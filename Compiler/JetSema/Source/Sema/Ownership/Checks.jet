// Ownership and reference facts for the Jet semantic checker.
//
// This is deliberately a fact prover, not a second Sema context.  Name and
// type lookup remain in SemaScopeTable and Type.  The state below stores only
// facts that are created by a source-order walk: moved places, short-lived
// access windows, declaration liveness, and reference anchors.  The parent
// checker can call the small hooks while it checks expressions/statements, or
// use sema_ownership_check_statements as the ownership-only walk for a body.
//
// Jet's `&` is AccessConvention.Write.  It grants a capability to change the
// named place; it is not a Rust read borrow and is never silently downgraded
// to Read.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    Binding,
    CallArg,
    Diagnostic,
    DiagnosticFixApplicability,
    DiagnosticFixSafety,
    Expr,
    InternalTag,
    LValue,
    Lambda,
    PlaceAccess,
    Span,
    Stmt,
    Symbol,
    SymbolKind,
    TGenericParam,
    TagMarker,
    TextEdit,
    Type,
    TypeTupleField,
    UnOp,
    ViewProvenance,
    ViewProvenanceEntry,
    ViewProvenanceMap,
    ViewSource,
    ViewSourcePath,
    ViewSourceProjection,
    diagnostic_registry_row,
    diagnostic_with_edit,
    diagnostic_with_edit_grade,
    diagnostic_with_label,
    diagnostic_with_detail,
    expr_source_span,
    expr_span,
    type_identity_equal,
    type_name,
    Field,
    PatSlot,
    Pattern,
    TCaptureFacts,
    pattern_binding_names,
    NameRows,
    name_rows,
    name_rows_get,
    name_rows_get_text,
    name_rows_hash,
    name_rows_set,
    name_rows_set_hashed,
]

SemaOwnershipReferenceKind: enum {
    Read
    Write
    Move
}

SemaOwnershipProjection: enum {
    Field(name: String, span: Span)
    Index(value: Int?, span: Span)
    Range(start: Int?, end: Int?, span: Span)
    Fresh(span: Span)
    Deref(span: Span)
}

SemaOwnershipPlace: struct {
    root: String
    root_key: String
    root_span: Span
    projections: [String]
    typed_projections: [SemaOwnershipProjection]
}

SemaOwnershipViewFact: struct {
    carrier: String
    carrier_key: String
    carrier_span: Span
    source: SemaOwnershipPlace
    output_path: [String]
    access: AccessConvention
    scope_depth: Int
    seq: Int
    loan_seq: Int
    loan_span: Span
    // Only this capability's actual ancestry may exempt overlapping windows.
    reborrow_parent: Int{-1}
    lexical: Bool{false}
    // A window opened over a conflict already reported (E0212) inside a
    // `task.group` body: it is kept so a child capturing it is judged against
    // its place, but it neither blocks nor is blocked by other views.
    contested: Bool{false}
    active: Bool
    invalidated: Bool
    invalidated_span: Span
    invalidated_verb: String
}

SemaOwnershipViewProducer: struct {
    source: Expr
    access: AccessConvention
    span: Span
}

SemaOwnershipMoveOrigin: struct {
    span: Span
    consumer: String
    // The moved binding's type when this was an unmarked
    // move of a whole binding written as its plain name. A later use turns
    // that site into a share; `None` for an exact `.move()` or a projection.
    share_ty: Type?
    // The callee when this was an unmarked argument to a
    // take parameter, moved as its name's last use. A later use reports
    // E0209 at the argument (pass a copy with `.copy()`) instead of sharing it.
    implicit_take: String?{None}
    // The captured name a run-once lambda takes with
    // `.move()`, when this move is that lambda binding's call. A later call
    // reports E0121 naming the capture (Rust `moved_use_diagnostic`).
    once_capture: String?{None}
    // The scope depth of the `defer close(name)` that made this move. The
    // value leaves when that scope exits: until then later statements still
    // read it and only another move is refused.
    deferred_depth: Int?{None}
    // The moved binding's type when the move names a plain binding, so the
    // later use can say why a one-pass source has no copy to give.
    moved_ty: Type?{None}
    // The whole `place.move()` of an exact move: the E0121 label covers the mark
    // that moved the value, not only the place after it.
    label_span: Span?{None}
    // The move does not repeat at a loop's back edge because each pass gets
    // its own copy: a lambda capture of a value whose clone is structurally
    // known (spec "copyable captures are copied at closure creation"), or an
    // owned field filled from a value whose copy facts are undecided here,
    // which a later use copies (sema_copy_site_refuse_copy).
    copies_each_pass: Bool{false}
}

// A lambda whose body takes a captured name with `.move()`.
// `site` is the lambda's span; `key` is the binding that holds it, once bound.
SemaOwnershipOnceLambda: struct {
    site: Span
    key: String
    capture: String
}

// A lambda binding `key` whose body writes the captured `names` (TCaptureFacts
// `mutable`): calling it changes them, so a call inside a loop reading one of
// them is E0507.
SemaOwnershipClosureWrites: struct {
    key: String
    names: [String]
}

// A lambda binding `key` that is only ever called directly and reads or
// writes the captured `places` (it takes or materializes none of them):
// each call reads them, so a call after one of them moved is E0121.
SemaOwnershipClosureCaptures: struct {
    key: String
    places: [SemaOwnershipPlace]
}

// A captured name an escaping lambda binding writes, held until the scope
// that bound the lambda (`scope_depth`) closes.
SemaOwnershipLambdaWriteBorrow: struct {
    name: String
    scope_depth: Int
}

// An unmarked move site that a later use reached. The
// function check re-runs with the site known, and the site then checks as
// the authored copy `name.copy()`.
SemaOwnershipShareSite: struct {
    span: Span
    ty: Type
}

SemaOwnershipMovedPlace: struct {
    place: SemaOwnershipPlace
    origin: SemaOwnershipMoveOrigin
}

SemaOwnershipLoan: struct {
    place: SemaOwnershipPlace
    access: AccessConvention
    span: Span
    scope_depth: Int
    seq: Int
    carrier_fact_seq: Int
    carrier_key: String
    // A window a `&place`/read-place expression opened in value position. No
    // name carries it unless its own statement binds it (`w := &xs`); an
    // unbound one ends before the next statement (sema_ownership_release_dead_views).
    statement_window: Bool{false}
}

// A place a running `task.group` child holds through a captured window
// (TaskGroups.jet publishes those borrows here). The child keeps it past the
// window binding's last lexical use, until `group` joins.
SemaOwnershipGroupLoan: struct {
    name: String
    group: String
    place: SemaOwnershipPlace
    access: AccessConvention
}

SemaOwnershipBindingFact: struct {
    key: String
    name: String
    span: Span
    parameter: Bool
    scope_depth: Int
    references: Int
    writes: Int
    active: Bool
    // This binding owns a `#SingleUse` value's consume duty
    // (Ownership/SingleUse.jet).
    single_use: Bool
    // The duty is a task handle's `join` (L1101), not `consume`.
    owes_join: Bool{false}
    // Provenance belongs to this exact binding, not its name.
    frozen_site: SemaOwnershipFreezeSite?{None}
    // The compiler declared this binding (a fallback's `err`); an unread one
    // is not the user's dead code.
    ambient: Bool{false}
}

SemaOwnershipReference: struct {
    name: String
    def_key: String
    def_span: Span
    use_span: Span
    kind: SemaOwnershipReferenceKind
}
// A typed place whose own Close implementation needs the complete value.
SemaOwnershipCloseOwner: struct {
    place: SemaOwnershipPlace
    ty: Type
}

SemaOwnershipState: struct {
    scope_depth: Int
    next_seq: Int
    declarations: [SemaOwnershipBindingFact]
    moved: [SemaOwnershipMovedPlace]
    loans: [SemaOwnershipLoan]
    views: [SemaOwnershipViewFact]
    references: [SemaOwnershipReference]
    receiver_frames: [SemaReceiverMarkFrame]
    // Share sites this check applies, and the sites it
    // found that a later use reached.
    share_known: [Span]
    share_found: [SemaOwnershipShareSite]
    // Unmarked take arguments the typed argument check
    // found eligible to move at their last use (Rust
    // `take_unmarked_last_use`); the call ownership check makes the move.
    implicit_take_ok: [Span]{[Span]{}}
    // Eligible unmarked take arguments whose name another
    // argument of the same call also names. Such a name has no last use in
    // that call (Rust `take_unmarked_last_use` `named_elsewhere`): E0209.
    implicit_take_twice: [Span]{[Span]{}}
    // Taken field arguments the typed argument check found to be exact
    // moves into a consuming parameter; the call ownership check records the
    // move, so a later use of the field is E0121.
    exact_field_takes: [Span]{[Span]{}}
    // Run-once lambdas found in this function, and the
    // bindings holding them (Rust `once_lambda_sites` / `once_lambdas`).
    once_lambdas: [SemaOwnershipOnceLambda]{[SemaOwnershipOnceLambda]{}}
    // Lambda bindings that write a capture, by binding key.
    closure_writes: [SemaOwnershipClosureWrites]{[SemaOwnershipClosureWrites]{}}
    // Lambda bindings that only direct calls reach, by lambda span.
    direct_call_lambdas: [Span]{[Span]{}}
    // Lambda bindings whose calls read their captures, by binding key.
    closure_captures: [SemaOwnershipClosureCaptures]{[SemaOwnershipClosureCaptures]{}}
    // Names an escaping lambda bound in an open scope writes.
    lambda_write_borrows: [SemaOwnershipLambdaWriteBorrow]{[SemaOwnershipLambdaWriteBorrow]{}}
    // `#Reactive` bodies checked so far: their writes land on the
    // registration's clones, not on the enclosing lambda's captures.
    reactive_bodies: [Span]{[Span]{}}
    // `function#parameter` keys of list write parameters
    // proven length-preserving (sema_fixed_length_write_params).
    fixed_length_write_params: [String]
    // E0420: `Type{ uninit }` bindings not yet
    // definitely written on every path reaching this point.
    uninit: [SemaOwnershipUninitFact]
    // Rust `is_static_move_root`: keys of this module's `#Persist`, mutable,
    // and `#Static` bindings, which own one shared storage cell (E0222/E0223).
    static_roots: [String]
    // The `#Persist` subset of `static_roots`, which a write borrow may lend.
    persist_roots: [String]
    close_owners: [SemaOwnershipCloseOwner]
    // Only the parameter symbol of this exact consuming Close body is exempt.
    close_receiver_key: String
    // Indices over declarations and references (key slots over interned
    // keys, A1); previous rows link equal keys.
    key_slots: NameRows
    key_facts: [SemaOwnershipKeyFacts]
    declaration_previous: [Int]
    // Scope buckets may hold stale rows; readers check the declaration itself.
    active_rows: [[Int]]
    single_use_rows: [Int]
    // Rows before dirty_clean have canonical reference counts again.
    dirty_rows: [Int]
    dirty_clean: Int
    anchors: SemaOwnershipAnchors
    // Declaration edits are recorded while a branch fork is open.
    forks: Int
    trail: [SemaOwnershipUndo]
    freeze_sites: [SemaOwnershipFreezeSite]{[SemaOwnershipFreezeSite]{}}
    // Match payload bindings (sema_ownership_payload_key) and the subject
    // places their payload is read from (Expressions/Control.jet
    // sema_expression_pattern_binding_sources): an explicit `p.move()` takes the
    // payload out of that subject (sema_ownership_move_pattern_payload).
    pattern_sources: [String:[Expr]]{[String:[Expr]]{}}
    // Spans of the windows whose overlap is judged where the value lands —
    // a binding statement's whole initializer, the elements of a `ViewMut`
    // list literal (sema_ownership_view_open_deferred).
    deferred_view_opens: [Span]{[Span]{}}
    // Facts the evaluated access walk reads by source span (key
    // sema_ownership_span_key): each checked lambda's capture modes, each
    // method call's resolved receiver access, and each field read's type.
    // A lambda body hands its own back (sema_ownership_note_lambda).
    lambda_facts: [Int:SemaOwnershipLambdaFacts]{[Int:SemaOwnershipLambdaFacts]{}}
    receiver_accesses: [Int:SemaOwnershipReceiverAccess]{[Int:SemaOwnershipReceiverAccess]{}}
    place_types: [Int:Type]{[Int:Type]{}}
    // Each checked call's returned-view facts by the span its return views
    // are published under: a nested call's View result keeps its source
    // lent as an argument of the enclosing call.
    call_views: [Int:[SemaCallReturnViewFact]]{[Int:[SemaCallReturnViewFact]]{}}
    // Keys of the bindings a checked path read, including a path that leaves
    // (`return`, `break`). A fork rollback drops a leaving path's references,
    // but its reads are still uses for L0101/L0102.
    used_keys: [String:Bool]{[String:Bool]{}}
    // The places the active task groups lend to running children, as the
    // parent sees them; empty while a child's own body is checked.
    group_loans: [SemaOwnershipGroupLoan]{[SemaOwnershipGroupLoan]{}}
}

// First/last declaration rows and total reference/write counts for one key.
SemaOwnershipKeyFacts: struct {
    first: Int
    last: Int
    references: Int
    writes: Int
}

// Mutable declaration fields before one edit.
SemaOwnershipUndo: struct {
    row: Int
    references: Int
    writes: Int
    active: Bool
    single_use: Bool
    frozen_site: SemaOwnershipFreezeSite?
}

// Indexed-store counts and small per-path facts before a branch arm.
SemaOwnershipFork: struct {
    scope_depth: Int
    next_seq: Int
    declarations: Int
    references: Int
    trail: Int
    dirty: Int
    dirty_clean: Int
    single_use: Int
    moved: [SemaOwnershipMovedPlace]
    loans: [SemaOwnershipLoan]
    views: [SemaOwnershipViewFact]
    uninit: [SemaOwnershipUninitFact]
    share_found: [SemaOwnershipShareSite]
    receiver_frames: [SemaReceiverMarkFrame]
    freeze_sites: [SemaOwnershipFreezeSite]
}

// Rows added after a fork, and that path's small facts at its end.
SemaOwnershipPath: struct {
    scope_depth: Int
    next_seq: Int
    declarations: [SemaOwnershipBindingFact]
    references: [SemaOwnershipReference]
    moved: [SemaOwnershipMovedPlace]
    loans: [SemaOwnershipLoan]
    views: [SemaOwnershipViewFact]
    uninit: [SemaOwnershipUninitFact]
    share_found: [SemaOwnershipShareSite]
    // Only bindings whose provenance changed on an in-place arm; whole-state
    // snapshot paths include every binding because they have no undo trail.
    frozen: SemaOwnershipFrozenRows
    freeze_sites: [SemaOwnershipFreezeSite]
}

// The freeze provenance of binding keys (a path's `frozen`): a hashed key
// table whose row of a key is its first-set position in `sites`.
SemaOwnershipFrozenRows: struct {
    keys: NameRows
    sites: [SemaOwnershipFreezeSite?]
}

sema_ownership_frozen_rows: fn() -> SemaOwnershipFrozenRows Never! {
    SemaOwnershipFrozenRows{keys: name_rows(), sites: [SemaOwnershipFreezeSite?]{}}
}

// Binds `key` (whose name_rows_hash is `hash`) to `site`, replacing any
// earlier site of the key.
sema_ownership_frozen_set: fn(rows: &SemaOwnershipFrozenRows, key: String, hash: Int, site: SemaOwnershipFreezeSite?) Never! {
    if name_rows_get(rows.keys, key, hash) == .Val(row) {
        rows.sites[row] = site
        return
    }
    name_rows_set_hashed(rows.keys, key, hash, rows.sites.len())
    rows.sites.push(site.copy())
}

SemaOwnershipFreezeSite: struct {
    span: Span
    line: Int
    column: Int
}

// One `Type{ uninit }` binding that is not yet definitely written.
// A fixed list tracks the literal slots written so far; `fixed_len` is None
// for a scalar, or once two paths disagree on the length.
SemaOwnershipUninitFact: struct {
    key: String
    name: String
    fixed_len: Int?
    initialized: [Int]
}

// One frame per method call being checked. Receiver hooks
// record the strongest convention the resolved call uses for its receiver,
// and under `#Policy(writes: .Explicit)` the signature line of that call.
SemaReceiverMarkFrame: struct {
    receiver_span: Span
    convention: AccessConvention?
    signature: String{""}
}

SemaOwnershipCallViewFact: struct {
    output_path: [String]
    access: AccessConvention
    places: [SemaOwnershipPlace]
}

SemaOwnershipCheckResult: struct {
    accepted: Bool
    complete: Bool
}

SemaOwnershipFlowResult: struct {
    complete: Bool
    falls_through: Bool
}

sema_ownership_state_init: fn() -> SemaOwnershipState Never! {
    SemaOwnershipState{
        scope_depth: 0,
        next_seq: 0,
        declarations: [SemaOwnershipBindingFact]{},
        moved: [SemaOwnershipMovedPlace]{},
        loans: [SemaOwnershipLoan]{},
        views: [SemaOwnershipViewFact]{},
        references: [SemaOwnershipReference]{},
        receiver_frames: [SemaReceiverMarkFrame]{},
        share_known: [Span]{},
        share_found: [SemaOwnershipShareSite]{},
        fixed_length_write_params: [String]{},
        uninit: [SemaOwnershipUninitFact]{},
        static_roots: [String]{},
        persist_roots: [String]{},
        close_owners: [SemaOwnershipCloseOwner]{},
        close_receiver_key: "",
        key_slots: name_rows(),
        key_facts: [SemaOwnershipKeyFacts]{},
        declaration_previous: [Int]{},
        active_rows: [[Int]]{},
        single_use_rows: [Int]{},
        dirty_rows: [Int]{},
        dirty_clean: 0,
        anchors: SemaOwnershipAnchors{slots: [Int:Int]{}, rows: [[Int]]{}},
        forks: 0,
        trail: [SemaOwnershipUndo]{},
    }
}

sema_ownership_place_snapshot: fn(source: SemaOwnershipPlace) -> SemaOwnershipPlace Never! {
    result := SemaOwnershipPlace{root: source.root, root_key: source.root_key, root_span: source.root_span, projections: [String]{}, typed_projections: [SemaOwnershipProjection]{}}
    loop projection in source.projections -> result.projections.push(projection.copy())
    loop typed_projection in source.typed_projections -> result.typed_projections.push(typed_projection.copy())
    result
}

sema_ownership_moved_snapshot: fn(source: SemaOwnershipMovedPlace) -> SemaOwnershipMovedPlace Never! {
    SemaOwnershipMovedPlace{
        place: sema_ownership_place_snapshot(source.place),
        origin: source.origin,
    }
}

sema_ownership_loan_snapshot: fn(source: SemaOwnershipLoan) -> SemaOwnershipLoan Never! {
    SemaOwnershipLoan{
        place: sema_ownership_place_snapshot(source.place),
        access: source.access,
        span: source.span,
        scope_depth: source.scope_depth,
        seq: source.seq,
        carrier_fact_seq: source.carrier_fact_seq,
        carrier_key: source.carrier_key,
        statement_window: source.statement_window,
    }
}

sema_ownership_view_snapshot: fn(source: SemaOwnershipViewFact) -> SemaOwnershipViewFact Never! {
    result := SemaOwnershipViewFact{
        carrier: source.carrier,
        carrier_key: source.carrier_key,
        carrier_span: source.carrier_span,
        source: sema_ownership_place_snapshot(source.source),
        output_path: [String]{},
        access: source.access,
        scope_depth: source.scope_depth,
        seq: source.seq,
        loan_seq: source.loan_seq,
        loan_span: source.loan_span,
        reborrow_parent: source.reborrow_parent,
        lexical: source.lexical,
        contested: source.contested,
        active: source.active,
        invalidated: source.invalidated,
        invalidated_span: source.invalidated_span,
        invalidated_verb: source.invalidated_verb,
    }
    loop path in source.output_path -> result.output_path.push(path.copy())
    result
}

sema_ownership_state_snapshot: fn(source: SemaOwnershipState) -> SemaOwnershipState Never! {
    snapshot := sema_ownership_state_init()
    snapshot.scope_depth = source.scope_depth
    snapshot.next_seq = source.next_seq
    loop declaration in source.declarations -> snapshot.declarations.push(declaration.copy())
    loop site in source.freeze_sites -> snapshot.freeze_sites.push(site.copy())
    loop moved in source.moved -> snapshot.moved.push(sema_ownership_moved_snapshot(moved))
    loop loan in source.loans -> snapshot.loans.push(sema_ownership_loan_snapshot(loan))
    loop view in source.views -> snapshot.views.push(sema_ownership_view_snapshot(view))
    loop reference in source.references -> snapshot.references.push(reference.copy())
    loop site in source.share_known -> snapshot.share_known.push(site.copy())
    loop site in source.share_found -> snapshot.share_found.push(site.copy())
    snapshot.fixed_length_write_params = source.fixed_length_write_params
    snapshot.uninit = source.uninit
    snapshot.static_roots = source.static_roots
    snapshot.persist_roots = source.persist_roots
    loop owner in source.close_owners -> snapshot.close_owners.push(SemaOwnershipCloseOwner{place: sema_ownership_place_snapshot(owner.place), ty: owner.ty})
    snapshot.close_receiver_key = source.close_receiver_key.copy()
    snapshot.key_slots = source.key_slots
    snapshot.key_facts = source.key_facts
    snapshot.declaration_previous = source.declaration_previous
    snapshot.active_rows = source.active_rows
    snapshot.single_use_rows = source.single_use_rows
    snapshot.dirty_rows = source.dirty_rows
    snapshot.dirty_clean = source.dirty_clean
    snapshot.anchors = source.anchors
    snapshot.forks = source.forks
    snapshot.trail = source.trail
    snapshot.used_keys = source.used_keys
    loop loan in source.group_loans -> snapshot.group_loans.push(SemaOwnershipGroupLoan{name: loan.name, group: loan.group, place: sema_ownership_place_snapshot(loan.place), access: loan.access})
    snapshot
}

// Puts back a whole-state copy (`state.copy()`) taken before a check that is
// being discarded. The saved state is spent, so each field moves back; the
// fields are those sema_ownership_state_restore_path copies, then the
// receiver frames, share sites known and function facts.
sema_ownership_state_restore: fn(state: &SemaOwnershipState, saved: &&SemaOwnershipState) Never! {
    state.scope_depth = saved.scope_depth
    state.next_seq = saved.next_seq
    state.declarations = saved.declarations.move()
    state.moved = saved.moved.move()
    state.loans = saved.loans.move()
    state.views = saved.views.move()
    state.references = saved.references.move()
    state.share_found = saved.share_found.move()
    state.uninit = saved.uninit.move()
    state.freeze_sites = saved.freeze_sites.move()
    state.key_slots = saved.key_slots.move()
    state.key_facts = saved.key_facts.move()
    state.declaration_previous = saved.declaration_previous.move()
    state.active_rows = saved.active_rows.move()
    state.single_use_rows = saved.single_use_rows.move()
    state.dirty_rows = saved.dirty_rows.move()
    state.dirty_clean = saved.dirty_clean
    state.anchors = saved.anchors.move()
    state.trail = saved.trail.move()
    state.receiver_frames = saved.receiver_frames.move()
    state.share_known = saved.share_known.move()
    state.fixed_length_write_params = saved.fixed_length_write_params.move()
    state.static_roots = saved.static_roots.move()
    state.persist_roots = saved.persist_roots.move()
    state.close_owners = saved.close_owners.move()
    state.close_receiver_key = saved.close_receiver_key.move()
    state.group_loans = saved.group_loans.move()
}

// The per-path part of a restore: everything except the receiver frames,
// share sites known, and function facts, which stay `state`'s. `saved` is
// read again by the caller, so each field is copied.
sema_ownership_state_restore_path: fn(state: &SemaOwnershipState, saved: SemaOwnershipState) Never! {
    state.scope_depth = saved.scope_depth
    state.next_seq = saved.next_seq
    state.declarations = saved.declarations.copy()
    state.moved = saved.moved.copy()
    state.loans = saved.loans.copy()
    state.views = saved.views.copy()
    state.references = saved.references.copy()
    state.share_found = saved.share_found.copy()
    state.uninit = saved.uninit.copy()
    state.freeze_sites = saved.freeze_sites.copy()
    state.key_slots = saved.key_slots.copy()
    state.key_facts = saved.key_facts.copy()
    // copy: the restored path takes its own declaration_previous, while `saved` is the caller's
    // saved state (a read parameter), restored again on every remaining path.
    state.declaration_previous = saved.declaration_previous.copy()
    // copy: the restored path takes its own active_rows, while `saved` is the caller's saved state
    // (a read parameter), restored again on every remaining path.
    state.active_rows = saved.active_rows.copy()
    // copy: the restored path takes its own single_use_rows, while `saved` is the caller's saved
    // state (a read parameter), restored again on every remaining path.
    state.single_use_rows = saved.single_use_rows.copy()
    // copy: the restored path takes its own dirty_rows, while `saved` is the caller's saved state
    // (a read parameter), restored again on every remaining path.
    state.dirty_rows = saved.dirty_rows.copy()
    state.dirty_clean = saved.dirty_clean
    // copy: the restored path takes its own anchors, while `saved` is the caller's saved state (a
    // read parameter), restored again on every remaining path.
    state.anchors = saved.anchors.copy()
    // copy: the restored path takes its own trail, while `saved` is the caller's saved state (a
    // read parameter), restored again on every remaining path.
    state.trail = saved.trail.copy()
}

sema_ownership_next_sequence: fn(state: &SemaOwnershipState) -> Int Never! {
    sequence := state.next_seq
    state.next_seq += 1
    sequence
}

sema_ownership_span_same: fn(left: Span, right: Span) -> Bool Never! {
    left.start == right.start && left.end == right.end
}

// ────────────────────────────────────────────────────────────────────────────
// Copy/clone judgments

// This is the representation-only part of Rust's `type_is_copy` judgment.
// Nominal types require the parent's trait registry and therefore are not
// guessed here; callers receive `complete == false` for such a dependency.
sema_ownership_type_tuple_is_copy: fn(fields: [TypeTupleField]) -> Bool Never! {
    loop field in fields {
        if !sema_ownership_type_is_copy(field.ty) -> return false
    }
    true
}

sema_ownership_type_is_copy: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int -> true
        .IntN(_, _) -> true
        .Float -> true
        .Float32 -> true
        .Bool -> true
        .Char -> true
        .Measure(_) -> true
        .Quantity(base, _) -> sema_ownership_type_is_copy(base)
        .Tagged(marker, inner) -> if marker == (TagMarker.Internal{internal_tag: InternalTag.AllocatorView}) -> false else -> sema_ownership_type_is_copy(inner)
        .Option(inner) -> sema_ownership_type_is_copy(inner)
        .Result(ok, err) -> sema_ownership_type_is_copy(ok) && sema_ownership_type_is_copy(err)
        .Tuple(fields) -> sema_ownership_type_tuple_is_copy(fields)
        .FixedList(inner, _) -> sema_ownership_type_is_copy(inner)
        .InlineRange(_, _, _) -> true
        .Named(name) -> name == "Unit" || name == "Never" || name == "IOOperation"
        .String | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Union(_) | .Case(_, _) -> false
    }
}

// Rust `Type::is_scalar`: the by-value numeric and boolean leaves (and raw
// pointers). Unlike Copy it excludes `Char`, carriers, tuples and units; the
// borrowed-parameter binding and return audits key on exactly this set.
sema_ownership_type_is_scalar: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Bool | .Float32 | .IntN(_, _) | .Quantity(_, _) -> true
        .Tagged(_, inner) | .InlineRange(inner, _, _) -> sema_ownership_type_is_scalar(inner)
        .Apply(name, args) -> name == "Ptr" && args.len() == 1
        .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .Union(_) | .Case(_, _) | .Measure(_) -> false
    }
}

// A read or write parameter: storage this function borrows and does not own
// (Rust `param_conv` is `Read` or `Write`). Locals are owned even though
// they are declared with read access.
sema_ownership_binding_is_borrowed_param: fn(binding: SemaScopeBinding) -> Bool Never! {
    binding.symbol.kind == SymbolKind.Parameter && (binding.access == AccessConvention.Read || binding.access == AccessConvention.Write)
}

// Rust `param_conv` is `Read` or `Write`: a borrowed parameter, or a write
// window bound by a `&place` pattern (Rust `declare_pattern_write_window`).
// A read pattern payload is an ordinary local there (`param_conv: None`).
sema_ownership_binding_lends: fn(binding: SemaScopeBinding) -> Bool Never! {
    sema_ownership_binding_is_borrowed_param(binding) || binding.access == AccessConvention.Write
}

// Rust `is_edit_shared_guard`: a binding holding a `guard_edit()` lease keeps
// its acquisition-site write capability even when the binding is immutable.
sema_ownership_binding_is_edit_shared_guard: fn(binding: SemaScopeBinding) -> Bool Never! {
    ty: binding.symbol.ty ?? return false
    if ty == .Tagged(marker, inner) {
        if marker != (TagMarker.Internal{internal_tag: InternalTag.SharedGuardEdit}) -> return false
        if inner == .Apply(name, _) -> return name == "SharedGuard"
    }
    false
}

// A write through the `.value` of a guard taken in the same statement
// (`store.guard_edit().value.items[key] = text`): the edit permit lives to
// the end of the statement, so the write reaches the cell without a binding.
sema_ownership_writes_temporary_edit_guard: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Field(base, member, _, _) -> {
            if member == "value" {
                if base == .MethodCall(_, method, _, _, _, args, _) -> return method == "guard_edit" && args.len() == 0
            }
            sema_ownership_writes_temporary_edit_guard(base)
        }
        .Index(base, _, _, _, _) | .Paren(base, _, _) | .Place(base, _, _, _) -> sema_ownership_writes_temporary_edit_guard(base)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}


// Rust `place_reads_untagged_or_read_shared_guard`: a write that reaches a
// `.value` held by an untagged or `guard_read()` SharedGuard. A write
// parameter root keeps its caller-granted capability. The guard type is
// known only for a binding root (`guard.value`), where every guard lives.
sema_ownership_writes_read_shared_guard: fn(expr: Expr, scopes: SemaScopeTable) -> Bool Never! {
    output_path := [String]{}
    root: sema_ownership_named_view_root(expr, output_path) ?? return false
    root_index: sema_scope_resolve_index_at(scopes, root, expr_span(expr)) ?? return false
    if scopes.bindings[root_index].symbol.kind == SymbolKind.Parameter && scopes.bindings[root_index].access == AccessConvention.Write -> return false
    sema_ownership_place_reads_read_shared_guard(expr, scopes)
}

sema_ownership_place_reads_read_shared_guard: fn(expr: Expr, scopes: SemaScopeTable) -> Bool Never! {
    if expr == {
        .Field(base, member, _, _) -> {
            if member == "value" && sema_ownership_expr_is_read_shared_guard(base, scopes) -> return true
            sema_ownership_place_reads_read_shared_guard(base, scopes)
        }
        .Index(base, _, _, _, _) | .Paren(base, _, _) | .Place(base, _, _, _) -> sema_ownership_place_reads_read_shared_guard(base, scopes)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

sema_ownership_expr_is_read_shared_guard: fn(expr: Expr, scopes: SemaScopeTable) -> Bool Never! {
    if expr == .Ident(name, span, _) {
        index: sema_scope_resolve_index_at(scopes, name, span) ?? return false
        ty: scopes.bindings[index].symbol.ty ?? return false
        if ty == .Apply(guard_name, _) -> return guard_name == "SharedGuard"
        if ty == .Tagged(marker, _) -> return marker == (TagMarker.Internal{internal_tag: InternalTag.SharedGuardRead})
    }
    false
}

sema_ownership_diag_read_shared_guard_write: fn(span: Span) -> Diagnostic {
    sema_error("E0205", span, "cannot edit through this read-only `SharedGuard` view", "a public guard type outside its acquisition site preserves read access unless a helper explicitly receives it with write access", "keep the edit at the acquisition site, or pass the guard to a helper that declares it with write access, such as `guard: &SharedGuard<T>`")
}

// Structural cloneability is known for the core value constructors; a
// `Shared` handle clones by its count, whatever it holds. A
// nominal, trait, or function part is registry-owned: it leaves the whole
// answer unresolved (None) for the registry check, never a conservative
// `false` for a composite that holds it (`Effect?`, `[Row]`).
sema_ownership_type_cloneable: fn(ty: Type) -> Bool? {
    if sema_ownership_type_is_copy(ty) -> return Val(true)
    if ty == {
        .String | .Shared(_) -> Val(true)
        .List(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .Quantity(inner, _) -> sema_ownership_type_cloneable(inner)
        .Map(key, _, value) | .Result(key, value) -> sema_ownership_types_cloneable([Type]{key, value})
        .Tuple(fields) -> sema_ownership_types_cloneable(loop field in fields -> field.ty)
        .Named(_) | .Apply(_, _) | .TraitObject(_) | .Fn(_, _, _, _, _, _) -> None
        .Int | .Float | .Bool | .Char | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Measure(_) -> Val(false)
    }
}

// Every part cloneable: one known refusal decides, else an unresolved part
// leaves the composite unresolved.
sema_ownership_types_cloneable: fn(parts: [Type]) -> Bool? {
    unresolved := false
    loop part in parts {
        answer: sema_ownership_type_cloneable(part)
        if answer == (Val(false)) -> return Val(false)
        if answer == None -> unresolved = true
    }
    if unresolved -> None else -> Val(true)
}

// ────────────────────────────────────────────────────────────────────────────
// Scope/declaration/reference facts

sema_ownership_enter_scope: fn(state: &SemaOwnershipState) Never! {
    state.scope_depth += 1
}

// ── Indexed declaration and reference rows ──────────────────────────────────
// Every edit of `declarations` and `references` goes through these helpers,
// which keep the indices of SemaOwnershipState exact and record each edit of
// a declaration row on the undo trail while a fork is open.

sema_ownership_key_slot: fn(state: &SemaOwnershipState, key: String) -> Int Never! {
    if name_rows_get_text(state.key_slots, key) == .Val(slot) -> return slot
    slot: state.key_facts.len()
    name_rows_set(state.key_slots, key, slot)
    state.key_facts.push(SemaOwnershipKeyFacts{first: -1, last: -1, references: 0, writes: 0})
    slot
}

// The first (or last) declaration row of `key`, -1 for none.
sema_ownership_first_row: fn(state: SemaOwnershipState, key: String) -> Int Never! {
    slot: name_rows_get_text(state.key_slots, key) ?? return -1
    state.key_facts[slot].first
}

sema_ownership_last_row: fn(state: SemaOwnershipState, key: String) -> Int Never! {
    slot: name_rows_get_text(state.key_slots, key) ?? return -1
    state.key_facts[slot].last
}

sema_ownership_active_add: fn(state: &SemaOwnershipState, depth: Int, row: Int) Never! {
    if depth < 0 -> return
    loop state.active_rows.len() <= depth -> state.active_rows.push([Int]{})
    state.active_rows[depth].push(row)
}

sema_ownership_mark_dirty: fn(state: &SemaOwnershipState, row: Int) Never! {
    if row >= 0 -> state.dirty_rows.push(row)
}

sema_ownership_note_undo: fn(state: &SemaOwnershipState, row: Int) Never! {
    if state.forks == 0 -> return
    undo: SemaOwnershipUndo{row: row, references: state.declarations[row].references, writes: state.declarations[row].writes, active: state.declarations[row].active, single_use: state.declarations[row].single_use, frozen_site: state.declarations[row].frozen_site}
    state.trail.push(undo)
}

// The counts the full recount gives `row`: the first row of a key holds
// every reference to the key, any later row of the same key none.
sema_ownership_canonical_counts: fn(state: SemaOwnershipState, row: Int) -> SemaOwnershipKeyFacts Never! {
    slot: name_rows_get_text(state.key_slots, state.declarations[row].key) ?? return SemaOwnershipKeyFacts{first: -1, last: -1, references: 0, writes: 0}
    facts: state.key_facts[slot]
    if facts.first != row -> return SemaOwnershipKeyFacts{first: facts.first, last: facts.last, references: 0, writes: 0}
    facts
}

sema_ownership_push_declaration: fn(state: &SemaOwnershipState, fact: &&SemaOwnershipBindingFact) Never! {
    row: state.declarations.len()
    slot: sema_ownership_key_slot(state, fact.key)
    previous: state.key_facts[slot].last
    state.declaration_previous.push(previous)
    if state.key_facts[slot].first < 0 -> state.key_facts[slot].first = row
    state.key_facts[slot].last = row
    active: fact.active
    scope_depth: fact.scope_depth
    single_use: fact.single_use
    references: fact.references
    writes: fact.writes
    state.declarations.push(fact.move())
    if active -> sema_ownership_active_add(state, scope_depth, row)
    if single_use -> state.single_use_rows.push(row)
    canonical: sema_ownership_canonical_counts(state, row)
    if canonical.references != references || canonical.writes != writes -> sema_ownership_mark_dirty(state, row)
}

sema_ownership_truncate_declarations: fn(state: &SemaOwnershipState, count: Int) Never! {
    loop state.declarations.len() > count {
        row: state.declarations.len() - 1
        fact: state.declarations.pop() ?? return
        previous: state.declaration_previous.pop() ?? -1
        slot: name_rows_get_text(state.key_slots, fact.key) ?? next
        state.key_facts[slot].last = previous
        if state.key_facts[slot].first == row -> state.key_facts[slot].first = -1
    }
}

// Appends one reference row and keeps the key's reference totals.
sema_ownership_push_reference: fn(state: &SemaOwnershipState, reference: &&SemaOwnershipReference) Never! {
    row: state.references.len()
    sema_ownership_anchor_add(state.anchors, reference.use_span.start, row)
    slot: sema_ownership_key_slot(state, reference.def_key)
    state.key_facts[slot].references += 1
    if reference.kind == SemaOwnershipReferenceKind.Write -> state.key_facts[slot].writes += 1
    state.references.push(reference.move())
}

sema_ownership_truncate_references: fn(state: &SemaOwnershipState, count: Int) Never! {
    loop state.references.len() > count {
        reference: state.references.pop() ?? return
        if state.anchors.slots.get(reference.use_span.start) == .Val(anchor_slot) -> _ := state.anchors.rows[anchor_slot].pop()
        slot: name_rows_get_text(state.key_slots, reference.def_key) ?? next
        state.key_facts[slot].references -= 1
        if reference.kind == SemaOwnershipReferenceKind.Write -> state.key_facts[slot].writes -= 1
    }
}

// A reference a join or a deferred body admits: no row counted it yet.
sema_ownership_admit_reference: fn(state: &SemaOwnershipState, reference: SemaOwnershipReference) Never! {
    sema_ownership_push_reference(state, reference.copy())
    first: sema_ownership_first_row(state, reference.def_key)
    sema_ownership_mark_dirty(state, first)
}

sema_ownership_deactivate: fn(state: &SemaOwnershipState, row: Int) Never! {
    if !state.declarations[row].active -> return
    sema_ownership_note_undo(state, row)
    state.declarations[row].active = false
}

sema_ownership_set_single_use: fn(state: &SemaOwnershipState, row: Int) Never! {
    if state.declarations[row].single_use -> return
    sema_ownership_note_undo(state, row)
    state.declarations[row].single_use = true
    state.single_use_rows.push(row)
}

// The rows flagged `single_use`, in declaration order.
sema_ownership_single_use_rows: fn(state: SemaOwnershipState) -> [Int] Never! {
    rows := [Int]{}
    loop row in state.single_use_rows {
        if row >= state.declarations.len() || !state.declarations[row].single_use || rows.contains(row) -> next
        rows.push(row)
    }
    rows.sort()
    rows
}

// Rust `pop_scope` keeps a moved fact only while no declaration of its root
// at the closing depth or deeper exists.
sema_ownership_key_declared_from: fn(state: SemaOwnershipState, key: String, depth: Int) -> Bool Never! {
    row := sema_ownership_last_row(state, key)
    loop row >= 0 {
        if state.declarations[row].scope_depth >= depth -> return true
        row = state.declaration_previous[row]
    }
    false
}

sema_ownership_leave_scope: fn(state: &SemaOwnershipState) Never! {
    depth := state.scope_depth
    if depth <= 0 -> return

    // Buckets at the closing depth or deeper empty out; popping them moves
    // each row list out instead of copying it.
    loop state.active_rows.len() > depth {
        rows: state.active_rows.pop() ?? break
        loop row in rows {
            if row < state.declarations.len() && state.declarations[row].scope_depth >= depth -> sema_ownership_deactivate(state, row)
        }
    }

    // The closing scope's rows leave in place, from the back, so the rows
    // that stay are never copied.
    index := state.moved.len()
    loop index > 0 {
        index -= 1
        if sema_ownership_key_declared_from(state, state.moved[index].place.root_key, depth) {
            _ := state.moved.remove(index, .Slot)
            next
        }
        // A deferred `close` of this scope has now taken its value.
        if state.moved[index].origin.deferred_depth == .Val(deferred) && deferred >= depth -> state.moved[index].origin.deferred_depth = None
    }
    sema_ownership_release_loans_from(state, depth)
    index = state.views.len()
    loop index > 0 {
        index -= 1
        if !state.views[index].active || state.views[index].scope_depth >= depth -> _ := state.views.remove(index, .Slot)
    }
    index = state.lambda_write_borrows.len()
    loop index > 0 {
        index -= 1
        if state.lambda_write_borrows[index].scope_depth >= depth -> _ := state.lambda_write_borrows.remove(index, .Slot)
    }
    state.scope_depth = depth - 1
}

// Loans opened at `depth` or deeper end. A lambda body's windows end with the
// body, so its escaping captures, which move in when the lambda is made, are
// checked only against the windows open around the lambda.
sema_ownership_release_loans_from: fn(state: &SemaOwnershipState, depth: Int) Never! {
    index := state.loans.len()
    loop index > 0 {
        index -= 1
        if state.loans[index].scope_depth >= depth -> _ := state.loans.remove(index, .Slot)
    }
}

// Rust `view_is_live_now`: a view stays live while this statement or a later
// one uses its carrier. A dead view releases its window, so the owner may be
// read, changed, moved, windowed, or pinned again after the view's last use.
// A window no name carries (`if &x.session == {…}` in value position) ends
// before the next statement, nested ones included: Rust records no view for
// it at all.
sema_ownership_release_dead_views: fn(state: &SemaOwnershipState, statement: Stmt, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) {
    loop index in 0..<state.views.len() {
        fact: state.views[index]
        if !fact.active || fact.lexical -> next
        if sema_ownership_last_use_statement(statement, fact.carrier) || sema_ownership_name_live_after(fact.carrier, tail_store, context) -> next
        descendant_live := false
        loop child in state.views {
            if child.active && child.lexical && sema_ownership_view_descends_from(state, child, fact.seq) {
                descendant_live = true
                break
            }
        }
        if descendant_live -> next
        state.views[index].active = false
        remaining: loop loan in state.loans if loan.carrier_fact_seq != fact.seq || loan.carrier_key != fact.carrier_key -> loan
        state.loans = remaining
    }
    unbound: loop loan in state.loans if !loan.statement_window || loan.carrier_fact_seq >= 0 -> loan
    state.loans = unbound
}

// Rust checks an assignment's target change (`check_lvalue_change`) before
// it infers the value, so a view the value alone reads is not yet "used in
// this statement": with no later use it is dead at the write. Release such
// views before the target write check, as `view_is_live_now` would.
sema_ownership_release_value_only_views: fn(state: &SemaOwnershipState, target: LValue, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) {
    target_expr: if target == {
        .Local(name, span) -> Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}
        // copy: `base` is a payload of read parameter `target`, which keeps the original; field `base` of the new Expr.Field owns this one
        .Field(base, field, span) -> Expr.Field{base: base.copy(), member: field, span: span, id: AST_NODE_GENERATED}
        // copy: `base`, `index` and `kind` are payloads of read parameter `target`, which keeps the originals; the new Expr.Index's fields own `base`, `index` and `kind`
        .Index(base, index, span, kind) -> Expr.Index{base: base.copy(), index: index.copy(), span: span, kind: kind.copy(), id: AST_NODE_GENERATED}
    }
    loop index in 0..<state.views.len() {
        fact: state.views[index]
        if !fact.active || fact.lexical -> next
        if sema_ownership_last_use_expr(target_expr, fact.carrier) || sema_ownership_name_live_after(fact.carrier, tail_store, context) -> next
        descendant_live := false
        loop child in state.views {
            if child.active && child.lexical && sema_ownership_view_descends_from(state, child, fact.seq) {
                descendant_live = true
                break
            }
        }
        if descendant_live -> next
        state.views[index].active = false
        remaining: loop loan in state.loans if loan.carrier_fact_seq != fact.seq || loan.carrier_key != fact.carrier_key -> loan
        state.loans = remaining
    }
}

sema_ownership_declare_binding: fn(state: &SemaOwnershipState, symbol: Symbol, parameter: Bool) Never! {
    if symbol.name == "_" -> return
    depth := state.scope_depth
    sema_ownership_push_declaration(state, SemaOwnershipBindingFact{
        key: symbol.id.key,
        name: symbol.name,
        span: symbol.span,
        parameter: parameter,
        scope_depth: depth,
        references: 0,
        writes: 0,
        active: true,
        single_use: false,
    })
}

// A compiler-declared binding such as a fallback's `err`: tracked like any
// local, never reported as unused.
sema_ownership_declare_ambient_binding: fn(state: &SemaOwnershipState, symbol: Symbol) Never! {
    before: state.declarations.len()
    sema_ownership_declare_binding(state, symbol, false)
    if state.declarations.len() > before -> state.declarations[state.declarations.len() - 1].ambient = true
}

sema_ownership_intentional_name: fn(name: String) -> Bool Never! {
    name == "" || name.starts_with("_") || name.starts_with("@_") || name == "self" || name == "result" || name == "it"
}

// The last declaration row of `key`.
sema_ownership_declaration_index: fn(state: &SemaOwnershipState, key: String) -> Int? {
    row: sema_ownership_last_row(state, key)
    if row < 0 -> return None
    Val(row)
}

// Lookup is delegated to SemaScopeTable.  If a parent hook forgot to declare
// the binding in the ownership store, recover one from the canonical Symbol
// rather than manufacturing a second name-resolution table.
sema_ownership_note_reference: fn(state: &SemaOwnershipState, name: String, use_span: Span, scopes: SemaScopeTable, kind: SemaOwnershipReferenceKind) -> Bool Never! {
    index: sema_scope_resolve_index_at(scopes, name, use_span) ?? return false
    def_key: scopes.bindings[index].symbol.id.key
    declaration_index := sema_ownership_declaration_index(state, def_key)
    if declaration_index == None {
        sema_ownership_declare_binding(state, scopes.bindings[index].symbol, scopes.bindings[index].symbol.kind == SymbolKind.Parameter)
        declaration_index = sema_ownership_declaration_index(state, def_key)
    }
    fact_index: declaration_index ?? return false
    // Only an open fork can roll this reference back.
    if state.forks > 0 -> state.used_keys[def_key] = true
    // Between joins a reference counts on the binding's last row; the first
    // row of the key owns the canonical recount, so any other row and that
    // first row both leave it.
    first: sema_ownership_first_row(state, def_key)
    sema_ownership_note_undo(state, fact_index)
    state.declarations[fact_index].references += 1
    if kind == SemaOwnershipReferenceKind.Write -> state.declarations[fact_index].writes += 1
    if fact_index != first {
        sema_ownership_mark_dirty(state, fact_index)
        sema_ownership_mark_dirty(state, first)
    }
    sema_ownership_push_reference(state, SemaOwnershipReference{name: name, def_key: def_key, def_span: scopes.bindings[index].symbol.span, use_span: use_span, kind: kind})
    true
}

sema_ownership_note_place_reference: fn(state: &SemaOwnershipState, expr: Expr, place: SemaOwnershipPlace, use_span: Span, scopes: SemaScopeTable, kind: SemaOwnershipReferenceKind) -> Bool Never! {
    valid := sema_ownership_note_reference(state, place.root, use_span, scopes, kind)
    output_path := [String]{}
    carrier_name := sema_ownership_named_view_root(expr, output_path)
    if carrier_name != None {
        name: carrier_name ?? place.root
        carrier_index := sema_scope_resolve_index_at(scopes, name, use_span)
        if carrier_index != None && scopes.bindings[carrier_index ?? 0].symbol.id.key != place.root_key {
            if !sema_ownership_note_reference(state, name, use_span, scopes, kind) -> valid = false
        }
    }
    valid
}

sema_ownership_finalize_references: fn(state: &SemaOwnershipState, diagnostics: &[Diagnostic]) {
    loop fact in state.declarations {
        if fact.references == 0 && state.used_keys.get(fact.key) == None && !fact.ambient && !sema_ownership_intentional_name(fact.name) && !sema_ownership_flow_narrowing(state, fact) {
            // Rust `CheckerReferences::emit_unused_binding_lints`: the
            // registry row wording, with the `_name` rename as the edit.
            what := "Local binding `{fact.name}` is never read."
            why := "A binding that no later expression reads adds dead code and may hide a computed result that should have been used."
            fix := "Remove the binding when its initializer is side-effect free, or rename `{fact.name}` to `_{fact.name}` when the value must be computed."
            code := "L0101"
            if fact.parameter {
                code = "L0102"
                what = "Parameter `{fact.name}` is never used."
                why = "An unused parameter often means the function contract or implementation is incomplete; Jet keeps this warning-only so prototypes stay unblocked."
                fix = "Use `{fact.name}`, rename it to `_{fact.name}` when it is intentionally unused, or remove it from the function contract."
            }
            diagnostics.push(diagnostic_with_edit(sema_lint(code, fact.span, what, why, fix), TextEdit{span: fact.span, new_text: "_{fact.name}"}))
        }
    }
}

// `x == None` over a stable optional reads as the presence
// test `x == .Val(x)`, which rebinds the payload under the same name at the
// read of `x`. That rebinding is the narrowed `x` itself (Rust refines the
// one binding's type), so it is not a separate unused local.
sema_ownership_flow_narrowing: fn(state: SemaOwnershipState, fact: SemaOwnershipBindingFact) -> Bool Never! {
    loop reference in state.references {
        if reference.name == fact.name && reference.def_key != fact.key && sema_ownership_span_same(reference.use_span, fact.span) -> return true
    }
    false
}

// The recount of every row (the first row of a key holds all references to
// the key, any other row none), applied to the rows that may differ from it.
sema_ownership_recompute_reference_counts: fn(state: &SemaOwnershipState) Never! {
    loop state.dirty_clean < state.dirty_rows.len() {
        row := state.dirty_rows[state.dirty_clean]
        state.dirty_clean += 1
        if row >= state.declarations.len() -> next
        canonical: sema_ownership_canonical_counts(state, row)
        if state.declarations[row].references == canonical.references && state.declarations[row].writes == canonical.writes -> next
        sema_ownership_note_undo(state, row)
        state.declarations[row].references = canonical.references
        state.declarations[row].writes = canonical.writes
    }
    if state.forks == 0 {
        state.dirty_rows = [Int]{}
        state.dirty_clean = 0
    }
}

// Exact reference anchor: definition key, use span and kind (a compound
// update reads and writes its target at one span, and both rows count).
// Rows of a reference list bucketed by use-span start, so a lookup compares a
// few rows instead of formatting and hashing a text key per reference.
SemaOwnershipAnchors: struct {
    slots: [Int:Int]
    rows: [[Int]]
}

sema_ownership_anchor_add: fn(anchors: &SemaOwnershipAnchors, start: Int, row: Int) Never! {
    if anchors.slots.get(start) == .Val(slot) {
        anchors.rows[slot].push(row)
        return
    }
    anchors.slots[start] = anchors.rows.len()
    anchors.rows.push([Int]{row})
}

// Whether a row of `merged` before `limit` (bucketed in `anchors`) has the
// anchor of `reference`.
sema_ownership_anchor_held: fn(merged: [SemaOwnershipReference], anchors: SemaOwnershipAnchors, limit: Int, reference: SemaOwnershipReference) -> Bool Never! {
    slot: anchors.slots.get(reference.use_span.start) ?? return false
    loop row in anchors.rows[slot] {
        if row >= limit -> return false
        if merged[row].use_span.end == reference.use_span.end && merged[row].def_key == reference.def_key && merged[row].kind == reference.kind -> return true
    }
    false
}

// Merge only reference anchors from a deferred body's added rows. Moves and
// write windows belong to the lambda's execution state, not construction.
sema_ownership_merge_references: fn(state: &SemaOwnershipState, references: [SemaOwnershipReference]) Never! {
    loop reference in references {
        if sema_ownership_anchor_held(state.references, state.anchors, state.references.len(), reference) -> next
        sema_ownership_admit_reference(state, reference)
    }
    sema_ownership_recompute_reference_counts(state)
}

// ────────────────────────────────────────────────────────────────────────────
// Places and overlap

sema_ownership_const_index: fn(expr: Expr) -> Int? {
    if expr == {
        .Int(value, _, _, _, _) -> Val(value)
        .Unary(op, value, _, _) -> {
            if op != UnOp.Neg -> return None
            number: sema_ownership_const_index(value) ?? return None
            Val(-number)
        }
        .Paren(value, _, _) -> sema_ownership_const_index(value)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

SemaOwnershipRangeBounds: struct {
    start: Int?
    end: Int?
}

sema_ownership_range_bounds: fn(start: Expr, end: Expr, range: Expr?) -> SemaOwnershipRangeBounds Never! {
    if range == .Val(actual) {
        if actual == {
            .Range(range_start, range_end, exclusive, _, _) -> {
                first: sema_ownership_const_index(range_start)
                last := sema_ownership_const_index(range_end)
                if exclusive && last != None {
                    last = Val((last ?? 0) - 1)
                }
                return SemaOwnershipRangeBounds{start: first, end: last}
            }
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return SemaOwnershipRangeBounds{start: None, end: None}
        }
    }
    SemaOwnershipRangeBounds{start: sema_ownership_const_index(start), end: sema_ownership_const_index(end)}
}

sema_ownership_path_starts: fn(path: [String], prefix: [String]) -> Bool Never! {
    if prefix.len() > path.len() -> return false
    loop (index, item) in prefix {
        if path[index] != item -> return false
    }
    true
}

sema_ownership_named_view_root: fn(expr: Expr, output_path: &[String]) -> String? {
    if expr == {
        .Ident(name, _, _) -> Val(name)
        .Paren(value, _, _) | .Place(value, _, _, _) -> sema_ownership_named_view_root(value, output_path)
        .Field(base, member, _, _) | .OptField(base, member, _, _, _, _) -> {
            root: sema_ownership_named_view_root(base, output_path) ?? return None
            output_path.push(".{member}")
            Val(root)
        }
        .Index(base, index, _, _, _) -> {
            root: sema_ownership_named_view_root(base, output_path) ?? return None
            constant: sema_ownership_const_index(index)
            if constant != None -> output_path.push("[{constant}]") else -> output_path.push("[]")
            Val(root)
        }
        .Slice(base, _, _, _, _, _) -> {
            root: sema_ownership_named_view_root(base, output_path) ?? return None
            output_path.push("[..]")
            Val(root)
        }
        .Deref(value, _, _) | .RawOf(value, _, _) -> {
            root: sema_ownership_named_view_root(value, output_path) ?? return None
            output_path.push("*")
            Val(root)
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Copy(_, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_ownership_typed_projection_facts: fn(expr: Expr) -> [SemaOwnershipProjection]? {
    if expr == {
        .Ident(_, _, _) -> Val([SemaOwnershipProjection]{})
        .Paren(value, _, _) | .Place(value, _, _, _) | .Tainted(value, _, _, _) -> sema_ownership_typed_projection_facts(value)
        .Field(base, member, span, _) | .OptField(base, member, _, _, span, _) -> {
            facts := sema_ownership_typed_projection_facts(base) ?? return None
            facts.push(SemaOwnershipProjection.Field{name: member, span: span})
            Val(facts)
        }
        .Index(base, index, span, _, _) -> {
            facts := sema_ownership_typed_projection_facts(base) ?? return None
            facts.push(SemaOwnershipProjection.Index{value: sema_ownership_const_index(index), span: span})
            Val(facts)
        }
        .Slice(base, start, end, range, span, _) -> {
            facts := sema_ownership_typed_projection_facts(base) ?? return None
            bounds: sema_ownership_range_bounds(start, end, range)
            facts.push(SemaOwnershipProjection.Range{start: bounds.start, end: bounds.end, span: span})
            Val(facts)
        }
        .Deref(value, span, _) | .RawOf(value, span, _) -> {
            facts := sema_ownership_typed_projection_facts(value) ?? return None
            facts.push(SemaOwnershipProjection.Deref{span: span})
            Val(facts)
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Copy(_, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_ownership_place_from_expr_inner: fn(expr: Expr, scopes: SemaScopeTable) -> SemaOwnershipPlace? {
    if expr == {
        .Ident(name, span, _) -> {
            index: sema_scope_resolve_index_at(scopes, name, span) ?? return None
            Val(SemaOwnershipPlace{
                root: scopes.bindings[index].symbol.name,
                root_key: scopes.bindings[index].symbol.id.key,
                root_span: scopes.bindings[index].symbol.span,
                projections: [String]{},
                typed_projections: [SemaOwnershipProjection]{},
            })
        }
        .Paren(value, _, _) -> sema_ownership_place_from_expr_inner(value, scopes)
        .Place(value, _, _, _) -> sema_ownership_place_from_expr_inner(value, scopes)
        .Tainted(value, _, _, _) -> sema_ownership_place_from_expr_inner(value, scopes)
        .Field(base, member, span, _) -> {
            place := sema_ownership_place_from_expr_inner(base, scopes) ?? return None
            place.projections.push(".{member}")
            place.typed_projections.push(SemaOwnershipProjection.Field{name: member, span: span})
            Val(place)
        }
        .OptField(base, member, _, _, span, _) -> {
            place := sema_ownership_place_from_expr_inner(base, scopes) ?? return None
            place.projections.push(".{member}")
            place.typed_projections.push(SemaOwnershipProjection.Field{name: member, span: span})
            Val(place)
        }
        .Index(base, index, span, _, _) -> {
            place := sema_ownership_place_from_expr_inner(base, scopes) ?? return None
            // Rust rewrites `xs[a..b]` to a slice before placing it: a range
            // operand is a range projection, not an element index.
            if index == .Range(_, _, _, _, _) {
                place.projections.push("[..]")
                bounds: sema_ownership_range_bounds(index, index, Val(index))
                place.typed_projections.push(SemaOwnershipProjection.Range{start: bounds.start, end: bounds.end, span: span})
                return Val(place)
            }
            constant: sema_ownership_const_index(index)
            if constant != None -> place.projections.push("[{constant}]") else -> place.projections.push("[]")
            place.typed_projections.push(SemaOwnershipProjection.Index{value: constant, span: span})
            Val(place)
        }
        .Slice(base, start, end, range, span, _) -> {
            place := sema_ownership_place_from_expr_inner(base, scopes) ?? return None
            place.projections.push("[..]")
            bounds: sema_ownership_range_bounds(start, end, range)
            place.typed_projections.push(SemaOwnershipProjection.Range{start: bounds.start, end: bounds.end, span: span})
            Val(place)
        }
        .Deref(value, span, _) -> {
            place := sema_ownership_place_from_expr_inner(value, scopes) ?? return None
            place.projections.push("*")
            place.typed_projections.push(SemaOwnershipProjection.Deref{span: span})
            Val(place)
        }
        .RawOf(value, span, _) -> {
            place := sema_ownership_place_from_expr_inner(value, scopes) ?? return None
            place.projections.push("*")
            place.typed_projections.push(SemaOwnershipProjection.Deref{span: span})
            Val(place)
        }
        .Copy(_, _, _) -> None
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_ownership_append_place_unique: fn(places: &[SemaOwnershipPlace], candidate: SemaOwnershipPlace) Never! {
    loop place in places {
        if sema_ownership_place_exact(place, candidate) -> return
    }
    places.push(candidate.copy())
}

sema_ownership_places_from_expr_in_state: fn(expr: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState) -> [SemaOwnershipPlace] {
    named_path := [String]{}
    named_root := sema_ownership_named_view_root(expr, named_path)
    if named_root == .Val(root_name) {
        binding_index: sema_scope_resolve_index_at(scopes, root_name, expr_span(expr))
        if binding_index == .Val(found_index) {
            carrier_key: scopes.bindings[found_index].symbol.id.key
            places := [SemaOwnershipPlace]{}
            typed: sema_ownership_typed_projection_facts(expr) ?? return [SemaOwnershipPlace]{}
            index := state.views.len() - 1
            loop index >= 0 {
                fact: state.views[index]
                if fact.active && fact.carrier_key == carrier_key && sema_ownership_path_starts(named_path, fact.output_path) {
                    place := sema_ownership_place_snapshot(fact.source)
                    loop suffix in fact.output_path.len()..<named_path.len() -> place.projections.push(named_path[suffix])
                    loop typed_suffix in fact.output_path.len()..<typed.len() -> place.typed_projections.push(typed[typed_suffix])
                    sema_ownership_append_place_unique(places, place)
                }
                index -= 1
            }
            if places.len() > 0 -> return places
        }
    }
    place: sema_ownership_place_from_expr_inner(expr, scopes) ?? return [SemaOwnershipPlace]{}
    [SemaOwnershipPlace]{place}
}

sema_ownership_typed_projection_overlap: fn(left: SemaOwnershipProjection, right: SemaOwnershipProjection) -> Bool Never! {
    if left == {
        .Field(name, _) -> if right == {
            .Field(other, _) -> name == other
            .Index(_, _) | .Range(_, _, _) | .Fresh(_) | .Deref(_) -> true
        }
        .Index(value, _) -> if right == {
            .Index(other, _) -> {
                if value != None && other != None -> return value == other
                true
            }
            .Range(start, end, _) -> {
                if value != None && start != None && end != None {
                    number := value
                    if number < start || number > end -> return false
                }
                true
            }
            .Field(_, _) | .Fresh(_) | .Deref(_) -> true
        }
        .Range(start, end, _) -> if right == {
            .Index(value, _) -> {
                if value != None && start != None && end != None {
                    number := value
                    if number < start || number > end -> return false
                }
                true
            }
            .Range(other_start, other_end, _) -> {
                if start != None && end != None && other_start != None && other_end != None {
                    if end < other_start || other_end < start -> return false
                }
                true
            }
            .Field(_, _) | .Fresh(_) | .Deref(_) -> true
        }
        .Fresh(span) -> if right == {
            .Fresh(other) -> sema_ownership_span_same(span, other)
            .Field(_, _) | .Index(_, _) | .Range(_, _, _) | .Deref(_) -> true
        }
        .Deref(_) -> true
    }
}

sema_ownership_typed_projection_exact: fn(left: SemaOwnershipProjection, right: SemaOwnershipProjection) -> Bool Never! {
    if left == {
        .Field(name, _) -> if right == {
            .Field(other, _) -> name == other
            .Index(_, _) | .Range(_, _, _) | .Fresh(_) | .Deref(_) -> false
        }
        .Index(value, _) -> if right == {
            .Index(other, _) -> value == other
            .Field(_, _) | .Range(_, _, _) | .Fresh(_) | .Deref(_) -> false
        }
        .Range(start, end, _) -> if right == {
            .Range(other_start, other_end, _) -> start == other_start && end == other_end
            .Field(_, _) | .Index(_, _) | .Fresh(_) | .Deref(_) -> false
        }
        .Fresh(span) -> if right == {
            .Fresh(other) -> sema_ownership_span_same(span, other)
            .Field(_, _) | .Index(_, _) | .Range(_, _, _) | .Deref(_) -> false
        }
        .Deref(span) -> if right == {
            .Deref(other) -> sema_ownership_span_same(span, other)
            .Field(_, _) | .Index(_, _) | .Range(_, _, _) | .Fresh(_) -> false
        }
    }
}

sema_ownership_places_overlap: fn(left: SemaOwnershipPlace, right: SemaOwnershipPlace) -> Bool Never! {
    if left.root_key == "" || right.root_key == "" -> return false
    if left.root_key != right.root_key -> return false
    if left.typed_projections.len() != left.projections.len() || right.typed_projections.len() != right.projections.len() -> return true
    limit := right.typed_projections.len()
    if left.typed_projections.len() < limit -> limit = left.typed_projections.len()
    loop index in 0..<limit {
        if !sema_ownership_typed_projection_overlap(left.typed_projections[index], right.typed_projections[index]) -> return false
    }
    true
}

// Rust `place_name`: a field projection keeps its name; an element index or a
// range window is `[…]`, whatever its bounds.
sema_ownership_place_name: fn(place: SemaOwnershipPlace) -> String Never! {
    name := place.root
    loop projection in place.projections {
        shown: if projection.starts_with("[") && projection != "[fresh]" -> "[…]" else -> projection
        name = "{name}{shown}"
    }
    name
}

sema_ownership_view_producer: fn(expr: Expr) -> SemaOwnershipViewProducer? {
    if expr == {
        .Paren(value, _, _) -> sema_ownership_view_producer(value)
        .Place(value, access, _, _) -> {
            convention: if access == PlaceAccess.Write -> AccessConvention.Write else -> AccessConvention.Read
            Val(SemaOwnershipViewProducer{source: value, access: convention, span: expr_span(expr)})
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_ownership_arena_view_source: fn(binding: Binding) -> Expr? {
    if !binding.arena_view -> return None
    if binding.init == {
        .MethodCall(receiver, method, _, _, _, _, _) -> {
            if method != "alloc" && method != "try_alloc" -> return None
            Val(receiver)
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_ownership_carrier_key: fn(scopes: SemaScopeTable, name: String, span: Span) -> String? {
    index: sema_scope_resolve_index_at(scopes, name, span) ?? return None
    Val(scopes.bindings[index].symbol.id.key)
}

sema_ownership_matching_loan_seq: fn(state: &SemaOwnershipState, source: SemaOwnershipPlace, span: Span) -> Int Never! {
    index := state.loans.len() - 1
    loop index >= 0 {
        loan: state.loans[index]
        if loan.access == AccessConvention.Write && loan.carrier_fact_seq < 0 && sema_ownership_span_same(loan.span, span) && sema_ownership_place_exact(loan.place, source) -> return loan.seq
        index -= 1
    }
    -1
}

sema_ownership_record_view_fact_inner: fn(state: &SemaOwnershipState, carrier: String, carrier_span: Span, source: SemaOwnershipPlace, output_path: [String], access: AccessConvention, scopes: SemaScopeTable, loan_seq: Int) -> Bool Never! {
    if source.root_key == "" -> return false
    key: sema_ownership_carrier_key(scopes, carrier, carrier_span) ?? return false
    associated_loan_span := carrier_span
    if loan_seq >= 0 {
        found_loan := false
        loop loan in state.loans {
            if loan.seq == loan_seq && loan.access == AccessConvention.Write && loan.carrier_fact_seq < 0 && sema_ownership_place_exact(loan.place, source) {
                associated_loan_span = loan.span
                found_loan = true
                break
            }
        }
        if !found_loan -> return false
    }
    stored_source := sema_ownership_place_snapshot(source)
    stored_output_path := [String]{}
    loop path in output_path -> stored_output_path.push(path.copy())
    fact_seq := sema_ownership_next_sequence(state)
    state.views.push(SemaOwnershipViewFact{
        carrier: carrier,
        carrier_key: key,
        carrier_span: carrier_span,
        source: stored_source,
        output_path: stored_output_path,
        access: access,
        scope_depth: state.scope_depth,
        seq: fact_seq,
        loan_seq: loan_seq,
        loan_span: associated_loan_span,
        active: true,
        invalidated: false,
        invalidated_span: carrier_span,
        invalidated_verb: "",
    })
    if loan_seq >= 0 {
        loop index in 0..<state.loans.len() {
            loan: state.loans[index]
            if loan.seq == loan_seq && loan.access == AccessConvention.Write && loan.carrier_fact_seq < 0 && sema_ownership_span_same(loan.span, associated_loan_span) && sema_ownership_place_exact(loan.place, source) {
                state.loans[index].carrier_fact_seq = fact_seq
                state.loans[index].carrier_key = key
                break
            }
        }
    }
    true
}

sema_ownership_record_view_fact: fn(state: &SemaOwnershipState, carrier: String, carrier_span: Span, source: SemaOwnershipPlace, output_path: [String], access: AccessConvention, scopes: SemaScopeTable, loan_seq: Int) -> Bool Never! {
    key: sema_ownership_carrier_key(scopes, carrier, carrier_span) ?? return false
    loop index in 0..<state.views.len() {
        if state.views[index].carrier_key == key && state.views[index].active -> state.views[index].active = false
    }
    sema_ownership_record_view_fact_inner(state, carrier, carrier_span, source, output_path, access, scopes, loan_seq)
}

// Borrowed payloads alias their matched storage. Owned/taken payloads retain
// ownership; all alternatives are recorded together for borrowed or-patterns.
sema_ownership_pattern_source_borrowed: fn(state: &SemaOwnershipState, source: Expr, scopes: SemaScopeTable) -> Bool {
    if source == {
        .Paren(inner, _, _) -> return sema_ownership_pattern_source_borrowed(state, inner, scopes)
        .Place(_, access, _, _) -> return access != PlaceAccess.Take
        .Copy(_, _, _) -> return false
        .Field(base, _, _, _) | .OptField(base, _, _, _, _, _) | .Index(base, _, _, _, _) | .Slice(base, _, _, _, _, _) -> {
            if sema_ownership_view_exists_for_expr(state, source, scopes) -> return true
            return sema_ownership_pattern_source_borrowed(state, base, scopes)
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    if sema_ownership_view_exists_for_expr(state, source, scopes) -> return true
    binding: sema_ownership_binding_for_expr(state, source, scopes) ?? return false
    sema_ownership_binding_is_borrowed_param(binding)
}

sema_ownership_record_pattern_views: fn(state: &SemaOwnershipState, carrier: String, span: Span, sources: [Expr], access: AccessConvention, scopes: SemaScopeTable) -> Bool {
    key: sema_ownership_carrier_key(scopes, carrier, span) ?? return false
    loop index in 0..<state.views.len() {
        if state.views[index].carrier_key == key && state.views[index].active -> state.views[index].active = false
    }
    if access == AccessConvention.Read {
        carrier_index: sema_scope_resolve_index_at(scopes, carrier, span) ?? return false
        if scopes.bindings[carrier_index].symbol.ty == .Val(ty) {
            if sema_ownership_type_is_scalar(ty) -> return false
        }
    }
    recorded := false
    loop source in sources {
        if access == AccessConvention.Read && !sema_ownership_pattern_source_borrowed(state, source, scopes) -> next
        loop place in sema_ownership_places_from_expr_in_state(source, scopes, state) {
            parent := -1
            loop fact in state.views {
                if fact.active && !fact.invalidated && sema_ownership_view_fact_matches_expr(fact, source, scopes) && sema_ownership_place_extends(fact.source, place) -> parent = fact.seq
            }
            loan_seq: if access == AccessConvention.Write -> sema_ownership_matching_loan_seq(state, place, expr_span(source)) else -> -1
            if sema_ownership_record_view_fact_inner(state, carrier, span, place, [String]{}, access, scopes, loan_seq) {
                index: state.views.len() - 1
                state.views[index].reborrow_parent = parent
                state.views[index].lexical = access == AccessConvention.Write
                recorded = true
            }
        }
    }
    recorded
}

// One match payload binding: its name at its declaration (a reused name in
// another arm is a different binding).
sema_ownership_payload_key: fn(name: String, span: Span) -> String Never! {
    "{name}@{span.start}"
}

sema_ownership_note_pattern_sources: fn(state: &SemaOwnershipState, symbol: Symbol, sources: &&[Expr]) Never! {
    state.pattern_sources[sema_ownership_payload_key(symbol.name, symbol.span)] = sources.move()
}

// `expr` (`p` or `p.f`) with its root name replaced by `source`.
sema_ownership_rebase_root: fn(expr: Expr, source: Expr) -> Expr Never! {
    if expr == {
        .Field(base, member, span, node) -> Expr.Field{base: sema_ownership_rebase_root(base, source), member: member, span: span, id: node}
        .Paren(inner, _, _) -> sema_ownership_rebase_root(inner, source)
        // copy: the moved place is a new path built on the binding's recorded
        // subject, which stays recorded for another `.move()` of the same binding.
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> source.copy()
    }
}

// An explicit `p.move()` (or `p.f.move()`) of a match payload binding takes the payload
// out of the subject it was read from, never a copy: the subject's payload
// place is moved like `subject.payload.move()` (a later use of the moved part is
// E0121), and a subject in a read parameter is E0201. A subject inside a
// collection element or a write parameter keeps its payload (the binding's
// own value, as before: an element has no hole to leave, and a write
// parameter's refill is not proven here). A list or map pattern's bindings
// record no subject (Expressions/Control.jet).
// -1: rejected; 0: not a match payload binding; 1: the payload is taken.
sema_ownership_move_pattern_payload: fn(state: &SemaOwnershipState, expr: Expr, mark_span: Span, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Int {
    root: sema_ownership_binding_for_expr(state, expr, scopes) ?? return 0
    key: sema_ownership_payload_key(root.symbol.name, root.symbol.span)
    // Taken out while the subject places are marked (marking writes the
    // state), then recorded again for another `.move()` of the same binding.
    sources: state.pattern_sources.remove(key) ?? return 0
    taken := 0
    loop source in sources {
        if source == {
            .Field(_, _, _, _) | .Ident(_, _, _) -> {}
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> next
        }
        place: sema_ownership_rebase_root(expr, source)
        owner: sema_ownership_binding_for_expr(state, place, scopes) ?? next
        // A payload of a payload binding: take it from the outer subject. A
        // binding that refines its own subject (`x == .Val(x)`) is its root.
        own_root: owner.symbol.name == root.symbol.name && owner.symbol.span.start == root.symbol.span.start
        nested: if own_root -> 0 else -> sema_ownership_move_pattern_payload(state, place, mark_span, scopes, diagnostics)
        if nested < 0 -> return -1
        if nested > 0 {
            taken = 1
            next
        }
        element: if place == {
            .Index(_, _, _, _, _) -> true
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> sema_expression_place_below_element(place)
        }
        if element -> next
        if owner.symbol.kind == SymbolKind.Parameter && owner.access == AccessConvention.Read {
            diagnostics.push(sema_ownership_diag_move_from_borrowed(root.symbol.name, None, mark_span))
            return -1
        }
        if sema_ownership_binding_lends(owner) -> next
        if !sema_ownership_mark_move(state, place, scopes, "`{root.symbol.name}.move()`", diagnostics) -> return -1
        taken = 1
    }
    state.pattern_sources[key] = sources.move()
    taken
}

sema_ownership_record_binding_view: fn(state: &SemaOwnershipState, binding: Binding, scopes: SemaScopeTable) -> Bool {
    if sema_ownership_arena_view_source(binding) == .Val(source_expr) {
        return sema_ownership_record_fresh_view_fact(state, binding.name, binding.name_span, source_expr, [String]{}, AccessConvention.Write, scopes, binding.name_span)
    }
    producer: sema_ownership_view_producer(binding.init) ?? return false
    places := sema_ownership_places_from_expr_in_state(producer.source, scopes, state)
    if places.len() == 0 -> return false
    key: sema_ownership_carrier_key(scopes, binding.name, binding.name_span) ?? return false
    loop index in 0..<state.views.len() {
        if state.views[index].carrier_key == key && state.views[index].active -> state.views[index].active = false
    }
    valid := true
    loop place in places {
        parent: sema_ownership_reborrow_parent(state, producer.source, place, producer.access, scopes)
        loan_seq := sema_ownership_matching_loan_seq(state, place, producer.span)
        if !sema_ownership_record_view_fact_inner(state, binding.name, binding.name_span, place, [String]{}, producer.access, scopes, loan_seq) {
            valid = false
            next
        }
        recorded: state.views.len() - 1
        state.views[recorded].reborrow_parent = parent
    }
    valid
}

sema_ownership_append_view_source_projections: fn(place: SemaOwnershipPlace, projections: [ViewSourceProjection], span: Span) -> SemaOwnershipPlace Never! {
    result := sema_ownership_place_snapshot(place)
    loop projection in projections {
        if projection == {
            .Field(name) -> {
                result.projections.push(".{name}")
                result.typed_projections.push(SemaOwnershipProjection.Field{name: name, span: span})
            }
            .Index -> {
                result.projections.push("[]")
                result.typed_projections.push(SemaOwnershipProjection.Index{value: None, span: span})
            }
            .Range -> {
                result.projections.push("[..]")
                result.typed_projections.push(SemaOwnershipProjection.Range{start: None, end: None, span: span})
            }
        }
    }
    result
}

sema_ownership_record_call_view_batch: fn(state: &SemaOwnershipState, carrier: String, carrier_span: Span, facts: [SemaOwnershipCallViewFact], scopes: SemaScopeTable) -> Bool Never! {
    if facts.len() == 0 -> return false
    key: sema_ownership_carrier_key(scopes, carrier, carrier_span) ?? return false
    place_count := 0
    loop fact in facts -> place_count += fact.places.len()
    if place_count == 0 -> return false
    loop index in 0..<state.views.len() {
        if state.views[index].carrier_key == key && state.views[index].active -> state.views[index].active = false
    }
    valid := true
    loop fact in facts {
        loop place in fact.places {
            if !sema_ownership_record_view_fact_inner(state, carrier, carrier_span, place, fact.output_path, fact.access, scopes, -1) -> valid = false
        }
    }
    valid
}

sema_ownership_record_fresh_view_fact: fn(state: &SemaOwnershipState, carrier: String, carrier_span: Span, source_expr: Expr, output_path: [String], access: AccessConvention, scopes: SemaScopeTable, proof_span: Span) -> Bool {
    places := sema_ownership_places_from_expr_in_state(source_expr, scopes, state)
    if places.len() == 0 -> return false
    key: sema_ownership_carrier_key(scopes, carrier, carrier_span) ?? return false
    loop index in 0..<state.views.len() {
        if state.views[index].carrier_key == key && state.views[index].active -> state.views[index].active = false
    }
    valid := true
    loop source in places {
        place := sema_ownership_place_snapshot(source)
        place.projections.push("[fresh]")
        place.typed_projections.push(SemaOwnershipProjection.Fresh{span: proof_span})
        if !sema_ownership_record_view_fact_inner(state, carrier, carrier_span, place, output_path, access, scopes, -1) -> valid = false
    }
    valid
}

sema_ownership_invalidate_view_owner: fn(state: &SemaOwnershipState, owner: SemaOwnershipPlace, verb: String, span: Span) Never! {
    if owner.root_key == "" -> return
    loop index in 0..<state.views.len() {
        if state.views[index].active && !state.views[index].invalidated && state.views[index].source.root_key == owner.root_key {
            state.views[index].invalidated = true
            state.views[index].invalidated_span = span
            state.views[index].invalidated_verb = verb
        }
    }
}

sema_ownership_view_source_projection: fn(projection: SemaOwnershipProjection) -> ViewSourceProjection? {
    if projection == {
        .Field(name, _) -> Val(ViewSourceProjection.Field{name: name})
        .Index(_, _) -> Val(ViewSourceProjection.Index)
        .Range(_, _, _) -> Val(ViewSourceProjection.Range)
        .Fresh(_) | .Deref(_) -> None
    }
}

sema_ownership_view_source_for_place: fn(place: SemaOwnershipPlace, receiver_key: String, parameter_keys: [String], scopes: SemaScopeTable) -> ViewSourcePath? {
    loop binding_index in 0..<scopes.bindings.len() {
        if scopes.bindings[binding_index].symbol.id.key == place.root_key {
            source := ViewSource?{None}
            if {
                receiver_key != "" && receiver_key == place.root_key -> source = Val(ViewSource.Receiver)
                else -> {
                    loop (parameter_index, parameter_key) in parameter_keys {
                        if parameter_key == place.root_key {
                            source = Val(ViewSource.Parameter{index: parameter_index})
                            break
                        }
                    }
                }
            }
            actual_source: source ?? return None
            if place.typed_projections.len() != place.projections.len() -> return None
            projections := [ViewSourceProjection]{}
            loop projection in place.typed_projections {
                converted: sema_ownership_view_source_projection(projection) ?? return None
                projections.push(converted)
            }
            return Val(ViewSourcePath{source: actual_source, projections: projections})
        }
    }
    None
}

sema_ownership_view_source_equal: fn(left: ViewSource, right: ViewSource) -> Bool Never! {
    if left == {
        .Receiver -> if right == {
            .Receiver -> true
            .Parameter(_) | .Static(_, _) -> false
        }
        .Parameter(index) -> if right == {
            .Parameter(other) -> index == other
            .Receiver | .Static(_, _) -> false
        }
        .Static(module_path, name) -> if right == {
            .Static(other_module, other_name) -> module_path == other_module && name == other_name
            .Receiver | .Parameter(_) -> false
        }
    }
}

sema_ownership_view_projection_equal: fn(left: ViewSourceProjection, right: ViewSourceProjection) -> Bool Never! {
    if left == {
        .Field(name) -> if right == {
            .Field(other) -> name == other
            .Index | .Range -> false
        }
        .Index -> if right == {
            .Index -> true
            .Field(_) | .Range -> false
        }
        .Range -> if right == {
            .Range -> true
            .Field(_) | .Index -> false
        }
    }
}

sema_ownership_view_source_path_equal: fn(left: ViewSourcePath, right: ViewSourcePath) -> Bool Never! {
    if !sema_ownership_view_source_equal(left.source, right.source) -> return false
    if left.projections.len() != right.projections.len() -> return false
    loop (index, projection) in left.projections {
        if !sema_ownership_view_projection_equal(projection, right.projections[index]) -> return false
    }
    true
}

sema_ownership_view_slot_equal: fn(left: [String], right: [String]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop (index, segment) in left {
        if segment != right[index] -> return false
    }
    true
}

sema_ownership_string_list_snapshot: fn(source: [String]) -> [String] Never! {
    result := [String]{}
    loop segment in source -> result.push(segment.copy())
    result
}

sema_ownership_diag_view_return_owner: fn(place: SemaOwnershipPlace, span: Span, aggregate: Bool) -> Diagnostic {
    owner := if aggregate -> place.root else -> sema_ownership_view_owner_name(place)
    sema_error("E2305", span, "this view points into `{owner}`, which this function owns", "`{owner}` is made here and freed when the function returns, so a read window into it would outlive what owns it — there'd be nothing left to look at", "return an owned copy with `place.copy()` (for example `value[a..b].copy()`), or accept the source as a parameter so the caller keeps owning it")
}

// The place a returned window points into: the window's own trailing element
// and range projections are not part of its owner.
sema_ownership_view_owner_name: fn(place: SemaOwnershipPlace) -> String Never! {
    kept := place.projections.len()
    loop kept > 0 && place.projections[kept - 1].starts_with("[") -> kept -= 1
    name := place.root
    loop index in 0..<kept {
        projection: place.projections[index]
        shown: if projection.starts_with("[") && projection != "[fresh]" -> "[…]" else -> projection
        name = "{name}{shown}"
    }
    name
}

sema_ownership_diag_view_return_boundary: fn(span: Span) -> Diagnostic {
    sema_error("E2305", span, "returned views need a stable owner relationship", "each public `View`/`ViewMut` slot must name a bounded set of receiver, parameter, or static sources that stay live; this return did not prove those sources", "return a view derived from parameters or the receiver on every path, keep the view local, or return an owned copy with `.copy()`")
}

// Rust `consumed_view_owner` (#4392): a `&&` parameter (or `&&self`) moves into
// this function and is freed when it returns, so it cannot own a returned
// view. A consumed view carrier differs: its windows still borrow the
// caller's owner.
sema_ownership_consumed_view_owner: fn(place: SemaOwnershipPlace, scopes: SemaScopeTable) -> Bool Never! {
    loop binding_index in 0..<scopes.bindings.len() {
        if scopes.bindings[binding_index].symbol.id.key != place.root_key -> next
        if scopes.bindings[binding_index].access != AccessConvention.Move -> return false
        ty: scopes.bindings[binding_index].symbol.ty ?? return true
        if ty == {
            .Apply(name, args) -> return !((name == "View" || name == "ViewMut") && args.len() == 1)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return true
        }
    }
    false
}

sema_ownership_diag_view_return_consumed: fn(place: SemaOwnershipPlace, span: Span, aggregate: Bool) -> Diagnostic {
    owner := if aggregate -> place.root else -> sema_ownership_view_owner_name(place)
    sema_error("E2305", span, "this view points into `{owner}`, which this function consumes", "the `&&` parameter `{owner}` moves the value into this function, which frees it when it returns, so a returned window into it would outlive its owner", "take `{owner}` as a read or `&` parameter so the caller keeps owning it, or return an owned copy with `.copy()`")
}

sema_ownership_place_has_fresh_projection: fn(place: SemaOwnershipPlace) -> Bool Never! {
    loop projection in place.typed_projections {
        if projection == {
            .Fresh(_) -> return true
            .Field(_, _) | .Index(_, _) | .Range(_, _, _) | .Deref(_) -> {}
        }
    }
    false
}

sema_ownership_diag_view_return_access: fn(span: Span) -> Diagnostic {
    sema_error("E2305", span, "returned view paths disagree about read or write access", "one public output slot cannot sometimes be a read view and sometimes be an exclusive write view", "return the same view access on every path")
}

sema_ownership_record_view_return: fn(state: &SemaOwnershipState, place: SemaOwnershipPlace, access: AccessConvention, output_path: [String], receiver_key: String, parameter_keys: [String], scopes: SemaScopeTable, provenance: &ViewProvenanceMap, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if sema_ownership_place_has_fresh_projection(place) {
        diagnostics.push(sema_ownership_diag_view_return_boundary(span))
        return false
    }
    source_path: sema_ownership_view_source_for_place(place, receiver_key, parameter_keys, scopes) ?? {
        diagnostics.push(sema_ownership_diag_view_return_owner(place, span, output_path.len() > 0))
        return false
    }
    if sema_ownership_consumed_view_owner(place, scopes) {
        diagnostics.push(sema_ownership_diag_view_return_consumed(place, span, output_path.len() > 0))
        return false
    }
    mutable := access == AccessConvention.Write
    loop entry_index in 0..<provenance.entries.len() {
        entry: provenance.entries[entry_index]
        if sema_ownership_view_slot_equal(entry.slot, output_path) {
            if entry.value.mutable != mutable {
                diagnostics.push(sema_ownership_diag_view_return_access(span))
                return false
            }
            loop existing_source in entry.value.sources {
                if sema_ownership_view_source_path_equal(existing_source, source_path) -> return true
            }
            provenance.entries[entry_index].value.sources.push(source_path)
            return true
        }
    }
    sources := [ViewSourcePath]{}
    sources.push(source_path)
    provenance.entries.push(ViewProvenanceEntry{
        slot: sema_ownership_string_list_snapshot(output_path),
        value: ViewProvenance{sources: sources, mutable: mutable},
    })
    true
}

sema_ownership_record_view_returns: fn(state: &SemaOwnershipState, places: [SemaOwnershipPlace], access: AccessConvention, output_path: [String], receiver_key: String, parameter_keys: [String], scopes: SemaScopeTable, provenance: &ViewProvenanceMap, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if places.len() == 0 {
        diagnostics.push(sema_ownership_diag_view_return_boundary(span))
        return false
    }
    loop place in places {
        if sema_ownership_view_source_for_place(place, receiver_key, parameter_keys, scopes) == None {
            if {
                sema_ownership_place_has_fresh_projection(place) -> diagnostics.push(sema_ownership_diag_view_return_boundary(span))
                else -> diagnostics.push(sema_ownership_diag_view_return_owner(place, span, output_path.len() > 0))
            }
            return false
        }
    }
    mutable := access == AccessConvention.Write
    loop entry in provenance.entries {
        if sema_ownership_view_slot_equal(entry.slot, output_path) && entry.value.mutable != mutable {
            diagnostics.push(sema_ownership_diag_view_return_access(span))
            return false
        }
    }
    loop place in places {
        if !sema_ownership_record_view_return(state, place, access, output_path, receiver_key, parameter_keys, scopes, provenance, span, diagnostics) -> return false
    }
    true
}

sema_ownership_diag_live_reference: fn(place: String, span: Span) -> Diagnostic {
    sema_error("E0212", span, "`{place}` already has a live reference that conflicts with this access", "an exclusive write window cannot overlap another live reference to the same place", "finish using the earlier reference before opening this one")
}

// Rust `check_place_change_with_view_exemption`: changing a place a live
// view looks into. A pin promises its storage keeps
// its address, so it reports E0219 with the change it forbids; every other
// view reports E0212 naming the view and the change. Without a change
// wording (a receiver hook that knows no method) the general E0212 stays.
sema_ownership_diag_view_change: fn(fact: SemaOwnershipViewFact, changed: SemaOwnershipPlace, action: String, span: Span, scopes: SemaScopeTable) -> Diagnostic {
    changed_name: sema_ownership_place_name(changed)
    if action == "" -> return sema_ownership_diag_live_reference(changed_name, span)
    view: fact.carrier
    place: sema_ownership_place_name(fact.source)
    if sema_pin_view_fact(fact, scopes) -> return sema_error("E0219", span, "`{changed_name}` cannot {action} while it is pinned", "`{view}` pinned `{place}`, which promises that storage keeps its address; moving or replacing it would leave every stored address pointing at the old place", "finish using `{view}` before changing `{changed_name}`, or narrow the pin's scope")
    access: if fact.access == AccessConvention.Write -> "exclusive mutable view" else -> "read view"
    sema_error("E0212", span, "`{changed_name}` cannot {action} while `{view}` is still looking into it", "`{view}` is a live {access} into `{place}`; changing or moving the owner could invalidate that view", "finish using `{view}` before changing `{changed_name}`, narrow the view's scope, or make an owned copy")
}

// A loan a named view carries is that view's fact (Rust keeps only the
// fact); an anonymous statement window has no view to name.
sema_ownership_diag_loan_change: fn(state: &SemaOwnershipState, loan: SemaOwnershipLoan, changed: SemaOwnershipPlace, action: String, span: Span, scopes: SemaScopeTable) -> Diagnostic {
    if loan.carrier_fact_seq >= 0 {
        loop fact in state.views {
            if fact.seq == loan.carrier_fact_seq && fact.carrier_key == loan.carrier_key -> return sema_ownership_diag_view_change(fact, changed, action, span, scopes)
        }
    }
    sema_ownership_diag_live_reference(sema_ownership_place_name(changed), span)
}

// Rust `check_place_read` (card #1361 / I2): reading a place beside a live
// exclusive window into it is E0220; reading through the window is the
// legal path.
sema_ownership_diag_owner_read: fn(fact: SemaOwnershipViewFact, read: SemaOwnershipPlace, span: Span, scopes: SemaScopeTable) -> Diagnostic {
    read_name: sema_ownership_place_name(read)
    view: fact.carrier
    window: if sema_pin_view_fact(fact, scopes) -> "pin" else -> "exclusive write window"
    sema_error("E0220", span, "`{read_name}` cannot be read while `{view}` has a live {window} into it", "`{view}` is an exclusive window into `{sema_ownership_place_name(fact.source)}`; reading the owner beside that window would be rejected after lowering", "read or edit through `{view}` instead of `{read_name}`")
}

// The E0220 check on one complete place expression, before its base is read.
sema_ownership_check_owner_read: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    loop place in sema_ownership_places_from_expr_in_state(expr, scopes, state) {
        if sema_ownership_conflicting_view_for_expr(state, place, AccessConvention.Read, expr, scopes) == .Val(fact) {
            diagnostics.push(sema_ownership_diag_owner_read(fact, place, expr_span(expr), scopes))
            return false
        }
    }
    true
}

sema_ownership_open_reference_for_expr: fn(state: &SemaOwnershipState, expr: Expr, access: AccessConvention, span: Span, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if sema_ownership_report_invalidated_view(state, expr, scopes, span, diagnostics) -> return false
    places := sema_ownership_places_from_expr_in_state(expr, scopes, state)
    if places.len() == 0 -> return false
    loop place in places {
        if access == AccessConvention.Write && sema_ownership_place_refuses_write(state, place, scopes) {
            sema_ownership_report_static_write(state, place, expr_span(expr), diagnostics)
            return false
        }
        if sema_ownership_view_open_deferred(state, span) -> next
        if sema_ownership_active_view_conflict_for_expr(state, place, access, expr, scopes) {
            diagnostics.push(sema_ownership_diag_live_reference(sema_ownership_place_name(place), span))
            return false
        }
        conflict: sema_ownership_active_loan_conflict_for_expr(state, place, access, expr, scopes)
        if conflict != None {
            diagnostics.push(sema_ownership_diag_live_reference(sema_ownership_place_name(place), span))
            return false
        }
    }
    kind: if access == AccessConvention.Write -> SemaOwnershipReferenceKind.Write else -> SemaOwnershipReferenceKind.Read
    index := 0
    loop index < places.len() {
        place := places[index]
        if !sema_ownership_exact_view_carrier_for_place(state, expr, place, scopes) {
            loan_seq := sema_ownership_next_sequence(state)
            state.loans.push(SemaOwnershipLoan{place: place, access: access, span: span, scope_depth: state.scope_depth, seq: loan_seq, carrier_fact_seq: -1, carrier_key: ""})
        }
        sema_ownership_note_place_reference(state, expr, place, span, scopes, kind)
        index += 1
    }
    true
}

// The windows a binding statement's initializer (`right: &xs[1..2]`) or a
// `ViewMut` list literal's elements open are checked against the other
// views where the value lands (Rust `record_view_with_exemptions`, Rust
// `check_list_view_element_aliases`), which name the binding or the
// element; the open itself does not report that overlap.
sema_ownership_view_open_deferred: fn(state: SemaOwnershipState, span: Span) -> Bool Never! {
    loop deferred in state.deferred_view_opens {
        if sema_ownership_span_same(deferred, span) -> return true
    }
    false
}

// Rust `record_view_with_exemptions`: a new view conflicts with a live view
// over an overlapping place when either of them writes; the binding being
// recorded and its own earlier facts for the same slot are alternatives, and
// a window opened through a live view reborrows that view's lineage. False
// when the open conflicts (its E0212 is pushed).
sema_ownership_check_binding_view_conflicts: fn(state: &SemaOwnershipState, carrier: String, carrier_span: Span, source: Expr, places: [SemaOwnershipPlace], access: AccessConvention, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    key: sema_ownership_carrier_key(scopes, carrier, carrier_span) ?? return true
    loop place in places {
        parent: sema_ownership_reborrow_parent(state, source, place, access, scopes)
        loop fact in state.views {
            if !fact.active || fact.invalidated || fact.contested || fact.carrier_key == key -> next
            if sema_ownership_is_reborrow_lineage(state, fact, parent) -> next
            if (fact.access == AccessConvention.Write || access == AccessConvention.Write) && sema_ownership_places_overlap(fact.source, place) {
                diagnostics.push(sema_error("E0212", carrier_span, "`{sema_ownership_place_name(place)}` already has a live view that conflicts with `{carrier}`", "many read views may overlap, but an exclusive mutable view cannot overlap any other live view", "finish using the earlier view before creating this one, or make an owned copy"))
                return false
            }
        }
    }
    true
}

// The `&place` elements of a list literal whose element type is `ViewMut`:
// their windows coexist in the list, so each one is judged against the
// earlier elements (sema_ownership_check_list_view_element_aliases).
sema_ownership_list_view_element_spans: fn(elements: [Expr]) -> [Span] Never! {
    spans := [Span]{}
    loop element in elements {
        if element == .Place(_, access, span, _) && access == PlaceAccess.Write -> spans.push(span.copy())
    }
    spans
}

// Rust `check_list_view_element_aliases`: list elements coexist, so an
// exclusive mutable view cannot overlap another element's view.
sema_ownership_check_list_view_element_aliases: fn(state: &SemaOwnershipState, elements: [Expr], element_ty: Type, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) {
    direct_mutable: if element_ty == {
        .Apply(name, _) -> name == "ViewMut"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
    previous := [SemaOwnershipPlace]{}
    previous_access := [AccessConvention]{}
    loop element in elements {
        sources := [SemaOwnershipPlace]{}
        access := AccessConvention.Read
        if element == .MethodCall(receiver, method, _, _, _, _, _) && method == "view" {
            loop place in sema_ownership_places_from_expr_in_state(receiver, scopes, state) {
                windowed := place
                windowed.projections.push("[..]")
                windowed.typed_projections.push(SemaOwnershipProjection.Range{start: None, end: None, span: expr_span(element)})
                sources.push(windowed)
            }
        }
        if sources.len() == 0 && direct_mutable {
            sources = sema_ownership_places_from_expr_in_state(element, scopes, state)
            access = AccessConvention.Write
        }
        loop place in sources {
            loop index in 0..<previous.len() {
                if (previous_access[index] == AccessConvention.Write || access == AccessConvention.Write) && sema_ownership_places_overlap(previous[index], place) {
                    diagnostics.push(sema_error("E0212", expr_span(element), "list elements create overlapping views of `{sema_ownership_place_name(place)}`", "list elements coexist, so an exclusive mutable view cannot overlap another element's view", "use disjoint ranges, keep only one mutable view, or store owned values"))
                    break
                }
            }
            previous.push(place)
            previous_access.push(access.copy())
        }
    }
}

// Open a mutable place window in one ownership transaction.  This is distinct
// from check_write: a write borrow keeps a live loan until its lexical scope
sema_ownership_open_write_reference: fn(state: &SemaOwnershipState, expr: Expr, span: Span, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if sema_ownership_reject_frozen_write(state, expr, "be edited", span, scopes, diagnostics) -> return false
    if sema_ownership_report_invalidated_view(state, expr, scopes, span, diagnostics) -> return false
    places := sema_ownership_places_from_expr_in_state(expr, scopes, state)
    if places.len() == 0 {
        if sema_ownership_writes_temporary_edit_guard(expr) -> return true
        diagnostics.push(sema_error("E0225", span, "`&` marks a fresh value, not a named place", "a write window lends a named place; a temporary value has no place to lend", "bind the value with `:=` first, then take the window from that name"))
        return false
    }
    loop place in places {
        if sema_ownership_place_refuses_write(state, place, scopes) {
            sema_ownership_report_static_write(state, place, expr_span(expr), diagnostics)
            return false
        }
        if sema_ownership_view_open_deferred(state, span) -> next
        if sema_ownership_active_view_conflict_for_expr(state, place, AccessConvention.Write, expr, scopes) {
            diagnostics.push(sema_ownership_diag_live_reference(sema_ownership_place_name(place), span))
            return false
        }
        conflict: sema_ownership_active_loan_conflict_for_expr(state, place, AccessConvention.Write, expr, scopes)
        if conflict != None {
            diagnostics.push(sema_ownership_diag_live_reference(sema_ownership_place_name(place), span))
            return false
        }
    }
    has_view := sema_ownership_view_exists_for_expr(state, expr, scopes)
    if has_view && sema_ownership_view_has_access(state, expr, scopes, AccessConvention.Read) {
        diagnostics.push(sema_error("E0205", span, "cannot edit through `{places[0].root}` — it has read access only", "a read window may inspect its place, but it cannot change the owner", "take a write window from a mutable owner instead"))
        return false
    }
    binding: sema_ownership_binding_for_expr(state, expr, scopes) ?? return false
    info: binding
    if sema_ownership_writes_read_shared_guard(expr, scopes) {
        diagnostics.push(sema_ownership_diag_read_shared_guard_write(span))
        return false
    }
    if !has_view && !info.mutable && info.access != AccessConvention.Write && !sema_ownership_binding_is_edit_shared_guard(info) && !sema_ownership_writes_through_view_type(expr, info.symbol.ty) {
        // Rust `validate_write_place`: a parameter is E0205, a local E0111.
        if info.symbol.kind == SymbolKind.Parameter {
            param_ty: info.symbol.ty ?? Type.Named{name: "Unit"}
            // A `View<T>` lends read windows only; a `&` marker on it would
            // still be a read view, so the fix names `ViewMut<T>`.
            read_view := false
            if sema_expr_unwrap_tag(param_ty) == .Apply(view_name, _) -> read_view = view_name == "View"
            if read_view {
                diagnostics.push(sema_error("E0205", span, "cannot take a write window through {sema_type_show(param_ty)} — it has read access only", "a `View<T>` may inspect its owner's elements, but it cannot change them", "take the write window from a `ViewMut<T>` or from the mutable owner instead"))
            } else {
                diagnostics.push(sema_error("E0205", span, "cannot take a write window into `{places[0].root}`", "an unmarked parameter gives read access only; a write window needs write access", "change the parameter to `{places[0].root}: &{type_name(param_ty)}`"))
            }
        } else {
            diagnostics.push(sema_ownership_diag_unchangeable(info, places[0].root, span, "a write window can change its owner, so the owner must be mutable (`:=`)"))
        }
        return false
    }
    index := 0
    loop index < places.len() {
        place := places[index]
        if !sema_ownership_exact_write_carrier(state, expr, place, scopes) {
            loan_seq := sema_ownership_next_sequence(state)
            state.loans.push(SemaOwnershipLoan{place: place, access: AccessConvention.Write, span: span, scope_depth: state.scope_depth, seq: loan_seq, carrier_fact_seq: -1, carrier_key: ""})
        }
        sema_ownership_note_place_reference(state, expr, place, span, scopes, SemaOwnershipReferenceKind.Write)
        index += 1
    }
    true
}

sema_ownership_place_moved: fn(state: &SemaOwnershipState, place: SemaOwnershipPlace) -> SemaOwnershipMovedPlace? {
    loop moved in state.moved {
        if moved.origin.deferred_depth == None && sema_ownership_places_overlap(moved.place, place) -> return Val(moved)
    }
    None
}

// Whether `expr`'s place was moved at a site before `expr`: an earlier
// argument of its call, not a later one whose nested move typing recorded.
sema_ownership_moved_before: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable) -> Bool {
    start: expr_span(expr).start
    loop place in sema_ownership_places_from_expr_in_state(expr, scopes, state) {
        if sema_ownership_place_moved(state, place) == .Val(moved) && moved.origin.span.start < start -> return true
    }
    false
}

// The deferred `close` that takes `place` when its scope exits.
sema_ownership_place_deferred: fn(state: &SemaOwnershipState, place: SemaOwnershipPlace) -> SemaOwnershipMovedPlace? {
    loop moved in state.moved {
        if moved.origin.deferred_depth != None && sema_ownership_places_overlap(moved.place, place) -> return Val(moved)
    }
    None
}

// The moves a `defer close(name)` or a `defer` body just recorded from
// `moved_before` on happen when the current scope exits.
sema_ownership_defer_moves: fn(state: &SemaOwnershipState, moved_before: Int) Never! {
    loop index in moved_before..<state.moved.len() -> state.moved[index].origin.deferred_depth = Val(state.scope_depth)
}

// An unmarked move site that a later use reached checks
// as the copy `name.copy()`, so the source stays usable.
sema_ownership_is_share_site: fn(state: SemaOwnershipState, span: Span) -> Bool Never! {
    loop site in state.share_known {
        if sema_ownership_span_same(site, span) -> return true
    }
    false
}

// (Rust `move_is_shareable`): only a whole binding moved
// by its plain name, whose type is not known to refuse a copy, can later
// become a share. Rust keys that move on the binding itself
// (`mark_moved(name)`), so a read payload or view binding moved by name
// qualifies even though its places chase to projections of its source. The
// function check confirms the copy against the registry before using it.
// A one-pass source (Iter, Stream, Body) has no copy to give, and
// `copies: .Explicit` forbids the hidden copy, so either keeps the move and a
// later use is E0121.
sema_ownership_move_origin: fn(expr: Expr, ty: Type, consumer: String, unmarked: Bool, copies_explicit: Bool) -> SemaOwnershipMoveOrigin {
    plain_name := if expr == {
        .Ident(_, _, _) -> true
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
    shareable: unmarked && plain_name && !copies_explicit && !sema_call_reflection_one_pass(ty) && sema_ownership_type_cloneable(ty) != (Val(false))
    share_ty: if shareable -> Val(ty) else -> None
    moved_ty: if plain_name -> Val(ty) else -> None
    SemaOwnershipMoveOrigin{span: expr_span(expr), consumer: consumer, share_ty: share_ty, moved_ty: moved_ty}
}

// A use after a move stays E0121 in this check. When the move was
// unmarked, the use also records the move site, so the next check of the
// function treats that site as a share and this use is valid.
// An exact `.move()` names the moved place; an unmarked move of a whole
// binding names the place this use reads (`a.id`).
sema_ownership_report_moved: fn(state: &SemaOwnershipState, moved: SemaOwnershipMovedPlace, used: SemaOwnershipPlace, span: Span, diagnostics: &[Diagnostic]) {
    if moved.origin.once_capture == .Val(capture) {
        name: sema_ownership_place_name(moved.place)
        label: if sema_ownership_span_same(moved.origin.span, span) -> "`{name}` ran here on an earlier loop iteration" else -> "`{name}` ran here"
        diagnostics.push(diagnostic_with_label(sema_error("E0121", span, "`{name}` can run only once, and it already ran", "`{name}` takes its captured `{capture}` with `{capture}.move()`, so its first call gave `{capture}` away", "call `{name}` once, or let it pass a copy of `{capture}` (`{capture}.copy()`) instead of taking it"), moved.origin.span, label))
        return
    }
    if moved.origin.implicit_take == .Val(callee) {
        sema_ownership_report_implicit_take_reused(callee, sema_ownership_place_name(moved.place), moved.origin.span, span, diagnostics)
        return
    }
    // copy: `ty` is a payload of read parameter `moved`, which keeps the original; field `ty` of the new SemaOwnershipShareSite owns this one
    if moved.origin.share_ty == .Val(ty) -> sema_ownership_note_share_found(state, SemaOwnershipShareSite{span: moved.origin.span, ty: ty.copy()})
    shown: if moved.origin.share_ty != None -> used else -> moved.place
    diagnostics.push(sema_ownership_diag_moved(sema_ownership_place_name(shown), moved.origin, span))
}

// E0209 (Rust `implicit_take_reused`): an argument to a take parameter moved
// its name, and a later use (or the next loop iteration) still needs the
// value. A call never copies on its own, so the fix is the explicit copy at
// the argument; one report per argument however many later uses reach it.
sema_ownership_report_implicit_take_reused: fn(callee: String, name: String, site: Span, reuse: Span, diagnostics: &[Diagnostic]) {
    loop existing in diagnostics {
        if existing.code == "E0209" && existing.span == .Val(known) {
            if sema_ownership_span_same(known, site) -> return
        }
    }
    label: if sema_ownership_span_same(site, reuse) -> "the next loop iteration passes `{name}` here again" else -> "`{name}` is used again here"
    consumer: sema_ownership_callee_text(callee)
    diagnostic: sema_error("E0209", site, "{consumer} takes `{name}`, but `{name}` is used again later", "{consumer} takes ownership of this argument, and a call never copies on its own, so `{name}` has no value after this call", "write `{name}.copy()` to pass a copy and keep `{name}`, or reorder so this call is the last use of `{name}`")
    labeled: diagnostic_with_label(diagnostic, reuse, label)
    diagnostics.push(diagnostic_with_edit_grade(labeled, TextEdit{span: Span{start: site.end, end: site.end}, new_text: ".copy()"}, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving))
}

sema_ownership_note_share_found: fn(state: &SemaOwnershipState, found: SemaOwnershipShareSite) Never! {
    loop site in state.share_found {
        if sema_ownership_span_same(site.span, found.span) -> return
    }
    state.share_found.push(found.copy())
}

// A share site found on a branch path is found for the
// function even when that path's check stops early (its E0121 is the reason
// it stopped) or never reaches the join; the next pass treats it as a share.
sema_ownership_keep_share_found: fn(state: &SemaOwnershipState, branch: SemaOwnershipState) Never! {
    loop site in branch.share_found -> sema_ownership_note_share_found(state, site)
}

// E0121 names the consumer every move recorder supplies and points a labelled
// caret at the move site, so the reader sees both where the value went and
// the later use. The reuse stays the primary span. A one-pass source has no
// copy to give, so a note names its materializer or a fresh source instead.
sema_ownership_diag_moved: fn(place: String, origin: SemaOwnershipMoveOrigin, span: Span) -> Diagnostic {
    consumer: origin.consumer
    same_site: origin.span.start == span.start && origin.span.end == span.end
    label: if same_site -> "`{place}` moved to {consumer} here on an earlier loop iteration" else -> "`{place}` moved to {consumer} here"
    diagnostic: sema_error(
        "E0121",
        span,
        "`{place}` was consumed by {consumer}, so it can't be used here",
        "After a value moves somewhere else, its old name no longer gives access to it",
        "Stop using `{place}` after the move, or give {consumer} a copy with `{place}.copy()` where it moved.",
    )
    labeled: diagnostic_with_label(diagnostic, origin.label_span ?? origin.span, label)
    if origin.moved_ty == .Val(ty) && sema_call_reflection_one_pass(ty) -> return diagnostic_with_detail(labeled, sema_ownership_one_pass_note(place, ty))
    // A value consumed by `close` is a Close resource that is now closed: it
    // has no copy to give, so a note says to acquire a new one instead.
    if consumer == "`close`" && origin.moved_ty == .Val(ty) {
        if ty == {
            .Named(name) | .Apply(name, _) -> return diagnostic_with_detail(labeled, " Note: acquire a new `{sema_call_reflection_leaf_name(name)}` resource; closed resources cannot be copied or reused")
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
        }
    }
    labeled
}

// Rust `one_pass_materializer`: an Iter or ViewIter materializes with
// `.to_list()` and a Body with `.text(limit)`; a Stream or HTTPBodyChunks has
// no materializer and is drained with a loop.
sema_ownership_one_pass_note: fn(place: String, ty: Type) -> String Never! {
    materializer := ""
    if ty == {
        .Apply(name, _) -> {
            leaf: sema_call_reflection_leaf_name(name)
            if leaf == "Iter" || leaf == "ViewIter" -> materializer = ".to_list()"
        }
        .Named(name) -> {
            if sema_call_reflection_leaf_name(name) == "Body" -> materializer = ".text(limit)"
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    if materializer == "" -> return " Note: `{place}` is one-pass and cannot be copied — create a fresh source for the second drive"
    " Note: `{place}` is one-pass — materialize it first with `{place}{materializer}`, or create a fresh source for the second drive"
}

// aliasing_while_mut (the conflicting access writes) and
// aliasing_mut_after_read (it reads and this access writes).
sema_ownership_diag_alias: fn(place: String, active_write: Bool, span: Span) -> Diagnostic {
    if {
        active_write -> sema_error("E0204", span, "`{place}` is being changed in this call, so it can't be used again here", "while something is being changed through a write parameter, nobody else may be looking at it", "pass `{place}` only once, or copy first with `{place}.copy()`")
        else -> sema_error("E0204", span, "`{place}` is already shared in this call, so it can't be changed here too", "while something is being looked at, nobody else may be changing it", "drop the extra use of `{place}`, or copy first with `{place}.copy()`")
    }
}

// A captured access reports at the place it names: `&pair.left` points at
// `left`, as the unmarked `pair.left` does, never at the marker.
sema_ownership_capture_site_span: fn(site: Expr) -> Span Never! {
    if site == .Place(inner, _, _, _) -> return sema_ownership_capture_site_span(inner)
    expr_span(site)
}

// ────────────────────────────────────────────────────────────────────────────
// Move and write capability proofs

sema_ownership_view_fact_matches_expr: fn(fact: SemaOwnershipViewFact, expr: Expr, scopes: SemaScopeTable) -> Bool {
    output_path := [String]{}
    root: sema_ownership_named_view_root(expr, output_path) ?? return false
    index: sema_scope_resolve_index_at(scopes, root, expr_span(expr)) ?? return false
    scopes.bindings[index].symbol.id.key == fact.carrier_key && sema_ownership_path_starts(output_path, fact.output_path)
}

// An index or field write whose path steps into a `ViewMut` value writes
// the window's owner, not the carrier binding: `option_part[0] = 6` with
// `option_part: ViewMut<Int>`, `selected[0][0] = 11` with
// `selected: [ViewMut<Int>]`.
sema_ownership_writes_through_view_type: fn(expr: Expr, root_type: Type?) -> Bool Never! {
    path := [String]{}
    _: sema_ownership_named_view_root(expr, path) ?? return false
    current := root_type ?? return false
    loop step in path {
        if current == .Apply(name, _) {
            if name == "ViewMut" -> return true
        }
        if current == .List(element) {
            if step.starts_with("[") && step != "[..]" {
                current = element.copy()
                next
            }
        }
        return false
    }
    false
}

sema_ownership_view_fact_exact_expr: fn(fact: SemaOwnershipViewFact, expr: Expr, scopes: SemaScopeTable) -> Bool {
    output_path := [String]{}
    root: sema_ownership_named_view_root(expr, output_path) ?? return false
    index: sema_scope_resolve_index_at(scopes, root, expr_span(expr)) ?? return false
    if scopes.bindings[index].symbol.id.key != fact.carrier_key || output_path.len() != fact.output_path.len() -> return false
    sema_ownership_path_starts(output_path, fact.output_path)
}

sema_ownership_exact_view_carrier_for_place: fn(state: &SemaOwnershipState, expr: Expr, place: SemaOwnershipPlace, scopes: SemaScopeTable) -> Bool {
    loop fact in state.views {
        if fact.active && !fact.invalidated && sema_ownership_view_fact_exact_expr(fact, expr, scopes) && sema_ownership_place_exact(fact.source, place) -> return true
    }
    false
}

sema_ownership_diag_invalidated_view: fn(fact: SemaOwnershipViewFact, span: Span) -> Diagnostic {
    // Rust `check_view_use` names the arena itself, not the fresh slot.
    owner: sema_ownership_view_owner_name(fact.source)
    verb: if fact.invalidated_verb == "" -> "operation" else -> fact.invalidated_verb
    sema_error("E0632", span, "`{owner}` was {verb} here, so the value `{fact.carrier}` points into is gone", "`{fact.carrier}` is a view into `{owner}`; `{owner}.{verb}()` invalidated everything stored in `{owner}`, so reading `{fact.carrier}` now would read freed memory", "use `{fact.carrier}` before `{owner}.{verb}()`, or re-`alloc` after the {verb} to get a fresh value")
}

// E0631 when a name holding an
// `arena.alloc` view would leave the arena's region.
sema_ownership_report_arena_view_escape: fn(state: &SemaOwnershipState, expr: Expr, what: String, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if expr == {
        .Ident(name, span, _) -> {
            index: sema_scope_resolve_index_at(scopes, name, span) ?? return false
            if !sema_ownership_is_allocator_view(scopes.bindings[index].symbol.ty) -> return false
            key: scopes.bindings[index].symbol.id.key
            loop fact in state.views {
                if !fact.active || fact.carrier_key != key || !fact.source.projections.contains("[fresh]") -> next
                arena: sema_ownership_view_owner_name(fact.source)
                diagnostics.push(sema_error("E0631", span, "`{name}` cannot be shared — it does not live long enough to {what}", "`{name}` is a view into `{arena}`; sharing it outside the region would let it outlive `{arena}` and point into freed memory", "keep `{name}` inside the `{arena}` region, or copy what you need out with `{name}.copy()` before it leaves"))
                return true
            }
            false
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// The type `arena.alloc(v)` gives its result (Memory.jet allocator methods).
sema_ownership_is_allocator_view: fn(ty: Type?) -> Bool Never! {
    if ty == .Val(.Tagged(marker, _)) -> return marker == (TagMarker.Internal{internal_tag: InternalTag.AllocatorView})
    false
}

sema_ownership_report_invalidated_view: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    output_path := [String]{}
    root: sema_ownership_named_view_root(expr, output_path) ?? return false
    binding_index: sema_scope_resolve_index_at(scopes, root, expr_span(expr)) ?? return false
    carrier_key: scopes.bindings[binding_index].symbol.id.key
    index := state.views.len() - 1
    loop index >= 0 {
        fact: state.views[index]
        if fact.active && fact.carrier_key == carrier_key && sema_ownership_path_starts(output_path, fact.output_path) && fact.invalidated {
            diagnostics.push(sema_ownership_diag_invalidated_view(fact, span))
            return true
        }
        index -= 1
    }
    false
}

sema_ownership_place_exact: fn(left: SemaOwnershipPlace, right: SemaOwnershipPlace) -> Bool Never! {
    if left.root_key == "" || right.root_key == "" || left.root_key != right.root_key -> return false
    if left.projections.len() != right.projections.len() -> return false
    if left.typed_projections.len() != left.projections.len() || right.typed_projections.len() != right.projections.len() -> return false
    loop (index, projection) in left.typed_projections {
        if !sema_ownership_typed_projection_exact(projection, right.typed_projections[index]) -> return false
    }
    true
}

sema_ownership_place_extends: fn(base: SemaOwnershipPlace, candidate: SemaOwnershipPlace) -> Bool Never! {
    if base.root_key == "" || candidate.root_key == "" || base.root_key != candidate.root_key -> return false
    if base.projections.len() > candidate.projections.len() -> return false
    if base.typed_projections.len() != base.projections.len() || candidate.typed_projections.len() != candidate.projections.len() -> return false
    loop (index, projection) in base.typed_projections {
        if !sema_ownership_typed_projection_exact(projection, candidate.typed_projections[index]) -> return false
    }
    true
}

sema_ownership_exact_write_carrier: fn(state: &SemaOwnershipState, expr: Expr, place: SemaOwnershipPlace, scopes: SemaScopeTable) -> Bool {
    loop fact in state.views {
        if fact.active && !fact.invalidated && sema_ownership_view_fact_matches_expr(fact, expr, scopes) && fact.access == AccessConvention.Write && sema_ownership_place_extends(fact.source, place) -> return true
    }
    false
}

sema_ownership_view_has_access: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, access: AccessConvention) -> Bool {
    loop fact in state.views {
        if fact.active && sema_ownership_view_fact_matches_expr(fact, expr, scopes) && fact.access == access -> return true
    }
    false
}

sema_ownership_view_exists_for_expr: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable) -> Bool {
    loop view in state.views {
        if view.active && sema_ownership_view_fact_matches_expr(view, expr, scopes) -> return true
    }
    false
}

// A live view whose window reads the storage of the binding `expr` names:
// `alias: bytes[0..1]` keeps `bytes` lent while `alias` is still used.
sema_ownership_view_reads_binding: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable) -> Bool {
    binding: sema_ownership_binding_for_expr(state, expr, scopes) ?? return false
    loop view in state.views {
        if view.active && view.source.root_key == binding.symbol.id.key -> return true
    }
    false
}

// A live write view carried by the expression's root name: a `&place`
// pattern window (Rust `param_conv` `Write`) or a pin.
sema_ownership_write_view_exists_for_expr: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable) -> Bool {
    loop view in state.views {
        if view.active && view.access == AccessConvention.Write && sema_ownership_view_fact_matches_expr(view, expr, scopes) -> return true
    }
    false
}

sema_ownership_check_use: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if sema_ownership_report_invalidated_view(state, expr, scopes, expr_span(expr), diagnostics) -> return false
    places := sema_ownership_places_from_expr_in_state(expr, scopes, state)
    if places.len() == 0 -> return true
    if sema_ownership_report_own_place_moved(state, expr, scopes, diagnostics) -> return false
    loop place in places {
        if sema_ownership_place_moved(state, place) == .Val(origin) {
            sema_ownership_report_moved(state, origin, place, expr_span(expr), diagnostics)
            return false
        }
        // Rust `check_place_read` reports E0220 and lets the read go on, so
        // the access that follows still runs its own checks (a write
        // receiver's E0212).
        if sema_ownership_conflicting_view_for_expr(state, place, AccessConvention.Read, expr, scopes) == .Val(fact) {
            diagnostics.push(sema_ownership_diag_owner_read(fact, place, expr_span(expr), scopes))
            next
        }
        conflict: sema_ownership_active_loan_conflict_for_expr(state, place, AccessConvention.Read, expr, scopes)
        if conflict == .Val(loan) {
            // A window's own bounds and indexes are read before it opens.
            if !sema_ownership_window_operand_read(loan, expr_span(expr)) {
                diagnostics.push(sema_ownership_diag_alias(sema_ownership_place_name(place), true, expr_span(expr)))
                return false
            }
        }
    }
    true
}

// True when `span` lies inside the statement window `loan` is opening: an
// operand of that window, read before it opens.
sema_ownership_window_operand_read: fn(loan: SemaOwnershipLoan, span: Span) -> Bool Never! {
    loan.statement_window && span.start >= loan.span.start && span.end <= loan.span.end
}

// Rust `reject_moved_expr_use` reads the written place without chasing a
// view alias to its source, so a moved view binding (recorded on itself by
// `sema_ownership_moved_record_places`) answers for its own later uses.
sema_ownership_report_own_place_moved: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    own: sema_ownership_place_from_expr_inner(expr, scopes) ?? return false
    moved: sema_ownership_place_moved(state, own) ?? return false
    sema_ownership_report_moved(state, moved, own, expr_span(expr), diagnostics)
    true
}

// Rust `reject_moved_expr_use` on a complete projected place (`state.x`):
// a move of the place, of a part of it, or of an owner it lies in is a use
// after move. Read windows and loans are judged by the caller's own checks.
sema_ownership_check_moved_place_use: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if sema_ownership_report_own_place_moved(state, expr, scopes, diagnostics) -> return false
    loop place in sema_ownership_places_from_expr_in_state(expr, scopes, state) {
        if sema_ownership_place_moved(state, place) == .Val(origin) {
            sema_ownership_report_moved(state, origin, place, expr_span(expr), diagnostics)
            return false
        }
    }
    true
}

// A base of a deeper place answers for moves of itself and its ancestors,
// not moved descendants. The complete projected place carries those checks,
// allowing sibling reads and exact field reinitialization without reviving a
// moved owner.
sema_ownership_check_root_base_use: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if sema_ownership_report_invalidated_view(state, expr, scopes, expr_span(expr), diagnostics) -> return false
    loop place in sema_ownership_places_from_expr_in_state(expr, scopes, state) {
        if sema_ownership_place_moved_ancestor(state, place) == .Val(origin) {
            sema_ownership_report_moved(state, origin, place, expr_span(expr), diagnostics)
            return false
        }
    }
    true
}

sema_ownership_place_moved_ancestor: fn(state: SemaOwnershipState, place: SemaOwnershipPlace) -> SemaOwnershipMovedPlace? {
    loop moved in state.moved {
        if moved.origin.deferred_depth == None && sema_ownership_place_extends(moved.place, place) -> return Val(moved)
    }
    None
}

sema_ownership_active_loan_conflict: fn(state: &SemaOwnershipState, place: SemaOwnershipPlace, access: AccessConvention) -> SemaOwnershipLoan? {
    loop loan in state.loans {
        if sema_ownership_places_overlap(loan.place, place) {
            if access == AccessConvention.Move || loan.access == AccessConvention.Write || access == AccessConvention.Write -> return Val(loan)
        }
    }
    None
}

// Follow sequence identities rather than place overlap: an unrelated window
// into the same owner is never a reborrow ancestor.
sema_ownership_view_descends_from: fn(state: SemaOwnershipState, child: SemaOwnershipViewFact, ancestor: Int) -> Bool Never! {
    parent := child.reborrow_parent
    loop parent >= 0 {
        if parent == ancestor -> return true
        next_parent := -1
        loop fact_index in 0..<state.views.len() {
            if state.views[fact_index].seq == parent && state.views[fact_index].active && !state.views[fact_index].invalidated {
                next_parent = state.views[fact_index].reborrow_parent
                break
            }
        }
        parent = next_parent
    }
    false
}

// The live view a window opened through a view carrier reborrows:
// `&edit[a..<b]` over the write view `edit` takes over edit's loan, and
// `view[a..<b]` narrows the read view `view`. -1 when `source` does not step
// through a live view over `place` that grants `access`.
sema_ownership_reborrow_parent: fn(state: SemaOwnershipState, source: Expr, place: SemaOwnershipPlace, access: AccessConvention, scopes: SemaScopeTable) -> Int Never! {
    parent := -1
    loop fact in state.views {
        if !fact.active || fact.invalidated -> next
        if access == AccessConvention.Write && fact.access != AccessConvention.Write -> next
        if sema_ownership_view_fact_matches_expr(fact, source, scopes) && sema_ownership_place_extends(fact.source, place) -> parent = fact.seq
    }
    parent
}

// Whether `fact` is the reborrow parent `parent` or one of its ancestors.
sema_ownership_is_reborrow_lineage: fn(state: SemaOwnershipState, fact: SemaOwnershipViewFact, parent: Int) -> Bool Never! {
    if parent < 0 -> return false
    if fact.seq == parent -> return true
    loop candidate in state.views {
        if candidate.seq == parent && candidate.active && !candidate.invalidated -> return sema_ownership_view_descends_from(state, candidate, fact.seq)
    }
    false
}

sema_ownership_carrier_loan_exempt: fn(state: &SemaOwnershipState, expr: Expr, place: SemaOwnershipPlace, loan: SemaOwnershipLoan, scopes: SemaScopeTable) -> Bool {
    if loan.access != AccessConvention.Write -> return false
    loop carrier in state.views {
        if !carrier.active || carrier.invalidated || !sema_ownership_view_fact_matches_expr(carrier, expr, scopes) || !sema_ownership_place_extends(carrier.source, place) -> next
        loop fact in state.views {
            if !fact.active || fact.invalidated || fact.access != AccessConvention.Write -> next
            if fact.seq != carrier.seq && !sema_ownership_view_descends_from(state, carrier, fact.seq) -> next
            if fact.loan_seq >= 0 && loan.seq == fact.loan_seq && sema_ownership_span_same(loan.span, fact.loan_span) && loan.carrier_fact_seq == fact.seq && loan.carrier_key == fact.carrier_key && sema_ownership_place_exact(loan.place, fact.source) && sema_ownership_place_extends(fact.source, place) -> return true
        }
    }
    false
}

// A live read view tolerates other reads only: a write or a move of its owner
// would invalidate what it looks into.
sema_ownership_view_access_conflicts: fn(view: AccessConvention, access: AccessConvention) -> Bool Never! {
    view == AccessConvention.Write || access == AccessConvention.Write || access == AccessConvention.Move
}

sema_ownership_mark_views_contested: fn(state: &SemaOwnershipState, first: Int) Never! {
    loop index in first..<state.views.len() -> state.views[index].contested = true
}

sema_ownership_conflicting_view_for_expr: fn(state: &SemaOwnershipState, place: SemaOwnershipPlace, access: AccessConvention, expr: Expr, scopes: SemaScopeTable) -> SemaOwnershipViewFact? {
    loop carrier in state.views {
        if carrier.active && carrier.contested && sema_ownership_view_fact_matches_expr(carrier, expr, scopes) -> return None
    }
    // Moving a view binding moves the view, not the owner it looks into, so
    // it conflicts with other views as a read of their source does.
    effective := access
    if access == AccessConvention.Move {
        loop carrier in state.views {
            if carrier.active && !carrier.invalidated && sema_ownership_view_fact_matches_expr(carrier, expr, scopes) {
                effective = AccessConvention.Read
                break
            }
        }
    }
    loop fact in state.views {
        if !fact.active || fact.invalidated || fact.contested || !sema_ownership_places_overlap(fact.source, place) || !sema_ownership_view_access_conflicts(fact.access, effective) -> next
        through_ancestor := false
        loop carrier in state.views {
            if carrier.active && !carrier.invalidated && sema_ownership_view_fact_matches_expr(carrier, expr, scopes) && sema_ownership_place_extends(carrier.source, place) && (carrier.seq == fact.seq || sema_ownership_view_descends_from(state, carrier, fact.seq)) {
                through_ancestor = true
                break
            }
        }
        if !through_ancestor -> return Val(fact)
    }
    None
}

sema_ownership_active_view_conflict_for_expr: fn(state: &SemaOwnershipState, place: SemaOwnershipPlace, access: AccessConvention, expr: Expr, scopes: SemaScopeTable) -> Bool {
    sema_ownership_conflicting_view_for_expr(state, place, access, expr, scopes) != None
}

sema_ownership_active_loan_conflict_for_expr: fn(state: &SemaOwnershipState, place: SemaOwnershipPlace, access: AccessConvention, expr: Expr, scopes: SemaScopeTable) -> SemaOwnershipLoan? {
    loop carrier in state.views {
        if carrier.active && carrier.contested && sema_ownership_view_fact_matches_expr(carrier, expr, scopes) -> return None
    }
    loop loan in state.loans {
        if sema_ownership_places_overlap(loan.place, place) {
            conflicts: access == AccessConvention.Move || loan.access == AccessConvention.Write || access == AccessConvention.Write
            if conflicts {
                if sema_ownership_carrier_loan_exempt(state, expr, place, loan, scopes) || sema_ownership_loan_contested(state, loan) -> next
                return Val(loan)
            }
        }
    }
    None
}

sema_ownership_loan_contested: fn(state: SemaOwnershipState, loan: SemaOwnershipLoan) -> Bool Never! {
    if loan.carrier_fact_seq < 0 -> return false
    loop view in state.views {
        if view.seq == loan.carrier_fact_seq && view.contested -> return true
    }
    false
}

sema_ownership_binding_for_expr: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable) -> SemaScopeBinding? {
    output_path := [String]{}
    root: sema_ownership_named_view_root(expr, output_path) ?? return None
    index: sema_scope_resolve_index_at(scopes, root, expr_span(expr)) ?? return None
    Val(scopes.bindings[index])
}

// The first binding of the root's symbol decides. Every binding of one symbol
// key has that symbol's kind (symbol_id spells the kind into the key), so a
// binding found among the bindings named like the root answers without
// scanning the whole table, which holds every module-level symbol; a root bound
// under another name falls back to the scan.
sema_ownership_place_is_static: fn(place: SemaOwnershipPlace, scopes: SemaScopeTable) -> Bool Never! {
    if sema_scope_name_slot(scopes, place.root) == .Val(slot) {
        loop position in scopes.name_positions[slot] {
            if scopes.bindings[position].symbol.id.key == place.root_key -> return scopes.bindings[position].symbol.kind == SymbolKind.Constant
        }
    }
    loop binding_index in 0..<scopes.bindings.len() {
        if scopes.bindings[binding_index].symbol.id.key == place.root_key -> return scopes.bindings[binding_index].symbol.kind == SymbolKind.Constant
    }
    false
}

// `capability` adds the mutability gate on the place's root binding. Without
// it only the change checks run: Rust `check_write_arg_change` for a `&`
// argument to a parameter that does not edit, and `record_call_receiver_access`
// for a handle receiver that writes through the handle. `callee`, `receiver`
// and `params` describe the call that writes the place, so a changeability
// error quotes its signature line; `callee` is empty for any other write.
sema_ownership_write_capability: fn(state: &SemaOwnershipState, expr: Expr, action: String, callee: String, receiver: AccessConvention?, params: [SemaCallParam], capability: Bool, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if sema_ownership_reject_frozen_write(state, expr, if action == "" -> "be edited" else -> action, expr_span(expr), scopes, diagnostics) -> return false
    if sema_ownership_report_invalidated_view(state, expr, scopes, expr_span(expr), diagnostics) -> return false
    places := sema_ownership_places_from_expr_in_state(expr, scopes, state)
    if places.len() == 0 {
        if sema_ownership_writes_temporary_edit_guard(expr) -> return true
        what: if callee == "" -> "this write needs a place, not a temporary" else -> "`{callee}` writes to this input, so it needs a place, not a temporary"
        diagnostics.push(sema_error("E0111", expr_span(expr), what, "write access can only be granted to stable storage, not a temporary expression", "bind the value to a `:=` name first, then pass the name"))
        return false
    }
    // The group loan outlives the borrow binding's last lexical use, so it is
    // checked before the view scan below, which has already let the place go.
    loop place in places {
        if sema_ownership_report_group_loan_change(state, place, if action == "" -> "be edited" else -> action, expr_span(expr), diagnostics) -> return false
    }
    loop place in places {
        if sema_ownership_place_refuses_write(state, place, scopes) {
            // Rust's assignment path has no static-borrow check: a constant
            // can't be changed (E0111).
            if action == "be assigned" {
                diagnostics.push(sema_error("E0111", expr_span(expr), "`{places[0].root}` is a constant, so it can't be changed", "static storage is not mutable", "copy the value into a mutable local (`:=`) and change that"))
            } else {
                sema_ownership_report_static_write(state, place, expr_span(expr), diagnostics)
            }
            return false
        }
        if sema_ownership_conflicting_view_for_expr(state, place, AccessConvention.Write, expr, scopes) == .Val(fact) {
            diagnostics.push(sema_ownership_diag_view_change(fact, place, action, expr_span(expr), scopes))
            return false
        }
        conflict: sema_ownership_active_loan_conflict_for_expr(state, place, AccessConvention.Write, expr, scopes)
        if conflict == .Val(loan) {
            diagnostics.push(sema_ownership_diag_loan_change(state, loan, place, action, expr_span(expr), scopes))
            return false
        }
    }
    if !capability -> return true
    has_view: sema_ownership_view_exists_for_expr(state, expr, scopes)
    if has_view && sema_ownership_view_has_access(state, expr, scopes, AccessConvention.Read) {
        diagnostics.push(sema_error("E0205", expr_span(expr), "cannot edit through `{places[0].root}` — it has read access only", "a read window may inspect its place, but it cannot change the owner", "take a write window from a mutable owner instead"))
        return false
    }
    binding: sema_ownership_binding_for_expr(state, expr, scopes) ?? return false
    info: binding
    guard_refused: sema_ownership_writes_read_shared_guard(expr, scopes)
    if guard_refused {
        diagnostics.push(sema_ownership_diag_read_shared_guard_write(expr_span(expr)))
        // Rust `validate_shared_guard_lvalue` runs beside an assignment's own
        // field or index capability check, so only an assignment goes on.
        if action != "be assigned" -> return false
    }
    // A `#Persist` module cell is mutable state lent like a local (its module
    // binding is registered without `mutable`); every other static root was
    // refused above.
    persist: state.persist_roots.contains(places[0].root_key)
    if !has_view && !persist && !info.mutable && info.access != AccessConvention.Write && !sema_ownership_binding_is_edit_shared_guard(info) && !sema_ownership_writes_through_view_type(expr, info.symbol.ty) {
        if action == "be assigned" && sema_ownership_report_assignment_capability(expr, places[0].root, info, diagnostics) -> return false
        call_why: if callee == "" -> "" else -> "{sema_ownership_signature_line(callee, receiver, params)} changes this input"
        if info.access == {
            .Read -> {
                // An unmarked parameter is read access for
                // the whole call; the fix is the parameter's `&` mark.
                if info.symbol.kind == SymbolKind.Parameter {
                    param_type: type_name(info.symbol.ty ?? Type.Named{name: "Unit"})
                    why: if call_why == "" -> "an unmarked parameter gives read access only; nobody changes it during the call" else -> "{call_why}, but an unmarked parameter gives read access only"
                    diagnostics.push(sema_error("E0205", expr_span(expr), "cannot edit through `{places[0].root}` — it has read access only", why, "change the parameter to `{places[0].root}: &{param_type}`"))
                } else if call_why != "" && !info.place_alias && info.binding_sigil != None {
                    // A `:` local, or a part of one, passed to a write
                    // parameter: the fix is the binding's sigil.
                    diagnostics.push(sema_ownership_diag_unchangeable(info, places[0].root, expr_span(expr), "{call_why}, so `{places[0].root}` must be mutable (`:=`)"))
                } else {
                    diagnostics.push(sema_error("E0205", expr_span(expr), "cannot edit through `{places[0].root}` — it has read access only", "a read window may inspect its place, but it cannot change the owner", "take a write window from a mutable owner instead"))
                }
            }
            .Write | .Move -> diagnostics.push(sema_ownership_diag_unchangeable(info, places[0].root, expr_span(expr), if call_why == "" -> "a write window can change its owner, so the owner must be mutable (`:=`)" else -> "{call_why}, so `{places[0].root}` must be mutable (`:=`)"))
        }
        return false
    }
    !guard_refused
}

// Rust's assignment statement checks: a field write through an immutable
// root is E0205 for a parameter and a local alike; an index write is E0205
// only for a read parameter and E0111 for any other binding. False for a
// target that is neither.
sema_ownership_report_assignment_capability: fn(expr: Expr, root: String, info: SemaScopeBinding, diagnostics: &[Diagnostic]) -> Bool {
    param_type: type_name(info.symbol.ty ?? Type.Named{name: "Unit"})
    is_param: info.symbol.kind == SymbolKind.Parameter
    if expr == {
        .Field(_, member, span, _) -> {
            if root == "self" {
                diagnostics.push(sema_error("E0205", span, "cannot edit `{member}` — `self` has read access only", "editing a field requires write access to the owning place", "declare the receiver with the write mark: `&self`"))
            } else if is_param {
                diagnostics.push(sema_error("E0205", span, "cannot edit `{member}` — `{root}` has read access only", "editing a field requires write access to the owning place", "change the parameter to `{root}: &{param_type}`"))
            } else {
                diagnostics.push(sema_error("E0205", span, "cannot edit `{member}` — `{root}` has read access only", "editing a field requires write access to the owning place", "declare it with `{root} := ...` to give it write access"))
            }
            true
        }
        .Index(_, _, span, _, _) -> {
            what: "cannot write to `{root}` — it has read access only"
            if is_param && info.access == AccessConvention.Read {
                diagnostics.push(sema_error("E0205", span, what, "an unmarked parameter gives read access only; assigning into it needs write access", "change the parameter to `{root}: &{param_type}`"))
            } else {
                diagnostics.push(sema_ownership_diag_unchangeable(info, root, span, "assigning into a collection edits it, so the binding must be mutable (`:=`)"))
            }
            true
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// A change to a place a running `task.group` child still holds: the child
// keeps its loan until the group joins, so a write, move or reset here would
// race the child or free memory it reads.
sema_ownership_report_group_loan_change: fn(state: SemaOwnershipState, changed: SemaOwnershipPlace, action: String, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    loop held in state.group_loans {
        if sema_ownership_places_overlap(held.place, changed) {
            changed_name: sema_ownership_place_name(changed)
            diagnostics.push(sema_error("E1101", span, "`{changed_name}` cannot {action} while `{held.name}` is lent to a task in `{held.group}`", "a task.group joins its children at the end of the block, so `{held.name}` stays borrowed until `{held.group}` joins — changing `{changed_name}` now would race a running task or free memory it still reads", "do this after the `{held.group}` block ends, give it away with `task &&{held.name}`, freeze it with `freeze`, or share it with `Shared{{…}}`"))
            return true
        }
    }
    false
}

// `action` is Rust's change wording for a pinned place (E0219), such as
// "be assigned"; an empty action keeps the general E0212 report.
sema_ownership_check_write: fn(state: &SemaOwnershipState, expr: Expr, action: String, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    sema_ownership_check_write_as(state, expr, action, "", None, [SemaCallParam]{}, true, scopes, diagnostics)
}

// A whole argument passed to `callee`'s write parameter; `receiver` and
// `params` are the callee's, for the signature line a changeability error quotes.
sema_ownership_check_write_argument: fn(state: &SemaOwnershipState, expr: Expr, callee: String, receiver: AccessConvention?, params: [SemaCallParam], scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    sema_ownership_check_write_as(state, expr, "be passed with write access", callee, receiver, params, true, scopes, diagnostics)
}

// A write access whose root needs no write capability (see
// `sema_ownership_write_capability`).
sema_ownership_check_write_change: fn(state: &SemaOwnershipState, expr: Expr, action: String, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    sema_ownership_check_write_as(state, expr, action, "", None, [SemaCallParam]{}, false, scopes, diagnostics)
}

sema_ownership_check_write_as: fn(state: &SemaOwnershipState, expr: Expr, action: String, callee: String, receiver: AccessConvention?, params: [SemaCallParam], capability: Bool, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    ok: sema_ownership_write_capability(state, expr, action, callee, receiver, params, capability, scopes, diagnostics)
    if ok {
        places := sema_ownership_places_from_expr_in_state(expr, scopes, state)
        loop place in places {
            sema_ownership_clear_moved(state, place)
            sema_ownership_note_place_reference(state, expr, place, expr_span(expr), scopes, SemaOwnershipReferenceKind.Write)
        }
    }
    ok
}

sema_ownership_clear_moved: fn(state: &SemaOwnershipState, place: SemaOwnershipPlace) Never! {
    // Reinitializing a descendant never restores its moved ancestor.
    remaining: loop moved in state.moved if !sema_ownership_place_extends(place, moved.place) -> moved
    state.moved = remaining
}

// Whether a value of `ty` has its own Close implementation (a nominal Close
// impl, or a generic parameter bounded by Close).
sema_ownership_type_owns_close: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if program.registration_graph == .Val(graph) {
        if sema_type_resolve_nominal_row_at(graph, ty, sema_scope_caller_row(environment, graph)) == .Val(row) {
            if sema_copy_nominal_close(program.registration_graph, program.copy_facts, graph.modules[row.module_index].nominals[row.row], row).value -> return true
        }
    }
    if ty == .Named(name) {
        loop param in environment.generic_params {
            if param.name == name && sema_copy_generic_bound(param, "Close") -> return true
        }
    }
    false
}

// Field typing supplies prefix facts; never copy the registration graph into
// per-function ownership state.
sema_ownership_note_close_owner: fn(state: &SemaOwnershipState, expr: Expr, ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) Never! {
    if !sema_ownership_type_owns_close(ty, environment, program) -> return
    loop place in sema_ownership_places_from_expr_in_state(expr, scopes, state) {
        known := false
        loop owner in state.close_owners {
            if sema_ownership_place_exact(owner.place, place) -> known = true
        }
        if !known -> state.close_owners.push(SemaOwnershipCloseOwner{place: place, ty: ty})
    }
}

sema_ownership_reject_partial_close_move: fn(state: SemaOwnershipState, place: SemaOwnershipPlace, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    loop owner in state.close_owners {
        if owner.place.projections.len() >= place.projections.len() || !sema_ownership_place_extends(owner.place, place) -> next
        if owner.place.projections.len() == 0 && owner.place.root_key == state.close_receiver_key -> next
        name: sema_ownership_place_name(place)
        diagnostics.push(sema_error("E0222", span, "A part of `{name}` cannot be moved independently", "`{type_name(owner.ty)}` has its own Close implementation, which needs the complete owner; this move would leave it with an empty field", "Move the Close owner as a whole, copy the field if its type supports copying, or call a method `{type_name(owner.ty)}` provides"))
        return true
    }
    false
}

// An exact move: a `.move()`, a consuming call or receiver, or a capture.
// A later use stays E0121.
sema_ownership_mark_move: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, consumer: String, diagnostics: &[Diagnostic]) -> Bool {
    sema_ownership_mark_move_as(state, expr, scopes, consumer, false, diagnostics)
}

// An unmarked owning position (binding, assignment,
// return, field, element). A later use turns this move into a share.
sema_ownership_mark_unmarked_move: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, consumer: String, diagnostics: &[Diagnostic]) -> Bool {
    sema_ownership_mark_move_as(state, expr, scopes, consumer, true, diagnostics)
}

// Rust `note_move_if_direct_ident`: an unmarked owning position (binding,
// assignment, return, element) moves only a bare name, seen through
// parentheses and the `Val`/`Ok`/`Err`/tainted constructors. A field or
// element read there (`m: parts[0]`, `x = row.width`) leaves its owner
// whole; lowering materializes the copy.
sema_ownership_unmarked_moves_name: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Ident(_, _, _) -> true
        .Paren(inner, _, _) | .Present(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) | .Tainted(inner, _, _, _) -> sema_ownership_unmarked_moves_name(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

sema_ownership_mark_move_as: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, consumer: String, unmarked: Bool, diagnostics: &[Diagnostic]) -> Bool {
    // A share site copies; the source stays usable.
    if unmarked && sema_ownership_is_share_site(state, expr_span(expr)) -> return true
    if sema_ownership_report_invalidated_view(state, expr, scopes, expr_span(expr), diagnostics) -> return false
    places := sema_ownership_places_from_expr_in_state(expr, scopes, state)
    if places.len() == 0 -> return true
    binding: sema_ownership_binding_for_expr(state, expr, scopes)
    // An ExpiringSecret loan is lent for the callback only: an exact move of
    // it is refused and nothing moves (an unmarked read keeps lending it);
    // the call that asked for the move still checks.
    if !unmarked && binding == .Val(loan) && sema_contains_expiring_secret_loan(loan.symbol.ty ?? Type.Named{name: "Unit"}) {
        diagnostics.push(sema_ownership_diag_expiring_secret_loan_change(loan.symbol.name, "be moved", expr_span(expr)))
        return true
    }
    if binding != None {
        info: binding
        // Rust moves only non-Copy values: every projection of a Copy root
        // is Copy, so nothing moves and no move conflict exists. A string
        // view binding is a borrowed `&str` window, Copy in the same way: an
        // owning destination copies the window or refuses it (E2307), and the
        // view stays usable. Rust
        // `note_move_if_direct_ident`: an unmarked owning position moves a
        // binding without an access convention only; a read or write
        // parameter or a write window keeps its value (the binding and return
        // audits report E0120 where it would have to copy). A function item
        // names immutable code, so naming it as a value moves nothing.
        root_ty: info.symbol.ty ?? Type.Named{name: "Unit"}
        if sema_ownership_type_is_copy(root_ty) || info.symbol.kind == SymbolKind.Function || info.string_view || (unmarked && sema_ownership_binding_lends(info)) || (unmarked && !sema_ownership_unmarked_moves_name(expr)) {
            loop place in places -> sema_ownership_note_place_reference(state, expr, place, expr_span(expr), scopes, SemaOwnershipReferenceKind.Move)
            return true
        }
    }
    // (spec "Copies, moves, and owned destinations"): an
    // exact `name.move()` on storage this scope does not own has nothing to give
    // away, and lowering would copy the value instead (`jet audit copies`
    // lists the site as an implicit read-view copy). A binding position
    // refuses the mark in sema_expression_exact_move; a call argument, a
    // consuming receiver, a task or a capture arrives here as a bare name and
    // is refused the same way (E0201): a read or write parameter, a `:` name
    // that reads a field or element through a view, or a loop name over a
    // borrowed collection. An unmarked last use (`implicit_take_ok`) is not an
    // exact mark and keeps the share-or-move rule.
    if !unmarked && binding != None && sema_ownership_unmarked_moves_name(expr) && !sema_ownership_expr_site_listed(state.implicit_take_ok, expr) {
        info: binding
        if sema_ownership_binding_is_borrowed_param(info) {
            param_type: type_name(info.symbol.ty ?? Type.Named{name: "T"})
            diagnostics.push(sema_error("E0201", expr_span(expr), "`{info.symbol.name}` cannot be moved from borrowed storage", "`{info.symbol.name}` is a read or write parameter, so its caller keeps the value; moving it here would copy it", "write `{info.symbol.name}.copy()` when {consumer} should receive a copy, or declare the parameter `{info.symbol.name}: &&{param_type}` so the caller hands the value over"))
            return false
        }
        if info.place_alias {
            diagnostics.push(sema_ownership_diag_place_alias_move(info.symbol.name, consumer, expr_span(expr)))
            return false
        }
    }
    // Named write windows keep ownership with their source (Rust
    // `note_exact_move`: `param_conv` `Write`). A read payload or view
    // binding is an ordinary local in Rust, so moving it is no E0201. A
    // borrowed parameter under an exact `.move()` is refused at the move
    // itself (E0201); a consuming call or receiver records its move like any
    // owner.
    if sema_ownership_report_own_place_moved(state, expr, scopes, diagnostics) -> return false
    // A whole `ViewMut` carrier moves the window itself, not the storage it
    // edits: its loan travels with the value, as `Edit{values: selected}`,
    // so the move touches the carrier's own place only.
    carrier: sema_ownership_expr_is_view_mut_carrier(expr, binding)
    if carrier -> places = sema_ownership_moved_record_places(expr, places, scopes, true)
    borrowed: !carrier && sema_ownership_write_view_exists_for_expr(state, expr, scopes)
    loop place in places {
        if !unmarked && sema_ownership_reject_partial_static_move(state, place, expr, diagnostics) -> return false
        if sema_ownership_place_moved(state, place) == .Val(origin) {
            sema_ownership_report_moved(state, origin, place, expr_span(expr), diagnostics)
            return false
        }
        if sema_ownership_place_deferred(state, place) == .Val(deferred) {
            diagnostics.push(sema_ownership_diag_moved(sema_ownership_place_name(deferred.place), deferred.origin, expr_span(expr)))
            return false
        }
        if borrowed {
            diagnostics.push(sema_error("E0201", expr_span(expr), "`{sema_ownership_place_name(place)}` cannot be moved from borrowed storage", "read and write parameters and named windows keep ownership with their source", "copy the value, or declare the parameter `&&T` to take ownership"))
            return false
        }
        if !unmarked && sema_ownership_reject_partial_close_move(state, place, expr_span(expr), diagnostics) -> return false
        if sema_ownership_report_group_loan_change(state, place, "be moved", expr_span(expr), diagnostics) -> return false
        if sema_ownership_conflicting_view_for_expr(state, place, AccessConvention.Move, expr, scopes) == .Val(fact) {
            diagnostics.push(sema_ownership_diag_view_change(fact, place, "be moved", expr_span(expr), scopes))
            return false
        }
        conflict: sema_ownership_active_loan_conflict(state, place, AccessConvention.Move)
        if conflict == .Val(loan) {
            diagnostics.push(sema_ownership_diag_loan_change(state, loan, place, "be moved", expr_span(expr), scopes))
            return false
        }
    }
    move_ty := Type.Named{name: "Unit"}
    if binding != None {
        info: binding
        move_ty = info.symbol.ty ?? Type.Named{name: "Unit"}
    }
    if !sema_ownership_type_is_copy(move_ty) {
        origin := sema_ownership_move_origin(expr, move_ty, consumer, unmarked, scopes.copies_explicit)
        // A `#SingleUse` value keeps its exact move; it never copies.
        if sema_single_use_key(state, places[0].root_key) -> origin.share_ty = None
        loop place in sema_ownership_moved_record_places(expr, places, scopes, unmarked) -> state.moved.push(SemaOwnershipMovedPlace{place: place, origin: origin})
    }
    loop place in places -> sema_ownership_note_place_reference(state, expr, place, expr_span(expr), scopes, SemaOwnershipReferenceKind.Move)
    true
}

sema_ownership_expr_is_view_mut_carrier: fn(expr: Expr, binding: SemaScopeBinding?) -> Bool Never! {
    if expr == .Ident(_, _, _) {
        info: binding ?? return false
        ty: info.symbol.ty ?? return false
        if ty == .Apply(name, _) -> return name == "ViewMut"
    }
    false
}

// Rust `note_move_if_direct_ident` keys an unmarked move on the binding
// itself (`mark_moved(name)`), never on the storage a view binding reads:
// moving `input` in `input: bytes[0..<n]; R{bytes: input}` leaves `bytes`
// usable. An exact `place.move()` move keeps the chased source places.
sema_ownership_moved_record_places: fn(expr: Expr, places: [SemaOwnershipPlace], scopes: SemaScopeTable, unmarked: Bool) -> [SemaOwnershipPlace] {
    if !unmarked -> return places.copy()
    name: sema_ownership_moved_name(expr) ?? return places.copy()
    own: sema_ownership_place_from_expr_inner(name, scopes) ?? return places.copy()
    [SemaOwnershipPlace]{own}
}

sema_ownership_moved_name: fn(expr: Expr) -> Expr? Never! {
    if expr == {
        .Ident(_, _, _) -> Val(expr)
        .Paren(inner, _, _) | .Present(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) | .Tainted(inner, _, _, _) -> sema_ownership_moved_name(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_ownership_consume_expression: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, consumer: String, diagnostics: &[Diagnostic]) -> Bool {
    // (#3714): `place.move()` is one exact move. The expression
    // check and the consuming position both reach it, so a place this very
    // mark already moved is the same move, not a use after it.
    if expr == .Place(value, access, mark_span, _) {
        if access == PlaceAccess.Take {
            loop place in sema_ownership_places_from_expr_in_state(value, scopes, state) {
                if sema_ownership_place_moved(state, place) == .Val(moved) {
                    if moved.origin.span.start == expr_span(value).start && moved.origin.span.end == expr_span(value).end -> return true
                }
            }
            if !sema_ownership_check_expression(state, value, scopes, diagnostics) -> return false
            // Exact projected takes enter the same recorder as whole roots.
            if sema_ownership_places_from_expr_in_state(value, scopes, state).len() > 0 {
                if !sema_ownership_mark_move(state, value, scopes, consumer, diagnostics) -> return false
                sema_ownership_label_moves(state, expr_span(value), mark_span)
            }
            return true
        }
    }
    if !sema_ownership_check_expression(state, expr, scopes, diagnostics) -> return false
    if sema_ownership_places_from_expr_in_state(expr, scopes, state).len() > 0 -> return sema_ownership_mark_unmarked_move(state, expr, scopes, consumer, diagnostics)
    true
}

// Moves just recorded at `origin_span` show their E0121 label on `label_span`:
// the whole `place.move()` of an exact move, or a field receiver's full place.
sema_ownership_label_moves: fn(state: &SemaOwnershipState, origin_span: Span, label_span: Span) {
    loop index in 0..<state.moved.len() {
        if sema_ownership_span_same(state.moved[index].origin.span, origin_span) -> state.moved[index].origin.label_span = Val(label_span)
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Call access integration

// One place a call argument (or receiver) holds for the duration of the call;
// later arguments that overlap it with a write on either side conflict.
// `reserved` is Rust's two-phase `&mut self` reservation: a later read does
// not conflict with it, and it activates after the arguments against only
// the `retained` loans (Rust `record_call_place_access`). A `&` argument is
// reserved and retained: nothing writes through it until the call runs, so a
// later read that ends with its own evaluation (`grow(xs, xs.len())`) passes,
// while one the call keeps holding, a move, or a second write conflicts at the
// later argument.
SemaOwnershipCallAccess: struct {
    place: SemaOwnershipPlace
    access: AccessConvention
    span: Span
    reserved: Bool
    retained: Bool
}

// Rust `check_call_place_access_kind`: the latest access of the call that
// overlaps `place` with a write on either side. A later read (not itself a
// reservation) passes a reserved `&` receiver, which activates after the
// arguments. `holds` marks an access that outlives its argument's evaluation
// (a retained read, a move, a lambda capture), which a reserved `&` argument
// does not let pass.
sema_ownership_call_access_conflict: fn(accesses: [SemaOwnershipCallAccess], place: SemaOwnershipPlace, access: AccessConvention, reserved: Bool, holds: Bool) -> AccessConvention? Never! {
    index := accesses.len() - 1
    loop index >= 0 {
        active: accesses[index]
        index -= 1
        // Only a generated borrow stays in Rust's call frame; a finished
        // scalar or moved argument does not (`check_call_argument_access`).
        if !active.retained && !active.reserved -> next
        if !sema_ownership_places_overlap(active.place, place) -> next
        if active.reserved && access != AccessConvention.Write && !reserved && !(active.retained && holds) -> next
        if active.access == AccessConvention.Write || access == AccessConvention.Write -> return Val(active.access)
    }
    None
}

// Rust `activate_call_reservations`: once the arguments are evaluated, a
// reserved receiver conflicts with every loan the call still retains. A
// reserved `&` argument was already checked against each later argument.
sema_ownership_activate_call_reservations: fn(accesses: [SemaOwnershipCallAccess], diagnostics: &[Diagnostic]) -> Bool {
    accepted := true
    loop reservation in accesses {
        if !reservation.reserved || reservation.retained -> next
        loop active in accesses {
            if !active.retained || !sema_ownership_places_overlap(active.place, reservation.place) -> next
            accepted = false
            diagnostics.push(sema_ownership_diag_alias(sema_ownership_place_name(reservation.place), active.access == AccessConvention.Write, reservation.span))
            break
        }
    }
    accepted
}

sema_ownership_param_for_arg: fn(params: [SemaCallParam], arg: CallArg, source_index: Int) -> SemaCallParam? {
    slot: arg.flags.binder_slot ?? source_index
    if slot < 0 || slot >= params.len() -> return None
    Val(params[slot])
}

// A range window has a fixed length, while this callee may
// grow or shrink the list it receives.
sema_ownership_call_diag_write_range_window: fn(span: Span) -> Diagnostic {
    sema_error("E0212", span, "a range write window can't fill a list parameter that may resize", "a range window has a fixed length, but this function may grow or shrink the list it receives through its write parameter", "pass the whole list: `fill(values)`")
}

sema_ownership_argument_is_function_item: fn(arg: CallArg, scopes: SemaScopeTable) -> Bool Never! {
    if arg.expr == .Ident(name, span, _) {
        index: sema_scope_resolve_index_at(scopes, name, span) ?? return false
        return scopes.bindings[index].symbol.kind == SymbolKind.Function
    }
    false
}

// The argument names a binding that holds an ExpiringSecret loan.
sema_ownership_binding_is_expiring_secret_loan: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable) -> Bool {
    binding: sema_ownership_binding_for_expr(state, expr, scopes)
    if binding == .Val(info) -> return sema_contains_expiring_secret_loan(info.symbol.ty ?? Type.Named{name: "Unit"})
    false
}

// Rust `reject_expiring_secret_loan_change`: the `.with` callback's loan is
// read-only; moving, changing or dropping it could let the credential escape.
sema_ownership_diag_expiring_secret_loan_change: fn(name: String, action: String, span: Span) -> Diagnostic {
    sema_error("E0201", span, "ExpiringSecret loan `{name}` cannot {action}", "the callback receives temporary read access; moving, changing, or dropping it could let the credential escape its expiry boundary", "use the loan only for read-only operations inside this callback")
}

// `ty` is the parameter's declared type, when `name` is that parameter.
sema_ownership_diag_move_from_borrowed: fn(name: String, ty: Type?, span: Span) -> Diagnostic {
    shown: type_name(ty ?? Type.Named{name: "T"})
    sema_error("E0201", span, "`{name}` cannot be moved from borrowed storage", "read and write parameters and named windows keep ownership with their source", "copy the value with `{name}.copy()`, or declare the parameter `{name}: &&{shown}` to take ownership")
}

// `.move()` never lowers to a copy. A call argument `p.move()` or `p.f.move()`
// whose root is a read parameter has no storage to give up: report it at the
// mark (E0201, as at a value-position mark in Expressions/Places.jet) instead
// of letting lowering copy the place. A write parameter's field keeps the
// refill-before-exit move the last-use pass proves. True when rejected.
sema_ownership_reject_read_param_move: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    root: sema_ownership_binding_for_expr(state, expr, scopes) ?? return false
    if root.symbol.kind != SymbolKind.Parameter || root.access != AccessConvention.Read -> return false
    // An ExpiringSecret loan's own move rule reports the mark.
    if sema_contains_expiring_secret_loan(root.symbol.ty ?? Type.Named{name: "Unit"}) -> return false
    start: sema_ownership_place_root_start(expr) ?? expr_span(expr).start
    diagnostics.push(sema_ownership_diag_move_from_borrowed(root.symbol.name, root.symbol.ty, Span{start: start, end: expr_span(expr).end}))
    true
}

// A `.move()` argument whose root reads its value in place (a `:` name over a
// field or element, a loop name over borrowed storage, a match payload read
// in place) has no storage of its own to give up: E0201, as
// sema_ownership_mark_move_as reports for a call argument. True when
// rejected.
sema_ownership_reject_place_alias_move: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, consumer: String, diagnostics: &[Diagnostic]) -> Bool {
    root: sema_ownership_binding_for_expr(state, expr, scopes) ?? return false
    if !root.place_alias -> return false
    diagnostics.push(sema_ownership_diag_place_alias_move(root.symbol.name, consumer, expr_span(expr)))
    true
}

sema_ownership_diag_place_alias_move: fn(name: String, consumer: String, span: Span) -> Diagnostic {
    sema_error("E0201", span, "`{name}` cannot be moved from borrowed storage", "`{name}` reads its value through a view of the place it was bound to, so that place keeps the value; moving it here would copy it", "write `{name}.copy()` when {consumer} should receive a copy, or move the place itself with `.move()` when this scope owns it")
}

// `borrowed_read` is Rust `check_call_argument_access`'s flag: a read argument
// of a non-scalar read parameter keeps its loan through the call. `single_use`
// is false for a receiver call: E0142 belongs to direct calls and function
// values (check_callable_argument_ownership), never to a Core route or a method
// call.
sema_ownership_check_call_arguments_with_accesses: fn(state: &SemaOwnershipState, callee: String, params: [SemaCallParam], receiver: AccessConvention?, args: &[CallArg], scopes: SemaScopeTable, diagnostics: &[Diagnostic], initial_accesses: &&[SemaOwnershipCallAccess], initial_accepted: Bool, initial_complete: Bool, borrowed_read: Bool, single_use: Bool) -> SemaOwnershipCheckResult {
    accesses := initial_accesses
    accepted := initial_accepted
    complete := initial_complete
    // Reports that predate this call's argument checks: a nested call
    // already judged its own arguments against its own accesses.
    known: diagnostics.len()
    loop index in 0..<args.len() {
        arg := args[index]
        param: sema_ownership_param_for_arg(params, arg, index) ?? {
            complete = false
            next
        }
        // Rust CallBinder `substitute_param_refs`: a default's reads of
        // earlier parameters name the call's own slot temporaries, never a
        // caller place, so those places take no part in the caller's checks.
        binder_names: loop reference in arg.flags.binder_refs -> reference.name
        binder_rooted := false
        places := [SemaOwnershipPlace]{}
        loop place in sema_ownership_places_from_expr_in_state(arg.expr, scopes, state) {
            if binder_names.contains(place.root) {
                binder_rooted = true
                next
            }
            places.push(place)
        }
        if (scopes.writes_explicit || arg.mark != None) && !binder_rooted -> sema_call_marks_check_argument(scopes, callee, receiver, params, param, arg, diagnostics)
        if !binder_rooted && single_use && !callee.starts_with("core.") && !sema_single_use_check_argument(state, callee, param.convention, arg.expr, scopes, diagnostics) {
            accepted = false
            next
        }
        // An unmarked place a write parameter receives is
        // its write access, checked as `&place` was.
        if sema_call_unmarked_write_place(param, arg) {
            arg.convention = AccessConvention.Write
            args[index].convention = AccessConvention.Write
        }
        decision: sema_call_argument_convention(param, arg)
        write_place_ok := true
        if arg.convention == AccessConvention.Write && write_place_ok {
            if arg.expr == {
                .Slice(_, _, _, _, _, _) -> if !sema_window_contains(state.fixed_length_write_params, sema_window_callee_key(callee, param.name)) {
                    accepted = false
                    write_place_ok = false
                    diagnostics.push(sema_ownership_call_diag_write_range_window(arg.span))
                }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
            }
        }
        // E0204 (#4702, Rust `reject_take_while_lent`): an earlier argument
        // of this call already holds the name, or the projected place
        // (`pair(d.title, d.title.move())`), a take parameter would receive.
        take_lent: param.convention == AccessConvention.Move && !binder_rooted && (sema_ownership_unmarked_moves_name(arg.expr) || sema_ownership_takes_projected_place(arg)) && !sema_ownership_type_is_copy(param.ty ?? Type.Named{name: "Unit"}) && sema_ownership_call_places_lent(accesses, places)
        if !binder_rooted && !sema_ownership_check_argument_evaluation(state, accesses, arg, places.len() > 0, scopes, known, diagnostics) -> accepted = false
        read_held: arg.convention == AccessConvention.Read && param.convention == AccessConvention.Read && borrowed_read && !sema_ownership_type_is_scalar(param.ty ?? Type.Named{name: "Unit"})
        holds: read_held || arg.convention == AccessConvention.Move || (param.convention == AccessConvention.Move && !sema_ownership_type_is_copy(param.ty ?? Type.Named{name: "Unit"}))
        if places.len() > 0 && write_place_ok {
            loop actual in places {
                if sema_ownership_call_access_conflict(accesses, actual, arg.convention, false, holds) == .Val(active) {
                    accepted = false
                    if sema_script_variable_default(arg.expr, param) != None {
                        diagnostics.push(sema_script_alias_diagnostic(sema_call_reflection_leaf_name(callee), param, active == AccessConvention.Write, expr_span(arg.expr)))
                    } else {
                        diagnostics.push(sema_ownership_diag_alias(sema_ownership_place_name(actual), active == AccessConvention.Write, expr_span(arg.expr)))
                    }
                }
            }
            if !binder_rooted {
                // Rust `check_call_arguments`: only a write parameter gates the
                // argument's root on write capability; `&` toward a parameter
                // that does not edit runs the change checks alone.
                checked: if {
                    // An earlier argument's lambda moved its captures when it
                    // was built; Rust infers each argument after the previous
                    // one's captures, so a write to a moved place is E0121.
                    arg.convention == AccessConvention.Write && sema_ownership_moved_before(state, arg.expr, scopes) && !sema_ownership_check_moved_place_use(state, arg.expr, scopes, diagnostics) -> false
                    arg.convention == AccessConvention.Write && param.convention == AccessConvention.Write -> sema_ownership_check_write_argument(state, arg.expr, callee, receiver, params, scopes, diagnostics)
                    arg.convention == AccessConvention.Write -> sema_ownership_check_write_change(state, arg.expr, "be passed with write access", scopes, diagnostics)
                    // Exact-place inference has already checked and consumed
                    // this projected argument; reading it again is a reuse.
                    arg.convention == AccessConvention.Move && (if arg.expr == {
                        .Place(_, access, _, _) -> access == PlaceAccess.Take
                        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
                    }) -> true
                    else -> sema_ownership_check_use(state, arg.expr, scopes, diagnostics)
                }
                if !checked -> accepted = false
            }
            // A name reported in two slots (E0209 below) is settled: it lends
            // nothing to the call, as in Rust `take_unmarked_last_use`.
            twice: decision == SemaCallConventionDecision.NeedsImplicitClone && !binder_rooted && sema_ownership_expr_site_listed(state.implicit_take_twice, arg.expr)
            if !twice && (arg.convention != AccessConvention.Move || !sema_ownership_type_is_copy(param.ty ?? Type.Named{name: "Unit"})) {
                write: arg.convention == AccessConvention.Write
                loop place in places -> accesses.push(SemaOwnershipCallAccess{place: place, access: arg.convention, span: arg.span, reserved: write, retained: write || read_held})
            }
        }
        if !binder_rooted && !sema_ownership_check_argument_captures(state, accesses, arg, scopes, known, diagnostics) -> accepted = false
        mark_implicit_take := false
        if decision == SemaCallConventionDecision.NeedsImplicitClone {
            if sema_ownership_type_is_copy(param.ty ?? Type.Named{name: "Unit"}) -> next
            // A top-level function item names static code: passing it
            // copies nothing and leaves nothing to move.
            if sema_ownership_argument_is_function_item(arg, scopes) -> next
            if take_lent {
                accepted = false
                diagnostics.push(sema_ownership_diag_take_while_lent(sema_ownership_taken_name(arg, places), callee, expr_source_span(arg.expr)))
                next
            }
            // A name in two argument slots of one call has
            // no last use there (Rust `named_elsewhere`).
            if !binder_rooted && sema_ownership_expr_site_listed(state.implicit_take_twice, arg.expr) {
                accepted = false
                diagnostics.push(sema_ownership_diag_take_twice(sema_ownership_argument_name(arg), callee, expr_span(arg.expr)))
                next
            }
            // An unmarked name a take parameter receives
            // moves like `name.move()` did; a later use reports the move into this
            // call. A call never copies on its own.
            if !binder_rooted {
                mark_implicit_take = true
                if !sema_ownership_mark_implicit_take(state, arg.expr, scopes, callee, diagnostics) -> accepted = false
            }
        }
        // Exact-place inference already consumed a projected take; while an
        // earlier argument still reads that place, the take is E0204, never a
        // move the backend would find used after it was moved.
        if take_lent && sema_ownership_takes_projected_place(arg) {
            accepted = false
            diagnostics.push(sema_ownership_diag_take_while_lent(sema_ownership_taken_name(arg, places), callee, expr_source_span(arg.expr)))
            next
        }
        if !mark_implicit_take && param.convention == AccessConvention.Move && arg.convention == AccessConvention.Move && !binder_rooted && sema_ownership_unmarked_moves_name(arg.expr) {
            if take_lent {
                accepted = false
                diagnostics.push(sema_ownership_diag_take_while_lent(sema_ownership_taken_name(arg, places), callee, expr_source_span(arg.expr)))
                next
            }
            if !sema_ownership_mark_move(state, arg.expr, scopes, sema_ownership_callee_text(callee), diagnostics) -> accepted = false
        }
        if param.convention == AccessConvention.Move && arg.convention == AccessConvention.Move && !binder_rooted && sema_ownership_exact_field_take(state, arg.expr) {
            // A place the use check above already found moved is reported there.
            moved_before := false
            loop place in places {
                if sema_ownership_place_moved(state, place) != None -> moved_before = true
            }
            if !moved_before {
                if sema_ownership_mark_move(state, arg.expr, scopes, "`{sema_expression_move_mark_text(arg.expr)}.move()`", diagnostics) {
                    sema_ownership_label_moves(state, expr_span(arg.expr), expr_source_span(arg.expr))
                } else {
                    accepted = false
                }
            }
        }
        if mark_implicit_take -> args[index].convention = AccessConvention.Move
    }
    if !sema_ownership_activate_call_reservations(accesses, diagnostics) -> accepted = false
    SemaOwnershipCheckResult{accepted: accepted, complete: complete}
}

sema_ownership_call_places_lent: fn(accesses: [SemaOwnershipCallAccess], places: [SemaOwnershipPlace]) -> Bool Never! {
    loop active in accesses {
        loop place in places {
            if sema_ownership_places_overlap(active.place, place) -> return true
        }
    }
    false
}

// A `.move()` argument naming a projected place (`d.title.move()`), which
// exact-place inference moves as that field, never as its whole owner.
sema_ownership_takes_projected_place: fn(arg: CallArg) -> Bool Never! {
    if arg.convention != AccessConvention.Move -> return false
    if arg.expr == {
        .Place(value, access, _, _) -> access == PlaceAccess.Take && !sema_ownership_unmarked_moves_name(value)
        .Field(_, _, _, _) -> true
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// The source spelling a take-while-lent report names: the argument's name,
// else its projected place (`d.title`).
sema_ownership_taken_name: fn(arg: CallArg, places: [SemaOwnershipPlace]) -> String Never! {
    if arg.expr == .Ident(name, _, _) -> return name
    if places.len() > 0 -> return sema_ownership_place_name(places[0])
    "this value"
}

sema_ownership_diag_take_while_lent: fn(name: String, callee: String, span: Span) -> Diagnostic {
    consumer: sema_ownership_callee_text(callee)
    sema_error("E0204", span, "`{name}` is already lent to this call, so {consumer} can't take it here too", "an earlier argument lets {consumer} read `{name}` for the whole call, so this argument can't hand the same value over", "pass a copy to one of the two parameters with `{name}.copy()`")
}

// The callee as a diagnostic names it: a built-in collection method by its
// call shape (`.push()`), any other callee by its name.
sema_ownership_callee_text: fn(callee: String) -> String Never! {
    if callee.starts_with("collection.") -> return "`.{callee.slice(11, callee.len())}()`"
    "`{callee}`"
}

sema_ownership_place_root_start: fn(expr: Expr) -> Int? Never! {
    if expr == {
        .Ident(_, span, _) -> return Val(span.start)
        .Field(base, _, _, _) -> return sema_ownership_place_root_start(base)
        .Index(base, _, _, _, _) -> return sema_ownership_place_root_start(base)
        .Slice(base, _, _, _, _, _) -> return sema_ownership_place_root_start(base)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
}

// A write window type (`ViewMut<T>`, `ComputeViewMut<T>`): its `&` place
// construction stays written at a read parameter (Rust `is_window_type`).
sema_ownership_is_window_type: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, _) -> name == "ViewMut" || name == "ComputeViewMut"
        .Tagged(_, inner) -> sema_ownership_is_window_type(inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// E0209 (Rust `take_unmarked_last_use` `named_elsewhere`): one call names
// the same binding in two argument slots, so neither slot is its last use.
sema_ownership_diag_take_twice: fn(name: String, callee: String, span: Span) -> Diagnostic {
    consumer: sema_ownership_callee_text(callee)
    sema_error("E0209", span, "`{name}` is passed to {consumer} more than once in this call", "a name used in two arguments of one call has no last use in that call, so {consumer} can't take `{name}` there", "write `{name}.copy()` in the argument that keeps a copy")
}

sema_ownership_expr_site_listed: fn(sites: [Span], expr: Expr) -> Bool Never! {
    if expr == .Ident(_, span, _) {
        loop site in sites {
            if sema_ownership_span_same(site, span) -> return true
        }
    }
    false
}

sema_ownership_exact_field_take: fn(state: SemaOwnershipState, expr: Expr) -> Bool Never! {
    if expr == .Field(_, _, _, _) {
        span: expr_span(expr)
        loop site in state.exact_field_takes {
            if sema_ownership_span_same(site, span) -> return true
        }
    }
    false
}

// The move of an eligible unmarked take argument: an exact move whose origin
// names the callee, so a later use reports E0209 at the argument.
sema_ownership_mark_implicit_take: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, callee: String, diagnostics: &[Diagnostic]) -> Bool {
    if !sema_ownership_mark_move(state, expr, scopes, sema_ownership_callee_text(callee), diagnostics) -> return false
    span: expr_span(expr)
    loop index in 0..<state.moved.len() {
        if sema_ownership_span_same(state.moved[index].origin.span, span) -> state.moved[index].origin.implicit_take = Val(callee)
    }
    true
}

// (Rust `once_lambda_sites`): the lambda at `site` takes
// its captured `capture` with `.move()`, so it can run only once.
sema_ownership_note_once_lambda: fn(state: &SemaOwnershipState, site: Span, capture: String) Never! {
    loop once in state.once_lambdas {
        if sema_ownership_span_same(once.site, site) -> return
    }
    state.once_lambdas.push(SemaOwnershipOnceLambda{site: site, key: "", capture: capture})
}

// (Rust `once_lambdas`): the binding `key` holds the
// run-once lambda at `site`.
sema_ownership_bind_once_lambda: fn(state: &SemaOwnershipState, site: Span, key: String) Never! {
    loop index in 0..<state.once_lambdas.len() {
        if sema_ownership_span_same(state.once_lambdas[index].site, site) -> state.once_lambdas[index].key = key
    }
}

// The binding `key` holds a lambda writing the captured `names`.
sema_ownership_bind_closure_writes: fn(state: &SemaOwnershipState, key: String, names: [String]) Never! {
    state.closure_writes.push(SemaOwnershipClosureWrites{key: key, names: names})
}

// The captured names a call of the lambda binding `callee` writes.
sema_ownership_closure_writes: fn(state: &SemaOwnershipState, callee: Expr, scopes: SemaScopeTable) -> [String] Never! {
    binding: sema_ownership_binding_for_expr(state, callee, scopes) ?? return [String]{}
    loop writes in state.closure_writes {
        if writes.key == binding.symbol.id.key -> return writes.names.copy()
    }
    [String]{}
}

// A call of a lambda that writes the captured `name` changes it as a direct
// write would: not while a live view or window looks into it, since a push
// or clear through the capture can move or free the storage under the view.
sema_ownership_check_closure_write_views: fn(state: &SemaOwnershipState, name: String, callee_name: String, span: Span, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) {
    owner: Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}
    action: "be changed by calling `{callee_name}`"
    loop place in sema_ownership_places_from_expr_in_state(owner, scopes, state) {
        if sema_ownership_conflicting_view_for_expr(state, place, AccessConvention.Write, owner, scopes) == .Val(fact) {
            diagnostics.push(sema_ownership_diag_view_change(fact, place, action, span, scopes))
            return
        }
        if sema_ownership_active_loan_conflict_for_expr(state, place, AccessConvention.Write, owner, scopes) == .Val(loan) {
            diagnostics.push(sema_ownership_diag_loan_change(state, loan, place, action, span, scopes))
            return
        }
    }
}

// An escaping lambda bound in this scope writes the captured `names`: it
// holds their write access while the scope lasts, so assigning one of them
// directly is E0204 (Rust `lambda_mut_borrow_stack`).
sema_ownership_bind_lambda_write_borrows: fn(state: &SemaOwnershipState, names: [String]) Never! {
    loop name in names -> state.lambda_write_borrows.push(SemaOwnershipLambdaWriteBorrow{name: name, scope_depth: state.scope_depth})
}

// Rust `lambda_mut_borrow_active`.
sema_ownership_lambda_write_borrow_active: fn(state: SemaOwnershipState, name: String) -> Bool Never! {
    loop borrow in state.lambda_write_borrows {
        if borrow.name == name -> return true
    }
    false
}

// True when `span` lies inside a checked `#Reactive` body.
sema_ownership_in_reactive_body: fn(state: SemaOwnershipState, span: Span) -> Bool Never! {
    loop body in state.reactive_bodies {
        if span.start >= body.start && span.end <= body.end -> return true
    }
    false
}

// The lambda at `site` is bound to a local that only direct calls reach, or
// is called where it is written.
sema_ownership_note_direct_call_lambda: fn(state: &SemaOwnershipState, site: Span) Never! {
    loop known in state.direct_call_lambdas {
        if sema_ownership_span_same(known, site) -> return
    }
    state.direct_call_lambdas.push(site.copy())
}

// Whether the lambda at `site` is bound to a local that only direct calls
// reach, or is called where it is written.
sema_ownership_is_direct_call_lambda: fn(state: SemaOwnershipState, site: Span) -> Bool Never! {
    loop known in state.direct_call_lambdas {
        if sema_ownership_span_same(known, site) -> return true
    }
    false
}

// The binding `key` holds the lambda at `site` with `captures`. When only
// direct calls reach it, each call reads its outer bindings, whether they
// are viewed in place or were copied at creation: a capture is shared read
// access to its owner (spec "Captures and escaping lambdas").
sema_ownership_bind_closure_captures: fn(state: &SemaOwnershipState, key: String, site: Span, captures: [TCapture], facts: TCaptureFacts, scopes: SemaScopeTable) Never! {
    if facts.escapes && !sema_ownership_is_direct_call_lambda(state, site) -> return
    places := [SemaOwnershipPlace]{}
    loop capture in captures {
        name: capture.source
        if facts.moved.contains(name) || facts.materialized.contains(name) -> next
        index: sema_scope_resolve_index(scopes, name) ?? -1
        if index < 0 -> next
        symbol: scopes.bindings[index].symbol
        place: SemaOwnershipPlace{root: symbol.name, root_key: symbol.id.key, root_span: symbol.span, projections: [String]{}, typed_projections: [SemaOwnershipProjection]{}}
        // A capture already moved here was moved by the lambda's own body
        // (`name.move()`): that lambda runs once, which its own check enforces.
        if sema_ownership_place_moved(state, place) != None -> next
        places.push(place)
    }
    if places.len() > 0 -> state.closure_captures.push(SemaOwnershipClosureCaptures{key: key, places: places})
}

// A call of the lambda binding `callee` reads its captures: one that moved
// since is a use after move at the call.
sema_ownership_check_closure_captures: fn(state: &SemaOwnershipState, callee: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) {
    if callee == .Ident(_, span, _) {
        binding: sema_ownership_binding_for_expr(state, callee, scopes) ?? return
        loop captured in state.closure_captures {
            if captured.key != binding.symbol.id.key -> next
            loop place in captured.places {
                if sema_ownership_place_moved(state, place) == .Val(origin) -> sema_ownership_report_moved(state, origin, place, span, diagnostics)
            }
        }
    }
}

// A call of a run-once lambda binding moves the binding,
// so a later call on any path reports E0121 naming the taken capture. The
// callee's own use check already reported a call after the move.
sema_ownership_call_once_lambda: fn(state: &SemaOwnershipState, callee: Expr, scopes: SemaScopeTable) Never! {
    if callee == .Ident(_, span, _) {
        binding: sema_ownership_binding_for_expr(state, callee, scopes) ?? return
        capture := String?{None}
        loop once in state.once_lambdas {
            if once.key != "" && once.key == binding.symbol.id.key -> capture = Val(once.capture)
        }
        if capture == None -> return
        places: sema_ownership_places_from_expr_in_state(callee, scopes, state)
        loop place in places {
            if sema_ownership_place_moved(state, place) != None -> return
        }
        loop place in places -> state.moved.push(SemaOwnershipMovedPlace{place: place, origin: SemaOwnershipMoveOrigin{span: span, consumer: "its first call", share_ty: None, once_capture: capture}})
    }
}

// (Rust `take_unmarked_last_use`): the typed argument
// check notes an unmarked argument to a take parameter that moves at its
// name's last use. Only a plain owned local or take parameter of an ordinary
// copyable value qualifies: any other argument (a value with cleanup, a type
// parameter, a task, a view, a string view, a capture inside a lambda body)
// the typed argument check marks as the parameter's take. Returns the noted
// binding's symbol key, so the caller can find the same name in a later
// argument (sema_ownership_note_implicit_take_twice).
sema_ownership_note_implicit_take: fn(state: &SemaOwnershipState, expr: Expr, ty: Type, required: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, generic_params: [TGenericParam], scopes: SemaScopeTable) -> String? Never! {
    if expr == .Ident(_, span, _) {
        facts: sema_copy_classify(ty, SemaCopyIntent.Clone, environment, program, generic_params, false)
        binding: sema_ownership_binding_for_expr(state, expr, scopes) ?? return None
        if binding.symbol.kind != SymbolKind.Local && binding.symbol.kind != SymbolKind.Parameter -> return None
        // A name that reads its place in place (a `:` projection, a loop name
        // over borrowed storage) has nothing to hand over: the take is the
        // exact move, which refuses it (E0201). A call never copies on its own.
        if sema_ownership_binding_is_borrowed_param(binding) || binding.place_alias || binding.string_view -> return None
        if sema_single_use_key(state, binding.symbol.id.key) -> return None
        if sema_ownership_binding_captured(scopes, binding) -> return None
        if !type_identity_equal(ty, required) || sema_ownership_type_mentions_generic(ty, generic_params) -> return None
        if !facts.accepted || !facts.complete || facts.copyable || !facts.cloneable || facts.resource || facts.materializes_view || facts.dynamic_loan -> return None
        state.implicit_take_ok.push(span.copy())
        return Val(binding.symbol.id.key)
    }
    None
}

// A noted take argument whose name another argument of
// the same call also references has no last use in that call; the call
// ownership check reports E0209 there instead of moving it.
sema_ownership_note_implicit_take_twice: fn(state: &SemaOwnershipState, span: Span) Never! {
    index := state.implicit_take_ok.len()
    loop index > 0 {
        index -= 1
        if sema_ownership_span_same(state.implicit_take_ok[index], span) -> _ := state.implicit_take_ok.remove(index, .Slot)
    }
    state.implicit_take_twice.push(span.copy())
}

// A binding declared outside the innermost lambda body around this point.
sema_ownership_binding_captured: fn(scopes: SemaScopeTable, binding: SemaScopeBinding) -> Bool Never! {
    frame := scopes.current
    loop frame >= 0 && frame < scopes.frames.len() {
        if frame == binding.frame -> return false
        if scopes.frames[frame].owner.starts_with("lambda@") -> return true
        frame = scopes.frames[frame].parent
    }
    false
}

sema_ownership_type_mentions_generic: fn(ty: Type, generic_params: [TGenericParam]) -> Bool Never! {
    if ty == {
        .Named(name) -> {
            loop param in generic_params {
                if param.name == name -> return true
            }
            false
        }
        .Apply(_, args) -> {
            loop arg in args {
                if sema_ownership_type_mentions_generic(arg, generic_params) -> return true
            }
            false
        }
        .List(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .Shared(inner) -> sema_ownership_type_mentions_generic(inner, generic_params)
        .Map(key, _, value) | .Result(key, value) -> sema_ownership_type_mentions_generic(key, generic_params) || sema_ownership_type_mentions_generic(value, generic_params)
        .Tuple(fields) -> {
            loop field in fields {
                if sema_ownership_type_mentions_generic(field.ty, generic_params) -> return true
            }
            false
        }
        .Int | .Float | .Bool | .String | .Char | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_ownership_check_call_arguments: fn(state: &SemaOwnershipState, callee: String, params: [SemaCallParam], args: &[CallArg], scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaOwnershipCheckResult {
    sema_ownership_check_call_arguments_with_accesses(state, callee, params, None, args, scopes, diagnostics, [SemaOwnershipCallAccess]{}, true, true, true, true)
}

sema_ownership_argument_name: fn(arg: CallArg) -> String Never! {
    if arg.expr == {
        .Ident(name, _, _) -> name
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> "this value"
    }
}

// The small receiver hook is separate because method resolution owns the
// receiver convention.  It reserves the receiver only for the duration of a
// call and therefore cannot leak a Rust-style borrow into later statements.
sema_ownership_check_call_receiver: fn(state: &SemaOwnershipState, receiver: Expr, convention: AccessConvention, scopes: SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    sema_ownership_check_call_receiver_as(state, receiver, convention, true, "", "", [SemaCallParam]{}, scopes, span, expr_span(receiver), diagnostics)
}

// A built-in method's receiver check: a consuming receiver names the method
// it moved into (`t` was consumed by `.join()`), never a generic phrase.
sema_ownership_check_method_receiver: fn(state: &SemaOwnershipState, receiver: Expr, convention: AccessConvention, method: String, scopes: SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    sema_ownership_check_call_receiver_as(state, receiver, convention, true, "", "`.{method}()`", [SemaCallParam]{}, scopes, span, expr_span(receiver), diagnostics)
}

// `change_span` anchors the missing write-capability report: the receiver for
// a built-in method, the method name for a declared one (Rust passes
// `receiver.span()` or the call span to `check_mutating_method_receiver`).
// `consumer` names the method a consuming receiver moves into; empty when the
// caller has no method spelling to show. `params` are the method's, for the
// signature line a changeability error quotes.
sema_ownership_check_call_receiver_as: fn(state: &SemaOwnershipState, receiver: Expr, convention: AccessConvention, capability: Bool, method: String, consumer: String, params: [SemaCallParam], scopes: SemaScopeTable, span: Span, change_span: Span, diagnostics: &[Diagnostic]) -> Bool {
    sema_ownership_note_call_receiver(state, receiver, convention)
    if scopes.writes_explicit && convention != AccessConvention.Read -> sema_receiver_mark_sign(state, receiver, sema_ownership_signature_line(method, Val(convention), params))
    places: sema_ownership_places_from_expr_in_state(receiver, scopes, state)
    if places.len() == 0 {
        if convention == AccessConvention.Write {
            if sema_ownership_writes_temporary_edit_guard(receiver) -> return true
            diagnostics.push(sema_error("E0111", span, "this call writes a temporary value", "write access can only be granted to stable storage, not a temporary expression", "bind the value with `:=` first, then call the method on that name"))
            return false
        }
        return true
    }
    if convention == {
        .Write -> if {
            capability && method != "" -> sema_ownership_check_receiver_write(state, receiver, method, params, scopes, change_span, diagnostics)
            capability -> sema_ownership_check_write(state, receiver, "", scopes, diagnostics)
            else -> sema_ownership_check_write_change(state, receiver, "", scopes, diagnostics)
        }
        .Move -> {
            if !sema_ownership_mark_move(state, receiver, scopes, if consumer == "" -> "a consuming method call" else -> consumer, diagnostics) -> return false
            // A field receiver's own span is its name; the label covers the place.
            sema_ownership_label_moves(state, expr_span(receiver), expr_source_span(receiver))
            true
        }
        .Read -> sema_ownership_check_use(state, receiver, scopes, diagnostics)
    }
}

// Records the receiver's resolved convention for the mark check and the call's
// receiver access, with no ownership check.
sema_ownership_note_call_receiver: fn(state: &SemaOwnershipState, receiver: Expr, convention: AccessConvention) {
    sema_receiver_mark_note(state, receiver, convention)
    state.receiver_accesses[sema_ownership_span_key(expr_span(receiver))] = SemaOwnershipReceiverAccess{convention: convention, reserved: false}
}

// A method that writes its receiver, called on a place that can't change: the
// report quotes the method's signature line.
sema_ownership_check_receiver_write: fn(state: &SemaOwnershipState, receiver: Expr, method: String, params: [SemaCallParam], scopes: SemaScopeTable, change_span: Span, diagnostics: &[Diagnostic]) -> Bool {
    action: "be changed by `.{method}()`"
    binding: sema_ownership_binding_for_expr(state, receiver, scopes)
    immutable: if binding == {
        .Val(info) -> !info.mutable && info.access != AccessConvention.Write && !sema_ownership_binding_is_edit_shared_guard(info)
        .None -> false
    }
    if !immutable || sema_ownership_view_exists_for_expr(state, receiver, scopes) || sema_ownership_writes_read_shared_guard(receiver, scopes) {
        return sema_ownership_check_write(state, receiver, action, scopes, diagnostics)
    }
    if !sema_ownership_check_write_change(state, receiver, action, scopes, diagnostics) -> return false
    info: binding ?? return false
    root: sema_receiver_mark_place_root(receiver) ?? info.symbol.name
    why: "{sema_ownership_signature_line(method, Val(AccessConvention.Write), params)} changes the value it's called on"
    diagnostic: if {
        root == "self" -> sema_error("E0205", change_span, "`.{method}()` edits `self`, but this method has read access only", why, "declare the enclosing method with the write mark: `&self`")
        info.symbol.kind == SymbolKind.Parameter -> sema_error("E0205", change_span, "`.{method}()` changes `{root}`, which has read access only", "{why}, but an unmarked parameter gives read access only", "change the parameter to `{root}: &{type_name(info.symbol.ty ?? Type.Named{name: "Unit"})}`")
        else -> sema_ownership_diag_unchangeable(info, root, change_span, "{why}, so `{root}` must be mutable (`:=`)")
    }
    diagnostics.push(diagnostic)
    false
}

// The root name of a place: a name plus fields, indexes, or ranges.
sema_receiver_mark_place_root: fn(expr: Expr) -> String? {
    if expr == {
        .Ident(name, _, _) -> return Val(name)
        .Field(base, _, _, _) -> return sema_receiver_mark_place_root(base)
        .Index(base, _, _, _, _) -> return sema_receiver_mark_place_root(base)
        .Slice(base, _, _, _, _, _) -> return sema_receiver_mark_place_root(base)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
}

sema_receiver_mark_rank: fn(convention: AccessConvention) -> Int Never! {
    if convention == {
        .Read -> 0
        .Write -> 1
        .Move -> 2
    }
}

// Opens the receiver frame of a method call. A place a desugaring builds
// (`g[1] = 99` through an index hook) is checked as its value; a write window
// receiver (`values[0..1].sort()`) keeps its `&place` construction.
sema_receiver_mark_begin: fn(state: &SemaOwnershipState, receiver: Expr) -> Expr {
    unmarked := receiver
    if receiver == .Place(value, access, _, _) {
        window: if value == {
            .Slice(_, _, _, _, _, _) -> access == PlaceAccess.Write
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
        }
        if access != PlaceAccess.Read && !window -> unmarked = value
    }
    state.receiver_frames.push(SemaReceiverMarkFrame{receiver_span: expr_span(unmarked), convention: None})
    unmarked
}

sema_receiver_mark_note: fn(state: &SemaOwnershipState, receiver: Expr, convention: AccessConvention) {
    span: expr_span(receiver)
    index := state.receiver_frames.len() - 1
    loop index >= 0 {
        frame: state.receiver_frames[index]
        if frame.receiver_span.start == span.start && frame.receiver_span.end == span.end {
            stronger: if frame.convention == {
                .Val(seen) -> sema_receiver_mark_rank(convention) > sema_receiver_mark_rank(seen)
                .None -> true
            }
            if stronger {
                updated := frame
                updated.convention = Val(convention)
                state.receiver_frames[index] = updated
            }
            return
        }
        index -= 1
    }
}

// The signature line E0228 quotes for the innermost frame over `receiver`.
sema_receiver_mark_sign: fn(state: &SemaOwnershipState, receiver: Expr, signature: String) {
    span: expr_span(receiver)
    index := state.receiver_frames.len() - 1
    loop index >= 0 {
        frame: state.receiver_frames[index]
        if frame.receiver_span.start == span.start && frame.receiver_span.end == span.end {
            updated := frame
            updated.signature = signature
            state.receiver_frames[index] = updated
            return
        }
        index -= 1
    }
}


// Rust's handle builders (`ProcessSpec` methods) report no receiver
// convention: a builder chain `spec = spec.env(…)` neither writes nor takes.
sema_receiver_mark_forget: fn(state: &SemaOwnershipState, receiver: Expr) {
    span: expr_span(receiver)
    index := state.receiver_frames.len() - 1
    loop index >= 0 {
        frame: state.receiver_frames[index]
        if frame.receiver_span.start == span.start && frame.receiver_span.end == span.end {
            updated := frame
            updated.convention = None
            state.receiver_frames[index] = updated
            return
        }
        index -= 1
    }
}

// Closes the receiver frame `sema_receiver_mark_begin` opened.
sema_receiver_mark_finish: fn(state: &SemaOwnershipState) {
    _ := state.receiver_frames.pop()
}

sema_ownership_check_method_call: fn(state: &SemaOwnershipState, callee: String, receiver: Expr, receiver_convention: AccessConvention, params: [SemaCallParam], args: &[CallArg], scopes: SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> SemaOwnershipCheckResult {
    sema_ownership_check_method_call_as(state, callee, sema_ownership_receiver_consumer(callee), receiver, receiver_convention, true, false, true, params, args, scopes, span, expr_span(receiver), diagnostics)
}

// Rust `record_call_receiver_reservation`: ordinary method-call syntax
// reserves a `&` receiver, evaluates the arguments, then activates the
// exclusive borrow, so `out.push(out[i])` and `self.f(self.cursor)` read
// the receiver before the edit begins. `borrowed_read` is false for a
// built-in collection method, whose arguments retain no call loan;
// `change_span` is where a missing write capability is reported.
sema_ownership_check_two_phase_method_call: fn(state: &SemaOwnershipState, callee: String, consumer: String, receiver: Expr, receiver_convention: AccessConvention, borrowed_read: Bool, params: [SemaCallParam], args: &[CallArg], scopes: SemaScopeTable, span: Span, change_span: Span, diagnostics: &[Diagnostic]) -> SemaOwnershipCheckResult {
    sema_ownership_check_method_call_as(state, callee, consumer, receiver, receiver_convention, true, receiver_convention == AccessConvention.Write, borrowed_read, params, args, scopes, span, change_span, diagnostics)
}

// Rust `record_call_receiver_access`: a Core stream or codec handle writes
// through the handle it names, so a write receiver keeps its call access and
// change checks but asks no write capability of the binding holding it.
sema_ownership_check_handle_method_call: fn(state: &SemaOwnershipState, callee: String, receiver: Expr, receiver_convention: AccessConvention, params: [SemaCallParam], args: &[CallArg], scopes: SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> SemaOwnershipCheckResult {
    sema_ownership_check_method_call_as(state, callee, sema_ownership_receiver_consumer(callee), receiver, receiver_convention, false, false, true, params, args, scopes, span, expr_span(receiver), diagnostics)
}

// A call is written plain and takes each input's
// convention from the callee, so an error about a value the call would change
// quotes the callee's signature line: `bump: fn(n: &Int, by: Int)`.
sema_ownership_signature_line: fn(callee: String, receiver: AccessConvention?, params: [SemaCallParam]) -> String Never! {
    inputs := [String]{}
    if receiver == .Val(convention) -> inputs.push("{sema_ownership_convention_mark(convention)}self")
    loop param in params {
        spread: if param.variadic -> "..." else -> ""
        ty: type_name(param.ty ?? Type.Named{name: "_"})
        name: if sema_ownership_param_is_unnamed(param.name) -> "" else -> "{param.name}: "
        inputs.push("{name}{spread}{sema_ownership_convention_mark(param.convention)}{ty}")
    }
    "`{sema_window_plain_name(callee)}: fn({inputs.join(", ")})`"
}

// A built-in's synthesized parameter (`arg0`) has no name worth showing.
sema_ownership_param_is_unnamed: fn(name: String) -> Bool Never! {
    if name == "" -> return true
    if !name.starts_with("arg") || name.len() == 3 -> return false
    loop (index, byte) in name.bytes() {
        code: Int.from_u8(byte)
        if index >= 3 && (code < 48 || code > 57) -> return false
    }
    true
}

sema_ownership_convention_mark: fn(convention: AccessConvention) -> String Never! {
    if convention == {
        .Write -> "&"
        .Move -> "&&"
        .Read -> ""
    }
}

// E0111 for a change to a binding that can't change. `why` names what changes
// it; a `:` binding that is not itself a window gets the `:=` edit.
sema_ownership_diag_unchangeable: fn(info: SemaScopeBinding, root: String, span: Span, why: String) -> Diagnostic {
    if !info.place_alias && info.binding_sigil == .Val(sigil) {
        diagnostic: sema_error("E0111", span, "`{root}` was made with `:`, so it can't be changed", why, "declare it with `{root} := ...`")
        return diagnostic_with_edit(diagnostic, TextEdit{span: sigil, new_text: " :="})
    }
    sema_error("E0111", span, "`{root}` can't be changed here", why, "declare it with `{root} := ...`")
}

// A type-qualified callee (`Option.map`) names the consumer of a moved
// receiver; a bare method name leaves the generic wording.
sema_ownership_receiver_consumer: fn(callee: String) -> String Never! {
    if callee.contains(".") -> "`{callee}`" else -> ""
}

sema_ownership_check_method_call_as: fn(state: &SemaOwnershipState, callee: String, consumer: String, receiver: Expr, receiver_convention: AccessConvention, capability: Bool, reserved: Bool, borrowed_read: Bool, params: [SemaCallParam], args: &[CallArg], scopes: SemaScopeTable, span: Span, change_span: Span, diagnostics: &[Diagnostic]) -> SemaOwnershipCheckResult {
    accepted: sema_ownership_check_call_receiver_as(state, receiver, receiver_convention, capability, sema_window_plain_name(callee), consumer, params, scopes, span, change_span, diagnostics)
    state.receiver_accesses[sema_ownership_span_key(expr_span(receiver))] = SemaOwnershipReceiverAccess{convention: receiver_convention, reserved: reserved}
    receiver_places: sema_ownership_places_from_expr_in_state(receiver, scopes, state)
    // Rust `record_call_receiver_access` keeps no loan for a consuming receiver.
    accesses: loop receiver_place in receiver_places -> SemaOwnershipCallAccess{place: receiver_place, access: receiver_convention, span: span, reserved: reserved, retained: !reserved && receiver_convention != AccessConvention.Move}
    sema_ownership_check_call_arguments_with_accesses(state, callee, params, Val(receiver_convention), args, scopes, diagnostics, accesses, accepted, true, borrowed_read, false)
}

// A Read receiver the call materializes into its own value before any
// argument runs (`Option.or_err`, whose canonical body takes it by move)
// keeps no loan on its place, so an argument may still change that place.
sema_ownership_check_snapshot_receiver_call: fn(state: &SemaOwnershipState, callee: String, receiver: Expr, params: [SemaCallParam], args: &[CallArg], scopes: SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> SemaOwnershipCheckResult {
    accepted: sema_ownership_check_call_receiver_as(state, receiver, AccessConvention.Read, true, sema_window_plain_name(callee), sema_ownership_receiver_consumer(callee), params, scopes, span, expr_span(receiver), diagnostics)
    state.receiver_accesses[sema_ownership_span_key(expr_span(receiver))] = SemaOwnershipReceiverAccess{convention: AccessConvention.Read, reserved: false}
    sema_ownership_check_call_arguments_with_accesses(state, callee, params, Val(AccessConvention.Read), args, scopes, diagnostics, [SemaOwnershipCallAccess]{}, accepted, true, true, false)
}

// An allocator handle named as the receiver of `alloc`/`try_alloc` keeps its
// Read call access but runs no place read on the name: the arena's `[fresh]`
// views look into storage the handle does not read (Rust
// `allocator_view_preserving_receiver`).
sema_ownership_check_allocator_handle_call: fn(state: &SemaOwnershipState, callee: String, receiver: Expr, params: [SemaCallParam], args: &[CallArg], scopes: SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> SemaOwnershipCheckResult {
    sema_ownership_note_call_receiver(state, receiver, AccessConvention.Read)
    accesses: loop receiver_place in sema_ownership_places_from_expr_in_state(receiver, scopes, state) -> SemaOwnershipCallAccess{place: receiver_place, access: AccessConvention.Read, span: span, reserved: false, retained: true}
    sema_ownership_check_call_arguments_with_accesses(state, callee, params, Val(AccessConvention.Read), args, scopes, diagnostics, accesses, true, true, true, false)
}

// A `&&name` capture moves its name out of the enclosing body when the lambda
// is made, before the body runs, so it is checked against the enclosing state.
sema_ownership_check_take_captures: fn(state: &SemaOwnershipState, lambda: Lambda, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    loop capture in lambda.take_names {
        if !sema_ownership_mark_move(state, Expr.Ident{name: capture.name, span: capture.span, id: AST_NODE_GENERATED}, scopes, "a lambda that captures it", diagnostics) -> valid = false
    }
    valid
}

sema_ownership_check_escaping_write_captures: fn(state: &SemaOwnershipState, lambda: Lambda, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    if lambda.meta.escapes {
        loop name in lambda.meta.mut_captures {
            // A write through a captured write window names the window's
            // owner too; the window's own capture carries that access.
            if sema_ownership_owner_of_captured_window(state, name, lambda.meta.mut_captures) -> next
            capture_expr: Expr.Ident{name: name, span: lambda.span, id: AST_NODE_GENERATED}
            places := sema_ownership_places_from_expr_in_state(capture_expr, scopes, state)
            if places.len() > 0 {
                if !sema_ownership_open_reference_for_expr(state, capture_expr, AccessConvention.Write, lambda.span, scopes, diagnostics) -> valid = false
            }
        }
    }
    valid
}

sema_ownership_owner_of_captured_window: fn(state: SemaOwnershipState, owner: String, captures: [String]) -> Bool Never! {
    loop view in state.views {
        if !view.active || view.invalidated || view.access != AccessConvention.Write || view.source.root != owner || view.carrier == owner -> next
        if captures.contains(view.carrier) -> return true
    }
    false
}

// ────────────────────────────────────────────────────────────────────────────
// Evaluated access walk
//
// What one call argument reads and writes while it is evaluated, and what its
// lambdas capture when they are built (push_evaluated_access through
// check_call_argument_captures). `bound` holds the names a lambda parameter or
// a body binding shadows. A call nested in the argument was checked before this
// call's accesses existed, so with `nested` the walk replays that call's
// receiver and argument checks against them, as Rust checks every call against
// each active call frame.

SemaOwnershipAccessWalk: enum {
    EvaluateNow
    ConstructCaptures
    CaptureRequirements
}

SemaOwnershipEvaluatedAccess: struct {
    place: SemaOwnershipPlace
    capture_place: SemaOwnershipPlace
    capture_ty: Type?
    capture_is_view: Bool
    access: AccessConvention
    site: Expr
    through_call: Bool
    moves_owner: Bool
}

// One place check a nested call makes against the enclosing call. `holds`
// marks an access that may outlive its evaluation: a nested call's own
// argument (whose parameter may take or keep it), a move, or a taking
// receiver. A reserved `&` argument lets only the other accesses pass.
SemaOwnershipNestedCheck: struct {
    place: SemaOwnershipPlace
    access: AccessConvention
    reserved: Bool
    holds: Bool
    span: Span
}

// A checked lambda's capture modes (TCaptureFacts), read back by its span.
SemaOwnershipLambdaFacts: struct {
    escapes: Bool
    needs_fn_mut: Bool
    cloned: [String]
    moved: [String]
}

// The receiver access a method call resolved; `reserved` is a two-phase
// `&` receiver (Rust `record_call_receiver_reservation`).
SemaOwnershipReceiverAccess: struct {
    convention: AccessConvention
    reserved: Bool
}

// Rust `capture_place_info`: the capture prefix of a written place, its
// type, and whether an index or range stopped it.
SemaOwnershipCapturePlace: struct {
    place: SemaOwnershipPlace
    ty: Type?
    stopped: Bool
}

sema_ownership_span_key: fn(span: Span) -> Int Never! {
    span.start * 4294967296 + span.end
}

// Rust lambda inference leaves the capture modes on the lambda; here the
// checked lambda records them, and hands back what its own body state
// recorded for the walk (receiver accesses, field types, inner lambdas).
sema_ownership_note_lambda: fn(state: &SemaOwnershipState, body: SemaOwnershipState, span: Span, facts: TCaptureFacts) Never! {
    loop (key, value) in body.lambda_facts -> state.lambda_facts[key] = value.copy()
    loop (key, value) in body.receiver_accesses -> state.receiver_accesses[key] = value.copy()
    loop (key, value) in body.place_types -> state.place_types[key] = value.copy()
    sema_ownership_note_lambda_facts(state, span, facts)
}

// The capture facts a call checks a lambda argument's construction against,
// keyed by the lambda's span.
sema_ownership_note_lambda_facts: fn(state: &SemaOwnershipState, span: Span, facts: TCaptureFacts) Never! {
    // copy: the capture name lists stay with `facts`, the checked lambda's own checked-tree facts.
    state.lambda_facts[sema_ownership_span_key(span)] = SemaOwnershipLambdaFacts{escapes: facts.escapes, needs_fn_mut: facts.needs_fn_mut, cloned: facts.cloned.copy(), moved: facts.moved.copy()}
}

// Rust `place_expr_type` for a field read: the checked field type.
sema_ownership_note_place_type: fn(state: &SemaOwnershipState, span: Span, ty: Type) Never! {
    // copy: `ty` stays with the checked field read.
    state.place_types[sema_ownership_span_key(span)] = ty.copy()
}

// A checked call publishes its returned-view facts under its call span.
sema_ownership_note_call_views: fn(state: &SemaOwnershipState, span: Span, facts: [SemaCallReturnViewFact]) Never! {
    // copy: the facts stay with the checked call that publishes them.
    state.call_views[sema_ownership_span_key(span)] = facts.copy()
}

// Rust `view_call_sources` for an evaluated call argument: the source places
// a nested call's returned View keeps lent, each with the output slot it
// fills. A copy of a plain read-only View is an owned value again.
sema_ownership_call_result_views: fn(state: SemaOwnershipState, expr: Expr) -> [SemaCallReturnViewFact] {
    none := [SemaCallReturnViewFact]{}
    if expr == {
        .Call(call, _) -> return state.call_views.get(sema_ownership_span_key(call.name_span)) ?? none
        .MethodCall(_, _, method_span, _, _, _, _) | .OptMethodCall(_, _, method_span, _, _, _, _) -> return state.call_views.get(sema_ownership_span_key(method_span)) ?? none
        .CallValue(_, _, span, _) -> return state.call_views.get(sema_ownership_span_key(span)) ?? none
        .Paren(value, _, _) | .Try(value, _, _, _, _) | .Present(value, _, _) | .Ok(value, _, _) | .Err(value, _, _) | .Tainted(value, _, _, _) -> return sema_ownership_call_result_views(state, value)
        .Copy(value, _, _) -> {
            sources: sema_ownership_call_result_views(state, value)
            plain := sources.len() > 0
            loop fact in sources {
                if fact.slot.len() > 0 || fact.access != AccessConvention.Read -> plain = false
            }
            return if plain -> none else -> sources
        }
        .If(_, _, then_value, _, else_value, _, _) -> {
            sources := sema_ownership_call_result_views(state, then_value)
            loop fact in sema_ownership_call_result_views(state, else_value) -> sources.push(fact)
            return sources
        }
        .OrFallback(value, fallback, _, _, _) -> {
            sources := sema_ownership_call_result_views(state, value)
            if fallback == .Value(other) {
                loop fact in sema_ownership_call_result_views(state, other) -> sources.push(fact)
            }
            return sources
        }
        .ListLit(elements, _, _) -> {
            sources := [SemaCallReturnViewFact]{}
            loop element in elements {
                loop fact in sema_ownership_call_result_views(state, element) -> sources.push(sema_ownership_call_view_prefixed(fact, [String]{"[]"}))
            }
            return sources
        }
        .TupleLit(fields, _, _, _) -> {
            sources := [SemaCallReturnViewFact]{}
            loop field in fields {
                loop fact in sema_ownership_call_result_views(state, field.value) -> sources.push(sema_ownership_call_view_prefixed(fact, [String]{field.name}))
            }
            return sources
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            sources := [SemaCallReturnViewFact]{}
            loop field in fields {
                loop fact in sema_ownership_call_result_views(state, field.value) -> sources.push(sema_ownership_call_view_prefixed(fact, [String]{field.name}))
            }
            return sources
        }
        .EnumLit(_, variant, _, args, _, _, _) -> {
            sources := [SemaCallReturnViewFact]{}
            loop index in 0..<args.len() {
                slot: if args[index] == {
                    .Positional(_) -> "{index}"
                    .Named(label, _) -> label
                }
                value: if args[index] == {
                    .Positional(positional) -> positional
                    .Named(_, named) -> named
                }
                loop fact in sema_ownership_call_result_views(state, value) -> sources.push(sema_ownership_call_view_prefixed(fact, [String]{variant, slot}))
            }
            return sources
        }
        .Index(base, _, _, _, _) -> return sema_ownership_call_view_projected(sema_ownership_call_result_views(state, base), "[]")
        .Field(base, member, _, _) -> return sema_ownership_call_view_projected(sema_ownership_call_result_views(state, base), member)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Lambda(_, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return none
    }
}

sema_ownership_call_view_prefixed: fn(fact: SemaCallReturnViewFact, prefix: [String]) -> SemaCallReturnViewFact Never! {
    slot := prefix
    loop part in fact.slot -> slot.push(part.copy())
    // copy: the source fact keeps its places for its other readers.
    SemaCallReturnViewFact{slot: slot, access: fact.access, places: fact.places.copy(), sources: fact.sources.copy(), temporaries: fact.temporaries.copy()}
}

// The facts filling output slot `member`, re-rooted at that slot.
sema_ownership_call_view_projected: fn(sources: [SemaCallReturnViewFact], member: String) -> [SemaCallReturnViewFact] Never! {
    dotted: ".{member}"
    projected := [SemaCallReturnViewFact]{}
    loop fact in sources {
        if fact.slot.len() == 0 || (fact.slot[0] != member && fact.slot[0] != dotted) -> next
        slot := [String]{}
        loop index in 1..<fact.slot.len() -> slot.push(fact.slot[index])
        // copy: the source fact keeps its places for its other readers.
        projected.push(SemaCallReturnViewFact{slot: slot, access: fact.access, places: fact.places.copy(), sources: fact.sources.copy(), temporaries: fact.temporaries.copy()})
    }
    projected
}

// Rust `record_call_result_views`: a nested call's own accesses end when it
// returns, but a returned View keeps its source lent as an argument of the
// enclosing call.
sema_ownership_record_call_result_views: fn(state: SemaOwnershipState, accesses: &[SemaOwnershipCallAccess], expr: Expr, diagnostics: &[Diagnostic]) -> Bool {
    span: expr_span(expr)
    loans := [SemaOwnershipCallAccess]{}
    loop fact in sema_ownership_call_result_views(state, expr) {
        loop place in fact.places {
            seen := false
            loop index in 0..<loans.len() {
                if sema_ownership_place_exact(loans[index].place, place) {
                    if fact.access == AccessConvention.Write -> loans[index].access = AccessConvention.Write
                    seen = true
                    break
                }
            }
            if !seen -> loans.push(SemaOwnershipCallAccess{place: sema_ownership_place_snapshot(place), access: fact.access, span: span, reserved: false, retained: true})
        }
    }
    accepted := true
    loop loan in loans {
        if sema_ownership_call_access_conflict(accesses, loan.place, loan.access, false, true) == .Val(active) {
            accepted = false
            diagnostics.push(sema_ownership_diag_alias(sema_ownership_place_name(loan.place), active == AccessConvention.Write, span))
        }
        accesses.push(SemaOwnershipCallAccess{place: sema_ownership_place_snapshot(loan.place), access: loan.access, span: span, reserved: false, retained: true})
    }
    accepted
}

// Rust `place_from_expr`: a local, parameter or constant and its field,
// index and range projections.
sema_ownership_walk_place_shape: fn(expr: Expr, scopes: SemaScopeTable) -> Bool {
    if expr == {
        .Ident(name, span, _) -> {
            index: sema_scope_resolve_index_at(scopes, name, span) ?? return false
            kind: scopes.bindings[index].symbol.kind
            return kind == SymbolKind.Local || kind == SymbolKind.Parameter || kind == SymbolKind.Constant
        }
        .Field(base, _, _, _) | .Index(base, _, _, _, _) | .Slice(base, _, _, _, _, _) | .Place(base, _, _, _) | .Paren(base, _, _) -> return sema_ownership_walk_place_shape(base, scopes)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return false
    }
}

sema_ownership_walk_places: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable) -> [SemaOwnershipPlace] {
    if !sema_ownership_walk_place_shape(expr, scopes) -> return [SemaOwnershipPlace]{}
    sema_ownership_places_from_expr_in_state(expr, scopes, state)
}

sema_ownership_capture_place_info: fn(state: SemaOwnershipState, expr: Expr, scopes: SemaScopeTable) -> SemaOwnershipCapturePlace? {
    if expr == {
        .Ident(name, span, _) -> {
            if !sema_ownership_walk_place_shape(expr, scopes) -> return None
            index: sema_scope_resolve_index_at(scopes, name, span) ?? return None
            return Val(SemaOwnershipCapturePlace{
                place: SemaOwnershipPlace{root: scopes.bindings[index].symbol.name, root_key: scopes.bindings[index].symbol.id.key, root_span: scopes.bindings[index].symbol.span, projections: [String]{}, typed_projections: [SemaOwnershipProjection]{}},
                ty: scopes.bindings[index].symbol.ty,
                stopped: false,
            })
        }
        .Field(base, member, span, _) -> {
            info := sema_ownership_capture_place_info(state, base, scopes) ?? return None
            if info.stopped -> return Val(info)
            info.place.projections.push(".{member}")
            info.place.typed_projections.push(SemaOwnershipProjection.Field{name: member, span: span})
            info.ty = if info.ty == None -> None else -> state.place_types.get(sema_ownership_span_key(span))
            return Val(info)
        }
        .Index(base, _, _, _, _) | .Slice(base, _, _, _, _, _) -> {
            info := sema_ownership_capture_place_info(state, base, scopes) ?? return None
            info.stopped = true
            return Val(info)
        }
        .Place(inner, _, _, _) | .Paren(inner, _, _) -> return sema_ownership_capture_place_info(state, inner, scopes)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
}

// Rust `is_view` of the written root name.
sema_ownership_walk_root_is_view: fn(state: SemaOwnershipState, expr: Expr, scopes: SemaScopeTable) -> Bool {
    output_path := [String]{}
    root: sema_ownership_named_view_root(expr, output_path) ?? return false
    index: sema_scope_resolve_index_at(scopes, root, expr_span(expr)) ?? return false
    key: scopes.bindings[index].symbol.id.key
    loop fact in state.views {
        if fact.active && fact.carrier_key == key -> return true
    }
    false
}

// Rust `lookup(name).param_conv.is_none()`: the root is an ordinary local,
// neither a parameter nor a write window.
sema_ownership_walk_root_is_local: fn(scopes: SemaScopeTable, expr: Expr) -> Bool {
    output_path := [String]{}
    root: sema_ownership_named_view_root(expr, output_path) ?? return false
    index: sema_scope_resolve_index_at(scopes, root, expr_span(expr)) ?? return false
    scopes.bindings[index].symbol.kind != SymbolKind.Parameter && scopes.bindings[index].access != AccessConvention.Write
}

// Rust `lookup(owner).ty`: the written root binding's type.
sema_ownership_walk_root_type: fn(scopes: SemaScopeTable, expr: Expr) -> Type? {
    output_path := [String]{}
    root: sema_ownership_named_view_root(expr, output_path) ?? return None
    index: sema_scope_resolve_index_at(scopes, root, expr_span(expr)) ?? return None
    scopes.bindings[index].symbol.ty
}

sema_ownership_walk_type_is_copy: fn(ty: Type?) -> Bool Never! {
    if ty == .Val(known) -> return sema_ownership_type_is_copy(known)
    false
}

// Rust `method_receiver_access`: the receiver access the call resolved, else
// the written `&` mark.
sema_ownership_walk_receiver_access: fn(state: SemaOwnershipState, receiver: Expr) -> AccessConvention Never! {
    unmarked := receiver
    written := false
    if receiver == .Place(value, access, _, _) {
        written = access == PlaceAccess.Write
        unmarked = value
    }
    if state.receiver_accesses.get(sema_ownership_span_key(expr_span(unmarked))) == .Val(resolved) {
        return if resolved.convention == AccessConvention.Write -> AccessConvention.Write else -> AccessConvention.Read
    }
    if written -> AccessConvention.Write else -> AccessConvention.Read
}

sema_ownership_push_evaluated_access: fn(state: &SemaOwnershipState, expr: Expr, access: AccessConvention, bound: [String], scopes: SemaScopeTable, events: &[SemaOwnershipEvaluatedAccess]) {
    places: sema_ownership_walk_places(state, expr, scopes)
    if places.len() == 0 -> return
    capture: sema_ownership_capture_place_info(state, expr, scopes)
    is_view: sema_ownership_walk_root_is_view(state, expr, scopes)
    loop place in places {
        capture_place := sema_ownership_place_snapshot(place)
        capture_ty := Type?{None}
        if capture == .Val(info) {
            capture_place = sema_ownership_place_snapshot(info.place)
            // copy: `info` stays with this access's capture prefix.
            capture_ty = info.ty.copy()
        }
        if bound.contains(capture_place.root) -> next
        merged := false
        loop index in 0..<events.len() {
            if sema_ownership_place_exact(events[index].place, place) && sema_ownership_place_exact(events[index].capture_place, capture_place) {
                if access == AccessConvention.Write {
                    events[index].access = AccessConvention.Write
                    // copy: `expr` is the read parameter naming this access site.
                    events[index].site = expr.copy()
                }
                merged = true
                break
            }
        }
        // copy: `expr` is the read parameter naming this access site.
        if !merged -> events.push(SemaOwnershipEvaluatedAccess{place: sema_ownership_place_snapshot(place), capture_place: capture_place, capture_ty: capture_ty, capture_is_view: is_view, access: access, site: expr.copy(), through_call: false, moves_owner: false})
    }
}

sema_ownership_collect_lvalue_access: fn(state: &SemaOwnershipState, target: LValue, bound: [String], nested: Bool, scopes: SemaScopeTable, events: &[SemaOwnershipEvaluatedAccess], checks: &[SemaOwnershipNestedCheck]) {
    if target == {
        .Local(name, name_span) -> sema_ownership_push_evaluated_access(state, Expr.Ident{name: name, span: name_span, id: AST_NODE_GENERATED}, AccessConvention.Write, bound, scopes, events)
        // copy: `base` is a payload of read parameter `target`; the new Expr.Field owns this one
        .Field(base, field, span) -> sema_ownership_push_evaluated_access(state, Expr.Field{base: base.copy(), member: field, span: span, id: AST_NODE_GENERATED}, AccessConvention.Write, bound, scopes, events)
        .Index(base, index, span, kind) -> {
            // copy: `base` and `index` are payloads of read parameter `target`; the new Expr.Index owns these
            sema_ownership_push_evaluated_access(state, Expr.Index{base: base.copy(), index: index.copy(), span: span, kind: kind, id: AST_NODE_GENERATED}, AccessConvention.Write, bound, scopes, events)
            sema_ownership_collect_evaluated_expr_accesses(state, index, SemaOwnershipAccessWalk.EvaluateNow, bound, nested, scopes, events, checks)
        }
    }
}

// Rust `collect_lambda_requirement_events`: the places the body reads and
// writes become the lambda's construction requirements. A cloned capture is
// read whole; an owned non-copy capture of a move closure moves the
// captured place; a capture the closure retains (a view, or a write of a
// non-escaping FnMut closure) stays lent through the call.
sema_ownership_collect_lambda_requirement_events: fn(state: &SemaOwnershipState, lambda: Lambda, scopes: SemaScopeTable, events: &[SemaOwnershipEvaluatedAccess]) {
    params: loop param in lambda.params -> param.name
    captured := [SemaOwnershipEvaluatedAccess]{}
    ignored := [SemaOwnershipNestedCheck]{}
    if lambda.body == {
        .Expr(body) -> sema_ownership_collect_evaluated_expr_accesses(state, body, SemaOwnershipAccessWalk.CaptureRequirements, params, false, scopes, captured, ignored)
        .Block(body) -> {
            bound := params.copy()
            sema_ownership_collect_evaluated_stmt_accesses(state, body, SemaOwnershipAccessWalk.CaptureRequirements, bound, false, scopes, captured, ignored)
        }
    }
    // `take` captures move at construction even when the body never names them.
    loop capture in lambda.take_names -> sema_ownership_push_evaluated_access(state, Expr.Ident{name: capture.name, span: capture.span, id: AST_NODE_GENERATED}, AccessConvention.Read, [String]{}, scopes, captured)
    taken: loop capture in lambda.take_names -> capture.name
    // A lambda this check did not record keeps plain capture reads.
    if state.lambda_facts.get(sema_ownership_span_key(lambda.span)) == .Val(facts) {
        has_write := false
        loop event in captured {
            if event.access == AccessConvention.Write -> has_write = true
        }
        retains: !facts.escapes && has_write
        loop index in 0..<captured.len() {
            name: captured[index].capture_place.root
            if facts.cloned.contains(name) {
                captured[index].place.projections = [String]{}
                captured[index].place.typed_projections = [SemaOwnershipProjection]{}
                captured[index].access = AccessConvention.Read
            } else if (facts.moved.contains(name) || !facts.needs_fn_mut || facts.escapes) && !captured[index].capture_is_view && !sema_ownership_walk_type_is_copy(captured[index].capture_ty) && sema_ownership_walk_root_is_local(scopes, captured[index].site) {
                captured[index].place = sema_ownership_place_snapshot(captured[index].capture_place)
                captured[index].access = AccessConvention.Write
                captured[index].moves_owner = true
            }
            captured[index].through_call = (captured[index].capture_is_view || (retains && !taken.contains(name))) && !captured[index].moves_owner
        }
    }
    loop event in captured {
        merged := false
        loop index in 0..<events.len() {
            if sema_ownership_place_exact(events[index].place, event.place) {
                if event.access == AccessConvention.Write {
                    events[index].access = AccessConvention.Write
                    // copy: `event` stays in this lambda's own requirement list.
                    events[index].site = event.site.copy()
                }
                events[index].through_call = events[index].through_call || event.through_call
                events[index].moves_owner = events[index].moves_owner || event.moves_owner
                merged = true
                break
            }
        }
        // copy: `event` stays in this lambda's own requirement list.
        if !merged -> events.push(event.copy())
    }
}

sema_ownership_collect_evaluated_list: fn(state: &SemaOwnershipState, values: [Expr], mode: SemaOwnershipAccessWalk, bound: [String], nested: Bool, scopes: SemaScopeTable, events: &[SemaOwnershipEvaluatedAccess], checks: &[SemaOwnershipNestedCheck]) {
    loop value in values -> sema_ownership_collect_evaluated_expr_accesses(state, value, mode, bound, nested, scopes, events, checks)
}

// Rust's capture-requirement walk of call arguments: a `&` argument lends
// its place for the call; it never moves the captured owner.
sema_ownership_collect_argument_requirements: fn(state: &SemaOwnershipState, args: [CallArg], bound: [String], scopes: SemaScopeTable, events: &[SemaOwnershipEvaluatedAccess], checks: &[SemaOwnershipNestedCheck]) {
    loop arg in args {
        sema_ownership_collect_evaluated_expr_accesses(state, arg.expr, SemaOwnershipAccessWalk.CaptureRequirements, bound, false, scopes, events, checks)
        if arg.convention == AccessConvention.Write -> sema_ownership_push_evaluated_access(state, arg.expr, AccessConvention.Write, bound, scopes, events)
    }
}

// A function value called as `callee.call(...)` checks as a call of the value.
sema_ownership_walk_called_value: fn(receiver: Expr, method: String, scopes: SemaScopeTable) -> Bool {
    if method != "call" -> return false
    if receiver == {
        .Paren(inner, _, _) -> return sema_ownership_walk_called_value(inner, method, scopes)
        .Lambda(_, _) -> return true
        .Ident(name, span, _) -> {
            index: sema_scope_resolve_index_at(scopes, name, span) ?? return false
            ty: scopes.bindings[index].symbol.ty ?? return false
            return if ty == {
                .Fn(_, _, _, _, _, _) -> true
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return false
    }
}

sema_ownership_walk_inline_loop: fn(callee: Expr) -> Lambda? {
    if callee == .Lambda(lambda, _) {
        if lambda.meta.collecting_loop || lambda.meta.result_loop -> return Val(lambda)
    }
    None
}

sema_ownership_collect_evaluated_expr_accesses: fn(state: &SemaOwnershipState, expr: Expr, mode: SemaOwnershipAccessWalk, bound: [String], nested: Bool, scopes: SemaScopeTable, events: &[SemaOwnershipEvaluatedAccess], checks: &[SemaOwnershipNestedCheck]) {
    places: sema_ownership_walk_places(state, expr, scopes)
    if places.len() > 0 {
        unbound := false
        loop place in places {
            if !bound.contains(place.root) -> unbound = true
        }
        if mode != SemaOwnershipAccessWalk.ConstructCaptures && unbound {
            written := false
            if expr == .Place(_, mark, _, _) -> written = mark == PlaceAccess.Write
            sema_ownership_push_evaluated_access(state, expr, if written -> AccessConvention.Write else -> AccessConvention.Read, bound, scopes, events)
        }
        if expr == {
            .Index(_, index, _, _, _) -> sema_ownership_collect_evaluated_expr_accesses(state, index, mode, bound, nested, scopes, events, checks)
            .Slice(_, start, end, range, _, _) -> {
                if range == .Val(range_expr) {
                    sema_ownership_collect_evaluated_expr_accesses(state, range_expr, mode, bound, nested, scopes, events, checks)
                } else {
                    sema_ownership_collect_evaluated_expr_accesses(state, start, mode, bound, nested, scopes, events, checks)
                    sema_ownership_collect_evaluated_expr_accesses(state, end, mode, bound, nested, scopes, events, checks)
                }
            }
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
        }
        return
    }
    requirements: mode == SemaOwnershipAccessWalk.CaptureRequirements
    if expr == {
        .Lambda(lambda, _) -> if mode != SemaOwnershipAccessWalk.EvaluateNow -> sema_ownership_collect_lambda_requirement_events(state, lambda, scopes, events)
        .Call(call, _) -> {
            if requirements {
                sema_ownership_collect_argument_requirements(state, call.args, bound, scopes, events, checks)
            } else if nested {
                loop arg in call.args -> sema_ownership_nested_argument_checks(state, arg, mode, scopes, checks)
            }
        }
        .MethodCall(receiver, method, method_span, _, _, args, _) -> {
            if requirements {
                receiver_access: sema_ownership_walk_receiver_access(state, receiver)
                sema_ownership_push_evaluated_access(state, receiver, receiver_access, bound, scopes, events)
                sema_ownership_collect_argument_requirements(state, args, bound, scopes, events, checks)
            } else if nested {
                if sema_ownership_walk_called_value(receiver, method, scopes) {
                    sema_ownership_nested_called_value_checks(state, receiver, mode, scopes, checks)
                } else {
                    sema_ownership_nested_receiver_checks(state, receiver, method_span, mode, scopes, checks)
                }
                loop arg in args -> sema_ownership_nested_argument_checks(state, arg, mode, scopes, checks)
            }
        }
        .OptMethodCall(receiver, _, method_span, _, args, _, _) -> {
            if requirements {
                receiver_access: sema_ownership_walk_receiver_access(state, receiver)
                sema_ownership_push_evaluated_access(state, receiver, receiver_access, bound, scopes, events)
                sema_ownership_collect_argument_requirements(state, args, bound, scopes, events, checks)
            } else if nested {
                sema_ownership_nested_receiver_checks(state, receiver, method_span, mode, scopes, checks)
                loop arg in args -> sema_ownership_nested_argument_checks(state, arg, mode, scopes, checks)
            }
        }
        .CallValue(callee, args, _, _) -> {
            if sema_ownership_walk_inline_loop(callee) == .Val(inline) {
                if inline.body == {
                    .Expr(body) -> sema_ownership_collect_evaluated_expr_accesses(state, body, mode, bound, nested, scopes, events, checks)
                    .Block(body) -> {
                        body_bound := bound.copy()
                        sema_ownership_collect_evaluated_stmt_accesses(state, body, mode, body_bound, nested, scopes, events, checks)
                    }
                }
                loop arg in args {
                    sema_ownership_collect_evaluated_expr_accesses(state, arg.expr, mode, bound, nested, scopes, events, checks)
                    if arg.convention == AccessConvention.Write -> sema_ownership_push_evaluated_access(state, arg.expr, AccessConvention.Write, bound, scopes, events)
                }
            } else if requirements {
                sema_ownership_collect_evaluated_expr_accesses(state, callee, mode, bound, false, scopes, events, checks)
                sema_ownership_collect_argument_requirements(state, args, bound, scopes, events, checks)
            } else if nested {
                sema_ownership_nested_called_value_checks(state, callee, mode, scopes, checks)
                loop arg in args -> sema_ownership_nested_argument_checks(state, arg, mode, scopes, checks)
            }
        }
        .Binary(_, left, right, _, _) -> {
            sema_ownership_collect_evaluated_expr_accesses(state, left, mode, bound, nested, scopes, events, checks)
            sema_ownership_collect_evaluated_expr_accesses(state, right, mode, bound, nested, scopes, events, checks)
        }
        .CompareChain(operands, _, _, _, _) | .ListLit(operands, _, _) -> sema_ownership_collect_evaluated_list(state, operands, mode, bound, nested, scopes, events, checks)
        .Unary(_, inner, _, _) | .Spread(inner, _, _) | .Deref(inner, _, _) | .RawOf(inner, _, _) | .Copy(inner, _, _) | .Place(inner, _, _, _) | .Tainted(inner, _, _, _) | .Present(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) | .Paren(inner, _, _) -> sema_ownership_collect_evaluated_expr_accesses(state, inner, mode, bound, nested, scopes, events, checks)
        .Try(inner, _, _, context, _) -> {
            sema_ownership_collect_evaluated_expr_accesses(state, inner, mode, bound, nested, scopes, events, checks)
            if context == .Val(note) -> sema_ownership_collect_evaluated_expr_accesses(state, note, mode, bound, nested, scopes, events, checks)
        }
        .Field(base, _, _, _) | .OptField(base, _, _, _, _, _) | .MemberSpread(base, _, _, _) -> sema_ownership_collect_evaluated_expr_accesses(state, base, mode, bound, nested, scopes, events, checks)
        .Index(base, index, _, _, _) -> {
            sema_ownership_collect_evaluated_expr_accesses(state, base, mode, bound, nested, scopes, events, checks)
            sema_ownership_collect_evaluated_expr_accesses(state, index, mode, bound, nested, scopes, events, checks)
        }
        .Slice(base, start, end, range, _, _) -> {
            sema_ownership_collect_evaluated_expr_accesses(state, base, mode, bound, nested, scopes, events, checks)
            if range == .Val(range_expr) {
                sema_ownership_collect_evaluated_expr_accesses(state, range_expr, mode, bound, nested, scopes, events, checks)
            } else {
                sema_ownership_collect_evaluated_expr_accesses(state, start, mode, bound, nested, scopes, events, checks)
                sema_ownership_collect_evaluated_expr_accesses(state, end, mode, bound, nested, scopes, events, checks)
            }
        }
        .Range(start, end, _, _, _) -> {
            sema_ownership_collect_evaluated_expr_accesses(state, start, mode, bound, nested, scopes, events, checks)
            sema_ownership_collect_evaluated_expr_accesses(state, end, mode, bound, nested, scopes, events, checks)
        }
        .MapLit(entries, _, _) -> {
            loop entry in entries {
                sema_ownership_collect_evaluated_expr_accesses(state, entry.key, mode, bound, nested, scopes, events, checks)
                sema_ownership_collect_evaluated_expr_accesses(state, entry.value, mode, bound, nested, scopes, events, checks)
            }
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            loop field in fields -> sema_ownership_collect_evaluated_expr_accesses(state, field.value, mode, bound, nested, scopes, events, checks)
        }
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> {
                    loop field in fields -> sema_ownership_collect_evaluated_expr_accesses(state, field.value, mode, bound, nested, scopes, events, checks)
                }
                .Elements(elements) -> sema_ownership_collect_evaluated_list(state, elements, mode, bound, nested, scopes, events, checks)
                .Entries(entries) -> {
                    loop entry in entries {
                        sema_ownership_collect_evaluated_expr_accesses(state, entry.key, mode, bound, nested, scopes, events, checks)
                        sema_ownership_collect_evaluated_expr_accesses(state, entry.value, mode, bound, nested, scopes, events, checks)
                    }
                }
                .Value(value) -> sema_ownership_collect_evaluated_expr_accesses(state, value, mode, bound, nested, scopes, events, checks)
                .ByteText(_) | .Empty -> {}
            }
        }
        .TupleLit(fields, _, _, _) -> {
            loop field in fields -> sema_ownership_collect_evaluated_expr_accesses(state, field.value, mode, bound, nested, scopes, events, checks)
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            loop arg in args {
                if arg == {
                    .Positional(value) -> sema_ownership_collect_evaluated_expr_accesses(state, value, mode, bound, nested, scopes, events, checks)
                    .Named(_, value) -> sema_ownership_collect_evaluated_expr_accesses(state, value, mode, bound, nested, scopes, events, checks)
                }
            }
        }
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Interp(value, _) -> sema_ownership_collect_evaluated_expr_accesses(state, value, mode, bound, nested, scopes, events, checks)
            }
        }
        .PatternTest(subject, pattern, _, _) -> {
            sema_ownership_collect_evaluated_expr_accesses(state, subject, mode, bound, nested, scopes, events, checks)
            sema_ownership_collect_evaluated_list(state, sema_ownership_pattern_value_exprs(pattern), mode, bound, nested, scopes, events, checks)
        }
        .OrFallback(value, fallback, _, _, _) -> {
            sema_ownership_collect_evaluated_expr_accesses(state, value, mode, bound, nested, scopes, events, checks)
            if fallback == {
                .Value(other) -> sema_ownership_collect_evaluated_expr_accesses(state, other, mode, bound, nested, scopes, events, checks)
                .Return(returned, _) -> if returned == .Val(other) -> sema_ownership_collect_evaluated_expr_accesses(state, other, mode, bound, nested, scopes, events, checks)
                .Panic(_, panic_args) -> {
                    loop arg in panic_args -> sema_ownership_collect_evaluated_expr_accesses(state, arg.expr, mode, bound, nested, scopes, events, checks)
                }
                .Block(_, _, _) | .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
            }
        }
        .If(condition, then_body, then_value, else_body, else_value, _, _) -> {
            sema_ownership_collect_evaluated_expr_accesses(state, condition, mode, bound, nested, scopes, events, checks)
            then_bound := bound.copy()
            if condition == .PatternTest(_, pattern, _, _) -> sema_ownership_bind_pattern_names(pattern, then_bound)
            sema_ownership_collect_evaluated_stmt_accesses(state, then_body, mode, then_bound, nested, scopes, events, checks)
            sema_ownership_collect_evaluated_expr_accesses(state, then_value, mode, then_bound, nested, scopes, events, checks)
            else_bound := bound.copy()
            sema_ownership_collect_evaluated_stmt_accesses(state, else_body, mode, else_bound, nested, scopes, events, checks)
            sema_ownership_collect_evaluated_expr_accesses(state, else_value, mode, else_bound, nested, scopes, events, checks)
        }
        .PtrFromAddr(_, _, _, addr, _, _) -> sema_ownership_collect_evaluated_expr_accesses(state, addr, mode, bound, nested, scopes, events, checks)
        // Each step's hidden name is bound before the step runs.
        .Pipe(head, steps, _, _) -> {
            sema_ownership_collect_evaluated_expr_accesses(state, head, mode, bound, nested, scopes, events, checks)
            step_bound := bound.copy()
            loop step in steps {
                step_bound.push(step.name)
                sema_ownership_collect_evaluated_expr_accesses(state, step.value, mode, step_bound, nested, scopes, events, checks)
            }
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .Ident(_, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}

// Rust `Pattern::for_each_value_expr`: the values a pattern compares against
// or looks up with, in source order.
sema_ownership_pattern_value_exprs: fn(pattern: Pattern) -> [Expr] Never! {
    values := [Expr]{}
    sema_ownership_collect_pattern_values(pattern, values)
    values
}

sema_ownership_collect_pattern_values: fn(pattern: Pattern, values: &[Expr]) Never! {
    if pattern == {
        .Variant(_, bindings, _, _) -> loop slot in bindings -> sema_ownership_collect_slot_values(slot, values)
        .Present(_, _, inner, _) | .Ok(_, _, inner, _) | .Err(_, _, inner, _) -> if inner == .Val(nested) -> sema_ownership_collect_pattern_values(nested, values)
        .Or(alternatives, _) -> loop alternative in alternatives -> sema_ownership_collect_pattern_values(alternative, values)
        .Struct(fields, _, _, _) -> {
            loop field in fields {
                if field == {
                    // copy: `value` is a payload of read parameter `pattern`; the value list owns this one
                    .Value(_, _, value) -> values.push(value.copy())
                    .Nested(_, _, nested) -> sema_ownership_collect_pattern_values(nested, values)
                    .Bind(_, _, _, _) -> {}
                }
            }
        }
        .List(items, _, _) -> loop slot in items -> sema_ownership_collect_slot_values(slot, values)
        .Map(entries, _, _) -> {
            loop entry in entries {
                // copy: `key` is a payload of read parameter `pattern`; the value list owns this one
                values.push(entry.key.copy())
                sema_ownership_collect_slot_values(entry.slot, values)
            }
        }
        .Absent(_) | .Range(_, _, _) | .StrMatch(_, _) | .BinMatch(_, _) -> {}
    }
}

sema_ownership_collect_slot_values: fn(slot: PatSlot, values: &[Expr]) Never! {
    if slot == {
        // copy: `value` is a payload of read parameter `slot`; the value list owns this one
        .Value(value) -> values.push(value.copy())
        .Nested(pattern) -> sema_ownership_collect_pattern_values(pattern, values)
        .Named(_, _, inner) -> sema_ownership_collect_slot_values(inner, values)
        .Wildcard | .Bind(_, _) | .Range(_, _) | .Rest(_) -> {}
    }
}

// Rust `bind_pattern_names`: the names a matched pattern introduces.
sema_ownership_bind_pattern_names: fn(pattern: Pattern, bound: &[String]) Never! {
    if pattern == {
        .Present(binding, _, inner, _) | .Ok(binding, _, inner, _) | .Err(binding, _, inner, _) -> {
            if inner == .Val(nested) {
                sema_ownership_bind_pattern_names(nested, bound)
            } else {
                bound.push(binding.copy())
            }
        }
        .Variant(_, bindings, _, _) -> loop slot in bindings -> sema_ownership_bind_slot_names(slot, bound)
        .Struct(fields, _, _, _) -> {
            loop field in fields {
                if field == {
                    .Bind(_, _, local, _) -> bound.push(local.copy())
                    .Nested(_, _, nested) -> sema_ownership_bind_pattern_names(nested, bound)
                    .Value(_, _, _) -> {}
                }
            }
        }
        .List(_, _, _) | .Map(_, _, _) -> {
            loop name in pattern_binding_names(pattern) -> bound.push(if name.rename == .Val(rename) -> rename.name else -> name.name)
        }
        .Or(alternatives, _) -> if alternatives.len() > 0 -> sema_ownership_bind_pattern_names(alternatives[0], bound)
        .StrMatch(parts, _) -> {
            loop part in parts {
                if part == .Hole(name, _, _) -> bound.push(name.copy())
            }
        }
        .BinMatch(parts, _) -> {
            loop part in parts {
                if part == .Hole(name, _, _) -> bound.push(name.copy())
            }
        }
        .Absent(_) | .Range(_, _, _) -> {}
    }
}

sema_ownership_bind_slot_names: fn(slot: PatSlot, bound: &[String]) Never! {
    if slot == {
        .Bind(name, _) -> bound.push(name.copy())
        .Nested(pattern) -> sema_ownership_bind_pattern_names(pattern, bound)
        .Named(_, _, inner) -> sema_ownership_bind_slot_names(inner, bound)
        .Wildcard | .Range(_, _) | .Rest(_) | .Value(_) -> {}
    }
}

sema_ownership_collect_evaluated_stmt_accesses: fn(state: &SemaOwnershipState, body: [Stmt], mode: SemaOwnershipAccessWalk, bound: &[String], nested: Bool, scopes: SemaScopeTable, events: &[SemaOwnershipEvaluatedAccess], checks: &[SemaOwnershipNestedCheck]) {
    loop statement in body {
        if statement == {
            .Expr(value) | .Yield(value, _) | .DeferClose(value, _) | .BreakValue(value, _) | .BreakLabelValue(_, _, value, _) -> sema_ownership_collect_evaluated_expr_accesses(state, value, mode, bound, nested, scopes, events, checks)
            .Val(binding) -> {
                sema_ownership_collect_evaluated_expr_accesses(state, binding.init, mode, bound, nested, scopes, events, checks)
                if binding.pattern == .Val(pattern) {
                    loop name in sema_stmt_destructure_names(pattern) -> bound.push(if name.rename == .Val(rename) -> rename.name else -> name.name)
                } else {
                    bound.push(binding.name)
                }
            }
            .Assign(target, _, _, value) -> {
                sema_ownership_collect_lvalue_access(state, target, bound, nested, scopes, events, checks)
                sema_ownership_collect_evaluated_expr_accesses(state, value, mode, bound, nested, scopes, events, checks)
            }
            .Return(value, _) -> if value == .Val(returned) -> sema_ownership_collect_evaluated_expr_accesses(state, returned, mode, bound, nested, scopes, events, checks)
            .While(condition, loop_body, _, _, _) -> {
                sema_ownership_collect_evaluated_expr_accesses(state, condition, mode, bound, nested, scopes, events, checks)
                body_bound := bound.copy()
                sema_ownership_collect_evaluated_stmt_accesses(state, loop_body, mode, body_bound, nested, scopes, events, checks)
            }
            .For(var, _, var2, kind, loop_body, _, _, _, _) -> {
                if kind == {
                    .Range(start, end, step, _) -> {
                        sema_ownership_collect_evaluated_expr_accesses(state, start, mode, bound, nested, scopes, events, checks)
                        sema_ownership_collect_evaluated_expr_accesses(state, end, mode, bound, nested, scopes, events, checks)
                        if step == .Val(step_expr) -> sema_ownership_collect_evaluated_expr_accesses(state, step_expr, mode, bound, nested, scopes, events, checks)
                    }
                    .In(collection, step) -> {
                        sema_ownership_collect_evaluated_expr_accesses(state, collection, mode, bound, nested, scopes, events, checks)
                        if step == .Val(step_expr) -> sema_ownership_collect_evaluated_expr_accesses(state, step_expr, mode, bound, nested, scopes, events, checks)
                    }
                }
                body_bound := bound.copy()
                body_bound.push(var.copy())
                if var2 == .Val(second) -> body_bound.push(second.name)
                sema_ownership_collect_evaluated_stmt_accesses(state, loop_body, mode, body_bound, nested, scopes, events, checks)
            }
            .Switch(subject, arms, else_body, _) -> {
                sema_ownership_collect_evaluated_expr_accesses(state, subject, mode, bound, nested, scopes, events, checks)
                switch_bound := bound.copy()
                switch_bound.push("it")
                loop arm in arms {
                    sema_ownership_collect_evaluated_expr_accesses(state, arm.cond, mode, switch_bound, nested, scopes, events, checks)
                    arm_bound := switch_bound.copy()
                    if arm.cond == .PatternTest(_, pattern, _, _) -> sema_ownership_bind_pattern_names(pattern, arm_bound)
                    sema_ownership_collect_evaluated_stmt_accesses(state, arm.body, mode, arm_bound, nested, scopes, events, checks)
                }
                if else_body == .Val(otherwise) {
                    else_bound := bound.copy()
                    sema_ownership_collect_evaluated_stmt_accesses(state, otherwise, mode, else_bound, nested, scopes, events, checks)
                }
            }
            .CountedLoop(init, condition, step, loop_body, _, _, _) -> {
                sema_ownership_collect_evaluated_expr_accesses(state, init.init, mode, bound, nested, scopes, events, checks)
                loop_bound := bound.copy()
                loop_bound.push(init.name)
                sema_ownership_collect_evaluated_expr_accesses(state, condition, mode, loop_bound, nested, scopes, events, checks)
                sema_ownership_collect_evaluated_stmt_accesses(state, loop_body, mode, loop_bound, nested, scopes, events, checks)
                // copy: `step_stmt` is a payload of the read statement list; the one-statement list owns this one
                if step == .Val(step_stmt) -> sema_ownership_collect_evaluated_stmt_accesses(state, [Stmt]{step_stmt.copy()}, mode, loop_bound, nested, scopes, events, checks)
            }
            // An `#Off` or `#Off(.Release)` body never reaches the release runtime.
            .Switched(marker, switched_body, _) -> {
                if !sema_authority_switched_erased(marker.name) {
                    body_bound := bound.copy()
                    sema_ownership_collect_evaluated_stmt_accesses(state, switched_body, mode, body_bound, nested, scopes, events, checks)
                }
            }
            .Loop(inner, _, _, _) | .Unsafe(_, _, inner, _) | .Impure(_, _, inner, _) | .Shield(inner, _) | .Defer(inner, _) | .Region(_, _, inner, _) | .Policy(_, inner, _) | .TaskGroup(_, _, _, inner, _) | .Layout(_, _, inner, _) | .AuthorityScope(_, _, _, inner, _) | .Transact(_, _, inner, _, _) | .AssumeDet(_, _, inner, _) | .Live(inner, _) -> {
                body_bound := bound.copy()
                sema_ownership_collect_evaluated_stmt_accesses(state, inner, mode, body_bound, nested, scopes, events, checks)
            }
            .Reactive(inner, _) -> {
                body_bound := bound.copy()
                captures := [SemaOwnershipEvaluatedAccess]{}
                sema_ownership_collect_evaluated_stmt_accesses(state, inner, SemaOwnershipAccessWalk.CaptureRequirements, body_bound, false, scopes, captures, checks)
                // Reactive registration clones every free capture: body writes
                // run later against the clones, so construction reads each
                // source root now.
                loop capture in captures {
                    root := sema_ownership_place_snapshot(capture.place)
                    root.projections = [String]{}
                    root.typed_projections = [SemaOwnershipProjection]{}
                    // copy: `capture` stays in the reactive body's own requirement list.
                    merged := SemaOwnershipEvaluatedAccess{place: sema_ownership_place_snapshot(root), capture_place: root, capture_ty: sema_ownership_walk_root_type(scopes, capture.site), capture_is_view: false, access: AccessConvention.Read, site: capture.site.copy(), through_call: false, moves_owner: false}
                    kept := [SemaOwnershipEvaluatedAccess]{}
                    loop existing in events {
                        if existing.place.root_key == merged.place.root_key {
                            if existing.access == AccessConvention.Write {
                                merged.access = AccessConvention.Write
                                // copy: the earlier access site stays with `existing`.
                                merged.site = existing.site.copy()
                            }
                            merged.through_call = merged.through_call || existing.through_call
                            merged.moves_owner = merged.moves_owner || existing.moves_owner
                        } else {
                            // copy: `existing` moves into the kept list rebuilt from `events`.
                            kept.push(existing.copy())
                        }
                    }
                    kept.push(merged)
                    loop events.len() > 0 -> _ := events.pop()
                    loop kept_event in kept -> events.push(kept_event)
                }
            }
            .ContextBlock(fields, inner, _) -> {
                loop field in fields -> sema_ownership_collect_evaluated_expr_accesses(state, field.value, mode, bound, nested, scopes, events, checks)
                body_bound := bound.copy()
                sema_ownership_collect_evaluated_stmt_accesses(state, inner, mode, body_bound, nested, scopes, events, checks)
            }
            .ScopeMember(_, _, member_args, _, inner, _, _, _) -> {
                sema_ownership_collect_evaluated_list(state, member_args, mode, bound, nested, scopes, events, checks)
                body_bound := bound.copy()
                sema_ownership_collect_evaluated_stmt_accesses(state, inner, mode, body_bound, nested, scopes, events, checks)
            }
            // Comptime forms erase before runtime evaluation.
            .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) -> {}
        }
    }
}

// Rust `collect_call_projection_accesses`: the index and range operands a
// projected place argument evaluates.
sema_ownership_collect_call_projection_accesses: fn(state: &SemaOwnershipState, expr: Expr, nested: Bool, scopes: SemaScopeTable, events: &[SemaOwnershipEvaluatedAccess], checks: &[SemaOwnershipNestedCheck]) {
    if expr == {
        .Index(base, index, _, _, _) -> {
            sema_ownership_collect_call_projection_accesses(state, base, nested, scopes, events, checks)
            sema_ownership_collect_evaluated_expr_accesses(state, index, SemaOwnershipAccessWalk.EvaluateNow, [String]{}, nested, scopes, events, checks)
        }
        .Slice(base, start, end, range, _, _) -> {
            sema_ownership_collect_call_projection_accesses(state, base, nested, scopes, events, checks)
            if range == .Val(range_expr) {
                sema_ownership_collect_evaluated_expr_accesses(state, range_expr, SemaOwnershipAccessWalk.EvaluateNow, [String]{}, nested, scopes, events, checks)
            } else {
                sema_ownership_collect_evaluated_expr_accesses(state, start, SemaOwnershipAccessWalk.EvaluateNow, [String]{}, nested, scopes, events, checks)
                sema_ownership_collect_evaluated_expr_accesses(state, end, SemaOwnershipAccessWalk.EvaluateNow, [String]{}, nested, scopes, events, checks)
            }
        }
        .Field(base, _, _, _) | .Place(base, _, _, _) | .Paren(base, _, _) | .Deref(base, _, _) -> sema_ownership_collect_call_projection_accesses(state, base, nested, scopes, events, checks)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}

sema_ownership_append_nested_events: fn(events: [SemaOwnershipEvaluatedAccess], checks: &[SemaOwnershipNestedCheck]) Never! {
    loop event in events -> checks.push(SemaOwnershipNestedCheck{place: sema_ownership_place_snapshot(event.place), access: event.access, reserved: false, holds: event.access == AccessConvention.Move || event.moves_owner, span: expr_span(event.site)})
}

sema_ownership_append_nested_checks: fn(found: [SemaOwnershipNestedCheck], checks: &[SemaOwnershipNestedCheck]) Never! {
    loop check in found -> checks.push(SemaOwnershipNestedCheck{place: sema_ownership_place_snapshot(check.place), access: check.access, reserved: check.reserved, holds: check.holds, span: check.span})
}

// Rust `check_call_argument_access` (evaluating now) or
// `check_call_argument_captures` (constructing) of one nested argument.
sema_ownership_nested_argument_checks: fn(state: &SemaOwnershipState, arg: CallArg, mode: SemaOwnershipAccessWalk, scopes: SemaScopeTable, checks: &[SemaOwnershipNestedCheck]) {
    transient := [SemaOwnershipEvaluatedAccess]{}
    inner := [SemaOwnershipNestedCheck]{}
    if mode == SemaOwnershipAccessWalk.EvaluateNow {
        places: sema_ownership_walk_places(state, arg.expr, scopes)
        if places.len() == 0 {
            sema_ownership_collect_evaluated_expr_accesses(state, arg.expr, mode, [String]{}, true, scopes, transient, inner)
            sema_ownership_append_nested_events(transient, checks)
            sema_ownership_append_nested_checks(inner, checks)
            return
        }
        sema_ownership_collect_call_projection_accesses(state, arg.expr, true, scopes, transient, inner)
        sema_ownership_append_nested_events(transient, checks)
        sema_ownership_append_nested_checks(inner, checks)
        access: if arg.convention == AccessConvention.Write -> AccessConvention.Write else -> AccessConvention.Read
        loop place in places -> checks.push(SemaOwnershipNestedCheck{place: sema_ownership_place_snapshot(place), access: access, reserved: false, holds: true, span: expr_span(arg.expr)})
        return
    }
    sema_ownership_collect_evaluated_expr_accesses(state, arg.expr, mode, [String]{}, true, scopes, transient, inner)
    sema_ownership_append_nested_checks(inner, checks)
    sema_ownership_append_nested_events(transient, checks)
}

// Rust `check_call_receiver_evaluation`, then the resolved receiver access
// (`record_call_receiver_access` / `_reservation`) at the method name.
sema_ownership_nested_receiver_checks: fn(state: &SemaOwnershipState, receiver: Expr, method_span: Span, mode: SemaOwnershipAccessWalk, scopes: SemaScopeTable, checks: &[SemaOwnershipNestedCheck]) {
    transient := [SemaOwnershipEvaluatedAccess]{}
    inner := [SemaOwnershipNestedCheck]{}
    if mode != SemaOwnershipAccessWalk.EvaluateNow {
        // Constructing captures: only calls inside the receiver build lambdas.
        sema_ownership_collect_evaluated_expr_accesses(state, receiver, mode, [String]{}, true, scopes, transient, inner)
        sema_ownership_append_nested_checks(inner, checks)
        return
    }
    unmarked := receiver
    if receiver == .Place(value, mark, _, _) {
        if mark != PlaceAccess.Read -> unmarked = value
    }
    places: sema_ownership_walk_places(state, unmarked, scopes)
    if places.len() == 0 {
        sema_ownership_collect_evaluated_expr_accesses(state, unmarked, mode, [String]{}, true, scopes, transient, inner)
        sema_ownership_append_nested_events(transient, checks)
        sema_ownership_append_nested_checks(inner, checks)
        return
    }
    sema_ownership_collect_call_projection_accesses(state, unmarked, true, scopes, transient, inner)
    sema_ownership_append_nested_events(transient, checks)
    sema_ownership_append_nested_checks(inner, checks)
    loop place in places -> checks.push(SemaOwnershipNestedCheck{place: sema_ownership_place_snapshot(place), access: AccessConvention.Read, reserved: false, holds: false, span: method_span})
    resolved: state.receiver_accesses.get(sema_ownership_span_key(expr_span(unmarked))) ?? return
    access: if resolved.reserved || resolved.convention == AccessConvention.Write -> AccessConvention.Write else -> AccessConvention.Read
    loop place in places -> checks.push(SemaOwnershipNestedCheck{place: sema_ownership_place_snapshot(place), access: access, reserved: resolved.reserved, holds: resolved.convention == AccessConvention.Move, span: method_span})
}

// Rust `infer_call_value`: the callee reads as a receiver, then its lambda
// captures are built.
sema_ownership_nested_called_value_checks: fn(state: &SemaOwnershipState, callee: Expr, mode: SemaOwnershipAccessWalk, scopes: SemaScopeTable, checks: &[SemaOwnershipNestedCheck]) {
    if mode == SemaOwnershipAccessWalk.EvaluateNow {
        sema_ownership_nested_receiver_value_check(state, callee, scopes, checks)
        return
    }
    transient := [SemaOwnershipEvaluatedAccess]{}
    inner := [SemaOwnershipNestedCheck]{}
    sema_ownership_collect_evaluated_expr_accesses(state, callee, mode, [String]{}, true, scopes, transient, inner)
    sema_ownership_append_nested_checks(inner, checks)
    sema_ownership_append_nested_events(transient, checks)
}

sema_ownership_nested_receiver_value_check: fn(state: &SemaOwnershipState, callee: Expr, scopes: SemaScopeTable, checks: &[SemaOwnershipNestedCheck]) {
    transient := [SemaOwnershipEvaluatedAccess]{}
    inner := [SemaOwnershipNestedCheck]{}
    places: sema_ownership_walk_places(state, callee, scopes)
    if places.len() == 0 {
        sema_ownership_collect_evaluated_expr_accesses(state, callee, SemaOwnershipAccessWalk.EvaluateNow, [String]{}, true, scopes, transient, inner)
    } else {
        sema_ownership_collect_call_projection_accesses(state, callee, true, scopes, transient, inner)
    }
    sema_ownership_append_nested_events(transient, checks)
    sema_ownership_append_nested_checks(inner, checks)
    loop place in places -> checks.push(SemaOwnershipNestedCheck{place: sema_ownership_place_snapshot(place), access: AccessConvention.Read, reserved: false, holds: false, span: expr_span(callee)})
}

sema_ownership_alias_reported: fn(diagnostics: [Diagnostic], known: Int, span: Span) -> Bool Never! {
    loop index in 0..<known {
        if diagnostics[index].code == "E0204" && diagnostics[index].span == .Val(reported) {
            if sema_ownership_span_same(reported, span) -> return true
        }
    }
    false
}

// A nested call's checks against this call's accesses. A conflict the nested
// call already reported at the same place is that one report.
sema_ownership_check_nested_accesses: fn(accesses: [SemaOwnershipCallAccess], checks: [SemaOwnershipNestedCheck], known: Int, diagnostics: &[Diagnostic]) -> Bool {
    accepted := true
    loop check in checks {
        active: sema_ownership_call_access_conflict(accesses, check.place, check.access, check.reserved, check.holds) ?? next
        if sema_ownership_alias_reported(diagnostics, known, check.span) -> next
        accepted = false
        diagnostics.push(sema_ownership_diag_alias(sema_ownership_place_name(check.place), active == AccessConvention.Write, check.span))
    }
    accepted
}

// Rust `check_call_argument_access` for what is evaluated before the
// argument's own place: a composite argument's accesses, or a projected
// place's index and range operands. Each ends with the evaluation.
sema_ownership_check_argument_evaluation: fn(state: &SemaOwnershipState, accesses: [SemaOwnershipCallAccess], arg: CallArg, is_place: Bool, scopes: SemaScopeTable, known: Int, diagnostics: &[Diagnostic]) -> Bool {
    events := [SemaOwnershipEvaluatedAccess]{}
    checks := [SemaOwnershipNestedCheck]{}
    if is_place {
        sema_ownership_collect_call_projection_accesses(state, arg.expr, true, scopes, events, checks)
    } else {
        sema_ownership_collect_evaluated_expr_accesses(state, arg.expr, SemaOwnershipAccessWalk.EvaluateNow, [String]{}, true, scopes, events, checks)
    }
    accepted := true
    loop event in events {
        active: sema_ownership_call_access_conflict(accesses, event.place, event.access, false, event.access == AccessConvention.Move || event.moves_owner) ?? next
        accepted = false
        diagnostics.push(sema_ownership_diag_alias(sema_ownership_place_name(event.place), active == AccessConvention.Write, expr_span(event.site)))
    }
    if !sema_ownership_check_nested_accesses(accesses, checks, known, diagnostics) -> accepted = false
    accepted
}

// Rust `check_call_argument_captures`: constructing the argument's lambdas
// evaluates their captures now. A capture a non-escaping FnMut closure (or
// a view) retains stays lent through the call; an owned move capture moves.
sema_ownership_check_argument_captures: fn(state: &SemaOwnershipState, accesses: &[SemaOwnershipCallAccess], arg: CallArg, scopes: SemaScopeTable, known: Int, diagnostics: &[Diagnostic]) -> Bool {
    events := [SemaOwnershipEvaluatedAccess]{}
    checks := [SemaOwnershipNestedCheck]{}
    sema_ownership_collect_evaluated_expr_accesses(state, arg.expr, SemaOwnershipAccessWalk.ConstructCaptures, [String]{}, true, scopes, events, checks)
    accepted := sema_ownership_check_nested_accesses(accesses, checks, known, diagnostics)
    loop event in events {
        // Every construction capture holds against a reserved `&` argument
        // (Rust `check_call_place_access`): even a cloned one reads the place
        // while the write is lent, as in a lambda nested in a struct field.
        if sema_ownership_call_access_conflict(accesses, event.place, event.access, false, true) == .Val(active) {
            accepted = false
            diagnostics.push(sema_ownership_diag_alias(sema_ownership_place_name(event.place), active == AccessConvention.Write, sema_ownership_capture_site_span(event.site)))
        }
        if event.through_call {
            accesses.push(SemaOwnershipCallAccess{place: sema_ownership_place_snapshot(event.place), access: event.access, span: expr_span(event.site), reserved: false, retained: true})
        } else if event.moves_owner {
            sema_ownership_mark_capture_move(state, event.place, event.capture_ty, sema_ownership_capture_site_span(event.site))
        }
    }
    if !sema_ownership_record_call_result_views(state, accesses, arg.expr, diagnostics) -> accepted = false
    accepted
}

// Rust `mark_moved_place_exact(place, span, "a lambda that captures it")`.
// `ty` is the captured root's type.
sema_ownership_mark_capture_move: fn(state: &SemaOwnershipState, place: SemaOwnershipPlace, ty: Type?, span: Span) Never! {
    loop moved in state.moved {
        if sema_ownership_place_exact(moved.place, place) -> return
    }
    copied := false
    if ty == .Val(captured) -> copied = sema_ownership_type_cloneable(captured) == (Val(true))
    state.moved.push(SemaOwnershipMovedPlace{place: sema_ownership_place_snapshot(place), origin: SemaOwnershipMoveOrigin{span: span, consumer: "a lambda that captures it", share_ty: None, copies_each_pass: copied}})
}

// ────────────────────────────────────────────────────────────────────────────
// Source-order expression walk.  This intentionally handles every AST shape
// that can carry a name or an access marker; registry-dependent operations are
// visited but do not invent ownership facts.

sema_ownership_check_expr_list: fn(state: &SemaOwnershipState, values: [Expr], scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    loop value in values {
        if !sema_ownership_check_expression(state, value, scopes, diagnostics) -> valid = false
    }
    valid
}

sema_ownership_check_projected_read: fn(state: &SemaOwnershipState, expr: Expr, base: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    places := sema_ownership_places_from_expr_in_state(expr, scopes, state)
    if places.len() > 0 {
        valid := true
        loop place in places {
            if !sema_ownership_note_place_reference(state, expr, place, expr_span(expr), scopes, SemaOwnershipReferenceKind.Read) -> valid = false
        }
        if !sema_ownership_check_use(state, expr, scopes, diagnostics) -> valid = false
        return valid
    }
    sema_ownership_check_expression(state, base, scopes, diagnostics)
}

sema_ownership_check_nested_call_value: fn(state: &SemaOwnershipState, value: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if sema_ownership_places_from_expr_in_state(value, scopes, state).len() > 0 -> return true
    sema_ownership_check_expression(state, value, scopes, diagnostics)
}

// The values a window's place path reads besides its root: every range bound
// and element index on the way to the window.
sema_ownership_check_window_operands: fn(state: &SemaOwnershipState, place: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if place == {
        .Paren(value, _, _) -> sema_ownership_check_window_operands(state, value, scopes, diagnostics)
        .Field(base, _, _, _) -> sema_ownership_check_window_operands(state, base, scopes, diagnostics)
        .Index(base, index, _, _, _) -> {
            valid := sema_ownership_check_window_operands(state, base, scopes, diagnostics)
            if !sema_ownership_check_expression(state, index, scopes, diagnostics) -> valid = false
            valid
        }
        .Slice(base, start, end, range, _, _) -> {
            valid := sema_ownership_check_window_operands(state, base, scopes, diagnostics)
            if !sema_ownership_check_expression(state, start, scopes, diagnostics) -> valid = false
            if !sema_ownership_check_expression(state, end, scopes, diagnostics) -> valid = false
            if range != None && !sema_ownership_check_expression(state, range, scopes, diagnostics) -> valid = false
            valid
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> true
    }
}

sema_ownership_check_expression: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if expr == {
        // As the expression check notes it (sema_expression_ident): only a
        // local or a parameter is owned state. A type, module or constant
        // root (`Float.NAN`, `Dyn.Null` inside a consumed payload) has no
        // reference to note.
        .Ident(name, span, _) -> sema_ownership_check_ident_reference(state, name, span, scopes) && sema_ownership_check_use(state, expr, scopes, diagnostics)
        .Paren(value, _, _) -> sema_ownership_check_expression(state, value, scopes, diagnostics)
        .Copy(value, _, _) -> sema_ownership_check_expression(state, value, scopes, diagnostics)
        .Deref(value, _, _) -> sema_ownership_check_expression(state, value, scopes, diagnostics)
        .RawOf(value, _, _) -> sema_ownership_check_expression(state, value, scopes, diagnostics)
        .Tainted(value, _, _, _) -> sema_ownership_check_expression(state, value, scopes, diagnostics)
        .Present(value, _, _) -> sema_ownership_check_expression(state, value, scopes, diagnostics)
        .Ok(value, _, _) -> sema_ownership_check_expression(state, value, scopes, diagnostics)
        .Err(value, _, _) -> sema_ownership_check_expression(state, value, scopes, diagnostics)
        .Field(base, _, _, _) -> sema_ownership_check_projected_read(state, expr, base, scopes, diagnostics)
        .OptField(base, _, _, _, _, _) -> sema_ownership_check_projected_read(state, expr, base, scopes, diagnostics)
        .Index(base, index, _, _, _) -> {
            places := sema_ownership_places_from_expr_in_state(expr, scopes, state)
            valid := true
            if {
                places.len() > 0 -> {
                    loop place in places {
                        if !sema_ownership_note_place_reference(state, expr, place, expr_span(expr), scopes, SemaOwnershipReferenceKind.Read) -> valid = false
                    }
                    if !sema_ownership_check_use(state, expr, scopes, diagnostics) -> valid = false
                }
                !sema_ownership_check_expression(state, base, scopes, diagnostics) -> valid = false
            }
            if !sema_ownership_check_expression(state, index, scopes, diagnostics) -> valid = false
            valid
        }
        .Slice(base, start, end, range, _, _) -> {
            places := sema_ownership_places_from_expr_in_state(expr, scopes, state)
            valid := true
            if {
                places.len() > 0 -> {
                    loop place in places {
                        if !sema_ownership_note_place_reference(state, expr, place, expr_span(expr), scopes, SemaOwnershipReferenceKind.Read) -> valid = false
                    }
                    if !sema_ownership_check_use(state, expr, scopes, diagnostics) -> valid = false
                }
                !sema_ownership_check_expression(state, base, scopes, diagnostics) -> valid = false
            }
            if !sema_ownership_check_expression(state, start, scopes, diagnostics) -> valid = false
            if !sema_ownership_check_expression(state, end, scopes, diagnostics) -> valid = false
            if range != None && !sema_ownership_check_expression(state, range, scopes, diagnostics) -> valid = false
            valid
        }
        .Place(value, access, _, _) -> {
            // (#3714): a take mark on a bare place is an
            // exact move, which the expression check records; it opens no view.
            if access == PlaceAccess.Take || sema_ownership_places_from_expr_in_state(value, scopes, state).len() == 0 -> return sema_ownership_check_expression(state, value, scopes, diagnostics)
            // A write window's bounds and indexes are read before it opens:
            // `&data[0..<data.len()]` reads `data`, then lends it.
            if access == PlaceAccess.Write && !sema_ownership_check_window_operands(state, value, scopes, diagnostics) -> return false
            first_seq: state.next_seq
            opened: if access == PlaceAccess.Write -> sema_ownership_open_write_reference(state, value, expr_span(expr), scopes, diagnostics) else -> sema_ownership_open_reference_for_expr(state, value, AccessConvention.Read, expr_span(expr), scopes, diagnostics)
            loop index in 0..<state.loans.len() {
                if state.loans[index].seq >= first_seq -> state.loans[index].statement_window = true
            }
            opened
        }
        .ListLit(elements, _, _) -> sema_ownership_check_expr_list(state, elements, scopes, diagnostics)
        .MapLit(entries, _, _) -> {
            valid := true
            loop entry in entries {
                if !sema_ownership_check_expression(state, entry.key, scopes, diagnostics) -> valid = false
                if !sema_ownership_check_expression(state, entry.value, scopes, diagnostics) -> valid = false
            }
            valid
        }
        .Call(call, _) -> {
            valid := true
            loop arg in call.args {
                if !sema_ownership_check_nested_call_value(state, arg.expr, scopes, diagnostics) -> valid = false
            }
            valid
        }
        .CallValue(callee, args, _, _) -> {
            valid := sema_ownership_check_expression(state, callee, scopes, diagnostics)
            loop arg in args {
                if !sema_ownership_check_nested_call_value(state, arg.expr, scopes, diagnostics) -> valid = false
            }
            valid
        }
        .MethodCall(receiver, _, _, _, _, args, _) -> {
            valid := true
            receiver_places: sema_ownership_places_from_expr_in_state(receiver, scopes, state)
            // A receiver that names no binding (`String.from_bytes(..)`,
            // `Int.parse(..)`) is a type or module path, not a value read
            // (Rust ownership walks only value receivers).
            static_receiver := false
            if receiver == .Ident(receiver_name, receiver_span, _) {
                static_receiver = sema_scope_resolve_index_at(scopes, receiver_name, receiver_span) == None
            }
            if receiver_places.len() == 0 && !static_receiver {
                valid = sema_ownership_check_expression(state, receiver, scopes, diagnostics)
            }
            loop arg in args {
                if !sema_ownership_check_nested_call_value(state, arg.expr, scopes, diagnostics) -> valid = false
            }
            valid
        }
        .OptMethodCall(receiver, _, _, _, args, _, _) -> {
            valid := sema_ownership_check_expression(state, receiver, scopes, diagnostics)
            loop arg in args {
                if !sema_ownership_check_nested_call_value(state, arg.expr, scopes, diagnostics) -> valid = false
            }
            valid
        }
        .Unary(_, value, _, _) -> sema_ownership_check_expression(state, value, scopes, diagnostics)
        .Binary(_, left, right, _, _) -> {
            valid := sema_ownership_check_expression(state, left, scopes, diagnostics)
            if !sema_ownership_check_expression(state, right, scopes, diagnostics) -> valid = false
            valid
        }
        .CompareChain(operands, _, _, _, _) -> sema_ownership_check_expr_list(state, operands, scopes, diagnostics)
        .TupleLit(fields, _, _, _) -> {
            valid := true
            loop field in fields {
                if !sema_ownership_check_expression(state, field.value, scopes, diagnostics) -> valid = false
            }
            valid
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            valid := true
            loop field in fields {
                if !sema_ownership_check_expression(state, field.value, scopes, diagnostics) -> valid = false
            }
            valid
        }
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> {
                    valid := true
                    loop field in fields {
                        if !sema_ownership_check_expression(state, field.value, scopes, diagnostics) -> valid = false
                    }
                    valid
                }
                .Elements(elements) -> sema_ownership_check_expr_list(state, elements, scopes, diagnostics)
                .Entries(entries) -> {
                    valid := true
                    loop entry in entries {
                        if !sema_ownership_check_expression(state, entry.key, scopes, diagnostics) -> valid = false
                        if !sema_ownership_check_expression(state, entry.value, scopes, diagnostics) -> valid = false
                    }
                    valid
                }
                .Value(value) -> sema_ownership_check_expression(state, value, scopes, diagnostics)
                .ByteText(_) | .Empty -> true
            }
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            valid := true
            loop arg in args {
                if arg == {
                    .Positional(value) -> if !sema_ownership_check_expression(state, value, scopes, diagnostics) -> valid = false
                    .Named(_, value) -> if !sema_ownership_check_expression(state, value, scopes, diagnostics) -> valid = false
                }
            }
            valid
        }
        .If(condition, then_body, then_value, else_body, else_value, _, _) -> {
            valid := sema_ownership_check_expression(state, condition, scopes, diagnostics)
            // Each arm runs on the live state inside a fork and is rolled
            // back; the join is that of the arms' whole-state copies.
            fork: sema_ownership_fork(state)
            sema_ownership_enter_scope(state)
            if !sema_ownership_check_statements(state, then_body, scopes, diagnostics).complete -> valid = false
            if !sema_ownership_check_expression(state, then_value, scopes, diagnostics) -> valid = false
            sema_ownership_leave_scope(state)
            then_path: sema_ownership_fork_path(state, fork)
            sema_ownership_fork_rollback(state, fork)
            sema_ownership_enter_scope(state)
            if !sema_ownership_check_statements(state, else_body, scopes, diagnostics).complete -> valid = false
            if !sema_ownership_check_expression(state, else_value, scopes, diagnostics) -> valid = false
            sema_ownership_leave_scope(state)
            else_path: sema_ownership_fork_path(state, fork)
            sema_ownership_fork_rollback(state, fork)
            sema_ownership_fork_join_close(state, fork, then_path, else_path, true)
            valid
        }
        .OrFallback(value, fallback, _, _, _) -> {
            valid := sema_ownership_check_expression(state, value, scopes, diagnostics)
            fork: sema_ownership_fork(state)
            // A fallback route that leaves (`return`, `panic`, `break`,
            // `next`, or a block that always does) never reaches the join, so
            // its moves must not poison later uses.
            fallback_reaches_merge := false
            if fallback == {
                .Value(other) -> {
                    if !sema_ownership_check_expression(state, other, scopes, diagnostics) -> valid = false
                    fallback_reaches_merge = true
                }
                .Block(body, result, _) -> {
                    sema_ownership_enter_scope(state)
                    nested: sema_ownership_check_statements(state, body, scopes, diagnostics)
                    if !nested.complete -> valid = false
                    fallback_reaches_merge = nested.falls_through
                    if result == .Val(result_expr) {
                        if !sema_ownership_check_expression(state, result_expr, scopes, diagnostics) -> valid = false
                    }
                    sema_ownership_leave_scope(state)
                }
                .Return(other, _) -> {
                    if other == .Val(returned) {
                        if !sema_ownership_check_expression(state, returned, scopes, diagnostics) -> valid = false
                    }
                }
                .Panic(_, _) | .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
            }
            fallback_path: sema_ownership_fork_path(state, fork)
            sema_ownership_fork_rollback(state, fork)
            if fallback_reaches_merge {
                sema_ownership_fork_join_close(state, fork, sema_ownership_fork_base(fork), fallback_path, true)
            } else {
                sema_ownership_fork_close(state, fork)
                sema_ownership_merge_references(state, fallback_path.references)
            }
            valid
        }
        .PatternTest(subject, _, _, _) -> sema_ownership_check_expression(state, subject, scopes, diagnostics)
        .Try(value, _, _, context, _) -> {
            valid := sema_ownership_check_expression(state, value, scopes, diagnostics)
            if context != None && !sema_ownership_check_expression(state, context, scopes, diagnostics) -> valid = false
            valid
        }
        .Lambda(lambda, _) -> {
            // Lambda bodies execute later.  Check them on a fork, rolled back,
            // so a move in the body cannot accidentally consume an enclosing
            // local now; only the body's reference anchors are merged.
            fork: sema_ownership_fork(state)
            if lambda.body == {
                .Expr(value) -> {
                    _ := sema_ownership_check_expression(state, value, scopes, diagnostics)
                }
                .Block(body) -> {
                    _ := sema_ownership_check_statements(state, body, scopes, diagnostics)
                }
            }
            deferred: sema_ownership_fork_path(state, fork)
            sema_ownership_fork_rollback(state, fork)
            sema_ownership_fork_close(state, fork)
            taken: sema_ownership_check_take_captures(state, lambda, scopes, diagnostics)
            if !sema_ownership_check_escaping_write_captures(state, lambda, scopes, diagnostics) || !taken -> return false
            sema_ownership_merge_references(state, deferred.references)
            true
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .Range(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> true
    }
}

sema_ownership_check_ident_reference: fn(state: &SemaOwnershipState, name: String, span: Span, scopes: SemaScopeTable) -> Bool Never! {
    index: sema_scope_resolve_index(scopes, name) ?? return true
    kind: scopes.bindings[index].symbol.kind
    if kind != SymbolKind.Local && kind != SymbolKind.Parameter -> return true
    sema_ownership_note_reference(state, name, span, scopes, SemaOwnershipReferenceKind.Read)
}

// ────────────────────────────────────────────────────────────────────────────
// Branch and scope state

// Branch facts are joined per key, like Rust `FlowFacts::merge_paths` rows:
// `slots` maps a key to its bucket in `rows`, and each bucket lists the
// merged rows of that key in merge order.
sema_ownership_bucket_add: fn(slots: &NameRows, rows: &[[Int]], key: String, row: Int) Never! {
    if name_rows_get_text(slots, key) == .Val(slot) {
        rows[slot].push(row)
    } else {
        name_rows_set(slots, key, rows.len())
        rows.push([Int]{row})
    }
}

// Overlapping places share one root, so a candidate move is compared only
// with the merged moves of its root.
sema_ownership_moved_covered: fn(merged: [SemaOwnershipMovedPlace], slots: NameRows, rows: [[Int]], candidate: SemaOwnershipMovedPlace) -> Bool Never! {
    slot: name_rows_get_text(slots, candidate.place.root_key) ?? return false
    loop row in rows[slot] {
        if sema_ownership_places_overlap(merged[row].place, candidate.place) -> return true
    }
    false
}

// An exact loan shares its root with the loan it repeats.
sema_ownership_merge_loan: fn(merged: &[SemaOwnershipLoan], slots: &NameRows, rows: &[[Int]], loan: SemaOwnershipLoan) Never! {
    if name_rows_get_text(slots, loan.place.root_key) == .Val(slot) {
        loop row in rows[slot] {
            if sema_ownership_loan_same(loan, merged[row]) -> return
        }
    }
    sema_ownership_bucket_add(slots, rows, loan.place.root_key, merged.len())
    merged.push(loan.copy())
}

// A repeated view has the same carrier; merged views are all active.
sema_ownership_merge_view: fn(merged: &[SemaOwnershipViewFact], slots: &NameRows, rows: &[[Int]], fact: SemaOwnershipViewFact) Never! {
    if name_rows_get_text(slots, fact.carrier_key) == .Val(slot) {
        loop row in rows[slot] {
            if sema_ownership_view_same(fact, merged[row]) {
                if fact.invalidated && !merged[row].invalidated {
                    merged[row].invalidated = true
                    merged[row].invalidated_span = fact.invalidated_span
                    merged[row].invalidated_verb = fact.invalidated_verb
                }
                return
            }
        }
    }
    if fact.active {
        sema_ownership_bucket_add(slots, rows, fact.carrier_key, merged.len())
        merged.push(fact.copy())
    }
}

sema_ownership_loan_same: fn(left: SemaOwnershipLoan, right: SemaOwnershipLoan) -> Bool Never! {
    sema_ownership_place_exact(left.place, right.place) && left.access == right.access && sema_ownership_span_same(left.span, right.span) && left.carrier_fact_seq == right.carrier_fact_seq && left.carrier_key == right.carrier_key
}

sema_ownership_view_same: fn(left: SemaOwnershipViewFact, right: SemaOwnershipViewFact) -> Bool Never! {
    if !left.active || !right.active -> return false
    if left.carrier_key != right.carrier_key || left.access != right.access -> return false
    if !sema_ownership_span_same(left.carrier_span, right.carrier_span) -> return false
    if left.loan_seq != right.loan_seq || !sema_ownership_span_same(left.loan_span, right.loan_span) -> return false
    if left.reborrow_parent != right.reborrow_parent || left.lexical != right.lexical -> return false
    if !sema_ownership_place_exact(left.source, right.source) -> return false
    if left.output_path.len() != right.output_path.len() -> return false
    loop (index, segment) in left.output_path {
        if segment != right.output_path[index] -> return false
    }
    true
}

// ── Forks: branch arms checked in place ─────────────────────────────────────
// A branch checks each arm on the live state between `sema_ownership_fork`
// and `sema_ownership_fork_rollback`, which puts back exactly the state the
// fork saw: the rows after the fork's counts are dropped, the declaration
// edits on the undo trail are replayed newest first, and the small per-path
// facts are put back. `sema_ownership_fork_path` keeps what an arm added, and
// `sema_ownership_path_join` + `sema_ownership_fork_apply` are the join of
// whole-state copies (`sema_ownership_join_paths`) at the cost of what the
// arms added. While a fork is open an arm runs as on a whole-state copy,
// which starts with no receiver frames (sema_ownership_state_snapshot).
sema_ownership_fork: fn(state: &SemaOwnershipState) -> SemaOwnershipFork Never! {
    fork: sema_ownership_state_fork(state)
    state.forks += 1
    state.receiver_frames = [SemaReceiverMarkFrame]{}
    fork
}

// A fork the code after it keeps running on in place (a loop body): its
// receiver frames stay. It ends in a join or a rollback and its close.
sema_ownership_mark: fn(state: &SemaOwnershipState) -> SemaOwnershipFork Never! {
    fork: sema_ownership_state_fork(state)
    state.forks += 1
    fork
}

// The fork marks of a state, without opening a fork.
sema_ownership_state_fork: fn(state: SemaOwnershipState) -> SemaOwnershipFork Never! {
    SemaOwnershipFork{
        scope_depth: state.scope_depth,
        next_seq: state.next_seq,
        declarations: state.declarations.len(),
        references: state.references.len(),
        trail: state.trail.len(),
        dirty: state.dirty_rows.len(),
        dirty_clean: state.dirty_clean,
        single_use: state.single_use_rows.len(),
        moved: state.moved,
        loans: state.loans,
        views: state.views,
        uninit: state.uninit,
        share_found: state.share_found,
        receiver_frames: state.receiver_frames,
        freeze_sites: state.freeze_sites,
    }
}

// What `state` added since `fork`, and its small facts now.
sema_ownership_fork_path: fn(state: SemaOwnershipState, fork: SemaOwnershipFork) -> SemaOwnershipPath Never! {
    declarations := [SemaOwnershipBindingFact]{}
    loop row in fork.declarations..<state.declarations.len() -> declarations.push(state.declarations[row])
    references := [SemaOwnershipReference]{}
    loop row in fork.references..<state.references.len() -> references.push(state.references[row])
    frozen := sema_ownership_frozen_rows()
    if state.forks == 0 {
        loop fact in state.declarations -> sema_ownership_frozen_set(frozen, fact.key, name_rows_hash(fact.key), fact.frozen_site)
    } else {
        loop row in fork.trail..<state.trail.len() {
            key: state.declarations[state.trail[row].row].key
            hash: name_rows_hash(key)
            // A key the trail repeats has the same last-row site.
            if name_rows_get(frozen.keys, key, hash) != None -> next
            sema_ownership_frozen_set(frozen, key, hash, sema_ownership_frozen_for_key_hashed(state, key, hash))
        }
        loop fact in declarations -> sema_ownership_frozen_set(frozen, fact.key, name_rows_hash(fact.key), fact.frozen_site)
    }
    SemaOwnershipPath{
        scope_depth: state.scope_depth,
        next_seq: state.next_seq,
        declarations: declarations,
        references: references,
        moved: state.moved,
        loans: state.loans,
        views: state.views,
        uninit: state.uninit,
        share_found: state.share_found,
        frozen: frozen,
        freeze_sites: state.freeze_sites,
    }
}

// The path that adds nothing: the fork's own state.
sema_ownership_fork_base: fn(fork: SemaOwnershipFork) -> SemaOwnershipPath Never! {
    SemaOwnershipPath{
        scope_depth: fork.scope_depth,
        next_seq: fork.next_seq,
        declarations: [SemaOwnershipBindingFact]{},
        references: [SemaOwnershipReference]{},
        moved: fork.moved,
        loans: fork.loans,
        views: fork.views,
        uninit: fork.uninit,
        share_found: fork.share_found,
        frozen: sema_ownership_frozen_rows(),
        freeze_sites: fork.freeze_sites,
    }
}

sema_ownership_fork_rollback: fn(state: &SemaOwnershipState, fork: SemaOwnershipFork) Never! {
    loop state.trail.len() > fork.trail {
        undo: state.trail.pop() ?? break
        if undo.row >= fork.declarations -> next
        if undo.active && !state.declarations[undo.row].active {
            depth: state.declarations[undo.row].scope_depth
            sema_ownership_active_add(state, depth, undo.row)
        }
        state.declarations[undo.row].references = undo.references
        state.declarations[undo.row].writes = undo.writes
        state.declarations[undo.row].active = undo.active
        state.declarations[undo.row].single_use = undo.single_use
        state.declarations[undo.row].frozen_site = undo.frozen_site
    }
    sema_ownership_truncate_declarations(state, fork.declarations)
    sema_ownership_truncate_references(state, fork.references)
    loop state.single_use_rows.len() > fork.single_use -> _ := state.single_use_rows.pop()
    loop state.dirty_rows.len() > fork.dirty -> _ := state.dirty_rows.pop()
    state.dirty_clean = fork.dirty_clean
    state.scope_depth = fork.scope_depth
    state.next_seq = fork.next_seq
    state.moved = fork.moved
    state.loans = fork.loans
    state.views = fork.views
    state.uninit = fork.uninit
    state.share_found = fork.share_found
    state.freeze_sites = fork.freeze_sites
    state.receiver_frames = [SemaReceiverMarkFrame]{}
}

// Ends a fork whose arms are rolled back (and joined).
sema_ownership_fork_close: fn(state: &SemaOwnershipState, fork: SemaOwnershipFork) Never! {
    state.forks -= 1
    state.receiver_frames = fork.receiver_frames
    if state.forks == 0 -> state.trail = [SemaOwnershipUndo]{}
}

// Ends a fork whose arms stop the check: the state before the fork, plus
// the share sites the arms found (sema_ownership_keep_share_found).
sema_ownership_fork_drop: fn(state: &SemaOwnershipState, fork: SemaOwnershipFork, first: [SemaOwnershipShareSite], second: [SemaOwnershipShareSite]) Never! {
    sema_ownership_fork_rollback(state, fork)
    sema_ownership_fork_close(state, fork)
    loop site in first -> sema_ownership_note_share_found(state, site)
    loop site in second -> sema_ownership_note_share_found(state, site)
}

// Joins two paths after rollback, applies their facts and closes the fork.
sema_ownership_fork_join_close: fn(state: &SemaOwnershipState, fork: SemaOwnershipFork, first: SemaOwnershipPath, second: SemaOwnershipPath, has_else: Bool) Never! {
    joined: sema_ownership_path_join(state, fork, first, second, has_else, state.share_found)
    sema_ownership_fork_apply(state, joined)
    sema_ownership_fork_close(state, fork)
}

// Appends a joined path to the state of its fork (after the rollback).
sema_ownership_fork_apply: fn(state: &SemaOwnershipState, path: SemaOwnershipPath) Never! {
    state.scope_depth = path.scope_depth
    state.next_seq = path.next_seq
    loop fact in path.declarations -> sema_ownership_push_declaration(state, fact.copy())
    loop reference in path.references -> sema_ownership_admit_reference(state, reference)
    state.moved = path.moved
    state.uninit = path.uninit
    state.share_found = path.share_found
    state.loans = path.loans
    state.views = path.views
    loop key_row in 0..<path.frozen.sites.len() {
        slot: name_rows_get(state.key_slots, path.frozen.keys.texts[key_row], path.frozen.keys.hashes[key_row]) ?? next
        row: state.key_facts[slot].last
        if row < 0 -> next
        sema_ownership_note_undo(state, row)
        state.declarations[row].frozen_site = path.frozen.sites[key_row]
    }
    state.freeze_sites = path.freeze_sites
    sema_ownership_recompute_reference_counts(state)
}

sema_ownership_share_found_add: fn(found: &[SemaOwnershipShareSite], site: SemaOwnershipShareSite) Never! {
    loop known in found {
        if sema_ownership_span_same(known.span, site.span) -> return
    }
    found.push(site.copy())
}

// A declaration of a path joins under a key neither the fork (the rows of
// `index` before `limit`) nor an earlier joined row has.
sema_ownership_join_declaration: fn(index: SemaOwnershipState, limit: Int, keys: &NameRows, joined: &[SemaOwnershipBindingFact], fact: SemaOwnershipBindingFact) Never! {
    hash: name_rows_hash(fact.key)
    if name_rows_get(index.key_slots, fact.key, hash) == .Val(slot) {
        first: index.key_facts[slot].first
        if first >= 0 && first < limit -> return
    }
    if name_rows_get(keys, fact.key, hash) != None -> return
    name_rows_set_hashed(keys, fact.key, hash, 0)
    joined.push(fact.copy())
}

// A reference of a path joins unless the fork (the rows of `index` before
// `limit`) or an earlier joined row has its anchor.
sema_ownership_join_reference: fn(index: SemaOwnershipState, limit: Int, anchors: &SemaOwnershipAnchors, joined: &[SemaOwnershipReference], reference: SemaOwnershipReference) Never! {
    if sema_ownership_anchor_held(index.references, index.anchors, limit, reference) -> return
    if sema_ownership_anchor_held(joined, anchors, joined.len(), reference) -> return
    sema_ownership_anchor_add(anchors, reference.use_span.start, joined.len())
    joined.push(reference.copy())
}

// The join of two paths of `fork` (Rust `FlowFacts::merge_paths`): what the
// whole-state join of the fork's state and the two path states adds to the
// fork's state. `index` holds the fork's rows before the fork's counts;
// `found` is the share-site list of the join target.
sema_ownership_path_join: fn(index: SemaOwnershipState, fork: SemaOwnershipFork, then_path: SemaOwnershipPath, else_path: SemaOwnershipPath, has_else: Bool, found: [SemaOwnershipShareSite]) -> SemaOwnershipPath Never! {
    next_seq := fork.next_seq
    if then_path.next_seq > next_seq -> next_seq = then_path.next_seq
    if else_path.next_seq > next_seq -> next_seq = else_path.next_seq
    declarations := [SemaOwnershipBindingFact]{}
    declaration_keys := name_rows()
    loop fact in then_path.declarations -> sema_ownership_join_declaration(index, fork.declarations, declaration_keys, declarations, fact)
    loop fact in else_path.declarations -> sema_ownership_join_declaration(index, fork.declarations, declaration_keys, declarations, fact)
    frozen := sema_ownership_frozen_rows()
    loop row in 0..<then_path.frozen.sites.len() -> sema_ownership_join_frozen(index, then_path, else_path, has_else, frozen, then_path.frozen.keys.texts[row], then_path.frozen.keys.hashes[row])
    loop row in 0..<else_path.frozen.sites.len() {
        key: else_path.frozen.keys.texts[row]
        hash: else_path.frozen.keys.hashes[row]
        if name_rows_get(frozen.keys, key, hash) != None -> next
        sema_ownership_join_frozen(index, then_path, else_path, has_else, frozen, key, hash)
    }
    freeze_sites := fork.freeze_sites.copy()
    loop site in then_path.freeze_sites {
        seen := false
        loop known in freeze_sites {
            if known.span == site.span -> seen = true
        }
        if !seen -> freeze_sites.push(site.copy())
    }
    loop site in else_path.freeze_sites {
        seen := false
        loop known in freeze_sites {
            if known.span == site.span -> seen = true
        }
        if !seen -> freeze_sites.push(site.copy())
    }

    merged_moves := [SemaOwnershipMovedPlace]{}
    move_slots := name_rows()
    move_rows := [[Int]]{}
    loop moved in then_path.moved {
        if !sema_ownership_moved_covered(merged_moves, move_slots, move_rows, moved) {
            sema_ownership_bucket_add(move_slots, move_rows, moved.place.root_key, merged_moves.len())
            merged_moves.push(moved.copy())
        }
    }
    loop moved in else_path.moved {
        if !sema_ownership_moved_covered(merged_moves, move_slots, move_rows, moved) {
            sema_ownership_bucket_add(move_slots, move_rows, moved.place.root_key, merged_moves.len())
            merged_moves.push(moved.copy())
        }
    }
    if !has_else {
        loop moved in fork.moved {
            if !sema_ownership_moved_covered(merged_moves, move_slots, move_rows, moved) {
                sema_ownership_bucket_add(move_slots, move_rows, moved.place.root_key, merged_moves.len())
                merged_moves.push(sema_ownership_moved_snapshot(moved))
            }
        }
    }
    // A share site found on either path is found.
    share_found := found
    loop site in then_path.share_found -> sema_ownership_share_found_add(share_found, site)
    loop site in else_path.share_found -> sema_ownership_share_found_add(share_found, site)

    // Loans and views are hazards after a branch whenever any executable
    // path carries them.  Keep pre-merge hazards and union both branch facts;
    // lexical scope cleanup has already removed facts whose owners ended.
    merged_loans := fork.loans
    loan_slots := name_rows()
    loan_rows := [[Int]]{}
    loop (row, loan) in merged_loans -> sema_ownership_bucket_add(loan_slots, loan_rows, loan.place.root_key, row)
    loop loan in then_path.loans -> sema_ownership_merge_loan(merged_loans, loan_slots, loan_rows, loan)
    loop loan in else_path.loans -> sema_ownership_merge_loan(merged_loans, loan_slots, loan_rows, loan)

    merged_views := [SemaOwnershipViewFact]{}
    view_slots := name_rows()
    view_rows := [[Int]]{}
    loop view in fork.views {
        if view.active {
            sema_ownership_bucket_add(view_slots, view_rows, view.carrier_key, merged_views.len())
            merged_views.push(sema_ownership_view_snapshot(view))
        }
    }
    loop fact in then_path.views -> sema_ownership_merge_view(merged_views, view_slots, view_rows, fact)
    loop fact in else_path.views -> sema_ownership_merge_view(merged_views, view_slots, view_rows, fact)

    references := [SemaOwnershipReference]{}
    anchors := SemaOwnershipAnchors{slots: [Int:Int]{}, rows: [[Int]]{}}
    loop reference in then_path.references -> sema_ownership_join_reference(index, fork.references, anchors, references, reference)
    loop reference in else_path.references -> sema_ownership_join_reference(index, fork.references, anchors, references, reference)
    SemaOwnershipPath{
        scope_depth: fork.scope_depth,
        next_seq: next_seq,
        declarations: declarations,
        references: references,
        moved: merged_moves,
        loans: merged_loans,
        views: merged_views,
        // A binding unwritten on either path stays unwritten.
        uninit: sema_ownership_uninit_join(then_path.uninit, else_path.uninit),
        share_found: share_found,
        frozen: frozen,
        freeze_sites: freeze_sites,
    }
}

// The freeze site of `key` (whose name_rows_hash is `hash`) at the end of
// `path`: the path's own row, else the last declaration row in `state`.
sema_ownership_path_frozen: fn(state: SemaOwnershipState, path: SemaOwnershipPath, key: String, hash: Int) -> SemaOwnershipFreezeSite? Never! {
    if name_rows_get(path.frozen.keys, key, hash) == .Val(row) -> return path.frozen.sites[row]
    sema_ownership_frozen_for_key_hashed(state, key, hash)
}

// Joins the freeze site of `key` into `frozen`: a binding stays frozen only
// where both paths keep a site.
sema_ownership_join_frozen: fn(index: SemaOwnershipState, then_path: SemaOwnershipPath, else_path: SemaOwnershipPath, has_else: Bool, frozen: &SemaOwnershipFrozenRows, key: String, hash: Int) Never! {
    left: sema_ownership_path_frozen(index, then_path, key, hash)
    right: if has_else -> sema_ownership_path_frozen(index, else_path, key, hash) else -> sema_ownership_frozen_for_key_hashed(index, key, hash)
    site := SemaOwnershipFreezeSite?{None}
    if left != None && right != None -> site = left
    sema_ownership_frozen_set(frozen, key, hash, site)
}

// The join of whole-state copies: `state` becomes `before` plus the join of
// the two path states, which extend `before`. Its receiver frames, share
// sites known, and function facts stay its own.
sema_ownership_join_paths: fn(state: &SemaOwnershipState, before: SemaOwnershipState, then_state: SemaOwnershipState, else_state: SemaOwnershipState, has_else: Bool) Never! {
    fork: sema_ownership_state_fork(before)
    joined: sema_ownership_path_join(before, fork, sema_ownership_fork_path(then_state, fork), sema_ownership_fork_path(else_state, fork), has_else, state.share_found)
    sema_ownership_state_restore_path(state, before)
    sema_ownership_fork_apply(state, joined)
    loop (key, _) in then_state.used_keys -> state.used_keys[key] = true
    loop (key, _) in else_state.used_keys -> state.used_keys[key] = true
}

// This rule branch merge (Rust `UninitState::merge_paths`): a binding left
// unwritten by either path stays unwritten, and a fixed-list slot counts as
// written only where every path wrote it.
sema_ownership_uninit_join: fn(left: [SemaOwnershipUninitFact], right: [SemaOwnershipUninitFact]) -> [SemaOwnershipUninitFact] Never! {
    // copy: the join is the left facts themselves when the right adds none.
    if right.len() == 0 -> return left.copy()
    right_slots := name_rows()
    right_rows := [[Int]]{}
    loop (row, other) in right -> sema_ownership_bucket_add(right_slots, right_rows, other.key, row)
    merged := [SemaOwnershipUninitFact]{}
    merged_keys := name_rows()
    loop fact in left {
        joined := fact
        if name_rows_get_text(right_slots, joined.key) == .Val(key_slot) {
            loop row in right_rows[key_slot] {
                if joined.fixed_len == right[row].fixed_len {
                    kept := [Int]{}
                    loop slot in joined.initialized {
                        if right[row].initialized.contains(slot) -> kept.push(slot)
                    }
                    joined.initialized = kept
                } else {
                    joined.fixed_len = None
                    joined.initialized = [Int]{}
                }
            }
        }
        name_rows_set(merged_keys, joined.key, 0)
        merged.push(joined)
    }
    loop fact in right {
        if name_rows_get_text(merged_keys, fact.key) != None -> next
        name_rows_set(merged_keys, fact.key, 0)
        merged.push(fact.copy())
    }
    merged
}

sema_ownership_uninit_contains: fn(facts: [SemaOwnershipUninitFact], key: String) -> Bool Never! {
    loop fact in facts {
        if fact.key == key -> return true
    }
    false
}

// Removes and returns the not-yet-written fact for the binding `key`; the
// other facts stay in place.
sema_ownership_uninit_take: fn(state: &SemaOwnershipState, key: String) -> SemaOwnershipUninitFact? {
    taken := SemaOwnershipUninitFact?{None}
    index := state.uninit.len()
    loop index > 0 {
        index -= 1
        if state.uninit[index].key != key -> next
        removed := state.uninit.remove(index, .Slot)
        if taken == None -> taken = removed
    }
    taken
}

sema_ownership_uninit_set: fn(state: &SemaOwnershipState, fact: SemaOwnershipUninitFact) Never! {
    _ := sema_ownership_uninit_take(state, fact.key)
    state.uninit.push(fact.copy())
}

sema_ownership_loop_path_to_depth: fn(path: SemaOwnershipState, target_depth: Int) -> SemaOwnershipState Never! {
    normalized := sema_ownership_state_snapshot(path)
    loop normalized.scope_depth > target_depth -> sema_ownership_leave_scope(normalized)
    normalized
}

// Rust `check_loop_move_backedge`: only a path that reaches the loop's back
// edge (the end of a body that falls through, or a `next`) can repeat a move.
// A move this pass of the body made of a binding declared outside the loop
// (at or below `frame.scope_depth`), still standing here and not already
// standing at loop entry, gives the value away again on the next iteration:
// E0121 at the move, labelled as the earlier iteration's, or E0209 for an
// unmarked take argument. Reinitializing the place in the body clears the
// move before this point. A move that may become a share (an unmarked move of
// a whole binding, an unmarked take argument) is reported once and dropped,
// as a later use would; the next pass checks that site as the copy.
sema_ownership_check_loop_move_backedge: fn(state: &SemaOwnershipState, frame: SemaLoopValueFrame, diagnostics: &[Diagnostic]) Never! {
    // Rows that do not repeat stay in place; a repeated row leaves unless it
    // stays standing too. Walked from the back, so the reports reverse after.
    repeated := [SemaOwnershipMovedPlace]{}
    index := state.moved.len()
    loop index > 0 {
        index -= 1
        if !sema_ownership_loop_move_repeats(state, frame, state.moved[index]) -> next
        if state.moved[index].origin.share_ty == None && state.moved[index].origin.implicit_take == None {
            repeated.push(state.moved[index].copy())
        } else {
            repeated.push(state.moved.remove(index, .Slot) ?? panic("a repeated move left the ownership state"))
        }
    }
    repeated.reverse()
    loop moved in repeated {
        if !sema_ownership_moved_reported(diagnostics, moved.origin.span) -> sema_ownership_report_moved(state, moved, moved.place, moved.origin.span, diagnostics)
    }
}

sema_ownership_loop_move_repeats: fn(state: SemaOwnershipState, frame: SemaLoopValueFrame, moved: SemaOwnershipMovedPlace) -> Bool Never! {
    // A pass that copies the value moves nothing the next pass reads.
    if moved.origin.copies_each_pass -> return false
    loop before in frame.moved_before {
        if before.place.root_key == moved.place.root_key && sema_ownership_place_name(before.place) == sema_ownership_place_name(moved.place) && sema_ownership_span_same(before.origin.span, moved.origin.span) -> return false
    }
    row: sema_ownership_last_row(state, moved.place.root_key)
    if row < 0 -> return false
    state.declarations[row].scope_depth <= frame.scope_depth
}

// An E0121 or E0209 already reported at this move site.
sema_ownership_moved_reported: fn(diagnostics: [Diagnostic], site: Span) -> Bool Never! {
    loop existing in diagnostics {
        if existing.code != "E0121" && existing.code != "E0209" -> next
        if existing.span == .Val(known) {
            if sema_ownership_span_same(known, site) -> return true
        }
    }
    false
}

// The join after a loop (Rust `FlowFacts::after_loop_value`). `fork` is the
// mark the loop opened before its body (sema_ownership_mark); the body ran in
// place, so `state` is the state after it. The join base is the fork state,
// or with `outer` that state after leaving one more scope (a counted loop's
// own scope). Paths: the base when the body may be skipped, the state after
// the body when it falls through, and every recorded break, each left down
// to the base depth.
sema_ownership_join_loop_value_paths: fn(state: &SemaOwnershipState, context: SemaCheckContext, frame_index: Int, fork: SemaOwnershipFork, outer: Bool, body_falls_through: Bool, may_skip: Bool) -> Bool Never! {
    target_depth: if outer -> fork.scope_depth - 1 else -> fork.scope_depth
    found: state.share_found.copy()
    after_body := SemaOwnershipPath?{None}
    if may_skip && body_falls_through {
        normalize: sema_ownership_mark(state)
        loop state.scope_depth > target_depth -> sema_ownership_leave_scope(state)
        after_body = Val(sema_ownership_fork_path(state, fork))
        sema_ownership_fork_rollback(state, normalize)
        sema_ownership_fork_close(state, normalize)
    }
    sema_ownership_fork_rollback(state, fork)
    if outer -> sema_ownership_leave_scope(state)
    base: sema_ownership_state_fork(state)
    paths := [SemaOwnershipPath]{}
    if may_skip -> paths.push(sema_ownership_fork_base(base))
    if after_body == .Val(path) -> paths.push(path)
    loop exit in sema_loop_value_break_flows(context, frame_index) -> paths.push(sema_ownership_fork_path(sema_ownership_loop_path_to_depth(exit, target_depth), fork))
    joined := sema_ownership_fork_base(base)
    if paths.len() == 0 {
        joined = sema_ownership_path_join(state, base, joined, joined, false, found)
    } else {
        joined = paths[0]
        index := 1
        loop index < paths.len() {
            joined = sema_ownership_path_join(state, base, joined, paths[index], true, joined.share_found)
            index += 1
        }
        joined = sema_ownership_path_join(state, base, joined, joined, true, found)
    }
    sema_ownership_fork_apply(state, joined)
    sema_ownership_fork_close(state, fork)
    paths.len() > 0
}

// ────────────────────────────────────────────────────────────────────────────
// Statement walk used by the parent integration hook

sema_ownership_check_binding: fn(state: &SemaOwnershipState, binding: Binding, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if !sema_ownership_consume_expression(state, binding.init, scopes, "the binding `{binding.name}`", diagnostics) -> return false
    if sema_scope_resolve_index_at(scopes, binding.name, binding.name_span) == .Val(symbol_index) {
        symbol: scopes.bindings[symbol_index].symbol
        if sema_ownership_declaration_index(state, symbol.id.key) == None {
            sema_ownership_declare_binding(state, symbol, false)
        }
    }
    sema_ownership_record_binding_view(state, binding, scopes)
    true
}

sema_ownership_lvalue_expr: fn(target: LValue) -> Expr Never! {
    if target == {
        .Local(name, span) -> Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}
        // copy: `base` is a payload of read parameter `target`, which keeps the original; field `base` of the new Expr.Field owns this one
        .Field(base, field, span) -> Expr.Field{base: base.copy(), member: field, span: span, id: AST_NODE_GENERATED}
        // copy: `base`, `index` and `kind` are payloads of read parameter `target`, which keeps the originals; the new Expr.Index's fields own `base`, `index` and `kind`
        .Index(base, index, span, kind) -> Expr.Index{base: base.copy(), index: index.copy(), span: span, kind: kind.copy(), id: AST_NODE_GENERATED}
    }
}

sema_ownership_record_assignment_view: fn(state: &SemaOwnershipState, target: LValue, value: Expr, scopes: SemaScopeTable) -> Bool {
    target_expr: sema_ownership_lvalue_expr(target)
    output_path := [String]{}
    carrier_name: sema_ownership_named_view_root(target_expr, output_path) ?? return false
    carrier_key: sema_ownership_carrier_key(scopes, carrier_name, expr_span(target_expr)) ?? return false
    if target == {
        .Local(_, _) -> {}
        .Index(_, _, _, _) | .Field(_, _, _) -> return false
    }
    producer: sema_ownership_view_producer(value) ?? return false
    places := sema_ownership_places_from_expr_in_state(producer.source, scopes, state)
    if places.len() == 0 -> return false
    loop index in 0..<state.views.len() {
        if state.views[index].carrier_key == carrier_key && state.views[index].active {
            state.views[index].active = false
        }
    }
    valid := true
    loop place in places {
        loan_seq := sema_ownership_matching_loan_seq(state, place, producer.span)
        if !sema_ownership_record_view_fact_inner(state, carrier_name, expr_span(target_expr), place, output_path, producer.access, scopes, loan_seq) -> valid = false
    }
    valid
}

sema_ownership_check_assignment: fn(state: &SemaOwnershipState, target: LValue, value: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    valid := sema_ownership_check_expression(state, value, scopes, diagnostics)
    lvalue_ok: sema_ownership_check_lvalue_write(state, target, scopes, diagnostics)
    if {
        lvalue_ok -> {
            _ := sema_ownership_record_assignment_view(state, target, value, scopes)
        }
        else -> valid = false
    }
    if value == {
        .Ident(_, _, _) | .Paren(_, _, _) | .Present(_, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Tainted(_, _, _, _) -> {
            if !sema_ownership_mark_unmarked_move(state, value, scopes, "the assignment", diagnostics) -> valid = false
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    valid
}

sema_ownership_check_lvalue_write: fn(state: &SemaOwnershipState, target: LValue, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    sema_ownership_check_lvalue_write_as(state, target, true, scopes, diagnostics)
}

// `capability` false: the write edits a window's owner, so the target's
// root binding needs no write capability of its own.
sema_ownership_check_lvalue_write_as: fn(state: &SemaOwnershipState, target: LValue, capability: Bool, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if target == {
        .Local(name, span) -> sema_ownership_check_write_as(state, Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}, "be assigned", "", None, [SemaCallParam]{}, capability, scopes, diagnostics)
        // copy: `base` is a payload of read parameter `target`, which keeps the original; field `base` of the new Expr.Field owns this one
        .Field(base, field, span) -> sema_ownership_check_write_as(state, Expr.Field{base: base.copy(), member: field, span: span, id: AST_NODE_GENERATED}, "be assigned", "", None, [SemaCallParam]{}, capability, scopes, diagnostics)
        .Index(base, index, span, kind) -> {
            if !sema_ownership_check_expression(state, index, scopes, diagnostics) -> return false
            sema_ownership_check_write_as(state, Expr.Index{base: base, index: index, span: span, kind: kind, id: AST_NODE_GENERATED}, "be assigned", "", None, [SemaCallParam]{}, capability, scopes, diagnostics)
        }
    }
}

sema_ownership_check_scoped_body: fn(state: &SemaOwnershipState, body: [Stmt], scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaOwnershipFlowResult {
    sema_ownership_enter_scope(state)
    nested: sema_ownership_check_statements(state, body, scopes, diagnostics)
    sema_ownership_leave_scope(state)
    nested
}

sema_ownership_check_statement: fn(state: &SemaOwnershipState, statement: Stmt, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaOwnershipFlowResult {
    if statement == {
        .Expr(expr) -> SemaOwnershipFlowResult{complete: sema_ownership_check_expression(state, expr, scopes, diagnostics), falls_through: true}
        .Val(binding) -> SemaOwnershipFlowResult{complete: sema_ownership_check_binding(state, binding, scopes, diagnostics), falls_through: true}
        .Assign(target, _, _, value) -> SemaOwnershipFlowResult{complete: sema_ownership_check_assignment(state, target, value, scopes, diagnostics), falls_through: true}
        .Return(value, _) -> {
            valid: if value == .Val(returned) -> sema_ownership_consume_expression(state, returned, scopes, "`return`", diagnostics) else -> true
            SemaOwnershipFlowResult{complete: valid, falls_through: false}
        }
        .BreakValue(value, _) | .BreakLabelValue(_, _, value, _) -> {
            valid: sema_ownership_consume_expression(state, value, scopes, "the loop `break`", diagnostics)
            SemaOwnershipFlowResult{complete: valid, falls_through: false}
        }
        .Break(_) | .BreakLabel(_, _) | .Continue(_) | .ContinueLabel(_, _) -> SemaOwnershipFlowResult{complete: true, falls_through: false}
        .Yield(value, _) -> {
            valid: sema_ownership_consume_expression(state, value, scopes, "`yield`", diagnostics)
            SemaOwnershipFlowResult{complete: valid, falls_through: true}
        }
        .While(condition, body, _, _, _) -> {
            valid := sema_ownership_check_expression(state, condition, scopes, diagnostics)
            // The body runs on the live state inside a fork, rolled back and
            // joined with the path that skips it.
            fork: sema_ownership_fork(state)
            sema_ownership_enter_scope(state)
            nested: sema_ownership_check_statements(state, body, scopes, diagnostics)
            sema_ownership_leave_scope(state)
            body_path: sema_ownership_fork_path(state, fork)
            sema_ownership_fork_rollback(state, fork)
            sema_ownership_fork_join_close(state, fork, body_path, sema_ownership_fork_base(fork), false)
            if !nested.complete -> valid = false
            SemaOwnershipFlowResult{complete: valid, falls_through: true}
        }
        .Loop(body, _, _, _) -> {
            fork: sema_ownership_fork(state)
            sema_ownership_enter_scope(state)
            nested: sema_ownership_check_statements(state, body, scopes, diagnostics)
            sema_ownership_leave_scope(state)
            body_path: sema_ownership_fork_path(state, fork)
            sema_ownership_fork_rollback(state, fork)
            sema_ownership_fork_join_close(state, fork, body_path, sema_ownership_fork_base(fork), false)
            SemaOwnershipFlowResult{complete: nested.complete, falls_through: true}
        }
        .For(var, var_span, _, kind, body, _, _, _, _) -> {
            valid := true
            if kind == {
                .Range(start, end, step, _) -> {
                    if !sema_ownership_check_expression(state, start, scopes, diagnostics) -> valid = false
                    if !sema_ownership_check_expression(state, end, scopes, diagnostics) -> valid = false
                    if step != None && !sema_ownership_check_expression(state, step, scopes, diagnostics) -> valid = false
                }
                .In(collection, step) -> {
                    if !sema_ownership_check_expression(state, collection, scopes, diagnostics) -> valid = false
                    if step != None && !sema_ownership_check_expression(state, step, scopes, diagnostics) -> valid = false
                }
            }
            fork: sema_ownership_fork(state)
            sema_ownership_enter_scope(state)
            if sema_scope_resolve_index_at(scopes, var, var_span) == .Val(loop_binding_index) {
                loop_symbol: scopes.bindings[loop_binding_index].symbol
                if sema_ownership_declaration_index(state, loop_symbol.id.key) == None {
                    sema_ownership_declare_binding(state, loop_symbol, false)
                }
            }
            nested: sema_ownership_check_statements(state, body, scopes, diagnostics)
            sema_ownership_leave_scope(state)
            body_path: sema_ownership_fork_path(state, fork)
            sema_ownership_fork_rollback(state, fork)
            sema_ownership_fork_join_close(state, fork, body_path, sema_ownership_fork_base(fork), false)
            if !nested.complete -> valid = false
            SemaOwnershipFlowResult{complete: valid, falls_through: true}
        }
        .CountedLoop(init, condition, step, body, _, _, _) -> {
            valid := sema_ownership_check_binding(state, init, scopes, diagnostics)
            if !sema_ownership_check_expression(state, condition, scopes, diagnostics) -> valid = false
            if step == .Val(step_statement) {
                nested_step: sema_ownership_check_statement(state, step_statement, scopes, diagnostics)
                if !nested_step.complete -> valid = false
            }
            nested: sema_ownership_check_statements(state, body, scopes, diagnostics)
            if !nested.complete -> valid = false
            SemaOwnershipFlowResult{complete: valid, falls_through: true}
        }
        .Switch(subject, arms, else_body, _) -> {
            valid := sema_ownership_check_expression(state, subject, scopes, diagnostics)
            before: sema_ownership_state_snapshot(state)
            joined := sema_ownership_state_snapshot(before)
            loop arm in arms {
                arm_state := sema_ownership_state_snapshot(before)
                if !sema_ownership_check_expression(arm_state, arm.cond, scopes, diagnostics) -> valid = false
                nested: sema_ownership_check_statements(arm_state, arm.body, scopes, diagnostics)
                if !nested.complete -> valid = false
                sema_ownership_join_paths(joined, before, arm_state, before, false)
            }
            if else_body == .Val(else_statements) {
                else_state := sema_ownership_state_snapshot(before)
                nested: sema_ownership_check_statements(else_state, else_statements, scopes, diagnostics)
                if !nested.complete -> valid = false
                arms_state := sema_ownership_state_snapshot(joined)
                sema_ownership_join_paths(joined, before, arms_state, else_state, true)
            }
            state.moved = joined.moved
            state.loans = joined.loans
            SemaOwnershipFlowResult{complete: valid, falls_through: true}
        }
        .Unsafe(_, _, body, _) -> sema_ownership_check_scoped_body(state, body, scopes, diagnostics)
        .Impure(_, _, body, _) -> sema_ownership_check_scoped_body(state, body, scopes, diagnostics)
        .Reactive(body, _) -> sema_ownership_check_scoped_body(state, body, scopes, diagnostics)
        .Shield(body, _) | .Defer(body, _) -> sema_ownership_check_scoped_body(state, body, scopes, diagnostics)
        .Switched(_, body, _) -> sema_ownership_check_scoped_body(state, body, scopes, diagnostics)
        .Region(_, _, body, _) -> sema_ownership_check_scoped_body(state, body, scopes, diagnostics)
        .Policy(_, body, _) -> sema_ownership_check_scoped_body(state, body, scopes, diagnostics)
        .Live(body, _) -> sema_ownership_check_scoped_body(state, body, scopes, diagnostics)
        .Transact(_, _, body, _, _) -> sema_ownership_check_scoped_body(state, body, scopes, diagnostics)
        .ComptimeIf(condition, _, then_body, else_body, _, _) -> {
            valid := sema_ownership_check_expression(state, condition, scopes, diagnostics)
            fork: sema_ownership_fork(state)
            nested_then: sema_ownership_check_statements(state, then_body, scopes, diagnostics)
            if !nested_then.complete -> valid = false
            then_path: sema_ownership_fork_path(state, fork)
            sema_ownership_fork_rollback(state, fork)
            else_path := sema_ownership_fork_base(fork)
            if else_body != None {
                nested_else: sema_ownership_check_statements(state, else_body, scopes, diagnostics)
                if !nested_else.complete -> valid = false
                else_path = sema_ownership_fork_path(state, fork)
                sema_ownership_fork_rollback(state, fork)
            }
            sema_ownership_fork_join_close(state, fork, then_path, else_path, else_body != None)
            SemaOwnershipFlowResult{complete: valid, falls_through: true}
        }
        .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .AssumeDet(_, _, _, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> SemaOwnershipFlowResult{complete: true, falls_through: true}
    }
}

sema_ownership_check_statements: fn(state: &SemaOwnershipState, statements: [Stmt], scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaOwnershipFlowResult {
    valid := true
    falls_through := true
    loop statement in statements {
        if !falls_through {
            break
        }
        checked: sema_ownership_check_statement(state, statement, scopes, diagnostics)
        if !checked.complete -> valid = false
        falls_through = checked.falls_through
    }
    SemaOwnershipFlowResult{complete: valid, falls_through: falls_through}
}

// The freeze site of the last declaration row of `key`.
sema_ownership_frozen_for_key: fn(state: SemaOwnershipState, key: String) -> SemaOwnershipFreezeSite? Never! {
    sema_ownership_frozen_for_key_hashed(state, key, name_rows_hash(key))
}

// sema_ownership_frozen_for_key for a `key` whose name_rows_hash is `hash`.
sema_ownership_frozen_for_key_hashed: fn(state: SemaOwnershipState, key: String, hash: Int) -> SemaOwnershipFreezeSite? Never! {
    slot: name_rows_get(state.key_slots, key, hash) ?? return None
    row: state.key_facts[slot].last
    if row < 0 -> return None
    state.declarations[row].frozen_site
}

sema_ownership_frozen_expr_site: fn(state: SemaOwnershipState, expr: Expr, scopes: SemaScopeTable) -> SemaOwnershipFreezeSite? Never! {
    if expr == {
        .Ident(name, span, _) -> {
            index: sema_scope_resolve_index_at(scopes, name, span) ?? return None
            sema_ownership_frozen_for_key(state, scopes.bindings[index].symbol.id.key)
        }
        .Field(base, _, _, _) | .Index(base, _, _, _, _) | .Slice(base, _, _, _, _, _) | .Place(base, _, _, _) | .Paren(base, _, _) -> sema_ownership_frozen_expr_site(state, base, scopes)
        .Call(call, _) -> {
            if call.name != "freeze" || call.args.len() != 1 -> return None
            loop site in state.freeze_sites {
                if site.span.start == call.name_span.start && site.span.end == call.name_span.end -> return Val(site)
            }
            None
        }
        // An `if` value is frozen only when both arms' values are: a merge
        // keeps the proof when every reaching path carries a frozen value.
        .If(_, _, then_value, _, else_value, _, _) -> {
            then_site: sema_ownership_frozen_expr_site(state, then_value, scopes) ?? return None
            if sema_ownership_frozen_expr_site(state, else_value, scopes) == None -> return None
            Val(then_site)
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_ownership_note_frozen_binding: fn(state: &SemaOwnershipState, key: String, init: Expr, scopes: SemaScopeTable) Never! {
    site := sema_ownership_frozen_expr_site(state, init, scopes)
    index: sema_ownership_declaration_index(state, key) ?? return
    sema_ownership_note_undo(state, index)
    state.declarations[index].frozen_site = site
}

sema_ownership_reject_frozen_write: fn(state: SemaOwnershipState, expr: Expr, action: String, span: Span, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    site: sema_ownership_frozen_expr_site(state, expr, scopes) ?? return false
    name := sema_receiver_mark_place_root(expr) ?? "the frozen value"
    freeze_site := "`freeze(...)` at line {site.line}, column {site.column}"
    row: diagnostic_registry_row("E1113") ?? panic("E1113 has no registry row")
    what := row.what.replace("{{name}}", name).replace("{{action}}", action).replace("{{freeze_site}}", freeze_site)
    diagnostics.push(sema_error("E1113", span, what, row.why, row.fix))
    true
}

// Rust carries_lending_view/report_lending_view_escape. Element reads do not
// carry the window, while owning aggregate slots and transparent wrappers do.
sema_ownership_carries_lending_view: fn(expr: Expr, name: String) -> Bool {
    if expr == {
        .Ident(found, _, _) -> return found == name
        .Copy(inner, _, _) | .Place(inner, _, _, _) | .Paren(inner, _, _) | .Spread(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) | .Present(inner, _, _) -> return sema_ownership_carries_lending_view(inner, name)
        .ListLit(items, _, _) -> { loop item in items { if sema_ownership_carries_lending_view(item, name) -> return true } }
        .TupleLit(fields, _, _, _) -> { loop field in fields { if sema_ownership_carries_lending_view(field.value, name) -> return true } }
        .StructLit(_, _, _, _, fields, _, _, _) -> { loop field in fields { if sema_ownership_carries_lending_view(field.value, name) -> return true } }
        .MapLit(entries, _, _) -> { loop entry in entries { if sema_ownership_carries_lending_view(entry.key, name) || sema_ownership_carries_lending_view(entry.value, name) -> return true } }
        .EnumLit(_, _, _, args, _, _, _) -> {
            loop arg in args {
                value: if arg == {
                    .Positional(value) -> value
                    .Named(_, value) -> value
                }
                if sema_ownership_carries_lending_view(value, name) -> return true
            }
        }
        .If(_, _, _, _, _, _, _) -> return sema_expression_lambda_bound_expr_use(expr, name)
        .OrFallback(source_value, fallback, _, _, _) -> {
            if sema_expression_lambda_bound_expr_use(source_value, name) -> return true
            if fallback == {
                .Value(value) -> return sema_expression_lambda_bound_expr_use(value, name)
                .Return(value, _) -> return sema_expression_lambda_bound_optional_expr(value, name)
                .Block(body, value, _) -> return sema_expression_lambda_bound_statements_use(body, name) || sema_expression_lambda_bound_optional_expr(value, name)
                .Panic(_, _) | .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
            }
        }
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> { loop field in fields { if sema_expression_lambda_bound_expr_use(field.value, name) -> return true } }
                .Elements(items) -> { loop item in items { if sema_expression_lambda_bound_expr_use(item, name) -> return true } }
                .Entries(entries) -> { loop entry in entries { if sema_expression_lambda_bound_expr_use(entry.key, name) || sema_expression_lambda_bound_expr_use(entry.value, name) -> return true } }
                .Value(value) -> return sema_expression_lambda_bound_expr_use(value, name)
                .ByteText(_) | .Empty -> {}
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Try(_, _, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    false
}

sema_ownership_report_lending_view_escape: fn(expr: Expr, action: String, scopes: SemaScopeTable, context: SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    loop key in context.lending_view_parameter_keys {
        loop binding_index in 0..<scopes.bindings.len() {
            if scopes.bindings[binding_index].symbol.id.key != key -> next
            name: scopes.bindings[binding_index].symbol.name
            if !sema_ownership_carries_lending_view(expr, name) -> break
            diagnostics.push(sema_error("E0212", expr_span(expr), "the lent mutable view `{name}` cannot {action}", "the view is valid only while the current iteration or callback invocation is active", "use the view inside that scope, and keep only owned values outside it"))
            return true
        }
    }
    false
}
