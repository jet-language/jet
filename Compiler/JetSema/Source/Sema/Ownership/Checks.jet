// Ownership and reference facts for the Jet semantic checker.
//
// This is deliberately a fact prover, not a second Sema context.  Name and
// type lookup remain in SemaScopeTable and Type.  The state below stores only
// facts that are created by a source-order walk: moved places, short-lived
// access windows, declaration liveness, and reference anchors.  The parent
// checker can call the small hooks while it checks expressions/statements, or
// use sema_ownership_check_statements as the ownership-only walk for a body.
//
// Jet's `&` is AccessConvention.Write.  It grants a capability to change the
// named place; it is not a Rust read borrow and is never silently downgraded
// to Read.
use jet_foundation.[
    AccessConvention,
    Binding,
    CallArg,
    Diagnostic,
    Expr,
    InternalTag,
    LValue,
    Lambda,
    PlaceAccess,
    Span,
    Stmt,
    Symbol,
    SymbolKind,
    TagMarker,
    TextEdit,
    Type,
    TypeTupleField,
    UnOp,
    ViewProvenance,
    ViewProvenanceEntry,
    ViewProvenanceMap,
    ViewSource,
    ViewSourcePath,
    ViewSourceProjection,
    diagnostic_with_edit,
    diagnostic_with_label,
    expr_span,
    type_name,
]

pub enum SemaOwnershipReferenceKind {
    Read
    Write
    Move
}

pub enum SemaOwnershipProjection {
    Field(name: String, span: Span)
    Index(value: Int?, span: Span)
    Range(start: Int?, end: Int?, span: Span)
    Fresh(span: Span)
    Deref(span: Span)
}

pub struct SemaOwnershipPlace {
    pub root: String
    pub root_key: String
    pub root_span: Span
    pub projections: [String]
    pub typed_projections: [SemaOwnershipProjection]
}

pub struct SemaOwnershipViewFact {
    pub carrier: String
    pub carrier_key: String
    pub carrier_span: Span
    pub source: SemaOwnershipPlace
    pub output_path: [String]
    pub access: AccessConvention
    pub scope_depth: Int
    pub seq: Int
    pub loan_seq: Int
    pub loan_span: Span
    pub active: Bool
    pub invalidated: Bool
    pub invalidated_span: Span
    pub invalidated_verb: String
}

pub struct SemaOwnershipViewProducer {
    pub source: Expr
    pub access: AccessConvention
    pub span: Span
}

pub struct SemaOwnershipMoveOrigin {
    pub span: Span
    pub consumer: String
    // D-COPY-DEFAULT1=A: the moved binding's type when this was an unmarked
    // move of a whole binding written as its plain name. A later use turns
    // that site into a share; `None` for an exact `^` move or a projection.
    pub share_ty: Type?
}

// D-COPY-DEFAULT1=A: an unmarked move site that a later use reached. The
// function check re-runs with the site known, and the site then checks as
// the authored copy `~name`.
pub struct SemaOwnershipShareSite {
    pub span: Span
    pub ty: Type
}

pub struct SemaOwnershipMovedPlace {
    pub place: SemaOwnershipPlace
    pub origin: SemaOwnershipMoveOrigin
}

pub struct SemaOwnershipLoan {
    pub place: SemaOwnershipPlace
    pub access: AccessConvention
    pub span: Span
    pub scope_depth: Int
    pub seq: Int
    pub carrier_fact_seq: Int
    pub carrier_key: String
    // A window a `&place`/read-place expression opened in value position. No
    // name carries it unless its own statement binds it (`w := &xs`); an
    // unbound one ends before the next statement (sema_ownership_release_dead_views).
    pub statement_window: Bool{false}
}

pub struct SemaOwnershipBindingFact {
    pub key: String
    pub name: String
    pub span: Span
    pub parameter: Bool
    pub scope_depth: Int
    pub references: Int
    pub writes: Int
    pub active: Bool
    // D-LIN1: this binding owns a `#SingleUse` value's consume duty
    // (Ownership/SingleUse.jet).
    pub single_use: Bool
}

pub struct SemaOwnershipReference {
    pub name: String
    pub def_key: String
    pub def_span: Span
    pub use_span: Span
    pub kind: SemaOwnershipReferenceKind
}

pub struct SemaOwnershipState {
    pub scope_depth: Int
    pub next_seq: Int
    pub declarations: [SemaOwnershipBindingFact]
    pub moved: [SemaOwnershipMovedPlace]
    pub loans: [SemaOwnershipLoan]
    pub views: [SemaOwnershipViewFact]
    pub references: [SemaOwnershipReference]
    pub receiver_frames: [SemaReceiverMarkFrame]
    // D-COPY-DEFAULT1=A: share sites this check applies, and the sites it
    // found that a later use reached.
    pub share_known: [Span]
    pub share_found: [SemaOwnershipShareSite]
    // D-SHAPE-PLACE1=A: `function#parameter` keys of list write parameters
    // proven length-preserving (sema_fixed_length_write_params).
    pub fixed_length_write_params: [String]
    // D-UNINIT-SENTINEL2 (E0420): `Type{ uninit }` bindings not yet
    // definitely written on every path reaching this point.
    pub uninit: [SemaOwnershipUninitFact]
    // Rust `is_static_move_root`: keys of this module's `#Persist`, mutable,
    // and `#Static` bindings, which own one shared storage cell (E0222/E0223).
    pub static_roots: [String]
}

// D-UNINIT1: one `Type{ uninit }` binding that is not yet definitely written.
// A fixed list tracks the literal slots written so far; `fixed_len` is None
// for a scalar, or once two paths disagree on the length.
pub struct SemaOwnershipUninitFact {
    pub key: String
    pub name: String
    pub fixed_len: Int?
    pub initialized: [Int]
}

// D-CAP-RECEIVER1=D: a written `&`/`^` mark on a method receiver place.
pub struct SemaReceiverMark {
    pub mark_span: Span
    pub access: PlaceAccess
}

// D-CAP-RECEIVER1=D: one frame per method call being checked. Receiver hooks
// record the strongest convention the resolved call uses for its receiver.
pub struct SemaReceiverMarkFrame {
    pub receiver_span: Span
    pub mark: SemaReceiverMark?
    pub convention: AccessConvention?
}

pub struct SemaOwnershipCallViewFact {
    pub output_path: [String]
    pub access: AccessConvention
    pub places: [SemaOwnershipPlace]
}

pub struct SemaOwnershipCheckResult {
    pub accepted: Bool
    pub complete: Bool
}

pub struct SemaOwnershipFlowResult {
    pub complete: Bool
    pub falls_through: Bool
}

pub fn sema_ownership_state_init() -> SemaOwnershipState Never! {
    SemaOwnershipState{
        scope_depth: 0,
        next_seq: 0,
        declarations: [SemaOwnershipBindingFact]{},
        moved: [SemaOwnershipMovedPlace]{},
        loans: [SemaOwnershipLoan]{},
        views: [SemaOwnershipViewFact]{},
        references: [SemaOwnershipReference]{},
        receiver_frames: [SemaReceiverMarkFrame]{},
        share_known: [Span]{},
        share_found: [SemaOwnershipShareSite]{},
        fixed_length_write_params: [String]{},
        uninit: [SemaOwnershipUninitFact]{},
        static_roots: [String]{},
    }
}

fn sema_ownership_place_snapshot(source: SemaOwnershipPlace) -> SemaOwnershipPlace Never! {
    result := SemaOwnershipPlace{root: source.root, root_key: source.root_key, root_span: source.root_span, projections: [String]{}, typed_projections: [SemaOwnershipProjection]{}}
    loop projection in source.projections -> &result.projections.push(projection)
    loop typed_projection in source.typed_projections -> &result.typed_projections.push(typed_projection)
    result
}

fn sema_ownership_moved_snapshot(source: SemaOwnershipMovedPlace) -> SemaOwnershipMovedPlace Never! {
    SemaOwnershipMovedPlace{
        place: sema_ownership_place_snapshot(source.place),
        origin: source.origin,
    }
}

fn sema_ownership_loan_snapshot(source: SemaOwnershipLoan) -> SemaOwnershipLoan Never! {
    SemaOwnershipLoan{
        place: sema_ownership_place_snapshot(source.place),
        access: source.access,
        span: source.span,
        scope_depth: source.scope_depth,
        seq: source.seq,
        carrier_fact_seq: source.carrier_fact_seq,
        carrier_key: source.carrier_key,
        statement_window: source.statement_window,
    }
}

fn sema_ownership_view_snapshot(source: SemaOwnershipViewFact) -> SemaOwnershipViewFact Never! {
    result := SemaOwnershipViewFact{
        carrier: source.carrier,
        carrier_key: source.carrier_key,
        carrier_span: source.carrier_span,
        source: sema_ownership_place_snapshot(source.source),
        output_path: [String]{},
        access: source.access,
        scope_depth: source.scope_depth,
        seq: source.seq,
        loan_seq: source.loan_seq,
        loan_span: source.loan_span,
        active: source.active,
        invalidated: source.invalidated,
        invalidated_span: source.invalidated_span,
        invalidated_verb: source.invalidated_verb,
    }
    loop path in source.output_path -> &result.output_path.push(path)
    result
}

pub fn sema_ownership_state_snapshot(source: SemaOwnershipState) -> SemaOwnershipState Never! {
    snapshot := sema_ownership_state_init()
    snapshot.scope_depth = source.scope_depth
    snapshot.next_seq = source.next_seq
    loop declaration in source.declarations -> &snapshot.declarations.push(declaration)
    loop moved in source.moved -> &snapshot.moved.push(sema_ownership_moved_snapshot(moved))
    loop loan in source.loans -> &snapshot.loans.push(sema_ownership_loan_snapshot(loan))
    loop view in source.views -> &snapshot.views.push(sema_ownership_view_snapshot(view))
    loop reference in source.references -> &snapshot.references.push(reference)
    loop site in source.share_known -> &snapshot.share_known.push(site)
    loop site in source.share_found -> &snapshot.share_found.push(site)
    snapshot.fixed_length_write_params = source.fixed_length_write_params
    snapshot.uninit = source.uninit
    snapshot.static_roots = source.static_roots
    snapshot
}

// Puts back a whole-state copy (`~state`) taken before a check that is being
// discarded.
pub fn sema_ownership_state_restore(state: &SemaOwnershipState, saved: SemaOwnershipState) Never! {
    state.scope_depth = saved.scope_depth
    state.next_seq = saved.next_seq
    state.declarations = ~saved.declarations
    state.moved = ~saved.moved
    state.loans = ~saved.loans
    state.views = ~saved.views
    state.references = ~saved.references
    state.receiver_frames = ~saved.receiver_frames
    state.share_known = ~saved.share_known
    state.share_found = ~saved.share_found
    state.fixed_length_write_params = ~saved.fixed_length_write_params
    state.uninit = ~saved.uninit
    state.static_roots = ~saved.static_roots
}

fn sema_ownership_next_sequence(state: &SemaOwnershipState) -> Int Never! {
    sequence := state.next_seq
    state.next_seq += 1
    sequence
}

fn sema_ownership_span_same(left: Span, right: Span) -> Bool Never! {
    left.start == right.start && left.end == right.end
}

// ────────────────────────────────────────────────────────────────────────────
// Copy/clone judgments

// This is the representation-only part of Rust's `type_is_copy` judgment.
// Nominal types require the parent's trait registry and therefore are not
// guessed here; callers receive `complete == false` for such a dependency.
fn sema_ownership_type_tuple_is_copy(fields: [TypeTupleField]) -> Bool Never! {
    loop field in fields {
        if !sema_ownership_type_is_copy(field.ty) -> return false
    }
    true
}

pub fn sema_ownership_type_is_copy(ty: Type) -> Bool Never! {
    if ty == {
        .Int -> true
        .IntN(_, _) -> true
        .Float -> true
        .Float32 -> true
        .Bool -> true
        .Char -> true
        .Measure(_) -> true
        .Quantity(base, _) -> sema_ownership_type_is_copy(base)
        .Tagged(marker, inner) -> if marker == (TagMarker.Internal{internal_tag: InternalTag.AllocatorView}) -> false else -> sema_ownership_type_is_copy(inner)
        .Option(inner) -> sema_ownership_type_is_copy(inner)
        .Result(ok, err) -> sema_ownership_type_is_copy(ok) && sema_ownership_type_is_copy(err)
        .Tuple(fields) -> sema_ownership_type_tuple_is_copy(fields)
        .FixedList(inner, _) -> sema_ownership_type_is_copy(inner)
        .InlineRange(_, _, _) -> true
        .Named(name) -> name == "Unit" || name == "Never"
        else -> false
    }
}

// Rust `Type::is_scalar`: the by-value numeric and boolean leaves (and raw
// pointers). Unlike Copy it excludes `Char`, carriers, tuples and units; the
// borrowed-parameter binding and return audits key on exactly this set.
pub fn sema_ownership_type_is_scalar(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Bool | .Float32 | .IntN(_, _) | .Quantity(_, _) -> true
        .Tagged(_, inner) | .InlineRange(inner, _, _) -> sema_ownership_type_is_scalar(inner)
        .Apply(name, args) -> name == "Ptr" && args.len() == 1
        else -> false
    }
}

// A read or write parameter: storage this function borrows and does not own
// (Rust `param_conv` is `Read` or `Write`). Locals are owned even though
// they are declared with read access.
pub fn sema_ownership_binding_is_borrowed_param(binding: SemaScopeBinding) -> Bool Never! {
    binding.symbol.kind == SymbolKind.Parameter && (binding.access == AccessConvention.Read || binding.access == AccessConvention.Write)
}

// Rust `is_edit_shared_guard`: a binding holding a `guard_edit()` lease keeps
// its acquisition-site write capability even when the binding is immutable.
fn sema_ownership_binding_is_edit_shared_guard(binding: SemaScopeBinding) -> Bool Never! {
    ty :: binding.symbol.ty ?? return false
    if ty == .Tagged(marker, inner) {
        if marker != (TagMarker.Internal{internal_tag: InternalTag.SharedGuardEdit}) -> return false
        if inner == .Apply(name, _) -> return name == "SharedGuard"
    }
    false
}

// Rust `place_reads_untagged_or_read_shared_guard`: a write that reaches a
// `.value` held by an untagged or `guard_read()` SharedGuard. A write
// parameter root keeps its caller-granted capability. The guard type is
// known only for a binding root (`guard.value`), where every guard lives.
fn sema_ownership_writes_read_shared_guard(expr: Expr, scopes: SemaScopeTable) -> Bool Never! {
    output_path := [String]{}
    root :: sema_ownership_named_view_root(expr, &output_path) ?? return false
    root_index :: sema_scope_resolve_index_at(scopes, root, expr_span(expr)) ?? return false
    root_binding :: scopes.bindings[root_index]
    if root_binding.symbol.kind == SymbolKind.Parameter && root_binding.access == AccessConvention.Write -> return false
    sema_ownership_place_reads_read_shared_guard(expr, scopes)
}

fn sema_ownership_place_reads_read_shared_guard(expr: Expr, scopes: SemaScopeTable) -> Bool Never! {
    if expr == {
        .Field(base, member, _) -> {
            if member == "value" && sema_ownership_expr_is_read_shared_guard(base, scopes) -> return true
            sema_ownership_place_reads_read_shared_guard(base, scopes)
        }
        .Index(base, _, _, _) | .Paren(base, _) | .Place(base, _, _) -> sema_ownership_place_reads_read_shared_guard(base, scopes)
        else -> false
    }
}

fn sema_ownership_expr_is_read_shared_guard(expr: Expr, scopes: SemaScopeTable) -> Bool Never! {
    if expr == .Ident(name, span) {
        index :: sema_scope_resolve_index_at(scopes, name, span) ?? return false
        ty :: scopes.bindings[index].symbol.ty ?? return false
        if ty == .Apply(guard_name, _) -> return guard_name == "SharedGuard"
        if ty == .Tagged(marker, _) -> return marker == (TagMarker.Internal{internal_tag: InternalTag.SharedGuardRead})
    }
    false
}

fn sema_ownership_diag_read_shared_guard_write(span: Span) -> Diagnostic {
    sema_error("E0205", span, "cannot edit through this read-only `SharedGuard` view", "a public guard type outside its acquisition site preserves read access unless a helper explicitly receives it with write access", "keep the edit at the acquisition site, or pass the guard to a helper with the write-access marker `&`, such as `&guard: SharedGuard<T>`")
}

// Structural cloneability is known for the core value constructors. A
// nominal, trait, or function part is registry-owned: it leaves the whole
// answer unresolved (None) for the registry check, never a conservative
// `false` for a composite that holds it (`Effect?`, `[Row]`).
pub fn sema_ownership_type_cloneable(ty: Type) -> Bool? {
    if sema_ownership_type_is_copy(ty) -> return Val(true)
    if ty == {
        .String -> Val(true)
        .List(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .Quantity(inner, _) -> sema_ownership_type_cloneable(inner)
        .Map(key, _, value) | .Result(key, value) -> sema_ownership_types_cloneable([Type]{key, value})
        .Tuple(fields) -> sema_ownership_types_cloneable(loop field in fields -> field.ty)
        .Named(_) | .Apply(_, _) | .TraitObject(_) | .Fn(_, _, _, _, _, _) -> None
        else -> Val(false)
    }
}

// Every part cloneable: one known refusal decides, else an unresolved part
// leaves the composite unresolved.
fn sema_ownership_types_cloneable(parts: [Type]) -> Bool? {
    unresolved := false
    loop part in parts {
        answer :: sema_ownership_type_cloneable(part)
        if answer == (Val(false)) -> return Val(false)
        if answer == None -> unresolved = true
    }
    if unresolved -> None else -> Val(true)
}

// ────────────────────────────────────────────────────────────────────────────
// Scope/declaration/reference facts

pub fn sema_ownership_enter_scope(state: &SemaOwnershipState) Never! {
    state.scope_depth += 1
}

pub fn sema_ownership_leave_scope(state: &SemaOwnershipState) Never! {
    depth := state.scope_depth
    if depth <= 0 -> return

    loop declaration_index in 0..<state.declarations.len() {
        if state.declarations[declaration_index].scope_depth >= depth {
            state.declarations[declaration_index].active = false
        }
    }

    remaining_moves := [SemaOwnershipMovedPlace]{}
    loop moved in state.moved {
        belongs := false
        loop declaration in state.declarations {
            if declaration.key == moved.place.root_key && declaration.scope_depth >= depth {
                belongs = true
                break
            }
        }
        if !belongs -> &remaining_moves.push(moved)
    }
    state.moved = remaining_moves

    remaining_loans := [SemaOwnershipLoan]{}
    loop loan in state.loans {
        if loan.scope_depth < depth -> &remaining_loans.push(loan)
    }
    state.loans = remaining_loans

    remaining_views := [SemaOwnershipViewFact]{}
    loop view in state.views {
        if view.active && view.scope_depth < depth -> &remaining_views.push(view)
    }
    state.views = remaining_views
    state.scope_depth = depth - 1
}

// Rust `view_is_live_now`: a view stays live while this statement or a later
// one uses its carrier. A dead view releases its window, so the owner may be
// read, changed, moved, windowed, or pinned again after the view's last use.
// A window no name carries (`if &x.session == {…}` in value position) ends
// before the next statement, nested ones included: Rust records no view for
// it at all.
pub fn sema_ownership_release_dead_views(state: &SemaOwnershipState, statement: Stmt, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) {
    loop index in 0..<state.views.len() {
        fact :: state.views[index]
        if !fact.active -> next
        if sema_ownership_last_use_statement(statement, fact.carrier) || sema_ownership_name_live_after(fact.carrier, &tail_store, &context) -> next
        state.views[index].active = false
        remaining :: loop loan in state.loans if loan.carrier_fact_seq != fact.seq || loan.carrier_key != fact.carrier_key -> loan
        state.loans = remaining
    }
    unbound :: loop loan in state.loans if !loan.statement_window || loan.carrier_fact_seq >= 0 -> loan
    state.loans = unbound
}

pub fn sema_ownership_declare_binding(state: &SemaOwnershipState, symbol: Symbol, parameter: Bool) Never! {
    if symbol.name == "_" -> return
    &state.declarations.push(SemaOwnershipBindingFact{
        key: symbol.id.key,
        name: symbol.name,
        span: symbol.span,
        parameter: parameter,
        scope_depth: state.scope_depth,
        references: 0,
        writes: 0,
        active: true,
        single_use: false,
    })
}

fn sema_ownership_intentional_name(name: String) -> Bool Never! {
    name == "" || name.starts_with("_") || name.starts_with("@_") || name == "self" || name == "result" || name == "it"
}

fn sema_ownership_declaration_index(state: &SemaOwnershipState, key: String) -> Int? {
    index := state.declarations.len() - 1
    loop index >= 0 {
        if state.declarations[index].key == key -> return Val(index)
        index -= 1
    }
    None
}

// Lookup is delegated to SemaScopeTable.  If a parent hook forgot to declare
// the binding in the ownership store, recover one from the canonical Symbol
// rather than manufacturing a second name-resolution table.
pub fn sema_ownership_note_reference(state: &SemaOwnershipState, name: String, use_span: Span, scopes: SemaScopeTable, kind: SemaOwnershipReferenceKind) -> Bool Never! {
    index :: sema_scope_resolve_index_at(scopes, name, use_span) ?? return false
    binding :: scopes.bindings[index]
    def_key :: binding.symbol.id.key
    declaration_index := sema_ownership_declaration_index(&state, def_key)
    if declaration_index == None {
        sema_ownership_declare_binding(&state, binding.symbol, binding.symbol.kind == SymbolKind.Parameter)
        declaration_index = sema_ownership_declaration_index(&state, def_key)
    }
    fact_index :: declaration_index ?? return false
    state.declarations[fact_index].references += 1
    if kind == SemaOwnershipReferenceKind.Write -> state.declarations[fact_index].writes += 1
    &state.references.push(SemaOwnershipReference{name: name, def_key: def_key, def_span: binding.symbol.span, use_span: use_span, kind: kind})
    true
}

fn sema_ownership_note_place_reference(state: &SemaOwnershipState, expr: Expr, place: SemaOwnershipPlace, use_span: Span, scopes: SemaScopeTable, kind: SemaOwnershipReferenceKind) -> Bool Never! {
    valid := sema_ownership_note_reference(&state, place.root, use_span, scopes, kind)
    output_path := [String]{}
    carrier_name := sema_ownership_named_view_root(expr, &output_path)
    if carrier_name != None {
        name :: carrier_name ?? place.root
        carrier_index := sema_scope_resolve_index_at(scopes, name, use_span)
        if carrier_index != None && scopes.bindings[carrier_index ?? 0].symbol.id.key != place.root_key {
            if !sema_ownership_note_reference(&state, name, use_span, scopes, kind) -> valid = false
        }
    }
    valid
}

pub fn sema_ownership_finalize_references(state: &SemaOwnershipState, diagnostics: &[Diagnostic]) {
    loop fact in state.declarations {
        if fact.references == 0 && !sema_ownership_intentional_name(fact.name) && !sema_ownership_flow_narrowing(state, fact) {
            // Rust `CheckerReferences::emit_unused_binding_lints`: the
            // registry row wording, with the `_name` rename as the edit.
            what := "Local binding `{fact.name}` is never read."
            why := "A binding that no later expression reads adds dead code and may hide a computed result that should have been used."
            fix := "Remove the binding when its initializer is side-effect free, or rename `{fact.name}` to `_{fact.name}` when the value must be computed."
            code := "L0101"
            if fact.parameter {
                code = "L0102"
                what = "Parameter `{fact.name}` is never used."
                why = "An unused parameter often means the function contract or implementation is incomplete; Jet keeps this warning-only so prototypes stay unblocked."
                fix = "Use `{fact.name}`, rename it to `_{fact.name}` when it is intentionally unused, or remove it from the function contract."
            }
            &diagnostics.push(diagnostic_with_edit(sema_lint(code, fact.span, what, why, fix), TextEdit{span: fact.span, new_text: "_{fact.name}"}))
        }
    }
}

// D-FLOWTYPE1=A: `x == None` over a stable optional reads as the presence
// test `x == .Val(x)`, which rebinds the payload under the same name at the
// read of `x`. That rebinding is the narrowed `x` itself (Rust refines the
// one binding's type), so it is not a separate unused local.
fn sema_ownership_flow_narrowing(state: SemaOwnershipState, fact: SemaOwnershipBindingFact) -> Bool Never! {
    loop reference in state.references {
        if reference.name == fact.name && reference.def_key != fact.key && sema_ownership_span_same(reference.use_span, fact.span) -> return true
    }
    false
}

fn sema_ownership_recompute_reference_counts(state: &SemaOwnershipState) Never! {
    positions := [String:Int]{}
    loop index in 0..<state.declarations.len() {
        state.declarations[index].references = 0
        state.declarations[index].writes = 0
        key :: state.declarations[index].key
        if positions.get(key) == None -> positions[key] = index
    }
    loop reference in state.references {
        declaration_index :: positions.get(reference.def_key) ?? next
        state.declarations[declaration_index].references += 1
        if reference.kind == SemaOwnershipReferenceKind.Write -> state.declarations[declaration_index].writes += 1
    }
}

// Exact reference anchor: definition key plus use span.
fn sema_ownership_reference_anchor(reference: SemaOwnershipReference) -> String Never! {
    "{reference.use_span.start}:{reference.use_span.end}:{reference.def_key}"
}

fn sema_ownership_reference_anchors(references: [SemaOwnershipReference]) -> [String:Bool] Never! {
    anchors := [String:Bool]{}
    loop reference in references -> anchors[sema_ownership_reference_anchor(reference)] = true
    anchors
}

// Appends each reference whose anchor `anchors` does not hold yet.
fn sema_ownership_admit_references(merged: &[SemaOwnershipReference], anchors: &[String:Bool], references: [SemaOwnershipReference]) Never! {
    loop reference in references {
        anchor :: sema_ownership_reference_anchor(reference)
        if anchors.get(anchor) != None -> next
        anchors[anchor] = true
        &merged.push(reference)
    }
}

// Merge only reference anchors from a deferred body.  Moves and write windows
// in a lambda body belong to the lambda's execution state, not construction.
pub fn sema_ownership_merge_references(state: &SemaOwnershipState, deferred: SemaOwnershipState) Never! {
    anchors := sema_ownership_reference_anchors(state.references)
    sema_ownership_admit_references(&state.references, &anchors, deferred.references)
    sema_ownership_recompute_reference_counts(&state)
}

// ────────────────────────────────────────────────────────────────────────────
// Places and overlap

fn sema_ownership_const_index(expr: Expr) -> Int? {
    if expr == {
        .Int(value, _, _, _) -> Val(value)
        .Unary(op, value, _) -> {
            if op != UnOp.Neg -> return None
            number :: sema_ownership_const_index(value) ?? return None
            Val(-number)
        }
        .Paren(value, _) -> sema_ownership_const_index(value)
        else -> None
    }
}

pub struct SemaOwnershipRangeBounds {
    pub start: Int?
    pub end: Int?
}

fn sema_ownership_range_bounds(start: Expr, end: Expr, range: Expr?) -> SemaOwnershipRangeBounds Never! {
    if range == .Val(actual) {
        if actual == {
            .Range(range_start, range_end, exclusive, _) -> {
                first :: sema_ownership_const_index(range_start)
                last := sema_ownership_const_index(range_end)
                if exclusive && last != None {
                    last = Val((last ?? 0) - 1)
                }
                return SemaOwnershipRangeBounds{start: first, end: last}
            }
            else -> return SemaOwnershipRangeBounds{start: None, end: None}
        }
    }
    SemaOwnershipRangeBounds{start: sema_ownership_const_index(start), end: sema_ownership_const_index(end)}
}

fn sema_ownership_path_starts(path: [String], prefix: [String]) -> Bool Never! {
    if prefix.len() > path.len() -> return false
    loop (index, item) in prefix {
        if path[index] != item -> return false
    }
    true
}

fn sema_ownership_named_view_root(expr: Expr, output_path: &[String]) -> String? {
    if expr == {
        .Ident(name, _) -> Val(name)
        .Paren(value, _) | .Place(value, _, _) -> sema_ownership_named_view_root(value, &output_path)
        .Field(base, member, _) | .OptField(base, member, _, _, _) -> {
            root :: sema_ownership_named_view_root(base, &output_path) ?? return None
            &output_path.push(".{member}")
            Val(root)
        }
        .Index(base, index, _, _) -> {
            root :: sema_ownership_named_view_root(base, &output_path) ?? return None
            constant :: sema_ownership_const_index(index)
            if constant != None -> &output_path.push("[{constant}]") else -> &output_path.push("[]")
            Val(root)
        }
        .Slice(base, _, _, _, _) -> {
            root :: sema_ownership_named_view_root(base, &output_path) ?? return None
            &output_path.push("[..]")
            Val(root)
        }
        .Deref(value, _) | .RawOf(value, _) -> {
            root :: sema_ownership_named_view_root(value, &output_path) ?? return None
            &output_path.push("*")
            Val(root)
        }
        else -> None
    }
}

fn sema_ownership_typed_projection_facts(expr: Expr) -> [SemaOwnershipProjection]? {
    if expr == {
        .Ident(_, _) -> Val([SemaOwnershipProjection]{})
        .Paren(value, _) | .Place(value, _, _) | .Tainted(value, _, _) -> sema_ownership_typed_projection_facts(value)
        .Field(base, member, span) | .OptField(base, member, _, _, span) -> {
            facts := sema_ownership_typed_projection_facts(base) ?? return None
            &facts.push(SemaOwnershipProjection.Field{name: member, span: span})
            Val(facts)
        }
        .Index(base, index, span, _) -> {
            facts := sema_ownership_typed_projection_facts(base) ?? return None
            &facts.push(SemaOwnershipProjection.Index{value: sema_ownership_const_index(index), span: span})
            Val(facts)
        }
        .Slice(base, start, end, range, span) -> {
            facts := sema_ownership_typed_projection_facts(base) ?? return None
            bounds :: sema_ownership_range_bounds(start, end, range)
            &facts.push(SemaOwnershipProjection.Range{start: bounds.start, end: bounds.end, span: span})
            Val(facts)
        }
        .Deref(value, span) | .RawOf(value, span) -> {
            facts := sema_ownership_typed_projection_facts(value) ?? return None
            &facts.push(SemaOwnershipProjection.Deref{span: span})
            Val(facts)
        }
        else -> None
    }
}

fn sema_ownership_place_from_expr_inner(expr: Expr, scopes: SemaScopeTable) -> SemaOwnershipPlace? {
    if expr == {
        .Ident(name, span) -> {
            index :: sema_scope_resolve_index_at(scopes, name, span) ?? return None
            binding :: scopes.bindings[index]
            Val(SemaOwnershipPlace{
                root: binding.symbol.name,
                root_key: binding.symbol.id.key,
                root_span: binding.symbol.span,
                projections: [String]{},
                typed_projections: [SemaOwnershipProjection]{},
            })
        }
        .Paren(value, _) -> sema_ownership_place_from_expr_inner(value, scopes)
        .Place(value, _, _) -> sema_ownership_place_from_expr_inner(value, scopes)
        .Tainted(value, _, _) -> sema_ownership_place_from_expr_inner(value, scopes)
        .Field(base, member, span) -> {
            place := sema_ownership_place_from_expr_inner(base, scopes) ?? return None
            &place.projections.push(".{member}")
            &place.typed_projections.push(SemaOwnershipProjection.Field{name: member, span: span})
            Val(place)
        }
        .OptField(base, member, _, _, span) -> {
            place := sema_ownership_place_from_expr_inner(base, scopes) ?? return None
            &place.projections.push(".{member}")
            &place.typed_projections.push(SemaOwnershipProjection.Field{name: member, span: span})
            Val(place)
        }
        .Index(base, index, span, _) -> {
            place := sema_ownership_place_from_expr_inner(base, scopes) ?? return None
            constant :: sema_ownership_const_index(index)
            if constant != None -> &place.projections.push("[{constant}]") else -> &place.projections.push("[]")
            &place.typed_projections.push(SemaOwnershipProjection.Index{value: constant, span: span})
            Val(place)
        }
        .Slice(base, start, end, range, span) -> {
            place := sema_ownership_place_from_expr_inner(base, scopes) ?? return None
            &place.projections.push("[..]")
            bounds :: sema_ownership_range_bounds(start, end, range)
            &place.typed_projections.push(SemaOwnershipProjection.Range{start: bounds.start, end: bounds.end, span: span})
            Val(place)
        }
        .Deref(value, span) -> {
            place := sema_ownership_place_from_expr_inner(value, scopes) ?? return None
            &place.projections.push("*")
            &place.typed_projections.push(SemaOwnershipProjection.Deref{span: span})
            Val(place)
        }
        .RawOf(value, span) -> {
            place := sema_ownership_place_from_expr_inner(value, scopes) ?? return None
            &place.projections.push("*")
            &place.typed_projections.push(SemaOwnershipProjection.Deref{span: span})
            Val(place)
        }
        .Copy(_, _) -> None
        else -> None
    }
}

fn sema_ownership_append_place_unique(places: &[SemaOwnershipPlace], candidate: SemaOwnershipPlace) Never! {
    loop place in places {
        if sema_ownership_place_exact(place, candidate) -> return
    }
    &places.push(candidate)
}

pub fn sema_ownership_places_from_expr_in_state(expr: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState) -> [SemaOwnershipPlace] {
    named_path := [String]{}
    named_root := sema_ownership_named_view_root(expr, &named_path)
    if named_root == .Val(root_name) {
        binding_index :: sema_scope_resolve_index_at(scopes, root_name, expr_span(expr))
        if binding_index == .Val(found_index) {
            carrier_key :: scopes.bindings[found_index].symbol.id.key
            places := [SemaOwnershipPlace]{}
            typed :: sema_ownership_typed_projection_facts(expr) ?? return [SemaOwnershipPlace]{}
            index := state.views.len() - 1
            loop index >= 0 {
                fact :: state.views[index]
                if fact.active && fact.carrier_key == carrier_key && sema_ownership_path_starts(named_path, fact.output_path) {
                    place := sema_ownership_place_snapshot(fact.source)
                    loop suffix in fact.output_path.len()..<named_path.len() -> &place.projections.push(named_path[suffix])
                    loop typed_suffix in fact.output_path.len()..<typed.len() -> &place.typed_projections.push(typed[typed_suffix])
                    sema_ownership_append_place_unique(&places, place)
                }
                index -= 1
            }
            if places.len() > 0 -> return places
        }
    }
    place :: sema_ownership_place_from_expr_inner(expr, scopes) ?? return [SemaOwnershipPlace]{}
    [SemaOwnershipPlace]{place}
}

fn sema_ownership_typed_projection_overlap(left: SemaOwnershipProjection, right: SemaOwnershipProjection) -> Bool Never! {
    if left == {
        .Field(name, _) -> if right == {
            .Field(other, _) -> name == other
            else -> true
        }
        .Index(value, _) -> if right == {
            .Index(other, _) -> {
                if value != None && other != None -> return value == other
                true
            }
            .Range(start, end, _) -> {
                if value != None && start != None && end != None {
                    number := value
                    if number < start || number > end -> return false
                }
                true
            }
            else -> true
        }
        .Range(start, end, _) -> if right == {
            .Index(value, _) -> {
                if value != None && start != None && end != None {
                    number := value
                    if number < start || number > end -> return false
                }
                true
            }
            .Range(other_start, other_end, _) -> {
                if start != None && end != None && other_start != None && other_end != None {
                    if end < other_start || other_end < start -> return false
                }
                true
            }
            else -> true
        }
        .Fresh(span) -> if right == {
            .Fresh(other) -> sema_ownership_span_same(span, other)
            else -> true
        }
        .Deref(_) -> true
    }
}

fn sema_ownership_typed_projection_exact(left: SemaOwnershipProjection, right: SemaOwnershipProjection) -> Bool Never! {
    if left == {
        .Field(name, _) -> if right == {.Field(other, _) -> name == other else -> false}
        .Index(value, _) -> if right == {.Index(other, _) -> value == other else -> false}
        .Range(start, end, _) -> if right == {.Range(other_start, other_end, _) -> start == other_start && end == other_end else -> false}
        .Fresh(span) -> if right == {.Fresh(other) -> sema_ownership_span_same(span, other) else -> false}
        .Deref(span) -> if right == {.Deref(other) -> sema_ownership_span_same(span, other) else -> false}
    }
}

pub fn sema_ownership_places_overlap(left: SemaOwnershipPlace, right: SemaOwnershipPlace) -> Bool Never! {
    if left.root_key == "" || right.root_key == "" -> return false
    if left.root_key != right.root_key -> return false
    if left.typed_projections.len() != left.projections.len() || right.typed_projections.len() != right.projections.len() -> return true
    limit := right.typed_projections.len()
    if left.typed_projections.len() < limit -> limit = left.typed_projections.len()
    loop index in 0..<limit {
        if !sema_ownership_typed_projection_overlap(left.typed_projections[index], right.typed_projections[index]) -> return false
    }
    true
}

fn sema_ownership_place_name(place: SemaOwnershipPlace) -> String Never! {
    name := place.root
    loop projection in place.projections -> name = "{name}{projection}"
    name
}

fn sema_ownership_view_producer(expr: Expr) -> SemaOwnershipViewProducer? {
    if expr == {
        .Paren(value, _) -> sema_ownership_view_producer(value)
        .Place(value, access, _) -> {
            convention :: if access == PlaceAccess.Write -> AccessConvention.Write else -> AccessConvention.Read
            Val(SemaOwnershipViewProducer{source: value, access: convention, span: expr_span(expr)})
        }
        else -> None
    }
}

fn sema_ownership_arena_view_source(binding: Binding) -> Expr? {
    if !binding.arena_view -> return None
    if binding.init == {
        .MethodCall(receiver, method, _, _, _, _, _, _, _, _) -> {
            if method != "alloc" && method != "try_alloc" -> return None
            Val(receiver)
        }
        else -> None
    }
}

fn sema_ownership_carrier_key(scopes: SemaScopeTable, name: String, span: Span) -> String? {
    index :: sema_scope_resolve_index_at(scopes, name, span) ?? return None
    Val(scopes.bindings[index].symbol.id.key)
}

fn sema_ownership_matching_loan_seq(state: &SemaOwnershipState, source: SemaOwnershipPlace, span: Span) -> Int Never! {
    index := state.loans.len() - 1
    loop index >= 0 {
        loan :: state.loans[index]
        if loan.access == AccessConvention.Write && loan.carrier_fact_seq < 0 && sema_ownership_span_same(loan.span, span) && sema_ownership_place_exact(loan.place, source) -> return loan.seq
        index -= 1
    }
    -1
}

fn sema_ownership_record_view_fact_inner(state: &SemaOwnershipState, carrier: String, carrier_span: Span, source: SemaOwnershipPlace, output_path: [String], access: AccessConvention, scopes: SemaScopeTable, loan_seq: Int) -> Bool Never! {
    if source.root_key == "" -> return false
    key :: sema_ownership_carrier_key(scopes, carrier, carrier_span) ?? return false
    associated_loan_span := carrier_span
    if loan_seq >= 0 {
        found_loan := false
        loop loan in state.loans {
            if loan.seq == loan_seq && loan.access == AccessConvention.Write && loan.carrier_fact_seq < 0 && sema_ownership_place_exact(loan.place, source) {
                associated_loan_span = loan.span
                found_loan = true
                break
            }
        }
        if !found_loan -> return false
    }
    stored_source := sema_ownership_place_snapshot(source)
    stored_output_path := [String]{}
    loop path in output_path -> &stored_output_path.push(path)
    fact_seq := sema_ownership_next_sequence(&state)
    &state.views.push(SemaOwnershipViewFact{
        carrier: carrier,
        carrier_key: key,
        carrier_span: carrier_span,
        source: stored_source,
        output_path: stored_output_path,
        access: access,
        scope_depth: state.scope_depth,
        seq: fact_seq,
        loan_seq: loan_seq,
        loan_span: associated_loan_span,
        active: true,
        invalidated: false,
        invalidated_span: carrier_span,
        invalidated_verb: "",
    })
    if loan_seq >= 0 {
        loop index in 0..<state.loans.len() {
            loan :: state.loans[index]
            if loan.seq == loan_seq && loan.access == AccessConvention.Write && loan.carrier_fact_seq < 0 && sema_ownership_span_same(loan.span, associated_loan_span) && sema_ownership_place_exact(loan.place, source) {
                state.loans[index].carrier_fact_seq = fact_seq
                state.loans[index].carrier_key = key
                break
            }
        }
    }
    true
}

pub fn sema_ownership_record_view_fact(state: &SemaOwnershipState, carrier: String, carrier_span: Span, source: SemaOwnershipPlace, output_path: [String], access: AccessConvention, scopes: SemaScopeTable, loan_seq: Int) -> Bool Never! {
    key :: sema_ownership_carrier_key(scopes, carrier, carrier_span) ?? return false
    loop index in 0..<state.views.len() {
        if state.views[index].carrier_key == key && state.views[index].active -> state.views[index].active = false
    }
    sema_ownership_record_view_fact_inner(&state, carrier, carrier_span, source, output_path, access, scopes, loan_seq)
}

pub fn sema_ownership_record_binding_view(state: &SemaOwnershipState, binding: Binding, scopes: SemaScopeTable) -> Bool {
    if sema_ownership_arena_view_source(binding) == .Val(source_expr) {
        return sema_ownership_record_fresh_view_fact(&state, binding.name, binding.name_span, source_expr, [String]{}, AccessConvention.Write, scopes, binding.name_span)
    }
    producer :: sema_ownership_view_producer(binding.init) ?? return false
    places := sema_ownership_places_from_expr_in_state(producer.source, scopes, &state)
    if places.len() == 0 -> return false
    key :: sema_ownership_carrier_key(scopes, binding.name, binding.name_span) ?? return false
    loop index in 0..<state.views.len() {
        if state.views[index].carrier_key == key && state.views[index].active -> state.views[index].active = false
    }
    valid := true
    loop place in places {
        loan_seq := sema_ownership_matching_loan_seq(&state, place, producer.span)
        if !sema_ownership_record_view_fact_inner(&state, binding.name, binding.name_span, place, [String]{}, producer.access, scopes, loan_seq) -> valid = false
    }
    valid
}

pub fn sema_ownership_record_call_view(state: &SemaOwnershipState, carrier: String, carrier_span: Span, source_expr: Expr, output_path: [String], access: AccessConvention, scopes: SemaScopeTable) -> Bool {
    places := sema_ownership_places_from_expr_in_state(source_expr, scopes, &state)
    if places.len() == 0 -> return false
    key :: sema_ownership_carrier_key(scopes, carrier, carrier_span) ?? return false
    loop index in 0..<state.views.len() {
        if state.views[index].carrier_key == key && state.views[index].active -> state.views[index].active = false
    }
    valid := true
    loop place in places {
        if !sema_ownership_record_view_fact_inner(&state, carrier, carrier_span, place, output_path, access, scopes, -1) -> valid = false
    }
    valid
}

pub fn sema_ownership_append_view_source_projections(place: SemaOwnershipPlace, projections: [ViewSourceProjection], span: Span) -> SemaOwnershipPlace Never! {
    result := sema_ownership_place_snapshot(place)
    loop projection in projections {
        if projection == {
            .Field(name) -> {
                &result.projections.push(".{name}")
                &result.typed_projections.push(SemaOwnershipProjection.Field{name: name, span: span})
            }
            .Index -> {
                &result.projections.push("[]")
                &result.typed_projections.push(SemaOwnershipProjection.Index{value: None, span: span})
            }
            .Range -> {
                &result.projections.push("[..]")
                &result.typed_projections.push(SemaOwnershipProjection.Range{start: None, end: None, span: span})
            }
        }
    }
    result
}

pub fn sema_ownership_record_call_view_batch(state: &SemaOwnershipState, carrier: String, carrier_span: Span, facts: [SemaOwnershipCallViewFact], scopes: SemaScopeTable) -> Bool Never! {
    if facts.len() == 0 -> return false
    key :: sema_ownership_carrier_key(scopes, carrier, carrier_span) ?? return false
    place_count := 0
    loop fact in facts -> place_count += fact.places.len()
    if place_count == 0 -> return false
    loop index in 0..<state.views.len() {
        if state.views[index].carrier_key == key && state.views[index].active -> state.views[index].active = false
    }
    valid := true
    loop fact in facts {
        loop place in fact.places {
            if !sema_ownership_record_view_fact_inner(&state, carrier, carrier_span, place, fact.output_path, fact.access, scopes, -1) -> valid = false
        }
    }
    valid
}

pub fn sema_ownership_record_fresh_view_fact(state: &SemaOwnershipState, carrier: String, carrier_span: Span, source_expr: Expr, output_path: [String], access: AccessConvention, scopes: SemaScopeTable, proof_span: Span) -> Bool {
    places := sema_ownership_places_from_expr_in_state(source_expr, scopes, &state)
    if places.len() == 0 -> return false
    key :: sema_ownership_carrier_key(scopes, carrier, carrier_span) ?? return false
    loop index in 0..<state.views.len() {
        if state.views[index].carrier_key == key && state.views[index].active -> state.views[index].active = false
    }
    valid := true
    loop source in places {
        place := sema_ownership_place_snapshot(source)
        &place.projections.push("[fresh]")
        &place.typed_projections.push(SemaOwnershipProjection.Fresh{span: proof_span})
        if !sema_ownership_record_view_fact_inner(&state, carrier, carrier_span, place, output_path, access, scopes, -1) -> valid = false
    }
    valid
}

pub fn sema_ownership_invalidate_view_owner(state: &SemaOwnershipState, owner: SemaOwnershipPlace, verb: String, span: Span) Never! {
    if owner.root_key == "" -> return
    loop index in 0..<state.views.len() {
        if state.views[index].active && !state.views[index].invalidated && state.views[index].source.root_key == owner.root_key {
            state.views[index].invalidated = true
            state.views[index].invalidated_span = span
            state.views[index].invalidated_verb = verb
        }
    }
}

fn sema_ownership_view_source_projection(projection: SemaOwnershipProjection) -> ViewSourceProjection? {
    if projection == {
        .Field(name, _) -> Val(ViewSourceProjection.Field{name: name})
        .Index(_, _) -> Val(ViewSourceProjection.Index)
        .Range(_, _, _) -> Val(ViewSourceProjection.Range)
        .Fresh(_) | .Deref(_) -> None
    }
}

fn sema_ownership_view_source_for_place(place: SemaOwnershipPlace, receiver_key: String, parameter_keys: [String], scopes: SemaScopeTable) -> ViewSourcePath? {
    loop binding in scopes.bindings {
        if binding.symbol.id.key == place.root_key {
            source := ViewSource?{None}
            if {
                receiver_key != "" && receiver_key == place.root_key -> source = Val(ViewSource.Receiver)
                else -> {
                    loop (parameter_index, parameter_key) in parameter_keys {
                        if parameter_key == place.root_key {
                            source = Val(ViewSource.Parameter{index: parameter_index})
                            break
                        }
                    }
                }
            }
            actual_source :: source ?? return None
            if place.typed_projections.len() != place.projections.len() -> return None
            projections := [ViewSourceProjection]{}
            loop projection in place.typed_projections {
                converted :: sema_ownership_view_source_projection(projection) ?? return None
                &projections.push(converted)
            }
            return Val(ViewSourcePath{source: actual_source, projections: projections})
        }
    }
    None
}

fn sema_ownership_view_source_equal(left: ViewSource, right: ViewSource) -> Bool Never! {
    if left == {
        .Receiver -> if right == {.Receiver -> true else -> false}
        .Parameter(index) -> if right == {.Parameter(other) -> index == other else -> false}
        .Static(module_path, name) -> if right == {.Static(other_module, other_name) -> module_path == other_module && name == other_name else -> false}
    }
}

fn sema_ownership_view_projection_equal(left: ViewSourceProjection, right: ViewSourceProjection) -> Bool Never! {
    if left == {
        .Field(name) -> if right == {.Field(other) -> name == other else -> false}
        .Index -> if right == {.Index -> true else -> false}
        .Range -> if right == {.Range -> true else -> false}
    }
}

fn sema_ownership_view_source_path_equal(left: ViewSourcePath, right: ViewSourcePath) -> Bool Never! {
    if !sema_ownership_view_source_equal(left.source, right.source) -> return false
    if left.projections.len() != right.projections.len() -> return false
    loop (index, projection) in left.projections {
        if !sema_ownership_view_projection_equal(projection, right.projections[index]) -> return false
    }
    true
}

fn sema_ownership_view_slot_equal(left: [String], right: [String]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop (index, segment) in left {
        if segment != right[index] -> return false
    }
    true
}

fn sema_ownership_string_list_snapshot(source: [String]) -> [String] Never! {
    result := [String]{}
    loop segment in source -> &result.push(segment)
    result
}

fn sema_ownership_diag_view_return_owner(place: SemaOwnershipPlace, span: Span) -> Diagnostic {
    owner := sema_ownership_place_name(place)
    sema_error("E2305", span, "this view points into `{owner}`, which this function owns", "`{owner}` is made here and freed when the function returns, so a read window into it would outlive what owns it — there'd be nothing left to look at", "return an owned copy with `~place` (for example `~value[a..b]`), or accept the source as a parameter so the caller keeps owning it")
}

fn sema_ownership_diag_view_return_boundary(span: Span) -> Diagnostic {
    sema_error("E2305", span, "returned views need a stable owner relationship", "each public `View`/`ViewMut` slot must name a bounded set of receiver, parameter, or static sources that stay live; this return did not prove those sources", "return a view derived from parameters or the receiver on every path, keep the view local, or return an owned copy with `~`")
}

// Rust `consumed_view_owner` (#4392): a `^` parameter (or `^self`) moves into
// this function and is freed when it returns, so it cannot own a returned
// view. A consumed view carrier differs: its windows still borrow the
// caller's owner.
fn sema_ownership_consumed_view_owner(place: SemaOwnershipPlace, scopes: SemaScopeTable) -> Bool Never! {
    loop binding in scopes.bindings {
        if binding.symbol.id.key != place.root_key -> next
        if binding.access != AccessConvention.Move -> return false
        ty :: binding.symbol.ty ?? return true
        if ty == {
            .Apply(name, args) -> return !((name == "View" || name == "ViewMut") && args.len() == 1)
            else -> return true
        }
    }
    false
}

fn sema_ownership_diag_view_return_consumed(place: SemaOwnershipPlace, span: Span) -> Diagnostic {
    owner := sema_ownership_place_name(place)
    sema_error("E2305", span, "this view points into `{owner}`, which this function consumes", "`^{owner}` moves the value into this function, which frees it when it returns, so a returned window into it would outlive its owner", "take `{owner}` as a read or `&` parameter so the caller keeps owning it, or return an owned copy with `~`")
}

fn sema_ownership_place_has_fresh_projection(place: SemaOwnershipPlace) -> Bool Never! {
    loop projection in place.typed_projections {
        if projection == {
            .Fresh(_) -> return true
            else -> {}
        }
    }
    false
}

fn sema_ownership_diag_view_return_access(span: Span) -> Diagnostic {
    sema_error("E2305", span, "returned view paths disagree about read or write access", "one public output slot cannot sometimes be a read view and sometimes be an exclusive write view", "return the same view access on every path")
}

pub fn sema_ownership_record_view_return(state: &SemaOwnershipState, place: SemaOwnershipPlace, access: AccessConvention, output_path: [String], receiver_key: String, parameter_keys: [String], scopes: SemaScopeTable, provenance: &ViewProvenanceMap, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if sema_ownership_place_has_fresh_projection(place) {
        &diagnostics.push(sema_ownership_diag_view_return_boundary(span))
        return false
    }
    source_path :: sema_ownership_view_source_for_place(place, receiver_key, parameter_keys, scopes) ?? {
        &diagnostics.push(sema_ownership_diag_view_return_owner(place, span))
        return false
    }
    if sema_ownership_consumed_view_owner(place, scopes) {
        &diagnostics.push(sema_ownership_diag_view_return_consumed(place, span))
        return false
    }
    mutable := access == AccessConvention.Write
    loop entry_index in 0..<provenance.entries.len() {
        entry :: provenance.entries[entry_index]
        if sema_ownership_view_slot_equal(entry.slot, output_path) {
            if entry.value.mutable != mutable {
                &diagnostics.push(sema_ownership_diag_view_return_access(span))
                return false
            }
            loop existing_source in entry.value.sources {
                if sema_ownership_view_source_path_equal(existing_source, source_path) -> return true
            }
            &provenance.entries[entry_index].value.sources.push(source_path)
            return true
        }
    }
    sources := [ViewSourcePath]{}
    &sources.push(source_path)
    &provenance.entries.push(ViewProvenanceEntry{
        slot: sema_ownership_string_list_snapshot(output_path),
        value: ViewProvenance{sources: sources, mutable: mutable},
    })
    true
}

pub fn sema_ownership_record_view_returns(state: &SemaOwnershipState, places: [SemaOwnershipPlace], access: AccessConvention, output_path: [String], receiver_key: String, parameter_keys: [String], scopes: SemaScopeTable, provenance: &ViewProvenanceMap, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if places.len() == 0 {
        &diagnostics.push(sema_ownership_diag_view_return_boundary(span))
        return false
    }
    loop place in places {
        if sema_ownership_view_source_for_place(place, receiver_key, parameter_keys, scopes) == None {
            if {
                sema_ownership_place_has_fresh_projection(place) -> &diagnostics.push(sema_ownership_diag_view_return_boundary(span))
                else -> &diagnostics.push(sema_ownership_diag_view_return_owner(place, span))
            }
            return false
        }
    }
    mutable := access == AccessConvention.Write
    loop entry in provenance.entries {
        if sema_ownership_view_slot_equal(entry.slot, output_path) && entry.value.mutable != mutable {
            &diagnostics.push(sema_ownership_diag_view_return_access(span))
            return false
        }
    }
    loop place in places {
        if !sema_ownership_record_view_return(&state, place, access, output_path, receiver_key, parameter_keys, scopes, &provenance, span, &diagnostics) -> return false
    }
    true
}

fn sema_ownership_diag_live_reference(place: String, span: Span) -> Diagnostic {
    sema_error("E0212", span, "`{place}` already has a live reference that conflicts with this access", "an exclusive write window cannot overlap another live reference to the same place", "finish using the earlier reference before opening this one")
}

// Rust `check_place_change`: changing a place a live view looks into. A pin
// promises its storage keeps its address, so it reports E0219 with the change
// it forbids; every other view keeps the general E0212.
fn sema_ownership_diag_view_change(fact: SemaOwnershipViewFact, changed: SemaOwnershipPlace, action: String, span: Span, scopes: SemaScopeTable) -> Diagnostic {
    changed_name :: sema_ownership_place_name(changed)
    if action == "" || !sema_pin_view_fact(fact, scopes) -> return sema_ownership_diag_live_reference(changed_name, span)
    sema_error("E0219", span, "`{changed_name}` cannot {action} while it is pinned", "`{fact.carrier}` pinned `{sema_ownership_place_name(fact.source)}`, which promises that storage keeps its address; moving or replacing it would leave every stored address pointing at the old place", "finish using `{fact.carrier}` before changing `{changed_name}`, or narrow the pin's scope")
}

// Rust `check_place_read` (card #1361 / I2): reading a place beside a live
// exclusive window into it is E0220; reading through the window is the
// legal path.
fn sema_ownership_diag_owner_read(fact: SemaOwnershipViewFact, read: SemaOwnershipPlace, span: Span, scopes: SemaScopeTable) -> Diagnostic {
    read_name :: sema_ownership_place_name(read)
    view :: fact.carrier
    window :: if sema_pin_view_fact(fact, scopes) -> "pin" else -> "exclusive write window"
    sema_error("E0220", span, "`{read_name}` cannot be read while `{view}` has a live {window} into it", "`{view}` is an exclusive window into `{sema_ownership_place_name(fact.source)}`; reading the owner beside that window would be rejected after lowering", "read or edit through `{view}` instead of `{read_name}`")
}

// The E0220 check on one complete place expression, before its base is read.
pub fn sema_ownership_check_owner_read(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    loop place in sema_ownership_places_from_expr_in_state(expr, scopes, &state) {
        if sema_ownership_conflicting_view_for_expr(&state, place, AccessConvention.Read, expr, scopes) == .Val(fact) {
            &diagnostics.push(sema_ownership_diag_owner_read(fact, place, expr_span(expr), scopes))
            return false
        }
    }
    true
}

// Registry-backed view inference calls this hook after it has proved the
// returned place.  Ownership stores the window and enforces overlap; it does
// not infer view kinds or invent a second type relation.
pub fn sema_ownership_open_reference(state: &SemaOwnershipState, place: SemaOwnershipPlace, access: AccessConvention, span: Span, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if access == AccessConvention.Write && sema_ownership_place_is_static(place, scopes) {
        sema_ownership_report_static_write(&state, place, span, &diagnostics)
        return false
    }
    if sema_ownership_active_view_conflict(&state, place, access) {
        &diagnostics.push(sema_ownership_diag_live_reference(sema_ownership_place_name(place), span))
        return false
    }
    conflict :: sema_ownership_active_loan_conflict(&state, place, access)
    if conflict != None {
        &diagnostics.push(sema_ownership_diag_live_reference(sema_ownership_place_name(place), span))
        return false
    }
    loan_seq := sema_ownership_next_sequence(&state)
    &state.loans.push(SemaOwnershipLoan{place: place, access: access, span: span, scope_depth: state.scope_depth, seq: loan_seq, carrier_fact_seq: -1, carrier_key: ""})
    kind :: if access == AccessConvention.Write -> SemaOwnershipReferenceKind.Write else -> SemaOwnershipReferenceKind.Read
    sema_ownership_note_reference(&state, place.root, span, scopes, kind)
    true
}

pub fn sema_ownership_open_reference_for_expr(state: &SemaOwnershipState, expr: Expr, access: AccessConvention, span: Span, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if sema_ownership_report_invalidated_view(&state, expr, scopes, span, &diagnostics) -> return false
    places := sema_ownership_places_from_expr_in_state(expr, scopes, &state)
    if places.len() == 0 -> return false
    loop place in places {
        if access == AccessConvention.Write && sema_ownership_place_is_static(place, scopes) {
            sema_ownership_report_static_write(&state, place, expr_span(expr), &diagnostics)
            return false
        }
        if sema_ownership_active_view_conflict_for_expr(&state, place, access, expr, scopes) {
            &diagnostics.push(sema_ownership_diag_live_reference(sema_ownership_place_name(place), span))
            return false
        }
        conflict :: sema_ownership_active_loan_conflict_for_expr(&state, place, access, expr, scopes)
        if conflict != None {
            &diagnostics.push(sema_ownership_diag_live_reference(sema_ownership_place_name(place), span))
            return false
        }
    }
    kind :: if access == AccessConvention.Write -> SemaOwnershipReferenceKind.Write else -> SemaOwnershipReferenceKind.Read
    index := 0
    loop index < places.len() {
        place := places[index]
        if !sema_ownership_exact_view_carrier_for_place(&state, expr, place, scopes) {
            loan_seq := sema_ownership_next_sequence(&state)
            &state.loans.push(SemaOwnershipLoan{place: place, access: access, span: span, scope_depth: state.scope_depth, seq: loan_seq, carrier_fact_seq: -1, carrier_key: ""})
        }
        sema_ownership_note_place_reference(&state, expr, place, span, scopes, kind)
        index += 1
    }
    true
}

// Open a mutable place window in one ownership transaction.  This is distinct
// from check_write: a write borrow keeps a live loan until its lexical scope
pub fn sema_ownership_open_write_reference(state: &SemaOwnershipState, expr: Expr, span: Span, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if sema_ownership_report_invalidated_view(&state, expr, scopes, span, &diagnostics) -> return false
    places := sema_ownership_places_from_expr_in_state(expr, scopes, &state)
    if places.len() == 0 {
        &diagnostics.push(sema_error("E0202", span, "the write-access marker `&` needs a place after it", "write access can only be granted to stable storage, not a temporary expression", "bind the value first, then borrow the binding with `&`"))
        return false
    }
    display :: places[0]
    loop place in places {
        if sema_ownership_place_is_static(place, scopes) {
            sema_ownership_report_static_write(&state, place, expr_span(expr), &diagnostics)
            return false
        }
        if sema_ownership_active_view_conflict_for_expr(&state, place, AccessConvention.Write, expr, scopes) {
            &diagnostics.push(sema_ownership_diag_live_reference(sema_ownership_place_name(place), span))
            return false
        }
        conflict :: sema_ownership_active_loan_conflict_for_expr(&state, place, AccessConvention.Write, expr, scopes)
        if conflict != None {
            &diagnostics.push(sema_ownership_diag_live_reference(sema_ownership_place_name(place), span))
            return false
        }
    }
    has_view := sema_ownership_view_exists_for_expr(&state, expr, scopes)
    if has_view && sema_ownership_view_has_access(&state, expr, scopes, AccessConvention.Read) {
        &diagnostics.push(sema_error("E0205", span, "cannot edit through `{display.root}` — it has read access only", "a read window may inspect its place, but it cannot change the owner", "take a write window from a mutable owner instead"))
        return false
    }
    binding :: sema_ownership_binding_for_expr(&state, expr, scopes) ?? return false
    info :: binding
    if sema_ownership_writes_read_shared_guard(expr, scopes) {
        &diagnostics.push(sema_ownership_diag_read_shared_guard_write(span))
        return false
    }
    if !has_view && !info.mutable && info.access != AccessConvention.Write && !sema_ownership_binding_is_edit_shared_guard(info) {
        // Rust `validate_write_place`: a parameter is E0205, a local E0202.
        if info.symbol.kind == SymbolKind.Parameter {
            param_type :: type_name(info.symbol.ty ?? Type.Named{name: "Unit"})
            &diagnostics.push(sema_error("E0205", span, "cannot take a write window into `{display.root}`", "an unmarked parameter gives read access only; a write window needs the write-access marker `&`", "change the parameter to `{display.root}: &{param_type}` with the write-access marker `&`"))
        } else {
            &diagnostics.push(sema_error("E0202", span, "cannot take a write window into `{display.root}`", "a write window can change its owner, so the owner must be mutable", "declare `{display.root} := ...`"))
        }
        return false
    }
    index := 0
    loop index < places.len() {
        place := places[index]
        if !sema_ownership_exact_write_carrier(&state, expr, place, scopes) {
            loan_seq := sema_ownership_next_sequence(&state)
            &state.loans.push(SemaOwnershipLoan{place: place, access: AccessConvention.Write, span: span, scope_depth: state.scope_depth, seq: loan_seq, carrier_fact_seq: -1, carrier_key: ""})
        }
        sema_ownership_note_place_reference(&state, expr, place, span, scopes, SemaOwnershipReferenceKind.Write)
        index += 1
    }
    true
}

pub fn sema_ownership_close_reference(state: &SemaOwnershipState, place: SemaOwnershipPlace) Never! {
    remaining :: loop loan in state.loans if !sema_ownership_places_overlap(loan.place, place) -> loan
    state.loans = remaining
}

fn sema_ownership_place_moved(state: &SemaOwnershipState, place: SemaOwnershipPlace) -> SemaOwnershipMovedPlace? {
    loop moved in state.moved {
        if sema_ownership_places_overlap(moved.place, place) -> return Val(moved)
    }
    None
}

// D-COPY-DEFAULT1=A: an unmarked move site that a later use reached checks
// as the copy `~name`, so the source stays usable.
pub fn sema_ownership_is_share_site(state: SemaOwnershipState, span: Span) -> Bool Never! {
    loop site in state.share_known {
        if sema_ownership_span_same(site, span) -> return true
    }
    false
}

// D-COPY-DEFAULT1=A: only a whole binding moved by its plain name, whose
// type is not known to refuse a copy, can later become a share. The
// function check confirms the copy against the registry before using it.
pub fn sema_ownership_move_origin(expr: Expr, places: [SemaOwnershipPlace], ty: Type, consumer: String, unmarked: Bool) -> SemaOwnershipMoveOrigin {
    whole_name := places.len() == 1 && places[0].projections.len() == 0
    plain_name := if expr == {
        .Ident(_, _) -> true
        else -> false
    }
    share_ty :: if unmarked && whole_name && plain_name && sema_ownership_type_cloneable(ty) != (Val(false)) -> Val(ty) else -> None
    SemaOwnershipMoveOrigin{span: expr_span(expr), consumer: consumer, share_ty: share_ty}
}

// A use after a move stays E0121 in this check. When the move was
// unmarked, the use also records the move site, so the next check of the
// function treats that site as a share and this use is valid.
pub fn sema_ownership_report_moved(state: &SemaOwnershipState, place: SemaOwnershipPlace, moved: SemaOwnershipMovedPlace, span: Span, diagnostics: &[Diagnostic]) {
    if moved.origin.share_ty == .Val(ty) -> sema_ownership_note_share_found(&state, SemaOwnershipShareSite{span: moved.origin.span, ty: ty})
    &diagnostics.push(sema_ownership_diag_moved(sema_ownership_place_name(place), moved.origin, span))
}

fn sema_ownership_note_share_found(state: &SemaOwnershipState, found: SemaOwnershipShareSite) Never! {
    loop site in state.share_found {
        if sema_ownership_span_same(site.span, found.span) -> return
    }
    &state.share_found.push(found)
}

// D-COPY-DEFAULT1=A: a share site found on a branch path is found for the
// function even when that path's check stops early (its E0121 is the reason
// it stopped) or never reaches the join; the next pass treats it as a share.
pub fn sema_ownership_keep_share_found(state: &SemaOwnershipState, branch: SemaOwnershipState) Never! {
    loop site in branch.share_found -> sema_ownership_note_share_found(&state, site)
}

// E0121 names the consumer every move recorder supplies and points a labelled
// caret at the move site, so the reader sees both where the value went and
// the later use. The reuse stays the primary span.
fn sema_ownership_diag_moved(place: String, origin: SemaOwnershipMoveOrigin, span: Span) -> Diagnostic {
    consumer :: origin.consumer
    same_site :: origin.span.start == span.start && origin.span.end == span.end
    label :: if same_site -> "`{place}` moved to {consumer} here on an earlier loop iteration" else -> "`{place}` moved to {consumer} here"
    diagnostic :: sema_error(
        "E0121",
        span,
        "`{place}` was consumed by {consumer}, so it can't be used here",
        "After a value moves somewhere else, its old name no longer gives access to it",
        "Stop using `{place}` after the move, or give {consumer} a copy with `~{place}` where it moved.",
    )
    diagnostic_with_label(^diagnostic, origin.span, label)
}

fn sema_ownership_diag_alias(place: String, write: Bool, span: Span) -> Diagnostic {
    if {
        write -> sema_error("E0204", span, "`{place}` is already shared in this call, so it can't be changed here", "while something is being looked at, nobody else may be changing it", "drop the extra use of `{place}`, or copy first with `~{place}`")
        else -> sema_error("E0204", span, "`{place}` is being changed in this call, so it can't be used again here", "while something is being changed through the write-access marker `&`, nobody else may be looking at it", "pass the write-access marker `&` only once, or copy first with `~{place}`")
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Move and write capability proofs

fn sema_ownership_view_fact_matches_expr(fact: SemaOwnershipViewFact, expr: Expr, scopes: SemaScopeTable) -> Bool {
    output_path := [String]{}
    root :: sema_ownership_named_view_root(expr, &output_path) ?? return false
    index :: sema_scope_resolve_index_at(scopes, root, expr_span(expr)) ?? return false
    scopes.bindings[index].symbol.id.key == fact.carrier_key && sema_ownership_path_starts(output_path, fact.output_path)
}

fn sema_ownership_view_fact_exact_expr(fact: SemaOwnershipViewFact, expr: Expr, scopes: SemaScopeTable) -> Bool {
    output_path := [String]{}
    root :: sema_ownership_named_view_root(expr, &output_path) ?? return false
    index :: sema_scope_resolve_index_at(scopes, root, expr_span(expr)) ?? return false
    if scopes.bindings[index].symbol.id.key != fact.carrier_key || output_path.len() != fact.output_path.len() -> return false
    sema_ownership_path_starts(output_path, fact.output_path)
}

fn sema_ownership_exact_view_carrier_for_place(state: &SemaOwnershipState, expr: Expr, place: SemaOwnershipPlace, scopes: SemaScopeTable) -> Bool {
    loop fact in state.views {
        if fact.active && !fact.invalidated && sema_ownership_view_fact_exact_expr(fact, expr, scopes) && sema_ownership_place_exact(fact.source, place) -> return true
    }
    false
}

fn sema_ownership_diag_invalidated_view(fact: SemaOwnershipViewFact, span: Span) -> Diagnostic {
    owner :: sema_ownership_place_name(fact.source)
    verb :: if fact.invalidated_verb == "" -> "operation" else -> fact.invalidated_verb
    sema_error("E0632", span, "`{owner}` was {verb} here, so the value `{fact.carrier}` points into is gone", "`{fact.carrier}` is a view into `{owner}`; `{owner}.{verb}()` invalidated everything stored in `{owner}`, so reading `{fact.carrier}` now would read freed memory", "use `{fact.carrier}` before `{owner}.{verb}()`, or re-`alloc` after the {verb} to get a fresh value")
}

pub fn sema_ownership_report_invalidated_view(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    output_path := [String]{}
    root :: sema_ownership_named_view_root(expr, &output_path) ?? return false
    binding_index :: sema_scope_resolve_index_at(scopes, root, expr_span(expr)) ?? return false
    carrier_key :: scopes.bindings[binding_index].symbol.id.key
    index := state.views.len() - 1
    loop index >= 0 {
        fact :: state.views[index]
        if fact.active && fact.carrier_key == carrier_key && sema_ownership_path_starts(output_path, fact.output_path) && fact.invalidated {
            &diagnostics.push(sema_ownership_diag_invalidated_view(fact, span))
            return true
        }
        index -= 1
    }
    false
}

fn sema_ownership_place_exact(left: SemaOwnershipPlace, right: SemaOwnershipPlace) -> Bool Never! {
    if left.root_key == "" || right.root_key == "" || left.root_key != right.root_key -> return false
    if left.projections.len() != right.projections.len() -> return false
    if left.typed_projections.len() != left.projections.len() || right.typed_projections.len() != right.projections.len() -> return false
    loop (index, projection) in left.typed_projections {
        if !sema_ownership_typed_projection_exact(projection, right.typed_projections[index]) -> return false
    }
    true
}

fn sema_ownership_place_extends(base: SemaOwnershipPlace, candidate: SemaOwnershipPlace) -> Bool Never! {
    if base.root_key == "" || candidate.root_key == "" || base.root_key != candidate.root_key -> return false
    if base.projections.len() > candidate.projections.len() -> return false
    if base.typed_projections.len() != base.projections.len() || candidate.typed_projections.len() != candidate.projections.len() -> return false
    loop (index, projection) in base.typed_projections {
        if !sema_ownership_typed_projection_exact(projection, candidate.typed_projections[index]) -> return false
    }
    true
}

fn sema_ownership_exact_write_carrier(state: &SemaOwnershipState, expr: Expr, place: SemaOwnershipPlace, scopes: SemaScopeTable) -> Bool {
    loop fact in state.views {
        if fact.active && !fact.invalidated && sema_ownership_view_fact_matches_expr(fact, expr, scopes) && fact.access == AccessConvention.Write && sema_ownership_place_extends(fact.source, place) -> return true
    }
    false
}

fn sema_ownership_view_has_access(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, access: AccessConvention) -> Bool {
    loop fact in state.views {
        if fact.active && sema_ownership_view_fact_matches_expr(fact, expr, scopes) && fact.access == access -> return true
    }
    false
}

fn sema_ownership_view_exists_for_expr(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable) -> Bool {
    loop view in state.views {
        if view.active && sema_ownership_view_fact_matches_expr(view, expr, scopes) -> return true
    }
    false
}

pub fn sema_ownership_check_use(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if sema_ownership_report_invalidated_view(&state, expr, scopes, expr_span(expr), &diagnostics) -> return false
    places := sema_ownership_places_from_expr_in_state(expr, scopes, &state)
    if places.len() == 0 -> return true
    loop place in places {
        if sema_ownership_place_moved(&state, place) == .Val(origin) {
            sema_ownership_report_moved(&state, place, origin, expr_span(expr), &diagnostics)
            return false
        }
        if sema_ownership_conflicting_view_for_expr(&state, place, AccessConvention.Read, expr, scopes) == .Val(fact) {
            &diagnostics.push(sema_ownership_diag_owner_read(fact, place, expr_span(expr), scopes))
            return false
        }
        conflict :: sema_ownership_active_loan_conflict_for_expr(&state, place, AccessConvention.Read, expr, scopes)
        if conflict != None {
            &diagnostics.push(sema_ownership_diag_alias(sema_ownership_place_name(place), false, expr_span(expr)))
            return false
        }
    }
    true
}

// Rust `reject_moved_expr_use` on a complete projected place (`state.x`):
// a move of the place, of a part of it, or of an owner it lies in is a use
// after move. Read windows and loans are judged by the caller's own checks.
pub fn sema_ownership_check_moved_place_use(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    loop place in sema_ownership_places_from_expr_in_state(expr, scopes, &state) {
        if sema_ownership_place_moved(&state, place) == .Val(origin) {
            sema_ownership_report_moved(&state, place, origin, expr_span(expr), &diagnostics)
            return false
        }
    }
    true
}

// Rust `reject_moved_expr_use` under `suppress_partial_move_root_read`: a
// bare name that is only the base of a deeper place (`state` in `state.x`,
// `s` in `&s`) answers for a move of the whole name alone. The complete
// place carries the partial-move, window, and loan checks, so a sibling of a
// moved field and the place a `&` window opens on stay readable here.
pub fn sema_ownership_check_root_base_use(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if sema_ownership_report_invalidated_view(&state, expr, scopes, expr_span(expr), &diagnostics) -> return false
    loop place in sema_ownership_places_from_expr_in_state(expr, scopes, &state) {
        if sema_ownership_place_moved_exactly(state, place) == .Val(origin) {
            sema_ownership_report_moved(&state, place, origin, expr_span(expr), &diagnostics)
            return false
        }
    }
    true
}

fn sema_ownership_place_moved_exactly(state: SemaOwnershipState, place: SemaOwnershipPlace) -> SemaOwnershipMovedPlace? {
    loop moved in state.moved {
        if sema_ownership_place_exact(moved.place, place) -> return Val(moved)
    }
    None
}

fn sema_ownership_active_loan_conflict(state: &SemaOwnershipState, place: SemaOwnershipPlace, access: AccessConvention) -> SemaOwnershipLoan? {
    loop loan in state.loans {
        if sema_ownership_places_overlap(loan.place, place) {
            if access == AccessConvention.Move || loan.access == AccessConvention.Write || access == AccessConvention.Write -> return Val(loan)
        }
    }
    None
}

fn sema_ownership_carrier_loan_exempt(state: &SemaOwnershipState, expr: Expr, place: SemaOwnershipPlace, loan: SemaOwnershipLoan, scopes: SemaScopeTable) -> Bool {
    if loan.access != AccessConvention.Write -> return false
    loop fact in state.views {
        if fact.active && !fact.invalidated && sema_ownership_view_fact_matches_expr(fact, expr, scopes) && fact.access == AccessConvention.Write && fact.loan_seq >= 0 && loan.seq == fact.loan_seq && sema_ownership_span_same(loan.span, fact.loan_span) && loan.carrier_fact_seq == fact.seq && loan.carrier_key == fact.carrier_key && sema_ownership_place_exact(loan.place, fact.source) && sema_ownership_place_extends(fact.source, place) -> return true
    }
    false
}

fn sema_ownership_active_view_conflict(state: &SemaOwnershipState, place: SemaOwnershipPlace, access: AccessConvention) -> Bool Never! {
    loop fact in state.views {
        if fact.active && !fact.invalidated && sema_ownership_places_overlap(fact.source, place) && (fact.access == AccessConvention.Write || access == AccessConvention.Write) -> return true
    }
    false
}

fn sema_ownership_conflicting_view_for_expr(state: &SemaOwnershipState, place: SemaOwnershipPlace, access: AccessConvention, expr: Expr, scopes: SemaScopeTable) -> SemaOwnershipViewFact? {
    loop fact in state.views {
        same_carrier :: sema_ownership_view_fact_matches_expr(fact, expr, scopes) && sema_ownership_place_extends(fact.source, place)
        if fact.active && !fact.invalidated && !same_carrier && sema_ownership_places_overlap(fact.source, place) && (fact.access == AccessConvention.Write || access == AccessConvention.Write) -> return Val(fact)
    }
    None
}

fn sema_ownership_active_view_conflict_for_expr(state: &SemaOwnershipState, place: SemaOwnershipPlace, access: AccessConvention, expr: Expr, scopes: SemaScopeTable) -> Bool {
    sema_ownership_conflicting_view_for_expr(&state, place, access, expr, scopes) != None
}

fn sema_ownership_active_loan_conflict_for_expr(state: &SemaOwnershipState, place: SemaOwnershipPlace, access: AccessConvention, expr: Expr, scopes: SemaScopeTable) -> SemaOwnershipLoan? {
    loop loan in state.loans {
        if sema_ownership_places_overlap(loan.place, place) {
            conflicts :: access == AccessConvention.Move || loan.access == AccessConvention.Write || access == AccessConvention.Write
            if conflicts {
                if sema_ownership_carrier_loan_exempt(&state, expr, place, loan, scopes) -> next
                return Val(loan)
            }
        }
    }
    None
}

fn sema_ownership_binding_for_expr(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable) -> SemaScopeBinding? {
    output_path := [String]{}
    root :: sema_ownership_named_view_root(expr, &output_path) ?? return None
    index :: sema_scope_resolve_index_at(scopes, root, expr_span(expr)) ?? return None
    Val(scopes.bindings[index])
}

fn sema_ownership_place_is_static(place: SemaOwnershipPlace, scopes: SemaScopeTable) -> Bool Never! {
    loop binding in scopes.bindings {
        if binding.symbol.id.key == place.root_key -> return binding.symbol.kind == SymbolKind.Constant
    }
    false
}

// `capability` adds the mutability gate on the place's root binding. Without
// it only the change checks run: Rust `check_write_arg_change` for a `&`
// argument to a parameter that does not edit, and `record_call_receiver_access`
// for a handle receiver that writes through the handle.
fn sema_ownership_write_capability(state: &SemaOwnershipState, expr: Expr, action: String, capability: Bool, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if sema_ownership_report_invalidated_view(&state, expr, scopes, expr_span(expr), &diagnostics) -> return false
    places := sema_ownership_places_from_expr_in_state(expr, scopes, &state)
    if places.len() == 0 {
        &diagnostics.push(sema_error("E0202", expr_span(expr), "the write-access marker `&` needs a place after it", "write access can only be granted to stable storage, not a temporary expression", "bind the value first, then pass the binding with `&`"))
        return false
    }
    display :: places[0]
    loop place in places {
        if sema_ownership_place_is_static(place, scopes) {
            // Rust's assignment path has no static-borrow check; keep E0202.
            if action == "be assigned" {
                &diagnostics.push(sema_error("E0202", expr_span(expr), "cannot take write access to a static binding", "static storage is not mutable through a borrow", "copy the value into a mutable local before taking `&`"))
            } else {
                sema_ownership_report_static_write(&state, place, expr_span(expr), &diagnostics)
            }
            return false
        }
        if sema_ownership_conflicting_view_for_expr(&state, place, AccessConvention.Write, expr, scopes) == .Val(fact) {
            &diagnostics.push(sema_ownership_diag_view_change(fact, place, action, expr_span(expr), scopes))
            return false
        }
        conflict :: sema_ownership_active_loan_conflict_for_expr(&state, place, AccessConvention.Write, expr, scopes)
        if conflict != None {
            &diagnostics.push(sema_ownership_diag_live_reference(sema_ownership_place_name(place), expr_span(expr)))
            return false
        }
    }
    if !capability -> return true
    has_view :: sema_ownership_view_exists_for_expr(&state, expr, scopes)
    if has_view && sema_ownership_view_has_access(&state, expr, scopes, AccessConvention.Read) {
        &diagnostics.push(sema_error("E0205", expr_span(expr), "cannot edit through `{display.root}` — it has read access only", "a read window may inspect its place, but it cannot change the owner", "take a write window from a mutable owner instead"))
        return false
    }
    binding :: sema_ownership_binding_for_expr(&state, expr, scopes) ?? return false
    info :: binding
    guard_refused :: sema_ownership_writes_read_shared_guard(expr, scopes)
    if guard_refused {
        &diagnostics.push(sema_ownership_diag_read_shared_guard_write(expr_span(expr)))
        // Rust `validate_shared_guard_lvalue` runs beside an assignment's own
        // field or index capability check, so only an assignment goes on.
        if action != "be assigned" -> return false
    }
    if !has_view && !info.mutable && info.access != AccessConvention.Write && !sema_ownership_binding_is_edit_shared_guard(info) {
        if action == "be assigned" && sema_ownership_report_assignment_capability(expr, display.root, info, &diagnostics) -> return false
        if info.access == {
            .Read -> &diagnostics.push(sema_error("E0205", expr_span(expr), "cannot edit through `{display.root}` — it has read access only", "a read window may inspect its place, but it cannot change the owner", "take a write window from a mutable owner instead"))
            else -> &diagnostics.push(sema_error("E0202", expr_span(expr), "cannot take a write window into `{display.root}`", "a write window can change its owner, so the owner must be mutable", "declare `{display.root}` as a mutable binding"))
        }
        return false
    }
    !guard_refused
}

// Rust's assignment statement checks: a field write through an immutable
// root is E0205 for a parameter and a local alike; an index write is E0205
// only for a read parameter and E0202 for any other binding. False for a
// target that is neither.
fn sema_ownership_report_assignment_capability(expr: Expr, root: String, info: SemaScopeBinding, diagnostics: &[Diagnostic]) -> Bool {
    param_type :: type_name(info.symbol.ty ?? Type.Named{name: "Unit"})
    is_param :: info.symbol.kind == SymbolKind.Parameter
    if expr == {
        .Field(_, member, span) -> {
            if root == "self" {
                &diagnostics.push(sema_error("E0205", span, "cannot edit `{member}` — `self` has read access only; the write-access marker `&` is required", "editing a field requires the write-access marker `&` on the owning place", "write the receiver with the write-access marker `&`: `&self` to grant write access"))
            } else if is_param {
                &diagnostics.push(sema_error("E0205", span, "cannot edit `{member}` — `{root}` does not have the write-access marker `&`", "editing a field requires the write-access marker `&` on the owning place", "mark the parameter with the write-access marker `&`: `{root}: &{param_type}` to grant write access"))
            } else {
                &diagnostics.push(sema_error("E0205", span, "cannot edit `{member}` — `{root}` does not have the write-access marker `&`", "editing a field requires the write-access marker `&` on the owning place", "declare it with `{root} := ...` to give it write access"))
            }
            true
        }
        .Index(_, _, span, _) -> {
            what :: "cannot write to `{root}` — it does not have the write-access marker `&`"
            if is_param && info.access == AccessConvention.Read {
                &diagnostics.push(sema_error("E0205", span, what, "an unmarked parameter gives read access only; assigning into it needs the write-access marker `&`", "change the parameter to `{root}: &{param_type}` with the write-access marker `&`"))
            } else {
                &diagnostics.push(sema_error("E0202", span, what, "assigning into a collection edits it; the binding must be declared mutable", "declare `{root} := ...`"))
            }
            true
        }
        else -> false
    }
}

// `action` is Rust's change wording for a pinned place (E0219), such as
// "be assigned"; an empty action keeps the general E0212 report.
pub fn sema_ownership_check_write(state: &SemaOwnershipState, expr: Expr, action: String, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    sema_ownership_check_write_as(&state, expr, action, true, scopes, &diagnostics)
}

// A write access whose root needs no write capability (see
// `sema_ownership_write_capability`).
pub fn sema_ownership_check_write_change(state: &SemaOwnershipState, expr: Expr, action: String, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    sema_ownership_check_write_as(&state, expr, action, false, scopes, &diagnostics)
}

fn sema_ownership_check_write_as(state: &SemaOwnershipState, expr: Expr, action: String, capability: Bool, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    ok :: sema_ownership_write_capability(&state, expr, action, capability, scopes, &diagnostics)
    if ok {
        places := sema_ownership_places_from_expr_in_state(expr, scopes, &state)
        loop place in places {
            sema_ownership_clear_moved(&state, place)
            sema_ownership_note_place_reference(&state, expr, place, expr_span(expr), scopes, SemaOwnershipReferenceKind.Write)
        }
    }
    ok
}

fn sema_ownership_clear_moved(state: &SemaOwnershipState, place: SemaOwnershipPlace) Never! {
    remaining :: loop moved in state.moved if !sema_ownership_places_overlap(moved.place, place) -> moved
    state.moved = remaining
}

// An exact move: a `^` mark, a consuming call or receiver, or a capture.
// A later use stays E0121.
pub fn sema_ownership_mark_move(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, consumer: String, diagnostics: &[Diagnostic]) -> Bool {
    sema_ownership_mark_move_as(&state, expr, scopes, consumer, false, &diagnostics)
}

// D-COPY-DEFAULT1=A: an unmarked owning position (binding, assignment,
// return, field, element). A later use turns this move into a share.
pub fn sema_ownership_mark_unmarked_move(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, consumer: String, diagnostics: &[Diagnostic]) -> Bool {
    sema_ownership_mark_move_as(&state, expr, scopes, consumer, true, &diagnostics)
}

// Rust `note_move_if_direct_ident`: an unmarked owning position (binding,
// assignment, return, element) moves only a bare name, seen through
// parentheses and the `Val`/`Ok`/`Err`/tainted constructors. A field or
// element read there (`m :: parts[0]`, `x = row.width`) leaves its owner
// whole; lowering materializes the copy.
fn sema_ownership_unmarked_moves_name(expr: Expr) -> Bool Never! {
    if expr == {
        .Ident(_, _) -> true
        .Paren(inner, _) | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _) | .Tainted(inner, _, _) -> sema_ownership_unmarked_moves_name(inner)
        else -> false
    }
}

fn sema_ownership_mark_move_as(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, consumer: String, unmarked: Bool, diagnostics: &[Diagnostic]) -> Bool {
    // D-COPY-DEFAULT1=A: a share site copies; the source stays usable.
    if unmarked && sema_ownership_is_share_site(state, expr_span(expr)) -> return true
    if sema_ownership_report_invalidated_view(&state, expr, scopes, expr_span(expr), &diagnostics) -> return false
    places := sema_ownership_places_from_expr_in_state(expr, scopes, &state)
    if places.len() == 0 -> return true
    binding :: sema_ownership_binding_for_expr(&state, expr, scopes)
    if binding != None {
        info :: binding
        // Rust moves only non-Copy values: every projection of a Copy root
        // is Copy, so nothing moves and no move conflict exists. Rust
        // `note_move_if_direct_ident`: an unmarked owning position moves a
        // local only; a read or write parameter keeps its value (the binding
        // and return audits report E0120 where it would have to copy).
        root_ty :: info.symbol.ty ?? Type.Named{name: "Unit"}
        if sema_ownership_type_is_copy(root_ty) || (unmarked && sema_ownership_binding_is_borrowed_param(info)) || (unmarked && !sema_ownership_unmarked_moves_name(expr)) {
            loop place in places -> sema_ownership_note_place_reference(&state, expr, place, expr_span(expr), scopes, SemaOwnershipReferenceKind.Move)
            return true
        }
    }
    // Named windows keep ownership with their source. A borrowed parameter
    // under an exact `^` mark is refused at the mark itself (E0201); a
    // consuming call or receiver records its move like any owner.
    borrowed :: sema_ownership_view_exists_for_expr(&state, expr, scopes)
    loop place in places {
        if !unmarked && sema_ownership_reject_partial_static_move(&state, place, expr, &diagnostics) -> return false
        if sema_ownership_place_moved(&state, place) == .Val(origin) {
            sema_ownership_report_moved(&state, place, origin, expr_span(expr), &diagnostics)
            return false
        }
        if borrowed {
            &diagnostics.push(sema_error("E0201", expr_span(expr), "`{sema_ownership_place_name(place)}` cannot be moved from borrowed storage", "read and write parameters and named windows keep ownership with their source", "copy the value, or accept it with the move marker `^`"))
            return false
        }
        if sema_ownership_conflicting_view_for_expr(&state, place, AccessConvention.Move, expr, scopes) == .Val(fact) {
            &diagnostics.push(sema_ownership_diag_view_change(fact, place, "be moved", expr_span(expr), scopes))
            return false
        }
        conflict :: sema_ownership_active_loan_conflict(&state, place, AccessConvention.Move)
        if conflict != None {
            &diagnostics.push(sema_ownership_diag_live_reference(sema_ownership_place_name(place), expr_span(expr)))
            return false
        }
    }
    move_ty := Type.Named{name: "Unit"}
    if binding != None {
        info :: binding
        move_ty = info.symbol.ty ?? Type.Named{name: "Unit"}
    }
    if !sema_ownership_type_is_copy(move_ty) {
        origin := sema_ownership_move_origin(expr, places, move_ty, consumer, unmarked)
        // D-LIN1: a `#SingleUse` value keeps its exact move; it never copies.
        if sema_single_use_key(state, places[0].root_key) -> origin.share_ty = None
        loop place in places -> &state.moved.push(SemaOwnershipMovedPlace{place: place, origin: origin})
    }
    loop place in places -> sema_ownership_note_place_reference(&state, expr, place, expr_span(expr), scopes, SemaOwnershipReferenceKind.Move)
    true
}

pub fn sema_ownership_consume_expression(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, consumer: String, diagnostics: &[Diagnostic]) -> Bool {
    // D-COPY-DEFAULT1=A (#3714): `^place` is one exact move. The expression
    // check and the consuming position both reach it, so a place this very
    // mark already moved is the same move, not a use after it.
    if expr == .Place(value, access, _) {
        if access == PlaceAccess.Take {
            loop place in sema_ownership_places_from_expr_in_state(value, scopes, &state) {
                if sema_ownership_place_moved(&state, place) == .Val(moved) {
                    if moved.origin.span.start == expr_span(value).start && moved.origin.span.end == expr_span(value).end -> return true
                }
            }
            if !sema_ownership_check_expression(&state, value, scopes, &diagnostics) -> return false
            // Rust `note_exact_move` / `mark_moved_by` record a move of a
            // whole name only: `^state.items` leaves no moved fact behind.
            if sema_ownership_unmarked_moves_name(value) && sema_ownership_places_from_expr_in_state(value, scopes, &state).len() > 0 -> return sema_ownership_mark_move(&state, value, scopes, consumer, &diagnostics)
            return true
        }
    }
    if !sema_ownership_check_expression(&state, expr, scopes, &diagnostics) -> return false
    if sema_ownership_places_from_expr_in_state(expr, scopes, &state).len() > 0 -> return sema_ownership_mark_unmarked_move(&state, expr, scopes, consumer, &diagnostics)
    true
}

// ────────────────────────────────────────────────────────────────────────────
// Call access integration

// One place a call argument (or receiver) holds for the duration of the call;
// later arguments that overlap it with a write on either side conflict.
struct SemaOwnershipCallAccess {
    place: SemaOwnershipPlace
    access: AccessConvention
    span: Span
}

fn sema_ownership_call_access_conflict(accesses: [SemaOwnershipCallAccess], place: SemaOwnershipPlace, access: AccessConvention) -> Bool Never! {
    loop active in accesses {
        if sema_ownership_places_overlap(active.place, place) && (active.access == AccessConvention.Write || access == AccessConvention.Write) -> return true
    }
    false
}

fn sema_ownership_param_for_arg(params: [SemaCallParam], arg: CallArg, source_index: Int) -> SemaCallParam? {
    slot :: arg.flags.binder_slot ?? source_index
    if slot < 0 || slot >= params.len() -> return None
    Val(params[slot])
}

fn sema_ownership_call_diag_write_required(callee: String, name: String, span: Span) -> Diagnostic {
    sema_error("E0202", span, "parameter `{name}` requires the write-access marker `&` at the call site", "`{callee}` needs to edit this value with the write-access marker `&`; passing it without that marker grants only read access", "write the write-access marker `&` (`&{name}`) when calling `{callee}`")
}

// D-SHAPE-PLACE1=A: `&` grants write access to a place — a name followed by
// field, index, or range projections. Only a temporary lacks one.
fn sema_ownership_call_diag_write_place(span: Span) -> Diagnostic {
    sema_error("E0202", span, "the write-access marker `&` needs a place after it", "write access reaches only a place: a name, optionally followed by field, index, or range projections such as `buf.items[0]`; a temporary expression has no storage for the edit to land in", "bind the value first: `x := ...` then pass `&x` with the write-access marker `&`")
}

// D-SHAPE-PLACE1=A: a range window has a fixed length, while this callee may
// grow or shrink the list it receives.
fn sema_ownership_call_diag_write_range_window(span: Span) -> Diagnostic {
    sema_error("E0202", span, "a range write window can't fill a list parameter that may resize", "a range window has a fixed length, but this function may grow or shrink the list it receives through the write-access marker `&`", "pass the whole list with the write-access marker `&`: `fill(&values)`")
}

fn sema_ownership_call_diag_move_rejected(span: Span) -> Diagnostic {
    sema_error("E0203", span, "a value was passed with the move marker `^` to a parameter that does not consume", "only parameters declared with the move marker `^` accept a moved value at the call site", "remove the move marker `^`, or declare the parameter with that marker to take ownership")
}

fn sema_ownership_call_diag_clone(callee: String, name: String, span: Span) -> Diagnostic {
    sema_error("E0209", span, "implicit clone of `{name}`", "`{callee}` expects to take ownership of this value", "write the move marker `^` (`^{name}`) if this is the last use, or copy first with `~{name}`")
}

fn sema_ownership_call_diag_not_copyable(callee: String, index: Int, name: String, span: Span) -> Diagnostic {
    sema_error("E0201", span, "`{callee}` needs the move marker `^` here — this value can't be copied", "parameter {index + 1} takes ownership through the move marker `^`; passing `{name}` without that marker would have to copy it, but this type can't be copied", "write the move marker `^` (`^{name}`) to move ownership to `{callee}`")
}

fn sema_ownership_check_call_arguments_with_accesses(state: &SemaOwnershipState, callee: String, params: [SemaCallParam], args: &[CallArg], scopes: SemaScopeTable, diagnostics: &[Diagnostic], initial_accesses: ^[SemaOwnershipCallAccess], initial_accepted: Bool, initial_complete: Bool) -> SemaOwnershipCheckResult {
    accesses := initial_accesses
    accepted := initial_accepted
    complete := initial_complete
    loop index in 0..<args.len() {
        arg :: args[index]
        param :: sema_ownership_param_for_arg(params, arg, index) ?? {
            complete = false
            next
        }
        // Rust CallBinder `substitute_param_refs`: a default's reads of
        // earlier parameters name the call's own slot temporaries, never a
        // caller place, so those places take no part in the caller's checks.
        binder_names :: loop reference in arg.flags.binder_refs -> reference.name
        binder_rooted := false
        places := [SemaOwnershipPlace]{}
        loop place in sema_ownership_places_from_expr_in_state(arg.expr, scopes, &state) {
            if binder_names.contains(place.root) {
                binder_rooted = true
                next
            }
            &places.push(place)
        }
        if !binder_rooted && !sema_single_use_check_argument(state, callee, param.convention, arg.expr, scopes, &diagnostics) {
            accepted = false
            next
        }
        decision :: sema_call_argument_convention(param, arg)
        if decision == {
            .RequiresWrite -> {
                accepted = false
                &diagnostics.push(sema_ownership_call_diag_write_required(callee, sema_ownership_argument_name(arg), arg.span))
            }
            .RejectsMove -> {
                accepted = false
                &diagnostics.push(sema_ownership_call_diag_move_rejected(arg.span))
            }
            else -> {}
        }

        write_place_ok := true
        if arg.convention == AccessConvention.Write && sema_receiver_mark_place_root(arg.expr) == None {
            accepted = false
            write_place_ok = false
            &diagnostics.push(sema_ownership_call_diag_write_place(arg.span))
        }
        if arg.convention == AccessConvention.Write && write_place_ok {
            if arg.expr == {
                .Slice(_, _, _, _, _) -> if !sema_window_contains(state.fixed_length_write_params, sema_window_callee_key(callee, param.name)) {
                    accepted = false
                    write_place_ok = false
                    &diagnostics.push(sema_ownership_call_diag_write_range_window(arg.span))
                }
                else -> {}
            }
        }
        if places.len() > 0 && write_place_ok {
            loop actual in places {
                if sema_ownership_call_access_conflict(accesses, actual, arg.convention) {
                    accepted = false
                    &diagnostics.push(sema_ownership_diag_alias(sema_ownership_place_name(actual), arg.convention == AccessConvention.Write, arg.span))
                }
            }
            if !binder_rooted {
                // Rust `check_call_arguments`: only a write parameter gates the
                // argument's root on write capability; `&` toward a parameter
                // that does not edit runs the change checks alone.
                checked :: if {
                    arg.convention == AccessConvention.Write && param.convention == AccessConvention.Write -> sema_ownership_check_write(&state, arg.expr, "be passed with write access", scopes, &diagnostics)
                    arg.convention == AccessConvention.Write -> sema_ownership_check_write_change(&state, arg.expr, "be passed with write access", scopes, &diagnostics)
                    else -> sema_ownership_check_use(&state, arg.expr, scopes, &diagnostics)
                }
                if !checked -> accepted = false
            }
            if arg.convention != AccessConvention.Move || !sema_ownership_type_is_copy(param.ty ?? Type.Named{name: "Unit"}) {
                loop place in places -> &accesses.push(SemaOwnershipCallAccess{place: place, access: arg.convention, span: arg.span})
            }
        }
        mark_implicit_clone := false
        if decision == SemaCallConventionDecision.NeedsImplicitClone {
            if sema_ownership_type_is_copy(param.ty ?? Type.Named{name: "Unit"}) -> next
            // Rust `check_take_arg_ownership`: a cloneable value is E0209, any
            // other is E0201. A nominal `Clone` row is registry-owned and not
            // visible here, so an unresolved nominal takes the cloneable
            // diagnostic; both reject the unmarked owning argument.
            if {
                sema_ownership_type_cloneable(param.ty ?? Type.Named{name: "Unit"}) ?? true -> {
                    mark_implicit_clone = true
                    &diagnostics.push(sema_ownership_call_diag_clone(callee, sema_ownership_argument_name(arg), arg.span))
                }
                else -> {
                    accepted = false
                    &diagnostics.push(sema_ownership_call_diag_not_copyable(callee, index, sema_ownership_argument_name(arg), arg.span))
                }
            }
        }
        if param.convention == AccessConvention.Move && arg.convention == AccessConvention.Move && !binder_rooted && sema_ownership_unmarked_moves_name(arg.expr) {
            if !sema_ownership_mark_move(&state, arg.expr, scopes, "`{callee}`", &diagnostics) -> accepted = false
        }
        if mark_implicit_clone -> args[index].flags.implicit_clone = true
    }
    SemaOwnershipCheckResult{accepted: accepted, complete: complete}
}

pub fn sema_ownership_check_call_arguments(state: &SemaOwnershipState, callee: String, params: [SemaCallParam], args: &[CallArg], scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaOwnershipCheckResult {
    sema_ownership_check_call_arguments_with_accesses(&state, callee, params, &args, scopes, &diagnostics, [SemaOwnershipCallAccess]{}, true, true)
}

fn sema_ownership_argument_name(arg: CallArg) -> String Never! {
    if arg.expr == {
        .Ident(name, _) -> name
        else -> "this value"
    }
}

// The small receiver hook is separate because method resolution owns the
// receiver convention.  It reserves the receiver only for the duration of a
// call and therefore cannot leak a Rust-style borrow into later statements.
pub fn sema_ownership_check_call_receiver(state: &SemaOwnershipState, receiver: Expr, convention: AccessConvention, scopes: SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    sema_ownership_check_call_receiver_as(&state, receiver, convention, true, scopes, span, &diagnostics)
}

fn sema_ownership_check_call_receiver_as(state: &SemaOwnershipState, receiver: Expr, convention: AccessConvention, capability: Bool, scopes: SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    sema_receiver_mark_note(&state, receiver, convention)
    places :: sema_ownership_places_from_expr_in_state(receiver, scopes, &state)
    if places.len() == 0 {
        if convention == AccessConvention.Write {
            &diagnostics.push(sema_error("E0202", span, "the write-access marker `&` needs a place after it", "write access can only be granted to stable storage, not a temporary expression", "bind the value first, then pass the binding with `&`"))
            return false
        }
        return true
    }
    if convention == {
        .Write -> if capability -> sema_ownership_check_write(&state, receiver, "", scopes, &diagnostics) else -> sema_ownership_check_write_change(&state, receiver, "", scopes, &diagnostics)
        .Move -> sema_ownership_mark_move(&state, receiver, scopes, "a consuming method call", &diagnostics)
        else -> sema_ownership_check_use(&state, receiver, scopes, &diagnostics)
    }
}

// D-CAP-RECEIVER1=D: mark the value, not the call. The method-call check lifts
// a written `&`/`^` mark off its receiver before resolution, the receiver hook
// above records the resolved convention, and the finish step compares them:
// E0224 missing, E0225 extra, E0226 wrong mark. A write window receiver
// (`&values[0..1].sort()`) keeps its `&place` construction.
fn sema_receiver_mark_place_root(expr: Expr) -> String? {
    if expr == {
        .Ident(name, _) -> return Val(name)
        .Field(base, _, _) -> return sema_receiver_mark_place_root(base)
        .Index(base, _, _, _) -> return sema_receiver_mark_place_root(base)
        .Slice(base, _, _, _, _) -> return sema_receiver_mark_place_root(base)
        else -> return None
    }
}

fn sema_receiver_mark_rank(convention: AccessConvention) -> Int Never! {
    if convention == {
        .Read -> 0
        .Write -> 1
        else -> 2
    }
}

pub fn sema_receiver_mark_begin(state: &SemaOwnershipState, receiver: Expr) -> Expr {
    unmarked := receiver
    mark := SemaReceiverMark?{None}
    if receiver == .Place(value, access, span) {
        window :: if value == {
            .Slice(_, _, _, _, _) -> access == PlaceAccess.Write
            else -> false
        }
        if access != PlaceAccess.Read && !window {
            mark = Val(SemaReceiverMark{mark_span: Span{start: span.start, end: span.start + 1}, access: access})
            unmarked = value
        }
    }
    &state.receiver_frames.push(SemaReceiverMarkFrame{receiver_span: expr_span(unmarked), mark: mark, convention: None})
    unmarked
}

fn sema_receiver_mark_note(state: &SemaOwnershipState, receiver: Expr, convention: AccessConvention) {
    span :: expr_span(receiver)
    index := state.receiver_frames.len() - 1
    loop index >= 0 {
        frame :: state.receiver_frames[index]
        if frame.receiver_span.start == span.start && frame.receiver_span.end == span.end {
            stronger :: if frame.convention == {
                .Val(seen) -> sema_receiver_mark_rank(convention) > sema_receiver_mark_rank(seen)
                .None -> true
            }
            if stronger {
                updated := frame
                updated.convention = Val(convention)
                state.receiver_frames[index] = updated
            }
            return
        }
        index -= 1
    }
}

fn sema_receiver_mark_remove(mark: SemaReceiverMark, written: String, what: String, why: String) -> Diagnostic {
    diagnostic_with_edit(sema_error("E0225", mark.mark_span, what, why, "remove `{written}`"), TextEdit{span: mark.mark_span, new_text: ""})
}

fn sema_receiver_mark_replace(mark: SemaReceiverMark, written: String, needed: String, verb: String) -> Diagnostic {
    diagnostic_with_edit(sema_error("E0226", mark.mark_span, "this call {verb} its receiver, so the mark is `{needed}`, not `{written}`", "`&` marks a place the call writes and `^` a place the call takes; the resolved method declares which one", "replace `{written}` with `{needed}`"), TextEdit{span: mark.mark_span, new_text: needed})
}

fn sema_receiver_mark_is_write_window(state: SemaOwnershipState, root: String) -> Bool Never! {
    loop view in state.views {
        if view.carrier == root && view.active && view.access == AccessConvention.Write -> return true
    }
    false
}

// D-COPY-DEFAULT1=A: a taking call on a whole local at its last use moves
// the local with no mark, so the compiler chooses and `^` stays optional
// there. A writing call still needs `&`, and a take anywhere else (a field,
// or a local read again later) still needs `^`.
pub fn sema_receiver_mark_finish(state: &SemaOwnershipState, receiver: Expr, scopes: SemaScopeTable, receiver_last_use: Bool, diagnostics: &[Diagnostic]) {
    frame :: &state.receiver_frames.pop() ?? return
    root :: sema_receiver_mark_place_root(receiver)
    places :: sema_ownership_places_from_expr_in_state(receiver, scopes, &state)
    is_place :: root != None && places.len() > 0
    if frame.mark == .Val(mark) {
        written :: if mark.access == PlaceAccess.Take -> "^" else -> "&"
        if !is_place {
            &diagnostics.push(sema_receiver_mark_remove(mark, written, "`{written}` marks a fresh value, not a named place", "a mark binds a name plus fields, indexes, or ranges; a call result or literal is new, so the call receives it without a mark"))
            return
        }
        convention :: frame.convention ?? return
        if {
            convention == AccessConvention.Write && mark.access == PlaceAccess.Take -> &diagnostics.push(sema_receiver_mark_replace(mark, written, "&", "writes"))
            convention == AccessConvention.Move && mark.access == PlaceAccess.Write -> &diagnostics.push(sema_receiver_mark_replace(mark, written, "^", "takes"))
            convention == AccessConvention.Read && mark.access == PlaceAccess.Write && sema_receiver_mark_is_write_window(state, root ?? "") -> {}
            convention == AccessConvention.Read -> &diagnostics.push(sema_receiver_mark_remove(mark, written, "this call only reads its receiver, so it takes no `{written}` mark", "a mark shows that a call writes (`&`) or takes (`^`) the named place; a read call leaves the place unmarked"))
            else -> {}
        }
        return
    }
    if !is_place -> return
    needed :: if frame.convention == {
        .Val(convention) -> if convention == {
            .Write -> "&"
            .Move -> "^"
            else -> ""
        }
        .None -> ""
    }
    if needed == "" -> return
    if needed == "^" && receiver_last_use -> return
    verb :: if needed == "&" -> "writes" else -> "takes"
    place_name :: sema_ownership_place_name(places[0])
    span :: expr_span(receiver)
    &diagnostics.push(diagnostic_with_edit(sema_error("E0224", span, "this call {verb} `{place_name}`, but it has no `{needed}` mark", "the method's receiver convention {verb} the named place it is called on; the mark sits on that place, the same way `edit(&buf)` and `consume(^text)` mark arguments", "write `{needed}` before the place"), TextEdit{span: Span{start: span.start, end: span.start}, new_text: needed}))
}

pub fn sema_ownership_check_method_call(state: &SemaOwnershipState, callee: String, receiver: Expr, receiver_convention: AccessConvention, params: [SemaCallParam], args: &[CallArg], scopes: SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> SemaOwnershipCheckResult {
    sema_ownership_check_method_call_as(&state, callee, receiver, receiver_convention, true, params, &args, scopes, span, &diagnostics)
}

// Rust `record_call_receiver_access`: a Core stream or codec handle writes
// through the handle it names, so a write receiver keeps its call access and
// change checks but asks no write capability of the binding holding it.
pub fn sema_ownership_check_handle_method_call(state: &SemaOwnershipState, callee: String, receiver: Expr, receiver_convention: AccessConvention, params: [SemaCallParam], args: &[CallArg], scopes: SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> SemaOwnershipCheckResult {
    sema_ownership_check_method_call_as(&state, callee, receiver, receiver_convention, false, params, &args, scopes, span, &diagnostics)
}

fn sema_ownership_check_method_call_as(state: &SemaOwnershipState, callee: String, receiver: Expr, receiver_convention: AccessConvention, capability: Bool, params: [SemaCallParam], args: &[CallArg], scopes: SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> SemaOwnershipCheckResult {
    accepted :: sema_ownership_check_call_receiver_as(&state, receiver, receiver_convention, capability, scopes, span, &diagnostics)
    receiver_places :: sema_ownership_places_from_expr_in_state(receiver, scopes, &state)
    accesses :: loop receiver_place in receiver_places -> SemaOwnershipCallAccess{place: receiver_place, access: receiver_convention, span: span}
    sema_ownership_check_call_arguments_with_accesses(&state, callee, params, &args, scopes, &diagnostics, ^accesses, accepted, true)
}

pub fn sema_ownership_check_lambda_captures(state: &SemaOwnershipState, lambda: Lambda, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    loop capture in lambda.take_names {
        if !sema_ownership_mark_move(&state, Expr.Ident{name: capture.name, span: capture.span}, scopes, "a lambda that captures it", &diagnostics) -> valid = false
    }
    if lambda.meta.escapes {
        loop name in lambda.meta.mut_captures {
            capture_expr :: Expr.Ident{name: name, span: lambda.span}
            places := sema_ownership_places_from_expr_in_state(capture_expr, scopes, &state)
            if places.len() > 0 {
                if !sema_ownership_open_reference_for_expr(&state, capture_expr, AccessConvention.Write, lambda.span, scopes, &diagnostics) -> valid = false
            }
        }
    }
    valid
}

// ────────────────────────────────────────────────────────────────────────────
// Source-order expression walk.  This intentionally handles every AST shape
// that can carry a name or an access marker; registry-dependent operations are
// visited but do not invent ownership facts.

fn sema_ownership_check_expr_list(state: &SemaOwnershipState, values: [Expr], scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    loop value in values {
        if !sema_ownership_check_expression(&state, value, scopes, &diagnostics) -> valid = false
    }
    valid
}

fn sema_ownership_check_projected_read(state: &SemaOwnershipState, expr: Expr, base: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    places := sema_ownership_places_from_expr_in_state(expr, scopes, &state)
    if places.len() > 0 {
        valid := true
        loop place in places {
            if !sema_ownership_note_place_reference(&state, expr, place, expr_span(expr), scopes, SemaOwnershipReferenceKind.Read) -> valid = false
        }
        if !sema_ownership_check_use(&state, expr, scopes, &diagnostics) -> valid = false
        return valid
    }
    sema_ownership_check_expression(&state, base, scopes, &diagnostics)
}

fn sema_ownership_check_nested_call_value(state: &SemaOwnershipState, value: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if sema_ownership_places_from_expr_in_state(value, scopes, &state).len() > 0 -> return true
    sema_ownership_check_expression(&state, value, scopes, &diagnostics)
}

pub fn sema_ownership_check_expression(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if expr == {
        .Ident(name, span) -> sema_ownership_note_reference(&state, name, span, scopes, SemaOwnershipReferenceKind.Read) && sema_ownership_check_use(&state, expr, scopes, &diagnostics)
        .Paren(value, _) -> sema_ownership_check_expression(&state, value, scopes, &diagnostics)
        .Copy(value, _) -> sema_ownership_check_expression(&state, value, scopes, &diagnostics)
        .Deref(value, _) -> sema_ownership_check_expression(&state, value, scopes, &diagnostics)
        .RawOf(value, _) -> sema_ownership_check_expression(&state, value, scopes, &diagnostics)
        .Tainted(value, _, _) -> sema_ownership_check_expression(&state, value, scopes, &diagnostics)
        .Present(value, _) -> sema_ownership_check_expression(&state, value, scopes, &diagnostics)
        .Ok(value, _) -> sema_ownership_check_expression(&state, value, scopes, &diagnostics)
        .Err(value, _) -> sema_ownership_check_expression(&state, value, scopes, &diagnostics)
        .Field(base, _, _) -> sema_ownership_check_projected_read(&state, expr, base, scopes, &diagnostics)
        .OptField(base, _, _, _, _) -> sema_ownership_check_projected_read(&state, expr, base, scopes, &diagnostics)
        .Index(base, index, _, _) -> {
            places := sema_ownership_places_from_expr_in_state(expr, scopes, &state)
            valid := true
            if {
                places.len() > 0 -> {
                    loop place in places {
                        if !sema_ownership_note_place_reference(&state, expr, place, expr_span(expr), scopes, SemaOwnershipReferenceKind.Read) -> valid = false
                    }
                    if !sema_ownership_check_use(&state, expr, scopes, &diagnostics) -> valid = false
                }
                !sema_ownership_check_expression(&state, base, scopes, &diagnostics) -> valid = false
            }
            if !sema_ownership_check_expression(&state, index, scopes, &diagnostics) -> valid = false
            valid
        }
        .Slice(base, start, end, range, _) -> {
            places := sema_ownership_places_from_expr_in_state(expr, scopes, &state)
            valid := true
            if {
                places.len() > 0 -> {
                    loop place in places {
                        if !sema_ownership_note_place_reference(&state, expr, place, expr_span(expr), scopes, SemaOwnershipReferenceKind.Read) -> valid = false
                    }
                    if !sema_ownership_check_use(&state, expr, scopes, &diagnostics) -> valid = false
                }
                !sema_ownership_check_expression(&state, base, scopes, &diagnostics) -> valid = false
            }
            if !sema_ownership_check_expression(&state, start, scopes, &diagnostics) -> valid = false
            if !sema_ownership_check_expression(&state, end, scopes, &diagnostics) -> valid = false
            if range != None && !sema_ownership_check_expression(&state, range, scopes, &diagnostics) -> valid = false
            valid
        }
        .Place(value, access, _) -> {
            // D-COPY-DEFAULT1=A (#3714): a take mark on a bare place is an
            // exact move, which the expression check records; it opens no view.
            if access == PlaceAccess.Take || sema_ownership_places_from_expr_in_state(value, scopes, &state).len() == 0 -> return sema_ownership_check_expression(&state, value, scopes, &diagnostics)
            first_seq :: state.next_seq
            opened :: if access == PlaceAccess.Write -> sema_ownership_open_write_reference(&state, value, expr_span(expr), scopes, &diagnostics) else -> sema_ownership_open_reference_for_expr(&state, value, AccessConvention.Read, expr_span(expr), scopes, &diagnostics)
            loop index in 0..<state.loans.len() {
                if state.loans[index].seq >= first_seq -> state.loans[index].statement_window = true
            }
            opened
        }
        .ListLit(elements, _) -> sema_ownership_check_expr_list(&state, elements, scopes, &diagnostics)
        .MapLit(entries, _) -> {
            valid := true
            loop entry in entries {
                if !sema_ownership_check_expression(&state, entry.key, scopes, &diagnostics) -> valid = false
                if !sema_ownership_check_expression(&state, entry.value, scopes, &diagnostics) -> valid = false
            }
            valid
        }
        .Call(call) -> {
            valid := true
            loop arg in call.args {
                if !sema_ownership_check_nested_call_value(&state, arg.expr, scopes, &diagnostics) -> valid = false
            }
            valid
        }
        .CallValue(callee, args, _) -> {
            valid := sema_ownership_check_expression(&state, callee, scopes, &diagnostics)
            loop arg in args {
                if !sema_ownership_check_nested_call_value(&state, arg.expr, scopes, &diagnostics) -> valid = false
            }
            valid
        }
        .MethodCall(receiver, _, _, _, _, args, _, _, _, _) -> {
            valid := true
            receiver_places :: sema_ownership_places_from_expr_in_state(receiver, scopes, &state)
            if receiver_places.len() == 0 {
                valid = sema_ownership_check_expression(&state, receiver, scopes, &diagnostics)
            }
            loop arg in args {
                if !sema_ownership_check_nested_call_value(&state, arg.expr, scopes, &diagnostics) -> valid = false
            }
            valid
        }
        .OptMethodCall(receiver, _, _, _, args, _) -> {
            valid := sema_ownership_check_expression(&state, receiver, scopes, &diagnostics)
            loop arg in args {
                if !sema_ownership_check_nested_call_value(&state, arg.expr, scopes, &diagnostics) -> valid = false
            }
            valid
        }
        .Unary(_, value, _) -> sema_ownership_check_expression(&state, value, scopes, &diagnostics)
        .Binary(_, left, right, _) -> {
            valid := sema_ownership_check_expression(&state, left, scopes, &diagnostics)
            if !sema_ownership_check_expression(&state, right, scopes, &diagnostics) -> valid = false
            valid
        }
        .CompareChain(operands, _, _, _) -> sema_ownership_check_expr_list(&state, operands, scopes, &diagnostics)
        .TupleLit(fields, _, _) -> {
            valid := true
            loop field in fields {
                if !sema_ownership_check_expression(&state, field.value, scopes, &diagnostics) -> valid = false
            }
            valid
        }
        .StructLit(_, _, _, _, fields, _, _) -> {
            valid := true
            loop field in fields {
                if !sema_ownership_check_expression(&state, field.value, scopes, &diagnostics) -> valid = false
            }
            valid
        }
        .TypedLit(_, body, _) -> {
            if body == {
                .Fields(fields) -> {
                    valid := true
                    loop field in fields {
                        if !sema_ownership_check_expression(&state, field.value, scopes, &diagnostics) -> valid = false
                    }
                    valid
                }
                .Elements(elements) -> sema_ownership_check_expr_list(&state, elements, scopes, &diagnostics)
                .Entries(entries) -> {
                    valid := true
                    loop entry in entries {
                        if !sema_ownership_check_expression(&state, entry.key, scopes, &diagnostics) -> valid = false
                        if !sema_ownership_check_expression(&state, entry.value, scopes, &diagnostics) -> valid = false
                    }
                    valid
                }
                .Value(value) -> sema_ownership_check_expression(&state, value, scopes, &diagnostics)
                else -> true
            }
        }
        .EnumLit(_, _, _, args, _, _) -> {
            valid := true
            loop arg in args {
                if arg == {
                    .Positional(value) -> if !sema_ownership_check_expression(&state, value, scopes, &diagnostics) -> valid = false
                    .Named(_, value) -> if !sema_ownership_check_expression(&state, value, scopes, &diagnostics) -> valid = false
                }
            }
            valid
        }
        .If(condition, then_body, then_value, else_body, else_value, _) -> {
            valid := sema_ownership_check_expression(&state, condition, scopes, &diagnostics)
            before :: sema_ownership_state_snapshot(state)
            then_state := sema_ownership_state_snapshot(before)
            sema_ownership_enter_scope(&then_state)
            if !sema_ownership_check_statements(&then_state, then_body, scopes, &diagnostics).complete -> valid = false
            if !sema_ownership_check_expression(&then_state, then_value, scopes, &diagnostics) -> valid = false
            sema_ownership_leave_scope(&then_state)
            else_state := sema_ownership_state_snapshot(before)
            sema_ownership_enter_scope(&else_state)
            if !sema_ownership_check_statements(&else_state, else_body, scopes, &diagnostics).complete -> valid = false
            if !sema_ownership_check_expression(&else_state, else_value, scopes, &diagnostics) -> valid = false
            sema_ownership_leave_scope(&else_state)
            sema_ownership_join_paths(&state, before, then_state, else_state, true)
            valid
        }
        .OrFallback(value, fallback, _, _) -> {
            valid := sema_ownership_check_expression(&state, value, scopes, &diagnostics)
            before :: sema_ownership_state_snapshot(state)
            fallback_state := sema_ownership_state_snapshot(before)
            // A fallback route that leaves (`return`, `panic`, `break`,
            // `next`, or a block that always does) never reaches the join, so
            // its moves must not poison later uses.
            fallback_reaches_merge := false
            if fallback == {
                .Value(other) -> {
                    if !sema_ownership_check_expression(&fallback_state, other, scopes, &diagnostics) -> valid = false
                    fallback_reaches_merge = true
                }
                .Block(body, result, _) -> {
                    sema_ownership_enter_scope(&fallback_state)
                    nested :: sema_ownership_check_statements(&fallback_state, body, scopes, &diagnostics)
                    if !nested.complete -> valid = false
                    fallback_reaches_merge = nested.falls_through
                    if result == .Val(result_expr) {
                        if !sema_ownership_check_expression(&fallback_state, result_expr, scopes, &diagnostics) -> valid = false
                    }
                    sema_ownership_leave_scope(&fallback_state)
                }
                .Return(other, _) -> {
                    if other == .Val(returned) {
                        if !sema_ownership_check_expression(&fallback_state, returned, scopes, &diagnostics) -> valid = false
                    }
                }
                else -> {}
            }
            if fallback_reaches_merge -> sema_ownership_join_paths(&state, before, before, fallback_state, true)
            valid
        }
        .PatternTest(subject, _, _) -> sema_ownership_check_expression(&state, subject, scopes, &diagnostics)
        .Try(value, _, _, context) -> {
            valid := sema_ownership_check_expression(&state, value, scopes, &diagnostics)
            if context != None && !sema_ownership_check_expression(&state, context, scopes, &diagnostics) -> valid = false
            valid
        }
        .Lambda(lambda) -> {
            // Lambda bodies execute later.  Check them on a fork so a move in
            // the body cannot accidentally consume an enclosing local now.
            deferred := sema_ownership_state_snapshot(state)
            if lambda.body == {
                .Expr(value) -> {
                    _ := sema_ownership_check_expression(&deferred, value, scopes, &diagnostics)
                }
                .Block(body) -> {
                    _ := sema_ownership_check_statements(&deferred, body, scopes, &diagnostics)
                }
            }
            if !sema_ownership_check_lambda_captures(&state, lambda, scopes, &diagnostics) -> return false
            sema_ownership_merge_references(&state, deferred)
            true
        }
        else -> true
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Branch and scope state

// Branch facts are joined per key, like Rust `FlowFacts::merge_paths` rows:
// `slots` maps a key to its bucket in `rows`, and each bucket lists the
// merged rows of that key in merge order.
fn sema_ownership_bucket_add(slots: &[String:Int], rows: &[[Int]], key: String, row: Int) Never! {
    if slots.get(key) == .Val(slot) {
        &rows[slot].push(row)
    } else {
        slots[key] = rows.len()
        &rows.push([Int]{row})
    }
}

// Overlapping places share one root, so a candidate move is compared only
// with the merged moves of its root.
fn sema_ownership_moved_covered(merged: [SemaOwnershipMovedPlace], slots: [String:Int], rows: [[Int]], candidate: SemaOwnershipMovedPlace) -> Bool Never! {
    slot :: slots.get(candidate.place.root_key) ?? return false
    loop row in rows[slot] {
        if sema_ownership_places_overlap(merged[row].place, candidate.place) -> return true
    }
    false
}

// An exact loan shares its root with the loan it repeats.
fn sema_ownership_merge_loan(merged: &[SemaOwnershipLoan], slots: &[String:Int], rows: &[[Int]], loan: SemaOwnershipLoan) Never! {
    if slots.get(loan.place.root_key) == .Val(slot) {
        loop row in rows[slot] {
            if sema_ownership_loan_same(loan, merged[row]) -> return
        }
    }
    sema_ownership_bucket_add(&slots, &rows, loan.place.root_key, merged.len())
    &merged.push(loan)
}

// A repeated view has the same carrier; merged views are all active.
fn sema_ownership_merge_view(merged: &[SemaOwnershipViewFact], slots: &[String:Int], rows: &[[Int]], fact: SemaOwnershipViewFact) Never! {
    if slots.get(fact.carrier_key) == .Val(slot) {
        loop row in rows[slot] {
            if sema_ownership_view_same(fact, merged[row]) {
                if fact.invalidated && !merged[row].invalidated {
                    merged[row].invalidated = true
                    merged[row].invalidated_span = fact.invalidated_span
                    merged[row].invalidated_verb = fact.invalidated_verb
                }
                return
            }
        }
    }
    if fact.active {
        sema_ownership_bucket_add(&slots, &rows, fact.carrier_key, merged.len())
        &merged.push(fact)
    }
}

fn sema_ownership_loan_same(left: SemaOwnershipLoan, right: SemaOwnershipLoan) -> Bool Never! {
    sema_ownership_place_exact(left.place, right.place) && left.access == right.access && sema_ownership_span_same(left.span, right.span) && left.carrier_fact_seq == right.carrier_fact_seq && left.carrier_key == right.carrier_key
}

fn sema_ownership_view_same(left: SemaOwnershipViewFact, right: SemaOwnershipViewFact) -> Bool Never! {
    if !left.active || !right.active -> return false
    if left.carrier_key != right.carrier_key || left.access != right.access -> return false
    if !sema_ownership_span_same(left.carrier_span, right.carrier_span) -> return false
    if left.loan_seq != right.loan_seq || !sema_ownership_span_same(left.loan_span, right.loan_span) -> return false
    if !sema_ownership_place_exact(left.source, right.source) -> return false
    if left.output_path.len() != right.output_path.len() -> return false
    loop (index, segment) in left.output_path {
        if segment != right.output_path[index] -> return false
    }
    true
}

pub fn sema_ownership_join_paths(state: &SemaOwnershipState, before: SemaOwnershipState, then_state: SemaOwnershipState, else_state: SemaOwnershipState, has_else: Bool) Never! {
    base :: sema_ownership_state_snapshot(before)
    state.scope_depth = before.scope_depth
    state.next_seq = before.next_seq
    if then_state.next_seq > state.next_seq -> state.next_seq = then_state.next_seq
    if else_state.next_seq > state.next_seq -> state.next_seq = else_state.next_seq
    state.declarations = base.declarations
    declaration_keys := [String:Bool]{}
    loop declaration in state.declarations -> declaration_keys[declaration.key] = true
    loop fact in then_state.declarations {
        if declaration_keys.get(fact.key) != None -> next
        declaration_keys[fact.key] = true
        &state.declarations.push(fact)
    }
    loop fact in else_state.declarations {
        if declaration_keys.get(fact.key) != None -> next
        declaration_keys[fact.key] = true
        &state.declarations.push(fact)
    }

    merged_moves := [SemaOwnershipMovedPlace]{}
    move_slots := [String:Int]{}
    move_rows := [[Int]]{}
    loop moved in then_state.moved {
        if !sema_ownership_moved_covered(merged_moves, move_slots, move_rows, moved) {
            sema_ownership_bucket_add(&move_slots, &move_rows, moved.place.root_key, merged_moves.len())
            &merged_moves.push(moved)
        }
    }
    loop moved in else_state.moved {
        if !sema_ownership_moved_covered(merged_moves, move_slots, move_rows, moved) {
            sema_ownership_bucket_add(&move_slots, &move_rows, moved.place.root_key, merged_moves.len())
            &merged_moves.push(moved)
        }
    }
    if !has_else {
        loop moved in base.moved {
            if !sema_ownership_moved_covered(merged_moves, move_slots, move_rows, moved) {
                sema_ownership_bucket_add(&move_slots, &move_rows, moved.place.root_key, merged_moves.len())
                &merged_moves.push(sema_ownership_moved_snapshot(moved))
            }
        }
    }
    state.moved = merged_moves
    // D-UNINIT1: a binding unwritten on either path stays unwritten.
    state.uninit = sema_ownership_uninit_join(then_state.uninit, else_state.uninit)
    // D-COPY-DEFAULT1=A: a share site found on either path is found.
    loop site in then_state.share_found -> sema_ownership_note_share_found(&state, site)
    loop site in else_state.share_found -> sema_ownership_note_share_found(&state, site)

    // Loans and views are hazards after a branch whenever any executable
    // path carries them.  Keep pre-merge hazards and union both branch facts;
    // lexical scope cleanup has already removed facts whose owners ended.
    merged_loans := base.loans
    loan_slots := [String:Int]{}
    loan_rows := [[Int]]{}
    loop (row, loan) in merged_loans -> sema_ownership_bucket_add(&loan_slots, &loan_rows, loan.place.root_key, row)
    loop loan in then_state.loans -> sema_ownership_merge_loan(&merged_loans, &loan_slots, &loan_rows, loan)
    loop loan in else_state.loans -> sema_ownership_merge_loan(&merged_loans, &loan_slots, &loan_rows, loan)
    state.loans = merged_loans

    merged_views := [SemaOwnershipViewFact]{}
    view_slots := [String:Int]{}
    view_rows := [[Int]]{}
    loop view in base.views {
        if view.active {
            sema_ownership_bucket_add(&view_slots, &view_rows, view.carrier_key, merged_views.len())
            &merged_views.push(sema_ownership_view_snapshot(view))
        }
    }
    loop fact in then_state.views -> sema_ownership_merge_view(&merged_views, &view_slots, &view_rows, fact)
    loop fact in else_state.views -> sema_ownership_merge_view(&merged_views, &view_slots, &view_rows, fact)
    state.views = merged_views
    merged_references := base.references
    anchors := sema_ownership_reference_anchors(merged_references)
    sema_ownership_admit_references(&merged_references, &anchors, then_state.references)
    sema_ownership_admit_references(&merged_references, &anchors, else_state.references)
    state.references = merged_references
    sema_ownership_recompute_reference_counts(&state)
}

// D-UNINIT1 branch merge (Rust `UninitState::merge_paths`): a binding left
// unwritten by either path stays unwritten, and a fixed-list slot counts as
// written only where every path wrote it.
fn sema_ownership_uninit_join(left: [SemaOwnershipUninitFact], right: [SemaOwnershipUninitFact]) -> [SemaOwnershipUninitFact] Never! {
    right_slots := [String:Int]{}
    right_rows := [[Int]]{}
    loop (row, other) in right -> sema_ownership_bucket_add(&right_slots, &right_rows, other.key, row)
    merged := [SemaOwnershipUninitFact]{}
    merged_keys := [String:Bool]{}
    loop fact in left {
        joined := fact
        if right_slots.get(joined.key) == .Val(key_slot) {
            loop row in right_rows[key_slot] {
                if joined.fixed_len == right[row].fixed_len {
                    kept := [Int]{}
                    loop slot in joined.initialized {
                        if right[row].initialized.contains(slot) -> &kept.push(slot)
                    }
                    joined.initialized = kept
                } else {
                    joined.fixed_len = None
                    joined.initialized = [Int]{}
                }
            }
        }
        merged_keys[joined.key] = true
        &merged.push(joined)
    }
    loop fact in right {
        if merged_keys.get(fact.key) != None -> next
        merged_keys[fact.key] = true
        &merged.push(fact)
    }
    merged
}

pub fn sema_ownership_uninit_contains(facts: [SemaOwnershipUninitFact], key: String) -> Bool Never! {
    loop fact in facts {
        if fact.key == key -> return true
    }
    false
}

// Removes and returns the not-yet-written fact for the binding `key`.
pub fn sema_ownership_uninit_take(state: &SemaOwnershipState, key: String) -> SemaOwnershipUninitFact? {
    if state.uninit.len() == 0 -> return None
    taken := SemaOwnershipUninitFact?{None}
    remaining := [SemaOwnershipUninitFact]{}
    loop fact in state.uninit {
        if fact.key == key {
            taken = Val(fact)
        } else {
            &remaining.push(fact)
        }
    }
    state.uninit = remaining
    taken
}

pub fn sema_ownership_uninit_set(state: &SemaOwnershipState, fact: SemaOwnershipUninitFact) Never! {
    _ := sema_ownership_uninit_take(&state, fact.key)
    &state.uninit.push(fact)
}

fn sema_ownership_loop_path_to_depth(path: SemaOwnershipState, target_depth: Int) -> SemaOwnershipState Never! {
    normalized := sema_ownership_state_snapshot(path)
    loop normalized.scope_depth > target_depth -> sema_ownership_leave_scope(&normalized)
    normalized
}

pub fn sema_ownership_join_loop_value_paths(state: &SemaOwnershipState, context: SemaCheckContext, frame_index: Int, before: SemaOwnershipState, after_body: SemaOwnershipState, body_falls_through: Bool, may_skip: Bool) -> Bool Never! {
    paths := [SemaOwnershipState]{}
    if may_skip -> &paths.push(sema_ownership_state_snapshot(before))
    if may_skip && body_falls_through -> &paths.push(sema_ownership_loop_path_to_depth(after_body, before.scope_depth))
    loop exit in sema_loop_value_break_flows(context, frame_index) -> &paths.push(sema_ownership_loop_path_to_depth(exit, before.scope_depth))
    if paths.len() == 0 {
        sema_ownership_join_paths(&state, before, before, before, false)
        return false
    }
    joined := paths[0]
    index := 1
    loop index < paths.len() {
        next := sema_ownership_state_snapshot(joined)
        sema_ownership_join_paths(&next, before, joined, paths[index], true)
        joined = next
        index += 1
    }
    sema_ownership_join_paths(&state, before, joined, joined, true)
    may_skip || sema_loop_value_break_flows(context, frame_index).len() > 0
}

// ────────────────────────────────────────────────────────────────────────────
// Statement walk used by the parent integration hook

pub fn sema_ownership_check_binding(state: &SemaOwnershipState, binding: Binding, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if !sema_ownership_consume_expression(&state, binding.init, scopes, "the binding `{binding.name}`", &diagnostics) -> return false
    if sema_scope_resolve_index_at(scopes, binding.name, binding.name_span) == .Val(symbol_index) {
        symbol :: scopes.bindings[symbol_index].symbol
        if sema_ownership_declaration_index(&state, symbol.id.key) == None {
            sema_ownership_declare_binding(&state, symbol, false)
        }
    }
    sema_ownership_record_binding_view(&state, binding, scopes)
    true
}

fn sema_ownership_lvalue_expr(target: LValue) -> Expr Never! {
    if target == {
        .Local(name, span) -> Expr.Ident{name: name, span: span}
        .Field(base, field, span) -> Expr.Field{base: base, member: field, span: span}
        .Index(base, index, span, kind) -> Expr.Index{base: base, index: index, span: span, kind: kind}
    }
}

pub fn sema_ownership_record_assignment_view(state: &SemaOwnershipState, target: LValue, value: Expr, scopes: SemaScopeTable) -> Bool {
    target_expr :: sema_ownership_lvalue_expr(target)
    output_path := [String]{}
    carrier_name :: sema_ownership_named_view_root(target_expr, &output_path) ?? return false
    carrier_key :: sema_ownership_carrier_key(scopes, carrier_name, expr_span(target_expr)) ?? return false
    if target == {
        .Local(_, _) -> {}
        else -> return false
    }
    producer :: sema_ownership_view_producer(value) ?? return false
    places := sema_ownership_places_from_expr_in_state(producer.source, scopes, &state)
    if places.len() == 0 -> return false
    loop index in 0..<state.views.len() {
        if state.views[index].carrier_key == carrier_key && state.views[index].active {
            state.views[index].active = false
        }
    }
    valid := true
    loop place in places {
        loan_seq := sema_ownership_matching_loan_seq(&state, place, producer.span)
        if !sema_ownership_record_view_fact_inner(&state, carrier_name, expr_span(target_expr), place, output_path, producer.access, scopes, loan_seq) -> valid = false
    }
    valid
}

pub fn sema_ownership_check_assignment(state: &SemaOwnershipState, target: LValue, value: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    valid := sema_ownership_check_expression(&state, value, scopes, &diagnostics)
    lvalue_ok :: sema_ownership_check_lvalue_write(&state, target, scopes, &diagnostics)
    if {
        lvalue_ok -> {
            _ := sema_ownership_record_assignment_view(&state, target, value, scopes)
        }
        else -> valid = false
    }
    if value == {
        .Ident(_, _) | .Paren(_, _) | .Present(_, _) | .Ok(_, _) | .Err(_, _) | .Tainted(_, _, _) -> {
            if !sema_ownership_mark_unmarked_move(&state, value, scopes, "the assignment", &diagnostics) -> valid = false
        }
        else -> {}
    }
    valid
}

pub fn sema_ownership_check_lvalue_write(state: &SemaOwnershipState, target: LValue, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if target == {
        .Local(name, span) -> sema_ownership_check_write(&state, Expr.Ident{name: name, span: span}, "be assigned", scopes, &diagnostics)
        .Field(base, field, span) -> sema_ownership_check_write(&state, Expr.Field{base: base, member: field, span: span}, "be assigned", scopes, &diagnostics)
        .Index(base, index, span, kind) -> {
            if !sema_ownership_check_expression(&state, index, scopes, &diagnostics) -> return false
            sema_ownership_check_write(&state, Expr.Index{base: base, index: index, span: span, kind: kind}, "be assigned", scopes, &diagnostics)
        }
    }
}

fn sema_ownership_check_scoped_body(state: &SemaOwnershipState, body: [Stmt], scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaOwnershipFlowResult {
    sema_ownership_enter_scope(&state)
    nested :: sema_ownership_check_statements(&state, body, scopes, &diagnostics)
    sema_ownership_leave_scope(&state)
    nested
}

pub fn sema_ownership_check_statement(state: &SemaOwnershipState, statement: Stmt, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaOwnershipFlowResult {
    if statement == {
        .Expr(expr) -> SemaOwnershipFlowResult{complete: sema_ownership_check_expression(&state, expr, scopes, &diagnostics), falls_through: true}
        .Val(binding) -> SemaOwnershipFlowResult{complete: sema_ownership_check_binding(&state, binding, scopes, &diagnostics), falls_through: true}
        .Assign(target, _, _, value) -> SemaOwnershipFlowResult{complete: sema_ownership_check_assignment(&state, target, value, scopes, &diagnostics), falls_through: true}
        .Return(value, _) -> {
            valid :: if value == .Val(returned) -> sema_ownership_consume_expression(&state, returned, scopes, "`return`", &diagnostics) else -> true
            SemaOwnershipFlowResult{complete: valid, falls_through: false}
        }
        .BreakValue(value, _) | .BreakLabelValue(_, _, value, _) -> {
            valid :: sema_ownership_consume_expression(&state, value, scopes, "the loop `break`", &diagnostics)
            SemaOwnershipFlowResult{complete: valid, falls_through: false}
        }
        .Break(_) | .BreakLabel(_, _) | .Continue(_) | .ContinueLabel(_, _) -> SemaOwnershipFlowResult{complete: true, falls_through: false}
        .Yield(value, _) -> {
            valid :: sema_ownership_consume_expression(&state, value, scopes, "`yield`", &diagnostics)
            SemaOwnershipFlowResult{complete: valid, falls_through: true}
        }
        .While(condition, body, _, _, _) -> {
            valid := sema_ownership_check_expression(&state, condition, scopes, &diagnostics)
            before :: sema_ownership_state_snapshot(state)
            body_state := sema_ownership_state_snapshot(before)
            sema_ownership_enter_scope(&body_state)
            nested :: sema_ownership_check_statements(&body_state, body, scopes, &diagnostics)
            sema_ownership_leave_scope(&body_state)
            sema_ownership_join_paths(&state, before, body_state, before, false)
            if !nested.complete -> valid = false
            SemaOwnershipFlowResult{complete: valid, falls_through: true}
        }
        .Loop(body, _, _, _) -> {
            before :: sema_ownership_state_snapshot(state)
            body_state := sema_ownership_state_snapshot(before)
            sema_ownership_enter_scope(&body_state)
            nested :: sema_ownership_check_statements(&body_state, body, scopes, &diagnostics)
            sema_ownership_leave_scope(&body_state)
            sema_ownership_join_paths(&state, before, body_state, before, false)
            SemaOwnershipFlowResult{complete: nested.complete, falls_through: true}
        }
        .For(var, var_span, _, kind, body, _, _, _, _) -> {
            valid := true
            if kind == {
                .Range(start, end, step, _) -> {
                    if !sema_ownership_check_expression(&state, start, scopes, &diagnostics) -> valid = false
                    if !sema_ownership_check_expression(&state, end, scopes, &diagnostics) -> valid = false
                    if step != None && !sema_ownership_check_expression(&state, step, scopes, &diagnostics) -> valid = false
                }
                .In(collection, step) -> {
                    if !sema_ownership_check_expression(&state, collection, scopes, &diagnostics) -> valid = false
                    if step != None && !sema_ownership_check_expression(&state, step, scopes, &diagnostics) -> valid = false
                }
            }
            before :: sema_ownership_state_snapshot(state)
            body_state := sema_ownership_state_snapshot(before)
            sema_ownership_enter_scope(&body_state)
            if sema_scope_resolve_index_at(scopes, var, var_span) == .Val(loop_binding_index) {
                loop_symbol :: scopes.bindings[loop_binding_index].symbol
                if sema_ownership_declaration_index(&body_state, loop_symbol.id.key) == None {
                    sema_ownership_declare_binding(&body_state, loop_symbol, false)
                }
            }
            nested :: sema_ownership_check_statements(&body_state, body, scopes, &diagnostics)
            sema_ownership_leave_scope(&body_state)
            sema_ownership_join_paths(&state, before, body_state, before, false)
            if !nested.complete -> valid = false
            SemaOwnershipFlowResult{complete: valid, falls_through: true}
        }
        .CountedLoop(init, condition, step, body, _, _, _) -> {
            valid := sema_ownership_check_binding(&state, init, scopes, &diagnostics)
            if !sema_ownership_check_expression(&state, condition, scopes, &diagnostics) -> valid = false
            if step == .Val(step_statement) {
                nested_step :: sema_ownership_check_statement(&state, step_statement, scopes, &diagnostics)
                if !nested_step.complete -> valid = false
            }
            nested :: sema_ownership_check_statements(&state, body, scopes, &diagnostics)
            if !nested.complete -> valid = false
            SemaOwnershipFlowResult{complete: valid, falls_through: true}
        }
        .Switch(subject, arms, else_body, _) -> {
            valid := sema_ownership_check_expression(&state, subject, scopes, &diagnostics)
            before :: sema_ownership_state_snapshot(state)
            joined := sema_ownership_state_snapshot(before)
            loop arm in arms {
                arm_state := sema_ownership_state_snapshot(before)
                if !sema_ownership_check_expression(&arm_state, arm.cond, scopes, &diagnostics) -> valid = false
                nested :: sema_ownership_check_statements(&arm_state, arm.body, scopes, &diagnostics)
                if !nested.complete -> valid = false
                sema_ownership_join_paths(&joined, before, arm_state, before, false)
            }
            if else_body == .Val(else_statements) {
                else_state := sema_ownership_state_snapshot(before)
                nested :: sema_ownership_check_statements(&else_state, else_statements, scopes, &diagnostics)
                if !nested.complete -> valid = false
                arms_state := sema_ownership_state_snapshot(joined)
                sema_ownership_join_paths(&joined, before, arms_state, else_state, true)
            }
            state.moved = joined.moved
            state.loans = joined.loans
            SemaOwnershipFlowResult{complete: valid, falls_through: true}
        }
        .Unsafe(_, _, body, _) -> sema_ownership_check_scoped_body(&state, body, scopes, &diagnostics)
        .Impure(_, _, body, _) -> sema_ownership_check_scoped_body(&state, body, scopes, &diagnostics)
        .Reactive(body, _) -> sema_ownership_check_scoped_body(&state, body, scopes, &diagnostics)
        .Shield(body, _) -> sema_ownership_check_scoped_body(&state, body, scopes, &diagnostics)
        .Switched(_, body, _) -> sema_ownership_check_scoped_body(&state, body, scopes, &diagnostics)
        .Region(_, _, body, _) -> sema_ownership_check_scoped_body(&state, body, scopes, &diagnostics)
        .Policy(_, body, _) -> sema_ownership_check_scoped_body(&state, body, scopes, &diagnostics)
        .Live(body, _) -> sema_ownership_check_scoped_body(&state, body, scopes, &diagnostics)
        .Transact(_, _, body, _, _) -> sema_ownership_check_scoped_body(&state, body, scopes, &diagnostics)
        .ComptimeIf(condition, _, then_body, else_body, _, _) -> {
            valid := sema_ownership_check_expression(&state, condition, scopes, &diagnostics)
            before :: sema_ownership_state_snapshot(state)
            then_state := sema_ownership_state_snapshot(before)
            nested_then :: sema_ownership_check_statements(&then_state, then_body, scopes, &diagnostics)
            if !nested_then.complete -> valid = false
            else_state := sema_ownership_state_snapshot(before)
            if else_body != None {
                nested_else :: sema_ownership_check_statements(&else_state, else_body, scopes, &diagnostics)
                if !nested_else.complete -> valid = false
            }
            sema_ownership_join_paths(&state, before, then_state, else_state, else_body != None)
            SemaOwnershipFlowResult{complete: valid, falls_through: true}
        }
        else -> SemaOwnershipFlowResult{complete: true, falls_through: true}
    }
}

pub fn sema_ownership_check_statements(state: &SemaOwnershipState, statements: [Stmt], scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaOwnershipFlowResult {
    valid := true
    falls_through := true
    loop statement in statements {
        if !falls_through {
            break
        }
        checked :: sema_ownership_check_statement(&state, statement, scopes, &diagnostics)
        if !checked.complete -> valid = false
        falls_through = checked.falls_through
    }
    SemaOwnershipFlowResult{complete: valid, falls_through: falls_through}
}
