// Private continuation of the canonical ownership checker.
use jet_foundation.[AccessConvention, BinOp, CallArg, ConstAttr, Diagnostic, EnumLitArg, Expr, InternalTag, Item, LValue, OrFallback, PatSlot, Pattern, PlaceAccess, Span, StructPatField, TagMarker, Type, VariantPayload, ViewSource]
use jet_sema.[Checker, AccessWalkMode, EvaluatedAccess, ViewAccess, ViewKind, ViewPlace, ViewProjection, carries_lending_view, const_place_int, expr_root_ident, named_view_field_path, view_facts_newest_first, view_kind_from_return_type, is_allocator_type, is_mapped_file_view_method, collection_changed_by_method_in_loop, collect_window_names]
use jet_foundation.Syntax as Syntax

impl Checker {
    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:1811
    pub fn check_call_argument_access(self: &Self, arg: &CallArg, param_conv: AccessConvention, param_ty: &Type, borrowed_read: Bool) {
        if arg.convention == AccessConvention.Write && self.reject_static_mutable_borrow(arg.expr, arg.span) -> return
        if param_conv == AccessConvention.Move && arg.convention == AccessConvention.Move {
            _ :: self.reject_partial_static_move(arg.expr, arg.span)
            _ :: self.reject_noncanonical_move_place(arg.expr, None, "this consuming call", arg.span)
        }
        place :: self.place_from_expr(arg.expr) ?? {
            accesses := [EvaluatedAccess]{}
            self.collect_evaluated_expr_accesses(arg.expr, AccessWalkMode.EvaluateNow, [String:Bool]{}, &accesses)
            self.check_transient_accesses(^accesses)
            return
        }
        projection_accesses := [EvaluatedAccess]{}
        self.collect_call_projection_accesses(arg.expr, &projection_accesses)
        self.check_transient_accesses(^projection_accesses)
        access :: if arg.convention == AccessConvention.Write { ViewAccess.Write } else { ViewAccess.Read }
        self.check_call_place_access(place, access, arg.expr.span())
        generated :: if arg.convention == AccessConvention.Write { Val(ViewAccess.Write) } else if arg.convention == AccessConvention.Read && param_conv == AccessConvention.Read && borrowed_read && !param_ty.is_scalar() { Val(ViewAccess.Read) } else { None }
        if generated == .Val(access) -> self.record_call_place_access(^place, access)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:1870
    // Construction evaluates free captures now; only nonescaping FnMut retains borrows.
    pub fn check_call_argument_captures(self: &Self, expr: &Expr) {
        self.report_lending_view_escape(expr, "be passed to a call")
        accesses := [EvaluatedAccess]{}
        self.collect_evaluated_expr_accesses(expr, AccessWalkMode.ConstructCaptures, [String:Bool]{}, &accesses)
        loop access in accesses {
            self.check_call_place_access(access.place, access.access, access.span)
            if access.through_call {
                self.record_call_place_access(^access.place, access.access)
            } else if access.moves_owner {
                self.mark_moved_place_exact(^access.place, access.span, "a lambda that captures it")
            }
        }
        self.record_call_result_views(expr)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:1894
    pub fn report_lending_view_escape(self: &Self, expr: &Expr, action: String) {
        name :: self.lending_view_loop_vars.keys().find(name -> carries_lending_view(expr, name)) ?? return
        self.diags.push(Diagnostic.error("E0212", "the lent mutable view `{name}` cannot {action}", "the view is valid only while the current iteration or callback invocation is active", "use the view inside that scope, and keep only owned values outside it", Val(expr.span())))
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:1915
    // Receiver evaluation reads even before method resolution.
    pub fn check_call_receiver_evaluation(self: &Self, receiver: &Expr, span: Span) {
        if self.place_from_expr(receiver) == .Val(place) {
            projection_accesses := [EvaluatedAccess]{}
            self.collect_call_projection_accesses(receiver, &projection_accesses)
            self.check_transient_accesses(^projection_accesses)
            self.check_call_place_access(place, ViewAccess.Read, span)
        } else {
            accesses := [EvaluatedAccess]{}
            self.collect_evaluated_expr_accesses(receiver, AccessWalkMode.EvaluateNow, [String:Bool]{}, &accesses)
            self.check_transient_accesses(^accesses)
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:1933
    fn is_static_move_root(self: &Self, name: String) -> Bool {
        self.items.any(item -> if item == {
            .Const(constant) -> constant.name == name && (constant.is_persist || constant.mutable || constant.attrs.any(attr -> if attr == { .ForceStatic -> true; _ -> false }))
            _ -> false
        })
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:1949
    fn static_expr_root(expr: &Expr) -> String? {
        if expr == {
            .Deref(inner, _) | .RawOf(inner, _) | .Place(inner, _, _) | .Paren(inner, _) -> Self.static_expr_root(inner)
            _ -> expr_root_ident(expr)
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:1959
    pub fn reject_static_mutable_borrow(self: &Self, expr: &Expr, span: Span) -> Bool {
        place :: self.place_from_expr(expr)
        owner :: place.map(place -> ~place.owner.name).or_else(fn() { Self.static_expr_root(expr) }) ?? return false
        if !self.is_static_move_root(owner) -> return false
        name :: place.map(place -> Self.place_name(place)).unwrap_or_else(fn() { ~owner })
        diagnostic :: Diagnostic.from_row("E0223", [("name", name)], Val(span))
        duplicate :: self.diags.any(previous -> previous.code == diagnostic.code && previous.span == diagnostic.span && previous.what == diagnostic.what)
        if !duplicate -> self.diags.push(^diagnostic)
        true
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:1994
    // Shared persistent/static storage can move only as a whole cell.
    pub fn reject_partial_static_move(self: &Self, expr: &Expr, span: Span) -> Bool {
        place :: self.place_from_expr(expr) ?? return false
        if place.projections.is_empty() || !self.is_static_move_root(place.owner.name) -> return false
        name :: Self.place_name(place)
        self.diags.push(Diagnostic.from_row("E0222", [("name", name)], Val(span)))
        true
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2010
    pub fn record_call_receiver_access(self: &Self, receiver: &Expr, convention: AccessConvention, span: Span) {
        // D-CAP-RECEIVER1=D: resolution checks the written mark.
        self.note_receiver_convention(receiver, convention)
        if convention == AccessConvention.Write && self.reject_static_mutable_borrow(receiver, span) -> return
        if convention == AccessConvention.Move -> _ :: self.reject_noncanonical_move_place(receiver, None, "this consuming method", span)
        place :: self.place_from_expr(receiver) ?? return
        if convention == AccessConvention.Move -> _ :: self.reject_partial_static_move(receiver, span)
        access :: if convention == AccessConvention.Write { ViewAccess.Write } else { ViewAccess.Read }
        self.check_call_place_access(place, access, span)
        if convention != AccessConvention.Move -> self.record_call_place_access(^place, access)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2047
    pub fn record_call_receiver_reservation(self: &Self, receiver: &Expr, span: Span) {
        self.note_receiver_convention(receiver, AccessConvention.Write)
        if self.reject_static_mutable_borrow(receiver, span) -> return
        place :: self.place_from_expr(receiver) ?? return
        self.check_call_place_access_kind(place, ViewAccess.Write, true, span)
        self.record_call_place_reservation(^place)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2059
    pub fn place_from_expr(self: &Self, expr: &Expr) -> ViewPlace? {
        output_path := [String]{}
        if named_view_field_path(expr, &output_path) == .Val(name) {
            if self.view_fact_at_path(name, output_path) == .Val(fact) {
                place := ~fact.place
                loop field in output_path[fact.output_path.len()..] -> place.projections.push(ViewProjection.Field(~field))
                return Val(^place)
            }
        }
        if expr == {
            .Ident(name, _) -> {
                if self.lookup(name) != None || self.consts.contains_key(name) { Val(ViewPlace{owner: self.owner_id(name), projections: []}) } else { None }
            }
            .Field(base, field, _) -> {
                place := self.place_from_expr(base) ?? return None
                place.projections.push(ViewProjection.Field(~field))
                Val(^place)
            }
            .Index(base: base, index: index, span: span, ..) -> {
                place := self.place_from_expr(base) ?? return None
                place.projections.push(ViewProjection.Index(value: const_place_int(index), span: span))
                Val(^place)
            }
            .Slice(base: base, start: start, end: end, range: range, span: span) -> {
                place := self.place_from_expr(base) ?? return None
                bounds :: if range == {
                    .Val(.Range(start: range_start, end: range_end, exclusive: exclusive, ..)) -> {
                        a :: const_place_int(range_start)
                        b := const_place_int(range_end)
                        if exclusive -> b = b.and_then(value -> value.checked_sub(1))
                        (a, b)
                    }
                    .Val(_) -> (None, None)
                    .None -> (const_place_int(start), const_place_int(end))
                }
                place.projections.push(ViewProjection.Range(start: bounds.0, end: bounds.1, span: span))
                Val(^place)
            }
            .Place(inner, _, _) | .Paren(inner, _) -> self.place_from_expr(inner)
            _ -> None
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2134
    // Rust 2021 captures stop field precision at an index or slice.
    fn capture_place_info(self: &Self, expr: &Expr) -> (ViewPlace, Type?, Bool)? {
        if expr == {
            .Ident(name, _) -> {
                if self.lookup(name) != None || self.consts.contains_key(name) {
                    Val((ViewPlace{owner: self.owner_id(name), projections: []}, self.lookup(name).map(info -> ~info.ty), false))
                } else { None }
            }
            .Field(base, field, _) -> {
                info := self.capture_place_info(base) ?? return None
                if info.2 -> return Val((^info.0, ^info.1, true))
                info.0.projections.push(ViewProjection.Field(~field))
                ty :: info.1.and_then(owner -> self.projected_field_type(owner, field))
                Val((^info.0, ^ty, false))
            }
            .Index(base: base, ..) | .Slice(base: base, ..) -> self.capture_place_info(base).map(info -> (info.0, info.1, true))
            .Place(inner, _, _) | .Paren(inner, _) -> self.capture_place_info(inner)
            _ -> None
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2167
    // Capture the alias itself, rather than chasing its view source.
    fn capture_place_from_expr(self: &Self, expr: &Expr) -> ViewPlace? {
        self.capture_place_info(expr).map(info -> info.0)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2171
    pub fn is_view(self: &Self, name: String) -> Bool { self.view_fact(name) != None }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2183
    pub fn frame_owns_place(self: &Self, place: &Expr) -> Bool {
        root :: expr_root_ident(place) ?? return true
        if self.is_view(root) -> return false
        !self.lookup(root).is_some_and(info -> info.param_conv == Val(AccessConvention.Read) || info.param_conv == Val(AccessConvention.Write))
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2206
    // Only a bare owned local or an rvalue is consumable, never projected storage.
    pub fn frame_can_consume_collection(self: &Self, place: &Expr) -> Bool {
        if place == {
            .Ident(..) -> self.frame_owns_place(place)
            .Paren(inner, _) | .Copy(inner, _) -> self.frame_can_consume_collection(inner)
            _ -> expr_root_ident(place) == None
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2217
    pub fn is_write_view(self: &Self, name: String) -> Bool { self.view_fact(name).is_some_and(fact -> fact.access == ViewAccess.Write) }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2222
    pub fn is_edit_shared_guard(self: &Self, name: String) -> Bool {
        self.lookup(name).is_some_and(info -> if info.ty == {
            .Tagged(marker: .Internal(InternalTag.SharedGuardEdit), inner: inner) -> if inner == { .Apply(name: name, ..) -> name == Syntax.TYPE_SHARED_GUARD; _ -> false }
            _ -> false
        })
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2237
    pub fn is_read_shared_guard(self: &Self, name: String) -> Bool {
        self.lookup(name).is_some_and(info -> if info.ty == {
            .Apply(name: name, ..) -> name == Syntax.TYPE_SHARED_GUARD
            .Tagged(marker: .Internal(InternalTag.SharedGuardRead), inner: inner) -> if inner == { .Apply(name: name, ..) -> name == Syntax.TYPE_SHARED_GUARD; _ -> false }
            _ -> false
        })
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2256
    pub fn validate_write_place(self: &Self, expr: &Expr, span: Span) {
        if self.frozen_expr_site(expr) == .Val(freeze_site) {
            name :: expr_root_ident(expr) ?? "the frozen value"
            self.report_frozen_write(name, freeze_site, "be edited", span)
            return
        }
        if self.reject_static_mutable_borrow(expr, span) -> return
        root :: expr_root_ident(expr) ?? return
        if self.frozen_for(root) == .Val(freeze_site) {
            self.report_frozen_write(root, freeze_site, "be edited", span)
            return
        }
        if self.view_fact(root) == .Val(fact) {
            if fact.access == ViewAccess.Write -> return
            self.diags.push(Diagnostic.error("E0205", "cannot edit through `{root}` — it has read access only", "a read window may inspect its place, but it cannot change the owner", "take a write window from a mutable owner instead", Val(span)))
            return
        }
        if self.is_global_mutable_binding(root) -> return
        if self.consts.contains_key(root) {
            self.diags.push(Diagnostic.error("E0111", "`{root}` is a const and can never change", "a const is fixed for the whole program", "use a `{Syntax.SIGIL_BIND_MUT}` binding if it needs to change", Val(span)))
            return
        }
        info :: self.lookup(root).map(info -> ~info) ?? return
        if self.reject_read_shared_guard_write(expr, span) -> return
        if info.mutable || info.param_conv == Val(AccessConvention.Write) || self.is_edit_shared_guard(root) -> return
        wording :: if info.param_conv != None {
            ("E0205", "an unmarked parameter gives read access only; a write window needs the write-access marker `&`", "change the parameter to `{root}: {Syntax.SIGIL_WRITE}{info.ty.name()}` with the write-access marker `&`")
        } else {
            ("E0202", "a write window can change its owner, so the owner must be mutable", "declare `{root} {Syntax.SIGIL_BIND_MUT} ...`")
        }
        self.diags.push(Diagnostic.error(wording.0, "cannot take a write window into `{root}`", wording.1, wording.2, Val(span)))
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2341
    pub fn check_expr_change(self: &Self, expr: &Expr, action: String, span: Span) {
        self.check_expr_change_with_view_exemption(expr, action, span, None)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2345
    fn check_expr_change_with_view_exemption(self: &Self, expr: &Expr, action: String, span: Span, ignored_view: (String, Span, Int)?) {
        if self.frozen_expr_site(expr) == .Val(freeze_site) {
            name :: expr_root_ident(expr) ?? "the frozen value"
            self.report_frozen_write(name, freeze_site, action, span)
            return
        }
        if self.reject_static_mutable_borrow(expr, span) -> return
        if expr_root_ident(expr) == .Val(name) {
            if self.reject_expiring_secret_loan_change(name, action, span) -> return
        }
        if self.place_from_expr(expr) == .Val(place) -> self.check_place_change_with_view_exemption(place, action, span, ignored_view)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2370
    pub fn check_mutating_method_receiver(self: &Self, receiver: &Expr, method: String, span: Span) {
        self.note_receiver_convention(receiver, AccessConvention.Write)
        if self.in_lambda_body {
            if expr_root_ident(receiver) == .Val(root) -> self.inferred_lambda_mut_captures.insert(~root, true)
        }
        root :: expr_root_ident(receiver) ?? {
            self.check_expr_change(receiver, "be changed by `.{method}()`", span)
            return
        }
        if self.is_edit_shared_guard(root) -> return
        if self.is_read_shared_guard(root) {
            self.diags.push(Diagnostic.error("E0205", "cannot edit through `{root}` — this `SharedGuard` has read access only", "a guard from `guard_read()` may inspect the shared value but cannot change it", "use `guard_edit()` when this scope must change the shared value", Val(span)))
            return
        }
        self.check_expr_change(receiver, "be changed by `.{method}()`", span)
        if expr_root_ident(receiver) == .Val(name) -> self.clear_origin(name)
        if self.iter_borrowed.contains_key(root) -> self.diags.push(collection_changed_by_method_in_loop(root, method, span))
        if self.lookup(root) == .Val(info) {
            if !info.mutable && self.frozen_for(root) == None {
                wording :: if root == Syntax.KW_SELF {
                    ("`.{method}()` edits `{Syntax.KW_SELF}`, but this method has read access only", "declare the enclosing method with the write-access marker `&`: `{Syntax.SIGIL_WRITE}{Syntax.KW_SELF}`")
                } else {
                    ("cannot write to `{root}` — it does not have the write-access marker `&`; required before calling `.{method}()`", "declare `{root} {Syntax.SIGIL_BIND_MUT} ...`")
                }
                self.diags.push(Diagnostic.error("E0202", wording.0, "this method edits the value it's called on; the write-access marker `&` is required", wording.1, Val(span)))
            }
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2447
    pub fn check_write_arg_change(self: &Self, arg: &CallArg) {
        if arg.convention != AccessConvention.Write -> return
        // Reborrow exactly the carrier's own fact, not another live view.
        write_view :: expr_root_ident(arg.expr).and_then(root -> self.view_fact(root).filter(fact -> fact.access == ViewAccess.Write).map(fact -> (~root, fact.binding_span, fact.seq)))
        if write_view == .Val(exemption) {
            self.check_expr_change_with_view_exemption(arg.expr, "be passed with write access", arg.span, Val(exemption))
        } else {
            self.check_expr_change(arg.expr, "be passed with write access", arg.span)
        }
        if expr_root_ident(arg.expr) == .Val(root) -> self.clear_origin(root)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2473
    pub fn check_lvalue_change(self: &Self, target: &LValue, action: String) {
        through_write_view :: if target == {
            .Index(base: base, ..) | .Field(base: base, ..) -> expr_root_ident(base).and_then(name -> self.view_fact(name)).is_some_and(fact -> fact.access == ViewAccess.Write)
            .Local(name: name, ..) -> self.is_write_view(name)
        }
        if through_write_view -> return
        frozen_base :: if target == {
            .Index(base: base, ..) | .Field(base: base, ..) -> Val(base)
            .Local(..) -> None
        }
        if frozen_base == .Val(base) {
            if self.frozen_expr_site(base) == .Val(freeze_site) {
                self.report_frozen_write(expr_root_ident(base) ?? "the frozen value", freeze_site, action, target.span())
                return
            }
        }
        place :: if target == {
            .Local(name: name, ..) -> Val(ViewPlace{owner: self.owner_id(name), projections: []})
            .Index(base: base, index: index, span: span, ..) -> self.place_from_expr(base).map(fn(place: ViewPlace) {
                result := ^place
                result.projections.push(ViewProjection.Index(value: const_place_int(index), span: span))
                ^result
            })
            .Field(base: base, field: field, ..) -> self.place_from_expr(base).map(fn(place: ViewPlace) {
                result := ^place
                result.projections.push(ViewProjection.Field(~field))
                ^result
            })
        }
        if place == .Val(place) -> self.check_place_change(place, action, target.span())
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2518
    pub fn validate_shared_guard_lvalue(self: &Self, target: &LValue) {
        if target == {
            .Local(..) -> {}
            .Index(base: base, span: span, ..) -> _ :: self.reject_read_shared_guard_write(base, span)
            .Field(base: base, field: field, span: span) -> {
                expr :: Expr.Field(~base, ~field, span)
                _ :: self.reject_read_shared_guard_write(expr, span)
            }
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2534
    pub fn check_owner_change(self: &Self, owner: String, action: String, span: Span) {
        owner_place :: ViewPlace{owner: self.owner_id(owner), projections: []}
        self.check_place_change(owner_place, action, span)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2545
    pub fn check_place_read(self: &Self, expr: &Expr, span: Span) {
        place :: self.place_from_expr(expr) ?? return
        if expr_root_ident(expr) == .Val(root) {
            if self.is_write_view(root) -> return
        }
        // Suppress only an ancestor base of a deeper checked projection. A view
        // at or above this place still covers the read and must be reported.
        base_of_deeper_projection :: self.suppress_partial_move_root_read
        conflict :: view_facts_newest_first(self.flow.views).find(entry -> {
            name :: entry.0
            fact :: entry.1
            self.view_is_live_now(name) && fact.access == ViewAccess.Write && fact.place.overlaps(place) && fact.invalidated == None && !(base_of_deeper_projection && place.projections.len() < fact.place.projections.len())
        }).map(entry -> (~entry.0, Self.place_name(entry.1.place), entry.1.kind)) ?? return
        view :: conflict.0
        place_name :: conflict.1
        read_name :: Self.place_name(place)
        window :: if conflict.2 == ViewKind.Pin { "pin" } else { "exclusive write window" }
        self.diags.push(Diagnostic.error("E0220", "`{read_name}` cannot be read while `{view}` has a live {window} into it", "`{view}` is an exclusive window into `{place_name}`; reading the owner beside that window would be rejected after lowering", "read or edit through `{view}` instead of `{read_name}`", Val(span)))
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2595
    fn check_place_change(self: &Self, changed: &ViewPlace, action: String, span: Span) {
        self.check_place_change_with_view_exemption(changed, action, span, None)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:2599
    fn check_place_change_with_view_exemption(self: &Self, changed: &ViewPlace, action: String, span: Span, ignored_view: (String, Span, Int)?) {
        // D-CONC-FREEZE1=A: moving is legal, mutating frozen storage is not.
        if action != "be moved" && !action.contains("moved") {
            if self.frozen_for(changed.owner.name) == .Val(freeze_site) {
                self.report_frozen_write(changed.owner.name, freeze_site, action, span)
                return
            }
        }
        // A scoped task loan lasts until join, beyond lexical carrier liveness.
        if self.report_scoped_loan_conflict(changed, action, span) -> return
        conflict :: view_facts_newest_first(self.flow.views).find(entry -> {
            name :: entry.0
            fact :: entry.1
