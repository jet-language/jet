//RS     /// E1113: the typed row owns the frozen-write wording; the checker only
//RS     /// supplies the source name, operation, and freeze-site provenance.
//RS     fn report_frozen_write(&mut self, name: &str, freeze_site: Span, action: &str, span: Span) {
