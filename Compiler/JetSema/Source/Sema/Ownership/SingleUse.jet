// A `#SingleUse` value carries a job
// that has to be done exactly once, so the binding that owns it carries the
// duty to consume it on every path.
//
// The duty is one flag on the owning SemaOwnershipBindingFact; consumption is
// the ordinary whole-binding move fact, so no second flow store exists.
//   E0140  the duty reached the end of its scope undone (or `_: value`)
//   E0141  one path through a branch consumed it and another left it
//   E0142  a non-owning parameter would borrow or copy it
//   E0143  `consume(x)` discarded it outside an audited `#Unsafe` region
// Parameters never own the duty (Rust `single_use_span: None`). A value that
// holds a task handle owes its job the same way (Rust `type_is_single_use`
// over `type_requires_owned_iteration`); a bare task's job is `join`, so its
// undone duty is L1101 rather than E0140.
use jet_foundation.[
    AccessConvention,
    BinOp,
    Call,
    Diagnostic,
    Expr,
    Span,
    Stmt,
    Symbol,
    Type,
    UnOp,
    ast_visit_statement,
    expr_span,
]

// Rust `type_is_single_use` over the registry: a value holding a task handle,
// a `#SingleUse` struct or enum, or the Core `Delivery` handle (Rust
// `core_single_use_type`). A value that holds one of those owes its duty too:
// a List, Option, Result, Map, tuple or generic type argument that holds a
// duty is dropped only once every duty inside it is done.
sema_single_use_type: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    if sema_stmt_for_in_type_requires_owned_iteration(ty) -> return true
    if ty == {
        .Named(name) -> return sema_single_use_declared(name, environment, program)
        .Apply(name, args) -> {
            if name == "View" || name == "ViewMut" -> return false
            if sema_single_use_declared(name, environment, program) -> return true
            loop arg in args {
                if sema_single_use_type(arg, environment, program) -> return true
            }
            return false
        }
        .List(inner) | .FixedList(inner, _) | .Option(inner) -> return sema_single_use_type(inner, environment, program)
        .Result(ok, err) -> return sema_single_use_type(ok, environment, program) || sema_single_use_type(err, environment, program)
        .Map(key, _, value) -> return sema_single_use_type(key, environment, program) || sema_single_use_type(value, environment, program)
        .Tuple(fields) -> {
            loop field in fields {
                if sema_single_use_type(field.ty, environment, program) -> return true
            }
            return false
        }
        .Int | .Float | .Bool | .String | .Char | .Shared(_) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return false
    }
}

// A `#SingleUse` struct or enum by name, or the Core `Delivery` handle.
sema_single_use_declared: fn(name: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    if name == "Delivery" -> return true
    definition: sema_serde_type_definition(environment, program, name) ?? return false
    definition.single_use
}

// Rust `is_task_type`: the task handle itself.
sema_single_use_is_task: fn(ty: Type) -> Bool Never! {
    if ty == .Apply(name, _) -> return name == "Task"
    false
}

// A binding that owns a `#SingleUse` value carries the consume duty.
// The duty transfers on `y: x`: the move marks `x` consumed and `y` owns it.
// `key` is the binding's symbol key.
sema_single_use_note_binding: fn(state: &SemaOwnershipState, symbol: Symbol, key: String, environment: SemaScopeEnvironment, program: SemaProgramTables) {
    ty: symbol.ty ?? return
    if !sema_single_use_type(ty, environment, program) -> return
    row: sema_ownership_last_row(state, key)
    if row < 0 -> return
    sema_ownership_set_single_use(state, row)
    if sema_single_use_is_task(ty) -> state.declarations[row].owes_join = true
}

// E0140 `_: value` skips the job of a `#SingleUse` value.
// A discarded task skips its join instead (L1101), except inside a
// `task.group` spawn, whose group joins it.
sema_single_use_check_discard: fn(ty: Type, span: Span, in_taskgroup_spawn: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) {
    if sema_single_use_is_task(ty) && !in_taskgroup_spawn {
        diagnostics.push(sema_single_use_diag_unjoined("this task", "discarding it into `_` skips the join before the task finishes", span))
        return
    }
    if sema_single_use_type(ty, environment, program) -> diagnostics.push(sema_single_use_diag_discarded(span))
}

sema_single_use_key: fn(state: SemaOwnershipState, key: String) -> Bool Never! {
    row: sema_ownership_first_row(state, key)
    row >= 0 && state.declarations[row].single_use
}

// The name of a bare identifier argument whose binding owns a consume duty.
sema_single_use_argument: fn(state: SemaOwnershipState, expr: Expr, scopes: SemaScopeTable) -> String? {
    if expr == .Ident(name, span, _) {
        index: sema_scope_resolve_index_at(scopes, name, span) ?? return None
        if sema_single_use_key(state, scopes.bindings[index].key) -> return Val(name)
    }
    None
}

// E0142: only an owning (`&&`) parameter may receive a `#SingleUse` value.
sema_single_use_check_argument: fn(state: SemaOwnershipState, callee: String, param_convention: AccessConvention, expr: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if param_convention == AccessConvention.Move -> return true
    name: sema_single_use_argument(state, expr, scopes) ?? return true
    diagnostics.push(sema_single_use_diag_aliased(name, callee, expr_span(expr)))
    false
}

// Consumption is a move of the whole binding (Rust `moved.contains(name)`).
sema_single_use_moved: fn(state: SemaOwnershipState, key: String) -> Bool Never! {
    sema_single_use_moved_in(state.moved, key)
}

sema_single_use_moved_in: fn(moved: [SemaOwnershipMovedPlace], key: String) -> Bool Never! {
    loop fact in moved {
        if fact.place.root_key == key && fact.place.projections.len() == 0 -> return true
    }
    false
}

// Rust `check_single_use_consumed_in_current_scope`: E0140 for each
// `#SingleUse` binding of the closing scope that is not consumed; an unjoined
// task handle is L1101.
sema_single_use_check_scope_end: fn(state: SemaOwnershipState, diagnostics: &[Diagnostic]) {
    loop row in sema_ownership_single_use_rows(state) {
        fact: state.declarations[row]
        if fact.active && fact.scope_depth >= state.scope_depth && !sema_single_use_moved(state, fact.key) {
            if fact.owes_join {
                diagnostics.push(sema_single_use_diag_unjoined(fact.name, "the program may end before this task finishes", fact.span))
            } else {
                diagnostics.push(sema_single_use_diag_unconsumed(fact.name, fact.span))
            }
        }
    }
}

// E0140 at a `return`: the function (or lambda) hands control back while a
// `#SingleUse` binding it owns still owes its job. `frame_depth` is the scope
// depth of that function's own frame, so an enclosing function's bindings,
// seen from a lambda, are not this return's. A task still owes `join` through
// L1101 at scope end instead. A reported duty is cleared on this path, so the
// scope end doesn't report it again.
sema_single_use_check_return: fn(state: &SemaOwnershipState, frame_depth: Int, span: Span, diagnostics: &[Diagnostic]) {
    loop row in sema_ownership_single_use_rows(state) {
        if !state.declarations[row].active || state.declarations[row].owes_join || state.declarations[row].scope_depth < frame_depth -> next
        if sema_single_use_moved(state, state.declarations[row].key) -> next
        diagnostics.push(sema_single_use_diag_returned(state.declarations[row].name, span))
        sema_ownership_note_undo(state, row)
        state.declarations[row].single_use = false
    }
}

// Rust `pop_scope`: the scope-end duty check, then the lexical scope exit.
sema_single_use_leave_scope: fn(scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) {
    sema_single_use_check_scope_end(state, diagnostics)
    sema_scope_leave(scopes, state)
}

// A drain loop discharges a list's consume duty: `loop xs.len() > 0 { … }`
// (or `xs.len() != 0`, `0 < xs.len()`, `!xs.is_empty()`) whose body names
// `xs` only to pop it or ask its length, and never breaks out, ends only once
// `xs` is empty. Each popped element's duty passed to the binding that popped
// it, so `xs` owes nothing. A body that refills `xs`, hands it elsewhere or
// may break keeps the duty (E0140 at scope end).
sema_single_use_note_drain: fn(state: &SemaOwnershipState, condition: Expr, body: [Stmt], scopes: SemaScopeTable) {
    receiver: sema_single_use_drained_receiver(condition) ?? return
    if receiver == .Ident(name, span, _) {
        if sema_stmt_refutable_loop_body_can_break(body) -> return
        drain := SemaSingleUseDrain{name: name, mentions: 0, reads: 0, pops: 0}
        loop statement in body -> ast_visit_statement(statement, fn(expression: Expr) { drain.visit(expression) }, true)
        if drain.pops == 0 || drain.mentions != drain.reads -> return
        index: sema_scope_resolve_index_at(scopes, name, span) ?? return
        row: sema_ownership_last_row(state, scopes.bindings[index].key)
        if row < 0 || !state.declarations[row].single_use -> return
        sema_ownership_note_undo(state, row)
        state.declarations[row].single_use = false
    }
}

// The list a loop condition waits to empty: `xs` in `xs.len() > 0`,
// `xs.len() != 0`, `0 < xs.len()` or `!xs.is_empty()`.
sema_single_use_drained_receiver: fn(condition: Expr) -> Expr? Never! {
    if condition == {
        .Binary(op, left, right, _, _) -> {
            if (op == BinOp.Gt || op == BinOp.Ne) && right == .Int(value, _, _, _, _) && value == 0 -> return sema_single_use_query_receiver(left, "len")
            if op == BinOp.Lt && left == .Int(value, _, _, _, _) && value == 0 -> return sema_single_use_query_receiver(right, "len")
            None
        }
        .Unary(op, operand, _, _) -> if op == UnOp.Not -> sema_single_use_query_receiver(operand, "is_empty") else -> None
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_single_use_query_receiver: fn(expression: Expr, query: String) -> Expr? Never! {
    if expression == .MethodCall(receiver, method, _, _, _, args, _) && method == query && args.len() == 0 -> return Val(receiver)
    None
}

// The local a method receiver names, through any `&` place marker.
sema_single_use_receiver_name: fn(expression: Expr) -> String? Never! {
    if expression == {
        .Ident(name, _, _) -> Val(name)
        .Place(value, _, _, _) -> sema_single_use_receiver_name(value)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// Counts a drain body's mentions of the drained list `name`: every mention
// must be a read (the receiver of `pop`, `len` or `is_empty`), and at least
// one a `pop`.
SemaSingleUseDrain: struct {
    name: String
    mentions: Int
    reads: Int
    pops: Int

    visit: fn(&self, expression: Expr) Never! {
        if expression == {
            .Ident(mentioned, _, _) -> if mentioned == self.name -> self.mentions += 1
            .MethodCall(receiver, method, _, _, _, args, _) -> {
                if sema_single_use_receiver_name(receiver) == .Val(owner) && owner == self.name && args.len() == 0 {
                    if method == "pop" {
                        self.reads += 1
                        self.pops += 1
                    } else if method == "len" || method == "is_empty" {
                        self.reads += 1
                    }
                }
            }
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
        }
    }
}

// Which single-use rows of `before` (sema_ownership_single_use_rows, in
// order) `path` moves. A branch's path is read in place, so the check below
// never copies a path to list it.
sema_single_use_path_moves: fn(before: SemaOwnershipState, path: SemaOwnershipPath) -> [Bool] Never! {
    moves := [Bool]{}
    loop row in sema_ownership_single_use_rows(before) -> moves.push(sema_single_use_moved_in(path.moved, before.declarations[row].key))
    moves
}

// E0141. The merged move store is a union, so a value
// consumed on only one path would look consumed after the branch. Compare
// the paths that reach the merge directly, over the bindings of the current
// scope that were unconsumed before the branch. `before` is the state of the
// branch's fork (rolled back); `paths` holds sema_single_use_path_moves of
// each path that reaches the merge, taken over that same state.
sema_single_use_check_paths: fn(before: SemaOwnershipState, paths: [[Bool]], diagnostics: &[Diagnostic]) {
    loop (index, row) in sema_ownership_single_use_rows(before) {
        fact: before.declarations[row]
        if !fact.active || fact.scope_depth != before.scope_depth -> next
        if sema_single_use_moved(before, fact.key) -> next
        consumed := false
        kept := false
        loop moves in paths {
            if {
                moves[index] -> consumed = true
                else -> kept = true
            }
        }
        if consumed && kept -> diagnostics.push(sema_single_use_diag_branch(fact.name, fact.span))
    }
}

// `consume(x)` moves one value to nowhere, running its cleanup.
// Discarding a `#SingleUse` value this way is legal only in an audited
// `#Unsafe("reason")` region or function (E0143). The value is consumed even
// on the E0143 path, so no E0140 cascades at scope end.
sema_single_use_check_consume: fn(call: Call, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if call.args.len() != 1 {
        diagnostics.push(sema_error("E0103", call.name_span, "`consume` discards exactly one value", "`drop` throws a single value away, running its cleanup", "e.g. consume(x)"))
        loop argument_index in 0..<call.args.len() -> _ := sema_check_expression(call.args[argument_index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    argument: call.args[0]
    value: sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if argument.expr == .Ident(name, span, _) {
        if context.unsafe_depth == 0 && sema_single_use_argument(state, argument.expr, scopes) != None {
            diagnostics.push(sema_single_use_diag_unaudited(name, span))
        }
        if !sema_ownership_mark_move(state, argument.expr, scopes, "`consume`", diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    }
    SemaDirectSpecialCheck{handled: true, value: Val(sema_tree_node(Type.Named{name: "Unit"}, TExprKind.Drop{value: value}, call.name_span))}
}

// Every diagnostic about a value's debt has one shape: "`name` still owes
// `consume`" (or `join`, or a use), then how this site falls short.
sema_single_use_diag_unconsumed: fn(name: String, span: Span) -> Diagnostic {
    sema_error("E0140", span, "`{name}` still owes `consume`", "this value's type is `#SingleUse`, so it carries a job that has to be done — dropping it without doing that job leaves the work undone (an unjoined task, an unreleased lock)", "consume it exactly once: pass it to a `&&` parameter, or `return` it — or write `#Unsafe(\"reason\") {{ consume({name}) }}` to discard it deliberately")
}

sema_single_use_diag_discarded: fn(span: Span) -> Diagnostic {
    sema_error("E0140", span, "this value still owes `consume`", "this value's type is `#SingleUse`, so it carries a job that has to be done — discarding it into `_` skips that job before it's done", "bind it to a name, then consume it exactly once — or write `#Unsafe(\"reason\") {{ consume(...) }}` to discard it deliberately")
}

sema_single_use_diag_returned: fn(name: String, span: Span) -> Diagnostic {
    sema_error("E0140", span, "`{name}` still owes `consume`, but this `return` leaves with it undone", "this value's type is `#SingleUse`, so its job has to be done before the function hands control back — returning here leaves the work undone (an open transaction, an unreleased lock)", "consume `{name}` before this `return` (commit or roll back the transaction, release the lock), or return it")
}

sema_single_use_diag_branch: fn(name: String, span: Span) -> Diagnostic {
    sema_error("E0141", span, "`{name}` still owes `consume` on one path through this `if`", "a `#SingleUse` value has to be used on every path — here it is consumed on one branch but not the other, so the program could reach the end of its scope without doing its job", "use `{name}` exactly once on every branch: consume it in the missing arm, or move it out before the `if`")
}

sema_single_use_diag_aliased: fn(name: String, callee: String, span: Span) -> Diagnostic {
    sema_error("E0142", span, "`{name}` still owes `consume`, so it can't be shared", "this value's type is `#SingleUse`, so it can only be moved (handed over for good); `{callee}` would borrow or copy it, and a `#SingleUse` value has no second use to give", "give it away with `{name}.move()`, or rework `{callee}` so it takes ownership with a `&&` parameter")
}

sema_single_use_diag_unaudited: fn(name: String, span: Span) -> Diagnostic {
    sema_error("E0143", span, "`{name}` still owes `consume`, and discarding it needs an audited reason", "this value's type is `#SingleUse`, so it carries a job that has to be done; deliberately throwing it away skips that job, which is exactly the kind of decision that has to be written down", "wrap it in an audited region: `#Unsafe(\"why discarding this is fine\") {{ consume({name}) }}`")
}

// (Rust `l1101_unjoined_task`): one duty voice
// for every task-owes-join site.
sema_single_use_diag_unjoined: fn(subject: String, why: String, span: Span) -> Diagnostic {
    sema_error("L1101", span, "`{subject}` still owes `join`", why, "join it with `.join()`, use its result, or write `.detach()` to let it go free")
}
