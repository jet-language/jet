// Multi-head normalization: one module's ordered heads of one function name
// fold into one pattern table before registration.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    Diagnostic,
    Expr,
    Func,
    Item,
    Param,
    ParamZone,
    Pattern,
    Span,
    Stmt,
    SwitchArm,
    Type,
    VariantPayload,
    type_name,
]

SemaHeadPatternVariant: struct {
    name: String
    enum_name: String
    payload: VariantPayload
}

SemaHeadPatternGroup: struct {
    name: String
    heads: [Func]
}

SemaHeadPatternOrderedItem: enum {
    Item(item: Item)
    Heads(group_index: Int)
}

sema_head_pattern_pattern_span: fn(pattern: Pattern) -> Span {
    if pattern == {
        .Variant(_, _, _, span) | .Present(_, _, _, span) | .Absent(span) | .Ok(_, _, _, span) | .Err(_, _, _, span) | .Range(_, _, span) | .Or(_, span) | .Struct(_, _, span, _) | .List(_, _, span) | .Map(_, _, span) | .StrMatch(_, span) | .BinMatch(_, span) -> span
    }
}

sema_head_pattern_payload_types: fn(payload: VariantPayload) -> [Type] Never! {
    types := [Type]{}
    if payload == {
        .Unit -> {}
        .Single(ty, _) -> types.push(ty.copy())
        .Named(fields) -> loop field in fields -> types.push(field.ty)
    }
    types
}

sema_head_pattern_fold_function: fn(heads: [Func], variants: [SemaHeadPatternVariant], diagnostics: &[Diagnostic]) -> Func {
    folded := heads[0]
    enum_name := String?{None}
    invalid := false
    arms := [SwitchArm]{}

    loop head in heads {
        pattern: head.head_pattern ?? {
            invalid = true
            next
        }
        pattern_span := sema_head_pattern_pattern_span(pattern)
        variant_name := String?{None}
        if pattern == {
            .Variant(name, _, _, _) -> variant_name = Val(name)
            else -> {}
        }
        if variant_name == None {
            diagnostics.push(sema_error("E0305", pattern_span, "a multi-head declaration needs an enum variant head", "multi-head coverage is proved by the enum pattern table", "write a variant head such as `Circle(radius: Float)`"))
            invalid = true
            next
        }
        variant: variant_name ?? ""

        candidate := SemaHeadPatternVariant?{None}
        candidate_enum := ""
        candidate_payload := VariantPayload.Unit
        ambiguous := false
        loop row in variants {
            if row.name == variant {
                if {
                    candidate == None -> {
                        candidate = Val(row)
                        candidate_enum = row.enum_name
                        candidate_payload = row.payload
                    }
                    row.enum_name != candidate_enum -> {
                        ambiguous = true
                    }
                }
            }
        }
        if candidate == None {
            diagnostics.push(sema_error("E0305", pattern_span, "multi-head variant `{variant}` is not an enum variant", "a multi-head table can only cover variants declared by an enum", "check the variant spelling or declare the enum first"))
            invalid = true
            next
        }
        if ambiguous {
            diagnostics.push(sema_error("E0305", pattern_span, "multi-head variant `{variant}` is ambiguous", "a bare head must identify one enum so one table subject can be typed", "use one enum's variants for this function name"))
            invalid = true
        }
        if {
            enum_name == None -> {
                enum_name = Val(candidate_enum)
            }
            else -> {
                previous: enum_name ?? candidate_enum
                if previous != candidate_enum {
                    diagnostics.push(sema_error("E0305", pattern_span, "multi-head variants `{previous}` and `{variant}` belong to different enums", "one function has one argument type and one coverage table", "put heads for one enum under one function name"))
                    invalid = true
                }
            }
        }

        expected := sema_head_pattern_payload_types(candidate_payload)
        payload_index := 0
        loop payload_index < head.params.len() && payload_index < expected.len() {
            parameter := head.params[payload_index]
            expected_type := expected[payload_index]
            if parameter.ty != expected_type {
                diagnostics.push(sema_error("E0305", parameter.ty_span, "multi-head binding `{parameter.name}` has type `{type_name(parameter.ty)}` but variant `{variant}` carries `{type_name(expected_type)}`", "head bindings must use the variant payload types", "write `{type_name(expected_type)}` for this binding"))
                invalid = true
            }
            payload_index += 1
        }

        subject := Expr.Ident{name: "__jet_multi_head_subject", span: folded.name_span, id: AST_NODE_GENERATED}
        arms.push(SwitchArm{
            cond: Expr.PatternTest{subject: subject, pattern: pattern, span: pattern_span, id: AST_NODE_GENERATED},
            body: head.body,
            span: pattern_span,
        })
    }

    if invalid || enum_name == None {
        folded.head_pattern = None
        return folded
    }
    enum_name_value: enum_name ?? ""
    last_head := heads[heads.len() - 1]
    full_span := Span{start: folded.span.start, end: last_head.span.end}
    subject_name := "__jet_multi_head_subject"
    subject := Expr.Ident{name: subject_name, span: folded.name_span, id: AST_NODE_GENERATED}
    folded.params = [Param]{Param{
        convention: AccessConvention.Read,
        root: false,
        name: subject_name,
        name_span: folded.name_span,
        public_label: None,
        zone: ParamZone.Either,
        ty: Type.Named{name: enum_name_value},
        ty_span: folded.name_span,
        default: None,
        variadic: false,
        variadic_bound_list: None,
        declared_view_from_names: None,
        declared_footprint: None,
    }}
    folded.body = [Stmt]{Stmt.Switch{subject: subject, arms: arms, else_body: None, span: folded.name_span}}
    folded.span = full_span
    folded.return_view_provenance = None
    folded.declared_return_view_provenance = None
    folded.head_pattern = None
    folded
}

// Folds each ordered group of multi-head declarations in one module's items
// into one function over the enum its heads name, at the first head's
// position. Variants come from the module's enums. Items without a head
// pattern are left in place, uncopied.
sema_head_patterns_fold_items: fn(items: &[Item], diagnostics: &[Diagnostic]) Never! {
    has_heads := false
    variants := [SemaHeadPatternVariant]{}
    loop item in items {
        if item == {
            .Enum(definition) -> loop variant in definition.variants -> variants.push(SemaHeadPatternVariant{name: variant.name, enum_name: definition.name, payload: variant.payload})
            .Func(function) -> {
                if function.head_pattern != None -> has_heads = true
            }
            else -> {}
        }
    }
    if !has_heads -> return
    groups := [SemaHeadPatternGroup]{}
    ordered := [SemaHeadPatternOrderedItem]{}
    loop item in items {
        head := Func?{None}
        if item == .Func(function) {
            if function.head_pattern != None -> head = Val(function)
        }
        if head == .Val(function) {
            group_index := 0
            loop group_index < groups.len() && groups[group_index].name != function.name -> group_index += 1
            if group_index == groups.len() {
                groups.push(SemaHeadPatternGroup{name: function.name, heads: [Func]{}})
                ordered.push(SemaHeadPatternOrderedItem.Heads{group_index: group_index})
            }
            groups[group_index].heads.push(function)
            next
        }
        ordered.push(SemaHeadPatternOrderedItem.Item{item: item})
    }
    folded := [Item]{}
    loop entry in ordered {
        if entry == {
            .Item(item) -> folded.push(item)
            .Heads(group_index) -> folded.push(Item.Func{value: sema_head_pattern_fold_function(groups[group_index].heads, variants, diagnostics)})
        }
    }
    items = folded
}
