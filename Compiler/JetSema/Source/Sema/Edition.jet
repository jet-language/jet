// Package-edition lifecycle diagnostics; payloads belong to the written marker.
use jet_foundation.[Diagnostic, Span, TextEdit, Deprecation, StructureFact, StructureFactKind]
use jet_foundation.PackageEdition as PackageEdition
use jet_foundation.Syntax as Syntax

// Rust: crates/jet-sema/src/Sema/Edition.rs:10
pub fn with_package_edition<R>(edition: String, f: fn() -> R) -> R Never! {
    PackageEdition.with_package_edition<R>(edition, f)
}
// Rust: crates/jet-sema/src/Sema/Edition.rs:14
pub fn package_edition() -> String Never! { PackageEdition.package_edition() }
// Rust: crates/jet-sema/src/Sema/Edition.rs:18
pub fn edition_at_least(baseline: String) -> Bool Never! { PackageEdition.package_edition_at_least(baseline) }
// Rust: crates/jet-sema/src/Sema/Edition.rs:22
fn is_edition_label(label: String) -> Bool Never! {
    trimmed := label.trim() // #4303
    trimmed.len() == 4 && trimmed.bytes().all(fn(byte) { byte.is_ascii_digit() })
}
// Rust: crates/jet-sema/src/Sema/Edition.rs:27
fn version_phrase(label: String) -> String Never! {
    if is_edition_label(label) -> "edition {label}" else -> label
}
// Rust: crates/jet-sema/src/Sema/Edition.rs:39
fn replacement_edit(dep: Deprecation, span: Span?) -> TextEdit? Never! {
    location :: span ?? return None
    leaf :: dep.replacement.rsplit('.').next() ?? return None
    replacement := leaf.trim() // #4303
    if replacement.is_empty() -> return None
    loop (index, byte) in replacement.bytes().enumerate() {
        if !(byte == U8{95} || (byte.is_ascii_alphanumeric() && (index > 0 || byte.is_ascii_alphabetic() || byte == U8{95}))) -> return None
    }
    Val(TextEdit{span: location, new_text: replacement.to_string()})
}
// Rust: crates/jet-sema/src/Sema/Edition.rs:57
pub fn deprecation_phase(dep: Deprecation) -> DeprecationPhase Never! {
    edition :: package_edition()
    if dep.removed_in == .Val(removed) {
        if is_edition_label(removed) && PackageEdition.edition_at_least(edition, removed) -> return DeprecationPhase.Removed
    }
    if is_edition_label(dep.since) && !PackageEdition.edition_at_least(edition, dep.since) -> DeprecationPhase.Active else -> DeprecationPhase.Deprecated
}
// Rust: crates/jet-sema/src/Sema/Edition.rs:75
pub enum DeprecationPhase { Active Deprecated Removed }
// Rust: crates/jet-sema/src/Sema/Edition.rs:81
pub fn e2002(item: String, dep: Deprecation, span: Span?) -> Diagnostic Never! {
    removed_in :: dep.removed_in ?? "this edition"
    diagnostic := Diagnostic.error("E2002", "`{item}` was removed in {version_phrase(removed_in)}", "`{item}` was deprecated in {version_phrase(dep.since)} and no longer exists in this edition; it has reached the end of its migration window.", "use `{dep.replacement}` instead, or run `{Syntax.BINARY_NAME} fix` to migrate automatically.", span)
    if replacement_edit(dep, span) == .Val(edit) -> return diagnostic.with_edit(edit)
    diagnostic
}
// Rust: crates/jet-sema/src/Sema/Edition.rs:102
pub fn l2001(item: String, dep: Deprecation, span: Span?) -> Diagnostic Never! {
    why :: if dep.removed_in == {
        .Val(removed_in) -> "`{item}` was deprecated in {version_phrase(dep.since)} and will be removed in {version_phrase(removed_in)}; it still works for now but should be migrated."
        .None -> "`{item}` was deprecated in {version_phrase(dep.since)}; it still works for now but should be migrated."
    }
    diagnostic := Diagnostic.lint("L2001", "`{item}` is deprecated", why, "use `{dep.replacement}` instead, or run `{Syntax.BINARY_NAME} fix` to migrate automatically.", span)
    if replacement_edit(dep, span) == .Val(edit) -> return diagnostic.with_edit(edit)
    diagnostic
}
impl Checker {
    // Rust: crates/jet-sema/src/Sema/Edition.rs:133
    pub fn check_deprecation(&self, item: String, dep: Deprecation, span: Span) Never! {
        phase :: deprecation_phase(dep)
        status :: if phase == { .Active -> "active"; .Deprecated -> "deprecated"; .Removed -> "removed" }
        detail :: if dep.removed_in == {
            .Val(removed_in) -> "since {dep.since}; use `{dep.replacement}`; removed in {removed_in}"
            .None -> "since {dep.since}; use `{dep.replacement}`"
        }
        &self.name_ledger.record_structure_fact(StructureFact.new(StructureFactKind.Lifecycle, item, self.module_path, span, status, detail, None))
        if phase == {
            .Removed -> &self.diags.push(e2002(item, dep, Val(span)))
            .Deprecated -> &self.diags.push(l2001(item, dep, Val(span)))
            .Active -> {}
        }
    }
}
