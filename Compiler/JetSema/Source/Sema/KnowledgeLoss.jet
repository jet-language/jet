// D-FACT-LAW1=B / D-FACT-WORD1=A: compile-time-only knowledge boundary.
use jet_foundation.[Diagnostic, Span]
use jet_foundation.Syntax

// Rust: crates/jet-sema/src/Sema/KnowledgeLoss.rs:16
pub enum KnowledgeGate {
    BoundedArithmetic
    Approximation
    RoundedConversion
    RawProjection
    StateTransition
    ClassificationScrub
}
impl KnowledgeGate {
    // Rust: crates/jet-sema/src/Sema/KnowledgeLoss.rs:26
    pub fn spelling(self: Self) -> String {
        if self == {
            .BoundedArithmetic -> Syntax.BUILTIN_WRAPPING
            .Approximation -> Syntax.BUILTIN_APPROX
            .RoundedConversion -> "rounded"
            .RawProjection -> Syntax.METHOD_DISTINCT_RAW
            .StateTransition -> Syntax.KW_TRANSITION
            .ClassificationScrub -> Syntax.KW_SCRUB
        }
    }
    // Rust: crates/jet-sema/src/Sema/KnowledgeLoss.rs:37
    pub fn permits(self: Self, plane: KnowledgePlane) -> Bool {
        if (plane, self) == {
            (.Range, .BoundedArithmetic | .RawProjection)
                | (.Exactness, .Approximation | .RoundedConversion | .RawProjection)
                | (.Unit, .RoundedConversion | .RawProjection)
                | (.State, .StateTransition | .RawProjection)
                | (.Classification, .ClassificationScrub | .RawProjection) -> true
            _ -> false
        }
    }
}
// Rust: crates/jet-sema/src/Sema/KnowledgeLoss.rs:58
pub enum KnowledgePlane {
    Range
    Exactness
    Unit
    State
    Classification
}
impl KnowledgePlane {
    // Rust: crates/jet-sema/src/Sema/KnowledgeLoss.rs:67
    pub fn name(self: Self) -> String {
        if self == {
            .Range -> "range"
            .Exactness -> "exactness"
            .Unit -> "unit"
            .State -> "state"
            .Classification -> "classification"
        }
    }
}
// Rust: crates/jet-sema/src/Sema/KnowledgeLoss.rs:82
pub fn requires_gate(plane: KnowledgePlane, gate: KnowledgeGate?) -> Bool {
    if gate == .Val(gate) -> !gate.permits(plane) else -> true
}
// Rust: crates/jet-sema/src/Sema/KnowledgeLoss.rs:86
pub fn allows_gate(plane: KnowledgePlane, gate: KnowledgeGate) -> Bool { gate.permits(plane) }
// Rust: crates/jet-sema/src/Sema/KnowledgeLoss.rs:90
pub fn diagnostic(plane: KnowledgePlane, gate: String, span: Span) -> Diagnostic {
    Diagnostic.from_row("E0156", [("plane", plane.name()), ("gate", gate)], Val(span))
}
