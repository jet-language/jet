// An exact number's operations run core.math's own source. A checked precise
// operation on a Decimal, Fraction or Complex (`a + b`, `d.to_float()`, a
// literal's constructor, a Complex magnitude) names the type and the
// operation; the core.math function that runs it fills the jet_builtins role
// of the two (sema_precise_role: `Decimal` `add` is DecimalAdd). Once a body
// is checked, each such operation whose role a core.math function fills
// becomes a direct call of it, so Core demand, reachability and lowering
// follow it as any other call. The rest stay the operation, which JetIR
// lowers: a Fraction `/`, whose zero divisor stops at the operator's own line
// before Core runs (ir_precise_division), and, in a program without
// core.math, every one, through its runtime route (ir_precise_route).
use jet_foundation.[BodyCallArg, BodyHandleOp, BodyTree, NodeKind, SymbolID, Type, module_is_core, sema_casing_pascal_words, sema_casing_snake_words]

// The types whose checked operations run core.math functions.
SEMA_PRECISE_TYPES: [String]{"Decimal", "Fraction", "Complex"}

// The jet_builtins role of the core.math function that runs `operation` of
// precise type `owner`: the type, then the operation's words (`Fraction`
// `try_int` is FractionTryInt).
sema_precise_role: fn(owner: String, operation: String) -> String Never! {
    "{owner}{sema_casing_pascal_words(operation)}"
}

// A precise type and one of its operations.
SemaPreciseRole: struct {
    owner: String,
    operation: String,
}

// The precise type and operation whose core.math function fills `role`
// (sema_precise_role), or None for any other role.
sema_precise_role_operation: fn(role: String) -> SemaPreciseRole? Never! {
    loop owner in SEMA_PRECISE_TYPES {
        if role.len() <= owner.len() || !role.starts_with(owner) -> next
        operation: sema_casing_snake_words(role.slice(owner.len(), role.len()))
        if sema_precise_role(owner, operation) == role -> return Val(SemaPreciseRole{owner: owner, operation: operation})
    }
    None
}

// A checked precise operation: the role of the core.math function that would
// run it and the nodes it passes, in order (a method's receiver first).
SemaPreciseOperation: struct {
    role: String,
    args: [Int],
}

// Rewrites each precise operation of the finished body `tree` whose role a
// core.math function fills into a direct call of that function.
sema_precise_bind: fn(tree: ^BodyTree, program: SemaProgramTables) Never! {
    if program.registration_graph == .Val(graph) {
        // Found on the first precise operation: most bodies hold none.
        math := -2
        fillers := [String:Int]{}
        loop index in 0..<tree.nodes.len() {
            operation: sema_precise_operation(tree.nodes[index].kind) ?? next
            if math == -2 {
                math = sema_precise_math_module(graph) ?? -1
                if math >= 0 -> fillers = sema_precise_fillers(graph, math)
            }
            if math < 0 -> return
            filler: fillers.get(operation.role) ?? next
            export: sema_registration_direct_symbol(graph.modules[math], graph.modules[math].functions[filler].declaration.name) ?? next
            callee: sema_registration_callable_id(graph, export.symbol.id) ?? next
            args: loop argument in operation.args -> BodyCallArg{value: argument, template_items: [SymbolID]{}, borrow: false, mut_borrow: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false}
            tree.nodes[index].kind = NodeKind.Call{callee: callee, type_args: [Type]{}, args: args}
        }
    }
}

// The row in core.math's functions (registration row `math`) of each
// function that fills a precise operation's role, by that role.
sema_precise_fillers: fn(graph: SemaRegistrationGraph, math: Int) -> [String:Int] Never! {
    fillers := [String:Int]{}
    module_row: graph.modules[math]
    loop (position, function) in module_row.functions {
        if function.declaration.markers.len() == 0 -> next
        role: sema_core_role(function.declaration.markers, graph, module_row.module_identity)
        if sema_precise_role_operation(role) != None -> fillers[role] = position
    }
    fillers
}

// The registration row of the loaded core.math module, or None.
sema_precise_math_module: fn(graph: SemaRegistrationGraph) -> Int? Never! {
    loop index in 0..<graph.modules.len() {
        if graph.modules[index].module_name == "core.math" && module_is_core(graph.modules[index].module_identity) {
            return Val(index)
        }
    }
    None
}

// The precise operation node `kind` holds, or None for any other node.
sema_precise_operation: fn(kind: NodeKind) -> SemaPreciseOperation? Never! {
    if kind == .PreciseBuiltin(type_name, function, args) {
        return sema_precise_operation_of(type_name, function, -1, args)
    }
    if kind == .MathBuiltin(type_name, function, args) {
        if type_name == "Complex" -> return sema_precise_operation_of(type_name, function, -1, args)
        return None
    }
    if kind == .HandleMethod(receiver, operation, args) {
        if operation == .PreciseMethod(type_name, method) {
            return sema_precise_operation_of(type_name, method, receiver, args)
        }
    }
    None
}

// The operation `function` of precise type `type_name` on `receiver` (a
// method's; -1 for none) and then `args`. A Fraction `div` stays the
// operation: JetIR tests its divisor first.
sema_precise_operation_of: fn(type_name: String, function: String, receiver: Int, args: [Int]) -> SemaPreciseOperation? Never! {
    if !SEMA_PRECISE_TYPES.contains(type_name) -> return None
    if type_name == "Fraction" && function == "div" -> return None
    values := [Int]{}
    if receiver >= 0 -> values.push(receiver)
    loop argument in args -> values.push(argument)
    Val(SemaPreciseOperation{role: sema_precise_role(type_name, function), args: values})
}

#Test("a precise operation runs the core.math function that fills its type's and operation's role") {
    assert_eq(sema_precise_role("Fraction", "from_owned_parts"), "FractionFromOwnedParts")
    assert_eq(sema_precise_role_operation("DecimalToFloat"), Val(SemaPreciseRole{owner: "Decimal", operation: "to_float"}))
    assert_eq(sema_precise_role_operation("FractionTryInt"), Val(SemaPreciseRole{owner: "Fraction", operation: "try_int"}))
    assert_eq(sema_precise_role_operation("ComplexAbs"), Val(SemaPreciseRole{owner: "Complex", operation: "abs"}))
    assert_eq(sema_precise_role_operation("Decimal"), None)
    assert_eq(sema_precise_role_operation("AbsF32"), None)
    operation: sema_precise_operation(NodeKind.PreciseBuiltin{type_name: "Decimal", function: "add", args: [Int]{3, 4}}) ?? panic("Decimal add is a precise operation")
    assert_eq(operation.role, "DecimalAdd")
    assert_eq(operation.args, [Int]{3, 4})
    method: sema_precise_operation(NodeKind.HandleMethod{receiver: 1, operation: BodyHandleOp.PreciseMethod{type_name: "Decimal", method: "to_float"}, args: [Int]{}}) ?? panic("Decimal to_float is a precise method")
    assert_eq(method.role, "DecimalToFloat")
    assert_eq(method.args, [Int]{1})
    assert_eq(sema_precise_operation(NodeKind.MathBuiltin{type_name: "F32", function: "abs", args: [Int]{2}}), None)
    sum: sema_precise_operation(NodeKind.PreciseBuiltin{type_name: "Fraction", function: "add", args: [Int]{5, 6}}) ?? panic("Fraction add is a precise operation")
    assert_eq(sum.role, "FractionAdd")
    assert_eq(sema_precise_operation(NodeKind.PreciseBuiltin{type_name: "Fraction", function: "div", args: [Int]{5, 6}}), None)
}
