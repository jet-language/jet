// D-PROTO1 / D-PROTO2: expand protocols through the normal source frontend.
use jet_foundation.[Diagnostic, Syntax, Item, ProtocolDecl, ProtocolDirection, ProtocolMessage]
use jet_lexer.[lex]
use jet_parser.[parse]

// Rust: crates/jet-sema/src/Sema/Protocol.rs:14
pub fn expand_module_protocols(items: &[Item], diagnostics: &[Diagnostic]) {
    i := 0
    loop i < items.len() {
        declaration :: if items[i] == { .ProtocolDecl(value) -> value; else -> { i += 1; continue } }
        fragment :: generate_protocol_source(declaration)
        if lex_parse_fragment(fragment) == {
            .Ok(parsed) -> {
                mark_generated_protocol_items(&parsed)
                loop item in parsed { &items.insert(i, item); i += 1 }
            }
            .Err(_) -> &diagnostics.push(Diagnostic.error("E0153", "protocol `{declaration.name}` failed to expand into handle types", "the compiler generates `#SingleUse` `.Client`/`.Server` stubs from the protocol block — a fragment did not parse", "check the protocol declaration for typos; if this persists, file a bug", Val(declaration.name_span)))
        }
        i += 1
    }
}
// Rust: crates/jet-sema/src/Sema/Protocol.rs:53
fn mark_generated_protocol_items(items: &[Item]) {
    loop item in &items {
        if item == {
            .Impl(definition) -> {
                loop method in &definition.methods { if method.state_transition != None -> method.compiler_generated = true }
            }
            .Struct(definition) -> {
                loop method in &definition.methods { if method.state_transition != None -> method.compiler_generated = true }
            }
            .Enum(definition) -> {
                loop method in &definition.methods { if method.state_transition != None -> method.compiler_generated = true }
            }
            else -> {}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Protocol.rs:71
fn lex_parse_fragment(src: String) -> [Item] ()! {
    (tokens, diagnostics) :: lex(src)
    if !diagnostics.is_empty() -> fail ()
    if parse(tokens) == { .Ok(program) -> program.items; .Err(_) -> fail () }
}
// Rust: crates/jet-sema/src/Sema/Protocol.rs:82
fn generate_protocol_source(declaration: ProtocolDecl) -> String Never! {
    out := ""
    client :: "{declaration.name}.Client"
    server :: "{declaration.name}.Server"
    state_count :: declaration.messages.len() + 1
    states := [String]{}
    loop i in 0..state_count -> &states.push("S{i}")
    state_list :: states.join(", ")
    &out.push_str("#{Syntax.MARKER_SINGLE_USE} struct {client} {{\n    state {{ {state_list} }}\n    _token: Int,\n}}\n\n")
    &out.push_str("#{Syntax.MARKER_SINGLE_USE} struct {server} {{\n    state {{ {state_list} }}\n    _token: Int,\n}}\n\n")
    &out.push_str("impl {client} {{\n")
    &out.push_str("    #{Syntax.KW_TRANSITION}(_, S0) fn client() {client} -> {{\n        return {client}{{ _token: 0 }}\n    }}\n\n")
    loop (idx, message) in declaration.messages {
        terminal :: idx + 1 == declaration.messages.len()
        if message.direction == ProtocolDirection.ClientToServer { append_send_method(&out, client, states, idx, message, terminal) }
        else { append_recv_method(&out, client, states, idx, message, terminal) }
    }
    &out.push_str("}}\n\n")
    &out.push_str("impl {server} {{\n")
    &out.push_str("    #{Syntax.KW_TRANSITION}(_, S0) fn server() {server} -> {{\n        return {server}{{ _token: 0 }}\n    }}\n\n")
    loop (idx, message) in declaration.messages {
        terminal :: idx + 1 == declaration.messages.len()
        if message.direction == ProtocolDirection.ClientToServer { append_recv_method(&out, server, states, idx, message, terminal) }
        else { append_send_method(&out, server, states, idx, message, terminal) }
    }
    &out.push('}')
    out
}
// Rust: crates/jet-sema/src/Sema/Protocol.rs:131
fn append_send_method(out: &String, handle: String, states: [String], idx: Int, message: ProtocolMessage, terminal: Bool) {
    from :: states[idx]
    to :: states[idx + 1]
    fields :: format_fields(message)
    param_suffix :: if fields.is_empty() { "" } else { ", {fields}" }
    if terminal {
        &out.push_str("    #{Syntax.KW_TRANSITION}({from}, {to}) fn {message.name}(self: ^{handle}{param_suffix}) {{\n        return\n    }}\n\n")
    } else {
        &out.push_str("    #{Syntax.KW_TRANSITION}({from}, {to}) fn {message.name}(self: ^{handle}{param_suffix}) -> {handle} !Err {{\n        return Ok(self)\n    }}\n\n")
    }
}
// Rust: crates/jet-sema/src/Sema/Protocol.rs:162
fn append_recv_method(out: &String, handle: String, states: [String], idx: Int, message: ProtocolMessage, terminal: Bool) {
    from :: states[idx]
    to :: states[idx + 1]
    method :: "recv_{message.name}"
    if terminal {
        &out.push_str("    #{Syntax.KW_TRANSITION}({from}, {to}) fn {method}(self: ^{handle}) {{\n        return\n    }}\n\n")
    } else {
        &out.push_str("    #{Syntax.KW_TRANSITION}({from}, {to}) fn {method}(self: ^{handle}) -> {handle} !Err {{\n        return Ok(self)\n    }}\n\n")
    }
}
// Rust: crates/jet-sema/src/Sema/Protocol.rs:186
fn format_fields(message: ProtocolMessage) -> String Never! {
    fields := [String]{}
    loop field in message.fields -> &fields.push("{field.name}: {field.ty.name()}")
    fields.join(", ")
}
