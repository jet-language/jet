// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4303
fn lower_stmt_plan_comptime_block() -> LowerStmtPlan { LowerStmtPlan.ready(TStmt.Inline([])) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4308
fn lower_stmt_plan_switched(marker: jet_foundation.Marker, body: [Stmt], env: LowerEnv) -> LowerStmtPlan {
    if jet_foundation.switched_off(marker) -> return LowerStmtPlan.ready(TStmt.Inline([]))
    in_own_frame(fn() -> LowerStmtPlan {
        scoped :: clone_env(env)
        deferred_stmt([LowerBody.scoped(body, ^scoped)], fn(lowered: &[[TStmt]]) -> TStmt { TStmt.DebugOnly(lowered.pop().expect("debug body was deferred")) })
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4326
fn lower_stmt_plan_comptime_if(then_body: [Stmt], else_body: [Stmt]?, selected_then: Bool?, env: LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        chosen :: if selected_then == { Val(true) -> then_body; Val(false) -> else_body ?? []; None -> [] }
        scoped :: clone_env(env)
        deferred_stmt([LowerBody.inline(chosen, ^scoped)], fn(lowered: &[[TStmt]]) -> TStmt { TStmt.Inline(lowered.pop().expect("comptime-if body was deferred")) })
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4350
fn lower_stmt_plan_unsafe(audit: String?, body: [Stmt], span: Span, cx: Cx, env: LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        scoped :: clone_env(env)
        gate :: TUnsafeGate{file: ~cx.file, line: cx.src_line_col(span.start).0 as U32, reason: audit ?? "", enabled: env.sentries_enabled, fenced: env.sentries_fenced}
        deferred_stmt([LowerBody.scoped(body, ^scoped)], fn(lowered: &[[TStmt]]) -> TStmt { TStmt.Unsafe{gate: gate, body: lowered.pop().expect("unsafe body was deferred")} })
    })
}
