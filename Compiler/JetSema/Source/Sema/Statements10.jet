// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4382
fn lower_stmt_plan_reactive(body: [Stmt], span: Span, cx: Cx, env: LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        outer_env :: clone_env(env)
        body_env :: reactive_block_env(body, cx, env)
        reads :: block_free_var_reads(body)
        meta := LambdaMeta.default()
        meta.cloned_captures = reads.filter(fn(n) { outer_env.locals.contains_key(n) }).collect()
        &meta.cloned_captures.sort()
        meta.needs_fn_mut = true
        meta.escapes = true
        synthetic :: Lambda{take_names: [], params: [], result_type: None, error_type: None, effects: None, body: LambdaBody.Block(~body), span: span, meta: ^meta}
        deferred_stmt([LowerBody.scoped(body, ^body_env)], fn(lowered: &[[TStmt]]) -> TStmt {
            lowered_body :: lowered.pop().expect("reactive body was deferred")
            // GATE #4494: canonical refcounted shared block, not two copied body arrays.
            shared :: Arc.from(^lowered_body)
            executable :: lower_lambda_with_shared_block(synthetic, cx, outer_env, ~shared)
            jit_lambda :: lower_spawn_lambda_for_jit_with_shared_block(synthetic, cx, outer_env, ^shared)
            &cx.jit_spawn_lambdas.borrow_mut().push(^jit_lambda)
            TStmt.Reactive{executable: ^executable}
        })
    })
}
