// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4449
fn lower_stmt_plan_policy(declarations: [PolicyDeclaration], body: [Stmt], env: LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        scoped := clone_env(env)
        sentry_mode :: declarations.find(fn(declaration) { declaration.key == PolicyKey.Sentries }).map(fn(declaration) { declaration.value == PolicyValue.On })
        if sentry_mode == Val(false) -> scoped.sentries_enabled = false
        deferred_stmt([LowerBody.scoped(body, ^scoped)], fn(lowered: &[[TStmt]]) -> TStmt {
            lowered_body :: lowered.pop().expect("policy body was deferred")
            if sentry_mode == Val(enabled) -> TStmt.SentryPolicy{enabled: enabled, body: ^lowered_body} else -> TStmt.Region(^lowered_body)
        })
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4472
fn lower_stmt_plan_task_group(name: String, limit: Expr?, body: [Stmt], cx: Cx, env: &LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        scoped := clone_env(env)
        group_ty :: Type.Named(Syntax.TYPE_TASKGROUP)
        group :: TLocal.user(name)
        scoped.bind(name, ~group, Val(group_ty))
        limit_t :: limit.map(fn(value) { lower_expr(value, cx, env) })
        deferred_stmt([LowerBody.scoped(body, ^scoped)], fn(lowered: &[[TStmt]]) -> TStmt { TStmt.TaskGroup{group: group, limit: limit_t, body: lowered.pop().expect("task-group body was deferred")} })
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4495
fn lower_stmt_plan_layout(name: String, body: [Stmt], env: LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        handle :: TLocal.user(name)
        scoped := clone_env(env)
        scoped.bind(name, ~handle, Val(Type.Named(Syntax.LAYOUT_TYPE)))
        deferred_stmt([LowerBody.inline(body, ^scoped)], fn(lowered: &[[TStmt]]) -> TStmt { TStmt.Layout{handle: handle, label: ~name, body: lowered.pop().expect("layout body was deferred")} })
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4516
fn lower_stmt_plan_authority_scope(caps: [jet_foundation.NamedSpan], binding: jet_foundation.NamedSpan?, body: [Stmt], env: LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        scoped := clone_env(env)
        if binding == Val(named_binding) -> {
            name :: named_binding.name
            authority_ty :: Type.Named(Syntax.TYPE_AUTHORITY)
            authority :: TLocal.user(name)
            scoped.bind(name, authority, Val(~authority_ty))
            rights :: TExpr{ty: Type.List(Type.String), kind: TExprKind.CtLit(CtValue.List(caps.map(fn(right) { CtValue.Str(~right.name) })))}
            init :: TExpr{ty: ~authority_ty, kind: TExprKind.StaticCall{owner: TStaticOwner.Prelude{rooted: true, path: "JetAuthority", generics: []}, owner_type: None,
                method: TMethodRef.bare("from_rights"), type_args: [], args: [TCallArg{value: ^rights, template_items: None, borrow: false, mut_borrow: false, clone: false,
                arc_clone: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None}]}}
            binding_used :: body.any(fn(statement) {
                if statement == .Assign{target: LValue.Local{name: target_name, ..}, ..} && target_name == name -> return true
                stmt := ~statement
                used := false
                stmt.for_each_expr_mut(fn(expr: &Expr) { if expr == .Ident(n, _) && n == name -> used = true })
                used
            })
            return deferred_stmt([LowerBody.scoped(body, ^scoped)], fn(lowered: &[[TStmt]]) -> TStmt {
                lowered_body := lowered.pop().expect("FX body was deferred")
                if binding_used -> &lowered_body.insert(0, TStmt.Let{name: ~name, kw: "let", let_ty: TLetTy.plain(authority_ty), init: init, gc_promotion: None, gc_transferred: false})
                TStmt.Region(^lowered_body)
            })
        }
        deferred_stmt([LowerBody.scoped(body, ^scoped)], fn(lowered: &[[TStmt]]) -> TStmt { TStmt.Region(lowered.pop().expect("FX body was deferred")) })
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4613
fn lower_stmt_plan_context_block(fields: [jet_foundation.ContextField], body: [Stmt], cx: Cx, env: &LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        guards :: fields.map(fn(field) { (~field.name, lower_expr(field.value, cx, env)) })
        scoped :: clone_env(env)
        deferred_stmt([LowerBody.scoped(body, ^scoped)], fn(lowered: &[[TStmt]]) -> TStmt { TStmt.ContextBlock{guards: guards, body: lowered.pop().expect("context body was deferred")} })
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4629
fn lower_stmt_plan_live(body: [Stmt], env: LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        scoped :: clone_env(env)
        deferred_stmt([LowerBody.scoped(body, ^scoped)], fn(lowered: &[[TStmt]]) -> TStmt { TStmt.Live{body: lowered.pop().expect("live body was deferred")} })
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4646
fn lower_stmt_plan_scope_member(name: String, args: [Expr], body: [Stmt], dsl: Bool, cx: Cx, env: &LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        if dsl -> return in_own_frame(fn() -> LowerStmtPlan {
            scoped :: clone_env(env)
            deferred_stmt([LowerBody.scoped(body, ^scoped)], fn(lowered: &[[TStmt]]) -> TStmt { TStmt.Region(lowered.pop().expect("scope body was deferred")) })
        })
        if name == Syntax.MARKER_ARITHMETIC -> {
            scoped :: clone_env(env)
            return deferred_stmt([LowerBody.scoped(body, ^scoped)], fn(lowered: &[[TStmt]]) -> TStmt { TStmt.Region(lowered.pop().expect("arithmetic body was deferred")) })
        }
        kind :: if name == Syntax.SCOPE_TEST_SETUP -> ScopeMemberKind.Setup
            else if name == Syntax.SCOPE_TEST_EXPECT_FAIL -> {
                expected :: args.first().and_then(fn(arg) { if arg == .Ident(code, _) -> Val(~code) else -> None })
                ScopeMemberKind.ExpectFail(expected)
            } else if name == Syntax.SCOPE_TEST_TIMEOUT -> ScopeMemberKind.Timeout(lower_expr(args.first().expect("sema validated .timeout argument"), cx, env))
            else if name == Syntax.SCOPE_TEST_MEASURE -> ScopeMemberKind.Measure
            else -> ScopeMemberKind.Skip
        scoped :: clone_env(env)
        body_plan :: if kind == ScopeMemberKind.Setup -> LowerBody.inline(body, ^scoped) else -> LowerBody.scoped(body, ^scoped)
        deferred_stmt([^body_plan], fn(lowered: &[[TStmt]]) -> TStmt { TStmt.ScopeMember{kind: kind, body: lowered.pop().expect("scope member body was deferred")} })
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4710
fn lower_stmt_plan_assume_det(body: [Stmt], env: LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        scoped :: clone_env(env)
        deferred_stmt([LowerBody.scoped(body, ^scoped)], fn(lowered: &[[TStmt]]) -> TStmt { TStmt.Region(lowered.pop().expect("determinism body was deferred")) })
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4723
fn lower_stmt_plan_transact(name: String?, body: [Stmt], implicit: Bool, cx: Cx, env: LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        if implicit && cx.in_stm_transact.get() -> {
            scoped :: clone_env(env)
            return deferred_stmt([LowerBody.scoped(body, ^scoped)], fn(lowered: &[[TStmt]]) -> TStmt { TStmt.Region(lowered.pop().expect("joined shared access body was deferred")) })
        }
        scoped := clone_env(env)
        handle :: name.map(fn(n) {
            slot :: TLocal.user(n).as_mutable()
            scoped.bind(n, ~slot, Val(Type.Named(Syntax.TXN_HANDLE_TYPE)))
            ^slot
        })
        synthesized_handle :: TLocal.generated("txn").as_mutable()
        // GATE #4494: shared reference-counted undo cell survives deferred lowering.
        txn_undo_needed :: Rc.new(Cell.new(false))
        scoped.txn_handle = Val(handle ?? ~synthesized_handle)
        scoped.txn_undo_needed = Val(~txn_undo_needed)
        roots := [String]{}
        collect_txn_mut_roots(body, &roots)
        snapshots :: roots.filter(fn(r) { env.locals.contains_key(r) }).map(fn(r) {
            rollback_ty :: env.ty_of(r).filter(fn(ty) { if ty == .Named(n) -> cx.rollback_types.contains(n) else -> false })
            (env.local_of(r), rollback_ty)
        })
        prev_in :: cx.in_stm_transact.replace(true)
        prev_touched :: cx.stm_touched.replace(false)
        deferred_stmt([LowerBody.scoped(body, ^scoped)], fn(lowered: &[[TStmt]]) -> TStmt {
            stm :: if cx.stm_touched.get() -> Val(TLocal.stm()) else -> None
            cx.in_stm_transact.set(prev_in)
            cx.stm_touched.set(prev_touched)
            effective_handle :: handle.or_else(fn() { if txn_undo_needed.get() || !snapshots.is_empty() -> Val(synthesized_handle) else -> None })
            TStmt.Transact{handle: effective_handle, snapshots: snapshots, stm: stm, body: lowered.pop().expect("transaction body was deferred")}
        })
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4808
fn lower_stmt_plan_comptime_switch(span: Span) -> LowerStmtPlan {
    LowerStmtPlan.ready(TStmt.Erased{construct: "ComptimeSwitch", span: span, reason: TirErasureReason.CompileTimeOnly})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4816
fn hardware_dma_channel(expr: Expr, cx: Cx) -> String? {
    if expr != .MethodCall{receiver, method, args, ..} -> return None
    if method != "start" || args.len() < 2 -> return None
    if receiver != .Ident(name, _) || name != "dma" -> return None
    if args[0].expr != .Field(base, channel, _) -> return None
    if base != .Field(root, block, _) -> return None
    if root != .Ident(alias, _) -> return None
    if !cx.core_imports.get(alias).is_some_and(fn(profile) { profile.starts_with("board.") }) -> return None
    fallback :: "{block.to_ascii_uppercase()}_{channel.to_ascii_uppercase()}"
    Val(cx.hardware_profile.and_then(fn(facts) {
        facts.dma_channels.find(fn(fact) { fact.name.eq_ignore_ascii_case(fallback) }).map(fn(fact) { ~fact.name })
    }) ?? fallback)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:3830-4814
// Direct continuation from Statements09; preceding Val/Assign arms stay at their owner.
fn lower_stmt_plan_tail(s: Stmt, cx: Cx, env: &LowerEnv) -> LowerStmtPlan {
    if s == {
        .Return(value, _) -> lower_stmt_plan_return(value, cx, env)
        .Yield(e, _) -> lower_stmt_plan_yield(e, cx, env)
        .DeferClose{close, ..} -> lower_stmt_plan_defer_close(close, cx, env)
        .Expr(e) -> lower_stmt_plan_expr(e, cx, env)
        .Loop{body, label, ..} -> lower_stmt_plan_loop(body, label, cx, env)
        .While{cond, body, label, ..} -> lower_stmt_plan_while(cond, body, label, cx, env)
        .CountedLoop{init, cond, step, body, label, ..} -> lower_stmt_plan_counted_loop(init, cond, step, body, label, cx, env)
        .For{var, var2, kind, body, label, auto_vectorization, ..} -> lower_stmt_plan_for(var, var2, kind, body, label, auto_vectorization, cx, env)
        .Break(_) -> lower_stmt_plan_break()
        .BreakValue(value, _) -> lower_stmt_plan_break_value(value, cx, env)
        .Continue(_) -> lower_stmt_plan_continue()
        .BreakLabel(name, _) -> lower_stmt_plan_break_label(name)
        .BreakLabelValue(name, _, value, _) -> lower_stmt_plan_break_label_value(name, value, cx, env)
        .ContinueLabel(name, _) -> lower_stmt_plan_continue_label(name)
        .Switch{subject, arms, else_body, span} -> lower_stmt_plan_switch(subject, arms, else_body, span, cx, env)
        .ComptimeBlock{..} -> lower_stmt_plan_comptime_block()
        .Switched{marker, body, ..} -> lower_stmt_plan_switched(marker, body, env)
        .ComptimeIf{then_body, else_body, selected_then, ..} -> lower_stmt_plan_comptime_if(then_body, else_body, selected_then, env)
        .Unsafe{audit, body, span, ..} -> lower_stmt_plan_unsafe(audit, body, span, cx, env)
        .Impure{body, ..} -> lower_stmt_plan_impure(body, env)
        .Reactive{body, span, ..} -> lower_stmt_plan_reactive(body, span, cx, env)
        .Shield{body, ..} -> lower_stmt_plan_shield(body, env)
        .Region{body, ..} -> lower_stmt_plan_region(body, env)
        .Policy{declarations, body, ..} -> lower_stmt_plan_policy(declarations, body, env)
        .TaskGroup{name, limit, body, ..} -> lower_stmt_plan_task_group(name, limit, body, cx, env)
        .Layout{name, body, ..} -> lower_stmt_plan_layout(name, body, env)
        .AuthorityScope{caps, binding, body, ..} -> lower_stmt_plan_authority_scope(caps, binding, body, env)
        .ContextBlock{fields, body, ..} -> lower_stmt_plan_context_block(fields, body, cx, env)
        .Live{body, ..} -> lower_stmt_plan_live(body, env)
        .ScopeMember{name, args, body, dsl, ..} -> lower_stmt_plan_scope_member(name, args, body, dsl, cx, env)
        .AssumeDet{body, ..} -> lower_stmt_plan_assume_det(body, env)
        .Transact{name, body, implicit, ..} -> lower_stmt_plan_transact(name, body, implicit, cx, env)
        .ComptimeSwitch{span, ..} -> lower_stmt_plan_comptime_switch(span)
        else -> panic("lower_stmt_plan tail routing violated: preceding statement reached continuation")
    }
}
