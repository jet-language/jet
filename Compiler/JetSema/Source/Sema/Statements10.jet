// Private continuation of Codegen.TIR.Lower.Statements.lower_stmt_plan.
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:3830
fn lower_stmt_plan_return(value: Expr?, cx: Cx, env: &LowerEnv) -> LowerStmtPlan {
    if value == Val(e) -> return LowerStmtPlan.ready(lower_return_value(e, cx, env))
    if env.ret_ty == Val(.Result(ok, _)) && ok == .Named(n) && n == Syntax.INTERNAL_UNIT_TYPE -> {
        return in_own_frame(fn() -> LowerStmtPlan {
            unit :: TExpr{ty: Type.Named(Syntax.INTERNAL_UNIT_TYPE), kind: TExprKind.Unit}
            LowerStmtPlan.ready(TStmt.Return(Val(TExpr{ty: env.ret_ty.expect("fallible void return"), kind: TExprKind.Ok(^unit)})))
        })
    }
    LowerStmtPlan.ready(TStmt.Return(None))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:3856
fn lower_stmt_plan_yield(e: Expr, cx: Cx, env: &LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        v :: lower_expr(e, cx, env)
        LowerStmtPlan.ready(TStmt.ExprStmt(TExpr{ty: unit_type(), kind: TExprKind.HostCall(THostCall.YieldSend{value: ^v})}))
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:3871
fn lower_stmt_plan_defer_close(close: Expr, cx: Cx, env: &LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        if close != .Call(close_call) -> panic("parser creates a close call for deferred cleanup")
        if close_call.args[0].expr != .Ident(resource, _) -> panic("parser restricts deferred close to one resource binding")
        LowerStmtPlan.ready(TStmt.DeferClose{close: lower_expr(close, cx, env), resource: env.local_of(resource)})
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:3887
fn lower_stmt_plan_expr(e: Expr, cx: Cx, env: &LowerEnv) -> LowerStmtPlan {
    if e.without_parens() == .If{..} -> return LowerStmtPlan.ready(lower_discarded_expr(e, cx, env))
    if e == .MethodCall{receiver, method, ..} && method == Syntax.METHOD_DROP -> return LowerStmtPlan.ready(TStmt.ExprStmt(lower_expr(receiver, cx, env)))
    LowerStmtPlan.ready(TStmt.ExprStmt(lower_expr(e, cx, env)))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:3899
fn lower_stmt_plan_loop(body: [Stmt], label: jet_foundation.NamedSpan?, cx: Cx, env: LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        branch :: clone_env(env)
        loop_label :: label_name(label)
        deferred_stmt([LowerBody.scoped(body, ^branch)], fn(lowered: &[[TStmt]]) -> TStmt {
            TStmt.Loop{label: loop_label, body: lowered.pop().expect("loop body was deferred")}
        })
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:3911
fn lower_stmt_plan_while(cond: Expr, body: [Stmt], label: jet_foundation.NamedSpan?, cx: Cx, env: &LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        condition :: lower_expr(cond, cx, env)
        branch := clone_env(env)
        refine_loop_condition(&branch, condition)
        loop_label :: label_name(label)
        deferred_stmt([LowerBody.scoped(body, ^branch)], fn(lowered: &[[TStmt]]) -> TStmt {
            TStmt.While{label: loop_label, cond: condition, body: lowered.pop().expect("while body was deferred")}
        })
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:3929
fn lower_stmt_plan_counted_loop(init: jet_foundation.Binding, cond: Expr, step: Stmt?, body: [Stmt], label: jet_foundation.NamedSpan?, cx: Cx, env: &LowerEnv) -> LowerStmtPlan {
    in_own_frame(fn() -> LowerStmtPlan {
        init_val := lower_expr(init.init, cx, env)
        init_ty :: init.ty ?? ~init_val.ty
        mut_fn :: thread_callback_lambda(init.init).is_some_and(fn(lam) { lam.meta.escapes && lam.meta.needs_fn_mut })
        send_fn :: env.is_send_fn(init.name) && init_ty == .Fn{..} && !mut_fn
        if send_fn -> init_val = force_thread_callback_value(^init_val, cx)
        init_bounds :: integer_bounds_for_expr(init_val)
        scoped := clone_env(env)
        scoped.bind(init.name, TLocal.user(init.name), Val(~init_ty))
        scoped.set_integer_bounds(init.name, init_bounds)
        init_stmt :: TStmt.Let{name: ~init.name, kw: "let mut", let_ty: if send_fn -> TLetTy.SendFn(^init_ty) else -> TLetTy.Inferred,
            init: ^init_val, gc_promotion: None, gc_transferred: false}
        condition :: lower_expr(cond, cx, &scoped)
        refine_loop_condition(&scoped, condition)
        has_step :: step.is_some()
        bodies := [LowerBody]{}
        if step == Val(step_stmt) -> &bodies.push(LowerBody.direct([step_stmt], ~scoped).carry_env())
        &bodies.push(LowerBody.inherited(body, ^scoped))
        loop_label :: label_name(label)
        deferred_stmt(^bodies, fn(lowered: &[[TStmt]]) -> TStmt {
            lowered_body :: lowered.pop().expect("counted-loop body was deferred")
            lowered_step :: if has_step -> Val(lowered.pop().expect("counted-loop step was deferred").first().expect("counted-loop step was empty")) else -> None
            TStmt.CountedLoop{label: loop_label, init: init_stmt, cond: condition, step: lowered_step, auto_vectorization: None, body: lowered_body}
        })
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:4002
fn lower_stmt_plan_for(var: String, var2: jet_foundation.NamedSpan?, kind: ForKind, body: [Stmt], label: jet_foundation.NamedSpan?, auto_vectorization: jet_foundation.AutoVectorizationFacts?, cx: Cx, env: &LowerEnv) -> LowerStmtPlan {
    if kind == {
        .Range{start, end, step, exclusive} -> in_own_frame(fn() -> LowerStmtPlan {
            start_t :: lower_expr(start, cx, env)
            end_t :: lower_expr(end, cx, env)
            step_t :: step.map(fn(s) { lower_expr(s, cx, env) })
            branch := clone_env(env)
            branch.bind(var, TLocal.user(var), Val(Type.Int))
            if range_iteration_bounds(start_t, end_t, step_t, exclusive) == Val(bounds) -> branch.set_integer_bounds(var, Val(bounds))
            loop_label :: label_name(label)
            deferred_stmt([LowerBody.scoped(body, ^branch)], fn(lowered: &[[TStmt]]) -> TStmt {
                TStmt.Range{label: loop_label, var: ~var, source: None, start: start_t, end: end_t, step: step_t, exclusive: exclusive,
                    auto_vectorization: ~auto_vectorization, body: lowered.pop().expect("range body was deferred")}
            })
        })
        .In{collection, step} -> in_own_frame(fn() -> LowerStmtPlan {
            (iter_source, initial_method_kind) :: lower_forin_collection(collection, cx, env)
            lowered_coll :: lower_expr(collection, cx, env)
            if lowered_coll.ty == .Named(name) && name == Syntax.TYPE_RANGE -> {
                return in_own_frame(fn() -> LowerStmtPlan {
                    step_t :: step.map(fn(s) { lower_expr(s, cx, env) })
                    zero :: fn() -> TExpr { TExpr{ty: Type.Int, kind: TExprKind.IntLit(0, None)} }
                    branch := clone_env(env)
                    branch.bind(var, TLocal.user(var), Val(Type.Int))
                    loop_label :: label_name(label)
                    deferred_stmt([LowerBody.scoped(body, ^branch)], fn(lowered: &[[TStmt]]) -> TStmt {
                        TStmt.Range{label: loop_label, var: ~var, source: Val(lowered_coll), start: zero(), end: zero(), step: step_t, exclusive: false,
                            auto_vectorization: None, body: lowered.pop().expect("range body was deferred")}
                    })
                })
            }
            method_kind := initial_method_kind
            coll_elem_ty := if lowered_coll.ty == {
                .List(inner) | .FixedList{elem: inner, ..} -> Val(~inner)
                .Map{key, value, ..} -> Val(Type.Tuple([("key", ~key), ("value", ~value)]))
                .Apply(name, args) if (name == Syntax.TYPE_STREAM || name == Syntax.TYPE_ITER) && args.len() == 1 -> Val(~args[0])
                .Named("HTTPBodyChunks") -> Val(Type.Result(Type.List(Type.Named("U8")), Type.Named("HTTPError")))
                .Named(name) -> encoding_reader_item_type(name)
                .Apply(name, args) if ["View", "ViewMut", "ComputeViewMut"].contains(name) && args.len() == 1 -> Val(~args[0])
                else -> None
            }
            // Element facts belong to the closed iteration form, even for marker-only source types.
            if method_kind == {
                Val(.Chars) -> coll_elem_ty = Val(Type.Char)
                Val(.LinesFile | .LinesStdin | .LinesProcessStream) -> coll_elem_ty = Val(Type.String)
                Val(.EncodingReader{..} | .Iterable{..} | .ChannelReceiver) | None -> {}
            }
            elem_is_view_mut :: coll_elem_ty.is_some_and(fn(t) { if t == .Apply(name, _) -> ["ViewMut", "ComputeViewMut"].contains(name) else -> false })
            elem_is_cloneable :: !coll_elem_ty.is_some_and(type_requires_owned_iteration)
            stream_source :: if lowered_coll.ty == .Apply(name, _) -> name == Syntax.TYPE_STREAM || name == Syntax.TYPE_ITER else -> false
            http_chunks :: lowered_coll.ty == Type.Named("HTTPBodyChunks")
            list_source :: if lowered_coll.ty == .List(_) | .FixedList{..} -> true else -> false
            by_value :: stream_source || http_chunks || (method_kind.is_none() && !elem_is_cloneable && !elem_is_view_mut && list_source)
            if method_kind.is_none() && lowered_coll.ty == .Named(n) -> {
                if cx.iterable_hooks.get(n) == Val(hook) -> {
                    method_kind = Val(TForInMethod.Iterable{coll_type: ~n, iter_type: ~hook.iter_type, iter_symbol: ~hook.iter_symbol, next_symbol: ~hook.next_symbol, item_type: ~hook.item_type})
                    coll_elem_ty = Val(~hook.item_type)
                }
            }
            branch := clone_env(env)
            branch.bind(var, TLocal.user(var), ~coll_elem_ty)
            if var2 == Val(second) -> {
                v2 :: second.name
                if lowered_coll.ty == {
                    .Map{key, value, ..} -> {
                        branch.bind(var, TLocal.user(var), Val(~key))
                        branch.bind(v2, TLocal.user(v2), Val(~value))
                    }
                    .List(inner) | .FixedList{elem: inner, ..} -> {
                        branch.bind(var, TLocal.user(var), Val(Type.Int))
                        branch.bind(v2, TLocal.user(v2), Val(~inner))
                    }
                    .Apply(name, args) if ["View", "ViewMut", "ComputeViewMut"].contains(name) && args.len() == 1 -> {
                        branch.bind(var, TLocal.user(var), Val(Type.Int))
                        branch.bind(v2, TLocal.user(v2), Val(~args[0]))
                    }
                    else -> branch.bind(v2, TLocal.user(v2), None)
                }
            }
            columnar :: var2.is_none() && method_kind.is_none() && coll_elem_ty.is_some_and(fn(t) { cx.columnar_list_type(t).is_some() })
            plain_list :: if lowered_coll.ty.without_user_tags() == .List(_) -> true else -> false
            source_stable :: method_kind.is_none() && step.is_none() && !by_value && !columnar && plain_list && stable_loop_source_root(collection).is_some_and(fn(root) { !block_free_var_reads(body).contains(root) })
            step_t :: step.map(fn(s) { lower_expr(s, cx, env) })
            loop_label :: label_name(label)
            second_var :: var2.map(fn(second) { ~second.name })
            deferred_stmt([LowerBody.scoped(body, ^branch)], fn(lowered: &[[TStmt]]) -> TStmt {
                TStmt.ForIn{label: loop_label, var: ~var, var2: second_var, source: iter_source, collection: lowered_coll, step: step_t,
                    method_kind: method_kind, columnar: columnar, by_value: by_value, source_stable: source_stable, body: lowered.pop().expect("for-in body was deferred")}
            })
        })
    }
}

