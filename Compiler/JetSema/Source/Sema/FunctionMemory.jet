// Scoped-GC escape facts are decided from the source policy ladder before
// statement lowering, then carried into the checked tree without backend reconstruction.
use jet_foundation.[
    Binding,
    Diagnostic,
    Expr,
    Func,
    GCPromotion,
    GCPromotionEdge,
    Item,
    LValue,
    PolicyDeclaration,
    PolicyKey,
    PolicyScope,
    PolicyValue,
    Program,
    Span,
    Stmt,
    TFuncKind,
    TGCPromotion,
    TGCPromotionEdge,
    Type,
    TypedLitBody,
    gate_kind_parse,
    policy_key_name,
    policy_scope_name,
    policy_scope_rank,
    policy_value_display,
]

SemaFunctionMemoryModuleInput: struct {
    module_identity: String
    package_identity: String
    policy_declarations: [PolicyDeclaration]
}

SemaFunctionMemoryFunction: struct {
    module_identity: String
    // The leaf name of the type that owns a method, "" for a free function.
    owner: String
    // The declaration as the plan rewrote it. None when no scoped-GC policy
    // reaches it and no other function shares its key: the plan then leaves
    // it exactly as written, so the checker reads its own declaration.
    function: Func?
    diagnostics: [Diagnostic]
    transfer_root: Bool
    complete: Bool
}

SemaFunctionMemoryPlan: struct {
    functions: [SemaFunctionMemoryFunction]
    // Row position of the first function per `sema_function_memory_key`, so
    // every body check finds its row without scanning the whole plan.
    positions: [String:Int]
    diagnostics: [Diagnostic]
    complete: Bool
}

SemaFunctionMemorySource: struct {
    module_identity: String
    owner: String
    name: String
    span: Span
    // The declaration, copied only when a scoped-GC policy may rewrite it
    // (sema_function_memory_scope_may_annotate); `chain` is then its policy
    // ladder, and empty otherwise.
    function: Func?
    chain: [PolicyDeclaration]
    transfer_root: Bool
}

// One walk over a plan's items in row order. Collecting, it records each
// function's source row; fetching (a second walk), it copies the declarations
// of the `wanted` rows into `fetched`.
SemaFunctionMemoryWalk: struct {
    sources: [SemaFunctionMemorySource]
    fetching: Bool
    next_row: Int
    wanted: [Int:Bool]
    fetched: [Int:Func]
}

// The declarations a plan rewrote (`functions`, at plan rows `rows`, both in
// row order) and the transfer-root names they promote.
SemaFunctionMemoryPlanned: struct {
    functions: [Func]
    rows: [Int]
    promoted: [String]
    // The first row of each key a later row shares: a lookup by that key
    // reads this row's declaration, so the row keeps a copy of it.
    shared_rows: [Int:Bool]
}

SemaFunctionMemoryPolicy: struct {
    value: PolicyValue
    provenance: [PolicyDeclaration]
    explanation: String
}

// Exact function identity: module, owning type, name, and declaration span.
// A derived member keeps its `Prelude/Derives.jet` template span, which every
// derived type shares, so the owner tells `Effect.equal` from `Route.equal`;
// a `#loop` template declares one member per value at one span, so
// the name tells `field_x` from `field_y` on the same owner. The integers lead
// and the owner and name are identifiers, so no module identity text can
// collide with another key.
sema_function_memory_key: fn(module_identity: String, owner: String, name: String, span: Span) -> String Never! {
    "{span.start}:{span.end}:{owner}:{name}:{module_identity}"
}

sema_function_memory_policy_declaration_equal: fn(left: PolicyDeclaration, right: PolicyDeclaration) -> Bool Never! {
    left.key == right.key && left.value == right.value && left.scope == right.scope && left.span.start == right.span.start && left.span.end == right.span.end && left.target == right.target && left.source == right.source
}

sema_function_memory_append_policy_unique: fn(values: &[PolicyDeclaration], declaration: PolicyDeclaration) Never! {
    loop existing in values {
        if sema_function_memory_policy_declaration_equal(existing, declaration) -> return
    }
    values.push(declaration.copy())
}

sema_function_memory_package_policies: fn(modules: [SemaFunctionMemoryModuleInput], package_identity: String) -> [PolicyDeclaration] Never! {
    declarations := [PolicyDeclaration]{}
    loop module_input in modules {
        if module_input.package_identity != package_identity -> next
        loop declaration in module_input.policy_declarations {
            if declaration.key == PolicyKey.ScopedGC && declaration.scope == PolicyScope.Package {
                sema_function_memory_append_policy_unique(declarations, declaration)
            }
        }
    }
    declarations
}

sema_function_memory_function_policies: fn(outer: [PolicyDeclaration], declarations: [PolicyDeclaration], function: Func) -> [PolicyDeclaration] Never! {
    chain := outer
    loop declaration in declarations {
        if declaration.key == PolicyKey.ScopedGC && declaration.scope == PolicyScope.Function && declaration.target == (Val(function.span)) -> chain.push(declaration.copy())
    }
    chain
}

sema_function_memory_policy_error: fn(diagnostics: &[Diagnostic], span: Span) {
    diagnostics.push(sema_error("E0355", span, "invalid effective `gc` policy", "the package, module, function, and block declarations must form one valid policy ladder", "remove the conflicting declaration or tighten the enclosing policy"))
}

sema_function_memory_policy_explanation: fn(value: PolicyValue, provenance: [PolicyDeclaration]) -> String Never! {
    explanation := "gc = {policy_value_display(value)}"
    index := 0
    loop declaration in provenance {
        status := "shadowed"
        if index + 1 == provenance.len() -> status = "effective"
        explanation = "{explanation}\n  [{status}] {policy_scope_name(declaration.scope)} {policy_value_display(declaration.value)} at {declaration.source}:{declaration.span.start}..{declaration.span.end}"
        index += 1
    }
    explanation
}

sema_function_memory_resolve_policy: fn(declarations: [PolicyDeclaration], diagnostics: &[Diagnostic], complete: &Bool) -> SemaFunctionMemoryPolicy? {
    ordered := [PolicyDeclaration]{}
    loop scope in ([PolicyScope]{PolicyScope.Organization, PolicyScope.Package, PolicyScope.Module, PolicyScope.Function, PolicyScope.Block}) {
        loop declaration in declarations {
            if declaration.key == PolicyKey.ScopedGC && declaration.scope == scope -> ordered.push(declaration.copy())
        }
    }
    if ordered.len() == 0 -> return None
    effective := PolicyValue?{None}
    provenance := [PolicyDeclaration]{}
    loop declaration in ordered {
        if policy_scope_rank(declaration.scope) == 0 {
            sema_function_memory_policy_error(diagnostics, declaration.span)
            complete = false
            return None
        }
        loop previous in provenance {
            if previous.scope == declaration.scope && previous.target == declaration.target {
                sema_function_memory_policy_error(diagnostics, declaration.span)
                complete = false
                return None
            }
        }
        effective = Val(declaration.value)
        provenance.push(declaration)
    }
    value: effective ?? return None
    Val(SemaFunctionMemoryPolicy{value: value, provenance: provenance, explanation: sema_function_memory_policy_explanation(value, provenance)})
}

sema_function_memory_walk_new: fn() -> SemaFunctionMemoryWalk Never! {
    SemaFunctionMemoryWalk{sources: [SemaFunctionMemorySource]{}, fetching: false, next_row: 0, wanted: [Int:Bool]{}, fetched: [Int:Func]{}}
}

// One function of the walk, at the walk's next row. A declaration is copied
// only when the plan may rewrite it or (fetching) the plan asked for it.
sema_function_memory_visit: fn(walk: &SemaFunctionMemoryWalk, module_identity: String, owner: String, function: Func, transfer_root: Bool, outer: [PolicyDeclaration], declarations: [PolicyDeclaration]) Never! {
    row: walk.next_row
    walk.next_row = row + 1
    if walk.fetching {
        if walk.wanted.get(row) != None -> walk.fetched[row] = function
        return
    }
    chain: sema_function_memory_function_policies(outer, declarations, function)
    rewritable := Func?{None}
    if sema_function_memory_scope_may_annotate(function.body, chain) -> rewritable = Val(function)
    walk.sources.push(SemaFunctionMemorySource{module_identity: module_identity, owner: sema_serde_named_leaf(owner), name: function.name, span: function.span, function: rewritable, chain: chain, transfer_root: transfer_root})
}

sema_function_memory_collect_items: fn(items: [Item], module_identity: String, top_level: Bool, outer: [PolicyDeclaration], declarations: [PolicyDeclaration], walk: &SemaFunctionMemoryWalk) Never! {
    loop item in items {
        if item == {
            .Func(function) -> sema_function_memory_visit(walk, module_identity, "", function, top_level, outer, declarations)
            .Struct(definition) -> {
                loop function in definition.methods -> sema_function_memory_visit(walk, module_identity, definition.name, function, false, outer, declarations)
                loop implementation in definition.trait_impls {
                    loop function in implementation.methods -> sema_function_memory_visit(walk, module_identity, definition.name, function, false, outer, declarations)
                }
            }
            .Enum(definition) -> {
                loop function in definition.methods -> sema_function_memory_visit(walk, module_identity, definition.name, function, false, outer, declarations)
                loop implementation in definition.trait_impls {
                    loop function in implementation.methods -> sema_function_memory_visit(walk, module_identity, definition.name, function, false, outer, declarations)
                }
            }
            .Impl(implementation) -> {
                // An operator hook on a built-in scalar (`impl Float.Mul(Vec3)`)
                // registers that scalar as its owner type, which has no nominal
                // base name, so its rows are found under the free-function owner.
                owner: if sema_registration_builtin_scalar(implementation.type_name) == None -> implementation.type_name else -> ""
                loop function in implementation.methods -> sema_function_memory_visit(walk, module_identity, owner, function, false, outer, declarations)
            }
            .CodeModule(code_module) -> {
                if code_module.body == .Val(body) -> sema_function_memory_collect_items(body, module_identity, false, outer, declarations, walk)
            }
            .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

// Visits one module's functions in row order under its package and module
// scoped-GC policies; returns its top-level item count (the propagation bound
// sums them).
sema_function_memory_walk_module: fn(modules: [SemaFunctionMemoryModuleInput], package_identity: String, module_identity: String, declarations: [PolicyDeclaration], items: [Item], walk: &SemaFunctionMemoryWalk) -> Int Never! {
    outer := sema_function_memory_package_policies(modules, package_identity)
    loop declaration in declarations {
        if declaration.key == PolicyKey.ScopedGC && declaration.scope == PolicyScope.Module -> outer.push(declaration.copy())
    }
    sema_function_memory_collect_items(items, module_identity, true, outer, declarations, walk)
    items.len()
}

sema_function_memory_walk_graph: fn(graph: SemaRegistrationGraph, walk: &SemaFunctionMemoryWalk) -> Int Never! {
    modules := [SemaFunctionMemoryModuleInput]{}
    loop module_row_index in 0..<graph.modules.len() {
        modules.push(SemaFunctionMemoryModuleInput{module_identity: graph.modules[module_row_index].module_identity, package_identity: graph.modules[module_row_index].package_identity, policy_declarations: graph.modules[module_row_index].program.policy_declarations})
    }
    limit := 0
    loop module_row_index in 0..<graph.modules.len() {
        limit += sema_function_memory_walk_module(modules, graph.modules[module_row_index].package_identity, graph.modules[module_row_index].module_identity, graph.modules[module_row_index].program.policy_declarations, graph.modules[module_row_index].program.items, walk)
    }
    limit
}

sema_function_memory_walk_program: fn(program: Program, module_identity: String, package_identity: String, walk: &SemaFunctionMemoryWalk) -> Int Never! {
    modules: [SemaFunctionMemoryModuleInput]{SemaFunctionMemoryModuleInput{module_identity: module_identity, package_identity: package_identity, policy_declarations: program.policy_declarations}}
    sema_function_memory_walk_module(modules, package_identity, module_identity, program.policy_declarations, program.items, walk)
}

sema_function_memory_plan_new: fn() -> SemaFunctionMemoryPlan Never! {
    SemaFunctionMemoryPlan{functions: [SemaFunctionMemoryFunction]{}, positions: [String:Int]{}, diagnostics: [Diagnostic]{}, complete: true}
}

// The plan's rows for `sources`, in order: each policy ladder resolved, the
// declarations a policy reaches rewritten, and transfers propagated among the
// rewritten transfer roots (a declaration no policy reaches never gains a
// scoped-GC fact, so it can neither promote nor take a transfer).
sema_function_memory_plan_rows: fn(plan: &SemaFunctionMemoryPlan, sources: [SemaFunctionMemorySource], limit: Int) -> SemaFunctionMemoryPlanned {
    planned := SemaFunctionMemoryPlanned{functions: [Func]{}, rows: [Int]{}, promoted: [String]{}, shared_rows: [Int:Bool]{}}
    keys := [String]{}
    loop (row, source) in sources {
        function_diagnostics := [Diagnostic]{}
        function_complete := true
        if source.function == .Val(declared) {
            function := declared
            effective := sema_function_memory_resolve_policy(source.chain, function_diagnostics, function_complete)
            function.gc_scope = false
            if effective == .Val(policy) && policy.value == PolicyValue.Enabled -> function.gc_scope = true
            function.gc_return = sema_function_memory_annotate_scope(function.body, source.chain, function_diagnostics, function_complete)
            planned.functions.push(function)
            planned.rows.push(row)
        }
        function_complete = function_complete && function_diagnostics.len() == 0
        loop diagnostic in function_diagnostics -> plan.diagnostics.push(diagnostic)
        plan.functions.push(SemaFunctionMemoryFunction{module_identity: source.module_identity, owner: source.owner, function: None, diagnostics: function_diagnostics, transfer_root: source.transfer_root, complete: function_complete})
        keys.push(sema_function_memory_key(source.module_identity, source.owner, source.name, source.span))
    }
    sema_function_memory_fill_positions(plan, planned, keys)
    iteration := 0
    loop iteration < limit {
        promoted: sema_function_memory_promoted(plan, planned)
        changed := false
        loop index in 0..<planned.functions.len() {
            // Updated in place: copying each function out and back would
            // copy every rewritten body once per round.
            if plan.functions[planned.rows[index]].transfer_root -> changed = sema_function_memory_propagate_transfers(planned.functions[index], promoted) || changed
        }
        if !changed -> break
        iteration += 1
    }
    planned.promoted = sema_function_memory_promoted(plan, planned)
    planned
}

// Each key's first row into the plan's (empty) positions, and that row marked
// shared when a later row has the same key. The (key, row) pairs are sorted
// once and the table filled in key order: a Map is a sorted list that every
// out-of-order insert shifts.
sema_function_memory_fill_positions: fn(plan: &SemaFunctionMemoryPlan, planned: &SemaFunctionMemoryPlanned, keys: [String]) Never! {
    order := loop (row, key) in keys -> (key: key, row: row)
    order.sort_by(fn(left: (key: String, row: Int), right: (key: String, row: Int)) { (left.key <=> right.key).then(left.row <=> right.row) })
    first := -1
    loop (position, entry) in order {
        if position > 0 && order[position - 1].key == entry.key {
            planned.shared_rows[first] = true
            next
        }
        first = entry.row
        plan.positions[entry.key] = entry.row
    }
}

sema_function_memory_promoted: fn(plan: SemaFunctionMemoryPlan, planned: SemaFunctionMemoryPlanned) -> [String] Never! {
    promoted := [String]{}
    loop index in 0..<planned.functions.len() {
        if plan.functions[planned.rows[index]].transfer_root && planned.functions[index].gc_return -> sema_function_memory_append_name_unique(promoted, planned.functions[index].name)
    }
    promoted
}

// The rows whose declarations the plan still reads: the first row of a shared
// key, and, once a function is promoted, every transfer root no policy
// rewrote (its bindings are checked against the promoted callees).
sema_function_memory_wanted_rows: fn(plan: SemaFunctionMemoryPlan, planned: SemaFunctionMemoryPlanned) -> [Int:Bool] Never! {
    rewritten := [Int:Bool]{}
    loop row in planned.rows -> rewritten[row] = true
    wanted := [Int:Bool]{}
    loop row in 0..<plan.functions.len() {
        if rewritten.get(row) != None -> next
        if planned.shared_rows.get(row) != None || (planned.promoted.len() > 0 && plan.functions[row].transfer_root) -> wanted[row] = true
    }
    wanted
}

// Completes `plan` from its rewritten declarations and the `fetched` ones
// (sema_function_memory_wanted_rows): E2111 at each ownership-only transfer
// root, then each row's declaration, then completeness.
sema_function_memory_plan_finish: fn(plan: &SemaFunctionMemoryPlan, planned: &SemaFunctionMemoryPlanned, fetched: [Int:Func]) {
    if planned.promoted.len() > 0 {
        rewritten := [Int:Int]{}
        loop index in 0..<planned.rows.len() -> rewritten[planned.rows[index]] = index
        loop row in 0..<plan.functions.len() {
            if !plan.functions[row].transfer_root -> next
            found := [Diagnostic]{}
            if rewritten.get(row) == .Val(index) {
                if planned.functions[index].gc_scope -> next
                found = sema_function_memory_boundary_diagnostics(planned.functions[index], planned.promoted)
            } else {
                if fetched.get(row) == .Val(declared) -> found = sema_function_memory_boundary_diagnostics(declared, planned.promoted)
            }
            loop diagnostic in found {
                plan.functions[row].diagnostics.push(diagnostic.copy())
                plan.diagnostics.push(diagnostic)
                plan.functions[row].complete = false
            }
        }
    }
    loop planned.functions.len() > 0 {
        function: planned.functions.pop() ?? break
        row: planned.rows.pop() ?? break
        plan.functions[row].function = Val(function)
    }
    loop row in 0..<plan.functions.len() {
        if plan.functions[row].function != None || planned.shared_rows.get(row) == None -> next
        if fetched.get(row) == .Val(declared) -> plan.functions[row].function = Val(declared)
    }
    complete := plan.diagnostics.len() == 0
    loop function in plan.functions {
        if !function.complete -> complete = false
    }
    plan.complete = complete
}

// E2111 for each binding of an ownership-only function that keeps a
// collector-owned graph returned by a promoted callee.
sema_function_memory_boundary_diagnostics: fn(function: Func, promoted: [String]) -> [Diagnostic] Never! {
    found := [Diagnostic]{}
    loop statement in function.body {
        if statement == {
            .Val(binding) -> {
                callee := sema_function_memory_called_function_name(binding.init)
                if callee != None && sema_function_memory_contains_name(promoted, callee ?? "") {
                    found.push(sema_error("E2111", binding.name_span, "`{binding.name}` cannot leave its scoped GC policy here", "the called function returns a collector-owned graph, but this function is ownership-only", "add `#Policy(gc)` to this function or convert the returned graph to ordinary ownership before the boundary"))
                }
            }
            .Expr(_) | .Assign(_, _, _, _) | .Return(_, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Defer(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> {}
        }
    }
    found
}

// A declaration no scoped-GC policy reaches is not copied into the plan (its
// row has no function); the walk revisits the items only when a shared key or
// an E2111 boundary check needs such a declaration after all.
sema_function_memory_plan_from_graph: fn(graph: SemaRegistrationGraph) -> SemaFunctionMemoryPlan {
    walk := sema_function_memory_walk_new()
    limit: sema_function_memory_walk_graph(graph, walk)
    plan := sema_function_memory_plan_new()
    planned := sema_function_memory_plan_rows(plan, walk.sources, limit)
    walk.wanted = sema_function_memory_wanted_rows(plan, planned)
    if walk.wanted.len() > 0 {
        walk.fetching = true
        walk.next_row = 0
        _ := sema_function_memory_walk_graph(graph, walk)
    }
    sema_function_memory_plan_finish(plan, planned, walk.fetched)
    plan
}

sema_function_memory_plan_for_program: fn(program: Program, module_identity: String, package_identity: String) -> SemaFunctionMemoryPlan {
    walk := sema_function_memory_walk_new()
    limit: sema_function_memory_walk_program(program, module_identity, package_identity, walk)
    plan := sema_function_memory_plan_new()
    planned := sema_function_memory_plan_rows(plan, walk.sources, limit)
    walk.wanted = sema_function_memory_wanted_rows(plan, planned)
    if walk.wanted.len() > 0 {
        walk.fetching = true
        walk.next_row = 0
        _ := sema_function_memory_walk_program(program, module_identity, package_identity, walk)
    }
    sema_function_memory_plan_finish(plan, planned, walk.fetched)
    plan
}

sema_function_memory_has_unsupported_policies: fn(declarations: [PolicyDeclaration]) -> Bool Never! {
    loop declaration in declarations {
        // `copies: .Explicit` only adds refusals (Ownership/StringViews.jet),
        // and so do `writes: .Explicit` (Ownership/CallMarks.jet) and
        // `explicit_units` (E0127, Scopes.jet sema_scope_module_policy
        // and sema_scope_push_unit_policy). `sentries` only turns the runtime
        // witness of a sentry build on or off; the lexical #Unsafe gate and its
        // obligations are checked either way, and a normal build lowers a
        // sentry scope as a plain scope (JetIR BuildExpr ir_stmt). An
        // `arithmetic` mode only routes fixed-width operators.
        if declaration.key == PolicyKey.ScopedGC || declaration.key == PolicyKey.Copies || declaration.key == PolicyKey.Writes || declaration.key == PolicyKey.ExplicitUnits || declaration.key == PolicyKey.Sentries || declaration.key == PolicyKey.Arithmetic -> next
        // An audited-gate key (`unsafe: .Forbid`, `check_removal: .Forbid`, …)
        // is no memory policy: the gate ledger and pkg_check_project_gate
        // enforce it.
        if gate_kind_parse(policy_key_name(declaration.key)) == None -> return true
    }
    false
}

// `owner` is the owning type of a method (any spelling; its leaf name is
// used), or "" for a free function.
sema_function_memory_position: fn(plan: SemaFunctionMemoryPlan, module_identity: String, owner: String, name: String, span: Span) -> Int? {
    plan.positions.get(sema_function_memory_key(module_identity, sema_serde_named_leaf(owner), name, span))
}

// The owner name a method's memory row is found by: the base name of its
// owning type, "" for a free function.
sema_function_memory_owner: fn(kind: TFuncKind) -> String Never! {
    if kind == {
        .Method(_, owner_type) -> sema_type_graph_base_name(owner_type) ?? ""
        .TraitMethod(_, _, owner_type, _, _) -> sema_type_graph_base_name(owner_type) ?? ""
        .TopLevel -> ""
    }
}

sema_function_memory_tree_promotion: fn(promotion: GCPromotion) -> TGCPromotion Never! {
    edges := [TGCPromotionEdge]{}
    loop edge in promotion.edges {
        edges.push(TGCPromotionEdge{binding: edge.binding, slot: edge.slot, group: edge.group})
    }
    TGCPromotion{span: promotion.span, scope: promotion.scope, policy_provenance: promotion.policy_provenance, reason: promotion.reason, edges: edges, collection_len: promotion.collection_len}
}

// True when `chain` or a block-level `#Policy` reachable from `stmts` (through
// the statements the annotation descends into) declares a scoped-GC policy;
// without one the annotation below changes nothing and reports nothing.
sema_function_memory_scope_may_annotate: fn(stmts: [Stmt], chain: [PolicyDeclaration]) -> Bool Never! {
    loop declaration in chain {
        if declaration.key == PolicyKey.ScopedGC -> return true
    }
    sema_function_memory_scope_has_policy(stmts)
}

sema_function_memory_scope_has_policy: fn(stmts: [Stmt]) -> Bool Never! {
    loop stmt in stmts {
        if stmt == {
            .Policy(_, _, _) -> return true
            .While(_, body, _, _, _) | .For(_, _, _, _, body, _, _, _, _) | .Loop(body, _, _, _) | .CountedLoop(_, _, _, body, _, _, _) -> {
                if sema_function_memory_scope_has_policy(body) -> return true
            }
            .Switch(_, arms, else_body, _) -> {
                loop arm in arms {
                    if sema_function_memory_scope_has_policy(arm.body) -> return true
                }
                if else_body == .Val(else_statements) {
                    if sema_function_memory_scope_has_policy(else_statements) -> return true
                }
            }
            .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Defer(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> {}
        }
    }
    false
}

sema_function_memory_annotate_scope: fn(stmts: &[Stmt], chain: [PolicyDeclaration], diagnostics: &[Diagnostic], complete: &Bool) -> Bool {
    // The rewrite below copies each statement out and back; skip it when no
    // scoped-GC policy can apply (the result is then `false`, unchanged).
    if !sema_function_memory_scope_may_annotate(stmts, chain) -> return false
    direct_returns := sema_function_memory_returned_names(stmts)
    promoted_names := direct_returns
    binding_names := [String]{}
    loop stmt in stmts {
        if stmt == {
            .Val(binding) -> {
                sema_function_memory_append_name_unique(binding_names, binding.name)
            }
            .Expr(_) | .Assign(_, _, _, _) | .Return(_, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Defer(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> {}
        }
    }
    loop {
        discovered := [String]{}
        loop stmt in stmts {
            if stmt == {
                .Val(binding) -> {
                    if sema_function_memory_contains_name(promoted_names, binding.name) -> sema_function_memory_collect_expr_idents(binding.init, discovered)
                }
                .Assign(target, _, _, value) -> {
                    if sema_function_memory_lvalue_root(target) != None && sema_function_memory_contains_name(promoted_names, sema_function_memory_lvalue_root(target) ?? "") -> sema_function_memory_collect_expr_idents(value, discovered)
                }
                .Expr(_) | .Return(_, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Defer(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> {}
            }
        }
        before := promoted_names.len()
        loop name in discovered {
            if sema_function_memory_contains_name(binding_names, name) -> sema_function_memory_append_name_unique(promoted_names, name)
        }
        if promoted_names.len() == before -> break
    }
    effective := sema_function_memory_resolve_policy(chain, diagnostics, complete)
    promoted_return := false
    index := 0
    loop index < stmts.len() {
        stmt := stmts[index]
        if stmt == {
            .Val(binding) -> {
                updated_binding := binding
                if sema_function_memory_contains_name(promoted_names, updated_binding.name) && sema_function_memory_binding_may_own_heap(updated_binding) && effective == .Val(policy) && policy.value == PolicyValue.Enabled {
                    scope: policy.provenance[policy.provenance.len() - 1].scope
                    edges := sema_function_memory_promotion_edges(updated_binding.init)
                    filtered_edges := [GCPromotionEdge]{}
                    loop edge in edges {
                        if edge.binding != updated_binding.name && sema_function_memory_contains_name(promoted_names, edge.binding) -> filtered_edges.push(edge)
                    }
                    sema_function_memory_sort_and_deduplicate_edges(filtered_edges)
                    updated_binding.gc_promotion = Val(GCPromotion{
                        span: updated_binding.name_span,
                        scope: policy_scope_name(scope),
                        policy_provenance: policy.explanation,
                        reason: "returned heap graph requires identity beyond its lexical owner",
                        edges: filtered_edges,
                        collection_len: sema_function_memory_collection_len(updated_binding.init),
                    })
                    if sema_function_memory_contains_name(direct_returns, updated_binding.name) -> promoted_return = true
                }
                stmts[index] = Stmt.Val{binding: updated_binding}
            }
            .Policy(declarations, body, span) -> {
                updated_body := body
                nested := chain
                loop declaration in declarations -> nested.push(declaration)
                promoted_return = sema_function_memory_annotate_scope(updated_body, nested, diagnostics, complete) || promoted_return
                stmts[index] = Stmt.Policy{declarations: declarations, body: updated_body, span: span}
            }
            .While(condition, body, span, arrow_body, label) -> {
                updated_body := body
                promoted_return = sema_function_memory_annotate_scope(updated_body, chain, diagnostics, complete) || promoted_return
                stmts[index] = Stmt.While{cond: condition, body: updated_body, span: span, arrow_body: arrow_body, label: label}
            }
            .For(variable, var_span, variable_two, kind, body, span, arrow_body, label, vectorization) -> {
                updated_body := body
                promoted_return = sema_function_memory_annotate_scope(updated_body, chain, diagnostics, complete) || promoted_return
                stmts[index] = Stmt.For{var: variable, var_span: var_span, var2: variable_two, kind: kind, body: updated_body, span: span, arrow_body: arrow_body, label: label, auto_vectorization: vectorization}
            }
            .Loop(body, span, arrow_body, label) -> {
                updated_body := body
                promoted_return = sema_function_memory_annotate_scope(updated_body, chain, diagnostics, complete) || promoted_return
                stmts[index] = Stmt.Loop{body: updated_body, span: span, arrow_body: arrow_body, label: label}
            }
            .CountedLoop(init, condition, step, body, span, arrow_body, label) -> {
                updated_body := body
                promoted_return = sema_function_memory_annotate_scope(updated_body, chain, diagnostics, complete) || promoted_return
                stmts[index] = Stmt.CountedLoop{init: init, cond: condition, step: step, body: updated_body, span: span, arrow_body: arrow_body, label: label}
            }
            .Switch(subject, arms, else_body, span) -> {
                updated_arms := arms.copy()
                loop arm_index in 0..<updated_arms.len() {
                    arm_body := updated_arms[arm_index].body
                    promoted_return = sema_function_memory_annotate_scope(arm_body, chain, diagnostics, complete) || promoted_return
                    updated_arms[arm_index].body = arm_body
                }
                updated_else_body := else_body
                if else_body == .Val(else_statements) {
                    body := else_statements.copy()
                    promoted_return = sema_function_memory_annotate_scope(body, chain, diagnostics, complete) || promoted_return
                    updated_else_body = Val(body)
                }
                stmts[index] = Stmt.Switch{subject: subject, arms: updated_arms, else_body: updated_else_body, span: span}
            }
            .Expr(_) | .Assign(_, _, _, _) | .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Defer(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> {}
        }
        index += 1
    }
    promoted_return
}

sema_function_memory_propagate_transfers: fn(function: &Func, promoted: [String]) -> Bool Never! {
    returned := sema_function_memory_returned_names(function.body)
    changed := false
    index := 0
    loop index < function.body.len() {
        transferred := false
        if function.body[index] == {
            .Val(binding) -> {
                callee := sema_function_memory_called_function_name(binding.init)
                transferred = function.gc_scope && callee != None && sema_function_memory_contains_name(promoted, callee ?? "") && !binding.gc_transferred
                if sema_function_memory_contains_name(returned, binding.name) && (binding.gc_promotion != None || binding.gc_transferred || transferred) && !function.gc_return {
                    function.gc_return = true
                    changed = true
                }
            }
            .Expr(_) | .Assign(_, _, _, _) | .Return(_, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Defer(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> {}
        }
        // Only a newly transferred binding is rewritten; an unchanged one is
        // not copied out and back.
        if transferred {
            if function.body[index] == .Val(binding) {
                updated_binding := binding
                updated_binding.gc_transferred = true
                function.body[index] = Stmt.Val{binding: updated_binding}
            }
            changed = true
        }
        index += 1
    }
    changed
}

sema_function_memory_binding_may_own_heap: fn(binding: Binding) -> Bool Never! {
    if binding.ty != None -> return sema_function_memory_type_may_own_heap(binding.ty ?? Type.Named{name: "Unit"})
    sema_function_memory_expr_may_own_heap(binding.init)
}

sema_function_memory_type_may_own_heap: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Bool | .Char | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 -> false
        .FixedList(element, _) | .Option(element) | .Tagged(_, element) -> sema_function_memory_type_may_own_heap(element)
        .Tuple(fields) -> {
            loop field in fields { if sema_function_memory_type_may_own_heap(field.ty) -> return true }
            false
        }
        .String | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> true
    }
}

sema_function_memory_expr_may_own_heap: fn(expression: Expr) -> Bool Never! {
    if expression == {
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Char(_, _, _) | .UnitLit(_, _, _, _, _, _, _) -> false
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> true
    }
}

sema_function_memory_contains_name: fn(names: [String], name: String) -> Bool Never! {
    loop candidate in names { if candidate == name -> return true }
    false
}

sema_function_memory_append_name_unique: fn(names: &[String], name: String) Never! {
    if !sema_function_memory_contains_name(names, name) -> names.push(name.copy())
}

sema_function_memory_returned_name: fn(expression: Expr) -> String? {
    if expression == {
        .Ident(name, _, _) -> Val(name)
        .Paren(inner, _, _) -> sema_function_memory_returned_name(inner)
        .Ok(inner, _, _) -> sema_function_memory_returned_name(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_function_memory_returned_names: fn(stmts: [Stmt]) -> [String] Never! {
    names := [String]{}
    loop stmt in stmts {
        if stmt == {
            .Return(value, _) -> {
                if value == .Val(expression) {
                    name := sema_function_memory_returned_name(expression)
                    if name != None -> sema_function_memory_append_name_unique(names, name ?? "")
                }
            }
            .Policy(_, body, _) | .While(_, body, _, _, _) | .For(_, _, _, _, body, _, _, _, _) | .Loop(body, _, _, _) | .CountedLoop(_, _, _, body, _, _, _) -> {
                loop name in sema_function_memory_returned_names(body) -> sema_function_memory_append_name_unique(names, name)
            }
            .Switch(_, arms, else_body, _) -> {
                loop arm in arms {
                    loop name in sema_function_memory_returned_names(arm.body) -> sema_function_memory_append_name_unique(names, name)
                }
                if else_body == .Val(body) {
                    loop name in sema_function_memory_returned_names(body) -> sema_function_memory_append_name_unique(names, name)
                }
            }
            .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Defer(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> {}
        }
    }
    names
}

sema_function_memory_called_function_name: fn(expression: Expr) -> String? {
    if expression == {
        .Paren(inner, _, _) -> sema_function_memory_called_function_name(inner)
        .Call(call, _) -> Val(call.name)
        .Try(inner, _, _, _, _) -> sema_function_memory_called_function_name(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_function_memory_lvalue_root: fn(target: LValue) -> String? {
    if target == {
        .Local(name, _) -> Val(name)
        .Field(base, _, _) | .Index(base, _, _, _) -> if base == {
            .Ident(name, _, _) -> Val(name)
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
        }
    }
}

sema_function_memory_collect_expr_idents: fn(expression: Expr, names: &[String]) {
    if expression == {
        .Ident(name, _, _) -> sema_function_memory_append_name_unique(names, name)
        .Call(call, _) -> loop argument in call.args -> sema_function_memory_collect_expr_idents(argument.expr, names)
        .MethodCall(receiver, _, _, _, _, args, _) | .OptMethodCall(receiver, _, _, _, args, _, _) | .CallValue(receiver, args, _, _) -> {
            sema_function_memory_collect_expr_idents(receiver, names)
            loop argument in args -> sema_function_memory_collect_expr_idents(argument.expr, names)
        }
        .Binary(_, left, right, _, _) -> {
            sema_function_memory_collect_expr_idents(left, names)
            sema_function_memory_collect_expr_idents(right, names)
        }
        .Unary(_, inner, _, _) | .Field(inner, _, _, _) | .Deref(inner, _, _) | .RawOf(inner, _, _) | .Copy(inner, _, _) | .Place(inner, _, _, _) | .Tainted(inner, _, _, _) | .Present(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) -> sema_function_memory_collect_expr_idents(inner, names)
        .Try(inner, _, _, note, _) -> {
            sema_function_memory_collect_expr_idents(inner, names)
            if note == .Val(value) -> sema_function_memory_collect_expr_idents(value, names)
        }
        .OptField(base, _, _, _, _, _) -> sema_function_memory_collect_expr_idents(base, names)
        .Index(base, index, _, _, _) -> {
            sema_function_memory_collect_expr_idents(base, names)
            sema_function_memory_collect_expr_idents(index, names)
        }
        .Slice(base, start, end, range, _, _) -> {
            sema_function_memory_collect_expr_idents(base, names)
            if range == {
                .Val(value) -> {
                    sema_function_memory_collect_expr_idents(value, names)
                }
                .None -> {
                    sema_function_memory_collect_expr_idents(start, names)
                    sema_function_memory_collect_expr_idents(end, names)
                }
            }
        }
        .ListLit(items, _, _) -> loop item in items -> sema_function_memory_collect_expr_idents(item, names)
        .MapLit(entries, _, _) -> loop entry in entries {
            sema_function_memory_collect_expr_idents(entry.key, names)
            sema_function_memory_collect_expr_idents(entry.value, names)
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> loop field in fields -> sema_function_memory_collect_expr_idents(field.value, names)
        .TypedLit(_, body, _, _) -> sema_function_memory_collect_typed_lit_idents(body, names)
        .TupleLit(fields, _, _, _) -> loop field in fields -> sema_function_memory_collect_expr_idents(field.value, names)
        .EnumLit(_, _, _, args, _, _, _) -> loop argument in args {
            if argument == {
                .Positional(value) -> {
                    sema_function_memory_collect_expr_idents(value, names)
                }
                .Named(_, value) -> {
                    sema_function_memory_collect_expr_idents(value, names)
                }
            }
        }
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == {
                    .Interp(value, _) -> {
                        sema_function_memory_collect_expr_idents(value, names)
                    }
                    .Lit(_) | .Byte(_) -> {}
                }
            }
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .Range(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .Lambda(_, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}

sema_function_memory_collect_typed_lit_idents: fn(body: TypedLitBody, names: &[String]) {
    if body == {
        .Fields(fields) -> loop field in fields -> sema_function_memory_collect_expr_idents(field.value, names)
        .Elements(elements) -> loop value in elements -> sema_function_memory_collect_expr_idents(value, names)
        .Entries(entries) -> loop entry in entries {
            sema_function_memory_collect_expr_idents(entry.key, names)
            sema_function_memory_collect_expr_idents(entry.value, names)
        }
        .Value(value) -> sema_function_memory_collect_expr_idents(value, names)
        .ByteText(_) | .Empty -> {}
    }
}

sema_function_memory_collect_sorted_idents: fn(expression: Expr) -> [String] {
    names := [String]{}
    sema_function_memory_collect_expr_idents(expression, names)
    index := 1
    loop index < names.len() {
        cursor := index
        loop cursor > 0 && names[cursor] < names[cursor - 1] {
            previous := names[cursor - 1]
            names[cursor - 1] = names[cursor]
            names[cursor] = previous
            cursor -= 1
        }
        index += 1
    }
    names
}

sema_function_memory_add_promotion_edges: fn(expression: Expr, slot: String, group: Int, edges: &[GCPromotionEdge]) {
    loop binding in sema_function_memory_collect_sorted_idents(expression) {
        edges.push(GCPromotionEdge{binding: binding, slot: slot, group: group})
    }
}

sema_function_memory_promotion_edges: fn(expression: Expr) -> [GCPromotionEdge] {
    edges := [GCPromotionEdge]{}
    if expression == {
        .StructLit(_, _, _, _, fields, _, _, _) -> loop field in fields -> sema_function_memory_add_promotion_edges(field.value, "field:{field.name}", 0, edges)
        .TypedLit(_, body, _, _) -> sema_function_memory_typed_lit_edges(body, edges)
        .ListLit(items, _, _) -> {
            index := 0
            loop item in items {
                sema_function_memory_add_promotion_edges(item, "collection", index, edges)
                index += 1
            }
        }
        .TupleLit(fields, _, _, _) -> loop field in fields -> sema_function_memory_add_promotion_edges(field.value, "field:{field.name}", 0, edges)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> sema_function_memory_add_promotion_edges(expression, "value", 0, edges)
    }
    edges
}

sema_function_memory_typed_lit_edges: fn(body: TypedLitBody, edges: &[GCPromotionEdge]) {
    if body == {
        .Fields(fields) -> loop field in fields -> sema_function_memory_add_promotion_edges(field.value, "typed_lit", 0, edges)
        .Elements(elements) -> loop value in elements -> sema_function_memory_add_promotion_edges(value, "typed_lit", 0, edges)
        .Entries(entries) -> loop entry in entries {
            sema_function_memory_add_promotion_edges(entry.key, "typed_lit", 0, edges)
            sema_function_memory_add_promotion_edges(entry.value, "typed_lit", 0, edges)
        }
        .Value(value) -> sema_function_memory_add_promotion_edges(value, "typed_lit", 0, edges)
        .ByteText(_) | .Empty -> {}
    }
}

sema_function_memory_edge_less: fn(left: GCPromotionEdge, right: GCPromotionEdge) -> Bool Never! {
    if left.slot != right.slot -> return left.slot < right.slot
    if left.group != right.group -> return left.group < right.group
    left.binding < right.binding
}

sema_function_memory_edge_equal: fn(left: GCPromotionEdge, right: GCPromotionEdge) -> Bool Never! {
    left.binding == right.binding && left.slot == right.slot && left.group == right.group
}

sema_function_memory_sort_and_deduplicate_edges: fn(edges: &[GCPromotionEdge]) Never! {
    index := 1
    loop index < edges.len() {
        cursor := index
        loop cursor > 0 && sema_function_memory_edge_less(edges[cursor], edges[cursor - 1]) {
            previous := edges[cursor - 1]
            edges[cursor - 1] = edges[cursor]
            edges[cursor] = previous
            cursor -= 1
        }
        index += 1
    }
    unique := [GCPromotionEdge]{}
    loop edge in edges {
        if unique.len() == 0 || !sema_function_memory_edge_equal(unique[unique.len() - 1], edge) -> unique.push(edge.copy())
    }
    loop edges.len() > 0 -> _ := edges.pop()
    loop edge in unique -> edges.push(edge)
}

sema_function_memory_collection_len: fn(expression: Expr) -> Int? {
    return if expression == {
        .ListLit(items, _, _) -> Val(items.len())
        .TypedLit(head, body, _, _) -> {
            if body != TypedLitBody.Empty -> return None
            if head == .Val(ty) {
                if ty == {
                    .List(_) | .FixedList(_, _) -> {
                        return Val(0)
                    }
                    .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
                }
            }
            None
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}
