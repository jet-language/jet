// Instances: what sema publishes for a generic function or type declaration
// built at concrete type arguments. A checked function's tree holds, as rows
// of its type table (FnBody.tree.types), every type its facts name: each
// node's type, each binder's (TLocal.ty), each call's type arguments, and the
// types its signature, lambdas, patterns and conversions record
// (sema_body_fact_types). An instance's types are those rows with the
// instance's type arguments bound (sema_instance_types), row for row, so the
// IR builder reads an instance type by row and never substitutes one.
use jet_foundation.[
    BodyCallArg,
    BodyIfCond,
    BodyLambda,
    BodyParameter,
    BodyPattern,
    BodyTree,
    NodeKind,
    StmtKind,
    TCapture,
    TContractResult,
    TFailureCarrier,
    TFuncKind,
    TLocal,
    TTypeDef,
    Type,
    TypeTable,
    type_table_find,
    type_table_intern,
]

// The types of `generic` (a checked function's FnBody.tree.types) with each
// type parameter `names[i]` bound to `args[i]`, row for row.
sema_instance_types: fn(generic: TypeTable, names: [String], args: [Type]) -> [Type] Never! {
    loop ty in generic.types -> sema_inference_substitute_type(ty, names, args)
}

// One row of sema_instance_types: the row of `ty` in `generic` at the
// instance. None when the tree's facts never named `ty`.
sema_instance_type: fn(generic: TypeTable, names: [String], args: [Type], ty: Type) -> Type? Never! {
    row: type_table_find(generic, ty) ?? return None
    Val(sema_inference_substitute_type(generic.types[row], names, args))
}

// Member type `written` of type declaration `def` (a field, variant payload,
// base or alias target) in the instance binding its parameters to `args`.
sema_type_def_instance_type: fn(def: TTypeDef, args: [Type], written: Type) -> Type Never! {
    if args.len() == 0 -> return written.copy()
    names: loop parameter in def.generic_params -> parameter.name
    sema_inference_substitute_type(written, names, args)
}

// Interns into `tree.types` every type the facts of a function's tree and
// signature name, beyond its nodes' own types: an instance publishes each of
// them (sema_instance_types).
sema_body_fact_types: fn(tree: &BodyTree, params: [BodyParameter], ret: Type?, kind: TFuncKind, failure: TFailureCarrier) Never! {
    loop parameter in params {
        sema_fact_type(tree, parameter.ty)
        sema_fact_local(tree, parameter.local)
    }
    if ret == .Val(returned) -> sema_fact_type(tree, returned)
    if kind == {
        .Method(_, owner_type) | .TraitMethod(_, _, owner_type, _, _) -> sema_fact_type(tree, owner_type)
        .TopLevel -> {}
    }
    sema_fact_failure(tree, failure)
    nodes: tree.nodes.copy()
    loop node in nodes -> sema_fact_node(tree, node.kind)
    stmts: tree.stmts.copy()
    loop statement in stmts -> sema_fact_stmt(tree, statement)
}

// A checked function's return `ret` and failure carrier `failure`, set after
// its tree was flattened (sema_failure_reconcile_infallible), published in
// its tree's types like the rest of its signature (sema_body_fact_types).
sema_body_fact_return: fn(tree: &BodyTree, ret: Type, failure: TFailureCarrier) Never! {
    sema_fact_type(tree, ret)
    sema_fact_failure(tree, failure)
}

sema_fact_type: fn(tree: &BodyTree, ty: Type) Never! {
    _: type_table_intern(tree.types, ty)
}

sema_fact_types: fn(tree: &BodyTree, types: [Type]) Never! {
    loop ty in types -> sema_fact_type(tree, ty)
}

sema_fact_local: fn(tree: &BodyTree, local: TLocal) Never! {
    sema_fact_type(tree, local.ty)
    if local.persist_ty == .Val(persisted) -> sema_fact_type(tree, persisted)
    if local.string_bytes_source == .Val(source) -> sema_fact_local(tree, source)
}

sema_fact_failure: fn(tree: &BodyTree, failure: TFailureCarrier) Never! {
    if failure == {
        .Result(success, error) -> {
            sema_fact_type(tree, success)
            sema_fact_type(tree, error)
        }
        .Optional(value) | .Diverges(value) -> sema_fact_type(tree, value)
        .Infallible -> {}
    }
}

sema_fact_args: fn(tree: &BodyTree, args: [BodyCallArg]) Never! {
    loop arg in args {
        if arg.widen_to_union == .Val(union) -> sema_fact_type(tree, union)
        if arg.box_as_trait == .Val(target) -> sema_fact_type(tree, target)
    }
}

sema_fact_captures: fn(tree: &BodyTree, captures: [TCapture]) Never! {
    loop capture in captures {
        sema_fact_type(tree, capture.ty)
        sema_fact_local(tree, capture.local)
    }
}

sema_fact_lambda: fn(tree: &BodyTree, lambda: BodyLambda) Never! {
    sema_fact_types(tree, lambda.param_types)
    if lambda.ret == .Val(returned) -> sema_fact_type(tree, returned)
    sema_fact_captures(tree, lambda.captures)
    sema_fact_failure(tree, lambda.failure_carrier)
}

sema_fact_pattern: fn(tree: &BodyTree, pattern: BodyPattern) Never! {
    loop binding in pattern.bindings -> sema_fact_type(tree, binding.ty)
}

sema_fact_condition: fn(tree: &BodyTree, condition: BodyIfCond) Never! {
    if condition == {
        .And(left, right) -> {
            sema_fact_condition(tree, left)
            sema_fact_condition(tree, right)
        }
        .IfLet(pattern, _) -> sema_fact_pattern(tree, pattern)
        .Plain(_) -> {}
    }
}

sema_fact_contract_result: fn(tree: &BodyTree, result: TContractResult) Never! {
    sema_fact_type(tree, result.carrier_ty)
    sema_fact_type(tree, result.binding_ty)
    sema_fact_local(tree, result.carrier_local)
    sema_fact_local(tree, result.binding_local)
}

sema_fact_node: fn(tree: &BodyTree, kind: NodeKind) Never! {
    if kind == {
        .Local(local) -> sema_fact_local(tree, local)
        .Call(_, type_args, args) -> {
            sema_fact_types(tree, type_args)
            sema_fact_args(tree, args)
        }
        .IndirectCall(_, type_args, args, signature) -> {
            sema_fact_types(tree, type_args)
            sema_fact_args(tree, args)
            sema_fact_type(tree, signature)
        }
        .MethodCall(_, _, type_args, args) -> {
            sema_fact_types(tree, type_args)
            sema_fact_args(tree, args)
        }
        .StaticCall(_, owner_type, _, type_args, args) -> {
            if owner_type == .Val(owner) -> sema_fact_type(tree, owner)
            sema_fact_types(tree, type_args)
            sema_fact_args(tree, args)
        }
        .CoreCall(_, _, _, type_args, _, fallibility) -> {
            sema_fact_types(tree, type_args)
            sema_fact_failure(tree, fallibility)
        }
        .AllocNew(_, args) -> sema_fact_args(tree, args)
        .TraitBox(_, target) -> sema_fact_type(tree, target)
        .List(_, trait_coercion) -> {
            if trait_coercion == .Val(target) -> sema_fact_type(tree, target)
        }
        .PtrFromAddr(_, element) -> sema_fact_type(tree, element)
        .TypeTest(subject, _) -> sema_fact_type(tree, subject)
        .TraitConst(owner, _, _) -> sema_fact_type(tree, owner)
        .NumberParam(param) -> sema_fact_type(tree, param)
        .CopyPhase(_, _, _, _) -> {}
        .Field(_, field) -> sema_fact_type(tree, field.ty)
        .StructLit(fields) -> {
            loop field in fields -> sema_fact_type(tree, field.field.ty)
        }
        .SharedGuardMap(_, path, _) -> {
            loop field in path -> sema_fact_type(tree, field.ty)
        }
        .SharedGuardSplit(_, first, second, _) -> {
            loop field in first -> sema_fact_type(tree, field.ty)
            loop field in second -> sema_fact_type(tree, field.ty)
        }
        .SharedGuardWait(_, _, predicate) -> sema_fact_lambda(tree, predicate)
        .Try(_, conversion, failure) -> {
            if conversion == .Typed(_, source, target) {
                sema_fact_type(tree, source)
                sema_fact_type(tree, target)
            }
            sema_fact_failure(tree, failure)
        }
        .TryWithContext(_, _, conversion, _, _, _) -> {
            if conversion == .Typed(_, source, target) {
                sema_fact_type(tree, source)
                sema_fact_type(tree, target)
            }
        }
        .Lambda(value) -> sema_fact_lambda(tree, value)
        .RawAddressOf(place) -> {
            if place == .Local(local) -> sema_fact_local(tree, local)
        }
        .HostCall(call) -> {
            if call == {
                .CellGuardProject(_, _, result_type, _, _) -> sema_fact_type(tree, result_type)
                .NumericBounds(ty, _) -> sema_fact_type(tree, ty)
                .Method(_, _, _) | .OptionProbe(_, _) | .TupleIndex(_, _) | .SwitchSubjectValue | .YieldSend(_) | .ComptimeInput(_, _, _) | .MemoStats(_, _) | .ContextRead(_) -> {}
            }
        }
        .HandleMethod(_, operation, _) -> {
            if operation == .DynDecode(ty) -> sema_fact_type(tree, ty)
        }
        .CoreClosureCall(closure) -> {
            if closure == {
                .Spawn(_, _, _, executable) | .Realtime(_, _, executable) | .Guard(executable) | .OnCommit(_, executable) | .OnRollback(_, executable) | .UIClickSlot(executable) | .UITextInputOnDrop(_, _, executable) | .ReactiveDerived(executable) | .ReactiveEffect(executable) | .UIReactiveRender(executable) -> sema_fact_lambda(tree, executable)
            }
        }
        .FnValue(value) -> {
            if value == {
                .NamedFn(_, lambda) -> {
                    if lambda == .Val(executable) -> sema_fact_lambda(tree, executable)
                }
                .Policy(fn_type, policy_args, _, _, captures, _) -> {
                    sema_fact_type(tree, fn_type)
                    sema_fact_args(tree, policy_args)
                    sema_fact_captures(tree, captures)
                }
                .Call(_, args) -> sema_fact_args(tree, args)
                .Send(_) -> {}
            }
        }
        .IfExpr(condition, _, _, _, _) -> sema_fact_condition(tree, condition)
        .PatternMatches(_, pattern) -> sema_fact_pattern(tree, pattern)
        .OrFallback(_, _, ambient_err) -> {
            if ambient_err == .Val(local) -> sema_fact_local(tree, local)
        }
        .OptMethodCall(_, binding, _, _) -> sema_fact_local(tree, binding)
        .BuiltinMethod(_, operation, _) -> {
            if operation == {
                .Zip(_, _, _, _, _, field_types) -> sema_fact_types(tree, field_types)
                .OptionZip(element) -> sema_fact_type(tree, element)
                .AtomicMethod(_) | .LenString | .LenList | .IsEmpty | .Push | .ListTryNew | .ListTryWithCapacity | .TryPush | .TryReserve | .TryInsertMap | .TryStringPush | .Pop | .PriorityQueuePop | .InsertMap | .AddNewMap | .MapSetDefault | .MapUpdate | .MapMerge | .MapMergeWith | .InsertList | .RemoveMap | .RemoveList(_, _) | .CountList | .Counts | .ExtendList | .ConcatList | .GetMap | .GetList | .First | .Last | .Contains | .IndexOf | .Reverse | .SwapList | .ListFill | .Sort | .SortDesc | .OrderingThen | .OrderingReverse | .JoinSep | .Sum(_, _) | .Product(_) | .Min(_) | .Max(_) | .Flatten | .Intersperse | .Unzip | .Clear | .Chars | .Bytes(_) | .StringFromBytes | .StringFromBytesLossy | .Trim | .TrimStart | .TrimEnd | .PadStart | .PadEnd | .StringIndexOf | .StringCount | .StringIsAlphabetic | .StringIsNumeric | .StringIsWhitespace | .StringIsASCII | .StringToTitle | .StringMethod(_) | .StringSplitOnce | .StringCutLast | .Split | .Lines | .ParseInt | .ParseFloat | .IntToRadix | .IntFromRadix | .StartsWith | .EndsWith | .Replace | .ToUpper | .ToLower | .ToASCIILower | .ToASCIIUpper | .Repeat | .Slice(_) | .After | .Before | .TrimView | .AfterView | .BeforeView | .Keys | .Values | .ContainsKey | .ToString | .Take | .Skip | .IterToList | .IterCollect | .ListLazy | .StepBy | .Dedup | .Chunks | .Windows | .IterRepeat | .IterCycle | .IterDropLast | .IterNext | .IterShuffle | .IterIsSorted | .IterLastIndexOf | .IterAverage(_) | .IterCompare | .IterSplit | .ListSlice | .ListEqual | .ListBinarySearch | .ListUnion | .ListIntersection | .ListDifference | .ListRandom | .ListMinMax | .MapEqual | .MapFirst | .MapToList | .MapTopN | .MapMin | .MapMax | .MapIntersection | .MapSliceKeys | .MapFromKeys | .MapContainsValue | .MapPopFirst | .ListReplace | .Indexed | .Indexes | .SetFrom | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate | .SetSymmetricDifferenceUpdate | .SetRemove | .SetToList | .SetUnion | .SetIntersection | .SetDifference | .SetSymmetricDifference | .SetIsSubset | .SetIsSuperset | .SetIsDisjoint | .SetEqual | .SetCapacity | .SetFirst | .SetValues | .SetPop | .SetReplace | .SetSort | .SetShuffle | .SortedSetFrom | .SortedSetInsert | .SortedSetRemove | .SortedSetToList | .SortedSetUnion | .SortedSetIntersection | .SortedSetDifference | .SortedSetSymmetricDifference | .SortedSetIsSubset | .SortedSetIsSuperset | .SortedSetIsDisjoint | .PriorityQueueFrom | .PriorityQueuePeek | .PriorityQueueToSortedList | .PriorityQueueRemove(_, _) | .KeyOrdered(_, _) | .LRUPut | .LRUAddNew | .LRUGet | .LRURemove | .LRUCapacity | .LRUKeys | .BitSetAdd | .BitSetRemove | .BitSetCount | .BitSetToList | .ByteBufferFrom | .ByteBufferWrite(_) | .ByteBufferToBytes | .ByteBufferMethod(_) | .ByteBufferWithCapacity | .BagAdd | .BagRemove | .BagHas | .BagCount | .DequePushFront | .DequePushBack | .DequePopFront | .DequePopBack | .DequePeekFront | .DequePeekBack | .DequeCapacity | .DequeContains | .DequeGet | .DequeDelete | .DequeToList | .DequeJoin | .DequeReverse | .DequeSplit | .DequeFrom | .TryCollect | .ViewNew(_) | .SplitWrite | .GetDisjointWrite | .ListFillRepeat -> {}
            }
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .GlobalShared(_, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .Map(_) | .EnumCtor(_, _, _) | .Borrow(_, _) | .Deref(_) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .ConditionNotify(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .DecodeUnder(_, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OptField(_, _, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .Never(_, _) -> {}
    }
}

sema_fact_stmt: fn(tree: &BodyTree, statement: StmtKind) Never! {
    if statement == {
        .ContractScope(_, _, _, result, _) -> sema_fact_contract_result(tree, result)
        .Let(local, let_ty, _, _, _, _) -> {
            sema_fact_local(tree, local)
            if let_ty == .Annotated(ty, _) -> sema_fact_type(tree, ty)
        }
        .RefutableBind(pattern, _, _, _) -> sema_fact_pattern(tree, pattern)
        .TupleDestructure(temp, _, _, binds, _) | .StructDestructure(temp, _, _, binds, _) -> {
            sema_fact_local(tree, temp)
            loop bind in binds -> sema_fact_local(tree, bind.local)
        }
        .ListDestructure(temp, _, _, _, elements, _) -> {
            sema_fact_local(tree, temp)
            loop element in elements -> sema_fact_local(tree, element)
        }
        .Assign(place, _, _, _, _) -> {
            if place == .Local(local) -> sema_fact_local(tree, local)
        }
        .ForRange(_, local, _, _, _, _, _, _, _) -> sema_fact_local(tree, local)
        .Range(_, variable, _, _, _, _, _, _, _, _) -> sema_fact_local(tree, variable)
        .TaskGroup(group, _, _, _) -> sema_fact_local(tree, group)
        .If(condition, _, _, _, _) -> sema_fact_condition(tree, condition)
        .Match(_, arms, _, _) | .EnumMatch(_, arms, _, _, _) -> {
            loop arm in arms -> sema_fact_pattern(tree, arm.pattern)
        }
        .ForIn(_, variable, variable_two, _, _, _, method_kind, _, _, _, _, _) -> {
            sema_fact_local(tree, variable)
            if variable_two == .Val(second) -> sema_fact_local(tree, second)
            if method_kind == .Val(method) {
                if method == .Iterable(_, _, _, _, item_type) -> sema_fact_type(tree, item_type)
            }
        }
        .Reactive(executable, _) -> sema_fact_lambda(tree, executable)
        .Layout(handle, _, _, _) -> sema_fact_local(tree, handle)
        .Transact(handle, snapshots, stm, _, _) -> {
            if handle == .Val(local) -> sema_fact_local(tree, local)
            loop snapshot in snapshots {
                sema_fact_local(tree, snapshot.local)
                if snapshot.rollback_type == .Val(rollback) -> sema_fact_type(tree, rollback)
            }
            if stm == .Val(local) -> sema_fact_local(tree, local)
        }
        .Contract(_) | .CountedLoop(_, _, _, _, _, _, _) | .ExprStmt(_, _) | .Return(_, _) | .DeferClose(_, _, _) | .Loop(_, _, _) | .While(_, _, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) | .RangeSwitch(_, _, _, _) | .Inline(_, _) | .DebugOnly(_, _) | .MixedSwitch(_, _, _, _, _) | .Unsafe(_, _) | .UnsafeBlock(_, _, _) | .SentryPolicy(_, _, _) | .Impure(_, _) | .Region(_, _) | .ContextBlock(_, _, _) | .Live(_, _) | .Shield(_, _) | .Defer(_, _) | .ScopeMember(_, _, _) | .GCEdit(_, _, _, _, _, _, _) -> {}
    }
}
