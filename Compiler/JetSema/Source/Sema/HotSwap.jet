// D-HOTSWAP1: compare module surfaces in sema; retain state per canonical Persist binding.
use jet_foundation.[Diagnostic, EnumDef, Func, Item, LoadedModule, MigrationOp, ProgramBundle, StructDef, Type, TypeParam, VariantPayload]
use jet_foundation.Syntax
use jet_foundation.HotSwap.[HotSwapCompatibility, HotSwapDecision, StateRetentionFact]
use jet_foundation.SchemaMigration.[SchemaMigrationOp, SchemaMigrationPlan, SchemaMigrationStep]
use jet_sema.Schema.[canonical_migration_shape, load_snapshot]

// Rust: crates/jet-sema/src/Sema/HotSwap.rs:33
pub fn e2210(what_changed: String) -> Diagnostic {
    Diagnostic.error("E2210", "this edit changed a type, so `jet dev` is restarting instead of swapping — {what_changed}",
        "a hot swap re-applies code while the program's types stay the same; changing a struct field, an enum variant, or a function signature changes the shape of your data, so the running code is rebuilt cleanly from the new types",
        "nothing to fix — `jet dev` restarted with the new types; this note just explains why the swap became a restart. Type-stable edits (function bodies, statements) swap without a restart", None)
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:53
fn canonical_migration_plans(bundle: ProgramBundle, module: LoadedModule) -> [SchemaMigrationPlan] {
    plans := [SchemaMigrationPlan]{}
    loop item in module.items {
        if item != .Struct(structure) -> continue
        published :: structure.is_published_schema || structure.derives.iter().any(fn(marker, _) { marker == Syntax.MARKER_PUBLISHED_SCHEMA })
        if !published -> continue
        if load_snapshot(bundle.project_root, structure.name).is_none() -> continue
        migrations := module.items.iter().filter_map(fn(item) {
            if item == .Migration(m) { if m.type_name == structure.name -> Val(m.clone()) else -> None } else -> None
        }).collect()
        if migrations.is_empty() -> continue
        canonical :: canonical_migration_shape(module.display, structure, migrations) or _ => { continue }
        steps := [SchemaMigrationStep]{}
        loop block_index, migration in migrations.enumerate() {
            ops := [SchemaMigrationOp]{}
            loop op in migration.ops {
                ops.push(if op == {
                    .Rename(from: from, to: to, ..) -> SchemaMigrationOp.Rename{from_key: canonical.json_key(from), to_key: canonical.json_key(to)}
                    .Remove(field: field, ..) -> SchemaMigrationOp.Remove{key: canonical.json_key(field)}
                    .Add(field: field, ty: ty, default_fn: default_fn, ..) -> SchemaMigrationOp.Add{
                        key: canonical.json_key(field), type_name: ty.name(), default_fn: default_fn.clone() ?? "",
                    }
                    .Change(field: field, from_ty: from_ty, to_ty: to_ty, conv_fn: conv_fn, ..) -> SchemaMigrationOp.Change{
                        key: canonical.json_key(field), from_type: from_ty.name(), to_type: to_ty.name(), converter_fn: conv_fn.clone() ?? "",
                    }
                })
            }
            steps.push(SchemaMigrationStep.new("v{block_index + 1}", "v{block_index + 2}", ^ops))
        }
        if steps.iter().all(fn(step) { step.ops.is_empty() }) || steps.iter().flat_map(fn(step) { step.ops.iter() }).any(fn(op) {
            if op == { .Add(default_fn: default_fn, ..) -> default_fn.is_empty() .Change(converter_fn: converter_fn, ..) -> converter_fn.is_empty() _ -> false }
        }) -> continue
        plans.push(SchemaMigrationPlan.new(structure.name.clone(), canonical.historical, ^steps))
    }
    ^plans
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:165
pub fn type_stable_decision(old: ProgramBundle, new: ProgramBundle, module_name: String) -> HotSwapDecision [Diagnostic]! {
    old_mod :: pick_module(old, module_name)
    new_mod :: pick_module(new, module_name)
    changed :: if (old_mod, new_mod) == {
        (.Val(o), .Val(n)) -> surface_changes(o, n)
        (.Val(_), .None) | (.None, .Val(_)) -> [String]{"the module `{module_name}` was added or removed"}
        (.None, .None) -> [String]{}
    }
    changed_functions :: if (old_mod, new_mod) == {
        (.Val(o), .Val(n)) -> changed_function_ids(o, n)
        (.Val(o), .None) -> { keys := callable_functions(o).keys().collect(); keys.sort(); ^keys }
        (.None, .Val(n)) -> { keys := callable_functions(n).keys().collect(); keys.sort(); ^keys }
        (.None, .None) -> [String]{}
    }
    compatibility :: if changed.is_empty() -> HotSwapCompatibility.Compatible else -> HotSwapCompatibility.Incompatible{reason: changed.join("; ")}
    state :: persistent_state_facts(old_mod, new_mod, compatibility.reason())
    schema_migrations :: if new_mod == .Val(module) -> canonical_migration_plans(new, module) else -> [SchemaMigrationPlan]{}
    HotSwapDecision{module: module_name.to_string(), compatibility: compatibility, changed: changed,
        changed_functions: changed_functions, state: state, schema_migrations: schema_migrations, rechecked_items: [], change_facts: []}
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:211
fn pick_module(bundle: ProgramBundle, name: String) -> LoadedModule? from bundle {
    if bundle.modules.iter().find(fn(m) { m.display == name || m.alias == name }) == .Val(m) -> return Val(m)
    bundle.modules.get(bundle.entry)
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:224
fn surface_changes(old: LoadedModule, new: LoadedModule) -> [String] {
    changes := [String]{}
    old_structs :: structs(old)
    new_structs :: structs(new)
    old_names := old_structs.keys().collect(); old_names.sort()
    new_names := new_structs.keys().collect(); new_names.sort()
    loop name in old_names {
        s :: old_structs[name]
        if new_structs.get(name) == .Val(n) {
            if struct_diff(name, s, n) == .Val(change) { changes.push(change) }
        } else { changes.push("struct `{name}` was removed") }
    }
    loop name in new_names { if !old_structs.contains_key(name) { changes.push("struct `{name}` was added") } }
    old_enums :: enums(old)
    new_enums :: enums(new)
    old_enum_names := old_enums.keys().collect(); old_enum_names.sort()
    new_enum_names := new_enums.keys().collect(); new_enum_names.sort()
    loop name in old_enum_names {
        e :: old_enums[name]
        if new_enums.get(name) == .Val(n) {
            if enum_diff(name, e, n) == .Val(change) { changes.push(change) }
        } else { changes.push("enum `{name}` was removed") }
    }
    loop name in new_enum_names { if !old_enums.contains_key(name) { changes.push("enum `{name}` was added") } }
    old_functions :: callable_functions(old)
    new_functions :: callable_functions(new)
    old_ids := old_functions.keys().collect(); old_ids.sort()
    new_ids := new_functions.keys().collect(); new_ids.sort()
    loop identity in old_ids {
        old_function :: old_functions[identity]
        if new_functions.get(identity) == .Val(new_function) {
            if fn_sig_diff(old_function.name, old_function, new_function) == .Val(change) { changes.push(change) }
        } else { changes.push("function `{old_function.name}` was removed") }
    }
    loop identity in new_ids {
        if !old_functions.contains_key(identity) { changes.push("function `{new_functions[identity].name}` was added") }
    }
    ^changes
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:283
fn structs(m: LoadedModule) -> [String:StructDef] from m {
    out := [String:StructDef]{}
    loop item in m.items { if item == .Struct(definition) { _ :: out.insert(definition.name, definition) } }
    ^out
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:293
fn enums(m: LoadedModule) -> [String:EnumDef] from m {
    out := [String:EnumDef]{}
    loop item in m.items { if item == .Enum(definition) { _ :: out.insert(definition.name, definition) } }
    ^out
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:303
fn changed_function_ids(old: LoadedModule, new: LoadedModule) -> [String] {
    old_functions :: callable_functions(old)
    new_functions :: callable_functions(new)
    changed := [String]{}
    old_ids := old_functions.keys().collect(); old_ids.sort()
    new_ids := new_functions.keys().collect(); new_ids.sort()
    loop identity in old_ids {
        old_function :: old_functions[identity]
        if new_functions.get(identity) == .Val(new_function) {
            if fn_sig_diff(old_function.name, old_function, new_function).is_some() || function_body_changed(old, old_function, new, new_function) {
                changed.push(identity.clone())
            }
        } else { changed.push(identity.clone()) }
    }
    loop identity in new_ids { if !old_functions.contains_key(identity) { changed.push(identity.clone()) } }
    ^changed
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:327
fn function_body_changed(old_module: LoadedModule, old: Func, new_module: LoadedModule, new: Func) -> Bool {
    old_source :: old_module.source.get(old.span.start..old.span.end)
    new_source :: new_module.source.get(new.span.start..new.span.end)
    old_source != new_source || "{old.body:?}" != "{new.body:?}"
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:341
fn callable_functions(m: LoadedModule) -> [String:Func] from m {
    module :: module_identity(m)
    out := [String:Func]{}
    loop item in m.items {
        if item == {
            .Func(function) -> { _ :: out.insert("{module}::fn:{function.name}", function) }
            .Struct(definition) -> {
                loop function in definition.methods { _ :: out.insert("{module}::struct:{definition.name}::method:{function.name}", function) }
                loop implementation in definition.trait_impls {
                    loop function in implementation.methods { _ :: out.insert("{module}::struct:{definition.name}::trait:{implementation.trait_name}::method:{function.name}", function) }
                }
            }
            .Enum(definition) -> {
                loop function in definition.methods { _ :: out.insert("{module}::enum:{definition.name}::method:{function.name}", function) }
                loop implementation in definition.trait_impls {
                    loop function in implementation.methods { _ :: out.insert("{module}::enum:{definition.name}::trait:{implementation.trait_name}::method:{function.name}", function) }
                }
            }
            .Impl(implementation) -> {
                loop function in implementation.methods {
                    trait_name :: implementation.trait_name ?? "inherent"
                    _ :: out.insert("{module}::impl:{implementation.type_name}::{trait_name}::method:{function.name}", function)
                }
            }
            _ -> {}
        }
    }
    ^out
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:406
fn persistent_state_facts(old: LoadedModule?, new: LoadedModule?, reason: String?) -> [StateRetentionFact] {
    old_bindings :: persistent_bindings(old)
    new_bindings :: persistent_bindings(new)
    keys := [String:Bool]{}
    loop key in old_bindings.keys() { _ :: keys.insert(key.clone(), true) }
    loop key in new_bindings.keys() { _ :: keys.insert(key.clone(), true) }
    sorted_keys := keys.keys().collect(); sorted_keys.sort()
    fresh_reason :: reason ?? "persistent state key was added or removed"
    facts := [StateRetentionFact]{}
    loop key in sorted_keys {
        old_present :: old_bindings.contains_key(key)
        new_present :: new_bindings.contains_key(key)
        old_ty :: old_bindings.get(key).flatten()
        new_ty :: new_bindings.get(key).flatten()
        fact :: if (old_present, new_present, old_ty, new_ty) == {
            (true, true, .Val(old_ty), .Val(new_ty)) -> {
                if types_eq(old_ty, new_ty) -> StateRetentionFact.preserve(key)
                else -> StateRetentionFact.fresh(key, "persistent binding type changed; reset to the new declaration")
            }
            (true, true, _, _) -> StateRetentionFact.fresh(key, "persistent binding type is unavailable")
            (true, false, _, _) | (false, true, _, _) -> StateRetentionFact.fresh(key, fresh_reason)
            (false, false, _, _) -> panic("persistent key came from neither bundle")
        }
        facts.push(fact)
    }
    ^facts
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:445
fn persistent_bindings(module: LoadedModule?) -> [String:Type?] from module {
    out := [String:Type?]{}
    if module != .Val(module) -> return ^out
    loop item in module.items {
        if item == .Const(constant) {
            if constant.is_persist { _ :: out.insert("{module.alias}::{constant.name}", constant.ty) }
        }
    }
    ^out
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:464
fn module_identity(module: LoadedModule) -> String from module {
    if module.display.is_empty() -> module.alias else -> module.display
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:474
fn struct_diff(name: String, old: StructDef, new: StructDef) -> String? {
    if !type_params_eq(old.type_params, new.type_params) -> return Val("struct `{name}` changed its type parameters")
    if old.layout != new.layout -> return Val("struct `{name}` changed its layout")
    if old.fields.len() != new.fields.len() -> return Val("struct `{name}` changed its fields")
    loop (o, n) in old.fields.iter().zip(new.fields) {
        if o.name != n.name -> return Val("struct `{name}` renamed field `{o.name}` to `{n.name}`")
        if !types_eq(o.ty, n.ty) -> return Val("struct `{name}` retyped field `{o.name}`")
    }
    None
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:498
fn enum_diff(name: String, old: EnumDef, new: EnumDef) -> String? {
    if !type_params_eq(old.type_params, new.type_params) -> return Val("enum `{name}` changed its type parameters")
    if old.c_layout_tag() != new.c_layout_tag() -> return Val("enum `{name}` changed its layout")
    if old.variants.len() != new.variants.len() -> return Val("enum `{name}` changed its variants")
    loop (o, n) in old.variants.iter().zip(new.variants) {
        if o.name != n.name -> return Val("enum `{name}` renamed variant `{o.name}` to `{n.name}`")
        if o.discriminant != n.discriminant -> return Val("enum `{name}` changed the discriminant of variant `{o.name}`")
        if !payload_eq(o.payload, n.payload) -> return Val("enum `{name}` changed the payload of variant `{o.name}`")
    }
    None
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:531
fn fn_sig_diff(name: String, old: Func, new: Func) -> String? {
    if !type_params_eq(old.type_params, new.type_params) -> return Val("function `{name}` changed its type parameters")
    if old.params.len() != new.params.len() -> return Val("function `{name}` changed its parameters")
    loop (o, n) in old.params.iter().zip(new.params) {
        if !types_eq(o.ty, n.ty) || o.convention != n.convention -> return Val("function `{name}` changed a parameter type")
    }
    if !opt_types_eq(old.return_type, new.return_type) -> return Val("function `{name}` changed its return type")
    None
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:549
fn type_params_eq(old: [TypeParam], new: [TypeParam]) -> Bool {
    old.len() == new.len() && old.iter().zip(new).all(fn(left, right) { left.name == right.name && left.bounds == right.bounds })
}
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:558
fn types_eq(a: Type, b: Type) -> Bool { a == b }
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:562
fn opt_types_eq(a: Type?, b: Type?) -> Bool { a == b }
// Rust: crates/jet-sema/src/Sema/HotSwap.rs:566
fn payload_eq(a: VariantPayload, b: VariantPayload) -> Bool {
    if (a, b) == {
        (.Unit, .Unit) -> true
        (.Single(ta, _), .Single(tb, _)) -> types_eq(ta, tb)
        (.Named(fa), .Named(fb)) -> fa.len() == fb.len() && fa.iter().zip(fb).all(fn(x, y) { x.name == y.name && types_eq(x.ty, y.ty) })
        _ -> false
    }
}
