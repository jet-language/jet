// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:529
pub fn block_definitely_returns(stmts: [Stmt]) -> Bool Never! {
    loop stmt in stmts { if stmt_definitely_returns(stmt) -> return true }
    false
}
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:538
pub fn block_definitely_exits(stmts: [Stmt]) -> Bool Never! {
    loop stmt in stmts { if stmt_definitely_exits(stmt) -> return true }
    false
}
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:542
fn stmt_definitely_exits(stmt: Stmt) -> Bool Never! {
    if stmt == {
        .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) -> true
        .Expr(expr) -> if expr_without_parens(expr) == { .Todo(_, _) | .NoElse(_) -> true; .Call(call) -> call.name == Syntax.BUILTIN_PANIC; else -> false }
        .Switch(subject, arms, else_body, span) -> {
            if arms.is_empty() -> return false
            loop arm in arms { if !block_definitely_exits(arm.body) -> return false }
            if else_body == { .Val(body) -> block_definitely_exits(body); .None -> !is_subjectless_guard(subject, span) }
        }
        .Loop(body, _, _, _) -> !loop_body_can_break(body)
        .While(cond, body, _, _, _) | .CountedLoop(_, cond, _, body, _, _, _) -> if expr_without_parens(cond) == .Bool(true, _) { !loop_body_can_break(body) } else { false }
        else -> false
    }
}
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:584
fn loop_body_can_break(stmts: [Stmt]) -> Bool Never! { loop_body_can_break_inner(stmts, [], true) }
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:588
fn loop_body_can_break_inner(stmts: [Stmt], nested_labels: [String], allow_unlabelled: Bool) -> Bool Never! {
    loop stmt in stmts {
        can_break :: if stmt == {
            .Break(_) | .BreakValue(_, _) -> allow_unlabelled
            .BreakLabel(name, _) | .BreakLabelValue(name, _, _, _) -> !nested_labels.contains(name)
            .Switch(_, arms, else_body, _) -> {
                found := false
                loop arm in arms { if loop_body_can_break_inner(arm.body, nested_labels, allow_unlabelled) { found = true; break } }
                if found { true } else { if else_body == { .Val(body) -> loop_body_can_break_inner(body, nested_labels, allow_unlabelled); .None -> false } }
            }
            .Loop(body, _, _, label) | .While(_, body, _, _, label) | .For(_, _, _, _, body, _, _, label, _) | .CountedLoop(_, _, _, body, _, _, label) -> {
                nested := ~nested_labels
                if label == .Val(named) -> &nested.push(named.name)
                loop_body_can_break_inner(body, nested, false)
            }
            else -> false
        }
        if can_break -> return true
        if stmt_definitely_exits(stmt) -> return false
    }
    false
}
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:630
pub fn stmt_definitely_returns(stmt: Stmt) -> Bool Never! {
    if stmt == {
        .Return(_, _) -> true
        .Expr(expr) -> if expr_without_parens(expr) == { .Todo(_, _) -> true; .Call(call) -> call.name == Syntax.BUILTIN_PANIC; else -> false }
        .Loop(body, _, _, _) -> !loop_body_can_break(body)
        .While(cond, body, _, _, _) | .CountedLoop(_, cond, _, body, _, _, _) -> if expr_without_parens(cond) == .Bool(true, _) { !loop_body_can_break(body) } else { false }
        .Switch(subject, arms, else_body, span) -> {
            if arms.is_empty() -> return false
            loop arm in arms { if !block_definitely_returns(arm.body) -> return false }
            if else_body == { .Val(body) -> block_definitely_returns(body); .None -> !is_subjectless_guard(subject, span) }
        }
        else -> false
    }
}
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:667
pub fn is_cloneable(ty: Type, registry: @TypeRegistry) -> Bool Never! {
    walk := NominalWalk.new(.Cloneable, registry)
    cloneable :: is_cloneable_rec(ty, registry, &walk)
    ^walk.finish(cloneable)
    cloneable
}
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:677
pub fn owned_type_for_read_view(ty: Type) -> Type? Never! {
    if ty == .Apply(name, args) {
        if name != "View" || args.len() != 1 -> return None
        if args[0] == .Named("str") -> return Val(.String)
        return Val(.List(args[0]))
    }
    None
}
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:698
fn is_cloneable_rec(ty: Type, registry: @TypeRegistry, walk: &NominalWalk) -> Bool Never! {
    if ty == {
        .Int | .Bool | .Float | .String | .Char | .IntN(_, _) | .Float32 | .Shared(_) -> true
        .List(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> is_cloneable_rec(inner, registry, &walk)
        .Map(key, _, value) | .Result(key, value) -> is_cloneable_rec(key, registry, &walk) && is_cloneable_rec(value, registry, &walk)
        .Fn(_, _, _, _, _, _) | .TraitObject(_) -> false
        .Named(name) -> {
            if builtin_resource_type(name) -> return false
            if is_type_var_name(name) || core_type_known(name) -> return true
            key :: &walk.enter(name, []) ?? return true
            result := false
            if registry.contains(name) && registry.types.get(name) == .Val(definition) {
                result = if definition == {
                    .Struct(fields, _, _, _, _, _, _, _) -> {
                        all := true
                        loop field in fields { if !is_cloneable_rec(field.2, registry, &walk) { all = false; break } }
                        all
                    }
                    .Enum(variants, _, _, _, _, _, _, _) -> {
                        all := true
                        loop (_, variant) in variants { loop field in pattern_binding_types(variant.1) { if !is_cloneable_rec(field, registry, &walk) { all = false; break } }; if !all -> break }
                        all
                    }
                    .Distinct(_, _, _, _) -> true
                    .Alias(_, target, _) -> is_cloneable_rec(target, registry, &walk)
                }
            }
            &walk.leave(name, ^key)
            result
        }
        .Apply(name, args) -> {
            if ["DataArrowBatch", "MutationPlan", "VaultWrite", "ExpiringSecret", "ViewMut", Syntax.TYPE_VIEW_ITER, "CellReadGuard", "CellEditGuard", "Task", Syntax.TYPE_SHARED_GUARD].contains(name) -> return false
            if name == "View" || name == "KeyRef" || name == "Rotation" -> return true
            loop arg in args { if !is_cloneable_rec(arg, registry, &walk) -> return false }
            true
        }
        .Tuple(fields) -> { loop field in fields { if !is_cloneable_rec(field.ty, registry, &walk) -> return false }; true }
        .Union(members) -> { loop member in members { if !is_cloneable_rec(member, registry, &walk) -> return false }; true }
        .Measure(_) -> true
    }
}
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:778
fn builtin_resource_type(name: String) -> Bool Never! { ["FileReader", "FileWriter", "FileScope", "FileLock", "TcpStream", "UnixStream", "TLSStream", "DBConnection", "Arena", "Bump", "Pool", "Fixed"].contains(name) }
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:803
pub fn type_owns_heap(ty: Type, registry: @TypeRegistry) -> Bool Never! {
    walk := NominalWalk.new(.OwnsHeap, registry)
    owns :: type_owns_heap_rec(ty, registry, &walk)
    ^walk.finish(!owns)
    owns
}
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:815
fn type_owns_heap_rec(ty: Type, registry: @TypeRegistry, walk: &NominalWalk) -> Bool Never! {
    if ty == {
        .Int | .Bool | .Float | .Char | .IntN(_, _) | .Float32 | .Fn(_, _, _, _, _, _) | .Measure(_) -> false
        .String | .List(_) | .Shared(_) | .Map(_, _, _) | .TraitObject(_) | .FixedList(_, _) -> true
        .Option(inner) | .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> type_owns_heap_rec(inner, registry, &walk)
        .Result(ok, err) -> type_owns_heap_rec(ok, registry, &walk) || type_owns_heap_rec(err, registry, &walk)
        .Named(name) -> {
            if is_type_var_name(name) || core_type_known(name) -> return false
            key :: &walk.enter(name, []) ?? return false
            result := false
            if registry.types.get(name) == .Val(definition) {
                result = if definition == {
                    .Struct(fields, _, _, _, _, _, _, _) -> { found := false; loop field in fields { if type_owns_heap_rec(field.2, registry, &walk) { found = true; break } }; found }
                    .Enum(variants, _, _, _, _, _, _, _) -> { found := false; loop (_, variant) in variants { loop field in pattern_binding_types(variant.1) { if type_owns_heap_rec(field, registry, &walk) { found = true; break } }; if found -> break }; found }
                    .Distinct(base, _, _, _) -> type_owns_heap_rec(base, registry, &walk)
                    .Alias(_, target, _) -> type_owns_heap_rec(target, registry, &walk)
                }
            }
            &walk.leave(name, ^key)
            result
        }
        .Apply(name, args) -> {
            if name == "Pool" || name == "KeyRef" -> return true
            if name == "ID" -> return false
            loop arg in args { if type_owns_heap_rec(arg, registry, &walk) -> return true }
            if registry.types.get(name) == .Val(.Struct(fields, _, _, _, _, _, _, _)) { loop field in fields { if type_owns_heap_rec(field.2, registry, &walk) -> return true } }
            false
        }
        .Tuple(fields) -> { loop field in fields { if type_owns_heap_rec(field.ty, registry, &walk) -> return true }; false }
        .Union(members) -> { loop member in members { if type_owns_heap_rec(member, registry, &walk) -> return true }; false }
    }
}
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:894
pub fn expr_is_same_ident(a: Expr, name: String) -> Bool Never! { if a == .Ident(n, _) -> return n == name; false }
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:898
pub fn pattern_variant_name(pattern: Pattern) -> String? Never! {
    if pattern.has_nested_pattern() && !(pattern == .Or(_, _)) -> return None
    if pattern == {
