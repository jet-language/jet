        .Fn(params, ret, _, _, _, _) -> { loop param in params { if contains_expiring_secret_loan(param) -> return true }; if ret == { .Val(value) -> contains_expiring_secret_loan(value); .None -> false } }
        .Tuple(fields) -> { loop field in fields { if contains_expiring_secret_loan(field.ty) -> return true }; false }
        .Apply(_, args) -> { loop arg in args { if contains_expiring_secret_loan(arg) -> return true }; false }
