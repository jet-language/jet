// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:202
pub fn type_fix_hint(want: Type, got: Type) -> String Never! {
    if type_name(want) == type_name(got) -> return "these are two different declarations that both print as {type_name(want)}; make both sides name the same one (import it once and use that name)"
    if !nominal_leaf(want).is_empty() && nominal_leaf(want) == nominal_leaf(got) -> return "these names may refer to one declaration; make both sides use one spelling for `{nominal_leaf(want)}`"
    if (want, got) == {
        (.Float, .Int) -> "write the number with a decimal part, like `2.0`"
        (.Float, _) -> if nominal_leaf(got) == Syntax.TYPE_DECIMAL { "write the literal as Float{{3.4}}, or keep Decimal on both sides" } else { "use {type_name(want)} here" }
        (.Int, .Float) -> "drop the decimal part, like `2`"
        (.Int, .IntN(signed, bits)) -> { prefix :: if signed { "i" } else { "u" }; "widen it explicitly with `Int.from_{prefix}{bits}(value)`" }
        (.String, _) -> "put the value in text with interpolation: \"{{x}}\""
        (.Named(name), _) -> if name.ends_with(".RNG") { "use {Syntax.RNG_TYPE} here" } else { "use {type_name(want)} here" }
        else -> "use {type_name(want)} here"
    }
}
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:221
fn nominal_leaf(ty: Type) -> String Never! {
    if ty == .Named(name) {
        if name.rsplit_once("::") == .Val(pair) -> return pair.1
        if name.rsplit_once(".") == .Val(pair) -> return pair.1
        return name
    }
    ""
}
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:283
pub fn typed_text_mismatch(want: Type, got: Type, span: Span) -> Diagnostic? Never! {
    if want == .Named(tn) {
        if tn == Syntax.TYPE_REGEX && got == .String -> return Val(Diagnostic.error("E0152", "a `String` is not a `Regex` pattern", "regex patterns are typed literals, so Jet can validate them before the program runs", "write `.{{\"...\"}}` here, or call `re.compile(text)` for a pattern built at run time", Val(span)))
        kind :: Syntax.typed_head_kind(tn) ?? return None
        if !kind.is_typed_text() || got != .String -> return None
        why :: if tn == Syntax.TYPE_SH { "a runtime string could change the executable or argument boundaries; only a checked literal may build `Sh`, where every `{{value}}` hole is exactly one argv item" } else { "interpolating untrusted text into a query or page is how injection happens; only a checked literal (its `{{value}}` holes become bound parameters or escaped insertions) may build one" }
        return Val(Diagnostic.error("E0149", "a runtime `String` can't be used as `{tn}`", why, "write `{tn}{{\"...\"}}` with `{{value}}` holes, or use `{tn}.raw(\"…\")` if you have audited the text", Val(span)))
    }
    None
}
