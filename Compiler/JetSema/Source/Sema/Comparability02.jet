fn secret_bearing_crypto_leaf(name: String) -> Bool Never! { name == "Secret" || name == "SigningKey" || name == "X25519SecretKey" || name == "SharedSecret" }
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:1299
pub fn core_crypto_nominal(ty: ^Type) -> Type Never! {
    if ty == {
        .Named(name) -> if crypto_leaf(name) == { .Val(leaf) -> .Tagged(.Internal(.CoreCryptoNominal), .Named(leaf)); .None -> .Named(name) }
        .List(inner) -> .List(core_crypto_nominal(^inner))
        .Shared(inner) -> .Shared(core_crypto_nominal(^inner))
        .Map(key, key_span, value) -> .Map(core_crypto_nominal(^key), key_span, core_crypto_nominal(^value))
        .Option(inner) -> .Option(core_crypto_nominal(^inner))
        .Result(ok, err) -> .Result(core_crypto_nominal(^ok), core_crypto_nominal(^err))
        .Tuple(fields) -> { mapped := [TypeTupleField]{}; loop field in ^fields -> &mapped.push(TypeTupleField{name: ^field.name, ty: core_crypto_nominal(^field.ty)}); .Tuple(^mapped) }
        .FixedList(elem, len) -> .FixedList(core_crypto_nominal(^elem), ^len)
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            mapped := [Type]{}
            loop param in ^params -> &mapped.push(core_crypto_nominal(^param))
            mapped_ret :: if ret == { .Val(value) -> Val(core_crypto_nominal(^value)); .None -> None }
            .Fn(^mapped, ^mapped_ret, ^effect_bound, ^param_contract, ^call_metadata, ^return_view_provenance)
        }
        .Apply(name, args) -> { mapped := [Type]{}; loop arg in ^args -> &mapped.push(core_crypto_nominal(^arg)); .Apply(^name, ^mapped) }
        .Tagged(.Internal(.CoreCryptoNominal), inner) -> .Tagged(.Internal(.CoreCryptoNominal), ^inner)
        .Tagged(marker, inner) -> .Tagged(^marker, core_crypto_nominal(^inner))
        .Union(members) -> { mapped := [Type]{}; loop member in ^members -> &mapped.push(core_crypto_nominal(^member)); canonicalize_union(^mapped) }
        .InlineRange(base, lo, hi) -> .InlineRange(core_crypto_nominal(^base), lo, hi)
        .Quantity(base, dimension) -> .Quantity(core_crypto_nominal(^base), ^dimension)
        else -> ^ty
    }
}
