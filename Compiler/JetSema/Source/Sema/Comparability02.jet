//RS /// D-MEM1: true when `ty` owns heap data — directly
//RS /// (`String`/`[T]`/`[K,V]`/`Shared<T>`/a boxed trait object/a `[T#N]`, which
//RS /// erases to `Vec<T>` at codegen) or transitively (a struct/enum/tuple/distinct/
//RS /// alias with a heap-owning part). Backs heap-ownership and `copy` checks —
//RS /// deliberately narrower than
//RS /// `is_cloneable`, which asks a different question ("can Rust `.clone()` this",
//RS /// true for nearly everything including heap types).
//RS pub(crate) fn type_owns_heap(ty: &Type, registry: &TypeRegistry) -> bool {
//RS     let mut walk = NominalWalk::new(NominalQuery::OwnsHeap, registry);
//RS     let owns = type_owns_heap_rec(ty, registry, &mut walk);
//RS     walk.finish(!owns);
//RS     owns
//RS }
//RS 
//RS /// `type_owns_heap`'s recursion, with the same self-referential-type cycle
//RS /// guard as `is_cloneable_rec` (a cycle is already behind a `Box` indirection
//RS /// by construction, so it's vacuously non-heap-owning here — the walk doesn't
//RS /// need to unwind further to answer "does this type ITSELF own heap data").
//RS /// A type this query already finished owned none (the first owner ends it).
//RS fn type_owns_heap_rec(ty: &Type, registry: &TypeRegistry, walk: &mut NominalWalk<'_>) -> bool {
//RS     match ty {
//RS         Type::Int | Type::Bool | Type::Float | Type::Char => false,
//RS         Type::IntN { .. } | Type::Float32 => false,
//RS         Type::String | Type::List(_) | Type::Shared(_) => true,
//RS         Type::Map { .. } => true,
//RS         Type::Option(inner) => type_owns_heap_rec(inner, registry, walk),
//RS         Type::Result { ok, err } => {
//RS             type_owns_heap_rec(ok, registry, walk) || type_owns_heap_rec(err, registry, walk)
//RS         }
//RS         // A plain function value/pointer carries no heap-owned data at the
//RS         // type level (a closure's captured environment isn't tracked here).
//RS         Type::Fn { .. } => false,
//RS         // A boxed dyn trait object is a heap allocation (Rust `Box<dyn …>`).
//RS         Type::TraitObject(_) => true,
//RS         Type::Named(name) if is_type_var_name(name) => false,
//RS         Type::Named(name) if core_type_known(name) => false,
//RS         Type::Named(name) => {
//RS             let Some(key) = walk.enter(name, &[]) else {
//RS                 return false;
//RS             };
//RS             let result = match registry.types.get(name) {
//RS                 Some(TypeDef::Struct { fields, .. }) => fields
//RS                     .iter()
//RS                     .any(|(_, _, fty)| type_owns_heap_rec(fty, registry, walk)),
//RS                 Some(TypeDef::Enum { variants, .. }) => variants.values().any(|(_, p)| match p {
//RS                     VariantPayload::Unit => false,
//RS                     VariantPayload::Single(t, _) => type_owns_heap_rec(t, registry, walk),
//RS                     VariantPayload::Named(fs) => fs
//RS                         .iter()
//RS                         .any(|f| type_owns_heap_rec(&f.ty, registry, walk)),
//RS                 }),
//RS                 // D-DIST1: a distinct type wraps a base type — heap-owning iff
//RS                 // the base is (e.g. `UserId :: distinct String`).
//RS                 Some(TypeDef::Distinct { base, .. }) => type_owns_heap_rec(base, registry, walk),
//RS                 Some(TypeDef::Alias { target, .. }) => type_owns_heap_rec(target, registry, walk),
//RS                 None => false,
//RS             };
//RS             walk.leave(name, key);
//RS             result
//RS         }
//RS         // D-POOLID-API1=A: `Pool<T>` is a generational arena (heap-owning
//RS         // regardless of `T`); `Id<T>` is plain index+generation data (`Copy`,
//RS         // never heap-owning). Any other generic application: best-effort —
//RS         // recurse into its type args (approximates a generic field storing
//RS         // one), OR'd with a direct field-registry lookup by name (no generic
//RS         // substitution — a known gap for a user generic struct whose fields
//RS         // are typed by a type PARAMETER rather than a concrete arg; see the
//RS         // generic-type report). Errs toward flagging (a false positive is
//RS         // cheaper than a silent miss of an actual allocation).
//RS         Type::Apply { name, args } if name == "Pool" => {
//RS             let _ = args;
//RS             true
//RS         }
//RS         Type::Apply { name, .. } if name == "ID" => false,
//RS         Type::Apply { name, .. } if name == "KeyRef" => true,
//RS         Type::Apply { name, args } => {
//RS             args.iter().any(|a| type_owns_heap_rec(a, registry, walk))
//RS                 || matches!(
//RS                     registry.types.get(name),
//RS                     Some(TypeDef::Struct { fields, .. }) if fields.iter().any(|(_, _, fty)| type_owns_heap_rec(fty, registry, walk))
//RS                 )
//RS         }
//RS         Type::Tuple(fields) => fields
//RS             .iter()
//RS             .any(|(_, t)| type_owns_heap_rec(t, registry, walk)),
//RS         // D-SG9/S76: `[T#N]` erases to `Vec<T>` at codegen (I3) — always a
//RS         // heap allocation regardless of the element type.
//RS         Type::FixedList { .. } => true,
//RS         Type::Tagged { inner, .. } => type_owns_heap_rec(inner, registry, walk),
//RS         Type::InlineRange { base, .. } => type_owns_heap_rec(base, registry, walk),
//RS         Type::Union(members) => members
//RS             .iter()
//RS             .any(|m| type_owns_heap_rec(m, registry, walk)),
//RS         Type::Quantity { base, .. } => type_owns_heap_rec(base, registry, walk),
//RS         Type::Measure(_) => false,
//RS     }
//RS }
