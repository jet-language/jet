pub fn suggest_field(name: String, candidates: [String]) -> String? Never! {
    best: String? = None
    best_distance := 3
    ambiguous := false
    loop cand in candidates {
        d :: edit_distance(name, cand)
        if d == 0 || d > 2 -> next
        if d < best_distance { best = Val(cand); best_distance = d; ambiguous = false }
        else if d == best_distance && best != Val(cand) -> ambiguous = true
    }
    if ambiguous { None } else { best }
}
