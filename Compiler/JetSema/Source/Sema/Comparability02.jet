//RS         Pattern::Present { .. } => Some(Syntax::LIT_VALUE.to_string()),
//RS         Pattern::Absent(_) => Some(Syntax::LIT_NULL.to_string()),
//RS         Pattern::Ok { .. } => Some(Syntax::LIT_OK.to_string()),
//RS         Pattern::Err { .. } => Some(Syntax::LIT_ERR.to_string()),
//RS         // D-PATO: use the first alternative's name as the canonical key.
//RS         // Coverage walks every alternative through `collect_covered_variant_names`.
//RS         Pattern::Or(alts, _) => alts.first().and_then(pattern_variant_name),
//RS         // D-PATR/D-DESTRUCT1/D-PARSESTR1: range, struct, and str-match patterns
//RS         // don't cover a single variant name.
//RS         Pattern::Range { .. }
//RS         | Pattern::Struct { .. }
//RS         | Pattern::StrMatch { .. }
//RS         | Pattern::BinMatch { .. } => None,
//RS     }
//RS }
