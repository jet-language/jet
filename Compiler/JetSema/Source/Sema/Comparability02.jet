// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:92
pub fn validate_typed_boundary_before_lowering(e: Expr) -> Diagnostic? Never! {
    if e == .TypedLit(.Val(.Named(type_name)), .Value(.Str(parts, literal_span)), _) {
        has_holes := false
        literals := [String]{""}
        loop part in parts {
            if part == {
                .Lit(text) -> &literals[literals.len() - 1].push_str(text)
                .Interp(_, _) -> { has_holes = true; &literals.push("") }
            }
        }
        kind :: Syntax.typed_head_kind(type_name) ?? return None
        if !kind.is_boundary() -> return None
        if kind.forbids_holes() && has_holes {
            return Val(Diagnostic.error("E0155", "a `DateTime` literal cannot contain interpolation", "DateTime values are checked as complete RFC3339 literals before the program runs", "write a complete `DateTime{{\"…\"}}` literal, or parse a runtime String explicitly", Val(literal_span)))
        }
        if validate_typed_boundary_literal(kind, literals) == .Err(reason) {
            return Val(Diagnostic.error("E0155", "this `{kind.source_name()}` literal is invalid", reason, "fix the literal, or parse a runtime String with the ordinary `{kind.source_name()}` constructor", Val(literal_span)))
        }
    }
    None
}
