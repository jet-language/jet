pub struct MethodSuggestion { pub name: String, pub fix: String }
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:1201
fn alias_target(name: String, receiver_family: String?, candidates: [String]) -> String? Never! {
    loop (foreign, family, target) in FOREIGN_METHOD_ALIASES {
        if foreign == name && (receiver_family == None || receiver_family == Val(family)) && target != name && candidates.contains(target) -> return Val(target)
    }
    None
}
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:1219
fn snake_case_of_camel(name: String) -> String? Never! {
    capitals := false
    loop c in name.chars() { if c.is_ascii_uppercase() { capitals = true; break } }
    if !capitals -> return None
    snake := String.with_capacity(name.len() + 4)
    index := 0
    loop c in name.chars() {
        if c.is_ascii_uppercase() { if index > 0 -> &snake.push('_'); &snake.push(c.to_ascii_lowercase()) } else { &snake.push(c) }
        index += 1
    }
    Val(snake)
}
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:1237
fn foreign_method_fix(name: String, jet: String) -> String Never! { "did you mean `{jet}`? `{name}` is another language's name for the same operation" }
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:1247
pub fn suggest_method_for_receiver(name: String, receiver_family: String?, candidates: [String]) -> MethodSuggestion? Never! {
    if snake_case_of_camel(name) == .Val(snake) {
        if candidates.contains(snake) -> return Val(MethodSuggestion{name: snake, fix: "did you mean `{snake}`? Jet method names are snake_case"})
    }
    if snake_case_of_camel(name) == .Val(snake) {
        if alias_target(snake, receiver_family, candidates) == .Val(jet) -> return Val(MethodSuggestion{name: jet, fix: foreign_method_fix(name, jet)})
    }
    if alias_target(name, receiver_family, candidates) == .Val(jet) -> return Val(MethodSuggestion{name: jet, fix: foreign_method_fix(name, jet)})
    if suggest_field(name, candidates) == .Val(candidate) -> return Val(MethodSuggestion{name: candidate, fix: "did you mean `{candidate}`?"})
    None
}
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:1283
pub fn suggest_method(name: String, candidates: [String]) -> MethodSuggestion? Never! { suggest_method_for_receiver(name, None, candidates) }
