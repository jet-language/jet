    ("contains", "List", "contains"), ("contains", "Set", "has"), ("includes", "List", "contains"),
    ("set", "Map", "add"), ("put", "Map", "add"), ("insert", "Map", "add"),
    ("upper", "String", "to_upper"), ("lower", "String", "to_lower"), ("strip", "String", "trim"),
