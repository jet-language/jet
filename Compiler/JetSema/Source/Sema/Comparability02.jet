//RS /// The one "did you mean …?" candidate picker. Every caller has already
//RS /// reported that `name` does not exist, so a candidate EQUAL to `name` is
//RS /// never a fix — it tells the reader to write what was just refused, and it
//RS /// contradicts the message that named it missing. Distance 0 is therefore not
//RS /// a suggestion but evidence that the candidate set and the failed lookup
//RS /// disagree; a tied nearest pair is ambiguous for a machine edit. The caller
//RS /// keeps its ordinary fix text in either case (card #2002).
//RS pub(crate) fn suggest_field(name: &str, candidates: &[String]) -> Option<String> {
//RS     let mut best: Option<(String, usize)> = None;
//RS     let mut ambiguous = false;
//RS     for cand in candidates {
//RS         let d = edit_distance(name, cand);
//RS         if d == 0 || d > 2 {
//RS             continue;
//RS         }
//RS         match best.as_ref() {
//RS             None => best = Some((cand.clone(), d)),
//RS             Some((_best_name, best_distance)) if d < *best_distance => {
//RS                 best = Some((cand.clone(), d));
//RS                 ambiguous = false;
//RS             }
//RS             Some((best_name, best_distance)) if d == *best_distance => {
//RS                 ambiguous |= best_name != cand;
//RS             }
//RS             _ => {}
//RS         }
//RS     }
//RS     best.filter(|_| !ambiguous).map(|(s, _)| s)
//RS }
//RS 
//RS /// The one home for cross-language method names (card #1965).
//RS ///
//RS /// A row earns its place only when all three of these hold. A reader deciding
//RS /// whether to add one answers them in order:
//RS ///
//RS /// 1. the left spelling is the *primary* name of this operation in at least two
//RS ///    mainstream languages (Python, JavaScript, Java/C#, C++, Rust, Go), so it
//RS ///    is what a newcomer or a coding agent types from habit — not a name one
//RS ///    library happens to use;
//RS /// 2. one of the right spellings is the real Jet name for the *same* operation
//RS ///    on some Core receiver — the same operation, not a near neighbour;
//RS /// 3. the left spelling is not itself a Jet method on that receiver, so the row
//RS ///    can only ever fire after real method lookup has already failed.
//RS ///
//RS /// A name failing (1) is one project's private dictionary. A name failing (2)
//RS /// teaches a method that does something else. A name failing (3) is dead
//RS /// weight: the call resolves and this table is never consulted.
//RS ///
//RS /// The receiver family is the same label used by E0311's `Why:` text. Keep
//RS /// target membership as a second check: a family row must name a method the
//RS /// receiver actually carries.
//RS const FOREIGN_METHOD_ALIASES: &[(&str, &str, &str)] = &[
//RS     // Sequence append: Python `list.append`, Java/C# `add`/`Add`, C++ `push_back`.
//RS     ("append", "List", "push"),
//RS     ("add", "List", "push"),
//RS     ("push_back", "List", "push"),
//RS     ("extend", "List", "push"),
//RS     // Size: C++/Java `size`, JavaScript/Java-String `length`, C#/Swift `Count`/`count`.
//RS     ("size", "List", "len"),
//RS     ("size", "Map", "len"),
//RS     ("size", "String", "len"),
//RS     ("length", "List", "len"),
//RS     ("length", "Map", "len"),
//RS     ("length", "String", "len"),
//RS     ("count", "List", "len"),
//RS     ("count", "Map", "len"),
//RS     ("count", "String", "len"),
//RS     // Membership: Rust `contains_key`, JavaScript `Map.has`, Rust/Java/C++ set
//RS     // `contains`, JavaScript `Array.includes`.
//RS     ("contains_key", "Map", "has_key"),
//RS     ("contains_key", "Set", "has"),
//RS     ("has", "Map", "has_key"),
//RS     ("contains", "List", "contains"),
//RS     ("contains", "Set", "has"),
//RS     ("includes", "List", "contains"),
//RS     // Keyed store: JavaScript `Map.set`, Java `Map.put`, Rust `HashMap::insert`.
//RS     ("set", "Map", "add"),
//RS     ("put", "Map", "add"),
//RS     ("insert", "Map", "add"),
//RS     // Text: Python `str.upper`/`lower`/`strip`, Java/JavaScript
//RS     // `substring`/`substr`, Rust `to_str`.
//RS     ("upper", "String", "to_upper"),
//RS     ("lower", "String", "to_lower"),
//RS     ("strip", "String", "trim"),
//RS     ("substring", "String", "slice"),
//RS     ("substr", "String", "slice"),
//RS     ("to_str", "String", "to_string"),
//RS ];
//RS 
//RS /// A method name the receiver really carries, plus the `Fix:` line that names
//RS /// it. One picker returns both so E0311 and E0102 cannot drift apart.
//RS pub(crate) struct MethodSuggestion {
//RS     /// The Jet spelling to write instead — also the rename `TextEdit`.
//RS     pub(crate) name: String,
//RS     /// The rendered `Fix:` sentence.
//RS     pub(crate) fix: String,
//RS }
