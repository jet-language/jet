//RS /// Core types that carry a Prelude display but are not user items, so they
//RS /// never reach the auto-derive sets. Every "can this be shown" predicate must
//RS /// agree on this list. Splitting it is what let interpolation accept a value
//RS /// that print rejected.
//RS pub(crate) fn is_core_shown_type(name: &str) -> bool {
//RS     matches!(
//RS         name,
//RS         "Decimal"
//RS             | "Fraction"
//RS             | "MIME"
//RS             | "ServiceUpgradeReceipt"
//RS             | "ServiceWorkflow"
//RS             | "TaskOutcome"
//RS             | "TaskStatus"
//RS             | "Complex"
//RS             | "URL"
//RS             | "Path"
//RS             | "Date"
//RS             | "Duration"
//RS             | "LocalDate"
//RS             | "LocalTime"
//RS             | "DateTime"
//RS             | "Instant"
//RS             | "Period"
//RS             | "Zone"
//RS             | "ZonedDateTime"
//RS             | "DataTracked"
//RS             | "DataWatch"
//RS             | "DataWatchStatus"
//RS             | "DBValue"
//RS             | "DBLease"
//RS             | "DBPoolReceipt"
//RS     ) || is_core_error_family_type(name)
//RS         // S80 / D-FAIL-ERROR1=A: the Prelude-owned default error shows its
//RS         // `message` through the Prelude display every tier already carries.
//RS         || name == Syntax::TYPE_ERR
//RS }
//RS 
//RS /// D-FAIL-CONV2=A: the standard library's own error family. Membership is
//RS /// derived, not chosen: a Core error type is a member when the Prelude registers
//RS /// it printable (`TraitRegistry::register_synthetic_display_debug`), a Core
//RS /// signature returns it in the error position of a `T !E` result, and showing it
//RS /// is not prohibited. `Prelude/Errors.jet` declares one `impl <member> => Err`
//RS /// for exactly this list, and the Prelude owns each member's failure text, so the
//RS /// family renders through the same display hook every other shown Core type uses.
//RS ///
//RS /// D-CRYPTO-ERRFAM1=A: `CryptoError` and `FileCryptoError` are members; both are
//RS /// payload-free enums, and the secret-bearing crypto types keep E0915.
//RS ///
//RS /// Outside the family on purpose: `TaskFailure` (D-FAIL-CARRIER1 owns
//RS /// cancellation and deadline reporting), `[FieldError]` (a list, not one named
//RS /// type), and component types no Core call fails with (`DataErrorKind`,
//RS /// `EncodingCause`, `IOContext`, `NetErrorDetail`, `NetDnsError`).
//RS ///
//RS /// A source-owned Core error arrives under its canonical owner identity
//RS /// (`<corelib>/Core/crypto::Core/crypto/uuid.jet::UUIDError`); membership is
//RS /// decided by its leaf.
//RS pub fn is_core_error_family_type(name: &str) -> bool {
//RS     matches!(
//RS         core_error_family_leaf(name),
//RS         "AppError"
//RS             | "ArchiveError"
//RS             | "BuildError"
//RS             | "BrowserError"
//RS             | "CBORError"
//RS             | "ComputeError"
//RS             | "CryptoError"
//RS             | "DBError"
//RS             | "DataError"
//RS             | "EncodingError"
//RS             | "EmailError"
//RS             | "EnvError"
//RS             | "FileCryptoError"
//RS             | "HTTPError"
//RS             | "IOError"
//RS             | "MIMEError"
//RS             | "ModError"
//RS             | "NetError"
//RS             | "PerfError"
//RS             | "RangeError"
//RS             | "TextError"
//RS             | "TimeError"
//RS             | "URLError"
//RS             | "UTF8Error"
//RS             | "UUIDError"
//RS             | "WsError"
//RS             | "XMLError"
//RS     )
//RS }
//RS 
//RS /// The family leaf of a Core error name: canonical `<corelib>/…::Leaf`
//RS /// identities reduce to `Leaf`; every other name is its own leaf.
//RS pub(crate) fn core_error_family_leaf(name: &str) -> &str {
//RS     name.strip_prefix("<corelib>/")
//RS         .and_then(|identity| identity.rsplit("::").next())
//RS         .unwrap_or(name)
//RS }
//RS 
//RS /// D-FAILURE-FOUNDATION1=A: every Core type that may be named as the error
//RS /// side of an explicit `!` contract. This is intentionally broader than the
//RS /// default-error conversion family above: types such as `TaskFailure` and
//RS /// `AllocError` keep their own typed failure meaning even when they do not
//RS /// convert implicitly to `Err`.
//RS pub(crate) fn is_core_error_type(name: &str) -> bool {
//RS     matches!(
//RS         name,
//RS         "AllocError"
//RS             | "AuthError"
//RS             | "BuildError"
//RS             | "BrowserError"
//RS             | "CBORError"
//RS             | "Closed"
//RS             | "CompilerError"
//RS             | "CompilerPackageError"
//RS             | "ComputeError"
//RS             | "CryptoError"
//RS             | "DBError"
//RS             | "DataError"
