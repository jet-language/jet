pub fn contains_expiring_secret_loan(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(.Internal(.ExpiringSecretLoan), _) -> true
        .Tagged(_, inner) | .Option(inner) | .List(inner) | .Shared(inner) | .FixedList(inner, _) -> contains_expiring_secret_loan(inner)
