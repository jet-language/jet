// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:1711
pub fn is_printable(ty: Type, registry: TypeRegistry, trait_reg: TraitRegistry) -> Bool Never! {
    if is_secret_bearing_crypto_type(ty) || is_one_pass_source(ty) -> return false
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 | .Quantity(_, _) -> true
        .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) -> is_printable(inner, registry, trait_reg)
        .Result(ok, err) | .Map(ok, _, err) -> is_printable(ok, registry, trait_reg) && is_printable(err, registry, trait_reg)
        .Named(n) -> registry.is_unit_type(n) || registry.distinct_is_printable(n) || trait_reg.implements_trait(n, Generics.PRINTABLE) || is_core_shown_type(n)
        .Apply(name, args) -> {
            if name == "KeyRef" -> return true
            if name == "View" && args.len() == 1 && args[0] == .Named("str") -> return true
            if !trait_reg.implements_trait(name, Generics.PRINTABLE) -> return false
            loop arg in args { if !is_printable(arg, registry, trait_reg) -> return false }
            true
        }
        .Tuple(fields) -> { loop field in fields { if !is_printable(field.ty, registry, trait_reg) -> return false }; true }
        .TraitObject(_) | .Shared(_) | .Fn(_, _, _, _, _, _) -> false
        .Union(members) -> { loop member in members { if !is_printable(member, registry, trait_reg) -> return false }; true }
        .Measure(_) -> false
    }
}
