pub fn missing_arms_text(subj_ty: Type, missing: [String], _subj_name: String?) -> String Never! {
    arms := [String]{}
    loop v in missing {
        arm := "    .{v} {Syntax.OP_UNIFIED_ARROW} {{}}"
        if !(v.contains("(") && !v.ends_with("(...)")) {
            if subj_ty == {
                .Option(_) -> { head :: if v == Syntax.LIT_VALUE { "{Syntax.LIT_VALUE}(inner)" } else { Syntax.LIT_NULL }; arm = "    .{head} {Syntax.OP_UNIFIED_ARROW} {{}}" }
                .Result(_, _) -> {
                    head :: if v.starts_with(Syntax.LIT_OK) { "{Syntax.LIT_OK}(v)" } else if v.starts_with(Syntax.LIT_VALUE) { "{Syntax.LIT_VALUE}(inner)" } else if v == Syntax.LIT_NULL { Syntax.LIT_NULL } else { "{Syntax.LIT_ERR}(e)" }
                    arm = "    .{head} {Syntax.OP_UNIFIED_ARROW} {{}}"
                }
                else -> {}
            }
        }
        &arms.push(arm)
    }
    "\n{arms.join("\n")}"
}
// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:1003
pub fn missing_pattern_coverage(subject_ty: Type, covered: [String:Bool], registry: TypeRegistry) -> [String]? Never! {
    missing := [String]{}
    if subject_ty == {
        .Named(name) -> {
            order :: registry.enum_variant_order(name) ?? return None
            loop leaf in order {
                present := covered.has_key(leaf)
                prefix := ""
                index := 0
                loop seg in leaf.split(".") {
                    if index > 0 {
                        if covered.has_key(prefix) -> present = true
                        &prefix.push_str(".")
                    }
                    &prefix.push_str(seg)
                    index += 1
                }
                if !present -> &missing.push(leaf)
            }
        }
        .Option(_) -> { if !covered.has_key(Syntax.LIT_VALUE) -> &missing.push(Syntax.LIT_VALUE); if !covered.has_key(Syntax.LIT_NULL) -> &missing.push(Syntax.LIT_NULL) }
        .Result(_, _) -> { if !covered.has_key(Syntax.LIT_OK) -> &missing.push("{Syntax.LIT_OK}(...)"); if !covered.has_key(Syntax.LIT_ERR) -> &missing.push("{Syntax.LIT_ERR}(...)") }
        .Union(members) -> { loop member in members { tag :: union_member_tag(member); if !covered.has_key(tag) -> &missing.push(tag) } }
        else -> return None
    }
    if missing.is_empty() { None } else { Val(missing) }
}
