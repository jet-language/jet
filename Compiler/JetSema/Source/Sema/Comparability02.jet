//RS         Some(Type::String)
//RS     } else {
//RS         Some(Type::List(Box::new(args[0].clone())))
//RS     }
//RS }
//RS 
//RS /// `is_cloneable`'s recursion. A self-referential type
//RS /// (`enum Nat { Succ(n: Nat) }`) compiles to a `Box` indirection (I3: sema
//RS /// already proves this elsewhere), so a cycle back to a type still being
//RS /// visited is vacuously cloneable, and a type this query already finished
//RS /// was cloneable (the first field that is not ends the query). The walk
//RS /// (`NominalWalk`) enters each named type once; without the cycle guard it
//RS /// never terminates.
//RS fn is_cloneable_rec(ty: &Type, registry: &TypeRegistry, walk: &mut NominalWalk<'_>) -> bool {
//RS     match ty {
//RS         Type::Int | Type::Bool | Type::Float | Type::String | Type::Char => true,
//RS         Type::IntN { .. } | Type::Float32 => true,
//RS         Type::Shared(_) => true,
//RS         Type::List(inner) | Type::Option(inner) => is_cloneable_rec(inner, registry, walk),
//RS         Type::Map { key, value, .. } => {
//RS             is_cloneable_rec(key, registry, walk) && is_cloneable_rec(value, registry, walk)
//RS         }
//RS         Type::Result { ok, err } => {
//RS             is_cloneable_rec(ok, registry, walk) && is_cloneable_rec(err, registry, walk)
//RS         }
//RS         Type::Fn { .. } => false,
//RS         Type::Named(name) if builtin_resource_type(name) => false,
//RS         Type::Named(name) if is_type_var_name(name) || core_type_known(name) => true,
//RS         Type::Named(name) => {
//RS             let Some(key) = walk.enter(name, &[]) else {
//RS                 return true;
//RS             };
//RS             let result = registry.contains(name)
//RS                 && match registry.types.get(name) {
//RS                     Some(TypeDef::Struct { fields, .. }) => fields
//RS                         .iter()
//RS                         .all(|(_, _, fty)| is_cloneable_rec(fty, registry, walk)),
//RS                     Some(TypeDef::Enum { variants, .. }) => {
//RS                         variants.values().all(|(_, p)| match p {
//RS                             VariantPayload::Unit => true,
//RS                             VariantPayload::Single(t, _) => is_cloneable_rec(t, registry, walk),
//RS                             VariantPayload::Named(fs) => fs
//RS                                 .iter()
//RS                                 .all(|f| is_cloneable_rec(&f.ty, registry, walk)),
//RS                         })
//RS                     }
//RS                     // D-DIST1: distinct types wrap a scalar; they are always cloneable.
//RS                     Some(TypeDef::Distinct { .. }) => true,
//RS                     Some(TypeDef::Alias { target, .. }) => is_cloneable_rec(target, registry, walk),
//RS                     None => false,
//RS                 };
//RS             walk.leave(name, key);
//RS             result
//RS         }
//RS         // A task or imported Arrow batch owns one release duty.  Copying either
//RS         // carrier would hand two bindings the same cleanup authority, so both
//RS         // runtime carriers implement no `Clone` and neither does the language
//RS         // type.
//RS         Type::Apply { name, .. }
//RS             if matches!(
//RS                 name.as_str(),
//RS                 "DataArrowBatch"
//RS                     | "MutationPlan"
//RS                     | "VaultWrite"
//RS                     | "ExpiringSecret"
//RS                     | "ViewMut"
//RS                     | Syntax::TYPE_VIEW_ITER
//RS                     | "CellReadGuard"
//RS                     | "CellEditGuard"
//RS                     | "Task"
//RS                     | Syntax::TYPE_SHARED_GUARD
//RS             ) =>
//RS         {
//RS             false
//RS         }
//RS         Type::Apply { name, .. } if name == "View" => true,
//RS         Type::Apply { name, .. } if matches!(name.as_str(), "KeyRef" | "Rotation") => true,
//RS         Type::Apply { args, .. } => args.iter().all(|a| is_cloneable_rec(a, registry, walk)),
//RS         Type::Tuple(fields) => fields
//RS             .iter()
//RS             .all(|(_, t)| is_cloneable_rec(t, registry, walk)),
//RS         Type::TraitObject(_) => false,
//RS         Type::FixedList { elem, .. } => is_cloneable_rec(elem, registry, walk),
//RS         Type::Tagged { inner, .. } => is_cloneable_rec(inner, registry, walk),
//RS         Type::InlineRange { base, .. } => is_cloneable_rec(base, registry, walk),
//RS         Type::Union(members) => members
//RS             .iter()
//RS             .all(|m| is_cloneable_rec(m, registry, walk)),
//RS         Type::Quantity { base, .. } => is_cloneable_rec(base, registry, walk),
//RS         Type::Measure(_) => true,
//RS     }
//RS }
