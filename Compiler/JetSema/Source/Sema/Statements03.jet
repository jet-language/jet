// Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:11
fn uncovered_guard_path(stmts: [Stmt], source: String) -> String? Never! {
    conds := [Expr]{}
    loop stmt in stmts.iter().rev() {
        if stmt is .Switch{subject, arms, else_body: None, span} {
            if !AST.is_subjectless_guard(subject, span) || arms.is_empty() || !arms.iter().all(fn(arm) { block_definitely_returns(arm.body) }) -> break
            loop arm in arms.iter().rev() -> conds.push(arm.cond)
        } else -> break
    }
    if conds.is_empty() -> return None
    conds.reverse()
    point := None as (String, I64)?
    below := false
    above := false
    single_point := true
    loop cond in conds {
        comparison := None as (BinOp, String, I64)?
        if cond is .Binary(op, left, right, _) {
            if (left, right) == {
                (.Ident(name, _), .Int(value, ..)) -> { comparison = Val((op, name, value)) }
                (.Int(value, ..), .Ident(name, _)) -> {
                    flipped :: if op == { .Lt -> BinOp.Gt .Gt -> BinOp.Lt else -> op }
                    comparison = Val((flipped, name, value))
                }
                else -> {}
            }
        }
        if comparison is (op, name, value) {
            if point.map(fn(known) { known != (name, value) }) == Val(true) {
                single_point = false
                break
            }
            point = Val((name, value))
            if op == {
                .Lt -> { below = true }
                .Gt -> { above = true }
                .Ne -> { below = true; above = true }
                else -> { single_point = false; break }
            }
        } else {
            single_point = false
            break
        }
    }
    if point is (name, value) && single_point && below && above -> return Val("`{name}` is `{value}`")
    texts := [String]{}
    loop cond in conds {
        span :: cond.span()
        text :: source.get(span.start..<span.end) ?? return None
        trimmed := text.trim() // #4303
        texts.push("`{trimmed}`")
    }
    Val(if texts.len() == 1 { "{texts[0]} is false" } else { "none of {texts.join(\", \")} is true" })
}

