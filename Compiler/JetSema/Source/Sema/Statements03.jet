    fn adjacent_dispatch_edit(self, run: [AdjacentDispatchGuard]) -> TextEdit? Never! {
        extents := [SourceIfExtent]{}
        loop guard in run -> extents.push(source_if_extent(self.source, guard.span, guard.condition_span, guard.body) ?? return None)
