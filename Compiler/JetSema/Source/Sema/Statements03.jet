//RS 
//RS     /// Check a body that may not run at all: a lambda or `task { … }` body,
//RS     /// or a `??` fallback block. A `return` inside such a body still returns
//RS     /// the enclosing function (that targeting is correct and the corpus
//RS     /// depends on it), but only when the body runs — so it is a CONDITIONAL
//RS     /// return, not an unconditional one. Statements after the construct stay
//RS     /// reachable.
//RS     ///
//RS     /// Without this, `check_stmt` sees `flow.reachable == false` for every
//RS     /// following statement and restores the pre-statement facts, discarding
//RS     /// each later declaration and reporting it as `nothing named X exists
//RS     /// here`. One `return` inside a task body buried its own real error under
//RS     /// eleven phantom E0107/E0003 reports (card #2006).
//RS     ///
//RS     /// Inline bodies (`#Unsafe`, `region`, `policy`, comptime blocks) run
//RS     /// unconditionally and deliberately keep `check_block`; loop bodies and
//RS     /// switch arms already isolate reachability through their own joins
//RS     /// (`FlowFacts::after_loop`, `merge_states`).
//RS     pub(crate) fn check_conditional_block(&mut self, stmts: &mut [Stmt], new_scope: bool) {
//RS         let reachable = self.flow.reachable;
//RS         self.check_block(stmts, new_scope);
//RS         self.flow.reachable = reachable;
//RS     }
//RS 
//RS     /// E0209 liveness gate: returns `true` when `name` is
//RS     /// referenced in any statement that follows the current statement in the
//RS     /// innermost block. E0209 fires either way now (no clone is ever silent),
//RS     /// but this decides its fix menu: live-after means `^` would break that
//RS     /// later use, so the menu offers copy/reorder; dead-after means `^` is
//RS     /// safe (this is the value's last use).
//RS     ///
//RS     /// Checks the current block's tail AND all enclosing block tails pushed
//RS     /// by `check_block`, so a clone inside a nested `if` body is not flagged
//RS     /// when the value is used again in the enclosing block after the `if`.
//RS     pub(crate) fn is_name_live_after(&self, name: &str) -> bool {
//RS         // Check the innermost block's tail first.
