    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:1048
    fn check_redundant_arm_table_return(&self, stmts: [Stmt]) {
        (arms, span, default, default_return_span) :: Checker.redundant_arm_table_parts(stmts) ?? return
        edit :: self.redundant_arm_table_edit(arms, span, default, default_return_span) ?? return
