    fn redundant_arm_table_parts(stmts: [Stmt]) -> ([AST.SwitchArm], Span, Expr, Span)? Never! {
        if stmts.len() < 2 -> return None
        if stmts[stmts.len() - 2] is .Switch{subject, arms, else_body: None, span, ..} {
            if stmts[stmts.len() - 1] is .Return(Val(default), default_return_span) {
