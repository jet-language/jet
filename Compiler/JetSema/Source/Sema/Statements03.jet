        if extents.iter().zip(run).any(fn(pair) { pair.0.braced && statements_contain_multiline_string(pair.1.body) }) -> return None
        indent :: source_line_indent(self.source, start)
        subject_view :: self.source.get(run[0].subject_span.start..<run[0].subject_span.end) ?? return None
        subject := subject_view.trim() // #4303
        if subject.is_empty() || subject.contains('\n') -> return None
        replacement := "if {subject} == {{"
        loop (guard, extent) in run.iter().zip(extents) {
            replacement += "\n{indent}    "
            loop (index, value) in guard.values.enumerate() {
                if index > 0 -> replacement += " | "
                value_view :: self.source.get(value.span.start..<value.span.end) ?? return None
                value_text := value_view.trim() // #4303
                replacement += value_text
            }
            replacement += " ->"
            body_view :: self.source.get(extent.body_start..<extent.body_end) ?? return None
            body := body_view.trim() // #4303
            if body.is_empty() {
                replacement += " {}"
            } else if extent.braced {
                replacement += " {"
                loop line in body.lines() {
                    trimmed := line.trim() // #4303
                    if !trimmed.is_empty() -> replacement += "\n{indent}        {trimmed}"
                }
                replacement += "\n{indent}    }"
            } else -> replacement += " {body}"
        }
        replacement += "\n{indent}    else -> {{}}\n}"
        formatted :: Formatter.format_source(replacement) ?? return None
        indented := ""
        formatted_view := formatted.trim_end_matches('\n') // #4303
        loop (line_index, line) in formatted_view.lines().enumerate() {
            if line_index > 0 -> indented += "\n{indent}"
            indented += line
        }
        Val(TextEdit{span: Span.new(start, end), new_text: ^indented})
    }
