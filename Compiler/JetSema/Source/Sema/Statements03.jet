// Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:1238
struct SourceIfExtent { start: USize, end: USize, body_start: USize, body_end: USize, braced: Bool }

// Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:1246
fn source_if_extent(source: String, span: Span, condition_span: Span, body: [Stmt]) -> SourceIfExtent? Never! {
    first_open :: find_source_char(source, condition_span.end, 123)
    arrow :: find_source_sequence(source, condition_span.end, "->".bytes())
    open := None as USize?
    if (first_open, arrow) == {
        (Val(found), Val(arrow_at)) if found < arrow_at -> { open = Val(found) }
        (Val(found), None) -> { open = Val(found) }
        (Val(found), Val(arrow_at)) -> {
            if source.get(arrow_at + 2..<found).map(fn(between) { between.trim().is_empty() }) == Val(true) -> open = Val(found)
        }
        (None, _) -> {}
    }
    if open is found {
        close :: find_switch_close(source, found) ?? return None
        end := close + 1
        if find_authored_semicolon(source, end) is semi -> end = semi + 1
        return Val(SourceIfExtent{start: span.start, end: end, body_start: found + 1, body_end: close, braced: true})
    }
    arrow_at :: arrow ?? return None
    body_start :: arrow_at + 2
    last :: body.last() ?? return None
    body_end :: statement_source_end(source, body_start, last.span().end) ?? return None
    end := body_end
    if find_authored_semicolon(source, end) is semi -> end = semi + 1
    Val(SourceIfExtent{start: span.start, end: end, body_start: body_start, body_end: body_end, braced: false})
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:1305
fn statement_source_end(source: String, start: USize, fallback: USize) -> USize? Never! {
    tail :: source.get(start..) ?? return Val(fallback.max(start))
    body_end :: fallback.max(start) - start
    loop extra_lines in [USize]{0, 2, 8, 32} {
        len :: end_of_lines(tail, body_end, extra_lines + 1) ?? break
        if settled_statement_semi(tail[0..<len]) is end -> return Val(start + end)
    }
    (tokens, _) :: Lexer.lex(tail)
    Val(statement_semi_index(tokens).map(fn(index) { start + tokens[index].span.start }) ?? fallback.max(start))
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:1326
fn end_of_lines(text: String, from: USize, count: USize) -> USize? Never! {
    bytes :: text.bytes().get(from..) ?? return None
    offset :: bytes.iter().enumerate().filter(fn(pair) { pair.1 == 10 }).nth(count - 1) ?? return None
    Val(from + offset.0 + 1)
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:1347
fn settled_statement_semi(window: String) -> USize? Never! {
    (tokens, _) :: Lexer.lex(window)
    index :: statement_semi_index(tokens) ?? return None
    semi :: tokens[index]
    if semi.span.end > semi.span.start -> return Val(semi.span.start)
    final_newline :: window.len().checked_sub(1) ?? return None
    following := tokens[index + 1..].iter().filter(fn(token) { !(token.kind == Lexer.TokKind.Semi && token.span.start == token.span.end) }).skip_while(fn(token) { Lexer.is_comment(token.kind) })
    decider :: following.next() ?? return None
    if decider.kind == { .Dot | .LParen | .Pipe -> true else -> false } -> return None
    settled := if decider.kind != Lexer.TokKind.Eof && decider.span.end <= final_newline { 1 } else { 0 }
    loop token in following.take(2) -> if token.kind != Lexer.TokKind.Eof && token.span.end <= final_newline -> settled += 1
    if settled == 3 -> Val(semi.span.start) else -> None
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:1375
fn statement_semi_index(tokens: [Lexer.Token]) -> USize? Never! {
    parens := 0
    brackets := 0
    braces := 0
    saw_body := false
    loop (index, token) in tokens.enumerate() {
        if token.kind == {
            .LineComment(_) | .BlockComment(_) -> {}
            .Semi if saw_body && parens == 0 && brackets == 0 && braces == 0 -> return Val(index)
            .LParen -> { parens += 1; saw_body = true }
            .RParen if parens > 0 -> { parens -= 1 }
            .LBracket -> { brackets += 1; saw_body = true }
            .RBracket if brackets > 0 -> { brackets -= 1 }
            .LBrace -> { braces += 1; saw_body = true }
            .RBrace if braces > 0 -> { braces -= 1 }
            .Eof -> break
            else -> { saw_body = true }
        }
    }
    None
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:1411
fn source_line_indent(source: String, start: USize) -> String Never! {
    end :: start.min(source.len())
    line_start :: source[0..<end].rfind('\n').map(fn(newline) { newline + 1 }) ?? 0
    source[line_start..<end].chars().take_while(fn(character) { character == ' ' || character == '\t' }).collect()
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:1421
fn source_has_comment(source: String, start: USize, end: USize) -> Bool Never! {
    bytes :: source.bytes()
    index := start.min(bytes.len())
    finish :: end.min(bytes.len())
    loop index < finish {
        if bytes[index] == {
            47 if bytes.get(index + 1) == Val(47) -> return true
            47 if bytes.get(index + 1) == Val(42) -> return true
            34 -> {
                triple :: bytes.get(index..<index + 3) == Val("\"\"\"".bytes())
                index += if triple { 3 } else { 1 }
                loop index < finish {
                    if triple && bytes.get(index..<index + 3) == Val("\"\"\"".bytes()) { index += 3; break }
                    if !triple && bytes[index] == 34 { index += 1; break }
                    if !triple && bytes[index] == 92 -> index = (index + 2).min(finish) else -> index += 1
                }
            }
            39 -> {
                index += 1
                loop index < finish {
                    if bytes[index] == 92 -> index = (index + 2).min(finish)
                    else if bytes[index] == 39 { index += 1; break }
                    else -> index += 1
                }
            }
            else -> { index += 1 }
        }
    }
    false
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:1467
fn statements_contain_multiline_string(stmts: [Stmt]) -> Bool Never! {
    stmts.iter().any(fn(stmt) {
        found := false
        stmt.for_each_expr(fn(expr) {
            if expr.without_parens() is .Str(parts, _) -> found = found || parts.iter().any(fn(part) {
                if part is .Lit(text) -> text.contains('\n') else -> false
            })
        })
        found
    })
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:1481
fn find_source_char(source: String, start: USize, wanted: U8) -> USize? Never! {
    bytes :: source.bytes()
    index := start.min(bytes.len())
    loop index < bytes.len() {
        if bytes[index] == {
            47 if bytes.get(index + 1) == Val(47) -> {
                index += 2
                loop index < bytes.len() && bytes[index] != 10 -> index += 1
            }
            47 if bytes.get(index + 1) == Val(42) -> {
                index += 2
                loop index + 1 < bytes.len() && !(bytes[index] == 42 && bytes[index + 1] == 47) -> index += 1
                index = (index + 2).min(bytes.len())
            }
            34 -> {
                triple :: bytes.get(index..<index + 3) == Val("\"\"\"".bytes())
                index += if triple { 3 } else { 1 }
                loop index < bytes.len() {
                    if triple && bytes.get(index..<index + 3) == Val("\"\"\"".bytes()) { index += 3; break }
                    if !triple && bytes[index] == 34 { index += 1; break }
                    if !triple && bytes[index] == 92 -> index = (index + 2).min(bytes.len()) else -> index += 1
                }
            }
            39 -> {
                index += 1
                loop index < bytes.len() {
                    if bytes[index] == 92 -> index = (index + 2).min(bytes.len())
                    else if bytes[index] == 39 { index += 1; break }
                    else -> index += 1
                }
            }
            byte if byte == wanted -> return Val(index)
            else -> { index += 1 }
        }
    }
    None
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:1539
fn find_source_sequence(source: String, start: USize, wanted: View<U8>) -> USize? Never! {
    if wanted.is_empty() -> return None
    bytes :: source.bytes()
    index := start.min(bytes.len())
    loop index + wanted.len() <= bytes.len() {
        if bytes[index] == {
            47 if bytes.get(index + 1) == Val(47) -> {
                index += 2
                loop index < bytes.len() && bytes[index] != 10 -> index += 1
            }
            47 if bytes.get(index + 1) == Val(42) -> {
                index += 2
                loop index + 1 < bytes.len() && !(bytes[index] == 42 && bytes[index + 1] == 47) -> index += 1
                index = (index + 2).min(bytes.len())
            }
            34 | 39 -> {
                quote :: bytes[index]
                index += 1
                loop index < bytes.len() {
                    if bytes[index] == 92 -> index = (index + 2).min(bytes.len())
                    else if bytes[index] == quote { index += 1; break }
                    else -> index += 1
                }
            }
            else -> {
                if bytes[index..].starts_with(wanted) -> return Val(index)
                index += 1
            }
        }
    }
    None
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:1582
fn find_switch_close(source: String, start: USize) -> USize? Never! {
    bytes :: source.bytes()
    depth := 0
    index := start
    loop index < bytes.len() {
        if bytes[index] == {
            47 if bytes.get(index + 1) == Val(47) -> {
                index += 2
                loop index < bytes.len() && bytes[index] != 10 -> index += 1
            }
            47 if bytes.get(index + 1) == Val(42) -> {
                index += 2
                loop index + 1 < bytes.len() && !(bytes[index] == 42 && bytes[index + 1] == 47) -> index += 1
                index = (index + 2).min(bytes.len())
            }
            34 -> {
                triple :: bytes.get(index..<index + 3) == Val("\"\"\"".bytes())
                index += if triple { 3 } else { 1 }
                loop index < bytes.len() {
                    if triple && bytes.get(index..<index + 3) == Val("\"\"\"".bytes()) { index += 3; break }
                    if !triple && bytes[index] == 34 { index += 1; break }
                    if bytes[index] == 92 && !triple -> index = (index + 2).min(bytes.len()) else -> index += 1
                }
            }
            39 -> {
                index += 1
                loop index < bytes.len() {
                    if bytes[index] == 92 -> index = (index + 2).min(bytes.len())
                    else if bytes[index] == 39 { index += 1; break }
                    else -> index += 1
                }
            }
            123 -> { depth += 1; index += 1 }
            125 if depth == 1 -> return Val(index)
            125 if depth > 1 -> { depth -= 1; index += 1 }
            else -> { index += 1 }
        }
    }
    None
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:1649
fn find_authored_semicolon(source: String, at: USize) -> USize? Never! {
    bytes :: source.bytes()
    cursor := at.min(bytes.len())
    loop {
        loop cursor < bytes.len() && bytes[cursor].is_ascii_whitespace() -> cursor += 1
        if bytes.get(cursor..).map(fn(tail) { tail.starts_with("//".bytes()) }) == Val(true) {
            cursor += 2
            loop cursor < bytes.len() && bytes[cursor] != 10 -> cursor += 1
            next
        }
        if bytes.get(cursor..).map(fn(tail) { tail.starts_with("/*".bytes()) }) == Val(true) {
            cursor += 2
            loop cursor + 1 < bytes.len() && bytes[cursor..<cursor + 2] != "*/".bytes() -> cursor += 1
            cursor = (cursor + 2).min(bytes.len())
            next
        }
        if bytes.get(cursor) == Val(59) -> return Val(cursor)
        return None
    }
}
