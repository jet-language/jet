        default_text :: source.get(default.span().start..<default.span().end) ?? return None
        prefix :: if close > switch_span.start && !source.bytes()[close - 1].is_ascii_whitespace() { " " } else { "" }
        edits.push((close, close, "{prefix}else -> {{ {default_text} }}"))
        edits.push((default_return_span.start, default_return_span.end, ""))
        edits.push((default.span().start, default.span().end, ""))
        end := default.span().end
        if find_authored_semicolon(source, end) is semi {
            end = semi + 1
            edits.push((semi, semi + 1, ""))
        }
        start :: switch_span.start
        replacement := (source.get(start..<end) ?? return None).to_string()
        edits.sort_by(fn(left, right) { left.0.cmp(right.0) })
        loop (edit_start, edit_end, new_text) in edits.iter().rev() {
            if edit_start < start || edit_end > end || edit_start > edit_end -> return None
            replacement.replace_range(edit_start - start..<edit_end - start, new_text)
        }
        Val(TextEdit{span: Span.new(start, end), new_text: ^replacement})
    }
