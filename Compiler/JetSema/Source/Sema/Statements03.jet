    pub fn is_name_live_after(self, name: String) -> Bool Never! {
        // GATE #4494: AST tail pointers set only from live statement slices.
        if !self.stmt_tail_ptr.is_null() && self.stmt_tail_len > 0 {
            #Unsafe("AST tail storage outlives Checker and is read only during statement checks") {
                tail :: slice.from_raw_parts(self.stmt_tail_ptr, self.stmt_tail_len)
                if tail.iter().any(fn(stmt) { stmt_refs_name(stmt, name) }) -> return true
            }
        }
        loop (ptr, len) in self.liveness_frames.iter().rev() {
            if !ptr.is_null() && len > 0 {
                #Unsafe("each enclosing frame points at an AST slice that outlives Checker") {
                    frame :: slice.from_raw_parts(ptr, len)
                    if frame.iter().any(fn(stmt) { stmt_refs_name(stmt, name) }) -> return true
                }
            }
        }
        false
    }
