    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:111
    fn check_block_inner(&self, stmts: &[Stmt], new_scope: Bool, value_tail: (Type, Span)?) {
        redundant_tail_span :: value_tail.and_then(fn(_) { Checker.redundant_arm_table_parts(stmts).map(fn(parts) { parts.1 }) })
        if redundant_tail_span != None -> self.check_redundant_arm_table_return(stmts)
        self.check_adjacent_subject_dispatch_lint(stmts)
        self.prepare_stdlib_lint_block(stmts)
        if new_scope -> self.push_scope()
        saved_ptr :: self.stmt_tail_ptr
        saved_len :: self.stmt_tail_len
        pushed_frame :: !saved_ptr.is_null()
        if pushed_frame -> self.liveness_frames.push((saved_ptr, saved_len))
        exit_guards := [(USize, String)]{}
        loop i in 0..<stmts.len() {
            if i > 0 -> self.emit_unreachable_after_loop(stmts[i - 1], stmts[i])
            // GATE #4494: borrowed AST tail pointer, read only during this check.
            #Unsafe("AST statement storage outlives this checker frame; tail is only read") {
                self.stmt_tail_ptr = stmts[i + 1..].as_ptr()
            }
            self.stmt_tail_len = stmts.len() - i - 1
            self.views_used_in_stmt.clear()
            self.scoped_loan_read_reported = false
            if i + 1 == stmts.len() {
                if value_tail is (expected, _) {
                    uncovered :: uncovered_guard_path(stmts[0..=i], self.source)
                    self.check_value_tail(&stmts[i], expected, uncovered)
                } else -> self.check_stmt(&stmts[i])
            } else {
                diagnostics_start :: self.diags.len()
                exit_guard :: self.optional_exit_guard_subject(stmts[i])
                self.check_stmt(&stmts[i])
                if exit_guard is name && self.flow.narrow.get_at(name, self.scope_depth()) != None -> exit_guards.push((i, name))
                if i + 2 == stmts.len() {
                    if redundant_tail_span is span {
                        checked :: self.diags.split_off(diagnostics_start)
                        self.diags.extend(checked.into_iter().filter(fn(diagnostic) { !(diagnostic.code == "E0003" && diagnostic.span == Val(span)) }))
                    }
                }
            }
        }
        loop (i, name) in exit_guards -> self.rewrite_optional_exit_guard(&stmts[i], name)
        if stmts.is_empty() {
            if value_tail is (expected, block_span) -> self.report_missing_block_value(expected, block_span)
        }
        if pushed_frame -> self.liveness_frames.pop()
        self.stmt_tail_ptr = saved_ptr
        self.stmt_tail_len = saved_len
        if new_scope -> self.pop_scope()
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:201
    pub fn check_stmts_in_scope(&self, stmts: &[Stmt]) {
        exit_guards := [(USize, String)]{}
        last :: stmts.len().saturating_sub(1)
        loop (i, stmt) in &stmts.enumerate() {
            exit_guard :: if i < last { self.optional_exit_guard_subject(stmt) } else { None }
            self.check_stmt(stmt)
            if exit_guard is name && self.flow.narrow.get_at(name, self.scope_depth()) != None -> exit_guards.push((i, name))
        }
        loop (i, name) in exit_guards -> self.rewrite_optional_exit_guard(&stmts[i], name)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:221
    fn tail_has_authored_semicolon(self, span: Span) -> Bool Never! { find_authored_semicolon(self.source, span.end) != None }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:228
    fn check_redundant_final_return(&self, _value: Expr, return_span: Span) {
        if self.compiler_generated || return_span.end > self.source.len() -> return
        keyword_gap :: self.source[return_span.end..].bytes().take_while(fn(byte) { byte == 32 || byte == 9 }).count()
        diagnostic := Diagnostic.from_row("L0530", [], Val(return_span)).with_edit(TextEdit{span: Span.new(return_span.start, return_span.end + keyword_gap), new_text: ""})
        if find_authored_semicolon(self.source, return_span.end) is semicolon -> diagnostic = diagnostic.with_alternative_edit(TextEdit{span: Span.new(semicolon, semicolon + 1), new_text: ""})
        self.diags.push(^diagnostic)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:256
    fn check_value_tail(&self, stmt: &Stmt, expected: Type, uncovered: String?) {
        if !self.flow.reachable {
            if stmt is .Expr(expr) && !self.tail_has_authored_semicolon(expr.span()) && !self.is_diverging_tail(expr) {
                self.infer_with_expected(expr, expected)
            } else -> self.check_stmt(stmt)
            return
        }
        if stmt == {
            .Expr(expr) -> {
                if !self.tail_has_authored_semicolon(expr.span()) && !self.is_diverging_tail(expr) {
                    span :: expr.span()
                    value := Val(mem.replace(expr, Expr.Absent(span)))
                    self.check_return_expr(&value, span, Val(expected.clone()))
                    if value is &inner -> self.lift_value_tail_into_return_carrier(inner, expected)
                    if value is inner -> expr = ^inner
                } else if self.is_diverging_tail(expr) {
                    self.check_stmt(stmt)
                } else {
                    span :: expr.span()
                    self.check_stmt(stmt)
                    self.report_missing_block_value(expected, span)
                }
            }
            .Return(Val(value), return_span) -> {
                self.check_redundant_final_return(value, return_span)
                self.check_stmt(stmt)
            }
            .Return(None, _) -> { self.check_stmt(stmt) }
            .Switch{subject, arms, else_body, span} | .ComptimeSwitch{subject, arms, else_body, span} -> {
                diagnostics_start :: self.diags.len()
                self.check_switch(subject, arms, else_body, span, Val(expected))
                if uncovered is path {
                    if self.diags[diagnostics_start..].iter().rposition(fn(diagnostic) { diagnostic.code == "E0114" }) is index {
                        reported :: self.diags.remove(diagnostics_start + index)
                        self.report_missing_block_value_on_path(expected, reported.span ?? span, Val(path))
                    }
                }
            }
            else -> {
                span :: stmt.span()
                self.check_stmt(stmt)
                if self.flow.reachable && !block_definitely_returns(slice.from_ref(stmt)) -> self.report_missing_block_value_on_path(expected, span, uncovered)
            }
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:352
    pub fn report_missing_block_value(&self, expected: Type, span: Span) { self.report_missing_block_value_on_path(expected, span, None) }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:358
    fn report_missing_block_value_on_path(&self, expected: Type, span: Span, uncovered: String?) {
        expected_name :: expected.show()
        (what, fix) :: if uncovered is path {
            ("when {path}, `{self.fn_name}` reaches the end without a value", "add a last line that produces {expected_name} for that case, or turn the last guard into an `else`")
        } else {
            ("this block promises to produce {expected_name}, but its last line produces no value", "end the block with an expression that produces {expected_name}, or `return` a value on every path")
        }
        self.diags.push(Diagnostic.error("E0114", what, "a block that promises {expected_name} must end with a value of that type, or leave through `return` on every path", fix, Val(span)))
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:399
    fn lift_value_tail_into_return_carrier(&self, value: &Expr, expected: Type) {
        if expected is .Result{..} || self.ret.map(fn(ret) { if ret is .Result{..} -> true else -> false }) != Val(true) || value.without_parens() == { .Ok(..) | .Err(..) -> true else -> false } -> return
        span :: value.span()
        inner :: mem.replace(value, Expr.Absent(span))
        value = Expr.Ok(^inner, span)
        saved_expected :: self.expected_type.clone()
        self.expected_type = self.ret.clone()
        self.infer(value)
        self.expected_type = ^saved_expected
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:415
    fn is_diverging_tail(self, expr: Expr) -> Bool Never! { self.expr_diverges(expr) }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:424
    fn check_adjacent_subject_dispatch_lint(&self, stmts: [Stmt]) {
        index := 0
        loop index < stmts.len() {
            first :: Checker.adjacent_dispatch_guard(stmts[index], self.source)
            if first is guard {
                run := [AdjacentDispatchGuard]{guard}
                end := index + 1
                loop end < stmts.len() {
                    following :: Checker.adjacent_dispatch_guard(stmts[end], self.source) ?? break
                    if following.subject_key != run[0].subject_key -> break
                    run.push(following)
                    end += 1
                }
                if run.len() >= 3 && Checker.dispatch_values_are_exclusive(run) && !run.iter().any(fn(g) { Checker.statements_write_subject(g.body, g.subject_dependencies) }) {
                    span :: run[0].span
                    subject := run[0].subject.join(".")
                    if self.source.get(run[0].subject_span.start..<run[0].subject_span.end) is text {
                        trimmed := text.trim() // #4303
                        if !trimmed.is_empty() -> subject = trimmed.to_string()
                    }
                    diagnostic := Diagnostic.from_row("L0514", [("subject", subject)], Val(span))
                    if self.adjacent_dispatch_edit(run) is edit -> diagnostic = diagnostic.with_edit(edit)
                    self.diags.push(^diagnostic)
                    index = end
                } else -> index += 1
            } else -> index += 1
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:469
    fn adjacent_dispatch_guard(stmt: Stmt, source: String) -> AdjacentDispatchGuard? Never! {
        if stmt is .Switch{subject, arms, else_body: None, span, ..} {
            if !AST.is_subjectless_guard(subject, span) || arms.len() != 1 || !AST.uses_classic_if_spelling(source, span, arms[0].cond.span()) -> return None
            condition_span :: arms[0].cond.span()
            (subject_path, subject_span, subject_key, subject_dependencies, values) :: Checker.dispatch_condition_values(arms[0].cond, source) ?? return None
            return Val(AdjacentDispatchGuard{subject: subject_path, subject_key: subject_key, subject_dependencies: subject_dependencies, subject_span: subject_span, values: values, body: arms[0].body.view(), condition_span: condition_span, span: span})
        }
        None
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:504
    fn dispatch_condition_values(condition: Expr, source: String) -> ([String], Span, String, [[String]], [DispatchValue])? Never! {
        // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:514
        fn collect(condition: Expr, source: String, subject: &DispatchSubject?, values: &[DispatchValue]) -> Bool Never! {
            if condition.without_parens() == {
                .Binary(.Or, left, right, _) -> collect(left, source, subject, values) && collect(right, source, subject, values)
                .Binary(.Eq, left, right, _) -> {
                    left_subject :: Checker.dispatch_subject(left, source)
                    right_subject :: Checker.dispatch_subject(right, source)
                    current := None as DispatchSubject?
                    value_expr := None as Expr?
                    if (left_subject, right_subject) == {
                        (Val(found), None) -> { current = Val(found); value_expr = Val(right) }
                        (None, Val(found)) -> { current = Val(found); value_expr = Val(left) }
                        else -> return false
                    }
                    found :: current ?? return false
                    value :: Checker.dispatch_literal(value_expr ?? return false) ?? return false
                    if subject is existing {
                        if existing.key != found.key -> return false
                    } else -> subject = Val(^found)
                    values.push(^value)
                    true
                }
                else -> false
            }
        }
        subject := None as DispatchSubject?
        values := [DispatchValue]{}
        if !collect(condition, source, &subject, &values) || values.is_empty() -> return None
        found :: subject ?? return None
        if values.iter().any(fn(value) { value.kind != values[0].kind }) -> return None
        Val((found.path, found.span, found.key, found.dependencies, ^values))
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:572
    fn dispatch_subject(expr: Expr, source: String) -> DispatchSubject? Never! {
        source_span :: expr.span()
        unwrapped :: expr.without_parens()
        if !Checker.dispatch_subject_is_call_free(unwrapped) -> return None
        span :: unwrapped.span()
        path :: Checker.dispatch_subject_path(unwrapped) ?? [String]{}
        key :: if path.is_empty() { Checker.dispatch_subject_key(source, span) ?? return None } else { path.join(".") }
        dependencies :: Checker.dispatch_subject_dependencies(unwrapped)
        if dependencies.is_empty() -> return None
        Val(DispatchSubject{path: path, span: source_span, key: key, dependencies: dependencies})
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:601
    fn dispatch_subject_is_call_free(expr: Expr) -> Bool Never! {
        call_free := true
        expr.for_each_expr(fn(nested) {
            if nested.without_parens() == {
                .Call(_) | .MethodCall{..} | .CallValue{..} | .Lambda(_) | .Try(..) | .OrFallback{..} | .If{..} | .Place(..) | .Deref(..) | .RawOf(..) | .PtrFromAddr{..} -> { call_free = false }
                else -> {}
            }
        })
        call_free
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:627
    fn dispatch_subject_key(source: String, span: Span) -> String? Never! {
        text :: source.get(span.start..<span.end) ?? return None
        (tokens, _) :: Lexer.lex(text)
        key := ""
        loop token in tokens {
            if token.kind == { .LineComment(_) | .BlockComment(_) | .Eof -> true else -> false } -> next
            key += "{token.kind:?};"
        }
        if key.is_empty() -> None else -> Val(^key)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:645
    fn dispatch_subject_dependencies(expr: Expr) -> [[String]] Never! {
        paths := [[String]]{}
        expr.for_each_expr(fn(nested) { if Checker.dispatch_subject_path(nested) is path -> paths.push(^path) })
        paths.sort_by(fn(left, right) { right.len().cmp(left.len()) })
        paths.dedup()
        longest_paths :: paths.clone()
        paths.retain(fn(path) { !longest_paths.iter().any(fn(other) { other.len() > path.len() && other.starts_with(path) }) })
        paths
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:663
    fn dispatch_subject_path(expr: Expr) -> [String]? Never! {
        if expr.without_parens() == {
            .Ident(name, _) if !name.starts_with(TEXT_NUL) -> Val([String]{name})
            .Field(base, field, _) -> {
                path := Checker.dispatch_subject_path(base) ?? return None
                path.push(field)
                Val(^path)
            }
            else -> None
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:675
    fn dispatch_literal(expr: Expr) -> DispatchValue? Never! {
        if expr.without_parens() == {
            .Str(parts, span) -> {
                if parts.len() != 1 -> return None
                if parts[0] is .Lit(value) -> return Val(DispatchValue{kind: .String, key: value, span: span})
                None
            }
            .Int(value, span, ..) -> Val(DispatchValue{kind: .Int, key: value.to_string(), span: span})
            .Bool(value, span) -> Val(DispatchValue{kind: .Bool, key: value.to_string(), span: span})
            .Char(value, span) -> Val(DispatchValue{kind: .Char, key: value.to_string(), span: span})
            .EnumLit{type_name, variant, args, span, ..} if args.is_empty() -> Val(DispatchValue{kind: .Enum, key: "{type_name}.{variant}", span: span})
            else -> None
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:703
    fn dispatch_values_are_exclusive(run: [AdjacentDispatchGuard]) -> Bool Never! {
        seen := [DispatchValue]{}
        loop guard in run -> loop value in guard.values {
            if seen.iter().any(fn(existing) { existing.kind == value.kind && existing.key == value.key }) -> return false
            seen.push(value.clone())
        }
        true
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:718
    fn statements_write_subject(stmts: [Stmt], subject: [[String]]) -> Bool Never! { stmts.iter().any(fn(stmt) { Checker.statement_writes_subject(stmt, subject) }) }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:724
    fn statement_writes_subject(stmt: Stmt, subject: [[String]]) -> Bool Never! {
        if stmt == {
            .Assign{target, value, ..} -> Checker.lvalue_writes_subject(target, subject) || Checker.expression_writes_subject(value, subject)
            .Expr(expr) | .Return(Val(expr), _) | .BreakValue(expr, _) | .Yield(expr, _) | .BreakLabelValue(_, _, expr, _) -> Checker.expression_writes_subject(expr, subject)
            .Val(binding) -> Checker.name_writes_subject(binding.name, subject) || Checker.expression_writes_subject(binding.init, subject)
            .While{body, ..} | .For{body, ..} | .Loop{body, ..} | .Unsafe{body, ..} | .Impure{body, ..} | .Reactive{body, ..} | .Shield{body, ..} | .Switched{body, ..} | .Region{body, ..} | .Policy{body, ..} | .Layout{body, ..} | .AuthorityScope{body, ..} | .ComptimeBlock{body, ..} | .Live{body, ..} | .Transact{body, ..} | .ScopeMember{body, ..} -> Checker.statements_write_subject(body, subject)
            .Switch{arms, else_body, ..} | .ComptimeSwitch{arms, else_body, ..} -> arms.iter().any(fn(arm) { Checker.statements_write_subject(arm.body, subject) }) || else_body.map(fn(body) { Checker.statements_write_subject(body, subject) }) == Val(true)
            .CountedLoop{init, step, body, ..} -> Checker.name_writes_subject(init.name, subject) || step.map(fn(stmt) { Checker.statement_writes_subject(stmt, subject) }) == Val(true) || Checker.statements_write_subject(body, subject)
            .TaskGroup{limit, body, ..} -> limit.map(fn(expr) { Checker.expression_writes_subject(expr, subject) }) == Val(true) || Checker.statements_write_subject(body, subject)
            .ContextBlock{fields, body, ..} -> fields.iter().any(fn(field) { Checker.expression_writes_subject(field.1, subject) }) || Checker.statements_write_subject(body, subject)
            .ComptimeIf{then_body, else_body, ..} -> Checker.statements_write_subject(then_body, subject) || else_body.map(fn(body) { Checker.statements_write_subject(body, subject) }) == Val(true)
            .AssumeDet{body, ..} -> Checker.statements_write_subject(body, subject)
            .DeferClose{close, ..} -> Checker.expression_writes_subject(close, subject)
            .Return(None, _) | .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> false
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:810
    fn expression_writes_subject(expr: Expr, subject: [[String]]) -> Bool Never! {
        writes := false
        expr.for_each_expr(fn(nested) {
            if nested.without_parens() == {
                .Place(inner, access, _) if access == AST.PlaceAccess.Write -> { writes = writes || Checker.expr_path(inner).map(fn(path) { Checker.path_writes_subject(path, subject) }) == Val(true) }
                .MethodCall{receiver, args, ..} -> { writes = writes || Checker.expr_path(receiver).map(fn(path) { Checker.path_writes_subject(path, subject) }) == Val(true); writes = writes || Checker.call_args_write_subject(args, subject) }
                .Call(call) -> { writes = writes || Checker.call_args_write_subject(call.args, subject) }
                .CallValue{callee, args, ..} -> { writes = writes || Checker.expr_path(callee).map(fn(path) { Checker.path_writes_subject(path, subject) }) == Val(true); writes = writes || Checker.call_args_write_subject(args, subject) }
                .OrFallback{fallback, ..} -> { if fallback is .Block{body, ..} -> writes = writes || Checker.statements_write_subject(body, subject) }
                .If{then_body, else_body, ..} -> { writes = writes || Checker.statements_write_subject(then_body, subject); writes = writes || Checker.statements_write_subject(else_body, subject) }
                .Lambda(lambda) -> { if lambda.body is .Block(body) -> writes = writes || Checker.statements_write_subject(body, subject) }
                else -> {}
            }
        })
        writes
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:853
    fn call_args_write_subject(args: [AST.CallArg], subject: [[String]]) -> Bool Never! {
        args.iter().any(fn(arg) { (arg.convention == AccessConvention.Write || arg.convention == AccessConvention.Move) && Checker.argument_path(arg.expr).map(fn(path) { Checker.path_writes_subject(path, subject) }) == Val(true) })
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:863
    fn argument_path(expr: Expr) -> [String]? Never! {
        if expr.without_parens() is .Place(inner, ..) -> Checker.expr_path(inner) else -> Checker.expr_path(expr)
    }
