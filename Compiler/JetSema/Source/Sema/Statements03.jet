    // Rust: crates/jet-sema/src/Sema/CheckerCore/blocks.rs:1063
    fn redundant_arm_table_edit(self, arms: [AST.SwitchArm], switch_span: Span, default: Expr, default_return_span: Span) -> TextEdit? Never! {
        source :: self.source
        edits := [(USize, USize, String)]{}
        loop arm in arms {
            if arm.body.len() != 1 -> return None
            if arm.body[0] is .Return(Val(value), return_span) {
                if return_span.start > return_span.end -> return None
