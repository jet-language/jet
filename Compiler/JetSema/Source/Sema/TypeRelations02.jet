// Rust: crates/jet-sema/src/Sema/CheckerItems.rs:2161
fn type_implements_trait_for_name(self: &Checker, type_name: String, trait_name: String) -> Bool {
    (import_ns, leaf) :: self.struct_type_name_parts(type_name)
    owner :: self.struct_owner_module(leaf, import_ns) ?? return self.trait_reg.implements_trait(type_name, trait_name)
    if owner == self.module_idx -> return self.trait_reg.implements_trait(leaf, trait_name)
    modules :: self.modules ?? return false
