// Rust: crates/jet-sema/src/Sema/CheckerItems.rs:2542
fn is_known_enum(self: &Checker, enum_name: String) -> Bool {
    if self.registry.enum_variants(enum_name) != None -> return true
    if self.canonical_enum_registry(enum_name, (registry, leaf) -> if registry.enum_variants(leaf) != None -> Val(()) else -> None) != None -> return true
    if self.modules == .Val(modules) {
        loop idx in self.import_scope_modules() {
            if self.type_is_pub_in(idx, enum_name) && modules[idx].registry.enum_variants(enum_name) != None -> return true
        }
    }
    if CoreModuleExports.core_enum_variants(enum_name) != None -> return true
    if enum_name == Syntax.TYPE_KEY || enum_name == Syntax.DURATION_UNIT_TYPE || enum_name == Syntax.TYPE_IO_OPERATION || is_io_error_type_name(enum_name) -> return true
    return if enum_name == {
        "ProcessStreamMode" | "ProcessSignal" | "TextWidthAmbiguous" | "TextWidthControls" | "WatchDomain" | "WatchKind" | "LateEventDisposition" | "Overflow" | "FailurePolicy" | "DispatchState" | "HookPolicy" | "HookDecision" | "HookOutcome" | "NetShutdown" | "NetReadyInterest" | "NetError" | "NetDnsError" | "SMTPSecurity" | "RecipientPolicy" | "EmailError" | "AuthError" | "DeliveryState" | "ServiceError" | "TaskOutcome" | "TaskStatus" -> true
        else -> false
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerItems.rs:2628
fn resolve_enum_variants_cloned(self: &Checker, enum_name: String) -> [String:(Span, VariantPayload)]? {
    if core_encoding_variants(enum_name) == .Val(v) -> return Val(v)
    if core_http_variants(enum_name) == .Val(v) -> return Val(v)
