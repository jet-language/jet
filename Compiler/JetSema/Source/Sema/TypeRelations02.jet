    self.cloneable_in_context(ty, self.module_idx, &entered)
}
// Rust: crates/jet-sema/src/Sema/CheckerItems.rs:2254
fn nominal_owner_in_context(self: &Checker, name: String, context_mod: USize) -> (USize, String)? {
    registry_of :: (module: USize) -> {
        if module == self.module_idx -> return Val(&self.registry)
        modules :: self.modules ?? return None
        state :: modules.get(module) ?? return None
        Val(&state.registry)
    }
    owner := 0
    leaf := name
    if name.rsplit_once("::") == .Val((_, local)) {
        owner = self.name_ledger.nominal_module(name) ?? return None
        leaf = local
    } else if registry_of(context_mod) == .Val(registry) && registry.contains(name) {
        owner = context_mod
    } else {
        (namespace, local) :: split_type_name(name)
        owner = self.struct_owner_module(local, namespace) ?? return None
        leaf = local
    }
    registry :: registry_of(owner) ?? return None
    if registry.contains(leaf) -> Val((owner, leaf)) else -> None
}
// Rust: crates/jet-sema/src/Sema/CheckerItems.rs:2285
fn cloneable_in_context(self: &Checker, ty: Type, context_mod: USize, entered: &[(USize, String):Bool]) -> Bool {
    return if ty == {
        .List(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> self.cloneable_in_context(inner, context_mod, &entered)
        .Map(key, _, value) | .Result(key, value) -> self.cloneable_in_context(key, context_mod, &entered) && self.cloneable_in_context(value, context_mod, &entered)
        .Tuple(fields) -> {
            loop field in fields { if !self.cloneable_in_context(field.ty, context_mod, &entered) -> return false }
            true
        }
        .Union(members) -> {
            loop member in members { if !self.cloneable_in_context(member, context_mod, &entered) -> return false }
            true
        }
        .Named(name) | .Apply(name, _) -> {
            (owner, leaf) :: self.nominal_owner_in_context(name, context_mod) ?? return SemaDiagnostics.is_cloneable(ty, self.registry)
            if ty == .Apply(_, args) {
                loop arg in args { if !self.cloneable_in_context(arg, context_mod, &entered) -> return false }
            }
            key :: (owner, leaf)
            if entered.contains_key(key) -> return true
            entered[key] = true
            registry := &self.registry
            if owner != self.module_idx {
                modules :: self.modules ?? return false
                state :: modules.get(owner) ?? return false
                registry = &state.registry
            }
            if registry.types.get(leaf) == {
                .Val(.Struct(fields, _)) -> {
                    loop field in fields { if !self.cloneable_in_context(field.2, owner, &entered) -> return false }
                    true
                }
                .Val(.Enum(variants, _, _)) -> {
                    loop value in variants.values() {
                        if value.1 == {
                            .Unit -> {}
                            .Single(payload, _) -> { if !self.cloneable_in_context(payload, owner, &entered) -> return false }
                            .Named(fields) -> { loop field in fields { if !self.cloneable_in_context(field.ty, owner, &entered) -> return false } }
                        }
                    }
                    true
                }
                .Val(.Distinct(_, _, _)) -> true
                .Val(.Alias(target, _)) -> self.cloneable_in_context(target, owner, &entered)
                None -> false
            }
        }
        else -> SemaDiagnostics.is_cloneable(ty, self.registry)
    }
}
