fn owning_field_value_mut(expr: &Expr) -> &Expr {
    return if expr == {
        .Paren(inner, _) | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _) | .Tainted(inner, _, _) -> owning_field_value_mut(&inner)
        else -> &expr
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerItems.rs:3426
fn owning_field_value_type(expr: Expr, ty: Type?) -> Type? {
    return if expr == {
        .Paren(inner, _) | .Tainted(inner, _, _) -> owning_field_value_type(inner, ty)
        .Present(inner, _) -> owning_field_value_type(inner, if ty == .Val(value) -> value.unwrap_option() else -> None)
        .Ok(inner, _) -> {
            payload := None
            if ty == .Val(value) { if value.unwrap_result() == .Val((ok, _)) -> payload = Val(ok) }
            owning_field_value_type(inner, payload)
        }
        .Err(inner, _) -> {
            payload := None
            if ty == .Val(value) { if value.unwrap_result() == .Val((_, error)) -> payload = Val(error) }
            owning_field_value_type(inner, payload)
        }
        else -> ty
    }
}
