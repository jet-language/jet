fn is_equatable_type(self: &Checker, ty: Type) -> Bool {
    if ty == {
        .List(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) -> return self.is_equatable_type(inner)
        .Map(key, _, value) | .Result(key, value) -> return self.is_equatable_type(key) && self.is_equatable_type(value)
        .Tuple(fields) -> {
            loop field in fields { if !self.is_equatable_type(field.ty) -> return false }
            return true
        }
        .Union(members) -> {
            loop member in members { if !self.is_equatable_type(member) -> return false }
            return true
        }
        .Apply(_, args) -> { loop arg in args { if !self.is_equatable_type(arg) -> return false } }
        else -> {}
    }
    (normalized, registry, trait_reg) :: self.capability_type_context(ty)
    SemaDiagnostics.is_equatable(normalized, registry, trait_reg)
}
