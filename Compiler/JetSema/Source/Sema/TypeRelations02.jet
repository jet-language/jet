//RS 
//RS     /// Return the leaf expression in an owning constructor payload. Optional
//RS     /// (`Val`/`Present`) and fallible (`Ok`/`Err`) constructors store their
//RS     /// payload in the destination, so the payload follows the same field
//RS     /// ownership law as a bare field value. Parentheses and taint labels are
//RS     /// transparent; an explicit `Copy` is a complete ownership decision.
//RS     fn owning_field_value_mut(expr: &mut Expr) -> &mut Expr {
//RS         match expr {
//RS             Expr::Paren(inner, _)
//RS             | Expr::Present(inner, _)
//RS             | Expr::Ok(inner, _)
//RS             | Expr::Err(inner, _)
//RS             | Expr::Tainted(inner, _, _) => Self::owning_field_value_mut(inner),
//RS             _ => expr,
//RS         }
//RS     }
//RS 
//RS     fn owning_field_value_type<'ty>(
//RS         expr: &Expr,
//RS         ty: Option<&'ty Type>,
