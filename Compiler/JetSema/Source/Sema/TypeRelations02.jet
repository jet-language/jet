// Rust: crates/jet-sema/src/Sema/CheckerItems.rs:2402
fn type_contains_observable_clock(self: &Checker, ty: Type) -> Bool {
    // Rust: crates/jet-sema/src/Sema/CheckerItems.rs:2403
    fn contains(checker: &Checker, ty: Type, context_mod: USize, seen: &[(USize, String):Bool]) -> Bool {
        if ty == .Tagged(.Internal(.DeterministicClock), inner) && SemaDiagnostics.is_clock_type(inner) -> return false
        return if ty == {
            .Named(name) | .Apply(name, _) -> {
                if ty == .Named(Syntax.CLOCK_TYPE) -> return true
                if ty == .Apply(_, args) {
                    loop arg in args { if contains(&checker, arg, context_mod, &seen) -> return true }
                }
                context_registry := None
                if context_mod == checker.module_idx {
                    context_registry = Val(&checker.registry)
                } else if checker.modules == .Val(modules) {
                    if modules.get(context_mod) == .Val(state) -> context_registry = Val(&state.registry)
                }
                owner_mod := context_mod
                if !(context_registry == .Val(registry) && registry.contains(name)) -> owner_mod = checker.struct_owner_module(name, None) ?? return false
                key :: (owner_mod, name)
                if seen.contains_key(key) -> return false
                seen[key] = true
                if owner_mod == checker.module_idx && checker.registry.nominal_memo_holds(NominalQuery.ObservableClock, name) -> return false
                registry := &checker.registry
                if owner_mod != checker.module_idx {
                    modules :: checker.modules ?? return false
                    state :: modules.get(owner_mod) ?? return false
                    registry = &state.registry
                }
                if registry.types.get(name) == {
                    .Val(.Struct(fields, _)) -> {
                        loop field in fields { if contains(&checker, field.2, owner_mod, &seen) -> return true }
                        false
                    }
                    .Val(.Enum(variants, _, _)) -> {
                        loop value in variants.values() {
                            if value.1 == {
                                .Unit -> {}
                                .Single(payload, _) -> { if contains(&checker, payload, owner_mod, &seen) -> return true }
                                .Named(fields) -> { loop field in fields { if contains(&checker, field.ty, owner_mod, &seen) -> return true } }
                            }
                        }
                        false
                    }
                    .Val(.Distinct(base, _, _)) -> contains(&checker, base, owner_mod, &seen)
                    .Val(.Alias(target, _)) -> contains(&checker, target, owner_mod, &seen)
                    None -> false
                }
            }
            .Option(inner) | .List(inner) | .Shared(inner) | .Tagged(_, inner) | .FixedList(inner, _) -> contains(&checker, inner, context_mod, &seen)
            .Result(key, value) | .Map(key, _, value) -> contains(&checker, key, context_mod, &seen) || contains(&checker, value, context_mod, &seen)
            .Tuple(fields) -> {
                loop field in fields { if contains(&checker, field.ty, context_mod, &seen) -> return true }
                false
            }
            else -> false
        }
    }
    seen := [(USize, String):Bool]{} // GATE #4499
    found :: contains(&self, ty, self.module_idx, &seen)
    if !found {
        neutral := [String]{}
        loop (key, _) in seen { if key.0 == self.module_idx -> &neutral.push(key.1) }
        self.registry.record_neutral_nominals(NominalQuery.ObservableClock, neutral)
    }
    found
}
