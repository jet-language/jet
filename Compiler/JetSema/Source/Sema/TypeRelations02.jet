// Rust: crates/jet-sema/src/Sema/CheckerItems.rs:1768
fn validate_public_failure_carrier(self: &Checker, function: Func) {
    if !function.is_pub -> return
    return_type :: function.return_type ?? return
    (_, error_type) :: return_type.unwrap_result() ?? return
    // Rust: crates/jet-sema/src/Sema/CheckerItems.rs:1779
    fn collect_named(ty: Type, out: &[String]) {
        if ty == {
            .Named(name) -> &out.push(name)
            .Apply(name, args) -> {
                &out.push(name)
                loop arg in args -> collect_named(arg, &out)
            }
            .List(inner) | .Shared(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> collect_named(inner, &out)
            .Map(key, _, value) | .Result(key, value) -> {
                collect_named(key, &out)
                collect_named(value, &out)
            }
            .Tuple(fields) -> { loop field in fields -> collect_named(field.ty, &out) }
            .Fn(params, ret, _, _) -> {
                loop param in params -> collect_named(param, &out)
                if ret == .Val(value) -> collect_named(value, &out)
            }
            .Union(members) -> { loop member in members -> collect_named(member, &out) }
            .Int | .Float | .Float32 | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Measure(_) -> {}
        }
    }
    pending := [String]{}
    collect_named(error_type, &pending)
    checked_carriers := [(USize, String):Bool]{} // GATE #4499: exact owner/leaf tuple keys.
    reported_members := [String:Bool]{}
    loop {
        carrier :: &pending.pop() ?? break
        (import_ns, leaf) :: split_type_name(carrier)
        owner :: self.struct_owner_module(leaf, import_ns) ?? next
        key :: (owner, leaf)
        if checked_carriers.contains_key(key) -> next
        checked_carriers[key] = true
        declaration :: self.name_ledger.declaration(owner, leaf) ?? next
        if declaration.visibility != NameVisibility.Public {
            if !reported_members.contains_key(leaf) {
                reported_members[leaf] = true
                diagnostic :: Diagnostic.from_row("E2421", [("function", function.name), ("member", leaf)], Val(declaration.span))
                edit :: self.public_failure_visibility_edit(owner, declaration.span, declaration.kind, declaration.visibility)
                self.diags.push(diagnostic.with_edit_grade(edit, FixApplicability.Suggested, FixSafety.ApiChanging))
            }
            next
        }
        fields :: self.struct_fields_of(owner, leaf) ?? next
        loop field in fields {
            collect_named(field.2, &pending)
            member_key :: "{leaf}.{field.0}"
            field_declaration :: self.name_ledger.declaration(owner, member_key) ?? next
            if field_declaration.visibility == NameVisibility.Public || reported_members.contains_key(member_key) -> next
            reported_members[member_key] = true
            diagnostic :: Diagnostic.from_row("E2421", [("function", function.name), ("member", member_key)], Val(field_declaration.span))
            edit :: self.public_failure_visibility_edit(owner, field_declaration.span, "field", field_declaration.visibility)
            self.diags.push(diagnostic.with_edit_grade(edit, FixApplicability.Suggested, FixSafety.ApiChanging))
        }
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerItems.rs:1927
fn core_source_owner_module(self: &Checker, module: String, type_name: String) -> USize? {
    alias := None
    loop source in CoreModuleExports.core_source_modules() {
        if source.module == module { alias = Val(source.alias); break }
    }
    wanted :: alias ?? return None
    modules :: self.modules ?? return None
    loop (idx, state) in modules.enumerate() {
        if state.module_alias == wanted && state.registry.contains(type_name) -> return Val(idx)
    }
    None
}
// Rust: crates/jet-sema/src/Sema/CheckerItems.rs:1941
fn import_scope_modules(self: &Checker) -> [USize] {
    scope := self.imports.values().to_list()
    initial :: scope.len()
    own_root :: self.name_ledger.module_namespace(self.module_idx)
    dependency_roots := [String:Bool]{}
    seen := [USize:Bool]{}
    loop idx in scope -> seen[idx] = true
    loop i in 0..initial {
        idx :: scope[i]
        root :: self.name_ledger.module_namespace(idx) ?? next
        if Val(root) == own_root || dependency_roots.contains_key(root) -> next
        dependency_roots[root] = true
        loop sibling in self.name_ledger.namespace_siblings(idx) {
            if !seen.contains_key(sibling) { seen[sibling] = true; &scope.push(sibling) }
        }
    }
    scope
}
// Rust: crates/jet-sema/src/Sema/CheckerItems.rs:1966
fn record_distinct_from_builtin(self: &Checker, owner: USize, leaf: String) -> Bool {
    kind :: Syntax.typed_head_kind(leaf) ?? return false
    carrier_alias := None
    if kind.carrier_record_module() == .Val(module) {
        if CoreModuleExports.core_source_module(module) == .Val(source) -> carrier_alias = Val(source.alias)
    }
    modules :: self.modules ?? return false
    state :: modules.get(owner) ?? return false
    state.registry.contains(leaf) && Val(state.module_alias) != carrier_alias
}
// Rust: crates/jet-sema/src/Sema/CheckerItems.rs:1985
fn core_nominal_shadowing_builtin(self: &Checker, module: String, leaf: String) -> String? {
    owner :: self.core_source_owner_module(module, leaf) ?? return None
    if self.record_distinct_from_builtin(owner, leaf) -> Val(self.canonical_nominal_name(owner, leaf)) else -> None
}
// Rust: crates/jet-sema/src/Sema/CheckerItems.rs:1994
fn qualify_builtin_shadowing_sig(self: &Checker, owner: USize, sig: &FuncSig) {
    if owner == self.module_idx -> return
    qualify :: (ty: Type) -> ty.map_named_types((name) -> if self.record_distinct_from_builtin(owner, name) -> Val(self.canonical_nominal_name(owner, name)) else -> None)
    loop param in &sig.params -> param.1 = qualify(param.1)
    if sig.return_type == .Val(ret) -> sig.return_type = Val(qualify(ret))
}
