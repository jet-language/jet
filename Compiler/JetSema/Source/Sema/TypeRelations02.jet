            what :: if borrowed -> "`{name}` was not moved here, so it cannot fill an owned field" else -> "`{name}` is still used later, so filling this field would copy it"
            why :: if borrowed -> "this function has read access only and does not own the value" else -> "`copies: .Explicit` is active, so a copy into an owned field must be written"
            diagnostic :: Diagnostic.error("E0120", what, why, "copy it explicitly with `{Syntax.SIGIL_COPY}{name}`", Val(span))
            self.diags.push(self.with_ownership_copy_edit(diagnostic, span, payload_ty))
        }
        return
    }
    if should_clone {
        span :: payload.span()
        old :: mem.replace(payload, Expr.Absent(span))
        payload = Expr.Copy(old, span)
    }
    self.note_move_if_direct_ident(payload, "the variant payload")
}
