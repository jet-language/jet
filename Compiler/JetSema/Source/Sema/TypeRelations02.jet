fn canonical_nominal_name(self: &Checker, owner: USize, leaf: String) -> String {
    identity :: self.name_ledger.nominal_identity(owner, leaf).expect("name ledger must contain every loaded module")
    if core_http_carrier_leaf(identity) == .Val(carrier) -> carrier else -> identity
}
