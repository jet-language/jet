        identity :: self.import_qualified_nominal(qualified) ?? return None
        return Val((identity, segs[1..].join(".")))
    }
    if !self.is_known_enum(root) -> return None
    if self.member_imported_type(root) -> return Val((self.imported_nominal_head(root), segs.join(".")))
