fn fold_enum_variant_path(self: &Checker, e: Expr) -> (String, String)? {
    // Rust: crates/jet-sema/src/Sema/CheckerItems.rs:2768
    fn walk(e: Expr) -> (String, [String])? {
        return if e == {
            .Ident(name, _) -> Val((name, []))
            .Field(inner, member, _) -> {
