fn struct_owner_module(self: &Checker, type_name: String, import_ns: String?) -> USize? {
    if import_ns == .Val(namespace) {
        if self.core_imports.get(namespace) == .Val(module) {
            if CoreModuleExports.core_leaf_kind(module, type_name) != None -> return self.core_source_owner_module(module, type_name)
        }
    }
    if import_ns == None {
        if self.core_imports.get(type_name) == .Val(module) {
            leaf :: self.core_item_imports.get(type_name) ?? type_name
            if CoreModuleExports.core_leaf_kind(module, leaf) != None {
                if self.core_source_owner_module(module, leaf) == .Val(owner) -> return Val(owner)
            }
        }
    }
    if import_ns == .Val(namespace) {
        if namespace.contains("::") {
            identity :: "{namespace}::{type_name}"
            mod_idx :: self.name_ledger.nominal_module(identity) ?? return None
            modules :: self.modules ?? return None
            state :: modules.get(mod_idx) ?? return None
            return if state.registry.contains(type_name) -> Val(mod_idx) else -> None
        }
        mod_idx :: self.imports.get(namespace) ?? return None
        modules :: self.modules ?? return None
        if modules[mod_idx].registry.contains(type_name) -> return Val(mod_idx)
        loop sibling in self.name_ledger.namespace_siblings(mod_idx) {
            if modules[sibling].registry.contains(type_name) -> return Val(sibling)
        }
        return None
    }
    if type_name.contains("::") {
        (namespace, leaf) :: type_name.rsplit_once("::") ?? return None
        return self.struct_owner_module(leaf, Val(namespace))
    }
    if self.registry.contains(type_name) -> return Val(self.module_idx)
    modules :: self.modules ?? return None
    if self.name_ledger.alias(self.module_idx, type_name) == .Val(alias) {
        if alias.target_module == .Val(owner) {
            (_, leaf) :: split_type_name(alias.target)
            if modules.get(owner) == .Val(state) && state.registry.contains(leaf) && self.type_is_pub_in(owner, leaf) -> return Val(owner)
        }
    }
    if Syntax.typed_head_kind(type_name) == .Val(kind) {
        module :: kind.carrier_record_module() ?? return None
        return self.core_source_owner_module(module, type_name)
    }
    if self.nominal_owner_cache.get(type_name) == .Val(owner) -> return owner
    found := None
    loop (idx, state) in modules.enumerate() {
        if state.registry.contains(type_name) && self.type_is_pub_in(idx, type_name) {
            if found == .Val(previous) && previous != idx { found = None; break }
            found = Val(idx)
        }
    }
    self.nominal_owner_cache[type_name] = found
    found
}
