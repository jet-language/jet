fn canonical_enum_registry<T>(self: &Checker, enum_name: String, read: (&TypeRegistry, String) -> T?) -> T? {
    (namespace, leaf) :: split_type_name(enum_name)
    qualified := enum_name.contains("::")
    if namespace == .Val(ns) && self.imports.contains_key(ns) -> qualified = true
    if !qualified -> return None
    owner :: self.struct_owner_module(leaf, namespace) ?? return None
    if owner == self.module_idx -> return read(&self.registry, leaf)
    modules :: self.modules ?? return None
    state :: modules.get(owner) ?? return None
    result :: read(&state.registry, leaf)
    if self.type_is_pub_in(owner, leaf) -> result else -> None
