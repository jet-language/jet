fn split_type_name(type_name: String) -> (String?, String) {
    parts := type_name.rsplit_once("::")
    if parts == None -> parts = type_name.rsplit_once(".")
    if parts == .Val((namespace, leaf)) -> (Val(namespace), leaf) else -> (None, type_name)
}
// Rust: crates/jet-sema/src/Sema/CheckerItems.rs:2127
fn struct_type_name_parts(self: &Checker, type_name: String) -> (String?, String) {
    if self.registry.contains(type_name) -> (None, type_name) else -> split_type_name(type_name)
}
