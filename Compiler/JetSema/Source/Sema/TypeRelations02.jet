fn capability_type_context(self: &Checker, ty: Type) -> (Type, &TypeRegistry, &TraitRegistry) {
    name := ""
    args := None
    if ty == {
        .Named(n) -> name = n
        .Apply(n, a) -> { name = n; args = Val(a) }
        else -> return (ty, &self.registry, &self.trait_reg)
    }
    (import_ns, leaf) :: self.struct_type_name_parts(name)
    owner :: self.struct_owner_module(leaf, import_ns) ?? return (ty, &self.registry, &self.trait_reg)
    normalized :: if args == .Val(values) -> Type.Apply{name: leaf, args: values} else -> Type.Named{name: leaf}
    if owner == self.module_idx -> return (normalized, &self.registry, &self.trait_reg)
    if self.modules == .Val(modules) {
        if modules.get(owner) == .Val(state) -> return (normalized, &state.registry, &state.trait_reg)
    }
    (ty, &self.registry, &self.trait_reg)
}
