use {
    math: core.math
    unicode: core.text
    jet_foundation.[
        JET_CLI_COMMANDS,
        Diagnostic,
        EveryArg,
        EverySchedule,
        EveryScheduleError,
        Expr,
        Func,
        Item,
        JobScope,
        MARKER_DOC,
        Param,
        Span,
        SymbolKind,
        TFunctionRef,
        Type,
        ast_job_metadata,
        diagnostic_with_label,
        expr_span,
        symbol_id,
        type_name,
    ]
}

SemaJobScheduleResolution: struct {
    schedule: EverySchedule?
    error: EveryScheduleError?
}

sema_job_schedule_unit: fn(suffix: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaRegistrationUnitFact? {
    if program.registration_graph == .Val(graph) -> return sema_expression_unit_literal_time_fact(suffix, graph)
    None
}

sema_job_schedule_float_to_int: fn(value: Float) -> Int Never! {
    remaining := value
    result := 0
    bit := 62
    loop bit >= 0 {
        unit := 1 << bit
        floating_unit := Float.from_int(unit)
        if remaining >= floating_unit {
            result += unit
            remaining -= floating_unit
        }
        bit -= 1
    }
    result
}

sema_job_schedule_duration_int: fn(value: Int, unit: SemaRegistrationUnitFact) -> Int? {
    if value <= 0 -> return None
    if unit.scale.numerator <= 0 || unit.scale.denominator <= 0 -> return None
    max_int: 9223372036854775807
    if value > max_int /% unit.scale.numerator -> return None
    nanos := value * unit.scale.numerator /% unit.scale.denominator
    if nanos <= 0 || nanos > max_int -> return None
    Val(nanos)
}

sema_job_schedule_duration_float: fn(value: Float, unit: SemaRegistrationUnitFact) -> SemaJobScheduleResolution {
    if !math.is_finite(value) || value <= 0.0 -> return SemaJobScheduleResolution{schedule: None, error: Val(EveryScheduleError.NonPositiveDuration)}
    if unit.scale.numerator <= 0 || unit.scale.denominator <= 0 -> return SemaJobScheduleResolution{schedule: None, error: Val(EveryScheduleError.DurationOutOfRange)}
    nanos := value * approx(unit.scale.numerator) / approx(unit.scale.denominator)
    max_int_exclusive: Float{9223372036854775808.0}
    if !math.is_finite(nanos) || nanos >= max_int_exclusive -> return SemaJobScheduleResolution{schedule: None, error: Val(EveryScheduleError.DurationOutOfRange)}
    if nanos <= 0.0 -> return SemaJobScheduleResolution{schedule: None, error: Val(EveryScheduleError.NonPositiveDuration)}
    integer_nanos := sema_job_schedule_float_to_int(nanos)
    if integer_nanos <= 0 -> return SemaJobScheduleResolution{schedule: None, error: Val(EveryScheduleError.NonPositiveDuration)}
    SemaJobScheduleResolution{schedule: Val(EverySchedule.Duration{nanos: integer_nanos}), error: None}
}

sema_job_schedule_wall_clock: fn(text: String) -> SemaJobScheduleResolution Never! {
    bytes := text.bytes()
    if bytes.len() != 5 || Int.from_u8(bytes[2]) != 58 -> return SemaJobScheduleResolution{schedule: None, error: Val(EveryScheduleError.BadWallClockFormat)}
    loop index in ([Int]{0, 1, 3, 4}) {
        digit := Int.from_u8(bytes[index])
        if digit < 48 || digit > 57 -> return SemaJobScheduleResolution{schedule: None, error: Val(EveryScheduleError.BadWallClockFormat)}
    }
    hour_text: String.from_bytes(bytes.slice(0, 2)) ?? return SemaJobScheduleResolution{schedule: None, error: Val(EveryScheduleError.BadWallClockFormat)}
    minute_text: String.from_bytes(bytes.slice(3, 5)) ?? return SemaJobScheduleResolution{schedule: None, error: Val(EveryScheduleError.BadWallClockFormat)}
    hour: Int.parse(hour_text) ?? return SemaJobScheduleResolution{schedule: None, error: Val(EveryScheduleError.BadWallClockFormat)}
    minute: Int.parse(minute_text) ?? return SemaJobScheduleResolution{schedule: None, error: Val(EveryScheduleError.BadWallClockFormat)}
    if hour > 23 -> return SemaJobScheduleResolution{schedule: None, error: Val(EveryScheduleError.HourOutOfRange)}
    if minute > 59 -> return SemaJobScheduleResolution{schedule: None, error: Val(EveryScheduleError.MinuteOutOfRange)}
    return SemaJobScheduleResolution{schedule: Val(EverySchedule.WallClockTime{hour: hour, minute: minute}), error: None}
}

sema_job_resolve_every_arg: fn(argument: EveryArg, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaJobScheduleResolution {
    if argument == {
        .Duration(int, float, suffix, _) -> {
            unit: sema_job_schedule_unit(suffix, environment, program) ?? return SemaJobScheduleResolution{schedule: None, error: Val(EveryScheduleError.UnknownDurationUnit)}
            if int == .Val(value) {
                nanos: sema_job_schedule_duration_int(value, unit) ?? {
                    error := if value <= 0 -> EveryScheduleError.NonPositiveDuration else -> EveryScheduleError.DurationOutOfRange
                    return SemaJobScheduleResolution{schedule: None, error: Val(error)}
                }
                return SemaJobScheduleResolution{schedule: Val(EverySchedule.Duration{nanos: nanos}), error: None}
            }
            if float == .Val(value) -> return sema_job_schedule_duration_float(value, unit)
            return SemaJobScheduleResolution{schedule: None, error: Val(EveryScheduleError.DynamicValue)}
        }
        .WallClock(text, _) -> return sema_job_schedule_wall_clock(text)
        .Expression(_) -> return SemaJobScheduleResolution{schedule: None, error: Val(EveryScheduleError.DynamicValue)}
    }
}

sema_job_every_error_span: fn(argument: EveryArg) -> Span {
    if argument == {
        .Duration(_, _, _, suffix_span) -> suffix_span
        .WallClock(_, text_span) -> text_span
        .Expression(expression) -> expr_span(expression)
    }
}

sema_job_schedule_error: fn(reason: EveryScheduleError, span: Span) -> Diagnostic {
    if reason == {
        .UnknownDurationUnit -> sema_error("E0926", span, "this duration's unit isn't a recognized schedule cadence", "a schedule's repeat interval uses the canonical Time family — `ns`/`us`/`ms`/`s`/`min`/`h`/`d` — not an arbitrary `#UnitFamily` member.", "use a canonical Time unit such as `min`, `h`, or `d` (e.g. `#Job(every: 2h)`).")
        .NonPositiveDuration -> sema_error("E0926", span, "a schedule interval must be a positive duration", "`every: 0ms` or a negative duration never becomes due — it isn't a real cadence.", "write a duration greater than zero, e.g. `#Job(every: 5min)`.")
        .DurationOutOfRange -> sema_error("E0926", span, "this schedule duration is outside the supported range", "schedule intervals use the same fixed i64 nanosecond carrier as Duration.", "write a smaller positive duration, e.g. `#Job(every: 5min)`.")
        .BadWallClockFormat -> sema_error("E0926", span, "this daily schedule isn't a plain `\"HH:MM\"` time", "a wall-clock trigger is exactly two digits, a colon, and two digits — 24h time, no seconds, no timezone.", "write a fixed daily time like `#Job(every: \"03:00\")`.")
        .HourOutOfRange -> sema_error("E0926", span, "this daily schedule's hour is out of range", "24h wall-clock hours run `00`..=`23`.", "write an hour between `00` and `23`, e.g. `#Job(every: \"03:00\")`.")
        .MinuteOutOfRange -> sema_error("E0926", span, "this daily schedule's minute is out of range", "wall-clock minutes run `00`..=`59`.", "write a minute between `00` and `59`, e.g. `#Job(every: \"03:00\")`.")
        .DynamicValue -> sema_error("E0926", span, "a job schedule must be known at compile time", "the marker argument has the right type, but job discovery needs one fixed cadence.", "write a duration or wall-clock literal, e.g. `#Job(every: 5min)` or `#Job(every: \"03:00\")`.")
    }
}

/// Sema and help read the same command registry.
sema_job_is_reserved: fn(name: String) -> Bool Never! {
    loop command in JET_CLI_COMMANDS {
        if command.name == name -> return true
    }
    false
}

sema_job_scope_name: fn(scope: JobScope) -> String Never! {
    if scope == {
        .Dev -> "Dev"
        .Ship -> "Ship"
        .Internal -> "Internal"
    }
}

sema_job_reserved_name_error: fn(name: String, span: Span) -> Diagnostic {
    sema_error("E0928", span, "`{name}` is reserved by Jet's command line", "`{name}` is a Jet command; top-level jobs must have distinct names", "rename the job, e.g. `#Job fn {name}_all()`")
}

sema_job_duplicate_error: fn(name: String, scope: JobScope, span: Span) -> Diagnostic {
    scope_name := sema_job_scope_name(scope)
    sema_error("E0928", span, "job `{name}` is declared more than once in scope .{scope_name}", "`jet {name}` must select exactly one function", "rename one of the jobs, or give the declarations different scopes")
}

sema_job_command_clash_error: fn(name: String, span: Span, command_span: Span) -> Diagnostic {
    diagnostic: sema_error("E0928", span, "job `{name}` clashes with the `#CLI` command `{name}`", "`{name}` names both a job and a command of this program, so `jet {name}` cannot select exactly one function", "rename the job or the command; an `.Internal` job never clashes")
    diagnostic_with_label(diagnostic, command_span, "the `#CLI` command `{name}` is declared here")
}

// One command word of a `#CLI` struct and where it is written.
SemaJobCommandWord: struct {
    name: String
    span: Span
}

// The command words of the `#CLI` structs among `items`: each method that is
// not a computed-field getter and each bound command, lowercased as the
// command line reads them (CliEntry.jet `sema_cli_entry_spec`).
sema_job_cli_commands: fn(items: [Item]) -> [SemaJobCommandWord] {
    words := [SemaJobCommandWord]{}
    loop item in items {
        if item == .Struct(definition) {
            cli := false
            loop derive_item in definition.derives {
                if derive_item.name == "CLI" -> cli = true
            }
            if !cli -> next
            loop function in definition.methods {
                if function.name.starts_with("__computed_") -> next
                words.push(SemaJobCommandWord{name: unicode.lower(function.name), span: function.name_span})
            }
            loop binding in definition.cli_bindings -> words.push(SemaJobCommandWord{name: unicode.lower(binding.name), span: binding.name_span})
        }
    }
    words
}

/// E0928: a `#Job fn` takes a reserved name, shares its word with a `#CLI`
/// command of the module (unless the job is `.Internal`), or two jobs share
/// one name in the same scope of a module.
sema_check_job_names: fn(items: [Item]) -> [Diagnostic] {
    diagnostics := [Diagnostic]{}
    commands: sema_job_cli_commands(items)
    seen_names := [String]{}
    seen_scopes := [JobScope]{}
    loop item in items {
        if item == {
            .Func(function) -> {
                if !function.is_job -> next
                span := function.job_span ?? function.name_span
                if sema_job_is_reserved(function.name) {
                    diagnostics.push(sema_job_reserved_name_error(function.name, span))
                    next
                }
                metadata := function.job_metadata ?? ast_job_metadata()
                scope := metadata.scope
                if scope != .Internal {
                    word: unicode.lower(function.name)
                    clash := false
                    loop command in commands {
                        if command.name == word {
                            diagnostics.push(sema_job_command_clash_error(function.name, span, command.span))
                            clash = true
                            break
                        }
                    }
                    if clash -> next
                }
                index := 0
                duplicate := false
                loop index < seen_names.len() {
                    if seen_names[index] == function.name && seen_scopes[index] == scope {
                        duplicate = true
                        break
                    }
                    index += 1
                }
                if duplicate {
                    diagnostics.push(sema_job_duplicate_error(function.name, scope, span))
                    next
                }
                seen_names.push(function.name)
                seen_scopes.push(scope)
            }
            else -> {}
        }
    }
    diagnostics
}

/// E0926: a job's `every:` schedule must resolve to one fixed cadence. A function
/// parameter of a type other than `Duration` is the marker's argument-type
/// error (E0930), so it is not also reported as a dynamic schedule.
sema_check_job_schedules: fn(items: [Item], environment: SemaScopeEnvironment, program: SemaProgramTables) -> [Diagnostic] {
    diagnostics := [Diagnostic]{}
    loop item in items {
        if item == {
            .Func(function) -> {
                marker: function.every ?? next
                if marker.arg == .Expression(expression) {
                    if expression == .Ident(name, _, _) && sema_job_mistyped_parameter(function.params, name) -> next
                }
                resolution: sema_job_resolve_every_arg(marker.arg, environment, program)
                if resolution.error == .Val(reason) -> diagnostics.push(sema_job_schedule_error(reason, sema_job_every_error_span(marker.arg)))
            }
            else -> {}
        }
    }
    diagnostics
}

sema_job_mistyped_parameter: fn(params: [Param], name: String) -> Bool Never! {
    loop param in params {
        if param.name == name -> return param.ty != Type.Named{name: "Duration"}
    }
    false
}
