// D-WASM1=A: classify functions into JS/WASM buckets and diagnose crossings.
use jet_foundation.[Diagnostic, Span, EnumDef, Func, Item, ProgramBundle, StructDef, Type, VariantPayload, partition_effect_key, partition_key]
use jet_syntax as Syntax
use jet_syntax.[WebBucket, WebPartitionMarker]
use jet_generics.[DECODE, ENCODE]

// Rust: crates/jet-sema/src/Sema/WebPartition.rs:18
struct FuncWebMeta {
    key: String,
    effect_key: String,
    name: String,
    name_span: Span,
    marker: WebPartitionMarker?,
    ceiling: WebBucket?,
    params: [Type],
    return_type: Type?,
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:30
struct ABITypeIndex {
    structs: [String:StructDef] = [:],
    enums: [String:EnumDef] = [:],
    // Rust: crates/jet-sema/src/Sema/WebPartition.rs:36
    fn from_bundle(bundle: ProgramBundle) -> ABITypeIndex {
        out := ABITypeIndex{}
        loop module in bundle.modules -> collect_abi_types(module.items, &out)
        out
    }
    // Rust: crates/jet-sema/src/Sema/WebPartition.rs:104
    fn is_codable_named(name: String, args: [Type]) -> Bool {
        if self.structs.get(name) == .Val(s) {
            if !has_codable_derive(s.derives) -> return false
            if !s.type_params.is_empty() && !args.is_empty() {
                if args.len() != s.type_params.len() -> return false
                return args.all(fn(t) { is_abi_safe_type_full(t, self) })
            }
            return s.fields.all(fn(f) { is_abi_safe_type_full(f.ty, self) })
        }
        if self.enums.get(name) == .Val(e) {
            if !has_codable_derive(e.derives) -> return false
            if !e.type_params.is_empty() && !args.is_empty() {
                if args.len() != e.type_params.len() -> return false
                return args.all(fn(t) { is_abi_safe_type_full(t, self) })
            }
            return e.variants.all(fn(v) {
                if v.payload == {
                    .Unit -> true
                    .Single(t, _) -> is_abi_safe_type_full(t, self)
                    .Named(fields) -> fields.all(fn(f) { is_abi_safe_type_full(f.ty, self) })
                }
            })
        }
        false
    }
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:45
fn collect_abi_types(items: [Item], out: &ABITypeIndex) {
    loop item in items {
        if item == {
            .Struct(s) -> out.structs[s.name] = clone_struct(s)
            .Enum(e) -> out.enums[e.name] = clone_enum(e)
            .CodeModule(cm) -> if cm.body == .Val(body) -> collect_abi_types(body, &out)
            else -> {}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:64
fn clone_struct(s: StructDef) -> StructDef {
    result := s.clone()
    &result.methods.clear()
    &result.trait_impls.clear()
    result
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:71
fn clone_enum(e: EnumDef) -> EnumDef {
    result := e.clone()
    &result.methods.clear()
    &result.trait_impls.clear()
    result
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:78
fn has_codable_derive(derives: [(String, Span)]) -> Bool {
    encode := false
    decode := false
    loop (d, _) in derives {
        if d == Syntax.MARKER_CODABLE -> return true
        if d == ENCODE -> encode = true
        if d == DECODE -> decode = true
    }
    encode && decode
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:92
fn is_abi_safe_type_full(ty: Type, idx: ABITypeIndex) -> Bool {
    if Syntax.is_abi_safe_type(ty) -> return true
    if ty == {
        .Named(n) -> idx.is_codable_named(n, [])
        .Apply(name, args) -> idx.is_codable_named(name, args)
        else -> false
    }
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:142
fn checked_web_bucket(marker: WebPartitionMarker?, ceiling: WebBucket?, effects: EffectSet, return_type: Type?) -> WebBucket {
    if marker == .Val(m) -> return m.bucket()
    if effect_set_has_root(effects, Effect.Browser) -> return WebBucket.JS
    if ceiling == .Val(c) -> return c
    // Stream producers require the JS generator yield/close protocol.
    if return_type == .Val(t) { if is_stream_type(t) -> return WebBucket.JS }
    WebBucket.Wasm
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:167
fn is_stream_type(ty: Type) -> Bool {
    if ty == .Apply(name, args) -> return name == Syntax.TYPE_STREAM && args.len() == 1
    false
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:171
fn funcs_have_web_markers(functions: [Func]) -> Bool {
    functions.any(fn(function) { function.web_marker != None })
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:175
fn items_have_web_markers(items: [Item]) -> Bool {
    loop item in items {
        if item == {
            .Func(f) -> if f.web_marker != None -> return true
            .Struct(s) -> {
                if funcs_have_web_markers(s.methods) || s.trait_impls.any(fn(i) { funcs_have_web_markers(i.methods) }) -> return true
            }
            .Enum(e) -> {
                if funcs_have_web_markers(e.methods) || e.trait_impls.any(fn(i) { funcs_have_web_markers(i.methods) }) -> return true
            }
            .Impl(i) -> if funcs_have_web_markers(i.methods) -> return true
            .CodeModule(cm) -> {
                if cm.web_target != None -> return true
                if cm.body == .Val(body) { if items_have_web_markers(body) -> return true }
            }
            else -> {}
        }
    }
    false
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:217
fn web_partition_active(bundle: ProgramBundle) -> Bool {
    if bundle.web_partition_enforced -> return true
    loop module in bundle.modules {
        if module.web_target_ceiling != None || items_have_web_markers(module.items) -> return true
    }
    false
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:231
fn push_func_meta(function: Func, owner_type: String?, file_ceiling: WebBucket?, module_ceiling: WebBucket?, module_prefix: String?, file_alias: String, is_entry: Bool, out: &[FuncWebMeta]) {
    ceiling :: module_ceiling.or(file_ceiling)
    local_key :: if owner_type == {
        .Val(owner) -> effect_key(Val(owner), function.name)
        None -> if module_prefix == {
            .Val(module) -> inline_effect_key(module, function.name)
            None -> effect_key(None, function.name)
        }
    }
    function_name :: if owner_type == .Val(owner) -> "{owner}::{function.name}" else -> function.name
    file_prefix :: if !is_entry && module_prefix == None -> Val(file_alias) else -> None
    key :: partition_key(file_prefix, module_prefix, function_name)
    &out.push(FuncWebMeta{
        key: key, effect_key: partition_effect_key(file_alias, local_key),
        name: function_name, name_span: function.name_span,
        marker: function.web_marker, ceiling: ceiling,
        params: function.params.map(fn(p) { p.ty.clone() }).collect(),
        return_type: function.return_type.clone(),
    })
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:266
fn collect_method_meta(methods: [Func], owner_type: String, file_ceiling: WebBucket?, module_ceiling: WebBucket?, module_prefix: String?, file_alias: String, is_entry: Bool, out: &[FuncWebMeta]) {
    loop method in methods -> push_func_meta(method, Val(owner_type), file_ceiling, module_ceiling, module_prefix, file_alias, is_entry, &out)
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:290
fn collect_funcs(items: [Item], file_ceiling: WebBucket?, module_ceiling: WebBucket?, module_prefix: String?, file_alias: String, is_entry: Bool, out: &[FuncWebMeta]) {
    ceiling :: module_ceiling.or(file_ceiling)
    loop item in items {
        if item == {
            .Func(function) -> push_func_meta(function, None, file_ceiling, module_ceiling, module_prefix, file_alias, is_entry, &out)
            .Struct(s) -> {
                collect_method_meta(s.methods, s.name, file_ceiling, module_ceiling, module_prefix, file_alias, is_entry, &out)
                loop i in s.trait_impls -> collect_method_meta(i.methods, s.name, file_ceiling, module_ceiling, module_prefix, file_alias, is_entry, &out)
            }
            .Enum(e) -> {
                collect_method_meta(e.methods, e.name, file_ceiling, module_ceiling, module_prefix, file_alias, is_entry, &out)
                loop i in e.trait_impls -> collect_method_meta(i.methods, e.name, file_ceiling, module_ceiling, module_prefix, file_alias, is_entry, &out)
            }
            .Impl(i) -> collect_method_meta(i.methods, i.type_name, file_ceiling, module_ceiling, module_prefix, file_alias, is_entry, &out)
            .CodeModule(cm) -> {
                mod_ceiling :: cm.web_target.or(ceiling)
                if cm.body == .Val(body) -> collect_funcs(body, file_ceiling, mod_ceiling, Val(cm.name), file_alias, is_entry, &out)
            }
            else -> {}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:389
fn type_show(ty: Type) -> String {
    if ty == {
        .Int -> "Int"
        .Float -> "Float"
        .Bool -> "Bool"
        .String -> "String"
        .Char -> "Char"
        .Named(n) -> n
        .List(inner) -> "[{type_show(inner)}]"
        .Map(_, value) -> "Map<String, {type_show(value)}>"
        .Fn(params, ret, effect_bound, _) -> "Fn {{ params: {params:Debug}, ret: {ret:Debug}, effect_bound: {effect_bound:Debug} }}"
        other -> "{other:Debug}"
    }
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:409
fn marker_show(marker: WebPartitionMarker?) -> String {
    if marker == .Val(m) -> m.name() else -> "—"
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:416
fn reason_show(f: FuncWebMeta, effects: EffectSet) -> String {
    if f.marker == .Val(m) -> return "#{marker_show(Val(m))}"
    if effect_set_has_root(effects, Effect.Browser) -> return "inferred: Browser effect"
    if f.ceiling == .Val(c) -> return "#{Syntax.MARKER_TARGET}({c.name()})"
    if f.return_type == .Val(t) { if is_stream_type(t) -> return "inferred: Stream producer" }
    if f.name == "run" -> return "entry"
    "inferred: pure / no Browser effect"
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:435
fn effects_show(effects: EffectSet) -> String {
    names := effects.map(fn(e) { e.as_str() }).collect()
    &names.sort()
    if names.is_empty() -> "(pure)" else -> names.join(", ")
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:446
fn format_partition_report(metas: [FuncWebMeta], partitions: [String:WebBucket], solved: [String:EffectSet]) -> String {
    lines := ["Web partition report", "================================"]
    rows := metas.iter().collect()
    &rows.sort_by(fn(a, b) { a.key.compare(b.key) })
    loop f in rows {
        bucket :: partitions.get(f.key) ?? WebBucket.Wasm
        effects :: solved.get(f.effect_key) ?? EffectSet{}
        &lines.push("{f.name:<24} -> {bucket.name():<4}  {reason_show(f, effects)}  effects: {effects_show(effects)}")
    }
    &lines.push("")
    lines.join("\n")
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:472
fn check_abi_export(f: FuncWebMeta, idx: ABITypeIndex, diags: &[Diagnostic]) {
    if f.marker != Val(WebPartitionMarker.WasmExport) -> return
    loop p in f.params {
        if !is_abi_safe_type_full(p, idx) -> &diags.push(Syntax.web_abi_type(type_show(p), "on a `#WasmExport` parameter", Val(f.name_span)))
    }
    if f.return_type == .Val(ret) {
        if !is_abi_safe_type_full(ret, idx) -> &diags.push(Syntax.web_abi_type(type_show(ret), "as a `#WasmExport` return type", Val(f.name_span)))
    }
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:496
fn check_target_browser(f: FuncWebMeta, bucket: WebBucket, effects: EffectSet, diags: &[Diagnostic]) {
    if bucket == WebBucket.Wasm && effect_set_has_root(effects, Effect.Browser) -> &diags.push(Syntax.web_target_browser(f.name, Val(f.name_span)))
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:513
fn app_web_callback_names(bundle: ProgramBundle) -> [String:Bool] {
    graph :: App.extract_app_graph(bundle).0 ?? return [:]
    callbacks := [String:Bool]{}
    insert :: fn(name: String) {
        if !name.is_empty() && !name.starts_with('<') -> callbacks[name] = true
    }
    loop route in graph.routes {
        insert(route.handler)
        if route.loader == .Val(loader) -> insert(loader.handler)
        if route.boundaries.pending == .Val(handler) -> insert(handler)
        if route.boundaries.not_found == .Val(handler) -> insert(handler)
        if route.boundaries.error == .Val(handler) -> insert(handler)
    }
    loop action in graph.actions -> insert(action.handler)
    loop mount in graph.mounts -> insert(mount.handler)
    callbacks
}
// Rust: crates/jet-sema/src/Sema/WebPartition.rs:549
fn check_web_partition(bundle: &ProgramBundle, summaries: [String:EffectSummary], solved: [String:EffectSet]) -> [Diagnostic] {
    metas := [FuncWebMeta][]
    loop (module_idx, module) in bundle.modules -> collect_funcs(module.items, module.web_target_ceiling, None, None, module.alias, module_idx == bundle.entry, &metas)
    partitions := [String:WebBucket]{}
    loop f in metas {
        effects :: solved.get(f.effect_key) ?? EffectSet{}
        partitions[f.key] = checked_web_bucket(f.marker, f.ceiling, effects, f.return_type)
    }
    // App callback values are JS roots, unless an explicit ceiling overrides them.
    if web_partition_active(bundle) {
        app_callbacks :: app_web_callback_names(bundle)
        loop f in metas {
            if app_callbacks.has_key(f.name) && f.marker == None && f.ceiling == None -> partitions[f.key] = WebBucket.JS
        }
    }
    // Index the first match used by Rust's propagation scans.
    first_by_effect := [String:Int]{}
    loop (i, meta) in metas { if !first_by_effect.has_key(meta.effect_key) -> first_by_effect[meta.effect_key] = i }
    loop {
        changed := false
        loop (caller_key, summary) in summaries {
            caller_meta :: metas[first_by_effect.get(caller_key) ?? next]
            caller_bucket :: partitions.get(caller_meta.key) ?? WebBucket.Wasm
            loop callee_key in summary.edges {
                callee_meta :: metas[first_by_effect.get(callee_key) ?? next]
                callee_bucket :: partitions.get(callee_meta.key) ?? WebBucket.Wasm
                if caller_bucket == WebBucket.Wasm && callee_bucket == WebBucket.JS && caller_meta.marker == None && caller_meta.ceiling == None {
                    if partitions.get(caller_meta.key) != Val(WebBucket.JS) {
                        partitions[caller_meta.key] = WebBucket.JS
                        changed = true
                    }
                } else if caller_bucket == WebBucket.JS && callee_bucket == WebBucket.Wasm && callee_meta.marker == None && callee_meta.ceiling == None {
                    if partitions.get(callee_meta.key) != Val(WebBucket.JS) {
                        partitions[callee_meta.key] = WebBucket.JS
                        changed = true
                    }
                }
            }
        }
        if !changed -> break
    }
    bundle.web_partitions = partitions.clone()
    if bundle.web_partition_enforced -> bundle.web_partition_report = Val(format_partition_report(metas, partitions, solved))
    if !web_partition_active(bundle) -> return []
    abi_idx :: ABITypeIndex.from_bundle(bundle)
    diags := [Diagnostic][]
    loop f in metas {
        effects :: solved.get(f.effect_key) ?? EffectSet{}
        bucket :: partitions.get(f.key) ?? WebBucket.Wasm
        check_abi_export(f, abi_idx, &diags)
        check_target_browser(f, bucket, effects, &diags)
    }
    // Rust's collected map uses the last duplicate for crossing diagnostics.
    meta_by_effect_key := [String:Int]{}
    loop (i, meta) in metas -> meta_by_effect_key[meta.effect_key] = i
    loop (caller_key, summary) in summaries {
        caller_meta :: metas[meta_by_effect_key.get(caller_key) ?? next]
        caller_bucket :: partitions[caller_meta.key]
        loop callee_key in summary.edges {
            callee_meta :: metas[meta_by_effect_key.get(callee_key) ?? next]
            callee_bucket :: partitions[callee_meta.key]
            if caller_bucket != callee_bucket {
                wasm_export_bridge :: caller_bucket == WebBucket.JS && callee_bucket == WebBucket.Wasm && callee_meta.marker == Val(WebPartitionMarker.WasmExport)
                if wasm_export_bridge -> next
                &diags.push(Syntax.web_cross_partition(caller_meta.key, callee_meta.name, caller_bucket, callee_bucket, Val(caller_meta.name_span)))
            }
        }
    }
    diags
}
