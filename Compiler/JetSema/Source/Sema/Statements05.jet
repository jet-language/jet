    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:2719-2879
    fn declare_source_loop_vars(self: &Self, var: String, var_span: Span, var2: NamedSpan?, coll_ty: Type?, collection: Expr, bindingless: Bool, nested_bindingless: Bool) {
        if coll_ty == {
            .Val(.List(inner)) | .Val(.FixedList(inner, _)) -> {
                if var2 == .Val(second) {
                    &self.declare_loop_var(~var, var_span, .Int)
                    &self.declare_loop_var(~second.name, second.span, inner)
                } else -> &self.declare_loop_var(~var, var_span, inner)
            }
            .Val(.Apply(name, args)) && (name == Syntax.TYPE_ITER || name == Syntax.TYPE_VIEW_ITER) && args.len() == 1 -> &self.declare_loop_var(~var, var_span, args[0])
            .Val(.Map(key, _, value)) -> {
                if var2 == .Val(second) {
                    &self.declare_loop_var(~var, var_span, key)
                    &self.declare_loop_var(~second.name, second.span, value)
                } else -> &self.declare_loop_var(~var, var_span, .Tuple([TypeTupleField{name: "key", ty: ~key}, TypeTupleField{name: "value", ty: ~value}]))
            }
            .Val(.Named(n)) && (n == "FileLines" || n == "StdinLines" || n == "ProcessLines") -> &self.declare_loop_var(~var, var_span, .String)
            .Val(.Named(n)) && n == Syntax.TYPE_RANGE -> {
                if var2 != None -> &self.diags.push(Diagnostic.error("E0109", "a Range loop has one value per step", "Range values yield whole numbers, not key-value pairs", "use one loop name", .Val(expr_span(collection))))
                &self.declare_loop_var(~var, var_span, .Int)
            }
            .Val(.Named(n)) && n == "HTTPBodyChunks" -> &self.declare_loop_var(~var, var_span, .Result(.List(.Named("U8")), .Named("HTTPError")))
            .Val(.Named(n)) && encoding_reader_item_type(n) != None -> {
                if var2 != None -> &self.diags.push(Diagnostic.error("E0109", "`loop (x, y) in` on `{n}` needs one loop name, not two", "a codec reader yields one item per step", "write `loop item in {n}`", .Val(expr_span(collection))))
                else if encoding_reader_item_type(n) == .Val(item_ty) -> &self.declare_loop_var(~var, var_span, item_ty)
            }
            .Val(.Named(n)) && self.trait_reg.iterable_items.contains_key(n) -> {
                if var2 != None -> &self.diags.push(Diagnostic.error("E0109", "`loop (x, y) in` on `{n}` needs one loop name, not two", "a custom iterable yields one item per step", "write `loop item in {n}`", .Val(expr_span(collection))))
                else -> &self.declare_loop_var(~var, var_span, self.trait_reg.iterable_items.get(n) ?? .Int)
            }
            .Val(.Apply(name, args)) && (name == Syntax.TYPE_STREAM || name == Syntax.TYPE_RECEIVER) && args.len() == 1 -> &self.declare_loop_var(~var, var_span, args[0])
            .Val(.Apply(name, args)) && (name == "View" || name == "ViewMut") && args.len() == 1 -> {
                if var2 == .Val(second) {
                    &self.declare_loop_var(~var, var_span, .Int)
                    &self.declare_loop_var(~second.name, second.span, args[0])
                } else -> &self.declare_loop_var(~var, var_span, args[0])
            }
            .Val(other) -> {
                if bindingless {
                    if !nested_bindingless -> &self.diags.push(Diagnostic.from_row("E0380", [], .Val(expr_span(collection))))
                } else {
                    &self.diags.push(Diagnostic.error("E0109", "`for x in` needs a list or map, not {type_show(other)}", "walk items with `loop item in items {{ }}` or characters with `loop c in s.chars() {{ }}`", "use a `List`, `Map`, or `s.chars()`", .Val(expr_span(collection))))
                    &self.declare_invalid_loop_vars(var, var_span, var2)
                }
            }
            None -> &self.declare_invalid_loop_vars(var, var_span, var2)
        }
    }
