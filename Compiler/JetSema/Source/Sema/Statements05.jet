    fn check_stmt_while(self: &Self, cond: &Expr, body: &[Stmt], span: Span, arrow_body: Bool, label: NamedSpan?) {
        memory_multiplier :: self.memory_control_multiplier
        &self.lint_shared_busy_wait(cond, body, span, label == None)
        self.memory_control_multiplier = None
        &self.require_bool(cond, "a `loop` condition")
        if label == .Val(label) -> &self.declare_loop_label(label.name, label.span)
        &self.push_loop_value_frame(label)
        &self.push_loop_break_frame()
        self.loop_depth += 1
        before_loop :: ~self.flow
        previous_arrow :: self.arrow_loop_body
        self.arrow_loop_body = arrow_body
        &self.check_block(body, true)
        self.arrow_loop_body = previous_arrow
        after_body :: ~self.flow
        always_true :: if cond.without_parens() == { .Bool(value, _) -> value; else -> false }
        &self.join_loop_flow(before_loop, after_body, !always_true)
        self.loop_depth -= 1
        if after_body.reachable {
            if drained_collection(cond, body) == .Val((name, span)) && self.lookup(name).is_some_and(fn(info) { self.type_is_single_use(info.ty) }) -> &self.mark_moved_by(name, span, ".loop()")
        }
        &self.pop_loop_value_frame()
        if label != None -> _ :: &self.loop_labels.pop()
        self.memory_control_multiplier = memory_multiplier
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:2440-2924
    fn check_stmt_for(self: &Self, var: String, var_span: Span, var2: NamedSpan?, kind: &ForKind, body: &[Stmt], arrow_body: Bool, label: NamedSpan?, auto_vectorization: &AutoVectorizationFacts?) {
        memory_multiplier :: self.memory_control_multiplier
        loop_multiplier :: memory_multiplier.and_then(fn(outer) { statically_bounded_for_iterations(kind).and_then(fn(iterations) { outer.checked_mul(iterations) }) })
        self.memory_control_multiplier = memory_multiplier
        if label == .Val(label) -> &self.declare_loop_label(label.name, label.span)
        before_loop :: ~self.flow
        &self.push_loop_value_frame(label)
        &self.push_loop_break_frame()
        if kind == {
            .Range(start, end, step, exclusive) -> &self.check_for_range(var, var_span, kind, &start, &end, &step, exclusive, body, arrow_body, loop_multiplier, auto_vectorization)
            .In(collection, step) -> &self.check_for_source(var, var_span, var2, &collection, &step, body, arrow_body, loop_multiplier)
        }
        &self.pop_loop_value_frame()
        after_body :: ~self.flow
        &self.join_loop_flow(before_loop, after_body, true)
        if label != None -> _ :: &self.loop_labels.pop()
        self.memory_control_multiplier = memory_multiplier
    }
