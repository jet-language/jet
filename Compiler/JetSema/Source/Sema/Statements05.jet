    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:1158-1336
    // True means preparation completed the statement (including any recursive
    // desugared statement); false means the parent's variant dispatch must run.
    fn check_stmt_inner_prepare(self: &Self, stmt: &Stmt) -> Bool {
        // Shared read/modify/write stays inside one lock, before += expansion.
        if &self.desugar_shared_field_write(stmt) {
            &self.check_stmt_inner(stmt)
            return true
        }
        if &self.take_statement_rule_fact(stmt_span(stmt)) == .Val(marker) {
            allow_names := [String]{}
            if marker.name == Syntax.MARKER_ALLOW {
                loop argument in marker.expr_args() { if argument == .Ident(name, _) -> &allow_names.push(~name) }
            }
            marker_args :: marker.expr_args_owned()
            if &self.validate_rule_signature(&marker) == .Val(arguments) {
                if marker.name == Syntax.MARKER_ALLOW -> &self.statement_lint_allows.extend(^allow_names)
                text :: if arguments.constant_for_source(0) == { .Val(.Str(value)) -> .Val(~value); else -> None }
                first :: if marker_args.is_empty() -> None else -> .Val(~marker_args[0])
                if stmt == {
                    .Unsafe(audit, audit_expr, _, _) -> {
                        if marker.name == Syntax.KW_UNSAFE { audit = text; audit_expr = first }
                    }
                    .Impure(reason, reason_expr, _, _) -> {
                        if marker.name == Syntax.KW_IMPURE { reason = text; reason_expr = first }
                    }
                    .AssumeDet(reason, reason_expr, _, _) -> {
                        if marker.name == Syntax.MARKER_NONDETERMINISTIC {
                            if text == .Val(text) -> reason = text
                            if first == .Val(argument) -> reason_expr = argument
                        }
                    }
                    else -> {}
                }
            }
        }
        control_span :: if stmt == {
            .While(_, _, span, _, _) | .For(_, _, _, _, _, span, _, _, _) | .Loop(_, span, _, _) | .CountedLoop(_, _, _, _, span, _, _) -> .Val(span)
            else -> None
        }
        if control_span == .Val(span) {
            &self.fx_memory_unbounded_control.push(span)
            loop region in &self.memory_policy_stack -> &region.unbounded_control.push(span)
        }
        if stmt == .Assign(.Field(base, field, span), .Val(op), _, value) && self.compound_nested_hook(base, field, op) {
            &self.diags.push(Diagnostic.error("E0362", "compound assignment can't target a nested operator field", "the current operator-place lowering supports one named owner and one field", "bind the inner value, update it, then assign the whole inner value back", .Val(span)))
            saved_expected :: ~self.expected_type
            if self.compound_field_type(base, field) == .Val(place_ty) -> self.expected_type = .Val(place_ty)
            _ :: &self.infer(&value)
            self.expected_type = saved_expected
            return true
        }
        if stmt == .Assign(target, None, op_span, value) {
            if prefer_compound_assign(target, value) == .Val((place, bin_op, compound)) && !self.compound_assign_rejected(target, bin_op) -> &self.diags.push(Diagnostic.from_row("L0503", [("place", place), ("op", compound)], .Val(op_span)))
        }
        compound := None as (Expr, Span, BinOp)?
        if stmt == {
            .Assign(.Local(name, name_span), .Val(op), _, _) -> {
                ty := None as Type?
                if self.lookup(name) == .Val(info) -> ty = .Val(~info.ty)
                else if self.is_global_mutable_binding(name) -> ty = self.consts.get(name)
                trait_name :: if op == { .Add -> .Val(Syntax.TRAIT_ADD); .Sub -> .Val(Syntax.TRAIT_SUB); .Mul -> .Val(Syntax.TRAIT_MUL); .Div -> .Val(Syntax.TRAIT_DIV); else -> None }
                if ty == .Val(ty) && trait_name == .Val(trait_name) && self.compound_type_implements(ty, trait_name) -> compound = .Val((.Ident(~name, name_span), name_span, op))
            }
            .Assign(.Field(base, field, span), .Val(op), _, _) -> {
                eligible :: if base == { .Ident(_, _) | .Index(_, _, _, _) -> true; else -> false }
                if eligible && self.compound_field_type(base, field) == .Val(field_ty) {
                    indexed :: if base == { .Index(_, _, _, _) -> true; else -> false }
                    named :: if field_ty == { .Named(_) | .Apply(_, _) -> true; else -> false }
                    if !(indexed && named) {
                        trait_name :: if op == { .Add -> .Val(Syntax.TRAIT_ADD); .Sub -> .Val(Syntax.TRAIT_SUB); .Mul -> .Val(Syntax.TRAIT_MUL); .Div -> .Val(Syntax.TRAIT_DIV); else -> None }
                        if trait_name == .Val(trait_name) && self.compound_type_implements(field_ty, trait_name) -> compound = .Val((.Field(~base, ~field, span), span, op))
                    }
                }
            }
            else -> {}
        }
        if compound == .Val((left, span, binary_op)) && stmt == .Assign(_, op, _, value) {
            rhs :: ^value
            value = .Binary(binary_op, ^left, ^rhs, span)
            op = None
        }
        false
    }

    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:1338-1341
    fn check_stmt_val(self: &Self, binding: &Binding) {
        &self.check_binding(binding)
        record_authority_alias(self, binding)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:1342-2122
    fn check_stmt_assignment(self: &Self, target: &LValue, op: BinOp?, value: &Expr) {
        is_compound :: op != None
        if op == .Val(compound_op) && target == .Index(_, _, span, _) {
            &self.diags.push(Diagnostic.from_row("E0164", [("op", compound_op.spell())], .Val(span)))
            saved_expected :: ~self.expected_type
            if &self.lvalue_type(target) == .Val(place_ty) -> self.expected_type = .Val(place_ty)
            _ :: &self.infer(value)
            self.expected_type = saved_expected
            return
        }
        origin_write_root :: if target == {
            .Local(name, _) -> .Val(~name)
            .Field(base, _, _) | .Index(base, _, _, _) -> expr_root_ident(base)
        }
        if target == .Local(name, _) -> &self.mark_local_write(name)
        &self.check_lvalue_change(target, "be assigned")
        &self.validate_shared_guard_lvalue(target)
        saved_expected :: ~self.expected_type
        place_ty :: &self.lvalue_type(target)
        if place_ty == .Val(place_ty) -> self.expected_type = .Val(~place_ty)
        vt := &self.infer(value)
        self.expected_type = saved_expected
        &self.report_lending_view_escape(value, "replace another value")
        if vt == .Val(source) && place_ty == .Val(target_ty) && source != target_ty && source.numeric_widening_to(target_ty) != None {
            &self.widen_numeric_expr(value, source, target_ty)
            vt = .Val(~target_ty)
        }
        if !is_compound {
            if vt == .Val(source) && contains_expiring_secret_loan(source) -> &self.diags.push(Diagnostic.error("E0201", "an ExpiringSecret loan cannot replace an owned value", "the callback parameter is a temporary read-only loan that ends when `.with` returns", "use the loan inside the callback and assign only a non-secret result", .Val(expr_span(value))))
            &self.reject_borrowed_param_subplace(value, vt, "replace an owned value")
            if value == .Ident(name, span) {
                borrowed :: if self.lookup(name) == {
                    .Val(info) -> !type_is_copy(info.ty) && (info.param_conv == .Val(.Read) || info.param_conv == .Val(.Write))
                    else -> false
                }
                if borrowed {
                    source_ty :: self.lookup(name).map(fn(info) { ~info.ty })
                    diagnostic :: Diagnostic.error("E0120", "`{name}` was not moved here, so it cannot replace an owned value", "this function has read access only and does not own the value", "copy it explicitly with `{Syntax.SIGIL_COPY}{name}`", .Val(span))
                    &self.diags.push(self.with_ownership_copy_edit(diagnostic, span, source_ty))
                }
            }
            if vt == .Val(source) && place_ty == .Val(target_ty) {
                if &self.lift_optional_slot(target_ty, source, value) == .Val(lifted) -> vt = .Val(lifted)
            }
        }
        &self.note_move_if_direct_ident(value, "the assignment")
        if target == .Local(name, name_span) && self.flow.uninit.contains(name) {
            if is_compound -> &self.diags.push(Diagnostic.error("E0420", "`{name}` may be read before it is given a value", "`{name}+=` reads `{name}` first, but it was declared with `Type{{ uninit }}` and has no value yet", "give `{name}` a value with `{name} = …` before updating it", .Val(name_span)))
            _ :: &self.flow.uninit.remove(name)
        }
        if target == {
            .Local(name, name_span) -> {
                if &self.check_assignment_local(name, name_span, is_compound, vt, value) -> return
            }
            .Index(base, index, span, kind) -> {
                if &self.check_assignment_index(&base, &index, span, &kind, is_compound, vt, value) -> return
            }
            .Field(base, field, span) -> {
                if &self.check_assignment_field(&base, field, span, is_compound, vt, value) -> return
            }
        }
        // RHS reads observe old provenance; only after the successful write is it cleared.
        if origin_write_root == .Val(root) -> &self.clear_origin(root)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:1470-1594
    fn check_assignment_local(self: &Self, name: String, name_span: Span, is_compound: Bool, vt: Type?, value: &Expr) -> Bool {
        if self.lambda_mut_borrow_active(name) -> &self.diags.push(aliasing_while_mut(name, name_span))
        self.lookup(name) == .Val(info_ref) ?? {
            if self.is_global_mutable_binding(name) -> return true
            if self.consts.contains_key(name) -> &self.diags.push(Diagnostic.error("E0111", "`{name}` is a const and can never change", "a const is fixed for the whole program", "use a `{Syntax.SIGIL_BIND_MUT}` binding if it needs to change", .Val(name_span)))
            else -> &self.unknown_name(name, name_span)
            return true
        }
        info :: ~info_ref
        target_was_frozen :: self.frozen_for(name) != None
        if !info.mutable && !self.is_write_view(name) && !target_was_frozen {
            what :: if info.param_conv != None -> "the parameter `{name}` can't be changed here" else -> "`{name}` was made with `{Syntax.SIGIL_BIND_IMMUT}`, so it can't change"
            fix :: if info.param_conv != None -> "mark the parameter `{name}: {Syntax.SIGIL_WRITE}{type_name(info.ty)}` with the write-access marker `&` if the function should change it" else -> "declare it with `{name} {Syntax.SIGIL_BIND_MUT} ...` instead"
            diagnostic := Diagnostic.error("E0111", what, "only `{Syntax.SIGIL_BIND_MUT}` bindings and parameters marked with the write-access marker `&` can be changed", fix, .Val(name_span))
            if info.binding_sigil_span == .Val(sigil_span) -> diagnostic = diagnostic.with_edit(TextEdit{span: sigil_span, new_text: Syntax.SIGIL_BIND_MUT})
            &self.diags.push(^diagnostic)
        }
        &self.clear_moved_binding(name)
        if !target_was_frozen && !is_compound && vt != None {
            depth :: self.binding_fact_depth(name) ?? self.scope_depth()
            if self.frozen_expr_site(value) == .Val(site) -> &self.flow.frozen.set_at(name, depth, site)
            else -> &self.flow.frozen.remove_at(name, depth)
        }
        is_fn :: if info.ty == { .Fn(_, _, _, _, _, _) -> true; else -> false }
        if is_fn {
            sendable :: !is_compound && vt.is_some_and(fn(value_ty) { self.interrupt_callback_expr_sendable(value, value_ty) }) && info.param_conv == None
            &self.set_interrupt_sendable(name, sendable)
        }
        if vt == .Val(vt) && !info.invalid && info.ty != .Named("") {
            if is_deterministic_clock_type(info.ty) && !is_deterministic_clock_type(vt) -> &self.diags.push(e3403("replacing a deterministic Clock with an unproven Clock", .Val(expr_span(value))))
            if vt != info.ty -> &self.diags.push(Diagnostic.error("E0108", "`{name}` holds {type_show(info.ty)}, but this value is {type_show(vt)}", "a binding keeps one type for its whole life", division_fix_hint(info.ty, vt, value), .Val(expr_span(value))))
        }
        false
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:1596-1946
    // True preserves an early exit from the enclosing assignment arm.
    fn check_assignment_index(self: &Self, base: &Expr, index: &Expr, span: Span, kind: &IndexKind, is_compound: Bool, vt: Type?, value: &Expr) -> Bool {
        fixed_uninit := None as (String, UninitState)?
        if !is_compound && base == .Ident(name, _) {
            if &self.flow.uninit.remove(name) == .Val(state) -> fixed_uninit = .Val((~name, state))
        }
        self.borrow_ctx = true
        base_ty :: &self.infer(base)
        idx_ty :: &self.infer(index)
        if base_ty == {
            .Val(.Map(_, _, _)) -> kind = .Map
            .Val(.List(_)) | .Val(.FixedList(_, _)) -> kind = .List
            .Val(.Apply(name, _)) && name == "ViewMut" -> kind = .List
            .Val(.Named(n)) && self.trait_reg.index_types.contains_key(n) -> kind = .User(~n)
            .Val(.Apply(name, pool_args)) && name == "Pool" -> {
                kind = .Pool
                matching :: if idx_ty == { .Val(.Apply(name, id_args)) -> name == "ID" && id_args.first() == pool_args.first(); else -> false }
                if !matching -> &self.diags.push(Diagnostic.error("E0112", "`Pool` indexes need a matching `ID<T>`, not {idx_ty.map(type_show) ?? "this"}", "a pool slot is only reached through the `ID<T>` its own `.add()` returned", "index with the `ID<T>` handle from `.add(...)`", .Val(expr_span(index))))
            }
            else -> {}
        }
        if base_ty == .Val(.List(.Named(elem))) && self.registry.is_columnar(elem) {
            &self.diags.push(Diagnostic.error("E1108", "writing through `[ ]` isn't supported on a columnar list `{type_show(base_ty ?? panic("known list"))}` yet", "`#Layout(columnar)` lists support reading in v1 (indexing, field access, `len`, `is_empty`, `push`, iteration); index-write is deferred", "drop `#Layout(columnar)` from `{elem}` to assign through `[ ]`, or rebuild the list with `push`", .Val(span)))
            return true
        }
        base_is_pool :: if base_ty == { .Val(.Apply(name, _)) -> name == "Pool"; else -> false }
        base_is_view_mut :: if base_ty == { .Val(.Apply(name, _)) -> name == "ViewMut"; else -> false }
        base_has_write_view :: expr_root_ident(base).is_some_and(fn(name) { self.is_write_view(name) })
        collection :: if base_ty == { .Val(.Map(_, _, _)) | .Val(.List(_)) | .Val(.FixedList(_, _)) -> true; else -> false }
        if base_is_pool || base_is_view_mut || collection {
            if expr_root_ident(base) == .Val(root) {
                if self.iter_borrowed.contains(root) -> &self.diags.push(collection_changed_in_loop(root, span))
                if self.lookup(root) == .Val(info) && !base_is_view_mut && !base_has_write_view && !info.mutable && self.frozen_for(root) == None {
                    (code, why, fix) :: if info.param_conv == .Val(.Read) -> ("E0205", "an unmarked parameter gives read access only; assigning into it needs the write-access marker `&`", "change the parameter to `{root}: {Syntax.SIGIL_WRITE}{type_name(info.ty)}` with the write-access marker `&`") else -> ("E0202", "assigning into a collection edits it; the binding must be declared mutable", "declare `{root} {Syntax.SIGIL_BIND_MUT} ...`")
                    &self.diags.push(Diagnostic.error(code, "cannot write to `{root}` — it does not have the write-access marker `&`", why, fix, .Val(span)))
                }
            }
        }
        valid_int :: if idx_ty == { .Val(.Int) | .Val(.InlineRange(_, _, _)) -> true; else -> false }
        is_map :: if base_ty == { .Val(.Map(_, _, _)) -> true; else -> false }
        if !valid_int && !is_map && idx_ty == .Val(it) -> &self.diags.push(Diagnostic.error("E0505", "list indexes must be {type_show(.Int)}, not {type_show(it)}", "count positions with a whole number starting at 0", "use an Int index, like `items[0]`", .Val(expr_span(index))))
        if base_ty == {
            .Val(.Map(key, _, map_val_ty)) -> {
                if idx_ty == .Val(kt) && kt != key -> &self.diags.push(Diagnostic.error("E0505", "this map holds keys of type {type_show(key)}, not {type_show(kt)}", "the key in `map[key]` must match the map's key type", "use a {type_name(key)} key here", .Val(expr_span(index))))
                if vt == .Val(vt) && vt != map_val_ty && !self.nominal_type_identity(map_val_ty, vt) -> &self.diags.push(Diagnostic.error("E0108", "this map holds values of type {type_show(map_val_ty)}, not {type_show(vt)}", "every value stored in a map must have the same type", type_fix_hint(map_val_ty, vt), .Val(expr_span(value))))
            }
            .Val(.List(elem_ty)) | .Val(.FixedList(elem_ty, _)) -> {
                if vt == .Val(vt) && vt != elem_ty -> &self.diags.push(Diagnostic.error("E0108", "this list holds {type_show(elem_ty)}, not {type_show(vt)}", "every item stored in a list must have the same type", type_fix_hint(elem_ty, vt), .Val(expr_span(value))))
            }
            .Val(.Apply(name, args)) -> {
                if name == "ViewMut" && !args.is_empty() && vt == .Val(vt) && vt != args[0] -> &self.diags.push(Diagnostic.error("E0108", "this view holds {type_show(args[0])}, not {type_show(vt)}", "every item written through a view must keep the owner's element type", type_fix_hint(args[0], vt), .Val(expr_span(value))))
            }
            .Val(.Named(n)) -> {
                if self.trait_reg.index_types.get(n) == .Val((key_ty, value_ty)) {
                    if !self.trait_reg.index_mutable.contains(n) -> &self.diags.push(Diagnostic.error("E0505", "`{n}` can be read with `[ ]` but not written — it has no `IndexMut` impl", "bracket assignment needs `impl Type.IndexMut {{ fn set(&self, k, v) }}` with the write-access marker `&`", "use `.set(key, value)` instead, or add `impl {n}.IndexMut`", .Val(span)))
                    if idx_ty == .Val(kt) && kt != key_ty -> &self.diags.push(Diagnostic.error("E0505", "this value indexes with {type_show(key_ty)}, not {type_show(kt)}", "the key must match the type's `Index` key", "use a {type_name(key_ty)} key here", .Val(expr_span(index))))
                    if vt == .Val(vt) && vt != value_ty -> &self.diags.push(Diagnostic.error("E0108", "this value holds {type_show(value_ty)}, not {type_show(vt)}", "the stored value must match the type's `Index` value", type_fix_hint(value_ty, vt), .Val(expr_span(value))))
                    if expr_root_ident(base) == .Val(root) && self.lookup(root) == .Val(info) && !info.mutable && !self.is_write_view(root) -> &self.diags.push(Diagnostic.error("E0202", "cannot write to `{root}` — it does not have the write-access marker `&`", "assigning through `[ ]` edits the value; the binding must be declared mutable", "declare `{root} {Syntax.SIGIL_BIND_MUT} ...`", .Val(span)))
                }
            }
            .Val(.String) -> &self.diags.push(Diagnostic.error("E0503", "strings aren't indexed with `[ ]`", "text is counted in characters — walk them with `.chars()` or take a piece with `.slice(start..end)`", "e.g. `loop c in s.chars() {{ }}` or `s.slice(0..2)`", .Val(span)))
            else -> {}
        }
        if fixed_uninit == .Val((name, state)) {
            completely_initialized := false
            if state.fixed_len == .Val(len) && index == .Int(index_value, _, _, _) {
                if index_value >= 0 && U64.from_int(index_value) < len -> &state.initialized_indexes.insert(U64.from_int(index_value))
                completely_initialized = U64.from_int(state.initialized_indexes.len()) == len
            }
            if !completely_initialized -> &self.flow.uninit.set(name, ^state)
        }
        false
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:1952-2113
    fn check_assignment_field(self: &Self, base: &Expr, field: String, span: Span, is_compound: Bool, vt: Type?, value: &Expr) -> Bool {
        self.borrow_ctx = true
        if base == .Index(ib, _, _, _) {
            if expr_root_ident(ib) == .Val(root) && self.lookup(root) == .Val(info) && info.ty == .List(.Named(elem)) && self.registry.is_columnar(elem) {
                &self.diags.push(Diagnostic.error("E1108", "writing `{root}[i].{field}` isn't supported on a columnar list yet", "`#Layout(columnar)` lists support reading a field (`xs[i].f`) in v1; writing one is deferred", "drop `#Layout(columnar)` from `{elem}` to write fields in place, or rebuild the element with `push`", .Val(span)))
                return true
            }
        }
        suppress :: self.suppress_partial_move_root_read
        if !is_compound -> self.suppress_partial_move_root_read = true
        base_ty :: &self.infer(base)
        self.suppress_partial_move_root_read = suppress
        if base_ty == .Val(bt) && self.field_is_computed(bt, field) {
            &self.diags.push(computed_field_not_settable(field, span))
            return true
        }
        if base_ty == .Val(.Named(type_name)) && is_swizzleable_math_type(type_name) && !self.registry.contains(type_name) {
            if parse_swizzle_member(field, type_name) == .Ok(lanes) && swizzle_write_overlaps(lanes) {
                root :: expr_root_ident(base) ?? "v"
                &self.diags.push(Diagnostic.error("E3111", "write swizzle `{field}` repeats a lane on `{type_name}`", "each lane may be written at most once — overlapping patterns like `v.xx` have no single meaning", "assign each lane once, e.g. `{root}.xy = …` instead of `{root}.{field} = …`", .Val(span)))
                return true
            }
        }
        if base_ty == .Val(bt) && &self.field_type(bt, field, span) == .Val(ft) {
            if self.type_contains_view_boundary(ft) {
                &self.diags.push(Diagnostic.error("E2305", "view field `{field}` cannot be assigned a new source", "a stored view field has one stabilized owner relationship; overwriting it would erase or change that public provenance", "construct a new value with the new view, or keep the original field source unchanged", .Val(span)))
                return true
            }
            if vt == .Val(vt) && ft != .Named("") -> &self.check_struct_field_assignable(field, ft, vt, value, expr_span(value))
        }
