// Native OS gating folds the selected build fact, never the compiler host.
use jet_foundation.[Diagnostic, Span, BinOp, Expr, Func, Item, LambdaBody, Pattern,
    ProgramBundle, Stmt, StrPart, SwitchArm, Type, OSTarget, BuildFactSnapshot, BuildFactValue,
    expr_span, type_name, os_target_build_context, os_target_dispatch_arm,
    os_target_dispatch_exhaustive, os_target_mixed_axis, os_target_unmatched_call,
    build_setting_key, app_capability_target, app_target_supports, ASTExprVisitor, ast_stmt_for_each_expr]
use jet_sema.[resolved_app_target]

// Rust: crates/jet-sema/src/Sema/OSTarget.rs:27
pub fn desugar_os_switches(bundle: &ProgramBundle) -> [Diagnostic] Never! {
    // GATE #4483: use the selected target stored by bundle construction.
    active :: if bundle.active_os == { .Linux -> OSTarget.Linux .MacOS -> OSTarget.MacOS .Windows -> OSTarget.Windows }
    diags := [Diagnostic]{}
    loop index in 0..<bundle.modules.len() {
        desugar_items(&bundle.modules[index].items, active, bundle.build_facts, &diags)
    }
    diags
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:40
fn desugar_items(items: &[Item], active: OSTarget, build_facts: BuildFactSnapshot, diags: &[Diagnostic]) Never! {
    loop index in 0..<items.len() {
        if items[index] == {
            .Func(f) -> desugar_stmts(&f.body, active, build_facts, &diags)
            .Struct(s) -> {
                loop method in &s.methods { desugar_stmts(&method.body, active, build_facts, &diags) }
                loop block in &s.trait_impls {
                    loop method in &block.methods { desugar_stmts(&method.body, active, build_facts, &diags) }
                }
            }
            .Enum(e) -> { loop method in &e.methods { desugar_stmts(&method.body, active, build_facts, &diags) } }
            .Impl(i) -> { loop method in &i.methods { desugar_stmts(&method.body, active, build_facts, &diags) } }
            .CodeModule(module) -> { if module.body == .Val(body) -> desugar_items(&body, active, build_facts, &diags) }
            .GenericModule(module) -> desugar_items(&module.body, active, build_facts, &diags)
            else -> {}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:85
fn desugar_stmts(stmts: &[Stmt], active: OSTarget, build_facts: BuildFactSnapshot, diags: &[Diagnostic]) Never! {
    loop index in 0..<stmts.len() {
        if stmts[index] == .ComptimeSwitch(_, arms, else_body, _) {
            loop arm in &arms { desugar_stmts(&arm.body, active, build_facts, &diags) }
            if else_body == .Val(body) -> desugar_stmts(&body, active, build_facts, &diags)
            taken :: core.mem.replace(&stmts[index], Stmt.Break{span: Span.new(0, 0)})
            stmts[index] = fold_switch(^taken, active, build_facts, &diags)
        } else {
            desugar_child_blocks(&stmts[index], active, build_facts, &diags)
        }
    }
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:116
fn desugar_child_blocks(stmt: &Stmt, active: OSTarget, build_facts: BuildFactSnapshot, diags: &[Diagnostic]) Never! {
    if stmt == {
        .Expr(e) | .Yield(e, _) | .DeferClose(e, _) -> desugar_expr(&e, active, build_facts, &diags)
        .Val(binding) -> desugar_expr(&binding.init, active, build_facts, &diags)
        .Assign(_, _, _, value) -> desugar_expr(&value, active, build_facts, &diags)
        .Return(.Val(e), _) -> desugar_expr(&e, active, build_facts, &diags)
        .While(_, body, _, _, _) | .For(_, _, _, _, body, _, _, _, _) -> desugar_stmts(&body, active, build_facts, &diags)
        .Switch(_, arms, else_body, _) -> {
            loop arm in &arms { desugar_stmts(&arm.body, active, build_facts, &diags) }
            if else_body == .Val(body) -> desugar_stmts(&body, active, build_facts, &diags)
        }
        .CountedLoop(_, _, step, body, _, _, _) -> {
            if step == .Val(value) -> desugar_child_blocks(&value, active, build_facts, &diags)
            desugar_stmts(&body, active, build_facts, &diags)
        }
        .Loop(body, _, _, _) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _) |
        .Reactive(body, _) | .Region(_, _, body, _) | .Policy(_, body, _) |
        .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) |
        .Transact(_, _, body, _, _) | .AssumeDet(_, _, body, _) | .ComptimeBlock(body, _, _) |
        .Live(body, _) | .ScopeMember(_, _, _, _, body, _, _, _) | .ContextBlock(_, body, _) ->
            desugar_stmts(&body, active, build_facts, &diags)
        .ComptimeIf(_, _, then_body, else_body, _, _) -> {
            desugar_stmts(&then_body, active, build_facts, &diags)
            if else_body == .Val(body) -> desugar_stmts(&body, active, build_facts, &diags)
        }
        else -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:179
fn desugar_expr(e: &Expr, active: OSTarget, build_facts: BuildFactSnapshot, diags: &[Diagnostic]) Never! {
    if e == {
        .Lambda(lambda) -> { if lambda.body == .Block(body) -> desugar_stmts(&body, active, build_facts, &diags) }
        .If(_, then_body, _, else_body, _, _) -> {
            desugar_stmts(&then_body, active, build_facts, &diags)
            desugar_stmts(&else_body, active, build_facts, &diags)
        }
        .Paren(inner, _) -> desugar_expr(&inner, active, build_facts, &diags)
        else -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:207
fn fold_switch(sw: ^Stmt, active: OSTarget, build_facts: BuildFactSnapshot, diags: &[Diagnostic]) -> Stmt Never! {
    if ^sw == .ComptimeSwitch(subject, arms, else_body, span) {
        subject_path :: expr_path(subject)
        if subject_path == Val("$build.os") -> return fold_os_switch(^subject, ^arms, ^else_body, span, active, &diags)
        key :: build_setting_key(subject_path ?? {
            &diags.push(os_target_build_context(Val(expr_span(subject))))
            return empty_stmt(span)
        }) ?? {
            &diags.push(os_target_build_context(Val(expr_span(subject))))
            return empty_stmt(span)
        }
        setting :: build_facts.settings.get(key) ?? {
            &diags.push(Diagnostic.error("E0302", "`$build.settings.{key}` is undeclared",
                "a setting must be declared with a type and default before it can be read",
                "add `{key}: Type = default` to the package `settings: {{ … }}` block", Val(expr_span(subject))))
            return empty_stmt(span)
        }
        arm_matches := [(Bool, [Stmt], Span)]{}
        loop arm in ^arms {
            matches :: setting_arm_matches(arm.cond, subject, setting.value) ?? {
                &diags.push(Diagnostic.error("E0302", "invalid arm for `$build.settings.{key}`",
                    "typed settings dispatch compares one setting with a literal value",
                    "use a literal arm or compare `{key}` with a Bool, Int, Char, String, or enum value", Val(arm.span)))
                return empty_stmt(span)
            }
            &arm_matches.push((matches, ^arm.body, arm.span))
        }
        tail := ^else_body
        loop !arm_matches.is_empty() {
            (matches, body, arm_span) :: &arm_matches.pop() ?? panic("nonempty arm list")
            node :: Stmt.ComptimeIf{cond: Expr.Bool{value: matches, span: arm_span}, cond_span: arm_span,
                then_body: ^body, else_body: ^tail, span: arm_span, selected_then: None}
            tail = Val([Stmt]{^node})
        }
        if ^tail == .Val(body) -> return &body.pop() ?? empty_stmt(span)
        return empty_stmt(span)
    }
    panic("fold_switch only called on ComptimeSwitch")
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:279
fn fold_os_switch(subject: ^Expr, arms: ^[SwitchArm], else_body: ^[Stmt]?, span: Span, active: OSTarget, diags: &[Diagnostic]) -> Stmt Never! {
    arm_os := [(OSTarget, [Stmt], Span)]{}
    seen := [OSTarget]{}
    had_error := false
    loop arm in ^arms {
        if arm_variant(arm) == .Val(os) {
            if !seen.contains(os) {
                &seen.push(os)
                &arm_os.push((os, ^arm.body, arm.span))
            } else {
                &diags.push(os_target_dispatch_arm(".{os.name()}", Val(arm.span)))
                had_error = true
            }
        } else {
            &diags.push(os_target_dispatch_arm(arm_head_text(arm.cond), Val(arm.span)))
            had_error = true
        }
    }
    if had_error -> return empty_stmt(span)
    if else_body == None {
        missing := [String]{}
        loop os in [OSTarget]{.Linux, .MacOS, .Windows} {
            if !seen.contains(os) -> &missing.push(os.name())
        }
        if !missing.is_empty() {
            &diags.push(os_target_dispatch_exhaustive(missing, Val(span)))
            return empty_stmt(span)
        }
    }
    tail := ^else_body
    loop !arm_os.is_empty() {
        (os, body, arm_span) :: &arm_os.pop() ?? panic("nonempty OS arm list")
        node :: Stmt.ComptimeIf{cond: Expr.Bool{value: os == active, span: arm_span}, cond_span: arm_span,
            then_body: ^body, else_body: ^tail, span: arm_span, selected_then: None}
        tail = Val([Stmt]{^node})
    }
    if ^tail == .Val(body) -> return &body.pop() ?? empty_stmt(span)
    empty_stmt(span)
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:351
fn expr_path(expr: Expr) -> String? Never! {
    if expr == {
        .Ident(name, _) | .ComptimeName(name, _, _) -> Val(~name)
        .Field(base, member, _) -> {
            path :: expr_path(base) ?? return None
            Val("{path}.{member}")
        }
        else -> None
    }
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:359
fn setting_arm_matches(cond: Expr, subject: Expr, value: BuildFactValue) -> Bool? Never! {
    if cond == {
        .Binary(op, lhs, rhs, _) && (op == .Eq || op == .Ne) -> {
            if expr_path(lhs) != expr_path(subject) -> return None
            literal :: setting_literal(rhs) ?? return None
            equal :: setting_values_equal(literal, value) ?? return None
            Val(if op == .Eq -> equal else -> !equal)
        }
        .PatternTest(lhs, .Variant(variant, bindings, _, _), _) && expr_path(lhs) == expr_path(subject) && bindings.is_empty() -> {
            if value == { .Enum(_, actual) -> Val(variant == actual) else -> None }
        }
        else -> {
            literal :: setting_literal(cond) ?? return None
            setting_values_equal(literal, value)
        }
    }
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:389
fn setting_literal(expr: Expr) -> BuildFactValue? Never! {
    if expr == {
        .Bool(value, _) -> Val(BuildFactValue.Bool{value: value})
        .Int(value, _, _, _) -> Val(BuildFactValue.Int{value: value})
        .Char(value, _) -> {
            scalar :: value.chars().next() ?? return None
            Val(BuildFactValue.Char{value: scalar})
        }
        .Str(parts, _) -> {
            loop part in parts { if part != .Lit(_) -> return None }
            text := String.new()
            loop part in parts { if part == .Lit(fragment) -> &text.push_str(fragment) }
            Val(BuildFactValue.Text{value: text})
        }
        .EnumLit(type_name, variant, _, args, _, _) && args.is_empty() -> Val(BuildFactValue.Enum{type_name: ~type_name, variant: ~variant})
        else -> None
    }
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:417
fn setting_values_equal(left: BuildFactValue, right: BuildFactValue) -> Bool? Never! {
    if (left, right) == {
        (.Bool(lhs), .Bool(rhs)) -> Val(lhs == rhs)
        (.Int(lhs), .Int(rhs)) -> Val(lhs == rhs)
        (.Char(lhs), .Char(rhs)) -> Val(lhs == rhs)
        (.Text(lhs), .Text(rhs)) -> Val(lhs == rhs)
        (.Enum(left_type, lhs), .Enum(right_type, rhs)) && (left_type.is_empty() || right_type.is_empty() || left_type == right_type) -> Val(lhs == rhs)
        else -> None
    }
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:456
fn arm_variant(arm: SwitchArm) -> OSTarget? Never! {
    if arm.cond == .PatternTest(_, .Variant(variant, bindings, _, _), _) && bindings.is_empty() -> return OSTarget.parse(variant)
    None
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:473
fn arm_head_text(cond: Expr) -> String Never! {
    if cond == {
        .PatternTest(_, pattern, _) -> if pattern == { .Variant(variant, _, _, _) -> ".{variant}" else -> "this pattern" }
        else -> "this arm head"
    }
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:483
fn empty_stmt(span: Span) -> Stmt Never! { Stmt.ComptimeBlock{body: [], is_template_loop: false, span: span} }

// Rust: crates/jet-sema/src/Sema/OSTarget.rs:507
pub fn check_os_target(bundle: ProgramBundle, no_os: Bool) -> [Diagnostic] Never! {
    diags := [Diagnostic]{}
    gate_of_type := [String:OSTarget]{}
    loop module in bundle.modules {
        loop item in module.items {
            if item != .Impl(_) -> next
            if item == .Impl(i) {
                gate_name :: i.os_target ?? next
                os :: OSTarget.parse(gate_name) ?? next
                gate_of_type[~i.type_name] = os
                if module.web_target_ceiling == .Val(bucket) {
                    label :: if i.trait_name == { .Val(t) -> "{i.type_name}.{t}" else -> ~i.type_name }
                    &diags.push(os_target_mixed_axis(label, os, bucket.name(), Val(i.type_span)))
                }
            }
        }
    }
    if !gate_of_type.is_empty() {
        loop module in bundle.modules { check_items_signatures(module.items, gate_of_type, &diags) }
    }
    check_app_capabilities(bundle, no_os, &diags)
    diags
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:545
fn check_app_capabilities(bundle: ProgramBundle, no_os: Bool, diags: &[Diagnostic]) Never! {
    loop index in 0..<bundle.modules.len() {
        target :: resolved_app_target(bundle, index, no_os)
        check_app_items(bundle.modules[index].items, target, &diags)
    }
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:552
fn check_app_items(items: [Item], target: String, diags: &[Diagnostic]) Never! {
    loop item in items {
        if item == {
            .Func(f) -> {
                own_target :: if f.web_marker == { .Val(marker) -> marker.bucket().name() else -> target }
                check_app_body(f.body, own_target, &diags)
            }
            .Impl(i) -> {
                loop method in i.methods {
                    own_target :: if method.web_marker == { .Val(marker) -> marker.bucket().name() else -> target }
                    check_app_body(method.body, own_target, &diags)
                }
            }
            .Struct(s) -> {
                loop method in s.methods {
                    own_target :: if method.web_marker == { .Val(marker) -> marker.bucket().name() else -> target }
                    check_app_body(method.body, own_target, &diags)
                }
                loop trait_impl in s.trait_impls {
                    loop method in trait_impl.methods {
                        own_target :: if method.web_marker == { .Val(marker) -> marker.bucket().name() else -> target }
                        check_app_body(method.body, own_target, &diags)
                    }
                }
            }
            .Enum(e) -> {
                loop method in e.methods {
                    own_target :: if method.web_marker == { .Val(marker) -> marker.bucket().name() else -> target }
                    check_app_body(method.body, own_target, &diags)
                }
                loop trait_impl in e.trait_impls {
                    loop method in trait_impl.methods {
                        own_target :: if method.web_marker == { .Val(marker) -> marker.bucket().name() else -> target }
                        check_app_body(method.body, own_target, &diags)
                    }
                }
            }
            .CodeModule(module) -> {
                if module.body == .Val(body) {
                    own_target :: if module.web_target == { .Val(bucket) -> bucket.name() else -> target }
                    check_app_items(body, own_target, &diags)
                }
            }
            .GenericModule(module) -> check_app_items(module.body, target, &diags)
            else -> {}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:640
fn check_app_body(body: [Stmt], target: String, diags: &[Diagnostic]) Never! {
    // Read-only canonical visitor avoids Rust's whole-statement clone.
    visitor := OSTargetAppVisitor{target: target, diags: &diags}
    loop original in body { ast_stmt_for_each_expr<OSTargetAppVisitor>(original, &visitor) }
}
struct OSTargetAppVisitor { target: String, diags: &[Diagnostic] }
impl OSTargetAppVisitor.ASTExprVisitor {
    fn visit(&self, expr: Expr) Never! {
        if expr == .MethodCall(_, method, method_span, _, _, _, .Val(receiver_type), _, _, _) {
            if receiver_type != "App" -> return
            required :: app_capability_target(method) ?? return
            if app_target_supports(required, self.target) -> return
            &self.diags.push(Diagnostic.from_row("E-APP-TARGET-FEATURE",
                [("feature", method), ("required", required), ("target", self.target)], Val(method_span)))
        }
    }
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:675
fn check_items_signatures(items: [Item], gate_of_type: [String:OSTarget], diags: &[Diagnostic]) Never! {
    loop item in items {
        if item == {
            .Func(f) -> check_func_sig(f, None, gate_of_type, &diags)
            .Impl(i) -> {
                own_gate := OSTarget?{None}
                if i.os_target == .Val(name) -> own_gate = OSTarget.parse(name)
                loop method in i.methods { check_func_sig(method, own_gate, gate_of_type, &diags) }
            }
            .Struct(s) -> { loop method in s.methods { check_func_sig(method, None, gate_of_type, &diags) } }
            .Enum(e) -> { loop method in e.methods { check_func_sig(method, None, gate_of_type, &diags) } }
            else -> {}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/OSTarget.rs:703
fn check_func_sig(f: Func, own_gate: OSTarget?, gate_of_type: [String:OSTarget], diags: &[Diagnostic]) Never! {
    flag :: (type_name: String) -> {
        if type_name.is_empty() -> return
        os :: gate_of_type.get(type_name) ?? return
        if own_gate == Val(os) -> return
        &diags.push(os_target_unmatched_call(f.name, type_name, os, Val(f.name_span)))
    }
    loop p in f.params { if p.ty == .Named(n) -> flag(n) }
    if f.return_type == .Val(.Named(n)) -> flag(n)
}
