// Reachability belongs to sema: canonical identities, not source spellings.
use jet_foundation.[Span, SymbolID, SymbolKind, WebPartitionMarker]

pub struct SemaCostCoverage {
    pub gaps: [String]
    pub has_roots: Bool
}

struct SemaCostCallable {
    key: String
    label: String
    name: String
    module: String
    span: Span
    definition: Span
    generated: Bool
    foreign: Bool
    root: Bool
}
fn sema_cost_callable(function: SemaRegistrationFunction, module: String, entry: String, selected: String?) -> SemaCostCallable Never! {
    source :: function.declaration
    root :: source.is_job || source.web_marker == Val(WebPartitionMarker.WasmExport) || (module == entry && source.name == (selected ?? "run"))
    SemaCostCallable{key: function.symbol.id.key, label: "{module}:{function.symbol.name}", name: source.name, module: module, span: source.span, definition: source.name_span, generated: source.compiler_generated, foreign: function.abi.is_extern, root: root}
}
fn sema_cost_edge(edges: &[String:[String]], caller: String, callee: String) Never! {
    rows := edges.get(caller) ?? [String]{}
    &rows.push(callee)
    edges[caller] = ^rows
}
// Returns every reachable non-foreign declaration lacking a complete checked
// body/specialization. Unreachable templates are not grounds for refusal.
pub fn sema_cost_coverage(registration: SemaRegistrationGraph, checked: SemaGraphResult, selected: String?) -> SemaCostCoverage {
    callables := [SemaCostCallable]{}
    positions := [String:Int]{}
    module_rows := [String:[Int]]{}
    declarations := [(module: String, start: Int, end: Int, name: String):String]{}
    loop module in registration.modules {
        first :: callables.len()
        loop function in module.functions -> &callables.push(sema_cost_callable(function, module.module_identity, registration.entry_module_identity, selected))
        loop nominal in module.nominals {
            loop function in nominal.methods -> &callables.push(sema_cost_callable(function, module.module_identity, registration.entry_module_identity, selected))
        }
        loop implementation in module.impls {
            loop function in implementation.methods -> &callables.push(sema_cost_callable(function, module.module_identity, registration.entry_module_identity, selected))
        }
        rows := [Int]{}
        loop index in first..<callables.len() {
            positions[callables[index].key] = index
            declarations[(module: callables[index].module, start: callables[index].span.start, end: callables[index].span.end, name: callables[index].name)] = callables[index].key
            &rows.push(index)
        }
        &rows.sort_by((left, right) -> (callables[left].span.start <=> callables[right].span.start).then(left <=> right))
        module_rows[module.module_identity] = ^rows
    }
    loop output in registration.output_rows {
        if !output.fact.selected -> next
        if output.fact.module_id < 0 || output.fact.module_id >= registration.modules.len() -> next
        module :: registration.modules[output.fact.module_id].module_identity
        loop index in (module_rows.get(module) ?? [Int]{}) {
            if callables[index].definition == output.fact.definition -> callables[index].root = true
        }
    }
    covered := [String:Bool]{}
    edges := [String:[String]]{}
    loop module in checked.modules {
        loop function in module.functions {
            if function.generic_params.len() > 0 -> next
            covered[function.key] = true
            // Specializations retain the source declaration's module and span.
            if declarations.get((module: function.module_identity, start: function.source_span.start, end: function.source_span.end, name: function.name)) == .Val(key) -> covered[key] = true
        }
        loop call in module.call_facts {
            if call.callee == .Val(target) -> sema_cost_edge(&edges, call.caller_key, target.key)
        }
        // Name references include stored function values and callback arguments,
        // not only direct calls. Credit generated templates independently from
        // the narrowest authored owner; their offsets may overlap authored code.
        rows :: module_rows.get(module.module_identity) ?? [Int]{}
        maximum := [Int]{}
        end := 0
        loop index in rows {
            if callables[index].span.end > end -> end = callables[index].span.end
            &maximum.push(end)
        }
        loop reference in module.name_references {
            if reference.symbol.kind != SymbolKind.Function -> next
            target :: reference.symbol.id.key
            lo := 0
            hi := rows.len()
            loop lo < hi {
                middle :: (lo + hi) /% 2
                if callables[rows[middle]].span.start <= reference.span.start -> lo = middle + 1 else -> hi = middle
            }
            best := Int?{None}
            width := 0
            loop lo > 0 {
                lo -= 1
                if maximum[lo] < reference.span.end -> break
                index :: rows[lo]
                owner :: callables[index]
                if owner.span.end < reference.span.end -> next
                if owner.generated -> sema_cost_edge(&edges, owner.key, target)
                else if best == None || owner.span.end - owner.span.start < width {
                    best = Val(index)
                    width = owner.span.end - owner.span.start
                }
            }
            if best == .Val(index) -> sema_cost_edge(&edges, callables[index].key, target)
        }
    }
    pending := [String]{}
    seen := [String:Bool]{}
    loop callable in callables { if callable.root -> &pending.push(callable.key) }
    gaps := [String]{}
    loop pending.len() > 0 {
        key :: &pending.pop() ?? break
        if seen.get(key) ?? false -> next
        seen[key] = true
        if positions.get(key) == .Val(index) {
            callable :: callables[index]
            if !callable.foreign && !(covered.get(key) ?? false) -> &gaps.push("{callable.label} (reachable sema-checked callable has no complete TIR body or specialization)")
        } else if !(covered.get(key) ?? false) && registration.callable_rows.get(key) == None {
            // Intrinsic Core operations have no source callable. A registered
            // foreign row is also a boundary, not a missing Jet body.
            if !key.starts_with("<corelib>/") -> &gaps.push("{key} (reachable typed callable has no checked declaration)")
        }
        loop target in (edges.get(key) ?? [String]{}) -> &pending.push(target)
    }
    &gaps.sort()
    SemaCostCoverage{gaps: gaps, has_roots: seen.len() > 0}
}
