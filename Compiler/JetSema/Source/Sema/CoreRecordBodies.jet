// The Core record's body packets (its section 5, schema `jet.core/v14`). The
// record is written from a finalized Core check, whose module rows hold every
// checked body with the facts all of them recorded, merged. At write time
// each row is split: every body becomes one packet, a
// SemaComptimeFunctionResult (the row a checked body travels in) that holds
// the body and the facts its own check recorded, and the row keeps only what
// belongs to no body. A compile that takes a recorded body takes its packet
// back into the seeded module's row (sema_core_body_packet_take), so that row
// grows by exactly the bodies the compile demands and their facts.
//
// A fact belongs to the body that recorded it: a call-site fact by its
// caller key; a failure row, a compute row, a comptime body source and a
// name reference by function key (a reference's `body`, so a local keeps the
// symbols it is a row of); a comptime request and a copy event by span, to
// the innermost body whose source span holds it. The hardware-use rows name
// no body and stay with the module.
//
// A graph seeded from a record reads the packets of its taken modules
// through a store the driver fills (SemaRegistrationGraph.core_bodies). A
// packet is decoded only when the finalization takes it: up front for the
// bodies a compile checks without a keyed caller, and otherwise when a
// checked or taken body names its key (CoreDemand.jet). A taken body's
// DeclIDs are rows of the record's declaration table (section 7); each row a
// taken body names is read when it is first named and mapped into the
// graph's table (sema_core_body_rebase_tree), and no other row is read.
use {
    jet_foundation.[BodyFnValueKind, BodyHostCall, BodyTree, DeclID, DeclRow, DeclTable, FnBody, ModuleID, NameTable, NodeKind, RecordReader, RecordTreeView, Span, SymbolID, SymbolTable, body_tree_pack, body_tree_unpack, decl_id_index, decl_table_add_row, decl_table_find, decl_table_index, module_text, name_find, name_index, name_intern, name_table, record_tree_row, symbol_find, symbol_table_key]
}

// `moved` split into one packet per body of `bodies` (the module's checked
// bodies, moved in), pushed to `packets` in their order. The row comes back
// with the facts no body owns and no function. The packets are complete: the
// record holds only a clean check.
sema_core_body_packets: fn(moved: &&SemaGraphModuleResult, bodies: &&[FnBody], packets: &[SemaComptimeFunctionResult]) -> SemaGraphModuleResult Never! {
    row := moved.move()
    owned := bodies.move()
    first: packets.len()
    // Each body's packet position, by the name its key interns as in `keys`.
    // Id 0 is the table's empty spelling, which names no body.
    keys := name_table()
    at := [Int]{-1}
    spans := [Span]{}
    loop function in owned {
        name: name_index(name_intern(keys, function.key))
        if name == at.len() {
            at.push(packets.len())
        } else if name > 0 {
            at[name] = packets.len()
        }
        spans.push(function.source_span.copy())
        packets.push(SemaComptimeFunctionResult{
            module_identity: row.module_identity,
            function_key: function.key.copy(),
            function: None,
            waiting_dependencies: [String]{},
            calls: [SemaComptimeRequest]{},
            reachable_function_keys: [String]{},
            call_facts: [SemaCallSiteFact]{},
            hardware_use: sema_hardware_empty_use(),
            name_references: [SemaNameReferenceFact]{},
            comptime_body_sources: [SemaComptimeBodySource]{},
            compute_facts: sema_compute_facts_empty(function.key.copy()),
            diagnostics: [Diagnostic]{},
            exact_int_reachable: row.exact_int_reachable,
            copy_events: [SemaCopyEvent]{},
            complete: true,
        })
    }
    loop owned.len() > 0 {
        function := owned.pop() ?? break
        // A body's heap, stack and frame bounds are its program's: they hang
        // on what calls it and on the denials that reach it, so the record
        // holds none, and the effect solve of each compile that takes the
        // body stamps its own (Effects/Checks.jet sema_effects_check_modules).
        function.heap = ""
        function.stack = ""
        function.frame_bound = -1
        // A body keyed "" has no name row; it fills its own packet.
        position: sema_core_body_at(keys, at, function.key) ?? first + owned.len()
        packets[position].function = Val(function)
    }
    row.functions = [FnBody]{}
    call_facts := row.call_facts.move()
    row.call_facts = [SemaCallSiteFact]{}
    loop fact in call_facts {
        if sema_core_body_at(keys, at, fact.caller_key) == .Val(position) {
            packets[position].call_facts.push(fact)
            next
        }
        row.call_facts.push(fact)
    }
    failure_facts := row.failure_facts.move()
    row.failure_facts = [SemaFunctionFailureFacts]{}
    loop facts in failure_facts {
        if sema_core_body_at(keys, at, facts.function_key) == .Val(position) {
            packets[position].failure = Val(facts)
            next
        }
        row.failure_facts.push(facts)
    }
    compute_facts := row.compute_facts.move()
    row.compute_facts = [SemaComputeFunctionFacts]{}
    loop facts in compute_facts {
        if sema_core_body_at(keys, at, facts.function_key) == .Val(position) {
            packets[position].compute_facts = facts
            next
        }
        row.compute_facts.push(facts)
    }
    sources := row.comptime_body_sources.move()
    row.comptime_body_sources = [SemaComptimeBodySource]{}
    loop source in sources {
        if sema_core_body_at(keys, at, source.function_key) == .Val(position) {
            packets[position].comptime_body_sources.push(source)
            next
        }
        row.comptime_body_sources.push(source)
    }
    requests := row.comptime_requests.move()
    row.comptime_requests = [SemaComptimeRequest]{}
    loop request in requests {
        if sema_core_body_owner(spans, request.span) == .Val(position) {
            packets[first + position].calls.push(request)
            next
        }
        row.comptime_requests.push(request)
    }
    references := row.name_references.move()
    row.name_references = [SemaNameReferenceFact]{}
    loop reference in references {
        if sema_core_body_at(keys, at, reference.body) == .Val(position) {
            packets[position].name_references.push(reference)
            next
        }
        row.name_references.push(reference)
    }
    events := row.copy_events.move()
    row.copy_events = [SemaCopyEvent]{}
    loop event in events {
        if sema_core_body_owner(spans, event.span) == .Val(position) {
            packets[first + position].copy_events.push(event)
            next
        }
        row.copy_events.push(event)
    }
    row
}

// The packet position of the body whose key is `key`, by its id in `keys`
// (`at` indexed by id, every read bounds-checked); None for a key no body
// has, the empty key (id 0) included.
sema_core_body_at: fn(keys: NameTable, at: [Int], key: String) -> Int? Never! {
    name: name_find(keys, key) ?? return None
    index: name_index(name)
    if index <= 0 || index >= at.len() || at[index] < 0 -> return None
    Val(at[index])
}

// The position in `spans` of the innermost body source span that holds
// `span`; None when none does.
sema_core_body_owner: fn(spans: [Span], span: Span) -> Int? Never! {
    owner := -1
    loop (index, body) in spans {
        if span.start < body.start || span.end > body.end -> next
        if owner < 0 || body.end - body.start < spans[owner].end - spans[owner].start -> owner = index
    }
    if owner < 0 -> return None
    Val(owner)
}

// `packet`'s body and facts appended to `row`, as the body pass appends a
// body it checked (sema_comptime_append_checked_function).
sema_core_body_packet_take: fn(row: &SemaGraphModuleResult, packet: &&SemaComptimeFunctionResult) Never! {
    owned := packet.move()
    _: sema_append_function(row.functions, owned.function.move())
    row.call_facts.extend(owned.call_facts.move())
    row.comptime_requests.extend(owned.calls.move())
    row.name_references.extend(owned.name_references.move())
    row.comptime_body_sources.extend(owned.comptime_body_sources.move())
    row.copy_events.extend(owned.copy_events.move())
    row.compute_facts.push(owned.compute_facts.move())
    failure := owned.failure.move()
    owned.failure = None
    if failure == .Val(facts) -> row.failure_facts.push(facts)
    row.exact_int_reachable = row.exact_int_reachable || owned.exact_int_reachable
}

// The body packets, taint crossing rows and effect rows a graph takes from
// its Core record, filled by the driver that opened it
// (sema_core_body_store_new).
SemaCoreBodyStore: struct {
    reader: RecordReader
    // Where the record's tree tables lie (JetFoundation RecordTree.jet).
    tree: RecordTreeView
    // The record section that holds the packets.
    section: Int
    // The record section that holds the declaration rows.
    decl_section: Int
    // The packet of each function of the modules the graph takes
    // (sema_finalize_seeded_taken), by the function's SymbolID.
    rows: [U32:SemaCoreBodyRow]
    rebase: SemaCoreDeclRebase
    // The element of each taken module's one-per-module rows (a crossing
    // row, an effect row), by its module identity, and the record sections
    // that hold the crossing rows (Taint.jet SemaCoreCrossingResult) and the
    // effect rows (CheckProgram.jet SemaCoreEffectResult).
    modules: [U32:Int]
    crossing_section: Int
    effect_section: Int
    // This finalization's: the functions it takes up front, in record
    // order, and every function it took (sema_core_body_begin).
    eager: [SymbolID]{[SymbolID]{}}
    taken: [U32:Bool]{[U32:Bool]{}}
}

// Where one packet is: its element in the store's section, and the graph
// index of the taken module whose row it joins.
SemaCoreBodyRow: struct {
    element: Int
    module_index: Int
}

// The record's declaration rows mapped into one graph's table, row by row
// as the taken bodies name them.
SemaCoreDeclRebase: struct {
    // How many declaration rows the record has: a body names DeclID `i`
    // for its row `i`.
    count: Int
    // Each record row a taken body named, by row, and its graph DeclID.
    decls: [Int:DeclID]{[Int:DeclID]{}}
    // Each key a mapped row has, and its graph DeclID. A later record row of
    // a key (a redeclaration of the same symbol, so of the same kind) maps
    // as the key's first row does.
    keys: [String:DeclID]{[String:DeclID]{}}
}

// A store over the packets `rows` of `reader`'s section `section`, tree rows
// of the tables `tree` places, whose bodies name the `decl_count`
// declaration rows of its section `decl_section`, and over the crossing and
// effect rows of its sections `crossing_section` and `effect_section`, whose
// element for each taken module `modules` holds.
sema_core_body_store_new: fn(reader: RecordReader, tree: RecordTreeView, section: Int, rows: [U32:SemaCoreBodyRow], decl_section: Int, decl_count: Int, modules: [U32:Int], crossing_section: Int, effect_section: Int) -> SemaCoreBodyStore Never! {
    SemaCoreBodyStore{reader: reader, tree: tree, section: section, rows: rows, decl_section: decl_section, rebase: sema_core_decl_rebase_new(decl_count), modules: modules, crossing_section: crossing_section, effect_section: effect_section}
}

// The crossing rows of the taken module `module_identity`, read from the
// graph's Core record; None when the graph took no such module from one. A
// row that doesn't read is a record that doesn't match this compiler.
sema_core_crossing_read: fn(graph: SemaRegistrationGraph, module_identity: ModuleID) -> SemaCoreCrossingResult? {
    if graph.core_bodies == .Val(store) {
        element: store.modules.get(module_identity.id) ?? return None
        read: record_tree_row(store.reader, store.tree, store.crossing_section, element)
        value: read.value ?? panic("the Core record has no crossing row {element}")
        crossings: value.decode<SemaCoreCrossingResult>() ?? panic("the Core record's crossing row {element} doesn't decode: {sema_core_record_field_errors(err)}")
        return Val(crossings)
    }
    None
}

// The effect rows of the taken module `module_identity`, read from the
// graph's Core record; None when the graph took no such module from one. A
// row that doesn't read, or is another module's, is a record that doesn't
// match this compiler.
sema_core_effect_read: fn(graph: SemaRegistrationGraph, module_identity: ModuleID) -> SemaCoreEffectResult? {
    if graph.core_bodies == .Val(store) {
        element: store.modules.get(module_identity.id) ?? return None
        read: record_tree_row(store.reader, store.tree, store.effect_section, element)
        value: read.value ?? panic("the Core record has no effect row {element}")
        effects: value.decode<SemaCoreEffectResult>() ?? panic("the Core record's effect row {element} doesn't decode: {sema_core_record_field_errors(err)}")
        if effects.module_identity != module_identity -> panic("the Core record's effect row {element} is another module's")
        return Val(effects)
    }
    None
}

// Whether the graph took the body of the function `symbol` from its Core
// record: a function its finalization registered (a generated codec or
// derived method the record has no body of) is not.
sema_core_body_recorded: fn(graph: SemaRegistrationGraph, symbol: SymbolID) -> Bool Never! {
    if graph.core_bodies == .Val(store) -> return store.rows.get(symbol.id) != None
    false
}

// A rebase of a record with `count` declaration rows that maps no row yet.
sema_core_decl_rebase_new: fn(count: Int) -> SemaCoreDeclRebase Never! {
    SemaCoreDeclRebase{count: count}
}

// Starts a finalization's taking: none taken yet, and up front every packet
// whose function is not `deferred` (the functions a keyed caller demands,
// sema_core_demand_index, by SymbolID), or every packet when `demand` is off.
sema_core_body_begin: fn(graph: &SemaRegistrationGraph, demand: Bool, deferred: [U32:Bool]) Never! {
    if &graph.core_bodies == .Val(store) {
        store.taken = [U32:Bool]{}
        by_element := [Int:U32]{}
        elements := [Int]{}
        loop (id, row) in store.rows {
            if demand && deferred.get(id) != None -> next
            by_element[row.element] = id
            elements.push(row.element)
        }
        elements.sort()
        store.eager = loop element in elements -> SymbolID{id: by_element[element]}
    }
}

// Takes the up-front packets of this finalization (sema_core_body_begin)
// into `modules`. Returns how many it took.
sema_core_body_take_eager: fn(graph: &SemaRegistrationGraph, modules: &[SemaGraphModuleResult]) -> Int Never! {
    ids := [SymbolID]{}
    if &graph.core_bodies == .Val(store) {
        ids = store.eager.copy()
        store.eager = [SymbolID]{}
    }
    took := 0
    loop id in ids {
        if sema_core_body_take_id(graph, modules, id) -> took += 1
    }
    took
}

// Whether the store holds a packet this finalization hasn't taken.
sema_core_body_pending: fn(graph: SemaRegistrationGraph) -> Bool Never! {
    if graph.core_bodies == .Val(store) -> return store.taken.len() < store.rows.len()
    false
}

// How many packets this finalization took.
sema_core_body_taken_count: fn(graph: SemaRegistrationGraph) -> Int Never! {
    if graph.core_bodies == .Val(store) -> return store.taken.len()
    0
}

// Takes the packet of function `key` into its module's row of `modules`,
// once per finalization: decoded from the record, its body's DeclIDs rebased
// into the graph's table, and appended as the body pass appends a body it
// checked. Returns whether it took one; a key the store doesn't hold, or
// took already, takes none. A packet that can't be read leaves its module
// incomplete, with the reason.
sema_core_body_take: fn(graph: &SemaRegistrationGraph, modules: &[SemaGraphModuleResult], key: String) -> Bool Never! {
    id: symbol_find(graph.symbols, key) ?? return false
    sema_core_body_take_id(graph, modules, id)
}

// sema_core_body_take of the function `id` names.
sema_core_body_take_id: fn(graph: &SemaRegistrationGraph, modules: &[SemaGraphModuleResult], id: SymbolID) -> Bool Never! {
    if &graph.core_bodies == .Val(store) -> return sema_core_body_take_from(store, graph.decls, graph.symbols, modules, id)
    false
}

sema_core_body_take_from: fn(store: &SemaCoreBodyStore, table: &DeclTable, symbols: SymbolTable, modules: &[SemaGraphModuleResult], id: SymbolID) -> Bool Never! {
    row: store.rows.get(id.id) ?? return false
    if store.taken.get(id.id) != None -> return false
    store.taken[id.id] = true
    key: symbol_table_key(symbols, id)
    if row.module_index < 0 || row.module_index >= modules.len() -> panic("the Core record's body `{key}` joins module {row.module_index}, which this finalization has no row for")
    identity: modules[row.module_index].module_identity
    packet := sema_core_body_read(store, table, row.element) ?? {
        modules[row.module_index].complete = false
        modules[row.module_index].incomplete_reasons.push("the Core record's body `{key}` can't be taken: {err}")
        return false
    }
    if packet.function_key != key || packet.module_identity != identity {
        modules[row.module_index].complete = false
        modules[row.module_index].incomplete_reasons.push("the Core record's body `{key}` holds `{packet.function_key}` of a module other than `{modules[row.module_index].module_name}`")
        return false
    }
    sema_core_body_packet_take(modules[row.module_index], packet)
    true
}

// `moved` as the record stores it: its body tree packed against the body's
// source start (body_tree_pack), each name reference's span written as its
// start's offset from there and its length, and the packet's own key left
// out of its name references' `body` and its call facts' `caller_key`
// (every one is the packet's, sema_core_body_packets); sema_core_body_read
// undoes all three.
sema_core_body_packet_stored: fn(moved: &&SemaComptimeFunctionResult) -> SemaComptimeFunctionResult Err! {
    packet := moved.move()
    held := packet.function.move()
    packet.function = None
    function := held.move() ?? return Ok(packet)
    base: function.source_span.start
    _: body_tree_pack(function.tree, base) ?? return Err("Core function `{packet.function_key}` can't be stored: {err}")
    loop index in 0..<packet.name_references.len() {
        span: packet.name_references[index].span
        packet.name_references[index].span = Span{start: span.start - base, end: span.end - span.start}
        if packet.name_references[index].body != packet.function_key -> return Err("Core function `{packet.function_key}` holds a name reference of `{packet.name_references[index].body}`")
        packet.name_references[index].body = ""
    }
    loop index in 0..<packet.call_facts.len() {
        if packet.call_facts[index].caller_key != packet.function_key -> return Err("Core function `{packet.function_key}` holds a call fact of `{packet.call_facts[index].caller_key}`")
        packet.call_facts[index].caller_key = ""
    }
    packet.function = Val(function.move())
    Ok(packet)
}

// The packet of element `element`, as it was before it was stored, its
// DeclIDs rebased into `table`. Each declaration row it names that no taken
// body named before is read here, and no other row.
sema_core_body_read: fn(store: &SemaCoreBodyStore, table: &DeclTable, element: Int) -> SemaComptimeFunctionResult Err! {
    packet := sema_core_body_unpacked(store, element) ?? return Err(err)
    held := packet.function.move()
    packet.function = None
    function := held.move() ?? return Err("its packet holds no body")
    loop row in sema_core_body_tree_decl_rows(function.tree) {
        if store.rebase.decls.get(row) != None -> next
        decl := sema_core_body_decl_row(store, row) ?? return Err(err)
        _: sema_core_body_rebase_row(store.rebase, table, row, decl) ?? return Err(err)
    }
    _: sema_core_body_rebase_tree(store.rebase, function.tree) ?? return Err(err)
    decl_table_index(table)
    packet.function = Val(function.move())
    Ok(packet)
}

// The packet of element `element` as it was before it was stored, its
// DeclIDs still the record's (sema_core_body_packet_stored undone).
sema_core_body_unpacked: fn(store: SemaCoreBodyStore, element: Int) -> SemaComptimeFunctionResult Err! {
    read: record_tree_row(store.reader, store.tree, store.section, element)
    value: read.value ?? return Err(read.problem ?? "the record has no element {element} in section {store.section}")
    packet := value.decode<SemaComptimeFunctionResult>() ?? return Err("it doesn't decode: {sema_core_record_field_errors(err)}")
    held := packet.function.move()
    packet.function = None
    function := held.move() ?? return Err("its packet holds no body")
    base: function.source_span.start
    body_tree_unpack(function.tree, base)
    loop index in 0..<packet.name_references.len() {
        span: packet.name_references[index].span
        start: base + span.start
        packet.name_references[index].span = Span{start: start, end: start + span.end}
        packet.name_references[index].body = packet.function_key.copy()
    }
    loop index in 0..<packet.call_facts.len() -> packet.call_facts[index].caller_key = packet.function_key.copy()
    packet.function = Val(function.move())
    Ok(packet)
}

// The record's declaration row `row`, read from its section.
sema_core_body_decl_row: fn(store: SemaCoreBodyStore, row: Int) -> DeclRow Err! {
    if row < 0 || row >= store.rebase.count -> return Err("a Core body names declaration row {row}, but the record has {store.rebase.count} rows")
    stored: record_tree_row(store.reader, store.tree, store.decl_section, row)
    stored_value: stored.value ?? return Err(stored.problem ?? "the record has no declaration row {row}")
    decl: stored_value.decode<DeclRow>() ?? return Err("the Core record's declaration row {row} doesn't decode: {sema_core_record_field_errors(err)}")
    Ok(decl)
}

// A taken Core function's packet, and the packets of the Prelude error
// conversions its propagation sites name, read for a comptime check of it
// (sema_check_comptime_function).
SemaCoreComptimePackets: struct {
    // None when a check of the function's source serves it.
    packet: SemaComptimeFunctionResult?
    // In the order the body names them (sema_prelude_conversion_demands).
    conversions: [SemaComptimeFunctionResult]
}

// One taken body read for a comptime check (sema_core_body_view).
SemaCoreBodyView: struct {
    // None when the store holds no packet of it, or its body names a
    // declaration the graph's table doesn't hold.
    packet: SemaComptimeFunctionResult?
}

// The packets of the function `function_key` of the taken module
// `module_identity` (SemaCoreComptimePackets). A comptime check only reads
// the graph, so each DeclID the bodies name is found among the graph's
// registered callables, where finalization maps it into the graph's table
// (sema_core_body_read). No packet when the graph took none of the
// function, or when a body names a declaration the graph hasn't registered
// (a generated codec or derived method, registered at finalization), which a
// check of the source serves. A packet that doesn't read is an Err.
sema_core_body_comptime_packets: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, function_key: String) -> SemaCoreComptimePackets Err! {
    unserved := SemaCoreComptimePackets{packet: None, conversions: [SemaComptimeFunctionResult]{}}
    if graph.core_bodies == .Val(store) {
        viewed := sema_core_body_view(store, graph.decls, graph.symbols, function_key) ?? return Err(err)
        held := viewed.packet.move()
        found := held.move() ?? return Ok(unserved)
        if found.module_identity != module_identity -> return Err("the Core record keys `{function_key}` to a module other than `{module_text(graph.module_table, module_identity)}`")
        // The demand walk reads a list of bodies: the body moves into a
        // one-row list and back.
        body := found.function.move()
        found.function = None
        bodies := [FnBody]{body.move() ?? return Err("the Core record's body `{function_key}` holds no body")}
        demands: sema_prelude_conversion_demands(module_text(graph.module_table, module_identity), bodies, [Int:[SemaPreludeConversionDemand]]{})
        found.function = bodies.pop()
        conversions := [SemaComptimeFunctionResult]{}
        loop demand in demands {
            // A routine's own propagation sites convert through itself.
            if demand.key == function_key -> next
            conversion := sema_core_body_view(store, graph.decls, graph.symbols, demand.key) ?? return Err(err)
            routine := conversion.packet.move()
            conversions.push(routine.move() ?? return Ok(unserved))
        }
        return Ok(SemaCoreComptimePackets{packet: Val(found.move()), conversions: conversions.move()})
    }
    Ok(unserved)
}

// The packet of the function `key` with its DeclIDs found in `table`
// (sema_core_body_comptime_packets).
sema_core_body_view: fn(store: SemaCoreBodyStore, table: DeclTable, symbols: SymbolTable, key: String) -> SemaCoreBodyView Err! {
    id: symbol_find(symbols, key) ?? return Ok(SemaCoreBodyView{packet: None})
    stored: store.rows.get(id.id) ?? return Ok(SemaCoreBodyView{packet: None})
    packet := sema_core_body_unpacked(store, stored.element) ?? return Err("the Core record's body `{key}` can't be read: {err}")
    if packet.function_key != key -> return Err("the Core record's body `{key}` holds `{packet.function_key}`")
    held := packet.function.move()
    packet.function = None
    function := held.move() ?? return Err("the Core record's body `{key}` holds no body")
    rebase := sema_core_decl_rebase_new(store.rebase.count)
    loop row in sema_core_body_tree_decl_rows(function.tree) {
        if rebase.decls.get(row) != None -> next
        decl: sema_core_body_decl_row(store, row) ?? return Err("the Core record's body `{key}` can't be read: {err}")
        mapped: decl_table_find(table, decl.key) ?? return Ok(SemaCoreBodyView{packet: None})
        rebase.decls[row] = mapped
    }
    _: sema_core_body_rebase_tree(rebase, function.tree) ?? return Err("the Core record's body `{key}` can't be read: {err}")
    packet.function = Val(function.move())
    Ok(SemaCoreBodyView{packet: Val(packet.move())})
}

// A decode's field errors, one `path: reason` each.
sema_core_record_field_errors: fn(errors: [FieldError]) -> String Never! {
    parts := [String]{}
    loop error in errors -> parts.push(if error.path == "" -> error.reason.copy() else -> "{error.path}: {error.reason}")
    parts.join("; ")
}

// Maps the record's declaration row `row`, read as `decl`, into the graph's
// `table`: a key the table holds keeps its row; any other key gets a new
// row, which the caller's `decl_table_index` keys. A later record row of a
// key (a redeclaration, kept but never found) maps as the key's first row
// does. Returns the row's graph DeclID.
sema_core_body_rebase_row: fn(rebase: &SemaCoreDeclRebase, table: &DeclTable, row: Int, decl: &&DeclRow) -> DeclID Err! {
    owned := decl.move()
    if row < 0 || row >= rebase.count -> return Err("a Core body names declaration row {row}, but the record has {rebase.count} rows")
    if rebase.decls.get(row) == .Val(done) -> return Ok(done)
    if rebase.keys.get(owned.key) == .Val(shared) {
        rebase.decls[row] = shared
        return Ok(shared)
    }
    mapped: decl_table_find(table, owned.key) ?? decl_table_add_row(table, owned.key, owned.kind)
    rebase.decls[row] = mapped
    rebase.keys[owned.key.move()] = mapped
    Ok(mapped)
}

// The graph DeclID of the record's declaration `id`, which a taken body
// named (sema_core_body_rebase_row).
sema_core_body_rebase_decl: fn(rebase: SemaCoreDeclRebase, id: DeclID) -> DeclID Err! {
    row: decl_id_index(id)
    if row < 0 || row >= rebase.count -> return Err("a Core body names declaration row {row}, but the record has {rebase.count} rows")
    mapped: rebase.decls.get(row) ?? return Err("the Core record's declaration row {row} isn't mapped into the graph")
    Ok(mapped)
}

// The record declaration row of every DeclID the checked tree `tree` (a
// body's, or a standalone expression's) names, in node order: direct calls,
// shared globals' initializers, named function values, policy wrappers and
// memo statistics. A lambda's nodes are rows of the same tree.
sema_core_body_tree_decl_rows: fn(tree: BodyTree) -> [Int] Never! {
    rows := [Int]{}
    loop node in tree.nodes {
        kind: node.kind
        if kind == .Call(callee, _, _) -> rows.push(decl_id_index(callee))
        if kind == .GlobalShared(initializer, _) -> rows.push(decl_id_index(initializer))
        if kind == .FnValue(value) {
            if value == .NamedFn(function, _) {
                if function == .Val(target) -> rows.push(decl_id_index(target))
            }
            if value == .Policy(_, _, _, wrapper, _, _) {
                if wrapper == .Val(wrapped) -> rows.push(decl_id_index(wrapped))
            }
        }
        if kind == .HostCall(call) {
            if call == .MemoStats(memo, _) -> rows.push(decl_id_index(memo))
        }
    }
    rows
}

// Rebases every DeclID of the checked tree `tree` (sema_core_body_tree_decl_rows)
// to the graph DeclID its record row was mapped to. Returns how many DeclIDs
// it rebased.
sema_core_body_rebase_tree: fn(rebase: SemaCoreDeclRebase, tree: &BodyTree) -> Int Err! {
    rebased := 0
    loop index in 0..<tree.nodes.len() {
        kind: tree.nodes[index].kind
        if kind == .Call(callee, type_args, args) {
            mapped: sema_core_body_rebase_decl(rebase, callee) ?? return Err(err)
            tree.nodes[index].kind = NodeKind.Call{callee: mapped, type_args: type_args, args: args}
            rebased += 1
            next
        }
        if kind == .GlobalShared(initializer, lifetime) {
            mapped: sema_core_body_rebase_decl(rebase, initializer) ?? return Err(err)
            tree.nodes[index].kind = NodeKind.GlobalShared{initializer: mapped, lifetime: lifetime}
            rebased += 1
            next
        }
        if kind == .FnValue(value) {
            if value == .NamedFn(function, lambda) {
                named: function ?? next
                mapped: sema_core_body_rebase_decl(rebase, named) ?? return Err(err)
                tree.nodes[index].kind = NodeKind.FnValue{kind: BodyFnValueKind.NamedFn{function: Val(mapped), lambda: lambda}}
                rebased += 1
                next
            }
            if value == .Policy(fn_type, policy_args, policy_conventions, wrapper, captures, callee) {
                wrapped: wrapper ?? next
                mapped: sema_core_body_rebase_decl(rebase, wrapped) ?? return Err(err)
                tree.nodes[index].kind = NodeKind.FnValue{kind: BodyFnValueKind.Policy{fn_type: fn_type, policy_args: policy_args, policy_conventions: policy_conventions, wrapper: Val(mapped), captures: captures, callee: callee}}
                rebased += 1
            }
            next
        }
        if kind == .HostCall(call) {
            if call == .MemoStats(function, bound) {
                mapped: sema_core_body_rebase_decl(rebase, function) ?? return Err(err)
                tree.nodes[index].kind = NodeKind.HostCall{call: BodyHostCall.MemoStats{function: mapped, bound: bound}}
                rebased += 1
            }
        }
    }
    Ok(rebased)
}
