// The Core record's body packets (its section 5, schema `jet.core/v4`). The
// record is written from a finalized Core check, whose module rows hold every
// checked body with the facts all of them recorded, merged. At write time
// each row is split: every body becomes one packet, a
// SemaComptimeFunctionResult (the row a checked body travels in) that holds
// the body and the facts its own check recorded, and the row keeps only what
// belongs to no body. A compile that takes a recorded body takes its packet
// back into the seeded module's row (sema_core_body_packet_take), so that row
// grows by exactly the bodies the compile demands and their facts.
//
// A fact belongs to the body that recorded it: a call-site fact by its
// caller key; a failure row, a compute row and a comptime body source by
// function key; a comptime request, a name reference and a copy event by
// span, to the innermost body whose source span holds it. The hardware-use
// rows name no body and stay with the module.
//
// A graph seeded from a record reads the packets of its taken modules
// through a store the driver fills (SemaRegistrationGraph.core_bodies). A
// packet is decoded only when the finalization takes it: up front for the
// bodies a compile checks without a keyed caller, and otherwise when a
// checked or taken body names its key (CoreDemand.jet). A taken body's
// DeclIDs are rows of the record's declaration table; they are rebased into
// the graph's as the body is taken (sema_core_body_rebase_tree).
use {
    core_record_cbor: core.encoding.cbor
    jet_foundation.[BodyFnValueKind, BodyHostCall, BodyTree, DeclID, DeclTable, FnBody, NodeKind, RecordReader, Span, decl_id_index, decl_table_add_row, decl_table_find, decl_table_index, record_element]
}

// The bounds a record row decodes under: a checked row nests as deep as its
// source does and is read whole, so they are core.encoding.cbor's ceilings
// (parse refuses a depth past 4096 or a byte bound past 1073741824).
SEMA_CORE_RECORD_CBOR: core_record_cbor.CBOROptions{max_depth: 4096, max_items: 1000000000, max_bytes: 1073741824, require_canonical: true}

// `moved` split into one packet per body of `bodies` (the module's checked
// bodies, moved in), pushed to `packets` in their order. The row comes back
// with the facts no body owns and no function. The packets are complete: the
// record holds only a clean check.
sema_core_body_packets: fn(moved: &&SemaGraphModuleResult, bodies: &&[FnBody], packets: &[SemaComptimeFunctionResult]) -> SemaGraphModuleResult Never! {
    row := moved.move()
    owned := bodies.move()
    first: packets.len()
    at := [String:Int]{}
    spans := [Span]{}
    loop function in owned {
        at[function.key.copy()] = packets.len()
        spans.push(function.source_span.copy())
        packets.push(SemaComptimeFunctionResult{
            module_identity: row.module_identity,
            function_key: function.key.copy(),
            function: None,
            waiting_dependencies: [String]{},
            calls: [SemaComptimeRequest]{},
            reachable_function_keys: [String]{},
            call_facts: [SemaCallSiteFact]{},
            hardware_use: sema_hardware_empty_use(),
            name_references: [SemaNameReferenceFact]{},
            comptime_body_sources: [SemaComptimeBodySource]{},
            compute_facts: SemaComputeFunctionFacts{function_key: function.key.copy(), compute_calls: [SemaComputeCallFact]{}, autodiff_obligations: [SemaAutodiffObligation]{}, autodiff_safe_panic: false, autodiff_unsafe_panic: false},
            diagnostics: [Diagnostic]{},
            exact_int_reachable: row.exact_int_reachable,
            copy_events: [SemaCopyEvent]{},
            complete: true,
        })
    }
    loop owned.len() > 0 {
        function := owned.pop() ?? break
        position: at[function.key]
        packets[position].function = Val(function)
    }
    row.functions = [FnBody]{}
    call_facts := row.call_facts.move()
    row.call_facts = [SemaCallSiteFact]{}
    loop fact in call_facts {
        if at.get(fact.caller_key) == .Val(position) {
            packets[position].call_facts.push(fact)
            next
        }
        row.call_facts.push(fact)
    }
    failure_facts := row.failure_facts.move()
    row.failure_facts = [SemaFunctionFailureFacts]{}
    loop facts in failure_facts {
        if at.get(facts.function_key) == .Val(position) {
            packets[position].failure = Val(facts)
            next
        }
        row.failure_facts.push(facts)
    }
    compute_facts := row.compute_facts.move()
    row.compute_facts = [SemaComputeFunctionFacts]{}
    loop facts in compute_facts {
        if at.get(facts.function_key) == .Val(position) {
            packets[position].compute_facts = facts
            next
        }
        row.compute_facts.push(facts)
    }
    sources := row.comptime_body_sources.move()
    row.comptime_body_sources = [SemaComptimeBodySource]{}
    loop source in sources {
        if at.get(source.function_key) == .Val(position) {
            packets[position].comptime_body_sources.push(source)
            next
        }
        row.comptime_body_sources.push(source)
    }
    requests := row.comptime_requests.move()
    row.comptime_requests = [SemaComptimeRequest]{}
    loop request in requests {
        if sema_core_body_owner(spans, request.span) == .Val(position) {
            packets[first + position].calls.push(request)
            next
        }
        row.comptime_requests.push(request)
    }
    references := row.name_references.move()
    row.name_references = [SemaNameReferenceFact]{}
    loop reference in references {
        if sema_core_body_owner(spans, reference.span) == .Val(position) {
            packets[first + position].name_references.push(reference)
            next
        }
        row.name_references.push(reference)
    }
    events := row.copy_events.move()
    row.copy_events = [SemaCopyEvent]{}
    loop event in events {
        if sema_core_body_owner(spans, event.span) == .Val(position) {
            packets[first + position].copy_events.push(event)
            next
        }
        row.copy_events.push(event)
    }
    row
}

// The position in `spans` of the innermost body source span that holds
// `span`; None when none does.
sema_core_body_owner: fn(spans: [Span], span: Span) -> Int? Never! {
    owner := -1
    loop (index, body) in spans {
        if span.start < body.start || span.end > body.end -> next
        if owner < 0 || body.end - body.start < spans[owner].end - spans[owner].start -> owner = index
    }
    if owner < 0 -> return None
    Val(owner)
}

// `packet`'s body and facts appended to `row`, as the body pass appends a
// body it checked (sema_comptime_append_checked_function).
sema_core_body_packet_take: fn(row: &SemaGraphModuleResult, packet: &&SemaComptimeFunctionResult) Never! {
    owned := packet.move()
    _: sema_append_function(row.functions, owned.function.move())
    row.call_facts.extend(owned.call_facts.move())
    row.comptime_requests.extend(owned.calls.move())
    row.name_references.extend(owned.name_references.move())
    row.comptime_body_sources.extend(owned.comptime_body_sources.move())
    row.copy_events.extend(owned.copy_events.move())
    row.compute_facts.push(owned.compute_facts.move())
    failure := owned.failure.move()
    owned.failure = None
    if failure == .Val(facts) -> row.failure_facts.push(facts)
    row.exact_int_reachable = row.exact_int_reachable || owned.exact_int_reachable
}

// The body packets a graph takes from its Core record, filled by the driver
// that opened it (sema_core_body_store_new).
SemaCoreBodyStore: struct {
    reader: RecordReader
    // The record section that holds the packets.
    section: Int
    // Function key -> its packet, for the bodies of the modules the graph
    // takes (sema_finalize_seeded_taken).
    rows: [String:SemaCoreBodyRow]
    rebase: SemaCoreDeclRebase
    // This finalization's: the keys it takes up front, in record order, and
    // every key it took (sema_core_body_begin).
    eager: [String]{[String]{}}
    taken: [String:Bool]{[String:Bool]{}}
}

// Where one packet is: its element in the store's section, and the graph
// index of the taken module whose row it joins.
SemaCoreBodyRow: struct {
    element: Int
    module_index: Int
}

// The record's declaration table mapped into one graph's.
SemaCoreDeclRebase: struct {
    // The record's declaration table, keyed: row `i` is the declaration its
    // bodies name as DeclID `i`.
    record_decls: DeclTable
    // Record declaration row `i` maps to `decls[i]` once a body named it.
    decls: [DeclID?]
}

// A store over the packets `rows` of `reader`'s section `section`, whose
// bodies name the declarations of `record_decls`.
sema_core_body_store_new: fn(reader: RecordReader, section: Int, rows: [String:SemaCoreBodyRow], record_decls: DeclTable) -> SemaCoreBodyStore Never! {
    SemaCoreBodyStore{reader: reader, section: section, rows: rows, rebase: sema_core_decl_rebase_new(record_decls)}
}

// A rebase of `record_decls` that maps no row yet.
sema_core_decl_rebase_new: fn(record_decls: DeclTable) -> SemaCoreDeclRebase Never! {
    decls := [DeclID?]{}
    loop _ in 0..<record_decls.rows.len() -> decls.push(None)
    SemaCoreDeclRebase{record_decls: record_decls, decls: decls}
}

// Starts a finalization's taking: none taken yet, and up front every packet
// that is not `deferred` (the keys a keyed caller demands,
// sema_core_demand_index), or every packet when `demand` is off.
sema_core_body_begin: fn(graph: &SemaRegistrationGraph, demand: Bool, deferred: [String:Int]) Never! {
    if &graph.core_bodies == .Val(store) {
        store.taken = [String:Bool]{}
        by_element := [Int:String]{}
        elements := [Int]{}
        loop (key, row) in store.rows {
            if demand && deferred.get(key) != None -> next
            by_element[row.element] = key.copy()
            elements.push(row.element)
        }
        elements.sort()
        store.eager = loop element in elements -> by_element[element].copy()
    }
}

// Takes the up-front packets of this finalization (sema_core_body_begin)
// into `modules`. Returns how many it took.
sema_core_body_take_eager: fn(graph: &SemaRegistrationGraph, modules: &[SemaGraphModuleResult]) -> Int Never! {
    keys := [String]{}
    if &graph.core_bodies == .Val(store) {
        keys = store.eager.copy()
        store.eager = [String]{}
    }
    took := 0
    loop key in keys {
        if sema_core_body_take(graph, modules, key) -> took += 1
    }
    took
}

// Whether the store holds a packet this finalization hasn't taken.
sema_core_body_pending: fn(graph: SemaRegistrationGraph) -> Bool Never! {
    if graph.core_bodies == .Val(store) -> return store.taken.len() < store.rows.len()
    false
}

// How many packets this finalization took.
sema_core_body_taken_count: fn(graph: SemaRegistrationGraph) -> Int Never! {
    if graph.core_bodies == .Val(store) -> return store.taken.len()
    0
}

// Takes the packet of function `key` into its module's row of `modules`,
// once per finalization: decoded from the record, its body's DeclIDs rebased
// into the graph's table, and appended as the body pass appends a body it
// checked. Returns whether it took one; a key the store doesn't hold, or
// took already, takes none. A packet that can't be read leaves its module
// incomplete, with the reason.
sema_core_body_take: fn(graph: &SemaRegistrationGraph, modules: &[SemaGraphModuleResult], key: String) -> Bool Never! {
    if &graph.core_bodies == .Val(store) -> return sema_core_body_take_from(store, graph.decls, modules, key)
    false
}

sema_core_body_take_from: fn(store: &SemaCoreBodyStore, table: &DeclTable, modules: &[SemaGraphModuleResult], key: String) -> Bool Never! {
    row: store.rows.get(key) ?? return false
    if store.taken.get(key) != None -> return false
    store.taken[key.copy()] = true
    if row.module_index < 0 || row.module_index >= modules.len() -> panic("the Core record's body `{key}` joins module {row.module_index}, which this finalization has no row for")
    identity: modules[row.module_index].module_identity
    packet := sema_core_body_read(store, table, row.element) ?? {
        modules[row.module_index].complete = false
        modules[row.module_index].incomplete_reasons.push("the Core record's body `{key}` can't be taken: {err}")
        return false
    }
    if packet.function_key != key || packet.module_identity != identity {
        modules[row.module_index].complete = false
        modules[row.module_index].incomplete_reasons.push("the Core record's body `{key}` holds `{packet.function_key}` of a module other than `{modules[row.module_index].module_name}`")
        return false
    }
    sema_core_body_packet_take(modules[row.module_index], packet)
    true
}

// The packet of element `element`, its body's DeclIDs rebased into `table`.
sema_core_body_read: fn(store: &SemaCoreBodyStore, table: &DeclTable, element: Int) -> SemaComptimeFunctionResult Err! {
    read: record_element(store.reader, store.section, element)
    value: read.value ?? return Err(read.problem ?? "the record has no element {element} in section {store.section}")
    bytes := [U8]{}
    if value == .Bytes(row) {
        bytes = row
    } else {
        return Err("its element is not a row")
    }
    packet := core_record_cbor.decode<SemaComptimeFunctionResult>(bytes, SEMA_CORE_RECORD_CBOR) ?? return Err("it doesn't decode: {sema_core_record_field_errors(err)}")
    held := packet.function.move()
    packet.function = None
    function := held.move() ?? return Err("its packet holds no body")
    _: sema_core_body_rebase_tree(store.rebase, table, function.tree) ?? return Err(err)
    decl_table_index(table)
    packet.function = Val(function.move())
    Ok(packet)
}

// A decode's field errors, one `path: reason` each.
sema_core_record_field_errors: fn(errors: [FieldError]) -> String Never! {
    parts := [String]{}
    loop error in errors -> parts.push(if error.path == "" -> error.reason.copy() else -> "{error.path}: {error.reason}")
    parts.join("; ")
}

// The graph DeclID of the record's declaration `id`. A key the graph's
// `table` holds keeps its row; any other key gets a new row, which the
// caller's `decl_table_index` keys. A later record row of a key (a
// redeclaration, kept but never found) maps as the key's first row does.
sema_core_body_rebase_decl: fn(rebase: &SemaCoreDeclRebase, table: &DeclTable, id: DeclID) -> DeclID Err! {
    row: decl_id_index(id)
    if row < 0 || row >= rebase.decls.len() -> return Err("a Core body names declaration row {row}, but the record has {rebase.decls.len()} rows")
    if rebase.decls[row] == .Val(done) -> return Ok(done)
    key: rebase.record_decls.rows.key[row]
    first: decl_table_find(rebase.record_decls, key) ?? return Err("the Core record's declaration `{key}` isn't keyed")
    if decl_id_index(first) != row {
        shared: sema_core_body_rebase_decl(rebase, table, first) ?? return Err(err)
        rebase.decls[row] = Val(shared)
        return Ok(shared)
    }
    mapped: decl_table_find(table, key) ?? decl_table_add_row(table, key, rebase.record_decls.rows.kind[row])
    rebase.decls[row] = Val(mapped)
    Ok(mapped)
}

// Rebases every DeclID of the checked tree `tree` (a body's, or a
// standalone expression's) into the graph's `table`: direct calls, shared
// globals' initializers, named function values, policy wrappers and memo
// statistics. A lambda's nodes are rows of the same tree. Returns how many
// DeclIDs it rebased.
sema_core_body_rebase_tree: fn(rebase: &SemaCoreDeclRebase, table: &DeclTable, tree: &BodyTree) -> Int Err! {
    rebased := 0
    loop index in 0..<tree.nodes.len() {
        kind: tree.nodes[index].kind
        if kind == .Call(callee, type_args, args) {
            mapped: sema_core_body_rebase_decl(rebase, table, callee) ?? return Err(err)
            tree.nodes[index].kind = NodeKind.Call{callee: mapped, type_args: type_args, args: args}
            rebased += 1
            next
        }
        if kind == .GlobalShared(initializer, lifetime) {
            mapped: sema_core_body_rebase_decl(rebase, table, initializer) ?? return Err(err)
            tree.nodes[index].kind = NodeKind.GlobalShared{initializer: mapped, lifetime: lifetime}
            rebased += 1
            next
        }
        if kind == .FnValue(value) {
            if value == .NamedFn(function, lambda) {
                named: function ?? next
                mapped: sema_core_body_rebase_decl(rebase, table, named) ?? return Err(err)
                tree.nodes[index].kind = NodeKind.FnValue{kind: BodyFnValueKind.NamedFn{function: Val(mapped), lambda: lambda}}
                rebased += 1
                next
            }
            if value == .Policy(fn_type, policy_args, policy_conventions, wrapper, captures, callee) {
                wrapped: wrapper ?? next
                mapped: sema_core_body_rebase_decl(rebase, table, wrapped) ?? return Err(err)
                tree.nodes[index].kind = NodeKind.FnValue{kind: BodyFnValueKind.Policy{fn_type: fn_type, policy_args: policy_args, policy_conventions: policy_conventions, wrapper: Val(mapped), captures: captures, callee: callee}}
                rebased += 1
            }
            next
        }
        if kind == .HostCall(call) {
            if call == .MemoStats(function, bound) {
                mapped: sema_core_body_rebase_decl(rebase, table, function) ?? return Err(err)
                tree.nodes[index].kind = NodeKind.HostCall{call: BodyHostCall.MemoStats{function: mapped, bound: bound}}
                rebased += 1
            }
        }
    }
    Ok(rebased)
}
