// Comparability and equality capability for operators and Core calls.
// Port of the Rust reference decisions `types_comparable`,
// `native_structural_ordering`, `named_fields_comparable`,
// `incomparable_field`, and `is_equatable` (jet-sema Sema/Diagnostics.rs), and
// of the checker wrappers `types_comparable_type`/`is_equatable_type`
// (Sema/CheckerItems.rs): a registered implementation or bound first, then
// the structural rule. Every user of the decision reads it from here (I8).
use jet_foundation.[
    BinOp,
    Diagnostic,
    Span,
    SymbolKind,
    TCallArg,
    TExpr,
    TExprKind,
    TTypeDef,
    Type,
    type_identity_equal,
    type_name,
]

// One comparability query. A recursive type (`enum Expr { Neg(inner: Expr) }`)
// reaches itself through its fields, and shared field types are reached many
// times. A revisit adds no obligation: a type still being decided is assumed
// comparable (coinduction), and a type that finished as incomparable already
// ended the whole query, because every caller short-circuits on the first
// failure. So a visited type answers `true`, and each type is walked once per
// query. Without the guard a recursive type never terminates and a shared
// graph costs exponential time. Checked declarations are read through the
// environment's keyed index, built once per pass.
struct SemaComparabilityQuery {
    visited: [String:Bool]
}

// A comparison operator the comparability rule decided. `handled` is false when
// the scalar operator path owns the operands; otherwise `value` is the typed
// comparison, or None after this rule reported the rejection.
struct SemaComparabilityBinary {
    handled: Bool
    value: TExpr?
}

fn sema_comparability_query() -> SemaComparabilityQuery Never! {
    SemaComparabilityQuery{visited: [String:Bool]{}}
}

fn sema_comparability_definition_key(definition: TTypeDef) -> String Never! {
    "{definition.module_identity}::{definition.name}"
}

// D-ENCSTREAM-SURFACE1=A: shared encoding value types compare by value.
fn sema_comparability_encoding_value(leaf: String) -> Bool Never! {
    leaf == "EncodingFormat" || leaf == "EncodingErrorKind" || leaf == "EncodingCause" || leaf == "EncodingError" || leaf == "EncodingLimits" || leaf == "DataError" || leaf == "DataErrorKind" || leaf == "DataLimits"
}

fn sema_comparability_data_equatable_value(leaf: String) -> Bool Never! {
    leaf == "DataFreshness" || leaf == "DataFormat" || leaf == "DataLoaderKind" || leaf == "DataInvalidationCause" || leaf == "JetDataPlotMark" || leaf == "JetDataPlotValue" || leaf == "JetDataPlotRenderFormat"
}

fn sema_comparability_sealed_crypto_plan(leaf: String) -> Bool Never! {
    leaf == "MutationPlan" || leaf == "VaultWrite" || leaf == "Rotation"
}

// Resolve `name` from `module_identity` to its checked declaration. Field and
// alias types are qualified in their declaring module, so nested lookups pass
// that module rather than the caller's.
fn sema_comparability_definition(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: String, name: String) -> TTypeDef? {
    if program.registration_graph == .Val(graph) {
        resolved :: sema_type_graph_lookup_symbol(graph, module_identity, name) ?? return None
        if resolved.symbol.kind != SymbolKind.Type -> return None
        index :: sema_scope_checked_type_row(environment, program, resolved.target_module_identity, resolved.symbol.name) ?? return None
        return Val(program.checked_types[index])
    }
    sema_serde_type_definition(environment, program, name)
}

// A registered `trait_name` implementation, generic bound, or derive. An
// auto-derived `Equatable` counts as registered, selected by the same
// declaration-marker rule codegen uses for the generated body.
fn sema_comparability_implements(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type, trait_name: String) -> Bool Never! {
    // Rust `register_synthetic_display_debug` registers the Prelude carriers'
    // value equality and order (D-TIME-ORDER1=A: LocalDate, DateTime, ...) in
    // the trait registry, so `implements_trait` answers by name.
    if ty == .Named(carrier) {
        if sema_derive_builtin_supports(sema_serde_named_leaf(carrier), trait_name) -> return true
    }
    if program.registration_graph == .Val(graph) {
        bound := sema_type_bound_satisfied_with_generics(graph, ty, trait_name, environment.module_identity, environment.generic_params) ?? false
        if bound -> return true
        name :: sema_type_graph_base_name(ty) ?? return false
        resolved :: sema_type_graph_lookup_symbol(graph, environment.module_identity, name) ?? return false
        if resolved.symbol.kind != SymbolKind.Type -> return false
        if sema_scope_checked_type_row(environment, program, resolved.target_module_identity, resolved.symbol.name) == .Val(checked_row) {
            if sema_serde_has_name(program.checked_types[checked_row].derives, trait_name) -> return true
        }
        if trait_name != "Equatable" -> return false
        module_index :: sema_registration_module_index(graph, resolved.target_module_identity) ?? return false
        row :: sema_type_graph_nominal_row(graph, resolved.symbol.id.key) ?? return false
        // Matched in place: a pattern on the indexed path copies the whole item.
        nominal :: graph.modules[row.module_index].nominals[row.row]
        if nominal.source == .SourceAST(item) -> return sema_type_metadata_auto_derives(item, graph.modules[module_index].declared_trait_impls).equatable
    }
    false
}

// Rust `native_structural_ordering`: the shapes whose ordering is the
// language's own lexicographic order. `aliases` holds the non-generic aliases
// being expanded on this path, so an alias cycle answers false.
fn sema_comparability_native_ordering(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: String, ty: Type, aliases: [String], query: &SemaComparabilityQuery) -> Bool Never! {
    if ty == {
        .Int | .Bool | .Float | .String | .Char | .IntN(_, _) | .Float32 -> true
        .List(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) -> sema_comparability_native_ordering(environment, program, module_identity, inner, aliases, &query)
        .Result(ok, err) -> sema_comparability_native_ordering(environment, program, module_identity, ok, aliases, &query) && sema_comparability_native_ordering(environment, program, module_identity, err, aliases, &query)
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_comparability_native_ordering(environment, program, module_identity, field.ty, aliases, &query) -> return false
            }
            true
        }
        .Named(name) -> {
            leaf := sema_serde_named_leaf(name)
            if leaf == "U8" || leaf == "Ordering" -> return true
            definition :: sema_comparability_definition(environment, program, module_identity, name) ?? return false
            if definition.generic_params.len() > 0 -> return false
            key := sema_comparability_definition_key(definition)
            loop alias in aliases {
                if alias == key -> return false
            }
            if definition.kind == {
                .Alias(target) -> {
                    nested := [String]{}
                    loop alias in aliases -> &nested.push(alias)
                    &nested.push(key)
                    sema_comparability_native_ordering(environment, program, definition.module_identity, target, nested, &query)
                }
                else -> false
            }
        }
        else -> false
    }
}

// Rust `types_comparable`: the structural ordering rule without registered
// implementations.
fn sema_comparability_structural(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: String, ty: Type, query: &SemaComparabilityQuery) -> Bool Never! {
    if sema_call_reflection_secret_bearing(ty) -> return false
    if ty == {
        .Int | .Bool | .Float | .String | .Char | .IntN(_, _) | .Float32 -> true
        .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) -> sema_comparability_native_ordering(environment, program, module_identity, inner, [String]{}, &query)
        .Result(ok, err) -> sema_comparability_native_ordering(environment, program, module_identity, ok, [String]{}, &query) && sema_comparability_native_ordering(environment, program, module_identity, err, [String]{}, &query)
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_comparability_native_ordering(environment, program, module_identity, field.ty, [String]{}, &query) -> return false
            }
            true
        }
        .Named(name) -> {
            leaf := sema_serde_named_leaf(name)
            if leaf == "U8" || leaf == "Ordering" || sema_comparability_encoding_value(leaf) -> return true
            sema_comparability_named_fields(environment, program, module_identity, name, &query)
        }
        .Apply(name, args) -> {
            leaf := sema_serde_named_leaf(name)
            if leaf == "KeyRef" -> return true
            if sema_comparability_sealed_crypto_plan(leaf) -> return false
            loop arg in args {
                if !sema_comparability_structural(environment, program, module_identity, arg, &query) -> return false
            }
            true
        }
        .InlineRange(base, _, _) -> sema_comparability_structural(environment, program, module_identity, base, &query)
        else -> false
    }
}

// Rust `named_fields_comparable`: a declared nominal is comparable when every
// field is; the query's visited set makes the walk coinductive and linear.
fn sema_comparability_named_fields(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: String, name: String, query: &SemaComparabilityQuery) -> Bool Never! {
    definition :: sema_comparability_definition(environment, program, module_identity, name) ?? return false
    key := sema_comparability_definition_key(definition)
    if query.visited.get(key) != None -> return true
    query.visited[key] = true
    sema_comparability_definition_incomparable_field(environment, program, definition, &query) == None
}

// Distinct and alias declarations wrap a comparable base (D-DIST1); only
// struct fields and enum payloads can block comparison.
fn sema_comparability_definition_incomparable_field(environment: SemaScopeEnvironment, program: SemaProgramTables, definition: TTypeDef, query: &SemaComparabilityQuery) -> String? {
    owner := definition.module_identity
    if definition.kind == {
        .Struct(fields, _) -> {
            loop field in fields {
                if !sema_comparability_structural(environment, program, owner, field.ty, &query) -> return Val(field.name)
            }
        }
        .Enum(variants, _) -> {
            loop variant in variants {
                if variant.payload == {
                    .Single(payload) -> {
                        if !sema_comparability_structural(environment, program, owner, payload, &query) -> return Val("payload")
                    }
                    .Named(fields) -> {
                        loop field in fields {
                            if !sema_comparability_structural(environment, program, owner, field.ty, &query) -> return Val(field.name)
                        }
                    }
                    .Unit -> {}
                }
            }
        }
        else -> {}
    }
    None
}

fn sema_comparability_incomparable_field(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: String, ty: Type, query: &SemaComparabilityQuery) -> String? {
    if ty == {
        .Named(name) -> {
            definition :: sema_comparability_definition(environment, program, module_identity, name) ?? return None
            key := sema_comparability_definition_key(definition)
            if query.visited.get(key) == None -> query.visited[key] = true
            sema_comparability_definition_incomparable_field(environment, program, definition, &query)
        }
        .Option(inner) -> sema_comparability_incomparable_field(environment, program, module_identity, inner, &query)
        .Result(ok, err) -> {
            found := sema_comparability_incomparable_field(environment, program, module_identity, ok, &query)
            if found != None -> return found
            sema_comparability_incomparable_field(environment, program, module_identity, err, &query)
        }
        else -> None
    }
}

// Rust `types_comparable`: structural ordering only.
fn sema_types_comparable(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type) -> Bool Never! {
    query := sema_comparability_query()
    sema_comparability_structural(environment, program, environment.module_identity, ty, &query)
}

// Rust `incomparable_field`: the first field (or `payload`) that blocks
// comparing values of `ty`.
fn sema_incomparable_field(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type) -> String? {
    query := sema_comparability_query()
    sema_comparability_incomparable_field(environment, program, environment.module_identity, ty, &query)
}

// Rust `types_comparable_type` plus `type_param_has_bound(_, Comparable)`: a
// registered `Comparable` implementation, bound, or derive, else the
// structural rule.
fn sema_type_comparable(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type) -> Bool Never! {
    if sema_comparability_implements(environment, program, ty, "Comparable") -> return true
    sema_types_comparable(environment, program, ty)
}

fn sema_comparability_stored_parameter(item: Item, name: String) -> Bool Never! {
    if item == {
        .Struct(definition) -> {
            loop field in definition.fields {
                if field.computed == None && sema_serde_mentions_parameter(field.ty, name) -> return true
            }
        }
        .Enum(definition) -> {
            loop variant in definition.variants {
                if variant.payload == {
                    .Single(ty, _) -> if sema_serde_mentions_parameter(ty, name) -> return true
                    .Named(fields) -> {
                        loop field in fields {
                            if sema_serde_mentions_parameter(field.ty, name) -> return true
                        }
                    }
                    .Unit -> {}
                }
            }
        }
        else -> {}
    }
    false
}

// Structural derives constrain stored generic parameters, not phantom names.
// Rust records these indices in TraitRegistry.structural_params. Resolve the
// same declaration-owned fields here; absent metadata keeps the strict rule.
fn sema_comparability_equatable_arguments(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type, args: [Type]) -> Bool Never! {
    if program.registration_graph == .Val(graph) {
        name :: sema_type_graph_base_name(ty) ?? ""
        resolved :: sema_type_graph_lookup_symbol(graph, environment.module_identity, name)
        if resolved == .Val(symbol) {
            row :: sema_type_graph_nominal_row(graph, symbol.symbol.id.key)
            if row == .Val(nominal_row) {
                nominal :: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
                if nominal.source == .SourceAST(item) {
                    if item == .Struct(_) || item == .Enum(_) {
                        if nominal.generic_params.len() != args.len() -> return false
                        loop (index, parameter) in nominal.generic_params {
                            if sema_comparability_stored_parameter(item, parameter.name) && !sema_type_equatable(environment, program, args[index]) -> return false
                        }
                        return true
                    }
                }
            }
        }
    }
    loop arg in args { if !sema_type_equatable(environment, program, arg) -> return false }
    true
}

// Rust `is_equatable_type`/`is_equatable`: value equality is structural over
// the built-in shapes and registered (`Equatable`) for nominals.
fn sema_type_equatable(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type) -> Bool Never! {
    if sema_call_reflection_secret_bearing(ty) -> return false
    if ty == {
        .Int | .Bool | .Float | .String | .Char | .IntN(_, _) | .Float32 -> true
        .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) -> sema_type_equatable(environment, program, inner)
        .Result(ok, err) | .Map(ok, _, err) -> sema_type_equatable(environment, program, ok) && sema_type_equatable(environment, program, err)
        .Named(name) -> {
            leaf := sema_serde_named_leaf(name)
            if leaf == "U8" || leaf == "Ordering" || sema_comparability_encoding_value(leaf) || sema_comparability_data_equatable_value(leaf) -> return true
            // D-FACT-ENUM-TIR: compiler fact enums compare by variant; codegen folds the test.
            if sema_fact_enum_menu(ty, environment, program) != None -> return true
            sema_comparability_implements(environment, program, ty, "Equatable")
        }
        .Apply(name, args) -> {
            leaf := sema_serde_named_leaf(name)
            if leaf == "KeyRef" -> return true
            if leaf == "ID" -> return sema_comparability_implements(environment, program, ty, "Equatable")
            if sema_comparability_sealed_crypto_plan(leaf) -> return false
            if !sema_comparability_implements(environment, program, ty, "Equatable") -> return false
            sema_comparability_equatable_arguments(environment, program, ty, args)
        }
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_type_equatable(environment, program, field.ty) -> return false
            }
            true
        }
        .Union(members) -> {
            loop member in members {
                if !sema_type_equatable(environment, program, member) -> return false
            }
            true
        }
        else -> false
    }
}

// Operands whose comparisons the scalar operator path already types, including
// numeric literal joins and the precise number families.
fn sema_comparability_scalar_operand(ty: Type) -> Bool Never! {
    sema_expr_is_numeric(ty) || sema_expr_is_integer(ty) || sema_expr_precise_name(ty) != None
}

// `==`/`!=` (Rust `infer_binary` Eq/Ne), `<=>` (Compare), and `<`/`<=`/`>`/`>=`
// (Rust `check_relational`) over one operand type without a registered
// operator hook. Mismatched operand types stay with the scalar path's
// mismatch diagnostics.
fn sema_comparability_check_binary(op: BinOp, lhs: TExpr, rhs: TExpr, span: Span, line: Int, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> SemaComparabilityBinary {
    skipped := SemaComparabilityBinary{handled: false, value: None}
    rejected := SemaComparabilityBinary{handled: true, value: None}
    equality := op == BinOp.Eq || op == BinOp.Ne
    ordering := op == BinOp.Compare || op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge
    if !equality && !ordering -> return skipped
    // A declared type names a nominal by its canonical `module::Name` while a
    // literal keeps the written `Name`; the operands compare by the identity
    // both spellings resolve to.
    if !type_identity_equal(sema_expr_expected_type(lhs.ty, environment, program), sema_expr_expected_type(rhs.ty, environment, program)) || sema_comparability_scalar_operand(lhs.ty) -> return skipped
    shown := type_name(lhs.ty)
    label := "`{sema_expr_binary_name(op)}`"
    if equality {
        if lhs.ty == Type.Bool || lhs.ty == Type.String || lhs.ty == Type.Char -> return skipped
        if !sema_type_equatable(environment, program, lhs.ty) {
            field := sema_incomparable_field(environment, program, lhs.ty)
            field_name := field ?? ""
            if {
                sema_call_reflection_secret_bearing(lhs.ty) -> &diagnostics.push(sema_error("E0312", span, "secret-bearing `{shown}` values cannot use {label}", "ordinary equality may leak secret information through timing and secret-bearing crypto types never implement comparison", "use `core.crypto.constant_time_equal` for `Secret` values; compare public keys through their canonical `.bytes()` values"))
                field != None -> &diagnostics.push(sema_error("E0312", span, "`{shown}` can't be compared with `{type_name(rhs.ty)}` because field `{field_name}` doesn't support {label}", "value equality needs every field to support the comparison", "compare individual fields instead"))
                else -> &diagnostics.push(sema_error("E0312", span, "`{shown}` doesn't support {label}", "value equality requires the Equatable trait", "add `#Equatable` before the type, implement `Equatable` by hand, or compare individual fields"))
            }
            return rejected
        }
        return SemaComparabilityBinary{handled: true, value: Val(sema_tir_node(Type.Bool, TExprKind.Binary{op: sema_expr_tir_binary_op(op), overflow: false, line: line, lhs: lhs, rhs: rhs}, span))}
    }
    if !sema_type_comparable(environment, program, lhs.ty) {
        &diagnostics.push(sema_error("E0109", span, "{label} can't compare or combine {shown} and {type_name(rhs.ty)}", "{label} is not defined for {shown}", "use an operation supported by {shown}, or call a named method"))
        return rejected
    }
    result_ty := if op == BinOp.Compare -> Type.Named{name: "Ordering"} else -> Type.Bool
    SemaComparabilityBinary{handled: true, value: Val(sema_tir_node(result_ty, TExprKind.Binary{op: sema_expr_tir_binary_op(op), overflow: false, line: line, lhs: lhs, rhs: rhs}, span))}
}

// Rust `core.math` `min`/`max`/`clamp` (E0905, reported at the first
// argument). Other Comparable-constrained Core members keep the canonical
// constraint wording.
fn sema_comparability_core_error(member: String, span: Span) -> Diagnostic? {
    why := if {
        member == "min" || member == "max" -> "min/max compare their two arguments"
        member == "clamp" -> "clamp compares the value with its lower and upper bounds"
        else -> ""
    }
    if why == "" -> return None
    Val(sema_error("E0905", span, "`{member}` needs comparable values", why, "use Int, Float, String, Char, Bool, or a comparable type"))
}

// Rust `map_key_type_eligible` (D-MAP-KEY1, E0502): map keys are ordered
// values. Scalars and tuples of keys qualify, and a nominal qualifies when it
// is a struct whose fields all qualify or an enum without payloads. A nominal
// reached again while it is still being decided lies on a cycle and answers
// false, as the Rust walk's active set does.
fn sema_type_map_key_eligible(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type) -> Bool Never! {
    query := sema_comparability_query()
    sema_comparability_map_key(environment, program, environment.module_identity, ty, &query)
}

// Rust `check_declared_type_rules` (D-MAP-KEY1, E0502): every map written in
// a declared type needs a key-eligible key. False when one was reported.
fn sema_type_check_declared_map_keys(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type, span: Span, diagnostics: &[Diagnostic]) -> Bool Never! {
    if ty == {
        .Map(key, key_span, value) -> {
            valid := sema_type_check_declared_map_keys(environment, program, key, span, &diagnostics)
            if !sema_type_check_declared_map_keys(environment, program, value, span, &diagnostics) -> valid = false
            if !sema_type_map_key_eligible(environment, program, key) {
                &diagnostics.push(sema_map_key_error("`{type_name(key)}` can't be a map key type (D-MAP-KEY1)", key_span ?? span))
                valid = false
            }
            valid
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .InlineRange(inner, _, _) -> sema_type_check_declared_map_keys(environment, program, inner, span, &diagnostics)
        .Result(ok, err) -> {
            valid := sema_type_check_declared_map_keys(environment, program, ok, span, &diagnostics)
            if !sema_type_check_declared_map_keys(environment, program, err, span, &diagnostics) -> valid = false
            valid
        }
        .Apply(_, members) | .Union(members) -> {
            valid := true
            loop member in members {
                if !sema_type_check_declared_map_keys(environment, program, member, span, &diagnostics) -> valid = false
            }
            valid
        }
        .Fn(params, ret, _, _, _, _) -> {
            valid := true
            loop param in params {
                if !sema_type_check_declared_map_keys(environment, program, param, span, &diagnostics) -> valid = false
            }
            if ret == .Val(result) && !sema_type_check_declared_map_keys(environment, program, result, span, &diagnostics) -> valid = false
            valid
        }
        .Tuple(fields) -> {
            valid := true
            loop field in fields {
                if !sema_type_check_declared_map_keys(environment, program, field.ty, span, &diagnostics) -> valid = false
            }
            valid
        }
        else -> true
    }
}

fn sema_comparability_map_key(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: String, ty: Type, query: &SemaComparabilityQuery) -> Bool Never! {
    if ty == {
        .Int | .Bool | .String | .Char | .IntN(_, _) -> true
        .Tagged(_, inner) -> sema_comparability_map_key(environment, program, module_identity, inner, &query)
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_comparability_map_key(environment, program, module_identity, field.ty, &query) -> return false
            }
            true
        }
        .Named(name) -> {
            if sema_serde_named_leaf(name) == "U8" -> return true
            definition :: sema_comparability_definition(environment, program, module_identity, name) ?? return false
            key := sema_comparability_definition_key(definition)
            if query.visited.get(key) == .Val(answer) -> return answer
            query.visited[key] = false
            eligible := sema_comparability_definition_map_key(environment, program, definition, &query)
            query.visited[key] = eligible
            eligible
        }
        else -> false
    }
}

fn sema_comparability_definition_map_key(environment: SemaScopeEnvironment, program: SemaProgramTables, definition: TTypeDef, query: &SemaComparabilityQuery) -> Bool Never! {
    if definition.kind == {
        .Struct(fields, _) -> {
            loop field in fields {
                if !sema_comparability_map_key(environment, program, definition.module_identity, field.ty, &query) -> return false
            }
            true
        }
        .Enum(variants, _) -> {
            loop variant in variants {
                if variant.payload == {
                    .Unit -> {}
                    else -> return false
                }
            }
            true
        }
        else -> false
    }
}

// Rust `hashable_type_eligible` (D-SET-HASH1, E0506): the `Hash + Eq`
// capability a `Set` or `Tally` element needs. Structural carriers follow
// their parts; a nominal needs value equality and hashable fields. A nominal
// still being decided answers false, and a finished one reuses its answer.
fn sema_type_hashable(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type) -> Bool Never! {
    query := sema_comparability_query()
    sema_comparability_hashable(environment, program, environment.module_identity, ty, &query)
}

fn sema_comparability_hashable(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: String, ty: Type, query: &SemaComparabilityQuery) -> Bool Never! {
    if ty == {
        .Int | .Bool | .String | .Char | .IntN(_, _) -> true
        .List(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> sema_comparability_hashable(environment, program, module_identity, inner, &query)
        .Result(ok, err) -> sema_comparability_hashable(environment, program, module_identity, ok, &query) && sema_comparability_hashable(environment, program, module_identity, err, &query)
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_comparability_hashable(environment, program, module_identity, field.ty, &query) -> return false
            }
            true
        }
        .Union(members) -> {
            loop member in members {
                if !sema_comparability_hashable(environment, program, module_identity, member, &query) -> return false
            }
            true
        }
        .Named(name) -> {
            if sema_serde_named_leaf(name) == "U8" -> return true
            definition :: sema_comparability_definition(environment, program, module_identity, name) ?? return false
            key := sema_comparability_definition_key(definition)
            if query.visited.get(key) == .Val(answer) -> return answer
            query.visited[key] = false
            eligible := sema_comparability_definition_hashable(environment, program, definition, ty, [SemaInferenceBinding]{}, &query)
            query.visited[key] = eligible
            eligible
        }
        .Apply(name, args) -> {
            leaf := sema_serde_named_leaf(name)
            if leaf == "ID" -> return sema_type_equatable(environment, program, ty)
            if leaf == "Task" || leaf == "Sender" || leaf == "Receiver" || leaf == "SharedGuard" || leaf == "Pool" || leaf == "Set" -> return false
            definition :: sema_comparability_definition(environment, program, module_identity, name) ?? return false
            if definition.generic_params.len() != args.len() -> return false
            key := "<{type_name(ty)}>"
            if query.visited.get(key) == .Val(answer) -> return answer
            query.visited[key] = false
            bindings :: loop (index, param) in definition.generic_params -> SemaInferenceBinding{name: param.name, ty: args[index], source: "hashable owner"}
            eligible := sema_comparability_definition_hashable(environment, program, definition, ty, bindings, &query)
            query.visited[key] = eligible
            eligible
        }
        else -> false
    }
}

fn sema_comparability_definition_hashable(environment: SemaScopeEnvironment, program: SemaProgramTables, definition: TTypeDef, ty: Type, bindings: [SemaInferenceBinding], query: &SemaComparabilityQuery) -> Bool Never! {
    owner := definition.module_identity
    if definition.kind == {
        .Distinct(base, _) -> sema_type_equatable(environment, program, ty) && sema_comparability_hashable(environment, program, owner, sema_inference_substitute_type_bindings(base, bindings), &query)
        .Alias(target) -> {
            if bindings.len() == 0 && definition.generic_params.len() > 0 -> return false
            sema_comparability_hashable(environment, program, owner, sema_inference_substitute_type_bindings(target, bindings), &query)
        }
        .Struct(fields, _) -> {
            if !sema_type_equatable(environment, program, ty) -> return false
            loop field in fields {
                if !sema_comparability_hashable(environment, program, owner, sema_inference_substitute_type_bindings(field.ty, bindings), &query) -> return false
            }
            true
        }
        .Enum(variants, _) -> {
            if !sema_type_equatable(environment, program, ty) -> return false
            loop variant in variants {
                if variant.payload == {
                    .Unit -> {}
                    .Single(value) -> {
                        if !sema_comparability_hashable(environment, program, owner, sema_inference_substitute_type_bindings(value, bindings), &query) -> return false
                    }
                    .Named(fields) -> {
                        loop field in fields {
                            if !sema_comparability_hashable(environment, program, owner, sema_inference_substitute_type_bindings(field.ty, bindings), &query) -> return false
                        }
                    }
                }
            }
            true
        }
        else -> false
    }
}
