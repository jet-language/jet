// Comparability and equality capability for operators and Core calls. Port of
// the Rust reference decisions `types_comparable`,
// `native_structural_ordering`, `named_fields_comparable`,
// `incomparable_field`, and `is_equatable` (jet-sema), and of the checker
// wrappers `types_comparable_type`/`is_equatable_type`: a registered
// implementation or bound first, then the structural rule. Every user of the
// decision reads it from here (I8).
use jet_foundation.[
    BinOp,
    Diagnostic,
    DiagnosticFixApplicability,
    DiagnosticFixSafety,
    Span,
    SymbolKind,
    ModuleID,
    TTypeDef,
    Type,
    type_identity_equal,
    type_name,
    Item,
    TraitImplBlock,
    IR_RUNTIME_HANDLES,
    ir_runtime_handle_row,
    diagnostic_with_edit_grade,
    owned_trait_implies,
]

// One comparability query. A recursive type (`Expr: enum { Neg(inner: Expr) }`)
// reaches itself through its fields, and shared field types are reached many
// times. A revisit adds no obligation: a type still being decided is assumed
// comparable (coinduction), and a type that finished as incomparable already
// ended the whole query, because every caller short-circuits on the first
// failure. So a visited type answers `true`, and each type is walked once per
// query. Without the guard a recursive type never terminates and a shared
// graph costs exponential time. Checked declarations are read through the
// environment's keyed index, built once per pass.
SemaComparabilityQuery: struct {
    visited: [String:Bool]
}

// A comparison operator the comparability rule decided. `handled` is false when
// the scalar operator path owns the operands; otherwise `value` is the typed
// comparison, or None after this rule reported the rejection.
SemaComparabilityBinary: struct {
    handled: Bool
    value: TExpr?
}

sema_comparability_query: fn() -> SemaComparabilityQuery Never! {
    SemaComparabilityQuery{visited: [String:Bool]{}}
}

sema_comparability_definition_key: fn(definition: TTypeDef) -> String Never! {
    "{definition.module_identity.id}::{definition.name}"
}

// Shared encoding value types compare by value.
sema_comparability_encoding_value: fn(leaf: String) -> Bool Never! {
    leaf == "EncodingFormat" || leaf == "EncodingErrorKind" || leaf == "EncodingCause" || leaf == "EncodingError" || leaf == "EncodingLimits" || leaf == "DataError" || leaf == "DataErrorKind" || leaf == "DataLimits"
}

sema_comparability_data_equatable_value: fn(leaf: String) -> Bool Never! {
    leaf == "DataFreshness" || leaf == "DataFormat" || leaf == "DataLoaderKind" || leaf == "DataInvalidationCause" || leaf == "JetDataPlotMark" || leaf == "JetDataPlotValue" || leaf == "JetDataPlotRenderFormat"
}

sema_comparability_sealed_crypto_plan: fn(leaf: String) -> Bool Never! {
    leaf == "MutationPlan" || leaf == "VaultWrite" || leaf == "Rotation"
}

// Resolve `name` from `module_identity` to its checked declaration. Field and
// alias types are qualified in their declaring module, so nested lookups pass
// that module rather than the caller's. Compile-time code is checked before
// the program's types are (sema_comptime_environment_tables), so with no
// checked types the registered declaration is checked here.
sema_comparability_definition: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID, name: String) -> TTypeDef? {
    if program.registration_graph == .Val(graph) {
        resolved: sema_type_graph_lookup_symbol(graph, module_identity, name) ?? return None
        if sema_resolved_kind(graph, resolved) != SymbolKind.Type -> return None
        if program.checked_types.len() > 0 {
            index: sema_scope_checked_type_row(environment, program, resolved.target_module_identity, sema_resolved_name(graph, resolved)) ?? return None
            return Val(program.checked_types[index])
        }
        row: sema_type_graph_resolved_nominal_row(graph, resolved) ?? return None
        // Its diagnostics are the program check's to report.
        ignored := [Diagnostic]{}
        return sema_checked_type_def(graph, program.boxed_edges, graph.modules[row.module_index], None, graph.modules[row.module_index].nominals[row.row], ignored)
    }
    sema_serde_type_definition(environment, program, name)
}

// A registered `trait_name` implementation, generic bound, or derive. An
// auto-derived `Equatable` counts as registered, selected by the same
// declaration-marker rule codegen uses for the generated body.
sema_comparability_implements: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type, trait_name: String) -> Bool Never! {
    // Rust `register_synthetic_display_debug` registers the Prelude carriers'
    // value equality and order (LocalDate, DateTime, ...) in
    // the trait registry, so `implements_trait` answers by name.
    if ty == .Named(carrier) {
        if sema_derive_builtin_supports(sema_serde_named_leaf(carrier), trait_name) -> return true
    }
    if program.registration_graph == .Val(graph) {
        bound := sema_type_bound_satisfied_at(graph, ty, trait_name, sema_scope_caller_row(environment, graph), environment.generic_params) ?? false
        if bound -> return true
        name: sema_type_graph_base_name(ty) ?? return false
        resolved: sema_type_graph_lookup_symbol_at(graph, sema_scope_caller_row(environment, graph), name) ?? return false
        if sema_resolved_kind(graph, resolved) != SymbolKind.Type -> return false
        if sema_scope_checked_type_row(environment, program, resolved.target_module_identity, sema_resolved_name(graph, resolved)) == .Val(checked_row) {
            if sema_serde_has_name(program.checked_types[checked_row].derives, trait_name) {
                return true
            }
        }
        // A KeyBy type is equal and ordered by its key.
        if owned_trait_implies("KeyBy", trait_name) {
            if sema_type_graph_resolved_nominal_row(graph, resolved) == .Val(key_row) {
                if sema_comparability_nominal_key(graph, graph.modules[key_row.module_index].nominals[key_row.row]) != None {
                    return true
                }
            }
        }
        if trait_name != "Equatable" -> return false
        module_index: sema_registration_module_index(graph, resolved.target_module_identity) ?? return false
        row: sema_type_graph_resolved_nominal_row(graph, resolved) ?? return false
        // Matched in place: a pattern on the indexed path copies the whole item.
        nominal: graph.modules[row.module_index].nominals[row.row]
        // An auto-derive that a field blocks has no compiler-generated
        // `Equatable` block, and neither has any member of its recursive group
        // or any type built on it.
        if nominal.source == .SourceAST(item) {
            if !sema_type_metadata_auto_derives(item, graph.modules[module_index].declared_trait_impls).equatable {
                return false
            }
            visited := [String:Bool]{}
            return !sema_comparability_auto_blocked(graph, resolved.target_module_identity, item, visited)
        }
    }
    false
}

// An auto-derived `Equatable` is blocked when some field reaches, through
// auto-derived types without a generated block, a declared type of the program
// that neither derives nor implements `Equatable` (`#!Equatable`), or a runtime
// handle registered without `eq` (`WsConn`, #6581). A revisited type adds no
// obligation; any other name that resolves to no declared item leaves the
// decision to its registered implementation.
sema_comparability_auto_blocked: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, item: Item, visited: &[String:Bool]) -> Bool Never! {
    if sema_comparability_generated_block(item, "Equatable") -> return false
    if item == {
        .Struct(definition) -> {
            loop field in definition.fields {
                if field.computed != None -> next
                if sema_comparability_auto_blocked_type(graph, module_identity, field.ty, visited) {
                    return true
                }
            }
        }
        .Enum(definition) -> {
            loop variant in definition.variants {
                if variant.payload == {
                    .Unit -> {}
                    .Single(ty, _) -> {
                        if sema_comparability_auto_blocked_type(graph, module_identity, ty, visited) {
                            return true
                        }
                    }
                    .Named(fields) -> {
                        loop field in fields {
                            if sema_comparability_auto_blocked_type(graph, module_identity, field.ty, visited) {
                                return true
                            }
                        }
                    }
                }
            }
        }
        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    false
}

sema_comparability_auto_blocked_type: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, ty: Type, visited: &[String:Bool]) -> Bool Never! {
    if ty == {
        .List(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) -> sema_comparability_auto_blocked_type(graph, module_identity, inner, visited)
        .Map(key, _, value) -> sema_comparability_auto_blocked_type(graph, module_identity, key, visited) || sema_comparability_auto_blocked_type(graph, module_identity, value, visited)
        .Result(ok, err) -> sema_comparability_auto_blocked_type(graph, module_identity, ok, visited) || sema_comparability_auto_blocked_type(graph, module_identity, err, visited)
        .Tuple(fields) -> {
            loop field in fields {
                if sema_comparability_auto_blocked_type(graph, module_identity, field.ty, visited) {
                    return true
                }
            }
            false
        }
        .Named(name) -> {
            resolved: sema_type_graph_lookup_symbol(graph, module_identity, name) ?? return sema_comparability_handle_without_eq(name)
            if sema_resolved_kind(graph, resolved) != SymbolKind.Type -> return false
            row: sema_type_graph_resolved_nominal_row(graph, resolved) ?? return false
            key: "{resolved.target_module_identity.id}::{sema_resolved_name(graph, resolved)}"
            if visited.get(key) != None -> return false
            visited[key] = true
            // Matched in place: a pattern on the indexed path copies the whole item.
            nominal: graph.modules[row.module_index].nominals[row.row]
            if nominal.source == .SourceAST(field_item) {
                if sema_comparability_generated_block(field_item, "Equatable") -> return false
                if !sema_type_metadata_auto_derives(field_item, graph.modules[row.module_index].declared_trait_impls).equatable {
                    return sema_type_bound_satisfied(graph, ty, "Equatable", module_identity) != (Val(true))
                }
                return sema_comparability_auto_blocked(graph, resolved.target_module_identity, field_item, visited)
            }
            false
        }
        .Int | .Float | .Bool | .String | .Char | .Shared(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// A runtime handle whose registration has no `jet_rt_handle_eq_<runtime>`
// routine: no tier can compare two of them, so nothing holding one derives
// `Equatable`.
sema_comparability_handle_without_eq: fn(name: String) -> Bool Never! {
    row: ir_runtime_handle_row(name) ?? return false
    !IR_RUNTIME_HANDLES[row].eq
}

sema_comparability_generated_block: fn(item: Item, trait_name: String) -> Bool Never! {
    if item == {
        .Struct(definition) -> return sema_comparability_generated_in(definition.trait_impls, trait_name)
        .Enum(definition) -> return sema_comparability_generated_in(definition.trait_impls, trait_name)
        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> return false
    }
}

sema_comparability_generated_in: fn(blocks: [TraitImplBlock], trait_name: String) -> Bool Never! {
    loop block in blocks {
        if block.trait_name == trait_name && block.compiler_generated -> return true
    }
    false
}

// Rust `native_structural_ordering`: the shapes whose ordering is the
// language's own lexicographic order. `aliases` holds the non-generic aliases
// being expanded on this path, so an alias cycle answers false.
sema_comparability_native_ordering: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID, ty: Type, aliases: [String], query: &SemaComparabilityQuery) -> Bool Never! {
    if ty == {
        .Int | .Bool | .Float | .String | .Char | .IntN(_, _) | .Float32 -> true
        .List(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) -> sema_comparability_native_ordering(environment, program, module_identity, inner, aliases, query)
        .Result(ok, err) -> sema_comparability_native_ordering(environment, program, module_identity, ok, aliases, query) && sema_comparability_native_ordering(environment, program, module_identity, err, aliases, query)
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_comparability_native_ordering(environment, program, module_identity, field.ty, aliases, query) {
                    return false
                }
            }
            true
        }
        .Named(name) -> {
            leaf := sema_serde_named_leaf(name)
            if leaf == "U8" || leaf == "Ordering" -> return true
            definition: sema_comparability_definition(environment, program, module_identity, name) ?? return false
            if definition.generic_params.len() > 0 -> return false
            key := sema_comparability_definition_key(definition)
            loop alias in aliases {
                if alias == key -> return false
            }
            if definition.kind == {
                .Alias(target) -> {
                    nested := [String]{}
                    loop alias in aliases -> nested.push(alias.copy())
                    nested.push(key)
                    sema_comparability_native_ordering(environment, program, definition.module_identity, target, nested, query)
                }
                .Struct(_, _) | .Enum(_, _) | .Distinct(_, _) | .UnitFamily(_, _) -> false
            }
        }
        .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .InlineRange(_, _, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// Rust `types_comparable`: the structural ordering rule without registered
// implementations.
sema_comparability_structural: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID, ty: Type, query: &SemaComparabilityQuery) -> Bool Never! {
    if sema_call_reflection_secret_bearing(ty) -> return false
    if ty == {
        .Int | .Bool | .Float | .String | .Char | .IntN(_, _) | .Float32 -> true
        .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) -> sema_comparability_native_ordering(environment, program, module_identity, inner, [String]{}, query)
        .Result(ok, err) -> sema_comparability_native_ordering(environment, program, module_identity, ok, [String]{}, query) && sema_comparability_native_ordering(environment, program, module_identity, err, [String]{}, query)
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_comparability_native_ordering(environment, program, module_identity, field.ty, [String]{}, query) {
                    return false
                }
            }
            true
        }
        .Named(name) -> {
            leaf := sema_serde_named_leaf(name)
            if leaf == "U8" || leaf == "Ordering" || sema_comparability_encoding_value(leaf) {
                return true
            }
            sema_comparability_named_fields(environment, program, module_identity, name, query)
        }
        .Apply(name, args) -> {
            leaf := sema_serde_named_leaf(name)
            if leaf == "KeyRef" -> return true
            if sema_comparability_sealed_crypto_plan(leaf) -> return false
            loop arg in args {
                if !sema_comparability_structural(environment, program, module_identity, arg, query) {
                    return false
                }
            }
            true
        }
        .InlineRange(base, _, _) -> sema_comparability_structural(environment, program, module_identity, base, query)
        .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// Rust `named_fields_comparable`: a declared nominal is comparable when every
// field is; the query's visited set makes the walk coinductive and linear.
sema_comparability_named_fields: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID, name: String, query: &SemaComparabilityQuery) -> Bool Never! {
    definition: sema_comparability_definition(environment, program, module_identity, name) ?? return false
    if !sema_comparability_ordering_selected(program, module_identity, name) -> return false
    key := sema_comparability_definition_key(definition)
    if query.visited.get(key) != None -> return true
    query.visited[key] = true
    sema_comparability_definition_incomparable_field(environment, program, definition, query) == None
}

// A declared struct or enum orders structurally only while it selects
// `Comparable`: `#!Comparable`, or a package that denies
// `auto_derive` without a `#Comparable` marker, refuses it, and a handwritten
// implementation still wins.
sema_comparability_ordering_selected: fn(program: SemaProgramTables, module_identity: ModuleID, name: String) -> Bool Never! {
    if program.registration_graph == .Val(graph) {
        resolved: sema_type_graph_lookup_symbol(graph, module_identity, name) ?? return true
        if sema_resolved_kind(graph, resolved) != SymbolKind.Type -> return true
        row: sema_type_graph_resolved_nominal_row(graph, resolved) ?? return true
        // Matched in place: a pattern on the indexed path copies the whole item.
        nominal: graph.modules[row.module_index].nominals[row.row]
        if nominal.source == .SourceAST(item) {
            declared: graph.modules[row.module_index].declared_trait_impls
            if item == {
                .Struct(value) -> return sema_type_metadata_trait_requested(value.type_markers, "Comparable", value.auto_derive_default) || sema_type_metadata_has_trait_block(value.trait_impls, "Comparable") || sema_type_metadata_has_explicit_impl(declared, value.name, "Comparable")
                .Enum(value) -> return sema_type_metadata_trait_requested(value.type_markers, "Comparable", value.auto_derive_default) || sema_type_metadata_has_trait_block(value.trait_impls, "Comparable") || sema_type_metadata_has_explicit_impl(declared, value.name, "Comparable")
                .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> return true
            }
        }
    }
    true
}

// Distinct and alias declarations wrap a comparable base only
// struct fields and enum payloads can block comparison.
sema_comparability_definition_incomparable_field: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, definition: TTypeDef, query: &SemaComparabilityQuery) -> String? {
    owner := definition.module_identity
    if definition.kind == {
        .Struct(fields, _) -> {
            loop field in fields {
                if !sema_comparability_structural(environment, program, owner, field.ty, query) {
                    return Val(field.name)
                }
            }
        }
        .Enum(variants, _) -> {
            loop variant in variants {
                if variant.payload == {
                    .Single(payload) -> {
                        if !sema_comparability_structural(environment, program, owner, payload, query) {
                            return Val("payload")
                        }
                    }
                    .Named(fields) -> {
                        loop field in fields {
                            if !sema_comparability_structural(environment, program, owner, field.ty, query) {
                                return Val(field.name)
                            }
                        }
                    }
                    .Unit -> {}
                }
            }
        }
        .Distinct(_, _) | .Alias(_) | .UnitFamily(_, _) -> {}
    }
    None
}

sema_comparability_incomparable_field: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID, ty: Type, query: &SemaComparabilityQuery) -> String? {
    if ty == {
        .Named(name) -> {
            definition: sema_comparability_definition(environment, program, module_identity, name) ?? return None
            key := sema_comparability_definition_key(definition)
            if query.visited.get(key) == None -> query.visited[key] = true
            sema_comparability_definition_incomparable_field(environment, program, definition, query)
        }
        .Option(inner) -> sema_comparability_incomparable_field(environment, program, module_identity, inner, query)
        .Result(ok, err) -> {
            found := sema_comparability_incomparable_field(environment, program, module_identity, ok, query)
            if found != None -> return found
            sema_comparability_incomparable_field(environment, program, module_identity, err, query)
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// Rust `types_comparable`: structural ordering only.
sema_types_comparable: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type) -> Bool Never! {
    query := sema_comparability_query()
    sema_comparability_structural(environment, program, environment.module_identity, ty, query)
}

// Rust `incomparable_field`: the first field (or `payload`) that blocks
// comparing values of `ty`.
sema_incomparable_field: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type) -> String? {
    query := sema_comparability_query()
    sema_comparability_incomparable_field(environment, program, environment.module_identity, ty, query)
}

// Rust `types_comparable_type` plus `type_param_has_bound(_, Comparable)`: a
// registered `Comparable` implementation, bound, or derive, else the
// structural rule.
sema_type_comparable: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type) -> Bool Never! {
    if sema_comparability_implements(environment, program, ty, "Comparable") -> return true
    sema_types_comparable(environment, program, ty)
}

sema_comparability_stored_parameter: fn(item: Item, name: String) -> Bool Never! {
    if item == {
        .Struct(definition) -> {
            loop field in definition.fields {
                if field.computed == None && sema_serde_mentions_parameter(field.ty, name) {
                    return true
                }
            }
        }
        .Enum(definition) -> {
            loop variant in definition.variants {
                if variant.payload == {
                    .Single(ty, _) -> {
                        if sema_serde_mentions_parameter(ty, name) -> return true
                    }
                    .Named(fields) -> {
                        loop field in fields {
                            if sema_serde_mentions_parameter(field.ty, name) -> return true
                        }
                    }
                    .Unit -> {}
                }
            }
        }
        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    false
}

// Structural derives constrain stored generic parameters, not phantom names.
// Rust records these indices in TraitRegistry.structural_params. Resolve the
// same declaration-owned fields here; absent metadata keeps the strict rule.
sema_comparability_equatable_arguments: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type, args: [Type]) -> Bool Never! {
    if program.registration_graph == .Val(graph) {
        name: sema_type_graph_base_name(ty) ?? ""
        resolved: sema_type_graph_lookup_symbol(graph, environment.module_identity, name)
        if resolved == .Val(symbol) {
            row: sema_type_graph_resolved_nominal_row(graph, symbol)
            if row == .Val(nominal_row) {
                nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
                if nominal.source == .SourceAST(item) {
                    if item == .Struct(_) || item == .Enum(_) {
                        if nominal.generic_params.len() != args.len() -> return false
                        loop (index, parameter) in nominal.generic_params {
                            if sema_comparability_stored_parameter(item, parameter.name) && !sema_type_equatable(environment, program, args[index]) {
                                return false
                            }
                        }
                        return true
                    }
                }
            }
        }
    }
    loop arg in args {
        if !sema_type_equatable(environment, program, arg) -> return false
    }
    true
}

// Rust `is_equatable_type`/`is_equatable`: value equality is structural over
// the built-in shapes and registered (`Equatable`) for nominals.
sema_type_equatable: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type) -> Bool Never! {
    if sema_call_reflection_secret_bearing(ty) -> return false
    if ty == {
        .Int | .Bool | .Float | .String | .Char | .IntN(_, _) | .Float32 -> true
        .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .Case(_, inner) | .InlineRange(inner, _, _) -> sema_type_equatable(environment, program, inner)
        .Result(ok, err) | .Map(ok, _, err) -> sema_type_equatable(environment, program, ok) && sema_type_equatable(environment, program, err)
        .Named(name) -> {
            leaf := sema_serde_named_leaf(name)
            if leaf == "U8" || leaf == "Ordering" || sema_comparability_encoding_value(leaf) || sema_comparability_data_equatable_value(leaf) {
                return true
            }
            // Compiler fact enums compare by variant; codegen folds the test.
            if sema_fact_enum_menu(ty, environment, program) != None -> return true
            sema_comparability_implements(environment, program, ty, "Equatable")
        }
        .Apply(name, args) -> {
            leaf := sema_serde_named_leaf(name)
            if leaf == "KeyRef" -> return true
            // An `ID<T>` is a plain index and generation that
            // never touches `T`, so ids compare whatever `T` is.
            if leaf == "ID" -> return true
            if sema_comparability_sealed_crypto_plan(leaf) -> return false
            if !sema_comparability_implements(environment, program, ty, "Equatable") -> return false
            sema_comparability_equatable_arguments(environment, program, ty, args)
        }
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_type_equatable(environment, program, field.ty) -> return false
            }
            true
        }
        .Union(members) -> {
            loop member in members {
                if !sema_type_equatable(environment, program, member) -> return false
            }
            true
        }
        .Shared(_) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// Operands whose comparisons the scalar operator path already types, including
// numeric literal joins and the precise number families.
sema_comparability_scalar_operand: fn(ty: Type) -> Bool Never! {
    sema_expr_is_numeric(ty) || sema_expr_is_integer(ty) || sema_expr_precise_name(ty) != None
}

// `==`/`!=` (Rust `infer_binary` Eq/Ne), `<=>` (Compare), and `<`/`<=`/`>`/`>=`
// (Rust `check_relational`) over one operand type without a registered
// operator hook. Mismatched operand types stay with the scalar path's
// mismatch diagnostics.
sema_comparability_check_binary: fn(op: BinOp, lhs: TExpr, rhs: TExpr, span: Span, line: Int, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> SemaComparabilityBinary {
    skipped := SemaComparabilityBinary{handled: false, value: None}
    rejected := SemaComparabilityBinary{handled: true, value: None}
    equality := op == BinOp.Eq || op == BinOp.Ne
    ordering := op == BinOp.Compare || op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge
    if !equality && !ordering -> return skipped
    // A declared type names a nominal by its canonical `module::Name` while a
    // literal keeps the written `Name`; the operands compare by the identity
    // both spellings resolve to.
    if !type_identity_equal(sema_expr_expected_type(lhs.ty, environment, program), sema_expr_expected_type(rhs.ty, environment, program)) || sema_comparability_scalar_operand(lhs.ty) {
        return skipped
    }
    shown := type_name(lhs.ty)
    label := "`{sema_expr_binary_name(op)}`"
    if equality {
        if lhs.ty == Type.Bool || lhs.ty == Type.String || lhs.ty == Type.Char -> return skipped
        if !sema_type_equatable(environment, program, lhs.ty) {
            field := sema_incomparable_field(environment, program, lhs.ty)
            field_name := field ?? ""
            if {
                sema_call_reflection_secret_bearing(lhs.ty) -> {
                    diagnostics.push(sema_error("E0312", span, "secret-bearing `{sema_call_reflection_leaf_name(shown)}` values cannot use {label}", "ordinary equality may leak secret information through timing and secret-bearing crypto types never implement comparison", "use `core.crypto.constant_time_equal` for `Secret` values; compare public keys through their canonical `.bytes()` values"))
                }
                field != None -> {
                    diagnostics.push(sema_error("E0312", span, "`{shown}` can't be compared with `{type_name(rhs.ty)}` because field `{field_name}` doesn't support {label}", "value equality needs every field to support the comparison", "compare individual fields instead"))
                }
                else -> {
                    diagnostics.push(sema_error("E0312", span, "`{shown}` doesn't support {label}", "value equality requires the Equatable trait", "add `#Equatable` before the type, implement `Equatable` by hand, or compare individual fields"))
                }
            }
            return rejected
        }
        return SemaComparabilityBinary{handled: true, value: Val(sema_tree_node(Type.Bool, TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: lhs, rhs: rhs}, span))}
    }
    if !sema_type_comparable(environment, program, lhs.ty) {
        diagnostics.push(sema_error("E0109", span, "{label} can't compare or combine {shown} and {type_name(rhs.ty)}", "{label} is not defined for {shown}", "use an operation supported by {shown}, or call a named method"))
        return rejected
    }
    result_ty := if op == BinOp.Compare -> Type.Named{name: "Ordering"} else -> Type.Bool
    SemaComparabilityBinary{handled: true, value: Val(sema_tree_node(result_ty, TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: lhs, rhs: rhs}, span))}
}

// Rust `map_key_type_eligible` (E0502): map keys are ordered
// values. Scalars and tuples of keys qualify, and a nominal qualifies when it
// is a struct whose fields all qualify, an enum without payloads, or a
// distinct type whose base qualifies. A nominal
// reached again while it is still being decided lies on a cycle and answers
// false, as the Rust walk's active set does.
sema_type_map_key_eligible: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type) -> Bool Never! {
    query := sema_comparability_query()
    sema_comparability_map_key(environment, program, environment.module_identity, ty, query)
}

// Rust `check_declared_type_rules` (E0502): every map written in
// a declared type needs a key-eligible key. False when one was reported.
sema_type_check_declared_map_keys: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type, span: Span, diagnostics: &[Diagnostic]) -> Bool Never! {
    if ty == {
        .Map(key, key_span, value) -> {
            valid := sema_type_check_declared_map_keys(environment, program, key, span, diagnostics)
            if !sema_type_check_declared_map_keys(environment, program, value, span, diagnostics) {
                valid = false
            }
            if !sema_type_map_key_eligible(environment, program, key) {
                diagnostics.push(sema_type_map_key_refusal(environment, program, key, "`{type_name(key)}` can't be a map key type", key_span ?? span))
                valid = false
            }
            valid
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .Case(_, inner) | .InlineRange(inner, _, _) -> sema_type_check_declared_map_keys(environment, program, inner, span, diagnostics)
        .Result(ok, err) -> {
            valid := sema_type_check_declared_map_keys(environment, program, ok, span, diagnostics)
            if !sema_type_check_declared_map_keys(environment, program, err, span, diagnostics) {
                valid = false
            }
            valid
        }
        .Apply(_, members) | .Union(members) -> {
            valid := true
            loop member in members {
                if !sema_type_check_declared_map_keys(environment, program, member, span, diagnostics) {
                    valid = false
                }
            }
            valid
        }
        .Fn(params, ret, _, _, _, _) -> {
            valid := true
            loop param in params {
                if !sema_type_check_declared_map_keys(environment, program, param, span, diagnostics) {
                    valid = false
                }
            }
            if ret == .Val(result) && !sema_type_check_declared_map_keys(environment, program, result, span, diagnostics) {
                valid = false
            }
            valid
        }
        .Tuple(fields) -> {
            valid := true
            loop field in fields {
                if !sema_type_check_declared_map_keys(environment, program, field.ty, span, diagnostics) {
                    valid = false
                }
            }
            valid
        }
        .Int | .Float | .Bool | .String | .Char | .Named(_) | .TraitObject(_) | .FixedList(_, _) | .IntN(_, _) | .Float32 | .Quantity(_, _) | .Measure(_) -> true
    }
}

sema_comparability_map_key: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID, ty: Type, query: &SemaComparabilityQuery) -> Bool Never! {
    if ty == {
        .Int | .Bool | .String | .Char | .IntN(_, _) -> true
        // A list orders item by item, a shorter prefix first.
        .List(inner) -> sema_comparability_map_key(environment, program, module_identity, inner, query)
        .Tagged(_, inner) -> sema_comparability_map_key(environment, program, module_identity, inner, query)
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_comparability_map_key(environment, program, module_identity, field.ty, query) {
                    return false
                }
            }
            true
        }
        .Named(name) -> {
            if sema_serde_named_leaf(name) == "U8" -> return true
            definition: sema_comparability_definition(environment, program, module_identity, name) ?? return false
            key := sema_comparability_definition_key(definition)
            if query.visited.get(key) == .Val(answer) -> return answer
            query.visited[key] = false
            eligible := sema_comparability_definition_map_key(environment, program, definition, query)
            query.visited[key] = eligible
            eligible
        }
        .Float | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_comparability_definition_map_key: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, definition: TTypeDef, query: &SemaComparabilityQuery) -> Bool Never! {
    // A KeyBy type is a key exactly when its key is; a key that reaches its
    // own type is a cycle and answers false.
    if sema_comparability_key_type(program, definition) == .Val(key) {
        return sema_comparability_map_key(environment, program, definition.module_identity, key, query)
    }
    if sema_comparability_written_order(program, definition) != None -> return false
    if definition.kind == {
        .Struct(fields, _) -> {
            loop field in fields {
                if !sema_comparability_map_key(environment, program, definition.module_identity, field.ty, query) {
                    return false
                }
            }
            true
        }
        .Enum(variants, _) -> {
            loop variant in variants {
                if variant.payload == {
                    .Unit -> {}
                    .Single(_) | .Named(_) -> return false
                }
            }
            true
        }
        // A distinct type is a key exactly when its base is: it hashes and
        // orders as the base value it wraps.
        .Distinct(base, _) -> sema_comparability_map_key(environment, program, definition.module_identity, base, query)
        .Alias(_) | .UnitFamily(_, _) -> false
    }
}

// The key type of a KeyBy type (the `Key` its `impl KeyBy` binds), or None
// when `definition` implements no KeyBy.
sema_comparability_key_type: fn(program: SemaProgramTables, definition: TTypeDef) -> Type? Never! {
    if program.registration_graph == .Val(graph) {
        caller: sema_type_module_row(graph, definition.module_identity)
        row: sema_type_resolve_nominal_row_at(graph, Type.Named{name: definition.name}, caller) ?? return None
        return sema_comparability_nominal_key(graph, graph.modules[row.module_index].nominals[row.row])
    }
    None
}

// The `Key` a KeyBy implementation of `nominal` binds, written as its own
// `impl` item or as an `impl KeyBy` block in the type's body.
sema_comparability_nominal_key: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal) -> Type? Never! {
    loop module_index in 0..<graph.modules.len() {
        loop impl_index in 0..<graph.modules[module_index].impls.len() {
            if graph.modules[module_index].impls[impl_index].declaration.trait_name != (Val("KeyBy")) {
                next
            }
            target_matches: sema_type_graph_impl_matches_nominal(graph, graph.modules[module_index].impls[impl_index], nominal) ?? next
            if !target_matches -> next
            loop associated in graph.modules[module_index].impls[impl_index].declaration.assoc_type_impls {
                if associated.name == "Key" {
                    return Val(sema_type_resolve_declared(graph, associated.ty, graph.modules[module_index].impls[impl_index].source_module_identity))
                }
            }
        }
    }
    if nominal.source == .SourceAST(item) {
        loop block in sema_registration_item_trait_blocks(item) {
            if block.trait_name != "KeyBy" -> next
            loop associated in block.assoc_type_impls {
                if associated.name == "Key" {
                    return Val(sema_type_resolve_declared(graph, associated.ty, nominal.symbol.module_identity))
                }
            }
        }
    }
    None
}

// A written `impl Equatable` or `impl Comparable` of the nominal at `row`:
// its trait, the module row it is written in, and the source it spans from
// `impl` through its brace. `impl_index` is the top-level `impl Owner.Trait`
// of that module; None for a block in the type's body.
SemaWrittenOrder: struct {
    trait_name: String
    module_index: Int
    row: SemaRegistrationRowRef
    impl_index: Int?
    span: Span?
}

// The written Equatable or Comparable of `definition`, which has no KeyBy:
// the type's own `==` or order can call two values the same that a field
// walk keeps apart, so it is no Map key or Set element. None when every such
// impl is derived.
sema_comparability_written_order: fn(program: SemaProgramTables, definition: TTypeDef) -> SemaWrittenOrder? Never! {
    if program.registration_graph == .Val(graph) {
        caller: sema_type_module_row(graph, definition.module_identity)
        row: sema_type_resolve_nominal_row_at(graph, Type.Named{name: definition.name}, caller) ?? return None
        return sema_comparability_nominal_written_order(graph, row)
    }
    None
}

sema_comparability_nominal_written_order: fn(graph: SemaRegistrationGraph, row: SemaRegistrationRowRef) -> SemaWrittenOrder? Never! {
    nominal: graph.modules[row.module_index].nominals[row.row]
    loop module_index in 0..<graph.modules.len() {
        loop impl_index in 0..<graph.modules[module_index].impls.len() {
            if graph.modules[module_index].impls[impl_index].compiler_generated -> next
            written: graph.modules[module_index].impls[impl_index].declaration.trait_name ?? next
            if written == "KeyBy" || !owned_trait_implies("KeyBy", written) -> next
            target_matches: sema_type_graph_impl_matches_nominal(graph, graph.modules[module_index].impls[impl_index], nominal) ?? next
            if !target_matches -> next
            return Val(SemaWrittenOrder{trait_name: sema_comparability_order_trait(written), module_index: module_index, row: row, impl_index: Val(impl_index), span: Val(graph.modules[module_index].impls[impl_index].declaration.span)})
        }
    }
    if nominal.source == .SourceAST(item) {
        loop block in sema_registration_item_trait_blocks(item) {
            if block.compiler_generated || block.trait_name == "KeyBy" || !owned_trait_implies("KeyBy", block.trait_name) {
                next
            }
            return Val(SemaWrittenOrder{trait_name: sema_comparability_order_trait(block.trait_name), module_index: row.module_index, row: row, impl_index: None, span: block.span})
        }
    }
    None
}

// The written order trait `written` names: Comparable, or Equatable, the
// traits KeyBy derives.
sema_comparability_order_trait: fn(written: String) -> String Never! {
    if written == "Comparable" -> "Comparable" else -> "Equatable"
}

// E0502 for a Map key type `key` that isn't key-eligible. A type that writes
// its own `equal` or `compare` is told to name its key with KeyBy, and
// `jet fix` moves a rule that reads one field path to KeyBy.
sema_type_map_key_refusal: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, key: Type, what: String, span: Span) -> Diagnostic {
    written: sema_comparability_written_order_of(environment, program, key) ?? return sema_map_key_error(what, span)
    sema_key_by_migrated(sema_error("E0502", span, what, "`{type_name(key)}` writes its own `{written.trait_name}`, so values its `==` calls the same could still be separate keys", "implement `KeyBy` with the value `{type_name(key)}` compares, and remove the written `{written.trait_name}`"), environment, program, written)
}

// `error` with the `jet fix` edit that moves `written`, a type's written
// rule, to KeyBy (sema_key_by_migration_edit), when there is one.
sema_key_by_migrated: fn(error: &&Diagnostic, environment: SemaScopeEnvironment, program: SemaProgramTables, written: SemaWrittenOrder) -> Diagnostic {
    if program.registration_graph == .Val(graph) {
        edit: sema_key_by_migration_edit(graph, written, environment.module_identity) ?? return error
        return diagnostic_with_edit_grade(error, edit, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving)
    }
    error
}

// The written Equatable or Comparable of the nominal `ty` names, when it has
// no KeyBy (sema_comparability_written_order).
sema_comparability_written_order_of: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type) -> SemaWrittenOrder? Never! {
    if ty == .Named(name) {
        definition: sema_comparability_definition(environment, program, environment.module_identity, name) ?? return None
        if sema_comparability_key_type(program, definition) != None -> return None
        return sema_comparability_written_order(program, definition)
    }
    None
}

// Rust `hashable_type_eligible` (E0506): the `Hash + Eq`
// capability a `Set` or `Tally` element needs. Structural carriers follow
// their parts; a nominal needs value equality and hashable fields. A nominal
// still being decided answers false, and a finished one reuses its answer.
sema_type_hashable: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type) -> Bool Never! {
    query := sema_comparability_query()
    sema_comparability_hashable(environment, program, environment.module_identity, ty, query)
}

sema_comparability_hashable: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID, ty: Type, query: &SemaComparabilityQuery) -> Bool Never! {
    if ty == {
        .Int | .Bool | .String | .Char | .IntN(_, _) -> true
        .List(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .Case(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> sema_comparability_hashable(environment, program, module_identity, inner, query)
        .Result(ok, err) -> sema_comparability_hashable(environment, program, module_identity, ok, query) && sema_comparability_hashable(environment, program, module_identity, err, query)
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_comparability_hashable(environment, program, module_identity, field.ty, query) {
                    return false
                }
            }
            true
        }
        .Union(members) -> {
            loop member in members {
                if !sema_comparability_hashable(environment, program, module_identity, member, query) {
                    return false
                }
            }
            true
        }
        .Named(name) -> {
            if sema_serde_named_leaf(name) == "U8" -> return true
            definition: sema_comparability_definition(environment, program, module_identity, name) ?? return false
            key := sema_comparability_definition_key(definition)
            if query.visited.get(key) == .Val(answer) -> return answer
            query.visited[key] = false
            eligible := sema_comparability_definition_hashable(environment, program, definition, ty, [SemaInferenceBinding]{}, query)
            query.visited[key] = eligible
            eligible
        }
        .Apply(name, args) -> {
            leaf := sema_serde_named_leaf(name)
            if leaf == "ID" -> return sema_type_equatable(environment, program, ty)
            if leaf == "Task" || leaf == "Sender" || leaf == "Receiver" || leaf == "SharedGuard" || leaf == "Pool" || leaf == "Set" {
                return false
            }
            definition: sema_comparability_definition(environment, program, module_identity, name) ?? return false
            if definition.generic_params.len() != args.len() -> return false
            key := "<{type_name(ty)}>"
            if query.visited.get(key) == .Val(answer) -> return answer
            query.visited[key] = false
            bindings: loop (index, param) in definition.generic_params -> SemaInferenceBinding{name: param.name, ty: args[index], source: "hashable owner"}
            eligible := sema_comparability_definition_hashable(environment, program, definition, ty, bindings, query)
            query.visited[key] = eligible
            eligible
        }
        .Float | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Float32 | .Measure(_) -> false
    }
}

sema_comparability_definition_hashable: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, definition: TTypeDef, ty: Type, bindings: [SemaInferenceBinding], query: &SemaComparabilityQuery) -> Bool Never! {
    owner := definition.module_identity
    if sema_comparability_key_type(program, definition) == .Val(key) {
        return sema_comparability_hashable(environment, program, owner, key, query)
    }
    if sema_comparability_written_order(program, definition) != None -> return false
    if definition.kind == {
        .Distinct(base, _) -> sema_type_equatable(environment, program, ty) && sema_comparability_hashable(environment, program, owner, sema_inference_substitute_type_bindings(base, bindings), query)
        .Alias(target) -> {
            if bindings.len() == 0 && definition.generic_params.len() > 0 -> return false
            sema_comparability_hashable(environment, program, owner, sema_inference_substitute_type_bindings(target, bindings), query)
        }
        .Struct(fields, _) -> {
            if !sema_type_equatable(environment, program, ty) -> return false
            loop field in fields {
                if !sema_comparability_hashable(environment, program, owner, sema_inference_substitute_type_bindings(field.ty, bindings), query) {
                    return false
                }
            }
            true
        }
        .Enum(variants, _) -> {
            if !sema_type_equatable(environment, program, ty) -> return false
            loop variant in variants {
                if variant.payload == {
                    .Unit -> {}
                    .Single(value) -> {
                        if !sema_comparability_hashable(environment, program, owner, sema_inference_substitute_type_bindings(value, bindings), query) {
                            return false
                        }
                    }
                    .Named(fields) -> {
                        loop field in fields {
                            if !sema_comparability_hashable(environment, program, owner, sema_inference_substitute_type_bindings(field.ty, bindings), query) {
                                return false
                            }
                        }
                    }
                }
            }
            true
        }
        .UnitFamily(_, _) -> false
    }
}
