// Rust: crates/jet-sema/src/Sema/Casing.rs:1-8
use jet_foundation.[Binding, DeriveBodyItem, Diagnostic, Expr, Func, Item, PatSlot, Pattern, ProgramBundle, Span, Stmt, TraitMethodSig, TypeParam, bind_pattern_names]
use jet_foundation.Syntax as Syntax
use jet_foundation.Syntax.[NameCase]
use jet_sema.CheckerCoreLib.[retired_acronym_spelling_diag]
use std.collections.[HashSet]

// Rust: crates/jet-sema/src/Sema/Casing.rs:10
fn validate_bundle(bundle: ProgramBundle) -> [Diagnostic] {
    out := [Diagnostic]{}
    traits := HashSet<String>{}
    loop module in bundle.modules { loop item in module.items -> trait_names(item, &traits) }
    loop module in bundle.modules {
        loop import in module.imports {
            if !import.alias.is_empty() -> snake(import.alias, import.alias_span, "module alias", &out)
            if import.kind == {
                .Module(name, span) -> snake(name, span, "module", &out)
                .Unqualified(module_alias, module_alias_span, _, _, _) -> snake(module_alias, module_alias_span, "module alias", &out)
                .File(_, _) -> {}
            }
        }
        loop item in module.items -> item_names(item, traits, &out)
    }
    ^out
}
// Rust: crates/jet-sema/src/Sema/Casing.rs:40
fn trait_names(item: Item, out: &HashSet<String>) {
    if item == {
        .Trait(t) -> { _ :: &out.insert(~t.name) }
        .CodeModule(m) -> { if m.body == .Val(body) { loop item in body -> trait_names(item, out) } }
        .GenericModule(m) -> { loop item in m.body -> trait_names(item, out) }
        else -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/Casing.rs:61
fn check(name: String, span: Span, category: String, out: &[Diagnostic]) {
    // Category lookup precedes all exemptions: a missing registry category is an ICE.
    case :: Syntax.name_case_for_category(category) ?? ice(.Val(span), "identifier category `{category}` is missing from Syntax::NAME_CASE_CATEGORIES")
    // No authored extent means compiler-generated spelling, not a rename site.
    if span.start == span.end || name.is_empty() || name.starts_with("__") || Syntax.name_has_case(name, case) -> return
    expected :: if case == { .Pascal -> "PascalCase"; .Snake -> "snake_case"; .Screaming -> "ALL_CAPS" }
    fixed :: Syntax.canonical_name_case(name, case)
    &out.push(Diagnostic.error("E0357", "{category} `{name}` must be {expected}", "Jet enforces PascalCase for type-like names, snake_case for value-like names, and ALL_CAPS (SCREAMING_SNAKE_CASE) for module-global constants (D-SHAPE-CASE1)", "rename it to `{fixed}`", .Val(span)))
}
// Rust: crates/jet-sema/src/Sema/Casing.rs:95
fn pascal(name: String, span: Span, category: String, out: &[Diagnostic]) {
    debug_assert_eq(Syntax.name_case_for_category(category), .Val(NameCase.Pascal))
    all_pascal := true
    loop segment in name.split(".") {
        check(segment, span, category, out)
        if !Syntax.name_has_case(segment, .Pascal) -> all_pascal = false
    }
    // Acronym edits cover the whole written name, only after valid Pascal casing.
    if span.start != span.end && all_pascal {
        parts := [String]{}
        loop segment in name.split(".") -> &parts.push(Syntax.respell_acronym_name(segment))
        canonical :: parts.join(".")
        if canonical != name -> &out.push(retired_acronym_spelling_diag(name, canonical, span))
    }
}
// Rust: crates/jet-sema/src/Sema/Casing.rs:123
fn snake(name: String, span: Span, category: String, out: &[Diagnostic]) {
    debug_assert_eq(Syntax.name_case_for_category(category), .Val(NameCase.Snake))
    loop part in name.split(".") { loop segment in part.split("-") -> check(segment, span, category, out) }
}
// Rust: crates/jet-sema/src/Sema/Casing.rs:132
fn screaming(name: String, span: Span, category: String, out: &[Diagnostic]) {
    debug_assert_eq(Syntax.name_case_for_category(category), .Val(NameCase.Screaming))
    loop part in name.split(".") { loop segment in part.split("-") -> check(segment, span, category, out) }
}
// Rust: crates/jet-sema/src/Sema/Casing.rs:148
fn type_parameter(p: TypeParam, out: &[Diagnostic]) {
    if p.prep != None {
        &out.push(Diagnostic.from_row("E0390", [("name", p.name)], .Val(p.name_span)))
        return
    }
    pascal(p.name, p.name_span, "type parameter", out)
}
// Rust: crates/jet-sema/src/Sema/Casing.rs:160
fn func_names(f: Func, category: String, out: &[Diagnostic]) {
    // Ok/Err remain contextual user function spellings, not reserved words.
    if f.name != Syntax.LIT_OK && f.name != Syntax.LIT_ERR -> snake(f.name, f.name_span, category, out)
    loop p in f.type_params -> type_parameter(p, out)
    loop p in f.params {
        if p.name != Syntax.KW_SELF -> snake(p.name, p.name_span, "parameter", out)
        if p.default == .Val(default) -> expr_names(default, out)
    }
    stmt_names(f.body, out)
}
// Rust: crates/jet-sema/src/Sema/Casing.rs:181
fn trait_method_names(m: TraitMethodSig, out: &[Diagnostic]) {
    snake(m.name, m.name_span, "method", out)
    loop p in m.params {
        if p.name != Syntax.KW_SELF -> snake(p.name, p.name_span, "parameter", out)
        if p.default == .Val(default) -> expr_names(default, out)
    }
    if m.default_body == .Val(body) -> stmt_names(body, out)
}
// Rust: crates/jet-sema/src/Sema/Casing.rs:196
fn item_names(item: Item, traits: HashSet<String>, out: &[Diagnostic]) {
    if item == {
        .EffectDecl(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        .Func(f) -> func_names(f, "function", out)
        .Struct(s) -> {
            pascal(s.name, s.name_span, "struct", out)
            loop p in s.type_params -> type_parameter(p, out)
            loop f in s.fields -> snake(f.name, f.name_span, "field", out)
            if s.state == .Val(state) { loop entry in state.states -> pascal(entry.name, entry.span, "state", out) }
            loop m in s.methods -> func_names(m, "method", out)
            loop b in s.trait_impls { loop m in b.methods -> func_names(m, "method", out) }
            stmt_names(s.validate_block, out)
        }
        .Enum(e) -> {
            pascal(e.name, e.name_span, "enum", out)
            loop p in e.type_params -> type_parameter(p, out)
            loop g in e.groups -> pascal(g.path, g.name_span, "variant group", out)
            loop v in e.variants {
                pascal(v.name, v.name_span, "enum variant", out)
                if v.payload == .Named(fields) { loop f in fields -> snake(f.name, f.name_span, "variant field", out) }
            }
            loop m in e.methods -> func_names(m, "method", out)
            loop b in e.trait_impls { loop m in b.methods -> func_names(m, "method", out) }
        }
        .Distinct(d) -> pascal(d.name, d.name_span, "distinct type", out)
        .TypeAlias(a) -> {
            pascal(a.name, a.name_span, "type alias", out)
            loop p in a.type_params -> type_parameter(p, out)
        }
        .UnitFamily(u) -> {
            pascal(u.family, u.family_span, "unit family", out)
            loop member in u.members { if member.name != "mmHg" -> snake(member.name, member.name_span, "unit member", out) }
        }
        .Trait(t) -> {
            pascal(t.name, t.name_span, "trait", out)
            loop entry in t.assoc_types -> pascal(entry.name, entry.span, "associated type", out)
            loop m in t.methods -> trait_method_names(m, out)
        }
        .Tag(t) -> pascal(t.name, t.name_span, "tag", out)
        .Impl(i) -> { loop m in i.methods -> func_names(m, "method", out) }
        .Const(c) -> {
            if c.mutable -> snake(c.name, c.name_span, "module variable", out)
            else -> screaming(c.name, c.name_span, "constant", out)
            expr_names(c.value, out)
        }
        .Test(t) -> {
            loop p in t.params -> snake(p.name, p.name_span, "parameter", out)
            stmt_names(t.body, out)
        }
        .Module(m) -> {
            snake(m.name, m.name_span, "module", out)
            loop source in m.sources -> snake(source.name, source.name_span, "config name", out)
            loop import in m.imports -> expr_names(import, out)
            loop member in m.members -> expr_names(member, out)
        }
        .CodeModule(m) -> {
            snake(m.name, m.name_span, "module", out)
            if m.body == .Val(body) { loop item in body -> item_names(item, traits, out) }
        }
        .GenericModule(m) -> {
            snake(m.name, m.name_span, "generic module", out)
            loop p in m.params {
                if p == {
                    .Type(name, span, _) -> pascal(name, span, "type parameter", out)
                    .Value(name, span, _) -> snake(name, span, "value parameter", out)
                }
            }
            loop item in m.body -> item_names(item, traits, out)
        }
        .ModuleAlias(m) -> snake(m.name, m.name_span, "module alias", out)
        .ProtocolDecl(p) -> {
            pascal(p.name, p.name_span, "protocol", out)
            loop m in p.messages {
                pascal(m.name, m.name_span, "protocol message", out)
                loop field in m.fields -> snake(field.name, m.span, "message field", out)
            }
        }
        .UserDerive(d) -> {
            pascal(d.trait_name, d.trait_span, "trait", out)
            derive_body_names(d.body, out)
        }
        .TemplateLoop(_) -> {}
        // Foreign declarations are exempt zones.
        .CModule(_) | .ExternRust(_) | .ErrorConv(_) | .Migration(_) -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/Casing.rs:355
fn derive_body_names(body: [DeriveBodyItem], out: &[Diagnostic]) {
    traits :: HashSet<String>{}
    loop item in body {
        if item == {
            .Item(item) -> item_names(item, traits, out)
            .Stmt(stmt) -> stmt_names([stmt], out)
            .Loop(_, _, source, body, _) -> { expr_names(source, out); derive_body_names(body, out) }
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Casing.rs:369
fn binding_name(b: Binding, out: &[Diagnostic]) {
    if b.pattern == .Val(pattern) {
        loop n in bind_pattern_names(pattern) {
            if n.rename == .Val(rename) -> snake(rename.name, rename.span, "local", out)
            else -> snake(n.name, n.span, "local", out)
        }
    } else -> snake(b.name, b.name_span, if b.is_comptime -> "local constant" else -> "local", out)
}
// Rust: crates/jet-sema/src/Sema/Casing.rs:389
fn stmt_names(stmts: [Stmt], out: &[Diagnostic]) {
    loop stmt in stmts {
        if stmt == {
            .Expr(e) | .Yield(e, _) | .DeferClose(e, _) -> expr_names(e, out)
            .Val(b) -> { binding_name(b, out); expr_names(b.init, out) }
            .Assign(target, _, _, value) -> {
                if target == {
                    .Index(base, index, _, _) -> { expr_names(base, out); expr_names(index, out) }
                    .Field(base, _, _) -> expr_names(base, out)
                    .Local(_, _) -> {}
                }
                expr_names(value, out)
            }
            .Return(value, _) -> { if value == .Val(value) -> expr_names(value, out) }
            .While(cond, body, _, _, label) -> {
                expr_names(cond, out)
                if label == .Val(label) -> snake(label.name, label.span, "loop label", out)
                stmt_names(body, out)
            }
            .Loop(body, _, _, label) -> {
                if label == .Val(label) -> snake(label.name, label.span, "loop label", out)
                stmt_names(body, out)
            }
            .For(var, var_span, var2, kind, body, _, _, label, _) -> {
                snake(var, var_span, "local", out)
                if var2 == .Val(second) -> snake(second.name, second.span, "local", out)
                if kind == {
                    .Range(start, end, step, _) -> {
                        expr_names(start, out)
                        expr_names(end, out)
                        if step == .Val(step) -> expr_names(step, out)
                    }
                    .In(collection, step) -> {
                        expr_names(collection, out)
                        if step == .Val(step) -> expr_names(step, out)
                    }
                }
                if label == .Val(label) -> snake(label.name, label.span, "loop label", out)
                stmt_names(body, out)
            }
            .Switch(subject, arms, else_body, _) | .ComptimeSwitch(subject, arms, else_body, _) -> {
                expr_names(subject, out)
                loop arm in arms { expr_names(arm.cond, out); stmt_names(arm.body, out) }
                if else_body == .Val(body) -> stmt_names(body, out)
            }
            .CountedLoop(init, cond, step, body, _, _, label) -> {
                binding_name(init, out)
                expr_names(init.init, out)
                expr_names(cond, out)
                if step == .Val(step) -> stmt_names([step], out)
                if label == .Val(label) -> snake(label.name, label.span, "loop label", out)
                stmt_names(body, out)
            }
            .Region(name, name_span, body, _) | .Layout(name, name_span, body, _) -> {
                snake(name, name_span, "local", out)
                stmt_names(body, out)
            }
            .TaskGroup(name, name_span, _, body, _) -> {
                snake(name, name_span, "local", out)
                stmt_names(body, out)
            }
            .Transact(name, name_span, body, _, _) -> {
                if name == .Val(name) && name_span == .Val(span) -> snake(name, span, "local", out)
                stmt_names(body, out)
            }
            .ComptimeIf(cond, _, then_body, else_body, _, _) -> {
                expr_names(cond, out)
                stmt_names(then_body, out)
                if else_body == .Val(body) -> stmt_names(body, out)
            }
            .ContextBlock(fields, body, _) -> {
                loop field in fields -> expr_names(field.value, out)
                stmt_names(body, out)
            }
            .ScopeMember(_, _, args, _, body, _, _, _) -> {
                loop arg in args -> expr_names(arg, out)
                stmt_names(body, out)
            }
            .AuthorityScope(_, _, binding, body, _) -> {
                if binding == .Val(binding) -> snake(binding.name, binding.span, "local", out)
                stmt_names(body, out)
            }
            .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .AssumeDet(_, _, body, _) -> stmt_names(body, out)
            .Reactive(body, _) | .Shield(body, _) | .Live(body, _) -> stmt_names(body, out)
            .Switched(_, body, _) | .Policy(_, body, _) | .ComptimeBlock(body, _, _) -> stmt_names(body, out)
            .BreakValue(value, _) | .BreakLabelValue(_, _, value, _) -> expr_names(value, out)
            .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Casing.rs:595
fn pattern_names(pattern: Pattern, out: &[Diagnostic]) {
    if pattern == {
        .Variant(_, bindings, _, _) -> { loop binding in bindings -> slot_names(binding, out) }
        .Present(binding, binding_span, inner, _) | .Ok(binding, binding_span, inner, _) | .Err(binding, binding_span, inner, _) -> {
            if inner == .Val(inner) -> pattern_names(inner, out)
            else -> snake(binding, binding_span, "pattern binding", out)
        }
        .Or(patterns, _) -> { loop pattern in patterns -> pattern_names(pattern, out) }
        .Struct(fields, _, _) -> {
            loop field in fields {
                if field == {
                    .Bind(_, _, local, local_span) -> snake(local, local_span, "pattern binding", out)
                    .Value(_, _, value) -> expr_names(value, out)
                }
            }
        }
        .StrMatch(parts, _) -> {
            loop part in parts { if part == .Hole(name, _, span) -> snake(name, span, "pattern binding", out) }
        }
        .BinMatch(parts, _) -> {
            loop part in parts { if part == .Hole(name, _, span) -> snake(name, span, "pattern binding", out) }
        }
        .Absent(_) | .Range(_, _, _) -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/Casing.rs:659
fn slot_names(slot: PatSlot, out: &[Diagnostic]) {
    if slot == {
        .Bind(name, span) -> snake(name, span, "pattern binding", out)
        .Nested(inner) -> pattern_names(inner, out)
        .Named(_, _, slot) -> slot_names(slot, out)
        .Wildcard | .Range(_, _) | .Rest(_) -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/Casing.rs:670
fn expr_names(expr: Expr, out: &[Diagnostic]) {
    if expr == {
        .Str(parts, _) -> { loop part in parts { if part == .Interp(value, _) -> expr_names(value, out) } }
        .StrMatchLit(parts, _) -> { loop part in parts { if part == .Hole(name, _, span) -> snake(name, span, "pattern binding", out) } }
        .BinMatchLit(parts, _) -> { loop part in parts { if part == .Hole(name, _, span) -> snake(name, span, "pattern binding", out) } }
        .Call(call) -> { loop arg in call.args -> expr_names(arg.expr, out) }
        .Unary(_, inner, _) | .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _) | .Place(inner, _, _) | .Field(inner, _, _) | .Tainted(inner, _, _) | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _) | .Paren(inner, _) | .Spread(inner, _) -> expr_names(inner, out)
        .Try(inner, _, _, note) -> {
            expr_names(inner, out)
            if note == .Val(note) -> expr_names(note, out)
        }
        .MemberSpread(base, _, _) | .OptField(base, _, _, _, _) -> expr_names(base, out)
        .MethodCall(receiver, _, _, _, _, args, _, _, _, _) -> {
            expr_names(receiver, out)
            loop arg in args -> expr_names(arg.expr, out)
        }
        .StructLit(_, _, _, _, fields, _, _) -> { loop field in fields -> expr_names(field.value, out) }
        .TypedLit(_, body, _) -> body.for_each_expr(fn(value) { expr_names(value, out) })
        .EnumLit(_, _, _, args, _, _) -> {
            loop arg in args { if arg == { .Positional(value) | .Named(_, value) -> expr_names(value, out) } }
        }
        .OrFallback(value, fallback, _, _) -> {
            expr_names(value, out)
            if fallback == {
                .Value(value) -> expr_names(value, out)
                .Return(value, _) -> { if value == .Val(value) -> expr_names(value, out) }
                .Block(body, value, _) -> {
                    stmt_names(body, out)
                    if value == .Val(value) -> expr_names(value, out)
                }
                .Panic(_, args) -> { loop arg in args -> expr_names(arg.expr, out) }
                .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
            }
        }
        .PatternTest(subject, pattern, _) -> { expr_names(subject, out); pattern_names(pattern, out) }
        .Binary(_, left, right, _) -> { expr_names(left, out); expr_names(right, out) }
        .CompareChain(operands, _, _, _) | .ListLit(operands, _) -> { loop value in operands -> expr_names(value, out) }
        .TupleLit(fields, _, _) -> { loop field in fields -> expr_names(field.value, out) }
        .MapLit(entries, _) -> { loop entry in entries { expr_names(entry.key, out); expr_names(entry.value, out) } }
        .Index(base, index, _, _) -> { expr_names(base, out); expr_names(index, out) }
        .Slice(base, start, end, range, _) -> {
            expr_names(base, out)
            if range == .Val(range) -> expr_names(range, out)
            else -> { expr_names(start, out); expr_names(end, out) }
        }
        .Range(start, end, _, _) -> { expr_names(start, out); expr_names(end, out) }
        .CallValue(callee, args, _) -> {
            expr_names(callee, out)
            loop arg in args -> expr_names(arg.expr, out)
        }
        .Lambda(lambda) -> {
            loop param in lambda.params -> snake(param.name, param.name_span, "lambda parameter", out)
            if lambda.body == { .Expr(value) -> expr_names(value, out); .Block(body) -> stmt_names(body, out) }
        }
        .If(cond, then_body, then_value, else_body, else_value, _) -> {
            expr_names(cond, out)
            stmt_names(then_body, out)
            expr_names(then_value, out)
            stmt_names(else_body, out)
            expr_names(else_value, out)
        }
        .PtrFromAddr(_, _, _, addr, _) -> expr_names(addr, out)
        .Char(_, _) | .Int(_, _, _, _) | .Float(_, _, _, _) | .Bool(_, _) | .Unit(_) | .Ident(_, _) | .UnitLit(_, _, _, _, _, _) | .Absent(_) | .Todo(_, _) | .NoElse(_) | .ReduceMarker(_, _) | .ComptimeName(_, _, _) -> {}
    }
}
