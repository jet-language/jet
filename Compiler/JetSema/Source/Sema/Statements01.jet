use jet_foundation.[Diagnostic, Stmt, Type]
use jet_sema.[Checker]
use jet_comptime.[CtValue, run_block_with_imports, evaluate_owned_with_imports_opts]

impl Checker {
    // Rust: crates/jet-sema/src/Sema/CheckerCore/control_flow.rs:6
    pub fn check_comptime_block(&self, stmt: &Stmt) Never! {
        if stmt != .ComptimeBlock -> return
        body :: &stmt.body
        saved_in_comptime :: self.in_comptime
        self.in_comptime = true
        self.check_block(&body, true)
        self.in_comptime = saved_in_comptime
        if self.defer_ct_evaluation -> return
        globals :: self.current_ct_globals()
        result :: run_block_with_imports(body, self.ct_checked_funcs_for_evaluation(), self.ct_externs, self.ct_base_dir, globals.as_ref(), self.core_imports)
        if result == {
            .Ok(scope) -> {
                current :: &self.ct_scopes.last_mut().unwrap()
                loop (name, value) in scope { current[^name] = ^value }
            }
            .Err(diagnostic) -> self.diags.push(^diagnostic)
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerCore/control_flow.rs:43
    pub fn check_comptime_if(&self, stmt: &Stmt) Never! {
        if stmt != .ComptimeIf -> return
        if self.defer_ct_evaluation {
            saved_in_comptime :: self.in_comptime
            self.in_comptime = true
            _ :: self.infer(&stmt.cond)
            saved_flow :: ~self.flow
            self.check_block(&stmt.then_body, true)
            self.flow = ~saved_flow
            if stmt.else_body == .Val(body) { self.check_block(&body, true) }
            self.flow = ^saved_flow
            self.in_comptime = saved_in_comptime
            stmt.selected_then = None
            return
        }
        globals :: self.current_ct_globals()
        selected_result :: evaluate_owned_with_imports_opts(stmt.cond, self.ct_checked_funcs_for_evaluation(), self.ct_externs, self.ct_base_dir, globals.as_ref(), self.core_imports, self.gates, self.ct_impure_depth)
        selected := false
        if selected_result == {
            .Ok(.Bool(value)) -> selected = value
            .Ok(_) -> {
                self.diags.push(Diagnostic.error("E0989", "a `prep if` condition must be " + Type.Bool.show() + ", not another type", "the condition selects a branch at compile time — it must be true or false", "write a Bool known-time expression, like `prep if flag { … }`", Val(stmt.cond_span)))
                return
            }
            .Err(_) -> {
                self.diags.push(Diagnostic.error("E0989", "this `prep if` condition can't be known at compile time", "a `prep if` condition must be a known-time expression — a prepared value, a literal, or a pure function call with known arguments (D-WHEN1)", "prepare the value first: `flag :: prep { … }`, then write `prep if flag { … }`", Val(stmt.cond_span)))
                return
            }
        }
        stmt.selected_then = Val(selected)
        if selected { self.check_block(&stmt.then_body, true) }
        else if stmt.else_body == .Val(body) { self.check_block(&body, true) }
        dropped_arm :: if selected { stmt.else_body.as_mut() } else { Val(&stmt.then_body) }
        if dropped_arm == .Val(dropped) {
            diagnostic_start :: self.diags.len()
            previous :: self.in_dropped_comptime_arm
            // D-FACT-FLOW1: the dropped arm resolves names, but contributes no flow facts.
            facts :: ~self.flow
            self.in_dropped_comptime_arm = true
            self.check_block(&dropped, true)
            self.in_dropped_comptime_arm = previous
            self.flow = ^facts
            diagnostics :: self.diags.drain(diagnostic_start..).collect()
            loop diagnostic in diagnostics {
                if diagnostic.code == "E0107" || diagnostic.code == "E0102" { self.diags.push(^diagnostic) }
            }
        }
    }
}
