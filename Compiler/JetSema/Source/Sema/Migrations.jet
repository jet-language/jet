use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    CallArg,
    Expr,
    Func,
    MigrationDecl,
    MigrationOp,
    Param,
    ParamZone,
    Span,
    Stmt,
    StructDef,
    Type,
    ast_empty_call_arg_flags,
    ast_func,
    type_name,
]

SemaMigrationFieldName: struct {
    field: String
    json_key: String
}

SemaMigrationCanonicalShape: struct {
    names: [SemaMigrationFieldName]
    current: [String]
    historical: [[String]]
    skipped: [String]
}

sema_migration_insert_sorted: fn(values: [String], value: String) -> [String] Never! {
    result := [String]{}
    inserted := false
    loop current in values {
        if current == value -> return values.copy()
        if !inserted && current > value {
            result.push(value.copy())
            inserted = true
        }
        result.push(current.copy())
    }
    if !inserted -> result.push(value.copy())
    result
}

sema_migration_remove: fn(values: [String], value: String) -> [String] Never! {
    result := [String]{}
    loop current in values {
        if current != value -> result.push(current.copy())
    }
    result
}

sema_migration_wire_name: fn(style: String?, name: String) -> String Never! {
    sema_checked_wire_case(style, name)
}

sema_migration_json_key: fn(definition: StructDef, style: String?, name: String) -> String Never! {
    loop field_index in 0..<definition.fields.len() {
        if definition.fields[field_index].name == name {
            names := sema_checked_field_shape_names(definition, definition.fields[field_index])
            return names.json ?? names.text
        }
    }
    sema_migration_wire_name(style, name)
}

sema_migration_canonical_shape: fn(definition: StructDef, migrations: [MigrationDecl]) -> SemaMigrationCanonicalShape Never! {
    style := sema_checked_rename_case(definition.serde_markers)
    names := [SemaMigrationFieldName]{}
    current := [String]{}
    skipped := [String]{}
    loop field_index in 0..<definition.fields.len() {
        key := sema_migration_json_key(definition, style, definition.fields[field_index].name)
        names.push(SemaMigrationFieldName{field: definition.fields[field_index].name, json_key: key})
        if {
            sema_checked_marker(definition.fields[field_index].serde_markers, "Skip") != None -> skipped = sema_migration_insert_sorted(skipped, key)
            else -> current = sema_migration_insert_sorted(current, key)
        }
    }
    historical_reverse := [[String]]{}
    shape := current
    block_index := migrations.len()
    loop block_index > 0 {
        block_index -= 1
        migration := migrations[block_index]
        loop operation in migration.ops {
            if operation == {
                .Add(field, _, _, _, _, _, _) -> shape = sema_migration_remove(shape, sema_migration_json_key(definition, style, field))
                .Remove(field, _) -> shape = sema_migration_insert_sorted(shape, sema_migration_json_key(definition, style, field))
                .Rename(from, _, to, _) -> {
                    shape = sema_migration_remove(shape, sema_migration_json_key(definition, style, to))
                    shape = sema_migration_insert_sorted(shape, sema_migration_json_key(definition, style, from))
                }
                .Change(_, _, _, _, _, _, _, _, _) -> {}
            }
        }
        historical_reverse.push(shape.copy())
    }
    historical := [[String]]{}
    index := historical_reverse.len()
    loop index > 0 {
        index -= 1
        historical.push(historical_reverse[index])
    }
    SemaMigrationCanonicalShape{names: names, current: current, historical: historical, skipped: skipped}
}

sema_migration_default_function: fn(name: String, ty: Type, default: Expr, span: Span) -> Func Never! {
    function := ast_func(name, span, span)
    function.return_type = Val(ty)
    function.return_type_span = Val(span)
    function.body = [Stmt]{Stmt.Return{value: Val(default), span: span}}
    function
}

sema_migration_callable_converter_function: fn(name: String, old_ty: Type, new_ty: Type, converter: Expr, span: Span) -> Func Never! {
    argument := CallArg{
        convention: AccessConvention.Move,
        expr: Expr.Ident{name: "__old", span: span, id: AST_NODE_GENERATED},
        span: span,
        flags: ast_empty_call_arg_flags(),
        label: None,
        spread: false,
    }
    call := Expr.CallValue{callee: converter, args: [CallArg]{argument}, span: span, id: AST_NODE_GENERATED}
    function := ast_func(name, span, span)
    function.params = [Param]{Param{
        convention: AccessConvention.Move,
        root: false,
        name: "__old",
        name_span: span,
        public_label: None,
        zone: ParamZone.Either,
        ty: old_ty,
        ty_span: span,
        default: None,
        variadic: false,
        variadic_bound_list: None,
        declared_view_from_names: None,
        declared_footprint: None,
    }}
    function.return_type = Val(new_ty)
    function.return_type_span = Val(span)
    function.body = [Stmt]{Stmt.Return{value: Val(call), span: span}}
    function
}

sema_migration_converter_function: fn(name: String, old_ty: Type, new_ty: Type, converter: Expr, span: Span) -> Func Never! {
    if converter == {
        .Lambda(lambda, _) -> if lambda.params.len() == 1 {
            parameter := lambda.params[0]
            body := if lambda.body == {
                .Expr(value) -> [Stmt]{Stmt.Return{value: Val(value), span: span}}
                .Block(statements) -> statements
            }
            function := ast_func(name, span, span)
            function.params = [Param]{Param{
                convention: AccessConvention.Move,
                root: false,
                name: parameter.name,
                name_span: parameter.name_span,
                public_label: None,
                zone: ParamZone.Either,
                ty: old_ty,
                ty_span: span,
                default: None,
                variadic: false,
                variadic_bound_list: None,
                declared_view_from_names: None,
                declared_footprint: None,
            }}
            function.return_type = Val(new_ty)
            function.return_type_span = Val(span)
            function.body = body
            return function
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    sema_migration_callable_converter_function(name, old_ty, new_ty, converter, span)
}

