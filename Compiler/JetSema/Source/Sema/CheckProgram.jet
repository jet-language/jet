// Module-level declaration registration followed by function body checking.
// The result explicitly reports when a source form lies beyond this checker
// slice so consumers cannot treat its checked tree as a complete semantic program.
use jet_foundation.[
    BodyExpr,
    BodyTree,
    FnBody,
    MARKER_CLI,
    MARKER_FX,
    MARKER_SCALAR,
    NodeKind,
    TBuiltinOp,
    jet_ring_core_module_layer,
    jet_ring_layer_name,
    jet_ring_prelude_closure_layer,
    body_tree_new,
    AST_NODE_GENERATED,
    AccessConvention,
    ResolvedOutput,
    CompilerThreads,
    CompilerTraceSink,
    ContractClause,
    DIAGNOSTIC_ERROR,
    DIAGNOSTIC_LINT,
    Diagnostic,
    ast_binding,
    ast_func,
    ConstDef,
    SemaNameCase,
    sema_casing_has_case,
    core_module_export,
    classify_identifier,
    IdentifierClass,
    Expr,
    Func,
    Item,
    NameAlias,
    NameDeclaration,
    NameDisplayPath,
    NameFacts,
    NameModule,
    NameReference,
    NameVisibility,
    RuntimeLayer,
    StructureFact,
    StructureFactKind,
    TargetHardwareUse,
    Marker,
    MetaAttr,
    NamedSpan,
    NameRows,
    NameTable,
    name_index,
    name_intern,
    name_rows,
    name_rows_get_text,
    name_rows_set,
    name_table,
    Param,
    Program,
    Span,
    StateDecl,
    Stmt,
    Symbol,
    SymbolID,
    SymbolKind,
    TComptimeValue,
    TConstantDef,
    TDeclarationFacts,
    TEffectFacts,
    TEffectSpan,
    TFailureCarrier,
    TFuncKind,
    TGenericParam,
    TTestFact,
    TAppliedRule,
    TTypeDef,
    TUnsafeGate,
    TVisibility,
    TWebParamReconstruction,
    Type,
    ViewProvenance,
    ViewProvenanceEntry,
    ViewProvenanceMap,
    ViewSource,
    ViewSourcePath,
    ViewSourceProjection,
    compiler_take_rows,
    compiler_threads_admit,
    compiler_threads_failure_text,
    compiler_threads_partition,
    compiler_transfer_rows,
    effect_scope_descriptor,
    expr_span,
    symbol_id,
    checked_expr_type_id,
    checked_symbol_local,
    checked_test_artifact_fact,
    type_name,
    type_with_effective_parameter_fn_return,
    CodeModule,
    EnumDef,
    ImplDef,
    StructDef,
    TraitImplBlock,
    FactDecl,
    compiler_threads_heaviest_first,
    owned_trait_codec_marker,
    owned_trait_bounds_pure,
]

// Exact registered APIs without a browser host provider. The compiler witness
// pins this list against Rust TargetSurface and rejects unknown Core members.
sema_web_host_unsupported_core_apis: fn() -> [String] Never! {
    [String]{
        "core.auth::magic_link_consume",
        "core.auth::magic_link_issue",
        "core.auth::oauth_begin",
        "core.auth::oauth_finish",
        "core.auth::password_login",
        "core.auth::register_user",
        "core.auth::session_validate",
        "core.sys::decode",
        "core.sys::expand",
        "core.sys::get",
        "core.sys::getenv",
        "core.sys::home_dir",
        "core.sys::set",
        "core.sys::temp_dir",
        "core.sys::unset",
        "core.sys::vars",
    }
}

sema_web_host_check_core_usage: fn(target_name: String, used_core: [String], diagnostics: &[Diagnostic]) -> Bool Never! {
    if target_name != "wasm.browser" -> return true
    unsupported: sema_web_host_unsupported_core_apis()
    complete := true
    loop usage in used_core {
        if !unsupported.contains(usage) -> next
        operation: usage.replace("::", ".")
        diagnostics.push(sema_error_optional("E-WEB-UNSUPPORTED", None,
            "Web output cannot compile `{operation}` yet.",
            "this Core operation needs a host provider that the browser target does not supply",
            "move this operation behind a native or server boundary"))
        complete = false
    }
    complete
}

// Reuses TargetSurface from 371361c3e against current registration facts.
sema_target_is_socket_surface: fn(path: String) -> Bool Never! {
    if path == {
        "core.net" | "core.net.tls" | "core.net.ws" | "core.http" | "core.http.client" | "core.http.server" -> true
        else -> false
    }
}

sema_target_socket_surface: fn(path: String) -> String? Never! {
    if sema_target_is_socket_surface(path) -> return Val(path)
    if core_module_export(path) != None -> return None
    separator: path.rfind(".")
    if separator < 0 -> return None
    owner: path.slice(0, separator)
    if sema_target_is_socket_surface(owner) -> Val(owner) else -> None
}

sema_target_wasip2_unsupported_operations: fn(used_core: [String]) -> [String] Never! {
    operations := [String]{}
    loop usage in used_core {
        separator: usage.find("::")
        if separator < 0 -> next
        module_name: usage.slice(0, separator)
        member: usage.slice(separator + 2, usage.len())
        unsupported: if module_name == {
            "core.net" -> if member == {
                "tcp_connect_happy" | "tcp_ready" | "udp_ready" | "tls_connect" | "tls_read" | "tls_write" | "tls_close" | "dns_a" | "dns_aaaa" | "dns_txt" | "dns_ptr" | "dns_srv" -> true
                else -> member.starts_with("unix_")
            }
            "core.http" -> member == "get" || member == "post" || member == "request"
            "core.http.server" -> member == "tls"
            "core.net.tls" | "core.http.client" -> true
            else -> false
        }
        if unsupported -> sema_core_string_add(operations, "{module_name}.{member}")
    }
    operations
}

sema_target_check_socket_surfaces: fn(graph: SemaRegistrationGraph, used_core: [String], diagnostics: &[Diagnostic]) -> Bool Never! {
    target: if graph.target_machine.name == "wasm.browser" -> "web" else -> graph.target_machine.triple
    wasip2: target == "wasm32-wasip2"
    socket_target: wasip2 || target.contains("linux") || target.contains("android") || target.contains("apple") || target.contains("darwin") || target.contains("windows") || target.contains("freebsd") || target.contains("openbsd") || target.contains("netbsd")
    if socket_target && !wasip2 -> return true
    operations: if wasip2 -> sema_target_wasip2_unsupported_operations(used_core) else -> [String]{}
    seen := [String:Bool]{}
    complete := true
    loop module_row_index in 0..<graph.modules.len() {
        // The surface is the one the program's own `use` names. Core's
        // imports are its implementation: which of that code a target reaches
        // is settled where Core gates it on the target (`#build.target.os`,
        // `#Target`) and by the denial row of the target's `core.target` facts.
        if sema_module_is_core_source(graph.modules[module_row_index].module_identity) -> next
        diagnostic_start: diagnostics.len()
        loop imported_index in 0..<graph.modules[module_row_index].imports.len() {
            path := graph.modules[module_row_index].imports[imported_index].target_module_identity
            if sema_registration_module_index(graph, path) == .Val(index) -> path = graph.modules[index].module_name
            surface: sema_target_socket_surface(path) ?? next
            span: if graph.modules[module_row_index].imports[imported_index].declaration.kind == {
                .Unqualified(_, _, _, items_span, _) -> items_span
                .File(_, _) | .Module(_, _) -> graph.modules[module_row_index].imports[imported_index].declaration.alias_span
            }
            key: "{graph.modules[module_row_index].module_identity}:{span.start}:{span.end}:E3304"
            if !socket_target && seen.get(key) == None {
                seen[key] = true
                diagnostics.push(sema_error("E3304", span, "`{surface}` is not available for target `{target}`.", "`{surface}` needs native sockets or WASI Preview 2 sockets, and this target provides neither runtime boundary. A `jet build` or `jet run` run reports this target-support diagnostic.", "Build for `wasm32-wasip2` or a supported native target, or remove the `{surface}` import."))
                complete = false
            }
            if !wasip2 -> next
            unsupported_surface: surface == "core.net.tls" || surface == "core.net.ws" || surface == "core.http.client"
            if unsupported_surface {
                operation_key: "{graph.modules[module_row_index].module_identity}:{span.start}:{span.end}:E3305:{surface}"
                if seen.get(operation_key) == None {
                    seen[operation_key] = true
                    diagnostics.push(sema_error("E3305", span, "`{surface}` is not available for target `{target}`.", "The selected target has no Prelude adapter for `{surface}`; WASI Preview 2 provides TCP/UDP sockets but not this operation. A `jet build` or `jet run` run reports this target-support diagnostic.", "use a supported TCP/UDP operation, or build for a native target."))
                    complete = false
                }
            }
            loop operation in operations {
                separator: operation.rfind(".")
                if separator < 0 || operation.slice(0, separator) != surface -> next
                operation_key: "{graph.modules[module_row_index].module_identity}:{span.start}:{span.end}:E3305:{operation}"
                if seen.get(operation_key) != None -> next
                seen[operation_key] = true
                diagnostics.push(sema_error("E3305", span, "`{operation}` is not available for target `{target}`.", "The selected target has no Prelude adapter for `{operation}`; WASI Preview 2 provides TCP/UDP sockets but not this operation. A `jet build` or `jet run` run reports this target-support diagnostic.", "use a supported TCP/UDP operation, or build for a native target."))
                complete = false
            }
        }
        sema_attach_diagnostic_source_locations(diagnostics, diagnostic_start, graph.modules[module_row_index].source_segments)
    }
    complete
}

SemaResult: struct {
    module_name: String
    functions: [FnBody]
    call_facts: [SemaCallSiteFact]
    hardware_use: TargetHardwareUse
    name_references: [SemaNameReferenceFact]
    comptime_requests: [SemaComptimeRequest]
    comptime_body_sources: [SemaComptimeBodySource]
    compute_facts: [SemaComputeFunctionFacts]
    exact_int_reachable: Bool
    copy_events: [SemaCopyEvent]
    diagnostics: [Diagnostic]
    complete: Bool
}

SemaGraphModuleResult: struct {
    module_identity: String
    module_name: String
    package_identity: String
    module_path: String
    source_file: String
    declarations: TDeclarationFacts
    // This module's checked functions as flat bodies: each function check
    // seals and flattens its own tree (sema_function_check_pass), so sema's
    // whole-program passes and every later package read only these.
    functions: [FnBody]
    nominals: [SemaRegistrationNominal]
    // Position in `nominals` of the first nominal per declared name, so a
    // nominal spelling resolves without scanning every module's nominals.
    nominal_positions: [String:Int]
    constants: [SemaRegistrationConstant]
    impls: [SemaRegistrationImpl]
    exports: [SemaRegistrationExport]
    imports: [SemaRegistrationImport]
    foreign_functions: [SemaCheckedForeignFunction]
    foreign_providers: [SemaCheckedForeignProvider]
    call_facts: [SemaCallSiteFact]
    hardware_use: TargetHardwareUse
    name_references: [SemaNameReferenceFact]
    comptime_requests: [SemaComptimeRequest]
    comptime_body_sources: [SemaComptimeBodySource]
    compute_facts: [SemaComputeFunctionFacts]
    exact_int_reachable: Bool
    copy_events: [SemaCopyEvent]
    diagnostics: [Diagnostic]
    complete: Bool
    // #3708: the failure rows of this module's checked top-level functions.
    failure_facts: [SemaFunctionFailureFacts]{[SemaFunctionFailureFacts]{}}
    // Why `complete` is false, one line per cause, so a no-diagnostic
    // incomplete module still names what stopped it.
    incomplete_reasons: [String]{[String]{}}
    // Keys of the Prelude error conversions sema injected
    // into this module after its bodies. They have no registration row (the
    // Rust reference pushes them as module items), so the driver's identity
    // check admits exactly these keys beside the registered declarations.
    injected_function_keys: [String]{[String]{}}
    // Test mode (Rust `CompileMode::Test`): one fact per named `#Test` of this
    // module whose body checked, in declaration order; the checked synthetic
    // function is in `functions` and its key in `injected_function_keys`.
    tests: [TTestFact]{[TTestFact]{}}
}

// #3708: what one checked function body propagates: the keys of the declared
// functions whose failures pass up ("" for a source of its own) and whether a
// statement or returned value is a direct failure source.
SemaFunctionFailureFacts: struct {
    function_key: String
    direct: Bool
    edges: [String]
    // This body's default-route row.
    union_members: [Type]{[Type]{}}
    union_cases: [SemaFailureCase]{[SemaFailureCase]{}}
    union_edges: [String]{[String]{}}
    union_general: Bool{false}
}

SemaComptimeItemKind: enum {
    Constant
    MarkerArgument
    FieldDefault
    TypeLevel
    CheckedText
    BodyExpression
}

SemaComptimeItemSource: struct {
    module_identity: String
    key: String
    destination_key: String
    name: String
    source_file: String
    kind: SemaComptimeItemKind
    expression: Expr
    expected_type: Type?
    span: Span
    dependencies: [String]
    checked_text: SemaCheckedTextEvaluation?
    // A FieldDefault of a struct that bakes its defaults (Codable, Decode,
    // Encode, CLI): Rust CheckerMarkers reports E2414 when it cannot evaluate.
    baked_default: Bool{false}
    // An immutable module-level `NAME: expr` whose value is not literal data:
    // computed while building when its evaluation is pure and succeeds, and
    // refused otherwise (E0643, jet_driver_module_value_refused).
    module_value: Bool{false}
    // A refused module value's check as ordinary code, outside compile-time
    // execution, which reports its real errors.
    runtime_check: Bool{false}
    // An immutable local `name: value` that calls code: computed while
    // compiling when that succeeds, and otherwise left to run time without a
    // report; its landed value is then `.Failed` with the reason as text
    // (sema_comptime_local_value_failure).
    local_value: Bool{false}
    // A body site's prepared locals, declared before its expression is checked.
    prepared: [SemaComptimePreparedLocal]{[SemaComptimePreparedLocal]{}}
    // A body site lexically inside an `#Impure` block: its Tier-2 effects
    // need the invocation gate (E3411), not the block (E3410).
    impure: Bool{false}
    // A body site's run-time locals and parameters, which its staged check
    // names as run-time values (E0640) when the code reads one.
    runtime_locals: [String]{[String]{}}
}

SemaComptimeItemRequest: struct {
    module_identity: String
    key: String
    destination_key: String
    source_file: String
    kind: SemaComptimeItemKind
    // The item expression's flat form (sema_publish_expression).
    expression: BodyExpr
    expected_type: Type?
    span: Span
    dependencies: [String]
    calls: [SemaComptimeRequest]
    hardware_use: TargetHardwareUse
    reachable_function_keys: [String]
    // The item expression's own call sites (a module value's purity reads them).
    call_facts: [SemaCallSiteFact]{[SemaCallSiteFact]{}}
    // The item expression's first call with a host effect, as a refused
    // comptime effect names it (sema_effect_comptime_call_name).
    effect_call: String?{None}
}

SemaComptimeItemValue: struct {
    module_identity: String
    key: String
    destination_key: String
    kind: SemaComptimeItemKind
    value: TComptimeValue
    ty: Type
    // A module `Shared{X}` holder (sema_comptime_shared_payload): `value` is
    // the payload the build folded, `ty` the holder's Shared type.
    shared_holder: Bool{false}
}

sema_comptime_body_value_from_item: fn(value: SemaComptimeItemValue) -> SemaComptimeBodyValue Never! {
    SemaComptimeBodyValue{
        module_identity: value.module_identity,
        key: value.key,
        destination_key: value.destination_key,
        value: value.value,
        ty: value.ty,
    }
}

sema_comptime_body_values_from_items: fn(values: [SemaComptimeItemValue]) -> [SemaComptimeBodyValue] Never! {
    result := [SemaComptimeBodyValue]{}
    loop value in values {
        if value.kind != SemaComptimeItemKind.BodyExpression -> next
        result.push(sema_comptime_body_value_from_item(value))
    }
    result
}

SemaRegistrationPackagePolicy: struct {
    package_identity: String
    authority_allow: [String]?
    authority_deny: [String]?
    authority_needs: [String]
    runtime_ceiling: RuntimeLayer?
    edition: String
    // The organization policy's `authority: { deny: [...] }`, carried on the
    // root package's row, and the policy file it names.
    organization_deny: [String]{[String]{}}
    organization_source: String{""}
}

SemaComptimeDeclarationStage: struct {
    modules: [SemaGraphModuleResult]
    imports: [SemaRegistrationImport]
    package_policies: [SemaRegistrationPackagePolicy]
    names: NameFacts
    sources: [SemaComptimeItemSource]
    diagnostics: [Diagnostic]
    complete: Bool
    // The registration graph the declaration pass moved into its program
    // tables, unchanged, handed to the comptime run (jet_driver_run_comptime
    // `staged`) so no one copies it; None once taken.
    graph: SemaRegistrationGraph?{None}
    // The declaration pass's boxed edges and copy facts of `graph`, handed
    // with it to the comptime run's environment (sema_comptime_environment)
    // so it does not compute them again; None once taken.
    graph_facts: SemaComptimeGraphFacts?{None}
}

// The facts the program tables derive from a registration graph alone
// (sema_scope_environment_boxed_edges, sema_copy_facts_table).
SemaComptimeGraphFacts: struct {
    boxed_edges: [String:[String]]
    copy_facts: SemaCopyFactsTable
}

SemaComptimeItemCheck: struct {
    request: SemaComptimeItemRequest?
    dependencies: [String]
    waiting_dependencies: [String]
    diagnostics: [Diagnostic]
    complete: Bool
    // A precheck's literal fold of its call-free request with no landed
    // values (sema_comptime_precheck_fold); None when it did not fold.
    folded: TComptimeValue?{None}
}

SemaComptimeFunctionResult: struct {
    module_identity: String
    function_key: String
    // The checked body (sema_function_check_pass flattens it).
    function: FnBody?
    waiting_dependencies: [String]
    calls: [SemaComptimeRequest]
    reachable_function_keys: [String]
    call_facts: [SemaCallSiteFact]
    hardware_use: TargetHardwareUse
    name_references: [SemaNameReferenceFact]
    comptime_body_sources: [SemaComptimeBodySource]
    compute_facts: SemaComputeFunctionFacts
    diagnostics: [Diagnostic]
    exact_int_reachable: Bool
    copy_events: [SemaCopyEvent]
    complete: Bool
    // Why an incomplete result has no diagnostic, for the driver's report.
    incomplete_reasons: [String]{[String]{}}
    // #3708: the body's failure row, which the bundle solve and a comptime
    // closure's solve read (sema_comptime_failure_closure_settle).
    failure: SemaFunctionFailureFacts?{None}
    // Incomplete only because of failure obligations against unannotated
    // callees: a solve over the callees' rows discharges or emits them.
    obligations_pending: Bool{false}
    // An inline foreign (`#FFI`) function's checked foreign row: it has no
    // Jet body to check, and a compile-time call of it stops the run.
    foreign: SemaCheckedForeignFunction?{None}
}

// A checked item expression as a flat body of its own; its Flat nodes are
// rows of `arena`, the checking context's.
sema_publish_expression: fn(value: TExpr, arena: BodyTree) -> BodyExpr Never! {
    flat := BodyFlat{tree: body_tree_new(), arena: arena, into_arena: false}
    root: body_flat_expr(value, flat)
    tree := flat.tree.move()
    body_tree_finish(tree)
    BodyExpr{root: root, tree: tree.move()}
}

SemaGraphResult: struct {
    package_identity: String
    entry_module_identity: String
    modules: [SemaGraphModuleResult]
    imports: [SemaRegistrationImport]
    package_policies: [SemaRegistrationPackagePolicy]
    core_usage: SemaCoreUsageResult
    call_facts: [SemaCallSiteFact]
    hardware_use: TargetHardwareUse
    comptime_requests: [SemaComptimeRequest]
    comptime_body_sources: [SemaComptimeBodySource]
    compute_facts: [SemaComputeFunctionFacts]
    names: NameFacts
    diagnostics: [Diagnostic]
    complete: Bool
    // #3708: the unannotated top-level functions the bundle failure solve
    // proved infallible, by symbol key.
    inferred_infallible: [String]{[String]{}}
    // The registration graph finalization checked against (values and
    // failure projections applied), handed back by sema_finalize_graph so its
    // caller can undo the edits (sema_graph_trail_undo); None otherwise.
    registration_graph: SemaRegistrationGraph?{None}
    // `SemaRegistrationGraph.retain_programs`: each module's program as sema
    // settled it, indexed like `modules`; empty otherwise.
    programs: [Program]{[Program]{}}
    outputs: [ResolvedOutput]{[ResolvedOutput]{}}
    memory_declarations: [SemaMemoryFactDeclaration]{[SemaMemoryFactDeclaration]{}}
    memory_projections: [SemaMemoryProjectionRow]{[SemaMemoryProjectionRow]{}}
}

sema_name_facts_empty: fn() -> NameFacts Never! {
    NameFacts{modules: [NameModule]{}, declarations: [NameDeclaration]{}, aliases: [NameAlias]{}, references: [NameReference]{}, structure_facts: [StructureFact]{}}
}

// Invocation-memory body memo, owned by the compiler's existing root service.
// It never replaces registration, summaries or the whole-program verdict.
SemaIncrementalCache: struct {
    state: Shared<SemaIncrementalState>
}

SemaIncrementalStats: struct {
    hits: Int
    recomputes: Int
    live_items: Int
    // Retained key/input and exhaustive Debug product UTF-8 bytes, not allocator RSS.
    live_item_bytes: Int
    recomputed_items: [String]
}

SemaBodyMemoValue: struct {
    checked: SemaFunctionResult
    diagnostics: [Diagnostic]
    call_facts: [SemaCallSiteFact]
    comptime_requests: [SemaComptimeRequest]
    name_references: [SemaNameReferenceFact]
    method_input: SemaMethodInput?
}

SemaCachedBody: struct {
    module_identity: String
    generation: Int
    epoch: Int
    input: String
    value: SemaBodyMemoValue
    bytes: Int
}

SemaIncrementalState: struct {
    frozen: String
    generation: Int
    next_epoch: Int
    scope_inputs: [String:String]
    scope_epochs: [String:Int]
    rows: [String:SemaCachedBody]
    frozen_bytes: Int
    row_bytes: Int
    hits: Int
    recomputes: Int
    recomputed_items: [String]
}

SemaModuleMemo: struct {
    cache: SemaIncrementalCache
    module_identity: String
    generation: Int
    epoch: Int
}

// A descriptor is not a checked product. The owning thread accepts a replay
// only while its frozen epoch and exact input still match the retained row.
SemaBodyMemoQuery: struct {
    module_memo: SemaModuleMemo
    key: String
    input: String
    eligible: Bool
    replay: Bool
}

sema_incremental_cache_new: fn() -> SemaIncrementalCache {
    SemaIncrementalCache{state: Shared{SemaIncrementalState{
        frozen: "", generation: 0, next_epoch: 0,
        scope_inputs: [String:String]{}, scope_epochs: [String:Int]{},
        rows: [String:SemaCachedBody]{}, frozen_bytes: 0, row_bytes: 0,
        hits: 0, recomputes: 0, recomputed_items: [String]{},
    }}}
}

sema_incremental_cache_clear_measurement: fn(cache: SemaIncrementalCache) {
    permit := cache.state.guard_edit()
    permit.value.recomputed_items = [String]{}
}

sema_incremental_cache_stats: fn(cache: SemaIncrementalCache) -> SemaIncrementalStats {
    permit: cache.state.guard_read()
    SemaIncrementalStats{
        hits: permit.value.hits, recomputes: permit.value.recomputes,
        live_items: permit.value.rows.len(),
        live_item_bytes: permit.value.frozen_bytes + permit.value.row_bytes,
        recomputed_items: permit.value.recomputed_items,
    }
}

sema_incremental_evict_module: fn(state: &SemaIncrementalState, module_identity: String) {
    keys := [String]{}
    loop (key, row) in state.rows {
        if row.module_identity == module_identity -> keys.push(key.copy())
    }
    loop key in keys {
        removed := state.rows.remove(key)
        if removed == .Val(row) -> state.row_bytes -= row.bytes
    }
}

sema_incremental_freeze_scope: fn(cache: SemaIncrementalCache, module_identity: String, input: &&String) -> SemaModuleMemo {
    permit := cache.state.guard_edit()
    previous: permit.value.scope_inputs.get(module_identity)
    if previous != Val(input) {
        sema_incremental_evict_module(permit.value, module_identity)
        if previous == .Val(old) -> permit.value.frozen_bytes -= old.count_bytes()
        else -> permit.value.frozen_bytes += module_identity.count_bytes()
        permit.value.frozen_bytes += input.count_bytes()
        permit.value.scope_inputs[module_identity] = input.move()
        permit.value.next_epoch += 1
        permit.value.scope_epochs[module_identity] = permit.value.next_epoch
    }
    SemaModuleMemo{cache: cache, module_identity: module_identity, generation: permit.value.generation, epoch: permit.value.scope_epochs.get(module_identity) ?? panic("a frozen module has no epoch")}
}

sema_incremental_advance_scope: fn(memo: &SemaModuleMemo) {
    permit := memo.cache.state.guard_edit()
    if permit.value.generation != memo.generation -> return
    sema_incremental_evict_module(permit.value, memo.module_identity)
    old: permit.value.scope_inputs.get(memo.module_identity) ?? ""
    permit.value.frozen_bytes -= old.count_bytes()
    // The changed scope is a new epoch of this compile, not the next request's
    // unchanged initial scope. Force an exact freeze before future reuse.
    permit.value.scope_inputs[memo.module_identity] = ""
    permit.value.next_epoch += 1
    memo.epoch = permit.value.next_epoch
    permit.value.scope_epochs[memo.module_identity] = memo.epoch
}

sema_incremental_publication: fn(memo: &SemaModuleMemo?) {
    if memo == .Val(current) {
        next := current
        sema_incremental_advance_scope(next)
        memo = Val(next.move())
    }
}

sema_incremental_query: fn(memo: SemaModuleMemo, key: String, input: &&String, eligible: Bool) -> SemaBodyMemoQuery {
    replay := false
    permit: memo.cache.state.guard_read()
    if eligible && permit.value.generation == memo.generation && (permit.value.scope_epochs.get(memo.module_identity) ?? -1) == memo.epoch {
        if permit.value.rows.has_key(key) {
            replay = permit.value.rows[key].generation == memo.generation && permit.value.rows[key].epoch == memo.epoch && permit.value.rows[key].input == input
        }
    }
    SemaBodyMemoQuery{module_memo: memo, key: key, input: input.move(), eligible: eligible, replay: replay}
}

sema_incremental_retarget: fn(query: &&SemaBodyMemoQuery?, memo: SemaModuleMemo?) -> SemaBodyMemoQuery? {
    current := query.move() ?? return None
    if memo == .Val(module_memo) -> current.module_memo = module_memo
    current.replay = false
    Val(current.move())
}

sema_incremental_replay: fn(query: SemaBodyMemoQuery) -> SemaBodyMemoValue? {
    permit := query.module_memo.cache.state.guard_edit()
    if permit.value.generation != query.module_memo.generation || (permit.value.scope_epochs.get(query.module_memo.module_identity) ?? -1) != query.module_memo.epoch -> return None
    if !permit.value.rows.has_key(query.key) -> return None
    row: permit.value.rows[query.key]
    if row.generation != query.module_memo.generation || row.epoch != query.module_memo.epoch || row.input != query.input -> return None
    // copy: the memo row stays cached under the edit guard for later hits, and the replay returns
    // an owned value to its caller.
    value := row.value.copy()
    permit.value.hits += 1
    Val(value.move())
}

sema_incremental_accept: fn(query: SemaBodyMemoQuery, body: SemaParallelBody) {
    // Exactly one accepted initial logical query, including failed/volatile
    // checks; worker and owning-thread retries do not add separate counters.
    permit := query.module_memo.cache.state.guard_edit()
    permit.value.recomputes += 1
    permit.value.recomputed_items.push(query.key)
    if !query.eligible || body.host_reached || body.volatile -> return
    checked: body.checked ?? panic("an accepted body packet lost its checker result")
    if !checked.complete || checked.value == None || body.comptime_requests.len() != 0 || checked.comptime_body_sources.len() != 0 -> return
    loop diagnostic in body.diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> return
    }
    if body.method_input == .Val(input) {
        if !input.memory_found || !input.memory_complete || !input.owner_generic_complete -> return
    }
    if permit.value.generation != query.module_memo.generation || (permit.value.scope_epochs.get(query.module_memo.module_identity) ?? -1) != query.module_memo.epoch -> return
    // Only a retainable product is copied: failed/volatile checks still count
    // their real recompute but allocate no throwaway memo product.
    value := SemaBodyMemoValue{
        checked: checked, diagnostics: body.diagnostics,
        call_facts: body.call_facts, comptime_requests: body.comptime_requests,
        name_references: body.name_references, method_input: body.method_input,
    }
    bytes: query.key.count_bytes() + query.input.count_bytes() + "{value:Debug}".count_bytes()
    previous_bytes: if permit.value.rows.has_key(query.key) -> permit.value.rows[query.key].bytes else -> 0
    permit.value.row_bytes -= previous_bytes
    permit.value.rows[query.key] = SemaCachedBody{module_identity: query.module_memo.module_identity, generation: query.module_memo.generation, epoch: query.module_memo.epoch, input: query.input, value: value, bytes: bytes}
    permit.value.row_bytes += bytes
}

// Typed header projection, not an AST serializer. Constructing the header
// directly avoids copying a body merely to discard it. New required AST fields
// must be accounted for here by the ordinary constructor check.
sema_incremental_function_header: fn(function: Func) -> Func Never! {
    Func{
        span: function.span, is_pub: function.is_pub, is_package_pub: function.is_package_pub,
        is_comptime: function.is_comptime, external_type: function.external_type,
        name: function.name, name_span: function.name_span, meta: function.meta,
        type_params: function.type_params, head_pattern: function.head_pattern,
        params: function.params, return_type: function.return_type,
        return_type_span: function.return_type_span,
        return_view_provenance: function.return_view_provenance,
        declared_return_view_provenance: function.declared_return_view_provenance,
        gc_return: function.gc_return, diverges: function.diverges, gc_scope: function.gc_scope,
        is_unsafe: function.is_unsafe, unsafe_reason: function.unsafe_reason,
        unsafe_span: function.unsafe_span, is_pure: function.is_pure,
        scrub_tag: function.scrub_tag,
        declared_effects: function.declared_effects, effect_via: function.effect_via,
        state_requires: function.state_requires, state_transition: function.state_transition,
        is_reactive: function.is_reactive, reactive_upgrades: function.reactive_upgrades,
        is_replayable: function.is_replayable, replayable_span: function.replayable_span,
        is_job: function.is_job, job_span: function.job_span, job_metadata: function.job_metadata,
        every: function.every, is_must_use: function.is_must_use,
        must_use_span: function.must_use_span, maturity: function.maturity,
        maturity_span: function.maturity_span, kernel: function.kernel,
        is_inline: function.is_inline, is_inline_always: function.is_inline_always,
        inline_span: function.inline_span, web_marker: function.web_marker,
        pre: function.pre, post: function.post, inline_foreign: function.inline_foreign,
        undo: function.undo, markers: function.markers,
        compiler_generated: function.compiler_generated, body: [Stmt]{},
    }
}

sema_incremental_function_headers: fn(functions: [Func]) -> [Func] Never! {
    loop function in functions -> sema_incremental_function_header(function)
}

sema_incremental_trait_impl_headers: fn(blocks: [TraitImplBlock]) -> [TraitImplBlock] Never! {
    loop block in blocks -> TraitImplBlock{
        trait_name: block.trait_name, trait_span: block.trait_span,
        operator_rhs: block.operator_rhs, operator_marker: block.operator_marker,
        methods: sema_incremental_function_headers(block.methods),
        compiler_generated: block.compiler_generated, assoc_type_impls: block.assoc_type_impls, constants: block.constants, delegation_field: block.delegation_field,
        markers: block.markers, span: block.span,
    }
}

sema_incremental_impl_header: fn(implementation: ImplDef) -> ImplDef Never! {
    ImplDef{
        span: implementation.span, type_name: implementation.type_name,
        type_span: implementation.type_span, trait_name: implementation.trait_name,
        trait_span: implementation.trait_span, operator_rhs: implementation.operator_rhs,
        operator_marker: implementation.operator_marker,
        methods: sema_incremental_function_headers(implementation.methods),
        delegation_field: implementation.delegation_field,
        assoc_type_impls: implementation.assoc_type_impls, constants: implementation.constants,
        is_generated_serde: implementation.is_generated_serde, os_target: implementation.os_target,
        markers: implementation.markers, type_params: implementation.type_params,
    }
}

sema_incremental_item_header: fn(item: Item) -> Item Never! {
    if item == {
        .Func(function) -> Item.Func{value: sema_incremental_function_header(function)}
        .Struct(definition) -> Item.Struct{value: StructDef{
            span: definition.span, is_pub: definition.is_pub,
            is_package_pub: definition.is_package_pub, name: definition.name,
            name_span: definition.name_span, type_params: definition.type_params,
            fields: definition.fields, state: definition.state,
            methods: sema_incremental_function_headers(definition.methods),
            cli_bindings: definition.cli_bindings,
            trait_impls: sema_incremental_trait_impl_headers(definition.trait_impls),
            derives: definition.derives, auto_derive_default: definition.auto_derive_default,
            is_published_schema: definition.is_published_schema,
            published_schema_span: definition.published_schema_span,
            is_single_use: definition.is_single_use, single_use_span: definition.single_use_span,
            is_must_use: definition.is_must_use, must_use_span: definition.must_use_span,
            layout: definition.layout, layout_span: definition.layout_span, layout_alignment_span: definition.layout_alignment_span,
            serde_markers: definition.serde_markers, type_markers: definition.type_markers,
            validate_block: definition.validate_block, validate_span: definition.validate_span,
            inline_module: definition.inline_module,
        }}
        .Enum(definition) -> Item.Enum{value: EnumDef{
            span: definition.span, is_pub: definition.is_pub,
            is_package_pub: definition.is_package_pub, name: definition.name,
            name_span: definition.name_span, type_params: definition.type_params,
            variants: definition.variants, methods: sema_incremental_function_headers(definition.methods),
            trait_impls: sema_incremental_trait_impl_headers(definition.trait_impls),
            derives: definition.derives, auto_derive_default: definition.auto_derive_default,
            is_single_use: definition.is_single_use, single_use_span: definition.single_use_span,
            is_must_use: definition.is_must_use, must_use_span: definition.must_use_span,
            serde_markers: definition.serde_markers, type_markers: definition.type_markers,
            groups: definition.groups,
        }}
        .Impl(implementation) -> Item.Impl{value: sema_incremental_impl_header(implementation)}
        .CodeModule(definition) -> {
            body := [Item]?{None}
            if definition.body == .Val(items) -> body = Val(sema_incremental_item_headers(items))
            Item.CodeModule{value: CodeModule{
                name: definition.name, name_span: definition.name_span,
                is_pub: definition.is_pub, is_package_pub: definition.is_package_pub,
                body: body.move(), imports: definition.imports, web_target: definition.web_target,
                instance_identity: definition.instance_identity, span: definition.span, markers: definition.markers,
            }}
        }
        // Defaults, validation/templates and other registration inputs remain
        // exhaustive; only ordinary callable body arrays are omitted.
        .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> item
    }
}

sema_incremental_item_headers: fn(items: [Item]) -> [Item] Never! {
    loop item in items -> sema_incremental_item_header(item)
}

sema_incremental_optional_item_header: fn(item: Item?) -> Item? Never! {
    if item == .Val(value) -> return Val(sema_incremental_item_header(value))
    None
}

sema_incremental_registered_function_headers: fn(functions: [SemaRegistrationFunction]) -> [SemaRegistrationFunction] Never! {
    loop function in functions -> SemaRegistrationFunction{
        symbol: function.symbol, declaration: sema_incremental_function_header(function.declaration),
        signature: function.signature, identity: function.identity, identity_key: function.identity_key,
        generic_params: function.generic_params, generic_identity_key: function.generic_identity_key,
        parameters: function.parameters, abi: function.abi, raw_protocol_return: function.raw_protocol_return,
    }
}

sema_incremental_registered_impl_headers: fn(implementations: [SemaRegistrationImpl]) -> [SemaRegistrationImpl] Never! {
    loop implementation in implementations -> SemaRegistrationImpl{
        symbol: implementation.symbol, declaration: sema_incremental_impl_header(implementation.declaration),
        source_module_identity: implementation.source_module_identity,
        source_package_identity: implementation.source_package_identity,
        target_module_identity: implementation.target_module_identity,
        target_type_name: implementation.target_type_name, target_type: implementation.target_type,
        target_identity: implementation.target_identity, target_identity_key: implementation.target_identity_key,
        trait_name: implementation.trait_name, trait_symbol: implementation.trait_symbol,
        trait_identity: implementation.trait_identity, trait_span: implementation.trait_span,
        identity_key: implementation.identity_key,
        methods: sema_incremental_registered_function_headers(implementation.methods),
        associated_type_impls: implementation.associated_type_impls, associated_types: implementation.associated_types,
        delegation_field: implementation.delegation_field, compiler_generated: implementation.compiler_generated,
        operator_marker: implementation.operator_marker, operator_rhs: implementation.operator_rhs,
        target_os: implementation.target_os, target_nominal_key: implementation.target_nominal_key,
    }
}

sema_incremental_registered_nominal_headers: fn(nominals: [SemaRegistrationNominal]) -> [SemaRegistrationNominal] Never! {
    output := [SemaRegistrationNominal]{}
    loop nominal in nominals {
        source: if nominal.source == {
            .SourceAST(item) -> SemaRegistrationNominalSource.SourceAST{value: sema_incremental_item_header(item)}
            .ForeignHandle(facts) -> SemaRegistrationNominalSource.ForeignHandle{value: facts}
            .CompilerBuiltinTrait(facts) -> SemaRegistrationNominalSource.CompilerBuiltinTrait{value: facts}
        }
        output.push(SemaRegistrationNominal{
            symbol: nominal.symbol, kind: nominal.kind, source: source.move(), ty: nominal.ty,
            identity: nominal.identity, identity_key: nominal.identity_key,
            generic_params: nominal.generic_params, generic_identity_key: nominal.generic_identity_key,
            fields: nominal.fields, variants: nominal.variants,
            methods: sema_incremental_registered_function_headers(nominal.methods),
            trait_methods: nominal.trait_methods, compiler_owned: nominal.compiler_owned,
            generated_provenance: nominal.generated_provenance,
        })
    }
    output.move()
}

sema_incremental_import_headers: fn(imports: [SemaRegistrationImport]) -> [SemaRegistrationImport] Never! {
    output := [SemaRegistrationImport]{}
    loop imported in imports {
        bindings := [SemaRegistrationImportBinding]{}
        loop binding in imported.bindings {
            bindings.push(SemaRegistrationImportBinding{
                original: binding.original, local: binding.local, symbol: binding.symbol,
                declaration: sema_incremental_optional_item_header(binding.declaration),
                target_module_identity: binding.target_module_identity,
                target_module_index: binding.target_module_index,
                visibility: binding.visibility,
            })
        }
        output.push(SemaRegistrationImport{
            source_module_identity: imported.source_module_identity,
            source_package_identity: imported.source_package_identity,
            target_module_identity: imported.target_module_identity,
            target_package_identity: imported.target_package_identity,
            declaration: imported.declaration, visibility: imported.visibility, bindings: bindings.move(),
        })
    }
    output.move()
}

sema_incremental_program_header: fn(program: Program) -> Program Never! {
    Program{
        imports: program.imports, items: sema_incremental_item_headers(program.items),
        script_body: program.script_body, block_spans: program.block_spans,
        fenced_statements: program.fenced_statements, web_target_ceiling: program.web_target_ceiling,
        no_prelude: program.no_prelude,
        default_target: program.default_target, html_path: program.html_path,
        policy_declarations: program.policy_declarations,
        user_policy_declarations: program.user_policy_declarations,
        applied_rules: program.applied_rules, rule_facts: program.rule_facts,
        else_arms: program.else_arms, used_import_names: program.used_import_names,
        debug_sites: program.debug_sites, app_route_roots: program.app_route_roots,
        entry_locals: program.entry_locals,
    }
}

sema_incremental_module_headers: fn(modules: [SemaRegistrationModule]) -> [SemaRegistrationModule] Never! {
    output := [SemaRegistrationModule]{}
    loop source_module in modules {
        exports := [SemaRegistrationExport]{}
        loop exported in source_module.exports {
            exports.push(SemaRegistrationExport{
                name: exported.name, symbol: exported.symbol,
                declaration: sema_incremental_optional_item_header(exported.declaration),
                source_module_identity: exported.source_module_identity, visibility: exported.visibility,
            })
        }
        output.push(SemaRegistrationModule{
            package_identity: source_module.package_identity, module_identity: source_module.module_identity,
            module_name: source_module.module_name, core_source_alias: source_module.core_source_alias,
            module_path: source_module.module_path, declared_module: source_module.declared_module, source_file: source_module.source_file,
            source_segments: source_module.source_segments, source_origin: source_module.source_origin,
            program: sema_incremental_program_header(source_module.program), source: "", template_caps: source_module.template_caps,
            declarations: sema_incremental_item_headers(source_module.declarations),
            symbols: source_module.symbols, symbol_nominal_rows: source_module.symbol_nominal_rows, symbol_positions: source_module.symbol_positions,
            declaration_positions: source_module.declaration_positions,
            impls: sema_incremental_registered_impl_headers(source_module.impls),
            functions: sema_incremental_registered_function_headers(source_module.functions),
            foreign_functions: source_module.foreign_functions,
            nominals: sema_incremental_registered_nominal_headers(source_module.nominals),
            constants: source_module.constants, static_roots: source_module.static_roots, persist_roots: source_module.persist_roots,
            imports: sema_incremental_import_headers(source_module.imports), exports: exports.move(),
            import_binding_rows: source_module.import_binding_rows,
            declared_trait_impls: source_module.declared_trait_impls,
        })
    }
    output.move()
}

sema_incremental_begin: fn(cache: SemaIncrementalCache, graph: SemaRegistrationGraph, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], checked_types: [TTypeDef]) {
    // Once per accepted request. Bodies are absent from the typed registration
    // view; all real source spans, resolved bindings and cooked metadata remain.
    headers: sema_incremental_module_headers(graph.modules)
    imports: sema_incremental_import_headers(graph.imports)
    header_text: "{headers:Debug}"
    input: "package={graph.package_identity:Debug};entry={graph.entry_module_identity:Debug};effects={graph.canonical_effect_module_identity:Debug};target={graph.target_machine:Debug};build={graph.build_facts:Debug};headers={header_text};module_rows={graph.module_rows:Debug};edges={graph.edges:Debug};providers={graph.foreign_providers:Debug};core_owners={graph.core_builtin_owner_facts:Debug};imports={imports:Debug};units={graph.unit_facts:Debug};internal={graph.internal_problem:Debug};diagnostics={graph.diagnostics:Debug};complete={graph.complete:Debug};callables={graph.callables:Debug};nominal_slots={graph.nominal_row_slots:Debug};nominal_buckets={graph.nominal_row_buckets:Debug};impl_slots={graph.impl_row_slots:Debug};impl_buckets={graph.impl_row_buckets:Debug};nominal_symbols={graph.nominal_symbol_rows:Debug};builtins={graph.compiler_builtin_rows:Debug};trait_slots={graph.impl_trait_slots:Debug};trait_buckets={graph.impl_trait_buckets:Debug};traits_indexed={graph.impl_traits_indexed:Debug};keep_going={graph.keep_going:Debug};test_mode={graph.test_mode:Debug};check_tests={graph.check_tests:Debug};retain_programs={graph.retain_programs:Debug};values={values:Debug};comptime={comptime_functions:Debug};types={checked_types:Debug}"
    permit := cache.state.guard_edit()
    if permit.value.frozen == input -> return
    permit.value.generation += 1
    permit.value.frozen = input.move()
    permit.value.scope_inputs = [String:String]{}
    permit.value.scope_epochs = [String:Int]{}
    permit.value.rows = [String:SemaCachedBody]{}
    permit.value.frozen_bytes = permit.value.frozen.count_bytes()
    permit.value.row_bytes = 0
}

sema_incremental_module_input: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> String Never! {
    declarations: loop declaration_index in 0..<environment.declarations.len() -> SemaScopeDeclaration{
        symbol_id: environment.declarations[declaration_index].symbol_id, item: sema_incremental_item_header(environment.declarations[declaration_index].item),
    }
    // The graph is already frozen once by begin. Callable names belong to the
    // per-body input, not whichever summary happened to run last. Everything
    // else read from the environment and the full binding table is exact.
    // This owner-only window ends before hooks, checking, publication or task
    // launch. Save/restore only the transient scalar; never clone the scope.
    // A borrowed table cannot hand off its field owner: explicitly clone this
    // Option<String>, then move it back after the normalized ordered snapshot.
    comptime_input: sema_comptime_body_values_debug(environment.comptime_body_values)
    // copy: `location` restores scopes.location_function after the edits below overwrite it. Jet
    // has no exchange on a field of the write-borrowed `scopes`.
    location := scopes.location_function.copy()
    scopes.location_function = None
    // copy: a handle copy (the graph's shared counters): a traced check keys
    // the same memo as an untraced one, so the handle is out of the key.
    counters := scopes.lookup_counters.copy()
    scopes.lookup_counters = None
    input := "module={environment.module_identity:Debug};package={environment.package_identity:Debug};name={environment.module_name:Debug};declared={environment.declared_module:Debug};file={environment.source_file:Debug};origin={environment.source_origin:Debug};segments={environment.source_segments:Debug};types={program.checked_types:Debug};type_rows={program.checked_type_rows:Debug};type_slots={program.checked_type_name_slots:Debug};type_names={program.checked_type_name_rows:Debug};boxed={program.boxed_edges:Debug};declarations={declarations:Debug};generics={environment.generic_params:Debug};comptime={comptime_input};else={environment.else_arms:Debug};fixed_writes={environment.fixed_length_write_params:Debug};debug={environment.debug_sites:Debug};scope={scopes:Debug}"
    scopes.location_function = location.move()
    scopes.lookup_counters = counters.move()
    input.move()
}

sema_incremental_module: fn(session: SemaIncrementalCache?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> SemaModuleMemo? {
    cache: session ?? return None
    Val(sema_incremental_freeze_scope(cache, environment.module_identity, sema_incremental_module_input(environment, program, scopes)))
}

// The complete frozen context guards these scalar source/plan selectors.
// TFuncKind.Method/TraitMethod already carries the exact owner_type.
sema_incremental_selected_body_query: fn(memo: SemaModuleMemo?, job: SemaBodyJob, module_index: Int, raw: Func, owner_id: SymbolID, kind: TFuncKind, raw_protocol_return: Bool, memory_plan: SemaFunctionMemoryPlan, memory_owner: String, trait_symbol: Symbol?, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaBodyMemoQuery? {
    module_memo: memo ?? return None
    position: sema_function_memory_position(memory_plan, module_memo.module_identity, memory_owner, raw.name, raw.span)
    memory_text: if position == {
        .Val(index) -> "{memory_plan.functions[index]:Debug}"
        .None -> "None"
    }
    input: "job={job:Debug};module_index={module_index};memory_position={position:Debug};raw={raw:Debug};owner={owner_id:Debug};kind={kind:Debug};raw_return={raw_protocol_return:Debug};memory={memory_text};trait={trait_symbol:Debug};generics={environment.generic_params:Debug}"
    Val(sema_incremental_query(module_memo, owner_id.key, input, !raw.is_comptime))
}

// Cold None ends before any payload match, plan lookup or formatting.
// Declaration loans end before checking, hooks, publication or task launch.
sema_incremental_registered_body_query: fn(memo: SemaModuleMemo?, job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaBodyMemoQuery? {
    if memo == None -> return None
    if program.registration_graph == .Val(graph) {
        if job == {
            .TopLevel(item_index) -> {
                if graph.modules[module_index].program.items[item_index] == .Func(function) {
                    return sema_incremental_selected_body_query(memo, job, module_index, function, symbol_id(SymbolKind.Function, graph.modules[module_index].module_identity, "", function.name), TFuncKind.TopLevel, false, memory_plan, "", None, environment, program)
                }
                panic("a selected source function lost its original item")
            }
            .NominalMethod(_, owner, row) -> {
                return sema_incremental_selected_body_query(memo, job, module_index, graph.modules[module_index].nominals[owner].methods[row].declaration, graph.modules[module_index].nominals[owner].methods[row].symbol.id, sema_comptime_method_kind(graph.modules[module_index].nominals[owner].methods[row].declaration, graph.modules[module_index].nominals[owner].ty, None), graph.modules[module_index].nominals[owner].methods[row].raw_protocol_return, memory_plan, sema_type_graph_base_name(graph.modules[module_index].nominals[owner].ty) ?? "", None, environment, program)
            }
            .ImplMethod(_, owner, row) -> {
                return sema_incremental_selected_body_query(memo, job, module_index, graph.modules[module_index].impls[owner].methods[row].declaration, graph.modules[module_index].impls[owner].methods[row].symbol.id, sema_comptime_method_kind(graph.modules[module_index].impls[owner].methods[row].declaration, graph.modules[module_index].impls[owner].target_type, graph.modules[module_index].impls[owner].trait_symbol), graph.modules[module_index].impls[owner].methods[row].raw_protocol_return, memory_plan, sema_type_graph_base_name(graph.modules[module_index].impls[owner].target_type) ?? "", graph.modules[module_index].impls[owner].trait_symbol, environment, program)
            }
        }
    }
    panic("an incremental Jet body query lost its owning graph")
}

sema_check_body_job_index: fn(job: SemaBodyJob) -> Int Never! {
    if job == {
        .TopLevel(index) -> index
        .NominalMethod(ordinal, _, _) | .ImplMethod(ordinal, _, _) -> ordinal
    }
}

sema_incremental_registered_job_queries: fn(memo: SemaModuleMemo?, module_index: Int, memory_plan: SemaFunctionMemoryPlan, jobs: [SemaBodyJob], environment: SemaScopeEnvironment, program: SemaProgramTables) -> [Int:SemaBodyMemoQuery] {
    queries := [Int:SemaBodyMemoQuery]{}
    if memo == None -> return queries.move()
    loop job in jobs {
        query := sema_incremental_registered_body_query(memo, job, module_index, memory_plan, environment, program)
        if query == .Val(_) -> queries[sema_check_body_job_index(job)] = query.move() ?? panic("an admitted body query disappeared")
    }
    queries.move()
}

sema_incremental_observer: fn(enabled: Bool) -> Shared<SemaBodyCheckReach>? {
    if !enabled -> return None
    Val(Shared{SemaBodyCheckReach{host: false, foreign_raw_body: false}})
}

sema_incremental_reach: fn(observed: Shared<SemaBodyCheckReach>?) -> SemaBodyCheckReach {
    cell: observed ?? return SemaBodyCheckReach{host: false, foreign_raw_body: false}
    permit: cell.guard_read()
    SemaBodyCheckReach{host: permit.value.host, foreign_raw_body: permit.value.foreign_raw_body}
}

sema_incremental_replayed_packet: fn(query: SemaBodyMemoQuery?, job_index: Int) -> SemaParallelBody? {
    descriptor: query ?? return None
    if !descriptor.eligible || !descriptor.replay -> return None
    replay := sema_incremental_replay(descriptor) ?? return None
    Val(SemaParallelBody{
        job_index: job_index, checked: Val(replay.checked.move()),
        diagnostics: replay.diagnostics.move(), call_facts: replay.call_facts.move(),
        comptime_requests: replay.comptime_requests.move(),
        name_references: replay.name_references.move(), method_input: replay.method_input.move(),
        wanted_hooks: false, host_reached: false, volatile: false, cache_hit: true,
    })
}

sema_incremental_prepared: fn(prepared: &&SemaPreparedBody?, query: SemaBodyMemoQuery?, job_index: Int, replay_allowed: Bool) -> SemaParallelBody? {
    owned := prepared.move()
    if owned == {
        .Val(.Checked(body)) -> return Val(body.move())
        .Val(.Replay(_)) -> {
            if !replay_allowed -> return None
            return sema_incremental_replayed_packet(query, job_index)
        }
        .None -> {
            // The same ordered replay for a module admitted on one thread.
            if !replay_allowed -> return None
            return sema_incremental_replayed_packet(query, job_index)
        }
    }
}

sema_incremental_accept_packet: fn(query: SemaBodyMemoQuery?, body: SemaParallelBody) {
    descriptor: query ?? return
    if body.cache_hit -> return
    sema_incremental_accept(descriptor, body)
}

SemaFunctionResult: struct {
    value: FnBody?
    complete: Bool
    exact_int_reachable: Bool
    copy_events: [SemaCopyEvent]
    hardware_use: TargetHardwareUse
    comptime_body_sources: [SemaComptimeBodySource]
    compute_facts: SemaComputeFunctionFacts
    failure: SemaFunctionFailureFacts?
    // Why an incomplete result has no diagnostic (SemaCheckContext rows).
    incomplete_reasons: [String]{[String]{}}
    // The value's prelude conversion demands (sema_prelude_conversion_demands),
    // when the compiler thread that checked the body walked it there.
    prelude_demands: [SemaPreludeConversionDemand]?{None}
}
sema_function_compute_facts: fn(function_key: String, context: SemaCheckContext) -> SemaComputeFunctionFacts Never! {
    SemaComputeFunctionFacts{
        function_key: function_key,
        compute_calls: context.compute_calls.copy(),
        autodiff_obligations: context.autodiff_obligations.copy(),
        autodiff_safe_panic: context.autodiff_safe_panic,
        autodiff_unsafe_panic: context.autodiff_unsafe_panic,
    }
}

// A function's result: `value` when its check completed, None when it did
// not, with the facts its check gathered taken out of the spent context.
sema_function_result: fn(value: &&FnBody?, function_key: String, context: &&SemaCheckContext) -> SemaFunctionResult Never! {
    complete: value != None
    SemaFunctionResult{
        value: value.move(),
        complete: complete,
        exact_int_reachable: context.exact_int_reachable,
        copy_events: context.copy_events.move(),
        hardware_use: sema_hardware_use_snapshot(context.hardware_use),
        comptime_body_sources: context.comptime_body_sources.move(),
        compute_facts: SemaComputeFunctionFacts{
            function_key: function_key,
            compute_calls: context.compute_calls.move(),
            autodiff_obligations: context.autodiff_obligations.move(),
            autodiff_safe_panic: context.autodiff_safe_panic,
            autodiff_unsafe_panic: context.autodiff_unsafe_panic,
        },
        failure: Val(SemaFunctionFailureFacts{
            function_key: function_key,
            direct: context.failure_direct_source,
            edges: context.failure_edges.move(),
            union_members: context.failure_union_members.move(),
            union_cases: context.failure_union_cases.move(),
            union_edges: context.failure_union_edges.move(),
            union_general: context.failure_union_general || context.failure_direct_source,
        }),
        incomplete_reasons: if complete -> [String]{} else -> context.incomplete_reasons.move(),
    }
}

sema_function_check_unavailable: fn(function_key: String, reason: String) -> SemaFunctionResult Never! {
    SemaFunctionResult{
        value: None,
        complete: false,
        exact_int_reachable: false,
        copy_events: [SemaCopyEvent]{},
        hardware_use: sema_hardware_empty_use(),
        comptime_body_sources: [SemaComptimeBodySource]{},
        compute_facts: SemaComputeFunctionFacts{
            function_key: function_key,
            compute_calls: [SemaComputeCallFact]{},
            autodiff_obligations: [SemaAutodiffObligation]{},
            autodiff_safe_panic: false,
            autodiff_unsafe_panic: false,
        },
        failure: None,
        incomplete_reasons: [String]{reason},
    }
}

sema_function_view_source_equal: fn(left: ViewSource, right: ViewSource) -> Bool Never! {
    if left == {
        .Receiver -> if right == {
            .Receiver -> true
            .Parameter(_) | .Static(_, _) -> false
        }
        .Parameter(index) -> if right == {
            .Parameter(other) -> index == other
            .Receiver | .Static(_, _) -> false
        }
        .Static(module_path, name) -> if right == {
            .Static(other_module, other_name) -> module_path == other_module && name == other_name
            .Receiver | .Parameter(_) -> false
        }
    }
}

sema_function_view_projection_equal: fn(left: ViewSourceProjection, right: ViewSourceProjection) -> Bool Never! {
    if left == {
        .Field(name) -> if right == {
            .Field(other) -> name == other
            .Index | .Range -> false
        }
        .Index -> if right == {
            .Index -> true
            .Field(_) | .Range -> false
        }
        .Range -> if right == {
            .Range -> true
            .Field(_) | .Index -> false
        }
    }
}

sema_function_view_slot_equal: fn(left: [String], right: [String]) -> Bool Never! {
    if left.len() != right.len() -> return false
    index := 0
    loop index < left.len() {
        if left[index] != right[index] -> return false
        index += 1
    }
    true
}

sema_function_view_source_within: fn(declared: ViewSourcePath, inferred: ViewSourcePath) -> Bool Never! {
    if !sema_function_view_source_equal(declared.source, inferred.source) || declared.projections.len() > inferred.projections.len() -> return false
    index := 0
    loop index < declared.projections.len() {
        if !sema_function_view_projection_equal(declared.projections[index], inferred.projections[index]) -> return false
        index += 1
    }
    true
}

sema_function_view_contract_for_slot: fn(map: ViewProvenanceMap, slot: [String]) -> ViewProvenance? {
    loop entry in map.entries {
        if sema_function_view_slot_equal(entry.slot, slot) -> return Val(entry.value)
    }
    if slot.len() > 0 {
        loop entry in map.entries {
            if entry.slot.len() == 0 -> return Val(entry.value)
        }
    }
    None
}

sema_function_return_view_provenance: fn(func: Func, inferred: ViewProvenanceMap?, diagnostics: &[Diagnostic], complete: &Bool) -> ViewProvenanceMap? {
    declared_option := func.declared_return_view_provenance
    // copy: the provenance is a new owned Option. Without a declared map it equals `inferred`, the
    // caller's inferred map (a read parameter), which the caller keeps.
    if declared_option == None -> return inferred.copy()
    declared: declared_option ?? ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
    if inferred != None {
        inferred_map: inferred
        span: func.return_type_span ?? func.name_span
        loop inferred_entry in inferred_map.entries {
            declared_entry := sema_function_view_contract_for_slot(declared, inferred_entry.slot)
            if declared_entry == None {
                diagnostics.push(sema_error("E2305", span, "returned view escapes its declared `from` clause", "every return path's owners must stay inside the sources named after `from`", "widen the `from` clause, or stop returning a view from that owner"))
                complete = false
                next
            }
            allowed: declared_entry ?? ViewProvenance{sources: [ViewSourcePath]{}, mutable: false}
            loop inferred_source in inferred_entry.value.sources {
                source_allowed := false
                loop declared_source in allowed.sources {
                    if sema_function_view_source_within(declared_source, inferred_source) -> source_allowed = true
                }
                if !source_allowed {
                    diagnostics.push(sema_error("E2305", span, "returned view escapes its declared `from` clause", "every return path's owners must stay inside the sources named after `from`", "widen the `from` clause, or stop returning a view from that owner"))
                    complete = false
                }
            }
        }
        published := [ViewProvenanceEntry]{}
        loop inferred_entry in inferred_map.entries {
            allowed := sema_function_view_contract_for_slot(declared, inferred_entry.slot)
            sources := inferred_entry.value.sources
            if allowed != None {
                allowed_value: allowed ?? ViewProvenance{sources: [ViewSourcePath]{}, mutable: false}
                sources = allowed_value.sources
            }
            published.push(ViewProvenanceEntry{slot: inferred_entry.slot, value: ViewProvenance{sources: sources, mutable: inferred_entry.value.mutable}})
        }
        loop declared_entry in declared.entries {
            if declared_entry.slot.len() == 0 -> next
            duplicate := false
            loop published_entry in published {
                if sema_function_view_slot_equal(published_entry.slot, declared_entry.slot) -> duplicate = true
            }
            if !duplicate -> published.push(declared_entry)
        }
        if published.len() == 0 {
            any_write := false
            loop inferred_entry in inferred_map.entries {
                if inferred_entry.value.mutable -> any_write = true
            }
            merged := [ViewProvenanceEntry]{}
            loop declared_entry in declared.entries {
                if {
                    declared_entry.slot.len() == 0 -> {
                        merged.push(ViewProvenanceEntry{slot: declared_entry.slot, value: ViewProvenance{sources: declared_entry.value.sources, mutable: any_write}})
                    }
                    else -> {
                        merged.push(declared_entry)
                    }
                }
            }
            return Val(ViewProvenanceMap{entries: merged})
        }
        return Val(ViewProvenanceMap{entries: published})
    }
    Val(declared)
}
sema_function_view_source_path_equal: fn(left: ViewSourcePath, right: ViewSourcePath) -> Bool Never! {
    if left.projections.len() != right.projections.len() -> return false
    sema_function_view_source_within(left, right)
}

sema_function_view_maps_equal: fn(left: ViewProvenanceMap?, right: ViewProvenanceMap?) -> Bool Never! {
    if left == None -> return right == None
    if right == None -> return false
    left_map: left
    right_map: right
    if left_map.entries.len() != right_map.entries.len() -> return false
    loop left_entry in left_map.entries {
        right_entry := ViewProvenanceEntry?{None}
        loop candidate in right_map.entries {
            if sema_function_view_slot_equal(left_entry.slot, candidate.slot) -> right_entry = Val(candidate)
        }
        if right_entry == None -> return false
        candidate: right_entry ?? ViewProvenanceEntry{slot: [String]{}, value: ViewProvenance{sources: [ViewSourcePath]{}, mutable: false}}
        if left_entry.value.mutable != candidate.value.mutable || left_entry.value.sources.len() != candidate.value.sources.len() -> return false
        loop left_source in left_entry.value.sources {
            found := false
            loop right_source in candidate.value.sources {
                if sema_function_view_source_path_equal(left_source, right_source) -> found = true
            }
            if !found -> return false
        }
    }
    true
}

// The first frame-0 binding row per symbol key, built by the first publish
// of a body loop so each later publish does not scan every module binding.
// Rows are only appended after the module rows, or edited in place without
// changing their key, so a recorded row that still holds its key is still
// the first one; any other key falls back to the scan the rows replace.
sema_function_return_view_rows: fn(scopes: SemaScopeTable, rows: &[String:Int]) Never! {
    loop index in 0..<scopes.bindings.len() {
        if scopes.bindings[index].frame == 0 && rows.get(scopes.bindings[index].symbol.id.key) == None -> rows[scopes.bindings[index].symbol.id.key] = index
    }
}

// The first frame-0 binding of `key`.
sema_function_return_view_row: fn(scopes: SemaScopeTable, rows: &[String:Int], key: String) -> Int? Never! {
    if rows.len() == 0 -> sema_function_return_view_rows(scopes, rows)
    if rows.get(key) == .Val(recorded) {
        if recorded < scopes.bindings.len() && scopes.bindings[recorded].frame == 0 && scopes.bindings[recorded].symbol.id.key == key -> return Val(recorded)
    }
    loop index in 0..<scopes.bindings.len() {
        if scopes.bindings[index].frame == 0 && scopes.bindings[index].symbol.id.key == key -> return Val(index)
    }
    None
}

// `rows`: the body loop's sema_function_return_view_rows, empty until the
// first publish fills it.
sema_function_publish_return_views: fn(scopes: &SemaScopeTable, rows: &[String:Int], function: FnBody) -> Bool Never! {
    provenance: function.return_view_provenance ?? return false
    index: sema_function_return_view_row(scopes, rows, function.key) ?? return false
    binding: scopes.bindings[index]
    if binding.symbol.ty == .Val(type_value) {
        if type_value == .Fn(params, ret, effect_bound, param_contract, metadata, existing) {
            next_map := Val(provenance)
            if sema_function_view_maps_equal(existing, next_map) -> return false
            scopes.bindings[index].symbol.ty = Val(Type.Fn{params: params, ret: ret, effect_bound: effect_bound, param_contract: param_contract, call_metadata: metadata, return_view_provenance: next_map})
            return true
        }
    }
    false
}

// Rust `contains_view` (`check_module_bodies`): a declared return type carries
// view provenance across its signature when it structurally holds a `View`,
// `ViewMut` or `Pin` directly or through struct fields. `seen` names every
// nominal already entered, so recursive structs terminate.
sema_check_type_contains_view: fn(graph: SemaRegistrationGraph, module_identity: String, ty: Type, seen: &[String:Bool]) -> Bool {
    if ty == {
        .Apply(name, args) -> {
            if (name == "View" || name == "ViewMut" || name == "Pin") && args.len() == 1 -> return true
            loop arg in args {
                if sema_check_type_contains_view(graph, module_identity, arg, seen) -> return true
            }
            return sema_check_struct_contains_view(graph, module_identity, name, seen)
        }
        .Named(name) -> return sema_check_struct_contains_view(graph, module_identity, name, seen)
        .Option(inner) -> return sema_check_type_contains_view(graph, module_identity, inner, seen)
        .List(element) -> return sema_check_type_contains_view(graph, module_identity, element, seen)
        .Shared(inner) -> return sema_check_type_contains_view(graph, module_identity, inner, seen)
        .Tagged(_, inner) -> return sema_check_type_contains_view(graph, module_identity, inner, seen)
        .Result(ok, err) -> {
            if sema_check_type_contains_view(graph, module_identity, ok, seen) -> return true
            return sema_check_type_contains_view(graph, module_identity, err, seen)
        }
        .Map(key, _, value) -> {
            if sema_check_type_contains_view(graph, module_identity, key, seen) -> return true
            return sema_check_type_contains_view(graph, module_identity, value, seen)
        }
        .Tuple(fields) -> {
            loop field in fields {
                if sema_check_type_contains_view(graph, module_identity, field.ty, seen) -> return true
            }
        }
        .FixedList(elem, _) -> return sema_check_type_contains_view(graph, module_identity, elem, seen)
        .Fn(params, ret, _, _, _, _) -> {
            loop param in params {
                if sema_check_type_contains_view(graph, module_identity, param, seen) -> return true
            }
            if ret == .Val(value) -> return sema_check_type_contains_view(graph, module_identity, value, seen)
        }
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Quantity(_, _) | .Measure(_) -> {}
    }
    false
}

// Rust `seen.insert(name) && registry.struct_fields(name)...`: field types
// resolve in the struct's own module; `seen` is keyed (Rust `HashSet`).
sema_check_struct_contains_view: fn(graph: SemaRegistrationGraph, module_identity: String, name: String, seen: &[String:Bool]) -> Bool {
    if seen.get(name) != None -> return false
    seen[name] = true
    nominal_row: sema_type_resolve_nominal_row(graph, Type.Named{name: name}, module_identity) ?? return false
    nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
    if nominal.kind != SemaRegistrationNominalKind.Struct -> return false
    loop field in nominal.fields {
        if sema_check_type_contains_view(graph, nominal.symbol.module_name, field.ty, seen) -> return true
    }
    false
}

// Summary jobs run in name order (Rust sorts view jobs by key). A stable
// bottom-up merge sort of job positions, so same-named functions keep
// declaration order and each job moves once.
// Existing name-ordered summary jobs retain only their original source cursors.
// Equal names retain declaration order, exactly as the canonical stable merge.
sema_check_view_summary_jobs: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int) -> [Int] {
    jobs := [Int]{}
    if program.registration_graph == .Val(graph) {
        loop item_index in 0..<graph.modules[module_index].program.items.len() {
            if graph.modules[module_index].program.items[item_index] == .Func(func) {
                if func.inline_foreign != None || sema_function_is_guest_import(func) -> next
                return_type: func.return_type ?? next
                seen := [String:Bool]{}
                if sema_check_type_contains_view(graph, graph.modules[module_index].module_identity, return_type, seen) -> jobs.push(item_index)
            }
        }
        return jobs.move()
    }
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_view_summary_name_before: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, left: Int, right: Int) -> Bool {
    if program.registration_graph == .Val(graph) {
        if graph.modules[module_index].program.items[left] == .Func(left_func) {
            if graph.modules[module_index].program.items[right] == .Func(right_func) -> return left_func.name <= right_func.name
        }
    }
    panic("a selected view summary lost its original function item")
}

sema_check_sort_view_summary_jobs: fn(jobs: &[Int], environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int) Never! {
    count: jobs.len()
    if count < 2 -> return
    order := [Int]{}
    loop index in 0..<count -> order.push(index)
    merged := order
    width := 1
    loop width < count {
        start := 0
        loop start < count {
            middle: if start + width < count -> start + width else -> count
            end: if start + 2 * width < count -> start + 2 * width else -> count
            left := start
            right := middle
            out := start
            loop out < end {
                if left < middle && (right >= end || sema_check_view_summary_name_before(environment, program, module_index, jobs[order[left]], jobs[order[right]])) {
                    merged[out] = order[left]
                    left += 1
                } else {
                    merged[out] = order[right]
                    right += 1
                }
                out += 1
            }
            start = end
        }
        order = merged
        width = width * 2
    }
    sorted: loop position in order -> jobs[position]
    loop index in 0..<count -> jobs[index] = sorted[index]
}

// Module `module_index`'s view summary jobs (sema_check_view_summary_jobs) in
// their run order (sema_check_sort_view_summary_jobs). Both read only the
// graph.
sema_check_sorted_view_summary_jobs: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int) -> [Int] {
    jobs := sema_check_view_summary_jobs(environment, program, module_index)
    sema_check_sort_view_summary_jobs(jobs, environment, program, module_index)
    jobs
}

sema_check_nominal_positions: fn(nominals: [SemaRegistrationNominal]) -> [String:Int] Never! {
    positions := [String:Int]{}
    loop index in 0..<nominals.len() {
        name: nominals[index].symbol.name
        if positions.get(name) == None -> positions[name] = index
    }
    positions
}

sema_check_view_rounds_equal: fn(left: [ViewProvenanceMap?], right: [ViewProvenanceMap?]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop index in 0..<left.len() {
        if !sema_function_view_maps_equal(left[index], right[index]) -> return false
    }
    true
}

sema_item_symbol: fn(item: Item, module_name: String, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment]) -> Symbol? {
    if item == {
        .Func(func) -> {
            id: symbol_id(SymbolKind.Function, module_name, "", func.name)
            ty: sema_function_symbol_type(func, false, id, fallback_source_file, fallback_source_origin, source_segments)
            visibility := 0
            if func.is_package_pub -> visibility = 1
            if func.is_pub -> visibility = 2
            Val(Symbol{id: id, kind: SymbolKind.Function, name: func.name, module_name: module_name, owner: None, span: func.name_span, ty: Val(ty), visibility: visibility})
        }
        .Struct(value) -> Val(sema_named_type_symbol(module_name, value.name, value.name_span, value.is_pub, value.is_package_pub))
        .Enum(value) -> Val(sema_named_type_symbol(module_name, value.name, value.name_span, value.is_pub, value.is_package_pub))
        .Distinct(value) -> Val(sema_named_type_symbol(module_name, value.name, value.name_span, value.is_pub, value.is_package_pub))
        .TypeAlias(value) -> Val(sema_named_type_symbol(module_name, value.name, value.name_span, value.is_pub, value.is_package_pub))
        .Trait(value) -> {
            id: symbol_id(SymbolKind.Trait, module_name, "", value.name)
            visibility := 0
            if value.is_package_pub -> visibility = 1
            if value.is_pub -> visibility = 2
            Val(Symbol{id: id, kind: SymbolKind.Trait, name: value.name, module_name: module_name, owner: None, span: value.name_span, ty: None, visibility: visibility})
        }
        .Tag(value) -> Val(sema_named_type_symbol(module_name, value.name, value.name_span, value.is_pub, value.is_package_pub))
        .Const(value) -> {
            id: symbol_id(SymbolKind.Constant, module_name, "", value.name)
            Val(Symbol{id: id, kind: SymbolKind.Constant, name: value.name, module_name: module_name, owner: None, span: value.name_span, ty: value.ty, visibility: 0})
        }
        .UnitFamily(value) -> Val(sema_named_type_symbol(module_name, value.family, value.family_span, value.is_pub, value.is_package_pub))
        .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> None
    }
}
sema_register_item: fn(scopes: &SemaScopeTable, declarations: &[SemaScopeDeclaration], item: Item, module_name: String, source_file: String, source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment], diagnostics: &[Diagnostic]) -> Bool {
    symbol: sema_item_symbol(item, module_name, source_file, source_origin, source_segments) ?? return false
    if sema_scope_add_module_symbol(scopes, symbol) {
        declarations.push(SemaScopeDeclaration{symbol_id: symbol.id, item: item})
        return true
    }
    diagnostics.push(sema_defined_twice(symbol.name, "module declarations share one name space", symbol.span))
    false
}

sema_append_function: fn(functions: &[FnBody], value: &&FnBody?) -> Bool Never! {
    function: value.move() ?? return false
    functions.push(function)
    true
}

sema_named_type_symbol: fn(module_name: String, name: String, span: Span, is_pub: Bool, is_package_pub: Bool) -> Symbol Never! {
    visibility := 0
    if is_package_pub -> visibility = 1
    if is_pub -> visibility = 2
    id: symbol_id(SymbolKind.Type, module_name, "", name)
    Symbol{id: id, kind: SymbolKind.Type, name: name, module_name: module_name, owner: None, span: span, ty: Val(Type.Named{name: name}), visibility: visibility}
}

sema_failure_carrier: fn(return_type: Type?) -> TFailureCarrier Never! {
    if return_type == None -> return TFailureCarrier.Result{success: Type.Named{name: "Unit"}, error: Type.Named{name: "Err"}}
    ty: return_type
    if ty == {
        .Named(name) -> {
            if name == "Never" -> return TFailureCarrier.Diverges{value: ty}
        }
        .Option(value) -> return TFailureCarrier.Optional{value: value}
        .Result(ok, err) -> {
            if err == {
                .Named(name) -> {
                    if name == "Never" -> return TFailureCarrier.Infallible
                }
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> {}
            }
            return TFailureCarrier.Result{success: ok, error: err}
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> {}
    }
    TFailureCarrier.Result{success: ty, error: Type.Named{name: "Err"}}
}

// A return that hands back a value: not `Unit` (bare or as a unit-fallible
// success) and not a `Stream` generator (the Rust reference's value_return).
sema_function_returns_value: fn(effective_return: Type) -> Bool Never! {
    success: if effective_return == {
        // copy: `ok` is a payload of read parameter `effective_return`, which keeps the original; the assigned `success` owns this one
        .Result(ok, _) -> ok.copy()
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> effective_return
    }
    if success == (Type.Named{name: "Unit"}) -> return false
    if effective_return == .Apply(name, _) && name == "Stream" -> return false
    if success == .Apply(name, _) && name == "Stream" -> return false
    true
}

sema_function_generic_params: fn(func: Func, graph_option: SemaRegistrationGraph?, module_identity: String, diagnostics: &[Diagnostic], complete: &Bool) -> [TGenericParam] {
    params := [TGenericParam]{}
    index := 0
    loop index < func.type_params.len() {
        parameter: func.type_params[index]
        bounds := [SymbolID]{}
        bound_index := 0
        loop bound_index < parameter.bounds.len() {
            bound := parameter.bounds[bound_index]
            bound_index += 1
            // The graph is read in place through the `.Val(…)` pattern on the
            // parameter; binding it to a local copies the whole graph.
            if graph_option == .Val(graph) {
                // Rust registers a generic bound as its written name and never
                // rejects an unregistered one at the declaration (tests/ui
                // embedded_generic_method_scope: `T: Clone`); such a bound has no
                // trait identity to carry, so a complete graph drops it.
                resolved: sema_type_graph_bound_symbol(graph, module_identity, bound) ?? {
                    if !graph.complete -> complete = false
                    next
                }
                if sema_resolved_kind(graph, resolved) != SymbolKind.Trait {
                    diagnostics.push(sema_error("E0301", parameter.name_span, "the generic bound `{bound}` is not a trait", "generic bounds refer to trait contracts", "use a trait name as the generic bound"))
                    complete = false
                    next
                }
                bounds.push(sema_resolved_id(graph, resolved))
            } else {
                complete = false
            }
        }
        params.push(TGenericParam{name: parameter.name, bounds: bounds, number: parameter.prep != None})
        index += 1
    }
    return params
}
sema_function_merge_generic_params: fn(enclosing: [TGenericParam], current: [TGenericParam]) -> [TGenericParam] Never! {
    merged := [TGenericParam]{}
    loop outer in enclosing {
        shadowed := false
        loop inner in current {
            if outer.name == inner.name -> shadowed = true
        }
        if !shadowed -> merged.push(outer.copy())
    }
    loop inner in current -> merged.push(inner.copy())
    merged
}
sema_function_normalize_owner_type: fn(graph: SemaRegistrationGraph, owner_type: Type, caller_module_identity: String) -> Type Never! {
    if owner_type == {
        .Named(name) -> {
            nominal_row: sema_type_resolve_nominal_row(graph, owner_type, caller_module_identity) ?? return owner_type
            nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
            // copy: the normalized owner type is a new owned Type. For a non-generic nominal it
            // equals `owner_type`, the caller's owner type (a read parameter), which the caller
            // keeps.
            if nominal.generic_params.len() == 0 -> return owner_type.copy()
            args: loop parameter in nominal.generic_params -> Type.Named{name: parameter.name}
            return Type.Apply{name: name, args: args}
        }
        // copy: the normalized owner type is a new owned Type. For other kinds it equals
        // `owner_type`, the caller's owner type (a read parameter), which the caller keeps.
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> return owner_type.copy()
    }
}

sema_function_owner_generic_params: fn(graph: SemaRegistrationGraph, owner_type: Type, caller_module_identity: String, diagnostics: &[Diagnostic], complete: &Bool) -> [TGenericParam] {
    normalized_owner_type := sema_function_normalize_owner_type(graph, owner_type, caller_module_identity)
    nominal_row: sema_type_resolve_nominal_row(graph, normalized_owner_type, caller_module_identity) ?? {
        if normalized_owner_type == .Apply(_, _) -> complete = false
        return [TGenericParam]{}
    }
    nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
    owner_args := if normalized_owner_type == {
        .Apply(_, args) -> args
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> [Type]{}
    }
    if nominal.generic_params.len() != owner_args.len() {
        if nominal.generic_params.len() > 0 || owner_args.len() > 0 -> complete = false
        return [TGenericParam]{}
    }
    owner_module_index: sema_registration_module_index(graph, nominal.symbol.module_name) ?? {
        if nominal.generic_params.len() > 0 -> complete = false
        return [TGenericParam]{}
    }
    owner_module: graph.modules[owner_module_index]
    params := [TGenericParam]{}
    index := 0
    loop index < nominal.generic_params.len() {
        parameter := nominal.generic_params[index]
        if owner_args[index] != (Type.Named{name: parameter.name}) {
            index += 1
            next
        }
        bounds := [SymbolID]{}
        loop bound in parameter.bounds {
            resolved := sema_type_graph_bound_symbol(graph, owner_module.module_identity, bound)
            // Rust never rejects an unregistered bound name at the declaration.
            if resolved == None {
                if !graph.complete -> complete = false
                next
            }
            symbol: resolved ?? {
                complete = false
                next
            }
            if sema_resolved_kind(graph, symbol) != SymbolKind.Trait {
                diagnostics.push(sema_error("E0301", parameter.span, "the generic bound `{bound}` is not a trait", "generic bounds refer to trait contracts", "use a trait name as the generic bound"))
                complete = false
                next
            }
            bounds.push(sema_resolved_id(graph, symbol))
        }
        params.push(TGenericParam{name: parameter.name, bounds: bounds, number: parameter.number})
        index += 1
    }
    return params
}

sema_function_explicit_receiver: fn(function_kind: TFuncKind, parameter_index: Int, parameter: Param) -> Bool Never! {
    if parameter_index != 0 || parameter.name != "self" -> return false
    if function_kind == {
        .Method(_, _) | .TraitMethod(_, _, _, _, _) -> true
        .TopLevel -> false
    }
}

sema_function_kind_owner_type: fn(function_kind: TFuncKind) -> Type? {
    if function_kind == {
        .Method(_, owner_type) | .TraitMethod(_, _, owner_type, _, _) -> Val(owner_type)
        .TopLevel -> None
    }
}

// An unmarked use of a value moves it only when it is the
// last use. A check records each unmarked move site that a later use reached;
// the function is then checked again with those sites known, where each one
// checks as the copy `name.copy()` and leaves its source usable. A site whose type
// does not copy stays a move, so its later use keeps E0121.
// The caller's environment and module scope table are borrowed, not copied:
// the function's generic parameters and name are set on the environment for
// its check and the body is checked in place on `module_scopes`, then both are
// restored. Copying them per function cost a copy of the registration graph
// and of every module declaration.
sema_function_check: fn(func: Func, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: &SemaScopeEnvironment, program: SemaProgramTables, module_scopes: &SemaScopeTable, host_hooks: SemaHostHookAccess?, diagnostics: &[Diagnostic], call_facts: &[SemaCallSiteFact], comptime_requests: &[SemaComptimeRequest], name_references: &[SemaNameReferenceFact]) -> SemaFunctionResult {
    if sema_function_check_unregistered(func, owner_id, function_kind, module_scopes) == .Val(unavailable) -> return unavailable
    base_generic_params: environment.generic_params.copy()
    generics := sema_function_check_generics(func, environment, program)
    environment.generic_params = generics.merged.copy()
    environment.function_name = func.name
    checked := sema_function_check_passes(func, owner_id, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
    environment.generic_params = base_generic_params.move()
    checked
}

// The same body checker on a compiler thread, reading one frozen environment.
// Admission excludes declared owner and planned function generic parameters.
// The scope owns the panic location for the entire check; no shared write is
// needed to the environment's callable name.
sema_function_check_shared: fn(func: Func, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, module_scopes: &SemaScopeTable, host_hooks: SemaHostHookAccess?, diagnostics: &[Diagnostic], call_facts: &[SemaCallSiteFact], comptime_requests: &[SemaComptimeRequest], name_references: &[SemaNameReferenceFact]) -> SemaFunctionResult {
    if sema_function_check_unregistered(func, owner_id, function_kind, module_scopes) == .Val(unavailable) -> return unavailable
    generics := sema_function_check_generics(func, environment, program)
    // copy: `previous_location` restores module_scopes.location_function after this function's
    // check overwrites it. Jet has no exchange on a field of the write-borrowed table.
    previous_location: module_scopes.location_function.copy()
    module_scopes.location_function = Val(func.name)
    checked := sema_function_check_passes(func, owner_id, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
    module_scopes.location_function = previous_location
    checked
}

// A top-level function the module scope does not register as itself is
// checked as unavailable, before anything else (its check reports nothing).
sema_function_check_unregistered: fn(func: Func, owner_id: SymbolID, function_kind: TFuncKind, scopes: SemaScopeTable) -> SemaFunctionResult? {
    if function_kind != TFuncKind.TopLevel -> return None
    registered: sema_scope_resolve(scopes, func.name) ?? return Val(sema_function_check_unavailable(owner_id.key, "the module scope has no registered function `{func.name}`"))
    if registered.id.key != owner_id.key || registered.span.start != func.name_span.start -> return Val(sema_function_check_unavailable(owner_id.key, "the registered function `{func.name}` is `{registered.id.key}` at offset {registered.span.start}, not `{owner_id.key}` at offset {func.name_span.start}"))
    None
}

// The function's own generic parameters (with the reports resolving them
// raised) and those merged with the environment's.
SemaFunctionCheckGenerics: struct {
    own: [TGenericParam]
    merged: [TGenericParam]
    diagnostics: [Diagnostic]
    complete: Bool
}

sema_function_check_generics: fn(func: Func, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaFunctionCheckGenerics {
    diagnostics := [Diagnostic]{}
    complete := true
    own := sema_function_generic_params(func, program.registration_graph, environment.module_identity, diagnostics, complete)
    merged := sema_function_merge_generic_params(environment.generic_params, own)
    SemaFunctionCheckGenerics{own: own, merged: merged, diagnostics: diagnostics, complete: complete}
}

// The checks of one function (sema_function_check): again while share sites
// are found or a use decides a `:=` number name's type
// (Expressions/NumberNames.jet), then its last pass's reports and facts are kept.
sema_function_check_passes: fn(func: Func, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, module_scopes: &SemaScopeTable, generics: SemaFunctionCheckGenerics, host_hooks: SemaHostHookAccess?, diagnostics: &[Diagnostic], call_facts: &[SemaCallSiteFact], comptime_requests: &[SemaComptimeRequest], name_references: &[SemaNameReferenceFact]) -> SemaFunctionResult {
    sema_comptime_body_work_count(environment.comptime_body_values, SemaComptimeBodyWorkOperation.FunctionsStarted)
    share_known := [Span]{}
    number_known := [SemaNumberRetype]{}
    loop {
        sema_comptime_body_work_count(environment.comptime_body_values, SemaComptimeBodyWorkOperation.CheckPassStarted)
        // copy: every pass starts from the generic checks' reports; a rechecked
        // pass discards its own list.
        pass_diagnostics := generics.diagnostics.copy()
        pass_call_facts := [SemaCallSiteFact]{}
        pass_comptime_requests := [SemaComptimeRequest]{}
        pass_name_references := [SemaNameReferenceFact]{}
        share_found := [SemaOwnershipShareSite]{}
        number_found := [SemaNumberRetype]{}
        mark: sema_scope_mark(module_scopes)
        checked := sema_function_check_pass(func, owner_id, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, share_known, share_found, number_known, number_found, pass_diagnostics, pass_call_facts, pass_comptime_requests, pass_name_references)
        sema_scope_rollback(module_scopes, mark)
        shares: sema_function_accept_share_sites(share_known, share_found, environment, program)
        retypes: sema_expr_number_accept_retypes(number_known, number_found)
        if !shares && !retypes {
            instance: if program.registration_graph == .Val(graph) -> sema_name_instance_span(graph, environment.module_identity, func.name) else -> None
            if instance == .Val(line) {
                loop diagnostic in pass_diagnostics -> diagnostics.push(sema_name_at_instance(diagnostic, line))
            } else {
                diagnostics.extend(pass_diagnostics.move())
            }
            call_facts.extend(pass_call_facts.move())
            comptime_requests.extend(pass_comptime_requests.move())
            name_references.extend(pass_name_references.move())
            return checked
        }
    }
}

// Keep each newly found share site whose value copies under the registry.
// Returns whether the known set grew, which is when another check is due.
sema_function_accept_share_sites: fn(share_known: &[Span], found: [SemaOwnershipShareSite], environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    added := false
    loop site in found {
        known := false
        loop span in share_known {
            if span.start == site.span.start && span.end == site.span.end -> known = true
        }
        if known -> next
        facts: sema_copy_classify(site.ty, SemaCopyIntent.Clone, environment, program, environment.generic_params, false)
        if !facts.accepted || facts.copyable || facts.materializes_view || facts.dynamic_loan -> next
        share_known.push(site.span)
        added = true
    }
    added
}

// The function check reads the registration graph through the read-only
// environment, so the graph is borrowed in place: binding it from the write
// parameter `updated` copied the whole graph (every module's AST) once per
// checked function, which made checking quadratic in program size.
sema_function_apply_scope_policies: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, span: Span, markers: [Marker]) Never! {
    if program.registration_graph == .Val(graph) {
        sema_scope_apply_unit_policy_for_function(scopes, graph, environment.module_identity, span)
        sema_string_view_apply_copies_policy(scopes, graph, environment.module_identity, markers)
        sema_call_marks_apply_policy(scopes, graph, environment.module_identity, markers)
    }
}

sema_function_static_roots: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: String) -> [String] Never! {
    if program.registration_graph == .Val(graph) -> return sema_ownership_static_roots(graph, module_identity)
    [String]{}
}

sema_function_persist_roots: fn(program: SemaProgramTables, module_identity: String) -> [String] Never! {
    if program.registration_graph == .Val(graph) -> return sema_ownership_persist_roots(graph, module_identity)
    [String]{}
}

sema_function_resolve_declared: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type, module_identity: String, generic_params: [TGenericParam]) -> Type Never! {
    if program.registration_graph == .Val(graph) -> return sema_type_resolve_declared_with_generics(graph, ty, module_identity, generic_params)
    // copy: the resolved declared type is a new owned Type. When nothing resolves it equals `ty`,
    // the declaration's written type (a read parameter), which stays in the AST.
    ty.copy()
}

// Whether written type `ty` mentions a type name that names nothing (E0119,
// reported by the signature walk sema_check_failure_contract_type). A
// parameter of such a type is in scope untyped, so its reads in the body
// check to nothing and add no follow-on report.
sema_function_type_names_nothing: fn(ty: Type, generic_names: [String], environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    if ty == {
        .Named(name) -> sema_failure_written_name_unknown(name, generic_names, environment, program)
        .Apply(name, args) -> {
            if sema_failure_written_name_unknown(name, generic_names, environment, program) -> return true
            loop arg in args {
                if sema_function_type_names_nothing(arg, generic_names, environment, program) -> return true
            }
            false
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> sema_function_type_names_nothing(inner, generic_names, environment, program)
        .Map(key, _, value) -> sema_function_type_names_nothing(key, generic_names, environment, program) || sema_function_type_names_nothing(value, generic_names, environment, program)
        .Result(ok, error) -> sema_function_type_names_nothing(ok, generic_names, environment, program) || sema_function_type_names_nothing(error, generic_names, environment, program)
        .Union(members) -> {
            loop member in members {
                if sema_function_type_names_nothing(member, generic_names, environment, program) -> return true
            }
            false
        }
        .Tuple(fields) -> {
            loop field in fields {
                if sema_function_type_names_nothing(field.ty, generic_names, environment, program) -> return true
            }
            false
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop param in params {
                if sema_function_type_names_nothing(param, generic_names, environment, program) -> return true
            }
            if ret == .Val(value) -> return sema_function_type_names_nothing(value, generic_names, environment, program)
            false
        }
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> false
    }
}

// The scope row of a parameter: untyped when its written type names nothing
// (sema_function_type_names_nothing), else `symbol` as declared.
sema_function_param_scope_symbol: fn(symbol: Symbol, written: Type, generic_names: [String], environment: SemaScopeEnvironment, program: SemaProgramTables) -> Symbol {
    scoped := symbol.copy()
    if sema_function_type_names_nothing(written, generic_names, environment, program) -> scoped.ty = None
    scoped
}

// Rust `is_consuming_close_body`: `func` is a method of a `Close` impl block,
// matched by the written trait leaf (`impl Secret.Close`), so a builtin
// `Close` that no module declares counts too.
sema_function_is_consuming_close_body: fn(func: Func, module_identity: String, program: SemaProgramTables) -> Bool Never! {
    if program.registration_graph == .Val(graph) {
        module_index: sema_registration_module_index(graph, module_identity) ?? return false
        loop item_index in 0..<graph.modules[module_index].program.items.len() {
            if graph.modules[module_index].program.items[item_index] == {
                .Impl(definition) -> {
                    if sema_function_close_trait_leaf(definition.trait_name ?? "") && sema_function_declares_span(definition.methods, func.span) -> return true
                }
                .Struct(definition) -> loop block in definition.trait_impls {
                    if sema_function_close_trait_leaf(block.trait_name) && sema_function_declares_span(block.methods, func.span) -> return true
                }
                .Enum(definition) -> loop block in definition.trait_impls {
                    if sema_function_close_trait_leaf(block.trait_name) && sema_function_declares_span(block.methods, func.span) -> return true
                }
                .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
            }
        }
    }
    false
}

sema_function_close_trait_leaf: fn(trait_name: String) -> Bool Never! {
    parts: trait_name.split("::").to_list()
    parts[parts.len() - 1] == "Close"
}

sema_function_declares_span: fn(methods: [Func], span: Span) -> Bool Never! {
    loop method in methods {
        if method.span == span -> return true
    }
    false
}

// One check of `func` (sema_function_check_passes). `updated` already carries
// the function's merged generic parameters (`generics.merged`) and name.
sema_function_check_pass: fn(func: Func, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, updated: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, generics: SemaFunctionCheckGenerics, host_hooks: SemaHostHookAccess?, share_known: [Span], share_found: &[SemaOwnershipShareSite], number_known: [SemaNumberRetype], number_found: &[SemaNumberRetype], diagnostics: &[Diagnostic], call_facts: &[SemaCallSiteFact], comptime_requests: &[SemaComptimeRequest], name_references: &[SemaNameReferenceFact]) -> SemaFunctionResult {
    diagnostics_start: diagnostics.len()
    module_identity := updated.module_identity
    module_name := updated.module_name
    fallback_source_file := updated.source_file
    complete := generics.complete
    // copy: the generic parameter lists stay with `generics` for the next pass;
    // the context owns this pass's.
    function_generic_params := generics.own.copy()
    generic_params := generics.merged.copy()
    sema_function_apply_scope_policies(updated, program, scopes, func.span, func.markers)
    // A function a marker template of another module generated reads the
    // names that template wrote in the template's module; the caller's mark
    // drops those bindings after the pass.
    if func.definition_module != "" && func.definition_module != module_identity {
        if program.registration_graph == .Val(graph) -> sema_scope_bind_definition_site(scopes, graph, func)
    }
    state := sema_ownership_state_init()
    state.fixed_length_write_params = updated.fixed_length_write_params
    state.share_known = share_known
    state.static_roots = sema_function_static_roots(updated, program, module_identity)
    state.persist_roots = sema_function_persist_roots(program, module_identity)
    tail_store := sema_statement_tail_store_init()
    // A raw protocol impl method (Comparable.compare, Display.display, …)
    // checks its body against the declared return, not the failure rail.
    effective_return := sema_checked_return_type(func.return_type, raw_protocol_return)
    effective_return = sema_function_resolve_declared(updated, program, effective_return, module_identity, generic_params)
    sema_scope_enter(scopes, state, owner_id.key)
    scopes.return_type = Val(effective_return)
    scopes.failure_carrier = Val(sema_failure_carrier(Val(effective_return)))
    scopes.loop_depth = 0
    scopes.ownership_call_depth = 0
    scopes.comptime_execution_depth = 0
    if func.is_comptime -> scopes.comptime_execution_depth = 1
    context := sema_check_context_init()
    context.host_hooks = host_hooks
    context.number_retypes_known = number_known
    context.generic_params = generic_params
    if func.return_type != None -> context.failure_contract_source = sema_failure_contract_source(func.return_type)
    if func.return_type == .Val(.Result(success, _)) {
        // copy: `success` is a payload of `func`, which keeps the original; the repair fact owns this one
        if func.return_type_span == .Val(return_span) -> context.failure_repair = Val(SemaFailureRepair{return_span: return_span, success: success.copy(), declaration_end: func.span.end})
    }
    // A lifted inline-module member reports its own body under its source name.
    context.function_name = sema_inline_member_source_name(func.name)
    // #6281 c176: the union solve reads this body's default `Err` route as
    // sema_failure_union_infer does: a top-level candidate other than the
    // entry `run`, which keeps the `Unit Err!` exit contract.
    if function_kind == .TopLevel && sema_failure_inference_candidate(func) {
        if program.registration_graph == .Val(graph) -> context.failure_union_inferable = func.name != "run" || graph.entry_module_identity != module_identity
    }
    context.arithmetic_policy = sema_function_arithmetic_policy(func.markers)
    context.compiler_generated = func.compiler_generated && !sema_test_synthetic_function(func) && !sema_policy_wrapper_function(func) && !sema_computed_field_getter_function(func)
    context.return_view_declared = func.declared_return_view_provenance != None
    if !complete -> sema_check_unsupported(context, "the generic parameters of `{func.name}` could not be resolved against the registration graph")
    // The declared signature's failure
    // domains and `Never` slots (E2417, E2422).
    generic_names: loop param in generic_params -> param.name
    if !sema_check_function_failure_contracts(func, updated, program, generic_names, diagnostics) -> complete = false
    // E2421: the public failure carrier, read from
    // the declared signature as the Rust reference's function registration does.
    sema_check_public_failure_carrier(func, updated, program, diagnostics)
    // E0939/E0940: the `#Memo` cache contract (Rust
    // `check_memoized_function`), also proven from the declared signature.
    sema_check_memoized_function(func, updated, program, generic_params, diagnostics)
    // E1410/E1411: a `#DevPanel` function's panel contract (Rust
    // `check_devtools_panels`), also read from the declared signature.
    sema_check_devtools_panel(func, updated, program, diagnostics)
    forward_defaults: sema_function_header_check_default_forward_refs(func, diagnostics)
    if forward_defaults.len() > 0 -> complete = false
    sema_function_header_lint_err_params(func, diagnostics)
    if function_kind == .TopLevel && !sema_module_is_core_source(module_identity) && !sema_module_no_prelude(updated, program) -> sema_function_header_lint_prelude_shadow(func, diagnostics)
    if !sema_function_header_check_variadic_bound_shape(func, updated, program, diagnostics) -> complete = false
    // copy: a shared-facts handle and its frontier, not the facts.
    context.comptime_body_values = updated.comptime_body_values.copy()
    sema_comptime_body_work_count(context.comptime_body_values, SemaComptimeBodyWorkOperation.ContextAttached)
    unsafe_gate_valid := true
    if func.is_unsafe {
        unsafe_source: sema_effect_source_from_function_key(func, module_identity, owner_id.key)
        unsafe_gate_valid = sema_effect_check_unsafe_function(unsafe_source, diagnostics)
        if !unsafe_gate_valid -> complete = false
    }
    is_method: if function_kind == {
        .Method(_, _) | .TraitMethod(_, _, _, _, _) -> true
        .TopLevel -> false
    }
    if !sema_function_header_check_root_params(func, is_method, diagnostics) -> complete = false
    sema_function_header_lint_positional_bools(func, is_method, diagnostics)
    if !sema_function_header_supported(func, context) -> complete = false
    // `self` is only a method's receiver; outside a type body or `impl` it
    // would silently be an ordinary parameter. An external `Type.method`
    // header left a function has an unresolved target, which E0301 reports;
    // an `impl Source -> Target` conversion routine takes its source as `self`.
    if !is_method && !func.compiler_generated && func.external_type == None && !sema_is_error_conversion_function(func) {
        loop param in func.params {
            if param.name == "self" {
                diagnostics.push(sema_self_outside_method(context.function_name, param.name_span))
                complete = false
                break
            }
        }
    }
    if func.is_reactive {
        if func.is_pure {
            diagnostics.push(sema_error("E2914", func.name_span, "`#Reactive fn` can't also declare `-[]>`", "a reactive effect re-runs when signals change, so it is not a pure function", "drop the `-[]>` bound or use `reactive.autorun` inside a plain `fn`"))
        }
        if func.return_type == .Val(return_type) && return_type != (Type.Named{name: "Unit"}) {
            diagnostics.push(sema_error("E2914", func.name_span, "`#Reactive fn` must not return a value", "`#Reactive fn` lowers to a reactive effect scope — effects don't produce a value", "drop the return type, or use `#Reactive {{ … }}` inside a plain `fn`"))
        }
    }
    if func.is_pure -> sema_check_pure_live_blocks(context.function_name, func.body, diagnostics)

    params := [TParameter]{}
    // The symbol key of an explicit read `self` (sema_place_borrow_function).
    place_borrow_receiver := ""
    param_index := 0
    loop param_index < func.params.len() {
        // The parameter is read in place (`func.params[param_index]`): a
        // binding of it copied the whole parameter, default expression included.
        parameter_ty := type_with_effective_parameter_fn_return(func.params[param_index].ty)
        if param_index == 0 && func.params[param_index].name == "self" {
            if function_kind == {
                .Method(_, receiver_type) -> parameter_ty = receiver_type
                .TraitMethod(_, _, receiver_type, _, _) -> parameter_ty = receiver_type
                .TopLevel -> {}
            }
        }
        if func.params[param_index].variadic -> parameter_ty = Type.List{element: parameter_ty}
        parameter_ty = sema_function_resolve_declared(updated, program, parameter_ty, module_identity, generic_params)
        // A `group: Group` parameter is the caller's live group: a `task` in
        // this body spawns into it, and the caller's `task.group` joins it.
        if parameter_ty == (Type.Named{name: "Group"}) -> sema_taskgroup_push_parameter(context, func.params[param_index].name)
        // E0502: a map in a declared parameter type needs a key-eligible key.
        if !(param_index == 0 && func.params[param_index].name == "self") && !sema_type_check_declared_map_keys(updated, program, parameter_ty, func.params[param_index].ty_span, diagnostics) -> complete = false
        default_expr := TExpr?{None}
        if func.params[param_index].default != None && !forward_defaults.contains(param_index) {
            default_context := sema_check_context_init()
            default_context.unsafe_depth = context.unsafe_depth
            default_context.generic_params = generic_params
            default_context.host_hooks = context.host_hooks
            // The default's node ids are the function's ids.
            default_context.next_expr_id = context.next_expr_id
            // The default's flat nodes are rows of the function's arena: it
            // lends its arena to the default's check and takes it back.
            default_context.arena = context.arena.move()
            // Checked on the live ownership state inside a fork and rolled back.
            default_fork: sema_ownership_fork(state)
            // A `#caller` default checks as the location literal each call
            // gets; a `#here` default is E2428.
            declared_default: func.params[param_index].default ?? Expr.Unit{span: func.params[param_index].name_span, id: AST_NODE_GENERATED}
            sema_site_here_default_check(declared_default, diagnostics)
            caller_default: if declared_default == .Ident(_, caller_span, _) && sema_site_is_caller(declared_default) -> Val(sema_site_location_expr("", updated, program, scopes, caller_span)) else -> Expr?{None}
            checked_default: sema_check_expression(caller_default ?? declared_default, Val(parameter_ty), updated, program, scopes, state, tail_store, default_context, diagnostics)
            context.arena = default_context.arena.move()
            default_context.arena = BodyFlat{tree: body_tree_new(), arena: body_tree_new(), into_arena: true}
            sema_ownership_fork_rollback(state, default_fork)
            sema_ownership_fork_close(state, default_fork)
            if {
                checked_default == None -> {
                    complete = false
                    loop reason in default_context.incomplete_reasons -> sema_check_unsupported(context, "default of `{func.params[param_index].name}`: {reason}")
                }
                else -> {
                    default_expr = checked_default
                    sema_check_context_merge_expr_ids(default_context, context)
                }
            }
        }
        param_mutable := func.params[param_index].convention == AccessConvention.Write
        // A sized-integer parameter starts with its type's interval, which a
        // later exit guard narrows.
        param_bounds: sema_expression_type_interval(parameter_ty)
        param_symbol := Symbol{
            id: symbol_id(SymbolKind.Parameter, module_identity, owner_id.key, func.params[param_index].name),
            kind: SymbolKind.Parameter,
            name: func.params[param_index].name,
            module_name: module_identity,
            owner: Val(owner_id.key),
            span: func.params[param_index].name_span,
            ty: Val(parameter_ty),
            visibility: 0,
        }
        scope_symbol := sema_function_param_scope_symbol(param_symbol, func.params[param_index].ty, generic_names, updated, program)
        if func.is_pure && scope_symbol.ty == .Val(scope_ty) {
            if sema_time_injected_clock(scope_ty) == .Val(injected) -> scope_symbol.ty = Val(injected)
        }
        if {
            !sema_scope_declare_local(scopes, scope_symbol, param_mutable, func.params[param_index].convention, param_bounds, false) -> {
                diagnostics.push(sema_already_defined(func.params[param_index].name, func.params[param_index].name_span))
                complete = false
            }
            else -> {
                sema_ownership_declare_binding(state, param_symbol, true)
                if param_index == 0 && func.params[param_index].name == "self" && func.params[param_index].convention == AccessConvention.Move && func.name == "close" && sema_function_is_consuming_close_body(func, module_identity, program) -> state.close_receiver_key = param_symbol.id.key
                if function_kind == {
                    .Method(_, _) | .TraitMethod(_, _, _, _, _) -> {
                        if param_index == 0 && func.params[param_index].name == "self" -> context.return_view_receiver_key = param_symbol.id.key
                        else -> context.return_view_parameter_keys.push(param_symbol.id.key)
                    }
                    .TopLevel -> context.return_view_parameter_keys.push(param_symbol.id.key)
                }
            }
        }
        local := checked_symbol_local(func.params[param_index].name, func.params[param_index].name_span, param_symbol.id, parameter_ty)
        local.mutable = param_mutable
        if !sema_function_explicit_receiver(function_kind, param_index, func.params[param_index]) {
            public_label: func.params[param_index].public_label.map((label) -> label.name) ?? func.params[param_index].name
            params.push(TParameter{local: local, name: func.params[param_index].name, span: func.params[param_index].name_span, ty: parameter_ty, convention: func.params[param_index].convention, public_label: public_label, zone: func.params[param_index].zone, default: default_expr, variadic: func.params[param_index].variadic})
        } else if func.params[param_index].convention == AccessConvention.Read {
            place_borrow_receiver = param_symbol.id.key
        }
        param_index += 1
    }
    // Rust `check_fn`: the function's builtin markers bind their signatures
    // with its parameters in scope. The markers are written before the
    // parameters, so names resolve position free, as the contract conditions do
    // (sema_contract_check_expr).
    marker_position_free: scopes.position_free
    scopes.position_free = true
    _ := sema_marker_rules_check_rule_signatures(func.markers, updated, program, scopes, state, tail_store, context, diagnostics)
    scopes.position_free = marker_position_free
    if func.return_type == .Val(declared_return) {
        resolved_return := declared_return
        resolved_return = sema_function_resolve_declared(updated, program, declared_return, module_identity, generic_params)
        if !sema_type_check_declared_map_keys(updated, program, resolved_return, func.return_type_span ?? func.name_span, diagnostics) -> complete = false
        // E1110: a group is call-stack-only spawn authority that flows down
        // through a direct parameter; a returned group would outlive the
        // block that joins it.
        if sema_stmt_contains_taskgroup(resolved_return) {
            diagnostics.push(sema_error("E1110", func.return_type_span ?? func.name_span, "`Group` cannot be returned", "a task group is call-stack-only spawn authority; a returned group would outlive the block that joins it", "pass `group: Group` down to the helper that spawns instead of returning it"))
        }
    }
    // `check_kernel_marker`: the declaration and worker-boundary obligations of
    // `#Kernel(.parallel)` (E1102); its effect and body obligations wait for
    // the effect rows (Kernel.jet).
    if func.kernel == .Val(kernel) {
        if !sema_kernel_check_declaration(func, kernel, is_method, params, effective_return, updated, program, scopes, context, diagnostics) -> complete = false
    }
    if func.is_unsafe && unsafe_gate_valid -> context.unsafe_depth = 1
    contract: sema_contract_check_function(func, updated, program, scopes, state, tail_store, context, diagnostics)
    if !contract.complete -> complete = false

    // With no written return type the function returns
    // nothing, so a value on its last line is lost (E0433). With a value
    // return (not a generator; written, or projected by the bundle failure
    // solve) the last line is the value handed back, and a table on the last
    // line hands back the value its arms end in. A `Never` function hands
    // back no value: E2423 (sema_check_never_fallthrough) owns its end.
    returns_value: sema_function_returns_value(effective_return) && !sema_function_promises_never(func)
    if func.body.len() > 0 && func.body[func.body.len() - 1] == .Expr(tail) {
        if {
            returns_value -> context.value_tail_span = Val(expr_span(tail))
            func.return_type_span == None && !func.compiler_generated -> context.lost_tail_span = Val(expr_span(tail))
            else -> {}
        }
    }
    if returns_value && func.body.len() > 0 && func.body[func.body.len() - 1] == .Switch(_, _, _, table_span) {
        context.value_tail_span = Val(table_span)
    }
    // Rust check_value_tail: a last-line `#Unsafe { … }` region checks its
    // body as the value block, so the region's own last line is the value.
    if returns_value && func.body.len() > 0 && func.body[func.body.len() - 1] == .Unsafe(_, _, unsafe_body, _) {
        context.value_tail_span = sema_stmt_value_tail_marker(unsafe_body)
    }
    // Imported Core bodies and generated functions have no user source to fix.
    if returns_value && !func.compiler_generated && !updated.module_identity.starts_with("<corelib>/") -> sema_stmt_value_block_tail_lints(func.body, diagnostics)
    statements := sema_check_statements(func.body, Val(effective_return), updated, program, scopes, state, tail_store, context, diagnostics, 0)
    // The caller's group joins every task this body spawned into a `Group`
    // parameter, so those handles owe no `join` here.
    sema_taskgroup_mark_spawns_owned(context, SemaTaskGroupOrigin.Parameter, scopes, state, diagnostics)
    context.lost_tail_span = None
    context.value_tail_span = None
    loop site in state.share_found -> share_found.push(site)
    loop retype in context.number_retypes_found -> number_found.push(retype)
    if !statements.complete -> complete = false
    if !sema_check_never_fallthrough(func, updated, program, scopes, diagnostics) -> complete = false
    sema_lint_inferred_never_return(func, owner_id.key, updated, program, diagnostics)
    sema_function_header_external_target(func, diagnostics, diagnostics_start)
    // Rust `check_value_block` over the body: a value body reports E0114 when
    // it can reach its end without a value.
    if returns_value && !sema_stmt_check_value_block_end(func.body, statements.value, Val(effective_return), func.span, context.function_name, scopes, diagnostics) -> complete = false
    // Validation borrows the original checked rows. Once that loan ends the
    // same vector moves into the function; no owning TStmt-vector copy.
    body := statements.value.move()
    if contract.complete && contract.post.len() > 0 {
        body = [TStmt]{TStmt.ContractScope{pre: [TContract]{}, body: body, post: contract.post, result: contract.result, span: func.span}}
    }
    // Unused-binding lints address authored code; a compiler-generated body
    // (derived codec scaffolding) binds every slot it may need.
    if !context.compiler_generated -> sema_ownership_finalize_references(state, diagnostics)
    // The context's facts move to the caller's lists; each emptied field is
    // set again so the spent context still moves whole into the result.
    call_facts.extend(context.call_facts.move())
    context.call_facts = [SemaCallSiteFact]{}
    comptime_requests.extend(context.comptime_requests.move())
    context.comptime_requests = [SemaComptimeRequest]{}
    name_references.extend(context.name_references.move())
    context.name_references = [SemaNameReferenceFact]{}
    sema_single_use_leave_scope(scopes, state, diagnostics)
    source_line := sema_source_line_at(updated.source_segments, func.name_span)
    if source_line == None {
        complete = false
        sema_check_unsupported(context, "no source segment covers the declaration of `{func.name}` at offset {func.name_span.start}")
    }
    return_view_provenance := sema_function_return_view_provenance(func, context.return_view_provenance, diagnostics, complete)
    if !complete -> return sema_function_result(None, owner_id.key, context.move())
    source_line_value: source_line ?? return sema_function_result(None, owner_id.key, context.move())
    source_file: sema_source_file_at(updated.source_segments, fallback_source_file, updated.source_origin, func.span)
    visibility := TVisibility.Private
    if func.is_pub -> visibility = TVisibility.Public
    effects: TEffectFacts{direct: [String]{}, solved: [String]{}, call_edges: [String]{}, maximal: false, direct_spans: [TEffectSpan]{}, module_writes: context.module_writes.move()}
    context.module_writes = [TEffectSpan]{}
    unsafe_gate := TUnsafeGate?{None}
    if func.is_unsafe && unsafe_gate_valid && func.unsafe_reason != None {
        reason: func.unsafe_reason ?? ""
        unsafe_span: func.unsafe_span ?? func.span
        line: sema_source_line_at(updated.source_segments, unsafe_span) ?? source_line_value
        unsafe_gate = Val(TUnsafeGate{file: sema_source_file_at(updated.source_segments, fallback_source_file, updated.source_origin, unsafe_span), line: line, reason: reason, enabled: true, fenced: false})
    }
    sema_place_borrow_function(body, params, place_borrow_receiver, context.arena.tree)
    memo: sema_function_header_memo_config(func)
    // `#Scalar` keeps every loop of the body on the scalar path: its loops
    // record no loop proof (LoopFacts.jet).
    scalar := false
    loop marker in func.markers {
        if marker.name == MARKER_SCALAR -> scalar = true
    }
    written_row := [String]?{None}
    if func.declared_effects == .Val(row) {
        names := [String]{}
        loop entry in row -> names.push(entry.name.copy())
        written_row = Val(names)
    }
    effect_scope: effect_scope_descriptor(func.name, owner_id.key, func.params.len() > 0 && func.params[0].name == "path", written_row)
    built := TFunc{
        name: func.name,
        module_name: module_name,
        module_identity: module_identity,
        key: owner_id.key,
        source_file: source_file,
        source_span: func.span,
        failure_carrier: sema_failure_carrier(Val(effective_return)),
        effects: effects,
        web_bucket: None,
        web_marker: func.web_marker,
        visibility: visibility,
        foreign: None,
        params: params,
        web_param_reconstructions: [TWebParamReconstruction]{},
        ret: Val(effective_return),
        gc_return: func.gc_return,
        gc_scope: func.gc_scope,
        return_view_provenance: return_view_provenance,
        generic_params: function_generic_params,
        is_main: false,
        line: source_line_value,
        synthetic: func.compiler_generated,
        is_unsafe: func.is_unsafe,
        unsafe_gate: unsafe_gate,
        is_pure: func.is_pure,
        memo_bound: memo.bound,
        memo_unbounded: memo.unbounded,
        is_reactive: func.is_reactive,
        reactive_upgrades: context.reactive_upgrades,
        body: body.move(),
        is_inline: func.is_inline,
        is_inline_always: func.is_inline_always,
        is_scalar: scalar,
        kernel_proof: None,
        uses_stack_sentry: false,
        kind: function_kind,
        origin_facts: context.origin_facts.move(),
        typed_goals: context.typed_goals.move(),
        index_proofs: context.index_proofs.move(),
        pre: if contract.complete -> contract.pre.move() else -> [TContract]{},
        effect_scope: effect_scope,
        effect_scope_regions: sema_authority_scope_regions(func.body, func.name),
    }
    // The checker's tree ends here, as the function's flat body; nodes the
    // checker gave no id take flat-local ones.
    context.origin_facts = [TOriginProjection]{}
    context.typed_goals = [TTypedGoal]{}
    context.index_proofs = [TIndexProof]{}
    flat: body_flat_function(built, context.arena.tree)
    sema_function_result(Val(flat), owner_id.key, context.move())
}

check_program: fn(input: Program, module_name: String, source_file: String, source_segments: [SemaSourceSegment]) -> SemaResult {
    diagnostics := [Diagnostic]{}
    policy_program := Program?{None}
    if input.user_policy_declarations.len() > 0 {
        prepared := input.copy()
        declarations: sema_policy_declarations_checked(input.user_policy_declarations, diagnostics)
        sema_policy_materialize(prepared, declarations, module_name, source_file, SemaSourceOrigin.Snapshot, source_segments, diagnostics)
        policy_program = Val(prepared.move())
    }
    source_program: policy_program ?? input
    sema_marker_rules_validate_allow(source_program, diagnostics)
    functions := [FnBody]{}
    call_facts := [SemaCallSiteFact]{}
    hardware_use := sema_hardware_empty_use()
    name_references := [SemaNameReferenceFact]{}
    comptime_requests := [SemaComptimeRequest]{}
    comptime_body_sources := [SemaComptimeBodySource]{}
    compute_facts := [SemaComputeFunctionFacts]{}
    scopes := sema_scope_init(module_name)
    local_declarations := [SemaScopeDeclaration]{}
    exact_int_reachable := false
    copy_events := [SemaCopyEvent]{}
    memory_plan := sema_function_memory_plan_for_program(source_program, module_name, "")
    // User policies are materialized above and `#Allow` is validated, so only
    // other rule applications leave the slice incomplete.
    complete := source_program.script_body.len() == 0 && source_program.imports.len() == 0 && source_program.block_spans.len() == 0 && source_program.web_target_ceiling == None && !source_program.no_prelude && source_program.html_path == None && !sema_function_memory_has_unsupported_policies(source_program.policy_declarations) && !sema_policy_has_unsupported_applications(source_program)
    item_index := 0
    loop item_index < source_program.items.len() {
        item: source_program.items[item_index]
        if !sema_register_item(scopes, local_declarations, item, module_name, source_file, SemaSourceOrigin.Snapshot, source_segments, diagnostics) -> complete = false
        if item == {
            .Func(_) -> {}
            .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> complete = false
        }
        item_index += 1
    }
    job_diagnostics := sema_check_job_names(source_program.items)
    if job_diagnostics.len() > 0 {
        loop diagnostic in job_diagnostics -> diagnostics.push(diagnostic)
        complete = false
    }
    loop diagnostic in sema_scope_members_check(source_program.items) -> diagnostics.push(diagnostic)
    environment := sema_scope_environment_init(module_name, "", module_name, source_file, SemaSourceOrigin.Snapshot, source_segments, local_declarations)
    // One program, no registration graph and no checked types.
    program := sema_program_tables_init(None, [TTypeDef]{})
    environment.else_arms = source_program.else_arms
    environment.debug_sites = source_program.debug_sites
    environment.fixed_length_write_params = sema_fixed_length_write_params(source_program.items)

    item_index = 0
    loop item_index < source_program.items.len() {
        if source_program.items[item_index] == {
            .Func(func) -> {
                function_call_facts := [SemaCallSiteFact]{}
                function_comptime_requests := [SemaComptimeRequest]{}
                function_name_references := [SemaNameReferenceFact]{}
                memory_row := sema_function_memory_position(memory_plan, module_name, "", func.name, func.span)
                memory_func := func
                if memory_row == {
                    .Val(position) -> {
                        if memory_plan.functions[position].function == .Val(planned) -> memory_func = planned
                        loop diagnostic in memory_plan.functions[position].diagnostics -> diagnostics.push(diagnostic)
                        if !memory_plan.functions[position].complete -> complete = false
                    }
                    .None -> {
                        complete = false
                    }
                }
                checked: sema_function_check(memory_func, symbol_id(SymbolKind.Function, module_name, "", func.name), TFuncKind.TopLevel, false, environment, program, scopes, None, diagnostics, function_call_facts, function_comptime_requests, function_name_references)
                sema_hardware_use_merge(hardware_use, sema_hardware_use_snapshot(checked.hardware_use))
                comptime_body_sources.extend(checked.comptime_body_sources.move())
                compute_facts.push(checked.compute_facts)
                exact_int_reachable = exact_int_reachable || checked.exact_int_reachable
                copy_events.extend(checked.copy_events.move())
                call_facts.extend(function_call_facts.move())
                comptime_requests.extend(function_comptime_requests.move())
                name_references.extend(function_name_references.move())
                if !checked.complete || !sema_append_function(functions, checked.value.move()) -> complete = false
            }
            .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
        item_index += 1
    }
    // #3708: one program has no bundle failure solve, so every recorded
    // failure-domain obligation is emitted as reported.
    if sema_failure_settle_obligations(diagnostics, [String:Bool]{}) -> complete = false
    sema_attach_diagnostic_source_locations(diagnostics, 0, source_segments)
    SemaResult{module_name: module_name, functions: functions, call_facts: call_facts, hardware_use: hardware_use, comptime_requests: comptime_requests, comptime_body_sources: comptime_body_sources, compute_facts: compute_facts, name_references: name_references, exact_int_reachable: exact_int_reachable, copy_events: copy_events, diagnostics: diagnostics, complete: complete}
}

// `rows` is sema_comptime_checked_function_rows(functions).
sema_comptime_find_checked_function: fn(functions: [SemaComptimeFunctionResult], rows: [String:Int], module_identity: String, function_key: String) -> SemaComptimeFunctionResult? {
    row: rows.get("{module_identity}\n{function_key}") ?? return None
    Val(functions[row])
}

// The functions of `functions` but those whose keys `keys` holds.
sema_comptime_functions_without: fn(functions: [SemaComptimeFunctionResult], keys: [String]) -> [SemaComptimeFunctionResult] Never! {
    dropped := [String:Bool]{}
    loop key in keys -> dropped[key] = true
    kept := [SemaComptimeFunctionResult]{}
    loop function in functions {
        if dropped.get(function.function_key) == None -> kept.push(function.copy())
    }
    kept
}

// `module\nkey` -> the first row of that function in `functions`, built once
// per check pass rather than rescanning the list for every checked function.
sema_comptime_checked_function_rows: fn(functions: [SemaComptimeFunctionResult]) -> [String:Int] Never! {
    rows := [String:Int]{}
    loop (row, checked) in functions {
        key: "{checked.module_identity}\n{checked.function_key}"
        if rows.get(key) == None -> rows[key] = row
    }
    rows
}

// A result whose only errors are failure obligations is appended too: the
// caller carries those obligations to the solve that settles them.
sema_comptime_append_checked_function: fn(result: SemaComptimeFunctionResult, functions: &[FnBody], call_facts: &[SemaCallSiteFact], comptime_requests: &[SemaComptimeRequest], name_references: &[SemaNameReferenceFact]) -> Bool Never! {
    function: result.function ?? return false
    functions.push(function.copy())
    loop fact in result.call_facts -> call_facts.push(fact.copy())
    loop request in result.calls -> comptime_requests.push(request.copy())
    loop reference in result.name_references -> name_references.push(reference.copy())
    result.complete || result.obligations_pending
}

// The failure obligations of a comptime-checked body, which the body pass
// that reuses it settles with the bundle solve, as it does for a body it
// checks itself.
sema_comptime_push_obligations: fn(result: SemaComptimeFunctionResult, diagnostics: &[Diagnostic]) Never! {
    if !result.obligations_pending -> return
    mark: sema_failure_obligation_mark()
    loop diagnostic in result.diagnostics {
        if sema_failure_obligation_callee(diagnostic, mark) != None -> diagnostics.push(diagnostic.copy())
    }
}

// sema_comptime_append_checked_function into one module result in place,
// carrying the function's exact-int and copy facts as well.
sema_comptime_append_checked_function_to_module: fn(result: SemaComptimeFunctionResult, module_row: &SemaGraphModuleResult) -> Bool Never! {
    if !sema_comptime_append_checked_function(result, module_row.functions, module_row.call_facts, module_row.comptime_requests, module_row.name_references) -> return false
    module_row.exact_int_reachable = module_row.exact_int_reachable || result.exact_int_reachable
    loop event in result.copy_events -> module_row.copy_events.push(event.copy())
    true
}

SemaComptimeFunctionSource: struct {
    declaration: Func
    symbol: Symbol
    kind: TFuncKind
    raw_protocol_return: Bool
}

sema_comptime_method_kind: fn(function: Func, owner_type: Type, trait_symbol: Symbol?) -> TFuncKind Never! {
    self_convention := AccessConvention?{None}
    if function.params.len() > 0 && function.params[0].name == "self" -> self_convention = Val(function.params[0].convention)
    if trait_symbol == {
        .Val(resolved_trait) -> return TFuncKind.TraitMethod{is_unsafe: function.is_unsafe, self_convention: self_convention, owner_type: owner_type, trait_name: resolved_trait.id, serde_codec: None}
        .None -> return TFuncKind.Method{self_convention: self_convention, owner_type: owner_type}
    }
}

sema_comptime_find_function_source: fn(graph: SemaRegistrationGraph, module_identity: String, function_key: String) -> SemaComptimeFunctionSource? {
    module_index: sema_registration_module_index(graph, module_identity) ?? return None
    sema_comptime_indexed_function_source(graph, module_index, function_key)
}

// The checked foreign row of the foreign function registered under
// `function_key`: an inline foreign (`#FFI`) function, or a per-callable
// `#Import(c)`. A jet.runtime binding is one of the latter, and IR lowers its
// row as a runtime route on every tier, compile time included. Validation
// findings are the module check's to report (sema_checked_foreign_functions),
// so this lookup drops them.
sema_comptime_foreign_row: fn(graph: SemaRegistrationGraph, function_key: String) -> SemaCheckedForeignFunction? {
    row: sema_registration_callable_row(graph, function_key) ?? return None
    if row == .Function(declaring, index) {
        if sema_function_is_guest_import(graph.modules[declaring].functions[index].declaration) -> return sema_checked_guest_import_foreign_row(graph, graph.modules[declaring], graph.modules[declaring].functions[index])
        reported := [Diagnostic]{}
        return sema_checked_inline_foreign_row(graph, graph.modules[declaring], graph.modules[declaring].functions[index], reported)
    }
    None
}

// The staged source of the callable registered under `function_key`, through
// its SymbolId (Rust `ct_funcs` keyed table); `module_index` >= 0 keeps
// only a row that module declares.
sema_comptime_indexed_function_source: fn(graph: SemaRegistrationGraph, module_index: Int, function_key: String) -> SemaComptimeFunctionSource? {
    row: sema_registration_callable_row(graph, function_key) ?? return None
    if row == {
        .Function(declaring, index) -> {
            if module_index >= 0 && declaring != module_index -> return None
            // copy: the source is the caller's own; the row stays in the graph.
            return Val(SemaComptimeFunctionSource{declaration: graph.modules[declaring].functions[index].declaration.copy(), symbol: graph.modules[declaring].functions[index].symbol.copy(), kind: TFuncKind.TopLevel, raw_protocol_return: graph.modules[declaring].functions[index].raw_protocol_return})
        }
        .NominalMethod(declaring, owner, index) -> {
            if module_index >= 0 && declaring != module_index -> return None
            // copy: the source is the caller's own; the row stays in the graph.
            declaration := graph.modules[declaring].nominals[owner].methods[index].declaration.copy()
            if declaration.body.len() == 0 && sema_codec_pending_method_body(graph, graph.modules[declaring].nominals[owner].symbol.name, function_key) == .Val(body) -> declaration.body = body
            return Val(SemaComptimeFunctionSource{declaration: declaration, symbol: graph.modules[declaring].nominals[owner].methods[index].symbol.copy(), kind: sema_comptime_method_kind(graph.modules[declaring].nominals[owner].methods[index].declaration, graph.modules[declaring].nominals[owner].ty, None), raw_protocol_return: graph.modules[declaring].nominals[owner].methods[index].raw_protocol_return})
        }
        .ImplMethod(declaring, owner, index) -> {
            if module_index >= 0 && declaring != module_index -> return None
            // copy: the source is the caller's own; the row stays in the graph.
            declaration := graph.modules[declaring].impls[owner].methods[index].declaration.copy()
            if sema_codec_pending_body(graph, declaring, owner, declaration.name) == .Val(body) -> declaration.body = body
            return Val(SemaComptimeFunctionSource{declaration: declaration, symbol: graph.modules[declaring].impls[owner].methods[index].symbol.copy(), kind: sema_comptime_method_kind(graph.modules[declaring].impls[owner].methods[index].declaration, graph.modules[declaring].impls[owner].target_type, graph.modules[declaring].impls[owner].trait_symbol), raw_protocol_return: graph.modules[declaring].impls[owner].methods[index].raw_protocol_return})
        }
        .Foreign(_, _) -> return None
    }
}

// Read the environment's staged graph only inside these probes; subsequent
// environment writes must not turn the graph payload into an owned snapshot.
sema_comptime_normalize_owner: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, owner: Type, module_identity: String) -> Type? {
    if program.registration_graph == .Val(graph) {
        return Val(sema_function_normalize_owner_type(graph, owner, module_identity))
    }
    None
}

sema_comptime_owner_generic_params: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, owner: Type, module_identity: String, diagnostics: &[Diagnostic], complete: &Bool) -> [TGenericParam] {
    if program.registration_graph == .Val(graph) {
        return sema_function_owner_generic_params(graph, owner, module_identity, diagnostics, complete)
    }
    [TGenericParam]{}
}

// `memory_plan` is the graph's memory plan, built once by the caller: known-
// time values only type constants, never the functions the plan annotates.
// The caller keeps the run's checked functions and reuses a complete one
// instead of calling this again.
// `probe` is the run's module scope (sema_comptime_probe_init), lent to every
// item and function check of the run.
sema_check_comptime_function: fn(graph: SemaRegistrationGraph, environment: &SemaScopeEnvironment, program: SemaProgramTables, probe: &SemaScopeProbe, available: SemaComptimeAvailableConstants, memory_plan: SemaFunctionMemoryPlan, values: [SemaComptimeItemValue], module_identity: String, function_key: String) -> SemaComptimeFunctionResult {
    unresolved := SemaComptimeFunctionResult{
        module_identity: module_identity,
        function_key: function_key,
        function: None,
        waiting_dependencies: [String]{},
        calls: [SemaComptimeRequest]{},
        reachable_function_keys: [String]{},
        call_facts: [SemaCallSiteFact]{},
        hardware_use: sema_hardware_empty_use(),
        name_references: [SemaNameReferenceFact]{},
        comptime_body_sources: [SemaComptimeBodySource]{},
        compute_facts: SemaComputeFunctionFacts{
            function_key: function_key,
            compute_calls: [SemaComputeCallFact]{},
            autodiff_obligations: [SemaAutodiffObligation]{},
            autodiff_safe_panic: false,
            autodiff_unsafe_panic: false,
        },
        diagnostics: [Diagnostic]{},
        exact_int_reachable: false,
        copy_events: [SemaCopyEvent]{},
        complete: false,
        incomplete_reasons: [String]{"`{function_key}` has no registered comptime function source in module `{module_identity}`"},
    }
    source: sema_comptime_find_function_source(graph, module_identity, function_key) ?? return unresolved
    if source.declaration.inline_foreign != None || sema_function_is_guest_import(source.declaration) {
        unresolved.incomplete_reasons = [String]{}
        unresolved.foreign = sema_comptime_foreign_row(graph, function_key)
        if unresolved.foreign == None {
            unresolved.incomplete_reasons.push("the foreign function `{source.declaration.name}` has no checked foreign row")
            return unresolved
        }
        // A per-callable `#Import(c)` has no body, so no failure source and
        // no edge: the closure's solve proves an unannotated one infallible,
        // as the bundle solve does (sema_failure_solve).
        if sema_function_is_guest_import(source.declaration) -> unresolved.failure = Val(SemaFunctionFailureFacts{function_key: function_key, direct: false, edges: [String]{}})
        unresolved.complete = true
        return unresolved
    }
    // Any function a compile-time body reaches runs while building; the
    // native run's effect gate (E3401) rejects an effectful call. No
    // `#run fn` or `pure` marker is required.
    // Retarget module-local scope facts while reading the retained graph
    // from its single owner in `program`.
    // copy: a handle copy (Shared facts plus length and frontier ints): this check reads a frozen
    // prefix while environment.comptime_body_publication keeps advancing.
    body_values := environment.comptime_body_publication.copy()
    entered: sema_scope_environment_enter_probe_module(environment, program, module_identity, body_values)
    if !entered -> return unresolved
    diagnostics := [Diagnostic]{}
    memory_row := sema_function_memory_position(memory_plan, module_identity, sema_function_memory_owner(source.kind), source.declaration.name, source.declaration.span)
    memory_func := source.declaration
    memory_complete := true
    if memory_row == {
        .Val(position) -> {
            // A pending codec's planned row is its header: the body the
            // source carries (sema_codec_pending_body) stands.
            if memory_plan.functions[position].function == .Val(planned) && (planned.body.len() > 0 || source.declaration.body.len() == 0) -> memory_func = planned
            loop diagnostic in memory_plan.functions[position].diagnostics -> diagnostics.push(diagnostic.copy())
            memory_complete = memory_plan.functions[position].complete
        }
        .None -> {
            memory_complete = false
        }
    }
    sema_comptime_probe_prepare(probe, environment, program, available.counted_values)
    if !probe.applied {
        loop diagnostic in probe.diagnostics -> diagnostics.push(diagnostic.copy())
        sema_attach_diagnostic_source_locations(diagnostics, 0, environment.source_segments)
        return SemaComptimeFunctionResult{
            module_identity: module_identity,
            function_key: function_key,
            function: None,
            waiting_dependencies: [String]{},
            calls: [SemaComptimeRequest]{},
            reachable_function_keys: [String]{},
            call_facts: [SemaCallSiteFact]{},
            hardware_use: sema_hardware_empty_use(),
            name_references: [SemaNameReferenceFact]{},
            comptime_body_sources: [SemaComptimeBodySource]{},
            compute_facts: SemaComputeFunctionFacts{
                function_key: function_key,
                compute_calls: [SemaComputeCallFact]{},
                autodiff_obligations: [SemaAutodiffObligation]{},
                autodiff_safe_panic: false,
                autodiff_unsafe_panic: false,
            },
            diagnostics: diagnostics,
            exact_int_reachable: false,
            copy_events: [SemaCopyEvent]{},
            complete: false,
            incomplete_reasons: [String]{"the scope of module `{module_identity}` could not be applied"},
        }
    }
    call_facts := [SemaCallSiteFact]{}
    calls := [SemaComptimeRequest]{}
    name_references := [SemaNameReferenceFact]{}
    owner_generic_complete := true
    function_kind := source.kind
    owner_type := sema_function_kind_owner_type(source.kind)
    if owner_type != None {
        owner: owner_type ?? Type.Named{name: "Unit"}
        normalized_owner_type: sema_comptime_normalize_owner(environment, program, owner, module_identity) ?? return unresolved
        environment.generic_params = sema_comptime_owner_generic_params(environment, program, normalized_owner_type, module_identity, diagnostics, owner_generic_complete)
        function_kind = if source.kind == {
            .Method(convention, _) -> TFuncKind.Method{self_convention: convention, owner_type: normalized_owner_type}
            .TraitMethod(is_unsafe, convention, _, trait_symbol, codec) -> TFuncKind.TraitMethod{is_unsafe: is_unsafe, self_convention: convention, owner_type: normalized_owner_type, trait_name: trait_symbol, serde_codec: codec}
            .TopLevel -> source.kind
        }
    }
    mark: sema_scope_mark(probe.table)
    probe.table.comptime_execution_depth = 1
    checked := sema_function_check(memory_func, source.symbol.id, function_kind, source.raw_protocol_return, environment, program, probe.table, probe.host_hooks, diagnostics, call_facts, calls, name_references)
    sema_scope_rollback(probe.table, mark)
    dependencies := sema_comptime_environment_dependencies(environment, program, name_references, values) ?? return unresolved
    waiting := sema_comptime_waiting_dependencies(available, dependencies)
    sema_attach_diagnostic_source_locations(diagnostics, 0, environment.source_segments)
    incomplete_reasons := [String]{}
    if !memory_complete -> incomplete_reasons.push("its memory plan row is missing or incomplete")
    if !owner_generic_complete -> incomplete_reasons.push("its owner's generic parameters could not be resolved")
    if !checked.complete {
        if checked.incomplete_reasons.len() == 0 -> incomplete_reasons.push("body checking is incomplete")
        incomplete_reasons.extend(checked.incomplete_reasons.move())
    }
    settled: memory_complete && checked.complete && owner_generic_complete && waiting.len() == 0
    complete: settled && !sema_has_error_since(diagnostics, 0)
    // A body that reads a constant not staged yet is checked again once that
    // constant lands; what this check reports past the unstaged read (a name
    // bound from its value, an obligation its callees' rows would settle) is
    // a consequence of the wait, never a finding.
    if waiting.len() > 0 -> diagnostics = [Diagnostic]{}
    reachable := sema_comptime_environment_reachable_function_keys(environment, program, call_facts)
    if checked.value == .Val(body) {
        if program.registration_graph == .Val(resolved_graph) -> sema_comptime_drop_close_keys(resolved_graph, body.tree, module_identity, reachable)
    }
    SemaComptimeFunctionResult{
        module_identity: module_identity,
        function_key: function_key,
        function: checked.value.move(),
        waiting_dependencies: waiting,
        calls: calls,
        reachable_function_keys: reachable,
        call_facts: call_facts,
        hardware_use: sema_hardware_use_snapshot(checked.hardware_use),
        name_references: name_references,
        comptime_body_sources: checked.comptime_body_sources.move(),
        compute_facts: checked.compute_facts,
        exact_int_reachable: checked.exact_int_reachable,
        copy_events: checked.copy_events.move(),
        diagnostics: diagnostics,
        complete: complete,
        incomplete_reasons: incomplete_reasons,
        failure: checked.failure,
        obligations_pending: settled && !complete && !sema_check_function_failed(diagnostics, 0, true),
    }
}

// Read-only graph reads of a comptime function check: the environment is
// borrowed, so reading its registration graph never copies the graph (a
// writable parameter would). None when the environment carries no graph.
sema_comptime_environment_dependencies: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, references: [SemaNameReferenceFact], values: [SemaComptimeItemValue]) -> [String]? {
    if program.registration_graph == .Val(resolved_graph) {
        return Val(sema_comptime_dependencies_from_references(resolved_graph, references, values))
    }
    None
}

sema_comptime_environment_reachable_function_keys: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, call_facts: [SemaCallSiteFact]) -> [String] {
    if program.registration_graph == .Val(resolved_graph) {
        return sema_comptime_reachable_function_keys(resolved_graph, call_facts)
    }
    [String]{}
}

// The module's reasons for one incomplete function: the causes its check
// recorded, or the bare fact when it recorded none (a diagnostic explains it).
sema_check_push_function_reasons: fn(label: String, incomplete_reasons: [String], reasons: &[String]) Never! {
    if incomplete_reasons.len() == 0 {
        reasons.push("{label}: body checking is incomplete")
        return
    }
    loop reason in incomplete_reasons -> reasons.push("{label}: {reason}")
}

// JET_KEEP_GOING (SemaRegistrationGraph.keep_going): the typed trap that
// stands in for a function whose check failed. It is `func` checked again
// with its body replaced by one `todo` (a Never value of the return type that
// lowers to an unreachable stop) and its contracts dropped, so its signature,
// owner and generic parameters are the declared ones. The trap's own reports
// are discarded: the real check's reports and reasons already name the
// failure. None when even the signature does not check.
sema_keep_going_stub: fn(func: Func, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: &SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, host_hooks: SemaHostHookAccess?) -> SemaFunctionResult? {
    stub := func
    stub.pre = [ContractClause]{}
    stub.post = [ContractClause]{}
    stub.body = [Stmt]{Stmt.Expr{expr: Expr.Todo{span: func.span, expected_type: None, id: AST_NODE_GENERATED}}}
    stub.return_type_span = sema_keep_going_trap_return_span(func)
    discarded_diagnostics := [Diagnostic]{}
    discarded_call_facts := [SemaCallSiteFact]{}
    discarded_comptime_requests := [SemaComptimeRequest]{}
    discarded_name_references := [SemaNameReferenceFact]{}
    checked := sema_function_check(stub, owner_id, function_kind, raw_protocol_return, environment, program, scopes, host_hooks, discarded_diagnostics, discarded_call_facts, discarded_comptime_requests, discarded_name_references)
    if !checked.complete || checked.value == None -> return None
    Val(checked)
}

// This rule reads a function with no written return type as losing the value
// of its last line (E0433). A trap's `todo` is a stop, never a value handed
// to nobody, so the trap's placeholder return position counts as written.
sema_keep_going_trap_return_span: fn(func: Func) -> Span? Never! {
    if func.return_type_span == None -> Val(func.span) else -> func.return_type_span
}

// Appends a keep-going trap with its one census row (#5566, #5662): the
// module is incomplete and one reason names the trapped function and why its
// check failed, so a compiler that lowers a trap never looks clean to the
// keep-going report, even when the failure was a post-solve recheck whose
// reports are settled away. A trap that could not be built or recorded is
// that row's outcome instead.
sema_keep_going_push_stub: fn(stub: &&SemaFunctionResult?, label: String, cause: String, functions: &[FnBody], reasons: &[String]) Never! {
    checked := stub.move() ?? {
        reasons.push("{label}: its keep-going trap did not check (the declared signature fails): {cause}")
        return
    }
    if !sema_append_function(functions, checked.value.move()) {
        reasons.push("{label}: its keep-going trap could not be recorded: {cause}")
        return
    }
    reasons.push("{label}: lowered as a keep-going trap: {cause}")
}

// Why a trapped function's check failed: the causes it recorded, else the
// error reports it made since `start`.
sema_keep_going_cause: fn(causes: [String], diagnostics: [Diagnostic], start: Int) -> String Never! {
    if causes.len() > 0 -> return causes.join("; ")
    reported := [String]{}
    loop index in start..<diagnostics.len() {
        if diagnostics[index].severity == DIAGNOSTIC_ERROR -> reported.push("{diagnostics[index].code} {diagnostics[index].what}")
    }
    if reported.len() == 0 -> "body checking is incomplete" else -> "body checking stopped on {reported.join("; ")}"
}

// Preparation is identical on the calling thread and a body-job thread.
// The packet retains existing scalar positions; no declaration borrow escapes.
SemaMethodInput: struct {
    job: SemaBodyJob
    memory_position: Int?
    diagnostics: [Diagnostic]
    generic_params: [TGenericParam]
    normalized_owner_type: Type
    function_kind: TFuncKind
    memory_found: Bool
    memory_complete: Bool
    owner_generic_complete: Bool
}

sema_check_method_input_row: fn(module_identity: String, job: SemaBodyJob, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, registered: SemaRegistrationFunction, owner_type: Type, trait_symbol: Symbol?, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaMethodInput {
    diagnostics := [Diagnostic]{}
    memory_complete := false
    if memory_position == .Val(position) {
        loop diagnostic in memory_plan.functions[position].diagnostics -> diagnostics.push(diagnostic.copy())
        memory_complete = memory_plan.functions[position].complete
    }
    method_generic_params := environment.generic_params.copy()
    owner_generic_complete := true
    normalized_owner_type := owner_type
    normalized: sema_comptime_normalize_owner(environment, program, owner_type, module_identity)
    if normalized == {
        .Val(owner) -> {
            normalized_owner_type = owner
            method_generic_params = sema_comptime_owner_generic_params(environment, program, normalized_owner_type, module_identity, diagnostics, owner_generic_complete)
        }
        .None -> {
            if owner_type == {
                .Apply(_, _) -> owner_generic_complete = false
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> {}
            }
        }
    }
    if registered.impl_conditions.len() > 0 && program.registration_graph == .Val(graph) -> sema_check_method_impl_conditions(graph, module_identity, registered, method_generic_params, diagnostics)
    function_kind: sema_check_method_input_kind(memory_plan, memory_position, registered.declaration, normalized_owner_type, trait_symbol)
    SemaMethodInput{job: job, memory_position: memory_position, diagnostics: diagnostics.move(), generic_params: method_generic_params.move(), normalized_owner_type: normalized_owner_type.move(), function_kind: function_kind.move(), memory_found: memory_position != None, memory_complete: memory_complete, owner_generic_complete: owner_generic_complete}
}

// A conditional impl's method (`impl Pair<T: Priced>.Describe`) sees its
// owner's parameters with the impl's bounds too: in `describe`, `T` is
// `Priced`. A bound that names no trait is E0301, as on a declaration.
sema_check_method_impl_conditions: fn(graph: SemaRegistrationGraph, module_identity: String, registered: SemaRegistrationFunction, params: &[TGenericParam], diagnostics: &[Diagnostic]) Never! {
    loop condition in registered.impl_conditions {
        loop index in 0..<params.len() {
            if params[index].name != condition.name -> next
            loop bound in condition.bounds {
                symbol: sema_type_graph_bound_symbol(graph, module_identity, bound) ?? next
                if sema_resolved_kind(graph, symbol) != SymbolKind.Trait {
                    diagnostics.push(sema_error("E0301", condition.name_span, "the generic bound `{bound}` is not a trait", "generic bounds refer to trait contracts", "use a trait name as the generic bound"))
                    next
                }
                id: sema_resolved_id(graph, symbol)
                known: loop existing in params[index].bounds {
                    if existing.key == id.key -> break true
                } ?? false
                if !known -> params[index].bounds.push(id)
            }
        }
    }
}

// Select before computing the kind: a rewritten function does not also pay
// for a discarded kind computation on the original declaration.
sema_check_method_input_kind: fn(memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, declaration: Func, owner_type: Type, trait_symbol: Symbol?) -> TFuncKind {
    if memory_position == .Val(position) {
        if memory_plan.functions[position].function == .Val(planned) -> return sema_comptime_method_kind(planned, owner_type, trait_symbol)
    }
    sema_comptime_method_kind(declaration, owner_type, trait_symbol)
}

sema_check_method_input: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaMethodInput {
    if program.registration_graph == .Val(graph) {
        if job == {
            .NominalMethod(_, owner, row) -> { return sema_check_method_input_row(graph.modules[module_index].module_identity, job, memory_plan, memory_position, graph.modules[module_index].nominals[owner].methods[row], graph.modules[module_index].nominals[owner].ty, None, environment, program) }
            .ImplMethod(_, owner, row) -> { return sema_check_method_input_row(graph.modules[module_index].module_identity, job, memory_plan, memory_position, graph.modules[module_index].impls[owner].methods[row], graph.modules[module_index].impls[owner].target_type, graph.modules[module_index].impls[owner].trait_symbol, environment, program) }
            .TopLevel(_) -> panic("a top-level function reached method preparation")
        }
    }
    panic("a registered Jet method lost its owning graph")
}

// Existing scalar body descriptors survive preparation writes; declarations do
// not escape their read-only thunks. Serial callers construct these descriptors
// for every body, not only the subset admitted to compiler-thread workers.
sema_function_check_registered: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: &SemaScopeEnvironment, program: SemaProgramTables, module_scopes: &SemaScopeTable, host_hooks: SemaHostHookAccess?, diagnostics: &[Diagnostic], call_facts: &[SemaCallSiteFact], comptime_requests: &[SemaComptimeRequest], name_references: &[SemaNameReferenceFact]) -> SemaFunctionResult {
    if sema_function_check_registered_unregistered(job, module_index, memory_plan, memory_position, owner_id, function_kind, environment, program, module_scopes) == .Val(unavailable) -> return unavailable
    base_generic_params: environment.generic_params.copy()
    generics := sema_function_check_registered_generics(job, module_index, memory_plan, memory_position, environment, program)
    environment.generic_params = generics.merged.copy()
    sema_function_check_registered_name(job, module_index, memory_plan, memory_position, environment, program)
    checked := sema_function_check_registered_passes(job, module_index, memory_plan, memory_position, owner_id, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
    environment.generic_params = base_generic_params.move()
    checked
}

sema_function_check_registered_unregistered: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, owner_id: SymbolID, function_kind: TFuncKind, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> SemaFunctionResult? {
    if memory_position == .Val(position) {
        if memory_plan.functions[position].function == .Val(planned) {
            return sema_function_check_unregistered(planned, owner_id, function_kind, scopes)
        }
    }
    if program.registration_graph == .Val(graph) -> return sema_function_check_unregistered_in_graph(graph, job, module_index, owner_id, function_kind, scopes)
    panic("a registered Jet body check lost its owning graph")
}

// The graph is a read parameter here: a declaration reached through the
// optional-payload binding of the caller was copied natively, a read
// parameter's place is borrowed (as in the helpers below).
sema_function_check_unregistered_in_graph: fn(graph: SemaRegistrationGraph, job: SemaBodyJob, module_index: Int, owner_id: SymbolID, function_kind: TFuncKind, scopes: SemaScopeTable) -> SemaFunctionResult? {
    if job == {
        .TopLevel(item_index) -> {
            if graph.modules[module_index].program.items[item_index] == .Func(func) {
                return sema_function_check_unregistered(func, owner_id, function_kind, scopes)
            }
            panic("a selected source function lost its original item")
        }
        .NominalMethod(_, owner, row) -> return sema_function_check_unregistered(graph.modules[module_index].nominals[owner].methods[row].declaration, owner_id, function_kind, scopes)
        .ImplMethod(_, owner, row) -> return sema_function_check_unregistered(graph.modules[module_index].impls[owner].methods[row].declaration, owner_id, function_kind, scopes)
    }
}

// Keep the actual environment's retained function name, not a context shadow.
// The graph payload window permits only the disjoint context-field write.
sema_function_check_registered_name: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, environment: &SemaScopeEnvironment, program: SemaProgramTables) {
    if memory_position == .Val(position) {
        if memory_plan.functions[position].function == .Val(planned) {
            environment.function_name = planned.name
            return
        }
    }
    if program.registration_graph == .Val(graph) {
        if job == {
            .TopLevel(item_index) -> {
                if graph.modules[module_index].program.items[item_index] == .Func(func) {
                    environment.function_name = func.name
                    return
                }
                panic("a selected source function lost its original item")
            }
            .NominalMethod(_, owner, row) -> environment.function_name = graph.modules[module_index].nominals[owner].methods[row].declaration.name
            .ImplMethod(_, owner, row) -> environment.function_name = graph.modules[module_index].impls[owner].methods[row].declaration.name
        }
        return
    }
    panic("a registered Jet body check lost its owning graph")
}

sema_function_check_registered_passes: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, module_scopes: &SemaScopeTable, generics: SemaFunctionCheckGenerics, host_hooks: SemaHostHookAccess?, diagnostics: &[Diagnostic], call_facts: &[SemaCallSiteFact], comptime_requests: &[SemaComptimeRequest], name_references: &[SemaNameReferenceFact]) -> SemaFunctionResult {
    if memory_position == .Val(position) {
        if memory_plan.functions[position].function == .Val(planned) {
            return sema_function_check_passes(planned, owner_id, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
        }
    }
    if program.registration_graph == .Val(graph) -> return sema_function_check_passes_in_graph(graph, job, module_index, owner_id, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
    panic("a registered Jet body check lost its owning graph")
}

sema_function_check_passes_in_graph: fn(graph: SemaRegistrationGraph, job: SemaBodyJob, module_index: Int, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, module_scopes: &SemaScopeTable, generics: SemaFunctionCheckGenerics, host_hooks: SemaHostHookAccess?, diagnostics: &[Diagnostic], call_facts: &[SemaCallSiteFact], comptime_requests: &[SemaComptimeRequest], name_references: &[SemaNameReferenceFact]) -> SemaFunctionResult {
    if job == {
        .TopLevel(item_index) -> {
            if graph.modules[module_index].program.items[item_index] == .Func(func) {
                return sema_function_check_passes(func, owner_id, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
            }
            panic("a selected source function lost its original item")
        }
        .NominalMethod(_, owner, row) -> { return sema_function_check_passes(graph.modules[module_index].nominals[owner].methods[row].declaration, owner_id, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references) }
        .ImplMethod(_, owner, row) -> { return sema_function_check_passes(graph.modules[module_index].impls[owner].methods[row].declaration, owner_id, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references) }
    }
}

// Read only within this thunk: neither the selected declaration nor the plan's
// rewritten function escapes into an owning Func temporary. Top-level targets
// retain the original source cursor, including duplicate-name/span failures.
sema_function_check_registered_generics: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaFunctionCheckGenerics {
    if memory_position == .Val(position) {
        if memory_plan.functions[position].function == .Val(planned) {
            return sema_function_check_generics(planned, environment, program)
        }
    }
    if program.registration_graph == .Val(graph) -> return sema_function_check_generics_in_graph(graph, job, module_index, environment, program)
    panic("a registered Jet body check lost its owning graph")
}

sema_function_check_generics_in_graph: fn(graph: SemaRegistrationGraph, job: SemaBodyJob, module_index: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaFunctionCheckGenerics {
    if job == {
        .TopLevel(item_index) -> {
            if graph.modules[module_index].program.items[item_index] == .Func(func) {
                return sema_function_check_generics(func, environment, program)
            }
            panic("a selected source function lost its original item")
        }
        .NominalMethod(_, owner, row) -> { return sema_function_check_generics(graph.modules[module_index].nominals[owner].methods[row].declaration, environment, program) }
        .ImplMethod(_, owner, row) -> { return sema_function_check_generics(graph.modules[module_index].impls[owner].methods[row].declaration, environment, program) }
    }
}

// Worker admission remains unchanged. Serial generic functions use the actual
// mutable-environment path; this is only the existing read checker with an
// existing scalar source selector in place of an owning planned Func input.
sema_function_check_registered_shared: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, module_scopes: &SemaScopeTable, host_hooks: SemaHostHookAccess?, diagnostics: &[Diagnostic], call_facts: &[SemaCallSiteFact], comptime_requests: &[SemaComptimeRequest], name_references: &[SemaNameReferenceFact]) -> SemaFunctionResult {
    if sema_function_check_registered_unregistered(job, module_index, memory_plan, memory_position, owner_id, function_kind, environment, program, module_scopes) == .Val(unavailable) -> return unavailable
    generics := sema_function_check_registered_generics(job, module_index, memory_plan, memory_position, environment, program)
    // copy: `previous_location` restores module_scopes.location_function after this function's
    // check overwrites it. Jet has no exchange on a field of the write-borrowed table.
    previous_location: module_scopes.location_function.copy()
    sema_function_check_registered_location(job, module_index, memory_plan, memory_position, environment, program, module_scopes)
    checked := sema_function_check_registered_passes(job, module_index, memory_plan, memory_position, owner_id, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
    module_scopes.location_function = previous_location
    checked
}

sema_function_check_registered_location: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) {
    if memory_position == .Val(position) {
        if memory_plan.functions[position].function == .Val(planned) {
            scopes.location_function = Val(planned.name)
            return
        }
    }
    if program.registration_graph == .Val(graph) {
        scopes.location_function = Val(sema_registered_job_function_name(graph, job, module_index))
        return
    }
    panic("a registered Jet body check lost its owning graph")
}

// The name of the source function a registered body job checks.
sema_registered_job_function_name: fn(graph: SemaRegistrationGraph, job: SemaBodyJob, module_index: Int) -> String Never! {
    if job == {
        .TopLevel(item_index) -> {
            if graph.modules[module_index].program.items[item_index] == .Func(func) -> return func.name
            panic("a selected source function lost its original item")
        }
        .NominalMethod(_, owner, row) -> return graph.modules[module_index].nominals[owner].methods[row].declaration.name
        .ImplMethod(_, owner, row) -> return graph.modules[module_index].impls[owner].methods[row].declaration.name
    }
}

// Return only the existing identity and plan position; never a source Func.
sema_check_registered_function_id: fn(job: SemaBodyJob, module_index: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SymbolID {
    if program.registration_graph == .Val(graph) {
        if job == {
            .TopLevel(item_index) -> {
                if graph.modules[module_index].program.items[item_index] == .Func(func) -> return symbol_id(SymbolKind.Function, graph.modules[module_index].module_identity, "", func.name)
                panic("a selected source function lost its original item")
            }
            .NominalMethod(_, owner, row) -> return graph.modules[module_index].nominals[owner].methods[row].symbol.id
            .ImplMethod(_, owner, row) -> return graph.modules[module_index].impls[owner].methods[row].symbol.id
        }
    }
    panic("a registered Jet body check lost its owning graph")
}

sema_check_registered_memory_position: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Int? {
    if program.registration_graph == .Val(graph) {
        if job == {
            .TopLevel(item_index) -> {
                if graph.modules[module_index].program.items[item_index] == .Func(func) -> return sema_function_memory_position(memory_plan, graph.modules[module_index].module_identity, "", func.name, func.span)
                panic("a selected source function lost its original item")
            }
            .NominalMethod(_, owner, row) -> return sema_function_memory_position(memory_plan, graph.modules[module_index].module_identity, sema_type_graph_base_name(graph.modules[module_index].nominals[owner].ty) ?? "", graph.modules[module_index].nominals[owner].methods[row].declaration.name, graph.modules[module_index].nominals[owner].methods[row].declaration.span)
            .ImplMethod(_, owner, row) -> return sema_function_memory_position(memory_plan, graph.modules[module_index].module_identity, sema_type_graph_base_name(graph.modules[module_index].impls[owner].target_type) ?? "", graph.modules[module_index].impls[owner].methods[row].declaration.name, graph.modules[module_index].impls[owner].methods[row].declaration.span)
        }
    }
    panic("a registered Jet body check lost its owning graph")
}

// The memory plan row of top-level job `job_index`: the one its checking
// thread looked up when that body is the next one `ready` pops, else looked
// up here.
sema_check_ready_memory_position: fn(ready: [SemaPreparedBody], job_index: Int, job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Int? {
    if ready.len() > 0 {
        if ready[ready.len() - 1] == .Checked(body) {
            if body.job_index == job_index && body.memory_known -> return body.memory_position
        }
    }
    sema_check_registered_memory_position(job, module_index, memory_plan, environment, program)
}

sema_check_registered_method_label: fn(job: SemaBodyJob, module_index: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> String {
    if program.registration_graph == .Val(graph) {
        if job == {
            .NominalMethod(_, owner, row) -> return "method `{type_name(graph.modules[module_index].nominals[owner].ty)}.{graph.modules[module_index].nominals[owner].methods[row].symbol.name}`"
            .ImplMethod(_, owner, row) -> return "method `{type_name(graph.modules[module_index].impls[owner].target_type)}.{graph.modules[module_index].impls[owner].methods[row].symbol.name}`"
            .TopLevel(_) -> panic("a top-level function reached method metadata")
        }
    }
    panic("a registered Jet method lost its owning graph")
}

sema_check_registered_raw_protocol_return: fn(job: SemaBodyJob, module_index: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    if program.registration_graph == .Val(graph) {
        if job == {
            .NominalMethod(_, owner, row) -> return graph.modules[module_index].nominals[owner].methods[row].raw_protocol_return
            .ImplMethod(_, owner, row) -> return graph.modules[module_index].impls[owner].methods[row].raw_protocol_return
            .TopLevel(_) -> return false
        }
    }
    panic("a registered Jet body check lost its owning graph")
}

// Rust reference lowering `lower_trait_method`: a `Close` or `Rollback` impl method is a raw
// protocol ABI (`close: fn(self)`), so its lowered return is the declared one
// (Unit when omitted) even though sema checks its body on the failure rail.
sema_check_protocol_unit_trait: fn(trait_name: String?) -> Bool Never! {
    name: trait_name ?? return false
    parts: name.split(".").to_list()
    leaf: parts[parts.len() - 1]
    leaf == "Close" || leaf == "Rollback"
}

sema_check_registered_protocol_unit_return: fn(job: SemaBodyJob, module_index: Int, program: SemaProgramTables) -> Bool {
    if program.registration_graph == .Val(graph) {
        if job == {
            .ImplMethod(_, owner, row) -> {
                if graph.modules[module_index].impls[owner].methods[row].declaration.return_type != None -> return false
                return sema_check_protocol_unit_trait(graph.modules[module_index].impls[owner].declaration.trait_name)
            }
            .NominalMethod(_, owner, row) -> return sema_check_registered_nominal_protocol_unit(graph, module_index, owner, row)
            .TopLevel(_) -> return false
        }
    }
    false
}

// Read through the graph as a read parameter: binding the nominal row copied
// the whole declaration, every method included, once per checked method.
sema_check_registered_nominal_protocol_unit: fn(graph: SemaRegistrationGraph, module_index: Int, owner: Int, row: Int) -> Bool Never! {
    if graph.modules[module_index].nominals[owner].methods[row].declaration.return_type != None -> return false
    method_span: graph.modules[module_index].nominals[owner].methods[row].declaration.span
    if graph.modules[module_index].nominals[owner].source == .SourceAST(item) {
        if item == {
            .Struct(definition) -> return sema_check_protocol_unit_block(definition.trait_impls, method_span)
            .Enum(definition) -> return sema_check_protocol_unit_block(definition.trait_impls, method_span)
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    false
}

// Whether the trait block declaring the method at `span` is a raw Close or
// Rollback protocol.
sema_check_protocol_unit_block: fn(blocks: [TraitImplBlock], span: Span) -> Bool Never! {
    loop block in blocks {
        loop method in block.methods {
            if method.span == span -> return sema_check_protocol_unit_trait(Val(block.trait_name))
        }
    }
    false
}

sema_check_registered_source_span: fn(job: SemaBodyJob, module_index: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Span {
    if program.registration_graph == .Val(graph) {
        if job == {
            .NominalMethod(_, owner, row) -> return graph.modules[module_index].nominals[owner].methods[row].declaration.span
            .ImplMethod(_, owner, row) -> return graph.modules[module_index].impls[owner].methods[row].declaration.span
            .TopLevel(item_index) -> {
                if graph.modules[module_index].program.items[item_index] == .Func(func) -> return func.span
                panic("a selected source function lost its original item")
            }
        }
    }
    panic("a registered Jet body check lost its owning graph")
}

sema_check_registered_original_method_kind: fn(job: SemaBodyJob, module_index: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TFuncKind {
    if program.registration_graph == .Val(graph) {
        if job == {
            .NominalMethod(_, owner, row) -> return sema_comptime_method_kind(graph.modules[module_index].nominals[owner].methods[row].declaration, graph.modules[module_index].nominals[owner].ty, None)
            .ImplMethod(_, owner, row) -> return sema_comptime_method_kind(graph.modules[module_index].impls[owner].methods[row].declaration, graph.modules[module_index].impls[owner].target_type, graph.modules[module_index].impls[owner].trait_symbol)
            .TopLevel(_) -> panic("a top-level function reached method metadata")
        }
    }
    panic("a registered Jet method lost its owning graph")
}

// A keep-going trap owns its replacement AST. Copy the complete signature and
// marker metadata, never the body/contracts that the trap immediately discards.
sema_keep_going_stub_source: fn(func: Func) -> Func {
    Func{
        span: func.span,
        is_pub: func.is_pub,
        is_package_pub: func.is_package_pub,
        is_comptime: func.is_comptime,
        external_type: func.external_type,
        name: func.name,
        name_span: func.name_span,
        meta: func.meta,
        type_params: func.type_params,
        head_pattern: func.head_pattern,
        params: func.params,
        return_type: func.return_type,
        return_type_span: sema_keep_going_trap_return_span(func),
        return_view_provenance: func.return_view_provenance,
        declared_return_view_provenance: func.declared_return_view_provenance,
        gc_return: func.gc_return,
        diverges: func.diverges,
        gc_scope: func.gc_scope,
        is_unsafe: func.is_unsafe,
        unsafe_reason: func.unsafe_reason,
        unsafe_span: func.unsafe_span,
        is_pure: func.is_pure,
        scrub_tag: func.scrub_tag,
        declared_effects: func.declared_effects,
        effect_via: func.effect_via,
        state_requires: func.state_requires,
        state_transition: func.state_transition,
        is_reactive: func.is_reactive,
        reactive_upgrades: func.reactive_upgrades,
        is_replayable: func.is_replayable,
        replayable_span: func.replayable_span,
        is_job: func.is_job,
        job_span: func.job_span,
        job_metadata: func.job_metadata,
        every: func.every,
        is_must_use: func.is_must_use,
        must_use_span: func.must_use_span,
        maturity: func.maturity,
        maturity_span: func.maturity_span,
        kernel: func.kernel,
        is_inline: func.is_inline,
        is_inline_always: func.is_inline_always,
        inline_span: func.inline_span,
        web_marker: func.web_marker,
        pre: [ContractClause]{},
        post: [ContractClause]{},
        inline_foreign: func.inline_foreign,
        undo: func.undo,
        markers: func.markers,
        compiler_generated: func.compiler_generated,
        body: [Stmt]{Stmt.Expr{expr: Expr.Todo{span: func.span, expected_type: None, id: AST_NODE_GENERATED}}},
    }
}

// This owns only the replacement trap AST. Original body/contracts never
// escape a read window or survive preparation of the writable checker.
sema_keep_going_registered_stub_source: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Func {
    if memory_position == .Val(position) {
        if memory_plan.functions[position].function == .Val(planned) -> return sema_keep_going_stub_source(planned)
    }
    if program.registration_graph == .Val(graph) {
        if job == {
            .TopLevel(item_index) -> {
                if graph.modules[module_index].program.items[item_index] == .Func(func) -> return sema_keep_going_stub_source(func)
                panic("a selected source function lost its original item")
            }
            .NominalMethod(_, owner, row) -> return sema_keep_going_stub_source(graph.modules[module_index].nominals[owner].methods[row].declaration)
            .ImplMethod(_, owner, row) -> return sema_keep_going_stub_source(graph.modules[module_index].impls[owner].methods[row].declaration)
        }
    }
    panic("a registered Jet trap lost its owning graph")
}

sema_keep_going_registered_stub: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: &SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, host_hooks: SemaHostHookAccess?) -> SemaFunctionResult? {
    stub := sema_keep_going_registered_stub_source(job, module_index, memory_plan, memory_position, environment, program)
    discarded_diagnostics := [Diagnostic]{}
    discarded_call_facts := [SemaCallSiteFact]{}
    discarded_comptime_requests := [SemaComptimeRequest]{}
    discarded_name_references := [SemaNameReferenceFact]{}
    checked := sema_function_check(stub, owner_id, function_kind, raw_protocol_return, environment, program, scopes, host_hooks, discarded_diagnostics, discarded_call_facts, discarded_comptime_requests, discarded_name_references)
    if !checked.complete || checked.value == None -> return None
    Val(checked)
}

sema_check_registered_method_stub: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: &SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, host_hooks: SemaHostHookAccess?) -> SemaFunctionResult? {
    // copy: `previous_location` restores scopes.location_function after the stub check overwrites
    // it. Jet has no exchange on a field of the write-borrowed table.
    previous_location: scopes.location_function.copy()
    sema_function_check_registered_location(job, module_index, memory_plan, None, environment, program, scopes)
    stub := sema_keep_going_registered_stub(job, module_index, memory_plan, None, owner_id, function_kind, raw_protocol_return, environment, program, scopes, host_hooks)
    scopes.location_function = previous_location
    stub
}

// Registration/header checks borrow the graph inside the existing program tables.
// The result owns precisely the same module metadata as the old checker; no
// registration module or Program temporary escapes this read-only phase.
// A declaration check's error that leaves its declaration well-formed (a
// rule it breaks, such as E0217 guard storage) or drops its fact row (a
// constant without a checked value: a skipped item) keeps the module
// complete, so its bodies are checked and their errors are reported with
// the declaration's (collect-all). So does a member type that names
// nothing: only the bodies that reach its declaration are skipped
// (sema_checked_unusable_bodies).
sema_check_registration_module_start: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, values: [SemaComptimeItemValue], scopes: &SemaScopeTable) -> SemaGraphModuleResult {
    if program.registration_graph == .Val(graph) {
        diagnostics := [Diagnostic]{}
        complete := graph.complete
        incomplete_reasons := [String]{}
        if !graph.complete -> incomplete_reasons.push("registration graph is incomplete")
        if !sema_registration_apply_graph_module(graph, graph.modules[module_index].module_identity, scopes, diagnostics) {
            complete = false
            incomplete_reasons.push("module scope could not be applied")
        }
        declarations := sema_registration_check_declarations_with_values(graph, module_index, diagnostics, values, program.boxed_edges)
        // The module's unknown applied rules (E0927) do not stop its check;
        // they follow its declaration errors, as Rust reports a derive of a
        // tag (E0731) before the unknown rule on the same marker.
        if module_index < graph.unknown_rule_diagnostics.len() -> loop diagnostic in graph.unknown_rule_diagnostics[module_index] -> diagnostics.push(diagnostic.copy())
        return SemaGraphModuleResult{
            package_identity: graph.modules[module_index].package_identity,
            module_path: graph.modules[module_index].module_path,
            source_file: graph.modules[module_index].source_file,
            declarations: declarations.move(),
            module_identity: graph.modules[module_index].module_identity,
            module_name: graph.modules[module_index].module_name,
            functions: [FnBody]{},
            nominals: graph.modules[module_index].nominals,
            nominal_positions: sema_check_nominal_positions(graph.modules[module_index].nominals),
            constants: graph.modules[module_index].constants,
            impls: graph.modules[module_index].impls,
            exports: graph.modules[module_index].exports,
            imports: graph.modules[module_index].imports,
            foreign_providers: [SemaCheckedForeignProvider]{},
            foreign_functions: [SemaCheckedForeignFunction]{},
            call_facts: [SemaCallSiteFact]{},
            hardware_use: sema_hardware_empty_use(),
            name_references: [SemaNameReferenceFact]{},
            comptime_requests: [SemaComptimeRequest]{},
            comptime_body_sources: [SemaComptimeBodySource]{},
            compute_facts: [SemaComputeFunctionFacts]{},
            exact_int_reachable: false,
            copy_events: [SemaCopyEvent]{},
            diagnostics: diagnostics.move(),
            complete: complete,
            failure_facts: [SemaFunctionFailureFacts]{},
            incomplete_reasons: incomplete_reasons.move(),
            injected_function_keys: [String]{},
            tests: [TTestFact]{},
        }
    }
    panic("an owning registered-module pass lost its registration graph")
}

// The body key of module `module_identity`'s top-level function `name`: the
// key its body job and its Core demand row use.
sema_check_top_level_key: fn(module_identity: String, name: String) -> String Never! {
    symbol_id(SymbolKind.Function, module_identity, "", name).key
}

// The body key of the test declared at `span` of module `module_identity`,
// which has no symbol of its own.
sema_check_test_key: fn(module_identity: String, span: Span) -> String Never! {
    "{module_identity}\ntest@{span.start}"
}

// Whether the body under `key` reaches an unusable declaration
// (sema_checked_unusable_bodies).
sema_check_unusable_body: fn(graph: SemaRegistrationGraph, key: String) -> Bool Never! {
    graph.unusable_bodies.len() > 0 && graph.unusable_bodies.get(key) != None
}

// Whether the text of `raw` at `span` names one of `names` as a whole
// identifier (sema_stmt_names_word).
sema_check_span_names_any: fn(raw: [U8], span: Span, names: [String]) -> Bool {
    if span.start < 0 || span.end > raw.len() || span.start >= span.end -> return false
    text: String.from_bytes(raw.slice(span.start, span.end)) ?? return false
    loop name in names {
        if sema_stmt_names_word(text, name) -> return true
    }
    false
}

// The bodies that reach a nominal whose struct field or enum payload type
// names nothing (sema_checked_member_types_name_nothing; E0119 reports at
// the member): the nominal's methods and impl methods, each function, method
// or test whose text names the nominal, and in turn each one whose text
// names such a function. Each would report follow-on errors of the unusable
// member, so these are skipped and recorded
// (sema_check_record_unusable_bodies); every other body is checked
// (collect-all). Core names no user type, so only user modules are read.
sema_checked_unusable_bodies: fn(graph: SemaRegistrationGraph) -> [String:Bool] {
    bodies := [String:Bool]{}
    names := [String]{}
    loop (module_index, module_row) in graph.modules {
        if module_row.module_identity.starts_with("<corelib>") -> next
        loop nominal in module_row.nominals {
            if sema_checked_member_types_name_nothing(graph, module_index, nominal) -> names.push(nominal.symbol.name)
        }
    }
    if names.len() == 0 -> return bodies
    loop module_row in graph.modules {
        if module_row.module_identity.starts_with("<corelib>") -> next
        loop nominal in module_row.nominals {
            if !names.contains(nominal.symbol.name) -> next
            loop method in nominal.methods -> bodies[method.symbol.id.key] = true
        }
        loop implementation in module_row.impls {
            if !names.contains(implementation.target_type_name) -> next
            loop method in implementation.methods -> bodies[method.symbol.id.key] = true
        }
    }
    // A function that reaches them joins `names`, so its callers do too; a
    // method's callers reach it through a value whose type or maker they name.
    grown := true
    loop grown {
        grown = false
        loop module_row in graph.modules {
            if module_row.module_identity.starts_with("<corelib>") -> next
            raw: module_row.source.bytes()
            loop item in module_row.program.items {
                if item == .Func(func) {
                    key: sema_check_top_level_key(module_row.module_identity, func.name)
                    if bodies.get(key) == None && sema_check_span_names_any(raw, func.span, names) {
                        bodies[key] = true
                        names.push(func.name)
                        grown = true
                    }
                }
                if item == .Test(test) {
                    key: sema_check_test_key(module_row.module_identity, test.span)
                    if bodies.get(key) == None && sema_check_span_names_any(raw, test.span, names) -> bodies[key] = true
                }
            }
            loop nominal in module_row.nominals {
                loop method in nominal.methods {
                    if bodies.get(method.symbol.id.key) == None && sema_check_span_names_any(raw, method.declaration.span, names) -> bodies[method.symbol.id.key] = true
                }
            }
            loop implementation in module_row.impls {
                loop method in implementation.methods {
                    if bodies.get(method.symbol.id.key) == None && sema_check_span_names_any(raw, method.declaration.span, names) -> bodies[method.symbol.id.key] = true
                }
            }
        }
    }
    bodies
}

// Records each body of module `module_index` that the check skipped
// (sema_checked_unusable_bodies), which leaves the module incomplete, and
// reports the misspelled signature types (E0119) its function check would
// have reported. A demand wave checks only the bodies it names, so it
// records none.
sema_check_record_unusable_bodies: fn(program: SemaProgramTables, module_index: Int, module_result: &SemaGraphModuleResult) {
    if program.registration_graph == .Val(graph) {
        if graph.unusable_bodies.len() == 0 || graph.core_wave_rows.len() > 0 || graph.derive_wave_rows.len() > 0 || graph.codec_wave_rows.len() > 0 -> return
        module_row: graph.modules[module_index]
        recorded := [String:Bool]{}
        loop item in module_row.program.items {
            if item == .Func(func) {
                key: sema_check_top_level_key(module_row.module_identity, func.name)
                if !sema_check_unusable_body(graph, key) || recorded.get(key) != None -> next
                recorded[key] = true
                sema_type_func_unknown_names(graph, module_index, func, [String]{}, module_result.diagnostics)
                sema_check_record_skipped_body("function `{func.name}`", module_result)
            }
            if item == .Test(test) {
                if !(graph.test_mode || graph.check_tests) || test.name == None || !sema_check_unusable_body(graph, sema_check_test_key(module_row.module_identity, test.span)) -> next
                sema_check_record_skipped_body("test `{test.name ?? ""}`", module_result)
            }
        }
        loop nominal in module_row.nominals {
            owner_names: loop param in nominal.generic_params -> param.name
            loop method in nominal.methods {
                if !sema_check_unusable_body(graph, method.symbol.id.key) || recorded.get(method.symbol.id.key) != None -> next
                recorded[method.symbol.id.key] = true
                if !method.declaration.compiler_generated -> sema_type_func_unknown_names(graph, module_index, method.declaration, owner_names, module_result.diagnostics)
                sema_check_record_skipped_body("method `{nominal.symbol.name}.{method.declaration.name}`", module_result)
            }
        }
        loop implementation in module_row.impls {
            owner_names := [String]{}
            loop nominal in module_row.nominals {
                if nominal.symbol.name == implementation.target_type_name {
                    loop param in nominal.generic_params -> owner_names.push(param.name)
                }
            }
            loop method in implementation.methods {
                if !sema_check_unusable_body(graph, method.symbol.id.key) || recorded.get(method.symbol.id.key) != None -> next
                recorded[method.symbol.id.key] = true
                if !implementation.compiler_generated -> sema_type_func_unknown_names(graph, module_index, method.declaration, owner_names, module_result.diagnostics)
                sema_check_record_skipped_body("method `{implementation.target_type_name}.{method.declaration.name}`", module_result)
            }
        }
        return
    }
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_record_skipped_body: fn(body: String, module_result: &SemaGraphModuleResult) {
    module_result.complete = false
    module_result.incomplete_reasons.push("{body} is skipped: it reaches a declared member type that names nothing")
}

// Module `module_index`'s result after its declaration and program checks:
// `started` when its pass made them ahead (sema_check_declaration_modules),
// else made here into `scopes`. Neither reads the entered module of
// `environment`.
sema_check_registration_module_started: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, values: [SemaComptimeItemValue], started: &&SemaDeclarationCheck?, scopes: &SemaScopeTable, count_work: Bool, items_scanned: &Int) -> SemaGraphModuleResult {
    check := started.move() ?? {
        module_result := sema_check_registration_module_start(environment, program, module_index, values, scopes)
        sema_check_registration_module_program(environment, program, module_index, module_result, count_work, items_scanned)
        return module_result
    }
    if count_work -> items_scanned += check.items_scanned
    check.module_result.move()
}

// The module scope sema_check_registration_module_start applies, for a module
// whose declaration check, made ahead, already holds that application's
// diagnostics.
sema_check_registration_module_scopes: fn(program: SemaProgramTables, module_index: Int, scopes: &SemaScopeTable) {
    if program.registration_graph == .Val(graph) {
        diagnostics := [Diagnostic]{}
        _: sema_registration_apply_graph_module(graph, graph.modules[module_index].module_identity, scopes, diagnostics)
        return
    }
    panic("an owning registered-module pass lost its registration graph")
}

// Retarget the actual module environment after declaration checking and
// before this ordinary program/header phase, exactly as in the old checker.
sema_check_registration_module_program: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, module_result: &SemaGraphModuleResult, count_work: Bool, items_scanned: &Int) {
    if program.registration_graph == .Val(graph) {
        test_names := [String:Bool]{}
        unsupported_forms := sema_check_unsupported_program_forms(graph.modules[module_index].program)
        if unsupported_forms.len() > 0 {
            module_result.complete = false
            loop form in unsupported_forms -> module_result.incomplete_reasons.push("unsupported program form `{form}`")
        }
        job_diagnostics := sema_check_job_names(graph.modules[module_index].program.items)
        loop diagnostic in sema_check_job_schedules(graph.modules[module_index].program.items, environment, program) -> job_diagnostics.push(diagnostic)
        if job_diagnostics.len() > 0 {
            loop diagnostic in job_diagnostics -> module_result.diagnostics.push(diagnostic)
            module_result.complete = false
            module_result.incomplete_reasons.push("invalid job names")
        }
        // `check`: structural `.member { … }` checks in every mode.
        loop diagnostic in sema_scope_members_check(graph.modules[module_index].program.items) -> module_result.diagnostics.push(diagnostic)
        // `infer_module_footprints`: a stated receiver footprint names stored
        // fields and covers its body (E0231).
        loop diagnostic in sema_footprint_check(graph.modules[module_index].program.items) -> module_result.diagnostics.push(diagnostic)
        // Typestate declarations are bundle-wide; collect that view only for
        // a module that declares a state section or a typestate marker.
        if sema_state_items_use_typestate(graph.modules[module_index].program.items) {
            bundle_items := [Item]{}
            loop registered_module_index in 0..<graph.modules.len() {
                loop item_index in 0..<graph.modules[registered_module_index].program.items.len() -> bundle_items.push(graph.modules[registered_module_index].program.items[item_index])
            }
            loop diagnostic in sema_state_validate_declarations(graph.modules[module_index].program.items, bundle_items) -> module_result.diagnostics.push(diagnostic)
        }
        item_index := 0
        loop item_index < graph.modules[module_index].program.items.len() {
            if count_work -> items_scanned += 1
            if graph.modules[module_index].program.items[item_index] == {
                .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .Trait(_) | .Tag(_) | .Const(_) | .UnitFamily(_) | .Impl(_) | .EffectDecl(_) -> {}
                .ExternRust(_) | .CModule(_) | .MarkerDecl(_) -> {}
                // A protocol is expanded into its handle types and transition
                // methods before registration (sema_protocols_expand); the
                // declaration itself has no checked body.
                .ProtocolDecl(_) -> {}
                // `Item::Module(_) => {}`: a role module (`env.*`, `perf.*`,
                // `dev`, `workspace`) carries no checked body; its
                // contributions are validated by their own passes.
                .Module(_) -> {}
                // A `migration` block has no checked body of its own: the
                // derived decode of its published-schema struct replays it
                // (Registration/SerdeItems.jet).
                .Migration(_) -> {}
                // A #Test name is a label string, not an item name: it shares
                // no namespace with functions or types (#6288), only with the
                // module's other test names.
                .Test(test) -> {
                    if test.name == .Val(test_name) {
                        if test_names.get(test_name) != None {
                            module_result.diagnostics.push(sema_defined_twice(test_name, "every test needs a unique name so failures are easy to find", test.name_span))
                        } else {
                            test_names[test_name] = true
                        }
                    }
                }
                .CodeModule(definition) -> {
                    if definition.body != None && !sema_inline_module_lowered(definition) {
                        module_result.complete = false
                        module_result.incomplete_reasons.push("inline module `{definition.name}` is not lowered")
                    }
                }
                // A `fact` declaration has no checked body: its rows are
                // compile-time-only and lowering erases them. One fact identity
                // names one declaration in the loaded bundle.
                .FactDecl(definition) -> {
                    identity: sema_fact_identity(definition)
                    if sema_fact_first_declaration(graph, module_index, item_index, identity) == .Val(first) {
                        diagnostic := sema_error("E0105", definition.name_span, "fact `{identity}` is declared twice (spans {first.span.start}..{first.span.end} and {definition.name_span.start}..{definition.name_span.end})", "one fact name must resolve to one declaration in the loaded bundle", "rename or remove one of the fact declarations")
                        diagnostic.detail = Val("first declaration `{first.name}`: module {first.module_index}, span {first.span.start}..{first.span.end}\nsecond declaration `{definition.name}`: module {module_index}, span {definition.name_span.start}..{definition.name_span.end}")
                        module_result.diagnostics.push(diagnostic)
                    }
                }
                .ErrorConv(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) -> {
                    module_result.complete = false
                    label := sema_check_item_kind_label(graph.modules[module_index].program.items[item_index])
                    module_result.incomplete_reasons.push("unsupported top-level item kind `{label}` (item {item_index})")
                }
            }
            item_index += 1
        }
        return
    }
    panic("an owning registered-module pass lost its registration graph")
}

// `fact_identity`: `name` when it is a plain string, otherwise the
// declaration's source name.
sema_fact_identity: fn(definition: FactDecl) -> String {
    loop parameter in definition.params {
        if parameter.name != "name" -> next
        value: parameter.value ?? break
        if value == .Str(parts, _, _) {
            identity := ""
            loop part in parts {
                if part == .Lit(text) -> identity = "{identity}{text}" else -> return definition.name.copy()
            }
            return identity
        }
        break
    }
    definition.name.copy()
}

SemaFactFirstDeclaration: struct {
    module_index: Int
    span: Span
    name: String
}

// The bundle's earlier declaration of fact `identity`, in module order and
// then source order, before item `item_index` of module `module_index`.
sema_fact_first_declaration: fn(graph: SemaRegistrationGraph, module_index: Int, item_index: Int, identity: String) -> SemaFactFirstDeclaration? {
    loop earlier_module in 0..module_index {
        end: if earlier_module == module_index -> item_index else -> graph.modules[earlier_module].program.items.len()
        loop earlier_item in 0..<end {
            if graph.modules[earlier_module].program.items[earlier_item] == .FactDecl(other) && sema_fact_identity(other) == identity -> return Val(SemaFactFirstDeclaration{module_index: earlier_module, span: other.name_span, name: other.name.copy()})
        }
    }
    None
}

// Finish only after the original ordered body/method/conversion phase. The
// retained graph is borrowed here; the checked module owns the foreign output.
sema_check_registration_module_foreign: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, module_result: &SemaGraphModuleResult) {
    if program.registration_graph == .Val(graph) {
        foreign_diagnostic_count := module_result.diagnostics.len()
        foreign_provider_inputs := [SemaForeignProviderInput]{}
        has_foreign_import_target := false
        loop edge_index in 0..<graph.edges.len() {
            if graph.edges[edge_index].target_module_identity == graph.modules[module_index].module_identity && graph.edges[edge_index].foreign_binding != None {
                has_foreign_import_target = true
                break
            }
        }
        if has_foreign_import_target {
            loop provider_index in 0..<graph.foreign_providers.len() {
                if graph.foreign_providers[provider_index].module_identity == graph.modules[module_index].module_identity -> foreign_provider_inputs.push(graph.foreign_providers[provider_index])
            }
        }
        foreign_providers := sema_checked_foreign_providers(foreign_provider_inputs, module_result.diagnostics)
        provider_index := 0
        loop provider_index < foreign_providers.len() {
            handle_index := 0
            loop handle_index < foreign_providers[provider_index].handles.len() {
                adapter_key := sema_check_foreign_handle_adapter_key(graph.modules[module_index], foreign_providers[provider_index], foreign_providers[provider_index].handles[handle_index])
                if {
                    adapter_key != None -> {
                        foreign_providers[provider_index].handles[handle_index].close_function_key = adapter_key
                        foreign_providers[provider_index].handles[handle_index].close_foreign_key = None
                    }
                    foreign_providers[provider_index].handles[handle_index].close_foreign_key == None -> {
                        foreign_providers[provider_index].handles[handle_index].close_foreign_key = sema_check_registered_foreign_key(graph.modules[module_index], foreign_providers[provider_index].handles[handle_index].close)
                    }
                }
                handle_index += 1
            }
            provider_index += 1
        }
        foreign_functions := sema_checked_foreign_functions(graph, graph.modules[module_index], foreign_providers, module_result.diagnostics)
        if module_result.diagnostics.len() > foreign_diagnostic_count {
            module_result.complete = false
            module_result.incomplete_reasons.push("foreign provider/function checking reported diagnostics")
        }
        module_result.foreign_providers = foreign_providers.move()
        module_result.foreign_functions = foreign_functions.move()
        sema_attach_diagnostic_source_locations(module_result.diagnostics, 0, graph.modules[module_index].source_segments)
        return
    }
    panic("an owning registered-module pass lost its registration graph")
}

// Tests stay synthetic owned AST inputs to the existing checker, never a fake
// registration index. Their property diagnostics precede their body reports.
// A test that reaches an unusable declaration (sema_checked_unusable_bodies)
// is not checked.
sema_check_registration_module_test: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, item_index: Int, scopes: SemaScopeTable, host_hooks: SemaHostHookAccess?, module_result: &SemaGraphModuleResult) {
    if program.registration_graph == .Val(graph) {
        if graph.modules[module_index].program.items[item_index] == .Test(test) {
            if (graph.test_mode || graph.check_tests) && test.name != None && !sema_check_unusable_body(graph, sema_check_test_key(graph.modules[module_index].module_identity, test.span)) {
                loop diagnostic in sema_property_param_diagnostics(test) -> module_result.diagnostics.push(diagnostic)
                checked_test: sema_check_test_function(test, environment, program, scopes, host_hooks)
                loop diagnostic in checked_test.diagnostics -> module_result.diagnostics.push(diagnostic)
                if !graph.test_mode -> return
                loop fact in checked_test.call_facts -> module_result.call_facts.push(fact)
                loop request in checked_test.comptime_requests -> module_result.comptime_requests.push(request)
                loop reference in checked_test.name_references -> module_result.name_references.push(reference)
                loop event in checked_test.copy_events -> module_result.copy_events.push(event)
                module_result.exact_int_reachable = module_result.exact_int_reachable || checked_test.exact_int_reachable
                loop source in checked_test.comptime_body_sources -> module_result.comptime_body_sources.push(source)
                if !checked_test.complete {
                    module_result.complete = false
                    if checked_test.incomplete_reasons.len() == 0 -> module_result.incomplete_reasons.push("test `{test.name ?? ""}`: body check is incomplete")
                    loop reason in checked_test.incomplete_reasons -> module_result.incomplete_reasons.push("test `{test.name ?? ""}`: {reason}")
                }
                if checked_test.function == .Val(function) {
                    module_result.injected_function_keys.push(function.key)
                    module_result.functions.push(function)
                    module_result.tests.push(checked_test_artifact_fact(environment.module_identity, test, graph.modules[module_index].source))
                }
            }
        }
        return
    }
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_registered_module_identity: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int) -> String {
    if program.registration_graph == .Val(graph) -> return graph.modules[module_index].module_identity
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_registered_keep_going: fn(environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    if program.registration_graph == .Val(graph) -> return graph.keep_going
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_registered_item_is_jet_function: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, item_index: Int) -> Bool {
    if program.registration_graph == .Val(graph) {
        // `check_fn`: an `#FFI` tier body is foreign source and a per-callable
        // `#Import(c)` has no Jet body (its C signature is checked by
        // sema_guest_check_surfaces); neither is checked as an empty value body.
        // Both stay registered. A body that reaches an unusable declaration
        // (sema_checked_unusable_bodies) is not checked either.
        if graph.modules[module_index].program.items[item_index] == .Func(func) -> return func.inline_foreign == None && !sema_function_is_guest_import(func) && !sema_check_unusable_body(graph, sema_check_top_level_key(graph.modules[module_index].module_identity, func.name))
        return false
    }
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_registered_method_jobs: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, impl_rows_scanned: &Int, count_work: Bool) -> [SemaBodyJob] {
    if program.registration_graph == .Val(graph) -> return sema_check_method_jobs(graph, graph.modules[module_index], impl_rows_scanned, count_work)
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_registered_parallel_method_jobs: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, memory_plan: SemaFunctionMemoryPlan, all_method_jobs: [SemaBodyJob], comptime_rows: [String:Int], weights: &[Int]) -> [SemaBodyJob] {
    if program.registration_graph == .Val(graph) -> return sema_check_parallel_method_jobs(graph, graph.modules[module_index], memory_plan, environment.generic_params, all_method_jobs, comptime_rows, weights)
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_registered_top_level_name: fn(module_index: Int, item_index: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> String {
    if program.registration_graph == .Val(graph) {
        if graph.modules[module_index].program.items[item_index] == .Func(func) -> return func.name
    }
    panic("a selected source function lost its original item")
}

// The caller selects ordinary Jet functions in source order. All graph and
// plan metadata reads finish before a writable checker or trap is entered.
sema_check_registration_top_level: fn(module_index: Int, item_index: Int, memory_plan: SemaFunctionMemoryPlan, environment: &SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, return_view_rows: &[String:Int], ready: &[SemaPreparedBody], queries: &[Int:SemaBodyMemoQuery], memo: &SemaModuleMemo?, host_hooks: SemaHostHookAccess?, comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], result: &SemaGraphModuleResult, prelude_demands: &[Int:[SemaPreludeConversionDemand]], scopes_changed: &Bool, keep_going: Bool, pending_obligations: Bool, trace_functions: Bool, trace_sink: CompilerTraceSink?, item_count: Int, count_work: Bool, functions_checked: &Int) {
    job: SemaBodyJob.TopLevel{item_index: item_index}
    function_name: sema_check_registered_top_level_name(module_index, item_index, environment, program)
    owner_id: sema_check_registered_function_id(job, module_index, environment, program)
    cached := sema_comptime_find_checked_function(comptime_functions, comptime_rows, environment.module_identity, owner_id.key)
    if cached == {
        .Val(checked_function) -> {
            if checked_function.function == .Val(function) {
                if sema_function_publish_return_views(scopes, return_view_rows, function) {
                    scopes_changed = true
                    sema_incremental_publication(memo)
                }
            }
            result.exact_int_reachable = result.exact_int_reachable || checked_function.exact_int_reachable
            sema_hardware_use_merge(result.hardware_use, sema_hardware_use_snapshot(checked_function.hardware_use))
            loop event in checked_function.copy_events -> result.copy_events.push(event)
            if !sema_comptime_append_checked_function(checked_function, result.functions, result.call_facts, result.comptime_requests, result.name_references) {
                result.complete = false
                if keep_going {
                    sema_keep_going_push_stub(sema_keep_going_registered_stub(job, module_index, memory_plan, None, owner_id, TFuncKind.TopLevel, false, environment, program, scopes, host_hooks), "function `{function_name}`", "comptime-checked body is incomplete", result.functions, result.incomplete_reasons)
                } else {
                    result.incomplete_reasons.push("function `{function_name}`: comptime-checked body is incomplete")
                }
            }
            loop source in checked_function.comptime_body_sources -> result.comptime_body_sources.push(source)
            result.compute_facts.push(checked_function.compute_facts)
            // #3708: the reused body joins the bundle solve like one checked
            // here: its failure row, and the obligations the solve settles.
            if checked_function.failure == .Val(facts) -> result.failure_facts.push(facts)
            sema_comptime_push_obligations(checked_function, result.diagnostics)
        }
        .None -> {
            function_call_facts := [SemaCallSiteFact]{}
            function_comptime_requests := [SemaComptimeRequest]{}
            function_name_references := [SemaNameReferenceFact]{}
            function_diagnostic_start: result.diagnostics.len()
            memory_position: sema_check_ready_memory_position(ready, item_index, job, module_index, memory_plan, environment, program)
            if memory_position == {
                .Val(position) -> {
                    loop diagnostic in memory_plan.functions[position].diagnostics -> result.diagnostics.push(diagnostic.copy())
                    if !memory_plan.functions[position].complete {
                        result.complete = false
                        result.incomplete_reasons.push("function `{function_name}`: memory plan is incomplete")
                    }
                }
                .None -> {
                    result.complete = false
                    result.incomplete_reasons.push("function `{function_name}`: no memory plan row")
                }
            }
            if trace_functions {
                if trace_sink == .Val(sink) -> sink.begin("sema.function", function_name, item_index, item_count)
            }
            checked: sema_check_module_function(ready, queries, memo, item_index, scopes_changed, job, module_index, memory_plan, memory_position, owner_id, TFuncKind.TopLevel, false, environment, program, scopes, host_hooks, result.diagnostics, function_call_facts, function_comptime_requests, function_name_references, count_work, functions_checked)
            if trace_functions {
                if trace_sink == .Val(sink) -> sink.end("sema.function", 1)
            }
            sema_hardware_use_merge(result.hardware_use, sema_hardware_use_snapshot(checked.hardware_use))
            result.comptime_body_sources.extend(checked.comptime_body_sources.move())
            result.compute_facts.push(checked.compute_facts)
            if checked.failure == .Val(facts) -> result.failure_facts.push(facts.copy())
            if checked.value == .Val(function) {
                if sema_function_publish_return_views(scopes, return_view_rows, function) {
                    scopes_changed = true
                    sema_incremental_publication(memo)
                }
            }
            result.exact_int_reachable = result.exact_int_reachable || checked.exact_int_reachable
            result.copy_events.extend(checked.copy_events.move())
            result.call_facts.extend(function_call_facts)
            result.comptime_requests.extend(function_comptime_requests)
            result.name_references.extend(function_name_references)
            if !checked.complete {
                result.complete = false
                if keep_going {
                    cause: sema_keep_going_cause(checked.incomplete_reasons, result.diagnostics, function_diagnostic_start)
                    sema_keep_going_push_stub(sema_keep_going_registered_stub(job, module_index, memory_plan, memory_position, owner_id, TFuncKind.TopLevel, false, environment, program, scopes, host_hooks), "function `{function_name}`", cause, result.functions, result.incomplete_reasons)
                } else {
                    sema_check_push_function_reasons("function `{function_name}`", checked.incomplete_reasons, result.incomplete_reasons)
                }
            } else if keep_going && sema_check_function_failed(result.diagnostics, function_diagnostic_start, pending_obligations) {
                cause: sema_keep_going_cause([String]{}, result.diagnostics, function_diagnostic_start)
                sema_keep_going_push_stub(sema_keep_going_registered_stub(job, module_index, memory_plan, memory_position, owner_id, TFuncKind.TopLevel, false, environment, program, scopes, host_hooks), "function `{function_name}`", cause, result.functions, result.incomplete_reasons)
                result.complete = false
            } else {
                position: result.functions.len()
                if sema_append_function(result.functions, checked.value.move()) {
                    if checked.prelude_demands == .Val(demands) -> prelude_demands[position] = demands
                } else {
                    result.complete = false
                    result.incomplete_reasons.push("function `{function_name}`: checked function could not be recorded")
                }
            }
        }
    }
}

sema_check_registration_method: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, ready: &[SemaPreparedBody], queries: &[Int:SemaBodyMemoQuery], memo: SemaModuleMemo?, ordinal: Int, scopes: &SemaScopeTable, environment: &SemaScopeEnvironment, program: SemaProgramTables, host_hooks: SemaHostHookAccess?, comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], diagnostics: &[Diagnostic], functions: &[FnBody], prelude_demands: &[Int:[SemaPreludeConversionDemand]], call_facts: &[SemaCallSiteFact], hardware_use: &TargetHardwareUse, comptime_requests: &[SemaComptimeRequest], name_references: &[SemaNameReferenceFact], comptime_body_sources: &[SemaComptimeBodySource], compute_facts: &[SemaComputeFunctionFacts], failure_facts: &[SemaFunctionFailureFacts], exact_int_reachable: &Bool, copy_events: &[SemaCopyEvent], reasons: &[String], keep_going: Bool, pending_obligations: Bool) -> Bool {
    label: sema_check_registered_method_label(job, module_index, environment, program)
    owner_id: sema_check_registered_function_id(job, module_index, environment, program)
    raw_protocol_return: sema_check_registered_raw_protocol_return(job, module_index, environment, program)
    cached := sema_comptime_find_checked_function(comptime_functions, comptime_rows, environment.module_identity, owner_id.key)
    if cached == {
        .Val(checked_function) -> {
            exact_int_reachable = exact_int_reachable || checked_function.exact_int_reachable
            sema_hardware_use_merge(hardware_use, sema_hardware_use_snapshot(checked_function.hardware_use))
            loop event in checked_function.copy_events -> copy_events.push(event)
            loop source in checked_function.comptime_body_sources -> comptime_body_sources.push(source)
            compute_facts.push(checked_function.compute_facts)
            // The reused method body joins the bundle failure solve like one
            // checked here, as a reused top-level body does.
            if checked_function.failure == .Val(facts) -> failure_facts.push(facts)
            sema_comptime_push_obligations(checked_function, diagnostics)
            if sema_comptime_append_checked_function(checked_function, functions, call_facts, comptime_requests, name_references) -> return true
            if keep_going {
                original_kind: sema_check_registered_original_method_kind(job, module_index, environment, program)
                sema_keep_going_push_stub(sema_check_registered_method_stub(job, module_index, memory_plan, owner_id, original_kind, raw_protocol_return, environment, program, scopes, host_hooks), label, "comptime-checked body is incomplete", functions, reasons)
            } else {
                reasons.push("{label}: comptime-checked body is incomplete")
            }
            return false
        }
        .None -> {}
    }
    function_diagnostic_start: diagnostics.len()
    query := SemaBodyMemoQuery?{None}
    if memo == .Val(_) {
        query = queries.remove(ordinal)
        if query == None -> query = sema_incremental_registered_body_query(memo, job, module_index, memory_plan, environment, program)
    }
    prepared := sema_incremental_prepared(sema_check_take_body(ready, ordinal), query, ordinal, true)
    prior_reach := SemaBodyCheckReach{host: false, foreign_raw_body: false}
    if prepared == .Val(body) {
        if body.wanted_hooks {
            prior_reach = SemaBodyCheckReach{host: body.host_reached, foreign_raw_body: body.volatile}
            prepared = None
        }
    }
    input := SemaMethodInput?{None}
    checked_result := SemaFunctionResult?{None}
    function_call_facts := [SemaCallSiteFact]{}
    function_comptime_requests := [SemaComptimeRequest]{}
    function_name_references := [SemaNameReferenceFact]{}
    if prepared != None {
        packet := prepared.move() ?? panic("a prepared method packet disappeared")
        prepared = None
        sema_incremental_accept_packet(query, packet)
        taken_input := packet.method_input.move()
        packet.method_input = None
        input = taken_input.move()
        taken_checked := packet.checked.move()
        packet.checked = None
        checked_result = taken_checked.move()
        diagnostics.extend(packet.diagnostics.move())
        function_call_facts = packet.call_facts.move()
        function_comptime_requests = packet.comptime_requests.move()
        function_name_references = packet.name_references.move()
    }
    if input == None {
        memory_position: sema_check_registered_memory_position(job, module_index, memory_plan, environment, program)
        input = Val(sema_check_method_input(job, module_index, memory_plan, memory_position, environment, program))
    }
    owned_input := input.move() ?? panic("a method body has no canonical preparation")
    input = None
    // Prepared diagnostics already include preparation, in the same order.
    if checked_result == None && query == None {
        loop diagnostic in owned_input.diagnostics -> diagnostics.push(diagnostic)
    }
    if !owned_input.memory_found {
        declaration_span: sema_check_registered_source_span(job, module_index, environment, program)
        reasons.push("{label}: the memory plan has no row for its declaration at offset {declaration_span.start}")
    }
    base_generic_params: environment.generic_params.copy()
    environment.generic_params = owned_input.generic_params.copy()
    // copy: `previous_location` restores scopes.location_function after this method's check
    // overwrites it. Jet has no exchange on a field of the write-borrowed table.
    previous_location: scopes.location_function.copy()
    sema_function_check_registered_location(job, module_index, memory_plan, owned_input.memory_position, environment, program, scopes)
    if checked_result == None {
        if query == None {
            checked_result = Val(sema_function_check_registered(job, module_index, memory_plan, owned_input.memory_position, owner_id, owned_input.function_kind, raw_protocol_return, environment, program, scopes, host_hooks, diagnostics, function_call_facts, function_comptime_requests, function_name_references))
        } else {
            query = sema_incremental_retarget(query, memo)
            prefix := owned_input.diagnostics.move()
            owned_input.diagnostics = [Diagnostic]{}
            packet := sema_check_inline_memo_body(ordinal, job, module_index, memory_plan, owned_input.memory_position, owner_id, owned_input.function_kind, raw_protocol_return, environment, program, scopes, host_hooks, prior_reach, prefix)
            packet.method_input = Val(owned_input.move())
            sema_incremental_accept_packet(query, packet)
            restored_input := packet.method_input.move()
            packet.method_input = None
            owned_input = restored_input.move() ?? panic("an accepted method packet lost its planned input")
            function_call_facts = packet.call_facts.move()
            packet.call_facts = [SemaCallSiteFact]{}
            function_comptime_requests = packet.comptime_requests.move()
            packet.comptime_requests = [SemaComptimeRequest]{}
            function_name_references = packet.name_references.move()
            packet.name_references = [SemaNameReferenceFact]{}
            checked_result = Val(sema_check_drain_body(packet, diagnostics, function_call_facts, function_comptime_requests, function_name_references))
        }
    } else {
        sema_function_check_registered_name(job, module_index, memory_plan, owned_input.memory_position, environment, program)
    }
    checked := checked_result.move() ?? panic("a method body has no checked result")
    checked_result = None
    memory_complete: owned_input.memory_complete
    owner_generic_complete: owned_input.owner_generic_complete
    // A failed check under keep-going always lowers as its trap (or records
    // why the trap could not be built), never as the failed body.
    check_failed: keep_going && sema_check_function_failed(diagnostics, function_diagnostic_start, pending_obligations)
    keep_going_stub := SemaFunctionResult?{None}
    if keep_going && (!memory_complete || !owner_generic_complete || !checked.complete || check_failed) {
        keep_going_stub = sema_keep_going_registered_stub(job, module_index, memory_plan, owned_input.memory_position, owner_id, owned_input.function_kind, raw_protocol_return, environment, program, scopes, host_hooks)
    }
    scopes.location_function = previous_location
    environment.generic_params = base_generic_params.move()
    exact_int_reachable = exact_int_reachable || checked.exact_int_reachable
    sema_hardware_use_merge(hardware_use, sema_hardware_use_snapshot(checked.hardware_use))
    copy_events.extend(checked.copy_events.move())
    call_facts.extend(function_call_facts)
    comptime_requests.extend(function_comptime_requests)
    comptime_body_sources.extend(checked.comptime_body_sources.move())
    compute_facts.push(checked.compute_facts)
    // A method's failure row joins the bundle failure solve, which infers
    // the contract of an inherent method as it does a top-level function's.
    if checked.failure == .Val(facts) -> failure_facts.push(facts.copy())
    name_references.extend(function_name_references)
    if !memory_complete || !owner_generic_complete {
        causes := [String]{}
        if !memory_complete && owned_input.memory_found -> causes.push("memory plan is incomplete")
        if !owner_generic_complete -> causes.push("generic owner `{type_name(owned_input.normalized_owner_type)}` could not be resolved to a registered nominal")
        if keep_going {
            sema_keep_going_push_stub(keep_going_stub.move(), label, sema_keep_going_cause(causes, diagnostics, function_diagnostic_start), functions, reasons)
        } else {
            loop cause in causes -> reasons.push("{label}: {cause}")
        }
        return false
    }
    if !checked.complete {
        if keep_going {
            sema_keep_going_push_stub(keep_going_stub.move(), label, sema_keep_going_cause(checked.incomplete_reasons, diagnostics, function_diagnostic_start), functions, reasons)
        } else {
            sema_check_push_function_reasons(label, checked.incomplete_reasons, reasons)
        }
        return false
    }
    if check_failed {
        sema_keep_going_push_stub(keep_going_stub.move(), label, sema_keep_going_cause([String]{}, diagnostics, function_diagnostic_start), functions, reasons)
        return false
    }
    if checked.value != None && sema_check_registered_protocol_unit_return(job, module_index, program) {
        taken := checked.value.move()
        checked.value = None
        rewritten := taken.move() ?? panic("a checked Close method lost its lowered function")
        raw_return: Type.Named{name: "Unit"}
        rewritten.ret = Val(raw_return)
        failure: sema_failure_carrier(Val(raw_return))
        sema_body_fact_return(rewritten.tree, raw_return, failure)
        rewritten.failure_carrier = failure
        checked.value = Val(rewritten.move())
    }
    position: functions.len()
    if sema_append_function(functions, checked.value.move()) {
        if checked.prelude_demands == .Val(demands) -> prelude_demands[position] = demands
        return true
    }
    reasons.push("{label}: checked function could not be recorded")
    false
}
sema_check_registered_tfunc_key: fn(module_row: SemaRegistrationModule, name: String) -> String? {
    loop function_index in 0..<module_row.functions.len() {
        if module_row.functions[function_index].declaration.name == name -> return Val(module_row.functions[function_index].symbol.id.key)
    }
    None
}

sema_check_registered_foreign_key: fn(module_row: SemaRegistrationModule, name: String) -> String? {
    loop function_index in 0..<module_row.foreign_functions.len() {
        if module_row.foreign_functions[function_index].declaration.name == name -> return Val(module_row.foreign_functions[function_index].symbol.id.key)
    }
    None
}

sema_check_foreign_handle_adapter_key: fn(module_row: SemaRegistrationModule, provider: SemaCheckedForeignProvider, handle: SemaCheckedForeignHandle) -> String? {
    loop adapter in provider.close_adapters {
        if adapter.raw_function == handle.close && (adapter.handle_type == handle.typedef_name || adapter.handle_type == handle.jet_name) {
            return sema_check_registered_tfunc_key(module_row, adapter.adapter_function)
        }
    }
    None
}

// The Program-level forms the module checker does not support yet, by name.
// Fenced statements are formatter metadata: sema checks their ordinary
// expanded statements in `items`, as the Rust checker does. A script body is
// not one of them: finalization rejects it with E0620/E0621. `#HTML(page)`
// (html_path) is not one either: it names the web output's companion page,
// which a native build has no use for. Nor is a web ceiling
// (`#Target(Wasm|JS)`): the web partition (WebPartition.jet)
// and the OS-axis check (OSTarget.jet) read it.
sema_check_unsupported_program_forms: fn(program: Program) -> [String] Never! {
    forms := [String]{}
    if sema_function_memory_has_unsupported_policies(program.policy_declarations) -> forms.push("memory policy")
    if sema_policy_has_unsupported_applications(program) -> forms.push("applied rules")
    forms
}

sema_check_item_kind_label: fn(item: Item) -> String Never! {
    if item == {
        .Func(_) -> "fn"
        .Struct(_) -> "struct"
        .Enum(_) -> "enum"
        .Distinct(_) -> "distinct"
        .TypeAlias(_) -> "type alias"
        .UnitFamily(_) -> "unit family"
        .Trait(_) -> "trait"
        .Tag(_) -> "tag"
        .EffectDecl(_) -> "effect"
        .Impl(_) -> "impl"
        .Const(_) -> "const"
        .Test(_) -> "test"
        .ExternRust(_) -> "extern rust"
        .Module(value) -> "{value.name}: module"
        .CModule(_) -> "c module"
        .CodeModule(value) -> "{value.name}: module"
        .ErrorConv(_) -> "error conversion"
        .Migration(_) -> "migration"
        .ProtocolDecl(_) -> "protocol"
        .TemplateLoop(_) -> "template loop"
        .GenericModule(_) -> "generic module"
        .ModuleAlias(_) -> "module alias"
        .MarkerDecl(_) -> "marker"
        .FactDecl(_) -> "fact"
    }
}

// One immutable pass graph is moved into the existing environment owner.
// Compute the borrowed graph facts before the handoff, never from a copied graph.
sema_check_pass_environment: fn(graph: &&SemaRegistrationGraph, checked_types: [TTypeDef], body_values: &&SemaComptimeBodyValues) -> SemaScopeEnvironment Never! {
    fixed_length_write_params := sema_fixed_length_write_params_in_graph(graph)
    tables := sema_program_tables_init(Val(graph.move()), checked_types)
    sema_check_pass_environment_from(tables, fixed_length_write_params, body_values)
}

// The pass environment over `tables`, whose graph `fixed_length_write_params`
// was computed from.
sema_check_pass_environment_from: fn(tables: &&SemaProgramTables, fixed_length_write_params: &&[String], body_values: &&SemaComptimeBodyValues) -> SemaScopeEnvironment Never! {
    environment := sema_scope_environment_init("", "", "", "", SemaSourceOrigin.Snapshot, [SemaSourceSegment]{}, [SemaScopeDeclaration]{})
    environment.registration_graph = tables.registration_graph.move()
    environment.checked_types = tables.checked_types.move()
    environment.checked_type_rows = tables.checked_type_rows.move()
    environment.checked_type_name_slots = tables.checked_type_name_slots.move()
    environment.checked_type_name_rows = tables.checked_type_name_rows.move()
    environment.boxed_edges = tables.boxed_edges.move()
    environment.copy_facts = tables.copy_facts.move()
    // Every module's functions, so the length-preserving
    // fact covers calls into other modules like the Rust bundle-wide fact.
    environment.fixed_length_write_params = fixed_length_write_params.move()
    environment.comptime_body_publication = body_values.move()
    environment.move()
}

// The graph facts a body pass reads besides the graph and checked types. Each
// reads only the graph, so a large program computes them side by side on
// compiler threads (sema_pass_facts). Jobs are numbered lightest first;
// threads claim them heaviest first. The first SEMA_PASS_FACT_TABLES jobs are
// the ones a pass environment needs (the declaration pass's); a body pass
// needs all SEMA_PASS_FACT_JOBS.
SEMA_PASS_FACT_BOXED_EDGES: 0
SEMA_PASS_FACT_COPY: 1
SEMA_PASS_FACT_FIXED_LENGTH: 2
SEMA_PASS_FACT_MEMORY_PLAN: 3
SEMA_PASS_FACT_TABLES: 3
SEMA_PASS_FACT_JOBS: 4

SemaPassFacts: struct {
    memory_plan: SemaFunctionMemoryPlan
    fixed_length_write_params: [String]
    boxed_edges: [String:[String]]
    copy_facts: SemaCopyFactsTable
}

// One computed fact: job `job`'s field of `facts` is filled.
SemaPassFact: struct {
    job: Int
    facts: SemaPassFacts
}

// What every pass-fact thread reads: the graph, the one row of its list.
SemaPassFactsShared: struct {
    graphs: [SemaRegistrationGraph?]
}

sema_pass_facts_new: fn() -> SemaPassFacts Never! {
    SemaPassFacts{memory_plan: sema_function_memory_plan_new(), fixed_length_write_params: [String]{}, boxed_edges: [String:[String]]{}, copy_facts: sema_copy_facts_table_empty()}
}

// Fills the fields of jobs 0..<`jobs` of `facts` from `graph`, on threads
// when the program is large enough, and returns the graph. Each fact is the
// same as computed serially, for any thread count.
sema_pass_facts: fn(graph: &&SemaRegistrationGraph, threads: CompilerThreads, jobs: Int, facts: &SemaPassFacts) -> SemaRegistrationGraph? Never! {
    workers: compiler_threads_admit(threads, jobs, graph.modules.len(), SEMA_FINALIZE_SIDE_MIN_MODULES_PER_THREAD, 0, 0)
    owned := SemaRegistrationGraph?{Val(graph.move())}
    if workers <= 1 {
        loop job in 0..<jobs -> sema_pass_fact_run(job, owned, facts)
        return owned
    }
    shared_state: Shared{SemaPassFactsShared{graphs: [SemaRegistrationGraph?]{}}}
    sema_pass_facts_fill(shared_state, owned)
    queue: Shared{SemaFinalizeCoreQueue{next: 0}}
    sema_pass_facts_claimers(shared_state, queue, jobs, 0, workers, facts)
    sema_pass_facts_take(shared_state)
}

// Computes job `job`'s fact of `graph` into its field of `facts`. The graph
// is read in place through the `.Val(…)` pattern on the parameter.
sema_pass_fact_run: fn(job: Int, graph: SemaRegistrationGraph?, facts: &SemaPassFacts) Never! {
    if graph == .Val(registered) {
        if {
            job == SEMA_PASS_FACT_BOXED_EDGES -> { facts.boxed_edges = sema_checked_program_boxed_edges(registered) }
            job == SEMA_PASS_FACT_COPY -> { facts.copy_facts = sema_copy_facts_table(graph) }
            job == SEMA_PASS_FACT_FIXED_LENGTH -> { facts.fixed_length_write_params = sema_fixed_length_write_params_in_graph(registered) }
            else -> { facts.memory_plan = sema_function_memory_plan_from_graph(registered) }
        }
    }
}

// Moves a thread's computed fact into its field of `facts`.
sema_pass_fact_join: fn(fact: &&SemaPassFact, facts: &SemaPassFacts) Never! {
    owned := fact.move()
    if {
        owned.job == SEMA_PASS_FACT_BOXED_EDGES -> { facts.boxed_edges = owned.facts.boxed_edges.move() }
        owned.job == SEMA_PASS_FACT_COPY -> { facts.copy_facts = owned.facts.copy_facts.move() }
        owned.job == SEMA_PASS_FACT_FIXED_LENGTH -> { facts.fixed_length_write_params = owned.facts.fixed_length_write_params.move() }
        else -> { facts.memory_plan = owned.facts.memory_plan.move() }
    }
}

sema_pass_facts_fill: fn(shared_state: Shared<SemaPassFactsShared>, graph: &&SemaRegistrationGraph?) Never! {
    permit: shared_state.guard_edit()
    permit.value.graphs.push(graph)
}

sema_pass_facts_take: fn(shared_state: Shared<SemaPassFactsShared>) -> SemaRegistrationGraph? Never! {
    permit: shared_state.guard_edit()
    permit.value.graphs.pop() ?? panic("the pass graph left the pass facts' shared state")
}

// Runs pass-fact threads `from..<workers`, one task each, over jobs
// 0..<`jobs`, and joins every fact a thread computed into `facts`.
sema_pass_facts_claimers: fn(shared_state: Shared<SemaPassFactsShared>, queue: Shared<SemaFinalizeCoreQueue>, jobs: Int, from: Int, workers: Int, facts: &SemaPassFacts) Never! {
    if from >= workers -> return
    task.group sema_pass_facts_threads {
        head: task sema_pass_facts_claimed(shared_state, queue, jobs)
        sema_pass_facts_claimers(shared_state, queue, jobs, from + 1, workers, facts)
        claimed := head.join() ?? panic(compiler_threads_failure_text(err))
        loop claimed.len() > 0 {
            done := claimed.pop() ?? break
            sema_pass_fact_join(done, facts)
        }
    }
}

// One thread: computes the facts of jobs 0..<`jobs` it claims, heaviest
// (last job) first.
sema_pass_facts_claimed: fn(shared_state: Shared<SemaPassFactsShared>, queue: Shared<SemaFinalizeCoreQueue>, jobs: Int) -> [SemaPassFact] Never! {
    inputs: shared_state.guard_read()
    claimed := [SemaPassFact]{}
    ranks: queue.guard_read()
    loop {
        rank: sema_finalize_core_claim(ranks.value)
        if rank >= jobs -> break
        job: jobs - 1 - rank
        fact := SemaPassFact{job: job, facts: sema_pass_facts_new()}
        // Passed straight through: a local binding of a guarded row would copy it.
        sema_pass_fact_run(job, inputs.value.graphs[0], fact.facts)
        claimed.push(fact)
    }
    claimed
}

// (Rust `check_module_bodies`): resolve callable view
// summaries before the real body pass so declaration order cannot affect a
// public owner contract. Only functions whose declared return type
// structurally contains a view are summary jobs, checked in name order, then
// the module's methods with such a return type
// (sema_check_view_summary_method_jobs); each
// check discards its diagnostics and other products and publishes only the
// return-view provenance into `scopes`. A round that reproduces the previous
// round's per-job provenance is the fixed point; jobs + 1 rounds is the upper
// bound, and no jobs means no summary checks. `view_jobs`: the jobs a
// declaration check found ahead (SemaDeclarationCheck), else None.
// `summary_functions_checked` counts the function jobs only.
sema_check_view_summaries: fn(environment: &SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, module_index: Int, host_hooks: SemaHostHookAccess?, memory_plan: SemaFunctionMemoryPlan, comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], view_jobs: [Int]?, counter_phase: String, trace_sink: CompilerTraceSink?) {
    summary_jobs: if view_jobs == .Val(found) -> found.copy() else -> sema_check_sorted_view_summary_jobs(environment, program, module_index)
    method_jobs: sema_check_view_summary_method_jobs(program, module_index)
    job_count: summary_jobs.len() + method_jobs.len()
    summary_functions_checked := 0
    return_view_rows := [String:Int]{}
    previous_round := [ViewProvenanceMap?]{}
    summary_round := 0
    loop job_count > 0 && summary_round <= job_count {
        round := [ViewProvenanceMap?]{}
        loop item_index in summary_jobs {
            job: SemaBodyJob.TopLevel{item_index: item_index}
            provenance := ViewProvenanceMap?{None}
            owner_id: sema_check_registered_function_id(job, module_index, environment, program)
            cached := sema_comptime_find_checked_function(comptime_functions, comptime_rows, environment.module_identity, owner_id.key)
            if cached == {
                .Val(checked_function) -> {
                    if checked_function.function == .Val(function) {
                        _ := sema_function_publish_return_views(scopes, return_view_rows, function)
                        provenance = function.return_view_provenance
                    }
                }
                .None -> {
                    summary_diagnostics := [Diagnostic]{}
                    summary_calls := [SemaCallSiteFact]{}
                    summary_comptime_requests := [SemaComptimeRequest]{}
                    summary_name_references := [SemaNameReferenceFact]{}
                    memory_position: sema_check_registered_memory_position(job, module_index, memory_plan, environment, program)
                    if trace_sink == .Val(_) -> summary_functions_checked += 1
                    checked := sema_function_check_registered(job, module_index, memory_plan, memory_position, owner_id, TFuncKind.TopLevel, false, environment, program, scopes, host_hooks, summary_diagnostics, summary_calls, summary_comptime_requests, summary_name_references)
                    if checked.value == .Val(function) {
                        _ := sema_function_publish_return_views(scopes, return_view_rows, function)
                        provenance = function.return_view_provenance
                    }
                }
            }
            round.push(provenance)
        }
        loop job in method_jobs -> round.push(sema_check_view_summary_method(job, module_index, memory_plan, environment, program, scopes, host_hooks))
        if summary_round > 0 && sema_check_view_rounds_equal(previous_round, round) -> break
        previous_round = round
        summary_round += 1
    }
    if trace_sink == .Val(sink) {
        sink.progress("counters.{counter_phase}.items_scanned", sema_check_registered_module_item_count(environment, program, module_index), -1)
        sink.progress("counters.{counter_phase}.summary_functions_checked", summary_functions_checked, -1)
    }
}

// The module's methods whose declared return type structurally contains a
// view, in method body order (sema_check_method_jobs). A method call reads
// the summary from `scopes.method_return_views`.
sema_check_view_summary_method_jobs: fn(program: SemaProgramTables, module_index: Int) -> [SemaBodyJob] {
    if program.registration_graph == .Val(graph) {
        jobs := [SemaBodyJob]{}
        scanned := 0
        loop job in sema_check_method_jobs(graph, graph.modules[module_index], scanned, false) {
            if job == {
                .NominalMethod(ordinal, owner, row) -> {
                    if sema_check_view_summary_method_selected(graph, module_index, graph.modules[module_index].nominals[owner].methods[row].declaration) -> jobs.push(SemaBodyJob.NominalMethod{ordinal: ordinal, nominal_index: owner, method_index: row})
                }
                .ImplMethod(ordinal, owner, row) -> {
                    if sema_check_view_summary_method_selected(graph, module_index, graph.modules[module_index].impls[owner].methods[row].declaration) -> jobs.push(SemaBodyJob.ImplMethod{ordinal: ordinal, implementation_index: owner, method_index: row})
                }
                .TopLevel(_) -> {}
            }
        }
        return jobs.move()
    }
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_view_summary_method_selected: fn(graph: SemaRegistrationGraph, module_index: Int, declaration: Func) -> Bool {
    if declaration.compiler_generated || declaration.inline_foreign != None || sema_function_is_guest_import(declaration) -> return false
    return_type: declaration.return_type ?? return false
    seen := [String:Bool]{}
    sema_check_type_contains_view(graph, graph.modules[module_index].module_identity, return_type, seen)
}

// One summary check of method `job`, set up as the method body pass sets it
// up: the owner's generic parameters and the panic location stay installed
// only for the check. Its diagnostics and other products are discarded; the
// inferred provenance is published under the method's registered symbol key,
// the key its call candidate carries.
sema_check_view_summary_method: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, environment: &SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, host_hooks: SemaHostHookAccess?) -> ViewProvenanceMap? {
    memory_position: sema_check_registered_memory_position(job, module_index, memory_plan, environment, program)
    input: sema_check_method_input(job, module_index, memory_plan, memory_position, environment, program)
    owner_id: sema_check_registered_function_id(job, module_index, environment, program)
    raw_protocol_return: sema_check_registered_raw_protocol_return(job, module_index, environment, program)
    base_generic_params: environment.generic_params.copy()
    environment.generic_params = input.generic_params.move()
    // copy: `previous_location` restores scopes.location_function after the check overwrites it.
    previous_location: scopes.location_function.copy()
    sema_function_check_registered_location(job, module_index, memory_plan, input.memory_position, environment, program, scopes)
    summary_diagnostics := [Diagnostic]{}
    summary_calls := [SemaCallSiteFact]{}
    summary_comptime_requests := [SemaComptimeRequest]{}
    summary_name_references := [SemaNameReferenceFact]{}
    checked := sema_function_check_registered(job, module_index, memory_plan, input.memory_position, owner_id, input.function_kind, raw_protocol_return, environment, program, scopes, host_hooks, summary_diagnostics, summary_calls, summary_comptime_requests, summary_name_references)
    scopes.location_function = previous_location
    environment.generic_params = base_generic_params.move()
    provenance := ViewProvenanceMap?{None}
    if checked.value == .Val(function) -> provenance = function.return_view_provenance
    if provenance == .Val(map) -> scopes.method_return_views[owner_id.key] = map
    provenance
}

sema_check_registered_module_item_count: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int) -> Int {
    if program.registration_graph == .Val(graph) -> return graph.modules[module_index].program.items.len()
    panic("an owning registered-module pass lost its registration graph")
}

// SP15: a module's top-level function and method bodies checked on compiler
// threads. The parallel pass (sema_check_bodies_parallel) checks every body
// sema_check_parallel_jobs and sema_check_parallel_method_jobs select against
// the module scope as it stands after the view summaries, each thread on its
// own copy of that scope and all of them on the one shared environment. The
// module's serial body loop then takes each prepared result in body-loop
// order instead of checking the body again (sema_check_module_function). It
// checks a body itself when the prepared result no longer applies: an
// earlier body published a return view that changed the module scope, or the
// check wanted a host callback, which never runs on a compiler thread.
// Reports, facts and functions are appended in body-loop order either way,
// so the module result is the same for any thread count.
// `checked` is optional only so the body loop can move it out
// (sema_check_drain_body); every prepared body has one.
SemaParallelBody: struct {
    job_index: Int
    checked: SemaFunctionResult?
    diagnostics: [Diagnostic]
    call_facts: [SemaCallSiteFact]
    comptime_requests: [SemaComptimeRequest]
    name_references: [SemaNameReferenceFact]
    method_input: SemaMethodInput?
    wanted_hooks: Bool
    host_reached: Bool{false}
    volatile: Bool{false}
    cache_hit: Bool{false}
    // A top-level body's memory plan row, as the thread that checked it
    // looked it up (memory_known), so the module pass need not look it up again.
    memory_position: Int?{None}
    memory_known: Bool{false}
}

// Replay carries an input descriptor, never a fabricated checked function.
SemaPreparedBody: enum {
    Checked(body: SemaParallelBody)
    Replay(job_index: Int)
}

// A module's parallel body pass: the post-summary module scope (one row, or
// none when the module checks serially) and the prepared function and method
// bodies, each list last first, so the body loop pops them in its order.
SemaPreparedBodies: struct {
    scopes: [SemaScopeTable]
    bodies: [SemaPreparedBody]
    memo: SemaModuleMemo?{None}
    queries: [Int:SemaBodyMemoQuery]{[Int:SemaBodyMemoQuery]{}}
    // A body wave's checks of the module's parallel method jobs
    // (sema_check_registered_parallel_method_jobs), last first like `bodies`;
    // `methods_prepared` when the wave selected those jobs.
    methods: [SemaPreparedBody]{[SemaPreparedBody]{}}
    methods_prepared: Bool{false}
    // The module's declaration and program checks when its pass made them
    // ahead (sema_check_declaration_modules), else None.
    started: SemaDeclarationCheck?{None}
}

sema_check_prepared_none: fn() -> SemaPreparedBodies Never! {
    SemaPreparedBodies{scopes: [SemaScopeTable]{}, bodies: [SemaPreparedBody]{}}
}

// Consume a body's prepared check in canonical source order. A wanted host
// callback or a changed top-level return-view scope requires the same check
// inline; none of that provisional result's reports or facts are published.
sema_check_prepared_body_index: fn(body: SemaPreparedBody) -> Int Never! {
    if body == {
        .Checked(value) -> value.job_index
        .Replay(index) -> index
    }
}

sema_check_take_body: fn(ready: &[SemaPreparedBody], job_index: Int) -> SemaPreparedBody? Never! {
    loop ready.len() > 0 && sema_check_prepared_body_index(ready[ready.len() - 1]) < job_index -> _ := ready.pop()
    if ready.len() > 0 && sema_check_prepared_body_index(ready[ready.len() - 1]) == job_index -> return ready.pop()
    None
}

sema_check_inline_memo_body: fn(job_index: Int, job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: &SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, host_hooks: SemaHostHookAccess?, prior_reach: SemaBodyCheckReach, prefix: &&[Diagnostic]) -> SemaParallelBody {
    observed: sema_incremental_observer(true)
    diagnostics := prefix.move()
    call_facts := [SemaCallSiteFact]{}
    comptime_requests := [SemaComptimeRequest]{}
    name_references := [SemaNameReferenceFact]{}
    checked := sema_function_check_registered(job, module_index, memory_plan, memory_position, owner_id, function_kind, raw_protocol_return, environment, program, scopes, sema_body_check_observe(host_hooks, observed), diagnostics, call_facts, comptime_requests, name_references)
    reach: sema_incremental_reach(observed)
    SemaParallelBody{
        job_index: job_index, checked: Val(checked.move()), diagnostics: diagnostics.move(),
        call_facts: call_facts.move(), comptime_requests: comptime_requests.move(),
        name_references: name_references.move(), method_input: None, wanted_hooks: false,
        host_reached: prior_reach.host || reach.host,
        volatile: prior_reach.foreign_raw_body || reach.foreign_raw_body,
    }
}

sema_check_drain_body: fn(body: &&SemaParallelBody, diagnostics: &[Diagnostic], call_facts: &[SemaCallSiteFact], comptime_requests: &[SemaComptimeRequest], name_references: &[SemaNameReferenceFact]) -> SemaFunctionResult {
    packet := body.move()
    // Moved, not copied: the packet is spent here.
    diagnostics.extend(packet.diagnostics.move())
    call_facts.extend(packet.call_facts.move())
    comptime_requests.extend(packet.comptime_requests.move())
    name_references.extend(packet.name_references.move())
    taken := packet.checked.move()
    packet.checked = None
    taken.move() ?? panic("an accepted body packet has no checked result")
}

sema_check_module_function: fn(ready: &[SemaPreparedBody], queries: &[Int:SemaBodyMemoQuery], memo: SemaModuleMemo?, job_index: Int, scopes_changed: Bool, job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: &SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, host_hooks: SemaHostHookAccess?, diagnostics: &[Diagnostic], call_facts: &[SemaCallSiteFact], comptime_requests: &[SemaComptimeRequest], name_references: &[SemaNameReferenceFact], count_work: Bool, functions_checked: &Int) -> SemaFunctionResult {
    query := SemaBodyMemoQuery?{None}
    if memo == .Val(_) {
        query = queries.remove(job_index)
        if query == None -> query = sema_incremental_registered_body_query(memo, job, module_index, memory_plan, environment, program)
    }
    prepared := sema_incremental_prepared(sema_check_take_body(ready, job_index), query, job_index, !scopes_changed)
    prior_reach := SemaBodyCheckReach{host: false, foreign_raw_body: false}
    if prepared != None {
        body := prepared.move() ?? panic("a prepared function packet disappeared")
        prepared = None
        if !scopes_changed && !body.wanted_hooks {
            sema_incremental_accept_packet(query, body)
            // Preserve serial names on a hit and the original method side effect.
            if body.cache_hit || function_kind != TFuncKind.TopLevel -> sema_function_check_registered_name(job, module_index, memory_plan, memory_position, environment, program)
            return sema_check_drain_body(body, diagnostics, call_facts, comptime_requests, name_references)
        }
        prior_reach = SemaBodyCheckReach{host: body.host_reached, foreign_raw_body: body.volatile}
    }
    if count_work -> functions_checked += 1
    if query == None {
        // No cold fingerprints, observer or temporary cache product arrays.
        return sema_function_check_registered(job, module_index, memory_plan, memory_position, owner_id, function_kind, raw_protocol_return, environment, program, scopes, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
    }
    query = sema_incremental_retarget(query, memo)
    body := sema_check_inline_memo_body(job_index, job, module_index, memory_plan, memory_position, owner_id, function_kind, raw_protocol_return, environment, program, scopes, host_hooks, prior_reach, [Diagnostic]{})
    sema_incremental_accept_packet(query, body)
    sema_check_drain_body(body, diagnostics, call_facts, comptime_requests, name_references)
}

// A compiler thread is admitted for at least this many bytes of function
// source, so a small program checks its bodies on the calling thread. A
// thread's fixed cost is its light scope copy (sema_scope_light_copy, a few
// hundred bytes per scope row); 32 KB per thread left every Core module of
// the self-compile (most under 64 KB of bodies) on one thread, about 6 s of
// the pass after the entry module's parallel check.
SEMA_BODY_MIN_BYTES_PER_THREAD: 4096
// Estimated bytes of one thread's copy of the module scope, per module item.
// The comptime prechecks' scope admission still uses this per-item estimate.
SEMA_BODY_SCOPE_BYTES_PER_ITEM: 4096
// Estimated bytes of one body thread's light copy of the module scope
// (sema_scope_light_copy), per scope binding row. A full row measured about
// 32 KB (one copy of the whole-compiler scope, about 25k module rows, was
// about 0.8 GB), almost all of it the module functions' types; the light copy
// leaves those in the shared module scope and keeps each row's identity
// strings, span, flags and non-function type, a few hundred bytes. The
// namespace rows still make a module scope span its whole package.
SEMA_BODY_SCOPE_BYTES_PER_BINDING: 2048

// The module-level binding rows sema_registration_apply_graph_module gives
// module `module_index`'s scope: its declarations, import bindings and
// package namespace rows (the compiler builtins are a fixed few more).
sema_check_module_scope_rows: fn(graph: SemaRegistrationGraph, module_index: Int) -> Int Never! {
    rows := graph.modules[module_index].symbols.len() + graph.modules[module_index].namespace_bindings.len()
    loop import_index in 0..<graph.modules[module_index].imports.len() -> rows += graph.modules[module_index].imports[import_index].bindings.len()
    rows
}

// What every body-check thread reads: the pass environment and memory plan,
// each moved in as the one row of its list for the pass and moved out
// between modules, so neither is copied. A body wave's module environments
// are its plan's (SemaBodyPlan.wave_environments).
SemaCheckShared: struct {
    environments: [SemaScopeEnvironment]
    programs: [SemaProgramTables]
    memory_plans: [SemaFunctionMemoryPlan]
}

// Addresses only: the AST, owner and trait stay in the frozen graph. Method
// ordinals are the nominal-then-impl source order used by ordered application.
SemaBodyJob: enum {
    TopLevel(item_index: Int)
    NominalMethod(ordinal: Int, nominal_index: Int, method_index: Int)
    ImplMethod(ordinal: Int, implementation_index: Int, method_index: Int)
}

// The body's existing shared lifecycle, absent for declaration-only checks.
SemaMethodScheduling: struct {
    shared_state: Shared<SemaCheckShared>
    threads: CompilerThreads
}

// The canonical module checker owns these rows while it runs. Returning
// them transports ownership back to all callers without moving from a borrow.
SemaOwnedModuleCheck: struct {
    module_result: SemaGraphModuleResult
    environment: SemaScopeEnvironment
    program: SemaProgramTables
    memory_plan: SemaFunctionMemoryPlan
}

// One thread of a module's parallel body pass: its own copy of the
// post-summary module scope, and the bodies it checked with each one's
// position in the pass's job list, in the order it claimed them.
SemaBodyPart: struct {
    scopes: SemaScopeTable
    bodies: [SemaPreparedBody]
    positions: [Int]
}

// What every thread of a parallel body pass reads: the jobs in job order,
// the order they are claimed in (`order[rank]` is a job position, heaviest
// source first), which positions are cache replays, and whether checks
// observe for the incremental cache. In a body wave (sema_check_body_wave)
// `modules[position]` is the wave module of each job,
// `module_indexes[wave module]` its graph module, and the wave module's
// environment, published bodies and count of unfinished jobs are its rows
// of `wave_environments`, `wave_outs` and `wave_left` (all empty outside a
// wave).
SemaBodyPlan: struct {
    jobs: [SemaBodyJob]
    order: [Int]
    replay: [Bool]
    observe: Bool
    modules: [Int]{[Int]{}}
    module_indexes: [Int]{[Int]{}}
    wave_environments: [Shared<SemaWaveEnvironment>]{[Shared<SemaWaveEnvironment>]{}}
    wave_outs: [Shared<SemaWaveOut>]{[Shared<SemaWaveOut>]{}}
    wave_left: [SemaBodyCount]{[SemaBodyCount]{}}
}

// A body wave module's environment, entered in the module with its
// post-summary scope moved in: the one row its jobs read until the module
// check takes the scope back (none for a module without wave jobs).
SemaWaveEnvironment: struct {
    environments: [SemaScopeEnvironment]
}

// The bodies a body wave module's jobs published, each with its job
// position, in the order the threads finished them.
SemaWaveOut: struct {
    bodies: [SemaPreparedBody]
    positions: [Int]
}

SemaBodyCount: struct {
    value: Atomic<Int>
}

// The next unclaimed rank of a parallel body pass, taken with one atomic add.
SemaBodyQueue: struct {
    next: Atomic<Int>
}

// One claimed job: its position in the plan's job list, or -1 when every job
// is claimed, and in a body wave its wave module and that module's graph
// module (-1 outside a wave).
SemaBodyClaim: struct {
    position: Int
    job: SemaBodyJob
    replay: Bool
    observe: Bool
    wave_module: Int
    module_index: Int
}

// The item indexes of module `module_index`'s top-level functions a compiler
// thread can check, in item order: not foreign (the foreign stage checks
// those), not already checked by comptime (the body loop takes that result),
// without generic parameters (sema_function_check_shared), not waiting
// for demand (sema_core_demand_deferred), and not reaching an unusable
// declaration (sema_checked_unusable_bodies); during a Core demand wave
// (graph.core_wave_rows) only that wave's. `weights` gets each one's source
// bytes.
sema_check_parallel_jobs: fn(graph: SemaRegistrationGraph, module_index: Int, comptime_rows: [String:Int], weights: &[Int]) -> [SemaBodyJob] Never! {
    source_module: graph.modules[module_index]
    core_wave: graph.core_wave_rows.len() > 0
    jobs := [SemaBodyJob]{}
    item_index := 0
    loop item in source_module.program.items {
        if item == .Func(func) {
            key: sema_check_top_level_key(source_module.module_identity, func.name)
            waiting: if core_wave -> graph.core_wave_rows.get(key) == None else -> sema_core_demand_deferred(graph, key)
            if func.inline_foreign == None && !sema_function_is_guest_import(func) && func.type_params.len() == 0 && comptime_rows.get("{source_module.module_identity}\n{key}") == None && !waiting && !sema_check_unusable_body(graph, key) {
                jobs.push(SemaBodyJob.TopLevel{item_index: item_index})
                weights.push(func.span.end - func.span.start)
            }
        }
        item_index += 1
    }
    jobs
}

// Exactly the original nominal-then-impl order, with impl lookup duplicates
// omitted once. The same addresses select workers and drive ordered apply.
// A generated codec impl whose body no demand has filled is skipped; during a
// codec wave (graph.codec_wave_rows) only that wave's filled codecs are jobs.
// A demand-checked derived method (graph.derive_method_rows) is a job only
// once a derive wave checked it (graph.derive_checked, so a recheck keeps
// it); during a derive wave (graph.derive_wave_rows) only that wave's are.
// A deferred Core body (sema_core_demand_deferred) is not a job; during a
// Core demand wave (graph.core_wave_rows) only that wave's bodies are. A
// body that reaches an unusable declaration (sema_checked_unusable_bodies)
// is never a job.
sema_check_method_jobs: fn(graph: SemaRegistrationGraph, source_module: SemaRegistrationModule, impl_rows_scanned: &Int, count_work: Bool) -> [SemaBodyJob] Never! {
    jobs := [SemaBodyJob]{}
    codec_wave: graph.codec_wave_rows.len() > 0
    derive_wave: graph.derive_wave_rows.len() > 0
    core_wave: graph.core_wave_rows.len() > 0
    if !codec_wave {
        loop (nominal_index, nominal) in source_module.nominals {
            // An impl method's nominal row shares its key and declaration span; a
            // method of a nested `impl Trait { … }` block that only shares the key
            // (a user codec beside a generated one, E0105) is still its own job.
            impl_method_keys := [String:Bool]{}
            loop impl_row in sema_registration_impl_rows_named(graph, nominal.symbol.name) {
                if count_work -> impl_rows_scanned += 1
                loop method_index in 0..<graph.modules[impl_row.module_index].impls[impl_row.row].methods.len() {
                    impl_method: graph.modules[impl_row.module_index].impls[impl_row.row].methods[method_index]
                    impl_method_keys["{impl_method.symbol.id.key}@{impl_method.declaration.span.start}:{impl_method.declaration.span.end}"] = true
                }
            }
            loop (method_index, method) in nominal.methods {
                if impl_method_keys.get("{method.symbol.id.key}@{method.declaration.span.start}:{method.declaration.span.end}") != None || sema_check_unusable_body(graph, method.symbol.id.key) -> next
                if core_wave {
                    if graph.core_wave_rows.get(method.symbol.id.key) == None -> next
                } else if method.declaration.compiler_generated && graph.derive_method_rows.get(method.symbol.id.key) != None {
                    if derive_wave {
                        if graph.derive_wave_rows.get(method.symbol.id.key) == None -> next
                    } else if graph.derive_checked.get(method.symbol.id.key) == None {
                        next
                    }
                } else if derive_wave || sema_core_demand_deferred(graph, method.symbol.id.key) {
                    next
                }
                jobs.push(SemaBodyJob.NominalMethod{ordinal: jobs.len(), nominal_index: nominal_index, method_index: method_index})
            }
        }
    }
    if derive_wave -> return jobs
    module_index: name_rows_get_text(graph.module_rows, source_module.module_identity) ?? -1
    // A top-level impl the orphan rule refuses (E0902) checks no body.
    coherence := SemaCheckedCoherence?{None}
    loop (implementation_index, implementation) in source_module.impls {
        if codec_wave {
            if graph.codec_wave_rows.get("{module_index}:{implementation_index}") == None -> next
        } else if sema_codec_impl_pending(implementation) {
            next
        }
        if implementation.declaration.trait_name != None && implementation.target_module_identity == None {
            if coherence == None -> coherence = Val(sema_checked_coherence_state(source_module))
            if coherence == .Val(state) {
                if sema_checked_impl_refused(graph, source_module, state, implementation) -> next
            }
        }
        loop (method_index, method) in implementation.methods {
            if sema_check_unusable_body(graph, method.symbol.id.key) -> next
            if core_wave {
                if graph.core_wave_rows.get(method.symbol.id.key) == None -> next
            } else if sema_core_demand_deferred(graph, method.symbol.id.key) {
                next
            }
            jobs.push(SemaBodyJob.ImplMethod{ordinal: jobs.len(), implementation_index: implementation_index, method_index: method_index})
        }
    }
    jobs
}

sema_check_method_parallel_eligible: fn(graph: SemaRegistrationGraph, source_module: SemaRegistrationModule, memory_plan: SemaFunctionMemoryPlan, registered: SemaRegistrationFunction, owner_type: Type, comptime_rows: [String:Int]) -> Bool {
    if comptime_rows.get("{source_module.module_identity}\n{registered.symbol.id.key}") != None -> return false
    position: memory_plan.positions.get(sema_function_memory_key(source_module.module_identity, sema_serde_named_leaf(sema_type_graph_base_name(owner_type) ?? ""), registered.declaration.name, registered.declaration.span)) ?? return false
    planned: memory_plan.functions[position].function ?? registered.declaration
    if planned.type_params.len() != 0 -> return false
    // A concrete generic owner still has declared generics, even when
    // owner-generic normalization would return no unresolved parameters.
    owner_row := sema_type_resolve_nominal_row(graph, owner_type, source_module.module_identity)
    if owner_row == .Val(found) -> return graph.modules[found.module_index].nominals[found.row].generic_params.len() == 0
    if owner_type == .Apply(_, _) -> return false
    true
}

sema_check_parallel_method_jobs: fn(graph: SemaRegistrationGraph, source_module: SemaRegistrationModule, memory_plan: SemaFunctionMemoryPlan, generic_params: [TGenericParam], all_jobs: [SemaBodyJob], comptime_rows: [String:Int], weights: &[Int]) -> [SemaBodyJob] {
    jobs := [SemaBodyJob]{}
    if generic_params.len() != 0 -> return jobs
    loop job in all_jobs {
        if job == {
            .NominalMethod(_, nominal_index, method_index) -> {
                nominal: source_module.nominals[nominal_index]
                method: nominal.methods[method_index]
                if !sema_check_method_parallel_eligible(graph, source_module, memory_plan, method, nominal.ty, comptime_rows) -> next
                weights.push(method.declaration.span.end - method.declaration.span.start)
            }
            .ImplMethod(_, implementation_index, method_index) -> {
                implementation: source_module.impls[implementation_index]
                method: implementation.methods[method_index]
                if !sema_check_method_parallel_eligible(graph, source_module, memory_plan, method, implementation.target_type, comptime_rows) -> next
                weights.push(method.declaration.span.end - method.declaration.span.start)
            }
            .TopLevel(_) -> panic("a top-level job entered the method wave")
        }
        jobs.push(job.copy())
    }
    jobs
}

// A compiler thread that checked a body also walks it for the module's
// prelude conversion demands (sema_prelude_conversion_demands), so the
// module check's demand walk (sema_inject_prelude_error_conversions) reads
// them instead of walking that body again. The checked function moves into
// a one-row list for the walk and back into the returned result.
sema_check_walk_prelude_demands: fn(checked: &&SemaFunctionResult, module_identity: String) -> SemaFunctionResult {
    walked := checked.move()
    if walked.value == None -> return walked
    taken := walked.value.move()
    walked.value = None
    functions := [FnBody]{taken.move() ?? panic("a checked body lost its function")}
    walked.prelude_demands = Val(sema_prelude_conversion_demands(module_identity, functions, [Int:[SemaPreludeConversionDemand]]{}))
    function := functions.pop() ?? panic("a walked body lost its function")
    walked.value = Val(function.move())
    walked
}

sema_check_prepare_method_body: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, ordinal: Int, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, wanted: Shared<SemaHostHookWanted>, observed: Shared<SemaBodyCheckReach>?) -> SemaParallelBody {
    memory_position: sema_check_registered_memory_position(job, module_index, memory_plan, environment, program)
    input := sema_check_method_input(job, module_index, memory_plan, memory_position, environment, program)
    diagnostics := input.diagnostics.move()
    input.diagnostics = [Diagnostic]{}
    call_facts := [SemaCallSiteFact]{}
    comptime_requests := [SemaComptimeRequest]{}
    name_references := [SemaNameReferenceFact]{}
    owner_id: sema_check_registered_function_id(job, module_index, environment, program)
    raw_protocol_return: sema_check_registered_raw_protocol_return(job, module_index, environment, program)
    checked := sema_function_check_registered_shared(job, module_index, memory_plan, memory_position, owner_id, input.function_kind, raw_protocol_return, environment, program, scopes, Val(SemaHostHookAccess.Withheld{wanted: wanted, observed: observed}), diagnostics, call_facts, comptime_requests, name_references)
    checked = sema_check_walk_prelude_demands(checked, sema_check_registered_module_identity(environment, program, module_index))
    reach: sema_incremental_reach(observed)
    SemaParallelBody{job_index: ordinal, checked: Val(checked.move()), diagnostics: diagnostics.move(), call_facts: call_facts.move(), comptime_requests: comptime_requests.move(), name_references: name_references.move(), method_input: Val(input.move()), wanted_hooks: sema_host_hook_was_wanted(wanted), host_reached: reach.host, volatile: reach.foreign_raw_body}
}

// One thread's checks: it claims the plan's jobs one at a time, heaviest
// source first, until none is left, and checks each on its own scope copy.
// The existing guard_read remains in sema_check_body_part. Both retained
// owners stay pinned until this read-only worker returns; admission/join and
// packet publication are unchanged.
sema_check_body_part_in: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, memory_plan: SemaFunctionMemoryPlan, part: &SemaBodyPart, plan: Shared<SemaBodyPlan>, queue: Shared<SemaBodyQueue>, module_index: Int) -> Int {
    wanted: Shared{SemaHostHookWanted{wanted: false}}
    jobs: plan.guard_read()
    ranks: queue.guard_read()
    checked_count := 0
    loop {
        claim: sema_check_body_claim(jobs.value, ranks.value)
        if claim.position < 0 -> break
        checked_count += sema_check_body_claimed(environment, program, memory_plan, part, claim, module_index, wanted)
    }
    checked_count
}

// One thread of a body wave (sema_check_body_wave): as sema_check_body_part_in,
// but each claimed job belongs to one of the wave's modules
// (sema_check_body_wave_job).
sema_check_body_wave_part: fn(shared: Shared<SemaCheckShared>, plan: Shared<SemaBodyPlan>, queue: Shared<SemaBodyQueue>) -> Int {
    inputs: shared.guard_read()
    jobs: plan.guard_read()
    ranks: queue.guard_read()
    wanted: Shared{SemaHostHookWanted{wanted: false}}
    part := SemaBodyPart{scopes: sema_scope_init(""), bodies: [SemaPreparedBody]{}, positions: [Int]{}}
    checked_count := 0
    current := -1
    loop {
        claim: sema_check_body_claim(jobs.value, ranks.value)
        if claim.position < 0 -> break
        // Passed straight through: a local binding of a guarded row would copy it.
        checked_count += sema_check_body_wave_job(inputs.value.programs[0], inputs.value.memory_plans[0], jobs.value, part, current, claim, wanted)
    }
    checked_count
}

// Checks one claimed body wave job against its module's environment, on
// `part`'s light copy of that module's scope (made on this thread when the
// job's module is not `current`, the previous job's), then publishes its
// body to the module and counts the job done. The environment's read guard
// ends before the publication, so the module's last job done means no
// thread reads that environment again.
sema_check_body_wave_job: fn(program: SemaProgramTables, memory_plan: SemaFunctionMemoryPlan, plan: SemaBodyPlan, part: &SemaBodyPart, current: &Int, claim: SemaBodyClaim, wanted: Shared<SemaHostHookWanted>) -> Int {
    checked: sema_check_body_wave_claimed(plan.wave_environments[claim.wave_module], program, memory_plan, part, current, claim, wanted)
    sema_check_body_wave_publish(plan.wave_outs[claim.wave_module], part)
    _ := plan.wave_left[claim.wave_module].value.add(-1)
    checked
}

sema_check_body_wave_claimed: fn(cell: Shared<SemaWaveEnvironment>, program: SemaProgramTables, memory_plan: SemaFunctionMemoryPlan, part: &SemaBodyPart, current: &Int, claim: SemaBodyClaim, wanted: Shared<SemaHostHookWanted>) -> Int {
    held: cell.guard_read()
    if claim.wave_module != current {
        current = claim.wave_module
        part.scopes = sema_check_body_wave_scope_copy(held.value.environments[0])
    }
    sema_check_body_claimed(held.value.environments[0], program, memory_plan, part, claim, claim.module_index, wanted)
}

// Moves the body a job left in `part` (none for a job with no function
// span) into its module's published bodies.
sema_check_body_wave_publish: fn(out: Shared<SemaWaveOut>, part: &SemaBodyPart) {
    if part.bodies.len() == 0 -> return
    held: out.guard_edit()
    loop part.bodies.len() > 0 {
        body: part.bodies.pop() ?? break
        position: part.positions.pop() ?? panic("a checked body has no job position")
        held.value.bodies.push(body)
        held.value.positions.push(position)
    }
}

// A light copy of a wave module's scope (sema_check_body_part_copy_scope),
// read in place through the read parameter.
sema_check_body_wave_scope_copy: fn(environment: SemaScopeEnvironment) -> SemaScopeTable {
    if environment.module_scope == .Val(source) -> return sema_scope_light_copy(source)
    panic("a body-wave module scope left its environment")
}

// Checks one claimed job of module `module_index` on `part`'s scope copy and
// records its body at the claim's position; 1 when it checked a body, 0 for
// a cache replay.
sema_check_body_claimed: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, memory_plan: SemaFunctionMemoryPlan, part: &SemaBodyPart, claim: SemaBodyClaim, module_index: Int, wanted: Shared<SemaHostHookWanted>) -> Int {
    if program.registration_graph == .Val(graph) {
        if claim.replay {
            part.bodies.push(SemaPreparedBody.Replay{job_index: sema_check_body_job_index(claim.job)})
            part.positions.push(claim.position)
            return 0
        }
        observed: sema_incremental_observer(claim.observe)
        sema_host_hook_unwant(wanted)
        if claim.job == {
            .TopLevel(item_index) -> {
                // The function's span is read through a read parameter:
                // a pattern over the payload binding copied the function.
                if sema_registered_top_level_func_span(graph, module_index, item_index) == .Val(func_span) {
                    memory_position: sema_function_memory_position(memory_plan, graph.modules[module_index].module_identity, "", sema_registered_job_function_name(graph, claim.job, module_index), func_span)
                    diagnostics := [Diagnostic]{}
                    call_facts := [SemaCallSiteFact]{}
                    comptime_requests := [SemaComptimeRequest]{}
                    name_references := [SemaNameReferenceFact]{}
                    checked := sema_function_check_registered_shared(claim.job, module_index, memory_plan, memory_position, symbol_id(SymbolKind.Function, graph.modules[module_index].module_identity, "", sema_registered_job_function_name(graph, claim.job, module_index)), TFuncKind.TopLevel, false, environment, program, part.scopes, Val(SemaHostHookAccess.Withheld{wanted: wanted, observed: observed}), diagnostics, call_facts, comptime_requests, name_references)
                    checked = sema_check_walk_prelude_demands(checked, graph.modules[module_index].module_identity)
                    reach: sema_incremental_reach(observed)
                    part.bodies.push(SemaPreparedBody.Checked{body: SemaParallelBody{job_index: item_index, checked: Val(checked.move()), diagnostics: diagnostics.move(), call_facts: call_facts.move(), comptime_requests: comptime_requests.move(), name_references: name_references.move(), method_input: None, wanted_hooks: sema_host_hook_was_wanted(wanted), host_reached: reach.host, volatile: reach.foreign_raw_body, memory_position: memory_position, memory_known: true}})
                    part.positions.push(claim.position)
                }
            }
            .NominalMethod(ordinal, _, _) -> {
                part.bodies.push(SemaPreparedBody.Checked{body: sema_check_prepare_method_body(claim.job, module_index, memory_plan, ordinal, environment, program, part.scopes, wanted, observed)})
                part.positions.push(claim.position)
            }
            .ImplMethod(ordinal, _, _) -> {
                part.bodies.push(SemaPreparedBody.Checked{body: sema_check_prepare_method_body(claim.job, module_index, memory_plan, ordinal, environment, program, part.scopes, wanted, observed)})
                part.positions.push(claim.position)
            }
        }
        return 1
    }
    0
}

// Claims the next rank of `queue` (one atomic add) and reads its job from
// `plan`; position -1 once every job is claimed. A thread holds read guards
// on both for its whole run, so claiming takes no lock.
sema_check_body_claim: fn(plan: SemaBodyPlan, queue: SemaBodyQueue) -> SemaBodyClaim {
    rank: queue.next.add(1)
    if rank >= plan.order.len() -> return SemaBodyClaim{position: -1, job: SemaBodyJob.TopLevel{item_index: -1}, replay: false, observe: false, wave_module: -1, module_index: -1}
    position: plan.order[rank]
    wave_module: if plan.modules.len() > position -> plan.modules[position] else -> -1
    module_index: if wave_module >= 0 -> plan.module_indexes[wave_module] else -> -1
    SemaBodyClaim{position: position, job: plan.jobs[position], replay: plan.replay.len() > position && plan.replay[position], observe: plan.observe, wave_module: wave_module, module_index: module_index}
}

// The span of the top-level function item `item_index`, when it is one.
sema_registered_top_level_func_span: fn(graph: SemaRegistrationGraph, module_index: Int, item_index: Int) -> Span? Never! {
    if graph.modules[module_index].program.items[item_index] == .Func(func) -> return Val(func.span)
    None
}

// Only compiler-generated nominal methods relocate their diagnostics to the
// author-facing nominal span. Implementation methods retain their own spans.
sema_check_generated_method_author_span: fn(job: SemaBodyJob, module_index: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Span? {
    if program.registration_graph == .Val(graph) {
        if job == {
            .NominalMethod(_, owner, row) -> {
                if graph.modules[module_index].nominals[owner].methods[row].declaration.compiler_generated -> return Val(graph.modules[module_index].nominals[owner].symbol.span)
                return None
            }
            .ImplMethod(_, _, _) -> return None
            .TopLevel(_) -> panic("a top-level job entered method application")
        }
    }
    panic("a registered Jet method lost its owning graph")
}

// Is `job` a method of a compiler-generated codec impl? Its body has no
// author to act on advice, so it reports its errors alone, as a derived
// body does (sema_author_facing_diagnostics); they keep their own spans.
sema_check_generated_codec_method: fn(job: SemaBodyJob, module_index: Int, program: SemaProgramTables) -> Bool {
    graph: program.registration_graph ?? panic("a registered Jet method lost its owning graph")
    if job == .ImplMethod(_, owner, _) -> return graph.modules[module_index].impls[owner].compiler_generated
    false
}

sema_check_apply_method_job: fn(module_index: Int, memory_plan: SemaFunctionMemoryPlan, job: SemaBodyJob, ready: &[SemaPreparedBody], queries: &[Int:SemaBodyMemoQuery], memo: SemaModuleMemo?, scopes: &SemaScopeTable, environment: &SemaScopeEnvironment, program: SemaProgramTables, host_hooks: SemaHostHookAccess?, comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], diagnostics: &[Diagnostic], functions: &[FnBody], prelude_demands: &[Int:[SemaPreludeConversionDemand]], call_facts: &[SemaCallSiteFact], hardware_use: &TargetHardwareUse, comptime_requests: &[SemaComptimeRequest], name_references: &[SemaNameReferenceFact], comptime_body_sources: &[SemaComptimeBodySource], compute_facts: &[SemaComputeFunctionFacts], failure_facts: &[SemaFunctionFailureFacts], exact_int_reachable: &Bool, copy_events: &[SemaCopyEvent], reasons: &[String], keep_going: Bool, pending_obligations: Bool) -> Bool {
    ordinal: if job == {
        .NominalMethod(position, _, _) -> position
        .ImplMethod(position, _, _) -> position
        .TopLevel(_) -> panic("a top-level job entered method application")
    }
    author_span: sema_check_generated_method_author_span(job, module_index, environment, program)
    if author_span == .Val(span) {
        generated_diagnostics := [Diagnostic]{}
        complete := sema_check_registration_method(job, module_index, memory_plan, ready, queries, memo, ordinal, scopes, environment, program, host_hooks, comptime_functions, comptime_rows, generated_diagnostics, functions, prelude_demands, call_facts, hardware_use, comptime_requests, name_references, comptime_body_sources, compute_facts, failure_facts, exact_int_reachable, copy_events, reasons, keep_going, pending_obligations)
        sema_author_facing_diagnostics(span, generated_diagnostics, diagnostics)
        return complete
    }
    if sema_check_generated_codec_method(job, module_index, program) {
        generated_diagnostics := [Diagnostic]{}
        complete := sema_check_registration_method(job, module_index, memory_plan, ready, queries, memo, ordinal, scopes, environment, program, host_hooks, comptime_functions, comptime_rows, generated_diagnostics, functions, prelude_demands, call_facts, hardware_use, comptime_requests, name_references, comptime_body_sources, compute_facts, failure_facts, exact_int_reachable, copy_events, reasons, keep_going, pending_obligations)
        loop diagnostic in generated_diagnostics {
            if diagnostic.severity == DIAGNOSTIC_ERROR -> diagnostics.push(diagnostic)
        }
        return complete
    }
    sema_check_registration_method(job, module_index, memory_plan, ready, queries, memo, ordinal, scopes, environment, program, host_hooks, comptime_functions, comptime_rows, diagnostics, functions, prelude_demands, call_facts, hardware_use, comptime_requests, name_references, comptime_body_sources, compute_facts, failure_facts, exact_int_reachable, copy_events, reasons, keep_going, pending_obligations)
}

// The module scope the body loop of module `module_index` checks against:
// the registered module scope after the view summaries, built as
// sema_check_registration_module builds it (whose reports here are its own).
// Leaves `environment` entered in the module.
// The initial graph/scope read window closes before entering the actual
// environment. Every summary then uses this selected module's identity/facts.
sema_check_module_summary_scope_init: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int) -> SemaScopeTable {
    if program.registration_graph == .Val(graph) {
        scopes := sema_scope_init(graph.modules[module_index].module_identity)
        discarded := [Diagnostic]{}
        _ := sema_registration_apply_graph_module(graph, graph.modules[module_index].module_identity, scopes, discarded)
        return scopes.move()
    }
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_module_summary_scopes: fn(environment: &SemaScopeEnvironment, program: &SemaProgramTables, host_hooks: SemaHostHookAccess?, memory_plan: SemaFunctionMemoryPlan, module_index: Int, comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], view_jobs: [Int]?, counter_phase: String, trace_sink: CompilerTraceSink?) -> SemaScopeTable {
    scopes := sema_check_module_summary_scope_init(environment, program, module_index)
    // copy: a handle copy (Shared facts plus length and frontier ints): the summary scopes read a
    // frozen prefix while environment.comptime_body_publication keeps advancing.
    body_values := environment.comptime_body_publication.copy()
    sema_scope_environment_enter_module(environment, program, module_index, body_values)
    sema_check_view_summaries(environment, program, scopes, module_index, host_hooks, memory_plan, comptime_functions, comptime_rows, view_jobs, counter_phase, trace_sink)
    scopes.move()
}

// The parallel body pass of module `module_index` on `workers` threads:
// `jobs` (sema_check_parallel_jobs) are claimed one at a time by whichever
// thread is free, heaviest source (`weights`) first, so no thread idles
// while jobs remain, each checked on that thread's own copy of `scopes`
// against the environment and memory plan in `shared`. A body's check reads
// only the frozen environment and its thread's scope copy, so it is the same
// body whichever thread checks it and whatever was checked before it; the
// joined bodies are placed by job position, last first, as the body loop
// pops them.
sema_check_bodies_parallel: fn(shared: Shared<SemaCheckShared>, module_index: Int, scopes: &&SemaScopeTable, jobs: [SemaBodyJob], weights: [Int], workers: Int, memo: SemaModuleMemo?, owned_queries: &&[Int:SemaBodyMemoQuery]) -> SemaPreparedBodies {
    queries := owned_queries.move()
    prepared := SemaPreparedBodies{scopes: [SemaScopeTable]{}, bodies: [SemaPreparedBody]{}, memo: memo, queries: [Int:SemaBodyMemoQuery]{}}
    has_memo: if memo == .Val(_) -> true else -> false
    all_replayed := has_memo
    if all_replayed {
        loop job in jobs {
            index: sema_check_body_job_index(job)
            if !queries.has_key(index) || !queries[index].replay {
                all_replayed = false
                break
            }
        }
    }
    if all_replayed {
        // Descriptors need no worker or copied scope.
        index := jobs.len()
        loop index > 0 {
            index -= 1
            prepared.bodies.push(SemaPreparedBody.Replay{job_index: sema_check_body_job_index(jobs[index])})
        }
        prepared.scopes.push(scopes)
        prepared.queries = queries.move()
        return prepared.move()
    }
    plan_jobs := [SemaBodyJob]{}
    replay := [Bool]{}
    loop position in 0..<jobs.len() {
        plan_jobs.push(jobs[position])
        if has_memo {
            index: sema_check_body_job_index(jobs[position])
            replay.push(queries.has_key(index) && queries[index].replay)
        }
    }
    order := compiler_threads_heaviest_first(weights)
    plan: Shared{SemaBodyPlan{jobs: [SemaBodyJob]{}, order: [Int]{}, replay: [Bool]{}, observe: has_memo}}
    sema_check_body_plan_fill(plan, plan_jobs, order, replay)
    queue: Shared{SemaBodyQueue{next: 0}}
    sema_check_shared_lend_scope(shared, scopes)
    slots := [Shared<SemaBodyPart>]{}
    loop _ in 0..<workers {
        slot: Shared{SemaBodyPart{scopes: sema_scope_init(""), bodies: [SemaPreparedBody]{}, positions: [Int]{}}}
        slots.push(slot)
    }
    _ := sema_check_body_parts(shared, slots, plan, queue, 0, module_index)
    restored := sema_check_shared_return_scope(shared)
    prepared.scopes.push(restored)
    prepared.queries = queries.move()
    placed := [SemaPreparedBody?]{}
    loop _ in 0..<jobs.len() -> placed.push(None)
    loop slot in slots -> sema_check_body_part_place(slot, placed)
    loop placed.len() > 0 {
        taken := placed.pop() ?? break
        body := taken.move() ?? next
        prepared.bodies.push(body)
    }
    prepared.move()
}

// Moves the pass's jobs, claim order and replay flags into its shared plan.
sema_check_body_plan_fill: fn(plan: Shared<SemaBodyPlan>, jobs: &&[SemaBodyJob], order: &&[Int], replay: &&[Bool]) {
    permit: plan.guard_edit()
    permit.value.jobs = jobs.move()
    permit.value.order = order.move()
    permit.value.replay = replay.move()
}

// The post-summary module scope is the pass's shared read-only module scope:
// it moves into the shared environment before the threads start and back
// out after they join. Each thread makes its own light copy of it on that
// thread (sema_scope_light_copy) and reads the function types the copy
// leaves out from it, so no thread copies a module function type.
sema_check_shared_lend_scope: fn(shared: Shared<SemaCheckShared>, scopes: &&SemaScopeTable) {
    environment := sema_check_shared_take_environment(shared)
    environment.module_scope = Val(scopes.move())
    sema_check_shared_put_environment(shared, environment)
}

sema_check_shared_return_scope: fn(shared: Shared<SemaCheckShared>) -> SemaScopeTable {
    environment := sema_check_shared_take_environment(shared)
    taken := environment.module_scope.move()
    environment.module_scope = None
    sema_check_shared_put_environment(shared, environment)
    taken.move() ?? panic("the body-check module scope left the shared environment")
}

// Gives a thread's slot its own light copy of the shared module scope, made
// on that thread.
sema_check_body_part_copy_scope: fn(environment: SemaScopeEnvironment, slot: Shared<SemaBodyPart>) {
    // The shared module scope is read in place by the light copy.
    if environment.module_scope == .Val(source) {
        light := sema_scope_light_copy(source)
        permit: slot.guard_edit()
        permit.value.scopes = light.move()
        return
    }
    panic("the body-check module scope left the shared environment")
}

// Moves a thread's bodies into `placed`, each at its job position.
sema_check_body_part_place: fn(slot: Shared<SemaBodyPart>, placed: &[SemaPreparedBody?]) {
    permit: slot.guard_edit()
    loop permit.value.bodies.len() > 0 {
        body: permit.value.bodies.pop() ?? break
        position: permit.value.positions.pop() ?? panic("a checked body has no job position")
        placed[position] = Val(body)
    }
}

// Checks on `slots[from..]`, one task per slot and the last slot on this
// thread; returns how many bodies they checked.
sema_check_body_parts: fn(shared: Shared<SemaCheckShared>, slots: [Shared<SemaBodyPart>], plan: Shared<SemaBodyPlan>, queue: Shared<SemaBodyQueue>, from: Int, module_index: Int) -> Int {
    if from >= slots.len() - 1 -> return sema_check_body_part(shared, slots[from], plan, queue, module_index)
    checked := 0
    task.group sema_threads {
        head: task sema_check_body_part(shared, slots[from], plan, queue, module_index)
        checked = sema_check_body_parts(shared, slots, plan, queue, from + 1, module_index)
        checked += head.join() ?? panic(compiler_threads_failure_text(err))
    }
    checked
}

// Where a body wave's modules' jobs sit in its job list: wave module k's
// top-level jobs are positions firsts[k]..<firsts[k + 1] and its method jobs
// method_firsts[k]..<method_firsts[k + 1]; `prepared[k]` when the wave built
// module k's post-summary scope. `start` is wave module 0's position in the
// pass's selected modules. `core` when the wave is a Core demand wave's
// (sema_core_demand_waves), which appends to each module's existing result.
SemaWaveLayout: struct {
    start: Int
    firsts: [Int]
    method_firsts: [Int]
    prepared: [Bool]
    core: Bool
}

// A body wave's threads: `tasks` tasks of sema_check_body_wave_part and the
// wave's lead (sema_check_body_wave_lead) on this thread. Returns how many
// bodies they checked.
sema_check_body_wave_parts: fn(shared: Shared<SemaCheckShared>, plan: Shared<SemaBodyPlan>, queue: Shared<SemaBodyQueue>, tasks: Int, environment: &SemaScopeEnvironment, host_hooks: SemaHostHookAccess?, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], pending_obligations: Bool, layout: SemaWaveLayout, phase: String, trace_sink: CompilerTraceSink?, starts: &[SemaDeclarationCheck], modules: &[SemaGraphModuleResult], checked_functions: &Int, done: &Int) -> Int {
    if tasks <= 0 -> return sema_check_body_wave_lead(shared, plan, queue, environment, host_hooks, values, comptime_functions, comptime_rows, pending_obligations, layout, phase, trace_sink, starts, modules, checked_functions, done)
    checked := 0
    task.group sema_threads {
        head: task sema_check_body_wave_part(shared, plan, queue)
        checked = sema_check_body_wave_parts(shared, plan, queue, tasks - 1, environment, host_hooks, values, comptime_functions, comptime_rows, pending_obligations, layout, phase, trace_sink, starts, modules, checked_functions, done)
        checked += head.join() ?? panic(compiler_threads_failure_text(err))
    }
    checked
}

// The lead thread of a body wave: checks wave modules `done..` in module
// order (sema_check_registration_module_lent, or for a Core demand wave
// sema_check_core_demand_module_lent into the module's existing result),
// each once every one of its jobs is done, so each module's result is the
// one a check after the whole wave makes. While the next module's jobs are
// unfinished it claims wave jobs itself (sema_check_body_wave_job). Once
// every job is claimed and the next module's are still running elsewhere it
// stops; `done` is then the first module it did not check, which the wave
// checks after the threads join. Returns how many bodies it checked.
sema_check_body_wave_lead: fn(shared: Shared<SemaCheckShared>, plan: Shared<SemaBodyPlan>, queue: Shared<SemaBodyQueue>, environment: &SemaScopeEnvironment, host_hooks: SemaHostHookAccess?, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], pending_obligations: Bool, layout: SemaWaveLayout, phase: String, trace_sink: CompilerTraceSink?, starts: &[SemaDeclarationCheck], modules: &[SemaGraphModuleResult], checked_functions: &Int, done: &Int) -> Int {
    inputs: shared.guard_read()
    jobs: plan.guard_read()
    ranks: queue.guard_read()
    wanted: Shared{SemaHostHookWanted{wanted: false}}
    part := SemaBodyPart{scopes: sema_scope_init(""), bodies: [SemaPreparedBody]{}, positions: [Int]{}}
    checked_count := 0
    current := -1
    loop done < layout.prepared.len() {
        loop jobs.value.wave_left[done].value.load() > 0 {
            claim: sema_check_body_claim(jobs.value, ranks.value)
            if claim.position < 0 -> return checked_count
            // Passed straight through: a local binding of a guarded row would copy it.
            checked_count += sema_check_body_wave_job(inputs.value.programs[0], inputs.value.memory_plans[0], jobs.value, part, current, claim, wanted)
        }
        module_index: jobs.value.module_indexes[done]
        bodies := sema_check_body_wave_take(jobs.value, done, layout)
        if layout.core {
            scopes := bodies.scopes.pop() ?? panic("a Core demand wave module lost its post-summary scope")
            body_values := environment.comptime_body_publication.copy()
            sema_scope_environment_enter_module(environment, inputs.value.programs[0], module_index, body_values)
            checked_functions += sema_check_core_demand_module_lent(environment, inputs.value.programs[0], host_hooks, inputs.value.memory_plans[0], module_index, scopes, bodies, comptime_functions, comptime_rows, pending_obligations, trace_sink, modules[module_index])
            done += 1
            next
        }
        started := starts.pop() ?? panic("a body-wave module lost its declaration check")
        if started.position != layout.start + done -> panic("a body-wave module took another module's declaration check")
        bodies.started = Val(started.move())
        if trace_sink == .Val(sink) -> sema_check_module_trace_begin(inputs.value.programs[0], module_index, phase, sink)
        checked := sema_check_registration_module_lent(environment, inputs.value.programs[0], host_hooks, inputs.value.memory_plans[0], module_index, values, comptime_functions, comptime_rows, pending_obligations, bodies, phase, trace_sink)
        if trace_sink == .Val(sink) -> sink.end("sema.module", checked.functions.len())
        checked_functions += checked.functions.len()
        modules.push(checked)
        done += 1
    }
    checked_count
}

// The prepared bodies of done wave module `wave_module`, as
// sema_check_bodies_parallel leaves a module's: its post-summary scope taken
// back from its environment, and its top-level and method bodies, each list
// in job order last first.
sema_check_body_wave_take: fn(plan: SemaBodyPlan, wave_module: Int, layout: SemaWaveLayout) -> SemaPreparedBodies {
    bodies := sema_check_prepared_none()
    if !layout.prepared[wave_module] -> return bodies.move()
    bodies.scopes.push(sema_check_body_wave_take_scope(plan.wave_environments[wave_module]))
    first: layout.firsts[wave_module]
    top: layout.firsts[wave_module + 1] - first
    method_first: layout.method_firsts[wave_module]
    placed := [SemaPreparedBody?]{}
    loop _ in 0..<(top + layout.method_firsts[wave_module + 1] - method_first) -> placed.push(None)
    sema_check_body_wave_place(plan.wave_outs[wave_module], first, top, method_first, placed)
    loop placed.len() > top {
        popped := placed.pop() ?? break
        body := popped.move() ?? next
        bodies.methods.push(body)
    }
    bodies.methods_prepared = true
    loop placed.len() > 0 {
        popped := placed.pop() ?? break
        body := popped.move() ?? next
        bodies.bodies.push(body)
    }
    bodies.move()
}

// Moves a wave module's published bodies into `placed`: its top-level jobs'
// at their position from `first`, then its method jobs' after `top`.
sema_check_body_wave_place: fn(out: Shared<SemaWaveOut>, first: Int, top: Int, method_first: Int, placed: &[SemaPreparedBody?]) {
    held: out.guard_edit()
    loop held.value.bodies.len() > 0 {
        body: held.value.bodies.pop() ?? break
        position: held.value.positions.pop() ?? panic("a checked body has no job position")
        slot: if position >= method_first -> top + position - method_first else -> position - first
        placed[slot] = Val(body)
    }
}

// A done wave module's post-summary scope, moved out of its environment.
sema_check_body_wave_take_scope: fn(cell: Shared<SemaWaveEnvironment>) -> SemaScopeTable {
    held: cell.guard_edit()
    entered := held.value.environments.pop() ?? panic("a body-wave module lost its environment")
    taken := entered.module_scope.move()
    entered.module_scope = None
    taken.move() ?? panic("a body-wave module scope left its environment")
}

// Moves a body wave's job modules, their graph modules and its module
// exchange rows into its plan.
sema_check_body_plan_fill_wave: fn(plan: Shared<SemaBodyPlan>, modules: &&[Int], module_indexes: &&[Int], environments: &&[Shared<SemaWaveEnvironment>], outs: &&[Shared<SemaWaveOut>], left: &&[SemaBodyCount]) {
    permit: plan.guard_edit()
    permit.value.modules = modules.move()
    permit.value.module_indexes = module_indexes.move()
    permit.value.wave_environments = environments.move()
    permit.value.wave_outs = outs.move()
    permit.value.wave_left = left.move()
}

// One thread: makes its light copy of the module scope in its slot, then
// checks the functions it claims on that copy. Host callbacks are withheld;
// a check that wanted one is marked, and the body loop checks that function
// again on the calling thread.
sema_check_body_part: fn(shared: Shared<SemaCheckShared>, slot: Shared<SemaBodyPart>, plan: Shared<SemaBodyPlan>, queue: Shared<SemaBodyQueue>, module_index: Int) -> Int {
    inputs: shared.guard_read()
    sema_check_body_part_copy_scope(inputs.value.environments[0], slot)
    permit := slot.guard_edit()
    // Passed straight through: a local binding of a guarded row would copy it.
    sema_check_body_part_in(inputs.value.environments[0], inputs.value.programs[0], inputs.value.memory_plans[0], permit.value, plan, queue, module_index)
}

sema_host_hook_unwant: fn(wanted: Shared<SemaHostHookWanted>) {
    permit: wanted.guard_edit()
    permit.value.wanted = false
}

sema_host_hook_was_wanted: fn(wanted: Shared<SemaHostHookWanted>) -> Bool {
    permit: wanted.guard_read()
    permit.value.wanted
}

// `environment` carries module-local source facts while `program` retains
// the pass's one graph and checked-type owner. Module retargeting borrows
// that graph in place and only replaces the selected scope facts.
// `comptime_rows` is sema_comptime_checked_function_rows(comptime_functions).
// `pending_obligations`: the bundle failure solve has not settled the failure
// obligations yet (`sema_check_function_failed`).
// `host_hooks` reach the host callbacks for every body check. `prepared` is
// the module's parallel body pass (sema_check_bodies_parallel), or none: its
// post-summary scope replaces the view-summary rounds, and its checked bodies
// stand in for checking the same functions here while they still apply
// (sema_check_module_function).
// Read-only declaration/body thunks close before either owner is moved.
sema_check_registration_module: fn(owned_environment: &&SemaScopeEnvironment, owned_program: &&SemaProgramTables, host_hooks: SemaHostHookAccess?, owned_memory_plan: &&SemaFunctionMemoryPlan, module_index: Int, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], check_bodies: Bool, pending_obligations: Bool, prepared: &&SemaPreparedBodies, scheduling: SemaMethodScheduling?, session: SemaIncrementalCache?, counter_phase: String, trace_sink: CompilerTraceSink?) -> SemaOwnedModuleCheck {
    environment := owned_environment.move()
    program := owned_program.move()
    memory_plan := owned_memory_plan.move()
    threads := CompilerThreads?{None}
    if scheduling == .Val(schedule) -> threads = Val(schedule.threads)
    run := sema_check_registration_module_head(environment, program, host_hooks, memory_plan, module_index, values, comptime_functions, comptime_rows, check_bodies, pending_obligations, prepared, threads, session, counter_phase, trace_sink)
    if run.wave_workers > 1 {
        if scheduling == .Val(schedule) {
            // All metadata read windows have ended before either owner
            // moves into its existing shared slot. Recover after every join.
            method_queries := sema_incremental_registered_job_queries(run.memo, module_index, memory_plan, run.wave_jobs, environment, program)
            lent := run.scopes.move()
            run.scopes = sema_scope_init("")
            sema_check_shared_fill(schedule.shared_state, environment, program, memory_plan)
            run.method_ready = sema_check_bodies_parallel(schedule.shared_state, module_index, lent, run.wave_jobs, run.wave_weights, run.wave_workers, run.memo, method_queries)
            environment = sema_check_shared_take_environment(schedule.shared_state)
            program = sema_check_shared_take_program(schedule.shared_state)
            memory_plan = sema_check_shared_take_memory_plan(schedule.shared_state)
            run.scopes = run.method_ready.scopes.pop() ?? panic("the method wave lost its module scope")
        }
    }
    module_result := sema_check_registration_module_tail(run, environment, program, host_hooks, memory_plan, module_index, comptime_functions, comptime_rows, pending_obligations, counter_phase, trace_sink)
    SemaOwnedModuleCheck{module_result: module_result.move(), environment: environment.move(), program: program.move(), memory_plan: memory_plan.move()}
}

// sema_check_registration_module on a body wave's lead thread
// (sema_check_body_wave_lead): the program tables and memory plan stay with
// the wave's threads and are read in place, so the module starts no method
// wave of its own; a method body the wave did not check is checked here.
sema_check_registration_module_lent: fn(environment: &SemaScopeEnvironment, program: SemaProgramTables, host_hooks: SemaHostHookAccess?, memory_plan: SemaFunctionMemoryPlan, module_index: Int, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], pending_obligations: Bool, prepared: &&SemaPreparedBodies, counter_phase: String, trace_sink: CompilerTraceSink?) -> SemaGraphModuleResult {
    run := sema_check_registration_module_head(environment, program, host_hooks, memory_plan, module_index, values, comptime_functions, comptime_rows, true, pending_obligations, prepared, None, None, counter_phase, trace_sink)
    sema_check_registration_module_tail(run, environment, program, host_hooks, memory_plan, module_index, comptime_functions, comptime_rows, pending_obligations, counter_phase, trace_sink)
}

// A module check between its top-level bodies and its method bodies: what
// the method half (sema_check_registration_module_tail) reads. `wave_jobs`
// are the parallel method jobs the head admitted `wave_workers` threads for
// (none, and one worker, when it admitted no method wave).
SemaModuleCheckRun: struct {
    module_result: SemaGraphModuleResult
    scopes: SemaScopeTable
    memo: SemaModuleMemo?
    method_ready: SemaPreparedBodies
    all_method_jobs: [SemaBodyJob]
    prelude_demands: [Int:[SemaPreludeConversionDemand]]
    module_identity: String
    keep_going: Bool
    check_bodies: Bool
    count_work: Bool
    items_scanned: Int
    functions_checked: Int
    impl_rows_scanned: Int
    wave_jobs: [SemaBodyJob]
    wave_weights: [Int]
    wave_workers: Int
}

// The module check's declarations and top-level bodies, and the method
// jobs of its method half. With `threads` it admits a method wave for the
// parallel method jobs the body wave did not check.
sema_check_registration_module_head: fn(environment: &SemaScopeEnvironment, program: SemaProgramTables, host_hooks: SemaHostHookAccess?, memory_plan: SemaFunctionMemoryPlan, module_index: Int, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], check_bodies: Bool, pending_obligations: Bool, prepared: &&SemaPreparedBodies, threads: CompilerThreads?, session: SemaIncrementalCache?, counter_phase: String, trace_sink: CompilerTraceSink?) -> SemaModuleCheckRun {
    ready := prepared.move()
    memo := ready.memo.move()
    ready.memo = None
    queries := ready.queries.move()
    ready.queries = [Int:SemaBodyMemoQuery]{}
    module_identity: sema_check_registered_module_identity(environment, program, module_index)
    keep_going: sema_check_registered_keep_going(environment, program)
    item_count: sema_check_registered_module_item_count(environment, program, module_index)
    scopes := sema_scope_init(module_identity)
    count_work: if trace_sink == .Val(_) -> true else -> false
    items_scanned := 0
    started := ready.started.move()
    ready.started = None
    precomputed: started != None
    // The view summary jobs the declaration check found ahead, if any.
    view_jobs: if started == .Val(check) -> check.view_summary_jobs.copy() else -> [Int]?{None}
    module_result := sema_check_registration_module_started(environment, program, module_index, values, started, scopes, count_work, items_scanned)
    // The original declaration/header boundary: do not substitute the probe
    // reset, which deliberately clears real else-arm/debug-site source facts.
    // copy: a handle copy (Shared facts plus length and frontier ints): the module's context reads
    // a frozen prefix while environment.comptime_body_publication keeps advancing.
    body_values := environment.comptime_body_publication.copy()
    sema_scope_environment_enter_module(environment, program, module_index, body_values)
    functions_checked := 0
    if count_work {
        loop prepared_body in ready.bodies {
            if prepared_body == {
                .Checked(_) -> functions_checked += 1
                .Replay(_) -> {}
            }
        }
    }
    impl_rows_scanned := 0
    all_method_jobs := [SemaBodyJob]{}
    method_ready := sema_check_prepared_none()
    // The prelude conversion demands of each body a compiler thread
    // walked, by its position in module_result.functions.
    prelude_demands := [Int:[SemaPreludeConversionDemand]]{}
    wave_jobs := [SemaBodyJob]{}
    wave_weights := [Int]{}
    wave_workers := 1
    if check_bodies {
        if ready.scopes.len() > 0 {
            scopes = ready.scopes.pop() ?? sema_scope_init(module_identity)
        } else {
            if precomputed -> sema_check_registration_module_scopes(program, module_index, scopes)
            sema_check_view_summaries(environment, program, scopes, module_index, host_hooks, memory_plan, comptime_functions, comptime_rows, view_jobs, counter_phase, trace_sink)
        }
        // The static-product markers bind their signatures in module scope.
        sema_marker_rules_check_static_sites(environment, program, module_index, scopes, module_result.diagnostics)
        // A distinct type's forwarded traits must exist on its base.
        sema_derive_check_distinct_forwards(environment, program, module_index, module_result.diagnostics)
        if memo == None -> memo = sema_incremental_module(session, environment, program, scopes)
        scopes_changed := false
        return_view_rows := [String:Int]{}
        trace_functions := false
        if trace_sink == .Val(sink) -> trace_functions = sink.functions()
        item_index := 0
        loop item_index < item_count {
            if count_work -> items_scanned += 1
            // The trace throttles progress by time, and each report reads the
            // clock and thread id from /proc: report every 64th item and the last.
            if item_index %% SEMA_CHECK_PROGRESS_STRIDE == 0 || item_index + 1 == item_count {
                if trace_sink == .Val(sink) -> sink.progress("sema.bodies", item_index, item_count)
            }
            if sema_check_registered_item_is_jet_function(environment, program, module_index, item_index) {
                if !sema_check_registered_item_deferred(environment, program, module_index, item_index) -> sema_check_registration_top_level(module_index, item_index, memory_plan, environment, program, scopes, return_view_rows, ready.bodies, queries, memo, host_hooks, comptime_functions, comptime_rows, module_result, prelude_demands, scopes_changed, keep_going, pending_obligations, trace_functions, trace_sink, item_count, count_work, functions_checked)
            } else {
                sema_check_registration_module_test(environment, program, module_index, item_index, scopes, host_hooks, module_result)
            }
            item_index += 1
        }
        all_method_jobs = sema_check_registered_method_jobs(environment, program, module_index, impl_rows_scanned, count_work)
        if ready.methods_prepared && !scopes_changed {
            // The body wave checked the module's parallel method jobs against
            // the post-summary scope, which the top-level checks left as it was.
            method_ready.bodies = ready.methods.move()
            ready.methods = [SemaPreparedBody]{}
        } else if threads == .Val(pool) {
            weights := [Int]{}
            jobs := sema_check_registered_parallel_method_jobs(environment, program, module_index, memory_plan, all_method_jobs, comptime_rows, weights)
            work := 0
            loop weight in weights -> work += weight
            workers := 1
            if !trace_functions -> workers = compiler_threads_admit(pool, jobs.len(), work, SEMA_BODY_MIN_BYTES_PER_THREAD, scopes.bindings.len() * SEMA_BODY_SCOPE_BYTES_PER_BINDING, 0)
            if workers > 1 {
                wave_jobs = jobs.move()
                wave_weights = weights.move()
                wave_workers = workers
            }
        }
    }
    SemaModuleCheckRun{
        module_result: module_result.move(), scopes: scopes.move(), memo: memo.move(), method_ready: method_ready.move(),
        all_method_jobs: all_method_jobs.move(), prelude_demands: prelude_demands.move(),
        module_identity: module_identity, keep_going: keep_going, check_bodies: check_bodies,
        count_work: count_work, items_scanned: items_scanned, functions_checked: functions_checked,
        impl_rows_scanned: impl_rows_scanned, wave_jobs: wave_jobs.move(), wave_weights: wave_weights.move(),
        wave_workers: wave_workers,
    }
}

// The module check's method bodies, its prelude error conversions and its
// foreign items, after sema_check_registration_module_head.
sema_check_registration_module_tail: fn(owned_run: &&SemaModuleCheckRun, environment: &SemaScopeEnvironment, program: SemaProgramTables, host_hooks: SemaHostHookAccess?, memory_plan: SemaFunctionMemoryPlan, module_index: Int, comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], pending_obligations: Bool, counter_phase: String, trace_sink: CompilerTraceSink?) -> SemaGraphModuleResult {
    run := owned_run.move()
    module_result := run.module_result.move()
    scopes := run.scopes.move()
    memo := run.memo.move()
    method_ready := run.method_ready.move()
    all_method_jobs := run.all_method_jobs.move()
    prelude_demands := run.prelude_demands.move()
    method_jobs := 0
    // The rows of the name references and call facts that generated bodies
    // record: a derived method keeps its template's spans and an injected
    // conversion its Prelude text's, so neither indexes this module's source.
    generated_references := [Span]{}
    generated_calls := [Span]{}
    if run.check_bodies {
        loop job in all_method_jobs {
            if run.count_work -> method_jobs += 1
            generated: sema_check_generated_method_author_span(job, module_index, environment, program) != None || sema_check_generated_codec_method(job, module_index, program)
            references_from: module_result.name_references.len()
            calls_from: module_result.call_facts.len()
            if !sema_check_apply_method_job(module_index, memory_plan, job, method_ready.bodies, method_ready.queries, memo, scopes, environment, program, host_hooks, comptime_functions, comptime_rows, module_result.diagnostics, module_result.functions, prelude_demands, module_result.call_facts, module_result.hardware_use, module_result.comptime_requests, module_result.name_references, module_result.comptime_body_sources, module_result.compute_facts, module_result.failure_facts, module_result.exact_int_reachable, module_result.copy_events, module_result.incomplete_reasons, run.keep_going, pending_obligations) -> module_result.complete = false
            if generated {
                generated_references.push(Span{start: references_from, end: module_result.name_references.len()})
                generated_calls.push(Span{start: calls_from, end: module_result.call_facts.len()})
            }
        }
        injected_from := module_result.functions.len()
        references_from: module_result.name_references.len()
        calls_from: module_result.call_facts.len()
        if !sema_inject_prelude_error_conversions(run.module_identity, environment, program, scopes, host_hooks, module_result.functions, prelude_demands, module_result.diagnostics, module_result.call_facts, module_result.comptime_requests, module_result.name_references, module_result.incomplete_reasons, run.keep_going) -> module_result.complete = false
        generated_references.push(Span{start: references_from, end: module_result.name_references.len()})
        generated_calls.push(Span{start: calls_from, end: module_result.call_facts.len()})
        loop index in injected_from..<module_result.functions.len() -> module_result.injected_function_keys.push(module_result.functions[index].key)
        sema_check_record_unusable_bodies(program, module_index, module_result)
    }
    sema_check_registration_module_foreign(environment, program, module_index, module_result)
    sema_check_soft_public_uses(program, module_index, generated_references, generated_calls, module_result)
    if trace_sink == .Val(sink) {
        sink.progress("counters.{counter_phase}.items_scanned", run.items_scanned, -1)
        sink.progress("counters.{counter_phase}.functions_checked", run.functions_checked, -1)
        sink.progress("counters.{counter_phase}.method_jobs", method_jobs, -1)
        sink.progress("counters.{counter_phase}.impl_rows_scanned", run.impl_rows_scanned, -1)
    }
    module_result.move()
}

// A `pub _name` is soft-public: a use outside its declaring module is
// allowed with one warning per occurrence (L0601), on the spelling the use
// site writes, so a re-export under a plain name does not warn and one
// under an underscore name does. Core's own modules are vetted internals.
// Only module `module_index`'s own text is read: the rows in
// `generated_references` and `generated_calls` (sorted, disjoint row ranges)
// carry spans into other text and are skipped.
sema_check_soft_public_uses: fn(program: SemaProgramTables, module_index: Int, generated_references: [Span], generated_calls: [Span], module_result: &SemaGraphModuleResult) {
    if program.registration_graph == .Val(graph) {
        module_identity: graph.modules[module_index].module_identity
        if module_identity.starts_with("<corelib>") -> return
        raw: graph.modules[module_index].source.bytes()
        codes: loop byte in raw -> Int.from_u8(byte)
        seen := [Int:Bool]{}
        skipped := 0
        loop (index, reference) in module_result.name_references {
            loop skipped < generated_references.len() && generated_references[skipped].end <= index -> skipped += 1
            if skipped < generated_references.len() && index >= generated_references[skipped].start -> next
            owner: reference.symbol.module_name
            if owner == "" || owner == module_identity -> next
            leaf: sema_soft_public_written_leaf(raw, codes, reference.span) ?? next
            sema_soft_public_warn(leaf, seen, module_result.diagnostics)
        }
        // A call's callee is a call fact, not a name reference.
        skipped = 0
        loop (index, call) in module_result.call_facts {
            loop skipped < generated_calls.len() && generated_calls[skipped].end <= index -> skipped += 1
            if skipped < generated_calls.len() && index >= generated_calls[skipped].start -> next
            callee: call.callee ?? next
            owner_and_rest: callee.key.split_once(":") ?? next
            module_and_rest: owner_and_rest.after.split_once(":") ?? next
            owner: module_and_rest.before
            if owner == "" || owner == module_identity -> next
            leaf: sema_soft_public_written_leaf(raw, codes, call.span) ?? next
            sema_soft_public_warn(leaf, seen, module_result.diagnostics)
        }
        sema_check_soft_public_signatures(graph.modules[module_index], codes, raw, seen, module_result.diagnostics)
    }
}

sema_soft_public_warn: fn(leaf: (start: Int, name: String), seen: &[Int:Bool], diagnostics: &[Diagnostic]) {
    if classify_identifier(leaf.name) != IdentifierClass.SoftPublic || seen.has_key(leaf.start) -> return
    seen[leaf.start] = true
    diagnostics.push(sema_lint("L0601", Span{start: leaf.start, end: leaf.start + leaf.name.count_bytes()}, "`{leaf.name}` is a soft-public API", "A leading underscore allows outside use but carries no compatibility promise across minor releases.", "Use a public name without a leading underscore when callers need a stable API."))
}

// The soft-public type names one module's signatures write: in a parameter
// or return type, or a generic bound. A qualified `alias._Cell` is always
// outside; an unqualified `_Shape` is outside unless the module declares it
// (a local declaration wins over an imported one) or the function's own
// type parameters name it.
sema_check_soft_public_signatures: fn(source_module: SemaRegistrationModule, codes: [Int], raw: [U8], seen: &[Int:Bool], diagnostics: &[Diagnostic]) {
    loop item in source_module.declarations {
        if item == {
            .Func(function) -> sema_check_soft_public_signature(function, source_module.declaration_positions, codes, raw, seen, diagnostics)
            .Impl(implementation) -> loop method in implementation.methods -> sema_check_soft_public_signature(method, source_module.declaration_positions, codes, raw, seen, diagnostics)
            .Struct(definition) -> loop method in definition.methods -> sema_check_soft_public_signature(method, source_module.declaration_positions, codes, raw, seen, diagnostics)
            .Enum(definition) -> loop method in definition.methods -> sema_check_soft_public_signature(method, source_module.declaration_positions, codes, raw, seen, diagnostics)
            .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

sema_check_soft_public_signature: fn(function: Func, declared: [String:Int], codes: [Int], raw: [U8], seen: &[Int:Bool], diagnostics: &[Diagnostic]) {
    if function.compiler_generated -> return
    local := [String]{}
    loop parameter in function.type_params -> local.push(parameter.name)
    ranges := [Span]{}
    loop parameter in function.params -> ranges.push(parameter.ty_span)
    if function.return_type_span == .Val(span) -> ranges.push(span.copy())
    // A bound runs from the parameter's name to its `,`, `>` or default `=`.
    loop parameter in function.type_params {
        end := parameter.name_span.end
        loop end < codes.len() && codes[end] != 44 && codes[end] != 62 && codes[end] != 61 -> end += 1
        ranges.push(Span{start: parameter.name_span.end, end: end})
    }
    loop range in ranges {
        at := if range.start < 0 -> 0 else -> range.start
        limit: if range.end > codes.len() -> codes.len() else -> range.end
        loop at < limit {
            if codes[at] != 95 || (at > 0 && sema_soft_public_word_byte(codes[at - 1])) {
                at += 1
                next
            }
            start: at
            loop at < limit && sema_soft_public_word_byte(codes[at]) -> at += 1
            name: String.from_bytes(raw[start..<at]) ?? next
            qualified: start > 0 && codes[start - 1] == 46
            if !qualified && (declared.has_key(name) || local.contains(name)) -> next
            sema_soft_public_warn((start: start, name: name), seen, diagnostics)
        }
    }
}

// The name a use site writes, with its byte offset in the source: the last
// identifier of the span (`n._title` gives `_title`). A span over a whole
// call names the identifier just before the argument list that its last
// `)` closes (type arguments skipped). A written name is a whole token of
// the source, so a span that cuts an identifier is no use site of this text
// (a span another source owns) and names nothing.
sema_soft_public_written_leaf: fn(raw: [U8], codes: [Int], span: Span) -> (start: Int, name: String)? Never! {
    if span.start < 0 || span.end > codes.len() || span.start >= span.end -> return None
    end := span.end
    loop end > span.start && (codes[end - 1] == 32 || codes[end - 1] == 10) -> end -= 1
    if end > span.start && codes[end - 1] == 41 {
        index := end - 1
        depth := 0
        loop index >= span.start {
            if codes[index] == 41 -> depth += 1
            if codes[index] == 40 {
                depth -= 1
                if depth == 0 -> break
            }
            index -= 1
        }
        if index <= span.start -> return None
        end = index
    }
    if end > span.start && codes[end - 1] == 62 {
        angle := 0
        loop end > span.start {
            end -= 1
            if codes[end] == 62 -> angle += 1
            if codes[end] == 60 {
                angle -= 1
                if angle == 0 -> break
            }
        }
    }
    start := end
    loop start > span.start && sema_soft_public_word_byte(codes[start - 1]) -> start -= 1
    if start == end -> return None
    if (start > 0 && sema_soft_public_word_byte(codes[start - 1])) || (end < codes.len() && sema_soft_public_word_byte(codes[end])) -> return None
    name: String.from_bytes(raw[start..<end]) ?? return None
    Val((start: start, name: name))
}

sema_soft_public_word_byte: fn(byte: Int) -> Bool Never! {
    byte == 95 || (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
}

// Whether this compile refuses what no `jet` has built yet (the "not built
// yet" E2104). The refusal keeps an unported runtime out of the IR, and
// `jet check` lowers nothing, so only build, run and test refuse.
sema_refuses_unbuilt: fn(program: SemaProgramTables) -> Bool Never! {
    if program.registration_graph == .Val(graph) -> return !graph.check_tests
    true
}

// sema_check_registration_module reports `sema.bodies` progress every this
// many items (and at the last).
SEMA_CHECK_PROGRESS_STRIDE: 64

SemaNameResolvedDeclaration: struct {
    symbol: Symbol
    kind: String
}

sema_name_visibility: fn(value: Int) -> NameVisibility Never! {
    if value >= 2 -> return NameVisibility.Public
    if value == 1 -> return NameVisibility.Package
    NameVisibility.Private
}

// Name facts keep the first row per identity. Rows are appended as found and
// `sema_name_build_facts_threads` drops later duplicates once, in one indexed pass;
// a reference that repeats an added one is dropped before it is formatted
// (SemaNameReferenceFilter).
sema_name_add_declaration: fn(facts: &NameFacts, module_index: Int, name: String, path: String, kind: String, span: Span, visibility: NameVisibility) Never! {
    facts.declarations.push(NameDeclaration{module_index: module_index, name: name, path: path, kind: kind, span: span, visibility: visibility})
}

// The references sema_name_build_facts_threads has added so far. A reference row is
// made from its symbol's graph module, owner key, name and definition span
// and its kind alone, so `seen` keys each added reference by those (the
// strings interned in `parts`): a reference whose key is seen repeats an
// earlier row exactly and would be dropped by sema_name_first_references, so
// it is dropped before its owner and semantic identity are formatted.
// `called[row]` marks the symbol-index declarations a call fact has added.
SemaNameReferenceFilter: struct {
    parts: NameTable
    seen: SemaNameReferenceKeys
    called: [Bool]
}

sema_name_add_reference: fn(facts: &NameFacts, filter: &SemaNameReferenceFilter, graph: SemaRegistrationGraph, owner_names: [String:String], module_indices: &[String:Int], span: Span, symbol: Symbol, kind: String) Never! {
    module_index: sema_registration_cached_module_index(graph, symbol.module_name, module_indices) ?? return
    owner_key: symbol.owner ?? ""
    kind_part: name_index(name_intern(filter.parts, kind))
    owner_part: name_index(name_intern(filter.parts, owner_key))
    name_part: name_index(name_intern(filter.parts, symbol.name))
    if sema_name_reference_seen(filter.seen, module_index, kind_part, symbol.span.start, symbol.span.end, owner_part, name_part) -> return
    source_module: graph.modules[module_index]
    declaration_name := symbol.name
    if owner_key != "" {
        owner_name: owner_names.get(sema_name_owner_index_key(module_index, owner_key))
        if owner_name == .Val(name) -> declaration_name = "{name}.{symbol.name}"
    }
    semantic_identity := String?{None}
    if kind != "local" && kind != "param" {
        word: if {
            kind == "function" && owner_key != "" -> "method"
            kind == "function" -> "fn"
            kind == "import_alias" -> "import"
            else -> kind
        }
        semantic_identity = Val("{word}:{source_module.module_name}.{declaration_name}")
    }
    facts.references.push(NameReference{module_path: source_module.module_path, kind: kind, def_span: symbol.span, semantic_identity: semantic_identity})
}

sema_name_owner_index_key: fn(module_index: Int, owner_key: String) -> String Never! {
    "{module_index}|{owner_key}"
}

// The display name of every member owner, keyed by module and owner symbol.
// A later impl of the same owner key replaces an earlier row, as the ordered
// nominal-then-impl search did.
sema_name_owner_index: fn(graph: SemaRegistrationGraph) -> [String:String] Never! {
    names := [String:String]{}
    module_index := 0
    loop module_index < graph.modules.len() {
        graph_module: graph.modules[module_index]
        loop nominal in graph_module.nominals -> names[sema_name_owner_index_key(module_index, nominal.symbol.id.key)] = nominal.symbol.name
        loop implementation in graph_module.impls -> names[sema_name_owner_index_key(module_index, implementation.symbol.id.key)] = implementation.target_type_name
        module_index += 1
    }
    names
}

// The declarations a call fact can name: `keys` maps each symbol ID to its
// declaration row (an open-addressing hash over the key's `s.hash()`, so
// indexing never shifts a sorted entry list or copies a key's bytes).
SemaNameSymbolIndex: struct {
    keys: NameRows
    declarations: [SemaNameResolvedDeclaration]
}

sema_name_index_symbol: fn(index: &SemaNameSymbolIndex, symbol: Symbol, kind: String) Never! {
    if name_rows_get_text(index.keys, symbol.id.key) != None -> return
    name_rows_set(index.keys, symbol.id.key, index.declarations.len())
    index.declarations.push(SemaNameResolvedDeclaration{symbol: symbol, kind: kind})
}

// The declaration row of `key`, or -1.
sema_name_symbol_row: fn(index: SemaNameSymbolIndex, key: String) -> Int Never! {
    row: name_rows_get_text(index.keys, key) ?? return -1
    row
}

// Whether `name` is new among module `module_index`'s rows, recording it in
// `seen` (one map per module index, grown on demand): the first row of a
// module and name is kept and every later one dropped, as a seen map of
// `module|name` keys did, without formatting a key per row.
sema_name_first_in_module: fn(seen: &[NameRows], module_index: Int, name: String) -> Bool Never! {
    loop seen.len() <= module_index -> seen.push(name_rows())
    if name_rows_get_text(seen[module_index], name) != None -> return false
    name_rows_set(seen[module_index], name, 0)
    true
}

// Every declaration a call fact can name, keyed by symbol ID. The first
// declaration in graph order wins, as the ordered search did.
sema_name_symbol_index: fn(graph: SemaRegistrationGraph) -> SemaNameSymbolIndex Never! {
    index := SemaNameSymbolIndex{keys: name_rows(), declarations: [SemaNameResolvedDeclaration]{}}
    loop graph_module_index in 0..<graph.modules.len() {
        loop symbol_index in 0..<graph.modules[graph_module_index].symbols.len() {
            sema_name_index_symbol(index, graph.modules[graph_module_index].symbols[symbol_index], if {
                graph.modules[graph_module_index].symbols[symbol_index].kind == SymbolKind.Constant -> "const"
                graph.modules[graph_module_index].symbols[symbol_index].kind == SymbolKind.Function -> "function"
                else -> "semantic"
            })
        }
        loop nominal_index in 0..<graph.modules[graph_module_index].nominals.len() {
            loop field_index in 0..<graph.modules[graph_module_index].nominals[nominal_index].fields.len() -> sema_name_index_symbol(index, graph.modules[graph_module_index].nominals[nominal_index].fields[field_index].symbol, "field")
            loop variant_index in 0..<graph.modules[graph_module_index].nominals[nominal_index].variants.len() -> sema_name_index_symbol(index, graph.modules[graph_module_index].nominals[nominal_index].variants[variant_index].symbol, "variant")
            loop function_index in 0..<graph.modules[graph_module_index].nominals[nominal_index].methods.len() -> sema_name_index_symbol(index, graph.modules[graph_module_index].nominals[nominal_index].methods[function_index].symbol, "method")
            loop method_index in 0..<graph.modules[graph_module_index].nominals[nominal_index].trait_methods.len() -> sema_name_index_symbol(index, graph.modules[graph_module_index].nominals[nominal_index].trait_methods[method_index].symbol, "method")
        }
        loop implementation_index in 0..<graph.modules[graph_module_index].impls.len() {
            loop function_index in 0..<graph.modules[graph_module_index].impls[implementation_index].methods.len() -> sema_name_index_symbol(index, graph.modules[graph_module_index].impls[implementation_index].methods[function_index].symbol, "method")
            loop associated_index in 0..<graph.modules[graph_module_index].impls[implementation_index].associated_types.len() -> sema_name_index_symbol(index, graph.modules[graph_module_index].impls[implementation_index].associated_types[associated_index].symbol, "associated_type")
        }
    }
    index
}

sema_name_first_declarations: fn(rows: &&[NameDeclaration]) -> [NameDeclaration] Never! {
    owned_rows := rows.move()
    seen := [NameRows]{}
    kept := [NameDeclaration]{}
    owned_rows.reverse()
    loop owned_rows.len() > 0 {
        row := owned_rows.pop() ?? break
        if !sema_name_first_in_module(seen, row.module_index, row.name) -> next
        kept.push(row)
    }
    kept
}

sema_name_first_aliases: fn(rows: &&[NameAlias]) -> [NameAlias] Never! {
    owned_rows := rows.move()
    seen := [NameRows]{}
    kept := [NameAlias]{}
    owned_rows.reverse()
    loop owned_rows.len() > 0 {
        row := owned_rows.pop() ?? break
        if !sema_name_first_in_module(seen, row.module_index, row.name) -> next
        kept.push(row)
    }
    kept
}

// The keys of the reference rows seen so far: six Int parts per key (for
// sema_name_first_references the interned ids of a row's module path and
// kind, its definition span, its semantic identity's id plus one (0 for
// none) and 0; for SemaNameReferenceFilter the graph module, the kind's id,
// the definition span and the owner key's and name's ids), in an
// open-addressing hash over parallel columns, so a row is deduplicated
// without formatting and interning one String per row.
SemaNameReferenceKeys: struct {
    path: [Int]
    kind: [Int]
    start: [Int]
    end: [Int]
    identity: [Int]
    member: [Int]
    // 0 is empty, otherwise the key's row plus one.
    slots: [Int]
    mask: Int
}

SEMA_NAME_REFERENCE_KEYS_INITIAL_SLOTS: 1024

sema_name_reference_keys: fn() -> SemaNameReferenceKeys Never! {
    slots := [Int]{}
    loop _ in 0..<SEMA_NAME_REFERENCE_KEYS_INITIAL_SLOTS -> slots.push(0)
    SemaNameReferenceKeys{path: [Int]{}, kind: [Int]{}, start: [Int]{}, end: [Int]{}, identity: [Int]{}, member: [Int]{}, slots: slots, mask: SEMA_NAME_REFERENCE_KEYS_INITIAL_SLOTS - 1}
}

// Only the hash reads a part's magnitude: equality compares the parts
// themselves, so a negative span bound folds onto its positive twin's slot.
sema_name_reference_hash_mix: fn(hash: U64, part: Int) -> U64 Never! {
    magnitude: if part < 0 -> 0 - part else -> part
    (hash.bit_xor(U64{magnitude})).wrapping_mul(U64{0x100000001b3})
}

// FNV-1a over the six key parts, as a slot index under `mask`.
sema_name_reference_slot: fn(mask: Int, path: Int, kind: Int, start: Int, end: Int, identity: Int, member: Int) -> Int Never! {
    hash := U64{0x811c9dc5}
    hash = sema_name_reference_hash_mix(hash, path)
    hash = sema_name_reference_hash_mix(hash, kind)
    hash = sema_name_reference_hash_mix(hash, start)
    hash = sema_name_reference_hash_mix(hash, end)
    hash = sema_name_reference_hash_mix(hash, identity)
    hash = sema_name_reference_hash_mix(hash, member)
    Int.from_u64(hash.bit_and(U64{mask}))
}

sema_name_reference_keys_grow: fn(keys: &SemaNameReferenceKeys) Never! {
    capacity: (keys.mask + 1) * 2
    mask: capacity - 1
    slots := [Int]{}
    loop _ in 0..<capacity -> slots.push(0)
    loop row in 0..<keys.path.len() {
        slot := sema_name_reference_slot(mask, keys.path[row], keys.kind[row], keys.start[row], keys.end[row], keys.identity[row], keys.member[row])
        loop slots[slot] != 0 -> slot = (slot + 1).bit_and(mask)
        slots[slot] = row + 1
    }
    keys.slots = slots.move()
    keys.mask = mask
}

// Whether the key is already in `keys`, recording it when it is new.
sema_name_reference_seen: fn(keys: &SemaNameReferenceKeys, path: Int, kind: Int, start: Int, end: Int, identity: Int, member: Int) -> Bool Never! {
    slot := sema_name_reference_slot(keys.mask, path, kind, start, end, identity, member)
    loop keys.slots[slot] != 0 {
        row: keys.slots[slot] - 1
        if keys.path[row] == path && keys.kind[row] == kind && keys.start[row] == start && keys.end[row] == end && keys.identity[row] == identity && keys.member[row] == member -> return true
        slot = (slot + 1).bit_and(keys.mask)
    }
    row: keys.path.len()
    keys.path.push(path)
    keys.kind.push(kind)
    keys.start.push(start)
    keys.end.push(end)
    keys.identity.push(identity)
    keys.member.push(member)
    keys.slots[slot] = row + 1
    if (row + 1) * 2 > keys.mask -> sema_name_reference_keys_grow(keys)
    false
}

// The first row per key, in order. A row's key is its module path, kind,
// definition span and semantic identity (present or not): the strings are
// interned in one table, so two rows have the same key exactly when their
// ids, span bounds and identity ids agree.
sema_name_first_references: fn(rows: [NameReference]) -> [NameReference] Never! {
    parts := name_table()
    seen := sema_name_reference_keys()
    kept := [NameReference]{}
    // A module's rows are contiguous and the kinds are few, so the current
    // path and each kind keep their part ids; only identities are interned
    // row by row.
    path_text := ""
    path := -1
    kinds := [String:Int]{}
    loop row in rows {
        identity: if row.semantic_identity == {
            .Val(value) -> name_index(name_intern(parts, value)) + 1
            .None -> 0
        }
        if path < 0 || row.module_path != path_text {
            path = name_index(name_intern(parts, row.module_path))
            // copy: the row stays in `rows`; the current path outlives it.
            path_text = row.module_path.copy()
        }
        kind := kinds.get(row.kind) ?? -1
        if kind < 0 {
            kind = name_index(name_intern(parts, row.kind))
            kinds[row.kind] = kind
        }
        if sema_name_reference_seen(seen, path, kind, row.def_span.start, row.def_span.end, identity, 0) -> next
        kept.push(row.copy())
    }
    kept
}

sema_name_visibility_flags: fn(is_pub: Bool, is_package_pub: Bool) -> NameVisibility Never! {
    if is_pub -> return NameVisibility.Public
    if is_package_pub -> return NameVisibility.Package
    NameVisibility.Private
}

sema_name_scoped: fn(prefix: String, name: String) -> String Never! {
    if prefix == "" -> return name.copy()
    "{prefix}.{name}"
}

sema_name_scoped_path: fn(prefix: String, name: String) -> String Never! {
    "{prefix}.{name}"
}

sema_name_add_method: fn(facts: &NameFacts, module_index: Int, owner_name: String, owner_path: String, function: Func) Never! {
    name := sema_name_scoped(owner_name, function.name)
    path := sema_name_scoped_path(owner_path, function.name)
    visibility := sema_name_visibility_flags(function.is_pub, function.is_package_pub)
    sema_name_add_declaration(facts, module_index, name, path, "method", function.name_span, visibility)
}

sema_name_add_item: fn(facts: &NameFacts, module_index: Int, module_path: String, prefix: String, item: Item) Never! {
    if item == {
        .Func(function) -> {
            name := sema_name_scoped(prefix, function.name)
            path := sema_name_scoped_path(module_path, function.name)
            visibility := sema_name_visibility_flags(function.is_pub, function.is_package_pub)
            sema_name_add_declaration(facts, module_index, name, path, "function", function.name_span, visibility)
        }
        .Struct(definition) -> {
            name := sema_name_scoped(prefix, definition.name)
            path := sema_name_scoped_path(module_path, definition.name)
            visibility := sema_name_visibility_flags(definition.is_pub, definition.is_package_pub)
            sema_name_add_declaration(facts, module_index, name, path, "type", definition.name_span, visibility)
            loop field in definition.fields {
                sema_name_add_declaration(facts, module_index, "{name}.{field.name}", "{path}.{field.name}", "field", field.name_span, sema_name_visibility_flags(field.is_pub, field.is_package_pub))
            }
            if definition.state != None {
                state: definition.state ?? StateDecl{is_pub: false, is_package_pub: false, type_name: "", type_name_span: definition.name_span, states: [NamedSpan]{}, span: definition.span}
                state_visibility := sema_name_visibility_flags(state.is_pub, state.is_package_pub)
                loop value in state.states -> sema_name_add_declaration(facts, module_index, "{name}.State.{value.name}", "{path}.State.{value.name}", "state", value.span, state_visibility)
            }
            loop method in definition.methods -> sema_name_add_method(facts, module_index, name, path, method)
            loop block in definition.trait_impls {
                loop method in block.methods -> sema_name_add_method(facts, module_index, name, path, method)
            }
        }
        .Enum(definition) -> {
            name := sema_name_scoped(prefix, definition.name)
            path := sema_name_scoped_path(module_path, definition.name)
            visibility := sema_name_visibility_flags(definition.is_pub, definition.is_package_pub)
            sema_name_add_declaration(facts, module_index, name, path, "type", definition.name_span, visibility)
            loop variant in definition.variants -> sema_name_add_declaration(facts, module_index, "{name}.{variant.name}", "{path}.{variant.name}", "variant", variant.name_span, visibility)
            loop method in definition.methods -> sema_name_add_method(facts, module_index, name, path, method)
            loop block in definition.trait_impls {
                loop method in block.methods -> sema_name_add_method(facts, module_index, name, path, method)
            }
        }
        .Distinct(definition) -> {
            name := sema_name_scoped(prefix, definition.name)
            path := sema_name_scoped_path(module_path, definition.name)
            sema_name_add_declaration(facts, module_index, name, path, "type", definition.name_span, sema_name_visibility_flags(definition.is_pub, definition.is_package_pub))
        }
        .TypeAlias(definition) -> {
            name := sema_name_scoped(prefix, definition.name)
            path := sema_name_scoped_path(module_path, definition.name)
            sema_name_add_declaration(facts, module_index, name, path, "type", definition.name_span, sema_name_visibility_flags(definition.is_pub, definition.is_package_pub))
        }
        .UnitFamily(_) -> {}
        .Trait(definition) -> {
            name := sema_name_scoped(prefix, definition.name)
            path := sema_name_scoped_path(module_path, definition.name)
            visibility := sema_name_visibility_flags(definition.is_pub, definition.is_package_pub)
            sema_name_add_declaration(facts, module_index, name, path, "trait", definition.name_span, visibility)
            loop method in definition.methods -> sema_name_add_declaration(facts, module_index, "{name}.{method.name}", "{path}.{method.name}", "method", method.name_span, visibility)
        }
        .Tag(definition) -> {
            name := sema_name_scoped(prefix, definition.name)
            path := sema_name_scoped_path(module_path, definition.name)
            sema_name_add_declaration(facts, module_index, name, path, "tag", definition.name_span, sema_name_visibility_flags(definition.is_pub, definition.is_package_pub))
        }
        .Impl(definition) -> {
            owner := sema_name_scoped(prefix, definition.type_name)
            owner_path := sema_name_scoped_path(module_path, definition.type_name)
            loop method in definition.methods -> sema_name_add_method(facts, module_index, owner, owner_path, method)
            loop associated in definition.assoc_type_impls -> sema_name_add_declaration(facts, module_index, "{owner}.{associated.name}", "{owner_path}.{associated.name}", "associated_type", associated.span, NameVisibility.Private)
        }
        .Const(definition) -> {
            name := sema_name_scoped(prefix, definition.name)
            path := sema_name_scoped_path(module_path, definition.name)
            sema_name_add_declaration(facts, module_index, name, path, "const", definition.name_span, NameVisibility.Private)
        }
        .ExternRust(block) -> {
            loop function in block.functions {
                name := sema_name_scoped(prefix, function.name)
                path := sema_name_scoped_path(module_path, function.name)
                sema_name_add_declaration(facts, module_index, name, path, "extern", function.name_span, NameVisibility.Private)
            }
        }
        .CModule(c_module) -> {
            loop function in c_module.functions {
                name := sema_name_scoped(prefix, function.name)
                path := sema_name_scoped_path(module_path, function.name)
                sema_name_add_declaration(facts, module_index, name, path, "extern", function.name_span, NameVisibility.Public)
            }
        }
        .CodeModule(definition) -> {
            name := sema_name_scoped(prefix, definition.name)
            path := sema_name_scoped_path(module_path, definition.name)
            kind := "file_module"
            if definition.body != None -> kind = "module"
            sema_name_add_declaration(facts, module_index, name, path, kind, definition.name_span, sema_name_visibility_flags(definition.is_pub, definition.is_package_pub))
            if definition.body != None {
                body: definition.body ?? [Item]{}
                loop nested in body -> sema_name_add_item(facts, module_index, path, name, nested)
            }
        }
        .GenericModule(definition) -> {
            name := sema_name_scoped(prefix, definition.name)
            path := sema_name_scoped_path(module_path, definition.name)
            sema_name_add_declaration(facts, module_index, name, path, "module", definition.name_span, sema_name_visibility_flags(definition.is_pub, definition.is_package_pub))
            loop nested in definition.body -> sema_name_add_item(facts, module_index, path, name, nested)
        }
        .ModuleAlias(definition) -> {
            name := sema_name_scoped(prefix, definition.name)
            path := sema_name_scoped_path(module_path, definition.name)
            sema_name_add_declaration(facts, module_index, name, path, "module", definition.name_span, sema_name_visibility_flags(definition.is_pub, definition.is_package_pub))
        }
        .ProtocolDecl(definition) -> {
            name := sema_name_scoped(prefix, definition.name)
            path := sema_name_scoped_path(module_path, definition.name)
            sema_name_add_declaration(facts, module_index, name, path, "protocol", definition.name_span, sema_name_visibility_flags(definition.is_pub, definition.is_package_pub))
        }
        .EffectDecl(_) | .Test(_) | .Module(_) | .ErrorConv(_) | .Migration(_) | .TemplateLoop(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
}

sema_name_tree_visibility: fn(value: TVisibility) -> NameVisibility Never! {
    if value == TVisibility.Public -> return NameVisibility.Public
    if value == TVisibility.Package -> return NameVisibility.Package
    NameVisibility.Private
}

sema_name_add_tree_declarations: fn(facts: &NameFacts, module_index: Int, module_path: String, declarations: TDeclarationFacts) Never! {
    loop definition in declarations.type_defs {
        name := definition.name
        path := sema_name_scoped_path(module_path, name)
        visibility := sema_name_visibility_flags(definition.public, definition.package_public)
        sema_name_add_declaration(facts, module_index, name, path, "type", definition.span, visibility)
        if definition.kind == {
            .Struct(fields, _) -> {
                loop field in fields -> sema_name_add_declaration(facts, module_index, "{name}.{field.name}", "{path}.{field.name}", "field", field.span, sema_name_visibility_flags(field.public, field.package_public))
            }
            .Enum(variants, _) -> {
                loop variant in variants -> sema_name_add_declaration(facts, module_index, "{name}.{variant.name}", "{path}.{variant.name}", "variant", variant.span, visibility)
            }
            .Distinct(_, _) | .Alias(_) | .UnitFamily(_, _) -> {}
        }
    }
    loop trait_definition in declarations.traits {
        name := trait_definition.name
        path := sema_name_scoped_path(module_path, name)
        visibility := sema_name_tree_visibility(trait_definition.visibility)
        sema_name_add_declaration(facts, module_index, name, path, "trait", trait_definition.span, visibility)
        loop method in trait_definition.methods -> sema_name_add_declaration(facts, module_index, "{name}.{method.name}", "{path}.{method.name}", "method", method.span, visibility)
    }
}

sema_name_add_alias: fn(facts: &NameFacts, module_index: Int, name: String, target: String, target_module: Int?, span: Span, visibility: Int) Never! {
    facts.aliases.push(NameAlias{module_index: module_index, name: name, target: target, target_module: target_module, span: span, visibility: sema_name_visibility(visibility)})
}

// Parser/load projection: share declaration and display-path writers with the
// checked projection, but never register types or inspect callable bodies.
sema_name_loaded_facts: fn(modules: [NameModule], programs: [Program], aliases: [NameAlias], structure: [StructureFact]) -> NameFacts Never! {
    facts := NameFacts{modules: modules, declarations: [], aliases: aliases, references: [], structure_facts: structure}
    loop (index, program) in programs {
        loop item in program.items -> sema_name_add_item(facts, index, modules[index].path, "", item)
        sema_name_add_display_paths(facts, index, modules[index].path, program.items)
    }
    facts.declarations = sema_name_first_declarations(facts.declarations.move())
    facts.aliases = sema_name_first_aliases(facts.aliases.move())
    facts
}

// The name facts of graph modules `from..<to`, in module order: each
// module's declarations, display paths, aliases and references, before the
// first-row passes. The part's reference filter is its own, so it drops only
// rows that repeat an earlier row of the part, which the first-row pass of
// sema_name_join_facts drops anyway: the joined parts keep every row's first
// occurrence at the place one part over every module keeps it.
sema_name_part_facts: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], owner_names: [String:String], symbol_index: SemaNameSymbolIndex, from: Int, to: Int) -> NameFacts Never! {
    facts := sema_name_facts_empty()
    module_indices := [String:Int]{}
    filter := SemaNameReferenceFilter{parts: name_table(), seen: sema_name_reference_keys(), called: [Bool]{}}
    loop _ in 0..<symbol_index.declarations.len() -> filter.called.push(false)
    module_index := from
    loop module_index < to {
        source: graph.modules[module_index]
        checked: modules[module_index]
        sema_name_add_tree_declarations(facts, module_index, source.module_path, checked.declarations)
        loop item in source.program.items -> sema_name_add_item(facts, module_index, source.module_path, "", item)
        sema_name_add_display_paths(facts, module_index, source.module_path, source.program.items)
        loop import in source.imports {
            target_index := sema_registration_cached_module_index(graph, import.target_module_identity, module_indices)
            target_name := import.target_module_identity
            if target_index != None -> target_name = graph.modules[target_index ?? 0].module_name
            target_alias := import.declaration.alias
            if import.declaration.kind == {
                .File(path, _) -> target_name = path
                .Module(name, _) -> target_name = name
                .Unqualified(module_alias, _, _, _, _) -> target_name = module_alias
            }
            sema_name_add_alias(facts, module_index, target_alias, target_name, target_index, import.declaration.alias_span, import.visibility)
            if import.declaration.kind == {
                .Unqualified(_, _, _, _, _) -> {
                    loop binding in import.bindings -> sema_name_add_alias(facts, module_index, binding.local, "{target_name}.{binding.original}", binding.target_module_index, binding.symbol.span, binding.visibility)
                }
                .File(_, _) | .Module(_, _) -> {}
            }
        }
        loop reference in checked.name_references -> sema_name_add_reference(facts, filter, graph, owner_names, module_indices, reference.span, reference.symbol, reference.kind)
        loop call in checked.call_facts {
            callee: call.callee ?? next
            row: sema_name_symbol_row(symbol_index, callee.key)
            if row < 0 || filter.called[row] -> next
            filter.called[row] = true
            sema_name_add_reference(facts, filter, graph, owner_names, module_indices, call.span, symbol_index.declarations[row].symbol, symbol_index.declarations[row].kind)
        }
        module_index += 1
    }
    facts
}

// The parts' facts joined in part order, the graph's output references after
// them, and every row's first occurrence kept.
sema_name_join_facts: fn(graph: SemaRegistrationGraph, owner_names: [String:String], parts: &[NameFacts], structure_facts: [StructureFact]) -> NameFacts Never! {
    facts := sema_name_facts_empty()
    loop graph_module_index in 0..<graph.modules.len() {
        namespace: if sema_registration_package_is_namespace(graph.modules[graph_module_index].package_identity) -> Val(graph.modules[graph_module_index].package_identity) else -> None
        facts.modules.push(NameModule{alias: graph.modules[graph_module_index].module_name, path: graph.modules[graph_module_index].module_path, package: graph.modules[graph_module_index].package_identity, namespace: namespace})
    }
    loop part in 0..<parts.len() {
        compiler_transfer_rows<NameDeclaration>(facts.declarations, parts[part].declarations)
        compiler_transfer_rows<NameDisplayPath>(facts.display_paths, parts[part].display_paths)
        compiler_transfer_rows<NameAlias>(facts.aliases, parts[part].aliases)
        compiler_transfer_rows<NameReference>(facts.references, parts[part].references)
    }
    module_indices := [String:Int]{}
    filter := SemaNameReferenceFilter{parts: name_table(), seen: sema_name_reference_keys(), called: [Bool]{}}
    loop reference_index in 0..<graph.output_name_references.len() -> sema_name_add_reference(facts, filter, graph, owner_names, module_indices, graph.output_name_references[reference_index].span, graph.output_name_references[reference_index].symbol, graph.output_name_references[reference_index].kind)
    NameFacts{
        modules: facts.modules,
        declarations: sema_name_first_declarations(facts.declarations.move()),
        aliases: sema_name_first_aliases(facts.aliases.move()),
        references: sema_name_first_references(facts.references),
        structure_facts: structure_facts,
        display_paths: facts.display_paths,
    }
}

// A compiler thread is admitted for at least this many name rows (items,
// references and call facts) to collect.
SEMA_NAME_MIN_ROWS_PER_THREAD: 16384
// Parts per admitted thread, claimed dynamically.
SEMA_NAME_PARTS_PER_THREAD: 4

// Every module's name facts, then the graph's output references, each row
// kept once, on up to `threads` compiler threads, into `names`.
// The modules are cut into consecutive parts of about equal rows; each
// thread collects the parts it claims (sema_name_part_facts reads only the
// graph, the module results and the two indexes), and the parts are joined
// in part order, so the facts are the same for any thread count. The graph
// and the module results move into the threads' shared state and back; the
// graph is returned.
sema_name_build_facts_threads: fn(graph: &&SemaRegistrationGraph, modules: &[SemaGraphModuleResult], structure_facts: [StructureFact], threads: CompilerThreads, names: &NameFacts) -> SemaRegistrationGraph {
    owned := graph.move()
    owner_names := sema_name_owner_index(owned)
    weights := [Int]{}
    work := 0
    loop module_index in 0..<owned.modules.len() {
        weight: 1 + owned.modules[module_index].program.items.len() + modules[module_index].name_references.len() + modules[module_index].call_facts.len()
        weights.push(weight)
        work += weight
    }
    workers: compiler_threads_admit(threads, weights.len(), work, SEMA_NAME_MIN_ROWS_PER_THREAD, 0, 0)
    parts := [NameFacts]{}
    if workers <= 1 {
        parts.push(sema_name_part_facts(owned, modules, owner_names, sema_name_symbol_index(owned), 0, owned.modules.len()))
        names = sema_name_join_facts(owned, owner_names, parts, structure_facts)
        return owned
    }
    count := workers * SEMA_NAME_PARTS_PER_THREAD
    if count > weights.len() -> count = weights.len()
    loop _ in 0..<count -> parts.push(sema_name_facts_empty())
    shared_state: Shared{SemaNameShared{graphs: [SemaRegistrationGraph]{}, modules: [SemaGraphModuleResult]{}, owner_names: [[String:String]]{}, symbol_indexes: [SemaNameSymbolIndex]{}, bounds: compiler_threads_partition(weights, count)}}
    symbol_index := sema_name_symbol_index(owned)
    sema_name_shared_fill(shared_state, owned, modules, owner_names, symbol_index)
    queue: Shared{SemaNameQueue{next: 0}}
    sema_name_part_builders(shared_state, queue, 0, workers, parts)
    returned := sema_name_shared_take(shared_state, modules)
    returned_owner_names := sema_name_shared_take_owner_names(shared_state)
    names = sema_name_join_facts(returned, returned_owner_names, parts, structure_facts)
    returned
}

// What every name-collecting thread reads: the graph, the module results and
// the owner and symbol indexes (each moved in, the graph, the results and the
// owner index moved back out), and the parts' module bounds.
SemaNameShared: struct {
    graphs: [SemaRegistrationGraph]
    modules: [SemaGraphModuleResult]
    owner_names: [[String:String]]
    symbol_indexes: [SemaNameSymbolIndex]
    bounds: [Int]
}

// The next unclaimed part of the name collection, taken with one atomic add.
SemaNameQueue: struct {
    next: Atomic<Int>
}

// One collected part: its number and its facts.
SemaNamePart: struct {
    part: Int
    facts: NameFacts
}

sema_name_shared_fill: fn(shared_state: Shared<SemaNameShared>, graph: &&SemaRegistrationGraph, modules: &[SemaGraphModuleResult], owner_names: &&[String:String], symbol_index: &&SemaNameSymbolIndex) {
    permit: shared_state.guard_edit()
    permit.value.graphs.push(graph)
    compiler_transfer_rows<SemaGraphModuleResult>(permit.value.modules, modules)
    permit.value.owner_names.push(owner_names)
    permit.value.symbol_indexes.push(symbol_index)
}

// Moves the module results back and returns the graph.
sema_name_shared_take: fn(shared_state: Shared<SemaNameShared>, modules: &[SemaGraphModuleResult]) -> SemaRegistrationGraph {
    permit: shared_state.guard_edit()
    compiler_transfer_rows<SemaGraphModuleResult>(modules, permit.value.modules)
    permit.value.graphs.pop() ?? panic("the name collection lost its registration graph")
}

sema_name_shared_take_owner_names: fn(shared_state: Shared<SemaNameShared>) -> [String:String] {
    permit: shared_state.guard_edit()
    permit.value.owner_names.pop() ?? panic("the name collection lost its owner index")
}

// Runs threads `from..<workers`, each collecting the parts it claims, and
// places each collected part at its number in `parts`.
sema_name_part_builders: fn(shared_state: Shared<SemaNameShared>, queue: Shared<SemaNameQueue>, from: Int, workers: Int, parts: &[NameFacts]) {
    if from >= workers -> return
    task.group sema_name_threads {
        head: task sema_name_parts_claimed(shared_state, queue)
        sema_name_part_builders(shared_state, queue, from + 1, workers, parts)
        claimed := head.join() ?? panic(compiler_threads_failure_text(err))
        loop claimed.len() > 0 {
            done := claimed.pop() ?? break
            parts[done.part] = done.facts.move()
        }
    }
}

// One thread: collects the parts it claims until none is left.
sema_name_parts_claimed: fn(shared_state: Shared<SemaNameShared>, queue: Shared<SemaNameQueue>) -> [SemaNamePart] {
    inputs: shared_state.guard_read()
    claimed := [SemaNamePart]{}
    ranks: queue.guard_read()
    loop {
        part: ranks.value.next.add(1)
        if part >= inputs.value.bounds.len() - 1 -> break
        // Passed straight through: a local binding of a guarded row would copy it.
        claimed.push(SemaNamePart{part: part, facts: sema_name_part_facts(inputs.value.graphs[0], inputs.value.modules, inputs.value.owner_names[0], inputs.value.symbol_indexes[0], inputs.value.bounds[part], inputs.value.bounds[part + 1])})
    }
    claimed
}

// The structure facts the registration graph alone proves: one resolved
// import edge per graph edge, in edge order, named by the modules' display
// paths (Rust `record_import_edge_facts`: `{source} -> {target}` over the
// ledger's module paths). They exist before checking, so a compile that fails
// later still reports them (Rust records these edges at bundle completion,
// before Sema, and `jet inspect structure` prints them ahead of the failure
// diagnostics).
sema_name_structure_facts: fn(graph: SemaRegistrationGraph) -> [StructureFact] Never! {
    facts := [StructureFact]{}
    module_indices := [String:Int]{}
    loop edge_index in 0..<graph.edges.len() {
        source_index: sema_registration_cached_module_index(graph, graph.edges[edge_index].source_module_identity, module_indices) ?? next
        target_index: sema_registration_cached_module_index(graph, graph.edges[edge_index].target_module_identity, module_indices) ?? next
        source: graph.modules[source_index]
        target: graph.modules[target_index]
        facts.push(StructureFact{
            kind: StructureFactKind.ImportEdge,
            subject: "{source.source_file} -> {target.source_file}",
            source: source.source_file,
            span: graph.edges[edge_index].declaration.span,
            status: "resolved",
            detail: "resolved import edge",
            gate: None,
        })
    }
    facts
}

// The constant values keyed "{module identity}|{key}", first row winning,
// built once per projection or reference walk (Rust's keyed ct globals)
// rather than scanning every value for each symbol, constant and binding.
sema_comptime_constant_values: fn(values: [SemaComptimeItemValue]) -> [String:SemaComptimeItemValue] Never! {
    constants := [String:SemaComptimeItemValue]{}
    loop value in values {
        if value.kind != SemaComptimeItemKind.Constant -> next
        slot: "{value.module_identity}|{value.key}"
        if constants.get(slot) == None -> constants[slot] = value
    }
    constants
}

sema_comptime_value_for_symbol: fn(constants: [String:SemaComptimeItemValue], module_identity: String, key: String) -> SemaComptimeItemValue? {
    constants.get("{module_identity}|{key}")
}

sema_comptime_symbol_with_values: fn(symbol: &&Symbol, module_identity: String, constants: [String:SemaComptimeItemValue]) -> Symbol Never! {
    updated := symbol
    if sema_comptime_symbol_waits(updated) {
        value: sema_comptime_value_for_symbol(constants, module_identity, updated.id.key) ?? return updated
        updated.ty = Val(value.ty)
    }
    updated
}

// A constant still waiting for its known-time type: the only symbol a staged
// value changes (first value wins, so a typed constant never changes again).
sema_comptime_symbol_waits: fn(symbol: Symbol) -> Bool Never! {
    symbol.kind == SymbolKind.Constant && symbol.ty == None
}

// Only constants still waiting for their known-time type change, so each
// module is read in place and rewritten only when one of its rows takes a
// value. (The old row-by-row copy cloned the whole module list for every
// symbol it visited.)
sema_comptime_graph_with_values: fn(graph: &&SemaRegistrationGraph, values: [SemaComptimeItemValue]) -> SemaRegistrationGraph Never! {
    resolved := graph.move()
    trail := sema_graph_trail_init()
    sema_comptime_graph_apply_values(resolved, values, trail)
    resolved
}

// The undo trail of a registration graph one compile moves through the
// declaration pass, the comptime run and finalization instead of copying it:
// every in-place edit of those passes (staged values typing waiting rows,
// the failure projections and minted error types, the counting switch)
// records what it replaced, and sema_graph_trail_undo replays the records
// newest first, which gives back the registered graph exactly.
SemaGraphTrail: struct {
    entries: [SemaGraphUndo]
    // Whether `entries` holds the nominal indexes as they were before the
    // first minted error type (one record restores them for every mint).
    nominal_indexes_saved: Bool
}

// One recorded edit. The `*Type` rows were untyped (None) before a staged
// value typed them; the others hold the replaced row.
SemaGraphUndo: enum {
    SymbolType(module_index: Int, position: Int)
    ConstantType(module_index: Int, position: Int)
    ConstantSymbolType(module_index: Int, position: Int)
    ConstantDeclarationType(module_index: Int, position: Int)
    ModuleImportType(module_index: Int, import_index: Int, binding: Int)
    ItemType(module_index: Int, position: Int)
    GraphImportType(import_index: Int, binding: Int)
    FunctionRow(module_index: Int, row: Int, old: SemaRegistrationFunction)
    NominalMethodRow(module_index: Int, owner: Int, row: Int, old: SemaRegistrationFunction)
    ImplMethodRow(module_index: Int, owner: Int, row: Int, old: SemaRegistrationFunction)
    SymbolRow(module_index: Int, position: Int, old: Symbol)
    DeclarationRow(module_index: Int, position: Int, old: Item)
    ProgramItemRow(module_index: Int, position: Int, old: Item)
    ExportRow(module_index: Int, position: Int, old: SemaRegistrationExport)
    ImportBindingRow(module_index: Int, import_index: Int, binding: Int, old: SemaRegistrationImportBinding)
    // Rows a minted error type appended to one module (and the name it
    // indexed): undo truncates them, without a copy of the module.
    ModuleAppend(module_index: Int, mark: SemaGraphModuleMark, name: String)
    NominalIndexes(symbol_rows: [String:SemaRegistrationRowRef], slots: [String:Int], buckets: [[SemaRegistrationRowRef]])
    Counting(old: Bool)
    FailureSolved(old: Bool)
    // A generated codec body a codec wave filled (sema_codec_fill_demanded);
    // undo returns the impl to its header.
    CodecBody(module_index: Int, row: Int)
}

sema_graph_trail_init: fn() -> SemaGraphTrail Never! {
    SemaGraphTrail{entries: [SemaGraphUndo]{}, nominal_indexes_saved: false}
}

// The row counts of one registration module before an append
// (SemaGraphUndo.ModuleAppend).
SemaGraphModuleMark: struct {
    symbols: Int
    declarations: Int
    functions: Int
    nominals: Int
    constants: Int
    static_roots: Int
    persist_roots: Int
    program_items: Int
    exports: Int
}

sema_graph_module_mark: fn(module_row: SemaRegistrationModule) -> SemaGraphModuleMark Never! {
    SemaGraphModuleMark{
        symbols: module_row.symbols.len(),
        declarations: module_row.declarations.len(),
        functions: module_row.functions.len(),
        nominals: module_row.nominals.len(),
        constants: module_row.constants.len(),
        static_roots: module_row.static_roots.len(),
        persist_roots: module_row.persist_roots.len(),
        program_items: module_row.program.items.len(),
        exports: module_row.exports.len(),
    }
}

// Drops every row appended to `module_row` since `mark` and, when a symbol
// was appended, the position entries of its `name`, giving back the module
// as it was at the mark.
sema_graph_module_rollback: fn(module_row: &SemaRegistrationModule, mark: SemaGraphModuleMark, name: String) Never! {
    appended: module_row.symbols.len() > mark.symbols
    loop module_row.symbols.len() > mark.symbols -> _ := module_row.symbols.pop()
    loop module_row.symbol_nominal_rows.len() > mark.symbols -> _ := module_row.symbol_nominal_rows.pop()
    loop module_row.declarations.len() > mark.declarations -> _ := module_row.declarations.pop()
    loop module_row.functions.len() > mark.functions -> _ := module_row.functions.pop()
    loop module_row.nominals.len() > mark.nominals -> _ := module_row.nominals.pop()
    loop module_row.constants.len() > mark.constants -> _ := module_row.constants.pop()
    loop module_row.static_roots.len() > mark.static_roots -> _ := module_row.static_roots.pop()
    loop module_row.persist_roots.len() > mark.persist_roots -> _ := module_row.persist_roots.pop()
    loop module_row.program.items.len() > mark.program_items -> _ := module_row.program.items.pop()
    loop module_row.exports.len() > mark.exports -> _ := module_row.exports.pop()
    if !appended || name == "" -> return
    sema_registration_forget_symbol_position(module_row, name)
    _ := module_row.declaration_positions.remove(name)
}

// Undoes every edit `trail` recorded on `graph`, newest first, leaving the
// trail empty.
sema_graph_trail_undo: fn(graph: &SemaRegistrationGraph, trail: &SemaGraphTrail) Never! {
    loop trail.entries.len() > 0 {
        entry: trail.entries.pop() ?? break
        if entry == {
            .SymbolType(module_index, position) -> graph.modules[module_index].symbols[position].ty = None
            .ConstantType(module_index, position) -> graph.modules[module_index].constants[position].ty = None
            .ConstantSymbolType(module_index, position) -> graph.modules[module_index].constants[position].symbol.ty = None
            .ConstantDeclarationType(module_index, position) -> graph.modules[module_index].constants[position].declaration.ty = None
            .ModuleImportType(module_index, import_index, binding) -> graph.modules[module_index].imports[import_index].bindings[binding].symbol.ty = None
            .ItemType(module_index, position) -> {
                if graph.modules[module_index].program.items[position] == .Const(definition) {
                    restored := definition
                    restored.ty = None
                    graph.modules[module_index].program.items[position] = Item.Const{value: restored}
                }
            }
            .GraphImportType(import_index, binding) -> graph.imports[import_index].bindings[binding].symbol.ty = None
            .FunctionRow(module_index, row, old) -> graph.modules[module_index].functions[row] = old
            .NominalMethodRow(module_index, owner, row, old) -> graph.modules[module_index].nominals[owner].methods[row] = old
            .ImplMethodRow(module_index, owner, row, old) -> graph.modules[module_index].impls[owner].methods[row] = old
            .SymbolRow(module_index, position, old) -> graph.modules[module_index].symbols[position] = old
            .DeclarationRow(module_index, position, old) -> graph.modules[module_index].declarations[position] = old
            .ProgramItemRow(module_index, position, old) -> graph.modules[module_index].program.items[position] = old
            .ExportRow(module_index, position, old) -> graph.modules[module_index].exports[position] = old
            .ImportBindingRow(module_index, import_index, binding, old) -> graph.modules[module_index].imports[import_index].bindings[binding] = old
            .ModuleAppend(module_index, mark, name) -> sema_graph_module_rollback(graph.modules[module_index], mark, name)
            .NominalIndexes(symbol_rows, slots, buckets) -> {
                graph.nominal_symbol_rows = symbol_rows
                graph.nominal_row_slots = slots
                graph.nominal_row_buckets = buckets
            }
            .Counting(old) -> graph.counting = old
            .FailureSolved(old) -> graph.failure_solved = old
            .CodecBody(module_index, row) -> sema_codec_undo_body(graph, module_index, row)
        }
    }
    trail.nominal_indexes_saved = false
}

// Applies staged values to a graph in place. A row already typed by an
// earlier value keeps it (first value wins), so a staging loop applies only
// the values that landed since its last call instead of rebuilding the graph
// for every item. Every row typed is recorded on `trail`.
sema_comptime_graph_apply_values: fn(graph: &SemaRegistrationGraph, values: [SemaComptimeItemValue], trail: &SemaGraphTrail) Never! {
    if values.len() == 0 -> return
    constants: sema_comptime_constant_values(values)
    if constants.len() == 0 -> return
    loop module_index in 0..<graph.modules.len() {
        if !sema_comptime_module_takes_values(graph.modules[module_index], constants) -> next
        sema_comptime_module_apply_values(graph.modules[module_index], module_index, constants, trail)
    }
    loop import_index in 0..<graph.imports.len() {
        loop binding_index in 0..<graph.imports[import_index].bindings.len() {
            if !sema_comptime_binding_takes_value(graph.imports[import_index].bindings[binding_index], constants) -> next
            symbol := graph.imports[import_index].bindings[binding_index].symbol
            updated: sema_comptime_symbol_with_values(symbol, graph.imports[import_index].bindings[binding_index].target_module_identity, constants)
            graph.imports[import_index].bindings[binding_index].symbol = updated
            trail.entries.push(SemaGraphUndo.GraphImportType{import_index: import_index, binding: binding_index})
        }
    }
}

// The rows of a graph that a staged value can type, keyed as
// sema_comptime_constant_values keys values ("{module identity}|{key}"):
// waiting constant symbols, constant rows not fully typed, waiting import
// bindings (keyed by their target module) and untyped `Const` items. A run
// builds them once (sema_comptime_value_sites) and applies each landing
// through them (sema_comptime_graph_apply_sites), so a landing reads only
// its own values' rows instead of every row of every module. Staged values
// only fill in types, so no row outside these ever takes one. `constants`
// lists the positions of every constant row by "{module index}|{key}"
// (sema_comptime_staged_constant_rows).
SemaComptimeValueSites: struct {
    sites: [String:[SemaComptimeValueSite]]
    constants: [String:[Int]]
}

SemaComptimeValueSite: enum {
    Symbol(module_index: Int, position: Int)
    Constant(module_index: Int, position: Int)
    ModuleImport(module_index: Int, import_index: Int, binding: Int)
    Item(module_index: Int, position: Int)
    GraphImport(import_index: Int, binding: Int)
}

sema_comptime_value_site_add: fn(sites: &[String:[SemaComptimeValueSite]], slot: String, site: SemaComptimeValueSite) Never! {
    rows := sites.get(slot) ?? [SemaComptimeValueSite]{}
    rows.push(site.copy())
    sites[slot] = rows
}

sema_comptime_value_sites: fn(graph: SemaRegistrationGraph) -> SemaComptimeValueSites Never! {
    sites := [String:[SemaComptimeValueSite]]{}
    constants := [String:[Int]]{}
    loop module_index in 0..<graph.modules.len() {
        module_identity: graph.modules[module_index].module_identity
        loop position in 0..<graph.modules[module_index].symbols.len() {
            if sema_comptime_symbol_waits(graph.modules[module_index].symbols[position]) -> sema_comptime_value_site_add(sites, "{module_identity}|{graph.modules[module_index].symbols[position].id.key}", SemaComptimeValueSite.Symbol{module_index: module_index, position: position})
        }
        loop position in 0..<graph.modules[module_index].constants.len() {
            constant: graph.modules[module_index].constants[position]
            row_slot: "{module_index}|{constant.symbol.id.key}"
            positions := constants.get(row_slot) ?? [Int]{}
            positions.push(position)
            constants[row_slot] = positions
            if constant.ty != None && constant.symbol.ty != None && constant.declaration.ty != None -> next
            sema_comptime_value_site_add(sites, "{module_identity}|{constant.symbol.id.key}", SemaComptimeValueSite.Constant{module_index: module_index, position: position})
        }
        loop import_index in 0..<graph.modules[module_index].imports.len() {
            loop binding in 0..<graph.modules[module_index].imports[import_index].bindings.len() {
                row: graph.modules[module_index].imports[import_index].bindings[binding]
                if sema_comptime_symbol_waits(row.symbol) -> sema_comptime_value_site_add(sites, "{row.target_module_identity}|{row.symbol.id.key}", SemaComptimeValueSite.ModuleImport{module_index: module_index, import_index: import_index, binding: binding})
            }
        }
        loop position in 0..<graph.modules[module_index].program.items.len() {
            key: sema_comptime_constant_item_key(module_identity, graph.modules[module_index].program.items[position]) ?? next
            sema_comptime_value_site_add(sites, "{module_identity}|{key}", SemaComptimeValueSite.Item{module_index: module_index, position: position})
        }
    }
    loop import_index in 0..<graph.imports.len() {
        loop binding in 0..<graph.imports[import_index].bindings.len() {
            row: graph.imports[import_index].bindings[binding]
            if sema_comptime_symbol_waits(row.symbol) -> sema_comptime_value_site_add(sites, "{row.target_module_identity}|{row.symbol.id.key}", SemaComptimeValueSite.GraphImport{import_index: import_index, binding: binding})
        }
    }
    SemaComptimeValueSites{sites: sites, constants: constants}
}

// No value sites: the placeholder a comptime run's staging holds until the
// run's program tables exist (sema_comptime_value_sites).
sema_comptime_value_sites_empty: fn() -> SemaComptimeValueSites Never! {
    SemaComptimeValueSites{sites: [String:[SemaComptimeValueSite]]{}, constants: [String:[Int]]{}}
}

// sema_comptime_graph_apply_values on a graph whose sites are `sites`: each
// site of a value takes it under the same test that rewrite applies, so the
// graph ends exactly as there. Every row typed is recorded on `trail`.
sema_comptime_graph_apply_sites: fn(graph: &SemaRegistrationGraph, sites: SemaComptimeValueSites, values: [SemaComptimeItemValue], trail: &SemaGraphTrail) Never! {
    if values.len() == 0 -> return
    constants: sema_comptime_constant_values(values)
    loop (slot, value) in constants {
        rows: sites.sites.get(slot) ?? next
        loop site in rows {
            if site == {
                .Symbol(module_index, position) -> {
                    if sema_comptime_symbol_waits(graph.modules[module_index].symbols[position]) {
                        graph.modules[module_index].symbols[position].ty = Val(value.ty)
                        trail.entries.push(SemaGraphUndo.SymbolType{module_index: module_index, position: position})
                    }
                }
                .Constant(module_index, position) -> sema_comptime_constant_apply_value(graph.modules[module_index], module_index, position, value, trail)
                .ModuleImport(module_index, import_index, binding) -> {
                    if sema_comptime_symbol_waits(graph.modules[module_index].imports[import_index].bindings[binding].symbol) {
                        graph.modules[module_index].imports[import_index].bindings[binding].symbol.ty = Val(value.ty)
                        trail.entries.push(SemaGraphUndo.ModuleImportType{module_index: module_index, import_index: import_index, binding: binding})
                    }
                }
                .Item(module_index, position) -> {
                    if graph.modules[module_index].program.items[position] == .Const(definition) {
                        if definition.ty == None {
                            updated_definition := definition
                            updated_definition.ty = Val(value.ty)
                            graph.modules[module_index].program.items[position] = Item.Const{value: updated_definition}
                            trail.entries.push(SemaGraphUndo.ItemType{module_index: module_index, position: position})
                        }
                    }
                }
                .GraphImport(import_index, binding) -> {
                    if sema_comptime_symbol_waits(graph.imports[import_index].bindings[binding].symbol) {
                        graph.imports[import_index].bindings[binding].symbol.ty = Val(value.ty)
                        trail.entries.push(SemaGraphUndo.GraphImportType{import_index: import_index, binding: binding})
                    }
                }
            }
        }
    }
}

// Types the untyped parts of constant row `position` of `module_row` (graph
// module `module_index`) with `value`, recording each on `trail`.
sema_comptime_constant_apply_value: fn(module_row: &SemaRegistrationModule, module_index: Int, position: Int, value: SemaComptimeItemValue, trail: &SemaGraphTrail) Never! {
    if module_row.constants[position].ty == None {
        module_row.constants[position].ty = Val(value.ty)
        trail.entries.push(SemaGraphUndo.ConstantType{module_index: module_index, position: position})
    }
    if module_row.constants[position].symbol.ty == None {
        module_row.constants[position].symbol.ty = Val(value.ty)
        trail.entries.push(SemaGraphUndo.ConstantSymbolType{module_index: module_index, position: position})
    }
    if module_row.constants[position].declaration.ty == None {
        module_row.constants[position].declaration.ty = Val(value.ty)
        trail.entries.push(SemaGraphUndo.ConstantDeclarationType{module_index: module_index, position: position})
    }
}

sema_comptime_symbol_takes_value: fn(symbol: Symbol, module_identity: String, constants: [String:SemaComptimeItemValue]) -> Bool Never! {
    sema_comptime_symbol_waits(symbol) && sema_comptime_value_for_symbol(constants, module_identity, symbol.id.key) != None
}

sema_comptime_binding_takes_value: fn(binding: SemaRegistrationImportBinding, constants: [String:SemaComptimeItemValue]) -> Bool Never! {
    sema_comptime_symbol_takes_value(binding.symbol, binding.target_module_identity, constants)
}

sema_comptime_constant_item_key: fn(module_identity: String, item: Item) -> String? {
    if item == .Const(definition) {
        if definition.ty == None -> return Val(symbol_id(SymbolKind.Constant, module_identity, "", definition.name).key)
    }
    None
}

sema_comptime_module_takes_values: fn(module_row: SemaRegistrationModule, constants: [String:SemaComptimeItemValue]) -> Bool Never! {
    module_identity: module_row.module_identity
    loop symbol in module_row.symbols {
        if sema_comptime_symbol_takes_value(symbol, module_identity, constants) -> return true
    }
    loop constant in module_row.constants {
        if constant.ty != None && constant.symbol.ty != None && constant.declaration.ty != None -> next
        if sema_comptime_value_for_symbol(constants, module_identity, constant.symbol.id.key) != None -> return true
    }
    loop import_index in 0..<module_row.imports.len() {
        loop binding in module_row.imports[import_index].bindings {
            if sema_comptime_binding_takes_value(binding, constants) -> return true
        }
    }
    loop item_index in 0..<module_row.program.items.len() {
        key: sema_comptime_constant_item_key(module_identity, module_row.program.items[item_index]) ?? next
        if sema_comptime_value_for_symbol(constants, module_identity, key) != None -> return true
    }
    false
}

// Types the module's waiting constants in place through the graph's row, so a
// landed value never copies the whole module. Each row is read before it is
// rewritten, and no row's rewrite changes another row's test. `module_row`
// is graph module `module_index`; every row typed is recorded on `trail`.
sema_comptime_module_apply_values: fn(module_row: &SemaRegistrationModule, module_index: Int, constants: [String:SemaComptimeItemValue], trail: &SemaGraphTrail) Never! {
    module_identity: module_row.module_identity
    loop symbol_index in 0..<module_row.symbols.len() {
        if !sema_comptime_symbol_takes_value(module_row.symbols[symbol_index], module_identity, constants) -> next
        symbol := module_row.symbols[symbol_index]
        module_row.symbols[symbol_index] = sema_comptime_symbol_with_values(symbol, module_identity, constants)
        trail.entries.push(SemaGraphUndo.SymbolType{module_index: module_index, position: symbol_index})
    }
    loop constant_index in 0..<module_row.constants.len() {
        value: sema_comptime_value_for_symbol(constants, module_identity, module_row.constants[constant_index].symbol.id.key) ?? next
        if module_row.constants[constant_index].ty == None {
            module_row.constants[constant_index].ty = Val(value.ty)
            trail.entries.push(SemaGraphUndo.ConstantType{module_index: module_index, position: constant_index})
        }
        if module_row.constants[constant_index].symbol.ty == None {
            module_row.constants[constant_index].symbol.ty = Val(value.ty)
            trail.entries.push(SemaGraphUndo.ConstantSymbolType{module_index: module_index, position: constant_index})
        }
        if module_row.constants[constant_index].declaration.ty == None {
            module_row.constants[constant_index].declaration.ty = Val(value.ty)
            trail.entries.push(SemaGraphUndo.ConstantDeclarationType{module_index: module_index, position: constant_index})
        }
    }
    loop import_index in 0..<module_row.imports.len() {
        loop binding_index in 0..<module_row.imports[import_index].bindings.len() {
            if !sema_comptime_binding_takes_value(module_row.imports[import_index].bindings[binding_index], constants) -> next
            symbol := module_row.imports[import_index].bindings[binding_index].symbol
            module_row.imports[import_index].bindings[binding_index].symbol = sema_comptime_symbol_with_values(symbol, module_row.imports[import_index].bindings[binding_index].target_module_identity, constants)
            trail.entries.push(SemaGraphUndo.ModuleImportType{module_index: module_index, import_index: import_index, binding: binding_index})
        }
    }
    loop item_index in 0..<module_row.program.items.len() {
        key: sema_comptime_constant_item_key(module_identity, module_row.program.items[item_index]) ?? next
        value: sema_comptime_value_for_symbol(constants, module_identity, key) ?? next
        if module_row.program.items[item_index] == .Const(definition) {
            updated_definition := definition
            updated_definition.ty = Val(value.ty)
            module_row.program.items[item_index] = Item.Const{value: updated_definition}
            trail.entries.push(SemaGraphUndo.ItemType{module_index: module_index, position: item_index})
        }
    }
}

sema_comptime_constant_has_ast_value: fn(graph: SemaRegistrationGraph, module_identity: String, key: String) -> Bool Never! {
    module_index: sema_registration_module_index(graph, module_identity) ?? return false
    loop constant_index in 0..<graph.modules[module_index].constants.len() {
        if graph.modules[module_index].constants[constant_index].symbol.id.key == key -> return graph.modules[module_index].constants[constant_index].declaration.ct != None
    }
    true
}

// An empty probe scope: the first sema_comptime_probe_prepare builds it. The
// caller that runs a series of probes owns one and lends it to each.
sema_comptime_probe_init: fn(host_hooks: SemaHostHookAccess?) -> SemaScopeProbe Never! {
    SemaScopeProbe{module_identity: "", table: sema_scope_init(""), applied: false, diagnostics: [Diagnostic]{}, constants: [SemaScopeProbeConstant]{}, host_hooks: host_hooks, version: -1}
}

// Readies `probe` as the declaration scope of the environment's current
// module (set by sema_scope_environment_enter_probe_module): a scope built for
// that module is reused, with any constant a staged value typed since copied
// in, and anything else is rebuilt. `version` is the number of staged values
// applied to the run's graph (SemaComptimeAvailableConstants
// counted_values): only those type waiting constants, so a scope compared at
// the same version has nothing to copy in, and is reused as it is. The caller
// checks inside a mark on `probe.table` and rolls back, so the next probe
// finds the same scope.
sema_comptime_probe_prepare: fn(probe: &SemaScopeProbe, environment: SemaScopeEnvironment, program: SemaProgramTables, version: Int) {
    module_identity: environment.module_identity
    if program.registration_graph == .Val(graph) {
        if probe.applied && probe.module_identity == module_identity {
            if probe.version == version && version >= 0 -> return
            if sema_registration_module_index(graph, module_identity) == .Val(module_index) {
                sema_comptime_probe_refresh(probe, graph, module_index)
                probe.version = version
                return
            }
        }
        // Any other scope is rebuilt; an unapplied one always is, so it never
        // outlives the graph state that failed it.
        table := sema_scope_init(module_identity)
        diagnostics := [Diagnostic]{}
        constants := [SemaScopeProbeConstant]{}
        applied: sema_registration_apply_graph_module_rows(graph, module_identity, table, diagnostics, constants)
        probe.module_identity = module_identity
        probe.table = table
        probe.applied = applied
        probe.diagnostics = diagnostics
        probe.constants = constants
        probe.version = version
    } else {
        probe.module_identity = module_identity
        probe.table = sema_scope_init(module_identity)
        probe.applied = false
        probe.diagnostics = [Diagnostic]{}
        probe.constants = [SemaScopeProbeConstant]{}
        probe.version = -1
        return
    }
}

// Copies each waiting constant that a staged value has typed since the last
// probe from its graph row into its binding: exactly the rows a rebuilt table
// would differ in. Typed constants never change again, so they leave the list.
sema_comptime_probe_refresh: fn(probe: &SemaScopeProbe, graph: SemaRegistrationGraph, module_index: Int) Never! {
    if probe.constants.len() == 0 -> return
    waiting := [SemaScopeProbeConstant]{}
    loop index in 0..<probe.constants.len() {
        if probe.constants[index].source == {
            .Symbol(position) -> {
                if sema_comptime_symbol_waits(graph.modules[module_index].symbols[position]) {
                    waiting.push(probe.constants[index])
                } else {
                    probe.table.bindings[probe.constants[index].binding].symbol = graph.modules[module_index].symbols[position]
                }
            }
            .Import(import_index, binding) -> {
                if sema_comptime_symbol_waits(graph.modules[module_index].imports[import_index].bindings[binding].symbol) {
                    waiting.push(probe.constants[index])
                } else {
                    probe.table.bindings[probe.constants[index].binding].symbol = graph.modules[module_index].imports[import_index].bindings[binding].symbol
                }
            }
            .Namespace(owner, position) -> {
                if sema_comptime_symbol_waits(graph.modules[owner].symbols[position]) {
                    waiting.push(probe.constants[index])
                } else {
                    probe.table.bindings[probe.constants[index].binding].symbol = graph.modules[owner].symbols[position]
                }
            }
        }
    }
    probe.constants = waiting
}

// A compiler thread is admitted for at least this many bytes of comptime
// source expressions, so a precheck wave with few item checks leaves them to
// the run (sema_comptime_precheck_items).
SEMA_PROBE_MIN_BYTES_PER_THREAD: 16384

// D2: the comptime sources of graph module `module_index`, read from the
// pass's program tables. A source's constant dependencies are not probed
// here: the run's own check of the item names them
// (sema_check_comptime_item_in, sema_comptime_dependencies_from_references),
// as it did for every probed source, so the probe's second full check of
// each expression is gone.
sema_comptime_module_sources: fn(program: SemaProgramTables, module_index: Int) -> [SemaComptimeItemSource] {
    if program.registration_graph == .Val(graph) -> return sema_comptime_collect_module_sources(graph, graph.modules[module_index])
    panic("the declaration pass lost its registration graph")
}

// A comptime run pass's item checks, made ahead of the pass on the compiler
// threads. The run checks its pending items one at a time, and a
// value that lands between two checks types only its own constant; an item
// check reads only the constants it references, and every referenced
// constant without a value is one of the check's `dependencies`
// (sema_comptime_dependencies_from_references). So a check made against the
// run's state at the start of the pass is the check the run would make at the
// item's turn as long as no value whose key is one of its dependencies has
// landed since (the run tests that before it takes one,
// jet_driver_comptime_prechecked). The checks run in waves of consecutive
// modules (sema_comptime_precheck_wave), each in its module's probe scope
// (sema_comptime_probe_prepare), against the environment entered in its
// module. The run's environment moves into the threads' shared state with the
// program tables and back out after. Each is the one row of its slot
// (`environments`, `programs`), so it is popped and pushed back, never
// copied: moving a borrowed environment or program out would copy the whole
// registration graph once per pass.
// Host callbacks are withheld there; a check that wanted one, a checked-text
// source (its check reads no expression), and every source of a module that
// cannot be entered or of a wave whose checks admit one thread have no row
// (None), and the run checks them at their turn. The result has one row per
// source. The calling thread, which waits for the checking threads, builds
// the run's function memory plan meanwhile when `memory_plan` has none yet.
sema_comptime_precheck_items: fn(environments: &[SemaScopeEnvironment], programs: &[SemaProgramTables], available: SemaComptimeAvailableConstants, sources: [SemaComptimeItemSource], threads: CompilerThreads, memory_plan: &[SemaFunctionMemoryPlan]) -> [SemaComptimeItemCheck?] {
    checks := [SemaComptimeItemCheck?]{}
    loop _ in 0..<sources.len() -> checks.push(None)
    // The expression sources of each module, in order of first appearance.
    module_rows := [String:Int]{}
    module_identities := [String]{}
    module_positions := [[Int]]{}
    loop (position, source) in sources {
        if source.checked_text != None -> next
        row := module_rows.get(source.module_identity) ?? -1
        if row < 0 {
            row = module_positions.len()
            module_rows[source.module_identity] = row
            module_identities.push(source.module_identity)
            module_positions.push([Int]{})
        }
        module_positions[row].push(position)
    }
    if module_positions.len() == 0 -> return checks
    total := 0
    loop row in module_positions {
        loop position in row -> total += sources[position].span.end - sources[position].span.start
    }
    if compiler_threads_admit(threads, sources.len(), total, SEMA_PROBE_MIN_BYTES_PER_THREAD, 0, 0) <= 1 -> return checks
    shared_state: Shared{SemaPrecheckShared{environments: [SemaScopeEnvironment]{}, programs: [SemaProgramTables]{}, available: [SemaComptimeAvailableConstants]{available}, sources: [[SemaComptimeItemSource]]{sources}, module_environments: [SemaScopeEnvironment]{}, probes: [SemaScopeProbe]{}}}
    counting: sema_comptime_precheck_fill(shared_state, environments, programs)
    start := 0
    loop start < module_positions.len() {
        end: sema_comptime_precheck_wave_end(shared_state, module_identities, start)
        sema_comptime_precheck_wave(shared_state, module_identities, module_positions, start, end, sources, available.counted_values, threads, checks, memory_plan)
        start = end
    }
    permit: shared_state.guard_edit()
    environment := permit.value.environments.pop() ?? panic("the precheck environment left the threads' shared state")
    program := permit.value.programs.pop() ?? panic("the precheck program tables left the threads' shared state")
    program.registration_graph = sema_comptime_precheck_counting(program.registration_graph.move(), counting)
    environments.push(environment)
    programs.push(program)
    checks
}

// A precheck wave: modules `module_identities[start..<end]` make their item
// checks in one parallel pass instead of one pass each, so a long check
// overlaps the other modules' checks, and a module too small to admit threads
// of its own has its checks made too. Every module is first entered in order
// (sema_comptime_precheck_enter), keeping a copy of the environment entered
// in it with its probe scope; the threads then claim the wave's checks,
// modules with the heaviest source first and heaviest source first within a
// module, and check each against its module's environment on the thread's
// light copy of that module's scope. A check reads only its module's entered
// environment, the program tables and the available constants, as a check of
// a pass of its module alone would. Each check lands in `checks` at its
// source's position.
sema_comptime_precheck_wave: fn(shared_state: Shared<SemaPrecheckShared>, module_identities: [String], module_positions: [[Int]], start: Int, end: Int, sources: [SemaComptimeItemSource], version: Int, threads: CompilerThreads, checks: &[SemaComptimeItemCheck?], memory_plan: &[SemaFunctionMemoryPlan]) {
    // Job j checks source positions[j] in entered wave module job_modules[j];
    // firsts[k] is wave module k's first job, its last row the job count.
    positions := [Int]{}
    job_modules := [Int]{}
    weights := [Int]{}
    firsts := [Int]{}
    heaviest := [Int]{}
    work := 0
    scope_items := 0
    loop row in start..<end {
        module_items := 0
        if !sema_comptime_precheck_enter(shared_state, module_identities[row], version, module_items) -> next
        if module_items > scope_items -> scope_items = module_items
        wave_module: firsts.len()
        firsts.push(positions.len())
        module_heaviest := 0
        loop position in module_positions[row] {
            weight: sources[position].span.end - sources[position].span.start
            positions.push(position)
            job_modules.push(wave_module)
            weights.push(weight)
            work += weight
            if weight > module_heaviest -> module_heaviest = weight
        }
        heaviest.push(module_heaviest)
    }
    firsts.push(positions.len())
    workers: compiler_threads_admit(threads, positions.len(), work, SEMA_PROBE_MIN_BYTES_PER_THREAD, scope_items * SEMA_BODY_SCOPE_BYTES_PER_ITEM, 0)
    if workers > 1 {
        order := [Int]{}
        loop wave_module in compiler_threads_heaviest_first(heaviest) {
            first: firsts[wave_module]
            module_weights := [Int]{}
            loop job in first..<firsts[wave_module + 1] -> module_weights.push(weights[job])
            loop index in compiler_threads_heaviest_first(module_weights) -> order.push(first + index)
        }
        plan: Shared{SemaPrecheckPlan{positions: positions.move(), modules: job_modules.move(), order: order.move(), next: 0}}
        done := [SemaPrecheckDone]{}
        sema_comptime_precheck_claimers(shared_state, plan, 0, workers, done, memory_plan)
        loop done.len() > 0 {
            row := done.pop() ?? break
            checks[row.position] = row.check.move()
        }
    }
    // The wave's module scopes leave with its threads.
    permit: shared_state.guard_edit()
    permit.value.module_environments = [SemaScopeEnvironment]{}
    permit.value.probes = [SemaScopeProbe]{}
}

// The end of the precheck wave that starts at `module_identities[start]`: it
// holds every module's probe scope at once, so it takes consecutive modules
// while their scope rows stay within a body wave's bound
// (SEMA_BODY_WAVE_SCOPE_ROWS), and at least one.
sema_comptime_precheck_wave_end: fn(shared_state: Shared<SemaPrecheckShared>, module_identities: [String], start: Int) -> Int {
    inputs: shared_state.guard_read()
    rows := 0
    end := start
    loop end < module_identities.len() {
        // Passed straight through: a local binding of a guarded row would copy it.
        module_rows: sema_comptime_precheck_scope_rows(inputs.value.programs[0], module_identities[end])
        if end > start && rows + module_rows > SEMA_BODY_WAVE_SCOPE_ROWS -> break
        rows += module_rows
        end += 1
    }
    end
}

// The scope rows of module `module_identity` (sema_check_module_scope_rows);
// 0 for a module the graph lacks.
sema_comptime_precheck_scope_rows: fn(program: SemaProgramTables, module_identity: String) -> Int {
    if program.registration_graph == .Val(graph) {
        module_index: sema_registration_module_index(graph, module_identity) ?? return 0
        return sema_check_module_scope_rows(graph, module_index)
    }
    0
}

// What every precheck thread reads: the run's environment and program
// tables, the pass's available constants and sources, each the one row of its
// list, and the current wave's entered module environments (each holding its
// module's prepared probe scope as `module_scope`) with their probes, one row
// per entered wave module.
SemaPrecheckShared: struct {
    environments: [SemaScopeEnvironment]
    programs: [SemaProgramTables]
    available: [SemaComptimeAvailableConstants]
    sources: [[SemaComptimeItemSource]]
    module_environments: [SemaScopeEnvironment]
    probes: [SemaScopeProbe]
}

// A precheck wave's jobs (sema_comptime_precheck_wave) in claim order:
// `order[rank]` is the job claimed at `rank`, `next` the next unclaimed rank,
// taken with one atomic add under a read guard each thread holds for its run.
SemaPrecheckPlan: struct {
    positions: [Int]
    modules: [Int]
    order: [Int]
    next: Atomic<Int>
}

// One claimed precheck job: its source position and entered wave module;
// position -1 when none is left.
SemaPrecheckClaim: struct {
    position: Int
    wave_module: Int
}

// One check a precheck thread made, at its source's position.
SemaPrecheckDone: struct {
    position: Int
    check: SemaComptimeItemCheck?
}

// Moves the run's environment and program tables out of their slots into the
// precheck threads' shared state; sema_comptime_precheck_items moves them
// back. The registration graph stops counting its lookups while it is there,
// as in sema_finalize_graph: every lookup would take the shared counters'
// permit and serialize the threads. The result is its old flag.
sema_comptime_precheck_fill: fn(shared_state: Shared<SemaPrecheckShared>, environments: &[SemaScopeEnvironment], programs: &[SemaProgramTables]) -> Bool {
    permit: shared_state.guard_edit()
    environment := environments.pop() ?? panic("the run's environment left its slot")
    program := programs.pop() ?? panic("the run's program tables left their slot")
    counting: sema_comptime_precheck_graph_counting(program)
    program.registration_graph = sema_comptime_precheck_counting(program.registration_graph.move(), false)
    permit.value.environments.push(environment)
    permit.value.programs.push(program)
    counting
}

// The registration graph `held`, moved through, with `counting` as its
// lookup-counting flag.
sema_comptime_precheck_counting: fn(held: &&SemaRegistrationGraph?, counting: Bool) -> SemaRegistrationGraph? {
    graph := held.move() ?? return None
    graph.counting = counting
    Val(graph.move())
}

// Whether the registration graph of `program` counts its lookups (false
// without a graph).
sema_comptime_precheck_graph_counting: fn(program: SemaProgramTables) -> Bool {
    if program.registration_graph == .Val(graph) -> return graph.counting
    false
}

// Enters the run's environment in `module_identity` and prepares the module's
// probe scope. When both succeed, a copy of the entered environment holding
// that scope as its `module_scope`, where every thread reads it in place
// through its own light copy (sema_comptime_precheck_thread_probe), joins the
// wave's module environments, and the probe, which keeps the module's other
// prepared facts, joins its probes. False when the module cannot be entered
// or its scope not applied (the run then checks its sources at their turn).
// `scope_items` gets the module's item count.
sema_comptime_precheck_enter: fn(shared_state: Shared<SemaPrecheckShared>, module_identity: String, version: Int, scope_items: &Int) -> Bool {
    permit: shared_state.guard_edit()
    // The environment moves out of the shared state and back, so entering
    // never copies it.
    environment := permit.value.environments.pop() ?? panic("the precheck environment left the threads' shared state")
    empty := sema_comptime_body_values_prefix(environment.comptime_body_publication, 0)
    entered: sema_scope_environment_enter_probe_module(environment, permit.value.programs[0], module_identity, empty)
    probe := sema_comptime_probe_init(None)
    if entered -> sema_comptime_probe_prepare(probe, environment, permit.value.programs[0], version)
    kept: entered && probe.applied
    if kept {
        if permit.value.programs[0].registration_graph == .Val(graph) {
            if sema_registration_module_index(graph, module_identity) == .Val(module_index) -> scope_items = graph.modules[module_index].program.items.len()
        }
        // copy: the module's checks read this entered environment while the
        // run's environment enters the wave's next module.
        module_environment := environment.copy()
        table := probe.table.move()
        probe.table = sema_scope_init(module_identity)
        module_environment.module_scope = Val(table.move())
        permit.value.module_environments.push(module_environment)
        permit.value.probes.push(probe)
    }
    permit.value.environments.push(environment)
    kept
}

// A precheck thread's own probe: a light copy of the module's declaration
// scope (the module environment's `module_scope`, whose function types the
// copy reads in place, sema_scope_light_copy) beside copies of the prepared
// probe's small rows, with host callbacks withheld through `wanted`. The
// copied probe is prepared for the same module and version, so a check's
// sema_comptime_probe_prepare keeps it as it is.
sema_comptime_precheck_thread_probe: fn(environment: SemaScopeEnvironment, source: SemaScopeProbe, wanted: Shared<SemaHostHookWanted>) -> SemaScopeProbe {
    if environment.module_scope == .Val(table) {
        return SemaScopeProbe{
            module_identity: source.module_identity.copy(),
            table: sema_scope_light_copy(table),
            applied: source.applied,
            // copy: the thread's probe owns its rows while the shared probe keeps its own.
            diagnostics: source.diagnostics.copy(),
            constants: source.constants.copy(),
            host_hooks: Val(SemaHostHookAccess.Withheld{wanted: wanted, observed: None}),
            version: source.version,
        }
    }
    panic("the precheck module scope left its module environment")
}

// Runs claiming threads `from..<workers`, one task each, and moves every
// check a thread returned into `done`. The calling thread, left waiting for
// them, builds the function memory plan if `memory_plan` has none yet.
sema_comptime_precheck_claimers: fn(shared_state: Shared<SemaPrecheckShared>, plan: Shared<SemaPrecheckPlan>, from: Int, workers: Int, done: &[SemaPrecheckDone], memory_plan: &[SemaFunctionMemoryPlan]) {
    if from >= workers {
        if memory_plan.len() == 0 -> sema_comptime_precheck_memory_plan(shared_state, memory_plan)
        return
    }
    task.group sema_precheck_threads {
        head: task sema_comptime_precheck_claimed(shared_state, plan)
        sema_comptime_precheck_claimers(shared_state, plan, from + 1, workers, done, memory_plan)
        claimed := head.join() ?? panic(compiler_threads_failure_text(err))
        loop claimed.len() > 0 {
            row := claimed.pop() ?? break
            done.push(row)
        }
    }
}

// The function memory plan of the program tables' graph, which staged values
// never change (sema_function_memory_plan_from_graph).
sema_comptime_precheck_memory_plan: fn(shared_state: Shared<SemaPrecheckShared>, memory_plan: &[SemaFunctionMemoryPlan]) {
    inputs: shared_state.guard_read()
    // Passed straight through: a local binding of a guarded row would copy it.
    sema_comptime_precheck_memory_plan_of(inputs.value.programs[0], memory_plan)
}

sema_comptime_precheck_memory_plan_of: fn(program: SemaProgramTables, memory_plan: &[SemaFunctionMemoryPlan]) {
    if program.registration_graph == .Val(graph) -> memory_plan.push(sema_function_memory_plan_from_graph(graph))
}

// One thread: checks the jobs it claims until none is left, each against its
// module's environment on the thread's light copy of that module's probe
// scope, made when the thread claims a job of a module other than its
// previous job's; host callbacks are withheld.
sema_comptime_precheck_claimed: fn(shared_state: Shared<SemaPrecheckShared>, plan: Shared<SemaPrecheckPlan>) -> [SemaPrecheckDone] {
    inputs: shared_state.guard_read()
    jobs: plan.guard_read()
    wanted: Shared{SemaHostHookWanted{wanted: false}}
    probe := sema_comptime_probe_init(None)
    current := -1
    claimed := [SemaPrecheckDone]{}
    loop {
        claim: sema_comptime_precheck_claim(jobs.value)
        if claim.position < 0 -> break
        if claim.wave_module != current {
            current = claim.wave_module
            probe = sema_comptime_precheck_thread_probe(inputs.value.module_environments[current], inputs.value.probes[current], wanted)
        }
        sema_host_hook_unwant(wanted)
        // Passed straight through: a local binding of a guarded row would copy it.
        check := sema_check_comptime_item_in(inputs.value.module_environments[current], inputs.value.programs[0], probe, inputs.value.available[0], inputs.value.sources[0][claim.position])
        if sema_host_hook_was_wanted(wanted) {
            claimed.push(SemaPrecheckDone{position: claim.position, check: None})
        } else {
            check.folded = sema_comptime_precheck_fold(check, inputs.value.sources[0][claim.position])
            claimed.push(SemaPrecheckDone{position: claim.position, check: Val(check.move())})
        }
    }
    claimed
}

// The literal fold of a precheck's call-free request, on its own thread, so
// the driver's turn takes a generated table's value instead of folding it on
// the main thread. No constant has landed for it: a request that reads one
// does not fold here and folds at its turn.
sema_comptime_precheck_fold: fn(check: SemaComptimeItemCheck, source: SemaComptimeItemSource) -> TComptimeValue? Never! {
    if !check.complete || check.waiting_dependencies.len() > 0 || source.kind == SemaComptimeItemKind.CheckedText -> return None
    if check.request == .Val(request) {
        if request.calls.len() == 0 -> return sema_comptime_fold(request.expression.tree, request.expression.root, [SemaComptimeItemValue]{})
    }
    None
}

sema_comptime_precheck_claim: fn(plan: SemaPrecheckPlan) -> SemaPrecheckClaim {
    rank: plan.next.add(1)
    if rank >= plan.order.len() -> return SemaPrecheckClaim{position: -1, wave_module: -1}
    job: plan.order[rank]
    SemaPrecheckClaim{position: plan.positions[job], wave_module: plan.modules[job]}
}

// The constants `references` name that have no compile-time value yet. A
// staged value is looked up only for the referenced keys: the values are
// scanned once for those keys, instead of keying every staged value (and
// copying it into a map) on each of the run's item checks.
sema_comptime_dependencies_from_references: fn(graph: SemaRegistrationGraph, references: [SemaNameReferenceFact], values: [SemaComptimeItemValue]) -> [String] Never! {
    dependencies := [String]{}
    if references.len() == 0 -> return dependencies
    wanted := [String:Bool]{}
    loop reference in references {
        if reference.symbol.kind == SymbolKind.Constant -> wanted[reference.symbol.id.key] = true
    }
    if wanted.len() == 0 -> return dependencies
    // "{module identity}|{key}" of every staged constant value a reference
    // can name (sema_comptime_constant_values keys values the same way).
    staged := [String:Bool]{}
    loop value in values {
        if value.kind != SemaComptimeItemKind.Constant -> next
        if wanted.get(value.key) == None -> next
        staged["{value.module_identity}|{value.key}"] = true
    }
    seen := [String:Bool]{}
    loop reference in references {
        if reference.symbol.kind != SymbolKind.Constant -> next
        if seen.get(reference.symbol.id.key) != None -> next
        if staged.get("{reference.symbol.module_name}|{reference.symbol.id.key}") != None -> next
        if sema_comptime_constant_has_ast_value(graph, reference.symbol.module_name, reference.symbol.id.key) -> next
        seen[reference.symbol.id.key] = true
        dependencies.push(reference.symbol.id.key)
    }
    dependencies
}

// The constant keys of one staging run that have a compile-time value: every
// graph constant with an AST value (staged values never change those), plus
// the key of every constant value staged so far. Built once per run and
// extended as values land, instead of rescanning every value and every
// module's constants for each waiting check.
SemaComptimeAvailableConstants: struct {
    keys: [String:Bool]
    // How many of the run's append-only values `keys` already covers.
    counted_values: Int
    // Canonical first Constant position, with module/key kept separate.
    // The same append-only frontier indexes these once for staged lowering.
    constant_modules: [String:Int]{[String:Int]{}}
    constant_rows: [[String:Int]]{[[String:Int]]{}}
    indexed_constants: Int{0}
    // Fixed declaration topology of this run's graph: heads by key and
    // integer next links retain ALL matching declarations in original order.
    declaration_heads: [[String:Int]]{[[String:Int]]{}}
    declaration_next: [[Int]]{[[Int]]{}}
    indexed_declarations: Int{0}
}

sema_comptime_available_constants: fn(graph: SemaRegistrationGraph, values: [SemaComptimeItemValue]) -> SemaComptimeAvailableConstants Never! {
    available := SemaComptimeAvailableConstants{keys: [String:Bool]{}, counted_values: 0}
    loop module_index in 0..<graph.modules.len() {
        available.declaration_heads.push([String:Int]{})
        available.declaration_next.push([Int]{})
        loop constant_index in 0..<graph.modules[module_index].constants.len() {
            if graph.modules[module_index].constants[constant_index].declaration.ct != None -> available.keys[graph.modules[module_index].constants[constant_index].symbol.id.key] = true
            available.declaration_next[module_index].push(-1)
        }
        constant_index := graph.modules[module_index].constants.len()
        loop constant_index > 0 {
            constant_index -= 1
            key: graph.modules[module_index].constants[constant_index].symbol.id.key
            available.declaration_next[module_index][constant_index] = available.declaration_heads[module_index].get(key) ?? -1
            available.declaration_heads[module_index][key] = constant_index
            available.indexed_declarations += 1
        }
    }
    sema_comptime_available_constants_add(available, values)
    available
}

// Counts the values that landed since the last call.
sema_comptime_available_constants_add: fn(available: &SemaComptimeAvailableConstants, values: [SemaComptimeItemValue]) Never! {
    loop index in available.counted_values..<values.len() {
        if values[index].kind == SemaComptimeItemKind.Constant {
            available.keys[values[index].key] = true
            slot: sema_comptime_index_module_slot(available.constant_modules, available.constant_rows, values[index].module_identity)
            if available.constant_rows[slot].get(values[index].key) == None -> available.constant_rows[slot][values[index].key] = index
            available.indexed_constants += 1
        }
    }
    if values.len() > available.counted_values -> available.counted_values = values.len()
}

sema_comptime_waiting_dependencies: fn(available: SemaComptimeAvailableConstants, dependencies: [String]) -> [String] Never! {
    waiting := [String]{}
    loop key in dependencies {
        if available.keys.get(key) == None -> waiting.push(key.copy())
    }
    waiting
}

sema_comptime_find_function_source_by_key: fn(graph: SemaRegistrationGraph, function_key: String) -> SemaComptimeFunctionSource? {
    sema_comptime_indexed_function_source(graph, -1, function_key)
}

// Every registered function a compile-time body calls runs while building,
// wherever it is declared: the callee's own file resolves its names, and the
// evaluator's effect gate (E3401) rejects an effectful call. A function need
// not be marked `#run fn` or `pure` to be reached.
sema_comptime_reachable_function_keys: fn(graph: SemaRegistrationGraph, call_facts: [SemaCallSiteFact]) -> [String] Never! {
    keys := [String]{}
    seen := [String:Bool]{}
    loop fact in call_facts {
        callee: fact.callee ?? next
        if seen.get(callee.key) != None -> next
        if sema_comptime_find_function_source_by_key(graph, callee.key) == None -> next
        seen[callee.key] = true
        keys.push(callee.key)
    }
    keys
}

// The `close` methods the drops in checked tree `tree` (of module
// `module_identity`) run, each added to `keys` once: no call fact records
// them. JetIR closes a value a call or a literal makes when it drops (a
// temporary at its statement's end, a binding at its scope's end) and a
// place's old value when an assignment writes it, and a value closes each of
// its fields and payloads that closes (ir_close_glue). A compile-time
// closure checks each like a callee, so their call sites count toward the
// evaluation's purity: a local value whose drops print runs with the program.
sema_comptime_drop_close_keys: fn(graph: SemaRegistrationGraph, tree: BodyTree, module_identity: String, keys: &[String]) {
    dropped := [Int]{}
    loop node in tree.nodes {
        made: node.kind == .Call(_, _, _) || node.kind == .IndirectCall(_, _, _, _) || node.kind == .MethodCall(_, _, _, _) || node.kind == .StaticCall(_, _, _, _, _) || node.kind == .CoreCall(_, _, _, _, _, _) || node.kind == .StructLit(_) || node.kind == .EnumCtor(_, _, _)
        if made -> dropped.push(node.id)
    }
    loop statement in tree.stmts {
        if statement == .Assign(_, _, value, _, _) -> dropped.push(value)
    }
    seen := [String:Bool]{}
    loop id in dropped {
        type_id: checked_expr_type_id(tree.expr_types, id) ?? next
        sema_comptime_close_methods_add(graph, tree.types.types[type_id], module_identity, seen, keys)
    }
}

// The `close` methods of the `Close` implementations of each nominal type
// `ty` holds, itself or as an element, member, argument, field or payload,
// `ty` named from module `module_identity`; `seen` holds the nominal keys
// already read.
sema_comptime_close_methods_add: fn(graph: SemaRegistrationGraph, ty: Type, module_identity: String, seen: &[String:Bool], keys: &[String]) {
    if ty == {
        .List(element) | .Option(element) | .Shared(element) | .Tagged(_, element) | .FixedList(element, _) -> sema_comptime_close_methods_add(graph, element, module_identity, seen, keys)
        .Map(key, _, value) -> {
            sema_comptime_close_methods_add(graph, key, module_identity, seen, keys)
            sema_comptime_close_methods_add(graph, value, module_identity, seen, keys)
        }
        .Result(ok, err) -> {
            sema_comptime_close_methods_add(graph, ok, module_identity, seen, keys)
            sema_comptime_close_methods_add(graph, err, module_identity, seen, keys)
        }
        .Tuple(fields) -> loop field in fields -> sema_comptime_close_methods_add(graph, field.ty, module_identity, seen, keys)
        .Union(members) -> loop member in members -> sema_comptime_close_methods_add(graph, member, module_identity, seen, keys)
        .Named(_) | .Apply(_, _) -> {
            if ty == .Apply(_, args) {
                loop arg in args -> sema_comptime_close_methods_add(graph, arg, module_identity, seen, keys)
            }
            row: sema_type_resolve_nominal_row(graph, ty, module_identity) ?? return
            nominal_key: graph.modules[row.module_index].nominals[row.row].symbol.id.key
            if seen.get(nominal_key) != None -> return
            seen[nominal_key.copy()] = true
            loop reference in sema_registration_impl_rows_named(graph, graph.modules[row.module_index].nominals[row.row].symbol.name) {
                implementation: graph.modules[reference.module_index].impls[reference.row]
                symbol_name: if implementation.trait_symbol == .Val(trait_symbol) -> trait_symbol.name.copy() else -> ""
                if implementation.trait_name != Val("Close") && symbol_name != "Close" -> next
                if sema_type_graph_impl_target_nominal_key(graph, implementation) != Val(nominal_key) -> next
                loop method in implementation.methods {
                    if method.symbol.name == "close" -> sema_comptime_close_key_add(graph, keys, method.symbol.id.key)
                }
            }
            // An `impl Close { … }` block in the type's own body, whose
            // methods the nominal registers.
            if graph.modules[row.module_index].nominals[row.row].source == .SourceAST(item) {
                loop block in sema_registration_item_trait_blocks(item) {
                    if block.trait_name != "Close" -> next
                    loop method in graph.modules[row.module_index].nominals[row.row].methods {
                        if method.symbol.name != "close" -> next
                        loop written in block.methods {
                            if written.span == method.declaration.span -> sema_comptime_close_key_add(graph, keys, method.symbol.id.key)
                        }
                    }
                }
            }
            owner_identity: graph.modules[row.module_index].module_identity
            loop field in graph.modules[row.module_index].nominals[row.row].fields -> sema_comptime_close_methods_add(graph, field.ty, owner_identity, seen, keys)
            loop variant in graph.modules[row.module_index].nominals[row.row].variants {
                if variant.payload_type == .Val(payload) -> sema_comptime_close_methods_add(graph, payload, owner_identity, seen, keys)
            }
        }
        .Int | .Float | .Bool | .String | .Char | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Quantity(_, _) | .Measure(_) -> {}
    }
}

sema_comptime_close_key_add: fn(graph: SemaRegistrationGraph, keys: &[String], key: String) {
    if keys.contains(key) || sema_comptime_find_function_source_by_key(graph, key) == None -> return
    keys.push(key.copy())
}

// The `encode` (under `encode`) and `decode` (under `decode`) methods a codec
// target `ty` reaches by owner type (JetIR ir_serde_encode and
// ir_dyn_decode), which no call fact records, `ty` named from module
// `module_identity`: the Encode and Decode implementations of each nominal
// type `ty` holds, itself or as an element, member or argument. A generated
// codec the body pass has not demanded yet is checked with the body its
// demand would give it (sema_codec_pending_body).
sema_comptime_codec_methods: fn(graph: SemaRegistrationGraph, ty: Type, module_identity: String, encode: Bool, decode: Bool) -> [(module_identity: String, key: String)] {
    found := [(module_identity: String, key: String)]{}
    sema_comptime_codec_methods_add(graph, ty, module_identity, encode, decode, found)
    found
}

sema_comptime_codec_methods_add: fn(graph: SemaRegistrationGraph, ty: Type, module_identity: String, encode: Bool, decode: Bool, found: &[(module_identity: String, key: String)]) {
    if ty == {
        .List(element) | .Option(element) | .Shared(element) | .Tagged(_, element) | .FixedList(element, _) -> sema_comptime_codec_methods_add(graph, element, module_identity, encode, decode, found)
        .Map(key, _, value) -> {
            sema_comptime_codec_methods_add(graph, key, module_identity, encode, decode, found)
            sema_comptime_codec_methods_add(graph, value, module_identity, encode, decode, found)
        }
        .Result(ok, _) -> sema_comptime_codec_methods_add(graph, ok, module_identity, encode, decode, found)
        .Tuple(fields) -> loop field in fields -> sema_comptime_codec_methods_add(graph, field.ty, module_identity, encode, decode, found)
        .Union(members) -> loop member in members -> sema_comptime_codec_methods_add(graph, member, module_identity, encode, decode, found)
        .Named(_) | .Apply(_, _) -> {
            if ty == .Apply(_, args) {
                loop arg in args -> sema_comptime_codec_methods_add(graph, arg, module_identity, encode, decode, found)
            }
            row: sema_type_resolve_nominal_row(graph, ty, module_identity) ?? return
            nominal_name: graph.modules[row.module_index].nominals[row.row].symbol.name
            nominal_key: graph.modules[row.module_index].nominals[row.row].symbol.id.key
            loop reference in sema_registration_impl_rows_named(graph, nominal_name) {
                implementation: graph.modules[reference.module_index].impls[reference.row]
                symbol_name: if implementation.trait_symbol == .Val(trait_symbol) -> trait_symbol.name.copy() else -> ""
                method_name: if {
                    decode && (implementation.trait_name == Val("Decode") || symbol_name == "Decode") -> "decode"
                    encode && (implementation.trait_name == Val("Encode") || symbol_name == "Encode") -> "encode"
                    else -> ""
                }
                if method_name == "" -> next
                if sema_codec_impl_pending(implementation) && sema_codec_pending_body(graph, reference.module_index, reference.row, method_name) == None -> next
                if sema_type_graph_impl_target_nominal_key(graph, implementation) != Val(nominal_key) -> next
                loop method in implementation.methods {
                    if method.symbol.name == method_name -> found.push((module_identity: graph.modules[reference.module_index].module_identity.copy(), key: method.symbol.id.key.copy()))
                }
            }
            // An `impl Encode { … }` or `impl Decode { … }` block in the
            // type's own body, whose methods the nominal registers.
            if graph.modules[row.module_index].nominals[row.row].source == .SourceAST(item) {
                loop block in sema_registration_item_trait_blocks(item) {
                    method_name: if {
                        decode && block.trait_name == "Decode" -> "decode"
                        encode && block.trait_name == "Encode" -> "encode"
                        else -> ""
                    }
                    if method_name == "" -> next
                    loop method in graph.modules[row.module_index].nominals[row.row].methods {
                        if method.symbol.name != method_name -> next
                        loop written in block.methods {
                            if written.span == method.declaration.span -> found.push((module_identity: graph.modules[row.module_index].module_identity.copy(), key: method.symbol.id.key.copy()))
                        }
                    }
                }
            }
        }
        .Int | .Float | .Bool | .String | .Char | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Quantity(_, _) | .Measure(_) -> {}
    }
}

// The `display` (Display) and `show` (Printable) methods a value of type `ty`
// renders through, `ty` named from module `module_identity`. Lowering selects
// them by owner type for an interpolation, a `print` and a nested value's
// text (JetIR ir_render), and no call fact records them. Each nominal type
// `ty` holds, itself or as an element, member, argument, field or payload,
// adds its own; `seen` holds the nominal keys already read.
sema_comptime_render_methods: fn(graph: SemaRegistrationGraph, ty: Type, module_identity: String, seen: &[String:Bool]) -> [(module_identity: String, key: String)] {
    found := [(module_identity: String, key: String)]{}
    sema_comptime_render_methods_add(graph, ty, module_identity, seen, found)
    found
}

sema_comptime_render_methods_add: fn(graph: SemaRegistrationGraph, ty: Type, module_identity: String, seen: &[String:Bool], found: &[(module_identity: String, key: String)]) {
    if ty == {
        .List(element) | .Option(element) | .Shared(element) | .Tagged(_, element) | .FixedList(element, _) -> sema_comptime_render_methods_add(graph, element, module_identity, seen, found)
        .Map(key, _, value) -> {
            sema_comptime_render_methods_add(graph, key, module_identity, seen, found)
            sema_comptime_render_methods_add(graph, value, module_identity, seen, found)
        }
        .Result(ok, err) -> {
            sema_comptime_render_methods_add(graph, ok, module_identity, seen, found)
            sema_comptime_render_methods_add(graph, err, module_identity, seen, found)
        }
        .Tuple(fields) -> loop field in fields -> sema_comptime_render_methods_add(graph, field.ty, module_identity, seen, found)
        .Union(members) -> loop member in members -> sema_comptime_render_methods_add(graph, member, module_identity, seen, found)
        .Named(_) | .Apply(_, _) -> {
            if ty == .Apply(_, args) {
                loop arg in args -> sema_comptime_render_methods_add(graph, arg, module_identity, seen, found)
            }
            row: sema_type_resolve_nominal_row(graph, ty, module_identity) ?? return
            nominal: graph.modules[row.module_index].nominals[row.row]
            if seen.get(nominal.symbol.id.key) != None -> return
            seen[nominal.symbol.id.key.copy()] = true
            loop reference in sema_registration_impl_rows_named(graph, nominal.symbol.name) {
                implementation: graph.modules[reference.module_index].impls[reference.row]
                symbol_name: if implementation.trait_symbol == .Val(trait_symbol) -> trait_symbol.name.copy() else -> ""
                written: if implementation.trait_name == .Val(name) -> name.copy() else -> ""
                method_name: sema_comptime_render_method_name(written, symbol_name)
                if method_name == "" -> next
                if sema_type_graph_impl_target_nominal_key(graph, implementation) != Val(nominal.symbol.id.key) -> next
                loop method in implementation.methods {
                    if method.symbol.name == method_name -> found.push((module_identity: graph.modules[reference.module_index].module_identity.copy(), key: method.symbol.id.key.copy()))
                }
            }
            // An `impl Display { … }` or `impl Printable { … }` block in the
            // type's own body, whose methods the nominal registers.
            if nominal.source == .SourceAST(item) {
                loop block in sema_registration_item_trait_blocks(item) {
                    method_name: sema_comptime_render_method_name(block.trait_name, block.trait_name)
                    if method_name == "" -> next
                    loop method in nominal.methods {
                        if method.symbol.name != method_name -> next
                        loop written in block.methods {
                            if written.span == method.declaration.span -> found.push((module_identity: graph.modules[row.module_index].module_identity.copy(), key: method.symbol.id.key.copy()))
                        }
                    }
                }
            }
            owner_identity: graph.modules[row.module_index].module_identity
            loop field in nominal.fields -> sema_comptime_render_methods_add(graph, field.ty, owner_identity, seen, found)
            loop variant in nominal.variants {
                if variant.payload_type == .Val(payload) -> sema_comptime_render_methods_add(graph, payload, owner_identity, seen, found)
            }
        }
        .Int | .Float | .Bool | .String | .Char | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Quantity(_, _) | .Measure(_) -> {}
    }
}

// The rendering method a trait named `written` (or resolved as `resolved`)
// selects: `display` for Display, `show` for Printable, else none.
sema_comptime_render_method_name: fn(written: String, resolved: String) -> String {
    if written == "Display" || resolved == "Display" -> return "display"
    if written == "Printable" || resolved == "Printable" -> return "show"
    ""
}

// The `close` method a value of type `ty` runs when it is closed, `ty` named
// from module `module_identity`: the Close implementation of the nominal type
// `ty` is. Lowering calls it by owner type, for a `close(value)`, a deferred
// close and the drop that ends the value's scope, and no call fact records
// it (sema_call_check_ambient_close).
sema_comptime_close_methods: fn(graph: SemaRegistrationGraph, ty: Type, module_identity: String) -> [(module_identity: String, key: String)] {
    found := [(module_identity: String, key: String)]{}
    owner: sema_expr_unwrap_tag(ty)
    if !(owner == .Named(_) || owner == .Apply(_, _)) -> return found
    row: sema_type_resolve_nominal_row(graph, owner, module_identity) ?? return found
    nominal: graph.modules[row.module_index].nominals[row.row]
    loop reference in sema_registration_impl_rows_named(graph, nominal.symbol.name) {
        implementation: graph.modules[reference.module_index].impls[reference.row]
        symbol_name: if implementation.trait_symbol == .Val(trait_symbol) -> trait_symbol.name.copy() else -> ""
        if implementation.trait_name != Val("Close") && symbol_name != "Close" -> next
        if sema_type_graph_impl_target_nominal_key(graph, implementation) != Val(nominal.symbol.id.key) -> next
        loop method in implementation.methods {
            if method.symbol.name == "close" -> found.push((module_identity: graph.modules[reference.module_index].module_identity.copy(), key: method.symbol.id.key.copy()))
        }
    }
    // An `impl Close { … }` block in the type's own body, whose method the
    // nominal registers.
    if nominal.source == .SourceAST(item) {
        loop block in sema_registration_item_trait_blocks(item) {
            if block.trait_name != "Close" -> next
            loop method in nominal.methods {
                if method.symbol.name != "close" -> next
                loop written in block.methods {
                    if written.span == method.declaration.span -> found.push((module_identity: graph.modules[row.module_index].module_identity.copy(), key: method.symbol.id.key.copy()))
                }
            }
        }
    }
    found
}

// Why the call sites `call_facts` keep an evaluation from running while
// building, or None when they keep it pure: a call reaches a foreign body,
// names an effect outside `Panic` and `Mem` in its row (files, network,
// processes, environment, clock, randomness, stdin, host or comptime IO
// authority), or calls a body this program lacks without a row (an unknown
// callee is maximal). A callee with a body is read through its own call sites
// (the item's checked closure). Effects never run while building: a module
// value whose evaluation is not pure is a build error (E0643). With
// `runtime_runs` (a local value), a call the runtime answers is refused too,
// whatever its row: a Core call a runtime export answers, or a runtime
// binding or other foreign body. Their rows grant authority but don't prove
// the call pure: the runtime reads the process it runs in (the live and auth
// registry cells, the clocks, the pid, entropy, the task and its cancel
// state), and the compiler's own process would stand in for every run's. So
// is a call of a `#Memo` function: its result store and the hit and miss
// counts `name.cache()` reads belong to the running program, and a call
// computed while building would never reach them.
sema_comptime_call_facts_impurity: fn(graph: SemaRegistrationGraph, call_facts: [SemaCallSiteFact], runtime_runs: Bool) -> String? Never! {
    loop fact in call_facts {
        name: if fact.callee == .Val(callee) -> "`{sema_effect_comptime_callee_name(callee.key)}`" else if fact.intrinsic_api == .Val(api) -> "`{api}`" else -> "a function value"
        if fact.foreign_effect_root != None -> return Val("it calls foreign code ({name})")
        if runtime_runs && fact.runtime_export -> return Val("it calls {name}, which the runtime answers from the running program")
        if runtime_runs && fact.callee == .Val(callee) {
            if sema_registration_callable_row(graph, callee.key) == .Val(row) {
                if row == {
                    .Foreign(_, _) -> return Val("it calls foreign code ({name})")
                    .Function(declaring, index) -> {
                        if sema_guest_runtime_binding(graph.modules[declaring].package_identity, graph.modules[declaring].functions[index].declaration) -> return Val("it calls {name}, which the runtime answers from the running program")
                    }
                    .NominalMethod(_, _, _) | .ImplMethod(_, _, _) -> {}
                }
                if sema_comptime_callable_memoized(graph, row) -> return Val("it calls {name}, a `#Memo` function whose result store the running program keeps")
            }
        }
        if fact.facts.effect_bound == .Val(row) {
            // A call with no named callee (a built-in such as `print`, or a
            // function value) is reported as the evaluation's own effect.
            reaches: if fact.callee == None -> "it" else -> name
            loop entry in row {
                if !sema_comptime_effect_pure(entry.name) -> return Val("{reaches} reaches the outside world ({entry.name})")
            }
            next
        }
        callee: fact.callee ?? return Val("it calls a function value, which doesn't run while building")
        callable: sema_registration_callable_row(graph, callee.key) ?? return Val("it calls {name}, which has no body here")
        if callable == .Foreign(_, _) -> return Val("it calls foreign code ({name})")
    }
    None
}

// Whether callable `row` is a `#Memo` function or method, read from its
// declaration in place.
sema_comptime_callable_memoized: fn(graph: SemaRegistrationGraph, row: SemaRegistrationCallableRow) -> Bool Never! {
    memo: if row == {
        .Function(module_index, index) -> sema_function_header_memo_config(graph.modules[module_index].functions[index].declaration)
        .NominalMethod(module_index, owner, index) -> sema_function_header_memo_config(graph.modules[module_index].nominals[owner].methods[index].declaration)
        .ImplMethod(module_index, owner, index) -> sema_function_header_memo_config(graph.modules[module_index].impls[owner].methods[index].declaration)
        .Foreign(_, _) -> SemaMemoConfig{bound: None, unbounded: false}
    }
    memo.bound != None || memo.unbounded
}

// Why checked closure body `function` keeps a value from being computed while
// building, or None. A body that takes a raw address or makes a pointer from
// one names storage only the running program has: a computed value would bake
// an address that points at nothing (an expired sentry frame reads as no
// allocation at all). With `unsafe_runs` (a local value, which the running
// program computes otherwise), an `#Unsafe` function or block is also
// refused: its effect row is a claim the compiler can't check, so the call
// runs in the program whatever the row says (#6758: host reads and unchecked
// code are never baked in at build time). So is a `#Memo` function: the
// program reads its result store (`name.cache()`), so each call must reach the
// store at run time. So is a body that reads `#phase`: the program's copy
// reads `.Runtime` there, which a value computed while compiling would turn
// into `.Preparation`.
sema_comptime_body_unfoldable: fn(function: FnBody, unsafe_runs: Bool) -> String? Never! {
    name: "`{sema_effect_comptime_callee_name(function.key)}`"
    loop node in function.tree.nodes {
        if node.kind == .RawOf(_) || node.kind == .RawAddressOf(_) -> return Val("it calls {name}, which takes a raw address only the running program has")
        if node.kind == .PtrFromAddr(_, _) -> return Val("it calls {name}, which makes a pointer only the running program can follow")
    }
    if !unsafe_runs -> return None
    if function.is_unsafe || function.unsafe_gate != None -> return Val("it calls {name}, which is `#Unsafe` code")
    if function.memo_bound != None || function.memo_unbounded -> return Val("it calls {name}, whose `#Memo` result store the program reads")
    loop statement in function.tree.stmts {
        if statement == .Unsafe(_, _) || statement == .UnsafeBlock(_, _, _) -> return Val("it calls {name}, which runs an `#Unsafe` block")
    }
    if sema_comptime_tree_reads_phase(function.tree) -> return Val("it calls {name}, which reads `#phase`, the phase of the copy that runs it")
    None
}

// Whether checked tree `tree` reads `#phase` (a CopyPhase node).
sema_comptime_tree_reads_phase: fn(tree: BodyTree) -> Bool Never! {
    loop node in tree.nodes {
        if node.kind == .CopyPhase(_, _, _, _) -> return true
    }
    false
}

// Whether effect row entry `name` names no outside-world effect: an
// exclusion (`!X`), `Panic`, or a `Mem` right.
sema_comptime_effect_pure: fn(name: String) -> Bool Never! {
    if name.starts_with("!") -> return true
    dotted: name.split(".").to_list()
    head: if dotted.len() > 0 -> dotted[0] else -> name
    parts: head.split("(").to_list()
    root: if parts.len() > 0 -> parts[0].trim() else -> head
    root == "Panic" || root == "Mem"
}

sema_comptime_checked_text_source: fn(evaluation: SemaCheckedTextEvaluation) -> SemaComptimeItemSource Never! {
    SemaComptimeItemSource{
        module_identity: evaluation.module_identity,
        key: evaluation.key,
        destination_key: evaluation.key,
        name: "{evaluation.type_name} checked text literal",
        source_file: evaluation.source_file,
        kind: SemaComptimeItemKind.CheckedText,
        expression: evaluation.source_expression,
        expected_type: Val(evaluation.ty),
        span: evaluation.span,
        dependencies: evaluation.dependencies,
        checked_text: Val(evaluation),
    }
}

// The comptime sources one module contributes, with the `module\nkey` of
// each, so a repeated key is found without rescanning the list. Their
// constant dependencies come from the run's item checks
// (sema_check_comptime_item_in).
SemaComptimeSourceList: struct {
    items: [SemaComptimeItemSource]
    keys: [String:Bool]
    // The prelude's applied rules, read at the module's first marker argument.
    marker_rules: [TAppliedRule]?
}

sema_comptime_add_source: fn(sources: &SemaComptimeSourceList, graph: SemaRegistrationGraph, module_identity: String, key: String, destination_key: String, name: String, kind: SemaComptimeItemKind, expression: Expr, expected_type: Type?) {
    source_key: "{module_identity}\n{key}"
    if sources.keys.get(source_key) != None -> return
    module_index: sema_registration_module_index(graph, module_identity) ?? return
    source_module: graph.modules[module_index]
    source: SemaComptimeItemSource{
        module_identity: module_identity,
        key: key,
        destination_key: destination_key,
        name: name,
        source_file: source_module.source_file,
        kind: kind,
        expression: expression,
        expected_type: expected_type,
        span: expr_span(expression),
        dependencies: [String]{},
        checked_text: None,
    }
    sources.items.push(source)
    sources.keys[source_key] = true
}

sema_comptime_add_marker_source: fn(sources: &SemaComptimeSourceList, graph: SemaRegistrationGraph, module_identity: String, owner_key: String, marker: Marker, expected_type: Type?) {
    // A type's `#FX(…)` is its effect cap, read by the parser, not a value.
    if marker.ct != None || marker.args.len() == 0 || marker.name == MARKER_FX -> return
    if sources.marker_rules == None -> sources.marker_rules = Val(sema_marker_module_prelude_rules())
    if sources.marker_rules == .Val(rules) {
        if !sema_marker_module_first_argument_evaluates(rules, marker) -> return
    }
    if marker.args[0] == {
        .Expr(expression) -> {
            destination_key := "{owner_key}::marker::{marker.name}::{marker.name_span.start}"
            key := "{module_identity}::{destination_key}"
            sema_comptime_add_source(sources, graph, module_identity, key, destination_key, marker.name, SemaComptimeItemKind.MarkerArgument, expression, expected_type)
        }
        .EffectRow(_, _) -> {}
    }
}

sema_comptime_add_meta_sources: fn(sources: &SemaComptimeSourceList, graph: SemaRegistrationGraph, module_identity: String, owner_key: String, meta: MetaAttr?) {
    if meta == None -> return
    value: meta
    loop field in value.fields {
        if field == {
            .Category(expression, span) -> {
                destination_key := "{owner_key}::meta::category::{span.start}"
                sema_comptime_add_source(sources, graph, module_identity, "{module_identity}::{destination_key}", destination_key, "category", SemaComptimeItemKind.MarkerArgument, expression, Val(Type.String))
            }
            .Unknown(name, expression, span) -> {
                if expression == .Val(source_expression) {
                    destination_key := "{owner_key}::meta::{name}::{span.start}"
                    sema_comptime_add_source(sources, graph, module_identity, "{module_identity}::{destination_key}", destination_key, name, SemaComptimeItemKind.MarkerArgument, source_expression, None)
                }
            }
            // `maturity:` names the parser's closed documentation scale, read
            // from `Func.maturity`; it is no evaluated value.
            .Tunable(_) | .Maturity(_, _) -> {}
        }
    }
}

// Only a function's `#Meta` fields are sources, so the caller formats the
// owner key of a function with a `#Meta` alone (sema_comptime_function_has_sources).
sema_comptime_add_function_sources: fn(sources: &SemaComptimeSourceList, graph: SemaRegistrationGraph, source_module: SemaRegistrationModule, function: Func, owner_key: String) {
    // A function or method marker sits on a dynamic site: Rust
    // `CheckerMarkers::resolve_static_rule_products` (`static_product_site`)
    // stages no value for it and discards its evaluation errors, because its
    // arguments may be menu words (`#Inline(Always)`, `#Job(.Dev)`) or name
    // locals; ordinary marker validation reads those arguments instead.
    sema_comptime_add_meta_sources(sources, graph, source_module.module_identity, owner_key, function.meta)
}

// Whether sema_comptime_add_function_sources adds any source for `function`.
sema_comptime_function_has_sources: fn(function: Func) -> Bool Never! {
    function.meta != None
}

sema_comptime_nominal_position: fn(source_module: SemaRegistrationModule, name: String) -> Int? {
    loop (position, nominal) in source_module.nominals {
        if nominal.symbol.name == name -> return Val(position)
    }
    None
}

sema_comptime_add_module_item_sources: fn(sources: &SemaComptimeSourceList, graph: SemaRegistrationGraph, source_module: SemaRegistrationModule, item: Item) {
    if item == {
        .Func(function) -> {
            if !sema_comptime_function_has_sources(function) -> return
            owner_key := symbol_id(SymbolKind.Function, source_module.module_identity, "", function.name).key
            sema_comptime_add_function_sources(sources, graph, source_module, function, owner_key)
        }
        .Struct(definition) -> {
            position: sema_comptime_nominal_position(source_module, definition.name) ?? return
            nominal: source_module.nominals[position]
            loop marker in definition.serde_markers -> sema_comptime_add_marker_source(sources, graph, source_module.module_identity, nominal.symbol.id.key, marker, None)
            loop marker in definition.type_markers -> sema_comptime_add_marker_source(sources, graph, source_module.module_identity, nominal.symbol.id.key, marker, None)
            loop field in definition.fields {
                field_symbol := Symbol?{None}
                loop registered in nominal.fields {
                    if registered.symbol.name == field.name -> field_symbol = Val(registered.symbol)
                }
                if field_symbol != None {
                    symbol: field_symbol ?? return
                    // Rust CheckerMarkers evaluates every `field: T{expr}`
                    // default opportunistically; construction lowers the default
                    // expression itself, so only a baked default must evaluate.
                    if field.default != None && field.default_ct == None {
                        expression: field.default ?? Expr.Unit{span: field.name_span, id: AST_NODE_GENERATED}
                        destination_key := symbol.id.key
                        key := "{destination_key}::default"
                        added: sources.items.len()
                        sema_comptime_add_source(sources, graph, source_module.module_identity, key, destination_key, "{definition.name}.{field.name}", SemaComptimeItemKind.FieldDefault, expression, Val(field.ty))
                        if sources.items.len() > added -> sources.items[added].baked_default = sema_comptime_struct_bakes_defaults(definition.derives)
                    }
                    // A field marker's argument has its rule's own parameter type
                    // (Rust CheckerMarkers `constant_for_source(0)`), never the field's.
                    loop marker in field.serde_markers -> sema_comptime_add_marker_source(sources, graph, source_module.module_identity, symbol.id.key, marker, None)
                }
            }
            loop function in definition.methods {
                if sema_comptime_function_has_sources(function) -> sema_comptime_add_function_sources(sources, graph, source_module, function, "{nominal.symbol.id.key}::{function.name}")
            }
            loop block in definition.trait_impls {
                loop function in block.methods {
                    if sema_comptime_function_has_sources(function) -> sema_comptime_add_function_sources(sources, graph, source_module, function, "{nominal.symbol.id.key}::{function.name}")
                }
            }
        }
        .Enum(definition) -> {
            position: sema_comptime_nominal_position(source_module, definition.name) ?? return
            nominal: source_module.nominals[position]
            loop marker in definition.serde_markers -> sema_comptime_add_marker_source(sources, graph, source_module.module_identity, nominal.symbol.id.key, marker, None)
            loop marker in definition.type_markers -> sema_comptime_add_marker_source(sources, graph, source_module.module_identity, nominal.symbol.id.key, marker, None)
            loop variant in definition.variants {
                if variant.discriminant_expr != None && variant.discriminant == None {
                    registered_symbol := Symbol?{None}
                    loop registered in nominal.variants {
                        if registered.symbol.name == variant.name -> registered_symbol = Val(registered.symbol)
                    }
                    if registered_symbol != None {
                        symbol: registered_symbol ?? return
                        expression: variant.discriminant_expr ?? Expr.Unit{span: variant.name_span, id: AST_NODE_GENERATED}
                        destination_key := symbol.id.key
                        key := "{destination_key}::discriminant"
                        sema_comptime_add_source(sources, graph, source_module.module_identity, key, destination_key, "{definition.name}.{variant.name}", SemaComptimeItemKind.TypeLevel, expression, Val(Type.Int))
                    }
                }
                loop marker in variant.serde_markers -> sema_comptime_add_marker_source(sources, graph, source_module.module_identity, "{nominal.symbol.id.key}::{variant.name}", marker, None)
            }
            loop function in definition.methods {
                if sema_comptime_function_has_sources(function) -> sema_comptime_add_function_sources(sources, graph, source_module, function, "{nominal.symbol.id.key}::{function.name}")
            }
            loop block in definition.trait_impls {
                loop function in block.methods {
                    if sema_comptime_function_has_sources(function) -> sema_comptime_add_function_sources(sources, graph, source_module, function, "{nominal.symbol.id.key}::{function.name}")
                }
            }
        }
        .Impl(definition) -> {
            loop implementation in source_module.impls {
                if implementation.declaration.type_name != definition.type_name -> next
                loop method in implementation.methods -> sema_comptime_add_function_sources(sources, graph, source_module, method.declaration, method.symbol.id.key)
            }
        }
        .Const(definition) -> {
            owner_key := symbol_id(SymbolKind.Constant, source_module.module_identity, "", definition.name).key
            sema_comptime_add_meta_sources(sources, graph, source_module.module_identity, owner_key, definition.meta)
        }
        .Distinct(definition) -> {
            owner_key := symbol_id(SymbolKind.Type, source_module.module_identity, "", definition.name).key
            loop marker in definition.type_markers -> sema_comptime_add_marker_source(sources, graph, source_module.module_identity, owner_key, marker, None)
        }
        .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
}

// Rust CheckerMarkers `needs_baked_default`: a decode/CLI shape fills a missing
// field from its compile-time default value.
sema_comptime_struct_bakes_defaults: fn(derives: [NamedSpan]) -> Bool Never! {
    loop marker in derives {
        if owned_trait_codec_marker(marker.name) || marker.name == MARKER_CLI -> return true
    }
    false
}

// The comptime sources of `source_module`, in declaration order, their
// dependencies not yet probed.
sema_comptime_collect_module_sources: fn(graph: SemaRegistrationGraph, source_module: SemaRegistrationModule) -> [SemaComptimeItemSource] {
    sources := SemaComptimeSourceList{items: [SemaComptimeItemSource]{}, keys: [String:Bool]{}, marker_rules: None}
    loop constant in source_module.constants {
        if sema_output_metadata_binding(constant.declaration) -> next
        if constant.declaration.ct != None -> next
        // Registration reports a mutable or `#Persist` binding whose value is
        // not a literal (E0622); it is never evaluated.
        module_value: sema_checked_module_value_computed(constant.declaration)
        if !module_value && !sema_checked_module_value_evaluates(constant.declaration) -> next
        expression := constant.declaration.value
        // Rust `module_scalar_const_type`: a bare decimal literal binding is a
        // Float constant, not the expression default Decimal.
        expected := constant.declaration.ty
        if expected == None && constant.declaration.value == .Float(_, _, _, _, _) -> expected = Val(Type.Float)
        if expected == None -> expected = constant.ty
        sema_comptime_add_source(sources, graph, source_module.module_identity, constant.symbol.id.key, constant.symbol.id.key, constant.declaration.name, SemaComptimeItemKind.Constant, expression, expected)
        if module_value && sources.items.len() > 0 {
            last: sources.items.len() - 1
            if sources.items[last].key == constant.symbol.id.key -> sources.items[last].module_value = true
        }
    }
    loop item in source_module.program.items -> sema_comptime_add_module_item_sources(sources, graph, source_module, item)
    items := sources.items.move()
    sources.items = [SemaComptimeItemSource]{}
    items
}

// The declaration pass makes no body check of its own (the sources'
// constant dependencies come from the run's item checks), so it takes no
// host callbacks. `graph` moves into the pass's program tables, which no
// check changes, and leaves unchanged with the stage as the comptime run's
// graph: the pass never copies it. The modules' declaration checks and the
// name facts run on up to `threads` compiler threads.
sema_collect_comptime_declarations: fn(graph: &&SemaRegistrationGraph, package_policies: [SemaRegistrationPackagePolicy], threads: CompilerThreads, trace_sink: CompilerTraceSink?) -> SemaComptimeDeclarationStage {
    diagnostics := [Diagnostic]{}
    loop diagnostic in graph.diagnostics -> diagnostics.push(diagnostic)
    complete := graph.complete
    module_count: graph.modules.len()
    modules := [SemaGraphModuleResult]{}
    body_values := sema_comptime_body_values_freeze([SemaComptimeBodyValue]{}, sema_comptime_body_work_new(trace_sink), false)
    facts := sema_pass_facts_new()
    owned := sema_pass_facts(graph, threads, SEMA_PASS_FACT_TABLES, facts)
    tables := sema_program_tables_with(owned, [TTypeDef]{}, facts.boxed_edges.move(), facts.copy_facts.move())
    initial_environment := sema_check_pass_environment_from(tables, facts.fixed_length_write_params.move(), body_values)
    initial_program := SemaProgramTables{
        registration_graph: initial_environment.registration_graph.move(),
        checked_types: initial_environment.checked_types.move(),
        checked_type_rows: initial_environment.checked_type_rows.move(),
        checked_type_name_slots: initial_environment.checked_type_name_slots.move(),
        checked_type_name_rows: initial_environment.checked_type_name_rows.move(),
        boxed_edges: initial_environment.boxed_edges.move(),
        copy_facts: initial_environment.copy_facts.move(),
    }
    initial_environment.registration_graph = None
    initial_environment.checked_types = [TTypeDef]{}
    initial_environment.checked_type_rows = [String:Int]{}
    initial_environment.checked_type_name_slots = [String:Int]{}
    initial_environment.checked_type_name_rows = [[Int]]{}
    initial_environment.boxed_edges = [String:[String]]{}
    initial_environment.copy_facts = sema_copy_facts_table_empty()
    module_state: Shared{SemaCheckShared{environments: [SemaScopeEnvironment]{}, programs: [SemaProgramTables]{}, memory_plans: [SemaFunctionMemoryPlan]{}}}
    // A declaration check reads no memory plan.
    sema_check_shared_fill(module_state, initial_environment, initial_program, sema_function_memory_plan_new())
    every_module := [Int]{}
    loop module_index in 0..<module_count -> every_module.push(module_index)
    checks := sema_check_declaration_modules(module_state, every_module, [SemaComptimeItemValue]{}, true, threads)
    pass_environment := sema_check_shared_take_environment(module_state)
    pass_program := sema_check_shared_take_program(module_state)
    checks.reverse()
    module_index := 0
    loop checks.len() > 0 {
        check := checks.pop() ?? break
        checked := check.module_result.move()
        if trace_sink == .Val(sink) {
            sema_comptime_trace_module_begin(sink, pass_program, module_index, module_count)
            sink.progress("counters.sema.check.items_scanned", check.items_scanned, -1)
            sink.progress("counters.sema.check.functions_checked", 0, -1)
            sink.progress("counters.sema.check.method_jobs", 0, -1)
            sink.progress("counters.sema.check.impl_rows_scanned", 0, -1)
            sink.end("sema.module", checked.declarations.type_defs.len() + checked.declarations.traits.len() + checked.declarations.impls.len() + checked.declarations.constants.len())
        }
        loop diagnostic in checked.diagnostics -> diagnostics.push(diagnostic)
        if !checked.complete -> complete = false
        modules.push(checked)
        module_index += 1
    }
    sources := [SemaComptimeItemSource]{}
    source_keys := [String:Bool]{}
    loop source_module_index in 0..<module_count {
        module_sources := sema_comptime_module_sources(pass_program, source_module_index)
        // Moved onto `sources` in order, without a copy.
        reversed_sources := [SemaComptimeItemSource]{}
        loop module_sources.len() > 0 {
            source: module_sources.pop() ?? break
            source_keys["{source.module_identity}\n{source.key}"] = true
            reversed_sources.push(source)
        }
        loop reversed_sources.len() > 0 {
            source: reversed_sources.pop() ?? break
            sources.push(source)
        }
    }
    loop checked_module_index in 0..<modules.len() {
        checked_module: modules[checked_module_index]
        loop request in checked_module.comptime_requests {
            evaluation: request.checked_text ?? next
            source := sema_comptime_checked_text_source(evaluation)
            source_key: "{source.module_identity}\n{source.key}"
            if source_keys.get(source_key) != None -> next
            source_keys[source_key] = true
            sources.push(source)
        }
    }
    // Recover the original graph from its tables.
    sema_comptime_body_work_flush(pass_environment.comptime_body_publication, trace_sink, "sema.check")
    imports := sema_comptime_stage_imports(pass_program)
    taken := pass_program.registration_graph.move()
    pass_graph := taken.move() ?? panic("the declaration pass lost its registration graph")
    // The name facts only read the graph: the pass's facts of it stand.
    graph_facts := SemaComptimeGraphFacts{boxed_edges: pass_program.boxed_edges.move(), copy_facts: pass_program.copy_facts.move()}
    structure_facts: sema_name_structure_facts(pass_graph)
    names := sema_name_facts_empty()
    returned := sema_name_build_facts_threads(pass_graph, modules, structure_facts, threads, names)
    // The bodies that reach a declaration a misspelled member type left
    // unusable are skipped; every other body is checked.
    if sema_has_error_since(diagnostics, 0) -> returned.unusable_bodies = sema_checked_unusable_bodies(returned)
    SemaComptimeDeclarationStage{
        modules: modules.move(),
        imports: imports.move(),
        package_policies: package_policies,
        names: names.move(),
        sources: sources,
        diagnostics: diagnostics,
        complete: complete,
        graph: Val(returned.move()),
        graph_facts: Val(graph_facts.move()),
    }
}

// The registration graph inside an owned program tables value is reached
// through these read parameters: a pattern binding of a read parameter's
// payload borrows it, whereas binding it from the owned local would copy the
// whole graph (every module's AST) natively, once per call.
sema_comptime_trace_module_begin: fn(sink: CompilerTraceSink, program: SemaProgramTables, module_index: Int, module_count: Int) {
    if program.registration_graph == .Val(registered) -> sink.begin("sema.module", registered.modules[module_index].module_path, module_index, module_count)
}

sema_comptime_stage_imports: fn(program: SemaProgramTables) -> [SemaRegistrationImport] {
    if program.registration_graph == .Val(registered) -> return registered.imports.copy()
    panic("the declaration pass lost its registration graph")
}

// Declaration-only modules against the staging run's existing program owner.
sema_comptime_modules_with_values: fn(program: SemaProgramTables, values: [SemaComptimeItemValue]) -> [SemaGraphModuleResult] {
    module_count: if program.registration_graph == {
        .Val(registered) -> registered.modules.len()
        .None -> 0
    }
    environment := sema_scope_environment_init("", "", "", "", SemaSourceOrigin.Snapshot, [SemaSourceSegment]{}, [SemaScopeDeclaration]{})
    environment.comptime_body_publication = sema_comptime_body_values_freeze(sema_comptime_body_values_from_items(values), None, false)
    modules := [SemaGraphModuleResult]{}
    loop module_index in 0..<module_count {
        scopes := sema_scope_init(sema_check_registered_module_identity(environment, program, module_index))
        checked := sema_check_registration_module_start(environment, program, module_index, values, scopes)
        // copy: a handle copy (Shared facts plus length and frontier ints): each module result
        // keeps the publication it was checked against, while the environment's publication
        // advances.
        body_values := environment.comptime_body_publication.copy()
        sema_scope_environment_enter_module(environment, program, module_index, body_values)
        items_scanned := 0
        sema_check_registration_module_program(environment, program, module_index, checked, false, items_scanned)
        sema_check_registration_module_foreign(environment, program, module_index, checked)
        modules.push(checked)
    }
    modules.move()
}

// A compiler thread is admitted for at least this many bytes of module item
// source to check declarations in.
SEMA_DECLARATION_MIN_BYTES_PER_THREAD: 65536

// The declaration check of the module at `position` of a checked module list
// (sema_check_declaration_module), the program items it scanned and, for a
// body pass (not `foreign`), the module's view summary jobs.
SemaDeclarationCheck: struct {
    position: Int
    module_result: SemaGraphModuleResult
    items_scanned: Int
    view_summary_jobs: [Int]?
}

// A module's declaration check under `values`: its declarations and program
// items, then its foreign rows when `foreign`, the checks
// sema_check_registration_module makes of a module besides its bodies. Each
// reads only the graph and the program tables, never the entered module of
// `environment`, so the modules' checks are independent of each other and of
// their order. A body pass's check also finds the module's view summary jobs
// (sema_check_sorted_view_summary_jobs), which read only the graph, so its
// summary scopes need not search for them on the calling thread.
sema_check_declaration_module: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, position: Int, values: [SemaComptimeItemValue], foreign: Bool) -> SemaDeclarationCheck {
    scopes := sema_scope_init(sema_check_registered_module_identity(environment, program, module_index))
    module_result := sema_check_registration_module_start(environment, program, module_index, values, scopes)
    items_scanned := 0
    sema_check_registration_module_program(environment, program, module_index, module_result, true, items_scanned)
    if foreign -> sema_check_registration_module_foreign(environment, program, module_index, module_result)
    view_summary_jobs := [Int]?{None}
    if !foreign -> view_summary_jobs = Val(sema_check_sorted_view_summary_jobs(environment, program, module_index))
    SemaDeclarationCheck{position: position, module_result: module_result.move(), items_scanned: items_scanned, view_summary_jobs: view_summary_jobs.move()}
}

// The declaration check (sema_check_declaration_module) of every module of
// `modules`, in that order, on up to `threads` compiler threads. The threads
// claim modules heaviest source first and read the pass environment and
// program tables of `shared_state` in place; the graph stops counting its
// lookups meanwhile, as in a body wave: every lookup would take the shared
// counters' permit and serialize the threads. Work that admits one thread
// checks on the calling thread.
sema_check_declaration_modules: fn(shared_state: Shared<SemaCheckShared>, modules: [Int], values: [SemaComptimeItemValue], foreign: Bool, threads: CompilerThreads) -> [SemaDeclarationCheck] {
    weights := [Int]{}
    scope_rows := 0
    work: sema_check_declaration_weights_in_shared(shared_state, modules, weights, scope_rows)
    workers: compiler_threads_admit(threads, modules.len(), work, SEMA_DECLARATION_MIN_BYTES_PER_THREAD, scope_rows * SEMA_BODY_SCOPE_BYTES_PER_BINDING, 0)
    checks := [SemaDeclarationCheck]{}
    if workers <= 1 {
        loop position in 0..<modules.len() -> checks.push(sema_check_declaration_module_in_shared(shared_state, modules[position], position, values, foreign))
        return checks
    }
    counting: sema_check_shared_counting(shared_state, false)
    // copy: the threads' read-only inputs; the module list and the pass's
    // comptime values are read parameters here.
    inputs: Shared{SemaDeclarationInputs{modules: modules.copy(), values: values.copy(), foreign: foreign}}
    plan: Shared{SemaDeclarationPlan{order: compiler_threads_heaviest_first(weights), next: 0}}
    placed := [SemaDeclarationCheck?]{}
    loop _ in 0..<modules.len() -> placed.push(None)
    sema_check_declaration_claimers(shared_state, inputs, plan, 0, workers, placed)
    _: sema_check_shared_counting(shared_state, counting)
    placed.reverse()
    loop placed.len() > 0 {
        slot := placed.pop() ?? break
        check := slot.move() ?? panic("a module's declaration check left its thread")
        checks.push(check)
    }
    checks
}

// Each module of `modules`' item source bytes into `weights`, the largest
// module scope (sema_check_module_scope_rows) into `scope_rows`; the total.
sema_check_declaration_weights_in_shared: fn(shared_state: Shared<SemaCheckShared>, modules: [Int], weights: &[Int], scope_rows: &Int) -> Int {
    inputs: shared_state.guard_read()
    sema_check_declaration_weights(inputs.value.programs[0], modules, weights, scope_rows)
}

sema_check_declaration_weights: fn(program: SemaProgramTables, modules: [Int], weights: &[Int], scope_rows: &Int) -> Int {
    if program.registration_graph == .Val(graph) {
        work := 0
        loop module_index in modules {
            weight := 0
            loop item_index in 0..<graph.modules[module_index].program.items.len() {
                span: sema_compiler_index_item_span(graph.modules[module_index].program.items[item_index])
                weight += span.end - span.start
            }
            weights.push(weight)
            work += weight
            rows: sema_check_module_scope_rows(graph, module_index)
            if rows > scope_rows -> scope_rows = rows
        }
        return work
    }
    panic("the declaration pass lost its registration graph")
}

sema_check_declaration_module_in_shared: fn(shared_state: Shared<SemaCheckShared>, module_index: Int, position: Int, values: [SemaComptimeItemValue], foreign: Bool) -> SemaDeclarationCheck {
    inputs: shared_state.guard_read()
    sema_check_declaration_module(inputs.value.environments[0], inputs.value.programs[0], module_index, position, values, foreign)
}

// Sets whether the graph in `shared_state`'s program tables counts its
// lookups; the old flag.
sema_check_shared_counting: fn(shared_state: Shared<SemaCheckShared>, counting: Bool) -> Bool {
    permit: shared_state.guard_edit()
    program := permit.value.programs.pop() ?? panic("the declaration program tables left the threads' shared state")
    old: sema_comptime_precheck_graph_counting(program)
    program.registration_graph = sema_comptime_precheck_counting(program.registration_graph.move(), counting)
    permit.value.programs.push(program)
    old
}

// What every declaration-check thread reads: the checked modules by
// position, the comptime values and whether foreign rows are checked.
SemaDeclarationInputs: struct {
    modules: [Int]
    values: [SemaComptimeItemValue]
    foreign: Bool
}

// The module positions in claim order: `order[rank]` is the position claimed
// at `rank`, `next` the next unclaimed rank, taken with one atomic add under
// a read guard each thread holds for its run.
SemaDeclarationPlan: struct {
    order: [Int]
    next: Atomic<Int>
}

// Runs claiming threads `from..<workers`, one task each, and moves every
// check a thread returned into its position's slot of `placed`.
sema_check_declaration_claimers: fn(shared_state: Shared<SemaCheckShared>, inputs: Shared<SemaDeclarationInputs>, plan: Shared<SemaDeclarationPlan>, from: Int, workers: Int, placed: &[SemaDeclarationCheck?]) {
    if from >= workers -> return
    task.group sema_declaration_threads {
        head: task sema_check_declaration_claimed(shared_state, inputs, plan)
        sema_check_declaration_claimers(shared_state, inputs, plan, from + 1, workers, placed)
        claimed := head.join() ?? panic(compiler_threads_failure_text(err))
        loop claimed.len() > 0 {
            check := claimed.pop() ?? break
            position: check.position
            placed[position] = Val(check.move())
        }
    }
}

// One thread: checks the modules it claims until none is left.
sema_check_declaration_claimed: fn(shared_state: Shared<SemaCheckShared>, inputs: Shared<SemaDeclarationInputs>, plan: Shared<SemaDeclarationPlan>) -> [SemaDeclarationCheck] {
    tables: shared_state.guard_read()
    rows: inputs.guard_read()
    claimed := [SemaDeclarationCheck]{}
    ranks: plan.guard_read()
    loop {
        position: sema_check_declaration_claim(ranks.value)
        if position < 0 -> break
        // Passed straight through: a local binding of a guarded row would copy it.
        claimed.push(sema_check_declaration_module(tables.value.environments[0], tables.value.programs[0], rows.value.modules[position], position, rows.value.values, rows.value.foreign))
    }
    claimed
}

sema_check_declaration_claim: fn(plan: SemaDeclarationPlan) -> Int {
    rank: plan.next.add(1)
    if rank >= plan.order.len() -> return -1
    plan.order[rank]
}

// The rows sema_comptime_modules_with_values adds for the values at `from`
// and after in `values`, checked against `resolved_graph`, which already
// carries every one of `values`. A staged value changes only its own
// constant's row among the module declarations (sema_checked_declaration_facts
// reads values only for constant rows, and applying a value only types
// constant rows of the graph, which no other declaration reads), so a run
// joins these rows to its staged modules instead of rechecking every module.
// As there, the first value of a constant key wins.
sema_comptime_staged_constant_rows: fn(resolved_graph: SemaRegistrationGraph, values: [SemaComptimeItemValue], from: Int, available: SemaComptimeAvailableConstants) -> [TConstantDef] {
    if available.counted_values != values.len() -> panic("staged constants lost their authenticated value frontier")
    if available.declaration_heads.len() != resolved_graph.modules.len() -> panic("staged constants lost their graph generation")
    rows := [TConstantDef]{}
    // Staging diagnostics are never reported (as for the module rechecks).
    diagnostics := [Diagnostic]{}
    loop index in from..<values.len() {
        value: values[index]
        if value.kind != SemaComptimeItemKind.Constant -> next
        slot: available.constant_modules.get(value.module_identity) ?? panic("a staged constant lost its indexed module")
        first: available.constant_rows[slot].get(value.key) ?? panic("a staged constant lost its canonical first position")
        if first != index -> next
        module_index: sema_registration_module_index(resolved_graph, value.module_identity) ?? next
        if available.declaration_next[module_index].len() != resolved_graph.modules[module_index].constants.len() -> panic("constant declaration topology changed inside a staging generation")
        constant_index := available.declaration_heads[module_index].get(value.key) ?? next
        staged_values := [String:SemaComptimeItemValue]{}
        staged_values[value.key] = value
        loop constant_index >= 0 {
            matched_index: constant_index
            constant_index = available.declaration_next[module_index][matched_index]
            if resolved_graph.modules[module_index].constants[matched_index].symbol.id.key != value.key -> panic("constant declaration order changed inside a staging generation")
            row: sema_checked_constant_with_values(resolved_graph, resolved_graph.modules[module_index], resolved_graph.modules[module_index].constants[matched_index], staged_values, diagnostics) ?? next
            rows.push(row)
        }
    }
    rows
}

// The one environment of a staging run: it owns `graph` (moved in, never
// copied here) with `values` applied, and every comptime item and function
// check re-targets it (sema_scope_environment_enter_probe_module) instead of
// copying the graph. The caller applies each later value to its graph in
// place. `graph_facts` are the declaration pass's facts of `graph`
// (SemaComptimeDeclarationStage.graph_facts), or None; they stand while no
// value is applied, else the tables derive them again.
sema_comptime_environment: fn(graph: &&SemaRegistrationGraph, values: [SemaComptimeItemValue], graph_facts: &&SemaComptimeGraphFacts?, trace_sink: CompilerTraceSink?) -> SemaScopeEnvironment Never! {
    resolved := graph.move()
    trail := sema_graph_trail_init()
    sema_comptime_graph_apply_values(resolved, values, trail)
    reused := graph_facts.move()
    if values.len() > 0 -> reused = None
    tables := sema_comptime_environment_tables(resolved, reused)
    environment := sema_scope_environment_init("", "", "", "", SemaSourceOrigin.Snapshot, [SemaSourceSegment]{}, [SemaScopeDeclaration]{})
    environment.registration_graph = tables.registration_graph.move()
    environment.checked_types = tables.checked_types.move()
    environment.checked_type_rows = tables.checked_type_rows.move()
    environment.checked_type_name_slots = tables.checked_type_name_slots.move()
    environment.checked_type_name_rows = tables.checked_type_name_rows.move()
    environment.boxed_edges = tables.boxed_edges.move()
    environment.copy_facts = tables.copy_facts.move()
    work := sema_comptime_body_work_new(trace_sink)
    count_key_bytes: if work == .Val(_) -> true else -> false
    environment.comptime_body_publication = sema_comptime_body_values_freeze(sema_comptime_body_values_from_items(values), work, count_key_bytes)
    environment.comptime_body_publication.item_frontier = values.len()
    environment.move()
}

sema_comptime_environment_tables: fn(graph: &&SemaRegistrationGraph, graph_facts: &&SemaComptimeGraphFacts?) -> SemaProgramTables Never! {
    facts := graph_facts.move() ?? return sema_program_tables_init(Val(graph.move()), [TTypeDef]{})
    sema_program_tables_with(Val(graph.move()), [TTypeDef]{}, facts.boxed_edges.move(), facts.copy_facts.move())
}

// Only the staging producer lands rows from its authenticated item frontier.
// Retargets and nonbody batches do not rebuild the visible body prefix.
sema_comptime_environment_publish_body_values: fn(environment: &SemaScopeEnvironment, values: [SemaComptimeItemValue], from: Int, body_values_changed: Bool) Never! {
    if from < 0 || from > values.len() || from != environment.comptime_body_publication.item_frontier -> panic("body publication lost its authenticated item frontier")
    if body_values_changed -> sema_comptime_body_values_append_items(environment.comptime_body_publication, values, from)
    environment.comptime_body_publication.item_frontier = values.len()
}

// The program tables of a staging run: they own `graph` (moved in, never
// copied here) with `values` applied (recorded on `trail`), beside the run's
// one environment. The caller applies each later value to their graph in
// place.
sema_comptime_program: fn(graph: &&SemaRegistrationGraph, values: [SemaComptimeItemValue], trail: &SemaGraphTrail) -> SemaProgramTables Never! {
    resolved := graph.move()
    sema_comptime_graph_apply_values(resolved, values, trail)
    sema_program_tables_init(Val(resolved.move()), [TTypeDef]{})
}

// `environment` is the run's sema_comptime_environment and `program` its
// tables (sema_comptime_program), whose graph already carries the run's
// values; `available` covers the same values.
// `probe` is the run's module scope (sema_comptime_probe_init), lent to every
// item and function check of the run.
sema_check_comptime_item: fn(environment: &SemaScopeEnvironment, program: &SemaProgramTables, probe: &SemaScopeProbe, available: SemaComptimeAvailableConstants, source: SemaComptimeItemSource) -> SemaComptimeItemCheck {
    if source.checked_text == .Val(evaluation) {
        dependencies := evaluation.dependencies
        waiting := sema_comptime_waiting_dependencies(available, dependencies)
        if waiting.len() > 0 -> return SemaComptimeItemCheck{request: None, dependencies: dependencies, waiting_dependencies: waiting, diagnostics: [Diagnostic]{}, complete: true}
        request := SemaComptimeItemRequest{
            module_identity: source.module_identity,
            key: source.key,
            destination_key: source.destination_key,
            source_file: source.source_file,
            kind: SemaComptimeItemKind.CheckedText,
            expression: evaluation.expression,
            expected_type: Val(evaluation.ty),
            span: evaluation.span,
            dependencies: dependencies,
            calls: [SemaComptimeRequest]{},
            hardware_use: sema_hardware_use_snapshot(evaluation.hardware_use),
            reachable_function_keys: evaluation.reachable_function_keys,
        }
        return SemaComptimeItemCheck{request: Val(request), dependencies: dependencies, waiting_dependencies: waiting, diagnostics: [Diagnostic]{}, complete: true}
    }
    empty := sema_comptime_body_values_prefix(environment.comptime_body_publication, 0)
    entered: sema_scope_environment_enter_probe_module(environment, program, source.module_identity, empty)
    if !entered -> return SemaComptimeItemCheck{request: None, dependencies: source.dependencies, waiting_dependencies: source.dependencies, diagnostics: [Diagnostic]{}, complete: false}
    sema_check_comptime_item_in(environment, program, probe, available, source)
}

// A body site's prepared locals read as their finished values in the staged
// check, as they do in the owner body (sema_stmt_check_prepared_binding).
sema_comptime_declare_prepared_locals: fn(source: SemaComptimeItemSource, table: &SemaScopeTable, state: &SemaOwnershipState) Never! {
    _ := sema_scope_enter(table, state, "{source.key}#prepared")
    owner: sema_scope_local_owner_key(table)
    loop local in source.prepared {
        id: symbol_id(SymbolKind.Local, source.module_identity, owner, local.name)
        symbol := Symbol{id: id, kind: SymbolKind.Local, name: local.name, module_name: source.module_identity, owner: Val(owner), span: local.span, ty: Val(local.ty), visibility: 0}
        if !sema_scope_declare_local(table, symbol, false, AccessConvention.Read, None, false) -> next
        last: table.bindings.len() - 1
        sema_scope_note_binding_edit(table, last)
        table.bindings[last].prepared = Val(local.value)
        sema_ownership_declare_binding(state, symbol, false)
    }
}

// Read-only half of the item check: the environment is borrowed, so reading
// its registration graph never copies the graph (a writable parameter would).
// D2: this one check is where a source's constant dependencies come from
// (sema_comptime_dependencies_from_references over its own references, with
// the dependencies the source carries from registration, a marker argument's
// or a checked text's); no dependency probe checks the expression before it.
// The list names every referenced constant without an AST value, staged or
// not (the driver reads it to decide whether an evaluation needs the staged
// rows, jet_driver_comptime_batch_add `needs_rows`); `waiting` is the part
// `available` lacks.
sema_check_comptime_item_in: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, probe: &SemaScopeProbe, available: SemaComptimeAvailableConstants, source: SemaComptimeItemSource) -> SemaComptimeItemCheck {
    if program.registration_graph == .Val(resolved_graph) {
        sema_comptime_probe_prepare(probe, environment, program, available.counted_values)
        diagnostics := probe.diagnostics.copy()
        if !probe.applied -> return SemaComptimeItemCheck{request: None, dependencies: source.dependencies, waiting_dependencies: source.dependencies, diagnostics: diagnostics, complete: false}
        mark: sema_scope_mark(probe.table)
        // A runtime check reads the expression as ordinary code, not as
        // compile-time execution.
        probe.table.comptime_execution_depth = if source.runtime_check -> 0 else -> 1
        // S57: `NAME: expr` fails the build when evaluation cannot complete.
        // The build edge carries the implicit `!Err` rail of `run: fn()`
        // so a fallible call here propagates to the build.
        probe.table.failure_carrier = Val(sema_failure_carrier(None))
        context := sema_check_context_init()
        context.host_hooks = probe.host_hooks
        state := sema_ownership_state_init()
        tail_store := sema_statement_tail_store_init()
        // A module value's checks run inside its own owner frame, so its
        // intrinsic call sites are recorded (sema_effect_record_intrinsic_fact
        // records only under an owner) and its purity can be read.
        if source.module_value || source.runtime_check -> _ := sema_scope_enter(probe.table, state, "{source.key}#init")
        if source.prepared.len() > 0 -> sema_comptime_declare_prepared_locals(source, probe.table, state)
        probe.table.comptime_runtime_locals = source.runtime_locals.copy()
        checked := if source.kind == SemaComptimeItemKind.TypeLevel -> sema_comptime_check_discriminant(source, environment, program, probe.table, state, tail_store, context, diagnostics) else -> sema_check_expression(source.expression, source.expected_type, environment, program, probe.table, state, tail_store, context, diagnostics)
        probe.table.comptime_runtime_locals = [String]{}
        sema_scope_rollback(probe.table, mark)
        // A compile-time value never reads the clock or randomness, and
        // reaches the network only through a pinned `fetch`; a module value
        // that reaches the outside world is refused whole (E0643), its
        // runtime check reads it as ordinary code, and an unevaluable field
        // default lowers at construction instead.
        if !source.module_value && !source.runtime_check && source.kind != SemaComptimeItemKind.FieldDefault {
            loop fact in context.call_facts {
                if !sema_effect_comptime_net_unavailable(fact, diagnostics) -> sema_effect_comptime_nondeterministic(fact, diagnostics)
            }
        }
        dependencies := sema_comptime_dependencies_from_references(resolved_graph, context.name_references, [SemaComptimeItemValue]{})
        loop dependency in source.dependencies {
            already := false
            loop existing in dependencies {
                if existing == dependency -> already = true
            }
            if !already -> dependencies.push(dependency.copy())
        }
        waiting := sema_comptime_waiting_dependencies(available, dependencies)
        if waiting.len() > 0 -> return SemaComptimeItemCheck{request: None, dependencies: dependencies, waiting_dependencies: waiting, diagnostics: diagnostics, complete: !sema_has_error_since(diagnostics, 0)}
        if checked == None -> return SemaComptimeItemCheck{request: None, dependencies: dependencies, waiting_dependencies: waiting, diagnostics: diagnostics, complete: false}
        expression: checked ?? return SemaComptimeItemCheck{request: None, dependencies: dependencies, waiting_dependencies: waiting, diagnostics: diagnostics, complete: false}
        checked_expected := source.expected_type
        if checked_expected != None {
            required: checked_expected ?? expression.ty
            if expression.ty != required -> checked_expected = None
        }
        published: sema_publish_expression(expression, context.arena.tree)
        reachable := sema_comptime_reachable_function_keys(resolved_graph, context.call_facts)
        sema_comptime_drop_close_keys(resolved_graph, published.tree, source.module_identity, reachable)
        request := SemaComptimeItemRequest{
            module_identity: source.module_identity,
            key: source.key,
            destination_key: source.destination_key,
            source_file: source.source_file,
            kind: source.kind,
            expression: published,
            expected_type: checked_expected,
            span: source.span,
            dependencies: dependencies,
            calls: context.comptime_requests,
            hardware_use: sema_hardware_use_snapshot(context.hardware_use),
            reachable_function_keys: reachable,
            call_facts: if source.module_value || source.runtime_check -> context.call_facts else -> [SemaCallSiteFact]{},
            effect_call: sema_effect_comptime_call_name(context.call_facts),
        }
        return SemaComptimeItemCheck{request: Val(request), dependencies: dependencies, waiting_dependencies: waiting, diagnostics: diagnostics, complete: !sema_has_error_since(diagnostics, 0)}
    }
    SemaComptimeItemCheck{request: None, dependencies: source.dependencies, waiting_dependencies: source.dependencies, diagnostics: [Diagnostic]{}, complete: false}
}

// An enum case number (`First = expr`) is part of the type layout, so a
// value the compiler can't compute or an operand that isn't `Int` is E0035 at
// the number, in place of the expression's own diagnostics.
sema_comptime_check_discriminant: fn(source: SemaComptimeItemSource, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    attempt := [Diagnostic]{}
    checked: sema_check_expression(source.expression, None, environment, program, scopes, state, tail_store, context, attempt)
    if sema_has_error_since(attempt, 0) {
        diagnostics.push(sema_error("E0035", source.span, "an enum discriminant must be computable at compile time", "the enum number is part of the type layout and must be known before code generation", "use an integer literal, a `NAME: #run value` constant, or another compile-time expression"))
        return None
    }
    expression: checked ?? {
        loop diagnostic in attempt -> diagnostics.push(diagnostic)
        return None
    }
    if expression.ty != Type.Int {
        diagnostics.push(sema_error("E0035", source.span, "an enum discriminant must be an integer, got {sema_type_show(expression.ty)}", "enum discriminants select a numeric variant value", "use an integer literal or a compile-time expression that produces Int"))
        return None
    }
    loop diagnostic in attempt -> diagnostics.push(diagnostic)
    checked
}

// E0338: a compile-time item waits on itself through `chain`, the names around
// the cycle from the item back to it, reported at the item's own value `span`.
// The words are the package config evaluator's for the same cycle among
// module-level values (envmodel_collect_comptime_globals).
sema_comptime_dependency_cycle_diagnostic: fn(chain: [String], span: Span) -> Diagnostic {
    sema_error("E0338", span, "computed module fields form a cycle: {chain.join(" -> ")}", "module-level comptime values must have a deterministic dependency order", "break the cycle by making one value independent or by moving the shared computation into a pure function")
}

// `type_caps` (sema_effect_type_caps) binds a struct's or enum's `#FX(…)` cap
// to each of its methods, trait impls written apart from its body included.
// Each trait impl method also takes the trait it implements, resolved in
// `graph` where its `impl` block is written, which binds the trait's cap
// and its trait-value calls to it.
sema_comptime_effect_sources: fn(graph: SemaRegistrationGraph, source_module: SemaRegistrationModule, type_caps: [String:SemaEffectTypeCap]) -> [SemaEffectFunctionSource] Never! {
    sources := [SemaEffectFunctionSource]{}
    compute_aliases: sema_kernel_compute_aliases(source_module)
    loop function in source_module.functions {
        source := sema_effect_source_from_function_key(function.declaration, source_module.module_identity, function.symbol.id.key)
        source.kernel = sema_kernel_pending(function.declaration, compute_aliases)
        sources.push(source)
    }
    loop nominal in source_module.nominals {
        block_traits: sema_effect_body_block_traits(graph, source_module.module_identity, nominal)
        loop (index, function) in nominal.methods {
            source := sema_effect_source_from_function_key(function.declaration, source_module.module_identity, function.symbol.id.key)
            sema_effect_bind_type_cap(source, type_caps, Val(nominal.symbol.id.key), source_module.module_identity)
            if index < block_traits.len() -> source.trait_key = block_traits[index]
            sources.push(source)
        }
    }
    loop implementation in source_module.impls {
        trait_key := ""
        if implementation.trait_name == .Val(trait_name) {
            trait_symbol := implementation.trait_symbol
            if trait_symbol == None -> trait_symbol = sema_type_graph_trait_symbol(graph, source_module.module_identity, trait_name)
            if trait_symbol == .Val(symbol) -> trait_key = sema_effect_trait_cap_key(symbol.id.key)
        }
        loop function in implementation.methods {
            source := sema_effect_source_from_function_key(function.declaration, source_module.module_identity, function.symbol.id.key)
            sema_effect_bind_type_cap(source, type_caps, implementation.target_nominal_key, source_module.module_identity)
            source.trait_key = trait_key
            sources.push(source)
        }
    }
    sources
}

// The trait key (sema_effect_trait_cap_key) of each of `nominal`'s methods,
// by method row: "" for a method of its own, the block's trait for one an
// `impl Trait` block in its body writes. The registration rows a nominal's
// own methods first, then each block's methods in block order.
sema_effect_body_block_traits: fn(graph: SemaRegistrationGraph, module_identity: String, nominal: SemaRegistrationNominal) -> [String] Never! {
    rows := [String]{}
    if nominal.source == .SourceAST(item) {
        own: if item == {
            .Struct(definition) -> definition.methods.len()
            .Enum(definition) -> definition.methods.len()
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> return rows
        }
        loop _ in 0..<own -> rows.push("")
        loop block in sema_registration_item_trait_blocks(item) {
            trait_key: if sema_type_graph_trait_symbol(graph, module_identity, block.trait_name) == .Val(symbol) -> sema_effect_trait_cap_key(symbol.id.key) else -> ""
            loop _ in block.methods -> rows.push(trait_key.copy())
        }
    }
    rows
}

// One checked module's effect inputs, read in place from its registration
// row `graph.modules[source_index]`.
sema_effect_module_input: fn(graph: SemaRegistrationGraph, source_index: Int, module_index: Int, type_caps: [String:SemaEffectTypeCap], library: [SemaLibraryEffect]) -> SemaEffectModuleInput Never! {
    source: graph.modules[source_index]
    SemaEffectModuleInput{
        module_index: module_index,
        sources: sema_comptime_effect_sources(graph, source, type_caps),
        // copy: the effect inputs locate their diagnostics; the graph keeps its segments.
        source_segments: source.source_segments.copy(),
        trait_bounds: sema_effect_trait_bounds(source.program.items),
        trait_implementers: sema_effect_trait_implementers(source.program.items),
        owned_trait_hooks: sema_effect_owned_trait_hooks(graph, source),
        library_effects: sema_library_effect_view(library, source),
    }
}

// The owned trait each method of an `impl Owner.Add` or `impl
// Owner.CheckedText` block, or of such an `impl Add { … }` block in a struct
// or enum body, implements, by function key (E0742 bounds those methods to
// `-[]>`). A block naming a user trait of the module is that trait's.
sema_effect_owned_trait_hooks: fn(graph: SemaRegistrationGraph, source: SemaRegistrationModule) -> [String:String] Never! {
    hooks := [String:String]{}
    loop implementation in source.impls {
        trait_name: implementation.trait_name ?? next
        if implementation.trait_symbol != None || !owned_trait_bounds_pure(trait_name) -> next
        loop function in implementation.methods -> hooks[function.symbol.id.key] = trait_name
    }
    loop nominal in source.nominals {
        if nominal.source == .SourceAST(item) {
            loop block in sema_registration_item_trait_blocks(item) {
                if !owned_trait_bounds_pure(block.trait_name) || sema_type_graph_trait_symbol(graph, source.module_identity, block.trait_name) != None -> next
                loop method in nominal.methods {
                    loop written in block.methods {
                        if written.span == method.declaration.span -> hooks[method.symbol.id.key] = block.trait_name
                    }
                }
            }
        }
    }
    hooks
}

sema_comptime_policy_for_package: fn(policies: [SemaRegistrationPackagePolicy], package_identity: String) -> SemaRegistrationPackagePolicy? {
    loop policy in policies {
        if policy.package_identity == package_identity -> return Val(policy)
    }
    None
}

sema_comptime_layer_exceeds: fn(actual: RuntimeLayer, ceiling: RuntimeLayer) -> Bool Never! {
    if ceiling == RuntimeLayer.Core -> return actual != RuntimeLayer.Core
    if ceiling == RuntimeLayer.Alloc -> return actual == RuntimeLayer.Std
    false
}

sema_comptime_runtime_ceiling_diagnostic: fn(subject: String, needed: RuntimeLayer, ceiling: RuntimeLayer, span: Span?, chain: String) -> Diagnostic {
    needed_name: jet_ring_layer_name(needed)
    ceiling_name: jet_ring_layer_name(ceiling)
    sema_error_optional("E1006", span, "`{subject}` needs `runtime: {needed_name}`", "this package declares `runtime: {ceiling_name}` in `package.jet`, which caps imports at the `{ceiling_name}` runtime profile; `{subject}` needs `{needed_name}`; import chain: {chain}", "remove the import or helper use, raise the ceiling to `runtime: {needed_name}` in `package.jet`, or use a `{ceiling_name}` runtime alternative")
}

// The Core modules one import declaration names: `use fs: core.files`
// parses as member `files` of `core`; `use core.mem.[...]` names its module.
sema_runtime_ceiling_import_modules: fn(declaration: ImportDecl) -> [String] Never! {
    names := [String]{}
    if declaration.kind == {
        .Module(name, _) -> {
            if name.starts_with("core.") -> names.push(name.copy())
        }
        .Unqualified(module_alias, _, items, _, _) -> {
            if module_alias.starts_with("core.") -> names.push(module_alias.copy())
            if module_alias == "core" {
                loop item in items -> names.push("core.{item.original}")
            }
        }
        .File(_, _) -> {}
    }
    names
}

// The local name an import gives `module_name`: the declaration alias, or
// the alias of the member row that names that module.
sema_runtime_ceiling_import_alias: fn(declaration: ImportDecl, module_name: String) -> String Never! {
    if declaration.kind == .Unqualified(module_alias, _, items, _, _) {
        loop item in items {
            if "{module_alias}.{item.original}" != module_name -> next
            if item.alias == .Val(alias) -> return alias.copy()
            return item.original.copy()
        }
    }
    declaration.alias.copy()
}

// How a written usage reaches its Core helper: the ambient `input` helper,
// an import of the helper's module, or the prelude itself.
sema_runtime_ceiling_helper_chain: fn(usage: String, imports: [ImportDecl]) -> String Never! {
    if usage == "core.term::__input_lines" -> return "ambient `input` (helper `{usage}`)"
    parts: usage.split("::").to_list()
    if parts.len() > 1 {
        loop declaration in imports {
            loop module_name in sema_runtime_ceiling_import_modules(declaration) {
                if module_name == parts[0] -> return "`use {sema_runtime_ceiling_import_alias(declaration, module_name)}: {module_name}` → `{usage}`"
            }
        }
    }
    "prelude helper `{usage}`"
}

sema_compute_module_owns_site: fn(module_result: SemaGraphModuleResult, span: Span) -> Bool Never! {
    loop function_facts in module_result.compute_facts {
        loop call in function_facts.compute_calls {
            if call.span.start == span.start && call.span.end == span.end -> return true
        }
        loop obligation in function_facts.autodiff_obligations {
            if obligation.span.start == span.start && obligation.span.end == span.end -> return true
        }
    }
    false
}

// #3708: a function whose failure contract sema may infer. No contract was
// written, and nothing else owns its return protocol (the Rust reference's
// `failure_inference_candidate`). A computed field's generated getter is the
// user's formula, so its failures are inferred like a written method's: a
// read of `path: String -> stored_path` is no failure source. A `#Memo`
// field's helper is not: its contract is fixed when it is generated
// (sema_computed_field_memo_helper_func), because a contract inferred after
// its body was checked would leave the body built for the other one.
sema_failure_inference_candidate: fn(func: Func) -> Bool Never! {
    if !sema_failure_contract_is_default(func.return_type) -> return false
    if func.return_type == .Val(.Apply(name, _)) && name == "Stream" -> return false
    if sema_computed_field_memo_helper_function(func) -> return false
    (!func.compiler_generated || sema_computed_field_getter_function(func)) && !func.is_comptime && !func.is_job && func.every == None && func.inline_foreign == None && !func.gc_return && func.pre.len() == 0 && func.post.len() == 0 && func.web_marker == None && func.external_type == None
}

// #3708 "Every function has the structured Error
// route by default. Sema removes it when impossible." After every body is
// checked, a greatest fixpoint over the bundle's propagation edges finds the
// unannotated top-level functions and inherent methods whose failure set is
// empty. A function used as a value keeps its declared callable type, and a
// body with a failure source of its own stays fallible. Returns the
// inferred-infallible keys.
sema_failure_solve: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult]) -> [String] Never! {
    address_taken := [String:Bool]{}
    loop module_result in modules {
        loop reference in module_result.name_references {
            if reference.kind == "function" -> address_taken[reference.symbol.id.key] = true
        }
    }
    candidates := [SemaFunctionFailureFacts]{}
    inferred := [String:Bool]{}
    loop module_result in modules {
        source_index: sema_registration_module_index(graph, module_result.module_identity) ?? next
        loop facts in module_result.failure_facts -> sema_failure_add_candidate(graph, source_index, facts, address_taken, candidates, inferred)
    }
    // Rust checks every declared function as a body job; a per-callable
    // `#Import(c)` declaration returns before its (empty) body, so its summary
    // has no failure source and no edge. An unannotated import is therefore a
    // candidate the solve proves infallible (a C function cannot fail) and
    // projects onto `T Never!`, instead of an edge no fact ever resolves.
    loop module_index in 0..<graph.modules.len() {
        loop row in 0..<graph.modules[module_index].functions.len() {
            if !sema_function_is_guest_import(graph.modules[module_index].functions[row].declaration) -> next
            key: graph.modules[module_index].functions[row].symbol.id.key
            if address_taken.get(key) != None || inferred.get(key) != None || !sema_failure_inference_candidate(graph.modules[module_index].functions[row].declaration) -> next
            candidates.push(SemaFunctionFailureFacts{function_key: key, direct: false, edges: [String]{}})
            inferred[key] = true
        }
    }
    sema_failure_fixpoint(candidates, inferred)
}

// A function the solve may infer: its body has no failure source of its own,
// it is not used as a value, and it is an inference candidate.
sema_failure_add_candidate: fn(graph: SemaRegistrationGraph, source_index: Int, facts: SemaFunctionFailureFacts, address_taken: [String:Bool], candidates: &[SemaFunctionFailureFacts], inferred: &[String:Bool]) Never! {
    if facts.direct || address_taken.get(facts.function_key) != None -> return
    row: sema_registration_callable_row(graph, facts.function_key) ?? return
    if !sema_failure_row_in_module(graph, row, source_index) || !sema_failure_row_candidate(graph, row) -> return
    candidates.push(facts.copy())
    inferred[facts.function_key] = true
}

// Whether module `source_index` registers the callable at `row`; a method
// is registered on its impl's module and on its type's.
sema_failure_row_in_module: fn(graph: SemaRegistrationGraph, row: SemaRegistrationCallableRow, source_index: Int) -> Bool Never! {
    if row == {
        .Function(module_index, _) -> return module_index == source_index
        .Foreign(module_index, _) -> return module_index == source_index
        .NominalMethod(_, _, _) | .ImplMethod(_, _, _) -> {}
    }
    loop site in sema_failure_method_rows(graph, row) {
        declaring: if site == {
            .NominalMethod(module_index, _, _) -> module_index
            .ImplMethod(module_index, _, _) -> module_index
            .Function(_, _) | .Foreign(_, _) -> -1
        }
        if declaring == source_index -> return true
    }
    false
}

// Whether the solve may infer the failure contract of the callable at `row`:
// a top-level function, or an inherent method (one in its type's body or in
// an `impl T { … }` block) that is an inference candidate. A trait-impl
// method's return is its trait's, so it keeps the route it declares.
sema_failure_row_candidate: fn(graph: SemaRegistrationGraph, row: SemaRegistrationCallableRow) -> Bool Never! {
    if row == {
        .Function(module_index, index) -> return sema_failure_inference_candidate(graph.modules[module_index].functions[index].declaration)
        .NominalMethod(module_index, owner, index) -> {
            if !sema_failure_inference_candidate(graph.modules[module_index].nominals[owner].methods[index].declaration) -> return false
        }
        .ImplMethod(module_index, owner, index) -> {
            if !sema_failure_inference_candidate(graph.modules[module_index].impls[owner].methods[index].declaration) -> return false
        }
        .Foreign(_, _) -> return false
    }
    loop site in sema_failure_method_rows(graph, row) {
        if site == {
            .NominalMethod(module_index, owner, index) -> {
                if index < sema_failure_inherent_method_count(graph.modules[module_index].nominals[owner]) -> return true
            }
            .ImplMethod(module_index, owner, _) -> {
                if graph.modules[module_index].impls[owner].trait_name == None && !graph.modules[module_index].impls[owner].compiler_generated -> return true
            }
            .Function(_, _) | .Foreign(_, _) -> {}
        }
    }
    false
}

// Every registered row of the method at `row`. A method of an `impl T` block
// is registered on the impl and again on the nominal `T`
// (sema_registration_add_impl), under one key.
sema_failure_method_rows: fn(graph: SemaRegistrationGraph, row: SemaRegistrationCallableRow) -> [SemaRegistrationCallableRow] Never! {
    rows := [SemaRegistrationCallableRow]{}
    if row == {
        .NominalMethod(module_index, owner, index) -> {
            rows.push(SemaRegistrationCallableRow.NominalMethod{module_index: module_index, owner: owner, row: index})
            key: graph.modules[module_index].nominals[owner].methods[index].symbol.id.key
            loop reference in sema_registration_impl_rows_named(graph, graph.modules[module_index].nominals[owner].symbol.name) {
                loop method in 0..<graph.modules[reference.module_index].impls[reference.row].methods.len() {
                    if graph.modules[reference.module_index].impls[reference.row].methods[method].symbol.id.key == key -> rows.push(SemaRegistrationCallableRow.ImplMethod{module_index: reference.module_index, owner: reference.row, row: method})
                }
            }
        }
        .ImplMethod(module_index, owner, index) -> {
            rows.push(SemaRegistrationCallableRow.ImplMethod{module_index: module_index, owner: owner, row: index})
            key: graph.modules[module_index].impls[owner].methods[index].symbol.id.key
            loop reference in sema_registration_nominal_rows_named(graph, graph.modules[module_index].impls[owner].target_type_name) {
                loop method in 0..<graph.modules[reference.module_index].nominals[reference.row].methods.len() {
                    if graph.modules[reference.module_index].nominals[reference.row].methods[method].symbol.id.key == key -> rows.push(SemaRegistrationCallableRow.NominalMethod{module_index: reference.module_index, owner: reference.row, row: method})
                }
            }
        }
        .Function(_, _) | .Foreign(_, _) -> {}
    }
    rows
}

// A nominal registers the methods of its own body first, then those of its
// trait-impl blocks (sema_registration_nominal), then those of each `impl`
// block (sema_registration_add_impl); this counts the first.
sema_failure_inherent_method_count: fn(nominal: SemaRegistrationNominal) -> Int Never! {
    if nominal.source == .SourceAST(item) {
        if item == {
            .Struct(definition) -> return definition.methods.len()
            .Enum(definition) -> return definition.methods.len()
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    0
}

// The greatest fixpoint over `candidates`, each of which starts inferred;
// returns the keys that stay infallible. By propagation: a candidate with an
// edge to a key that is not (or no longer) inferred falls, and its fall
// reaches every candidate with an edge to it through `dependents`, so each
// edge is visited a bounded number of times instead of once per round.
sema_failure_fixpoint: fn(candidates: [SemaFunctionFailureFacts], inferred: &[String:Bool]) -> [String] Never! {
    dependent_slots := [String:Int]{}
    dependents := [[Int]]{}
    fallen := [String]{}
    loop (row, facts) in candidates {
        loop edge in facts.edges {
            if !(inferred.get(edge) ?? false) {
                if inferred.get(facts.function_key) ?? false {
                    inferred[facts.function_key] = false
                    fallen.push(facts.function_key)
                }
                next
            }
            slot := dependent_slots.get(edge) ?? -1
            if slot < 0 {
                slot = dependents.len()
                dependent_slots[edge] = slot
                dependents.push([Int]{})
            }
            dependents[slot].push(row)
        }
    }
    loop fallen.len() > 0 {
        key: fallen.pop() ?? break
        slot: dependent_slots.get(key) ?? next
        loop row in dependents[slot] {
            caller: candidates[row].function_key
            if inferred.get(caller) ?? false {
                inferred[caller] = false
                fallen.push(caller.copy())
            }
        }
    }
    solved := [String]{}
    loop facts in candidates {
        if inferred.get(facts.function_key) ?? false -> solved.push(facts.function_key)
    }
    solved
}

// #3708: discharge each failure-domain obligation whose callee the solve
// proved infallible (`solved` holds the infallible keys), and emit the rest
// with the obligation mark removed. Returns whether any obligation survived
// as an error.
sema_failure_settle_obligations: fn(diagnostics: &[Diagnostic], solved: [String:Bool]) -> Bool Never! {
    mark: sema_failure_obligation_mark()
    pending: loop diagnostic in diagnostics {
        if (diagnostic.detail ?? "").starts_with(mark) -> break true
    } ?? false
    if !pending -> return false
    kept := [Diagnostic]{}
    survived := false
    loop diagnostic in diagnostics {
        detail: diagnostic.detail ?? ""
        if !detail.starts_with(mark) {
            kept.push(diagnostic.copy())
            next
        }
        lines: detail.split("\n").to_list()
        callee: lines[0].replace(mark, "")
        if solved.get(callee) != None -> next
        remainder := [String]{}
        loop line_index in 1..<lines.len() -> remainder.push(lines[line_index])
        emitted := diagnostic
        rest: remainder.join("\n")
        emitted.detail = None
        if rest != "" -> emitted.detail = Val(rest)
        kept.push(emitted)
        survived = true
    }
    diagnostics = kept
    survived
}

// E2404 repeated sites: every call of one callee whose failure domain has no
// route into the same caller domain is one root, reported once at its first
// site. `seen` carries the reported domains across the bundle's report lists.
sema_failure_domain_dedupe: fn(diagnostics: &[Diagnostic], seen: &[String:Bool]) Never! {
    repeated: loop diagnostic in diagnostics {
        if diagnostic.code == "E2404" -> break true
    } ?? false
    if !repeated -> return
    kept := [Diagnostic]{}
    loop diagnostic in diagnostics {
        detail: diagnostic.detail ?? ""
        if diagnostic.code != "E2404" || !detail.starts_with("failure-domain:") {
            kept.push(diagnostic.copy())
            next
        }
        key: detail.split("\n").to_list()[0]
        if seen.get(key) != None -> next
        seen[key] = true
        kept.push(diagnostic.copy())
    }
    diagnostics = kept
}

// #3708 for one comptime function closure: the failure rows, function-value
// uses and failure obligations of its checked bodies. Every function a
// comptime body reaches is in its closure, so the closure's own solve proves
// what the bundle solve proves for those callees; the body pass that reuses a
// body settles its obligations again with the bundle solve.
SemaComptimeFailureClosure: struct {
    owners: [Int]{[Int]{}}
    facts: [SemaFunctionFailureFacts]{[SemaFunctionFailureFacts]{}}
    address_taken: [String:Bool]{[String:Bool]{}}
    obligations: [Diagnostic]{[Diagnostic]{}}
}

sema_comptime_failure_closure_add: fn(graph: SemaRegistrationGraph, closure: &SemaComptimeFailureClosure, result: SemaComptimeFunctionResult) Never! {
    loop reference in result.name_references {
        if reference.kind == "function" -> closure.address_taken[reference.symbol.id.key] = true
    }
    if result.failure == .Val(facts) {
        if sema_registration_module_index(graph, result.module_identity) == .Val(source_index) {
            closure.owners.push(source_index)
            closure.facts.push(facts.copy())
        }
    }
    sema_comptime_push_obligations(result, closure.obligations)
}

// Settles the closure's obligations with a solve over its rows; each one
// that survives is reported in `diagnostics`. A discharged callee keeps its
// carrier, as every function compile-time evaluation reached does in the
// bundle (sema_failure_project_infallible). Returns whether every obligation
// was discharged.
sema_comptime_failure_closure_settle: fn(graph: SemaRegistrationGraph, closure: SemaComptimeFailureClosure, diagnostics: &[Diagnostic]) -> Bool Never! {
    if closure.obligations.len() == 0 -> return true
    candidates := [SemaFunctionFailureFacts]{}
    inferred := [String:Bool]{}
    loop (index, facts) in closure.facts -> sema_failure_add_candidate(graph, closure.owners[index], facts, closure.address_taken, candidates, inferred)
    solved := [String:Bool]{}
    loop key in sema_failure_fixpoint(candidates, inferred) -> solved[key] = true
    obligations := closure.obligations
    if !sema_failure_settle_obligations(obligations, solved) -> return true
    loop diagnostic in obligations -> diagnostics.push(diagnostic)
    false
}

// One finalize body pass: its checked modules, and the pass graph moved back
// out of the pass's program tables.
SemaFinalizeChecked: struct {
    modules: [SemaGraphModuleResult]
    graph: SemaRegistrationGraph?
}

// A body check of the registered modules `selected` (graph module indices, in
// order) against the graph's current contracts, traced as `phase` with the
// number of checked functions. `pending_obligations`: the failure solve has
// not run yet, so a failure obligation does not decide a keep-going trap.
// `graph` moves into the pass's program tables (never copied) and back out
// with the result.
// SP15: a module with enough top-level function source for more than one of
// `threads` checks those bodies on compiler threads first
// (sema_check_bodies_parallel); the environment and memory plan move into
// the threads' shared state for that pass and back out after it.
// This is the only consuming graph-pass boundary. All module/body workers
// read the existing Env/Shared owner, then join before that owner is recovered.
// Returning the actual graph keeps failure projection/rechecks on the same
// registered rows rather than on a second snapshot.
// `carried`: the pass facts (sema_pass_facts) of `graph` from the previous
// pass, its one row, when none of the graph rows they read changed since (a
// derive wave only selects demanded methods), else empty; the pass leaves
// its facts there for the next one.
sema_finalize_check_modules: fn(graph: &&SemaRegistrationGraph, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], checked_types: [TTypeDef], selected: [Int], pending_obligations: Bool, host_hooks: SemaHostHookAccess?, threads: CompilerThreads, session: SemaIncrementalCache?, phase: String, trace_sink: CompilerTraceSink?, carried: &[SemaPassFacts], modules: &[SemaGraphModuleResult]) -> SemaRegistrationGraph {
    if trace_sink == .Val(sink) -> sink.begin(phase, "", -1, -1)
    // A codec wave (sema_codec_waves) checks only the generated codecs it
    // filled, a derive wave (sema_derive_waves) only the derived methods
    // demanded, and a Core demand wave (sema_core_demand_pass) only the
    // deferred bodies named, into the modules' existing results.
    core_wave: graph.core_wave_rows.len() > 0
    codec_wave: graph.codec_wave_rows.len() > 0 || graph.derive_wave_rows.len() > 0 || core_wave
    pass_graph := graph.move()
    shared_state: sema_finalize_pass_open(pass_graph, values, checked_types, threads, trace_sink, carried)
    comptime_rows := sema_comptime_checked_function_rows(comptime_functions)
    checked_functions: sema_finalize_pass_modules(shared_state, values, comptime_functions, comptime_rows, selected, codec_wave, core_wave, pending_obligations, host_hooks, threads, session, phase, trace_sink, modules)
    if trace_sink == .Val(sink) -> sink.end(phase, checked_functions)
    sema_finalize_pass_close(shared_state, phase, trace_sink, carried)
}

// The shared state of one body pass over `graph`, which moves into the
// pass's program tables: the pass environment, the program tables and the
// memory plan, built from `carried` (its one row) when it holds the graph's
// pass facts, else computed here.
sema_finalize_pass_open: fn(graph: &&SemaRegistrationGraph, values: [SemaComptimeItemValue], checked_types: [TTypeDef], threads: CompilerThreads, trace_sink: CompilerTraceSink?, carried: &[SemaPassFacts]) -> Shared<SemaCheckShared> {
    fresh: carried.len() == 0
    facts := carried.pop() ?? sema_pass_facts_new()
    owned := if fresh -> sema_pass_facts(graph, threads, SEMA_PASS_FACT_JOBS, facts) else -> SemaRegistrationGraph?{Val(graph.move())}
    memory_plan := facts.memory_plan.move()
    work := sema_comptime_body_work_new(trace_sink)
    count_key_bytes: if work == .Val(_) -> true else -> false
    body_values := sema_comptime_body_values_freeze(sema_comptime_body_values_from_items(values), work, count_key_bytes)
    tables := sema_program_tables_with(owned, checked_types, facts.boxed_edges.move(), facts.copy_facts.move())
    environment := sema_check_pass_environment_from(tables, facts.fixed_length_write_params.move(), body_values)
    program := SemaProgramTables{
        registration_graph: environment.registration_graph.move(),
        checked_types: environment.checked_types.move(),
        checked_type_rows: environment.checked_type_rows.move(),
        checked_type_name_slots: environment.checked_type_name_slots.move(),
        checked_type_name_rows: environment.checked_type_name_rows.move(),
        boxed_edges: environment.boxed_edges.move(),
        copy_facts: environment.copy_facts.move(),
    }
    environment.registration_graph = None
    environment.checked_types = [TTypeDef]{}
    environment.checked_type_rows = [String:Int]{}
    environment.checked_type_name_slots = [String:Int]{}
    environment.checked_type_name_rows = [[Int]]{}
    environment.boxed_edges = [String:[String]]{}
    environment.copy_facts = sema_copy_facts_table_empty()
    shared_state: Shared{SemaCheckShared{environments: [SemaScopeEnvironment]{}, programs: [SemaProgramTables]{}, memory_plans: [SemaFunctionMemoryPlan]{}}}
    sema_check_shared_fill(shared_state, environment, program, memory_plan)
    shared_state
}

// Checks the registered modules `selected` in an open pass
// (sema_finalize_pass_open); returns how many functions they checked.
sema_finalize_pass_modules: fn(shared_state: Shared<SemaCheckShared>, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], selected: [Int], codec_wave: Bool, core_wave: Bool, pending_obligations: Bool, host_hooks: SemaHostHookAccess?, threads: CompilerThreads, session: SemaIncrementalCache?, phase: String, trace_sink: CompilerTraceSink?, modules: &[SemaGraphModuleResult]) -> Int {
    // A per-function trace times each check where it runs, in item order.
    trace_functions := false
    if trace_sink == .Val(sink) -> trace_functions = sink.functions()
    checked_functions := 0
    // An incremental session and a per-function trace keep one body pass per
    // module; otherwise consecutive modules share a body wave.
    single_passes := trace_functions
    if session == .Val(_) -> single_passes = true
    // Body waves take every selected module's declaration and program checks
    // made up front on the threads (sema_check_declaration_modules), last
    // first; a module's foreign rows stay after its bodies.
    starts := [SemaDeclarationCheck]{}
    if !codec_wave && !single_passes -> starts = sema_check_declaration_modules(shared_state, selected, values, false, threads)
    starts.reverse()
    start := 0
    // A Core demand wave shares body waves too (sema_check_body_wave with
    // `core`); codec and derive waves check module by module.
    loop start < selected.len() {
        module_index: selected[start]
        if codec_wave && (!core_wave || single_passes) {
            checked_functions += if core_wave -> sema_check_core_demand_module_in_shared(shared_state, host_hooks, module_index, comptime_functions, comptime_rows, pending_obligations, phase, trace_sink, modules[module_index]) else -> sema_check_codec_module_in_shared(shared_state, host_hooks, module_index, comptime_functions, comptime_rows, pending_obligations, phase, trace_sink, modules[module_index])
            start += 1
            next
        }
        if !single_passes {
            end: sema_check_body_wave_end(shared_state, selected, start)
            checked_functions += sema_check_body_wave(shared_state, host_hooks, selected, start, end, values, comptime_functions, comptime_rows, pending_obligations, threads, phase, trace_sink, core_wave, starts, modules)
            start = end
            next
        }
        weights := [Int]{}
        jobs: sema_check_parallel_jobs_in_shared(shared_state, module_index, comptime_rows, weights, phase, trace_sink)
        scope_rows: sema_check_module_scope_rows_in_shared(shared_state, module_index)
        body_work := 0
        loop weight in weights -> body_work += weight
        workers := 1
        if !trace_functions -> workers = compiler_threads_admit(threads, jobs.len(), body_work, SEMA_BODY_MIN_BYTES_PER_THREAD, scope_rows * SEMA_BODY_SCOPE_BYTES_PER_BINDING, 0)
        prepared := sema_check_prepare_module(shared_state, host_hooks, module_index, values, comptime_functions, comptime_rows, jobs, weights, workers, session, phase, trace_sink)
        checked := sema_check_module_in_shared(shared_state, host_hooks, module_index, values, comptime_functions, comptime_rows, pending_obligations, prepared, threads, session, phase, trace_sink)
        if trace_sink == .Val(sink) -> sink.end("sema.module", checked.functions.len())
        checked_functions += checked.functions.len()
        modules.push(checked)
        start += 1
    }
    checked_functions
}

// Ends an open pass: its facts go to `carried` for the next pass, and the
// pass graph moves back out of its program tables.
sema_finalize_pass_close: fn(shared_state: Shared<SemaCheckShared>, phase: String, trace_sink: CompilerTraceSink?, carried: &[SemaPassFacts]) -> SemaRegistrationGraph {
    environment_out := sema_check_shared_take_environment(shared_state)
    program_out := sema_check_shared_take_program(shared_state)
    memory_plan_out := sema_check_shared_take_memory_plan(shared_state)
    sema_comptime_body_work_flush(environment_out.comptime_body_publication, trace_sink, phase)
    carried.push(SemaPassFacts{
        memory_plan: memory_plan_out.move(),
        fixed_length_write_params: environment_out.fixed_length_write_params.move(),
        boxed_edges: program_out.boxed_edges.move(),
        copy_facts: program_out.copy_facts.move(),
    })
    environment_out.fixed_length_write_params = [String]{}
    program_out.boxed_edges = [String:[String]]{}
    program_out.copy_facts = sema_copy_facts_table_empty()
    // No guard or worker survives here. Leave the consumed environment slot
    // empty only after all joins and before returning its one graph owner.
    graph_out := program_out.registration_graph.move()
    program_out.registration_graph = None
    graph_out.move() ?? panic("a completed registered-body pass lost its graph")
}

sema_check_parallel_jobs_in_shared: fn(shared_state: Shared<SemaCheckShared>, module_index: Int, comptime_rows: [String:Int], weights: &[Int], phase: String, trace_sink: CompilerTraceSink?) -> [SemaBodyJob] {
    sema_check_module_trace_begin_in_shared(shared_state, module_index, phase, trace_sink)
    sema_check_module_jobs_in_shared(shared_state, module_index, comptime_rows, weights)
}

// Opens module `module_index`'s trace span and counts its items.
sema_check_module_trace_begin_in_shared: fn(shared_state: Shared<SemaCheckShared>, module_index: Int, phase: String, trace_sink: CompilerTraceSink?) {
    if trace_sink == .Val(sink) {
        inputs: shared_state.guard_read()
        sema_check_module_trace_begin(inputs.value.programs[0], module_index, phase, sink)
    }
}

sema_check_module_trace_begin: fn(program: SemaProgramTables, module_index: Int, phase: String, sink: CompilerTraceSink) {
    if program.registration_graph == .Val(graph) {
        sink.begin("sema.module", graph.modules[module_index].module_path, module_index, graph.modules.len())
        sink.progress("counters.{phase}.items_scanned", graph.modules[module_index].program.items.len(), -1)
        return
    }
    panic("a registered-module scheduler lost its graph")
}

// Module `module_index`'s parallel body jobs (sema_check_parallel_jobs).
sema_check_module_jobs_in_shared: fn(shared_state: Shared<SemaCheckShared>, module_index: Int, comptime_rows: [String:Int], weights: &[Int]) -> [SemaBodyJob] {
    inputs: shared_state.guard_read()
    sema_check_module_jobs(inputs.value.programs[0], module_index, comptime_rows, weights)
}

sema_check_module_jobs: fn(program: SemaProgramTables, module_index: Int, comptime_rows: [String:Int], weights: &[Int]) -> [SemaBodyJob] {
    if program.registration_graph == .Val(graph) -> return sema_check_parallel_jobs(graph, module_index, comptime_rows, weights)
    panic("a registered-module scheduler lost its graph")
}

// A body wave holds the post-summary scope of every module it prepares at
// once, so it takes consecutive modules only while their scope rows
// (sema_check_module_scope_rows) stay within this bound, and at least one.
SEMA_BODY_WAVE_SCOPE_ROWS: 32768

// The end of the body wave that starts at `selected[start]`.
sema_check_body_wave_end: fn(shared_state: Shared<SemaCheckShared>, selected: [Int], start: Int) -> Int {
    rows := 0
    end := start
    loop end < selected.len() {
        module_rows: sema_check_module_scope_rows_in_shared(shared_state, selected[end])
        if end > start && rows + module_rows > SEMA_BODY_WAVE_SCOPE_ROWS -> break
        rows += module_rows
        end += 1
    }
    end
}

// A body wave: modules `selected[start..<end]` check their top-level
// function and method bodies in one parallel pass (sema_check_bodies_parallel)
// instead of one pass each, so the threads stay busy across small modules.
// Every module with jobs or methods first builds its post-summary scope, in
// module order, as sema_check_prepare_module does, and keeps a copy of the
// environment that leaves entered in it: all a body check reads besides its
// thread's scope copy. The threads then claim the wave's jobs module by
// module, heaviest source first within a module, and check each against its
// module's environment, while this thread checks the modules in module order
// as each one's jobs are done (sema_check_body_wave_lead). A body's check
// does not depend on the thread that checks it or on what was checked before
// it, and a module check (sema_check_registration_module) enters its module
// before it reads the environment, so each module's prepared bodies and its
// result from the module checks, run in module order, are those of a pass
// per module.
// `starts` holds the modules' declaration checks, made ahead, last first.
// A Core demand wave's (`core`, sema_core_demand_waves) has none: it checks
// the wave's bodies of each module into the module's existing result
// (sema_check_core_demand_module_lent).
// Returns how many functions the modules checked.
sema_check_body_wave: fn(shared_state: Shared<SemaCheckShared>, host_hooks: SemaHostHookAccess?, selected: [Int], start: Int, end: Int, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], pending_obligations: Bool, threads: CompilerThreads, phase: String, trace_sink: CompilerTraceSink?, core: Bool, starts: &[SemaDeclarationCheck], modules: &[SemaGraphModuleResult]) -> Int {
    jobs := [SemaBodyJob]{}
    job_modules := [Int]{}
    order := [Int]{}
    module_indexes := [Int]{}
    // firsts[k] is the first job of wave module k; the last entry is the job count.
    firsts := [Int]{}
    body_work := 0
    scope_rows := 0
    loop wave_module in 0..<(end - start) {
        module_index: selected[start + wave_module]
        module_indexes.push(module_index)
        firsts.push(jobs.len())
        weights := [Int]{}
        module_jobs: sema_check_module_jobs_in_shared(shared_state, module_index, comptime_rows, weights)
        if module_jobs.len() > 0 {
            rows: sema_check_module_scope_rows_in_shared(shared_state, module_index)
            if rows > scope_rows -> scope_rows = rows
        }
        first: jobs.len()
        loop index in compiler_threads_heaviest_first(weights) -> order.push(first + index)
        loop weight in weights -> body_work += weight
        loop position in 0..<module_jobs.len() {
            jobs.push(module_jobs[position])
            job_modules.push(wave_module)
        }
    }
    firsts.push(jobs.len())
    workers: compiler_threads_admit(threads, jobs.len(), body_work, SEMA_BODY_MIN_BYTES_PER_THREAD, scope_rows * SEMA_BODY_SCOPE_BYTES_PER_BINDING, 0)
    if workers > 1 {
        // Each wave module's view summary jobs its declaration check found
        // ahead; `starts` holds them last module first.
        view_jobs := [[Int]?]{}
        loop wave_module in 0..<(end - start) {
            slot: starts.len() - 1 - wave_module
            found := [Int]?{None}
            if slot >= 0 && starts[slot].position == start + wave_module -> found = starts[slot].view_summary_jobs.copy()
            view_jobs.push(found)
        }
        return sema_check_body_wave_run(shared_state, host_hooks, start, module_indexes, firsts, jobs, job_modules, order, workers, values, comptime_functions, comptime_rows, pending_obligations, view_jobs, phase, trace_sink, core, starts, modules)
    }
    checked_functions := 0
    loop wave_module in 0..<(end - start) {
        module_index: selected[start + wave_module]
        if core {
            checked_functions += sema_check_core_demand_module_in_shared(shared_state, host_hooks, module_index, comptime_functions, comptime_rows, pending_obligations, phase, trace_sink, modules[module_index])
            next
        }
        bodies := sema_check_prepared_none()
        started := starts.pop() ?? panic("a body-wave module lost its declaration check")
        if started.position != start + wave_module -> panic("a body-wave module took another module's declaration check")
        bodies.started = Val(started.move())
        sema_check_module_trace_begin_in_shared(shared_state, module_index, phase, trace_sink)
        checked := sema_check_module_in_shared(shared_state, host_hooks, module_index, values, comptime_functions, comptime_rows, pending_obligations, bodies, threads, None, phase, trace_sink)
        if trace_sink == .Val(sink) -> sink.end("sema.module", checked.functions.len())
        checked_functions += checked.functions.len()
        modules.push(checked)
    }
    checked_functions
}

// A body wave on `workers` threads (sema_check_body_wave): builds the wave
// modules' post-summary scopes and the wave's plan, then runs the threads
// and the module checks; returns how many functions the modules checked.
// Every module of a Core demand wave (`core`) has bodies the wave names, so
// each builds its scope.
sema_check_body_wave_run: fn(shared_state: Shared<SemaCheckShared>, host_hooks: SemaHostHookAccess?, start: Int, module_indexes: &&[Int], owned_firsts: &&[Int], jobs: &&[SemaBodyJob], job_modules: &&[Int], order: &&[Int], workers: Int, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], pending_obligations: Bool, view_jobs: [[Int]?], counter_phase: String, trace_sink: CompilerTraceSink?, core: Bool, starts: &[SemaDeclarationCheck], modules: &[SemaGraphModuleResult]) -> Int {
    wave_modules := module_indexes.move()
    firsts := owned_firsts.move()
    module_count: wave_modules.len()
    wave_jobs := jobs.move()
    wave_job_modules := job_modules.move()
    top_order := order.move()
    // Each module's top-level ranks, then its parallel method jobs (appended
    // after every top-level job), heaviest first; method_firsts[k] is wave
    // module k's first method job and its last entry the wave's job count.
    wave_order := [Int]{}
    method_firsts := [Int]{}
    prepared := [Bool]{}
    cells := [Shared<SemaWaveEnvironment>]{}
    outs := [Shared<SemaWaveOut>]{}
    environment := sema_check_shared_take_environment(shared_state)
    program := sema_check_shared_take_program(shared_state)
    memory_plan := sema_check_shared_take_memory_plan(shared_state)
    loop wave_module in 0..<module_count {
        method_firsts.push(wave_jobs.len())
        loop rank in firsts[wave_module]..<firsts[wave_module + 1] -> wave_order.push(top_order[rank])
        // The method jobs the module check would hand a method wave
        // (sema_check_registration_module). A module with methods and no
        // top-level job joins the wave too, so no module check starts a
        // method wave of its own while the wave's threads run.
        scanned := 0
        all_method_jobs: sema_check_registered_method_jobs(environment, program, wave_modules[wave_module], scanned, false)
        held := [SemaScopeEnvironment]{}
        if core || firsts[wave_module + 1] > firsts[wave_module] || all_method_jobs.len() > 0 {
            scopes := sema_check_module_summary_scopes(environment, program, host_hooks, memory_plan, wave_modules[wave_module], comptime_functions, comptime_rows, view_jobs[wave_module], counter_phase, trace_sink)
            entered := environment.copy()
            // Selected against the entered environment, as the module check does.
            weights := [Int]{}
            method_jobs: sema_check_registered_parallel_method_jobs(entered, program, wave_modules[wave_module], memory_plan, all_method_jobs, comptime_rows, weights)
            first: wave_jobs.len()
            loop index in compiler_threads_heaviest_first(weights) -> wave_order.push(first + index)
            loop job in method_jobs {
                wave_jobs.push(job)
                wave_job_modules.push(wave_module)
            }
            entered.module_scope = Val(scopes.move())
            held.push(entered)
            prepared.push(true)
        } else {
            prepared.push(false)
        }
        cell: Shared{SemaWaveEnvironment{environments: held.move()}}
        cells.push(cell)
        out: Shared{SemaWaveOut{bodies: [SemaPreparedBody]{}, positions: [Int]{}}}
        outs.push(out)
    }
    method_firsts.push(wave_jobs.len())
    left := [SemaBodyCount]{}
    loop wave_module in 0..<module_count -> left.push(SemaBodyCount{value: firsts[wave_module + 1] - firsts[wave_module] + method_firsts[wave_module + 1] - method_firsts[wave_module]})
    sema_check_shared_put_tables(shared_state, program, memory_plan)
    replay := [Bool]{}
    plan: Shared{SemaBodyPlan{jobs: [SemaBodyJob]{}, order: [Int]{}, replay: [Bool]{}, observe: false}}
    sema_check_body_plan_fill(plan, wave_jobs, wave_order, replay)
    sema_check_body_plan_fill_wave(plan, wave_job_modules, wave_modules, cells, outs, left)
    queue: Shared{SemaBodyQueue{next: 0}}
    layout: SemaWaveLayout{start: start, firsts: firsts.move(), method_firsts: method_firsts.move(), prepared: prepared.move(), core: core}
    checked_functions := 0
    done := 0
    _ := sema_check_body_wave_parts(shared_state, plan, queue, workers - 1, environment, host_hooks, values, comptime_functions, comptime_rows, pending_obligations, layout, counter_phase, trace_sink, starts, modules, checked_functions, done)
    // The threads have joined: every job is done, and the lead checks the
    // modules it stopped before.
    if done < module_count -> _ := sema_check_body_wave_lead(shared_state, plan, queue, environment, host_hooks, values, comptime_functions, comptime_rows, pending_obligations, layout, counter_phase, trace_sink, starts, modules, checked_functions, done)
    sema_check_shared_put_environment(shared_state, environment)
    checked_functions
}

sema_check_module_scope_rows_in_shared: fn(shared_state: Shared<SemaCheckShared>, module_index: Int) -> Int {
    inputs: shared_state.guard_read()
    sema_check_registered_module_scope_rows(inputs.value.environments[0], inputs.value.programs[0], module_index)
}

sema_check_registered_module_scope_rows: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int) -> Int {
    if program.registration_graph == .Val(graph) -> return sema_check_module_scope_rows(graph, module_index)
    panic("a registered-module scheduler lost its graph")
}

sema_check_prepare_module: fn(shared_state: Shared<SemaCheckShared>, host_hooks: SemaHostHookAccess?, module_index: Int, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], jobs: [SemaBodyJob], weights: [Int], workers: Int, session: SemaIncrementalCache?, counter_phase: String, trace_sink: CompilerTraceSink?) -> SemaPreparedBodies {
    if workers <= 1 -> return sema_check_prepared_none()
    environment := sema_check_shared_take_environment(shared_state)
    program := sema_check_shared_take_program(shared_state)
    memory_plan := sema_check_shared_take_memory_plan(shared_state)
    scopes := sema_check_module_summary_scopes(environment, program, host_hooks, memory_plan, module_index, comptime_functions, comptime_rows, None, counter_phase, trace_sink)
    memo := sema_incremental_module(session, environment, program, scopes)
    queries := sema_incremental_registered_job_queries(memo, module_index, memory_plan, jobs, environment, program)
    sema_check_shared_fill(shared_state, environment, program, memory_plan)
    sema_check_bodies_parallel(shared_state, module_index, scopes, jobs, weights, workers, memo, queries)
}

sema_check_module_in_shared: fn(shared_state: Shared<SemaCheckShared>, host_hooks: SemaHostHookAccess?, module_index: Int, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], pending_obligations: Bool, prepared: &&SemaPreparedBodies, threads: CompilerThreads, session: SemaIncrementalCache?, counter_phase: String, trace_sink: CompilerTraceSink?) -> SemaGraphModuleResult {
    environment := sema_check_shared_take_environment(shared_state)
    program := sema_check_shared_take_program(shared_state)
    memory_plan := sema_check_shared_take_memory_plan(shared_state)
    checked := sema_check_registration_module(environment, program, host_hooks, memory_plan, module_index, values, comptime_functions, comptime_rows, true, pending_obligations, prepared, Val(SemaMethodScheduling{shared_state: shared_state, threads: threads}), session, counter_phase, trace_sink)
    restored_environment := checked.environment.move()
    restored_program := checked.program.move()
    restored_memory_plan := checked.memory_plan.move()
    sema_check_shared_fill(shared_state, restored_environment, restored_program, restored_memory_plan)
    checked.module_result.move()
}

// One codec wave's part of module `module_index`: the generated codec
// methods the wave filled (graph.codec_wave_rows), checked against the
// module scope the body pass uses (sema_check_module_summary_scopes) and
// appended to the module's result from that pass, their diagnostics located
// in the module's source as the body pass locates its own. Returns how many
// checked functions it appended.
sema_check_codec_module_in_shared: fn(shared_state: Shared<SemaCheckShared>, host_hooks: SemaHostHookAccess?, module_index: Int, comptime_functions: [SemaComptimeFunctionResult], comptime_rows: [String:Int], pending_obligations: Bool, counter_phase: String, trace_sink: CompilerTraceSink?, result: &SemaGraphModuleResult) -> Int {
    environment := sema_check_shared_take_environment(shared_state)
    program := sema_check_shared_take_program(shared_state)
    memory_plan := sema_check_shared_take_memory_plan(shared_state)
    scopes := sema_check_module_summary_scopes(environment, program, host_hooks, memory_plan, module_index, comptime_functions, comptime_rows, None, counter_phase, trace_sink)
    keep_going: sema_check_registered_keep_going(environment, program)
    scanned := 0
    jobs: sema_check_registered_method_jobs(environment, program, module_index, scanned, false)
    ready := [SemaPreparedBody]{}
    queries := [Int:SemaBodyMemoQuery]{}
    // Every codec body is checked here, never on a compiler thread, and the
    // codec wave injects no prelude conversion: no demand is kept.
    prelude_demands := [Int:[SemaPreludeConversionDemand]]{}
    before: result.functions.len()
    diagnostics_before: result.diagnostics.len()
    loop job in jobs {
        if !sema_check_apply_method_job(module_index, memory_plan, job, ready, queries, None, scopes, environment, program, host_hooks, comptime_functions, comptime_rows, result.diagnostics, result.functions, prelude_demands, result.call_facts, result.hardware_use, result.comptime_requests, result.name_references, result.comptime_body_sources, result.compute_facts, result.failure_facts, result.exact_int_reachable, result.copy_events, result.incomplete_reasons, keep_going, pending_obligations) -> result.complete = false
    }
    sema_check_registered_locate_diagnostics(environment, program, module_index, diagnostics_before, result.diagnostics)
    sema_check_shared_fill(shared_state, environment, program, memory_plan)
    result.functions.len() - before
}

// Moves the pass environment back into shared state alone.
sema_check_shared_put_environment: fn(shared_state: Shared<SemaCheckShared>, environment: &&SemaScopeEnvironment) {
    permit: shared_state.guard_edit()
    permit.value.environments.push(environment)
}

sema_check_shared_take_environment: fn(shared_state: Shared<SemaCheckShared>) -> SemaScopeEnvironment {
    permit: shared_state.guard_edit()
    permit.value.environments.pop() ?? panic("the body-check environment left the threads' shared state")
}

sema_check_shared_take_program: fn(shared_state: Shared<SemaCheckShared>) -> SemaProgramTables {
    permit: shared_state.guard_edit()
    permit.value.programs.pop() ?? panic("the body-check program tables left the threads' shared state")
}

sema_check_shared_take_memory_plan: fn(shared_state: Shared<SemaCheckShared>) -> SemaFunctionMemoryPlan {
    permit: shared_state.guard_edit()
    permit.value.memory_plans.pop() ?? panic("the body-check memory plan left the threads' shared state")
}

// Moves the pass environment, program tables and memory plan into shared state.
sema_check_shared_fill: fn(shared_state: Shared<SemaCheckShared>, environment: &&SemaScopeEnvironment, program: &&SemaProgramTables, memory_plan: &&SemaFunctionMemoryPlan) {
    permit: shared_state.guard_edit()
    permit.value.environments.push(environment)
    permit.value.programs.push(program)
    permit.value.memory_plans.push(memory_plan)
}

// Moves the program tables and memory plan alone into shared state; a body
// wave's lead keeps the pass environment (sema_check_body_wave_run).
sema_check_shared_put_tables: fn(shared_state: Shared<SemaCheckShared>, program: &&SemaProgramTables, memory_plan: &&SemaFunctionMemoryPlan) {
    permit: shared_state.guard_edit()
    permit.value.programs.push(program)
    permit.value.memory_plans.push(memory_plan)
}

// The diagnostic `diagnostic` defers to the failure solve: the key of the
// unannotated callee it names (`sema_failure_defer_obligation`).
sema_failure_obligation_callee: fn(diagnostic: Diagnostic, mark: String) -> String? Never! {
    detail: diagnostic.detail ?? return None
    if !detail.starts_with(mark) -> return None
    lines: detail.split("\n").to_list()
    Val(lines[0].replace(mark, ""))
}

// Whether a function check reported an error a keep-going trap answers for.
// Before the failure solve (`pending_obligations`) an obligation against an
// unannotated callee is not one yet: the solve discharges it, or the module
// that keeps it is checked again (`sema_failure_recheck_modules`).
sema_check_function_failed: fn(diagnostics: [Diagnostic], start: Int, pending_obligations: Bool) -> Bool Never! {
    if !pending_obligations -> return sema_has_error_since(diagnostics, start)
    mark: sema_failure_obligation_mark()
    loop index in start..<diagnostics.len() {
        if diagnostics[index].severity == DIAGNOSTIC_ERROR && sema_failure_obligation_callee(diagnostics[index], mark) == None -> return true
    }
    false
}

// Whether `module_result` calls one of `keys` or names one as a value.
sema_failure_module_references: fn(module_result: SemaGraphModuleResult, keys: [String:Bool]) -> Bool Never! {
    loop fact in module_result.call_facts {
        if fact.callee == .Val(callee) && keys.get(callee.key) != None -> return true
    }
    loop reference in module_result.name_references {
        if keys.get(reference.symbol.id.key) != None -> return true
    }
    false
}

// The modules the one body check can't keep, in
// order. A union contract changes what its callers check against (the cases
// a match names, the typed payloads), so each module that declares a
// projected function or a minted `#Error enum`, calls a projected function or
// names one as a value is checked again against the projected graph. A
// minted type may be named before it existed, which that module's check
// reported, so after a mint a module with an error is checked again too. A
// module with a failure obligation against a callee that kept its carrier
// (`infallible` holds the `T Never!` projections) is checked again against
// the solved graph: an inferring callback that deferred the callee's failure
// takes the callee's carrier there, and a keep-going trap sees the error, as
// it does once the obligations are settled.
sema_failure_recheck_modules: fn(modules: [SemaGraphModuleResult], unions: SemaFailureUnionProjected, infallible: [String]) -> [Int] Never! {
    union_keys := [String:Bool]{}
    loop key in unions.keys -> union_keys[key] = true
    declaring := [Bool]{}
    loop _ in modules -> declaring.push(false)
    loop module_index in unions.modules -> declaring[module_index] = true
    plain_keys := [String:Bool]{}
    loop key in infallible -> plain_keys[key] = true
    mark: sema_failure_obligation_mark()
    selected := [Int]{}
    loop (module_index, module_result) in modules {
        recheck := declaring[module_index]
        if !recheck && union_keys.len() > 0 -> recheck = sema_failure_module_references(module_result, union_keys)
        if !recheck {
            loop diagnostic in module_result.diagnostics {
                if diagnostic.severity != DIAGNOSTIC_ERROR -> next
                callee: sema_failure_obligation_callee(diagnostic, mark)
                recheck = if callee == .Val(key) -> plain_keys.get(key) == None else -> unions.minted
                if recheck -> break
            }
        }
        if recheck -> selected.push(module_index)
    }
    selected
}

// #3708 / #3740: the Rust reference checks every body once and reconciles the `T
// Never!` projection afterwards (`solve_inferred_failure`, the Rust reference's
// `is_result_carrier`, `plain_named_fn_value`). A module checked before the solve
// projected `projected` takes it here: each projected function's checked signature
// names the `T Never!` carrier, and a dropped call to one is a discarded result
// (E0433). Its call sites keep the carrier they were checked against; lowering hands
// a plain-return callee's value to any `Result` carrier a call site names.
sema_failure_reconcile_infallible: fn(modules: &[SemaGraphModuleResult], projected: [String]) {
    if projected.len() == 0 -> return
    keys := [String:Bool]{}
    loop key in projected -> keys[key] = true
    loop module_index in 0..<modules.len() {
        loop function_index in 0..<modules[module_index].functions.len() {
            if keys.get(modules[module_index].functions[function_index].key) != None -> sema_failure_reconcile_function(modules[module_index].functions[function_index])
        }
        loop fact_index in 0..<modules[module_index].call_facts.len() {
            if !modules[module_index].call_facts[fact_index].discarded_if_infallible -> next
            if modules[module_index].call_facts[fact_index].callee == .Val(callee) && keys.get(callee.key) != None -> modules[module_index].call_facts[fact_index].discarded = true
        }
    }
}

// One projected function's checked signature names the `T Never!` carrier
// (sema_failure_reconcile_infallible).
sema_failure_reconcile_function: fn(function: &FnBody) Never! {
    if function.ret == .Val(.Result(ok, _)) {
        ret: Type.Result{ok: ok, err: Type.Named{name: "Never"}}
        function.ret = Val(ret)
        failure: sema_failure_carrier(Val(ret))
        sema_body_fact_return(function.tree, ret, failure)
        function.failure_carrier = failure
    }
}

// The checked type definitions a finalization reads: every staged module's.
sema_stage_checked_types: fn(modules: [SemaGraphModuleResult]) -> [TTypeDef] Never! {
    checked_types := [TTypeDef]{}
    loop staged_module in modules {
        loop type_definition in staged_module.declarations.type_defs -> checked_types.push(type_definition.copy())
    }
    checked_types
}

// Adds the diagnostics `comptime_functions` bring a finalization to
// `diagnostics`; whether they leave it complete. A pending result's
// obligations reach the failure solve through the body pass that reuses it
// (sema_comptime_push_obligations).
sema_comptime_function_diagnostics: fn(comptime_functions: [SemaComptimeFunctionResult], diagnostics: &[Diagnostic]) -> Bool Never! {
    mark: sema_failure_obligation_mark()
    complete := true
    loop result in comptime_functions {
        loop diagnostic in result.diagnostics {
            if result.obligations_pending && sema_failure_obligation_callee(diagnostic, mark) != None -> next
            diagnostics.push(diagnostic.copy())
        }
        if !result.complete && !result.obligations_pending -> complete = false
    }
    complete
}

// A file of top-level statements is a program: with no `run: fn` of its own,
// the entry file's statements are, in order, the body of its `run: fn`
// (sema_script_entry), so they reach this check only beside an explicit one.
// That file is E0621, and an imported file with loose statements E0620, each
// spanning the first through the last statement. A file-scope `name: value`
// binding is a module global which the parser already registers as a
// declaration.
sema_check_script_entries: fn(graph: SemaRegistrationGraph, diagnostics: &[Diagnostic]) -> Bool {
    found := false
    loop source_module_index in 0..<graph.modules.len() {
        statements: graph.modules[source_module_index].program.script_body
        if statements.len() == 0 -> next
        span: Span{start: sema_compiler_index_stmt_span(statements[0]).start, end: sema_compiler_index_stmt_span(statements[statements.len() - 1]).end}
        start: diagnostics.len()
        if {
            graph.modules[source_module_index].module_identity != graph.entry_module_identity -> diagnostics.push(sema_error("E0620", span, "imported script `{graph.modules[source_module_index].source_file}` has executable top-level statements", "imported files provide declarations; executable code belongs in the entry file, so an import never gains a hidden side effect.", "move the statements into the entry file, or import a declaration-only file"))
            else -> diagnostics.push(sema_error("E0621", span, "this file has top-level statements and a `run: fn`", "a file's top-level statements are its entry, and so is `run: fn`; a program has one entry", "move the statements into `run: fn`, or remove `run: fn` so the statements run"))
        }
        sema_attach_diagnostic_source_locations(diagnostics, start, graph.modules[source_module_index].source_segments)
        found = true
    }
    found
}

// The entry file `program` of a load: a file whose top level holds
// statements and declares no `run: fn` is a program whose `run: fn` runs
// those statements in order (owner ruling 2026-11-09, #6281). Its
// top-level bindings are part of that order: `total := 0` and `limit: 3`
// are locals of the generated `run: fn` (Main ruling 2026-11-09, option A),
// so its functions don't see them (sema_unknown_entry_local). An ALL_CAPS
// constant, a `#Persist` or comptime binding and the Output defaults record
// stay module declarations. A file with both keeps its statements for E0621
// (sema_check_script_entries).
sema_script_entry: fn(program: &Program) {
    count: program.script_body.len()
    if count == 0 -> return
    loop item in program.items {
        if item == .Func(function) && function.name == "run" && function.external_type == None -> return
    }
    statements := [Stmt]{}
    compiler_transfer_rows<Stmt>(statements, program.script_body)
    // Popped twice, the items come back in source order.
    reversed := [Item]{}
    loop program.items.len() > 0 -> reversed.push(program.items.pop() ?? panic("a nonempty item list failed to pop"))
    locals := [Stmt]{}
    loop reversed.len() > 0 {
        item := reversed.pop() ?? panic("a nonempty item list failed to pop")
        if item == .Const(definition) && sema_script_entry_local(definition) {
            binding := ast_binding(definition.name.copy(), definition.name_span, definition.mutable, definition.value.copy(), None)
            binding.ty = definition.ty.copy()
            binding.meta = definition.meta.copy()
            binding.markers = definition.markers.copy()
            program.entry_locals.push(definition.name.copy())
            locals.push(Stmt.Val{binding: binding})
            next
        }
        program.items.push(item)
    }
    // `statements` and `locals` are each in source order: take the later of
    // the two tails into `order`, which then pops in source order.
    order := [Stmt]{}
    loop statements.len() > 0 || locals.len() > 0 {
        local_last: locals.len() > 0 && (statements.len() == 0 || sema_compiler_index_stmt_span(locals[locals.len() - 1]).start > sema_compiler_index_stmt_span(statements[statements.len() - 1]).start)
        if local_last {
            order.push(locals.pop() ?? panic("a nonempty local list failed to pop"))
            next
        }
        order.push(statements.pop() ?? panic("a nonempty statement list failed to pop"))
    }
    start: sema_compiler_index_stmt_span(order[order.len() - 1]).start
    end: sema_compiler_index_stmt_span(order[0]).end
    entry := ast_func("run", Span{start: start, end: start}, Span{start: start, end: end})
    loop order.len() > 0 -> entry.body.push(order.pop() ?? panic("a nonempty statement list failed to pop"))
    program.items.push(Item.Func{value: entry})
}

// Whether the file-scope binding `definition` of an entry file of
// top-level statements is a local of its entry (sema_script_entry).
sema_script_entry_local: fn(definition: ConstDef) -> Bool Never! {
    if definition.is_persist || definition.is_comptime -> return false
    if definition.ty == (Val(Type.Named{name: "__OutputDefaults"})) -> return false
    definition.mutable || sema_casing_has_case(definition.name, SemaNameCase.Snake)
}

// `host_hooks` are the driver's host callbacks; `threads` admits the
// compiler threads of the body pass (sema_finalize_check_modules). `resolved`
// is `graph` with `values` already applied when the caller owns one (the
// comptime run's graph, JetDriverComptimeRunResult.graph); None applies the
// values to the consumed baseline graph without copying it.
sema_finalize_registration_graph: fn(graph: &&SemaRegistrationGraph, resolved: &&SemaRegistrationGraph?, stage: SemaComptimeDeclarationStage, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], host_hooks: Shared<SemaRegistrationHostHooks>, threads: CompilerThreads, session: SemaIncrementalCache?, trace_sink: CompilerTraceSink?) -> SemaGraphResult {
    owned := resolved.move()
    resolved_graph := owned.move() ?? sema_comptime_graph_with_values(graph, values)
    trail := sema_graph_trail_init()
    result := sema_finalize_graph(resolved_graph, trail, stage, values, comptime_functions, host_hooks, threads, session, true, trace_sink)
    result.registration_graph = None
    result
}

// Demand: after the body pass, every generated codec an
// Encode/Decode requirement reached gets its body (sema_codec_fill_demanded)
// and is checked into its module's result. A wave's checks may require more
// codecs, so waves repeat until no requirement is new; a program that reaches
// no generated codec runs none. The counters compare the generated codec
// impls registered (candidates) with those that got a body.
sema_codec_waves: fn(owned: &&SemaRegistrationGraph, trail: &SemaGraphTrail, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], checked_types: [TTypeDef], host_hooks: SemaHostHookAccess?, threads: CompilerThreads, trace_sink: CompilerTraceSink?, carried: &[SemaPassFacts], modules: &[SemaGraphModuleResult]) -> SemaRegistrationGraph {
    graph := owned.move()
    candidates: graph.codec_method_rows.len()
    generated := 0
    waves := 0
    loop {
        affected: sema_codec_fill_demanded(graph, trail)
        if affected.len() == 0 -> break
        generated += graph.codec_wave_rows.len()
        waves += 1
        // The filled bodies change the rows the pass facts read.
        carried = [SemaPassFacts]{}
        checked := sema_finalize_check_modules(graph, values, comptime_functions, checked_types, affected, true, host_hooks, threads, None, "sema.codecs", trace_sink, carried, modules)
        graph = checked.move()
        graph.codec_wave_rows = [String:Bool]{}
    }
    if trace_sink == .Val(sink) {
        sink.progress("counters.sema.codec_candidates", candidates, -1)
        sink.progress("counters.sema.codec_generated", generated, -1)
        sink.progress("counters.sema.codec_waves", waves, -1)
    }
    graph.move()
}

// Demand: after the body pass and the codec waves, every demand-checked
// derived method a check reached (sema_derive_demand_call,
// sema_derive_demand_type) is checked into its module's result. A wave's
// bodies compare their fields, so they may demand more; waves repeat until
// none is new. Derived `equal`/`compare` bodies call no codec, so no codec
// wave follows. A program that compares no compiler-owned type runs none.
sema_derive_waves: fn(owned: &&SemaRegistrationGraph, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], checked_types: [TTypeDef], host_hooks: SemaHostHookAccess?, threads: CompilerThreads, trace_sink: CompilerTraceSink?, carried: &[SemaPassFacts], modules: &[SemaGraphModuleResult]) -> SemaRegistrationGraph {
    graph := owned.move()
    checked := 0
    waves := 0
    loop {
        wave := [String:Bool]{}
        affected := [Int]{}
        loop key in sema_derive_demand_keys(graph.derive_demand) {
            if graph.derive_checked.get(key) != None -> next
            row: graph.derive_method_rows.get(key) ?? next
            wave[key] = true
            graph.derive_checked[key] = true
            if !affected.contains(row.module_index) -> affected.push(row.module_index)
        }
        if wave.len() == 0 -> break
        affected.sort()
        checked += wave.len()
        waves += 1
        graph.derive_wave_rows = wave.move()
        result := sema_finalize_check_modules(graph, values, comptime_functions, checked_types, affected, true, host_hooks, threads, None, "sema.derives", trace_sink, carried, modules)
        graph = result.move()
        graph.derive_wave_rows = [String:Bool]{}
    }
    if trace_sink == .Val(sink) {
        sink.progress("counters.sema.derive_deferred", graph.derive_method_rows.len(), -1)
        sink.progress("counters.sema.derive_checked", checked, -1)
        sink.progress("counters.sema.derive_waves", waves, -1)
    }
    graph.move()
}

// sema_finalize_registration_graph on `resolved`, the registration graph
// with `values` applied, moved in: every edit finalization makes to it is
// recorded on `trail`, and the graph comes back as the result's
// `registration_graph`, so the caller can undo the edits instead of keeping
// a copy of the registration graph. Values never change the graph's
// identities or `complete`, which are read from `resolved`. `build_names`
// builds the bundle's name facts; without it the result carries only their
// structure facts, for a caller that builds the names itself once it has
// changed the modules (the driver's checked-text merge).
sema_finalize_graph: fn(resolved: &&SemaRegistrationGraph, trail: &SemaGraphTrail, stage: SemaComptimeDeclarationStage, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], host_hooks: Shared<SemaRegistrationHostHooks>, threads: CompilerThreads, session: SemaIncrementalCache?, build_names: Bool, trace_sink: CompilerTraceSink?) -> SemaGraphResult {
    bodies := sema_finalize_bodies_empty()
    bodies.build_names = build_names
    body_graph := sema_finalize_bodies(resolved, trail, stage, values, comptime_functions, host_hooks, threads, session, trace_sink, bodies)
    sema_finalize_program(body_graph, trail, stage, values, comptime_functions, host_hooks, threads, trace_sink, bodies)
}

// What the body half of a finalization (sema_finalize_bodies) hands its
// whole-program half (sema_finalize_program): the checked modules, the pass
// facts the Core demand waves read while the graph rows stay unchanged, the
// stage's checked types, whether the graph and the stage were complete, and
// whether the whole-program half builds the bundle's name facts
// (sema_finalize_graph's `build_names`).
SemaFinalizeBodies: struct {
    modules: [SemaGraphModuleResult]
    carried: [SemaPassFacts]
    checked_types: [TTypeDef]
    complete: Bool
    build_names: Bool
}

// Bodies for sema_finalize_bodies to fill, with no name facts built.
sema_finalize_bodies_empty: fn() -> SemaFinalizeBodies {
    SemaFinalizeBodies{modules: [SemaGraphModuleResult]{}, carried: [SemaPassFacts]{}, checked_types: [TTypeDef]{}, complete: false, build_names: false}
}

// The body half of sema_finalize_graph: the body pass over every module and
// the codec and derive waves it demands, into `bodies`. The graph moves in
// and comes back with its edits on `trail`.
sema_finalize_bodies: fn(resolved: &&SemaRegistrationGraph, trail: &SemaGraphTrail, stage: SemaComptimeDeclarationStage, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], host_hooks: Shared<SemaRegistrationHostHooks>, threads: CompilerThreads, session: SemaIncrementalCache?, trace_sink: CompilerTraceSink?, bodies: &SemaFinalizeBodies) -> SemaRegistrationGraph {
    resolved_graph := resolved.move()
    // #4319 lookup counters are traced through `sema.check` only; counting
    // here would serialize the body-check threads on the shared counters.
    trail.entries.push(SemaGraphUndo.Counting{old: resolved_graph.counting})
    resolved_graph.counting = false
    hook_access: sema_host_hook_access(host_hooks)
    bodies.checked_types = sema_stage_checked_types(stage.modules)
    bodies.complete = resolved_graph.complete && stage.complete
    if session == .Val(cache) -> sema_incremental_begin(cache, resolved_graph, values, comptime_functions, bodies.checked_types)
    // Derived methods and deferred Core bodies are demanded afresh by this
    // pass's checks. A compile that checks every Core body (`jet check Core`)
    // demands every derived method too, so Core's derives get the checks a
    // package's do.
    sema_derive_demand_reset(resolved_graph.derive_demand)
    if resolved_graph.every_core_body -> sema_derive_demand_add(resolved_graph.derive_demand, loop (key, _) in resolved_graph.derive_method_rows -> key.copy())
    resolved_graph.derive_checked = [String:Bool]{}
    incremental: if session == .Val(_) -> true else -> false
    web_checks: sema_web_partition_active(resolved_graph)
    sema_core_demand_index(resolved_graph, (resolved_graph.check_tests || resolved_graph.core_lowering_roots != None || resolved_graph.retained_core_demand) && (!resolved_graph.retain_programs || resolved_graph.retained_core_demand) && !resolved_graph.every_core_body && !incremental && !web_checks)
    all_modules: loop module_index in 0..<resolved_graph.modules.len() -> module_index
    // The body pass's facts serve the codec and derive waves after it while
    // the graph rows they read stay unchanged (sema_finalize_check_modules).
    body_graph := sema_finalize_check_modules(resolved_graph, values, comptime_functions, bodies.checked_types, all_modules, true, hook_access, threads, session, "sema.bodies", trace_sink, bodies.carried, bodies.modules)
    // Demand: only the generated codecs a requirement reached
    // get bodies, checked into their modules' results before the failure solve,
    // and only the derived methods of compiler-owned modules a check reached.
    after_codec_graph := sema_codec_waves(body_graph, trail, values, comptime_functions, bodies.checked_types, hook_access, threads, trace_sink, bodies.carried, bodies.modules)
    sema_derive_waves(after_codec_graph, values, comptime_functions, bodies.checked_types, hook_access, threads, trace_sink, bodies.carried, bodies.modules)
}

// The whole-program half of sema_finalize_graph over the `bodies` of
// sema_finalize_bodies: the Core demand waves, the failure solve and
// recheck, and every whole-program pass after them. The graph moves in and
// comes back as the result's `registration_graph`, with its edits on
// `trail`. `values` and `comptime_functions` are the ones the bodies were
// checked against.
sema_finalize_program: fn(owned: &&SemaRegistrationGraph, trail: &SemaGraphTrail, stage: SemaComptimeDeclarationStage, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], host_hooks: Shared<SemaRegistrationHostHooks>, threads: CompilerThreads, trace_sink: CompilerTraceSink?, bodies: &&SemaFinalizeBodies) -> SemaGraphResult {
    body_graph := owned.move()
    held := bodies.move()
    modules := held.modules.move()
    carried := held.carried.move()
    checked_types: held.checked_types.move()
    complete := held.complete
    hook_access: sema_host_hook_access(host_hooks)
    diagnostics := stage.diagnostics
    if !sema_comptime_function_diagnostics(comptime_functions, diagnostics) -> complete = false
    after_body_graph := sema_core_demand_waves(body_graph, trail, values, comptime_functions, checked_types, hook_access, threads, trace_sink, carried, modules)
    carried = [SemaPassFacts]{}
    // Every body the program reaches is checked (a Core body no check
    // demanded stays unchecked and has no caller), so the failure solve finds
    // the unannotated functions that can never fail.
    if trace_sink == .Val(sink) -> sink.begin("sema.failure", "", -1, -1)
    inferred_infallible := sema_failure_solve(after_body_graph, modules)
    // The same rows settle the
    // failure union of every unannotated function. Each inferred contract,
    // and the `T Never!` plain return of each infallible one (#3708 T1), is
    // projected onto the graph, so every later check and lowering read that
    // one contract.
    union_start: diagnostics.len()
    unions: sema_failure_union_infer(after_body_graph, modules, diagnostics, trail)
    if diagnostics.len() > union_start -> complete = false
    infallible: sema_failure_project_infallible(after_body_graph, inferred_infallible, trail)
    trail.entries.push(SemaGraphUndo.FailureSolved{old: after_body_graph.failure_solved})
    after_body_graph.failure_solved = true
    if trace_sink == .Val(sink) -> sink.end("sema.failure", inferred_infallible.len())
    // One body pass: only the modules a union contract changes, or whose
    // failure obligations name a callee the solve left fallible, are checked
    // again; the `T Never!` projections are reconciled onto the checked bodies.
    recheck: sema_failure_recheck_modules(modules, unions, infallible)
    final_graph := if {
        recheck.len() > 0 -> {
            rechecked := [SemaGraphModuleResult]{}
            // The projected contracts change the rows the pass facts read.
            recheck_facts := [SemaPassFacts]{}
            // A body checked for compile-time execution was checked against
            // the contract its function had before the solve: one whose
            // contract a union projection changed is checked again with its
            // callers, which read the projected one.
            recheck_functions: if unions.keys.len() == 0 -> comptime_functions else -> sema_comptime_functions_without(comptime_functions, unions.keys)
            after_recheck_graph := sema_finalize_check_modules(after_body_graph, values, recheck_functions, checked_types, recheck, false, hook_access, threads, None, "sema.recheck", trace_sink, recheck_facts, rechecked)
            // One rechecked result per `recheck` row, in order: each moves
            // into its module's slot, last row first.
            loop rechecked.len() > 0 {
                row: rechecked.len() - 1
                checked := rechecked.pop() ?? break
                modules[recheck[row]] = checked.move()
            }
            after_recheck_graph.move()
        }
        else -> after_body_graph.move()
    }
    sema_failure_reconcile_infallible(modules, infallible)
    // The export and import rows read the projected declarations.
    loop module_index in 0..<modules.len() {
        modules[module_index].exports = final_graph.modules[module_index].exports
        modules[module_index].imports = final_graph.modules[module_index].imports
    }
    loop module_result in modules {
        loop diagnostic in module_result.diagnostics -> diagnostics.push(diagnostic)
        if !module_result.complete -> complete = false
    }
    // The C-safe export law reads the solved carriers: an `#Export(c)` that
    // declares no carrier is refused when its body infers one.
    if sema_guest_check_export_failures(final_graph, modules, diagnostics) -> complete = false
    // The failure-domain obligations recorded against unannotated callees
    // are discharged or emitted.
    infallible_keys := [String:Bool]{}
    loop key in inferred_infallible -> infallible_keys[key] = true
    if sema_failure_settle_obligations(diagnostics, infallible_keys) -> complete = false
    loop settle_index in 0..<modules.len() {
        if sema_failure_settle_obligations(modules[settle_index].diagnostics, infallible_keys) -> modules[settle_index].complete = false
    }
    // The bundle list and the per-module lists each keep one report per
    // failure domain.
    bundle_domains := [String:Bool]{}
    sema_failure_domain_dedupe(diagnostics, bundle_domains)
    module_domains := [String:Bool]{}
    loop dedupe_index in 0..<modules.len() -> sema_failure_domain_dedupe(modules[dedupe_index].diagnostics, module_domains)
    // The `#Inline(Always)` promise (E0917-E0919) needs every body's
    // function-value references first. These read-only checks, the effect
    // inputs with each module's effect-graph rows, and the liveness verdicts
    // run side by side.
    if trace_sink == .Val(sink) -> sink.begin("sema.side", "", -1, -1)
    effect_inputs := [SemaEffectModuleInput]{}
    effect_prepared := sema_effect_prepared_empty()
    liveness := sema_finalize_side_liveness_empty()
    taint_prepared := [SemaTaintPrepared]{}
    final_graph = sema_finalize_side_checks(final_graph, modules, threads, diagnostics, complete, effect_inputs, effect_prepared, liveness, taint_prepared)
    if trace_sink == .Val(sink) -> sink.end("sema.side", liveness.facts.len())
    if trace_sink == .Val(sink) -> sink.begin("sema.effects", "", -1, -1)
    root_policy: sema_comptime_policy_for_package(stage.package_policies, final_graph.package_identity)
    package_denials: if root_policy == .Val(policy) -> policy.authority_deny ?? [String]{} else -> [String]{}
    organization_denials: if root_policy == .Val(policy) -> policy.organization_deny.copy() else -> [String]{}
    organization_source: if root_policy == .Val(policy) -> policy.organization_source.copy() else -> ""
    // The root package's `authority.deny` row, and the organization's, bind
    // the root package's own modules.
    denial_modules := [Bool]{}
    loop graph_module in final_graph.modules -> denial_modules.push(graph_module.package_identity == final_graph.package_identity)
    // Each `#FX(…)` module cap names known effects, checked once where it is
    // written; a file module's caps reach its file through the module graph,
    // and an erased generic-module template leaves its cap behind. A capped
    // type's function-typed fields fit its cap where they are declared.
    field_caps: sema_effect_type_caps(final_graph.modules)
    loop graph_module in final_graph.modules {
        cap_diagnostics := [Diagnostic]{}
        if graph_module.program.file_cap == .Val(head) -> sema_effect_cap_entry_names(head, cap_diagnostics)
        loop cap in graph_module.template_caps -> sema_effect_cap_entry_names(cap, cap_diagnostics)
        sema_effect_module_cap_names(graph_module.program.items, cap_diagnostics)
        sema_effect_check_field_rows(graph_module, field_caps, cap_diagnostics)
        sema_effect_publish_diagnostics(diagnostics, graph_module.source_segments, cap_diagnostics)
    }
    file_caps: sema_effect_file_module_caps(final_graph.modules, final_graph.edges)
    trait_caps: sema_effect_trait_caps(final_graph.modules)
    // The functions the build checked to run while compiling are prep code,
    // never a runtime entry (sema_effect_runtime_input_paths).
    prep_functions := [String:Bool]{}
    loop result in comptime_functions -> prep_functions[result.function_key.copy()] = true
    // The effect graph reads every checked body in place and stamps each
    // solved row onto `modules`.
    effects := sema_effects_check_modules(modules, effect_inputs, effect_prepared, package_denials, denial_modules, file_caps, trait_caps, final_graph.decls, prep_functions, threads, organization_denials, organization_source)
    if trace_sink == .Val(sink) -> sink.end("sema.effects", effect_inputs.len())
    loop diagnostic in effects.diagnostics -> diagnostics.push(diagnostic)
    if !effects.complete -> complete = false
    // The web partition reads the solved effect rows and call edges.
    sema_web_partition_check(modules, final_graph, diagnostics)
    // Code the entry reaches uses only the effects its target provides.
    sema_target_denial_check(modules, final_graph, diagnostics)
    // `#Target(OS.…)` impls: the axis conflict and ungated signature uses.
    sema_os_target_check(final_graph, diagnostics)
    // Typestate flow reads each body's checked receiver types.
    sema_typestate_check(modules, final_graph, diagnostics)
    outputs := sema_output_publish_solved_effects(final_graph, modules)
    compute_work := SemaComputeValidationWork{}
    compute_diagnostics := sema_compute_validate_autodiff_purity(modules, compute_work)
    loop diagnostic in compute_diagnostics {
        if diagnostic.span == {
            .Val(span) -> {
                owner_index := Int?{None}
                ambiguous := false
                index := 0
                loop index < modules.len() {
                    if sema_compute_module_owns_site(modules[index], span) {
                        if owner_index != None -> ambiguous = true
                        owner_index = Val(index)
                    }
                    index += 1
                }
                if {
                    owner_index == .Val(owner_module_index) && !ambiguous -> {
                        registration_index: sema_registration_module_index(final_graph, modules[owner_module_index].module_identity)
                        if registration_index == {
                            .Val(found_index) -> {
                                registration: final_graph.modules[found_index]
                                located := [Diagnostic]{diagnostic}
                                sema_attach_diagnostic_source_locations(located, 0, registration.source_segments)
                                diagnostics.push(located[0])
                            }
                            .None -> {
                                diagnostics.push(diagnostic)
                            }
                        }
                    }
                    else -> {
                        diagnostics.push(diagnostic)
                    }
                }
            }
            .None -> {
                diagnostics.push(diagnostic)
            }
        }
        complete = false
    }

    // Tag dataflow over every checked body (the Rust reference's
    // `check_fact_tags_and_states`): a tagged value reaching a denied
    // destination is reported, whatever else the bundle reported. The Core
    // usage walk runs beside it (sema_finalize_walks).
    if trace_sink == .Val(sink) -> sink.begin("sema.walks", "", -1, -1)
    taint_diagnostics := [Diagnostic]{}
    taint_catalog := taint_prepared.pop() ?? panic("the side checks left no taint catalog")
    core_modules := [SemaCoreModuleUsageResult]{}
    final_graph = sema_finalize_walks(final_graph, taint_catalog, diagnostics, modules, threads, taint_diagnostics, core_modules)
    core_usage := sema_core_combine_module_usage(core_modules)
    if trace_sink == .Val(sink) -> sink.end("sema.walks", core_modules.len())
    loop diagnostic in taint_diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> complete = false
        diagnostics.push(diagnostic)
    }

    if !sema_web_host_check_core_usage(final_graph.target_machine.name, core_usage.used_core, diagnostics) -> complete = false
    if !sema_target_check_socket_surfaces(final_graph, core_usage.used_core, diagnostics) -> complete = false
    // A Core import above the package's runtime ceiling is reported on the
    // import; a module whose imports already fail is not reported again for
    // the helpers those imports reach.
    import_blocked := [String:Bool]{}
    loop source_module in final_graph.modules {
        policy: sema_comptime_policy_for_package(stage.package_policies, source_module.package_identity) ?? next
        ceiling: policy.runtime_ceiling ?? next
        diagnostic_start := diagnostics.len()
        loop declaration in source_module.program.imports {
            loop module_name in sema_runtime_ceiling_import_modules(declaration) {
                needed: jet_ring_core_module_layer(module_name)
                if !sema_comptime_layer_exceeds(needed, ceiling) -> next
                diagnostics.push(sema_comptime_runtime_ceiling_diagnostic(module_name, needed, ceiling, Val(declaration.span), "`use {module_name}`"))
                import_blocked[source_module.module_identity] = true
                complete = false
            }
        }
        sema_attach_diagnostic_source_locations(diagnostics, diagnostic_start, source_module.source_segments)
    }
    loop module_usage in core_usage.modules {
        usage_index: sema_registration_module_index(final_graph, module_usage.module_identity) ?? next
        source_module: final_graph.modules[usage_index]
        policy: sema_comptime_policy_for_package(stage.package_policies, source_module.package_identity) ?? next
        ceiling: policy.runtime_ceiling ?? next
        if import_blocked.get(source_module.module_identity) != None -> next
        if !sema_comptime_layer_exceeds(module_usage.inferred_layer, ceiling) -> next
        diagnostic_start := diagnostics.len()
        loop row in module_usage.usage_spans {
            needed: jet_ring_prelude_closure_layer([String]{row.usage})
            if !sema_comptime_layer_exceeds(needed, ceiling) -> next
            diagnostics.push(sema_comptime_runtime_ceiling_diagnostic(row.usage, needed, ceiling, Val(row.span), sema_runtime_ceiling_helper_chain(row.usage, source_module.program.imports)))
        }
        if diagnostics.len() == diagnostic_start {
            diagnostics.push(sema_comptime_runtime_ceiling_diagnostic(source_module.module_identity, module_usage.inferred_layer, ceiling, None, "the module's reachable Core closure"))
        }
        sema_attach_diagnostic_source_locations(diagnostics, diagnostic_start, source_module.source_segments)
        complete = false
    }
    // A UI host service needs its capability in the package's
    // `authority.needs` (E2937).
    loop module_index in 0..<modules.len() {
        usage_index: sema_registration_module_index(final_graph, modules[module_index].module_identity) ?? next
        source_module: final_graph.modules[usage_index]
        policy: sema_comptime_policy_for_package(stage.package_policies, source_module.package_identity) ?? next
        diagnostic_start := diagnostics.len()
        sema_core_check_ui_capabilities(modules[module_index].call_facts, final_graph, core_usage.modules, source_module.module_identity, policy.authority_needs, diagnostics)
        if diagnostics.len() == diagnostic_start -> next
        sema_attach_diagnostic_source_locations(diagnostics, diagnostic_start, source_module.source_segments)
        complete = false
    }

    if trace_sink == .Val(sink) -> sink.begin("sema.facts", "", -1, -1)
    call_facts := [SemaCallSiteFact]{}
    hardware_use := sema_hardware_empty_use()
    comptime_requests := [SemaComptimeRequest]{}
    comptime_body_sources := [SemaComptimeBodySource]{}
    compute_facts := [SemaComputeFunctionFacts]{}
    loop module_index in 0..<modules.len() {
        module_result: modules[module_index]
        loop fact in module_result.call_facts -> call_facts.push(fact.copy())
        sema_hardware_use_merge(hardware_use, sema_hardware_use_snapshot(module_result.hardware_use))
        loop request in module_result.comptime_requests -> comptime_requests.push(request.copy())
        loop source in module_result.comptime_body_sources -> comptime_body_sources.push(source.copy())
        loop facts in module_result.compute_facts -> compute_facts.push(facts.copy())
    }
    if trace_sink == .Val(sink) -> sink.end("sema.facts", call_facts.len())
    // Only an error makes the graph incomplete: warning-only bodies (L0103
    // unused imports and the like) still lower and emit.
    if stage.diagnostics.len() == 0 {
        loop diagnostic in diagnostics {
            if diagnostic.severity == DIAGNOSTIC_ERROR {
                complete = false
                break
            }
        }
    }
    loop diagnostic in sema_http_unmounted_warnings(final_graph, modules) -> diagnostics.push(diagnostic)
    // Bundle-owned structure verdicts share the same checked references on
    // success and failure; consumers never reconstruct them from source text.
    // The liveness verdicts were read with the side checks, before the effect
    // pass, which changes no reference, call fact or declaration they read.
    if trace_sink == .Val(sink) -> sink.begin("sema.lifecycle", "", -1, -1)
    lifecycle: sema_lifecycle_structure(final_graph, modules, stage.package_policies)
    if trace_sink == .Val(sink) -> sink.end("sema.lifecycle", lifecycle.facts.len())
    loop diagnostic in liveness.diagnostics -> diagnostics.push(diagnostic)
    loop diagnostic in lifecycle.diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> complete = false
        diagnostics.push(diagnostic)
    }
    if trace_sink == .Val(sink) -> sink.begin("sema.names", "", -1, -1)
    structure_facts := sema_name_structure_facts(final_graph)
    loop fact in lifecycle.facts -> structure_facts.push(fact)
    loop fact in liveness.facts -> structure_facts.push(fact)
    names := sema_name_facts_empty()
    if {
        held.build_names -> final_graph = sema_name_build_facts_threads(final_graph, modules, structure_facts, threads, names)
        else -> names.structure_facts = structure_facts
    }
    if trace_sink == .Val(sink) -> sink.end("sema.names", names.references.len())
    // Core modules are checked in the same bundle so their errors keep the
    // program honest, but Core is library source: its lints are not the
    // user's to act on and never reach user output. A lint inside a site
    // `#Allow` for it is the author's recorded decision (LintAllowances.jet).
    allowances := [SemaLintAllowance]{}
    loop source_module in final_graph.modules -> sema_lint_allowances(source_module.program, source_module.source_segments, allowances)
    reported := [Diagnostic]{}
    loop diagnostic in diagnostics {
        if !sema_core_source_lint(diagnostic) && !sema_lint_allowed(diagnostic, allowances) -> reported.push(diagnostic)
    }
    diagnostics = reported
    sema_crypto_misuse_precedence(diagnostics)
    sema_name_display_diagnostics(final_graph, diagnostics)
    programs := [Program]{}
    if final_graph.retain_programs {
        loop source_module in final_graph.modules -> programs.push(source_module.program)
    }
    result := SemaGraphResult{
        package_identity: final_graph.package_identity,
        entry_module_identity: final_graph.entry_module_identity,
        modules: modules.move(),
        imports: stage.imports,
        package_policies: stage.package_policies,
        core_usage: core_usage,
        call_facts: call_facts,
        hardware_use: hardware_use,
        comptime_requests: comptime_requests,
        comptime_body_sources: comptime_body_sources,
        compute_facts: compute_facts,
        names: names,
        diagnostics: diagnostics,
        complete: complete,
        inferred_infallible: inferred_infallible,
        programs: programs,
        outputs: outputs.move(),
        memory_declarations: effects.memory_declarations.move(),
        memory_projections: effects.memory_projections.move(),
    }
    result.registration_graph = Val(final_graph.move())
    result.move()
}

// A lint reported against embedded Core library source (`<corelib>/…`).
sema_core_source_lint: fn(diagnostic: Diagnostic) -> Bool Never! {
    if diagnostic.severity != DIAGNOSTIC_LINT -> return false
    path := diagnostic.source_path ?? ""
    if path == "" && diagnostic.origin == .Val(origin) -> path = origin.path
    path == "<corelib>" || path.starts_with("<corelib>/")
}

// A compiler thread is admitted for at least this many bytes of item source
// walked, so a small program walks on the calling thread. The taint and Core
// walks (sema_finalize_walks) each read every item: twice the 65536 bytes
// either walk was once admitted a thread for on its own.
SEMA_FINALIZE_WALK_MIN_BYTES_PER_THREAD: 131072
// Core usage jobs per admitted thread, claimed dynamically.
SEMA_CORE_JOBS_PER_THREAD: 8

// The finalization's two read-only walks of the graph after the effect
// publish, run together on up to `threads` compiler threads that claim from
// one queue: the taint modules first, heaviest source first, then the Core
// ranges in order.
//
// The tag dataflow (the Rust reference's `check_fact_tags_and_states` taint
// walk) over `prepared` (sema_taint_prepare of `graph`): its reports first,
// then every function, method, test and conversion body walked once, one job
// per module. Appends the new reports to `reports`; the E0307 reports among
// `existing_diagnostics` (the bundle's reports so far) settle switch coverage
// (sema_taint_coverage_reports), and no report of `existing_diagnostics` is
// repeated. A module's walk reads only the graph, the catalog and the
// coverage reports, and each module's reports are kept apart and joined in
// module order (sema_taint_join_reports).
//
// The Core usage of every registered module, appended to `cores` in module
// order. The walk of a module's items is the only part that grows with the
// program, so the jobs are consecutive item ranges (one module each, about
// equal source bytes, every module's ranges consecutive); each thread builds
// the walk context of a job's module (sema_core_module_context, from the
// module's checked call facts) and walks its claimed ranges into their own
// rows. A job that covers its whole module also assembles that module's
// usage on its thread (sema_core_module_usage_assemble: the prefix and
// script-body usages and the reachable closure); a module's first job
// otherwise hands back its context, and the caller joins the module's rows in
// job order (sema_core_collected_append) and assembles it.
//
// So the reports, the usage sets, the first span of each usage and the
// callback keys read exactly as one thread's taint walk and then Core walk of
// every module in order. The graph and the modules move into the threads'
// shared state and back; the graph is returned. A program whose work admits
// one thread walks on the calling thread.
sema_finalize_walks: fn(graph: &&SemaRegistrationGraph, prepared: &&SemaTaintPrepared, existing_diagnostics: [Diagnostic], modules: &[SemaGraphModuleResult], threads: CompilerThreads, reports: &[Diagnostic], cores: &[SemaCoreModuleUsageResult]) -> SemaRegistrationGraph {
    owned := graph.move()
    taken := prepared.move()
    catalog := taken.catalog.move()
    reports.extend(taken.reports.move())
    taint_weights: taken.weights.move()
    coverage := sema_taint_coverage_reports(existing_diagnostics)
    weights := [Int]{}
    owners := [Int]{}
    work := 0
    loop weight in taint_weights -> work += weight
    loop module_index in 0..<owned.modules.len() {
        loop item_index in 0..<owned.modules[module_index].program.items.len() {
            span: sema_compiler_index_item_span(owned.modules[module_index].program.items[item_index])
            weight: span.end - span.start
            weights.push(weight)
            owners.push(module_index)
            work += weight
        }
    }
    workers: compiler_threads_admit(threads, taint_weights.len() + weights.len(), work, SEMA_FINALIZE_WALK_MIN_BYTES_PER_THREAD, 0, 0)
    if workers <= 1 {
        state := SemaTaintFlowState{catalog: catalog.move(), module_identity: "", bindings: [SemaTaintBindingFact]{}, imports: [SemaTaintImportAlias]{}, callable_scope: sema_taint_slots(), diagnostics: [Diagnostic]{}, coverage_reports: coverage.move(), fixed_tags: [String]{}}
        loop module_index in 0..<owned.modules.len() {
            found := [Diagnostic]{}
            sema_taint_check_module(owned, state, module_index, found)
            sema_taint_join_reports(reports, existing_diagnostics, found)
            sema_mark_masked_branches(modules[module_index].functions, state.masked, state.fixed_tags)
        }
        loop module_index in 0..<owned.modules.len() {
            context: sema_core_module_context(owned, owned.modules[module_index], modules[module_index].call_facts)
            collected := sema_core_collected_empty()
            sema_core_collect_item_range(owned.modules[module_index].program.items, 0, owned.modules[module_index].program.items.len(), context, collected)
            cores.push(sema_core_module_usage_assemble(owned.modules[module_index], context, modules[module_index].exact_int_reachable, collected))
        }
        return owned
    }
    count := workers * SEMA_CORE_JOBS_PER_THREAD
    if count > weights.len() -> count = weights.len()
    jobs: sema_finalize_core_jobs(compiler_threads_partition(weights, count), owners)
    shared_state: Shared{SemaFinalizeWalkShared{graphs: [SemaRegistrationGraph]{}, modules: [SemaGraphModuleResult]{}, catalogs: [SemaTaintCatalog]{}, coverage: [[Diagnostic]]{}, taint_order: compiler_threads_heaviest_first(taint_weights), jobs: jobs}}
    sema_finalize_walk_fill(shared_state, owned, modules, catalog, coverage)
    queue: Shared{SemaFinalizeCoreQueue{next: 0}}
    walked := [[Diagnostic]]{}
    masked := [[Span]]{}
    fixed := [[String]]{}
    loop _ in 0..<taint_weights.len() {
        walked.push([Diagnostic]{})
        masked.push([Span]{})
        fixed.push([String]{})
    }
    results := [SemaCoreCollected]{}
    assembled := [SemaCoreModuleUsageResult?]{}
    contexts := [SemaCoreModuleContext?]{}
    loop _ in 0..<jobs.len() {
        results.push(sema_core_collected_empty())
        assembled.push(None)
        contexts.push(None)
    }
    sema_finalize_walkers(shared_state, queue, 0, workers, walked, masked, fixed, results, assembled, contexts)
    returned := sema_finalize_walk_take(shared_state, modules)
    loop found in walked -> sema_taint_join_reports(reports, existing_diagnostics, found)
    loop module_index in 0..<masked.len() -> sema_mark_masked_branches(modules[module_index].functions, masked[module_index], fixed[module_index])
    // Each module in order: a module walked whole by one job was assembled
    // on its thread; any other module's item ranges are joined in job order
    // (jobs are in module and item order, so a module's jobs are
    // consecutive) and assembled here, with the context its first job built
    // (or, for a module without items, built here).
    results.reverse()
    assembled.reverse()
    contexts.reverse()
    job := 0
    loop module_index in 0..<returned.modules.len() {
        collected := sema_core_collected_empty()
        whole := SemaCoreModuleUsageResult?{None}
        context := SemaCoreModuleContext?{None}
        loop job < jobs.len() && jobs[job].module_index == module_index {
            part := results.pop() ?? panic("a Core usage job left its rows")
            done := assembled.pop() ?? panic("a Core usage job left its rows")
            built := contexts.pop() ?? panic("a Core usage job left its rows")
            if built != None -> context = built.move()
            if done == None {
                sema_core_collected_append(collected, part)
            } else {
                whole = done.move()
            }
            job += 1
        }
        if whole == None {
            module_context := context.move() ?? sema_core_module_context(returned, returned.modules[module_index], modules[module_index].call_facts)
            whole = Val(sema_core_module_usage_assemble(returned.modules[module_index], module_context, modules[module_index].exact_int_reachable, collected))
        }
        cores.push(whole.move() ?? panic("a Core usage module left no usage"))
    }
    returned
}

// Each masked branch of a module (Taint.jet sema_taint_mask_branch) joins
// FnBody.masked of every function whose source holds it, and each function
// one of whose checked types carries a fixed tag of the module
// (`fixed_tags`) gets them as FnBody.fixed_tags.
sema_mark_masked_branches: fn(functions: &[FnBody], masked: [Span], fixed_tags: [String]) Never! {
    loop span in masked {
        loop index in 0..<functions.len() {
            source: functions[index].source_span
            if span.start >= source.start && span.end <= source.end -> functions[index].masked.push(span.copy())
        }
    }
    loop index in 0..<functions.len() {
        if sema_fixed_types(functions[index].tree.types.types, fixed_tags) -> functions[index].fixed_tags = fixed_tags.copy()
    }
}

// Whether one of `types` carries a tag of `fixed_tags` on its own value or
// on a list's elements.
sema_fixed_types: fn(types: [Type], fixed_tags: [String]) -> Bool Never! {
    loop ty in types {
        if sema_fixed_type(ty, fixed_tags) -> return true
    }
    false
}

sema_fixed_type: fn(ty: Type, fixed_tags: [String]) -> Bool Never! {
    if ty == {
        .Tagged(marker, inner) -> {
            if marker == .User(name) {
                if fixed_tags.contains(name) -> return true
            }
            return sema_fixed_type(inner, fixed_tags)
        }
        .List(element) -> return sema_fixed_type(element, fixed_tags)
        .FixedList(element, _) -> return sema_fixed_type(element, fixed_tags)
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Quantity(_, _) | .Measure(_) -> return false
    }
}

// One module's consecutive item range, walked for Core usage on one thread.
SemaFinalizeCoreJob: struct {
    module_index: Int
    first: Int
    last: Int
}

// The jobs of the parts `bounds` cuts over every module's items (flattened
// in module and item order; `owners[position]` is the module of a position),
// each part cut again at its module boundaries, so a job never spans two
// modules and the jobs stay in module and item order.
sema_finalize_core_jobs: fn(bounds: [Int], owners: [Int]) -> [SemaFinalizeCoreJob] Never! {
    jobs := [SemaFinalizeCoreJob]{}
    starts := [Int]{}
    loop position in 0..<owners.len() {
        loop starts.len() <= owners[position] -> starts.push(position)
    }
    parts: bounds.len() - 1
    loop part in 0..<parts {
        position := bounds[part]
        loop position < bounds[part + 1] {
            module_index: owners[position]
            start: starts[module_index]
            end := bounds[part + 1]
            if module_index + 1 < starts.len() && starts[module_index + 1] < end -> end = starts[module_index + 1]
            jobs.push(SemaFinalizeCoreJob{module_index: module_index, first: position - start, last: end - start})
            position = end
        }
    }
    jobs
}

// What every walking thread reads (sema_finalize_walks): the registration
// graph and the checked modules (each list moved in and back out; the graph
// is its list's one row, and its modules' items are read in place); for the
// taint walk the catalog and the coverage reports (each the one row of its
// list) and the modules in claim order; for the Core walk the jobs.
SemaFinalizeWalkShared: struct {
    graphs: [SemaRegistrationGraph]
    modules: [SemaGraphModuleResult]
    catalogs: [SemaTaintCatalog]
    coverage: [[Diagnostic]]
    taint_order: [Int]
    jobs: [SemaFinalizeCoreJob]
}

// The next unclaimed job, taken with one atomic add under a read guard each
// thread holds for its run.
SemaFinalizeCoreQueue: struct {
    next: Atomic<Int>
}

// One job's rows, walked by one thread, or the module's assembled usage when
// the job walked the whole module; a module's first job that does not walk
// it whole hands back the module's walk context.
SemaFinalizeCoreCollected: struct {
    job: Int
    collected: SemaCoreCollected
    assembled: SemaCoreModuleUsageResult?
    context: SemaCoreModuleContext?
}

// What one walking thread returns: its taint modules' reports and its Core
// jobs' rows.
SemaFinalizeWalked: struct {
    taint: [SemaTaintWalked]
    core: [SemaFinalizeCoreCollected]
}

sema_finalize_walk_fill: fn(shared_state: Shared<SemaFinalizeWalkShared>, graph: &&SemaRegistrationGraph, modules: &[SemaGraphModuleResult], catalog: &&SemaTaintCatalog, coverage: &&[Diagnostic]) {
    permit: shared_state.guard_edit()
    permit.value.graphs.push(graph)
    compiler_transfer_rows<SemaGraphModuleResult>(permit.value.modules, modules)
    permit.value.catalogs.push(catalog)
    permit.value.coverage.push(coverage)
}

// Moves the modules back and returns the graph.
sema_finalize_walk_take: fn(shared_state: Shared<SemaFinalizeWalkShared>, modules: &[SemaGraphModuleResult]) -> SemaRegistrationGraph {
    permit: shared_state.guard_edit()
    compiler_transfer_rows<SemaGraphModuleResult>(modules, permit.value.modules)
    permit.value.graphs.pop() ?? panic("the finalization graph left the threads' shared state")
}

// Runs walking threads `from..<workers`, one task each, and moves each taint
// module's reports, masked branches and fixed tags a thread returned into
// its module's slot of `walked`, `masked` and `fixed` and every Core job
// row into its slot of `results`, `assembled` and `contexts`.
sema_finalize_walkers: fn(shared_state: Shared<SemaFinalizeWalkShared>, queue: Shared<SemaFinalizeCoreQueue>, from: Int, workers: Int, walked: &[[Diagnostic]], masked: &[[Span]], fixed: &[[String]], results: &[SemaCoreCollected], assembled: &[SemaCoreModuleUsageResult?], contexts: &[SemaCoreModuleContext?]) {
    if from >= workers -> return
    task.group sema_finalize_walk_threads {
        head: task sema_finalize_walk_claimed(shared_state, queue)
        sema_finalize_walkers(shared_state, queue, from + 1, workers, walked, masked, fixed, results, assembled, contexts)
        claimed := head.join() ?? panic(compiler_threads_failure_text(err))
        loop claimed.taint.len() > 0 {
            done := claimed.taint.pop() ?? break
            walked[done.module_index] = done.found.move()
            masked[done.module_index] = done.masked.move()
            fixed[done.module_index] = done.fixed_tags.move()
        }
        loop claimed.core.len() > 0 {
            done := claimed.core.pop() ?? break
            results[done.job] = done.collected.move()
            assembled[done.job] = done.assembled.move()
            contexts[done.job] = done.context.move()
        }
    }
}

// One thread: walks the ranks it claims, in order: ranks below the taint
// module count are taint modules, the rest Core jobs. A taint module is
// walked with the thread's own flow state, over its own copy of the catalog
// and the coverage reports made at its first taint module. A Core job builds
// its module's walk context and walks its range into its own rows; a job
// that walks its module's every item assembles the module's usage too, and
// a module's first job otherwise hands its context back.
sema_finalize_walk_claimed: fn(shared_state: Shared<SemaFinalizeWalkShared>, queue: Shared<SemaFinalizeCoreQueue>) -> SemaFinalizeWalked {
    inputs: shared_state.guard_read()
    state := SemaTaintFlowState{catalog: sema_taint_catalog_init(), module_identity: "", bindings: [SemaTaintBindingFact]{}, imports: [SemaTaintImportAlias]{}, callable_scope: sema_taint_slots(), diagnostics: [Diagnostic]{}, coverage_reports: [Diagnostic]{}, fixed_tags: [String]{}}
    stated := false
    claimed := SemaFinalizeWalked{taint: [SemaTaintWalked]{}, core: [SemaFinalizeCoreCollected]{}}
    taint_count: inputs.value.taint_order.len()
    ranks: queue.guard_read()
    loop {
        rank: sema_finalize_core_claim(ranks.value)
        if rank < taint_count {
            if !stated {
                state.catalog = inputs.value.catalogs[0].copy()
                state.coverage_reports = inputs.value.coverage[0].copy()
                stated = true
            }
            module_index: inputs.value.taint_order[rank]
            found := [Diagnostic]{}
            // Passed straight through: a local binding of a guarded row would copy it.
            sema_taint_check_module(inputs.value.graphs[0], state, module_index, found)
            claimed.taint.push(SemaTaintWalked{module_index: module_index, found: found.move(), masked: state.masked.copy(), fixed_tags: state.fixed_tags.copy()})
            next
        }
        job: rank - taint_count
        if job >= inputs.value.jobs.len() -> break
        module_index: inputs.value.jobs[job].module_index
        context := sema_core_module_context(inputs.value.graphs[0], inputs.value.graphs[0].modules[module_index], inputs.value.modules[module_index].call_facts)
        collected := sema_core_collected_empty()
        sema_core_collect_item_range(inputs.value.graphs[0].modules[module_index].program.items, inputs.value.jobs[job].first, inputs.value.jobs[job].last, context, collected)
        if inputs.value.jobs[job].first == 0 && inputs.value.jobs[job].last == inputs.value.graphs[0].modules[module_index].program.items.len() {
            claimed.core.push(SemaFinalizeCoreCollected{job: job, collected: sema_core_collected_empty(), assembled: Val(sema_core_module_usage_assemble(inputs.value.graphs[0].modules[module_index], context, inputs.value.modules[module_index].exact_int_reachable, collected)), context: None})
            next
        }
        handed := SemaCoreModuleContext?{None}
        if inputs.value.jobs[job].first == 0 -> handed = Val(context.move())
        claimed.core.push(SemaFinalizeCoreCollected{job: job, collected: collected.move(), assembled: None, context: handed.move()})
    }
    claimed
}

sema_finalize_core_claim: fn(queue: SemaFinalizeCoreQueue) -> Int {
    queue.next.add(1)
}

// The finalization's read-only checks before the effect pass: each reads
// the final graph and the checked modules and writes neither, so they run
// side by side on compiler threads. Jobs are numbered in the serial order
// their results join in; threads claim them heaviest first (the taint
// catalog, the liveness walk, the effect parts, then the declaration
// checks). Effect part `k` reads the effect inputs and builds the
// effect-graph rows (sema_effect_prepare_module) of the k-th of
// SEMA_FINALIZE_SIDE_EFFECT_PARTS consecutive module ranges. The taint job
// builds the tag dataflow's catalog (sema_taint_prepare), which the taint
// walk after the effect pass reads.
SEMA_FINALIZE_SIDE_INLINE_ALWAYS: 0
SEMA_FINALIZE_SIDE_SCRIPT_ENTRIES: 1
SEMA_FINALIZE_SIDE_DECLARED_LEAVES: 2
SEMA_FINALIZE_SIDE_AUTHORITY_HANDLES: 3
SEMA_FINALIZE_SIDE_EFFECT_FIRST: 4
SEMA_FINALIZE_SIDE_EFFECT_PARTS: 4
SEMA_FINALIZE_SIDE_LIVENESS: 8
SEMA_FINALIZE_SIDE_TAINT: 9
SEMA_FINALIZE_SIDE_JOBS: 10
// A program of fewer modules per admitted thread checks them on the calling
// thread.
SEMA_FINALIZE_SIDE_MIN_MODULES_PER_THREAD: 16

// What every side-check thread reads: the registration graph (the one row of
// its list) and the checked modules, moved in and back out.
SemaFinalizeSideShared: struct {
    graphs: [SemaRegistrationGraph]
    modules: [SemaGraphModuleResult]
}

// One side check's result: a declaration check's diagnostics and whether it
// found any, an effect part's inputs and graph rows, the liveness verdicts,
// or the taint catalog (the one row of `taint`).
SemaFinalizeSide: struct {
    job: Int
    found: Bool
    diagnostics: [Diagnostic]
    effect_inputs: [SemaEffectModuleInput]
    effect_prepared: SemaEffectPrepared
    liveness: SemaLivenessResult
    taint: [SemaTaintPrepared]
}

sema_finalize_side_new: fn(job: Int) -> SemaFinalizeSide {
    SemaFinalizeSide{job: job, found: false, diagnostics: [Diagnostic]{}, effect_inputs: [SemaEffectModuleInput]{}, effect_prepared: sema_effect_prepared_empty(), liveness: sema_finalize_side_liveness_empty(), taint: [SemaTaintPrepared]{}}
}

sema_finalize_side_liveness_empty: fn() -> SemaLivenessResult {
    SemaLivenessResult{diagnostics: [Diagnostic]{}, facts: [StructureFact]{}}
}

// Runs every side check, on threads when the program is large enough, and
// joins them in order: the declaration checks' diagnostics onto
// `diagnostics` (any found leaves the graph incomplete), the effect inputs
// onto `effect_inputs` with their graph rows in `effect_prepared`, the
// liveness verdicts into `liveness`, and the taint catalog onto `taint`.
sema_finalize_side_checks: fn(graph: &&SemaRegistrationGraph, modules: &[SemaGraphModuleResult], threads: CompilerThreads, diagnostics: &[Diagnostic], complete: &Bool, effect_inputs: &[SemaEffectModuleInput], effect_prepared: &SemaEffectPrepared, liveness: &SemaLivenessResult, taint: &[SemaTaintPrepared]) -> SemaRegistrationGraph {
    owned := graph.move()
    sides := [SemaFinalizeSide]{}
    workers: compiler_threads_admit(threads, SEMA_FINALIZE_SIDE_JOBS, modules.len(), SEMA_FINALIZE_SIDE_MIN_MODULES_PER_THREAD, 0, 0)
    if workers <= 1 {
        loop job in 0..<SEMA_FINALIZE_SIDE_JOBS -> sides.push(sema_finalize_side_run(job, owned, modules))
        sema_finalize_side_join(sides, diagnostics, complete, effect_inputs, effect_prepared, liveness, taint)
        return owned
    }
    loop job in 0..<SEMA_FINALIZE_SIDE_JOBS -> sides.push(sema_finalize_side_new(job))
    shared_state: Shared{SemaFinalizeSideShared{graphs: [SemaRegistrationGraph]{}, modules: [SemaGraphModuleResult]{}}}
    sema_finalize_side_fill(shared_state, owned, modules)
    queue: Shared{SemaFinalizeCoreQueue{next: 0}}
    sema_finalize_side_claimers(shared_state, queue, 0, workers, sides)
    returned := sema_finalize_side_take(shared_state, modules)
    sema_finalize_side_join(sides, diagnostics, complete, effect_inputs, effect_prepared, liveness, taint)
    returned
}

// One side check over the graph and the checked modules.
sema_finalize_side_run: fn(job: Int, graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult]) -> SemaFinalizeSide {
    side := sema_finalize_side_new(job)
    if {
        job == SEMA_FINALIZE_SIDE_INLINE_ALWAYS -> { side.found = sema_marker_rules_check_inline_always(graph, modules, side.diagnostics) }
        job == SEMA_FINALIZE_SIDE_SCRIPT_ENTRIES -> { side.found = sema_check_script_entries(graph, side.diagnostics) }
        job == SEMA_FINALIZE_SIDE_DECLARED_LEAVES -> { side.found = sema_effect_check_declared_leaves(graph, side.diagnostics) }
        job == SEMA_FINALIZE_SIDE_AUTHORITY_HANDLES -> { side.found = sema_effect_check_authority_handles(graph, side.diagnostics) }
        job == SEMA_FINALIZE_SIDE_LIVENESS -> { side.liveness = sema_liveness_structure(graph, modules) }
        job == SEMA_FINALIZE_SIDE_TAINT -> { side.taint.push(sema_taint_prepare(graph)) }
        else -> {
            part: job - SEMA_FINALIZE_SIDE_EFFECT_FIRST
            first: part * modules.len() /% SEMA_FINALIZE_SIDE_EFFECT_PARTS
            last: (part + 1) * modules.len() /% SEMA_FINALIZE_SIDE_EFFECT_PARTS
            type_caps: sema_effect_type_caps(graph.modules)
            library: sema_library_effects(graph)
            loop module_index in first..<last {
                source_index: sema_registration_module_index(graph, modules[module_index].module_identity) ?? next
                input := sema_effect_module_input(graph, source_index, module_index, type_caps, library)
                // Input positions count from the part's first input; the join shifts them.
                sema_effect_prepare_module(side.effect_prepared, modules[module_index].functions, modules[module_index].call_facts, input, side.effect_inputs.len(), graph.decls)
                side.effect_inputs.push(input)
            }
        }
    }
    side
}

// Joins the side checks in job order.
sema_finalize_side_join: fn(sides: &&[SemaFinalizeSide], diagnostics: &[Diagnostic], complete: &Bool, effect_inputs: &[SemaEffectModuleInput], effect_prepared: &SemaEffectPrepared, liveness: &SemaLivenessResult, taint: &[SemaTaintPrepared]) {
    owned := sides.move()
    owned.reverse()
    loop owned.len() > 0 {
        side := owned.pop() ?? break
        if side.found -> complete = false
        diagnostics.extend(side.diagnostics.move())
        sema_effect_prepared_join(effect_prepared, side.effect_prepared.move(), effect_inputs.len())
        effect_inputs.extend(side.effect_inputs.move())
        if side.job == SEMA_FINALIZE_SIDE_LIVENESS {
            liveness = side.liveness.move()
        }
        taint.extend(side.taint.move())
    }
}

sema_finalize_side_fill: fn(shared_state: Shared<SemaFinalizeSideShared>, graph: &&SemaRegistrationGraph, modules: &[SemaGraphModuleResult]) {
    permit: shared_state.guard_edit()
    permit.value.graphs.push(graph)
    compiler_transfer_rows<SemaGraphModuleResult>(permit.value.modules, modules)
}

// Moves the modules back and returns the graph.
sema_finalize_side_take: fn(shared_state: Shared<SemaFinalizeSideShared>, modules: &[SemaGraphModuleResult]) -> SemaRegistrationGraph {
    permit: shared_state.guard_edit()
    compiler_transfer_rows<SemaGraphModuleResult>(modules, permit.value.modules)
    permit.value.graphs.pop() ?? panic("the finalization graph left the side checks' shared state")
}

// Runs side-check threads `from..<workers`, one task each, and moves every
// result a thread returned into its job's slot of `sides`.
sema_finalize_side_claimers: fn(shared_state: Shared<SemaFinalizeSideShared>, queue: Shared<SemaFinalizeCoreQueue>, from: Int, workers: Int, sides: &[SemaFinalizeSide]) {
    if from >= workers -> return
    task.group sema_finalize_side_threads {
        head: task sema_finalize_side_claimed(shared_state, queue)
        sema_finalize_side_claimers(shared_state, queue, from + 1, workers, sides)
        claimed := head.join() ?? panic(compiler_threads_failure_text(err))
        loop claimed.len() > 0 {
            done := claimed.pop() ?? break
            job: done.job
            sides[job] = done.move()
        }
    }
}

// One thread: runs the side checks it claims, heaviest (last job) first.
sema_finalize_side_claimed: fn(shared_state: Shared<SemaFinalizeSideShared>, queue: Shared<SemaFinalizeCoreQueue>) -> [SemaFinalizeSide] {
    inputs: shared_state.guard_read()
    claimed := [SemaFinalizeSide]{}
    ranks: queue.guard_read()
    loop {
        rank: sema_finalize_core_claim(ranks.value)
        if rank >= SEMA_FINALIZE_SIDE_JOBS -> break
        // Passed straight through: a local binding of a guarded row would copy it.
        claimed.push(sema_finalize_side_run(SEMA_FINALIZE_SIDE_JOBS - 1 - rank, inputs.value.graphs[0], inputs.value.modules))
    }
    claimed
}

// Rust CheckerCore `Stmt::Live`: a terminal block is impure (IO), so each
// one in a `-[]>` function is E3401, reported like an impure call. Nested
// `#Unsafe` gates are skipped as sema_unsafe_nested_bodies does.
sema_check_pure_live_blocks: fn(name: String, body: [Stmt], diagnostics: &[Diagnostic]) Never! {
    loop statement in body {
        if statement == .Live(_, span) -> diagnostics.push(sema_pure_root_diagnostic(name, "#Live {{ … }}", [String]{}, span))
        loop nested in sema_unsafe_nested_bodies(statement) -> sema_check_pure_live_blocks(name, nested, diagnostics)
    }
}
