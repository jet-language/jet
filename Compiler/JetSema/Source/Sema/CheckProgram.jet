// Module-level declaration registration followed by function body checking.
// The result explicitly reports when a source form lies beyond this checker
// slice so consumers cannot treat its TIR as a complete semantic program.
use jet_foundation.[
    AccessConvention,
    Diagnostic,
    Expr,
    Func,
    Item,
    MIRNameAlias,
    MIRNameDeclaration,
    MIRNameFacts,
    MIRNameModule,
    MIRNameReference,
    MIRNameVisibility,
    MIRRuntimeLayer,
    MIRStructureFact,
    MIRStructureFactKind,
    MIRTargetHardwareUse,
    Marker,
    MetaAttr,
    NamedSpan,
    Param,
    Program,
    Span,
    StateDecl,
    Symbol,
    SymbolID,
    SymbolKind,
    TComptimeValue,
    TContract,
    TDeclarationFacts,
    TEffectFacts,
    TEffectSpan,
    TExpr,
    TFailureCarrier,
    TFunc,
    TFuncKind,
    TGenericParam,
    TParameter,
    TStmt,
    TTargetApplicability,
    TTypeDef,
    TUnsafeGate,
    TVisibility,
    TWebParamReconstruction,
    Type,
    ViewProvenance,
    ViewProvenanceEntry,
    ViewProvenanceMap,
    ViewSource,
    ViewSourcePath,
    ViewSourceProjection,
    expr_span,
    symbol_id,
    tir_symbol_local,
    type_with_effective_fn_returns,
]

pub struct SemaResult {
    pub module_name: String
    pub functions: [TFunc]
    pub call_facts: [SemaCallSiteFact]
    pub hardware_use: MIRTargetHardwareUse
    pub name_references: [SemaNameReferenceFact]
    pub comptime_requests: [SemaComptimeRequest]
    pub comptime_body_sources: [SemaComptimeBodySource]
    pub compute_facts: [SemaComputeFunctionFacts]
    pub exact_int_reachable: Bool
    pub copy_events: [SemaCopyEvent]
    pub diagnostics: [Diagnostic]
    pub complete: Bool
}

pub struct SemaGraphModuleResult {
    pub module_identity: String
    pub module_name: String
    pub package_identity: String
    pub module_path: String
    pub source_file: String
    pub declarations: TDeclarationFacts
    pub functions: [TFunc]
    pub nominals: [SemaRegistrationNominal]
    pub constants: [SemaRegistrationConstant]
    pub impls: [SemaRegistrationImpl]
    pub exports: [SemaRegistrationExport]
    pub imports: [SemaRegistrationImport]
    pub foreign_functions: [SemaCheckedForeignFunction]
    pub foreign_providers: [SemaCheckedForeignProvider]
    pub call_facts: [SemaCallSiteFact]
    pub hardware_use: MIRTargetHardwareUse
    pub name_references: [SemaNameReferenceFact]
    pub comptime_requests: [SemaComptimeRequest]
    pub comptime_body_sources: [SemaComptimeBodySource]
    pub compute_facts: [SemaComputeFunctionFacts]
    pub exact_int_reachable: Bool
    pub copy_events: [SemaCopyEvent]
    pub diagnostics: [Diagnostic]
    pub complete: Bool
}

pub enum SemaComptimeItemKind {
    Constant
    MarkerArgument
    FieldDefault
    TypeLevel
    CheckedText
    BodyExpression
}

pub struct SemaComptimeItemSource {
    pub module_identity: String
    pub key: String
    pub destination_key: String
    pub name: String
    pub source_file: String
    pub kind: SemaComptimeItemKind
    pub expression: Expr
    pub expected_type: Type?
    pub span: Span
    pub dependencies: [String]
    pub checked_text: SemaCheckedTextEvaluation?
}

pub struct SemaComptimeItemRequest {
    pub module_identity: String
    pub key: String
    pub destination_key: String
    pub source_file: String
    pub kind: SemaComptimeItemKind
    pub expression: TExpr
    pub expected_type: Type?
    pub span: Span
    pub dependencies: [String]
    pub calls: [SemaComptimeRequest]
    pub hardware_use: MIRTargetHardwareUse
    pub reachable_function_keys: [String]
}

pub struct SemaComptimeItemValue {
    pub module_identity: String
    pub key: String
    pub destination_key: String
    pub kind: SemaComptimeItemKind
    pub value: TComptimeValue
    pub ty: Type
}

pub fn sema_comptime_body_values_from_items(values: [SemaComptimeItemValue]) -> [SemaComptimeBodyValue] Never! {
    result := [SemaComptimeBodyValue]{}
    loop value in values {
        if value.kind != SemaComptimeItemKind.BodyExpression -> next
        &result.push(SemaComptimeBodyValue{
            module_identity: value.module_identity,
            key: value.key,
            destination_key: value.destination_key,
            value: value.value,
            ty: value.ty,
        })
    }
    result
}

pub struct SemaRegistrationPackagePolicy {
    pub package_identity: String
    pub authority_allow: [String]?
    pub authority_deny: [String]?
    pub authority_needs: [String]
    pub runtime_ceiling: MIRRuntimeLayer?
    pub edition: String
}

pub struct SemaComptimeDeclarationStage {
