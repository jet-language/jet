// Module-level declaration registration followed by function body checking.
// The result explicitly reports when a source form lies beyond this checker
// slice so consumers cannot treat its checked tree as a complete semantic program.
use jet_foundation.[
    BodyExpr,
    FnBody,
    MarkerHook,
    MARKER_SCALAR,
    body_tree_new,
    AST_NODE_GENERATED,
    AccessConvention,
    ResolvedOutput,
    CompilerThreads,
    CompilerTraceSink,
    ContractClause,
    DIAGNOSTIC_ERROR,
    Diagnostic,
    DiagnosticLabel,
    InternerDelta,
    delta_has_rows,
    interner_merge_delta,
    ast_binding,
    ast_func,
    ConstDef,
    SemaNameCase,
    sema_casing_has_case,
    core_module_export,
    module_index,
    module_is_core,
    module_is_none,
    module_none,
    module_text,
    classify_identifier,
    IdentifierClass,
    Expr,
    Func,
    Item,
    NameAlias,
    NameDeclaration,
    NameFacts,
    NameModule,
    NameReference,
    NameVisibility,
    RuntimeLayer,
    StructureFact,
    TargetHardwareUse,
    Marker,
    NameTable,
    name_count,
    name_find,
    name_index,
    name_intern,
    name_table,
    name_table_sized,
    Param,
    Program,
    Span,
    Stmt,
    Symbol,
    SymbolID,
    SymbolLocalKeys,
    SymbolKind,
    TComptimeValue,
    TDeclarationFacts,
    TEffectFacts,
    TEffectSpan,
    TFailureCarrier,
    TFuncKind,
    TGenericParam,
    TTestFact,
    TTypeDef,
    TUnsafeGate,
    TWebParamReconstruction,
    Type,
    ViewProvenance,
    ViewProvenanceEntry,
    ViewProvenanceMap,
    ViewSource,
    ViewSourcePath,
    ViewSourceProjection,
    compiler_take_rows,
    compiler_threads_admit,
    compiler_threads_joined,
    compiler_transfer_rows,
    effect_scope_descriptor,
    expr_span,
    symbol_find,
    symbol_intern,
    symbol_is_local,
    symbol_is_none,
    symbol_key_text,
    symbol_local_keys_intern,
    symbol_local_keys_text_at,
    symbol_mint,
    symbol_none,
    symbol_table,
    symbol_table_key,
    body_tree_remap_types,
    interner_empty,
    checked_symbol_local,
    checked_test_artifact_fact,
    type_name,
    type_structural_head_names,
    type_with_effective_parameter_fn_return,
    CodeModule,
    TraitImplBlock,
    FactDecl,
    foundation_byte_text,
    ImportDecl,
    import_walk_bindings,
]

// Exact registered APIs without a browser host provider. The compiler witness
// pins this list and rejects unknown Core members.
sema_web_host_unsupported_core_apis: fn() -> [String] Never! {
    [String]{
        "core.auth.magic_link_consume",
        "core.auth.magic_link_issue",
        "core.auth.oauth_begin",
        "core.auth.oauth_finish",
        "core.auth.password_login",
        "core.auth.register_user",
        "core.auth.session_validate",
        "core.sys.decode",
        "core.sys.expand",
        "core.sys.get",
        "core.sys.getenv",
        "core.sys.home_dir",
        "core.sys.set",
        "core.sys.temp_dir",
        "core.sys.unset",
        "core.sys.vars",
    }
}

sema_web_host_check_core_usage: fn(target_name: String, used_core: [String], diagnostics: ^[Diagnostic]) -> Bool Never! {
    if target_name != "wasm.browser" -> return true
    unsupported: sema_web_host_unsupported_core_apis()
    complete := true
    loop usage in used_core {
        if !unsupported.contains(usage) -> next
        operation: usage.replace(".", ".")
        diagnostics.push(
            sema_error_optional(
                "E-WEB-UNSUPPORTED",
                None,
                "Web output cannot compile `{operation}` yet.",
                "this Core operation needs a host provider that the browser target does not supply",
                "move this operation behind a native or server boundary",
            ),
        )
        complete = false
    }
    complete
}

// Reuses TargetSurface from 371361c3e against current registration facts.
sema_target_is_socket_surface: fn(path: String) -> Bool Never! {
    if path == {
        "core.net" | "core.net.tls" | "core.net.ws" | "core.http" | "core.http.client" | "core.http.server" -> true
        else -> false
    }
}

sema_target_socket_surface: fn(path: String) -> String? Never! {
    if sema_target_is_socket_surface(path) -> return Val(path)
    if core_module_export(path) != None -> return None
    separator: path.rfind(".")
    if separator < 0 -> return None
    owner: foundation_byte_text(path.bytes(), 0, separator)
    if sema_target_is_socket_surface(owner) -> Val(owner) else -> None
}

sema_target_wasip2_unsupported_operations: fn(used_core: [String]) -> [String] Never! {
    operations := [String]{}
    loop usage in used_core {
        separator: usage.rfind(".")
        if separator < 0 -> next
        module_name: foundation_byte_text(usage.bytes(), 0, separator)
        member: foundation_byte_text(usage.bytes(), separator + 1, usage.count_bytes())
        unsupported: if module_name == {
            "core.net" -> if member == {
                "tcp_connect_happy" | "tcp_ready" | "udp_ready" | "tls_connect" | "tls_read" | "tls_write" | "tls_close" | "dns_a" | "dns_aaaa" | "dns_txt" | "dns_ptr" | "dns_srv" -> true
                else -> member.starts_with("unix_")
            }
            "core.http" -> member == "get" || member == "post" || member == "request"
            "core.http.server" -> member == "tls"
            "core.net.tls" | "core.http.client" -> true
            else -> false
        }
        if unsupported -> sema_core_string_add(operations, "{module_name}.{member}")
    }
    operations
}

sema_target_check_socket_surfaces: fn(graph: SemaRegistrationGraph, used_core: [String], diagnostics: ^[Diagnostic]) -> Bool Never! {
    target: if graph.target_machine.name == "wasm.browser" -> "web" else -> graph.target_machine.triple
    wasip2: target == "wasm32-wasip2"
    socket_target: wasip2 || target.contains("linux") || target.contains("android") || target.contains("apple") || target.contains("darwin") || target.contains("windows") || target.contains("freebsd") || target.contains("openbsd") || target.contains("netbsd")
    if socket_target && !wasip2 -> return true
    operations: if wasip2 -> sema_target_wasip2_unsupported_operations(used_core) else -> [String]{}
    seen := name_table_sized(8)
    complete := true
    loop module_row_index in 0..<graph.modules.len() {
        // The surface is the one the program's own `use` names. Core's
        // imports are its implementation: which of that code a target reaches
        // is settled where Core gates it on the target (`#build.target.os`,
        // `#Target`) and by the denial row of the target's `core.target` facts.
        if module_is_core(graph.modules[module_row_index].module_identity) -> next
        diagnostic_start: diagnostics.len()
        loop imported_index in 0..<graph.modules[module_row_index].imports.len() {
            target_identity: graph.modules[module_row_index].imports[imported_index].target_module_identity
            path := module_text(graph.module_table, target_identity)
            if sema_registration_module_index(graph, target_identity) == .Val(index) {
                path = graph.modules[index].module_name
            }
            surface: sema_target_socket_surface(path) ?? next
            // The diagnostic names the module, so it points at the path the
            // `use` names, or at the members a member import takes from it.
            span: if graph.modules[module_row_index].imports[imported_index].declaration.kind == {
                .Unqualified(_, _, _, items_span, _) -> items_span
                .File(_, path_span) -> path_span
                .Module(_, path_span) -> path_span
            }
            key: "{graph.modules[module_row_index].module_identity.id}:{span.start}:{span.end}:E3304"
            if !socket_target && name_find(seen, key) == None {
                _ := name_intern(seen, key)
                diagnostics.push(sema_error("E3304", span, "`{surface}` is not available for target `{target}`.", "`{surface}` needs native sockets or WASI Preview 2 sockets, and this target provides neither runtime boundary. A `jet build` or `jet run` run reports this target-support diagnostic.", "Build for `wasm32-wasip2` or a supported native target, or remove the `{surface}` import."))
                complete = false
            }
            if !wasip2 -> next
            unsupported_surface: surface == "core.net.tls" || surface == "core.net.ws" || surface == "core.http.client"
            if unsupported_surface {
                operation_key: "{graph.modules[module_row_index].module_identity.id}:{span.start}:{span.end}:E3305:{surface}"
                if name_find(seen, operation_key) == None {
                    _ := name_intern(seen, operation_key)
                    diagnostics.push(sema_error("E3305", span, "`{surface}` is not available for target `{target}`.", "The selected target has no Prelude adapter for `{surface}`; WASI Preview 2 provides TCP/UDP sockets but not this operation. A `jet build` or `jet run` run reports this target-support diagnostic.", "Use a supported TCP/UDP operation, or build for a native target."))
                    complete = false
                }
            }
            loop operation in operations {
                separator: operation.rfind(".")
                if separator < 0 || foundation_byte_text(operation.bytes(), 0, separator) != surface {
                    next
                }
                operation_key: "{graph.modules[module_row_index].module_identity.id}:{span.start}:{span.end}:E3305:{operation}"
                if name_find(seen, operation_key) != None -> next
                _ := name_intern(seen, operation_key)
                diagnostics.push(sema_error("E3305", span, "`{operation}` is not available for target `{target}`.", "The selected target has no Prelude adapter for `{operation}`; WASI Preview 2 provides TCP/UDP sockets but not this operation. A `jet build` or `jet run` run reports this target-support diagnostic.", "Use a supported TCP/UDP operation, or build for a native target."))
                complete = false
            }
        }
        sema_attach_diagnostic_source_locations(diagnostics, diagnostic_start, graph.modules[module_row_index].source_segments)
    }
    complete
}

SemaResult: struct {
    module_name: String,
    functions: [FnBody],
    call_facts: [SemaCallSiteFact],
    hardware_use: TargetHardwareUse,
    name_references: [SemaNameReferenceFact],
    comptime_requests: [SemaComptimeRequest],
    comptime_body_sources: [SemaComptimeBodySource],
    compute_facts: [SemaComputeFunctionFacts],
    exact_int_reachable: Bool,
    copy_events: [SemaCopyEvent],
    diagnostics: [Diagnostic],
    complete: Bool,
    interner: Interner,
}

SemaGraphModuleResult: struct {
    module_identity: ModuleID,
    module_name: String,
    package_identity: String,
    module_path: String,
    source_file: String,
    declarations: TDeclarationFacts,
    // This module's checked functions as flat bodies: each function check
    // seals and flattens its own tree (sema_function_check_pass), so sema's
    // whole-program passes and every later package read only these.
    functions: [FnBody],
    nominals: [SemaRegistrationNominal],
    constants: [SemaRegistrationConstant],
    impls: [SemaRegistrationImpl],
    exports: [SemaRegistrationExport],
    imports: [SemaRegistrationImport],
    foreign_functions: [SemaCheckedForeignFunction],
    foreign_providers: [SemaCheckedForeignProvider],
    call_facts: [SemaCallSiteFact],
    hardware_use: TargetHardwareUse,
    name_references: [SemaNameReferenceFact],
    comptime_requests: [SemaComptimeRequest],
    comptime_body_sources: [SemaComptimeBodySource],
    compute_facts: [SemaComputeFunctionFacts],
    exact_int_reachable: Bool,
    copy_events: [SemaCopyEvent],
    // The answers of the debugger's probes inside this module's functions,
    // which the effect pass judges and the finalization takes
    // (sema_eval_probe_answers).
    eval_answers: [SemaEvalProbeAnswer]{[SemaEvalProbeAnswer]{}},
    diagnostics: [Diagnostic],
    complete: Bool,
    // #3708: the failure rows of this module's checked top-level functions.
    failure_facts: [SemaFunctionFailureFacts]{[SemaFunctionFailureFacts]{}},
    // Why `complete` is false, one line per cause, so a no-diagnostic
    // incomplete module still names what stopped it.
    incomplete_reasons: [String]{[String]{}},
    // Keys of the Prelude error conversions sema injected into this module
    // after its bodies. They have no registration row, so the driver's identity
    // check admits exactly these keys beside the registered declarations.
    injected_function_keys: [String]{[String]{}},
    // Test mode: one fact per named `#Test` of this module whose body checked,
    // in declaration order; the checked synthetic function is in `functions`
    // and its key in `injected_function_keys`.
    tests: [TTestFact]{[TTestFact]{}},
    // Outside test mode (`jet check`, a build's root tests): the fields this
    // module's checked `#Test` bodies read and the cases they build. The
    // bodies are dropped, so liveness reads a test's member uses from here
    // (sema_liveness_member_uses).
    test_member_uses: SemaLivenessMemberUses{SemaLivenessMemberUses.empty()},
    // Under a per-function trace: each Core body a demand wave checked into
    // this module, as its position in `functions`, and the task CPU time
    // (ns) its check took at the same position of `core_check_ns`
    // (sema_core_bound_charge), which sema_core_bound_counters reads.
    core_check_rows: [Int]{[Int]{}},
    core_check_ns: [Int]{[Int]{}},
    // The Core library's check: this Core module's function checks as
    // packets, in the order they were checked (CoreBodies.jet
    // sema_core_body_capture); a demand wave appends its own after the
    // body pass's.
    core_bodies: [SemaCoreBody]{[SemaCoreBody]{}},
    // Worker-local types minted while checking this module's bodies, merged
    // deterministically into graph.interner when the pass closes.
    type_delta: [InternerDelta]{[InternerDelta]{}},
}

// The facts of a checked module that only sema's whole-program passes read:
// its call, name and copy facts, compute and failure facts, comptime sites
// and registration impl, export and import rows
// (sema_graph_modules_take_checked_facts).
SemaCheckedFacts: struct {
    name_references: [SemaNameReferenceFact],
    call_facts: [SemaCallSiteFact],
    comptime_requests: [SemaComptimeRequest],
    comptime_body_sources: [SemaComptimeBodySource],
    compute_facts: [SemaComputeFunctionFacts],
    copy_events: [SemaCopyEvent],
    failure_facts: [SemaFunctionFailureFacts],
    impls: [SemaRegistrationImpl],
    exports: [SemaRegistrationExport],
    imports: [SemaRegistrationImport],
}

// Moves the SemaCheckedFacts out of every module of `modules`, one row per
// module. Past sema a module is read only for its identity, declarations,
// constants, tests, injected keys and foreign rows, so a driver takes the
// rest before it copies the modules on to the IR build, and drops them off
// its own thread. The nominals stay, with the positions that index them. The
// modules pop off whole and go back in order, so no fact moves one at a time
// and none drops here.
sema_graph_modules_take_checked_facts: fn(modules: ^[SemaGraphModuleResult]) -> [SemaCheckedFacts] Never! {
    taken := [SemaCheckedFacts]{}
    kept := [SemaGraphModuleResult]{}
    loop {
        graph_module := modules.pop() ?? break
        taken.push(
            SemaCheckedFacts{
                name_references: graph_module.name_references.move(),
                call_facts: graph_module.call_facts.move(),
                comptime_requests: graph_module.comptime_requests.move(),
                comptime_body_sources: graph_module.comptime_body_sources.move(),
                compute_facts: graph_module.compute_facts.move(),
                copy_events: graph_module.copy_events.move(),
                failure_facts: graph_module.failure_facts.move(),
                impls: graph_module.impls.move(),
                exports: graph_module.exports.move(),
                imports: graph_module.imports.move(),
            },
        )
        graph_module.name_references = [SemaNameReferenceFact]{}
        graph_module.call_facts = [SemaCallSiteFact]{}
        graph_module.comptime_requests = [SemaComptimeRequest]{}
        graph_module.comptime_body_sources = [SemaComptimeBodySource]{}
        graph_module.compute_facts = [SemaComputeFunctionFacts]{}
        graph_module.copy_events = [SemaCopyEvent]{}
        graph_module.failure_facts = [SemaFunctionFailureFacts]{}
        graph_module.impls = [SemaRegistrationImpl]{}
        graph_module.exports = [SemaRegistrationExport]{}
        graph_module.imports = [SemaRegistrationImport]{}
        kept.push(graph_module)
    }
    loop {
        graph_module: kept.pop() ?? break
        modules.push(graph_module)
    }
    taken.reverse()
    taken
}

// #3708: what one checked function body propagates: the keys of the declared
// functions whose failures pass up ("" for a source of its own) and whether a
// statement or returned value is a direct failure source.
SemaFunctionFailureFacts: struct {
    function_key: String,
    direct: Bool,
    edges: [String],
    // This body's default-route row.
    union_members: [Type]{[Type]{}},
    union_cases: [SemaFailureCase]{[SemaFailureCase]{}},
    union_edges: [String]{[String]{}},
    union_general: Bool{false},
}

SemaComptimeItemKind: enum {
    Constant,
    MarkerArgument,
    FieldDefault,
    TypeLevel,
    CheckedText,
    BodyExpression,
}

SemaComptimeItemSource: struct {
    module_identity: ModuleID,
    key: String,
    destination_key: String,
    name: String,
    source_file: String,
    kind: SemaComptimeItemKind,
    expression: Expr,
    expected_type: Type?,
    span: Span,
    dependencies: [String],
    checked_text: SemaCheckedTextEvaluation?,
    // A FieldDefault of a struct that bakes its defaults (Codable, Decode,
    // Encode, CLI): a default that cannot be evaluated reports E2414.
    baked_default: Bool{false},
    // A module-level `NAME: expr` or `name := expr` whose value is not literal data:
    // computed while building when its evaluation is pure and succeeds, and
    // refused otherwise (E0643, jet_driver_module_value_refused).
    module_value: Bool{false},
    // An immutable module binding of a declared point's shape
    // (sema_casing_point_shaped): its name's span, which the run holds to
    // ALL_CAPS when the value is not a point (sema_comptime_module_point).
    point_name: Span?{None},
    // A refused module value's check as ordinary code, outside compile-time
    // execution, which reports its real errors.
    runtime_check: Bool{false},
    // An immutable local `name: value` that calls code: computed while
    // compiling when that succeeds, and otherwise left to run time without a
    // report; its landed value is then `.Failed` with the reason as text
    // (sema_comptime_local_value_failure).
    local_value: Bool{false},
    // An explicit `name: #run value` local in a body: its failures are
    // reported as any `#run` site's, but a pass whose sites are all local
    // values or such locals lands in their owner bodies the same way
    // (Comptime/LocalSplice.jet).
    local_binding: Bool{false},
    // A local value computed ahead of its body's check, under a key of its
    // own (Comptime/LocalValues.jet): a computation whose own check fails,
    // or that waits for good, leaves no value.
    ahead: Bool{false},
    // A body site's prepared locals, declared before its expression is checked.
    prepared: [SemaComptimePreparedLocal]{[SemaComptimePreparedLocal]{}},
    // A body site lexically inside an `#Impure` block: its Tier-2 effects
    // need their package to hold `Meta.Host` (E3411), not the block (E3410).
    impure: Bool{false},
    // A constant's `#StepLimit(n)` (sema_comptime_step_limit): its
    // evaluation may take n steps instead of the evaluator's default.
    step_limit: Int?{None},
    // A body site's run-time locals and parameters, which its staged check
    // names as run-time values (E0640) when the code reads one.
    runtime_locals: [String]{[String]{}},
    // A body site's place, which its landed value keeps for the body checks
    // that read it (SemaComptimeBodyValue.place).
    place: SemaComptimeBodyPlace?{None},
}

SemaComptimeItemRequest: struct {
    module_identity: ModuleID,
    key: String,
    destination_key: String,
    source_file: String,
    kind: SemaComptimeItemKind,
    // The item expression's flat form (sema_publish_expression).
    expression: BodyExpr,
    expected_type: Type?,
    span: Span,
    dependencies: [String],
    calls: [SemaComptimeRequest],
    hardware_use: TargetHardwareUse,
    reachable_function_keys: [String],
    // The item expression's own call sites (a module value's purity reads them).
    call_facts: [SemaCallSiteFact]{[SemaCallSiteFact]{}},
    // The item expression's first call with a host effect, as a refused
    // comptime effect names it (sema_effect_comptime_call_name).
    effect_call: String?{None},
}

SemaComptimeItemValue: struct {
    module_identity: ModuleID,
    key: String,
    destination_key: String,
    kind: SemaComptimeItemKind,
    value: TComptimeValue,
    ty: Type,
    // A module `Shared{X}` holder (sema_comptime_shared_payload): `value` is
    // the payload the build folded, `ty` the holder's Shared type.
    shared_holder: Bool{false},
    // A body site's place (SemaComptimeItemSource.place).
    place: SemaComptimeBodyPlace?{None},
}

sema_comptime_body_value_from_item: fn(value: SemaComptimeItemValue) -> SemaComptimeBodyValue Never! {
    SemaComptimeBodyValue{
        module_identity: value.module_identity,
        key: value.key,
        destination_key: value.destination_key,
        value: value.value,
        ty: value.ty,
        place: value.place,
    }
}

sema_comptime_body_values_from_items: fn(values: [SemaComptimeItemValue]) -> [SemaComptimeBodyValue] Never! {
    result := [SemaComptimeBodyValue]{}
    loop value in values {
        if value.kind != SemaComptimeItemKind.BodyExpression -> next
        result.push(sema_comptime_body_value_from_item(value))
    }
    result
}

SemaRegistrationPackagePolicy: struct {
    package_identity: String,
    authority_allow: [String]?,
    authority_deny: [String]?,
    authority_needs: [String],
    runtime_ceiling: RuntimeLayer?,
    edition: String,
    // The organization policy's `authority: { deny: [...] }`, carried on the
    // root package's row, and the policy file it names.
    organization_deny: [String]{[String]{}},
    organization_source: String{""},
    // The entries that may hold expert effects (Authority.jet
    // authority_expert_answer): the main package's `allow` row, or for a
    // dependency the main package's `authority.grants` line for it.
    expert_held: [String]{[String]{}},
    // The name the main package's `authority.grants` keys this dependency
    // by; "" for the main package.
    grant_name: String{""},
}

SemaComptimeDeclarationStage: struct {
    modules: [SemaGraphModuleResult],
    imports: [SemaRegistrationImport],
    package_policies: [SemaRegistrationPackagePolicy],
    names: NameFacts,
    sources: [SemaComptimeItemSource],
    diagnostics: [Diagnostic],
    complete: Bool,
    // The registration graph the declaration pass moved into its program
    // tables, unchanged, handed to the comptime run (jet_driver_run_comptime
    // `staged`) so no one copies it; None once taken.
    graph: SemaRegistrationGraph?{None},
    // The declaration pass's boxed edges and copy facts of `graph`, handed
    // with it to the comptime run's environment (sema_comptime_environment)
    // so it does not compute them again; None once taken.
    graph_facts: SemaComptimeGraphFacts?{None},
}

// The facts the program tables derive from a registration graph alone
// (sema_scope_environment_boxed_edges, sema_copy_facts_table).
SemaComptimeGraphFacts: struct {
    boxed_edges: [U32:[String]],
    copy_facts: SemaCopyFactsTable,
}

SemaComptimeItemCheck: struct {
    request: SemaComptimeItemRequest?,
    dependencies: [String],
    waiting_dependencies: [String],
    diagnostics: [Diagnostic],
    complete: Bool,
    // A precheck's literal fold of its call-free request with no landed
    // values (sema_comptime_precheck_fold); None when it did not fold.
    folded: TComptimeValue?{None},
    type_delta: [InternerDelta]{[InternerDelta]{}},
}

SemaComptimeFunctionResult: struct {
    module_identity: ModuleID,
    function_key: String,
    // The checked body (sema_function_check_pass flattens it).
    function: FnBody?,
    waiting_dependencies: [String],
    calls: [SemaComptimeRequest],
    reachable_function_keys: [String],
    call_facts: [SemaCallSiteFact],
    hardware_use: TargetHardwareUse,
    name_references: [SemaNameReferenceFact],
    comptime_body_sources: [SemaComptimeBodySource],
    compute_facts: SemaComputeFunctionFacts,
    diagnostics: [Diagnostic],
    exact_int_reachable: Bool,
    copy_events: [SemaCopyEvent],
    complete: Bool,
    // Why an incomplete result has no diagnostic, for the driver's report.
    incomplete_reasons: [String]{[String]{}},
    // #3708: the body's failure row, which the bundle solve and a comptime
    // closure's solve read (sema_comptime_failure_closure_settle).
    failure: SemaFunctionFailureFacts?{None},
    // Incomplete only because of failure obligations against unannotated
    // callees: a solve over the callees' rows discharges or emits them.
    obligations_pending: Bool{false},
    // An inline foreign (`#FFI`) function's checked foreign row: it has no
    // Jet body to check, and a compile-time call of it stops the run.
    foreign: SemaCheckedForeignFunction?{None},
    // The codecs and derived methods the check demanded (SemaDemandCapture),
    // which a body pass that takes this result records again.
    codec_demand: [SemaCodecWant]{[SemaCodecWant]{}},
    derive_demand: [String]{[String]{}},
    // The Prelude error conversion routines the body's propagation sites
    // demand, checked under its module (sema_check_comptime_function); a
    // closure that builds the body builds them too.
    conversions: [FnBody]{[FnBody]{}},
    // The round of the Core demand (sema_core_demand_waves) whose first wave
    // demands what this function names: 0, but for the closures of a body
    // comptime pass the driver lands between two rounds
    // (jet_driver_land_local_values), which get the next one.
    demand_round: Int{0},
    // The answers of the debugger's probes inside the body (EvalProbe.jet).
    eval_answers: [SemaEvalProbeAnswer]{[SemaEvalProbeAnswer]{}},
    type_delta: [InternerDelta]{[InternerDelta]{}},
}

// A checked item expression as a flat body of its own; its Flat nodes are
// rows of `context.arena`.
sema_publish_expression: fn(value: TExpr, program: SemaProgramTables, context: ^SemaCheckContext) -> BodyExpr Never! {
    flat := BodyFlat{tree: body_tree_new(), arena: context.arena.tree, into_arena: false}
    root: body_flat_expr(value, flat)
    // The arena's syntax column lends itself to the resolve only when an
    // arena row waits on it.
    lends: flat.out_arena_rows.len() > 0
    syntax := if lends -> compiler_take_rows<Type>(context.arena.arena_syntax) else -> [Type]{}
    body_flat_resolve_types(flat, syntax, program, context)
    if lends -> context.arena.arena_syntax = syntax.move()
    tree := flat.tree.move()
    sema_precise_bind(tree, program)
    // The expression's own symbol keys leave with it (body_flat_function).
    tree.symbols = context.arena.tree.symbols.copy()
    body_tree_finish(tree)
    BodyExpr{root: root, tree: tree.move()}
}

SemaGraphResult: struct {
    package_identity: String,
    entry_module_identity: ModuleID,
    modules: [SemaGraphModuleResult],
    imports: [SemaRegistrationImport],
    package_policies: [SemaRegistrationPackagePolicy],
    core_usage: SemaCoreUsageResult,
    call_facts: [SemaCallSiteFact],
    hardware_use: TargetHardwareUse,
    comptime_requests: [SemaComptimeRequest],
    comptime_body_sources: [SemaComptimeBodySource],
    compute_facts: [SemaComputeFunctionFacts],
    names: NameFacts,
    diagnostics: [Diagnostic],
    complete: Bool,
    // #3708: the unannotated top-level functions the bundle failure solve
    // proved infallible, by symbol key.
    inferred_infallible: [String]{[String]{}},
    // SemaRegistrationGraph.core_seal: the Core seal's lines
    // (sema_core_seal_lines); empty otherwise.
    core_seal: [String]{[String]{}},
    // SemaRegistrationGraph.core_seal: the Core function checks as captured,
    // in capture order, which the Core library writes as the bodies file
    // (CoreBodies.jet sema_core_bodies_bytes); empty otherwise.
    core_bodies: SemaCoreCaptures{SemaCoreCaptures{bodies: [SemaCoreBody]{}, context: ""}},
    // A run bound to the Core image (SemaRegistrationGraph.core_stand_ins):
    // how many Core functions its demand checked as stand-ins, and, when
    // something they assume did not hold, why the finalization must run
    // again without stand-ins (sema_finalize_program), else "".
    core_stand_ins: Int{0},
    core_stand_in_rerun: String{""},
    // `SemaRegistrationGraph.retain_programs`: each module's program as sema
    // settled it, indexed like `modules`; empty otherwise.
    programs: [Program]{[Program]{}},
    outputs: [ResolvedOutput]{[ResolvedOutput]{}},
    memory_declarations: [SemaMemoryFactDeclaration]{[SemaMemoryFactDeclaration]{}},
    memory_projections: [SemaMemoryProjectionRow]{[SemaMemoryProjectionRow]{}},
    // The answers of the debugger's probes (EvalProbe.jet), ordered by
    // probe, expression and function; empty without probes.
    eval_answers: [SemaEvalProbeAnswer]{[SemaEvalProbeAnswer]{}},
}

// What sema_finalize_graph hands back: its result, and the registration graph
// the finalization checked against (values and failure projections applied),
// moved back to the caller so it can undo the edits (sema_graph_trail_undo).
SemaFinalized: struct {
    result: SemaGraphResult,
    graph: SemaRegistrationGraph,
}

sema_name_facts_empty: fn() -> NameFacts Never! {
    NameFacts{modules: [NameModule]{}, declarations: [NameDeclaration]{}, aliases: [NameAlias]{}, references: [NameReference]{}, structure_facts: [StructureFact]{}}
}

sema_check_body_job_index: fn(job: SemaBodyJob) -> Int Never! {
    if job == {
        .TopLevel(index) -> index
        .NominalMethod(ordinal, _, _) | .ImplMethod(ordinal, _, _) -> ordinal
    }
}

SemaFunctionResult: struct {
    value: FnBody?,
    complete: Bool,
    exact_int_reachable: Bool,
    copy_events: [SemaCopyEvent],
    hardware_use: TargetHardwareUse,
    comptime_body_sources: [SemaComptimeBodySource],
    compute_facts: SemaComputeFunctionFacts,
    failure: SemaFunctionFailureFacts?,
    // Why an incomplete result has no diagnostic (SemaCheckContext rows).
    incomplete_reasons: [String]{[String]{}},
    // The value's prelude conversion demands (sema_prelude_conversion_demands),
    // when the compiler thread that checked the body walked it there.
    prelude_demands: [SemaPreludeConversionDemand]?{None},
    // The symbols of a check that built no `value`: the local ids its name
    // references carry are rows of these (sema_keep_going_trap_references).
    failed_locals: SymbolLocalKeys?{None},
    // The answers of the debugger's probes inside the body (EvalProbe.jet).
    eval_answers: [SemaEvalProbeAnswer]{[SemaEvalProbeAnswer]{}},
}

sema_function_compute_facts: fn(function_key: String, context: SemaCheckContext) -> SemaComputeFunctionFacts Never! {
    SemaComputeFunctionFacts{
        function_key: function_key,
        compute_calls: context.compute_calls.copy(),
        autodiff_obligations: context.autodiff_obligations.copy(),
        autodiff_safe_panic: context.autodiff_safe_panic,
        autodiff_unsafe_panic: context.autodiff_unsafe_panic,
        generic_crossings: context.generic_crossings.copy(),
        generic_calls: context.generic_calls.copy(),
    }
}

// A function's result: `value` when its check completed, None when it did
// not, with the facts its check gathered taken out of the spent context.
sema_function_result: fn(value: ^^FnBody?, function_key: String, context: ^^SemaCheckContext) -> SemaFunctionResult Never! {
    complete: value != None
    SemaFunctionResult{
        value: value.move(),
        complete: complete,
        exact_int_reachable: context.exact_int_reachable,
        copy_events: context.copy_events.move(),
        hardware_use: sema_hardware_use_snapshot(context.hardware_use),
        comptime_body_sources: context.comptime_body_sources.move(),
        compute_facts: SemaComputeFunctionFacts{
            function_key: function_key,
            compute_calls: context.compute_calls.move(),
            autodiff_obligations: context.autodiff_obligations.move(),
            autodiff_safe_panic: context.autodiff_safe_panic,
            autodiff_unsafe_panic: context.autodiff_unsafe_panic,
            // The crossings the body's type parameters reach and its generic
            // calls (sema_generic_crossings_validate); without them no generic
            // call is checked for what it sends.
            generic_crossings: context.generic_crossings.move(),
            generic_calls: context.generic_calls.move(),
        },
        failure: Val(SemaFunctionFailureFacts{
            function_key: function_key,
            direct: context.failure_direct_source,
            edges: context.failure_edges.move(),
            union_members: context.failure_union_members.move(),
            union_cases: context.failure_union_cases.move(),
            union_edges: sema_failure_union_edges_once(context.failure_union_edges.move()),
            union_general: context.failure_union_general || context.failure_direct_source,
        }),
        incomplete_reasons: if complete -> [String]{} else -> context.incomplete_reasons.move(),
        failed_locals: if complete -> None else -> Val(context.arena.tree.symbols.move()),
        eval_answers: context.eval_walk.answers.move(),
    }
}

sema_function_check_unavailable: fn(function_key: String, reason: String) -> SemaFunctionResult Never! {
    SemaFunctionResult{
        value: None,
        complete: false,
        exact_int_reachable: false,
        copy_events: [SemaCopyEvent]{},
        hardware_use: sema_hardware_empty_use(),
        comptime_body_sources: [SemaComptimeBodySource]{},
        compute_facts: sema_compute_facts_empty(function_key),
        failure: None,
        incomplete_reasons: [String]{reason},
    }
}

sema_function_view_source_equal: fn(left: ViewSource, right: ViewSource) -> Bool Never! {
    if left == {
        .Receiver -> if right == {
            .Receiver -> true
            .Parameter(_) | .Static(_, _) -> false
        }
        .Parameter(index) -> if right == {
            .Parameter(other) -> index == other
            .Receiver | .Static(_, _) -> false
        }
        .Static(module_path, name) -> if right == {
            .Static(other_module, other_name) -> module_path == other_module && name == other_name
            .Receiver | .Parameter(_) -> false
        }
    }
}

sema_function_view_projection_equal: fn(left: ViewSourceProjection, right: ViewSourceProjection) -> Bool Never! {
    if left == {
        .Field(name) -> if right == {
            .Field(other) -> name == other
            .Index | .Range -> false
        }
        .Index -> if right == {
            .Index -> true
            .Field(_) | .Range -> false
        }
        .Range -> if right == {
            .Range -> true
            .Field(_) | .Index -> false
        }
    }
}

sema_function_view_slot_equal: fn(left: [String], right: [String]) -> Bool Never! {
    if left.len() != right.len() -> return false
    index := 0
    loop index < left.len() {
        if left[index] != right[index] -> return false
        index += 1
    }
    true
}

sema_function_view_source_within: fn(declared: ViewSourcePath, inferred: ViewSourcePath) -> Bool Never! {
    if !sema_function_view_source_equal(declared.source, inferred.source) || declared.projections.len() > inferred.projections.len() {
        return false
    }
    index := 0
    loop index < declared.projections.len() {
        if !sema_function_view_projection_equal(declared.projections[index], inferred.projections[index]) {
            return false
        }
        index += 1
    }
    true
}

sema_function_view_contract_for_slot: fn(map: ViewProvenanceMap, slot: [String]) -> ViewProvenance? {
    loop entry in map.entries {
        if sema_function_view_slot_equal(entry.slot, slot) -> return Val(entry.value)
    }
    if slot.len() > 0 {
        loop entry in map.entries {
            if entry.slot.len() == 0 -> return Val(entry.value)
        }
    }
    None
}

sema_function_return_view_provenance: fn(func: Func, inferred: ViewProvenanceMap?, diagnostics: ^[Diagnostic], complete: ^Bool) -> ViewProvenanceMap? {
    declared_option := func.declared_return_view_provenance
    // copy: the provenance is a new owned Option. Without a declared map it equals `inferred`, the
    // caller's inferred map (a read parameter), which the caller keeps.
    if declared_option == None -> return inferred.copy()
    declared: declared_option ?? ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
    if inferred != None {
        inferred_map: inferred
        span: func.return_type_span ?? func.name_span
        loop inferred_entry in inferred_map.entries {
            declared_entry := sema_function_view_contract_for_slot(declared, inferred_entry.slot)
            if declared_entry == None {
                diagnostics.push(sema_error("E2305", span, "returned view escapes its declared `from` clause", "every return path's owners must stay inside the sources named after `from`", "widen the `from` clause, or stop returning a view from that owner"))
                complete = false
                next
            }
            allowed: declared_entry ?? ViewProvenance{sources: [ViewSourcePath]{}, mutable: false}
            loop inferred_source in inferred_entry.value.sources {
                source_allowed := false
                loop declared_source in allowed.sources {
                    if sema_function_view_source_within(declared_source, inferred_source) {
                        source_allowed = true
                    }
                }
                if !source_allowed {
                    diagnostics.push(sema_error("E2305", span, "returned view escapes its declared `from` clause", "every return path's owners must stay inside the sources named after `from`", "widen the `from` clause, or stop returning a view from that owner"))
                    complete = false
                }
            }
        }
        published := [ViewProvenanceEntry]{}
        loop inferred_entry in inferred_map.entries {
            allowed := sema_function_view_contract_for_slot(declared, inferred_entry.slot)
            sources := inferred_entry.value.sources
            if allowed != None {
                allowed_value: allowed ?? ViewProvenance{sources: [ViewSourcePath]{}, mutable: false}
                sources = allowed_value.sources
            }
            published.push(ViewProvenanceEntry{slot: inferred_entry.slot, value: ViewProvenance{sources: sources, mutable: inferred_entry.value.mutable}})
        }
        loop declared_entry in declared.entries {
            if declared_entry.slot.len() == 0 -> next
            duplicate := false
            loop published_entry in published {
                if sema_function_view_slot_equal(published_entry.slot, declared_entry.slot) {
                    duplicate = true
                }
            }
            if !duplicate -> published.push(declared_entry)
        }
        if published.len() == 0 {
            any_write := false
            loop inferred_entry in inferred_map.entries {
                if inferred_entry.value.mutable -> any_write = true
            }
            merged := [ViewProvenanceEntry]{}
            loop declared_entry in declared.entries {
                if {
                    declared_entry.slot.len() == 0 -> {
                        merged.push(ViewProvenanceEntry{slot: declared_entry.slot, value: ViewProvenance{sources: declared_entry.value.sources, mutable: any_write}})
                    }
                    else -> { merged.push(declared_entry) }
                }
            }
            return Val(ViewProvenanceMap{entries: merged})
        }
        return Val(ViewProvenanceMap{entries: published})
    }
    Val(declared)
}

sema_function_view_source_path_equal: fn(left: ViewSourcePath, right: ViewSourcePath) -> Bool Never! {
    if left.projections.len() != right.projections.len() -> return false
    sema_function_view_source_within(left, right)
}

sema_function_view_maps_equal: fn(left: ViewProvenanceMap?, right: ViewProvenanceMap?) -> Bool Never! {
    if left == None -> return right == None
    if right == None -> return false
    left_map: left
    right_map: right
    if left_map.entries.len() != right_map.entries.len() -> return false
    loop left_entry in left_map.entries {
        right_entry := ViewProvenanceEntry?{None}
        loop candidate in right_map.entries {
            if sema_function_view_slot_equal(left_entry.slot, candidate.slot) {
                right_entry = Val(candidate)
            }
        }
        if right_entry == None -> return false
        candidate: right_entry ?? ViewProvenanceEntry{slot: [String]{}, value: ViewProvenance{sources: [ViewSourcePath]{}, mutable: false}}
        if left_entry.value.mutable != candidate.value.mutable || left_entry.value.sources.len() != candidate.value.sources.len() {
            return false
        }
        loop left_source in left_entry.value.sources {
            found := false
            loop right_source in candidate.value.sources {
                if sema_function_view_source_path_equal(left_source, right_source) -> found = true
            }
            if !found -> return false
        }
    }
    true
}

// The first frame-0 binding row per symbol, built by the first publish of a
// body loop so each later publish does not scan every module binding. Rows
// are only appended after the module rows, or edited in place without
// changing their symbol, so a recorded row that still holds its symbol is
// still the first one; any other symbol falls back to the scan the rows
// replace.
sema_function_return_view_rows: fn(scopes: SemaScopeTable, rows: ^[U32:Int]) Never! {
    loop index in 0..<scopes.bindings.len() {
        if scopes.bindings[index].frame == 0 && rows.get(scopes.bindings[index].symbol.id.id) == None {
            rows[scopes.bindings[index].symbol.id.id] = index
        }
    }
}

// The first frame-0 binding of `id`.
sema_function_return_view_row: fn(scopes: SemaScopeTable, rows: ^[U32:Int], id: SymbolID) -> Int? Never! {
    if rows.len() == 0 -> sema_function_return_view_rows(scopes, rows)
    if rows.get(id.id) == .Val(recorded) {
        if recorded < scopes.bindings.len() && scopes.bindings[recorded].frame == 0 && scopes.bindings[recorded].symbol.id == id {
            return Val(recorded)
        }
    }
    loop index in 0..<scopes.bindings.len() {
        if scopes.bindings[index].frame == 0 && scopes.bindings[index].symbol.id == id {
            return Val(index)
        }
    }
    None
}

// `rows`: the body loop's sema_function_return_view_rows, empty until the
// first publish fills it. `id` is `function`'s symbol.
sema_function_publish_return_views: fn(scopes: ^SemaScopeTable, rows: ^[U32:Int], function: FnBody, id: SymbolID) -> Bool Never! {
    provenance: function.return_view_provenance ?? return false
    index: sema_function_return_view_row(scopes, rows, id) ?? return false
    binding: scopes.bindings[index]
    if binding.symbol.ty == .Val(type_value) {
        if type_value == .Fn(params, ret, effect_bound, param_contract, metadata, existing) {
            next_map := Val(provenance)
            if sema_function_view_maps_equal(existing, next_map) -> return false
            scopes.bindings[index].symbol.ty = Val(Type.Fn{params: params, ret: ret, effect_bound: effect_bound, param_contract: param_contract, call_metadata: metadata, return_view_provenance: next_map})
            return true
        }
    }
    false
}

// A declared return type carries view provenance across its signature when it
// structurally holds a `View`, `ViewMut` or `Pin` directly or through struct
// fields. `seen` holds every struct already entered, by its symbol id, so
// recursive structs terminate.
sema_check_type_contains_view: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, ty: Type, seen: ^[U32:Bool]) -> Bool {
    if ty == {
        .Apply(name, args) -> {
            if (name == "View" || name == "ViewMut" || name == "Pin") && args.len() == 1 {
                return true
            }
            loop arg in args {
                if sema_check_type_contains_view(graph, module_identity, arg, seen) -> return true
            }
            return sema_check_struct_contains_view(graph, module_identity, name, seen)
        }
        .Named(name) -> return sema_check_struct_contains_view(graph, module_identity, name, seen)
        .Option(inner) -> return sema_check_type_contains_view(graph, module_identity, inner, seen)
        .List(element) -> return sema_check_type_contains_view(graph, module_identity, element, seen)
        .Shared(inner) -> return sema_check_type_contains_view(graph, module_identity, inner, seen)
        .Tagged(_, inner) -> return sema_check_type_contains_view(graph, module_identity, inner, seen)
        .Result(ok, err) -> {
            if sema_check_type_contains_view(graph, module_identity, ok, seen) -> return true
            return sema_check_type_contains_view(graph, module_identity, err, seen)
        }
        .Map(key, _, value) -> {
            if sema_check_type_contains_view(graph, module_identity, key, seen) -> return true
            return sema_check_type_contains_view(graph, module_identity, value, seen)
        }
        .Tuple(fields) -> {
            loop field in fields {
                if sema_check_type_contains_view(graph, module_identity, field.ty, seen) {
                    return true
                }
            }
        }
        .FixedList(elem, _) -> return sema_check_type_contains_view(graph, module_identity, elem, seen)
        .Fn(params, ret, _, _, _, _) -> {
            loop param in params {
                if sema_check_type_contains_view(graph, module_identity, param, seen) -> return true
            }
            if ret == .Val(value) {
                return sema_check_type_contains_view(graph, module_identity, value, seen)
            }
        }
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    false
}

// Field types resolve in the struct's own module, and each struct is entered
// once.
sema_check_struct_contains_view: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, name: String, seen: ^[U32:Bool]) -> Bool {
    nominal_row: sema_type_resolve_nominal_row(graph, Type.Named{name: name}, module_identity) ?? return false
    nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
    if nominal.kind != SemaRegistrationNominalKind.Struct -> return false
    if seen.get(nominal.symbol.id.id) != None -> return false
    seen[nominal.symbol.id.id] = true
    loop field in nominal.fields {
        if sema_check_type_contains_view(graph, nominal.symbol.module_identity, field.ty, seen) {
            return true
        }
    }
    false
}

// Summary jobs run in name order. A stable bottom-up merge sort of job
// positions, so same-named functions keep declaration order and each job moves
// once. Existing name-ordered summary jobs retain only their original source
// cursors. Equal names retain declaration order, exactly as the canonical
// stable merge.
sema_check_view_summary_jobs: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int) -> [Int] {
    jobs := [Int]{}
    if program.registration_graph == .Val(graph) {
        loop item_index in 0..<graph.modules[module_index].program.items.len() {
            if graph.modules[module_index].program.items[item_index] == .Func(func) {
                if func.inline_foreign != None || sema_function_is_guest_import(func) -> next
                return_type: func.return_type ?? next
                seen := [U32:Bool]{}
                if sema_check_type_contains_view(graph, graph.modules[module_index].module_identity, return_type, seen) {
                    jobs.push(item_index)
                }
            }
        }
        return jobs.move()
    }
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_view_summary_name_before: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, left: Int, right: Int) -> Bool {
    if program.registration_graph == .Val(graph) {
        if graph.modules[module_index].program.items[left] == .Func(left_func) {
            if graph.modules[module_index].program.items[right] == .Func(right_func) {
                return left_func.name <= right_func.name
            }
        }
    }
    panic("a selected view summary lost its original function item")
}

sema_check_sort_view_summary_jobs: fn(jobs: ^[Int], environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int) Never! {
    count: jobs.len()
    if count < 2 {
        return
    }
    order := [Int]{}
    loop index in 0..<count -> order.push(index)
    merged := order
    width := 1
    loop width < count {
        start := 0
        loop start < count {
            middle: if start + width < count -> start + width else -> count
            end: if start + 2 * width < count -> start + 2 * width else -> count
            left := start
            right := middle
            out := start
            loop out < end {
                if left < middle && (right >= end || sema_check_view_summary_name_before(environment, program, module_index, jobs[order[left]], jobs[order[right]])) {
                    merged[out] = order[left]
                    left += 1
                } else {
                    merged[out] = order[right]
                    right += 1
                }
                out += 1
            }
            start = end
        }
        // Swap the buffers: the next pass rewrites every slot of `merged`.
        spent: order.move()
        order = merged.move()
        merged = spent
        width *= 2
    }
    sorted: loop position in order -> jobs[position]
    loop index in 0..<count -> jobs[index] = sorted[index]
}

// Module `module_index`'s view summary jobs (sema_check_view_summary_jobs) in
// their run order (sema_check_sort_view_summary_jobs). Both read only the
// graph.
sema_check_sorted_view_summary_jobs: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int) -> [Int] {
    jobs := sema_check_view_summary_jobs(environment, program, module_index)
    sema_check_sort_view_summary_jobs(jobs, environment, program, module_index)
    jobs
}

sema_check_view_rounds_equal: fn(left: [ViewProvenanceMap?], right: [ViewProvenanceMap?]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop index in 0..<left.len() {
        if !sema_function_view_maps_equal(left[index], right[index]) -> return false
    }
    true
}

// The module symbol of `item`, with no id: a snapshot mints its own
// (sema_register_item), and a synthetic function no registration holds
// keeps none.
sema_item_symbol: fn(item: Item, module_identity: ModuleID, module_name: String, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment]) -> Symbol? {
    if item == {
        .Func(func) -> {
            id: symbol_none()
            ty: sema_function_symbol_type(func, false, symbol_key_text(SymbolKind.Function, module_name, "", func.name), fallback_source_file, fallback_source_origin, source_segments)
            visibility := 0
            if func.is_package_pub -> visibility = 1
            if func.is_pub -> visibility = 2
            Val(Symbol{id: id, kind: SymbolKind.Function, name: func.name, module_identity: module_identity, owner: None, span: func.name_span, ty: Val(ty), visibility: visibility})
        }
        .Struct(value) -> Val(sema_named_type_symbol(module_identity, module_name, value.name, value.name_span, value.is_pub, value.is_package_pub))
        .Enum(value) -> Val(sema_named_type_symbol(module_identity, module_name, value.name, value.name_span, value.is_pub, value.is_package_pub))
        .Distinct(value) -> Val(sema_named_type_symbol(module_identity, module_name, value.name, value.name_span, value.is_pub, value.is_package_pub))
        .TypeAlias(value) -> Val(sema_named_type_symbol(module_identity, module_name, value.name, value.name_span, value.is_pub, value.is_package_pub))
        .Trait(value) -> {
            id: symbol_none()
            visibility := 0
            if value.is_package_pub -> visibility = 1
            if value.is_pub -> visibility = 2
            Val(Symbol{id: id, kind: SymbolKind.Trait, name: value.name, module_identity: module_identity, owner: None, span: value.name_span, ty: None, visibility: visibility})
        }
        .Tag(value) -> Val(sema_named_type_symbol(module_identity, module_name, value.name, value.name_span, value.is_pub, value.is_package_pub))
        .Const(value) -> {
            id: symbol_none()
            Val(Symbol{id: id, kind: SymbolKind.Constant, name: value.name, module_identity: module_identity, owner: None, span: value.name_span, ty: value.ty, visibility: 0})
        }
        .UnitFamily(value) -> Val(sema_named_type_symbol(module_identity, module_name, value.family, value.family_span, value.is_pub, value.is_package_pub))
        .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> None
    }
}

// A snapshot has no module table: its symbols carry the none module id, and
// their ids are rows of the snapshot's own `symbols`, as are its struct,
// enum and impl methods' (sema_call_method_candidate_from_func finds them).
sema_register_item: fn(scopes: ^SemaScopeTable, declarations: ^[SemaScopeDeclaration], symbols: ^SymbolTable, item: Item, module_name: String, source_file: String, source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment], diagnostics: ^[Diagnostic]) -> Bool {
    if item == {
        .Struct(value) -> {
            loop method in value.methods {
                _ := symbol_mint(symbols, SymbolKind.Function, module_name, value.name, method.name)
            }
        }
        .Enum(value) -> {
            loop method in value.methods {
                _ := symbol_mint(symbols, SymbolKind.Function, module_name, value.name, method.name)
            }
        }
        .Impl(value) -> {
            loop method in value.methods {
                _ := symbol_mint(symbols, SymbolKind.Function, module_name, value.type_name, method.name)
            }
        }
        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    symbol := sema_item_symbol(item, module_none(), module_name, source_file, source_origin, source_segments) ?? return false
    key: symbol_key_text(symbol.kind, module_name, "", symbol.name)
    symbol.id = symbol_intern(symbols, key)
    if sema_scope_add_module_symbol(scopes, symbol, key) {
        declarations.push(SemaScopeDeclaration{symbol_id: symbol.id, item: item})
        return true
    }
    diagnostics.push(sema_defined_twice(symbol.name, "module declarations share one name space", symbol.span))
    false
}

sema_append_function: fn(functions: ^[FnBody], value: ^^FnBody?) -> Bool Never! {
    function: value.move() ?? return false
    functions.push(function)
    true
}

sema_named_type_symbol: fn(module_identity: ModuleID, module_name: String, name: String, span: Span, is_pub: Bool, is_package_pub: Bool) -> Symbol Never! {
    visibility := 0
    if is_package_pub -> visibility = 1
    if is_pub -> visibility = 2
    id: symbol_none()
    Symbol{id: id, kind: SymbolKind.Type, name: name, module_identity: module_identity, owner: None, span: span, ty: Val(Type.Named{name: name}), visibility: visibility}
}

sema_failure_carrier: fn(return_type: Type?) -> TFailureCarrier Never! {
    if return_type == None {
        return TFailureCarrier.Result{success: Type.Named{name: "Unit"}, error: Type.Named{name: "Err"}}
    }
    ty: return_type
    if ty == {
        .Named(name) -> {
            if name == "Never" -> return TFailureCarrier.Diverges{value: ty}
        }
        .Option(value) -> return TFailureCarrier.Optional{value: value}
        .Result(ok, err) -> {
            if err == {
                .Named(name) -> {
                    if name == "Never" -> return TFailureCarrier.Infallible
                }
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
            }
            return TFailureCarrier.Result{success: ok, error: err}
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    TFailureCarrier.Result{success: ty, error: Type.Named{name: "Err"}}
}

// A return that hands back a value: not `Unit` (bare or as a unit-fallible
// success) and not a `Stream` generator.
sema_function_returns_value: fn(effective_return: Type) -> Bool Never! {
    success: if effective_return == {
        // copy: `ok` is a payload of read parameter `effective_return`, which keeps the original; the assigned `success` owns this one
        .Result(ok, _) -> ok.copy()
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> effective_return
    }
    if success == (Type.Named{name: "Unit"}) -> return false
    if effective_return == .Apply(name, _) && name == "Stream" -> return false
    if success == .Apply(name, _) && name == "Stream" -> return false
    true
}

sema_function_generic_params: fn(func: Func, graph_option: SemaRegistrationGraph?, module_identity: ModuleID, diagnostics: ^[Diagnostic], complete: ^Bool) -> [TGenericParam] {
    params := [TGenericParam]{}
    index := 0
    loop index < func.type_params.len() {
        parameter: func.type_params[index]
        bounds := [SymbolID]{}
        bound_index := 0
        loop bound_index < parameter.bounds.len() {
            bound := parameter.bounds[bound_index]
            bound_index += 1
            // The graph is read in place through the `.Val(…)` pattern on the
            // parameter; binding it to a local copies the whole graph.
            if graph_option == .Val(graph) {
                // A generic bound registers as its written name, and an
                // unregistered one is never rejected at the declaration
                // (Tests/UI embedded_generic_method_scope: `T: Clone`); such a
                // bound has no trait identity to carry, so a settled module
                // drops it (sema_registration_identity_settled).
                resolved: sema_type_graph_bound_symbol(graph, module_identity, bound) ?? {
                    if !sema_registration_identity_settled(graph, module_identity) {
                        complete = false
                    }
                    next
                }
                if sema_resolved_kind(graph, resolved) != SymbolKind.Trait {
                    diagnostics.push(sema_error("E0301", parameter.name_span, "the generic bound `{bound}` is not a trait", "generic bounds refer to trait contracts", "use a trait name as the generic bound"))
                    complete = false
                    next
                }
                bounds.push(sema_resolved_id(graph, resolved))
            } else { complete = false }
        }
        params.push(TGenericParam{name: parameter.name, bounds: bounds, number: parameter.prep != None})
        index += 1
    }
    return params
}

sema_function_merge_generic_params: fn(enclosing: [TGenericParam], current: [TGenericParam]) -> [TGenericParam] Never! {
    merged := [TGenericParam]{}
    loop outer in enclosing {
        shadowed := false
        loop inner in current {
            if outer.name == inner.name -> shadowed = true
        }
        if !shadowed -> merged.push(outer.copy())
    }
    loop inner in current -> merged.push(inner.copy())
    merged
}

sema_function_normalize_owner_type: fn(graph: SemaRegistrationGraph, owner_type: Type, caller_module_identity: ModuleID) -> Type Never! {
    if owner_type == {
        .Named(name) -> {
            nominal_row: sema_type_resolve_nominal_row(graph, owner_type, caller_module_identity) ?? return owner_type
            nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
            // An impl of an imported type (`impl math.Decimal.Shown`) names it
            // through the caller's import; its methods' owner is the type's
            // own identity, the one its values carry, as the impl row's
            // self type is (sema_checked_impl_row).
            owner_name: if name.contains(".") && sema_type_resolve_declared(graph, owner_type, caller_module_identity) == .Named(resolved) -> resolved else -> name
            // copy: the normalized owner type is a new owned Type. For a non-generic nominal it
            // equals `owner_type`, the caller's owner type (a read parameter), which the caller
            // keeps.
            if nominal.generic_params.len() == 0 -> return Type.Named{name: owner_name}
            args: loop parameter in nominal.generic_params -> Type.Named{name: parameter.name}
            return Type.Apply{name: owner_name, args: args}
        }
        // copy: the normalized owner type is a new owned Type. For other kinds it equals
        // `owner_type`, the caller's owner type (a read parameter), which the caller keeps.
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return owner_type.copy()
    }
}

sema_function_owner_generic_params: fn(graph: SemaRegistrationGraph, owner_type: Type, caller_module_identity: ModuleID, diagnostics: ^[Diagnostic], complete: ^Bool) -> [TGenericParam] {
    normalized_owner_type := sema_function_normalize_owner_type(graph, owner_type, caller_module_identity)
    nominal_row: sema_type_resolve_nominal_row(graph, normalized_owner_type, caller_module_identity) ?? {
        if normalized_owner_type == .Apply(_, _) -> complete = false
        // A structural impl's methods (`impl [T#N].Trait`) see its head's
        // parameters; a fixed array's length is a number parameter.
        names: type_structural_head_names(normalized_owner_type) ?? return [TGenericParam]{}
        fixed := false
        if normalized_owner_type == .FixedList(_, _) -> fixed = true
        return loop (index, name) in names -> TGenericParam{name: name, bounds: [SymbolID]{}, number: fixed && index == 1}
    }
    nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
    owner_args := if normalized_owner_type == {
        .Apply(_, args) -> args
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> [Type]{}
    }
    if nominal.generic_params.len() != owner_args.len() {
        if nominal.generic_params.len() > 0 || owner_args.len() > 0 -> complete = false
        return [TGenericParam]{}
    }
    owner_module_index: sema_registration_module_index(graph, nominal.symbol.module_identity) ?? {
        if nominal.generic_params.len() > 0 -> complete = false
        return [TGenericParam]{}
    }
    owner_module: graph.modules[owner_module_index]
    params := [TGenericParam]{}
    index := 0
    loop index < nominal.generic_params.len() {
        parameter := nominal.generic_params[index]
        if owner_args[index] != (Type.Named{name: parameter.name}) {
            index += 1
            next
        }
        bounds := [SymbolID]{}
        loop bound in parameter.bounds {
            resolved := sema_type_graph_bound_symbol(graph, owner_module.module_identity, bound)
            // An unregistered bound name is never rejected at the declaration.
            if resolved == None {
                if !sema_registration_identity_settled(graph, owner_module.module_identity) {
                    complete = false
                }
                next
            }
            symbol: resolved ?? {
                complete = false
                next
            }
            if sema_resolved_kind(graph, symbol) != SymbolKind.Trait {
                diagnostics.push(sema_error("E0301", parameter.span, "the generic bound `{bound}` is not a trait", "generic bounds refer to trait contracts", "use a trait name as the generic bound"))
                complete = false
                next
            }
            bounds.push(sema_resolved_id(graph, symbol))
        }
        params.push(TGenericParam{name: parameter.name, bounds: bounds, number: parameter.number})
        index += 1
    }
    return params
}

sema_function_explicit_receiver: fn(function_kind: TFuncKind, parameter_index: Int, parameter: Param) -> Bool Never! {
    if parameter_index != 0 || parameter.name != "self" -> return false
    if function_kind == {
        .Method(_, _) | .TraitMethod(_, _, _, _, _) -> true
        .TopLevel -> false
    }
}

sema_function_kind_owner_type: fn(function_kind: TFuncKind) -> Type? {
    if function_kind == {
        .Method(_, owner_type) | .TraitMethod(_, _, owner_type, _, _) -> Val(owner_type)
        .TopLevel -> None
    }
}

// An unmarked use of a value moves it only when it is the
// last use. A check records each unmarked move site that a later use reached;
// the function is then checked again with those sites known, where each one
// checks as the copy `name.copy()` and leaves its source usable. A site whose type
// does not copy stays a move, so its later use keeps E0121.
// The caller's environment and module scope table are borrowed, not copied:
// the function's generic parameters and name are set on the environment for
// its check and the body is checked in place on `module_scopes`, then both are
// restored. Copying them per function cost a copy of the registration graph
// and of every module declaration.
sema_function_check: fn(func: Func, owner_key: String, function_kind: TFuncKind, raw_protocol_return: Bool, environment: ^SemaScopeEnvironment, program: SemaProgramTables, module_scopes: ^SemaScopeTable, host_hooks: SemaHostHookAccess?, diagnostics: ^[Diagnostic], call_facts: ^[SemaCallSiteFact], comptime_requests: ^[SemaComptimeRequest], name_references: ^[SemaNameReferenceFact]) -> SemaFunctionResult {
    if sema_function_check_unregistered(func, owner_key, function_kind, module_scopes, program) == .Val(unavailable) {
        return unavailable
    }
    base_generic_params: environment.generic_params.copy()
    generics := sema_function_check_generics(func, environment, program)
    environment.generic_params = generics.merged.copy()
    environment.function_name = func.name
    checked := sema_function_check_passes(func, owner_key, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
    environment.generic_params = base_generic_params.move()
    checked
}

// The same body checker on a compiler thread, reading one frozen environment.
// A function with generic parameters reads them from the environment, so a
// compiler thread checks one through sema_function_check_registered_on_thread.
// The scope owns the panic location for the entire check; no shared write is
// needed to the environment's callable name.
sema_function_check_shared: fn(func: Func, owner_key: String, function_kind: TFuncKind, raw_protocol_return: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, module_scopes: ^SemaScopeTable, host_hooks: SemaHostHookAccess?, diagnostics: ^[Diagnostic], call_facts: ^[SemaCallSiteFact], comptime_requests: ^[SemaComptimeRequest], name_references: ^[SemaNameReferenceFact]) -> SemaFunctionResult {
    if sema_function_check_unregistered(func, owner_key, function_kind, module_scopes, program) == .Val(unavailable) {
        return unavailable
    }
    generics := sema_function_check_generics(func, environment, program)
    // copy: `previous_location` restores module_scopes.location_function after this function's
    // check overwrites it. Jet has no exchange on a field of the write-borrowed table.
    previous_location: module_scopes.location_function.copy()
    module_scopes.location_function = Val(func.name)
    checked := sema_function_check_passes(func, owner_key, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
    module_scopes.location_function = previous_location
    checked
}

// A top-level function the module scope does not register as itself is
// checked as unavailable, before anything else (its check reports nothing).
// A synthetic function no registration holds (a test, a Prelude error
// conversion) is bound in the module scope with no id, by its name span.
sema_function_check_unregistered: fn(func: Func, owner_key: String, function_kind: TFuncKind, scopes: SemaScopeTable, program: SemaProgramTables) -> SemaFunctionResult? {
    if function_kind != TFuncKind.TopLevel -> return None
    registered: sema_scope_resolve(scopes, func.name) ?? return Val(sema_function_check_unavailable(owner_key, "the module scope has no registered function `{func.name}`"))
    registered_key: if symbol_is_none(registered.id) || symbol_is_local(registered.id) -> owner_key else -> sema_program_symbol_key(program, registered.id)
    if registered_key != owner_key || registered.span.start != func.name_span.start {
        return Val(sema_function_check_unavailable(owner_key, "the registered function `{func.name}` is `{registered_key}` at offset {registered.span.start}, not `{owner_key}` at offset {func.name_span.start}"))
    }
    None
}

// The function's own generic parameters (with the reports resolving them
// raised) and those merged with the environment's.
SemaFunctionCheckGenerics: struct {
    own: [TGenericParam],
    merged: [TGenericParam],
    diagnostics: [Diagnostic],
    complete: Bool,
}

sema_function_check_generics: fn(func: Func, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaFunctionCheckGenerics {
    diagnostics := [Diagnostic]{}
    complete := true
    own := sema_function_generic_params(func, program.registration_graph, environment.module_identity, diagnostics, complete)
    merged := sema_function_merge_generic_params(environment.generic_params, own)
    SemaFunctionCheckGenerics{own: own, merged: merged, diagnostics: diagnostics, complete: complete}
}

// The checks of one function (sema_function_check): again while share sites
// are found or a use decides a `:=` number name's type
// (Expressions/NumberNames.jet), then its last pass's reports and facts are kept.
sema_function_check_passes: fn(func: Func, owner_key: String, function_kind: TFuncKind, raw_protocol_return: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, module_scopes: ^SemaScopeTable, generics: SemaFunctionCheckGenerics, host_hooks: SemaHostHookAccess?, diagnostics: ^[Diagnostic], call_facts: ^[SemaCallSiteFact], comptime_requests: ^[SemaComptimeRequest], name_references: ^[SemaNameReferenceFact]) -> SemaFunctionResult {
    sema_comptime_body_work_count(environment.comptime_body_values, SemaComptimeBodyWorkOperation.FunctionsStarted)
    share_known := [Span]{}
    number_known := [SemaNumberRetype]{}
    // Each pass's probe answers replace those an earlier pass gave again.
    eval_answers := [SemaEvalProbeAnswer]{}
    loop {
        sema_comptime_body_work_count(environment.comptime_body_values, SemaComptimeBodyWorkOperation.CheckPassStarted)
        // copy: every pass starts from the generic checks' reports; a rechecked
        // pass discards its own list.
        pass_diagnostics := generics.diagnostics.copy()
        pass_call_facts := [SemaCallSiteFact]{}
        pass_comptime_requests := [SemaComptimeRequest]{}
        pass_name_references := [SemaNameReferenceFact]{}
        share_found := [SemaOwnershipShareSite]{}
        number_found := [SemaNumberRetype]{}
        mark: sema_scope_mark(module_scopes)
        checked := sema_function_check_pass(func, owner_key, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, share_known, share_found, number_known, number_found, pass_diagnostics, pass_call_facts, pass_comptime_requests, pass_name_references)
        sema_scope_rollback(module_scopes, mark)
        loop answer in checked.eval_answers.move() -> sema_eval_answer_put(eval_answers, answer)
        shares: sema_function_accept_share_sites(share_known, share_found, environment, program)
        retypes: sema_expr_number_accept_retypes(number_known, number_found)
        if !shares && !retypes {
            instance: if program.registration_graph == .Val(graph) -> sema_name_instance_span(graph, environment.module_identity, func.name) else -> None
            if instance == .Val(owner) {
                loop diagnostic in pass_diagnostics {
                    placed: sema_name_at_instance(diagnostic, owner) ?? next
                    diagnostics.push(placed)
                }
            } else { diagnostics.extend(pass_diagnostics.move()) }
            call_facts.extend(pass_call_facts.move())
            comptime_requests.extend(pass_comptime_requests.move())
            keep_locals: if program.registration_graph == .Val(graph) -> graph.keep_local_name_references || graph.retain_programs || graph.core_seal else -> true
            if keep_locals {
                name_references.extend(pass_name_references.move())
            } else {
                loop reference in pass_name_references.move() {
                    if reference.symbol.kind != SymbolKind.Local && reference.symbol.kind != SymbolKind.Parameter {
                        name_references.push(reference)
                    }
                }
            }
            checked.eval_answers = eval_answers.move()
            return checked
        }
    }
}

// Keep each newly found share site whose value copies under the registry.
// Returns whether the known set grew, which is when another check is due.
sema_function_accept_share_sites: fn(share_known: ^[Span], found: [SemaOwnershipShareSite], environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    added := false
    loop site in found {
        known := false
        loop span in share_known {
            if span.start == site.span.start && span.end == site.span.end -> known = true
        }
        if known -> next
        facts: sema_copy_classify(site.ty, SemaCopyIntent.Clone, environment, program, environment.generic_params, false)
        if !facts.accepted || facts.copyable || facts.materializes_view || facts.dynamic_loan {
            next
        }
        share_known.push(site.span)
        added = true
    }
    added
}

// The function check reads the registration graph through the read-only
// environment, so the graph is borrowed in place: binding it from the write
// parameter `updated` copied the whole graph (every module's AST) once per
// checked function, which made checking quadratic in program size.
sema_function_apply_scope_policies: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, span: Span, markers: [Marker]) Never! {
    if program.registration_graph == .Val(graph) {
        sema_scope_apply_unit_policy_for_function(scopes, graph, environment.module_identity, span)
        sema_string_view_apply_copies_policy(scopes, graph, environment.module_identity, markers)
        sema_call_marks_apply_policy(scopes, graph, environment.module_identity, markers)
        sema_failure_marks_apply_policy(scopes, graph, environment.module_identity, markers)
    }
}

sema_function_static_roots: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID) -> [SymbolID] Never! {
    if program.registration_graph == .Val(graph) {
        return sema_ownership_static_roots(graph, module_identity)
    }
    [SymbolID]{}
}

sema_function_persist_roots: fn(program: SemaProgramTables, module_identity: ModuleID) -> [SymbolID] Never! {
    if program.registration_graph == .Val(graph) {
        return sema_ownership_persist_roots(graph, module_identity)
    }
    [SymbolID]{}
}

sema_function_resolve_declared: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type, module_identity: ModuleID, generic_params: [TGenericParam]) -> Type Never! {
    if program.registration_graph == .Val(graph) {
        return sema_type_resolve_declared_with_generics(graph, ty, module_identity, generic_params)
    }
    // copy: the resolved declared type is a new owned Type. When nothing resolves it equals `ty`,
    // the declaration's written type (a read parameter), which stays in the AST.
    ty.copy()
}

// Whether written type `ty` mentions a type name that names nothing (E0119,
// reported by the signature walk sema_check_failure_contract_type). A
// parameter of such a type is in scope untyped, so its reads in the body
// check to nothing and add no follow-on report.
sema_function_type_names_nothing: fn(ty: Type, generic_names: [String], environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    if ty == {
        .Named(name) -> sema_failure_written_name_unknown(name, generic_names, environment, program)
        .Apply(name, args) -> {
            if sema_failure_written_name_unknown(name, generic_names, environment, program) {
                return true
            }
            loop arg in args {
                if sema_function_type_names_nothing(arg, generic_names, environment, program) {
                    return true
                }
            }
            false
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .Case(_, inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> sema_function_type_names_nothing(inner, generic_names, environment, program)
        .Map(key, _, value) -> sema_function_type_names_nothing(key, generic_names, environment, program) || sema_function_type_names_nothing(value, generic_names, environment, program)
        .Result(ok, error) -> sema_function_type_names_nothing(ok, generic_names, environment, program) || sema_function_type_names_nothing(error, generic_names, environment, program)
        .Union(members) -> {
            loop member in members {
                if sema_function_type_names_nothing(member, generic_names, environment, program) {
                    return true
                }
            }
            false
        }
        .Tuple(fields) -> {
            loop field in fields {
                if sema_function_type_names_nothing(field.ty, generic_names, environment, program) {
                    return true
                }
            }
            false
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop param in params {
                if sema_function_type_names_nothing(param, generic_names, environment, program) {
                    return true
                }
            }
            if ret == .Val(value) {
                return sema_function_type_names_nothing(value, generic_names, environment, program)
            }
            false
        }
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> false
    }
}

// The scope row of a parameter: untyped when its written type names nothing
// (sema_function_type_names_nothing), else `symbol` as declared.
sema_function_param_scope_symbol: fn(symbol: Symbol, written: Type, generic_names: [String], environment: SemaScopeEnvironment, program: SemaProgramTables) -> Symbol {
    scoped := symbol.copy()
    if sema_function_type_names_nothing(written, generic_names, environment, program) {
        scoped.ty = None
    }
    scoped
}

// `func` is a method of a `Close` impl block, matched by the written trait leaf
// (`impl Secret.Close`), so a builtin `Close` that no module declares counts
// too.
sema_function_is_consuming_close_body: fn(func: Func, module_identity: ModuleID, program: SemaProgramTables) -> Bool Never! {
    if program.registration_graph == .Val(graph) {
        module_index: sema_registration_module_index(graph, module_identity) ?? return false
        loop item_index in 0..<graph.modules[module_index].program.items.len() {
            if graph.modules[module_index].program.items[item_index] == {
                .Impl(definition) -> {
                    if sema_function_close_trait_leaf(definition.trait_name ?? "") && sema_function_declares_span(definition.methods, func.span) {
                        return true
                    }
                }
                .Struct(definition) -> {
                    loop block in definition.trait_impls {
                        if sema_function_close_trait_leaf(block.trait_name) && sema_function_declares_span(block.methods, func.span) {
                            return true
                        }
                    }
                }
                .Enum(definition) -> {
                    loop block in definition.trait_impls {
                        if sema_function_close_trait_leaf(block.trait_name) && sema_function_declares_span(block.methods, func.span) {
                            return true
                        }
                    }
                }
                .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
            }
        }
    }
    false
}

sema_function_close_trait_leaf: fn(trait_name: String) -> Bool Never! {
    parts: trait_name.split(".").to_list()
    parts[parts.len() - 1] == "Close"
}

sema_function_declares_span: fn(methods: [Func], span: Span) -> Bool Never! {
    loop method in methods {
        if method.span == span -> return true
    }
    false
}

// One check of `func` (sema_function_check_passes). `updated` already carries
// the function's merged generic parameters (`generics.merged`) and name.
sema_function_check_pass: fn(func: Func, owner_key: String, function_kind: TFuncKind, raw_protocol_return: Bool, updated: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, generics: SemaFunctionCheckGenerics, host_hooks: SemaHostHookAccess?, share_known: [Span], share_found: ^[SemaOwnershipShareSite], number_known: [SemaNumberRetype], number_found: ^[SemaNumberRetype], diagnostics: ^[Diagnostic], call_facts: ^[SemaCallSiteFact], comptime_requests: ^[SemaComptimeRequest], name_references: ^[SemaNameReferenceFact]) -> SemaFunctionResult {
    diagnostics_start: diagnostics.len()
    module_identity := updated.module_identity
    // The module's identity text: the symbol keys and the checked function name it.
    module_text: sema_scope_environment_module_text(updated, program)
    module_name := updated.module_name
    fallback_source_file := updated.source_file
    complete := generics.complete
    // A Core stand-in of a run bound to the Core image checks its signature
    // alone, with the Core seal's effect and failure facts (CoreSeal.jet
    // sema_core_stand_in): its body is the image's.
    stand_in: sema_core_stand_in(program, owner_key, func.span)
    // copy: the generic parameter lists stay with `generics` for the next pass;
    // the context owns this pass's.
    function_generic_params := generics.own.copy()
    generic_params := generics.merged.copy()
    sema_function_apply_scope_policies(updated, program, scopes, func.span, func.markers)
    // A function a marker template of another module generated reads the
    // names that template wrote in the template's module; the caller's mark
    // drops those bindings after the pass.
    if func.definition_module != "" && func.definition_module != module_text {
        if program.registration_graph == .Val(graph) {
            sema_scope_bind_definition_site(scopes, graph, func)
        }
    }
    check := sema_body_check_init()
    check.state.fixed_length_write_params = updated.fixed_length_write_params
    check.state.share_known = share_known
    check.state.static_roots = sema_function_static_roots(updated, program, module_identity)
    check.state.persist_roots = sema_function_persist_roots(program, module_identity)
    // A raw protocol impl method (Comparable.compare, Display.display, …)
    // checks its body against the declared return, not the failure rail.
    effective_return := sema_checked_return_type(func.return_type, raw_protocol_return)
    effective_return = sema_function_resolve_declared(updated, program, effective_return, module_identity, generic_params)
    sema_scope_enter(scopes, check.state, owner_key)
    scopes.return_type = Val(effective_return)
    scopes.failure_carrier = Val(sema_failure_carrier(Val(effective_return)))
    scopes.loop_depth = 0
    scopes.ownership_call_depth = 0
    scopes.comptime_execution_depth = 0
    if func.is_comptime -> scopes.comptime_execution_depth = 1
    check.context.host_hooks = host_hooks
    check.context.number_retypes_known = number_known
    check.context.generic_params = generic_params
    if func.return_type != None {
        check.context.failure_contract_source = sema_failure_contract_source(func.return_type)
    }
    if func.return_type == .Val(.Result(success, _)) {
        // copy: `success` is a payload of `func`, which keeps the original; the repair fact owns this one
        if func.return_type_span == .Val(return_span) {
            check.context.failure_repair = Val(SemaFailureRepair{return_span: return_span, success: success.copy(), declaration_end: func.span.end})
        }
    }
    // A lifted inline-module member reports its own body under its source name.
    check.context.function_name = sema_inline_member_source_name(func.name)
    // The written success names E0113's alias: the failure solver's `T Never!`
    // and the default `T Err!` both show as T.
    if func.return_type == .Val(written) {
        check.context.return_alias = if written == .Result(success, error) && (sema_expr_unwrap_tag(error) == (Type.Named{name: "Never"}) || error == (Type.Named{name: "Err"})) -> sema_call_alias_shown(success, updated, program) else -> sema_call_alias_shown(written, updated, program)
    }
    // #6281 c176: the union solve reads this body's default `Err` route as
    // sema_failure_union_infer does: a top-level candidate other than the
    // entry `run`, which keeps the `Unit Err!` exit contract.
    if function_kind == .TopLevel && sema_failure_inference_candidate(func) {
        if program.registration_graph == .Val(graph) {
            check.context.failure_union_inferable = func.name != "run" || graph.entry_module_identity != module_identity
        }
    }
    check.context.arithmetic_policy = sema_function_arithmetic_policy(func.markers)
    check.context.runtime_policy = sema_function_runtime_policy(func.markers)
    check.context.compiler_generated = func.compiler_generated && !sema_test_synthetic_function(func) && !sema_policy_wrapper_function(func) && !sema_computed_field_getter_function(func)
    check.context.marker_check_call = None
    if func.marker_check && func.name == "check" && func.params.len() >= 2 -> check.context.marker_check_call = Val("{func.params[1].name}")
    check.context.return_view_declared = func.declared_return_view_provenance != None
    if !check.context.compiler_generated && stand_in == None {
        check.context.eval_walk = sema_eval_walk_open(program, module_identity, func.span, owner_key)
    }
    if !complete {
        sema_check_unsupported(check.context, "the generic parameters of `{func.name}` could not be resolved against the registration graph")
    }
    // The declared signature's failure
    // domains and `Never` slots (E2417, E2422).
    generic_names: loop param in generic_params -> param.name
    if !sema_check_function_failure_contracts(func, updated, program, generic_names, diagnostics) {
        complete = false
    }
    // E0104: a parameter or result type that writes a user generic type bare
    // (`fn(b: Box)`). A trait method's signature is the trait's: a
    // conversion's `from: fn(error: Unsent)` converts every instance.
    if (function_kind == .TopLevel || function_kind == .Method(_, _)) && !func.compiler_generated && !module_is_core(module_identity) {
        if program.registration_graph == .Val(graph) {
            caller: sema_scope_caller_row(updated, graph)
            bare_start: diagnostics.len()
            loop param in func.params {
                if param.name == "self" -> next
                sema_type_bare_generic_names(graph, caller, param.ty, param.ty_span, generic_names, diagnostics)
            }
            if func.return_type == .Val(written_return) {
                sema_type_bare_generic_names(graph, caller, written_return, func.return_type_span ?? func.name_span, generic_names, diagnostics)
            }
            if diagnostics.len() > bare_start {
                complete = false
                check.context.bare_generic_signature = true
            }
        }
    }
    // E2421: the public failure carrier, read from the declared signature.
    sema_check_public_failure_carrier(func, updated, program, diagnostics)
    // E0939/E0940: the `#Memo` cache contract, also proven from the declared
    // signature.
    sema_check_memoized_function(func, updated, program, generic_params, diagnostics)
    // E1411: a `#DevPanel` function's panel contract, also read from the
    // declared signature.
    sema_check_devtools_panel(func, updated, program, diagnostics)
    forward_defaults: sema_function_header_check_default_forward_refs(func, diagnostics)
    if forward_defaults.len() > 0 -> complete = false
    sema_function_header_lint_err_params(func, diagnostics)
    if function_kind == .TopLevel && !module_is_core(module_identity) && !sema_module_no_prelude(updated, program) {
        sema_function_header_lint_prelude_shadow(func, diagnostics)
    }
    if !sema_function_header_check_variadic_bound_shape(func, updated, program, diagnostics) {
        complete = false
    }
    // copy: a shared-facts handle and its frontier, not the facts.
    check.context.comptime_body_values = updated.comptime_body_values.copy()
    sema_comptime_body_work_count(check.context.comptime_body_values, SemaComptimeBodyWorkOperation.ContextAttached)
    unsafe_gate_valid := true
    if func.is_unsafe {
        unsafe_source: sema_effect_source_from_function_key(func, owner_key)
        unsafe_gate_valid = sema_effect_check_unsafe_function(unsafe_source, diagnostics)
        if !unsafe_gate_valid -> complete = false
    }
    is_method: if function_kind == {
        .Method(_, _) | .TraitMethod(_, _, _, _, _) -> true
        .TopLevel -> false
    }
    if !sema_function_header_check_root_params(func, is_method, diagnostics) -> complete = false
    sema_function_header_lint_positional_bools(func, is_method, diagnostics)
    if !sema_function_header_supported(func, check.context) -> complete = false
    // `self` is only a method's receiver; outside a type body or `impl` it
    // would silently be an ordinary parameter. An external `Type.method`
    // header left a function has an unresolved target, which E0301 reports;
    // an `impl Source -> Target` conversion routine takes its source as `self`.
    if !is_method && !func.compiler_generated && func.external_type == None && !sema_is_error_conversion_function(func) {
        loop param in func.params {
            if param.name == "self" {
                diagnostics.push(sema_self_outside_method(check.context.function_name, param.name_span))
                complete = false
                break
            }
        }
    }
    if func.is_reactive {
        if func.is_pure {
            diagnostics.push(sema_error("E2914", func.name_span, "`#Reactive fn` can't also declare `-[]>`", "a reactive effect re-runs when signals change, so it is not a pure function", "drop the `-[]>` bound or use `reactive.autorun` inside a plain `fn`"))
        }
        if func.return_type == .Val(return_type) && return_type != (Type.Named{name: "Unit"}) {
            diagnostics.push(sema_error("E2914", func.name_span, "`#Reactive fn` must not return a value", "`#Reactive fn` lowers to a reactive effect scope — effects don't produce a value", "drop the return type, or use `#Reactive {{ … }}` inside a plain `fn`"))
        }
    }
    if func.is_pure && stand_in == None {
        sema_check_pure_live_blocks(check.context.function_name, func.body, diagnostics)
    }

    params := [TParameter]{}
    // The symbol id of an explicit read `self` (sema_place_borrow_function).
    place_borrow_receiver := symbol_none()
    param_index := 0
    loop param_index < func.params.len() {
        // The parameter is read in place (`func.params[param_index]`): a
        // binding of it copied the whole parameter, default expression included.
        parameter_ty := type_with_effective_parameter_fn_return(func.params[param_index].ty)
        if param_index == 0 && func.params[param_index].name == "self" {
            if function_kind == {
                .Method(_, receiver_type) -> { parameter_ty = receiver_type }
                .TraitMethod(_, _, receiver_type, _, _) -> { parameter_ty = receiver_type }
                .TopLevel -> {}
            }
        }
        if func.params[param_index].variadic -> parameter_ty = Type.List{element: parameter_ty}
        parameter_ty = sema_function_resolve_declared(updated, program, parameter_ty, module_identity, generic_params)
        // A `group: Group` parameter is the caller's live group: a `task` in
        // this body spawns into it, and the caller's `task.group` joins it.
        if parameter_ty == (Type.Named{name: "Group"}) {
            sema_taskgroup_push_parameter(check.context, func.params[param_index].name)
        }
        // E0502: a map in a declared parameter type needs a key-eligible key.
        if !(param_index == 0 && func.params[param_index].name == "self") && !sema_type_check_declared_map_keys(updated, program, parameter_ty, func.params[param_index].ty_span, diagnostics) {
            complete = false
        }
        default_expr := TExpr?{None}
        // A script variable's default names a variable of the calling script
        // lines, which each call checks where it is made.
        if func.params[param_index].default != None && !func.params[param_index].script_variable && !forward_defaults.contains(param_index) {
            default_context := sema_check_context_init()
            default_context.is_snapshot = true
            default_context.unsafe_depth = check.context.unsafe_depth
            default_context.generic_params = generic_params.copy()
            default_context.host_hooks = check.context.host_hooks
            // The default's node ids are the function's ids.
            default_context.next_expr_id = check.context.next_expr_id
            // The default's TypeIDs are the function's: it interns into the
            // function's type delta.
            sema_check_delta_pass(check.context.type_delta, default_context.type_delta)
            // The default's flat nodes are rows of the function's arena: the
            // two contexts trade arenas for the default's check and trade back.
            function_arena: check.context.arena
            check.context.arena = default_context.arena
            default_context.arena = function_arena
            // Checked on the live ownership state inside a fork and rolled back.
            default_fork: sema_ownership_fork(check.state)
            // A `#caller` default checks as the location literal each call
            // gets; a `#here` default is E2428.
            declared_default: func.params[param_index].default ?? Expr.Unit{span: func.params[param_index].name_span, id: AST_NODE_GENERATED}
            sema_site_here_default_check(declared_default, diagnostics)
            caller_default: if declared_default == .Ident(_, caller_span, _) && sema_site_is_caller(declared_default) -> Val(sema_site_location_expr("", updated, program, scopes, caller_span)) else -> Expr?{None}
            sema_body_check_swap_context(check, default_context)
            checked_default: sema_check_expression(caller_default ?? declared_default, Val(parameter_ty), updated, program, scopes, check, diagnostics)
            sema_body_check_swap_context(check, default_context)
            sema_check_delta_pass(default_context.type_delta, check.context.type_delta)
            default_arena: check.context.arena
            check.context.arena = default_context.arena
            default_context.arena = default_arena
            sema_ownership_fork_rollback(check.state, default_fork)
            sema_ownership_fork_close(check.state, default_fork)
            if {
                checked_default == None -> {
                    complete = false
                    loop reason in default_context.incomplete_reasons {
                        sema_check_unsupported(check.context, "default of `{func.params[param_index].name}`: {reason}")
                    }
                }
                else -> {
                    default_expr = checked_default
                    sema_check_context_merge_expr_ids(default_context, check.context)
                }
            }
        }
        param_mutable := func.params[param_index].convention == AccessConvention.Write
        // A sized-integer parameter starts with its type's interval, which a
        // later exit guard narrows.
        param_bounds: sema_expression_type_interval(parameter_ty)
        param_key: symbol_key_text(SymbolKind.Parameter, module_text, owner_key, func.params[param_index].name)
        param_symbol := Symbol{
            id: sema_symbol_id(program, check.context, SymbolKind.Parameter, module_text, owner_key, func.params[param_index].name),
            kind: SymbolKind.Parameter,
            name: func.params[param_index].name,
            module_identity: updated.module_identity,
            owner: Val(owner_key),
            span: func.params[param_index].name_span,
            ty: Val(parameter_ty),
            visibility: 0,
        }
        scope_symbol := sema_function_param_scope_symbol(param_symbol, func.params[param_index].ty, generic_names, updated, program)
        if func.is_pure && scope_symbol.ty == .Val(scope_ty) {
            if sema_time_injected_clock(scope_ty) == .Val(injected) {
                scope_symbol.ty = Val(injected)
            }
        }
        if {
            !sema_scope_declare_local(scopes, scope_symbol, param_key, param_mutable, func.params[param_index].convention, param_bounds, false) -> {
                diagnostics.push(sema_already_defined(func.params[param_index].name, func.params[param_index].name_span))
                complete = false
            }
            else -> {
                sema_ownership_declare_binding(check.state, param_symbol, true)
                if param_index == 0 && func.params[param_index].name == "self" && func.params[param_index].convention == AccessConvention.Move && func.name == "close" && sema_function_is_consuming_close_body(func, module_identity, program) {
                    check.state.close_receiver_id = SymbolID{id: param_symbol.id.id}
                }
                if function_kind == {
                    .Method(_, _) | .TraitMethod(_, _, _, _, _) -> {
                        if param_index == 0 && func.params[param_index].name == "self" {
                            check.context.return_view_receiver_key = param_key.copy()
                        } else { check.context.return_view_parameter_keys.push(param_key.copy()) }
                    }
                    .TopLevel -> check.context.return_view_parameter_keys.push(param_key.copy())
                }
            }
        }
        local := checked_symbol_local(func.params[param_index].name, func.params[param_index].name_span, param_symbol.id, parameter_ty)
        local.mutable = param_mutable
        if !sema_function_explicit_receiver(function_kind, param_index, func.params[param_index]) {
            public_label: func.params[param_index].public_label.map(fn(label) { label.name }) ?? func.params[param_index].name
            params.push(TParameter{local: local, name: func.params[param_index].name, span: func.params[param_index].name_span, ty: parameter_ty, convention: func.params[param_index].convention, public_label: public_label, zone: func.params[param_index].zone, default: default_expr, variadic: func.params[param_index].variadic})
        } else if func.params[param_index].convention == AccessConvention.Read {
            place_borrow_receiver = param_symbol.id
        }
        param_index += 1
    }
    // The function's builtin markers bind their signatures with its parameters
    // in scope. The markers are written before the parameters, so names resolve
    // position free, as the contract conditions do (sema_contract_check_expr).
    // A `#Deadline(limit)` function bounds the waits of its whole body, as a
    // `#Deadline` block around it would.
    marker_position_free: scopes.position_free
    scopes.position_free = true
    markers_valid: sema_marker_rules_check_function_markers(func, updated, program, scopes, check, diagnostics)
    deadline_guards := [TContextGuard]{}
    loop marker in func.markers {
        if stand_in != None || !markers_valid || !sema_marker_is_hook(marker, MarkerHook.Deadline) || marker.negated || marker.args.len() != 1 {
            next
        }
        if marker.args[0] == .Expr(value) {
            limit: sema_check_expression(value, None, updated, program, scopes, check, diagnostics) ?? next
            deadline_guards.push(sema_stmt_deadline_guard(limit, marker.span))
        }
    }
    scopes.position_free = marker_position_free
    if stand_in == None && markers_valid {
        if program.registration_graph == .Val(graph) {
            sema_app_server_only_endpoint_check(func, graph, module_identity, diagnostics)
        }
    }
    if func.return_type == .Val(declared_return) {
        resolved_return := declared_return
        resolved_return = sema_function_resolve_declared(updated, program, declared_return, module_identity, generic_params)
        if !sema_type_check_declared_map_keys(updated, program, resolved_return, func.return_type_span ?? func.name_span, diagnostics) {
            complete = false
        }
        // E1110: a group is call-stack-only spawn authority that flows down
        // through a direct parameter; a returned group would outlive the
        // block that joins it.
        if sema_stmt_contains_taskgroup(resolved_return) {
            diagnostics.push(sema_error("E1110", func.return_type_span ?? func.name_span, "`Group` cannot be returned", "a task group is call-stack-only spawn authority; a returned group would outlive the block that joins it", "pass `group: Group` down to the helper that spawns instead of returning it"))
        }
    }
    // `check_kernel_marker`: the declaration and worker-boundary obligations of
    // `#Kernel(.parallel)` (E1102); its effect and body obligations wait for
    // the effect rows (Kernel.jet).
    if func.kernel == .Val(kernel) {
        if !sema_kernel_check_declaration(func, kernel, is_method, params, effective_return, updated, program, scopes, check.context, diagnostics) {
            complete = false
        }
    }
    if func.is_unsafe && unsafe_gate_valid -> check.context.unsafe_depth = 1
    contract: sema_contract_check_function(func, updated, program, scopes, check, diagnostics)
    if !contract.complete -> complete = false

    body := [TStmt]{}
    if stand_in == None {
        // With no written return type the function returns
        // nothing, so a value on its last line is lost (L0508). With a value
        // return (not a generator; written, or projected by the bundle failure
        // solve) the last line is the value handed back, and a table on the last
        // line hands back the value its arms end in. A `Never` function hands
        // back no value: E2423 (sema_check_never_fallthrough) owns its end.
        returns_value: sema_function_returns_value(effective_return) && !sema_function_promises_never(func)
        if func.body.len() > 0 && func.body[func.body.len() - 1] == .Expr(tail) {
            if {
                returns_value -> check.context.value_tail_span = Val(expr_span(tail))
                func.return_type_span == None && !func.compiler_generated -> {
                    check.context.lost_tail_span = Val(expr_span(tail))
                }
                else -> {}
            }
        }
        if returns_value && func.body.len() > 0 && func.body[func.body.len() - 1] == .Switch(_, _, _, table_span) {
            check.context.value_tail_span = Val(table_span)
        }
        // A last-line `#Unsafe { … }` region checks its body as the value
        // block, so the region's own last line is the value.
        if returns_value && func.body.len() > 0 && func.body[func.body.len() - 1] == .Unsafe(_, _, unsafe_body, _) {
            check.context.value_tail_span = sema_stmt_value_tail_marker(unsafe_body)
        }
        // A fallback-free arm table followed by a default return needs no `else`
        // arm; imported Core bodies and generated functions have no user source
        // to fix, so only user code is linted (L0513, L0530).
        if returns_value {
            sema_stmt_value_block_tail_lints(func.body, !func.compiler_generated && !module_is_core(updated.module_identity), updated, program, check.context.fallback_tables, diagnostics)
        }
        statements := sema_check_statements(func.body, Val(effective_return), updated, program, scopes, check, diagnostics, 0)
        // The caller's group joins every task this body spawned into a `Group`
        // parameter, so those handles owe no `join` here.
        sema_taskgroup_mark_spawns_owned(check.context, SemaTaskGroupOrigin.Parameter, scopes, check.state, diagnostics)
        check.context.lost_tail_span = None
        check.context.value_tail_span = None
        check.context.fallback_tables = [Int]{}
        loop site in check.state.share_found -> share_found.push(site)
        loop retype in check.context.number_retypes_found -> number_found.push(retype)
        if !statements.complete -> complete = false
        if !sema_check_never_fallthrough(func, updated, program, scopes, diagnostics) {
            complete = false
        }
        sema_lint_inferred_never_return(func, owner_key, updated, program, diagnostics)
        sema_function_header_external_target(func, diagnostics, diagnostics_start)
        // A value body reports E0114 when it can reach its end without a value.
        if returns_value && !sema_stmt_check_value_block_end(func.body, statements.value, Val(effective_return), func.span, check.context.function_name, scopes, diagnostics) {
            complete = false
        }
        // Validation borrows the original checked rows. Once that loan ends the
        // same vector moves into the function; no owning TStmt-vector copy.
        body = statements.value.move()
        if deadline_guards.len() > 0 {
            body = [TStmt]{TStmt.ContextBlock{guards: deadline_guards, body: body, span: func.span}}
        }
        if contract.complete && contract.post.len() > 0 {
            body = [TStmt]{TStmt.ContractScope{pre: [TContract]{}, body: body, post: contract.post, result: contract.result, span: func.span}}
        }
    }
    // Unused-binding lints and E0514 address authored code; a
    // compiler-generated body (derived codec scaffolding) binds every slot it
    // may need.
    if !check.context.compiler_generated && stand_in == None {
        sema_ownership_finalize_references(check.state, diagnostics)
        sema_ownership_report_never_written(check.state, diagnostics)
    }
    // The context's facts move to the caller's lists; each emptied field is
    // set again so the spent context still moves whole into the result.
    call_facts.extend(check.context.call_facts.move())
    check.context.call_facts = [SemaCallSiteFact]{}
    comptime_requests.extend(check.context.comptime_requests.move())
    check.context.comptime_requests = [SemaComptimeRequest]{}
    // Each reference names the body that recorded it, so a reader keys a
    // local in that body's symbols whatever its span. A nested check that
    // ran its own body keeps its name.
    loop index in 0..<check.context.name_references.len() {
        if check.context.name_references[index].body == "" {
            check.context.name_references[index].body = owner_key
        }
    }
    name_references.extend(check.context.name_references.move())
    check.context.name_references = [SemaNameReferenceFact]{}
    if stand_in == None -> sema_single_use_leave_scope(scopes, check.state, diagnostics) else {
        sema_scope_leave(scopes, check.state)
    }
    source_line := sema_source_line_at(updated.source_segments, func.name_span)
    if source_line == None {
        complete = false
        sema_check_unsupported(check.context, "no source segment covers the declaration of `{func.name}` at offset {func.name_span.start}")
    }
    return_view_provenance := ViewProvenanceMap?{None}
    if stand_in == None {
        return_view_provenance = sema_function_return_view_provenance(func, check.context.return_view_provenance, diagnostics, complete)
    }
    if !complete {
        return sema_function_result(None, owner_key, check.context.move())
    }
    source_line_value: source_line ?? {
        return sema_function_result(None, owner_key, check.context.move())
    }
    source_file: sema_source_file_at(updated.source_segments, fallback_source_file, updated.source_origin, func.span)
    visibility := NameVisibility.Private
    if func.is_pub -> visibility = NameVisibility.Public
    effects := TEffectFacts{direct: [String]{}, solved: [String]{}, call_edges: [String]{}, maximal: false, direct_spans: [TEffectSpan]{}, module_writes: check.context.module_writes.move()}
    check.context.module_writes = [TEffectSpan]{}
    if stand_in == .Val(seal_facts) -> effects = seal_facts.effects
    unsafe_gate := TUnsafeGate?{None}
    if func.is_unsafe && unsafe_gate_valid && func.unsafe_reason != None {
        reason: func.unsafe_reason ?? ""
        unsafe_span: func.unsafe_span ?? func.span
        line: sema_source_line_at(updated.source_segments, unsafe_span) ?? source_line_value
        unsafe_gate = Val(TUnsafeGate{file: sema_source_file_at(updated.source_segments, fallback_source_file, updated.source_origin, unsafe_span), line: line, reason: reason, enabled: true, fenced: false})
    }
    sema_place_borrow_function(body, params, place_borrow_receiver, program, check.context)
    memo: sema_function_header_memo_config(func)
    // `#Scalar` keeps every loop of the body on the scalar path: its loops
    // record no loop proof (LoopFacts.jet).
    scalar := false
    loop marker in func.markers {
        if marker.name == MARKER_SCALAR -> scalar = true
    }
    written_row := [String]?{None}
    if func.declared_effects == .Val(row) {
        names := [String]{}
        loop entry in row -> names.push(entry.name.copy())
        written_row = Val(names)
    }
    effect_scope: effect_scope_descriptor(func.name, owner_key, func.params.len() > 0 && func.params[0].name == "path", written_row)
    endpoint := ""
    system_run := ""
    role := ""
    if program.registration_graph == .Val(graph) {
        endpoint = sema_function_endpoint(func, graph, module_identity)
        system_run = sema_function_system_run(func, graph, module_identity)
        role = sema_core_role(func.markers, graph, module_identity)
    }
    built := TFunc{
        name: func.name,
        module_name: module_name,
        module_identity: module_identity,
        key: owner_key,
        source_file: source_file,
        source_span: func.span,
        failure_carrier: sema_failure_carrier(Val(effective_return)),
        effects: effects,
        web_bucket: None,
        web_marker: func.web_marker,
        endpoint: endpoint,
        system_run: system_run,
        role: role,
        visibility: visibility,
        foreign: None,
        params: params,
        web_param_reconstructions: [TWebParamReconstruction]{},
        ret: Val(effective_return),
        gc_return: func.gc_return,
        gc_scope: func.gc_scope,
        return_view_provenance: return_view_provenance,
        generic_params: function_generic_params,
        is_main: false,
        line: source_line_value,
        synthetic: func.compiler_generated,
        is_unsafe: func.is_unsafe,
        unsafe_gate: unsafe_gate,
        is_pure: func.is_pure,
        memo_bound: memo.bound,
        memo_unbounded: memo.unbounded,
        is_reactive: func.is_reactive,
        reactive_upgrades: check.context.reactive_upgrades,
        body: body.move(),
        is_inline: func.is_inline,
        is_inline_always: func.is_inline_always,
        is_scalar: scalar,
        kernel_proof: None,
        uses_stack_sentry: false,
        max_depth: func.max_depth,
        kind: function_kind,
        origin_facts: check.context.origin_facts.move(),
        typed_goals: check.context.typed_goals.move(),
        index_proofs: check.context.index_proofs.move(),
        pre: if contract.complete -> contract.pre.move() else -> [TContract]{},
        effect_scope: effect_scope,
        effect_scope_regions: sema_authority_scope_regions(func.body, func.name),
    }
    // The checker's tree ends here, as the function's flat body; nodes the
    // checker gave no id take flat-local ones.
    check.context.origin_facts = [TOriginProjection]{}
    check.context.typed_goals = [TTypedGoal]{}
    check.context.index_proofs = [TIndexProof]{}
    arena_tree := check.context.arena.tree.move()
    arena_syntax := check.context.arena.arena_syntax.move()
    check.context.arena.tree = body_tree_new()
    check.context.arena.arena_syntax = [Type]{}
    flat := body_flat_function(built.move(), arena_tree.move(), arena_syntax.move(), program, check.context)
    if sema_footprint_has_receiver(func) {
        if program.registration_graph == .Val(graph) {
            if sema_registration_module_index(graph, flat.module_identity) == .Val(module_index) {
                flat.receiver_footprint = sema_footprint_for_method_span(graph.modules[module_index], func.span)
            }
        }
    }
    scopes.type_delta = [InternerDelta]{}
    if check.context.type_delta.len() > 0 {
        if check.context.type_delta.pop() == .Val(delta) {
            if delta_has_rows(delta) {
                scopes.type_delta.push(delta)
            }
        }
    }
    if stand_in == None -> return sema_function_result(Val(flat), owner_key, check.context.move())
    flat.stand_in = true
    result := sema_function_result(Val(flat), owner_key, check.context.move())
    result.failure = Val(stand_in.failure)
    result
}

check_program: fn(input: Program, module_name: String, source_file: String, source_segments: [SemaSourceSegment]) -> SemaResult {
    diagnostics := [Diagnostic]{}
    policy_program := Program?{None}
    if input.user_policy_declarations.len() > 0 {
        prepared := input.copy()
        declarations: sema_policy_declarations_checked(input.user_policy_declarations, diagnostics)
        sema_policy_materialize(prepared, declarations, module_name, source_file, SemaSourceOrigin.Snapshot, source_segments, diagnostics)
        policy_program = Val(prepared.move())
    }
    source_program: policy_program ?? input
    sema_marker_rules_validate_allow(source_program, diagnostics)
    functions := [FnBody]{}
    call_facts := [SemaCallSiteFact]{}
    hardware_use := sema_hardware_empty_use()
    name_references := [SemaNameReferenceFact]{}
    comptime_requests := [SemaComptimeRequest]{}
    comptime_body_sources := [SemaComptimeBodySource]{}
    compute_facts := [SemaComputeFunctionFacts]{}
    // A snapshot has no module table: its module is the none id, named by
    // `module_name` (sema_scope_environment_module_text).
    scopes := sema_scope_init(module_none())
    local_declarations := [SemaScopeDeclaration]{}
    symbols := symbol_table()
    exact_int_reachable := false
    copy_events := [SemaCopyEvent]{}
    memory_plan := sema_function_memory_plan_for_program(source_program, module_none())
    // User policies are materialized above and `#Allow` is validated, so only
    // other rule applications leave the slice incomplete.
    complete := source_program.script_body.len() == 0 && source_program.imports.len() == 0 && source_program.block_spans.len() == 0 && source_program.web_target_ceiling == None && !source_program.no_prelude && source_program.html_path == None && !sema_function_memory_has_unsupported_policies(source_program.policy_declarations) && !sema_policy_has_unsupported_applications(source_program)
    item_index := 0
    loop item_index < source_program.items.len() {
        item: source_program.items[item_index]
        if !sema_register_item(scopes, local_declarations, symbols, item, module_name, source_file, SemaSourceOrigin.Snapshot, source_segments, diagnostics) {
            complete = false
        }
        if item == {
            .Func(_) -> {}
            .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {
                complete = false
            }
        }
        item_index += 1
    }
    job_diagnostics := sema_check_job_names(source_program.items)
    if job_diagnostics.len() > 0 {
        loop diagnostic in job_diagnostics -> diagnostics.push(diagnostic)
        complete = false
    }
    loop diagnostic in sema_scope_members_check(source_program.tables, source_program.items, source_program.has_scope_member) {
        diagnostics.push(diagnostic)
    }
    environment := sema_scope_environment_init(module_none(), "", module_name, source_file, SemaSourceOrigin.Snapshot, source_segments, local_declarations)
    // One program, no registration graph and no checked types; its symbols
    // are the snapshot's own.
    program := sema_program_tables_init(None, [TTypeDef]{})
    program.symbols = symbols.move()
    program.interner = Val(interner_empty())
    environment.else_arms = source_program.else_arms
    environment.debug_sites = source_program.debug_sites
    environment.tables = source_program.tables
    environment.fixed_length_write_params = sema_fixed_length_write_params(source_program.items)

    item_index = 0
    loop item_index < source_program.items.len() {
        if source_program.items[item_index] == {
            .Func(func) -> {
                function_call_facts := [SemaCallSiteFact]{}
                function_comptime_requests := [SemaComptimeRequest]{}
                function_name_references := [SemaNameReferenceFact]{}
                memory_row := sema_function_memory_position(memory_plan, module_none(), "", func.name, func.span)
                memory_func := func.copy()
                if memory_row == {
                    .Val(position) -> {
                        if memory_plan.functions[position].function == .Val(planned) {
                            memory_func = planned
                        }
                        loop diagnostic in memory_plan.functions[position].diagnostics {
                            diagnostics.push(diagnostic)
                        }
                        if !memory_plan.functions[position].complete -> complete = false
                    }
                    .None -> { complete = false }
                }
                checked := sema_function_check(memory_func, symbol_key_text(SymbolKind.Function, module_name, "", func.name), TFuncKind.TopLevel, false, environment, program, scopes, None, diagnostics, function_call_facts, function_comptime_requests, function_name_references)
                if ^program.interner == .Val(table) {
                    loop scopes.type_delta.len() > 0 {
                        delta := scopes.type_delta.pop() ?? break
                        if delta_has_rows(delta) {
                            remap: interner_merge_delta(table, delta.move())
                            if ^checked.value == .Val(body) -> body_tree_remap_types(body.tree, remap)
                            sema_remap_comptime_requests_from(function_comptime_requests, 0, remap)
                        }
                    }
                }
                sema_hardware_use_merge(hardware_use, sema_hardware_use_snapshot(checked.hardware_use))
                comptime_body_sources.extend(checked.comptime_body_sources.move())
                compute_facts.push(checked.compute_facts)
                exact_int_reachable = exact_int_reachable || checked.exact_int_reachable
                copy_events.extend(checked.copy_events.move())
                call_facts.extend(function_call_facts.move())
                comptime_requests.extend(function_comptime_requests.move())
                name_references.extend(function_name_references.move())
                if !checked.complete || !sema_append_function(functions, checked.value.move()) {
                    complete = false
                }
            }
            .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
        item_index += 1
    }
    // #3708: one program has no bundle failure solve, so every recorded
    // failure-domain obligation is emitted as reported.
    if sema_failure_settle_obligations(diagnostics, name_table_sized(4)) -> complete = false
    sema_attach_diagnostic_source_locations(diagnostics, 0, source_segments)
    SemaResult{module_name: module_name, functions: functions, call_facts: call_facts, hardware_use: hardware_use, comptime_requests: comptime_requests, comptime_body_sources: comptime_body_sources, compute_facts: compute_facts, name_references: name_references, exact_int_reachable: exact_int_reachable, copy_events: copy_events, diagnostics: diagnostics, complete: complete, interner: program.interner.move() ?? interner_empty()}
}

// `rows` is sema_comptime_checked_function_rows(functions).
sema_comptime_find_checked_function: fn(functions: [SemaComptimeFunctionResult], rows: SemaComptimeFunctionRows, module_identity: ModuleID, function_key: String) -> SemaComptimeFunctionResult? {
    row: sema_comptime_function_row(rows, module_identity, function_key) ?? return None
    Val(functions[row])
}

// The functions of `functions` but those whose keys `keys` holds.
sema_comptime_functions_without: fn(functions: [SemaComptimeFunctionResult], keys: [String]) -> [SemaComptimeFunctionResult] Never! {
    dropped := name_table_sized(keys.len() + 1)
    loop key in keys -> _ := name_intern(dropped, key)
    kept := [SemaComptimeFunctionResult]{}
    loop function in functions {
        if name_find(dropped, function.function_key) == None -> kept.push(function.copy())
    }
    kept
}

// Each checked comptime function's first row in its list by module and key,
// built once per check pass rather than rescanning the list for every
// checked function. `first` holds the first row of each key at its id in
// `keys` (-1: none), `next[row]` the key's next row, and `modules[row]` the
// row's module, so a lookup walks only its key's rows.
SemaComptimeFunctionRows: struct {
    keys: NameTable,
    first: [Int],
    next: [Int],
    modules: [U32],
}

sema_comptime_checked_function_rows: fn(functions: [SemaComptimeFunctionResult]) -> SemaComptimeFunctionRows Never! {
    rows := SemaComptimeFunctionRows{keys: name_table_sized(functions.len() * 2 + 2), first: [Int]{-1}, next: [Int]{}, modules: [U32]{}}
    last := [Int]{-1}
    loop (row, checked) in functions {
        id: name_index(name_intern(rows.keys, checked.function_key))
        if id == rows.first.len() {
            rows.first.push(-1)
            last.push(-1)
        }
        if rows.first[id] < 0 -> rows.first[id] = row else -> rows.next[last[id]] = row
        last[id] = row
        rows.next.push(-1)
        rows.modules.push(checked.module_identity.id)
    }
    rows
}

// The first row of `module_identity`'s function `function_key`, if any.
sema_comptime_function_row: fn(rows: SemaComptimeFunctionRows, module_identity: ModuleID, function_key: String) -> Int? Never! {
    id: name_find(rows.keys, function_key) ?? return None
    row := rows.first[name_index(id)]
    loop row >= 0 {
        if rows.modules[row] == module_identity.id -> return Val(row)
        row = rows.next[row]
    }
    None
}

// A result whose only errors are failure obligations is appended too: the
// caller carries those obligations to the solve that settles them.
sema_comptime_append_checked_function: fn(result: SemaComptimeFunctionResult, functions: ^[FnBody], call_facts: ^[SemaCallSiteFact], comptime_requests: ^[SemaComptimeRequest], name_references: ^[SemaNameReferenceFact]) -> Bool Never! {
    function: result.function ?? return false
    functions.push(function.copy())
    loop fact in result.call_facts -> call_facts.push(fact.copy())
    loop request in result.calls -> comptime_requests.push(request.copy())
    loop reference in result.name_references -> name_references.push(reference.copy())
    result.complete || result.obligations_pending
}

// The failure obligations of a comptime-checked body, which the body pass
// that reuses it settles with the bundle solve, as it does for a body it
// checks itself.
sema_comptime_push_obligations: fn(result: SemaComptimeFunctionResult, diagnostics: ^[Diagnostic]) Never! {
    if !result.obligations_pending {
        return
    }
    mark: sema_failure_obligation_mark()
    loop diagnostic in result.diagnostics {
        if sema_failure_obligation_callee(diagnostic, mark) != None {
            diagnostics.push(diagnostic.copy())
        }
    }
}

// Records again what a comptime-checked body demanded of the generated
// codecs and derived methods, which the body pass that reuses it would have
// demanded checking it (SemaDemandCapture).
sema_comptime_replay_demand: fn(result: SemaComptimeFunctionResult, program: SemaProgramTables) {
    if result.codec_demand.len() == 0 && result.derive_demand.len() == 0 {
        return
    }
    if program.registration_graph == .Val(graph) {
        sema_demand_capture_replay(graph, result.codec_demand, result.derive_demand)
    }
}

// sema_comptime_append_checked_function into one module result in place,
// carrying the function's exact-int, copy and probe facts as well.
sema_comptime_append_checked_function_to_module: fn(result: SemaComptimeFunctionResult, module_row: ^SemaGraphModuleResult) -> Bool Never! {
    if !sema_comptime_append_checked_function(result, module_row.functions, module_row.call_facts, module_row.comptime_requests, module_row.name_references) {
        return false
    }
    module_row.exact_int_reachable = module_row.exact_int_reachable || result.exact_int_reachable
    loop event in result.copy_events -> module_row.copy_events.push(event.copy())
    module_row.eval_answers.extend(result.eval_answers)
    true
}

SemaComptimeFunctionSource: struct {
    declaration: Func,
    symbol: Symbol,
    kind: TFuncKind,
    raw_protocol_return: Bool,
}

sema_comptime_method_kind: fn(function: Func, owner_type: Type, trait_symbol: Symbol?) -> TFuncKind Never! {
    self_convention := AccessConvention?{None}
    if function.params.len() > 0 && function.params[0].name == "self" {
        self_convention = Val(function.params[0].convention)
    }
    if trait_symbol == {
        .Val(resolved_trait) -> return TFuncKind.TraitMethod{is_unsafe: function.is_unsafe, self_convention: self_convention, owner_type: owner_type, trait_name: resolved_trait.id, serde_codec: None}
        .None -> return TFuncKind.Method{self_convention: self_convention, owner_type: owner_type}
    }
}

sema_comptime_find_function_source: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, function_key: String) -> SemaComptimeFunctionSource? {
    module_index: sema_registration_module_index(graph, module_identity) ?? return None
    sema_comptime_indexed_function_source(graph, module_index, function_key)
}

// The checked foreign row of the foreign function registered under
// `function_key`: an inline foreign (`#FFI`) function, or a per-callable
// `#Import(c)`. A jet.runtime binding is one of the latter, and IR lowers its
// row as a runtime route on every tier, compile time included. Validation
// findings are the module check's to report (sema_checked_foreign_functions),
// so this lookup drops them.
sema_comptime_foreign_row: fn(graph: SemaRegistrationGraph, function_key: String) -> SemaCheckedForeignFunction? {
    row: sema_registration_callable_row(graph, function_key) ?? return None
    if row == .Function(declaring, index) {
        if sema_function_is_guest_import(graph.modules[declaring].functions[index].declaration) {
            return sema_checked_guest_import_foreign_row(graph, graph.modules[declaring], graph.modules[declaring].functions[index])
        }
        reported := [Diagnostic]{}
        source := [U8]{}
        return sema_checked_inline_foreign_row(graph, graph.modules[declaring], graph.modules[declaring].functions[index], source, reported)
    }
    None
}

// The staged source of the callable registered under `function_key`, through
// its SymbolId; `module_index` >= 0 keeps only a row that module declares.
sema_comptime_indexed_function_source: fn(graph: SemaRegistrationGraph, module_index: Int, function_key: String) -> SemaComptimeFunctionSource? {
    row: sema_registration_callable_row(graph, function_key) ?? return None
    if row == {
        .Function(declaring, index) -> {
            if module_index >= 0 && declaring != module_index -> return None
            // copy: the source is the caller's own; the row stays in the graph.
            return Val(SemaComptimeFunctionSource{declaration: sema_registration_function_with_body(graph.modules[declaring], graph.modules[declaring].functions[index]), symbol: graph.modules[declaring].functions[index].symbol.copy(), kind: TFuncKind.TopLevel, raw_protocol_return: graph.modules[declaring].functions[index].raw_protocol_return})
        }
        .NominalMethod(declaring, owner, index) -> {
            if module_index >= 0 && declaring != module_index -> return None
            declaration := sema_registration_function_with_body(graph.modules[declaring], graph.modules[declaring].nominals[owner].methods[index])
            if declaration.body.len() == 0 && sema_codec_method_body(graph, graph.modules[declaring].nominals[owner].symbol.name, graph.modules[declaring].nominals[owner].methods[index].symbol.id) == .Val(body) {
                declaration.body = body
            }
            return Val(SemaComptimeFunctionSource{declaration: declaration, symbol: graph.modules[declaring].nominals[owner].methods[index].symbol.copy(), kind: sema_comptime_method_kind(graph.modules[declaring].nominals[owner].methods[index].declaration, graph.modules[declaring].nominals[owner].ty, None), raw_protocol_return: graph.modules[declaring].nominals[owner].methods[index].raw_protocol_return})
        }
        .ImplMethod(declaring, owner, index) -> {
            if module_index >= 0 && declaring != module_index -> return None
            declaration := sema_registration_function_with_body(graph.modules[declaring], graph.modules[declaring].impls[owner].methods[index])
            if sema_codec_pending_body(graph, declaring, owner, declaration.name) == .Val(body) {
                declaration.body = body
            }
            return Val(SemaComptimeFunctionSource{declaration: declaration, symbol: graph.modules[declaring].impls[owner].methods[index].symbol.copy(), kind: sema_comptime_method_kind(graph.modules[declaring].impls[owner].methods[index].declaration, graph.modules[declaring].impls[owner].target_type, graph.modules[declaring].impls[owner].trait_symbol), raw_protocol_return: graph.modules[declaring].impls[owner].methods[index].raw_protocol_return})
        }
        .Foreign(_, _) -> return None
    }
}

// Read the environment's staged graph only inside these checks; subsequent
// environment writes must not turn the graph payload into an owned snapshot.
sema_comptime_normalize_owner: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, owner: Type, module_identity: ModuleID) -> Type? {
    if program.registration_graph == .Val(graph) {
        return Val(sema_function_normalize_owner_type(graph, owner, module_identity))
    }
    None
}

sema_comptime_owner_generic_params: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, owner: Type, module_identity: ModuleID, diagnostics: ^[Diagnostic], complete: ^Bool) -> [TGenericParam] {
    if program.registration_graph == .Val(graph) {
        return sema_function_owner_generic_params(graph, owner, module_identity, diagnostics, complete)
    }
    [TGenericParam]{}
}

// The result of a comptime function check that could not run, with `reason`
// as its one incomplete reason.
sema_comptime_function_unresolved: fn(module_identity: ModuleID, function_key: String, reason: String) -> SemaComptimeFunctionResult Never! {
    SemaComptimeFunctionResult{
        module_identity: module_identity,
        function_key: function_key,
        function: None,
        waiting_dependencies: [String]{},
        calls: [SemaComptimeRequest]{},
        reachable_function_keys: [String]{},
        call_facts: [SemaCallSiteFact]{},
        hardware_use: sema_hardware_empty_use(),
        name_references: [SemaNameReferenceFact]{},
        comptime_body_sources: [SemaComptimeBodySource]{},
        compute_facts: sema_compute_facts_empty(function_key),
        diagnostics: [Diagnostic]{},
        exact_int_reachable: false,
        copy_events: [SemaCopyEvent]{},
        complete: false,
        incomplete_reasons: [String]{reason},
    }
}

// `memory_plan` is the graph's memory plan, built once by the caller: known-
// time values only type constants, never the functions the plan annotates.
// The caller keeps the run's checked functions and reuses a complete one
// instead of calling this again.
// `comptime_scopes` are the run's module scopes (sema_comptime_scopes_init),
// lent to every item and function check of the run.
sema_check_comptime_function: fn(graph: SemaRegistrationGraph, environment: ^SemaScopeEnvironment, program: SemaProgramTables, comptime_scopes: ^SemaComptimeScopes, available: SemaComptimeAvailableConstants, memory_plan: SemaFunctionMemoryPlan, values: [SemaComptimeItemValue], module_identity: ModuleID, function_key: String) -> SemaComptimeFunctionResult {
    unresolved := sema_comptime_function_unresolved(module_identity, function_key, "`{function_key}` has no registered comptime function source in module `{module_text(graph.module_table, module_identity)}`")
    source: sema_comptime_find_function_source(graph, module_identity, function_key) ?? return unresolved
    if source.declaration.inline_foreign != None || sema_function_is_guest_import(source.declaration) {
        unresolved.incomplete_reasons = [String]{}
        unresolved.foreign = sema_comptime_foreign_row(graph, function_key)
        if unresolved.foreign == None {
            unresolved.incomplete_reasons.push("the foreign function `{source.declaration.name}` has no checked foreign row")
            return unresolved
        }
        // A per-callable `#Import(c)` has no body, so no failure source and
        // no edge: the closure's solve proves an unannotated one infallible,
        // as the bundle solve does (sema_failure_solve).
        if sema_function_is_guest_import(source.declaration) {
            unresolved.failure = Val(SemaFunctionFailureFacts{function_key: function_key, direct: false, edges: [String]{}})
        }
        unresolved.complete = true
        return unresolved
    }
    // Any function a compile-time body reaches runs while building; the
    // native run's effect gate (E3401) rejects an effectful call. No
    // `#run fn` or `pure` marker is required.
    // Retarget module-local scope facts while reading the retained graph
    // from its single owner in `program`.
    // copy: a handle copy (Shared facts plus length and frontier ints): this check reads a frozen
    // prefix while environment.comptime_body_publication keeps advancing.
    body_values := environment.comptime_body_publication.copy()
    entered: sema_scope_environment_enter_comptime_module(environment, program, module_identity, body_values)
    if !entered -> return unresolved
    diagnostics := [Diagnostic]{}
    memory_row := sema_function_memory_position(memory_plan, module_identity, sema_function_memory_owner(source.kind), source.declaration.name, source.declaration.span)
    memory_func := source.declaration
    memory_complete := true
    if memory_row == {
        .Val(position) -> {
            // A pending codec's planned row is its header: the body the
            // source carries (sema_codec_pending_body) stands.
            if memory_plan.functions[position].function == .Val(planned) && (planned.body.len() > 0 || source.declaration.body.len() == 0) {
                memory_func = planned
            }
            loop diagnostic in memory_plan.functions[position].diagnostics {
                diagnostics.push(diagnostic.copy())
            }
            memory_complete = memory_plan.functions[position].complete
        }
        .None -> { memory_complete = false }
    }
    sema_comptime_scopes_prepare(comptime_scopes, environment, program, sema_comptime_available_version(available))
    if !comptime_scopes.slots[comptime_scopes.current].applied {
        loop diagnostic in comptime_scopes.slots[comptime_scopes.current].diagnostics {
            diagnostics.push(diagnostic.copy())
        }
        sema_attach_diagnostic_source_locations(diagnostics, 0, environment.source_segments)
        failed := sema_comptime_function_unresolved(module_identity, function_key, "the scope of module `{module_text(graph.module_table, module_identity)}` could not be applied")
        failed.diagnostics = diagnostics
        return failed
    }
    call_facts := [SemaCallSiteFact]{}
    calls := [SemaComptimeRequest]{}
    name_references := [SemaNameReferenceFact]{}
    owner_generic_complete := true
    function_kind := source.kind
    owner_type := sema_function_kind_owner_type(source.kind)
    if owner_type != None {
        owner: owner_type ?? Type.Named{name: "Unit"}
        normalized_owner_type: sema_comptime_normalize_owner(environment, program, owner, module_identity) ?? return unresolved
        environment.generic_params = sema_comptime_owner_generic_params(environment, program, normalized_owner_type, module_identity, diagnostics, owner_generic_complete)
        function_kind = if source.kind == {
            .Method(convention, _) -> TFuncKind.Method{self_convention: convention, owner_type: normalized_owner_type}
            .TraitMethod(is_unsafe, convention, _, trait_symbol, codec) -> TFuncKind.TraitMethod{is_unsafe: is_unsafe, self_convention: convention, owner_type: normalized_owner_type, trait_name: trait_symbol, serde_codec: codec}
            .TopLevel -> source.kind
        }
    }
    mark: sema_scope_mark(comptime_scopes.slots[comptime_scopes.current].table)
    comptime_scopes.slots[comptime_scopes.current].table.comptime_execution_depth = 1
    // The demand this check records rides the result, for a body pass that
    // takes it to record again (SemaDemandCapture). A Core function's check
    // loads from the Core library's bodies file as the body pass's does
    // (CoreBodies.jet sema_core_body_loaded), and that check is the one the
    // body pass then reuses.
    sema_demand_capture_open(graph)
    module_index: sema_registration_module_index(graph, module_identity) ?? -1
    comptime_scopes.slots[comptime_scopes.current].table.type_delta = [InternerDelta]{}
    loaded: if module_index >= 0 -> sema_core_body_loaded(program, comptime_scopes.host_hooks, module_index, source.symbol.id, comptime_scopes.slots[comptime_scopes.current].table.type_delta, diagnostics, call_facts, calls, name_references) else -> None
    checked := loaded ?? sema_function_check(memory_func, sema_program_symbol_key(program, source.symbol.id), function_kind, source.raw_protocol_return, environment, program, comptime_scopes.slots[comptime_scopes.current].table, comptime_scopes.host_hooks, diagnostics, call_facts, calls, name_references)
    fn_delta := [InternerDelta]{}
    sema_drain_scope_delta(program, fn_delta, comptime_scopes.slots[comptime_scopes.current].table, checked.value, calls, 0)
    // A propagation site that reaches `Err` from a Core error family member
    // converts through its module's Prelude routine, which a module check
    // injects after its bodies. A compile-time closure runs before that, so
    // this check injects the routines the body demands, and the closure
    // builds them beside it. The body moves into a one-row list for the
    // injection's demand walk and back. The routines' own facts stay out of
    // the body's, which a module check that reuses this result records.
    conversions := [FnBody]{}
    conversion_reasons := [String]{}
    conversion_call_facts := [SemaCallSiteFact]{}
    if checked.value != None {
        taken := checked.value.move()
        checked.value = None
        bodies := [FnBody]{taken.move() ?? panic("a checked body lost its function")}
        conversion_requests := [SemaComptimeRequest]{}
        conversion_references := [SemaNameReferenceFact]{}
        _ := sema_inject_prelude_error_conversions(sema_scope_environment_module_text(environment, program), environment, program, comptime_scopes.slots[comptime_scopes.current].table, comptime_scopes.host_hooks, bodies, [Int:[SemaPreludeConversionDemand]]{}, fn_delta, diagnostics, conversion_call_facts, conversion_requests, conversion_references, conversion_reasons, false)
        loop bodies.len() > 1 {
            conversions.push(bodies.pop() ?? break)
        }
        conversions.reverse()
        function := bodies.pop() ?? panic("a checked body lost its function")
        checked.value = Val(function.move())
    }
    // This body runs while building, but it is checked as the run-time code
    // it also is, so its calls of a `#Runtime(.Only)` function are refused
    // here (E1022). A `#run fn`'s own check refuses them already.
    if !source.declaration.is_comptime {
        loop fact in call_facts {
            callee: fact.callee ?? next
            row: sema_registration_callable_row_of(graph, callee) ?? next
            if sema_callable_runtime_only(graph, row) {
                diagnostics.push(sema_runtime_only_build_time_diagnostic("Compile-time code calls `{sema_effect_comptime_callee_name(symbol_table_key(graph.symbols, callee))}`", fact.span))
            }
        }
    }
    demand: sema_demand_capture_close(graph)
    sema_scope_rollback(comptime_scopes.slots[comptime_scopes.current].table, mark)
    waiting := [String]{}
    if available.counted_values >= values.len() {
        seen_wait := name_table()
        loop reference in name_references {
            if reference.symbol.kind != SymbolKind.Constant -> next
            key: symbol_table_key(graph.symbols, reference.symbol.id)
            if name_find(available.keys, key) != None || name_find(seen_wait, key) != None -> next
            _ := name_intern(seen_wait, key)
            waiting.push(key)
        }
    } else {
        dependencies := sema_comptime_environment_dependencies(environment, program, name_references, values) ?? return unresolved
        waiting = sema_comptime_waiting_dependencies(available, dependencies)
    }
    sema_attach_diagnostic_source_locations(diagnostics, 0, environment.source_segments)
    incomplete_reasons := [String]{}
    if !memory_complete -> incomplete_reasons.push("its memory plan row is missing or incomplete")
    if !owner_generic_complete {
        incomplete_reasons.push("its owner's generic parameters could not be resolved")
    }
    if !checked.complete {
        if checked.incomplete_reasons.len() == 0 {
            incomplete_reasons.push("body checking is incomplete")
        }
        incomplete_reasons.extend(checked.incomplete_reasons.move())
    }
    incomplete_reasons.extend(conversion_reasons.move())
    settled: memory_complete && checked.complete && owner_generic_complete && waiting.len() == 0 && incomplete_reasons.len() == 0
    complete: settled && !sema_has_error_since(diagnostics, 0)
    // A body that reads a constant not staged yet is checked again once that
    // constant lands; what this check reports past the unstaged read (a name
    // bound from its value, an obligation its callees' rows would settle) is
    // a consequence of the wait, never a finding.
    if waiting.len() > 0 -> diagnostics = [Diagnostic]{}
    reachable := sema_comptime_environment_reachable_function_keys(environment, program, call_facts)
    loop key in sema_comptime_environment_reachable_function_keys(environment, program, conversion_call_facts) {
        if !reachable.contains(key) -> reachable.push(key)
    }
    if checked.value == .Val(body) {
        if program.registration_graph == .Val(resolved_graph) {
            sema_comptime_drop_close_keys(resolved_graph, fn_delta, body.tree, module_identity, reachable)
        }
    }
    SemaComptimeFunctionResult{
        module_identity: module_identity,
        function_key: function_key,
        function: checked.value.move(),
        waiting_dependencies: waiting,
        calls: calls,
        reachable_function_keys: reachable,
        call_facts: call_facts,
        hardware_use: sema_hardware_use_snapshot(checked.hardware_use),
        name_references: name_references,
        comptime_body_sources: checked.comptime_body_sources.move(),
        compute_facts: checked.compute_facts,
        exact_int_reachable: checked.exact_int_reachable,
        copy_events: checked.copy_events.move(),
        eval_answers: checked.eval_answers.move(),
        diagnostics: diagnostics,
        complete: complete,
        incomplete_reasons: incomplete_reasons,
        failure: checked.failure,
        obligations_pending: settled && !complete && !sema_check_function_failed(diagnostics, 0, true),
        codec_demand: demand.codecs.move(),
        derive_demand: demand.derived.move(),
        conversions: conversions,
        type_delta: fn_delta.move(),
    }
}

// Read-only graph reads of a comptime function check: the environment is
// borrowed, so reading its registration graph never copies the graph (a
// writable parameter would). None when the environment carries no graph.
sema_comptime_environment_dependencies: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, references: [SemaNameReferenceFact], values: [SemaComptimeItemValue]) -> [String]? {
    if program.registration_graph == .Val(resolved_graph) {
        return Val(sema_comptime_dependencies_from_references(resolved_graph, references, values))
    }
    None
}

sema_comptime_environment_reachable_function_keys: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, call_facts: [SemaCallSiteFact]) -> [String] {
    if program.registration_graph == .Val(resolved_graph) {
        return sema_comptime_reachable_function_keys(resolved_graph, call_facts)
    }
    [String]{}
}

// The module's reasons for one incomplete function: the causes its check
// recorded, or the bare fact when it recorded none (a diagnostic explains it).
sema_check_push_function_reasons: fn(label: String, incomplete_reasons: [String], reasons: ^[String]) Never! {
    if incomplete_reasons.len() == 0 {
        reasons.push("{label}: body checking is incomplete")
        return
    }
    loop reason in incomplete_reasons -> reasons.push("{label}: {reason}")
}

// JET_KEEP_GOING (SemaRegistrationGraph.keep_going): the typed trap that
// stands in for a function whose check failed. It is `func` checked again
// with its body replaced by one `todo` (a Never value of the return type that
// lowers to an unreachable stop) and its contracts dropped, so its signature,
// owner and generic parameters are the declared ones. The trap's own reports
// are discarded: the real check's reports and reasons already name the
// failure. None when even the signature does not check.
sema_keep_going_stub: fn(func: Func, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: ^SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, host_hooks: SemaHostHookAccess?) -> SemaFunctionResult? {
    stub := func
    stub.pre = [ContractClause]{}
    stub.post = [ContractClause]{}
    stub.body = [Stmt]{Stmt.Expr{expr: Expr.Todo{span: func.span, expected_type: None, id: AST_NODE_GENERATED}}}
    stub.return_type_span = sema_keep_going_trap_return_span(func)
    discarded_diagnostics := [Diagnostic]{}
    discarded_call_facts := [SemaCallSiteFact]{}
    discarded_comptime_requests := [SemaComptimeRequest]{}
    discarded_name_references := [SemaNameReferenceFact]{}
    checked := sema_function_check(stub, sema_program_symbol_key(program, owner_id), function_kind, raw_protocol_return, environment, program, scopes, host_hooks, discarded_diagnostics, discarded_call_facts, discarded_comptime_requests, discarded_name_references)
    if !checked.complete || checked.value == None -> return None
    Val(checked)
}

// This rule reads a function with no written return type as losing the value
// of its last line (L0508). A trap's `todo` is a stop, never a value handed
// to nobody, so the trap's placeholder return position counts as written.
sema_keep_going_trap_return_span: fn(func: Func) -> Span? Never! {
    if func.return_type_span == None -> Val(func.span) else -> func.return_type_span
}

// Appends a keep-going trap with its one census row (#5566, #5662): the
// module is incomplete and one reason names the trapped function and why its
// check failed, so a compiler that lowers a trap never looks clean to the
// keep-going report, even when the failure was a post-solve recheck whose
// reports are settled away. A trap that could not be built or recorded is
// that row's outcome instead.
sema_keep_going_push_stub: fn(stub: ^^SemaFunctionResult?, label: String, cause: String, functions: ^[FnBody], reasons: ^[String]) Never! {
    checked := stub.move() ?? {
        reasons.push("{label}: its keep-going trap did not check (the declared signature fails): {cause}")
        return
    }
    if !sema_append_function(functions, checked.value.move()) {
        reasons.push("{label}: its keep-going trap could not be recorded: {cause}")
        return
    }
    reasons.push("{label}: lowered as a keep-going trap: {cause}")
}

// The name references a trapped function's check recorded (`references`
// from `start` on) are kept, keyed in the trap that stands in for its body:
// a local's id is a row of the failed check's own symbols (its body's, else
// its `failed_locals`), which the trap does not share, so the local's key is
// interned in the trap's symbols and the reference takes that id. A reader
// keys a local in the body its reference names (SemaNameReferenceFact.body),
// the function's key, which is now the trap's. A reference a nested body
// recorded names that body and keeps its id. A failed check with neither
// symbols drops its own local references, and with no trap (or a trap with
// no body) every local reference from `start` on is dropped: no body holds
// their keys. Returns `trap`.
sema_keep_going_trap_references: fn(references: ^[SemaNameReferenceFact], start: Int, failed: SemaFunctionResult, trap: ^^SemaFunctionResult?) -> SemaFunctionResult? Never! {
    stubbed := trap.move() ?? {
        sema_keep_going_drop_local_references(references, start, None)
        return None
    }
    // A trap always has its body (sema_keep_going_stub).
    if stubbed.value == None {
        sema_keep_going_drop_local_references(references, start, None)
        return Val(stubbed)
    }
    body := stubbed.value.move() ?? return None
    if failed.value == .Val(failed_body) {
        sema_keep_going_rekey_references(references, start, body.key, failed_body.tree.symbols, body.tree.symbols)
    } else if failed.failed_locals == .Val(locals) {
        sema_keep_going_rekey_references(references, start, body.key, locals, body.tree.symbols)
    } else { sema_keep_going_drop_local_references(references, start, Val(body.key)) }
    stubbed.value = Val(body)
    Val(stubbed)
}

// Drops the local references from `start` on that body `owner` recorded,
// every one when `owner` is None (sema_keep_going_trap_references).
sema_keep_going_drop_local_references: fn(references: ^[SemaNameReferenceFact], start: Int, owner: String?) Never! {
    kept := [SemaNameReferenceFact]{}
    loop index in start..<references.len() {
        dropped := symbol_is_local(references[index].symbol.id)
        if owner == .Val(key) -> dropped = dropped && references[index].body == key
        if !dropped -> kept.push(references[index].copy())
    }
    loop references.len() > start -> _ := references.pop()
    references.extend(kept)
}

// Re-keys the local references from `start` on that body `owner` recorded,
// minted in `from`, into `into` (sema_keep_going_trap_references). A local
// `from` does not hold keeps its id.
sema_keep_going_rekey_references: fn(references: ^[SemaNameReferenceFact], start: Int, owner: String, from: SymbolLocalKeys, into: ^SymbolLocalKeys) Never! {
    loop index in start..<references.len() {
        if !symbol_is_local(references[index].symbol.id) || references[index].body != owner -> next
        key: symbol_local_keys_text_at(from, references[index].symbol.id) ?? next
        references[index].symbol.id = symbol_local_keys_intern(into, key)
    }
}

// Why a trapped function's check failed: the causes it recorded, else the
// error reports it made since `start`.
sema_keep_going_cause: fn(causes: [String], diagnostics: [Diagnostic], start: Int) -> String Never! {
    if causes.len() > 0 -> return causes.join("; ")
    reported := [String]{}
    loop index in start..<diagnostics.len() {
        if diagnostics[index].severity == DIAGNOSTIC_ERROR {
            reported.push("{diagnostics[index].code} {diagnostics[index].what}")
        }
    }
    if reported.len() == 0 -> "body checking is incomplete" else -> "body checking stopped on {reported.join("; ")}"
}

// Preparation is identical on the calling thread and a body-job thread.
// The packet retains existing scalar positions; no declaration borrow escapes.
SemaMethodInput: struct {
    job: SemaBodyJob,
    memory_position: Int?,
    diagnostics: [Diagnostic],
    generic_params: [TGenericParam],
    normalized_owner_type: Type,
    function_kind: TFuncKind,
    memory_found: Bool,
    memory_complete: Bool,
    owner_generic_complete: Bool,
}

sema_check_method_input_row: fn(module_identity: ModuleID, job: SemaBodyJob, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, registered: SemaRegistrationFunction, owner_type: Type, trait_symbol: Symbol?, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaMethodInput {
    diagnostics := [Diagnostic]{}
    memory_complete := false
    if memory_position == .Val(position) {
        loop diagnostic in memory_plan.functions[position].diagnostics {
            diagnostics.push(diagnostic.copy())
        }
        memory_complete = memory_plan.functions[position].complete
    }
    method_generic_params := environment.generic_params.copy()
    owner_generic_complete := true
    normalized_owner_type := owner_type
    normalized: sema_comptime_normalize_owner(environment, program, owner_type, module_identity)
    if normalized == {
        .Val(owner) -> {
            normalized_owner_type = owner
            method_generic_params = sema_comptime_owner_generic_params(environment, program, normalized_owner_type, module_identity, diagnostics, owner_generic_complete)
        }
        .None -> {
            if owner_type == {
                .Apply(_, _) -> owner_generic_complete = false
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
            }
        }
    }
    if registered.impl_conditions.len() > 0 && program.registration_graph == .Val(graph) {
        sema_check_method_impl_conditions(graph, module_identity, registered, method_generic_params, diagnostics)
    }
    function_kind: sema_check_method_input_kind(memory_plan, memory_position, registered.declaration, normalized_owner_type, trait_symbol)
    SemaMethodInput{job: job, memory_position: memory_position, diagnostics: diagnostics.move(), generic_params: method_generic_params.move(), normalized_owner_type: normalized_owner_type.move(), function_kind: function_kind.move(), memory_found: memory_position != None, memory_complete: memory_complete, owner_generic_complete: owner_generic_complete}
}

// A conditional impl's method (`impl Pair<T: Priced>.Describe`) sees its
// owner's parameters with the impl's bounds too: in `describe`, `T` is
// `Priced`. A bound that names no trait is E0301, as on a declaration.
sema_check_method_impl_conditions: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, registered: SemaRegistrationFunction, params: ^[TGenericParam], diagnostics: ^[Diagnostic]) Never! {
    loop condition in registered.impl_conditions {
        loop index in 0..<params.len() {
            if params[index].name != condition.name -> next
            loop bound in condition.bounds {
                symbol: sema_type_graph_bound_symbol(graph, module_identity, bound) ?? next
                if sema_resolved_kind(graph, symbol) != SymbolKind.Trait {
                    diagnostics.push(sema_error("E0301", condition.name_span, "the generic bound `{bound}` is not a trait", "generic bounds refer to trait contracts", "use a trait name as the generic bound"))
                    next
                }
                id: sema_resolved_id(graph, symbol)
                known: loop existing in params[index].bounds {
                    if existing == id {
                        break true
                    }
                } ?? false
                if !known -> params[index].bounds.push(id)
            }
        }
    }
}

// Select before computing the kind: a rewritten function does not also pay
// for a discarded kind computation on the original declaration.
sema_check_method_input_kind: fn(memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, declaration: Func, owner_type: Type, trait_symbol: Symbol?) -> TFuncKind {
    if memory_position == .Val(position) {
        if memory_plan.functions[position].function == .Val(planned) {
            return sema_comptime_method_kind(planned, owner_type, trait_symbol)
        }
    }
    sema_comptime_method_kind(declaration, owner_type, trait_symbol)
}

sema_check_method_input: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaMethodInput {
    if program.registration_graph == .Val(graph) {
        if job == {
            .NominalMethod(_, owner, row) -> {
                return sema_check_method_input_row(graph.modules[module_index].module_identity, job, memory_plan, memory_position, graph.modules[module_index].nominals[owner].methods[row], graph.modules[module_index].nominals[owner].ty, None, environment, program)
            }
            .ImplMethod(_, owner, row) -> {
                return sema_check_method_input_row(graph.modules[module_index].module_identity, job, memory_plan, memory_position, graph.modules[module_index].impls[owner].methods[row], graph.modules[module_index].impls[owner].target_type, graph.modules[module_index].impls[owner].trait_symbol, environment, program)
            }
            .TopLevel(_) -> panic("a top-level function reached method preparation")
        }
    }
    panic("a registered Jet method lost its owning graph")
}

// Existing scalar body descriptors survive preparation writes; declarations do
// not escape their read-only thunks. Serial callers construct these descriptors
// for every body, not only the subset admitted to compiler-thread workers.
sema_function_check_registered: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: ^SemaScopeEnvironment, program: SemaProgramTables, module_scopes: ^SemaScopeTable, host_hooks: SemaHostHookAccess?, diagnostics: ^[Diagnostic], call_facts: ^[SemaCallSiteFact], comptime_requests: ^[SemaComptimeRequest], name_references: ^[SemaNameReferenceFact]) -> SemaFunctionResult {
    if sema_function_check_registered_unregistered(job, module_index, memory_plan, memory_position, owner_id, function_kind, environment, program, module_scopes) == .Val(unavailable) {
        return unavailable
    }
    base_generic_params: environment.generic_params.copy()
    generics := sema_function_check_registered_generics(job, module_index, memory_plan, memory_position, environment, program)
    environment.generic_params = generics.merged.copy()
    sema_function_check_registered_name(job, module_index, memory_plan, memory_position, environment, program)
    checked := sema_function_check_registered_passes(job, module_index, memory_plan, memory_position, owner_id, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
    environment.generic_params = base_generic_params.move()
    checked
}

sema_function_check_registered_unregistered: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, owner_id: SymbolID, function_kind: TFuncKind, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> SemaFunctionResult? {
    owner_key: sema_program_symbol_key(program, owner_id)
    if memory_position == .Val(position) {
        if memory_plan.functions[position].function == .Val(planned) {
            return sema_function_check_unregistered(planned, owner_key, function_kind, scopes, program)
        }
    }
    if program.registration_graph == .Val(graph) {
        return sema_function_check_unregistered_in_graph(graph, job, module_index, owner_key, function_kind, scopes, program)
    }
    Val(sema_function_check_unavailable(owner_key, "its body check has neither a memory-plan row nor a registration graph"))
}

sema_function_check_unregistered_method: fn(module_row: SemaRegistrationModule, method: SemaRegistrationFunction, owner_key: String, function_kind: TFuncKind, scopes: SemaScopeTable, program: SemaProgramTables) -> SemaFunctionResult? {
    if method.declaration.body.len() == 0 && method.item_index >= 0 && method.item_index < module_row.program.items.len() {
        method_index: method.method_index
        trait_block_index: method.trait_block_index
        if module_row.program.items[method.item_index] == {
            .Impl(item_impl) -> {
                if method_index >= 0 && method_index < item_impl.methods.len() && item_impl.methods[method_index].return_type == method.declaration.return_type && item_impl.methods[method_index].return_type_span == method.declaration.return_type_span {
                    return sema_function_check_unregistered(item_impl.methods[method_index], owner_key, function_kind, scopes, program)
                }
            }
            .Struct(item_struct) -> {
                if trait_block_index >= 0 {
                    if trait_block_index < item_struct.trait_impls.len() && method_index >= 0 && method_index < item_struct.trait_impls[trait_block_index].methods.len() && item_struct.trait_impls[trait_block_index].methods[method_index].return_type == method.declaration.return_type && item_struct.trait_impls[trait_block_index].methods[method_index].return_type_span == method.declaration.return_type_span {
                        return sema_function_check_unregistered(item_struct.trait_impls[trait_block_index].methods[method_index], owner_key, function_kind, scopes, program)
                    }
                } else if method_index >= 0 && method_index < item_struct.methods.len() && item_struct.methods[method_index].return_type == method.declaration.return_type && item_struct.methods[method_index].return_type_span == method.declaration.return_type_span {
                    return sema_function_check_unregistered(item_struct.methods[method_index], owner_key, function_kind, scopes, program)
                }
            }
            .Enum(item_enum) -> {
                if trait_block_index >= 0 {
                    if trait_block_index < item_enum.trait_impls.len() && method_index >= 0 && method_index < item_enum.trait_impls[trait_block_index].methods.len() && item_enum.trait_impls[trait_block_index].methods[method_index].return_type == method.declaration.return_type && item_enum.trait_impls[trait_block_index].methods[method_index].return_type_span == method.declaration.return_type_span {
                        return sema_function_check_unregistered(item_enum.trait_impls[trait_block_index].methods[method_index], owner_key, function_kind, scopes, program)
                    }
                } else if method_index >= 0 && method_index < item_enum.methods.len() && item_enum.methods[method_index].return_type == method.declaration.return_type && item_enum.methods[method_index].return_type_span == method.declaration.return_type_span {
                    return sema_function_check_unregistered(item_enum.methods[method_index], owner_key, function_kind, scopes, program)
                }
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
        return sema_function_check_unregistered(sema_registration_function_with_body(module_row, method), owner_key, function_kind, scopes, program)
    }
    sema_function_check_unregistered(method.declaration, owner_key, function_kind, scopes, program)
}

// The graph is a read parameter here: a declaration reached through the
// optional-payload binding of the caller was copied natively, a read
// parameter's place is borrowed (as in the helpers below).
sema_function_check_unregistered_in_graph: fn(graph: SemaRegistrationGraph, job: SemaBodyJob, module_index: Int, owner_key: String, function_kind: TFuncKind, scopes: SemaScopeTable, program: SemaProgramTables) -> SemaFunctionResult? {
    if job == {
        .TopLevel(item_index) -> {
            if graph.modules[module_index].program.items[item_index] == .Func(func) {
                return sema_function_check_unregistered(func, owner_key, function_kind, scopes, program)
            }
        }
        .NominalMethod(_, owner, row) -> return sema_function_check_unregistered_method(graph.modules[module_index], graph.modules[module_index].nominals[owner].methods[row], owner_key, function_kind, scopes, program)
        .ImplMethod(_, owner, row) -> return sema_function_check_unregistered_method(graph.modules[module_index], graph.modules[module_index].impls[owner].methods[row], owner_key, function_kind, scopes, program)
    }
    Val(sema_function_check_unavailable(owner_key, "its top-level item is not a function"))
}

// Keep the actual environment's retained function name, not a context shadow.
// The graph payload window permits only the disjoint context-field write.
sema_function_check_registered_name: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, environment: ^SemaScopeEnvironment, program: SemaProgramTables) {
    if memory_position == .Val(position) {
        if memory_plan.functions[position].function == .Val(planned) {
            environment.function_name = planned.name
            return
        }
    }
    if program.registration_graph == .Val(graph) {
        if job == {
            .TopLevel(item_index) -> {
                if graph.modules[module_index].program.items[item_index] == .Func(func) {
                    environment.function_name = func.name
                    return
                }
                panic("a selected source function lost its original item")
            }
            .NominalMethod(_, owner, row) -> {
                environment.function_name = graph.modules[module_index].nominals[owner].methods[row].declaration.name
            }
            .ImplMethod(_, owner, row) -> {
                environment.function_name = graph.modules[module_index].impls[owner].methods[row].declaration.name
            }
        }
        return
    }
    panic("a registered Jet body check lost its owning graph")
}

sema_function_check_registered_passes: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, module_scopes: ^SemaScopeTable, generics: SemaFunctionCheckGenerics, host_hooks: SemaHostHookAccess?, diagnostics: ^[Diagnostic], call_facts: ^[SemaCallSiteFact], comptime_requests: ^[SemaComptimeRequest], name_references: ^[SemaNameReferenceFact]) -> SemaFunctionResult {
    owner_key: sema_program_symbol_key(program, owner_id)
    if memory_position == .Val(position) {
        if memory_plan.functions[position].function == .Val(planned) {
            return sema_function_check_passes(planned, owner_key, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
        }
    }
    if program.registration_graph == .Val(graph) {
        return sema_function_check_passes_in_graph(graph, job, module_index, owner_key, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
    }
    panic("a registered Jet body check lost its owning graph")
}

sema_function_check_passes_method: fn(module_row: SemaRegistrationModule, method: SemaRegistrationFunction, owner_key: String, function_kind: TFuncKind, raw_protocol_return: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, module_scopes: ^SemaScopeTable, generics: SemaFunctionCheckGenerics, host_hooks: SemaHostHookAccess?, diagnostics: ^[Diagnostic], call_facts: ^[SemaCallSiteFact], comptime_requests: ^[SemaComptimeRequest], name_references: ^[SemaNameReferenceFact]) -> SemaFunctionResult {
    if method.declaration.body.len() == 0 && method.item_index >= 0 && method.item_index < module_row.program.items.len() {
        method_index: method.method_index
        trait_block_index: method.trait_block_index
        if module_row.program.items[method.item_index] == {
            .Impl(item_impl) -> {
                if method_index >= 0 && method_index < item_impl.methods.len() && item_impl.methods[method_index].return_type == method.declaration.return_type && item_impl.methods[method_index].return_type_span == method.declaration.return_type_span {
                    return sema_function_check_passes(item_impl.methods[method_index], owner_key, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
                }
            }
            .Struct(item_struct) -> {
                if trait_block_index >= 0 {
                    if trait_block_index < item_struct.trait_impls.len() && method_index >= 0 && method_index < item_struct.trait_impls[trait_block_index].methods.len() && item_struct.trait_impls[trait_block_index].methods[method_index].return_type == method.declaration.return_type && item_struct.trait_impls[trait_block_index].methods[method_index].return_type_span == method.declaration.return_type_span {
                        return sema_function_check_passes(item_struct.trait_impls[trait_block_index].methods[method_index], owner_key, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
                    }
                } else if method_index >= 0 && method_index < item_struct.methods.len() && item_struct.methods[method_index].return_type == method.declaration.return_type && item_struct.methods[method_index].return_type_span == method.declaration.return_type_span {
                    return sema_function_check_passes(item_struct.methods[method_index], owner_key, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
                }
            }
            .Enum(item_enum) -> {
                if trait_block_index >= 0 {
                    if trait_block_index < item_enum.trait_impls.len() && method_index >= 0 && method_index < item_enum.trait_impls[trait_block_index].methods.len() && item_enum.trait_impls[trait_block_index].methods[method_index].return_type == method.declaration.return_type && item_enum.trait_impls[trait_block_index].methods[method_index].return_type_span == method.declaration.return_type_span {
                        return sema_function_check_passes(item_enum.trait_impls[trait_block_index].methods[method_index], owner_key, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
                    }
                } else if method_index >= 0 && method_index < item_enum.methods.len() && item_enum.methods[method_index].return_type == method.declaration.return_type && item_enum.methods[method_index].return_type_span == method.declaration.return_type_span {
                    return sema_function_check_passes(item_enum.methods[method_index], owner_key, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
                }
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
        return sema_function_check_passes(sema_registration_function_with_body(module_row, method), owner_key, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
    }
    sema_function_check_passes(method.declaration, owner_key, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
}

sema_function_check_passes_in_graph: fn(graph: SemaRegistrationGraph, job: SemaBodyJob, module_index: Int, owner_key: String, function_kind: TFuncKind, raw_protocol_return: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, module_scopes: ^SemaScopeTable, generics: SemaFunctionCheckGenerics, host_hooks: SemaHostHookAccess?, diagnostics: ^[Diagnostic], call_facts: ^[SemaCallSiteFact], comptime_requests: ^[SemaComptimeRequest], name_references: ^[SemaNameReferenceFact]) -> SemaFunctionResult {
    if job == {
        .TopLevel(item_index) -> {
            if graph.modules[module_index].program.items[item_index] == .Func(func) {
                return sema_function_check_passes(func, owner_key, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
            }
            panic("a selected source function lost its original item")
        }
        .NominalMethod(_, owner, row) -> {
            return sema_function_check_passes_method(graph.modules[module_index], graph.modules[module_index].nominals[owner].methods[row], owner_key, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
        }
        .ImplMethod(_, owner, row) -> {
            return sema_function_check_passes_method(graph.modules[module_index], graph.modules[module_index].impls[owner].methods[row], owner_key, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
        }
    }
}

// Read only within this thunk: neither the selected declaration nor the plan's
// rewritten function escapes into an owning Func temporary. Top-level targets
// retain the original source cursor, including duplicate-name/span failures.
sema_function_check_registered_generics: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaFunctionCheckGenerics {
    if memory_position == .Val(position) {
        if memory_plan.functions[position].function == .Val(planned) {
            return sema_function_check_generics(planned, environment, program)
        }
    }
    if program.registration_graph == .Val(graph) {
        return sema_function_check_generics_in_graph(graph, job, module_index, environment, program)
    }
    panic("a registered Jet body check lost its owning graph")
}

sema_function_check_generics_in_graph: fn(graph: SemaRegistrationGraph, job: SemaBodyJob, module_index: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaFunctionCheckGenerics {
    if job == {
        .TopLevel(item_index) -> {
            if graph.modules[module_index].program.items[item_index] == .Func(func) {
                return sema_function_check_generics(func, environment, program)
            }
            panic("a selected source function lost its original item")
        }
        .NominalMethod(_, owner, row) -> {
            return sema_function_check_generics(graph.modules[module_index].nominals[owner].methods[row].declaration, environment, program)
        }
        .ImplMethod(_, owner, row) -> {
            return sema_function_check_generics(graph.modules[module_index].impls[owner].methods[row].declaration, environment, program)
        }
    }
}

// The read checker a compiler thread runs for a body that declares no generic
// parameters (sema_function_check_registered_on_thread): the existing scalar
// source selector in place of an owning planned Func input.
sema_function_check_registered_shared: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, module_scopes: ^SemaScopeTable, host_hooks: SemaHostHookAccess?, diagnostics: ^[Diagnostic], call_facts: ^[SemaCallSiteFact], comptime_requests: ^[SemaComptimeRequest], name_references: ^[SemaNameReferenceFact]) -> SemaFunctionResult {
    if sema_function_check_registered_unregistered(job, module_index, memory_plan, memory_position, owner_id, function_kind, environment, program, module_scopes) == .Val(unavailable) {
        return unavailable
    }
    generics := sema_function_check_registered_generics(job, module_index, memory_plan, memory_position, environment, program)
    sema_function_check_registered_location(job, module_index, memory_plan, memory_position, environment, program, module_scopes)
    sema_function_check_registered_passes(job, module_index, memory_plan, memory_position, owner_id, function_kind, raw_protocol_return, environment, program, module_scopes, generics, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
}

// A body check on a compiler thread. A function that declares generic
// parameters of its own, or a method its owner gives some (`generic_params`,
// SemaMethodInput.generic_params), checks as the module check does
// (sema_function_check_registered_with_generics). Any other body reads the
// shared environment as it is (sema_function_check_registered_shared).
sema_function_check_registered_on_thread: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, generic_params: [TGenericParam], environment: SemaScopeEnvironment, program: SemaProgramTables, module_scopes: ^SemaScopeTable, host_hooks: SemaHostHookAccess?, diagnostics: ^[Diagnostic], call_facts: ^[SemaCallSiteFact], comptime_requests: ^[SemaComptimeRequest], name_references: ^[SemaNameReferenceFact]) -> SemaFunctionResult {
    // copy: `previous_location` restores module_scopes.location_function after this function's
    // check overwrites it. Jet has no exchange on a field of the write-borrowed table.
    previous_location: module_scopes.location_function.copy()
    checked: if generic_params.len() == 0 && !sema_function_registered_declares_generics(job, module_index, memory_plan, memory_position, program) -> sema_function_check_registered_shared(job, module_index, memory_plan, memory_position, owner_id, function_kind, raw_protocol_return, environment, program, module_scopes, host_hooks, diagnostics, call_facts, comptime_requests, name_references) else -> sema_function_check_registered_with_generics(job, module_index, memory_plan, memory_position, owner_id, function_kind, raw_protocol_return, generic_params, environment, program, module_scopes, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
    module_scopes.location_function = previous_location
    checked
}

// A thread's check of a body with generic parameters
// (sema_function_check_registered_on_thread): a check reads those parameters
// from the environment, so it runs on this job's own environment with them
// set, which shares the shared environment's rows until the check sets its
// generic parameters and name.
sema_function_check_registered_with_generics: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, generic_params: [TGenericParam], environment: SemaScopeEnvironment, program: SemaProgramTables, module_scopes: ^SemaScopeTable, host_hooks: SemaHostHookAccess?, diagnostics: ^[Diagnostic], call_facts: ^[SemaCallSiteFact], comptime_requests: ^[SemaComptimeRequest], name_references: ^[SemaNameReferenceFact]) -> SemaFunctionResult {
    job_environment := environment
    job_environment.generic_params = generic_params
    sema_function_check_registered_location(job, module_index, memory_plan, memory_position, job_environment, program, module_scopes)
    sema_function_check_registered(job, module_index, memory_plan, memory_position, owner_id, function_kind, raw_protocol_return, job_environment, program, module_scopes, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
}

// Whether the function `job` checks declares generic parameters of its own:
// the memory plan's rewritten function when it has one, else the registered
// declaration, as sema_function_check_registered_generics reads them.
sema_function_registered_declares_generics: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, program: SemaProgramTables) -> Bool Never! {
    if memory_position == .Val(position) {
        if memory_plan.functions[position].function == .Val(planned) {
            return planned.type_params.len() != 0
        }
    }
    // Read in place through the pattern: a `??` binding copies the graph.
    if program.registration_graph == .Val(graph) {
        return if job == {
            .TopLevel(item_index) -> {
                if graph.modules[module_index].program.items[item_index] == .Func(func) {
                    return func.type_params.len() != 0
                }
                panic("a selected source function lost its original item")
            }
            .NominalMethod(_, owner, row) -> graph.modules[module_index].nominals[owner].methods[row].declaration.type_params.len() != 0
            .ImplMethod(_, owner, row) -> graph.modules[module_index].impls[owner].methods[row].declaration.type_params.len() != 0
        }
    }
    panic("a registered Jet body check lost its owning graph")
}

sema_function_check_registered_location: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable) {
    if memory_position == .Val(position) {
        if memory_plan.functions[position].function == .Val(planned) {
            scopes.location_function = Val(planned.name)
            return
        }
    }
    if program.registration_graph == .Val(graph) {
        scopes.location_function = Val(sema_registered_job_function_name(graph, job, module_index))
        return
    }
    panic("a registered Jet body check lost its owning graph")
}

// The name of the source function a registered body job checks.
sema_registered_job_function_name: fn(graph: SemaRegistrationGraph, job: SemaBodyJob, module_index: Int) -> String Never! {
    if job == {
        .TopLevel(item_index) -> {
            if graph.modules[module_index].program.items[item_index] == .Func(func) {
                return func.name
            }
            panic("a selected source function lost its original item")
        }
        .NominalMethod(_, owner, row) -> return graph.modules[module_index].nominals[owner].methods[row].declaration.name
        .ImplMethod(_, owner, row) -> return graph.modules[module_index].impls[owner].methods[row].declaration.name
    }
}

// Return only the existing identity and plan position; never a source Func.
sema_check_registered_function_id: fn(job: SemaBodyJob, module_index: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SymbolID {
    if program.registration_graph == .Val(graph) {
        if job == {
            .TopLevel(item_index) -> {
                if graph.modules[module_index].program.items[item_index] == .Func(func) {
                    return symbol_find(graph.symbols, symbol_key_text(SymbolKind.Function, module_text(graph.module_table, graph.modules[module_index].module_identity), "", func.name)) ?? panic("the top-level function `{func.name}` has no registered symbol")
                }
                panic("a selected source function lost its original item")
            }
            .NominalMethod(_, owner, row) -> return graph.modules[module_index].nominals[owner].methods[row].symbol.id
            .ImplMethod(_, owner, row) -> return graph.modules[module_index].impls[owner].methods[row].symbol.id
        }
    }
    panic("a registered Jet body check lost its owning graph")
}

sema_check_registered_memory_position: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Int? {
    if program.registration_graph == .Val(graph) {
        if job == {
            .TopLevel(item_index) -> {
                if graph.modules[module_index].program.items[item_index] == .Func(func) {
                    return sema_function_memory_position(memory_plan, graph.modules[module_index].module_identity, "", func.name, func.span)
                }
                panic("a selected source function lost its original item")
            }
            .NominalMethod(_, owner, row) -> return sema_function_memory_position(memory_plan, graph.modules[module_index].module_identity, sema_type_graph_base_name(graph.modules[module_index].nominals[owner].ty) ?? "", graph.modules[module_index].nominals[owner].methods[row].declaration.name, graph.modules[module_index].nominals[owner].methods[row].declaration.span)
            .ImplMethod(_, owner, row) -> return sema_function_memory_position(memory_plan, graph.modules[module_index].module_identity, sema_function_memory_type_owner(graph.modules[module_index].impls[owner].target_type), graph.modules[module_index].impls[owner].methods[row].declaration.name, graph.modules[module_index].impls[owner].methods[row].declaration.span)
        }
    }
    panic("a registered Jet body check lost its owning graph")
}

// The memory plan row of top-level job `job_index`: the one its checking
// thread looked up when that body is the next one `ready` pops, else looked
// up here.
sema_check_ready_memory_position: fn(ready: [SemaParallelBody], job_index: Int, job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Int? {
    last: ready.len() - 1
    if last >= 0 && ready[last].job_index == job_index && ready[last].memory_known {
        return ready[last].memory_position
    }
    sema_check_registered_memory_position(job, module_index, memory_plan, environment, program)
}

sema_check_registered_method_label: fn(job: SemaBodyJob, module_index: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> String {
    if program.registration_graph == .Val(graph) {
        if job == {
            .NominalMethod(_, owner, row) -> return "method `{type_name(graph.modules[module_index].nominals[owner].ty)}.{graph.modules[module_index].nominals[owner].methods[row].symbol.name}`"
            .ImplMethod(_, owner, row) -> return "method `{type_name(graph.modules[module_index].impls[owner].target_type)}.{graph.modules[module_index].impls[owner].methods[row].symbol.name}`"
            .TopLevel(_) -> panic("a top-level function reached method metadata")
        }
    }
    panic("a registered Jet method lost its owning graph")
}

sema_check_registered_raw_protocol_return: fn(job: SemaBodyJob, module_index: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    if program.registration_graph == .Val(graph) {
        if job == {
            .NominalMethod(_, owner, row) -> return graph.modules[module_index].nominals[owner].methods[row].raw_protocol_return
            .ImplMethod(_, owner, row) -> return graph.modules[module_index].impls[owner].methods[row].raw_protocol_return
            .TopLevel(_) -> return false
        }
    }
    panic("a registered Jet body check lost its owning graph")
}

// A `Close` or `Rollback` impl method is a raw protocol ABI (`close: fn(self)`), so its
// lowered return is the declared one (Unit when omitted) even though sema checks its body on
// the failure rail.
sema_check_protocol_unit_trait: fn(trait_name: String?) -> Bool Never! {
    name: trait_name ?? return false
    parts: name.split(".").to_list()
    leaf: parts[parts.len() - 1]
    leaf == "Close" || leaf == "Rollback"
}

sema_check_registered_protocol_unit_return: fn(job: SemaBodyJob, module_index: Int, program: SemaProgramTables) -> Bool {
    if program.registration_graph == .Val(graph) {
        if job == {
            .ImplMethod(_, owner, row) -> {
                if graph.modules[module_index].impls[owner].methods[row].declaration.return_type != None {
                    return false
                }
                return sema_check_protocol_unit_trait(graph.modules[module_index].impls[owner].declaration.trait_name)
            }
            .NominalMethod(_, owner, row) -> return sema_check_registered_nominal_protocol_unit(graph, module_index, owner, row)
            .TopLevel(_) -> return false
        }
    }
    false
}

// Read through the graph as a read parameter: binding the nominal row copied
// the whole declaration, every method included, once per checked method.
sema_check_registered_nominal_protocol_unit: fn(graph: SemaRegistrationGraph, module_index: Int, owner: Int, row: Int) -> Bool Never! {
    if graph.modules[module_index].nominals[owner].methods[row].declaration.return_type != None {
        return false
    }
    method_span: graph.modules[module_index].nominals[owner].methods[row].declaration.span
    if graph.modules[module_index].nominals[owner].source == .SourceAST(item) {
        if item == {
            .Struct(definition) -> return sema_check_protocol_unit_block(definition.trait_impls, method_span)
            .Enum(definition) -> return sema_check_protocol_unit_block(definition.trait_impls, method_span)
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    false
}

// Whether the trait block declaring the method at `span` is a raw Close or
// Rollback protocol.
sema_check_protocol_unit_block: fn(blocks: [TraitImplBlock], span: Span) -> Bool Never! {
    loop block in blocks {
        loop method in block.methods {
            if method.span == span -> return sema_check_protocol_unit_trait(Val(block.trait_name))
        }
    }
    false
}

sema_check_registered_source_span: fn(job: SemaBodyJob, module_index: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Span {
    if program.registration_graph == .Val(graph) {
        if job == {
            .NominalMethod(_, owner, row) -> return graph.modules[module_index].nominals[owner].methods[row].declaration.span
            .ImplMethod(_, owner, row) -> return graph.modules[module_index].impls[owner].methods[row].declaration.span
            .TopLevel(item_index) -> {
                if graph.modules[module_index].program.items[item_index] == .Func(func) {
                    return func.span
                }
                panic("a selected source function lost its original item")
            }
        }
    }
    panic("a registered Jet body check lost its owning graph")
}

sema_check_registered_original_method_kind: fn(job: SemaBodyJob, module_index: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TFuncKind {
    if program.registration_graph == .Val(graph) {
        if job == {
            .NominalMethod(_, owner, row) -> return sema_comptime_method_kind(graph.modules[module_index].nominals[owner].methods[row].declaration, graph.modules[module_index].nominals[owner].ty, None)
            .ImplMethod(_, owner, row) -> return sema_comptime_method_kind(graph.modules[module_index].impls[owner].methods[row].declaration, graph.modules[module_index].impls[owner].target_type, graph.modules[module_index].impls[owner].trait_symbol)
            .TopLevel(_) -> panic("a top-level function reached method metadata")
        }
    }
    panic("a registered Jet method lost its owning graph")
}

// A keep-going trap owns its replacement AST. Copy the complete signature and
// marker metadata, never the body/contracts that the trap immediately discards.
sema_keep_going_stub_source: fn(func: Func) -> Func {
    Func{
        span: func.span,
        is_pub: func.is_pub,
        is_package_pub: func.is_package_pub,
        is_comptime: func.is_comptime,
        external_type: func.external_type,
        name: func.name,
        name_span: func.name_span,
        meta: func.meta,
        type_params: func.type_params,
        head_pattern: func.head_pattern,
        params: func.params,
        return_type: func.return_type,
        return_type_span: sema_keep_going_trap_return_span(func),
        return_view_provenance: func.return_view_provenance,
        declared_return_view_provenance: func.declared_return_view_provenance,
        gc_return: func.gc_return,
        diverges: func.diverges,
        gc_scope: func.gc_scope,
        is_unsafe: func.is_unsafe,
        unsafe_reason: func.unsafe_reason,
        unsafe_span: func.unsafe_span,
        is_pure: func.is_pure,
        scrub_tag: func.scrub_tag,
        declared_effects: func.declared_effects,
        effect_via: func.effect_via,
        is_reactive: func.is_reactive,
        reactive_upgrades: func.reactive_upgrades,
        is_replayable: func.is_replayable,
        replayable_span: func.replayable_span,
        is_job: func.is_job,
        job_span: func.job_span,
        job_metadata: func.job_metadata,
        every: func.every,
        is_must_use: func.is_must_use,
        must_use_span: func.must_use_span,
        maturity: func.maturity,
        maturity_span: func.maturity_span,
        kernel: func.kernel,
        is_inline: func.is_inline,
        is_inline_always: func.is_inline_always,
        inline_span: func.inline_span,
        web_marker: func.web_marker,
        pre: [ContractClause]{},
        post: [ContractClause]{},
        inline_foreign: func.inline_foreign,
        undo: func.undo,
        markers: func.markers,
        compiler_generated: func.compiler_generated,
        body: [Stmt]{Stmt.Expr{expr: Expr.Todo{span: func.span, expected_type: None, id: AST_NODE_GENERATED}}},
    }
}

// This owns only the replacement trap AST. Original body/contracts never
// escape a read window or survive preparation of the writable checker.
sema_keep_going_registered_stub_source: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Func {
    if memory_position == .Val(position) {
        if memory_plan.functions[position].function == .Val(planned) {
            return sema_keep_going_stub_source(planned)
        }
    }
    if program.registration_graph == .Val(graph) {
        if job == {
            .TopLevel(item_index) -> {
                if graph.modules[module_index].program.items[item_index] == .Func(func) {
                    return sema_keep_going_stub_source(func)
                }
                panic("a selected source function lost its original item")
            }
            .NominalMethod(_, owner, row) -> return sema_keep_going_stub_source(graph.modules[module_index].nominals[owner].methods[row].declaration)
            .ImplMethod(_, owner, row) -> return sema_keep_going_stub_source(graph.modules[module_index].impls[owner].methods[row].declaration)
        }
    }
    panic("a registered Jet trap lost its owning graph")
}

sema_keep_going_registered_stub: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, memory_position: Int?, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: ^SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, host_hooks: SemaHostHookAccess?) -> SemaFunctionResult? {
    stub := sema_keep_going_registered_stub_source(job, module_index, memory_plan, memory_position, environment, program)
    discarded_diagnostics := [Diagnostic]{}
    discarded_call_facts := [SemaCallSiteFact]{}
    discarded_comptime_requests := [SemaComptimeRequest]{}
    discarded_name_references := [SemaNameReferenceFact]{}
    checked := sema_function_check(stub, sema_program_symbol_key(program, owner_id), function_kind, raw_protocol_return, environment, program, scopes, host_hooks, discarded_diagnostics, discarded_call_facts, discarded_comptime_requests, discarded_name_references)
    if !checked.complete || checked.value == None -> return None
    Val(checked)
}

sema_check_registered_method_stub: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, owner_id: SymbolID, function_kind: TFuncKind, raw_protocol_return: Bool, environment: ^SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, host_hooks: SemaHostHookAccess?) -> SemaFunctionResult? {
    // copy: `previous_location` restores scopes.location_function after the stub check overwrites
    // it. Jet has no exchange on a field of the write-borrowed table.
    previous_location: scopes.location_function.copy()
    sema_function_check_registered_location(job, module_index, memory_plan, None, environment, program, scopes)
    stub := sema_keep_going_registered_stub(job, module_index, memory_plan, None, owner_id, function_kind, raw_protocol_return, environment, program, scopes, host_hooks)
    scopes.location_function = previous_location
    stub
}

// Registration/header checks borrow the graph inside the existing program tables.
// The result owns precisely the same module metadata as the old checker; no
// registration module or Program temporary escapes this read-only phase.
// A declaration check's error that leaves its declaration well-formed (a
// rule it breaks, such as E0217 guard storage) or drops its fact row (a
// constant without a checked value: a skipped item) keeps the module
// complete, so its bodies are checked and their errors are reported with
// the declaration's (collect-all). So does a member type that names
// nothing: only the bodies that reach its declaration are skipped
// (sema_checked_unusable_bodies).
sema_check_registration_module_start: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, values: [SemaComptimeItemValue], scopes: ^SemaScopeTable) -> SemaGraphModuleResult {
    if program.registration_graph == .Val(graph) {
        diagnostics := [Diagnostic]{}
        settled: sema_registration_module_settled(graph, module_index)
        complete := settled
        incomplete_reasons := [String]{}
        if !settled -> incomplete_reasons.push("registration graph is incomplete")
        if !sema_registration_apply_graph_module(graph, graph.modules[module_index].module_identity, scopes, diagnostics) {
            complete = false
            incomplete_reasons.push("module scope could not be applied")
        }
        declarations := sema_registration_check_declarations_with_values(graph, module_index, diagnostics, values, program.boxed_edges)
        // The module's unknown applied rules (E0927) do not stop its check;
        // they follow its declaration errors, so a derive of a tag (E0731)
        // reports before the unknown rule on the same marker.
        if module_index < graph.unknown_rule_diagnostics.len() {
            loop diagnostic in graph.unknown_rule_diagnostics[module_index] {
                diagnostics.push(diagnostic.copy())
            }
        }
        return SemaGraphModuleResult{
            package_identity: graph.modules[module_index].package_identity,
            module_path: graph.modules[module_index].module_path,
            source_file: graph.modules[module_index].source_file,
            declarations: declarations.move(),
            module_identity: graph.modules[module_index].module_identity,
            module_name: graph.modules[module_index].module_name,
            functions: [FnBody]{},
            nominals: [SemaRegistrationNominal]{},
            constants: graph.modules[module_index].constants,
            impls: [SemaRegistrationImpl]{},
            exports: [SemaRegistrationExport]{},
            imports: [SemaRegistrationImport]{},
            foreign_providers: [SemaCheckedForeignProvider]{},
            foreign_functions: [SemaCheckedForeignFunction]{},
            call_facts: [SemaCallSiteFact]{},
            hardware_use: sema_hardware_empty_use(),
            name_references: [SemaNameReferenceFact]{},
            comptime_requests: [SemaComptimeRequest]{},
            comptime_body_sources: [SemaComptimeBodySource]{},
            compute_facts: [SemaComputeFunctionFacts]{},
            exact_int_reachable: false,
            copy_events: [SemaCopyEvent]{},
            diagnostics: diagnostics.move(),
            complete: complete,
            failure_facts: [SemaFunctionFailureFacts]{},
            incomplete_reasons: incomplete_reasons.move(),
            injected_function_keys: [String]{},
            tests: [TTestFact]{},
        }
    }
    panic("an owning registered-module pass lost its registration graph")
}

// The body key of module `module_identity`'s top-level function `name`: the
// key its body job and its Core demand row use.
sema_check_top_level_key: fn(module_identity: String, name: String) -> String Never! {
    symbol_key_text(SymbolKind.Function, module_identity, "", name)
}

// The body key of the test declared at `span` of module `module_identity`,
// which has no symbol of its own.
sema_check_test_key: fn(module_identity: String, span: Span) -> String Never! {
    "{module_identity}\ntest@{span.start}"
}

// Whether the body under `key` reaches an unusable declaration
// (sema_checked_unusable_bodies).
sema_check_unusable_body: fn(graph: SemaRegistrationGraph, key: String) -> Bool Never! {
    name_count(graph.unusable_bodies) > 1 && name_find(graph.unusable_bodies, key) != None
}

// Whether the text of `raw` at `span` names one of `names` as a whole
// identifier (sema_stmt_names_word).
sema_check_span_names_any: fn(raw: [U8], span: Span, names: [String]) -> Bool {
    if span.start < 0 || span.end > raw.len() || span.start >= span.end -> return false
    text: String.from_bytes(raw.slice(span.start, span.end)) ?? return false
    loop name in names {
        if sema_stmt_names_word(text, name) -> return true
    }
    false
}

// The bodies that reach a nominal whose struct field or enum payload type
// names nothing (sema_checked_member_types_name_nothing; E0119 reports at
// the member): the nominal's methods and impl methods, each function, method
// or test whose text names the nominal, and in turn each one whose text
// names such a function. Each would report follow-on errors of the unusable
// member, so these are skipped and recorded
// (sema_check_record_unusable_bodies); every other body is checked
// (collect-all). Core names no user type, so only user modules are read.
sema_checked_unusable_bodies: fn(graph: SemaRegistrationGraph) -> NameTable {
    bodies := name_table_sized(16)
    names := [String]{}
    loop (module_index, module_row) in graph.modules {
        if module_is_core(module_row.module_identity) -> next
        loop nominal in module_row.nominals {
            if sema_checked_member_types_name_nothing(graph, module_index, nominal) {
                names.push(nominal.symbol.name)
            }
        }
    }
    if names.len() == 0 -> return bodies
    loop module_row in graph.modules {
        if module_is_core(module_row.module_identity) -> next
        loop nominal in module_row.nominals {
            if !names.contains(nominal.symbol.name) -> next
            loop method in nominal.methods {
                _ := name_intern(bodies, symbol_table_key(graph.symbols, method.symbol.id))
            }
        }
        loop implementation in module_row.impls {
            if !names.contains(implementation.target_type_name) -> next
            loop method in implementation.methods {
                _ := name_intern(bodies, symbol_table_key(graph.symbols, method.symbol.id))
            }
        }
    }
    // A function that reaches them joins `names`, so its callers do too; a
    // method's callers reach it through a value whose type or maker they name.
    grown := true
    loop grown {
        grown = false
        loop module_row in graph.modules {
            if module_is_core(module_row.module_identity) -> next
            raw: module_row.source.bytes()
            loop item in module_row.program.items {
                if item == .Func(func) {
                    key: sema_check_top_level_key(module_text(graph.module_table, module_row.module_identity), func.name)
                    if name_find(bodies, key) == None && sema_check_span_names_any(raw, func.span, names) {
                        _ := name_intern(bodies, key)
                        names.push(func.name)
                        grown = true
                    }
                }
                if item == .Test(test) {
                    key: sema_check_test_key(module_text(graph.module_table, module_row.module_identity), test.span)
                    if name_find(bodies, key) == None && sema_check_span_names_any(raw, test.span, names) {
                        _ := name_intern(bodies, key)
                    }
                }
            }
            loop nominal in module_row.nominals {
                loop method in nominal.methods {
                    method_key: symbol_table_key(graph.symbols, method.symbol.id)
                    if name_find(bodies, method_key) == None && sema_check_span_names_any(raw, method.declaration.span, names) {
                        _ := name_intern(bodies, method_key)
                    }
                }
            }
            loop implementation in module_row.impls {
                loop method in implementation.methods {
                    method_key: symbol_table_key(graph.symbols, method.symbol.id)
                    if name_find(bodies, method_key) == None && sema_check_span_names_any(raw, method.declaration.span, names) {
                        _ := name_intern(bodies, method_key)
                    }
                }
            }
        }
    }
    bodies
}

// Records each body of module `module_index` that the check skipped
// (sema_checked_unusable_bodies), which leaves the module incomplete, and
// reports the misspelled signature types (E0119) its function check would
// have reported. A demand wave checks only the bodies it names, so it
// records none.
sema_check_record_unusable_bodies: fn(program: SemaProgramTables, module_index: Int, module_result: ^SemaGraphModuleResult) {
    if program.registration_graph == .Val(graph) {
        if name_count(graph.unusable_bodies) <= 1 || sema_core_wave_size(graph.core_wave_rows) > 0 || graph.derive_wave_rows.len() > 0 || graph.codec_wave_rows.len() > 0 {
            return
        }
        module_row: graph.modules[module_index]
        recorded := name_table_sized(16)
        loop item in module_row.program.items {
            if item == .Func(func) {
                key: sema_check_top_level_key(module_text(graph.module_table, module_row.module_identity), func.name)
                if !sema_check_unusable_body(graph, key) || name_find(recorded, key) != None -> next
                _ := name_intern(recorded, key)
                sema_type_func_unknown_names(graph, module_index, func, [String]{}, module_result.diagnostics)
                sema_check_record_skipped_body("function `{func.name}`", module_result)
            }
            if item == .Test(test) {
                if !sema_check_module_tests(graph, module_index) || test.name == None || !sema_check_unusable_body(graph, sema_check_test_key(module_text(graph.module_table, module_row.module_identity), test.span)) {
                    next
                }
                sema_check_record_skipped_body("test `{test.name ?? ""}`", module_result)
            }
        }
        loop nominal in module_row.nominals {
            owner_names: loop param in nominal.generic_params -> param.name
            loop method in nominal.methods {
                method_key: symbol_table_key(graph.symbols, method.symbol.id)
                if !sema_check_unusable_body(graph, method_key) || name_find(recorded, method_key) != None {
                    next
                }
                _ := name_intern(recorded, method_key)
                if !method.declaration.compiler_generated {
                    sema_type_func_unknown_names(graph, module_index, method.declaration, owner_names, module_result.diagnostics)
                }
                sema_check_record_skipped_body("method `{nominal.symbol.name}.{method.declaration.name}`", module_result)
            }
        }
        loop implementation in module_row.impls {
            owner_names := [String]{}
            loop nominal in module_row.nominals {
                if nominal.symbol.name == implementation.target_type_name {
                    loop param in nominal.generic_params -> owner_names.push(param.name)
                }
            }
            loop method in implementation.methods {
                method_key: symbol_table_key(graph.symbols, method.symbol.id)
                if !sema_check_unusable_body(graph, method_key) || name_find(recorded, method_key) != None {
                    next
                }
                _ := name_intern(recorded, method_key)
                if !implementation.compiler_generated {
                    sema_type_func_unknown_names(graph, module_index, method.declaration, owner_names, module_result.diagnostics)
                }
                sema_check_record_skipped_body("method `{implementation.target_type_name}.{method.declaration.name}`", module_result)
            }
        }
        return
    }
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_record_skipped_body: fn(body: String, module_result: ^SemaGraphModuleResult) {
    module_result.complete = false
    module_result.incomplete_reasons.push("{body} is skipped: it reaches a declared member type that names nothing")
}

// Module `module_index`'s result after its declaration and program checks:
// `started` when its pass made them ahead (sema_check_declaration_modules),
// else made here into `scopes`. Neither reads the entered module of
// `environment`.
sema_check_registration_module_started: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, values: [SemaComptimeItemValue], started: ^^SemaDeclarationCheck?, scopes: ^SemaScopeTable, count_work: Bool, items_scanned: ^Int) -> SemaGraphModuleResult {
    check := started.move() ?? {
        module_result := sema_check_registration_module_start(environment, program, module_index, values, scopes)
        sema_check_registration_module_program(environment, program, module_index, module_result, count_work, items_scanned)
        return module_result
    }
    if count_work -> items_scanned += check.items_scanned
    check.module_result.move()
}

// The module scope sema_check_registration_module_start applies, for a module
// whose declaration check, made ahead, already holds that application's
// diagnostics.
sema_check_registration_module_scopes: fn(program: SemaProgramTables, module_index: Int, scopes: ^SemaScopeTable) {
    if program.registration_graph == .Val(graph) {
        diagnostics := [Diagnostic]{}
        _: sema_registration_apply_graph_module(graph, graph.modules[module_index].module_identity, scopes, diagnostics)
        return
    }
    panic("an owning registered-module pass lost its registration graph")
}

// Retarget the actual module environment after declaration checking and
// before this ordinary program/header phase, exactly as in the old checker.
sema_check_registration_module_program: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, module_result: ^SemaGraphModuleResult, count_work: Bool, items_scanned: ^Int) {
    if program.registration_graph == .Val(graph) {
        test_names := name_table_sized(4)
        unsupported_forms := sema_check_unsupported_program_forms(graph.modules[module_index].program)
        if unsupported_forms.len() > 0 {
            module_result.complete = false
            loop form in unsupported_forms {
                module_result.incomplete_reasons.push("unsupported program form `{form}`")
            }
        }
        job_diagnostics := sema_check_job_names(graph.modules[module_index].program.items)
        loop diagnostic in sema_check_job_schedules(graph.modules[module_index].program.items, environment, program) {
            job_diagnostics.push(diagnostic)
        }
        if job_diagnostics.len() > 0 {
            loop diagnostic in job_diagnostics -> module_result.diagnostics.push(diagnostic)
            module_result.complete = false
            module_result.incomplete_reasons.push("invalid job names")
        }
        // `check`: structural `.member { … }` checks in every mode.
        loop diagnostic in sema_scope_members_check(graph.modules[module_index].program.tables, graph.modules[module_index].program.items, graph.modules[module_index].program.has_scope_member) {
            module_result.diagnostics.push(diagnostic)
        }
        // `infer_module_footprints`: a stated receiver footprint names stored
        // fields and covers its body (E0231).
        loop diagnostic in sema_footprint_check(graph.modules[module_index].program.tables, graph.modules[module_index].program.items) {
            module_result.diagnostics.push(diagnostic)
        }
        // Typestate declarations are bundle-wide; collect that view only for
        // a module that declares a state section or a typestate marker.
        if sema_state_items_use_typestate(graph.modules[module_index].program.items) {
            bundle_items := [Item]{}
            loop registered_module_index in 0..<graph.modules.len() {
                loop item_index in 0..<graph.modules[registered_module_index].program.items.len() {
                    bundle_items.push(graph.modules[registered_module_index].program.items[item_index])
                }
            }
            loop diagnostic in sema_state_validate_declarations(graph.modules[module_index].program.items, bundle_items) {
                module_result.diagnostics.push(diagnostic)
            }
        }
        item_index := 0
        loop item_index < graph.modules[module_index].program.items.len() {
            if count_work -> items_scanned += 1
            if graph.modules[module_index].program.items[item_index] == {
                .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .Trait(_) | .Tag(_) | .Const(_) | .UnitFamily(_) | .Impl(_) | .EffectDecl(_) -> {}
                .ExternRust(_) | .CModule(_) | .MarkerDecl(_) -> {}
                // A protocol is expanded into its handle types and transition
                // methods before registration (sema_protocols_expand); the
                // declaration itself has no checked body.
                .ProtocolDecl(_) -> {}
                // `Item.Module(_) => {}`: a role module (`env.*`, `perf.*`,
                // `dev`, `workspace`) carries no checked body; its
                // contributions are validated by their own passes.
                .Module(_) -> {}
                // A `migration` block has no checked body of its own: the
                // derived decode of its published-schema struct replays it
                // (Registration/SerdeItems.jet).
                .Migration(_) -> {}
                // A #Test name is a label string, not an item name: it shares
                // no namespace with functions or types (#6288), only with the
                // module's other test names.
                .Test(test) -> {
                    if test.name == .Val(test_name) {
                        if name_find(test_names, test_name) != None {
                            module_result.diagnostics.push(sema_defined_twice(test_name, "every test needs a unique name so failures are easy to find", test.name_span))
                        } else { _ := name_intern(test_names, test_name) }
                    }
                }
                .CodeModule(definition) -> {
                    if definition.body != None && !sema_inline_module_lowered(definition) {
                        module_result.complete = false
                        module_result.incomplete_reasons.push("inline module `{definition.name}` is not lowered")
                    }
                }
                // A `fact` declaration has no checked body: its rows are
                // compile-time-only and lowering erases them. One fact identity
                // names one declaration in the loaded bundle.
                .FactDecl(definition) -> {
                    identity: sema_fact_identity(definition)
                    if sema_fact_first_declaration(graph, module_index, item_index, identity) == .Val(first) {
                        diagnostic := sema_error("E0105", definition.name_span, "fact `{identity}` is declared twice (spans {first.span.start}..{first.span.end} and {definition.name_span.start}..{definition.name_span.end})", "one fact name must resolve to one declaration in the loaded bundle", "rename or remove one of the fact declarations")
                        diagnostic.detail = Val("first declaration `{first.name}`: module {first.module_index}, span {first.span.start}..{first.span.end}\nsecond declaration `{definition.name}`: module {module_index}, span {definition.name_span.start}..{definition.name_span.end}")
                        module_result.diagnostics.push(diagnostic)
                    }
                }
                .ErrorConv(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) -> {
                    module_result.complete = false
                    label := sema_check_item_kind_label(graph.modules[module_index].program.items[item_index])
                    module_result.incomplete_reasons.push("unsupported top-level item kind `{label}` (item {item_index})")
                }
            }
            item_index += 1
        }
        return
    }
    panic("an owning registered-module pass lost its registration graph")
}

// `fact_identity`: `name` when it is a plain string, otherwise the
// declaration's source name.
sema_fact_identity: fn(definition: FactDecl) -> String {
    loop parameter in definition.params {
        if parameter.name != "name" -> next
        value: parameter.value ?? break
        if value == .Str(parts, _, _) {
            identity := ""
            loop part in parts {
                if part == .Lit(text) -> identity = "{identity}{text}" else {
                    return definition.name.copy()
                }
            }
            return identity
        }
        break
    }
    definition.name.copy()
}

SemaFactFirstDeclaration: struct {
    module_index: Int,
    span: Span,
    name: String,
}

// The bundle's earlier declaration of fact `identity`, in module order and
// then source order, before item `item_index` of module `module_index`.
sema_fact_first_declaration: fn(graph: SemaRegistrationGraph, module_index: Int, item_index: Int, identity: String) -> SemaFactFirstDeclaration? {
    loop earlier_module in 0..module_index {
        end: if earlier_module == module_index -> item_index else -> graph.modules[earlier_module].program.items.len()
        loop earlier_item in 0..<end {
            if graph.modules[earlier_module].program.items[earlier_item] == .FactDecl(other) && sema_fact_identity(other) == identity {
                return Val(SemaFactFirstDeclaration{module_index: earlier_module, span: other.name_span, name: other.name.copy()})
            }
        }
    }
    None
}

// Finish only after the original ordered body/method/conversion phase. The
// retained graph is borrowed here; the checked module owns the foreign output.
sema_check_registration_module_foreign: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, module_result: ^SemaGraphModuleResult) {
    if program.registration_graph == .Val(graph) {
        foreign_diagnostic_count := module_result.diagnostics.len()
        foreign_provider_inputs := [SemaForeignProviderInput]{}
        has_foreign_import_target := false
        loop edge_index in 0..<graph.edges.len() {
            if graph.edges[edge_index].target_module_identity == graph.modules[module_index].module_identity && graph.edges[edge_index].foreign_binding != None {
                has_foreign_import_target = true
                break
            }
        }
        if has_foreign_import_target {
            loop provider_index in 0..<graph.foreign_providers.len() {
                if graph.foreign_providers[provider_index].module_identity == graph.modules[module_index].module_identity {
                    foreign_provider_inputs.push(graph.foreign_providers[provider_index])
                }
            }
        }
        foreign_providers := sema_checked_foreign_providers(foreign_provider_inputs, module_result.diagnostics)
        provider_index := 0
        loop provider_index < foreign_providers.len() {
            handle_index := 0
            loop handle_index < foreign_providers[provider_index].handles.len() {
                adapter_key := sema_check_foreign_handle_adapter_key(graph, graph.modules[module_index], foreign_providers[provider_index], foreign_providers[provider_index].handles[handle_index])
                if {
                    adapter_key != None -> {
                        foreign_providers[provider_index].handles[handle_index].close_function_key = adapter_key
                        foreign_providers[provider_index].handles[handle_index].close_foreign_key = None
                    }
                    foreign_providers[provider_index].handles[handle_index].close_foreign_key == None -> {
                        foreign_providers[provider_index].handles[handle_index].close_foreign_key = sema_check_registered_foreign_key(graph, graph.modules[module_index], foreign_providers[provider_index].handles[handle_index].close)
                    }
                }
                handle_index += 1
            }
            provider_index += 1
        }
        foreign_functions := sema_checked_foreign_functions(graph, graph.modules[module_index], foreign_providers, module_result.diagnostics)
        if module_result.diagnostics.len() > foreign_diagnostic_count {
            module_result.complete = false
            module_result.incomplete_reasons.push("foreign provider/function checking reported diagnostics")
        }
        module_result.foreign_providers = foreign_providers.move()
        module_result.foreign_functions = foreign_functions.move()
        sema_attach_diagnostic_source_locations(module_result.diagnostics, 0, graph.modules[module_index].source_segments)
        return
    }
    panic("an owning registered-module pass lost its registration graph")
}

// Whether module `module_index` has its named `#Test` bodies checked: every
// module's under `jet test` and `jet check`, and the root package's under a
// build or run (check_root_tests). The same body is refused, with the same
// diagnostic, by every command that reads it.
sema_check_module_tests: fn(graph: SemaRegistrationGraph, module_index: Int) -> Bool Never! {
    if graph.test_mode || graph.check_tests -> return true
    graph.check_root_tests && graph.modules[module_index].package_identity == graph.package_identity
}

// Tests stay synthetic owned AST inputs to the existing checker, never a fake
// registration index. Their property diagnostics precede their body reports.
// A test that reaches an unusable declaration (sema_checked_unusable_bodies)
// is not checked. Outside `jet test` a test is checked only, never lowered.
sema_check_registration_module_test: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, item_index: Int, scopes: SemaScopeTable, host_hooks: SemaHostHookAccess?, module_result: ^SemaGraphModuleResult) {
    if program.registration_graph == .Val(graph) {
        if graph.modules[module_index].program.items[item_index] == .Test(test) {
            if sema_check_module_tests(graph, module_index) && test.name != None && !sema_check_unusable_body(graph, sema_check_test_key(module_text(graph.module_table, graph.modules[module_index].module_identity), test.span)) {
                loop diagnostic in sema_property_param_diagnostics(graph, module_index, test) {
                    module_result.diagnostics.push(diagnostic)
                }
                checked_test := sema_check_test_function(test, environment, program, scopes, host_hooks)
                loop diagnostic in checked_test.diagnostics {
                    module_result.diagnostics.push(diagnostic)
                }
                if !graph.test_mode {
                    if checked_test.function == .Val(function) {
                        sema_liveness_member_body_uses(graph.interner, function, module_result.test_member_uses, checked_test.type_delta)
                    }
                    return
                }
                loop checked_test.type_delta.len() > 0 {
                    delta := checked_test.type_delta.pop() ?? break
                    remap: sema_merge_delta_into(program, module_result.type_delta, delta.move())
                    if remap.types.len() > 0 {
                        if ^checked_test.function == .Val(fn_body) -> body_tree_remap_types(fn_body.tree, remap)
                        sema_remap_comptime_requests_from(checked_test.comptime_requests, 0, remap)
                    }
                }
                loop fact in checked_test.call_facts -> module_result.call_facts.push(fact)
                loop request in checked_test.comptime_requests {
                    module_result.comptime_requests.push(request)
                }
                loop reference in checked_test.name_references {
                    module_result.name_references.push(reference)
                }
                loop event in checked_test.copy_events -> module_result.copy_events.push(event)
                loop answer in checked_test.eval_answers -> module_result.eval_answers.push(answer)
                module_result.exact_int_reachable = module_result.exact_int_reachable || checked_test.exact_int_reachable
                loop source in checked_test.comptime_body_sources {
                    module_result.comptime_body_sources.push(source)
                }
                if !checked_test.complete {
                    module_result.complete = false
                    if checked_test.incomplete_reasons.len() == 0 {
                        module_result.incomplete_reasons.push("test `{test.name ?? ""}`: body check is incomplete")
                    }
                    loop reason in checked_test.incomplete_reasons {
                        module_result.incomplete_reasons.push("test `{test.name ?? ""}`: {reason}")
                    }
                }
                if checked_test.function == .Val(function) {
                    module_result.injected_function_keys.push(function.key)
                    module_result.functions.push(function)
                    fact := checked_test_artifact_fact(environment.tables, environment.module_identity, module_text(graph.module_table, environment.module_identity), test, graph.modules[module_index].source)
                    // The fact outlives the borrowed graph, so it owns its copy of the fault.
                    if sema_trait_law_fault(graph.law_faults, fact.key) == .Val(row) {
                        fact.compiler_fault = Val(graph.law_faults[row].fault.copy())
                    }
                    module_result.tests.push(fact)
                }
            }
        }
        return
    }
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_registered_module_identity: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int) -> ModuleID {
    if program.registration_graph == .Val(graph) {
        return graph.modules[module_index].module_identity
    }
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_registered_module_text: fn(program: SemaProgramTables, module_identity: ModuleID) -> String {
    if program.registration_graph == .Val(graph) {
        return module_text(graph.module_table, module_identity)
    }
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_registered_keep_going: fn(environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    if program.registration_graph == .Val(graph) -> return graph.keep_going
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_registered_item_is_jet_function: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, item_index: Int) -> Bool {
    if program.registration_graph == .Val(graph) {
        // `check_fn`: an `#FFI` tier body is foreign source and a per-callable
        // `#Import(c)` has no Jet body (its C signature is checked by
        // sema_guest_check_surfaces); neither is checked as an empty value body.
        // Both stay registered. A body that reaches an unusable declaration
        // (sema_checked_unusable_bodies) is not checked either.
        if graph.modules[module_index].program.items[item_index] == .Func(func) {
            return func.inline_foreign == None && !sema_function_is_guest_import(func) && !sema_check_unusable_body(graph, sema_check_top_level_key(module_text(graph.module_table, graph.modules[module_index].module_identity), func.name))
        }
        return false
    }
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_registered_method_jobs: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, impl_rows_scanned: ^Int, count_work: Bool) -> [SemaBodyJob] {
    if program.registration_graph == .Val(graph) {
        return sema_check_method_jobs(graph, graph.modules[module_index], impl_rows_scanned, count_work)
    }
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_registered_parallel_method_jobs: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, memory_plan: SemaFunctionMemoryPlan, all_method_jobs: [SemaBodyJob], comptime_rows: SemaComptimeFunctionRows, weights: ^[Int]) -> [SemaBodyJob] {
    if program.registration_graph == .Val(graph) {
        return sema_check_parallel_method_jobs(graph, graph.modules[module_index], memory_plan, environment.generic_params, all_method_jobs, comptime_rows, weights)
    }
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_registered_top_level_name: fn(module_index: Int, item_index: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> String {
    if program.registration_graph == .Val(graph) {
        if graph.modules[module_index].program.items[item_index] == .Func(func) -> return func.name
    }
    panic("a selected source function lost its original item")
}

// The caller selects ordinary Jet functions in source order. All graph and
// plan metadata reads finish before a writable checker or trap is entered.
sema_check_registration_top_level: fn(module_index: Int, item_index: Int, memory_plan: SemaFunctionMemoryPlan, environment: ^SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, return_view_rows: ^[U32:Int], ready: ^[SemaParallelBody], ready_deltas: ^[InternerDelta?], host_hooks: SemaHostHookAccess?, comptime_functions: [SemaComptimeFunctionResult], comptime_rows: SemaComptimeFunctionRows, result: ^SemaGraphModuleResult, prelude_demands: ^[Int:[SemaPreludeConversionDemand]], scopes_changed: ^Bool, keep_going: Bool, pending_obligations: Bool, trace_functions: Bool, trace_sink: CompilerTraceSink?, item_count: Int, count_work: Bool, functions_checked: ^Int) {
    job: SemaBodyJob.TopLevel{item_index: item_index}
    function_name: sema_check_registered_top_level_name(module_index, item_index, environment, program)
    owner_id: sema_check_registered_function_id(job, module_index, environment, program)
    // The Core library's check captures every Core function check it makes
    // (CoreBodies.jet), so it checks a Core function its comptime already
    // checked again here rather than reuse that check, which no capture saw.
    cached := if sema_core_body_capturing(program, module_index) -> SemaComptimeFunctionResult?{None} else -> sema_comptime_find_checked_function(comptime_functions, comptime_rows, environment.module_identity, sema_program_symbol_key(program, owner_id))
    if cached == {
        .Val(checked_function) -> {
            if checked_function.function == .Val(function) {
                if sema_function_publish_return_views(scopes, return_view_rows, function, owner_id) {
                    scopes_changed = true
                }
            }
            result.exact_int_reachable = result.exact_int_reachable || checked_function.exact_int_reachable
            sema_hardware_use_merge(result.hardware_use, sema_hardware_use_snapshot(checked_function.hardware_use))
            loop event in checked_function.copy_events -> result.copy_events.push(event)
            loop answer in checked_function.eval_answers -> result.eval_answers.push(answer)
            if !sema_comptime_append_checked_function(checked_function, result.functions, result.call_facts, result.comptime_requests, result.name_references) {
                result.complete = false
                if keep_going {
                    scopes.type_delta = [InternerDelta]{}
                    stub := sema_keep_going_registered_stub(job, module_index, memory_plan, None, owner_id, TFuncKind.TopLevel, false, environment, program, scopes, host_hooks)
                    if ^stub == .Val(trapped) -> sema_drain_scope_delta(program, result.type_delta, scopes, trapped.value, result.comptime_requests, result.comptime_requests.len()) else -> scopes.type_delta = [InternerDelta]{}
                    sema_keep_going_push_stub(stub, "function `{function_name}`", "comptime-checked body is incomplete", result.functions, result.incomplete_reasons)
                } else {
                    result.incomplete_reasons.push("function `{function_name}`: comptime-checked body is incomplete")
                }
            }
            loop source in checked_function.comptime_body_sources {
                result.comptime_body_sources.push(source)
            }
            result.compute_facts.push(checked_function.compute_facts)
            // #3708: the reused body joins the bundle solve like one checked
            // here: its failure row, and the obligations the solve settles.
            if checked_function.failure == .Val(facts) -> result.failure_facts.push(facts)
            sema_comptime_push_obligations(checked_function, result.diagnostics)
            sema_comptime_replay_demand(checked_function, program)
        }
        .None -> {
            function_call_facts := [SemaCallSiteFact]{}
            function_comptime_requests := [SemaComptimeRequest]{}
            function_name_references := [SemaNameReferenceFact]{}
            function_diagnostic_start: result.diagnostics.len()
            memory_position: sema_check_ready_memory_position(ready, item_index, job, module_index, memory_plan, environment, program)
            if memory_position == {
                .Val(position) -> {
                    loop diagnostic in memory_plan.functions[position].diagnostics {
                        result.diagnostics.push(diagnostic.copy())
                    }
                    if !memory_plan.functions[position].complete {
                        result.complete = false
                        result.incomplete_reasons.push("function `{function_name}`: memory plan is incomplete")
                    }
                }
                .None -> {
                    result.complete = false
                    result.incomplete_reasons.push("function `{function_name}`: no memory plan row")
                }
            }
            if trace_functions {
                if trace_sink == .Val(sink) {
                    sink.begin("sema.function", function_name, item_index, item_count)
                }
            }
            check_diagnostic_start: result.diagnostics.len()
            capturing: sema_core_body_capturing(program, module_index)
            if capturing -> sema_core_body_capture_open(program)
            scopes.type_delta = [InternerDelta]{}
            checked := sema_core_body_loaded(program, host_hooks, module_index, owner_id, scopes.type_delta, result.diagnostics, function_call_facts, function_comptime_requests, function_name_references) ?? sema_check_module_function(ready, ready_deltas, item_index, scopes_changed, job, module_index, memory_plan, memory_position, owner_id, TFuncKind.TopLevel, false, environment, program, scopes, host_hooks, result.diagnostics, function_call_facts, function_comptime_requests, function_name_references, count_work, functions_checked)
            if trace_functions {
                if trace_sink == .Val(sink) -> sink.end("sema.function", 1)
            }
            if capturing {
                checked = sema_core_body_capture(program, owner_id, checked, scopes.type_delta, result.diagnostics, check_diagnostic_start, function_call_facts, function_comptime_requests, function_name_references, result.core_bodies)
            }
            sema_drain_scope_delta(program, result.type_delta, scopes, checked.value, function_comptime_requests, 0)
            sema_hardware_use_merge(result.hardware_use, sema_hardware_use_snapshot(checked.hardware_use))
            result.comptime_body_sources.extend(checked.comptime_body_sources.move())
            result.compute_facts.push(checked.compute_facts)
            if checked.failure == .Val(facts) -> result.failure_facts.push(facts.copy())
            if checked.value == .Val(function) {
                if sema_function_publish_return_views(scopes, return_view_rows, function, owner_id) {
                    scopes_changed = true
                }
            }
            result.exact_int_reachable = result.exact_int_reachable || checked.exact_int_reachable
            result.copy_events.extend(checked.copy_events.move())
            result.eval_answers.extend(checked.eval_answers.move())
            result.call_facts.extend(function_call_facts)
            result.comptime_requests.extend(function_comptime_requests)
            // A trapped function's references are keyed in its trap before
            // they join the module's (sema_keep_going_trap_references).
            if !checked.complete {
                result.complete = false
                if keep_going {
                    cause: sema_keep_going_cause(checked.incomplete_reasons, result.diagnostics, function_diagnostic_start)
                    scopes.type_delta = [InternerDelta]{}
                    trap := sema_keep_going_trap_references(function_name_references, 0, checked, sema_keep_going_registered_stub(job, module_index, memory_plan, memory_position, owner_id, TFuncKind.TopLevel, false, environment, program, scopes, host_hooks))
                    if ^trap == .Val(trapped) -> sema_drain_scope_delta(program, result.type_delta, scopes, trapped.value, result.comptime_requests, result.comptime_requests.len()) else -> scopes.type_delta = [InternerDelta]{}
                    result.name_references.extend(function_name_references)
                    sema_keep_going_push_stub(trap, "function `{function_name}`", cause, result.functions, result.incomplete_reasons)
                } else {
                    result.name_references.extend(function_name_references)
                    sema_check_push_function_reasons("function `{function_name}`", checked.incomplete_reasons, result.incomplete_reasons)
                }
            } else if keep_going && sema_check_function_failed(result.diagnostics, function_diagnostic_start, pending_obligations) {
                cause: sema_keep_going_cause([String]{}, result.diagnostics, function_diagnostic_start)
                scopes.type_delta = [InternerDelta]{}
                trap := sema_keep_going_trap_references(function_name_references, 0, checked, sema_keep_going_registered_stub(job, module_index, memory_plan, memory_position, owner_id, TFuncKind.TopLevel, false, environment, program, scopes, host_hooks))
                if ^trap == .Val(trapped) -> sema_drain_scope_delta(program, result.type_delta, scopes, trapped.value, result.comptime_requests, result.comptime_requests.len()) else -> scopes.type_delta = [InternerDelta]{}
                result.name_references.extend(function_name_references)
                sema_keep_going_push_stub(trap, "function `{function_name}`", cause, result.functions, result.incomplete_reasons)
                result.complete = false
            } else {
                result.name_references.extend(function_name_references)
                position: result.functions.len()
                if sema_append_function(result.functions, checked.value.move()) {
                    if checked.prelude_demands == .Val(demands) {
                        prelude_demands[position] = demands
                    }
                } else {
                    result.complete = false
                    result.incomplete_reasons.push("function `{function_name}`: checked function could not be recorded")
                }
            }
        }
    }
}

sema_check_registration_method: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, ready: ^[SemaParallelBody], ready_deltas: ^[InternerDelta?], ordinal: Int, scopes: ^SemaScopeTable, environment: ^SemaScopeEnvironment, program: SemaProgramTables, host_hooks: SemaHostHookAccess?, comptime_functions: [SemaComptimeFunctionResult], comptime_rows: SemaComptimeFunctionRows, diagnostics: ^[Diagnostic], functions: ^[FnBody], prelude_demands: ^[Int:[SemaPreludeConversionDemand]], type_delta: ^[InternerDelta], call_facts: ^[SemaCallSiteFact], hardware_use: ^TargetHardwareUse, comptime_requests: ^[SemaComptimeRequest], name_references: ^[SemaNameReferenceFact], comptime_body_sources: ^[SemaComptimeBodySource], compute_facts: ^[SemaComputeFunctionFacts], failure_facts: ^[SemaFunctionFailureFacts], exact_int_reachable: ^Bool, copy_events: ^[SemaCopyEvent], eval_answers: ^[SemaEvalProbeAnswer], core_bodies: ^[SemaCoreBody], reasons: ^[String], keep_going: Bool, pending_obligations: Bool) -> Bool {
    label: sema_check_registered_method_label(job, module_index, environment, program)
    owner_id: sema_check_registered_function_id(job, module_index, environment, program)
    raw_protocol_return: sema_check_registered_raw_protocol_return(job, module_index, environment, program)
    // As a top-level function's (sema_check_registration_top_level).
    cached := if sema_core_body_capturing(program, module_index) -> SemaComptimeFunctionResult?{None} else -> sema_comptime_find_checked_function(comptime_functions, comptime_rows, environment.module_identity, sema_program_symbol_key(program, owner_id))
    if cached == {
        .Val(checked_function) -> {
            exact_int_reachable = exact_int_reachable || checked_function.exact_int_reachable
            sema_hardware_use_merge(hardware_use, sema_hardware_use_snapshot(checked_function.hardware_use))
            loop event in checked_function.copy_events -> copy_events.push(event)
            loop answer in checked_function.eval_answers -> eval_answers.push(answer)
            loop source in checked_function.comptime_body_sources {
                comptime_body_sources.push(source)
            }
            compute_facts.push(checked_function.compute_facts)
            // The reused method body joins the bundle failure solve like one
            // checked here, as a reused top-level body does.
            if checked_function.failure == .Val(facts) -> failure_facts.push(facts)
            sema_comptime_push_obligations(checked_function, diagnostics)
            sema_comptime_replay_demand(checked_function, program)
            if sema_comptime_append_checked_function(checked_function, functions, call_facts, comptime_requests, name_references) {
                return true
            }
            if keep_going {
                original_kind: sema_check_registered_original_method_kind(job, module_index, environment, program)
                scopes.type_delta = [InternerDelta]{}
                stub := sema_check_registered_method_stub(job, module_index, memory_plan, owner_id, original_kind, raw_protocol_return, environment, program, scopes, host_hooks)
                if ^stub == .Val(trapped) -> sema_drain_scope_delta(program, type_delta, scopes, trapped.value, comptime_requests, comptime_requests.len()) else -> scopes.type_delta = [InternerDelta]{}
                sema_keep_going_push_stub(stub, label, "comptime-checked body is incomplete", functions, reasons)
            } else { reasons.push("{label}: comptime-checked body is incomplete") }
            return false
        }
        .None -> {}
    }
    function_diagnostic_start: diagnostics.len()
    capturing: sema_core_body_capturing(program, module_index)
    if capturing -> sema_core_body_capture_open(program)
    scopes.type_delta = [InternerDelta]{}
    prepared := sema_check_take_body(ready, ready_deltas, ordinal, scopes.type_delta)
    if prepared == .Val(body) {
        if body.wanted_hooks {
            prepared = None
            scopes.type_delta = [InternerDelta]{}
        }
    }
    input := SemaMethodInput?{None}
    checked_result := SemaFunctionResult?{None}
    function_call_facts := [SemaCallSiteFact]{}
    function_comptime_requests := [SemaComptimeRequest]{}
    function_name_references := [SemaNameReferenceFact]{}
    if prepared != None {
        packet := prepared.move() ?? panic("a prepared method packet disappeared")
        prepared = None
        sema_check_body_demand_replay(program, packet)
        taken_input := packet.method_input.move()
        packet.method_input = None
        input = taken_input.move()
        taken_checked := packet.checked.move()
        packet.checked = None
        checked_result = taken_checked.move()
        diagnostics.extend(packet.diagnostics.move())
        function_call_facts = packet.call_facts.move()
        function_comptime_requests = packet.comptime_requests.move()
        function_name_references = packet.name_references.move()
    }
    if checked_result == None {
        checked_result = sema_core_body_loaded(program, host_hooks, module_index, owner_id, scopes.type_delta, diagnostics, function_call_facts, function_comptime_requests, function_name_references)
    }
    owned_input := input.move() ?? sema_check_method_input(job, module_index, memory_plan, sema_check_registered_memory_position(job, module_index, memory_plan, environment, program), environment, program)
    // Prepared diagnostics already include preparation, in the same order.
    if checked_result == None {
        loop diagnostic in owned_input.diagnostics -> diagnostics.push(diagnostic)
    }
    if !owned_input.memory_found {
        declaration_span: sema_check_registered_source_span(job, module_index, environment, program)
        reasons.push("{label}: the memory plan has no row for its declaration at offset {declaration_span.start}")
    }
    base_generic_params: environment.generic_params.copy()
    environment.generic_params = owned_input.generic_params.copy()
    // copy: `previous_location` restores scopes.location_function after this method's check
    // overwrites it. Jet has no exchange on a field of the write-borrowed table.
    previous_location: scopes.location_function.copy()
    sema_function_check_registered_location(job, module_index, memory_plan, owned_input.memory_position, environment, program, scopes)
    if checked_result != None -> sema_function_check_registered_name(job, module_index, memory_plan, owned_input.memory_position, environment, program)
    checked := checked_result.move() ?? sema_function_check_registered(job, module_index, memory_plan, owned_input.memory_position, owner_id, owned_input.function_kind, raw_protocol_return, environment, program, scopes, host_hooks, diagnostics, function_call_facts, function_comptime_requests, function_name_references)
    // A captured method packet's diagnostics hold its preparation's, as a
    // prepared one's do.
    if capturing {
        checked = sema_core_body_capture(program, owner_id, checked, scopes.type_delta, diagnostics, function_diagnostic_start, function_call_facts, function_comptime_requests, function_name_references, core_bodies)
    }
    sema_drain_scope_delta(program, type_delta, scopes, checked.value, function_comptime_requests, 0)
    memory_complete: owned_input.memory_complete
    owner_generic_complete: owned_input.owner_generic_complete
    // A failed check under keep-going always lowers as its trap (or records
    // why the trap could not be built), never as the failed body.
    check_failed: keep_going && sema_check_function_failed(diagnostics, function_diagnostic_start, pending_obligations)
    keep_going_stub := SemaFunctionResult?{None}
    if keep_going && (!memory_complete || !owner_generic_complete || !checked.complete || check_failed) {
        scopes.type_delta = [InternerDelta]{}
        keep_going_stub = sema_keep_going_trap_references(function_name_references, 0, checked, sema_keep_going_registered_stub(job, module_index, memory_plan, owned_input.memory_position, owner_id, owned_input.function_kind, raw_protocol_return, environment, program, scopes, host_hooks))
        if ^keep_going_stub == .Val(trapped) -> sema_drain_scope_delta(program, type_delta, scopes, trapped.value, function_comptime_requests, function_comptime_requests.len()) else -> scopes.type_delta = [InternerDelta]{}
    }
    scopes.location_function = previous_location
    environment.generic_params = base_generic_params.move()
    exact_int_reachable = exact_int_reachable || checked.exact_int_reachable
    sema_hardware_use_merge(hardware_use, sema_hardware_use_snapshot(checked.hardware_use))
    copy_events.extend(checked.copy_events.move())
    eval_answers.extend(checked.eval_answers.move())
    call_facts.extend(function_call_facts)
    comptime_requests.extend(function_comptime_requests)
    comptime_body_sources.extend(checked.comptime_body_sources.move())
    compute_facts.push(checked.compute_facts)
    // A method's failure row joins the bundle failure solve, which infers
    // the contract of an inherent method as it does a top-level function's.
    if checked.failure == .Val(facts) -> failure_facts.push(facts.copy())
    name_references.extend(function_name_references)
    if !memory_complete || !owner_generic_complete {
        causes := [String]{}
        if !memory_complete && owned_input.memory_found -> causes.push("memory plan is incomplete")
        if !owner_generic_complete {
            causes.push("generic owner `{type_name(owned_input.normalized_owner_type)}` could not be resolved to a registered nominal")
        }
        if keep_going {
            sema_keep_going_push_stub(keep_going_stub.move(), label, sema_keep_going_cause(causes, diagnostics, function_diagnostic_start), functions, reasons)
        } else {
            loop cause in causes -> reasons.push("{label}: {cause}")
        }
        return false
    }
    if !checked.complete {
        if keep_going {
            sema_keep_going_push_stub(keep_going_stub.move(), label, sema_keep_going_cause(checked.incomplete_reasons, diagnostics, function_diagnostic_start), functions, reasons)
        } else { sema_check_push_function_reasons(label, checked.incomplete_reasons, reasons) }
        return false
    }
    if check_failed {
        sema_keep_going_push_stub(keep_going_stub.move(), label, sema_keep_going_cause([String]{}, diagnostics, function_diagnostic_start), functions, reasons)
        return false
    }
    if checked.value != None && sema_check_registered_protocol_unit_return(job, module_index, program) {
        taken := checked.value.move()
        checked.value = None
        rewritten := taken.move() ?? panic("a checked Close method lost its lowered function")
        raw_return: Type.Named{name: "Unit"}
        rewritten.ret = Val(raw_return)
        failure: sema_failure_carrier(Val(raw_return))
        rewritten.failure_carrier = failure
        checked.value = Val(rewritten.move())
    }
    position: functions.len()
    if sema_append_function(functions, checked.value.move()) {
        if checked.prelude_demands == .Val(demands) -> prelude_demands[position] = demands
        return true
    }
    reasons.push("{label}: checked function could not be recorded")
    false
}

sema_check_registered_tfunc_key: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, name: String) -> String? {
    loop function_index in 0..<module_row.functions.len() {
        if module_row.functions[function_index].declaration.name == name {
            return Val(symbol_table_key(graph.symbols, module_row.functions[function_index].symbol.id))
        }
    }
    None
}

sema_check_registered_foreign_key: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, name: String) -> String? {
    loop function_index in 0..<module_row.foreign_functions.len() {
        if module_row.foreign_functions[function_index].declaration.name == name {
            return Val(symbol_table_key(graph.symbols, module_row.foreign_functions[function_index].symbol.id))
        }
    }
    None
}

sema_check_foreign_handle_adapter_key: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, provider: SemaCheckedForeignProvider, handle: SemaCheckedForeignHandle) -> String? {
    loop adapter in provider.close_adapters {
        if adapter.raw_function == handle.close && (adapter.handle_type == handle.typedef_name || adapter.handle_type == handle.jet_name) {
            return sema_check_registered_tfunc_key(graph, module_row, adapter.adapter_function)
        }
    }
    None
}

// The Program-level forms the module checker does not support yet, by name.
// Fenced statements are formatter metadata: sema checks their ordinary
// expanded statements in `items`. A script body is not one of them:
// finalization rejects it with E0621. `#HTML(page)`
// (html_path) is not one either: it names the web output's companion page,
// which a native build has no use for. Nor is a web ceiling
// (`#Target(Wasm|JS)`): the web partition (WebPartition.jet)
// and the OS-axis check (OSTarget.jet) read it.
sema_check_unsupported_program_forms: fn(program: Program) -> [String] Never! {
    forms := [String]{}
    if sema_function_memory_has_unsupported_policies(program.policy_declarations) {
        forms.push("memory policy")
    }
    if sema_policy_has_unsupported_applications(program) -> forms.push("applied rules")
    forms
}

sema_check_item_kind_label: fn(item: Item) -> String Never! {
    if item == {
        .Func(_) -> "fn"
        .Struct(_) -> "struct"
        .Enum(_) -> "enum"
        .Distinct(_) -> "distinct"
        .TypeAlias(_) -> "type alias"
        .UnitFamily(_) -> "unit family"
        .Trait(_) -> "trait"
        .Tag(_) -> "tag"
        .EffectDecl(_) -> "effect"
        .Impl(_) -> "impl"
        .Const(_) -> "const"
        .Test(_) -> "test"
        .ExternRust(_) -> "extern rust"
        .Module(value) -> "{value.name}: module"
        .CModule(_) -> "c module"
        .CodeModule(value) -> "{value.name}: module"
        .ErrorConv(_) -> "error conversion"
        .Migration(_) -> "migration"
        .ProtocolDecl(_) -> "protocol"
        .TemplateLoop(_) -> "template loop"
        .GenericModule(_) -> "generic module"
        .ModuleAlias(_) -> "module alias"
        .MarkerDecl(_) -> "marker"
        .FactDecl(_) -> "fact"
    }
}

// The environment of a pass over `program`, whose tables keep the pass's one
// graph and its checked-type indexes; `fixed_length_write_params` were
// computed from that graph. The pass reads fields of every registered struct,
// not only its checked types, so it never skips the computed-field lookup.
sema_check_pass_environment: fn(program: ^SemaProgramTables, fixed_length_write_params: ^^[String], body_values: ^^SemaComptimeBodyValues) -> SemaScopeEnvironment Never! {
    program.has_computed_fields = true
    environment := sema_scope_environment_init(module_none(), "", "", "", SemaSourceOrigin.Snapshot, [SemaSourceSegment]{}, [SemaScopeDeclaration]{})
    // Every module's functions, so the length-preserving fact covers calls
    // into other modules, bundle-wide.
    environment.fixed_length_write_params = fixed_length_write_params.move()
    environment.comptime_body_publication = body_values.move()
    environment.move()
}

// The graph facts a body pass reads besides the graph and checked types. Each
// reads only the graph, so a large program computes them side by side on
// compiler threads (sema_pass_facts). Jobs are numbered lightest first;
// threads claim them heaviest first. The first SEMA_PASS_FACT_TABLES jobs are
// the ones a pass environment needs (the declaration pass's); a body pass
// needs all SEMA_PASS_FACT_JOBS.
SEMA_PASS_FACT_BOXED_EDGES: 0

SEMA_PASS_FACT_COPY: 1

SEMA_PASS_FACT_FIXED_LENGTH: 2

SEMA_PASS_FACT_MEMORY_PLAN: 3

SEMA_PASS_FACT_TABLES: 3

SEMA_PASS_FACT_JOBS: 4

SemaPassFacts: struct {
    memory_plan: SemaFunctionMemoryPlan,
    fixed_length_write_params: [String],
    boxed_edges: [U32:[String]],
    copy_facts: SemaCopyFactsTable,
}

// One computed fact: job `job`'s field of `facts` is filled.
SemaPassFact: struct {
    job: Int,
    facts: SemaPassFacts,
}

sema_pass_facts_new: fn() -> SemaPassFacts Never! {
    SemaPassFacts{memory_plan: sema_function_memory_plan_new(), fixed_length_write_params: [String]{}, boxed_edges: [U32:[String]]{}, copy_facts: sema_copy_facts_table_empty()}
}

// Fills the fields of jobs 0..<`jobs` of `facts` from `graph`, on threads
// when the program is large enough, and returns the graph. Each fact is the
// same as computed serially, for any thread count.
sema_pass_facts: fn(graph: ^^SemaRegistrationGraph, threads: CompilerThreads, jobs: Int, facts: ^SemaPassFacts) -> SemaRegistrationGraph? Never! {
    workers: compiler_threads_admit(threads, jobs, graph.modules.len(), SEMA_FINALIZE_SIDE_MIN_MODULES_PER_THREAD, 0, 0)
    owned: SemaRegistrationGraph?{Val(graph.move())}
    if workers <= 1 {
        loop job in 0..<jobs -> sema_pass_fact_run(job, owned, threads, facts)
        return owned
    }
    queue: SemaFinalizeCoreQueue{next: 0}
    sema_pass_facts_claimers(owned, queue, threads, jobs, 0, workers, facts)
    owned
}

// Computes job `job`'s fact of `graph` into its field of `facts`. The graph
// is read in place through the `.Val(…)` pattern on the parameter. The
// memory plan's walk runs on as many threads as `threads` admits.
sema_pass_fact_run: fn(job: Int, graph: SemaRegistrationGraph?, threads: CompilerThreads, facts: ^SemaPassFacts) Never! {
    if graph == .Val(registered) {
        if {
            job == SEMA_PASS_FACT_BOXED_EDGES -> {
                facts.boxed_edges = sema_checked_program_boxed_edges(registered)
            }
            job == SEMA_PASS_FACT_COPY -> { facts.copy_facts = sema_copy_facts_table_threads(graph, threads) }
            job == SEMA_PASS_FACT_FIXED_LENGTH -> {
                facts.fixed_length_write_params = sema_fixed_length_write_params_in_graph_threads(registered, threads)
            }
            else -> {
                facts.memory_plan = sema_function_memory_plan_from_graph(registered, threads)
            }
        }
    }
}

// Moves a thread's computed fact into its field of `facts`.
sema_pass_fact_join: fn(fact: ^^SemaPassFact, facts: ^SemaPassFacts) Never! {
    owned := fact.move()
    if {
        owned.job == SEMA_PASS_FACT_BOXED_EDGES -> {
            facts.boxed_edges = owned.facts.boxed_edges.move()
        }
        owned.job == SEMA_PASS_FACT_COPY -> { facts.copy_facts = owned.facts.copy_facts.move() }
        owned.job == SEMA_PASS_FACT_FIXED_LENGTH -> {
            facts.fixed_length_write_params = owned.facts.fixed_length_write_params.move()
        }
        else -> { facts.memory_plan = owned.facts.memory_plan.move() }
    }
}

// Runs pass-fact threads `from..<workers`, one task each, over jobs
// 0..<`jobs`, and joins every fact a thread computed into `facts`. Every
// thread reads the graph and claims from the queue in place: neither is
// written or moved before the group joins.
sema_pass_facts_claimers: fn(graph: SemaRegistrationGraph?, queue: SemaFinalizeCoreQueue, threads: CompilerThreads, jobs: Int, from: Int, workers: Int, facts: ^SemaPassFacts) Never! {
    if from >= workers {
        return
    }
    task.group sema_pass_facts_threads {
        head: task sema_pass_facts_claimed(graph, queue, threads, jobs)
        sema_pass_facts_claimers(graph, queue, threads, jobs, from + 1, workers, facts)
        claimed := compiler_threads_joined(head)
        loop claimed.len() > 0 {
            done := claimed.pop() ?? break
            sema_pass_fact_join(done, facts)
        }
    }
}

// One thread: computes the facts of jobs 0..<`jobs` it claims, heaviest
// (last job) first.
sema_pass_facts_claimed: fn(graph: SemaRegistrationGraph?, queue: SemaFinalizeCoreQueue, threads: CompilerThreads, jobs: Int) -> [SemaPassFact] Never! {
    claimed := [SemaPassFact]{}
    loop {
        rank: sema_finalize_core_claim(queue)
        if rank >= jobs -> break
        job: jobs - 1 - rank
        fact := SemaPassFact{job: job, facts: sema_pass_facts_new()}
        sema_pass_fact_run(job, graph, threads, fact.facts)
        claimed.push(fact)
    }
    claimed
}

// Resolve callable view summaries before the real body pass so declaration
// order cannot affect a public owner contract. Only functions whose declared
// return type structurally contains a view are summary jobs, checked in name
// order, then the module's methods with such a return type
// (sema_check_view_summary_method_jobs); each check discards its diagnostics
// and other products and publishes only the return-view provenance into
// `scopes`. A round that reproduces the previous round's per-job provenance is
// the fixed point; jobs + 1 rounds is the upper bound, and no jobs means no
// summary checks. `view_jobs`: the jobs a declaration check found ahead
// (SemaDeclarationCheck), else None. Returns how many function jobs it checked,
// which the trace counter `summary_functions_checked` reports.
sema_check_view_summaries: fn(environment: ^SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, module_index: Int, host_hooks: SemaHostHookAccess?, memory_plan: SemaFunctionMemoryPlan, comptime_functions: [SemaComptimeFunctionResult], comptime_rows: SemaComptimeFunctionRows, view_jobs: [Int]?, counter_phase: String, trace_sink: CompilerTraceSink?) -> Int {
    summary_jobs: if view_jobs == .Val(found) -> found.copy() else -> sema_check_sorted_view_summary_jobs(environment, program, module_index)
    method_jobs: sema_check_view_summary_method_jobs(program, module_index)
    job_count: summary_jobs.len() + method_jobs.len()
    summary_functions_checked := 0
    return_view_rows := [U32:Int]{}
    previous_round := [ViewProvenanceMap?]{}
    summary_round := 0
    loop job_count > 0 && summary_round <= job_count {
        round := [ViewProvenanceMap?]{}
        loop item_index in summary_jobs {
            job: SemaBodyJob.TopLevel{item_index: item_index}
            provenance := ViewProvenanceMap?{None}
            owner_id: sema_check_registered_function_id(job, module_index, environment, program)
            cached := sema_comptime_find_checked_function(comptime_functions, comptime_rows, environment.module_identity, sema_program_symbol_key(program, owner_id))
            if cached == {
                .Val(checked_function) -> {
                    if checked_function.function == .Val(function) {
                        _ := sema_function_publish_return_views(scopes, return_view_rows, function, owner_id)
                        provenance = function.return_view_provenance
                    }
                }
                .None -> {
                    summary_diagnostics := [Diagnostic]{}
                    summary_calls := [SemaCallSiteFact]{}
                    summary_comptime_requests := [SemaComptimeRequest]{}
                    summary_name_references := [SemaNameReferenceFact]{}
                    memory_position: sema_check_registered_memory_position(job, module_index, memory_plan, environment, program)
                    summary_functions_checked += 1
                    checked := sema_function_check_registered(job, module_index, memory_plan, memory_position, owner_id, TFuncKind.TopLevel, false, environment, program, scopes, host_hooks, summary_diagnostics, summary_calls, summary_comptime_requests, summary_name_references)
                    if checked.value == .Val(function) {
                        _ := sema_function_publish_return_views(scopes, return_view_rows, function, owner_id)
                        provenance = function.return_view_provenance
                    }
                }
            }
            round.push(provenance)
        }
        loop job in method_jobs {
            round.push(sema_check_view_summary_method(job, module_index, memory_plan, environment, program, scopes, host_hooks))
        }
        if summary_round > 0 && sema_check_view_rounds_equal(previous_round, round) -> break
        previous_round = round
        summary_round += 1
    }
    scopes.type_delta = [InternerDelta]{}
    if trace_sink == .Val(sink) {
        sink.progress("counters.{counter_phase}.items_scanned", sema_check_registered_module_item_count(environment, program, module_index), -1)
        sink.progress("counters.{counter_phase}.summary_functions_checked", summary_functions_checked, -1)
    }
    summary_functions_checked
}

// The module's methods whose declared return type structurally contains a
// view, in method body order (sema_check_method_jobs). A method call reads
// the summary from `scopes.method_return_views`.
sema_check_view_summary_method_jobs: fn(program: SemaProgramTables, module_index: Int) -> [SemaBodyJob] {
    if program.registration_graph == .Val(graph) {
        jobs := [SemaBodyJob]{}
        scanned := 0
        loop job in sema_check_method_jobs(graph, graph.modules[module_index], scanned, false) {
            if job == {
                .NominalMethod(ordinal, owner, row) -> {
                    if sema_check_view_summary_method_selected(graph, module_index, graph.modules[module_index].nominals[owner].methods[row].declaration) {
                        jobs.push(SemaBodyJob.NominalMethod{ordinal: ordinal, nominal_index: owner, method_index: row})
                    }
                }
                .ImplMethod(ordinal, owner, row) -> {
                    if sema_check_view_summary_method_selected(graph, module_index, graph.modules[module_index].impls[owner].methods[row].declaration) {
                        jobs.push(SemaBodyJob.ImplMethod{ordinal: ordinal, implementation_index: owner, method_index: row})
                    }
                }
                .TopLevel(_) -> {}
            }
        }
        return jobs.move()
    }
    panic("an owning registered-module pass lost its registration graph")
}

sema_check_view_summary_method_selected: fn(graph: SemaRegistrationGraph, module_index: Int, declaration: Func) -> Bool {
    if declaration.compiler_generated || declaration.inline_foreign != None || sema_function_is_guest_import(declaration) {
        return false
    }
    return_type: declaration.return_type ?? return false
    seen := [U32:Bool]{}
    sema_check_type_contains_view(graph, graph.modules[module_index].module_identity, return_type, seen)
}

// One summary check of method `job`, set up as the method body pass sets it
// up: the owner's generic parameters and the panic location stay installed
// only for the check. Its diagnostics and other products are discarded; the
// inferred provenance is published under the method's registered symbol key,
// the key its call candidate carries.
sema_check_view_summary_method: fn(job: SemaBodyJob, module_index: Int, memory_plan: SemaFunctionMemoryPlan, environment: ^SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, host_hooks: SemaHostHookAccess?) -> ViewProvenanceMap? {
    memory_position: sema_check_registered_memory_position(job, module_index, memory_plan, environment, program)
    input: sema_check_method_input(job, module_index, memory_plan, memory_position, environment, program)
    owner_id: sema_check_registered_function_id(job, module_index, environment, program)
    raw_protocol_return: sema_check_registered_raw_protocol_return(job, module_index, environment, program)
    base_generic_params: environment.generic_params.copy()
    environment.generic_params = input.generic_params.move()
    // copy: `previous_location` restores scopes.location_function after the check overwrites it.
    previous_location: scopes.location_function.copy()
    sema_function_check_registered_location(job, module_index, memory_plan, input.memory_position, environment, program, scopes)
    summary_diagnostics := [Diagnostic]{}
    summary_calls := [SemaCallSiteFact]{}
    summary_comptime_requests := [SemaComptimeRequest]{}
    summary_name_references := [SemaNameReferenceFact]{}
    checked := sema_function_check_registered(job, module_index, memory_plan, input.memory_position, owner_id, input.function_kind, raw_protocol_return, environment, program, scopes, host_hooks, summary_diagnostics, summary_calls, summary_comptime_requests, summary_name_references)
    scopes.location_function = previous_location
    environment.generic_params = base_generic_params.move()
    provenance := ViewProvenanceMap?{None}
    if checked.value == .Val(function) -> provenance = function.return_view_provenance
    if provenance == .Val(map) -> scopes.method_return_views[owner_id.id] = map
    provenance
}

sema_check_registered_module_item_count: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int) -> Int {
    if program.registration_graph == .Val(graph) {
        return graph.modules[module_index].program.items.len()
    }
    panic("an owning registered-module pass lost its registration graph")
}

sema_host_hook_unwant: fn(wanted: Shared<SemaHostHookWanted>) {
    permit: wanted.guard_edit()
    permit.value.wanted = false
}

sema_host_hook_was_wanted: fn(wanted: Shared<SemaHostHookWanted>) -> Bool {
    permit: wanted.guard_read()
    permit.value.wanted
}

// `environment` carries module-local source facts while `program` retains
// the pass's one graph and checked-type owner. Module retargeting borrows
// that graph in place and only replaces the selected scope facts.
// `comptime_rows` is sema_comptime_checked_function_rows(comptime_functions).
// `pending_obligations`: the bundle failure solve has not settled the failure
// obligations yet (`sema_check_function_failed`).
// `host_hooks` reach the host callbacks for every body check. `prepared` is
// the module's parallel body pass (sema_check_bodies_parallel), or none: its
// post-summary scope replaces the view-summary rounds, and its checked bodies
// stand in for checking the same functions here while they still apply
// (sema_check_module_function).
// Read-only declaration/body thunks close before either owner is moved.
sema_check_registration_module: fn(owned_environment: ^^SemaScopeEnvironment, owned_program: ^^SemaProgramTables, host_hooks: SemaHostHookAccess?, owned_memory_plan: ^^SemaFunctionMemoryPlan, module_index: Int, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], comptime_rows: SemaComptimeFunctionRows, check_bodies: Bool, pending_obligations: Bool, prepared: ^^SemaPreparedBodies, scheduling: SemaMethodScheduling?, counter_phase: String, trace_sink: CompilerTraceSink?) -> SemaOwnedModuleCheck {
    environment := owned_environment.move()
    program := owned_program.move()
    memory_plan := owned_memory_plan.move()
    threads := CompilerThreads?{None}
    if scheduling == .Val(schedule) -> threads = Val(schedule.threads)
    run := sema_check_registration_module_head(environment, program, host_hooks, memory_plan, module_index, values, comptime_functions, comptime_rows, check_bodies, pending_obligations, prepared, threads, counter_phase, trace_sink)
    if run.wave_workers > 1 {
        if scheduling == .Val(schedule) {
            // All metadata read windows have ended before either owner
            // moves into its existing shared slot. Recover after every join.
            lent := run.scopes.move()
            run.scopes = sema_scope_init(module_none())
            sema_check_shared_fill(schedule.shared_state, environment, program, memory_plan)
            run.method_ready = sema_check_bodies_parallel(schedule.shared_state, module_index, lent, run.wave_jobs, run.wave_weights, run.wave_workers, trace_sink)
            environment = sema_check_shared_take_environment(schedule.shared_state)
            program = sema_check_shared_take_program(schedule.shared_state)
            memory_plan = sema_check_shared_take_memory_plan(schedule.shared_state)
            run.scopes = run.method_ready.scopes.pop() ?? panic("the method wave lost its module scope")
        }
    }
    module_result := sema_check_registration_module_tail(run, environment, program, host_hooks, memory_plan, module_index, comptime_functions, comptime_rows, pending_obligations, counter_phase, trace_sink)
    SemaOwnedModuleCheck{module_result: module_result.move(), environment: environment.move(), program: program.move(), memory_plan: memory_plan.move()}
}

// sema_check_registration_module on a body stream's lead thread
// (sema_check_body_stream_lead): the program tables and memory plan stay with
// the stream's threads and are read in place, so the module starts no method
// wave of its own; a method body the stream did not check is checked here.
sema_check_registration_module_lent: fn(environment: ^SemaScopeEnvironment, program: SemaProgramTables, host_hooks: SemaHostHookAccess?, memory_plan: SemaFunctionMemoryPlan, module_index: Int, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], comptime_rows: SemaComptimeFunctionRows, pending_obligations: Bool, prepared: ^^SemaPreparedBodies, counter_phase: String, trace_sink: CompilerTraceSink?) -> SemaGraphModuleResult {
    run := sema_check_registration_module_head(environment, program, host_hooks, memory_plan, module_index, values, comptime_functions, comptime_rows, true, pending_obligations, prepared, None, counter_phase, trace_sink)
    sema_check_registration_module_tail(run, environment, program, host_hooks, memory_plan, module_index, comptime_functions, comptime_rows, pending_obligations, counter_phase, trace_sink)
}

// A module check between its top-level bodies and its method bodies: what
// the method half (sema_check_registration_module_tail) reads. `wave_jobs`
// are the parallel method jobs the head admitted `wave_workers` threads for
// (none, and one worker, when it admitted no method wave).
SemaModuleCheckRun: struct {
    module_result: SemaGraphModuleResult,
    scopes: SemaScopeTable,
    method_ready: SemaPreparedBodies,
    all_method_jobs: [SemaBodyJob],
    prelude_demands: [Int:[SemaPreludeConversionDemand]],
    module_identity: ModuleID,
    keep_going: Bool,
    check_bodies: Bool,
    count_work: Bool,
    items_scanned: Int,
    functions_checked: Int,
    impl_rows_scanned: Int,
    wave_jobs: [SemaBodyJob],
    wave_weights: [Int],
    wave_workers: Int,
}

// The module check's declarations and top-level bodies, and the method
// jobs of its method half. With `threads` it admits a method wave for the
// parallel method jobs the body stream did not check.
sema_check_registration_module_head: fn(environment: ^SemaScopeEnvironment, program: SemaProgramTables, host_hooks: SemaHostHookAccess?, memory_plan: SemaFunctionMemoryPlan, module_index: Int, values: [SemaComptimeItemValue], comptime_functions: [SemaComptimeFunctionResult], comptime_rows: SemaComptimeFunctionRows, check_bodies: Bool, pending_obligations: Bool, prepared: ^^SemaPreparedBodies, threads: CompilerThreads?, counter_phase: String, trace_sink: CompilerTraceSink?) -> SemaModuleCheckRun {
    ready := prepared.move()
    module_identity: sema_check_registered_module_identity(environment, program, module_index)
    keep_going: sema_check_registered_keep_going(environment, program)
    item_count: sema_check_registered_module_item_count(environment, program, module_index)
    scopes := sema_scope_init(module_identity)
    count_work: if trace_sink == .Val(_) -> true else -> false
    items_scanned := 0
    started := ready.started.move()
    ready.started = None
    precomputed: started != None
    // The view summary jobs the declaration check found ahead, if any.
    view_jobs: if started == .Val(check) -> check.view_summary_jobs.copy() else -> [Int]?{None}
    module_result := sema_check_registration_module_started(environment, program, module_index, values, started, scopes, count_work, items_scanned)
    // The original declaration/header boundary: do not substitute the comptime
    // module entry, which deliberately clears real else-arm source facts.
    // copy: a handle copy (Shared facts plus length and frontier ints): the module's context reads
    // a frozen prefix while environment.comptime_body_publication keeps advancing.
    body_values := environment.comptime_body_publication.copy()
    sema_scope_environment_enter_module(environment, program, module_index, body_values)
    functions_checked := 0
    if count_work -> functions_checked = ready.bodies.len()
    impl_rows_scanned := 0
    all_method_jobs := [SemaBodyJob]{}
    method_ready := sema_check_prepared_none()
    // The prelude conversion demands of each body a compiler thread
    // walked, by its position in module_result.functions.
    prelude_demands := [Int:[SemaPreludeConversionDemand]]{}
    wave_jobs := [SemaBodyJob]{}
    wave_weights := [Int]{}
    wave_workers := 1
    if check_bodies {
        if ready.scopes.len() > 0 -> scopes = ready.scopes.pop() ?? sema_scope_init(module_identity) else {
            if precomputed -> sema_check_registration_module_scopes(program, module_index, scopes)
            _ := sema_check_view_summaries(environment, program, scopes, module_index, host_hooks, memory_plan, comptime_functions, comptime_rows, view_jobs, counter_phase, trace_sink)
        }
        // The static-product markers bind their signatures in module scope.
        sema_marker_rules_check_static_sites(environment, program, module_index, scopes, module_result.diagnostics)
        // A distinct type's forwarded traits must exist on its base.
        sema_derive_check_distinct_forwards(environment, program, module_index, module_result.diagnostics)
        scopes_changed := false
        return_view_rows := [U32:Int]{}
        trace_functions := false
        if trace_sink == .Val(sink) -> trace_functions = sink.functions()
        item_index := 0
        loop item_index < item_count {
            if count_work -> items_scanned += 1
            // The trace throttles progress by time, and each report reads the
            // clock and thread id from /proc: report every 64th item and the last.
            if item_index %% SEMA_CHECK_PROGRESS_STRIDE == 0 || item_index + 1 == item_count {
                if trace_sink == .Val(sink) -> sink.progress("sema.bodies", item_index, item_count)
            }
            if sema_check_registered_item_is_jet_function(environment, program, module_index, item_index) {
                if !sema_check_registered_item_deferred(environment, program, module_index, item_index) {
                    sema_check_registration_top_level(module_index, item_index, memory_plan, environment, program, scopes, return_view_rows, ready.bodies, ready.body_deltas, host_hooks, comptime_functions, comptime_rows, module_result, prelude_demands, scopes_changed, keep_going, pending_obligations, trace_functions, trace_sink, item_count, count_work, functions_checked)
                }
            } else {
                sema_check_registration_module_test(environment, program, module_index, item_index, scopes, host_hooks, module_result)
            }
            item_index += 1
        }
        all_method_jobs = sema_check_registered_method_jobs(environment, program, module_index, impl_rows_scanned, count_work)
        if ready.methods_prepared && !scopes_changed {
            // The body stream checked the module's parallel method jobs against
            // the post-summary scope, which the top-level checks left as it was.
            method_ready.bodies = ready.methods.move()
            method_ready.body_deltas = ready.method_deltas.move()
            ready.methods = [SemaParallelBody]{}
            ready.method_deltas = [InternerDelta?]{}
        } else if threads == .Val(pool) {
            weights := [Int]{}
            jobs := sema_check_registered_parallel_method_jobs(environment, program, module_index, memory_plan, all_method_jobs, comptime_rows, weights)
            work := 0
            loop weight in weights -> work += weight
            workers := 1
            if !trace_functions {
                workers = compiler_threads_admit(pool, jobs.len(), work, SEMA_BODY_MIN_BYTES_PER_THREAD, scopes.bindings.len() * SEMA_BODY_SCOPE_BYTES_PER_BINDING, 0)
            }
            if workers > 1 {
                wave_jobs = jobs.move()
                wave_weights = weights.move()
                wave_workers = workers
            }
        }
    }
    SemaModuleCheckRun{
        module_result: module_result.move(),
        scopes: scopes.move(),
        method_ready: method_ready.move(),
        all_method_jobs: all_method_jobs.move(),
        prelude_demands: prelude_demands.move(),
        module_identity: module_identity,
        keep_going: keep_going,
        check_bodies: check_bodies,
        count_work: count_work,
        items_scanned: items_scanned,
        functions_checked: functions_checked,
        impl_rows_scanned: impl_rows_scanned,
        wave_jobs: wave_jobs.move(),
        wave_weights: wave_weights.move(),
        wave_workers: wave_workers,
    }
}

// The module check's method bodies, its prelude error conversions and its
// foreign items, after sema_check_registration_module_head.
sema_check_registration_module_tail: fn(owned_run: ^^SemaModuleCheckRun, environment: ^SemaScopeEnvironment, program: SemaProgramTables, host_hooks: SemaHostHookAccess?, memory_plan: SemaFunctionMemoryPlan, module_index: Int, comptime_functions: [SemaComptimeFunctionResult], comptime_rows: SemaComptimeFunctionRows, pending_obligations: Bool, counter_phase: String, trace_sink: CompilerTraceSink?) -> SemaGraphModuleResult {
    run := owned_run.move()
    module_result := run.module_result.move()
    scopes := run.scopes.move()
    method_ready := run.method_ready.move()
    all_method_jobs := run.all_method_jobs.move()
    prelude_demands := run.prelude_demands.move()
    method_jobs := 0
    // The rows of the name references and call facts that generated bodies
    // record: a derived method keeps its template's spans and an injected
    // conversion its Prelude text's, so neither indexes this module's source.
    generated_references := [Span]{}
    generated_calls := [Span]{}
    if run.check_bodies {
        loop job in all_method_jobs {
            if run.count_work -> method_jobs += 1
            generated: sema_check_generated_method_author_span(job, module_index, environment, program) != None || sema_check_generated_codec_method(job, module_index, program)
            references_from: module_result.name_references.len()
            calls_from: module_result.call_facts.len()
            if !sema_check_apply_method_job(module_index, memory_plan, job, method_ready.bodies, method_ready.body_deltas, scopes, environment, program, host_hooks, comptime_functions, comptime_rows, module_result.diagnostics, module_result.functions, prelude_demands, module_result.type_delta, module_result.call_facts, module_result.hardware_use, module_result.comptime_requests, module_result.name_references, module_result.comptime_body_sources, module_result.compute_facts, module_result.failure_facts, module_result.exact_int_reachable, module_result.copy_events, module_result.eval_answers, module_result.core_bodies, module_result.incomplete_reasons, run.keep_going, pending_obligations) {
                module_result.complete = false
            }
            if generated {
                generated_references.push(Span{start: references_from, end: module_result.name_references.len()})
                generated_calls.push(Span{start: calls_from, end: module_result.call_facts.len()})
            }
        }
        injected_from := module_result.functions.len()
        references_from: module_result.name_references.len()
        calls_from: module_result.call_facts.len()
        if !sema_inject_prelude_error_conversions(sema_check_registered_module_text(program, run.module_identity), environment, program, scopes, host_hooks, module_result.functions, prelude_demands, module_result.type_delta, module_result.diagnostics, module_result.call_facts, module_result.comptime_requests, module_result.name_references, module_result.incomplete_reasons, run.keep_going) {
            module_result.complete = false
        }
        generated_references.push(Span{start: references_from, end: module_result.name_references.len()})
        generated_calls.push(Span{start: calls_from, end: module_result.call_facts.len()})
        loop index in injected_from..<module_result.functions.len() {
            module_result.injected_function_keys.push(module_result.functions[index].key)
        }
        sema_check_record_unusable_bodies(program, module_index, module_result)
    }
    sema_check_registration_module_foreign(environment, program, module_index, module_result)
    sema_check_soft_public_uses(program, module_index, generated_references, generated_calls, module_result)
    sema_check_module_value_consumers(program, module_index, generated_references, module_result)
    if trace_sink == .Val(sink) {
        sink.progress("counters.{counter_phase}.items_scanned", run.items_scanned, -1)
        sink.progress("counters.{counter_phase}.functions_checked", run.functions_checked, -1)
        sink.progress("counters.{counter_phase}.method_jobs", method_jobs, -1)
        sink.progress("counters.{counter_phase}.impl_rows_scanned", run.impl_rows_scanned, -1)
    }
    module_result.move()
}

// A public `_name` is soft-public: a use outside its declaring module is
// allowed with one warning per occurrence (L0601), on the spelling the use
// site writes, so a re-export under a plain name does not warn and one
// under an underscore name does. Core's own modules are vetted internals.
// Only module `module_index`'s own text is read: the rows in
// `generated_references` and `generated_calls` (sorted, disjoint row ranges)
// carry spans into other text and are skipped.
sema_check_soft_public_uses: fn(program: SemaProgramTables, module_index: Int, generated_references: [Span], generated_calls: [Span], module_result: ^SemaGraphModuleResult) {
    if program.registration_graph == .Val(graph) {
        module_identity: module_text(graph.module_table, graph.modules[module_index].module_identity)
        if module_is_core(graph.modules[module_index].module_identity) {
            return
        }
        raw: graph.modules[module_index].source.bytes()
        seen := [Int:Bool]{}
        skipped := 0
        loop (index, reference) in module_result.name_references {
            loop skipped < generated_references.len() && generated_references[skipped].end <= index {
                skipped += 1
            }
            if skipped < generated_references.len() && index >= generated_references[skipped].start {
                next
            }
            owner: reference.symbol.module_identity
            if module_is_none(owner) || owner == graph.modules[module_index].module_identity -> next
            leaf: sema_soft_public_written_leaf(raw, reference.span) ?? next
            sema_soft_public_warn(leaf, seen, module_result.diagnostics)
        }
        // A call's callee is a call fact, not a name reference.
        skipped = 0
        loop (index, call) in module_result.call_facts {
            loop skipped < generated_calls.len() && generated_calls[skipped].end <= index {
                skipped += 1
            }
            if skipped < generated_calls.len() && index >= generated_calls[skipped].start -> next
            callee: call.callee ?? next
            if symbol_is_local(callee) -> next
            leaf: sema_soft_public_written_leaf(raw, call.span) ?? next
            callee_key: sema_program_symbol_key(program, callee)
            // The callee's module identity follows its key's kind
            // (symbol_key_text); a builtin, which no module registers, has
            // none.
            path: callee_key.split_once(":") ?? next
            if path.after.starts_with("{module_identity}.") || sema_registration_callable_row(graph, callee_key) == None {
                next
            }
            sema_soft_public_warn(leaf, seen, module_result.diagnostics)
        }
        sema_check_soft_public_signatures(graph.modules[module_index], raw, seen, module_result.diagnostics)
    }
}

// One consumer's read of a module value, from a body of this module.
SemaModuleValueRead: struct {
    key: SymbolID,
    name: String,
    consumer: String,
    span: Span,
}

// A module value has one type and one value for every consumer. When one
// consumer reads it as the value it is and another needs something else (a
// String where the value is an Int, or a field the value lacks), the
// disagreement belongs to the value: the consumer's error moves to the
// value's name, and its labels name both consumers. A value whose consumers
// all fail, or that one consumer alone reads, keeps the error at the read.
sema_check_module_value_consumers: fn(program: SemaProgramTables, module_index: Int, generated_references: [Span], module_result: ^SemaGraphModuleResult) {
    graph: program.registration_graph ?? return
    has_error: loop diagnostic in module_result.diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR {
            break true
        }
    } ?? false
    if !has_error {
        return
    }
    module_identity: graph.modules[module_index].module_identity
    raw: graph.modules[module_index].source.bytes()
    segments: graph.modules[module_index].source_segments
    candidates := [SemaModuleValueRead]{}
    skipped := 0
    loop (index, reference) in module_result.name_references {
        loop skipped < generated_references.len() && generated_references[skipped].end <= index {
            skipped += 1
        }
        if skipped < generated_references.len() && index >= generated_references[skipped].start {
            next
        }
        if reference.kind != Val(SymbolKind.Constant) -> next
        owner: reference.symbol.module_identity
        if !module_is_none(owner) && owner != module_identity -> next
        candidates.push(SemaModuleValueRead{key: reference.symbol.id, name: reference.symbol.name.copy(), consumer: "", span: reference.span})
    }
    // A read's consumer is looked up only when some error may fail a read.
    if candidates.len() < 2 || !sema_module_value_reads_failed(candidates, raw, module_result.diagnostics) {
        return
    }
    bodies: sema_module_value_bodies(graph.modules[module_index].declarations)
    reads := [SemaModuleValueRead]{}
    loop candidate in candidates {
        consumer: sema_module_value_consumer(bodies, candidate.span) ?? next
        reads.push(SemaModuleValueRead{key: candidate.key, name: candidate.name.copy(), consumer: consumer, span: candidate.span})
    }
    if reads.len() < 2 {
        return
    }
    moved := [{position: Int, diagnostic: Diagnostic}]{}
    loop (position, diagnostic) in module_result.diagnostics {
        failed: sema_module_value_failed_read(reads, raw, segments, diagnostic) ?? next
        read: reads[failed]
        agreeing: reads[sema_module_value_agreeing_read(reads, module_result.diagnostics, raw, segments, read) ?? next]
        constant: sema_module_value_constant(graph.modules[module_index].constants, read.key) ?? next
        shown: if constant.ty == .Val(ty) -> " as {sema_module_value_type_show(ty)}" else -> ""
        updated := diagnostic.copy()
        // The value's name is located afresh: it may sit in another file of
        // this module than the read.
        updated.span = Val(constant.declaration.name_span)
        updated.source_path = None
        updated.source_offset = None
        updated.source_start = None
        updated.what = "`{read.consumer}` and `{agreeing.consumer}` disagree about `{read.name}`: {diagnostic.what}"
        updated.labels.push(DiagnosticLabel{span: read.span, message: "`{read.consumer}` reads `{read.name}` here"})
        updated.labels.push(DiagnosticLabel{span: agreeing.span, message: "`{agreeing.consumer}` reads it here{shown}"})
        moved.push({position: position, diagnostic: sema_diagnostic_with_source_location(updated, segments)})
    }
    loop row in moved.move() -> module_result.diagnostics[row.position] = row.diagnostic
}

// Another consumer's read of `read`'s value that no error fails.
sema_module_value_agreeing_read: fn(reads: [SemaModuleValueRead], diagnostics: [Diagnostic], raw: [U8], segments: [SemaSourceSegment], read: SemaModuleValueRead) -> Int? {
    loop (index, other) in reads {
        if other.key == read.key && other.consumer != read.consumer && sema_module_value_read_agrees(diagnostics, reads, raw, segments, other) {
            return Val(index)
        }
    }
    None
}

// A module value's type as its reader wrote it: a registered nominal type
// carries its module's key, and the reader wrote only its name.
sema_module_value_type_show: fn(ty: Type) -> String Never! {
    leaf: sema_type_nominal_leaf(ty)
    if leaf != "" -> return "`{leaf}`"
    sema_type_show(ty)
}

sema_module_value_constant: fn(constants: [SemaRegistrationConstant], key: SymbolID) -> SemaRegistrationConstant? {
    loop row in constants {
        if row.symbol.id == key -> return Val(row.copy())
    }
    None
}

// A function or method of a module's declarations and its text's span.
SemaModuleValueBody: struct {
    name: String,
    span: Span,
}

// The functions and methods of `declarations`, in declaration order.
sema_module_value_bodies: fn(declarations: [Item]) -> [SemaModuleValueBody] {
    bodies := [SemaModuleValueBody]{}
    loop item in declarations {
        if item == {
            .Func(function) -> {
                bodies.push(SemaModuleValueBody{name: function.name.copy(), span: function.span})
            }
            .Impl(implementation) -> {
                loop method in implementation.methods {
                    bodies.push(SemaModuleValueBody{name: method.name.copy(), span: method.span})
                }
            }
            .Struct(definition) -> {
                loop method in definition.methods {
                    bodies.push(SemaModuleValueBody{name: method.name.copy(), span: method.span})
                }
            }
            .Enum(definition) -> {
                loop method in definition.methods {
                    bodies.push(SemaModuleValueBody{name: method.name.copy(), span: method.span})
                }
            }
            .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    bodies
}

// The first function or method of `bodies` whose text holds `span`.
sema_module_value_consumer: fn(bodies: [SemaModuleValueBody], span: Span) -> String? {
    loop body in bodies {
        if body.span.start <= span.start && span.end <= body.span.end {
            return Val(body.name.copy())
        }
    }
    None
}

// Whether an error of `diagnostics` may fail one of `reads`: one that starts
// at a read, or just past the `.` after one (sema_module_value_failed_read,
// before its location checks). Most modules' errors fail none.
sema_module_value_reads_failed: fn(reads: [SemaModuleValueRead], raw: [U8], diagnostics: [Diagnostic]) -> Bool {
    starts := [Int:Bool]{}
    loop read in reads {
        starts[read.span.start] = true
        if read.span.end < raw.len() && (Int{raw[read.span.end]}) == 46 {
            starts[read.span.end + 1] = true
        }
    }
    loop diagnostic in diagnostics {
        if diagnostic.severity != DIAGNOSTIC_ERROR -> next
        at: diagnostic.span ?? next
        if starts.has_key(at.start) -> return true
    }
    false
}

// The row in `reads` that an error of this module's text fails: an error at
// the read itself (the value is the wrong type there), or at the member
// written right after the read's `.` (the value lacks that field).
sema_module_value_failed_read: fn(reads: [SemaModuleValueRead], raw: [U8], segments: [SemaSourceSegment], diagnostic: Diagnostic) -> Int? {
    if diagnostic.severity != DIAGNOSTIC_ERROR -> return None
    at: diagnostic.span ?? return None
    // Only this module's own written text: a diagnostic located where its
    // segment maps, not one on generated text or another file.
    location: sema_source_location_at(segments, at) ?? return None
    if location.origin == SemaSourceOrigin.CompilerGenerated || diagnostic.source_path != Val(location.source_path) || diagnostic.source_offset != Val(location.aggregate_start) {
        return None
    }
    loop (index, read) in reads {
        if at.start == read.span.start && at.end == read.span.end -> return Val(index)
        if at.start == read.span.end + 1 && read.span.end < raw.len() && (Int{raw[read.span.end]}) == 46 {
            return Val(index)
        }
    }
    None
}

sema_module_value_read_agrees: fn(diagnostics: [Diagnostic], reads: [SemaModuleValueRead], raw: [U8], segments: [SemaSourceSegment], read: SemaModuleValueRead) -> Bool {
    loop diagnostic in diagnostics {
        failed: sema_module_value_failed_read(reads, raw, segments, diagnostic) ?? next
        if reads[failed].span.start == read.span.start -> return false
    }
    true
}

sema_soft_public_warn: fn(leaf: {start: Int, name: String}, seen: ^[Int:Bool], diagnostics: ^[Diagnostic]) {
    if classify_identifier(leaf.name) != IdentifierClass.SoftPublic || seen.has_key(leaf.start) {
        return
    }
    seen[leaf.start] = true
    diagnostics.push(sema_lint("L0601", Span{start: leaf.start, end: leaf.start + leaf.name.count_bytes()}, "`{leaf.name}` is a soft-public API", "A leading underscore allows outside use but carries no compatibility promise across minor releases.", "Use a public name without a leading underscore when callers need a stable API."))
}

// The soft-public type names one module's signatures write: in a parameter
// or return type, or a generic bound. A qualified `alias._Cell` is always
// outside; an unqualified `_Shape` is outside unless the module declares it
// (a local declaration wins over an imported one) or the function's own
// type parameters name it.
sema_check_soft_public_signatures: fn(source_module: SemaRegistrationModule, raw: [U8], seen: ^[Int:Bool], diagnostics: ^[Diagnostic]) {
    loop item in source_module.declarations {
        if item == {
            .Func(function) -> {
                sema_check_soft_public_signature(function, source_module, raw, seen, diagnostics)
            }
            .Impl(implementation) -> {
                loop method in implementation.methods {
                    sema_check_soft_public_signature(method, source_module, raw, seen, diagnostics)
                }
            }
            .Struct(definition) -> {
                loop method in definition.methods {
                    sema_check_soft_public_signature(method, source_module, raw, seen, diagnostics)
                }
            }
            .Enum(definition) -> {
                loop method in definition.methods {
                    sema_check_soft_public_signature(method, source_module, raw, seen, diagnostics)
                }
            }
            .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

sema_check_soft_public_signature: fn(function: Func, module_row: SemaRegistrationModule, raw: [U8], seen: ^[Int:Bool], diagnostics: ^[Diagnostic]) {
    if function.compiler_generated {
        return
    }
    local := [String]{}
    loop parameter in function.type_params -> local.push(parameter.name)
    ranges := [Span]{}
    loop parameter in function.params -> ranges.push(parameter.ty_span)
    if function.return_type_span == .Val(span) -> ranges.push(span.copy())
    // A bound runs from the parameter's name to its `,`, `>` or default `=`.
    loop parameter in function.type_params {
        end := parameter.name_span.end
        loop end < raw.len() && raw[end] != 44 && raw[end] != 62 && raw[end] != 61 -> end += 1
        ranges.push(Span{start: parameter.name_span.end, end: end})
    }
    loop range in ranges {
        at := if range.start < 0 -> 0 else -> range.start
        limit: if range.end > raw.len() -> raw.len() else -> range.end
        loop at < limit {
            if raw[at] != 95 || (at > 0 && sema_soft_public_word_byte(raw[at - 1])) {
                at += 1
                next
            }
            start: at
            loop at < limit && sema_soft_public_word_byte(raw[at]) -> at += 1
            name: String.from_bytes(raw[start..<at]) ?? next
            qualified: start > 0 && raw[start - 1] == 46
            if !qualified && (sema_registration_declaration_row(module_row, name) != None || local.contains(name)) -> next
            sema_soft_public_warn({start: start, name: name}, seen, diagnostics)
        }
    }
}

// The soft-public candidate a use site writes, with its byte offset in the
// source: the last identifier of the span (`n._title` gives `_title`) when it
// starts with `_`, as every soft-public name does. A span over a whole call
// names the identifier just before the argument list that its last `)`
// closes (type arguments skipped). A written name is a whole token of the
// source, so a span that cuts an identifier is no use site of this text (a
// span another source owns) and names nothing.
sema_soft_public_written_leaf: fn(raw: [U8], span: Span) -> {start: Int, name: String}? Never! {
    if span.start < 0 || span.end > raw.len() || span.start >= span.end -> return None
    end := span.end
    loop end > span.start && (raw[end - 1] == 32 || raw[end - 1] == 10) -> end -= 1
    if end > span.start && raw[end - 1] == 41 {
        index := end - 1
        depth := 0
        loop index >= span.start {
            if raw[index] == 41 -> depth += 1
            if raw[index] == 40 {
                depth -= 1
                if depth == 0 -> break
            }
            index -= 1
        }
        if index <= span.start -> return None
        end = index
    }
    if end > span.start && raw[end - 1] == 62 {
        angle := 0
        loop end > span.start {
            end -= 1
            if raw[end] == 62 -> angle += 1
            if raw[end] == 60 {
                angle -= 1
                if angle == 0 -> break
            }
        }
    }
    start := end
    loop start > span.start && sema_soft_public_word_byte(raw[start - 1]) -> start -= 1
    if start == end || raw[start] != 95 -> return None
    if (start > 0 && sema_soft_public_word_byte(raw[start - 1])) || (end < raw.len() && sema_soft_public_word_byte(raw[end])) {
        return None
    }
    name: String.from_bytes(raw[start..<end]) ?? return None
    Val({start: start, name: name})
}

sema_soft_public_word_byte: fn(byte: U8) -> Bool Never! {
    byte == 95 || (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
}

// Whether this compile refuses what no `jet` has built yet (the "not built
// yet" E2104). The refusal keeps an unported runtime out of the IR, and
// `jet check` lowers nothing, so only build, run and test refuse.
sema_refuses_unbuilt: fn(program: SemaProgramTables) -> Bool Never! {
    if program.registration_graph == .Val(graph) -> return !graph.check_tests
    true
}

// sema_check_registration_module reports `sema.bodies` progress every this
// many items (and at the last).
SEMA_CHECK_PROGRESS_STRIDE: 64

// The checked type definitions a finalization reads: every staged module's.
sema_stage_checked_types: fn(modules: [SemaGraphModuleResult]) -> [TTypeDef] Never! {
    checked_types := [TTypeDef]{}
    loop staged_module in modules {
        loop type_definition in staged_module.declarations.type_defs {
            checked_types.push(type_definition.copy())
        }
    }
    checked_types
}

// `modules`, moved in, as a finalization's stage needs them: it reads only
// their declarations (sema_stage_checked_types). The checked bodies and the
// rows their checks filled are freed, so finalizing a checked program again
// never holds its old bodies beside the new ones.
sema_stage_declaration_modules: fn(modules: ^^[SemaGraphModuleResult]) -> [SemaGraphModuleResult] Never! {
    kept := modules.move()
    loop index in 0..<kept.len() {
        kept[index].functions = [FnBody]{}
        kept[index].call_facts = [SemaCallSiteFact]{}
        kept[index].name_references = [SemaNameReferenceFact]{}
        kept[index].comptime_requests = [SemaComptimeRequest]{}
        kept[index].comptime_body_sources = [SemaComptimeBodySource]{}
        kept[index].compute_facts = [SemaComputeFunctionFacts]{}
        kept[index].copy_events = [SemaCopyEvent]{}
        kept[index].diagnostics = [Diagnostic]{}
        kept[index].failure_facts = [SemaFunctionFailureFacts]{}
        kept[index].tests = [TTestFact]{}
        kept[index].test_member_uses = SemaLivenessMemberUses.empty()
    }
    kept
}

// Adds the diagnostics `comptime_functions` bring a finalization to
// `diagnostics`; whether they leave it complete. A pending result's
// obligations reach the failure solve through the body pass that reuses it
// (sema_comptime_push_obligations).
sema_comptime_function_diagnostics: fn(comptime_functions: [SemaComptimeFunctionResult], diagnostics: ^[Diagnostic]) -> Bool Never! {
    mark: sema_failure_obligation_mark()
    complete := true
    loop result in comptime_functions {
        loop diagnostic in result.diagnostics {
            if result.obligations_pending && sema_failure_obligation_callee(diagnostic, mark) != None {
                next
            }
            diagnostics.push(diagnostic.copy())
        }
        if !result.complete && !result.obligations_pending -> complete = false
    }
    complete
}

// One entry of a program in module row `row`: a file's top-level
// statements, or a `run` entry, which is a `run: fn` or an import that binds
// `run`.
SemaProgramEntrySite: struct {
    row: Int,
    span: Span,
    // How a report names it: "top-level statements", "`run: fn`" or "the
    // `run` import".
    kind: String,
}

// A program has one entry: its entry file's top-level statements, or one
// `run: fn`. Outside Core, a `run: fn` anywhere in the load graph (a module,
// a nested module, another file of the package, a generated module) or an
// import that binds `run` (a rename or a re-export) refuses top-level
// statements anywhere in it, and the reverse; with no `run` entry, the
// statements of a file other than the entry file are a second entry. Each
// file's statements are one E0621, spanning the first through the last
// statement and naming the other entry's file and line. The entry file's
// statements reach this check as the `run: fn` sema_script_entry generates
// from them, or, beside a `run` entry of the file's own, as its script body.
// A file-scope `name: value` binding is a module global the parser already
// registers as a declaration.
sema_check_script_entries: fn(graph: SemaRegistrationGraph, diagnostics: ^[Diagnostic]) -> Bool {
    statements := [SemaProgramEntrySite]{}
    runs := [SemaProgramEntrySite]{}
    entry := -1
    loop index in 0..<graph.modules.len() {
        if module_is_core(graph.modules[index].module_identity) -> next
        if graph.modules[index].module_identity == graph.entry_module_identity -> entry = index
        body: graph.modules[index].program.script_body
        if body.len() > 0 {
            span: Span{start: sema_compiler_index_stmt_span(body[0]).start, end: sema_compiler_index_stmt_span(body[body.len() - 1]).end}
            statements.push(SemaProgramEntrySite{row: index, span: span, kind: "top-level statements"})
        }
        // Another entry file of the package (a named entry or a `run.jet`
        // home) keeps its `run: fn` to itself: that is a program of its own.
        separate: graph.modules[index].module_identity != graph.entry_module_identity && graph.modules[index].namespace_private.contains("run")
        sema_program_entry_sites(index, graph.modules[index].program.imports, graph.modules[index].program.items, statements, runs, separate_entry: separate)
    }
    found := false
    loop site in statements {
        if runs.len() == 0 && site.row == entry -> next
        chosen: sema_program_entry_run(runs, site.row)
        other: if chosen >= 0 -> "{runs[chosen].kind} at `{sema_effect_cap_site(graph.modules[runs[chosen].row], runs[chosen].span)}`" else -> sema_program_entry_script(graph, statements, entry)
        fix: if {
            chosen < 0 -> "move the statements into the entry file, or import a declaration-only file"
            runs[chosen].kind == "`run: fn`" -> "move the statements into `run: fn`, or remove `run: fn` so the statements run"
            else -> "move the statements into the function the `run` import names, or rename the import so the statements run"
        }
        start: diagnostics.len()
        diagnostics.push(sema_error("E0621", site.span, "top-level statements at `{sema_effect_cap_site(graph.modules[site.row], site.span)}` and {other} are two entries of one program", "a program is script style, its entry file's top-level statements, or one `run: fn`, never both, so it starts in one place", fix))
        sema_attach_diagnostic_source_locations(diagnostics, start, graph.modules[site.row].source_segments)
        found = true
    }
    found
}

// The `runs` row a report on statements in module row `row` names: the
// file's own `run` entry when it has one, else the first; -1 for none.
sema_program_entry_run: fn(runs: [SemaProgramEntrySite], row: Int) -> Int Never! {
    loop (position, candidate) in runs {
        if candidate.row == row -> return position
    }
    if runs.len() > 0 -> 0 else -> -1
}

// How a report names the entry file, `entry` (-1 for none), beside another
// file's statements: by its own statements' site when it has some.
sema_program_entry_script: fn(graph: SemaRegistrationGraph, statements: [SemaProgramEntrySite], entry: Int) -> String {
    if entry < 0 -> return "the entry file"
    loop site in statements {
        if site.row == entry {
            return "{site.kind} at `{sema_effect_cap_site(graph.modules[entry], site.span)}`"
        }
    }
    "the entry file `{sema_effect_source_display(graph.modules[entry].source_file)}`"
}

// The entries `imports` and `items` declare in module row `row`, nested
// modules included: a nested module's `run: fn` is either still in its body
// or, once sema_inline_modules_lower has lifted it, a top-level function
// whose lifted name reads back as `run`. The `run: fn` sema_script_entry
// generates, whose name is zero-width at the first statement, is its file's
// top-level statements. A `separate_entry` file's own top-level `run: fn` is
// not one of them.
sema_program_entry_sites: fn(row: Int, imports: [ImportDecl], items: [Item], statements: ^[SemaProgramEntrySite], runs: ^[SemaProgramEntrySite], separate_entry: Bool) Never! {
    loop declaration in imports {
        loop binding in import_walk_bindings(declaration) {
            if binding.local != "run" -> next
            span: if binding.local_span.end > binding.local_span.start -> binding.local_span else -> binding.import_span
            runs.push(SemaProgramEntrySite{row: row, span: span, kind: "the `run` import"})
        }
    }
    loop item in items {
        if item == .CodeModule(definition) && definition.body == .Val(body) {
            sema_program_entry_sites(row, definition.imports, body, statements, runs, separate_entry: false)
        }
        if item == .Func(function) && function.external_type == None && ((function.name == "run" && !separate_entry) || (function.name != "run" && sema_inline_member_source_name(function.name) == "run")) {
            generated: function.name_span.start == function.name_span.end
            site: SemaProgramEntrySite{row: row, span: if generated -> function.span else -> function.name_span, kind: if generated -> "top-level statements" else -> "`run: fn`"}
            if generated -> statements.push(site) else -> runs.push(site)
        }
    }
}

// The entry file `program` of a load: a file whose top level holds
// statements and declares no `run: fn` is a program whose `run: fn` runs
// those statements in order (owner ruling 2026-11-09, #6281). Its
// top-level bindings are part of that order: `total := 0` and `limit: 3`
// are locals of the generated `run: fn` (Main ruling 2026-11-09, option A),
// so its functions don't see them (sema_unknown_entry_local). An ALL_CAPS
// constant, a `#Persist` or comptime binding and the Output defaults record
// stay module declarations. A file that also declares `run: fn` or imports a
// name as `run` keeps its statements for E0621 (sema_check_script_entries).
sema_script_entry: fn(program: ^Program) {
    count: program.script_body.len()
    if count == 0 {
        return
    }
    loop item in program.items {
        if item == .Func(function) && function.name == "run" && function.external_type == None {
            return
        }
    }
    loop declaration in program.imports {
        loop binding in import_walk_bindings(declaration) {
            if binding.local == "run" {
                return
            }
        }
    }
    statements := [Stmt]{}
    compiler_transfer_rows<Stmt>(statements, program.script_body)
    // Popped twice, the items come back in source order.
    reversed := [Item]{}
    loop program.items.len() > 0 {
        reversed.push(program.items.pop() ?? break)
    }
    locals := [Stmt]{}
    loop {
        item := reversed.pop() ?? break
        if item == .Const(definition) && sema_script_entry_local(definition) {
            binding := ast_binding(definition.name.copy(), definition.name_span, definition.mutable, definition.value.copy(), None)
            binding.ty = definition.ty.copy()
            binding.meta = definition.meta.copy()
            binding.markers = definition.markers.copy()
            program.entry_locals.push(definition.name.copy())
            locals.push(Stmt.Val{binding: binding})
            next
        }
        program.items.push(item)
    }
    // `statements` and `locals` are each in source order: take the later of
    // the two tails into `order`, which then pops in source order.
    order := [Stmt]{}
    loop statements.len() > 0 || locals.len() > 0 {
        local_last: locals.len() > 0 && (statements.len() == 0 || sema_compiler_index_stmt_span(locals[locals.len() - 1]).start > sema_compiler_index_stmt_span(statements[statements.len() - 1]).start)
        if local_last {
            order.push(locals.pop() ?? panic("a nonempty local list failed to pop"))
            next
        }
        order.push(statements.pop() ?? panic("a nonempty statement list failed to pop"))
    }
    start: sema_compiler_index_stmt_span(order[order.len() - 1]).start
    end: sema_compiler_index_stmt_span(order[0]).end
    entry := ast_func("run", Span{start: start, end: start}, Span{start: start, end: end})
    loop order.len() > 0 {
        entry.body.push(order.pop() ?? break)
    }
    program.items.push(Item.Func{value: entry})
}

// Whether the file-scope binding `definition` of an entry file of
// top-level statements is a local of its entry (sema_script_entry). A
// `#ContextKey` stays the module's: its identity is the constant's.
sema_script_entry_local: fn(definition: ConstDef) -> Bool Never! {
    if definition.is_persist || definition.is_comptime || sema_context_key_declared(definition) {
        return false
    }
    if definition.ty == (Val(Type.Named{name: "__OutputDefaults"})) -> return false
    definition.mutable || sema_casing_has_case(definition.name, SemaNameCase.Snake)
}
