// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:1
// Typed CLI shapes are sema-owned: required scalar fields fill positionally
// unless #Flag opts out; named input wins. Bool/optional/default stay flag-only.
use jet_sema.Diagnostics.[Diagnostic, Span]
use jet_sema.Syntax as Syntax
use jet_sema.Traits.[TraitRegistry]
use jet_sema.AST.[AccessConvention, Expr, Field, Func, Item, StrPart, StructDef, Type, Marker, CLICommandBinding]
use jet_foundation.Shape.[ShapeProjectionKind]
use jet_foundation.CLISchema.[shape_field_names]

// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:29
pub fn cli_flag_name(structure: StructDef, field: Field) -> String Never! {
    shape_field_names(structure, field).name_for(ShapeProjectionKind.Args).expect("checked CLI field is missing its Args shape name").to_string()
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:40
fn is_cli_scalar(ty: Type) -> Bool Never! {
    if ty == { .Int | .InlineRange(..) | .Float | .Bool | .String -> true .Named(name) -> name == "Path" _ -> false }
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:49
fn has_default_marker(field: Field) -> Bool Never! {
    if field.default.is_some() -> return true
    loop marker in field.serde_markers { if marker.name == Syntax.MARKER_DEFAULT -> return true }
    false
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:57
fn has_flag_marker(field: Field) -> Bool Never! {
    loop marker in field.serde_markers { if marker.name == Syntax.MARKER_FLAG -> return true }
    false
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:63
fn marker_string(field: Field, name: String) -> (Marker, String)? from field {
    loop marker in field.serde_markers {
        if marker.name != name -> continue
        if marker.expr_arg(0) == .Val(expr) {
            if expr == .Str(parts, _) {
                if parts.len() == 1 { if parts[0] == .Lit(value) -> return Val((marker, value.clone())) }
            }
        }
        return None
    }
    None
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:76
pub enum CLIFieldKind { Flag OptionalOption DefaultedOption RequiredOption }
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:90
pub fn classify_cli_field(field: Field) -> CLIFieldKind? Never! {
    if field.ty == .Bool -> return Val(.Flag)
    if field.ty == .Option(inner) { if is_cli_scalar(inner) -> return Val(.OptionalOption) }
    if is_cli_scalar(field.ty) {
        if has_default_marker(field) -> return Val(.DefaultedOption)
        return Val(.RequiredOption)
    }
    None
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:106
fn e1305(field_name: String, ty_show: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E1305", "field `{field_name}` has no CLI flag mapping ({ty_show})",
        "a `#[CLI]` field becomes one `--flag` (and a positional when required); only `Int` (including inline ranges), `Float`, `Bool`, `String`, `Path`, and `T?` of those have a defined shape (nested `#[CLI]` structs and other collection/closure types don't).",
        "change the field to a supported type, or drop it from the `#[CLI]` struct", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:124
fn e1306(flag: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E1306", "two `#[CLI]` fields both derive the flag `--{flag}`",
        "every field needs a distinct `--flag`; generated commands reserve `--help`, `--allow`, and `--deny`.",
        "rename the colliding field or choose a non-reserved flag name", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:137
fn e1309(field_name: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E1309", "`#[Flag]` on `{field_name}` has nothing to opt out of",
        "`#[Flag]` keeps a required value field flag-only. Bool fields, optional fields (`T?`), and fields with a {{expr}} default already stay flag-only.",
        "remove `#[Flag]`, or make the field a required scalar without a {{expr}} default", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:151
fn e1318(short: String, first: String, second: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E1318", "`#Short(\"{short}\")` is used by both `{first}` and `{second}`", "each short option must select only one `#CLI` field.", "give `{first}` or `{second}` a different `#Short` value", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:161
fn e1318_invalid(short: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E1318", "`#Short(\"{short}\")` is not a one-letter option", "the shared command parser treats a short option as one ASCII letter.", "use one letter, such as `#Short(\"p\")`", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:172
fn e1319(marker: String, field: String, why: String, fix: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E1319", "`#{marker}` has no CLI mapping for field `{field}`", why.to_string(), fix.to_string(), Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:183
pub fn e1308(span: Span?) -> Diagnostic Never! {
    Diagnostic.error("E1308", "`run`'s parameter isn't a CLI-derived type", "a typed `fn run(args: T)` entry only works when `T` is a `#[CLI]`-derived program struct.", "mark the program struct `#[CLI]` (or `#CLI(Standard)` for the standard pack)", span)
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:194
fn e1344(command: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E1344", "CLI command `{command}` collides with another command or root flag", "a program struct has one command namespace and one root flag namespace; a word cannot name both.", "rename the command or the root field so every command word is unique", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:205
fn e1345(name: String, span: Span, why: String) -> Diagnostic Never! {
    Diagnostic.error("E1345", "CLI command member `{name}` has no callable shape", why.to_string(), "bind a visible function with scalar parameters and, at most, one first read-only parameter of the program-struct type", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:215
fn e1346(span: Span) -> Diagnostic Never! {
    Diagnostic.error("E1346", "callable CLI members cannot be declared on a Codable struct", "CLI commands are behavior, while Codable structs contain only serializable data fields.", "split the command program struct from the Codable data struct", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:226
fn e1347(span: Span) -> Diagnostic Never! {
    Diagnostic.error("E1347", "a CLI method receiver must be read-only", "shared root flags are parsed into one program value and command dispatch must not mutate that value.", "change the receiver to read-only `self`", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:237
fn callable_param_shape(ty: Type) -> Bool Never! {
    if is_cli_scalar(ty) -> return true
    if ty == .Option(inner) -> return is_cli_scalar(inner)
    false
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:241
fn validate_callable_params(function: Func, command_name: String, shared_type: String?, out: &[Diagnostic]) Never! {
    shared := [USize:Bool]{}
    first_shared := None as USize?
    if shared_type == .Val(owner) {
        loop index in 0..function.params.len() {
            if named_leaf(function.params[index].ty) == Val(owner) {
                shared[index] = true
                if first_shared.is_none() { first_shared = Val(index) }
            }
        }
        if shared.len() > 1 || (first_shared.is_some() && first_shared != Val(USize{0})) {
            out.push(e1345(command_name, function.name_span, "a bound function may receive the shared program struct only once, as its first parameter"))
        }
    }
    loop index in 0..function.params.len() {
        param :: function.params[index]
        if param.name == Syntax.KW_SELF {
            if shared_type.is_some() { out.push(e1345(command_name, param.name_span, "a bound function receives shared state as an ordinary first program-struct parameter, not as a method receiver")) }
            continue
        }
        if shared.contains_key(index) {
            if param.convention != AccessConvention.Read { out.push(e1345(command_name, param.name_span, "the shared program-struct parameter must be read-only")) }
            continue
        }
        if param.variadic || param.variadic_bound_list.is_some() {
            out.push(e1345(command_name, param.name_span, "command parameters cannot be variadic; use one scalar or optional scalar parameter per input"))
            continue
        }
        if !callable_param_shape(param.ty) { out.push(e1345(command_name, param.ty_span, "every command parameter must be a CLI scalar or optional scalar")) }
        if param.default == .Val(default) {
            scalar :: if default.without_parens() == { .Int(..) | .Float(..) | .Bool(..) | .Str(..) -> true _ -> false }
            if !scalar { out.push(e1345(command_name, param.name_span, "a command default must be a CLI compile-time scalar value")) }
        }
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:321
fn named_leaf(ty: Type) -> String? from ty {
    if ty == .Named(name) -> return Val(name.rsplit('.').next() ?? name)
    None
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:328
fn has_codable_shape(structure: StructDef) -> Bool Never! {
    loop (name, _) in structure.derives { if name == Syntax.MARKER_CODABLE || name == "Encode" || name == "Decode" -> return true }
    false
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:334
fn binding_target(items: [Item], binding: CLICommandBinding) -> Func? from items {
    if binding.target.without_parens() == .Ident(name, _) {
        loop item in items { if item == .Func(function) { if function.name == name -> return Val(function) } }
    }
    None
}
// Rust: crates/jet-sema/src/Sema/CheckerCli.rs:350
pub fn validate_cli_items(items: [Item], reg: TraitRegistry) -> [Diagnostic] Never! {
    out := [Diagnostic]{}
    loop item in items {
        if item == .Struct(structure) {
            cli := false
            loop (name, _) in structure.derives { if name == "CLI" { cli = true; break } }
            if !cli {
                loop binding in structure.cli_bindings { out.push(e1345(binding.name, binding.name_span, "a callable member is only valid inside a `#CLI` program struct")) }
                loop field in structure.fields {
                    loop marker in field.serde_markers {
                        if marker.name == Syntax.MARKER_SHORT || marker.name == Syntax.MARKER_ENV {
                            out.push(e1319(marker.name, field.name, "`#Short` and `#Env` describe generated command inputs, but this struct is not `#CLI`.", "remove the marker, or mark the command-input struct `#CLI`", marker.name_span))
                        }
                    }
                }
                continue
            }
            _ :: reg
            seen_flags := [String:Span]{}
            seen_shorts := [String:String]{}
            loop name in [String]{"help", "allow", "deny"} { seen_flags[name] = structure.name_span }
            standard := false
            loop marker in structure.type_markers {
                if marker.name == Syntax.MARKER_CLI {
                    loop arg in marker.expr_args() { if arg == .Ident(name, _) { if name == "Standard" { standard = true; break } } }
                }
                if standard -> break
            }
            if standard {
                loop name in [String]{"verbose", "quiet", "color", "version"} { seen_flags[name] = structure.name_span }
                seen_shorts["v"] = "standard --verbose"
                seen_shorts["q"] = "standard --quiet"
            }
            loop field in structure.fields {
                kind :: classify_cli_field(field) ?? { out.push(e1305(field.name, field.ty.show(), field.name_span)); continue }
                if has_flag_marker(field) && kind != CLIFieldKind.RequiredOption {
                    span := field.name_span
                    loop marker in field.serde_markers { if marker.name == Syntax.MARKER_FLAG { span = marker.name_span; break } }
                    out.push(e1309(field.name, span))
                }
                flag :: cli_flag_name(structure, field)
                collision :: seen_flags.contains_key(flag)
                seen_flags[flag.clone()] = field.name_span
                if collision { out.push(e1306(flag, field.name_span)) }
                if marker_string(field, Syntax.MARKER_SHORT) == .Val(short_marker) {
                    (marker, short) :: short_marker
                    if short.len() != 1 || !short.as_bytes()[0].is_ascii_alphabetic() { out.push(e1318_invalid(short, marker.name_span)) }
                    else {
                        first :: seen_shorts.get(short)
                        seen_shorts[short.clone()] = field.name.clone()
                        if first == .Val(name) { out.push(e1318(short, name, field.name, marker.name_span)) }
                    }
                }
                if kind == CLIFieldKind.Flag {
                    if marker_string(field, Syntax.MARKER_ENV) == .Val(env_marker) {
                        out.push(e1319("Env", field.name, "a `Bool` command field is a presence flag, while `#Env` lowers to a value option.", "remove `#Env`, or use it on an `Int`, `Float`, `String`, `Path`, or optional value field", env_marker.0.name_span))
                    }
                }
            }
            seen_commands := [String:Span]{}
            command_count := USize{0}
            loop function in structure.methods {
                computed := false
                loop field in structure.fields { if field.computed.is_some() && field.name == function.name { computed = true; break } }
                if computed -> continue
                command_count += 1
                command :: function.name.to_lowercase()
                collision := seen_flags.contains_key(command)
                // Preserve short-circuit insertion: a root flag collision does
                // not insert this name into the command map.
                if !collision {
                    collision = seen_commands.contains_key(command)
                    seen_commands[command.clone()] = function.name_span
                }
                if collision { out.push(e1344(command, function.name_span)) }
                loop param in function.params {
                    if param.name == Syntax.KW_SELF {
                        if param.convention != AccessConvention.Read { out.push(e1347(param.name_span)) }
                        break
                    }
                }
                validate_callable_params(function, command, None, &out)
            }
            loop binding in structure.cli_bindings {
                command_count += 1
                command :: binding.name.to_lowercase()
                collision := seen_flags.contains_key(command)
                if !collision {
                    collision = seen_commands.contains_key(command)
                    seen_commands[command.clone()] = binding.name_span
                }
                if collision { out.push(e1344(command, binding.name_span)) }
                invalid_marker := false
                loop marker in binding.markers { if marker.name != Syntax.MARKER_DOC { invalid_marker = true; break } }
                if invalid_marker { out.push(e1345(binding.name, binding.name_span, "a callable member accepts `#Doc`, but field-only CLI markers do not apply to bindings")) }
                function :: binding_target(items, binding) ?? {
                    out.push(e1345(binding.name, binding.target.span(), "the binding target must be a function declared in the same program module"))
                    continue
                }
                validate_callable_params(function, binding.name, Val(structure.name), &out)
            }
            if command_count > 0 && has_codable_shape(structure) { out.push(e1346(structure.name_span)) }
        }
    }
    ^out
}
