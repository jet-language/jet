// The roles Core declarations fill. `#Builtin.Role(.AbsF32)`, jet_builtins'
// Role marker, makes the function, method or trait it marks the one that
// fills role `AbsF32`. Lowering then finds that declaration through its role
// (FnBody.role and JetIR ir_core_role_row), never through its name.
use jet_foundation.[CORE_BUILTINS_MODULE, Diagnostic, Marker, ModuleID, Span, Symbol, module_is_core, owned_trait_for_role]

// The jet_builtins marker that gives a Core function its role.
SEMA_CORE_ROLE_MARKER: "Role"

// The role that `markers`, written on a function of module
// `module_identity`, give it: the RoleKind case that `#Builtin.Role(.X)`
// names. "" when no role marker marks it. Only a Core function fills a role.
sema_core_role: fn(markers: [Marker], graph: SemaRegistrationGraph, module_identity: ModuleID) -> String {
    if !module_is_core(module_identity) -> return ""
    loop marker in markers {
        if marker.args.len() != 1 || !sema_core_builtin_marker(marker, graph, module_identity, SEMA_CORE_ROLE_MARKER) {
            next
        }
        if marker.args[0] == .Expr(value) {
            if value == .EnumLit(_, variant, _, _, _, _, _) -> return "{variant}"
        }
    }
    ""
}

// Whether `marker`, written in module `module_identity`, applies the
// jet_builtins marker `name` (`#Builtin.Role`, `#Builtin.Needs`).
sema_core_builtin_marker: fn(marker: Marker, graph: SemaRegistrationGraph, module_identity: ModuleID, name: String) -> Bool {
    if marker.negated -> return false
    resolved: sema_marker_module_resolve_application(graph, module_identity, marker)
    if resolved.status != "found" -> return false
    declaration: resolved.declaration ?? return false
    if declaration.name != name -> return false
    index: sema_registration_module_index(graph, resolved.declaring_module_identity) ?? return false
    graph.modules[index].module_name == CORE_BUILTINS_MODULE
}

// A top-level Core function that fills a role: its module and its name.
SemaCoreRoleFunction: struct {
    module_identity: ModuleID,
    name: String,
}

// The top-level Core functions that fill one of `roles` (sema_core_role).
sema_core_role_functions: fn(graph: SemaRegistrationGraph, roles: [String]) -> [SemaCoreRoleFunction] {
    ^found: [SemaCoreRoleFunction]{}
    if roles.len() == 0 -> return found
    loop module_row in graph.modules {
        if !module_is_core(module_row.module_identity) -> next
        loop function in module_row.functions {
            if function.declaration.markers.len() == 0 -> next
            role: sema_core_role(function.declaration.markers, graph, module_row.module_identity)
            if role != "" && roles.contains(role) {
                found.push(SemaCoreRoleFunction{module_identity: module_row.module_identity, name: function.declaration.name})
            }
        }
    }
    found
}

// The role of the `text_input` that keeps an `on_drop:` handler's slot.
SEMA_CORE_ROLE_TEXT_INPUT_DROP: "TextInputDrop"

// The role of the `text_input` that keeps an `on_change:` handler's slot,
// and an `on_drop:` handler's when it has one.
SEMA_CORE_ROLE_TEXT_INPUT_CHANGE: "TextInputChange"

// The role of core.encoding's body that publishes `receipt.attach(value)`'s
// encoded section (Calls/Receipts.jet).
SEMA_CORE_ROLE_RECEIPT_ATTACH: "ReceiptAttach"

// The Core function that fills `role`, for a check that calls it. None when
// no loaded Core function fills it.
sema_core_role_function: fn(graph: SemaRegistrationGraph, role: String) -> SemaCoreRoleFunction? {
    found: sema_core_role_functions(graph, [String]{role})
    if found.len() == 0 -> return None
    Val(found[0])
}

// Whether `name` is a top-level function of Core module `module_row` that
// fills a role (sema_core_role).
sema_core_role_filler: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, name: String) -> Bool {
    sema_core_function_role(graph, module_row, name) != ""
}

// The role that `name`, a top-level function of Core module `module_row`,
// fills, or "" when it fills none.
sema_core_function_role: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, name: String) -> String {
    if !module_is_core(module_row.module_identity) -> return ""
    loop function in module_row.functions {
        if function.declaration.name != name || function.declaration.markers.len() == 0 -> next
        return sema_core_role(function.declaration.markers, graph, module_row.module_identity)
    }
    ""
}

// The role that static `method` of the Core type at nominal row `row` fills:
// the role of the method it declares by that name, or "" when that fills none.
sema_core_method_role: fn(graph: SemaRegistrationGraph, row: SemaRegistrationRowRef, method: String) -> String {
    module_row: graph.modules[row.module_index]
    if !module_is_core(module_row.module_identity) -> return ""
    loop function in module_row.nominals[row.row].methods {
        if function.declaration.name != method || function.declaration.markers.len() == 0 -> next
        return sema_core_role(function.declaration.markers, graph, module_row.module_identity)
    }
    ""
}

// Whether callable `row` is a top-level Core function that constructs a
// declared point (`point`, `hook_point`, `decision_point`), whose call is a
// module binding's identity: it fills a role whose name ends in `Point`
// (jet_builtins RoleKind).
sema_core_point_constructor: fn(graph: SemaRegistrationGraph, row: SemaRegistrationCallableRow) -[]> Bool {
    if row == .Function(declaring, index) {
        module_row: graph.modules[declaring]
        if !module_is_core(module_row.module_identity) -> return false
        markers: module_row.functions[index].declaration.markers
        if markers.len() == 0 -> return false
        return sema_core_role(markers, graph, module_row.module_identity).ends_with("Point")
    }
    false
}

// The role the top-level Core function `symbol` names fills
// (sema_core_role); "" for any other callee.
sema_core_symbol_role: fn(graph: SemaRegistrationGraph, symbol: Symbol) -> String {
    if !module_is_core(symbol.module_identity) -> return ""
    row: sema_registration_callable_row(graph, sema_registration_symbol_key(graph, symbol.id)) ?? return ""
    if row == .Function(declaring, index) {
        module_row: graph.modules[declaring]
        markers: module_row.functions[index].declaration.markers
        if markers.len() == 0 -> return ""
        return sema_core_role(markers, graph, module_row.module_identity)
    }
    ""
}

// The jet_builtins enum whose cases are the roles.
SEMA_CORE_ROLE_KIND: "RoleKind"

// Where jet_builtins' RoleKind enum is registered: its module row and its
// nominal row.
SemaCoreRoleKind: struct {
    module_index: Int,
    nominal_index: Int,
}

// The roles the loaded Core functions fill. `fillers` holds, for each case of
// RoleKind in case order, the name of the first function that fills it, or ""
// when none does. `kind` is None when jet_builtins declares no RoleKind.
SemaCoreRoleFill: struct {
    kind: SemaCoreRoleKind?,
    fillers: [String],
}

// A role problem and the row of the module it is in.
SemaCoreRoleProblem: struct {
    module_index: Int,
    diagnostic: Diagnostic,
}

// Where jet_builtins' RoleKind enum is registered, when it is.
sema_core_role_kind: fn(graph: SemaRegistrationGraph) -> SemaCoreRoleKind? {
    loop (module_index, module_row) in graph.modules {
        if module_row.module_name != CORE_BUILTINS_MODULE -> next
        loop (nominal_index, nominal) in module_row.nominals {
            if nominal.kind == SemaRegistrationNominalKind.Enum && nominal.symbol.name == SEMA_CORE_ROLE_KIND {
                return SemaCoreRoleKind{module_index: module_index, nominal_index: nominal_index}
            }
        }
    }
    None
}

// The RoleKind case that `role` names: its row among the enum's cases.
sema_core_role_case: fn(graph: SemaRegistrationGraph, kind: SemaCoreRoleKind, role: String) -> Int? {
    loop (index, variant) in graph.modules[kind.module_index].nominals[kind.nominal_index].variants {
        if variant.symbol.name == role -> return index
    }
    None
}

// Each role is filled at most once: a Core function, method or trait that
// fills a role an earlier one, or a compiler-owned trait (OWNED_TRAITS
// `role`, the `#Builtin.Role(.X)` of Compiler/Prelude/Traits.jet), already
// fills is E1014, at its name. Gives the roles the owned traits and the
// loaded Core declarations fill, for sema_core_roles_check_filled.
sema_core_roles_check: fn(graph: ^SemaRegistrationGraph) -> SemaCoreRoleFill {
    kind: sema_core_role_kind(graph) ?? return SemaCoreRoleFill{kind: None, fillers: [String]{}}
    ^fillers: [String]{}
    loop variant in graph.modules[kind.module_index].nominals[kind.nominal_index].variants {
        fillers.push(sema_core_role_owned_filler(variant.symbol.name))
    }
    ^problems: [SemaCoreRoleProblem]{}
    loop (module_index, module_row) in graph.modules {
        if !module_is_core(module_row.module_identity) -> next
        loop function in module_row.functions {
            if function.declaration.markers.len() == 0 -> next
            role: sema_core_role(function.declaration.markers, graph, module_row.module_identity)
            if role == "" -> next
            sema_core_role_record(graph, kind, role, function.declaration.name, function.declaration.name_span, module_index, fillers, problems)
        }
        loop nominal in module_row.nominals {
            loop method in nominal.methods {
                if method.declaration.markers.len() == 0 -> next
                role: sema_core_role(method.declaration.markers, graph, module_row.module_identity)
                if role == "" -> next
                sema_core_role_record(graph, kind, role, "{nominal.symbol.name}.{method.declaration.name}", method.declaration.name_span, module_index, fillers, problems)
            }
            if nominal.source == .SourceAST(item) {
                if item == .Trait(definition) {
                    role: sema_core_role(definition.markers, graph, module_row.module_identity)
                    if role != "" {
                        sema_core_role_record(graph, kind, role, definition.name, definition.name_span, module_index, fillers, problems)
                    }
                }
            }
        }
    }
    loop problem in problems {
        sema_registration_push_graph_diagnostic(graph, problem.module_index, problem.diagnostic)
    }
    SemaCoreRoleFill{kind: kind, fillers: fillers}
}

// `name`, at `span` in module row `module_index`, fills `role`: the role's
// first filler, else E1014.
sema_core_role_record: fn(graph: SemaRegistrationGraph, kind: SemaCoreRoleKind, role: String, name: String, span: Span, module_index: Int, fillers: ^[String], problems: ^[SemaCoreRoleProblem]) {
    slot: sema_core_role_case(graph, kind, role) ?? return
    if {
        fillers[slot] == "" -> fillers[slot] = name
        else -> {
            problems.push(SemaCoreRoleProblem{module_index: module_index, diagnostic: sema_duplicate_core_role(name, role, fillers[slot], span)})
        }
    }
}

// The compiler-owned trait that fills `role`, or "" when none does.
sema_core_role_owned_filler: fn(role: String) -> String Never! {
    ^owned: owned_trait_for_role(role) ?? return ""
    owned.name.move()
}

// With every Core module loaded (`jet check Core` and the Core library's
// check), each case of jet_builtins' RoleKind that no owned trait and no
// function fills is E1015, at the case.
sema_core_roles_check_filled: fn(graph: ^SemaRegistrationGraph, fill: SemaCoreRoleFill) {
    kind: fill.kind ?? return
    problems: loop (index, variant) in graph.modules[kind.module_index].nominals[kind.nominal_index].variants if fill.fillers[index] == "" -> sema_missing_core_role(variant.symbol.name, variant.symbol.span)
    loop problem in problems {
        sema_registration_push_graph_diagnostic(graph, kind.module_index, problem)
    }
}

// E1014: `name` fills `role`, which `first` already fills.
sema_duplicate_core_role: fn(name: String, role: String, first: String, span: Span) -> Diagnostic {
    row: sema_diagnostic_row("E1014")
    what: row.what.replace("{{name}}", name).replace("{{role}}", role).replace("{{first}}", first)
    sema_error("E1014", span, what, row.why, row.fix.replace("{{role}}", role))
}

// E1015: no Core function fills `role`.
sema_missing_core_role: fn(role: String, span: Span) -> Diagnostic {
    row: sema_diagnostic_row("E1015")
    sema_error("E1015", span, row.what.replace("{{role}}", role), row.why, row.fix.replace("{{role}}", role))
}
