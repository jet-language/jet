// Sema emits the shared Lexer Diagnostic value; it does not define a second
// diagnostic payload or rebase the aggregate UTF-8 byte spans.
use jet_foundation.[
    Diagnostic,
    Span,
    Type,
    diagnostic_from_registry,
    diagnostic_with_source_mapping,
    dimension_display_name,
    measure_expression,
    type_name,
]

pub enum SemaSourceOrigin { Snapshot CompilerGenerated }

pub struct SemaSourceSegment {
    pub generated: Span
    pub source_file: String
    pub source_start: Int
    pub line_starts: [Int]
    pub origin: SemaSourceOrigin
}

pub fn sema_source_file_at(segments: [SemaSourceSegment], fallback: String, fallback_origin: SemaSourceOrigin, site: Span) -> String Never! {
    loop segment in segments {
        if site.start >= segment.generated.start && site.start < segment.generated.end -> return segment.source_file
    }
    if fallback_origin == SemaSourceOrigin.Snapshot -> fallback else -> ""
}

pub struct SemaSourceLocation {
    pub source_path: String
    pub aggregate_start: Int
    pub source_start: Int
    pub origin: SemaSourceOrigin
}

pub fn sema_source_location_at(segments: [SemaSourceSegment], site: Span) -> SemaSourceLocation? {
    if site.end < site.start || segments.len() == 0 -> return None
    candidate := -1
    matches := 0
    if {
        site.start == site.end -> {
            loop (index, segment) in segments {
                if site.start >= segment.generated.start && site.start < segment.generated.end {
                    candidate = index
                    matches += 1
                }
            }
            if matches == 0 {
                final_end := segments[0].generated.end
                loop index in 1..<segments.len() {
                    if segments[index].generated.end > final_end -> final_end = segments[index].generated.end
                }
                if site.start != final_end -> return None
                loop (index, segment) in segments {
                    if segment.generated.end == final_end {
                        candidate = index
                        matches += 1
                    }
                }
            }
        }
        else -> {
            loop (index, segment) in segments {
                intersects :: segment.generated.start < site.end && segment.generated.end > site.start
                if intersects {
                    if site.start >= segment.generated.start && site.start < segment.generated.end && site.end <= segment.generated.end {
                        candidate = index
                    }
                    matches += 1
                }
            }
        }
    }
    if matches != 1 || candidate < 0 -> return None
    segment :: segments[candidate]
    if segment.source_file == "" || segment.generated.start < 0 || segment.source_start < 0 -> return None
    Val(SemaSourceLocation{source_path: segment.source_file, aggregate_start: segment.generated.start, source_start: segment.source_start, origin: segment.origin})
}

pub fn sema_diagnostic_with_source_location(diagnostic: ^Diagnostic, segments: [SemaSourceSegment]) -> Diagnostic Never! {
    updated := diagnostic
    span :: updated.span ?? return updated
    location :: sema_source_location_at(segments, span) ?? {
        updated.source_path = None
        updated.source_offset = None
        updated.source_start = None
        return updated
    }
    if updated.edit == .Val(edit) {
        edit_location :: sema_source_location_at(segments, edit.span) ?? {
            updated.source_path = None
            updated.source_offset = None
            updated.source_start = None
            return updated
        }
        if edit_location.source_path != location.source_path || edit_location.aggregate_start != location.aggregate_start || edit_location.source_start != location.source_start || edit_location.origin != location.origin {
            updated.source_path = None
            updated.source_offset = None
            updated.source_start = None
            return updated
        }
    }
    if updated.source_path != None {
        if updated.source_path != Val(location.source_path) || updated.source_offset != Val(location.aggregate_start) || updated.source_start != Val(location.source_start) {
            updated.source_path = None
            updated.source_offset = None
            updated.source_start = None
        }
        return updated
    }
    diagnostic_with_source_mapping(^updated, location.source_path, location.aggregate_start, location.source_start)
}

pub fn sema_attach_diagnostic_source_locations(diagnostics: &[Diagnostic], start: Int, segments: [SemaSourceSegment]) Never! {
    loop index in start..<diagnostics.len() {
        diagnostics[index] = sema_diagnostic_with_source_location(diagnostics[index], segments)
    }
}

pub fn sema_source_line_at(segments: [SemaSourceSegment], site: Span) -> Int? {
    loop segment in segments {
        if site.start >= segment.generated.start && site.start < segment.generated.end {
            if segment.line_starts.len() == 0 -> return None
            local_offset :: site.start - segment.generated.start
            low := 0
            high := segment.line_starts.len()
            loop low < high {
                middle :: (low + high) /% 2
                if {
                    segment.line_starts[middle] <= local_offset -> {
                        low = middle + 1
                    }
                    else -> {
                        high = middle
                    }
                }
            }
            if low == 0 -> return None
            return Val(low)
        }
    }
    None
}

// The 1-based column of `site` in its source line (Rust `span_line_col`).
// Segments carry line starts, not text, so this counts bytes; Rust counts
// characters, which agree on ASCII lines.
pub fn sema_source_column_at(segments: [SemaSourceSegment], site: Span) -> Int? {
    line :: sema_source_line_at(segments, site) ?? return None
    loop segment in segments {
        if site.start >= segment.generated.start && site.start < segment.generated.end -> return Val(site.start - segment.generated.start - segment.line_starts[line - 1] + 1)
    }
    None
}

pub fn sema_error_optional(code: String, span: Span?, what: String, why: String, fix: String) -> Diagnostic {
    diagnostic_from_registry(code, span, what, why, fix)
}

pub fn sema_error(code: String, span: Span, what: String, why: String, fix: String) -> Diagnostic {
    sema_error_optional(code, Val(span), what, why, fix)
}

pub fn sema_lint(code: String, span: Span, what: String, why: String, fix: String) -> Diagnostic {
    diagnostic_from_registry(code, Val(span), what, why, fix)
}

pub fn sema_defined_twice_optional(name: String, why: String, span: Span?) -> Diagnostic {
    sema_error_optional("E0105", span, "`{name}` is defined twice", why, "rename or remove one of the definitions")
}

pub fn sema_already_defined(name: String, span: Span) -> Diagnostic {
    sema_error(
        "E0118",
        span,
        "the name `{name}` is already taken here",
        "inside one function, each name refers to exactly one thing",
        "pick a different name, or assign to the existing one with `{name} = ...`",
    )
}

pub fn sema_defined_twice(name: String, why: String, span: Span) -> Diagnostic {
    sema_error("E0105", span, "`{name}` is defined twice", why, "rename or remove one of the definitions")
}

pub fn sema_unknown_name(name: String, span: Span) -> Diagnostic {
    sema_error(
        "E0107",
        span,
        "nothing named `{name}` exists here",
        "a name must be declared before it's used",
        "declare it first: `{name} :: ...`",
    )
}

pub fn sema_type_mismatch(required: Type, offered: Type, span: Span) -> Diagnostic {
    // D-TYPEDTEXT1 / D-FFI-SH1 / D-REGEX-LIT1 (Rust `typed_text_mismatch`): a
    // runtime `String` never becomes a checked typed text or a `Regex`.
    if required == .Named(name) && offered == Type.String {
        head :: sema_call_reflection_leaf_name(name)
        if head == "Regex" -> return sema_error("E0152", span, "a `String` is not a `Regex` pattern", "regex patterns are typed literals, so Jet can validate them before the program runs", "write `.{{\"...\"}}` here, or call `re.compile(text)` for a pattern built at run time")
        if head == "SQL" || head == "HTML" || head == "Sh" {
            why :: if head == "Sh" -> "a runtime string could change the executable or argument boundaries; only a checked literal may build `Sh`, where every `{{value}}` hole is exactly one argv item" else -> "interpolating untrusted text into a query or page is how injection happens; only a checked literal (its `{{value}}` holes become bound parameters or escaped insertions) may build one"
            return sema_error("E0149", span, "a runtime `String` can't be used as `{head}`", why, "write `{head}{{\"...\"}}` with `{{value}}` holes, or use `{head}.raw(\"…\")` if you have audited the text")
        }
    }
    required_name :: type_name(required)
    offered_name :: type_name(offered)
    sema_error(
        "E0108",
        span,
        "this needs {required_name}, but the value is {offered_name}",
        "the value here does not have the type required by this declaration",
        "use a value of the required type or convert it explicitly",
    )
}

// The plain-words type name diagnostics print (the Rust reference's
// `Type::show`): scalars carry a gloss and nominal names are quoted.
pub fn sema_type_show(ty: Type) -> String Never! {
    if ty == {
        .Int -> "Int (a whole number)"
        .Float -> "Float (an approximate binary number)"
        .Bool -> "Bool (true or false)"
        .String -> "String (text)"
        .Char -> "Char (one character)"
        .Named(name) -> if name == "Decimal" -> "Decimal (an exact base-10 number)" else -> "`{name}`"
        .Measure(measure) -> "{measure_expression(measure)} (a compile-time measure)"
        .Apply(name, args) -> {
            if name == "Ptr" && args.len() == 1 -> return "`*{type_name(args[0])}`"
            names :: loop arg in args -> type_name(arg)
            "`{name}`<{names.join(", ")}>"
        }
        .Quantity(_, dimension) -> "{dimension_display_name(dimension)} (a physical quantity)"
        .TraitObject(bounds) -> "`{bounds.join(" + ")}` (a trait value)"
        .IntN(signed, bits) -> {
            spelling :: if signed -> "I{bits}" else -> "U{bits}"
            article :: if bits == 8 -> "an" else -> "a"
            "{spelling} ({article} {bits}-bit whole number, {sema_type_int_range_text(signed, bits)})"
        }
        .InlineRange(base, lo, hi) -> "{type_name(base)} (a whole number from {lo} to {hi})"
        .Float32 -> "F32 (a 32-bit approximate binary number)"
        .Tagged(marker, inner) -> if marker == {
            .User(name) -> "#{name} {sema_type_show(inner)}"
            .Internal(_) -> sema_type_show(inner)
        }
        else -> type_name(ty)
    }
}

fn sema_type_int_range_text(signed: Bool, bits: Int) -> String Never! {
    if bits == 64 && signed -> return "-9223372036854775808 to 9223372036854775807"
    if bits == 64 -> return "0 to 18446744073709551615"
    if bits == 128 && signed -> return "-170141183460469231731687303715884105728 to 170141183460469231731687303715884105727"
    if bits == 128 -> return "0 to 340282366920938463463374607431768211455"
    span := 1
    loop _ in 0..<bits -> span = span * 2
    if signed -> return "{0 - span / 2} to {span / 2 - 1}"
    "0 to {span - 1}"
}

// The last path segment of a nominal type, or "" for any other type.
fn sema_type_nominal_leaf(ty: Type) -> String Never! {
    if ty == {
        .Named(name) -> {
            parts := name.split("::").to_list()
            if parts.len() < 2 -> parts = name.split(".").to_list()
            parts[parts.len() - 1]
        }
        else -> ""
    }
}

// The repair for a value of type `got` where `want` is required (the Rust
// reference's `type_fix_hint`). A fix never prescribes what was written.
pub fn sema_type_fix_hint(want: Type, got: Type) -> String Never! {
    want_show :: sema_type_show(want)
    if want_show == sema_type_show(got) -> return "these are two different declarations that both print as {want_show}; make both sides name the same one (import it once and use that name)"
    want_leaf :: sema_type_nominal_leaf(want)
    if want_leaf != "" && want_leaf == sema_type_nominal_leaf(got) -> return "these names may refer to one declaration; make both sides use one spelling for `{want_leaf}`"
    if want == {
        .Float -> {
            if got == Type.Int -> return "write the number with a decimal part, like `2.0`"
            if sema_type_nominal_leaf(got) == "Decimal" -> return "write the literal as Float{{3.4}}, or keep Decimal on both sides"
        }
        .Int -> {
            if got == Type.Float -> return "drop the decimal part, like `2`"
            if got == .IntN(signed, bits) {
                prefix :: if signed -> "i" else -> "u"
                return "widen it explicitly with `Int.from_{prefix}{bits}(value)`"
            }
        }
        .String -> return "put the value in text with interpolation: \"{{x}}\""
        .Named(name) -> {
            if name.ends_with(".RNG") -> return "use RNG here"
        }
        else -> {}
    }
    "use {want_show} here"
}

// D-DISCARD1=A (owner ruling): with a written return type, a mismatched value
// is taught as a fault in the value itself (its conversion or wrap), never as
// a prompt to change the declared return type.
fn sema_return_value_fix(want: Type, got: Type) -> String Never! {
    if want == Type.Int && got == (Type.Named{name: "Fraction"}) -> return "`/` on whole numbers makes an exact Fraction; divide with `/%` to get a whole number rounded down"
    if want == .List(item) && item == got -> return "wrap the value in a list: `[value]`"
    if got == .List(item) && item == want -> return "this is a whole list; hand back one element, or combine the elements into one value"
    if got == .Option(item) && item == want -> return "the value may be missing; supply a fallback with `?? default`, or leave early when it is `None`"
    if type_name(want) == "String" -> return "put the value in text with interpolation: \"{{value}}\""
    hint :: sema_type_fix_hint(want, got)
    if hint.starts_with("use ") && hint.ends_with(" here") -> return "hand back a {type_name(want)} value: convert this value to {type_name(want)}, or return the value you meant"
    hint
}

// E0113: a value handed back by `function` does not match its written
// return type `want`.
pub fn sema_return_value_mismatch(function: String, want: Type, got: Type, span: Span) -> Diagnostic {
    want_name :: type_name(want)
    sema_error("E0113", span, "this value is {sema_type_show(got)}, but `{function}` returns {want_name}", "`{function}` declares {want_name} as its result, so the value it hands back must be {want_name}", sema_return_value_fix(want, got))
}
