// Sema totality (AGENTS.md I2, I3): every function sema checks is complete,
// or its check reported at least one diagnostic. A check that stops with
// neither broke the law; the driver turns each function it left incomplete
// into one ICE row (jet_driver_totality_problem), so one run names them all
// instead of one whole-graph stop.

// One function a check left incomplete, with one recorded cause.
SemaTotalityRow: struct {
    // The module: its source file, or its identity when it has none.
    owner: String
    // The function's label as its check wrote it ("function `name`",
    // "method `Type.name`", a comptime closure's function key), or "-" when
    // the cause is module-wide (a scope, a declaration pass, an item kind).
    function: String
    reason: String
}

// The rows of every incomplete module of `modules`, one per recorded cause.
// A function's cause is the line "{label}: {reason}" (CheckProgram's
// sema_check_push_function_reasons and its siblings), its label ending in
// the backticked name; any other line is a module-wide cause. A module that
// is incomplete with no recorded cause is one row saying so: that stop is
// itself the break of the law.
sema_totality_rows: fn(modules: [SemaGraphModuleResult]) -> [SemaTotalityRow] Never! {
    rows := [SemaTotalityRow]{}
    loop graph_module in modules {
        if graph_module.complete -> next
        owner: if graph_module.source_file != "" -> graph_module.source_file.copy() else -> graph_module.module_identity.copy()
        if graph_module.incomplete_reasons.len() == 0 {
            rows.push(SemaTotalityRow{owner: owner, function: "-", reason: "incomplete with no recorded cause"})
            next
        }
        loop reason in graph_module.incomplete_reasons -> rows.push(sema_totality_reason_row(owner, reason))
    }
    rows
}

// One recorded cause of the module `owner` as its row.
sema_totality_reason_row: fn(owner: String, reason: String) -> SemaTotalityRow Never! {
    at: reason.find("`: ")
    if at < 0 -> return SemaTotalityRow{owner: owner.copy(), function: "-", reason: reason.copy()}
    SemaTotalityRow{owner: owner.copy(), function: reason.slice(0..<at + 1), reason: reason.slice(at + 3..<reason.len())}
}
