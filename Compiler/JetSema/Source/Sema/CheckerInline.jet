//RS /// D-METHODMACRO1=A: the size ceiling named in E0919's fix text. A statement
//RS /// count, not a byte/token count — cheap to compute, easy to explain, and
//RS /// generous enough that no shipped example needs to cross it. Chosen as a
//RS /// round number comfortably above every hand-written helper in the stdlib;
//RS /// revisit with real inlining-cost data if it ever cuts off a legitimate use.
//RS pub const INLINE_ALWAYS_MAX_STMTS: usize = 40;
//RS 
//RS /// E0917: `#Inline(Always) fn {name}` calls itself.
