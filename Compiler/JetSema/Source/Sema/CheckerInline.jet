use jet_foundation.[Diagnostic, Span, Binding, Expr, Func, LValue, Stmt, ForKind, StrPart, EnumLitArg, OrFallback]

// D-METHODMACRO1=A: #Inline is only a hint; #Inline(Always) is a checked promise.
// Only direct self-recursion is detected here; mutual recursion requires a whole-program graph.
// Address-taking is accumulated during ordinary inference and checked after all bodies.
// Nested lambdas compile separately and are excluded from both recursion and statement counts.
// Rust: crates/jet-sema/src/Sema/CheckerInline.rs:48
pub INLINE_ALWAYS_MAX_STMTS: Int :: 40

// Rust: crates/jet-sema/src/Sema/CheckerInline.rs:51
fn e0917_self_recursive(name: String, span: Span) -> Diagnostic {
    Diagnostic.error("E0917", "`{name}` calls itself, so `#Inline(Always)` cannot expand it", "inlining a recursive call would either loop forever at compile time or require an artificial depth cutoff — neither is a real inline.", "drop `#Inline(Always)` (use `#Inline` as a hint), or restructure the function to be non-recursive.", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerInline.rs:67
pub fn e0918_address_taken(name: String, span: Span) -> Diagnostic {
    Diagnostic.error("E0918", "`{name}` cannot be inlined: its address is taken", "`#Inline(Always)` promises every call to `{name}` expands in place — but `{name}` is also used as a plain value somewhere (stored, returned, or passed as a callback), and a value needs a real function to point at.", "drop `#Inline(Always)`, or call `{name}` directly instead of through a value.", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerInline.rs:82
fn e0919_too_large(name: String, stmt_count: Int, span: Span) -> Diagnostic {
    Diagnostic.error("E0919", "`{name}` is too large for `#Inline(Always)`", "its body has {stmt_count} statements — over the {INLINE_ALWAYS_MAX_STMTS}-statement ceiling `#Inline(Always)` enforces so a promised inline doesn't quietly bloat every call site.", "drop `#Inline(Always)` (use `#Inline` as a hint the compiler is free to ignore), or split the function so the hot part is small enough to inline.", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerInline.rs:103
pub fn check_inline_always_fn(f: Func) -> [Diagnostic] {
    scan := InlineAlwaysScan{target: f.name, stmt_count: 0, self_recursive: false}
    &scan.scan_stmts(f.body)
    span :: f.inline_span ?? f.name_span
    out := [Diagnostic]{}
    if scan.self_recursive -> &out.push(e0917_self_recursive(f.name, span))
    if scan.stmt_count > INLINE_ALWAYS_MAX_STMTS -> &out.push(e0919_too_large(f.name, scan.stmt_count, span))
    out
}
// Rust: crates/jet-sema/src/Sema/CheckerInline.rs:121
struct InlineAlwaysScan {
    target: String
    stmt_count: Int
    self_recursive: Bool
}
impl InlineAlwaysScan {
    // Rust: crates/jet-sema/src/Sema/CheckerInline.rs:128
    fn scan_stmts(self: &Self, stmts: [Stmt]) {
        loop stmt in stmts { &self.scan_stmt(stmt) }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInline.rs:134
    fn scan_binding(self: &Self, binding: Binding) { &self.scan_expr(binding.init) }
    // Rust: crates/jet-sema/src/Sema/CheckerInline.rs:138
    fn scan_stmt(self: &Self, stmt: Stmt) {
        self.stmt_count += 1
        if stmt == {
            .Expr(expr) | .DeferClose{close: expr, ..} -> &self.scan_expr(expr)
            .Val(binding) -> &self.scan_binding(binding)
            .Assign{target, value, ..} -> { &self.scan_lvalue(target); &self.scan_expr(value) }
            .Return(value, _) -> if value == .Val(expr) -> &self.scan_expr(expr)
            .BreakValue(expr, _) | .BreakLabelValue(_, _, expr, _) -> &self.scan_expr(expr)
            .While{cond, body, ..} -> { &self.scan_expr(cond); &self.scan_stmts(body) }
            .For{kind, body, ..} -> {
                if kind == {
                    .Range{start, end, step, ..} -> {
                        &self.scan_expr(start)
                        &self.scan_expr(end)
                        if step == .Val(expr) -> &self.scan_expr(expr)
                    }
                    .In{collection, step} -> {
                        &self.scan_expr(collection)
                        if step == .Val(expr) -> &self.scan_expr(expr)
                    }
                }
                &self.scan_stmts(body)
            }
            .Switch{subject, arms, else_body, ..} | .ComptimeSwitch{subject, arms, else_body, ..} -> {
                &self.scan_expr(subject)
                loop arm in arms { &self.scan_expr(arm.cond); &self.scan_stmts(arm.body) }
                if else_body == .Val(body) -> &self.scan_stmts(body)
            }
            .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
            .Loop{body, ..} -> &self.scan_stmts(body)
            .CountedLoop{init, cond, step, body, ..} -> {
                &self.scan_binding(init)
                &self.scan_expr(cond)
                if step == .Val(next_stmt) -> &self.scan_stmt(next_stmt)
                &self.scan_stmts(body)
            }
            .Unsafe{body, ..} | .Impure{body, ..} | .Reactive{body, ..} | .Shield{body, ..}
                | .Switched{body, ..} | .Region{body, ..} | .Policy{body, ..} | .TaskGroup{body, ..}
                | .Layout{body, ..} | .ComptimeBlock{body, ..} | .Live{body, ..} | .AssumeDet{body, ..}
                | .ScopeMember{body, ..} | .Transact{body, ..} | .AuthorityScope{body, ..} -> &self.scan_stmts(body)
            .ComptimeIf{cond, then_body, else_body, ..} -> {
                &self.scan_expr(cond)
                &self.scan_stmts(then_body)
                if else_body == .Val(body) -> &self.scan_stmts(body)
            }
            .ContextBlock{fields, body, ..} -> {
                loop (_, expr, _) in fields { &self.scan_expr(expr) }
                &self.scan_stmts(body)
            }
            .Yield(expr, _) -> &self.scan_expr(expr)
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInline.rs:257
    fn scan_lvalue(self: &Self, value: LValue) {
        if value == {
            .Local{..} -> {}
            .Index{base, index, ..} -> { &self.scan_expr(base); &self.scan_expr(index) }
            .Field{base, ..} -> &self.scan_expr(base)
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInline.rs:273
    fn scan_expr(self: &Self, expr: Expr) {
        if expr == {
            .Call(call) -> {
                if call.name == self.target -> self.self_recursive = true
                loop arg in call.args { &self.scan_expr(arg.expr) }
            }
            .MethodCall{receiver, method, args, ..} -> {
                if method == self.target -> self.self_recursive = true
                &self.scan_expr(receiver)
                loop arg in args { &self.scan_expr(arg.expr) }
            }
            .CallValue{callee, args, ..} -> {
                &self.scan_expr(callee)
                loop arg in args { &self.scan_expr(arg.expr) }
            }
            .Str(parts, _) -> {
                loop part in parts { if part == .Interp(inner, _) -> &self.scan_expr(inner) }
            }
            .StrMatchLit(_, _) | .BinMatchLit(_, _) | .Int(_, _, _, _) | .Float(_, _, _, _)
                | .Bool(_, _) | .Char(_, _) -> {}
            .ListLit(items, _) -> { loop item in items { &self.scan_expr(item) } }
            .Spread(inner, _) -> &self.scan_expr(inner)
            .MemberSpread{base, ..} -> &self.scan_expr(base)
            .MapLit(entries, _) -> { loop (key, value) in entries { &self.scan_expr(key); &self.scan_expr(value) } }
            .Index{base, index, ..} -> { &self.scan_expr(base); &self.scan_expr(index) }
            .Slice{base, start, end, range, ..} -> {
                &self.scan_expr(base)
                if range == .Val(inner) -> &self.scan_expr(inner)
                else { &self.scan_expr(start); &self.scan_expr(end) }
            }
            .Range{start, end, ..} -> { &self.scan_expr(start); &self.scan_expr(end) }
            .Ident(_, _) -> {}
            .Unary(_, inner, _) -> &self.scan_expr(inner)
            .Binary(_, left, right, _) -> { &self.scan_expr(left); &self.scan_expr(right) }
            .CompareChain{operands, ..} -> { loop operand in operands { &self.scan_expr(operand) } }
            .UnitLit{..} -> {}
            .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _) | .Field(inner, _, _) -> &self.scan_expr(inner)
            .OptField{base, ..} -> &self.scan_expr(base)
            .StructLit{fields, ..} -> { loop (_, _, inner) in fields { &self.scan_expr(inner) } }
            .TypedLit{body, ..} -> body.for_each_expr(fn(inner) { &self.scan_expr(inner) })
            .EnumLit{args, ..} -> {
                loop arg in args {
                    if arg == { .Positional(inner) | .Named{expr: inner, ..} -> &self.scan_expr(inner) }
                }
            }
            .Tainted(inner, _, _) | .Present(inner, _) -> &self.scan_expr(inner)
            .Absent(_) | .Todo{..} | .NoElse(_) | .ReduceMarker(_, _) -> {}
            .PatternTest{subject, ..} -> &self.scan_expr(subject)
            .Ok(inner, _) | .Err(inner, _) -> &self.scan_expr(inner)
            .Try(inner, _, _, note) -> {
                &self.scan_expr(inner)
                if note == .Val(value) -> &self.scan_expr(value)
            }
            .OrFallback{value, fallback, ..} -> {
                &self.scan_expr(value)
                if fallback == {
                    .Value(inner) -> &self.scan_expr(inner)
                    .Block{body, value, ..} -> {
                        &self.scan_stmts(body)
                        if value == .Val(inner) -> &self.scan_expr(inner)
                    }
                    .Return(value, _) -> if value == .Val(inner) -> &self.scan_expr(inner)
                    .Panic{args, ..} -> { loop arg in args { &self.scan_expr(arg.expr) } }
                    .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> {}
                }
            }
            .If{cond, then_body, then_value, else_body, else_value, ..} -> {
                &self.scan_expr(cond)
                &self.scan_stmts(then_body)
                &self.scan_expr(then_value)
                &self.scan_stmts(else_body)
                &self.scan_expr(else_value)
            }
            .TupleLit(fields, _, _) -> { loop (_, inner) in fields { &self.scan_expr(inner) } }
            // A lambda compiles to a separate closure, not this function's inline text.
            .Lambda(_) -> {}
            .PtrFromAddr{addr, ..} -> &self.scan_expr(addr)
            .ComptimeName{..} | .Unit(_) -> {}
            .Paren(inner, _) | .Place(inner, _, _) -> &self.scan_expr(inner)
        }
    }
}
