use jet_foundation.[Diagnostic, Span, ErrorConvDef, Expr, Func, ImportDecl, ImportKind, Item, LoadedModule, ProgramBundle, Stmt, TryConvert]
use jet_foundation.Prelude as CorePrelude
use jet_foundation.Prelude.[Target]
use jet_lexer.[lex_generated]
use jet_parser.[parse]

// Rust: crates/jet-sema/src/Sema/Prelude.rs:12
const INTERNAL_PREFIX: String = "__jet_prelude_"
// Rust: crates/jet-sema/src/Sema/Prelude.rs:24
pub fn inject_exercised_error_conversions(module: &LoadedModule) -> [Diagnostic] {
    if module.no_prelude -> return []
    (shipped, diagnostics) :: shipped_error_conversions()
    if shipped.is_empty() -> return diagnostics
    // GATE #4499: exact tuple-key equality for conversion identity.
    needed := [(String, String):ErrorConvDef]{}
    loop item in &module.items {
        walk_item_exprs(&item, fn(expr: Expr) {
            if expr == .Try(_, _, .Typed(source, target, _), _) {
                source_name :: source.name()
                target_name :: target.name()
                leaf :: core_error_family_leaf(source_name)
                loop conversion in shipped {
                    if leaf == conversion.from_ty && target_name == conversion.to_ty {
                        bound := ~conversion
                        bound.from_ty = source_name
                        needed[(source_name, target_name)] = bound
                    }
                }
            }
        })
    }
    keys := needed.keys().collect()
    &keys.sort()
    loop key in keys {
        conversion :: needed[key]
        declared_locally := false
        loop item in module.items {
            if item == .ErrorConv(local) {
                if local.from_ty == conversion.from_ty && local.to_ty == conversion.to_ty { declared_locally = true; break }
            }
        }
        if !declared_locally -> &module.items.push(Item.ErrorConv(conversion))
    }
    diagnostics
}
// Rust: crates/jet-sema/src/Sema/Prelude.rs:72
fn shipped_error_conversions() -> ([ErrorConvDef], [Diagnostic]) {
    // Compile-time source inclusion, not a Rust execution bridge.
    SOURCE :: #Embed("../../../../crates/jet-codegen/src/Prelude/Errors.jet")
    (tokens, diagnostics) := lex_generated(SOURCE)
    if parse(tokens) == {
        .Ok(program) -> {
            conversions := [ErrorConvDef]{}
            loop item in program.items { if item == .ErrorConv(conversion) -> &conversions.push(conversion) }
            (conversions, diagnostics)
        }
        .Err(parse_diagnostics) -> {
            &diagnostics.extend(parse_diagnostics)
            ([], diagnostics)
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Prelude.rs:94
fn walk_item_exprs(item: &Item, visit: fn(Expr)) {
    if item == {
        .Func(function) -> walk_func(&function, visit)
        .Struct(definition) -> {
            loop method in &definition.methods -> walk_func(&method, visit)
            loop implementation in &definition.trait_impls { loop method in &implementation.methods -> walk_func(&method, visit) }
        }
        .Impl(implementation) -> { loop method in &implementation.methods -> walk_func(&method, visit) }
        .Test(test) -> walk_stmts(&test.body, visit)
        .Const(constant) -> walk_expr(&constant.value, visit)
        .ErrorConv(conversion) -> walk_stmts(&conversion.body, visit)
        .CodeModule(module) -> { if module.body == .Val(body) { loop inner in &body -> walk_item_exprs(&inner, visit) } }
        else -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/Prelude.rs:126
fn walk_func(function: &Func, visit: fn(Expr)) { walk_stmts(&function.body, visit) }
// Rust: crates/jet-sema/src/Sema/Prelude.rs:130
fn walk_stmts(body: &[Stmt], visit: fn(Expr)) {
    loop statement in &body -> &statement.for_each_expr_mut(fn(expr: &Expr) { walk_expr(&expr, visit) })
}
// Rust: crates/jet-sema/src/Sema/Prelude.rs:136
fn walk_expr(expr: &Expr, visit: fn(Expr)) { visit(expr) }

// Rust: crates/jet-sema/src/Sema/Prelude.rs:143
pub fn inject(bundle: &ProgramBundle) {
    loop module in &bundle.modules {
        if module.no_prelude -> continue
        modules := [String:Bool]{}
        loop entry in CorePrelude.entries() {
            if entry.target == .Core(core_module, _) {
                if source_mentions_identifier(module.source, entry.name) -> modules[core_module] = true
            }
        }
        keys := modules.keys().collect()
        &keys.sort()
        loop core_module in keys {
            present := false
            loop import in module.imports {
                if import.import_alias().starts_with(INTERNAL_PREFIX) && import.core_module_path() == Val(core_module) { present = true; break }
            }
            if present -> continue
            stem :: core_module.replace(".", "_")
            base :: "{INTERNAL_PREFIX}{stem}"
            alias := base
            suffix := 0
            loop {
                occupied := false
                loop import in module.imports { if import.import_alias() == alias { occupied = true; break } }
                if !occupied -> break
                suffix += 1
                alias = "{base}_{suffix}"
            }
            zero :: Span.new(0, 0)
            &module.imports.push(ImportDecl{kind: ImportKind.Module(core_module, zero), alias: alias, alias_span: zero, span: zero, item_spans: [], local_spans: [], is_pub: false, is_package_pub: false, inline_version: None})
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Prelude.rs:194
pub fn core_alias_for(core_imports: [String:String], module: String) -> String? {
    loop (alias, target) in core_imports { if alias.starts_with(INTERNAL_PREFIX) && target == module -> return Val(alias) }
    None
}
// Rust: crates/jet-sema/src/Sema/Prelude.rs:203
pub fn shadow_warning(name: String, span: Span) -> Diagnostic Never! {
    Diagnostic.lint("L0510", "declaration {name} replaces a Core prelude alias", "the readable Core prelude opens this name automatically, and a user declaration wins in its file", "keep the declaration to accept the shadow, or rename it to use the prelude alias", Val(span))
}
// Rust: crates/jet-sema/src/Sema/Prelude.rs:213
pub fn is_prelude_name(name: String) -> Bool Never! { CorePrelude.entry(name) != None }
// Rust: crates/jet-sema/src/Sema/Prelude.rs:217
fn source_mentions_identifier(source: String, name: String) -> Bool Never! {
    loop (start, _) in source.match_indices(name) {
        before :: source[..start].chars().next_back()
        after :: source[start + name.len()..].chars().next()
        before_ident :: before.is_some_and(ch -> ch.is_alphanumeric() || ch == '_')
        after_ident :: after.is_some_and(ch -> ch.is_alphanumeric() || ch == '_')
        if !before_ident && !after_ident -> return true
    }
    false
}
