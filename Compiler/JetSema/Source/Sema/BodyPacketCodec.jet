body_codec_get_semanamereferencefact: fn(bytes: [U8], input: &BodyCodecIn) -> SemaNameReferenceFact Never! {
    f0: body_codec_get_span(bytes, input)
    f1: body_codec_get_semanamereferent(bytes, input)
    f2: body_codec_get_opt_symbolkind(bytes, input)
    f3: body_codec_get_string(bytes, input)
    SemaNameReferenceFact{span: f0, symbol: f1, kind: f2, body: f3}
}

body_codec_put_semanamereferent: fn(out: &BodyCodecOut, value: SemaNameReferent) Never! {
    body_codec_put_symbolid(out, value.id)
    body_codec_put_symbolkind(out, value.kind)
    body_codec_put_string(out, value.name)
    body_codec_put_moduleid(out, value.module_identity)
    body_codec_put_string(out, value.owner)
    body_codec_put_span(out, value.span)
}

body_codec_get_semanamereferent: fn(bytes: [U8], input: &BodyCodecIn) -> SemaNameReferent Never! {
    f0: body_codec_get_symbolid(bytes, input)
    f1: body_codec_get_symbolkind(bytes, input)
    f2: body_codec_get_string(bytes, input)
    f3: body_codec_get_moduleid(bytes, input)
    f4: body_codec_get_string(bytes, input)
    f5: body_codec_get_span(bytes, input)
    SemaNameReferent{id: f0, kind: f1, name: f2, module_identity: f3, owner: f4, span: f5}
}

body_codec_put_symbolkind: fn(out: &BodyCodecOut, value: SymbolKind) Never! {
    if value == {
        .Module -> { body_codec_put_tag(out, 0) }
        .Function -> { body_codec_put_tag(out, 1) }
        .Type -> { body_codec_put_tag(out, 2) }
        .Trait -> { body_codec_put_tag(out, 3) }
        .Impl -> { body_codec_put_tag(out, 4) }
        .Constant -> { body_codec_put_tag(out, 5) }
        .Field -> { body_codec_put_tag(out, 6) }
        .Variant -> { body_codec_put_tag(out, 7) }
        .Parameter -> { body_codec_put_tag(out, 8) }
        .Local -> { body_codec_put_tag(out, 9) }
        .Import -> { body_codec_put_tag(out, 10) }
        .Foreign -> { body_codec_put_tag(out, 11) }
        .Label -> body_codec_put_tag(out, 12)
    }
}

body_codec_get_symbolkind: fn(bytes: [U8], input: &BodyCodecIn) -> SymbolKind Never! {
    position: body_codec_get_tag(bytes, input, 13, 0)
    if position == {
        1 -> SymbolKind.Function
        2 -> SymbolKind.Type
        3 -> SymbolKind.Trait
        4 -> SymbolKind.Impl
        5 -> SymbolKind.Constant
        6 -> SymbolKind.Field
        7 -> SymbolKind.Variant
        8 -> SymbolKind.Parameter
        9 -> SymbolKind.Local
        10 -> SymbolKind.Import
        11 -> SymbolKind.Foreign
        12 -> SymbolKind.Label
        else -> SymbolKind.Module
    }
}

body_codec_put_semamethodinput: fn(out: &BodyCodecOut, value: SemaMethodInput) Never! {
    body_codec_put_semabodyjob(out, value.job)
    body_codec_put_opt_int(out, value.memory_position)
    body_codec_put_list_diagnostic(out, value.diagnostics)
    body_codec_put_list_tgenericparam(out, value.generic_params)
    body_codec_put_type(out, value.normalized_owner_type)
    body_codec_put_tfunckind(out, value.function_kind)
    body_codec_put_bool(out, value.memory_found)
    body_codec_put_bool(out, value.memory_complete)
    body_codec_put_bool(out, value.owner_generic_complete)
}

body_codec_get_semamethodinput: fn(bytes: [U8], input: &BodyCodecIn) -> SemaMethodInput Never! {
    f0: body_codec_get_semabodyjob(bytes, input)
    f1: body_codec_get_opt_int(bytes, input)
    f2: body_codec_get_list_diagnostic(bytes, input)
    f3: body_codec_get_list_tgenericparam(bytes, input)
    f4: body_codec_get_type(bytes, input)
    f5: body_codec_get_tfunckind(bytes, input)
    f6: body_codec_get_bool(bytes, input)
    f7: body_codec_get_bool(bytes, input)
    f8: body_codec_get_bool(bytes, input)
    SemaMethodInput{job: f0, memory_position: f1, diagnostics: f2, generic_params: f3, normalized_owner_type: f4, function_kind: f5, memory_found: f6, memory_complete: f7, owner_generic_complete: f8}
}

body_codec_put_semabodyjob: fn(out: &BodyCodecOut, value: SemaBodyJob) Never! {
    if value == {
        .TopLevel(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_int(out, p0)
        }
        .NominalMethod(p0, p1, p2) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_int(out, p2)
        }
        .ImplMethod(p0, p1, p2) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_int(out, p2)
        }
    }
}

body_codec_get_semabodyjob: fn(bytes: [U8], input: &BodyCodecIn) -> SemaBodyJob Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_int(bytes, input)
            SemaBodyJob.NominalMethod{ordinal: f0, nominal_index: f1, method_index: f2}
        }
        2 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_int(bytes, input)
            SemaBodyJob.ImplMethod{ordinal: f0, implementation_index: f1, method_index: f2}
        }
        else -> {
            f0: body_codec_get_int(bytes, input)
            SemaBodyJob.TopLevel{item_index: f0}
        }
    }
}
