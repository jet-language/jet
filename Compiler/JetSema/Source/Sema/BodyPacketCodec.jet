    body_codec_put_symbolid(out, value.symbol)
    body_codec_put_string(out, value.method)
}

body_codec_get_diagnosticcallrewrite: fn(bytes: [U8], input: &BodyCodecIn) -> DiagnosticCallRewrite Never! {
    f0: body_codec_get_symbolid(bytes, input)
    f1: body_codec_get_string(bytes, input)
    DiagnosticCallRewrite{symbol: f0, method: f1}
}

body_codec_put_diagnosticfixapplicability: fn(out: &BodyCodecOut, value: DiagnosticFixApplicability) Never! {
    if value == {
        .Safe -> { body_codec_put_tag(out, 0) }
        .Suggested -> body_codec_put_tag(out, 1)
    }
}

body_codec_get_diagnosticfixapplicability: fn(bytes: [U8], input: &BodyCodecIn) -> DiagnosticFixApplicability Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> DiagnosticFixApplicability.Suggested
        else -> DiagnosticFixApplicability.Safe
    }
}

body_codec_put_diagnosticfixsafety: fn(out: &BodyCodecOut, value: DiagnosticFixSafety) Never! {
    if value == {
        .Formatting -> { body_codec_put_tag(out, 0) }
        .BehaviorPreserving -> { body_codec_put_tag(out, 1) }
        .APIChanging -> { body_codec_put_tag(out, 2) }
        .TargetChanging -> { body_codec_put_tag(out, 3) }
        .NeedsReview -> body_codec_put_tag(out, 4)
    }
}

body_codec_get_diagnosticfixsafety: fn(bytes: [U8], input: &BodyCodecIn) -> DiagnosticFixSafety Never! {
    position: body_codec_get_tag(bytes, input, 5, 0)
    if position == {
        1 -> DiagnosticFixSafety.BehaviorPreserving
        2 -> DiagnosticFixSafety.APIChanging
        3 -> DiagnosticFixSafety.TargetChanging
        4 -> DiagnosticFixSafety.NeedsReview
        else -> DiagnosticFixSafety.Formatting
    }
}

body_codec_put_diagnosticnofixreason: fn(out: &BodyCodecOut, value: DiagnosticNoFixReason) Never! {
    body_codec_put_diagnosticnofixreasonkind(out, value.kind)
    body_codec_put_string(out, value.next)
}

body_codec_get_diagnosticnofixreason: fn(bytes: [U8], input: &BodyCodecIn) -> DiagnosticNoFixReason Never! {
    f0: body_codec_get_diagnosticnofixreasonkind(bytes, input)
    f1: body_codec_get_string(bytes, input)
    DiagnosticNoFixReason{kind: f0, next: f1}
}

body_codec_put_diagnosticnofixreasonkind: fn(out: &BodyCodecOut, value: DiagnosticNoFixReasonKind) Never! {
    if value == {
        .Behavior -> { body_codec_put_tag(out, 0) }
        .Design -> { body_codec_put_tag(out, 1) }
        .Ambiguous -> body_codec_put_tag(out, 2)
    }
}

body_codec_get_diagnosticnofixreasonkind: fn(bytes: [U8], input: &BodyCodecIn) -> DiagnosticNoFixReasonKind Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> DiagnosticNoFixReasonKind.Design
        2 -> DiagnosticNoFixReasonKind.Ambiguous
        else -> DiagnosticNoFixReasonKind.Behavior
    }
}

body_codec_put_diagnosticstructured: fn(out: &BodyCodecOut, value: DiagnosticStructured) Never! {
    if value == {
        .SuggestedEdits(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_list_textedit(out, p0)
        }
        .CryptoMisuse(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_diagnosticcryptomisusereason(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_opt_string(out, p2)
            body_codec_put_opt_int(out, p3)
        }
        .BuildError(p0) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_diagnosticbuilderror(out, p0)
        }
        .RuntimeHostFault(p0) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_string(out, p0)
        }
    }
}

body_codec_get_diagnosticstructured: fn(bytes: [U8], input: &BodyCodecIn) -> DiagnosticStructured Never! {
    position: body_codec_get_tag(bytes, input, 4, 0)
    if position == {
        1 -> {
            f0: body_codec_get_diagnosticcryptomisusereason(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_opt_string(bytes, input)
            f3: body_codec_get_opt_int(bytes, input)
            DiagnosticStructured.CryptoMisuse{reason: f0, operation: f1, expected: f2, actual: f3}
        }
        2 -> {
            f0: body_codec_get_diagnosticbuilderror(bytes, input)
            DiagnosticStructured.BuildError{report: f0}
        }
        3 -> {
            f0: body_codec_get_string(bytes, input)
            DiagnosticStructured.RuntimeHostFault{stdout: f0}
        }
        else -> {
            f0: body_codec_get_list_textedit(bytes, input)
            DiagnosticStructured.SuggestedEdits{edits: f0}
        }
    }
}

body_codec_put_diagnosticcryptomisusereason: fn(out: &BodyCodecOut, value: DiagnosticCryptoMisuseReason) Never! {
    if value == {
        .InvalidLength -> { body_codec_put_tag(out, 0) }
        .NonceLength -> { body_codec_put_tag(out, 1) }
        .OutputLength -> { body_codec_put_tag(out, 2) }
        .SaltLength -> { body_codec_put_tag(out, 3) }
        .MemoryCost -> { body_codec_put_tag(out, 4) }
        .IterationCount -> { body_codec_put_tag(out, 5) }
        .LaneCount -> { body_codec_put_tag(out, 6) }
        .MemoryTimeCost -> { body_codec_put_tag(out, 7) }
        .RawNonce -> { body_codec_put_tag(out, 8) }
        .RawAlgorithm -> { body_codec_put_tag(out, 9) }
        .DeterministicEntropy -> body_codec_put_tag(out, 10)
    }
}

body_codec_get_diagnosticcryptomisusereason: fn(bytes: [U8], input: &BodyCodecIn) -> DiagnosticCryptoMisuseReason Never! {
    position: body_codec_get_tag(bytes, input, 11, 0)
    if position == {
        1 -> DiagnosticCryptoMisuseReason.NonceLength
        2 -> DiagnosticCryptoMisuseReason.OutputLength
        3 -> DiagnosticCryptoMisuseReason.SaltLength
        4 -> DiagnosticCryptoMisuseReason.MemoryCost
        5 -> DiagnosticCryptoMisuseReason.IterationCount
        6 -> DiagnosticCryptoMisuseReason.LaneCount
        7 -> DiagnosticCryptoMisuseReason.MemoryTimeCost
        8 -> DiagnosticCryptoMisuseReason.RawNonce
        9 -> DiagnosticCryptoMisuseReason.RawAlgorithm
        10 -> DiagnosticCryptoMisuseReason.DeterministicEntropy
        else -> DiagnosticCryptoMisuseReason.InvalidLength
    }
}

body_codec_put_list_diagnosticbuilderror: fn(out: &BodyCodecOut, values: [DiagnosticBuildError]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_diagnosticbuilderror(out, value)
}

body_codec_get_list_diagnosticbuilderror: fn(bytes: [U8], input: &BodyCodecIn) -> [DiagnosticBuildError] Never! {
    count: body_codec_get_count(bytes, input, 1)
    values := [DiagnosticBuildError]{}
    loop _ in 0..<count -> values.push(body_codec_get_diagnosticbuilderror(bytes, input))
