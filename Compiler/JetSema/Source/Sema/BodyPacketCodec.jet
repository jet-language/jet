body_codec_put_targethardwareunresolvedreference: fn(out: &BodyCodecOut, value: TargetHardwareUnresolvedReference) Never! {
    if value == {
        .RegisterBlock(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
        }
        .Register(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
        }
        .DMAChannel(p0) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_string(out, p0)
        }
        .Interrupt(p0) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_string(out, p0)
        }
    }
}

body_codec_get_targethardwareunresolvedreference: fn(bytes: [U8], input: &BodyCodecIn) -> TargetHardwareUnresolvedReference Never! {
    position: body_codec_get_tag(bytes, input, 4, 0)
    if position == {
        1 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_string(bytes, input)
            TargetHardwareUnresolvedReference.Register{block: f0, register: f1}
        }
        2 -> {
            f0: body_codec_get_string(bytes, input)
            TargetHardwareUnresolvedReference.DMAChannel{channel: f0}
        }
        3 -> {
            f0: body_codec_get_string(bytes, input)
            TargetHardwareUnresolvedReference.Interrupt{interrupt: f0}
        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            TargetHardwareUnresolvedReference.RegisterBlock{block: f0}
        }
    }
}

