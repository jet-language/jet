    f1: body_codec_get_opt_span(bytes, input)
    f2: body_codec_get_opt_diagnosticorigin(bytes, input)
    DiagnosticCause{code: f0, span: f1, origin: f2}
}

body_codec_put_diagnosticlabel: fn(out: &BodyCodecOut, value: DiagnosticLabel) Never! {
    body_codec_put_span(out, value.span)
    body_codec_put_string(out, value.message)
}

body_codec_get_diagnosticlabel: fn(bytes: [U8], input: &BodyCodecIn) -> DiagnosticLabel Never! {
    f0: body_codec_get_span(bytes, input)
    f1: body_codec_get_string(bytes, input)
    DiagnosticLabel{span: f0, message: f1}
}

body_codec_put_textedit: fn(out: &BodyCodecOut, value: TextEdit) Never! {
    body_codec_put_span(out, value.span)
    body_codec_put_string(out, value.new_text)
    body_codec_put_opt_string(out, value.path)
