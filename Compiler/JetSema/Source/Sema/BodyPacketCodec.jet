    f1: body_codec_get_list_string(bytes, input)
    f2: body_codec_get_semasendproblemkind(bytes, input)
    SemaSendabilityProblem{root: f0, path: f1, kind: f2}
}

body_codec_put_semasendproblemkind: fn(out: &BodyCodecOut, value: SemaSendProblemKind) Never! {
    if value == {
        .ClosureNeedsTake -> { body_codec_put_tag(out, 0) }
        .ClosureCaptures -> { body_codec_put_tag(out, 1) }
        .CallableValue -> { body_codec_put_tag(out, 2) }
        .TraitValue(p0) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_string(out, p0)
        }
        .ThreadConfined(p0) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_string(out, p0)
        }
        .LocalReactive(p0) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_string(out, p0)
        }
        .ViewBorrow -> { body_codec_put_tag(out, 6) }
        .SharedMutation -> { body_codec_put_tag(out, 7) }
        .UnknownType(p0) -> {
            body_codec_put_tag(out, 8)
            body_codec_put_string(out, p0)
        }
    }
}

body_codec_get_semasendproblemkind: fn(bytes: [U8], input: &BodyCodecIn) -> SemaSendProblemKind Never! {
    position: body_codec_get_tag(bytes, input, 9, 0)
    if position == {
        1 -> SemaSendProblemKind.ClosureCaptures
        2 -> SemaSendProblemKind.CallableValue
        3 -> {
            f0: body_codec_get_string(bytes, input)
            SemaSendProblemKind.TraitValue{name: f0}
        }
        4 -> {
            f0: body_codec_get_string(bytes, input)
            SemaSendProblemKind.ThreadConfined{name: f0}
        }
        5 -> {
            f0: body_codec_get_string(bytes, input)
            SemaSendProblemKind.LocalReactive{name: f0}
        }
        6 -> SemaSendProblemKind.ViewBorrow
        7 -> SemaSendProblemKind.SharedMutation
        8 -> {
            f0: body_codec_get_string(bytes, input)
            SemaSendProblemKind.UnknownType{name: f0}
        }
        else -> SemaSendProblemKind.ClosureNeedsTake
    }
}

