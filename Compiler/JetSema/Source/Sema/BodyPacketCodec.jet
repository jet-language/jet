body_codec_put_diagnostic: fn(out: &BodyCodecOut, value: Diagnostic) Never! {
    body_codec_put_diagnosticmoment(out, value.moment)
    body_codec_put_int(out, value.severity)
    body_codec_put_string(out, value.code)
    body_codec_put_opt_span(out, value.span)
    body_codec_put_opt_string(out, value.source_path)
    body_codec_put_opt_int(out, value.source_offset)
    body_codec_put_opt_int(out, value.source_start)
    body_codec_put_opt_diagnosticorigin(out, value.origin)
    body_codec_put_list_diagnosticcause(out, value.cause)
    body_codec_put_list_diagnosticlabel(out, value.labels)
    body_codec_put_string(out, value.what)
    body_codec_put_string(out, value.why)
    body_codec_put_string(out, value.fix)
    body_codec_put_opt_textedit(out, value.edit)
    body_codec_put_list_textedit(out, value.fix_edits)
    body_codec_put_opt_diagnosticcallrewrite(out, value.fix_calls)
    body_codec_put_opt_diagnosticfixapplicability(out, value.applicability)
    body_codec_put_opt_diagnosticfixsafety(out, value.safety)
    body_codec_put_opt_diagnosticnofixreason(out, value.no_fix_reason)
    body_codec_put_opt_string(out, value.detail)
    body_codec_put_opt_diagnosticstructured(out, value.structured)
    body_codec_put_opt_string(out, value.denial_kind)
    body_codec_put_list_string(out, value.call_chain)
    body_codec_put_list_string(out, value.scope_chain)
    body_codec_put_opt_string(out, value.nearest_granting_scope)
    body_codec_put_opt_int(out, value.outside_signal)
}

body_codec_get_diagnostic: fn(bytes: [U8], input: &BodyCodecIn) -> Diagnostic Never! {
    f0: body_codec_get_diagnosticmoment(bytes, input)
    f1: body_codec_get_int(bytes, input)
    f2: body_codec_get_string(bytes, input)
    f3: body_codec_get_opt_span(bytes, input)
    f4: body_codec_get_opt_string(bytes, input)
    f5: body_codec_get_opt_int(bytes, input)
    f6: body_codec_get_opt_int(bytes, input)
    f7: body_codec_get_opt_diagnosticorigin(bytes, input)
    f8: body_codec_get_list_diagnosticcause(bytes, input)
    f9: body_codec_get_list_diagnosticlabel(bytes, input)
    f10: body_codec_get_string(bytes, input)
    f11: body_codec_get_string(bytes, input)
    f12: body_codec_get_string(bytes, input)
    f13: body_codec_get_opt_textedit(bytes, input)
    f14: body_codec_get_list_textedit(bytes, input)
    f15: body_codec_get_opt_diagnosticcallrewrite(bytes, input)
    f16: body_codec_get_opt_diagnosticfixapplicability(bytes, input)
    f17: body_codec_get_opt_diagnosticfixsafety(bytes, input)
    f18: body_codec_get_opt_diagnosticnofixreason(bytes, input)
    f19: body_codec_get_opt_string(bytes, input)
    f20: body_codec_get_opt_diagnosticstructured(bytes, input)
    f21: body_codec_get_opt_string(bytes, input)
    f22: body_codec_get_list_string(bytes, input)
    f23: body_codec_get_list_string(bytes, input)
    f24: body_codec_get_opt_string(bytes, input)
    f25: body_codec_get_opt_int(bytes, input)
    Diagnostic{moment: f0, severity: f1, code: f2, span: f3, source_path: f4, source_offset: f5, source_start: f6, origin: f7, cause: f8, labels: f9, what: f10, why: f11, fix: f12, edit: f13, fix_edits: f14, fix_calls: f15, applicability: f16, safety: f17, no_fix_reason: f18, detail: f19, structured: f20, denial_kind: f21, call_chain: f22, scope_chain: f23, nearest_granting_scope: f24, outside_signal: f25}
}

body_codec_put_diagnosticmoment: fn(out: &BodyCodecOut, value: DiagnosticMoment) Never! {
    if value == {
        .Compile -> { body_codec_put_tag(out, 0) }
        .Run -> { body_codec_put_tag(out, 1) }
        .Test -> { body_codec_put_tag(out, 2) }
        .Tool -> body_codec_put_tag(out, 3)
    }
}

body_codec_get_diagnosticmoment: fn(bytes: [U8], input: &BodyCodecIn) -> DiagnosticMoment Never! {
    position: body_codec_get_tag(bytes, input, 4, 0)
    if position == {
        1 -> DiagnosticMoment.Run
        2 -> DiagnosticMoment.Test
        3 -> DiagnosticMoment.Tool
        else -> DiagnosticMoment.Compile
    }
}

body_codec_put_diagnosticorigin: fn(out: &BodyCodecOut, value: DiagnosticOrigin) Never! {
    body_codec_put_string(out, value.display)
    body_codec_put_string(out, value.path)
    body_codec_put_string(out, value.source)
    body_codec_put_string(out, value.revision)
}

body_codec_get_diagnosticorigin: fn(bytes: [U8], input: &BodyCodecIn) -> DiagnosticOrigin Never! {
    f0: body_codec_get_string(bytes, input)
    f1: body_codec_get_string(bytes, input)
    f2: body_codec_get_string(bytes, input)
    f3: body_codec_get_string(bytes, input)
    DiagnosticOrigin{display: f0, path: f1, source: f2, revision: f3}
}

body_codec_put_diagnosticcause: fn(out: &BodyCodecOut, value: DiagnosticCause) Never! {
    body_codec_put_string(out, value.code)
    body_codec_put_opt_span(out, value.span)
    body_codec_put_opt_diagnosticorigin(out, value.origin)
}

body_codec_get_diagnosticcause: fn(bytes: [U8], input: &BodyCodecIn) -> DiagnosticCause Never! {
