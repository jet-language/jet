body_codec_put_opt_semasendabilityproblem: fn(out: &BodyCodecOut, value: SemaSendabilityProblem?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_semasendabilityproblem(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_semasendabilityproblem: fn(bytes: [U8], input: &BodyCodecIn) -> SemaSendabilityProblem? Never! {
    if body_codec_get_bool(bytes, input) {
        return Val(body_codec_get_semasendabilityproblem(bytes, input))
    }
    None
}

