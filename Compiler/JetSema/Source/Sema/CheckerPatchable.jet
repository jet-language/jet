// D-PATCH1: synthetic T.Patch type and apply/diff/merge methods.
use jet_foundation.[Diagnostic, Field, Item, StructDef, Type, Func, AccessConvention, ParamZone]
use jet_foundation.Syntax
use jet_sema.[MethodSig, TypeDef, TypeRegistry]
use jet_lexer.lex_generated
use jet_parser.parse

// Rust: crates/jet-sema/src/Sema/CheckerPatchable.rs:9
pub fn patch_type_name(base: String) -> String { "{base}.Patch" }
// Rust: crates/jet-sema/src/Sema/CheckerPatchable.rs:13
fn has_patchable(s: StructDef) -> Bool {
    s.derives.iter().any(fn(t, _) { t == Syntax.MARKER_PATCHABLE })
}
// Rust: crates/jet-sema/src/Sema/CheckerPatchable.rs:18
pub fn inject_patchable_types(items: &[Item], diags: &[Diagnostic]) {
    to_add := [Item]{}
    generated_base_methods := [(USize, [Func])]{}
    loop index, item in items.enumerate() {
        if item != .Struct(s) -> continue
        if !has_patchable(s) -> continue
        if validate_patchable_struct(s) == .Val(d) { diags.push(d); continue }
        patch_name :: patch_type_name(s.name)
        fields := [Field]{}
        // Computed fields cannot hold an unchanged sentinel.
        loop f in s.fields {
            if f.computed.is_some() -> continue
            fields.push(Field{
                name: f.name.clone(), name_span: f.name_span,
                ty: Type.Option(f.ty.clone()), ty_span: f.ty_span,
                is_pub: f.is_pub, is_package_pub: f.is_package_pub,
                serde_markers: [], redact: false, computed: None,
                default: None, default_ct: None,
            })
        }
        (base_methods, patch_methods) :: generated_patchable_methods(s)
        to_add.push(Item.Struct(StructDef{
            span: s.span, is_pub: s.is_pub, is_package_pub: s.is_package_pub,
            name: patch_name, name_span: s.name_span, type_params: [], fields: ^fields,
            state: None, methods: patch_methods, cli_bindings: [], trait_impls: [], derives: [],
            // Patch serde is deferred; do not inherit package auto-derive.
            auto_derive_default: false, is_published_schema: false, published_schema_span: None,
            is_single_use: false, single_use_span: None, is_must_use: false, must_use_span: None,
            layout: None, layout_span: None, serde_markers: [], type_markers: [],
            validate_block: [], validate_span: None,
        }))
        generated_base_methods.push((index, base_methods))
    }
    loop (index, methods) in generated_base_methods {
        if items[index] == .Struct(s) { s.methods.extend(methods) }
    }
    items.extend(to_add)
}
// Rust: crates/jet-sema/src/Sema/CheckerPatchable.rs:93
fn generated_patchable_methods(s: StructDef) -> ([Func], [Func]) {
    base :: s.name
    patch :: patch_type_name(base)
    fields := [String]{}
    loop field in s.fields { if field.computed.is_none() { fields.push(field.name.clone()) } }
    source := String.new()
    source.push_str("struct __JetPatchableMethods {{\n")
    source.push_str("    fn apply(self, patch: {patch}) -> {base} {{\n        return {base}{{\n")
    loop index, field in fields.enumerate() {
        if index != 0 { source.push_str(",\n") }
        source.push_str("            {field}: patch.{field} ?? self.{field}")
    }
    source.push_str("\n        }\n    }\n\n")
    source.push_str("    fn diff(^new: {base}, ^old: {base}) -> {patch} {{\n        return {patch}{{\n")
    loop index, field in fields.enumerate() {
        if index != 0 { source.push_str(",\n") }
        source.push_str("            {field}: if new.{field} == old.{field} -> None else -> Val(new.{field})")
    }
    source.push_str("\n        }\n    }\n}\n\n")
    source.push_str("struct __JetPatchablePatchMethods {{\n")
    source.push_str("    fn merge(self, ^other: {patch}) -> {patch} {{\n        return {patch}{{\n")
    loop index, field in fields.enumerate() {
        if index != 0 { source.push_str(",\n") }
        source.push_str("            {field}: if self.{field} == None -> other.{field} else -> self.{field}")
    }
    source.push_str("\n        }\n    }\n}\n")
    (tokens, lex_diagnostics) :: lex_generated(source)
    if !lex_diagnostics.is_empty() { panic("invalid generated Patchable methods: {lex_diagnostics:?}") }
    program := parse(tokens) or diagnostics => { panic("invalid generated Patchable methods: {diagnostics:?}") }
    base_methods := [Func]{}
    patch_methods := [Func]{}
    loop &item in program.items {
        if item != .Struct(definition) -> continue
        loop &method in definition.methods {
            method.span = s.span
            method.name_span = s.name_span
            method.compiler_generated = true
        }
        if definition.name == "__JetPatchableMethods" {
            base_methods = ^definition.methods
            definition.methods = []
        } else if definition.name == "__JetPatchablePatchMethods" {
            patch_methods = ^definition.methods
            definition.methods = []
        }
    }
    (^base_methods, ^patch_methods)
}
// Rust: crates/jet-sema/src/Sema/CheckerPatchable.rs:173
fn validate_patchable_struct(s: StructDef) -> Diagnostic? {
    if !s.type_params.is_empty() {
        return Val(Diagnostic.error("E0336", "`#[Patchable]` on generic struct `{s.name}` isn't supported yet",
            "`T.Patch` codegen needs a concrete field list — generic patches are a follow-on",
            "remove the type parameters, or drop `#[Patchable]` for now", Val(s.name_span)))
    }
    loop f in s.fields {
        if f.ty == .Fn(..) {
            return Val(Diagnostic.error("E0337", "`#[Patchable]` struct `{s.name}` field `{f.name}` has function type",
                "patches are data values — function-typed fields can't be patched",
                "store a callable handle type instead, or drop `#[Patchable]`", Val(f.name_span)))
        }
    }
    None
}
// Rust: crates/jet-sema/src/Sema/CheckerPatchable.rs:205
pub fn register_patchable_methods(items: [Item], registry: &TypeRegistry) {
    loop item in items {
        if item != .Struct(s) -> continue
        if !has_patchable(s) -> continue
        patch :: patch_type_name(s.name)
        if !registry.contains(patch) -> continue
        base :: s.name
        generated :: items.iter().any(fn(item) {
            if item == .Struct(definition) {
                definition.name == base && definition.methods.iter().any(fn(method) { method.compiler_generated && method.name == "apply" })
                    && definition.methods.iter().any(fn(method) { method.compiler_generated && method.name == "diff" })
            } else -> false
        }) && items.iter().any(fn(item) {
            if item == .Struct(definition) {
                definition.name == patch && definition.methods.iter().any(fn(method) { method.compiler_generated && method.name == "merge" })
            } else -> false
        })
        if generated -> continue
        base_ty :: Type.Named(base.clone())
        patch_ty :: Type.Named(patch.clone())
        if registry.types.get_mut(base) == .Val(.Struct(methods: methods, ..)) {
            _ :: methods.insert("apply", MethodSig{
                params: [(.Read, base_ty.clone()), (.Move, patch_ty.clone())], return_type: Val(base_ty.clone()),
                deprecation: None, type_params: [], is_static: false, self_conv: Val(.Read),
                param_info: [("patch", false)], param_call: [("patch", ParamZone.Either)],
                param_variadic: [false], defaults: [None], must_use: false, return_view_provenance: .default(),
            })
            _ :: methods.insert("diff", MethodSig{
                params: [(.Move, base_ty.clone()), (.Move, base_ty.clone())], return_type: Val(patch_ty.clone()),
                deprecation: None, type_params: [], is_static: true, self_conv: None,
                param_info: [("new", false), ("old", false)], param_call: [("new", ParamZone.Either), ("old", ParamZone.Either)],
                param_variadic: [false, false], defaults: [None, None], must_use: false, return_view_provenance: .default(),
            })
        }
        if registry.types.get_mut(patch) == .Val(.Struct(methods: methods, ..)) {
            _ :: methods.insert("merge", MethodSig{
                params: [(.Read, patch_ty.clone()), (.Move, patch_ty.clone())], return_type: Val(Type.Named(patch.clone())),
                deprecation: None, type_params: [], is_static: false, self_conv: Val(.Read),
                param_info: [("other", false)], param_call: [("other", ParamZone.Either)],
                param_variadic: [false], defaults: [None], must_use: false, return_view_provenance: .default(),
            })
        }
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerPatchable.rs:318
// Explicit flags win, then environment settings, then defaults. Invalid present values remain FieldError.
pub fn register_cli_merge_methods(items: [Item], registry: &TypeRegistry) {
    loop item in items {
        if item != .Struct(s) -> continue
        if !s.derives.iter().any(fn(name, _) { name == Syntax.MARKER_CLI }) -> continue
        if registry.types.get_mut(s.name) != .Val(.Struct(methods: methods, ..)) -> continue
        if methods.contains_key("merge") -> continue
        ty :: Type.Named(s.name.clone())
        _ :: methods.insert("merge", MethodSig{
            params: [(.Read, ty.clone()), (.Read, ty.clone())],
            return_type: Val(Type.Result{ok: ty.clone(), err: Type.List(Type.Named("FieldError"))}),
            deprecation: None, type_params: [], is_static: true, self_conv: None,
            param_info: [("flags", false), ("settings", false)], param_call: [("flags", ParamZone.Either), ("settings", ParamZone.Either)],
            param_variadic: [false, false], defaults: [None, None], must_use: true, return_view_provenance: .default(),
        })
    }
}
