// Function-block checking for simple bindings, local writes, returns, and
// control-flow constructs whose checked tree carries no registry-owned facts.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    ArithmeticOperation,
    BinOp,
    BindName,
    BindPattern,
    Binding,
    CallArg,
    ContextField,
    Diagnostic,
    DiagnosticFixApplicability,
    DiagnosticFixSafety,
    EffectRowEntry,
    Expr,
    IndexKind,
    LValue,
    Lambda,
    LambdaBody,
    LambdaParam,
    BodyIfCond,
    BodyPattern,
    BodyTree,
    MARKER_META,
    MARKER_OFF,
    MARKER_TRACK,
    Marker,
    NodeKind,
    body_each_if_cond_child,
    body_each_node_kind_child,
    body_each_pattern_child,
    body_each_stmt_child,
    NamedSpan,
    OrFallback,
    Pattern,
    PlaceAccess,
    Span,
    Stmt,
    SwitchArm,
    Symbol,
    SymbolID,
    SymbolKind,
    TBinaryOp,
    TComptimeValue,
    TARGET_OS_ALL,
    TDestructureBinding,
    TEffectSpan,
    TFailureCarrier,
    TForInMethod,
    TGenericParam,
    TIntegerBounds,
    TLetTy,
    TLetWrapper,
    TLocal,
    TMethodRef,
    TPatternBindingFact,
    TPatternPosition,
    TPreludeArg,
    TStaticOwner,
    TStructLayout,
    TTransactionSnapshot,
    TUnsafeGate,
    Type,
    TypeTupleField,
    ViewProvenance,
    ViewProvenanceEntry,
    ViewProvenanceMap,
    ViewSource,
    ViewSourcePath,
    ViewSourceProjection,
    ast_binding,
    ast_empty_call_arg_flags,
    ast_visit_statement,
    ast_visit_expr,
    ast_empty_lambda_meta,
    diagnostic_registry_row,
    expr_source_span,
    expr_source_start,
    expr_span,
    foundation_named_type,
    integer_bounds_exact,
    measure_literal_value,
    owned_trait_arithmetic,
    symbol_id,
    checked_generated_local,
    checked_symbol_local,
    target_os_name,
    type_carrier_identity,
    type_identity_equal,
    type_identity_key,
    type_name,
    TextEdit,
    UnOp,
    diagnostic_with_edit,
    diagnostic_with_label,
    diagnostic_with_edit_grade,
    checked_persistent_local,
]

SemaStatementResult: struct {
    value: [TStmt]
    complete: Bool
}

SemaStatementRollbackMethods: struct {
    snapshot: TMethodRef
    restore: TMethodRef
}

sema_stmt_binary_type: fn(op: BinOp) -> TBinaryOp Never! {
    sema_expr_tree_binary_op(op)
}

sema_stmt_check_block: fn(body: [Stmt], return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], owner: String, loop_depth: Int) -> SemaStatementResult {
    sema_scope_enter(scopes, state, owner)
    result: sema_check_statements(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
    sema_single_use_leave_scope(scopes, state, diagnostics)
    result
}
sema_stmt_tree_loop_body_has_break: fn(statements: [TStmt], label: String?, allow_unlabeled: Bool) -> Bool Never! {
    loop statement in statements {
        if statement == {
            .Break(target, _) -> {
                if target == .Val(name) {
                    if label == (Val(name)) -> return true
                }
                if target == None && allow_unlabeled -> return true
            }
            .If(_, then_body, else_body, _, _) -> {
                if sema_stmt_tree_loop_body_has_break(then_body, label, allow_unlabeled) -> return true
                if else_body == .Val(else_statements) && sema_stmt_tree_loop_body_has_break(else_statements, label, allow_unlabeled) -> return true
            }
            .Match(_, arms, _, _) -> {
                loop arm in arms {
                    if sema_stmt_tree_loop_body_has_break(arm.body, label, allow_unlabeled) -> return true
                }
            }
            .EnumMatch(_, arms, else_body, _, _) -> {
                loop arm in arms {
                    if sema_stmt_tree_loop_body_has_break(arm.body, label, allow_unlabeled) -> return true
                }
                if else_body == .Val(else_statements) && sema_stmt_tree_loop_body_has_break(else_statements, label, allow_unlabeled) -> return true
            }
            .RangeSwitch(_, arms, else_body, _) -> {
                loop arm in arms {
                    if sema_stmt_tree_loop_body_has_break(arm.body, label, allow_unlabeled) -> return true
                }
                if sema_stmt_tree_loop_body_has_break(else_body, label, allow_unlabeled) -> return true
            }
            .MixedSwitch(_, _, arms, else_body, _) -> {
                loop arm in arms {
                    if sema_stmt_tree_loop_body_has_break(arm.body, label, allow_unlabeled) -> return true
                }
                if else_body == .Val(else_statements) && sema_stmt_tree_loop_body_has_break(else_statements, label, allow_unlabeled) -> return true
            }
            // A nested loop owns its unlabeled breaks; a labeled one can
            // still leave this loop.
            .Loop(_, body, _) | .While(_, _, body, _) | .CountedLoop(_, _, _, _, _, body, _) | .ForRange(_, _, _, _, _, _, body, _, _) | .Range(_, _, _, _, _, _, _, _, body, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, body, _) -> {
                if label != None && sema_stmt_tree_loop_body_has_break(body, label, false) -> return true
            }
            .RefutableBind(_, _, fallback, _) -> {
                if sema_stmt_tree_loop_body_has_break(fallback, label, allow_unlabeled) -> return true
            }
            .Inline(body, _) | .DebugOnly(body, _) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) | .ScopeMember(_, body, _) -> {
                if sema_stmt_tree_loop_body_has_break(body, label, allow_unlabeled) -> return true
            }
            .Unsafe(_, body) | .TaskGroup(_, _, body, _) | .Layout(_, _, body, _) | .ContextBlock(_, body, _) | .Transact(_, _, _, body, _) | .ContractScope(_, body, _, _, _) -> {
                if sema_stmt_tree_loop_body_has_break(body, label, allow_unlabeled) -> return true
            }
            else -> {}
        }
    }
    false
}

// Statements are read in place (read windows): an index read or an unwrapped
// optional would copy the statement, and with it a whole else-if chain.
sema_stmt_tree_block_can_fall_through: fn(statements: [TStmt]) -> Bool Never! {
    seen := 0
    loop last in statements {
        seen += 1
        if seen < statements.len() -> next
        if last == {
            .Return(_, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) -> return false
            .ExprStmt(value, _) -> return value.ty != (Type.Named{name: "Never"})
            .If(_, then_body, else_body, _, _) -> {
                if else_body == .Val(else_statements) -> return sema_stmt_tree_block_can_fall_through(then_body) || sema_stmt_tree_block_can_fall_through(else_statements)
                return true
            }
            .Match(_, arms, exhaustive, _) -> {
                if !exhaustive -> return true
                loop arm in arms {
                    if sema_stmt_tree_block_can_fall_through(arm.body) -> return true
                }
                return false
            }
            .Loop(label, body, _) -> return sema_stmt_tree_loop_body_has_break(body, label, true)
            // Rust flow facts: a wrapper block's own exit leaves the block.
            .Inline(body, _) | .Unsafe(_, body) | .UnsafeBlock(_, body, _) | .Impure(body, _) | .Shield(body, _) | .Region(body, _) -> return sema_stmt_tree_block_can_fall_through(body)
            else -> return true
        }
    }
    true
}

// Rust `stream_element_type` reads the declared return type. The scope holds
// the effective return, where a plain `Stream<T>` became
// `Stream<T> Err!` (`sema_effective_return_type`), so that carrier is unwrapped.
sema_stmt_stream_element_type: fn(return_type: Type?) -> Type? {
    resolved: return_type ?? return None
    if resolved == {
        .Apply(name, args) -> {
            if name == "Stream" && args.len() == 1 {
                return Val(args[0])
            }
        }
        .Result(ok, err) -> {
            if err == (Type.Named{name: "Err"}) -> return sema_stmt_stream_element_type(Val(ok))
        }
        else -> {}
    }
    None
}

sema_stmt_loop_value_break_missing_payload: fn(frame: SemaLoopValueFrame, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if frame.kind != SemaLoopValueKind.Result -> return true
    diagnostics.push(sema_error("E0076", span, "this loop break needs a value", "an ordinary loop used as a value needs a payload on every matching break", "write `break value`"))
    false
}

sema_stmt_check_loop_value_break: fn(value: Expr, label: String?, label_span: Span, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    if label == .Val(name) && !sema_scope_has_loop_label(scopes, name) {
        diagnostics.push(sema_stmt_unknown_loop_label(scopes, name, label_span))
        return None
    }
    frame_index: sema_loop_value_resolve_frame(context, label) ?? {
        diagnostics.push(sema_error("E0115", label_span, "`break value` only works inside a loop", "a loop value needs an active target", "move this inside a loop"))
        return None
    }
    // copy: `frame` is read after sema_check_expression and loop-value recording, which write
    // context.loop_value_frames (`&context`). A view would be live across those writes.
    frame: context.loop_value_frames[frame_index].copy()
    payload_expected := Type?{None}
    if frame.ty == .Val(expected_type) && !sema_expr_is_numeric(expected_type) -> payload_expected = Val(expected_type)
    checked: sema_check_expression(value, payload_expected, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    if !sema_copy_site_check_guard_owned(checked, environment, program, scopes, state, context, diagnostics, false) -> return None
    // A payload the loop cannot carry is reported on the `break` keyword.
    keyword_span: Span{start: span.start, end: span.start + "break".len()}
    if frame.kind == SemaLoopValueKind.Collecting {
        diagnostics.push(sema_error("E0075", keyword_span, "this collecting loop cannot use a break payload", "its result is already the accumulated List, so a second payload would give one exit two result channels", "write `break` to return the accumulated list"))
        return None
    }
    if frame.kind == SemaLoopValueKind.Effect {
        diagnostics.push(sema_error("E0079", keyword_span, "this effect-only loop uses a result exit", "a break payload makes an effect-only loop a value expression", "bind the loop with `:`, or remove the payload"))
        return None
    }
    result: sema_loop_value_check_result_exit(context, frame_index, checked, environment, program, diagnostics) ?? return None
    if !sema_stmt_move_direct(value, state, scopes, "the loop `break`", diagnostics) -> return None
    sema_loop_value_record_break(context, frame_index, state)
    Val(TStmt.BreakValue{label: label, value: result, span: span})
}

sema_stmt_check_yield: fn(value: Expr, span: Span, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    if span.start == span.end && context.collect_item_types.len() > 0 {
        item: sema_loop_value_check_collecting_item(value, expr_span(value), environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
        if !sema_copy_site_check_guard_owned(item, environment, program, scopes, state, context, diagnostics, false) -> return None
        if !sema_stmt_move_direct(value, state, scopes, "the collecting loop", diagnostics) -> return None
        return Val(TStmt.ExprStmt{value: item, span: span})
    }
    stream_return := return_type
    if sema_stmt_stream_element_type(stream_return) == None -> stream_return = scopes.return_type
    elem_type: sema_stmt_stream_element_type(stream_return) ?? {
        // Rust reports at the `yield` keyword.
        keyword: Span{start: span.start, end: span.start + "yield".count_bytes()}
        diagnostics.push(sema_error("E0805", keyword, "`yield` outside a generator", "`yield` hands a value to a `Stream<T>` consumer — only a function declared `Stream<T> ->` may use it", "declare `Stream<T> ->` on this function, or remove the `yield`"))
        _ := sema_check_expression(value, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return None
    }
    diagnostic_start: diagnostics.len()
    checked: sema_check_expression(value, Val(elem_type), environment, program, scopes, state, tail_store, context, diagnostics) ?? {
        // Rust `Stmt::Yield`: the element type is the yielded value's target,
        // and a value of another type is E0807 about the stream.
        mismatch_index: sema_value_mismatch_index(diagnostics, diagnostic_start, expr_span(value)) ?? return None
        probe_diagnostics := [Diagnostic]{}
        offered: sema_probe_expression(value, None, environment, program, scopes, state, tail_store, context, probe_diagnostics) ?? return None
        diagnostics[mismatch_index] = sema_stmt_yield_mismatch(elem_type, offered.ty, expr_span(value))
        return None
    }
    if !sema_copy_site_check_guard_owned(checked, environment, program, scopes, state, context, diagnostics, false) -> return None
    yielded := checked
    if !type_identity_equal(checked.ty, elem_type) {
        if {
            sema_expr_numeric_value_widening(checked, elem_type) == (Val(true)) -> {
                line: sema_source_line_at(environment.source_segments, checked.span) ?? 0
                yielded = sema_expr_numeric_literal_conversion(checked, elem_type, checked.span, line, diagnostics) ?? return None
            }
            else -> {
                diagnostics.push(sema_stmt_yield_mismatch(elem_type, checked.ty, checked.span))
                return None
            }
        }
    }
    if !sema_stmt_move_direct(value, state, scopes, "`yield`", diagnostics) -> return None
    call := sema_tree_node(Type.Named{name: "Unit"}, TExprKind.HostCall{call: THostCall.YieldSend{value: yielded}}, span)
    Val(TStmt.ExprStmt{value: call, span: span})
}

sema_stmt_yield_mismatch: fn(element: Type, offered: Type, span: Span) -> Diagnostic {
    sema_error("E0807", span, "this yields {sema_type_show(offered)}, but the stream is `Stream<{sema_type_show(element)}>`", "every `yield` in a generator must hand back the stream's element type", sema_type_fix_hint(element, offered))
}

// E0806: a generator (`Stream<T> ->`) yields its values;
// `return` only ends the stream early, so it can't carry one. True when this
// return was rejected.
sema_stmt_generator_return_rejected: fn(value: Expr?, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    returned: value ?? return false
    stream_return := return_type
    if sema_stmt_stream_element_type(stream_return) == None -> stream_return = scopes.return_type
    if sema_stmt_stream_element_type(stream_return) == None -> return false
    _ := sema_check_expression(returned, None, environment, program, scopes, state, tail_store, context, diagnostics)
    diagnostics.push(sema_error("E0806", expr_span(returned), "`{context.function_name}` yields values, so `return` can't carry one", "a generator body produces values with `yield`; `return` only ends the stream early", "write `yield ...;` to hand back a value, or a bare `return;` to end the stream"))
    true
}

sema_stmt_close_loop_value_frame: fn(context: &SemaCheckContext, frame_index: Int, body: &[TStmt], state: &SemaOwnershipState, fork: SemaOwnershipFork, outer: Bool, may_skip: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    frame := SemaLoopValueFrame?{None}
    if frame_index >= 0 && frame_index < context.loop_value_frames.len() -> frame = Val(context.loop_value_frames[frame_index])
    if frame == .Val(value) && value.kind == SemaLoopValueKind.Result && value.ty != None {
        result_type: value.ty ?? Type.Named{name: "Unit"}
        if !sema_loop_value_widen_result_breaks(body, value.label, result_type, environment, program, diagnostics) -> valid = false
    }
    body_falls_through := sema_stmt_tree_block_can_fall_through(body)
    if body_falls_through && frame != None -> sema_ownership_check_loop_move_backedge(state, context.loop_value_frames[frame_index], diagnostics)
    _ := sema_ownership_join_loop_value_paths(state, context, frame_index, fork, outer, body_falls_through, may_skip)
    sema_loop_value_pop_frame(context)
    valid
}

sema_stmt_block_has_no_fallthrough: fn(statements: [Stmt]) -> Bool Never! {
    if statements.len() == 0 -> return false
    last: statements[statements.len() - 1]
    if last == {
        .Return(_, _) -> true
        .Loop(body, _, _, _) -> !sema_stmt_refutable_loop_body_can_break(body)
        .Transact(_, _, body, _, _) -> sema_stmt_block_has_no_fallthrough(body)
        else -> false
    }
}

// Rust `stmt_definitely_returns`: `return`, a diverging `panic`/`todo` line, a
// loop that no `break` leaves, or a table whose every path returns.
sema_stmt_definitely_returns: fn(statement: Stmt) -> Bool Never! {
    if statement == {
        .Return(_, _) -> return true
        .Expr(expr) -> return sema_stmt_refutable_expr_diverges(expr)
        .Loop(body, _, _, _) -> return !sema_stmt_refutable_loop_body_can_break(body)
        .While(cond, body, _, _, _) -> return sema_stmt_refutable_expr_is_true(cond) && !sema_stmt_refutable_loop_body_can_break(body)
        .CountedLoop(_, cond, _, body, _, _, _) -> return sema_stmt_refutable_expr_is_true(cond) && !sema_stmt_refutable_loop_body_can_break(body)
        .Switch(subject, arms, else_body, span) -> {
            if arms.len() == 0 -> return false
            loop arm in arms {
                if !sema_stmt_block_definitely_returns(arm.body) -> return false
            }
            if else_body == .Val(body) -> return sema_stmt_block_definitely_returns(body)
            return !sema_stmt_refutable_is_subjectless_guard(subject, span)
        }
        else -> return false
    }
}

sema_stmt_block_definitely_returns: fn(statements: [Stmt]) -> Bool Never! {
    loop statement in statements {
        if sema_stmt_definitely_returns(statement) -> return true
    }
    false
}

// The `value_tail_span` mark for a value block's last line: its value
// expression, or the table that ends the block (its arms carry the value).
sema_stmt_value_tail_marker: fn(statements: [Stmt]) -> Span? {
    seen := 0
    loop last in statements {
        seen += 1
        if seen < statements.len() -> next
        if last == {
            .Expr(tail) -> return Val(expr_span(tail))
            .Switch(_, _, _, span) -> return Val(span)
            .Unsafe(_, _, body, _) -> return sema_stmt_value_tail_marker(body)
            else -> return None
        }
    }
    None
}

// L0521 (ascii_ladder): a binding followed by the 26 assignments `name =
// name.replace("A", "a")` through `("Z", "z")`, all lowering or all raising,
// spells out `name.to_ascii_lower()` (or upper) by hand. Reported at the
// binding name when the binding is a `String`.
sema_stmt_ascii_case_ladder: fn(statements: [Stmt], index: Int, binding: Binding) -> Bool Never! {
    if binding.name == "" || binding.pattern != None || binding.is_comptime -> return false
    if index + 26 >= statements.len() -> return false
    direction := 0
    loop offset in 0..<26 {
        pair: sema_stmt_ascii_replace(statements[index + offset + 1], binding.name) ?? return false
        // ASCII `A` is 65 and `a` is 97.
        this_direction := 0
        if pair[0] == 65 + offset && pair[1] == 97 + offset -> this_direction = 1
        if pair[0] == 97 + offset && pair[1] == 65 + offset -> this_direction = 2
        if this_direction == 0 || (direction != 0 && direction != this_direction) -> return false
        direction = this_direction
    }
    true
}

// `name = name.replace("X", "y")` with two one-byte literals: their bytes.
sema_stmt_ascii_replace: fn(statement: Stmt, name: String) -> [Int]? Never! {
    if statement == .Assign(target, op, _, value) {
        if op != None -> return None
        if target == {
            .Local(local_name, _) -> {
                if local_name != name -> return None
            }
            else -> return None
        }
        if sema_registration_cli_without_parens(value) == .MethodCall(receiver, method, _, _, _, args, _) {
            if method != "replace" || args.len() != 2 || sema_stmt_ident_name(receiver) != (Val(name)) -> return None
            from: sema_stmt_single_byte_literal(args[0]) ?? return None
            to: sema_stmt_single_byte_literal(args[1]) ?? return None
            return Val([Int]{from, to})
        }
    }
    None
}

// The name of a plain (possibly parenthesized) identifier.
sema_stmt_ident_name: fn(expression: Expr) -> String? Never! {
    if sema_registration_cli_without_parens(expression) == .Ident(name, _, _) -> return Val(name)
    None
}

// A plain one-byte string literal argument; the ladder only matches ASCII
// letters, so a longer (multi-byte) character never matches either.
sema_stmt_single_byte_literal: fn(arg: CallArg) -> Int? Never! {
    if arg.label != None || arg.spread -> return None
    if sema_registration_cli_without_parens(arg.expr) == .Str(parts, _, _) {
        if parts.len() == 1 && parts[0] == .Lit(text) {
            bytes: text.bytes()
            if bytes.len() == 1 -> return Val(Int.from_u8(bytes[0]))
        }
    }
    None
}

// An untyped `[]` (E0501) or bare `None` (E0308) binding
// reads ahead in its block for the first later use that implies its type: a
// push or insert argument, a map index store, an assignment, a return, or a
// typed call argument. The report names that line and type, labels the use,
// and carries a Safe edit that writes the typed start. With no implying use
// the report stays as the literal check wrote it.
SemaEmptyStartUse: struct {
    ty: Type
    span: Span
    what: String
}

// "list" for `[]`, "map" for an empty map literal, "none" for bare `None`.
sema_stmt_empty_start_kind: fn(init: Expr) -> String Never! {
    if sema_registration_cli_without_parens(init) == {
        .ListLit(elements, _, _) -> if elements.len() == 0 -> "list" else -> ""
        .MapLit(entries, _, _) -> if entries.len() == 0 -> "map" else -> ""
        .Absent(_, _) -> "none"
        .EnumLit(owner, variant, _, args, _, _, _) -> if owner == "" && variant == "None" && args.len() == 0 -> "none" else -> ""
        else -> ""
    }
}

// The name a use reads: a plain, parenthesized or marked identifier.
sema_stmt_empty_start_name: fn(expression: Expr) -> String Never! {
    if sema_registration_cli_without_parens(expression) == {
        .Ident(name, _, _) -> name
        .Place(value, _, _, _) -> sema_stmt_empty_start_name(value)
        else -> ""
    }
}

// The type a use's value shows without checking it: a literal's, or an
// earlier binding's declared type.
sema_stmt_empty_start_value_type: fn(value: Expr, scopes: SemaScopeTable) -> Type? {
    if sema_registration_cli_without_parens(value) == {
        .Str(_, _, _) -> Val(Type.String)
        .Int(_, _, width, _, _) -> if width == None -> Val(Type.Int) else -> None
        .Float(_, _, is_f32, _, _) -> if is_f32 -> None else -> Val(Type.Float)
        .Bool(_, _, _) -> Val(Type.Bool)
        .Present(inner, _, _) -> {
            payload: sema_stmt_empty_start_value_type(inner, scopes) ?? return None
            Val(Type.Option{inner: payload})
        }
        .EnumLit(owner, variant, _, args, _, _, _) -> {
            if owner != "" || variant != "Val" || args.len() != 1 -> return None
            if args[0] == .Positional(inner) {
                payload: sema_stmt_empty_start_value_type(inner, scopes) ?? return None
                return Val(Type.Option{inner: payload})
            }
            None
        }
        .Ident(name, _, _) -> {
            index: sema_scope_resolve_index(scopes, name) ?? return None
            scopes.bindings[index].symbol.ty
        }
        else -> None
    }
}

// "a `[String]`" / "an `Int`": `ty` named with its article.
sema_stmt_empty_start_a: fn(ty: Type) -> String Never! {
    text: type_name(ty)
    if text.starts_with("A") || text.starts_with("E") || text.starts_with("I") || text.starts_with("O") || text.starts_with("U") -> return "an `{text}`"
    "a `{text}`"
}

// The success type a `return` or value tail gives: origin tags and the
// failure contract (`T E!`) don't count.
sema_stmt_empty_start_success: fn(tagged: Type) -> Type Never! {
    ty: sema_expr_unwrap_tag(tagged)
    if ty == .Result(ok, _) -> return sema_expr_unwrap_tag(ok)
    ty
}

// A whole-value use (assignment, return, call argument) of type `ty`: the
// binding's type when it fits the start's shape. Origin tags don't count.
sema_stmt_empty_start_whole: fn(tagged: Type, kind: String, span: Span, what: String) -> SemaEmptyStartUse? Never! {
    ty: sema_expr_unwrap_tag(tagged)
    if kind == "none" {
        if ty == .Option(_) -> return Val(SemaEmptyStartUse{ty: ty, span: span, what: what})
        return Val(SemaEmptyStartUse{ty: Type.Option{inner: ty}, span: span, what: what})
    }
    if ty == {
        .List(_) -> if kind == "list" -> Val(SemaEmptyStartUse{ty: ty, span: span, what: what}) else -> None
        .Map(_, _, _) -> Val(SemaEmptyStartUse{ty: ty, span: span, what: what})
        else -> None
    }
}

// The parameter type at `position` of the function `callee` names in scope.
sema_stmt_empty_start_param_type: fn(callee: String, position: Int, scopes: SemaScopeTable) -> Type? {
    index: sema_scope_resolve_index(scopes, callee) ?? return None
    if scopes.bindings[index].symbol.ty == .Val(callee_ty) {
        if callee_ty == .Fn(params, _, _, _, _, _) {
            if position < params.len() -> return Val(params[position])
        }
    }
    None
}

// The first implying use of `name` in `statements` from `start`, looking into
// nested loop, switch and if bodies, binding values and call arguments; a
// later binding of the same name ends the search. `tail_span` is the value
// tail's span when `statements` is the block whose value `return_type` types.
sema_stmt_empty_start_use: fn(statements: [Stmt], start: Int, name: String, kind: String, return_type: Type?, tail_span: Span?, scopes: SemaScopeTable) -> SemaEmptyStartUse? {
    loop index in start..<statements.len() {
        if tail_span == .Val(tail_at) && index + 1 == statements.len() && statements[index] == .Expr(tail) {
            if sema_stmt_empty_start_name(tail) == name && tail_at.start == expr_span(tail).start {
                ty: sema_stmt_empty_start_success(return_type ?? return None)
                return sema_stmt_empty_start_whole(ty, kind, expr_span(tail), "gives `{name}` as the block's `{type_name(ty)}` value")
            }
        }
        found: sema_stmt_empty_start_use_in(statements[index], name, kind, return_type, scopes)
        if found != None -> return found
        if statements[index] == .Val(binding) && binding.name == name -> return None
    }
    None
}

sema_stmt_empty_start_use_in: fn(statement: Stmt, name: String, kind: String, return_type: Type?, scopes: SemaScopeTable) -> SemaEmptyStartUse? {
    if statement == {
        .Expr(expr) -> sema_stmt_empty_start_expr_use(expr, name, kind, return_type, scopes)
        .Val(binding) -> sema_stmt_empty_start_expr_use(binding.init, name, kind, return_type, scopes)
        .Assign(target, op, _, value) -> {
            if op != None -> return None
            if target == {
                .Local(target_name, _) -> {
                    if target_name != name -> return sema_stmt_empty_start_expr_use(value, name, kind, return_type, scopes)
                    ty: sema_stmt_empty_start_value_type(value, scopes) ?? return None
                    sema_stmt_empty_start_whole(ty, kind, expr_span(value), "assigns `{name}` {sema_stmt_empty_start_a(ty)}")
                }
                .Index(base, key, span, _) -> {
                    if kind == "none" || sema_stmt_empty_start_name(base) != name -> return None
                    key_ty: sema_stmt_empty_start_value_type(key, scopes) ?? return None
                    value_ty: sema_stmt_empty_start_value_type(value, scopes) ?? return None
                    Val(SemaEmptyStartUse{ty: Type.Map{key: key_ty, key_span: None, value: value_ty}, span: span, what: "stores {sema_stmt_empty_start_a(value_ty)} under {sema_stmt_empty_start_a(key_ty)} key in `{name}`"})
                }
                .Field(_, _, _) -> None
            }
        }
        .Return(value, _) -> {
            returned: value ?? return None
            if sema_stmt_empty_start_name(returned) != name -> return sema_stmt_empty_start_expr_use(returned, name, kind, return_type, scopes)
            ty: sema_stmt_empty_start_success(return_type ?? return None)
            sema_stmt_empty_start_whole(ty, kind, expr_span(returned), "returns `{name}` as the function's `{type_name(ty)}`")
        }
        .While(_, body, _, _, _) -> sema_stmt_empty_start_use(body, 0, name, kind, return_type, None, scopes)
        .For(_, _, _, _, body, _, _, _, _) -> sema_stmt_empty_start_use(body, 0, name, kind, return_type, None, scopes)
        .Loop(body, _, _, _) -> sema_stmt_empty_start_use(body, 0, name, kind, return_type, None, scopes)
        .CountedLoop(_, _, _, body, _, _, _) -> sema_stmt_empty_start_use(body, 0, name, kind, return_type, None, scopes)
        .Switch(_, arms, else_body, _) -> {
            loop arm in arms {
                found: sema_stmt_empty_start_use(arm.body, 0, name, kind, return_type, None, scopes)
                if found != None -> return found
            }
            if else_body == .Val(body) -> return sema_stmt_empty_start_use(body, 0, name, kind, return_type, None, scopes)
            None
        }
        else -> None
    }
}

// The first implying use of `name` inside call arguments `args`.
sema_stmt_empty_start_args_use: fn(args: [CallArg], name: String, kind: String, return_type: Type?, scopes: SemaScopeTable) -> SemaEmptyStartUse? {
    loop arg in args {
        found: sema_stmt_empty_start_expr_use(arg.expr, name, kind, return_type, scopes)
        if found != None -> return found
    }
    None
}

sema_stmt_empty_start_expr_use: fn(expr: Expr, name: String, kind: String, return_type: Type?, scopes: SemaScopeTable) -> SemaEmptyStartUse? {
    if expr == {
        .MethodCall(receiver, method, _, _, _, args, _) -> {
            if sema_stmt_empty_start_name(receiver) != name -> return sema_stmt_empty_start_args_use(args, name, kind, return_type, scopes)
            if kind == "none" -> return None
            if method == "push" && args.len() == 1 && kind == "list" {
                element: sema_stmt_empty_start_value_type(args[0].expr, scopes) ?? return None
                return Val(SemaEmptyStartUse{ty: Type.List{element: element}, span: args[0].span, what: "pushes {sema_stmt_empty_start_a(element)} onto `{name}`"})
            }
            if (method == "insert" || method == "add") && args.len() == 2 {
                key: sema_stmt_empty_start_value_type(args[0].expr, scopes) ?? return None
                value: sema_stmt_empty_start_value_type(args[1].expr, scopes) ?? return None
                // `List.insert(index, value)` and `Map.add(key, value)`.
                if method == "insert" {
                    if kind != "list" || key != .Int -> return None
                    return Val(SemaEmptyStartUse{ty: Type.List{element: value}, span: args[1].span, what: "inserts {sema_stmt_empty_start_a(value)} into `{name}`"})
                }
                return Val(SemaEmptyStartUse{ty: Type.Map{key: key, key_span: None, value: value}, span: args[1].span, what: "adds {sema_stmt_empty_start_a(value)} under {sema_stmt_empty_start_a(key)} key to `{name}`"})
            }
            None
        }
        .Call(call, _) -> {
            labeled := false
            loop (position, arg) in call.args {
                if arg.label != None || arg.spread -> labeled = true
                if sema_stmt_empty_start_name(arg.expr) == name {
                    if labeled -> return None
                    param: sema_stmt_empty_start_param_type(call.name, position, scopes) ?? return None
                    return sema_stmt_empty_start_whole(param, kind, arg.span, "passes `{name}` to `{call.name}` as {sema_stmt_empty_start_a(param)}")
                }
                found: sema_stmt_empty_start_expr_use(arg.expr, name, kind, return_type, scopes)
                if found != None -> return found
            }
            None
        }
        .Place(value, _, _, _) -> sema_stmt_empty_start_expr_use(value, name, kind, return_type, scopes)
        .Try(value, _, _, _, _) -> sema_stmt_empty_start_expr_use(value, name, kind, return_type, scopes)
        .OrFallback(value, _, _, _, _) -> sema_stmt_empty_start_expr_use(value, name, kind, return_type, scopes)
        .If(_, then_body, _, else_body, _, _, _) -> {
            found: sema_stmt_empty_start_use(then_body, 0, name, kind, return_type, None, scopes)
            if found != None -> return found
            sema_stmt_empty_start_use(else_body, 0, name, kind, return_type, None, scopes)
        }
        else -> None
    }
}

// The typed start a use implies, as source: `[String]{}`, `[String:Int]{}`,
// `Int?{None}`.
sema_stmt_empty_start_text: fn(ty: Type) -> String Never! {
    if ty == {
        .List(element) -> "[{type_name(element)}]{{}}"
        .Map(key, _, value) -> "[{type_name(key)}:{type_name(value)}]{{}}"
        .Option(inner) -> "{type_name(inner)}?{{None}}"
        else -> type_name(ty)
    }
}

// Rewrites the literal check's report for the untyped `binding` at
// `statements[index]` when a later use implies its type.
sema_stmt_empty_start_report: fn(binding: Binding, statements: [Stmt], index: Int, return_type: Type?, tail_span: Span?, environment: SemaScopeEnvironment, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) {
    if binding.ty != None || binding.pattern != None || binding.name == "" -> return
    kind: sema_stmt_empty_start_kind(binding.init)
    if kind == "" -> return
    code: if kind == "none" -> "E0308" else -> "E0501"
    site: expr_span(binding.init)
    reported := false
    loop diagnostic in diagnostics {
        if diagnostic.code == code && (diagnostic.span ?? Span{start: -1, end: -1}) == site -> reported = true
    }
    if !reported -> return
    found: sema_stmt_empty_start_use(statements, index + 1, binding.name, kind, return_type, tail_span, scopes) ?? return
    written: sema_stmt_empty_start_text(found.ty)
    what := "an empty list needs a type"
    if kind == "map" -> what = "an empty map needs a type"
    if kind == "none" -> what = "bare `None` needs a known optional type here"
    use_text := "a later line"
    if sema_source_line_at(environment.source_segments, found.span) == .Val(line) -> use_text = "line {line}"
    diagnostic: sema_error(code, site, what, "{use_text} {found.what}, so `{binding.name}` is `{type_name(found.ty)}`", "write `{written}`; `jet fix` writes it")
    labeled: diagnostic_with_label(diagnostic, found.span, "this use makes `{binding.name}` {sema_stmt_empty_start_a(found.ty)}")
    rewritten: diagnostic_with_edit_grade(labeled, TextEdit{span: site, new_text: written}, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving)
    // The literal check can run more than once over one binding; every copy
    // of its report becomes the rewritten one.
    loop position in 0..<diagnostics.len() {
        if diagnostics[position].code == code && (diagnostics[position].span ?? Span{start: -1, end: -1}) == site -> diagnostics[position] = rewritten.copy()
    }
}

// L0522 (check_stdlib_walk_filter): a loop over `fs.walk(root).list()` whose
// first line only skips directories (`if entry.is_dir { next }`) and whose
// other lines read the entry only as `entry.path`, with no exit or fallback
// route, restates `fs.walk_files(root)`.
sema_stmt_lint_walk_filter: fn(var: String, collection: Expr, body: [Stmt], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) {
    walk: sema_stmt_direct_fs_walk(collection, environment, program, scopes) ?? return
    if body.len() == 0 || !sema_stmt_is_directory_filter(body[0], var) -> return
    path_uses := 0
    loop index in 1..<body.len() {
        if sema_stmt_has_structural_control_flow(body[index]) -> return
        facts := SemaStmtWalkFacts{path_uses: 0, path_bases: [Int]{}, variable_uses: [Int]{}, fallback_exit: false}
        ast_visit_statement(body[index], (expression: Expr) -> sema_stmt_note_walk_use(facts, var, expression), true)
        if facts.fallback_exit -> return
        loop start in facts.variable_uses {
            if !sema_stmt_int_listed(facts.path_bases, start) -> return
        }
        path_uses += facts.path_uses
    }
    if path_uses == 0 -> return
    diagnostics.push(sema_lint("L0522", walk, "a direct fs.walk loop filters directories by hand", "fs.walk_files() already returns only file entries; the direct API keeps this control flow and intent together", "replace fs.walk with fs.walk_files"))
}

SemaStmtWalkFacts: struct {
    path_uses: Int
    path_bases: [Int]
    variable_uses: [Int]
    fallback_exit: Bool
}

sema_stmt_note_walk_use: fn(facts: &SemaStmtWalkFacts, var: String, expression: Expr) Never! {
    if expression == {
        .Field(base, member, _, _) -> {
            if member == "path" && sema_registration_cli_without_parens(base) == .Ident(name, span, _) {
                if name == var {
                    facts.path_bases.push(span.start)
                    facts.path_uses += 1
                }
            }
        }
        .Ident(name, span, _) -> {
            if name == var -> facts.variable_uses.push(span.start)
        }
        .OrFallback(_, _, _, _, _) | .Try(_, _, _, _, _) | .Todo(_, _, _) -> {
            facts.fallback_exit = true
        }
        .Call(call, _) -> {
            if call.name == "panic" -> facts.fallback_exit = true
        }
        else -> {}
    }
}

sema_stmt_int_listed: fn(values: [Int], wanted: Int) -> Bool Never! {
    loop value in values {
        if value == wanted -> return true
    }
    false
}

// `fs.walk(root).list()` (optionally `ignore:`), behind `??` or `?`, on the
// `core.files` import spelled `fs`: the span from `fs` through the walk
// call's `)`.
sema_stmt_direct_fs_walk: fn(collection: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> Span? {
    expression := sema_registration_cli_without_parens(collection)
    if expression == .OrFallback(value, _, _, _, _) -> expression = sema_registration_cli_without_parens(value)
    if expression == .Try(value, _, _, _, _) -> expression = sema_registration_cli_without_parens(value)
    if expression == .MethodCall(walked, collect, _, _, _, collected, _) {
        if collect != "list" || collected.len() != 0 -> return None
        expression = sema_registration_cli_without_parens(walked)
    } else {
        return None
    }
    if expression == .MethodCall(receiver, method, _, _, _, args, _) {
        if method != "walk" || args.len() < 1 || args.len() > 2 -> return None
        loop (index, arg) in args {
            if arg.spread -> return None
            if arg.label == .Val(label) {
                if index == 0 || label.name != "ignore" -> return None
            }
        }
        if sema_stmt_ident_name(receiver) != (Val("fs")) || !sema_expr_core_module_alias_visible("fs", scopes) -> return None
        if sema_call_core_import_module(environment, program, "fs") != (Val("core.files")) -> return None
        return Val(Span{start: expr_source_start(receiver), end: args[args.len() - 1].span.end + 1})
    }
    None
}

// `if entry.is_dir { next }` with no `else`.
sema_stmt_is_directory_filter: fn(statement: Stmt, var: String) -> Bool Never! {
    if statement == .Switch(subject, arms, else_body, span) {
        if else_body != None || arms.len() != 1 || !sema_stmt_refutable_is_subjectless_guard(subject, span) -> return false
        if arms[0].body.len() != 1 -> return false
        if arms[0].body[0] == {
            .Continue(_) -> {}
            else -> return false
        }
        if sema_registration_cli_without_parens(arms[0].cond) == .Field(base, member, _, _) -> return member == "is_dir" && sema_stmt_ident_name(base) == (Val(var))
    }
    false
}

// Rust stmt_has_structural_control_flow: an exit, a loop, a table or a task
// group, here or inside a plain nested block.
sema_stmt_has_structural_control_flow: fn(statement: Stmt) -> Bool Never! {
    if statement == {
        .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Yield(_, _) -> return true
        .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) -> return true
        .Switch(_, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .TaskGroup(_, _, _, _, _) -> return true
        .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .ComptimeBlock(body, _, _) | .ContextBlock(_, body, _) | .AuthorityScope(_, _, _, body, _) | .Live(body, _) | .AssumeDet(_, _, body, _) | .Transact(_, _, body, _, _) | .ScopeMember(_, _, _, _, body, _, _, _) | .Layout(_, _, body, _) -> {
            loop nested in body {
                if sema_stmt_has_structural_control_flow(nested) -> return true
            }
            return false
        }
        else -> return false
    }
}

// Rust check_block_inner's value-tail lints for a value block: L0513 when a
// fallback-free arm table of direct returns is followed by a default return,
// and L0530 when the last line is `return value`, which only
// repeats the implicit return. A last-line table hands its arms the value, and
// a last-line `#Unsafe` region its body.
sema_stmt_value_block_tail_lints: fn(statements: [Stmt], diagnostics: &[Diagnostic]) {
    count: statements.len()
    if count == 0 -> return
    if count >= 2 && sema_stmt_redundant_arm_table_span(statements[count - 2], statements[count - 1]) == .Val(table_span) {
        diagnostics.push(sema_lint("L0513", table_span, "this arm table is followed by a default return that can be its explicit `else` arm", "the value-table form keeps all outcomes together and lets the block return its final expression", "replace the table and fallback with an explicit `else` arm"))
    }
    if statements[count - 1] == {
        .Return(value, span) -> {
            if value == .Val(returned) {
                // The fix deletes `return` and the blank run after it, so the
                // value is left as the block tail.
                lint: sema_lint("L0530", Span{start: span.start, end: span.start + "return".len()}, "an explicit `return` is used on the final value line", "an unadorned expression on the final value line is Jet's implicit return; `return` is for early exits", "remove the final `return` and leave the expression as the block tail")
                diagnostics.push(diagnostic_with_edit_grade(lint, TextEdit{span: Span{start: span.start, end: expr_source_start(returned)}, new_text: ""}, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.Formatting))
            }
        }
        .Switch(_, arms, else_body, _) -> {
            loop arm in arms -> sema_stmt_value_block_tail_lints(arm.body, diagnostics)
            if else_body == .Val(rest) -> sema_stmt_value_block_tail_lints(rest, diagnostics)
        }
        .Unsafe(_, _, body, _) -> sema_stmt_value_block_tail_lints(body, diagnostics)
        else -> {}
    }
}

// Rust redundant_arm_table_parts: a value-dispatch table (not a subjectless
// guard or readiness table) with no `else`, whose arms each only return a
// value, then a default `return value`. The table's span when it matches.
sema_stmt_redundant_arm_table_span: fn(table: Stmt, fallback: Stmt) -> Span? Never! {
    if !sema_stmt_is_value_return(fallback) -> return None
    if table == .Switch(subject, arms, else_body, span) {
        if else_body != None || arms.len() == 0 || sema_stmt_refutable_is_subjectless_guard(subject, span) -> return None
        loop arm in arms {
            if sema_readiness_head(arm.cond) != None -> return None
            if arm.body.len() != 1 || !sema_stmt_is_value_return(arm.body[0]) -> return None
        }
        return Val(span)
    }
    None
}

sema_stmt_is_value_return: fn(statement: Stmt) -> Bool Never! {
    if statement == {
        .Return(value, _) -> value != None
        else -> false
    }
}

// Rust `check_value_tail` for the end of a value block: an empty block, one
// whose last line is a valueless builtin call (`print`, `assert`, …: Rust
// `check_call` hands back no type for these), or one whose last line is a
// statement that can still reach the end, reports E0114. A value line and a
// table report their own errors. False when E0114 was reported.
sema_stmt_check_value_block_end: fn(statements: [Stmt], checked: [TStmt], expected: Type?, block_span: Span, function_name: String, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if statements.len() == 0 {
        diagnostics.push(sema_stmt_missing_value(expected, None, function_name, block_span))
        return false
    }
    seen := 0
    // An earlier line that always leaves makes a valueless last line dead
    // code, not the block's value.
    left := false
    loop last in statements {
        seen += 1
        if seen < statements.len() {
            if sema_stmt_definitely_returns(last) -> left = true
            next
        }
        if last == {
            .Expr(value) -> {
                if left || sema_fallback_unit_call_name(value, scopes) == None -> return true
                diagnostics.push(sema_stmt_missing_value(expected, None, function_name, expr_span(value)))
                return false
            }
            .Return(_, _) | .Switch(_, _, _, _) -> return true
            .Unsafe(_, _, body, span) -> return sema_stmt_check_value_block_end(body, checked, expected, span, function_name, scopes, diagnostics)
            else -> {}
        }
        if !sema_stmt_tree_block_can_fall_through(checked) || sema_stmt_definitely_returns(last) -> return true
        diagnostics.push(sema_stmt_missing_value(expected, None, function_name, sema_compiler_index_stmt_span(last)))
        return false
    }
    true
}

sema_stmt_missing_value: fn(expected: Type?, uncovered: String?, function_name: String, span: Span) -> Diagnostic {
    expected_name: sema_type_show(expected ?? Type.Named{name: "Unit"})
    why: "a block that promises {expected_name} must end with a value of that type, or leave through `return` on every path"
    if uncovered == .Val(path) -> return sema_error("E0114", span, "when {path}, `{function_name}` reaches the end without a value", why, "add a last line that produces {expected_name} for that case, or turn the last guard into an `else`")
    sema_error("E0114", span, "this block promises to produce {expected_name}, but its last line produces no value", why, "end the block with an expression that produces {expected_name}, or `return` a value on every path")
}

// Rust `uncovered_guard_path`: the case that none of a value block's trailing
// `if cond -> return …` guards covers.
sema_stmt_uncovered_guard_path: fn(statements: [Stmt]) -> String? {
    reversed := [Expr]{}
    index := statements.len() - 1
    loop index >= 0 {
        guard_arms := [SwitchArm]?{None}
        if statements[index] == .Switch(guard_subject, switch_arms, guard_else, guard_span) {
            if guard_else == None && sema_stmt_refutable_is_subjectless_guard(guard_subject, guard_span) && switch_arms.len() > 0 -> guard_arms = Val(switch_arms)
        }
        arms: guard_arms ?? break
        loop arm in arms {
            if !sema_stmt_block_definitely_returns(arm.body) -> return sema_stmt_guard_path(reversed)
        }
        arm_index := arms.len() - 1
        loop arm_index >= 0 {
            reversed.push(arms[arm_index].cond)
            arm_index -= 1
        }
        index -= 1
    }
    sema_stmt_guard_path(reversed)
}

sema_stmt_guard_path: fn(reversed: [Expr]) -> String? {
    if reversed.len() == 0 -> return None
    conds := [Expr]{}
    index := reversed.len() - 1
    loop index >= 0 {
        conds.push(reversed[index])
        index -= 1
    }
    // Guards that compare one name with one whole number from both sides
    // (`n > 0`, `n < 0`) leave exactly that number.
    point_name := ""
    point_value := 0
    has_point := false
    below := false
    above := false
    single_point := true
    loop cond in conds {
        comparison := SemaGuardComparison?{None}
        if cond == .Binary(op, left, right, _, _) {
            if left == .Ident(name, _, _) && right == .Int(value, _, _, _, _) -> comparison = Val(SemaGuardComparison{op: op, name: name, value: value})
            if left == .Int(value, _, _, _, _) && right == .Ident(name, _, _) {
                flipped := op
                if op == BinOp.Lt -> flipped = BinOp.Gt
                if op == BinOp.Gt -> flipped = BinOp.Lt
                comparison = Val(SemaGuardComparison{op: flipped, name: name, value: value})
            }
        }
        found: comparison ?? {
            single_point = false
            break
        }
        if has_point && (found.name != point_name || found.value != point_value) {
            single_point = false
            break
        }
        point_name = found.name
        point_value = found.value
        has_point = true
        if {
            found.op == BinOp.Lt -> below = true
            found.op == BinOp.Gt -> above = true
            found.op == BinOp.Ne -> {
                below = true
                above = true
            }
            else -> {
                single_point = false
                break
            }
        }
    }
    if has_point && single_point && below && above -> return Val("`{point_name}` is `{point_value}`")
    texts := [String]{}
    loop cond in conds {
        text: sema_stmt_guard_text(cond) ?? return None
        texts.push("`{text}`")
    }
    if texts.len() == 1 -> return Val("{texts[0]} is false")
    Val("none of {texts.join(", ")} is true")
}

SemaGuardComparison: struct {
    op: BinOp
    name: String
    value: Int
}

// A guard condition as written. The reference quotes the source text; this
// spells the same simple forms and gives up (the generic E0114) otherwise.
sema_stmt_guard_text: fn(expr: Expr) -> String? {
    if expr == {
        .Ident(name, _, _) -> return Val(name)
        .Int(value, _, _, raw, _) -> return Val(raw ?? "{value}")
        .Bool(value, _, _) -> return Val(if value -> "true" else -> "false")
        .Field(base, member, _, _) -> {
            base_text: sema_stmt_guard_text(base) ?? return None
            return Val("{base_text}.{member}")
        }
        .Paren(inner, _, _) -> {
            inner_text: sema_stmt_guard_text(inner) ?? return None
            return Val("({inner_text})")
        }
        .Unary(op, operand, _, _) -> {
            operand_text: sema_stmt_guard_text(operand) ?? return None
            prefix: if op == UnOp.Not -> "!" else -> "-"
            return Val("{prefix}{operand_text}")
        }
        .Binary(op, left, right, _, _) -> {
            symbol: sema_stmt_guard_operator(op) ?? return None
            left_text: sema_stmt_guard_text(left) ?? return None
            right_text: sema_stmt_guard_text(right) ?? return None
            return Val("{left_text} {symbol} {right_text}")
        }
        else -> return None
    }
}

sema_stmt_guard_operator: fn(op: BinOp) -> String? {
    if op == {
        .Eq -> return Val("==")
        .Ne -> return Val("!=")
        .Lt -> return Val("<")
        .Gt -> return Val(">")
        .Le -> return Val("<=")
        .Ge -> return Val(">=")
        .And -> return Val("&&")
        .Or -> return Val("||")
        .Add -> return Val("+")
        .Sub -> return Val("-")
        .Mul -> return Val("*")
        .Div -> return Val("/")
        else -> return None
    }
}

// Rust `switch_arm_pattern` over every arm: each head is a structural pattern
// test (text and byte patterns can always miss).
sema_stmt_switch_all_patterns: fn(arms: [SwitchArm]) -> Bool Never! {
    if arms.len() == 0 -> return false
    loop arm in arms {
        if arm.cond == .PatternTest(_, pattern, _, _) {
            if pattern == {
                .StrMatch(_, _) | .BinMatch(_, _) -> return false
                else -> {}
            }
        } else {
            return false
        }
    }
    true
}

sema_stmt_switch_has_text_or_bytes: fn(arms: [SwitchArm]) -> Bool Never! {
    loop arm in arms {
        if arm.cond == .PatternTest(_, pattern, _, _) {
            if pattern == {
                .StrMatch(_, _) | .BinMatch(_, _) -> return true
                else -> {}
            }
        }
    }
    false
}

// Rust `check_switch` for a subject that is not a plain name: its pattern and
// range heads test `it`. A place subject reads the same value in every arm, so
// the heads read the place itself, as the value form does; any other subject is
// checked once and bound to `it`.
sema_stmt_check_subject_switch: fn(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> SemaStatementResult {
    subject_span: expr_span(subject)
    local: Expr.Ident{name: "it", span: subject_span, id: AST_NODE_GENERATED}
    if sema_expression_if_subject_is_place(subject) -> return sema_stmt_check_switch(local, sema_stmt_rebind_switch_arms(arms, subject_span, subject), else_body, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
    sema_scope_enter(scopes, state, "if.subject@{span.start}")
    carrier := false
    loop arm in arms {
        if sema_expression_if_condition_consumes_carrier(arm.cond) -> carrier = true
    }
    checked_subject: if carrier -> sema_check_expression_carrier(subject, None, environment, program, scopes, state, tail_store, context, diagnostics) else -> sema_check_expression(subject, None, environment, program, scopes, state, tail_store, context, diagnostics)
    init: checked_subject ?? {
        sema_single_use_leave_scope(scopes, state, diagnostics)
        return SemaStatementResult{value: [TStmt]{}, complete: false}
    }
    owner: sema_scope_local_owner_key(scopes)
    id: symbol_id(SymbolKind.Local, environment.module_identity, owner, "it")
    symbol: Symbol{id: id, kind: SymbolKind.Local, name: "it", module_name: environment.module_identity, owner: Val(owner), span: subject_span, ty: Val(init.ty), visibility: 0}
    // Rust `check_switch` declares `it` in its own scope with
    // `declare_in_scope`, so a nested subject table shadows the enclosing
    // table's `it` instead of reading it.
    it_frame: scopes.current
    bounds: checked_cost_integer_bounds(init)
    sema_scope_push_binding(scopes, SemaScopeBinding{frame: it_frame, symbol: symbol, mutable: false, access: AccessConvention.Read, integer_bounds: bounds, string_view: false, compiler_builtin: false})
    sema_ownership_declare_binding(state, symbol, false)
    // The arms' payload sources are rooted at `it`; the subject it holds
    // decides whether a payload moves out of a named place.
    sema_copy_site_note_subject(state, "it", subject_span, subject)
    it_local := checked_symbol_local("it", subject_span, id, init.ty)
    it_local.generated = true
    it_local.integer_bounds = bounds
    checked: sema_stmt_check_switch(local, sema_stmt_rebind_switch_arms(arms, subject_span, local), else_body, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
    sema_single_use_leave_scope(scopes, state, diagnostics)
    if !checked.complete -> return checked
    body := [TStmt]{TStmt.Let{local: it_local, let_ty: TLetTy.Inferred, init: init, gc_promotion: None, gc_transferred: false, span: subject_span}}
    loop statement in checked.value -> body.push(statement)
    SemaStatementResult{value: [TStmt]{TStmt.Inline{body: body, span: span}}, complete: true}
}

// Every arm head that tests the dispatch subject reads `replacement` instead.
sema_stmt_rebind_switch_arms: fn(arms: [SwitchArm], subject_span: Span, replacement: Expr) -> [SwitchArm] {
    rebound := [SwitchArm]{}
    loop arm in arms -> rebound.push(SwitchArm{cond: sema_expression_if_replace_subject(arm.cond, subject_span, replacement), body: arm.body, span: arm.span})
    rebound
}

// TStmt.If carries statement arms; value-producing if expressions need an
// InlineBlock consumer and therefore stay incomplete in this Sema slice.

// The type of a checked loop condition; an unchecked one reads as Bool.
sema_stmt_condition_type: fn(condition: TExpr?) -> Type Never! {
    // copy: the condition keeps its type; the caller compares or reports this one.
    if condition == .Val(value) -> return value.ty.copy()
    Type.Bool
}

sema_stmt_check_unit_branch: fn(body: [Stmt], value_expr: Expr, bindings: [SemaConditionBinding], return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], owner: String, loop_depth: Int) -> SemaStatementResult {
    sema_scope_enter(scopes, state, owner)
    sema_expression_declare_condition_bindings(bindings, scopes, state, true, diagnostics)
    result := sema_check_statements(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
    if result.complete {
        value_span: expr_span(value_expr)
        // The arm's value is discarded like an expression statement's, so an
        // arm may produce a value beside a Unit arm. A form that needs the
        // surrounding type (`()`, a missing `else`, `.Case`, `None`, an
        // inferred literal) still reads Unit.
        discarded: !sema_stmt_unit_arm_form(value_expr)
        expected: if discarded -> None else -> Val(Type.Named{name: "Unit"})
        fact_start: context.call_facts.len()
        checked_value := sema_check_expression(value_expr, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        if {
            checked_value == None -> result.complete = false
            else -> {
                value: checked_value ?? sema_node(context, Type.Named{name: "Unit"}, NodeKind.Unit, value_span)
                // A `()` value statement does nothing.
                unit := false
                if value.kind == .Flat(index) -> unit = context.arena.tree.nodes[index - context.arena.tree.node_base].kind == .Unit
                if {
                    !discarded || sema_stmt_type_is_unit_success(value.ty) -> {
                        if !unit -> result.value.push(TStmt.ExprStmt{value: value, span: value_span})
                    }
                    sema_stmt_type_is_fallible(value.ty) -> {
                        diagnostics.push(sema_error("E0402", value_span, "this call can fail and nothing checks it", "a fallible result can't be ignored — handle it or say failure is impossible", "use `?`, `??`, `panic ...`, or `.drop(\"reason\")` to intentionally discard"))
                        result.complete = false
                    }
                    else -> {
                        sema_must_use_check_statement(value_expr, value.ty, value_span, environment, program, scopes, diagnostics)
                        sema_stmt_mark_discarded_result(program, value, fact_start, context)
                        result.value.push(TStmt.ExprStmt{value: value, span: value_span})
                    }
                }
            }
        }
    }
    sema_single_use_leave_scope(scopes, state, diagnostics)
    result
}

// An arm value that reads the arm's Unit type rather than producing a value
// of its own: `()`, a missing `else`, or a form that needs the surrounding
// type (sema_expr_wants_expected_form).
sema_stmt_unit_arm_form: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Unit(_, _) | .NoElse(_, _) -> true
        else -> sema_expr_wants_expected_form(expr)
    }
}

sema_stmt_check_unit_if_parts: fn(condition: Expr, then_body: [Stmt], then_value: Expr, else_body: [Stmt], else_value: Expr, span: Span, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> SemaStatementResult {
    // E1403: an `if` is one source nesting level, and so is a whole
    // else-if chain: each link is checked at its head's level.
    if !sema_enter_source_nesting(context, span, diagnostics) -> return SemaStatementResult{value: [TStmt]{}, complete: false}
    // `if T == Int { … }` is the one-arm type test, checked
    // as a type-table arm: its body reads `T` as the named type.
    type_param: sema_expression_type_table_param(condition, environment, scopes)
    type_target := Type?{None}
    condition_check := SemaConditionCheck{checked: None, bindings: [SemaConditionBinding]{}}
    if type_param == .Val(param) {
        type_target = sema_stmt_type_switch_target(param, condition, [Type]{}, environment, program, scopes, diagnostics)
        if type_target == .Val(target) -> condition_check = sema_expression_condition_checked(sema_stmt_type_test_condition(param, target, expr_span(condition), context))
    } else {
        condition_check = sema_expression_check_condition(condition, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    checked_condition: condition_check.checked
    condition_bindings: condition_check.bindings
    // Both arms check in place on the live ownership state, each rolled back
    // to the fork (sema_ownership_fork), and their paths join after.
    fork: sema_ownership_fork(state)
    before_hardware: sema_scope_hardware_facts(scopes)
    then_mark: sema_scope_mark(scopes)
    then_return := return_type.copy()
    if type_param == .Val(param) && type_target == .Val(target) {
        names: [String]{param.copy()}
        actuals: [Type]{target.copy()}
        if return_type == .Val(declared) -> then_return = Val(sema_inference_substitute_type(declared, names, actuals))
        // After the mark, so the rollback below puts the rebound rows back.
        sema_stmt_type_switch_rebind(scopes, param, target)
    }
    then_result: sema_stmt_check_unit_branch(then_body, then_value, condition_bindings, then_return, environment, program, scopes, state, tail_store, context, diagnostics, "if.then@{span.start}", loop_depth)
    then_path: sema_ownership_fork_path(state, fork)
    sema_ownership_fork_rollback(state, fork)
    then_hardware: sema_scope_hardware_facts(scopes)
    sema_scope_rollback(scopes, then_mark)
    else_mark: sema_scope_mark(scopes)
    else_is_elseif := false
    else_result := SemaStatementResult{value: [TStmt]{}, complete: false}
    if else_value == {
        .If(_, _, _, _, _, _, _) -> {
            else_is_elseif = true
            if else_body.len() == 0 {
                sema_leave_source_nesting(context)
                else_result = sema_stmt_check_unit_if(else_value, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
                context.source_nesting += 1
            }
        }
        else -> else_result = sema_stmt_check_unit_branch(else_body, else_value, [SemaConditionBinding]{}, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "if.else@{span.start}", loop_depth)
    }
    else_path: sema_ownership_fork_path(state, fork)
    sema_ownership_fork_rollback(state, fork)
    sema_leave_source_nesting(context)
    else_hardware: sema_scope_hardware_facts(scopes)
    sema_scope_rollback(scopes, else_mark)
    // A branch that leaves (`return`, `break`, `next`) does not reach the
    // code after the `if`, so its moves are not moves there.
    then_reaches_merge: sema_stmt_tree_block_can_fall_through(then_result.value)
    else_reaches_merge: sema_stmt_tree_block_can_fall_through(else_result.value)
    // The single-use check reads the state before the branch, which the
    // rollback left live; the join reports nothing, so the order holds.
    single_use_paths := [SemaOwnershipPath]{}
    if then_reaches_merge -> single_use_paths.push(then_path.copy())
    if else_reaches_merge -> single_use_paths.push(else_path.copy())
    sema_single_use_check_paths(state, single_use_paths, diagnostics)
    base: sema_ownership_fork_base(fork)
    joined: if {
        then_reaches_merge && else_reaches_merge -> sema_ownership_path_join(state, fork, then_path, else_path, true, state.share_found)
        then_reaches_merge -> sema_ownership_path_join(state, fork, then_path, base, false, state.share_found)
        else_reaches_merge -> sema_ownership_path_join(state, fork, else_path, base, false, state.share_found)
        else -> sema_ownership_path_join(state, fork, base, base, false, state.share_found)
    }
    sema_ownership_fork_apply(state, joined)
    sema_ownership_fork_close(state, fork)
    // Only paths that reach the merge count (Rust `merge_paths`).
    if then_reaches_merge && !else_reaches_merge -> state.uninit = then_path.uninit
    if else_reaches_merge && !then_reaches_merge -> state.uninit = else_path.uninit
    loop site in then_path.share_found -> sema_ownership_note_share_found(state, site)
    loop site in else_path.share_found -> sema_ownership_note_share_found(state, site)
    sema_scope_join_hardware_paths(scopes, before_hardware, then_hardware, else_hardware, true)
    if checked_condition == None || !then_result.complete || !else_result.complete {
        return SemaStatementResult{value: [TStmt]{}, complete: false}
    }
    condition_tree: checked_condition ?? return SemaStatementResult{value: [TStmt]{}, complete: false}
    SemaStatementResult{
        value: [TStmt]{TStmt.If{condition: condition_tree.condition, then_body: then_result.value, else_body: Val(else_result.value), else_is_elseif: else_is_elseif, span: span}},
        complete: true,
    }
}

sema_stmt_check_unit_if: fn(expr: Expr, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> SemaStatementResult {
    if expr == {
        .If(condition, then_body, then_value, else_body, else_value, span, _) -> {
            // A dispatch table binds a call subject once before the chain
            // that tests it, exactly like the value form.
            if sema_expression_if_dispatch_subject(condition, else_value) == .Val(subject) {
                // A value table's `it` lives in the table's own scope.
                table_it: sema_expression_if_subject_is_table_it(subject)
                if table_it -> sema_scope_enter(scopes, state, "if.it@{span.start}")
                bound: sema_expression_if_bind_subject(subject, condition, else_value, environment, program, scopes, state, tail_store, context, diagnostics)
                table := if bound != None -> sema_stmt_check_unit_if_parts(sema_expression_if_rebound_condition(subject, condition), then_body, then_value, else_body, sema_expression_if_rebound_chain(subject, else_value), span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth) else -> SemaStatementResult{value: [TStmt]{}, complete: false}
                if table_it -> sema_single_use_leave_scope(scopes, state, diagnostics)
                binding: bound ?? return SemaStatementResult{value: [TStmt]{}, complete: false}
                if !table.complete -> return table
                statements := [TStmt]{binding}
                loop statement in table.value -> statements.push(statement)
                return SemaStatementResult{value: statements, complete: true}
            }
            // A stable `x == None` test reads as its presence
            // test with the branches swapped, as in the value form.
            if sema_expression_absent_optional_test(condition) == .Val(test) {
                if sema_expression_flow_optional_payload(scopes, test.name.name) != None && sema_expression_if_absent_test_swaps(else_value, test.name.name) -> return sema_stmt_check_unit_if_parts(sema_expression_presence_test(test.name, test.span), else_body, else_value, then_body, then_value, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
            }
            sema_stmt_check_unit_if_parts(condition, then_body, then_value, else_body, else_value, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
        }
        else -> SemaStatementResult{value: [TStmt]{}, complete: false}
    }
}
sema_stmt_check_switch: fn(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> SemaStatementResult {
    subject_is_true: if subject == {
        .Bool(value, _, _) -> value
        else -> false
    }
    // A folded multi-head function is the same table of self-contained
    // pattern tests over its synthetic parameter.
    multi_head: if subject == {
        .Ident(name, _, _) -> name == "__jet_multi_head_subject"
        else -> false
    }
    // `if T == { Int -> … else -> … }` over a type parameter
    // is a type table (sema_stmt_type_switch_param).
    type_param := String?{None}
    if !(subject_is_true || multi_head) -> type_param = sema_stmt_type_switch_param(subject, environment, scopes)
    type_arms := [Type]{}
    // Rust `check_switch`: the arms of `if subject OP { … }` over a plain name
    // test that name directly; any other subject is read once as the `it` the
    // pattern heads test.
    if !(subject_is_true || multi_head) {
        if subject == {
            .Ident(_, _, _) -> {}
            else -> return sema_stmt_check_subject_switch(subject, arms, else_body, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
        }
    }
    // Rust `check_value_tail`: a table that ends a value block is that
    // block's value, so each arm ends in a value line or leaves.
    value_tail: context.value_tail_span == (Val(span))
    // `if x == None -> a else -> b` over a stable Optional
    // reads as `if x == .Val(x) -> b else -> a`, so `b` holds the payload.
    // The guard is evaluated once at the same point; only the mutually
    // exclusive bodies change places (Rust `check_switch`).
    subjectless_guard: sema_stmt_refutable_is_subjectless_guard(subject, span)
    if subjectless_guard && arms.len() == 1 && else_body == .Val(present_body) {
        if sema_expression_absent_optional_test(arms[0].cond) == .Val(test) {
            if sema_expression_flow_optional_payload(scopes, test.name.name) != None {
                present_arm: SwitchArm{cond: sema_expression_presence_test(test.name, test.span), body: present_body, span: arms[0].span}
                return sema_stmt_check_switch(subject, [SwitchArm]{present_arm}, Val(arms[0].body), span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
            }
        }
    }
    // Arm conditions are checked on the fallthrough path in place; each arm
    // body and the else body are checked in place and rolled back, on the
    // scope table and on the ownership state (sema_ownership_fork). Paths are
    // taken against the state before the table, `fork`.
    fork: sema_ownership_fork(state)
    before_hardware: sema_scope_hardware_facts(scopes)
    fallthrough_mark: sema_scope_mark(scopes)
    conditions := [SemaCheckedCondition?]{}
    branches := [SemaStatementResult]{}
    branch_hardware := [SemaScopeHardwareFacts]{}
    merged_path := sema_ownership_fork_base(fork)
    has_branch := false
    arm_found := [SemaOwnershipShareSite]{}
    complete := true
    single_use_paths := [SemaOwnershipPath]{}
    // Rust `check_switch`: a subjectless table with a readiness arm waits on
    // channels and timers; its heads are not Boolean guards.
    readiness: subjectless_guard && sema_readiness_is_table(arms)
    readiness_table := sema_readiness_table_new()
    arm_index := 0
    loop arm_index < arms.len() {
        // The arm is read in place (`arms[arm_index]`): binding it copied the
        // whole arm, its body included.
        arm_bindings := [SemaConditionBinding]{}
        // A type-table arm checks its body with `T` read as the arm's type
        // (sema_stmt_type_switch_rebind after the branch mark below).
        arm_target := Type?{None}
        arm_return := Type?{None}
        // A guard arm `T == Int` (the one-arm `if T == Int { … }`, or an
        // `else if` link) is the same type test.
        arm_param := type_param.copy()
        if subject_is_true && !readiness -> arm_param = sema_expression_type_table_param(arms[arm_index].cond, environment, scopes)
        if readiness {
            if sema_readiness_check_head(arms[arm_index].cond, readiness_table, environment, program, scopes, state, tail_store, context, diagnostics) == .Val(binding) -> arm_bindings.push(binding)
            if readiness_table.arms[arm_index] == None -> complete = false
        } else if arm_param == .Val(param) {
            target := sema_stmt_type_switch_target(param, arms[arm_index].cond, type_arms, environment, program, scopes, diagnostics)
            if target == .Val(arm_type) {
                if return_type == .Val(declared) -> arm_return = Val(sema_inference_substitute_type(declared, [String]{param}, [Type]{arm_type}))
                type_arms.push(arm_type.copy())
                arm_target = Val(arm_type)
                conditions.push(Val(sema_stmt_type_test_condition(param, arm_type, expr_span(arms[arm_index].cond), context)))
            } else {
                complete = false
                conditions.push(None)
            }
        } else {
            condition_result := sema_expression_check_condition(arms[arm_index].cond, environment, program, scopes, state, tail_store, context, diagnostics)
            if condition_result.checked == None -> complete = false
            arm_bindings = condition_result.bindings
            conditions.push(condition_result.checked)
        }
        branch_mark: sema_scope_mark(scopes)
        // After the mark, so the rollback below puts the rebound rows back.
        if arm_param == .Val(param) && arm_target == .Val(arm_type) -> sema_stmt_type_switch_rebind(scopes, param, arm_type)
        branch_fork: sema_ownership_fork(state)
        sema_scope_enter(scopes, state, "if.arm@{arms[arm_index].span.start}")
        sema_expression_declare_condition_bindings(arm_bindings, scopes, state, true, diagnostics)
        if value_tail -> context.value_tail_span = sema_stmt_value_tail_marker(arms[arm_index].body)
        branch := if arm_return != None -> sema_check_statements(arms[arm_index].body, arm_return, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth) else -> sema_check_statements(arms[arm_index].body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
        // An arm whose body did not check leaves no complete checked tree for it; the
        // table must not lower that arm as an empty fall-through.
        if !branch.complete -> complete = false
        if value_tail {
            context.value_tail_span = Val(span)
            ends: if arm_return != None -> sema_stmt_check_value_block_end(arms[arm_index].body, branch.value, arm_return, arms[arm_index].span, context.function_name, scopes, diagnostics) else -> sema_stmt_check_value_block_end(arms[arm_index].body, branch.value, return_type, arms[arm_index].span, context.function_name, scopes, diagnostics)
            if !ends -> complete = false
        }
        sema_single_use_leave_scope(scopes, state, diagnostics)
        branch_path := sema_ownership_fork_path(state, fork)
        sema_ownership_fork_rollback(state, branch_fork)
        sema_ownership_fork_close(state, branch_fork)
        branch_hardware.push(sema_scope_hardware_facts(scopes))
        sema_scope_rollback(scopes, branch_mark)
        falls_through: sema_stmt_tree_block_can_fall_through(branch.value)
        branches.push(branch)
        // An arm that leaves does not reach the merge.
        loop site in branch_path.share_found -> arm_found.push(site)
        if falls_through {
            if has_branch {
                merged_path = sema_ownership_path_join(state, fork, merged_path, branch_path, true, merged_path.share_found)
            } else {
                // copy: the first falling-through arm's path is both the merge
                // seed and its own row of the single-use check below.
                merged_path = branch_path.copy()
                has_branch = true
            }
            single_use_paths.push(branch_path)
        }
        arm_index += 1
    }
    if subjectless_guard && !readiness -> sema_stmt_lint_same_enum_guards(arms, conditions, span, diagnostics)
    else_result := [TStmt]?{None}
    else_fork: sema_ownership_fork(state)
    else_mark: sema_scope_mark(scopes)
    if else_body == .Val(body) {
        complement: sema_stmt_else_presence_names(arms, scopes)
        if value_tail -> context.value_tail_span = sema_stmt_value_tail_marker(body)
        checked_else := if complement.len() == 0 -> sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "if.else@{span.start}", loop_depth) else -> sema_stmt_check_else_complement(complement, body, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
        if !checked_else.complete -> complete = false
        if value_tail {
            context.value_tail_span = Val(span)
            if !sema_stmt_check_value_block_end(body, checked_else.value, return_type, span, context.function_name, scopes, diagnostics) -> complete = false
        }
        checked_value := checked_else.value.move()
        checked_else.value = [TStmt]{}
        else_result = Val(checked_value.move())
    }
    else_path: sema_ownership_fork_path(state, fork)
    sema_ownership_fork_rollback(state, else_fork)
    sema_ownership_fork_close(state, else_fork)
    else_hardware: sema_scope_hardware_facts(scopes)
    sema_scope_rollback(scopes, else_mark)
    sema_scope_rollback(scopes, fallthrough_mark)
    hardware_merged := sema_scope_hardware_facts(scopes)
    if branch_hardware.len() > 0 {
        hardware_merged = branch_hardware[0]
        branch_hardware_index := 1
        loop branch_hardware_index < branch_hardware.len() {
            hardware_merged = sema_scope_hardware_join(before_hardware, hardware_merged, branch_hardware[branch_hardware_index], true)
            branch_hardware_index += 1
        }
    }
    // A blocking readiness wait always selects an arm, so without an `else`
    // no path skips the table (Rust merges only the arm paths).
    else_reaches_merge: if else_body == None -> !readiness else -> sema_stmt_tree_block_can_fall_through(else_result ?? [TStmt]{})
    // The fallthrough path ends here: the live state is the one before the
    // table again, which the single-use check reads; the join reports
    // nothing, so the order holds.
    sema_ownership_fork_rollback(state, fork)
    if else_reaches_merge -> single_use_paths.push(else_path.copy())
    sema_single_use_check_paths(state, single_use_paths, diagnostics)
    base: sema_ownership_fork_base(fork)
    joined: if {
        has_branch && else_reaches_merge -> sema_ownership_path_join(state, fork, merged_path, else_path, true, state.share_found)
        has_branch -> sema_ownership_path_join(state, fork, merged_path, merged_path, true, state.share_found)
        else_reaches_merge -> sema_ownership_path_join(state, fork, else_path, else_path, true, state.share_found)
        else -> sema_ownership_path_join(state, fork, base, base, false, state.share_found)
    }
    sema_ownership_fork_apply(state, joined)
    sema_ownership_fork_close(state, fork)
    loop site in arm_found -> sema_ownership_note_share_found(state, site)
    loop site in else_path.share_found -> sema_ownership_note_share_found(state, site)
    sema_scope_join_hardware_paths(scopes, before_hardware, hardware_merged, else_hardware, true)
    // Types are an open set, so a type table ends in `else`.
    if type_param != None && else_body == None {
        diagnostics.push(sema_error("E0003", span, "a type table needs an `else` arm", "types are an open set, so no list of type arms covers every `{type_param ?? ""}`", "add `else -> {{ ... }}` after the last arm"))
        return SemaStatementResult{value: [TStmt]{}, complete: false}
    }
    if !complete -> return SemaStatementResult{value: [TStmt]{}, complete: false}
    if readiness {
        table_tree: sema_readiness_tree(readiness_table, branches, else_result, span, context) ?? return SemaStatementResult{value: [TStmt]{}, complete: false}
        return SemaStatementResult{value: [TStmt]{table_tree}, complete: true}
    }
    // Rust `check_switch` notes each all-pattern arm's coverage (E0365/L0301),
    // with or without an `else`, before the E0307 completeness proof. A type
    // table noted its repeated arms itself (sema_stmt_type_switch_target).
    if !subjectless_guard && type_param == None {
        noted_conditions := [TExpr]{}
        loop condition in conditions {
            if condition == .Val(noted) -> noted_conditions.push(noted.value)
        }
        if noted_conditions.len() == conditions.len() -> sema_coverage_check_unreachable_arms(noted_conditions, multi_head, diagnostics)
    }
    // A subjectless guard table proves no coverage: its arms test their own
    // subjects (Rust `check_switch` skips E0307 for subjectless guards).
    if else_body == None && !subjectless_guard {
        // Rust `check_switch`: only an all-pattern table can prove that one
        // arm always matches; a text or byte pattern is left to coverage.
        if !multi_head && !sema_stmt_switch_all_patterns(arms) && !sema_stmt_switch_has_text_or_bytes(arms) {
            diagnostics.push(sema_error("E0003", span, "this `if` needs an `else` arm", "mixed condition arms (or non-pattern arms) must always have a fallback", "add `else -> {{ ... }}` after the last arm"))
            return SemaStatementResult{value: [TStmt]{}, complete: false}
        }
        checked_conditions := [TExpr]{}
        loop condition in conditions {
            checked: condition ?? return SemaStatementResult{value: [TStmt]{}, complete: false}
            checked_conditions.push(checked.value)
        }
        sema_coverage_check_table(checked_conditions, multi_head, span, environment, program, diagnostics)
        // Rust `lower_enum_match`: the miss path of a covered else-less table
        // is unreachable (codegen ends it in an Unreachable terminator), so it
        // never falls through to the join, exactly as
        // sema_stmt_refutable_switch_exits already assumes.
        else_result = Val([TStmt]{TStmt.ExprStmt{value: sema_node(context, Type.Named{name: "Never"}, NodeKind.Never{reason: "no else arm", line: 0}, span), span: span}})
    }
    loop condition in conditions {
        if condition == None -> return SemaStatementResult{value: [TStmt]{}, complete: false}
    }
    SemaStatementResult{value: sema_stmt_switch_chain(conditions, branches, arms, else_result, span) ?? [TStmt]{}, complete: true}
}

// The subject of `if T == { … }` when it names a type
// parameter of the function being checked that no value binding shadows.
sema_stmt_type_switch_param: fn(subject: Expr, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> String? {
    if subject == {
        .Ident(name, _, _) -> {
            if sema_scope_resolve_index(scopes, name) != None -> return None
            loop parameter in environment.generic_params {
                if parameter.name == name -> return Val(name.copy())
            }
        }
        else -> {}
    }
    None
}

// The type an arm head names. `Int -> …` arrives as the value-head test
// `T == Int`; a head may be a plain name or an alias-qualified one. None for
// any other head.
sema_stmt_type_switch_head: fn(param: String, condition: Expr) -> NamedSpan? {
    if condition == {
        .Binary(op, left, right, _, _) -> {
            if op != BinOp.Eq -> return None
            if left == {
                .Ident(name, _, _) -> {
                    if name != param -> return None
                }
                else -> return None
            }
            if right == {
                .Ident(name, span, _) -> return Val(NamedSpan{name: name.copy(), span: span})
                .Field(base, member, span, _) -> {
                    if base == .Ident(alias, _, _) -> return Val(NamedSpan{name: "{alias}.{member}", span: span})
                }
                else -> {}
            }
        }
        else -> {}
    }
    None
}

// The type a written arm name means here: a primitive spelling, or a
// declared or imported type resolved as a signature resolves it, so an
// alias is its target.
sema_stmt_type_switch_resolve: fn(name: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Type? {
    primitive: foundation_named_type(name)
    if primitive == {
        .Named(_) -> {}
        else -> return Val(primitive)
    }
    graph: program.registration_graph ?? return None
    resolved: sema_type_graph_lookup_symbol(graph, environment.module_identity, name) ?? return None
    if sema_resolved_kind(graph, resolved) != SymbolKind.Type -> return None
    Val(sema_type_resolve_declared(graph, Type.Named{name: name}, environment.module_identity))
}

// One arm of a type table: the type it tests, or None after its error. Each
// arm names one known type (E0119), and no type twice (E0365): matching is
// exact type identity of the resolved type.
sema_stmt_type_switch_target: fn(param: String, condition: Expr, earlier: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Type? {
    head: sema_stmt_type_switch_head(param, condition) ?? {
        diagnostics.push(sema_error("E0119", sema_stmt_type_switch_head_span(condition), "a type-table arm must name a type", "`if {param} == {{ … }}` compares the type `{param}`, not a value", "write a type such as `Int`, or `else`"))
        return None
    }
    target: sema_stmt_type_switch_resolve(head.name, environment, program) ?? {
        diagnostics.push(sema_error("E0119", head.span, "`{head.name}` isn't a known type", "a type-table arm names one type: a primitive, a declared type, or an imported one", "check the spelling, or import the type"))
        return None
    }
    identity: type_carrier_identity(target)
    loop seen in earlier {
        if type_carrier_identity(seen) == identity {
            diagnostics.push(sema_error("E0365", head.span, "arm `{head.name}` is unreachable — that type is already handled", "an earlier arm already names the same type", "remove this arm or merge it with the one above"))
            return None
        }
    }
    Val(target)
}

// The written head of a type-table arm, `0` in `T == 0`, for its error.
sema_stmt_type_switch_head_span: fn(condition: Expr) -> Span {
    if condition == {
        .Binary(_, _, right, _, _) -> expr_span(right)
        .PatternTest(_, pattern, _, _) -> sema_pattern_span(pattern)
        else -> expr_span(condition)
    }
}

// The checked condition of a type-table arm: a TypeTest of `T` against the
// arm's type, which the IR folds per instance (ir_folded_type_test).
sema_stmt_type_test_condition: fn(param: String, target: Type, span: Span, context: &SemaCheckContext) -> SemaCheckedCondition {
    test: sema_node(context, Type.Bool, NodeKind.TypeTest{subject: Type.Named{name: param.copy()}, target: target.copy()}, span)
    SemaCheckedCondition{condition: TIfCond.Plain{value: test.copy()}, value: test, bindings: [SemaConditionBinding]{}}
}

// Inside a type-table arm `T` reads as the arm's type: each local and
// parameter whose type names `T` takes the substituted type. The caller's
// branch rollback puts the rows back.
sema_stmt_type_switch_rebind: fn(scopes: &SemaScopeTable, param: String, target: Type) Never! {
    names: [String]{param.copy()}
    actuals: [Type]{target.copy()}
    loop index in 0..<scopes.bindings.len() {
        rebound: sema_stmt_type_switch_rebound(scopes.bindings[index].symbol, names, actuals) ?? next
        sema_scope_note_binding_edit(scopes, index)
        scopes.bindings[index].symbol.ty = Val(rebound)
    }
}

sema_stmt_type_switch_rebound: fn(symbol: Symbol, names: [String], actuals: [Type]) -> Type? Never! {
    if symbol.kind != SymbolKind.Local && symbol.kind != SymbolKind.Parameter -> return None
    declared: symbol.ty ?? return None
    if !sema_checked_type_contains_name(declared, names) -> return None
    Val(sema_inference_substitute_type(declared, names, actuals))
}

// The checked switch as the else-if chain codegen lowers, built from the
// last arm back: each level moves its condition and checked body out of the
// consumed rows and the chain so far into the new level, so no checked body
// is copied (the old recursion copied every arm's body and the else body).
sema_stmt_switch_chain: fn(conditions: &&[SemaCheckedCondition?], branches: &&[SemaStatementResult], arms: [SwitchArm], else_result: &&[TStmt]?, span: Span) -> [TStmt]? {
    owned_conditions := conditions.move()
    owned_branches := branches.move()
    chain := else_result.move()
    index := arms.len()
    loop index > 0 {
        index -= 1
        condition_row := owned_conditions.pop() ?? return None
        condition := condition_row.move() ?? return None
        branch := owned_branches.pop() ?? return None
        arm_span: if index == 0 -> span else -> arms[index].span
        rest := chain.move()
        chain = Val([TStmt]{TStmt.If{condition: condition.condition.move(), then_body: branch.value.move(), else_body: rest.move(), else_is_elseif: index + 1 < arms.len(), span: arm_span}})
    }
    chain
}

sema_stmt_range_integer_type: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int -> true
        .InlineRange(_, _, _) -> true
        else -> false
    }
}

sema_stmt_check_range_endpoint: fn(expr: Expr, which: String, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    value: sema_check_expression(expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    if !sema_stmt_range_integer_type(value.ty) {
        diagnostics.push(sema_error("E0109", expr_span(expr), "the {which} of a `for` range must be Int, not {type_name(value.ty)}", "`loop` counts whole numbers between two ends", "use Int values for both ends, like `1..10` or `0..<n`"))
        return None
    }
    Val(value)
}

sema_stmt_check_range_stride: fn(expr: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    value: sema_check_expression(expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    if !sema_stmt_range_integer_type(value.ty) {
        diagnostics.push(sema_error("E0123", expr_span(expr), "a range loop stride must be Int, not {type_name(value.ty)}", "the stride is how far to count each turn, so it must be a whole number", "use an Int stride, like `loop i in 0..10, 2`"))
        return None
    }
    if expr == {
        .Int(n, span, _, _, _) -> {
            if n <= 0 {
                diagnostics.push(sema_error("E0123", span, "a range loop stride must be positive, not {n}", "a zero or negative stride would never reach the end", "use a stride of 1 or more, like `loop i in 0..10, 2 {{ ... }}`"))
                return None
            }
        }
        else -> {}
    }
    Val(value)
}

// A number written in the source, with an optional
// leading minus (Rust `written_range_int`).
sema_range_written_int: fn(expr: Expr) -> Int? {
    if expr == {
        .Int(value, _, _, _, _) -> Val(value)
        .Paren(inner, _, _) -> sema_range_written_int(inner)
        .Unary(op, operand, _, _) -> {
            if op != UnOp.Neg -> return None
            value: sema_range_written_int(operand) ?? return None
            Val(0 - value)
        }
        else -> None
    }
}

// Written ends and step that count in opposite
// directions are E0170 (Rust `backward_range_diagnostic`). A loop range gets
// a fix edit for its step; a range value is taught to write its ends in order.
sema_range_backward_diagnostic: fn(start: Expr, end: Expr, step: Expr?, exclusive: Bool, loop_range: Bool) -> Diagnostic? {
    s: sema_range_written_int(start) ?? return None
    e: sema_range_written_int(end) ?? return None
    op: if exclusive -> "..<" else -> ".."
    written_step := Int?{None}
    if step == .Val(step_expr) -> written_step = sema_range_written_int(step_expr)
    range_span: Span{start: expr_span(start).start, end: expr_span(end).end}
    if s > e {
        if step == .Val(step_expr) {
            k: written_step ?? return None
            if k <= 0 -> return None
            diagnostic: sema_error("E0170", expr_span(step_expr), "this range counts down from {s} to {e} but its step {k} counts up", "a positive step moves away from {e}, so the loop would run zero times", "make the step negative: `{s}{op}{e}, -{k}`")
            return Val(diagnostic_with_edit(diagnostic, TextEdit{span: expr_span(step_expr), new_text: "-{k}"}))
        }
        if !loop_range -> return Val(sema_error("E0170", range_span, "this range counts down from {s} to {e} and holds no numbers", "a range value always counts up from its start, so a bigger start leaves it empty", "write the smaller end first, `{e}{op}{s}`; count down in a loop with `{s}{op}{e}, -1`"))
        diagnostic: sema_error("E0170", range_span, "this range counts down from {s} to {e} but has no step", "a range without a step counts up, so `{s}{op}{e}` would run zero times", "add the minus step: `{s}{op}{e}, -1`")
        end_at: expr_span(end).end
        return Val(diagnostic_with_edit(diagnostic, TextEdit{span: Span{start: end_at, end: end_at}, new_text: ", -1"}))
    }
    if s < e && step == .Val(step_expr) {
        k: written_step ?? return None
        if k >= 0 -> return None
        up: 0 - k
        diagnostic: sema_error("E0170", expr_span(step_expr), "this range counts up from {s} to {e} but its step {k} counts down", "a negative step moves away from {e}, so the loop would run zero times", "make the step positive: `{s}{op}{e}, {up}`")
        return Val(diagnostic_with_edit(diagnostic, TextEdit{span: expr_span(step_expr), new_text: "{up}"}))
    }
    None
}

SemaForInIterableFact: struct {
    method_kind: TForInMethod
    item_type: Type
}
SemaForInPairTypes: struct {
    first: Type
    second: Type
}

sema_stmt_for_in_named_type_name: fn(ty: Type) -> String? {
    if ty == {
        .Named(name) -> return Val(name)
        else -> return None
    }
}

sema_stmt_for_in_type_is_named: fn(ty: Type, name: String) -> Bool Never! {
    actual: sema_stmt_for_in_named_type_name(ty) ?? return false
    actual == name || actual.ends_with("::{name}")
}

sema_stmt_for_in_type_requires_owned_iteration: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, args) -> {
            if name == "ViewMut" -> return false
            if name == "Task" -> return true
            loop arg in args {
                if sema_stmt_for_in_type_requires_owned_iteration(arg) -> return true
            }
            return false
        }
        .List(inner) | .FixedList(inner, _) -> return sema_stmt_for_in_type_requires_owned_iteration(inner)
        .Tuple(fields) -> {
            loop field in fields {
                if sema_stmt_for_in_type_requires_owned_iteration(field.ty) -> return true
            }
            return false
        }
        .Option(inner) | .Shared(inner) -> return sema_stmt_for_in_type_requires_owned_iteration(inner)
        .Result(ok, err) -> return sema_stmt_for_in_type_requires_owned_iteration(ok) || sema_stmt_for_in_type_requires_owned_iteration(err)
        .Map(key, _, value) -> return sema_stmt_for_in_type_requires_owned_iteration(key) || sema_stmt_for_in_type_requires_owned_iteration(value)
        else -> return false
    }
}

sema_stmt_for_in_encoding_item_type: fn(name: String) -> Type? {
    if sema_stmt_for_in_type_is_named(Type.Named{name: name}, "JSONReader") || sema_stmt_for_in_type_is_named(Type.Named{name: name}, "CBORReader") -> return Val(Type.Named{name: "DataEvent"})
    if sema_stmt_for_in_type_is_named(Type.Named{name: name}, "JSONLReader") || sema_stmt_for_in_type_is_named(Type.Named{name: name}, "XMLReader") -> return Val(Type.Named{name: "Dyn"})
    if sema_stmt_for_in_type_is_named(Type.Named{name: name}, "CSVReader") -> return Val(Type.Named{name: "CSVRow"})
    None
}

sema_stmt_for_in_iterable_fact: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, collection_type: Type) -> SemaForInIterableFact? {
    if sema_stmt_for_in_named_type_name(collection_type) == None -> return None
    if program.registration_graph == .Val(graph) {
        // Impls key their target by the declaring nominal's identity, so a
        // source type and its `Iter` resolve to that nominal first (a Core
        // type written by its bare name, `HTTPBodyChunks`, included).
        collection_identity := type_identity_key(collection_type)
        if sema_type_resolve_nominal_row_at(graph, collection_type, sema_scope_caller_row(environment, graph)) == .Val(row) -> collection_identity = graph.modules[row.module_index].nominals[row.row].identity_key
        iterable_impl := SemaRegistrationImpl?{None}
        iterable_module := -1
        loop module_row_index in 0..<graph.modules.len() {
            loop implementation_index in 0..<graph.modules[module_row_index].impls.len() {
                if graph.modules[module_row_index].impls[implementation_index].trait_name != (Val("Iterable")) || graph.modules[module_row_index].impls[implementation_index].target_identity_key != collection_identity -> next
                iterable_impl = Val(graph.modules[module_row_index].impls[implementation_index])
                iterable_module = module_row_index
            }
        }
        iterable: iterable_impl ?? return None
        iter_type := Type?{None}
        iter_symbol := String?{None}
        loop associated in iterable.associated_types {
            if associated.symbol.name == "Iter" -> iter_type = Val(associated.ty)
        }
        loop method in iterable.methods {
            if method.declaration.name == "iter" -> iter_symbol = Val(method.symbol.id.key)
        }
        resolved_iter_type: iter_type ?? return None
        if sema_stmt_for_in_named_type_name(resolved_iter_type) == None -> return None
        iterator_identity := type_identity_key(resolved_iter_type)
        if sema_type_resolve_nominal_row_at(graph, resolved_iter_type, iterable_module) == .Val(iter_row) -> iterator_identity = graph.modules[iter_row.module_index].nominals[iter_row.row].identity_key
        iterator_impl := SemaRegistrationImpl?{None}
        loop module_row_index in 0..<graph.modules.len() {
            loop implementation_index in 0..<graph.modules[module_row_index].impls.len() {
                if graph.modules[module_row_index].impls[implementation_index].trait_name != (Val("Iterator")) || graph.modules[module_row_index].impls[implementation_index].target_identity_key != iterator_identity -> next
                iterator_impl = Val(graph.modules[module_row_index].impls[implementation_index])
            }
        }
        iterator: iterator_impl ?? return None
        item_type := Type?{None}
        next_symbol := String?{None}
        loop associated in iterator.associated_types {
            if associated.symbol.name == "Item" -> item_type = Val(associated.ty)
        }
        loop method in iterator.methods {
            if method.declaration.name == "next" -> next_symbol = Val(method.symbol.id.key)
        }
        item: item_type ?? return None
        iter_key: iter_symbol ?? return None
        next_key: next_symbol ?? return None
        return Val(SemaForInIterableFact{
            method_kind: TForInMethod.Iterable{coll_type: iterable.target_identity_key, iter_type: iterator_identity, iter_symbol: iter_key, next_symbol: next_key, item_type: item},
            item_type: item,
        })
    }
    None
}

sema_stmt_for_in_method_kind: fn(expression: Expr, collection: TExpr) -> TForInMethod? {
    if expression == {
        .MethodCall(receiver_expr, method, _, _, _, _, _) -> {
            if method == "chars" -> return Val(TForInMethod.Chars)
            if method == "lines" {
                receiver := TExpr?{None}
                if collection.kind == {
                    // copy: `value` is a payload of read parameter `collection`, which keeps the original; the Val carrier owns this one
                    .MethodCall(value, _, _, _) -> receiver = Val(value.copy())
                    else -> {}
                }
                if receiver != None {
                    receiver_value: receiver ?? collection
                    if sema_stmt_for_in_type_is_named(receiver_value.ty, "FileReader") -> return Val(TForInMethod.LinesFile)
                    if sema_stmt_for_in_type_is_named(receiver_value.ty, "StdinHandle") -> return Val(TForInMethod.LinesStdin)
                    if receiver_expr == {
                        .Field(base, member, _, _) -> {
                            if member == "stdout" || member == "stderr" {
                                if receiver_value.kind == {
                                    .Field(base_value, _) -> {
                                        if sema_stmt_for_in_type_is_named(base_value.ty, "ProcessChild") -> return Val(TForInMethod.LinesProcessStream)
                                    }
                                    else -> {}
                                }
                            }
                        }
                        else -> {}
                    }
                }
                if sema_stmt_for_in_type_is_named(collection.ty, "FileLines") -> return Val(TForInMethod.LinesFile)
                if sema_stmt_for_in_type_is_named(collection.ty, "StdinLines") -> return Val(TForInMethod.LinesStdin)
                if sema_stmt_for_in_type_is_named(collection.ty, "ProcessLines") -> return Val(TForInMethod.LinesProcessStream)
            }
        }
        else -> {}
    }
    if collection.ty == {
        .Apply(name, args) -> {
            if name == "Receiver" && args.len() == 1 -> return Val(TForInMethod.ChannelReceiver)
        }
        .Named(name) -> {
            if sema_stmt_for_in_encoding_item_type(name) != None -> return Val(TForInMethod.EncodingReader{reader_type: name})
        }
        else -> {}
    }
    None
}

sema_stmt_for_in_source: fn(expression: Expr, collection: TExpr, method_kind: TForInMethod?) -> TExpr Never! {
    special_source := method_kind == (Val(TForInMethod.Chars)) || method_kind == (Val(TForInMethod.LinesFile)) || method_kind == (Val(TForInMethod.LinesStdin)) || method_kind == (Val(TForInMethod.LinesProcessStream))
    if special_source {
        if expression == {
            .MethodCall(_, method, _, _, _, _, _) -> {
                if method == "chars" || method == "lines" {
                    if collection.kind == {
                        // copy: `receiver` is a payload of read parameter `collection`, which keeps the original; the returned value owns this one
                        .MethodCall(receiver, _, _, _) -> return receiver.copy()
                        // `text.chars()` checks as the String builtin; the
                        // loop walks its receiver's scalars, as Rust
                        // lower_forin_collection sources `chars` from it.
                        .BuiltinMethod(receiver, operation, _) -> {
                            if operation == .Chars -> return receiver
                        }
                        // `child.stdout.lines()` checks as the process
                        // stream's handle method; the loop reads the stream,
                        // as Rust lower_forin_collection sources it.
                        .HandleMethod(receiver, _, _) -> {
                            if method_kind == (Val(TForInMethod.LinesProcessStream)) -> return receiver.copy()
                        }
                        else -> {}
                    }
                }
            }
            else -> {}
        }
    }
    // copy: the for-in source is a new owned TExpr. Otherwise it equals `collection`, the caller's
    // checked iterable (a read parameter), which the caller keeps.
    collection.copy()
}

sema_stmt_for_in_expr_root_ident: fn(expression: Expr) -> String? {
    if expression == {
        .Ident(name, _, _) -> return Val(name)
        .Field(base, _, _, _) | .Index(base, _, _, _, _) | .Slice(base, _, _, _, _, _) -> return sema_stmt_for_in_expr_root_ident(base)
        .Paren(value, _, _) | .Copy(value, _, _) -> return sema_stmt_for_in_expr_root_ident(value)
        else -> return None
    }
}

sema_stmt_for_in_can_consume_collection: fn(expression: Expr) -> Bool Never! {
    if expression == {
        .Paren(value, _, _) | .Copy(value, _, _) -> return sema_stmt_for_in_can_consume_collection(value)
        .Field(base, _, _, _) | .Index(base, _, _, _, _) | .Slice(base, _, _, _, _, _) -> return sema_stmt_for_in_expr_root_ident(expression) == None
        else -> return true
    }
}

sema_stmt_for_in_is_list: fn(collection_type: Type) -> Bool Never! {
    if collection_type == {
        .List(_) | .FixedList(_, _) -> true
        else -> false
    }
}

// Rust `frame_owns_place`: a bare name this frame owns outright. A read or
// write parameter and a live view name storage the caller still owns.
sema_stmt_for_in_frame_owns: fn(expression: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState) -> Bool {
    if expression == {
        .Paren(value, _, _) | .Copy(value, _, _) -> return sema_stmt_for_in_frame_owns(value, scopes, state)
        .Ident(_, _, _) -> {}
        else -> return true
    }
    if sema_ownership_view_exists_for_expr(state, expression, scopes) -> return false
    binding: sema_ownership_binding_for_expr(state, expression, scopes) ?? return true
    !(binding.symbol.kind == SymbolKind.Parameter && (binding.access == AccessConvention.Read || binding.access == AccessConvention.Write))
}

// Rust `report_borrowed_loop_consume`: a loop over task handles hands out
// each handle itself, which takes the list; a borrowed name, a field or an
// index cannot give the list away.
sema_stmt_for_in_borrowed_task_list: fn(collection: Expr, collection_type: Type, scopes: SemaScopeTable, state: &SemaOwnershipState) -> Diagnostic {
    why: "each step hands you the handle itself, and a task handle cannot be copied — so the loop takes the whole list"
    place: if collection == {
        .Paren(inner, _, _) | .Copy(inner, _, _) -> inner
        else -> collection
    }
    if place == .Ident(name, _, _) {
        is_param: if sema_ownership_binding_for_expr(state, place, scopes) == {
            .Val(binding) -> binding.symbol.kind == SymbolKind.Parameter
            .None -> false
        }
        fix: if is_param -> "take the list: `{name}: &&{sema_type_show(collection_type)}`, or collect the work in a canonical `task.all` or `task.group` block" else -> "move the list into a local this scope owns before the loop consumes its task handles"
        return sema_error("E0120", expr_span(collection), "`{name}` was not moved here, so this loop can't take its handles", why, fix)
    }
    sema_error("E0120", expr_span(collection), "this loop can't take handles out of a field or index", why, "bind the list into a local this scope owns first (`hs := …`), then write `loop h in hs {{ … }}`")
}

// Rust `collection_root_name`: the local a loop reads, through `.chars()`.
sema_stmt_for_in_collection_root: fn(expression: Expr) -> String? {
    if expression == {
        .Ident(name, _, _) -> return Val(name)
        .MethodCall(receiver, method, _, _, _, _, _) -> {
            if method == "chars" -> return sema_stmt_for_in_collection_root(receiver)
            return None
        }
        else -> return None
    }
}

// The collection a `loop x in xs` holds across its body (E0507). A written
// drive (`loop x in &items`) holds the same source as a by-value one.
sema_stmt_for_in_driven_root: fn(expression: Expr) -> String? {
    if expression == {
        .Place(inner, _, _, _) -> return sema_stmt_for_in_collection_root(inner)
        else -> return sema_stmt_for_in_collection_root(expression)
    }
}

// `loop x in xs` where `xs` is a plain place (`xs`,
// `a.b.xs`, `xs[i]`, `xs[a..b]`, also behind a read or write drive mark)
// rooted in a read or write parameter or in a name that reads its place in
// place (a projection or payload binding): each loop name reads an element
// that place's owner keeps, so an exact `x.move()` in the body would copy it. A
// `.copy()` source or a `xs.move()` drive hands the loop owned elements.
sema_stmt_for_in_borrowed_elements: fn(expression: Expr, scopes: SemaScopeTable) -> Bool Never! {
    if expression == .Place(_, access, _, _) {
        if access == PlaceAccess.Take -> return false
    }
    source: if expression == .Place(inner, _, _, _) -> inner else -> expression
    if !sema_stmt_for_in_plain_place(source) -> return false
    root: sema_stmt_for_in_expr_root_ident(source) ?? return false
    index: sema_scope_resolve_index(scopes, root) ?? return false
    binding: scopes.bindings[index]
    sema_ownership_binding_is_borrowed_param(binding) || binding.place_alias
}

// `loop x in xs` over a list read in place (no `xs.move()` drive) whose items hold a
// resource (#6429): each loop name reads an element the list keeps, whoever
// owns the list, so taking it (`x.move()`) or copying it into an owning position
// (`out.push(x)`, `-> x`) would leave two owners closing one resource.
sema_stmt_for_in_resource_elements: fn(expression: Expr, collection_type: Type, item_type: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, context: SemaCheckContext) -> Bool {
    if expression == .Place(_, access, _, _) {
        if access == PlaceAccess.Take -> return false
    }
    if !sema_stmt_for_in_columnar_list_type(collection_type) -> return false
    source: if expression == .Place(inner, _, _, _) -> inner else -> expression
    if !sema_stmt_for_in_plain_place(source) -> return false
    if sema_ownership_type_is_copy(item_type) || item_type == .String -> return false
    facts: sema_copy_classify(item_type, SemaCopyIntent.Clone, environment, program, context.generic_params, false)
    facts.complete && facts.holds_resource
}

sema_stmt_for_in_plain_place: fn(expression: Expr) -> Bool Never! {
    if expression == {
        .Ident(_, _, _) -> true
        .Field(base, _, _, _) | .Index(base, _, _, _, _) | .Slice(base, _, _, _, _, _) | .Paren(base, _, _) -> sema_stmt_for_in_plain_place(base)
        else -> false
    }
}

// #4318 §4 stable loop source: the root name of a source that is a plain
// place, `xs` or `a.b.xs`. A user `.copy()` copy, a call, or an index is not one.
// Rust reference lowering: `stable_loop_source_root`.
sema_stmt_for_in_stable_root: fn(expression: Expr) -> String? {
    if expression == {
        .Ident(name, _, _) -> return Val(name)
        .Field(base, _, _, _) | .Paren(base, _, _) -> return sema_stmt_for_in_stable_root(base)
        else -> return None
    }
}

// The definition key of a stable source's root, or None when the source is
// not a place or a write loan on the root is active at loop entry (a write
// window or mutating capture can change it without naming it in the body).
sema_stmt_for_in_stable_root_key: fn(expression: Expr, scopes: SemaScopeTable, state: SemaOwnershipState) -> String? {
    root: sema_stmt_for_in_stable_root(expression) ?? return None
    index: sema_scope_resolve_index(scopes, root) ?? return None
    key: scopes.bindings[index].symbol.id.key
    loop loan in state.loans {
        if loan.place.root_key == key && loan.access == AccessConvention.Write -> return None
    }
    Val(key)
}

// True when a reference the loop body added (from `references_before` on)
// names the definition `key`: any read, write, or move of the root.
sema_stmt_for_in_body_mentions: fn(state: SemaOwnershipState, references_before: Int, key: String) -> Bool Never! {
    loop index in references_before..<state.references.len() {
        if state.references[index].def_key == key -> return true
    }
    false
}

// True when the checked loop body names the definition `key` on any path,
// as Rust's syntactic test does (`block_free_var_reads(body)` in
// the Rust reference lowering). The ownership
// references above miss an arm that does not fall through, whose branch
// state is dropped: `loop x in s.xs { if c { f(s, x); return } }` looked
// stable, lowered an in-place walk, and rustc rejected the `&mut s` call
// that also borrows `s.xs[i]` (E0502).
// `arena` holds the rows of the body's flat nodes (sema_node).
sema_stmt_for_in_tree_mentions: fn(statements: [TStmt], key: String, arena: BodyTree) -> Bool Never! {
    if sema_stmt_for_in_tree_assigns(statements, key) -> return true
    found := false
    loop statement in statements {
        if found -> break
        tree_each_stmt_child(statement, (child: TExpr) -> {
            if !found && sema_stmt_for_in_tree_expr_names(child, key, arena) -> found = true
        })
    }
    found
}

sema_stmt_for_in_tree_local_is: fn(local: TLocal, key: String) -> Bool Never! {
    symbol: local.symbol_id ?? return false
    symbol.key == key
}

// A local read, an address of the whole local, or a lambda capture of it;
// `tree_each_expr_child` covers every nested expression.
sema_stmt_for_in_tree_expr_names: fn(value: TExpr, key: String, arena: BodyTree) -> Bool Never! {
    if value.kind == {
        .Flat(index) -> return sema_stmt_for_in_row_names(arena, index, key)
        .Local(local) -> return sema_stmt_for_in_tree_local_is(local, key)
        .RawAddressOf(place) -> {
            if place == .Local(local) -> return sema_stmt_for_in_tree_local_is(local, key)
        }
        .Lambda(lambda) -> {
            loop capture in lambda.captures {
                if sema_stmt_for_in_tree_local_is(capture.local, key) -> return true
            }
        }
        .InlineBlock(body) -> {
            if sema_stmt_for_in_tree_assigns(body, key) -> return true
        }
        else -> {}
    }
    found := false
    tree_each_expr_child(value, (child: TExpr) -> {
        if !found && sema_stmt_for_in_tree_expr_names(child, key, arena) -> found = true
    })
    found
}

// sema_stmt_for_in_tree_expr_names of node row `index` of `tree`.
sema_stmt_for_in_row_names: fn(tree: BodyTree, index: Int, key: String) -> Bool Never! {
    if tree.nodes[index - tree.node_base].kind == {
        .Local(local) -> return sema_stmt_for_in_tree_local_is(local, key)
        .RawAddressOf(place) -> {
            if place == .Local(local) -> return sema_stmt_for_in_tree_local_is(local, key)
        }
        .Lambda(lambda) -> {
            loop capture in lambda.captures {
                if sema_stmt_for_in_tree_local_is(capture.local, key) -> return true
            }
        }
        .InlineBlock(body) -> {
            if sema_stmt_for_in_row_assigns(tree, body, key) -> return true
        }
        else -> {}
    }
    found := false
    body_each_node_kind_child(tree, tree.nodes[index - tree.node_base].kind, (child: Int) -> {
        if !found && sema_stmt_for_in_row_names(tree, child, key) -> found = true
    })
    found
}

// A whole-local assignment `key = …` at any depth: its place is not an
// expression child (`tree_each_stmt_child`).
sema_stmt_for_in_tree_assigns: fn(statements: [TStmt], key: String) -> Bool Never! {
    loop statement in statements {
        if statement == {
            .Assign(place, _, _, _, _) -> {
                if place == .Local(local) {
                    if sema_stmt_for_in_tree_local_is(local, key) -> return true
                }
            }
            .ContractScope(_, body, _, _, _) | .TaskGroup(_, _, body, _) | .Loop(_, body, _) | .While(_, _, body, _) | .ForRange(_, _, _, _, _, _, body, _, _) | .Range(_, _, _, _, _, _, _, _, body, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, body, _) | .Inline(body, _) | .DebugOnly(body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) | .Unsafe(_, body) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Layout(_, _, body, _) | .ContextBlock(_, body, _) | .ScopeMember(_, body, _) | .Transact(_, _, _, body, _) -> {
                if sema_stmt_for_in_tree_assigns(body, key) -> return true
            }
            .RefutableBind(_, _, fallback, _) -> {
                if sema_stmt_for_in_tree_assigns(fallback, key) -> return true
            }
            .CountedLoop(_, init, _, step, _, body, _) -> {
                if sema_stmt_for_in_tree_assigns([TStmt]{init}, key) || sema_stmt_for_in_tree_assigns(body, key) -> return true
                if step == .Val(nested) {
                    if sema_stmt_for_in_tree_assigns([TStmt]{nested}, key) -> return true
                }
            }
            .If(_, then_body, else_body, _, _) -> {
                if sema_stmt_for_in_tree_assigns(then_body, key) -> return true
                if else_body == .Val(else_statements) {
                    if sema_stmt_for_in_tree_assigns(else_statements, key) -> return true
                }
            }
            .Match(_, arms, _, _) -> loop arm in arms {
                if sema_stmt_for_in_tree_assigns(arm.body, key) -> return true
            }
            .EnumMatch(_, arms, else_body, _, _) -> {
                loop arm in arms {
                    if sema_stmt_for_in_tree_assigns(arm.body, key) -> return true
                }
                if else_body == .Val(else_statements) {
                    if sema_stmt_for_in_tree_assigns(else_statements, key) -> return true
                }
            }
            .RangeSwitch(_, arms, else_body, _) -> {
                loop arm in arms {
                    if sema_stmt_for_in_tree_assigns(arm.body, key) -> return true
                }
                if sema_stmt_for_in_tree_assigns(else_body, key) -> return true
            }
            .MixedSwitch(_, _, arms, else_body, _) -> {
                loop arm in arms {
                    if sema_stmt_for_in_tree_assigns(arm.body, key) -> return true
                }
                if else_body == .Val(else_statements) {
                    if sema_stmt_for_in_tree_assigns(else_statements, key) -> return true
                }
            }
            .GCEdit(_, _, _, _, _, edited, _) -> {
                if sema_stmt_for_in_tree_assigns([TStmt]{edited}, key) -> return true
            }
            else -> {}
        }
    }
    false
}

// sema_stmt_for_in_tree_assigns of statement rows `statements` of `tree`.
sema_stmt_for_in_row_assigns: fn(tree: BodyTree, statements: [Int], key: String) -> Bool Never! {
    loop item in statements {
        if sema_stmt_for_in_row_stmt_assigns(tree, item, key) -> return true
    }
    false
}

sema_stmt_for_in_row_stmt_assigns: fn(tree: BodyTree, item: Int, key: String) -> Bool Never! {
    if tree.stmts[item - tree.stmt_base] == {
        .Assign(place, _, _, _, _) -> {
            if place == .Local(local) -> return sema_stmt_for_in_tree_local_is(local, key)
            false
        }
        .ContractScope(_, body, _, _, _) | .TaskGroup(_, _, body, _) | .Loop(_, body, _) | .While(_, _, body, _) | .ForRange(_, _, _, _, _, _, body, _, _) | .Range(_, _, _, _, _, _, _, _, body, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, body, _) | .Inline(body, _) | .DebugOnly(body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) | .Unsafe(_, body) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Layout(_, _, body, _) | .ContextBlock(_, body, _) | .ScopeMember(_, body, _) | .Transact(_, _, _, body, _) -> sema_stmt_for_in_row_assigns(tree, body, key)
        .RefutableBind(_, _, fallback, _) -> sema_stmt_for_in_row_assigns(tree, fallback, key)
        .CountedLoop(_, init, _, step, _, body, _) -> {
            if sema_stmt_for_in_row_stmt_assigns(tree, init, key) || sema_stmt_for_in_row_assigns(tree, body, key) -> return true
            if step == .Val(nested) -> return sema_stmt_for_in_row_stmt_assigns(tree, nested, key)
            false
        }
        .If(_, then_body, else_body, _, _) -> {
            if sema_stmt_for_in_row_assigns(tree, then_body, key) -> return true
            if else_body == .Val(else_statements) -> return sema_stmt_for_in_row_assigns(tree, else_statements, key)
            false
        }
        .Match(_, arms, _, _) -> {
            loop arm in arms {
                if sema_stmt_for_in_row_assigns(tree, arm.body, key) -> return true
            }
            false
        }
        .EnumMatch(_, arms, else_body, _, _) -> {
            loop arm in arms {
                if sema_stmt_for_in_row_assigns(tree, arm.body, key) -> return true
            }
            if else_body == .Val(else_statements) -> return sema_stmt_for_in_row_assigns(tree, else_statements, key)
            false
        }
        .RangeSwitch(_, arms, else_body, _) -> {
            loop arm in arms {
                if sema_stmt_for_in_row_assigns(tree, arm.body, key) -> return true
            }
            sema_stmt_for_in_row_assigns(tree, else_body, key)
        }
        .MixedSwitch(_, _, arms, else_body, _) -> {
            loop arm in arms {
                if sema_stmt_for_in_row_assigns(tree, arm.body, key) -> return true
            }
            if else_body == .Val(else_statements) -> return sema_stmt_for_in_row_assigns(tree, else_statements, key)
            false
        }
        .GCEdit(_, _, _, _, _, edited, _) -> sema_stmt_for_in_row_stmt_assigns(tree, edited, key)
        else -> false
    }
}

// True when the loop body leaves the source root `key` unchanged, so the
// loop may walk the source in place, as Rust's
// reference lowering's `loop_body_keeps_source`
// decides. A body that never names the root qualifies. A body that names it
// qualifies only when every reference it adds to the root is a read, it
// never assigns, write-borrows or captures the root, and it never leaves the
// loop early or diverges (sema_stmt_for_in_tree_stays). With no early exit
// and no diverging arm, no branch state is dropped, so the references are
// complete; and no read of the root can become its moving last use while the
// walk's item borrow is live.
sema_stmt_for_in_body_keeps: fn(state: SemaOwnershipState, references_before: Int, key: String, statements: [TStmt], arena: BodyTree) -> Bool {
    if !sema_stmt_for_in_body_mentions(state, references_before, key) && !sema_stmt_for_in_tree_mentions(statements, key, arena) -> return true
    loop index in references_before..<state.references.len() {
        reference: state.references[index]
        if reference.def_key == key && reference.kind != SemaOwnershipReferenceKind.Read -> return false
    }
    !sema_stmt_for_in_tree_assigns(statements, key) && sema_stmt_for_in_tree_stays(statements, key, arena)
}

// True when every statement only falls through: no return, break, value
// break or next at any depth (a nested loop's included), no statement of
// type Never, and no expression that leaves or diverges
// (sema_stmt_for_in_tree_expr_stays).
sema_stmt_for_in_tree_stays: fn(statements: [TStmt], key: String, arena: BodyTree) -> Bool Never! {
    loop statement in statements {
        if statement == {
            .Return(_, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) -> return false
            .ExprStmt(value, _) -> {
                if value.ty == (Type.Named{name: "Never"}) -> return false
            }
            .ContractScope(_, body, _, _, _) | .TaskGroup(_, _, body, _) | .Loop(_, body, _) | .While(_, _, body, _) | .ForRange(_, _, _, _, _, _, body, _, _) | .Range(_, _, _, _, _, _, _, _, body, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, body, _) | .Inline(body, _) | .DebugOnly(body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) | .Unsafe(_, body) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Layout(_, _, body, _) | .ContextBlock(_, body, _) | .ScopeMember(_, body, _) | .Transact(_, _, _, body, _) -> {
                if !sema_stmt_for_in_tree_stays(body, key, arena) -> return false
            }
            .RefutableBind(_, _, fallback, _) -> {
                if !sema_stmt_for_in_tree_stays(fallback, key, arena) -> return false
            }
            .CountedLoop(_, init, _, step, _, body, _) -> {
                if !sema_stmt_for_in_tree_stays([TStmt]{init}, key, arena) || !sema_stmt_for_in_tree_stays(body, key, arena) -> return false
                if step == .Val(nested) {
                    if !sema_stmt_for_in_tree_stays([TStmt]{nested}, key, arena) -> return false
                }
            }
            .If(_, then_body, else_body, _, _) -> {
                if !sema_stmt_for_in_tree_stays(then_body, key, arena) -> return false
                if else_body == .Val(else_statements) {
                    if !sema_stmt_for_in_tree_stays(else_statements, key, arena) -> return false
                }
            }
            .Match(_, arms, _, _) -> loop arm in arms {
                if !sema_stmt_for_in_tree_stays(arm.body, key, arena) -> return false
            }
            .EnumMatch(_, arms, else_body, _, _) -> {
                loop arm in arms {
                    if !sema_stmt_for_in_tree_stays(arm.body, key, arena) -> return false
                }
                if else_body == .Val(else_statements) {
                    if !sema_stmt_for_in_tree_stays(else_statements, key, arena) -> return false
                }
            }
            .RangeSwitch(_, arms, else_body, _) -> {
                loop arm in arms {
                    if !sema_stmt_for_in_tree_stays(arm.body, key, arena) -> return false
                }
                if !sema_stmt_for_in_tree_stays(else_body, key, arena) -> return false
            }
            .MixedSwitch(_, _, arms, else_body, _) -> {
                loop arm in arms {
                    if !sema_stmt_for_in_tree_stays(arm.body, key, arena) -> return false
                }
                if else_body == .Val(else_statements) {
                    if !sema_stmt_for_in_tree_stays(else_statements, key, arena) -> return false
                }
            }
            .GCEdit(_, _, _, _, _, edited, _) -> {
                if !sema_stmt_for_in_tree_stays([TStmt]{edited}, key, arena) -> return false
            }
            else -> {}
        }
        stays := true
        tree_each_stmt_child(statement, (child: TExpr) -> {
            if stays && !sema_stmt_for_in_tree_expr_stays(child, key, arena) -> stays = false
        })
        if !stays -> return false
    }
    true
}

// An expression that neither leaves the loop (`?`, a diverging `??`), nor
// diverges (type Never), nor write-borrows or captures the root `key`; an
// inline block's statements fall through too.
sema_stmt_for_in_tree_expr_stays: fn(value: TExpr, key: String, arena: BodyTree) -> Bool Never! {
    if value.ty == (Type.Named{name: "Never"}) -> return false
    if value.kind == {
        .Flat(index) -> return sema_stmt_for_in_row_expr_stays(arena, index, key)
        .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) -> return false
        .OrFallback(_, fallback, _) -> {
            if fallback == {
                .Value(_) -> {}
                else -> return false
            }
        }
        .Lambda(lambda) -> {
            loop capture in lambda.captures {
                if sema_stmt_for_in_tree_local_is(capture.local, key) -> return false
            }
        }
        .InlineBlock(body) -> {
            if !sema_stmt_for_in_tree_stays(body, key, arena) -> return false
        }
        else -> {}
    }
    stays := true
    tree_each_expr_child(value, (child: TExpr) -> {
        if stays && !sema_stmt_for_in_tree_expr_stays(child, key, arena) -> stays = false
    })
    stays
}

// Whether node row `index` of `tree` has type Never.
sema_stmt_row_is_never: fn(tree: BodyTree, index: Int) -> Bool Never! {
    tree.types.types[tree.expr_types[index - tree.node_base].ty] == (Type.Named{name: "Never"})
}

// sema_stmt_for_in_tree_stays of statement rows `statements` of `tree`.
sema_stmt_for_in_row_stays: fn(tree: BodyTree, statements: [Int], key: String) -> Bool Never! {
    loop item in statements {
        if !sema_stmt_for_in_row_stmt_stays(tree, item, key) -> return false
    }
    true
}

sema_stmt_for_in_row_stmt_stays: fn(tree: BodyTree, item: Int, key: String) -> Bool Never! {
    if tree.stmts[item - tree.stmt_base] == {
        .Return(_, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) -> return false
        .ExprStmt(value, _) -> {
            if sema_stmt_row_is_never(tree, value) -> return false
        }
        .ContractScope(_, body, _, _, _) | .TaskGroup(_, _, body, _) | .Loop(_, body, _) | .While(_, _, body, _) | .ForRange(_, _, _, _, _, _, body, _, _) | .Range(_, _, _, _, _, _, _, _, body, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, body, _) | .Inline(body, _) | .DebugOnly(body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) | .Unsafe(_, body) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Layout(_, _, body, _) | .ContextBlock(_, body, _) | .ScopeMember(_, body, _) | .Transact(_, _, _, body, _) -> {
            if !sema_stmt_for_in_row_stays(tree, body, key) -> return false
        }
        .RefutableBind(_, _, fallback, _) -> {
            if !sema_stmt_for_in_row_stays(tree, fallback, key) -> return false
        }
        .CountedLoop(_, init, _, step, _, body, _) -> {
            if !sema_stmt_for_in_row_stmt_stays(tree, init, key) || !sema_stmt_for_in_row_stays(tree, body, key) -> return false
            if step == .Val(nested) {
                if !sema_stmt_for_in_row_stmt_stays(tree, nested, key) -> return false
            }
        }
        .If(_, then_body, else_body, _, _) -> {
            if !sema_stmt_for_in_row_stays(tree, then_body, key) -> return false
            if else_body == .Val(else_statements) {
                if !sema_stmt_for_in_row_stays(tree, else_statements, key) -> return false
            }
        }
        .Match(_, arms, _, _) -> loop arm in arms {
            if !sema_stmt_for_in_row_stays(tree, arm.body, key) -> return false
        }
        .EnumMatch(_, arms, else_body, _, _) -> {
            loop arm in arms {
                if !sema_stmt_for_in_row_stays(tree, arm.body, key) -> return false
            }
            if else_body == .Val(else_statements) {
                if !sema_stmt_for_in_row_stays(tree, else_statements, key) -> return false
            }
        }
        .RangeSwitch(_, arms, else_body, _) -> {
            loop arm in arms {
                if !sema_stmt_for_in_row_stays(tree, arm.body, key) -> return false
            }
            if !sema_stmt_for_in_row_stays(tree, else_body, key) -> return false
        }
        .MixedSwitch(_, _, arms, else_body, _) -> {
            loop arm in arms {
                if !sema_stmt_for_in_row_stays(tree, arm.body, key) -> return false
            }
            if else_body == .Val(else_statements) {
                if !sema_stmt_for_in_row_stays(tree, else_statements, key) -> return false
            }
        }
        .GCEdit(_, _, _, _, _, edited, _) -> {
            if !sema_stmt_for_in_row_stmt_stays(tree, edited, key) -> return false
        }
        else -> {}
    }
    stays := true
    body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], (child: Int) -> {
        if stays && !sema_stmt_for_in_row_expr_stays(tree, child, key) -> stays = false
    })
    stays
}

// sema_stmt_for_in_tree_expr_stays of node row `index` of `tree`.
sema_stmt_for_in_row_expr_stays: fn(tree: BodyTree, index: Int, key: String) -> Bool Never! {
    if sema_stmt_row_is_never(tree, index) -> return false
    if tree.nodes[index - tree.node_base].kind == {
        .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) -> return false
        .OrFallback(_, fallback, _) -> {
            if fallback == {
                .Value(_) -> {}
                else -> return false
            }
        }
        .Lambda(lambda) -> {
            loop capture in lambda.captures {
                if sema_stmt_for_in_tree_local_is(capture.local, key) -> return false
            }
        }
        .InlineBlock(body) -> {
            if !sema_stmt_for_in_row_stays(tree, body, key) -> return false
        }
        else -> {}
    }
    stays := true
    body_each_node_kind_child(tree, tree.nodes[index - tree.node_base].kind, (child: Int) -> {
        if stays && !sema_stmt_for_in_row_expr_stays(tree, child, key) -> stays = false
    })
    stays
}

sema_stmt_for_in_stable_list: fn(collection_type: Type) -> Bool Never! {
    if sema_expr_unwrap_tag(collection_type) == {
        .List(_) | .FixedList(_, _) -> true
        else -> false
    }
}

// Rust `collection_changed_in_loop` / `collection_changed_by_method_in_loop`
// (E0507): a change to a collection an active loop is reading. `operation`
// is `` `name.method()` `` or `a mutation of `name``.
sema_collection_changed_in_loop: fn(name: String, operation: String, span: Span) -> Diagnostic {
    sema_error("E0507", span, "While the loop is reading `{name}`, nothing may change it", "The loop reads `{name}` across its body, so {operation} can change the visited domain, element order, or termination.", "Choose the collection intent explicitly: use a separate result when the original traversal should stay unchanged; snapshot `{name}` and iterate the fixed original set when only the original values belong in the traversal; or use an explicit work queue when newly added values should be visited. Do not use index traversal unless its fixed domain and result meaning are intended.")
}

// The root local of a written place such as `xs`, `&xs`, or `a.b[i]`.
sema_expr_place_root_ident: fn(expression: Expr) -> String? {
    if expression == {
        .Place(inner, _, _, _) | .Paren(inner, _, _) -> return sema_expr_place_root_ident(inner)
        else -> return sema_stmt_for_in_expr_root_ident(expression)
    }
}

// Rust's indexed-write gate: a Pool, ViewMut, Map, List, or fixed list slot.
sema_stmt_index_write_is_collection: fn(ty: Type) -> Bool Never! {
    if sema_expr_unwrap_tag(ty) == {
        .Map(_, _, _) | .List(_) | .FixedList(_, _) -> true
        .Apply(name, _) -> name == "Pool" || name == "ViewMut"
        else -> false
    }
}

// E1108: the element name of a `[S]` whose struct is
// `#Layout(columnar)`; v1 supports only the core read surface on it.
sema_columnar_list_element: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type) -> String? {
    if sema_expr_unwrap_tag(ty) == .List(inner) {
        if inner == .Named(element) && sema_stmt_for_in_columnar(environment, program, inner) -> return Val(element)
    }
    None
}

// Only the exact shape `….len()` (no args) ends a range.
sema_stmt_range_end_len_root: fn(end: Expr) -> String? {
    if end == .MethodCall(receiver, method, _, _, _, args, _) && method == "len" && args.len() == 0 {
        collection: sema_stmt_for_in_collection_root(receiver)
        if collection != None -> return collection
        return sema_stmt_for_in_expr_root_ident(receiver)
    }
    None
}

// True when a statement in `body` indexes `root` with the name `index_var`.
sema_stmt_index_root_with_stmts: fn(body: [Stmt], root: String, index_var: String) -> Bool Never! {
    loop statement in body {
        if sema_stmt_index_root_with_stmt(statement, root, index_var) -> return true
    }
    false
}

sema_stmt_index_root_with_stmt: fn(statement: Stmt, root: String, index_var: String) -> Bool Never! {
    if statement == {
        .Expr(value) | .DeferClose(value, _) -> sema_stmt_index_root_with_expr(value, root, index_var)
        .Return(value, _) -> {
            if value == .Val(returned) -> return sema_stmt_index_root_with_expr(returned, root, index_var)
            false
        }
        .Val(binding) -> sema_stmt_index_root_with_expr(binding.init, root, index_var)
        .Assign(target, _, _, value) -> {
            if target == .Index(base, index, _, _) {
                if sema_stmt_for_in_expr_root_ident(base) == (Val(root)) && sema_stmt_index_is_ident(index, index_var) -> return true
                if sema_stmt_index_root_with_expr(base, root, index_var) || sema_stmt_index_root_with_expr(index, root, index_var) -> return true
            }
            sema_stmt_index_root_with_expr(value, root, index_var)
        }
        .While(cond, body, _, _, _) -> sema_stmt_index_root_with_expr(cond, root, index_var) || sema_stmt_index_root_with_stmts(body, root, index_var)
        .For(_, _, _, kind, body, _, _, _, _) -> {
            if kind == {
                .Range(start, end, step, _) -> {
                    if sema_stmt_index_root_with_expr(start, root, index_var) || sema_stmt_index_root_with_expr(end, root, index_var) -> return true
                    if step == .Val(stride) {
                        if sema_stmt_index_root_with_expr(stride, root, index_var) -> return true
                    }
                }
                .In(collection, step) -> {
                    if sema_stmt_index_root_with_expr(collection, root, index_var) -> return true
                    if step == .Val(stride) {
                        if sema_stmt_index_root_with_expr(stride, root, index_var) -> return true
                    }
                }
            }
            sema_stmt_index_root_with_stmts(body, root, index_var)
        }
        .Loop(body, _, _, _) | .Unsafe(_, _, body, _) | .Region(_, _, body, _) -> sema_stmt_index_root_with_stmts(body, root, index_var)
        .CountedLoop(init, cond, step, body, _, _, _) -> {
            if sema_stmt_index_root_with_expr(init.init, root, index_var) || sema_stmt_index_root_with_expr(cond, root, index_var) -> return true
            if step == .Val(step_statement) {
                if sema_stmt_index_root_with_stmt(step_statement, root, index_var) -> return true
            }
            sema_stmt_index_root_with_stmts(body, root, index_var)
        }
        .Switch(subject, arms, else_body, _) | .ComptimeSwitch(subject, arms, else_body, _) -> {
            if sema_stmt_index_root_with_expr(subject, root, index_var) -> return true
            loop arm in arms {
                if sema_stmt_index_root_with_expr(arm.cond, root, index_var) || sema_stmt_index_root_with_stmts(arm.body, root, index_var) -> return true
            }
            if else_body == .Val(fallback) -> return sema_stmt_index_root_with_stmts(fallback, root, index_var)
            false
        }
        else -> false
    }
}

sema_stmt_index_is_ident: fn(value: Expr, name: String) -> Bool Never! {
    if value == .Ident(found, _, _) -> return found == name
    false
}

sema_stmt_index_root_with_args: fn(args: [CallArg], root: String, index_var: String) -> Bool Never! {
    loop argument in args {
        if sema_stmt_index_root_with_expr(argument.expr, root, index_var) -> return true
    }
    false
}

sema_stmt_index_root_with_expr: fn(value: Expr, root: String, index_var: String) -> Bool Never! {
    if value == {
        .Index(base, index, _, _, _) -> (sema_stmt_for_in_expr_root_ident(base) == (Val(root)) && sema_stmt_index_is_ident(index, index_var)) || sema_stmt_index_root_with_expr(base, root, index_var) || sema_stmt_index_root_with_expr(index, root, index_var)
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Interp(inner, _) && sema_stmt_index_root_with_expr(inner, root, index_var) -> return true
            }
            false
        }
        .Call(call, _) -> sema_stmt_index_root_with_args(call.args, root, index_var)
        .CallValue(callee, args, _, _) -> sema_stmt_index_root_with_expr(callee, root, index_var) || sema_stmt_index_root_with_args(args, root, index_var)
        .MethodCall(receiver, _, _, _, _, args, _) -> sema_stmt_index_root_with_expr(receiver, root, index_var) || sema_stmt_index_root_with_args(args, root, index_var)
        .Field(inner, _, _, _) | .Spread(inner, _, _) | .Copy(inner, _, _) | .RawOf(inner, _, _) | .Place(inner, _, _, _) | .Present(inner, _, _) | .Tainted(inner, _, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) | .OrFallback(inner, _, _, _, _) -> sema_stmt_index_root_with_expr(inner, root, index_var)
        .Try(inner, _, _, note, _) -> {
            if sema_stmt_index_root_with_expr(inner, root, index_var) -> return true
            if note == .Val(context_note) -> return sema_stmt_index_root_with_expr(context_note, root, index_var)
            false
        }
        .Binary(_, left, right, _, _) -> sema_stmt_index_root_with_expr(left, root, index_var) || sema_stmt_index_root_with_expr(right, root, index_var)
        .ListLit(items, _, _) -> {
            loop item in items {
                if sema_stmt_index_root_with_expr(item, root, index_var) -> return true
            }
            false
        }
        .TupleLit(fields, _, _, _) -> {
            loop field in fields {
                if sema_stmt_index_root_with_expr(field.value, root, index_var) -> return true
            }
            false
        }
        .Slice(base, start, end, range, _, _) -> {
            if sema_stmt_index_root_with_expr(base, root, index_var) -> return true
            if range == .Val(window) -> return sema_stmt_index_root_with_expr(window, root, index_var)
            sema_stmt_index_root_with_expr(start, root, index_var) || sema_stmt_index_root_with_expr(end, root, index_var)
        }
        .If(cond, then_body, then_value, else_body, else_value, _, _) -> sema_stmt_index_root_with_expr(cond, root, index_var) || sema_stmt_index_root_with_stmts(then_body, root, index_var) || sema_stmt_index_root_with_expr(then_value, root, index_var) || sema_stmt_index_root_with_stmts(else_body, root, index_var) || sema_stmt_index_root_with_expr(else_value, root, index_var)
        else -> false
    }
}

sema_stmt_for_in_consumes_collection: fn(collection_type: Type, item_type: Type) -> Bool Never! {
    if collection_type == {
        .List(_) | .FixedList(_, _) -> return sema_stmt_for_in_type_requires_owned_iteration(item_type)
        .Apply(name, _) -> return name == "Stream" || name == "Iter" || name == "ViewIter"
        else -> return false
    }
}

sema_stmt_for_in_by_value: fn(collection_type: Type, item_type: Type) -> Bool Never! {
    if collection_type == {
        .List(_) | .FixedList(_, _) -> return sema_stmt_for_in_type_requires_owned_iteration(item_type)
        .Apply(name, _) -> return name == "Stream" || name == "Iter"
        else -> return false
    }
}

sema_stmt_for_in_columnar_list_type: fn(collection_type: Type) -> Bool Never! {
    if collection_type == {
        .List(_) | .FixedList(_, _) -> true
        else -> false
    }
}

sema_stmt_for_in_is_range: fn(collection_type: Type) -> Bool Never! {
    if collection_type == {
        .InlineRange(_, _, _) -> return true
        .Named(name) -> return name == "Range"
        else -> return false
    }
}

sema_stmt_for_in_range_zero: fn(span: Span) -> TExpr Never! {
    sema_tree_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span)
}

// `ty` is None when the loop source failed its own check: the loop name
// stays in scope untyped, so reads of it in the body check to nothing and add
// no follow-on report (the same poison as `sema_stmt_declare_unchecked_binding`).
// The returned local carries the declared symbol and its type, so lowering
// binds the loop name under the identity every body read resolves by. None
// when the name could not be declared (reported here) or is untyped (the
// loop is incomplete either way).
sema_stmt_for_in_decl_loop_local: fn(name: String, name_span: Span, ty: Type?, owes_duty: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> TLocal? {
    owner := sema_scope_local_owner_key(scopes)
    symbol := Symbol{
        id: symbol_id(SymbolKind.Local, environment.module_identity, owner, name),
        kind: SymbolKind.Local,
        name: name,
        module_name: environment.module_identity,
        owner: Val(owner),
        span: name_span,
        ty: ty,
        visibility: 0,
    }
    if !sema_scope_declare_local(scopes, symbol, false, AccessConvention.Read, None, false) {
        diagnostics.push(sema_already_defined(name, name_span))
        return None
    }
    checked_ty: ty ?? return None
    sema_ownership_declare_binding(state, symbol, false)
    if owes_duty -> sema_single_use_note_binding(state, symbol, environment, program)
    Val(checked_symbol_local(name, name_span, symbol.id, checked_ty))
}

// `loop (k, v) in table.move()`: the loop takes the map, so its entries are owned.
sema_stmt_for_in_takes_map: fn(collection: Expr, collection_type: Type) -> Bool Never! {
    if !(collection_type == .Map(_, _, _)) -> return false
    if collection == {
        .Place(_, access, _, _) -> access == PlaceAccess.Take
        .MethodCall(receiver, method, _, _, type_args, args, _) -> method == "move" && args.len() == 0 && type_args.len() == 0 && (receiver == .Ident(_, _, _) || receiver == .Field(_, _, _, _))
        else -> false
    }
}

// Rust lends each ViewMut item for one iteration; the descriptor may not
// escape, and its source still participates in the ordinary view ledger.
sema_stmt_for_in_lend_view_item: fn(local: TLocal?, ty: Type, collection: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext) {
    if ty == .Apply(lend_name, item_args) && lend_name == "ViewMut" {
        if item_args.len() != 1 -> return
    } else {
        return
    }
    variable: local ?? return
    symbol: variable.symbol_id ?? return
    facts: sema_stmt_local_view_facts_for_expr(collection, scopes, state, context)
    recorded := false
    loop fact in facts {
        if fact.slot.len() != 1 || fact.slot[0] != "[]" -> next
        loop place in fact.places {
            _ := sema_ownership_record_view_fact_inner(state, variable.name, variable.span, place, [String]{}, AccessConvention.Write, scopes, -1)
            recorded = true
        }
    }
    if !recorded {
        places: sema_ownership_places_from_expr_in_state(collection, scopes, state)
        loop source in places {
            place := sema_ownership_place_snapshot(source)
            place.projections.push("[]")
            place.typed_projections.push(SemaOwnershipProjection.Index{value: None, span: variable.span})
            _ := sema_ownership_record_view_fact_inner(state, variable.name, variable.span, place, [String]{}, AccessConvention.Write, scopes, -1)
        }
    }
    context.lending_view_parameter_keys.push(symbol.key)
}

sema_stmt_for_in_pair_types: fn(collection_type: Type, item_type: Type) -> SemaForInPairTypes? {
    if collection_type == {
        .List(_) | .FixedList(_, _) -> return Val(SemaForInPairTypes{first: Type.Int, second: item_type})
        // copy: `key` and `value` are payloads of read parameter `collection_type`, which keeps the originals; the new SemaForInPairTypes's fields own `key` and `value`
        .Map(key, _, value) -> return Val(SemaForInPairTypes{first: key.copy(), second: value.copy()})
        .Apply(name, args) -> {
            if (name == "View" || name == "ViewMut" || name == "ComputeViewMut") && args.len() == 1 -> return Val(SemaForInPairTypes{first: Type.Int, second: args[0]})
        }
        else -> {}
    }
    None
}

sema_stmt_for_in_method_pair_is_supported: fn(method_kind: TForInMethod?) -> Bool Never! {
    method_kind == None
}

sema_stmt_for_in_item_type: fn(collection_type: Type, method_kind: TForInMethod?, iterable_item_type: Type?) -> Type? {
    if iterable_item_type != None -> return iterable_item_type
    if method_kind == {
        .Val(method) -> {
            if method == {
                .Chars -> return Val(Type.Char)
                .LinesFile | .LinesStdin | .LinesProcessStream -> return Val(Type.String)
                .ChannelReceiver -> {
                    if collection_type == {
                        .Apply(name, args) -> {
                            if name == "Receiver" && args.len() == 1 -> return Val(args[0])
                        }
                        else -> {}
                    }
                }
                .EncodingReader(reader_type) -> return sema_stmt_for_in_encoding_item_type(reader_type)
                .Iterable(_, _, _, _, item_type) -> return Val(item_type)
            }
        }
        .None -> {}
    }
    if collection_type == {
        .List(inner) | .FixedList(inner, _) -> return Val(inner)
        // copy: `key` and `value` are payloads of read parameter `collection_type`, which keeps the originals; the new TypeTupleField's fields own `key` and `value`
        .Map(key, _, value) -> return Val(Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "key", ty: key.copy()}, TypeTupleField{name: "value", ty: value.copy()}}})
        .Apply(name, args) -> {
            if (name == "Iter" || name == "ViewIter" || name == "Stream" || name == "View" || name == "ViewMut" || name == "ComputeViewMut" || name == "Receiver") && args.len() == 1 -> return Val(args[0])
        }
        .Named(name) -> {
            if name == "FileLines" || name == "StdinLines" || name == "ProcessLines" -> return Val(Type.String)
            if name == "Range" -> return Val(Type.Int)
            return sema_stmt_for_in_encoding_item_type(name)
        }
        .InlineRange(_, _, _) -> return Val(Type.Int)
        else -> {}
    }
    None
}

// A body pass's tables carry no checked types, so the layout comes from the
// struct's declaration in the registration graph.
sema_stmt_for_in_columnar: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, item_type: Type) -> Bool {
    if program.registration_graph == .Val(graph) {
        nominal_row: sema_type_resolve_nominal_row(graph, item_type, environment.module_identity) ?? return false
        nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
        if nominal.kind != SemaRegistrationNominalKind.Struct -> return false
        if sema_registration_nominal_source_item(nominal.source) == .Val(.Struct(definition)) -> return definition.layout == (Val(StructLayout.Columnar))
    }
    false
}

sema_stmt_check_source_stride: fn(expr: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    value: sema_check_expression(expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    if !sema_stmt_range_integer_type(value.ty) {
        diagnostics.push(sema_error("E0123", expr_span(expr), "a source loop stride must be {sema_type_show(Type.Int)}, not {sema_type_show(value.ty)}", "the stride counts source pulls, so it must be a positive whole number", "use an Int stride of 1 or more"))
        return None
    }
    if expr == {
        .Int(number, span, _, _, _) -> {
            if number <= 0 {
                diagnostics.push(sema_error("E0123", span, "a source loop stride must be positive", "zero or a negative value cannot select a later source item", "use a stride of 1 or more"))
                return None
            }
        }
        else -> {}
    }
    Val(value)
}

// The fix names the loop labels that are reachable here.
sema_stmt_unknown_loop_label: fn(scopes: SemaScopeTable, name: String, span: Span) -> Diagnostic {
    choices := [String]{}
    seen := [String]{}
    loop label in scopes.loop_labels {
        if seen.contains(label.name) -> next
        seen.push(label.name)
        choices.push("`break({label.name})` or `next({label.name})`")
    }
    fix := "label an enclosing loop with `name: loop {{ … }}` first"
    if choices.len() > 0 -> fix = "use a label in scope: {choices.join(", ")}"
    sema_error("E0987", span, "no loop labeled `{name}` is in scope", "a named `break`/`next` must name an enclosing `name: loop`", fix)
}
sema_stmt_move_direct: fn(expr: Expr, state: &SemaOwnershipState, scopes: SemaScopeTable, consumer: String, diagnostics: &[Diagnostic]) -> Bool {
    if expr == {
        .Place(_, _, _, _) | .Copy(_, _, _) -> return true
        else -> {}
    }
    sema_ownership_mark_unmarked_move(state, expr, scopes, consumer, diagnostics)
}

sema_stmt_view_access: fn(ty: Type) -> AccessConvention? {
    if ty == {
        .Apply(name, _) -> {
            if name == "View" -> return Val(AccessConvention.Read)
            if name == "ViewMut" -> return Val(AccessConvention.Write)
        }
        else -> {}
    }
    None
}

sema_stmt_view_slot_equal: fn(left: [String], right: [String]) -> Bool Never! {
    if left.len() != right.len() -> return false
    index := 0
    loop index < left.len() {
        if left[index] != right[index] -> return false
        index += 1
    }
    true
}

sema_stmt_view_source_equal: fn(left: ViewSource, right: ViewSource) -> Bool Never! {
    if left == {
        .Receiver -> if right == {.Receiver -> true else -> false}
        .Parameter(index) -> if right == {.Parameter(other) -> index == other else -> false}
        .Static(module_path, name) -> if right == {.Static(other_module, other_name) -> module_path == other_module && name == other_name else -> false}
    }
}

sema_stmt_view_projection_equal: fn(left: ViewSourceProjection, right: ViewSourceProjection) -> Bool Never! {
    if left == {
        .Field(name) -> if right == {.Field(other) -> name == other else -> false}
        .Index -> if right == {.Index -> true else -> false}
        .Range -> if right == {.Range -> true else -> false}
    }
}

sema_stmt_view_source_path_equal: fn(left: ViewSourcePath, right: ViewSourcePath) -> Bool Never! {
    if !sema_stmt_view_source_equal(left.source, right.source) || left.projections.len() != right.projections.len() -> return false
    index := 0
    loop index < left.projections.len() {
        if !sema_stmt_view_projection_equal(left.projections[index], right.projections[index]) -> return false
        index += 1
    }
    true
}

sema_stmt_record_static_view_return: fn(provenance: &ViewProvenanceMap, slot: [String], source: ViewSourcePath, access: AccessConvention, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    mutable := access == AccessConvention.Write
    entry_index := 0
    loop entry_index < provenance.entries.len() {
        entry: provenance.entries[entry_index]
        if sema_stmt_view_slot_equal(entry.slot, slot) {
            if entry.value.mutable != mutable {
                diagnostics.push(sema_error("E2305", span, "returned view paths disagree about read or write access", "one public output slot cannot sometimes be a read view and sometimes be an exclusive write view", "return the same view access on every path"))
                return false
            }
            source_index := 0
            loop source_index < entry.value.sources.len() {
                if sema_stmt_view_source_path_equal(entry.value.sources[source_index], source) -> return true
                source_index += 1
            }
            provenance.entries[entry_index].value.sources.push(source.copy())
            return true
        }
        entry_index += 1
    }
    sources := [ViewSourcePath]{source}
    provenance.entries.push(ViewProvenanceEntry{slot: slot, value: ViewProvenance{sources: sources, mutable: mutable}})
    true
}

sema_stmt_call_return_views_at: fn(span: Span, context: SemaCheckContext) -> [SemaCallReturnViewFact] Never! {
    index := context.call_return_views.len() - 1
    loop index >= 0 {
        row: context.call_return_views[index]
        if row.span.start == span.start && row.span.end == span.end -> return row.facts
        index -= 1
    }
    [SemaCallReturnViewFact]{}
}

sema_stmt_call_return_views_for_expr: fn(expr: Expr, context: SemaCheckContext) -> [SemaCallReturnViewFact] {
    if expr == {
        .Call(call, _) -> {
            direct: sema_stmt_call_return_views_at(call.name_span, context)
            if direct.len() > 0 -> return direct
            // A call through a callable local publishes at its whole span.
            return sema_stmt_call_return_views_at(sema_expr_local_call_span(call), context)
        }
        .MethodCall(_, _, method_span, _, _, _, _) | .OptMethodCall(_, _, method_span, _, _, _, _) -> return sema_stmt_call_return_views_at(method_span, context)
        .CallValue(_, _, span, _) -> return sema_stmt_call_return_views_at(span, context)
        .Paren(value, _, _) | .Place(value, _, _, _) | .Tainted(value, _, _, _) | .Try(value, _, _, _, _) | .Present(value, _, _) | .Ok(value, _, _) | .OrFallback(value, _, _, _, _) -> return sema_stmt_call_return_views_for_expr(value, context)
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            result := [SemaCallReturnViewFact]{}
            loop field in fields {
                loop fact in sema_stmt_call_return_views_for_expr(field.value, context) {
                    slot := [String]{field.name}
                    loop part in fact.slot -> slot.push(part)
                    result.push(SemaCallReturnViewFact{slot: slot, access: fact.access, places: fact.places, sources: fact.sources, temporaries: fact.temporaries})
                }
            }
            return result
        }
        .Field(base, member, _, _) | .OptField(base, member, _, _, _, _) -> {
            source := sema_stmt_call_return_views_for_expr(base, context)
            result := [SemaCallReturnViewFact]{}
            index := 0
            loop index < source.len() {
                fact: source[index]
                dotted: ".{member}"
                if fact.slot.len() > 0 && (fact.slot[0] == member || fact.slot[0] == dotted) {
                    slot := [String]{}
                    slot_index := 1
                    loop slot_index < fact.slot.len() {
                        slot.push(fact.slot[slot_index])
                        slot_index += 1
                    }
                    result.push(SemaCallReturnViewFact{slot: slot, access: fact.access, places: fact.places, sources: fact.sources, temporaries: fact.temporaries})
                }
                index += 1
            }
            return result
        }
        else -> [SemaCallReturnViewFact]{}
    }
}
sema_stmt_local_view_facts_for_expr: fn(expr: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState, context: SemaCheckContext) -> [SemaCallReturnViewFact] {
    sema_stmt_local_view_facts_inner(expr, scopes, state, context, false)
}

sema_stmt_local_view_facts_inner: fn(expr: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState, context: SemaCheckContext, aggregate: Bool) -> [SemaCallReturnViewFact] {
    if expr == {
        .Ident(name, _, _) -> {
            symbol: sema_scope_resolve(scopes, name) ?? return [SemaCallReturnViewFact]{}
            result := [SemaCallReturnViewFact]{}
            loop local_fact in context.local_view_provenance {
                if local_fact.carrier_key != symbol.id.key -> next
                projected_expr := expr
                projectable := true
                loop part in local_fact.output_path {
                    member := part
                    if part.starts_with(".") -> member = part.slice(1, part.len())
                    if part.starts_with("[") || part == "*" {
                        projectable = false
                        break
                    }
                    projected_expr = Expr.Field{base: projected_expr, member: member, span: expr_span(projected_expr), id: AST_NODE_GENERATED}
                }
                places := [SemaOwnershipPlace]{}
                if projectable -> places = sema_ownership_places_from_expr_in_state(projected_expr, scopes, state)
                result.push(SemaCallReturnViewFact{slot: local_fact.output_path, access: local_fact.access, places: places, sources: local_fact.sources})
            }
            // A range binding records its owner in the ownership state rather
            // than the call-provenance table. Preserve its nested output slot.
            if aggregate && result.len() == 0 {
                loop fact in state.views {
                    if fact.carrier_key != symbol.id.key || !fact.active -> next
                    slot := [String]{}
                    loop part in fact.output_path -> slot.push(if part.starts_with(".") -> part.slice(1, part.len()) else -> part)
                    result.push(SemaCallReturnViewFact{slot: slot, access: fact.access, places: [SemaOwnershipPlace]{fact.source}, sources: [ViewSourcePath]{}})
                }
            }
            if aggregate && result.len() == 0 && symbol.ty == .Val(ty) {
                if sema_stmt_view_access(ty) == .Val(access) {
                    places: sema_ownership_places_from_expr_in_state(expr, scopes, state)
                    result.push(SemaCallReturnViewFact{slot: [String]{}, access: access, places: places, sources: [ViewSourcePath]{}})
                }
            }
            return result
        }
        .Field(base, member, _, _) | .OptField(base, member, _, _, _, _) -> {
            source := sema_stmt_local_view_facts_inner(base, scopes, state, context, aggregate)
            result := [SemaCallReturnViewFact]{}
            dotted: ".{member}"
            loop fact in source {
                if fact.slot.len() == 0 || (fact.slot[0] != member && fact.slot[0] != dotted) -> next
                slot := [String]{}
                index := 1
                loop index < fact.slot.len() {
                    slot.push(fact.slot[index])
                    index += 1
                }
                result.push(SemaCallReturnViewFact{slot: slot, access: fact.access, places: fact.places, sources: fact.sources, temporaries: fact.temporaries, span: fact.span})
            }
            return result
        }
        .Paren(value, _, _) | .Tainted(value, _, _, _) | .Try(value, _, _, _, _) | .Present(value, _, _) | .Ok(value, _, _) -> return sema_stmt_local_view_facts_inner(value, scopes, state, context, aggregate)
        .Place(value, access, _, _) -> {
            facts := sema_stmt_local_view_facts_inner(value, scopes, state, context, aggregate)
            if aggregate && access == PlaceAccess.Write {
                loop index in 0..<facts.len() {
                    if facts[index].slot.len() == 0 -> facts[index].access = AccessConvention.Write
                }
            }
            return facts
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> return sema_stmt_local_view_facts_fields(fields, false, scopes, state, context)
        // `Domain{ value: view }` with a written head: the same named fields,
        // but only those whose declared type holds a view; any other field
        // stores its own copy.
        .TypedLit(_, body, _, _) -> {
            if body == .Fields(fields) -> return sema_stmt_local_view_facts_fields(fields, true, scopes, state, context)
            return [SemaCallReturnViewFact]{}
        }
        .Slice(_, _, _, _, _, _) -> {
            if !aggregate -> return [SemaCallReturnViewFact]{}
            places: sema_ownership_places_from_expr_in_state(expr, scopes, state)
            return [SemaCallReturnViewFact]{SemaCallReturnViewFact{slot: [String]{}, access: AccessConvention.Read, places: places, sources: [ViewSourcePath]{}}}
        }
        // A `trim`/`after`/`before` window on a `String` name stored straight
        // into an aggregate field borrows that name (Rust `view_call_sources`).
        .MethodCall(_, _, _, _, _, _, _) -> {
            if !aggregate -> return [SemaCallReturnViewFact]{}
            places: sema_string_view_call_sources(expr, scopes, state)
            if places.len() == 0 -> return [SemaCallReturnViewFact]{}
            return [SemaCallReturnViewFact]{SemaCallReturnViewFact{slot: [String]{}, access: AccessConvention.Read, places: places, sources: [ViewSourcePath]{}}}
        }
        else -> [SemaCallReturnViewFact]{}
    }
}

// Rust `check_aggregate_view_return`: each field of a returned literal fills
// its own output slot, and a report names the field value that holds the view.
// `typed` keeps only fields checked against a view type (view_field_values);
// a `s.slice(..)` field is a view only in such a field, so it is kept the
// same way in either literal form.
sema_stmt_local_view_facts_fields: fn(fields: [ExprField], typed: Bool, scopes: SemaScopeTable, state: &SemaOwnershipState, context: SemaCheckContext) -> [SemaCallReturnViewFact] {
    result := [SemaCallReturnViewFact]{}
    loop field in fields {
        if (typed || sema_string_view_is_slice_call(field.value)) && !sema_stmt_view_field_value(field.value, context) -> next
        loop fact in sema_stmt_local_view_facts_inner(field.value, scopes, state, context, true) {
            slot := [String]{field.name}
            loop part in fact.slot -> slot.push(part)
            span: if fact.span == None -> Val(expr_source_span(field.value)) else -> fact.span
            result.push(SemaCallReturnViewFact{slot: slot, access: fact.access, places: fact.places, sources: fact.sources, temporaries: fact.temporaries, span: span})
        }
    }
    result
}

sema_stmt_view_field_value: fn(value: Expr, context: SemaCheckContext) -> Bool Never! {
    span: expr_span(value)
    loop listed in context.view_field_values {
        if listed.start == span.start && listed.end == span.end -> return true
    }
    false
}

sema_stmt_store_local_view_provenance: fn(carrier_key: String, facts: [SemaCallReturnViewFact], context: &SemaCheckContext) Never! {
    loop fact in facts {
        context.local_view_provenance.push(SemaLocalViewProvenance{carrier_key: carrier_key, output_path: fact.slot, access: fact.access, sources: fact.sources})
    }
}

sema_stmt_view_owner_path: fn(slot: [String]) -> [String] Never! {
    result := [String]{}
    index := 0
    loop index < slot.len() {
        part: slot[index]
        if {
            part.starts_with(".") || part.starts_with("[") || part == "*" -> {
                result.push(part.copy())
            }
            else -> {
                result.push(".{part}")
            }
        }
        index += 1
    }
    result
}

sema_stmt_call_view_has_dynamic_source: fn(fact: SemaCallReturnViewFact) -> Bool Never! {
    loop source in fact.sources {
        if source.source == {
            .Receiver | .Parameter(_) -> return true
            .Static(_, _) -> {}
        }
    }
    false
}

sema_stmt_record_call_view_return: fn(state: &SemaOwnershipState, fact: SemaCallReturnViewFact, slot: [String], scopes: SemaScopeTable, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    provenance := context.return_view_provenance ?? ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
    valid := true
    if {
        fact.places.len() > 0 -> {
            if !sema_ownership_record_view_returns(state, fact.places, fact.access, slot, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, provenance, span, diagnostics) -> valid = false
        }
        sema_stmt_call_view_has_dynamic_source(fact) || fact.sources.len() == 0 -> {
            if !sema_ownership_record_view_returns(state, [SemaOwnershipPlace]{}, fact.access, slot, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, provenance, span, diagnostics) -> valid = false
        }
    }
    loop source in fact.sources {
        if source.source == {
            .Static(_, _) -> {
                if !sema_stmt_record_static_view_return(provenance, slot, source, fact.access, span, diagnostics) -> valid = false
            }
            else -> {}
        }
    }
    context.return_view_provenance = Val(provenance)
    valid
}

sema_stmt_string_view_type: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, args) -> name == "View" && args.len() == 1 && args[0] == (Type.Named{name: "str"})
        else -> false
    }
}

// Rust `report_temporary_view_source` at a binding or `return` that keeps a
// returned view: every temporary source is refused, a static string literal
// too, since the kept view outlives the statement. True when the fact names
// a temporary.
sema_stmt_report_temporary_view_sources: fn(fact: SemaCallReturnViewFact, string_view: Bool, diagnostics: &[Diagnostic]) -> Bool {
    loop span in fact.temporaries -> sema_call_report_temporary_view_source(span, string_view, diagnostics)
    fact.temporaries.len() > 0
}

sema_stmt_has_struct_view_source: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .StructLit(_, _, _, _, _, _, _, _) -> true
        .TypedLit(_, body, _, _) -> body == .Fields(_)
        .Field(base, _, _, _) | .OptField(base, _, _, _, _, _) -> sema_stmt_has_struct_view_source(base)
        .Paren(value, _, _) | .Place(value, _, _, _) | .Tainted(value, _, _, _) | .Try(value, _, _, _, _) | .Present(value, _, _) | .Ok(value, _, _) -> sema_stmt_has_struct_view_source(value)
        else -> false
    }
}

// The operand of `value.copy()` (or `~value`), whose views the copy holds.
sema_stmt_copy_operand: fn(expr: Expr) -> Expr? Never! {
    if expr == {
        .Copy(value, _, _) -> Val(value)
        .MethodCall(receiver, method, _, _, type_args, args, _) -> if method == "copy" && args.len() == 0 && type_args.len() == 0 -> Val(receiver) else -> None
        .Paren(value, _, _) -> sema_stmt_copy_operand(value)
        else -> None
    }
}

sema_stmt_record_return_views: fn(expr: Expr, ty: Type, scopes: SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    call_facts := sema_stmt_call_return_views_for_expr(expr, context)
    if sema_stmt_has_struct_view_source(expr) {
        loop fact in sema_stmt_local_view_facts_for_expr(expr, scopes, state, context) -> call_facts.push(fact)
    }
    if call_facts.len() > 0 {
        valid := true
        direct_view := sema_stmt_view_access(ty) != None
        saw_direct := false
        index := 0
        loop index < call_facts.len() {
            fact: call_facts[index]
            if !direct_view || fact.slot.len() == 0 {
                saw_direct = true
                temporary: sema_stmt_report_temporary_view_sources(fact, sema_stmt_string_view_type(ty), diagnostics)
                if temporary -> valid = false
                if (!temporary || fact.places.len() > 0) && !sema_stmt_record_call_view_return(state, fact, fact.slot, scopes, context, fact.span ?? expr_span(expr), diagnostics) -> valid = false
            }
            index += 1
        }
        if direct_view && !saw_direct {
            access: sema_stmt_view_access(ty) ?? AccessConvention.Read
            provenance := context.return_view_provenance ?? ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
            if !sema_ownership_record_view_returns(state, [SemaOwnershipPlace]{}, access, [String]{}, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, provenance, expr_span(expr), diagnostics) -> valid = false
            context.return_view_provenance = Val(provenance)
        }
        return valid
    }
    local_facts := sema_stmt_local_view_facts_for_expr(expr, scopes, state, context)
    if local_facts.len() > 0 {
        valid := true
        direct_view := sema_stmt_view_access(ty) != None
        saw_direct := false
        loop fact in local_facts {
            if !direct_view || fact.slot.len() == 0 {
                saw_direct = true
                if !sema_stmt_record_call_view_return(state, fact, fact.slot, scopes, context, fact.span ?? expr_span(expr), diagnostics) -> valid = false
            }
        }
        if direct_view && !saw_direct {
            access: sema_stmt_view_access(ty) ?? AccessConvention.Read
            provenance := context.return_view_provenance ?? ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
            if !sema_ownership_record_view_returns(state, [SemaOwnershipPlace]{}, access, [String]{}, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, provenance, expr_span(expr), diagnostics) -> valid = false
            context.return_view_provenance = Val(provenance)
        }
        return valid
    }
    access: sema_stmt_view_access(ty) ?? return true
    places := sema_ownership_places_from_expr_in_state(expr, scopes, state)
    provenance := context.return_view_provenance ?? ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
    valid := sema_ownership_record_view_returns(state, places, access, [String]{}, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, provenance, expr_span(expr), diagnostics)
    context.return_view_provenance = Val(provenance)
    valid
}

sema_stmt_binding_is_place_view: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Place(_, access, _, _) -> access != PlaceAccess.Take
        .Paren(value, _, _) -> sema_stmt_binding_is_place_view(value)
        else -> false
    }
}

sema_stmt_binding_is_write_place: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Place(_, access, _, _) -> access == PlaceAccess.Write
        .Paren(value, _, _) -> sema_stmt_binding_is_write_place(value)
        else -> false
    }
}

// A `:` binding made from `&place` is a live write window: assigning it
// writes the place it names.
sema_stmt_binding_is_write_window: fn(state: SemaOwnershipState, key: String) -> Bool Never! {
    loop view in state.views {
        if view.carrier_key == key && view.active && view.access == AccessConvention.Write -> return true
    }
    false
}

// Rust `place_from_expr` on a range: `xs[a..b]` over a named place (through
// fields and indexes) is the source of a read window, and so is `xs[band]`
// when the local `band` holds a range.
sema_stmt_is_bare_range_place: fn(expr: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState) -> Bool {
    if expr == .Slice(_, _, _, _, _, _) -> return sema_ownership_places_from_expr_in_state(expr, scopes, state).len() > 0
    // `xs[a..b]` parses as an index whose operand is the range.
    if expr == .Index(_, index, _, _, _) {
        if index == .Range(_, _, _, _, _) -> return sema_ownership_places_from_expr_in_state(expr, scopes, state).len() > 0
        if index == .Ident(name, span, _) {
            symbol: scopes.bindings[sema_scope_resolve_index_at(scopes, name, span) ?? return false].symbol
            if sema_stmt_for_in_is_range(symbol.ty ?? return false) -> return sema_ownership_places_from_expr_in_state(expr, scopes, state).len() > 0
        }
    }
    false
}

// Rust `check_return` (`bare_place`): a bare whole list place (a name or a
// field of one) returned at a named `View<T>` boundary is a read window over
// all of it. It is written as its full range `place[0..<place.len()]`, so it
// takes the range-window path: typed `View<T>`, owned by the place, and
// lowered without a copy.
sema_stmt_whole_list_window: fn(value: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState) -> Expr? {
    if value == {
        .Ident(_, _, _) | .Field(_, _, _, _) -> {}
        else -> return None
    }
    if sema_ownership_places_from_expr_in_state(value, scopes, state).len() == 0 -> return None
    ty: sema_shared_access_place_type(value, environment, program, scopes) ?? return None
    if sema_expr_unwrap_tag(ty) == {
        .List(_) | .FixedList(_, _) -> {}
        else -> return None
    }
    span: expr_span(value)
    // copy: the full range reads the place twice, as its base and as the receiver of its length
    length: Expr.MethodCall{receiver: value.copy(), method: "len", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{}, id: AST_NODE_GENERATED}
    start: Expr.Int{value: 0, span: span, width: None, raw: None, id: AST_NODE_GENERATED}
    // copy: the slice keeps its bounds both as `start`/`end` and inside its range, as the parser writes `xs[a..<b]`
    whole: Expr.Range{start: start.copy(), end: length.copy(), exclusive: true, span: span, id: AST_NODE_GENERATED}
    Val(Expr.Slice{base: value, start: start, end: length, range: Val(whole), span: span, id: AST_NODE_GENERATED})
}

sema_stmt_record_binding_views: fn(binding: Binding, init_ty: Type, scopes: SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if sema_pin_record_binding(state, binding, init_ty, scopes) -> return true
    // `_: view_call(..)` discards the value at once: no local holds the
    // view, so there is no loan to record (and no binding to carry it).
    if binding.name == "_" -> return true
    // `x: arena.alloc(v)`
    // makes `x` a scope-bound view into `arena`; a reset invalidates it
    // (E0632) and it may not leave the region (E0631).
    if sema_ownership_is_allocator_view(Val(init_ty)) && binding.init == .MethodCall(arena, method, _, _, _, _, _) && method == "alloc" {
        if arena == .Ident(_, _, _) -> return sema_ownership_record_fresh_view_fact(state, binding.name, binding.name_span, arena, [String]{}, AccessConvention.Write, scopes, binding.name_span)
    }
    call_facts := sema_stmt_call_return_views_for_expr(binding.init, context)
    // A copy of a value holding views carries the same views into the
    // binding (Rust `Expr::Copy` keeps its operand's view sources).
    copied: sema_stmt_copy_operand(binding.init)
    if sema_stmt_has_struct_view_source(binding.init) || copied != None {
        // A struct that stores a view is a new carrier of its places: it
        // conflicts with another live view of them as a window would. A
        // carrier whose open is rejected holds no loan.
        loop fact in sema_stmt_local_view_facts_for_expr(copied ?? binding.init, scopes, state, context) {
            if fact.places.len() > 0 && !sema_ownership_check_binding_view_conflicts(state, binding.name, binding.name_span, binding.init, fact.places, fact.access, scopes, diagnostics) -> return true
            call_facts.push(fact)
        }
    }
    if call_facts.len() > 0 {
        owner_facts := [SemaOwnershipCallViewFact]{}
        valid := true
        loop fact in call_facts {
            if sema_stmt_report_temporary_view_sources(fact, sema_stmt_string_view_type(init_ty), diagnostics) -> valid = false
            if {
                fact.places.len() > 0 -> {
                    owner_facts.push(SemaOwnershipCallViewFact{output_path: sema_stmt_view_owner_path(fact.slot), access: fact.access, places: fact.places})
                }
                fact.temporaries.len() > 0 -> {}
                sema_stmt_call_view_has_dynamic_source(fact) || fact.sources.len() == 0 -> {
                    empty_provenance := ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
                    if !sema_ownership_record_view_returns(state, [SemaOwnershipPlace]{}, fact.access, fact.slot, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, empty_provenance, expr_span(binding.init), diagnostics) -> valid = false
                }
            }
        }
        if owner_facts.len() > 0 && !sema_ownership_record_call_view_batch(state, binding.name, binding.name_span, owner_facts, scopes) -> valid = false
        local_symbol: sema_scope_resolve(scopes, binding.name) ?? return false
        sema_stmt_store_local_view_provenance(local_symbol.id.key, call_facts, context)
        return valid
    }
    local_facts := sema_stmt_local_view_facts_for_expr(binding.init, scopes, state, context)
    if local_facts.len() > 0 {
        owner_facts := [SemaOwnershipCallViewFact]{}
        valid := true
        loop fact in local_facts {
            if {
                fact.places.len() > 0 -> {
                    owner_facts.push(SemaOwnershipCallViewFact{output_path: sema_stmt_view_owner_path(fact.slot), access: fact.access, places: fact.places})
                }
                sema_stmt_call_view_has_dynamic_source(fact) || fact.sources.len() == 0 -> {
                    empty_provenance := ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
                    if !sema_ownership_record_view_returns(state, [SemaOwnershipPlace]{}, fact.access, fact.slot, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, empty_provenance, expr_span(binding.init), diagnostics) -> valid = false
                }
            }
        }
        if owner_facts.len() > 0 && !sema_ownership_record_call_view_batch(state, binding.name, binding.name_span, owner_facts, scopes) -> valid = false
        local_symbol: sema_scope_resolve(scopes, binding.name) ?? return false
        sema_stmt_store_local_view_provenance(local_symbol.id.key, local_facts, context)
        return valid
    }
    // `x: &place` is a write window into the place whatever the place's
    // type: a scalar or struct place is not carried by a `ViewMut`.
    view_access: sema_stmt_view_access(init_ty)
    if sema_stmt_binding_is_place_view(binding.init) && (view_access != None || sema_stmt_binding_is_write_place(binding.init)) {
        if sema_expr_place_root_ident(binding.init) == None {
            diagnostics.push(sema_error("E0213", expr_span(binding.init), "a window must start from a place", "only a name followed by fields, indexes, or one range has stable storage to read or edit without copying", "bind the call or temporary to a name first, then take a window into that name"))
            return false
        }
        // A window whose open is rejected is still recorded, contested: it
        // neither blocks nor is blocked by other views, so later uses of it
        // are not judged against the conflict already reported, but it stays
        // a window into its place, so a write through it is not a write
        // without a marker, and a child task that captures it inside a
        // `task.group` body is judged against its place.
        if sema_ownership_view_producer(binding.init) == .Val(producer) {
            producer_places: sema_ownership_places_from_expr_in_state(producer.source, scopes, state)
            if !sema_ownership_check_binding_view_conflicts(state, binding.name, binding.name_span, producer.source, producer_places, producer.access, scopes, diagnostics) {
                first: state.views.len()
                recorded: sema_ownership_record_binding_view(state, binding, scopes)
                sema_ownership_mark_views_contested(state, first)
                return recorded
            }
        }
        return sema_ownership_record_binding_view(state, binding, scopes)
    }
    access: view_access ?? return true
    places := sema_ownership_places_from_expr_in_state(binding.init, scopes, state)
    if places.len() == 0 {
        empty_provenance := ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
        _ := sema_ownership_record_view_returns(state, [SemaOwnershipPlace]{}, access, [String]{}, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, empty_provenance, expr_span(binding.init), diagnostics)
        return false
    }
    contested := false
    if !binding.mutable && sema_stmt_is_bare_range_place(binding.init, scopes, state) && !sema_ownership_check_binding_view_conflicts(state, binding.name, binding.name_span, binding.init, places, access, scopes, diagnostics) {
        if !sema_taskgroup_in_group_body(context) -> return true
        contested = true
    }
    first: state.views.len()
    fact := SemaOwnershipCallViewFact{output_path: [String]{}, access: access, places: places}
    recorded: sema_ownership_record_call_view_batch(state, binding.name, binding.name_span, [SemaOwnershipCallViewFact]{fact}, scopes)
    if contested -> sema_ownership_mark_views_contested(state, first)
    recorded
}

sema_stmt_destructure_names: fn(pattern: BindPattern) -> [BindName] Never! {
    if pattern == {
        .Struct(_, _, fields, _, _) -> fields
        .List(elements, _) | .Tuple(elements, _) -> elements
        .Refutable(_, _, names, _) -> names
    }
}

sema_stmt_destructure_local: fn(name: BindName, ty: Type, mutable: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> TLocal? {
    local_name := if name.rename == .Val(rename) -> rename.name else -> name.name
    local_span := if name.rename == .Val(rename) -> rename.span else -> name.span
    owner := sema_scope_local_owner_key(scopes)
    id := symbol_id(SymbolKind.Local, environment.module_identity, owner, local_name)
    symbol := Symbol{id: id, kind: SymbolKind.Local, name: local_name, module_name: environment.module_identity, owner: Val(owner), span: local_span, ty: Val(ty), visibility: 0}
    if !sema_scope_declare_local(scopes, symbol, mutable, AccessConvention.Read, None, false) {
        diagnostics.push(sema_already_defined(local_name, local_span))
        sema_stmt_shadow_refused_binding(symbol, mutable, scopes, state)
        return None
    }
    sema_ownership_declare_binding(state, symbol, false)
    sema_single_use_note_binding(state, symbol, environment, program)
    local := checked_symbol_local(local_name, local_span, id, ty)
    local.mutable = mutable
    Val(local)
}

// A binding refused as a duplicate name (E0118) still names what was
// written for the statements after it, so their uses check against the
// value bound here instead of cascading from the name it failed to replace.
sema_stmt_shadow_refused_binding: fn(symbol: Symbol, mutable: Bool, scopes: &SemaScopeTable, state: &SemaOwnershipState) Never! {
    frame: scopes.current
    sema_scope_push_binding(scopes, SemaScopeBinding{frame: frame, symbol: symbol, mutable: mutable, access: AccessConvention.Read, integer_bounds: None, string_view: false, compiler_builtin: false})
    sema_ownership_declare_binding(state, symbol, false)
}

sema_stmt_destructure_recover: fn(pattern: BindPattern, mutable: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) Never! {
    loop name in sema_stmt_destructure_names(pattern) {
        _ := sema_stmt_destructure_local(name, Type.Int, mutable, environment, program, scopes, state, diagnostics)
    }
}

sema_stmt_destructure_count: fn(actual: Int, expected: Int, tuple: Bool, literal: Bool, span: Span, diagnostics: &[Diagnostic]) {
    unit := if tuple -> "member" else -> "item"
    actual_suffix := if actual == 1 -> "" else -> "s"
    expected_suffix := if expected == 1 -> "" else -> "s"
    container := if tuple -> if literal -> "tuple literal" else -> "tuple" else -> "list"
    why := if tuple -> if literal -> "a tuple pattern must name exactly as many members as the literal holds" else -> "a tuple pattern must name exactly as many members as the tuple holds" else -> "a list pattern must name exactly as many items as the list holds"
    target := if tuple -> "tuple" else -> "list"
    diagnostics.push(sema_error("E0315", span, "this pattern binds {actual} {unit}{actual_suffix}, but the {container} has {expected}", why, "name {expected} {unit}{expected_suffix} to match the {target}"))
}

// `contains_taskgroup`: whether `ty` holds a `Group`. A function type has its
// own direct `Group` parameter and return checks.
sema_stmt_contains_taskgroup: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> name == "Group"
        .List(inner) | .Shared(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) -> sema_stmt_contains_taskgroup(inner)
        .Map(key, _, value) -> sema_stmt_contains_taskgroup(key) || sema_stmt_contains_taskgroup(value)
        .Result(ok, err) -> sema_stmt_contains_taskgroup(ok) || sema_stmt_contains_taskgroup(err)
        .Apply(_, args) | .Union(args) -> {
            loop arg in args {
                if sema_stmt_contains_taskgroup(arg) -> return true
            }
            false
        }
        .Tuple(fields) -> {
            loop field in fields {
                if sema_stmt_contains_taskgroup(field.ty) -> return true
            }
            false
        }
        else -> false
    }
}

sema_stmt_contains_shared_guard: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, seen: &[String]) -> Bool Never! {
    sema_stmt_type_contains_shared_guard(ty, program.registration_graph, environment.module_identity, environment.generic_params, seen)
}

// The walk takes the registration graph, module identity and generic
// parameters it reads instead of the whole environment: a nominal's fields are
// checked in the nominal's module, and copying the environment per nominal to
// change its module copied the whole registration graph each time.
sema_stmt_type_contains_shared_guard: fn(ty: Type, graph: SemaRegistrationGraph?, module_identity: String, generic_params: [TGenericParam], seen: &[String]) -> Bool Never! {
    resolved := ty
    if graph == .Val(registered) -> resolved = sema_type_resolve_declared_with_generics(registered, ty, module_identity, generic_params)
    if resolved == {
        .Apply(name, args) -> {
            if name == "SharedGuard" -> return true
            loop argument in args {
                if sema_stmt_type_contains_shared_guard(argument, graph, module_identity, generic_params, seen) -> return true
            }
        }
        .Named(_) -> {}
        .List(inner) | .FixedList(inner, _) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) -> return sema_stmt_type_contains_shared_guard(inner, graph, module_identity, generic_params, seen)
        .Map(key, _, value) | .Result(key, value) -> return sema_stmt_type_contains_shared_guard(key, graph, module_identity, generic_params, seen) || sema_stmt_type_contains_shared_guard(value, graph, module_identity, generic_params, seen)
        .Tuple(fields) -> {
            loop field in fields {
                if sema_stmt_type_contains_shared_guard(field.ty, graph, module_identity, generic_params, seen) -> return true
            }
            return false
        }
        .Union(members) -> {
            loop member in members {
                if sema_stmt_type_contains_shared_guard(member, graph, module_identity, generic_params, seen) -> return true
            }
            return false
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop parameter in params {
                if sema_stmt_type_contains_shared_guard(parameter, graph, module_identity, generic_params, seen) -> return true
            }
            if ret == .Val(result) -> return sema_stmt_type_contains_shared_guard(result, graph, module_identity, generic_params, seen)
            return false
        }
        else -> return false
    }
    if graph == .Val(registered) {
        nominal_row: sema_pattern_nominal_row(registered, module_identity, resolved) ?? return false
        nominal: registered.modules[nominal_row.module_index].nominals[nominal_row.row]
        key := nominal.symbol.id.key
        if seen.contains(key) -> return false
        seen.push(key)
        generic_names := (loop parameter in nominal.generic_params -> parameter.name)
        arguments := sema_pattern_subject_args(resolved)
        owner_module: nominal.symbol.module_name
        loop field in nominal.fields {
            field_type := sema_inference_substitute_type(field.ty, generic_names, arguments)
            if sema_stmt_type_contains_shared_guard(field_type, graph, owner_module, generic_params, seen) -> return true
        }
        loop variant in nominal.variants {
            if variant.payload == {
                .Unit -> {}
                .Single(value, _) -> {
                    if sema_stmt_type_contains_shared_guard(sema_inference_substitute_type(value, generic_names, arguments), graph, owner_module, generic_params, seen) -> return true
                }
                .Named(fields) -> loop field in fields {
                    if sema_stmt_type_contains_shared_guard(sema_inference_substitute_type(field.ty, generic_names, arguments), graph, owner_module, generic_params, seen) -> return true
                }
            }
        }
    }
    false
}

sema_stmt_destructure_moves_field: fn(ty: Type, pattern: BindPattern, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    seen := [String]{}
    if sema_stmt_contains_shared_guard(ty, environment, program, seen) -> return true
    if pattern == {
        .Tuple(_, _) -> return sema_shared_access_is_cell_guard_type(ty)
        else -> return false
    }
    false
}

// A destructure whose initializer is an owned temporary (a call result, a
// literal, a take or an explicit copy) moves every field out of it, so
// `(a, b): f()` never copies a field. Only a place initializer (a name,
// field, index or view) keeps its value and copies fields out.
// Rust reference lowering: `destructure_init_is_temporary`.
sema_stmt_destructure_init_is_temporary: fn(init: Expr) -> Bool Never! {
    if init == {
        .Paren(inner, _, _) -> sema_stmt_destructure_init_is_temporary(inner)
        .Try(inner, _, _, _, _) -> sema_stmt_destructure_init_is_temporary(inner)
        .OrFallback(inner, _, _, _, _) -> sema_stmt_destructure_init_is_temporary(inner)
        .Call(_, _) | .CallValue(_, _, _, _) | .MethodCall(_, _, _, _, _, _, _) -> true
        .TupleLit(_, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .Copy(_, _, _) -> true
        .Place(_, access, _, _) -> access == PlaceAccess.Take
        else -> false
    }
}

SemaRefutableFallbackCheck: struct {
    or_fallback: TOrFallback?
    statements: [TStmt]
    complete: Bool
    ambient_err: TLocal?
}

sema_stmt_refutable_expr_diverges: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Paren(inner, _, _) -> return sema_stmt_refutable_expr_diverges(inner)
        .Todo(_, _, _) | .NoElse(_, _) -> return true
        .Call(call, _) -> return call.name == "panic"
        else -> return false
    }
}

sema_stmt_refutable_expr_is_true: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Paren(inner, _, _) -> return sema_stmt_refutable_expr_is_true(inner)
        .Bool(value, _, _) -> return value
        else -> return false
    }
}

sema_stmt_refutable_is_subjectless_guard: fn(subject: Expr, span: Span) -> Bool Never! {
    if subject == {
        .Bool(value, subject_span, _) -> return value && subject_span == span
        else -> return false
    }
}

// L0302: every arm of a subjectless guard table opens with a pattern test on
// the same place, and that place is a user enum; naming the subject makes the
// table one exhaustively checked enum switch.
sema_stmt_lint_same_enum_guards: fn(arms: [SwitchArm], conditions: [SemaCheckedCondition?], span: Span, diagnostics: &[Diagnostic]) Never! {
    if arms.len() < 2 -> return
    first := ""
    loop (index, arm) in arms {
        path: sema_stmt_leading_guard_path(arm.cond) ?? return
        if index == 0 {
            first = path
        } else if path != first {
            return
        }
    }
    loop condition in conditions {
        checked: condition ?? next
        enum_name: sema_stmt_leading_guard_enum(checked.condition) ?? next
        diagnostics.push(sema_lint("L0302", span, "These arm heads all dispatch on `{enum_name}`", "Naming the subject makes one closed enum's cases explicit and exhaustively checked", "Write `if {first} == {{ ... }}` and put each variant pattern in an arm"))
        return
    }
}

// L0514: three or more adjacent else-less guards that each compare one
// stable local with literals (`if key == "rev" || key == "r" { … }`) are one
// categorical dispatch; an ordered subject table states it once. A guard body
// that assigns the subject makes the guards order-dependent, so it ends the run.
sema_stmt_lint_same_subject_dispatch: fn(statements: [Stmt], environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) {
    index := 0
    loop index < statements.len() {
        run_end := index + 1
        if sema_stmt_categorical_guard_subject(statements[index]) == .Val(subject) {
            loop run_end < statements.len() && sema_stmt_categorical_guard_subject(statements[run_end]) == (Val(subject)) -> run_end += 1
            if run_end - index >= 3 && sema_stmt_guard_run_keeps_subject(statements, index, run_end, subject) {
                diagnostic := sema_lint("L0514", sema_compiler_index_stmt_span(statements[index]), "Adjacent categorical guards over `{subject}` can be one ordered subject table", "Exclusive guards repeat one stable subject; an ordered table keeps the categories together", "Rewrite as `if {subject} == {{ … }}` and group aliases with `|`; see `Examples/Apps/Programs/Dispatch.jet`")
                if sema_stmt_same_subject_table_edit(statements, index, run_end, subject, environment, program) == .Val(edit) -> diagnostic = diagnostic_with_edit_grade(diagnostic, edit, DiagnosticFixApplicability.Suggested, DiagnosticFixSafety.NeedsReview)
                diagnostics.push(diagnostic)
            }
        }
        index = run_end
    }
}

// One group a block takes out of a Map by key and grows (L0534): the local's
// name, the source of the Map, the key and the fallback group, and the span of
// the take.
SemaStmtMapGroupTake: struct { name: String, map: String, key: String, fallback: String, span: Span }

// L0534: `group := groups.get(key) ?? fallback`, a write such as
// `group.insert(0, item)`, then `groups[key] = group` copies the whole group
// on every pass. The local still shares the entry's buffer when it is
// written, so the write first makes it unique by copying it, strings and
// all, and the store then drops the Map's old copy: a loop of these is
// quadratic. Growing the entry in place (`groups[key].insert(0, item)`, the
// key seeded first when it is missing) copies nothing. The fix is that
// rewrite when the block is exactly take, one write, store, and the local is
// not read after the store. A block the compiler already builds without the
// copy (sema_stmt_map_group_moved) is not reported. Only a block that takes
// a group copies the module's bytes (`String.bytes`): a copy for every block
// makes a large module's check quadratic.
sema_stmt_lint_map_group_round_trip: fn(statements: [Stmt], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) {
    graph: program.registration_graph ?? return
    caller: sema_scope_caller_index(environment, graph) ?? return
    loop index in 0..<statements.len() {
        if !sema_stmt_map_group_takes(statements[index]) -> next
        raw: graph.modules[caller].source.bytes()
        taken: sema_stmt_map_group_take(statements[index], raw) ?? next
        stored := -1
        written := ""
        loop later in (index + 1)..<statements.len() {
            if sema_stmt_map_group_store(statements[later], raw, taken) {
                stored = later
                break
            }
            if written == "" {
                if sema_stmt_map_group_write(statements[later], taken.name) == .Val(method) -> written = method
            }
        }
        if stored < 0 || written == "" || sema_stmt_map_group_moved(statements, index, stored, taken, raw, scopes) -> next
        diagnostic := sema_lint("L0534", taken.span, "`{taken.name}` copies the whole group out of `{taken.map}` and stores it back", "`{taken.name}` still shares the entry's buffer when it is written, so the write first copies the whole group, and storing it back drops the Map's old copy; in a loop that is quadratic. The build grows the entry in place only when the Map is a variable the function declares, the statements before the store neither name it nor `break` or `next`, and nothing after the store names the group", "Grow the entry in place: `if !{taken.map}.has_key({taken.key}) -> {taken.map}[{taken.key}] = {taken.fallback}`, then `{taken.map}[{taken.key}].{written}(…)`")
        if stored == index + 2 && sema_stmt_map_group_edit(statements, index, taken, raw) == .Val(edit) -> diagnostic = diagnostic_with_edit_grade(diagnostic, edit, DiagnosticFixApplicability.Suggested, DiagnosticFixSafety.NeedsReview)
        diagnostics.push(diagnostic)
    }
}

// Whether the build grows the group in the Map's entry instead of copying
// it (JetIR BuildMaps.jet ir_map_take_fuses): the Map is a variable the
// function declares, not a parameter; the key is a variable or a field of
// one, and that variable is constant or the statements between the take and
// the store never name it; those statements never name the Map and never
// `break` or `next`; and nothing after the store names the group. The build
// also copies where a closure of the function names the Map or a
// transaction holds the update, which this check does not see.
sema_stmt_map_group_moved: fn(statements: [Stmt], index: Int, stored: Int, taken: SemaStmtMapGroupTake, raw: [U8], scopes: SemaScopeTable) -> Bool {
    if statements[index] == .Val(binding) {
        if binding.init == .OrFallback(value, _, _, _, _) {
            if value == .MethodCall(receiver, _, _, _, _, args, _) {
                map := ""
                if receiver == .Ident(local, _, _) {
                    map = local.copy()
                } else {
                    return false
                }
                if !sema_stmt_map_group_declared(statements, index, map, scopes) -> return false
                root: sema_stmt_map_group_key_root(args[0].expr) ?? return false
                // The statements between run from the take's end to the line
                // of the store.
                store: sema_compiler_index_stmt_span(statements[stored])
                line_start := store.start
                loop line_start > 0 && raw[line_start - 1] != (U8{10}) -> line_start -= 1
                between: sema_stmt_source_text(raw, Span{start: taken.span.end, end: line_start}) ?? ""
                if sema_stmt_names_word(between, map) || sema_stmt_names_word(between, "break") || sema_stmt_names_word(between, "next") -> return false
                if sema_stmt_map_group_mutable(statements, index, root, scopes) && sema_stmt_names_word(between, root) -> return false
                block_end: sema_stmt_scan_close(raw, store.end) ?? return false
                rest: sema_stmt_source_text(raw, Span{start: store.end, end: block_end}) ?? ""
                return !sema_stmt_names_word(rest, taken.name)
            }
        }
    }
    false
}

// Whether `name` is a variable the function declares: one of the statements
// before `index` binds it, or the scope does as a local, not a parameter.
sema_stmt_map_group_declared: fn(statements: [Stmt], index: Int, name: String, scopes: SemaScopeTable) -> Bool {
    loop earlier in 0..<index {
        if statements[earlier] == .Val(binding) {
            if binding.pattern == None && binding.name == name -> return true
        }
    }
    found: sema_scope_resolve_index(scopes, name) ?? return false
    if sema_scope_binding_is_light(scopes, found) -> return false
    scopes.bindings[found].symbol.kind == .Local
}

// Whether the variable `name` may be written: the latest of the statements
// before `index` that binds it is mutable, or the scope's binding is.
sema_stmt_map_group_mutable: fn(statements: [Stmt], index: Int, name: String, scopes: SemaScopeTable) -> Bool {
    earlier := index - 1
    loop earlier >= 0 {
        if statements[earlier] == .Val(binding) {
            if binding.pattern == None && binding.name == name -> return binding.mutable
        }
        earlier -= 1
    }
    found: sema_scope_resolve_index(scopes, name) ?? return true
    scopes.bindings[found].mutable
}

// The variable `key` reads when it is that variable or a field of one.
sema_stmt_map_group_key_root: fn(key: Expr) -> String? {
    if key == .Ident(local, _, _) -> return Val(local.copy())
    if key == .Field(base, _, _, _) -> return sema_stmt_map_group_key_root(base)
    None
}

// The source text of `span`, None outside `raw`.
sema_stmt_source_text: fn(raw: [U8], span: Span) -> String? {
    if span.start < 0 || span.end > raw.len() || span.start >= span.end -> return None
    text: String.from_bytes(raw[span.start..<span.end]) ?? return None
    Val(text)
}

// Whether `statement` is `name := map.get(key) ?? fallback` with a mutable
// local `name`.
sema_stmt_map_group_takes: fn(statement: Stmt) -> Bool {
    if statement == .Val(binding) {
        if !binding.mutable || binding.pattern != None -> return false
        if binding.init == .OrFallback(value, fallback, _, _, _) {
            if value == .MethodCall(_, method, _, _, _, args, _) {
                if method != "get" || args.len() != 1 -> return false
                return fallback == .Value(_)
            }
        }
    }
    false
}

// The take of a statement sema_stmt_map_group_takes accepts, None when its
// parts' source text is not in `raw`.
sema_stmt_map_group_take: fn(statement: Stmt, raw: [U8]) -> SemaStmtMapGroupTake? {
    if statement == .Val(binding) {
        if !binding.mutable || binding.pattern != None -> return None
        if binding.init == .OrFallback(value, fallback, _, span, _) {
            if value == .MethodCall(receiver, method, _, _, _, args, _) {
                if method != "get" || args.len() != 1 -> return None
                if fallback == .Value(group) {
                    map: sema_stmt_source_text(raw, expr_source_span(receiver)) ?? return None
                    key: sema_stmt_source_text(raw, expr_source_span(args[0].expr)) ?? return None
                    seed: sema_stmt_source_text(raw, expr_source_span(group)) ?? return None
                    return Val(SemaStmtMapGroupTake{name: binding.name.copy(), map: map, key: key, fallback: seed, span: Span{start: binding.name_span.start, end: span.end}})
                }
            }
        }
    }
    None
}

// `map[key] = name` or `map[key] = name.move()`, the take's Map and key
// written as they were taken.
sema_stmt_map_group_store: fn(statement: Stmt, raw: [U8], taken: SemaStmtMapGroupTake) -> Bool {
    if statement == .Assign(target, op, _, value) {
        if op != None || !sema_stmt_names_local(value, taken.name) -> return false
        if target == .Index(base, index, _, _) {
            return (sema_stmt_source_text(raw, expr_source_span(base)) == Val(taken.map.copy())) && (sema_stmt_source_text(raw, expr_source_span(index)) == Val(taken.key.copy()))
        }
    }
    false
}

// Whether `value` is the local `name`, or `name.move()`.
sema_stmt_names_local: fn(value: Expr, name: String) -> Bool {
    if value == .Ident(local, _, _) -> return local == name
    if value == .MethodCall(receiver, method, _, _, _, args, _) {
        if method != "move" || args.len() != 0 -> return false
        if receiver == .Ident(local, _, _) -> return local == name
    }
    false
}

// The method of a statement `name.method(…)` that grows or reorders the
// group in place; None for any other statement.
sema_stmt_map_group_write: fn(statement: Stmt, name: String) -> String? {
    if statement == .Expr(call) {
        if call == .MethodCall(receiver, method, _, _, _, _, _) {
            writes: [String]{"push", "extend", "insert", "append", "sort", "reverse"}
            if receiver == .Ident(local, _, _) {
                if local == name && writes.contains(method) -> return Val(method.copy())
            }
        }
    }
    None
}

// The L0534 rewrite of take, write, store: the key seeded when missing, then
// the write through the entry. None when the rest of the block still names
// the local.
sema_stmt_map_group_edit: fn(statements: [Stmt], index: Int, taken: SemaStmtMapGroupTake, raw: [U8]) -> TextEdit? {
    method: sema_stmt_map_group_write(statements[index + 1], taken.name) ?? return None
    // A method call is spanned at its name; its arguments run from the `(`
    // right after it to the matching `)`.
    open: sema_compiler_index_stmt_span(statements[index + 1]).end
    if open >= raw.len() || raw[open] != (U8{40}) -> return None
    close: sema_stmt_scan_close(raw, open + 1) ?? return None
    arguments: sema_stmt_source_text(raw, Span{start: open, end: close + 1}) ?? return None
    // The take starts at its local's name (its statement span starts at `:=`).
    start: taken.span.start
    last: sema_compiler_index_stmt_span(statements[index + 2])
    // A `name.move()` store is spanned at `move`; only a plain store is
    // rewritten.
    if statements[index + 2] == .Assign(_, _, _, value) {
        if !(value == .Ident(_, _, _)) -> return None
    }
    block_end: sema_stmt_scan_close(raw, last.end) ?? return None
    rest: sema_stmt_source_text(raw, Span{start: last.end, end: block_end}) ?? ""
    if sema_stmt_names_word(rest, taken.name) -> return None
    line_start := start
    loop line_start > 0 && raw[line_start - 1] != (U8{10}) -> line_start -= 1
    indent := ""
    loop _ in line_start..<start -> indent = "{indent} "
    entry: "{taken.map}[{taken.key}]"
    Val(TextEdit{span: Span{start: start, end: last.end}, new_text: "if !{taken.map}.has_key({taken.key}) -> {entry} = {taken.fallback}\n{indent}{entry}.{method}{arguments}"})
}

// The offset of the bracket that closes the nesting `from` sits in: the
// first `)`, `]` or `}` outside strings with no opener of its own after
// `from`. None when the source ends first.
sema_stmt_scan_close: fn(raw: [U8], from: Int) -> Int? {
    at := from
    depth := 0
    in_string := false
    loop at < raw.len() {
        byte: raw[at]
        if in_string {
            if byte == (U8{92}) {
                at += 2
                next
            }
            if byte == (U8{34}) -> in_string = false
        } else if byte == (U8{34}) {
            in_string = true
        } else if byte == (U8{40}) || byte == (U8{91}) || byte == (U8{123}) {
            depth += 1
        } else if byte == (U8{41}) || byte == (U8{93}) || byte == (U8{125}) {
            if depth == 0 -> return Val(at)
            depth -= 1
        }
        at += 1
    }
    None
}

// Whether `text` names `word` as a whole identifier.
sema_stmt_names_word: fn(text: String, word: String) -> Bool {
    bytes: text.bytes()
    wanted: word.bytes()
    loop at in 0..<bytes.len() {
        end: at + wanted.len()
        if end > bytes.len() || bytes[at..<end] != wanted -> next
        before: at == 0 || !sema_stmt_identifier_byte(bytes[at - 1])
        after: end >= bytes.len() || !sema_stmt_identifier_byte(bytes[end])
        if before && after -> return true
    }
    false
}

sema_stmt_identifier_byte: fn(byte: U8) -> Bool {
    (byte >= U8{48} && byte <= U8{57}) || (byte >= U8{65} && byte <= U8{90}) || (byte >= U8{97} && byte <= U8{122}) || byte == U8{95}
}

// The L0514 rewrite: one `if subject == { … }` table whose arms keep the
// guards' order, with each guard's literals as one `|` head and its body as
// the arm body, closed by an empty `else` (a String or Int subject is open).
sema_stmt_same_subject_table_edit: fn(statements: [Stmt], start: Int, end: Int, subject: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TextEdit? {
    graph: program.registration_graph ?? return None
    caller: sema_scope_caller_index(environment, graph) ?? return None
    raw: graph.modules[caller].source.bytes()
    first: sema_compiler_index_stmt_span(statements[start])
    if first.start < 0 || first.start > raw.len() -> return None
    line_start := first.start
    loop line_start > 0 && raw[line_start - 1] != (U8{10}) -> line_start -= 1
    indent := ""
    loop _ in line_start..<first.start -> indent = "{indent} "
    text := "if {subject} == {{\n"
    table_end := first.start
    loop index in start..<end {
        if statements[index] == {
            .Switch(_, arms, _, _) -> {
                heads := [String]{}
                if !sema_stmt_category_heads(arms[0].cond, raw, heads) -> return None
                body: sema_stmt_guard_body_text(raw, expr_span(arms[0].cond).end, indent) ?? return None
                text = "{text}{indent}    {heads.join(" | ")} -> {body.text}\n"
                table_end = body.end
            }
            else -> return None
        }
    }
    text = "{text}{indent}    else -> {{}}\n{indent}}}"
    Val(TextEdit{span: Span{start: first.start, end: table_end}, new_text: text})
}

// The literal source of each `subject == literal` disjunct, in order.
sema_stmt_category_heads: fn(condition: Expr, raw: [U8], heads: &[String]) -> Bool {
    if condition == {
        .Paren(inner, _, _) -> return sema_stmt_category_heads(inner, raw, heads)
        .Binary(op, left, right, _, _) -> {
            if op == BinOp.Or -> return sema_stmt_category_heads(left, raw, heads) && sema_stmt_category_heads(right, raw, heads)
            span: expr_span(right)
            if span.start < 0 || span.end > raw.len() || span.start >= span.end -> return false
            head: String.from_bytes(raw[span.start..<span.end]) ?? return false
            heads.push(head)
            return true
        }
        else -> return false
    }
}

// A guard's body after its condition: an arrow body is the rest of its line,
// a braced body with one line becomes an arrow body, and a longer braced body
// stays braced one level deeper.
sema_stmt_guard_body_text: fn(raw: [U8], from: Int, indent: String) -> (text: String, end: Int)? {
    at := from
    loop at < raw.len() && (raw[at] == (U8{32}) || raw[at] == (U8{9})) -> at += 1
    if at + 1 < raw.len() && raw[at] == (U8{45}) && raw[at + 1] == (U8{62}) {
        at += 2
        loop at < raw.len() && raw[at] == (U8{32}) -> at += 1
        line_end := at
        loop line_end < raw.len() && raw[line_end] != (U8{10}) -> line_end += 1
        trimmed := line_end
        loop trimmed > at && (raw[trimmed - 1] == (U8{32}) || raw[trimmed - 1] == (U8{13})) -> trimmed -= 1
        if trimmed == at -> return None
        text: String.from_bytes(raw[at..<trimmed]) ?? return None
        return Val((text: text, end: trimmed))
    }
    if at >= raw.len() || raw[at] != (U8{123}) -> return None
    close := at + 1
    depth := 1
    in_string := false
    loop close < raw.len() {
        byte: raw[close]
        if in_string {
            if byte == (U8{92}) {
                close += 2
                next
            }
            if byte == (U8{34}) -> in_string = false
        } else if byte == (U8{34}) {
            in_string = true
        } else if byte == (U8{123}) {
            depth += 1
        } else if byte == (U8{125}) {
            depth -= 1
            if depth == 0 -> break
        }
        close += 1
    }
    if depth != 0 -> return None
    inner: String.from_bytes(raw[at + 1..<close]) ?? return None
    lines := [String]{}
    loop line in inner.split("\n") {
        if line.trim().len() > 0 -> lines.push(line.trim_end())
    }
    if lines.len() == 0 -> return Val((text: "{{}}", end: close + 1))
    if lines.len() == 1 -> return Val((text: lines[0].trim(), end: close + 1))
    text := "{{\n"
    loop line in lines -> text = "{text}    {line}\n"
    Val((text: "{text}{indent}    }}", end: close + 1))
}

// The local a classic else-less one-arm `if` compares with literals, when
// every disjunct of its condition is `local == literal`.
sema_stmt_categorical_guard_subject: fn(statement: Stmt) -> String? Never! {
    if statement == {
        .Switch(subject, arms, else_body, span) -> {
            if else_body != None || arms.len() != 1 || !sema_stmt_refutable_is_subjectless_guard(subject, span) -> return None
            return sema_stmt_categorical_condition_subject(arms[0].cond)
        }
        else -> return None
    }
}

sema_stmt_categorical_condition_subject: fn(condition: Expr) -> String? Never! {
    if condition == {
        .Paren(inner, _, _) -> return sema_stmt_categorical_condition_subject(inner)
        .Binary(op, left, right, _, _) -> {
            if op == BinOp.Or {
                left_subject: sema_stmt_categorical_condition_subject(left) ?? return None
                right_subject: sema_stmt_categorical_condition_subject(right) ?? return None
                return if left_subject == right_subject -> Val(left_subject) else -> None
            }
            if op != BinOp.Eq -> return None
            if left == {
                .Ident(name, _, _) -> return if sema_stmt_is_category_literal(right) -> Val("{name}") else -> None
                else -> return None
            }
        }
        else -> return None
    }
}

sema_stmt_is_category_literal: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Str(_, _, _) | .Int(_, _, _, _, _) | .Char(_, _, _) -> return true
        else -> return false
    }
}

sema_stmt_guard_run_keeps_subject: fn(statements: [Stmt], start: Int, end: Int, subject: String) -> Bool Never! {
    loop index in start..<end {
        if statements[index] == {
            .Switch(_, arms, _, _) -> loop arm in arms {
                loop statement in arm.body {
                    if sema_stmt_assigned_local(statement) == (Val(subject)) -> return false
                }
            }
            else -> {}
        }
    }
    true
}

sema_stmt_assigned_local: fn(statement: Stmt) -> String? Never! {
    if statement == {
        .Assign(target, _, _, _) -> {
            if target == {
                .Local(name, _) -> return Val("{name}")
                else -> return None
            }
        }
        else -> return None
    }
}

sema_stmt_leading_guard_path: fn(condition: Expr) -> String? Never! {
    if condition == {
        .PatternTest(subject, _, _, _) -> return sema_stmt_guard_subject_path(subject)
        .Binary(op, left, _, _, _) -> return if op == BinOp.And -> sema_stmt_leading_guard_path(left) else -> None
        else -> return None
    }
}

sema_stmt_guard_subject_path: fn(expr: Expr) -> String? Never! {
    if expr == {
        .Ident(name, _, _) -> return Val("{name}")
        .Field(base, member, _, _) -> {
            base_path: sema_stmt_guard_subject_path(base) ?? return None
            return Val("{base_path}.{member}")
        }
        .Copy(inner, _, _) | .Paren(inner, _, _) -> return sema_stmt_guard_subject_path(inner)
        else -> return None
    }
}

// The enum a checked guard head tests first, when its pattern names one.
sema_stmt_leading_guard_enum: fn(condition: TIfCond) -> String? Never! {
    if condition == {
        .IfLet(pattern, subject) -> return if pattern.enum_type != None -> Val(type_name(subject.ty)) else -> None
        .And(left, _) -> return sema_stmt_leading_guard_enum(left)
        else -> return None
    }
}

sema_stmt_refutable_loop_labels: fn(nested_labels: [String], label: NamedSpan?) -> [String] Never! {
    labels := [String]{}
    loop nested_label in nested_labels -> labels.push(nested_label.copy())
    if label == {
        .Val(value) -> labels.push(value.name)
        .None -> {}
    }
    labels
}

// L0529 (emit_state_loop_unchanged_lint @ 6083377777): a `loop i := start, cond { …
// }` whose condition reads the mutable header binding while neither the body nor the
// step writes it, and whose body can return to the condition, re-tests unchanged
// state.
sema_stmt_lint_state_loop_unchanged: fn(init: Binding, cond: Expr, step: Stmt?, body: [Stmt], label: NamedSpan?, diagnostics: &[Diagnostic]) Never! {
    if !init.mutable || init.name.is_empty() || !sema_stmt_expr_mentions(cond, init.name) || sema_stmt_state_body_writes(body, init.name) -> return
    if step == .Val(step_statement) {
        if sema_stmt_state_writes(step_statement, init.name) -> return
    }
    label_name := String?{None}
    if label == .Val(value) -> label_name = Val(value.name)
    if !sema_stmt_state_loop_reaches_next_turn(body, label_name) -> return
    row: diagnostic_registry_row("L0529") ?? panic("L0529 has no registry row")
    diagnostics.push(sema_lint("L0529", init.name_span, row.what, row.why, row.fix))
}

SemaStmtNameScan: struct {
    name: String
    found: Bool
}

sema_stmt_expr_mentions: fn(expression: Expr, name: String) -> Bool Never! {
    scan := SemaStmtNameScan{name: name, found: false}
    ast_visit_expr(expression, (value: Expr) -> sema_stmt_note_name_mention(scan, value))
    scan.found
}

sema_stmt_note_name_mention: fn(scan: &SemaStmtNameScan, value: Expr) Never! {
    if value == .Ident(candidate, _, _) {
        if candidate == scan.name -> scan.found = true
    }
}

sema_stmt_state_body_writes: fn(body: [Stmt], name: String) -> Bool Never! {
    loop statement in body {
        if sema_stmt_state_writes(statement, name) -> return true
    }
    false
}

// Rust statement_writes_name: an assignment rooted at `name` anywhere in the
// statement, or an expression that writes it (a write place or argument, a
// method call on it, or an assignment inside a lambda, `if` or fallback body).
sema_stmt_state_writes: fn(statement: Stmt, name: String) -> Bool Never! {
    if statement == .Assign(target, _, _, _) {
        if sema_stmt_lvalue_root_is(target, name) -> return true
    }
    if sema_stmt_state_nested_writes(statement, name) -> return true
    scan := SemaStmtNameScan{name: name, found: false}
    ast_visit_statement(statement, (value: Expr) -> sema_stmt_note_state_write(scan, value), true)
    scan.found
}

sema_stmt_lvalue_root_is: fn(target: LValue, name: String) -> Bool Never! {
    if target == {
        .Local(candidate, _) -> return candidate == name
        .Field(base, _, _) -> return sema_shared_access_expr_root_is(base, name)
        .Index(base, _, _, _) -> return sema_shared_access_expr_root_is(base, name)
    }
}

sema_stmt_state_nested_writes: fn(statement: Stmt, name: String) -> Bool Never! {
    if statement == {
        .While(_, body, _, _, _) | .For(_, _, _, _, body, _, _, _, _) | .Loop(body, _, _, _) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .ContextBlock(_, body, _) | .Live(body, _) | .AssumeDet(_, _, body, _) | .Transact(_, _, body, _, _) | .ScopeMember(_, _, _, _, body, _, _, _) -> return sema_stmt_state_body_writes(body, name)
        .CountedLoop(_, _, step, body, _, _, _) -> {
            if step == .Val(step_statement) {
                if sema_stmt_state_writes(step_statement, name) -> return true
            }
            return sema_stmt_state_body_writes(body, name)
        }
        .Switch(_, arms, else_body, _) | .ComptimeSwitch(_, arms, else_body, _) -> {
            loop arm in arms {
                if sema_stmt_state_body_writes(arm.body, name) -> return true
            }
            if else_body == .Val(fallback) -> return sema_stmt_state_body_writes(fallback, name)
            return false
        }
        .ComptimeIf(_, _, then_body, else_body, _, _) -> {
            if sema_stmt_state_body_writes(then_body, name) -> return true
            if else_body == .Val(fallback) -> return sema_stmt_state_body_writes(fallback, name)
            return false
        }
        else -> return false
    }
}

sema_stmt_note_state_write: fn(scan: &SemaStmtNameScan, value: Expr) Never! {
    if scan.found -> return
    if value == {
        .Place(inner, access, _, _) -> {
            if access == PlaceAccess.Write && sema_shared_access_expr_root_is(inner, scan.name) -> scan.found = true
        }
        .Call(call, _) -> {
            if sema_stmt_args_write_name(call.args, scan.name) -> scan.found = true
        }
        .CallValue(_, args, _, _) -> {
            if sema_stmt_args_write_name(args, scan.name) -> scan.found = true
        }
        .MethodCall(receiver, _, _, _, _, args, _) -> {
            if sema_shared_access_expr_root_is(receiver, scan.name) || sema_stmt_args_write_name(args, scan.name) -> scan.found = true
        }
        .Lambda(lambda, _) -> {
            if lambda.body == .Block(body) {
                if sema_stmt_state_body_writes(body, scan.name) -> scan.found = true
            }
        }
        .If(_, then_body, _, else_body, _, _, _) -> {
            if sema_stmt_state_body_writes(then_body, scan.name) || sema_stmt_state_body_writes(else_body, scan.name) -> scan.found = true
        }
        .OrFallback(_, fallback, _, _, _) -> {
            if fallback == {
                .Block(body, _, _) -> {
                    if sema_stmt_state_body_writes(body, scan.name) -> scan.found = true
                }
                .Panic(_, args) -> {
                    if sema_stmt_args_write_name(args, scan.name) -> scan.found = true
                }
                else -> {}
            }
        }
        else -> {}
    }
}

sema_stmt_args_write_name: fn(args: [CallArg], name: String) -> Bool Never! {
    loop arg in args {
        if arg.convention == AccessConvention.Write && sema_shared_access_expr_root_is(arg.expr, name) -> return true
    }
    false
}

// Rust state_loop_can_reach_next_turn: a body that does not always exit
// reaches the condition again; one that does reaches it only through a
// `continue` of this loop before its first exiting statement.
sema_stmt_state_loop_reaches_next_turn: fn(body: [Stmt], label: String?) -> Bool Never! {
    if !sema_stmt_refutable_block_exits(body) -> return true
    loop statement in body {
        if sema_stmt_contains_current_continue(statement, label) -> return true
        if sema_stmt_refutable_statement_exits(statement) -> return false
    }
    false
}

sema_stmt_body_contains_current_continue: fn(body: [Stmt], label: String?) -> Bool Never! {
    loop statement in body {
        if sema_stmt_contains_current_continue(statement, label) -> return true
    }
    false
}

sema_stmt_contains_current_continue: fn(statement: Stmt, label: String?) -> Bool Never! {
    if statement == {
        .Continue(_) -> return true
        .ContinueLabel(name, _) -> return label == (Val(name))
        .Switch(_, arms, else_body, _) | .ComptimeSwitch(_, arms, else_body, _) -> {
            loop arm in arms {
                if sema_stmt_body_contains_current_continue(arm.body, label) -> return true
            }
            if else_body == .Val(fallback) -> return sema_stmt_body_contains_current_continue(fallback, label)
            return false
        }
        .ComptimeIf(_, _, then_body, else_body, _, _) -> {
            if sema_stmt_body_contains_current_continue(then_body, label) -> return true
            if else_body == .Val(fallback) -> return sema_stmt_body_contains_current_continue(fallback, label)
            return false
        }
        .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .ContextBlock(_, body, _) | .Live(body, _) | .AssumeDet(_, _, body, _) | .Transact(_, _, body, _, _) | .ScopeMember(_, _, _, _, body, _, _, _) -> return sema_stmt_body_contains_current_continue(body, label)
        else -> return false
    }
}

sema_stmt_refutable_block_exits: fn(statements: [Stmt]) -> Bool Never! {
    loop statement in statements {
        if sema_stmt_refutable_statement_exits(statement) -> return true
    }
    false
}

sema_stmt_refutable_switch_exits: fn(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span) -> Bool Never! {
    if arms.len() == 0 -> return false
    fallback_exits := if else_body == {
        .Val(body) -> sema_stmt_refutable_block_exits(body)
        .None -> !sema_stmt_refutable_is_subjectless_guard(subject, span)
    }
    loop arm in arms {
        if !sema_stmt_refutable_block_exits(arm.body) -> return false
    }
    fallback_exits
}

sema_stmt_refutable_statement_exits: fn(statement: Stmt) -> Bool Never! {
    if statement == {
        .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) -> return true
        .Expr(expr) -> return sema_stmt_refutable_expr_diverges(expr)
        .Switch(subject, arms, else_body, span) -> return sema_stmt_refutable_switch_exits(subject, arms, else_body, span)
        .Loop(body, _, _, _) -> return !sema_stmt_refutable_loop_body_can_break(body)
        .While(cond, body, _, _, _) -> return sema_stmt_refutable_expr_is_true(cond) && !sema_stmt_refutable_loop_body_can_break(body)
        .CountedLoop(_, cond, _, body, _, _, _) -> return sema_stmt_refutable_expr_is_true(cond) && !sema_stmt_refutable_loop_body_can_break(body)
        else -> return false
    }
}

sema_stmt_refutable_loop_body_can_break: fn(statements: [Stmt]) -> Bool Never! {
    sema_stmt_refutable_loop_body_can_break_inner(statements, [String]{}, true)
}

sema_stmt_refutable_label_is_nested: fn(nested_labels: [String], name: String) -> Bool Never! {
    loop nested_label in nested_labels {
        if nested_label == name -> return true
    }
    false
}

// A `?? break` fallback leaves the enclosing loop exactly like a statement
// `break`, so it counts as a reachable loop exit. The `break` can sit at any
// depth of the fallback: `??` is right-associative, so `a ?? b ?? break` is
// `a ?? (b ?? break)` with the exit in a value fallback, and a block
// fallback's final value or a `return` value can hold a chain of its own.
sema_stmt_refutable_fallback_can_break: fn(fallback: OrFallback, nested_labels: [String], allow_unlabelled: Bool) -> Bool Never! {
    if fallback == {
        .Break(_) -> allow_unlabelled
        .BreakLabel(name, _) -> !sema_stmt_refutable_label_is_nested(nested_labels, name)
        .Value(value) -> sema_stmt_refutable_expr_can_break(value, nested_labels, allow_unlabelled)
        .Block(body, value, _) -> sema_stmt_refutable_loop_body_can_break_inner(body, nested_labels, allow_unlabelled) || sema_stmt_refutable_optional_expr_can_break(value, nested_labels, allow_unlabelled)
        .Return(value, _) -> sema_stmt_refutable_optional_expr_can_break(value, nested_labels, allow_unlabelled)
        else -> false
    }
}

sema_stmt_refutable_optional_expr_can_break: fn(value: Expr?, nested_labels: [String], allow_unlabelled: Bool) -> Bool Never! {
    if value == .Val(expr) -> return sema_stmt_refutable_expr_can_break(expr, nested_labels, allow_unlabelled)
    false
}

sema_stmt_refutable_expr_can_break: fn(expr: Expr, nested_labels: [String], allow_unlabelled: Bool) -> Bool Never! {
    if expr == {
        .Paren(inner, _, _) -> sema_stmt_refutable_expr_can_break(inner, nested_labels, allow_unlabelled)
        .OrFallback(value, fallback, _, _, _) -> sema_stmt_refutable_fallback_can_break(fallback, nested_labels, allow_unlabelled) || sema_stmt_refutable_expr_can_break(value, nested_labels, allow_unlabelled)
        .If(cond, then_body, then_value, else_body, else_value, _, _) -> sema_stmt_refutable_expr_can_break(cond, nested_labels, allow_unlabelled) || sema_stmt_refutable_loop_body_can_break_inner(then_body, nested_labels, allow_unlabelled) || sema_stmt_refutable_expr_can_break(then_value, nested_labels, allow_unlabelled) || sema_stmt_refutable_loop_body_can_break_inner(else_body, nested_labels, allow_unlabelled) || sema_stmt_refutable_expr_can_break(else_value, nested_labels, allow_unlabelled)
        else -> false
    }
}

sema_stmt_refutable_binding_can_break: fn(binding: Binding, nested_labels: [String], allow_unlabelled: Bool) -> Bool Never! {
    if binding.pattern == .Val(pattern) {
        if pattern == {
            .Refutable(_, fallback, _, _) -> {
                if sema_stmt_refutable_fallback_can_break(fallback, nested_labels, allow_unlabelled) -> return true
            }
            else -> {}
        }
    }
    sema_stmt_refutable_expr_can_break(binding.init, nested_labels, allow_unlabelled)
}

sema_stmt_refutable_loop_body_can_break_inner: fn(statements: [Stmt], nested_labels: [String], allow_unlabelled: Bool) -> Bool Never! {
    loop statement in statements {
        can_break := if statement == {
            .Break(_) | .BreakValue(_, _) -> allow_unlabelled
            .BreakLabel(name, _) | .BreakLabelValue(name, _, _, _) -> !sema_stmt_refutable_label_is_nested(nested_labels, name)
            .Expr(expr) -> sema_stmt_refutable_expr_can_break(expr, nested_labels, allow_unlabelled)
            .Assign(_, _, _, value) -> sema_stmt_refutable_expr_can_break(value, nested_labels, allow_unlabelled)
            .Val(binding) -> sema_stmt_refutable_binding_can_break(binding, nested_labels, allow_unlabelled)
            .Switch(_, arms, else_body, _) | .ComptimeSwitch(_, arms, else_body, _) -> {
                found := false
                loop arm in arms {
                    if sema_stmt_refutable_loop_body_can_break_inner(arm.body, nested_labels, allow_unlabelled) -> found = true
                }
                if else_body == {
                    .Val(body) -> found || sema_stmt_refutable_loop_body_can_break_inner(body, nested_labels, allow_unlabelled)
                    .None -> found
                }
            }
            .Loop(body, _, _, label) | .While(_, body, _, _, label) | .For(_, _, _, _, body, _, _, label, _) | .CountedLoop(_, _, _, body, _, _, label) -> sema_stmt_refutable_loop_body_can_break_inner(body, sema_stmt_refutable_loop_labels(nested_labels, label), false)
            // A marker block runs its body in line, so a `break` inside it
            // leaves the enclosing loop as one written beside it does.
            .ComptimeIf(_, _, then_body, else_body, _, _) -> sema_stmt_refutable_loop_body_can_break_inner(then_body, nested_labels, allow_unlabelled) || (else_body != None && sema_stmt_refutable_loop_body_can_break_inner(else_body ?? [Stmt]{}, nested_labels, allow_unlabelled))
            .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .ContextBlock(_, body, _) | .Live(body, _) | .AssumeDet(_, _, body, _) | .Transact(_, _, body, _, _) | .ScopeMember(_, _, _, _, body, _, _, _) -> sema_stmt_refutable_loop_body_can_break_inner(body, nested_labels, allow_unlabelled)
            else -> false
        }
        if can_break -> return true
        if sema_stmt_refutable_statement_exits(statement) -> return false
    }
    false
}

sema_stmt_refutable_tree_block_has_never_expr: fn(statements: [TStmt]) -> Bool Never! {
    loop statement in statements {
        if statement == {
            .ExprStmt(value, _) -> {
                if value.ty == (Type.Named{name: "Never"}) -> return true
            }
            else -> {}
        }
    }
    false
}

sema_stmt_refutable_contextual_pattern: fn(pattern: Pattern, subject_ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Pattern Never! {
    if pattern == {
        .Or(alternatives, span) -> {
            normalized := (loop item in alternatives -> sema_stmt_refutable_contextual_pattern(item, subject_ty, environment, program))
            return Pattern.Or{alternatives: normalized, span: span}
        }
        .Variant(variant, slots, _, span) -> {
            if variant == "value" && slots.len() == 1 {
                if sema_expr_unwrap_tag(subject_ty) == {
                    .Option(_) -> {
                        binding: sema_pattern_normalize_contextual_binding(slots[0], span)
                        return Pattern.Present{binding: binding.name, binding_span: binding.span, inner: None, span: span}
                    }
                    else -> {}
                }
            }
        }
        else -> {}
    }
    sema_pattern_normalize_contextual(pattern, subject_ty, environment, program)
}

sema_stmt_refutable_capture_fact: fn(facts: [TPatternBindingFact], name: BindName) -> TPatternBindingFact? {
    local_name := if name.rename == .Val(rename) -> rename.name else -> name.name
    loop fact in facts {
        if fact.name == local_name -> return Val(fact)
    }
    loop fact in facts {
        if fact.name == name.name -> return Val(fact)
    }
    None
}

sema_stmt_refutable_capture_payload: fn(pattern: TPattern, subject_ty: Type) -> Type? {
    if pattern.shape == {
        .Ok(_, _, inner, _) -> {
            if inner != None -> return None
            if sema_expr_unwrap_tag(subject_ty) == {
                .Result(ok, _) -> return Val(ok)
                else -> return None
            }
        }
        .Present(_, _, inner, _) -> {
            if inner != None -> return None
            if sema_expr_unwrap_tag(subject_ty) == {
                .Option(payload) -> return Val(payload)
                else -> return None
            }
        }
        else -> return None
    }
    None
}

sema_stmt_refutable_assign_capture_identity: fn(pattern: &TPattern, name: BindName, local: TLocal) Never! {
    local_name := if name.rename == .Val(rename) -> rename.name else -> name.name
    loop index in 0..<pattern.bindings.len() {
        fact: pattern.bindings[index]
        if fact.name == local_name || fact.name == name.name {
            pattern.bindings[index].symbol_id = local.symbol_id
            return
        }
    }
}

// The miss route runs in its own frame on the live scope table and on the
// live ownership state (sema_ownership_fork), both rolled back at the end
// (instead of on copies of the whole table and state).
sema_stmt_check_refutable_fallback: fn(fallback: OrFallback, subject_ty: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaRefutableFallbackCheck {
    before := diagnostics.len()
    fallback_mark: sema_scope_mark(scopes)
    fork: sema_ownership_fork(state)
    sema_scope_enter(scopes, state, "refutable.fallback@{span.start}")
    carrier := sema_expr_unwrap_tag(subject_ty)
    result := SemaRefutableFallbackCheck{or_fallback: None, statements: [TStmt]{}, complete: false, ambient_err: None}
    if carrier == {
        .Result(_, error_ty) -> {
            owner := sema_scope_local_owner_key(scopes)
            symbol := Symbol{id: symbol_id(SymbolKind.Local, environment.module_identity, owner, "err"), kind: SymbolKind.Local, name: "err", module_name: environment.module_identity, owner: Val(owner), span: span, ty: Val(error_ty), visibility: 0}
            frame: scopes.current
            sema_scope_push_binding(scopes, SemaScopeBinding{frame: frame, symbol: symbol, mutable: false, access: AccessConvention.Read, integer_bounds: None, string_view: false, compiler_builtin: false})
            sema_ownership_declare_ambient_binding(state, symbol)
            result.ambient_err = Val(checked_symbol_local("err", span, symbol.id, error_ty))
        }
        else -> {}
    }

    // copy: `enclosing_err_denial` restores context.fallback_err_denial after this fallback
    // overwrites it. Jet has no exchange on a field of the write-borrowed `context`.
    enclosing_err_denial: context.fallback_err_denial.copy()
    context.fallback_err_denial = sema_fallback_err_denial_for(carrier)
    if fallback == {
        .Value(value) -> {
            checked := sema_check_expression(value, None, environment, program, scopes, state, tail_store, context, diagnostics)
            if checked != None {
                item: checked ?? sema_node(context, Type.Named{name: "Unit"}, NodeKind.Unit, expr_span(value))
                result.or_fallback = Val(TOrFallback.Value{value: item})
                result.statements.push(TStmt.ExprStmt{value: item, span: expr_span(value)})
            }
            diagnostics.push(sema_error("E0405", expr_span(value), "`??` must diverge after a refutable binding", "a failed pattern match cannot continue without defining the captures", "use `return`, `panic(...)`, `break`, or `next` as the fallback"))
        }
        .Block(body, value, block_span) -> {
            block_mark: sema_scope_mark(scopes)
            sema_scope_enter(scopes, state, "refutable.block@{block_span.start}")
            // copy: `block_return_type` restores scopes.return_type after the fallback block
            // overwrites it. Jet has no exchange on a field of the write-borrowed `scopes`.
            block_return_type: scopes.return_type.copy()
            block_loop_depth: scopes.loop_depth
            checked_block := sema_check_statements(body, block_return_type, environment, program, scopes, state, tail_store, context, diagnostics, block_loop_depth)
            if value == .Val(tail) -> _ := sema_check_expression(tail, None, environment, program, scopes, state, tail_store, context, diagnostics)
            sema_single_use_leave_scope(scopes, state, diagnostics)
            sema_scope_rollback(scopes, block_mark)
            diverges := value == None && (sema_stmt_refutable_block_exits(body) || sema_stmt_refutable_tree_block_has_never_expr(checked_block.value))
            valid := diverges && checked_block.complete
            if value != None || !diverges {
                diagnostics.push(sema_error("E0405", block_span, "`??` fallback blocks cannot continue after a refutable binding", "a refutable binding needs one direct diverging miss route", "end the block with `return`, `panic(...)`, `break`, or `next`"))
            }
            if valid {
                block_expr := sema_tree_node(Type.Named{name: "Never"}, TExprKind.InlineBlock{body: checked_block.value}, block_span)
                result.or_fallback = Val(TOrFallback.Value{value: block_expr})
                result.statements = checked_block.value
                result.complete = true
            }
        }
        .Return(value, return_span) -> {
            return_tree := TOrFallback?{None}
            statement_value := TExpr?{None}
            if value == {
                .None -> {
                    if !sema_stmt_return_allows_empty(scopes.return_type) {
                        required := sema_stmt_return_success_type(scopes.return_type)
                        diagnostics.push(sema_error("E0405", return_span, "`?? return` here needs a value", "this function returns {type_name(required)}, so its return route needs a value", "write `?? return <value>`"))
                    }
                }
                .Val(expression) -> {
                    if {
                        scopes.return_type == None -> {
                            _ := sema_check_expression(expression, None, environment, program, scopes, state, tail_store, context, diagnostics)
                            diagnostics.push(sema_error("E0405", expr_span(expression), "`?? return value` cannot return a value here", "this function returns nothing", "drop the value from the return route"))
                        }
                        else -> {
                            // copy: `fallback_return_type` restores scopes.return_type after the
                            // fallback overwrites it. Jet has no exchange on a field of the
                            // write-borrowed `scopes`.
                            fallback_return_type: scopes.return_type.copy()
                            checked: sema_stmt_check_return_value(expression, fallback_return_type, environment, program, scopes, state, tail_store, context, diagnostics)
                            if checked != None {
                                checked_value: checked
                                if sema_stmt_record_return_views(expression, checked_value.ty, scopes, state, context, diagnostics) && sema_stmt_move_direct(expression, state, scopes, "`return`", diagnostics) {
                                    return_tree = Val(TOrFallback.Return{value: Val(checked_value)})
                                    statement_value = Val(checked_value)
                                }
                            }
                        }
                    }
                }
            }
            if value == .None && sema_stmt_return_allows_empty(scopes.return_type) -> return_tree = Val(TOrFallback.Return{value: None})
            if return_tree != None {
                result.or_fallback = return_tree
                result.statements.push(TStmt.Return{value: statement_value, span: return_span})
                result.complete = true
            }
        }
        .Panic(name_span, args) -> {
            if {
                args.len() != 1 -> {
                    diagnostics.push(sema_error("E0103", name_span, "`panic` needs exactly one message", "a panic report needs something to show the user", "write `?? panic(\"message\")`"))
                }
                else -> {
                    message := sema_check_expression(args[0].expr, Val(Type.String), environment, program, scopes, state, tail_store, context, diagnostics)
                    if message != None {
                        checked: message ?? sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: ""}}}, name_span)
                        location := sema_expression_panic_location(environment, program, scopes, name_span)
                        result.or_fallback = Val(TOrFallback.Panic{message: checked, location: location})
                        panic_expr := sema_tree_node(Type.Named{name: "Never"}, TExprKind.RequireStop{kind: TRequireKind.Panic{msg: checked}, location: location, always_stops: true}, name_span)
                        result.statements.push(TStmt.ExprStmt{value: panic_expr, span: name_span})
                        result.complete = true
                    }
                }
            }
        }
        .Break(route_span) -> {
            if {
                scopes.loop_depth <= 0 -> {
                    diagnostics.push(sema_error("E0115", route_span, "`break` only works inside a loop", "`break` and `next` steer the nearest `loop` loop", "move this inside a loop, or remove it"))
                }
                else -> {
                    result.or_fallback = Val(TOrFallback.Break)
                    result.statements.push(TStmt.Break{label: None, span: route_span})
                    result.complete = true
                }
            }
        }
        .Continue(route_span) -> {
            if {
                scopes.loop_depth <= 0 -> {
                    diagnostics.push(sema_error("E0115", route_span, "`next` only works inside a loop", "`break` and `next` steer the nearest `loop` loop", "move this inside a loop, or remove it"))
                }
                else -> {
                    if sema_loop_value_resolve_frame(context, None) == .Val(frame_index) -> sema_ownership_check_loop_move_backedge(state, context.loop_value_frames[frame_index], diagnostics)
                    result.or_fallback = Val(TOrFallback.Continue)
                    result.statements.push(TStmt.Continue{label: None, span: route_span})
                    result.complete = true
                }
            }
        }
        .BreakLabel(label, route_span) -> {
            if {
                scopes.loop_depth <= 0 || !sema_scope_has_loop_label(scopes, label) -> {
                    diagnostics.push(sema_error("E0405", route_span, "the `?? break` label is not an enclosing loop", "the fallback route must name an active loop label", "use an enclosing loop label"))
                }
                else -> {
                    result.or_fallback = Val(TOrFallback.BreakLabel{label: label})
                    result.statements.push(TStmt.Break{label: Val(label), span: route_span})
                    result.complete = true
                }
            }
        }
        .ContinueLabel(label, route_span) -> {
            if {
                scopes.loop_depth <= 0 || !sema_scope_has_loop_label(scopes, label) -> {
                    diagnostics.push(sema_error("E0405", route_span, "the `?? next` label is not an enclosing loop", "the fallback route must name an active loop label", "use an enclosing loop label"))
                }
                else -> {
                    if sema_loop_value_resolve_frame(context, Val(label)) == .Val(frame_index) -> sema_ownership_check_loop_move_backedge(state, context.loop_value_frames[frame_index], diagnostics)
                    result.or_fallback = Val(TOrFallback.ContinueLabel{label: label})
                    result.statements.push(TStmt.Continue{label: Val(label), span: route_span})
                    result.complete = true
                }
            }
        }
    }
    context.fallback_err_denial = enclosing_err_denial
    sema_single_use_leave_scope(scopes, state, diagnostics)
    sema_ownership_fork_rollback(state, fork)
    sema_ownership_fork_close(state, fork)
    sema_scope_rollback(scopes, fallback_mark)
    result.complete = result.complete && diagnostics.len() == before
    result
}

sema_stmt_check_refutable_binding: fn(binding: Binding, pattern: Pattern, fallback: OrFallback, names: [BindName], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    before := diagnostics.len()
    // An `.Ok`/`.Err` pattern consumes the carrier.
    subject_value: if sema_pattern_consumes_result_carrier(pattern) -> sema_check_expression_carrier(binding.init, binding.ty, environment, program, scopes, state, tail_store, context, diagnostics) else -> sema_check_expression(binding.init, binding.ty, environment, program, scopes, state, tail_store, context, diagnostics)
    subject: subject_value ?? {
        sema_stmt_destructure_recover(BindPattern.Refutable{pattern: pattern, fallback: fallback, names: names, span: span}, binding.mutable, environment, program, scopes, state, diagnostics)
        return None
    }
    checked_pattern := sema_check_pattern(subject, sema_stmt_refutable_contextual_pattern(pattern, subject.ty, environment, program), TPatternPosition.Binding, binding.mutable, false, environment, program, scopes, state, tail_store, context, diagnostics)
    move_subject := false
    loop fact in checked_pattern.bindings {
        if !sema_ownership_type_is_copy(fact.ty) -> move_subject = true
    }
    // The fallback runs only when the pattern missed, so the subject is
    // still whole there; the success path moves it into the captures after.
    checked_fallback := sema_stmt_check_refutable_fallback(fallback, subject.ty, span, environment, program, scopes, state, tail_store, context, diagnostics)
    move_valid := true
    if move_subject && !sema_stmt_move_direct(binding.init, state, scopes, "the pattern binding", diagnostics) -> move_valid = false
    locals := [TLocal]{}
    checked_pattern_tree := checked_pattern.checked
    loop name in names {
        fact := sema_stmt_refutable_capture_fact(checked_pattern.bindings, name)
        // A refused hole has no binding fact; recovery must leave its
        // existing value visible rather than declaring it a second time.
        if fact == None && (if pattern == {.StrMatch(_, _) | .BinMatch(_, _) -> true else -> false}) && !sema_pattern_hole_name_available(name.name, scopes) -> next
        ty := if fact == {.Val(value) -> value.ty else -> Type.Int}
        local := sema_stmt_destructure_local(name, ty, binding.mutable, environment, program, scopes, state, diagnostics)
        if local == None -> next
        installed: local ?? next
        locals.push(installed.copy())
        if checked_pattern_tree != None {
            typed := checked_pattern_tree ?? next
            sema_stmt_refutable_assign_capture_identity(typed.pattern, name, installed)
            checked_pattern_tree = Val(typed)
        }
    }
    if diagnostics.len() != before || !checked_pattern.complete || !move_valid || !checked_fallback.complete || locals.len() != names.len() -> return None
    typed: checked_pattern_tree ?? return None
    fallback_tree: checked_fallback.or_fallback ?? return None
    payload := sema_stmt_refutable_capture_payload(typed.pattern, typed.subject.ty)
    if payload != None && names.len() == 1 {
        local := locals[0]
        initializer := sema_tree_node(payload ?? Type.Named{name: "Unit"}, TExprKind.OrFallback{value: typed.subject, fallback: fallback_tree, ambient_err: checked_fallback.ambient_err}, span)
        return Val(TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: initializer, gc_promotion: None, gc_transferred: false, span: Span{start: local.span.start, end: expr_span(binding.init).end}})
    }
    Val(TStmt.RefutableBind{pattern: typed.pattern, init: typed.subject, fallback: checked_fallback.statements, span: span})
}

// The stable Optional (an immutable local or parameter of type
// `T?`) that a statement guard `if x == None -> …` with one arm, no `else`,
// and a directly exiting body tests.
sema_stmt_optional_exit_guard_name: fn(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span, scopes: SemaScopeTable) -> BindName? {
    if else_body != None || arms.len() != 1 || !sema_stmt_refutable_is_subjectless_guard(subject, span) -> return None
    if !sema_stmt_refutable_block_exits(arms[0].body) -> return None
    test: sema_expression_absent_optional_test(arms[0].cond) ?? return None
    if sema_expression_flow_optional_payload(scopes, test.name.name) == None -> return None
    Val(test.name)
}

// The stable Optionals the `x == None` arms of a guard table
// test, in arm order without repeats. The table's `else` holds each payload
// (Rust `complement_condition_bindings`).
sema_stmt_else_presence_names: fn(arms: [SwitchArm], scopes: SemaScopeTable) -> [BindName] {
    names := [BindName]{}
    loop arm in arms {
        test: sema_expression_absent_optional_test(arm.cond) ?? next
        if sema_expression_flow_optional_payload(scopes, test.name.name) == None -> next
        repeated := false
        loop name in names {
            if name.name == test.name.name -> repeated = true
        }
        if !repeated -> names.push(test.name)
    }
    names
}

// Refines the stable Optional `name` to its payload for the
// rest of the current scope. Check `x ?? fallback` and bind the payload under
// the same name, the operation the Rust frontend reaches through the
// refutable binding `x == .Val(x) ?? { fallback }`.
sema_stmt_check_optional_refinement: fn(name: BindName, fallback: OrFallback, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    guarded: Expr.OrFallback{value: Expr.Ident{name: name.name, span: name.span, id: AST_NODE_GENERATED}, fallback: fallback, is_option: true, span: span, id: AST_NODE_GENERATED}
    value: sema_check_expression(guarded, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    // The refinement is a new local; its identity names the guard so it never
    // collides with the carrier binding it shadows.
    owner: "{sema_scope_local_owner_key(scopes)}/flow@{span.start}"
    id: symbol_id(SymbolKind.Local, environment.module_identity, owner, name.name)
    symbol: Symbol{id: id, kind: SymbolKind.Local, name: name.name, module_name: environment.module_identity, owner: Val(owner), span: name.span, ty: Val(value.ty), visibility: 0}
    sema_scope_refine_local(scopes, symbol)
    sema_ownership_declare_binding(state, symbol, false)
    Val(TStmt.Let{local: checked_symbol_local(name.name, name.span, id, value.ty), let_ty: TLetTy.Inferred, init: value, gc_promotion: None, gc_transferred: false, span: span})
}

// One integer local whose interval a guard table narrows for the rest of the
// block.
SemaStmtBoundsRefinement: struct {
    name: String
    name_span: Span
    bounds: TIntegerBounds
}

// After `if i >= limit -> exit` with no `else`, the rest of the block runs
// only where the test was false. A `:` or parameter integer whose
// interval is already known keeps the part the false test allows:
// `i >= n` leaves hi n-1, `i > n` leaves hi n, `i < n` leaves lo n,
// `i <= n` leaves lo n+1, and `a || b` leaves both. `limit` is an integer
// literal or `.len()` of a fixed-size list. Bounds are only tightened: a
// name with no known interval gains none, so no index check becomes stricter.
sema_stmt_exit_guard_bound_refinements: fn(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> [SemaStmtBoundsRefinement] {
    refinements := [SemaStmtBoundsRefinement]{}
    if else_body != None || arms.len() != 1 || !sema_stmt_refutable_is_subjectless_guard(subject, span) -> return refinements
    if !sema_stmt_refutable_block_exits(arms[0].body) -> return refinements
    sema_stmt_exit_guard_false_bounds(arms[0].cond, environment, scopes, refinements)
    refinements
}

sema_stmt_exit_guard_false_bounds: fn(cond: Expr, environment: SemaScopeEnvironment, scopes: SemaScopeTable, refinements: &[SemaStmtBoundsRefinement]) Never! {
    if cond == {
        .Paren(inner, _, _) -> sema_stmt_exit_guard_false_bounds(inner, environment, scopes, refinements)
        .Binary(op, left, right, _, _) -> {
            if op == BinOp.Or {
                sema_stmt_exit_guard_false_bounds(left, environment, scopes, refinements)
                sema_stmt_exit_guard_false_bounds(right, environment, scopes, refinements)
                return
            }
            if left == .Ident(name, name_span, _) {
                limit: sema_stmt_guard_limit(right, environment, scopes) ?? return
                sema_stmt_note_false_bound(name, name_span, op, limit, scopes, refinements)
                return
            }
            if right == .Ident(name, name_span, _) {
                limit: sema_stmt_guard_limit(left, environment, scopes) ?? return
                mirrored: if op == {
                    .Lt -> BinOp.Gt
                    .Gt -> BinOp.Lt
                    .Le -> BinOp.Ge
                    .Ge -> BinOp.Le
                    else -> op
                }
                sema_stmt_note_false_bound(name, name_span, mirrored, limit, scopes, refinements)
            }
        }
        else -> {}
    }
}

// The constant a guard compares against: an integer literal, or `.len()` of a
// name whose type is a fixed-size list.
sema_stmt_guard_limit: fn(expr: Expr, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> Int? {
    if expr == {
        .Paren(inner, _, _) -> return sema_stmt_guard_limit(inner, environment, scopes)
        .Int(value, _, _, _, _) -> return Val(value)
        .MethodCall(receiver, method, _, _, _, args, _) -> {
            if method != "len" || args.len() != 0 -> return None
            if receiver == .Ident(list_name, _, _) {
                index: sema_scope_resolve_index(scopes, list_name) ?? return None
                if sema_scope_binding_type(environment, scopes, index) == .Val(.FixedList(_, length)) -> return measure_literal_value(length)
            }
            return None
        }
        else -> return None
    }
}

sema_stmt_note_false_bound: fn(name: String, name_span: Span, op: BinOp, limit: Int, scopes: SemaScopeTable, refinements: &[SemaStmtBoundsRefinement]) Never! {
    index: sema_scope_resolve_index(scopes, name) ?? return
    if scopes.bindings[index].mutable -> return
    kind: scopes.bindings[index].symbol.kind
    if kind != SymbolKind.Local && kind != SymbolKind.Parameter -> return
    known: scopes.bindings[index].integer_bounds ?? return
    position := -1
    loop at in 0..<refinements.len() {
        if refinements[at].name == name -> position = at
    }
    current: if position >= 0 -> refinements[position].bounds else -> known
    lo := current.lo
    hi := current.hi
    if op == {
        .Ge -> { if limit - 1 < hi -> hi = limit - 1 }
        .Gt -> { if limit < hi -> hi = limit }
        .Lt -> { if limit > lo -> lo = limit }
        .Le -> { if limit + 1 > lo -> lo = limit + 1 }
        else -> return
    }
    // An empty interval means the rest of the block never runs; leave it alone.
    if lo > hi -> return
    narrowed: TIntegerBounds{lo: lo, hi: hi}
    if position >= 0 {
        refinements[position].bounds = narrowed
    } else {
        refinements.push(SemaStmtBoundsRefinement{name: name, name_span: name_span, bounds: narrowed})
    }
}

// Rebinds the guarded name for the rest of the block with its narrowed
// interval, the way sema_stmt_check_optional_refinement rebinds a payload.
sema_stmt_check_bounds_refinement: fn(refinement: SemaStmtBoundsRefinement, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    read: Expr.Ident{name: refinement.name, span: refinement.name_span, id: AST_NODE_GENERATED}
    value: sema_check_expression(read, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    owner: "{sema_scope_local_owner_key(scopes)}/bounds@{span.start}"
    id: symbol_id(SymbolKind.Local, environment.module_identity, owner, refinement.name)
    symbol: Symbol{id: id, kind: SymbolKind.Local, name: refinement.name, module_name: environment.module_identity, owner: Val(owner), span: refinement.name_span, ty: Val(value.ty), visibility: 0}
    sema_scope_refine_local(scopes, symbol)
    scopes.bindings[scopes.bindings.len() - 1].integer_bounds = Val(refinement.bounds)
    sema_ownership_declare_binding(state, symbol, false)
    local := checked_symbol_local(refinement.name, refinement.name_span, id, value.ty)
    local.integer_bounds = Val(refinement.bounds)
    Val(TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: value, gc_promotion: None, gc_transferred: false, span: span})
}

// The `else` of a guard table holds the payload of every
// stable `x == None` arm subject. Each refinement leads the block as
// `x: x ?? <no else arm>`, as the Rust frontend prepends the dead-end
// binding `x == .Val(x) ?? { }` (`prepend_else_presence_refinements`).
sema_stmt_check_else_complement: fn(names: [BindName], body: [Stmt], span: Span, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> SemaStatementResult {
    sema_scope_enter(scopes, state, "if.else@{span.start}")
    statements := [TStmt]{}
    complete := true
    loop name in names {
        refined: sema_stmt_check_optional_refinement(name, OrFallback.Value{value: Expr.NoElse{span: name.span, id: AST_NODE_GENERATED}}, name.span, environment, program, scopes, state, tail_store, context, diagnostics)
        if refined == {
            .Val(statement) -> statements.push(statement)
            .None -> complete = false
        }
    }
    checked: sema_check_statements(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
    sema_single_use_leave_scope(scopes, state, diagnostics)
    loop statement in checked.value -> statements.push(statement)
    SemaStatementResult{value: statements, complete: complete && checked.complete}
}

sema_stmt_check_destructure: fn(binding: Binding, pattern: BindPattern, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    if pattern == {
        .Refutable(inner, fallback, names, span) -> return sema_stmt_check_refutable_binding(binding, inner, fallback, names, span, environment, program, scopes, state, tail_store, context, diagnostics)
        else -> {}
    }
    before := diagnostics.len()
    init: sema_check_expression(binding.init, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
        sema_stmt_destructure_recover(pattern, binding.mutable, environment, program, scopes, state, diagnostics)
        return None
    }
    ty := sema_expr_expected_type(init.ty, environment, program)
    names := sema_stmt_destructure_names(pattern)
    fields := [TypeTupleField]{}
    span := binding.name_span
    plain_fields := true
    if pattern == {
        .Struct(written_type, type_span, selected, rest, pattern_span) -> {
            span = pattern_span
            if program.registration_graph == .Val(graph) {
                actual: sema_pattern_nominal_row(graph, environment.module_identity, ty)
                actual_is_struct: if actual == {
                    .Val(row) -> graph.modules[row.module_index].nominals[row.row].kind == SemaRegistrationNominalKind.Struct
                    .None -> false
                }
                if !actual_is_struct {
                    diagnostics.push(sema_error("E0313", type_span, "`{written_type} {{ … }}` can only destructure a `{written_type}` value, but this is {sema_type_show(ty)}", "destructuring with `{{ }}` pulls fields out of a struct value", "destructure a `{written_type}`, or bind the whole value with a name"))
                    sema_stmt_destructure_recover(pattern, binding.mutable, environment, program, scopes, state, diagnostics)
                    return None
                }
                nominal_row: actual ?? return None
                nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
                plain_fields = !(sema_type_bound_satisfied_at(graph, ty, "Close", sema_scope_caller_row(environment, graph), context.generic_params) ?? true)
                named: sema_pattern_nominal_row(graph, environment.module_identity, Type.Named{name: written_type})
                named_matches: if named == {
                    .Val(row) -> graph.modules[row.module_index].nominals[row.row].symbol.id.key == nominal.symbol.id.key
                    .None -> false
                }
                if !named_matches {
                    diagnostics.push(sema_error("E0313", type_span, "this value is a `{nominal.symbol.name}`, not a `{written_type}`", "the type named before `{{ }}` must match the value you destructure", "write `{nominal.symbol.name} {{ … }}` to match the value"))
                    sema_stmt_destructure_recover(pattern, binding.mutable, environment, program, scopes, state, diagnostics)
                    return None
                }
                generic_names := (loop parameter in nominal.generic_params -> parameter.name)
                arguments := sema_pattern_subject_args(ty)
                // A struct hoisted from an inline module keeps its `priv`
                // fields to that module (sema_expression_field_visible).
                inline_module := Span?{None}
                if nominal.source == .SourceAST(item) {
                    if item == .Struct(declared) -> inline_module = declared.inline_module
                }
                loop selected_field in selected {
                    field_type := Type?{None}
                    loop field in nominal.fields {
                        if field.symbol.name == selected_field.name {
                            if field.computed -> plain_fields = false
                            if {
                                sema_expression_field_visible(field.symbol.visibility == 2, field.symbol.visibility == 1, nominal.symbol.module_name, inline_module, selected_field.span, context.compiler_generated, environment, program) -> {
                                    field_type = Val(sema_inference_substitute_type(field.ty, generic_names, arguments))
                                    context.name_references.push(SemaNameReferenceFact{span: selected_field.span, symbol: field.symbol, kind: "field"})
                                }
                                else -> {
                                    diagnostics.push(sema_expression_private_field_error(selected_field.name, selected_field.span))
                                    field_type = Val(Type.Int)
                                }
                            }
                        }
                    }
                    if field_type == None {
                        // Rust `check_destructure`: the field-access E0302, nearest field suggested.
                        suggestion: sema_suggest_field(selected_field.name, loop field in nominal.fields -> field.symbol.name)
                        fix: if suggestion == .Val(candidate) -> "did you mean `{candidate}`?" else -> "check the field names on `{type_name(ty)}`"
                        diagnostics.push(sema_error("E0302", selected_field.span, "`{type_name(ty)}` has no field `{selected_field.name}`", "field access only works on names declared in the struct", fix))
                    }
                    fields.push(TypeTupleField{name: selected_field.name, ty: field_type ?? Type.Int})
                }
                partial := selected.len() < nominal.fields.len()
                if {
                    partial && rest == None -> {
                        diagnostics.push(sema_error("E0326", pattern_span, "this pattern leaves out fields of `{written_type}`", "a destructure that doesn't name every field must end with `..` so the skipped fields are visible at a glance", "add `, ..` before the closing `}}`, or name the remaining fields"))
                    }
                    !partial && rest != None -> {
                        diagnostics.push(sema_error("E0327", rest, "`..` is redundant — this pattern already names every field of `{written_type}`", "a trailing `..` only makes sense when some fields are left unnamed", "remove the `..`"))
                    }
                }
            } else {
                return None
            }
        }
        .List(elements, pattern_span) -> {
            span = pattern_span
            element_type := if ty == {
                .List(element) -> element
                .FixedList(element, length) -> {
                    fixed: measure_literal_value(length) ?? return None
                    if elements.len() != fixed {
                        names_suffix := if elements.len() == 1 -> "" else -> "s"
                        fixed_suffix := if fixed == 1 -> "" else -> "s"
                        diagnostics.push(sema_error("E0963", pattern_span, "destructuring with {elements.len()} name{names_suffix}, but this fixed-size list has {fixed} element{fixed_suffix}", "a fixed-size list `[T#N]` has a known length — the pattern must match exactly", "use {fixed} name{fixed_suffix} in the pattern"))
                    }
                    element
                }
                else -> {
                    diagnostics.push(sema_error("E0313", pattern_span, "`[ … ]` can only destructure a list, but this is {sema_type_show(ty)}", "destructuring with `[ ]` pulls elements out of a list value", "destructure a list, or bind the whole value with a name"))
                    sema_stmt_destructure_recover(pattern, binding.mutable, environment, program, scopes, state, diagnostics)
                    return None
                }
            }
            if binding.init == .ListLit(items, _, _) && items.len() != elements.len() {
                sema_stmt_destructure_count(elements.len(), items.len(), false, true, pattern_span, diagnostics)
            }
            loop (index, _) in elements -> fields.push(TypeTupleField{name: "{index}", ty: element_type})
        }
        .Tuple(elements, pattern_span) -> {
            span = pattern_span
            // A `VJPRun`
            // destructures positionally as `(value, pull)`; it is the one
            // carrier the S74 member-name law (syntax-decisions.md:982) exempts.
            positional := false
            if ty == {
                .Tuple(canonical) -> fields = canonical
                .Apply(name, args) -> {
                    if name == "VJPRun" && args.len() == 1 && elements.len() == 2 {
                        fields = sema_stmt_vjp_run_positional_fields(args[0])
                        positional = true
                    }
                }
                else -> {}
            }
            if fields.len() == 0 && ty != (Type.Tuple{fields: [TypeTupleField]{}}) {
                diagnostics.push(sema_error("E0313", pattern_span, "`( … )` can only destructure a tuple, but this is {sema_type_show(ty)}", "destructuring with `( )` pulls named members out of a tuple value", "destructure a tuple, or bind the whole value with a name"))
                sema_stmt_destructure_recover(pattern, binding.mutable, environment, program, scopes, state, diagnostics)
                return None
            }
            if {
                elements.len() != fields.len() -> {
                    sema_stmt_destructure_count(elements.len(), fields.len(), true, false, pattern_span, diagnostics)
                }
                binding.init == .TupleLit(items, _, _, _) && items.len() != elements.len() -> {
                    sema_stmt_destructure_count(elements.len(), items.len(), true, true, pattern_span, diagnostics)
                }
            }
            // Tuples destructure by member name: each written name selects the
            // member it names, never a position.
            if elements.len() == fields.len() && !positional {
                by_name := [TypeTupleField]{}
                loop element in elements {
                    found := TypeTupleField?{None}
                    loop field in fields {
                        if field.name == element.name -> found = Val(field.copy())
                    }
                    if found == .Val(field) -> by_name.push(field)
                }
                if by_name.len() == fields.len() {
                    fields = by_name
                } else {
                    diagnostics.push(sema_stmt_tuple_destructure_by_name(elements, fields, ty, pattern_span))
                }
            }
        }
        .Refutable(_, _, _, _) -> return None
    }
    locals := [TLocal]{}
    binds := [TDestructureBinding]{}
    move_fields := plain_fields && sema_stmt_destructure_init_is_temporary(binding.init)
    loop (index, name) in names {
        if index >= fields.len() -> break
        field := fields[index]
        local: sema_stmt_destructure_local(name, field.ty, binding.mutable, environment, program, scopes, state, diagnostics) ?? next
        locals.push(local.copy())
        binds.push(TDestructureBinding{local: local, field: field.name})
        projected_binding := binding
        projected_binding.name = local.name
        projected_binding.name_span = local.span
        projected_binding.pattern = None
        projected_binding.ty = Val(field.ty)
        projected_binding.init = if pattern == {
            .List(_, _) -> Expr.Index{base: binding.init, index: Expr.Int{value: index, span: span, width: None, raw: None, id: AST_NODE_GENERATED}, span: span, kind: IndexKind.List, id: AST_NODE_GENERATED}
            else -> Expr.Field{base: binding.init, member: field.name, span: span, id: AST_NODE_GENERATED}
        }
        if !sema_stmt_record_binding_views(projected_binding, field.ty, scopes, state, context, diagnostics) -> return None
        if sema_stmt_destructure_moves_field(field.ty, pattern, environment, program) -> move_fields = true
    }
    if binding.init == .Ident(name, _, _) {
        source: sema_scope_resolve(scopes, name) ?? return None
        if source.kind != SymbolKind.Parameter && !sema_stmt_move_direct(binding.init, state, scopes, "the destructuring binding", diagnostics) -> return None
    }
    // A warning from the value (a lint) leaves the binding complete.
    if sema_has_error_since(diagnostics, before) || locals.len() != names.len() -> return None
    temp := checked_generated_local("__jet_destructure_{span.start}", span, init.ty)
    temp.mutable = true
    if pattern == {
        .Struct(_, _, _, _, _) -> Val(TStmt.StructDestructure{temp: temp, init: init, move_fields: move_fields, binds: binds, span: span})
        .Tuple(_, _) -> Val(TStmt.TupleDestructure{temp: temp, init: init, move_fields: move_fields, binds: binds, span: span})
        .List(_, _) -> Val(TStmt.ListDestructure{temp: temp, init: init, count: names.len(), line: sema_source_line_at(environment.source_segments, span) ?? 0, elements: locals, span: span})
        .Refutable(_, _, _, _) -> None
    }
}

// The ordered `(value, pull)` members a `VJPRun<G>` destructures into,
// typed by the run's field rows.
sema_stmt_vjp_run_positional_fields: fn(gradient: Type) -> [TypeTupleField] {
    members: [String]{"value", "pull"}
    fields := [TypeTupleField]{}
    loop member in members {
        if sema_expression_vjp_run_field(gradient, member) == .Val(field_ty) {
            fields.push(TypeTupleField{name: member, ty: field_ty})
        }
    }
    fields
}

// A tuple destructure names its members; the first written name that is not a
// member is reported with the member-name and rename forms.
sema_stmt_tuple_destructure_by_name: fn(elements: [BindName], fields: [TypeTupleField], ty: Type, pattern_span: Span) -> Diagnostic {
    members := [String]{}
    renames := [String]{}
    loop field in fields {
        members.push(field.name)
        renames.push("{field.name}: name")
    }
    span := pattern_span
    written := ""
    loop element in elements {
        if !members.contains(element.name) {
            span = element.span
            written = element.name
            break
        }
    }
    sema_error("E0313", span, "`{written}` isn't a member of {type_name(ty)}", "a tuple destructure binds each member by its name, never by position", "name the members, `({members.join(", ")}): …`, or rename them: `{{ {renames.join(", ")} }}: …`")
}

// True when the initializer is itself a `<alias>.Fixed.<method>(…)` call;
// the memory check confirms the alias names `core.mem`.
sema_stmt_init_is_fixed_constructor: fn(init: Expr) -> Bool Never! {
    if init == .MethodCall(receiver, _, _, _, _, _, _) && receiver == .Field(base, name, _, _) {
        return name == "Fixed" && base == .Ident(_, _, _)
    }
    return false
}

sema_stmt_install_binding_loop_label: fn(expr: Expr, name: String, name_span: Span) -> Expr Never! {
    if expr == {
        .CallValue(callee, args, span, _) -> {
            if args.len() == 0 {
                if callee == {
                    .Lambda(lambda, _) -> {
                        updated_lambda := lambda
                        if updated_lambda.meta.result_loop || updated_lambda.meta.collecting_loop {
                            updated_lambda.meta.loop_label = Val(NamedSpan{name: name, span: name_span})
                            return Expr.CallValue{callee: Expr.Lambda{lambda: updated_lambda, id: AST_NODE_GENERATED}, args: args, span: span, id: AST_NODE_GENERATED}
                        }
                    }
                    else -> {}
                }
            }
        }
        else -> {}
    }
    // copy: the labeled expression is a new owned Expr. For other kinds it equals `expr`, the
    // caller's AST node (a read parameter), which the caller keeps.
    expr.copy()
}

// A binding whose initializer produced no checked value stays in scope with
// only its written type. Without one, reads of the name check to nothing and
// add no report, so the initializer's own error is the only one: bindings
// derived from it inherit the poison instead of cascading into unknown-name
// or type-mismatch reports.
sema_stmt_declare_unchecked_binding: fn(binding: Binding, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) Never! {
    owner := sema_scope_local_owner_key(scopes)
    id: symbol_id(SymbolKind.Local, environment.module_identity, owner, binding.name)
    symbol := Symbol{id: id, kind: SymbolKind.Local, name: binding.name, module_name: environment.module_identity, owner: Val(owner), span: binding.name_span, ty: binding.ty, visibility: 0}
    _ := sema_scope_declare_local(scopes, symbol, binding.mutable, AccessConvention.Read, None, binding.string_view)
}

sema_stmt_check_binding: fn(binding: Binding, lambda_escapes: Bool?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    loop marker in binding.markers {
        if marker.name == MARKER_META && !marker.negated && sema_marker_rules_check_rule_signature(marker, environment, program, scopes, state, tail_store, context, diagnostics) -> sema_marker_rules_check_local_meta(marker, diagnostics)
    }
    if binding.name == "err" -> diagnostics.push(sema_err_shadow_lint(binding.name_span))
    if sema_ownership_report_lending_view_escape(binding.init, "be stored in a binding", scopes, context, diagnostics) -> return None
    // `y: x` would move an arena view to a new, possibly longer-lived
    // binding. The escape is the binding's one fault: the name is declared
    // unchecked, so the move out of the arena slot reports no second E0201.
    if sema_ownership_report_arena_view_escape(state, binding.init, "be stored in another binding", scopes, diagnostics) {
        sema_stmt_declare_unchecked_binding(binding, environment, program, scopes)
        return None
    }
    if binding.uninit -> return sema_stmt_check_uninit_binding(binding, environment, program, scopes, state, context, diagnostics)
    if binding.arena_view -> return None
    // A lambda is already its value, and a function is no compile-time data:
    // `name :: comptime { () -> … }` binds the lambda as a runtime binding does.
    if binding.is_comptime && !(binding.init == .Lambda(_, _)) -> return sema_stmt_check_prepared_binding(binding, environment, program, scopes, state, tail_store, context, diagnostics)
    if binding.pattern == .Val(pattern) {
        statement := sema_stmt_check_destructure(binding, pattern, environment, program, scopes, state, tail_store, context, diagnostics)
        if statement != None {
            loop name in sema_stmt_destructure_names(pattern) {
                local_name := if name.rename == .Val(rename) -> rename.name else -> name.name
                index: sema_scope_resolve_index(scopes, local_name) ?? next
                sema_ownership_note_frozen_binding(state, scopes.bindings[index].symbol.id.key, binding.init, scopes)
            }
        }
        return statement
    }
    // E0804: a lambda stored in a binding can't call itself through that name.
    if binding.init == .Lambda(lambda, _) && sema_ownership_last_use_expr(binding.init, binding.name) {
        diagnostics.push(sema_error("E0804", lambda.span, "a lambda can't call itself as `{binding.name}`", "short functions stored in a binding can't recurse in v1", "write a named `fn` instead of assigning the lambda to `{binding.name}`"))
    }
    sema_copy_site_check_borrowed_binding(binding, environment, program, scopes, context, diagnostics)
    binding_expr := sema_stmt_install_binding_loop_label(binding.init, binding.name, binding.name_span)
    // (Rust `check_binding`): an immutable binding of a
    // bare range place is a read window into its source, typed `View<T>`.
    if !binding.mutable && sema_stmt_is_bare_range_place(binding.init, scopes, state) -> binding_expr = Expr.Place{value: binding_expr, access: PlaceAccess.Read, span: expr_span(binding.init), id: AST_NODE_GENERATED}
    range_head: sema_stmt_range_conversion_head(binding.init, environment, program, scopes)
    previous_binding_initializer: context.binding_initializer
    context.binding_initializer = true
    // `mem.Fixed.new`/`.over` is allowed only as the whole initializer.
    previous_fixed_constructor: context.allow_fixed_constructor
    context.allow_fixed_constructor = sema_stmt_init_is_fixed_constructor(binding.init)
    // (Rust `current_binding_name`): a task spawned by this
    // initializer records its binding for the `.detach()` refusals.
    previous_binding_name: context.taskgroups.binding_name
    context.taskgroups.binding_name = Val(binding.name)
    // A place-view initializer's overlap with the live views is checked when
    // the binding records its view, naming the binding (Rust `record_view`).
    deferred_before: state.deferred_view_opens.len()
    if sema_stmt_binding_is_place_view(binding_expr) -> state.deferred_view_opens.push(expr_span(binding_expr))
    // A declared type (a generated binding's) resolves in this module's scope,
    // so an alias-qualified name such as `crypto.Secret` names its nominal.
    declared: if binding.ty == .Val(written) -> Val(sema_expr_expected_type(written, environment, program)) else -> None
    checked_init := if range_head == .Val(head) -> sema_stmt_check_range_conversion(binding.init, head, declared, environment, program, scopes, state, tail_store, context, diagnostics) else -> sema_check_expression_with_lambda_escapes(binding_expr, declared, environment, program, scopes, state, tail_store, context, lambda_escapes, diagnostics)
    loop state.deferred_view_opens.len() > deferred_before -> _ := state.deferred_view_opens.pop()
    context.binding_initializer = previous_binding_initializer
    context.allow_fixed_constructor = previous_fixed_constructor
    context.taskgroups.binding_name = previous_binding_name
    checked_value: checked_init ?? {
        sema_stmt_declare_unchecked_binding(binding, environment, program, scopes)
        return None
    }
    init: sema_stmt_owning_view_init(checked_value, binding, environment, program, scopes, context)
    owned: if !binding.mutable && sema_stmt_binding_reads_projection(binding.init, scopes) -> sema_copy_site_check_view_binding(init, environment, program, scopes, state, context, diagnostics) else -> sema_copy_site_check_guard_owned(init, environment, program, scopes, state, context, diagnostics, false)
    if !owned || (binding.mutable && !sema_copy_site_refuse_borrowed_copy(binding.init, "the binding `{binding.name}`", environment, program, scopes, context, diagnostics)) {
        sema_stmt_declare_unchecked_binding(binding, environment, program, scopes)
        return None
    }
    sema_copy_site_check_conditional(binding.init, declared, environment, program, scopes, context, diagnostics)
    // An ExpiringSecret loan lives only while its `.with` callback runs.
    if sema_contains_expiring_secret_loan(init.ty) {
        diagnostics.push(sema_error("E0201", expr_span(binding.init), "an ExpiringSecret loan cannot be stored", "the callback parameter is a temporary read-only loan that ends when `.with` returns", "use the loan inside the callback and store only a non-secret result"))
    }
    // E2502 (Rust `check_binding`): a line stream (`.lines()` on a file,
    // stdin, or process reader) is consumed only directly by a loop; binding
    // it lets it escape loop position.
    if init.ty == .Named(stream) && (stream == "FileLines" || stream == "StdinLines" || stream == "ProcessLines") {
        loop_name: if binding.name == "" -> "line" else -> binding.name
        diagnostics.push(sema_error("E2502", expr_span(binding.init), "a line stream can only be used directly in a loop", "`.lines()` hands back a lazy line reader meant to be iterated in place; storing it in a name would let it leave the loop, where it has no use", "iterate it directly: `loop {loop_name} in handle.lines() {{ … }}`"))
    }
    // E1110 (Rust `check_binding`, contains_taskgroup): a value that holds a
    // `Group` inside it could outlive the group's owner.
    if init.ty != (Type.Named{name: "Group"}) && sema_stmt_contains_taskgroup(init.ty) {
        diagnostics.push(sema_error("E1110", binding.name_span, "`Group` cannot be stored inside another value", "a task group is call-stack-only spawn authority; aliases and aggregates could outlive its owner", "pass `group: Group` directly to a helper function or method and use it there"))
    }
    // This rule stage S5 (Rust `string_view_call_source`): `x: s.trim()`,
    // `s.after(sep)` or `s.before(sep)` on a local or parameter `String`
    // binds a scope-bound zero-copy view into `s`; a `:=` binding keeps the
    // owned result, since it may later be reassigned an owned `String`. A
    // `s.slice(..)` binding stays owned too: a slice is a view only where a
    // `View<str>` slot (a return or a field) asks for one.
    view_sources := if binding.mutable || sema_string_view_is_slice_call(binding.init) -> [SemaOwnershipPlace]{} else -> sema_string_view_call_sources(binding.init, scopes, state)
    view_init := if view_sources.len() > 0 -> sema_string_view_lower_init(init) else -> None
    string_view := view_init != None
    if !string_view && !sema_stmt_move_direct(binding_expr, state, scopes, "the binding `{binding.name}`", diagnostics) {
        sema_stmt_declare_unchecked_binding(binding, environment, program, scopes)
        return None
    }
    kind: SymbolKind.Local
    owner := sema_scope_local_owner_key(scopes)
    id: symbol_id(kind, environment.module_identity, owner, binding.name)
    symbol := Symbol{id: id, kind: kind, name: binding.name, module_name: environment.module_identity, owner: Val(owner), span: binding.name_span, ty: Val(init.ty), visibility: 0}
    // An immutable binding of foldable Int arithmetic holds its value from
    // the build on, at every tier (tree_expr_fold_int).
    folded: if binding.mutable -> None else -> tree_expr_fold_int(init)
    bounds: if folded == .Val(number) -> Val(integer_bounds_exact(number)) else if binding.mutable -> None else -> checked_cost_integer_bounds(init)
    if !sema_scope_declare_local(scopes, symbol, binding.mutable, AccessConvention.Read, bounds, string_view) {
        diagnostics.push(sema_already_defined(binding.name, binding.name_span))
        sema_stmt_shadow_refused_binding(symbol, binding.mutable, scopes, state)
        return None
    }
    sema_ownership_declare_binding(state, symbol, false)
    // `name: root.field` / `name: root[i]` reads the
    // place through a view; an exact `name.move()` later would copy it (E0201).
    if !binding.mutable && !string_view && sema_stmt_binding_reads_projection(binding.init, scopes) -> sema_scope_mark_place_alias(scopes, binding.name)
    if !binding.mutable && binding.sigil_span == .Val(sigil) -> sema_scope_mark_binding_sigil(scopes, binding.name, Span{start: binding.name_span.end, end: sigil.end})
    sema_ownership_note_frozen_binding(state, symbol.id.key, binding.init, scopes)
    // A bound lambda that takes a capture runs once; one that writes a
    // capture changes it at each call.
    if binding.init == .Lambda(bound_lambda, _) -> sema_ownership_bind_once_lambda(state, bound_lambda.span, symbol.id.key)
    if init.kind == .Lambda(checked_lambda) && checked_lambda.capture_facts.mutable.len() > 0 {
        sema_ownership_bind_closure_writes(state, symbol.id.key, checked_lambda.capture_facts.mutable)
        if checked_lambda.capture_facts.escapes -> sema_ownership_bind_lambda_write_borrows(state, checked_lambda.capture_facts.mutable)
    }
    if binding.init == .Lambda(captured_lambda, _) {
        if init.kind == .Lambda(viewing_lambda) -> sema_ownership_bind_closure_captures(state, symbol.id.key, captured_lambda.span, viewing_lambda.captures, viewing_lambda.capture_facts, scopes)
        // Rust `check_binding`: an escaping lambda moves the owned
        // non-cloneable captures it did not take with `.move()` when it is built,
        // so a later use of one here is E0121.
        if init.kind == .Lambda(moving_lambda) && moving_lambda.capture_facts.escapes {
            taken_names: loop capture in captured_lambda.take_names -> capture.name
            loop name in moving_lambda.capture_facts.moved {
                if taken_names.contains(name) -> next
                _ := sema_ownership_mark_move(state, Expr.Ident{name: name, span: captured_lambda.span, id: AST_NODE_GENERATED}, scopes, "an escaping lambda", diagnostics)
            }
        }
    }
    sema_single_use_note_binding(state, symbol, environment, program)
    if binding.name == "_" {
        sema_single_use_check_discard(init.ty, binding.name_span, context.taskgroups.in_spawn, environment, program, diagnostics)
        // Rust `check_binding`: an ordinary fallible call already propagates
        // its failure in statement position, so its Unit success has nothing to
        // bind.
        if !binding.is_comptime && sema_expr_unwrap_tag(init.ty) == (Type.Named{name: "Unit"}) && sema_stmt_is_propagated_call(init) {
            row: diagnostic_registry_row("L0531") ?? panic("L0531 has no registry row")
            diagnostics.push(sema_lint("L0531", binding.name_span, row.what, row.why, row.fix))
        }
    }
    // A money-like binding whose
    // final type is `Float`.
    if sema_checked_type_is_float(init.ty) && sema_checked_money_like_name(binding.name) {
        diagnostics.push(sema_lint("L0504", binding.name_span, "binding `{binding.name}` looks like money but has type `Float`", "floating-point money loses cents on common values like `0.1 + 0.2`", "use `Decimal` for exact money: `price: Decimal := Decimal(\"9.99\")`"))
    }
    sema_stmt_track_origin(binding, environment, program, scopes)
    sema_stmt_note_normalized_path_text(binding, init, scopes)
    _ := sema_hardware_bind_pending_dma_transfer(binding_expr, symbol, scopes)
    view_diagnostics_before: diagnostics.len()
    // An owning copy of a read view (`entries := stream.object_entries(tree)`)
    // is new storage: the binding holds no window into the view's source.
    owned_copy: init.kind == .MaterializeView(_)
    if !owned_copy && !sema_stmt_record_binding_views(binding, init.ty, scopes, state, context, diagnostics) {
        if !sema_has_error_since(diagnostics, view_diagnostics_before) -> sema_check_unsupported(context, "the view held by `{binding.name}` (offset {binding.name_span.start}) could not be recorded")
        return None
    }
    if string_view && !sema_string_view_record_binding(state, binding.name, binding.name_span, view_sources, scopes) {
        if !sema_has_error_since(diagnostics, view_diagnostics_before) -> sema_check_unsupported(context, "the string view held by `{binding.name}` (offset {binding.name_span.start}) could not be recorded")
        return None
    }
    sema_function_reactive_record_binding(context, binding, symbol, init.ty)
    local := checked_symbol_local(binding.name, binding.name_span, symbol.id, init.ty)
    local.mutable = binding.mutable
    local.integer_bounds = bounds
    let_ty := TLetTy.Inferred
    if binding.ty != None -> let_ty = TLetTy.Annotated{ty: init.ty, wrapper: TLetWrapper.Plain}
    if binding.gc_promotion != None || binding.gc_transferred -> let_ty = TLetTy.Annotated{ty: init.ty, wrapper: TLetWrapper.AutomaticRoot}
    // The view is a borrowed `&str` place; its source type stays `String`.
    if string_view -> let_ty = TLetTy.StrView
    gc_promotion := if binding.gc_promotion == .Val(promotion) -> Val(sema_function_memory_tree_promotion(promotion)) else -> None
    stored := view_init ?? init
    if folded == .Val(number) -> stored = sema_tree_node(init.ty, TExprKind.IntLit{value: number, width: None}, init.span)
    Val(TStmt.Let{local: local, let_ty: let_ty, init: stored, gc_promotion: gc_promotion, gc_transferred: binding.gc_transferred, span: Span{start: binding.name_span.start, end: expr_span(binding.init).end}})
}

// Rust `infer_owning_value` (`implicit_copy_target` over
// `owned_type_for_read_view`): a `:=` binding, or a value `if` bound as a
// non-view, owns its value, so a read-view initializer (`View<T>`,
// `View<str>`) materializes one owned copy (`[T]`, `String`) under the
// default copy policy. A binding declared `View`/`ViewMut` keeps the view.
sema_stmt_owning_view_init: fn(init: &&TExpr, binding: Binding, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, context: &SemaCheckContext) -> TExpr {
    declared_view: if binding.ty == .Val(.Apply(name, _)) -> name == "View" || name == "ViewMut" else -> false
    value_if: if binding.init == {
        .If(_, _, _, _, _, _, _) -> true
        .Paren(inner, _, _) -> inner == .If(_, _, _, _, _, _, _)
        else -> false
    }
    if scopes.copies_explicit || declared_view || !(binding.mutable || value_if) -> return init
    owned: sema_copy_owned_view_type(init.ty, false)
    if !owned.materialized -> return init
    if binding.ty == .Val(declared) && !type_identity_equal(declared, owned.ty) -> return init
    facts: sema_copy_classify(init.ty, SemaCopyIntent.Materialize, environment, program, context.generic_params, true)
    if !facts.accepted -> return init
    if sema_copy_effect_name(facts) != None || sema_copy_memory_operation(facts) != None -> context.copy_events.push(SemaCopyEvent{span: init.span, facts: facts})
    span: init.span
    sema_tree_node(facts.target, TExprKind.MaterializeView{value: init}, span)
}

// A `:` initializer that is a field or element projection of a value name
// this scope knows (`root.field`, `root[i].field`, parenthesized): the binding
// reads it through a view. A whole name (`x: y`) is the share-or-move rule
// instead, and a range (`xs[a..b]`) is already a typed View. A type, module
// or import path (`Mode.Off`, `encoding.DataEvent.Null`) builds a new value.
sema_stmt_binding_reads_projection: fn(init: Expr, scopes: SemaScopeTable) -> Bool Never! {
    if init == {
        .Paren(inner, _, _) -> sema_stmt_binding_reads_projection(inner, scopes)
        // `name: root.field ?? return …`: a diverging fallback leaves the
        // payload read through the same view (probe: `name.move()` copies it).
        .OrFallback(value, fallback, _, _, _) -> if fallback == {
            .Value(_) | .Block(_, _, _) -> false
            else -> sema_stmt_binding_reads_projection(value, scopes)
        }
        .Field(base, _, _, _) | .Index(base, _, _, _, _) -> {
            root: sema_stmt_for_in_expr_root_ident(base) ?? return false
            index: sema_scope_resolve_index(scopes, root) ?? return false
            if scopes.bindings[index].symbol.kind == {
                .Local | .Parameter | .Constant -> true
                else -> false
            }
        }
        else -> false
    }
}

// E0136: the type head of a binding whose value is a range
// type's numeric conversion (`Severity.from_int(raw)`). Its Result stays
// visible to the binding, which reports a runtime value; an inline range
// conversion reports in its own call check.
sema_stmt_range_conversion_head: fn(init: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> String? {
    if init == .MethodCall(receiver, method, _, _, _, args, _) {
        if args.len() != 1 -> return None
        if receiver == .Ident(name, _, _) {
            facts: sema_expr_distinct_facts(Type.Named{name: name}, environment, program, scopes) ?? return None
            if facts.range != None && sema_call_distinct_numeric_row(facts.base, method) != None -> return Val(name)
        }
    }
    None
}

sema_stmt_check_range_conversion: fn(init: Expr, head: String, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    value: sema_check_expression_carrier(init, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    if sema_expr_unwrap_tag(value.ty) == .Result(success, _) {
        if init == .MethodCall(_, method, _, _, _, args, _) -> diagnostics.push(sema_range_runtime_conversion(head, method, expr_span(args[0].expr)))
        return Val(TExpr{ty: success, kind: value.kind, span: value.span})
    }
    sema_expr_expected(value, expected, environment, program, diagnostics)
}

// (Rust `check_uninit_binding`): `name := Type{ uninit }`
// needs `use core.mem` (E0424) and a plain-data type (E0423). The binding is
// declared without a value and recorded as not yet written, so a read before
// every path writes it is E0420; it lowers to the uninitialized-local let.
sema_stmt_check_uninit_binding: fn(binding: Binding, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    valid := true
    if !sema_stmt_module_uses_core_mem(environment, program) {
        diagnostics.push(sema_error("E0424", binding.name_span, "`uninit` needs the low-level memory tier", "`uninit` skips the automatic zero-fill — an expert-tier operation", "add `use core.mem` at the top of this file to opt in"))
        valid = false
    }
    written: binding.ty ?? return None
    ty_span: binding.ty_span ?? return None
    ty: sema_expr_expected_type(written, environment, program)
    if !sema_stmt_uninit_plain_data(ty) {
        diagnostics.push(sema_error("E0423", ty_span, "`uninit` needs a plain-data type", "`{sema_type_show(ty)}` may own heap memory or need cleanup, so leaving it uninitialized is unsafe", "use plain data — a number, `Bool`, `Char`, `U8`, or a fixed array of those (e.g. `[4096]U8`)"))
        valid = false
    }
    owner := sema_scope_local_owner_key(scopes)
    id: symbol_id(SymbolKind.Local, environment.module_identity, owner, binding.name)
    symbol := Symbol{id: id, kind: SymbolKind.Local, name: binding.name, module_name: environment.module_identity, owner: Val(owner), span: binding.name_span, ty: Val(ty), visibility: 0}
    if !sema_scope_declare_local(scopes, symbol, true, AccessConvention.Read, None, false) {
        diagnostics.push(sema_already_defined(binding.name, binding.name_span))
        return None
    }
    sema_ownership_declare_binding(state, symbol, false)
    fixed_len := Int?{None}
    fixed := false
    if ty == .FixedList(_, length) {
        fixed = true
        fixed_len = measure_literal_value(length)
    }
    sema_ownership_uninit_set(state, SemaOwnershipUninitFact{key: id.key, name: binding.name, fixed_len: fixed_len, initialized: [Int]{}})
    if !valid -> return None
    local := checked_symbol_local(binding.name, binding.name_span, id, ty)
    local.mutable = true
    local.uninit_scalar = !fixed
    local.uninit_fixed = fixed
    init: sema_node(context, ty, NodeKind.Uninit, ty_span)
    Val(TStmt.Let{local: local, let_ty: TLetTy.Annotated{ty: ty, wrapper: TLetWrapper.Plain}, init: init, gc_promotion: None, gc_transferred: false, span: Span{start: binding.name_span.start, end: ty_span.end}})
}

// Rust `is_pod_uninit_type`: scalars, `Char`, `U8`, and fixed arrays of those.
sema_stmt_uninit_plain_data: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Float32 | .Bool | .Char -> true
        .IntN(_, _) | .InlineRange(_, _, _) -> true
        .FixedList(element, _) -> sema_stmt_uninit_plain_data(element)
        else -> false
    }
}

sema_stmt_module_uses_core_mem: fn(environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    if program.registration_graph == .Val(graph) {
        module_index: sema_scope_caller_index(environment, graph) ?? return false
        return sema_function_header_inline_has_core_mem(graph.modules[module_index])
    }
    false
}

// Record one written slot of a fixed `Type{ uninit }` list. Only a
// literal in-range index proves a slot; the fact ends once every slot is
// written.
sema_stmt_uninit_note_slot_write: fn(state: &SemaOwnershipState, fact: SemaOwnershipUninitFact, index: Expr) Never! {
    initialized := [Int]{}
    loop written in fact.initialized -> initialized.push(written)
    if fact.fixed_len == .Val(length) && index == .Int(slot, _, _, _, _) {
        if slot >= 0 && slot < length && !initialized.contains(slot) -> initialized.push(slot)
        if initialized.len() == length -> return
    }
    sema_ownership_uninit_set(state, SemaOwnershipUninitFact{key: fact.key, name: fact.name, fixed_len: fact.fixed_len, initialized: initialized})
}

// (Rust `clear_uninit_mut_args`): a name a write parameter receives does not
// prove the callee writes every value, so the binding stays unwritten (E0420).
sema_stmt_uninit_write_arg: fn(arg: CallArg, state: SemaOwnershipState, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) Never! {
    if state.uninit.len() == 0 -> return
    if arg.expr == .Ident(name, span, _) && sema_scope_resolve_index(scopes, name) == .Val(index) {
        if sema_ownership_uninit_contains(state.uninit, scopes.bindings[index].symbol.id.key) {
            diagnostics.push(sema_error("E0420", span, "`{name}` may be read before it is given a value", "passing `{name}` with write access does not prove that the callee initializes it", "write every value in `{name}` here before passing it to another function"))
        }
    }
}

// `Fixed.over(bytes)` is the one raw-storage adapter: it borrows
// the storage without claiming it was initialized. The facts it takes are
// set again after the call is checked.
sema_stmt_uninit_fixed_over_take: fn(receiver: Expr, method: String, args: [CallArg], state: &SemaOwnershipState, scopes: SemaScopeTable) -> [SemaOwnershipUninitFact] Never! {
    taken := [SemaOwnershipUninitFact]{}
    if method != "over" || state.uninit.len() == 0 -> return taken
    if receiver == .Field(_, member, _, _) && member == "Fixed" {
        loop arg in args {
            if arg.expr == .Ident(name, _, _) && sema_scope_resolve_index(scopes, name) == .Val(index) {
                if sema_ownership_uninit_take(state, scopes.bindings[index].symbol.id.key) == .Val(fact) -> taken.push(fact)
            }
        }
    }
    taken
}

// A `#Track` binding records its checked source identity
// and declaration site (Rust `check_binding`); the marker stays on the AST.
sema_stmt_track_origin: fn(binding: Binding, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) Never! {
    tracked: loop marker in binding.markers {
        if marker.name == MARKER_TRACK && !marker.negated -> break true
    } ?? false
    if !tracked || binding.name.len() == 0 || binding.name == "_" -> return
    index: sema_scope_resolve_index(scopes, binding.name) ?? return
    sema_scope_note_binding_edit(scopes, index)
    scopes.bindings[index].origin = Val(SemaOriginFact{
        source: binding.name,
        line: sema_source_line_at(environment.source_segments, binding.name_span),
        column: sema_source_column_at(environment.source_segments, binding.name_span),
    })
}

// L0517: `name: path.normalize().to_string()`
// binds the text of a typed normalized Path, so a string-prefix containment
// check written over two such names is reported (sema_expr_lint_path_prefix).
sema_stmt_note_normalized_path_text: fn(binding: Binding, init: TExpr, scopes: &SemaScopeTable) Never! {
    if binding.mutable || binding.name.len() == 0 || binding.name == "_" -> return
    if init.kind == .HandleMethod(receiver, operation, _) {
        if !sema_stmt_is_path_op(operation, false) -> return
        if receiver.kind == .HandleMethod(_, inner, _) {
            if !sema_stmt_is_path_op(inner, true) -> return
            index: sema_scope_resolve_index(scopes, binding.name) ?? return
            sema_scope_note_binding_edit(scopes, index)
            scopes.bindings[index].normalized_path_text = true
        }
    }
}

// `Path.normalize()` when `normalize`, else `Path.to_string()`.
sema_stmt_is_path_op: fn(operation: THandleOp, normalize: Bool) -> Bool Never! {
    if operation == {
        .PathNormalize -> normalize
        .PathToString -> !normalize
        else -> false
    }
}

// `name: comptime { value }` in a body is compile-time code
// (Rust `check_binding` under `in_comptime`). A value already known here, such
// as a fact read on a local, binds at once; any other value is staged through
// the body comptime evaluator and binds when the owner body is checked again.
// The name then reads as that value and the binding emits no runtime code.
sema_stmt_check_prepared_binding: fn(binding: Binding, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    fact_start: context.call_facts.len()
    scopes.comptime_execution_depth += 1
    checked: sema_check_expression(binding.init, binding.ty, environment, program, scopes, state, tail_store, context, diagnostics)
    scopes.comptime_execution_depth -= 1
    init: checked ?? {
        sema_stmt_declare_unchecked_binding(binding, environment, program, scopes)
        return None
    }
    if sema_stmt_comptime_site_refused(context, fact_start, diagnostics) {
        sema_stmt_declare_unchecked_binding(binding, environment, program, scopes)
        return None
    }
    value := sema_expr_comptime_value(init, context)
    if value == None -> value = sema_fact_constant_path_value(init, context)
    ty := init.ty
    init_span: expr_span(binding.init)
    if value == None {
        staged: sema_comptime_body_value_find(context, environment.module_identity, sema_scope_function_owner_key(scopes), init_span, binding.name_span)
        if staged == .Val(body_value) {
            value = Val(body_value.value)
            ty = body_value.ty
        } else {
            _ := sema_comptime_body_capture(context, environment, program, scopes, binding.name, binding.init, init.ty, init_span, binding.name_span)
            sema_stmt_declare_unchecked_binding(binding, environment, program, scopes)
            return None
        }
    }
    known: value ?? return None
    owner := sema_scope_local_owner_key(scopes)
    id: symbol_id(SymbolKind.Local, environment.module_identity, owner, binding.name)
    symbol := Symbol{id: id, kind: SymbolKind.Local, name: binding.name, module_name: environment.module_identity, owner: Val(owner), span: binding.name_span, ty: Val(ty), visibility: 0}
    if !sema_scope_declare_local(scopes, symbol, false, AccessConvention.Read, None, false) {
        diagnostics.push(sema_already_defined(binding.name, binding.name_span))
        return None
    }
    if binding.name != "_" {
        last: scopes.bindings.len() - 1
        sema_scope_note_binding_edit(scopes, last)
        scopes.bindings[last].prepared = Val(known)
    }
    sema_ownership_declare_binding(state, symbol, false)
    sema_stmt_track_origin(binding, environment, program, scopes)
    sema_origin_prepared_projection(binding.init, ty, known, context)
    Val(TStmt.Inline{body: [TStmt]{}, span: Span{start: binding.name_span.start, end: init_span.end}})
}

// A compile-time site whose calls (from `fact_start` on) reach `core.net`
// beyond the pinned fetch (E3412) or read ambient time or randomness (E3403)
// is refused where the body writes it, so it is never staged and a later
// site in the body is still checked. True when reported.
sema_stmt_comptime_site_refused: fn(context: SemaCheckContext, fact_start: Int, diagnostics: &[Diagnostic]) -> Bool {
    before: diagnostics.len()
    loop index in fact_start..<context.call_facts.len() {
        fact: context.call_facts[index]
        if !sema_effect_comptime_net_unavailable(fact, diagnostics) -> sema_effect_comptime_nondeterministic(fact, diagnostics)
    }
    diagnostics.len() > before
}

// Rust `Stmt::Assign` with a compound op checks the update value against the
// place type: `text += "…"` appends to a String place (the binary `+`
// itself is not text joining, which stays E0109); every other compound op
// keeps its binary operator typing, and `n /%= 0` its zero-divisor lint.
sema_stmt_compound_result: fn(op: BinOp, place: Type, offered: Type, value: Expr, span: Span, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Type? {
    if op == BinOp.Add && place == Type.String && offered == Type.String -> return Val(Type.String)
    sema_expr_lint_zero_divisor(op, value, place, offered, span, scopes, diagnostics)
    sema_expr_binary_type(op, place, offered, span, diagnostics)
}

sema_stmt_check_local_assignment: fn(name: String, name_span: Span, op: BinOp?, op_span: Span, expr: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    index: sema_scope_resolve_index(scopes, name)
    if index == None {
        diagnostics.push(sema_unknown_name_at(name, name_span, environment, program, scopes))
        return None
    }
    binding: sema_scope_binding_row(environment, scopes, index)
    if sema_ownership_reject_frozen_write(state, Expr.Ident{name: name, span: name_span, id: AST_NODE_GENERATED}, "be assigned", name_span, scopes, diagnostics) -> return None
    // Rust `is_global_mutable_binding`: a module-level `name := …` is the one
    // module-level write target; it writes the binding's runtime storage cell.
    // A function writes it only when it is `#Persist` or inside `#Unsafe`:
    // every task sees module state, and two plain
    // writes at once can lose one.
    if binding.symbol.kind == SymbolKind.Constant {
        if sema_stmt_module_storage_binding(environment, program, binding.symbol.id) == .Val(persists) {
            if !persists && context.unsafe_depth == 0 {
                diagnostics.push(sema_error("E0111", name_span, "`{name}` is module state, so a function can't change it directly", "every task sees module state, and two plain writes at once can lose one", "keep it in a `shared` holder (`{name}: shared Count{{value: 0}}`, written `{name}.value += 1`); code that needs a raw word writes it inside `#Unsafe(\"reason\") {{ … }}`"))
                return None
            }
            context.module_writes.push(TEffectSpan{name: name, span: name_span})
            return sema_stmt_check_module_storage_assignment(binding.symbol, name, name_span, op, op_span, expr, environment, program, scopes, state, tail_store, context, diagnostics)
        }
    }
    if !binding.mutable && !sema_stmt_binding_is_write_window(state, binding.symbol.id.key) {
        diagnostic := sema_error("E0111", name_span, "`{name}` was made with `:`, so it can't change", "only `:=` bindings and parameters declared with the write mark `&` can be changed", "declare it with `{name} := ...` instead")
        if binding.binding_sigil == .Val(sigil) -> diagnostic = diagnostic_with_edit(diagnostic, TextEdit{span: sigil, new_text: " :="})
        diagnostics.push(diagnostic)
        // The refused value is still checked, so the names it reads count as
        // used: `total = total + n` must not leave `n` an unused binding whose
        // `_n` rename `jet fix` would apply.
        _ := sema_check_expression(expr, binding.symbol.ty, environment, program, scopes, state, tail_store, context, diagnostics)
        return None
    }
    if binding.symbol.ty == None {
        // An unchecked target already carries its initializer's report.
        _ := sema_check_expression(expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return None
    }
    if op != None {
        if !sema_ownership_note_reference(state, name, name_span, scopes, SemaOwnershipReferenceKind.Read) -> return None
        if !sema_ownership_check_use(state, Expr.Ident{name: name, span: name_span, id: AST_NODE_GENERATED}, scopes, diagnostics) -> return None
    }
    if !sema_hardware_note_cpu_use(Expr.Ident{name: name, span: name_span, id: AST_NODE_GENERATED}, scopes, state, context, diagnostics) -> return None
    required: binding.symbol.ty ?? Type.Named{name: "Unit"}
    expected := Type?{None}
    plain_self_typed: op == None && sema_stmt_numeric_slot_self_typed(expr, required)
    if op == None && !plain_self_typed -> expected = Val(required)
    // The Rust `Stmt::Assign` feeds the place type into the RHS for compound
    // updates too, so `price *= 2.0` with `price: Float` reads the literal as
    // Float rather than exact Decimal.
    if op != None && sema_expr_decimal_literal_operand(expr, true) && sema_expr_expects_machine_float(Val(required)) -> expected = Val(required)
    checked_value: sema_check_expression(expr, expected, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    if !sema_copy_site_check_guard_owned(checked_value, environment, program, scopes, state, context, diagnostics, false) -> return None
    if op == None && !sema_copy_site_refuse_borrowed_copy(expr, "the assignment to `{name}`", environment, program, scopes, context, diagnostics) -> return None
    checked := checked_value
    // A compound operand widens into the place's numeric type first
    // (`total += byte`), as Rust `widen_numeric_expr` does after inference.
    if op != None && sema_stmt_compound_widens(checked, required) {
        widen_line: sema_source_line_at(environment.source_segments, checked.span) ?? 0
        checked = sema_expr_numeric_literal_conversion(checked, required, checked.span, widen_line, diagnostics) ?? return None
    }
    if plain_self_typed -> checked = sema_stmt_numeric_slot_value(checked, required, environment, program, diagnostics) ?? return None
    if op == None && sema_copy_site_check_assignment(expr, environment, program, scopes, context, diagnostics) -> return None
    // A plain `name = …` gives a `Type{ uninit }`
    // binding its value; a compound update reads it first (E0420).
    if sema_ownership_uninit_take(state, binding.symbol.id.key) != None && op != None {
        diagnostics.push(sema_error("E0420", name_span, "`{name}` may be read before it is given a value", "`{name}+=` reads `{name}` first, but it was declared with `Type{{ uninit }}` and has no value yet", "give `{name}` a value with `{name} = …` before updating it"))
    }
    // An escaping lambda bound in an open scope still holds `name`'s write
    // access (Rust `lambda_mut_borrow_active`).
    if sema_ownership_lambda_write_borrow_active(state, name) -> diagnostics.push(sema_ownership_diag_alias(name, true, name_span))
    tree_op := TBinaryOp?{None}
    if op != None {
        operator: op
        result: sema_stmt_compound_result(operator, required, checked.ty, expr, op_span, scopes, diagnostics) ?? return None
        if !sema_type_assignable(required, result) {
            diagnostics.push(sema_slot_holds_mismatch("`{name}`", "binding", required, result, name_span))
            return None
        }
        tree_op = Val(sema_stmt_binary_type(operator))
    }
    sema_ownership_release_value_only_views(state, LValue.Local{name: name, name_span: name_span}, tail_store, context)
    if !sema_ownership_check_lvalue_write(state, LValue.Local{name: name, name_span: name_span}, scopes, diagnostics) -> return None
    if !sema_stmt_move_direct(expr, state, scopes, "the assignment to `{name}`", diagnostics) -> return None
    if op == None -> sema_ownership_note_frozen_binding(state, binding.symbol.id.key, expr, scopes)
    line: sema_source_line_at(environment.source_segments, name_span) ?? return None
    local := checked_symbol_local(name, binding.symbol.span, binding.symbol.id, required)
    local.mutable = true
    span: Span{start: name_span.start, end: expr_span(expr).end}
    value := checked
    if op != None {
        operator: op
        read: sema_tree_node(required, TExprKind.Local{local: local.copy()}, name_span)
        if sema_stmt_policy_compound(operator, required, read, checked, line, span, context) == .Val(policed) {
            value = policed
            tree_op = None
        }
    }
    updated_bounds := TIntegerBounds?{None}
    // Mutable loop-carried values cannot inherit a one-iteration interval.
    // Their declared range remains available through the type fact channel.
    sema_scope_note_binding_edit(scopes, index)
    scopes.bindings[index].integer_bounds = updated_bounds
    // A new value has no `#Track` origin (Rust `clear_origin`).
    scopes.bindings[index].origin = None
    Val(TStmt.Assign{place: TPlace.Local{local: local}, op: tree_op, value: value, line: line, span: span})
}

// Rust `is_global_mutable_binding`: this module's own `name := …` binding that
// is not prepared while building, with whether it is `#Persist`; None for
// any other binding. A checker on the registration graph has no local
// declarations (sema_scope_environment for a graph module), so the binding is
// read from the module's registered constant rows.
sema_stmt_module_storage_binding: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, id: SymbolID) -> Bool? Never! {
    loop declaration_index in 0..<environment.declarations.len() {
        if environment.declarations[declaration_index].symbol_id.key != id.key -> next
        if environment.declarations[declaration_index].item == .Const(definition) {
            if definition.mutable && !definition.is_comptime -> return Val(definition.is_persist)
        }
        return None
    }
    if program.registration_graph == .Val(graph) {
        module_index: sema_scope_caller_index(environment, graph) ?? return None
        loop constant_index in 0..<graph.modules[module_index].constants.len() {
            if graph.modules[module_index].constants[constant_index].symbol.id.key != id.key -> next
            if graph.modules[module_index].constants[constant_index].declaration.mutable && !graph.modules[module_index].constants[constant_index].declaration.is_comptime -> return Val(graph.modules[module_index].constants[constant_index].declaration.is_persist)
            return None
        }
    }
    None
}

// Rust `Stmt::Assign` on a module-level mutable binding: the value checks
// against the declared place type, and the write lands in the binding's
// persistent storage cell (the Rust reference lowering's `persistent_local`).
sema_stmt_check_module_storage_assignment: fn(symbol: Symbol, name: String, name_span: Span, op: BinOp?, op_span: Span, expr: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    required: symbol.ty ?? {
        // An unchecked module binding already carries its initializer's report.
        _ := sema_check_expression(expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return None
    }
    expected := Type?{None}
    if op == None -> expected = Val(required)
    if op != None && sema_expr_decimal_literal_operand(expr, true) && sema_expr_expects_machine_float(Val(required)) -> expected = Val(required)
    checked_value: sema_check_expression(expr, expected, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    checked := checked_value
    if op != None && sema_stmt_compound_widens(checked, required) {
        widen_line: sema_source_line_at(environment.source_segments, checked.span) ?? 0
        checked = sema_expr_numeric_literal_conversion(checked, required, checked.span, widen_line, diagnostics) ?? return None
    }
    tree_op := TBinaryOp?{None}
    if op != None {
        operator: op
        result: sema_stmt_compound_result(operator, required, checked.ty, expr, op_span, scopes, diagnostics) ?? return None
        if !sema_type_assignable(required, result) {
            diagnostics.push(sema_type_mismatch(required, result, op_span))
            return None
        }
        tree_op = Val(sema_stmt_binary_type(operator))
    }
    if !sema_copy_site_check_guard_owned(checked, environment, program, scopes, state, context, diagnostics, false) -> return None
    if op == None && !sema_copy_site_refuse_borrowed_copy(expr, "the assignment to `{name}`", environment, program, scopes, context, diagnostics) -> return None
    if !sema_stmt_move_direct(expr, state, scopes, "the assignment to `{name}`", diagnostics) -> return None
    line: sema_source_line_at(environment.source_segments, name_span) ?? return None
    storage := checked_persistent_local(name, environment.module_identity, required, name_span)
    storage.mutable = true
    place: sema_tree_node(required, TExprKind.Local{local: storage}, name_span)
    span: Span{start: name_span.start, end: expr_span(expr).end}
    value := checked
    if op != None {
        operator: op
        // The storage reads as its constant reference (sema_expr_check_ident).
        read: sema_node(context, required, NodeKind.ConstRef{symbol: symbol.id}, name_span)
        if sema_stmt_policy_compound(operator, required, read, checked, line, span, context) == .Val(policed) {
            value = policed
            tree_op = None
        }
    }
    Val(TStmt.Assign{place: TPlace.Expr{value: place}, op: tree_op, value: value, line: line, span: span})
}

// Rust `source != target && source.numeric_widening_to(target).is_some()`,
// read through `sema_expr_numeric_value_widening` so a literal operand takes
// the place's width. The port helper reports a contained fixed-width range as
// `Val(true)` and an uncontained one as `Val(false)`, so ranged pairs widen
// only on `Val(true)`.
sema_stmt_compound_widens: fn(value: TExpr, target: Type) -> Bool {
    if type_identity_equal(value.ty, target) -> return false
    widening: sema_expr_numeric_value_widening(value, target)
    if sema_expr_integer_range_for_type(value.ty) != None && sema_expr_integer_range_for_type(target) != None -> return widening == (Val(true))
    widening != None
}

// Rust `Stmt::Assign` and call arguments infer the value with the slot type
// only as a hint, then widen a narrower numeric value into the slot
// (`n = bytes[i]` with `n: Int`, `f(id.value)` of `U64` into `Int`). A name,
// field, or index read, and a typed literal with a written numeric head
// (`F32{1.5}` into a `Float` parameter), has its own type whatever the hint,
// so it checks without one and `sema_stmt_numeric_slot_value` fits it into
// the slot.
sema_stmt_numeric_slot_self_typed: fn(expr: Expr, required: Type) -> Bool Never! {
    if !sema_expr_is_numeric(required) -> return false
    if expr == {
        .Ident(_, _, _) | .Field(_, _, _, _) | .Index(_, _, _, _, _) -> return true
        .Paren(inner, _, _) -> return sema_stmt_numeric_slot_self_typed(inner, required)
        .TypedLit(head, _, _, _) -> {
            if head == .Val(written) -> return sema_expr_is_numeric(written)
            return false
        }
        else -> return false
    }
}

// A self-typed value in a numeric slot: widened (Rust `widen_numeric_expr`)
// when its numeric type widens into the slot, else the ordinary expected-type
// check.
sema_stmt_numeric_slot_value: fn(value: TExpr, required: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> TExpr? {
    if sema_expr_is_numeric(value.ty) && sema_stmt_compound_widens(value, required) {
        line: sema_source_line_at(environment.source_segments, value.span) ?? 0
        return sema_expr_numeric_literal_conversion(value, required, value.span, line, diagnostics)
    }
    sema_expr_expected(value, Val(required), environment, program, diagnostics)
}

sema_stmt_transaction_expr_root: fn(expr: Expr) -> String? {
    if expr == {
        .Ident(name, _, _) -> return Val(name)
        .Field(base, _, _, _) | .Index(base, _, _, _, _) -> return sema_stmt_transaction_expr_root(base)
        else -> None
    }
}

sema_stmt_transaction_lvalue_root: fn(target: LValue) -> String? {
    if target == {
        .Local(name, _) -> return Val(name)
        .Field(base, _, _) -> return sema_stmt_transaction_expr_root(base)
        .Index(base, _, _, _) -> return sema_stmt_transaction_expr_root(base)
    }
}

sema_stmt_transaction_add_root: fn(name: String, roots: &[String]) Never! {
    loop existing in roots {
        if existing == name -> return
    }
    roots.push(name.copy())
}

sema_stmt_transaction_collect_roots: fn(statements: [Stmt], roots: &[String]) Never! {
    loop statement in statements {
        if statement == {
            .Assign(target, _, _, _) -> {
                root := sema_stmt_transaction_lvalue_root(target)
                if root != None -> sema_stmt_transaction_add_root(root ?? "", roots)
            }
            .While(_, body, _, _, _)
            | .Loop(body, _, _, _)
            | .Unsafe(_, _, body, _)
            | .Impure(_, _, body, _)
            | .Reactive(body, _)
            | .Shield(body, _)
            | .Region(_, _, body, _)
            | .Policy(_, body, _)
            | .TaskGroup(_, _, _, body, _)
            | .Layout(_, _, body, _)
            | .AuthorityScope(_, _, _, body, _)
            | .ContextBlock(_, body, _)
            | .Live(body, _)
            | .AssumeDet(_, _, body, _) -> sema_stmt_transaction_collect_roots(body, roots)
            .Switched(marker, body, _) -> {
                if marker.name != MARKER_OFF -> sema_stmt_transaction_collect_roots(body, roots)
            }
            .For(_, _, _, _, body, _, _, _, _) -> sema_stmt_transaction_collect_roots(body, roots)
            .CountedLoop(_, _, _, body, _, _, _) -> sema_stmt_transaction_collect_roots(body, roots)
            .Switch(_, arms, else_body, _) -> {
                loop arm in arms -> sema_stmt_transaction_collect_roots(arm.body, roots)
                if else_body != None -> sema_stmt_transaction_collect_roots(else_body, roots)
            }
            .ComptimeIf(_, _, then_body, else_body, _, _) -> {
                sema_stmt_transaction_collect_roots(then_body, roots)
                if else_body != None -> sema_stmt_transaction_collect_roots(else_body, roots)
            }
            .ComptimeBlock(_, _, _) | .ComptimeSwitch(_, _, _, _) -> {}
            .Transact(_, _, _, _, _) -> {}
            else -> {}
        }
    }
}

sema_stmt_transaction_rollback_trait_symbol: fn(graph: SemaRegistrationGraph, implementation: SemaRegistrationImpl) -> Symbol? {
    if implementation.trait_symbol != None -> return implementation.trait_symbol
    resolved: sema_registration_lookup_name(graph, implementation.source_module_identity, "Rollback") ?? return None
    if sema_resolved_kind(graph, resolved) == SymbolKind.Trait -> return Val(sema_resolved_symbol(graph, resolved))
    None
}

sema_stmt_transaction_rollback_methods: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaStatementRollbackMethods? {
    if ty == {
        .Named(_) -> {}
        else -> return None
    }
    if program.registration_graph == .Val(graph) {
        nominal_row: sema_type_resolve_nominal_row_at(graph, ty, sema_scope_caller_row(environment, graph)) ?? return None
        nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
        loop graph_module_index in 0..<graph.modules.len() {
            loop implementation_index in 0..<graph.modules[graph_module_index].impls.len() {
                trait_matches := graph.modules[graph_module_index].impls[implementation_index].trait_name == (Val("Rollback"))
                if graph.modules[graph_module_index].impls[implementation_index].trait_symbol != None {
                    trait_value: graph.modules[graph_module_index].impls[implementation_index].trait_symbol ?? return None
                    trait_matches = trait_value.name == "Rollback"
                }
                if !trait_matches || !(sema_type_graph_impl_matches_nominal(graph, graph.modules[graph_module_index].impls[implementation_index], nominal) ?? false) -> next
                trait_owner := sema_stmt_transaction_rollback_trait_symbol(graph, graph.modules[graph_module_index].impls[implementation_index])
                snapshot_method := TMethodRef?{None}
                restore_method := TMethodRef?{None}
                loop method_index in 0..<graph.modules[graph_module_index].impls[implementation_index].methods.len() {
                    method_ref := TMethodRef{symbol: graph.modules[graph_module_index].impls[implementation_index].methods[method_index].symbol.id, name: graph.modules[graph_module_index].impls[implementation_index].methods[method_index].symbol.name, mangled: false, trait_owner: trait_owner.map((value) -> value.id), operator_identity: None}
                    if graph.modules[graph_module_index].impls[implementation_index].methods[method_index].symbol.name == "snapshot" -> snapshot_method = Val(method_ref)
                    if graph.modules[graph_module_index].impls[implementation_index].methods[method_index].symbol.name == "restore" -> restore_method = Val(method_ref)
                }
                if snapshot_method != None && restore_method != None {
                    snapshot: snapshot_method ?? return None
                    restore: restore_method ?? return None
                    return Val(SemaStatementRollbackMethods{snapshot: snapshot, restore: restore})
                }
            }
        }
    }
    None
}

sema_stmt_transaction_snapshots: fn(roots: [String], scopes: SemaScopeTable, environment: SemaScopeEnvironment, program: SemaProgramTables) -> [TTransactionSnapshot] Never! {
    snapshots := [TTransactionSnapshot]{}
    loop name in roots {
        index := sema_scope_resolve_index(scopes, name)
        if index == None -> next
        binding: scopes.bindings[index ?? 0]
        if binding.symbol.kind != SymbolKind.Local && binding.symbol.kind != SymbolKind.Parameter -> next
        local_ty: binding.symbol.ty ?? next
        local := checked_symbol_local(name, binding.symbol.span, binding.symbol.id, local_ty)
        local.mutable = binding.mutable
        local.integer_bounds = binding.integer_bounds
        rollback := sema_stmt_transaction_rollback_methods(binding.symbol.ty ?? Type.Named{name: "Unit"}, environment, program)
        rollback_type := Type?{None}
        snapshot_method := TMethodRef?{None}
        restore_method := TMethodRef?{None}
        if rollback != None {
            rollback_value: rollback ?? return snapshots
            rollback_type = Val(binding.symbol.ty ?? Type.Named{name: "Unit"})
            snapshot_method = Val(rollback_value.snapshot)
            restore_method = Val(rollback_value.restore)
        }
        snapshots.push(TTransactionSnapshot{local: local, rollback_type: rollback_type, snapshot_method: snapshot_method, restore_method: restore_method})
    }
    snapshots
}

sema_stmt_transaction_stm_local: fn(span: Span) -> TLocal Never! {
    local := checked_generated_local("stm", span, Type.Named{name: "Stm"})
    local.mutable = true
    local
}

// Whether any child expression of `value` touches shared state; the
// children are read in place (tree_each_*_child), never copied. `arena`
// holds the rows of the body's flat nodes (sema_node).
sema_stmt_tree_children_touch_shared: fn(value: TExpr, arena: BodyTree) -> Bool Never! {
    found := false
    tree_each_expr_child(value, (child: TExpr) -> {
        if !found && sema_stmt_tree_expr_touches_shared(child, arena) -> found = true
    })
    found
}

sema_stmt_tree_pattern_touches_shared: fn(pattern: TPattern, arena: BodyTree) -> Bool Never! {
    found := false
    tree_each_pattern_child(pattern, (child: TExpr) -> {
        if !found && sema_stmt_tree_expr_touches_shared(child, arena) -> found = true
    })
    found
}

sema_stmt_tree_condition_touches_shared: fn(condition: TIfCond, arena: BodyTree) -> Bool Never! {
    found := false
    tree_each_if_cond_child(condition, (child: TExpr) -> {
        if !found && sema_stmt_tree_expr_touches_shared(child, arena) -> found = true
    })
    found
}

sema_stmt_tree_statement_children_touch_shared: fn(statement: TStmt, arena: BodyTree) -> Bool Never! {
    found := false
    tree_each_stmt_child(statement, (child: TExpr) -> {
        if !found && sema_stmt_tree_expr_touches_shared(child, arena) -> found = true
    })
    found
}

sema_stmt_tree_expr_touches_shared: fn(value: TExpr, arena: BodyTree) -> Bool Never! {
    if value.kind == {
        .Flat(index) -> return sema_stmt_row_touches_shared(arena, index)
        .Lambda(_) -> return false
        .InlineBlock(body) -> return sema_stmt_tree_statements_touch_shared(body, arena)
        .IfExpr(condition, then_body, then_value, else_body, else_value) -> {
            if sema_stmt_tree_condition_touches_shared(condition, arena) -> return true
            if sema_stmt_tree_statements_touch_shared(then_body, arena) -> return true
            if sema_stmt_tree_expr_touches_shared(then_value, arena) -> return true
            if sema_stmt_tree_statements_touch_shared(else_body, arena) -> return true
            return sema_stmt_tree_expr_touches_shared(else_value, arena)
        }
        .SharedGuardWait(guard, condition, _) -> {
            if sema_stmt_tree_expr_touches_shared(guard, arena) -> return true
            return sema_stmt_tree_expr_touches_shared(condition, arena)
        }
        .CoreClosureCall(kind) -> return sema_stmt_tree_core_closure_touches_shared(kind, arena)
        .FnValue(kind) -> {
            if kind == {
                .NamedFn(_, _) -> return false
                else -> {}
            }
        }
        .HostCall(call) -> {
            if call == {
                .Method(receiver, method, _) -> {
                    if method == "shared.read" || method == "shared.edit" || method == "shared.read_txn" || method == "shared.edit_txn" -> return true
                    // A capture inside a transaction snapshots through the STM.
                    if method == "capture" && receiver.ty == .Shared(_) -> return true
                }
                else -> {}
            }
        }
        else -> {}
    }
    sema_stmt_tree_children_touch_shared(value, arena)
}

sema_stmt_tree_contract_touches_shared: fn(contract: TContract, arena: BodyTree) -> Bool Never! {
    if sema_stmt_tree_expr_touches_shared(contract.condition, arena) -> return true
    sema_stmt_tree_expr_touches_shared(contract.message, arena)
}

sema_stmt_tree_core_closure_touches_shared: fn(kind: TCoreClosureKind, arena: BodyTree) -> Bool Never! {
    if kind == {
        .Spawn(group, _, _, _) -> {
            if group != None {
                value: group
                if sema_stmt_tree_expr_touches_shared(value, arena) -> return true
            }
            false
        }
        .Realtime(rate, frames, _) -> sema_stmt_tree_expr_touches_shared(rate, arena) || sema_stmt_tree_expr_touches_shared(frames, arena)
        .UITextInputOnDrop(state, ime, _) -> sema_stmt_tree_expr_touches_shared(state, arena) || sema_stmt_tree_expr_touches_shared(ime, arena)
        .Guard(_) | .OnCommit(_, _) | .OnRollback(_, _) | .ReactiveDerived(_) | .ReactiveEffect(_) | .UIReactiveRender(_) | .UIClickSlot(_) -> false
    }
}

sema_stmt_tree_statement_touches_shared: fn(statement: TStmt, arena: BodyTree) -> Bool Never! {
    if statement == {
        .Transact(_, _, _, _, _) -> false
        .ContractScope(pre, body, post, _, _) -> {
            loop contract in pre {
                if sema_stmt_tree_contract_touches_shared(contract, arena) -> return true
            }
            if sema_stmt_tree_statements_touch_shared(body, arena) -> return true
            loop contract in post {
                if sema_stmt_tree_contract_touches_shared(contract, arena) -> return true
            }
            false
        }
        .RefutableBind(pattern, init, fallback, _) -> {
            if sema_stmt_tree_pattern_touches_shared(pattern, arena) -> return true
            if sema_stmt_tree_expr_touches_shared(init, arena) -> return true
            sema_stmt_tree_statements_touch_shared(fallback, arena)
        }
        .CountedLoop(_, init, condition, step, _, body, _) -> {
            if sema_stmt_tree_statement_touches_shared(init, arena) -> return true
            if sema_stmt_tree_expr_touches_shared(condition, arena) -> return true
            if step != None {
                nested: step
                if sema_stmt_tree_statement_touches_shared(nested, arena) -> return true
            }
            sema_stmt_tree_statements_touch_shared(body, arena)
        }
        .ForRange(_, _, start, end, step, _, body, _, _) -> {
            if sema_stmt_tree_expr_touches_shared(start, arena) || sema_stmt_tree_expr_touches_shared(end, arena) -> return true
            if step != None {
                nested: step
                if sema_stmt_tree_expr_touches_shared(nested, arena) -> return true
            }
            sema_stmt_tree_statements_touch_shared(body, arena)
        }
        .Range(_, _, source, start, end, step, _, _, body, _) -> {
            if source == .Val(nested) && sema_stmt_tree_expr_touches_shared(nested, arena) -> return true
            if sema_stmt_tree_expr_touches_shared(start, arena) || sema_stmt_tree_expr_touches_shared(end, arena) -> return true
            if step == .Val(nested) && sema_stmt_tree_expr_touches_shared(nested, arena) -> return true
            sema_stmt_tree_statements_touch_shared(body, arena)
        }
        .If(condition, then_body, else_body, _, _) -> {
            if sema_stmt_tree_condition_touches_shared(condition, arena) -> return true
            if sema_stmt_tree_statements_touch_shared(then_body, arena) -> return true
            if else_body == .Val(else_statements) -> sema_stmt_tree_statements_touch_shared(else_statements, arena) else -> false
        }
        .Loop(_, body, _) -> sema_stmt_tree_statements_touch_shared(body, arena)
        .While(_, condition, body, _) -> {
            if sema_stmt_tree_expr_touches_shared(condition, arena) -> return true
            sema_stmt_tree_statements_touch_shared(body, arena)
        }
        .Match(subject, arms, _, _) -> {
            if sema_stmt_tree_expr_touches_shared(subject, arena) -> return true
            loop arm in arms {
                if sema_stmt_tree_pattern_touches_shared(arm.pattern, arena) -> return true
                if sema_stmt_tree_statements_touch_shared(arm.body, arena) -> return true
            }
            false
        }
        .EnumMatch(scrutinee, arms, else_body, _, _) -> {
            if sema_stmt_tree_expr_touches_shared(scrutinee, arena) -> return true
            loop arm in arms {
                if sema_stmt_tree_pattern_touches_shared(arm.pattern, arena) -> return true
                if sema_stmt_tree_statements_touch_shared(arm.body, arena) -> return true
            }
            if else_body == .Val(else_statements) -> sema_stmt_tree_statements_touch_shared(else_statements, arena) else -> false
        }
        .RangeSwitch(subject, arms, else_body, _) -> {
            if sema_stmt_tree_expr_touches_shared(subject, arena) -> return true
            loop arm in arms {
                if sema_stmt_tree_statements_touch_shared(arm.body, arena) -> return true
            }
            sema_stmt_tree_statements_touch_shared(else_body, arena)
        }
        .ForIn(_, _, _, source, collection, step, _, _, _, _, body, _) -> {
            if sema_stmt_tree_expr_touches_shared(source, arena) || sema_stmt_tree_expr_touches_shared(collection, arena) -> return true
            if step != None {
                nested: step
                if sema_stmt_tree_expr_touches_shared(nested, arena) -> return true
            }
            sema_stmt_tree_statements_touch_shared(body, arena)
        }
        .Inline(body, _) | .DebugOnly(body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) -> sema_stmt_tree_statements_touch_shared(body, arena)
        .MixedSwitch(subject, _, arms, else_body, _) -> {
            if sema_stmt_tree_expr_touches_shared(subject, arena) -> return true
            loop arm in arms {
                if sema_stmt_tree_expr_touches_shared(arm.condition, arena) -> return true
                if sema_stmt_tree_statements_touch_shared(arm.body, arena) -> return true
            }
            if else_body == .Val(else_statements) -> sema_stmt_tree_statements_touch_shared(else_statements, arena) else -> false
        }
        .Unsafe(_, body) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Layout(_, _, body, _) -> sema_stmt_tree_statements_touch_shared(body, arena)
        .ContextBlock(guards, body, _) -> {
            loop guard in guards {
                if sema_stmt_tree_expr_touches_shared(guard.value, arena) -> return true
            }
            sema_stmt_tree_statements_touch_shared(body, arena)
        }
        .ScopeMember(kind, body, _) -> {
            if kind == {
                .Timeout(duration) -> {
                    if sema_stmt_tree_expr_touches_shared(duration, arena) -> return true
                }
                else -> {}
            }
            sema_stmt_tree_statements_touch_shared(body, arena)
        }
        .GCEdit(_, _, _, _, index_temp, nested, _) -> {
            if index_temp != None {
                nested_index: index_temp
                if sema_stmt_tree_expr_touches_shared(nested_index, arena) -> return true
            }
            sema_stmt_tree_statement_touches_shared(nested, arena)
        }
        .Reactive(_, _) -> false
        else -> sema_stmt_tree_statement_children_touch_shared(statement, arena)
    }
}

sema_stmt_tree_statements_touch_shared: fn(statements: [TStmt], arena: BodyTree) -> Bool Never! {
    loop statement in statements {
        if sema_stmt_tree_statement_touches_shared(statement, arena) -> return true
    }
    false
}

// sema_stmt_tree_expr_touches_shared of node row `index` of `tree`.
sema_stmt_row_touches_shared: fn(tree: BodyTree, index: Int) -> Bool Never! {
    if tree.nodes[index - tree.node_base].kind == {
        .Lambda(_) -> return false
        .InlineBlock(body) -> return sema_stmt_rows_touch_shared(tree, body)
        .IfExpr(condition, then_body, then_value, else_body, else_value) -> {
            if sema_stmt_row_condition_touches_shared(tree, condition) -> return true
            if sema_stmt_rows_touch_shared(tree, then_body) -> return true
            if sema_stmt_row_touches_shared(tree, then_value) -> return true
            if sema_stmt_rows_touch_shared(tree, else_body) -> return true
            return sema_stmt_row_touches_shared(tree, else_value)
        }
        .SharedGuardWait(guard, condition, _) -> {
            if sema_stmt_row_touches_shared(tree, guard) -> return true
            return sema_stmt_row_touches_shared(tree, condition)
        }
        .CoreClosureCall(kind) -> return if kind == {
            .Spawn(group, _, _, _) -> if group == .Val(value) -> sema_stmt_row_touches_shared(tree, value) else -> false
            .Realtime(rate, frames, _) -> sema_stmt_row_touches_shared(tree, rate) || sema_stmt_row_touches_shared(tree, frames)
            .UITextInputOnDrop(state, ime, _) -> sema_stmt_row_touches_shared(tree, state) || sema_stmt_row_touches_shared(tree, ime)
            .Guard(_) | .OnCommit(_, _) | .OnRollback(_, _) | .ReactiveDerived(_) | .ReactiveEffect(_) | .UIReactiveRender(_) | .UIClickSlot(_) -> false
        }
        .FnValue(kind) -> {
            if kind == {
                .NamedFn(_, _) -> return false
                else -> {}
            }
        }
        .HostCall(call) -> {
            if call == {
                .Method(receiver, method, _) -> {
                    if method == "shared.read" || method == "shared.edit" || method == "shared.read_txn" || method == "shared.edit_txn" -> return true
                    // A capture inside a transaction snapshots through the STM.
                    if method == "capture" && tree.types.types[tree.expr_types[receiver - tree.node_base].ty] == .Shared(_) -> return true
                }
                else -> {}
            }
        }
        else -> {}
    }
    found := false
    body_each_node_kind_child(tree, tree.nodes[index - tree.node_base].kind, (child: Int) -> {
        if !found && sema_stmt_row_touches_shared(tree, child) -> found = true
    })
    found
}

sema_stmt_row_pattern_touches_shared: fn(tree: BodyTree, pattern: BodyPattern) -> Bool Never! {
    found := false
    body_each_pattern_child(tree, pattern, (child: Int) -> {
        if !found && sema_stmt_row_touches_shared(tree, child) -> found = true
    })
    found
}

sema_stmt_row_condition_touches_shared: fn(tree: BodyTree, condition: BodyIfCond) -> Bool Never! {
    found := false
    body_each_if_cond_child(tree, condition, (child: Int) -> {
        if !found && sema_stmt_row_touches_shared(tree, child) -> found = true
    })
    found
}

// sema_stmt_tree_statement_touches_shared of statement row `item` of `tree`.
sema_stmt_row_statement_touches_shared: fn(tree: BodyTree, item: Int) -> Bool Never! {
    if tree.stmts[item - tree.stmt_base] == {
        .Transact(_, _, _, _, _) | .Reactive(_, _) -> return false
        .ContractScope(pre, body, post, _, _) -> {
            loop contract in pre {
                if sema_stmt_row_touches_shared(tree, contract.condition) || sema_stmt_row_touches_shared(tree, contract.message) -> return true
            }
            if sema_stmt_rows_touch_shared(tree, body) -> return true
            loop contract in post {
                if sema_stmt_row_touches_shared(tree, contract.condition) || sema_stmt_row_touches_shared(tree, contract.message) -> return true
            }
            return false
        }
        .RefutableBind(pattern, init, fallback, _) -> {
            if sema_stmt_row_pattern_touches_shared(tree, pattern) -> return true
            if sema_stmt_row_touches_shared(tree, init) -> return true
            return sema_stmt_rows_touch_shared(tree, fallback)
        }
        .CountedLoop(_, init, condition, step, _, body, _) -> {
            if sema_stmt_row_statement_touches_shared(tree, init) -> return true
            if sema_stmt_row_touches_shared(tree, condition) -> return true
            if step == .Val(nested) && sema_stmt_row_statement_touches_shared(tree, nested) -> return true
            return sema_stmt_rows_touch_shared(tree, body)
        }
        .ForRange(_, _, start, end, step, _, body, _, _) -> {
            if sema_stmt_row_touches_shared(tree, start) || sema_stmt_row_touches_shared(tree, end) -> return true
            if step == .Val(nested) && sema_stmt_row_touches_shared(tree, nested) -> return true
            return sema_stmt_rows_touch_shared(tree, body)
        }
        .Range(_, _, source, start, end, step, _, _, body, _) -> {
            if source == .Val(nested) && sema_stmt_row_touches_shared(tree, nested) -> return true
            if sema_stmt_row_touches_shared(tree, start) || sema_stmt_row_touches_shared(tree, end) -> return true
            if step == .Val(nested) && sema_stmt_row_touches_shared(tree, nested) -> return true
            return sema_stmt_rows_touch_shared(tree, body)
        }
        .If(condition, then_body, else_body, _, _) -> {
            if sema_stmt_row_condition_touches_shared(tree, condition) -> return true
            if sema_stmt_rows_touch_shared(tree, then_body) -> return true
            return if else_body == .Val(else_statements) -> sema_stmt_rows_touch_shared(tree, else_statements) else -> false
        }
        .While(_, condition, body, _) -> {
            if sema_stmt_row_touches_shared(tree, condition) -> return true
            return sema_stmt_rows_touch_shared(tree, body)
        }
        .Match(subject, arms, _, _) -> {
            if sema_stmt_row_touches_shared(tree, subject) -> return true
            loop arm in arms {
                if sema_stmt_row_pattern_touches_shared(tree, arm.pattern) -> return true
                if sema_stmt_rows_touch_shared(tree, arm.body) -> return true
            }
            return false
        }
        .EnumMatch(scrutinee, arms, else_body, _, _) -> {
            if sema_stmt_row_touches_shared(tree, scrutinee) -> return true
            loop arm in arms {
                if sema_stmt_row_pattern_touches_shared(tree, arm.pattern) -> return true
                if sema_stmt_rows_touch_shared(tree, arm.body) -> return true
            }
            return if else_body == .Val(else_statements) -> sema_stmt_rows_touch_shared(tree, else_statements) else -> false
        }
        .RangeSwitch(subject, arms, else_body, _) -> {
            if sema_stmt_row_touches_shared(tree, subject) -> return true
            loop arm in arms {
                if sema_stmt_rows_touch_shared(tree, arm.body) -> return true
            }
            return sema_stmt_rows_touch_shared(tree, else_body)
        }
        .ForIn(_, _, _, source, collection, step, _, _, _, _, body, _) -> {
            if sema_stmt_row_touches_shared(tree, source) || sema_stmt_row_touches_shared(tree, collection) -> return true
            if step == .Val(nested) && sema_stmt_row_touches_shared(tree, nested) -> return true
            return sema_stmt_rows_touch_shared(tree, body)
        }
        .Loop(_, body, _) | .Inline(body, _) | .DebugOnly(body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) | .Unsafe(_, body) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Layout(_, _, body, _) -> return sema_stmt_rows_touch_shared(tree, body)
        .MixedSwitch(subject, _, arms, else_body, _) -> {
            if sema_stmt_row_touches_shared(tree, subject) -> return true
            loop arm in arms {
                if sema_stmt_row_touches_shared(tree, arm.condition) -> return true
                if sema_stmt_rows_touch_shared(tree, arm.body) -> return true
            }
            return if else_body == .Val(else_statements) -> sema_stmt_rows_touch_shared(tree, else_statements) else -> false
        }
        .ContextBlock(guards, body, _) -> {
            loop guard in guards {
                if sema_stmt_row_touches_shared(tree, guard.value) -> return true
            }
            return sema_stmt_rows_touch_shared(tree, body)
        }
        .ScopeMember(kind, body, _) -> {
            if kind == .Timeout(duration) && sema_stmt_row_touches_shared(tree, duration) -> return true
            return sema_stmt_rows_touch_shared(tree, body)
        }
        .GCEdit(_, _, _, _, index_temp, nested, _) -> {
            if index_temp == .Val(nested_index) && sema_stmt_row_touches_shared(tree, nested_index) -> return true
            return sema_stmt_row_statement_touches_shared(tree, nested)
        }
        else -> {}
    }
    found := false
    body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], (child: Int) -> {
        if !found && sema_stmt_row_touches_shared(tree, child) -> found = true
    })
    found
}

sema_stmt_rows_touch_shared: fn(tree: BodyTree, statements: [Int]) -> Bool Never! {
    loop item in statements {
        if sema_stmt_row_statement_touches_shared(tree, item) -> return true
    }
    false
}

sema_stmt_check_transaction: fn(name: String?, name_span: Span?, body: [Stmt], implicit: Bool, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    roots := [String]{}
    sema_stmt_transaction_collect_roots(body, roots)
    snapshots := sema_stmt_transaction_snapshots(roots, scopes, environment, program)
    return_type := scopes.return_type
    loop_depth := scopes.loop_depth
    inside_transaction := implicit && scopes.transaction_depth > 0
    sema_scope_enter(scopes, state, "transact@{span.start}")
    handle := TLocal?{None}
    if name != None {
        handle_name: name
        handle_span: name_span ?? span
        owner := sema_scope_local_owner_key(scopes)
        id := symbol_id(SymbolKind.Local, environment.module_identity, owner, handle_name)
        symbol := Symbol{id: id, kind: SymbolKind.Local, name: handle_name, module_name: environment.module_identity, owner: Val(owner), span: handle_span, ty: Val(Type.Named{name: "Transaction"}), visibility: 0}
        if !sema_scope_declare_local(scopes, symbol, true, AccessConvention.Read, None, false) {
            diagnostics.push(sema_already_defined(handle_name, handle_span))
            sema_scope_leave(scopes, state)
            return None
        }
        sema_ownership_declare_binding(state, symbol, false)
        local := checked_symbol_local(handle_name, handle_span, symbol.id, Type.Named{name: "Transaction"})
        local.mutable = true
        handle = Val(local)
    }
    previous_transaction_depth := scopes.transaction_depth
    previous_transaction_wall_depth := scopes.transaction_wall_depth
    scopes.transaction_depth += 1
    if !implicit -> scopes.transaction_wall_depth += 1
    nested: sema_check_statements(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
    scopes.transaction_depth = previous_transaction_depth
    scopes.transaction_wall_depth = previous_transaction_wall_depth
    sema_single_use_leave_scope(scopes, state, diagnostics)
    if !nested.complete -> return None
    if inside_transaction -> return Val(TStmt.Region{body: nested.value, span: span})
    if handle == None && snapshots.len() > 0 {
        synthesized := checked_generated_local("txn", span, Type.Named{name: "Transaction"})
        synthesized.mutable = true
        handle = Val(synthesized)
    }
    stm := TLocal?{None}
    if sema_stmt_tree_statements_touch_shared(nested.value, context.arena.tree) -> stm = Val(sema_stmt_transaction_stm_local(span))
    Val(TStmt.Transact{handle: handle, snapshots: snapshots, stm: stm, body: nested.value, span: span})
}
sema_stmt_defer_close_resource: fn(close: Expr, scopes: SemaScopeTable) -> SymbolID? {
    if close == {
        .Call(call, _) -> {
            if call.name != "close" || call.args.len() != 1 -> return None
            argument := call.args[0]
            if argument.convention == AccessConvention.Write -> return None
            root: sema_stmt_for_in_expr_root_ident(argument.expr) ?? return None
            index: sema_scope_resolve_index_at(scopes, root, expr_span(argument.expr)) ?? return None
            binding: scopes.bindings[index]
            if binding.symbol.kind != SymbolKind.Local && binding.symbol.kind != SymbolKind.Parameter -> return None
            return Val(binding.symbol.id)
        }
        else -> return None
    }
}
sema_stmt_check_defer_close: fn(close: Expr, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    if close == {
        .Call(call, _) -> {
            if call.name != "close" -> return None
            if call.args.len() != 1 {
                diagnostics.push(sema_error("E0104", call.name_span, "`close` takes exactly one resource, got {call.args.len()}", "`close` takes one value through its nominal `Close` implementation", "write `defer close(resource)`"))
                loop argument in call.args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
                return None
            }
            argument := call.args[0]
            resource_value := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
            if argument.convention == AccessConvention.Write {
                diagnostics.push(sema_error("E0201", argument.span, "`close` takes ownership of its resource", "`Close.close(&&self)` takes its receiver, so cleanup runs on exactly one owner; `&` would only lend it", "write `defer close(resource)`"))
                return None
            }
            value: resource_value ?? return None
            resource_id: sema_stmt_defer_close_resource(close, scopes) ?? return None
            if program.registration_graph == .Val(graph) {
                satisfies_close := sema_type_bound_satisfied_at(graph, value.ty, "Close", sema_scope_caller_row(environment, graph), context.generic_params)
                if satisfies_close == None -> return None
                close_valid := satisfies_close == (Val(true))
                if !close_valid {
                    shown := type_name(value.ty)
                    diagnostics.push(sema_error("E0905", expr_span(argument.expr), "`{shown}` isn't `Close`", "`{shown}` would need to implement `Close` before it can be used here", "write `impl {shown}.Close {{ … }}` with every required method"))
                }
                moved_before := state.moved.len()
                if !sema_stmt_move_direct(argument.expr, state, scopes, "the deferred `close`", diagnostics) || !close_valid -> return None
                sema_ownership_defer_moves(state, moved_before)
                closed := sema_tree_node(Type.Named{name: "Unit"}, TExprKind.Close{value: value}, span)
                return Val(TStmt.DeferClose{close: closed, resource: resource_id, span: span})
            }
            None
        }
        else -> None
    }
}

sema_stmt_check_reactive: fn(body: [Stmt], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TLambda? {
    forbidden := scopes.comptime_execution_depth > 0
    if forbidden {
        diagnostics.push(sema_error("E2914", span, "`#Reactive` can't run at comptime", "reactive effects subscribe to runtime signals and re-run when they change", "move `#Reactive {{ … }}` out of the `comptime` block"))
    }
    closure_body := body
    closure_body.push(Stmt.Return{value: None, span: Span{start: span.end, end: span.end}})
    lambda := Lambda{
        take_names: [NamedSpan]{},
        params: [LambdaParam]{},
        effects: None,
        body: LambdaBody.Block{body: closure_body},
        span: span,
        meta: ast_empty_lambda_meta(),
    }
    previous_escapes := context.lambda_escapes
    context.lambda_escapes = Val(true)
    checked := sema_expression_lambda(lambda, Val(Type.Fn{params: [Type]{}, ret: Val(Type.Named{name: "Unit"}), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}), environment, program, scopes, state, tail_store, context, diagnostics)
    context.lambda_escapes = previous_escapes
    if forbidden -> return None
    expression: checked ?? return None
    if expression.kind == {
        .Lambda(value) -> return Val(value)
        else -> return None
    }
}

sema_stmt_check_scope_member: fn(name: String, args: [Expr], args_span: Span?, body: [Stmt], dsl: Bool, span: Span, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> TStmt? {
    if dsl {
        dsl_args_valid := args.len() == 0
        if name != "HTML" && args.len() == 1 {
            if args[0] == {
                .Ident(_, _, _) -> dsl_args_valid = true
                else -> {}
            }
        }
        if !dsl_args_valid {
            header_span := args_span ?? span
            // The marker rules check the header against the block's registered
            // signature first (E0930); a header they already rejected is not
            // reported a second time.
            registry_reported := false
            loop diagnostic in diagnostics {
                if diagnostic.code == "E0930" && diagnostic.span == .Val(reported) && reported.start >= span.start && reported.end <= header_span.end -> registry_reported = true
            }
            expected := if name == {
                "SQL" -> "`#SQL {{ … }}` or `#SQL(Row) {{ … }}`"
                "HTML" -> "`#HTML {{ … }}`"
                else -> "the declared checked text-block header"
            }
            if !registry_reported -> diagnostics.push(sema_error("E0617", header_span, "`#{name}` has an invalid DSL header", "a checked text block keeps its Jet boundary; only its declared header shape is legal", "write {expected}"))
        }
        // `#SQL(Row)`'s row header is a declared type position: a name that
        // resolves to no type is E0119 at the header.
        if dsl_args_valid && name == "SQL" && args.len() == 1 && args[0] == .Ident(row_name, row_span, _) && program.registration_graph == .Val(graph) {
            generic_names: loop parameter in environment.generic_params -> parameter.name
            caller: sema_scope_caller_row(environment, graph)
            if sema_type_written_name_unknown(graph, caller, row_name, generic_names) {
                diagnostics.push(sema_unknown_type_name(row_name, row_span, sema_type_declared_names(graph, caller)))
                dsl_args_valid = false
            }
        }
        nested := sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "scope-dsl@{span.start}", loop_depth)
        if !dsl_args_valid || !nested.complete -> return None
        return Val(TStmt.Region{body: nested.value, span: span})
    }
    // Rust `#Arithmetic(mode) { … }`: one lexical
    // fixed-width arithmetic mode over the block, read by the operator checks
    // as `context.arithmetic_policy`. An argument that names no mode is the
    // block application's E0930, reported where every marked statement binds
    // its signature (sema_marker_rules_check_statement_facts); the block is
    // still checked.
    if name == "Arithmetic" {
        mode := ArithmeticMode?{None}
        if args.len() == 1 -> mode = sema_function_arithmetic_mode(args[0])
        outer_policy: context.arithmetic_policy
        if mode == .Val(value) -> context.arithmetic_policy = Val(ArithmeticPolicyFact{mode: value, scope_span: span, operation_span: span, operation: None})
        nested := sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "arithmetic@{span.start}", loop_depth)
        context.arithmetic_policy = outer_policy
        if mode == None || !nested.complete -> return None
        return Val(TStmt.Region{body: nested.value, span: span})
    }
    kind := TScopeMemberKind?{None}
    if name == {
        "setup" -> {
            if args.len() == 0 {
                kind = Val(TScopeMemberKind.Setup)
            } else {
                diagnostics.push(sema_error("E0617", args_span ?? span, "`.setup` takes no arguments", "`.setup` marks a region; it has nothing to configure", "write `.setup {{ … }}`"))
            }
        }
        "expect_fail" -> {
            code := String?{None}
            message := String?{None}
            valid := args.len() <= 2
            loop argument in args {
                if argument == {
                    .Ident(value, _, _) -> {
                        if code != None || message != None || !value.starts_with("E30") || diagnostic_registry_row(value) == None -> valid = false
                        code = Val(value)
                    }
                    .TupleLit(fields, _, _, _) -> {
                        if message != None || fields.len() != 1 {
                            valid = false
                            next
                        }
                        if fields[0].name != "message" {
                            valid = false
                            next
                        }
                        if fields[0].value == {
                            .Str(parts, _, _) -> {
                                text := ""
                                loop part in parts {
                                    if part == {
                                        .Lit(value) -> text = "{text}{value}"
                                        else -> valid = false
                                    }
                                }
                                if text.len() == 0 -> valid = false
                                message = Val(text)
                            }
                            else -> valid = false
                        }
                    }
                    else -> valid = false
                }
            }
            if valid -> kind = Val(TScopeMemberKind.ExpectFail{code: code, message: message})
            else -> diagnostics.push(sema_error("E0617", args_span ?? span,
                "`.expect_fail` takes an optional runtime stop code and `message: \"text\"`",
                "the code names a registered E30xx stop; the message is a non-empty string literal matched as a case-sensitive substring",
                "write `.expect_fail {{ … }}`, `.expect_fail(E3010) {{ … }}`, or `.expect_fail(E3001, message: \"reason\") {{ … }}`"))
        }
        "timeout" -> {
            // One argument the ordinary checker types as a Duration; any other
            // shape is the member's own E0617, not a type mismatch.
            if args.len() == 1 {
                checked := [Diagnostic]{}
                duration := sema_check_expression(args[0], Val(Type.Named{name: "Duration"}), environment, program, scopes, state, tail_store, context, checked)
                if !sema_has_error_since(checked, 0) {
                    loop diagnostic in checked -> diagnostics.push(diagnostic)
                    if duration == .Val(typed) -> kind = Val(TScopeMemberKind.Timeout{duration: typed})
                }
            }
            if kind == None {
                diagnostics.push(sema_error("E0617", args_span ?? span,
                    "`.timeout` needs exactly one duration",
                    "the region must complete within a time budget, written as a duration value",
                    "write `.timeout(500ms) {{ … }}` or bind that value first (`ns`/`us`/`ms`/`s`/`min`/`h`/`d`)"))
            }
        }
        "measure" -> {
            if args.len() == 0 {
                kind = Val(TScopeMemberKind.Measure)
            } else {
                diagnostics.push(sema_error("E0617", args_span ?? span, "`.measure` takes no arguments", "`.measure` is a selection marker for the test measurement mode", "write `.measure {{ … }}`"))
            }
        }
        "skip" -> {
            if args.len() == {
                0 -> kind = Val(TScopeMemberKind.Skip)
                1 -> {
                    if args[0] == {
                        .Str(_, _, _) -> kind = Val(TScopeMemberKind.Skip)
                        else -> {}
                    }
                }
                else -> {}
            }
            if kind == None -> diagnostics.push(sema_error("E0617", args_span ?? span, "`.skip` takes at most one reason string", "`.skip` optionally records why the region is skipped", "write `.skip {{ … }}` or `.skip(\"reason\") {{ … }}`"))
        }
        else -> {}
    }
    nested := if name == "setup" -> sema_check_statements(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth) else -> sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "scope-member@{span.start}", loop_depth)
    if !nested.complete || kind == None -> return None
    member: kind ?? return None
    Val(TStmt.ScopeMember{kind: member, body: nested.value, span: span})
}

sema_stmt_check_shared_transaction: fn(transaction: Stmt, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    if transaction == {
        .Transact(_, _, body, _, span) -> sema_stmt_check_transaction(None, None, body, true, span, environment, program, scopes, state, tail_store, context, diagnostics)
        else -> None
    }
}

sema_stmt_check_shared_place_assignment: fn(handle: Expr, target: LValue, op: BinOp?, op_span: Span, expr: Expr, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    needs_transaction := sema_shared_access_expr_touches_shared(expr, scopes)
    value := expr
    body := [Stmt]{}
    if needs_transaction {
        binding := ast_binding(SEMA_SHARED_HOISTED_RHS, expr_span(expr), false, expr, None)
        body.push(Stmt.Val{binding: binding})
        value = Expr.Ident{name: SEMA_SHARED_HOISTED_RHS, span: expr_span(expr), id: AST_NODE_GENERATED}
    }
    rewritten_expr: sema_shared_access_desugar_place_write(handle, target, op, op_span, value, span)
    if needs_transaction {
        body.push(Stmt.Expr{expr: rewritten_expr})
        transaction_span := Span{start: span.start, end: expr_span(expr).end}
        transaction := Stmt.Transact{name: None, name_span: None, body: body, implicit: true, span: transaction_span}
        return sema_stmt_check_shared_transaction(transaction, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    checked: sema_check_expression(rewritten_expr, Val(Type.Named{name: "Unit"}), environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    Val(TStmt.ExprStmt{value: checked, span: expr_span(rewritten_expr)})
}

sema_stmt_check_assignment_place: fn(target: LValue, compound: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if target == {
        .Field(base, member, span) -> {
            // Rust `check_stmt` (LValue::Field): a plain assignment writes the
            // field, so its base answers only for a move of the whole name
            // (`env.graph = None` after `env.graph.move()`).
            previous_root_read: context.suppress_partial_move_root_read
            if !compound -> context.suppress_partial_move_root_read = true
            checked_base_value: sema_check_expression(base, None, environment, program, scopes, state, tail_store, context, diagnostics)
            context.suppress_partial_move_root_read = previous_root_read
            checked_base: checked_base_value ?? return None
            // (Rust `check_stmt` dyn_write_path): a Dyn
            // member write is a path step, not a field of a nominal owner.
            if sema_dyn_is_type(sema_expr_expected_type(checked_base.ty, environment, program)) {
                if sema_dyn_is_member(member) {
                    diagnostics.push(sema_dyn_member_error(member, span))
                    return None
                }
                key: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: member}}}, span)
                operation: THandleOp.DynIndexKey{site: "{sema_dyn_site(base)}.{member}", location: sema_expression_panic_location(environment, program, scopes, span)}
                return Val(sema_tree_node(sema_dyn_type(), TExprKind.HandleMethod{receiver: checked_base, operation: operation, args: [TExpr]{key}}, span))
            }
            return sema_expression_field_checked(checked_base, member, span, None, environment, program, scopes, context, diagnostics)
        }
        .Index(base, index, span, kind) -> sema_expression_index(base, index, kind, span, None, environment, program, scopes, state, tail_store, context, diagnostics)
        else -> None
    }
}

sema_stmt_is_dyn_index: fn(operation: THandleOp) -> Bool Never! {
    if operation == {
        .DynIndexKey(_, _) | .DynIndexAt(_, _) -> true
        else -> false
    }
}

// Collect the access chain without materializing intermediate Dyn copies:
// the runtime setter walks the original root place and never grows prefixes.
sema_stmt_dyn_path_root: fn(place: &&TExpr, keys: &[Bool], steps: &[TExpr]) -> TExpr Never! {
    if place.kind == .HandleMethod(receiver, operation, args) {
        if operation == {
            .DynIndexKey(_, _) | .DynIndexAt(_, _) -> {
                root: sema_stmt_dyn_path_root(receiver, keys, steps)
                keys.push(if operation == {.DynIndexKey(_, _) -> true else -> false})
                steps.push(args[0])
                return root
            }
            else -> {}
        }
    }
    place
}

sema_stmt_check_projected_assignment: fn(target: LValue, op: BinOp?, op_span: Span, expr: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    exit_diagnostics: diagnostics.len()
    exit_reasons: context.incomplete_reasons.len()
    // Keep nested fields and indexes below the cell inside its locked edit.
    projected := sema_shared_access_write_place(target, environment, program, scopes)
    if projected == .Val(place) -> return sema_stmt_check_shared_place_assignment(place.handle, place.target, op, op_span, expr, place.span, environment, program, scopes, state, tail_store, context, diagnostics)
    if target == {
        .Index(_, _, span, _) -> {
            if op != None {
                operator: op
                diagnostics.push(sema_error("E0164", span, "compound assignment can't target an indexed slot.", "a compound update reads an indexed slot before it writes; that read can panic when a map key is missing.", "write a total update, such as `map[key] = (map.get(key) ?? 0) {sema_expr_binary_name(operator)} 1`"))
                return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "projected_assignment exit 1")
            }
        }
        else -> {}
    }
    // `base[key] = value` on a type with an `Index` impl is its `IndexMut`
    // `set(key, value)`.
    if target == .Index(hook_base, hook_index, hook_span, _) {
        if sema_stmt_return_known_type(hook_base, environment, scopes) == .Val(hook_ty) {
            if sema_expression_index_hook(environment, program, hook_ty, "Index") {
                if !sema_expression_index_hook(environment, program, hook_ty, "IndexMut") {
                    shown: type_name(hook_ty)
                    diagnostics.push(sema_error("E0505", hook_span, "`{shown}` can be read with `[ ]` but not written — it has no `IndexMut` impl", "bracket assignment needs `impl Type.IndexMut {{ set: fn(&self, k, v) }}` with the write-access marker `&`", "use `.set(key, value)` instead, or add `impl {shown}.IndexMut`"))
                    return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "projected_assignment index hook")
                }
                receiver: Expr.Place{value: hook_base, access: PlaceAccess.Write, span: expr_span(hook_base), id: AST_NODE_GENERATED}
                call: sema_expression_index_hook_call(receiver, "set", [Expr]{hook_index, expr}, hook_span)
                checked: sema_check_expression(call, Val(Type.Named{name: "Unit"}), environment, program, scopes, state, tail_store, context, diagnostics) ?? return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "projected_assignment index hook set")
                return Val(TStmt.ExprStmt{value: checked, span: Span{start: hook_span.start, end: expr_span(expr).end}})
            }
        }
    }
    // Swizzle write: `v.yx = value` on a Core vector or swizzleable lane
    // type is the declaration's own `__swizzle_setN(lanes…, value)` on the
    // written place; `v.xy += value` writes `v.xy + value`.
    if target == .Field(swizzle_base, member, swizzle_span) && sema_stmt_swizzle_member(member) {
        vector: sema_stmt_swizzle_base_vector(swizzle_base, environment, program, scopes, state, tail_store, context, diagnostics)
        if vector == .Val(vector_name) {
            parsed: sema_expression_math_swizzle_parse(vector_name, member, swizzle_span, diagnostics)
            if parsed == .InvalidLane -> return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "projected_assignment swizzle lane")
            if parsed == .Lanes(packed, count, overlaps) {
                if overlaps {
                    root: sema_expr_place_root_ident(swizzle_base) ?? "v"
                    diagnostics.push(sema_error("E3111", swizzle_span, "write swizzle `{member}` repeats a lane on `{vector_name}`", "each lane may be written at most once — overlapping patterns like `v.xx` have no single meaning", "assign each lane once, e.g. `{root}.xy = …` instead of `{root}.{member} = …`"))
                    return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "projected_assignment swizzle overlap")
                }
                value: if op == .Val(operator) -> Expr.Binary{op: operator, left: Expr.Field{base: swizzle_base.copy(), member: member, span: swizzle_span, id: AST_NODE_GENERATED}, right: expr, span: Span{start: swizzle_span.start, end: expr_span(expr).end}, id: AST_NODE_GENERATED} else -> expr
                args := [CallArg]{}
                loop index in 0..<count {
                    lane: (packed >> (index * 2)).bit_and(3)
                    args.push(CallArg{convention: AccessConvention.Read, expr: Expr.Int{value: lane, span: swizzle_span, width: None, raw: None, id: AST_NODE_GENERATED}, span: swizzle_span, flags: ast_empty_call_arg_flags(), label: None, spread: false})
                }
                value_span: expr_span(value)
                args.push(CallArg{convention: AccessConvention.Read, expr: value, span: value_span, flags: ast_empty_call_arg_flags(), label: None, spread: false})
                receiver: Expr.Place{value: swizzle_base, access: PlaceAccess.Write, span: expr_span(swizzle_base), id: AST_NODE_GENERATED}
                call: Expr.MethodCall{receiver: receiver, method: "__swizzle_set{count}", method_span: swizzle_span, owner_type_args: [Type]{}, type_args: [Type]{}, args: args, id: AST_NODE_GENERATED}
                checked: sema_check_expression(call, Val(Type.Named{name: "Unit"}), environment, program, scopes, state, tail_store, context, diagnostics) ?? return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "projected_assignment swizzle set")
                return Val(TStmt.ExprStmt{value: checked, span: Span{start: swizzle_span.start, end: value_span.end}})
            }
        }
    }
    // E1108: `xs[i].field = …` on a columnar list would write a
    // gathered copy, not the column.
    if target == .Field(field_base, field, field_span) && field_base == .Index(indexed_base, _, _, _, _) && sema_stmt_for_in_expr_root_ident(indexed_base) == .Val(root) {
        root_type: sema_stmt_return_known_type(Expr.Ident{name: root, span: field_span, id: AST_NODE_GENERATED}, environment, scopes)
        if root_type == .Val(root_ty) && sema_columnar_list_element(environment, program, root_ty) == .Val(element) {
            diagnostics.push(sema_error("E1108", field_span, "writing `{root}[i].{field}` isn't supported on a columnar list yet", "`#Layout(columnar)` lists support reading a field (`xs[i].f`) in v1; writing one is deferred", "drop `#Layout(columnar)` from `{element}` to write fields in place, or rebuild the element with `push`"))
            return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "projected_assignment exit 2")
        }
    }
    place_diagnostics: diagnostics.len()
    place_reasons: context.incomplete_reasons.len()
    place: sema_stmt_check_assignment_place(target, op != None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
        if !sema_has_error_since(diagnostics, place_diagnostics) && context.incomplete_reasons.len() == place_reasons -> sema_check_unsupported(context, "the assignment place at offset {op_span.start} checked to no place without a report")
        return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "projected_assignment exit 3")
    }
    // A computed field has no storage to assign. This is
    // decided before the place's mutability, so it is the one report.
    write: if op == None -> "assigned" else -> "updated"
    if sema_expression_refuse_computed_place(place, write, environment, program, scopes, diagnostics) -> return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "projected_assignment computed field")
    // A stored view field keeps the owner relationship it was constructed
    // with; assigning it a new view would change that public provenance.
    if target == .Field(_, view_field, view_field_span) && program.registration_graph == .Val(view_graph) {
        seen := [String:Bool]{}
        if sema_check_type_contains_view(view_graph, environment.module_identity, place.ty, seen) {
            diagnostics.push(sema_error("E2305", view_field_span, "view field `{view_field}` cannot be assigned a new source", "a stored view field has one stabilized owner relationship; overwriting it would erase or change that public provenance", "construct a new value with the new view, or keep the original field source unchanged"))
            return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "projected_assignment view field")
        }
    }
    // This rule on a field of a local: the type of the place just checked
    // decides the route, so the field expression is checked once.
    hooked: sema_stmt_compound_field_hook_value(target, op, op_span, expr, place.ty)
    if hooked == .Val(binary) -> return sema_stmt_check_place_assignment(target, place, None, op_span, binary, environment, program, scopes, state, tail_store, context, diagnostics)
    sema_stmt_check_place_assignment(target, place, op, op_span, expr, environment, program, scopes, state, tail_store, context, diagnostics)
}

// A field name that spells a swizzle: one to four of x, y, z and w.
sema_stmt_swizzle_member: fn(member: String) -> Bool Never! {
    if member.len() == 0 || member.len() > 4 -> return false
    loop byte in member.bytes() {
        code: Int.from_u8(byte)
        if code != 120 && code != 121 && code != 122 && code != 119 -> return false
    }
    true
}

// The Core vector or swizzleable lane type (`Vec3`, `F64x2`) a swizzle
// write's base is, probed without keeping the check.
sema_stmt_swizzle_base_vector: fn(base: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> String? {
    probed: sema_expr_probe_type(base, false, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    sema_expression_core_vector_name(probed, environment, program)
}

// An index or field write whose path passes through a `ViewMut` or `Pin`
// value edits the window's owner, not the carrier: `borrowed.values[0] = 3`
// with `values: ViewMut<Int>`, or `pinned.hops += 1` with `pinned: Pin<Node>`,
// needs no write marker on the carrier.
sema_stmt_place_writes_through_view: fn(place: TExpr) -> Bool Never! {
    if place.kind == {
        .Index(base, _, _, _, _, _) | .Field(base, _) -> {
            if sema_pin_target(base.ty) != None -> return true
            if sema_expr_unwrap_tag(base.ty) == .Apply(name, _) {
                if name == "ViewMut" -> return true
            }
            sema_stmt_place_writes_through_view(base)
        }
        else -> false
    }
}

// The write of `expr` (combined by `op`) through the checked `place` of `target`.
sema_stmt_check_place_assignment: fn(target: LValue, checked_place: &&TExpr, op: BinOp?, op_span: Span, expr: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    exit_diagnostics: diagnostics.len()
    exit_reasons: context.incomplete_reasons.len()
    place := checked_place.move()
    // (Rust `check_stmt` __dyn_set_path): a plain write
    // through a Dyn member/index chain sets the path on the root in place.
    if place.kind == .HandleMethod(_, operation, _) && sema_stmt_is_dyn_index(operation) {
        if op != None {
            diagnostics.push(sema_error("E0164", place.span, "compound assignment can't target a Dyn path", "a compound update reads the path before it writes", "write the Dyn path assignment explicitly"))
            return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 12")
        }
        keys := [Bool]{}
        steps := [TExpr]{}
        span: place.span.copy()
        site: if operation == {
            .DynIndexKey(text, _) | .DynIndexAt(text, _) -> text
            else -> "…"
        }
        root: sema_stmt_dyn_path_root(place, keys, steps)
        checked: sema_check_expression(expr, Val(sema_dyn_type()), environment, program, scopes, state, tail_store, context, diagnostics) ?? return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 8")
        if sema_copy_site_check_assignment(expr, environment, program, scopes, context, diagnostics) -> return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 1")
        if !sema_ownership_check_lvalue_write(state, target, scopes, diagnostics) -> return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 2")
        if !sema_stmt_move_direct(expr, state, scopes, "the assignment", diagnostics) -> return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 3")
        steps.push(checked)
        set: THandleOp.DynSetPath{keys: keys, site: site, location: sema_expression_panic_location(environment, program, scopes, span)}
        value: sema_tree_node(Type.Named{name: "Unit"}, TExprKind.HandleMethod{receiver: root, operation: set, args: steps}, span)
        return Val(TStmt.ExprStmt{value: value, span: Span{start: span.start, end: expr_span(expr).end}})
    }
    // E0362: a compound operator hook on a field below a nested owner has no
    // operator-place lowering.
    if op != None && target == .Field(field_base, _, field_span) {
        if sema_stmt_compound_nested_hook(op, field_base, place.ty, environment, program) {
            diagnostics.push(sema_error("E0362", field_span, "compound assignment can't target a nested operator field", "the current operator-place lowering supports one named owner and one field", "bind the inner value, update it, then assign the whole inner value back"))
            _ := sema_check_expression(expr, Val(place.ty), environment, program, scopes, state, tail_store, context, diagnostics)
            return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 13")
        }
    }
    if target == .Index(index_base, _, index_span, _) && place.kind == .Index(checked_base, _, _, _, _, _) {
        if sema_columnar_list_element(environment, program, checked_base.ty) == .Val(element) {
            diagnostics.push(sema_error("E1108", index_span, "writing through `[ ]` isn't supported on a columnar list `{sema_type_show(sema_expr_unwrap_tag(checked_base.ty))}` yet", "`#Layout(columnar)` lists support reading in v1 (indexing, field access, `len`, `is_empty`, `push`, iteration); index-write is deferred", "drop `#Layout(columnar)` from `{element}` to assign through `[ ]`, or rebuild the list with `push`"))
            return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 14")
        }
        if sema_stmt_index_write_is_collection(checked_base.ty) && sema_expr_place_root_ident(index_base) == .Val(root) && context.iter_borrowed.contains(root) {
            diagnostics.push(sema_collection_changed_in_loop(root, "a mutation of `{root}`", index_span))
        }
    }
    expected := Type?{None}
    plain_self_typed: op == None && sema_stmt_numeric_slot_self_typed(expr, place.ty)
    if op == None && !plain_self_typed -> expected = Val(place.ty)
    // Same compound contract as `sema_stmt_check_local_assignment`.
    if op != None && sema_expr_decimal_literal_operand(expr, true) && sema_expr_expects_machine_float(Val(place.ty)) -> expected = Val(place.ty)
    value_diagnostics: diagnostics.len()
    value_reasons: context.incomplete_reasons.len()
    checked_value_or: sema_check_expression(expr, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if op == None -> sema_stmt_field_write_mismatch(target, place.ty, expr, value_diagnostics, environment, program, scopes, state, tail_store, context, diagnostics)
    checked_value: checked_value_or ?? {
        if !sema_has_error_since(diagnostics, value_diagnostics) && context.incomplete_reasons.len() == value_reasons -> sema_check_unsupported(context, "the assigned value at offset {expr_span(expr).start} checked to no value without a report")
        return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 15")
    }
    if !sema_copy_site_check_guard_owned(checked_value, environment, program, scopes, state, context, diagnostics, false) -> return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 4")
    if op == None && !sema_copy_site_refuse_borrowed_copy(expr, "the assignment", environment, program, scopes, context, diagnostics) -> return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 4")
    checked := checked_value
    if op != None && sema_stmt_compound_widens(checked, place.ty) {
        widen_line: sema_source_line_at(environment.source_segments, checked.span) ?? 0
        checked = sema_expr_numeric_literal_conversion(checked, place.ty, checked.span, widen_line, diagnostics) ?? return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 9")
    }
    if plain_self_typed -> checked = sema_stmt_numeric_slot_value(checked, place.ty, environment, program, diagnostics) ?? return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 10")
    if op == None && sema_copy_site_check_assignment(expr, environment, program, scopes, context, diagnostics) -> return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 5")
    tree_op := TBinaryOp?{None}
    if op != None {
        operator: op
        // (Rust `check_stmt` `compound_missing_struct_hook`) A record place
        // whose type implements no hook for this operator has no arithmetic.
        if sema_stmt_compound_missing_struct_hook(operator, place.ty, environment, program) {
            diagnostics.push(sema_expr_missing_operator_hook(operator, place.ty, op_span))
            return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 11")
        }
        result: sema_stmt_compound_result(operator, place.ty, checked.ty, expr, op_span, scopes, diagnostics) ?? return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 11")
        if !sema_type_assignable(place.ty, result) {
            diagnostics.push(if target == .Field(_, member, _) -> sema_slot_holds_mismatch("field `{member}`", "field", place.ty, result, op_span) else -> sema_type_mismatch(place.ty, result, op_span))
            return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 16")
        }
        tree_op = Val(sema_stmt_binary_type(operator))
    }
    sema_ownership_release_value_only_views(state, target, tail_store, context)
    if !sema_ownership_check_lvalue_write_as(state, target, !sema_stmt_place_writes_through_view(place), scopes, diagnostics) -> return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 6")
    if !sema_stmt_move_direct(expr, state, scopes, "the assignment", diagnostics) -> return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 7")
    // A compound update under an `#Arithmetic` policy reads the place as a
    // value (sema_stmt_policy_compound), before it becomes the write.
    read := TExpr?{None}
    if op != None -> read = Val(place.copy())
    if place.kind == {
        .Index(base, index, kind, _, checked_call, location) -> place.kind = TExprKind.Index{base: base, index: index, kind: kind, access: AccessConvention.Write, checked_call: checked_call, location: location}
        else -> {}
    }
    line: sema_source_line_at(environment.source_segments, place.span) ?? {
        sema_check_unsupported(context, "the assignment place span {place.span.start}..{place.span.end} has no source line in this module")
        return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "place_assignment exit 17")
    }
    assign_span: Span{start: place.span.start, end: expr_span(expr).end}
    assigned := checked
    if op != None {
        operator: op
        if read == .Val(current) && sema_stmt_policy_compound(operator, place.ty, current, checked, line, assign_span, context) == .Val(policed) {
            assigned = policed
            tree_op = None
        }
    }
    Val(TStmt.Assign{place: TPlace.Expr{value: place}, op: tree_op, value: assigned, line: line, span: assign_span})
}

// A plain field write whose value doesn't fit the field reports about the
// field, with the value's own type inferred without the field as a target.
sema_stmt_field_write_mismatch: fn(target: LValue, required: Type, value: Expr, diagnostic_start: Int, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) {
    if target == .Field(_, member, _) {
        value_span: expr_span(value)
        mismatch_index: sema_value_mismatch_index(diagnostics, diagnostic_start, value_span) ?? return
        probe_diagnostics := [Diagnostic]{}
        offered: sema_probe_expression(value, None, environment, program, scopes, state, tail_store, context, probe_diagnostics) ?? return
        diagnostics[mismatch_index] = sema_slot_holds_mismatch("field `{member}`", "field", sema_expr_expected_type(required, environment, program), sema_expr_expected_type(offered.ty, environment, program), value_span)
    }
}

// A compound update `place op= value` of a fixed-width integer under the
// function's `#Arithmetic` policy, for + - * **: `place = OverflowOpt(read,
// value)`, the policy's operation exactly as the binary form lowers it
// (Expressions.jet sema_expr_check_binary, sema_expr_arithmetic_policy_value).
// `read` is the place read as a value. None outside a policy, for any other
// operator or type, and for a place whose second read could differ from the
// first (a call on its path); those keep the compound form, which JetIR
// checks for overflow (BuildTypes ir_assign_overflow).
sema_stmt_policy_compound: fn(op: BinOp, ty: Type, read: TExpr, value: TExpr, line: Int, span: Span, context: SemaCheckContext) -> TExpr? {
    if (op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Pow) && ty == .IntN(_, _) && sema_stmt_pure_place(read, context) && context.arithmetic_policy == .Val(policy) {
        operation: if op == {
            .Add -> ArithmeticOperation.Add
            .Sub -> ArithmeticOperation.Sub
            .Mul -> ArithmeticOperation.Mul
            else -> ArithmeticOperation.Pow
        }
        return Val(sema_expr_arithmetic_policy_value(policy, operation, ty, span, line, read, value))
    }
    None
}

// Whether reading the place `place` again yields what the first read did:
// locals, constants and literals, and fields and plain indexes of them.
sema_stmt_pure_place: fn(place: TExpr, context: SemaCheckContext) -> Bool {
    if place.kind == {
        .Local(_) | .IntLit(_, _) -> return true
        .Flat(index) -> return if context.arena.tree.nodes[index - context.arena.tree.node_base].kind == {
            .BoolLit(_) | .ConstRef(_) -> true
            else -> false
        }
        .Field(receiver, _) -> return sema_stmt_pure_place(receiver, context)
        .Index(base, index, _, _, checked_call, _) -> return checked_call == None && sema_stmt_pure_place(base, context) && sema_stmt_pure_place(index, context)
        .Binary(_, _, _, lhs, rhs) -> return sema_stmt_pure_place(lhs, context) && sema_stmt_pure_place(rhs, context)
        .Unary(_, operand) -> return sema_stmt_pure_place(operand, context)
        else -> return false
    }
}

sema_stmt_compound_nested_hook: fn(op: BinOp, base: Expr, field_ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    trait_name: sema_expr_operator_trait(op) ?? return false
    if !owned_trait_arithmetic(trait_name) -> return false
    if field_ty == {
        .Int | .Float | .IntN(_, _) | .Float32 -> return false
        else -> {}
    }
    if !sema_comparability_implements(environment, program, field_ty, trait_name) -> return false
    if base == {
        .Ident(_, _, _) -> false
        .Index(_, _, _, _, _) -> if field_ty == {
            .Named(_) | .Apply(_, _) -> true
            else -> false
        }
        else -> true
    }
}

sema_stmt_compound_missing_struct_hook: fn(op: BinOp, place: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    if op != BinOp.Add && op != BinOp.Sub && op != BinOp.Mul && op != BinOp.Div -> return false
    trait_name: sema_expr_operator_trait(op) ?? return false
    if !sema_stmt_compound_nominal(place) -> return false
    if program.registration_graph == .Val(graph) {
        row: sema_type_resolve_nominal_row(graph, place, environment.module_identity) ?? return false
        if graph.modules[row.module_index].nominals[row.row].kind != SemaRegistrationNominalKind.Struct -> return false
        return !sema_comparability_implements(environment, program, place, trait_name)
    }
    false
}

// (Rust `check_stmt`): compound arithmetic is the same operator as
// its binary form, so on a place whose type has no built-in arithmetic (a
// nominal type: an operator-hook struct such as `Vec3`, a time, unit,
// geometry or distinct carrier) `place op= value` checks as
// `place = place op value` and the checked tree sees one binary spine. The binary check
// then resolves the hook or reports E0360 at the operator, as Rust's
// missing-hook report does. Numbers, exact numbers and `String +=` keep the
// compound route. Only a local or a field of a local qualifies: a nominal
// field below an index keeps E0362, and an indexed slot keeps E0164.
sema_stmt_compound_hook_operator: fn(op: BinOp?) -> BinOp? Never! {
    operator: op ?? return None
    if operator != BinOp.Add && operator != BinOp.Sub && operator != BinOp.Mul && operator != BinOp.Div -> return None
    Val(operator)
}

// A local reads its binding's declared type.
sema_stmt_compound_hook_value: fn(target: LValue, op: BinOp?, op_span: Span, expr: Expr, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> Expr? {
    operator: sema_stmt_compound_hook_operator(op) ?? return None
    if target == .Local(name, name_span) {
        index: sema_scope_resolve_index(scopes, name) ?? return None
        place_ty: sema_scope_binding_row(environment, scopes, index).symbol.ty ?? return None
        if !sema_stmt_compound_hooked_place(place_ty) -> return None
        return Val(Expr.Binary{op: operator, left: Expr.Ident{name: name, span: name_span, id: AST_NODE_GENERATED}, right: expr, span: op_span, id: AST_NODE_GENERATED})
    }
    None
}

// A field of a local reads the type of the place the projected assignment
// already checked (`sema_stmt_check_projected_assignment`).
sema_stmt_compound_field_hook_value: fn(target: LValue, op: BinOp?, op_span: Span, expr: Expr, place_ty: Type) -> Expr? {
    operator: sema_stmt_compound_hook_operator(op) ?? return None
    if target == .Field(base, field, span) {
        if base == .Ident(_, _, _) && sema_stmt_compound_hooked_place(place_ty) -> return Val(Expr.Binary{op: operator, left: Expr.Field{base: base, member: field, span: span, id: AST_NODE_GENERATED}, right: expr, span: op_span, id: AST_NODE_GENERATED})
    }
    None
}

sema_stmt_compound_nominal: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Named(_) | .Apply(_, _) -> true
        else -> false
    }
}

sema_stmt_compound_hooked_place: fn(ty: Type) -> Bool {
    sema_stmt_compound_nominal(ty) && !sema_expr_is_numeric(ty) && sema_expr_precise_name(ty) == None && ty != Type.String
}

// A silent exit of an assignment check: when nothing since `diagnostics`/
// `reasons` explains it, record which exit it was, so a collect-all census
// names the step instead of the generic assignment report.
sema_stmt_assign_exit: fn(context: &SemaCheckContext, diagnostics: [Diagnostic], diagnostics_start: Int, reasons_start: Int, label: String) -> TStmt? {
    if !sema_has_error_since(diagnostics, diagnostics_start) && context.incomplete_reasons.len() == reasons_start -> sema_check_unsupported(context, "assignment: {label} without a report")
    None
}

sema_stmt_check_assignment: fn(target: LValue, op: BinOp?, op_span: Span, expr: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    diagnostics_before: diagnostics.len()
    reasons_before: context.incomplete_reasons.len()
    if op == None -> sema_stmt_lint_compound_assignment(target, op_span, expr, diagnostics)
    checked := sema_stmt_check_assignment_target(target, op, op_span, expr, environment, program, scopes, state, tail_store, context, diagnostics)
    sema_shared_cycle_check_write(target, expr, environment, program, scopes, state, diagnostics)
    // Collect-all: an assignment that checks to nothing names its step when
    // no error report or recorded reason already explains it.
    if checked == None && !sema_has_error_since(diagnostics, diagnostics_before) && context.incomplete_reasons.len() == reasons_before {
        sema_check_unsupported(context, "the assignment at offset {op_span.start} (value at offset {expr_span(expr).start}) checked to no statement without a report")
    }
    checked
}

// L0503: `place = place op value` restates the place a compound assignment
// names once. An indexed place stays expanded (its compound form is E0164).
sema_stmt_lint_compound_assignment: fn(target: LValue, op_span: Span, expr: Expr, diagnostics: &[Diagnostic]) {
    place := ""
    if target == {
        .Local(name, _) -> place = name
        .Field(base, field, _) -> {
            root: sema_stmt_compound_place_text(base) ?? return
            place = "{root}.{field}"
        }
        else -> return
    }
    value: sema_stmt_compound_unparen(expr)
    if value == .Binary(op, left, _, _, _) {
        if sema_stmt_compound_place_text(left) != (Val(place)) -> return
        op_text: sema_stmt_compound_op_text(op) ?? return
        diagnostics.push(sema_lint("L0503", op_span, "Prefer `{place} {op_text} …` instead of repeating the left side", "Compound assignment updates a place in one step without restating it", "Write `{place} {op_text} …`"))
    }
}

sema_stmt_compound_unparen: fn(expr: Expr) -> Expr Never! {
    if expr == .Paren(inner, _, _) -> return sema_stmt_compound_unparen(inner)
    expr.copy()
}

sema_stmt_compound_place_text: fn(expr: Expr) -> String? Never! {
    if expr == {
        .Ident(name, _, _) -> Val(name)
        .Field(base, member, _, _) -> {
            root: sema_stmt_compound_place_text(base) ?? return None
            Val("{root}.{member}")
        }
        .Paren(inner, _, _) -> sema_stmt_compound_place_text(inner)
        else -> None
    }
}

sema_stmt_compound_op_text: fn(op: BinOp) -> String? Never! {
    if op == {
        .Add -> Val("+=")
        .Sub -> Val("-=")
        .Mul -> Val("*=")
        .Div -> Val("/=")
        .FloorDiv -> Val("/%=")
        .Mod -> Val("%=")
        .Rem -> Val("%%=")
        .Shl -> Val("<<=")
        .Shr -> Val(">>=")
        else -> None
    }
}

sema_stmt_check_assignment_target: fn(target: LValue, op: BinOp?, op_span: Span, expr: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    exit_diagnostics: diagnostics.len()
    exit_reasons: context.incomplete_reasons.len()
    if sema_ownership_report_lending_view_escape(expr, "replace another value", scopes, context, diagnostics) -> return sema_stmt_assign_exit(context, diagnostics, exit_diagnostics, exit_reasons, "assignment_target exit 1")
    hooked: sema_stmt_compound_hook_value(target, op, op_span, expr, environment, scopes)
    if hooked == .Val(binary) -> return sema_stmt_check_assignment_target(target, None, op_span, binary, environment, program, scopes, state, tail_store, context, diagnostics)
    checked: if target == {
        .Local(name, name_span) -> sema_stmt_check_local_assignment(name, name_span, op, op_span, expr, environment, program, scopes, state, tail_store, context, diagnostics)
        .Field(_, _, _) -> sema_stmt_check_projected_assignment(target, op, op_span, expr, environment, program, scopes, state, tail_store, context, diagnostics)
        .Index(base, index, _, _) -> {
            // A plain `buf[i] = …` fills one slot of a fixed
            // `Type{ uninit }` list, so the base is not read while the
            // write is checked; the remaining slots stay unwritten.
            taken := SemaOwnershipUninitFact?{None}
            if op == None && base == .Ident(root, _, _) && sema_scope_resolve_index(scopes, root) == .Val(root_index) {
                taken = sema_ownership_uninit_take(state, scopes.bindings[root_index].symbol.id.key)
            }
            projected := sema_stmt_check_projected_assignment(target, op, op_span, expr, environment, program, scopes, state, tail_store, context, diagnostics)
            if taken == .Val(fact) -> sema_stmt_uninit_note_slot_write(state, fact, index)
            projected
        }
        else -> None
    }
    // An ExpiringSecret loan lives only while its `.with` callback runs.
    if op == None && checked == .Val(.Assign(_, _, value, _, _)) && sema_contains_expiring_secret_loan(value.ty) {
        diagnostics.push(sema_error("E0201", expr_span(expr), "an ExpiringSecret loan cannot replace an owned value", "the callback parameter is a temporary read-only loan that ends when `.with` returns", "use the loan inside the callback and assign only a non-secret result"))
    }
    checked
}

sema_stmt_check_loop_step: fn(step: Stmt, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    if step == {
        .Assign(target, op, op_span, expr) -> sema_stmt_check_assignment(target, op, op_span, expr, environment, program, scopes, state, tail_store, context, diagnostics)
        .Expr(expr) -> {
            value: sema_check_expression(expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
            if value.ty != (Type.Named{name: "Unit"}) -> return None
            return Val(TStmt.ExprStmt{value: value, span: expr_span(expr)})
        }
        else -> None
    }
}

// Leave a statement list: drop its lambda tail frames and its tail body (and
// any a nested list left; bodies are added and dropped in stack order, and no
// frame refers to one past its list) and, when it entered one source nesting
// level, that level.
sema_stmt_leave_statements: fn(context: &SemaCheckContext, tail_store: &SemaStatementTailStore, depth: Int, body_id: Int, nested: Bool) Never! {
    loop context.lambda_statement_tails.len() > depth -> _ := context.lambda_statement_tails.pop()
    loop tail_store.bodies.len() > body_id -> _ := tail_store.bodies.pop()
    if nested -> sema_leave_source_nesting(context)
}

sema_stmt_return_required_type: fn(return_type: Type?) -> Type Never! {
    return return_type ?? Type.Named{name: "Unit"}
}
sema_stmt_return_success_type: fn(return_type: Type?) -> Type Never! {
    required := sema_stmt_return_required_type(return_type)
    normalized := sema_expr_unwrap_tag(required)
    if normalized == {
        .Result(ok, _) -> return ok
        .Option(value) -> return value
        else -> return normalized
    }
}
sema_stmt_return_is_carrier: fn(return_type: Type?) -> Bool Never! {
    normalized := sema_expr_unwrap_tag(sema_stmt_return_required_type(return_type))
    if normalized == {
        .Result(_, _) | .Option(_) -> return true
        else -> return false
    }
}
sema_stmt_return_known_type: fn(value: Expr, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> Type? {
    if value == {
        .Paren(inner, _, _) | .Tainted(inner, _, _, _) | .Copy(inner, _, _) | .Place(inner, _, _, _) -> return sema_stmt_return_known_type(inner, environment, scopes)
        .Ident(name, _, _) -> {
            index: sema_scope_resolve_index(scopes, name) ?? return None
            return sema_scope_binding_type(environment, scopes, index)
        }
        .Call(call, _) -> {
            index: sema_scope_resolve_index(scopes, call.name) ?? return None
            symbol_type: sema_scope_binding_type(environment, scopes, index) ?? return None
            if symbol_type == {
                .Fn(_, ret, _, _, _, _) -> return ret
                else -> {}
            }
        }
        .CallValue(callee, _, _, _) -> {
            callee_ty: sema_stmt_return_known_type(callee, environment, scopes) ?? return None
            if callee_ty == {
                .Fn(_, ret, _, _, _, _) -> return ret
                else -> {}
            }
        }
        else -> return None
    }
    None
}
sema_stmt_return_types_are_carriers: fn(actual: Type, required: Type) -> Bool Never! {
    normalized_actual := sema_expr_unwrap_tag(actual)
    normalized_required := sema_expr_unwrap_tag(required)
    if normalized_required == {
        .Result(_, _) -> {
            if normalized_actual == {
                .Result(_, _) -> return true
                else -> {}
            }
        }
        .Option(_) -> {
            if normalized_actual == {
                .Option(_) -> return true
                else -> {}
            }
        }
        else -> {}
    }
    false
}
sema_stmt_return_expr_is_carrier: fn(value: Expr, return_type: Type?, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> Bool {
    if !sema_stmt_return_is_carrier(return_type) -> return false
    required := sema_stmt_return_required_type(return_type)
    normalized := sema_expr_unwrap_tag(required)
    if value == {
        .Paren(inner, _, _) | .Tainted(inner, _, _, _) | .Copy(inner, _, _) -> return sema_stmt_return_expr_is_carrier(inner, return_type, environment, scopes)
        // Rust `check_return_expr` checks a value `if` against the whole
        // return type. A `T?` slot lifts each plain arm itself, so any value
        // `if` there is checked as the carrier (an arm may be a bound `T?`
        // local, a `Val(x)`, a `None`, or a plain `x`). A `T !E` slot checks
        // the carrier when some decision level builds it and every other arm
        // already has the carrier's type (Rust lifts that table into the
        // carrier, so it is this body's own failure source); a table of plain
        // arms and calls takes the payload route, where each call propagates.
        .If(_, _, _, _, _, _, _) -> return normalized == .Option(_) || (sema_stmt_return_if_builds_carrier(value, return_type, environment, scopes) && sema_stmt_return_if_arms_fit_carrier(value, return_type, environment, scopes))
        else -> {}
    }
    if normalized == {
        .Result(_, error) -> {
            // Under `Never!` no failure exists to build, so `Err(...)` is the
            // default error value itself (an error conversion's result).
            failure_reachable: sema_expr_unwrap_tag(error) != Type.Named{name: "Never"}
            if value == {
                .Ok(_, _, _) -> return true
                .Err(_, _, _) -> return failure_reachable
                .EnumLit(owner, variant, _, args, dot, _, _) -> {
                    if owner == "" && dot && args.len() == 1 && args[0] == .Positional(_) {
                        if variant == "Ok" -> return true
                        if variant == "Err" -> return failure_reachable
                    }
                }
                else -> {}
            }
            // (Rust `check_return`): every direct call
            // but an unshadowed `Ok`/`Err` checks against the success slot, so
            // its failure propagates through the transparent carrier and the
            // payload is lifted into this carrier. Such a returned call is
            // never this body's own failure source, and a `T Never!` callee
            // meets a fallible slot.
            if value == {
                .Call(call, _) -> {
                    if (call.name == "Ok" || failure_reachable) && sema_expression_contextual_result_call(call, Val(required), scopes) != None -> return true
                    if failure_reachable && sema_call_default_err_candidate(call, Val(required), scopes) -> return true
                    if call.name != "Ok" && call.name != "Err" -> return false
                    if sema_scope_resolve_index(scopes, call.name) == .Val(index) {
                        if !sema_scope_binding_is_compiler_builtin(scopes.bindings[index], "Err") -> return false
                    }
                }
                .MethodCall(_, _, _, _, _, _, _) | .CallValue(_, _, _, _) -> return false
                else -> {}
            }
        }
        .Option(_) -> {
            if value == {
                // An optional chain always yields the `T?` carrier itself.
                .Present(_, _, _) | .Absent(_, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) -> return true
                .EnumLit(owner, variant, _, args, _, _, _) -> {
                    if owner == "" {
                        if variant == "None" && args.len() == 0 -> return true
                        if variant == "Val" && args.len() == 1 && args[0] == .Positional(_) -> return true
                    }
                }
                else -> {}
            }
        }
        else -> {}
    }
    known_type: sema_stmt_return_known_type(value, environment, scopes) ?? return false
    if sema_stmt_return_types_are_carriers(known_type, required) -> return true
    // A call root propagates its failure so a
    // `T? !E` callee (`T? Never!` included) meets a `T?` slot with its own
    // `T?` success, as Rust `check_return_expr` infers it against the slot.
    if normalized == .Option(_) && sema_expression_propagating_call(value, scopes) && sema_expr_unwrap_tag(known_type) == .Result(ok, _) -> return sema_expr_unwrap_tag(ok) == .Option(_)
    false
}
// A value `if` that builds the `T !E` carrier on some arm, through nested
// decision levels and grouping.
sema_stmt_return_if_builds_carrier: fn(value: Expr, return_type: Type?, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> Bool {
    if value == {
        .Paren(inner, _, _) | .Tainted(inner, _, _, _) | .Copy(inner, _, _) -> return sema_stmt_return_if_builds_carrier(inner, return_type, environment, scopes)
        .If(_, _, then_value, _, else_value, _, _) -> return sema_stmt_return_if_builds_carrier(then_value, return_type, environment, scopes) || sema_stmt_return_if_builds_carrier(else_value, return_type, environment, scopes)
        else -> {}
    }
    sema_stmt_return_expr_is_carrier(value, return_type, environment, scopes)
}
// Every arm of a value `if`, through nested decision levels and grouping, is
// a carrier or a direct call whose own result already is the carrier. The
// missing `else` of a covered table never runs, so it fits any slot.
sema_stmt_return_if_arms_fit_carrier: fn(value: Expr, return_type: Type?, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> Bool {
    if value == {
        .Paren(inner, _, _) | .Tainted(inner, _, _, _) | .Copy(inner, _, _) -> return sema_stmt_return_if_arms_fit_carrier(inner, return_type, environment, scopes)
        .If(_, _, then_value, _, else_value, _, _) -> return sema_stmt_return_if_arms_fit_carrier(then_value, return_type, environment, scopes) && sema_stmt_return_if_arms_fit_carrier(else_value, return_type, environment, scopes)
        .NoElse(_, _) -> return true
        else -> {}
    }
    if sema_stmt_return_expr_is_carrier(value, return_type, environment, scopes) -> return true
    if !sema_expression_propagating_call(value, scopes) -> return false
    known_type: sema_stmt_return_known_type(value, environment, scopes) ?? return false
    required: sema_stmt_return_required_type(return_type)
    // A `T Never!` call has no failure to bring into a fallible carrier, so
    // Rust lifts it like a plain arm (`check_return_expr`).
    if sema_stmt_type_is_fallible_result(required) && !sema_stmt_type_is_fallible_result(known_type) -> return false
    sema_stmt_return_types_are_carriers(known_type, required)
}
// A value `if` in a `T !E` slot that builds the carrier on some arm while
// another arm is a plain success value (`.Int(_) -> Val(n)` beside
// `else -> Err(…)`). Rust `check_return_expr` infers the table against the
// whole carrier and lifts each plain arm into it through `Ok`.
sema_stmt_return_if_mixes_carrier: fn(value: Expr, return_type: Type?, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> Bool {
    if !sema_stmt_return_type_is_result(Val(sema_expr_unwrap_tag(sema_stmt_return_required_type(return_type)))) -> return false
    if value == {
        .Paren(inner, _, _) -> return sema_stmt_return_if_mixes_carrier(inner, return_type, environment, scopes)
        .If(_, _, _, _, _, _, _) -> return sema_stmt_return_if_builds_carrier(value, return_type, environment, scopes) && !sema_stmt_return_if_arms_fit_carrier(value, return_type, environment, scopes)
        else -> return false
    }
}
// The table with every plain arm that reaches the merge written as `Ok(arm)`.
sema_stmt_return_lift_if_arms: fn(value: Expr, return_type: Type?, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> Expr {
    if value == {
        // copy: `inner` is a payload of read parameter `value`, which keeps the original; the new Expr.Paren owns the lifted one
        .Paren(inner, span, node) -> return Expr.Paren{value: sema_stmt_return_lift_if_arms(inner.copy(), return_type, environment, scopes), span: span, id: node}
        .If(cond, then_body, then_value, else_body, else_value, span, node) -> {
            then_lifted: sema_stmt_return_lift_arm(then_body, then_value, return_type, environment, scopes)
            else_lifted: sema_stmt_return_lift_arm(else_body, else_value, return_type, environment, scopes)
            // copy: `cond` and the arm bodies are payloads of read parameter `value`, which keeps the originals; the new Expr.If owns these
            return Expr.If{cond: cond.copy(), then_body: then_body.copy(), then_value: then_lifted, else_body: else_body.copy(), else_value: else_lifted, span: span, id: node}
        }
        // copy: the returned Expr is a new owned value; read parameter `value` keeps the original
        else -> return value.copy()
    }
}
sema_stmt_return_lift_arm: fn(body: [Stmt], value: Expr, return_type: Type?, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> Expr {
    nested: if value == {
        .If(_, _, _, _, _, _, _) -> true
        .Paren(inner, _, _) -> inner == .If(_, _, _, _, _, _, _)
        else -> false
    }
    if nested -> return sema_stmt_return_lift_if_arms(value, return_type, environment, scopes)
    diverges: sema_stmt_block_has_no_fallthrough(body) || (body.len() > 0 && sema_stmt_definitely_returns(body[body.len() - 1]))
    placeholder: if value == {
        .NoElse(_, _) | .Todo(_, _, _) -> true
        else -> false
    }
    plain: !diverges && !placeholder && !sema_stmt_return_if_arms_fit_carrier(value, return_type, environment, scopes)
    // copy: the arm value is a payload of the caller's read table, which keeps the original; the result owns this one
    if !plain -> return value.copy()
    // copy: as above; the new Expr.Ok owns the lifted arm value
    Expr.Ok{value: value.copy(), span: expr_span(value), id: AST_NODE_GENERATED}
}
sema_stmt_check_return_value: fn(value: Expr, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    diagnostic_start: diagnostics.len()
    checked: sema_stmt_check_return_value_typed(value, return_type, environment, program, scopes, state, tail_store, context, diagnostics)
    if checked == None -> sema_stmt_value_return_mismatch(value, return_type, diagnostic_start, environment, program, scopes, state, tail_store, context, diagnostics)
    checked
}

// L0533: a returned call of a function of this module is a
// tail call, which reuses the caller's frame (JetIR TailCalls.jet). A value
// with a Close cleanup that is still open in the function (a live owner, or
// one a `defer close` takes at scope exit) closes after the call returns, so
// the call keeps its frame; name each one.
sema_stmt_lint_blocked_tail_call: fn(span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, state: SemaOwnershipState, diagnostics: &[Diagnostic]) Never! {
    frames := [Int]{}
    frame := scopes.current
    loop frame > 0 && frame < scopes.frames.len() {
        frames.push(frame)
        if scopes.frames[frame].owner.starts_with("lambda@") -> break
        frame = scopes.frames[frame].parent
    }
    named := [String]{}
    loop binding in scopes.bindings {
        if !frames.contains(binding.frame) || named.contains(binding.symbol.id.key) || binding.symbol.id.key == state.close_receiver_key -> next
        owned: binding.symbol.kind == SymbolKind.Local || (binding.symbol.kind == SymbolKind.Parameter && binding.access == AccessConvention.Move)
        if !owned -> next
        if binding.symbol.ty == .Val(ty) {
            if !sema_ownership_type_owns_close(ty, environment, program) -> next
            deferred := false
            moved := false
            loop entry in state.moved {
                if entry.place.root_key != binding.symbol.id.key || entry.place.projections.len() != 0 -> next
                if entry.origin.deferred_depth == None -> moved = true else -> deferred = true
            }
            if moved -> next
            named.push(binding.symbol.id.key)
            name: binding.symbol.name
            closes: if deferred -> "its `defer close` runs" else -> "its Close implementation runs"
            diagnostics.push(sema_lint("L0533", span, "This tail call can't reuse the frame because `{name}` closes after it returns", "`{name}` is a `{type_name(ty)}` that is still open here, and {closes} when its scope ends, after this call returns; the call keeps its frame, so a chain of such calls grows the stack", "Close `{name}` before the call with `close({name})` (bind any argument that reads it first), or open it in a smaller block that ends before the call"))
        }
    }
}

// Whether `value` calls a function of this module by its name.
sema_stmt_returns_module_call: fn(value: Expr, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> Bool Never! {
    if value == {
        .Paren(inner, _, _) -> return sema_stmt_returns_module_call(inner, environment, scopes)
        .Call(call, _) -> {
            symbol: sema_scope_resolve(scopes, call.name) ?? return false
            return symbol.kind == SymbolKind.Function && symbol.module_name == environment.module_identity
        }
        else -> return false
    }
}

// A returned value (a `return` or a value tail) with its ownership and view
// obligations: the value moves out and its views must outlive the call.
sema_stmt_check_returned_value: fn(value: Expr, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if sema_ownership_report_lending_view_escape(value, "be returned", scopes, context, diagnostics) {
        // Rust `check_return` still runs the view-return check on the lent
        // view, whose loan names no stable owner (E2305).
        if sema_stmt_return_success_is_view(return_type) {
            declared: return_type ?? return None
            success: if declared == .Result(ok, _) -> ok else -> declared
            access: sema_stmt_view_access(success) ?? AccessConvention.Read
            provenance := context.return_view_provenance ?? ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
            _ := sema_ownership_record_view_returns(state, [SemaOwnershipPlace]{}, access, [String]{}, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, provenance, expr_span(value), diagnostics)
            context.return_view_provenance = Val(provenance)
        }
        return None
    }
    // A returned arena view would outlive the
    // arena, which drops at scope end.
    if sema_ownership_report_arena_view_escape(state, value, "be returned", scopes, diagnostics) -> return None
    // (Rust `check_return`): a bare range place is a read
    // window at a named `View<T>` return boundary, acquired explicitly so
    // the returned type stays a view instead of a materialized list.
    if sema_stmt_return_is_view_boundary(return_type) && sema_stmt_is_bare_range_place(value, scopes, state) {
        return sema_stmt_check_returned_value(Expr.Place{value: value, access: PlaceAccess.Read, span: expr_span(value), id: AST_NODE_GENERATED}, return_type, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    if sema_stmt_return_is_view_boundary(return_type) {
        if sema_stmt_whole_list_window(value, environment, program, scopes, state) == .Val(window) -> return sema_stmt_check_returned_value(window, return_type, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    // `Ok(place)` fills the same view success slot (Rust `check_return`):
    // return the window itself, lifted into the success rail like any plain
    // success value, so the payload never materializes the view.
    if sema_stmt_return_is_view_boundary(return_type) && sema_stmt_return_type_is_result(return_type) {
        payload := Expr?{None}
        // copy: `ok_value` is a payload of read parameter `value`, which keeps the original; the local `payload` owns this one
        if value == .Ok(ok_value, _, _) -> payload = Val(ok_value.copy())
        if value == .Call(ok_call, _) {
            if ok_call.name == "Ok" && ok_call.args.len() == 1 -> payload = Val(ok_call.args[0].expr)
        }
        if payload == .Val(ok_value) {
            if sema_stmt_is_bare_range_place(ok_value, scopes, state) {
                return sema_stmt_check_returned_value(Expr.Place{value: ok_value, access: PlaceAccess.Read, span: expr_span(ok_value), id: AST_NODE_GENERATED}, return_type, environment, program, scopes, state, tail_store, context, diagnostics)
            }
            if sema_stmt_whole_list_window(ok_value, environment, program, scopes, state) == .Val(window) -> return sema_stmt_check_returned_value(window, return_type, environment, program, scopes, state, tail_store, context, diagnostics)
        }
    }
    diagnostics_before: diagnostics.len()
    checked: sema_stmt_check_return_value(value, return_type, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
        sema_stmt_report_ownerless_view_return(value, return_type, diagnostics_before, scopes, state, context, diagnostics)
        return None
    }
    if sema_stmt_returns_module_call(value, environment, scopes) -> sema_stmt_lint_blocked_tail_call(expr_span(value), environment, program, scopes, state, diagnostics)
    if !sema_stmt_return_is_view_boundary(return_type) && !context.return_view_declared && !sema_copy_site_check_guard_owned(checked, environment, program, scopes, state, context, diagnostics, false) -> return None
    if return_type != None && sema_contains_expiring_secret_loan(checked.ty) {
        diagnostics.push(sema_error("E0201", expr_span(value), "an ExpiringSecret loan cannot be returned", "the callback parameter is valid only while `.with` is running", "return a non-secret result computed from the loan"))
    }
    value_is_ident := if value == {
        .Ident(_, _, _) -> true
        else -> false
    }
    // Classify the value, not the enclosing Result/Option rail. The failure
    // solver also wraps an infallible view return in `View<str> Never!`.
    returned_success: sema_stmt_return_success_type(Val(checked.ty))
    string_view_return := sema_stmt_string_view_type(returned_success) && (value_is_ident || sema_string_view_call_sources(value, scopes, state).len() > 0)
    materialized_string_view: sema_string_view_owning_read(value, returned_success, scopes)
    // An owning materialization returns new storage, not the source window's
    // provenance. A view return must instead prove its original owner.
    // An `Ok(view)` exit proves its success payload's owners; an `Err(..)`
    // exit carries no view (Rust `check_return` `failure_exit`). A window
    // read at the boundary, or a view binding, is lifted into the success
    // rail, so it proves its owners as the success view it is.
    recorded_value := value
    recorded_ty := checked.ty
    if sema_stmt_return_success_is_view(return_type) && checked.ty == .Result(ok_ty, _) {
        if value == .Ok(ok_value, _, _) {
            recorded_value = ok_value
            recorded_ty = ok_ty
        }
        if value == .Place(_, _, _, _) -> recorded_ty = ok_ty
        if sema_stmt_return_known_type(value, environment, scopes) == .Val(known) {
            if sema_stmt_view_access(known) != None -> recorded_ty = ok_ty
        }
    }
    failure_exit := false
    if sema_stmt_return_success_is_view(return_type) {
        if value == .Err(_, _, _) -> failure_exit = true
        if value == .Call(err_call, _) {
            if err_call.name == "Err" && err_call.args.len() == 1 -> failure_exit = true
        }
    }
    view_valid := materialized_string_view || failure_exit || if string_view_return -> sema_string_view_record_return(value, scopes, state, context, diagnostics) else -> sema_stmt_record_return_views(recorded_value, recorded_ty, scopes, state, context, diagnostics)
    // A named `View<T>` boundary reads every bare place through a window
    // (Rust wraps it before the audit), so only other returns are audited.
    if return_type != None && !sema_stmt_return_is_view_boundary(return_type) -> sema_copy_site_check_borrowed_return(value, environment, program, scopes, context, diagnostics)
    // Neither a returned window nor its owning copy moves the window's owner.
    moved := materialized_string_view || string_view_return || (!view_valid) || sema_stmt_move_direct(value, state, scopes, "`return`", diagnostics)
    if !view_valid || !moved -> return None
    Val(checked)
}

// Rust `check_return` audits a declared `View`/`ViewMut` return before the
// value's type: a value that reads no place and calls no view-returning
// function names no owner (E2305), reported ahead of its type error.
sema_stmt_report_ownerless_view_return: fn(value: Expr, return_type: Type?, at: Int, scopes: SemaScopeTable, state: &SemaOwnershipState, context: SemaCheckContext, diagnostics: &[Diagnostic]) {
    if at >= diagnostics.len() || !sema_stmt_return_success_is_view(return_type) -> return
    if sema_stmt_call_return_views_for_expr(value, context).len() > 0 || sema_ownership_places_from_expr_in_state(value, scopes, state).len() > 0 -> return
    diagnostics.insert(at, sema_ownership_diag_view_return_boundary(expr_span(value)))
}

// `return value` in a callback expected with no return row (a generic
// `map`'s `fn(T) -> U`): `return` leaves the callback, never the enclosing
// function. The first returned value gives the callback its row, and every
// later one must fit it; a row a propagated fallible call gave first is that
// call's carrier, and a value fits its success. The value stays the
// callback's result, so its caller still judges it.
sema_stmt_check_open_callback_return: fn(value: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    checked: sema_check_expression(value, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    if context.callback_return_row == .Val(row) {
        // A Result row is a propagated call's carrier; a plain row is the
        // value an earlier `return` handed back.
        if row == .Result(success, _) {
            if !sema_type_assignable(success, checked.ty) -> diagnostics.push(sema_return_value_mismatch(context.function_name, row, checked.ty, expr_span(value)))
        } else if !sema_type_assignable(row, checked.ty) {
            diagnostics.push(sema_callback_return_mismatch(row, checked.ty, expr_span(value)))
        }
        return Val(checked)
    }
    context.callback_return_row = Val(checked.ty.copy())
    Val(checked)
}

// E0113: a callback's value disagrees with the type its first `return`
// handed back.
sema_callback_return_mismatch: fn(row: Type, got: Type, span: Span) -> Diagnostic {
    sema_error("E0113", span, "this callback returns {sema_type_show(row)} elsewhere, but this value is {sema_type_show(got)}", "every `return` and the last line of a callback hand back one type", sema_return_value_fix(row, got))
}

// The declared return type is a `T !E` carrier.
sema_stmt_return_type_is_result: fn(return_type: Type?) -> Bool Never! {
    declared: return_type ?? return false
    declared == .Result(_, _)
}

// The declared success type is `View<T>`, not the string view `View<str>`.
sema_stmt_return_is_view_boundary: fn(return_type: Type?) -> Bool Never! {
    declared: return_type ?? return false
    success: if declared == .Result(ok, _) -> ok else -> declared
    if success == .Apply(name, _) -> return name == "View" && !sema_stmt_string_view_type(success)
    false
}

// The declared success type is a window, `View<T>` or `ViewMut<T>` (not the
// string view `View<str>`), whose owners a return proves on its success rail.
sema_stmt_return_success_is_view: fn(return_type: Type?) -> Bool Never! {
    declared: return_type ?? return false
    success: if declared == .Result(ok, _) -> ok else -> declared
    if success == .Apply(name, _) -> return (name == "View" || name == "ViewMut") && !sema_stmt_string_view_type(success)
    false
}

// (owner ruling): with a written return type, a value that does
// not fit it is E0113 about the value itself (the Rust reference's
// `check_return_expr`), replacing the generic E0108 at the value.
sema_stmt_value_return_mismatch: fn(value: Expr, return_type: Type?, diagnostic_start: Int, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) {
    if sema_stmt_return_success_type(return_type) == (Type.Named{name: "Unit"}) -> return
    value_span: expr_span(value)
    mismatch_index: sema_value_mismatch_index(diagnostics, diagnostic_start, value_span) ?? return
    // The value's own type, inferred without the return type as a target.
    probe_diagnostics := [Diagnostic]{}
    offered: sema_probe_expression(value, None, environment, program, scopes, state, tail_store, context, probe_diagnostics) ?? return
    diagnostics[mismatch_index] = sema_return_value_mismatch(context.function_name, sema_stmt_return_required_type(return_type), offered.ty, value_span)
}

// Rust `check_return_expr` infers the value against the whole return type,
// so a value whose own type already is the carrier (`list[i]` of `[T?]`,
// `row.field` of `T !E`, `map.get(key)` or `list.pop() ?? None` of `T?`)
// returns as-is. The syntactic carrier test above cannot see such a value's
// type, so it is inferred here on its own. A `T !E` slot keeps method and
// value calls on the payload route, where their failure propagates.
sema_stmt_return_probed_carrier: fn(value: Expr, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> Bool {
    if !sema_stmt_return_is_carrier(return_type) -> return false
    required: sema_stmt_return_required_type(return_type)
    if sema_stmt_return_known_type(value, environment, scopes) == .Val(known) {
        // A generic callee declares its result as its own parameter (`-> T`),
        // so only the call's inferred type shows whether it is the carrier.
        if !(sema_stmt_return_unparen(value) == .Call(_, _)) || sema_stmt_return_types_are_carriers(known, required) -> return false
    } else if !sema_stmt_return_probe_shape(value, sema_expr_unwrap_tag(required) == .Option(_)) {
        return false
    }
    probe_diagnostics := [Diagnostic]{}
    probed: sema_probe_expression(value, None, environment, program, scopes, state, tail_store, context, probe_diagnostics) ?? return false
    sema_stmt_return_types_are_carriers(probed.ty, required)
}

sema_stmt_return_unparen: fn(value: Expr) -> Expr Never! {
    if value == {
        .Paren(inner, _, _) -> sema_stmt_return_unparen(inner)
        else -> value
    }
}

// The value shapes whose own type the return check infers before choosing
// the carrier or the payload route. A `.copy()` has its place's type, as
// `sema_stmt_return_known_type` reads it (`return list[i].copy()` of `[T?]`).
sema_stmt_return_probe_shape: fn(value: Expr, optional_slot: Bool) -> Bool Never! {
    if value == {
        .Paren(inner, _, _) | .Place(inner, _, _, _) -> return optional_slot && sema_stmt_return_probe_shape(inner, optional_slot)
        .Copy(inner, _, _) -> return sema_stmt_return_probe_shape(inner, optional_slot)
        .Index(_, _, _, _, _) | .Field(_, _, _, _) -> return true
        .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .OrFallback(_, _, _, _, _) | .CallValue(_, _, _, _) -> return optional_slot
        else -> return false
    }
}

sema_stmt_check_return_value_typed: fn(value: Expr, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    required := sema_stmt_return_required_type(return_type)
    if sema_stmt_return_if_mixes_carrier(value, return_type, environment, scopes) {
        lifted: sema_stmt_return_lift_if_arms(value, return_type, environment, scopes)
        table: sema_check_expression(lifted, Val(required), environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
        if sema_stmt_type_is_fallible_result(table.ty) -> context.failure_direct_source = true
        return Val(table)
    }
    success: sema_stmt_return_success_type(return_type)
    widened_call: sema_stmt_return_call_widening(value, success, environment, program, scopes, state, tail_store, context)
    if widened_call == None && (sema_stmt_return_expr_is_carrier(value, return_type, environment, scopes) || sema_stmt_return_probed_carrier(value, return_type, environment, program, scopes, state, tail_store, context)) {
        carrier: sema_check_expression(value, Val(required), environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
        // #3708: a fallible value returned as-is (not an `Ok`/`Err` written
        // here) is this body's own failure source.
        if !sema_stmt_is_written_carrier(value, Val(required), scopes) && sema_stmt_type_is_fallible_result(carrier.ty) -> context.failure_direct_source = true
        return Val(carrier)
    }
    if !sema_stmt_return_is_carrier(return_type) {
        return sema_stmt_check_return_payload(value, required, widened_call, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    payload: sema_stmt_check_return_payload(value, success, widened_call, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    normalized := sema_expr_unwrap_tag(required)
    if normalized == {
        .Result(_, _) -> return Val(sema_tree_node(required, TExprKind.Ok{value: payload}, expr_span(value)))
        .Option(_) -> return Val(sema_tree_node(required, TExprKind.Present{value: payload}, expr_span(value)))
        else -> return Val(payload)
    }
}

// A returned call whose own success type widens losslessly into a numeric
// success slot: the call is inferred alone, its failure propagates, and its
// payload converts like any other widened return. A checked widening keeps
// the slot as the call's inference target. The call's own success type.
sema_stmt_return_call_widening: fn(value: Expr, success: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> Type? {
    if !sema_expr_is_numeric(success) || !sema_stmt_return_call_shape(value) -> return None
    probe_diagnostics := [Diagnostic]{}
    probe: sema_probe_expression(value, None, environment, program, scopes, state, tail_store, context, probe_diagnostics) ?? return None
    own := probe.ty
    unwrapped: sema_expr_unwrap_tag(probe.ty)
    if unwrapped == .Result(ok, _) -> own = ok
    if !sema_expr_is_numeric(own) || type_identity_equal(own, success) -> return None
    if sema_expr_numeric_widening_to(own, success) != (Val(false)) -> return None
    Val(own)
}

// Return-position numeric widening, exactly as at a call argument: a value
// whose type is already known and widens into the numeric success slot is
// checked on its own type and then converted, so every tier receives the
// explicit conversion instead of the source bits under the slot's type.
// Rust `widen_numeric_return` takes any widening (`numeric_widening_to` is
// Some): a lossless one (U8 into Int) as well as a checked one. A widened
// call (`sema_stmt_return_call_widening`) is checked on its own success type.
sema_stmt_check_return_payload: fn(value: Expr, success: Type, call_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    known := sema_stmt_return_numeric_source(value, environment, scopes)
    // copy: `call_type` is the caller's read parameter, which keeps its value
    if call_type == .Val(own) -> known = Val(own.copy())
    if known == .Val(source) && sema_expr_is_numeric(success) && !type_identity_equal(source, success) && sema_expr_numeric_widening_to(source, success) != None {
        checked: sema_check_expression(value, call_type, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
        line: sema_source_line_at(environment.source_segments, checked.span) ?? 0
        return sema_expr_numeric_literal_conversion(checked, success, checked.span, line, diagnostics)
    }
    // Rust `string_view_return`: a `View<str>` return reads a string view as itself.
    if sema_stmt_string_view_type(success) && sema_string_view_return_source(value, scopes, state) -> return sema_string_view_return_value(value, success, environment, program, scopes, state, tail_store, context, diagnostics)
    // A returned string view becomes an owned `String`.
    if sema_string_view_owning_read(value, success, scopes) {
        if value == .Ident(name, name_span, _) -> return sema_string_view_materialize(name, name_span, Val(success), environment, program, scopes, state, context, diagnostics)
    }
    sema_check_expression(value, Val(success), environment, program, scopes, state, tail_store, context, diagnostics)
}

sema_stmt_return_call_shape: fn(value: Expr) -> Bool Never! {
    if value == {
        .Paren(inner, _, _) -> sema_stmt_return_call_shape(inner)
        .Call(_, _) | .MethodCall(_, _, _, _, _, _, _) | .CallValue(_, _, _, _) -> true
        else -> false
    }
}

// Rust `widen_numeric_return` widens whatever type the value inferred to, so
// an arithmetic value (`return n - 48` with `n: U8` under `-> Int`) widens on
// its operand carrier: two operands of one type, or one typed operand and a
// bare integer literal that adopts it.
sema_stmt_return_numeric_source: fn(value: Expr, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> Type? {
    if value == {
        .Paren(inner, _, _) -> return sema_stmt_return_numeric_source(inner, environment, scopes)
        .Binary(op, left, right, _, _) -> {
            if op != BinOp.Add && op != BinOp.Sub && op != BinOp.Mul && op != BinOp.Mod && op != BinOp.Rem -> return None
            left_literal: left == .Int(_, _, _, _, _)
            right_literal: right == .Int(_, _, _, _, _)
            if left_literal && right_literal -> return None
            if left_literal -> return sema_stmt_return_numeric_source(right, environment, scopes)
            if right_literal -> return sema_stmt_return_numeric_source(left, environment, scopes)
            left_type: sema_stmt_return_numeric_source(left, environment, scopes) ?? return None
            right_type: sema_stmt_return_numeric_source(right, environment, scopes) ?? return None
            if type_identity_equal(left_type, right_type) -> return Val(left_type)
            return None
        }
        else -> return sema_stmt_return_known_type(value, environment, scopes)
    }
}
sema_stmt_return_allows_empty: fn(return_type: Type?) -> Bool Never! {
    if return_type == None -> return true
    normalized := sema_expr_unwrap_tag(sema_stmt_return_required_type(return_type))
    if normalized == {
        .Option(_) -> return false
        else -> {}
    }
    if normalized == {
        .Named(name) -> {
            if name == "Never" -> return false
        }
        else -> {}
    }
    sema_stmt_return_success_type(return_type) == Type.Named{name: "Unit"}
}

// A Result whose failure is reachable.
sema_stmt_type_is_fallible_result: fn(ty: Type) -> Bool Never! {
    if sema_expr_unwrap_tag(ty) == {
        .Result(_, error) -> sema_expr_unwrap_tag(error) != Type.Named{name: "Never"}
        else -> false
    }
}

// An `Ok(…)` or `Err(…)` written at this site, through parentheses.
sema_stmt_is_written_carrier: fn(value: Expr, expected: Type?, scopes: SemaScopeTable) -> Bool Never! {
    if value == {
        .Paren(inner, _, _) -> sema_stmt_is_written_carrier(inner, expected, scopes)
        .Ok(_, _, _) | .Err(_, _, _) -> true
        .Call(call, _) -> sema_expression_contextual_result_call(call, expected, scopes) != None || sema_call_default_err_candidate(call, expected, scopes)
        .EnumLit(owner, variant, _, args, dot, _, _) -> owner == "" && dot && (variant == "Ok" || variant == "Err") && args.len() == 1 && args[0] == .Positional(_)
        else -> false
    }
}

// An optional, or a Result whose failure is reachable (the Rust reference's
// `Type::is_fallible`).
sema_stmt_type_is_fallible: fn(ty: Type) -> Bool Never! {
    if sema_expr_unwrap_tag(ty) == {
        .Option(_) -> true
        .Result(_, error) -> sema_expr_unwrap_tag(error) != Type.Named{name: "Never"}
        else -> false
    }
}

// Rust `Expr::Try` over a call or method call: the checked form of a
// fallible call whose failure propagates, explicitly (`?`) or implicitly.
sema_stmt_is_propagated_call: fn(init: TExpr) -> Bool Never! {
    value := init
    if init.kind == {
        .Try(inner, _, _) -> value = inner
        .TryWithContext(inner, _, _, _, _, _) -> value = inner
        else -> return false
    }
    if value.kind == {
        .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .StaticCall(_, _, _, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) -> return true
        else -> return false
    }
}

// A statement value that carries nothing: `Unit`, `Never`, or the success of
// a unit `Never!` call.
sema_stmt_type_is_unit_success: fn(ty: Type) -> Bool Never! {
    success: if sema_expr_unwrap_tag(ty) == {
        .Result(ok, error) -> if sema_expr_unwrap_tag(error) == (Type.Named{name: "Never"}) -> ok else -> ty
        else -> ty
    }
    success == (Type.Named{name: "Unit"}) || success == (Type.Named{name: "Never"})
}

sema_stmt_restore_statement_scopes: fn(scopes: &SemaScopeTable, return_type: Type?, failure_carrier: TFailureCarrier?, loop_depth: Int) Never! {
    scopes.return_type = return_type
    scopes.failure_carrier = failure_carrier
    scopes.loop_depth = loop_depth
}

// A callable argument's effects belong to the call site, and a write-marked
// argument changes the caller's place, so either one gives the call a purpose
// beyond its result.
sema_stmt_discard_args_effectful: fn(args: [TCallArg]) -> Bool Never! {
    loop arg in args {
        if arg.mut_borrow -> return true
        if arg.value.ty == {
            .Fn(_, _, _, _, _, _) -> return true
            else -> {}
        }
    }
    false
}

// E0433 lost-tail site: a function with no written return
// type returns nothing, so the value of its last line is lost. A `value ??
// fallback` tail is reported from its value's span, so a method call points
// at its method, as a bare one does.
sema_stmt_lost_tail_diagnostic: fn(function: String, value_type: String, tail: Expr) -> Diagnostic {
    span := expr_span(tail)
    if tail == .OrFallback(value, _, _, _, _) -> span = Span{start: expr_span(value).start, end: span.end}
    sema_error("E0433", span, "this {value_type} value is thrown away", "`{function}` has no return type, so it returns nothing and the value of its last line is lost", "if `{function}` should return it, write `-> {value_type}` after its parameter list; to discard it on purpose, write `.drop(\"reason\")`")
}

// The call a statement drops, under an automatic or written `?` or bare, and
// whether its checked carrier is `T Never!`. Under `?` the call still carries
// a failure unless its callee's contract is `T Never!`
// declared, or projected onto a callee the #3708 failure solve proves
// infallible after this one check (`sema_failure_reconcile_infallible`).
SemaStmtDiscardedCall: struct {
    call: TExpr
    infallible: Bool
}

sema_stmt_discarded_call: fn(checked: TExpr) -> SemaStmtDiscardedCall? Never! {
    inner := checked
    if checked.kind == {
        .Try(value, _, _) -> inner = value
        .TryWithContext(value, _, _, _, _, _) -> inner = value
        else -> return Val(SemaStmtDiscardedCall{call: checked, infallible: true})
    }
    if sema_expr_unwrap_tag(inner.ty) == .Result(_, error) -> return Val(SemaStmtDiscardedCall{call: inner, infallible: sema_expr_unwrap_tag(error) == (Type.Named{name: "Never"})})
    None
}

// E0433 candidate: the statement drops the non-Unit result of a direct,
// static or method call. Mark the call's fact; the solved effect phase
// reports it when the callee's row is empty (pure means an
// empty row and nothing passed with `&`). A call whose carrier can still fail
// waits for the failure solve.
sema_stmt_mark_discarded_result: fn(program: SemaProgramTables, checked: TExpr, fact_start: Int, context: &SemaCheckContext) Never! {
    discarded: sema_stmt_discarded_call(checked) ?? return
    call: discarded.call
    callee_key: if call.kind == {
        .Call(callee, _, args) -> if sema_stmt_discard_args_effectful(args) -> "" else -> sema_program_decl_key(program, callee)
        .StaticCall(_, _, method, _, args) -> if sema_stmt_discard_args_effectful(args) -> "" else -> method.symbol.key
        .MethodCall(receiver, method, _, args) -> {
            written: if receiver.kind == {
                .Borrow(_, access) -> access != AccessConvention.Read
                else -> false
            }
            if written || sema_stmt_discard_args_effectful(args) -> "" else -> method.symbol.key
        }
        else -> ""
    }
    if callee_key == "" -> return
    index := context.call_facts.len() - 1
    loop index >= fact_start {
        if context.call_facts[index].callee == .Val(symbol) && symbol.key == callee_key {
            if discarded.infallible {
                context.call_facts[index].discarded = true
            } else {
                context.call_facts[index].discarded_if_infallible = true
            }
            return
        }
        index -= 1
    }
}

// Rust `check_value_tail` on an unreachable value line infers it with the
// promised type only as context (`infer_with_expected`): the value is never
// compared against that type, handed back, or treated as a discarded result.
// A value that only fails against the promised type is checked on its own.
sema_stmt_check_dead_value_tail: fn(tail: Expr, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    probe_diagnostics := [Diagnostic]{}
    probed: sema_probe_expression(tail, return_type, environment, program, scopes, state, tail_store, context, probe_diagnostics)
    expected := Type?{None}
    if probed != None && !sema_has_error_since(probe_diagnostics, 0) -> expected = return_type
    sema_check_expression(tail, expected, environment, program, scopes, state, tail_store, context, diagnostics) != None
}

sema_check_statements: fn(statements: [Stmt], return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> SemaStatementResult {
    // E1403: a statement list is one source nesting level
    // below its owner, as each of its statements is in the Rust checker.
    entered_nesting := false
    loop first in statements {
        if !sema_enter_source_nesting(context, sema_compiler_index_stmt_span(first), diagnostics) -> return SemaStatementResult{value: [TStmt]{}, complete: false}
        entered_nesting = true
        break
    }
    tail_frame_depth := context.lambda_statement_tails.len()
    tail_body_id := sema_statement_tail_store_add_body(tail_store, statements)
    context.lambda_statement_tails.push(SemaStatementTailFrame{body_id: tail_body_id, start_index: 0})
    previous_return_type := scopes.return_type
    previous_failure_carrier := scopes.failure_carrier
    previous_loop_depth := scopes.loop_depth
    // A nested block keeps the carrier its owner established (a lambda's is
    // not the implicit `!Err` of a function); only a new return type, or a
    // root with no carrier outside an open callback, derives it.
    if return_type != previous_return_type || (previous_failure_carrier == None && !context.failure_inference) -> scopes.failure_carrier = Val(sema_failure_carrier(return_type))
    scopes.return_type = return_type
    scopes.loop_depth = loop_depth
    sema_stmt_lint_same_subject_dispatch(statements, environment, program, diagnostics)
    sema_stmt_lint_map_group_round_trip(statements, environment, program, scopes, diagnostics)
    output := [TStmt]{}
    complete := true
    reachable := true
    index := 0
    loop index < statements.len() {
        // Each statement is read in place (`statements[index]`): a binding of
        // the row copied the whole statement, its nested bodies included.
        context.lambda_statement_tails[tail_frame_depth].start_index = index + 1
        if !reachable {
            if !sema_stmt_check_unreachable_statement(statements[index], index, statements, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth) -> complete = false
            index += 1
            next
        }
        if sema_unsafe_is_assertion(statements[index]) {
            index += 1
            next
        }
        sema_ownership_release_dead_views(state, statements[index], tail_store, context)
        output_start := output.len()
        statement_diagnostics: diagnostics.len()
        statement_reasons: context.incomplete_reasons.len()
        statement_complete: complete
        sema_marker_rules_check_statement_facts(sema_compiler_index_stmt_span(statements[index]), environment, program, scopes, state, tail_store, context, diagnostics)
        // #3708: these statements own a failure route of their own (task
        // groups, transactions, reactive scopes, generators, deferred closes).
        if statements[index] == {
            .TaskGroup(_, _, _, _, _) | .Transact(_, _, _, _, _) | .Live(_, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .Yield(_, _) | .DeferClose(_, _) -> context.failure_direct_source = true
            else -> {}
        }
        // #3886 the reachable last line of a function with a
        // written value return is the value it hands back, checked like `return`.
        unit_result_return: if return_type == {
            .Val(.Result(success, _)) -> success == (Type.Named{name: "Unit"})
            else -> false
        }
        if index + 1 == statements.len() && statements[index] == .Expr(tail) && (context.value_tail_span == (Val(expr_span(tail))) || (unit_result_return && sema_stmt_return_expr_is_carrier(tail, return_type, environment, scopes))) && !sema_stmt_refutable_expr_diverges(tail) {
            returned: sema_stmt_check_returned_value(tail, return_type, environment, program, scopes, state, tail_store, context, diagnostics)
            if returned == {
                .Val(value) -> output.push(TStmt.Return{value: Val(value), span: expr_span(tail)})
                .None -> complete = false
            }
            sema_stmt_note_silent_incomplete(statements[index], statement_complete, complete, diagnostics, statement_diagnostics, context, statement_reasons)
            index += 1
            next
        }
        if statements[index] == {
            .Expr(expr) -> {
                if !sema_stmt_check_expression_statement(expr, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth, output) -> complete = false
            }
            .DeferClose(close, span) -> {
                checked := sema_stmt_check_defer_close(close, span, environment, program, scopes, state, tail_store, context, diagnostics)
                if checked == {
                    .Val(checked_statement) -> output.push(checked_statement)
                    .None -> complete = false
                }
            }
            .Switch(subject, arms, else_body, span) -> {
                exit_guard: if index + 1 < statements.len() -> sema_stmt_optional_exit_guard_name(subject, arms, else_body, span, scopes) else -> None
                if exit_guard == {
                    .Val(guarded_name) -> {
                        refined: sema_stmt_check_optional_refinement(guarded_name, OrFallback.Block{body: arms[0].body, value: None, span: span}, span, environment, program, scopes, state, tail_store, context, diagnostics)
                        if refined == {
                            .Val(refined_statement) -> output.push(refined_statement)
                            .None -> complete = false
                        }
                    }
                    .None -> {
                        // Rust `check_switch`: a guard table that ends a value
                        // block with no `else` can skip every arm (E0114).
                        value_guard: index + 1 == statements.len() && context.value_tail_span == (Val(span)) && else_body == None && sema_stmt_refutable_is_subjectless_guard(subject, span)
                        checked: sema_stmt_check_switch(subject, arms, else_body, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
                        if value_guard {
                            diagnostics.push(sema_stmt_missing_value(return_type, sema_stmt_uncovered_guard_path(statements), context.function_name, span))
                            complete = false
                        }
                        if {
                            !checked.complete -> complete = false
                            else -> {
                                loop checked_statement in checked.value -> output.push(checked_statement)
                                if index + 1 < statements.len() {
                                    loop refinement in sema_stmt_exit_guard_bound_refinements(subject, arms, else_body, span, environment, scopes) {
                                        refined: sema_stmt_check_bounds_refinement(refinement, span, environment, program, scopes, state, tail_store, context, diagnostics)
                                        if refined == {
                                            .Val(refined_statement) -> output.push(refined_statement)
                                            .None -> complete = false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            .Val(binding) -> {
                lambda_escapes := context.lambda_escapes
                if binding.init == {
                    .Lambda(_, _) -> lambda_escapes = sema_expression_lambda_bound_escapes(binding, statements, index + 1, tail_store, environment, program, scopes, state, context, diagnostics)
                    else -> {}
                }
                checked: sema_stmt_check_binding(binding, lambda_escapes, environment, program, scopes, state, tail_store, context, diagnostics)
                if checked == {
                    .Val(value) -> {
                        if value == .Let(local, _, _, _, _, _) {
                            if local.ty == Type.String && sema_stmt_ascii_case_ladder(statements, index, binding) {
                                diagnostics.push(sema_lint("L0521", binding.name_span, "a complete ASCII case ladder repeats a direct case conversion", "all 26 constant ASCII branches inspect the same value and only change its case", "replace the complete ladder with value.to_ascii_lower() or value.to_ascii_upper()"))
                            }
                        }
                        output.push(value)
                        // A bare `None` start can check as a value after its E0308.
                        sema_stmt_empty_start_report(binding, statements, index, return_type, context.value_tail_span, environment, scopes, diagnostics)
                        if !binding.mutable && binding.pattern == None && sema_shared_cycle_cell_init(binding.init) -> sema_scope_mark_fresh_cell(scopes, binding.name, binding.init)
                    }
                    .None -> {
                        sema_stmt_empty_start_report(binding, statements, index, return_type, context.value_tail_span, environment, scopes, diagnostics)
                        complete = false
                    }
                }
            }
            .Assign(target, op, op_span, expr) -> {
                checked: sema_stmt_check_assignment(target, op, op_span, expr, environment, program, scopes, state, tail_store, context, diagnostics)
                if checked == {
                    .Val(value) -> output.push(value)
                    .None -> complete = false
                }
            }
            .Return(value, span) -> {
                if {
                    sema_stmt_generator_return_rejected(value, return_type, environment, program, scopes, state, tail_store, context, diagnostics) -> complete = false
                    sema_stmt_never_return_rejected(value, return_type, context.function_name, span, diagnostics) -> complete = false
                    value == None -> {
                        if !sema_stmt_return_allows_empty(return_type) {
                            // (E0113): the empty `return` against the declared result.
                            required: sema_stmt_return_required_type(return_type)
                            diagnostics.push(sema_error("E0113", span, "`{context.function_name}` promises to return {type_name(required)}, but this `return` is empty", "the value handed back must match the declared return type", "add the value: `return ...;`"))
                            complete = false
                        }
                        output.push(TStmt.Return{value: None, span: span})
                    }
                    else -> {
                        // `value` is narrowed to the returned expression here (the
                        // None arm above); it is read in place through a read parameter.
                        checked: if return_type == None && context.callback_return_open -> sema_stmt_check_open_callback_return(value, environment, program, scopes, state, tail_store, context, diagnostics) else -> sema_stmt_check_returned_value(value, return_type, environment, program, scopes, state, tail_store, context, diagnostics)
                        if {
                            checked == None -> {
                                complete = false
                            }
                            else -> {
                                output.push(TStmt.Return{value: checked, span: span})
                            }
                        }
                    }
                }
            }
            .For(var, var_span, var2, kind, body, span, arrow_body, label, _) -> {
                if kind == {
                    .Range(start_expr, end_expr, step_expr, exclusive) -> {
                        start_value := sema_stmt_check_range_endpoint(start_expr, "start", environment, program, scopes, state, tail_store, context, diagnostics)
                        end_value := sema_stmt_check_range_endpoint(end_expr, "end", environment, program, scopes, state, tail_store, context, diagnostics)
                        step_value := TExpr?{None}
                        if step_expr != None {
                            step_value = sema_stmt_check_range_stride(step_expr, environment, program, scopes, state, tail_store, context, diagnostics)
                        }
                        // Written ends that count the wrong
                        // way are a check error; computed ends stay empty.
                        if sema_range_backward_diagnostic(start_expr, end_expr, step_expr, exclusive, true) == .Val(backward) -> diagnostics.push(backward)
                        // Rust `check_stmt`: an arrow body is only the body's
                        // spelling, and a second loop name is not declared for
                        // a range.
                        valid := start_value != None && end_value != None
                        if step_expr != None && step_value == None -> valid = false
                        range_var_type := Type.Int
                        if start_value == {
                            .Val(value) -> range_var_type = value.ty
                            .None -> {}
                        }

                        // The body runs in place from this mark (sema_ownership_mark).
                        loop_fork: sema_ownership_mark(state)
                        sema_scope_enter(scopes, state, "for@{span.start}")
                        label_name := String?{None}
                        if label != None {
                            label_name = Val(label.name)
                            if !sema_scope_push_loop_label(scopes, label.name) {
                                diagnostics.push(sema_already_defined(label.name, label.span))
                                valid = false
                            }
                        }
                        module_name := environment.module_identity
                        owner := sema_scope_local_owner_key(scopes)
                        symbol := Symbol{
                            id: symbol_id(SymbolKind.Local, module_name, owner, var),
                            kind: SymbolKind.Local,
                            name: var,
                            module_name: module_name,
                            owner: Val(owner),
                            span: var_span,
                            ty: Val(range_var_type),
                            visibility: 0,
                        }
                        if {
                            !sema_scope_declare_local(scopes, symbol, false, AccessConvention.Read, None, false) -> {
                                diagnostics.push(sema_already_defined(var, var_span))
                                valid = false
                            }
                            else -> {
                                sema_ownership_declare_binding(state, symbol, false)
                            }
                        }
                        loop_frame_index := context.loop_value_frames.len()
                        sema_loop_value_push_frame(context, label_name, loop_fork)
                        previous_arrow_loop_body := context.arrow_loop_body
                        context.arrow_loop_body = arrow_body
                        nested := sema_check_statements(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth + 1)
                        if !nested.complete -> valid = false
                        context.arrow_loop_body = previous_arrow_loop_body
                        // E0364: inclusive `0..xs.len()` whose body
                        // indexes that same `xs` with this loop's index name.
                        if !exclusive && sema_stmt_range_end_len_root(end_expr) == .Val(len_root) && sema_stmt_index_root_with_stmts(body, len_root, var) {
                            diagnostics.push(sema_error("E0364", expr_span(end_expr), "this range includes `{len_root}.len()`, one past the last index", "`{len_root}.len()` is the count of items, so inclusive `..` runs one step too far when the body indexes `{len_root}`", "write `loop (i, item) in {len_root}` — or `loop i in {len_root}.indexes()` — or `0..<{len_root}.len()`"))
                        }
                        if label != None -> sema_scope_pop_loop_label(scopes)
                        sema_single_use_leave_scope(scopes, state, diagnostics)
                        if !sema_stmt_close_loop_value_frame(context, loop_frame_index, nested.value, state, loop_fork, false, true, environment, program, diagnostics) -> valid = false
                        if {
                            !valid -> complete = false
                            else -> {
                                start_tree: start_value ?? {
                                    sema_stmt_leave_statements(context, tail_store, tail_frame_depth, tail_body_id, entered_nesting)
                                    sema_stmt_restore_statement_scopes(scopes, previous_return_type, previous_failure_carrier, previous_loop_depth)
                                    return SemaStatementResult{value: output, complete: false}
                                }
                                end_tree: end_value ?? {
                                    sema_stmt_leave_statements(context, tail_store, tail_frame_depth, tail_body_id, entered_nesting)
                                    sema_stmt_restore_statement_scopes(scopes, previous_return_type, previous_failure_carrier, previous_loop_depth)
                                    return SemaStatementResult{value: output, complete: false}
                                }
                                local: checked_symbol_local(var, var_span, symbol.id, range_var_type)
                                output.push(TStmt.ForRange{label: label_name, local: local, start: start_tree, end: end_tree, step: step_value, exclusive: exclusive, body: nested.value, vectorization: None, span: span})
                            }
                        }
                    }
                    .In(written_collection, step_expr) -> {
                        // `loop x in xs.move()` takes the source: every shape
                        // check below reads it as the exact take.
                        collection_expr: sema_expr_take_place_form(written_collection, scopes) ?? written_collection
                        collection_value := sema_check_expression(collection_expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
                        collection: collection_value ?? sema_node(context, Type.Named{name: "Unit"}, NodeKind.Unit, expr_span(collection_expr))
                        if collection_value != None && var2 == None -> sema_stmt_lint_walk_filter(var, collection_expr, body, environment, program, scopes, diagnostics)
                        step_value := TExpr?{None}
                        if step_expr != None {
                            step_value = sema_stmt_check_source_stride(step_expr, environment, program, scopes, state, tail_store, context, diagnostics)
                        }
                        valid := collection_value != None
                        if step_expr != None && step_value == None -> valid = false
                        range_source := sema_stmt_for_in_is_range(collection.ty)
                        method_kind := sema_stmt_for_in_method_kind(collection_expr, collection)
                        iterable_item_type := Type?{None}
                        if method_kind == None && !range_source {
                            iterable := sema_stmt_for_in_iterable_fact(environment, program, collection.ty)
                            if iterable != None {
                                fact: iterable ?? SemaForInIterableFact{method_kind: TForInMethod.Chars, item_type: Type.Named{name: "Unit"}}
                                method_kind = Val(fact.method_kind)
                                iterable_item_type = Val(fact.item_type)
                            }
                        }
                        item_type_option := sema_stmt_for_in_item_type(collection.ty, method_kind, iterable_item_type)
                        item_type := item_type_option ?? Type.Named{name: "Unit"}
                        // A bindingless `loop xs -> .member` binds the implicit `it`,
                        // which bare member chains in the body read. Its source must
                        // be a collection of items: a scalar source (a range, or a
                        // value that is no loop source) and a nested bindingless loop
                        // are E0380, and the rejected loop declares no second `it`.
                        bindingless: var == "it" && var2 == None
                        nested_bindingless: bindingless && context.implicit_loop_subject_depth > 0
                        scalar_bindingless: bindingless && !nested_bindingless && collection_value != None && (range_source || item_type_option == None)
                        if nested_bindingless || scalar_bindingless {
                            diagnostics.push(sema_error("E0380", expr_source_span(collection_expr), "this loop needs a named source binding", "an implicit subject is one collection item; a scalar source or nested loop needs a distinct named binding", "write `loop item in source -> ...`; give nested loops named bindings"))
                            valid = false
                        }
                        // A source that failed its own check already reported why;
                        // its placeholder type is not a second loop-source error.
                        if item_type_option == None && collection_value != None && !scalar_bindingless {
                            diagnostics.push(sema_error("E0109", expr_source_span(collection_expr), "values of type {type_name(collection.ty)} can't be used as a loop source", "a `loop` source must provide one checked item type per step", "use a list, map, stream, iterator, reader, or registered Iterable value"))
                            valid = false
                        }
                        pair_types := sema_stmt_for_in_pair_types(collection.ty, item_type)
                        // #4604: a rejected two-name form already reported why; both
                        // names stay in scope untyped so body reads add no E0107.
                        pair_rejected := false
                        if var2 != None && collection_value != None {
                            if {
                                range_source -> {
                                    diagnostics.push(sema_error("E0109", expr_source_span(collection_expr), "a Range loop has one value per step", "Range values yield whole numbers, not key-value pairs", "use one loop name"))
                                    valid = false
                                    pair_rejected = true
                                }
                                !sema_stmt_for_in_method_pair_is_supported(method_kind) || pair_types == None -> {
                                    diagnostics.push(sema_error("E0109", expr_source_span(collection_expr), "`loop (x, y) in` on `{type_name(collection.ty)}` needs one loop name, not two", "this iterator yields one item per step; only maps and indexed sequences yield a pair", "use one loop name for this source"))
                                    valid = false
                                    pair_rejected = true
                                }
                            }
                        }
                        // A list whose elements owe a `#SingleUse` duty hands each one over.
                        consumes_collection := sema_stmt_for_in_consumes_collection(collection.ty, item_type) || (sema_stmt_for_in_is_list(collection.ty) && sema_single_use_type(item_type, environment, program))
                        task_list_consume: consumes_collection && sema_stmt_for_in_is_list(collection.ty)
                        owns_collection := !consumes_collection || (sema_stmt_for_in_can_consume_collection(collection_expr) && (!task_list_consume || sema_stmt_for_in_frame_owns(collection_expr, scopes, state)))
                        if !owns_collection {
                            if task_list_consume {
                                diagnostics.push(sema_stmt_for_in_borrowed_task_list(collection_expr, collection.ty, scopes, state))
                            } else {
                                diagnostics.push(sema_error("E0120", expr_span(collection_expr), "this loop can't take a stream or iterator out of a field or index", "each step pulls from the source itself, so the loop must take a whole value this scope owns", "bind it into a local this scope owns first (`src := …`), then write `loop x in src {{ … }}`"))
                            }
                            valid = false
                        }
                        loop_fork: sema_ownership_mark(state)
                        // #4318 §4: the source's root, resolved before the loop
                        // names can shadow it.
                        stable_root_key := sema_stmt_for_in_stable_root_key(collection_expr, scopes, state)
                        // The loop names over a collection a read or write
                        // parameter owns, or over a list of resources read in
                        // place, read each element through a view (resolved
                        // before the names can shadow the root).
                        borrowed_elements: !consumes_collection && !range_source && (sema_stmt_for_in_borrowed_elements(collection_expr, scopes) || sema_stmt_for_in_resource_elements(collection_expr, collection.ty, item_type, environment, program, context))
                        sema_scope_enter(scopes, state, "for.in@{span.start}")
                        label_name := String?{None}
                        if label != None {
                            label_name = Val(label.name)
                            if !sema_scope_push_loop_label(scopes, label.name) {
                                diagnostics.push(sema_already_defined(label.name, label.span))
                                valid = false
                            }
                        }
                        first_type := item_type
                        second_type := Type?{None}
                        if var2 != None && pair_types != None {
                            pair: pair_types ?? SemaForInPairTypes{first: item_type, second: item_type}
                            first_type = pair.first
                            second_type = Val(pair.second)
                        }
                        source_checked := collection_value != None
                        first_local_type := Type?{None}
                        second_local_type := Type?{None}
                        if source_checked && !pair_rejected && !scalar_bindingless {
                            first_local_type = Val(first_type)
                            second_local_type = Val(second_type ?? item_type)
                        }
                        // Each `#SingleUse` element a consuming loop hands over owes its
                        // own duty in the body; task handles keep their join rule.
                        element_owes_duty: ((consumes_collection && sema_stmt_for_in_is_list(collection.ty)) || sema_stmt_for_in_takes_map(collection_expr, collection.ty)) && !sema_stmt_for_in_type_requires_owned_iteration(item_type)
                        first_local := TLocal?{None}
                        if nested_bindingless {
                            valid = false
                        } else {
                            first_local = sema_stmt_for_in_decl_loop_local(var, var_span, first_local_type, element_owes_duty, environment, program, scopes, state, diagnostics)
                            if first_local == None -> valid = false
                        }
                        variable_two := TLocal?{None}
                        if var2 != None && (second_type != None || !source_checked || pair_rejected) {
                            variable_two = sema_stmt_for_in_decl_loop_local(var2.name, var2.span, second_local_type, element_owes_duty, environment, program, scopes, state, diagnostics)
                            if variable_two == None -> valid = false
                        }
                        if borrowed_elements && !nested_bindingless {
                            sema_scope_mark_place_alias(scopes, var)
                            if var2 != None -> sema_scope_mark_place_alias(scopes, var2.name)
                        }
                        lending_depth: context.lending_view_parameter_keys.len()
                        sema_stmt_for_in_lend_view_item(first_local, first_type, collection_expr, scopes, state, context)
                        sema_stmt_for_in_lend_view_item(variable_two, second_type ?? item_type, collection_expr, scopes, state, context)
                        loop_frame_index := context.loop_value_frames.len()
                        sema_loop_value_push_frame(context, label_name, loop_fork)
                        previous_arrow_loop_body := context.arrow_loop_body
                        context.arrow_loop_body = arrow_body
                        iter_borrowed_depth := context.iter_borrowed.len()
                        if sema_stmt_for_in_driven_root(collection_expr) == .Val(driven) -> context.iter_borrowed.push(driven)
                        references_before := state.references.len()
                        if bindingless && !nested_bindingless -> context.implicit_loop_subject_depth += 1
                        nested := sema_check_statements(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth + 1)
                        if bindingless && !nested_bindingless -> context.implicit_loop_subject_depth -= 1
                        loop context.lending_view_parameter_keys.len() > lending_depth -> _ := context.lending_view_parameter_keys.pop()
                        source_stable := stable_root_key != None && sema_stmt_for_in_body_keeps(state, references_before, stable_root_key ?? "", nested.value, context.arena.tree)
                        loop context.iter_borrowed.len() > iter_borrowed_depth -> _ := context.iter_borrowed.pop()
                        context.arrow_loop_body = previous_arrow_loop_body
                        if !nested.complete -> valid = false
                        if label != None -> sema_scope_pop_loop_label(scopes)
                        sema_single_use_leave_scope(scopes, state, diagnostics)
                        if !sema_stmt_close_loop_value_frame(context, loop_frame_index, nested.value, state, loop_fork, false, true, environment, program, diagnostics) -> valid = false
                        if consumes_collection && owns_collection {
                            if collection_expr == {
                                .Ident(_, _, _) -> {
                                    if !sema_ownership_mark_move(state, collection_expr, scopes, "`.loop()`", diagnostics) -> valid = false
                                }
                                else -> {}
                            }
                        }
                        if {
                            !valid -> complete = false
                            else -> {
                                variable: first_local ?? panic("checked loop name has no declared local")
                                if {
                                    range_source -> {
                                        zero_start := sema_stmt_for_in_range_zero(span)
                                        zero_end := sema_stmt_for_in_range_zero(span)
                                        output.push(TStmt.Range{label: label_name, variable: variable, source: Val(collection), start: zero_start, end: zero_end, step: step_value, exclusive: false, vectorization: None, body: nested.value, span: span})
                                    }
                                    else -> {
                                        source_value := sema_stmt_for_in_source(collection_expr, collection, method_kind)
                                        columnar := var2 == None && method_kind == None && sema_stmt_for_in_columnar_list_type(collection.ty) && sema_stmt_for_in_columnar(environment, program, item_type)
                                        // `loop (k, v) in table.move()` takes the map, so its walk takes the entries.
                                        by_value := (consumes_collection && (sema_stmt_for_in_by_value(collection.ty, item_type) || sema_stmt_for_in_is_list(collection.ty))) || sema_stmt_for_in_takes_map(collection_expr, collection.ty)
                                        stable := source_stable && method_kind == None && step_value == None && !by_value && !columnar && sema_stmt_for_in_stable_list(collection.ty)
                                        output.push(TStmt.ForIn{label: label_name, variable: variable, variable_two: variable_two, source: source_value, collection: collection, step: step_value, method_kind: method_kind, columnar: columnar, by_value: by_value, source_stable: stable, body: nested.value, span: span})
                                    }
                                }
                            }
                        }
                    }
                    else -> complete = false
                }
            }
            .CountedLoop(init, cond, step, body, span, arrow_body, label) -> {
                // copy: sema_stmt_check_binding reads the escapes as they were before the loop,
                // while the binding, condition and body checks write context.lambda_escapes through
                // `&context`, so a view would be live across those writes.
                init_lambda_escapes: context.lambda_escapes.copy()
                sema_scope_enter(scopes, state, "counted@{span.start}")
                loop_scope_valid := true
                label_name := String?{None}
                if label != None {
                    label_name = Val(label.name)
                    if !sema_scope_push_loop_label(scopes, label.name) {
                        diagnostics.push(sema_already_defined(label.name, label.span))
                        loop_scope_valid = false
                    }
                }
                init_tree := sema_stmt_check_binding(init, init_lambda_escapes, environment, program, scopes, state, tail_store, context, diagnostics)
                sema_shared_access_lint_busy_wait(cond, body, scopes, diagnostics)
                cond_tree := sema_check_expression(cond, None, environment, program, scopes, state, tail_store, context, diagnostics)
                cond_valid := cond_tree != None
                if cond_tree != None && sema_stmt_condition_type(cond_tree) != Type.Bool {
                    cond_ty: sema_stmt_condition_type(cond_tree)
                    diagnostics.push(if sema_dyn_is_type(sema_expr_expected_type(cond_ty, environment, program)) -> sema_dyn_condition_error(span) else -> sema_error("E0110", expr_span(cond), "a `loop` condition must be Bool (true or false), but this is {sema_type_show(cond_ty)}", "the program needs a clear yes or no here", "compare the value to something, e.g. `x > 0` or `name == \"ok\"`"))
                    cond_valid = false
                }
                // Each iteration starts from this mark; the join base is the
                // counted loop's own scope left (`outer`).
                loop_fork: sema_ownership_mark(state)
                loop_frame_index := context.loop_value_frames.len()
                sema_loop_value_push_frame(context, label_name, loop_fork)
                previous_arrow_loop_body := context.arrow_loop_body
                context.arrow_loop_body = arrow_body
                nested := sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "counted.body@{span.start}", loop_depth + 1)
                context.arrow_loop_body = previous_arrow_loop_body
                step_tree := TStmt?{None}
                step_valid := true
                if step != None {
                    checked_step: sema_stmt_check_loop_step(step, environment, program, scopes, state, tail_store, context, diagnostics)
                    if checked_step == None -> step_valid = false else -> step_tree = checked_step
                }
                if label != None -> sema_scope_pop_loop_label(scopes)
                sema_single_use_leave_scope(scopes, state, diagnostics)
                if !sema_stmt_close_loop_value_frame(context, loop_frame_index, nested.value, state, loop_fork, true, true, environment, program, diagnostics) -> loop_scope_valid = false
                // Rust emit_loop_liveness_lints_for_stmt runs after the statement is checked.
                sema_stmt_lint_state_loop_unchanged(init, cond, step, body, label, diagnostics)
                if {
                    init_tree == None || !cond_valid || !nested.complete || !step_valid || !loop_scope_valid -> complete = false
                    else -> {
                        init_value: init_tree ?? {
                            sema_stmt_leave_statements(context, tail_store, tail_frame_depth, tail_body_id, entered_nesting)
                            sema_stmt_restore_statement_scopes(scopes, previous_return_type, previous_failure_carrier, previous_loop_depth)
                            return SemaStatementResult{value: output, complete: false}
                        }
                        cond_value: cond_tree ?? {
                            sema_stmt_leave_statements(context, tail_store, tail_frame_depth, tail_body_id, entered_nesting)
                            sema_stmt_restore_statement_scopes(scopes, previous_return_type, previous_failure_carrier, previous_loop_depth)
                            return SemaStatementResult{value: output, complete: false}
                        }
                        output.push(TStmt.CountedLoop{label: label_name, init: init_value, condition: cond_value, step: step_tree, vectorization: None, body: nested.value, span: span})
                    }
                }
            }
            .While(condition, body, span, arrow_body, label) -> {
                sema_shared_access_lint_busy_wait(condition, body, scopes, diagnostics)
                // `loop items.pop() == .Val(item) { … }` binds the payload for
                // each pass, checked as `loop { if items.pop() == .Val(item) { … }
                // else { break } }` so the pattern test runs before every pass.
                binding_loop: sema_expression_condition_binds(condition)
                if binding_loop {
                    gate: Stmt.Switch{subject: Expr.Bool{value: true, span: span, id: AST_NODE_GENERATED}, arms: [SwitchArm]{SwitchArm{cond: condition.copy(), body: body.copy(), span: expr_span(condition)}}, else_body: Val([Stmt]{Stmt.Break{span: span}}), span: span}
                    if !sema_stmt_check_loop([Stmt]{gate}, span, arrow_body, label, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth, output) -> complete = false
                }
                cond: if binding_loop -> TExpr?{None} else -> sema_check_expression(condition, None, environment, program, scopes, state, tail_store, context, diagnostics)
                if {
                    binding_loop -> {}
                    cond == None -> {
                        complete = false
                    }
                    sema_stmt_condition_type(cond) != Type.Bool -> {
                        cond_ty: sema_stmt_condition_type(cond)
                        diagnostics.push(if sema_dyn_is_type(sema_expr_expected_type(cond_ty, environment, program)) -> sema_dyn_condition_error(span) else -> sema_error("E0110", expr_span(condition), "a `loop` condition must be Bool (true or false), but this is {sema_type_show(cond_ty)}", "the program needs a clear yes or no here", "compare the value to something, e.g. `x > 0` or `name == \"ok\"`"))
                        complete = false
                    }
                    else -> {
                        loop_fork: sema_ownership_mark(state)
                        loop_scope_valid := true
                        sema_scope_enter(scopes, state, "while@{span.start}")
                        label_name := String?{None}
                        if label != None {
                            label_name = Val(label.name)
                            if !sema_scope_push_loop_label(scopes, label.name) {
                                diagnostics.push(sema_already_defined(label.name, label.span))
                                loop_scope_valid = false
                            }
                        }
                        loop_frame_index := context.loop_value_frames.len()
                        sema_loop_value_push_frame(context, label_name, loop_fork)
                        previous_arrow_loop_body := context.arrow_loop_body
                        context.arrow_loop_body = arrow_body
                        nested := sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "while.body@{span.start}", loop_depth + 1)
                        context.arrow_loop_body = previous_arrow_loop_body
                        if label != None -> sema_scope_pop_loop_label(scopes)
                        sema_single_use_leave_scope(scopes, state, diagnostics)
                        // Rust `check_stmt`: a literal `true` condition never
                        // skips the body, as `loop`.
                        if !sema_stmt_close_loop_value_frame(context, loop_frame_index, nested.value, state, loop_fork, false, !sema_stmt_refutable_expr_is_true(condition), environment, program, diagnostics) -> loop_scope_valid = false
                        if nested.complete && loop_scope_valid -> sema_single_use_note_drain(state, condition, body, scopes)
                        if {
                            !nested.complete || !loop_scope_valid -> complete = false
                            else -> output.push(TStmt.While{label: label_name, condition: cond, body: nested.value, span: span})
                        }
                    }
                }
            }
            .Loop(body, span, arrow_body, label) -> {
                if !sema_stmt_check_loop(body, span, arrow_body, label, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth, output) -> complete = false
            }
            // An arm must fall through to the statement loop's `index += 1`:
            // a `next` here re-checks the same statement forever, pushing one
            // more diagnostic each time.
            .Break(span) -> {
                resolved: sema_loop_value_resolve_frame(context, None)
                if resolved == .Val(frame_index) {
                    frame: context.loop_value_frames[frame_index]
                    if {
                        !sema_stmt_loop_value_break_missing_payload(frame, span, diagnostics) -> {
                            complete = false
                        }
                        else -> {
                            sema_loop_value_record_break(context, frame_index, state)
                            output.push(TStmt.Break{label: None, span: span})
                        }
                    }
                } else {
                    diagnostics.push(sema_error("E0115", span, "`break` only works inside a loop", "`break` and `next` steer the nearest `loop` loop", "move this inside a loop, or remove it"))
                    complete = false
                }
            }
            .BreakValue(value, span) -> {
                checked: sema_stmt_check_loop_value_break(value, None, span, span, environment, program, scopes, state, tail_store, context, diagnostics)
                if checked == {
                    .Val(checked_statement) -> output.push(checked_statement)
                    else -> complete = false
                }
            }
            .Continue(span) -> {
                if {
                    loop_depth == 0 -> {
                        diagnostics.push(sema_error("E0115", span, "`next` only works inside a loop", "`break` and `next` steer the nearest `loop` loop", "move this inside a loop, or remove it"))
                        complete = false
                    }
                    else -> {
                        if sema_loop_value_resolve_frame(context, None) == .Val(frame_index) -> sema_ownership_check_loop_move_backedge(state, context.loop_value_frames[frame_index], diagnostics)
                        output.push(TStmt.Continue{label: None, span: span})
                    }
                }
            }
            .BreakLabel(name, span) -> {
                resolved: if sema_scope_has_loop_label(scopes, name) -> sema_loop_value_resolve_frame(context, Val(name)) else -> None
                if resolved == .Val(frame_index) {
                    frame: context.loop_value_frames[frame_index]
                    if {
                        !sema_stmt_loop_value_break_missing_payload(frame, span, diagnostics) -> {
                            complete = false
                        }
                        else -> {
                            sema_loop_value_record_break(context, frame_index, state)
                            output.push(TStmt.Break{label: Val(name), span: span})
                        }
                    }
                } else {
                    diagnostics.push(sema_stmt_unknown_loop_label(scopes, name, span))
                    complete = false
                }
            }
            .BreakLabelValue(name, name_span, value, span) -> {
                checked: sema_stmt_check_loop_value_break(value, Val(name), name_span, span, environment, program, scopes, state, tail_store, context, diagnostics)
                if checked == {
                    .Val(checked_statement) -> output.push(checked_statement)
                    else -> complete = false
                }
            }
            .ContinueLabel(name, span) -> {
                if {
                    !sema_scope_has_loop_label(scopes, name) -> {
                        diagnostics.push(sema_stmt_unknown_loop_label(scopes, name, span))
                        complete = false
                    }
                    else -> {
                        if sema_loop_value_resolve_frame(context, Val(name)) == .Val(frame_index) -> sema_ownership_check_loop_move_backedge(state, context.loop_value_frames[frame_index], diagnostics)
                        output.push(TStmt.Continue{label: Val(name), span: span})
                    }
                }
            }
            .Yield(value, span) -> {
                checked: sema_stmt_check_yield(value, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics)
                if checked == {
                    .Val(checked_statement) -> output.push(checked_statement)
                    else -> complete = false
                }
            }
            .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Region(_, _, _, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .Switched(_, _, _) | .Transact(_, _, _, _, _) | .Policy(_, _, _) | .AuthorityScope(_, _, _, _, _) | .TaskGroup(_, _, _, _, _) -> {
                if !sema_stmt_check_scoped_statement(statements[index], return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth, output) -> complete = false
            }
            .ComptimeIf(cond, cond_span, then_body, else_body, span, _) -> {
                if !sema_stmt_check_prep_if(cond, cond_span, then_body, else_body, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth, output) -> complete = false
            }
            .ComptimeSwitch(subject, arms, else_body, span) -> {
                if !sema_stmt_check_prep_switch(subject, arms, else_body, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth, output) -> complete = false
            }
            .ComptimeBlock(body, is_template_loop, span) -> {
                if is_template_loop {
                    complete = false
                    sema_check_unsupported(context, "the statement-level `comptime` block at offset {span.start} is not executed by the self-hosted checker yet")
                } else if !sema_stmt_check_comptime_block(body, span, environment, program, scopes, state, tail_store, context, diagnostics) {
                    complete = false
                }
            }
            .ContextBlock(fields, body, span) -> {
                if !sema_stmt_check_context_block(fields, body, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth, output) -> complete = false
            }
            .Layout(name, name_span, body, span) -> {
                if !sema_stmt_check_layout(name, name_span, body, span, environment, program, scopes, state, tail_store, context, diagnostics, output) -> complete = false
            }
        }
        if statements[index] == {
            .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) -> reachable = false
            .Loop(body, _, _, _) -> {
                if !sema_stmt_refutable_loop_body_can_break(body) -> reachable = false
            }
            // Rust flow facts: a table whose every path leaves, or a literal
            // `true` loop that nothing breaks, ends the reachable path too.
            .Switch(_, _, _, _) | .While(_, _, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) -> {
                if sema_stmt_refutable_statement_exits(statements[index]) -> reachable = false
            }
            .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Shield(body, _) | .Live(body, _) | .AssumeDet(_, _, body, _) | .Region(_, _, body, _) | .AuthorityScope(_, _, _, body, _) -> {
                if sema_stmt_refutable_block_exits(body) -> reachable = false
            }
            .ScopeMember(name, _, _, _, body, _, _, _) -> {
                if name != "skip" && name != "expect_fail" && sema_stmt_refutable_block_exits(body) -> reachable = false
            }
            .Transact(_, _, body, _, _) | .Policy(_, body, _) -> {
                if sema_stmt_block_has_no_fallthrough(body) -> reachable = false
            }
            else -> {}
        }
        if output.len() > output_start && sema_stmt_checked_never(output[output.len() - 1]) -> reachable = false
        sema_stmt_note_silent_incomplete(statements[index], statement_complete, complete, diagnostics, statement_diagnostics, context, statement_reasons)
        index += 1
    }
    sema_stmt_leave_statements(context, tail_store, tail_frame_depth, tail_body_id, entered_nesting)
    scopes.return_type = previous_return_type
    scopes.failure_carrier = previous_failure_carrier
    scopes.loop_depth = previous_loop_depth
    SemaStatementResult{value: output, complete: complete}
}

// A `loop { … }` statement: its label and value frame, then its body one
// loop level deeper. False when the loop does not check.
sema_stmt_check_loop: fn(body: [Stmt], span: Span, arrow_body: Bool, label: NamedSpan?, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int, output: &[TStmt]) -> Bool {
    loop_fork: sema_ownership_mark(state)
    sema_scope_enter(scopes, state, "loop@{span.start}")
    label_name := String?{None}
    label_valid := true
    if label != None {
        label_name = Val(label.name)
        if !sema_scope_push_loop_label(scopes, label.name) {
            diagnostics.push(sema_already_defined(label.name, label.span))
            label_valid = false
        }
    }
    loop_frame_index := context.loop_value_frames.len()
    sema_loop_value_push_frame(context, label_name, loop_fork)
    previous_arrow_loop_body := context.arrow_loop_body
    context.arrow_loop_body = arrow_body
    nested := sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "loop.body@{span.start}", loop_depth + 1)
    context.arrow_loop_body = previous_arrow_loop_body
    if label != None -> sema_scope_pop_loop_label(scopes)
    sema_single_use_leave_scope(scopes, state, diagnostics)
    if !sema_stmt_close_loop_value_frame(context, loop_frame_index, nested.value, state, loop_fork, false, false, environment, program, diagnostics) -> label_valid = false
    if !nested.complete || !label_valid -> return false
    output.push(TStmt.Loop{label: label_name, body: nested.value, span: span})
    true
}

// Whether a checked statement is an expression statement of type `Never`;
// read in place so the last output row is not copied.
sema_stmt_checked_never: fn(statement: TStmt) -> Bool Never! {
    if statement == .ExprStmt(value, _) -> return value.ty == (Type.Named{name: "Never"})
    false
}

// Collect-all: a statement that left its list incomplete with no error report
// and no recorded reason names itself, so the stop always says where it is.
// A nested list records its own statement first; the enclosing one then sees
// that reason and adds nothing.
sema_stmt_note_silent_incomplete: fn(statement: Stmt, was_complete: Bool, complete: Bool, diagnostics: [Diagnostic], diagnostics_start: Int, context: &SemaCheckContext, reasons_start: Int) {
    if !was_complete || complete -> return
    if context.incomplete_reasons.len() != reasons_start || sema_has_error_since(diagnostics, diagnostics_start) -> return
    span: sema_compiler_index_stmt_span(statement)
    sema_check_unsupported(context, "the statement at offset {span.start}..{span.end} checked incomplete without a report")
}

// sema_check_statements's statement after an exit: checked on the live tables
// and rolled back, keeping only its failure rows. False when it is incomplete.
// A separate function keeps sema_check_statements within what one backend
// codegen unit compiles quickly; the split arms below exist for the same reason.
sema_stmt_check_unreachable_statement: fn(statement: Stmt, index: Int, statements: [Stmt], return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> Bool {
    complete := true
    // Checked on the live tables and rolled back; only its failure
    // rows are kept.
    dead_scope_mark: sema_scope_mark(scopes)
    dead_state := sema_ownership_state_snapshot(state)
    dead_mark: sema_check_context_mark(context)
    // A dead last line is checked for its own diagnostics, never as the value
    // the function hands back. Rust `check_value_tail`: a dead value line keeps
    // the promised type as context (so a bare `None` still types).
    dead_value_tail := false
    if index + 1 == statements.len() && statement == .Expr(tail) && context.value_tail_span == (Val(expr_span(tail))) && !sema_stmt_refutable_expr_diverges(tail) {
        dead_value_tail = true
        context.value_tail_span = None
        if !sema_stmt_check_dead_value_tail(tail, return_type, environment, program, scopes, dead_state, tail_store, context, diagnostics) -> complete = false
    }
    context.value_tail_span = None
    if !dead_value_tail {
        dead_result: sema_check_statements([Stmt]{statement}, return_type, environment, program, scopes, dead_state, tail_store, context, diagnostics, loop_depth)
        if !dead_result.complete -> complete = false
    }
    dead_edges := [String]{}
    // A dead `break value` still types its loop (`loop { break(outer, 1)
    // break 2 }` is an Int loop): the frames open at the mark keep the result
    // type the dead line gave them.
    dead_frame_types := [Type?]{}
    loop frame_index in 0..<dead_mark.saved.loop_value_frames.len() -> dead_frame_types.push(context.loop_value_frames[frame_index].ty)
    loop edge_index in dead_mark.failure_edges..<context.failure_edges.len() -> dead_edges.push(context.failure_edges[edge_index])
    dead_direct_source: context.failure_direct_source
    dead_members := [Type]{}
    loop member_index in dead_mark.failure_union_members..<context.failure_union_members.len() -> dead_members.push(context.failure_union_members[member_index])
    dead_cases := [SemaFailureCase]{}
    loop case_index in dead_mark.failure_union_cases..<context.failure_union_cases.len() -> dead_cases.push(context.failure_union_cases[case_index])
    dead_union_edges := [String]{}
    loop union_edge_index in dead_mark.failure_union_edges..<context.failure_union_edges.len() -> dead_union_edges.push(context.failure_union_edges[union_edge_index])
    dead_general: context.failure_union_general
    sema_check_context_rollback(context, dead_mark)
    sema_scope_rollback(scopes, dead_scope_mark)
    // #3708: dead source still counts toward the body's failure rows.
    loop edge in dead_edges -> context.failure_edges.push(edge)
    if dead_direct_source -> context.failure_direct_source = true
    // So does a dead failure on the default route.
    loop member in dead_members -> context.failure_union_members.push(member)
    loop failure_case in dead_cases -> context.failure_union_cases.push(failure_case)
    loop union_edge in dead_union_edges -> context.failure_union_edges.push(union_edge)
    context.failure_union_general = dead_general
    loop frame_index in 0..<dead_frame_types.len() {
        if context.loop_value_frames[frame_index].ty == None && dead_frame_types[frame_index] != None -> context.loop_value_frames[frame_index].ty = dead_frame_types[frame_index]
    }
    complete
}

// sema_check_statements's expression statement. False when it is incomplete.
sema_stmt_check_expression_statement: fn(expr: Expr, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int, output: &[TStmt]) -> Bool {
    // A parenthesized `if` statement is the same statement as the bare one.
    if expr == .Paren(inner, _, _) && sema_stmt_is_paren_if(inner) -> return sema_stmt_check_expression_statement(inner, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth, output)
    complete := true
    // `.drop("reason")` is the explicit-discard
    // terminal; it checks its receiver without propagation.
    dropped: sema_stmt_check_drop(expr, environment, program, scopes, state, tail_store, context, diagnostics)
    if dropped.handled {
        if dropped.value == {
            .Val(statement_value) -> output.push(statement_value)
            .None -> complete = false
        }
    }
    // A writing call on a shared place whose arguments read shared state runs
    // in one implicit transaction with them (sema_shared_access_place_call_transaction).
    if !dropped.handled {
        if sema_shared_access_place_call_transaction(expr, environment, program, scopes) == .Val(transaction) {
            checked: sema_stmt_check_shared_transaction(transaction, environment, program, scopes, state, tail_store, context, diagnostics)
            sema_shared_cycle_check_hoisted_call(expr, environment, program, scopes, state, diagnostics)
            if checked == {
                .Val(value) -> output.push(value)
                .None -> complete = false
            }
            return complete
        }
    }
    if !dropped.handled {
        if expr == {
            .If(_, _, _, _, _, _, _) -> {
                checked: sema_stmt_check_unit_if(expr, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
                if {
                    !checked.complete || checked.value.len() == 0 -> complete = false
                    else -> {
                        // A hoisted dispatch subject's binding precedes the chain.
                        conditions: sema_coverage_noelse_statement_conditions(expr, checked.value[checked.value.len() - 1])
                        if conditions == .Val(table) {
                            sema_coverage_check_unreachable_arms(table, false, diagnostics)
                            sema_coverage_check_table(table, false, expr_span(expr), environment, program, diagnostics)
                        }
                        // L0303 (#3716): a table whose arms cover a closed set has an `else` that can never run.
                        if sema_coverage_is_else_table(environment, program, expr_span(expr)) -> sema_coverage_check_redundant_else(sema_coverage_else_statement_conditions(expr, checked.value[checked.value.len() - 1]), expr_span(expr), environment, program, diagnostics)
                        loop checked_statement in checked.value -> output.push(checked_statement)
                    }
                }
            }
            else -> {
                discard_fact_start: context.call_facts.len()
                discard_diagnostic_start: diagnostics.len()
                // A direct call statement in a callback with no return row
                // keeps the Result its callee declares (the Rust reference's
                // open-callback statement root): the statement reports it
                // unchecked (E0402) and the callback's return row becomes
                // that carrier.
                raw_call: context.failure_inference && context.callback_return_open && expr == .Call(_, _) && sema_failure_source_declares_failure(Val(expr), environment, program, scopes)
                value: if raw_call -> sema_check_expression_carrier(expr, None, environment, program, scopes, state, tail_store, context, diagnostics) else -> sema_check_expression(expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
                if raw_call && context.callback_return_row == None && value == .Val(raw) {
                    if sema_stmt_type_is_fallible(raw.ty) && sema_expr_unwrap_tag(raw.ty) == .Result(_, _) -> context.callback_return_row = Val(sema_expr_unwrap_tag(raw.ty))
                }
                if {
                    value != None -> {
                        checked: value
                        // E0419: a `#MustUse` result dropped here.
                        if !sema_stmt_type_is_fallible(checked.ty) -> sema_must_use_check_statement(expr, checked.ty, expr_span(expr), environment, program, scopes, diagnostics)
                        if {
                            sema_stmt_type_is_unit_success(checked.ty) -> output.push(TStmt.ExprStmt{value: checked, span: expr_span(expr)})
                            sema_stmt_type_is_fallible(checked.ty) -> {
                                // A failure that survives to statement
                                // position (a non-propagating carrier) must be handled.
                                diagnostics.push(sema_error("E0402", expr_span(expr), "this call can fail and nothing checks it", "a fallible result can't be ignored — handle it or say failure is impossible", "use `?`, `??`, `panic ...`, or `.drop(\"reason\")` to intentionally discard"))
                                complete = false
                            }
                            else -> {
                                // The last line of a function with no
                                // written return type; its value goes nowhere.
                                lost_tail: context.lost_tail_span == (Val(expr_span(expr)))
                                // Any other discarded value lowers like an explicit
                                // `.drop("reason")`; the solved effect phase reports
                                // E0433 when its callee turns out pure.
                                if {
                                    lost_tail -> {
                                        if diagnostics.len() == discard_diagnostic_start -> diagnostics.push(sema_stmt_lost_tail_diagnostic(context.function_name, type_name(checked.ty), expr))
                                        // The checked statement stays in the body, and the
                                        // body stays complete, so the flow passes after it
                                        // (typestate) still read it.
                                        output.push(TStmt.ExprStmt{value: checked, span: expr_span(expr)})
                                    }
                                    else -> {
                                        sema_stmt_mark_discarded_result(program, checked, discard_fact_start, context)
                                        output.push(TStmt.ExprStmt{value: checked, span: expr_span(expr)})
                                    }
                                }
                            }
                        }
                    }
                    else -> complete = false
                }
            }
        }
    }
    complete
}

// Whether `expr` is an `if`, under any number of parentheses.
sema_stmt_is_paren_if: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .If(_, _, _, _, _, _, _) -> true
        .Paren(inner, _, _) -> sema_stmt_is_paren_if(inner)
        else -> false
    }
}

// Rust CheckerCore `Stmt::ContextBlock` each field
// value is checked once in the enclosing scope (`deadline` is an Int
// epoch-millis instant, `allocator` an `Arena`, `Bump`, `Pool` or `Fixed`
// handle, `logger` any value; the parser already rejected unknown fields,
// E0761), then the body is an ordinary nested block. Lowering installs the
// guards around the body (jet_codegen_lower_context_block).
sema_stmt_check_context_block: fn(fields: [ContextField], body: [Stmt], span: Span, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int, output: &[TStmt]) -> Bool {
    // Rust binds the block's `#Context` application first; fields that do
    // not bind (E0930) get no E0762 of their own.
    signature_valid: sema_marker_rules_check_context_fact(span, environment, program, scopes, state, tail_store, context, diagnostics)
    complete := signature_valid
    guards := [TContextGuard]{}
    loop field in fields {
        checked: sema_check_expression(field.value, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
            complete = false
            next
        }
        if signature_valid && field.name == "deadline" && !sema_stmt_context_deadline_type(checked.ty) {
            diagnostics.push(sema_error("E0762", field.span, "`deadline` needs an Int epoch-millis instant, got {sema_type_show(checked.ty)}", "the `deadline` field carries an absolute time budget in milliseconds", "pass an Int, e.g. `time.now() + 200`"))
            complete = false
        }
        if signature_valid && field.name == "allocator" && !sema_stmt_context_allocator_type(checked.ty) {
            diagnostics.push(sema_error("E0762", field.span, "`allocator` needs an allocator, got {sema_type_show(checked.ty)}", "the `allocator` field takes an `Arena`, `Bump`, `Pool`, or `Fixed` value", "pass an allocator, e.g. `mem.Arena.new()`"))
            complete = false
        }
        guards.push(TContextGuard{field: field.name, value: checked})
    }
    previous_allocation: scopes.context_allocation
    names_allocator := false
    loop field in fields {
        if field.name == "allocator" -> names_allocator = true
    }
    scopes.context_allocation = if names_allocator || previous_allocation == 2 -> 2 else -> 1
    nested: sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "context@{span.start}", loop_depth)
    scopes.context_allocation = previous_allocation
    if !nested.complete -> return false
    if !complete -> return false
    output.push(TStmt.ContextBlock{guards: guards, body: nested.value, span: span})
    true
}

sema_stmt_context_deadline_type: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .InlineRange(_, _, _) -> true
        else -> false
    }
}

sema_stmt_context_allocator_type: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> name == "Arena" || name == "Bump" || name == "Pool" || name == "Fixed"
        else -> false
    }
}

// Rust CheckerCore `check_comptime_if`
// `comptime if` selects a branch while building. Its condition is compile-time
// code, like `name: comptime { value }` (sema_stmt_check_prepared_binding): a
// value already known here selects at once; any other value is staged through
// the body comptime evaluator, and the branch is selected when the owner body
// is checked again. The selected arm is an ordinary nested block emitted
// inline; the dropped arm is checked for name resolution only (its other
// reports and everything it did to the scope, the context and the ownership
// state are rolled back). False while the arm is unselected or incomplete.
sema_stmt_check_prep_if: fn(cond: Expr, cond_span: Span, then_body: [Stmt], else_body: [Stmt]?, span: Span, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int, output: &[TStmt]) -> Bool {
    // `comptime if T == Int { … }` is the one-arm type test,
    // which already keeps its arm only in the `Int` instance.
    if sema_expression_type_table_param(cond, environment, scopes) != None {
        arm: SwitchArm{cond: cond, body: then_body, span: cond_span}
        return sema_stmt_check_prep_type_table(Expr.Bool{value: true, span: span, id: AST_NODE_GENERATED}, [SwitchArm]{arm}, else_body, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth, output)
    }
    fact_start: context.call_facts.len()
    scopes.comptime_execution_depth += 1
    checked: sema_check_expression(cond, None, environment, program, scopes, state, tail_store, context, diagnostics)
    scopes.comptime_execution_depth -= 1
    condition: checked ?? return false
    if sema_stmt_comptime_site_refused(context, fact_start, diagnostics) -> return false
    // A prepared local reads as its value, so a local left in the checked
    // condition is known only at run time.
    runtime_local := false
    sema_stmt_reads_runtime_local(condition, context.arena.tree, runtime_local)
    if runtime_local {
        diagnostics.push(sema_error("E0989", cond_span, "this `comptime if` condition can't be known at compile time", "a `comptime if` condition must be a known-time expression — a prepared value, a literal, or a pure function call with known arguments", "prepare the value first: `flag: comptime {{ … }}`, then write `comptime if flag {{ … }}`"))
        return false
    }
    if sema_expr_unwrap_tag(condition.ty) != Type.Bool {
        diagnostics.push(sema_stmt_prep_if_not_bool(cond_span))
        return false
    }
    value := sema_expr_comptime_value(condition, context)
    if value == None -> value = sema_fact_constant_path_value(condition, context)
    if value == None {
        staged: sema_comptime_body_value_find(context, environment.module_identity, sema_scope_function_owner_key(scopes), cond_span, span)
        if staged == .Val(body_value) {
            value = Val(body_value.value)
        } else {
            _ := sema_comptime_body_capture(context, environment, program, scopes, "comptime if", cond, condition.ty, cond_span, span)
            return false
        }
    }
    known: value ?? return false
    selected := false
    if known == .Bool(flag) {
        selected = flag
    } else {
        diagnostics.push(sema_stmt_prep_if_not_bool(cond_span))
        return false
    }
    owner: "prep-if@{span.start}"
    nested := SemaStatementResult{value: [TStmt]{}, complete: true}
    if selected {
        nested = sema_stmt_check_block(then_body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, owner, loop_depth)
        if else_body == .Val(dropped) -> sema_stmt_check_dropped_prep_arm(dropped, return_type, environment, program, scopes, state, tail_store, context, diagnostics, owner, loop_depth)
    } else {
        if else_body == .Val(chosen) -> nested = sema_stmt_check_block(chosen, return_type, environment, program, scopes, state, tail_store, context, diagnostics, owner, loop_depth)
        sema_stmt_check_dropped_prep_arm(then_body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, owner, loop_depth)
    }
    if !nested.complete -> return false
    output.push(TStmt.Inline{body: nested.value, span: span})
    true
}

// Rust CheckerCore `check_comptime_block`
// `comptime { … }` is compile-time code and emits no runtime code. Its
// statements are staged through the body comptime evaluator like a
// `comptime if` condition (sema_stmt_check_prep_if), reading the prepared
// locals before it; once the run lands, the owner body is checked again and
// the block leaves nothing behind. A failed check or a panic stops the build.
// False while the block is staged.
sema_stmt_check_comptime_block: fn(body: [Stmt], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if sema_comptime_body_value_find(context, environment.module_identity, sema_scope_function_owner_key(scopes), span, span) != None -> return true
    block: Expr.If{
        cond: Expr.Bool{value: true, span: span, id: AST_NODE_GENERATED},
        then_body: body,
        then_value: Expr.Unit{span: span, id: AST_NODE_GENERATED},
        else_body: [Stmt]{},
        else_value: Expr.Unit{span: span, id: AST_NODE_GENERATED},
        span: span,
        id: AST_NODE_GENERATED,
    }
    fact_start: context.call_facts.len()
    scopes.comptime_execution_depth += 1
    checked: sema_check_expression(block, None, environment, program, scopes, state, tail_store, context, diagnostics)
    scopes.comptime_execution_depth -= 1
    checked_block: checked ?? return false
    if sema_stmt_comptime_site_refused(context, fact_start, diagnostics) -> return false
    _ := sema_comptime_body_capture(context, environment, program, scopes, "comptime block", block, checked_block.ty, span, span)
    false
}

// `arena` holds the rows of the condition's flat nodes (sema_node).
sema_stmt_reads_runtime_local: fn(expression: TExpr, arena: BodyTree, found: &Bool) Never! {
    if expression.kind == {
        .Local(_) -> {
            found = true
            return
        }
        .Flat(index) -> return sema_stmt_row_reads_runtime_local(arena, index, found)
        else -> {}
    }
    tree_each_expr_child(expression, (child: TExpr) -> sema_stmt_reads_runtime_local(child, arena, found))
}

sema_stmt_row_reads_runtime_local: fn(tree: BodyTree, index: Int, found: &Bool) Never! {
    if tree.nodes[index - tree.node_base].kind == .Local(_) {
        found = true
        return
    }
    body_each_node_kind_child(tree, tree.nodes[index - tree.node_base].kind, (child: Int) -> sema_stmt_row_reads_runtime_local(tree, child, found))
}

sema_stmt_prep_if_not_bool: fn(cond_span: Span) -> Diagnostic {
    sema_error("E0989", cond_span, "a `comptime if` condition must be Bool, not another type", "the condition selects a branch at compile time — it must be true or false", "write a Bool known-time expression, like `comptime if flag {{ … }}`")
}

// The dropped arm is not a path through this code.
// It is walked for name resolution only: unknown names (E0107, E0102) are
// reported, and nothing else it reports or does survives it.
sema_stmt_check_dropped_prep_arm: fn(body: [Stmt], return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], owner: String, loop_depth: Int) {
    scope_mark: sema_scope_mark(scopes)
    context_mark: sema_check_context_mark(context)
    fork: sema_ownership_fork(state)
    arm_diagnostics := [Diagnostic]{}
    _ := sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, arm_diagnostics, "{owner}.dropped", loop_depth)
    sema_ownership_fork_rollback(state, fork)
    sema_ownership_fork_close(state, fork)
    sema_check_context_rollback(context, context_mark)
    sema_scope_rollback(scopes, scope_mark)
    loop diagnostic in arm_diagnostics {
        if diagnostic.code == "E0107" || diagnostic.code == "E0102" -> diagnostics.push(diagnostic)
    }
}

// `comptime` on a type table or type test changes nothing: it is checked
// as the plain form (sema_stmt_check_switch).
sema_stmt_check_prep_type_table: fn(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int, output: &[TStmt]) -> Bool {
    table := sema_stmt_check_switch(subject, arms, else_body, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
    loop statement in table.value -> output.push(statement)
    table.complete
}

// Rust OSTarget `fold_switch` `comptime if
// build.target.os == { .Linux -> … }` folds to the chain of `comptime if` arms whose
// conditions are this build's `build.target.os == .OS` as Bool literals, so the
// `comptime if` check selects the arm. Every arm head is a distinct bare OS
// variant, and the arms cover every OS or carry an `else`, whatever the
// target. A `build.settings.<key>` dispatch folds against the declared
// setting's value (sema_stmt_check_setting_switch).
sema_stmt_check_prep_switch: fn(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int, output: &[TStmt]) -> Bool {
    // `comptime if T == { … }` over a type parameter is the
    // type table, which already keeps one arm per instance.
    if sema_stmt_type_switch_param(subject, environment, scopes) != None -> return sema_stmt_check_prep_type_table(subject, arms, else_body, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth, output)
    subject_span: expr_span(subject)
    path: sema_fact_expr_path(subject)
    if path != (Val("build.target.os")) {
        if path == .Val(text) {
            if sema_fact_build_setting_key(text) == .Val(key) {
                setting: sema_fact_build_setting(key, subject_span, environment, program, diagnostics) ?? return false
                return sema_stmt_check_setting_switch(key, setting.value, arms, else_body, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth, output)
            }
        }
        diagnostics.push(sema_error("E-OSTARGET-BUILD-CONTEXT", subject_span, "a `comptime if … == {{ … }}` dispatch branches on `build.target.os`", "`build.target.os` is the one compiler-known value this dispatch folds on — it selects the arm matching the build's target OS at compile time", "write `comptime if build.target.os == {{ .Linux -> … else -> … }}`, or use a plain runtime `if` for a value that isn't known at compile time"))
        return false
    }
    active := ""
    if program.registration_graph == .Val(graph) {
        active = graph.build_facts.os
    } else {
        sema_check_unsupported(context, "the `comptime if build.target.os` dispatch at offset {span.start} has no build facts to fold on")
        return false
    }
    oses: loop os in TARGET_OS_ALL -> target_os_name(os)
    seen := [String]{}
    valid := true
    loop arm in arms {
        variant := ""
        if arm.cond == .PatternTest(_, pattern, _, _) {
            if pattern == .Variant(name, bindings, _, _) {
                if bindings.len() == 0 -> variant = name
            }
        }
        if !oses.contains(variant) || seen.contains(variant) {
            diagnostics.push(sema_stmt_os_dispatch_arm(sema_stmt_os_dispatch_arm_head(arm.cond), arm.span))
            valid = false
            next
        }
        seen.push(variant)
    }
    if !valid -> return false
    if else_body == None {
        missing := [String]{}
        loop os in oses {
            if !seen.contains(os) -> missing.push(os)
        }
        if missing.len() != 0 {
            list: missing.join(", ")
            diagnostics.push(sema_error("E-OSTARGET-DISPATCH-EXHAUSTIVE", span, "this `build.target.os` dispatch doesn't cover every target OS — missing: {list}", "a build can target any OS of the list, native, web, Wasm or freestanding, so the dispatch must handle each one — otherwise a build for a missing OS would have no arm to run", "add an arm for each missing OS ({list}), or an `else -> …` catch-all"))
            return false
        }
    }
    // Only an `else` arm: it always runs.
    if arms.len() == 0 {
        fallback: else_body ?? return true
        nested: sema_stmt_check_block(fallback, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "prep-switch@{span.start}", loop_depth)
        if !nested.complete -> return false
        output.push(TStmt.Inline{body: nested.value, span: span})
        return true
    }
    // The nested chain below arm 0; each condition is `active == OS`.
    tail := else_body
    index := arms.len()
    loop index > 1 {
        index -= 1
        arm: arms[index]
        node: Stmt.ComptimeIf{cond: Expr.Bool{value: seen[index] == active, span: arm.span, id: AST_NODE_GENERATED}, cond_span: arm.span, then_body: arm.body, else_body: tail, span: arm.span, selected_then: None}
        tail = Val([Stmt]{node})
    }
    first: arms[0]
    sema_stmt_check_prep_if(Expr.Bool{value: seen[0] == active, span: first.span, id: AST_NODE_GENERATED}, first.span, first.body, tail, first.span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth, output)
}

// Whether a setting dispatch arm head names `value`: a literal or `.Variant`
// the dispatch compares against (`true ->`, `8 ->`, `"eu" ->`, `.Fast ->`).
// None when the head is no value of the setting's kind.
sema_stmt_setting_arm_matches: fn(cond: Expr, value: TComptimeValue) -> Bool? Never! {
    if cond == {
        .Binary(op, _, right, _, _) -> {
            if op != BinOp.Eq -> return None
            if right == {
                .Bool(flag, _, _) -> {
                    if value == .Bool(held) -> return Val(flag == held)
                }
                .Int(number, _, _, _, _) -> {
                    if value == .Int(held) -> return Val(number == held)
                }
                .Char(text, _, _) -> {
                    if value == .Char(held) -> return Val((sema_checked_const_char(text) ?? -1) == held)
                }
                .Str(parts, _, _) -> {
                    if value == .String(held) {
                        if parts.len() == 0 -> return Val(held == "")
                        if parts.len() == 1 && parts[0] == .Lit(text) -> return Val(text == held)
                    }
                }
                .EnumLit(_, variant, _, args, _, _, _) -> {
                    if value == .Enum(_, held, _) {
                        if args.len() == 0 -> return Val(variant == held)
                    }
                }
                else -> {}
            }
            None
        }
        .PatternTest(_, pattern, _, _) -> {
            if pattern == .Variant(variant, bindings, _, _) {
                if value == .Enum(_, held, _) {
                    if bindings.len() == 0 -> return Val(variant == held)
                }
            }
            None
        }
        else -> None
    }
}

// `comptime if build.settings.<key> == { … }`: each arm head is compared
// with the setting's value for this build, and the folded Bool conditions
// select the arm through the `comptime if` chain, as the `build.target.os`
// dispatch does.
sema_stmt_check_setting_switch: fn(key: String, value: TComptimeValue, arms: [SwitchArm], else_body: [Stmt]?, span: Span, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int, output: &[TStmt]) -> Bool {
    matched := [Bool]{}
    valid := true
    loop arm in arms {
        if sema_stmt_setting_arm_matches(arm.cond, value) == .Val(flag) {
            matched.push(flag)
        } else {
            diagnostics.push(sema_error("E0302", arm.span, "this arm doesn't name a value of the setting `{key}`", "a `build.settings.{key}` dispatch compares each arm head with the setting's value for this build", "write each arm head as a literal or `.Variant` of the setting's declared type"))
            valid = false
        }
    }
    if !valid -> return false
    if arms.len() == 0 {
        fallback: else_body ?? return true
        nested: sema_stmt_check_block(fallback, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "prep-switch@{span.start}", loop_depth)
        if !nested.complete -> return false
        output.push(TStmt.Inline{body: nested.value, span: span})
        return true
    }
    tail := else_body
    index := arms.len()
    loop index > 1 {
        index -= 1
        arm: arms[index]
        node: Stmt.ComptimeIf{cond: Expr.Bool{value: matched[index], span: arm.span, id: AST_NODE_GENERATED}, cond_span: arm.span, then_body: arm.body, else_body: tail, span: arm.span, selected_then: None}
        tail = Val([Stmt]{node})
    }
    first: arms[0]
    sema_stmt_check_prep_if(Expr.Bool{value: matched[0], span: first.span, id: AST_NODE_GENERATED}, first.span, first.body, tail, first.span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth, output)
}

sema_stmt_os_dispatch_arm: fn(found: String, span: Span) -> Diagnostic {
    sema_error("E-OSTARGET-DISPATCH-ARM", span, "`{found}` is not an OS arm — a `build.target.os` dispatch arm names one OS of the `OS` list, such as `.Linux` or `.Web`", "each arm gates code for exactly one OS, so its head is a bare, payload-free OS variant — the same list `#Target(OS.*)` uses — and each OS appears at most once", "write one OS per arm, such as `.Linux -> …` or `.Web -> …` (add an `else -> …` for a shared fallback)")
}

// A short display of a refused `build.target.os` arm head.
sema_stmt_os_dispatch_arm_head: fn(cond: Expr) -> String Never! {
    if cond == .PatternTest(_, pattern, _, _) {
        if pattern == .Variant(variant, _, _, _) -> return ".{variant}"
        return "this pattern"
    }
    "this arm head"
}

// sema_check_statements's block-scoped statements (unsafe, impure, reactive,
// shield, region, scope members, switched, transactions, policies, authority
// scopes, task groups). False when one is incomplete.
sema_stmt_check_scoped_statement: fn(statement: Stmt, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int, output: &[TStmt]) -> Bool {
    complete := true
    if statement == {
        .Unsafe(audit, audit_expr, body, span) -> {
            if {
                !sema_effect_check_unsafe_region(audit, audit_expr != None, span, diagnostics) -> {
                    complete = false
                }
                else -> {
                    previous_unsafe_depth := context.unsafe_depth
                    context.unsafe_depth += 1
                    nested: sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "unsafe@{span.start}", loop_depth)
                    context.unsafe_depth = previous_unsafe_depth
                    source_file := sema_source_file_at(environment.source_segments, environment.source_file, environment.source_origin, span)
                    source_line := sema_source_line_at(environment.source_segments, span)
                    if {
                        !nested.complete || source_file == "" || source_line == None -> {
                            complete = false
                        }
                        else -> {
                            line: source_line ?? 0
                            gate: TUnsafeGate{file: source_file, line: line, reason: audit ?? "", enabled: true, fenced: false}
                            output.push(TStmt.UnsafeBlock{gate: gate, body: nested.value, span: span})
                        }
                    }
                }
            }
        }
        .Impure(reason, reason_expr, body, span) -> {
            // A checked String argument that is not a literal (`#Impure(reason)`) is a reason.
            if reason == None && reason_expr == None {
                diagnostics.push(sema_lint("L3102", span, "this `#Impure` block has no reason", "every comptime effect gate records why ambient I/O is needed", "add the reason: `#Impure(\"reading build config\") {{ … }}`"))
            }
            nested: sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "impure@{span.start}", loop_depth)
            if {
                !nested.complete -> {
                    complete = false
                }
                else -> {
                    output.push(TStmt.Impure{body: nested.value, span: span})
                }
            }
        }
        .Reactive(body, span) -> {
            state.reactive_bodies.push(span.copy())
            checked := sema_stmt_check_reactive(body, span, environment, program, scopes, state, tail_store, context, diagnostics)
            if checked == {
                .Val(value) -> output.push(TStmt.Reactive{executable: value, span: span})
                .None -> complete = false
            }
        }
        .Shield(body, span) -> {
            nested: sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "shield@{span.start}", loop_depth)
            if {
                !nested.complete -> {
                    complete = false
                }
                else -> {
                    output.push(TStmt.Shield{body: nested.value, span: span})
                }
            }
        }
        // Rust `Stmt::Live`: a lexical block; a no-OS target has no terminal.
        .Live(body, span) -> {
            if sema_scope_environment_no_os(environment) {
                complete = false
                diagnostics.push(sema_error("E3301", span, "`#Live {{ … }}` is not available on a no-OS target.", "No-OS targets have no OS; only `core`-level APIs are available.", "Terminal I/O requires an OS terminal device. Select a hosted target or declare an IO.Write provider."))
            }
            nested: sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "live@{span.start}", loop_depth)
            if {
                !nested.complete -> complete = false
                else -> output.push(TStmt.Live{body: nested.value, span: span})
            }
        }
        // Rust `Stmt::AssumeDet`: the audited `#Nondeterministic("reason")`
        // body is a lexical block (the gate ledger records the audit).
        .AssumeDet(_, _, body, span) -> {
            nested: sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "nondeterministic@{span.start}", loop_depth)
            if {
                !nested.complete -> complete = false
                else -> output.push(TStmt.Region{body: nested.value, span: span})
            }
        }
        .Region(_, _, body, span) -> {
            nested: sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "region@{span.start}", loop_depth)
            if {
                !nested.complete -> {
                    complete = false
                }
                else -> {
                    output.push(TStmt.Region{body: nested.value, span: span})
                }
            }
        }
        .ScopeMember(name, _, args, args_span, body, dsl, _, span) -> {
            checked := sema_stmt_check_scope_member(name, args, args_span, body, dsl, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
            // A checked text block's
            // name, site and header were validated by the scope-member pass
            // (ScopeMembers.jet, E0927/E0355/E0617); its body is ordinary
            // checked Jet statements.
            if checked == {
                .Val(value) -> output.push(value)
                .None -> complete = false
            }
        }
        .Switched(marker, body, span) -> {
            if {
                marker.name == MARKER_OFF -> {
                    release_only: sema_switch_off_release_only(marker)
                    erased_scope_mark: sema_scope_mark(scopes)
                    erased_state := sema_ownership_state_snapshot(state)
                    erased_mark: sema_check_context_mark(context)
                    checked: sema_check_statements(body, return_type, environment, program, scopes, erased_state, tail_store, context, diagnostics, loop_depth)
                    erased_reasons := [String]{}
                    loop reason_index in erased_mark.incomplete_reasons..<context.incomplete_reasons.len() -> erased_reasons.push(context.incomplete_reasons[reason_index])
                    if release_only -> sema_check_context_rollback_keep_expr_ids(context, erased_mark) else -> sema_check_context_rollback(context, erased_mark)
                    sema_scope_rollback(scopes, erased_scope_mark)
                    if {
                        !checked.complete -> {
                            complete = false
                            loop reason in erased_reasons -> sema_check_unsupported(context, reason)
                        }
                        release_only -> {
                            output.push(TStmt.DebugOnly{body: checked.value, span: span})
                        }
                    }
                }
                // Rust checks any other switched marker's body as a plain
                // block (`Stmt::Switched` fallback).
                else -> {
                    nested: sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "switched@{span.start}", loop_depth)
                    if {
                        !nested.complete -> complete = false
                        else -> output.push(TStmt.Region{body: nested.value, span: span})
                    }
                }
            }
        }
        .Transact(name, name_span, body, implicit, span) -> {
            checked: sema_stmt_check_transaction(name, name_span, body, implicit, span, environment, program, scopes, state, tail_store, context, diagnostics)
            if checked == {
                .Val(value) -> output.push(value)
                .None -> complete = false
            }
        }
        .Policy(declarations, body, span) -> {
            previous_unit_policy := sema_scope_push_unit_policy(scopes, declarations)
            previous_copies_policy := sema_string_view_push_copies_policy(scopes, declarations)
            nested: sema_stmt_check_block(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, "policy@{span.start}", loop_depth)
            sema_scope_pop_unit_policy(scopes, previous_unit_policy)
            scopes.copies_explicit = previous_copies_policy
            if {
                !nested.complete -> {
                    complete = false
                }
                else -> {
                    loop checked_statement in nested.value {
                        output.push(checked_statement)
                    }
                }
            }
        }
        .AuthorityScope(caps, _, binding, body, span) -> {
            // (Rust `Stmt::AuthorityScope`): the body is a lexical
            // block; a named head binds the scoped `Authority` handle. The
            // cap subset check (E0712) runs over the lowered region in the
            // effect pass.
            sema_scope_enter(scopes, state, "fx@{span.start}")
            region_body := [TStmt]{}
            if binding == .Val(handle) {
                owner := sema_scope_local_owner_key(scopes)
                id := symbol_id(SymbolKind.Local, environment.module_identity, owner, handle.name)
                symbol := Symbol{id: id, kind: SymbolKind.Local, name: handle.name, module_name: environment.module_identity, owner: Val(owner), span: handle.span, ty: Val(Type.Named{name: "Authority"}), visibility: 0}
                if {
                    sema_scope_declare_local(scopes, symbol, false, AccessConvention.Read, None, false) -> {
                        sema_ownership_declare_binding(state, symbol, false)
                        // A used handle is an ordinary runtime
                        // `Authority` built from the resolved cap list.
                        if sema_ownership_last_use_statements(body, handle.name) {
                            rights: (loop cap in caps -> TComptimeValue.String{value: cap.name})
                            rights_value: sema_tree_node(Type.List{element: Type.String}, TExprKind.CtLit{value: TComptimeValue.List{values: rights}}, handle.span)
                            reference: TMethodRef{symbol: symbol_id(SymbolKind.Function, "", "JetAuthority", "from_rights"), name: "from_rights", mangled: false, trait_owner: None, operator_identity: None}
                            // Building the handle is effect-free; record the known-pure site so
                            // the effect pass does not treat it as an unknown call.
                            _ := sema_effect_record_intrinsic_effects(environment, program, scopes, context, "Authority.from_rights", handle.span, [EffectRowEntry]{}, diagnostics)
                            rights_arg: TCallArg{value: rights_value, template_items: [SymbolID]{}, borrow: false, mut_borrow: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false}
                            init: sema_tree_node(Type.Named{name: "Authority"}, TExprKind.StaticCall{owner: TStaticOwner.Prelude{rooted: true, path: "JetAuthority", generics: [TPreludeArg]{}}, owner_type: None, method: reference, type_args: [Type]{}, args: [TCallArg]{rights_arg}}, handle.span)
                            region_body.push(TStmt.Let{local: checked_symbol_local(handle.name, handle.span, symbol.id, Type.Named{name: "Authority"}), let_ty: TLetTy.Annotated{ty: Type.Named{name: "Authority"}, wrapper: TLetWrapper.Plain}, init: init, gc_promotion: None, gc_transferred: false, span: handle.span})
                        }
                    }
                    else -> {
                        diagnostics.push(sema_already_defined(handle.name, handle.span))
                        complete = false
                    }
                }
            }
            nested: sema_check_statements(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
            sema_single_use_leave_scope(scopes, state, diagnostics)
            if {
                !nested.complete -> {
                    complete = false
                }
                else -> {
                    loop checked_statement in nested.value {
                        region_body.push(checked_statement)
                    }
                    output.push(TStmt.Region{body: region_body, span: span})
                }
            }
        }
        .TaskGroup(name, name_span, limit, body, span) -> {
            checked := sema_taskgroup_check_statement(name, name_span, limit, body, span, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
            if checked == {
                .Val(value) -> output.push(value)
                .None -> complete = false
            }
        }
        else -> {}
    }
    complete
}

// `#Off(.Release)` names the one entry of the closed build
// condition menu, so its body runs in every build but a release build; a bare
// `#Off` erases its body from every build. The marker registry has already
// checked the argument against `BuildCondition` (Prelude Markers.jet).
sema_switch_off_release_only: fn(marker: Marker) -> Bool Never! {
    if marker.args.len() != 1 -> return false
    if marker.args[0] == .Expr(value) {
        if value == {
            .EnumLit(_, variant, _, _, _, _, _) -> return variant == "Release"
            .Field(_, member, _, _) -> return member == "Release"
            .Ident(name, _, _) -> return name == "Release"
            else -> {}
        }
    }
    false
}
