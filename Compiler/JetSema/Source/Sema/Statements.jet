    Stmt,
    SwitchArm,
    Symbol,
    SymbolID,
    SymbolKind,
    TBinaryOp,
    TCallArg,
    TComptimeValue,
    TContract,
    TCoreClosureKind,
    TDestructureBinding,
    TExpr,
    TExprKind,
    TFailureCarrier,
    TForInMethod,
    TGenericParam,
    THostCall,
    TIntegerBounds,
    TLambda,
    TLetTy,
    TLetWrapper,
    TLocal,
    TMethodRef,
    TOrFallback,
    TPattern,
    TPatternBindingFact,
    TPatternPosition,
    TPlace,
    TPreludeArg,
    TRequireKind,
    TScopeMemberKind,
    TStmt,
    TStaticOwner,
