pub struct SemaStatementResult {
    pub value: [TStmt]
    pub complete: Bool
}

struct SemaStatementRollbackMethods {
    pub snapshot: TMethodRef
    pub restore: TMethodRef
}


fn sema_stmt_binary_type(op: BinOp) -> TBinaryOp Never! {
    sema_expr_tir_binary_op(op)
}

fn sema_stmt_check_block(body: [Stmt], return_type: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], owner: String, loop_depth: Int) -> SemaStatementResult {
    sema_scope_enter(&scopes, &state, owner)
    result :: sema_check_statements(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
    sema_single_use_leave_scope(&scopes, &state, &diagnostics)
    result
}
fn sema_stmt_tir_loop_body_has_break(statements: [TStmt], label: String?, allow_unlabeled: Bool) -> Bool Never! {
    loop statement in statements {
        if statement == {
            .Break(target, _) -> {
                if target == .Val(name) {
                    if label == (Val(name)) -> return true
                }
                if target == None && allow_unlabeled -> return true
            }
            .If(_, then_body, else_body, _, _) -> {
                if sema_stmt_tir_loop_body_has_break(then_body, label, allow_unlabeled) -> return true
                if else_body == .Val(else_statements) && sema_stmt_tir_loop_body_has_break(else_statements, label, allow_unlabeled) -> return true
            }
            .Match(_, arms, _, _) -> {
                loop arm in arms {
                    if sema_stmt_tir_loop_body_has_break(arm.body, label, allow_unlabeled) -> return true
                }
            }
            .EnumMatch(_, _, arms, else_body, _, _) -> {
                loop arm in arms {
                    if sema_stmt_tir_loop_body_has_break(arm.body, label, allow_unlabeled) -> return true
                }
                if else_body == .Val(else_statements) && sema_stmt_tir_loop_body_has_break(else_statements, label, allow_unlabeled) -> return true
            }
            .RangeSwitch(_, arms, else_body, _) -> {
                loop arm in arms {
                    if sema_stmt_tir_loop_body_has_break(arm.body, label, allow_unlabeled) -> return true
                }
                if sema_stmt_tir_loop_body_has_break(else_body, label, allow_unlabeled) -> return true
            }
            .MixedSwitch(_, _, arms, else_body, _) -> {
                loop arm in arms {
                    if sema_stmt_tir_loop_body_has_break(arm.body, label, allow_unlabeled) -> return true
                }
                if else_body == .Val(else_statements) && sema_stmt_tir_loop_body_has_break(else_statements, label, allow_unlabeled) -> return true
            }
            .Loop(_, _, _) | .While(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .ForRange(_, _, _, _, _, _, _, _, _) | .Range(_, _, _, _, _, _, _, _, _, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, _) -> {}
            .Inline(body, _) | .DebugOnly(body, _) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) | .ScopeMember(_, body, _) -> {
                if sema_stmt_tir_loop_body_has_break(body, label, allow_unlabeled) -> return true
            }
            .Unsafe(_, body) | .TaskGroup(_, _, body, _) | .Layout(_, _, body, _) | .ContextBlock(_, body, _) | .Transact(_, _, _, body, _) | .ContractScope(_, body, _, _, _) -> {
                if sema_stmt_tir_loop_body_has_break(body, label, allow_unlabeled) -> return true
            }
            else -> {}
        }
    }
    false
}

// Statements are read in place (read windows): an index read or an unwrapped
// optional would copy the statement, and with it a whole else-if chain.
fn sema_stmt_tir_block_can_fall_through(statements: [TStmt]) -> Bool Never! {
    seen := 0
    loop last in statements {
        seen += 1
        if seen < statements.len() -> next
        if last == {
            .Return(_, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) -> return false
            .ExprStmt(value, _) -> return value.ty != (Type.Named{name: "Never"})
            .If(_, then_body, else_body, _, _) -> {
                if else_body == .Val(else_statements) -> return sema_stmt_tir_block_can_fall_through(then_body) || sema_stmt_tir_block_can_fall_through(else_statements)
                return true
            }
            .Match(_, arms, exhaustive, _) -> {
                if !exhaustive -> return true
                loop arm in arms {
                    if sema_stmt_tir_block_can_fall_through(arm.body) -> return true
                }
                return false
            }
            .Loop(label, body, _) -> return sema_stmt_tir_loop_body_has_break(body, label, true)
            .Inline(body, _) -> return sema_stmt_tir_block_can_fall_through(body)
            else -> return true
        }
    }
    true
}

// Rust `stream_element_type` reads the declared return type. The scope holds
// the effective return, where a plain `Stream<T>` became
// `Stream<T> Err!` (`sema_effective_return_type`), so that carrier is unwrapped.
fn sema_stmt_stream_element_type(return_type: Type?) -> Type? {
    resolved :: return_type ?? return None
    if resolved == {
        .Apply(name, args) -> {
            if name == "Stream" && args.len() == 1 {
                return Val(args[0])
            }
        }
        .Result(ok, err) -> {
            if err == (Type.Named{name: "Err"}) -> return sema_stmt_stream_element_type(Val(ok))
        }
        else -> {}
    }
    None
}

fn sema_stmt_loop_value_break_missing_payload(frame: SemaLoopValueFrame, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if frame.kind != SemaLoopValueKind.Result -> return true
    &diagnostics.push(sema_error("E0076", span, "this loop break needs a value", "an ordinary loop used as a value needs a payload on every matching break", "write `break value`"))
    false
}


fn sema_stmt_check_loop_value_break(value: Expr, label: String?, label_span: Span, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    if label == .Val(name) && !sema_scope_has_loop_label(scopes, name) {
        &diagnostics.push(sema_stmt_unknown_loop_label(name, label_span))
        return None
    }
    frame_index :: sema_loop_value_resolve_frame(context, label) ?? {
        &diagnostics.push(sema_error("E0115", label_span, "`break value` only works inside a loop", "a loop value needs an active target", "move this inside a loop"))
        return None
    }
    frame :: ~context.loop_value_frames[frame_index]
    payload_expected := Type?{None}
    if frame.ty == .Val(expected_type) && !sema_expr_is_numeric(expected_type) -> payload_expected = Val(expected_type)
    checked :: sema_check_expression(value, payload_expected, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if frame.kind == SemaLoopValueKind.Collecting {
        &diagnostics.push(sema_error("E0075", span, "a collecting loop can't break with a value", "collecting loops produce items with `yield`; only the loop's own break without a payload is valid", "remove the break payload or use an ordinary result loop"))
        return None
    }
    if frame.kind == SemaLoopValueKind.Effect {
        &diagnostics.push(sema_error("E0079", span, "this effect loop can't break with a value", "only a result loop consumes a break payload", "remove the payload or use a result loop"))
        return None
    }
    result :: sema_loop_value_check_result_exit(&context, frame_index, checked, environment, &diagnostics) ?? return None
    if !sema_stmt_move_direct(value, &state, scopes, "the loop `break`", &diagnostics) -> return None
    sema_loop_value_record_break(&context, frame_index, state)
    Val(TStmt.BreakValue{label: label, value: result, span: span})
}

fn sema_stmt_check_yield(value: Expr, span: Span, return_type: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    if span.start == span.end && context.collect_item_types.len() > 0 {
        item :: sema_loop_value_check_collecting_item(value, expr_span(value), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        if !sema_stmt_move_direct(value, &state, scopes, "the collecting loop", &diagnostics) -> return None
        return Val(TStmt.ExprStmt{value: item, span: span})
    }
    stream_return := return_type
    if sema_stmt_stream_element_type(stream_return) == None -> stream_return = scopes.return_type
    elem_type :: sema_stmt_stream_element_type(stream_return) ?? {
        &diagnostics.push(sema_error("E0805", span, "`yield` outside a generator", "`yield` hands a value to a `Stream<T>` consumer — only a function declared `Stream<T> ->` may use it", "declare `Stream<T> ->` on this function, or remove `yield`"))
        _ := sema_check_expression(value, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return None
    }
    checked :: sema_check_expression(value, Val(elem_type), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    yielded := checked
    if !type_identity_equal(checked.ty, elem_type) {
        if {
            sema_expr_numeric_widening_to(checked.ty, elem_type) == (Val(true)) -> {
                line :: sema_source_line_at(environment.source_segments, checked.span) ?? 0
                yielded = sema_expr_numeric_literal_conversion(checked, elem_type, checked.span, line, &diagnostics) ?? return None
            }
            else -> {
                &diagnostics.push(sema_error("E0807", checked.span, "this yields `{type_name(checked.ty)}`, but the stream is `Stream<{type_name(elem_type)}>`", "every `yield` in a generator must hand back the stream's element type", "convert the yielded value to the stream element type"))
                return None
            }
        }
    }
    if !sema_stmt_move_direct(value, &state, scopes, "`yield`", &diagnostics) -> return None
    call := sema_tir_expr(Type.Named{name: "Unit"}, TExprKind.HostCall{call: THostCall.YieldSend{value: yielded}}, span)
    Val(TStmt.ExprStmt{value: call, span: span})
}

// D-STREAMYIELD1 (E0806): a generator (`Stream<T> ->`) yields its values;
// `return` only ends the stream early, so it can't carry one. True when this
// return was rejected.
fn sema_stmt_generator_return_rejected(value: Expr?, return_type: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    returned :: value ?? return false
    stream_return := return_type
    if sema_stmt_stream_element_type(stream_return) == None -> stream_return = scopes.return_type
    if sema_stmt_stream_element_type(stream_return) == None -> return false
    _ := sema_check_expression(returned, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    &diagnostics.push(sema_error("E0806", expr_span(returned), "`{context.function_name}` yields values, so `return` can't carry one", "a generator body produces values with `yield`; `return` only ends the stream early", "write `yield ...;` to hand back a value, or a bare `return;` to end the stream"))
    true
}

fn sema_stmt_close_loop_value_frame(context: &SemaCheckContext, frame_index: Int, body: &[TStmt], state: &SemaOwnershipState, before: SemaOwnershipState, after_body: SemaOwnershipState, may_skip: Bool, environment: SemaScopeEnvironment, diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    frame := SemaLoopValueFrame?{None}
    if frame_index >= 0 && frame_index < context.loop_value_frames.len() -> frame = Val(context.loop_value_frames[frame_index])
    if frame == .Val(value) && value.kind == SemaLoopValueKind.Result && value.ty != None {
        result_type :: value.ty ?? Type.Named{name: "Unit"}
        if !sema_loop_value_widen_result_breaks(&body, value.label, result_type, environment, &diagnostics) -> valid = false
    }
    body_falls_through := sema_stmt_tir_block_can_fall_through(body)
    _ := sema_ownership_join_loop_value_paths(&state, context, frame_index, before, after_body, body_falls_through, may_skip)
    sema_loop_value_pop_frame(&context)
    valid
}

pub fn sema_stmt_block_has_no_fallthrough(statements: [Stmt]) -> Bool Never! {
    if statements.len() == 0 -> return false
    last :: statements[statements.len() - 1]
    if last == {
        .Return(_, _) -> true
        .Loop(body, _, _, _) -> !sema_stmt_refutable_loop_body_can_break(body)
        .Transact(_, _, body, _, _) -> sema_stmt_block_has_no_fallthrough(body)
        else -> false
    }
}

// Rust `stmt_definitely_returns` (Diagnostics.rs:630-665): `return`, a
// diverging `panic`/`todo` line, a loop that no `break` leaves, or a table
// whose every path returns.
fn sema_stmt_definitely_returns(statement: Stmt) -> Bool Never! {
    if statement == {
        .Return(_, _) -> return true
        .Expr(expr) -> return sema_stmt_refutable_expr_diverges(expr)
        .Loop(body, _, _, _) -> return !sema_stmt_refutable_loop_body_can_break(body)
        .While(cond, body, _, _, _) -> return sema_stmt_refutable_expr_is_true(cond) && !sema_stmt_refutable_loop_body_can_break(body)
        .CountedLoop(_, cond, _, body, _, _, _) -> return sema_stmt_refutable_expr_is_true(cond) && !sema_stmt_refutable_loop_body_can_break(body)
        .Switch(subject, arms, else_body, span) -> {
            if arms.len() == 0 -> return false
            loop arm in arms {
                if !sema_stmt_block_definitely_returns(arm.body) -> return false
            }
            if else_body == .Val(body) -> return sema_stmt_block_definitely_returns(body)
            return !sema_stmt_refutable_is_subjectless_guard(subject, span)
        }
        else -> return false
    }
}

fn sema_stmt_block_definitely_returns(statements: [Stmt]) -> Bool Never! {
    loop statement in statements {
        if sema_stmt_definitely_returns(statement) -> return true
    }
    false
}

// The `value_tail_span` mark for a value block's last line: its value
// expression, or the table that ends the block (its arms carry the value).
fn sema_stmt_value_tail_marker(statements: [Stmt]) -> Span? {
    seen := 0
    loop last in statements {
        seen += 1
        if seen < statements.len() -> next
        if last == {
            .Expr(tail) -> return Val(expr_span(tail))
            .Switch(_, _, _, span) -> return Val(span)
            else -> return None
        }
    }
    None
}

// Rust `check_value_tail` (CheckerCore/blocks.rs:256-350) for the end of a
// value block: an empty block, or one whose last line is a statement that can
// still reach the end, reports E0114. A value line and a table report their
// own errors. False when E0114 was reported.
pub fn sema_stmt_check_value_block_end(statements: [Stmt], checked: [TStmt], expected: Type?, block_span: Span, function_name: String, diagnostics: &[Diagnostic]) -> Bool {
    if statements.len() == 0 {
        &diagnostics.push(sema_stmt_missing_value(expected, None, function_name, block_span))
        return false
    }
    seen := 0
    loop last in statements {
        seen += 1
        if seen < statements.len() -> next
        if last == {
            .Expr(_) | .Return(_, _) | .Switch(_, _, _, _) -> return true
            else -> {}
        }
        if !sema_stmt_tir_block_can_fall_through(checked) || sema_stmt_definitely_returns(last) -> return true
        &diagnostics.push(sema_stmt_missing_value(expected, None, function_name, sema_compiler_index_stmt_span(last)))
        return false
    }
    true
}

// Rust `report_missing_block_value_on_path` (CheckerCore/blocks.rs:358-393).
fn sema_stmt_missing_value(expected: Type?, uncovered: String?, function_name: String, span: Span) -> Diagnostic {
    expected_name :: sema_type_show(expected ?? Type.Named{name: "Unit"})
    why :: "a block that promises {expected_name} must end with a value of that type, or leave through `return` on every path"
    if uncovered == .Val(path) -> return sema_error("E0114", span, "when {path}, `{function_name}` reaches the end without a value", why, "add a last line that produces {expected_name} for that case, or turn the last guard into an `else`")
    sema_error("E0114", span, "this block promises to produce {expected_name}, but its last line produces no value", why, "end the block with an expression that produces {expected_name}, or `return` a value on every path")
}

// Rust `uncovered_guard_path` (CheckerCore/blocks.rs:11-89): the case that
// none of a value block's trailing `if cond -> return …` guards covers.
fn sema_stmt_uncovered_guard_path(statements: [Stmt]) -> String? {
    reversed := [Expr]{}
    index := statements.len() - 1
    loop index >= 0 {
        guard_arms := [SwitchArm]?{None}
        if statements[index] == .Switch(guard_subject, switch_arms, guard_else, guard_span) {
            if guard_else == None && sema_stmt_refutable_is_subjectless_guard(guard_subject, guard_span) && switch_arms.len() > 0 -> guard_arms = Val(switch_arms)
        }
        arms :: guard_arms ?? break
        loop arm in arms {
            if !sema_stmt_block_definitely_returns(arm.body) -> return sema_stmt_guard_path(reversed)
        }
        arm_index := arms.len() - 1
        loop arm_index >= 0 {
            &reversed.push(arms[arm_index].cond)
            arm_index -= 1
        }
        index -= 1
    }
    sema_stmt_guard_path(reversed)
}

fn sema_stmt_guard_path(reversed: [Expr]) -> String? {
    if reversed.len() == 0 -> return None
    conds := [Expr]{}
    index := reversed.len() - 1
    loop index >= 0 {
        &conds.push(reversed[index])
        index -= 1
    }
    // Guards that compare one name with one whole number from both sides
    // (`n > 0`, `n < 0`) leave exactly that number.
    point_name := ""
    point_value := 0
    has_point := false
    below := false
    above := false
    single_point := true
    loop cond in conds {
        comparison := SemaGuardComparison?{None}
        if cond == .Binary(op, left, right, _) {
            if left == .Ident(name, _) && right == .Int(value, _, _, _) -> comparison = Val(SemaGuardComparison{op: op, name: name, value: value})
            if left == .Int(value, _, _, _) && right == .Ident(name, _) {
                flipped := op
                if op == BinOp.Lt -> flipped = BinOp.Gt
                if op == BinOp.Gt -> flipped = BinOp.Lt
                comparison = Val(SemaGuardComparison{op: flipped, name: name, value: value})
            }
        }
        found :: comparison ?? {
            single_point = false
            break
        }
        if has_point && (found.name != point_name || found.value != point_value) {
            single_point = false
            break
        }
        point_name = found.name
        point_value = found.value
        has_point = true
        if {
            found.op == BinOp.Lt -> below = true
            found.op == BinOp.Gt -> above = true
            found.op == BinOp.Ne -> {
                below = true
                above = true
            }
            else -> {
                single_point = false
                break
            }
        }
    }
    if has_point && single_point && below && above -> return Val("`{point_name}` is `{point_value}`")
    texts := [String]{}
    loop cond in conds {
        text :: sema_stmt_guard_text(cond) ?? return None
        &texts.push("`{text}`")
    }
    if texts.len() == 1 -> return Val("{texts[0]} is false")
    Val("none of {texts.join(", ")} is true")
}

struct SemaGuardComparison {
    op: BinOp
    name: String
    value: Int
}

// A guard condition as written. The reference quotes the source text; this
// spells the same simple forms and gives up (the generic E0114) otherwise.
fn sema_stmt_guard_text(expr: Expr) -> String? {
    if expr == {
        .Ident(name, _) -> return Val(name)
        .Int(value, _, _, raw) -> return Val(raw ?? "{value}")
        .Bool(value, _) -> return Val(if value -> "true" else -> "false")
        .Field(base, member, _) -> {
            base_text :: sema_stmt_guard_text(base) ?? return None
            return Val("{base_text}.{member}")
        }
        .Paren(inner, _) -> {
            inner_text :: sema_stmt_guard_text(inner) ?? return None
            return Val("({inner_text})")
        }
        .Unary(op, operand, _) -> {
            operand_text :: sema_stmt_guard_text(operand) ?? return None
            prefix :: if op == UnOp.Not -> "!" else -> "-"
            return Val("{prefix}{operand_text}")
        }
        .Binary(op, left, right, _) -> {
            symbol :: sema_stmt_guard_operator(op) ?? return None
            left_text :: sema_stmt_guard_text(left) ?? return None
            right_text :: sema_stmt_guard_text(right) ?? return None
            return Val("{left_text} {symbol} {right_text}")
        }
        else -> return None
    }
}

fn sema_stmt_guard_operator(op: BinOp) -> String? {
    if op == {
        .Eq -> return Val("==")
        .Ne -> return Val("!=")
        .Lt -> return Val("<")
        .Gt -> return Val(">")
        .Le -> return Val("<=")
        .Ge -> return Val(">=")
        .And -> return Val("&&")
        .Or -> return Val("||")
        .Add -> return Val("+")
        .Sub -> return Val("-")
        .Mul -> return Val("*")
        .Div -> return Val("/")
        else -> return None
    }
}

// Rust `switch_arm_pattern` over every arm: each head is a structural pattern
// test (text and byte patterns can always miss).
fn sema_stmt_switch_all_patterns(arms: [SwitchArm]) -> Bool Never! {
    if arms.len() == 0 -> return false
    loop arm in arms {
        if arm.cond == .PatternTest(_, pattern, _) {
            if pattern == {
                .StrMatch(_, _) | .BinMatch(_, _) -> return false
                else -> {}
            }
        } else {
            return false
        }
    }
    true
}

fn sema_stmt_switch_has_text_or_bytes(arms: [SwitchArm]) -> Bool Never! {
    loop arm in arms {
        if arm.cond == .PatternTest(_, pattern, _) {
            if pattern == {
                .StrMatch(_, _) | .BinMatch(_, _) -> return true
                else -> {}
            }
        }
    }
    false
}

// Rust `check_switch` (switches.rs:2277-2308) for a subject that is not a
// plain name: its pattern and range heads test `it`. A place subject reads
// the same value in every arm, so the heads read the place itself, as the
// value form does; any other subject is checked once and bound to `it`.
fn sema_stmt_check_subject_switch(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span, return_type: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> SemaStatementResult {
    subject_span :: expr_span(subject)
    local :: Expr.Ident{name: "it", span: subject_span}
    if sema_expression_if_subject_is_place(subject) -> return sema_stmt_check_switch(local, sema_stmt_rebind_switch_arms(arms, subject_span, subject), else_body, span, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
    sema_scope_enter(&scopes, &state, "if.subject@{span.start}")
    carrier := false
    loop arm in arms {
        if sema_expression_if_condition_consumes_carrier(arm.cond) -> carrier = true
    }
    checked_subject :: if carrier -> sema_check_expression_carrier(subject, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(subject, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    init :: checked_subject ?? {
        sema_single_use_leave_scope(&scopes, &state, &diagnostics)
        return SemaStatementResult{value: [TStmt]{}, complete: false}
    }
    owner :: sema_scope_local_owner_key(scopes)
    id :: symbol_id(SymbolKind.Local, environment.module_identity, owner, "it")
    symbol :: Symbol{id: id, kind: SymbolKind.Local, name: "it", module_name: environment.module_identity, owner: Val(owner), span: subject_span, ty: Val(init.ty), visibility: 0}
    _ := sema_scope_declare_local(&scopes, symbol, false, AccessConvention.Read, init.integer_bounds, false)
    sema_ownership_declare_binding(&state, symbol, false)
    it_local := tir_symbol_local("it", subject_span, id)
    it_local.generated = true
    it_local.integer_bounds = init.integer_bounds
    checked :: sema_stmt_check_switch(local, sema_stmt_rebind_switch_arms(arms, subject_span, local), else_body, span, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
    sema_single_use_leave_scope(&scopes, &state, &diagnostics)
    if !checked.complete -> return checked
    body := [TStmt]{TStmt.Let{local: it_local, let_ty: TLetTy.Inferred, init: init, gc_promotion: None, gc_transferred: false, span: subject_span}}
    loop statement in checked.value -> &body.push(statement)
    SemaStatementResult{value: [TStmt]{TStmt.Inline{body: body, span: span}}, complete: true}
}

// Every arm head that tests the dispatch subject reads `replacement` instead.
fn sema_stmt_rebind_switch_arms(arms: [SwitchArm], subject_span: Span, replacement: Expr) -> [SwitchArm] {
    rebound := [SwitchArm]{}
    loop arm in arms -> &rebound.push(SwitchArm{cond: sema_expression_if_replace_subject(arm.cond, subject_span, replacement), body: arm.body, span: arm.span})
    rebound
}

// TStmt.If carries statement arms; value-producing if expressions need an
// InlineBlock consumer and therefore stay incomplete in this Sema slice.

fn sema_stmt_check_unit_branch(body: [Stmt], value_expr: Expr, bindings: [SemaConditionBinding], return_type: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], owner: String, loop_depth: Int) -> SemaStatementResult {
    sema_scope_enter(&scopes, &state, owner)
    sema_expression_declare_condition_bindings(bindings, &scopes, &state, true, &diagnostics)
    result := sema_check_statements(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
    if result.complete {
        value_span :: expr_span(value_expr)
        checked_value := sema_check_expression(value_expr, Val(Type.Named{name: "Unit"}), environment, &scopes, &state, &tail_store, &context, &diagnostics)
        if {
            checked_value == None -> result.complete = false
            else -> {
                value :: checked_value ?? sema_tir_expr(Type.Named{name: "Unit"}, TExprKind.Unit, value_span)
                if value.kind == {
                    .Unit -> {}
                    else -> &result.value.push(TStmt.ExprStmt{value: value, span: value_span})
                }
            }
        }
    }
    sema_single_use_leave_scope(&scopes, &state, &diagnostics)
    result
}

fn sema_stmt_check_unit_if_parts(condition: Expr, then_body: [Stmt], then_value: Expr, else_body: [Stmt], else_value: Expr, span: Span, return_type: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> SemaStatementResult {
    // D-COMPILE-STACK1=A (E1403): each level of the chain is one source
    // nesting level, as an `if` expression is in the Rust checker.
    if !sema_enter_source_nesting(&context, span, &diagnostics) -> return SemaStatementResult{value: [TStmt]{}, complete: false}
    checked_condition := sema_expression_check_condition(condition, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    condition_bindings :: if checked_condition == {
        .Val(checked) -> checked.bindings
        else -> [SemaConditionBinding]{}
    }
    before := sema_ownership_state_snapshot(state)
    before_hardware :: sema_scope_hardware_facts(scopes)
    then_state := sema_ownership_state_snapshot(before)
    then_mark :: sema_scope_mark(&scopes)
    then_result :: sema_stmt_check_unit_branch(then_body, then_value, condition_bindings, return_type, environment, &scopes, &then_state, &tail_store, &context, &diagnostics, "if.then@{span.start}", loop_depth)
    then_hardware :: sema_scope_hardware_facts(scopes)
    sema_scope_rollback(&scopes, then_mark)
    else_state := sema_ownership_state_snapshot(before)
    else_mark :: sema_scope_mark(&scopes)
    else_is_elseif := false
    else_result := SemaStatementResult{value: [TStmt]{}, complete: false}
    if else_value == {
        .If(_, _, _, _, _, _) -> {
            else_is_elseif = true
            if else_body.len() == 0 {
                else_result = sema_stmt_check_unit_if(else_value, return_type, environment, &scopes, &else_state, &tail_store, &context, &diagnostics, loop_depth)
            }
        }
        else -> else_result = sema_stmt_check_unit_branch(else_body, else_value, [SemaConditionBinding]{}, return_type, environment, &scopes, &else_state, &tail_store, &context, &diagnostics, "if.else@{span.start}", loop_depth)
    }
    sema_leave_source_nesting(&context)
    else_hardware :: sema_scope_hardware_facts(scopes)
    sema_scope_rollback(&scopes, else_mark)
    // A branch that leaves (`return`, `break`, `next`) does not reach the
    // code after the `if`, so its moves are not moves there (D-COPY-DEFAULT1).
    then_reaches_merge :: sema_stmt_tir_block_can_fall_through(then_result.value)
    else_reaches_merge :: sema_stmt_tir_block_can_fall_through(else_result.value)
    single_use_paths := [SemaOwnershipState]{}
    if then_reaches_merge -> &single_use_paths.push(sema_ownership_state_snapshot(then_state))
    if else_reaches_merge -> &single_use_paths.push(sema_ownership_state_snapshot(else_state))
    sema_single_use_check_paths(before, single_use_paths, &diagnostics)
    if {
        then_reaches_merge && else_reaches_merge -> sema_ownership_join_paths(&state, before, then_state, else_state, true)
        then_reaches_merge -> sema_ownership_join_paths(&state, before, then_state, before, false)
        else_reaches_merge -> sema_ownership_join_paths(&state, before, else_state, before, false)
        else -> sema_ownership_join_paths(&state, before, before, before, false)
    }
    // D-UNINIT1: only paths that reach the merge count (Rust `merge_paths`).
    if then_reaches_merge && !else_reaches_merge -> state.uninit = then_state.uninit
    if else_reaches_merge && !then_reaches_merge -> state.uninit = else_state.uninit
    loop site in then_state.share_found -> sema_ownership_note_share_found(&state, site)
    loop site in else_state.share_found -> sema_ownership_note_share_found(&state, site)
    sema_scope_join_hardware_paths(&scopes, before_hardware, then_hardware, else_hardware, true)
    if checked_condition == None || !then_result.complete || !else_result.complete {
        return SemaStatementResult{value: [TStmt]{}, complete: false}
    }
    condition_tir :: checked_condition ?? return SemaStatementResult{value: [TStmt]{}, complete: false}
    SemaStatementResult{
        value: [TStmt]{TStmt.If{condition: condition_tir.condition, then_body: then_result.value, else_body: Val(else_result.value), else_is_elseif: else_is_elseif, span: span}},
        complete: true,
    }
}

fn sema_stmt_check_unit_if(expr: Expr, return_type: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> SemaStatementResult {
    if expr == {
        .If(condition, then_body, then_value, else_body, else_value, span) -> {
            // A dispatch table binds a call subject once before the chain
            // that tests it, exactly like the value form.
            if sema_expression_if_dispatch_subject(condition, else_value) == .Val(subject) {
                binding :: sema_expression_if_bind_subject(subject, condition, else_value, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaStatementResult{value: [TStmt]{}, complete: false}
                table := sema_stmt_check_unit_if_parts(sema_expression_if_rebound_condition(subject, condition), then_body, then_value, else_body, sema_expression_if_rebound_chain(subject, else_value), span, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
                if !table.complete -> return table
                statements := [TStmt]{binding}
                loop statement in table.value -> &statements.push(statement)
                return SemaStatementResult{value: statements, complete: true}
            }
            // D-FLOWTYPE1=A: a stable `x == None` test reads as its presence
            // test with the branches swapped, as in the value form.
            if sema_expression_absent_optional_test(condition) == .Val(test) {
                if sema_expression_flow_optional_payload(scopes, test.name.name) != None -> return sema_stmt_check_unit_if_parts(sema_expression_presence_test(test.name, test.span), else_body, else_value, then_body, then_value, span, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
            }
            sema_stmt_check_unit_if_parts(condition, then_body, then_value, else_body, else_value, span, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
        }
        else -> SemaStatementResult{value: [TStmt]{}, complete: false}
    }
}
fn sema_stmt_check_switch(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span, return_type: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> SemaStatementResult {
    subject_is_true :: if subject == {
        .Bool(value, _) -> value
        else -> false
    }
    // A folded multi-head function is the same table of self-contained
    // pattern tests over its synthetic parameter.
    multi_head :: if subject == {
        .Ident(name, _) -> name == "__jet_multi_head_subject"
        else -> false
    }
    // Rust `check_switch` (switches.rs:2277-2308): the arms of `if subject OP
    // { … }` over a plain name test that name directly; any other subject is
    // read once as the `it` the pattern heads test.
    if !(subject_is_true || multi_head) {
        if subject == {
            .Ident(_, _) -> {}
            else -> return sema_stmt_check_subject_switch(subject, arms, else_body, span, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
        }
    }
    // Rust `check_value_tail`: a table that ends a value block is that
    // block's value, so each arm ends in a value line or leaves.
    value_tail :: context.value_tail_span == (Val(span))
    // D-FLOWTYPE1=A: `if x == None -> a else -> b` over a stable Optional
    // reads as `if x == .Val(x) -> b else -> a`, so `b` holds the payload.
    // The guard is evaluated once at the same point; only the mutually
    // exclusive bodies change places (Rust `check_switch`).
    subjectless_guard :: sema_stmt_refutable_is_subjectless_guard(subject, span)
    if subjectless_guard && arms.len() == 1 && else_body == .Val(present_body) {
        if sema_expression_absent_optional_test(arms[0].cond) == .Val(test) {
            if sema_expression_flow_optional_payload(scopes, test.name.name) != None {
                present_arm :: SwitchArm{cond: sema_expression_presence_test(test.name, test.span), body: present_body, span: arms[0].span}
                return sema_stmt_check_switch(subject, [SwitchArm]{present_arm}, Val(arms[0].body), span, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
            }
        }
    }
    before := sema_ownership_state_snapshot(state)
    before_hardware :: sema_scope_hardware_facts(scopes)
    fallthrough_state := sema_ownership_state_snapshot(before)
    // Arm conditions are checked on the fallthrough path in place; each arm
    // body and the else body are checked in place and rolled back.
    fallthrough_mark :: sema_scope_mark(&scopes)
    conditions := [SemaCheckedCondition?]{}
    branches := [SemaStatementResult]{}
    branch_hardware := [SemaScopeHardwareFacts]{}
    merged_state := sema_ownership_state_snapshot(before)
    has_branch := false
    arm_found := [SemaOwnershipShareSite]{}
    complete := true
    single_use_paths := [SemaOwnershipState]{}
    arm_index := 0
    loop arm_index < arms.len() {
        arm := arms[arm_index]
        condition_result := sema_expression_check_condition(arm.cond, environment, &scopes, &fallthrough_state, &tail_store, &context, &diagnostics)
        arm_bindings := [SemaConditionBinding]{}
        if condition_result == {
            .Val(condition) -> {
                arm_bindings = condition.bindings
                &conditions.push(Val(condition))
            }
            else -> {
                &conditions.push(None)
                complete = false
            }
        }
        branch_mark :: sema_scope_mark(&scopes)
        branch_state := sema_ownership_state_snapshot(fallthrough_state)
        sema_scope_enter(&scopes, &branch_state, "if.arm@{arm.span.start}")
        sema_expression_declare_condition_bindings(arm_bindings, &scopes, &branch_state, true, &diagnostics)
        if value_tail -> context.value_tail_span = sema_stmt_value_tail_marker(arm.body)
        branch := sema_check_statements(arm.body, return_type, environment, &scopes, &branch_state, &tail_store, &context, &diagnostics, loop_depth)
        if value_tail {
            context.value_tail_span = Val(span)
            if !sema_stmt_check_value_block_end(arm.body, branch.value, return_type, arm.span, context.function_name, &diagnostics) -> complete = false
        }
        sema_single_use_leave_scope(&scopes, &branch_state, &diagnostics)
        &branch_hardware.push(sema_scope_hardware_facts(scopes))
        sema_scope_rollback(&scopes, branch_mark)
        &branches.push(branch)
        // D-COPY-DEFAULT1: an arm that leaves does not reach the merge.
        loop site in branch_state.share_found -> &arm_found.push(site)
        if sema_stmt_tir_block_can_fall_through(branch.value) -> &single_use_paths.push(sema_ownership_state_snapshot(branch_state))
        if {
            !sema_stmt_tir_block_can_fall_through(branch.value) -> {}
            !has_branch -> {
                merged_state = branch_state
                has_branch = true
            }
            else -> {
                joined := merged_state
                sema_ownership_join_paths(&joined, before, merged_state, branch_state, true)
                merged_state = joined
            }
        }
        arm_index += 1
    }
    else_result := [TStmt]?{None}
    else_state := sema_ownership_state_snapshot(fallthrough_state)
    else_mark :: sema_scope_mark(&scopes)
    if else_body != None {
        body :: else_body
        complement :: sema_stmt_else_presence_names(arms, scopes)
        if value_tail -> context.value_tail_span = sema_stmt_value_tail_marker(body)
        checked_else :: if complement.len() == 0 -> sema_stmt_check_block(body, return_type, environment, &scopes, &else_state, &tail_store, &context, &diagnostics, "if.else@{span.start}", loop_depth) else -> sema_stmt_check_else_complement(complement, body, span, return_type, environment, &scopes, &else_state, &tail_store, &context, &diagnostics, loop_depth)
        if !checked_else.complete -> complete = false
        if value_tail {
            context.value_tail_span = Val(span)
            if !sema_stmt_check_value_block_end(body, checked_else.value, return_type, span, context.function_name, &diagnostics) -> complete = false
        }
        else_result = Val(checked_else.value)
    }
    else_hardware :: sema_scope_hardware_facts(scopes)
    sema_scope_rollback(&scopes, else_mark)
    sema_scope_rollback(&scopes, fallthrough_mark)
    hardware_merged := sema_scope_hardware_facts(scopes)
    if branch_hardware.len() > 0 {
        hardware_merged = branch_hardware[0]
        branch_hardware_index := 1
        loop branch_hardware_index < branch_hardware.len() {
            hardware_merged = sema_scope_hardware_join(before_hardware, hardware_merged, branch_hardware[branch_hardware_index], true)
            branch_hardware_index += 1
        }
    }
    else_reaches_merge :: else_body == None || sema_stmt_tir_block_can_fall_through(else_result ?? [TStmt]{})
    if else_reaches_merge -> &single_use_paths.push(sema_ownership_state_snapshot(else_state))
    sema_single_use_check_paths(before, single_use_paths, &diagnostics)
    if {
        has_branch && else_reaches_merge -> sema_ownership_join_paths(&state, before, merged_state, else_state, true)
        has_branch -> sema_ownership_join_paths(&state, before, merged_state, merged_state, true)
        else_reaches_merge -> sema_ownership_join_paths(&state, before, else_state, else_state, true)
        else -> sema_ownership_join_paths(&state, before, before, before, false)
    }
    loop site in arm_found -> sema_ownership_note_share_found(&state, site)
    loop site in else_state.share_found -> sema_ownership_note_share_found(&state, site)
    sema_scope_join_hardware_paths(&scopes, before_hardware, hardware_merged, else_hardware, true)
    if !complete -> return SemaStatementResult{value: [TStmt]{}, complete: false}
    // A subjectless guard table proves no coverage: its arms test their own
    // subjects (Rust `check_switch` skips E0307 for subjectless guards).
    if else_body == None && !subjectless_guard {
        // Rust `check_switch`: only an all-pattern table can prove that one
        // arm always matches; a text or byte pattern is left to coverage.
        if !multi_head && !sema_stmt_switch_all_patterns(arms) && !sema_stmt_switch_has_text_or_bytes(arms) {
            &diagnostics.push(sema_error("E0003", span, "this `if` needs an `else` arm", "mixed condition arms (or non-pattern arms) must always have a fallback (D-IF1)", "add `else -> {{ ... }}` after the last arm"))
            return SemaStatementResult{value: [TStmt]{}, complete: false}
        }
        checked_conditions := [TExpr]{}
        loop condition in conditions {
            checked :: condition ?? return SemaStatementResult{value: [TStmt]{}, complete: false}
            &checked_conditions.push(checked.value)
        }
        sema_coverage_check_table(checked_conditions, multi_head, span, environment, &diagnostics)
    }
    loop condition in conditions {
        if condition == None -> return SemaStatementResult{value: [TStmt]{}, complete: false}
    }
    SemaStatementResult{value: sema_stmt_switch_chain(conditions, branches, arms, else_result, span, 0) ?? [TStmt]{}, complete: true}
}

// The checked switch from arm `index` on, as the else-if chain codegen lowers.
// Built by direct recursion, one frame per arm, so every finished level is a
// moved temporary; a loop would hold the partial chain in a local and copy it
// into each new level, quadratic in the arm count.
fn sema_stmt_switch_chain(conditions: [SemaCheckedCondition?], branches: [SemaStatementResult], arms: [SwitchArm], else_result: [TStmt]?, span: Span, index: Int) -> [TStmt]? {
    if index == arms.len() -> return ~else_result
    condition :: conditions[index] ?? return None
    arm_span :: if index == 0 -> span else -> arms[index].span
    Val([TStmt]{TStmt.If{condition: condition.condition, then_body: branches[index].value, else_body: sema_stmt_switch_chain(conditions, branches, arms, else_result, span, index + 1), else_is_elseif: index + 1 < arms.len(), span: arm_span}})
}





fn sema_stmt_range_integer_type(ty: Type) -> Bool Never! {
    if ty == {
        .Int -> true
        .InlineRange(_, _, _) -> true
        else -> false
    }
}

fn sema_stmt_check_range_endpoint(expr: Expr, which: String, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    value :: sema_check_expression(expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if !sema_stmt_range_integer_type(value.ty) {
        &diagnostics.push(sema_error("E0109", expr_span(expr), "the {which} of a `for` range must be Int, not {type_name(value.ty)}", "`loop` counts whole numbers between two ends", "use Int values for both ends, like `1..10` or `0..<n`"))
        return None
    }
    Val(value)
}

fn sema_stmt_check_range_stride(expr: Expr, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    value :: sema_check_expression(expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if !sema_stmt_range_integer_type(value.ty) {
        &diagnostics.push(sema_error("E0123", expr_span(expr), "a range loop stride must be Int, not {type_name(value.ty)}", "the stride is how far to count each turn, so it must be a whole number", "use an Int stride, like `loop i in 0..10, 2`"))
        return None
    }
    if expr == {
        .Int(n, span, _, _) -> {
            if n <= 0 {
                &diagnostics.push(sema_error("E0123", span, "a range loop stride must be positive, not {n}", "a zero or negative stride would never reach the end", "use a stride of 1 or more"))
                return None
            }
        }
        else -> {}
    }
    Val(value)
}

struct SemaForInIterableFact {
    method_kind: TForInMethod
    item_type: Type
}
struct SemaForInPairTypes {
    first: Type
    second: Type
}

fn sema_stmt_for_in_named_type_name(ty: Type) -> String? {
    if ty == {
        .Named(name) -> return Val(name)
        else -> return None
    }
}

fn sema_stmt_for_in_type_is_named(ty: Type, name: String) -> Bool Never! {
    actual :: sema_stmt_for_in_named_type_name(ty) ?? return false
    actual == name || actual.ends_with("::{name}")
}

fn sema_stmt_for_in_type_requires_owned_iteration(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, args) -> {
            if name == "ViewMut" -> return false
            if name == "Task" -> return true
            loop arg in args {
                if sema_stmt_for_in_type_requires_owned_iteration(arg) -> return true
            }
            return false
        }
        .List(inner) | .FixedList(inner, _) -> return sema_stmt_for_in_type_requires_owned_iteration(inner)
        .Tuple(fields) -> {
            loop field in fields {
                if sema_stmt_for_in_type_requires_owned_iteration(field.ty) -> return true
            }
            return false
        }
        .Option(inner) | .Shared(inner) -> return sema_stmt_for_in_type_requires_owned_iteration(inner)
        .Result(ok, err) -> return sema_stmt_for_in_type_requires_owned_iteration(ok) || sema_stmt_for_in_type_requires_owned_iteration(err)
        .Map(key, _, value) -> return sema_stmt_for_in_type_requires_owned_iteration(key) || sema_stmt_for_in_type_requires_owned_iteration(value)
        else -> return false
    }
}

fn sema_stmt_for_in_encoding_item_type(name: String) -> Type? {
    if sema_stmt_for_in_type_is_named(Type.Named{name: name}, "JSONReader") || sema_stmt_for_in_type_is_named(Type.Named{name: name}, "CBORReader") -> return Val(Type.Named{name: "DataEvent"})
    if sema_stmt_for_in_type_is_named(Type.Named{name: name}, "JSONLReader") || sema_stmt_for_in_type_is_named(Type.Named{name: name}, "XMLReader") -> return Val(Type.Named{name: "DataTree"})
    if sema_stmt_for_in_type_is_named(Type.Named{name: name}, "CSVReader") -> return Val(Type.Named{name: "CSVRow"})
    None
}

fn sema_stmt_for_in_iterable_fact(environment: SemaScopeEnvironment, collection_type: Type) -> SemaForInIterableFact? {
    if sema_stmt_for_in_named_type_name(collection_type) == None -> return None
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return None
    collection_identity := type_identity_key(collection_type)
    iterable_impl := SemaRegistrationImpl?{None}
    loop module_row in graph.modules {
        loop implementation in module_row.impls {
            if implementation.trait_name != (Val("Iterable")) || implementation.target_identity_key != collection_identity -> next
            iterable_impl = Val(implementation)
        }
    }
    iterable :: iterable_impl ?? return None
    iter_type := Type?{None}
    iter_symbol := String?{None}
    loop associated in iterable.associated_types {
        if associated.symbol.name == "Iter" -> iter_type = Val(associated.ty)
    }
    loop method in iterable.methods {
        if method.declaration.name == "iter" -> iter_symbol = Val(method.symbol.id.key)
    }
    resolved_iter_type :: iter_type ?? return None
    if sema_stmt_for_in_named_type_name(resolved_iter_type) == None -> return None
    iterator_identity := type_identity_key(resolved_iter_type)
    iterator_impl := SemaRegistrationImpl?{None}
    loop module_row in graph.modules {
        loop implementation in module_row.impls {
            if implementation.trait_name != (Val("Iterator")) || implementation.target_identity_key != iterator_identity -> next
            iterator_impl = Val(implementation)
        }
    }
    iterator :: iterator_impl ?? return None
    item_type := Type?{None}
    next_symbol := String?{None}
    loop associated in iterator.associated_types {
        if associated.symbol.name == "Item" -> item_type = Val(associated.ty)
    }
    loop method in iterator.methods {
        if method.declaration.name == "next" -> next_symbol = Val(method.symbol.id.key)
    }
    item :: item_type ?? return None
    iter_key :: iter_symbol ?? return None
    next_key :: next_symbol ?? return None
    Val(SemaForInIterableFact{
        method_kind: TForInMethod.Iterable{coll_type: iterable.target_identity_key, iter_type: iterator_identity, iter_symbol: iter_key, next_symbol: next_key, item_type: item},
        item_type: item,
    })
}

fn sema_stmt_for_in_method_kind(expression: Expr, collection: TExpr) -> TForInMethod? {
    if expression == {
        .MethodCall(receiver_expr, method, _, _, _, _, _, _, _, _) -> {
            if method == "chars" -> return Val(TForInMethod.Chars)
            if method == "lines" {
                receiver := TExpr?{None}
                if collection.kind == {
                    .MethodCall(value, _, _, _) -> receiver = Val(value)
                    else -> {}
                }
                if receiver != None {
                    receiver_value :: receiver ?? collection
                    if sema_stmt_for_in_type_is_named(receiver_value.ty, "FileReader") -> return Val(TForInMethod.LinesFile)
                    if sema_stmt_for_in_type_is_named(receiver_value.ty, "StdinHandle") -> return Val(TForInMethod.LinesStdin)
                    if receiver_expr == {
                        .Field(base, member, _) -> {
                            if member == "stdout" || member == "stderr" {
                                if receiver_value.kind == {
                                    .Field(base_value, _) -> {
                                        if sema_stmt_for_in_type_is_named(base_value.ty, "ProcessChild") -> return Val(TForInMethod.LinesProcessStream)
                                    }
                                    else -> {}
                                }
                            }
                        }
                        else -> {}
                    }
                }
                if sema_stmt_for_in_type_is_named(collection.ty, "FileLines") -> return Val(TForInMethod.LinesFile)
                if sema_stmt_for_in_type_is_named(collection.ty, "StdinLines") -> return Val(TForInMethod.LinesStdin)
                if sema_stmt_for_in_type_is_named(collection.ty, "ProcessLines") -> return Val(TForInMethod.LinesProcessStream)
            }
        }
        else -> {}
    }
    if collection.ty == {
        .Apply(name, args) -> {
            if name == "Receiver" && args.len() == 1 -> return Val(TForInMethod.ChannelReceiver)
        }
        .Named(name) -> {
            if sema_stmt_for_in_encoding_item_type(name) != None -> return Val(TForInMethod.EncodingReader{reader_type: name})
        }
        else -> {}
    }
    None
}

fn sema_stmt_for_in_source(expression: Expr, collection: TExpr, method_kind: TForInMethod?) -> TExpr Never! {
    special_source := method_kind == (Val(TForInMethod.Chars)) || method_kind == (Val(TForInMethod.LinesFile)) || method_kind == (Val(TForInMethod.LinesStdin)) || method_kind == (Val(TForInMethod.LinesProcessStream))
    if special_source {
        if expression == {
            .MethodCall(_, method, _, _, _, _, _, _, _, _) -> {
                if method == "chars" || method == "lines" {
                    if collection.kind == {
                        .MethodCall(receiver, _, _, _) -> return receiver
                        else -> {}
                    }
                }
            }
            else -> {}
        }
    }
    ~collection
}

fn sema_stmt_for_in_layout_type_name(ty: Type) -> String? {
    if ty == {
        .Named(name) | .Apply(name, _) -> return Val(name)
        else -> return None
    }
}

fn sema_stmt_for_in_expr_root_ident(expression: Expr) -> String? {
    if expression == {
        .Ident(name, _) -> return Val(name)
        .Field(base, _, _) | .Index(base, _, _, _) | .Slice(base, _, _, _, _) -> return sema_stmt_for_in_expr_root_ident(base)
        .Paren(value, _) | .Copy(value, _) -> return sema_stmt_for_in_expr_root_ident(value)
        else -> return None
    }
}

fn sema_stmt_for_in_can_consume_collection(expression: Expr) -> Bool Never! {
    if expression == {
        .Paren(value, _) | .Copy(value, _) -> return sema_stmt_for_in_can_consume_collection(value)
        .Field(base, _, _) | .Index(base, _, _, _) | .Slice(base, _, _, _, _) -> return sema_stmt_for_in_expr_root_ident(expression) == None
        else -> return true
    }
}

// Rust `collection_root_name`: the local a loop reads, through `.chars()`.
fn sema_stmt_for_in_collection_root(expression: Expr) -> String? {
    if expression == {
        .Ident(name, _) -> return Val(name)
        .MethodCall(receiver, method, _, _, _, _, _, _, _, _) -> {
            if method == "chars" -> return sema_stmt_for_in_collection_root(receiver)
            return None
        }
        else -> return None
    }
}

// The collection a `loop x in xs` holds across its body (E0507). A written
// drive (`loop x in &items`) holds the same source as a by-value one.
fn sema_stmt_for_in_driven_root(expression: Expr) -> String? {
    if expression == {
        .Place(inner, _, _) -> return sema_stmt_for_in_collection_root(inner)
        else -> return sema_stmt_for_in_collection_root(expression)
    }
}

// Rust `collection_changed_in_loop` / `collection_changed_by_method_in_loop`
// (E0507): a change to a collection an active loop is reading. `operation`
// is `` `name.method()` `` or `a mutation of `name``.
pub fn sema_collection_changed_in_loop(name: String, operation: String, span: Span) -> Diagnostic {
    sema_error("E0507", span, "While the loop is reading `{name}`, nothing may change it", "The loop reads `{name}` across its body, so {operation} can change the visited domain, element order, or termination.", "Choose the collection intent explicitly: use a separate result when the original traversal should stay unchanged; snapshot `{name}` and iterate the fixed original set when only the original values belong in the traversal; or use an explicit work queue when newly added values should be visited. Do not use index traversal unless its fixed domain and result meaning are intended.")
}

// The root local of a written place such as `xs`, `&xs`, or `a.b[i]`.
pub fn sema_expr_place_root_ident(expression: Expr) -> String? {
    if expression == {
        .Place(inner, _, _) | .Paren(inner, _) -> return sema_expr_place_root_ident(inner)
        else -> return sema_stmt_for_in_expr_root_ident(expression)
    }
}

// Rust's indexed-write gate: a Pool, ViewMut, Map, List, or fixed list slot.
fn sema_stmt_index_write_is_collection(ty: Type) -> Bool Never! {
    if sema_expr_unwrap_tag(ty) == {
        .Map(_, _, _) | .List(_) | .FixedList(_, _) -> true
        .Apply(name, _) -> name == "Pool" || name == "ViewMut"
        else -> false
    }
}

// D-SOA1 (E1108): the element name of a `[S]` whose struct is
// `#Layout(columnar)`; v1 supports only the core read surface on it.
pub fn sema_columnar_list_element(environment: SemaScopeEnvironment, ty: Type) -> String? {
    if sema_expr_unwrap_tag(ty) == .List(inner) {
        if inner == .Named(element) && sema_stmt_for_in_columnar(environment, inner) -> return Val(element)
    }
    None
}

// D-RANGE-EXCL1=C: only the exact shape `….len()` (no args) ends a range.
fn sema_stmt_range_end_len_root(end: Expr) -> String? {
    if end == .MethodCall(receiver, method, _, _, _, args, _, _, _, _) && method == "len" && args.len() == 0 {
        collection :: sema_stmt_for_in_collection_root(receiver)
        if collection != None -> return collection
        return sema_stmt_for_in_expr_root_ident(receiver)
    }
    None
}

// True when a statement in `body` indexes `root` with the name `index_var`.
fn sema_stmt_index_root_with_stmts(body: [Stmt], root: String, index_var: String) -> Bool Never! {
    loop statement in body {
        if sema_stmt_index_root_with_stmt(statement, root, index_var) -> return true
    }
    false
}

fn sema_stmt_index_root_with_stmt(statement: Stmt, root: String, index_var: String) -> Bool Never! {
    if statement == {
        .Expr(value) | .DeferClose(value, _) -> sema_stmt_index_root_with_expr(value, root, index_var)
        .Return(value, _) -> {
            if value == .Val(returned) -> return sema_stmt_index_root_with_expr(returned, root, index_var)
            false
        }
        .Val(binding) -> sema_stmt_index_root_with_expr(binding.init, root, index_var)
        .Assign(target, _, _, value) -> {
            if target == .Index(base, index, _, _) {
                if sema_stmt_for_in_expr_root_ident(base) == (Val(root)) && sema_stmt_index_is_ident(index, index_var) -> return true
                if sema_stmt_index_root_with_expr(base, root, index_var) || sema_stmt_index_root_with_expr(index, root, index_var) -> return true
            }
            sema_stmt_index_root_with_expr(value, root, index_var)
        }
        .While(cond, body, _, _, _) -> sema_stmt_index_root_with_expr(cond, root, index_var) || sema_stmt_index_root_with_stmts(body, root, index_var)
        .For(_, _, _, kind, body, _, _, _, _) -> {
            if kind == {
                .Range(start, end, step, _) -> {
                    if sema_stmt_index_root_with_expr(start, root, index_var) || sema_stmt_index_root_with_expr(end, root, index_var) -> return true
                    if step == .Val(stride) {
                        if sema_stmt_index_root_with_expr(stride, root, index_var) -> return true
                    }
                }
                .In(collection, step) -> {
                    if sema_stmt_index_root_with_expr(collection, root, index_var) -> return true
                    if step == .Val(stride) {
                        if sema_stmt_index_root_with_expr(stride, root, index_var) -> return true
                    }
                }
            }
            sema_stmt_index_root_with_stmts(body, root, index_var)
        }
        .Loop(body, _, _, _) | .Unsafe(_, _, body, _) | .Region(_, _, body, _) -> sema_stmt_index_root_with_stmts(body, root, index_var)
        .CountedLoop(init, cond, step, body, _, _, _) -> {
            if sema_stmt_index_root_with_expr(init.init, root, index_var) || sema_stmt_index_root_with_expr(cond, root, index_var) -> return true
            if step == .Val(step_statement) {
                if sema_stmt_index_root_with_stmt(step_statement, root, index_var) -> return true
            }
            sema_stmt_index_root_with_stmts(body, root, index_var)
        }
        .Switch(subject, arms, else_body, _) | .ComptimeSwitch(subject, arms, else_body, _) -> {
            if sema_stmt_index_root_with_expr(subject, root, index_var) -> return true
            loop arm in arms {
                if sema_stmt_index_root_with_expr(arm.cond, root, index_var) || sema_stmt_index_root_with_stmts(arm.body, root, index_var) -> return true
            }
            if else_body == .Val(fallback) -> return sema_stmt_index_root_with_stmts(fallback, root, index_var)
            false
        }
        else -> false
    }
}

fn sema_stmt_index_is_ident(value: Expr, name: String) -> Bool Never! {
    if value == .Ident(found, _) -> return found == name
    false
}

fn sema_stmt_index_root_with_args(args: [CallArg], root: String, index_var: String) -> Bool Never! {
    loop argument in args {
        if sema_stmt_index_root_with_expr(argument.expr, root, index_var) -> return true
    }
    false
}

fn sema_stmt_index_root_with_expr(value: Expr, root: String, index_var: String) -> Bool Never! {
    if value == {
        .Index(base, index, _, _) -> (sema_stmt_for_in_expr_root_ident(base) == (Val(root)) && sema_stmt_index_is_ident(index, index_var)) || sema_stmt_index_root_with_expr(base, root, index_var) || sema_stmt_index_root_with_expr(index, root, index_var)
        .Str(parts, _) -> {
            loop part in parts {
                if part == .Interp(inner, _) && sema_stmt_index_root_with_expr(inner, root, index_var) -> return true
            }
            false
        }
        .Call(call) -> sema_stmt_index_root_with_args(call.args, root, index_var)
        .CallValue(callee, args, _) -> sema_stmt_index_root_with_expr(callee, root, index_var) || sema_stmt_index_root_with_args(args, root, index_var)
        .MethodCall(receiver, _, _, _, _, args, _, _, _, _) -> sema_stmt_index_root_with_expr(receiver, root, index_var) || sema_stmt_index_root_with_args(args, root, index_var)
        .Field(inner, _, _) | .Spread(inner, _) | .Copy(inner, _) | .RawOf(inner, _) | .Place(inner, _, _) | .Present(inner, _) | .Tainted(inner, _, _) | .Ok(inner, _) | .Err(inner, _) | .OrFallback(inner, _, _, _) -> sema_stmt_index_root_with_expr(inner, root, index_var)
        .Try(inner, _, _, note) -> {
            if sema_stmt_index_root_with_expr(inner, root, index_var) -> return true
            if note == .Val(context_note) -> return sema_stmt_index_root_with_expr(context_note, root, index_var)
            false
        }
        .Binary(_, left, right, _) -> sema_stmt_index_root_with_expr(left, root, index_var) || sema_stmt_index_root_with_expr(right, root, index_var)
        .ListLit(items, _) -> {
            loop item in items {
                if sema_stmt_index_root_with_expr(item, root, index_var) -> return true
            }
            false
        }
        .TupleLit(fields, _, _) -> {
            loop field in fields {
                if sema_stmt_index_root_with_expr(field.value, root, index_var) -> return true
            }
            false
        }
        .Slice(base, start, end, range, _) -> {
            if sema_stmt_index_root_with_expr(base, root, index_var) -> return true
            if range == .Val(window) -> return sema_stmt_index_root_with_expr(window, root, index_var)
            sema_stmt_index_root_with_expr(start, root, index_var) || sema_stmt_index_root_with_expr(end, root, index_var)
        }
        .If(cond, then_body, then_value, else_body, else_value, _) -> sema_stmt_index_root_with_expr(cond, root, index_var) || sema_stmt_index_root_with_stmts(then_body, root, index_var) || sema_stmt_index_root_with_expr(then_value, root, index_var) || sema_stmt_index_root_with_stmts(else_body, root, index_var) || sema_stmt_index_root_with_expr(else_value, root, index_var)
        else -> false
    }
}

fn sema_stmt_for_in_consumes_collection(collection_type: Type, item_type: Type) -> Bool Never! {
    if collection_type == {
        .List(_) | .FixedList(_, _) -> return sema_stmt_for_in_type_requires_owned_iteration(item_type)
        .Apply(name, _) -> return name == "Stream" || name == "Iter" || name == "ViewIter"
        .Named(name) -> return name == "HTTPBodyChunks"
        else -> return false
    }
}

fn sema_stmt_for_in_by_value(collection_type: Type, item_type: Type) -> Bool Never! {
    if collection_type == {
        .List(_) | .FixedList(_, _) -> return sema_stmt_for_in_type_requires_owned_iteration(item_type)
        .Apply(name, _) -> return name == "Stream" || name == "Iter"
        .Named(name) -> return name == "HTTPBodyChunks"
        else -> return false
    }
}



fn sema_stmt_for_in_columnar_list_type(collection_type: Type) -> Bool Never! {
    if collection_type == {
        .List(_) | .FixedList(_, _) -> true
        else -> false
    }
}

fn sema_stmt_for_in_is_range(collection_type: Type) -> Bool Never! {
    if collection_type == {
        .InlineRange(_, _, _) -> return true
        .Named(name) -> return name == "Range"
        else -> return false
    }
}

fn sema_stmt_for_in_range_zero(span: Span) -> TExpr Never! {
    sema_tir_expr(Type.Int, TExprKind.IntLit{value: 0, width: None}, span)
}

// `ty` is None when the loop source failed its own check: the loop name
// stays in scope untyped, so reads of it in the body check to nothing and add
// no follow-on report (the same poison as `sema_stmt_declare_unchecked_binding`).
// The returned local carries the declared symbol, so lowering binds the loop
// name under the identity every body read resolves by. None when the name
// could not be declared (reported here).
fn sema_stmt_for_in_decl_loop_local(name: String, name_span: Span, ty: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> TLocal? {
    owner := sema_scope_local_owner_key(scopes)
    symbol := Symbol{
        id: symbol_id(SymbolKind.Local, environment.module_identity, owner, name),
        kind: SymbolKind.Local,
        name: name,
        module_name: environment.module_identity,
        owner: Val(owner),
        span: name_span,
        ty: ty,
        visibility: 0,
    }
    if !sema_scope_declare_local(&scopes, symbol, false, AccessConvention.Read, None, false) {
        &diagnostics.push(sema_already_defined(name, name_span))
        return None
    }
    if ty != None -> sema_ownership_declare_binding(&state, symbol, false)
    Val(tir_symbol_local(name, name_span, symbol.id))
}

fn sema_stmt_for_in_pair_types(collection_type: Type, item_type: Type) -> SemaForInPairTypes? {
    if collection_type == {
        .List(_) | .FixedList(_, _) -> return Val(SemaForInPairTypes{first: Type.Int, second: item_type})
        .Map(key, _, value) -> return Val(SemaForInPairTypes{first: key, second: value})
        .Apply(name, args) -> {
            if (name == "View" || name == "ViewMut" || name == "ComputeViewMut") && args.len() == 1 -> return Val(SemaForInPairTypes{first: Type.Int, second: args[0]})
        }
        else -> {}
    }
    None
}

fn sema_stmt_for_in_method_pair_is_supported(method_kind: TForInMethod?) -> Bool Never! {
    method_kind == None
}

fn sema_stmt_for_in_item_type(collection_type: Type, method_kind: TForInMethod?, iterable_item_type: Type?) -> Type? {
    if iterable_item_type != None -> return iterable_item_type
    if method_kind == {
        .Val(method) -> {
            if method == {
                .Chars -> return Val(Type.Char)
                .LinesFile | .LinesStdin | .LinesProcessStream -> return Val(Type.String)
                .ChannelReceiver -> {
                    if collection_type == {
                        .Apply(name, args) -> {
                            if name == "Receiver" && args.len() == 1 -> return Val(args[0])
                        }
                        else -> {}
                    }
                }
                .EncodingReader(reader_type) -> return sema_stmt_for_in_encoding_item_type(reader_type)
                .Iterable(_, _, _, _, item_type) -> return Val(item_type)
            }
        }
        .None -> {}
    }
    if collection_type == {
        .List(inner) | .FixedList(inner, _) -> return Val(inner)
        .Map(key, _, value) -> return Val(Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "key", ty: key}, TypeTupleField{name: "value", ty: value}}})
        .Apply(name, args) -> {
            if (name == "Iter" || name == "ViewIter" || name == "Stream" || name == "View" || name == "ViewMut" || name == "ComputeViewMut" || name == "Receiver") && args.len() == 1 -> return Val(args[0])
        }
        .Named(name) -> {
            if name == "HTTPBodyChunks" -> return Val(Type.Result{ok: Type.List{element: Type.Named{name: "U8"}}, err: Type.Named{name: "HTTPError"}})
            if name == "FileLines" || name == "StdinLines" || name == "ProcessLines" -> return Val(Type.String)
            if name == "Range" -> return Val(Type.Int)
            return sema_stmt_for_in_encoding_item_type(name)
        }
        .InlineRange(_, _, _) -> return Val(Type.Int)
        else -> {}
    }
    None
}

fn sema_stmt_for_in_columnar(environment: SemaScopeEnvironment, item_type: Type) -> Bool Never! {
    item_name :: sema_stmt_for_in_layout_type_name(item_type) ?? return false
    loop definition in environment.checked_types {
        if definition.name == item_name && definition.layout == (Val(TStructLayout.Columnar)) -> return true
    }
    false
}

fn sema_stmt_check_source_stride(expr: Expr, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    value :: sema_check_expression(expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if !sema_stmt_range_integer_type(value.ty) {
        &diagnostics.push(sema_error("E0123", expr_span(expr), "a source loop stride must be Int, not {type_name(value.ty)}", "the stride counts source pulls, so it must be a positive whole number", "use an Int stride of 1 or more"))
        return None
    }
    if expr == {
        .Int(number, span, _, _) -> {
            if number <= 0 {
                &diagnostics.push(sema_error("E0123", span, "a source loop stride must be positive", "zero or a negative value cannot select a later source item", "use a stride of 1 or more"))
                return None
            }
        }
        else -> {}
    }
    Val(value)
}

fn sema_stmt_unknown_loop_label(name: String, span: Span) -> Diagnostic {
    sema_error("E0987", span, "no loop labeled `{name}` is in scope", "a named `break` or `next` must target an enclosing labeled loop", "label the target loop with `{name} ::` first")
}
fn sema_stmt_move_direct(expr: Expr, state: &SemaOwnershipState, scopes: SemaScopeTable, consumer: String, diagnostics: &[Diagnostic]) -> Bool {
    if expr == {
        .Place(_, _, _) | .Copy(_, _) -> return true
        else -> {}
    }
    sema_ownership_mark_unmarked_move(&state, expr, scopes, consumer, &diagnostics)
}


fn sema_stmt_view_access(ty: Type) -> AccessConvention? {
    if ty == {
        .Apply(name, _) -> {
            if name == "View" -> return Val(AccessConvention.Read)
            if name == "ViewMut" -> return Val(AccessConvention.Write)
        }
        else -> {}
    }
    None
}

fn sema_stmt_view_slot_equal(left: [String], right: [String]) -> Bool Never! {
    if left.len() != right.len() -> return false
    index := 0
    loop index < left.len() {
        if left[index] != right[index] -> return false
        index += 1
    }
    true
}

fn sema_stmt_view_source_equal(left: ViewSource, right: ViewSource) -> Bool Never! {
    if left == {
        .Receiver -> if right == {.Receiver -> true else -> false}
        .Parameter(index) -> if right == {.Parameter(other) -> index == other else -> false}
        .Static(module_path, name) -> if right == {.Static(other_module, other_name) -> module_path == other_module && name == other_name else -> false}
    }
}

fn sema_stmt_view_projection_equal(left: ViewSourceProjection, right: ViewSourceProjection) -> Bool Never! {
    if left == {
        .Field(name) -> if right == {.Field(other) -> name == other else -> false}
        .Index -> if right == {.Index -> true else -> false}
        .Range -> if right == {.Range -> true else -> false}
    }
}

fn sema_stmt_view_source_path_equal(left: ViewSourcePath, right: ViewSourcePath) -> Bool Never! {
    if !sema_stmt_view_source_equal(left.source, right.source) || left.projections.len() != right.projections.len() -> return false
    index := 0
    loop index < left.projections.len() {
        if !sema_stmt_view_projection_equal(left.projections[index], right.projections[index]) -> return false
        index += 1
    }
    true
}

fn sema_stmt_record_static_view_return(provenance: &ViewProvenanceMap, slot: [String], source: ViewSourcePath, access: AccessConvention, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    mutable := access == AccessConvention.Write
    entry_index := 0
    loop entry_index < provenance.entries.len() {
        entry :: provenance.entries[entry_index]
        if sema_stmt_view_slot_equal(entry.slot, slot) {
            if entry.value.mutable != mutable {
                &diagnostics.push(sema_error("E2305", span, "returned view paths disagree about read or write access", "one public output slot cannot sometimes be a read view and sometimes be an exclusive write view", "return the same view access on every path"))
                return false
            }
            source_index := 0
            loop source_index < entry.value.sources.len() {
                if sema_stmt_view_source_path_equal(entry.value.sources[source_index], source) -> return true
                source_index += 1
            }
            &provenance.entries[entry_index].value.sources.push(source)
            return true
        }
        entry_index += 1
    }
    sources := [ViewSourcePath]{source}
    &provenance.entries.push(ViewProvenanceEntry{slot: slot, value: ViewProvenance{sources: sources, mutable: mutable}})
    true
}

fn sema_stmt_call_return_views_at(span: Span, context: SemaCheckContext) -> [SemaCallReturnViewFact] Never! {
    index := context.call_return_views.len() - 1
    loop index >= 0 {
        row :: context.call_return_views[index]
        if row.span.start == span.start && row.span.end == span.end -> return row.facts
        index -= 1
    }
    [SemaCallReturnViewFact]{}
}

fn sema_stmt_call_return_views_for_expr(expr: Expr, context: SemaCheckContext) -> [SemaCallReturnViewFact] {
    if expr == {
        .Call(call) -> return sema_stmt_call_return_views_at(call.name_span, context)
        .MethodCall(_, _, method_span, _, _, _, _, _, _, _) | .OptMethodCall(_, _, method_span, _, _, _) -> return sema_stmt_call_return_views_at(method_span, context)
        .CallValue(_, _, span) -> return sema_stmt_call_return_views_at(span, context)
        .Paren(value, _) | .Place(value, _, _) | .Tainted(value, _, _) | .Try(value, _, _, _) | .Present(value, _) | .Ok(value, _) -> return sema_stmt_call_return_views_for_expr(value, context)
        .Field(base, member, _) | .OptField(base, member, _, _, _) -> {
            source := sema_stmt_call_return_views_for_expr(base, context)
            result := [SemaCallReturnViewFact]{}
            index := 0
            loop index < source.len() {
                fact :: source[index]
                if fact.slot.len() > 0 && (fact.slot[0] == member || fact.slot[0] == ".{member}") {
                    slot := [String]{}
                    slot_index := 1
                    loop slot_index < fact.slot.len() {
                        &slot.push(fact.slot[slot_index])
                        slot_index += 1
                    }
                    &result.push(SemaCallReturnViewFact{slot: slot, access: fact.access, places: fact.places, sources: fact.sources})
                }
                index += 1
            }
            return result
        }
        else -> [SemaCallReturnViewFact]{}
    }
}
fn sema_stmt_local_view_facts_for_expr(expr: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState, context: SemaCheckContext) -> [SemaCallReturnViewFact] {
    if expr == {
        .Ident(name, _) -> {
            symbol :: sema_scope_resolve(scopes, name) ?? return [SemaCallReturnViewFact]{}
            result := [SemaCallReturnViewFact]{}
            loop local_fact in context.local_view_provenance {
                if local_fact.carrier_key != symbol.id.key -> next
                projected_expr := expr
                projectable := true
                loop part in local_fact.output_path {
                    member := part
                    if part.starts_with(".") -> member = part.slice(1, part.len())
                    if part.starts_with("[") || part == "*" {
                        projectable = false
                        break
                    }
                    projected_expr = Expr.Field{base: projected_expr, member: member, span: expr_span(projected_expr)}
                }
                places := [SemaOwnershipPlace]{}
                if projectable -> places = sema_ownership_places_from_expr_in_state(projected_expr, scopes, &state)
                &result.push(SemaCallReturnViewFact{slot: local_fact.output_path, access: local_fact.access, places: places, sources: local_fact.sources})
            }
            return result
        }
        .Field(base, member, _) | .OptField(base, member, _, _, _) -> {
            source := sema_stmt_local_view_facts_for_expr(base, scopes, &state, context)
            result := [SemaCallReturnViewFact]{}
            loop fact in source {
                if fact.slot.len() == 0 || (fact.slot[0] != member && fact.slot[0] != ".{member}") -> next
                slot := [String]{}
                index := 1
                loop index < fact.slot.len() {
                    &slot.push(fact.slot[index])
                    index += 1
                }
                &result.push(SemaCallReturnViewFact{slot: slot, access: fact.access, places: fact.places, sources: fact.sources})
            }
            return result
        }
        .Paren(value, _) | .Place(value, _, _) | .Tainted(value, _, _) | .Try(value, _, _, _) | .Present(value, _) | .Ok(value, _) -> return sema_stmt_local_view_facts_for_expr(value, scopes, &state, context)
        else -> [SemaCallReturnViewFact]{}
    }
}

fn sema_stmt_store_local_view_provenance(carrier_key: String, facts: [SemaCallReturnViewFact], context: &SemaCheckContext) Never! {
    loop fact in facts {
        &context.local_view_provenance.push(SemaLocalViewProvenance{carrier_key: carrier_key, output_path: fact.slot, access: fact.access, sources: fact.sources})
    }
}

fn sema_stmt_view_owner_path(slot: [String]) -> [String] Never! {
    result := [String]{}
    index := 0
    loop index < slot.len() {
        part :: slot[index]
        if {
            part.starts_with(".") || part.starts_with("[") || part == "*" -> {
                &result.push(part)
            }
            else -> {
                &result.push(".{part}")
            }
        }
        index += 1
    }
    result
}

fn sema_stmt_call_view_has_dynamic_source(fact: SemaCallReturnViewFact) -> Bool Never! {
    loop source in fact.sources {
        if source.source == {
            .Receiver | .Parameter(_) -> return true
            .Static(_, _) -> {}
        }
    }
    false
}

fn sema_stmt_record_call_view_return(state: &SemaOwnershipState, fact: SemaCallReturnViewFact, slot: [String], scopes: SemaScopeTable, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    provenance := context.return_view_provenance ?? ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
    valid := true
    if {
        fact.places.len() > 0 -> {
            if !sema_ownership_record_view_returns(&state, fact.places, fact.access, slot, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, &provenance, span, &diagnostics) -> valid = false
        }
        sema_stmt_call_view_has_dynamic_source(fact) || fact.sources.len() == 0 -> {
            if !sema_ownership_record_view_returns(&state, [SemaOwnershipPlace]{}, fact.access, slot, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, &provenance, span, &diagnostics) -> valid = false
        }
    }
    loop source in fact.sources {
        if source.source == {
            .Static(_, _) -> {
                if !sema_stmt_record_static_view_return(&provenance, slot, source, fact.access, span, &diagnostics) -> valid = false
            }
            else -> {}
        }
    }
    context.return_view_provenance = Val(provenance)
    valid
}

fn sema_stmt_string_view_type(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, args) -> name == "View" && args.len() == 1 && args[0] == (Type.Named{name: "str"})
        else -> false
    }
}

// Rust `report_temporary_view_source`: a view-returning call whose parameter
// source is a temporary owner (dropped at the end of the statement). True
// when the fact names a temporary.
fn sema_stmt_report_temporary_view_sources(fact: SemaCallReturnViewFact, string_view: Bool, diagnostics: &[Diagnostic]) -> Bool {
    loop span in fact.temporaries {
        diagnostic :: if string_view -> sema_error("E2307", span, "A returned view cannot borrow from a temporary argument", "The temporary owner is dropped at the end of this statement, while the returned view remains live", "Store the owner in a named binding first, then pass that binding to the view-returning call") else -> sema_error("E2305", span, "a returned view cannot borrow from a temporary argument", "the temporary owner is dropped at the end of this statement, while the returned view remains live", "store the owner in a named binding first, then pass that binding to the view-returning call")
        duplicate :: loop previous in diagnostics {
            if previous.code == diagnostic.code && previous.span == diagnostic.span -> break true
        } ?? false
        if !duplicate -> &diagnostics.push(diagnostic)
    }
    fact.temporaries.len() > 0
}

fn sema_stmt_record_return_views(expr: Expr, ty: Type, scopes: SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    call_facts := sema_stmt_call_return_views_for_expr(expr, context)
    if call_facts.len() > 0 {
        valid := true
        direct_view := sema_stmt_view_access(ty) != None
        saw_direct := false
        index := 0
        loop index < call_facts.len() {
            fact :: call_facts[index]
            if !direct_view || fact.slot.len() == 0 {
                saw_direct = true
                temporary :: sema_stmt_report_temporary_view_sources(fact, sema_stmt_string_view_type(ty), &diagnostics)
                if temporary -> valid = false
                if (!temporary || fact.places.len() > 0) && !sema_stmt_record_call_view_return(&state, fact, fact.slot, scopes, &context, expr_span(expr), &diagnostics) -> valid = false
            }
            index += 1
        }
        if direct_view && !saw_direct {
            access :: sema_stmt_view_access(ty) ?? AccessConvention.Read
            provenance := context.return_view_provenance ?? ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
            if !sema_ownership_record_view_returns(&state, [SemaOwnershipPlace]{}, access, [String]{}, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, &provenance, expr_span(expr), &diagnostics) -> valid = false
            context.return_view_provenance = Val(provenance)
        }
        return valid
    }
    local_facts := sema_stmt_local_view_facts_for_expr(expr, scopes, &state, context)
    if local_facts.len() > 0 {
        valid := true
        direct_view := sema_stmt_view_access(ty) != None
        saw_direct := false
        loop fact in local_facts {
            if !direct_view || fact.slot.len() == 0 {
                saw_direct = true
                if !sema_stmt_record_call_view_return(&state, fact, fact.slot, scopes, &context, expr_span(expr), &diagnostics) -> valid = false
            }
        }
        if direct_view && !saw_direct {
            access :: sema_stmt_view_access(ty) ?? AccessConvention.Read
            provenance := context.return_view_provenance ?? ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
            if !sema_ownership_record_view_returns(&state, [SemaOwnershipPlace]{}, access, [String]{}, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, &provenance, expr_span(expr), &diagnostics) -> valid = false
            context.return_view_provenance = Val(provenance)
        }
        return valid
    }
    access :: sema_stmt_view_access(ty) ?? return true
    places := sema_ownership_places_from_expr_in_state(expr, scopes, &state)
    provenance := context.return_view_provenance ?? ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
    valid := sema_ownership_record_view_returns(&state, places, access, [String]{}, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, &provenance, expr_span(expr), &diagnostics)
    context.return_view_provenance = Val(provenance)
    valid
}

fn sema_stmt_binding_is_place_view(expr: Expr) -> Bool Never! {
    if expr == {
        .Place(_, access, _) -> access != PlaceAccess.Take
        .Paren(value, _) -> sema_stmt_binding_is_place_view(value)
        else -> false
    }
}

// Rust `place_from_expr` on a range: `xs[a..b]` over a named place (through
// fields and indexes) is the source of a read window.
fn sema_stmt_is_bare_range_place(expr: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState) -> Bool {
    if expr == .Slice(_, _, _, _, _) -> return sema_ownership_places_from_expr_in_state(expr, scopes, &state).len() > 0
    false
}

fn sema_stmt_record_binding_views(binding: Binding, init_ty: Type, scopes: SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if sema_pin_record_binding(&state, binding, init_ty, scopes) -> return true
    call_facts := sema_stmt_call_return_views_for_expr(binding.init, context)
    if call_facts.len() > 0 {
        owner_facts := [SemaOwnershipCallViewFact]{}
        valid := true
        loop fact in call_facts {
            if sema_stmt_report_temporary_view_sources(fact, sema_stmt_string_view_type(init_ty), &diagnostics) -> valid = false
            if {
                fact.places.len() > 0 -> {
                    &owner_facts.push(SemaOwnershipCallViewFact{output_path: sema_stmt_view_owner_path(fact.slot), access: fact.access, places: fact.places})
                }
                fact.temporaries.len() > 0 -> {}
                sema_stmt_call_view_has_dynamic_source(fact) || fact.sources.len() == 0 -> {
                    empty_provenance := ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
                    if !sema_ownership_record_view_returns(&state, [SemaOwnershipPlace]{}, fact.access, fact.slot, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, &empty_provenance, expr_span(binding.init), &diagnostics) -> valid = false
                }
            }
        }
        if owner_facts.len() > 0 && !sema_ownership_record_call_view_batch(&state, binding.name, binding.name_span, owner_facts, scopes) -> valid = false
        local_symbol :: sema_scope_resolve(scopes, binding.name) ?? return false
        sema_stmt_store_local_view_provenance(local_symbol.id.key, call_facts, &context)
        return valid
    }
    local_facts := sema_stmt_local_view_facts_for_expr(binding.init, scopes, &state, context)
    if local_facts.len() > 0 {
        owner_facts := [SemaOwnershipCallViewFact]{}
        valid := true
        loop fact in local_facts {
            if {
                fact.places.len() > 0 -> {
                    &owner_facts.push(SemaOwnershipCallViewFact{output_path: sema_stmt_view_owner_path(fact.slot), access: fact.access, places: fact.places})
                }
                sema_stmt_call_view_has_dynamic_source(fact) || fact.sources.len() == 0 -> {
                    empty_provenance := ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
                    if !sema_ownership_record_view_returns(&state, [SemaOwnershipPlace]{}, fact.access, fact.slot, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, &empty_provenance, expr_span(binding.init), &diagnostics) -> valid = false
                }
            }
        }
        if owner_facts.len() > 0 && !sema_ownership_record_call_view_batch(&state, binding.name, binding.name_span, owner_facts, scopes) -> valid = false
        local_symbol :: sema_scope_resolve(scopes, binding.name) ?? return false
        sema_stmt_store_local_view_provenance(local_symbol.id.key, local_facts, &context)
        return valid
    }
    access :: sema_stmt_view_access(init_ty) ?? return true
    if sema_stmt_binding_is_place_view(binding.init) -> return sema_ownership_record_binding_view(&state, binding, scopes)
    places := sema_ownership_places_from_expr_in_state(binding.init, scopes, &state)
    if places.len() == 0 {
        empty_provenance := ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
        _ := sema_ownership_record_view_returns(&state, [SemaOwnershipPlace]{}, access, [String]{}, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, &empty_provenance, expr_span(binding.init), &diagnostics)
        return false
    }
    fact := SemaOwnershipCallViewFact{output_path: [String]{}, access: access, places: places}
    sema_ownership_record_call_view_batch(&state, binding.name, binding.name_span, [SemaOwnershipCallViewFact]{fact}, scopes)
}

fn sema_stmt_destructure_names(pattern: BindPattern) -> [BindName] Never! {
    if pattern == {
        .Struct(_, _, fields, _, _) -> fields
        .List(elements, _) | .Tuple(elements, _) -> elements
        .Refutable(_, _, names, _) -> names
    }
}

fn sema_stmt_destructure_local(name: BindName, ty: Type, mutable: Bool, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> TLocal? {
    local_name := if name.rename == .Val(rename) -> rename.name else -> name.name
    local_span := if name.rename == .Val(rename) -> rename.span else -> name.span
    owner := sema_scope_local_owner_key(scopes)
    id := symbol_id(SymbolKind.Local, environment.module_identity, owner, local_name)
    symbol := Symbol{id: id, kind: SymbolKind.Local, name: local_name, module_name: environment.module_identity, owner: Val(owner), span: local_span, ty: Val(ty), visibility: 0}
    if !sema_scope_declare_local(&scopes, symbol, mutable, AccessConvention.Read, None, false) {
        &diagnostics.push(sema_already_defined(local_name, local_span))
        return None
    }
    sema_ownership_declare_binding(&state, symbol, false)
    sema_single_use_note_binding(&state, symbol, environment)
    local := tir_symbol_local(local_name, local_span, id)
    local.mutable = mutable
    Val(local)
}

fn sema_stmt_destructure_recover(pattern: BindPattern, mutable: Bool, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) Never! {
    loop name in sema_stmt_destructure_names(pattern) {
        _ := sema_stmt_destructure_local(name, Type.Int, mutable, environment, &scopes, &state, &diagnostics)
    }
}

fn sema_stmt_destructure_count(actual: Int, expected: Int, tuple: Bool, literal: Bool, span: Span, diagnostics: &[Diagnostic]) {
    unit := if tuple -> "member" else -> "item"
    actual_suffix := if actual == 1 -> "" else -> "s"
    expected_suffix := if expected == 1 -> "" else -> "s"
    container := if tuple -> if literal -> "tuple literal" else -> "tuple" else -> "list"
    why := if tuple -> if literal -> "a tuple pattern must name exactly as many members as the literal holds" else -> "a tuple pattern must name exactly as many members as the tuple holds" else -> "a list pattern must name exactly as many items as the list holds"
    target := if tuple -> "tuple" else -> "list"
    &diagnostics.push(sema_error("E0315", span, "this pattern binds {actual} {unit}{actual_suffix}, but the {container} has {expected}", why, "name {expected} {unit}{expected_suffix} to match the {target}"))
}

fn sema_stmt_contains_shared_guard(ty: Type, environment: SemaScopeEnvironment, seen: &[String]) -> Bool Never! {
    sema_stmt_type_contains_shared_guard(ty, environment.registration_graph, environment.module_identity, environment.generic_params, &seen)
}

// The walk takes the registration graph, module identity and generic
// parameters it reads instead of the whole environment: a nominal's fields are
// checked in the nominal's module, and copying the environment per nominal to
// change its module copied the whole registration graph each time.
fn sema_stmt_type_contains_shared_guard(ty: Type, graph: SemaRegistrationGraph?, module_identity: String, generic_params: [TGenericParam], seen: &[String]) -> Bool Never! {
    resolved := ty
    if graph == .Val(registered) -> resolved = sema_type_resolve_declared_with_generics(registered, ty, module_identity, generic_params)
    if resolved == {
        .Apply(name, args) -> {
            if name == "SharedGuard" -> return true
            loop argument in args {
                if sema_stmt_type_contains_shared_guard(argument, graph, module_identity, generic_params, &seen) -> return true
            }
        }
        .Named(_) -> {}
        .List(inner) | .FixedList(inner, _) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) -> return sema_stmt_type_contains_shared_guard(inner, graph, module_identity, generic_params, &seen)
        .Map(key, _, value) | .Result(key, value) -> return sema_stmt_type_contains_shared_guard(key, graph, module_identity, generic_params, &seen) || sema_stmt_type_contains_shared_guard(value, graph, module_identity, generic_params, &seen)
        .Tuple(fields) -> {
            loop field in fields {
                if sema_stmt_type_contains_shared_guard(field.ty, graph, module_identity, generic_params, &seen) -> return true
            }
            return false
        }
        .Union(members) -> {
            loop member in members {
                if sema_stmt_type_contains_shared_guard(member, graph, module_identity, generic_params, &seen) -> return true
            }
            return false
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop parameter in params {
                if sema_stmt_type_contains_shared_guard(parameter, graph, module_identity, generic_params, &seen) -> return true
            }
            if ret == .Val(result) -> return sema_stmt_type_contains_shared_guard(result, graph, module_identity, generic_params, &seen)
            return false
        }
        else -> return false
    }
    if graph == .Val(registered) {
        nominal :: sema_pattern_nominal(registered, module_identity, resolved) ?? return false
        key := nominal.symbol.id.key
        if seen.contains(key) -> return false
        &seen.push(key)
        generic_names := (loop parameter in nominal.generic_params -> parameter.name)
        arguments := sema_pattern_subject_args(resolved)
        owner_module :: nominal.symbol.module_name
        loop field in nominal.fields {
            field_type := sema_inference_substitute_type(field.ty, generic_names, arguments)
            if sema_stmt_type_contains_shared_guard(field_type, graph, owner_module, generic_params, &seen) -> return true
        }
        loop variant in nominal.variants {
            if variant.payload == {
                .Unit -> {}
                .Single(value, _) -> {
                    if sema_stmt_type_contains_shared_guard(sema_inference_substitute_type(value, generic_names, arguments), graph, owner_module, generic_params, &seen) -> return true
                }
                .Named(fields) -> loop field in fields {
                    if sema_stmt_type_contains_shared_guard(sema_inference_substitute_type(field.ty, generic_names, arguments), graph, owner_module, generic_params, &seen) -> return true
                }
            }
        }
    }
    false
}

fn sema_stmt_destructure_moves_field(ty: Type, pattern: BindPattern, environment: SemaScopeEnvironment) -> Bool Never! {
    seen := [String]{}
    if sema_stmt_contains_shared_guard(ty, environment, &seen) -> return true
    if pattern == {
        .Tuple(_, _) -> return sema_shared_access_is_cell_guard_type(ty)
        else -> return false
    }
    false
}

struct SemaRefutableFallbackCheck {
    pub tir: TOrFallback?
    pub statements: [TStmt]
    pub complete: Bool
    pub ambient_err: TLocal?
}

fn sema_stmt_refutable_expr_diverges(expr: Expr) -> Bool Never! {
    if expr == {
        .Paren(inner, _) -> return sema_stmt_refutable_expr_diverges(inner)
        .Todo(_, _) | .NoElse(_) -> return true
        .Call(call) -> return call.name == "panic"
        else -> return false
    }
}

fn sema_stmt_refutable_expr_is_true(expr: Expr) -> Bool Never! {
    if expr == {
        .Paren(inner, _) -> return sema_stmt_refutable_expr_is_true(inner)
        .Bool(value, _) -> return value
        else -> return false
    }
}

fn sema_stmt_refutable_is_subjectless_guard(subject: Expr, span: Span) -> Bool Never! {
    if subject == {
        .Bool(value, subject_span) -> return value && subject_span == span
        else -> return false
    }
}

fn sema_stmt_refutable_loop_labels(nested_labels: [String], label: NamedSpan?) -> [String] Never! {
    labels := [String]{}
    loop nested_label in nested_labels -> &labels.push(nested_label)
    if label == {
        .Val(value) -> &labels.push(value.name)
        .None -> {}
    }
    labels
}

fn sema_stmt_refutable_block_exits(statements: [Stmt]) -> Bool Never! {
    loop statement in statements {
        if sema_stmt_refutable_statement_exits(statement) -> return true
    }
    false
}

fn sema_stmt_refutable_switch_exits(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span) -> Bool Never! {
    if arms.len() == 0 -> return false
    fallback_exits := if else_body == {
        .Val(body) -> sema_stmt_refutable_block_exits(body)
        .None -> !sema_stmt_refutable_is_subjectless_guard(subject, span)
    }
    loop arm in arms {
        if !sema_stmt_refutable_block_exits(arm.body) -> return false
    }
    fallback_exits
}

fn sema_stmt_refutable_statement_exits(statement: Stmt) -> Bool Never! {
    if statement == {
        .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) -> return true
        .Expr(expr) -> return sema_stmt_refutable_expr_diverges(expr)
        .Switch(subject, arms, else_body, span) -> return sema_stmt_refutable_switch_exits(subject, arms, else_body, span)
        .Loop(body, _, _, _) -> return !sema_stmt_refutable_loop_body_can_break(body)
        .While(cond, body, _, _, _) -> return sema_stmt_refutable_expr_is_true(cond) && !sema_stmt_refutable_loop_body_can_break(body)
        .CountedLoop(_, cond, _, body, _, _, _) -> return sema_stmt_refutable_expr_is_true(cond) && !sema_stmt_refutable_loop_body_can_break(body)
        else -> return false
    }
}

fn sema_stmt_refutable_loop_body_can_break(statements: [Stmt]) -> Bool Never! {
    sema_stmt_refutable_loop_body_can_break_inner(statements, [String]{}, true)
}

fn sema_stmt_refutable_label_is_nested(nested_labels: [String], name: String) -> Bool Never! {
    loop nested_label in nested_labels {
        if nested_label == name -> return true
    }
    false
}

// A `?? break` fallback leaves the enclosing loop exactly like a statement
// `break`, so it counts as a reachable loop exit.
fn sema_stmt_refutable_fallback_can_break(fallback: OrFallback, nested_labels: [String], allow_unlabelled: Bool) -> Bool Never! {
    if fallback == {
        .Break(_) -> allow_unlabelled
        .BreakLabel(name, _) -> !sema_stmt_refutable_label_is_nested(nested_labels, name)
        .Block(body, _, _) -> sema_stmt_refutable_loop_body_can_break_inner(body, nested_labels, allow_unlabelled)
        else -> false
    }
}

fn sema_stmt_refutable_expr_can_break(expr: Expr, nested_labels: [String], allow_unlabelled: Bool) -> Bool Never! {
    if expr == {
        .Paren(inner, _) -> sema_stmt_refutable_expr_can_break(inner, nested_labels, allow_unlabelled)
        .OrFallback(value, fallback, _, _) -> sema_stmt_refutable_fallback_can_break(fallback, nested_labels, allow_unlabelled) || sema_stmt_refutable_expr_can_break(value, nested_labels, allow_unlabelled)
        else -> false
    }
}

fn sema_stmt_refutable_binding_can_break(binding: Binding, nested_labels: [String], allow_unlabelled: Bool) -> Bool Never! {
    if binding.pattern == .Val(pattern) {
        if pattern == {
            .Refutable(_, fallback, _, _) -> {
                if sema_stmt_refutable_fallback_can_break(fallback, nested_labels, allow_unlabelled) -> return true
            }
            else -> {}
        }
    }
    sema_stmt_refutable_expr_can_break(binding.init, nested_labels, allow_unlabelled)
}

fn sema_stmt_refutable_loop_body_can_break_inner(statements: [Stmt], nested_labels: [String], allow_unlabelled: Bool) -> Bool Never! {
    loop statement in statements {
        can_break := if statement == {
            .Break(_) | .BreakValue(_, _) -> allow_unlabelled
            .BreakLabel(name, _) | .BreakLabelValue(name, _, _, _) -> !sema_stmt_refutable_label_is_nested(nested_labels, name)
            .Expr(expr) -> sema_stmt_refutable_expr_can_break(expr, nested_labels, allow_unlabelled)
            .Assign(_, _, _, value) -> sema_stmt_refutable_expr_can_break(value, nested_labels, allow_unlabelled)
            .Val(binding) -> sema_stmt_refutable_binding_can_break(binding, nested_labels, allow_unlabelled)
            .Switch(_, arms, else_body, _) -> {
                found := false
                loop arm in arms {
                    if sema_stmt_refutable_loop_body_can_break_inner(arm.body, nested_labels, allow_unlabelled) -> found = true
                }
                if else_body == {
                    .Val(body) -> found || sema_stmt_refutable_loop_body_can_break_inner(body, nested_labels, allow_unlabelled)
                    .None -> found
                }
            }
            .Loop(body, _, _, label) | .While(_, body, _, _, label) | .For(_, _, _, _, body, _, _, label, _) | .CountedLoop(_, _, _, body, _, _, label) -> sema_stmt_refutable_loop_body_can_break_inner(body, sema_stmt_refutable_loop_labels(nested_labels, label), false)
            else -> false
        }
        if can_break -> return true
        if sema_stmt_refutable_statement_exits(statement) -> return false
    }
    false
}

fn sema_stmt_refutable_tir_block_has_never_expr(statements: [TStmt]) -> Bool Never! {
    loop statement in statements {
        if statement == {
            .ExprStmt(value, _) -> {
                if value.ty == (Type.Named{name: "Never"}) -> return true
            }
            else -> {}
        }
    }
    false
}

fn sema_stmt_refutable_contextual_pattern(pattern: Pattern, subject_ty: Type, environment: SemaScopeEnvironment) -> Pattern Never! {
    if pattern == {
        .Or(alternatives, span) -> {
            normalized := (loop item in alternatives -> sema_stmt_refutable_contextual_pattern(item, subject_ty, environment))
            return Pattern.Or{alternatives: normalized, span: span}
        }
        .Variant(variant, slots, _, span) -> {
            if variant == "value" && slots.len() == 1 {
                if sema_expr_unwrap_tag(subject_ty) == {
                    .Option(_) -> {
                        binding :: sema_pattern_normalize_contextual_binding(slots[0], span)
                        return Pattern.Present{binding: binding.name, binding_span: binding.span, inner: None, span: span}
                    }
                    else -> {}
                }
            }
        }
        else -> {}
    }
    sema_pattern_normalize_contextual(pattern, subject_ty, environment)
}

fn sema_stmt_refutable_capture_fact(facts: [TPatternBindingFact], name: BindName) -> TPatternBindingFact? {
    local_name := if name.rename == .Val(rename) -> rename.name else -> name.name
    loop fact in facts {
        if fact.name == local_name -> return Val(fact)
    }
    loop fact in facts {
        if fact.name == name.name -> return Val(fact)
    }
    None
}

fn sema_stmt_refutable_capture_payload(pattern: TPattern, subject_ty: Type) -> Type? {
    if pattern.shape == {
        .Ok(_, _, inner, _) -> {
            if inner != None -> return None
            if sema_expr_unwrap_tag(subject_ty) == {
                .Result(ok, _) -> return Val(ok)
                else -> return None
            }
        }
        .Present(_, _, inner, _) -> {
            if inner != None -> return None
            if sema_expr_unwrap_tag(subject_ty) == {
                .Option(payload) -> return Val(payload)
                else -> return None
            }
        }
        else -> return None
    }
    None
}


fn sema_stmt_refutable_assign_capture_identity(pattern: &TPattern, name: BindName, local: TLocal) Never! {
    local_name := if name.rename == .Val(rename) -> rename.name else -> name.name
    loop index in 0..<pattern.bindings.len() {
        fact :: pattern.bindings[index]
        if fact.name == local_name || fact.name == name.name {
            pattern.bindings[index].symbol_id = local.symbol_id
            return
        }
    }
}

// The miss route runs in its own frame on the live scope table, rolled back at
// the end (instead of on a copy of the whole table).
fn sema_stmt_check_refutable_fallback(fallback: OrFallback, subject_ty: Type, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaRefutableFallbackCheck {
    before := diagnostics.len()
    fallback_mark :: sema_scope_mark(&scopes)
    fallback_state := sema_ownership_state_snapshot(state)
    sema_scope_enter(&scopes, &fallback_state, "refutable.fallback@{span.start}")
    carrier := sema_expr_unwrap_tag(subject_ty)
    result := SemaRefutableFallbackCheck{tir: None, statements: [TStmt]{}, complete: false, ambient_err: None}
    if carrier == {
        .Result(_, error_ty) -> {
            owner := sema_scope_local_owner_key(scopes)
            symbol := Symbol{id: symbol_id(SymbolKind.Local, environment.module_identity, owner, "err"), kind: SymbolKind.Local, name: "err", module_name: environment.module_identity, owner: Val(owner), span: span, ty: Val(error_ty), visibility: 0}
            frame :: scopes.current
            sema_scope_push_binding(&scopes, SemaScopeBinding{frame: frame, symbol: symbol, mutable: false, access: AccessConvention.Read, integer_bounds: None, string_view: false, compiler_builtin: false})
            sema_ownership_declare_binding(&fallback_state, symbol, false)
            result.ambient_err = Val(tir_symbol_local("err", span, symbol.id))
        }
        else -> {}
    }

    enclosing_err_denial :: ~context.fallback_err_denial
    context.fallback_err_denial = sema_fallback_err_denial_for(carrier)
    if fallback == {
        .Value(value) -> {
            checked := sema_check_expression(value, None, environment, &scopes, &fallback_state, &tail_store, &context, &diagnostics)
            if checked != None {
                item :: checked ?? sema_tir_expr(Type.Named{name: "Unit"}, TExprKind.Unit, expr_span(value))
                result.tir = Val(TOrFallback.Value{value: item})
                &result.statements.push(TStmt.ExprStmt{value: item, span: expr_span(value)})
            }
            &diagnostics.push(sema_error("E0405", expr_span(value), "`??` must diverge after a refutable binding", "a failed pattern match cannot continue without defining the captures", "use `return`, `panic(...)`, `break`, or `next` as the fallback"))
        }
        .Block(body, value, block_span) -> {
            block_mark :: sema_scope_mark(&scopes)
            sema_scope_enter(&scopes, &fallback_state, "refutable.block@{block_span.start}")
            block_return_type :: ~scopes.return_type
            block_loop_depth :: scopes.loop_depth
            checked_block := sema_check_statements(body, block_return_type, environment, &scopes, &fallback_state, &tail_store, &context, &diagnostics, block_loop_depth)
            if value == .Val(tail) -> _ := sema_check_expression(tail, None, environment, &scopes, &fallback_state, &tail_store, &context, &diagnostics)
            sema_single_use_leave_scope(&scopes, &fallback_state, &diagnostics)
            sema_scope_rollback(&scopes, block_mark)
            diverges := value == None && (sema_stmt_refutable_block_exits(body) || sema_stmt_refutable_tir_block_has_never_expr(checked_block.value))
            valid := diverges && checked_block.complete
            if value != None || !diverges {
                &diagnostics.push(sema_error("E0405", block_span, "`??` fallback blocks cannot continue after a refutable binding", "a refutable binding needs one direct diverging miss route", "end the block with `return`, `panic(...)`, `break`, or `next`"))
            }
            if valid {
                block_expr := sema_tir_expr(Type.Named{name: "Never"}, TExprKind.InlineBlock{body: checked_block.value}, block_span)
                result.tir = Val(TOrFallback.Value{value: block_expr})
                result.statements = checked_block.value
                result.complete = true
            }
        }
        .Return(value, return_span) -> {
            return_tir := TOrFallback?{None}
            statement_value := TExpr?{None}
            if value == {
                .None -> {
                    if !sema_stmt_return_allows_empty(scopes.return_type) {
                        required := sema_stmt_return_success_type(scopes.return_type)
                        &diagnostics.push(sema_error("E0405", return_span, "`?? return` here needs a value", "this function returns {type_name(required)}, so its return route needs a value", "write `?? return <value>`"))
                    }
                }
                .Val(expression) -> {
                    if {
                        scopes.return_type == None -> {
                            _ := sema_check_expression(expression, None, environment, &scopes, &fallback_state, &tail_store, &context, &diagnostics)
                            &diagnostics.push(sema_error("E0405", expr_span(expression), "`?? return value` cannot return a value here", "this function returns nothing", "drop the value from the return route"))
                        }
                        else -> {
                            fallback_return_type :: ~scopes.return_type
                            checked :: sema_stmt_check_return_value(expression, fallback_return_type, environment, &scopes, &fallback_state, &tail_store, &context, &diagnostics)
                            if checked != None {
                                checked_value :: checked
                                if sema_stmt_record_return_views(expression, checked_value.ty, scopes, &fallback_state, &context, &diagnostics) && sema_stmt_move_direct(expression, &fallback_state, scopes, "`return`", &diagnostics) {
                                    return_tir = Val(TOrFallback.Return{value: Val(checked_value)})
                                    statement_value = Val(checked_value)
                                }
                            }
                        }
                    }
                }
            }
            if value == .None && sema_stmt_return_allows_empty(scopes.return_type) -> return_tir = Val(TOrFallback.Return{value: None})
            if return_tir != None {
                result.tir = return_tir
                &result.statements.push(TStmt.Return{value: statement_value, span: return_span})
                result.complete = true
            }
        }
        .Panic(name_span, args) -> {
            if {
                args.len() != 1 -> {
                    &diagnostics.push(sema_error("E0103", name_span, "`panic` needs exactly one message", "a panic report needs something to show the user", "write `?? panic(\"message\")`"))
                }
                else -> {
                    message := sema_check_expression(args[0].expr, Val(Type.String), environment, &scopes, &fallback_state, &tail_store, &context, &diagnostics)
                    if message != None {
                        checked :: message ?? sema_tir_expr(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: ""}}}, name_span)
                        location := sema_expression_panic_location(environment, name_span)
                        result.tir = Val(TOrFallback.Panic{message: checked, location: location})
                        panic_expr := sema_tir_expr(Type.Named{name: "Never"}, TExprKind.RequireStop{kind: TRequireKind.Panic{msg: checked}, location: location, always_stops: true}, name_span)
                        &result.statements.push(TStmt.ExprStmt{value: panic_expr, span: name_span})
                        result.complete = true
                    }
                }
            }
        }
        .Break(route_span) -> {
            if {
                scopes.loop_depth <= 0 -> {
                    &diagnostics.push(sema_error("E0405", route_span, "`?? break` is only valid inside a loop", "the fallback route must have an enclosing loop to leave", "move this binding into a loop"))
                }
                else -> {
                    result.tir = Val(TOrFallback.Break)
                    &result.statements.push(TStmt.Break{label: None, span: route_span})
                    result.complete = true
                }
            }
        }
        .Continue(route_span) -> {
            if {
                scopes.loop_depth <= 0 -> {
                    &diagnostics.push(sema_error("E0405", route_span, "`?? next` is only valid inside a loop", "the fallback route must have an enclosing loop to continue", "move this binding into a loop"))
                }
                else -> {
                    result.tir = Val(TOrFallback.Continue)
                    &result.statements.push(TStmt.Continue{label: None, span: route_span})
                    result.complete = true
                }
            }
        }
        .BreakLabel(label, route_span) -> {
            if {
                scopes.loop_depth <= 0 || !sema_scope_has_loop_label(scopes, label) -> {
                    &diagnostics.push(sema_error("E0405", route_span, "the `?? break` label is not an enclosing loop", "the fallback route must name an active loop label", "use an enclosing loop label"))
                }
                else -> {
                    result.tir = Val(TOrFallback.BreakLabel{label: label})
                    &result.statements.push(TStmt.Break{label: Val(label), span: route_span})
                    result.complete = true
                }
            }
        }
        .ContinueLabel(label, route_span) -> {
            if {
                scopes.loop_depth <= 0 || !sema_scope_has_loop_label(scopes, label) -> {
                    &diagnostics.push(sema_error("E0405", route_span, "the `?? next` label is not an enclosing loop", "the fallback route must name an active loop label", "use an enclosing loop label"))
                }
                else -> {
                    result.tir = Val(TOrFallback.ContinueLabel{label: label})
                    &result.statements.push(TStmt.Continue{label: Val(label), span: route_span})
                    result.complete = true
                }
            }
        }
    }
    context.fallback_err_denial = enclosing_err_denial
    sema_single_use_leave_scope(&scopes, &fallback_state, &diagnostics)
    sema_scope_rollback(&scopes, fallback_mark)
    result.complete = result.complete && diagnostics.len() == before
    result
}

fn sema_stmt_check_refutable_binding(binding: Binding, pattern: Pattern, fallback: OrFallback, names: [BindName], span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    before := diagnostics.len()
    // D-FAILURE-FOUNDATION1=A: an `.Ok`/`.Err` pattern consumes the carrier.
    subject_value :: if sema_pattern_consumes_result_carrier(pattern) -> sema_check_expression_carrier(binding.init, binding.ty, environment, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(binding.init, binding.ty, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    subject :: subject_value ?? {
        sema_stmt_destructure_recover(BindPattern.Refutable{pattern: pattern, fallback: fallback, names: names, span: span}, binding.mutable, environment, &scopes, &state, &diagnostics)
        return None
    }
    checked_pattern := sema_check_pattern(subject, sema_stmt_refutable_contextual_pattern(pattern, subject.ty, environment), TPatternPosition.Binding, binding.mutable, false, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    move_subject := false
    loop fact in checked_pattern.bindings {
        if !sema_ownership_type_is_copy(fact.ty) -> move_subject = true
    }
    move_valid := true
    if move_subject && !sema_stmt_move_direct(binding.init, &state, scopes, "the pattern binding", &diagnostics) -> move_valid = false
    checked_fallback := sema_stmt_check_refutable_fallback(fallback, subject.ty, span, environment, &scopes, state, &tail_store, &context, &diagnostics)
    locals := [TLocal]{}
    checked_pattern_tir := checked_pattern.checked
    loop name in names {
        fact := sema_stmt_refutable_capture_fact(checked_pattern.bindings, name)
        ty := if fact == {.Val(value) -> value.ty else -> Type.Int}
        local := sema_stmt_destructure_local(name, ty, binding.mutable, environment, &scopes, &state, &diagnostics)
        if local == None -> next
        installed :: local ?? next
        &locals.push(installed)
        if checked_pattern_tir != None {
            typed := checked_pattern_tir ?? next
            sema_stmt_refutable_assign_capture_identity(&typed.pattern, name, installed)
            checked_pattern_tir = Val(typed)
        }
    }
    if diagnostics.len() != before || !checked_pattern.complete || !move_valid || !checked_fallback.complete || locals.len() != names.len() -> return None
    typed :: checked_pattern_tir ?? return None
    fallback_tir :: checked_fallback.tir ?? return None
    payload := sema_stmt_refutable_capture_payload(typed.pattern, typed.subject.ty)
    if payload != None && names.len() == 1 {
        local := locals[0]
        initializer := sema_tir_expr(payload ?? Type.Named{name: "Unit"}, TExprKind.OrFallback{value: typed.subject, fallback: fallback_tir, ambient_err: checked_fallback.ambient_err}, span)
        return Val(TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: initializer, gc_promotion: None, gc_transferred: false, span: Span{start: local.span.start, end: expr_span(binding.init).end}})
    }
    Val(TStmt.RefutableBind{pattern: typed.pattern, init: typed.subject, fallback: checked_fallback.statements, span: span})
}

// D-FLOWTYPE1=A: the stable Optional (an immutable local or parameter of type
// `T?`) that a statement guard `if x == None -> …` with one arm, no `else`,
// and a directly exiting body tests.
fn sema_stmt_optional_exit_guard_name(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span, scopes: SemaScopeTable) -> BindName? {
    if else_body != None || arms.len() != 1 || !sema_stmt_refutable_is_subjectless_guard(subject, span) -> return None
    if !sema_stmt_refutable_block_exits(arms[0].body) -> return None
    test :: sema_expression_absent_optional_test(arms[0].cond) ?? return None
    if sema_expression_flow_optional_payload(scopes, test.name.name) == None -> return None
    Val(test.name)
}

// D-FLOWTYPE1=A: the stable Optionals the `x == None` arms of a guard table
// test, in arm order without repeats. The table's `else` holds each payload
// (Rust `complement_condition_bindings`).
fn sema_stmt_else_presence_names(arms: [SwitchArm], scopes: SemaScopeTable) -> [BindName] {
    names := [BindName]{}
    loop arm in arms {
        test :: sema_expression_absent_optional_test(arm.cond) ?? next
        if sema_expression_flow_optional_payload(scopes, test.name.name) == None -> next
        repeated := false
        loop name in names {
            if name.name == test.name.name -> repeated = true
        }
        if !repeated -> &names.push(test.name)
    }
    names
}

// D-FLOWTYPE1=A: refines the stable Optional `name` to its payload for the
// rest of the current scope. Check `x ?? fallback` and bind the payload under
// the same name, the operation the Rust frontend reaches through the
// refutable binding `x == .Val(x) ?? { fallback }`.
fn sema_stmt_check_optional_refinement(name: BindName, fallback: OrFallback, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    guarded :: Expr.OrFallback{value: Expr.Ident{name: name.name, span: name.span}, fallback: fallback, is_option: true, span: span}
    value :: sema_check_expression(guarded, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    // The refinement is a new local; its identity names the guard so it never
    // collides with the carrier binding it shadows.
    owner :: "{sema_scope_local_owner_key(scopes)}/flow@{span.start}"
    id :: symbol_id(SymbolKind.Local, environment.module_identity, owner, name.name)
    symbol :: Symbol{id: id, kind: SymbolKind.Local, name: name.name, module_name: environment.module_identity, owner: Val(owner), span: name.span, ty: Val(value.ty), visibility: 0}
    sema_scope_refine_local(&scopes, symbol)
    sema_ownership_declare_binding(&state, symbol, false)
    Val(TStmt.Let{local: tir_symbol_local(name.name, name.span, id), let_ty: TLetTy.Inferred, init: value, gc_promotion: None, gc_transferred: false, span: span})
}

// D-FLOWTYPE1=A: the `else` of a guard table holds the payload of every
// stable `x == None` arm subject. Each refinement leads the block as
// `x :: x ?? <no else arm>`, as the Rust frontend prepends the dead-end
// binding `x == .Val(x) ?? { }` (`prepend_else_presence_refinements`).
fn sema_stmt_check_else_complement(names: [BindName], body: [Stmt], span: Span, return_type: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> SemaStatementResult {
    sema_scope_enter(&scopes, &state, "if.else@{span.start}")
    statements := [TStmt]{}
    complete := true
    loop name in names {
        refined :: sema_stmt_check_optional_refinement(name, OrFallback.Value{value: Expr.NoElse{span: name.span}}, name.span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        if refined == {
            .Val(statement) -> &statements.push(statement)
            .None -> complete = false
        }
    }
    checked :: sema_check_statements(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
    sema_single_use_leave_scope(&scopes, &state, &diagnostics)
    loop statement in checked.value -> &statements.push(statement)
    SemaStatementResult{value: statements, complete: complete && checked.complete}
}

fn sema_stmt_check_destructure(binding: Binding, pattern: BindPattern, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    if pattern == {
        .Refutable(inner, fallback, names, span) -> return sema_stmt_check_refutable_binding(binding, inner, fallback, names, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        else -> {}
    }
    before := diagnostics.len()
    init :: sema_check_expression(binding.init, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? {
        sema_stmt_destructure_recover(pattern, binding.mutable, environment, &scopes, &state, &diagnostics)
        return None
    }
    ty := sema_expr_expected_type(init.ty, environment)
    names := sema_stmt_destructure_names(pattern)
    fields := [TypeTupleField]{}
    span := binding.name_span
    if pattern == {
        .Struct(written_type, type_span, selected, rest, pattern_span) -> {
            span = pattern_span
            graph_option :: environment.registration_graph
            graph :: graph_option ?? return None
            actual := sema_pattern_nominal(graph, environment.module_identity, ty)
            if actual == None || (actual ?? panic("missing destructure nominal")).kind != SemaRegistrationNominalKind.Struct {
                &diagnostics.push(sema_error("E0313", type_span, "`{written_type} {{ … }}` can only destructure a `{written_type}` value, but this is {type_name(ty)}", "destructuring with `{{ }}` pulls fields out of a struct value", "destructure a `{written_type}`, or bind the whole value with a name"))
                sema_stmt_destructure_recover(pattern, binding.mutable, environment, &scopes, &state, &diagnostics)
                return None
            }
            nominal :: actual ?? return None
            named := sema_pattern_nominal(graph, environment.module_identity, Type.Named{name: written_type})
            if named == None || (named ?? nominal).symbol.id.key != nominal.symbol.id.key {
                &diagnostics.push(sema_error("E0313", type_span, "this value is a `{nominal.symbol.name}`, not a `{written_type}`", "the type named before `{{ }}` must match the value you destructure", "write `{nominal.symbol.name} {{ … }}` to match the value"))
                sema_stmt_destructure_recover(pattern, binding.mutable, environment, &scopes, &state, &diagnostics)
                return None
            }
            generic_names := (loop parameter in nominal.generic_params -> parameter.name)
            arguments := sema_pattern_subject_args(ty)
            owner_package := ""
            loop graph_module in graph.modules {
                if graph_module.module_identity == nominal.symbol.module_name -> owner_package = graph_module.package_identity
            }
            loop selected_field in selected {
                field_type := Type?{None}
                loop field in nominal.fields {
                    if field.symbol.name == selected_field.name {
                        if {
                            sema_registration_visible(field.symbol.visibility, environment.module_identity, environment.package_identity, nominal.symbol.module_name, owner_package) -> {
                                field_type = Val(sema_inference_substitute_type(field.ty, generic_names, arguments))
                                &context.name_references.push(SemaNameReferenceFact{span: selected_field.span, symbol: field.symbol, kind: "field"})
                            }
                            else -> {
                                &diagnostics.push(sema_error("E0605", selected_field.span, "`{selected_field.name}` exists but is private to its file", "only names marked `pub` can be used from another file (S18)", "add `pub` before `{selected_field.name}`, or don't reach across files here"))
                                field_type = Val(Type.Int)
                            }
                        }
                    }
                }
                if field_type == None {
                    &diagnostics.push(sema_error("E0302", selected_field.span, "`{type_name(ty)}` has no field `{selected_field.name}`", "a destructuring pattern can only name declared fields", "use one of the declared field names"))
                }
                &fields.push(TypeTupleField{name: selected_field.name, ty: field_type ?? Type.Int})
            }
            partial := selected.len() < nominal.fields.len()
            if {
                partial && rest == None -> {
                    &diagnostics.push(sema_error("E0326", pattern_span, "this pattern leaves out fields of `{written_type}`", "a destructure that doesn't name every field must end with `..` so the skipped fields are visible at a glance", "add `, ..` before the closing `}}`, or name the remaining fields"))
                }
                !partial && rest != None -> {
                    &diagnostics.push(sema_error("E0327", rest, "`..` is redundant — this pattern already names every field of `{written_type}`", "a trailing `..` only makes sense when some fields are left unnamed", "remove the `..`"))
                }
            }
        }
        .List(elements, pattern_span) -> {
            span = pattern_span
            element_type := if ty == {
                .List(element) -> element
                .FixedList(element, length) -> {
                    fixed :: measure_literal_value(length) ?? return None
                    if elements.len() != fixed {
                        names_suffix := if elements.len() == 1 -> "" else -> "s"
                        fixed_suffix := if fixed == 1 -> "" else -> "s"
                        &diagnostics.push(sema_error("E0963", pattern_span, "destructuring with {elements.len()} name{names_suffix}, but this fixed-size list has {fixed} element{fixed_suffix}", "a fixed-size list `[T#N]` has a known length — the pattern must match exactly", "use {fixed} name{fixed_suffix} in the pattern"))
                    }
                    element
                }
                else -> {
                    &diagnostics.push(sema_error("E0313", pattern_span, "`[ … ]` can only destructure a list, but this is {type_name(ty)}", "destructuring with `[ ]` pulls elements out of a list value", "destructure a list, or bind the whole value with a name"))
                    sema_stmt_destructure_recover(pattern, binding.mutable, environment, &scopes, &state, &diagnostics)
                    return None
                }
            }
            if binding.init == .ListLit(items, _) && items.len() != elements.len() {
                sema_stmt_destructure_count(elements.len(), items.len(), false, true, pattern_span, &diagnostics)
            }
            loop (index, _) in elements -> &fields.push(TypeTupleField{name: "{index}", ty: element_type})
        }
        .Tuple(elements, pattern_span) -> {
            span = pattern_span
            if ty == {
                .Tuple(canonical) -> fields = canonical
                .Apply(name, args) -> {
                    if name == "VJPRun" && args.len() == 1 && elements.len() == 2 {
                    pull := Type.Fn{params: [Type]{Type.Named{name: "Tensor"}}, ret: Val(args[0]), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
                    fields = [TypeTupleField]{TypeTupleField{name: "value", ty: Type.Named{name: "Tensor"}}, TypeTupleField{name: "pull", ty: pull}}
                }
                }
                else -> {}
            }
            if fields.len() == 0 && ty != (Type.Tuple{fields: [TypeTupleField]{}}) {
                &diagnostics.push(sema_error("E0313", pattern_span, "`( … )` can only destructure a tuple, but this is {type_name(ty)}", "destructuring with `( )` pulls named members out of a tuple value", "destructure a tuple, or bind the whole value with a name"))
                sema_stmt_destructure_recover(pattern, binding.mutable, environment, &scopes, &state, &diagnostics)
                return None
            }
            if {
                elements.len() != fields.len() -> {
                    sema_stmt_destructure_count(elements.len(), fields.len(), true, false, pattern_span, &diagnostics)
                }
                binding.init == .TupleLit(items, _, _) && items.len() != elements.len() -> {
                    sema_stmt_destructure_count(elements.len(), items.len(), true, true, pattern_span, &diagnostics)
                }
            }
        }
        .Refutable(_, _, _, _) -> return None
    }
    locals := [TLocal]{}
    binds := [TDestructureBinding]{}
    move_fields := false
    loop (index, name) in names {
        if index >= fields.len() -> break
        field := fields[index]
        local :: sema_stmt_destructure_local(name, field.ty, binding.mutable, environment, &scopes, &state, &diagnostics) ?? next
        &locals.push(local)
        &binds.push(TDestructureBinding{local: local, field: field.name})
        projected_binding := binding
        projected_binding.name = local.name
        projected_binding.name_span = local.span
        projected_binding.pattern = None
        projected_binding.ty = Val(field.ty)
        projected_binding.init = if pattern == {
            .List(_, _) -> Expr.Index{base: binding.init, index: Expr.Int{value: index, span: span, width: None, raw: None}, span: span, kind: IndexKind.List}
            else -> Expr.Field{base: binding.init, member: field.name, span: span}
        }
        if !sema_stmt_record_binding_views(projected_binding, field.ty, scopes, &state, &context, &diagnostics) -> return None
        if sema_stmt_destructure_moves_field(field.ty, pattern, environment) -> move_fields = true
    }
    if binding.init == .Ident(name, _) {
        source :: sema_scope_resolve(scopes, name) ?? return None
        if source.kind != SymbolKind.Parameter && !sema_stmt_move_direct(binding.init, &state, scopes, "the destructuring binding", &diagnostics) -> return None
    }
    if diagnostics.len() != before || locals.len() != names.len() -> return None
    temp := tir_generated_local("__jet_destructure_{span.start}", span)
    temp.mutable = true
    if pattern == {
        .Struct(_, _, _, _, _) -> Val(TStmt.StructDestructure{temp: temp, init: init, move_fields: move_fields, binds: binds, span: span})
        .Tuple(_, _) -> Val(TStmt.TupleDestructure{temp: temp, init: init, move_fields: move_fields, binds: binds, span: span})
        .List(_, _) -> Val(TStmt.ListDestructure{temp: temp, init: init, count: names.len(), file: environment.source_file, line: sema_source_line_at(environment.source_segments, span) ?? 0, elements: locals, span: span})
        .Refutable(_, _, _, _) -> None
    }
}

fn sema_stmt_install_binding_loop_label(expr: Expr, name: String, name_span: Span) -> Expr Never! {
    if expr == {
        .CallValue(callee, args, span) -> {
            if args.len() == 0 {
                if callee == {
                    .Lambda(lambda) -> {
                        updated_lambda := lambda
                        if updated_lambda.meta.result_loop || updated_lambda.meta.collecting_loop {
                            updated_lambda.meta.loop_label = Val(NamedSpan{name: name, span: name_span})
                            return Expr.CallValue{callee: Expr.Lambda{lambda: updated_lambda}, args: args, span: span}
                        }
                    }
                    else -> {}
                }
            }
        }
        else -> {}
    }
    ~expr
}


// A binding whose initializer produced no checked value stays in scope with
// only its written type. Without one, reads of the name check to nothing and
// add no report, so the initializer's own error is the only one: bindings
// derived from it inherit the poison instead of cascading into unknown-name
// or type-mismatch reports.
fn sema_stmt_declare_unchecked_binding(binding: Binding, environment: SemaScopeEnvironment, scopes: &SemaScopeTable) Never! {
    owner := sema_scope_local_owner_key(scopes)
    id :: symbol_id(SymbolKind.Local, environment.module_identity, owner, binding.name)
    symbol := Symbol{id: id, kind: SymbolKind.Local, name: binding.name, module_name: environment.module_identity, owner: Val(owner), span: binding.name_span, ty: binding.ty, visibility: 0}
    _ := sema_scope_declare_local(&scopes, symbol, binding.mutable, AccessConvention.Read, None, binding.string_view)
}

fn sema_stmt_check_binding(binding: Binding, lambda_escapes: Bool?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    if binding.uninit -> return sema_stmt_check_uninit_binding(binding, environment, &scopes, &state, &diagnostics)
    if binding.arena_view -> return None
    if binding.is_comptime -> return sema_stmt_check_prepared_binding(binding, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if binding.pattern == .Val(pattern) -> return sema_stmt_check_destructure(binding, pattern, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    // E0804: a lambda stored in a binding can't call itself through that name.
    if binding.init == .Lambda(lambda) && sema_ownership_last_use_expr(binding.init, binding.name) {
        &diagnostics.push(sema_error("E0804", lambda.span, "a lambda can't call itself as `{binding.name}`", "short functions stored in a binding can't recurse in v1", "write a named `fn` instead of assigning the lambda to `{binding.name}`"))
    }
    sema_copy_site_check_borrowed_binding(binding, environment, scopes, context, &diagnostics)
    binding_expr := sema_stmt_install_binding_loop_label(binding.init, binding.name, binding.name_span)
    // D-SHAPE-PLACE1=A (Rust `check_binding`): an immutable binding of a
    // bare range place is a read window into its source, typed `View<T>`.
    if !binding.mutable && sema_stmt_is_bare_range_place(binding.init, scopes, &state) -> binding_expr = Expr.Place{value: binding_expr, access: PlaceAccess.Read, span: expr_span(binding.init)}
    range_head :: sema_stmt_range_conversion_head(binding.init, environment, &scopes)
    previous_binding_initializer :: context.binding_initializer
    context.binding_initializer = true
    checked_init := if range_head == .Val(head) -> sema_stmt_check_range_conversion(binding.init, head, binding.ty, environment, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression_with_lambda_escapes(binding_expr, binding.ty, environment, &scopes, &state, &tail_store, &context, lambda_escapes, &diagnostics)
    context.binding_initializer = previous_binding_initializer
    init :: checked_init ?? {
        sema_stmt_declare_unchecked_binding(binding, environment, &scopes)
        return None
    }
    sema_copy_site_check_conditional(binding.init, binding.ty, environment, scopes, context, &diagnostics)
    // D-MEM1 stage S5 (Rust `string_view_call_source`): `x :: s.trim()`,
    // `s.after(sep)` or `s.before(sep)` on a local or parameter `String`
    // binds a scope-bound zero-copy view into `s`; a `:=` binding keeps the
    // owned result, since it may later be reassigned an owned `String`.
    view_sources := if binding.mutable -> [SemaOwnershipPlace]{} else -> sema_string_view_call_sources(binding.init, scopes, &state)
    view_init := if view_sources.len() > 0 -> sema_string_view_lower_init(init) else -> None
    string_view := view_init != None
    if !string_view && !sema_stmt_move_direct(binding_expr, &state, scopes, "the binding `{binding.name}`", &diagnostics) -> return None
    kind :: SymbolKind.Local
    owner := sema_scope_local_owner_key(scopes)
    id :: symbol_id(kind, environment.module_identity, owner, binding.name)
    symbol := Symbol{id: id, kind: kind, name: binding.name, module_name: environment.module_identity, owner: Val(owner), span: binding.name_span, ty: Val(init.ty), visibility: 0}
    if !sema_scope_declare_local(&scopes, symbol, binding.mutable, AccessConvention.Read, init.integer_bounds, string_view) {
        &diagnostics.push(sema_already_defined(binding.name, binding.name_span))
        return None
    }
    sema_ownership_declare_binding(&state, symbol, false)
    sema_single_use_note_binding(&state, symbol, environment)
    if binding.name == "_" -> sema_single_use_check_discard(init.ty, binding.name_span, environment, &diagnostics)
    sema_stmt_track_origin(binding, environment, &scopes)
    _ := sema_hardware_bind_pending_dma_transfer(binding_expr, symbol, &scopes)
    if !sema_stmt_record_binding_views(binding, init.ty, scopes, &state, &context, &diagnostics) -> return None
    if string_view && !sema_string_view_record_binding(&state, binding.name, binding.name_span, view_sources, scopes) -> return None
    sema_function_reactive_record_binding(&context, binding, symbol, init.ty)
    local := tir_symbol_local(binding.name, binding.name_span, symbol.id)
    local.mutable = binding.mutable
    local.integer_bounds = init.integer_bounds
    let_ty := TLetTy.Inferred
    if binding.ty != None -> let_ty = TLetTy.Annotated{ty: binding.ty ?? init.ty, wrapper: TLetWrapper.Plain}
    if binding.gc_promotion != None || binding.gc_transferred -> let_ty = TLetTy.Annotated{ty: binding.ty ?? init.ty, wrapper: TLetWrapper.AutomaticRoot}
    // The view is a borrowed `&str` place; its source type stays `String`.
    if string_view -> let_ty = TLetTy.StrView
    gc_promotion := if binding.gc_promotion == .Val(promotion) -> Val(sema_function_memory_tir_promotion(promotion)) else -> None
    Val(TStmt.Let{local: local, let_ty: let_ty, init: view_init ?? init, gc_promotion: gc_promotion, gc_transferred: binding.gc_transferred, span: Span{start: binding.name_span.start, end: expr_span(binding.init).end}})
}

// D-RANGETYPE1 (E0136): the type head of a binding whose value is a range
// type's numeric conversion (`Severity.from_int(raw)`). Its Result stays
// visible to the binding, which reports a runtime value; an inline range
// conversion reports in its own call check.
fn sema_stmt_range_conversion_head(init: Expr, environment: SemaScopeEnvironment, scopes: &SemaScopeTable) -> String? {
    if init == .MethodCall(receiver, method, _, _, _, args, _, _, _, _) {
        if args.len() != 1 -> return None
        if receiver == .Ident(name, _) {
            facts :: sema_expr_distinct_facts(Type.Named{name: name}, environment, &scopes) ?? return None
            if facts.range != None && sema_call_distinct_numeric_row(facts.base, method) != None -> return Val(name)
        }
    }
    None
}

fn sema_stmt_check_range_conversion(init: Expr, head: String, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    value :: sema_check_expression_carrier(init, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if sema_expr_unwrap_tag(value.ty) == .Result(success, _) {
        if init == .MethodCall(_, method, _, _, _, args, _, _, _, _) -> &diagnostics.push(sema_range_runtime_conversion(head, method, expr_span(args[0].expr)))
        return Val(TExpr{ty: success, kind: value.kind, span: value.span, integer_bounds: None, cost: None})
    }
    sema_expr_expected(value, expected, environment, &diagnostics)
}

// D-UNINIT-SENTINEL2 (Rust `check_uninit_binding`): `name := Type{ uninit }`
// needs `use core.mem` (E0424) and a plain-data type (E0423). The binding is
// declared without a value and recorded as not yet written, so a read before
// every path writes it is E0420; it lowers to the uninitialized-local let.
fn sema_stmt_check_uninit_binding(binding: Binding, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> TStmt? {
    valid := true
    if !sema_stmt_module_uses_core_mem(environment) {
        &diagnostics.push(sema_error("E0424", binding.name_span, "`uninit` needs the low-level memory tier", "`uninit` skips the automatic zero-fill — an expert-tier operation", "add `use core.mem` at the top of this file to opt in"))
        valid = false
    }
    written :: binding.ty ?? return None
    ty_span :: binding.ty_span ?? return None
    ty :: sema_expr_expected_type(written, environment)
    if !sema_stmt_uninit_plain_data(ty) {
        &diagnostics.push(sema_error("E0423", ty_span, "`uninit` needs a plain-data type", "`{sema_type_show(ty)}` may own heap memory or need cleanup, so leaving it uninitialized is unsafe", "use plain data — a number, `Bool`, `Char`, `U8`, or a fixed array of those (e.g. `[4096]U8`)"))
        valid = false
    }
    owner := sema_scope_local_owner_key(scopes)
    id :: symbol_id(SymbolKind.Local, environment.module_identity, owner, binding.name)
    symbol := Symbol{id: id, kind: SymbolKind.Local, name: binding.name, module_name: environment.module_identity, owner: Val(owner), span: binding.name_span, ty: Val(ty), visibility: 0}
    if !sema_scope_declare_local(&scopes, symbol, true, AccessConvention.Read, None, false) {
        &diagnostics.push(sema_already_defined(binding.name, binding.name_span))
        return None
    }
    sema_ownership_declare_binding(&state, symbol, false)
    fixed_len := Int?{None}
    fixed := false
    if ty == .FixedList(_, length) {
        fixed = true
        fixed_len = measure_literal_value(length)
    }
    sema_ownership_uninit_set(&state, SemaOwnershipUninitFact{key: id.key, name: binding.name, fixed_len: fixed_len, initialized: [Int]{}})
    if !valid -> return None
    local := tir_symbol_local(binding.name, binding.name_span, id)
    local.mutable = true
    local.uninit_scalar = !fixed
    local.uninit_fixed = fixed
    init :: sema_tir_expr(ty, TExprKind.Uninit, ty_span)
    Val(TStmt.Let{local: local, let_ty: TLetTy.Annotated{ty: ty, wrapper: TLetWrapper.Plain}, init: init, gc_promotion: None, gc_transferred: false, span: Span{start: binding.name_span.start, end: ty_span.end}})
}

// Rust `is_pod_uninit_type`: scalars, `Char`, `U8`, and fixed arrays of those.
fn sema_stmt_uninit_plain_data(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Float32 | .Bool | .Char -> true
        .IntN(_, _) | .InlineRange(_, _, _) -> true
        .FixedList(element, _) -> sema_stmt_uninit_plain_data(element)
        else -> false
    }
}

fn sema_stmt_module_uses_core_mem(environment: SemaScopeEnvironment) -> Bool {
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return false
    module_index :: sema_registration_module_index(graph, environment.module_identity) ?? return false
    sema_function_header_inline_has_core_mem(graph.modules[module_index])
}

// D-UNINIT1: record one written slot of a fixed `Type{ uninit }` list. Only a
// literal in-range index proves a slot; the fact ends once every slot is
// written.
fn sema_stmt_uninit_note_slot_write(state: &SemaOwnershipState, fact: SemaOwnershipUninitFact, index: Expr) Never! {
    initialized := [Int]{}
    loop written in fact.initialized -> &initialized.push(written)
    if fact.fixed_len == .Val(length) && index == .Int(slot, _, _, _) {
        if slot >= 0 && slot < length && !initialized.contains(slot) -> &initialized.push(slot)
        if initialized.len() == length -> return
    }
    sema_ownership_uninit_set(&state, SemaOwnershipUninitFact{key: fact.key, name: fact.name, fixed_len: fact.fixed_len, initialized: initialized})
}

// D-UNINIT1 (Rust `clear_uninit_mut_args`): a `&name` argument does not prove
// the callee writes every value, so the binding stays unwritten (E0420).
fn sema_stmt_uninit_write_args(args: [CallArg], state: SemaOwnershipState, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) Never! {
    if state.uninit.len() == 0 -> return
    loop arg in args {
        if arg.convention == AccessConvention.Write && arg.expr == .Ident(name, span) && sema_scope_resolve_index(scopes, name) == .Val(index) {
            if sema_ownership_uninit_contains(state.uninit, scopes.bindings[index].symbol.id.key) {
                &diagnostics.push(sema_error("E0420", span, "`{name}` may be read before it is given a value", "passing `{name}` with write access does not prove that the callee initializes it", "write every value in `{name}` here before passing it to another function"))
            }
        }
    }
}

// D-UNINIT1: `Fixed.over(&bytes)` is the one raw-storage adapter: it borrows
// the storage without claiming it was initialized. The facts it takes are
// set again after the call is checked.
fn sema_stmt_uninit_fixed_over_take(receiver: Expr, method: String, args: [CallArg], state: &SemaOwnershipState, scopes: SemaScopeTable) -> [SemaOwnershipUninitFact] Never! {
    taken := [SemaOwnershipUninitFact]{}
    if method != "over" || state.uninit.len() == 0 -> return taken
    if receiver == .Field(_, member, _) && member == "Fixed" {
        loop arg in args {
            if arg.expr == .Ident(name, _) && sema_scope_resolve_index(scopes, name) == .Val(index) {
                if sema_ownership_uninit_take(&state, scopes.bindings[index].symbol.id.key) == .Val(fact) -> &taken.push(fact)
            }
        }
    }
    taken
}

// D-TRACK-ORIGIN1=A: a `#Track` binding records its checked source identity
// and declaration site (Rust `check_binding`); the marker stays on the AST.
fn sema_stmt_track_origin(binding: Binding, environment: SemaScopeEnvironment, scopes: &SemaScopeTable) Never! {
    tracked :: loop marker in binding.markers {
        if marker.name == "Track" && !marker.negated -> break true
    } ?? false
    if !tracked || binding.name.len() == 0 || binding.name == "_" -> return
    index :: sema_scope_resolve_index(scopes, binding.name) ?? return
    sema_scope_note_binding_edit(&scopes, index)
    scopes.bindings[index].origin = Val(SemaOriginFact{
        source: binding.name,
        line: sema_source_line_at(environment.source_segments, binding.name_span),
        column: sema_source_column_at(environment.source_segments, binding.name_span),
    })
}

// D-PREP-SURFACE2=A: `name :: prep { value }` in a body is compile-time code
// (Rust `check_binding` under `in_comptime`). A value already known here, such
// as a fact read on a local, binds at once; any other value is staged through
// the body comptime evaluator and binds when the owner body is checked again.
// The name then reads as that value and the binding emits no runtime code.
fn sema_stmt_check_prepared_binding(binding: Binding, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    scopes.comptime_execution_depth += 1
    checked :: sema_check_expression(binding.init, binding.ty, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    scopes.comptime_execution_depth -= 1
    init :: checked ?? {
        sema_stmt_declare_unchecked_binding(binding, environment, &scopes)
        return None
    }
    value := sema_expr_comptime_value(init)
    if value == None -> value = sema_fact_constant_path_value(init)
    ty := init.ty
    init_span :: expr_span(binding.init)
    if value == None {
        staged :: sema_comptime_body_value_find(context.comptime_body_values, environment.module_identity, sema_scope_function_owner_key(scopes), init_span, binding.name_span)
        if staged == .Val(body_value) {
            value = Val(body_value.value)
            ty = body_value.ty
        } else {
            _ := sema_comptime_body_capture(&context, environment, scopes, binding.name, binding.init, init.ty, init_span, binding.name_span)
            sema_stmt_declare_unchecked_binding(binding, environment, &scopes)
            return None
        }
    }
    known :: value ?? return None
    owner := sema_scope_local_owner_key(scopes)
    id :: symbol_id(SymbolKind.Local, environment.module_identity, owner, binding.name)
    symbol := Symbol{id: id, kind: SymbolKind.Local, name: binding.name, module_name: environment.module_identity, owner: Val(owner), span: binding.name_span, ty: Val(ty), visibility: 0}
    if !sema_scope_declare_local(&scopes, symbol, false, AccessConvention.Read, None, false) {
        &diagnostics.push(sema_already_defined(binding.name, binding.name_span))
        return None
    }
    if binding.name != "_" {
        last :: scopes.bindings.len() - 1
        sema_scope_note_binding_edit(&scopes, last)
        scopes.bindings[last].prepared = Val(known)
    }
    sema_ownership_declare_binding(&state, symbol, false)
    sema_stmt_track_origin(binding, environment, &scopes)
    Val(TStmt.Inline{body: [TStmt]{}, span: Span{start: binding.name_span.start, end: init_span.end}})
}

fn sema_stmt_check_local_assignment(name: String, name_span: Span, op: BinOp?, op_span: Span, expr: Expr, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    index :: sema_scope_resolve_index(scopes, name)
    if index == None {
        &diagnostics.push(sema_unknown_name(name, name_span))
        return None
    }
    binding :: ~scopes.bindings[index]
    if !binding.mutable {
        &diagnostics.push(sema_error("E0111", name_span, "`{name}` was made immutable, so it can't change", "only mutable bindings and write-access parameters can be changed", "declare it as a mutable binding"))
        return None
    }
    if binding.symbol.ty == None {
        // An unchecked target already carries its initializer's report.
        _ := sema_check_expression(expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return None
    }
    if op != None {
        if !sema_ownership_note_reference(&state, name, name_span, scopes, SemaOwnershipReferenceKind.Read) -> return None
        if !sema_ownership_check_use(&state, Expr.Ident{name: name, span: name_span}, scopes, &diagnostics) -> return None
    }
    if !sema_hardware_note_cpu_use(Expr.Ident{name: name, span: name_span}, scopes, &state, &context, &diagnostics) -> return None
    required :: binding.symbol.ty ?? Type.Named{name: "Unit"}
    expected := Type?{None}
    if op == None -> expected = Val(required)
    // Rust CheckerCore/statements.rs `Stmt::Assign` feeds the place type into
    // the RHS for compound updates too, so `price *= 2.0` with `price: Float`
    // reads the literal as Float rather than exact Decimal.
    if op != None && sema_expr_decimal_literal_operand(expr, true) && sema_expr_expects_machine_float(Val(required)) -> expected = Val(required)
    checked_value :: sema_check_expression(expr, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    checked := checked_value
    // A compound operand widens into the place's numeric type first
    // (`total += byte`), as Rust `widen_numeric_expr` does after inference.
    if op != None && sema_stmt_compound_widens(checked.ty, required) {
        widen_line :: sema_source_line_at(environment.source_segments, checked.span) ?? 0
        checked = sema_expr_numeric_literal_conversion(checked, required, checked.span, widen_line, &diagnostics) ?? return None
    }
    if op == None && sema_copy_site_check_assignment(expr, environment, scopes, context, &diagnostics) -> return None
    // D-UNINIT-SENTINEL2: a plain `name = …` gives a `Type{ uninit }`
    // binding its value; a compound update reads it first (E0420).
    if sema_ownership_uninit_take(&state, binding.symbol.id.key) != None && op != None {
        &diagnostics.push(sema_error("E0420", name_span, "`{name}` may be read before it is given a value", "`{name}+=` reads `{name}` first, but it was declared with `Type{{ uninit }}` and has no value yet", "give `{name}` a value with `{name} = …` before updating it"))
    }
    tir_op := TBinaryOp?{None}
    if op != None {
        operator :: op
        result :: sema_expr_binary_type(operator, required, checked.ty, op_span, &diagnostics) ?? return None
        if !sema_type_assignable(required, result) {
            &diagnostics.push(sema_type_mismatch(required, result, op_span))
            return None
        }
        tir_op = Val(sema_stmt_binary_type(operator))
    }
    if !sema_ownership_check_lvalue_write(&state, LValue.Local{name: name, name_span: name_span}, scopes, &diagnostics) -> return None
    if !sema_stmt_move_direct(expr, &state, scopes, "the assignment to `{name}`", &diagnostics) -> return None
    line :: sema_source_line_at(environment.source_segments, name_span) ?? return None
    local := tir_symbol_local(name, binding.symbol.span, binding.symbol.id)
    local.mutable = true
    updated_bounds := TIntegerBounds?{None}
    if op == None -> updated_bounds = checked.integer_bounds
    sema_scope_note_binding_edit(&scopes, index)
    scopes.bindings[index].integer_bounds = updated_bounds
    // A new value has no `#Track` origin (Rust `clear_origin`).
    scopes.bindings[index].origin = None
    Val(TStmt.Assign{place: TPlace.Local{local: local}, op: tir_op, value: checked, clone_value: false, line: line, span: Span{start: name_span.start, end: expr_span(expr).end}})
}

// Rust `source != target && source.numeric_widening_to(target).is_some()`.
// The port helper reports a contained fixed-width range as `Val(true)` and an
// uncontained one as `Val(false)`, so ranged pairs widen only on `Val(true)`.
fn sema_stmt_compound_widens(source: Type, target: Type) -> Bool {
    if type_identity_equal(source, target) -> return false
    widening :: sema_expr_numeric_widening_to(source, target)
    if sema_expr_integer_range_for_type(source) != None && sema_expr_integer_range_for_type(target) != None -> return widening == (Val(true))
    widening != None
}

fn sema_stmt_transaction_expr_root(expr: Expr) -> String? {
    if expr == {
        .Ident(name, _) -> return Val(name)
        .Field(base, _, _) | .Index(base, _, _, _) -> return sema_stmt_transaction_expr_root(base)
        else -> None
    }
}

fn sema_stmt_transaction_lvalue_root(target: LValue) -> String? {
    if target == {
        .Local(name, _) -> return Val(name)
        .Field(base, _, _) -> return sema_stmt_transaction_expr_root(base)
        .Index(base, _, _, _) -> return sema_stmt_transaction_expr_root(base)
    }
}

fn sema_stmt_transaction_add_root(name: String, roots: &[String]) Never! {
    loop existing in roots {
        if existing == name -> return
    }
    &roots.push(name)
}

fn sema_stmt_transaction_collect_roots(statements: [Stmt], roots: &[String]) Never! {
    loop statement in statements {
        if statement == {
            .Assign(target, _, _, _) -> {
                root := sema_stmt_transaction_lvalue_root(target)
                if root != None -> sema_stmt_transaction_add_root(root ?? "", &roots)
            }
            .While(_, body, _, _, _)
            | .Loop(body, _, _, _)
            | .Unsafe(_, _, body, _)
            | .Impure(_, _, body, _)
            | .Reactive(body, _)
            | .Shield(body, _)
            | .Region(_, _, body, _)
            | .Policy(_, body, _)
            | .TaskGroup(_, _, _, body, _)
            | .Layout(_, _, body, _)
            | .AuthorityScope(_, _, _, body, _)
            | .ContextBlock(_, body, _)
            | .Live(body, _)
            | .AssumeDet(_, _, body, _) -> sema_stmt_transaction_collect_roots(body, &roots)
            .Switched(marker, body, _) -> {
                if marker.name != "Off" -> sema_stmt_transaction_collect_roots(body, &roots)
            }
            .For(_, _, _, _, body, _, _, _, _) -> sema_stmt_transaction_collect_roots(body, &roots)
            .CountedLoop(_, _, _, body, _, _, _) -> sema_stmt_transaction_collect_roots(body, &roots)
            .Switch(_, arms, else_body, _) -> {
                loop arm in arms -> sema_stmt_transaction_collect_roots(arm.body, &roots)
                if else_body != None -> sema_stmt_transaction_collect_roots(else_body, &roots)
            }
            .ComptimeIf(_, _, then_body, else_body, _, _) -> {
                sema_stmt_transaction_collect_roots(then_body, &roots)
                if else_body != None -> sema_stmt_transaction_collect_roots(else_body, &roots)
            }
            .ComptimeBlock(_, _, _) | .ComptimeSwitch(_, _, _, _) -> {}
            .Transact(_, _, _, _, _) -> {}
            else -> {}
        }
    }
}

fn sema_stmt_transaction_impl_matches_nominal(graph: SemaRegistrationGraph, implementation: SemaRegistrationImpl, nominal: SemaRegistrationNominal) -> Bool Never! {
    if implementation.target_identity_key == nominal.identity_key -> return true
    if implementation.target_module_identity == (Val(nominal.symbol.module_name)) && implementation.target_type_name == nominal.symbol.name -> return true
    resolved :: sema_type_resolve_nominal(graph, implementation.target_type, implementation.source_module_identity) ?? return false
    resolved.symbol.id.key == nominal.symbol.id.key
}

fn sema_stmt_transaction_rollback_trait_symbol(graph: SemaRegistrationGraph, implementation: SemaRegistrationImpl) -> Symbol? {
    if implementation.trait_symbol != None -> return implementation.trait_symbol
    resolved :: sema_registration_lookup_name(graph, implementation.source_module_identity, "Rollback") ?? return None
    if resolved.symbol.kind == SymbolKind.Trait -> return Val(resolved.symbol)
    None
}

fn sema_stmt_transaction_rollback_methods(ty: Type, environment: SemaScopeEnvironment) -> SemaStatementRollbackMethods? {
    if ty == {
        .Named(_) -> {}
        else -> return None
    }
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return None
    nominal :: sema_type_resolve_nominal(graph, ty, environment.module_identity) ?? return None
    loop graph_module in graph.modules {
        loop implementation in graph_module.impls {
            trait_matches := implementation.trait_name == (Val("Rollback"))
            if implementation.trait_symbol != None {
                trait_value :: implementation.trait_symbol ?? return None
                trait_matches = trait_value.name == "Rollback"
            }
            if !trait_matches || !sema_stmt_transaction_impl_matches_nominal(graph, implementation, nominal) -> next
            trait_owner := sema_stmt_transaction_rollback_trait_symbol(graph, implementation)
            snapshot_method := TMethodRef?{None}
            restore_method := TMethodRef?{None}
            loop method in implementation.methods {
                method_ref := TMethodRef{symbol: method.symbol.id, name: method.symbol.name, mangled: false, trait_owner: trait_owner.map((value) -> value.id), operator_identity: None}
                if method.symbol.name == "snapshot" -> snapshot_method = Val(method_ref)
                if method.symbol.name == "restore" -> restore_method = Val(method_ref)
            }
            if snapshot_method != None && restore_method != None {
                snapshot :: snapshot_method ?? return None
                restore :: restore_method ?? return None
                return Val(SemaStatementRollbackMethods{snapshot: snapshot, restore: restore})
            }
        }
    }
    None
}

fn sema_stmt_transaction_snapshots(roots: [String], scopes: SemaScopeTable, environment: SemaScopeEnvironment) -> [TTransactionSnapshot] Never! {
    snapshots := [TTransactionSnapshot]{}
    loop name in roots {
        index := sema_scope_resolve_index(scopes, name)
        if index == None -> next
        binding :: scopes.bindings[index ?? 0]
        if binding.symbol.kind != SymbolKind.Local && binding.symbol.kind != SymbolKind.Parameter -> next
        local := tir_symbol_local(name, binding.symbol.span, binding.symbol.id)
        local.mutable = binding.mutable
        local.integer_bounds = binding.integer_bounds
        rollback := sema_stmt_transaction_rollback_methods(binding.symbol.ty ?? Type.Named{name: "Unit"}, environment)
        rollback_type := Type?{None}
        snapshot_method := TMethodRef?{None}
        restore_method := TMethodRef?{None}
        if rollback != None {
            rollback_value :: rollback ?? return snapshots
            rollback_type = Val(binding.symbol.ty ?? Type.Named{name: "Unit"})
            snapshot_method = Val(rollback_value.snapshot)
            restore_method = Val(rollback_value.restore)
        }
        &snapshots.push(TTransactionSnapshot{local: local, rollback_type: rollback_type, snapshot_method: snapshot_method, restore_method: restore_method})
    }
    snapshots
}

fn sema_stmt_transaction_stm_local(span: Span) -> TLocal Never! {
    local := tir_generated_local("stm", span)
    local.mutable = true
    local
}

fn sema_stmt_tir_expr_touches_shared(value: TExpr) -> Bool {
    if value.kind == {
        .Lambda(_) | .LambdaValue(_) -> return false
        .InlineBlock(body) -> return sema_stmt_tir_statements_touch_shared(body)
        .IfExpr(condition, then_body, then_value, else_body, else_value) -> {
            loop child in tir_if_cond_children(condition) {
                if sema_stmt_tir_expr_touches_shared(child) -> return true
            }
            if sema_stmt_tir_statements_touch_shared(then_body) -> return true
            if sema_stmt_tir_expr_touches_shared(then_value) -> return true
            if sema_stmt_tir_statements_touch_shared(else_body) -> return true
            return sema_stmt_tir_expr_touches_shared(else_value)
        }
        .ResultHandler(subject, ok_pattern, ok_body, ok_value, err_pattern, err_body, err_value, terminal) -> {
            if sema_stmt_tir_expr_touches_shared(subject) -> return true
            loop child in tir_pattern_children(ok_pattern) {
                if sema_stmt_tir_expr_touches_shared(child) -> return true
            }
            if sema_stmt_tir_statements_touch_shared(ok_body) -> return true
            if sema_stmt_tir_expr_touches_shared(ok_value) -> return true
            loop child in tir_pattern_children(err_pattern) {
                if sema_stmt_tir_expr_touches_shared(child) -> return true
            }
            if sema_stmt_tir_statements_touch_shared(err_body) -> return true
            if sema_stmt_tir_expr_touches_shared(err_value) -> return true
            return sema_stmt_tir_expr_touches_shared(terminal)
        }
        .SharedGuardWait(guard, condition, _) -> {
            if sema_stmt_tir_expr_touches_shared(guard) -> return true
            return sema_stmt_tir_expr_touches_shared(condition)
        }
        .CoreClosureCall(kind) -> return sema_stmt_tir_core_closure_touches_shared(kind)
        .FnValue(kind) -> {
            if kind == {
                .NamedFn(_, _) -> return false
                else -> {}
            }
        }
        .HostCall(call) -> {
            if call == {
                .Method(receiver, method, _) -> {
                    if method == "shared.read" || method == "shared.edit" || method == "shared.read_txn" || method == "shared.edit_txn" -> return true
                    // D-CONC-STM1=A: a capture inside a transaction snapshots through the STM.
                    if method == "capture" && receiver.ty == .Shared(_) -> return true
                }
                .CCallback(_, _, _, _, _, _) -> return false
                else -> {}
            }
        }
        else -> {}
    }
    loop child in tir_expr_children(value) {
        if sema_stmt_tir_expr_touches_shared(child) -> return true
    }
    false
}

fn sema_stmt_tir_contract_touches_shared(contract: TContract) -> Bool {
    if sema_stmt_tir_expr_touches_shared(contract.condition) -> return true
    sema_stmt_tir_expr_touches_shared(contract.message)
}

fn sema_stmt_tir_core_closure_touches_shared(kind: TCoreClosureKind) -> Bool {
    if kind == {
        .Spawn(group, _, _, _) -> {
            if group != None {
                value :: group
                if sema_stmt_tir_expr_touches_shared(value) -> return true
            }
            false
        }
        .Realtime(rate, frames, _) -> sema_stmt_tir_expr_touches_shared(rate) || sema_stmt_tir_expr_touches_shared(frames)
        .Serve(address, _) -> sema_stmt_tir_expr_touches_shared(address)
        .OnInterrupt(callback) -> sema_stmt_tir_expr_touches_shared(callback)
        .UIButtonOnClick(label, shortcut, accessible_label, _, _) -> sema_stmt_tir_expr_touches_shared(label) || sema_stmt_tir_expr_touches_shared(shortcut) || sema_stmt_tir_expr_touches_shared(accessible_label)
        .UITextInputOnDrop(state, ime, _, _) -> sema_stmt_tir_expr_touches_shared(state) || sema_stmt_tir_expr_touches_shared(ime)
        .UIPreview(name, viewport, _, _, _, _, _, _, _, _, _, _, _) -> {
            if sema_stmt_tir_expr_touches_shared(name) -> return true
            if viewport != None {
                value :: viewport
                if sema_stmt_tir_expr_touches_shared(value) -> return true
            }
            false
        }
        .Guard(_) | .OnCommit(_, _) | .OnRollback(_, _) | .ReactiveDerived(_, _) | .ReactiveEffect(_, _) | .UIReactiveRender(_, _) -> false
    }
}

fn sema_stmt_tir_statement_touches_shared(statement: TStmt) -> Bool {
    if statement == {
        .Transact(_, _, _, _, _) -> false
        .ContractScope(pre, body, post, _, _) -> {
            loop contract in pre {
                if sema_stmt_tir_contract_touches_shared(contract) -> return true
            }
            if sema_stmt_tir_statements_touch_shared(body) -> return true
            loop contract in post {
                if sema_stmt_tir_contract_touches_shared(contract) -> return true
            }
            false
        }
        .RefutableBind(pattern, init, fallback, _) -> {
            pattern_children :: tir_pattern_children(pattern)
            loop child in pattern_children {
                if sema_stmt_tir_expr_touches_shared(child) -> return true
            }
            if sema_stmt_tir_expr_touches_shared(init) -> return true
            sema_stmt_tir_statements_touch_shared(fallback)
        }
        .CountedLoop(_, init, condition, step, _, body, _) -> {
            if sema_stmt_tir_statement_touches_shared(init) -> return true
            if sema_stmt_tir_expr_touches_shared(condition) -> return true
            if step != None {
                nested :: step
                if sema_stmt_tir_statement_touches_shared(nested) -> return true
            }
            sema_stmt_tir_statements_touch_shared(body)
        }
        .ForRange(_, _, start, end, step, _, body, _, _) -> {
            if sema_stmt_tir_expr_touches_shared(start) || sema_stmt_tir_expr_touches_shared(end) -> return true
            if step != None {
                nested :: step
                if sema_stmt_tir_expr_touches_shared(nested) -> return true
            }
            sema_stmt_tir_statements_touch_shared(body)
        }
        .Range(_, _, source, start, end, step, _, _, body, _) -> {
            if source == .Val(nested) && sema_stmt_tir_expr_touches_shared(nested) -> return true
            if sema_stmt_tir_expr_touches_shared(start) || sema_stmt_tir_expr_touches_shared(end) -> return true
            if step == .Val(nested) && sema_stmt_tir_expr_touches_shared(nested) -> return true
            sema_stmt_tir_statements_touch_shared(body)
        }
        .If(condition, then_body, else_body, _, _) -> {
            condition_children :: tir_if_cond_children(condition)
            loop child in condition_children {
                if sema_stmt_tir_expr_touches_shared(child) -> return true
            }
            if sema_stmt_tir_statements_touch_shared(then_body) -> return true
            if else_body == .Val(else_statements) -> sema_stmt_tir_statements_touch_shared(else_statements) else -> false
        }
        .Loop(_, body, _) -> sema_stmt_tir_statements_touch_shared(body)
        .While(_, condition, body, _) -> {
            if sema_stmt_tir_expr_touches_shared(condition) -> return true
            sema_stmt_tir_statements_touch_shared(body)
        }
        .Match(subject, arms, _, _) -> {
            if sema_stmt_tir_expr_touches_shared(subject) -> return true
            loop arm in arms {
                pattern_children :: tir_pattern_children(arm.pattern)
                loop child in pattern_children {
                    if sema_stmt_tir_expr_touches_shared(child) -> return true
                }
                if sema_stmt_tir_statements_touch_shared(arm.body) -> return true
            }
            false
        }
        .EnumMatch(scrutinee, _, arms, else_body, _, _) -> {
            if sema_stmt_tir_expr_touches_shared(scrutinee) -> return true
            loop arm in arms {
                pattern_children :: tir_pattern_children(arm.pattern)
                loop child in pattern_children {
                    if sema_stmt_tir_expr_touches_shared(child) -> return true
                }
                if sema_stmt_tir_statements_touch_shared(arm.body) -> return true
            }
            if else_body == .Val(else_statements) -> sema_stmt_tir_statements_touch_shared(else_statements) else -> false
        }
        .RangeSwitch(subject, arms, else_body, _) -> {
            if sema_stmt_tir_expr_touches_shared(subject) -> return true
            loop arm in arms {
                if sema_stmt_tir_statements_touch_shared(arm.body) -> return true
            }
            sema_stmt_tir_statements_touch_shared(else_body)
        }
        .ForIn(_, _, _, source, collection, step, _, _, _, body, _) -> {
            if sema_stmt_tir_expr_touches_shared(source) || sema_stmt_tir_expr_touches_shared(collection) -> return true
            if step != None {
                nested :: step
                if sema_stmt_tir_expr_touches_shared(nested) -> return true
            }
            sema_stmt_tir_statements_touch_shared(body)
        }
        .Inline(body, _) | .DebugOnly(body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) -> sema_stmt_tir_statements_touch_shared(body)
        .MixedSwitch(subject, _, arms, else_body, _) -> {
            if sema_stmt_tir_expr_touches_shared(subject) -> return true
            loop arm in arms {
                if sema_stmt_tir_expr_touches_shared(arm.condition) -> return true
                if sema_stmt_tir_statements_touch_shared(arm.body) -> return true
            }
            if else_body == .Val(else_statements) -> sema_stmt_tir_statements_touch_shared(else_statements) else -> false
        }
        .Unsafe(_, body) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Layout(_, _, body, _) -> sema_stmt_tir_statements_touch_shared(body)
        .ContextBlock(guards, body, _) -> {
            loop guard in guards {
                if sema_stmt_tir_expr_touches_shared(guard.value) -> return true
            }
            sema_stmt_tir_statements_touch_shared(body)
        }
        .ScopeMember(kind, body, _) -> {
            if kind == {
                .Timeout(duration) -> {
                    if sema_stmt_tir_expr_touches_shared(duration) -> return true
                }
                else -> {}
            }
            sema_stmt_tir_statements_touch_shared(body)
        }
        .GCEdit(_, _, _, _, index_temp, nested, _) -> {
            if index_temp != None {
                nested_index :: index_temp
                if sema_stmt_tir_expr_touches_shared(nested_index) -> return true
            }
            sema_stmt_tir_statement_touches_shared(nested)
        }
        .Reactive(_, _) -> false
        else -> {
            statement_children :: tir_stmt_children(statement)
            loop child in statement_children {
                if sema_stmt_tir_expr_touches_shared(child) -> return true
            }
            false
        }
    }
}

fn sema_stmt_tir_statements_touch_shared(statements: [TStmt]) -> Bool {
    loop statement in statements {
        if sema_stmt_tir_statement_touches_shared(statement) -> return true
    }
    false
}

fn sema_stmt_check_transaction(name: String?, name_span: Span?, body: [Stmt], implicit: Bool, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    roots := [String]{}
    sema_stmt_transaction_collect_roots(body, &roots)
    snapshots := sema_stmt_transaction_snapshots(roots, scopes, environment)
    return_type := scopes.return_type
    loop_depth := scopes.loop_depth
    inside_transaction := implicit && scopes.transaction_depth > 0
    sema_scope_enter(&scopes, &state, "transact@{span.start}")
    handle := TLocal?{None}
    if name != None {
        handle_name :: name
        handle_span :: name_span ?? span
        owner := sema_scope_local_owner_key(scopes)
        id := symbol_id(SymbolKind.Local, environment.module_identity, owner, handle_name)
        symbol := Symbol{id: id, kind: SymbolKind.Local, name: handle_name, module_name: environment.module_identity, owner: Val(owner), span: handle_span, ty: Val(Type.Named{name: "Transaction"}), visibility: 0}
        if !sema_scope_declare_local(&scopes, symbol, true, AccessConvention.Read, None, false) {
            &diagnostics.push(sema_already_defined(handle_name, handle_span))
            sema_scope_leave(&scopes, &state)
            return None
        }
        sema_ownership_declare_binding(&state, symbol, false)
        local := tir_symbol_local(handle_name, handle_span, symbol.id)
        local.mutable = true
        handle = Val(local)
    }
    previous_transaction_depth := scopes.transaction_depth
    previous_transaction_wall_depth := scopes.transaction_wall_depth
    scopes.transaction_depth += 1
    if !implicit -> scopes.transaction_wall_depth += 1
    nested :: sema_check_statements(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
    scopes.transaction_depth = previous_transaction_depth
    scopes.transaction_wall_depth = previous_transaction_wall_depth
    sema_single_use_leave_scope(&scopes, &state, &diagnostics)
    if !nested.complete -> return None
    if inside_transaction -> return Val(TStmt.Region{body: nested.value, span: span})
    if handle == None && snapshots.len() > 0 {
        synthesized := tir_generated_local("txn", span)
        synthesized.mutable = true
        handle = Val(synthesized)
    }
    stm := TLocal?{None}
    if sema_stmt_tir_statements_touch_shared(nested.value) -> stm = Val(sema_stmt_transaction_stm_local(span))
    Val(TStmt.Transact{handle: handle, snapshots: snapshots, stm: stm, body: nested.value, span: span})
}
fn sema_stmt_defer_close_resource(close: Expr, scopes: SemaScopeTable) -> SymbolID? {
    if close == {
        .Call(call) -> {
            if call.name != "close" || call.args.len() != 1 -> return None
            argument := call.args[0]
            if argument.convention != AccessConvention.Move -> return None
            root :: sema_stmt_for_in_expr_root_ident(argument.expr) ?? return None
            index :: sema_scope_resolve_index_at(scopes, root, expr_span(argument.expr)) ?? return None
            binding :: scopes.bindings[index]
            if binding.symbol.kind != SymbolKind.Local && binding.symbol.kind != SymbolKind.Parameter -> return None
            return Val(binding.symbol.id)
        }
        else -> return None
    }
}
fn sema_stmt_check_defer_close(close: Expr, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    if close == {
        .Call(call) -> {
            if call.name != "close" -> return None
            if call.args.len() != 1 {
                &diagnostics.push(sema_error("E0104", call.name_span, "`close` takes exactly one resource, got {call.args.len()}", "`close` consumes one value through its nominal `Close` implementation and the move marker `^`", "write `close(^resource)` with the move marker `^`"))
                loop argument in call.args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                return None
            }
            argument := call.args[0]
            resource_value := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            if argument.convention != AccessConvention.Move {
                &diagnostics.push(sema_error("E0201", argument.span, "`close` takes ownership of its resource", "`Close.close(^self)` is consuming through the move marker `^`, so cleanup runs on exactly one owner", "write `close(^resource)` with the move marker `^`"))
                return None
            }
            value :: resource_value ?? return None
            resource_id :: sema_stmt_defer_close_resource(close, scopes) ?? return None
            graph_option :: environment.registration_graph
            graph :: graph_option ?? return None
            satisfies_close := sema_type_bound_satisfied_with_generics(graph, value.ty, "Close", environment.module_identity, context.generic_params)
            if satisfies_close == None -> return None
            close_valid := satisfies_close == (Val(true))
            if !close_valid {
                shown := type_name(value.ty)
                &diagnostics.push(sema_error("E0905", expr_span(argument.expr), "`{shown}` isn't `Close`", "`{shown}` would need to implement `Close` before it can be used here", "write `impl {shown}: Close {{ … }}` with every required method"))
            }
            if !sema_stmt_move_direct(argument.expr, &state, scopes, "the deferred `close`", &diagnostics) || !close_valid -> return None
            closed := sema_tir_expr(Type.Named{name: "Unit"}, TExprKind.Close{value: value}, span)
            Val(TStmt.DeferClose{close: closed, resource: resource_id, scope_id: scopes.current, span: span})
        }
        else -> None
    }
}


fn sema_stmt_check_reactive(body: [Stmt], span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TLambda? {
    forbidden := scopes.comptime_execution_depth > 0
    if forbidden {
        &diagnostics.push(sema_error("E2914", span, "`#Reactive` can't run at comptime", "reactive effects subscribe to runtime signals and re-run when they change (D-REACTCORE1)", "move `#Reactive {{ … }}` out of the `comptime` block"))
    }
    closure_body := body
    &closure_body.push(Stmt.Return{value: None, span: Span{start: span.end, end: span.end}})
    lambda := Lambda{
        take_names: [NamedSpan]{},
        params: [LambdaParam]{},
        result_type: Val(Type.Named{name: "Unit"}),
        error_type: None,
        effects: None,
        body: LambdaBody.Block{body: closure_body},
        span: span,
        meta: ast_empty_lambda_meta(),
    }
    previous_escapes := context.lambda_escapes
    context.lambda_escapes = Val(true)
    checked := sema_expression_lambda(lambda, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    context.lambda_escapes = previous_escapes
    if forbidden -> return None
    expression :: checked ?? return None
    if expression.kind == {
        .Lambda(value) -> return Val(value)
        else -> return None
    }
}

fn sema_stmt_check_scope_member(name: String, args: [Expr], args_span: Span?, body: [Stmt], dsl: Bool, span: Span, return_type: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> TStmt? {
    if dsl {
        dsl_args_valid := args.len() == 0
        if name != "HTML" && args.len() == 1 {
            if args[0] == {
                .Ident(_, _) -> dsl_args_valid = true
                else -> {}
            }
        }
        if !dsl_args_valid {
            header_span := args_span ?? span
            expected := if name == {
                "SQL" -> "`#SQL {{ … }}` or `#SQL<Row> {{ … }}`"
                "HTML" -> "`#HTML {{ … }}`"
                else -> "the declared checked text-block header"
            }
            &diagnostics.push(sema_error("E0617", header_span, "`#{name}` has an invalid DSL header", "a checked text block keeps its Jet boundary; only its declared header shape is legal", "write {expected}"))
        }
        nested := sema_stmt_check_block(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, "scope-dsl@{span.start}", loop_depth)
        if !dsl_args_valid || !nested.complete -> return None
        return Val(TStmt.Region{body: nested.value, span: span})
    }
    kind := TScopeMemberKind?{None}
    if name == {
        "setup" -> {
            if args.len() == 0 {
                kind = Val(TScopeMemberKind.Setup)
            }
        }
        "expect_fail" -> {
            if args.len() == {
                0 -> kind = Val(TScopeMemberKind.ExpectFail{code: None})
                1 -> {
                    if args[0] == {
                        .Ident(code, _) -> kind = Val(TScopeMemberKind.ExpectFail{code: Val(code)})
                        else -> {}
                    }
                }
                else -> {}
            }
        }
        "timeout" -> {
            if args.len() == 1 {
                duration := sema_check_expression(args[0], Val(Type.Named{name: "Duration"}), environment, &scopes, &state, &tail_store, &context, &diagnostics)
                if duration == {
                    .Val(typed) -> kind = Val(TScopeMemberKind.Timeout{duration: typed})
                    .None -> {}
                }
            }
        }
        "measure" -> {
            if args.len() == 0 {
                kind = Val(TScopeMemberKind.Measure)
            }
        }
        "skip" -> {
            if args.len() == {
                0 -> kind = Val(TScopeMemberKind.Skip)
                1 -> {
                    if args[0] == {
                        .Str(_, _) -> kind = Val(TScopeMemberKind.Skip)
                        else -> {}
                    }
                }
                else -> {}
            }
        }
        else -> {}
    }
    nested := if name == "setup" -> sema_check_statements(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth) else -> sema_stmt_check_block(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, "scope-member@{span.start}", loop_depth)
    if !nested.complete || kind == None -> return None
    member :: kind ?? return None
    Val(TStmt.ScopeMember{kind: member, body: nested.value, span: span})
}


fn sema_stmt_check_shared_transaction(transaction: Stmt, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    if transaction == {
        .Transact(_, _, body, _, span) -> sema_stmt_check_transaction(None, None, body, true, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        else -> None
    }
}

fn sema_stmt_check_shared_field_assignment(target: LValue, op: BinOp?, op_span: Span, expr: Expr, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    if target == {
        .Field(base, _, _) -> {
            receiver_ty :: sema_stmt_return_known_type(base, scopes) ?? return None
            needs_transaction := sema_shared_access_expr_touches_shared(expr, scopes)
            value := expr
            body := [Stmt]{}
            if needs_transaction {
                binding := ast_binding(SEMA_SHARED_HOISTED_RHS, expr_span(expr), false, expr, None)
                &body.push(Stmt.Val{binding: binding})
                value = Expr.Ident{name: SEMA_SHARED_HOISTED_RHS, span: expr_span(expr)}
            }
            rewritten :: sema_shared_access_desugar_field_write(target, op, op_span, value, span, receiver_ty) ?? return None
            if rewritten == {
                .Expr(rewritten_expr) -> {
                    if needs_transaction {
                        &body.push(Stmt.Expr{expr: rewritten_expr})
                        transaction_span := Span{start: span.start, end: expr_span(expr).end}
                        transaction := Stmt.Transact{name: None, name_span: None, body: body, implicit: true, span: transaction_span}
                        return sema_stmt_check_shared_transaction(transaction, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                    }
                    checked :: sema_check_expression(rewritten_expr, Val(Type.Named{name: "Unit"}), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                    return Val(TStmt.ExprStmt{value: checked, span: expr_span(rewritten_expr)})
                }
                else -> return None
            }
        }
        else -> return None
    }
}

fn sema_stmt_check_assignment_place(target: LValue, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if target == {
        .Field(base, member, span) -> {
            checked_base :: sema_check_expression(base, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
            return sema_expression_field_checked(checked_base, member, span, None, environment, &scopes, &context, &diagnostics)
        }
        .Index(base, index, span, kind) -> sema_expression_index(base, index, kind, span, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        else -> None
    }
}

fn sema_stmt_check_projected_assignment(target: LValue, op: BinOp?, op_span: Span, expr: Expr, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    if target == {
        .Index(_, _, span, _) -> {
            if op != None {
                operator :: op
                &diagnostics.push(sema_error("E0164", span, "compound assignment `{sema_expr_binary_name(operator)}` can't target an indexed slot", "a compound update reads an indexed slot before it writes, so a missing map key or checked index would make the update partial", "write a total update such as `map[key] = (map.get(key) ?? 0) {sema_expr_binary_name(operator)} 1`"))
                return None
            }
        }
        else -> {}
    }
    // D-SOA1 (E1108): `xs[i].field = …` on a columnar list would write a
    // gathered copy, not the column.
    if target == .Field(field_base, field, field_span) && field_base == .Index(indexed_base, _, _, _) && sema_stmt_for_in_expr_root_ident(indexed_base) == .Val(root) {
        root_type :: sema_stmt_return_known_type(Expr.Ident{name: root, span: field_span}, scopes)
        if root_type == .Val(root_ty) && sema_columnar_list_element(environment, root_ty) == .Val(element) {
            &diagnostics.push(sema_error("E1108", field_span, "writing `{root}[i].{field}` isn't supported on a columnar list yet", "`#Layout(columnar)` lists support reading a field (`xs[i].f`) in v1; writing one is deferred", "drop `#Layout(columnar)` from `{element}` to write fields in place, or rebuild the element with `push`"))
            return None
        }
    }
    place := sema_stmt_check_assignment_place(target, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if target == .Index(index_base, _, index_span, _) && place.kind == .Index(checked_base, _, _, _, _, _) {
        if sema_columnar_list_element(environment, checked_base.ty) == .Val(element) {
            &diagnostics.push(sema_error("E1108", index_span, "writing through `[ ]` isn't supported on a columnar list `{sema_type_show(sema_expr_unwrap_tag(checked_base.ty))}` yet", "`#Layout(columnar)` lists support reading in v1 (indexing, field access, `len`, `is_empty`, `push`, iteration); index-write is deferred", "drop `#Layout(columnar)` from `{element}` to assign through `[ ]`, or rebuild the list with `push`"))
            return None
        }
        if sema_stmt_index_write_is_collection(checked_base.ty) && sema_expr_place_root_ident(index_base) == .Val(root) && context.iter_borrowed.contains(root) {
            &diagnostics.push(sema_collection_changed_in_loop(root, "a mutation of `{root}`", index_span))
        }
    }
    expected := Type?{None}
    if op == None -> expected = Val(place.ty)
    // Same compound contract as `sema_stmt_check_local_assignment`.
    if op != None && sema_expr_decimal_literal_operand(expr, true) && sema_expr_expects_machine_float(Val(place.ty)) -> expected = Val(place.ty)
    checked_value :: sema_check_expression(expr, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    checked := checked_value
    if op != None && sema_stmt_compound_widens(checked.ty, place.ty) {
        widen_line :: sema_source_line_at(environment.source_segments, checked.span) ?? 0
        checked = sema_expr_numeric_literal_conversion(checked, place.ty, checked.span, widen_line, &diagnostics) ?? return None
    }
    if op == None && sema_copy_site_check_assignment(expr, environment, scopes, context, &diagnostics) -> return None
    tir_op := TBinaryOp?{None}
    if op != None {
        operator :: op
        result :: sema_expr_binary_type(operator, place.ty, checked.ty, op_span, &diagnostics) ?? return None
        if !sema_type_assignable(place.ty, result) {
            &diagnostics.push(sema_type_mismatch(place.ty, result, op_span))
            return None
        }
        tir_op = Val(sema_stmt_binary_type(operator))
    }
    if !sema_ownership_check_lvalue_write(&state, target, scopes, &diagnostics) -> return None
    if !sema_stmt_move_direct(expr, &state, scopes, "the assignment", &diagnostics) -> return None
    if place.kind == {
        .Index(base, index, kind, _, checked_call, location) -> place.kind = TExprKind.Index{base: base, index: index, kind: kind, access: AccessConvention.Write, checked_call: checked_call, location: location}
        else -> {}
    }
    line :: sema_source_line_at(environment.source_segments, place.span) ?? return None
    Val(TStmt.Assign{place: TPlace.Expr{value: place}, op: tir_op, value: checked, clone_value: false, line: line, span: Span{start: place.span.start, end: expr_span(expr).end}})
}

fn sema_stmt_check_assignment(target: LValue, op: BinOp?, op_span: Span, expr: Expr, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    if target == {
        .Local(name, name_span) -> sema_stmt_check_local_assignment(name, name_span, op, op_span, expr, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Field(base, _, span) -> {
            receiver_ty := sema_stmt_return_known_type(base, scopes)
            if receiver_ty != None {
                resolved :: receiver_ty ?? Type.Named{name: "Unit"}
                if sema_shared_access_is_shared_type(resolved) -> return sema_stmt_check_shared_field_assignment(target, op, op_span, expr, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            }
            sema_stmt_check_projected_assignment(target, op, op_span, expr, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        }
        .Index(base, index, _, _) -> {
            // D-UNINIT1: a plain `buf[i] = …` fills one slot of a fixed
            // `Type{ uninit }` list, so the base is not read while the
            // write is checked; the remaining slots stay unwritten.
            taken := SemaOwnershipUninitFact?{None}
            if op == None && base == .Ident(root, _) && sema_scope_resolve_index(scopes, root) == .Val(root_index) {
                taken = sema_ownership_uninit_take(&state, scopes.bindings[root_index].symbol.id.key)
            }
            checked := sema_stmt_check_projected_assignment(target, op, op_span, expr, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            if taken == .Val(fact) -> sema_stmt_uninit_note_slot_write(&state, fact, index)
            checked
        }
        else -> None
    }
}

fn sema_stmt_check_loop_step(step: Stmt, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    if step == {
        .Assign(target, op, op_span, expr) -> sema_stmt_check_assignment(target, op, op_span, expr, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Expr(expr) -> {
            value :: sema_check_expression(expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
            if value.ty != (Type.Named{name: "Unit"}) -> return None
            return Val(TStmt.ExprStmt{value: value, span: expr_span(expr)})
        }
        else -> None
    }
}


// Leave a statement list: drop its lambda tail frames and, when it entered
// one source nesting level, that level.
fn sema_stmt_leave_statements(context: &SemaCheckContext, depth: Int, nested: Bool) Never! {
    loop context.lambda_statement_tails.len() > depth -> _ := &context.lambda_statement_tails.pop()
    if nested -> sema_leave_source_nesting(&context)
}

fn sema_stmt_return_required_type(return_type: Type?) -> Type Never! {
    return return_type ?? Type.Named{name: "Unit"}
}
fn sema_stmt_return_success_type(return_type: Type?) -> Type Never! {
    required := sema_stmt_return_required_type(return_type)
    normalized := sema_expr_unwrap_tag(required)
    if normalized == {
        .Result(ok, _) -> return ok
        .Option(value) -> return value
        else -> return normalized
    }
}
fn sema_stmt_return_is_carrier(return_type: Type?) -> Bool Never! {
    normalized := sema_expr_unwrap_tag(sema_stmt_return_required_type(return_type))
    if normalized == {
        .Result(_, _) | .Option(_) -> return true
        else -> return false
    }
}
fn sema_stmt_return_known_type(value: Expr, scopes: SemaScopeTable) -> Type? {
    if value == {
        .Paren(inner, _) | .Tainted(inner, _, _) | .Copy(inner, _) | .Place(inner, _, _) -> return sema_stmt_return_known_type(inner, scopes)
        .Ident(name, _) -> {
            symbol :: sema_scope_resolve(scopes, name) ?? return None
            return symbol.ty
        }
        .Call(call) -> {
            if call.resolved_ret != None -> return call.resolved_ret
            symbol :: sema_scope_resolve(scopes, call.name) ?? return None
            symbol_type :: symbol.ty ?? return None
            if symbol_type == {
                .Fn(_, ret, _, _, _, _) -> return ret
                else -> {}
            }
        }
        .MethodCall(_, _, _, _, _, _, _, resolved_ret, _, _) -> return resolved_ret
        .CallValue(callee, _, _) -> {
            callee_ty :: sema_stmt_return_known_type(callee, scopes) ?? return None
            if callee_ty == {
                .Fn(_, ret, _, _, _, _) -> return ret
                else -> {}
            }
        }
        else -> return None
    }
    None
}
fn sema_stmt_return_types_are_carriers(actual: Type, required: Type) -> Bool Never! {
    normalized_actual := sema_expr_unwrap_tag(actual)
    normalized_required := sema_expr_unwrap_tag(required)
    if normalized_required == {
        .Result(_, _) -> {
            if normalized_actual == {
                .Result(_, _) -> return true
                else -> {}
            }
        }
        .Option(_) -> {
            if normalized_actual == {
                .Option(_) -> return true
                else -> {}
            }
        }
        else -> {}
    }
    false
}
fn sema_stmt_return_expr_is_carrier(value: Expr, return_type: Type?, scopes: SemaScopeTable) -> Bool {
    if !sema_stmt_return_is_carrier(return_type) -> return false
    required := sema_stmt_return_required_type(return_type)
    normalized := sema_expr_unwrap_tag(required)
    if value == {
        .Paren(inner, _) | .Tainted(inner, _, _) | .Copy(inner, _) -> return sema_stmt_return_expr_is_carrier(inner, return_type, scopes)
        else -> {}
    }
    if normalized == {
        .Result(_, error) -> {
            // Under `Never!` no failure exists to build, so `Err(...)` is the
            // default error value itself (an error conversion's result).
            failure_reachable :: sema_expr_unwrap_tag(error) != Type.Named{name: "Never"}
            if value == {
                .Ok(_, _) -> return true
                .Err(_, _) -> return failure_reachable
                .EnumLit(owner, variant, _, args, dot, _) -> {
                    if owner == "" && dot && args.len() == 1 && args[0] == .Positional(_) {
                        if variant == "Ok" -> return true
                        if variant == "Err" -> return failure_reachable
                    }
                }
                else -> {}
            }
            if value == {
                .Call(call) -> {
                    if (call.name == "Ok" || failure_reachable) && sema_expression_contextual_result_call(call, Val(required), scopes) != None -> return true
                    if failure_reachable && sema_call_default_err_candidate(call, Val(required), scopes) -> return true
                }
                else -> {}
            }
        }
        .Option(_) -> {
            if value == {
                .Present(_, _) | .Absent(_) -> return true
                .EnumLit(owner, variant, _, args, _, _) -> {
                    if owner == "" {
                        if variant == "None" && args.len() == 0 -> return true
                        if variant == "Val" && args.len() == 1 && args[0] == .Positional(_) -> return true
                    }
                }
                else -> {}
            }
        }
        else -> {}
    }
    known_type :: sema_stmt_return_known_type(value, scopes) ?? return false
    sema_stmt_return_types_are_carriers(known_type, required)
}
fn sema_stmt_check_return_value(value: Expr, return_type: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    diagnostic_start :: diagnostics.len()
    checked :: sema_stmt_check_return_value_typed(value, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if checked == None -> sema_stmt_value_return_mismatch(value, return_type, diagnostic_start, environment, &scopes, state, &tail_store, &context, &diagnostics)
    checked
}

// A returned value (a `return` or a value tail) with its ownership and view
// obligations: the value moves out and its views must outlive the call.
fn sema_stmt_check_returned_value(value: Expr, return_type: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    // D-SHAPE-PLACE1=A (Rust `check_return`): a bare range place is a read
    // window at a named `View<T>` return boundary, acquired explicitly so
    // the returned type stays a view instead of a materialized list.
    if sema_stmt_return_is_view_boundary(return_type) && sema_stmt_is_bare_range_place(value, scopes, &state) {
        return sema_stmt_check_returned_value(Expr.Place{value: value, access: PlaceAccess.Read, span: expr_span(value)}, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    checked :: sema_stmt_check_return_value(value, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    value_is_ident := if value == {
        .Ident(_, _) -> true
        else -> false
    }
    string_view_return := sema_stmt_string_view_type(checked.ty) && (value_is_ident || sema_string_view_call_sources(value, scopes, &state).len() > 0)
    // Rust keeps checking the move after a refused `View<str>` source (E0120).
    view_valid := if string_view_return -> sema_string_view_record_return(value, scopes, &state, &context, &diagnostics) else -> sema_stmt_record_return_views(value, checked.ty, scopes, &state, &context, &diagnostics)
    // A named `View<T>` boundary reads every bare place through a window
    // (Rust wraps it before the audit), so only other returns are audited.
    if return_type != None && !sema_stmt_return_is_view_boundary(return_type) -> sema_copy_site_check_borrowed_return(value, environment, scopes, context, &diagnostics)
    moved := (!string_view_return && !view_valid) || sema_stmt_move_direct(value, &state, scopes, "`return`", &diagnostics)
    if !view_valid || !moved -> return None
    Val(checked)
}

// The declared success type is `View<T>`, not the string view `View<str>`.
fn sema_stmt_return_is_view_boundary(return_type: Type?) -> Bool Never! {
    declared :: return_type ?? return false
    success :: if declared == .Result(ok, _) -> ok else -> declared
    if success == .Apply(name, _) -> return name == "View" && !sema_stmt_string_view_type(success)
    false
}

// D-DISCARD1=A (owner ruling): with a written return type, a value that does
// not fit it is E0113 about the value itself (the Rust reference's
// `check_return_expr`), replacing the generic E0108 at the value.
fn sema_stmt_value_return_mismatch(value: Expr, return_type: Type?, diagnostic_start: Int, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) {
    if sema_stmt_return_success_type(return_type) == (Type.Named{name: "Unit"}) -> return
    value_span :: expr_span(value)
    found := Int?{None}
    index := diagnostic_start
    loop index < diagnostics.len() {
        if diagnostics[index].code == "E0108" && diagnostics[index].span == (Val(value_span)) {
            found = Val(index)
            break
        }
        index += 1
    }
    mismatch_index :: found ?? return
    // The value's own type, inferred without the return type as a target.
    probe_diagnostics := [Diagnostic]{}
    offered :: sema_probe_expression(value, None, environment, &scopes, state, &tail_store, &context, &probe_diagnostics) ?? return
    diagnostics[mismatch_index] = sema_return_value_mismatch(context.function_name, sema_stmt_return_required_type(return_type), offered.ty, value_span)
}

fn sema_stmt_check_return_value_typed(value: Expr, return_type: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    required := sema_stmt_return_required_type(return_type)
    if sema_stmt_return_expr_is_carrier(value, return_type, scopes) {
        carrier :: sema_check_expression(value, Val(required), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        // #3708: a fallible value returned as-is (not an `Ok`/`Err` written
        // here) is this body's own failure source.
        if !sema_stmt_is_written_carrier(value, Val(required), scopes) && sema_stmt_type_is_fallible_result(carrier.ty) -> context.failure_direct_source = true
        return Val(carrier)
    }
    if !sema_stmt_return_is_carrier(return_type) {
        return sema_stmt_check_return_payload(value, required, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    payload :: sema_stmt_check_return_payload(value, sema_stmt_return_success_type(return_type), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    normalized := sema_expr_unwrap_tag(required)
    if normalized == {
        .Result(_, _) -> return Val(sema_tir_expr(required, TExprKind.Ok{value: payload}, expr_span(value)))
        .Option(_) -> return Val(sema_tir_expr(required, TExprKind.Present{value: payload}, expr_span(value)))
        else -> return Val(payload)
    }
}
// Return-position numeric widening, exactly as at a call argument: a value
// whose type is already known and widens into the numeric success slot is
// checked on its own type and then converted, so every tier receives the
// explicit conversion instead of the source bits under the slot's type.
fn sema_stmt_check_return_payload(value: Expr, success: Type, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    known := sema_stmt_return_known_type(value, scopes)
    if known == .Val(source) && sema_expr_is_numeric(success) && !type_identity_equal(source, success) && sema_expr_numeric_widening_to(source, success) == (Val(true)) {
        checked :: sema_check_expression(value, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        line :: sema_source_line_at(environment.source_segments, checked.span) ?? 0
        return sema_expr_numeric_literal_conversion(checked, success, checked.span, line, &diagnostics)
    }
    // Rust `string_view_return`: a `View<str>` return reads a string view as itself.
    if sema_stmt_string_view_type(success) && sema_string_view_return_source(value, scopes, &state) -> return sema_string_view_return_value(value, success, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    // D-MEM-COPYSEM1=A: a returned string view becomes an owned `String`.
    if sema_string_view_owning_read(value, success, scopes) {
        if value == .Ident(name, name_span) -> return sema_string_view_materialize(name, name_span, Val(success), environment, &scopes, &state, &context, &diagnostics)
    }
    sema_check_expression(value, Val(success), environment, &scopes, &state, &tail_store, &context, &diagnostics)
}
fn sema_stmt_return_allows_empty(return_type: Type?) -> Bool Never! {
    if return_type == None -> return true
    normalized := sema_expr_unwrap_tag(sema_stmt_return_required_type(return_type))
    if normalized == {
        .Option(_) -> return false
        else -> {}
    }
    if normalized == {
        .Named(name) -> {
            if name == "Never" -> return false
        }
        else -> {}
    }
    sema_stmt_return_success_type(return_type) == Type.Named{name: "Unit"}
}

// A Result whose failure is reachable.
fn sema_stmt_type_is_fallible_result(ty: Type) -> Bool Never! {
    if sema_expr_unwrap_tag(ty) == {
        .Result(_, error) -> sema_expr_unwrap_tag(error) != Type.Named{name: "Never"}
        else -> false
    }
}

// An `Ok(…)` or `Err(…)` written at this site, through parentheses.
fn sema_stmt_is_written_carrier(value: Expr, expected: Type?, scopes: SemaScopeTable) -> Bool Never! {
    if value == {
        .Paren(inner, _) -> sema_stmt_is_written_carrier(inner, expected, scopes)
        .Ok(_, _) | .Err(_, _) -> true
        .Call(call) -> sema_expression_contextual_result_call(call, expected, scopes) != None || sema_call_default_err_candidate(call, expected, scopes)
        .EnumLit(owner, variant, _, args, dot, _) -> owner == "" && dot && (variant == "Ok" || variant == "Err") && args.len() == 1 && args[0] == .Positional(_)
        else -> false
    }
}

// An optional, or a Result whose failure is reachable (the Rust reference's
// `Type::is_fallible`).
fn sema_stmt_type_is_fallible(ty: Type) -> Bool Never! {
    if sema_expr_unwrap_tag(ty) == {
        .Option(_) -> true
        .Result(_, error) -> sema_expr_unwrap_tag(error) != Type.Named{name: "Never"}
        else -> false
    }
}

// A statement value that carries nothing: `Unit`, `Never`, or the success of
// a unit `Never!` call.
fn sema_stmt_type_is_unit_success(ty: Type) -> Bool Never! {
    success :: if sema_expr_unwrap_tag(ty) == {
        .Result(ok, error) -> if sema_expr_unwrap_tag(error) == (Type.Named{name: "Never"}) -> ok else -> ty
        else -> ty
    }
    success == (Type.Named{name: "Unit"}) || success == (Type.Named{name: "Never"})
}

fn sema_stmt_restore_statement_scopes(scopes: &SemaScopeTable, return_type: Type?, failure_carrier: TFailureCarrier?, loop_depth: Int) Never! {
    scopes.return_type = return_type
    scopes.failure_carrier = failure_carrier
    scopes.loop_depth = loop_depth
}

// A callable argument's effects belong to the call site, and a write-marked
// argument changes the caller's place, so either one gives the call a purpose
// beyond its result.
fn sema_stmt_discard_args_effectful(args: [TCallArg]) -> Bool Never! {
    loop arg in args {
        if arg.mut_borrow -> return true
        if arg.value.ty == {
            .Fn(_, _, _, _, _, _) -> return true
            else -> {}
        }
    }
    false
}

// E0433 (D-DISCARD1=A), lost-tail site: a function with no written return
// type returns nothing, so the value of its last line is lost.
fn sema_stmt_lost_tail_diagnostic(function: String, value_type: String, span: Span) -> Diagnostic {
    sema_error("E0433", span, "this {value_type} value is thrown away", "`{function}` has no return type, so it returns nothing and the value of its last line is lost", "if `{function}` should return it, write `-> {value_type}` after its parameter list; to discard it on purpose, write `.drop(\"reason\")`")
}

// A statement call under an automatic or written `?` still carries a
// failure unless its callee's contract is `T Never!` (D-DISCARD1=A): declared,
// or projected onto a callee the #3708 failure solve proved infallible
// (`sema_failure_project_infallible`) before the bundle's final check.
fn sema_stmt_discarded_call(checked: TExpr) -> TExpr? Never! {
    inner := checked
    if checked.kind == {
        .Try(value, _, _) -> inner = value
        .TryWithContext(value, _, _, _, _, _) -> inner = value
        else -> return Val(checked)
    }
    if sema_expr_unwrap_tag(inner.ty) == .Result(_, error) && sema_expr_unwrap_tag(error) == (Type.Named{name: "Never"}) -> return Val(inner)
    None
}

// E0433 candidate: the statement drops the non-Unit result of a direct,
// static or method call. Mark the call's fact; the solved effect phase
// reports it when the callee's row is empty (D-DISCARD1=A: pure means an
// empty row and nothing passed with `&`).
fn sema_stmt_mark_discarded_result(checked: TExpr, fact_start: Int, context: &SemaCheckContext) Never! {
    call :: sema_stmt_discarded_call(checked) ?? return
    callee_key :: if call.kind == {
        .Call(callee, _, args) -> if sema_stmt_discard_args_effectful(args) -> "" else -> callee.key
        .StaticCall(_, _, method, _, args) -> if sema_stmt_discard_args_effectful(args) -> "" else -> method.symbol.key
        .MethodCall(receiver, method, _, args) -> {
            written :: if receiver.kind == {
                .Borrow(_, access) -> access != AccessConvention.Read
                else -> false
            }
            if written || sema_stmt_discard_args_effectful(args) -> "" else -> method.symbol.key
        }
        else -> ""
    }
    if callee_key == "" -> return
    index := context.call_facts.len() - 1
    loop index >= fact_start {
        if context.call_facts[index].callee == .Val(symbol) && symbol.key == callee_key {
            context.call_facts[index].discarded = true
            return
        }
        index -= 1
    }
}

// The source spelling of a scoped statement form this checker does not
// handle yet, for its incomplete reason.
fn sema_stmt_scope_form_label(statement: Stmt) -> String Never! {
    if statement == {
        .Layout(_, _, _, _) -> "`layout`"
        .ContextBlock(_, _, _) -> "`#Context`"
        .Live(_, _) -> "`live`"
        .AssumeDet(_, _, _, _) -> "`assume_deterministic`"
        else -> "scoped statement"
    }
}

pub fn sema_check_statements(statements: [Stmt], return_type: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> SemaStatementResult {
    // D-COMPILE-STACK1=A (E1403): a statement list is one source nesting level
    // below its owner, as each of its statements is in the Rust checker.
    entered_nesting := false
    loop first in statements {
        if !sema_enter_source_nesting(&context, sema_compiler_index_stmt_span(first), &diagnostics) -> return SemaStatementResult{value: [TStmt]{}, complete: false}
        entered_nesting = true
        break
    }
    tail_frame_depth := context.lambda_statement_tails.len()
    tail_body_id := sema_statement_tail_store_add_body(&tail_store, statements)
    &context.lambda_statement_tails.push(SemaStatementTailFrame{body_id: tail_body_id, start_index: 0})
    previous_return_type := scopes.return_type
    previous_failure_carrier := scopes.failure_carrier
    previous_loop_depth := scopes.loop_depth
    // A nested block keeps the carrier its owner established (a lambda's is
    // not the implicit `!Err` of a function); only a new return type, or a
    // root with no carrier outside an open callback, derives it.
    if return_type != previous_return_type || (previous_failure_carrier == None && !context.failure_inference) -> scopes.failure_carrier = Val(sema_failure_carrier(return_type))
    scopes.return_type = return_type
    scopes.loop_depth = loop_depth
    output := [TStmt]{}
    complete := true
    reachable := true
    index := 0
    loop index < statements.len() {
        statement :: statements[index]
        context.lambda_statement_tails[tail_frame_depth].start_index = index + 1
        if !reachable {
            // Checked on the live tables and rolled back; only its failure
            // rows are kept.
            dead_scope_mark :: sema_scope_mark(&scopes)
            dead_state := sema_ownership_state_snapshot(state)
            dead_mark :: sema_check_context_mark(&context)
            // A dead last line is checked for its own diagnostics, never as the
            // value the function hands back.
            context.value_tail_span = None
            dead_result :: sema_check_statements([Stmt]{statement}, return_type, environment, &scopes, &dead_state, &tail_store, &context, &diagnostics, loop_depth)
            if !dead_result.complete -> complete = false
            dead_edges := [String]{}
            loop edge_index in dead_mark.failure_edges..<context.failure_edges.len() -> &dead_edges.push(context.failure_edges[edge_index])
            dead_direct_source :: context.failure_direct_source
            dead_members := [Type]{}
            loop member_index in dead_mark.failure_union_members..<context.failure_union_members.len() -> &dead_members.push(context.failure_union_members[member_index])
            dead_cases := [SemaFailureCase]{}
            loop case_index in dead_mark.failure_union_cases..<context.failure_union_cases.len() -> &dead_cases.push(context.failure_union_cases[case_index])
            dead_union_edges := [String]{}
            loop union_edge_index in dead_mark.failure_union_edges..<context.failure_union_edges.len() -> &dead_union_edges.push(context.failure_union_edges[union_edge_index])
            dead_general :: context.failure_union_general
            sema_check_context_rollback(&context, dead_mark)
            sema_scope_rollback(&scopes, dead_scope_mark)
            // #3708: dead source still counts toward the body's failure rows.
            loop edge in dead_edges -> &context.failure_edges.push(edge)
            if dead_direct_source -> context.failure_direct_source = true
            // D-FAIL-INFER-UNION1=A: so does a dead failure on the default route.
            loop member in dead_members -> &context.failure_union_members.push(member)
            loop failure_case in dead_cases -> &context.failure_union_cases.push(failure_case)
            loop union_edge in dead_union_edges -> &context.failure_union_edges.push(union_edge)
            context.failure_union_general = dead_general
            index += 1
            next
        }
        sema_pin_release_dead(&state, statement, scopes, &tail_store, &context)
        output_start := output.len()
        // #3708: these statements own a failure route of their own (task
        // groups, transactions, reactive scopes, generators, deferred closes).
        if statement == {
            .TaskGroup(_, _, _, _, _) | .Transact(_, _, _, _, _) | .Live(_, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .Yield(_, _) | .DeferClose(_, _) -> context.failure_direct_source = true
            else -> {}
        }
        // #3886 (D-DISCARD1=A): the reachable last line of a function with a
        // written value return is the value it hands back, checked like `return`.
        if index + 1 == statements.len() && statement == .Expr(tail) && context.value_tail_span == (Val(expr_span(tail))) && !sema_stmt_refutable_expr_diverges(tail) {
            returned :: sema_stmt_check_returned_value(tail, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            if returned == {
                .Val(value) -> &output.push(TStmt.Return{value: Val(value), span: expr_span(tail)})
                .None -> complete = false
            }
            index += 1
            next
        }
        if statement == {
            .Expr(expr) -> {
                // D-IGNORERET2=A: `.drop("reason")` is the explicit-discard
                // terminal; it checks its receiver without propagation.
                dropped :: sema_stmt_check_drop(expr, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                if dropped.handled {
                    if dropped.value == {
                        .Val(statement_value) -> &output.push(statement_value)
                        .None -> complete = false
                    }
                }
                if !dropped.handled {
                    if expr == {
                        .If(_, _, _, _, _, _) -> {
                            checked :: sema_stmt_check_unit_if(expr, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
                            if {
                                !checked.complete || checked.value.len() == 0 -> complete = false
                                else -> {
                                    // A hoisted dispatch subject's binding precedes the chain.
                                    conditions :: sema_coverage_noelse_statement_conditions(expr, checked.value[checked.value.len() - 1])
                                    if conditions == .Val(table) -> sema_coverage_check_table(table, false, expr_span(expr), environment, &diagnostics)
                                    // L0303 (#3716): a table whose arms cover a closed set has an `else` that can never run.
                                    if sema_coverage_is_else_table(environment, expr_span(expr)) -> sema_coverage_check_redundant_else(sema_coverage_else_statement_conditions(expr, checked.value[checked.value.len() - 1]), expr_span(expr), environment, &diagnostics)
                                    loop checked_statement in checked.value -> &output.push(checked_statement)
                                }
                            }
                        }
                        else -> {
                            discard_fact_start :: context.call_facts.len()
                            discard_diagnostic_start :: diagnostics.len()
                            value :: sema_check_expression(expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                            if {
                                value != None -> {
                                    checked :: value
                                    // D-MUSTUSE1 (E0419): a `#MustUse` result dropped here.
                                    if !sema_stmt_type_is_fallible(checked.ty) -> sema_must_use_check_statement(expr, checked.ty, expr_span(expr), environment, scopes, &diagnostics)
                                    if {
                                        sema_stmt_type_is_unit_success(checked.ty) -> &output.push(TStmt.ExprStmt{value: checked, span: expr_span(expr)})
                                        sema_stmt_type_is_fallible(checked.ty) -> {
                                            // D-IGNORERET2: a failure that survives to statement
                                            // position (a non-propagating carrier) must be handled.
                                            &diagnostics.push(sema_error("E0402", expr_span(expr), "this call can fail and nothing checks it", "a fallible result can't be ignored — handle it or say failure is impossible", "use `?`, `??`, `?? panic(...)`, or `.drop(\"reason\")` to intentionally discard"))
                                            complete = false
                                        }
                                        else -> {
                                            // D-DISCARD1=A: the last line of a function with no
                                            // written return type; its value goes nowhere.
                                            lost_tail :: context.lost_tail_span == (Val(expr_span(expr)))
                                            if {
                                                lost_tail -> {
                                                    if diagnostics.len() == discard_diagnostic_start -> &diagnostics.push(sema_stmt_lost_tail_diagnostic(context.function_name, type_name(checked.ty), expr_span(expr)))
                                                }
                                                else -> sema_stmt_mark_discarded_result(checked, discard_fact_start, &context)
                                            }
                                            complete = false
                                        }
                                    }
                                }
                                else -> complete = false
                            }
                        }
                    }
                }
            }
            .DeferClose(close, span) -> {
                checked := sema_stmt_check_defer_close(close, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                if checked == {
                    .Val(checked_statement) -> &output.push(checked_statement)
                    .None -> complete = false
                }
            }
            .Switch(subject, arms, else_body, span) -> {
                exit_guard :: if index + 1 < statements.len() -> sema_stmt_optional_exit_guard_name(subject, arms, else_body, span, scopes) else -> None
                if exit_guard == {
                    .Val(guarded_name) -> {
                        refined :: sema_stmt_check_optional_refinement(guarded_name, OrFallback.Block{body: arms[0].body, value: None, span: span}, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                        if refined == {
                            .Val(refined_statement) -> &output.push(refined_statement)
                            .None -> complete = false
                        }
                    }
                    .None -> {
                        // Rust `check_switch`: a guard table that ends a value
                        // block with no `else` can skip every arm (E0114).
                        value_guard :: index + 1 == statements.len() && context.value_tail_span == (Val(span)) && else_body == None && sema_stmt_refutable_is_subjectless_guard(subject, span)
                        checked :: sema_stmt_check_switch(subject, arms, else_body, span, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
                        if value_guard {
                            &diagnostics.push(sema_stmt_missing_value(return_type, sema_stmt_uncovered_guard_path(statements), context.function_name, span))
                            complete = false
                        }
                        if {
                            !checked.complete -> complete = false
                            else -> loop checked_statement in checked.value -> &output.push(checked_statement)
                        }
                    }
                }
            }
            .Val(binding) -> {
                updated_binding := binding
                lambda_escapes := context.lambda_escapes
                if updated_binding.init == {
                    .Lambda(_) -> lambda_escapes = sema_expression_lambda_bound_escapes(updated_binding, statements, index + 1, &tail_store, environment, &scopes, &state, &context, &diagnostics)
                    else -> {}
                }
                checked :: sema_stmt_check_binding(updated_binding, lambda_escapes, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                if checked == {
                    .Val(value) -> &output.push(value)
                    .None -> complete = false
                }
            }
            .Assign(target, op, op_span, expr) -> {
                checked :: sema_stmt_check_assignment(target, op, op_span, expr, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                if checked == {
                    .Val(value) -> &output.push(value)
                    .None -> complete = false
                }
            }
            .Return(value, span) -> {
                source := value ?? Expr.Unit{span: span}
                if {
                    sema_stmt_generator_return_rejected(value, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics) -> complete = false
                    sema_stmt_never_return_rejected(value, return_type, context.function_name, span, &diagnostics) -> complete = false
                    value == None -> {
                        if !sema_stmt_return_allows_empty(return_type) {
                            required :: sema_stmt_return_required_type(return_type)
                            &diagnostics.push(sema_type_mismatch(required, Type.Named{name: "Unit"}, span))
                            complete = false
                        }
                        &output.push(TStmt.Return{value: None, span: span})
                    }
                    else -> {
                        checked :: sema_stmt_check_returned_value(source, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                        if {
                            checked == None -> {
                                complete = false
                            }
                            else -> {
                                &output.push(TStmt.Return{value: checked, span: span})
                            }
                        }
                    }
                }
            }
            .For(var, var_span, var2, kind, body, span, arrow_body, label, _) -> {
                if kind == {
                    .Range(start_expr, end_expr, step_expr, exclusive) -> {
                        start_value := sema_stmt_check_range_endpoint(start_expr, "start", environment, &scopes, &state, &tail_store, &context, &diagnostics)
                        end_value := sema_stmt_check_range_endpoint(end_expr, "end", environment, &scopes, &state, &tail_store, &context, &diagnostics)
                        step_value := TExpr?{None}
                        if step_expr != None {
                            stride :: step_expr
                            step_value = sema_stmt_check_range_stride(stride, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                        }
                        // Rust `check_stmt` (statements.rs:2467-2589): an arrow
                        // body is only the body's spelling, and a second loop
                        // name is not declared for a range.
                        valid := start_value != None && end_value != None
                        if step_expr != None && step_value == None -> valid = false
                        range_var_type := Type.Int
                        if start_value == {
                            .Val(value) -> range_var_type = value.ty
                            .None -> {}
                        }

                        before := sema_ownership_state_snapshot(state)
                        sema_scope_enter(&scopes, &state, "for@{span.start}")
                        label_name := String?{None}
                        if label != None {
                            named :: label
                            label_name = Val(named.name)
                            if !sema_scope_push_loop_label(&scopes, named.name) -> valid = false
                        }
                        module_name := environment.module_identity
                        owner := sema_scope_local_owner_key(scopes)
                        symbol := Symbol{
                            id: symbol_id(SymbolKind.Local, module_name, owner, var),
                            kind: SymbolKind.Local,
                            name: var,
                            module_name: module_name,
                            owner: Val(owner),
                            span: var_span,
                            ty: Val(range_var_type),
                            visibility: 0,
                        }
                        if {
                            !sema_scope_declare_local(&scopes, symbol, false, AccessConvention.Read, None, false) -> {
                                &diagnostics.push(sema_already_defined(var, var_span))
                                valid = false
                            }
                            else -> {
                                sema_ownership_declare_binding(&state, symbol, false)
                            }
                        }
                        loop_frame_index := context.loop_value_frames.len()
                        sema_loop_value_push_frame(&context, label_name)
                        previous_arrow_loop_body := context.arrow_loop_body
                        context.arrow_loop_body = arrow_body
                        nested := sema_check_statements(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth + 1)
                        if !nested.complete -> valid = false
                        context.arrow_loop_body = previous_arrow_loop_body
                        // D-RANGE-EXCL1=C (E0364): inclusive `0..xs.len()` whose body
                        // indexes that same `xs` with this loop's index name.
                        if !exclusive && sema_stmt_range_end_len_root(end_expr) == .Val(len_root) && sema_stmt_index_root_with_stmts(body, len_root, var) {
                            &diagnostics.push(sema_error("E0364", expr_span(end_expr), "this range includes `{len_root}.len()`, one past the last index", "`{len_root}.len()` is the count of items, so inclusive `..` runs one step too far when the body indexes `{len_root}`", "write `loop (i, item) in {len_root}` — or `loop i in {len_root}.indexes` — or `0..<{len_root}.len()`"))
                        }
                        if label != None -> sema_scope_pop_loop_label(&scopes)
                        sema_single_use_leave_scope(&scopes, &state, &diagnostics)
                        body_state := sema_ownership_state_snapshot(state)
                        if !sema_stmt_close_loop_value_frame(&context, loop_frame_index, &nested.value, &state, before, body_state, true, environment, &diagnostics) -> valid = false
                        if {
                            !valid -> complete = false
                            else -> {
                                start_tir :: start_value ?? {
                                    sema_stmt_leave_statements(&context, tail_frame_depth, entered_nesting)
                                    sema_stmt_restore_statement_scopes(&scopes, previous_return_type, previous_failure_carrier, previous_loop_depth)
                                    return SemaStatementResult{value: output, complete: false}
                                }
                                end_tir :: end_value ?? {
                                    sema_stmt_leave_statements(&context, tail_frame_depth, entered_nesting)
                                    sema_stmt_restore_statement_scopes(&scopes, previous_return_type, previous_failure_carrier, previous_loop_depth)
                                    return SemaStatementResult{value: output, complete: false}
                                }
                                local :: tir_symbol_local(var, var_span, symbol.id)
                                &output.push(TStmt.ForRange{label: label_name, local: local, start: start_tir, end: end_tir, step: step_value, exclusive: exclusive, body: nested.value, vectorization: None, span: span})
                            }
                        }
                    }
                    .In(collection_expr, step_expr) -> {
                        collection_value := sema_check_expression(collection_expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                        collection :: collection_value ?? sema_tir_expr(Type.Named{name: "Unit"}, TExprKind.Unit, expr_span(collection_expr))
                        step_value := TExpr?{None}
                        if step_expr != None {
                            stride :: step_expr
                            step_value = sema_stmt_check_source_stride(stride, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                        }
                        valid := collection_value != None
                        if step_expr != None && step_value == None -> valid = false
                        range_source := sema_stmt_for_in_is_range(collection.ty)
                        method_kind := sema_stmt_for_in_method_kind(collection_expr, collection)
                        iterable_item_type := Type?{None}
                        if method_kind == None && !range_source {
                            iterable := sema_stmt_for_in_iterable_fact(environment, collection.ty)
                            if iterable != None {
                                fact :: iterable ?? SemaForInIterableFact{method_kind: TForInMethod.Chars, item_type: Type.Named{name: "Unit"}}
                                method_kind = Val(fact.method_kind)
                                iterable_item_type = Val(fact.item_type)
                            }
                        }
                        item_type_option := sema_stmt_for_in_item_type(collection.ty, method_kind, iterable_item_type)
                        item_type := item_type_option ?? Type.Named{name: "Unit"}
                        // A source that failed its own check already reported why;
                        // its placeholder type is not a second loop-source error.
                        if item_type_option == None && collection_value != None {
                            &diagnostics.push(sema_error("E0109", expr_span(collection_expr), "values of type {type_name(collection.ty)} can't be used as a loop source", "a `for` source must provide one checked item type per step", "use a list, map, stream, iterator, reader, or registered Iterable value"))
                            valid = false
                        }
                        pair_types := sema_stmt_for_in_pair_types(collection.ty, item_type)
                        if var2 != None && collection_value != None {
                            if {
                                range_source -> {
                                    &diagnostics.push(sema_error("E0109", expr_span(collection_expr), "a Range loop has one value per step", "Range values yield whole numbers, not key-value pairs", "use one loop name"))
                                    valid = false
                                }
                                !sema_stmt_for_in_method_pair_is_supported(method_kind) || pair_types == None -> {
                                    &diagnostics.push(sema_error("E0109", expr_span(collection_expr), "`loop (x, y) in` on `{type_name(collection.ty)}` needs one loop name, not two", "this iterator yields one item per step; only maps and indexed sequences yield a pair", "use one loop name for this source"))
                                    valid = false
                                }
                            }
                        }
                        consumes_collection := sema_stmt_for_in_consumes_collection(collection.ty, item_type)
                        owns_collection := !consumes_collection || sema_stmt_for_in_can_consume_collection(collection_expr)
                        if !owns_collection {
                            &diagnostics.push(sema_error("E0120", expr_span(collection_expr), "this loop can't take a stream or iterator out of a field or index", "each step pulls from the source itself, so the loop must take a whole value this scope owns", "bind it into a local this scope owns first, then loop over that local"))
                            valid = false
                        }
                        before := sema_ownership_state_snapshot(state)
                        sema_scope_enter(&scopes, &state, "for.in@{span.start}")
                        label_name := String?{None}
                        if label != None {
                            named :: label
                            label_name = Val(named.name)
                            if !sema_scope_push_loop_label(&scopes, named.name) -> valid = false
                        }
                        first_type := item_type
                        second_type := Type?{None}
                        if var2 != None && pair_types != None {
                            pair :: pair_types ?? SemaForInPairTypes{first: item_type, second: item_type}
                            first_type = pair.first
                            second_type = Val(pair.second)
                        }
                        source_checked := collection_value != None
                        first_local_type := Type?{None}
                        second_local_type := Type?{None}
                        if source_checked {
                            first_local_type = Val(first_type)
                            second_local_type = Val(second_type ?? item_type)
                        }
                        first_local :: sema_stmt_for_in_decl_loop_local(var, var_span, first_local_type, environment, &scopes, &state, &diagnostics)
                        if first_local == None -> valid = false
                        variable_two := TLocal?{None}
                        if var2 != None && (second_type != None || !source_checked) {
                            second_name :: var2
                            variable_two = sema_stmt_for_in_decl_loop_local(second_name.name, second_name.span, second_local_type, environment, &scopes, &state, &diagnostics)
                            if variable_two == None -> valid = false
                        }
                        loop_frame_index := context.loop_value_frames.len()
                        sema_loop_value_push_frame(&context, label_name)
                        previous_arrow_loop_body := context.arrow_loop_body
                        context.arrow_loop_body = arrow_body
                        iter_borrowed_depth := context.iter_borrowed.len()
                        if sema_stmt_for_in_driven_root(collection_expr) == .Val(driven) -> &context.iter_borrowed.push(driven)
                        nested := sema_check_statements(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth + 1)
                        loop context.iter_borrowed.len() > iter_borrowed_depth -> _ := &context.iter_borrowed.pop()
                        context.arrow_loop_body = previous_arrow_loop_body
                        if !nested.complete -> valid = false
                        if label != None -> sema_scope_pop_loop_label(&scopes)
                        sema_single_use_leave_scope(&scopes, &state, &diagnostics)
                        body_state := sema_ownership_state_snapshot(state)
                        if !sema_stmt_close_loop_value_frame(&context, loop_frame_index, &nested.value, &state, before, body_state, true, environment, &diagnostics) -> valid = false
                        if consumes_collection && owns_collection {
                            if collection_expr == {
                                .Ident(_, _) -> {
                                    if !sema_ownership_mark_move(&state, collection_expr, scopes, "`.loop()`", &diagnostics) -> valid = false
                                }
                                else -> {}
                            }
                        }
                        if {
                            !valid -> complete = false
                            else -> {
                                variable :: first_local ?? panic("checked loop name has no declared local")
                                if {
                                    range_source -> {
                                        zero_start := sema_stmt_for_in_range_zero(span)
                                        zero_end := sema_stmt_for_in_range_zero(span)
                                        &output.push(TStmt.Range{label: label_name, variable: variable, source: Val(collection), start: zero_start, end: zero_end, step: step_value, exclusive: false, vectorization: None, body: nested.value, span: span})
                                    }
                                    else -> {
                                        source_value := sema_stmt_for_in_source(collection_expr, collection, method_kind)
                                        columnar := var2 == None && method_kind == None && sema_stmt_for_in_columnar_list_type(collection.ty) && sema_stmt_for_in_columnar(environment, item_type)
                                        by_value := sema_stmt_for_in_by_value(collection.ty, item_type)
                                        &output.push(TStmt.ForIn{label: label_name, variable: variable, variable_two: variable_two, source: source_value, collection: collection, step: step_value, method_kind: method_kind, columnar: columnar, by_value: by_value, body: nested.value, span: span})
                                    }
                                }
                            }
                        }
                    }
                    else -> complete = false
                }
            }
            .CountedLoop(init, cond, step, body, span, arrow_body, label) -> {
                init_lambda_escapes :: ~context.lambda_escapes
                sema_scope_enter(&scopes, &state, "counted@{span.start}")
                loop_scope_valid := true
                label_name := String?{None}
                if label != None {
                    named :: label
                    label_name = Val(named.name)
                    if !sema_scope_push_loop_label(&scopes, named.name) -> loop_scope_valid = false
                }
                init_tir := sema_stmt_check_binding(init, init_lambda_escapes, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                cond_tir := sema_check_expression(cond, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                cond_valid := cond_tir != None
                if cond_tir != None && (cond_tir ?? sema_tir_expr(Type.Bool, TExprKind.BoolLit{value: false}, span)).ty != Type.Bool {
                    cond_ty :: (cond_tir ?? sema_tir_expr(Type.Bool, TExprKind.BoolLit{value: false}, span)).ty
                    &diagnostics.push(sema_error("E0110", span, "the counted loop condition must be Bool, but this is {type_name(cond_ty)}", "the program needs a clear yes or no here", "compare the value to produce Bool"))
                    cond_valid = false
                }
                before_iteration := sema_ownership_state_snapshot(state)
                loop_frame_index := context.loop_value_frames.len()
                sema_loop_value_push_frame(&context, label_name)
                previous_arrow_loop_body := context.arrow_loop_body
                context.arrow_loop_body = arrow_body
                nested := sema_stmt_check_block(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, "counted.body@{span.start}", loop_depth + 1)
                context.arrow_loop_body = previous_arrow_loop_body
                step_tir := TStmt?{None}
                step_valid := true
                if step != None {
                    step_stmt :: step
                    checked_step :: sema_stmt_check_loop_step(step_stmt, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                    if checked_step == None -> step_valid = false else -> step_tir = checked_step
                }
                if label != None -> sema_scope_pop_loop_label(&scopes)
                sema_single_use_leave_scope(&scopes, &state, &diagnostics)
                body_state := sema_ownership_state_snapshot(state)
                before_outer := sema_ownership_state_snapshot(before_iteration)
                sema_ownership_leave_scope(&before_outer)
                if !sema_stmt_close_loop_value_frame(&context, loop_frame_index, &nested.value, &state, before_outer, body_state, true, environment, &diagnostics) -> loop_scope_valid = false
                if {
                    init_tir == None || !cond_valid || !nested.complete || !step_valid || !loop_scope_valid -> complete = false
                    else -> {
                        init_value :: init_tir ?? {
                            sema_stmt_leave_statements(&context, tail_frame_depth, entered_nesting)
                            sema_stmt_restore_statement_scopes(&scopes, previous_return_type, previous_failure_carrier, previous_loop_depth)
                            return SemaStatementResult{value: output, complete: false}
                        }
                        cond_value :: cond_tir ?? {
                            sema_stmt_leave_statements(&context, tail_frame_depth, entered_nesting)
                            sema_stmt_restore_statement_scopes(&scopes, previous_return_type, previous_failure_carrier, previous_loop_depth)
                            return SemaStatementResult{value: output, complete: false}
                        }
                        &output.push(TStmt.CountedLoop{label: label_name, init: init_value, condition: cond_value, step: step_tir, vectorization: None, body: nested.value, span: span})
                    }
                }
            }
            .While(condition, body, span, arrow_body, label) -> {
                cond :: sema_check_expression(condition, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                if {
                    cond == None -> {
                        complete = false
                    }
                    (cond ?? sema_tir_expr(Type.Bool, TExprKind.BoolLit{value: false}, span)).ty != Type.Bool -> {
                        cond_ty :: (cond ?? sema_tir_expr(Type.Bool, TExprKind.BoolLit{value: false}, span)).ty
                        &diagnostics.push(sema_error("E0110", span, "the while condition must be Bool, but this is {type_name(cond_ty)}", "the program needs a clear yes or no here", "compare the value to produce Bool"))
                        complete = false
                    }
                    else -> {
                        before := sema_ownership_state_snapshot(state)
                        loop_scope_valid := true
                        sema_scope_enter(&scopes, &state, "while@{span.start}")
                        label_name := String?{None}
                        if label != None {
                            named :: label
                            label_name = Val(named.name)
                            if !sema_scope_push_loop_label(&scopes, named.name) -> loop_scope_valid = false
                        }
                        loop_frame_index := context.loop_value_frames.len()
                        sema_loop_value_push_frame(&context, label_name)
                        previous_arrow_loop_body := context.arrow_loop_body
                        context.arrow_loop_body = arrow_body
                        nested := sema_stmt_check_block(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, "while.body@{span.start}", loop_depth + 1)
                        context.arrow_loop_body = previous_arrow_loop_body
                        if label != None -> sema_scope_pop_loop_label(&scopes)
                        sema_single_use_leave_scope(&scopes, &state, &diagnostics)
                        body_state := sema_ownership_state_snapshot(state)
                        // Rust `check_stmt` (statements.rs:233-266): a literal
                        // `true` condition never skips the body, as `loop`.
                        if !sema_stmt_close_loop_value_frame(&context, loop_frame_index, &nested.value, &state, before, body_state, !sema_stmt_refutable_expr_is_true(condition), environment, &diagnostics) -> loop_scope_valid = false
                        if {
                            !nested.complete || !loop_scope_valid -> complete = false
                            else -> &output.push(TStmt.While{label: label_name, condition: cond, body: nested.value, span: span})
                        }
                    }
                }
            }
            .Loop(body, span, arrow_body, label) -> {
                before := sema_ownership_state_snapshot(state)
                sema_scope_enter(&scopes, &state, "loop@{span.start}")
                label_name := String?{None}
                label_valid := true
                if label != None {
                    named :: label
                    label_name = Val(named.name)
                    if !sema_scope_push_loop_label(&scopes, named.name) -> label_valid = false
                }
                loop_frame_index := context.loop_value_frames.len()
                sema_loop_value_push_frame(&context, label_name)
                previous_arrow_loop_body := context.arrow_loop_body
                context.arrow_loop_body = arrow_body
                nested := sema_stmt_check_block(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, "loop.body@{span.start}", loop_depth + 1)
                context.arrow_loop_body = previous_arrow_loop_body
                if label != None -> sema_scope_pop_loop_label(&scopes)
                sema_single_use_leave_scope(&scopes, &state, &diagnostics)
                body_state := sema_ownership_state_snapshot(state)
                if !sema_stmt_close_loop_value_frame(&context, loop_frame_index, &nested.value, &state, before, body_state, false, environment, &diagnostics) -> label_valid = false
                if {
                    !nested.complete || !label_valid -> complete = false
                    else -> &output.push(TStmt.Loop{label: label_name, body: nested.value, span: span})
                }
            }
            .Break(span) -> {
                frame_index :: sema_loop_value_resolve_frame(context, None) ?? {
                    &diagnostics.push(sema_error("E0115", span, "`break` only works inside a loop", "`break` and `next` steer the nearest loop", "move this inside a loop, or remove it"))
                    complete = false
                    next
                }
                frame :: context.loop_value_frames[frame_index]
                if {
                    !sema_stmt_loop_value_break_missing_payload(frame, span, &diagnostics) -> {
                        complete = false
                    }
                    else -> {
                        sema_loop_value_record_break(&context, frame_index, state)
                        &output.push(TStmt.Break{label: None, span: span})
                    }
                }
            }
            .BreakValue(value, span) -> {
                checked :: sema_stmt_check_loop_value_break(value, None, span, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                if checked == {
                    .Val(checked_statement) -> &output.push(checked_statement)
                    else -> complete = false
                }
            }
            .Continue(span) -> {
                if {
                    loop_depth == 0 -> {
                        &diagnostics.push(sema_error("E0115", span, "`next` only works inside a loop", "`break` and `next` steer the nearest loop", "move this inside a loop, or remove it"))
                        complete = false
                    }
                    else -> {
                        &output.push(TStmt.Continue{label: None, span: span})
                    }
                }
            }
            .BreakLabel(name, span) -> {
                if {
                    !sema_scope_has_loop_label(scopes, name) -> {
                        &diagnostics.push(sema_stmt_unknown_loop_label(name, span))
                        complete = false
                    }
                    else -> {
                        frame_index :: sema_loop_value_resolve_frame(context, Val(name)) ?? {
                            &diagnostics.push(sema_stmt_unknown_loop_label(name, span))
                            complete = false
                            next
                        }
                        frame :: context.loop_value_frames[frame_index]
                        if {
                            !sema_stmt_loop_value_break_missing_payload(frame, span, &diagnostics) -> {
                                complete = false
                            }
                            else -> {
                                sema_loop_value_record_break(&context, frame_index, state)
                                &output.push(TStmt.Break{label: Val(name), span: span})
                            }
                        }
                    }
                }
            }
            .BreakLabelValue(name, name_span, value, span) -> {
                checked :: sema_stmt_check_loop_value_break(value, Val(name), name_span, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                if checked == {
                    .Val(checked_statement) -> &output.push(checked_statement)
                    else -> complete = false
                }
            }
            .ContinueLabel(name, span) -> {
                if {
                    !sema_scope_has_loop_label(scopes, name) -> {
                        &diagnostics.push(sema_stmt_unknown_loop_label(name, span))
                        complete = false
                    }
                    else -> {
                        &output.push(TStmt.Continue{label: Val(name), span: span})
                    }
                }
            }
            .Yield(value, span) -> {
                checked :: sema_stmt_check_yield(value, span, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                if checked == {
                    .Val(checked_statement) -> &output.push(checked_statement)
                    else -> complete = false
                }
            }
            .Unsafe(audit, _, body, span) -> {
                if {
                    !sema_effect_check_unsafe_region(audit, span, &diagnostics) -> {
                        complete = false
                    }
                    else -> {
                        previous_unsafe_depth := context.unsafe_depth
                        context.unsafe_depth += 1
                        nested :: sema_stmt_check_block(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, "unsafe@{span.start}", loop_depth)
                        context.unsafe_depth = previous_unsafe_depth
                        source_file := sema_source_file_at(environment.source_segments, environment.source_file, environment.source_origin, span)
                        source_line := sema_source_line_at(environment.source_segments, span)
                        if {
                            !nested.complete || source_file == "" || source_line == None -> {
                                complete = false
                            }
                            else -> {
                                line :: source_line ?? 0
                                gate :: TUnsafeGate{file: source_file, line: line, reason: audit ?? "", enabled: true, fenced: false}
                                &output.push(TStmt.UnsafeBlock{gate: gate, body: nested.value, span: span})
                            }
                        }
                    }
                }
            }
            .Impure(reason, _, body, span) -> {
                if reason == None {
                    &diagnostics.push(sema_lint("L3102", span, "this `#Impure` block has no reason", "every comptime effect gate records why ambient I/O is needed", "add the reason: `#Impure(\"reading build config\") {{ … }}`"))
                }
                nested :: sema_stmt_check_block(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, "impure@{span.start}", loop_depth)
                if {
                    !nested.complete -> {
                        complete = false
                    }
                    else -> {
                        &output.push(TStmt.Impure{body: nested.value, span: span})
                    }
                }
            }
            .Reactive(body, span) -> {
                checked := sema_stmt_check_reactive(body, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                if checked == {
                    .Val(value) -> &output.push(TStmt.Reactive{executable: value, span: span})
                    .None -> complete = false
                }
            }
            .Shield(body, span) -> {
                nested :: sema_stmt_check_block(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, "shield@{span.start}", loop_depth)
                if {
                    !nested.complete -> {
                        complete = false
                    }
                    else -> {
                        &output.push(TStmt.Shield{body: nested.value, span: span})
                    }
                }
            }
            .Region(_, _, body, span) -> {
                nested :: sema_stmt_check_block(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, "region@{span.start}", loop_depth)
                if {
                    !nested.complete -> {
                        complete = false
                    }
                    else -> {
                        &output.push(TStmt.Region{body: nested.value, span: span})
                    }
                }
            }
            .ScopeMember(name, _, args, args_span, body, dsl, _, span) -> {
                checked := sema_stmt_check_scope_member(name, args, args_span, body, dsl, span, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
                // Rust validates a declared text block's body by running its
                // checked-text rule (`Bundle/Pipeline` declared text blocks);
                // this checker does not run that validation yet.
                if dsl {
                    complete = false
                    sema_check_unsupported(&context, "the checked text block `#{name}` is not validated by the self-hosted checker yet")
                }
                if checked == {
                    .Val(value) -> &output.push(value)
                    .None -> complete = false
                }
            }
            .Switched(marker, body, span) -> {
                if {
                    marker.name == "Off" || marker.name == "DebugOnly" -> {
                        erased_scope_mark :: sema_scope_mark(&scopes)
                        erased_state := sema_ownership_state_snapshot(state)
                        erased_mark :: sema_check_context_mark(&context)
                        checked :: sema_check_statements(body, return_type, environment, &scopes, &erased_state, &tail_store, &context, &diagnostics, loop_depth)
                        erased_reasons := [String]{}
                        loop reason_index in erased_mark.incomplete_reasons..<context.incomplete_reasons.len() -> &erased_reasons.push(context.incomplete_reasons[reason_index])
                        sema_check_context_rollback(&context, erased_mark)
                        sema_scope_rollback(&scopes, erased_scope_mark)
                        if {
                            !checked.complete -> {
                                complete = false
                                loop reason in erased_reasons -> sema_check_unsupported(&context, reason)
                            }
                            marker.name == "DebugOnly" -> {
                                &output.push(TStmt.DebugOnly{body: checked.value, span: span})
                            }
                        }
                    }
                    // Rust checks any other switched marker's body as a plain
                    // block (`Stmt::Switched` fallback).
                    else -> {
                        nested :: sema_stmt_check_block(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, "switched@{span.start}", loop_depth)
                        if {
                            !nested.complete -> complete = false
                            else -> &output.push(TStmt.Region{body: nested.value, span: span})
                        }
                    }
                }
            }
            .Transact(name, name_span, body, implicit, span) -> {
                checked :: sema_stmt_check_transaction(name, name_span, body, implicit, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                if checked == {
                    .Val(value) -> &output.push(value)
                    .None -> complete = false
                }
            }
            .Policy(declarations, body, span) -> {
                previous_unit_policy := sema_scope_push_unit_policy(&scopes, declarations)
                previous_copies_policy := sema_string_view_push_copies_policy(&scopes, declarations)
                nested :: sema_stmt_check_block(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, "policy@{span.start}", loop_depth)
                sema_scope_pop_unit_policy(&scopes, previous_unit_policy)
                scopes.copies_explicit = previous_copies_policy
                if {
                    !nested.complete -> {
                        complete = false
                    }
                    else -> {
                        loop checked_statement in nested.value {
                            &output.push(checked_statement)
                        }
                    }
                }
            }
            .AuthorityScope(caps, _, binding, body, span) -> {
                // D-EFF1 (Rust `Stmt::AuthorityScope`): the body is a lexical
                // block; a named head binds the scoped `Authority` handle. The
                // cap subset check (E0712) runs over the lowered region in the
                // effect pass.
                sema_scope_enter(&scopes, &state, "fx@{span.start}")
                region_body := [TStmt]{}
                if binding == .Val(handle) {
                    owner := sema_scope_local_owner_key(scopes)
                    id := symbol_id(SymbolKind.Local, environment.module_identity, owner, handle.name)
                    symbol := Symbol{id: id, kind: SymbolKind.Local, name: handle.name, module_name: environment.module_identity, owner: Val(owner), span: handle.span, ty: Val(Type.Named{name: "Authority"}), visibility: 0}
                    if {
                        sema_scope_declare_local(&scopes, symbol, false, AccessConvention.Read, None, false) -> {
                            sema_ownership_declare_binding(&state, symbol, false)
                            // D-AUTHORITY-NAME1: a used handle is an ordinary runtime
                            // `Authority` built from the resolved cap list.
                            if sema_ownership_last_use_statements(body, handle.name) {
                                rights :: (loop cap in caps -> TComptimeValue.String{value: cap.name})
                                rights_value :: sema_tir_expr(Type.List{element: Type.String}, TExprKind.CtLit{value: TComptimeValue.List{values: rights}}, handle.span)
                                reference :: TMethodRef{symbol: symbol_id(SymbolKind.Function, "", "JetAuthority", "from_rights"), name: "from_rights", mangled: false, trait_owner: None, operator_identity: None}
                                // Building the handle is effect-free; record the known-pure site so
                                // the effect pass does not treat it as an unknown call.
                                _ := sema_effect_record_intrinsic_effects(environment, &scopes, &context, "Authority.from_rights", handle.span, [EffectRowEntry]{}, &diagnostics)
                                rights_arg :: TCallArg{value: rights_value, template_items: [SymbolID]{}, borrow: false, mut_borrow: false, clone: false, arc_clone: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false}
                                init :: sema_tir_expr(Type.Named{name: "Authority"}, TExprKind.StaticCall{owner: TStaticOwner.Prelude{rooted: true, path: "JetAuthority", generics: [TPreludeArg]{}}, owner_type: None, method: reference, type_args: [Type]{}, args: [TCallArg]{rights_arg}}, handle.span)
                                &region_body.push(TStmt.Let{local: tir_symbol_local(handle.name, handle.span, symbol.id), let_ty: TLetTy.Annotated{ty: Type.Named{name: "Authority"}, wrapper: TLetWrapper.Plain}, init: init, gc_promotion: None, gc_transferred: false, span: handle.span})
                            }
                        }
                        else -> {
                            &diagnostics.push(sema_already_defined(handle.name, handle.span))
                            complete = false
                        }
                    }
                }
                nested :: sema_check_statements(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
                sema_single_use_leave_scope(&scopes, &state, &diagnostics)
                if {
                    !nested.complete -> {
                        complete = false
                    }
                    else -> {
                        loop checked_statement in nested.value {
                            &region_body.push(checked_statement)
                        }
                        &output.push(TStmt.Region{body: region_body, span: span})
                    }
                }
            }
            .TaskGroup(name, name_span, limit, body, span) -> {
                checked := sema_taskgroup_check_statement(name, name_span, limit, body, span, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
                if checked == {
                    .Val(value) -> &output.push(value)
                    .None -> complete = false
                }
            }
            .ComptimeIf(_, _, _, _, span, _) | .ComptimeSwitch(_, _, _, span) | .ComptimeBlock(_, _, span) -> {
                complete = false
                sema_check_unsupported(&context, "the statement-level `prep` form at offset {span.start} is not executed by the self-hosted checker yet")
            }
            .Layout(_, _, _, span) | .ContextBlock(_, _, span) | .Live(_, span) | .AssumeDet(_, _, _, span) -> {
                complete = false
                sema_check_unsupported(&context, "the {sema_stmt_scope_form_label(statement)} block at offset {span.start} is not supported by the self-hosted checker yet")
            }
        }
        if statement == {
            .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) -> reachable = false
            .Loop(body, _, _, _) -> {
                if !sema_stmt_refutable_loop_body_can_break(body) -> reachable = false
            }
            // Rust flow facts: a table whose every path leaves, or a literal
            // `true` loop that nothing breaks, ends the reachable path too.
            .Switch(_, _, _, _) | .While(_, _, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) -> {
                if sema_stmt_refutable_statement_exits(statement) -> reachable = false
            }
            .Impure(_, _, body, _) | .Shield(body, _) | .Region(_, _, body, _) | .AuthorityScope(_, _, _, body, _) -> {
                if sema_stmt_refutable_block_exits(body) -> reachable = false
            }
            .ScopeMember(name, _, _, _, body, _, _, _) -> {
                if name != "skip" && sema_stmt_refutable_block_exits(body) -> reachable = false
            }
            .Transact(_, _, body, _, _) | .Policy(_, body, _) -> {
                if sema_stmt_block_has_no_fallthrough(body) -> reachable = false
            }
            else -> {}
        }
        if output.len() > output_start {
            last :: output[output.len() - 1]
            if last == {
                .ExprStmt(value, _) -> {
                    if value.ty == (Type.Named{name: "Never"}) -> reachable = false
                }
                else -> {}
            }
        }
        index += 1
    }
    sema_stmt_leave_statements(&context, tail_frame_depth, entered_nesting)
    scopes.return_type = previous_return_type
    scopes.failure_carrier = previous_failure_carrier
    scopes.loop_depth = previous_loop_depth
    SemaStatementResult{value: output, complete: complete}
}
