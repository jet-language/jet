// D-COMPILE-SPEED1: active names bound recursive generic growth, finished
// instantiations make each structural query linear in its nominal graph.
use jet_foundation.[Type, type_name]
use jet_sema.[TypeRegistry]
use std.sync.[RwLock, PoisonError] // GATE #4494: native shared lock and poison recovery.

// Rust: crates/jet-sema/src/Sema/NominalWalk.rs:34
pub enum NominalQuery {
    Cloneable
    OwnsHeap
    Sendable(strict_callable: Bool, cell_only: Bool)
    ViewBoundary
    CellGuard
    SharedHandle
    ObservableClock
}
// Rust: crates/jet-sema/src/Sema/NominalWalk.rs:52
struct NominalMemo {
    neutral: [NominalQuery:[String:Bool]] // GATE #4499: exact enum equality/hash, no encoded key.
}
// Rust: crates/jet-sema/src/Sema/NominalWalk.rs:59
pub struct NominalMemoCell { lock: RwLock<NominalMemo?> }
impl NominalMemoCell {
    fn default() -> NominalMemoCell Never! { NominalMemoCell{lock: RwLock.new(None)} } // GATE #4494
}
// Rust: crates/jet-sema/src/Sema/NominalWalk.rs:62
impl NominalMemoCell.Clone {
    // Rust: crates/jet-sema/src/Sema/NominalWalk.rs:63
    fn clone(self) -> NominalMemoCell Never! { NominalMemoCell.default() }
}
// Rust: crates/jet-sema/src/Sema/NominalWalk.rs:68
pub struct NominalWalk {
    query: NominalQuery
    registry: @TypeRegistry
    active: [String:Bool]
    finished: [String:Bool]
}
// Rust: crates/jet-sema/src/Sema/NominalWalk.rs:78
impl NominalWalk {
    // Rust: crates/jet-sema/src/Sema/NominalWalk.rs:79
    pub fn new(query: NominalQuery, registry: @TypeRegistry) -> NominalWalk Never! {
        NominalWalk{query: query, registry: registry, active: [:], finished: [:]}
    }
    // Rust: crates/jet-sema/src/Sema/NominalWalk.rs:92
    pub fn enter(&self, name: String, args: [Type]) -> String? Never! {
        if self.active.has_key(name) -> return None
        key :: instantiation_key(name, args)
        if self.finished.has_key(key) || self.memo_holds(key) -> return None
        self.active[~name] = true
        Val(key)
    }
    // Rust: crates/jet-sema/src/Sema/NominalWalk.rs:104
    pub fn leave(&self, name: String, key: ^String) Never! {
        _ :: &self.active.remove(name)
        self.finished[^key] = true
    }
    // Rust: crates/jet-sema/src/Sema/NominalWalk.rs:111
    pub fn finish(^self, neutral: Bool) Never! {
        if !neutral || self.finished.is_empty() -> return
        self.registry.record_neutral_nominals(self.query, ^self.finished)
    }
    // Rust: crates/jet-sema/src/Sema/NominalWalk.rs:118
    fn memo_holds(self, key: String) -> Bool Never! { self.registry.nominal_memo_holds(self.query, key) }
}
// Rust: crates/jet-sema/src/Sema/NominalWalk.rs:123
fn instantiation_key(name: String, args: [Type]) -> String Never! {
    if args.is_empty() -> return ~name
    key := String.with_capacity(name.len() + 16 * args.len())
    &key.push_str(name)
    &key.push_str("<")
    loop index in 0..<args.len() {
        if index > 0 -> &key.push_str(", ")
        &key.push_str(type_name(args[index]))
    }
    &key.push_str(">")
    key
}
// Rust: crates/jet-sema/src/Sema/NominalWalk.rs:143
pub struct NominalMemoScope { registry: @TypeRegistry, opened: Bool }
// Rust: crates/jet-sema/src/Sema/NominalWalk.rs:148
impl TypeRegistry {
    // Rust: crates/jet-sema/src/Sema/NominalWalk.rs:152
    pub fn open_nominal_memo(self) -> NominalMemoScope Never! from self {
        // GATE #4494: the guard unlocks at scope exit, including poison recovery.
        memo := self.nominal_memo.lock.write().unwrap_or_else(PoisonError.into_inner)
        opened :: memo.deref() == None
        if opened -> memo.set(Val(NominalMemo{neutral: [:]}))
        NominalMemoScope{registry: @self, opened: opened}
    }
    // Rust: crates/jet-sema/src/Sema/NominalWalk.rs:169
    pub fn nominal_memo_holds(self, query: NominalQuery, key: String) -> Bool Never! {
        // GATE #4494
        guard :: self.nominal_memo.lock.read().unwrap_or_else(PoisonError.into_inner)
        if guard.deref() == .Val(memo) {
            if memo.neutral.get(query) == .Val(neutral) -> return neutral.has_key(key)
        }
        false
    }
    // Rust: crates/jet-sema/src/Sema/NominalWalk.rs:181
    pub fn record_neutral_nominals(self, query: NominalQuery, keys: ^[String:Bool]) Never! {
        // GATE #4494: mutate the protected map in place, never a guard snapshot.
        guard := self.nominal_memo.lock.write().unwrap_or_else(PoisonError.into_inner)
        if guard.deref_mut() == .Val(memo) {
            if !memo.neutral.has_key(query) -> memo.neutral[query] = [:]
            loop (key, _) in ^keys { memo.neutral[query][^key] = true }
        }
    }
}
// Rust: crates/jet-sema/src/Sema/NominalWalk.rs:198
impl NominalMemoScope.Drop {
    // Rust: crates/jet-sema/src/Sema/NominalWalk.rs:199
    fn drop(&self) Never! {
        if self.opened {
            // GATE #4494: nested scopes do not close their outer scope's memo.
            guard := self.registry.nominal_memo.lock.write().unwrap_or_else(PoisonError.into_inner)
            guard.set(None)
        }
    }
}
