// Typed pattern validation and canonical TIR conversion.
//
// Pattern checking deliberately consumes an already checked TExpr.  The
// expression checker owns subject inference; this file owns only pattern
// shape/type validation, recovery bindings, and TPattern construction.
use jet_foundation.[
    BinEndian,
    BinMatchPart,
    Diagnostic,
    Expr,
    ListPatRest,
    MapPatEntry,
    PatternTypeHead,
    TListPatternRest,
    PatSlot,
    Pattern,
    Span,
    StrMatchPart,
    StructPatField,
    SymbolID,
    TBinaryPatternPart,
    TPatternBindingFact,
    TPatternPosition,
    TTextPatternPart,
    TextEdit,
    Type,
    VariantField,
    VariantPayload,
    core_enum_payload_variants,
    measure_literal_value,
    core_enum_variant_payload,
    core_enum_variants,
    diagnostic_with_edit,
    diagnostic_with_source_derived_suggestion,
    type_identity_equal,
    type_name,
    type_union_member_tag,
]

struct SemaCheckedPattern {
    subject: TExpr
    pattern: TPattern
    bindings: [TPatternBindingFact]
}

// A failed pattern keeps the valid native recovery bindings for scope
// diagnostics, but never publishes a checked TPattern.  Callers own scope
// installation and branch lifetime.
struct SemaPatternCheck {
    complete: Bool
    checked: SemaCheckedPattern?
    bindings: [TPatternBindingFact]
}

struct SemaPatternPayload {
    types: [Type]
    owner: SymbolID?
    payload: VariantPayload?
    known: Bool
    group: Bool
    range_forbidden: Bool
}

struct SemaPatternValidation {
    shape: TPatternShape
    enum_type: SymbolID?
    bindings: [TPatternBindingFact]
    complete: Bool
}

fn sema_pattern_unwrap_tags(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(_, inner) -> sema_pattern_unwrap_tags(inner)
        else -> ty
    }
}

fn sema_pattern_span(pattern: Pattern) -> Span {
    if pattern == {
        .Variant(_, _, _, span) -> span
        .Present(_, _, _, span) -> span
        .Absent(span) -> span
        .Ok(_, _, _, span) -> span
        .Err(_, _, _, span) -> span
        .Range(_, _, span) -> span
        .Or(_, span) -> span
        .Struct(_, _, span, _) | .List(_, _, span) | .Map(_, _, span) -> span
        .StrMatch(_, span) -> span
        .BinMatch(_, span) -> span
    }
}

fn sema_pattern_nominal_type(ty: Type) -> Type? {
    if ty == {
        .Named(_) | .Apply(_, _) -> Val(ty)
        .Tagged(_, inner) -> sema_pattern_nominal_type(inner)
        else -> None
    }
}

fn sema_pattern_base_name(ty: Type) -> String? {
    if ty == {
        .Named(name) -> Val(name)
        .Apply(name, _) -> Val(name)
        .Tagged(_, inner) -> sema_pattern_base_name(inner)
        else -> None
    }
}

fn sema_pattern_subject_args(ty: Type) -> [Type] Never! {
    if ty == {
        .Apply(_, args) -> args
        .Tagged(_, inner) -> sema_pattern_subject_args(inner)
        else -> [Type]{}
    }
}

fn sema_pattern_nominal_row(graph: SemaRegistrationGraph, module_identity: String, ty: Type) -> SemaRegistrationRowRef? {
    sema_type_resolve_nominal_row(graph, sema_pattern_nominal_type(ty) ?? return None, module_identity)
}

// A variant's payload types for a subject of `subject_ty`. Each payload type is
// resolved in the enum's own module, where it is spelled (a binding in another
// package must not keep the declaring module's bare name), then takes the
// subject's generic arguments.
fn sema_pattern_variant_types(graph: SemaRegistrationGraph?, payload: VariantPayload, nominal: SemaRegistrationNominal, subject_ty: Type) -> [Type] Never! {
    names :: loop parameter in nominal.generic_params -> parameter.name
    actuals :: sema_pattern_subject_args(subject_ty)
    if payload == {
        .Unit -> [Type]{}
        .Single(ty, _) -> [sema_inference_substitute_type(sema_type_resolve_member_type(graph, nominal, ty), names, actuals)]
        .Named(fields) -> loop field in fields -> sema_inference_substitute_type(sema_type_resolve_member_type(graph, nominal, field.ty), names, actuals)
    }
}

// (Rust `union_member_tag`): the tag an arm names for one
// union member, read without module qualifiers (`.LocalDate`, `.M__String_`).
fn sema_pattern_union_tag(ty: Type) -> String Never! {
    type_union_member_tag(sema_pattern_unwrap_tags(ty))
}

fn sema_pattern_core_payload(owner: String, variant: String) -> [Type]? {
    if sema_data_is_json_name(owner) {
        return if variant == {
            "Null" -> Val([Type]{})
            "Bool" -> Val([Type.Bool])
            "Int" -> Val([Type.Int])
            "Float" -> Val([Type.Float])
            "Text" -> Val([Type.String])
            "Bytes" -> Val([Type.List{element: Type.IntN{signed: false, bits: 8}}])
            "DateTime" -> Val([Type.Named{name: "ZonedDateTime"}])
            "Array" -> Val([Type.List{element: sema_dyn_type()}])
            // An object is its fields in arrival order.
            "Object" -> Val([sema_data_object_pairs_type()])
            "Number" -> Val([Type.String])
            else -> None
        }
    }
    if owner == {
        // The canonical twelve generated payload rows.
        "DataEvent" -> core_enum_variant_payload(owner, variant)
        "Key" -> if variant == {
            "Char" | "Ctrl" -> Val([Type.Char])
            "F" -> Val([Type.Int])
            "Enter" | "Escape" | "Backspace" | "Tab" | "Delete" | "Up" | "Down" | "Left" | "Right" | "Unknown" -> Val([Type]{})
            else -> None
        }
        else -> None
    }
}

// A Core enum with no source declaration (`IOError`, `ProcessSignal`, ...):
// the variant's payload comes from the generated Core enum rows.
fn sema_pattern_core_enum_payload(owner_name: String, variant: String, span: Span, diagnostics: &[Diagnostic]) -> SemaPatternPayload {
    result := SemaPatternPayload{types: [Type]{}, owner: None, payload: None, known: false, group: false, range_forbidden: false}
    if core_enum_payload_variants(owner_name) == None && core_enum_variants(owner_name) == None {
        &diagnostics.push(sema_error("E0305", span, "pattern `{variant}` doesn't match `{owner_name}`", "pattern tests must name a variant on the subject's enum type", "check the variant spelling"))
        return result
    }
    result.range_forbidden = true
    payload :: core_enum_variant_payload(owner_name, variant) ?? {
        &diagnostics.push(sema_error("E0305", span, "pattern `{variant}` doesn't belong to `{owner_name}`", "pattern tests must name a variant on the subject's enum type", "check the variant spelling"))
        return result
    }
    result.types = payload
    result.known = true
    result
}

// The one union member whose enum declares the case
// `variant`, when `variant` is not itself a member tag. `None` for an
// unknown or ambiguous case, which reaches the ordinary E0305 member check.
fn sema_pattern_flat_union_owner(carrier: Type, variant: String, env: SemaScopeEnvironment, program: SemaProgramTables, span: Span) -> Type? {
    members :: if carrier == {
        .Union(values) -> values
        else -> [Type]{}
    }
    loop member in members {
        if sema_pattern_union_tag(member) == variant -> return None
    }
    owners := [Type]{}
    loop member in members {
        probe := [Diagnostic]{}
        if sema_pattern_payload(member, variant, env, program, span, &probe).known -> &owners.push(member)
    }
    if owners.len() != 1 -> return None
    Val(owners[0])
}

// The flat-case owner's checked type name, which a leading-dot constructor
// resolves as its enum.
fn sema_pattern_flat_union_owner_name(carrier: Type, variant: String, env: SemaScopeEnvironment, program: SemaProgramTables, span: Span) -> String? {
    owner :: sema_pattern_flat_union_owner(carrier, variant, env, program, span) ?? return None
    Val(type_name(sema_pattern_unwrap_tags(owner)))
}

fn sema_pattern_payload(subject_ty: Type, variant: String, env: SemaScopeEnvironment, program: SemaProgramTables, span: Span, diagnostics: &[Diagnostic]) -> SemaPatternPayload {
    normalized :: sema_pattern_unwrap_tags(subject_ty)
    result := SemaPatternPayload{types: [Type]{}, owner: None, payload: None, known: false, group: false, range_forbidden: false}
    if normalized == {
        .Union(members) -> {
            loop member in members {
                if sema_pattern_union_tag(member) == variant {
                    &result.types.push(member)
                    result.known = true
                    return result
                }
            }
            &diagnostics.push(sema_error("E0305", span, "pattern `{variant}` doesn't belong to `{type_name(normalized)}`", "union pattern arms name one member type of the subject union", "use one of the subject union member types"))
            return result
        }
        .Apply(name, args) -> {
            if name == "HookDecision" || name == "HookOutcome" {
                if variant == {
                    "Continue" -> if args.len() > 0 -> &result.types.push(args[0])
                    "Transform" -> if name == "HookDecision" && args.len() > 0 -> &result.types.push(args[0])
                    "Fail" -> if args.len() > 1 -> &result.types.push(args[1])
                    "Cancel" -> result.known = true
                    else -> {}
                }
                if result.types.len() > 0 || result.known {
                    result.known = true
                    return result
                }
                &diagnostics.push(sema_error("E0305", span, "pattern `{variant}` doesn't belong to `{name}`", "hook decision patterns name one of the declared hook outcomes", "check the hook variant spelling"))
                return result
            }
        }
        else -> {}
    }
    owner_name :: sema_pattern_base_name(normalized) ?? {
        &diagnostics.push(sema_error("E0305", span, "pattern `{variant}` doesn't match `{type_name(normalized)}`", "variant patterns only work on enum values", "match a value with a pattern for its type"))
        return result
    }
    if sema_data_is_json_name(owner_name) || owner_name == "DataEvent" || owner_name == "Key" {
        result.range_forbidden = true
        core_payload :: sema_pattern_core_payload(owner_name, variant)
        result.types = core_payload ?? [Type]{}
        result.known = core_payload != None
        if !result.known {
            &diagnostics.push(sema_error("E0305", span, "pattern `{variant}` doesn't belong to `{owner_name}`", "pattern tests must name a variant on the subject's enum type", "check the variant spelling"))
        }
        return result
    }
    if program.registration_graph == .Val(graph) {
    // A compiler-owned runtime enum (`TaskFailure`) is registered once and
    // seen from every module, as its canonical owner.
    found_row := sema_pattern_nominal_row(graph, env.module_identity, normalized)
    if found_row == None -> found_row = sema_registration_compiler_builtin_row(graph, owner_name)
    nominal_row :: found_row ?? {
        return sema_pattern_core_enum_payload(owner_name, variant, span, &diagnostics)
    }
    nominal :: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
    result.owner = Val(nominal.symbol.id)
    if nominal.source == {
        .SourceAST(item) -> {
            if item == {
                .Enum(definition) -> {
                    loop group in definition.groups {
                        if group.path == variant {
                            result.group = true
                            result.known = true
                            return result
                        }
                    }
                }
                else -> {
                    &diagnostics.push(sema_error("E0305", span, "pattern `{variant}` doesn't match `{type_name(normalized)}`", "`{owner_name}` is not an enum with variant constructors", "use a struct field or constructor pattern for this type"))
                    return result
                }
            }
        }
        .ForeignHandle(_) | .CompilerBuiltinTrait(_) -> {
            &diagnostics.push(sema_error("E0305", span, "pattern `{variant}` doesn't match `{type_name(normalized)}`", "variant patterns only work on enum values", "match an enum value or use its constructor"))
            return result
        }
    }
    loop row in nominal.variants {
        if row.symbol.name == variant {
            result.payload = Val(row.payload)
            result.types = sema_pattern_variant_types(program.registration_graph, row.payload, nominal, normalized)
            result.known = true
            return result
        }
    }
    &diagnostics.push(sema_error("E0305", span, "pattern `{variant}` doesn't belong to `{owner_name}`", "pattern tests must name a variant on the subject's enum type", "check the variant spelling"))
    } else {
        &diagnostics.push(sema_error("E0305", span, "pattern `{variant}` cannot be resolved", "pattern validation needs the completed declaration graph", "resolve the subject's declaration before matching it"))
    }
    result
}

fn sema_pattern_fact(name: String, span: Span, ty: Type, mutable: Bool) -> TPatternBindingFact Never! {
    TPatternBindingFact{name: name, span: span, ty: ty, mutable: mutable, symbol_id: None}
}

fn sema_pattern_binding_shape(name: String, span: Span) -> TPatternBinding Never! {
    if name == "_" -> TPatternBinding.Wildcard else -> TPatternBinding.Bind{name: name, span: span}
}

fn sema_pattern_is_range_type(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Char | .InlineRange(_, _, _) -> true
        else -> false
    }
}

fn sema_pattern_is_option(ty: Type) -> Bool Never! {
    if ty == {
        .Option(_) -> true
        else -> false
    }
}

fn sema_pattern_is_result(ty: Type) -> Bool Never! {
    if ty == {
        .Result(_, _) -> true
        else -> false
    }
}

fn sema_pattern_is_text_hole_type(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Bool | .String | .InlineRange(_, _, _) -> true
        else -> false
    }
}

fn sema_pattern_range_valid(ty: Type, lo: Int, hi: Int, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if {
        !sema_pattern_is_range_type(ty) -> {
            &diagnostics.push(sema_error("E0316", span, "range pattern `{lo}..{hi}` used on `{type_name(ty)}`", "range patterns only work on Int, Char, or an already bounded integer value", "bind the value and check it with a regular condition"))
            false
        }
        lo > hi -> {
            &diagnostics.push(sema_error("E0316", span, "range pattern `{lo}..{hi}` is empty", "the lower end of a range must be less than or equal to the upper end", "swap the range bounds"))
            false
        }
        else -> true
    }
}

fn sema_pattern_slot_facts(slots: [PatSlot], expected: [Type], variant: String, range_forbidden: Bool, env: SemaScopeEnvironment, program: SemaProgramTables, writes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, mutable: Bool, diagnostics: &[Diagnostic], facts: &[TPatternBindingFact], tir_bindings: &[TPatternBinding]) -> Bool {
    complete := true
    loop (index, slot) in slots {
        has_type :: index < expected.len()
        if slot == {
            .Bind(name, binding_span) -> {
                if {
                    has_type -> &facts.push(sema_pattern_fact(name, binding_span, expected[index], mutable))
                    else -> {
                        complete = false
                    }
                }
                &tir_bindings.push(sema_pattern_binding_shape(name, binding_span))
            }
            .Wildcard -> &tir_bindings.push(TPatternBinding.Wildcard)
            .Range(lo, hi) -> {
                if {
                    !has_type -> complete = false
                    range_forbidden -> {
                        &diagnostics.push(sema_error("E0316", span, "range pattern `{lo}..{hi}` is not valid for `{variant}` payloads", "this payload does not expose an ordered integer carrier", "bind the payload and compare it explicitly"))
                        complete = false
                    }
                    !sema_pattern_range_valid(expected[index], lo, hi, span, &diagnostics) -> complete = false
                }
                &tir_bindings.push(TPatternBinding.Range{lo: lo, hi: hi})
            }
            // S31: a nested pattern is normalized and validated against the
            // slot's payload type; its bindings join this pattern's.
            .Nested(nested) -> {
                if has_type {
                    nested_check :: sema_pattern_validate_nested(expected[index], nested, env, program, &writes, &state, &tail_store, &context, &diagnostics, mutable)
                    if !nested_check.complete -> complete = false
                    loop fact in nested_check.bindings -> &facts.push(fact)
                    &tir_bindings.push(TPatternBinding.Nested{pattern: TNestedPattern{shape: nested_check.shape, enum_type: nested_check.enum_type}})
                } else {
                    complete = false
                }
            }
            .Value(value) -> {
                if has_type {
                    checked :: sema_check_expression(value, Val(expected[index]), env, program, &writes, &state, &tail_store, &context, &diagnostics)
                    if checked == .Val(typed) {
                        if !sema_type_assignable(expected[index], typed.ty) {
                            &diagnostics.push(sema_type_mismatch(expected[index], typed.ty, typed.span))
                            complete = false
                        }
                        &tir_bindings.push(TPatternBinding.Value{value: typed})
                    } else {
                        complete = false
                    }
                } else {
                    complete = false
                }
            }
            // Sema places named entries before collecting slot facts.
            .Named(_, _, _) | .Rest(_) -> complete = false
        }
    }
    if slots.len() != expected.len() {
        complete = false
        &diagnostics.push(sema_error("E0306", span, "pattern `{variant}` expects {expected.len()} bindings, got {slots.len()}", "each payload field needs its own binding slot", "write the variant with the declared payload arity"))
    }
    complete
}

// Whether a variant pattern uses the named payload
// form `.Case{field: pat, ..}`.
fn sema_pattern_has_named_slots(slots: [PatSlot]) -> Bool {
    loop slot in slots {
        if slot == {
            .Named(_, _, _) | .Rest(_) -> return true
            else -> {}
        }
    }
    false
}

// The written entries of a named payload in source order, without their
// field names and `..`, for a case that gives no names to place them by.
fn sema_pattern_strip_named_slots(slots: [PatSlot]) -> [PatSlot] {
    stripped := [PatSlot]{}
    loop slot in slots {
        if slot == {
            .Named(_, _, inner) -> &stripped.push(inner)
            .Rest(_) -> {}
            else -> &stripped.push(slot)
        }
    }
    stripped
}

fn sema_pattern_slot_text(slot: PatSlot) -> String {
    if slot == {
        .Bind(name, _) -> name
        .Range(lo, hi) -> "{lo}..{hi}"
        .Nested(inner) -> sema_pattern_source_text(inner) ?? "_"
        .Value(_) -> "value"
        .Wildcard | .Named(_, _, _) | .Rest(_) -> "_"
    }
}

// Braces on a case whose payload is positional; the
// fix spells the positional form.
fn sema_pattern_unnamed_payload_error(variant: String, slots: [PatSlot], arity: Int, span: Span) -> Diagnostic {
    positional :: sema_pattern_strip_named_slots(slots)
    fix := "write `.{variant}` with no payload"
    if arity > 0 {
        parts := [String]{}
        if positional.len() == 0 {
            loop _ in 0..<arity -> &parts.push("_")
        } else {
            loop slot in positional -> &parts.push(sema_pattern_slot_text(slot))
        }
        joined :: parts.join(", ")
        fix = "match it by position: `.{variant}({joined})`"
    }
    sema_error("E0303", span, "case `{variant}` has no field names to match", "only a case declared with named fields can be matched with `{{field: pattern}}`; this case's payload is positional", fix)
}

// Place each `field: slot` entry at its field's
// position. A left-out field needs the trailing `..` (E0326) and then
// matches anything; `..` after every field is redundant (E0327).
fn sema_pattern_place_named_slots(written: [PatSlot], fields: [VariantField], variant: String, span: Span, diagnostics: &[Diagnostic]) -> [PatSlot] {
    placed := [PatSlot?]{}
    loop _ in fields -> &placed.push(None)
    names :: loop declared in fields -> declared.name
    declared_list :: names.join(", ")
    rest := Span?{None}
    loop entry in written {
        if entry == {
            .Named(field, field_span, slot) -> {
                found := -1
                loop (index, name) in names {
                    if name == field {
                        found = index
                        break
                    }
                }
                if {
                    found < 0 -> &diagnostics.push(sema_error("E0302", field_span, "case `{variant}` has no field `{field}`", "`{variant}` declares the fields {declared_list}", "name one of the declared fields"))
                    placed[found] != None -> &diagnostics.push(sema_error("E0303", field_span, "field `{field}` appears more than once", "each payload field may be matched only once", "remove the duplicate field"))
                    else -> placed[found] = Val(slot)
                }
            }
            .Rest(rest_span) -> rest = Val(rest_span)
            else -> {}
        }
    }
    missing := [String]{}
    loop (index, name) in names {
        if placed[index] == None -> &missing.push(name)
    }
    missing_list :: missing.join(", ")
    if rest == {
        .Val(rest_span) -> if missing.len() == 0 -> &diagnostics.push(sema_error("E0327", rest_span, "this `..` is redundant", "the pattern already names every field of `{variant}`", "remove `..` or leave out at least one field"))
        .None -> if missing.len() > 0 -> &diagnostics.push(sema_error("E0326", span, "this pattern leaves out fields of `{variant}`: {missing_list}", "a pattern that doesn't name every field must end with `..` so the skipped fields are visible at a glance", "add `, ..` before the closing `}}`, or name {missing_list}"))
    }
    loop slot in placed -> slot ?? PatSlot.Wildcard
}

fn sema_pattern_validate_variant(subject_ty: Type, variant: String, written_slots: [PatSlot], leading_dot: Bool, span: Span, env: SemaScopeEnvironment, program: SemaProgramTables, writes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], mutable: Bool) -> SemaPatternValidation {
    named :: sema_pattern_has_named_slots(written_slots)
    carrier :: sema_pattern_unwrap_tags(subject_ty)
    if named && (sema_pattern_is_option(carrier) || sema_pattern_is_result(carrier)) && (variant == "Val" || variant == "None" || variant == "Ok" || variant == "Err") {
        arity :: if variant == "None" -> 0 else -> 1
        &diagnostics.push(sema_pattern_unnamed_payload_error(variant, written_slots, arity, span))
        return SemaPatternValidation{shape: TPatternShape.Variant{variant: variant, bindings: [TPatternBinding]{}, leading_dot: leading_dot, span: span}, enum_type: None, bindings: [TPatternBindingFact]{}, complete: false}
    }
    // A case that exactly one union member declares may be
    // matched flat (`.Err(.NotFound(w))` over `FindError | ParseError`); it is
    // checked as the member arm `.FindError(.NotFound(w))`.
    if sema_pattern_flat_union_owner(carrier, variant, env, program, span) == .Val(owner) {
        flat :: Pattern.Variant{variant: variant, bindings: written_slots, leading_dot: leading_dot, span: span}
        return sema_pattern_validate_variant(subject_ty, sema_pattern_union_tag(owner), [PatSlot.Nested{pattern: flat}], true, span, env, program, &writes, &state, &tail_store, &context, &diagnostics, mutable)
    }
    // A compiler-owned fact enum has no registered nominal.
    fact_enum :: sema_fact_enum_pattern(carrier, variant, written_slots, leading_dot, span, env, program, &diagnostics)
    if fact_enum == .Val(validation) -> return validation
    payload :: sema_pattern_payload(subject_ty, variant, env, program, span, &diagnostics)
    facts := [TPatternBindingFact]{}
    tir_bindings := [TPatternBinding]{}
    complete := payload.known
    if !payload.known {
        return SemaPatternValidation{shape: TPatternShape.Variant{variant: variant, bindings: tir_bindings, leading_dot: leading_dot, span: span}, enum_type: payload.owner, bindings: facts, complete: false}
    }
    slots := written_slots
    if named && !payload.group {
        if payload.payload == {
            .Val(declared) -> if declared == {
                .Named(fields) -> slots = sema_pattern_place_named_slots(written_slots, fields, variant, span, &diagnostics)
                else -> {
                    &diagnostics.push(sema_pattern_unnamed_payload_error(variant, written_slots, payload.types.len(), span))
                    return SemaPatternValidation{shape: TPatternShape.Variant{variant: variant, bindings: tir_bindings, leading_dot: leading_dot, span: span}, enum_type: payload.owner, bindings: facts, complete: false}
                }
            }
            .None -> {
                &diagnostics.push(sema_pattern_unnamed_payload_error(variant, written_slots, payload.types.len(), span))
                return SemaPatternValidation{shape: TPatternShape.Variant{variant: variant, bindings: tir_bindings, leading_dot: leading_dot, span: span}, enum_type: payload.owner, bindings: facts, complete: false}
            }
        }
    }
    if {
        payload.group -> {
            if slots.len() != 0 {
                &diagnostics.push(sema_error("E0306", span, "pattern `{variant}` expects no bindings", "an enum group carries no payload of its own", "match a leaf variant to bind its payload"))
                complete = false
            }
        }
        else -> {
            if !sema_pattern_slot_facts(slots, payload.types, variant, payload.range_forbidden, env, program, &writes, &state, &tail_store, &context, span, mutable, &diagnostics, &facts, &tir_bindings) -> complete = false
        }
    }
    SemaPatternValidation{shape: TPatternShape.Variant{variant: variant, bindings: tir_bindings, leading_dot: leading_dot, span: span}, enum_type: payload.owner, bindings: facts, complete: complete}
}

fn sema_pattern_invalid_value(span: Span) -> TExpr Never! {
    TExpr{ty: Type.Named{name: "Never"}, kind: TExprKind.InvariantViolation{construct: "invalid pattern value", span: span}, span: span}
}

fn sema_pattern_struct(subject_ty: Type, fields: [StructPatField], rest: Span?, span: Span, type_head: PatternTypeHead?, env: SemaScopeEnvironment, program: SemaProgramTables, writes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], mutable: Bool) -> SemaPatternValidation {
    if program.registration_graph == .Val(graph) {
    nominal_row :: sema_pattern_nominal_row(graph, env.module_identity, subject_ty) ?? {
        &diagnostics.push(sema_error("E0313", span, "`{{ … }}` can only match a struct value, but this is `{type_name(subject_ty)}`", "a struct pattern reads named fields from a struct value", "match a struct value instead"))
        return SemaPatternValidation{shape: TPatternShape.Struct{fields: [TPatternField]{}, span: span}, enum_type: None, bindings: [TPatternBindingFact]{}, complete: false}
    }
    nominal :: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
    is_struct :: nominal.kind == SemaRegistrationNominalKind.Struct
    if type_head == .Val(head) && head.name != nominal.symbol.name {
        &diagnostics.push(sema_error("E0305", head.span, "pattern `{head.name}` does not match `{type_name(subject_ty)}`", "a named pattern must name the subject's struct type", "use `{nominal.symbol.name}` as the pattern head"))
    }
    if !is_struct {
        &diagnostics.push(sema_error("E0313", span, "`{{ … }}` can only match a struct value, but this is `{type_name(subject_ty)}`", "a struct pattern reads named fields from a struct value", "match a struct value instead"))
    }
    names :: loop field in fields -> if field == {
        .Bind(field_name, _, _, _) -> field_name
        .Value(field_name, _, _) | .Nested(field_name, _, _) -> field_name
    }
    facts := [TPatternBindingFact]{}
    tir_fields := [TPatternField]{}
    complete := is_struct
    nominal_args :: sema_pattern_subject_args(subject_ty)
    generic_names :: loop parameter in nominal.generic_params -> parameter.name
    loop field in fields {
        field_name :: if field == {
            .Bind(name, _, _, _) -> name
            .Value(name, _, _) | .Nested(name, _, _) -> name
        }
        known := false
        field_ty := Type?{None}
        loop registered in nominal.fields {
            if registered.symbol.name == field_name {
                known = true
                field_ty = Val(sema_inference_substitute_type(registered.ty, generic_names, nominal_args))
            }
        }
        if !known {
            unknown_span :: if field == {
                .Bind(_, binding_span, _, _) -> binding_span
                .Value(_, value_span, _) -> value_span
                else -> span
            }
            &diagnostics.push(sema_error("E0107", unknown_span, "nothing named `{field_name}` exists on this struct", "struct patterns can only name declared fields", "check the field spelling"))
            complete = false
            next
        }
        if field_ty == .Val(resolved_ty) {
            if field == {
                .Bind(_, _, local, local_span) -> {
                    &facts.push(sema_pattern_fact(local, local_span, resolved_ty, mutable))
                    &tir_fields.push(TPatternField.Bind{field: field_name, local: local, span: local_span})
                }
                .Value(_, field_span, value) -> {
                    checked :: sema_check_expression(value, Val(resolved_ty), env, program, &writes, &state, &tail_store, &context, &diagnostics)
                    if checked == {
                        .Val(typed) -> {
                            if !sema_type_assignable(resolved_ty, typed.ty) {
                                &diagnostics.push(sema_type_mismatch(resolved_ty, typed.ty, typed.span))
                                complete = false
                            }
                            &tir_fields.push(TPatternField.Value{field: field_name, value: typed, span: field_span})
                        }
                        .None -> {
                            complete = false
                            &tir_fields.push(TPatternField.Value{field: field_name, value: sema_pattern_invalid_value(field_span), span: field_span})
                        }
                    }
                }
                .Nested(_, field_span, nested) -> {
                    checked :: sema_pattern_validate_nested(resolved_ty, nested, env, program, &writes, &state, &tail_store, &context, &diagnostics, mutable)
                    if !checked.complete -> complete = false
                    loop fact in checked.bindings -> &facts.push(fact)
                    &tir_fields.push(TPatternField.Nested{field: field_name, pattern: TNestedPattern{shape: checked.shape, enum_type: checked.enum_type}, span: field_span})
                }
            }
        }
    }
    if {
        rest == None && names.len() < nominal.fields.len() -> {
            &diagnostics.push(sema_error("E0326", span, "this pattern leaves out fields of `{nominal.symbol.name}`", "a destructure without `..` must name every field", "add `, ..` or name the remaining fields"))
            complete = false
        }
        rest != None && names.len() >= nominal.fields.len() && nominal.fields.len() > 0 -> {
            &diagnostics.push(sema_error("E0327", rest, "this `..` is redundant", "the pattern already names every field", "remove `..` or leave out a field"))
            complete = false
        }
    }
    return SemaPatternValidation{shape: TPatternShape.Struct{fields: tir_fields, span: span}, enum_type: None, bindings: facts, complete: complete}
    }
    &diagnostics.push(sema_error("E0313", span, "a struct pattern needs the declaration graph", "struct patterns read registered fields", "resolve the subject declaration before matching it"))
    SemaPatternValidation{shape: TPatternShape.Struct{fields: [TPatternField]{}, span: span}, enum_type: None, bindings: [TPatternBindingFact]{}, complete: false}
}

fn sema_pattern_list(subject_ty: Type, items: [PatSlot], rest: ListPatRest?, span: Span, env: SemaScopeEnvironment, program: SemaProgramTables, writes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaPatternValidation {
    elem := Type.Named{name: "Never"}
    complete := true
    if sema_pattern_unwrap_tags(subject_ty) == {
        .List(element) -> elem = element
        .FixedList(element, length) -> {
            elem = element
            if measure_literal_value(length) == .Val(count) {
                if (rest == None && items.len() != count) || items.len() > count {
                    &diagnostics.push(sema_error("E0305", span, "this list pattern cannot match length {count}", "an exact pattern needs the same length; a rest pattern needs enough items", "adjust the pattern length"))
                    complete = false
                }
            }
        }
        else -> {
            &diagnostics.push(sema_error("E0305", span, "a list pattern cannot match `{type_name(subject_ty)}`", "list patterns match list values", "match a list value"))
            complete = false
        }
    }
    facts := [TPatternBindingFact]{}
    slots := [TPatternBinding]{}
    expected :: loop _ in items -> elem
    if !sema_pattern_slot_facts(items, expected, "list", false, env, program, &writes, &state, &tail_store, &context, span, false, &diagnostics, &facts, &slots) -> complete = false
    lowered_rest := TListPatternRest?{None}
    if rest == .Val(tail) {
        name := String?{None}
        if tail.name == .Val(binding) {
            name = Val(binding.name)
            &facts.push(sema_pattern_fact(binding.name, binding.span, Type.List{element: elem}, false))
        }
        lowered_rest = Val(TListPatternRest{name: name, span: tail.span})
    }
    SemaPatternValidation{shape: TPatternShape.List{items: slots, rest: lowered_rest, span: span}, enum_type: None, bindings: facts, complete: complete}
}

fn sema_pattern_constant_name(name: String) -> Bool Never! {
    if name.len() == 0 -> return false
    letter := false
    loop byte in name.bytes() {
        code :: Int.from_u8(byte)
        if code >= 65 && code <= 90 -> letter = true
        if code >= 97 && code <= 122 -> return false
    }
    letter
}

fn sema_pattern_map_key_written(key: Expr) -> Bool Never! {
    if key == {
        .Int(_, _, _, _, _) | .Bool(_, _, _) | .Char(_, _, _) | .EnumLit(_, _, _, _, _, _, _) -> true
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Interp(_, _) -> return false
            }
            true
        }
        .Ident(name, _, _) -> sema_pattern_constant_name(name)
        .Field(base, _, _, _) -> if base == .Ident(name, _, _) -> name.len() > 0 else -> false
        .Unary(_, inner, _, _) -> sema_pattern_map_key_written(inner)
        else -> false
    }
}

fn sema_pattern_map_resolve_key(key: TExpr, env: SemaScopeEnvironment, program: SemaProgramTables) -> TExpr {
    if key.kind == .ConstRef(symbol) && program.registration_graph == .Val(graph) {
        loop module_row_index in 0..<graph.modules.len() {
            loop constant_index in 0..<graph.modules[module_row_index].constants.len() {
                if graph.modules[module_row_index].constants[constant_index].symbol.id.key != symbol.key -> next
                if graph.modules[module_row_index].constants[constant_index].declaration.ct == .Val(value) {
                    if sema_checked_comptime(value) == .Val(known) {
                        resolved := key
                        resolved.kind = TExprKind.CtLit{value: known}
                        return resolved
                    }
                }
            }
        }
    }
    // copy: the resolved key is a new owned TExpr. When nothing resolves it equals `key`, the
    // pattern's checked key (a read parameter), which stays on the pattern.
    key.copy()
}

fn sema_pattern_map(subject_ty: Type, entries: [MapPatEntry], rest: Span?, span: Span, env: SemaScopeEnvironment, program: SemaProgramTables, writes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaPatternValidation {
    key_ty := Type.Named{name: "Never"}
    value_ty := Type.Named{name: "Never"}
    complete := true
    if sema_pattern_unwrap_tags(subject_ty) == {
        .Map(key, _, value) -> {
            key_ty = key
            value_ty = value
        }
        else -> {
            &diagnostics.push(sema_error("E0305", span, "a map pattern cannot match `{type_name(subject_ty)}`", "map patterns match map values", "match a map value"))
            complete = false
        }
    }
    facts := [TPatternBindingFact]{}
    lowered := [TMapPatternEntry]{}
    keys := [String]{}
    loop entry in entries {
        if !sema_pattern_map_key_written(entry.key) {
            &diagnostics.push(sema_error("E0305", entry.span, "a map pattern key must be written out", "keys must be literals, enum cases or ALL_CAPS constants", "write the key's value or an ALL_CAPS constant"))
            complete = false
        }
        checked :: sema_check_expression(entry.key, Val(key_ty), env, program, &writes, &state, &tail_store, &context, &diagnostics)
        key := sema_pattern_map_resolve_key(checked ?? {
            complete = false
            next
        }, env, program)
        if tir_pattern_key_identity(key) == .Val(identity) {
            if keys.contains(identity) {
                &diagnostics.push(sema_error("E0117", entry.span, "this map pattern repeats a key", "each key can appear only once in a pattern", "remove the repeated key"))
                complete = false
            }
            &keys.push(identity)
        }
        slots := [TPatternBinding]{}
        slot_ty :: if entry.optional -> Type.Option{inner: value_ty} else -> value_ty
        if !sema_pattern_slot_facts([PatSlot]{entry.slot}, [Type]{slot_ty}, "map", false, env, program, &writes, &state, &tail_store, &context, entry.span, false, &diagnostics, &facts, &slots) -> complete = false
        if slots.len() == 1 -> &lowered.push(TMapPatternEntry{key: key, optional: entry.optional, slot: slots[0], span: entry.span})
    }
    SemaPatternValidation{shape: TPatternShape.Map{entries: lowered, rest: rest != None, span: span}, enum_type: None, bindings: facts, complete: complete}
}

// . Validation happens before branch scopes or
// Optional refinements, including tests whose bindings never escape.
fn sema_pattern_hole_name_available(name: String, scopes: SemaScopeTable) -> Bool Never! {
    if name == "_" -> return true
    index :: sema_scope_resolve_index(scopes, name) ?? return true
    !sema_scope_name_blocks_binding(scopes.bindings[index].symbol.kind)
}

fn sema_pattern_reused_hole(name: String, hole_span: Span, diagnostics: &[Diagnostic], pattern_span: Span, comparison: String?) {
    fix :: if comparison != None -> "wrap the pattern text in parentheses to compare with the existing value, or pick a new hole name to capture" else -> "pick a new hole name to capture; to compare, build the expected text or bytes first and compare the two values"
    diagnostic :: sema_error("E0118", hole_span, "pattern hole `{{{name}}}` would make a new `{name}`, but `{name}` already holds a value", "a pattern hole introduces a new name; it does not compare with an existing value or refine it", fix)
    if comparison == {
        .Val(text) -> &diagnostics.push(diagnostic_with_source_derived_suggestion(diagnostic, pattern_span, text))
        .None -> &diagnostics.push(diagnostic)
    }
}

// S31 with (#4713): `subject == Val(name)`
// binds `name` in every expression position. In a value position a name that
// already holds a value is this E0118; `Val((name))` is the comparison with
// the held value (a parenthesized payload constructs it). Conditions report a
// held name when they declare their bindings
// (sema_expression_declare_condition_bindings), which keeps the
// refinement `x == .Val(x)` that every `x != None` test is rewritten into.
fn sema_pattern_test_reused_payload_name(pattern: Pattern, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    name := ""
    name_span := Span{start: 0, end: 0}
    if pattern == {
        .Present(binding, binding_span, inner, _) -> if inner == None {
            name = binding
            name_span = binding_span
        }
        .Variant(variant, slots, _, _) -> if variant == "Val" && slots.len() == 1 {
            if slots[0] == .Bind(bound, bound_span) {
                name = bound
                name_span = bound_span
            }
        }
        else -> {}
    }
    if name == "" || sema_pattern_hole_name_available(name, scopes) -> return false
    &diagnostics.push(sema_error("E0118", name_span, "`Val({name})` would make a new `{name}`, but `{name}` already holds a value", "a payload name after `==` introduces a new name; it does not compare with an existing value", "write `Val(({name}))` to compare with the existing value, or pick a new name to bind"))
    true
}

// S20: Jet text has only the `\n`, `\t`, `\"`, `\\` escapes plus doubled
// braces, so any other scalar (a carriage return included) stays as the raw
// source character.
fn sema_pattern_escape_literal(text: String) -> String Never! {
    text.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\t", "\\t").replace("{{", "{{{{").replace("}}", "}}}}")
}

fn sema_pattern_text_comparison(parts: [StrMatchPart]) -> String Never! {
    text := ""
    loop part in parts {
        if part == {
            .Lit(value) -> text += sema_pattern_escape_literal(value)
            .Hole(name, _, _) -> text += "{{{name}}}"
        }
    }
    "(\"{text}\")"
}

fn sema_pattern_text(subject_ty: Type, parts: [StrMatchPart], span: Span, diagnostics: &[Diagnostic], mutable: Bool, scopes: SemaScopeTable, introduces_names: Bool) -> SemaPatternValidation {
    if sema_pattern_unwrap_tags(subject_ty) != Type.String {
        &diagnostics.push(sema_error("E0305", span, "this pattern matches text, but the subject is `{type_name(subject_ty)}`", "a string-interpolation pattern only matches String", "match a String subject instead"))
        return SemaPatternValidation{shape: TPatternShape.Text{parts: [TTextPatternPart]{}, span: span}, enum_type: None, bindings: [TPatternBindingFact]{}, complete: false}
    }
    typed_parts := [TTextPatternPart]{}
    facts := [TPatternBindingFact]{}
    complete := true
    offer_comparison_edit := true
    loop part in parts {
        if part == .Hole(_, .Val(_), _) -> offer_comparison_edit = false
    }
    loop part in parts {
        if part == {
            .Lit(text) -> &typed_parts.push(TTextPatternPart.Literal{value: text})
            .Hole(name, ty, hole_span) -> {
                if introduces_names {
                    if !sema_pattern_hole_name_available(name, scopes) {
                        comparison :: if offer_comparison_edit -> Val(sema_pattern_text_comparison(parts)) else -> None
                        sema_pattern_reused_hole(name, hole_span, &diagnostics, span, comparison)
                        complete = false
                        next
                    }
                }
                hole_ty := ty ?? Type.String
                if !sema_pattern_is_text_hole_type(hole_ty) {
                    &diagnostics.push(sema_error("E0305", hole_span, "`{{{name}:{type_name(hole_ty)}}}` cannot read text as `{type_name(hole_ty)}`", "typed text holes support integer carriers, Float, Bool, and String", "use one of the supported hole types or omit the type"))
                    complete = false
                    hole_ty = Type.String
                }
                &typed_parts.push(TTextPatternPart.Hole{name: name, ty: hole_ty, span: hole_span})
                &facts.push(sema_pattern_fact(name, hole_span, hole_ty, mutable))
            }
        }
    }
    SemaPatternValidation{shape: TPatternShape.Text{parts: typed_parts, span: span}, enum_type: None, bindings: facts, complete: complete}
}

fn sema_pattern_binary(subject_ty: Type, parts: [BinMatchPart], span: Span, diagnostics: &[Diagnostic], mutable: Bool, scopes: SemaScopeTable, introduces_names: Bool) -> SemaPatternValidation {
    normalized :: sema_pattern_unwrap_tags(subject_ty)
    bytes :: if normalized == {
        .List(element) -> element == Type.IntN{signed: false, bits: 8}
        else -> false
    }
    if !bytes {
        &diagnostics.push(sema_error("E1010", span, "this pattern matches raw bytes, but the subject is `{type_name(subject_ty)}`", "a binary pattern only matches a `[U8]` byte buffer", "match a `[U8]` subject instead"))
        return SemaPatternValidation{shape: TPatternShape.Binary{parts: [TBinaryPatternPart]{}, span: span}, enum_type: None, bindings: [TPatternBindingFact]{}, complete: false}
    }
    typed_parts := [TBinaryPatternPart]{}
    facts := [TPatternBindingFact]{}
    complete := true
    offset := 0
    loop part in parts {
        if part == {
            .Lit(bytes_value) -> {
                if offset % 8 != 0 {
                    &diagnostics.push(sema_error("E1011", span, "this binary pattern part is not byte-aligned", "fixed bytes must start on a byte boundary", "pad preceding bit fields to a byte boundary"))
                    complete = false
                }
                &typed_parts.push(TBinaryPatternPart.Literal{value: bytes_value})
                offset += bytes_value.len() * 8
            }
            .Hole(name, spec, hole_span) -> {
                available := true
                if introduces_names {
                    available = sema_pattern_hole_name_available(name, scopes)
                    if !available {
                        sema_pattern_reused_hole(name, hole_span, &diagnostics, span, None)
                        complete = false
                    }
                }
                if spec == {
                    .Rest -> {
                        if offset % 8 != 0 {
                            &diagnostics.push(sema_error("E1011", hole_span, "this binary pattern part is not byte-aligned", "a rest capture reads whole bytes", "pad preceding bit fields to a byte boundary"))
                            complete = false
                        }
                        rest_ty :: Type.List{element: Type.IntN{signed: false, bits: 8}}
                        &typed_parts.push(TBinaryPatternPart.Rest{name: name, ty: rest_ty, span: hole_span})
                        if available -> &facts.push(sema_pattern_fact(name, hole_span, rest_ty, mutable))
                    }
                    .Bits(width, endian) -> {
                        if width <= 0 || width > 64 {
                            &diagnostics.push(sema_error("E1008", hole_span, "binary bit width is outside U1 through U64", "bit captures have a fixed unsigned width", "use a width from U1 through U64"))
                            complete = false
                        }
                        if endian == BinEndian.Little && width % 8 != 0 {
                            &diagnostics.push(sema_error("E1008", hole_span, "a little-endian binary read must be a whole number of bytes", "byte order only reorders complete bytes", "use a multiple-of-8 width or big-endian order"))
                            complete = false
                        }
                        bits :: if {
                            width <= 8 -> 8
                            width <= 16 -> 16
                            width <= 32 -> 32
                            else -> 64
                        }
                        hole_ty :: Type.IntN{signed: false, bits: bits}
                        &typed_parts.push(TBinaryPatternPart.Bits{name: name, width: width, big_endian: endian == BinEndian.Big, ty: hole_ty, span: hole_span})
                        if available -> &facts.push(sema_pattern_fact(name, hole_span, hole_ty, mutable))
                        offset += width
                    }
                }
            }
        }
    }
    SemaPatternValidation{shape: TPatternShape.Binary{parts: typed_parts, span: span}, enum_type: None, bindings: facts, complete: complete}
}

fn sema_pattern_normalize_contextual_binding(slot: PatSlot, fallback: Span) -> (name: String, span: Span) Never! {
    if slot == {
        .Bind(name, binding_span) -> (name: name, span: binding_span)
        .Wildcard -> (name: "_", span: fallback)
        .Range(_, _) | .Nested(_) | .Named(_, _, _) | .Rest(_) | .Value(_) -> (name: "", span: fallback)
    }
}

// S31: a nested payload pattern normalized against its payload type.
fn sema_pattern_normalize_nested(slot: PatSlot, payload_ty: Type, env: SemaScopeEnvironment, program: SemaProgramTables) -> Pattern? {
    if slot == {
        .Nested(nested) -> Val(sema_pattern_normalize_contextual(nested, payload_ty, env, program))
        else -> None
    }
}

fn sema_pattern_normalize_contextual(pattern: Pattern, subject_ty: Type, env: SemaScopeEnvironment, program: SemaProgramTables) -> Pattern Never! {
    if pattern == {
        .Or(alternatives, span) -> {
            normalized :: loop alternative in alternatives -> sema_pattern_normalize_contextual(alternative, subject_ty, env, program)
            return Pattern.Or{alternatives: normalized, span: span}
        }
        .Variant(variant, slots, leading_dot, span) -> {
            normalized_ty :: sema_pattern_unwrap_tags(subject_ty)
            // `T? E!` names its success states directly;
            // `.Val(x)` / `.None` test the carrier's `Ok` payload.
            if normalized_ty == .Result(ok, _) && (variant == "Val" || variant == "None") {
                if sema_pattern_is_option(sema_pattern_unwrap_tags(ok)) {
                    state :: sema_pattern_normalize_contextual(pattern, ok, env, program)
                    return Pattern.Ok{binding: "_", binding_span: span, inner: Val(state), span: span}
                }
            }
            if variant == {
                "None" -> if slots.len() == 0 && (!leading_dot || sema_pattern_is_option(normalized_ty)) -> return Pattern.Absent{span: span}
                "Val" -> if slots.len() == 1 && (!leading_dot || sema_pattern_is_option(normalized_ty)) {
                    if normalized_ty == .Option(payload_ty) {
                        nested :: sema_pattern_normalize_nested(slots[0], payload_ty, env, program)
                        if nested != None -> return Pattern.Present{binding: "_", binding_span: span, inner: nested, span: span}
                    }
                    binding :: sema_pattern_normalize_contextual_binding(slots[0], span)
                    if binding.name != "" -> return Pattern.Present{binding: binding.name, binding_span: binding.span, inner: None, span: span}
                }
                "Ok" -> if slots.len() == 1 && sema_pattern_is_result(normalized_ty) {
                    if normalized_ty == .Result(ok, _) {
                        nested :: sema_pattern_normalize_nested(slots[0], ok, env, program)
                        if nested != None -> return Pattern.Ok{binding: "_", binding_span: span, inner: nested, span: span}
                    }
                    binding :: sema_pattern_normalize_contextual_binding(slots[0], span)
                    if binding.name != "" -> return Pattern.Ok{binding: binding.name, binding_span: binding.span, inner: None, span: span}
                }
                "Err" -> if slots.len() == 1 && sema_pattern_is_result(normalized_ty) {
                    if normalized_ty == .Result(_, err) {
                        nested :: sema_pattern_normalize_nested(slots[0], err, env, program)
                        if nested != None -> return Pattern.Err{binding: "_", binding_span: span, inner: nested, span: span}
                    }
                    binding :: sema_pattern_normalize_contextual_binding(slots[0], span)
                    if binding.name != "" -> return Pattern.Err{binding: binding.name, binding_span: binding.span, inner: None, span: span}
                }
                else -> {}
            }
        }
        else -> {}
    }
    // copy: the normalized pattern is a new owned Pattern. Otherwise it equals `pattern`, the
    // caller's AST pattern (a read parameter), which the caller keeps.
    pattern.copy()
}

// S31: normalize a nested payload pattern against its payload type, then
// validate it there.
fn sema_pattern_validate_nested(payload_ty: Type, pattern: Pattern, env: SemaScopeEnvironment, program: SemaProgramTables, writes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], mutable: Bool) -> SemaPatternValidation {
    normalized :: sema_pattern_normalize_contextual(pattern, payload_ty, env, program)
    sema_pattern_validate_internal(payload_ty, normalized, env, program, &writes, &state, &tail_store, &context, &diagnostics, mutable)
}

fn sema_pattern_carrier_shape(kind: String, binding: String, binding_span: Span, inner: TNestedPattern?, span: Span) -> TPatternShape Never! {
    if kind == {
        "Val" -> TPatternShape.Present{binding: binding, binding_span: binding_span, inner: inner, span: span}
        "Ok" -> TPatternShape.Ok{binding: binding, binding_span: binding_span, inner: inner, span: span}
        else -> TPatternShape.Err{binding: binding, binding_span: binding_span, inner: inner, span: span}
    }
}

// A `.Val`, `.Ok`, or `.Err` pattern over its payload type: the carrier
// binding, or an S31 nested pattern that binds its own names.
fn sema_pattern_validate_carrier(kind: String, payload_ty: Type, binding: String, binding_span: Span, inner: Pattern?, span: Span, env: SemaScopeEnvironment, program: SemaProgramTables, writes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], mutable: Bool) -> SemaPatternValidation {
    if inner == .Val(nested) {
        check :: sema_pattern_validate_nested(payload_ty, nested, env, program, &writes, &state, &tail_store, &context, &diagnostics, mutable)
        return SemaPatternValidation{shape: sema_pattern_carrier_shape(kind, binding, binding_span, Val(TNestedPattern{shape: check.shape, enum_type: check.enum_type}), span), enum_type: None, bindings: check.bindings, complete: check.complete}
    }
    facts := [TPatternBindingFact]{}
    if binding != "_" -> &facts.push(sema_pattern_fact(binding, binding_span, payload_ty, mutable))
    SemaPatternValidation{shape: sema_pattern_carrier_shape(kind, binding, binding_span, None, span), enum_type: None, bindings: facts, complete: true}
}

fn sema_pattern_validate_internal(subject_ty: Type, pattern: Pattern, env: SemaScopeEnvironment, program: SemaProgramTables, writes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], mutable: Bool) -> SemaPatternValidation Never! {
    span :: sema_pattern_span(pattern)
    if pattern == {
        .Present(binding, binding_span, inner, _) -> if sema_pattern_unwrap_tags(subject_ty) == {
            .Option(payload) -> sema_pattern_validate_carrier("Val", payload, binding, binding_span, inner, span, env, program, &writes, &state, &tail_store, &context, &diagnostics, mutable)
            else -> {
                &diagnostics.push(sema_error("E0305", span, "this pattern belongs to an optional value, not `{type_name(subject_ty)}`", "present-value patterns work on Option values", "match an optional value or use its enum pattern"))
                SemaPatternValidation{shape: TPatternShape.Present{binding: binding, binding_span: binding_span, inner: None, span: span}, enum_type: None, bindings: [TPatternBindingFact]{}, complete: false}
            }
        }
        .Absent(_) -> if {
            sema_pattern_is_option(sema_pattern_unwrap_tags(subject_ty)) -> SemaPatternValidation{shape: TPatternShape.Absent{span: span}, enum_type: None, bindings: [TPatternBindingFact]{}, complete: true}
            else -> {
                &diagnostics.push(sema_error("E0305", span, "this pattern belongs to an optional value, not `{type_name(subject_ty)}`", "absent patterns work on Option values", "match an optional value or use its enum pattern"))
                SemaPatternValidation{shape: TPatternShape.Absent{span: span}, enum_type: None, bindings: [TPatternBindingFact]{}, complete: false}
            }
        }
        .Ok(binding, binding_span, inner, _) -> if sema_pattern_unwrap_tags(subject_ty) == {
            .Result(ok, _) -> sema_pattern_validate_carrier("Ok", ok, binding, binding_span, inner, span, env, program, &writes, &state, &tail_store, &context, &diagnostics, mutable)
            else -> {
                &diagnostics.push(sema_error("E0305", span, "this pattern belongs to a fallible result, not `{type_name(subject_ty)}`", "Ok patterns work on Result values", "match a Result value instead"))
                SemaPatternValidation{shape: TPatternShape.Ok{binding: binding, binding_span: binding_span, inner: None, span: span}, enum_type: None, bindings: [TPatternBindingFact]{}, complete: false}
            }
        }
        .Err(binding, binding_span, inner, _) -> if sema_pattern_unwrap_tags(subject_ty) == {
            .Result(_, err) -> sema_pattern_validate_carrier("Err", err, binding, binding_span, inner, span, env, program, &writes, &state, &tail_store, &context, &diagnostics, mutable)
            else -> {
                &diagnostics.push(sema_error("E0305", span, "this pattern belongs to a fallible result, not `{type_name(subject_ty)}`", "Err patterns work on Result values", "match a Result value instead"))
                SemaPatternValidation{shape: TPatternShape.Err{binding: binding, binding_span: binding_span, inner: None, span: span}, enum_type: None, bindings: [TPatternBindingFact]{}, complete: false}
            }
        }
        .Range(lo, hi, _) -> {
            complete :: sema_pattern_range_valid(sema_pattern_unwrap_tags(subject_ty), lo, hi, span, &diagnostics)
            SemaPatternValidation{shape: TPatternShape.Range{lo: lo, hi: hi, span: span}, enum_type: None, bindings: [TPatternBindingFact]{}, complete: complete}
        }
        .Struct(fields, rest, _, type_head) -> sema_pattern_struct(subject_ty, fields, rest, span, type_head, env, program, &writes, &state, &tail_store, &context, &diagnostics, mutable)
        .List(items, rest, _) -> sema_pattern_list(subject_ty, items, rest, span, env, program, &writes, &state, &tail_store, &context, &diagnostics)
        .Map(entries, rest, _) -> sema_pattern_map(subject_ty, entries, rest, span, env, program, &writes, &state, &tail_store, &context, &diagnostics)
        .StrMatch(parts, _) -> sema_pattern_text(subject_ty, parts, span, &diagnostics, mutable, writes, true)
        .BinMatch(parts, _) -> sema_pattern_binary(subject_ty, parts, span, &diagnostics, mutable, writes, true)
        .Variant(variant, slots, leading_dot, _) -> sema_pattern_validate_variant(subject_ty, variant, slots, leading_dot, span, env, program, &writes, &state, &tail_store, &context, &diagnostics, mutable)
        .Or(alternatives, _) -> {
            if alternatives.len() == 0 {
                &diagnostics.push(sema_error("E0317", span, "an or-pattern needs at least one alternative", "or-patterns compare one or more valid pattern shapes", "write a pattern before the `|`"))
                return SemaPatternValidation{shape: TPatternShape.Or{alternatives: [TPatternShape]{}, span: span}, enum_type: None, bindings: [TPatternBindingFact]{}, complete: false}
            }
            results :: loop alternative in alternatives -> sema_pattern_validate_internal(subject_ty, alternative, env, program, &writes, &state, &tail_store, &context, &diagnostics, mutable)
            shapes :: loop result in results -> result.shape
            complete := results[0].complete
            loop index in 1..<results.len() {
                alternative :: results[index]
                if !alternative.complete || !sema_pattern_facts_equal(results[0].bindings, alternative.bindings) {
                    &diagnostics.push(sema_error("E0317", span, "or-pattern alternatives bind different names or types", "every alternative must bind the same names at the same types", "rename bindings so all alternatives agree"))
                    complete = false
                }
            }
            SemaPatternValidation{shape: TPatternShape.Or{alternatives: shapes, span: span}, enum_type: results[0].enum_type, bindings: results[0].bindings, complete: complete}
        }
    }
}

fn sema_pattern_facts_equal(left: [TPatternBindingFact], right: [TPatternBindingFact]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop left_fact in left {
        found := false
        loop right_fact in right {
            if right_fact.name == left_fact.name {
                if !type_identity_equal(left_fact.ty, right_fact.ty) -> return false
                found = true
                break
            }
        }
        if !found -> return false
    }
    true
}

fn sema_pattern_binding_facts(checked: SemaCheckedPattern) -> [TPatternBindingFact] Never! {
    checked.bindings
}

// True when `pattern` names only optional states
// (`.Val(…)`, `.None`, or an or-pattern of them) — the payload the retired
// nested `.Ok(…)` spelling wrapped.
fn sema_pattern_names_optional_state(pattern: Pattern) -> Bool Never! {
    if pattern == {
        .Present(_, _, _, _) | .Absent(_) -> true
        .Variant(variant, _, _, _) -> variant == "Val" || variant == "None"
        .Or(alternatives, _) -> loop alternative in alternatives {
            if !sema_pattern_names_optional_state(alternative) -> break false
        } ?? true
        else -> false
    }
}

// The canonical source text of a raw leading-dot pattern tree, for the E0392
// edit. None for pattern kinds a payload slot cannot hold.
fn sema_pattern_source_text(pattern: Pattern) -> String? {
    if pattern == {
        .Variant(variant, slots, leading_dot, _) -> {
            head :: if leading_dot -> ".{variant}" else -> variant
            if slots.len() == 0 -> return Val(head)
            parts := [String]{}
            loop slot in slots {
                if slot == {
                    .Wildcard -> &parts.push("_")
                    .Bind(name, _) -> &parts.push(name)
                    .Range(lo, hi) -> &parts.push("{lo}..{hi}")
                    .Nested(inner) -> {
                        text :: sema_pattern_source_text(inner) ?? return None
                        &parts.push(text)
                    }
                    // The E0392 edit spells only the positional form.
                    .Named(_, _, _) | .Rest(_) | .Value(_) -> return None
                }
            }
            joined :: parts.join(", ")
            return Val("{head}({joined})")
        }
        .Or(alternatives, _) -> {
            parts := [String]{}
            loop alternative in alternatives {
                text :: sema_pattern_source_text(alternative) ?? return None
                &parts.push(text)
            }
            return Val(parts.join(" | "))
        }
        else -> return None
    }
}

fn sema_pattern_retired_outcome_diagnostic(span: Span, state: Pattern, subject_ty: Type) -> Diagnostic {
    why :: "a `T? E!` value has three states, matched as `.Val(x)`, `.None` and `.Err(e)`"
    if sema_pattern_source_text(state) == .Val(text) {
        diagnostic :: sema_error("E0392", span, "`.Ok({text})` wraps a state that `{type_name(subject_ty)}` names directly", why, "write `{text}`")
        return diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: text})
    }
    sema_error("E0392", span, "`.Ok(…)` wraps a state that `{type_name(subject_ty)}` names directly", why, "write `.Val(…)` or `.None`")
}

// `T? E!` names its three states directly, so a source
// `.Ok(.Val(x))` / `.Ok(.None)` on such a value is the retired nested
// spelling (E0392). Walks the raw pattern before normalization.
fn sema_pattern_report_retired_outcome(pattern: Pattern, subject_ty: Type, env: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) Never! {
    if pattern == {
        .Or(alternatives, _) -> loop alternative in alternatives -> sema_pattern_report_retired_outcome(alternative, subject_ty, env, program, &diagnostics)
        .Variant(variant, slots, leading_dot, span) -> {
            if slots.len() != 1 -> return
            normalized_ty :: sema_pattern_unwrap_tags(subject_ty)
            if normalized_ty == .Result(ok, _) && variant == "Ok" && leading_dot {
                if sema_pattern_is_option(sema_pattern_unwrap_tags(ok)) {
                    if slots[0] == .Nested(state) {
                        if sema_pattern_names_optional_state(state) {
                            &diagnostics.push(sema_pattern_retired_outcome_diagnostic(span, state, subject_ty))
                            return
                        }
                    }
                }
            }
            if slots[0] == .Nested(inner) {
                payload_ty :: sema_coverage_payload_type(normalized_ty, variant, env, program) ?? return
                sema_pattern_report_retired_outcome(inner, payload_ty, env, program, &diagnostics)
            }
        }
        else -> {}
    }
}

fn sema_check_pattern(subject: TExpr, pattern: Pattern, position: TPatternPosition, mutable: Bool, boxed: Bool, env: SemaScopeEnvironment, program: SemaProgramTables, writes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaPatternCheck Never! {
    before :: diagnostics.len()
    sema_pattern_report_retired_outcome(pattern, subject.ty, env, program, &diagnostics)
    normalized :: sema_pattern_normalize_contextual(pattern, subject.ty, env, program)
    validation :: sema_pattern_validate_internal(subject.ty, normalized, env, program, &writes, &state, &tail_store, &context, &diagnostics, mutable)
    if position == TPatternPosition.Binding {
        loop index in before..<diagnostics.len() {
            diagnostic :: diagnostics[index]
            if diagnostic.code == "E0118" && diagnostic.edit != None {
                // A parenthesized comparison is Bool, not a test-bind carrier.
                diagnostics[index] = sema_error("E0118", diagnostic.span ?? sema_pattern_span(pattern), diagnostic.what, diagnostic.why, "pick a new hole name to capture; to compare, build the expected text or bytes first and compare the two values")
            }
        }
    }
    complete :: validation.complete && diagnostics.len() == before
    checked :: if complete -> Val(SemaCheckedPattern{subject: subject, pattern: TPattern{shape: validation.shape, bindings: validation.bindings, enum_type: validation.enum_type, position: position, mutable: mutable, boxed: boxed}, bindings: validation.bindings}) else -> None
    SemaPatternCheck{complete: complete, checked: checked, bindings: validation.bindings}
}
