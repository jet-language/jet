// Canonical Core reachability collection for checked source and generated roots.
//
// This pass consumes declaration-registration imports plus the AST that a caller
// has selected for checking. It does not resolve ordinary names and it does not
// own target policy. Core's dependency graph and runtime-layer classification
// remain Foundation-owned (RingLayer.jet).
use jet_foundation.[
    AST_NODE_GENERATED,
    Diagnostic,
    Expr,
    ExternFn,
    Field,
    Func,
    ImportDecl,
    InternalTag,
    Item,
    LValue,
    MARKER_SCALAR,
    RuntimeLayer,
    Param,
    Span,
    Stmt,
    StrFormat,
    StructDef,
    SwitchArm,
    SymbolKind,
    TraitImplBlock,
    TraitMethodSig,
    Type,
    TypedLitBody,
    core_call,
    core_input_method_member,
    core_input_method_modules,
    core_module_has_member,
    core_module_has_type,
    core_type_modules,
    expr_binary_operands,
    expr_optional_method_call_as_call,
    expr_span,
    jet_ring_classify_prelude_closure,
    jet_ring_closure_rows_layer,
    jet_ring_prelude_closure_layer,
    diagnostic_registry_row,
    boundary_head_owner_module,
    SymbolTable,
    symbol_find,
    symbol_is_local,
    symbol_key_text,
    symbol_table_key,
    ModuleID,
    ModuleTable,
    module_is_core,
    module_text,
]

SemaCoreImport: struct {
    alias: String
    module_name: String
    item: String?
    span: Span
}

SemaCoreUsageSpan: struct {
    usage: String
    span: Span
}

SemaCoreModuleUsageResult: struct {
    module_identity: ModuleID
    used_core: [String]
    usage_spans: [SemaCoreUsageSpan]
    ffi_callback_keys: [String]
    closure: [String]
    inferred_layer: RuntimeLayer
}

SemaCoreUsageResult: struct {
    used_core: [String]
    usage_spans: [SemaCoreUsageSpan]
    ffi_callback_keys: [String]
    closure: [String]
    inferred_layer: RuntimeLayer
    modules: [SemaCoreModuleUsageResult]
}

sema_core_string_contains: fn(values: [String], value: String) -> Bool Never! {
    loop item in values {
        if item == value -> return true
    }
    false
}

sema_core_string_add: fn(values: &[String], value: String) Never! {
    if value == "" || sema_core_string_contains(values, value) -> return
    sema_core_string_insert_sorted(values, value)
}

// Inserts `value`, known absent, at its sorted position.
sema_core_string_insert_sorted: fn(values: &[String], value: String) Never! {
    index: loop (index, existing) in values {
        if value < existing -> break index
    } ?? values.len()
    values.push(value.copy())
    cursor := values.len() - 1
    loop cursor > index {
        values[cursor] = values[cursor - 1]
        cursor -= 1
    }
    values[index] = value
}

sema_core_type_uses_default_int: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int -> true
        .List(inner) | .Shared(inner) | .Option(inner) | .FixedList(inner, _) |
        .Tagged(_, inner) | .Case(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> sema_core_type_uses_default_int(inner)
        .Map(key, _, value) -> sema_core_type_uses_default_int(key) || sema_core_type_uses_default_int(value)
        .Result(ok, err) -> sema_core_type_uses_default_int(ok) || sema_core_type_uses_default_int(err)
        .Tuple(fields) -> loop field in fields {
            if sema_core_type_uses_default_int(field.ty) -> break true
        } ?? false
        .Union(members) -> loop member in members {
            if sema_core_type_uses_default_int(member) -> break true
        } ?? false
        .Fn(params, ret, _, _, _, _) -> {
            params_have_default_int: loop parameter in params {
                if sema_core_type_uses_default_int(parameter) -> break true
            } ?? false
            if params_have_default_int -> return true
            return_type: ret ?? return false
            sema_core_type_uses_default_int(return_type)
        }
        .Apply(_, args) -> loop argument in args {
            if sema_core_type_uses_default_int(argument) -> break true
        } ?? false
        .Float | .Bool | .String | .Char | .Named(_) | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> false
    }
}

sema_core_generated_receiver_key: fn(receiver: Expr) -> String Never! {
    if receiver == {
        .Ident(name, _, _) -> name
        .Field(base, member, _, _) -> {
            prefix: sema_core_generated_receiver_key(base)
            if prefix == "" -> member else -> "{prefix}.{member}"
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> ""
    }
}

sema_core_generated_context_marker: fn(name: String) -> String Never! {
    "__core_generated::{name}"
}

sema_core_generated_type_marker: fn(source_name: String, module_name: String, type_name: String) -> String Never! {
    sema_core_generated_context_marker("type::{source_name}::{module_name}::{type_name}")
}

sema_core_generated_constructor_marker: fn(source_name: String) -> String Never! {
    sema_core_generated_context_marker("constructor::{source_name}")
}

sema_core_generated_shadow_marker: fn(name: String) -> String Never! {
    sema_core_generated_context_marker("shadow::{name}")
}

// Generated-context markers share the module's registered-name set: every
// marker starts with `__core_generated::`, which no source type name can, so
// one set answers both the type-name and the marker questions.
sema_core_generated_marker_add: fn(markers: &[String:Bool], marker: String) Never! {
    markers[marker] = true
}

sema_core_generated_marker_has: fn(markers: [String:Bool], marker: String) -> Bool Never! {
    markers.get(marker) != None
}

sema_core_generated_type_marked: fn(markers: [String:Bool], source_name: String, module_name: String, type_name: String) -> Bool Never! {
    sema_core_generated_marker_has(markers, sema_core_generated_type_marker(source_name, module_name, type_name))
}

sema_core_generated_constructor_marked: fn(markers: [String:Bool], source_name: String) -> Bool Never! {
    sema_core_generated_marker_has(markers, sema_core_generated_constructor_marker(source_name))
}

sema_core_generated_shadowed: fn(markers: [String:Bool], name: String) -> Bool Never! {
    sema_core_generated_marker_has(markers, sema_core_generated_shadow_marker(name))
}

sema_core_generated_core_module: fn(module_name: String) -> Bool Never! {
    if module_name == {
        "core.mem" | "core.compute" -> true
        else -> false
    }
}

sema_core_generated_core_type: fn(module_name: String, type_name: String) -> Bool Never! {
    if module_name == {
        "core.mem" -> type_name == "Pool" || type_name == "Cell" || type_name == "ID"
        "core.compute" -> type_name == "Vec" || type_name == "Matrix"
        else -> false
    }
}

sema_core_generated_register_core_name: fn(markers: &[String:Bool], source_name: String, module_name: String, type_name: String) Never! {
    if !sema_core_generated_core_type(module_name, type_name) -> return
    sema_core_generated_marker_add(markers, sema_core_generated_type_marker(source_name, module_name, type_name))
    if type_name == "Cell" -> sema_core_generated_marker_add(markers, sema_core_generated_constructor_marker(source_name))
}

sema_core_generated_register_core_alias: fn(markers: &[String:Bool], alias: String, module_name: String) Never! {
    if !sema_core_generated_core_module(module_name) -> return
    loop type_name in ([String]{"Pool", "Cell", "ID", "Vec", "Matrix"}) {
        if sema_core_generated_core_type(module_name, type_name) {
            sema_core_generated_register_core_name(markers, "{alias}.{type_name}", module_name, type_name)
            sema_core_generated_register_core_name(markers, "{alias}::{type_name}", module_name, type_name)
        }
    }
}

sema_core_generated_register_core_qualified: fn(markers: &[String:Bool], module_name: String, type_name: String) Never! {
    sema_core_generated_register_core_name(markers, "{module_name}.{type_name}", module_name, type_name)
    sema_core_generated_register_core_name(markers, "{module_name}::{type_name}", module_name, type_name)
}

sema_core_generated_register_unqualified: fn(graph: SemaRegistrationGraph, registration_module: SemaRegistrationModule, markers: &[String:Bool], module_name: String, type_name: String) Never! {
    resolved := sema_registration_lookup_name(graph, registration_module.module_identity, type_name)
    if resolved != None {
        row: resolved ?? return
        if sema_resolved_kind(graph, row) != SymbolKind.Type && sema_resolved_kind(graph, row) != SymbolKind.Trait {
            sema_core_generated_register_core_name(markers, type_name, module_name, type_name)
            return
        }
        if {
            module_text(graph.module_table, row.target_module_identity) == module_name && sema_core_generated_core_type(module_name, type_name) -> {
                sema_core_generated_register_core_name(markers, type_name, module_name, type_name)
            }
            else -> {
                sema_core_generated_marker_add(markers, sema_core_generated_shadow_marker(type_name))
            }
        }
        return
    }
    sema_core_generated_register_core_name(markers, type_name, module_name, type_name)
}

sema_core_generated_register_import: fn(markers: &[String:Bool], row: SemaRegistrationImport, table: ModuleTable) Never! {
    target := module_text(table, row.target_module_identity)
    if target == "" {
        if row.declaration.kind == {
            .Module(name, _) -> target = name
            .Unqualified(module_alias, _, _, _, _) -> target = module_alias
            .File(_, _) -> {}
        }
    }
    if {
        sema_core_generated_core_module(target) -> {
            if row.declaration.kind == {
                .Module(name, _) -> {
                    alias := if row.declaration.alias != "" -> row.declaration.alias else -> name
                    sema_core_generated_register_core_alias(markers, alias, target)
                }
                .File(_, _) | .Unqualified(_, _, _, _, _) -> {}
            }
            loop binding in row.bindings {
                if {
                    sema_core_generated_core_type(target, binding.original) -> {
                        sema_core_generated_register_core_name(markers, binding.local, target, binding.original)
                    }
                    else -> {
                        sema_core_generated_marker_add(markers, sema_core_generated_shadow_marker(binding.local))
                    }
                }
            }
        }
        else -> {
            loop binding in row.bindings -> sema_core_generated_marker_add(markers, sema_core_generated_shadow_marker(binding.local))
        }
    }
}

sema_core_generated_context_markers: fn(graph: SemaRegistrationGraph, registration_module: SemaRegistrationModule, markers: &[String:Bool]) Never! {
    sema_core_generated_marker_add(markers, sema_core_generated_context_marker("shared"))
    loop nominal in registration_module.nominals -> sema_core_generated_marker_add(markers, sema_core_generated_shadow_marker(nominal.symbol.name))
    if !sema_core_generated_shadowed(markers, "Shared") -> sema_core_generated_marker_add(markers, sema_core_generated_constructor_marker("Shared"))
    loop type_name in ([String]{"Pool", "Cell", "ID"}) -> sema_core_generated_register_unqualified(graph, registration_module, markers, "core.mem", type_name)
    loop type_name in ([String]{"Vec", "Matrix"}) -> sema_core_generated_register_unqualified(graph, registration_module, markers, "core.compute", type_name)
    loop type_name in ([String]{"Pool", "Cell", "ID"}) -> sema_core_generated_register_core_qualified(markers, "core.mem", type_name)
    loop type_name in ([String]{"Vec", "Matrix"}) -> sema_core_generated_register_core_qualified(markers, "core.compute", type_name)
    loop row in registration_module.imports -> sema_core_generated_register_import(markers, row, graph.module_table)
    // A package name bound in the module shadows a Core name
    // like a non-Core import does.
    loop owner in registration_module.namespace_bindings -> sema_core_generated_marker_add(markers, sema_core_generated_shadow_marker(graph.modules[owner.module_index].symbols[owner.row].name))
}

sema_core_generated_scope_shadow_items: fn(items: [Item], markers: &[String:Bool]) Never! {
    loop item in items {
        if item == {
            .Struct(definition) -> sema_core_generated_marker_add(markers, sema_core_generated_shadow_marker(definition.name))
            .Enum(definition) -> sema_core_generated_marker_add(markers, sema_core_generated_shadow_marker(definition.name))
            .Distinct(definition) -> sema_core_generated_marker_add(markers, sema_core_generated_shadow_marker(definition.name))
            .TypeAlias(definition) -> sema_core_generated_marker_add(markers, sema_core_generated_shadow_marker(definition.name))
            .Trait(definition) -> sema_core_generated_marker_add(markers, sema_core_generated_shadow_marker(definition.name))
            .Func(_) | .UnitFamily(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

sema_core_generated_scope_import_markers: fn(declarations: [ImportDecl], markers: &[String:Bool]) Never! {
    loop declaration in declarations {
        if declaration.kind == {
            .Module(name, _) -> {
                alias := if declaration.alias != "" -> declaration.alias else -> name
                if {
                    sema_core_generated_core_module(name) -> {
                        sema_core_generated_register_core_alias(markers, alias, name)
                    }
                    else -> {
                        loop type_name in ([String]{"Pool", "Cell", "ID", "Vec", "Matrix"}) -> sema_core_generated_marker_add(markers, sema_core_generated_shadow_marker("{alias}.{type_name}"))
                    }
                }
            }
            .Unqualified(module_alias, _, items, _, _) -> {
                if {
                    sema_core_generated_core_module(module_alias) -> {
                        loop item in items {
                            local := item.alias ?? item.original
                            sema_core_generated_register_core_name(markers, local, module_alias, item.original)
                        }
                    }
                    else -> {
                        loop item in items {
                            local := item.alias ?? item.original

                            sema_core_generated_marker_add(markers, sema_core_generated_shadow_marker(local))
                        }
                    }
                }
            }
            .File(_, _) -> {}
        }
    }
}

sema_core_generated_struct_has_cli: fn(definition: StructDef) -> Bool Never! {
    loop derive_item in definition.derives {
        if derive_item.name == "CLI" -> return true
    }
    false
}

sema_core_generated_direct_item_roots: fn(items: [Item], used: &[String], spans: &[SemaCoreUsageSpan]) Never! {
    loop item in items {
        if item == {
            .Func(function) -> {
                if function.is_job -> sema_core_note_usage(used, spans, "core.args::spec", None)
            }
            .Struct(definition) -> {
                if sema_core_generated_struct_has_cli(definition) -> sema_core_note_usage(used, spans, "core.args::spec", None)
                if definition.validate_span != None || definition.validate_block.len() > 0 -> sema_core_note_usage(used, spans, "core.validate::field_error", None)
            }
            .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

sema_core_import_add: fn(imports: &[SemaCoreImport], row: SemaCoreImport) Never! {
    loop existing in imports {
        if existing.alias == row.alias {
            // Registration is authoritative. Keep the first resolved binding
            // when an inline source repeats an alias.
            return
        }
    }
    imports.push(row.copy())
}

sema_core_import_copy: fn(imports: [SemaCoreImport]) -> [SemaCoreImport] Never! {
    result := [SemaCoreImport]{}
    loop row in imports -> result.push(row.copy())
    result
}

sema_core_import_is_core: fn(module_name: String) -> Bool Never! {
    module_name == "core" || module_name.starts_with("core.")
}

sema_core_import_find: fn(imports: [SemaCoreImport], alias: String) -> SemaCoreImport? {
    loop row in imports {
        if row.alias == alias -> return Val(row)
    }
    None
}

sema_core_registered_type: fn(types: [String:Bool], name: String) -> Bool Never! {
    types.get(name) != None
}

sema_core_note_usage: fn(used: &[String], spans: &[SemaCoreUsageSpan], usage: String, span: Span?) Never! {
    sema_core_string_add(used, usage)
    if span == None -> return
    if sema_core_string_contains(used, usage) {
        loop row in spans {
            if row.usage == usage -> return
        }
        spans.push(SemaCoreUsageSpan{usage: usage, span: span})
    }
}

// The public `core.text.fmt` member an interpolation selector lowers through.
// An integer value takes a private helper beside it (`fixed_int`, `hex`'s
// width form), which comes with the same source module. Display and Debug
// render through the typed route and name no member.
sema_core_format_selector_member: fn(format: StrFormat) -> String? Never! {
    if format == {
        .Display | .Debug | .Count -> None
        .Pretty -> Val("pretty")
        .Fixed(_) -> Val("decimal")
        .Grouped(_) -> Val("grouped")
        .Hex(_) -> Val("hex")
        .Bin -> Val("bin")
        .Oct -> Val("oct")
        .Sci(_) -> Val("sci")
        .Percent(_) -> Val("percent")
        .Pad(_, _) -> Val("pad")
        .PadLeft(_, _) -> Val("pad_left")
        .Unit(_) -> Val("quantity")
    }
}

sema_core_note_callback: fn(callbacks: &[String], key: String?) Never! {
    if key != None -> sema_core_string_add(callbacks, key)
}

sema_core_is_closure_marker: fn(usage: String) -> Bool Never! {
    usage.starts_with("__core_source::") || usage.starts_with("__core_intrinsic::")
}

sema_core_module_and_helper: fn(usage: String) -> [String] Never! {
    parts := usage.split("::").to_list()
    if parts.len() <= 1 -> return [String]{parts[0]}
    helper_parts := [String]{}
    loop index in 1..<parts.len() {
        helper_parts.push(parts[index])
    }
    [String]{parts[0], helper_parts.join("::")}
}

// E2937: every UI capability a Core row the module calls names must be
// declared in the package's `authority.needs`. Each missing capability is
// reported once per module, on its first located use: the module's calls
// into Core source functions first, then its Core usage rows.
sema_core_check_ui_capabilities: fn(call_facts: [SemaCallSiteFact], graph: SemaRegistrationGraph, usage_modules: [SemaCoreModuleUsageResult], module_identity: ModuleID, needs: [String], diagnostics: &[Diagnostic]) {
    reported := [String]{}
    loop fact in call_facts {
        callee: fact.callee ?? next
        if symbol_is_local(callee) -> next
        usage: sema_core_source_call_usage(symbol_table_key(graph.symbols, callee), graph) ?? next
        sema_core_check_ui_usage(usage, Val(fact.span), needs, reported, diagnostics)
    }
    loop index in 0..<usage_modules.len() {
        if usage_modules[index].module_identity != module_identity -> next
        loop row in usage_modules[index].usage_spans -> sema_core_check_ui_usage(row.usage, Val(row.span), needs, reported, diagnostics)
        loop usage in usage_modules[index].used_core -> sema_core_check_ui_usage(usage, None, needs, reported, diagnostics)
    }
}

// `module::member` of a call whose callee is a free function of a Core
// source module (`function:<module identity>::<member>`), or None.
sema_core_source_call_usage: fn(key: String, graph: SemaRegistrationGraph) -> String? Never! {
    if !key.starts_with("function:<corelib>/") -> return None
    cut: key.rfind(":")
    head: key.slice(0, cut)
    if !head.ends_with(":") -> return None
    index: sema_registration_module_index_text(graph, head.slice(9, head.len() - 1)) ?? return None
    Val("{graph.modules[index].module_name}::{key.slice(cut + 1, key.len())}")
}

sema_core_check_ui_usage: fn(usage: String, span: Span?, needs: [String], reported: &[String], diagnostics: &[Diagnostic]) {
    parts: sema_core_module_and_helper(usage)
    if parts.len() != 2 -> return
    row: core_call(parts[0], parts[1]) ?? return
    loop capability in row.ui_capabilities {
        if sema_core_string_contains(needs, capability) || sema_core_string_contains(reported, capability) -> next
        reported.push(capability.copy())
        service: "{parts[0]}.{parts[1]}"
        registry: diagnostic_registry_row("E2937") ?? panic("E2937 has no registry row")
        diagnostics.push(sema_error_optional("E2937", span, registry.what.replace("{{service}}", service).replace("{{capability}}", capability), registry.why, registry.fix.replace("{{capability}}", capability)))
    }
}

// Source authority is deliberately narrower than the intrinsic closure. The
// archive package is the only Core source package currently exposed to this
// port; all other roots are compiler-owned runtime seams.
sema_core_has_source_package: fn(module_name: String) -> Bool Never! {
    module_name == "core.archive"
}

// The closure's runtime layer lands in `layer`, from the same classification:
// the closure is closed under the dependency edges, so it classifies to the
// rows its roots do.
sema_expand_core_reachable_closure: fn(roots: [String], layer: &RuntimeLayer) -> [String] Never! {
    used := [String]{}
    loop root in roots -> sema_core_string_add(used, root)
    direct := [String]{}
    loop root in roots {
        if !sema_core_is_closure_marker(root) -> sema_core_string_add(direct, root)
    }
    loop usage in direct {
        parts := sema_core_module_and_helper(usage)
        module_name := parts[0]
        helper := if parts.len() > 1 -> parts[1] else -> ""
        if sema_core_has_source_package(module_name) {
            sema_core_string_add(used, "__core_source::{module_name}")
            if helper != "" -> sema_core_string_add(used, "__core_source::{usage}")
        }
        intrinsic := if module_name == "core.archive" -> "archive.abi" else -> module_name
        sema_core_string_add(used, "__core_intrinsic::{intrinsic}")
        if helper != "" -> sema_core_string_add(used, "__core_intrinsic::{intrinsic}::{helper}")
    }
    // Foundation owns dependency edges and keeps this expansion idempotent.
    rows: jet_ring_classify_prelude_closure(used)
    loop row in rows -> sema_core_string_add(used, row.key)
    layer = jet_ring_closure_rows_layer(rows)
    used
}

sema_core_note_builtin_math_type: fn(name: String, registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], span: Span?) Never! {
    if sema_core_registered_type(registered, name) -> return
    if sema_core_is_math_type(name) || sema_core_is_geometry_type(name) {
        sema_core_note_usage(used, spans, "core.math::__mathtypes__", span)
    }
}

sema_core_is_math_type: fn(name: String) -> Bool Never! {
    if name == {
        "F32x4" | "F64x2" | "F32x8" | "F64x4" |
        "I8x16" | "I16x8" | "I32x4" | "I64x2" |
        "U8x16" | "U16x8" | "U32x4" | "U64x2" |
        "I8x32" | "I16x16" | "I32x8" | "I64x4" |
        "U8x32" | "U16x16" | "U32x8" | "U64x4" |
        "Vec2" | "Vec3" | "Vec4" | "Mat3" | "Mat4" -> true
        else -> false
    }
}

sema_core_is_geometry_type: fn(name: String) -> Bool Never! {
    if name == {
        "Point2" | "Delta2" | "Transform" | "Transform2" |
        "Ray2" | "ScreenPoint" | "WorldPoint" | "ViewPoint" |
        "CameraPoint" | "DevicePoint" | "ScreenDelta" | "WorldDelta" |
        "ViewDelta" | "CameraDelta" | "DeviceDelta" -> true
        else -> false
    }
}

sema_core_is_http_nominal: fn(name: String) -> Bool Never! {
    if name == {
        "HTTPMethod" | "HTTPStatus" | "HTTPVersion" |
        "HTTPHeaderName" | "HTTPHeaderValue" | "HTTPHeaders" | "HTTPBody" -> true
        else -> false
    }
}

sema_core_is_crypto_nominal: fn(name: String) -> Bool Never! {
    leaf_parts: name.split(".").to_list()
    leaf: if leaf_parts.len() > 0 -> leaf_parts[leaf_parts.len() - 1] else -> name
    if leaf == {
        "Secret" | "SigningKey" | "VerifyKey" |
        "X25519SecretKey" | "X25519PublicKey" | "SharedSecret" |
        "Signature" | "Sealed" | "WrappedKey" |
        "Digest256" | "Digest512" | "PasswordHash" -> true
        else -> false
    }
}

sema_core_is_data_type: fn(name: String) -> Bool Never! {
    if name == {
        "JSON" | "JSON" | "YAML" | "Yaml" |
        "CSV" | "Csv" | "TOML" | "Toml" |
        "XML" | "Xml" | "Dyn" -> true
        else -> false
    }
}

sema_core_note_type_modules: fn(name: String, registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], span: Span?) Never! {
    if sema_core_registered_type(registered, name) -> return
    loop module_name in core_type_modules(name) {
        sema_core_note_usage(used, spans, "{module_name}::__type__", span)
    }
    leaf_parts := name.split(".").to_list()
    leaf := if leaf_parts.len() > 0 -> leaf_parts[leaf_parts.len() - 1] else -> name
    // These are semantic runtime seams rather than ordinary generated exports.
    if leaf == "Ptr" -> sema_core_note_usage(used, spans, "core.mem::__type__", span)
}

sema_core_collect_type: fn(ty: Type, registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], span: Span?) Never! {
    if ty == {
        .Named(name) -> {
            sema_core_note_type_modules(name, registered, used, spans, span)
            sema_core_note_builtin_math_type(name, registered, used, spans, span)
            if name == "Decimal" || name == "Fraction" || name == "Complex" -> sema_core_note_usage(used, spans, "core.math::__precise__", span)
            if sema_core_is_crypto_nominal(name) -> sema_core_note_usage(used, spans, "core.crypto::__nominal__", span)
        }
        .Apply(name, args) -> {
            sema_core_note_type_modules(name, registered, used, spans, span)
            sema_core_note_builtin_math_type(name, registered, used, spans, span)
            if name == "Atomic" || name.ends_with(".Atomic") -> sema_core_note_usage(used, spans, "core.mem::atomic", span)
            if args.len() > 0 && !sema_core_generated_shadowed(registered, name) {
                if sema_core_generated_type_marked(registered, name, "core.mem", "Pool") || sema_core_generated_type_marked(registered, name, "core.mem", "Cell") || sema_core_generated_type_marked(registered, name, "core.mem", "ID") -> sema_core_note_usage(used, spans, "core.mem::pool_shared", None)
                if sema_core_generated_type_marked(registered, name, "core.compute", "Vec") || sema_core_generated_type_marked(registered, name, "core.compute", "Matrix") -> sema_core_note_usage(used, spans, "core.compute::shape_alias", None)
            }
            loop arg in args -> sema_core_collect_type(arg, registered, used, spans, span)
        }
        .Tagged(marker, inner) -> {
            if marker == {
                .Internal(internal) -> {
                    if internal == InternalTag.CoreCryptoNominal -> sema_core_note_usage(used, spans, "core.crypto::__nominal__", span)
                }
                .User(_) -> {}
            }
            sema_core_collect_type(inner, registered, used, spans, span)
        }
        .List(inner) | .Case(_, inner) -> sema_core_collect_type(inner, registered, used, spans, span)
        .Option(inner) -> sema_core_collect_type(inner, registered, used, spans, span)
        .Shared(inner) -> {
            if sema_core_generated_marker_has(registered, sema_core_generated_context_marker("shared")) -> sema_core_note_usage(used, spans, "core.mem::pool_shared", None)
            sema_core_collect_type(inner, registered, used, spans, span)
        }
        .FixedList(inner, _) -> sema_core_collect_type(inner, registered, used, spans, span)
        .InlineRange(inner, _, _) -> sema_core_collect_type(inner, registered, used, spans, span)
        .Map(key, _, value) -> {
            sema_core_collect_type(key, registered, used, spans, span)
            sema_core_collect_type(value, registered, used, spans, span)
        }
        .Result(ok, err) -> {
            sema_core_collect_type(ok, registered, used, spans, span)
            sema_core_collect_type(err, registered, used, spans, span)
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop parameter in params -> sema_core_collect_type(parameter, registered, used, spans, span)
            if ret != None -> sema_core_collect_type(ret, registered, used, spans, span)
        }
        .Tuple(fields) -> loop field in fields -> sema_core_collect_type(field.ty, registered, used, spans, span)
        .Union(members) -> loop member in members -> sema_core_collect_type(member, registered, used, spans, span)
        .TraitObject(bounds) -> loop bound in bounds -> sema_core_note_type_modules(bound, registered, used, spans, span)
        .Quantity(base, _) -> sema_core_collect_type(base, registered, used, spans, span)
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 | .Measure(_) -> {}
    }
}

sema_core_note_typed_head: fn(used: &[String], spans: &[SemaCoreUsageSpan], name: String, span: Span?) Never! {
    if name == "Regex" {
        sema_core_note_usage(used, spans, "core.regex::compile", span)
        return
    }
    owner_module: boundary_head_owner_module(name) ?? return
    sema_core_note_usage(used, spans, "{owner_module}::typed_head", span)
}
sema_core_is_internal_task_key: fn(name: String, suffix: String) -> Bool Never! {
    bytes: name.bytes()
    suffix_bytes: suffix.bytes()
    if bytes.len() != 9 + suffix_bytes.len() -> return false
    if bytes[0] != (U8{0}) || bytes[1] != (U8{106}) || bytes[2] != (U8{101}) || bytes[3] != (U8{116}) || bytes[4] != (U8{46}) || bytes[5] != (U8{116}) || bytes[6] != (U8{97}) || bytes[7] != (U8{115}) || bytes[8] != (U8{107}) -> return false
    loop index in 0..<suffix_bytes.len() {
        if bytes[index + 9] != suffix_bytes[index] -> return false
    }
    true
}

sema_core_collect_params: fn(params: [Param], imports: [SemaCoreImport], registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], callbacks: &[String]) {
    loop parameter in params {
        sema_core_collect_type(parameter.ty, registered, used, spans, Val(parameter.ty_span))
        if parameter.default != None -> sema_core_collect_expr(parameter.default ?? Expr.Unit{span: parameter.name_span, id: AST_NODE_GENERATED}, imports, registered, used, spans, callbacks)
    }
}

sema_core_collect_func_signature: fn(function: Func, imports: [SemaCoreImport], registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], callbacks: &[String]) {
    loop marker in function.markers {
        if marker.name == MARKER_SCALAR -> sema_core_note_usage(used, spans, "core.math::__mathtypes__", Val(function.name_span))
    }
    sema_core_collect_params(function.params, imports, registered, used, spans, callbacks)
    if function.return_type != None -> sema_core_collect_type(function.return_type ?? Type.Named{name: "Unit"}, registered, used, spans, function.return_type_span)
}

sema_core_collect_func: fn(function: Func, imports: [SemaCoreImport], registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], callbacks: &[String]) {
    sema_core_collect_func_signature(function, imports, registered, used, spans, callbacks)
    sema_core_collect_stmts(function.body, imports, registered, used, spans, callbacks)
}

// I1: a Core source wrapper restating its own compiler row (`pub
// tui_backend: fn() -> TUIBackend { core.ui.tui_backend() }`) is not a use of that
// row. Whoever reaches the wrapper (user code, another module, or a sibling in
// this module) already notes `owner::name`. Counting the wrapper's own body
// would select the row's runtime part for every program that imports the
// module, though only the wrapper's callers need it.
sema_core_collect_source_wrapper: fn(function: Func, owner: String, imports: [SemaCoreImport], registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], callbacks: &[String]) {
    own := [String]{}
    own_spans := [SemaCoreUsageSpan]{}
    sema_core_collect_func(function, imports, registered, own, own_spans, callbacks)
    self_key: "{owner}::{function.name}"
    loop usage in own {
        if usage != self_key -> sema_core_string_add(used, usage)
    }
    loop row in own_spans {
        if row.usage != self_key -> sema_core_note_usage(used, spans, row.usage, Val(row.span))
    }
}

// The top-level functions of a Core source module that no other body of the
// module calls. Self-recursion is not a sibling call: a wrapper's own
// `core.ui.tui_backend()` may resolve to itself.
sema_core_source_unshared_functions: fn(registration_module: SemaRegistrationModule, symbols: SymbolTable, module_text: String, call_facts: [SemaCallSiteFact]) -> [String] Never! {
    unshared := [String]{}
    if !module_is_core(registration_module.module_identity) -> return unshared
    called := [U32:Bool]{}
    loop fact in call_facts {
        callee: fact.callee ?? next
        if symbol_is_local(callee) -> next
        if symbol_table_key(symbols, callee) != fact.caller_key -> called[callee.id] = true
    }
    loop item in registration_module.program.items {
        if item == {
            .Func(function) -> {
                called_here := false
                if symbol_find(symbols, symbol_key_text(SymbolKind.Function, module_text, "", function.name)) == .Val(id) -> called_here = called.get(id.id) != None
                if !called_here -> unshared.push(function.name)
            }
            .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    unshared
}

sema_core_collect_field: fn(field: Field, imports: [SemaCoreImport], registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], callbacks: &[String]) {
    sema_core_collect_type(field.ty, registered, used, spans, Val(field.ty_span))
    if field.computed != None -> sema_core_collect_expr(field.computed ?? Expr.Unit{span: field.name_span, id: AST_NODE_GENERATED}, imports, registered, used, spans, callbacks)
    if field.default != None -> sema_core_collect_expr(field.default ?? Expr.Unit{span: field.name_span, id: AST_NODE_GENERATED}, imports, registered, used, spans, callbacks)
}

sema_core_collect_trait_method: fn(method: TraitMethodSig, imports: [SemaCoreImport], registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], callbacks: &[String]) {
    sema_core_collect_params(method.params, imports, registered, used, spans, callbacks)
    if method.return_type != None -> sema_core_collect_type(method.return_type ?? Type.Named{name: "Unit"}, registered, used, spans, Val(method.name_span))
    if method.default_body != None -> sema_core_collect_stmts(method.default_body ?? [Stmt]{}, imports, registered, used, spans, callbacks)
}

sema_core_collect_trait_impl: fn(block: TraitImplBlock, imports: [SemaCoreImport], registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], callbacks: &[String]) {
    loop method in block.methods -> sema_core_collect_func(method, imports, registered, used, spans, callbacks)
    loop associated in block.assoc_type_impls -> sema_core_collect_type(associated.ty, registered, used, spans, Val(associated.span))
    loop constant in block.constants -> sema_core_collect_expr(constant.value, imports, registered, used, spans, callbacks)
}

sema_core_collect_extern: fn(function: ExternFn, imports: [SemaCoreImport], registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], callbacks: &[String]) {
    sema_core_collect_params(function.params, imports, registered, used, spans, callbacks)
    if function.return_type != None -> sema_core_collect_type(function.return_type ?? Type.Named{name: "Unit"}, registered, used, spans, function.return_type_span)
}

sema_core_collect_ast_import: fn(imports: &[SemaCoreImport], declaration: ImportDecl) Never! {
    if declaration.kind == {
        .Module(name, span) -> {
            alias := if declaration.alias != "" -> declaration.alias else -> name
            sema_core_import_add(imports, SemaCoreImport{alias: alias, module_name: name, item: None, span: span})
        }
        .Unqualified(module_alias, module_alias_span, items, _, span) -> {
            module_name := module_alias
            sema_core_import_add(imports, SemaCoreImport{alias: module_alias, module_name: module_name, item: None, span: module_alias_span})
            loop item in items {
                local := item.alias ?? item.original
                sema_core_import_add(imports, SemaCoreImport{alias: local, module_name: module_name, item: Val(item.original), span: span})
            }
        }
        .File(_, _) -> {}
    }
}

// `owner` names a Core source module (empty otherwise); its top-level
// functions listed in `unshared` are collected as wrappers
// (sema_core_collect_source_wrapper).
sema_core_collect_items: fn(items: [Item], owner: String, unshared: [String], imports: [SemaCoreImport], registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], callbacks: &[String]) {
    loop item in items -> sema_core_collect_item(item, owner, unshared, imports, registered, used, spans, callbacks)
}

// Items `first..<last` of `items`, each read in place, in item order: a
// module's items split into consecutive ranges note the same usages as one
// walk of all of them (sema_core_collected_append joins the ranges).
sema_core_collect_item_range: fn(items: [Item], first: Int, last: Int, context: SemaCoreModuleContext, collected: &SemaCoreCollected) {
    loop index in first..<last -> sema_core_collect_item(items[index], context.owner, context.unshared, context.imports, context.registered, collected.used, collected.spans, collected.callbacks)
}

sema_core_collect_item: fn(item: Item, owner: String, unshared: [String], imports: [SemaCoreImport], registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], callbacks: &[String]) {
    if item == {
        .Func(function) -> {
            if owner != "" && sema_core_string_contains(unshared, function.name) {
                sema_core_collect_source_wrapper(function, owner, imports, registered, used, spans, callbacks)
            } else {
                sema_core_collect_func(function, imports, registered, used, spans, callbacks)
            }
        }
        .Struct(definition) -> {
            loop field in definition.fields -> sema_core_collect_field(field, imports, registered, used, spans, callbacks)
            loop method in definition.methods -> sema_core_collect_func(method, imports, registered, used, spans, callbacks)
            loop block in definition.trait_impls -> sema_core_collect_trait_impl(block, imports, registered, used, spans, callbacks)
            sema_core_collect_stmts(definition.validate_block, imports, registered, used, spans, callbacks)
            loop binding in definition.cli_bindings -> sema_core_collect_expr(binding.target, imports, registered, used, spans, callbacks)
        }
        .Enum(definition) -> {
            loop variant in definition.variants {
                if variant.payload == {
                    .Single(ty, span) -> sema_core_collect_type(ty, registered, used, spans, Val(span))
                    .Named(fields) -> loop field in fields -> sema_core_collect_type(field.ty, registered, used, spans, Val(field.ty_span))
                    .Unit -> {}
                }
                if variant.discriminant_expr != None -> sema_core_collect_expr(variant.discriminant_expr ?? Expr.Unit{span: variant.name_span, id: AST_NODE_GENERATED}, imports, registered, used, spans, callbacks)
            }
            loop method in definition.methods -> sema_core_collect_func(method, imports, registered, used, spans, callbacks)
            loop block in definition.trait_impls -> sema_core_collect_trait_impl(block, imports, registered, used, spans, callbacks)
        }
        .Impl(definition) -> {
            loop method in definition.methods -> sema_core_collect_func(method, imports, registered, used, spans, callbacks)
            loop associated in definition.assoc_type_impls -> sema_core_collect_type(associated.ty, registered, used, spans, Val(associated.span))
            loop constant in definition.constants -> sema_core_collect_expr(constant.value, imports, registered, used, spans, callbacks)
        }
        .Test(definition) -> {
            sema_core_collect_params(definition.params, imports, registered, used, spans, callbacks)
            sema_core_collect_stmts(definition.body, imports, registered, used, spans, callbacks)
        }
        .Const(definition) -> {
            if definition.ty != None -> sema_core_collect_type(definition.ty ?? Type.Named{name: "Unit"}, registered, used, spans, Val(definition.name_span))
            sema_core_collect_expr(definition.value, imports, registered, used, spans, callbacks)
        }
        .Trait(definition) -> {
            loop constant in definition.constants {
                sema_core_collect_type(constant.ty, registered, used, spans, Val(constant.ty_span))
                if constant.default == .Val(value) -> sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
            }
            loop method in definition.methods -> sema_core_collect_trait_method(method, imports, registered, used, spans, callbacks)
        }
        .ExternRust(block) -> loop function in block.functions -> sema_core_collect_extern(function, imports, registered, used, spans, callbacks)
        .TypeAlias(definition) -> sema_core_collect_type(definition.target, registered, used, spans, Val(definition.target_span))
        .Distinct(definition) -> sema_core_collect_type(definition.base, registered, used, spans, Val(definition.base_span))
        .ErrorConv(definition) -> sema_core_collect_stmts(definition.body, imports, registered, used, spans, callbacks)
        .CodeModule(code_module) -> {
            if code_module.body == .Val(body) {
                scoped := sema_core_import_copy(imports)
                // An inline module's own declarations and imports shadow
                // the generated Core names inside its body only.
                scoped_registered := registered
                sema_core_generated_scope_shadow_items(body, scoped_registered)
                sema_core_generated_scope_import_markers(code_module.imports, scoped_registered)
                loop declaration in code_module.imports -> sema_core_collect_ast_import(scoped, declaration)
                sema_core_collect_items(body, "", [String]{}, scoped, scoped_registered, used, spans, callbacks)
            }
        }
        .UnitFamily(_) | .Tag(_) | .EffectDecl(_) | .Module(_) | .CModule(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
}

sema_core_collect_lvalue: fn(value: LValue, imports: [SemaCoreImport], registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], callbacks: &[String]) {
    if value == {
        .Index(base, index, _, _) -> {
            sema_core_collect_expr(base, imports, registered, used, spans, callbacks)
            sema_core_collect_expr(index, imports, registered, used, spans, callbacks)
        }
        .Field(base, _, _) -> sema_core_collect_expr(base, imports, registered, used, spans, callbacks)
        .Local(_, _) -> {}
    }
}

sema_core_generated_module_member: fn(module_name: String, member: String) -> Bool Never! {
    core_module_has_member(module_name, member)
}

sema_core_generated_type: fn(module_name: String, type_name: String) -> Bool Never! {
    core_module_has_type(module_name, type_name)
}

sema_core_import_usage_is_known: fn(row: SemaCoreImport, fallback: String) -> Bool Never! {
    if row.item == {
        .Val(_) -> true
        .None -> core_module_has_member(row.module_name, fallback)
    }
}

sema_core_import_usage: fn(row: SemaCoreImport, fallback: String) -> String Never! {
    if row.item == {
        .Val(item) -> "{row.module_name}::{item}"
        .None -> "{row.module_name}::{fallback}"
    }
}

sema_core_collect_typed_literal_body: fn(body: TypedLitBody, imports: [SemaCoreImport], registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], callbacks: &[String]) {
    if body == {
        .Fields(fields) -> loop field in fields -> sema_core_collect_expr(field.value, imports, registered, used, spans, callbacks)
        .Elements(elements) -> loop element in elements -> sema_core_collect_expr(element, imports, registered, used, spans, callbacks)
        .Entries(entries) -> loop entry in entries {
            sema_core_collect_expr(entry.key, imports, registered, used, spans, callbacks)
            sema_core_collect_expr(entry.value, imports, registered, used, spans, callbacks)
        }
        .Value(value) -> sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
        .ByteText(_) | .Empty -> {}
    }
}

sema_core_collect_expr: fn(expr: Expr, imports: [SemaCoreImport], registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], callbacks: &[String]) {
    if expr == {
        .Call(call, _) -> {
            if call.name == "Decimal" || call.name == "Fraction" || call.name == "Complex" -> sema_core_note_usage(used, spans, "core.math::__precise__", Val(call.name_span))
            if call.name == "measurement" -> sema_core_note_usage(used, spans, "core.units::__measurement_new", Val(call.name_span))
            sema_core_note_builtin_math_type(call.name, registered, used, spans, Val(call.name_span))
            sema_core_note_typed_head(used, spans, call.name, Val(call.name_span))
            if call.name == "print" {
                lone_string := if {
                    call.args.len() == 1 -> {
                        if call.args[0].expr == {
                            .Str(_, _, _) -> true
                            .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
                        }
                    }
                    else -> false
                }
                if !lone_string -> sema_core_note_usage(used, spans, "core.text.fmt::interpolation", Val(call.name_span))
            }
            // The value `jet -e` shows prints as `print` prints a value.
            if call.name == "__jet_eval_show" -> sema_core_note_usage(used, spans, "core.text.fmt::interpolation", Val(call.name_span))
            // A `debug(value)` trace interpolates the value's Debug form
            // and writes it through the shared `core.term.eprint` row, so it
            // reaches that row's Prelude part without a `core.term` import.
            if call.name == "debug" {
                sema_core_note_usage(used, spans, "core.text.fmt::interpolation", Val(call.name_span))
                sema_core_note_usage(used, spans, "core.term::eprint", Val(call.name_span))
            }
            // The prelude's `eprint` writes through the same `core.term.eprint`
            // row with no `core.term` import of its own.
            if call.name == "eprint" && sema_core_import_find(imports, call.name) == None {
                sema_core_note_usage(used, spans, "core.text.fmt::interpolation", Val(call.name_span))
                sema_core_note_usage(used, spans, "core.term::eprint", Val(call.name_span))
            }
            row: sema_core_import_find(imports, call.name)
            if row != None {
                imported := row
                if sema_core_import_is_core(imported.module_name) && sema_core_import_usage_is_known(imported, call.name) -> sema_core_note_usage(used, spans, sema_core_import_usage(imported, call.name), Val(call.name_span))
            }
            loop ty in call.type_args -> sema_core_collect_type(ty, registered, used, spans, Val(call.name_span))
            loop arg in call.args {
                sema_core_note_callback(callbacks, arg.flags.c_callback_function_key)
                sema_core_collect_expr(arg.expr, imports, registered, used, spans, callbacks)
            }
        }
        .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, _) -> {
            constructor_name := sema_core_generated_receiver_key(receiver)
            if method == "new" && !sema_core_generated_shadowed(registered, constructor_name) && sema_core_generated_constructor_marked(registered, constructor_name) -> sema_core_note_usage(used, spans, "core.mem::pool_shared", None)
            if receiver == {
                .Ident(name, _, _) -> {
                    if name == "Path" -> sema_core_note_usage(used, spans, "core.files::__pathapi__", Val(method_span))
                }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
            }
            if receiver == {
                .Ident(name, _, _) -> {
                    sema_core_note_builtin_math_type(name, registered, used, spans, Val(method_span))
                }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
            }
            loop ty in owner_type_args -> sema_core_collect_type(ty, registered, used, spans, Val(method_span))
            loop ty in type_args -> sema_core_collect_type(ty, registered, used, spans, Val(method_span))
            recv_name := if receiver == {
                .Ident(name, _, _) -> name
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> ""
            }
            if sema_core_is_internal_task_key(recv_name, "") -> sema_core_note_usage(used, spans, "core.concurrency::task", Val(method_span))
            if method == {
                "trim_start" | "trim_end" | "pad_start" | "pad_end" |
                "is_alphabetic" | "is_numeric" | "is_whitespace" | "is_ascii" |
                "to_title" | "is_lower" | "is_upper" | "capitalize" |
                "swapcase" | "normalize" | "last_index_of" |
                "remove_prefix" | "remove_suffix" -> sema_core_note_usage(used, spans, "core.text::__string_surface__", Val(method_span))
                else -> {}
            }
            if sema_core_is_http_nominal(recv_name) -> sema_core_note_usage(used, spans, "core.http::__nominal__", Val(method_span))
            if recv_name == "Duration" -> sema_core_note_usage(used, spans, "core.time::__duration__", Val(method_span))
            if method == "cmd" && (recv_name == "" || recv_name == "UIShortcut") -> sema_core_note_usage(used, spans, "core.ui.host::shortcut", Val(method_span))
            // `input.csv<Row>()` and its kin read through `__input_<method>`
            // (sema_call_try_ambient_input_method).
            if recv_name == "input" {
                member: core_input_method_member(method)
                loop owner in core_input_method_modules(method) {
                    if sema_core_generated_module_member(owner, member) -> sema_core_note_usage(used, spans, "{owner}::{member}", Val(method_span))
                }
            }
            if recv_name != "" {
                row: sema_core_import_find(imports, "{recv_name}.{method}")
                if {
                    row != None -> {
                        imported := row
                        if sema_core_import_is_core(imported.module_name) && sema_core_import_usage_is_known(imported, method) -> sema_core_note_usage(used, spans, sema_core_import_usage(imported, method), Val(method_span))
                    }
                    else -> {
                        row2: sema_core_import_find(imports, recv_name)
                        if row2 != None {
                            imported2 := row2
                            if sema_core_import_is_core(imported2.module_name) && sema_core_import_usage_is_known(imported2, method) -> sema_core_note_usage(used, spans, sema_core_import_usage(imported2, method), Val(method_span))
                        }
                    }
                }
            }
            if receiver == {
                .Field(base, leaf, _, _) -> {
                    if base == {
                        .Ident(alias, _, _) -> {
                            row: sema_core_import_find(imports, alias)
                            if row != None {
                                imported := row
                                submodule := "{imported.module_name}.{leaf}"
                                if sema_core_import_is_core(imported.module_name) && sema_core_generated_module_member(submodule, method) -> sema_core_note_usage(used, spans, "{submodule}::{method}", Val(method_span))
                                if sema_core_import_is_core(imported.module_name) && sema_core_generated_type(imported.module_name, leaf) -> sema_core_note_usage(used, spans, "{imported.module_name}::{leaf}.{method}", Val(method_span))
                            }
                        }
                        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
                    }
                }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
            }
            sema_core_collect_expr(receiver, imports, registered, used, spans, callbacks)
            loop arg in args {
                sema_core_note_callback(callbacks, arg.flags.c_callback_function_key)
                sema_core_collect_expr(arg.expr, imports, registered, used, spans, callbacks)
            }
        }
        .PtrFromAddr(_, _, elem, addr, span, _) -> {
            sema_core_collect_type(elem, registered, used, spans, Val(span))
            sema_core_collect_expr(addr, imports, registered, used, spans, callbacks)
        }
        .Pipe(head, steps, _, _) -> {
            sema_core_collect_expr(head, imports, registered, used, spans, callbacks)
            loop step in steps -> sema_core_collect_expr(step.value, imports, registered, used, spans, callbacks)
        }
        .Field(base, member, span, _) -> {
            if base == {
                .Ident(alias, _, _) -> {
                    if sema_core_is_data_type(alias) && member == "Null" -> sema_core_note_usage(used, spans, "core::json", Val(span))
                }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
            }
            sema_core_collect_expr(base, imports, registered, used, spans, callbacks)
        }
        .OptField(base, _, _, _, _, _) -> sema_core_collect_expr(base, imports, registered, used, spans, callbacks)
        .OptMethodCall(receiver, method, method_span, type_args, args, _, _) -> sema_core_collect_expr(expr_optional_method_call_as_call(receiver, method, method_span, type_args, args), imports, registered, used, spans, callbacks)
        .Unary(_, value, _, _) | .Deref(value, _, _) | .RawOf(value, _, _) | .Copy(value, _, _) | .Tainted(value, _, _, _) | .Present(value, _, _) | .Ok(value, _, _) | .Err(value, _, _) -> sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
        .Place(value, _, _, _) -> sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
        .Try(value, _, _, context, _) -> {
            sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
            if context != None -> sema_core_collect_expr(context, imports, registered, used, spans, callbacks)
        }
        .Binary(_, left, right, _, _) -> loop operand in expr_binary_operands(left, right) -> sema_core_collect_expr(operand, imports, registered, used, spans, callbacks)
        .Index(base, index, _, _, _) -> {
            sema_core_collect_expr(base, imports, registered, used, spans, callbacks)
            sema_core_collect_expr(index, imports, registered, used, spans, callbacks)
        }
        .CompareChain(operands, _, _, _, _) -> loop value in operands -> sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
        .Slice(base, start, end, range, _, _) -> {
            sema_core_collect_expr(base, imports, registered, used, spans, callbacks)
            if {
                range != None -> {
                    sema_core_collect_expr(range, imports, registered, used, spans, callbacks)
                }
                else -> {
                    sema_core_collect_expr(start, imports, registered, used, spans, callbacks)
                    sema_core_collect_expr(end, imports, registered, used, spans, callbacks)
                }
            }
        }
        .Range(start, end, _, _, _) -> {
            sema_core_collect_expr(start, imports, registered, used, spans, callbacks)
            sema_core_collect_expr(end, imports, registered, used, spans, callbacks)
        }
        .Str(parts, _, _) -> loop part in parts {
            if part == {
                .Interp(value, format) -> {
                    sema_core_note_usage(used, spans, "core.text.fmt::interpolation", Val(expr_span(value)))
                    // A selector lowers to its `Core/Text/Fmt.jet` formatter by name
                    // (ir_string_format_member), so no call here names it:
                    // the selector's public member brings that source module in.
                    if sema_core_format_selector_member(format) == .Val(member) -> sema_core_note_usage(used, spans, "core.text.fmt::{member}", Val(expr_span(value)))
                    sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
                }
                .Lit(_) | .Byte(_) -> {}
            }
        }
        .ListLit(values, _, _) -> loop value in values -> sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
        .MemberSpread(base, _, _, _) | .Spread(base, _, _) -> sema_core_collect_expr(base, imports, registered, used, spans, callbacks)
        .MapLit(entries, _, _) -> loop entry in entries {
            sema_core_collect_expr(entry.key, imports, registered, used, spans, callbacks)
            sema_core_collect_expr(entry.value, imports, registered, used, spans, callbacks)
        }
        .TupleLit(fields, span, ty, _) -> {
            if ty != None -> sema_core_collect_type(ty, registered, used, spans, Val(span))
            loop field in fields -> sema_core_collect_expr(field.value, imports, registered, used, spans, callbacks)
        }
        .StructLit(type_name, type_args, _, _, fields, _, span, _) -> {
            sema_core_note_builtin_math_type(type_name, registered, used, spans, Val(span))
            loop ty in type_args -> sema_core_collect_type(ty, registered, used, spans, Val(span))
            loop field in fields -> sema_core_collect_expr(field.value, imports, registered, used, spans, callbacks)
        }
        .TypedLit(head, body, span, _) -> {
            if head != None {
                ty := head
                sema_core_collect_type(ty, registered, used, spans, Val(span))
                if ty == {
                    .Named(name) -> {
                        sema_core_note_typed_head(used, spans, name, Val(span))
                    }
                    .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
                }
            }
            sema_core_collect_typed_literal_body(body, imports, registered, used, spans, callbacks)
        }
        .EnumLit(_, _, _, args, _, _, _) -> loop arg in args {
            if arg == {
                .Positional(value) -> {
                    sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
                }
                .Named(_, value) -> {
                    sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
                }
            }
        }
        // An imaginary literal (`4i`) is a core.math Complex.
        .UnitLit(_, _, _, suffix, _, span, _) -> {
            if suffix == "i" -> sema_core_note_usage(used, spans, "core.math::__precise__", Val(span))
        }
        .PatternTest(subject, _, _, _) -> sema_core_collect_expr(subject, imports, registered, used, spans, callbacks)
        .OrFallback(value, fallback, _, _, _) -> {
            sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
            if fallback == {
                .Value(other) -> {
                    sema_core_collect_expr(other, imports, registered, used, spans, callbacks)
                }
                .Block(body, result, _) -> {
                    sema_core_collect_stmts(body, imports, registered, used, spans, callbacks)
                    if result != None -> sema_core_collect_expr(result, imports, registered, used, spans, callbacks)
                }
                .Return(result, _) -> {
                    if result != None -> sema_core_collect_expr(result, imports, registered, used, spans, callbacks)
                }
                .Panic(_, args) -> {
                    loop arg in args -> sema_core_collect_expr(arg.expr, imports, registered, used, spans, callbacks)
                }
                .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
            }
        }
        .Lambda(lambda, _) -> {
            loop parameter in lambda.params {
                if parameter.ty != None -> sema_core_collect_type(parameter.ty ?? Type.Named{name: "Unit"}, registered, used, spans, parameter.ty_span)
            }
            if lambda.body == {
                .Expr(value) -> sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
                .Block(body) -> sema_core_collect_stmts(body, imports, registered, used, spans, callbacks)
            }
        }
        .If(cond, then_body, then_value, else_body, else_value, _, _) -> {
            sema_core_collect_expr(cond, imports, registered, used, spans, callbacks)
            sema_core_collect_stmts(then_body, imports, registered, used, spans, callbacks)
            sema_core_collect_expr(then_value, imports, registered, used, spans, callbacks)
            sema_core_collect_stmts(else_body, imports, registered, used, spans, callbacks)
            sema_core_collect_expr(else_value, imports, registered, used, spans, callbacks)
        }
        .ComptimeName(_, span, value, _) -> {
            if value != None {
                ct := value
                if ct == {
                    .Struct(type_name, _) -> {
                        if type_name == "Measurement" -> sema_core_note_usage(used, spans, "core.units::from", Val(span))
                    }
                    .Int(_) | .Float(_) | .Bool(_) | .Char(_) | .Str(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> {}
                }
            }
        }
        .Paren(value, _, _) -> sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
        // The ambient `input` reads through core.term `__input_lines`.
        .Ident(name, span, _) -> {
            if name == "input" -> sema_core_note_usage(used, spans, "core.term::__input_lines", Val(span))
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .CallValue(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}

sema_core_collect_stmts: fn(statements: [Stmt], imports: [SemaCoreImport], registered: [String:Bool], used: &[String], spans: &[SemaCoreUsageSpan], callbacks: &[String]) {
    loop statement in statements {
        if statement == {
            .Expr(value) | .Yield(value, _) | .DeferClose(value, _) -> {
                sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
            }
            .Val(binding) -> {
                if binding.ty != None -> sema_core_collect_type(binding.ty ?? Type.Named{name: "Unit"}, registered, used, spans, binding.ty_span)
                sema_core_collect_expr(binding.init, imports, registered, used, spans, callbacks)
            }
            .Assign(target, _, _, value) -> {
                sema_core_collect_lvalue(target, imports, registered, used, spans, callbacks)
                sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
            }
            .Return(value, _) -> {
                if value != None -> sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
            }
            .BreakValue(value, _) | .BreakLabelValue(_, _, value, _) -> {
                sema_core_collect_expr(value, imports, registered, used, spans, callbacks)
            }
            .While(cond, body, _, _, _) -> {
                sema_core_collect_expr(cond, imports, registered, used, spans, callbacks)
                sema_core_collect_stmts(body, imports, registered, used, spans, callbacks)
            }
            .For(_, _, _, kind, body, _, _, _, _) -> {
                if kind == {
                    .Range(start, end, step, _) -> {
                        sema_core_collect_expr(start, imports, registered, used, spans, callbacks)
                        sema_core_collect_expr(end, imports, registered, used, spans, callbacks)
                        if step != None -> sema_core_collect_expr(step, imports, registered, used, spans, callbacks)
                    }
                    .In(collection, step) -> {
                        sema_core_collect_expr(collection, imports, registered, used, spans, callbacks)
                        if step != None -> sema_core_collect_expr(step, imports, registered, used, spans, callbacks)
                    }
                }
                sema_core_collect_stmts(body, imports, registered, used, spans, callbacks)
            }
            .Switch(subject, arms, else_body, span) | .ComptimeSwitch(subject, arms, else_body, span) -> {
                if sema_core_switch_has_readiness(arms) -> sema_core_note_usage(used, spans, "core.concurrency::select", Val(span))
                sema_core_collect_expr(subject, imports, registered, used, spans, callbacks)
                loop arm in arms {
                    sema_core_collect_expr(arm.cond, imports, registered, used, spans, callbacks)
                    sema_core_collect_stmts(arm.body, imports, registered, used, spans, callbacks)
                }
                if else_body != None -> sema_core_collect_stmts(else_body, imports, registered, used, spans, callbacks)
            }
            .CountedLoop(init, cond, step, body, _, _, _) -> {
                if init.ty != None -> sema_core_collect_type(init.ty ?? Type.Named{name: "Unit"}, registered, used, spans, init.ty_span)
                sema_core_collect_expr(init.init, imports, registered, used, spans, callbacks)
                sema_core_collect_expr(cond, imports, registered, used, spans, callbacks)
                sema_core_collect_stmts(body, imports, registered, used, spans, callbacks)
                if step != None -> sema_core_collect_stmts([Stmt]{step}, imports, registered, used, spans, callbacks)
            }
            .TaskGroup(_, _, args, body, span) -> {
                sema_core_note_usage(used, spans, "core.concurrency::task", Val(span))
                if args.limit == .Val(limit) -> sema_core_collect_expr(limit, imports, registered, used, spans, callbacks)
                if args.stack == .Val(stack) -> sema_core_collect_expr(stack, imports, registered, used, spans, callbacks)
                sema_core_collect_stmts(body, imports, registered, used, spans, callbacks)
            }
            .Shield(body, span) -> {
                sema_core_note_usage(used, spans, "core.concurrency::shield", Val(span))
                sema_core_collect_stmts(body, imports, registered, used, spans, callbacks)
            }
            .Defer(body, _) -> sema_core_collect_stmts(body, imports, registered, used, spans, callbacks)
            .Reactive(body, span) -> {
                sema_core_note_usage(used, spans, "core.reactive", Val(span))
                sema_core_collect_stmts(body, imports, registered, used, spans, callbacks)
            }
            .Live(body, span) -> {
                sema_core_note_usage(used, spans, "core.term", Val(span))
                sema_core_collect_stmts(body, imports, registered, used, spans, callbacks)
            }
            .AssumeDet(_, reason_expr, body, _) -> {
                sema_core_collect_expr(reason_expr, imports, registered, used, spans, callbacks)
                sema_core_collect_stmts(body, imports, registered, used, spans, callbacks)
            }
            .Loop(body, _, _, _) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .Transact(_, _, body, _, _) -> {
                sema_core_collect_stmts(body, imports, registered, used, spans, callbacks)
            }
            .ComptimeIf(cond, _, then_body, else_body, _, _) -> {
                sema_core_collect_expr(cond, imports, registered, used, spans, callbacks)
                sema_core_collect_stmts(then_body, imports, registered, used, spans, callbacks)
                if else_body != None -> sema_core_collect_stmts(else_body, imports, registered, used, spans, callbacks)
            }
            .ComptimeBlock(body, _, _) -> sema_core_collect_stmts(body, imports, registered, used, spans, callbacks)
            .ContextBlock(fields, body, _) -> {
                loop field in fields -> sema_core_collect_expr(field.value, imports, registered, used, spans, callbacks)
                sema_core_collect_stmts(body, imports, registered, used, spans, callbacks)
            }
            .ScopeMember(_, _, args, _, body, _, _, _) -> {
                loop arg in args -> sema_core_collect_expr(arg, imports, registered, used, spans, callbacks)
                sema_core_collect_stmts(body, imports, registered, used, spans, callbacks)
            }
            .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
        }
    }
}

sema_core_switch_has_readiness: fn(arms: [SwitchArm]) -> Bool Never! {
    // The parser stores each readiness arm as one named tuple field. This is
    // the same structural predicate used by the checked switch pass.
    loop arm in arms {
        if arm.cond == {
            .TupleLit(fields, _, _, _) -> {
                if fields.len() == 1 -> return true
            }
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
        }
    }
    false
}

// What one module's Core-usage walk reads beside the items it walks: the
// Core source owner (empty for a source module), the owner's unshared
// wrappers (sema_core_source_unshared_functions), the module's Core-visible
// imports, and the registered set: its nominal names and its
// generated-context markers, so the generated roots (`core.args::spec`,
// `core.mem::pool_shared`, ...) are noted by the same walk that notes every
// other usage.
SemaCoreModuleContext: struct {
    owner: String
    unshared: [String]
    imports: [SemaCoreImport]
    registered: [String:Bool]
}

sema_core_module_context: fn(graph: SemaRegistrationGraph, registration_module: SemaRegistrationModule, call_facts: [SemaCallSiteFact]) -> SemaCoreModuleContext {
    registered := sema_core_registration_type_names(registration_module)
    sema_core_generated_context_markers(graph, registration_module, registered)
    owner: if module_is_core(registration_module.module_identity) -> registration_module.module_name else -> ""
    // An import row names its target by module identity (a Core module's is
    // `<corelib>/…`, as `use sys: core.sys` or `use core.sys.[get]` registers
    // it); a Core usage is keyed by the module's name.
    imports := sema_core_registration_imports(registration_module, graph.module_table)
    loop index in 0..<imports.len() {
        target: sema_registration_module_index_text(graph, imports[index].module_name) ?? next
        imports[index].module_name = graph.modules[target].module_name.copy()
    }
    SemaCoreModuleContext{
        owner: owner,
        unshared: sema_core_source_unshared_functions(registration_module, graph.symbols, module_text(graph.module_table, registration_module.module_identity), call_facts),
        imports: imports.move(),
        registered: registered.move(),
    }
}

// What a walk noted: the sorted usage set, the first span of each usage in
// walk order, and the sorted FFI callback keys.
SemaCoreCollected: struct {
    used: [String]
    spans: [SemaCoreUsageSpan]
    callbacks: [String]
}

sema_core_collected_empty: fn() -> SemaCoreCollected Never! {
    SemaCoreCollected{used: [String]{}, spans: [SemaCoreUsageSpan]{}, callbacks: [String]{}}
}

// Notes `part`'s rows after the rows already in `collected`, as one walk
// continuing past `collected`'s items would: the usage sets union (sorted),
// a usage keeps its first span, the callback sets union.
sema_core_collected_append: fn(collected: &SemaCoreCollected, part: SemaCoreCollected) Never! {
    loop usage in part.used -> sema_core_string_add(collected.used, usage)
    loop row in part.spans -> sema_core_note_usage(collected.used, collected.spans, row.usage, Val(row.span))
    loop key in part.callbacks -> sema_core_string_add(collected.callbacks, key)
}

// The module's Core usage from `items`, what its item ranges noted in item
// order (joined by the caller), between the usages noted before any item
// (`__exact_int__`, the generated roots) and its script body's.
sema_core_module_usage_assemble: fn(registration_module: SemaRegistrationModule, context: SemaCoreModuleContext, exact_int_reachable: Bool, items: SemaCoreCollected) -> SemaCoreModuleUsageResult {
    collected := sema_core_collected_empty()
    if exact_int_reachable -> sema_core_note_usage(collected.used, collected.spans, "core.math::__exact_int__", None)
    sema_core_generated_direct_item_roots(registration_module.program.items, collected.used, collected.spans)
    sema_core_collected_append(collected, items)
    sema_core_collect_stmts(registration_module.program.script_body, context.imports, context.registered, collected.used, collected.spans, collected.callbacks)
    layer := RuntimeLayer.Core
    closure := sema_expand_core_reachable_closure(collected.used, layer)
    SemaCoreModuleUsageResult{
        module_identity: registration_module.module_identity,
        used_core: closure,
        usage_spans: collected.spans.move(),
        ffi_callback_keys: collected.callbacks.move(),
        closure: closure,
        inferred_layer: layer
    }
}

// The module's Core-visible imports, read from its registration rows without
// copying the module's program. An import with no loaded target names its
// module by the name it is written with.
sema_core_registration_imports: fn(registration_module: SemaRegistrationModule, table: ModuleTable) -> [SemaCoreImport] Never! {
    imports := [SemaCoreImport]{}
    loop registration in registration_module.imports {
        declaration := registration.declaration
        target := module_text(table, registration.target_module_identity)
        if declaration.kind == {
            .Module(name, span) -> {
                if target == "" -> target = name
                alias := if declaration.alias != "" -> declaration.alias else -> name
                sema_core_import_add(imports, SemaCoreImport{alias: alias, module_name: target, item: None, span: span})
            }
            .Unqualified(module_alias, module_alias_span, _, _, span) -> {
                if target == "" -> target = module_alias
                sema_core_import_add(imports, SemaCoreImport{alias: module_alias, module_name: target, item: None, span: module_alias_span})
                loop binding in registration.bindings {
                    // A Core submodule member (`use core.mem`) binds a namespace.
                    if binding.declaration == None && binding.symbol.kind == SymbolKind.Import {
                        sema_core_import_add(imports, SemaCoreImport{alias: binding.local, module_name: module_text(table, binding.target_module_identity), item: None, span: binding.symbol.span})
                        next
                    }
                    sema_core_import_add(imports, SemaCoreImport{alias: binding.local, module_name: target, item: Val(binding.original), span: binding.symbol.span})
                }
                if declaration.alias != "" -> sema_core_import_add(imports, SemaCoreImport{alias: declaration.alias, module_name: target, item: None, span: span})
            }
            .File(_, _) -> {}
        }
    }
    imports
}

sema_core_registration_type_names: fn(registration_module: SemaRegistrationModule) -> [String:Bool] Never! {
    registered := [String:Bool]{}
    loop nominal in registration_module.nominals {
        if nominal.symbol.name != "" -> registered[nominal.symbol.name] = true
    }
    registered
}

// Adds `value` to the sorted, duplicate-free `values`, with `seen` holding
// the same members so the membership test does not scan the list.
sema_core_sorted_set_add: fn(values: &[String], seen: &[String:Bool], value: String) Never! {
    if value == "" || seen.get(value) != None -> return
    seen[value] = true
    sema_core_string_insert_sorted(values, value)
}

sema_core_combine_module_usage: fn(modules: [SemaCoreModuleUsageResult]) -> SemaCoreUsageResult {
    used := [String]{}
    used_seen := [String:Bool]{}
    spans := [SemaCoreUsageSpan]{}
    span_seen := [String:Bool]{}
    callbacks := [String]{}
    callback_seen := [String:Bool]{}
    loop module_row in modules {
        loop usage in module_row.used_core -> sema_core_sorted_set_add(used, used_seen, usage)
        loop row in module_row.usage_spans {
            if span_seen.get(row.usage) != None -> next
            span_seen[row.usage] = true
            spans.push(row.copy())
        }
        loop key in module_row.ffi_callback_keys -> sema_core_sorted_set_add(callbacks, callback_seen, key)
    }
    layer := jet_ring_prelude_closure_layer(used)
    SemaCoreUsageResult{used_core: used, usage_spans: spans, ffi_callback_keys: callbacks, closure: used, inferred_layer: layer, modules: modules}
}

