use {
    jet_foundation.[
        AppliedRuleApplication,
        CallArg,
        Call,
        Diagnostic,
        Expr,
        Func,
        Item,
        MARKER_ON,
        Marker,
        MarkerDecl,
        MarkerDeclParam,
        MarkerHook,
        Program,
        RuleSite,
        STATE_ARROW_LABEL,
        Span,
        Stmt,
        SymbolKind,
        TAppliedRule,
        TAppliedRuleArgKind,
        TAppliedRuleArgumentMenu,
        TAppliedRuleCatalog,
        TAppliedRuleCompanionSite,
        TAppliedRuleParameter,
        TAppliedRuleSignature,
        TComptimeValue,
        TGenericParam,
        TextEdit,
        Type,
        UnOp,
        COMPILER_EVENTS,
        TOOL_STAGES,
        diagnostic_from_registry,
        diagnostic_with_edit,
        diagnostic_with_label,
        expr_span,
        marker_hook_of_declaration,
        stage_hook,
        symbol_find,
        symbol_key_text,
        symbol_table_key,
        type_name,
        module_text,
        NameTable,
        name_column,
        name_column_get,
        name_column_set_first,
        name_column_table,
        name_find,
        name_intern,
        name_table_sized,
    ]
    jet_parser.[parser_marker_spells_service_import, parser_service_import]
}

SemaMarkerRuleArgumentObservation: struct {
    ty: Type?,
    constant: TComptimeValue?,
    // The argument checked against the rule's expected type.
    checked: Bool,
    comptime_requests: [SemaComptimeRequest],
    comptime_source: SemaComptimeItemSource?,
    diagnostics: [Diagnostic],
}

SemaMarkerRuleArgumentFact: struct {
    marker_span: Span,
    source_index: Int,
    parameter_index: Int?,
    kind: TAppliedRuleArgKind,
    ty: Type?,
    constant: TComptimeValue?,
    checked: Bool,
    comptime_requests: [SemaComptimeRequest],
}

SemaMarkerRulesCheckResult: struct {
    diagnostics: [Diagnostic],
    argument_facts: [SemaMarkerRuleArgumentFact],
    comptime_sources: [SemaComptimeItemSource],
    comptime_requests: [SemaComptimeRequest],
}

SemaMarkerRuleArgumentBinding: struct {
    source_index: Int,
    parameter_index: Int?,
    kind: TAppliedRuleArgKind,
}

sema_marker_rules_append_name: fn(values: ^[String], name: String) Never! {
    loop existing in values {
        if existing == name {
            return
        }
    }
    values.push(name.copy())
}

sema_marker_rules_expr_name: fn(value: Expr) -> String? {
    if value == .Ident(name, _, _) {
        if name.starts_with(".") -> return Val(name.slice(1, name.len()))
        return Val(name)
    }
    if value == .Field(_, name, _, _) -> return Val(name)
    if value == .EnumLit(_, name, _, _, _, _, _) -> return Val(name)
    None
}

sema_marker_rules_site_name: fn(site: RuleSite) -> String Never! {
    if {
        site == RuleSite.Package -> "Package"
        site == RuleSite.File -> "File"
        site == RuleSite.Module -> "Module"
        site == RuleSite.Function -> "Function"
        site == RuleSite.Method -> "Method"
        site == RuleSite.Block -> "Block"
        site == RuleSite.Statement -> "Statement"
        site == RuleSite.Expression -> "Expression"
        site == RuleSite.Type -> "Type"
        site == RuleSite.Impl -> "Impl"
        site == RuleSite.Trait -> "Trait"
        site == RuleSite.Declaration -> "Declaration"
        site == RuleSite.Constant -> "Constant"
        site == RuleSite.Field -> "Field"
        site == RuleSite.Variant -> "Variant"
        site == RuleSite.Parameter -> "Parameter"
        site == RuleSite.Test -> "Test"
        site == RuleSite.Operation -> "Operation"
        site == RuleSite.Text -> "Text"
        site == RuleSite.Arm -> "Arm"
        else -> "TypeUse"
    }
}

sema_marker_rules_site_value: fn(value: Expr) -> String? {
    name: sema_marker_rules_expr_name(value) ?? return None
    if name == "Package" || name == "File" || name == "Module" || name == "Function" || name == "Method" || name == "Block" || name == "Statement" || name == "Expression" || name == "Type" || name == "Impl" || name == "Trait" || name == "Declaration" || name == "Constant" || name == "Field" || name == "Variant" || name == "Parameter" || name == "Test" || name == "Operation" || name == "Text" || name == "Arm" {
        return Val(name)
    }
    None
}

sema_marker_rules_type_kind: fn(ty: Type) -> TAppliedRuleArgKind Never! {
    if ty == Type.String -> return TAppliedRuleArgKind.String
    if ty == Type.Bool -> return TAppliedRuleArgKind.Bool
    if ty == Type.Int -> return TAppliedRuleArgKind.Int
    if ty == .Named(name) {
        if name == "Value" || name == "PolicySetting" -> return TAppliedRuleArgKind.Any
        if name == "Path" -> return TAppliedRuleArgKind.Path
        if name == "Ident" -> return TAppliedRuleArgKind.Ident
        if name == "String" -> return TAppliedRuleArgKind.String
        if name == "Bool" -> return TAppliedRuleArgKind.Bool
        if name == "Int" -> return TAppliedRuleArgKind.Int
        return TAppliedRuleArgKind.Ident
    }
    if ty == .List(element) {
        if element == (Type.Named{name: "Effect"}) -> return TAppliedRuleArgKind.EffectRoots
    }
    if ty == .Union(members) {
        ^has_string: false
        ^has_duration: false
        ^has_instant: false
        ^has_naming_case: false
        loop member in members {
            if member == Type.String -> has_string = true
            if member == (Type.Named{name: "Duration"}) -> has_duration = true
            if member == (Type.Named{name: "Instant"}) -> has_instant = true
            if member == (Type.Named{name: "NamingCase"}) -> has_naming_case = true
        }
        if has_string && has_duration && members.len() == 2 {
            return TAppliedRuleArgKind.DurationOrString
        }
        if has_duration && has_instant && members.len() == 2 {
            return TAppliedRuleArgKind.DurationOrInstant
        }
        if has_string && has_naming_case && members.len() == 2 {
            return TAppliedRuleArgKind.StringOrMenu
        }
    }
    TAppliedRuleArgKind.Ident
}

sema_marker_rules_type_name_for_parameter: fn(parameter: MarkerDeclParam) -> String? {
    ty: parameter.ty ?? return Val("Value")
    Val(type_name(ty))
}

sema_marker_rules_parameter_kind: fn(parameter: MarkerDeclParam) -> TAppliedRuleArgKind Never! {
    ty: parameter.ty ?? return TAppliedRuleArgKind.Any
    sema_marker_rules_type_kind(ty)
}

sema_marker_rules_metadata_expr: fn(declaration: MarkerDecl, name: String) -> Expr? {
    loop parameter_index in 0..<declaration.params.len() {
        if declaration.params[parameter_index].name == name {
            return declaration.params[parameter_index].value
        }
    }
    None
}

sema_marker_rules_bool_fact: fn(declaration: MarkerDecl, name: String) -> Bool? {
    ^found: false
    loop parameter_index in 0..<declaration.params.len() {
        if declaration.params[parameter_index].name != name -> next
        found = true
        value: declaration.params[parameter_index].value ?? return None
        if value == .Bool(result, _, _) -> return Val(result)
        return None
    }
    if found -> return None
    Val(false)
}

sema_marker_rules_metadata_names: fn(declaration: MarkerDecl, name: String, sites: Bool) -> [String]? {
    ^found: false
    loop parameter_index in 0..<declaration.params.len() {
        if declaration.params[parameter_index].name != name -> next
        found = true
        value: declaration.params[parameter_index].value ?? return None
        if value == .ListLit(values, _, _) {
            ^names: [String]{}
            loop item in values {
                ^name_value: if sites -> sema_marker_rules_site_value(item) else -> sema_marker_rules_expr_name(item)
                value_name: name_value ?? return None
                sema_marker_rules_append_name(names, value_name)
            }
            return Val(names)
        }
        return None
    }
    if found -> return None
    if name == "$sites" -> return None
    Val([String]{})
}

// A declared `companion` setting; `site` is None when the rule declares none.
SemaMarkerRulesCompanion: struct {
    site: TAppliedRuleCompanionSite?,
}

sema_marker_rules_companion: fn(declaration: MarkerDecl) -> SemaMarkerRulesCompanion? {
    value: sema_marker_rules_metadata_expr(declaration, "$companion") ?? return Val(SemaMarkerRulesCompanion{site: None})
    if value == .ListLit(values, _, _) {
        if values.len() != 2 -> return None
        companion_name: sema_marker_rules_expr_name(values[0]) ?? return None
        site: sema_marker_rules_site_value(values[1]) ?? return None
        return Val(SemaMarkerRulesCompanion{site: Val(TAppliedRuleCompanionSite{rule: companion_name, site: site})})
    }
    None
}

sema_marker_rules_resolution: fn(declaration: MarkerDecl) -> String? {
    value: sema_marker_rules_metadata_expr(declaration, "$resolution") ?? return Val("SiteBound")
    name: sema_marker_rules_expr_name(value) ?? return None
    if name == "SiteBound" || name == "Override" || name == "Merge" || name == "Tighten" {
        return Val(name)
    }
    None
}

sema_marker_rules_source_slice: fn(source: String, span: Span) -> String? {
    if span.start < 0 || span.end < span.start -> return None
    ^bytes: source.bytes()
    if span.end > bytes.len() -> return None
    text: String.from_bytes(bytes[span.start..<span.end]) ?? return None
    Val(text)
}

sema_marker_rules_applied_parameter: fn(parameter: MarkerDeclParam, source: String) -> TAppliedRuleParameter? {
    ty: parameter.ty ?? return None
    ^default_source: String?{None}
    if parameter.value != None {
        default_expr: parameter.value ?? return None
        default_source = Val(sema_marker_rules_source_slice(source, expr_span(default_expr)) ?? return None)
    }
    Val(TAppliedRuleParameter{
        name: parameter.name,
        kind: sema_marker_rules_type_kind(ty),
        source_type: type_name(ty),
        default_source: default_source,
    })
}

sema_marker_rules_applied_row: fn(declaration: MarkerDecl, source: String) -> TAppliedRule? {
    sites: sema_marker_rules_metadata_names(declaration, "$sites", true) ?? return None
    scopes: sema_marker_rules_metadata_names(declaration, "$scopes", false) ?? return None
    repeatable: sema_marker_rules_bool_fact(declaration, "$repeatable") ?? return None
    owns_menu: sema_marker_rules_bool_fact(declaration, "$owns_menu") ?? return None
    inherits: sema_marker_rules_bool_fact(declaration, "$inherits") ?? return None
    resolution: sema_marker_rules_resolution(declaration) ?? return None
    companion: sema_marker_rules_companion(declaration) ?? return None
    ^params: [TAppliedRuleParameter]{}
    ^variadic: TAppliedRuleArgKind?{None}
    ^variadic_source_type: String?{None}
    ^variadic_name: String?{None}
    loop parameter_index in 0..<declaration.params.len() {
        if declaration.params[parameter_index].name.starts_with("$") -> next
        ty: declaration.params[parameter_index].ty ?? return None
        if declaration.params[parameter_index].variadic {
            if variadic != None -> return None
            variadic = Val(sema_marker_rules_type_kind(ty))
            variadic_source_type = Val(type_name(ty))
            variadic_name = Val(declaration.params[parameter_index].name)
            next
        }
        applied_parameter: sema_marker_rules_applied_parameter(declaration.params[parameter_index], source) ?? return None
        params.push(applied_parameter)
    }
    Val(TAppliedRule{
        name: declaration.name,
        signature: TAppliedRuleSignature{params: params, variadic: variadic, variadic_source_type: variadic_source_type, variadic_name: variadic_name},
        policy_scopes: scopes,
        sites: sites,
        repeatable: repeatable,
        owns_menu: owns_menu,
        companion_site: companion.site,
        inherits: inherits,
        resolution: resolution,
    })
}

// `Ident` is a free identifier slot and `Type`/`T.default` are
// language-checked, so none names a core.compiler.lang menu; every other
// identifier-kind type is a menu name.
sema_marker_rules_rule_requires_menu: fn(rule: TAppliedRule, source_type: String, kind: TAppliedRuleArgKind) -> String? {
    if source_type == "[Effect]" -> return Val("Effect")
    if kind != TAppliedRuleArgKind.Ident || source_type == "Ident" || source_type == "Type" || source_type == "T.default" {
        return None
    }
    Val(source_type)
}

sema_marker_rules_catalog_has_menu: fn(menus: [TAppliedRuleArgumentMenu], name: String) -> Bool Never! {
    loop menu in menus {
        if menu.name == name -> return true
    }
    false
}

// The applied-rule rows are the sole rule source (the registration table's
// marker rows, JetFoundation REGISTRATION_TABLE).
// Menu rows are explicit carrier input because their canonical source is
// Core.rows's specialized `types { … }` metadata, not marker sites or Program
// policy declarations.
sema_marker_rules_build_catalog: fn(rows: [TAppliedRule], argument_menus: [TAppliedRuleArgumentMenu]) -> TAppliedRuleCatalog? {
    ^menus: [TAppliedRuleArgumentMenu]{}
    loop menu in argument_menus {
        loop existing in menus {
            if existing.name == menu.name -> return None
        }
        menus.push(
            TAppliedRuleArgumentMenu{
                name: menu.name,
                variants: menu.variants,
                first_variant_segment: menu.first_variant_segment,
            },
        )
    }
    loop rule in rows {
        loop parameter in rule.signature.params {
            menu_name: sema_marker_rules_rule_requires_menu(rule, parameter.source_type, parameter.kind)
            if menu_name != None && !sema_marker_rules_catalog_has_menu(menus, menu_name) {
                return None
            }
        }
        if rule.signature.variadic != None {
            source_type: rule.signature.variadic_source_type ?? return None
            variadic_kind: rule.signature.variadic ?? return None
            menu_name: sema_marker_rules_rule_requires_menu(rule, source_type, variadic_kind)
            if menu_name != None && !sema_marker_rules_catalog_has_menu(menus, menu_name) {
                return None
            }
        }
    }
    Val(TAppliedRuleCatalog{rows: rows, argument_menus: menus})
}

sema_marker_rules_catalog_rule_index: fn(rules: [TAppliedRule], name: String) -> Int? {
    loop (index, rule) in rules {
        if rule.name == name -> return Val(index)
    }
    None
}

// A checked text block whose declared rule takes a type as its first header
// argument (`#SQL(Row) {{ … }}`, `row: Type` in the Prelude declaration): the
// header names a declared type position.
sema_marker_rules_type_header: fn(program: SemaProgramTables, name: String) -[]> Bool {
    graph: program.registration_graph
    if graph.marker_catalog == .Val(registry) {
        index: sema_marker_rules_catalog_rule_index(registry.applied_rules, name) ?? return false
        if registry.applied_rules[index].signature.params.len() > 0 {
            return registry.applied_rules[index].signature.params[0].source_type == "Type"
        }
    }
    false
}

sema_marker_rules_user_rule_index: fn(registry: SemaScopeMembersMarkerRegistry, marker: Marker) -> Int? {
    loop (index, rule) in registry.marker_rules {
        if marker.declaration_module != None {
            if rule.declaration_module == marker.declaration_module && rule.declaration_span == marker.declaration_span {
                return Val(index)
            }
        } else if rule.name == marker.name && rule.declaration_module == None { return Val(index) }
    }
    None
}

sema_marker_rules_builtin_index: fn(registry: SemaScopeMembersMarkerRegistry, marker: Marker) -> Int? {
    if marker.declaration_module != None -> return None
    sema_marker_rules_catalog_rule_index(registry.applied_rules, marker.name)
}

sema_marker_rules_menu_index: fn(menus: [TAppliedRuleArgumentMenu], name: String) -> Int? {
    loop (index, menu) in menus {
        if menu.name == name -> return Val(index)
    }
    None
}

sema_marker_rules_marker_expression: fn(marker: Marker, index: Int) -> Expr? {
    if index < 0 || index >= marker.args.len() -> return None
    if marker.args[index] == .Expr(value) -> return Val(value)
    None
}

sema_marker_rules_label: fn(marker: Marker, index: Int) -> String? {
    if index < 0 || index >= marker.arg_labels.len() -> return None
    if marker.arg_labels[index] == .Val(label) {
        // `#State(A -> B)`'s arrow binds B to the next
        // parameter, as a positional argument does.
        if label.name == STATE_ARROW_LABEL -> return None
        return Val(label.name)
    }
    None
}

// `formats` holds the codec format names a `#Rename` takes a label for
// beyond its parameters (SemaScopeMembersMarkerRegistry.format_names); None
// takes any such label, for a caller that reads only the bound parameters.
sema_marker_rules_marker_signature_bindings: fn(marker: Marker, signature: TAppliedRuleSignature, formats: [String]?) -> [SemaMarkerRuleArgumentBinding]? {
    if marker.args.len() != marker.arg_labels.len() -> return None
    ^bindings: [SemaMarkerRuleArgumentBinding]{}
    // A bare `#Unsafe` binds nothing; its missing reason is E3112's, not
    // E0930's.
    if sema_marker_is_hook(marker, MarkerHook.Unsafe) && marker.args.len() == 0 {
        return Val(bindings)
    }
    ^supplied: [Bool]{}
    loop _ in signature.params { supplied.push(false) }
    meta: sema_marker_is_hook(marker, MarkerHook.Meta)
    if meta && marker.arg_labels.len() == marker.args.len() {
        ^all_named: true
        loop label in marker.arg_labels {
            if label == None -> all_named = false
        }
        if all_named {
            loop source_index in 0..<marker.args.len() {
                label: sema_marker_rules_label(marker, source_index) ?? return None
                ^selected: Int?{None}
                loop (index, parameter) in signature.params {
                    if parameter.name == label -> selected = Val(index)
                }
                parameter_index: selected ?? return None
                bindings.push(SemaMarkerRuleArgumentBinding{source_index: source_index, parameter_index: Val(parameter_index), kind: signature.params[parameter_index].kind})
            }
            return Val(bindings)
        }
    }
    if sema_marker_is_hook(marker, MarkerHook.Policy) {
        kind: signature.variadic ?? return None
        loop source_index in 0..<marker.args.len() {
            ^label: sema_marker_rules_label(marker, source_index)
            if label != None {
                name: label ?? return None
                if name != "copies" && name != "writes" && name != "failures" && name != "sentries" {
                    return None
                }
            }
            bindings.push(SemaMarkerRuleArgumentBinding{source_index: source_index, parameter_index: None, kind: kind})
        }
        return Val(bindings)
    }
    rename: sema_marker_is_hook(marker, MarkerHook.Rename)
    ^format_labels: [String]{}
    ^next_positional: 0
    ^saw_named: false
    loop source_index in 0..<marker.args.len() {
        ^label: sema_marker_rules_label(marker, source_index)
        if label == None -> label = sema_marker_rules_flag_label(marker, source_index, signature)
        ^parameter_index: Int?{None}
        if {
            label != None -> {
                name: label ?? return None
                saw_named = true
                ^selected: Int?{None}
                loop (index, parameter) in signature.params {
                    if parameter.name == name -> selected = Val(index)
                }
                // A `#Rename` label naming a codec format, not a parameter.
                if rename && selected == None {
                    if format_labels.contains(name) -> return None
                    if formats == .Val(names) && !names.contains(name) -> return None
                    format_labels.push(name)
                    bindings.push(SemaMarkerRuleArgumentBinding{source_index: source_index, parameter_index: None, kind: TAppliedRuleArgKind.String})
                    next
                }
                index: selected ?? return None
                if supplied[index] && !meta -> return None
                supplied[index] = true
                parameter_index = Val(index)
            }
            else -> {
                if saw_named -> return None
                loop next_positional < supplied.len() && supplied[next_positional] {
                    next_positional += 1
                }
                if {
                    next_positional < supplied.len() -> {
                        ^selected: next_positional
                        supplied[selected] = true
                        parameter_index = Val(selected)
                        next_positional += 1
                    }
                    signature.variadic == None -> { return None }
                }
            }
        }
        ^kind: if parameter_index == {
            .Val(index) -> signature.params[index].kind
            .None -> signature.variadic ?? return None
        }
        bindings.push(SemaMarkerRuleArgumentBinding{source_index: source_index, parameter_index: parameter_index, kind: kind})
    }
    loop (index, parameter) in signature.params {
        if !supplied[index] && parameter.default_source == None -> return None
    }
    Val(bindings)
}

// A bare word naming a Bool parameter is that flag set: `#Meta(tunable)`,
// `#Codable(published)`.
sema_marker_rules_flag_label: fn(marker: Marker, source_index: Int, signature: TAppliedRuleSignature) -> String? {
    expression: sema_marker_rules_marker_expression(marker, source_index) ?? return None
    if expression == .Ident(name, _, _) {
        loop parameter in signature.params {
            if parameter.name == name && parameter.kind == TAppliedRuleArgKind.Bool {
                return Val(name)
            }
        }
    }
    None
}

sema_marker_rules_bare_flag: fn(argument: Expr, parameter_index: Int?, signature: TAppliedRuleSignature) -> Bool {
    index: parameter_index ?? return false
    if argument == .Ident(name, _, _) -> return name == signature.params[index].name
    false
}

sema_marker_rules_signature_text: fn(name: String, signature: TAppliedRuleSignature) -> String Never! {
    ^parts: [String]{}
    loop parameter in signature.params {
        ^default: ""
        ^default_value_option: parameter.default_source
        if default_value_option != None {
            default_value: default_value_option ?? ""
            default = "{{{default_value}}}"
        }
        parts.push("{parameter.name}: {parameter.source_type}{default}")
    }
    ^variadic_type_option: signature.variadic_source_type
    if variadic_type_option != None {
        variadic_type: variadic_type_option ?? ""
        parts.push("{variadic_type}...")
    }
    "{name}({parts.join(", ")})"
}

// The marker argument shape error for a registered rule, the
// declared-signature form for a source-declared one. The span is the marker
// span: the name through the closing `)`, without `#`. A `#X: true` line
// missing its Bool argument is the parentheses code.
sema_marker_rules_signature_error: fn(marker: Marker, signature: TAppliedRuleSignature, declared: Bool) -> Diagnostic {
    if sema_marker_rules_line_needs_bool(marker, signature) {
        diagnostic: sema_error("E0943", marker.span, "`#{marker.name}: true` gives `#{marker.name}` no arguments, but it needs a Bool", "`true` alone on a marker line applies the marker with its defaults, so a Bool argument is written in parentheses", "write `#{marker.name}: (true)`")
        return diagnostic_with_edit(diagnostic, TextEdit{span: Span{start: marker.span.end - 4, end: marker.span.end}, new_text: "(true)"})
    }
    ^expected: sema_marker_rules_signature_text(marker.name, signature)
    ^fix: if declared -> "match the declared signature `{expected}`" else -> "match the registered signature `{expected}`"
    sema_error("E0930", Span{start: marker.name_span.start, end: marker.span.end}, "`#{marker.name}` arguments do not match `{expected}`", "marker arguments use the same call grammar and typed signature as function arguments", fix)
}

// E0930 for a `#Rename` whose labels match neither its parameters nor a
// codec format's name, or repeat one: the message lists the formats.
sema_marker_rules_rename_error: fn(marker: Marker, signature: TAppliedRuleSignature, formats: [String]) -> Diagnostic {
    expected: sema_marker_rules_signature_text(marker.name, signature)
    sema_error("E0930", Span{start: marker.name_span.start, end: marker.span.end}, "`#{marker.name}` arguments do not match `{expected}` or a format label", "beside its parameters, `#{marker.name}` takes one label per codec format, the `name` of a `Format` impl: {formats.join(", ")}", "match `{expected}`, label a format once, or import the package that implements the format")
}

// The path an argument names; an `Effect` argument may name it denied, as
// `#FX(!Net, !FS)` does (`!Net` names `Net`), or scoped, as
// `#FX(FS.Read("data/"))` does (it names `FS.Read`).
sema_marker_rules_effect_path: fn(argument: Expr, source_type: String) -> String? {
    if source_type == "Effect" && argument == .Unary(op, operand, _, _) {
        if op == UnOp.Not {
            if sema_marker_rules_scoped_effect_path(operand) == .Val(scoped) -> return Val(scoped)
            return sema_marker_rules_argument_path(operand)
        }
    }
    if source_type == "Effect" && sema_marker_rules_scoped_effect_path(argument) == .Val(scoped) {
        return Val(scoped)
    }
    sema_marker_rules_argument_path(argument)
}

// The effect a scoped entry names: `FS.Read` in `FS.Read("data/")`, `Net` in
// `Net("api.example.com")`; None for any other argument. The parser checks
// the scope itself (parser_authority_effect_entry).
sema_marker_rules_scoped_effect_path: fn(argument: Expr) -> String? {
    // copy: the path outlives the argument.
    if argument == .Call(call, _) -> return Val(call.name.copy())
    if argument == .MethodCall(receiver, method, _, _, _, _, _) {
        receiver_path: sema_marker_rules_argument_path(receiver) ?? return None
        return Val("{receiver_path}.{method}")
    }
    None
}

// The span of the root an argument path starts from: `Bogus` in `Bogus.Write`,
// in `!Bogus` or in `Bogus.Write("data/")`.
sema_marker_rules_root_span: fn(argument: Expr) -> Span {
    if argument == .Unary(op, operand, _, _) {
        if op == UnOp.Not -> return sema_marker_rules_root_span(operand)
    }
    if argument == .Field(base, _, _, _) -> return sema_marker_rules_root_span(base)
    if argument == .MethodCall(receiver, _, _, _, _, _, _) {
        return sema_marker_rules_root_span(receiver)
    }
    expr_span(argument)
}

// Whether an argument names an item; an `Effect` argument may name it denied
// or scoped.
sema_marker_rules_names_item: fn(argument: Expr, source_type: String) -> Bool {
    if source_type == "Effect" && argument == .Unary(op, operand, _, _) {
        if op == UnOp.Not {
            return sema_marker_rules_names_item(operand, "") || sema_marker_rules_scoped_effect_path(operand) != None
        }
    }
    if source_type == "Effect" && sema_marker_rules_scoped_effect_path(argument) != None {
        return true
    }
    argument == .Ident(_, _, _) || argument == .Field(_, _, _, _) || argument == .EnumLit(_, _, _, _, _, _, _)
}

// A closed-menu word is written as a variant (`.Camel`); a bare name is a
// value, so `#Rename(FIELD_NAME)` reads the constant and must be a String.
sema_marker_rules_names_menu_word: fn(argument: Expr) -> Bool {
    argument == .EnumLit(_, _, _, _, _, _, _)
}

sema_marker_rules_argument_path: fn(expression: Expr) -> String? {
    if expression == .Ident(name, _, _) -> return Val(name)
    if expression == .Field(base, member, _, _) {
        path: sema_marker_rules_argument_path(base) ?? return None
        return Val("{path}.{member}")
    }
    if expression == .EnumLit(_, name, _, _, _, _, _) -> return Val(name)
    None
}

sema_marker_rules_staged_argument_value: fn(values: [SemaComptimeItemValue], check: SemaBodyCheck, marker: Marker, source_index: Int) -> TComptimeValue? {
    destination_suffix: if source_index == 0 -> ".marker.{marker.name}.{marker.name_span.start}" else -> ".marker.{marker.name}.{marker.name_span.start}.arg.{source_index}"
    loop value in values {
        if value.kind == SemaComptimeItemKind.MarkerArgument && value.module_identity == check.environment.module_identity && value.destination_key.ends_with(destination_suffix) {
            return Val(value.value)
        }
    }
    None
}

// `key` is the constant's key (a body's own constant has its body's key).
sema_marker_rules_constant_for_reference: fn(symbol: SemaNameReferent, key: String, references: [SemaNameReferenceFact], reference_start: Int, check: SemaBodyCheck, values: [SemaComptimeItemValue]) -> TComptimeValue? {
    ^found: false
    loop index in reference_start..<references.len() {
        ^reference: references[index]
        if reference.symbol.id == symbol.id && reference.symbol.kind == SymbolKind.Constant {
            found = true
            break
        }
    }
    if !found -> return None
    loop value in values {
        if value.kind == SemaComptimeItemKind.Constant && value.module_identity == symbol.module_identity && value.key == key {
            return Val(value.value)
        }
    }
    graph: check.program.registration_graph
    module_index: sema_registration_module_index(graph, symbol.module_identity) ?? return None
    loop constant_index in 0..<graph.modules[module_index].constants.len() {
        if graph.modules[module_index].constants[constant_index].symbol.id == symbol.id {
            value: graph.modules[module_index].constants[constant_index].declaration.ct ?? return None
            return sema_checked_comptime(value)
        }
    }
    None
}

sema_marker_rules_constant_value: fn(checked: TExpr, marker: Marker, source_index: Int, reference_start: Int, check: SemaBodyCheck, values: [SemaComptimeItemValue]) -> TComptimeValue? {
    if source_index == 0 && marker.ct == .Val(value) -> return sema_checked_comptime(value)
    staged: sema_marker_rules_staged_argument_value(values, check, marker, source_index)
    if staged != None -> return staged
    direct: sema_expr_comptime_value(checked, check.context)
    if direct != None -> return direct
    if checked.kind == .Flat(index) && check.context.arena.tree.nodes[index - check.context.arena.tree.node_base].kind == .ConstRef(symbol) {
        loop reference in check.context.name_references {
            if reference.symbol.id == symbol && reference.symbol.kind == SymbolKind.Constant {
                key: sema_symbol_key(check.program.*, check.context, symbol)
                return sema_marker_rules_constant_for_reference(reference.symbol, key, check.context.name_references, reference_start, check, values)
            }
        }
    }
    None
}

// The argument was just checked in this module (`reference_start` onward in
// `check.context.name_references`), against the environment whose graph already
// carries `values`, so its constant dependencies come from those references
// instead of a second check on a copy of the graph.
sema_marker_rules_comptime_source: fn(marker: Marker, source_index: Int, expression: Expr, expected_type: Type?, reference_start: Int, check: SemaBodyCheck, values: [SemaComptimeItemValue]) -> SemaComptimeItemSource? {
    // Snapshot: a marker argument is staged only for a registered module.
    if check.program.registration_graph.mode == .Snapshot -> return None
    graph: check.program.registration_graph
    destination_key: "{marker.name}.marker.{marker.name_span.start}.arg.{source_index}"
    ^source: SemaComptimeItemSource{
        module_identity: check.environment.module_identity,
        key: "{module_text(graph.module_table, check.environment.module_identity)}.{destination_key}",
        destination_key: destination_key,
        name: "#{marker.name} argument {source_index + 1}",
        source_file: check.environment.source_file,
        kind: SemaComptimeItemKind.MarkerArgument,
        expression: expression,
        expected_type: expected_type,
        span: expr_span(expression),
        dependencies: [String]{},
        checked_text: None,
    }
    references: loop index in reference_start..<check.context.name_references.len() -> check.context.name_references[index]
    source.dependencies = sema_comptime_dependencies_from_references(graph, references, values)
    Val(source)
}

sema_marker_rules_observe_argument: fn(marker: Marker, source_index: Int, expected_type: Type?, capture_constant: Bool, argument: Expr, check: ^SemaBodyCheck, values: [SemaComptimeItemValue]) -> SemaMarkerRuleArgumentObservation {
    ^diagnostics: [Diagnostic]{}
    ^checked_expected: expected_type
    graph: check.program.registration_graph
    if checked_expected == .Val(required) {
        checked_expected = Val(sema_type_resolve_declared_with_generics(graph, required, check.environment.module_identity, check.environment.generic_params))
    }
    // Probed on the live tables, rolled back below.
    probe_scope_mark: sema_scope_mark(check.scopes)
    probe_fork: sema_ownership_fork(check.state)
    probe_context_mark: sema_check_context_mark(check.context)
    ^reference_start: check.context.name_references.len()
    ^request_start: check.context.comptime_requests.len()
    sema_body_check_swap_diagnostics(check, diagnostics)
    ^checked: sema_check_expression(argument, checked_expected, check)
    sema_body_check_swap_diagnostics(check, diagnostics)
    sema_ownership_fork_rollback(check.state, probe_fork)
    sema_ownership_fork_close(check.state, probe_fork)
    ^checked_value: false
    ^constant: TComptimeValue?{None}
    ^staged_source: SemaComptimeItemSource?{None}
    ^observed_type: Type?{None}
    if checked == .Val(value) {
        ^required: checked_expected
        if required != None {
            required_type: required ?? value.ty
            ^assignable: Val(sema_type_assignable(required_type, value.ty))
            assignable = sema_type_assignable_in_graph_with_generics(graph, required_type, value.ty, check.environment.module_identity, check.environment.generic_params)
            if {
                assignable == (Val(false)) -> {
                    diagnostics.push(sema_type_mismatch(required_type, value.ty, value.span, check.program.*))
                    checked = None
                }
                assignable == None -> { checked = None }
            }
        }
        if checked != None {
            checked_value = true
            observed_type = Val(value.ty)
            if capture_constant {
                constant = sema_marker_rules_constant_value(value, marker, source_index, reference_start, check, values)
                if constant == None && sema_marker_rules_explicit_constant(argument, check.scopes) {
                    staged_source = sema_marker_rules_comptime_source(marker, source_index, argument, checked_expected, reference_start, check, values)
                }
            }
        }
    }
    requests: loop index in request_start..<check.context.comptime_requests.len() -> check.context.comptime_requests[index]
    sema_check_context_rollback(check.context, probe_context_mark.move())
    sema_scope_rollback(check.scopes, probe_scope_mark)
    SemaMarkerRuleArgumentObservation{
        ty: observed_type,
        constant: constant,
        checked: checked_value,
        comptime_requests: requests,
        comptime_source: staged_source,
        diagnostics: diagnostics,
    }
}

// Compile time is always explicit, so a rule argument is evaluated only when
// it is written as a constant: literals (including unit and enum literals),
// type-, enum- or module-qualified members, module constants, prepared
// values, and negation or arithmetic over those. A local binding or a
// function call never counts as a constant here.
sema_marker_rules_explicit_constant: fn(expression: Expr, scopes: SemaScopeTable) -> Bool Never! {
    if expression == {
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .Absent(_, _) -> return true
        .UnitLit(_, _, _, _, _, _, _) | .ComptimeName(_, _, _, _) -> return true
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Interp(inner, _) {
                    if !sema_marker_rules_explicit_constant(inner, scopes) -> return false
                }
            }
            return true
        }
        .Paren(inner, _, _) | .Unary(_, inner, _, _) | .Present(inner, _, _) -> return sema_marker_rules_explicit_constant(inner, scopes)
        .Binary(_, left, right, _, _) -> return sema_marker_rules_explicit_constant(left, scopes) && sema_marker_rules_explicit_constant(right, scopes)
        .CompareChain(operands, _, _, _, _) | .ListLit(operands, _, _) -> {
            loop operand in operands {
                if !sema_marker_rules_explicit_constant(operand, scopes) -> return false
            }
            return true
        }
        .TupleLit(fields, _, _, _) -> {
            loop field in fields {
                if !sema_marker_rules_explicit_constant(field.value, scopes) -> return false
            }
            return true
        }
        .MapLit(entries, _, _) -> {
            loop entry in entries {
                if !sema_marker_rules_explicit_constant(entry.key, scopes) || !sema_marker_rules_explicit_constant(entry.value, scopes) {
                    return false
                }
            }
            return true
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            loop arg in args {
                value: if arg == {
                    .Positional(inner) -> inner
                    .Named(_, inner) -> inner
                }
                if !sema_marker_rules_explicit_constant(value, scopes) -> return false
            }
            return true
        }
        .Ident(name, _, _) -> {
            index: sema_scope_resolve_index(scopes, name) ?? return false
            return scopes.bindings[index].symbol.kind == SymbolKind.Constant
        }
        .Field(base, _, _, _) -> return sema_marker_rules_constant_qualifier(base, scopes)
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return false
    }
}

// The base of a member read `base.member` that keeps it constant: a type,
// enum, module or constant name (`Method.Get`, `math.PI`), or a value that
// is itself an explicit constant.
sema_marker_rules_constant_qualifier: fn(base: Expr, scopes: SemaScopeTable) -> Bool Never! {
    if base == {
        .Field(inner, _, _, _) -> return sema_marker_rules_constant_qualifier(inner, scopes)
        .Ident(name, _, _) -> {
            index: sema_scope_resolve_index(scopes, name) ?? return true
            kind: scopes.bindings[index].symbol.kind
            return kind != SymbolKind.Local && kind != SymbolKind.Parameter
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return sema_marker_rules_explicit_constant(base, scopes)
    }
}

sema_marker_rules_append_comptime_source: fn(sources: ^[SemaComptimeItemSource], source: ^^SemaComptimeItemSource) Never! {
    loop existing in sources {
        if existing.module_identity == source.module_identity && existing.key == source.key {
            return
        }
    }
    sources.push(source)
}

sema_marker_rules_append_comptime_requests: fn(requests: ^[SemaComptimeRequest], incoming: [SemaComptimeRequest]) Never! {
    loop request in incoming { requests.push(request.copy()) }
}

sema_marker_rules_menu_candidate: fn(path: String, menu: TAppliedRuleArgumentMenu) -> String Never! {
    ^segments: path.split(".").to_list()
    ^start: 0
    loop index in 0..<segments.len() {
        if segments[index] == menu.name && index + 1 < segments.len() {
            start = index + 1
            break
        }
    }
    return if menu.first_variant_segment -> segments[start] else -> segments[segments.len() - 1]
}

// A `.Variant` argument is underlined from the rule name; a bare or labeled
// argument from the `#`.
sema_marker_rules_unknown_variant_error: fn(marker: Marker, menu: TAppliedRuleArgumentMenu, written: String, argument: Expr) -> Diagnostic {
    ^variants: (loop variant in menu.variants -> "`{variant}`")
    ^choices: variants.join(", ")
    start: if argument == .EnumLit(_, _, _, _, _, _, _) -> marker.name_span.start else -> marker.span.start
    sema_error("E0930", Span{start: start, end: marker.span.end}, "`#{marker.name}` has no `{menu.name}` called `{written}`", "`{menu.name}` is a closed menu: {choices}", "pick one of {choices}")
}

priv sema_marker_rules_check_menu_element: fn(marker: Marker, menu: TAppliedRuleArgumentMenu, menu_type: String, element: Expr, check: ^SemaBodyCheck) -> Bool {
    path: sema_marker_rules_effect_path(element, menu_type) ?? return true
    candidate: sema_marker_rules_menu_candidate(path, menu)
    if candidate != "" && !menu.variants.contains(candidate) {
        // An unknown effect root is the effect vocabulary's own E0119, reported once.
        unknown: if menu.name == "Effect" -> sema_effect_unknown(candidate, sema_marker_rules_root_span(element)) else -> sema_marker_rules_unknown_variant_error(marker, menu, candidate, element)
        check.diagnostics.push(unknown)
        return false
    }
    true
}

sema_marker_rules_validate_argument_signature: fn(marker: Marker, signature: TAppliedRuleSignature, expected_types: [Type?], variadic_expected_type: Type?, declared: Bool, owns_menu: Bool, registry: SemaScopeMembersMarkerRegistry, check: ^SemaBodyCheck, values: [SemaComptimeItemValue], facts: ^[SemaMarkerRuleArgumentFact], comptime_sources: ^[SemaComptimeItemSource], comptime_requests: ^[SemaComptimeRequest]) -> Bool {
    bindings: sema_marker_rules_marker_signature_bindings(marker, signature, Val(registry.format_names)) ?? {
        failure: if sema_marker_is_hook(marker, MarkerHook.Rename) -> sema_marker_rules_rename_error(marker, signature, registry.format_names) else -> sema_marker_rules_signature_error(marker, signature, declared)
        check.diagnostics.push(failure)
        return false
    }
    ^valid: true
    ^had_declared_expression_error: false
    ^pending_facts: [SemaMarkerRuleArgumentFact]{}
    loop binding in bindings {
        expression: sema_marker_rules_marker_expression(marker, binding.source_index)
        if expression == None {
            if sema_marker_is_hook(marker, MarkerHook.Interrupt) && binding.source_index == 1 {
                pending_facts.push(SemaMarkerRuleArgumentFact{marker_span: marker.name_span, source_index: binding.source_index, parameter_index: binding.parameter_index, kind: binding.kind, ty: None, constant: None, checked: false, comptime_requests: [SemaComptimeRequest]{}})
                next
            }
            check.diagnostics.push(sema_marker_rules_signature_error(marker, signature, declared))
            return false
        }
        argument: expression
        ^source_type: ""
        if binding.parameter_index == {
            .Val(index) -> {
                if index < signature.params.len() {
                    source_type = signature.params[index].source_type
                }
            }
            .None -> { source_type = signature.variadic_source_type ?? "" }
        }
        if !declared && !owns_menu {
            // A `[Menu]` parameter checks each written element against the menu.
            list_menu: source_type.starts_with("[") && source_type.ends_with("]")
            menu_type: if list_menu -> source_type.slice(1, source_type.len() - 1) else -> source_type
            if sema_marker_rules_menu_index(registry.argument_menus, menu_type) == .Val(menu_index) {
                ^menu: registry.argument_menus[menu_index]
                if menu.variants.len() > 0 {
                    if list_menu {
                        if argument == .ListLit(items, _, _) {
                            loop element in items {
                                if !sema_marker_rules_check_menu_element(marker, menu, menu_type, element, check) -> return false
                            }
                        }
                    } else if !sema_marker_rules_check_menu_element(marker, menu, menu_type, argument, check) {
                        return false
                    }
                }
            }
        }
        ^observation_ty: Type?{None}
        ^observation_constant: TComptimeValue?{None}
        ^observation_checked: false
        ^observation_requests: [SemaComptimeRequest]{}
        ^observe: true
        ^unit_argument: argument == .UnitLit(_, _, _, _, _, _, _)
        if {
            !declared && (binding.kind == TAppliedRuleArgKind.Ident || binding.kind == TAppliedRuleArgKind.Any || (binding.kind == TAppliedRuleArgKind.DurationOrString && unit_argument) || (binding.kind == TAppliedRuleArgKind.StringOrMenu && sema_marker_rules_names_menu_word(argument)) || binding.kind == TAppliedRuleArgKind.EffectRoots) -> {
                observe = false
            }
            !declared && binding.kind == TAppliedRuleArgKind.Bool && sema_marker_rules_bare_flag(argument, binding.parameter_index, signature) -> {
                observation_ty = Val(Type.Bool)
                observe = false
            }
        }
        if observe {
            ^capture_constant: declared || binding.kind == TAppliedRuleArgKind.String || binding.kind == TAppliedRuleArgKind.Bool || binding.kind == TAppliedRuleArgKind.Int
            observed: if {
                !declared -> sema_marker_rules_observe_argument(marker, binding.source_index, None, capture_constant, argument, check, values)
                binding.parameter_index == .Val(index) -> sema_marker_rules_observe_argument(marker, binding.source_index, if index < expected_types.len() -> expected_types[index] else -> None, capture_constant, argument, check, values)
                else -> sema_marker_rules_observe_argument(marker, binding.source_index, variadic_expected_type, capture_constant, argument, check, values)
            }
            if declared && observed.diagnostics.len() > 0 -> had_declared_expression_error = true
            loop diagnostic in observed.diagnostics { check.diagnostics.push(diagnostic) }
            if observed.comptime_source == .Val(source) {
                sema_marker_rules_append_comptime_source(comptime_sources, source)
            }
            sema_marker_rules_append_comptime_requests(comptime_requests, observed.comptime_requests)
            observation_ty = observed.ty
            observation_constant = observed.constant
            observation_checked = observed.checked
            observation_requests = observed.comptime_requests
        }
        ^matches: if {
            declared -> observation_checked
            else -> if binding.kind == {
                .Any -> true
                .String -> observation_ty == (Val(Type.String))
                .Path -> observation_ty == (Val(Type.Named{name: "Path"}))
                .Ident -> sema_marker_rules_names_item(argument, source_type)
                .Bool -> observation_ty == (Val(Type.Bool))
                .Int -> observation_ty == (Val(Type.Int))
                .DurationOrString -> unit_argument || observation_ty == (Val(Type.String)) || observation_ty == (Val(Type.Named{name: "Duration"}))
                .DurationOrInstant -> observation_ty == (Val(Type.Named{name: "Duration"})) || sema_stmt_deadline_instant(observation_ty ?? Type.Int)
                .StringOrMenu -> sema_marker_rules_names_menu_word(argument) || observation_ty == (Val(Type.String))
                .EffectRoots -> argument == .ListLit(_, _, _)
            }
        }
        if !matches -> valid = false
        pending_facts.push(
            SemaMarkerRuleArgumentFact{
                marker_span: marker.name_span,
                source_index: binding.source_index,
                parameter_index: binding.parameter_index,
                kind: binding.kind,
                ty: observation_ty,
                constant: observation_constant,
                checked: observation_checked,
                comptime_requests: observation_requests,
            },
        )
    }
    if !valid {
        if !had_declared_expression_error {
            check.diagnostics.push(sema_marker_rules_signature_error(marker, signature, declared))
        }
        return false
    }
    loop fact in pending_facts { facts.push(fact) }
    true
}

// A builtin marker binds its arguments against its registered rule signature,
// each argument checked in the scope of the site that carries it (E0930). The
// sites: a local binding, a marked statement or block
// (sema_marker_rules_check_statement_facts), a `#Context` block
// (sema_marker_rules_check_context_fact), a function or method, and the
// static-product sites (sema_marker_rules_check_static_sites). True when the
// arguments bind or no registered rule governs the marker.
sema_marker_rules_check_rule_signature: fn(marker: Marker, check: ^SemaBodyCheck) -> Bool {
    if marker.declaration_module != None -> return true
    graph: check.program.registration_graph
    if graph.marker_catalog == .Val(registry) {
        rule_index: sema_marker_rules_builtin_index(registry, marker) ?? return true
        expected_types: (loop _ in registry.applied_rules[rule_index].signature.params -> Type?{None})
        ^facts: [SemaMarkerRuleArgumentFact]{}
        ^sources: [SemaComptimeItemSource]{}
        ^requests: [SemaComptimeRequest]{}
        return sema_marker_rules_validate_argument_signature(marker, registry.applied_rules[rule_index].signature, expected_types, None, false, registry.applied_rules[rule_index].owns_menu, registry, check, [SemaComptimeItemValue]{}, facts, sources, requests)
    }
    true
}

// A `#X: true` line whose rule's first required argument is a Bool: `true`
// there means "no arguments", so the Bool is missing.
sema_marker_rules_line_needs_bool: fn(marker: Marker, signature: TAppliedRuleSignature) -> Bool Never! {
    if !marker.inside || marker.negated || marker.args.len() != 0 -> return false
    loop parameter in signature.params {
        if parameter.default_source != None -> next
        return parameter.kind == TAppliedRuleArgKind.Bool || parameter.source_type == "Bool"
    }
    false
}

// Every marker of `markers` through sema_marker_rules_check_rule_signature;
// true when all of them bind.
sema_marker_rules_check_rule_signatures: fn(markers: [Marker], check: ^SemaBodyCheck) -> Bool {
    ^valid: true
    loop marker in markers {
        if !sema_marker_rules_check_rule_signature(marker, check) -> valid = false
    }
    valid
}

// A function's markers through sema_marker_rules_check_rule_signature, except
// its `#On`: at the function site `#On(moment)` hooks a compiler or build
// moment and `#On(stage, Marker)` joins a tool stage (ToolStages.jet), so the
// stage and the hook's shape are checked, not the statement site's `build`
// condition. True when all of them bind.
sema_marker_rules_check_function_markers: fn(func: Func, check: ^SemaBodyCheck) -> Bool {
    ^valid: true
    loop marker in func.markers {
        bound: if marker.name == MARKER_ON && marker.declaration_module == None -> sema_marker_rules_check_stage_hook(func, marker, check.diagnostics) else -> sema_marker_rules_check_rule_signature(marker, check)
        if !bound -> valid = false
    }
    valid
}

// A function's `#On` names a moment of COMPILER_EVENTS, or a stage of
// TOOL_STAGES and the marker whose blocks it reads (E0930).
sema_marker_rules_check_stage_hook: fn(func: Func, marker: Marker, diagnostics: ^[Diagnostic]) -> Bool {
    hook: stage_hook(marker) ?? {
        diagnostics.push(sema_error("E0930", marker.span, "`#On` on a function names a moment, or a tool stage and a marker", "a function hooks a compiler or build moment with `#On(moment)` and joins a tool stage with `#On(stage, Marker)`", "write a moment, such as `#On(compiler.settled)`, or a tool stage and the marker whose blocks the function reads, such as `#On(fmt.block, SQL)`"))
        return false
    }
    if hook.marker == "" {
        return sema_marker_rules_check_moment_hook(func, marker, hook.stage, diagnostics)
    }
    stages: (loop row in TOOL_STAGES -> "`{row.name}`").join(", ")
    ^known: -1
    loop (index, row) in TOOL_STAGES {
        if row.name == hook.stage -> known = index
    }
    if known < 0 {
        diagnostics.push(sema_error("E0930", marker.span, "`{hook.stage}` is not a tool stage", "a function joins a tool stage with `#On(stage, Marker)`; the stages are {stages}", "name one of the tool stages"))
        return false
    }
    answer: TOOL_STAGES[known].answer
    shape: "`{func.name}: fn(block: compiler.MarkerBlock) -> {answer}`"
    takes_block: func.params.len() == 1 && func.type_params.len() == 0 && sema_marker_rules_unqualified_type(type_name(func.params[0].ty)) == "MarkerBlock"
    returned: if func.return_type == .Val(ty) -> sema_marker_rules_unqualified_type(type_name(ty)) else -> ""
    if !takes_block || returned != sema_marker_rules_unqualified_type(answer) {
        diagnostics.push(sema_error("E0930", func.name_span, "a `{hook.stage}` hook takes one `compiler.MarkerBlock` and answers `{answer}`", "the tool calls the function with each `#{hook.marker}` block it reads and reads the stage's answer", "declare {shape}"))
        return false
    }
    true
}

// A moment hook names a row of COMPILER_EVENTS (`compiler.settled`), takes
// the one payload that row's `compiler.Event` variant carries, and returns
// the row's answer when it has one: a `build.link` or `build.before_write`
// hook returns the `BuildAction` Jet runs at that moment (E0930).
sema_marker_rules_check_moment_hook: fn(func: Func, marker: Marker, moment: String, diagnostics: ^[Diagnostic]) -> Bool {
    ^payload: ""
    ^answer: ""
    loop row in COMPILER_EVENTS {
        if row.name == moment {
            payload = row.payload
            answer = row.answer
        }
    }
    if payload == "" {
        moments: (loop row in COMPILER_EVENTS -> "`{row.name}`").join(", ")
        diagnostics.push(sema_error("E0930", marker.span, "`{moment}` is not a compiler or build moment", "a function hooks a moment of `compiler.Event` with `#On(moment)`; the moments are {moments}", "name one of the moments"))
        return false
    }
    takes_payload: func.params.len() == 1 && func.type_params.len() == 0 && sema_marker_rules_unqualified_type(type_name(func.params[0].ty)) == payload
    if !takes_payload {
        shape: if answer == "" -> "" else -> " -> build.{answer}"
        diagnostics.push(sema_error("E0930", func.name_span, "a `{moment}` hook takes one `compiler.{payload}`", "the compiler calls the function with the payload of the moment's `compiler.Event` variant", "declare `{func.name}: fn(value: compiler.{payload}){shape}`"))
        return false
    }
    if answer == "" -> return true
    returned: if func.return_type == .Val(ty) -> sema_marker_rules_unqualified_type(type_name(ty)) else -> ""
    if returned != answer {
        diagnostics.push(sema_error("E0930", func.name_span, "a `{moment}` hook returns a `build.{answer}`", "Jet runs the step the hook returns at that moment", "declare `{func.name}: fn(value: compiler.{payload}) -> build.{answer}`"))
        return false
    }
    true
}

// A written type with its module qualifiers dropped: `[core.compiler.Token]`
// and `[compiler.Token]` are both `[Token]`.
sema_marker_rules_unqualified_type: fn(text: String) -> String Never! {
    ^out: [U8]{}
    ^word: [U8]{}
    loop byte in text.bytes() {
        code: Int{byte}
        if code == 46 {
            word = [U8]{}
            next
        }
        if (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || (code >= 48 && code <= 57) || code == 95 {
            word.push(byte)
            next
        }
        loop kept in word -> out.push(kept)
        word = [U8]{}
        out.push(byte)
    }
    loop kept in word -> out.push(kept)
    String.from_bytes(out) ?? text
}

// The marker of a marked statement or block is the module's Statement- or
// Block-site application targeting the statement. `#Meta` is its binding's
// (Statements/Bindings.jet) and `#Context` or `#Deadline` its block's
// (sema_marker_rules_check_context_fact). A marker with a site-dependent
// signature (`#HTML(path)` at the file site, bare `#HTML { … }` at the block
// site) is bare at its block site. The block form's header is the checked text
// block's own law (sema_stmt_check_scope_member, E0617).
sema_marker_rules_check_statement_facts: fn(target: Span, check: ^SemaBodyCheck) {
    graph: check.program.registration_graph
    if graph.marker_catalog == .Val(registry) {
        row: sema_scope_caller_row(check.environment.*, graph)
        if row < 0 {
            return
        }
        loop index in 0..<graph.modules[row].program.rule_facts.len() {
            // The statement walk asks once per statement, over every
            // application of the module, so the target compares field by
            // field rather than through a `Val(target)` built each pass.
            fact_target: graph.modules[row].program.rule_facts[index].target ?? next
            if fact_target.start != target.start || fact_target.end != target.end -> next
            if graph.modules[row].program.rule_facts[index].site != (Val(RuleSite.Block)) && graph.modules[row].program.rule_facts[index].site != (Val(RuleSite.Statement)) {
                next
            }
            if sema_marker_is_hook(graph.modules[row].program.rule_facts[index].marker, MarkerHook.Meta) || sema_marker_is_hook(graph.modules[row].program.rule_facts[index].marker, MarkerHook.Context) || sema_marker_is_hook(graph.modules[row].program.rule_facts[index].marker, MarkerHook.Deadline) {
                next
            }
            if graph.modules[row].program.rule_facts[index].site == (Val(RuleSite.Block)) && sema_marker_rules_block_form_is_bare(registry, graph.modules[row].program.rule_facts[index].marker) {
                next
            }
            ^_: sema_marker_rules_check_rule_signature(graph.modules[row].program.rule_facts[index].marker, check)
        }
    }
}

// A builtin rule registered at both the file and the block site takes its
// signature at the file site, so its block form is bare.
sema_marker_rules_block_form_is_bare: fn(registry: SemaScopeMembersMarkerRegistry, marker: Marker) -> Bool {
    rule_index: sema_marker_rules_builtin_index(registry, marker) ?? return false
    registry.applied_rules[rule_index].sites.contains(sema_marker_rules_site_name(RuleSite.File)) && registry.applied_rules[rule_index].sites.contains(sema_marker_rules_site_name(RuleSite.Block))
}

// The block's `#Context` application binds against
// `Context(allocator:, logger:)`, its labels naming `#ContextKey` constants
// left out (ContextKeys.jet sema_context_marker_fields), and its `#Deadline`
// application against `Deadline(limit:)`. False when it does not bind; the
// field checks then stay quiet.
sema_marker_rules_check_context_fact: fn(span: Span, check: ^SemaBodyCheck) -> Bool {
    graph: check.program.registration_graph
    if graph.marker_catalog == None -> return true
    row: sema_scope_caller_row(check.environment.*, graph)
    if row < 0 -> return true
    loop index in 0..<graph.modules[row].program.rule_facts.len() {
        deadline: sema_marker_is_hook(graph.modules[row].program.rule_facts[index].marker, MarkerHook.Deadline)
        if (!deadline && !sema_marker_is_hook(graph.modules[row].program.rule_facts[index].marker, MarkerHook.Context)) || graph.modules[row].program.rule_facts[index].target != (Val(span)) {
            next
        }
        if deadline {
            return sema_marker_rules_check_rule_signature(graph.modules[row].program.rule_facts[index].marker, check)
        }
        return sema_marker_rules_check_rule_signature(sema_context_marker_fields(graph.modules[row].program.rule_facts[index].marker), check)
    }
    true
}

// A marker at a static-product site (the file, a type, a constant, a field, a
// variant, a test) binds its signature in the module's own scope, where its
// arguments can name only module items. A test's written name, `faults:` and
// `expected_fail:` are its `#Test` marker's arguments.
sema_marker_rules_check_static_sites: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, scopes: ^SemaScopeTable, diagnostics: ^[Diagnostic]) {
    graph: program.registration_graph
    if graph.marker_catalog == None {
        return
    }
    ^check: sema_body_check_init(@program, @environment)
    sema_body_check_swap_diagnostics(check, diagnostics)
    sema_body_check_swap_scopes(check, scopes)
    loop index in 0..<graph.modules[module_index].program.rule_facts.len() {
        if graph.modules[module_index].program.rule_facts[index].site != (Val(RuleSite.File)) {
            next
        }
        ^_: sema_marker_rules_check_rule_signature(graph.modules[module_index].program.rule_facts[index].marker, check)
    }
    loop item_index in 0..<graph.modules[module_index].program.items.len() {
        sema_marker_rules_check_static_item(graph.modules[module_index].program.items[item_index], check)
    }
    sema_body_check_swap_scopes(check, scopes)
    sema_body_check_swap_diagnostics(check, diagnostics)
}

sema_marker_rules_check_static_item: fn(item: Item, check: ^SemaBodyCheck) {
    if item == {
        .Struct(definition) -> {
            ^_: sema_marker_rules_check_rule_signatures(definition.type_markers, check)
            ^_: sema_marker_rules_check_rule_signatures(definition.serde_markers, check)
            loop field in definition.fields {
                ^_: sema_marker_rules_check_rule_signatures(field.serde_markers, check)
            }
        }
        .Enum(definition) -> {
            ^_: sema_marker_rules_check_rule_signatures(definition.type_markers, check)
            ^_: sema_marker_rules_check_rule_signatures(definition.serde_markers, check)
            loop variant in definition.variants {
                ^_: sema_marker_rules_check_rule_signatures(variant.serde_markers, check)
            }
        }
        .Distinct(definition) -> {
            ^_: sema_marker_rules_check_rule_signatures(definition.type_markers, check)
        }
        .Const(definition) -> {
            ^_: sema_marker_rules_check_rule_signatures(definition.markers, check)
            sema_context_key_check_declaration(definition, check.environment.module_name, check.diagnostics)
        }
        .Test(test) -> {
            ^args: [MarkerCallArg]{}
            ^labels: [CallLabel?]{}
            if test.name_expr == .Val(expression) {
                args.push(MarkerCallArg.Expr{value: expression})
                labels.push(None)
            }
            if test.faults_expr == .Val(expression) {
                args.push(MarkerCallArg.Expr{value: expression})
                labels.push(Val(CallLabel{name: "faults", span: expr_span(expression)}))
            }
            if test.expected_fail_expr == .Val(expression) {
                args.push(MarkerCallArg.Expr{value: expression})
                labels.push(Val(CallLabel{name: "expected_fail", span: expr_span(expression)}))
            }
            if args.len() == 0 {
                return
            }
            marker: Marker{name: "Test", negated: false, name_span: test.span, args: args, arg_labels: labels, span: test.span, ct: None}
            ^_: sema_marker_rules_check_rule_signature(marker, check)
        }
        .Func(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
}

// A local binding's `#Meta(...)` repeats a field (E0346) or has an empty
// (E0348) or not plain (E0347) category. It runs once the arguments bind to
// the signature. Only a written literal decides: a non-literal category that
// may name a comptime constant is left alone, and only an interpolated string
// is certainly not plain text.
sema_marker_rules_check_local_meta: fn(marker: Marker, diagnostics: ^[Diagnostic]) {
    ^seen: name_table_sized(2)
    loop index in 0..<marker.args.len() {
        expression: sema_marker_rules_marker_expression(marker, index) ?? next
        value_span: expr_span(expression)
        ^name: ""
        ^field_span: value_span
        if index < marker.arg_labels.len() && marker.arg_labels[index] == .Val(label) {
            name = label.name
            field_span = Span{start: label.span.start, end: value_span.end}
        } else if expression == .Ident(word, _, _) && word == "tunable" { name = word }
        if name != "category" && name != "tunable" && name != "maturity" -> next
        if name == "tunable" && expression == .Bool(flag, _, _) && !flag -> next
        category: if name == "category" -> sema_marker_rules_meta_literal_text(expression) else -> None
        sema_marker_rules_note_meta_field(name, expression, field_span, category, expression == .Str(_, _, _), seen, diagnostics)
    }
}

// The text of a plain quoted literal (`""` included), or None.
sema_marker_rules_meta_literal_text: fn(expression: Expr) -> String? Never! {
    if expression == .Str(parts, _, _) {
        if parts.len() == 0 -> return Val("")
        if parts.len() == 1 && parts[0] == .Lit(text) -> return Val(text)
    }
    None
}

// A repeat is E0346; a category is E0348 when its text is empty and E0347 when
// `plain_required` and it has no plain text.
sema_marker_rules_note_meta_field: fn(name: String, expression: Expr, field_span: Span, category: String?, plain_required: Bool, seen: ^NameTable, diagnostics: ^[Diagnostic]) {
    if name_find(seen, name) != None {
        if name == {
            "category" -> {
                diagnostics.push(sema_error("E0346", field_span, "`#Meta` repeats `category`", "`category` has one value; writing it twice would make tooling choose between two labels", "keep one `category: \"...\"` field"))
            }
            "tunable" -> {
                diagnostics.push(sema_error("E0346", field_span, "`#Meta` repeats `tunable`", "`tunable` is a flag; writing it twice does not add meaning", "keep one `tunable` field"))
            }
            "maturity" -> {
                diagnostics.push(sema_error("E0346", field_span, "`#Meta` repeats `maturity`", "a declaration has one maturity value", "keep one `maturity: .Experimental`, `.Tested`, or `.Hardened` field"))
            }
            else -> {}
        }
    }
    ^_: name_intern(seen, name)
    if name != "category" {
        return
    }
    value_span: expr_span(expression)
    if category == .Val(text) {
        if text.len() == 0 {
            diagnostics.push(sema_error("E0348", value_span, "`#Meta` category cannot be empty", "Canvas groups use this text as a visible label", "write a non-empty category, e.g. `category: \"Movement\"`"))
        }
        return
    }
    if !plain_required {
        return
    }
    why: if expression == .Str(_, _, _) -> "`category` is compile-time tooling data, not a runtime string" else -> "`category` is compile-time tooling data, not a runtime value"
    diagnostics.push(sema_error("E0347", value_span, "`#Meta` category needs plain quoted text", why, "write a string literal, e.g. `category: \"Movement\"`"))
}

sema_marker_rules_declared_signature: fn(rule: SemaScopeMembersMarkerRule) -> {signature: TAppliedRuleSignature, expected_types: [Type?], variadic_expected_type: Type?} Never! {
    ^params: [TAppliedRuleParameter]{}
    ^expected_types: [Type?]{}
    ^variadic: TAppliedRuleArgKind?{None}
    ^variadic_source_type: String?{None}
    ^variadic_expected_type: Type?{None}
    loop parameter in rule.params {
        if parameter.name.starts_with("$") -> next
        ^source_type: sema_marker_rules_type_name_for_parameter(parameter) ?? "Value"
        ^kind: sema_marker_rules_parameter_kind(parameter)
        ^default_source: if parameter.value != None -> Val("…") else -> None
        if parameter.variadic {
            variadic = Val(kind)
            variadic_source_type = Val(source_type)
            variadic_expected_type = parameter.ty
            next
        }
        params.push(TAppliedRuleParameter{name: parameter.name, kind: kind, source_type: source_type, default_source: default_source})
        expected_types.push(parameter.ty)
    }
    {expected_types: expected_types, signature: TAppliedRuleSignature{params: params, variadic: variadic, variadic_source_type: variadic_source_type}, variadic_expected_type: variadic_expected_type}
}

sema_marker_rules_declared_site_error: fn(marker: Marker, rule: SemaScopeMembersMarkerRule) -> Diagnostic {
    ^sites: (loop site in rule.sites -> ".{site}")
    ^allowed: if sites.len() == 0 -> "no sites" else -> sites.join(", ")
    sema_error("E0355", marker.name_span, "`#{marker.name}` cannot attach at this site", "the declared rule allows only these sites: {allowed}", "remove the marker or move it to one of its declared sites")
}

sema_marker_rules_applied_site_error: fn(marker: Marker, rule: TAppliedRule, site: RuleSite) -> Diagnostic {
    ^legal: (loop allowed_site in rule.sites -> "`{allowed_site}`")
    if rule.companion_site == .Val(companion) {
        legal.push("{companion.site} with companion `#{companion.rule}`")
    }
    ^allowed: if legal.len() == 0 -> "no active attachment sites" else -> legal.join(", ")
    ^fix: if rule.companion_site == None && rule.sites.len() == 1 && rule.sites[0] == "Constant" -> "write `#{marker.name} NAME: #run value` — a storage marker precedes a module constant" else -> "move `#{marker.name}` to one of its registered sites"
    sema_error("E0355", marker.span, "`#{marker.name}` cannot attach at the {sema_marker_rules_site_name(site)} site", "the registry allows `#{marker.name}` only at: {allowed}", fix)
}

sema_marker_rules_fact_allows: fn(rule: TAppliedRule, application: AppliedRuleApplication, facts: [AppliedRuleApplication]) -> Bool Never! {
    site: application.site ?? return true
    if rule.sites.contains(sema_marker_rules_site_name(site)) -> return true
    companion: rule.companion_site ?? return false
    if companion.site != sema_marker_rules_site_name(site) || application.target == None {
        return false
    }
    target: application.target ?? return false
    // The companion is a rule its declaring module also declares, so a fact
    // meets it only when it binds that module's declaration of that name.
    loop other in facts {
        if other.target == (Val(target)) && other.marker.declaration_module == application.marker.declaration_module && companion.rule == other.marker.name {
            return true
        }
    }
    false
}

// Identity of a marker's declaration: the module and declaration span of a
// declared rule (a marker with a declaration module matches only that module
// and span), else its name. Equal rows exactly when two markers name the
// same declaration, so dedupes probe a map instead of rescanning the list.
sema_marker_rules_declaration_key: fn(keys: ^SemaKeyRows, marker: Marker) -> Int Never! {
    if marker.declaration_module == .Val(owner_module) {
        declared_at: sema_key_span(keys, marker.declaration_span)
        return sema_key_pair(keys, Int{owner_module.id}, declared_at)
    }
    name: sema_key_text(keys, marker.name)
    sema_key_pair(keys, SEMA_KEY_NONE, name)
}

// Identity of a marker occurrence: its name span and its declaration.
sema_marker_rules_occurrence_key: fn(keys: ^SemaKeyRows, marker: Marker) -> Int Never! {
    at: sema_key_span(keys, Val(marker.name_span))
    declaration: sema_marker_rules_declaration_key(keys, marker)
    sema_key_pair(keys, at, declaration)
}

// Same occurrence on the same target.
sema_marker_rules_application_key: fn(keys: ^SemaKeyRows, application: AppliedRuleApplication) -> Int Never! {
    occurrence: sema_marker_rules_occurrence_key(keys, application.marker)
    target: sema_key_span(keys, application.target)
    sema_key_pair(keys, occurrence, target)
}

// Whether `marker`'s occurrence is new to `keys`; it is seen from now on.
sema_marker_rules_first_occurrence: fn(keys: ^SemaKeyRows, marker: Marker) -> Bool Never! {
    key: sema_marker_rules_occurrence_key(keys, marker)
    sema_key_first(keys, key)
}

// Whether `application` is new to `keys`; it is seen from now on.
sema_marker_rules_first_application: fn(keys: ^SemaKeyRows, application: AppliedRuleApplication) -> Bool Never! {
    key: sema_marker_rules_application_key(keys, application)
    sema_key_first(keys, key)
}

sema_marker_rules_attach: fn(markers: [Marker], target: Span, site: RuleSite, applications: ^[AppliedRuleApplication]) Never! {
    loop marker in markers {
        applications.push(AppliedRuleApplication{marker: marker, target: Val(target), site: Val(site)})
    }
}

sema_marker_rules_function_applications: fn(function: Func, site: RuleSite, applications: ^[AppliedRuleApplication]) Never! {
    sema_marker_rules_attach(function.markers, function.name_span, site, applications)
}

// An impl's markers that are rule applications: the parser owns
// `#Target(OS.…)` on an impl as its OS gate.
priv sema_marker_rules_attach_impl_markers: fn(markers: [Marker], os_target: String?, target: Span, site: RuleSite, applications: ^[AppliedRuleApplication]) Never! {
    loop marker in markers {
        if sema_marker_is_hook(marker, MarkerHook.Target) && os_target != None -> next
        applications.push(AppliedRuleApplication{marker: marker, target: Val(target), site: Val(site)})
    }
}

// The parser owns `#FX` on a module, a struct, an enum or a trait as its
// effect cap, so it is no rule application there.
priv sema_marker_rules_attach_without_cap: fn(markers: [Marker], target: Span, site: RuleSite, applications: ^[AppliedRuleApplication]) Never! {
    loop marker in markers {
        if sema_marker_is_hook(marker, MarkerHook.FX) -> next
        applications.push(AppliedRuleApplication{marker: marker, target: Val(target), site: Val(site)})
    }
}

sema_marker_rules_item_applications: fn(item: Item, applications: ^[AppliedRuleApplication]) Never! {
    if item == {
        .Func(function) -> {
            sema_marker_rules_function_applications(function, RuleSite.Function, applications)
        }
        .Struct(definition) -> {
            sema_marker_rules_attach_without_cap(definition.type_markers, definition.name_span, RuleSite.Type, applications)
            loop field in definition.fields {
                sema_marker_rules_attach(field.serde_markers, field.name_span, RuleSite.Field, applications)
            }
            loop method in definition.methods {
                sema_marker_rules_function_applications(method, RuleSite.Method, applications)
            }
            loop implementation in definition.trait_impls {
                sema_marker_rules_attach_impl_markers(implementation.markers, implementation.os_target, implementation.trait_span, RuleSite.Impl, applications)
                loop method in implementation.methods {
                    sema_marker_rules_function_applications(method, RuleSite.Method, applications)
                }
            }
        }
        .Enum(definition) -> {
            sema_marker_rules_attach_without_cap(definition.type_markers, definition.name_span, RuleSite.Type, applications)
            loop variant in definition.variants {
                sema_marker_rules_attach(variant.serde_markers, variant.name_span, RuleSite.Variant, applications)
            }
            loop method in definition.methods {
                sema_marker_rules_function_applications(method, RuleSite.Method, applications)
            }
            loop implementation in definition.trait_impls {
                sema_marker_rules_attach_impl_markers(implementation.markers, implementation.os_target, implementation.trait_span, RuleSite.Impl, applications)
                loop method in implementation.methods {
                    sema_marker_rules_function_applications(method, RuleSite.Method, applications)
                }
            }
        }
        .Distinct(definition) -> {
            sema_marker_rules_attach(definition.type_markers, definition.name_span, RuleSite.Type, applications)
        }
        .Impl(implementation) -> {
            sema_marker_rules_attach_impl_markers(implementation.markers, implementation.os_target, implementation.type_span, RuleSite.Impl, applications)
            loop method in implementation.methods {
                sema_marker_rules_function_applications(method, RuleSite.Method, applications)
            }
        }
        .Trait(definition) -> {
            sema_marker_rules_attach_without_cap(definition.markers, definition.name_span, RuleSite.Trait, applications)
            loop method in definition.methods {
                sema_marker_rules_attach(method.markers, method.name_span, RuleSite.Method, applications)
            }
        }
        .Module(declaration) -> {
            sema_marker_rules_attach(declaration.markers, declaration.name_span, RuleSite.Module, applications)
        }
        .CodeModule(code_module) -> {
            sema_marker_rules_attach_without_cap(code_module.markers, code_module.name_span, RuleSite.Module, applications)
            if code_module.body == .Val(body) {
                loop nested in body -> sema_marker_rules_item_applications(nested, applications)
            }
        }
        .TypeAlias(_) | .UnitFamily(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
}

priv SemaOwnedRuleApplications: struct {
    applications: [AppliedRuleApplication],
    owners: [Int],
}

priv sema_marker_rules_owned_item_applications: fn(item: Item, next_owner: ^Int, applications: ^[AppliedRuleApplication], owners: ^[Int]) Never! {
    owner: next_owner
    next_owner += 1
    if item == .CodeModule(code_module) {
        before: applications.len()
        sema_marker_rules_attach_without_cap(code_module.markers, code_module.name_span, RuleSite.Module, applications)
        loop _ in before..<applications.len() -> owners.push(owner)
        if code_module.body == .Val(body) {
            loop nested in body -> sema_marker_rules_owned_item_applications(nested, next_owner, applications, owners)
        }
        return
    }
    before: applications.len()
    sema_marker_rules_item_applications(item, applications)
    loop _ in before..<applications.len() -> owners.push(owner)
}

sema_marker_rules_owned_applications: fn(program: Program) -> SemaOwnedRuleApplications Never! {
    ^applications: program.rule_facts
    ^owners: loop _ in 0..<applications.len() -> 0
    ^keys: SemaKeyRows{}
    ^recorded: [Int:Bool]{}
    loop fact in program.rule_facts {
        key: sema_marker_rules_application_key(keys, fact)
        recorded[key] = true
    }
    ^collected: [AppliedRuleApplication]{}
    ^collected_owners: [Int]{}
    ^next_owner: 1
    loop item in program.items {
        sema_marker_rules_owned_item_applications(item, next_owner, collected, collected_owners)
    }
    loop (index, application) in collected {
        key: sema_marker_rules_application_key(keys, application)
        if !recorded.has_key(key) {
            applications.push(application)
            owners.push(collected_owners[index])
        }
    }
    if program.applied_rules.len() == 0 {
        return SemaOwnedRuleApplications{applications: applications, owners: owners}
    }
    loop application in applications -> ^_: sema_marker_rules_first_application(keys, application)
    loop application in program.applied_rules {
        if !sema_marker_rules_first_application(keys, application) -> next
        applications.push(application.copy())
        owners.push(0)
    }
    SemaOwnedRuleApplications{applications: applications, owners: owners}
}

sema_marker_rules_applications: fn(program: Program) -> [AppliedRuleApplication] Never! {
    sema_marker_rules_owned_applications(program).applications
}

// Marker name and name span -> the first of `applications` there, by the
// (name span, name) key over `keys`.
SemaMarkerApplicationRows: struct {
    keys: SemaKeyRows{SemaKeyRows{}},
    rows: [Int:Int]{[Int:Int]{}},
}

sema_marker_rules_application_rows: fn(applications: [AppliedRuleApplication]) -> SemaMarkerApplicationRows Never! {
    ^rows: SemaMarkerApplicationRows{}
    loop (index, application) in applications {
        key: sema_marker_rules_application_row_key(rows.keys, application.marker)
        if !rows.rows.has_key(key) -> rows.rows[key] = index
    }
    rows
}

// The (name span, name) key of `marker` in `keys`.
sema_marker_rules_application_row_key: fn(keys: ^SemaKeyRows, marker: Marker) -> Int Never! {
    at: sema_key_span(keys, Val(marker.name_span))
    name: sema_key_text(keys, marker.name)
    sema_key_pair(keys, at, name)
}

// The compiler hook a marker application reaches (jet_foundation
// MARKER_HOOKS). Registration binds every application that resolves to a
// declaration of the graph (sema_marker_module_bind_program), local or
// imported; such a marker is that module's own and reaches no hook, even
// under a Prelude name. Only the Prelude's markers stay unbound.
sema_marker_hook: fn(marker: Marker) -> MarkerHook? Never! {
    if marker.declaration_module != None -> return None
    marker_hook_of_declaration(marker.name)
}

// Whether `marker` reaches the compiler hook `hook`.
sema_marker_is_hook: fn(marker: Marker, hook: MarkerHook) -> Bool Never! {
    reached: sema_marker_hook(marker) ?? return false
    reached == hook
}

// The first of `markers` that reaches the compiler hook `hook`.
sema_marker_with_hook: fn(markers: [Marker], hook: MarkerHook) -> Marker? Never! {
    loop marker in markers {
        if sema_marker_is_hook(marker, hook) -> return Val(marker)
    }
    None
}

sema_marker_rules_is_guest_marker: fn(marker: Marker, site: RuleSite?) -> Bool Never! {
    if marker.negated -> return false
    if site == (Val(RuleSite.Function)) && (sema_marker_is_hook(marker, MarkerHook.Import) || sema_marker_is_hook(marker, MarkerHook.Export)) {
        return sema_marker_c_argument(marker) || sema_marker_is_wasm_export(marker) || parser_marker_spells_service_import(marker)
    }
    if site == (Val(RuleSite.Module)) && sema_marker_is_hook(marker, MarkerHook.Import) && marker.args.len() == 0 {
        return true
    }
    false
}

// Whether a function marker is the ratified `#Export(c)` spelling.
sema_marker_is_guest_export: fn(marker: Marker) -> Bool Never! {
    !marker.negated && sema_marker_is_hook(marker, MarkerHook.Export) && sema_marker_c_argument(marker)
}

// `#Export(wasm)` is the JS-to-Wasm bridge entry, parsed as
// `function.web_marker` (WebPartition.jet checks it).
sema_marker_is_wasm_export: fn(marker: Marker) -> Bool Never! {
    if marker.negated || !sema_marker_is_hook(marker, MarkerHook.Export) || marker.args.len() != 1 {
        return false
    }
    if marker.args[0] == .Expr(value) {
        if value == .Ident(name, _, _) -> return name == "wasm"
    }
    false
}

sema_marker_c_argument: fn(marker: Marker) -> Bool Never! {
    if marker.args.len() == 0 -> return false
    argument: marker.args[0]
    if argument == .Expr(value) {
        if value == .Ident(name, _, _) -> return name == "c"
    }
    false
}

sema_marker_rules_edit_distance: fn(left: String, right: String) -> Int Never! {
    ^a: left.bytes()
    ^b: right.bytes()
    ^previous: [Int]{0}
    loop index in 0..<b.len() { previous.push(index + 1) }
    ^i: 0
    loop i < a.len() {
        ^current: [Int]{i + 1}
        ^j: 0
        loop j < b.len() {
            ^cost: if a[i] == b[j] -> 0 else -> 1
            ^deletion: previous[j + 1] + 1
            ^insertion: current[j] + 1
            ^substitution: previous[j] + cost
            ^distance: deletion
            if insertion < distance -> distance = insertion
            if substitution < distance -> distance = substitution
            current.push(distance)
            j += 1
        }
        previous = current
        i += 1
    }
    previous[b.len()]
}

sema_marker_rules_unknown_error: fn(registry: SemaScopeMembersMarkerRegistry, marker: Marker) -> Diagnostic {
    ^names: [String]{}
    loop rule in registry.applied_rules { sema_marker_rules_append_name(names, rule.name) }
    loop name in registry.marker_rules { sema_marker_rules_append_name(names, name.name) }
    ^nearest: ""
    ^nearest_distance: 3
    ^ambiguous: false
    loop candidate in names {
        ^distance: sema_marker_rules_edit_distance(marker.name, candidate)
        if distance == 0 || distance > 2 -> next
        if {
            distance < nearest_distance -> {
                nearest = candidate
                nearest_distance = distance
                ambiguous = false
            }
            distance == nearest_distance && nearest != candidate -> { ambiguous = true }
        }
    }
    ^fix: if nearest != "" && !ambiguous -> "did you mean `#{nearest}`?" else -> "check the spelling, or see Docs/Spec/syntax-decisions.md for the full applied-rule list."
    ^diagnostic: sema_error("E0927", marker.name_span, "`#{marker.name}` isn't a known applied rule", "`{marker.name}` isn't registered as an applied rule — Jet rules are a closed, registered vocabulary, not any PascalCase word.", fix)
    if nearest != "" && !ambiguous -> diagnostic_with_edit(diagnostic, TextEdit{span: marker.name_span, new_text: nearest}) else -> diagnostic
}

// The one repeated-rule diagnostic, named for the target it repeats on.
sema_marker_rules_repeated_error: fn(marker: Marker, first: Marker, site: RuleSite?) -> Diagnostic {
    ^noun: "target"
    if site == .Val(value) {
        noun = if value == RuleSite.Function || value == RuleSite.Method -> "function" else -> sema_marker_rules_site_name(value).lower()
    }
    ^diagnostic: sema_error("E0999", marker.span, "`#{marker.name}` is already applied to this {noun}", "`#{marker.name}` is not a repeatable rule, so the second copy adds nothing and can only disagree with the first", "remove the repeated marker")
    diagnostic.detail = Val("second application span: the copy this report points at\nfirst application span: the earlier copy on the same target")
    diagnostic_with_label(diagnostic, first.span, "first application span")
}

sema_marker_rules_collect_function: fn(function: Func, markers: ^[Marker]) Never! {
    loop marker in function.markers { markers.push(marker.copy()) }
}

sema_marker_rules_collect_item: fn(item: Item, markers: ^[Marker]) Never! {
    if item == .Struct(definition) {
        loop marker in definition.type_markers { markers.push(marker.copy()) }
        loop field in definition.fields {
            loop marker in field.serde_markers { markers.push(marker.copy()) }
        }
        loop function in definition.methods {
            sema_marker_rules_collect_function(function, markers)
        }
        loop implementation in definition.trait_impls {
            loop function in implementation.methods {
                sema_marker_rules_collect_function(function, markers)
            }
        }
        return
    }
    if item == .Enum(definition) {
        loop marker in definition.type_markers { markers.push(marker.copy()) }
        loop variant in definition.variants {
            loop marker in variant.serde_markers { markers.push(marker.copy()) }
        }
        loop function in definition.methods {
            sema_marker_rules_collect_function(function, markers)
        }
        loop implementation in definition.trait_impls {
            loop function in implementation.methods {
                sema_marker_rules_collect_function(function, markers)
            }
        }
        return
    }
    if item == .Distinct(definition) {
        loop marker in definition.type_markers { markers.push(marker.copy()) }
        return
    }
    if item == .Func(function) {
        sema_marker_rules_collect_function(function, markers)
        return
    }
    if item == .Impl(implementation) {
        loop function in implementation.methods {
            sema_marker_rules_collect_function(function, markers)
        }
        return
    }
    if item == .CodeModule(code_module) {
        if code_module.body != None {
            body: code_module.body ?? return
            loop nested in body { sema_marker_rules_collect_item(nested, markers) }
        }
    }
}

sema_marker_rules_collect_program: fn(program: Program) -> [Marker] Never! {
    ^markers: [Marker]{}
    loop item in program.items { sema_marker_rules_collect_item(item, markers) }
    ^keys: SemaKeyRows{}
    loop existing in markers -> ^_: sema_marker_rules_first_occurrence(keys, existing)
    loop application in sema_marker_rules_applications(program) {
        if application.target == None -> next
        if sema_marker_rules_first_occurrence(keys, application.marker) {
            markers.push(application.marker)
        }
    }
    markers
}

sema_marker_rules_marker_is_known: fn(registry: SemaScopeMembersMarkerRegistry, marker: Marker) -> Bool Never! {
    if sema_marker_rules_user_rule_index(registry, marker) != None || (marker.declaration_module == None && sema_scope_members_has_name(registry.known_marker_names, marker.name)) {
        return true
    }
    false
}

sema_marker_rules_validate_vocabulary: fn(registry: SemaScopeMembersMarkerRegistry, program: Program, markers: [Marker], diagnostics: ^[Diagnostic]) {
    ^seen: SemaKeyRows{}
    applications: sema_marker_rules_applications(program)
    ^application_rows: sema_marker_rules_application_rows(applications)
    loop marker in markers {
        if !sema_marker_rules_first_occurrence(seen, marker) -> next
        row_key: sema_marker_rules_application_row_key(application_rows.keys, marker)
        application_row: application_rows.rows.get(row_key) ?? -1
        ^site: if application_row >= 0 -> applications[application_row].site else -> None
        if sema_marker_rules_is_guest_marker(marker, site) -> next
        if sema_marker_rules_builtin_index(registry, marker) == None && !sema_marker_rules_marker_is_known(registry, marker) {
            diagnostics.push(sema_marker_rules_unknown_error(registry, marker))
        }
    }
}

sema_marker_rules_validate_allow: fn(program: Program, diagnostics: ^[Diagnostic]) {
    applications: sema_marker_rules_applications(program)
    loop application in applications {
        sema_marker_rules_allow_checks(application.marker, diagnostics)
    }
}

// An `#Allow(Jet.LintName, "why")` records its reason, names its lint by the
// lint's name (Jet's own are `Jet.`, never `jet.`), and the reason check
// cannot allow itself.
sema_marker_rules_allow_checks: fn(marker: Marker, diagnostics: ^[Diagnostic]) {
    if !sema_marker_is_hook(marker, MarkerHook.Allow) {
        return
    }
    if marker.args.len() < 2 {
        diagnostics.push(diagnostic_from_registry("L3103", Val(marker.span), "This `#Allow` has no reason.", "Every lint allowance records why the selected lint does not apply at this site.", "Add the reason slot: `#Allow(Jet.LintName, \"why this lint does not apply\")`."))
    }
    loop argument in marker.args {
        if argument == .Expr(expr) {
            if expr == .Field(base, member, span, _) {
                if base == .Ident(package, package_span, _) {
                    if package == "jet" {
                        unknown: sema_error("E0107", package_span, "nothing named `jet` exists here", "Jet's own diagnostics are named `Jet.Name`, so an `#Allow` names Jet's lint `Jet.{member}`", "write `Jet.{member}`")
                        diagnostics.push(diagnostic_with_edit(unknown, TextEdit{span: package_span, new_text: "Jet"}))
                    }
                    if package == "Jet" && member == "AllowReason" {
                        diagnostics.push(sema_error("E0355", Span{start: package_span.start, end: span.end}, "`#Allow` cannot suppress `Jet.AllowReason`", "the reason check audits the lint allowance itself and cannot be disabled by that allowance", "write the reason slot: `#Allow(Jet.LintName, \"why this lint does not apply\")`"))
                    }
                }
            }
        }
    }
}

sema_marker_rules_validate_sites: fn(registry: SemaScopeMembersMarkerRegistry, program: Program, diagnostics: ^[Diagnostic]) {
    sema_marker_rules_validate_allow(program, diagnostics)
    applications: sema_marker_rules_applications(program)
    loop application in applications {
        sema_marker_rules_allow_checks(application.marker, diagnostics)
        site: application.site ?? next
        ^builtin_index: sema_marker_rules_builtin_index(registry, application.marker)
        if builtin_index != None {
            ^rule: registry.applied_rules[builtin_index ?? 0]
            if !sema_marker_rules_fact_allows(rule, application, applications) {
                diagnostics.push(sema_marker_rules_applied_site_error(application.marker, rule, site))
            }
            next
        }
        diagnostic: sema_marker_rules_user_site_error(registry, application, site) ?? next
        diagnostics.push(diagnostic)
    }
}

// A source-declared marker rule names its legal sites (`sites: [.Type]`). A
// group has no sites of its own: its members are checked where it expands.
sema_marker_rules_user_site_error: fn(registry: SemaScopeMembersMarkerRegistry, application: AppliedRuleApplication, site: RuleSite) -> Diagnostic? {
    user_index: sema_marker_rules_user_rule_index(registry, application.marker) ?? return None
    if registry.marker_rules[user_index].group -> return None
    if registry.marker_rules[user_index].sites.contains(sema_marker_rules_site_name(site)) {
        return None
    }
    Val(sema_marker_rules_declared_site_error(application.marker, registry.marker_rules[user_index]))
}

// The argument and site checks of every source-declared marker applied in
// `program`.
sema_marker_rules_validate_user_sites: fn(registry: SemaScopeMembersMarkerRegistry, program: Program, diagnostics: ^[Diagnostic]) {
    loop application in sema_marker_rules_applications(program) {
        if sema_marker_rules_builtin_index(registry, application.marker) != None -> next
        if sema_marker_rules_user_argument_error(registry, application.marker) == .Val(error) {
            diagnostics.push(error)
        }
        site: application.site ?? next
        diagnostic: sema_marker_rules_user_site_error(registry, application, site) ?? next
        diagnostics.push(diagnostic)
    }
}

// A source-declared rule's arguments bind its declared signature (E0930). A
// literal argument fails only when its own type contradicts the parameter's
// declared type; names and calls stay open for ordinary inference. A group
// takes no parameters, so any parentheses after its name are E0930.
sema_marker_rules_user_argument_error: fn(registry: SemaScopeMembersMarkerRegistry, marker: Marker) -> Diagnostic? {
    user_index: sema_marker_rules_user_rule_index(registry, marker) ?? return None
    rule: registry.marker_rules[user_index]
    if rule.group {
        if marker.args.len() == 0 && marker.span.end <= marker.name_span.end -> return None
        return Val(sema_error("E0930", Span{start: marker.name_span.start, end: marker.span.end}, "`#{marker.name}` is a marker group and takes no arguments", "a group names a fixed stack of markers; it has no parameters for arguments to bind", "write `#{marker.name}` without parentheses"))
    }
    declared: sema_marker_rules_declared_signature(rule)
    bindings: sema_marker_rules_marker_signature_bindings(marker, declared.signature, Val(registry.format_names)) ?? return Val(sema_marker_rules_signature_error(marker, declared.signature, true))
    loop binding in bindings {
        argument: sema_marker_rules_marker_expression(marker, binding.source_index) ?? return Val(sema_marker_rules_signature_error(marker, declared.signature, true))
        actual: sema_marker_rules_literal_kind(argument) ?? next
        wanted: (if binding.parameter_index == .Val(index) -> if index < declared.expected_types.len() -> sema_marker_rules_declared_kind(declared.expected_types[index]) else -> None else -> sema_marker_rules_declared_kind(declared.variadic_expected_type)) ?? next
        if actual != wanted {
            return Val(sema_marker_rules_signature_error(marker, declared.signature, true))
        }
    }
    None
}

sema_marker_rules_literal_kind: fn(argument: Expr) -> String? Never! {
    if argument == {
        .Str(_, _, _) -> return Val("String")
        .Int(_, _, _, _, _) -> return Val("Int")
        .Float(_, _, _, _, _) -> return Val("Float")
        .Bool(_, _, _) -> return Val("Bool")
        .Char(_, _, _) -> return Val("Char")
        .ListLit(_, _, _) -> return Val("List")
        .MapLit(_, _, _) -> return Val("Map")
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    None
}

sema_marker_rules_declared_kind: fn(ty: Type?) -> String? Never! {
    declared: ty ?? return None
    if declared == {
        .String -> return Val("String")
        .Int -> return Val("Int")
        .Float -> return Val("Float")
        .Bool -> return Val("Bool")
        .Char -> return Val("Char")
        .List(_) -> return Val("List")
        .Map(_, _, _) -> return Val("Map")
        .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    None
}

sema_marker_rules_validate_repeatability: fn(registry: SemaScopeMembersMarkerRegistry, program: Program, diagnostics: ^[Diagnostic]) {
    // Declaration, site, owning item and target span -> the first marker
    // applied there, a row of `seen_markers`, by the key's row in `keys`.
    ^keys: SemaKeyRows{}
    ^firsts: [Int:Int]{}
    ^seen_markers: [Marker]{}
    owned: sema_marker_rules_owned_applications(program)
    loop (at, application) in owned.applications {
        ^builtin_index: sema_marker_rules_builtin_index(registry, application.marker)
        ^repeatable: false
        if builtin_index == {
            .Val(index) -> {
                ^rule: registry.applied_rules[index]
                repeatable = rule.repeatable
            }
            .None -> {
                ^user_index_option: sema_marker_rules_user_rule_index(registry, application.marker)
                if {
                    user_index_option != None -> {
                        user_index: user_index_option ?? next
                        repeatable = registry.marker_rules[user_index].repeatable
                    }
                    else -> { next }
                }
            }
        }
        if repeatable -> next
        // Same declaration on the same target: the same site, owning item and
        // span. An application with no target span, such as a marked block,
        // has no identity to repeat on. Two generated items (such as a grammar
        // literal's `<Name>Rule` and `<Name>Token` enums, both `#Layout(U32)`)
        // share the literal's span but have distinct owners.
        if application.target == None -> next
        site: if application.site == .Val(value) -> sema_marker_rules_site_name(value) else -> ""
        declaration: sema_marker_rules_declaration_key(keys, application.marker)
        site_id: sema_key_text(keys, site)
        declared_at: sema_key_pair(keys, declaration, site_id)
        target_span: sema_key_span(keys, application.target)
        target: sema_key_pair(keys, target_span, owned.owners[at])
        key: sema_key_pair(keys, declared_at, target)
        if firsts.get(key) == .Val(first) {
            diagnostics.push(sema_marker_rules_repeated_error(application.marker, seen_markers[first], application.site))
            next
        }
        firsts[key] = seen_markers.len()
        seen_markers.push(application.marker)
    }
}

sema_marker_rules_validate_arguments: fn(registry: SemaScopeMembersMarkerRegistry, source_program: Program, markers: [Marker], check: ^SemaBodyCheck, values: [SemaComptimeItemValue], result: ^SemaMarkerRulesCheckResult) {
    ^seen: SemaKeyRows{}
    loop marker in markers {
        if !sema_marker_rules_first_occurrence(seen, marker) -> next
        ^builtin_index: sema_marker_rules_builtin_index(registry, marker)
        if builtin_index != None {
            ^rule: registry.applied_rules[builtin_index ?? 0]
            expected_types: (loop _ in rule.signature.params -> Type?{None})
            sema_body_check_swap_diagnostics(check, result.diagnostics)
            sema_marker_rules_validate_argument_signature(marker, rule.signature, expected_types, None, false, rule.owns_menu, registry, check, values, result.argument_facts, result.comptime_sources, result.comptime_requests)
            sema_body_check_swap_diagnostics(check, result.diagnostics)
        }
        ^user_index: sema_marker_rules_user_rule_index(registry, marker)
        if user_index != None {
            ^rule: registry.marker_rules[user_index ?? 0]
            signature: sema_marker_rules_declared_signature(rule)
            sema_body_check_swap_diagnostics(check, result.diagnostics)
            sema_marker_rules_validate_argument_signature(marker, signature.signature, signature.expected_types, signature.variadic_expected_type, true, false, registry, check, values, result.argument_facts, result.comptime_sources, result.comptime_requests)
            sema_body_check_swap_diagnostics(check, result.diagnostics)
        }
    }
}

sema_marker_rules_check: fn(registry: SemaScopeMembersMarkerRegistry, source_program: Program, check: ^SemaBodyCheck, values: [SemaComptimeItemValue]) -> SemaMarkerRulesCheckResult {
    ^result: SemaMarkerRulesCheckResult{
        diagnostics: [Diagnostic]{},
        argument_facts: [SemaMarkerRuleArgumentFact]{},
        comptime_sources: [SemaComptimeItemSource]{},
        comptime_requests: [SemaComptimeRequest]{},
    }
    ^markers: sema_marker_rules_collect_program(source_program)
    sema_marker_rules_validate_vocabulary(registry, source_program, markers, result.diagnostics)
    sema_marker_rules_validate_sites(registry, source_program, result.diagnostics)
    sema_marker_rules_validate_repeatability(registry, source_program, result.diagnostics)
    sema_marker_rules_validate_arguments(registry, source_program, markers, check, values, result)
    result
}

SemaMarkerRulesDeclaredTypeCheck: struct {
    resolved_type: Type?,
    diagnostics: [Diagnostic],
    complete: Bool,
}

sema_marker_rules_builtin_type: fn(name: String) -> Type? {
    if name == "Int" -> return Val(Type.Int)
    if name == "Float" -> return Val(Type.Float)
    if name == "Bool" -> return Val(Type.Bool)
    if name == "String" -> return Val(Type.String)
    if name == "Char" -> return Val(Type.Char)
    if name == "F32" -> return Val(Type.Float32)
    if name == "I8" -> return Val(Type.IntN{signed: true, bits: 8})
    if name == "I16" -> return Val(Type.IntN{signed: true, bits: 16})
    if name == "I32" -> return Val(Type.IntN{signed: true, bits: 32})
    if name == "I64" -> return Val(Type.IntN{signed: true, bits: 64})
    if name == "U8" -> return Val(Type.IntN{signed: false, bits: 8})
    if name == "U16" -> return Val(Type.IntN{signed: false, bits: 16})
    if name == "U32" -> return Val(Type.IntN{signed: false, bits: 32})
    if name == "U64" -> return Val(Type.IntN{signed: false, bits: 64})
    if name == "F64" -> return Val(Type.Float)
    if name == "Unit" || name == "Err" || name == "Never" -> return Val(Type.Named{name: name})
    None
}

// `#Inline(Always)` is a checked promise. A function that
// calls itself directly (E0917) or whose body has more statements than the
// ceiling (E0919) cannot be expanded in place, and a top-level function whose
// bare name is read as a value anywhere in the bundle (E0918) needs a real
// function to point at. Statements count transitively through nested blocks
// but not through a lambda body, which compiles to its own closure. Only
// direct self-recursion is checked: a call of the function's own name, but
// not one through an import (`mem.fill` in a method `fill`), nor, in a
// method, a bare call that passes no `self` (`close(self.region)` in a
// `close` method calls the region's).
SEMA_INLINE_ALWAYS_MAX_STMTS: 40

SemaInlineAlwaysScan: struct {
    target: String,
    stmt_count: Int,
    self_recursive: Bool,
    // The file's imports.
    imports: [ImportDecl],
    method: Bool,
}

sema_inline_always_scan_body: fn(statements: [Stmt], scan: ^SemaInlineAlwaysScan) {
    loop statement in statements -> sema_inline_always_scan_statement(statement, scan)
}

sema_inline_always_scan_args: fn(args: [CallArg], scan: ^SemaInlineAlwaysScan) {
    loop arg in args -> sema_inline_always_scan_expr(arg.expr, scan)
}

sema_inline_always_scan_optional: fn(expression: Expr?, scan: ^SemaInlineAlwaysScan) {
    if expression == .Val(value) -> sema_inline_always_scan_expr(value, scan)
}

sema_inline_always_scan_statement: fn(statement: Stmt, scan: ^SemaInlineAlwaysScan) {
    scan.stmt_count += 1
    if statement == {
        .Expr(value) | .DeferClose(value, _) | .BreakValue(value, _) | .Yield(value, _) -> {
            sema_inline_always_scan_expr(value, scan)
        }
        .BreakLabelValue(_, _, value, _) -> { sema_inline_always_scan_expr(value, scan) }
        .Val(binding) -> { sema_inline_always_scan_expr(binding.init, scan) }
        .Assign(target, _, _, value) -> {
            if target == {
                .Local(_, _) -> {}
                .Index(base, index, _, _) -> {
                    sema_inline_always_scan_expr(base, scan)
                    sema_inline_always_scan_expr(index, scan)
                }
                .Field(base, _, _) -> sema_inline_always_scan_expr(base, scan)
            }
            sema_inline_always_scan_expr(value, scan)
        }
        .Return(value, _) -> { sema_inline_always_scan_optional(value, scan) }
        .While(cond, body, _, _, _) -> {
            sema_inline_always_scan_expr(cond, scan)
            sema_inline_always_scan_body(body, scan)
        }
        .For(_, _, _, kind, body, _, _, _, _) -> {
            if kind == {
                .Range(start, end, step, _) -> {
                    sema_inline_always_scan_expr(start, scan)
                    sema_inline_always_scan_expr(end, scan)
                    sema_inline_always_scan_optional(step, scan)
                }
                .In(collection, step) -> {
                    sema_inline_always_scan_expr(collection, scan)
                    sema_inline_always_scan_optional(step, scan)
                }
            }
            sema_inline_always_scan_body(body, scan)
        }
        .Switch(subject, arms, else_body, _) | .ComptimeSwitch(subject, arms, else_body, _) -> {
            sema_inline_always_scan_expr(subject, scan)
            loop arm in arms {
                sema_inline_always_scan_expr(arm.cond, scan)
                sema_inline_always_scan_body(arm.body, scan)
            }
            if else_body == .Val(body) -> sema_inline_always_scan_body(body, scan)
        }
        .Loop(body, _, _, _) | .Reactive(body, _) | .Shield(body, _) | .Defer(body, _) | .Live(body, _) -> {
            sema_inline_always_scan_body(body, scan)
        }
        .Switched(_, body, _) | .Policy(_, body, _) | .Region(_, _, body, _) | .Layout(_, _, body, _) -> {
            sema_inline_always_scan_body(body, scan)
        }
        .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .AssumeDet(_, _, body, _) -> {
            sema_inline_always_scan_body(body, scan)
        }
        .TaskGroup(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .Transact(_, _, body, _, _) -> {
            sema_inline_always_scan_body(body, scan)
        }
        .AuthorityScope(_, _, _, body, _) | .ScopeMember(_, _, _, _, body, _, _, _) -> {
            sema_inline_always_scan_body(body, scan)
        }
        .CountedLoop(init, cond, step, body, _, _, _) -> {
            sema_inline_always_scan_expr(init.init, scan)
            sema_inline_always_scan_expr(cond, scan)
            if step == .Val(inner) -> sema_inline_always_scan_statement(inner, scan)
            sema_inline_always_scan_body(body, scan)
        }
        .ComptimeIf(cond, _, then_body, else_body, _, _) -> {
            sema_inline_always_scan_expr(cond, scan)
            sema_inline_always_scan_body(then_body, scan)
            if else_body == .Val(body) -> sema_inline_always_scan_body(body, scan)
        }
        .ContextBlock(fields, body, _) -> {
            loop field in fields -> sema_inline_always_scan_expr(field.value, scan)
            sema_inline_always_scan_body(body, scan)
        }
        .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
    }
}

// Whether `expression` is the method's own receiver, `self`.
sema_inline_always_is_self: fn(expression: Expr) -> Bool {
    if expression == .Ident(name, _, _) -> return name == "self"
    if expression == .Paren(base, _, _) -> return sema_inline_always_is_self(base)
    if expression == .Place(base, _, _, _) -> return sema_inline_always_is_self(base)
    false
}

// Whether a method call's `receiver` is the alias of one of the file's
// `imports` (`mem` in `mem.fill(…)`): the call names a function of that
// module.
sema_inline_always_through_import: fn(receiver: Expr, imports: [ImportDecl]) -> Bool {
    if receiver == .Ident(name, _, _) {
        return imports.any(fn(declaration) { declaration.alias == name })
    }
    false
}

sema_inline_always_scan_expr: fn(expression: Expr, scan: ^SemaInlineAlwaysScan) {
    if expression == {
        .Call(call, _) -> {
            if call.name == scan.target && (!scan.method || call.args.any(fn(arg) { sema_inline_always_is_self(arg.expr) })) {
                scan.self_recursive = true
            }
            sema_inline_always_scan_args(call.args, scan)
        }
        .MethodCall(receiver, method, _, _, _, args, _) | .OptMethodCall(receiver, method, _, _, args, _, _) -> {
            if method == scan.target && !sema_inline_always_through_import(receiver, scan.imports) {
                scan.self_recursive = true
            }
            sema_inline_always_scan_expr(receiver, scan)
            sema_inline_always_scan_args(args, scan)
        }
        .CallValue(callee, args, _, _) -> {
            sema_inline_always_scan_expr(callee, scan)
            sema_inline_always_scan_args(args, scan)
        }
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Interp(value, _) -> sema_inline_always_scan_expr(value, scan)
            }
        }
        .ListLit(elements, _, _) -> {
            loop element in elements -> sema_inline_always_scan_expr(element, scan)
        }
        .CompareChain(operands, _, _, _, _) -> {
            loop operand in operands -> sema_inline_always_scan_expr(operand, scan)
        }
        .MapLit(entries, _, _) -> {
            loop entry in entries {
                sema_inline_always_scan_expr(entry.key, scan)
                sema_inline_always_scan_expr(entry.value, scan)
            }
        }
        .MemberSpread(base, _, _, _) | .Spread(base, _, _) | .Deref(base, _, _) | .RawOf(base, _, _) | .Copy(base, _, _) -> {
            sema_inline_always_scan_expr(base, scan)
        }
        .Field(base, _, _, _) | .OptField(base, _, _, _, _, _) | .Tainted(base, _, _, _) | .Present(base, _, _) -> {
            sema_inline_always_scan_expr(base, scan)
        }
        .Ok(base, _, _) | .Err(base, _, _) | .Paren(base, _, _) | .Unary(_, base, _, _) | .Place(base, _, _, _) -> {
            sema_inline_always_scan_expr(base, scan)
        }
        .PatternTest(subject, _, _, _) -> { sema_inline_always_scan_expr(subject, scan) }
        .PtrFromAddr(_, _, _, addr, _, _) -> { sema_inline_always_scan_expr(addr, scan) }
        .Pipe(head, steps, _, _) -> {
            sema_inline_always_scan_expr(head, scan)
            loop step in steps -> sema_inline_always_scan_expr(step.value, scan)
        }
        .Index(base, index, _, _, _) -> {
            sema_inline_always_scan_expr(base, scan)
            sema_inline_always_scan_expr(index, scan)
        }
        .Slice(base, start, end, range, _, _) -> {
            sema_inline_always_scan_expr(base, scan)
            if range == {
                .Val(value) -> { sema_inline_always_scan_expr(value, scan) }
                .None -> {
                    sema_inline_always_scan_expr(start, scan)
                    sema_inline_always_scan_expr(end, scan)
                }
            }
        }
        .Range(start, end, _, _, _) | .Binary(_, start, end, _, _) -> {
            sema_inline_always_scan_expr(start, scan)
            sema_inline_always_scan_expr(end, scan)
        }
        .Try(value, _, _, context, _) -> {
            sema_inline_always_scan_expr(value, scan)
            sema_inline_always_scan_optional(context, scan)
        }
        .OrFallback(value, fallback, _, _, _) -> {
            sema_inline_always_scan_expr(value, scan)
            if fallback == {
                .Value(inner) -> { sema_inline_always_scan_expr(inner, scan) }
                .Block(body, inner, _) -> {
                    sema_inline_always_scan_body(body, scan)
                    sema_inline_always_scan_optional(inner, scan)
                }
                .Return(inner, _) -> { sema_inline_always_scan_optional(inner, scan) }
                .Panic(_, args) -> sema_inline_always_scan_args(args, scan)
                .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
            }
        }
        .If(cond, then_body, then_value, else_body, else_value, _, _) -> {
            sema_inline_always_scan_expr(cond, scan)
            sema_inline_always_scan_body(then_body, scan)
            sema_inline_always_scan_expr(then_value, scan)
            sema_inline_always_scan_body(else_body, scan)
            sema_inline_always_scan_expr(else_value, scan)
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            loop field in fields -> sema_inline_always_scan_expr(field.value, scan)
        }
        .TupleLit(fields, _, _, _) -> {
            loop field in fields -> sema_inline_always_scan_expr(field.value, scan)
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            loop arg in args {
                if arg == {
                    .Positional(value) -> { sema_inline_always_scan_expr(value, scan) }
                    .Named(_, value) -> sema_inline_always_scan_expr(value, scan)
                }
            }
        }
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> {
                    loop field in fields -> sema_inline_always_scan_expr(field.value, scan)
                }
                .Elements(elements) -> {
                    loop element in elements -> sema_inline_always_scan_expr(element, scan)
                }
                .Entries(entries) -> {
                    loop entry in entries {
                        sema_inline_always_scan_expr(entry.key, scan)
                        sema_inline_always_scan_expr(entry.value, scan)
                    }
                }
                .Value(value) -> sema_inline_always_scan_expr(value, scan)
                .ByteText(_) | .Empty -> {}
            }
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .Ident(_, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .Lambda(_, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}

// The local half of the promise: direct self-recursion (E0917), the size
// ceiling (E0919), `#Scrub` (E1016) and a foreign body (E1021), all provable
// from the function alone. `imports` are its file's imports; `method` says
// it is a method.
sema_inline_always_check_function: fn(function: Func, imports: [ImportDecl], diagnostics: ^[Diagnostic], method: Bool) Never! {
    if !function.is_inline_always {
        return
    }
    ^scan: SemaInlineAlwaysScan{target: function.name, stmt_count: 0, self_recursive: false, imports: imports, method: method}
    sema_inline_always_scan_body(function.body, scan)
    span: function.inline_span ?? function.name_span
    name: function.name
    if scan.self_recursive {
        diagnostics.push(sema_error("E0917", span, "`{name}` calls itself, so `#Inline(Always)` cannot expand it", sema_inline_always_why("inlining a recursive call would either loop forever at compile time or need an artificial depth cutoff, and neither is a real inline."), "drop `#Inline(Always)` (use `#Inline` as a hint), or restructure the function to be non-recursive."))
    }
    if scan.stmt_count > SEMA_INLINE_ALWAYS_MAX_STMTS {
        diagnostics.push(sema_error("E0919", span, "`{name}` is too large for `#Inline(Always)`", sema_inline_always_why("its body has {scan.stmt_count} statements, over the {SEMA_INLINE_ALWAYS_MAX_STMTS}-statement ceiling that keeps the copy at every call site small."), "drop `#Inline(Always)` (use `#Inline` as a hint the compiler is free to ignore), or split the function so the hot part is small enough to inline."))
    }
    if function.scrub_tag != None {
        diagnostics.push(sema_error("E1016", span, "`{name}` is `#Scrub`, so `#Inline(Always)` cannot expand it", sema_inline_always_why("a `#Scrub` routine reveals a fixed value as a public result, and only its own call keeps that value fixed up to the result; an inlined copy would let the fixed value flow on into the caller's code."), "drop `#Inline(Always)`; a `#Scrub` routine stays a call."))
    }
    // An `#FFI` function's body is C or assembly source, an `#Import(c)`
    // function's is the C symbol it names, and a service import's is the
    // host's answer to its symbol.
    foreign: if {
        function.inline_foreign == .Val(ffi) -> "`#FFI({ffi.lang})`"
        parser_service_import(function) == .Val(service) -> "`#Import({service.provider})`"
        sema_function_is_guest_import(function) -> "`#Import(c)`"
        else -> ""
    }
    if foreign != "" {
        diagnostics.push(sema_error("E1021", span, "`{name}` has a foreign body, so `#Inline(Always)` cannot expand it", sema_inline_always_why("the body of an {foreign} function is foreign code, not Jet: each call goes to that code, and there is no Jet body to copy into the caller."), "drop `#Inline(Always)`; a function with a foreign body stays a call."))
    }
}

// The why of every `#Inline(Always)` refusal: `reason`, then the guarantee
// and every mark sema refuses.
sema_inline_always_why: fn(reason: String) -> String Never! {
    "{reason} `#Inline(Always)` guarantees that every direct call is inlined on every tier, or the program is refused: sema refuses a function that calls itself or closes a cycle of marked calls (Jet.RecursiveInlineAlways), one used as a value (Jet.InlineAlwaysAddressTaken), one over the size ceiling (Jet.InlineAlwaysTooLarge), a `#Scrub` routine (Jet.InlineAlwaysScrub), one that reads `context.trace` (Jet.InlineAlwaysReadsTrace) and one with a foreign body (Jet.InlineAlwaysForeign)."
}

// One call between two `#Inline(Always)` functions (indexes into the marked
// list of sema_inline_always_check_calls), at `span` in module `module`.
SemaInlineAlwaysEdge: struct {
    caller: Int,
    callee: Int,
    module: Int,
    span: Span,
}

// The whole-program half for calls, read from the call facts: a marked
// function that reads `context.trace` (E1017: the trace names the reading
// function's own frame, which an inlined copy doesn't have) and marked
// functions whose calls of each other come back around (E0917: each copy
// would hold the next one without end). A lambda's facts are its enclosing
// function's.
sema_inline_always_check_calls: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], diagnostics: ^[Diagnostic]) -> Bool Never! {
    // The marked functions, as module and function indexes into `modules`,
    // and each marked key's first position in that list, at the key's id in
    // `marked_names`.
    ^marked_modules: [Int]{}
    ^marked_functions: [Int]{}
    ^marked_names: name_column_table()
    ^marked_rows: name_column()
    loop (module_index, module_result) in modules {
        loop (function_index, function) in module_result.functions {
            if function.is_inline_always {
                name_column_set_first(marked_names, marked_rows, function.key, marked_modules.len())
                marked_modules.push(module_index)
                marked_functions.push(function_index)
            }
        }
    }
    if marked_modules.len() == 0 -> return false
    ^found: false
    ^edges: [SemaInlineAlwaysEdge]{}
    loop (module_index, module_result) in modules {
        segments_index: sema_registration_module_index(graph, module_result.module_identity) ?? next
        start: diagnostics.len()
        loop fact in module_result.call_facts {
            caller: name_column_get(marked_names, marked_rows, fact.caller_key) ?? next
            name: modules[marked_modules[caller]].functions[marked_functions[caller]].name
            if fact.detail == .Val(detail) {
                if detail.intrinsic_api == .Val(api) {
                    if api == "context.trace" {
                        diagnostics.push(sema_error("E1017", fact.span, "`{name}` reads `context.trace`, so `#Inline(Always)` cannot expand it", sema_inline_always_why("`context.trace` starts at the reading function's own frame, and an inlined copy has no frame of its own: the trace would name the caller instead."), "drop `#Inline(Always)`, or read `context.trace` in the function that calls `{name}`."))
                    }
                }
            }
            callee_id: fact.callee ?? next
            callee: name_column_get(marked_names, marked_rows, symbol_table_key(graph.symbols, callee_id)) ?? next
            // A direct call of itself is the local half's E0917.
            if callee != caller {
                edges.push(SemaInlineAlwaysEdge{caller: caller, callee: callee, module: module_index, span: fact.span})
            }
        }
        if diagnostics.len() > start -> found = true
        sema_attach_diagnostic_source_locations(diagnostics, start, graph.modules[segments_index].source_segments)
    }
    // Each marked function's call edges, in edge order, so the walk reads
    // only its own.
    ^calls: (loop _ in marked_modules -> [Int]{})
    loop (index, edge) in edges -> calls[edge.caller].push(index)
    ^state: (loop _ in marked_modules -> 0)
    ^back: [Int]{}
    loop node in 0..<marked_modules.len() {
        if state[node] == 0 -> sema_inline_always_walk(node, edges, calls, state, back)
    }
    loop index in back {
        edge: edges[index]
        caller: modules[marked_modules[edge.caller]].functions[marked_functions[edge.caller]].name
        callee: modules[marked_modules[edge.callee]].functions[marked_functions[edge.callee]].name
        segments_index: sema_registration_module_index(graph, modules[edge.module].module_identity) ?? next
        start: diagnostics.len()
        diagnostics.push(sema_error("E0917", edge.span, "`{caller}` calls `{callee}`, whose calls lead back to `{caller}`, so `#Inline(Always)` cannot expand them", sema_inline_always_why("each inlined copy would hold the next one, so expanding the cycle would never end."), "drop `#Inline(Always)` from one function of the cycle (use `#Inline` as a hint), or break the cycle."))
        sema_attach_diagnostic_source_locations(diagnostics, start, graph.modules[segments_index].source_segments)
        found = true
    }
    found
}

// A depth-first walk of the marked calls from `node`: `state` is 0 before a
// function's walk, 1 during it and 2 after, and each call of a function
// still being walked closes a cycle, its edge index onto `back`. `calls`
// holds each function's edge indexes in edge order.
sema_inline_always_walk: fn(node: Int, edges: [SemaInlineAlwaysEdge], calls: [[Int]], state: ^[Int], back: ^[Int]) Never! {
    state[node] = 1
    loop index in calls[node] {
        edge: edges[index]
        if state[edge.callee] == 1 -> back.push(index)
        if state[edge.callee] == 0 {
            sema_inline_always_walk(edge.callee, edges, calls, state, back)
        }
    }
    state[node] = 2
}

// Every body of the bundle has been checked, so the function references
// read as values are complete for the whole-program E0918 half, and the
// call facts for the calls half (sema_inline_always_check_calls). Methods
// cannot be read as bare values, so E0918 applies to top-level functions.
sema_marker_rules_check_inline_always: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], diagnostics: ^[Diagnostic]) -> Bool Never! {
    ^address_taken: [U32:Bool]{}
    loop module_result in modules {
        loop reference in module_result.name_references {
            if reference.kind == Val(SymbolKind.Function) {
                address_taken[reference.symbol.id.id] = true
            }
        }
    }
    ^found: false
    loop source_module_index in 0..<graph.modules.len() {
        start: diagnostics.len()
        imports: graph.modules[source_module_index].program.imports
        loop item_index in 0..<graph.modules[source_module_index].program.items.len() {
            if graph.modules[source_module_index].program.items[item_index] == .Func(function) {
                sema_inline_always_check_function(function, imports, diagnostics, method: false)
                if function.is_inline_always {
                    key: symbol_key_text(SymbolKind.Function, module_text(graph.module_table, graph.modules[source_module_index].module_identity), "", function.name)
                    id: symbol_find(graph.symbols, key) ?? next
                    if address_taken.get(id.id) != None {
                        name: function.name
                        diagnostics.push(sema_error("E0918", function.inline_span ?? function.name_span, "`{name}` cannot be inlined: its address is taken", sema_inline_always_why("`{name}` is also used as a plain value somewhere (stored, returned, or passed as a callback), and a value needs a real function to point at."), "drop `#Inline(Always)`, or call `{name}` directly instead of through a value."))
                    }
                }
            }
        }
        loop nominal_index in 0..<graph.modules[source_module_index].nominals.len() {
            loop method_index in 0..<graph.modules[source_module_index].nominals[nominal_index].methods.len() {
                sema_inline_always_check_function(graph.modules[source_module_index].nominals[nominal_index].methods[method_index].declaration, imports, diagnostics, method: true)
            }
        }
        loop implementation_index in 0..<graph.modules[source_module_index].impls.len() {
            loop method_index in 0..<graph.modules[source_module_index].impls[implementation_index].methods.len() {
                sema_inline_always_check_function(graph.modules[source_module_index].impls[implementation_index].methods[method_index].declaration, imports, diagnostics, method: true)
            }
        }
        if diagnostics.len() > start -> found = true
        sema_attach_diagnostic_source_locations(diagnostics, start, graph.modules[source_module_index].source_segments)
    }
    if sema_inline_always_check_calls(graph, modules, diagnostics) -> found = true
    found
}

// `#NoPrelude` turns the curated prelude names `print` and
// `input` off for its file (E0429) unless the file declares its own. The
// arguments are still checked; the call reports once and yields no value.
sema_marker_rules_no_prelude_call: fn(call: Call, check: ^SemaBodyCheck) -> Bool {
    if call.name != "print" && call.name != "input" -> return false
    if !sema_module_no_prelude(check.environment.*, check.program.*) || !sema_call_gate_is_unshadowed(call.name, check.scopes) {
        return false
    }
    fix: if call.name == "print" -> "write `use io: core.term` and call `io.print(…)`, or remove `#NoPrelude`" else -> "write `use io: core.term` and read a line with `io.readline(…)`, or remove `#NoPrelude`"
    check.diagnostics.push(sema_marker_rules_no_prelude_error(call.name, call.name_span, fix))
    loop argument_index in 0..<call.args.len() {
        ^_: sema_check_expression(call.args[argument_index].expr, None, check)
    }
    true
}

// The bare `input` value under `#NoPrelude` (E0429), when the file declares
// no `input` of its own.
sema_marker_rules_no_prelude_input: fn(span: Span, check: ^SemaBodyCheck) -> Bool Never! {
    if !sema_module_no_prelude(check.environment.*, check.program.*) -> return false
    check.diagnostics.push(sema_marker_rules_no_prelude_error("input", span, "write `use io: core.term` and loop over `io.stdin().lines()`, or remove `#NoPrelude`"))
    true
}

sema_marker_rules_no_prelude_error: fn(name: String, span: Span, fix: String) -> Diagnostic Never! {
    sema_error("E0429", span, "`{name}` is not ambient here — this file opted out with `#NoPrelude`", "`#NoPrelude` disables the curated prelude auto-imports (`print` / `input`)", fix)
}

// The marker's result-cache contract is proven from the declared signature
// before lowering. A lazy `Iter`/`ViewIter` argument or result carries live
// computation state (E0940); every other argument must be hashable and not a
// list (E0939). A `#Memo` computed field's helper (Derives.jet
// sema_computed_field_memo_helper_func) takes the fields its formula reads; its
// store compares them by value, so each needs equality, not a hash. The first
// refused parameter ends the check. Purity (E0938) is judged by the solved
// effect row, not here.
sema_check_memoized_function: fn(func: Func, environment: SemaScopeEnvironment, program: SemaProgramTables, generic_params: [TGenericParam], diagnostics: ^[Diagnostic]) {
    marker: sema_marker_with_hook(func.markers, MarkerHook.Memo) ?? return
    field_helper: sema_computed_field_getter_function(func)
    loop parameter_index in 0..<func.params.len() {
        declared: if func.params[parameter_index].variadic -> Type.List{element: func.params[parameter_index].ty} else -> func.params[parameter_index].ty
        ty: sema_function_resolve_declared(environment, program, declared, environment.module_identity, generic_params)
        if sema_expression_zip_is_iter(ty) {
            diagnostics.push(sema_error("E0940", marker.span, "`#Memo` cannot cache lazy `Iter` values", "a lazy iterator carries live computation state instead of one completed result", "materialize the iterator before the memoized boundary"))
            return
        }
        if field_helper {
            if !sema_type_equatable(environment, program, ty) {
                diagnostics.push(sema_error("E0939", marker.span, "`#Memo` field reads `{func.params[parameter_index].name}`, which has no equality", "a kept field answer is reused while every field its formula reads is equal to its value at the first read, so each one must compare by value", "read only fields that compare by value, or drop `#Memo`"))
                return
            }
            next
        }
        if ty == .List(_) || !sema_type_hashable(environment, program, ty) {
            diagnostics.push(sema_error("E0939", marker.span, "`#Memo` parameter `{func.params[parameter_index].name}` is not hashable", "memoization keys are the function's argument tuple, so every argument must pass the existing hashability rule", "use an Int, Bool, Char, String, or named hashable value as the argument"))
            return
        }
    }
    declared_return: func.return_type ?? return
    if sema_expression_zip_is_iter(sema_function_resolve_declared(environment, program, declared_return, environment.module_identity, generic_params)) {
        diagnostics.push(sema_error("E0940", marker.span, "`#Memo` cannot cache a lazy `Iter` result", "a lazy iterator carries live computation state instead of one completed result", "materialize the iterator before returning from the memoized function"))
    }
}
