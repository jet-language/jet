use jet_foundation.[
    AppliedRuleApplication,
    CallArg,
    Call,
    Diagnostic,
    Expr,
    Func,
    Item,
    MARKER_ALLOW,
    MARKER_CONTEXT,
    MARKER_FX,
    MARKER_INTERRUPT,
    MARKER_META,
    MARKER_POLICY,
    MARKER_TARGET,
    MARKER_UNSAFE,
    Marker,
    MarkerDecl,
    MarkerDeclParam,
    Program,
    RuleSite,
    STATE_ARROW_LABEL,
    Span,
    Stmt,
    Symbol,
    SymbolKind,
    TAppliedRule,
    TAppliedRuleArgKind,
    TAppliedRuleArgumentMenu,
    TAppliedRuleCatalog,
    TAppliedRuleCompanionSite,
    TAppliedRuleParameter,
    TAppliedRuleSignature,
    TComptimeValue,
    TGenericParam,
    TextEdit,
    Type,
    UnOp,
    diagnostic_from_registry,
    diagnostic_with_edit,
    diagnostic_with_label,
    expr_span,
    symbol_id,
    type_name,
]

SemaMarkerRuleArgumentObservation: struct {
    ty: Type?
    constant: TComptimeValue?
    // The argument checked against the rule's expected type.
    checked: Bool
    comptime_requests: [SemaComptimeRequest]
    comptime_source: SemaComptimeItemSource?
    diagnostics: [Diagnostic]
}

SemaMarkerRuleArgumentFact: struct {
    marker_span: Span
    source_index: Int
    parameter_index: Int?
    kind: TAppliedRuleArgKind
    ty: Type?
    constant: TComptimeValue?
    checked: Bool
    comptime_requests: [SemaComptimeRequest]
}

SemaMarkerRulesCheckResult: struct {
    diagnostics: [Diagnostic]
    argument_facts: [SemaMarkerRuleArgumentFact]
    comptime_sources: [SemaComptimeItemSource]
    comptime_requests: [SemaComptimeRequest]
}

SemaMarkerRuleArgumentBinding: struct {
    source_index: Int
    parameter_index: Int?
    kind: TAppliedRuleArgKind
}

sema_marker_rules_append_name: fn(values: &[String], name: String) Never! {
    loop existing in values {
        if existing == name {
            return
        }
    }
    values.push(name.copy())
}

sema_marker_rules_expr_name: fn(value: Expr) -> String? {
    if value == .Ident(name, _, _) {
        if name.starts_with(".") {
            return Val(name.slice(1, name.len()))
        }
        return Val(name)
    }
    if value == .Field(_, name, _, _) {
        return Val(name)
    }
    if value == .EnumLit(_, name, _, _, _, _, _) {
        return Val(name)
    }
    None
}

sema_marker_rules_site_name: fn(site: RuleSite) -> String Never! {
    if {
        site == RuleSite.Package -> "Package"
        site == RuleSite.File -> "File"
        site == RuleSite.Module -> "Module"
        site == RuleSite.Function -> "Function"
        site == RuleSite.Method -> "Method"
        site == RuleSite.Block -> "Block"
        site == RuleSite.Statement -> "Statement"
        site == RuleSite.Expression -> "Expression"
        site == RuleSite.Type -> "Type"
        site == RuleSite.Impl -> "Impl"
        site == RuleSite.Trait -> "Trait"
        site == RuleSite.Declaration -> "Declaration"
        site == RuleSite.Constant -> "Constant"
        site == RuleSite.Field -> "Field"
        site == RuleSite.Variant -> "Variant"
        site == RuleSite.Parameter -> "Parameter"
        site == RuleSite.Test -> "Test"
        site == RuleSite.Operation -> "Operation"
        site == RuleSite.Text -> "Text"
        else -> "Arm"
    }
}

sema_marker_rules_site_value: fn(value: Expr) -> String? {
    name: sema_marker_rules_expr_name(value) ?? return None
    if name == "Package" || name == "File" || name == "Module" || name == "Function" || name == "Method" || name == "Block" || name == "Statement" || name == "Expression" || name == "Type" || name == "Impl" || name == "Trait" || name == "Declaration" || name == "Constant" || name == "Field" || name == "Variant" || name == "Parameter" || name == "Test" || name == "Operation" || name == "Text" || name == "Arm" {
        return Val(name)
    }
    None
}

sema_marker_rules_type_kind: fn(ty: Type) -> TAppliedRuleArgKind Never! {
    if ty == Type.String {
        return TAppliedRuleArgKind.String
    }
    if ty == Type.Bool {
        return TAppliedRuleArgKind.Bool
    }
    if ty == Type.Int {
        return TAppliedRuleArgKind.Int
    }
    if ty == .Named(name) {
        if name == "Value" || name == "PolicySetting" {
            return TAppliedRuleArgKind.Any
        }
        if name == "Path" {
            return TAppliedRuleArgKind.Path
        }
        if name == "Ident" {
            return TAppliedRuleArgKind.Ident
        }
        if name == "String" {
            return TAppliedRuleArgKind.String
        }
        if name == "Bool" {
            return TAppliedRuleArgKind.Bool
        }
        if name == "Int" {
            return TAppliedRuleArgKind.Int
        }
        return TAppliedRuleArgKind.Ident
    }
    if ty == .List(element) {
        if element == (Type.Named{name: "Effect"}) {
            return TAppliedRuleArgKind.EffectRoots
        }
    }
    if ty == .Union(members) {
        has_string := false
        has_duration := false
        has_naming_case := false
        loop member in members {
            if member == Type.String {
                has_string = true
            }
            if member == (Type.Named{name: "Duration"}) {
                has_duration = true
            }
            if member == (Type.Named{name: "NamingCase"}) {
                has_naming_case = true
            }
        }
        if has_string && has_duration && members.len() == 2 {
            return TAppliedRuleArgKind.DurationOrString
        }
        if has_string && has_naming_case && members.len() == 2 {
            return TAppliedRuleArgKind.StringOrMenu
        }
    }
    TAppliedRuleArgKind.Ident
}

sema_marker_rules_type_name_for_parameter: fn(parameter: MarkerDeclParam) -> String? {
    ty: parameter.ty ?? return Val("Value")
    Val(type_name(ty))
}

sema_marker_rules_parameter_kind: fn(parameter: MarkerDeclParam) -> TAppliedRuleArgKind Never! {
    ty: parameter.ty ?? return TAppliedRuleArgKind.Any
    sema_marker_rules_type_kind(ty)
}

sema_marker_rules_metadata_expr: fn(declaration: MarkerDecl, name: String) -> Expr? {
    loop parameter_index in 0..<declaration.params.len() {
        if declaration.params[parameter_index].name == name {
            return declaration.params[parameter_index].value
        }
    }
    None
}

sema_marker_rules_bool_fact: fn(declaration: MarkerDecl, name: String) -> Bool? {
    found := false
    loop parameter_index in 0..<declaration.params.len() {
        if declaration.params[parameter_index].name != name {
            next
        }
        found = true
        value: declaration.params[parameter_index].value ?? return None
        if value == .Bool(result, _, _) {
            return Val(result)
        }
        return None
    }
    if found {
        return None
    }
    Val(false)
}

sema_marker_rules_metadata_names: fn(declaration: MarkerDecl, name: String, sites: Bool) -> [String]? {
    found := false
    loop parameter_index in 0..<declaration.params.len() {
        if declaration.params[parameter_index].name != name {
            next
        }
        found = true
        value: declaration.params[parameter_index].value ?? return None
        if value == .ListLit(values, _, _) {
            names := [String]{}
            loop item in values {
                name_value := if sites -> sema_marker_rules_site_value(item) else -> sema_marker_rules_expr_name(item)
                value_name: name_value ?? return None
                sema_marker_rules_append_name(names, value_name)
            }
            return Val(names)
        }
        return None
    }
    if found {
        return None
    }
    if name == "$sites" {
        return None
    }
    Val([String]{})
}

// A declared `companion` setting; `site` is None when the rule declares none.
SemaMarkerRulesCompanion: struct {
    site: TAppliedRuleCompanionSite?
}

sema_marker_rules_companion: fn(declaration: MarkerDecl) -> SemaMarkerRulesCompanion? {
    value: sema_marker_rules_metadata_expr(declaration, "$companion") ?? return Val(SemaMarkerRulesCompanion{site: None})
    if value == .ListLit(values, _, _) {
        if values.len() != 2 {
            return None
        }
        companion_name: sema_marker_rules_expr_name(values[0]) ?? return None
        site: sema_marker_rules_site_value(values[1]) ?? return None
        return Val(SemaMarkerRulesCompanion{site: Val(TAppliedRuleCompanionSite{rule: companion_name, site: site})})
    }
    None
}

sema_marker_rules_resolution: fn(declaration: MarkerDecl) -> String? {
    value: sema_marker_rules_metadata_expr(declaration, "$resolution") ?? return Val("SiteBound")
    name: sema_marker_rules_expr_name(value) ?? return None
    if name == "SiteBound" || name == "Override" || name == "Merge" || name == "Tighten" {
        return Val(name)
    }
    None
}

sema_marker_rules_source_slice: fn(source: String, span: Span) -> String? {
    if span.start < 0 || span.end < span.start {
        return None
    }
    bytes := source.bytes()
    if span.end > bytes.len() {
        return None
    }
    text: String.from_bytes(bytes[span.start..<span.end]) ?? return None
    Val(text)
}

sema_marker_rules_applied_parameter: fn(parameter: MarkerDeclParam, source: String) -> TAppliedRuleParameter? {
    ty: parameter.ty ?? return None
    default_source := String?{None}
    if parameter.value != None {
        default_expr: parameter.value ?? return None
        default_source = Val(sema_marker_rules_source_slice(source, expr_span(default_expr)) ?? return None)
    }
    Val(TAppliedRuleParameter{
        name: parameter.name,
        kind: sema_marker_rules_type_kind(ty),
        source_type: type_name(ty),
        default_source: default_source,
    })
}

sema_marker_rules_applied_row: fn(declaration: MarkerDecl, source: String) -> TAppliedRule? {
    sites: sema_marker_rules_metadata_names(declaration, "$sites", true) ?? return None
    scopes: sema_marker_rules_metadata_names(declaration, "$scopes", false) ?? return None
    repeatable: sema_marker_rules_bool_fact(declaration, "$repeatable") ?? return None
    owns_menu: sema_marker_rules_bool_fact(declaration, "$owns_menu") ?? return None
    inherits: sema_marker_rules_bool_fact(declaration, "$inherits") ?? return None
    resolution: sema_marker_rules_resolution(declaration) ?? return None
    companion: sema_marker_rules_companion(declaration) ?? return None
    params := [TAppliedRuleParameter]{}
    variadic := TAppliedRuleArgKind?{None}
    variadic_source_type := String?{None}
    variadic_name := String?{None}
    loop parameter_index in 0..<declaration.params.len() {
        if declaration.params[parameter_index].name.starts_with("$") {
            next
        }
        ty: declaration.params[parameter_index].ty ?? return None
        if declaration.params[parameter_index].variadic {
            if variadic != None {
                return None
            }
            variadic = Val(sema_marker_rules_type_kind(ty))
            variadic_source_type = Val(type_name(ty))
            variadic_name = Val(declaration.params[parameter_index].name)
            next
        }
        applied_parameter: sema_marker_rules_applied_parameter(declaration.params[parameter_index], source) ?? return None
        params.push(applied_parameter)
    }
    Val(TAppliedRule{
        name: declaration.name,
        signature: TAppliedRuleSignature{params: params, variadic: variadic, variadic_source_type: variadic_source_type, variadic_name: variadic_name},
        policy_scopes: scopes,
        sites: sites,
        repeatable: repeatable,
        owns_menu: owns_menu,
        companion_site: companion.site,
        inherits: inherits,
        resolution: resolution,
    })
}

// Rust RULE_ARG_TYPES_WITHOUT_CORE_DECLARATION: `Ident` is a free identifier
// slot and `Type`/`T.default` are language-checked, so none names a
// core.compiler.lang menu; every other identifier-kind type is a menu name.
sema_marker_rules_rule_requires_menu: fn(rule: TAppliedRule, source_type: String, kind: TAppliedRuleArgKind) -> String? {
    if source_type == "[Effect]" {
        return Val("Effect")
    }
    if kind != TAppliedRuleArgKind.Ident || source_type == "Ident" || source_type == "Type" || source_type == "T.default" {
        return None
    }
    Val(source_type)
}

sema_marker_rules_catalog_has_menu: fn(menus: [TAppliedRuleArgumentMenu], name: String) -> Bool Never! {
    loop menu in menus {
        if menu.name == name {
            return true
        }
    }
    false
}

// The parsed embedded Prelude/Markers.jet Program is the sole applied-rule
// row source. Menu rows are explicit carrier input because their canonical
// source is Core.jet's specialized `types { … }` metadata, not marker sites or
// Program policy declarations.
sema_marker_rules_build_catalog: fn(marker_source: Program, marker_source_text: String, argument_menus: [TAppliedRuleArgumentMenu]) -> TAppliedRuleCatalog? {
    rows := [TAppliedRule]{}
    loop item in marker_source.items {
        if item == .MarkerDecl(declaration) {
            row: sema_marker_rules_applied_row(declaration, marker_source_text) ?? return None
            loop existing in rows {
                if existing.name == row.name {
                    return None
                }
            }
            rows.push(row)
        }
    }
    if rows.len() == 0 {
        return None
    }
    menus := [TAppliedRuleArgumentMenu]{}
    loop menu in argument_menus {
        loop existing in menus {
            if existing.name == menu.name {
                return None
            }
        }
        menus.push(TAppliedRuleArgumentMenu{
            name: menu.name,
            variants: menu.variants,
            first_variant_segment: menu.first_variant_segment,
        })
    }
    loop rule in rows {
        loop parameter in rule.signature.params {
            menu_name: sema_marker_rules_rule_requires_menu(rule, parameter.source_type, parameter.kind)
            if menu_name != None && !sema_marker_rules_catalog_has_menu(menus, menu_name) {
                return None
            }
        }
        if rule.signature.variadic != None {
            source_type: rule.signature.variadic_source_type ?? return None
            variadic_kind: rule.signature.variadic ?? return None
            menu_name: sema_marker_rules_rule_requires_menu(rule, source_type, variadic_kind)
            if menu_name != None && !sema_marker_rules_catalog_has_menu(menus, menu_name) {
                return None
            }
        }
    }
    Val(TAppliedRuleCatalog{rows: rows, argument_menus: menus})
}

sema_marker_rules_catalog_rule_index: fn(rules: [TAppliedRule], name: String) -> Int? {
    loop (index, rule) in rules {
        if rule.name == name {
            return Val(index)
        }
    }
    None
}

sema_marker_rules_user_rule_index: fn(registry: SemaScopeMembersMarkerRegistry, marker: Marker) -> Int? {
    loop (index, rule) in registry.marker_rules {
        if marker.declaration_module != None {
            if rule.declaration_module == marker.declaration_module && rule.declaration_span == marker.declaration_span -> return Val(index)
        } else if rule.name == marker.name && rule.declaration_module == None -> return Val(index)
    }
    None
}

sema_marker_rules_builtin_index: fn(registry: SemaScopeMembersMarkerRegistry, marker: Marker) -> Int? {
    if marker.declaration_module != None -> return None
    sema_marker_rules_catalog_rule_index(registry.applied_rules, marker.name)
}

sema_marker_rules_menu_index: fn(menus: [TAppliedRuleArgumentMenu], name: String) -> Int? {
    loop (index, menu) in menus {
        if menu.name == name {
            return Val(index)
        }
    }
    None
}

sema_marker_rules_marker_expression: fn(marker: Marker, index: Int) -> Expr? {
    if index < 0 || index >= marker.args.len() {
        return None
    }
    if marker.args[index] == .Expr(value) {
        return Val(value)
    }
    None
}

sema_marker_rules_label: fn(marker: Marker, index: Int) -> String? {
    if index < 0 || index >= marker.arg_labels.len() {
        return None
    }
    if marker.arg_labels[index] == .Val(label) {
        // `#State(A -> B)`'s arrow binds B to the next
        // parameter, as a positional argument does.
        if label.name == STATE_ARROW_LABEL -> return None
        return Val(label.name)
    }
    None
}

sema_marker_rules_marker_signature_bindings: fn(marker: Marker, signature: TAppliedRuleSignature) -> [SemaMarkerRuleArgumentBinding]? {
    if marker.args.len() != marker.arg_labels.len() {
        return None
    }
    bindings := [SemaMarkerRuleArgumentBinding]{}
    // Rust `rule_signature_bindings`: a bare `#Unsafe` binds nothing; its
    // missing reason is E3112's, not E0930's.
    if marker.name == MARKER_UNSAFE && marker.args.len() == 0 -> return Val(bindings)
    supplied := [Bool]{}
    loop _ in signature.params {
        supplied.push(false)
    }
    if marker.name == MARKER_META && marker.arg_labels.len() == marker.args.len() {
        all_named := true
        loop label in marker.arg_labels {
            if label == None {
                all_named = false
            }
        }
        if all_named {
            loop source_index in 0..<marker.args.len() {
                label: sema_marker_rules_label(marker, source_index) ?? return None
                selected := Int?{None}
                loop (index, parameter) in signature.params {
                    if parameter.name == label {
                        selected = Val(index)
                    }
                }
                parameter_index: selected ?? return None
                bindings.push(SemaMarkerRuleArgumentBinding{source_index: source_index, parameter_index: Val(parameter_index), kind: signature.params[parameter_index].kind})
            }
            return Val(bindings)
        }
    }
    if marker.name == MARKER_POLICY {
        kind: signature.variadic ?? return None
        loop source_index in 0..<marker.args.len() {
            label := sema_marker_rules_label(marker, source_index)
            if label != None {
                name: label ?? return None
                if name != "copies" && name != "writes" && name != "sentries" && name != "arithmetic" {
                    return None
                }
            }
            bindings.push(SemaMarkerRuleArgumentBinding{source_index: source_index, parameter_index: None, kind: kind})
        }
        return Val(bindings)
    }
    next_positional := 0
    saw_named := false
    loop source_index in 0..<marker.args.len() {
        label := sema_marker_rules_label(marker, source_index)
        if label == None && marker.name == MARKER_META {
            expression: sema_marker_rules_marker_expression(marker, source_index)
            if expression == .Val(value) && value == .Ident(name, _, _) && name == "tunable" {
                label = Val(name)
            }
        }
        parameter_index := Int?{None}
        if {
            label != None -> {
                name: label ?? return None
                saw_named = true
                selected := Int?{None}
                loop (index, parameter) in signature.params {
                    if parameter.name == name {
                        selected = Val(index)
                    }
                }
                index: selected ?? return None
                if supplied[index] && marker.name != MARKER_META {
                    return None
                }
                supplied[index] = true
                parameter_index = Val(index)
            }
            else -> {
                if saw_named {
                    return None
                }
                loop next_positional < supplied.len() && supplied[next_positional] {
                    next_positional += 1
                }
                if {
                    next_positional < supplied.len() -> {
                        selected := next_positional
                        supplied[selected] = true
                        parameter_index = Val(selected)
                        next_positional += 1
                    }
                    signature.variadic == None -> {
                        return None
                    }
                }
            }
        }
        kind := if parameter_index == {
            .Val(index) -> signature.params[index].kind
            .None -> signature.variadic ?? return None
        }
        bindings.push(SemaMarkerRuleArgumentBinding{source_index: source_index, parameter_index: parameter_index, kind: kind})
    }
    loop (index, parameter) in signature.params {
        if !supplied[index] && parameter.default_source == None {
            return None
        }
    }
    Val(bindings)
}

sema_marker_rules_signature_text: fn(name: String, signature: TAppliedRuleSignature) -> String Never! {
    parts := [String]{}
    loop parameter in signature.params {
        default := ""
        default_value_option := parameter.default_source
        if default_value_option != None {
            default_value: default_value_option ?? ""
            default = "{{{default_value}}}"
        }
        parts.push("{parameter.name}: {parameter.source_type}{default}")
    }
    variadic_type_option := signature.variadic_source_type
    if variadic_type_option != None {
        variadic_type: variadic_type_option ?? ""
        parts.push("{variadic_type}...")
    }
    "{name}({parts.join(", ")})"
}

// Rust `marker_argument_shape_error` for a registered rule, the
// declared-signature form for a source-declared one. The span is Rust's marker
// span: the name through the closing `)`, without `#`. A `#X: true` line
// missing its Bool argument is the parentheses code.
sema_marker_rules_signature_error: fn(marker: Marker, signature: TAppliedRuleSignature, declared: Bool) -> Diagnostic {
    if sema_marker_rules_line_needs_bool(marker, signature) {
        diagnostic: sema_error("E0943", marker.span, "`#{marker.name}: true` gives `#{marker.name}` no arguments, but it needs a Bool", "`true` alone on a marker line applies the marker with its defaults, so a Bool argument is written in parentheses", "write `#{marker.name}: (true)`")
        return diagnostic_with_edit(diagnostic, TextEdit{span: Span{start: marker.span.end - 4, end: marker.span.end}, new_text: "(true)"})
    }
    expected := sema_marker_rules_signature_text(marker.name, signature)
    fix := if declared -> "match the declared signature `{expected}`" else -> "match the registered signature `{expected}`"
    sema_error("E0930", Span{start: marker.name_span.start, end: marker.span.end}, "`#{marker.name}` arguments do not match `{expected}`", "marker arguments use the same call grammar and typed signature as function arguments", fix)
}

// The path an argument names; an `Effect` argument may name it denied, as
// `#FX(!Net, !FS)` does (`!Net` names `Net`), or scoped, as
// `#FX(FS.Read("data/"))` does (it names `FS.Read`).
sema_marker_rules_effect_path: fn(argument: Expr, source_type: String) -> String? {
    if source_type == "Effect" && argument == .Unary(op, operand, _, _) {
        if op == UnOp.Not {
            if sema_marker_rules_scoped_effect_path(operand) == .Val(scoped) -> return Val(scoped)
            return sema_marker_rules_argument_path(operand)
        }
    }
    if source_type == "Effect" && sema_marker_rules_scoped_effect_path(argument) == .Val(scoped) -> return Val(scoped)
    sema_marker_rules_argument_path(argument)
}

// The effect a scoped entry names: `FS.Read` in `FS.Read("data/")`, `Net` in
// `Net("api.example.com")`; None for any other argument. The parser checks
// the scope itself (parser_authority_effect_entry).
sema_marker_rules_scoped_effect_path: fn(argument: Expr) -> String? {
    // copy: the path outlives the argument.
    if argument == .Call(call, _) -> return Val(call.name.copy())
    if argument == .MethodCall(receiver, method, _, _, _, _, _) {
        receiver_path: sema_marker_rules_argument_path(receiver) ?? return None
        return Val("{receiver_path}.{method}")
    }
    None
}

// The span of the root an argument path starts from: `Bogus` in `Bogus.Write`,
// in `!Bogus` or in `Bogus.Write("data/")`.
sema_marker_rules_root_span: fn(argument: Expr) -> Span {
    if argument == .Unary(op, operand, _, _) {
        if op == UnOp.Not -> return sema_marker_rules_root_span(operand)
    }
    if argument == .Field(base, _, _, _) -> return sema_marker_rules_root_span(base)
    if argument == .MethodCall(receiver, _, _, _, _, _, _) -> return sema_marker_rules_root_span(receiver)
    expr_span(argument)
}

// Whether an argument names an item; an `Effect` argument may name it denied
// or scoped.
sema_marker_rules_names_item: fn(argument: Expr, source_type: String) -> Bool {
    if source_type == "Effect" && argument == .Unary(op, operand, _, _) {
        if op == UnOp.Not -> return sema_marker_rules_names_item(operand, "") || sema_marker_rules_scoped_effect_path(operand) != None
    }
    if source_type == "Effect" && sema_marker_rules_scoped_effect_path(argument) != None -> return true
    argument == .Ident(_, _, _) || argument == .Field(_, _, _, _) || argument == .EnumLit(_, _, _, _, _, _, _)
}

// A closed-menu word is written as a variant (`.Camel`); a bare name is a
// value, so `#Rename(FIELD_NAME)` reads the constant and must be a String.
sema_marker_rules_names_menu_word: fn(argument: Expr) -> Bool {
    argument == .EnumLit(_, _, _, _, _, _, _)
}

sema_marker_rules_argument_path: fn(expression: Expr) -> String? {
    if expression == .Ident(name, _, _) {
        return Val(name)
    }
    if expression == .Field(base, member, _, _) {
        path: sema_marker_rules_argument_path(base) ?? return None
        return Val("{path}.{member}")
    }
    if expression == .EnumLit(_, name, _, _, _, _, _) {
        return Val(name)
    }
    None
}
sema_marker_rules_staged_argument_value: fn(values: [SemaComptimeItemValue], environment: SemaScopeEnvironment, program: SemaProgramTables, marker: Marker, source_index: Int) -> TComptimeValue? {
    destination_suffix := if source_index == 0 -> "::marker::{marker.name}::{marker.name_span.start}" else -> "::marker::{marker.name}::{marker.name_span.start}::arg::{source_index}"
    loop value in values {
        if value.kind == SemaComptimeItemKind.MarkerArgument && value.module_identity == environment.module_identity && value.destination_key.ends_with(destination_suffix) {
            return Val(value.value)
        }
    }
    None
}

sema_marker_rules_constant_for_reference: fn(symbol: Symbol, references: [SemaNameReferenceFact], reference_start: Int, environment: SemaScopeEnvironment, program: SemaProgramTables, values: [SemaComptimeItemValue]) -> TComptimeValue? {
    found := false
    loop index in reference_start..<references.len() {
        reference := references[index]
        if reference.symbol.id.key == symbol.id.key && reference.symbol.kind == SymbolKind.Constant {
            found = true
            break
        }
    }
    if !found {
        return None
    }
    loop value in values {
        if value.kind == SemaComptimeItemKind.Constant && value.module_identity == symbol.module_name && value.key == symbol.id.key {
            return Val(value.value)
        }
    }
    if program.registration_graph == .Val(graph) {
        module_index: sema_registration_module_index(graph, symbol.module_name) ?? return None
        loop constant_index in 0..<graph.modules[module_index].constants.len() {
            if graph.modules[module_index].constants[constant_index].symbol.id.key == symbol.id.key {
                value: graph.modules[module_index].constants[constant_index].declaration.ct ?? return None
                return sema_checked_comptime(value)
            }
        }
    }
    None
}

sema_marker_rules_constant_value: fn(checked: TExpr, marker: Marker, source_index: Int, reference_start: Int, context: &SemaCheckContext, environment: SemaScopeEnvironment, program: SemaProgramTables, values: [SemaComptimeItemValue]) -> TComptimeValue? {
    if source_index == 0 && marker.ct == .Val(value) {
        return sema_checked_comptime(value)
    }
    staged: sema_marker_rules_staged_argument_value(values, environment, program, marker, source_index)
    if staged != None {
        return staged
    }
    direct: sema_expr_comptime_value(checked, context)
    if direct != None {
        return direct
    }
    if checked.kind == .Flat(index) && context.arena.tree.nodes[index - context.arena.tree.node_base].kind == .ConstRef(symbol) {
        loop reference in context.name_references {
            if reference.symbol.id.key == symbol.key && reference.symbol.kind == SymbolKind.Constant {
                return sema_marker_rules_constant_for_reference(reference.symbol, context.name_references, reference_start, environment, program, values)
            }
        }
    }
    None
}

// The argument was just checked in this module (`reference_start` onward in
// `context.name_references`), against the environment whose graph already
// carries `values`, so its constant dependencies come from those references
// instead of a second check on a copy of the graph.
sema_marker_rules_comptime_source: fn(marker: Marker, source_index: Int, expression: Expr, expected_type: Type?, reference_start: Int, context: SemaCheckContext, environment: SemaScopeEnvironment, program: SemaProgramTables, values: [SemaComptimeItemValue]) -> SemaComptimeItemSource? {
    if program.registration_graph == .Val(graph) {
        destination_key := "{marker.name}::marker::{marker.name_span.start}::arg::{source_index}"
        source := SemaComptimeItemSource{
            module_identity: environment.module_identity,
            key: "{environment.module_identity}::{destination_key}",
            destination_key: destination_key,
            name: "#{marker.name} argument {source_index + 1}",
            source_file: environment.source_file,
            kind: SemaComptimeItemKind.MarkerArgument,
            expression: expression,
            expected_type: expected_type,
            span: expr_span(expression),
            dependencies: [String]{},
            checked_text: None,
        }
        references := [SemaNameReferenceFact]{}
        loop index in reference_start..<context.name_references.len() -> references.push(context.name_references[index])
        source.dependencies = sema_comptime_dependencies_from_references(graph, references, values)
        return Val(source)
    }
    None
}

sema_marker_rules_observe_argument: fn(marker: Marker, source_index: Int, expected_type: Type?, capture_constant: Bool, argument: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, values: [SemaComptimeItemValue]) -> SemaMarkerRuleArgumentObservation {
    diagnostics := [Diagnostic]{}
    checked_expected := expected_type
    if program.registration_graph == .Val(graph) {
        if checked_expected == .Val(required) {
            checked_expected = Val(sema_type_resolve_declared_with_generics(graph, required, environment.module_identity, environment.generic_params))
        }
    }
    // Probed on the live tables, rolled back below.
    probe_scope_mark: sema_scope_mark(scopes)
    probe_fork: sema_ownership_fork(state)
    probe_context_mark: sema_check_context_mark(context)
    reference_start := context.name_references.len()
    request_start := context.comptime_requests.len()
    checked := sema_check_expression(argument, checked_expected, environment, program, scopes, state, tail_store, context, diagnostics)
    sema_ownership_fork_rollback(state, probe_fork)
    sema_ownership_fork_close(state, probe_fork)
    checked_value := false
    constant := TComptimeValue?{None}
    staged_source := SemaComptimeItemSource?{None}
    observed_type := Type?{None}
    if checked == .Val(value) {
        required := checked_expected
        if required != None {
            required_type: required ?? value.ty
            assignable := Val(sema_type_assignable(required_type, value.ty))
            if program.registration_graph == .Val(graph) {
                assignable = sema_type_assignable_in_graph_with_generics(graph, required_type, value.ty, environment.module_identity, environment.generic_params)
            }
            if {
                assignable == (Val(false)) -> {
                    diagnostics.push(sema_type_mismatch(required_type, value.ty, value.span))
                    checked = None
                }
                assignable == None -> {
                    checked = None
                }
            }
        }
        if checked != None {
            checked_value = true
            observed_type = Val(value.ty)
            if capture_constant {
                constant = sema_marker_rules_constant_value(value, marker, source_index, reference_start, context, environment, program, values)
                if constant == None && sema_marker_rules_explicit_constant(argument, scopes) {
                    staged_source = sema_marker_rules_comptime_source(marker, source_index, argument, checked_expected, reference_start, context, environment, program, values)
                }
            }
        }
    }
    requests := [SemaComptimeRequest]{}
    loop index in request_start..<context.comptime_requests.len() {
        requests.push(context.comptime_requests[index])
    }
    sema_check_context_rollback(context, probe_context_mark)
    sema_scope_rollback(scopes, probe_scope_mark)
    SemaMarkerRuleArgumentObservation{
        ty: observed_type,
        constant: constant,
        checked: checked_value,
        comptime_requests: requests,
        comptime_source: staged_source,
        diagnostics: diagnostics,
    }
}

// Compile time is always explicit, so a rule argument is evaluated only when
// it is written as a constant: literals (including unit and enum literals),
// type-, enum- or module-qualified members, module constants, prepared
// values, and negation or arithmetic over those. A local binding or a
// function call never counts as a constant here.
sema_marker_rules_explicit_constant: fn(expression: Expr, scopes: SemaScopeTable) -> Bool Never! {
    if expression == {
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .Absent(_, _) -> return true
        .UnitLit(_, _, _, _, _, _, _) | .ComptimeName(_, _, _, _) -> return true
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Interp(inner, _) {
                    if !sema_marker_rules_explicit_constant(inner, scopes) -> return false
                }
            }
            return true
        }
        .Paren(inner, _, _) | .Unary(_, inner, _, _) | .Present(inner, _, _) -> return sema_marker_rules_explicit_constant(inner, scopes)
        .Binary(_, left, right, _, _) -> return sema_marker_rules_explicit_constant(left, scopes) && sema_marker_rules_explicit_constant(right, scopes)
        .CompareChain(operands, _, _, _, _) | .ListLit(operands, _, _) -> {
            loop operand in operands {
                if !sema_marker_rules_explicit_constant(operand, scopes) -> return false
            }
            return true
        }
        .TupleLit(fields, _, _, _) -> {
            loop field in fields {
                if !sema_marker_rules_explicit_constant(field.value, scopes) -> return false
            }
            return true
        }
        .MapLit(entries, _, _) -> {
            loop entry in entries {
                if !sema_marker_rules_explicit_constant(entry.key, scopes) || !sema_marker_rules_explicit_constant(entry.value, scopes) -> return false
            }
            return true
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            loop arg in args {
                value: if arg == {
                    .Positional(inner) -> inner
                    .Named(_, inner) -> inner
                }
                if !sema_marker_rules_explicit_constant(value, scopes) -> return false
            }
            return true
        }
        .Ident(name, _, _) -> {
            index: sema_scope_resolve_index(scopes, name) ?? return false
            return scopes.bindings[index].symbol.kind == SymbolKind.Constant
        }
        .Field(base, _, _, _) -> return sema_marker_rules_constant_qualifier(base, scopes)
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return false
    }
}

// The base of a member read `base.member` that keeps it constant: a type,
// enum, module or constant name (`Method.Get`, `math.PI`), or a value that
// is itself an explicit constant.
sema_marker_rules_constant_qualifier: fn(base: Expr, scopes: SemaScopeTable) -> Bool Never! {
    if base == {
        .Field(inner, _, _, _) -> return sema_marker_rules_constant_qualifier(inner, scopes)
        .Ident(name, _, _) -> {
            index: sema_scope_resolve_index(scopes, name) ?? return true
            kind: scopes.bindings[index].symbol.kind
            return kind != SymbolKind.Local && kind != SymbolKind.Parameter
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return sema_marker_rules_explicit_constant(base, scopes)
    }
}

sema_marker_rules_append_comptime_source: fn(sources: &[SemaComptimeItemSource], source: SemaComptimeItemSource) Never! {
    loop existing in sources {
        if existing.module_identity == source.module_identity && existing.key == source.key {
            return
        }
    }
    sources.push(source.copy())
}

sema_marker_rules_append_comptime_requests: fn(requests: &[SemaComptimeRequest], incoming: [SemaComptimeRequest]) Never! {
    loop request in incoming {
        requests.push(request.copy())
    }
}

sema_marker_rules_menu_candidate: fn(path: String, menu: TAppliedRuleArgumentMenu) -> String Never! {
    segments := path.split(".").to_list()
    start := 0
    loop index in 0..<segments.len() {
        if segments[index] == menu.name && index + 1 < segments.len() {
            start = index + 1
            break
        }
    }
    return if menu.first_variant_segment -> segments[start] else -> segments[segments.len() - 1]
}

// A `.Variant` argument is underlined from the rule name; a bare or labeled
// argument from the `#`, as the Rust checker's snapshots pin.
sema_marker_rules_unknown_variant_error: fn(marker: Marker, menu: TAppliedRuleArgumentMenu, written: String, argument: Expr) -> Diagnostic {
    variants := (loop variant in menu.variants -> "`{variant}`")
    choices := variants.join(", ")
    start: if argument == .EnumLit(_, _, _, _, _, _, _) -> marker.name_span.start else -> marker.span.start
    sema_error("E0930", Span{start: start, end: marker.span.end}, "`#{marker.name}` has no `{menu.name}` called `{written}`", "`{menu.name}` is a closed menu: {choices}", "pick one of {choices}")
}

sema_marker_rules_validate_argument_signature: fn(marker: Marker, signature: TAppliedRuleSignature, expected_types: [Type?], variadic_expected_type: Type?, declared: Bool, owns_menu: Bool, registry: SemaScopeMembersMarkerRegistry, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, values: [SemaComptimeItemValue], facts: &[SemaMarkerRuleArgumentFact], comptime_sources: &[SemaComptimeItemSource], comptime_requests: &[SemaComptimeRequest], diagnostics: &[Diagnostic]) -> Bool {
    bindings: sema_marker_rules_marker_signature_bindings(marker, signature) ?? {
        diagnostics.push(sema_marker_rules_signature_error(marker, signature, declared))
        return false
    }
    valid := true
    had_declared_expression_error := false
    pending_facts := [SemaMarkerRuleArgumentFact]{}
    loop binding in bindings {
        expression: sema_marker_rules_marker_expression(marker, binding.source_index)
        if expression == None {
            if marker.name == MARKER_INTERRUPT && binding.source_index == 1 {
                pending_facts.push(SemaMarkerRuleArgumentFact{marker_span: marker.name_span, source_index: binding.source_index, parameter_index: binding.parameter_index, kind: binding.kind, ty: None, constant: None, checked: false, comptime_requests: [SemaComptimeRequest]{}})
                next
            }
            diagnostics.push(sema_marker_rules_signature_error(marker, signature, declared))
            return false
        }
        argument: expression
        source_type := ""
        if binding.parameter_index == {
            .Val(index) -> {
                if index < signature.params.len() {
                    source_type = signature.params[index].source_type
                }
            }
            .None -> {
                source_type = signature.variadic_source_type ?? ""
            }
        }
        if !declared && !owns_menu {
            // A `[Menu]` parameter checks each written element against the menu.
            list_menu: source_type.starts_with("[") && source_type.ends_with("]")
            menu_type: if list_menu -> source_type.slice(1, source_type.len() - 1) else -> source_type
            menu_index_option := sema_marker_rules_menu_index(registry.argument_menus, menu_type)
            if menu_index_option != None {
                menu_index: menu_index_option ?? return false
                menu := registry.argument_menus[menu_index]
                elements := [Expr]{argument}
                if list_menu {
                    elements = if argument == .ListLit(items, _, _) -> items else -> [Expr]{}
                }
                if menu.variants.len() > 0 {
                    loop element in elements {
                        path: sema_marker_rules_effect_path(element, menu_type)
                        if path == .Val(value) {
                            candidate := sema_marker_rules_menu_candidate(value, menu)
                            if candidate != "" && !menu.variants.contains(candidate) {
                                // An unknown effect root is the effect vocabulary's own E0119, reported once.
                                unknown: if menu.name == "Effect" -> sema_effect_unknown(candidate, sema_marker_rules_root_span(element)) else -> sema_marker_rules_unknown_variant_error(marker, menu, candidate, element)
                                diagnostics.push(unknown)
                                return false
                            }
                        }
                    }
                }
            }
        }
        expected_type := Type?{None}
        if binding.parameter_index == {
            .Val(index) -> {
                if index < expected_types.len() {
                    expected_type = expected_types[index]
                }
            }
            .None -> {
                expected_type = variadic_expected_type.copy()
            }
        }
        observation := SemaMarkerRuleArgumentObservation{
            ty: None,
            constant: None,
            checked: false,
            comptime_requests: [SemaComptimeRequest]{},
            comptime_source: None,
            diagnostics: [Diagnostic]{},
        }
        observe := true
        unit_argument := argument == .UnitLit(_, _, _, _, _, _, _)
        if {
            !declared && (binding.kind == TAppliedRuleArgKind.Ident || (binding.kind == TAppliedRuleArgKind.Any && marker.name != "Default") || (binding.kind == TAppliedRuleArgKind.DurationOrString && unit_argument) || (binding.kind == TAppliedRuleArgKind.StringOrMenu && sema_marker_rules_names_menu_word(argument)) || binding.kind == TAppliedRuleArgKind.EffectRoots) -> {
                observe = false
            }
            !declared && binding.kind == TAppliedRuleArgKind.Bool && marker.name == MARKER_META && argument == .Ident(name, _, _) && name == "tunable" -> {
                observation.ty = Val(Type.Bool)
                observe = false
            }
        }
        if observe {
            capture_constant := declared || binding.kind == TAppliedRuleArgKind.String || binding.kind == TAppliedRuleArgKind.Bool || binding.kind == TAppliedRuleArgKind.Int
            observation = sema_marker_rules_observe_argument(marker, binding.source_index, if declared -> expected_type else -> None, capture_constant, argument, environment, program, scopes, state, tail_store, context, values)
            loop diagnostic in observation.diagnostics {
                diagnostics.push(diagnostic)
            }
            if declared && observation.diagnostics.len() > 0 {
                had_declared_expression_error = true
            }
            if observation.comptime_source == .Val(source) {
                sema_marker_rules_append_comptime_source(comptime_sources, source)
            }
            sema_marker_rules_append_comptime_requests(comptime_requests, observation.comptime_requests)
        }
        matches := if {
            declared -> observation.checked
            else -> {
                if binding.kind == {
                    .Any -> true
                    .String -> observation.ty == (Val(Type.String))
                    .Path -> observation.ty == (Val(Type.Named{name: "Path"}))
                    .Ident -> sema_marker_rules_names_item(argument, source_type)
                    .Bool -> observation.ty == (Val(Type.Bool))
                    .Int -> observation.ty == (Val(Type.Int))
                    .DurationOrString -> unit_argument || observation.ty == (Val(Type.String)) || observation.ty == (Val(Type.Named{name: "Duration"}))
                    .StringOrMenu -> sema_marker_rules_names_menu_word(argument) || observation.ty == (Val(Type.String))
                    .EffectRoots -> argument == .ListLit(_, _, _)
                }
            }
        }
        if !matches {
            valid = false
        }
        pending_facts.push(SemaMarkerRuleArgumentFact{
            marker_span: marker.name_span,
            source_index: binding.source_index,
            parameter_index: binding.parameter_index,
            kind: binding.kind,
            ty: observation.ty,
            constant: observation.constant,
            checked: observation.checked,
            comptime_requests: observation.comptime_requests,
        })
    }
    if !valid {
        if !had_declared_expression_error {
            diagnostics.push(sema_marker_rules_signature_error(marker, signature, declared))
        }
        return false
    }
    loop fact in pending_facts {
        facts.push(fact)
    }
    true
}

// Rust `validate_rule_signature`: a builtin marker binds its arguments against
// its registered rule signature, each argument checked in the scope of the site
// that carries it (E0930). Rust's sites, each ported here: a local binding
// (`check_binding`), a marked statement or block
// (sema_marker_rules_check_statement_facts), a `#Context` block
// (sema_marker_rules_check_context_fact), a function or method, and the
// static-product sites (`resolve_static_rule_products`,
// sema_marker_rules_check_static_sites). True when the arguments bind or no
// registered rule governs the marker.
sema_marker_rules_check_rule_signature: fn(marker: Marker, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if marker.declaration_module != None -> return true
    if program.registration_graph == .Val(graph) {
        if graph.marker_catalog == .Val(registry) {
            rule_index: sema_marker_rules_builtin_index(registry, marker) ?? return true
            expected_types: (loop _ in registry.applied_rules[rule_index].signature.params -> Type?{None})
            facts := [SemaMarkerRuleArgumentFact]{}
            sources := [SemaComptimeItemSource]{}
            requests := [SemaComptimeRequest]{}
            return sema_marker_rules_validate_argument_signature(marker, registry.applied_rules[rule_index].signature, expected_types, None, false, registry.applied_rules[rule_index].owns_menu, registry, environment, program, scopes, state, tail_store, context, [SemaComptimeItemValue]{}, facts, sources, requests, diagnostics)
        }
    }
    true
}

// A `#X: true` line whose rule's first required argument is a Bool: `true`
// there means "no arguments", so the Bool is missing.
sema_marker_rules_line_needs_bool: fn(marker: Marker, signature: TAppliedRuleSignature) -> Bool Never! {
    if !marker.inside || marker.negated || marker.args.len() != 0 -> return false
    loop parameter in signature.params {
        if parameter.default_source != None -> next
        return parameter.kind == TAppliedRuleArgKind.Bool || parameter.source_type == "Bool"
    }
    false
}

// Every marker of `markers` through sema_marker_rules_check_rule_signature;
// true when all of them bind.
sema_marker_rules_check_rule_signatures: fn(markers: [Marker], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    loop marker in markers {
        if !sema_marker_rules_check_rule_signature(marker, environment, program, scopes, state, tail_store, context, diagnostics) -> valid = false
    }
    valid
}

// Rust `take_statement_rule_fact` then `validate_rule_signature`: the marker of
// a marked statement or block is the module's Statement- or Block-site
// application targeting the statement. `#Meta` is its binding's
// (Statements.jet) and `#Context` its block's
// (sema_marker_rules_check_context_fact). A marker with a site-dependent
// signature (`#HTML(path)` at the file site, bare `#HTML { … }` at the block
// site; Rust `validate_registered_rule_marker`, @ 6083377777) is bare at its
// block site. The block form's header is the checked text block's own law
// (sema_stmt_check_scope_member, E0617).
sema_marker_rules_check_statement_facts: fn(target: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) {
    if program.registration_graph == .Val(graph) {
        if graph.marker_catalog == .Val(registry) {
            row: sema_scope_caller_row(environment, graph)
            if row < 0 -> return
            loop index in 0..<graph.modules[row].program.rule_facts.len() {
                if graph.modules[row].program.rule_facts[index].target != (Val(target)) -> next
                if graph.modules[row].program.rule_facts[index].site != (Val(RuleSite.Block)) && graph.modules[row].program.rule_facts[index].site != (Val(RuleSite.Statement)) -> next
                if graph.modules[row].program.rule_facts[index].marker.name == MARKER_META || graph.modules[row].program.rule_facts[index].marker.name == MARKER_CONTEXT -> next
                if graph.modules[row].program.rule_facts[index].site == (Val(RuleSite.Block)) && sema_marker_rules_block_form_is_bare(registry, graph.modules[row].program.rule_facts[index].marker) -> next
                _ := sema_marker_rules_check_rule_signature(graph.modules[row].program.rule_facts[index].marker, environment, program, scopes, state, tail_store, context, diagnostics)
            }
        }
    }
}

// A builtin rule registered at both the file and the block site takes its
// signature at the file site, so its block form is bare.
sema_marker_rules_block_form_is_bare: fn(registry: SemaScopeMembersMarkerRegistry, marker: Marker) -> Bool {
    rule_index: sema_marker_rules_builtin_index(registry, marker) ?? return false
    registry.applied_rules[rule_index].sites.contains(sema_marker_rules_site_name(RuleSite.File)) && registry.applied_rules[rule_index].sites.contains(sema_marker_rules_site_name(RuleSite.Block))
}

// Rust `Stmt::ContextBlock`: the block's `#Context` application binds against
// `Context(allocator:, logger:, deadline:)`. False when it does not bind; the
// field checks then stay quiet.
sema_marker_rules_check_context_fact: fn(span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if program.registration_graph == .Val(graph) {
        if graph.marker_catalog == None -> return true
        row: sema_scope_caller_row(environment, graph)
        if row < 0 -> return true
        loop index in 0..<graph.modules[row].program.rule_facts.len() {
            if graph.modules[row].program.rule_facts[index].marker.name != MARKER_CONTEXT || graph.modules[row].program.rule_facts[index].target != (Val(span)) -> next
            return sema_marker_rules_check_rule_signature(graph.modules[row].program.rule_facts[index].marker, environment, program, scopes, state, tail_store, context, diagnostics)
        }
    }
    true
}

// Rust `resolve_static_rule_products`: a marker at a static-product site (the
// file, a type, a constant, a field, a variant, a test) binds its signature in
// the module's own scope, where its arguments can name only module items. A
// test's written name, `faults:` and `expected_fail:` are its `#Test` marker's
// arguments.
sema_marker_rules_check_static_sites: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) {
    if program.registration_graph == .Val(graph) {
        if graph.marker_catalog == None -> return
        context := sema_check_context_init()
        state := sema_ownership_state_init()
        tail_store := sema_statement_tail_store_init()
        loop index in 0..<graph.modules[module_index].program.rule_facts.len() {
            if graph.modules[module_index].program.rule_facts[index].site != (Val(RuleSite.File)) -> next
            _ := sema_marker_rules_check_rule_signature(graph.modules[module_index].program.rule_facts[index].marker, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        loop item_index in 0..<graph.modules[module_index].program.items.len() {
            sema_marker_rules_check_static_item(graph.modules[module_index].program.items[item_index], environment, program, scopes, state, tail_store, context, diagnostics)
        }
    }
}

sema_marker_rules_check_static_item: fn(item: Item, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) {
    if item == {
        .Struct(definition) -> {
            _ := sema_marker_rules_check_rule_signatures(definition.type_markers, environment, program, scopes, state, tail_store, context, diagnostics)
            _ := sema_marker_rules_check_rule_signatures(definition.serde_markers, environment, program, scopes, state, tail_store, context, diagnostics)
            loop field in definition.fields {
                _ := sema_marker_rules_check_rule_signatures(field.serde_markers, environment, program, scopes, state, tail_store, context, diagnostics)
            }
        }
        .Enum(definition) -> {
            _ := sema_marker_rules_check_rule_signatures(definition.type_markers, environment, program, scopes, state, tail_store, context, diagnostics)
            _ := sema_marker_rules_check_rule_signatures(definition.serde_markers, environment, program, scopes, state, tail_store, context, diagnostics)
            loop variant in definition.variants {
                _ := sema_marker_rules_check_rule_signatures(variant.serde_markers, environment, program, scopes, state, tail_store, context, diagnostics)
            }
        }
        .Distinct(definition) -> {
            _ := sema_marker_rules_check_rule_signatures(definition.type_markers, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        .Const(definition) -> {
            _ := sema_marker_rules_check_rule_signatures(definition.markers, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        .Test(test) -> {
            args := [MarkerCallArg]{}
            labels := [CallLabel?]{}
            if test.name_expr == .Val(expression) {
                args.push(MarkerCallArg.Expr{value: expression})
                labels.push(None)
            }
            if test.faults_expr == .Val(expression) {
                args.push(MarkerCallArg.Expr{value: expression})
                labels.push(Val(CallLabel{name: "faults", span: expr_span(expression)}))
            }
            if test.expected_fail_expr == .Val(expression) {
                args.push(MarkerCallArg.Expr{value: expression})
                labels.push(Val(CallLabel{name: "expected_fail", span: expr_span(expression)}))
            }
            if args.len() == 0 -> return
            marker: Marker{name: "Test", negated: false, name_span: test.span, args: args, arg_labels: labels, span: test.span, ct: None}
            _ := sema_marker_rules_check_rule_signature(marker, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        .Func(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .UserDerive(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
}

// Rust `check_binding` → `check_meta_attr` → `check_meta_attr_fields`: a local
// binding's `#Meta(...)` repeats a field (E0346) or has an empty (E0348) or not
// plain (E0347) category. It runs once the arguments bind to the signature.
// Rust then rewrites a constant category to its value; here only a written
// literal decides: a non-literal category that may name a comptime constant is
// left alone, and only an interpolated string is certainly not plain text.
sema_marker_rules_check_local_meta: fn(marker: Marker, diagnostics: &[Diagnostic]) {
    seen := [String:Bool]{}
    loop index in 0..<marker.args.len() {
        expression: sema_marker_rules_marker_expression(marker, index) ?? next
        value_span: expr_span(expression)
        name := ""
        field_span := value_span
        if index < marker.arg_labels.len() && marker.arg_labels[index] == .Val(label) {
            name = label.name
            field_span = Span{start: label.span.start, end: value_span.end}
        } else if expression == .Ident(word, _, _) && word == "tunable" {
            name = word
        }
        if name != "category" && name != "tunable" && name != "maturity" -> next
        if name == "tunable" && expression == .Bool(flag, _, _) && !flag -> next
        category: if name == "category" -> sema_marker_rules_meta_literal_text(expression) else -> None
        sema_marker_rules_note_meta_field(name, expression, field_span, category, expression == .Str(_, _, _), seen, diagnostics)
    }
}

// The text of a plain quoted literal (`""` included), or None.
sema_marker_rules_meta_literal_text: fn(expression: Expr) -> String? Never! {
    if expression == .Str(parts, _, _) {
        if parts.len() == 0 -> return Val("")
        if parts.len() == 1 && parts[0] == .Lit(text) -> return Val(text)
    }
    None
}

// Rust `check_meta_attr_fields` for one field: a repeat is E0346; a category
// is E0348 when its text is empty and E0347 when `plain_required` and it has
// no plain text.
sema_marker_rules_note_meta_field: fn(name: String, expression: Expr, field_span: Span, category: String?, plain_required: Bool, seen: &[String:Bool], diagnostics: &[Diagnostic]) {
    if seen.get(name) != None {
        if name == {
            "category" -> diagnostics.push(sema_error("E0346", field_span, "`#Meta` repeats `category`", "`category` has one value; writing it twice would make tooling choose between two labels", "keep one `category: \"...\"` field"))
            "tunable" -> diagnostics.push(sema_error("E0346", field_span, "`#Meta` repeats `tunable`", "`tunable` is a flag; writing it twice does not add meaning", "keep one `tunable` field"))
            "maturity" -> diagnostics.push(sema_error("E0346", field_span, "`#Meta` repeats `maturity`", "a declaration has one maturity value", "keep one `maturity: .Experimental`, `.Tested`, or `.Hardened` field"))
            else -> {}
        }
    }
    seen[name] = true
    if name != "category" -> return
    value_span: expr_span(expression)
    if category == .Val(text) {
        if text.len() == 0 -> diagnostics.push(sema_error("E0348", value_span, "`#Meta` category cannot be empty", "Canvas groups use this text as a visible label", "write a non-empty category, e.g. `category: \"Movement\"`"))
        return
    }
    if !plain_required -> return
    why: if expression == .Str(_, _, _) -> "`category` is compile-time tooling data, not a runtime string" else -> "`category` is compile-time tooling data, not a runtime value"
    diagnostics.push(sema_error("E0347", value_span, "`#Meta` category needs plain quoted text", why, "write a string literal, e.g. `category: \"Movement\"`"))
}

sema_marker_rules_declared_signature: fn(rule: SemaScopeMembersMarkerRule) -> (signature: TAppliedRuleSignature, expected_types: [Type?], variadic_expected_type: Type?) Never! {
    params := [TAppliedRuleParameter]{}
    expected_types := [Type?]{}
    variadic := TAppliedRuleArgKind?{None}
    variadic_source_type := String?{None}
    variadic_expected_type := Type?{None}
    loop parameter in rule.params {
        if parameter.name.starts_with("$") {
            next
        }
        ty := parameter.ty ?? Type.Named{name: "Value"}
        source_type := sema_marker_rules_type_name_for_parameter(parameter) ?? "Value"
        kind := sema_marker_rules_parameter_kind(parameter)
        default_source := if parameter.value != None -> Val("…") else -> None
        if parameter.variadic {
            variadic = Val(kind)
            variadic_source_type = Val(source_type)
            variadic_expected_type = parameter.ty
            next
        }
        params.push(TAppliedRuleParameter{name: parameter.name, kind: kind, source_type: source_type, default_source: default_source})
        expected_types.push(parameter.ty)
    }
    (expected_types: expected_types, signature: TAppliedRuleSignature{params: params, variadic: variadic, variadic_source_type: variadic_source_type}, variadic_expected_type: variadic_expected_type)
}

sema_marker_rules_declared_site_error: fn(marker: Marker, rule: SemaScopeMembersMarkerRule) -> Diagnostic {
    sites := (loop site in rule.sites -> ".{site}")
    allowed := if sites.len() == 0 -> "no sites" else -> sites.join(", ")
    sema_error("E0355", marker.name_span, "`#{marker.name}` cannot attach at this site", "the declared rule allows only these sites: {allowed}", "remove the marker or move it to one of its declared sites")
}

sema_marker_rules_applied_site_error: fn(marker: Marker, rule: TAppliedRule, site: RuleSite) -> Diagnostic {
    legal := (loop allowed_site in rule.sites -> "`{allowed_site}`")
    if rule.companion_site == .Val(companion) {
        legal.push("{companion.site} with companion `#{companion.rule}`")
    }
    allowed := if legal.len() == 0 -> "no active attachment sites" else -> legal.join(", ")
    fix := if rule.companion_site == None && rule.sites.len() == 1 && rule.sites[0] == "Constant" -> "write `#{marker.name} NAME: comptime {{ value }}` — a storage marker precedes a module constant" else -> "move `#{marker.name}` to one of its registered sites"
    sema_error("E0355", marker.span, "`#{marker.name}` cannot attach at the {sema_marker_rules_site_name(site)} site", "the registry allows `#{marker.name}` only at: {allowed}", fix)
}

sema_marker_rules_fact_allows: fn(rule: TAppliedRule, application: AppliedRuleApplication, facts: [AppliedRuleApplication]) -> Bool Never! {
    site: application.site ?? return true
    if rule.sites.contains(sema_marker_rules_site_name(site)) {
        return true
    }
    companion: rule.companion_site ?? return false
    if companion.site != sema_marker_rules_site_name(site) || application.target == None {
        return false
    }
    target: application.target ?? return false
    loop other in facts {
        if other.target == (Val(target)) && other.marker.name == companion.rule {
            return true
        }
    }
    false
}

// Identity of a marker's declaration: the module and declaration span of a
// declared rule (a marker with a declaration module matches only that module
// and span), else its name. Equal keys exactly when two markers name the same
// declaration, so dedupes probe a map instead of rescanning the list.
sema_marker_rules_declaration_key: fn(marker: Marker) -> String Never! {
    if marker.declaration_module == {
        .Val(owner_module) -> "m{owner_module.len()}:{owner_module}|{sema_marker_rules_span_key(marker.declaration_span)}"
        .None -> "n:{marker.name}"
    }
}

// Identity of a marker occurrence: its name span and its declaration.
sema_marker_rules_occurrence_key: fn(marker: Marker) -> String Never! {
    "{marker.name_span.start}:{marker.name_span.end}|{sema_marker_rules_declaration_key(marker)}"
}

sema_marker_rules_span_key: fn(span: Span?) -> String Never! {
    if span == {
        .Val(at) -> "{at.start}:{at.end}"
        .None -> "-"
    }
}

// Same occurrence on the same target.
sema_marker_rules_application_key: fn(application: AppliedRuleApplication) -> String Never! {
    "{sema_marker_rules_occurrence_key(application.marker)}|{sema_marker_rules_span_key(application.target)}"
}

sema_marker_rules_attach: fn(markers: [Marker], target: Span, site: RuleSite, applications: &[AppliedRuleApplication]) Never! {
    loop marker in markers -> applications.push(AppliedRuleApplication{marker: marker, target: Val(target), site: Val(site)})
}

sema_marker_rules_function_applications: fn(function: Func, site: RuleSite, applications: &[AppliedRuleApplication]) Never! {
    sema_marker_rules_attach(function.markers, function.name_span, site, applications)
}

// An impl's markers that are rule applications: the parser owns
// `#Target(OS.…)` on an impl as its OS gate.
sema_marker_rules_impl_markers: fn(markers: [Marker], os_target: String?) -> [Marker] Never! {
    kept := [Marker]{}
    loop marker in markers {
        if marker.name == MARKER_TARGET && os_target != None -> next
        kept.push(marker.copy())
    }
    kept
}

// The parser owns `#FX` on a module, a struct, an enum or a trait as its
// effect cap, so it is no rule application there.
sema_marker_rules_without_cap: fn(markers: [Marker]) -> [Marker] Never! {
    kept := [Marker]{}
    loop marker in markers {
        if marker.name != MARKER_FX -> kept.push(marker.copy())
    }
    kept
}

sema_marker_rules_item_applications: fn(item: Item, applications: &[AppliedRuleApplication]) Never! {
    if item == {
        .Func(function) -> sema_marker_rules_function_applications(function, RuleSite.Function, applications)
        .Struct(definition) -> {
            sema_marker_rules_attach(sema_marker_rules_without_cap(definition.type_markers), definition.name_span, RuleSite.Type, applications)
            loop field in definition.fields -> sema_marker_rules_attach(field.serde_markers, field.name_span, RuleSite.Field, applications)
            loop method in definition.methods -> sema_marker_rules_function_applications(method, RuleSite.Method, applications)
            loop implementation in definition.trait_impls {
                sema_marker_rules_attach(sema_marker_rules_impl_markers(implementation.markers, implementation.os_target), implementation.trait_span, RuleSite.Impl, applications)
                loop method in implementation.methods -> sema_marker_rules_function_applications(method, RuleSite.Method, applications)
            }
        }
        .Enum(definition) -> {
            sema_marker_rules_attach(sema_marker_rules_without_cap(definition.type_markers), definition.name_span, RuleSite.Type, applications)
            loop variant in definition.variants -> sema_marker_rules_attach(variant.serde_markers, variant.name_span, RuleSite.Variant, applications)
            loop method in definition.methods -> sema_marker_rules_function_applications(method, RuleSite.Method, applications)
            loop implementation in definition.trait_impls {
                sema_marker_rules_attach(sema_marker_rules_impl_markers(implementation.markers, implementation.os_target), implementation.trait_span, RuleSite.Impl, applications)
                loop method in implementation.methods -> sema_marker_rules_function_applications(method, RuleSite.Method, applications)
            }
        }
        .Distinct(definition) -> sema_marker_rules_attach(definition.type_markers, definition.name_span, RuleSite.Type, applications)
        .Impl(implementation) -> {
            sema_marker_rules_attach(sema_marker_rules_impl_markers(implementation.markers, implementation.os_target), implementation.type_span, RuleSite.Impl, applications)
            loop method in implementation.methods -> sema_marker_rules_function_applications(method, RuleSite.Method, applications)
        }
        .Trait(definition) -> {
            sema_marker_rules_attach(sema_marker_rules_without_cap(definition.markers), definition.name_span, RuleSite.Trait, applications)
            loop method in definition.methods -> sema_marker_rules_attach(method.markers, method.name_span, RuleSite.Method, applications)
        }
        .Module(declaration) -> sema_marker_rules_attach(declaration.markers, declaration.name_span, RuleSite.Module, applications)
        .CodeModule(code_module) -> {
            sema_marker_rules_attach(sema_marker_rules_without_cap(code_module.markers), code_module.name_span, RuleSite.Module, applications)
            if code_module.body == .Val(body) {
                loop nested in body -> sema_marker_rules_item_applications(nested, applications)
            }
        }
        .TypeAlias(_) | .UnitFamily(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .UserDerive(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
}

sema_marker_rules_applications: fn(program: Program) -> [AppliedRuleApplication] Never! {
    applications := program.rule_facts
    recorded := [String:Bool]{}
    loop fact in program.rule_facts -> recorded[sema_marker_rules_application_key(fact)] = true
    collected := [AppliedRuleApplication]{}
    loop item in program.items -> sema_marker_rules_item_applications(item, collected)
    loop application in collected {
        if recorded.get(sema_marker_rules_application_key(application)) == None -> applications.push(application)
    }
    if program.applied_rules.len() == 0 -> return applications
    present := [String:Bool]{}
    loop application in applications -> present[sema_marker_rules_application_key(application)] = true
    loop application in program.applied_rules {
        key: sema_marker_rules_application_key(application)
        if present.get(key) != None -> next
        present[key] = true
        applications.push(application.copy())
    }
    applications
}

// Marker name and name span -> the first of `applications` there.
sema_marker_rules_application_rows: fn(applications: [AppliedRuleApplication]) -> [String:Int] Never! {
    rows := [String:Int]{}
    loop (index, application) in applications {
        key: "{application.marker.name_span.start}:{application.marker.name_span.end}|{application.marker.name}"
        if rows.get(key) == None -> rows[key] = index
    }
    rows
}

sema_marker_rules_is_guest_marker: fn(marker: Marker, site: RuleSite?) -> Bool Never! {
    if marker.negated {
        return false
    }
    if site == (Val(RuleSite.Function)) && (marker.name == "Import" || marker.name == "Export") {
        return sema_marker_c_argument(marker) || sema_marker_is_wasm_export(marker)
    }
    if site == (Val(RuleSite.Module)) && marker.name == "Import" && marker.args.len() == 0 {
        return true
    }
    false
}

// Whether a function marker is the ratified `#Export(c)` spelling (Rust
// `Sema::Guest::is_guest_export_marker`).
sema_marker_is_guest_export: fn(marker: Marker) -> Bool Never! {
    !marker.negated && marker.name == "Export" && sema_marker_c_argument(marker)
}

// `#Export(wasm)` is the JS-to-Wasm bridge entry, parsed as
// `function.web_marker` (WebPartition.jet checks it).
sema_marker_is_wasm_export: fn(marker: Marker) -> Bool Never! {
    if marker.negated || marker.name != "Export" || marker.args.len() != 1 -> return false
    if marker.args[0] == .Expr(value) {
        if value == .Ident(name, _, _) -> return name == "wasm"
    }
    false
}

sema_marker_c_argument: fn(marker: Marker) -> Bool Never! {
    if marker.args.len() == 0 {
        return false
    }
    argument: marker.args[0]
    if argument == .Expr(value) {
        if value == .Ident(name, _, _) {
            return name == "c"
        }
    }
    false
}

sema_marker_rules_edit_distance: fn(left: String, right: String) -> Int Never! {
    a := left.bytes()
    b := right.bytes()
    previous := [Int]{0}
    loop index in 0..<b.len() {
        previous.push(index + 1)
    }
    i := 0
    loop i < a.len() {
        current := [Int]{i + 1}
        j := 0
        loop j < b.len() {
            cost := if a[i] == b[j] -> 0 else -> 1
            deletion := previous[j + 1] + 1
            insertion := current[j] + 1
            substitution := previous[j] + cost
            distance := deletion
            if insertion < distance {
                distance = insertion
            }
            if substitution < distance {
                distance = substitution
            }
            current.push(distance)
            j += 1
        }
        previous = current
        i += 1
    }
    previous[b.len()]
}

sema_marker_rules_unknown_error: fn(registry: SemaScopeMembersMarkerRegistry, marker: Marker) -> Diagnostic {
    names := [String]{}
    loop rule in registry.applied_rules {
        sema_marker_rules_append_name(names, rule.name)
    }
    loop name in registry.marker_rules {
        sema_marker_rules_append_name(names, name.name)
    }
    loop name in registry.derive_provider_names {
        sema_marker_rules_append_name(names, name)
    }
    nearest := ""
    nearest_distance := 3
    ambiguous := false
    loop candidate in names {
        distance := sema_marker_rules_edit_distance(marker.name, candidate)
        if distance == 0 || distance > 2 {
            next
        }
        if {
            distance < nearest_distance -> {
                nearest = candidate
                nearest_distance = distance
                ambiguous = false
            }
            distance == nearest_distance && nearest != candidate -> {
                ambiguous = true
            }
        }
    }
    fix := if nearest != "" && !ambiguous -> "did you mean `#{nearest}`?" else -> "check the spelling, or see Docs/spec/syntax-decisions.md for the full applied-rule list."
    diagnostic := sema_error("E0927", marker.name_span, "`#{marker.name}` isn't a known applied rule", "`{marker.name}` isn't registered as an applied rule — Jet rules are a closed, registered vocabulary (I7), not any PascalCase word.", fix)
    if nearest != "" && !ambiguous -> diagnostic_with_edit(diagnostic, TextEdit{span: marker.name_span, new_text: nearest}) else -> diagnostic
}

// The one repeated-rule diagnostic, named for the target it
// repeats on (Rust `marker_repeated_error`'s noun).
sema_marker_rules_repeated_error: fn(marker: Marker, first: Marker, site: RuleSite?) -> Diagnostic {
    noun := "target"
    if site == .Val(value) {
        noun = if value == RuleSite.Function || value == RuleSite.Method -> "function" else -> sema_marker_rules_site_name(value).lower()
    }
    diagnostic := sema_error("E0999", marker.span, "`#{marker.name}` is already applied to this {noun}", "`#{marker.name}` is not a repeatable rule, so the second copy adds nothing and can only disagree with the first", "remove the repeated marker")
    diagnostic.detail = Val("second application span: the copy this report points at\nfirst application span: the earlier copy on the same target")
    diagnostic_with_label(diagnostic, first.span, "first application span")
}

sema_marker_rules_collect_function: fn(function: Func, markers: &[Marker]) Never! {
    loop marker in function.markers {
        markers.push(marker.copy())
    }
}

sema_marker_rules_collect_item: fn(item: Item, markers: &[Marker]) Never! {
    if item == .Struct(definition) {
        loop marker in definition.type_markers {
            markers.push(marker.copy())
        }
        loop field in definition.fields {
            loop marker in field.serde_markers {
                markers.push(marker.copy())
            }
        }
        loop function in definition.methods {
            sema_marker_rules_collect_function(function, markers)
        }
        loop implementation in definition.trait_impls {
            loop function in implementation.methods {
                sema_marker_rules_collect_function(function, markers)
            }
        }
        return
    }
    if item == .Enum(definition) {
        loop marker in definition.type_markers {
            markers.push(marker.copy())
        }
        loop variant in definition.variants {
            loop marker in variant.serde_markers {
                markers.push(marker.copy())
            }
        }
        loop function in definition.methods {
            sema_marker_rules_collect_function(function, markers)
        }
        loop implementation in definition.trait_impls {
            loop function in implementation.methods {
                sema_marker_rules_collect_function(function, markers)
            }
        }
        return
    }
    if item == .Distinct(definition) {
        loop marker in definition.type_markers {
            markers.push(marker.copy())
        }
        return
    }
    if item == .Func(function) {
        sema_marker_rules_collect_function(function, markers)
        return
    }
    if item == .Impl(implementation) {
        loop function in implementation.methods {
            sema_marker_rules_collect_function(function, markers)
        }
        return
    }
    if item == .CodeModule(code_module) {
        if code_module.body != None {
            body: code_module.body ?? return
            loop nested in body {
                sema_marker_rules_collect_item(nested, markers)
            }
        }
    }
}

sema_marker_rules_collect_program: fn(program: Program) -> [Marker] Never! {
    markers := [Marker]{}
    loop item in program.items {
        sema_marker_rules_collect_item(item, markers)
    }
    present := [String:Bool]{}
    loop existing in markers -> present[sema_marker_rules_occurrence_key(existing)] = true
    loop application in sema_marker_rules_applications(program) {
        if application.target == None {
            next
        }
        key: sema_marker_rules_occurrence_key(application.marker)
        if present.get(key) == None {
            present[key] = true
            markers.push(application.marker)
        }
    }
    markers
}

sema_marker_rules_marker_is_known: fn(registry: SemaScopeMembersMarkerRegistry, marker: Marker) -> Bool Never! {
    if sema_marker_rules_user_rule_index(registry, marker) != None || (marker.declaration_module == None && sema_scope_members_has_name(registry.known_marker_names, marker.name)) {
        return true
    }
    false
}

sema_marker_rules_validate_vocabulary: fn(registry: SemaScopeMembersMarkerRegistry, program: Program, markers: [Marker], diagnostics: &[Diagnostic]) {
    seen := [String:Bool]{}
    applications: sema_marker_rules_applications(program)
    application_rows: sema_marker_rules_application_rows(applications)
    loop marker in markers {
        occurrence: sema_marker_rules_occurrence_key(marker)
        if seen.get(occurrence) != None {
            next
        }
        seen[occurrence] = true
        application_row: application_rows.get("{marker.name_span.start}:{marker.name_span.end}|{marker.name}") ?? -1
        site := if application_row >= 0 -> applications[application_row].site else -> None
        if sema_marker_rules_is_guest_marker(marker, site) {
            next
        }
        if sema_marker_rules_builtin_index(registry, marker) == None && !sema_marker_rules_marker_is_known(registry, marker) {
            diagnostics.push(sema_marker_rules_unknown_error(registry, marker))
        }
    }
}

sema_marker_rules_validate_allow: fn(program: Program, diagnostics: &[Diagnostic]) {
    applications: sema_marker_rules_applications(program)
    loop application in applications -> sema_marker_rules_allow_checks(application.marker, diagnostics)
}

// An `#Allow(jet.LintName, "why")` records its reason, and the reason check
// cannot allow itself.
sema_marker_rules_allow_checks: fn(marker: Marker, diagnostics: &[Diagnostic]) {
    if marker.name != MARKER_ALLOW -> return
    if marker.args.len() < 2 {
        diagnostics.push(diagnostic_from_registry("L3103", Val(marker.span), "This `#Allow` has no reason.", "Every lint allowance records why the selected lint does not apply at this site.", "Add the reason slot: `#Allow(jet.LintName, \"why this lint does not apply\")`."))
    }
    loop argument in marker.args {
        if argument == .Expr(expr) {
            if expr == .Field(base, member, span, _) {
                if base == .Ident(package, package_span, _) {
                    if package == "jet" && member == "AllowReason" -> diagnostics.push(sema_error("E0355", Span{start: package_span.start, end: span.end}, "`#Allow` cannot suppress `jet.AllowReason`", "the reason check audits the lint allowance itself and cannot be disabled by that allowance", "write the reason slot: `#Allow(jet.LintName, \"why this lint does not apply\")`"))
                }
            }
        }
    }
}

sema_marker_rules_validate_sites: fn(registry: SemaScopeMembersMarkerRegistry, program: Program, diagnostics: &[Diagnostic]) {
    sema_marker_rules_validate_allow(program, diagnostics)
    applications: sema_marker_rules_applications(program)
    loop application in applications {
        sema_marker_rules_allow_checks(application.marker, diagnostics)
        site: application.site ?? next
        builtin_index := sema_marker_rules_builtin_index(registry, application.marker)
        if builtin_index != None {
            rule := registry.applied_rules[builtin_index ?? 0]
            if !sema_marker_rules_fact_allows(rule, application, applications) {
                diagnostics.push(sema_marker_rules_applied_site_error(application.marker, rule, site))
            }
            next
        }
        diagnostic: sema_marker_rules_user_site_error(registry, application, site) ?? next
        diagnostics.push(diagnostic)
    }
}

// A source-declared marker rule names its legal sites (`sites: [.Type]`).
sema_marker_rules_user_site_error: fn(registry: SemaScopeMembersMarkerRegistry, application: AppliedRuleApplication, site: RuleSite) -> Diagnostic? {
    user_index: sema_marker_rules_user_rule_index(registry, application.marker) ?? return None
    if registry.marker_rules[user_index].sites.contains(sema_marker_rules_site_name(site)) -> return None
    Val(sema_marker_rules_declared_site_error(application.marker, registry.marker_rules[user_index]))
}

// The argument and site checks of every source-declared marker applied in
// `program`.
sema_marker_rules_validate_user_sites: fn(registry: SemaScopeMembersMarkerRegistry, program: Program, diagnostics: &[Diagnostic]) {
    loop application in sema_marker_rules_applications(program) {
        if sema_marker_rules_builtin_index(registry, application.marker) != None -> next
        if sema_marker_rules_user_argument_error(registry, application.marker) == .Val(error) -> diagnostics.push(error)
        site: application.site ?? next
        diagnostic: sema_marker_rules_user_site_error(registry, application, site) ?? next
        diagnostics.push(diagnostic)
    }
}

// A source-declared rule's arguments bind its declared signature (E0930). A
// literal argument fails only when its own type contradicts the parameter's
// declared type; names and calls stay open for ordinary inference.
sema_marker_rules_user_argument_error: fn(registry: SemaScopeMembersMarkerRegistry, marker: Marker) -> Diagnostic? {
    user_index: sema_marker_rules_user_rule_index(registry, marker) ?? return None
    rule: registry.marker_rules[user_index]
    if rule.group -> return None
    declared: sema_marker_rules_declared_signature(rule)
    bindings: sema_marker_rules_marker_signature_bindings(marker, declared.signature) ?? return Val(sema_marker_rules_signature_error(marker, declared.signature, true))
    loop binding in bindings {
        argument: sema_marker_rules_marker_expression(marker, binding.source_index) ?? return Val(sema_marker_rules_signature_error(marker, declared.signature, true))
        expected := declared.variadic_expected_type.copy()
        if binding.parameter_index == .Val(index) {
            expected = if index < declared.expected_types.len() -> declared.expected_types[index] else -> None
        }
        actual: sema_marker_rules_literal_kind(argument) ?? next
        wanted: sema_marker_rules_declared_kind(expected) ?? next
        if actual != wanted -> return Val(sema_marker_rules_signature_error(marker, declared.signature, true))
    }
    None
}

sema_marker_rules_literal_kind: fn(argument: Expr) -> String? Never! {
    if argument == {
        .Str(_, _, _) -> return Val("String")
        .Int(_, _, _, _, _) -> return Val("Int")
        .Float(_, _, _, _, _) -> return Val("Float")
        .Bool(_, _, _) -> return Val("Bool")
        .Char(_, _, _) -> return Val("Char")
        .ListLit(_, _, _) -> return Val("List")
        .MapLit(_, _, _) -> return Val("Map")
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    None
}

sema_marker_rules_declared_kind: fn(ty: Type?) -> String? Never! {
    declared: ty ?? return None
    if declared == {
        .String -> return Val("String")
        .Int -> return Val("Int")
        .Float -> return Val("Float")
        .Bool -> return Val("Bool")
        .Char -> return Val("Char")
        .List(_) -> return Val("List")
        .Map(_, _, _) -> return Val("Map")
        .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> {}
    }
    None
}

sema_marker_rules_validate_repeatability: fn(registry: SemaScopeMembersMarkerRegistry, program: Program, diagnostics: &[Diagnostic]) {
    seen := [String:Marker]{}
    loop application in sema_marker_rules_applications(program) {
        builtin_index := sema_marker_rules_builtin_index(registry, application.marker)
        repeatable := false
        if builtin_index == {
            .Val(index) -> {
                rule := registry.applied_rules[index]
                repeatable = rule.repeatable
            }
            .None -> {
                user_index_option := sema_marker_rules_user_rule_index(registry, application.marker)
                if {
                    user_index_option != None -> {
                        user_index: user_index_option ?? next
                        repeatable = registry.marker_rules[user_index].repeatable
                    }
                    else -> {
                        next
                    }
                }
            }
        }
        if repeatable {
            next
        }
        // Same declaration on the same target. An application with no
        // target span, such as a marked block, has no identity to repeat on.
        if application.target == None -> next
        key: "{sema_marker_rules_declaration_key(application.marker)}|{sema_marker_rules_span_key(application.target)}"
        if seen.get(key) == .Val(first) {
            diagnostics.push(sema_marker_rules_repeated_error(application.marker, first, application.site))
            next
        }
        seen[key] = application.marker
    }
}

sema_marker_rules_validate_arguments: fn(registry: SemaScopeMembersMarkerRegistry, source_program: Program, markers: [Marker], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, values: [SemaComptimeItemValue], result: &SemaMarkerRulesCheckResult) {
    seen := [String:Bool]{}
    loop marker in markers {
        occurrence: sema_marker_rules_occurrence_key(marker)
        if seen.get(occurrence) != None {
            next
        }
        seen[occurrence] = true
        builtin_index := sema_marker_rules_builtin_index(registry, marker)
        if builtin_index != None {
            rule := registry.applied_rules[builtin_index ?? 0]
            expected_types: (loop _ in rule.signature.params -> Type?{None})
            sema_marker_rules_validate_argument_signature(marker, rule.signature, expected_types, None, false, rule.owns_menu, registry, environment, program, scopes, state, tail_store, context, values, result.argument_facts, result.comptime_sources, result.comptime_requests, result.diagnostics)
        }
        user_index := sema_marker_rules_user_rule_index(registry, marker)
        if user_index != None {
            rule := registry.marker_rules[user_index ?? 0]
            signature: sema_marker_rules_declared_signature(rule)
            sema_marker_rules_validate_argument_signature(marker, signature.signature, signature.expected_types, signature.variadic_expected_type, true, false, registry, environment, program, scopes, state, tail_store, context, values, result.argument_facts, result.comptime_sources, result.comptime_requests, result.diagnostics)
        }
    }
}

sema_marker_rules_check: fn(registry: SemaScopeMembersMarkerRegistry, source_program: Program, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, values: [SemaComptimeItemValue]) -> SemaMarkerRulesCheckResult {
    result := SemaMarkerRulesCheckResult{
        diagnostics: [Diagnostic]{},
        argument_facts: [SemaMarkerRuleArgumentFact]{},
        comptime_sources: [SemaComptimeItemSource]{},
        comptime_requests: [SemaComptimeRequest]{},
    }
    markers := sema_marker_rules_collect_program(source_program)
    sema_marker_rules_validate_vocabulary(registry, source_program, markers, result.diagnostics)
    sema_marker_rules_validate_sites(registry, source_program, result.diagnostics)
    sema_marker_rules_validate_repeatability(registry, source_program, result.diagnostics)
    sema_marker_rules_validate_arguments(registry, source_program, markers, environment, program, scopes, state, tail_store, context, values, result)
    result
}

SemaMarkerRulesDeclaredTypeCheck: struct {
    resolved_type: Type?
    diagnostics: [Diagnostic]
    complete: Bool
}

sema_marker_rules_builtin_type: fn(name: String) -> Type? {
    if name == "Int" {
        return Val(Type.Int)
    }
    if name == "Float" {
        return Val(Type.Float)
    }
    if name == "Bool" {
        return Val(Type.Bool)
    }
    if name == "String" {
        return Val(Type.String)
    }
    if name == "Char" {
        return Val(Type.Char)
    }
    if name == "F32" {
        return Val(Type.Float32)
    }
    if name == "I8" {
        return Val(Type.IntN{signed: true, bits: 8})
    }
    if name == "I16" {
        return Val(Type.IntN{signed: true, bits: 16})
    }
    if name == "I32" {
        return Val(Type.IntN{signed: true, bits: 32})
    }
    if name == "I64" {
        return Val(Type.IntN{signed: true, bits: 64})
    }
    if name == "U8" {
        return Val(Type.IntN{signed: false, bits: 8})
    }
    if name == "U16" {
        return Val(Type.IntN{signed: false, bits: 16})
    }
    if name == "U32" {
        return Val(Type.IntN{signed: false, bits: 32})
    }
    if name == "U64" {
        return Val(Type.IntN{signed: false, bits: 64})
    }
    if name == "F64" {
        return Val(Type.Float)
    }
    if name == "Unit" || name == "Err" || name == "Never" {
        return Val(Type.Named{name: name})
    }
    None
}

// `#Inline(Always)` is a checked promise. A function that
// calls itself directly (E0917) or whose body has more statements than the
// ceiling (E0919) cannot be expanded in place, and a top-level function whose
// bare name is read as a value anywhere in the bundle (E0918) needs a real
// function to point at. Statements count transitively through nested blocks
// but not through a lambda body, which compiles to its own closure. Only
// direct self-recursion is checked, exactly as in the Rust checker.
SEMA_INLINE_ALWAYS_MAX_STMTS: 40

SemaInlineAlwaysScan: struct {
    target: String
    stmt_count: Int
    self_recursive: Bool
}

sema_inline_always_scan_body: fn(statements: [Stmt], scan: &SemaInlineAlwaysScan) {
    loop statement in statements -> sema_inline_always_scan_statement(statement, scan)
}

sema_inline_always_scan_args: fn(args: [CallArg], scan: &SemaInlineAlwaysScan) {
    loop arg in args -> sema_inline_always_scan_expr(arg.expr, scan)
}

sema_inline_always_scan_optional: fn(expression: Expr?, scan: &SemaInlineAlwaysScan) {
    if expression == .Val(value) -> sema_inline_always_scan_expr(value, scan)
}

sema_inline_always_scan_statement: fn(statement: Stmt, scan: &SemaInlineAlwaysScan) {
    scan.stmt_count += 1
    if statement == {
        .Expr(value) | .DeferClose(value, _) | .BreakValue(value, _) | .Yield(value, _) -> sema_inline_always_scan_expr(value, scan)
        .BreakLabelValue(_, _, value, _) -> sema_inline_always_scan_expr(value, scan)
        .Val(binding) -> sema_inline_always_scan_expr(binding.init, scan)
        .Assign(target, _, _, value) -> {
            if target == {
                .Local(_, _) -> {}
                .Index(base, index, _, _) -> {
                    sema_inline_always_scan_expr(base, scan)
                    sema_inline_always_scan_expr(index, scan)
                }
                .Field(base, _, _) -> sema_inline_always_scan_expr(base, scan)
            }
            sema_inline_always_scan_expr(value, scan)
        }
        .Return(value, _) -> sema_inline_always_scan_optional(value, scan)
        .While(cond, body, _, _, _) -> {
            sema_inline_always_scan_expr(cond, scan)
            sema_inline_always_scan_body(body, scan)
        }
        .For(_, _, _, kind, body, _, _, _, _) -> {
            if kind == {
                .Range(start, end, step, _) -> {
                    sema_inline_always_scan_expr(start, scan)
                    sema_inline_always_scan_expr(end, scan)
                    sema_inline_always_scan_optional(step, scan)
                }
                .In(collection, step) -> {
                    sema_inline_always_scan_expr(collection, scan)
                    sema_inline_always_scan_optional(step, scan)
                }
            }
            sema_inline_always_scan_body(body, scan)
        }
        .Switch(subject, arms, else_body, _) | .ComptimeSwitch(subject, arms, else_body, _) -> {
            sema_inline_always_scan_expr(subject, scan)
            loop arm in arms {
                sema_inline_always_scan_expr(arm.cond, scan)
                sema_inline_always_scan_body(arm.body, scan)
            }
            if else_body == .Val(body) -> sema_inline_always_scan_body(body, scan)
        }
        .Loop(body, _, _, _) | .Reactive(body, _) | .Shield(body, _) | .Live(body, _) -> sema_inline_always_scan_body(body, scan)
        .Switched(_, body, _) | .Policy(_, body, _) | .Region(_, _, body, _) | .Layout(_, _, body, _) -> sema_inline_always_scan_body(body, scan)
        .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .AssumeDet(_, _, body, _) -> sema_inline_always_scan_body(body, scan)
        .TaskGroup(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .Transact(_, _, body, _, _) -> sema_inline_always_scan_body(body, scan)
        .AuthorityScope(_, _, _, body, _) | .ScopeMember(_, _, _, _, body, _, _, _) -> sema_inline_always_scan_body(body, scan)
        .CountedLoop(init, cond, step, body, _, _, _) -> {
            sema_inline_always_scan_expr(init.init, scan)
            sema_inline_always_scan_expr(cond, scan)
            if step == .Val(inner) -> sema_inline_always_scan_statement(inner, scan)
            sema_inline_always_scan_body(body, scan)
        }
        .ComptimeIf(cond, _, then_body, else_body, _, _) -> {
            sema_inline_always_scan_expr(cond, scan)
            sema_inline_always_scan_body(then_body, scan)
            if else_body == .Val(body) -> sema_inline_always_scan_body(body, scan)
        }
        .ContextBlock(fields, body, _) -> {
            loop field in fields -> sema_inline_always_scan_expr(field.value, scan)
            sema_inline_always_scan_body(body, scan)
        }
        .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
    }
}

sema_inline_always_scan_expr: fn(expression: Expr, scan: &SemaInlineAlwaysScan) {
    if expression == {
        .Call(call, _) -> {
            if call.name == scan.target -> scan.self_recursive = true
            sema_inline_always_scan_args(call.args, scan)
        }
        .MethodCall(receiver, method, _, _, _, args, _) | .OptMethodCall(receiver, method, _, _, args, _, _) -> {
            if method == scan.target -> scan.self_recursive = true
            sema_inline_always_scan_expr(receiver, scan)
            sema_inline_always_scan_args(args, scan)
        }
        .CallValue(callee, args, _, _) -> {
            sema_inline_always_scan_expr(callee, scan)
            sema_inline_always_scan_args(args, scan)
        }
        .Str(parts, _, _) -> loop part in parts {
            if part == .Interp(value, _) -> sema_inline_always_scan_expr(value, scan)
        }
        .ListLit(elements, _, _) -> loop element in elements -> sema_inline_always_scan_expr(element, scan)
        .CompareChain(operands, _, _, _, _) -> loop operand in operands -> sema_inline_always_scan_expr(operand, scan)
        .MapLit(entries, _, _) -> loop entry in entries {
            sema_inline_always_scan_expr(entry.key, scan)
            sema_inline_always_scan_expr(entry.value, scan)
        }
        .MemberSpread(base, _, _, _) | .Spread(base, _, _) | .Deref(base, _, _) | .RawOf(base, _, _) | .Copy(base, _, _) -> sema_inline_always_scan_expr(base, scan)
        .Field(base, _, _, _) | .OptField(base, _, _, _, _, _) | .Tainted(base, _, _, _) | .Present(base, _, _) -> sema_inline_always_scan_expr(base, scan)
        .Ok(base, _, _) | .Err(base, _, _) | .Paren(base, _, _) | .Unary(_, base, _, _) | .Place(base, _, _, _) -> sema_inline_always_scan_expr(base, scan)
        .PatternTest(subject, _, _, _) -> sema_inline_always_scan_expr(subject, scan)
        .PtrFromAddr(_, _, _, addr, _, _) -> sema_inline_always_scan_expr(addr, scan)
        .Pipe(head, steps, _, _) -> {
            sema_inline_always_scan_expr(head, scan)
            loop step in steps -> sema_inline_always_scan_expr(step.value, scan)
        }
        .Index(base, index, _, _, _) -> {
            sema_inline_always_scan_expr(base, scan)
            sema_inline_always_scan_expr(index, scan)
        }
        .Slice(base, start, end, range, _, _) -> {
            sema_inline_always_scan_expr(base, scan)
            if range == {
                .Val(value) -> sema_inline_always_scan_expr(value, scan)
                .None -> {
                    sema_inline_always_scan_expr(start, scan)
                    sema_inline_always_scan_expr(end, scan)
                }
            }
        }
        .Range(start, end, _, _, _) | .Binary(_, start, end, _, _) -> {
            sema_inline_always_scan_expr(start, scan)
            sema_inline_always_scan_expr(end, scan)
        }
        .Try(value, _, _, context, _) -> {
            sema_inline_always_scan_expr(value, scan)
            sema_inline_always_scan_optional(context, scan)
        }
        .OrFallback(value, fallback, _, _, _) -> {
            sema_inline_always_scan_expr(value, scan)
            if fallback == {
                .Value(inner) -> sema_inline_always_scan_expr(inner, scan)
                .Block(body, inner, _) -> {
                    sema_inline_always_scan_body(body, scan)
                    sema_inline_always_scan_optional(inner, scan)
                }
                .Return(inner, _) -> sema_inline_always_scan_optional(inner, scan)
                .Panic(_, args) -> sema_inline_always_scan_args(args, scan)
                .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
            }
        }
        .If(cond, then_body, then_value, else_body, else_value, _, _) -> {
            sema_inline_always_scan_expr(cond, scan)
            sema_inline_always_scan_body(then_body, scan)
            sema_inline_always_scan_expr(then_value, scan)
            sema_inline_always_scan_body(else_body, scan)
            sema_inline_always_scan_expr(else_value, scan)
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> loop field in fields -> sema_inline_always_scan_expr(field.value, scan)
        .TupleLit(fields, _, _, _) -> loop field in fields -> sema_inline_always_scan_expr(field.value, scan)
        .EnumLit(_, _, _, args, _, _, _) -> loop arg in args {
            if arg == {
                .Positional(value) -> sema_inline_always_scan_expr(value, scan)
                .Named(_, value) -> sema_inline_always_scan_expr(value, scan)
            }
        }
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> loop field in fields -> sema_inline_always_scan_expr(field.value, scan)
                .Elements(elements) -> loop element in elements -> sema_inline_always_scan_expr(element, scan)
                .Entries(entries) -> loop entry in entries {
                    sema_inline_always_scan_expr(entry.key, scan)
                    sema_inline_always_scan_expr(entry.value, scan)
                }
                .Value(value) -> sema_inline_always_scan_expr(value, scan)
                .ByteText(_) | .Empty -> {}
            }
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .Ident(_, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .Lambda(_, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}

// The local half of the promise: direct self-recursion (E0917) and the size
// ceiling (E0919), both provable from the function alone.
sema_inline_always_check_function: fn(function: Func, diagnostics: &[Diagnostic]) Never! {
    if !function.is_inline_always -> return
    scan := SemaInlineAlwaysScan{target: function.name, stmt_count: 0, self_recursive: false}
    sema_inline_always_scan_body(function.body, scan)
    span: function.inline_span ?? function.name_span
    name: function.name
    if scan.self_recursive {
        diagnostics.push(sema_error("E0917", span, "`{name}` calls itself, so `#Inline(Always)` cannot expand it", "inlining a recursive call would either loop forever at compile time or require an artificial depth cutoff — neither is a real inline.", "drop `#Inline(Always)` (use `#Inline` as a hint), or restructure the function to be non-recursive."))
    }
    if scan.stmt_count > SEMA_INLINE_ALWAYS_MAX_STMTS {
        diagnostics.push(sema_error("E0919", span, "`{name}` is too large for `#Inline(Always)`", "its body has {scan.stmt_count} statements — over the {SEMA_INLINE_ALWAYS_MAX_STMTS}-statement ceiling `#Inline(Always)` enforces so a promised inline doesn't quietly bloat every call site.", "drop `#Inline(Always)` (use `#Inline` as a hint the compiler is free to ignore), or split the function so the hot part is small enough to inline."))
    }
}

// Every body of the bundle has been checked, so the function references
// read as values are complete for the whole-program E0918 half. Methods
// cannot be read as bare values, so E0918 applies to top-level functions.
sema_marker_rules_check_inline_always: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], diagnostics: &[Diagnostic]) -> Bool Never! {
    address_taken := [String:Bool]{}
    loop module_result in modules {
        loop reference in module_result.name_references {
            if reference.kind == "function" -> address_taken[reference.symbol.id.key] = true
        }
    }
    found := false
    loop source_module_index in 0..<graph.modules.len() {
        start: diagnostics.len()
        loop item_index in 0..<graph.modules[source_module_index].program.items.len() {
            if graph.modules[source_module_index].program.items[item_index] == .Func(function) {
                sema_inline_always_check_function(function, diagnostics)
                key: symbol_id(SymbolKind.Function, graph.modules[source_module_index].module_identity, "", function.name).key
                if function.is_inline_always && address_taken.get(key) != None {
                    name: function.name
                    diagnostics.push(sema_error("E0918", function.inline_span ?? function.name_span, "`{name}` cannot be inlined: its address is taken", "`#Inline(Always)` promises every call to `{name}` expands in place — but `{name}` is also used as a plain value somewhere (stored, returned, or passed as a callback), and a value needs a real function to point at.", "drop `#Inline(Always)`, or call `{name}` directly instead of through a value."))
                }
            }
        }
        loop nominal_index in 0..<graph.modules[source_module_index].nominals.len() {
            loop method_index in 0..<graph.modules[source_module_index].nominals[nominal_index].methods.len() -> sema_inline_always_check_function(graph.modules[source_module_index].nominals[nominal_index].methods[method_index].declaration, diagnostics)
        }
        loop implementation_index in 0..<graph.modules[source_module_index].impls.len() {
            loop method_index in 0..<graph.modules[source_module_index].impls[implementation_index].methods.len() -> sema_inline_always_check_function(graph.modules[source_module_index].impls[implementation_index].methods[method_index].declaration, diagnostics)
        }
        if diagnostics.len() > start -> found = true
        sema_attach_diagnostic_source_locations(diagnostics, start, graph.modules[source_module_index].source_segments)
    }
    found
}

// `#NoPrelude` turns the curated prelude names `print` and
// `input` off for its file (E0429) unless the file declares its own. The
// arguments are still checked; the call reports once and yields no value.
sema_marker_rules_no_prelude_call: fn(call: Call, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if call.name != "print" && call.name != "input" -> return false
    if !sema_module_no_prelude(environment, program) || !sema_call_gate_is_unshadowed(call.name, scopes) -> return false
    fix: if call.name == "print" -> "write `use io: core.term` and call `io.print(…)`, or remove `#NoPrelude`" else -> "write `use io: core.term` and read a line with `io.readline(…)`, or remove `#NoPrelude`"
    diagnostics.push(sema_marker_rules_no_prelude_error(call.name, call.name_span, fix))
    loop argument_index in 0..<call.args.len() -> _ := sema_check_expression(call.args[argument_index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
    true
}

// The bare `input` value under `#NoPrelude` (E0429), when the file declares
// no `input` of its own.
sema_marker_rules_no_prelude_input: fn(span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> Bool Never! {
    if !sema_module_no_prelude(environment, program) -> return false
    diagnostics.push(sema_marker_rules_no_prelude_error("input", span, "write `use io: core.term` and loop over `io.stdin().lines()`, or remove `#NoPrelude`"))
    true
}

sema_marker_rules_no_prelude_error: fn(name: String, span: Span, fix: String) -> Diagnostic Never! {
    sema_error("E0429", span, "`{name}` is not ambient here — this file opted out with `#NoPrelude`", "`#NoPrelude` disables the curated prelude auto-imports (`print` / `input`)", fix)
}

// (Rust `check_memoized_function`): the marker's result-cache
// contract is proven from the declared signature before lowering. A lazy
// `Iter`/`ViewIter` argument or result carries live computation state
// (E0940); every other argument must be hashable and not a list (E0939).
// The first refused parameter ends the check, as in the Rust reference.
// Purity (E0938) is judged by the solved effect row, not here.
sema_check_memoized_function: fn(func: Func, environment: SemaScopeEnvironment, program: SemaProgramTables, generic_params: [TGenericParam], diagnostics: &[Diagnostic]) {
    memo := Marker?{None}
    loop candidate in func.markers {
        if candidate.name == "Memo" {
            memo = Val(candidate)
            break
        }
    }
    if memo == None -> return
    marker: memo ?? panic("checked #Memo marker disappeared")
    loop parameter_index in 0..<func.params.len() {
        declared: if func.params[parameter_index].variadic -> Type.List{element: func.params[parameter_index].ty} else -> func.params[parameter_index].ty
        ty: sema_function_resolve_declared(environment, program, declared, environment.module_identity, generic_params)
        if sema_expression_zip_is_iter(ty) {
            diagnostics.push(sema_error("E0940", marker.span, "`#Memo` cannot cache lazy `Iter` values", "a lazy iterator carries live computation state instead of one completed result", "materialize the iterator before the memoized boundary"))
            return
        }
        if ty == .List(_) || !sema_type_hashable(environment, program, ty) {
            diagnostics.push(sema_error("E0939", marker.span, "`#Memo` parameter `{func.params[parameter_index].name}` is not hashable", "memoization keys are the function's argument tuple, so every argument must pass the existing hashability rule", "use an Int, Bool, Char, String, or named hashable value as the argument"))
            return
        }
    }
    declared_return: func.return_type ?? return
    if sema_expression_zip_is_iter(sema_function_resolve_declared(environment, program, declared_return, environment.module_identity, generic_params)) {
        diagnostics.push(sema_error("E0940", marker.span, "`#Memo` cannot cache a lazy `Iter` result", "a lazy iterator carries live computation state instead of one completed result", "materialize the iterator before returning from the memoized function"))
    }
}
