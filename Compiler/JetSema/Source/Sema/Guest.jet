// The sema-owned native guest boundary. Per-callable `#Import(c)` declarations
// and `#Export(c)` functions are the same C-shaped record in opposite
// directions; their signatures obey the C-safe type law before any body is
// checked, and every native symbol of the guest surface is unique.
use {
    jet_foundation.[
        AccessConvention,
        Diagnostic,
        Func,
        Marker,
        MarkerHook,
        Param,
        Span,
        TFailureCarrier,
        TFuncKind,
        Type,
        TypeTupleField,
        diagnostic_registry_row,
        ir_runtime_handle_row,
        runtime_c_export,
        runtime_only_read,
        type_name,
        ModuleID,
    ]
    jet_parser.[parser_guest_import_symbol]
}

// Rust `is_guest_import_marker`: the ratified `#Import(c)` spelling.
sema_marker_is_guest_import: fn(marker: Marker) -> Bool Never! {
    !marker.negated && sema_marker_is_hook(marker, MarkerHook.Import) && sema_marker_c_argument(marker)
}

// Rust `is_guest_import`: a function carrying the per-callable `#Import(c)`.
sema_function_is_guest_import: fn(function: Func) -> Bool Never! {
    loop marker in function.markers {
        if sema_marker_is_guest_import(marker) -> return true
    }
    false
}

// Rust `is_guest_export`: a function carrying `#Export(c)`.
sema_function_is_guest_export: fn(function: Func) -> Bool Never! {
    loop marker in function.markers {
        if sema_marker_is_guest_export(marker) -> return true
    }
    false
}

// Rust `guest_export_native_symbol`: the one native spelling of an exported
// C symbol, shared by sema, Library output and bindings.
sema_guest_export_native_symbol: fn(name: String) -> String Never! {
    bytes := [U8]{}
    loop byte in name.bytes() {
        n: Int{byte}
        if (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 95 {
            bytes.push(byte)
        } else {
            bytes.push(U8{95})
        }
    }
    symbol := String.from_bytes(bytes) ?? ""
    if symbol == "" || (Int{bytes[0]} >= 48 && Int{bytes[0]} <= 57) -> symbol = "_{symbol}"
    symbol
}

// Rust GuestScalar: the closed scalar projection of native Library artifacts.
SemaGuestScalar: enum {
    Int
    Float
    Bool
    Text
}

sema_guest_scalar: fn(ty: Type) -> SemaGuestScalar? Never! {
    if ty == {
        .Int -> Val(SemaGuestScalar.Int)
        .Float -> Val(SemaGuestScalar.Float)
        .Bool -> Val(SemaGuestScalar.Bool)
        .String -> Val(SemaGuestScalar.Text)
        .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// Rust `scalar_shape`: one scalar kind shared by every parameter and the return.
sema_guest_scalar_shape: fn(params: [Param], return_type: Type?) -> SemaGuestScalar? Never! {
    shape := SemaGuestScalar?{None}
    loop parameter in params {
        next_shape: sema_guest_scalar(parameter.ty) ?? return None
        if shape == .Val(existing) && existing != next_shape -> return None
        shape = Val(next_shape)
    }
    returned: return_type ?? return None
    next_shape: sema_guest_scalar(returned) ?? return None
    if shape == .Val(existing) && existing != next_shape -> return None
    Val(next_shape)
}

// Rust `export_boundary_return_type`: the success value an export publishes;
// Optional and `Never` carriers keep their written type.
sema_guest_export_return_type: fn(return_type: Type?) -> Type? Never! {
    written: return_type ?? return None
    if written == .Result(ok, _) -> return Val(ok)
    Val(written)
}

// The C result a signature publishes: `T Never!` is the infallible spelling of
// a plain `T`, and `Never!` alone publishes no result.
sema_guest_c_return_type: fn(return_type: Type?) -> Type? Never! {
    written: return_type ?? return None
    if written == .Result(ok, err) && err == (Type.Named{name: "Never"}) {
        if ok == (Type.Named{name: "Unit"}) -> return None
        return Val(ok)
    }
    Val(written)
}

// Rust `check_c_signature`: E3203 for a parameter or return without a stable
// C ABI, E3202 for a by-value pointer return. Registers nothing.
sema_guest_check_c_signature: fn(graph: SemaRegistrationGraph, module_index: Int, function: Func, diagnostics: &[Diagnostic]) -> Bool {
    module_identity: graph.modules[module_index].module_identity
    handles: [SemaCheckedForeignHandle]{}
    valid := true
    loop parameter_index in 0..<function.params.len() {
        if !sema_checked_foreign_type(graph, function.params[parameter_index].ty, module_identity, true, false, handles, [String]{}) {
            diagnostics.push(sema_checked_foreign_type_error(function.params[parameter_index].ty, function.params[parameter_index].ty_span, true))
            valid = false
        }
    }
    if sema_guest_c_return_type(function.return_type) == .Val(return_type) {
        return_span: function.return_type_span ?? function.name_span
        pointer_return: if return_type == {
            .Apply(name, _) -> name == "Ptr"
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        if {
            pointer_return -> {
                row: diagnostic_registry_row("E3202") ?? panic("E3202 has no registry row")
                diagnostics.push(sema_error("E3202", return_span, row.what.replace("{{ty}}", type_name(return_type)), row.why, row.fix))
                valid = false
            }
            !sema_checked_foreign_type(graph, return_type, module_identity, true, false, handles, [String]{}) -> {
                diagnostics.push(sema_checked_foreign_type_error(return_type, return_span, true))
                valid = false
            }
            else -> {}
        }
    }
    valid
}

// Rust `ExternFn::hidden_c_bridge_compatible` for a per-callable import: it is
// never generated and has no opaque handles, so it crosses the resident
// bridge only with Read/Write scalar or `String` values and such a return.
sema_guest_import_bridge_value: fn(ty: Type) -> Bool Never! {
    ty == Type.String || sema_checked_foreign_bridge_scalar_type(ty)
}

sema_guest_import_bridge_compatible: fn(function: Func) -> Bool Never! {
    if parser_guest_import_symbol(function) == None -> return false
    loop parameter_index in 0..<function.params.len() {
        if function.params[parameter_index].convention == {
            .Read | .Write -> {
                if !sema_guest_import_bridge_value(function.params[parameter_index].ty) -> return false
            }
            .Move -> return false
        }
    }
    if function.return_type == .Val(returned) -> sema_guest_import_bridge_value(returned) else -> true
}

// Rust `library_component_type_is_safe`: native Library rich values use the
// canonical byte carrier; named records and enums are admitted only when every
// nested payload has a closed, checked shape.
sema_guest_library_component_type: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, ty: Type, seen: &[String:Bool]) -> Bool {
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 -> true
        .List(inner) | .Option(inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Tagged(_, inner) -> sema_guest_library_component_type(graph, module_identity, inner, seen)
        .Result(ok, err) -> sema_guest_library_component_type(graph, module_identity, ok, seen) && sema_guest_library_component_type(graph, module_identity, err, seen)
        .Named(name) -> sema_guest_library_component_named(graph, module_identity, ty, name, seen)
        .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// The `Type::Named` arm: a registered struct, enum, distinct or alias whose
// every nested payload is itself a closed shape; a recursive name is not.
sema_guest_library_component_named: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, ty: Type, name: String, seen: &[String:Bool]) -> Bool {
    if seen.get(name) == .Val(seen_before) && seen_before -> return false
    row: sema_type_resolve_nominal_row(graph, ty, module_identity) ?? return false
    owner: graph.modules[row.module_index].module_identity
    seen[name] = true
    safe := false
    if graph.modules[row.module_index].nominals[row.row].source == .SourceAST(item) {
        if item == {
            .Struct(definition) -> {
                safe = true
                loop field in definition.fields {
                    if !sema_guest_library_component_type(graph, owner, field.ty, seen) {
                        safe = false
                        break
                    }
                }
            }
            .Enum(definition) -> {
                safe = true
                loop variant in definition.variants {
                    variant_safe: if variant.payload == {
                        .Unit -> true
                        .Single(payload, _) -> sema_guest_library_component_type(graph, owner, payload, seen)
                        .Named(fields) -> loop field in fields {
                            if !sema_guest_library_component_type(graph, owner, field.ty, seen) -> break false
                        } ?? true
                    }
                    if !variant_safe {
                        safe = false
                        break
                    }
                }
            }
            .Distinct(definition) -> safe = sema_guest_library_component_type(graph, owner, definition.base, seen)
            .TypeAlias(definition) -> safe = sema_guest_library_component_type(graph, owner, definition.target, seen)
            .Func(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    seen[name] = false
    safe
}

// Rust `library_component_signature_is_safe`.
sema_guest_library_component_signature: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, function: Func) -> Bool {
    return_type: function.return_type ?? return false
    seen := [String:Bool]{}
    if !sema_guest_library_component_type(graph, module_identity, return_type, seen) -> return false
    loop parameter_index in 0..<function.params.len() {
        if !sema_guest_library_component_type(graph, module_identity, function.params[parameter_index].ty, seen) -> return false
    }
    true
}

// Rust `record_guest_symbol`: one native symbol in the bundle-wide guest
// namespace (E1341 on a second owner).
sema_guest_record_symbol: fn(symbols: &[String:String], symbol: String, owner: String, kind: String, name: String, span: Span?, diagnostics: &[Diagnostic]) {
    description: "{kind} `{name}` in module `{owner}`"
    if symbols.get(symbol) == .Val(previous) {
        diagnostics.push(sema_error_optional("E1341", span, "{previous} and {description} use the same C symbol `{symbol}`", "the native guest call surface must map every imported, exported, and generated C symbol unambiguously before codegen", "rename one declaration or its native symbol string"))
    }
    symbols[symbol] = description
}

// A Jet runtime export (RUNTIME_C_EXPORTS) is the runtime's own internals,
// not a checked API: an `#Import(c)` that names one must be an audited
// `#Unsafe` declaration. Ordinary C symbols stay ungated.
sema_guest_runtime_import_error: fn(function: Func, symbol: String) -> Diagnostic Never! {
    sema_error("E3101", function.name_span, "`#Import(c)` of the Jet runtime symbol `{symbol}` can only sit inside `#Unsafe`.", "The runtime's C exports are its internals, not a checked API, so reaching one directly needs an audited region.", "Gate the declaration with `#[Import(c), Unsafe(\"why this is safe\")]`, or call the Core function that wraps it.")
}

// The package identity of the generated jet.runtime interface units
// (Driver RuntimeInterface.jet jet_driver_runtime_interface_sources): the
// compiler-generated Core root, which no user package can carry.
SEMA_GUEST_RUNTIME_INTERFACE_PACKAGE: "<corelib>/jet/runtime/"

// The package identity prefixes (Driver Loader.jet jet_driver_package_identity)
// of the runtime (Compiler/JetRuntime/package.jet) and of its test units
// (Toolchain/RuntimePack.jet test_package).
SEMA_GUEST_RUNTIME_PACKAGES: [String]{"package:11:jet_runtime:", "package:17:jet_runtime_tests:"}

// The ABI of a runtime binding's foreign row: the runtime's route carriers
// (IR ir_runtime_binding_call), not the C law.
SEMA_GUEST_RUNTIME_ABI: "jet-runtime"

// A runtime binding (#6615): a body-less `#Import(c)` member of a jet.runtime
// interface module, the checked API over one runtime export. It is one either
// in a generated interface unit, or as the runtime's own declaration of it:
// an inline-module member of the runtime package naming a runtime export
// (Compiler/JetRuntime/Source/Public), from which the interface is rendered.
// A user module of any name, `jet.runtime.*` included, is neither.
sema_guest_runtime_binding: fn(package_identity: String, function: Func) -> Bool Never! {
    symbol: parser_guest_import_symbol(function) ?? return false
    if package_identity.starts_with(SEMA_GUEST_RUNTIME_INTERFACE_PACKAGE) -> return true
    if !runtime_c_export(symbol) || sema_inline_member_module(function.name) == "" -> return false
    loop prefix in SEMA_GUEST_RUNTIME_PACKAGES {
        if package_identity.starts_with(prefix) -> return true
    }
    false
}

// What runtime binding `function` reads when its export is run-time only
// (runtime_only_read), else None: a call of it is never computed while
// compiling, whatever row the binding declares.
sema_guest_runtime_only_read: fn(package_identity: String, function: Func) -> String? Never! {
    if !sema_guest_runtime_binding(package_identity, function) -> return None
    runtime_only_read(parser_guest_import_symbol(function) ?? return None)
}

// A value a runtime route carries: Int and the machine integers as a Word,
// Float, Bool as a Flag, String as Text, a Core type the runtime holds as a
// handle (sema_guest_runtime_handle), and a List of those.
sema_guest_runtime_scalar: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Bool | .IntN(_, _) -> true
        .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// A Core type with a runtime handle row (Authority, LogSpan, LogField): it
// crosses as the runtime's handle, a record the program lays out itself as a
// runtime record made for the call (IR ir_route_carrier_of).
sema_guest_runtime_handle: fn(ty: Type) -> Bool Never! {
    if ty == .Named(name) -> return ir_runtime_handle_row(name) != None
    false
}

sema_guest_runtime_value: fn(ty: Type) -> Bool Never! {
    if ty == {
        .String -> true
        .Named(_) -> sema_guest_runtime_handle(ty)
        .List(item) -> item == Type.String || sema_guest_runtime_scalar(item) || sema_guest_runtime_handle(item)
        .Int | .Float | .Bool | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> sema_guest_runtime_scalar(ty)
    }
}

// A tuple item a runtime route result carries: a carried value or an Option
// of one.
sema_guest_runtime_item: fn(ty: Type) -> Bool Never! {
    if ty == .Option(inner) -> return sema_guest_runtime_value(inner)
    sema_guest_runtime_value(ty)
}

sema_guest_runtime_tuple: fn(fields: [TypeTupleField]) -> Bool Never! {
    loop field in fields {
        if !sema_guest_runtime_item(field.ty) -> return false
    }
    true
}

// A runtime route result: a carried value, an Option of one or of a tuple, a
// tuple of carried values and Options of them (its items cross in the checked
// tuple's member order), or a fallible `T E!` whose success is a carried
// value, an Option of one or Unit. Its error is the default `Err`, which
// crosses as its message text, or a Core type the runtime holds as a handle
// (`EncodingCause`, `IOError`), which crosses as that handle.
sema_guest_runtime_result: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Option(inner) -> {
            if inner == .Tuple(fields) -> return sema_guest_runtime_tuple(fields)
            sema_guest_runtime_value(inner)
        }
        .Tuple(fields) -> sema_guest_runtime_tuple(fields)
        .Result(ok, err) -> (ok == Type.Named{name: "Unit"} || sema_guest_runtime_item(ok)) && (err == Type.Named{name: "Err"} || sema_guest_runtime_handle(err))
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> sema_guest_runtime_value(ty)
    }
}

// A parameter a runtime route carries: a read carried value, a read View of
// a scalar (its window crosses as a List), or a written (`&`) runtime handle
// or List of scalars, which the runtime changes in place. Nothing crosses
// moved.
sema_guest_runtime_param: fn(convention: AccessConvention, ty: Type) -> Bool Never! {
    if convention == {
        .Read -> {
            if ty == .Apply(name, args) -> return name == "View" && args.len() == 1 && sema_guest_runtime_scalar(args[0])
            sema_guest_runtime_value(ty)
        }
        .Write -> {
            if ty == .List(item) -> return sema_guest_runtime_scalar(item)
            sema_guest_runtime_handle(ty)
        }
        .Move -> false
    }
}

// E3203 for a runtime binding's parameter or result no runtime route carries;
// true when every one is carried.
sema_guest_check_runtime_binding: fn(function: Func, diagnostics: &[Diagnostic]) -> Bool Never! {
    valid := true
    why: "a jet.runtime function crosses the runtime's route carriers"
    fix: "use Int, a machine integer, Float, Bool, String, a Core type the runtime holds as a handle, or a List of those, a View of a scalar, or a written (`&`) handle or List of scalars; a result may also be an Option of one or of a tuple, a tuple of those and Options of them, or `T E!` with a carried, Option or Unit success and the default Err or a handle error"
    loop param in function.params {
        if !sema_guest_runtime_param(param.convention, param.ty) {
            diagnostics.push(sema_error("E3203", param.ty_span, "`{type_name(param.ty)}` is not a runtime carrier for the parameter `{param.name}` of `{function.name}`", why, fix))
            valid = false
        }
    }
    if sema_guest_c_return_type(function.return_type) == .Val(returned) {
        if !sema_guest_runtime_result(returned) {
            diagnostics.push(sema_error("E3203", function.return_type_span ?? function.name_span, "`{type_name(returned)}` is not a runtime carrier for the result of `{function.name}`", why, fix))
            valid = false
        }
    }
    valid
}

// Rust CheckInner `check_guest_import_surface` (every module but the seeded
// ones, checked when they were finalized), `check_guest_export_surface` (the
// entry module) and `check_guest_symbol_collisions` (the bundle, seeded
// modules' symbols included), after registration and before any body is
// checked.
sema_guest_check_surfaces: fn(graph: &SemaRegistrationGraph) {
    entry_index: sema_registration_module_index(graph, graph.entry_module_identity) ?? -1
    failed := false
    loop module_index in graph.seeded..<graph.modules.len() {
        diagnostics := [Diagnostic]{}
        loop item in graph.modules[module_index].program.items {
            if item == .Func(function) {
                if sema_guest_runtime_binding(graph.modules[module_index].package_identity, function) {
                    if !sema_guest_check_runtime_binding(function, diagnostics) -> failed = true
                    next
                }
                if parser_guest_import_symbol(function) == .Val(symbol) {
                    if runtime_c_export(symbol) && !function.is_unsafe {
                        diagnostics.push(sema_guest_runtime_import_error(function, symbol))
                        failed = true
                    }
                    if !sema_guest_check_c_signature(graph, module_index, function, diagnostics) {
                        failed = true
                    } else if !sema_guest_import_bridge_compatible(function) {
                        diagnostics.push(sema_error("E1341", function.name_span, "guest import `{function.name}` cannot use the resident hidden C bridge", "per-callable imports have no direct C-module wrapper fallback", "use a read-only scalar or String bridge signature"))
                        failed = true
                    }
                }
                if module_index == entry_index && sema_function_is_guest_export(function) {
                    if sema_guest_declared_carrier(function.return_type) == .Val(carrier) {
                        diagnostics.push(sema_guest_export_carrier_error(function, "declares the carrier `{carrier}`"))
                        failed = true
                    } else if !sema_guest_library_component_signature(graph, graph.modules[module_index].module_identity, function) {
                        if !sema_guest_check_c_signature(graph, module_index, function, diagnostics) -> failed = true
                    }
                }
            }
        }
        loop diagnostic in diagnostics -> sema_registration_push_graph_diagnostic(graph, module_index, diagnostic)
    }
    symbols := [String:String]{}
    has_text_export := false
    loop module_index in 0..<graph.modules.len() {
        diagnostics := [Diagnostic]{}
        owner: graph.modules[module_index].module_name
        loop item in graph.modules[module_index].program.items {
            if item == {
                .Func(function) -> {
                    // A runtime binding names the runtime's own export, not a
                    // second owner of its symbol.
                    if parser_guest_import_symbol(function) == .Val(symbol) && !sema_guest_runtime_binding(graph.modules[module_index].package_identity, function) -> sema_guest_record_symbol(symbols, symbol, owner, "guest imports", function.name, Val(function.name_span), diagnostics)
                    if module_index == entry_index && sema_function_is_guest_export(function) {
                        if sema_guest_scalar_shape(function.params, sema_guest_export_return_type(function.return_type)) == (Val(SemaGuestScalar.Text)) -> has_text_export = true
                        sema_guest_record_symbol(symbols, sema_guest_export_native_symbol(function.name), owner, "Library exports", function.name, Val(function.name_span), diagnostics)
                    }
                }
                .CModule(c_module) -> {
                    loop foreign in c_module.functions -> sema_guest_record_symbol(symbols, foreign.rust_path, owner, "C module imports", foreign.name, Val(foreign.name_span), diagnostics)
                }
                .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
            }
        }
        if diagnostics.len() > 0 -> failed = true
        loop diagnostic in diagnostics -> sema_registration_push_graph_diagnostic(graph, module_index, diagnostic)
    }
    if has_text_export {
        diagnostics := [Diagnostic]{}
        sema_guest_record_symbol(symbols, "jet_text_free", "<generated>", "generated C symbol", "jet_text_free", None, diagnostics)
        if diagnostics.len() > 0 -> failed = true
        loop diagnostic in diagnostics -> sema_registration_push_graph_diagnostic(graph, -1, diagnostic)
    }
    if failed -> graph.complete = false
}

// The failure carrier a written return declares (`T E!` with E not `Never`,
// or `T?`), spelled as written; None for a plain `T`, `T Never!` or no
// return.
sema_guest_declared_carrier: fn(return_type: Type?) -> String? Never! {
    written: return_type ?? return None
    if written == {
        .Result(ok, err) -> if err == (Type.Named{name: "Never"}) -> None else -> Val("{type_name(ok)} {type_name(err)}!")
        .Option(value) -> Val("{type_name(value)}?")
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// The carrier a C export inferred, spelled as its signature would write it.
sema_guest_carrier_text: fn(carrier: TFailureCarrier) -> String Never! {
    if carrier == {
        .Result(success, error) -> "{type_name(success)} {type_name(error)}!"
        .Optional(value) -> "{type_name(value)}?"
        .Diverges(value) -> type_name(value)
        .Infallible -> ""
    }
}

// E3203 at an export's name: a C export is infallible, so an `#Export(c)`
// that can fail (`reason`: the carrier it declares or infers) has no C
// return, whatever its parameters.
sema_guest_export_carrier_error: fn(function: Func, reason: String) -> Diagnostic Never! {
    what: "`#Export(c)` `{function.name}` {reason}, which is not a C-compatible return."
    why: "`#Import` / `#Export` functions must use types with a stable C ABI at the edge, and a C export is infallible: it returns no failure carrier."
    fix: "Handle every failure inside `{function.name}` and declare it `Never!`."
    sema_error("E3203", function.name_span, what, why, fix)
}

// The C-safe export law over inferred carriers, after the failure solve: an
// entry-module `#Export(c)` that declares no carrier must be infallible
// (E3203 at its name). A declared carrier, on a C signature or a library
// component signature alike, is already E3203 at the name
// (sema_guest_check_surfaces). True when an export was refused.
sema_guest_check_export_failures: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], diagnostics: &[Diagnostic]) -> Bool {
    entry_index: sema_registration_module_index(graph, graph.entry_module_identity) ?? return false
    if entry_index >= modules.len() -> return false
    refused := false
    loop item in graph.modules[entry_index].program.items {
        if item == .Func(function) {
            if !sema_function_is_guest_export(function) || sema_guest_declared_carrier(function.return_type) != None -> next
            loop body in modules[entry_index].functions {
                if body.kind != TFuncKind.TopLevel || body.name != function.name -> next
                if body.failure_carrier != TFailureCarrier.Infallible {
                    diagnostics.push(sema_diagnostic_with_source_location(sema_guest_export_carrier_error(function, "can fail: its body infers the carrier `{sema_guest_carrier_text(body.failure_carrier)}`"), graph.modules[entry_index].source_segments))
                    refused = true
                }
                break
            }
        }
    }
    refused
}
