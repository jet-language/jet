use jet_foundation.[Diagnostic, ProgramBundle, walk_imports]
use jet_syntax as Syntax

// Rust: crates/jet-sema/src/Sema/TargetSurface.rs:6
SOCKET_SURFACES :: ["core.net", "core.net.tls", "core.net.ws", "core.http", "core.http.client", "core.http.server", "core.email"]
// Rust: crates/jet-sema/src/Sema/TargetSurface.rs:16
WASIP2_UNSUPPORTED_SURFACES :: ["core.net.tls", "core.net.ws", "core.http.client", "core.email"]

// Rust: crates/jet-sema/src/Sema/TargetSurface.rs:25
fn check_target_surface(bundle: ProgramBundle, target: String) -> [Diagnostic] {
    socket_target :: socket_target_supported(target)
    web_target :: target == Syntax.BUILD_TARGET_WEB || bundle.web_partition_enforced
    plugin_reachable :: web_target && bundle.used_core.any(fn(usage) { usage == "core.plugin" || usage.starts_with("core.plugin::") })
    wasip2 :: target == Syntax.BUILD_TARGET_WASI_SERVER
    unsupported_surfaces :: if wasip2 -> wasip2_unsupported_surfaces(bundle) else -> [String:Bool]{}
    unsupported :: if wasip2 -> wasip2_unsupported_operations(bundle) else -> [String:Bool]{}
    if socket_target && unsupported.is_empty() && unsupported_surfaces.is_empty() && !plugin_reachable -> return []
    seen := [(String, Int, Int, String):Bool]{}
    diagnostics := [Diagnostic][]
    if plugin_reachable {
        anchored := false
        loop module in bundle.modules {
            loop (_, import) in walk_imports(module) {
                loop binding in import.walk_bindings() {
                    module_path :: binding.path()
                    if module_path != "core.plugin" && !module_path.starts_with("core.plugin.") -> next
                    anchored = true
                    span :: binding.items_span ?? binding.module_alias_span
                    key :: (module.display, span.start, span.end, "E3306")
                    if !seen.has_key(key) {
                        seen[key] = true
                        &diagnostics.push(Diagnostic.from_row("E3306", [("module", "core.plugin"), ("target", target)], Val(span)))
                    }
                }
            }
        }
        // Generated and re-exported uses still receive an unanchored verdict.
        if !anchored -> &diagnostics.push(Diagnostic.from_row("E3306", [("module", "core.plugin"), ("target", target)], None))
    }
    operations := unsupported.keys().collect()
    &operations.sort()
    loop module in bundle.modules {
        loop (_, import) in walk_imports(module) {
            loop binding in import.walk_bindings() {
                surface :: socket_surface(binding.path()) ?? next
                span :: binding.items_span ?? binding.module_alias_span
                key :: (module.display, span.start, span.end, "E3304")
                if !socket_target && !seen.has_key(key) {
                    seen[key] = true
                    &diagnostics.push(Diagnostic.from_row("E3304", [("module", surface), ("target", target)], Val(span)))
                }
                if unsupported_surfaces.has_key(surface) {
                    operation_key :: (module.display, span.start, span.end, "E3305:{surface}")
                    if !seen.has_key(operation_key) {
                        seen[operation_key] = true
                        &diagnostics.push(Diagnostic.from_row("E3305", [("operation", surface), ("target", target)], Val(span)))
                    }
                }
                loop operation in operations {
                    if operation_surface(operation) != Val(surface) -> next
                    operation_key :: (module.display, span.start, span.end, "E3305:{operation}")
                    if !seen.has_key(operation_key) {
                        seen[operation_key] = true
                        &diagnostics.push(Diagnostic.from_row("E3305", [("operation", operation), ("target", target)], Val(span)))
                    }
                }
            }
        }
    }
    diagnostics
}

// Rust: crates/jet-sema/src/Sema/TargetSurface.rs:158
fn wasip2_unsupported_surfaces(bundle: ProgramBundle) -> [String:Bool] {
    surfaces := [String:Bool]{}
    loop module in bundle.modules {
        loop (_, import) in walk_imports(module) {
            loop binding in import.walk_bindings() {
                if socket_surface(binding.path()) == .Val(surface) {
                    if WASIP2_UNSUPPORTED_SURFACES.contains(surface) -> surfaces[surface] = true
                }
            }
        }
    }
    surfaces
}
// Rust: crates/jet-sema/src/Sema/TargetSurface.rs:174
fn operation_surface(operation: String) -> String? {
    pair :: operation.rsplit_once('.') ?? return None
    Val(pair.0)
}
// Rust: crates/jet-sema/src/Sema/TargetSurface.rs:178
fn socket_surface(path: String) -> String? {
    loop surface in SOCKET_SURFACES { if surface == path -> return Val(surface) }
    if Syntax.is_known_core_module(path) -> return None
    module :: (path.rsplit_once('.') ?? return None).0
    loop surface in SOCKET_SURFACES { if surface == module -> return Val(surface) }
    None
}
// Rust: crates/jet-sema/src/Sema/TargetSurface.rs:192
fn wasip2_unsupported_operations(bundle: ProgramBundle) -> [String:Bool] {
    operations := [String:Bool]{}
    loop usage in bundle.used_core {
        (module, call) :: usage.split_once("::") ?? next
        unsupported :: if module == {
            "core.net" -> ["tcp_connect_happy", "tcp_ready", "udp_ready", "tls_connect", "tls_read", "tls_write", "tls_close", "dns_a", "dns_aaaa", "dns_txt", "dns_ptr", "dns_srv"].contains(call) || call.starts_with("unix_")
            "core.http" -> ["get", "post", "request"].contains(call)
            "core.http.server" -> call == "tls"
            "core.net.tls" -> true
            "core.http.client", "core.email" -> true
            else -> false
        }
        if unsupported -> operations["{module}.{call}"] = true
    }
    operations
}
// Rust: crates/jet-sema/src/Sema/TargetSurface.rs:227
fn socket_target_supported(target: String) -> Bool {
    target == Syntax.BUILD_TARGET_WASI_SERVER || ["linux", "android", "apple", "darwin", "windows", "freebsd", "openbsd", "netbsd"].any(fn(os) { target.contains(os) })
}
