// D-SPREAD1=A: expand prefix.[a, b] before inference.
use jet_foundation.[Span, EnumLitArg, Expr, ForKind, Item, LambdaBody, ProgramBundle, Stmt, StrPart, TypedLitBody]

// Rust: crates/jet-sema/src/Sema/MemberSpread.rs:9
pub fn desugar_member_spreads(bundle: &ProgramBundle) {
    loop &module in bundle.modules {
        loop &item in module.items {
            if item == {
                .Func(f) -> desugar_stmts(&f.body)
                .Const(c) -> desugar_expr(&c.value)
                .Test(t) -> {
                    if t.name_expr == .Val(e) { desugar_expr(&e) }
                    if t.faults_expr == .Val(e) { desugar_expr(&e) }
                    if t.expected_fail_expr == .Val(e) { desugar_expr(&e) }
                    desugar_stmts(&t.body)
                }
                .Struct(s) -> {
                    loop &m in s.methods { desugar_stmts(&m.body) }
                    loop &b in s.trait_impls { loop &m in b.methods { desugar_stmts(&m.body) } }
                }
                .Enum(e) -> { loop &m in e.methods { desugar_stmts(&m.body) } }
                .Impl(i) -> { loop &m in i.methods { desugar_stmts(&m.body) } }
                _ -> {}
            }
        }
    }
}
// Rust: crates/jet-sema/src/Sema/MemberSpread.rs:53
fn desugar_stmts(stmts: &[Stmt]) { loop &stmt in stmts { desugar_stmt(&stmt) } }
// Rust: crates/jet-sema/src/Sema/MemberSpread.rs:59
fn desugar_stmt(stmt: &Stmt) {
    if stmt == {
        .Expr(e) | .Yield(e, _) | .DeferClose(close: e, ..) | .BreakValue(e, _) -> desugar_expr(&e)
        .BreakLabelValue(_, _, e, _) -> desugar_expr(&e)
        .Val(b) -> desugar_expr(&b.init)
        .Assign(value: value, ..) -> desugar_expr(&value)
        .Return(.Val(e), _) -> desugar_expr(&e)
        .While(cond: cond, body: body, ..) -> { desugar_expr(&cond); desugar_stmts(&body) }
        .For(kind: kind, body: body, ..) -> {
            if kind == {
                .Range(start: start, end: end, step: step, ..) -> {
                    desugar_expr(&start); desugar_expr(&end)
                    if step == .Val(s) { desugar_expr(&s) }
                }
                .In(collection: collection, step: step) -> {
                    desugar_expr(&collection)
                    if step == .Val(s) { desugar_expr(&s) }
                }
            }
            desugar_stmts(&body)
        }
        .Switch(subject: subject, arms: arms, else_body: else_body, ..)
            | .ComptimeSwitch(subject: subject, arms: arms, else_body: else_body, ..) -> {
            desugar_expr(&subject)
            loop &arm in arms { desugar_expr(&arm.cond); desugar_stmts(&arm.body) }
            if else_body == .Val(eb) { desugar_stmts(&eb) }
        }
        .CountedLoop(init: init, cond: cond, step: step, body: body, ..) -> {
            desugar_expr(&init.init); desugar_expr(&cond)
            if step == .Val(s) { desugar_stmt(&s) }
            desugar_stmts(&body)
        }
        .Loop(body: body, ..) | .Reactive(body: body, ..) | .Shield(body: body, ..) | .Switched(body: body, ..)
            | .Region(body: body, ..) | .Policy(body: body, ..) | .TaskGroup(body: body, ..) | .Layout(body: body, ..)
            | .AuthorityScope(body: body, ..) | .Transact(body: body, ..) | .ComptimeBlock(body: body, ..)
            | .Live(body: body, ..) -> desugar_stmts(&body)
        .Unsafe(audit_expr: audit_expr, body: body, ..) -> {
            if audit_expr == .Val(e) { desugar_expr(&e) }
            desugar_stmts(&body)
        }
        .Impure(reason_expr: reason_expr, body: body, ..) -> {
            if reason_expr == .Val(e) { desugar_expr(&e) }
            desugar_stmts(&body)
        }
        .AssumeDet(reason_expr: reason_expr, body: body, ..) -> { desugar_expr(&reason_expr); desugar_stmts(&body) }
        .ComptimeIf(cond: cond, then_body: then_body, else_body: else_body, ..) -> {
            desugar_expr(&cond); desugar_stmts(&then_body)
            if else_body == .Val(eb) { desugar_stmts(&eb) }
        }
        .ContextBlock(fields: fields, body: body, ..) -> {
            loop &(_, value, _) in fields { desugar_expr(&value) }
            desugar_stmts(&body)
        }
        .ScopeMember(args: args, body: body, ..) -> {
            loop &a in args { desugar_expr(&a) }
            desugar_stmts(&body)
        }
        _ -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/MemberSpread.rs:190
fn fields_from_spread(base: Expr, members: [(String, Span)], span: Span) -> [Expr] {
    fields := [Expr]{}
    loop (name, member_span) in members {
        fields.push(Expr.Field(base.clone(), name.clone(), Span.new(span.start, member_span.end)))
    }
    ^fields
}
// Rust: crates/jet-sema/src/Sema/MemberSpread.rs:204
fn desugar_expr(expr: &Expr) {
    // Splice lists before a spread becomes its own ListLit.
    if expr == .ListLit(elems, _) {
        input :: ^elems
        out := [Expr]{}
        loop &elem in input {
            if elem == .MemberSpread(base: base, members: members, span: span) {
                desugar_expr(&base)
                out.extend(fields_from_spread(base, members, span))
            } else {
                desugar_expr(&elem)
                out.push(^elem)
            }
        }
        elems = ^out
        return
    }
    if expr == .MemberSpread(base: base, members: members, span: span) {
        desugar_expr(&base)
        fields :: fields_from_spread(base, members, span)
        expr = Expr.ListLit(fields, span)
        return
    }
    if expr == {
        .Spread(inner, _) | .Paren(inner, _) | .Copy(inner, _) | .Unary(_, inner, _) | .Deref(inner, _)
            | .RawOf(inner, _) | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _) | .Tainted(inner, _, _)
            | .Field(inner, _, _) | .Place(inner, _, _) -> desugar_expr(&inner)
        .Try(inner, _, _, note) -> {
            desugar_expr(&inner)
            if note == .Val(note) { desugar_expr(&note) }
        }
        .Binary(_, a, b, _) -> { desugar_expr(&a); desugar_expr(&b) }
        .CompareChain(operands: operands, ..) -> { loop &op in operands { desugar_expr(&op) } }
        .OptField(base: base, ..) -> desugar_expr(&base)
        .Call(call) -> { loop &arg in call.args { desugar_expr(&arg.expr) } }
        .MethodCall(receiver: receiver, args: args, ..) -> {
            desugar_expr(&receiver)
            loop &arg in args { desugar_expr(&arg.expr) }
        }
        .CallValue(callee: callee, args: args, ..) -> {
            desugar_expr(&callee)
            loop &arg in args { desugar_expr(&arg.expr) }
        }
        .Index(base: base, index: index, ..) -> { desugar_expr(&base); desugar_expr(&index) }
        .Slice(base: base, start: start, end: end, range: range, ..) -> {
            desugar_expr(&base); desugar_expr(&start); desugar_expr(&end)
            if range == .Val(r) { desugar_expr(&r) }
        }
        .Range(start: start, end: end, ..) -> { desugar_expr(&start); desugar_expr(&end) }
        .StructLit(fields: fields, ..) -> { loop &(_, _, value) in fields { desugar_expr(&value) } }
        .TypedLit(body: body, ..) -> {
            if body == {
                .Fields(fields) -> { loop &(_, _, value) in fields { desugar_expr(&value) } }
                .Elements(elems) -> { loop &e in elems { desugar_expr(&e) } }
                .Entries(entries) -> { loop &(k, v) in entries { desugar_expr(&k); desugar_expr(&v) } }
                .Value(inner) -> desugar_expr(&inner)
                .ByteText(_) | .Empty -> {}
            }
        }
        .EnumLit(args: args, ..) -> {
            loop &arg in args {
                if arg == { .Positional(e) -> desugar_expr(&e) .Named(expr: e, ..) -> desugar_expr(&e) }
            }
        }
        .MapLit(entries, _) -> { loop &(k, v) in entries { desugar_expr(&k); desugar_expr(&v) } }
        .TupleLit(fields, _, _) -> { loop &(_, value) in fields { desugar_expr(&value) } }
        .Lambda(lam) -> { if lam.body == { .Block(body) -> desugar_stmts(&body) .Expr(e) -> desugar_expr(&e) } }
        .If(cond: cond, then_body: then_body, then_value: then_value, else_body: else_body, else_value: else_value, ..) -> {
            desugar_expr(&cond); desugar_stmts(&then_body); desugar_expr(&then_value)
            desugar_stmts(&else_body); desugar_expr(&else_value)
        }
        .OrFallback(value: value, fallback: fallback, ..) -> {
            desugar_expr(&value)
            if fallback == {
                .Value(e) | .Return(.Val(e), _) -> desugar_expr(&e)
                .Block(body: body, value: value, ..) -> {
                    desugar_stmts(&body)
                    if value == .Val(value) { desugar_expr(&value) }
                }
                .Panic(args: args, ..) -> { loop &arg in args { desugar_expr(&arg.expr) } }
                _ -> {}
            }
        }
        .PatternTest(subject: subject, ..) -> desugar_expr(&subject)
        .Str(parts, _) -> { loop &part in parts { if part == .Interp(inner, _) { desugar_expr(&inner) } } }
        .PtrFromAddr(addr: addr, ..) -> desugar_expr(&addr)
        _ -> {}
    }
}
