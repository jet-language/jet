// Checked serial source-order schedule and derivation for frame callbacks.
// Call/resource facts are supplied by the sema caller; this module does not
// invent identities or completion contracts.

pub struct SemaFrameScheduleBuild {
    pub schedule: FrameSchedule?
    pub error: String?
}

pub struct SemaFrameScheduleFacts {
    pub schedule: FrameSchedule?
    pub explanation: String?
    pub derivation_record: DerivationRecord?
    pub derivation: DerivationRef?
    pub mir_derivation: MirDerivationRef?
    pub error: String?
}

struct FrameEventIndex { token: String, index: Int }
struct FrameDependencyKey { before: Int, after: Int, resource: String }
struct FrameUse {
    resource: String
    first: Int
    last: Int
    temporary: Bool
    layouts: [ResourceLayout?]
}
pub struct SemaFrameOperationFact {
    pub operation: FrameOperation?
    pub error: String?
}

// Project the registered Core access contract onto checked argument places.
// The caller supplies the canonical call name and source byte index.
pub fn sema_frame_core_call_operation(record: CoreCallRecord, name: String, args: [CallArg], source_index: Int) -> SemaFrameOperationFact Never! {
    accesses := [ResourceAccess]{}
    loop access in record.frame_accesses {
        if access.argument < 0 || access.argument >= args.len() -> next
        identity :: sema_frame_resource_identity(args[access.argument].expr) ?? next
        &accesses.push(ResourceAccess{
            resource: identity,
            mode: sema_frame_core_access_mode(access.mode),
            region: ResourceRegion.Whole,
            layout: None,
            temporary: false,
        })
    }
    completion := FrameCompletion.Synchronous
    completion_provider := None
    if record.frame_completion == {
        .Val(_) -> {
            metadata :: record.frame_completion ?? CoreCallCompletion{kind: CoreCallCompletionKind.Synchronous, token: None, provider: ""}
            completion_provider = Val(metadata.provider)
            if metadata.kind == {
                .Synchronous -> {}
                .Pending -> {
                    token :: metadata.token ?? return SemaFrameOperationFact{operation: None, error: Val("core frame primitive `{name}` has pending completion without a checked token")}
                    completion = FrameCompletion.Pending{token: token}
                }
                .Event -> {
                    token :: metadata.token ?? return SemaFrameOperationFact{operation: None, error: Val("core frame primitive `{name}` has event completion without a checked token")}
                    completion = FrameCompletion.Event{token: token}
                }
            }
        }
        .None -> {
            if accesses.len() > 0 -> return SemaFrameOperationFact{operation: None, error: Val("core frame primitive `{name}` has resource accesses but no checked completion metadata")}
        }
    }
    external_effect := record.effect_kind != None || record.effect_leaf != None
    if !external_effect && accesses.len() == 0 -> return SemaFrameOperationFact{operation: None, error: None}
    SemaFrameOperationFact{
        operation: Val(FrameOperation{name: name, source_index: source_index, accesses: accesses, completion: completion, completion_provider: completion_provider, external_effect: external_effect}),
        error: None,
    }
}

// Checked ordinary-call parameter conventions take precedence; elaborated
// argument conventions are the fallback for omitted signature slots.
pub fn sema_frame_checked_call_operation(name: String, args: [CallArg], signature_accesses: [AccessConvention]?, extern_or_unknown: Bool, external_effect: Bool, source_index: Int) -> SemaFrameOperationFact Never! {
    accesses := [ResourceAccess]{}
    loop (index, argument) in args {
        identity :: sema_frame_resource_identity(argument.expr) ?? next
        convention := argument.convention
        if signature_accesses != None {
            parameters :: signature_accesses ?? [AccessConvention]{}
            if index < parameters.len() -> convention = parameters[index]
        }
        &accesses.push(ResourceAccess{
            resource: identity,
            mode: sema_frame_access_convention(convention),
            region: ResourceRegion.Whole,
            layout: None,
            temporary: false,
        })
    }
    if extern_or_unknown && accesses.len() > 0 -> return SemaFrameOperationFact{operation: None, error: Val("foreign or unknown frame primitive `{name}` has resource accesses but no checked completion token")}
    if !external_effect && accesses.len() == 0 -> return SemaFrameOperationFact{operation: None, error: None}
    SemaFrameOperationFact{
        operation: Val(FrameOperation{name: name, source_index: source_index, accesses: accesses, completion: FrameCompletion.Synchronous, completion_provider: None, external_effect: external_effect}),
        error: None,
    }
}

pub fn sema_frame_resource_identity(expression: Expr) -> ResourceIdentity? {
    if expression == {
        .Paren(inner, _) | .Place(inner, _, _) | .Copy(inner, _) -> return sema_frame_resource_identity(inner)
        .Ident(name, _) -> return Val(ResourceIdentity.Named{name: name})
        .Field(base, _, _) -> return sema_frame_resource_identity(base)
        .Index(base, _, _, _) | .Slice(base, _, _, _, _) -> {
            identity :: sema_frame_resource_identity(base) ?? return Val(ResourceIdentity.Unknown)
            return Val(identity)
        }
        .Call(_) | .MethodCall(_, _, _, _, _, _, _, _, _, _) | .CallValue(_, _, _) -> return Val(ResourceIdentity.Unknown)
        else -> None
    }
}

fn sema_frame_core_access_mode(mode: CoreCallResourceAccessMode) -> ResourceAccessMode Never! {
    if mode == {
        .Read -> ResourceAccessMode.Read
        .Write -> ResourceAccessMode.Write
        .Move -> ResourceAccessMode.Move
    }
}

fn sema_frame_access_convention(convention: AccessConvention) -> ResourceAccessMode Never! {
    if convention == {
        .Read -> ResourceAccessMode.Read
        .Write -> ResourceAccessMode.Write
        .Move -> ResourceAccessMode.Move
    }
}


pub struct SemaFrameDmaBinding {
    pub transfer_name: String
    pub profile_id: String
    pub channel: String
    pub buffer_name: String
    pub token: String
}

pub struct SemaFrameHardwareCall {
    pub operation: FrameOperation?
    pub dma_start: SemaFrameDmaBinding?
}

// Only selected target-machine register facts can create an MMIO resource.
pub fn sema_frame_hardware_register_operation(receiver: Expr, method: String, source_index: Int, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> FrameOperation? {
    if method != "read" && method != "write" && method != "set" && method != "clear" -> return None
    path :: sema_hardware_board_path(receiver, environment, scopes) ?? return None
    if path.segments.len() < 3 -> return None
    machine :: sema_hardware_target_machine(environment) ?? return None
    block :: sema_hardware_register_block_fact(machine, path.segments[1]) ?? return None
    register :: sema_hardware_register_fact(block, path.segments[2]) ?? return None
    mode := if method == "read" -> ResourceAccessMode.Read else -> ResourceAccessMode.Write
    resource := "mmio::" + path.profile_id + "::" + block.name + "::" + register.name
    Val(FrameOperation{
        name: "hardware.register." + path.profile_id + "." + block.name + "." + register.name + "." + method,
        source_index: source_index,
        accesses: [ResourceAccess]{ResourceAccess{resource: ResourceIdentity.Named{name: resource}, mode: mode, region: ResourceRegion.Whole, layout: None, temporary: false}},
        completion: FrameCompletion.Synchronous,
        completion_provider: None,
        external_effect: true,
    })
}

// Bind the exact checked start token to the source local that receives it.
pub fn sema_frame_hardware_dma_bind_start(start: SemaFrameDmaBinding, transfer_name: String) -> SemaFrameDmaBinding Never! {
    result := start
    result.transfer_name = transfer_name
    result
}

pub fn sema_frame_hardware_dma_start(receiver: Expr, args: [CallArg], source_index: Int, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> SemaFrameHardwareCall Never! {
    is_dma_receiver := if receiver == {
        .Ident(name, _) -> name == "dma"
        else -> false
    }
    if !is_dma_receiver || args.len() != 2 -> return SemaFrameHardwareCall{operation: None, dma_start: None}
    path :: sema_hardware_board_path(args[0].expr, environment, scopes) ?? return SemaFrameHardwareCall{operation: None, dma_start: None}
    if path.segments.len() < 3 -> return SemaFrameHardwareCall{operation: None, dma_start: None}
    machine :: sema_hardware_target_machine(environment) ?? return SemaFrameHardwareCall{operation: None, dma_start: None}
    channel :: sema_hardware_dma_channel_fact(machine, path.segments[1], path.segments[2]) ?? return SemaFrameHardwareCall{operation: None, dma_start: None}
    buffer :: sema_hardware_expr_name(args[1].expr) ?? return SemaFrameHardwareCall{operation: None, dma_start: None}
    token := "jet_dma_transfer@" + source_index.to_string()
    operation := FrameOperation{
        name: "hardware.dma.start." + path.profile_id + "." + channel,
        source_index: source_index,
        accesses: [ResourceAccess]{ResourceAccess{resource: ResourceIdentity.Named{name: buffer}, mode: ResourceAccessMode.Move, region: ResourceRegion.Whole, layout: None, temporary: false}},
        completion: FrameCompletion.Pending{token: token},
        completion_provider: Val("jet_dma_transfer"),
        external_effect: true,
    }
    return SemaFrameHardwareCall{
        operation: Val(operation),
        dma_start: Val(SemaFrameDmaBinding{transfer_name: "", profile_id: path.profile_id, channel: channel, buffer_name: buffer, token: token}),
    }
}

pub fn sema_frame_hardware_dma_wait(receiver: Expr, source_index: Int, bindings: [SemaFrameDmaBinding]) -> FrameOperation? {
    transfer_name :: sema_hardware_expr_name(receiver) ?? return None
    binding_result := (loop item in bindings {
        if item.transfer_name == transfer_name -> break Val(item)
    } ?? None)
    binding :: binding_result ?? return None
    Val(FrameOperation{
        name: "hardware.dma.wait." + binding.profile_id + "." + binding.channel,
        source_index: source_index,
        accesses: [ResourceAccess]{ResourceAccess{resource: ResourceIdentity.Named{name: binding.buffer_name}, mode: ResourceAccessMode.Move, region: ResourceRegion.Whole, layout: None, temporary: false}},
        completion: FrameCompletion.Event{token: binding.token},
        completion_provider: Val("jet_dma_transfer"),
        external_effect: true,
    })
}

pub fn sema_frame_schedule_build(operations: [FrameOperation]) -> SemaFrameScheduleBuild {
    validation := sema_frame_schedule_validate(operations)
    if validation != None -> return SemaFrameScheduleBuild{schedule: None, error: validation}
    events_result := sema_frame_schedule_events(operations)
    if events_result.error != None -> return SemaFrameScheduleBuild{schedule: None, error: events_result.error}
    events := events_result.events
    dependencies := [FrameDependency]{}
    dependency_keys := [FrameDependencyKey]{}
    transfers := [FrameTransfer]{}
    conservative := [String]{}
    loop left_index in 0..<operations.len() {
        left := operations[left_index]
        loop right_index in left_index + 1..<operations.len() {
            right := operations[right_index]
            loop left_access in left.accesses {
                loop right_access in right.accesses {
                    if !sema_frame_resource_overlaps(left_access.resource, right_access.resource) || !sema_frame_region_overlaps(left_access.region, right_access.region) -> next
                    unknown_alias := left_access.resource == ResourceIdentity.Unknown || right_access.resource == ResourceIdentity.Unknown
                    conflict := sema_frame_mode_writes(left_access.mode) || sema_frame_mode_writes(right_access.mode)
                    if unknown_alias {
                        &conservative.push(left.name + " and " + right.name + " keep source order because aliasing is unknown")
                        if !conflict -> sema_frame_push_dependency(&dependencies, &dependency_keys, left_index, right_index, "unknown resource", "unknown aliasing")
                    }
                    if conflict {
                        resource := if unknown_alias -> "unknown resource" else -> sema_frame_resource_label(left_access.resource)
                        reason := left.name + " " + sema_frame_mode_name(left_access.mode) + " -> " + right.name + " " + sema_frame_mode_name(right_access.mode)
                        sema_frame_push_dependency(&dependencies, &dependency_keys, left_index, right_index, resource, reason)
                    }
                    if left_access.resource == {
                        .Named(resource) -> {
                            if left_access.layout != None && right_access.layout != None {
                                left_layout :: left_access.layout ?? ResourceLayout{size: 0, align: 0, layout: "", device: ""}
                                right_layout :: right_access.layout ?? ResourceLayout{size: 0, align: 0, layout: "", device: ""}
                                if left_layout.device != "" && right_layout.device != "" && left_layout.device != right_layout.device {
                                    transfer := FrameTransfer{before: left_index, after: right_index, resource: resource, from_device: left_layout.device, to_device: right_layout.device}
                                    if !sema_frame_has_transfer(transfers, transfer) -> &transfers.push(transfer)
                                }
                            }
                        }
                        .Unknown -> {}
                    }
                }
            }
            if left.external_effect || right.external_effect -> sema_frame_push_dependency(&dependencies, &dependency_keys, left_index, right_index, "external effect", "visible external effects preserve source order")
        }
    }
    async_error := sema_frame_check_async_uses(operations, events, &dependencies, &dependency_keys)
    if async_error != None -> return SemaFrameScheduleBuild{schedule: None, error: async_error}
    retentions := sema_frame_retentions(operations, events)
    reuse := sema_frame_reuse(operations, events, &conservative)
    sema_frame_sort_dependencies(&dependencies)
    sema_frame_sort_transfers(&transfers)
    conservative = sema_frame_strings_sorted_unique(conservative)
    SemaFrameScheduleBuild{
        schedule: Val(FrameSchedule{operations: operations, dependencies: dependencies, transfers: transfers, reuse: reuse, retentions: retentions, conservative: conservative}),
        error: None,
    }
}

pub fn sema_frame_schedule_produce(operations: [FrameOperation], environment: SemaScopeEnvironment, source_bytes: String, lambda_start: Int) -> SemaFrameScheduleFacts {
    if operations.len() == 0 -> return SemaFrameScheduleFacts{schedule: None, explanation: None, derivation_record: None, derivation: None, mir_derivation: None, error: None}
    built := sema_frame_schedule_build(operations)
    if built.schedule == None -> return SemaFrameScheduleFacts{schedule: None, explanation: None, derivation_record: None, derivation: None, mir_derivation: None, error: built.error}
    graph :: environment.registration_graph ?? return SemaFrameScheduleFacts{schedule: None, explanation: None, derivation_record: None, derivation: None, mir_derivation: None, error: Val("frame schedule derivation requires registered module identity")}
    module_index :: sema_registration_module_index(graph, environment.module_identity) ?? return SemaFrameScheduleFacts{schedule: None, explanation: None, derivation_record: None, derivation: None, mir_derivation: None, error: Val("frame schedule derivation requires registered module identity")}
    module_path := graph.modules[module_index].module_path
    schedule :: built.schedule ?? FrameSchedule{operations: [FrameOperation]{}, dependencies: [FrameDependency]{}, transfers: [FrameTransfer]{}, reuse: [FrameReuse]{}, retentions: [FrameRetention]{}, conservative: [String]{}}
    premises := [String]{}
    loop operation in schedule.operations -> &premises.push(operation.name + "@" + operation.source_index.to_string())
    identity := derivation_identity(module_path, "", "", source_bytes)
    record := derivation_record(module_path + "::on_frame@" + lambda_start.to_string(), "checked frame resource schedule", "jet-sema", MirDerivationMethod.StaticDerivation, "checked-frame-accesses", premises, identity)
    record = derivation_record_with_payload(^record, DerivationPayload.FrameSchedule{schedule: sema_frame_schedule_to_mir(schedule)})
    mir_reference := derivation_record_reference(record)
    SemaFrameScheduleFacts{
        schedule: Val(schedule),
        explanation: Val(sema_frame_schedule_explain(schedule)),
        derivation_record: Val(record),
        derivation: Val(DerivationRef{id: mir_reference.id}),
        mir_derivation: Val(mir_reference),
        error: None,
    }
}

fn sema_frame_schedule_validate(operations: [FrameOperation]) -> String? {
    previous_source := -1
    loop (index, operation) in operations {
        if operation.name.trim() == "" -> return Val("operation {index} is invalid: checked operation name must not be empty")
        if operation.source_index < 0 -> return Val("operation {index} is invalid: source index must be non-negative")
        if index > 0 && operation.source_index < previous_source -> return Val("operation {index} source index {operation.source_index} follows {previous_source} out of order")
        if operation.completion == {
            .Pending(token) | .Event(token) -> {
                if token.trim() == "" -> return Val("operation {index} is invalid: completion token must not be empty")
            }
            else -> {}
        }
        loop access in operation.accesses {
            if access.resource == {
                .Named(resource) -> {
                    if resource.trim() == "" -> return Val("operation `{operation.name}` has invalid access to `{resource}`: resource identity must not be empty")
                }
                .Unknown -> {}
            }
            if access.region == {
                .Bytes(start, length) -> {
                    if start < 0 || length <= 0 || start > 0xffffffffffffffff || length > 0xffffffffffffffff || start + length > 0xffffffffffffffff -> return Val("operation `{operation.name}` has invalid access to `{sema_frame_resource_label(access.resource)}`: byte region must be non-empty and fit its checked range")
                }
                else -> {}
            }
            if access.layout != None {
                layout :: access.layout ?? ResourceLayout{size: 0, align: 0, layout: "", device: ""}
                if layout.size <= 0 || layout.size > 0xffffffffffffffff || layout.align <= 0 || layout.align > 0xffffffffffffffff || (layout.align & (layout.align - 1)) != 0 -> return Val("operation `{operation.name}` has invalid access to `{sema_frame_resource_label(access.resource)}`: layout size must be positive and alignment must be a non-zero power of two")
                if layout.layout.trim() == "" -> return Val("operation `{operation.name}` has invalid access to `{sema_frame_resource_label(access.resource)}`: layout identity must not be empty")
            }
        }
    }
    return None
}

struct FrameEventsResult { events: [FrameEventIndex], error: String? }

fn sema_frame_schedule_events(operations: [FrameOperation]) -> FrameEventsResult Never! {
    events := [FrameEventIndex]{}
    loop (index, operation) in operations {
        if operation.completion == {
            .Event(token) -> {
                previous := sema_frame_event_index(events, token)
                if previous >= 0 -> return FrameEventsResult{events: events, error: Val("operation {index} is invalid: completion token `{token}` has duplicate events at {previous} and {index}")}
                &events.push(FrameEventIndex{token: token, index: index})
            }
            else -> {}
        }
    }
    loop (index, operation) in operations {
        if operation.completion == {
            .Pending(token) -> {
                event_index := sema_frame_event_index(events, token)
                if event_index <= index {
                    resource := if {
                        operation.accesses.len() == 0 -> "unknown resource"
                        else -> sema_frame_resource_label(operation.accesses[0].resource)
                    }
                    return FrameEventsResult{events: events, error: Val("operation `{operation.name}` accesses `{resource}` before completion event `{token}`")}
                }
            }
            else -> {}
        }
    }
    return FrameEventsResult{events: events, error: None}
}

fn sema_frame_event_index(events: [FrameEventIndex], token: String) -> Int Never! {
    loop event in events {
        if event.token == token -> return event.index
    }
    -1
}

fn sema_frame_check_async_uses(operations: [FrameOperation], events: [FrameEventIndex], dependencies: &[FrameDependency], keys: &[FrameDependencyKey]) -> String? {
    loop (index, operation) in operations {
        if operation.completion == {
            .Pending(token) -> {
                event_index := sema_frame_event_index(events, token)
                if event_index < 0 -> return Val("operation `{operation.name}` has no completion event `{token}`")
                sema_frame_push_dependency(dependencies, keys, index, event_index, "completion", operation.name + " completes at event " + token)
                loop later_index in event_index + 1..<operations.len() {
                    later_operation := operations[later_index]
                    loop access in later_operation.accesses {
                        if sema_frame_operation_overlaps(operation, access) -> sema_frame_push_dependency(dependencies, keys, event_index, later_index, "completion", "event " + token + " releases submitted owners")
                    }
                }
            }
            else -> {}
        }
    }
    loop (index, operation) in operations {
        loop access in operation.accesses {
            loop pending_index in 0..<index {
                pending := operations[pending_index]
                if pending.completion == {
                    .Pending(token) -> {
                        if sema_frame_operation_overlaps(pending, access) {
                            event_index := sema_frame_event_index(events, token)
                            if event_index < 0 || event_index >= index -> return Val("operation `{operation.name}` accesses `{sema_frame_resource_label(access.resource)}` before completion event `{token}`")
                        }
                    }
                    else -> {}
                }
            }
        }
    }
    None
}

fn sema_frame_retentions(operations: [FrameOperation], events: [FrameEventIndex]) -> [FrameRetention] Never! {
    retentions := [FrameRetention]{}
    loop (index, operation) in operations {
        if operation.completion == {
            .Pending(token) -> {
                completed := sema_frame_event_index(events, token) > index
                loop access in operation.accesses -> &retentions.push(FrameRetention{resource: sema_frame_resource_label(access.resource), operation: index, owner: operation.name, completion_token: Val(token), completed: completed})
            }
            else -> {}
        }
    }
    retentions
}

fn sema_frame_reuse(operations: [FrameOperation], events: [FrameEventIndex], conservative: &[String]) -> [FrameReuse] {
    uses := [FrameUse]{}
    loop (index, operation) in operations {
        loop access in operation.accesses {
            if access.resource == {
                .Named(resource) -> {
                    use_index := sema_frame_use_index(uses, resource)
                    if {
                        use_index < 0 -> &uses.push(FrameUse{resource: resource, first: index, last: index, temporary: access.temporary, layouts: [ResourceLayout?]{Val(access.layout)}})
                        else -> {
                            usage := uses[use_index]
                            usage.first = min(usage.first, index)
                            usage.last = max(usage.last, index)
                            usage.temporary = usage.temporary && access.temporary
                            &usage.layouts.push(access.layout)
                            uses[use_index] = usage
                        }
                    }
                }
                .Unknown -> {}
            }
        }
    }
    sema_frame_sort_uses(&uses)
    candidates := [FrameUse]{}
    loop usage in uses {
        if usage.temporary -> &candidates.push(usage)
    }
    reuse := [FrameReuse]{}
    loop right in candidates {
        left_index := -1
        best_last := -1
        loop (index, left) in candidates {
            if left.resource != right.resource && left.last < right.first && left.last >= best_last {
                left_index = index
                best_last = left.last
            }
        }
        if left_index < 0 -> next
        left := candidates[left_index]
        reason := sema_frame_matching_layout_reason(left, right)
        legal := reason == None
        reason_text := if reason == None -> "lifetimes do not overlap" else -> reason ?? "layout facts incomplete"
        if legal {
            pending_index := -1
            loop (index, operation) in operations {
                if index <= left.last {
                    if operation.completion == {
                        .Pending(_) -> {
                            if sema_frame_operation_names_resource(operation, left.resource) && index > pending_index -> pending_index = index
                        }
                        else -> {}
                    }
                }
            }
            if pending_index >= 0 {
                if operations[pending_index].completion == {
                    .Pending(token) -> {
                        if sema_frame_event_index(events, token) >= right.first {
                            legal = false
                            reason_text = "completion event " + token + " has not occurred"
                        }
                    }
                    else -> {}
                }
            }
        }
        if !legal -> &conservative.push(left.resource + " was not reused for " + right.resource + ": " + reason_text)
        &reuse.push(FrameReuse{previous_resource: left.resource, next_resource: right.resource, previous_last_use: left.last, next_first_use: right.first, legal: legal, reason: reason_text})
    }
    sema_frame_sort_reuse(&reuse)
    reuse
}

fn sema_frame_use_index(uses: [FrameUse], resource: String) -> Int Never! {
    loop (index, usage) in uses {
        if usage.resource == resource -> return index
    }
    -1
}

fn sema_frame_operation_names_resource(operation: FrameOperation, resource: String) -> Bool Never! {
    loop access in operation.accesses {
        if access.resource == {
            .Named(name) -> {
                if name == resource -> return true
            }
            .Unknown -> {}
        }
    }
    false
}

fn sema_frame_matching_layout_reason(left: FrameUse, right: FrameUse) -> String? {
    left_layout :: sema_frame_first_layout(left.layouts) ?? return Val("layout/size/alignment/device facts are incomplete")
    right_layout :: sema_frame_first_layout(right.layouts) ?? return Val("layout/size/alignment/device facts are incomplete")
    loop layout in left.layouts {
        if layout != (Val(left_layout)) -> return Val("every temporary use needs complete matching layout facts")
    }
    loop layout in right.layouts {
        if layout != (Val(right_layout)) -> return Val("every temporary use needs complete matching layout facts")
    }
    if left_layout.device == "" || right_layout.device == "" -> return Val("placement/device facts are incomplete")
    if left_layout != right_layout -> return Val("size, alignment, layout, or device differs")
    None
}

fn sema_frame_first_layout(layouts: [ResourceLayout?]) -> ResourceLayout? {
    loop layout in layouts {
        if layout != None -> return layout
    }
    None
}

fn sema_frame_operation_overlaps(operation: FrameOperation, access: ResourceAccess) -> Bool Never! {
    loop submitted in operation.accesses {
        if sema_frame_resource_overlaps(submitted.resource, access.resource) && sema_frame_region_overlaps(submitted.region, access.region) -> return true
    }
    false
}

fn sema_frame_resource_overlaps(left: ResourceIdentity, right: ResourceIdentity) -> Bool Never! {
    if left == {
        .Named(name) -> return right == ResourceIdentity.Named{name: name}
        .Unknown -> return true
    }
}

fn sema_frame_region_overlaps(left: ResourceRegion, right: ResourceRegion) -> Bool Never! {
    if left == {
        .Bytes(start, length) -> if right == {
            .Bytes(other_start, other_length) -> return start < other_start + other_length && other_start < start + length
            else -> return true
        }
        else -> return true
    }
}

fn sema_frame_mode_writes(mode: ResourceAccessMode) -> Bool Never! {
    mode == ResourceAccessMode.Write || mode == ResourceAccessMode.Move
}

fn sema_frame_mode_name(mode: ResourceAccessMode) -> String Never! {
    if mode == {
        .Read -> "read"
        .Write -> "write"
        .Move -> "move"
    }
}

fn sema_frame_resource_label(identity: ResourceIdentity) -> String Never! {
    if identity == {
        .Named(name) -> name
        .Unknown -> "unknown resource"
    }
}

fn sema_frame_push_dependency(dependencies: &[FrameDependency], keys: &[FrameDependencyKey], before: Int, after: Int, resource: String, reason: String) Never! {
    loop key in keys {
        if key.before == before && key.after == after && key.resource == resource -> return
    }
    &dependencies.push(FrameDependency{before: before, after: after, resource: resource, reason: reason})
    &keys.push(FrameDependencyKey{before: before, after: after, resource: resource})
}

fn sema_frame_has_transfer(transfers: [FrameTransfer], wanted: FrameTransfer) -> Bool Never! {
    loop item in transfers {
        if item.before == wanted.before && item.after == wanted.after && item.resource == wanted.resource && item.from_device == wanted.from_device && item.to_device == wanted.to_device -> return true
    }
    false
}

fn sema_frame_sort_dependencies(rows: &[FrameDependency]) Never! {
    loop i in 1..<rows.len() {
        item := rows[i]
        j := i
        loop j > 0 && sema_frame_dependency_gt(rows[j - 1], item) {
            rows[j] = rows[j - 1]
            j -= 1
        }
        rows[j] = item
    }
}

fn sema_frame_dependency_gt(left: FrameDependency, right: FrameDependency) -> Bool Never! {
    if left.before != right.before -> return left.before > right.before
    if left.after != right.after -> return left.after > right.after
    if left.resource != right.resource -> return left.resource > right.resource
    left.reason > right.reason
}

fn sema_frame_sort_transfers(rows: &[FrameTransfer]) Never! {
    loop i in 1..<rows.len() {
        item := rows[i]
        j := i
        loop j > 0 && sema_frame_transfer_gt(rows[j - 1], item) {
            rows[j] = rows[j - 1]
            j -= 1
        }
        rows[j] = item
    }
}

fn sema_frame_transfer_gt(left: FrameTransfer, right: FrameTransfer) -> Bool Never! {
    if left.before != right.before -> return left.before > right.before
    if left.after != right.after -> return left.after > right.after
    if left.resource != right.resource -> return left.resource > right.resource
    if left.from_device != right.from_device -> return left.from_device > right.from_device
    left.to_device > right.to_device
}

fn sema_frame_sort_reuse(rows: &[FrameReuse]) Never! {
    loop i in 1..<rows.len() {
        item := rows[i]
        j := i
        loop j > 0 && sema_frame_reuse_gt(rows[j - 1], item) {
            rows[j] = rows[j - 1]
            j -= 1
        }
        rows[j] = item
    }
}

fn sema_frame_reuse_gt(left: FrameReuse, right: FrameReuse) -> Bool Never! {
    if left.previous_last_use != right.previous_last_use -> return left.previous_last_use > right.previous_last_use
    if left.next_first_use != right.next_first_use -> return left.next_first_use > right.next_first_use
    if left.previous_resource != right.previous_resource -> return left.previous_resource > right.previous_resource
    left.next_resource > right.next_resource
}

fn sema_frame_sort_uses(rows: &[FrameUse]) Never! {
    loop i in 1..<rows.len() {
        item := rows[i]
        j := i
        loop j > 0 && rows[j - 1].resource > item.resource {
            rows[j] = rows[j - 1]
            j -= 1
        }
        rows[j] = item
    }
}

fn sema_frame_strings_sorted_unique(values: [String]) -> [String] Never! {
    loop i in 1..<values.len() {
        item := values[i]
        j := i
        loop j > 0 && values[j - 1] > item {
            values[j] = values[j - 1]
            j -= 1
        }
        values[j] = item
    }
    output := [String]{}
    loop value in values {
        if output.len() == 0 || output[output.len() - 1] != value -> &output.push(value)
    }
    output
}

fn sema_frame_explain_access(access: ResourceAccess) -> String Never! {
    sema_frame_mode_name(access.mode) + " " + sema_frame_resource_label(access.resource)
}

fn sema_frame_schedule_explain(schedule: FrameSchedule) -> String Never! {
    lines := [String]{"Why did these operations run in order?"}
    loop operation in schedule.operations {
        accesses := [String]{}
        loop access in operation.accesses -> &accesses.push(sema_frame_explain_access(access))
        description := if accesses.len() == 0 -> "no resource access" else -> accesses.join(", ")
        &lines.push("  " + operation.name + " " + description)
    }
    loop dependency in schedule.dependencies {
        &lines.push("  dependency: " + schedule.operations[dependency.before].name + " -> " + schedule.operations[dependency.after].name + " (" + dependency.reason + ")")
    }
    loop transfer in schedule.transfers -> &lines.push("  transfer: " + transfer.resource + " " + transfer.from_device + " -> " + transfer.to_device)
    loop reuse in schedule.reuse {
        verb := if reuse.legal -> "reuse" else -> "reuse refused"
        &lines.push("  " + verb + ": " + reuse.previous_resource + " -> " + reuse.next_resource + " (" + reuse.reason + ")")
    }
    loop retention in schedule.retentions {
        state := if retention.completed -> "completed" else -> "still retained"
        token := retention.completion_token ?? "return"
        &lines.push("  retention: " + retention.resource + " owner " + retention.owner + " until " + token + " (" + state + ")")
    }
    loop reason in schedule.conservative -> &lines.push("  conservative: " + reason)
    if schedule.dependencies.len() == 0 -> &lines.push("  no conflicting resource accesses")
    lines.join("\n")
}

fn sema_frame_schedule_to_mir(schedule: FrameSchedule) -> MirFrameSchedule Never! {
    operations := [MirFrameOperation]{}
    dependencies := [MirFrameDependency]{}
    transfers := [MirFrameTransfer]{}
    reuse := [MirFrameReuse]{}
    retentions := [MirFrameRetention]{}
    loop operation in schedule.operations {
        accesses := [MirResourceAccess]{}
        loop access in operation.accesses -> &accesses.push(sema_frame_access_to_mir(access))
        &operations.push(MirFrameOperation{name: operation.name, source_index: operation.source_index, accesses: accesses, completion: sema_frame_completion_to_mir(operation.completion), completion_provider: operation.completion_provider, external_effect: operation.external_effect})
    }
    loop row in schedule.dependencies -> &dependencies.push(MirFrameDependency{before: row.before, after: row.after, resource: row.resource, reason: row.reason})
    loop row in schedule.transfers -> &transfers.push(MirFrameTransfer{before: row.before, after: row.after, resource: row.resource, from_device: row.from_device, to_device: row.to_device})
    loop row in schedule.reuse -> &reuse.push(MirFrameReuse{previous_resource: row.previous_resource, next_resource: row.next_resource, previous_last_use: row.previous_last_use, next_first_use: row.next_first_use, legal: row.legal, reason: row.reason})
    loop row in schedule.retentions -> &retentions.push(MirFrameRetention{resource: row.resource, operation: row.operation, owner: row.owner, completion_token: row.completion_token, completed: row.completed})
    MirFrameSchedule{operations: operations, dependencies: dependencies, transfers: transfers, reuse: reuse, retentions: retentions, conservative: schedule.conservative}
}

fn sema_frame_access_to_mir(access: ResourceAccess) -> MirResourceAccess Never! {
    resource := if access.resource == {
        .Named(name) -> MirResourceIdentity.Named{name: name}
        .Unknown -> MirResourceIdentity.Unknown
    }
    mode := if access.mode == {
        .Read -> MirResourceAccessMode.Read
        .Write -> MirResourceAccessMode.Write
        .Move -> MirResourceAccessMode.Move
    }
    region := if access.region == {
        .Whole -> MirResourceRegion.Whole
        .Bytes(start, length) -> MirResourceRegion.Bytes{start: start, length: length}
        .Unknown -> MirResourceRegion.Unknown
    }
    layout := if {
        access.layout == None -> None
        else -> {
            value :: access.layout ?? ResourceLayout{size: 0, align: 0, layout: "", device: ""}
            Val(MirResourceLayout{size: value.size, align: value.align, layout: value.layout, device: value.device})
        }
    }
    MirResourceAccess{resource: resource, mode: mode, region: region, layout: layout, temporary: access.temporary}
}

fn sema_frame_completion_to_mir(completion: FrameCompletion) -> MirFrameCompletion Never! {
    if completion == {
        .Synchronous -> MirFrameCompletion.Synchronous
        .Pending(token) -> MirFrameCompletion.Pending{token: token}
        .Event(token) -> MirFrameCompletion.Event{token: token}
    }
}
