use jet_foundation.[
    AST_NODE_GENERATED,
    BinOp,
    CodeModule,
    Diagnostic,
    EnumLitArg,
    Expr,
    GenericModuleDef,
    GenericModuleParam,
    ImportedItem,
    Item,
    ModuleAliasDef,
    ModuleArg,
    ModuleInstanceApplication,
    ModuleInstanceIdentity,
    NameTable,
    Program,
    Span,
    StrPart,
    SymbolKind,
    TestDef,
    Type,
    type_identity_key,
    type_name,
    Func,
    ModuleID,
    ModuleTable,
    module_text,
    name_column,
    name_column_get,
    name_column_set,
    name_column_table,
    name_find,
    name_index,
    name_intern,
    name_table_sized,
]

// Generic module instantiation checks. `int_cache: cache<Int>(32)` names a
// template, passes type and value arguments, and may chain through other
// aliases. Each alias is resolved in source order of its chain depth, so the
// same alias reports the same first problem: cycle (E0855), unsupported value
// parameter (E0856), alias-chain arguments or arity (E0851), unknown template
// (E0850), type argument kind or bound (E0852), value argument type (E0853) or
// a value that is not closed at compile time (E0857). Instantiating a template
// walks its nested modules and nested templates with the instance's arguments
// bound.

SemaGenericModuleParam: enum {
    Type(name: String, bound: String?),
    Value(name: String, ty: Type),
    Invalid,
}

SemaGenericModuleArg: enum {
    Type(ty: Type),
    Value(ty: Type),
}

SemaGenericModuleTemplate: struct {
    alias_name: String?{None},
    definition: GenericModuleDef,
    params: [SemaGenericModuleParam],
    // Closed constant values visible at the template's definition site.
    values: SemaInlineTypes,
}

SemaGenericModuleCheck: struct {
    module_identity: ModuleID,
    diagnostics: [Diagnostic],
    seen: SemaKeyRows,
}

SemaGenericModuleEdge: struct {
    target: String,
    span: Span,
}

SemaGenericModuleNode: struct {
    name: String,
    edges: [SemaGenericModuleEdge],
}

// `inputs` carries the programs as written of the modules that declare a
// module alias or a generic module (sema_generic_modules_written); every
// other module has nothing to check. By now every valid alias in `graph` is
// an expanded instance (`sema_generic_modules_expand`).
sema_generic_modules_check: fn(graph: ^SemaRegistrationGraph, inputs: [SemaRegistrationModuleInput]) {
    per_module: sema_generic_modules_collect(graph, inputs)
    ^module_index: 0
    loop diagnostics in per_module.move() {
        loop diagnostic in diagnostics.move() {
            graph.diagnostics.push(sema_diagnostic_with_source_location(diagnostic, graph.modules[module_index].source_segments))
        }
        module_index += 1
    }
}

sema_generic_modules_collect: fn(graph: SemaRegistrationGraph, inputs: [SemaRegistrationModuleInput]) -> [[Diagnostic]] {
    // Template parameters resolve once per defining module, so an invalid
    // value parameter reports once however often the template is used.
    ^templates_by_module: [[SemaGenericModuleTemplate]]{}
    ^output: [[Diagnostic]]{}
    loop module_row_index in 0..<graph.modules.len() {
        ^check: SemaGenericModuleCheck{module_identity: graph.modules[module_row_index].module_identity, diagnostics: [Diagnostic]{}, seen: SemaKeyRows{}}
        ^templates: [SemaGenericModuleTemplate]{}
        if sema_genmod_written_input(inputs, graph.modules[module_row_index].module_identity) == .Val(index) {
            templates = sema_genmod_collect_templates(inputs[index].program.items, check)
        }
        templates_by_module.push(templates)
        output.push(check.diagnostics)
    }
    loop (module_index, module_row) in graph.modules {
        ^check: SemaGenericModuleCheck{module_identity: module_row.module_identity, diagnostics: output[module_index], seen: SemaKeyRows{}}
        if sema_genmod_written_input(inputs, module_row.module_identity) == .Val(index) {
            sema_genmod_check_module(graph, module_row, inputs[index].program.items, templates_by_module, check)
        }
        output[module_index] = check.diagnostics
    }
    output
}

// Locate the written input without returning an owned copy of its items.
sema_genmod_written_input: fn(inputs: [SemaRegistrationModuleInput], module_identity: ModuleID) -> Int? {
    loop index in 0..<inputs.len() {
        if inputs[index].module_identity == module_identity -> return Val(index)
    }
    None
}

// The inputs whose programs as written declare a module alias or a generic
// module, taken before registration moves every program into its row.
sema_generic_modules_written: fn(inputs: [SemaRegistrationModuleInput]) -> [SemaRegistrationModuleInput] {
    ^written: [SemaRegistrationModuleInput]{}
    loop input in inputs {
        // copy: the alias check reads these programs as written after
        // registration moves every input's program into its row.
        if sema_genmod_declares_modules(input.program.items) -> written.push(input.copy())
    }
    written.move()
}

sema_genmod_declares_modules: fn(items: [Item]) -> Bool {
    loop item in items {
        if item == {
            .ModuleAlias(_) | .GenericModule(_) -> return true
            .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    false
}

sema_genmod_collect_templates: fn(written: [Item], check: ^SemaGenericModuleCheck) -> [SemaGenericModuleTemplate] {
    enums: sema_genmod_enums(written, [GenericModuleDef]{})
    values: sema_genmod_const_values(written, SemaInlineTypes{}, enums)
    ^templates: [SemaGenericModuleTemplate]{}
    loop item in written {
        if item == .GenericModule(definition) {
            templates.push(SemaGenericModuleTemplate{definition: definition.copy(), params: sema_genmod_resolve_params(definition, enums, check), values: values.copy()})
        }
    }
    templates
}

sema_genmod_check_module: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, items: [Item], templates_by_module: [[SemaGenericModuleTemplate]], check: ^SemaGenericModuleCheck) {
    if sema_genmod_report_cycles(items, check) {
        return
    }
    enums: sema_genmod_enums(items, [GenericModuleDef]{})
    values: sema_genmod_const_values(items, sema_genmod_setting_types(sema_build_facts_settings_at(graph.build_facts, module_row.settings_row), enums), enums)
    ^templates: [SemaGenericModuleTemplate]{}
    module_index: sema_registration_module_index(graph, module_row.module_identity) ?? return
    loop template in templates_by_module[module_index] -> templates.push(template.copy())
    // `use defs.box` brings a template in under its local name. A private
    // template was refused by import registration (E0609); its aliases stay
    // silent rather than also reporting an unknown template.
    ^denied: name_table_sized(2)
    loop import_index in 0..<module_row.imports.len() {
        if module_row.imports[import_index].declaration.kind == .Unqualified(_, _, imported, _, _) {
            target_index: sema_registration_module_index(graph, module_row.imports[import_index].target_module_identity) ?? next
            loop entry in imported {
                source: sema_genmod_find_template(templates_by_module[target_index], entry.original) ?? next
                ^bound_local: String?{None}
                loop binding in module_row.imports[import_index].bindings {
                    if binding.original == entry.original -> bound_local = Val(binding.local)
                }
                if bound_local == {
                    .Val(local) -> {
                        ^renamed: source
                        renamed.alias_name = Val(local)
                        templates.push(renamed)
                    }
                    .None -> ^_: name_intern(denied, sema_genmod_import_local(entry))
                }
            }
        }
    }
    ^aliases: [ModuleAliasDef]{}
    loop item in items {
        if item == .ModuleAlias(alias) -> aliases.push(alias.copy())
    }
    sema_genmod_check_aliases(graph, aliases, templates, values, enums, denied, true, check)
}

sema_genmod_import_local: fn(entry: ImportedItem) -> String {
    if entry.alias == .Val(alias) -> return alias
    parts: entry.original.split(".").to_list()
    parts[parts.len() - 1]
}

// The last template bound to a name wins: an import inserts over a same-named
// local template.
sema_genmod_find_template: fn(templates: [SemaGenericModuleTemplate], name: String) -> SemaGenericModuleTemplate? {
    ^found: SemaGenericModuleTemplate?{None}
    loop template in templates {
        template_name: template.alias_name ?? template.definition.name
        if template_name == name -> found = Val(template)
    }
    found
}

sema_genmod_find_alias: fn(aliases: [ModuleAliasDef], name: String) -> ModuleAliasDef? {
    ^found: ModuleAliasDef?{None}
    loop alias in aliases {
        if alias.name == name -> found = Val(alias)
    }
    found
}

// Keeps `diagnostic` once per (code, span, what); a missing span counts as
// the empty span at 0.
sema_genmod_push: fn(check: ^SemaGenericModuleCheck, diagnostic: ^^Diagnostic) {
    span: diagnostic.span ?? Span{start: 0, end: 0}
    if !sema_key_report_first(check.seen, diagnostic.code, Val(span), diagnostic.what) {
        return
    }
    check.diagnostics.push(diagnostic)
}

// Enum names declared by a module's items (and nested template bodies), each
// marked at its id when every variant is fieldless: only those are Tier-0
// values.
SemaGenericModuleEnums: struct {
    names: NameTable{name_table_sized(2)},
    fieldless: [Bool]{[Bool]{false}},
}

sema_genmod_enum_declared: fn(enums: SemaGenericModuleEnums, name: String) -> Bool {
    name_find(enums.names, name) != None
}

sema_genmod_enum_fieldless: fn(enums: SemaGenericModuleEnums, name: String) -> Bool {
    id: name_find(enums.names, name) ?? return false
    enums.fieldless[name_index(id)]
}

sema_genmod_enums: fn(items: [Item], nested: [GenericModuleDef]) -> SemaGenericModuleEnums {
    ^enums: SemaGenericModuleEnums{}
    sema_genmod_collect_enums(items, enums)
    loop definition in nested -> sema_genmod_collect_enums(definition.body, enums)
    enums
}

sema_genmod_collect_enums: fn(items: [Item], enums: ^SemaGenericModuleEnums) {
    loop item in items {
        if item == .Enum(definition) {
            ^fieldless: true
            loop variant in definition.variants {
                if variant.payload == {
                    .Unit -> {}
                    .Single(_, _) | .Named(_) -> fieldless = false
                }
            }
            row: name_index(name_intern(enums.names, definition.name))
            if row == enums.fieldless.len() -> enums.fieldless.push(fieldless) else {
                enums.fieldless[row] = fieldless
            }
        }
    }
}

// Constants evaluate in declaration order; each closed one is visible to
// later constants and to module arguments.
sema_genmod_const_values: fn(items: [Item], inherited: SemaInlineTypes, enums: SemaGenericModuleEnums) -> SemaInlineTypes {
    ^values: inherited
    loop item in items {
        if item == .Const(definition) {
            value_type: sema_genmod_value_type(definition.value, values, enums) ?? next
            sema_inline_type_put(values, definition.name, value_type)
        }
    }
    values
}

sema_genmod_resolve_params: fn(definition: GenericModuleDef, enums: SemaGenericModuleEnums, check: ^SemaGenericModuleCheck) -> [SemaGenericModuleParam] {
    ^params: [SemaGenericModuleParam]{}
    loop param in definition.params {
        if param == {
            .Type(name, _, bound) -> {
                ^bound_name: String?{None}
                if bound == .Val(bound_type) {
                    if bound_type == .Named(trait_name) -> bound_name = Val(trait_name)
                }
                params.push(SemaGenericModuleParam.Type{name: name, bound: bound_name})
            }
            .Value(name, name_span, ty) -> {
                if sema_genmod_tier0_type(ty, enums) {
                    params.push(SemaGenericModuleParam.Value{name: name, ty: ty})
                } else {
                    sema_genmod_push(check, sema_error("E0856", name_span, "generic module value parameter `{name}` uses unsupported type `{sema_genmod_type_text(ty)}`", "value parameters admit only Bool, Int, Char, String, or a fieldless enum", "use a Tier-0 value type, or make this an unannotated type parameter"))
                    params.push(SemaGenericModuleParam.Invalid)
                }
            }
        }
    }
    params
}

sema_genmod_tier0_type: fn(ty: Type, enums: SemaGenericModuleEnums) -> Bool {
    if ty == {
        .Bool | .Int | .Char | .String -> true
        .Named(name) -> sema_genmod_enum_fieldless(enums, name)
        .Float | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// The bare spelling of the Tier-0 and nominal types, and the structural form of
// anything else.
sema_genmod_type_text: fn(ty: Type) -> String {
    if ty == {
        .Int -> "Int"
        .Bool -> "Bool"
        .Char -> "Char"
        .String -> "String"
        .Named(name) -> name
        .Apply(name, _) -> name
        .Float | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> sema_genmod_type_structure(ty)
    }
}

sema_genmod_type_structure: fn(ty: Type) -> String {
    if ty == {
        .Int -> "Int"
        .Float -> "Float"
        .Bool -> "Bool"
        .Char -> "Char"
        .String -> "String"
        .Named(name) -> "Named(\"{name}\")"
        .List(element) -> "List({sema_genmod_type_structure(element)})"
        .Option(inner) -> "Option({sema_genmod_type_structure(inner)})"
        .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> type_name(ty)
    }
}

// The type of a closed compile-time value, or None when the expression is
// not closed (a runtime call, an unknown name, an interpolated string).
sema_genmod_value_type: fn(expression: Expr, values: SemaInlineTypes, enums: SemaGenericModuleEnums) -> Type? {
    if expression == {
        .Int(_, _, _, _, _) -> Val(Type.Int)
        .Float(_, _, _, _, _) -> Val(Type.Float)
        .Bool(_, _, _) -> Val(Type.Bool)
        .Char(_, _, _) -> Val(Type.Char)
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == {
                    .Lit(_) -> {}
                    .Interp(_, _) | .Byte(_) -> return None
                }
            }
            Val(Type.String)
        }
        .Paren(value, _, _) -> sema_genmod_value_type(value, values, enums)
        .Ident(name, _, _) -> sema_inline_type_of(values, name)
        .Unary(op, operand, _, _) -> {
            inner: sema_genmod_value_type(operand, values, enums) ?? return None
            if op == {
                .Neg -> if inner == {
                    .Int -> Val(Type.Int)
                    .Float -> Val(Type.Float)
                    .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
                }
                .Not -> if inner == {
                    .Bool -> Val(Type.Bool)
                    .Int | .Float | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
                }
                .Complement -> if inner == .Int -> Val(Type.Int) else -> None
            }
        }
        .Binary(op, left, right, _, _) -> {
            left_type: sema_genmod_value_type(left, values, enums) ?? return None
            right_type: sema_genmod_value_type(right, values, enums) ?? return None
            left_key: sema_genmod_tier0_key(left_type) ?? return None
            if left_key != (sema_genmod_tier0_key(right_type) ?? "") -> return None
            if {
                left_key == "Int" && (op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul) -> Val(Type.Int)
                left_key == "Int" && (op == BinOp.Lt || op == BinOp.Le || op == BinOp.Gt || op == BinOp.Ge) -> Val(Type.Bool)
                left_key == "Bool" && (op == BinOp.And || op == BinOp.Or) -> Val(Type.Bool)
                op == BinOp.Eq || op == BinOp.Ne -> Val(Type.Bool)
                left_key == "String" && op == BinOp.Add -> Val(Type.String)
                else -> None
            }
        }
        .Field(base, member, _, _) -> {
            if sema_fact_build_rooted(base) {
                return sema_inline_type_of(values, sema_fact_path_text(base, member) ?? return None)
            }
            if base == .Ident(enum_name, _, _) {
                if sema_genmod_enum_declared(enums, enum_name) {
                    return Val(Type.Named{name: enum_name})
                }
            }
            None
        }
        .EnumLit(enum_name, _, _, args, _, _, _) -> {
            if args.len() == 0 && sema_genmod_enum_declared(enums, enum_name) {
                return Val(Type.Named{name: enum_name})
            }
            None
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_genmod_tier0_key: fn(ty: Type) -> String? {
    if ty == {
        .Bool -> Val("Bool")
        .Int -> Val("Int")
        .Char -> Val("Char")
        .String -> Val("String")
        .Named(name) -> Val("enum {name}")
        .Float | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

sema_genmod_arg_span: fn(arg: ModuleArg) -> Span {
    if arg == {
        .Type(_, span) -> span
        .Value(_, span) -> span
    }
}

// Whether a type implements a module bound. Only a bound that names a declared
// trait is checked; a type that resolves to no declaration (a primitive, an
// unknown name) implements no declared trait.
sema_genmod_implements: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, ty: Type, bound: String) -> Bool {
    resolved_bound: sema_registration_lookup_name(graph, module_identity, bound) ?? return true
    if sema_resolved_kind(graph, resolved_bound) != SymbolKind.Trait -> return true
    if sema_type_resolve_nominal_row(graph, ty, module_identity) == None -> return false
    sema_type_bound_satisfied(graph, ty, bound, module_identity) ?? true
}

sema_genmod_resolve_args: fn(graph: SemaRegistrationGraph, alias: ModuleAliasDef, template: SemaGenericModuleTemplate, values: SemaInlineTypes, enums: SemaGenericModuleEnums, check: ^SemaGenericModuleCheck) -> [SemaGenericModuleArg]? {
    ^resolved: [SemaGenericModuleArg]{}
    loop (index, param) in template.params {
        if index >= alias.args.len() -> break
        arg: alias.args[index]
        span: sema_genmod_arg_span(arg)
        if param == {
            .Invalid -> return None
            .Type(name, bound) -> {
                ^ty: Type.Int
                if arg == {
                    .Type(value, _) -> { ty = value }
                    .Value(expression, _) -> {
                        if expression == .Ident(type_ident, _, _) {
                            ty = Type.Named{name: type_ident}
                        } else {
                            sema_genmod_push(check, sema_error("E0852", span, "type argument for `{name}` does not satisfy its module bound", "this slot resolves to a type parameter, but the argument is a value expression", "pass a type that satisfies the declared bound"))
                            return None
                        }
                    }
                }
                if bound == .Val(trait_name) {
                    if !sema_genmod_implements(graph, check.module_identity, ty, trait_name) {
                        identity: sema_genmod_type_text(ty)
                        sema_genmod_push(check, sema_error("E0852", span, "type argument `{identity}` does not satisfy `{trait_name}`", "generic module parameter `{name}` requires the `{trait_name}` bound", "pass a type that implements `{trait_name}`"))
                        return None
                    }
                }
                resolved.push(SemaGenericModuleArg.Type{ty: ty})
            }
            .Value(name, ty) -> {
                expected: sema_genmod_type_text(ty)
                ^expression: Expr?{None}
                if arg == {
                    .Value(value, _) -> { expression = Val(value) }
                    .Type(value, type_span) -> {
                        if value == .Named(type_ident) {
                            expression = Val(Expr.Ident{name: type_ident, span: type_span, id: AST_NODE_GENERATED})
                        }
                    }
                }
                value_expression: expression ?? {
                    sema_genmod_push(check, sema_error("E0853", span, "value argument for `{name}` has the wrong type", "this slot requires an exact `{expected}` Tier-0 value", "pass a compile-time `{expected}` value without conversion"))
                    return None
                }
                actual: sema_genmod_value_type(value_expression, values, enums) ?? {
                    sema_genmod_push(check, sema_error("E0857", span, "value argument for `{name}` is not known at compile time", "generic module instances need one closed, deterministic Tier-0 value", "pass a literal, a `build.*` fact, or a comptime `{expected}` value"))
                    return None
                }
                actual_key: sema_genmod_tier0_key(actual)
                if !sema_genmod_tier0_type(ty, enums) || actual_key == None || actual_key != sema_genmod_tier0_key(ty) {
                    found: if actual_key == None -> "non-Tier-0 value" else -> sema_genmod_type_text(actual)
                    sema_genmod_push(check, sema_error("E0853", span, "value argument for `{name}` has the wrong type", "expected exact `{expected}`, found `{found}`", "pass a compile-time `{expected}` value without conversion"))
                    return None
                }
                resolved.push(SemaGenericModuleArg.Value{ty: actual})
            }
        }
    }
    Val(resolved)
}

sema_genmod_alias_depth: fn(alias: ModuleAliasDef, aliases: [ModuleAliasDef]) -> Int {
    ^depth: 0
    ^current: alias
    loop depth <= aliases.len() {
        next_alias: sema_genmod_find_alias(aliases, current.target) ?? break
        depth += 1
        current = next_alias
    }
    depth
}

sema_genmod_chain_contains: fn(alias: ModuleAliasDef, aliases: [ModuleAliasDef], names: NameTable) -> Bool {
    ^current: alias
    ^steps: 0
    loop steps <= aliases.len() {
        next_alias: sema_genmod_find_alias(aliases, current.target) ?? return false
        if name_find(names, next_alias.name) != None -> return true
        current = next_alias
        steps += 1
    }
    false
}

// Follow an alias-to-alias chain to the template application at its end. A
// link that passes arguments to another alias is E0851.
sema_genmod_resolve_local: fn(alias: ModuleAliasDef, aliases: [ModuleAliasDef], check: ^SemaGenericModuleCheck) -> ModuleAliasDef? {
    ^current: alias
    ^steps: 0
    loop steps <= aliases.len() {
        next_alias: sema_genmod_find_alias(aliases, current.target) ?? break
        if current.args.len() != 0 {
            sema_genmod_push(check, sema_error("E0851", current.span, "module alias `{current.name}` passes {current.args.len()} argument(s) but alias `{current.target}` expects 0", "an alias-to-alias link reuses an already-bound module instance", "remove the arguments and write `{current.name}: {current.target}`"))
            return None
        }
        current = next_alias
        steps += 1
    }
    ^resolved: alias
    resolved.target = current.target
    resolved.target_span = current.target_span
    resolved.args = current.args
    Val(resolved)
}

sema_genmod_by_depth: fn(aliases: [ModuleAliasDef]) -> [ModuleAliasDef] {
    ^ordered: aliases
    ^depths: [Int]{}
    loop alias in ordered -> depths.push(sema_genmod_alias_depth(alias, aliases))
    loop i in 1..<ordered.len() {
        ^alias: ordered[i]
        ^depth: depths[i]
        ^j: i
        loop j > 0 && depths[j - 1] > depth {
            ordered[j] = ordered[j - 1]
            depths[j] = depths[j - 1]
            j -= 1
        }
        ordered[j] = alias
        depths[j] = depth
    }
    ordered
}

// The alias loop shared by file scope and nested module bodies. File scope
// also skips denied templates and leaves forward aliases to the terminal
// instance they project.
sema_genmod_check_aliases: fn(graph: SemaRegistrationGraph, aliases: [ModuleAliasDef], templates: [SemaGenericModuleTemplate], values: SemaInlineTypes, enums: SemaGenericModuleEnums, denied: NameTable, file_scope: Bool, check: ^SemaGenericModuleCheck) {
    ^invalid: name_table_sized(2)
    loop alias in sema_genmod_by_depth(aliases) {
        if sema_genmod_chain_contains(alias, aliases, invalid) -> next
        resolved: sema_genmod_resolve_local(alias, aliases, check) ?? {
            ^_: name_intern(invalid, alias.name)
            next
        }
        if name_find(denied, resolved.target) != None {
            ^_: name_intern(invalid, alias.name)
            next
        }
        if file_scope && sema_genmod_find_alias(aliases, alias.target) != None -> next
        template: sema_genmod_find_template(templates, resolved.target) ?? {
            sema_genmod_push(check, sema_error("E0850", resolved.target_span, "generic module `{resolved.target}` not found in this scope", "check the module template name and make sure it is defined in the same file", "example: `{alias.name}: MyTemplate<String>`"))
            ^_: name_intern(invalid, alias.name)
            next
        }
        args: sema_genmod_resolve_args(graph, resolved, template, values, enums, check) ?? {
            ^_: name_intern(invalid, alias.name)
            next
        }
        if !sema_genmod_instantiate(graph, resolved, template, args, enums, check) {
            ^_: name_intern(invalid, alias.name)
        }
    }
}

sema_genmod_substitute_alias: fn(alias: ModuleAliasDef, names: [String], actuals: [Type]) -> ModuleAliasDef {
    ^updated: alias
    ^args: [ModuleArg]{}
    loop arg in alias.args {
        if arg == {
            .Type(ty, span) -> {
                args.push(ModuleArg.Type{ty: sema_inference_substitute_type(ty, names, actuals), span: span})
            }
            .Value(expression, span) -> args.push(ModuleArg.Value{expr: expression, span: span})
        }
    }
    updated.args = args
    updated
}

sema_genmod_substitute_template: fn(definition: GenericModuleDef, names: [String], actuals: [Type]) -> GenericModuleDef {
    ^updated: definition
    ^params: [GenericModuleParam]{}
    loop param in definition.params {
        if param == {
            .Type(name, name_span, bound) -> {
                params.push(GenericModuleParam.Type{name: name, name_span: name_span, bound: bound})
            }
            .Value(name, name_span, ty) -> {
                params.push(GenericModuleParam.Value{name: name, name_span: name_span, ty: sema_inference_substitute_type(ty, names, actuals)})
            }
        }
    }
    updated.params = params
    updated
}

// The arity check, then the template body under this instance's arguments — its
// nested modules and nested templates.
sema_genmod_instantiate: fn(graph: SemaRegistrationGraph, alias: ModuleAliasDef, template: SemaGenericModuleTemplate, args: ^^[SemaGenericModuleArg], enums: SemaGenericModuleEnums, check: ^SemaGenericModuleCheck) -> Bool {
    definition: template.definition
    if alias.args.len() != definition.params.len() {
        ^names: [String]{}
        loop param in definition.params {
            if param == {
                .Type(name, _, _) -> { names.push(name.copy()) }
                .Value(name, _, _) -> names.push(name.copy())
            }
        }
        expected: definition.params.len()
        sema_genmod_push(check, sema_error("E0851", alias.span, "module alias `{alias.name}` passes {alias.args.len()} argument(s) but `{alias.target}` expects {expected}", "the number of type/value arguments must match the template parameter list", "example: `{alias.name}: {alias.target}<{names.join(", ")}>` with {expected} arg(s)"))
        return false
    }
    ^type_names: [String]{}
    ^type_actuals: [Type]{}
    ^values: template.values
    loop (index, arg) in args.move() {
        if index >= template.params.len() -> break
        if template.params[index] == {
            .Type(name, _) -> {
                if arg == .Type(ty) {
                    type_names.push(name)
                    type_actuals.push(ty)
                }
            }
            .Value(name, _) -> {
                if arg == .Value(ty) -> sema_inline_type_put(values, name, ty)
            }
            .Invalid -> {}
        }
    }
    values = sema_genmod_const_values(definition.body, values, enums)
    loop item in definition.body {
        if item == .CodeModule(nested_module) {
            if nested_module.body == .Val(body) {
                sema_genmod_check_code_module(graph, body, type_names, type_actuals, values, check)
            }
        }
    }
    ^nested_defs: [GenericModuleDef]{}
    loop item in definition.body {
        if item == .GenericModule(nested) {
            nested_defs.push(sema_genmod_substitute_template(nested, type_names, type_actuals))
        }
    }
    if nested_defs.len() == 0 -> return true
    // Nested templates close over the outer instance; their aliases resolve
    // now, with the outer arguments bound. An unknown nested target is left
    // to the instance body.
    nested_enums: sema_genmod_enums([Item]{}, nested_defs)
    nested_templates: loop nested in nested_defs.move() -> {
        params: sema_genmod_resolve_params(nested, nested_enums, check)
        SemaGenericModuleTemplate{definition: nested, params: params, values: values}
    }
    ^nested_aliases: [ModuleAliasDef]{}
    loop item in definition.body {
        if item == .ModuleAlias(nested_alias) {
            nested_aliases.push(sema_genmod_substitute_alias(nested_alias, type_names, type_actuals))
        }
    }
    loop nested_alias in sema_genmod_by_depth(nested_aliases) {
        resolved: sema_genmod_resolve_local(nested_alias, nested_aliases, check) ?? next
        nested_template: sema_genmod_find_template(nested_templates, resolved.target) ?? next
        nested_args: sema_genmod_resolve_args(graph, resolved, nested_template, values, nested_enums, check) ?? next
        ^_: sema_genmod_instantiate(graph, resolved, nested_template, nested_args, nested_enums, check)
    }
    true
}

// A plain module inside an instance resolves its own templates and aliases with
// the instance's arguments and constants in scope, after its child modules.
sema_genmod_check_code_module: fn(graph: SemaRegistrationGraph, body: [Item], type_names: [String], type_actuals: [Type], inherited: SemaInlineTypes, check: ^SemaGenericModuleCheck) {
    loop item in body {
        if item == .CodeModule(child) {
            if child.body == .Val(child_body) {
                sema_genmod_check_code_module(graph, child_body, type_names, type_actuals, inherited, check)
            }
        }
    }
    ^nested_defs: [GenericModuleDef]{}
    ^aliases: [ModuleAliasDef]{}
    loop item in body {
        if item == {
            .GenericModule(nested) -> {
                nested_defs.push(sema_genmod_substitute_template(nested, type_names, type_actuals))
            }
            .ModuleAlias(alias) -> {
                aliases.push(sema_genmod_substitute_alias(alias, type_names, type_actuals))
            }
            .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    if nested_defs.len() == 0 && aliases.len() == 0 {
        return
    }
    enums: sema_genmod_enums(body, nested_defs)
    values: sema_genmod_const_values(body, inherited, enums)
    templates: loop nested in nested_defs.move() -> {
        params: sema_genmod_resolve_params(nested, enums, check)
        SemaGenericModuleTemplate{definition: nested, params: params, values: values}
    }
    sema_genmod_check_aliases(graph, aliases, templates, values, enums, name_table_sized(2), false, check)
}

// Module aliases and templates form one dependency graph per file; a cycle
// (E0855) stops every other generic-module check in that file.
sema_genmod_report_cycles: fn(items: [Item], check: ^SemaGenericModuleCheck) -> Bool {
    ^nodes: [SemaGenericModuleNode]{}
    loop item in items {
        if item == {
            .ModuleAlias(alias) -> {
                edge: SemaGenericModuleEdge{target: alias.target, span: alias.target_span}
                existing: sema_genmod_node_index(nodes, alias.name)
                if existing == {
                    .Val(index) -> { nodes[index].edges.push(edge) }
                    .None -> {
                        nodes.push(SemaGenericModuleNode{name: alias.name, edges: [SemaGenericModuleEdge]{edge}})
                    }
                }
            }
            .GenericModule(definition) -> {
                ^edges: [SemaGenericModuleEdge]{}
                sema_genmod_collect_alias_edges(definition.body, edges)
                existing: sema_genmod_node_index(nodes, definition.name)
                if existing == {
                    .Val(index) -> { nodes[index].edges = edges }
                    .None -> nodes.push(SemaGenericModuleNode{name: definition.name, edges: edges})
                }
            }
            .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    if nodes.len() == 0 -> return false
    loop node_index in 0..<nodes.len() {
        ^edges: nodes[node_index].edges
        loop i in 1..<edges.len() {
            ^edge: edges[i]
            ^j: i
            loop j > 0 && edges[j - 1].target > edge.target {
                edges[j] = edges[j - 1]
                j -= 1
            }
            edges[j] = edge
        }
        nodes[node_index].edges = edges
    }
    ^names: [String]{}
    loop node in nodes -> names.push(node.name)
    loop i in 1..<names.len() {
        ^name: names[i]
        ^j: i
        loop j > 0 && names[j - 1] > name {
            names[j] = names[j - 1]
            j -= 1
        }
        names[j] = name
    }
    ^state_keys: name_column_table()
    ^state: name_column()
    ^stack: [Int]{}
    ^reported: [String]{}
    loop name in names {
        if name_column_get(state_keys, state, name) == None {
            if sema_genmod_node_index(nodes, name) == .Val(node_index) {
                sema_genmod_visit(node_index, nodes, state_keys, state, stack, reported, check)
            }
        }
    }
    reported.len() > 0
}

sema_genmod_collect_alias_edges: fn(items: [Item], edges: ^[SemaGenericModuleEdge]) {
    loop item in items {
        if item == {
            .ModuleAlias(alias) -> {
                edges.push(SemaGenericModuleEdge{target: alias.target, span: alias.target_span})
            }
            .GenericModule(definition) -> sema_genmod_collect_alias_edges(definition.body, edges)
            .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

sema_genmod_node_index: fn(nodes: [SemaGenericModuleNode], name: String) -> Int? {
    loop (index, node) in nodes {
        if node.name == name -> return Val(index)
    }
    None
}

// `state` holds each visited node's mark at its id in `state_keys`: 1 while
// its edges are walked, 2 once they are.
sema_genmod_visit: fn(node_index: Int, nodes: [SemaGenericModuleNode], state_keys: ^NameTable, state: ^[Int], stack: ^[Int], reported: ^[String], check: ^SemaGenericModuleCheck) {
    name_column_set(state_keys, state, nodes[node_index].name, 1)
    stack.push(node_index)
    loop edge in nodes[node_index].edges {
        target_index: sema_genmod_node_index(nodes, edge.target) ?? next
        visited: name_column_get(state_keys, state, edge.target) ?? 0
        if visited == 0 {
            sema_genmod_visit(target_index, nodes, state_keys, state, stack, reported, check)
        } else if visited == 1 {
            ^start: 0
            loop (index, stacked) in stack {
                if stacked == target_index {
                    start = index
                    break
                }
            }
            ^chain: [String]{}
            loop index in start..<stack.len() -> chain.push(nodes[stack[index]].name)
            chain.push(edge.target)
            text: chain.join(" -> ")
            if !reported.contains(text) {
                sema_genmod_push(check, sema_error("E0855", edge.span, "generic module instantiation forms a cycle: {text}", "module aliases must form an acyclic dependency graph so specialization reaches one stable result", "break the cycle: {text}"))
                reported.push(text)
            }
        }
    }
    ^_: stack.pop()
    name_column_set(state_keys, state, nodes[node_index].name, 2)
}

// ---------------------------------------------------------------------------
// Expansion.
//
// `int_cache: cache<Int>(32)` becomes an ordinary module instance
// before registration: the template body with every type parameter, value
// parameter and template constant substituted, its member types and
// constants lifted beside it under the instance's member names. Inline-module
// lowering then gives its functions their member identities like any other
// module. Expansion reports nothing; `sema_generic_modules_check` reports
// every problem once imports are bound, and an alias with one stays
// unexpanded.

// A template an alias can name: a local `cache: module<K>` or one imported
// with `use defs.box`. The key names the defining module, so equal
// applications of one template share one instance.
SemaGenericModuleSource: struct {
    local: String,
    key: String,
    definition: GenericModuleDef,
    // An imported template's defining-module declarations: each instance
    // carries them under its own member names.
    source_items: [Item],
    // Closed constants of the defining module.
    source_values: SemaInlineValues,
}

SemaGenericModuleBinding: struct {
    key: String,
    type_names: [String],
    type_actuals: [Type],
    value_names: [String],
    value_actuals: [Expr],
    // Each argument's identity text, in parameter order: the type identity
    // key of a type argument, the closed literal of a value argument.
    argument_keys: [String],
}

SemaGenericModuleExpansion: struct {
    instance: CodeModule,
    declarations: [Item],
}

// Rows `sema_generic_modules_imported` reads, built once per graph: edge rows
// by source module identity and the rows of inputs that declare a template,
// by module identity, each in ascending order. A per-module scan of every
// edge and every input made registration modules × (edges + inputs).
SemaGenericModuleIndex: struct {
    edge_slots: [ModuleID:Int],
    edge_rows: [[Int]],
    template_slots: [ModuleID:Int],
    template_rows: [[Int]],
}

sema_generic_modules_bucket_add: fn(slots: ^[ModuleID:Int], rows: ^[[Int]], key: ModuleID, row: Int) Never! {
    if slots.get(key) == .Val(slot) {
        rows[slot].push(row)
        return
    }
    slots[key] = rows.len()
    rows.push([Int]{row})
}

sema_generic_modules_index: fn(inputs: [SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge]) -> SemaGenericModuleIndex Never! {
    ^index: SemaGenericModuleIndex{edge_slots: [ModuleID:Int]{}, edge_rows: [[Int]]{}, template_slots: [ModuleID:Int]{}, template_rows: [[Int]]{}}
    loop (row, edge) in edges {
        sema_generic_modules_bucket_add(index.edge_slots, index.edge_rows, edge.source_module_identity, row)
    }
    loop (row, input) in inputs {
        ^has_template: false
        loop item in input.program.items {
            if item == .GenericModule(_) -> has_template = true
        }
        if has_template {
            sema_generic_modules_bucket_add(index.template_slots, index.template_rows, input.module_identity, row)
        }
    }
    index
}

// Templates `module_identity` imports by name, from each loaded import edge;
// `table` spells their keys. A private template binds nothing; import
// registration reports it (E0609).
sema_generic_modules_imported: fn(inputs: [SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], index: SemaGenericModuleIndex, module_identity: ModuleID, table: ModuleTable) -> [SemaGenericModuleSource] {
    ^sources: [SemaGenericModuleSource]{}
    edge_slot: index.edge_slots.get(module_identity) ?? return sources
    loop edge_row in index.edge_rows[edge_slot] {
        edge: edges[edge_row]
        if edge.declaration.kind == .Unqualified(_, _, imported, _, _) {
            template_slot: index.template_slots.get(edge.target_module_identity) ?? next
            loop input_row in index.template_rows[template_slot] {
                input: inputs[input_row]
                items: input.program.items
                enums: sema_genmod_enums(items, [GenericModuleDef]{})
                values: sema_genmod_folded_consts(items, SemaInlineValues{}, enums)
                loop entry in imported {
                    loop item in items {
                        if item == .GenericModule(definition) {
                            if definition.name == entry.original && (definition.is_pub || definition.is_package_pub) {
                                sources.push(SemaGenericModuleSource{local: sema_genmod_import_local(entry), key: "{module_text(table, input.module_identity)}:{definition.name}", definition: definition, source_items: sema_genmod_definition_items(items), source_values: values.copy()})
                            }
                        }
                    }
                }
            }
        }
    }
    sources
}

sema_genmod_definition_items: fn(items: [Item]) -> [Item] {
    ^kept: [Item]{}
    loop item in items {
        if item == {
            .Func(_) | .Struct(_) | .Enum(_) | .Trait(_) | .Tag(_) | .Impl(_) | .ErrorConv(_) | .Test(_) | .Const(_) -> {
                kept.push(item.copy())
            }
            .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .EffectDecl(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    kept
}

// Expands `program`'s module aliases in place; a program without one is left
// untouched (not copied). `module_text` is `module_identity`'s identity text,
// which the instances' keys and applications spell.
sema_generic_modules_expand: fn(program: ^Program, module_identity: ModuleID, module_text: String, imported: [SemaGenericModuleSource], settings: [SemaBuildSetting]) {
    if sema_genmod_has_aliases(program.items) {
        enums: sema_genmod_enums(program.items, [GenericModuleDef]{})
        values: sema_genmod_folded_consts(program.items, sema_genmod_setting_literals(settings, enums), enums)
        nesting: SemaGenericModuleNesting{module_identity: module_identity, module_text: module_text, key_prefix: "{module_text}:", path: ""}
        ^_: sema_genmod_expand_items(program.items, nesting, imported, values, enums)
    }
    if !sema_genmod_has_expression_tests(program.items) {
        return
    }
    enums: sema_genmod_enums(program.items, [GenericModuleDef]{})
    sema_genmod_resolve_test_names(program.items, sema_genmod_setting_literals(settings, enums), enums)
}

// A test named by an expression (`#Test(NAME)`, `#Test(label)` in a generic
// module) is named by the string that expression folds to at compile time,
// behind its instance's prefix. Every later pass reads the resolved `name`:
// the duplicate-name check, the test plan and the test report.
priv sema_genmod_resolve_test_name_item: fn(item: ^Item, values: SemaInlineValues, enums: SemaGenericModuleEnums) {
    if item.in_place() == {
        .Test(definition) -> {
            if definition.name != None -> return
            expression: definition.name_expr ?? return
            folded: sema_genmod_fold(expression, values, enums) ?? return
            text: sema_genmod_text(folded) ?? return
            definition.name = Val(if definition.name_prefix == .Val(prefix) -> sema_genmod_value_name(prefix, text) else -> text)
        }
        .CodeModule(definition) -> {
            if definition.body.in_place() == .Val(body) {
                if sema_genmod_has_expression_tests(body) {
                    sema_genmod_resolve_test_names(body, values, enums)
                }
            }
        }
        .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
}

sema_genmod_resolve_test_names: fn(items: ^[Item], inherited: SemaInlineValues, enums: SemaGenericModuleEnums) {
    values: sema_genmod_folded_consts(items, inherited, enums)
    loop index in 0..<items.len() {
        sema_genmod_resolve_test_name_item(items[index], values, enums)
    }
}

sema_genmod_has_expression_tests: fn(items: [Item]) -> Bool {
    loop item in items {
        if item == {
            .Test(definition) -> {
                if definition.name == None && definition.name_expr != None -> return true
            }
            .CodeModule(definition) -> {
                if definition.body == .Val(body) {
                    if sema_genmod_has_expression_tests(body) -> return true
                }
            }
            .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    false
}

sema_genmod_has_aliases: fn(items: [Item]) -> Bool Never! {
    loop item in items {
        if item == .ModuleAlias(_) -> return true
    }
    false
}

// Where one item list's aliases expand: the module that declares them and its
// identity text, the prefix of its local templates' keys (a template inside
// an instance belongs to that instance), and the flattened name of the module
// body holding the list ("" at file level), which its application names
// start from.
SemaGenericModuleNesting: struct {
    module_identity: ModuleID,
    module_text: String,
    key_prefix: String,
    path: String,
}

SemaGenericModuleExpanded: struct {
    // The expanded aliases, each its own instance.
    instances: NameTable,
    // Every alias projected onto an instance to that instance's alias.
    canonical: SemaInlineAliases,
}

// The instances one item list's aliases expand to: each expanded alias's id
// in `aliases` holds its row in `modules` and in `nominals`, the generated
// names of the struct, enum and trait declarations lifted beside it.
SemaGenericModuleInstances: struct {
    aliases: NameTable{name_column_table()},
    rows: [Int]{name_column()},
    modules: [CodeModule]{[CodeModule]{}},
    nominals: [[String]]{[[String]]{}},
}

// Expands every valid module alias of `items` in place, returning None when
// they hold no alias (or their aliases form a cycle). `values` are the closed
// constants visible to the aliases' arguments.
sema_genmod_expand_items: fn(items: ^[Item], nesting: SemaGenericModuleNesting, imported: [SemaGenericModuleSource], values: SemaInlineValues, enums: SemaGenericModuleEnums) -> SemaGenericModuleExpanded? {
    ^aliases: [ModuleAliasDef]{}
    loop item in items {
        if item == .ModuleAlias(alias) -> aliases.push(alias.copy())
    }
    if aliases.len() == 0 -> return None
    ^silent: SemaGenericModuleCheck{module_identity: nesting.module_identity, diagnostics: [Diagnostic]{}, seen: SemaKeyRows{}}
    if sema_genmod_report_cycles(items, silent) -> return None
    ^sources: [SemaGenericModuleSource]{}
    loop item in items {
        if item == .GenericModule(definition) {
            sources.push(SemaGenericModuleSource{local: definition.name, key: "{nesting.key_prefix}{definition.name}", definition: definition, source_items: [Item]{}, source_values: values})
        }
    }
    loop source in imported -> sources.push(source.copy())
    ^invalid: name_table_sized(2)
    ^instance_keys: SemaInlineAliases{}
    ^projections: SemaInlineAliases{}
    ^projected_names: [String]{}
    ^instances: SemaGenericModuleInstances{}
    ^expanded_names: [String]{}
    ^declarations: [Item]{}
    loop alias in sema_genmod_by_depth(aliases) {
        if sema_genmod_chain_contains(alias, aliases, invalid) -> next
        resolved: sema_genmod_resolve_local(alias, aliases, silent) ?? {
            ^_: name_intern(invalid, alias.name)
            next
        }
        // A forward alias projects the instance its chain ends at.
        if sema_genmod_find_alias(aliases, alias.target) != None {
            sema_inline_alias_put(projections, alias.name, alias.target)
            projected_names.push(alias.name)
            next
        }
        source: sema_genmod_find_source(sources, resolved.target) ?? {
            ^_: name_intern(invalid, alias.name)
            next
        }
        binding: sema_genmod_bind(resolved, source, values, enums) ?? {
            ^_: name_intern(invalid, alias.name)
            next
        }
        // An equal application reuses the first instance.
        if sema_inline_alias_of(instance_keys, binding.key) == .Val(canonical) {
            sema_inline_alias_put(projections, alias.name, canonical)
            projected_names.push(alias.name)
            next
        }
        expansion: sema_genmod_expand_alias(resolved, source, binding, enums, nesting)
        sema_inline_alias_put(instance_keys, binding.key, alias.name)
        name_column_set(instances.aliases, instances.rows, alias.name, instances.modules.len())
        instances.modules.push(expansion.instance)
        expanded_names.push(alias.name)
        ^names: [String]{}
        loop declaration in expansion.declarations {
            if declaration == {
                .Struct(definition) -> { names.push(definition.name) }
                .Enum(definition) -> { names.push(definition.name) }
                .Trait(definition) -> names.push(definition.name)
                .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
            }
            declarations.push(declaration)
        }
        instances.nominals.push(names)
    }
    // Collapse projection chains onto their canonical instance.
    loop name in projected_names {
        ^canonical: sema_inline_alias_of(projections, name) ?? next
        ^steps: 0
        loop steps <= aliases.len() {
            following: sema_inline_alias_of(projections, canonical) ?? break
            canonical = following
            steps += 1
        }
        sema_inline_alias_put(projections, name, canonical)
    }
    ^canonical_names: SemaInlineAliases{}
    loop name in projected_names {
        target: sema_inline_alias_of(projections, name) ?? next
        if name_column_get(instances.aliases, instances.rows, target) != None {
            sema_inline_alias_put(canonical_names, name, target)
        }
    }
    // `three_ints.Buffer`, `m8.Native` and a projected `alias.Type` name the
    // instance's generated nominal.
    ^projection: sema_inline_rewrite_empty()
    loop name in expanded_names -> sema_genmod_project_types(projection, name, name, instances)
    loop name in projected_names {
        canonical: sema_inline_alias_of(projections, name) ?? next
        sema_genmod_project_types(projection, name, canonical, instances)
    }
    ^module_map: [Int:CodeModule]{}
    loop (row, expanded_module) in instances.modules.move() {
        ^with_apps: expanded_module
        sema_genmod_with_applications(with_apps, aliases, canonical_names, nesting)
        module_map[row] = with_apps
    }
    loop index in 0..<items.len() {
        if items[index] == .ModuleAlias(alias) {
            if name_column_get(instances.aliases, instances.rows, alias.name) == .Val(row) {
                if module_map.remove(row) == .Val(expanded_module) {
                    items[index] = Item.CodeModule{value: expanded_module}
                    next
                }
            }
        }
        if sema_genmod_project_item(items[index], projections, projected_names, projection) == .Val(projected) {
            items[index] = projected
        }
    }
    items.extend(declarations.move())
    Val(SemaGenericModuleExpanded{instances: instances.aliases, canonical: canonical_names})
}

// The application name of alias `name` in the module body at `path`: the
// alias itself at file level, else its flattened `outer_inner` name.
sema_genmod_application_name: fn(path: String, name: String) -> String {
    if path == "" -> return name.copy()
    sema_genmod_value_name(path, name)
}

// Records `instance`'s applications in place: its own alias first, then every
// alias projected onto it, in source order. All of them are the one instance.
sema_genmod_with_applications: fn(instance: ^CodeModule, aliases: [ModuleAliasDef], canonical: SemaInlineAliases, nesting: SemaGenericModuleNesting) {
    if instance.instance_identity.in_place() == .Val(identity) {
        semantic: "instance:{identity.fingerprint}"
        ^applications: [ModuleInstanceApplication]{ModuleInstanceApplication{name: sema_genmod_application_name(nesting.path, instance.name), source_module: nesting.module_text, semantic_identity: semantic, span: instance.name_span}}
        loop alias in aliases {
            if alias.name == instance.name || sema_inline_alias_of(canonical, alias.name) != Val(instance.name) {
                next
            }
            applications.push(ModuleInstanceApplication{name: sema_genmod_application_name(nesting.path, alias.name), source_module: nesting.module_text, semantic_identity: semantic.copy(), span: alias.name_span})
        }
        identity.applications = applications
    }
}

// The last template bound to a name wins: an import inserts over a same-named
// local template.
sema_genmod_find_source: fn(sources: [SemaGenericModuleSource], name: String) -> SemaGenericModuleSource? {
    ^found: SemaGenericModuleSource?{None}
    loop source in sources {
        if source.local == name -> found = Val(source)
    }
    found
}

sema_genmod_project_types: fn(rewrite: ^SemaInlineRewrite, alias: String, canonical: String, instances: SemaGenericModuleInstances) {
    prefix: sema_inline_type_prefix(canonical)
    row: name_column_get(instances.aliases, instances.rows, canonical) ?? return
    loop generated in instances.nominals[row] {
        if !generated.starts_with(prefix) -> next
        suffix: String.from_bytes(generated.bytes()[prefix.bytes().len()..<generated.bytes().len()]) ?? next
        sema_inline_type_put(rewrite.types, "{alias}.{suffix}", Type.Named{name: generated})
        sema_inline_type_put(rewrite.types, sema_inline_type_name(alias, suffix), Type.Named{name: generated})
    }
}

// Every top-level declaration that can name an instance member projects, not
// only functions: a field `inner: m8.Handle`, an `impl m8.Handle.Show` or
// `impl Provider.m8.Native` head, a method or test body. A projected alias
// first reads as its canonical instance, then projected member types resolve.
// None: `item` names nothing.
sema_genmod_project_item: fn(item: Item, projections: SemaInlineAliases, projected_names: [String], projection: SemaInlineRewrite) -> Item? {
    if item == {
        .Func(_) | .Struct(_) | .Enum(_) | .Trait(_) | .Impl(_) | .ErrorConv(_) | .Test(_) -> {}
        .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> return None
    }
    ^updated: item
    loop name in projected_names {
        canonical: sema_inline_alias_of(projections, name) ?? next
        ^calls: sema_inline_rewrite_empty()
        sema_inline_alias_put(calls.aliases, name, canonical)
        if sema_genmod_rewrite_item(calls, updated) == .Val(rewritten) -> updated = rewritten
    }
    ^types: projection
    sema_genmod_rewrite_item(types, updated)
}

sema_genmod_rewrite_item: fn(rewrite: ^SemaInlineRewrite, item: Item) -> Item? {
    if item == {
        .Func(function) -> Val(Item.Func{value: sema_inline_rewrite_func(rewrite, function)})
        .Struct(definition) -> Val(Item.Struct{value: sema_inline_rewrite_struct(rewrite, definition, "")})
        .Enum(definition) -> Val(Item.Enum{value: sema_inline_rewrite_enum(rewrite, definition, "")})
        .Trait(definition) -> Val(Item.Trait{value: sema_inline_rewrite_trait(rewrite, definition)})
        .Impl(definition) -> Val(Item.Impl{value: sema_inline_rewrite_impl(rewrite, definition)})
        .ErrorConv(definition) -> Val(Item.ErrorConv{value: sema_inline_rewrite_error_conv(rewrite, definition)})
        .Test(definition) -> {
            ^updated: definition
            saved: rewrite.locals.len()
            sema_inline_rewrite_params(rewrite, updated.params)
            updated.body = sema_inline_rewrite_stmts(rewrite, definition.body)
            sema_inline_restore_locals(rewrite, saved)
            Val(Item.Test{value: updated})
        }
        .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> None
    }
}

// The arguments the checks accept: type arguments as written, value arguments
// folded to their closed literal of the exact parameter type. The key is the
// applicative instance identity.
sema_genmod_bind: fn(alias: ModuleAliasDef, source: SemaGenericModuleSource, values: SemaInlineValues, enums: SemaGenericModuleEnums) -> SemaGenericModuleBinding? {
    definition: source.definition
    if alias.args.len() != definition.params.len() -> return None
    ^binding: SemaGenericModuleBinding{key: source.key, type_names: [String]{}, type_actuals: [Type]{}, value_names: [String]{}, value_actuals: [Expr]{}, argument_keys: [String]{}}
    loop (index, param) in definition.params {
        arg: alias.args[index]
        if param == {
            .Type(name, _, _) -> {
                ^ty: Type.Int
                if arg == {
                    .Type(value, _) -> { ty = value }
                    .Value(expression, _) -> {
                        if expression == .Ident(type_ident, _, _) {
                            ty = Type.Named{name: type_ident}
                        } else { return None }
                    }
                }
                binding.type_names.push(name.copy())
                binding.argument_keys.push(type_identity_key(ty))
                binding.type_actuals.push(ty)
                binding.key = "{binding.key}|{binding.argument_keys[index]}"
            }
            .Value(name, _, ty) -> {
                ^expression: Expr?{None}
                if arg == {
                    .Value(value, _) -> { expression = Val(value) }
                    .Type(value, type_span) -> {
                        if value == .Named(type_ident) {
                            expression = Val(Expr.Ident{name: type_ident, span: type_span, id: AST_NODE_GENERATED})
                        }
                    }
                }
                written: expression ?? return None
                folded: sema_genmod_fold(written, values, enums) ?? return None
                actual_key: sema_genmod_literal_key(folded) ?? return None
                if sema_genmod_tier0_key(ty) != Val(actual_key) -> return None
                binding.value_names.push(name.copy())
                binding.argument_keys.push(sema_genmod_literal_text(folded))
                binding.value_actuals.push(folded)
                binding.key = "{binding.key}|{binding.argument_keys[index]}"
            }
        }
    }
    Val(binding)
}

sema_genmod_nominal_name: fn(item: Item) -> String {
    if item == {
        .Struct(definition) -> definition.name
        .Enum(definition) -> definition.name
        .Trait(definition) -> definition.name
        .Tag(definition) -> definition.name
        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> ""
    }
}

sema_genmod_value_name: fn(alias: String, name: String) -> String {
    bytes: alias.bytes()
    ^end: bytes.len()
    loop end > 0 && (Int{bytes[end - 1]}) == 95 -> end -= 1
    trimmed: String.from_bytes(bytes[0..<end]) ?? alias
    "{trimmed}_{sema_inline_trim_leading_underscores(name)}"
}

// Whether a type argument's spelling names a module: a lowercase name, which
// no type has.
sema_genmod_names_module: fn(name: String) -> Bool Never! {
    if name == "" || name.contains(".") || name.contains(".") -> return false
    first: name.bytes()[0]
    first >= U8{97} && first <= U8{122}
}

sema_genmod_expand_alias: fn(alias: ModuleAliasDef, source: SemaGenericModuleSource, binding: SemaGenericModuleBinding, enums: SemaGenericModuleEnums, nesting: SemaGenericModuleNesting) -> SemaGenericModuleExpansion {
    template: source.definition
    ^rewrite: sema_inline_rewrite_empty()
    loop item in source.source_items {
        name: sema_genmod_nominal_name(item)
        if name != "" {
            sema_inline_type_put(rewrite.types, name, Type.Named{name: sema_inline_type_name(alias.name, name)})
        }
    }
    loop item in template.body {
        name: sema_genmod_nominal_name(item)
        if name != "" {
            sema_inline_type_put(rewrite.types, name, Type.Named{name: sema_inline_type_name(alias.name, name)})
        }
    }
    loop (index, name) in binding.type_names {
        sema_inline_type_put(rewrite.types, name, binding.type_actuals[index])
    }
    loop item in template.body {
        if item == {
            .CodeModule(nested) -> {
                sema_inline_type_put(rewrite.types, nested.name, Type.Named{name: sema_genmod_value_name(alias.name, nested.name)})
            }
            .ModuleAlias(nested) -> {
                sema_inline_type_put(rewrite.types, nested.name, Type.Named{name: sema_genmod_value_name(alias.name, nested.name)})
            }
            .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    rewrite.values = source.source_values
    loop (index, name) in binding.value_names {
        sema_inline_value_put(rewrite.values, name, binding.value_actuals[index])
    }
    // A module argument (`billing<pricing>`) read as a value is that module,
    // so it passes as its Module record (ModuleMeta.jet).
    loop (index, name) in binding.type_names {
        if binding.type_actuals[index] == .Named(actual) {
            if sema_genmod_names_module(actual) {
                sema_inline_value_put(rewrite.values, name, Expr.Ident{name: actual, span: Span{start: 0, end: 0}, id: AST_NODE_GENERATED})
            }
        }
    }
    ^declarations: [Item]{}
    loop item in source.source_items {
        sema_genmod_push_declaration(rewrite, item, alias.name, declarations)
    }
    // Template constants specialize in declaration order; each folded value
    // is visible to later constants and to every member.
    loop item in template.body {
        if item == .Const(definition) {
            value: sema_inline_rewrite_expr(rewrite, definition.value)
            ^mapped: definition.copy()
            mapped.name = sema_genmod_value_name(alias.name, definition.name)
            mapped.ty = sema_inline_rewrite_optional_type(rewrite, definition.ty)
            sema_inline_rewrite_markers(rewrite, mapped.markers)
            mapped.meta = sema_inline_rewrite_meta(rewrite, definition.meta)
            mapped.ct = None
            folded: sema_genmod_fold(value, rewrite.values, enums)
            if folded == .Val(_) {
                literal: folded ?? value
                if mapped.ty == None -> mapped.ty = sema_genmod_literal_type(literal)
                sema_inline_value_put(rewrite.values, definition.name, literal.copy())
                mapped.value = literal
            } else {
                mapped.value = value
            }
            declarations.push(Item.Const{value: mapped})
        }
    }
    // The templates and aliases of the template body expand per instance,
    // under its arguments, as file-level instances named like nested modules:
    // `closed: inner<T>(count)` in `instance: outer<String>(3)` is
    // `instance_closed`, an `inner<String>(3)`. A forward or equal alias
    // among them reads as the instance it shares.
    ^inner: [Item]{}
    loop item in template.body {
        if item == .GenericModule(nested) {
            inner.push(Item.GenericModule{value: sema_genmod_rewrite_template(rewrite, nested)})
        } else if item == .ModuleAlias(nested) {
            ^renamed: sema_genmod_rewrite_alias(rewrite, nested)
            renamed.name = sema_genmod_value_name(alias.name, nested.name)
            if sema_genmod_body_declares_alias(template.body, nested.target) {
                renamed.target = sema_genmod_value_name(alias.name, nested.target)
            }
            inner.push(Item.ModuleAlias{value: renamed})
        }
    }
    inner_nesting: SemaGenericModuleNesting{module_identity: nesting.module_identity, module_text: nesting.module_text, key_prefix: "{binding.key}#", path: nesting.path}
    if sema_genmod_expand_items(inner, inner_nesting, [SemaGenericModuleSource]{}, rewrite.values, enums) == .Val(nested_expanded) {
        loop item in template.body {
            if item == .ModuleAlias(nested) {
                key: sema_genmod_value_name(alias.name, nested.name)
                if name_find(nested_expanded.instances, key) != None {
                    sema_inline_type_put(rewrite.types, nested.name, Type.Named{name: key})
                } else if sema_inline_alias_of(nested_expanded.canonical, key) == .Val(target) {
                    sema_inline_type_put(rewrite.types, nested.name, Type.Named{name: target})
                }
            }
        }
        loop item in inner.move() {
            if item == .GenericModule(_) || item == .ModuleAlias(_) -> next
            declarations.push(item)
        }
    }
    loop item in template.body {
        if item == {
            .Test(definition) -> {
                declarations.push(Item.Test{value: sema_genmod_specialize_test(rewrite, definition, alias.name)})
            }
            .CodeModule(nested) -> {
                ^mapped: nested.copy()
                mapped.name = sema_genmod_value_name(alias.name, nested.name)
                nested_path: SemaGenericModuleNesting{module_identity: nesting.module_identity, module_text: nesting.module_text, key_prefix: "{binding.key}#{nested.name}.", path: sema_genmod_application_name(nesting.path, mapped.name)}
                if nested.body == .Val(nested_body) {
                    mapped.body = Val(sema_genmod_specialize_nested(rewrite, nested_body, nested.name, enums, nested_path))
                }
                declarations.push(Item.CodeModule{value: mapped})
            }
            .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {
                sema_genmod_push_declaration(rewrite, item, alias.name, declarations)
            }
        }
    }
    ^body: [Item]{}
    loop item in source.source_items {
        if item == .Func(function) {
            body.push(Item.Func{value: sema_inline_rewrite_func(rewrite, function)})
        }
    }
    loop item in template.body {
        if item == .Func(function) {
            body.push(Item.Func{value: sema_inline_rewrite_func(rewrite, function)})
        }
    }
    argument_keys: loop key in binding.argument_keys -> sema_genmod_key_bytes(key)
    identity: ModuleInstanceIdentity{full_key: sema_genmod_key_bytes(binding.key), fingerprint: binding.key, definition_id: source.key, argument_keys: argument_keys, argument_values: binding.argument_keys, argument_provenance: [[String]]{}, template_span: template.span, applications: [ModuleInstanceApplication]{}}
    instance: CodeModule{name: alias.name, name_span: alias.name_span, is_pub: alias.is_pub, is_package_pub: alias.is_package_pub, body: Val(body), imports: template.imports, web_target: None, instance_identity: Val(identity), span: alias.span}
    SemaGenericModuleExpansion{instance: instance, declarations: declarations}
}

sema_genmod_key_bytes: fn(text: String) -> [U8] Never! {
    loop byte in text.bytes() -> byte
}

// Whether `body` declares the module alias `name`.
sema_genmod_body_declares_alias: fn(body: [Item], name: String) -> Bool Never! {
    loop item in body {
        if item == .ModuleAlias(declared) {
            if declared.name == name -> return true
        }
    }
    false
}

// A template declared inside an instance's body, with the instance's
// arguments substituted into it. Its own parameters and nominals shadow the
// outer bindings of the same names.
sema_genmod_rewrite_template: fn(rewrite: SemaInlineRewrite, definition: GenericModuleDef) -> GenericModuleDef {
    ^inner: rewrite.copy()
    ^params: [GenericModuleParam]{}
    loop param in definition.params {
        if param == {
            .Type(name, name_span, bound) -> {
                sema_inline_type_drop(inner.types, name)
                sema_inline_value_drop(inner.values, name)
                params.push(GenericModuleParam.Type{name: name, name_span: name_span, bound: sema_inline_rewrite_optional_type(rewrite, bound)})
            }
            .Value(name, name_span, ty) -> {
                sema_inline_type_drop(inner.types, name)
                sema_inline_value_drop(inner.values, name)
                params.push(GenericModuleParam.Value{name: name, name_span: name_span, ty: sema_inline_rewrite_type(rewrite, ty)})
            }
        }
    }
    loop item in definition.body {
        name: sema_genmod_nominal_name(item)
        if name != "" -> sema_inline_type_drop(inner.types, name)
    }
    ^updated: definition
    updated.params = params
    sema_genmod_rewrite_body(inner, updated.body)
    updated
}

// Rewrites the items of a template body in place under `rewrite`, each keeping
// its name; the instance that expands the template later names them.
priv sema_genmod_rewrite_body_item: fn(rewrite: ^SemaInlineRewrite, item: ^Item) {
    if item.in_place() == {
        .Const(definition) -> {
            definition.value = sema_inline_rewrite_expr(rewrite, definition.value)
            definition.ty = sema_inline_rewrite_optional_type(rewrite, definition.ty)
            sema_inline_rewrite_markers(rewrite, definition.markers)
            definition.meta = sema_inline_rewrite_meta(rewrite, definition.meta)
            return
        }
        .CodeModule(child) -> {
            if child.body.in_place() == .Val(child_body) {
                sema_genmod_rewrite_body(rewrite, child_body)
            }
            return
        }
        .GenericModule(definition) -> {
            definition = sema_genmod_rewrite_template(rewrite, definition)
            return
        }
        .ModuleAlias(definition) -> {
            definition = sema_genmod_rewrite_alias(rewrite, definition)
            return
        }
        .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    if sema_genmod_rewrite_item(rewrite, item) == .Val(rewritten) {
        item = rewritten
    }
}

sema_genmod_rewrite_body: fn(rewrite: ^SemaInlineRewrite, body: ^[Item]) {
    loop index in 0..<body.len() {
        sema_genmod_rewrite_body_item(rewrite, body[index])
    }
}

// A module alias inside an instance's body, its arguments under `rewrite`:
// `inner<T>(count)` in `outer<Int>(3)` reads `inner<Int>(3)`.
sema_genmod_rewrite_alias: fn(rewrite: ^SemaInlineRewrite, alias: ModuleAliasDef) -> ModuleAliasDef {
    ^updated: alias
    updated.args = loop arg in alias.args -> sema_genmod_rewrite_arg(rewrite, arg)
    updated
}

sema_genmod_rewrite_arg: fn(rewrite: ^SemaInlineRewrite, arg: ModuleArg) -> ModuleArg {
    if arg == {
        .Type(ty, span) -> ModuleArg.Type{ty: sema_inline_rewrite_type(rewrite, ty), span: span}
        .Value(expression, span) -> {
            // A bare type parameter parses as a value; it passes its type.
            if expression == .Ident(name, _, _) {
                if sema_inline_type_of(rewrite.types, name) == .Val(ty) {
                    return ModuleArg.Type{ty: ty, span: span}
                }
            }
            ModuleArg.Value{expr: sema_inline_rewrite_expr(rewrite, expression), span: span}
        }
    }
}

// The instance copy of a struct or enum (renamed to the instance's member
// name), trait, tag, impl or error conversion.
sema_genmod_push_declaration: fn(rewrite: ^SemaInlineRewrite, item: Item, alias: String, declarations: ^[Item]) {
    if item == {
        .Struct(definition) -> {
            declarations.push(Item.Struct{value: sema_inline_rewrite_struct(rewrite, definition, alias)})
        }
        .Enum(definition) -> {
            declarations.push(Item.Enum{value: sema_inline_rewrite_enum(rewrite, definition, alias)})
        }
        .Trait(definition) -> {
            declarations.push(Item.Trait{value: sema_inline_rewrite_trait(rewrite, definition)})
        }
        .Tag(definition) -> {
            ^mapped: definition
            mapped.name = sema_inline_mapped_name(rewrite, definition.name)
            declarations.push(Item.Tag{value: mapped})
        }
        .Impl(definition) -> {
            declarations.push(Item.Impl{value: sema_inline_rewrite_impl(rewrite, definition)})
        }
        .ErrorConv(definition) -> {
            declarations.push(Item.ErrorConv{value: sema_inline_rewrite_error_conv(rewrite, definition)})
        }
        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
}

// The members of a plain module inside a template, under the instance's
// arguments, keeping their own names. Its own templates and aliases expand in
// place: in `selected: outer<Int>(3)`, the `closed: inner<T>` of `plain` is the
// instance `selected_plain_closed`, still reached as `closed` inside `plain`.
// `nesting.path` is the module's flattened name.
sema_genmod_specialize_nested: fn(rewrite: ^SemaInlineRewrite, body: [Item], module_name: String, enums: SemaGenericModuleEnums, nesting: SemaGenericModuleNesting) -> [Item] {
    ^mapped: [Item]{}
    loop item in body {
        if item == {
            .Func(function) -> {
                mapped.push(Item.Func{value: sema_inline_rewrite_func(rewrite, function)})
            }
            .Struct(definition) -> {
                mapped.push(Item.Struct{value: sema_inline_rewrite_struct(rewrite, definition, "")})
            }
            .Enum(definition) -> {
                mapped.push(Item.Enum{value: sema_inline_rewrite_enum(rewrite, definition, "")})
            }
            .Const(definition) -> {
                ^updated: definition.copy()
                updated.value = sema_inline_rewrite_expr(rewrite, definition.value)
                updated.ty = sema_inline_rewrite_optional_type(rewrite, definition.ty)
                sema_inline_rewrite_markers(rewrite, updated.markers)
                updated.meta = sema_inline_rewrite_meta(rewrite, definition.meta)
                mapped.push(Item.Const{value: updated})
            }
            .CodeModule(child) -> {
                ^updated: child.copy()
                child_nesting: SemaGenericModuleNesting{module_identity: nesting.module_identity, module_text: nesting.module_text, key_prefix: "{nesting.key_prefix}{child.name}.", path: sema_genmod_value_name(nesting.path, child.name)}
                if child.body == .Val(child_body) {
                    updated.body = Val(sema_genmod_specialize_nested(rewrite, child_body, child.name, enums, child_nesting))
                }
                mapped.push(Item.CodeModule{value: updated})
            }
            .GenericModule(definition) -> {
                mapped.push(Item.GenericModule{value: sema_genmod_rewrite_template(rewrite, definition)})
            }
            .ModuleAlias(definition) -> {
                mapped.push(Item.ModuleAlias{value: sema_genmod_rewrite_alias(rewrite, definition)})
            }
            .Trait(definition) -> {
                mapped.push(Item.Trait{value: sema_inline_rewrite_trait(rewrite, definition)})
            }
            .Tag(definition) -> {
                ^updated: definition.copy()
                updated.name = sema_inline_mapped_name(rewrite, definition.name)
                mapped.push(Item.Tag{value: updated})
            }
            .Impl(definition) -> {
                mapped.push(Item.Impl{value: sema_inline_rewrite_impl(rewrite, definition)})
            }
            .ErrorConv(definition) -> {
                mapped.push(Item.ErrorConv{value: sema_inline_rewrite_error_conv(rewrite, definition)})
            }
            .Test(definition) -> {
                mapped.push(Item.Test{value: sema_genmod_specialize_test(rewrite, definition, module_name)})
            }
            .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .EffectDecl(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    values: sema_genmod_folded_consts(mapped, rewrite.values, enums)
    if sema_genmod_expand_items(mapped, nesting, [SemaGenericModuleSource]{}, values, enums) == None -> return mapped
    // The templates and aliases have served; only instances remain.
    kept: loop item in mapped.move() -> {
        if item == .GenericModule(_) || item == .ModuleAlias(_) -> next
        item
    }
    kept
}

sema_genmod_specialize_test: fn(rewrite: ^SemaInlineRewrite, definition: TestDef, alias: String) -> TestDef {
    ^updated: definition
    if definition.name_expr == .Val(expression) {
        updated.name_expr = Val(sema_inline_rewrite_expr(rewrite, expression))
        updated.name = None
        updated.name_prefix = Val(alias)
    } else if definition.name == .Val(name) {
        updated.name = Val(sema_genmod_value_name(alias, name))
    }
    updated.faults_expr = sema_inline_rewrite_optional_expr(rewrite, definition.faults_expr)
    updated.expected_fail_expr = sema_inline_rewrite_optional_expr(rewrite, definition.expected_fail_expr)
    updated.expected_fail = false
    updated.faults = [String]{}
    saved: rewrite.locals.len()
    sema_inline_rewrite_params(rewrite, updated.params)
    sema_inline_rewrite_clauses(rewrite, updated.pre)
    updated.body = sema_inline_rewrite_stmts(rewrite, definition.body)
    sema_inline_restore_locals(rewrite, saved)
    updated
}

// Constants fold in declaration order; each closed one is visible to later
// constants and to module arguments.
sema_genmod_folded_consts: fn(items: [Item], inherited: SemaInlineValues, enums: SemaGenericModuleEnums) -> SemaInlineValues {
    ^values: inherited
    loop item in items {
        if item == .Const(definition) {
            folded: sema_genmod_fold(definition.value, values, enums) ?? next
            sema_inline_value_put(values, definition.name, folded)
        }
    }
    values
}

// A declared `#build.settings.<key>` is one closed Tier-0
// value of its declared type, so a module argument may name it. Each setting
// joins the closed values under its full path; one whose value its type
// cannot read stays out, and an argument naming it is not known (E0857).
sema_genmod_setting_literals: fn(settings: [SemaBuildSetting], enums: SemaGenericModuleEnums) -> SemaInlineValues {
    ^values: SemaInlineValues{}
    loop setting in settings {
        literal: sema_genmod_setting_literal(setting, enums) ?? next
        sema_inline_value_put(values, "#build.settings.{setting.name}", literal)
    }
    values
}

// The Tier-0 type of each readable setting, under its full path.
sema_genmod_setting_types: fn(settings: [SemaBuildSetting], enums: SemaGenericModuleEnums) -> SemaInlineTypes {
    ^values: SemaInlineTypes{}
    loop setting in settings {
        literal: sema_genmod_setting_literal(setting, enums) ?? next
        value_type: sema_genmod_value_type(literal, SemaInlineTypes{}, enums) ?? next
        sema_inline_type_put(values, "#build.settings.{setting.name}", value_type)
    }
    values
}

// The literal a setting's value text reads as under its declared type, as
// sema_fact_build_setting_value reads it: `Bool`, `Int`, `Char`, `String`, or
// a fieldless enum of this module written `.Variant` or `Variant`.
sema_genmod_setting_literal: fn(setting: SemaBuildSetting, enums: SemaGenericModuleEnums) -> Expr? {
    raw: setting.value.trim()
    ty: setting.ty.trim()
    span: Span{start: 0, end: 0}
    if ty == "Int" {
        number: Int.parse(raw) ?? return None
        return Val(Expr.Int{value: number, span: span, width: None, raw: None, id: AST_NODE_GENERATED})
    }
    if ty == "Bool" {
        if raw != "true" && raw != "false" -> return None
        return Val(Expr.Bool{value: raw == "true", span: span, id: AST_NODE_GENERATED})
    }
    if ty == "String" {
        return Val(Expr.Str{parts: [StrPart]{StrPart.Lit{text: sema_fact_build_setting_unquote(raw)}}, span: span, id: AST_NODE_GENERATED})
    }
    if ty == "Char" {
        ^text: raw
        if raw.count_bytes() >= 2 && raw.starts_with("'") && raw.ends_with("'") {
            text = sema_fact_build_setting_unquote(raw.slice(1, raw.len() - 1))
        }
        ^count: 0
        loop _ in text.chars() -> count += 1
        if count != 1 -> return None
        return Val(Expr.Char{value: text, span: span, id: AST_NODE_GENERATED})
    }
    fieldless: sema_genmod_enum_fieldless(enums, ty)
    if !fieldless -> return None
    variant: if raw.starts_with(".") -> raw.slice(1, raw.len()).trim() else -> raw
    Val(Expr.EnumLit{type_name: ty, variant: variant, variant_span: None, args: [EnumLitArg]{}, leading_dot: false, span: span, id: AST_NODE_GENERATED})
}

// A setting's literal spanned at the path that reads it.
sema_genmod_setting_at: fn(literal: Expr, span: Span) -> Expr {
    if literal == {
        .Int(number, _, _, _, _) -> Expr.Int{value: number, span: span, width: None, raw: None, id: AST_NODE_GENERATED}
        .Bool(flag, _, _) -> Expr.Bool{value: flag, span: span, id: AST_NODE_GENERATED}
        .Char(text, _, _) -> Expr.Char{value: text, span: span, id: AST_NODE_GENERATED}
        .Str(parts, _, _) -> Expr.Str{parts: parts, span: span, id: AST_NODE_GENERATED}
        .EnumLit(type_name, variant, _, _, _, _, _) -> Expr.EnumLit{type_name: type_name, variant: variant, variant_span: None, args: [EnumLitArg]{}, leading_dot: false, span: span, id: AST_NODE_GENERATED}
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> literal
    }
}

// The literal an expression folds to over the closed domain the checks accept
// (`sema_genmod_value_type`).
sema_genmod_fold: fn(expression: Expr, values: SemaInlineValues, enums: SemaGenericModuleEnums) -> Expr? {
    if expression == {
        .Int(number, span, _, _, node) -> Val(Expr.Int{value: number, span: span, width: None, raw: None, id: node})
        // copy: the folded literal is a new owned Expr. A Bool/Char literal equals `expression`,
        // the generic template's node (a read parameter), which stays in the template for other
        // instances.
        .Bool(_, _, _) | .Char(_, _, _) -> Val(expression.copy())
        .Str(_, span, node) -> {
            text: sema_genmod_text(expression) ?? return None
            Val(Expr.Str{parts: [StrPart]{StrPart.Lit{text: text}}, span: span, id: node})
        }
        .Paren(value, _, _) -> sema_genmod_fold(value, values, enums)
        .Ident(name, _, _) -> sema_inline_value_of(values, name)
        .Unary(op, operand, span, _) -> {
            inner: sema_genmod_fold(operand, values, enums) ?? return None
            if op == {
                .Neg -> if inner == {
                    .Int(number, _, _, _, node) -> Val(Expr.Int{value: 0 - number, span: span, width: None, raw: None, id: node})
                    .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
                }
                .Not -> if inner == {
                    .Bool(flag, _, node) -> Val(Expr.Bool{value: !flag, span: span, id: node})
                    .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
                }
                .Complement -> if inner == .Int(number, _, _, _, node) -> Val(Expr.Int{value: 0 - number - 1, span: span, width: None, raw: None, id: node}) else -> None
            }
        }
        // The Tier-0 operators a generic module's value argument folds: Int arithmetic and comparison,
        // Bool logic, literal equality, and String concatenation.
        .Binary(op, left, right, span, _) -> {
            lhs: sema_genmod_fold(left, values, enums) ?? return None
            rhs: sema_genmod_fold(right, values, enums) ?? return None
            if lhs == .Int(left_number, _, _, _, _) {
                if rhs == .Int(right_number, _, _, _, _) {
                    if op == BinOp.Add {
                        return Val(Expr.Int{value: left_number + right_number, span: span, width: None, raw: None, id: AST_NODE_GENERATED})
                    }
                    if op == BinOp.Sub {
                        return Val(Expr.Int{value: left_number - right_number, span: span, width: None, raw: None, id: AST_NODE_GENERATED})
                    }
                    if op == BinOp.Mul {
                        return Val(Expr.Int{value: left_number * right_number, span: span, width: None, raw: None, id: AST_NODE_GENERATED})
                    }
                    if op == BinOp.Lt {
                        return Val(Expr.Bool{value: left_number < right_number, span: span, id: AST_NODE_GENERATED})
                    }
                    if op == BinOp.Le {
                        return Val(Expr.Bool{value: left_number <= right_number, span: span, id: AST_NODE_GENERATED})
                    }
                    if op == BinOp.Gt {
                        return Val(Expr.Bool{value: left_number > right_number, span: span, id: AST_NODE_GENERATED})
                    }
                    if op == BinOp.Ge {
                        return Val(Expr.Bool{value: left_number >= right_number, span: span, id: AST_NODE_GENERATED})
                    }
                }
            }
            if lhs == .Bool(left_flag, _, _) {
                if rhs == .Bool(right_flag, _, _) {
                    if op == BinOp.And {
                        return Val(Expr.Bool{value: left_flag && right_flag, span: span, id: AST_NODE_GENERATED})
                    }
                    if op == BinOp.Or {
                        return Val(Expr.Bool{value: left_flag || right_flag, span: span, id: AST_NODE_GENERATED})
                    }
                }
            }
            if op == BinOp.Eq || op == BinOp.Ne {
                left_key: sema_genmod_literal_key(lhs) ?? return None
                right_key: sema_genmod_literal_key(rhs) ?? return None
                if left_key != right_key -> return None
                same: sema_genmod_literal_text(lhs) == sema_genmod_literal_text(rhs)
                return Val(Expr.Bool{value: if op == BinOp.Eq -> same else -> !same, span: span, id: AST_NODE_GENERATED})
            }
            if op != BinOp.Add -> return None
            left_text: sema_genmod_text(lhs) ?? return None
            right_text: sema_genmod_text(rhs) ?? return None
            Val(Expr.Str{parts: [StrPart]{StrPart.Lit{text: "{left_text}{right_text}"}}, span: span, id: AST_NODE_GENERATED})
        }
        .Field(base, member, span, _) -> {
            if sema_fact_build_rooted(base) {
                return Val(sema_genmod_setting_at(sema_inline_value_of(values, sema_fact_path_text(base, member) ?? return None) ?? return None, span))
            }
            if base == .Ident(enum_name, _, _) {
                fieldless: sema_genmod_enum_fieldless(enums, enum_name)
                if fieldless {
                    return Val(Expr.EnumLit{type_name: enum_name, variant: member, variant_span: None, args: [EnumLitArg]{}, leading_dot: false, span: span, id: AST_NODE_GENERATED})
                }
            }
            None
        }
        .EnumLit(enum_name, variant, _, args, _, span, node) -> {
            fieldless: sema_genmod_enum_fieldless(enums, enum_name)
            if args.len() == 0 && fieldless {
                return Val(Expr.EnumLit{type_name: enum_name, variant: variant, variant_span: None, args: [EnumLitArg]{}, leading_dot: false, span: span, id: node})
            }
            None
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// The text of a literal string with no interpolation.
sema_genmod_text: fn(value: Expr) -> String? {
    if value == .Str(parts, _, _) {
        ^text: ""
        loop part in parts {
            if part == {
                .Lit(literal) -> text = "{text}{literal}"
                .Interp(_, _) | .Byte(_) -> return None
            }
        }
        return Val(text)
    }
    None
}

sema_genmod_literal_key: fn(value: Expr) -> String? {
    if value == {
        .Int(_, _, _, _, _) -> Val("Int")
        .Bool(_, _, _) -> Val("Bool")
        .Char(_, _, _) -> Val("Char")
        .Str(_, _, _) -> Val("String")
        .EnumLit(type_name, _, _, _, _, _, _) -> Val("enum {type_name}")
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_genmod_literal_text: fn(value: Expr) -> String {
    if value == {
        .Int(number, _, _, _, _) -> "Int:{number}"
        .Bool(flag, _, _) -> if flag -> "Bool:true" else -> "Bool:false"
        .Char(text, _, _) -> "Char:{text}"
        .Str(_, _, _) -> "String:{sema_genmod_text(value) ?? ""}"
        .EnumLit(type_name, variant, _, _, _, _, _) -> "{type_name}.{variant}"
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> ""
    }
}

sema_genmod_literal_type: fn(value: Expr) -> Type? {
    if value == {
        .Int(_, _, _, _, _) -> Val(Type.Int)
        .Bool(_, _, _) -> Val(Type.Bool)
        .Char(_, _, _) -> Val(Type.Char)
        .Str(_, _, _) -> Val(Type.String)
        .EnumLit(type_name, _, _, _, _, _, _) -> Val(Type.Named{name: type_name})
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}
