use jet_foundation.[CtValue, Func, Diagnostic, GenericModuleDef, GenericModuleParam, Item, ModuleAliasDef, ModuleArg, Span, Type, canonical_ast_type_text]

// D-CONF-GENSPELL1=A: generic module instantiation checks (Rust
// `Bundle/GenericModules`). `module int_cache :: cache<Int>(32)` names a
// template, passes type and value arguments, and may chain through other
// aliases. Each alias is resolved in source order of its chain depth exactly
// like the Rust expansion pre-pass, so the same alias reports the same first
// problem: cycle (E0855), unsupported value parameter (E0856), alias-chain
// arguments or arity (E0851), unknown template (E0850), type argument kind or
// bound (E0852), value argument type (E0853) or a value that is not closed at
// compile time (E0857). Instantiating a template walks its nested modules and
// nested templates with the instance's arguments bound, like Rust's
// `expand_alias`.

pub enum SemaGenericModuleParam {
    Type(name: String, bound: String?)
    Value(name: String, ty: Type)
    Invalid
}


struct SemaGenericModuleCheck {
    module_identity: String
    diagnostics: [Diagnostic]
    seen: [String:Bool]
    context: SemaClosedValueContext
    input: SemaRegistrationModuleInput
    bound_graph: SemaRegistrationGraph?{None}
    functions: [Func]
    type_aliases: [String:Type]
    type_alias_names: [String]
    type_alias_targets: [Type]
}

struct SemaGenericModuleEdge {
    target: String
    span: Span
}

fn sema_genmod_new_check(module_identity: String, input: SemaRegistrationModuleInput, context: SemaClosedValueContext, functions: [Func]) -> SemaGenericModuleCheck {
    aliases := [String:Type]{}
    loop item in input.program.items {
        if item == .TypeAlias(definition) -> aliases[definition.name] = definition.target
    }
    names := [String]{}
    targets := [Type]{}
    loop (name, target) in aliases {
        &names.push(name)
        &targets.push(target)
    }
    SemaGenericModuleCheck{module_identity: module_identity, diagnostics: [Diagnostic]{}, seen: [String:Bool]{}, context: context, input: input, functions: functions, type_aliases: aliases, type_alias_names: names, type_alias_targets: targets}
}


fn sema_genmod_push(check: &SemaGenericModuleCheck, diagnostic: Diagnostic) {
    span :: diagnostic.span ?? Span{start: 0, end: 0}
    key :: "{diagnostic.code}|{span.start}|{span.end}|{diagnostic.what}"
    if check.seen.get(key) != None -> return
    check.seen[key] = true
    &check.diagnostics.push(diagnostic)
}

// Enum names declared by these items (and nested template bodies), each
// marked when every variant is fieldless: only those are Tier-0 values.
fn sema_genmod_enums(items: [Item], nested: [GenericModuleDef]) -> [String:Bool] {
    enums := [String:Bool]{}
    sema_genmod_collect_enums(items, &enums)
    loop definition in nested -> sema_genmod_collect_enums(definition.body, &enums)
    enums
}

fn sema_genmod_collect_enums(items: [Item], enums: &[String:Bool]) {
    loop item in items {
        if item == .Enum(definition) {
            fieldless := true
            loop variant in definition.variants {
                if variant.payload == {
                    .Unit -> {}
                    else -> fieldless = false
                }
            }
            enums[definition.name] = fieldless
        }
    }
}

// Constants evaluate in declaration order; each closed one is visible to
// later constants and to module arguments.
fn sema_genmod_const_values(items: [Item], inherited: [String:CtValue], check: &SemaGenericModuleCheck) -> [String:CtValue] {
    values := inherited
    loop item in items {
        if item == .Const(definition) {
            if sema_evaluate_closed_value(definition.value, check.functions, values, check.input, check.context) == .Ok(value) -> values[definition.name] = value
        }
    }
    values
}

fn sema_genmod_resolve_params(definition: GenericModuleDef, enums: [String:Bool], check: &SemaGenericModuleCheck) -> [SemaGenericModuleParam] {
    params := [SemaGenericModuleParam]{}
    loop param in definition.params {
        if param == {
            .Type(name, _, bound) -> {
                bound_name := String?{None}
                if bound == .Val(bound_type) {
                    if bound_type == .Named(trait_name) -> bound_name = Val(trait_name)
                }
                &params.push(SemaGenericModuleParam.Type{name: name, bound: bound_name})
            }
            .Value(name, name_span, ty) -> {
                if sema_genmod_tier0_type(ty, enums) {
                    &params.push(SemaGenericModuleParam.Value{name: name, ty: ty})
                } else {
                    sema_genmod_push(&check, sema_error("E0856", name_span, "generic module value parameter `{name}` uses unsupported type `{sema_genmod_type_text(ty)}`", "value parameters admit only Bool, Int, Char, String, or a fieldless enum", "use a Tier-0 value type, or make this an unannotated type parameter"))
                    &params.push(SemaGenericModuleParam.Invalid)
                }
            }
        }
    }
    params
}

fn sema_genmod_tier0_type(ty: Type, enums: [String:Bool]) -> Bool {
    if ty == {
        .Bool | .Int | .Char | .String -> true
        .Named(name) -> enums.get(name) ?? false
        else -> false
    }
}

// Rust `type_name`: the bare spelling of the Tier-0 and nominal types, and the
// structural form of anything else.
fn sema_genmod_type_text(ty: Type) -> String {
    if ty == {
        .Int -> "Int"
        .Bool -> "Bool"
        .Char -> "Char"
        .String -> "String"
        .Named(name) -> name
        .Apply(name, _) -> name
        else -> canonical_ast_type_text(ty)
    }
}


// Rust value_type: only exact Tier-0 values can bind module parameters.
fn sema_genmod_value_type(value: CtValue) -> Type? Never! {
    if value == {
        .Int(_) -> Val(Type.Int)
        .Bool(_) -> Val(Type.Bool)
        .Char(_) -> Val(Type.Char)
        .Str(_) -> Val(Type.String)
        .Enum(name, _, args) -> if args.len() == 0 -> Val(Type.Named{name: name}) else -> None
        else -> None
    }
}


fn sema_genmod_arg_span(arg: ModuleArg) -> Span {
    if arg == {
        .Type(_, span) -> span
        .Value(_, span) -> span
    }
}


// Stable depth buckets, with each alias edge traversed once. Forward
// applications retain source order without re-walking or insertion sorting.
fn sema_genmod_by_depth(aliases: [ModuleAliasDef], by_name: [String:ModuleAliasDef]) -> [ModuleAliasDef] {
    memo := [String:Int]{}
    depths := [Int]{}
    maximum := 0
    loop alias in aliases {
        current := alias.target
        chain := [String]{}
        loop memo.get(current) == None {
            parent :: by_name.get(current) ?? break
            &chain.push(current)
            current = parent.target
        }
        depth := memo.get(current) ?? -1
        loop chain.len() != 0 {
            name :: &chain.pop() ?? panic("nonempty alias chain")
            depth += 1
            memo[name] = depth
        }
        depth = if by_name.get(alias.target) == None -> 0 else -> (memo.get(alias.target) ?? panic("alias depth must be memoized")) + 1
        &depths.push(depth)
        if depth > maximum -> maximum = depth
    }
    buckets := [[ModuleAliasDef]]{}
    loop _ in 0..(maximum + 1) -> &buckets.push([ModuleAliasDef]{})
    loop (index, alias) in aliases -> &buckets[depths[index]].push(alias)
    ordered := [ModuleAliasDef]{}
    loop bucket in buckets {
        loop alias in bucket -> &ordered.push(alias)
    }
    ordered
}

fn sema_genmod_resolve_local(alias: ModuleAliasDef, aliases: [String:ModuleAliasDef], resolved: [String:ModuleAliasDef], check: &SemaGenericModuleCheck) -> ModuleAliasDef? {
    if aliases.get(alias.target) == None -> return Val(alias)
    if alias.args.len() != 0 {
        sema_genmod_push(&check, sema_error("E0851", alias.span, "module alias `{alias.name}` passes {alias.args.len()} argument(s) but alias `{alias.target}` expects 0", "an alias-to-alias link reuses an already-bound module instance", "remove the arguments and write `module {alias.name} :: {alias.target}`"))
        return None
    }
    terminal :: resolved.get(alias.target) ?? panic("depth-ordered alias has no resolved parent")
    updated := alias
    updated.target = terminal.target
    updated.target_span = terminal.target_span
    updated.args = terminal.args
    Val(updated)
}


// Module aliases and templates form one dependency graph per file; a cycle
// (E0855) stops every other generic-module check in that file.
fn sema_genmod_report_cycles(items: [Item], check: &SemaGenericModuleCheck) -> Bool {
    nodes := [String:[SemaGenericModuleEdge]]{}
    loop item in items {
        if item == {
            .ModuleAlias(alias) -> {
                edges := nodes.get(alias.name) ?? [SemaGenericModuleEdge]{}
                &edges.push(SemaGenericModuleEdge{target: alias.target, span: alias.target_span})
                nodes[alias.name] = edges
            }
            .GenericModule(definition) -> {
                edges := [SemaGenericModuleEdge]{}
                sema_genmod_collect_alias_edges(definition.body, &edges)
                nodes[definition.name] = edges
            }
            else -> {}
        }
    }
    if nodes.len() == 0 -> return false
    loop (name, edges) in nodes {
        ordered := edges
        &ordered.sort_by((left: SemaGenericModuleEdge, right: SemaGenericModuleEdge) -> left.target <=> right.target)
        nodes[name] = ordered
    }
    names := [String]{}
    loop (name, _) in nodes -> &names.push(name)
    &names.sort()
    state := [String:Int]{}
    stack := [String]{}
    reported := [String:Bool]{}
    loop name in names {
        if state.get(name) == None -> sema_genmod_visit(name, nodes, &state, &stack, &reported, &check)
    }
    reported.len() > 0
}

fn sema_genmod_collect_alias_edges(items: [Item], edges: &[SemaGenericModuleEdge]) {
    loop item in items {
        if item == {
            .ModuleAlias(alias) -> &edges.push(SemaGenericModuleEdge{target: alias.target, span: alias.target_span})
            .GenericModule(definition) -> sema_genmod_collect_alias_edges(definition.body, &edges)
            else -> {}
        }
    }
}


fn sema_genmod_visit(node: String, nodes: [String:[SemaGenericModuleEdge]], state: &[String:Int], stack: &[String], reported: &[String:Bool], check: &SemaGenericModuleCheck) {
    state[node] = 1
    &stack.push(node)
    if nodes.get(node) == .Val(edges) {
        loop edge in edges {
            if nodes.get(edge.target) == None -> next
            visited :: state.get(edge.target) ?? 0
            if visited == 0 {
                sema_genmod_visit(edge.target, nodes, &state, &stack, &reported, &check)
            } else if visited == 1 {
                start := 0
                loop (index, name) in stack {
                    if name == edge.target {
                        start = index
                        break
                    }
                }
                chain := [String]{}
                loop index in start..<stack.len() -> &chain.push(stack[index])
                &chain.push(edge.target)
                text :: chain.join(" -> ")
                if reported.get(text) == None {
                    reported[text] = true
                    sema_genmod_push(&check, sema_error("E0855", edge.span, "generic module instantiation forms a cycle: {text}", "module aliases must form an acyclic dependency graph so specialization reaches one stable result", "break the cycle: {text}"))
                }
            }
        }
    }
    _ := &stack.pop()
    state[node] = 2
}


fn sema_genmod_nominal_name(item: Item) -> String {
    if item == {
        .Struct(definition) -> definition.name
        .Enum(definition) -> definition.name
        .Trait(definition) -> definition.name
        .Tag(definition) -> definition.name
        else -> ""
    }
}

// Rust `module_value_name`.
fn sema_genmod_value_name(alias: String, name: String) -> String {
    bytes :: alias.bytes()
    end := bytes.len()
    loop end > 0 && Int.from_u8(bytes[end - 1]) == 95 {
        end -= 1
    }
    trimmed :: String.from_bytes(bytes[0..<end]) ?? ~alias
    "{trimmed}_{sema_inline_trim_leading_underscores(name)}"
}


// Rust resolved_argument_value's Tier-0 CtValue::jet_show projection. This is
// display metadata, never an identity/JSON serializer.
fn sema_genmod_value_show(value: CtValue) -> String Never! {
    if value == {
        .Int(number) -> "{number}"
        .Bool(flag) -> "{flag}"
        .Char(character) -> "{character}"
        .Str(text) -> text
        .Enum(type_name, variant, args) -> {
            if args.len() != 0 -> panic("module value must remain fieldless")
            if type_name == "Loadable" && (variant == "Idle" || variant == "Loading") -> variant else -> "__jet_{variant}"
        }
        else -> panic("resolved module value must remain Tier-0")
    }
}


