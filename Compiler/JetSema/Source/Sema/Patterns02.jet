//RS     /// Binding a non-copy payload out of a pattern gives the subject away in
//RS     /// the generated Rust (`if let` / `matches!` move the place), so the old
//RS     /// name must stop being usable — otherwise rustc rejects the output (I2).
//RS     pub(crate) fn mark_pattern_subject_moved(
//RS         &mut self,
//RS         subject: &Expr,
//RS         bindings: &HashMap<String, Type>,
//RS     ) {
//RS         if bindings.values().all(type_is_copy) {
//RS             return;
//RS         }
//RS         // D-OPT-WRITE1 (#3974): a `&place` subject binds write windows into
//RS         // its payload; the owner keeps its value.
//RS         if crate::Sema::CheckerCore::is_write_window_subject(subject) {
//RS             return;
//RS         }
//RS         if let Expr::Ident(name, _) = subject {
//RS             // A borrowed parameter's payload binds as a read view of that
//RS             // parameter, exactly like a projected subject `param.field`; the
//RS             // subject stays usable and nothing is copied.
//RS             if self.is_borrowed_binding(name) {
//RS                 return;
//RS             }
//RS         }
//RS         if self.transfer_mutable_pattern_subject(subject) {
//RS             return;
//RS         }
//RS         if let Expr::Ident(n, nspan) = subject {
//RS             if n != Syntax::KW_IT && self.lookup(n).is_some() {
//RS                 self.mark_moved(n.clone(), *nspan, "the pattern match");
//RS             }
//RS         }
//RS     }
//RS 
//RS     /// D-PARSESTR1 (shared with D-SHIFT1's `take_pattern` — I8, one hole-type
//RS     /// rule, not two): the bound type of a str-match pattern hole. `None`
//RS     /// binds `String`; a typed hole must be an integer carrier (`Int` or an
//RS     /// inline range), `Float`, `Bool`, or `String` — the types that can read
//RS     /// out of matched text — else E0305.
//RS     pub(crate) fn str_match_hole_type(
//RS         &mut self,
//RS         name: &str,
//RS         ty: &Option<Type>,
//RS         hole_span: Span,
//RS     ) -> Type {
//RS         match ty {
//RS             None => Type::String,
//RS             Some(
//RS                 t
//RS                 @ (Type::Int | Type::Float | Type::Bool | Type::String | Type::InlineRange { .. }),
//RS             ) => t.clone(),
//RS             Some(other) => {
//RS                 self.diags.push(Diagnostic::error(
//RS                     "E0305",
//RS                     format!(
//RS                         "`{{{}:{}}}` can't read text as {} — only an integer carrier, `Float`, `Bool`, or `String` can come out of a pattern hole",
//RS                         name,
//RS                         other.show(),
//RS                         other.show()
//RS                     ),
//RS                     "a typed hole reads the matched text into that type, and only these four types know how to read text".to_string(),
//RS                     "use `Int`, an inline integer range, `Float`, `Bool`, or `String`, or drop the type to bind `String`".to_string(),
//RS                     Some(hole_span),
//RS                 ));
//RS                 Type::String
//RS             }
//RS         }
//RS     }
//RS 
//RS     /// D-BINPAT1 (shared with card #506 follow-up's `take_pattern` — I8, one
//RS     /// hole-type rule, not two): walk a binary pattern's parts, folding the
//RS     /// running bit offset and pushing alignment/endian diagnostics (E1008,
//RS     /// E1011), and return the ORDERED `(name, Type)` list for every hole
//RS     /// (literal parts contribute no entry). Order matches source order —
//RS     /// `validate_pattern`'s arm-head bindings collect this into a
//RS     /// name-keyed `HashMap` (binding order doesn't matter for a switch arm);
//RS     /// `take_pattern` needs the order preserved, since it becomes a
//RS     /// canonical result tuple, so it keeps the `Vec` as-is.
//RS     pub(crate) fn bin_match_hole_types(
//RS         &mut self,
//RS         parts: &[crate::AST::BinMatchPart],
//RS         span: Span,
//RS     ) -> Vec<(String, Type)> {
//RS         let mut off: usize = 0;
//RS         let mut holes: Vec<(String, Type)> = Vec::new();
//RS         for part in parts {
//RS             match part {
//RS                 crate::AST::BinMatchPart::Lit(bytes) => {
//RS                     if off % 8 != 0 {
//RS                         self.diags.push(self.bin_align_diag(span));
//RS                     }
//RS                     off += bytes.len() * 8;
//RS                 }
//RS                 crate::AST::BinMatchPart::Hole {
//RS                     name,
//RS                     spec,
//RS                     span: hole_span,
//RS                 } => match spec {
//RS                     crate::AST::BinSpec::Rest => {
//RS                         if off % 8 != 0 {
//RS                             self.diags.push(self.bin_align_diag(*hole_span));
//RS                         }
//RS                         holes.push((
//RS                             name.clone(),
//RS                             Type::List(Box::new(Type::IntN {
//RS                                 signed: false,
//RS                                 bits: 8,
//RS                             })),
//RS                         ));
//RS                     }
//RS                     crate::AST::BinSpec::Bits { width, endian } => {
//RS                         if matches!(endian, crate::AST::BinEndian::Little) && *width % 8 != 0 {
//RS                             self.diags.push(Diagnostic::error(
//RS                                     "E1008",
//RS                                     format!(
//RS                                         "a little-endian read `U{width}le` must be a whole number of bytes"
//RS                                     ),
//RS                                     "byte order only reorders whole bytes, so a `le` read's width must be a multiple of 8"
//RS                                         .to_string(),
//RS                                     "use a multiple-of-8 width (`U16le`, `U32le`) or big-endian `be`".to_string(),
//RS                                     Some(*hole_span),
//RS                                 ));
//RS                         }
//RS                         holes.push((name.clone(), bin_bits_type(*width)));
//RS                         off += *width as usize;
//RS                     }
//RS                 },
//RS             }
//RS         }
//RS         holes
//RS     }
//RS 
//RS     /// D-BINPAT1: a fixed byte literal or a rest capture must start on a byte
//RS     /// boundary — the preceding bit-typed holes must sum to a multiple of 8.
//RS     fn bin_align_diag(&self, span: Span) -> Diagnostic {
//RS         Diagnostic::error(
//RS             "E1011",
//RS             "this part of the binary pattern doesn't start on a byte boundary".to_string(),
//RS             "fixed bytes and a `{rest:...}` capture are read whole-byte, so every bit-field before them must add up to a multiple of 8 bits"
//RS                 .to_string(),
//RS             "pad the preceding holes to a byte boundary (e.g. add a reserved `{_:U4}`)".to_string(),
//RS             Some(span),
//RS         )
//RS     }
