    // Rust: crates/jet-sema/src/Sema/CheckerItems.rs:3597
    pub fn check_enum_lit(self: &Self, type_name: String, variant: String, args: &[EnumLitArg], span: Span, variant_span: Span?) -> Type Never! {
        &self.warn_deprecated_type_name(type_name, span)
        &self.record_type_import_name_use(type_name)
        contextual_ty :: self.expected_type.filter(fn(ty) { if ty == { .Apply(name, _) -> name == type_name; else -> false } })
        ty :: contextual_ty ?? Type.Named(if self.member_imported_type(type_name) { self.imported_nominal_head(type_name) } else { type_name })
        display_type_name :: self.display_type_name(type_name, None)
        variants :: self.resolve_enum_variants_cloned(type_name) ?? {
            &self.diags.push(Diagnostic.error("E0119", "there's no enum called `{display_type_name}`", "enum literals need an enum type name", "define the enum first, or check the spelling", Val(span)))
            loop a in &args {
                if a == { .Positional(e) | .Named(_, e) -> _ :: &self.infer(&e) }
            }
            return ty
        }
        (_, payload) :: variants.get(variant) ?? {
            if self.resolve_enum_groups_cloned(type_name).and_then(fn(g) { g.get(variant) }) == .Val((_, leaves)) {
                leaf_text :: leaves.map(fn(l) { "`{display_type_name}.{l}`" }).to_array().join(", ")
                &self.diags.push(Diagnostic.error("E0332", "`{variant}` is a group, not a value", "a group names its whole subtree in patterns; an actual value is always a leaf variant (D-TAG1)", "pick a leaf: {leaf_text}", Val(span)))
            } else {
                suggestion :: suggest_field(variant, variants.keys().to_array())
                fix :: suggestion.map(fn(s) { "did you mean `{s}`?" }) ?? "check the variant name"
                diagnostic := Diagnostic.error("E0304", "`{display_type_name}` has no variant `{variant}`", "enum literals must name a variant on the type", fix, Val(span))
                if (suggestion, variant_span) == (.Val(candidate), .Val(edit_span)) -> diagnostic = diagnostic.with_edit(TextEdit{span: edit_span, new_text: candidate})
                &self.diags.push(^diagnostic)
            }
            loop a in &args {
                if a == { .Positional(e) | .Named(_, e) -> _ :: &self.infer(&e) }
            }
            return ty
        }
        if payload == {
            .Unit -> {
                if !args.is_empty() -> &self.diags.push(Diagnostic.error("E0303", "variant `{variant}` takes no payload", "unit variants are written without parentheses", "write `{display_type_name}.{variant}` with no `(...)`", Val(span)))
            }
            .Single(declared, _) -> {
                contextual_payload :: if (contextual_ty, type_name, variant) == {
                    (.Val(.Apply(_, params)), "HookDecision" | "HookOutcome", "Transform" | "Continue") -> params.first()
                    (.Val(.Apply(_, params)), "HookDecision" | "HookOutcome", "Fail") -> params.get(1)
                    else -> None
                }
                expected :: contextual_payload ?? declared
                if args.len() != 1 -> &self.diags.push(Diagnostic.error("E0303", "variant `{variant}` expects one value", "single-payload variants take one positional argument (S30)", "write `{display_type_name}.{variant}(...)", Val(span)))
                if !args.is_empty() {
                    if args[0] == {
                        .Positional(e) -> {
                            et :: &self.infer_with_expected(&e, expected)
                            if et == .Val(et) {
                                if contextual_payload != None && et != expected -> &self.diags.push(Diagnostic.error("E0108", "`{display_type_name}.{variant}` needs {expected.show()}, not {et.show()}", "the decision payload must match the hook's declared payload or error type", type_fix_hint(expected, et), Val(e.span())))
                                else -> &self.check_enum_payload_assignable(type_name, variant, None, expected, et, e)
                            }
                            &self.clone_borrowed_struct_field_value(None, &e, et)
                        }
                        .Named(label, _) -> &self.diags.push(Diagnostic.error("E0303", "variant `{variant}` expects a positional value, not `{label}:`", "single-payload variants use positional args only (S30)", "write `{display_type_name}.{variant}(value)", Val(span)))
                    }
                }
            }
            .Named(fields) -> {
                seen := [String:Bool]{}
                loop a in &args {
                    if a == {
                        .Positional(_) -> &self.diags.push(Diagnostic.error("E0303", "variant `{variant}` requires labeled fields", "named-payload variants construct with the dot-brace form (D-UITREE1/D-DOTCTOR1), matching struct construction", "write `{display_type_name}.{variant}.{{ w: 1.0, h: 2.0 }}`", Val(span)))
                        .Named(label, expr) -> {
                            if seen.contains_key(label) -> &self.diags.push(Diagnostic.error("E0303", "field `{label}` appears more than once", "each payload field may be written only once", "remove the duplicate label", Val(expr.span())))
                            seen[label] = true
                            field :: fields.find(fn(f) { f.name == label })
                            expected_for_child :: field.map(fn(f) { f.ty })
                            et :: if expected_for_child == .Val(expected) { &self.infer_with_expected(&expr, expected) } else { &self.infer(&expr) }
                            &self.clone_borrowed_struct_field_value(None, &expr, et)
                            if field == .Val(f) {
                                if et == .Val(et) -> &self.check_enum_payload_assignable(type_name, variant, Val(label), f.ty, et, expr)
                            } else {
                                fix :: suggest_field(label, fields.map(fn(f) { f.name }).to_array()).map(fn(s) { "did you mean `{s}`?" }) ?? "remove this label"
                                &self.diags.push(Diagnostic.error("E0302", "variant `{variant}` has no field `{label}`", "check the field names on this variant", fix, Val(expr.span())))
                            }
                        }
                    }
                }
                missing :: fields.filter(fn(f) { !seen.contains_key(f.name) }).map(fn(f) { f.name }).to_array()
                if !missing.is_empty() -> &self.diags.push(Diagnostic.error("E0303", "variant `{variant}` is missing fields: {missing.join(", ")}", "every payload field must appear exactly once", "add: {missing.join(", ")}", Val(span)))
            }
        }
        ty
    }
    // Rust: crates/jet-sema/src/Sema/CheckerItems.rs:3861
    pub fn eq_unit_variant_pattern(self: &Self, lhs: Expr, rhs: Expr, subject_name: String?, subj_ty: Type) -> Pattern? Never! {
        if !subject_name.is_some_and(fn(n) { expr_is_same_ident(lhs, n) }) -> return None
        if rhs != .Ident -> return None
        if rhs == .Ident(variant, rhs_span) {
            if self.lookup(variant) != None || self.consts.contains_key(variant) -> return None
            enum_name :: if subj_ty == { .Named(name) | .Apply(name, _) -> name; else -> return None }
            variant_known :: self.resolve_enum_variants_cloned(enum_name).is_some_and(fn(variants) { variants.contains_key(variant) }) || self.resolve_enum_groups_cloned(enum_name).is_some_and(fn(groups) { groups.contains_key(variant) })
            if !variant_known -> return None
            &self.diags.push(Diagnostic.error("E0367", "pattern `{variant}` needs a leading `.`", "match patterns take a leading dot so the name isn't read as a variable or call (D-ENUMDOT1)", "write `.{variant}`", Val(rhs_span)))
            return Val(Pattern.Variant(variant, [], false, rhs_span))
        }
        None
    }
    // Rust: crates/jet-sema/src/Sema/CheckerItems.rs:3909
    pub fn switch_arm_pattern(self: &Self, cond: Expr, subject_name: String?, subj_ty: Type) -> Pattern? Never! {
        if cond == {
            .PatternTest(_, .StrMatch, _) | .PatternTest(_, .BinMatch, _) -> None
            .PatternTest(subject, pattern, _) -> if subject_name.is_some_and(fn(n) { expr_is_same_ident(subject, n) }) { Val(pattern) } else { None }
            .Binary(.Eq, lhs, rhs, _) -> &self.eq_unit_variant_pattern(lhs, rhs, subject_name, subj_ty)
            .Ident(variant, span) -> {
                if subject_name == None -> return None
                enum_name :: if subj_ty == { .Named(name) | .Apply(name, _) -> name; else -> return None }
                variants :: self.resolve_enum_variants_cloned(enum_name) ?? return None
                is_group :: self.resolve_enum_groups_cloned(enum_name).is_some_and(fn(g) { g.contains_key(variant) })
                if !is_group {
                    (_, payload) :: variants.get(variant) ?? return None
                    if payload != .Unit -> return None
                }
                if self.lookup(variant) != None -> return None
                &self.diags.push(Diagnostic.error("E0367", "pattern `{variant}` needs a leading `.`", "match patterns take a leading dot so the name isn't read as a variable or call (D-ENUMDOT1)", "write `.{variant}`", Val(span)))
                Val(Pattern.Variant(variant, [], false, span))
            }
            .Call(call) -> {
                if subject_name == None || call.args.len() != 1 -> return None
                if call.args[0].expr != .Ident -> return None
                if call.args[0].expr == .Ident(binding, binding_span) {
                    if self.lookup(binding) != None -> return None
                    enum_name :: if subj_ty == {
                        .Named(name) | .Apply(name, _) -> name
                        .Union(members) -> {
                            if !members.any(fn(m) { union_member_tag(m) == call.name }) -> return None
                            &self.diags.push(Diagnostic.error("E0367", "pattern `{call.name}` needs a leading `.`", "match patterns take a leading dot so the name isn't read as a variable or call (D-ENUMDOT1)", "write `.{call.name}(…)`", Val(call.name_span)))
                            return Val(Pattern.Variant(call.name, [PatSlot.Bind(binding, binding_span)], false, call.name_span))
                        }
                        else -> return None
                    }
                    variants :: self.resolve_enum_variants_cloned(enum_name) ?? return None
                    (_, payload) :: variants.get(call.name) ?? return None
                    if payload != .Single -> return None
                    &self.diags.push(Diagnostic.error("E0367", "pattern `{call.name}` needs a leading `.`", "match patterns take a leading dot so the name isn't read as a variable or call (D-ENUMDOT1)", "write `.{call.name}(…)`", Val(call.name_span)))
                    return Val(Pattern.Variant(call.name, [PatSlot.Bind(binding, binding_span)], false, call.name_span))
                }
                None
            }
            else -> None
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerItems.rs:4040
    pub fn check_pattern_test(self: &Self, subject: &Expr, pattern: &Pattern, span: Span) -> [String:Type] Never! {
        (&self.check_pattern_test_typed(&subject, &pattern, span)).1
    }
    // Rust: crates/jet-sema/src/Sema/CheckerItems.rs:4053
    pub fn check_pattern_test_typed(self: &Self, subject: &Expr, pattern: &Pattern, span: Span) -> (Type?, [String:Type]) Never! {
        preserve_result_carrier :: pattern_consumes_result_carrier(pattern) || (names_optional_state(pattern) && self.carrier_chain_subjects.contains(subject.span().start))
        use_subject_cache :: preserve_result_carrier && !self.compiler_generated
        subject_key :: subject.span().start
        cached_subject :: if use_subject_cache { self.result_handler_subject_types.get(subject_key) } else { None }
        if cached_subject == .Val((_, typed_subject)) -> subject = typed_subject.clone()
        cached_subject_ty :: cached_subject.map(fn(pair) { pair.0 })
        if preserve_result_carrier && cached_subject_ty == None -> self.failure_auto_depth += 1
        saved_subject_expected :: self.expected_type
        if !preserve_result_carrier && saved_subject_expected == .Val(.Result) -> self.expected_type = None
        stable_optional_subject :: if pattern_needs_stable_optional_carrier(pattern) && subject == .Ident(name, _) {
            self.flow.bindings.get(name).and_then(fn(info) { if info.ty == .Option { Val(info.ty) } else { None } })
        } else { None }
        subj_ty := cached_subject_ty.or_else(fn() {
            inferred :: if stable_optional_subject == .Val(stable) {
                _ :: &self.infer(&subject)
                Val(stable)
            } else if preserve_result_carrier { &self.infer_without_auto_propagation(&subject) } else { &self.infer(&subject) }
            if use_subject_cache && inferred == .Val(ty) -> self.result_handler_subject_types[subject_key] = (ty, subject.clone())
            inferred
        })
        self.expected_type = saved_subject_expected
        if preserve_result_carrier && cached_subject_ty == None -> self.failure_auto_depth -= 1
        if preserve_result_carrier && subj_ty.is_some_and(fn(ty) { if ty == { .Result(_, err) -> !self.is_error_domain(err); else -> false } }) -> subj_ty = &self.infer(&subject)
        st :: subj_ty ?? return (None, [:])
        &self.normalize_pattern_tree(&pattern, st)
        bindings :: &self.validate_pattern(st, pattern, span)
        if cached_subject_ty == None && pattern != .Struct -> &self.mark_pattern_subject_moved(subject, bindings)
        (Val(st), ^bindings)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerItems.rs:4159
    pub fn mark_pattern_subject_moved(self: &Self, subject: Expr, bindings: [String:Type]) Never! {
        if bindings.values().all(type_is_copy) || is_write_window_subject(subject) -> return
        if subject == .Ident(name, _) && self.is_borrowed_binding(name) -> return
        if &self.transfer_mutable_pattern_subject(subject) -> return
        if subject == .Ident(n, nspan) && n != Syntax.KW_IT && self.lookup(n) != None -> &self.mark_moved(n, nspan, "the pattern match")
    }
    // Rust: crates/jet-sema/src/Sema/CheckerItems.rs:4195
    pub fn str_match_hole_type(self: &Self, name: String, ty: Type?, hole_span: Span) -> Type Never! {
        if ty == {
            .None -> Type.String
            .Val(t) -> if t == {
                .Int | .Float | .Bool | .String | .InlineRange -> t
                other -> {
                    &self.diags.push(Diagnostic.error("E0305", "`{{{name}:{other.show()}}}` can't read text as {other.show()} — only an integer carrier, `Float`, `Bool`, or `String` can come out of a pattern hole", "a typed hole reads the matched text into that type, and only these four types know how to read text", "use `Int`, an inline integer range, `Float`, `Bool`, or `String`, or drop the type to bind `String`", Val(hole_span)))
                    Type.String
                }
            }
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerItems.rs:4234
    pub fn bin_match_hole_types(self: &Self, parts: [BinMatchPart], span: Span) -> [(String, Type)] Never! {
        off := 0
        holes := [(String, Type)]{}
        loop part in parts {
            if part == {
                .Lit(bytes) -> {
                    if off % 8 != 0 -> &self.diags.push(self.bin_align_diag(span))
                    off += bytes.len() * 8
                }
                .Hole(name, spec, hole_span) -> if spec == {
                    .Rest -> {
                        if off % 8 != 0 -> &self.diags.push(self.bin_align_diag(hole_span))
                        &holes.push((name, Type.List(Type.IntN(false, 8))))
                    }
                    .Bits(width, endian) -> {
                        if endian == BinEndian.Little && width % 8 != 0 -> &self.diags.push(Diagnostic.error("E1008", "a little-endian read `U{width}le` must be a whole number of bytes", "byte order only reorders whole bytes, so a `le` read's width must be a multiple of 8", "use a multiple-of-8 width (`U16le`, `U32le`) or big-endian `be`", Val(hole_span)))
                        &holes.push((name, bin_bits_type(width)))
                        off += Int{width}
                    }
                }
            }
        }
        ^holes
    }
    // Rust: crates/jet-sema/src/Sema/CheckerItems.rs:4290
    fn bin_align_diag(self, span: Span) -> Diagnostic Never! {
        Diagnostic.error("E1011", "this part of the binary pattern doesn't start on a byte boundary", "fixed bytes and a `{rest:...}` capture are read whole-byte, so every bit-field before them must add up to a multiple of 8 bits", "pad the preceding holes to a byte boundary (e.g. add a reserved `{_:U4}`)", Val(span))
    }
    // Rust: crates/jet-sema/src/Sema/CheckerItems.rs:4301
    pub fn validate_pattern(self: &Self, subject_ty: Type, pattern: Pattern, span: Span) -> [String:Type] Never! {
        if (subject_ty, pattern) == {
            (.Option(payload), .Present(_, .Val(inner), _)) | (.Result(payload, _), .Ok(_, .Val(inner), _)) | (.Result(_, payload), .Err(_, .Val(inner), _)) -> &self.validate_pattern(payload, inner, inner.span())
            (.Option(inner), .Present(binding, _, _)) -> [binding: inner]
            (.Option(_), .Absent(_)) -> [:]
            (.Result(ok, _), .Ok(binding, _, _)) -> [binding: ok]
            (.Result(_, err), .Err(binding, _, _)) -> [binding: err]
            (.Result, .Present | .Absent) -> {
                &self.diags.push(Diagnostic.error("E0305", "this pattern belongs to an optional value, not {subject_ty.name()}", "use `== .Ok(...)` or `== .Err(...)` on a fallible result", "write `== .{Syntax.LIT_OK}(...)` or `== .{Syntax.LIT_ERR}(...)` instead", Val(span)))
                [:]
            }
            (.Union(members), .Variant(variant, bindings, _, _)) -> {
                member_ty :: members.find(fn(m) { union_member_tag(m) == variant }) ?? {
                    member_names :: members.map(union_member_tag).to_array().join(", ")
                    &self.diags.push(Diagnostic.error("E0305", "pattern `{variant}` doesn't belong to `{subject_ty.name()}`", "union match arms name a member type of the subject's union", "members are {member_names}", Val(span)))
                    return [:]
                }
