                if bindings.first() == { .Val(.Bind(name, _)) -> [name: member_ty]; .Val(.Nested(inner)) -> &self.validate_pattern(member_ty, inner, inner.span()); else -> [:] }
            }
            (.Named(type_name) | .Apply(type_name, _), .Struct(fields, rest, _)) -> {
                (import_ns, lookup_name) :: self.struct_type_name_parts(type_name)
                owner_mod :: self.struct_owner_module(lookup_name, import_ns)
                display_type_name :: owner_mod.map(fn(owner) { self.display_type_name(type_name, Val(owner)) }) ?? self.display_type_name(type_name, None)
                all_fields :: owner_mod.and_then(fn(m) { self.struct_fields_of(m, lookup_name) }).map(fn(fs) { fs.map(fn(f) { f.0 }).to_array() }) ?? {
                    &self.diags.push(Diagnostic.error("E0313", "`{ … }` can only match a struct value, but this is {subject_ty.show()}", "a struct pattern reads named fields from a struct value", "match a struct value, or use an enum/optional pattern instead", Val(span)))
                    return [:]
                }
                named := [String:Bool]{}
                result := [String:Type]{}
                loop f in fields {
                    field_name :: f.field_name()
                    named[field_name] = true
                    fty :: &self.field_type(subject_ty, field_name, f.field_span()) ?? Type.Int
                    if f == {
                        .Bind(_, _, local, _) -> result[local] = fty
                        .Value(_, _, value) -> {
                            value := value.clone()
                            saved_expected :: self.expected_type
                            self.expected_type = Val(fty)
                            got :: &self.infer(&value)
                            self.expected_type = saved_expected
                            if got == .Val(got) {
                                reported :: &self.check_type_assignable(fty, got, value.span())
                                if !reported && got != fty -> &self.diags.push(Diagnostic.error("E0108", "field `{field_name}` is {fty.show()}, but this pattern value is {got.show()}", "a field pattern value must have the field's type", type_fix_hint(fty, got), Val(value.span())))
                            }
                        }
