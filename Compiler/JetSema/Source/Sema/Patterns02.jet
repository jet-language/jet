    }
    // Rust: crates/jet-sema/src/Sema/CheckerItems.rs:4995
    pub fn check_panic_call(self: &Self, call: &Call) Never! {
        self.fx_edges["__jet_panic__"] = true
        &self.record_effect(Effect.Panic.name(), call.name_span)
        safe_panic_context :: self.autodiff_safe_panic_context
        if safe_panic_context { self.fx_autodiff_safe_panic = true } else { self.fx_autodiff_unsafe_panic = true }
        self.autodiff_safe_panic_context = false
        if call.args.len() != 1 -> &self.diags.push(Diagnostic.error("E0103", "`{Syntax.BUILTIN_PANIC}` needs exactly one message", "a panic report needs something to show the user", "e.g. {Syntax.BUILTIN_PANIC}(\"something went wrong\")", Val(call.name_span)))
        loop arg in &call.args {
            self.borrow_ctx = true
            if &self.infer(&arg.expr) == .Val(t) && t != Type.String -> &self.diags.push(Diagnostic.error("E0112", "`{Syntax.BUILTIN_PANIC}` needs text, but this is {t.show()}", "the panic message is shown to the user as text", "put the message in quotes", Val(arg.expr.span())))
        }
        self.autodiff_safe_panic_context = safe_panic_context
    }
    // Rust: crates/jet-sema/src/Sema/CheckerItems.rs:5043
    pub fn check_assert_call(self: &Self, call: &Call) Never! {
        if call.args.is_empty() || call.args.len() > 2 -> &self.diags.push(Diagnostic.error("E0103", "`{Syntax.BUILTIN_ASSERT}` needs one condition, or a condition and a message", "assert checks a yes/no condition and stops when it's false", "e.g. {Syntax.BUILTIN_ASSERT}(x > 0) or {Syntax.BUILTIN_ASSERT}(x > 0, \"x must be positive\")", Val(call.name_span)))
        if !call.args.is_empty() {
            arg :: &call.args[0]
            if &self.infer(&arg.expr) == .Val(t) && t != Type.Bool -> &self.diags.push(Diagnostic.error("E0110", "`{Syntax.BUILTIN_ASSERT}` needs {Type.Bool.show()}, but this is {t.show()}", "the condition must be true or false", "compare values first, e.g. `x > 0`", Val(arg.expr.span())))
        }
        if call.args.len() > 1 {
            arg :: &call.args[1]
            if &self.infer(&arg.expr) == .Val(t) && t != Type.String -> &self.diags.push(Diagnostic.error("E0112", "`{Syntax.BUILTIN_ASSERT}` message must be text, but this is {t.show()}", "the optional message is shown when the condition is false", "put the message in quotes", Val(arg.expr.span())))
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerItems.rs:5099
    pub fn check_assert_eq_call(self: &Self, call: &Call) Never! {
        if call.args.len() != 2 {
            &self.diags.push(Diagnostic.error("E0104", "`{Syntax.BUILTIN_ASSERT_EQ}` needs exactly two values to compare", "assert_eq checks that two values are equal", "e.g. {Syntax.BUILTIN_ASSERT_EQ}(got, expected)", Val(call.name_span)))
            loop arg in &call.args -> _ :: &self.infer(&arg.expr)
            return
        }
        self.borrow_ctx = true
        lt :: &self.infer(&call.args[0].expr)
        self.borrow_ctx = true
        rt :: if lt == .Val(expected) && expr_wants_expected_type(call.args[1].expr) { &self.infer_with_expected(&call.args[1].expr, expected) } else { &self.infer(&call.args[1].expr) }
        if (lt, rt) == (.Val(lt), .Val(rt)) {
            if lt != rt -> &self.diags.push(Diagnostic.error("E0108", "`{Syntax.BUILTIN_ASSERT_EQ}` compared {lt.show()} and {rt.show()}, which don't match", "both sides must be the same type to compare them", "convert one side, or compare fields that have the same type", Val(call.name_span)))
