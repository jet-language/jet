//RS         // fallible call as `T !E` here; ordinary value positions unwrap the
//RS         // same call through the existing automatic propagation rule. This
//RS         // includes contextual `.Ok` / `.Err` syntax before normalization.
//RS         // D-OUTCOME-SHAPE1=A: a `.Val`/`.None` level of a value chain that
//RS         // also handles `.Err` tests the same `T? E!` carrier.
//RS         let preserve_result_carrier = super::CheckerCore::pattern_consumes_result_carrier(pattern)
//RS             || (super::CheckerCore::names_optional_state(pattern)
//RS                 && self.carrier_chain_subjects.contains(&subject.span().start));
//RS         // Source spans are the diagnostic anchor, not an AST identity. Compiler
//RS         // generated codec/derive bodies intentionally stamp every synthetic
//RS         // node with one declaration span, so a span-only cache would let one
//RS         // `Result<Int, E>` subject answer a later `Result<String, E>` subject.
//RS         // Those bodies are fully typed by their explicit generated signatures;
//RS         // infer each carrier subject directly instead of reusing that ambiguous
//RS         // key. User source keeps the cache for the existing single-inference
//RS         // behavior.
//RS         let use_subject_cache = preserve_result_carrier && !self.compiler_generated;
//RS         let subject_key = subject.span().start;
//RS         let cached_subject = use_subject_cache
