//RS         | Type::Float32
//RS         | Type::IntN { .. }
//RS         | Type::InlineRange { .. } => true,
//RS         Type::List(inner) | Type::Option(inner) => property_param_generatable(inner),
//RS         Type::FixedList { elem, .. } => property_param_generatable(elem),
//RS         _ => false,
//RS     }
//RS }
