// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:3
pub fn merge_view_provenance(into: &ViewProvenanceMap, from: &ViewProvenanceMap) -> Bool {
    if into.len() != from.len() || !into.keys().all(fn(path) { from.contains_key(path) }) -> return false
    for (path, candidate) in from {
        existing := into.get_mut(path).expect("view paths were checked above")
        if existing.mutable != candidate.mutable -> return false
        existing.sources.extend(candidate.sources.iter().cloned())
    }
    true
}

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:21
pub fn checker_for_module(
    module_idx: USize, states: &[ModuleState], plugin_interfaces: &PluginInterfaceRegistry,
    devtools_registry: &DevtoolsRegistry, effect_facts: &FactRegistry,
    ct_funcs: &[String: Func], ct_checked_funcs: &[String: Func], ct_items: &[Item],
    ct_externs: &HashSet<String>, ct_base_dir: &OSPath, ct_globals: &[String: CtValue],
    no_os: Bool, gates: GateSet, no_prelude: Bool, name_ledger: &NameLedger,
    function: &Func?, raw_protocol_return: Bool, defer_ct_evaluation: Bool
) -> Checker {
    st :: &states[module_idx]
    current_function_span :: function.map_or_else(fn() { Span.new(0, 0) }, fn(f) { f.span })
    in_unsafe :: function.is_some_and(fn(f) { f.is_unsafe })
    in_pure :: function.is_some_and(fn(f) { f.is_pure || f.is_comptime })
    in_comptime :: function.is_some_and(fn(f) { f.is_comptime })
    compiler_api_allowed :: function.is_some_and(fn(f) { st.allow_compiler_api && is_build_entry(f) })
    ret :: function.and_then(fn(f) { checked_body_return_type(f, raw_protocol_return) })
    fn_name :: function.map_or_else(fn() { "" }, fn(f) { f.name.clone() })
    compiler_generated :: function.is_some_and(fn(f) { f.compiler_generated })
    declared_return_type :: function.and_then(fn(f) { f.return_type.clone() })
    current_return_type_span :: function.and_then(fn(f) { f.return_type_span })
    current_param_names :: function.map(fn(f) { f.params.iter().filter(fn(p) { p.name != Syntax.KW_SELF }).map(fn(p) { p.name.clone() }).collect() }).unwrap_or_default()
    type_param_scope :: function.map(fn(f) { f.type_params.clone() }).unwrap_or_default()
    Checker{
        funcs: &st.funcs,
        diverging_functions: &st.diverging_functions,
        fixed_length_write_params: &st.fixed_length_write_params,
        plugin_interfaces: plugin_interfaces,
        registry: &st.registry,
        devtools_registry: devtools_registry,
        effect_facts: effect_facts,
        consts: &st.consts,
        modules: Val(states),
        nominal_owner_cache: RefCell.new([:]),
        items: &st.items,
        module_idx: module_idx,
        imports: &st.imports,
        core_imports: &st.core_imports,
        code_modules: &st.code_modules,
        code_module_identities: &st.code_module_identities,
        unqualified: &st.unqualified,
        unqualified_file: &st.unqualified_file,
        core_item_imports: &st.core_item_imports,
        inline_unqualified: &st.inline_unqualified,
        inline_unqualified_file: &st.inline_unqualified_file,
        inline_module: None,
        inline_reexport_inline: &st.inline_reexport_inline,
        inline_reexport_file: &st.inline_reexport_file,
        inline_reexport_core: &st.inline_reexport_core,
        inline_reexport_foreign: &st.inline_reexport_foreign,
        module_path: &st.module_path,
        source: &st.source,
        package_scope: &st.package_scope,
        policy_declarations: &st.policy_declarations,
        callable_policy_declarations: &st.callable_policy_declarations,
        rule_facts: st.rule_facts.clone(),
        frame_schedule_systems: [],
        current_function_span: current_function_span,
        name_ledger: name_ledger,
        diags: [],
        statement_lint_allows: [],
        stdlib_lint_candidates: [:],
        unused_bindings: [],
        unused_binding_refs: HashSet.new(),
        flow: FlowFacts{depth: 1, ..FlowFacts.default()},
        concrete_unit_values: [[:]],
        suppress_partial_move_root_read: false,
        loop_depth: 0,
        loop_exit_depth: None,
        share_sites: [],
        implicit_loop_subject_depth: 0,
        subject_shorthand_depth: 0,
        source_nesting: 0,
        statement_expr_root_depth: None,
        loop_labels: [],
        collect_item_types: [],
        loop_value_frames: [],
        loop_break_flows: [],
        pending_loop_value: None,
        arrow_loop_body: false,
        last_loop_result_type: None,
        fx_direct: BTreeSet.new(),
        fx_direct_spans: [:],
        lambda_effect_stack: [],
        fx_edges: BTreeSet.new(),
        fx_maximal: false,
        fx_maximal_span: None,
        region_stack: [],
        fx_regions: [],
        fx_authority_delegations: [],
        fx_callback_obligations: [],
        fx_autodiff_obligations: [],
        fx_compute_calls: [],
        fx_autodiff_safe_panic: false,
        fx_autodiff_unsafe_panic: false,
        autodiff_safe_panic_context: false,
        fx_pending_diagnostics: [],
        fx_memory_events: [],
        fx_memory_open: [],
        memory_policy_stack: [],
        arithmetic_policy_stack: [],
        fx_memory_regions: [],
        fx_memory_unbounded_control: [],
        fx_memory_calls: [],
        fx_discarded_results: [],
        lost_tail_span: None,
        memory_control_multiplier: Val(1),
        txn_depth: 0,
        txn_wall_depth: 0,
        deterministic_world_depth: 0,
        det_suppress: 0,
        context_depth: 0,
        context_allocator_active: false,
        in_unsafe: in_unsafe,
        suppress_must_use: false,
        in_pure: in_pure,
        no_prelude: no_prelude,
        in_pre_clause: false,
        fallback_has_err: None,
        failure_auto_root_suppression: 0,
        failure_auto_depth: 0,
        fallback_is_shape_miss: false,
        inferred_call_type_args: None,
        invalid_binding_reads: 0,
        in_comptime: in_comptime,
        compiler_api_allowed: compiler_api_allowed,
        ret: ret,
        fn_name: fn_name,
        compiler_generated: compiler_generated,
        raw_protocol_return: raw_protocol_return,
        declared_return_type: declared_return_type,
        current_return_type_span: current_return_type_span,
        current_param_names: current_param_names,
        binder_ref_types: [:],
        expected_type: None,
        uses_exact_int: false,
        knowledge_gate: None,
        iter_borrowed: HashSet.new(),
        noelse_chains_checked: HashSet.new(),
        result_handler_subject_types: [:],
        carrier_chain_subjects: HashSet.new(),
        lending_view_loop_vars: HashSet.new(),
        return_view_provenance: None,
        views_used_in_stmt: HashSet.new(),
        scoped_loan_read_reported: false,
        call_access_frames: [],
        borrow_ctx: false,
        owning_if_value_depth: 0,
        allow_fixed_constructor: false,
        allow_string_view_read: false,
        lambda_escapes: true,
        in_lambda_body: false,
        inferred_lambda_mut_captures: HashSet.new(),
        lambda_params_are_lending_views: false,
        receiver_marks: [:],
        receiver_mark_frames: [],
        is_task_spawn: false,
        task_body_propagates: false,
        failure_direct_source: false,
        failure_union_probe: None,
        failure_carrier_inference: false,
        failure_carrier: None,
        statement_expr_inference: false,
        http_handler_depth: 0,
        interrupt_callback_depth: 0,
        lambda_param_mutable: false,
        lambda_param_is_secret_loan: false,
        view_capture_tasks: HashSet.new(),
        reactive_upgrades: [],
        reactive_upgrade_names: HashSet.new(),
        view_borrow_escape_tasks: HashSet.new(),
        current_binding_name: None,
        task_spawn_binding_name: None,
        lambda_binding: None,
        lambda_mut_borrow_stack: [HashSet.new()],
        trait_reg: &st.trait_reg,
        ct_funcs: ct_funcs,
        ct_checked_funcs: ct_checked_funcs,
        ct_items: ct_items,
        ct_externs: ct_externs,
        ct_base_dir: ct_base_dir,
        ct_globals: ct_globals,
        ct_scopes: [[:]],
        defer_ct_evaluation: defer_ct_evaluation,
        type_param_scope: type_param_scope,
        no_os: no_os,
        gates: gates,
        ct_impure_depth: 0,
