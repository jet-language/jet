//RS /// Publish the fixed-point result on bundle functions for downstream lowering.
//RS ///
//RS /// A function is projected as diverging only when its body has no reachable
//RS /// normal, returning, or loop-control path; an E0307 `NoElse` marker is an
//RS /// absent fallthrough, not a diverging result, and every arm/fallback/loop
//RS /// path must independently diverge.
//RS ///
//RS /// This is the sole semantic writer of `Func::diverges`; parser and synthetic
//RS /// constructors only initialize the compiler-metadata bit to `false`.
//RS pub(crate) fn project_divergence_facts(
//RS     bundle: &mut crate::AST::ProgramBundle,
//RS     diverging: &std::collections::HashSet<String>,
//RS ) {
//RS     for module in &mut bundle.modules {
//RS         for item in &mut module.items {
//RS             match item {
//RS                 Item::Func(function) => {
//RS                     function.diverges = diverging.contains(&function.name);
//RS                 }
//RS                 Item::CodeModule(code_module) => {
//RS                     let Some(body) = &mut code_module.body else {
//RS                         continue;
//RS                     };
//RS                     for inner in body {
//RS                         let Item::Func(function) = inner else {
//RS                             continue;
//RS                         };
//RS                         let name =
//RS                             jet_foundation::Names::member_name(&code_module.name, &function.name);
//RS                         function.diverges = diverging.contains(&name);
//RS                     }
//RS                 }
//RS                 _ => {}
//RS             }
//RS         }
//RS     }
//RS }
