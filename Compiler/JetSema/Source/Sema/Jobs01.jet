    }
}

impl Checker {
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:251
    pub fn ct_checked_funcs_for_evaluation(self: &Self) -> &[String: Func] {
        self.ct_evaluator_ran.set(true)
        self.ct_checked_funcs
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:261
pub struct BodyContext {
    pub module_idx: USize
    pub states: &[ModuleState]
    pub plugin_interfaces: &PluginInterfaceRegistry
    pub devtools_registry: &DevtoolsRegistry
    pub effect_facts: &FactRegistry
    pub ct_funcs: &[String: Func]
    pub ct_externs: &HashSet<String>
    pub ct_base_dir: &OSPath
    pub ct_globals: &[String: CtValue]
    pub no_os: Bool
    pub gates: GateSet
    pub no_prelude: Bool
}

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:281
pub struct BodyProducts {
    pub summaries: [String: EffectSummary] = [:]
    pub embed_inputs: [ComptimeInput] = []
    pub addr_taken: HashSet<String> = HashSet.new()
    pub pending_diagnostics: [PendingFunctionDiagnostic] = []
    pub devtools_publications: [DevtoolsFactPublication] = []
    pub uses_exact_int: Bool = false
    pub ran_ct_evaluator: Bool = false
}
impl BodyProducts {
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:296
    pub fn absorb(self: &Self, other: BodyProducts) {
        self.summaries.extend(^other.summaries)
        self.embed_inputs.extend(^other.embed_inputs)
        self.addr_taken.extend(^other.addr_taken)
        self.pending_diagnostics.extend(^other.pending_diagnostics)
        self.devtools_publications.extend(^other.devtools_publications)
        self.uses_exact_int |= other.uses_exact_int
        self.ran_ct_evaluator |= other.ran_ct_evaluator
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:312
pub fn check_func_body(cx: &BodyContext, f: &Func, owner_type: String?, raw_protocol_return: Bool, inline_module: String?, ct_checked_funcs: [String: Func]?, name_ledger: &NameLedger, products: &BodyProducts) -> [Diagnostic] {
    deferred_table :: [String: Func] = [:]
    defer_ct_evaluation :: ct_checked_funcs.is_none()
    checked_table :: ct_checked_funcs.as_ref().unwrap_or(&deferred_table)
    module_idx :: cx.module_idx
    states :: cx.states
    st :: &states[module_idx]
    // Only inline-module bodies copy the import tables.
    scoped := inline_module.map(fn(scope) {
        imports := st.imports.clone()
        core_imports := st.core_imports.clone()
        unqualified := st.unqualified.clone()
        unqualified_file := st.unqualified_file.clone()
        core_item_imports := st.core_item_imports.clone()
        for ((owner, name), target) in &st.inline_foreign_imports {
            if owner == scope -> imports.insert(name.clone(), target)
        }
        for ((owner, name), module) in &st.inline_core_imports {
            if owner == scope -> core_imports.insert(name.clone(), module.clone())
        }
        for ((owner, name), item) in &st.inline_core_items {
            if owner == scope -> core_item_imports.insert(name.clone(), item.clone())
        }
        for ((owner, name), mangled) in &st.inline_unqualified {
            if owner == scope -> unqualified.insert(name.clone(), mangled.clone())
        }
        for ((owner, name), target) in &st.inline_unqualified_file {
            if owner == scope -> unqualified_file.insert(name.clone(), target.clone())
        }
        (imports, core_imports, unqualified, unqualified_file, core_item_imports)
    })
    ck := checker_for_module(module_idx, states, cx.plugin_interfaces, cx.devtools_registry,
        cx.effect_facts, cx.ct_funcs, checked_table, &st.items, cx.ct_externs, cx.ct_base_dir,
        cx.ct_globals, cx.no_os, cx.gates, cx.no_prelude, name_ledger, Val(f),
        raw_protocol_return, defer_ct_evaluation)
    if scoped.as_ref() == .Val((imports, core_imports, unqualified, unqualified_file, core_item_imports)) {
        ck.imports = &imports
        ck.core_imports = &core_imports
        ck.unqualified = &unqualified
        ck.unqualified_file = &unqualified_file
        ck.core_item_imports = &core_item_imports
    }
    ck.inline_module = inline_module.clone()
    ck.canonicalize_function_return_type(f)
    ck.ret = checked_body_return_type(f, raw_protocol_return)
    for (active, name, span) in [
        (f.is_pure, Syntax.KW_PURE, f.name_span),
        (f.is_sanitizer, Syntax.KW_SANITIZER, f.name_span),
        (f.is_unsafe, Syntax.KW_UNSAFE, f.unsafe_span.unwrap_or(f.name_span)),
        (f.is_replayable, Syntax.MARKER_REPLAYABLE, f.replayable_span.unwrap_or(f.name_span)),
        (f.is_must_use, Syntax.MARKER_MUST_USE, f.must_use_span.unwrap_or(f.name_span)),
        (f.is_inline, Syntax.MARKER_INLINE, f.inline_span.unwrap_or(f.name_span)),
        (f.is_inline_always, Syntax.MARKER_INLINE, f.inline_span.unwrap_or(f.name_span)),
        (f.is_reactive, Syntax.KW_REACTIVE, f.name_span),
    ] {
        if active && !rule_allows(name, RuleSite.Function) {
            ck.diags.push(Diagnostic.error("E0355", "`#{name}` cannot attach to a function", "the compiler-owned applicability registry is shared by parser, sema, formatter, semantic index, and explain", "move the rule to one of its registered sites", Val(span)))
        }
    }
    ck.check_params_and_body(f, owner_type)
    if f.return_type.as_ref().is_some_and(fn(t) { t.has_never_success() }) && body_flow(&f.body, &st.diverging_functions, st).normal {
        span :: f.body.last().map(fn(stmt) { stmt.span() }).unwrap_or(f.return_type_span.unwrap_or(f.name_span))
        ck.diags.push(Diagnostic.from_row("E2423", [("function", f.name)], Val(span)))
    }
    if f.is_pub && f.return_type.is_none() && f.diverges {
        ck.diags.push(Diagnostic.from_row("L2421", [("function", f.name)], Val(f.name_span)))
    }
    apply_reactive_upgrade_flags(&f.body, &ck.reactive_upgrade_names)
    f.reactive_upgrades = ^ck.reactive_upgrades
    f.return_view_provenance = ck.return_view_provenance.clone()
    if f.declared_return_view_provenance.clone() == .Val(declared) {
        if f.return_view_provenance.as_ref() == .Val(inferred) {
            for (slot, inferred_prov) in inferred {
                declared_prov := declared.get(slot).or_else(fn() { declared.get([]) })
                if declared_prov == .None {
                    ck.diags.push(Diagnostic.error("E2305", "returned view escapes its declared `from` clause", "every return path's owners must stay inside the sources named after `from`", "widen the `from` clause, or stop returning a view from that owner", f.return_type_span.or(Val(f.name_span))))
                    continue
                }
                allowed :: inferred_prov.sources.iter().all(fn(inferred_path) {
                    declared_prov.unwrap().sources.iter().any(fn(declared_path) {
                        declared_path.source == inferred_path.source && inferred_path.projections.starts_with(&declared_path.projections)
                    })
                })
                if !allowed {
                    ck.diags.push(Diagnostic.error("E2305", "returned view escapes its declared `from` clause", "every return path's owners must stay inside the sources named after `from`", "widen the `from` clause, or stop returning a view from that owner", f.return_type_span.or(Val(f.name_span))))
                }
            }
        }
        merged := declared.clone()
        if f.return_view_provenance.as_ref() == .Val(inferred) {
            published := ViewProvenanceMap.new()
            for (slot, inferred_prov) in inferred {
                sources :: declared.get(slot).or_else(fn() { declared.get([]) }).map(fn(prov) { prov.sources.clone() }).unwrap_or_else(fn() { inferred_prov.sources.clone() })
                published.insert(slot.clone(), ViewProvenance{sources: sources, mutable: inferred_prov.mutable})
            }
            for (slot, declared_prov) in &declared {
                if slot.is_empty() || published.contains_key(slot) -> continue
                published.insert(slot.clone(), declared_prov.clone())
            }
            if published.is_empty() {
                for (slot, declared_prov) in &merged {
                    if slot.is_empty() -> declared_prov.mutable = inferred.values().any(fn(prov) { prov.mutable })
                }
                f.return_view_provenance = Val(^merged)
            } else {
                f.return_view_provenance = Val(^published)
            }
        } else if f.return_type.as_ref() == .Val(ret) {
            leaves :: ck.view_leaf_paths(ret)
            for (slot, declared_prov) in &merged {
                declared_prov.mutable = leaves.iter().any(fn((path, access)) {
                    (slot.is_empty() || path == slot) && access == ViewAccess.Write
                })
            }
            f.return_view_provenance = Val(^merged)
        } else {
            f.return_view_provenance = Val(^merged)
        }
    }
    if owner_type == .Val(owner) {
        if (st.registry.method(owner, f.name), f.return_view_provenance.clone()) == (.Val(signature), .Val(provenance)) {
            _ :: signature.return_view_provenance.set(^provenance)
        }
    } else {
        if (st.funcs.get(f.name), f.return_view_provenance.clone()) == (.Val(signature), .Val(provenance)) {
            _ :: signature.return_view_provenance.set(^provenance)
        }
    }
    if f.is_pure -> ck.diags.extend(check_pure_fn(f, &st.funcs))
    if f.is_inline_always -> ck.diags.extend(check_inline_always_fn(f))
    ck.diags.extend(check_every_marker(f, &st.registry))
    products.addr_taken.extend(^ck.inline_addr_taken)
    products.embed_inputs.extend(^ck.ct_embed_inputs)
    direct := ^ck.fx_direct
    direct_spans := ^ck.fx_direct_spans
    memory_events := ^ck.fx_memory_events
    for event in &memory_events {
        right :: if event.kind == {
            .Allocation | .ArenaBytes(_) -> "Mem.Alloc"
            .RetainRelease -> "Mem.Rc"
        }
        direct.insert(right)
        direct_spans.entry(right).or_insert(event.span)
    }
    for event in &memory_events {
        event.source = st.module_path.clone()
        event.provenance = "{effect_key(owner_type, f.name)} in {st.module_path}"
    }
    for region in &ck.fx_memory_regions {
        for event in &region.events {
            event.source = st.module_path.clone()
            event.provenance = "{effect_key(owner_type, f.name)} block policy in {st.module_path}"
        }
    }
    if !ck.diags.iter().any(fn(diagnostic) { diagnostic.severity == Severity.Error }) {
        for diagnostic in ^ck.fx_pending_diagnostics {
            products.pending_diagnostics.push(PendingFunctionDiagnostic{function_key: effect_key(owner_type, f.name), function_span: f.span, diagnostic: ^diagnostic})
        }
    }
    products.summaries.insert(effect_key(owner_type, f.name), EffectSummary{
        direct: ^direct,
        direct_spans: ^direct_spans,
        edges: ^ck.fx_edges,
        maximal: ck.fx_maximal,
        maximal_span: ck.fx_maximal_span,
        unbounded_trait_dispatch: false,
        regions: ^ck.fx_regions,
        authority_delegations: ^ck.fx_authority_delegations,
        callback_obligations: ^ck.fx_callback_obligations,
        autodiff_obligations: ^ck.fx_autodiff_obligations,
        compute_calls: ^ck.fx_compute_calls,
        autodiff_safe_panic: ck.fx_autodiff_safe_panic,
        autodiff_unsafe_panic: ck.fx_autodiff_unsafe_panic,
        memory: MemorySummary{
            events: ^memory_events, open_dispatches: ^ck.fx_memory_open,
            regions: ^ck.fx_memory_regions, unbounded_control: ^ck.fx_memory_unbounded_control,
            calls: ^ck.fx_memory_calls,
        },
        discarded_results: ^ck.fx_discarded_results,
        failure_direct: ck.failure_direct_source,
    })
    products.uses_exact_int |= ck.uses_exact_int
    products.ran_ct_evaluator |= ck.ct_evaluator_ran.get()
    products.devtools_publications.extend(^ck.devtools_publications)
    ^ck.diags
}

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:699
pub fn apply_reactive_upgrade_flags(stmts: &[Stmt], names: &HashSet<String>) {
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:700
    fn walk(stmts: &[Stmt], names: &HashSet<String>) {
        for stmt in stmts {
            if stmt == {
                .Val(b) -> {
                    if names.contains(b.name) || b.reactive_shared() -> b.reactive_upgrade = true
                }
                .While{body, ..} | .For{body, ..} | .Loop{body, ..} |
                .CountedLoop{body, ..} | .Unsafe{body, ..} | .Impure{body, ..} |
                .Reactive{body, ..} | .Shield{body, ..} | .Region{body, ..} |
                .Policy{body, ..} | .TaskGroup{body, ..} | .AuthorityScope{body, ..} |
                .ComptimeBlock{body, ..} | .ContextBlock{body, ..} | .Live{body, ..} |
                .AssumeDet{body, ..} | .Transact{body, ..} | .Switched{body, ..} -> walk(&body, names)
                .Switch{arms, else_body, ..} | .ComptimeSwitch{arms, else_body, ..} -> {
                    for arm in &arms -> walk(&arm.body, names)
                    if else_body == .Val(body) -> walk(&body, names)
                }
                .ComptimeIf{then_body, else_body, ..} -> {
                    walk(&then_body, names)
                    if else_body == .Val(body) -> walk(&body, names)
                }
                _ -> {}
            }
        }
    }
    walk(stmts, names)
}

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:761
pub fn function_value_param_contract(sig: &FuncSig) -> [(String, ParamZone)]? {
    contract := [(String, ParamZone)].with_capacity(sig.param_call.len())
    for (index, (label, zone)) in sig.param_call.iter().enumerate() {
        implicit_local_label :: zone == ParamZone.Either && sig.param_info.get(index).is_some_and(fn((name, _)) { name == label })
        public_label :: if zone == ParamZone.PositionalOnly || implicit_local_label -> "" else -> label.clone()
        contract.push((public_label, zone))
    }
    if contract.iter().any(fn((label, zone)) { !label.is_empty() || zone != ParamZone.Either }) -> Val(^contract) else -> None
}

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:782
pub fn func_sig_to_fn_type(sig: &FuncSig) -> Type {
    Type.Fn{
        params: sig.params.iter().enumerate().map(fn((index, (_, ty))) {
            if sig.param_variadic.get(index).copied().unwrap_or(false) -> Type.List(ty.clone()) else -> ty.clone()
        }).collect(),
        ret: Val(sig.effective_return_type()),
        effect_bound: if sig.is_pure || sig.is_foreign_thread_safe -> Val([]) else -> None,
        param_contract: function_value_param_contract(sig),
        call_metadata: Val(FunctionCallMetadata{
            names: sig.param_info.iter().map(fn((name, _)) { name.clone() }).collect(),
            defaults: sig.defaults.clone(),
            variadic: sig.param_variadic.clone(),
            conventions: sig.params.iter().map(fn((convention, _)) { convention }).collect(),
            policies: sig.callable_policies.clone(),
        }),
        return_view_provenance: sig.return_view_provenance.get(),
    }
}
impl Checker {
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:825
    pub fn checked_func_sig_to_fn_type(self: &Self, sig: &FuncSig) -> Type {
        function_type := func_sig_to_fn_type(sig)
        if function_type == .Fn{params, ret, ..} {
            for param in &params -> param = self.resolve_type(param.clone())
            if ret == .Val(value) {
                (_, effective) :: self.checked_return_types(sig.return_type.clone(), sig.is_extern)
                value = ^effective
            }
        }
        ^function_type
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:841
pub fn fn_types_compatible(want: &Type, got: &Type) -> Bool {
    want :: want.with_effective_fn_returns()
    got :: got.with_effective_fn_returns()
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:845
    fn carrier_compatible(want: &Type, got: &Type) -> Bool {
        compatible := true
        shape :: Type.for_each_composite_pair(want, got, fn(want, got) {
            if compatible {
                compatible = if (want, got) == {
                    (.List(_), .List(_)) | (.Option(_), .Option(_)) | (.Result{..}, .Result{..}) -> true
                    (.Apply{name: want_name, ..}, .Apply{name: got_name, ..}) -> want_name == got_name
                    (.Fn{..}, .Fn{..}) -> fn_types_compatible(want, got)
                    _ -> want == got
                }
            }
        })
        shape.is_ok() && compatible
    }
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:866
    fn effect_bound_compatible(want: [(String, Span)]?, got: [(String, Span)]?) -> Bool {
        if want == {
            .None -> true
            .Val(required) -> got.is_some_and(fn(actual) {
                actual.iter().all(fn((effect, _)) { required.iter().any(fn((name, _)) { name == effect }) })
            })
        }
    }
    if (want, got) == (.Fn{params: wp, ret: wr, effect_bound: we, ..}, .Fn{params: gp, ret: gr, effect_bound: ge, ..}) {
        if wp.len() != gp.len() -> return false
        for (a, b) in wp.iter().zip(gp.iter()) {
            if !carrier_compatible(a, b) -> return false
        }
        return_compatible :: if (wr, gr) == {
            (.None, .None) -> true
            (.Val(a), .Val(b)) -> {
                compatible := carrier_compatible(a, b)
                if (a, b) == (.Result{ok: want_ok, ..}, .Result{ok: got_ok, err: got_err}) {
                    compatible |= got_err.is_never() && carrier_compatible(want_ok, got_ok)
                }
                compatible
            }
            (.None, .Val(b)) | (.Val(b), .None) -> is_unit_callable_return(b)
        }
        return return_compatible && effect_bound_compatible(we, ge)
    }
    false
}

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1005
pub fn property_param_generatable(ty: &Type) -> Bool {
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .Float32 | .IntN{..} | .InlineRange{..} -> true
        .List(inner) | .Option(inner) -> property_param_generatable(inner)
        .FixedList{elem, ..} -> property_param_generatable(elem)
        _ -> false
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1022
pub fn property_param_unsupported(ty: &Type, span: Span) -> Diagnostic? {
    if property_param_generatable(ty) -> return None
    Val(Diagnostic.error(
        "E0613",
        "a property test can't generate values of type `{ty.name()}`",
        "a parameterized `#{Syntax.KW_TEST} fn` is a property test (D-TEST1): {Syntax.LANG_NAME} generates inputs from each parameter's type, but this type has no built-in generator",
        "use a generatable type (Int, Float, Bool, String, Char, a sized integer, or a list/optional of those), or write a plain `#Test \"name\" { … }` block and construct the value yourself",
        Val(span),
    ))
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1044
pub fn collect_diverging_functions(states: &[ModuleState]) -> HashSet<String> {
    diverging := HashSet<String>.new()
    for state in states {
        for item in &state.items {
            if item == {
                .Func(function) -> {
                    if function.return_type.as_ref().is_some_and(fn(t) { t.has_never_success() }) -> diverging.insert(function.name.clone())
                }
                .CodeModule(module) -> {
                    if module.body.as_ref() == .Val(body) {
                        for inner in body {
                            if inner == .Func(function) && function.return_type.as_ref().is_some_and(fn(t) { t.has_never_success() }) {
                                diverging.insert(jet_foundation.Names.member_name(module.name, function.name))
                            }
                        }
                    }
                }
                _ -> {}
            }
        }
    }
    loop {
        changed := false
        for state in states {
            for item in &state.items {
                if item == {
                    .Func(function) -> {
                        if body_definitely_diverges(&function.body, &diverging, state) && diverging.insert(function.name.clone()) -> changed = true
                    }
                    .CodeModule(module) -> {
                        if module.body.as_ref() == .Val(body) {
                            for inner in body {
                                if inner == .Func(function) && body_definitely_diverges(&function.body, &diverging, state) {
                                    if diverging.insert(jet_foundation.Names.member_name(module.name, function.name)) -> changed = true
                                }
                            }
                        }
                    }
                    _ -> {}
                }
            }
        }
        if !changed -> return ^diverging
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1134
pub fn collect_fixed_length_write_params(states: &[ModuleState]) -> HashSet<(String, USize)> {
    functions := [(String, &Func)].new()
    for state in states {
        for item in &state.items {
            if item == {
                .Func(function) -> functions.push((function.name.clone(), function))
                .CodeModule(module) -> {
                    for inner in module.body.iter().flatten() {
                        if inner == .Func(function) -> functions.push((jet_foundation.Names.member_name(module.name, function.name), function))
                    }
                }
                _ -> {}
            }
        }
    }
    declared := [String: USize] = [:]
    for (_, function) in &functions -> declared[function.name] = declared.get(function.name).copied().unwrap_or_default() + 1
    proven := HashSet<(String, USize)>.new() // GATE #4499: composite key equality/hash.
    onward_uses := []
    for (name, function) in &functions {
        if declared.get(function.name).copied().unwrap_or_default() > 1 -> continue
        for (index, param) in function.params.iter().enumerate() {
            if param.convention != AccessConvention.Write -> continue
            if param.ty != .List(_) -> continue
            if write_list_param_onward_uses(&function.body, param.name) == .Val(onward) {
                key :: (name.clone(), index)
                proven.insert(key.clone())
                onward_uses.push((key, ^onward))
            }
        }
    }
    loop {
        before :: proven.len()
        onward_uses.retain(fn((key, onward)) {
            if onward.iter().all(fn(target) { proven.contains(target) }) -> true
            else {
                proven.remove(key)
                false
            }
        })
        if proven.len() == before -> return ^proven
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1199
LENGTH_PRESERVING_LIST_METHODS :: [String] = ["sort", "sort_desc", "sort_by", "sort_by_key", "reverse", "swap", "fill", "shuffle", "rotate_left", "rotate_right"]

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1217
fn write_list_param_onward_uses(body: &[Stmt], param: String) -> [(String, USize)]? {
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1218
    fn is_param(expr: &Expr, param: String) -> Bool {
        if expr == {
            .Paren(inner, _) -> is_param(inner, param)
            .Ident(name, _) -> name == param
            _ -> false
        }
    }
    resizes := assigns_whole_local(body, param)
    marks := USize{0}
    accounted := USize{0}
    onward := [(String, USize)].new()
    for stmt in body {
        stmt.for_each_expr(fn(expr) {
            if expr == {
                .Place(inner, .Write, _) -> {
                    if is_param(inner, param) -> marks += 1
                }
                .MethodCall{receiver, method, args, ..} -> {
                    if receiver == .Place(inner, .Write, _) && is_param(inner, param) {
                        accounted += 1
                        if !LENGTH_PRESERVING_LIST_METHODS.contains(method) -> resizes = true
                    }
                    if args.iter().any(fn(arg) { arg.convention == AccessConvention.Write && is_param(&arg.expr, param) }) -> resizes = true
                }
                .Call(call) -> {
                    for (index, arg) in call.args.iter().enumerate() {
                        if arg.convention == AccessConvention.Write && is_param(&arg.expr, param) -> onward.push((call.name.clone(), index))
                    }
                }
                .CallValue{args, ..} -> {
                    if args.iter().any(fn(arg) { arg.convention == AccessConvention.Write && is_param(&arg.expr, param) }) -> resizes = true
                }
                _ -> {}
            }
        })
    }
    if !resizes && marks == accounted -> Val(^onward) else -> None
}

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1280
fn assigns_whole_local(body: &[Stmt], name: String) -> Bool {
    body.iter().any(fn(stmt) {
        nested :: if stmt == {
            .Assign{target: .Local{name: target, ..}, ..} && target == name -> return true
            .While{body, ..} | .For{body, ..} | .CountedLoop{body, ..} |
            .Loop{body, ..} | .Reactive{body, ..} | .Shield{body, ..} |
            .Switched{body, ..} | .Region{body, ..} | .Policy{body, ..} |
            .AuthorityScope{body, ..} | .ComptimeBlock{body, ..} | .Live{body, ..} |
            .Transact{body, ..} | .Layout{body, ..} | .Unsafe{body, ..} |
            .Impure{body, ..} | .TaskGroup{body, ..} | .ContextBlock{body, ..} |
            .AssumeDet{body, ..} | .ScopeMember{body, ..} -> assigns_whole_local(&body, name)
            .Switch{arms, else_body, ..} | .ComptimeSwitch{arms, else_body, ..} -> {
                arms.iter().any(fn(arm) { assigns_whole_local(&arm.body, name) }) ||
                    else_body.as_ref().is_some_and(fn(body) { assigns_whole_local(body, name) })
            }
            .ComptimeIf{then_body, else_body, ..} -> {
                assigns_whole_local(&then_body, name) || else_body.as_ref().is_some_and(fn(body) { assigns_whole_local(body, name) })
            }
            _ -> false
        }
        in_expr := false
        stmt.for_each_expr(fn(expr) {
            if expr == {
                .If{then_body, else_body, ..} -> in_expr |= assigns_whole_local(&then_body, name) || assigns_whole_local(&else_body, name)
                .Lambda(lambda) -> {
                    if lambda.body == .Block(body) -> in_expr |= assigns_whole_local(&body, name)
                }
                _ -> {}
            }
        })
        nested || in_expr
    })
}

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1359
pub fn project_divergence_facts(bundle: &ProgramBundle, diverging: &HashSet<String>) {
    for module in &bundle.modules {
        for item in &module.items {
            if item == {
                .Func(function) -> function.diverges = diverging.contains(function.name)
                .CodeModule(code_module) -> {
                    if code_module.body == .Val(body) {
                        for inner in &body {
                            if inner == .Func(function) {
                                name :: jet_foundation.Names.member_name(code_module.name, function.name)
                                function.diverges = diverging.contains(name)
                            }
                        }
                    }
                }
                _ -> {}
            }
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1389
pub struct DivergenceFlow {
    pub normal: Bool = false
    pub returned: Bool = false
    pub diverged: Bool = false
    pub broke: Bool = false
    pub continued: Bool = false
}
impl DivergenceFlow {
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1398
    fn normal() -> Self { Self{normal: true} }
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1405
    fn none() -> Self { Self{} }
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1409
    fn union(self: Self, other: Self) -> Self {
        Self{normal: self.normal || other.normal, returned: self.returned || other.returned, diverged: self.diverged || other.diverged, broke: self.broke || other.broke, continued: self.continued || other.continued}
    }
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1421
    fn then(self: Self, next: Self) -> Self {
        if !self.normal -> return self
        Self{normal: false, returned: self.returned, diverged: self.diverged, broke: self.broke, continued: self.continued}.union(next)
    }
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1435
    fn return_to_caller(self: Self) -> Self {
        Self{normal: false, returned: self.returned || self.normal, diverged: self.diverged, broke: self.broke, continued: self.continued}
    }
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1445
    fn break_to_loop(self: Self) -> Self {
        Self{normal: false, returned: self.returned, diverged: self.diverged, broke: self.broke || self.normal, continued: self.continued}
    }
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1455
    fn definitely_diverges(self: Self) -> Bool {
        self.diverged && !self.normal && !self.returned && !self.broke && !self.continued
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1460
pub fn body_flow(body: &[Stmt], diverging: &HashSet<String>, state: &ModuleState) -> DivergenceFlow {
    flow := DivergenceFlow.normal()
    for stmt in body -> flow = flow.then(stmt_flow(stmt, diverging, state))
    flow
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1472
pub fn body_definitely_diverges(body: &[Stmt], diverging: &HashSet<String>, state: &ModuleState) -> Bool {
    body_flow(body, diverging, state).definitely_diverges()
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1480
pub fn expr_list_flow<I: IntoIterator<&Expr>>(expressions: I, diverging: &HashSet<String>, state: &ModuleState) -> DivergenceFlow {
    flow := DivergenceFlow.normal()
    for expression in expressions -> flow = flow.then(expr_flow(expression, diverging, state))
    flow
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1495
pub fn call_args_flow(args: &[CallArg], diverging: &HashSet<String>, state: &ModuleState) -> DivergenceFlow {
    expr_list_flow(args.iter().map(fn(arg) { &arg.expr }), diverging, state)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1503
pub fn lvalue_flow(target: &LValue, diverging: &HashSet<String>, state: &ModuleState) -> DivergenceFlow {
    if target == {
        .Local{..} -> DivergenceFlow.normal()
        .Index{base, index, ..} -> expr_flow(base, diverging, state).then(expr_flow(index, diverging, state))
        .Field{base, ..} -> expr_flow(base, diverging, state)
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1517
pub fn for_kind_flow(kind: &ForKind, diverging: &HashSet<String>, state: &ModuleState) -> DivergenceFlow {
    if kind == {
        .Range{start, end, step, ..} -> expr_flow(start, diverging, state)
            .then(expr_flow(end, diverging, state))
            .then(step.as_ref().map(fn(step) { expr_flow(step, diverging, state) }).unwrap_or_else(fn() { DivergenceFlow.normal() }))
        .In{collection, step} -> expr_flow(collection, diverging, state)
            .then(step.as_ref().map(fn(step) { expr_flow(step, diverging, state) }).unwrap_or_else(fn() { DivergenceFlow.normal() }))
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1540
pub fn finite_loop_flow(body: DivergenceFlow) -> DivergenceFlow {
    DivergenceFlow{normal: true, returned: body.returned, diverged: body.diverged, broke: false, continued: false}
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1552
pub fn infinite_loop_flow(body: DivergenceFlow) -> DivergenceFlow {
    DivergenceFlow{normal: body.broke, returned: body.returned, diverged: body.diverged || body.normal || body.continued, broke: false, continued: false}
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1564
pub fn branch_flow(body: &[Stmt], value: &Expr, diverging: &HashSet<String>, state: &ModuleState) -> DivergenceFlow {
    body_flow(body, diverging, state).then(expr_flow(value, diverging, state))
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1573
pub fn switch_flow(subject: &Expr, arms: &[SwitchArm], else_body: [Stmt]?, span: Span, diverging: &HashSet<String>, state: &ModuleState) -> DivergenceFlow {
    if arms.is_empty() {
        return expr_flow(subject, diverging, state).then(else_body.map(fn(body) { body_flow(&body, diverging, state) }).unwrap_or_else(fn() { DivergenceFlow.normal() }))
    }
    branches := DivergenceFlow.none()
    for arm in arms -> branches = branches.union(expr_flow(&arm.cond, diverging, state).then(body_flow(&arm.body, diverging, state)))
    fallback :: if else_body == {
        .Val(body) -> body_flow(&body, diverging, state)
        .None -> if jet_foundation.is_subjectless_guard(subject, span) -> DivergenceFlow.normal() else -> DivergenceFlow.none()
    }
    expr_flow(subject, diverging, state).then(branches.union(fallback))
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1604
pub fn stmt_flow(stmt: &Stmt, diverging: &HashSet<String>, state: &ModuleState) -> DivergenceFlow {
    if stmt == {
        .Expr(expr) -> expr_flow(expr, diverging, state)
        .Val(binding) -> expr_flow(&binding.init, diverging, state)
        .Assign{target, value, ..} -> lvalue_flow(target, diverging, state).then(expr_flow(value, diverging, state))
        .Return(value, ..) -> value.as_ref().map(fn(v) { expr_flow(v, diverging, state) }).unwrap_or_else(fn() { DivergenceFlow.normal() }).return_to_caller()
        .Break(_) | .BreakLabel(_, _) -> DivergenceFlow{broke: true}
        .BreakValue(value, _) | .BreakLabelValue(_, _, value, _) -> expr_flow(value, diverging, state).break_to_loop()
        .Continue(_) | .ContinueLabel(_, _) -> DivergenceFlow{continued: true}
        .Loop{body, ..} -> infinite_loop_flow(body_flow(&body, diverging, state))
        .While{cond, body, ..} -> {
            loop_body :: body_flow(&body, diverging, state)
            loop_flow :: if cond.without_parens() == .Bool(true, _) -> infinite_loop_flow(loop_body) else -> finite_loop_flow(loop_body)
            expr_flow(cond, diverging, state).then(loop_flow)
        }
        .For{kind, body, ..} -> for_kind_flow(kind, diverging, state).then(finite_loop_flow(body_flow(&body, diverging, state)))
        .CountedLoop{init, cond, step, body, ..} -> {
            iteration :: body_flow(&body, diverging, state).then(step.as_ref().map(fn(step) { stmt_flow(step, diverging, state) }).unwrap_or_else(fn() { DivergenceFlow.normal() }))
            loop_flow :: if cond.without_parens() == .Bool(true, _) -> infinite_loop_flow(iteration) else -> finite_loop_flow(iteration)
            expr_flow(&init.init, diverging, state).then(expr_flow(cond, diverging, state)).then(loop_flow)
        }
        .Switch{subject, arms, else_body, span} | .ComptimeSwitch{subject, arms, else_body, span} -> switch_flow(subject, &arms, else_body, span, diverging, state)
        .Unsafe{audit_expr, body, ..} | .Impure{reason_expr: audit_expr, body, ..} -> audit_expr.as_ref().map(fn(expr) { expr_flow(expr, diverging, state) }).unwrap_or_else(fn() { DivergenceFlow.normal() }).then(body_flow(&body, diverging, state))
        .Reactive{body, ..} | .Shield{body, ..} | .Switched{body, ..} |
        .Region{body, ..} | .Policy{body, ..} | .Layout{body, ..} |
        .AuthorityScope{body, ..} | .ComptimeBlock{body, ..} | .Live{body, ..} |
        .Transact{body, ..} -> body_flow(&body, diverging, state)
        .TaskGroup{limit, body, ..} -> limit.as_ref().map(fn(expr) { expr_flow(expr, diverging, state) }).unwrap_or_else(fn() { DivergenceFlow.normal() }).then(body_flow(&body, diverging, state))
        .ComptimeIf{then_body, else_body, selected_then, ..} -> {
            if selected_then == {
                .Val(true) -> body_flow(&then_body, diverging, state)
                .Val(false) -> else_body.as_ref().map(fn(body) { body_flow(body, diverging, state) }).unwrap_or_else(fn() { DivergenceFlow.normal() })
                .None -> body_flow(&then_body, diverging, state).union(else_body.as_ref().map(fn(body) { body_flow(body, diverging, state) }).unwrap_or_else(fn() { DivergenceFlow.normal() }))
            }
        }
        .ContextBlock{fields, body, ..} -> expr_list_flow(fields.iter().map(fn((_, value, _)) { value }), diverging, state).then(body_flow(&body, diverging, state))
        .AssumeDet{reason_expr, body, ..} -> expr_flow(reason_expr, diverging, state).then(body_flow(&body, diverging, state))
        .Yield(value, _) -> expr_flow(value, diverging, state)
        .ScopeMember{args, body, ..} -> expr_list_flow(args.iter(), diverging, state).then(body_flow(&body, diverging, state))
        .DeferClose{close, ..} -> expr_flow(close, diverging, state)
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1736
pub fn typed_lit_flow(body: &TypedLitBody, diverging: &HashSet<String>, state: &ModuleState) -> DivergenceFlow {
    if body == {
        .Fields(fields) -> expr_list_flow(fields.iter().map(fn((_, _, value)) { value }), diverging, state)
        .Elements(elements) -> expr_list_flow(elements.iter(), diverging, state)
        .Entries(entries) -> expr_list_flow(entries.iter().flat_map(fn((key, value)) { [key, value] }), diverging, state)
        .Value(value) -> expr_flow(value, diverging, state)
        .ByteText(_) | .Empty -> DivergenceFlow.normal()
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1760
pub fn expr_flow(expr: &Expr, diverging: &HashSet<String>, state: &ModuleState) -> DivergenceFlow {
    if expr.without_parens() == {
        .Str(parts, _) -> {
            flow := DivergenceFlow.normal()
            for part in parts {
                if part == .Interp(value, _) -> flow = flow.then(expr_flow(value, diverging, state))
            }
            flow
        }
        .StrMatchLit(_, _) | .BinMatchLit(_, _) | .Int(_, _, _, _) |
        .Float(_, _, _, _) | .Bool(_, _) | .Unit(_) | .Char(_, _) |
        .Ident(_, _) | .Absent(_) | .ReduceMarker(_, _) | .ComptimeName{..} |
        .Lambda(_) -> DivergenceFlow.normal()
        .ListLit(items, _) -> expr_list_flow(items.iter(), diverging, state)
        .MemberSpread{base, ..} | .Spread(base, _) -> expr_flow(base, diverging, state)
        .MapLit(items, _) -> expr_list_flow(items.iter().flat_map(fn((key, value)) { [key, value] }), diverging, state)
        .Index{base, index, ..} | .Range{start: base, end: index, ..} -> expr_flow(base, diverging, state).then(expr_flow(index, diverging, state))
        .Slice{base, start, end, range, ..} -> {
            flow := expr_flow(base, diverging, state).then(expr_flow(start, diverging, state)).then(expr_flow(end, diverging, state))
            if range == .Val(range) -> flow = flow.then(expr_flow(range, diverging, state))
            flow
        }
        .MethodCall{receiver, method, args, ..} -> {
            flow :: expr_flow(receiver, diverging, state).then(call_args_flow(&args, diverging, state))
            if flow.normal && core_call_diverges(state, receiver, method) -> DivergenceFlow{normal: false, diverged: true, ..flow} else -> flow
        }
        .UnitLit{..} -> DivergenceFlow.normal()
        .Call(call) -> {
            args :: call_args_flow(&call.args, diverging, state)
            call_diverges :: call.name == Syntax.BUILTIN_PANIC || diverging.contains(call.name)
            if call_diverges && args.normal -> DivergenceFlow{normal: false, returned: args.returned, diverged: true, broke: args.broke, continued: args.continued} else -> args
        }
        .Unary(_, inner, _) -> expr_flow(inner, diverging, state)
        .Binary(op, left, right, _) -> {
            left :: expr_flow(left, diverging, state)
            right :: expr_flow(right, diverging, state)
            if op == .And || op == .Or {
                if !left.normal -> left
                else -> DivergenceFlow{normal: true, returned: left.returned || right.returned, diverged: left.diverged || right.diverged, broke: left.broke || right.broke, continued: left.continued || right.continued}
            } else -> left.then(right)
        }
        .CompareChain{operands, ..} -> {
            flow := DivergenceFlow.normal()
            for (index, operand) in operands.iter().enumerate() {
                prior :: flow
                flow = flow.then(expr_flow(operand, diverging, state))
                if index > 0 && prior.normal -> flow.normal = true
            }
            flow
        }
        .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _) | .Place(inner, _, _) |
        .Field(inner, _, _) | .OptField{base: inner, ..} | .Present(inner, _) |
        .Ok(inner, _) | .Err(inner, _) | .Paren(inner, _) -> expr_flow(inner, diverging, state)
        .StructLit{fields, ..} -> expr_list_flow(fields.iter().map(fn((_, _, value)) { value }), diverging, state)
        .TypedLit{body, ..} -> typed_lit_flow(body, diverging, state)
        .EnumLit{args, ..} -> expr_list_flow(args.iter().filter_map(fn(arg) {
            if arg == {
                .Positional(value) | .Named{expr: value, ..} -> Val(value)
            }
        }), diverging, state)
        .Tainted(inner, ..) -> expr_flow(inner, diverging, state)
        .Todo{..} -> DivergenceFlow{diverged: true}
        // Omitted exhaustive fallthrough has no runtime outcome, not divergence.
        .NoElse(_) -> DivergenceFlow.none()
        .PatternTest{subject, ..} -> expr_flow(subject, diverging, state)
        .Try(inner, _, _, note) -> {
            flow := expr_flow(inner, diverging, state)
            if note == .Val(note) -> flow = flow.union(expr_flow(note, diverging, state))
            flow
        }
        .OrFallback{value, fallback, ..} -> {
            value_flow :: expr_flow(value, diverging, state)
            if value_flow.normal -> value_flow.union(or_fallback_flow(fallback, diverging, state)) else -> value_flow
        }
        .If{cond, then_body, then_value, else_body, else_value, ..} -> {
            branches :: branch_flow(&then_body, then_value, diverging, state).union(branch_flow(&else_body, else_value, diverging, state))
            expr_flow(cond, diverging, state).then(branches)
        }
        .TupleLit(fields, _, _) -> expr_list_flow(fields.iter().map(fn((_, value)) { value }), diverging, state)
        .CallValue{callee, args, ..} -> expr_flow(callee, diverging, state).then(call_args_flow(&args, diverging, state))
        .PtrFromAddr{addr, ..} -> expr_flow(addr, diverging, state)
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:1960
pub fn or_fallback_flow(fallback: &OrFallback, diverging: &HashSet<String>, state: &ModuleState) -> DivergenceFlow {
    if fallback == {
        .Value(value) -> expr_flow(value, diverging, state)
        .Block{body, value, ..} -> body_flow(&body, diverging, state).then(value.as_ref().map(fn(value) { expr_flow(value, diverging, state) }).unwrap_or_else(fn() { DivergenceFlow.normal() }))
        .Return(value, _) -> value.as_ref().map(fn(value) { expr_flow(value, diverging, state) }).unwrap_or_else(fn() { DivergenceFlow.normal() }).return_to_caller()
        .Panic{args, ..} -> {
            args :: call_args_flow(&args, diverging, state)
            if args.normal -> DivergenceFlow{normal: false, returned: args.returned, diverged: true, broke: args.broke, continued: args.continued} else -> args
        }
        .Break(_) | .BreakLabel(_, _) -> DivergenceFlow{broke: true}
        .Continue(_) | .ContinueLabel(_, _) -> DivergenceFlow{continued: true}
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/BodyCheck.rs:2003
pub fn core_call_diverges(state: &ModuleState, receiver: &Expr, method: String) -> Bool {
    if receiver.without_parens() == .Ident(alias, _) {
        module :: state.core_imports.get(alias) ?? return false
        return jet_sema.CheckerCoreLib.core_call_signature(module, method).and_then(fn((_, ret)) { ret }).is_some_and(fn(ret) {
            if ret == .Named(name) -> name == Syntax.TYPE_NEVER else -> false
        })
    }
    false
}

