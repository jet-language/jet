//RS                     err: want_err,
//RS                 },
//RS                 Type::Result {
//RS                     ok: got_ok,
//RS                     err: got_err,
//RS                 },
//RS             ) => {
//RS                 self.checked_text_string_target(want_ok, got_ok)
//RS                     || self.checked_text_string_target(want_err, got_err)
