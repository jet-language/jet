use jet_sema.Sema.Diagnostics.[option_used_where_plain_expected, plain_used_where_result_expected, result_used_where_plain_expected, soft_public_use, suggest_field, type_fix_hint, undeclared_value_tag, is_expiring_secret_member_type]
