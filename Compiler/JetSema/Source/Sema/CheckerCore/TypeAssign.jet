//RS     /// S48 (syntax-decisions.md:1613; spec.md:839, ratified): a
//RS     /// trait name in type position (`fn f(s: Shape)`) means dynamic dispatch
//RS     /// with INVISIBLE boxing. A concrete value whose type implements the
//RS     /// named trait therefore MEETS that slot — sema decides acceptance only;
//RS     /// the box itself is materialised by the slot-driven boxing lowering
//RS     /// already applies to a `[Shape]` list element (`TCallArg::box_as_trait`
//RS     /// / `preserve_typed_list_shape`), never by a second mechanism here.
//RS     ///
//RS     /// Single-trait only (the S48 shape). A multi-name `TraitObject` is the
//RS     /// D-ANY-JAI1 variadic loop element, which has no one `Box<dyn T>` to
//RS     /// coerce toward and stays on the ordinary equality path.
//RS     pub(crate) fn trait_slot_accepts(&self, want: &Type, got: &Type) -> bool {
//RS         // A value that already IS the trait value needs no coercion: an
//RS         // unresolved bare-trait parameter spelling can equal the argument's
//RS         // own type, and a `TraitObject` argument is the resolved same thing.
//RS         if want == got || matches!(got, Type::TraitObject(_)) {
//RS             return false;
//RS         }
//RS         let trait_name = match want {
//RS             Type::TraitObject(names) if names.len() == 1 => names.first(),
//RS             // An unresolved signature type still spells the trait as a plain
//RS             // nominal; `CheckerCore/types.rs:179` uses the same test.
//RS             Type::Named(name)
//RS                 if self.trait_reg.is_trait_name(name) && !self.registry.contains(name) =>
//RS             {
//RS                 Some(name)
//RS             }
//RS             _ => None,
//RS         };
//RS         trait_name.is_some_and(|trait_name| self.trait_reg.type_implements_trait(got, trait_name))
//RS     }
