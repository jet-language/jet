//RS     /// D-OPT-LIFT1=A: a plain `T` fills a slot whose checked type is `T?`
//RS     /// (returns, call arguments, struct fields, list and map items, typed
//RS     /// bindings, and reassignment). The slot type is already fixed, so the
//RS     /// lift never picks a callee or infers a generic; it adds exactly one
//RS     /// `Present` around the value (after any numeric widening), which every
//RS     /// tier lowers through the existing optional constructor. Nested
//RS     /// optionals never arise: a value that is already optional or fallible
//RS     /// is left for the ordinary checks (E0108/E0309). Returns the slot type
//RS     /// when the value was lifted.
//RS     pub(crate) fn lift_optional_slot(
//RS         &mut self,
//RS         want: &Type,
//RS         got: &Type,
//RS         expr: &mut crate::AST::Expr,
//RS     ) -> Option<Type> {
//RS         let Type::Option(payload) = want.without_user_tags() else {
//RS             return None;
//RS         };
//RS         let plain = got.without_user_tags();
//RS         if plain.unwrap_option().is_some() || plain.unwrap_result().is_some() || plain.is_never()
//RS         {
//RS             return None;
//RS         }
//RS         if matches!(
//RS             expr.without_parens(),
//RS             crate::AST::Expr::Present(..) | crate::AST::Expr::Absent(_)
//RS         ) {
//RS             return None;
//RS         }
//RS         let payload = payload.as_ref();
//RS         let fits = got == payload
//RS             || self.nominal_type_identity(payload, got)
//RS             || matches!(payload, Type::Union(members) if members.iter().any(|m| m == got));
//RS         if !fits {
//RS             if got.numeric_widening_to(payload).is_none() {
//RS                 return None;
//RS             }
//RS             self.widen_numeric_expr(expr, got, payload);
//RS         }
//RS         let span = expr.span();
//RS         let value = std::mem::replace(expr, crate::AST::Expr::Absent(span));
//RS         *expr = crate::AST::Expr::Present(Box::new(value), span);
//RS         Some(want.clone())
//RS     }
//RS 
//RS     /// D-OPT-LIFT1=A at a call argument: the callee is already chosen, so a
//RS     /// plain payload fills its `T?` parameter. A write parameter edits the
//RS     /// caller's own binding and never lifts.
//RS     pub(crate) fn lift_optional_argument(
//RS         &mut self,
//RS         expr: &mut crate::AST::Expr,
//RS         got: Type,
//RS         want: &Type,
//RS         convention: crate::AST::AccessConvention,
//RS     ) -> Type {
//RS         if convention == crate::AST::AccessConvention::Write {
//RS             return got;
//RS         }
//RS         self.lift_optional_slot(want, &got, expr).unwrap_or(got)
//RS     }
