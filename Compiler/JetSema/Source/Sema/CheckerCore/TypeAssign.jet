// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:41
pub fn is_core_view_generic(ty: Type) -> Bool {
    if ty == { .Apply(name, _) -> name == "View" || name == "ViewMut" || name == Syntax.TYPE_PIN || name == Syntax.TYPE_VIEW_ITER; else -> false }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:52
// Never may inhabit only a callable success return or a failure domain.
pub fn reject_never_value_positions(ty: Type, span: Span, allow_success_never: Bool, diags: &[Diagnostic]) -> {
    if ty == {
        .Named(name) -> { if name == Syntax.TYPE_NEVER && !allow_success_never -> &diags.push(Diagnostic.from_row("E2422", [], Val(span))) }
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> reject_never_value_positions(inner, span, false, &diags)
        .Map(key, _, value) -> { reject_never_value_positions(key, span, false, &diags); reject_never_value_positions(value, span, false, &diags) }
        .Result(ok, err) -> { reject_never_value_positions(ok, span, allow_success_never, &diags); reject_never_value_positions(err, span, true, &diags) }
        .Fn{params, ret, ..} -> {
            loop param in params -> reject_never_value_positions(param, span, false, &diags)
            if ret == .Val(ret) -> reject_never_value_positions(ret, span, true, &diags)
        }
        .Apply(_, args) | .Union(args) -> { loop arg in args -> reject_never_value_positions(arg, span, false, &diags) }
        .Tuple(fields) -> { loop field in fields -> reject_never_value_positions(field.ty, span, false, &diags) }
        else -> {}
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:114
pub fn check_declared_type(self: &Checker, ty: Type, span: Span) -> {
    self.check_declared_type_common(ty, span)
    self.reject_never_value_positions(ty, span, false)
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:119
pub fn check_declared_return_type(self: &Checker, ty: Type, span: Span) -> {
    self.check_declared_type_common(ty, span)
    self.reject_never_value_positions(ty, span, true)
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:127
fn check_declared_type_common(self: &Checker, ty: Type, span: Span) -> {
    self.warn_soft_public_declared_type(ty, span)
    self.check_declared_type_rules(ty, span)
    if self.cell_guard_storage_is_unsupported(ty) -> self.report_cell_guard_storage("a Cell guard cannot be stored in `{ty.show()}`", span)
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:138
fn reject_never_value_positions(self: &Checker, ty: Type, span: Span, allow_success_never: Bool) -> {
    reject_never_value_positions(ty, span, allow_success_never, &self.diags)
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:142
pub fn warn_soft_public_declared_type(self: &Checker, ty: Type, span: Span) -> { self.warn_soft_public_type_tree(ty, span) }
// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:146
fn warn_soft_public_type_tree(self: &Checker, ty: Type, span: Span) -> {
    if ty == {
        .Named(name) -> self.warn_soft_public_type_name(name, span)
        .Apply(name, args) -> { self.warn_soft_public_type_name(name, span); loop arg in args -> self.warn_soft_public_type_tree(arg, span) }
        .TraitObject(names) -> { loop name in names -> self.warn_soft_public_type_name(name, span) }
        .Option(inner) | .List(inner) | .Shared(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) -> self.warn_soft_public_type_tree(inner, span)
        .Map(key, _, value) | .Result(key, value) -> { self.warn_soft_public_type_tree(key, span); self.warn_soft_public_type_tree(value, span) }
        .Union(members) -> { loop member in members -> self.warn_soft_public_type_tree(member, span) }
        .Tuple(fields) -> { loop field in fields -> self.warn_soft_public_type_tree(field.ty, span) }
        .Fn{params, ret, ..} -> { loop param in params -> self.warn_soft_public_type_tree(param, span); if ret == .Val(ret) -> self.warn_soft_public_type_tree(ret, span) }
        else -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:198
fn warn_soft_public_type_name(self: &Checker, name: String, span: Span) -> {
    self.warn_deprecated_type_name(name, span)
    owner := Int?{None}
    public_name := name // #4303
    if name.rsplit_once('.') == .Val((alias, leaf)) {
        owner = self.imports.get(alias)
        public_name = leaf
    } else {
        declared :: self.name_ledger.declaration(self.module_idx, name) != None
        locally_owned :: self.registry.contains(name) || (declared && self.modules.is_some_and(modules -> modules[self.module_idx].trait_reg.is_trait_name(name)))
        if locally_owned -> owner = Val(self.module_idx)
        else if self.modules == .Val(modules) {
            loop idx in self.imports.values() {
                if modules[idx].registry.contains(name) || modules[idx].trait_reg.is_trait_name(name) { owner = Val(idx); break }
            }
        }
    }
    if Syntax.classify_identifier(public_name) != .SoftPublic -> return
    idx :: owner ?? return
    if idx == self.module_idx || !self.type_is_pub_in(idx, public_name) -> return
    &self.diags.push(soft_public_use(public_name, span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:234
pub fn warn_deprecated_type_name(self: &Checker, name: String, span: Span) -> {
    (import_ns, leaf) :: self.struct_type_name_parts(name)
    owner :: self.struct_owner_module(leaf, import_ns) ?? return
    definition :: if owner == self.module_idx -> self.registry.types.get(leaf)
        else -> self.modules.and_then(modules -> modules.get(owner)).and_then(module -> module.registry.types.get(leaf))
    deprecation :: definition.and_then(definition -> if definition == {
        .Struct{deprecation, ..} | .Enum{deprecation, ..} | .Distinct{deprecation, ..} | .Alias{deprecation, ..} -> deprecation
    })
    if deprecation == .Val(deprecation) {
        item :: if import_ns == .Val(namespace) -> "{namespace}.{leaf}" else -> "{leaf}"
        self.check_deprecation(item, deprecation, span)
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:270
pub fn check_declared_type_rules(self: &Checker, ty: Type, span: Span) -> {
    if generic_depth_exceeded(ty) == .Val(chain) -> &self.diags.push(e0909(chain, span))
    if ty == {
        .Named(n) -> {
            if n == "Any" { &self.diags.push(no_any_type(span)); return }
            if n == "_" { &self.diags.push(type_hole_diag(span)); return }
            if n == "Data" { &self.diags.push(data_renamed_to_datatree(span)); return }
            if n == Syntax.LAYOUT_HANDLE_TYPE_RETIRED { &self.diags.push(layout_handle_renamed_to_layout(span)); return }
            if Syntax.retired_acronym_spelling(n) == .Val(canonical) { &self.diags.push(retired_acronym_spelling_diag(n, canonical, span)); return }
            if retired_authority_vocabulary_diag(n, span) == .Val(diag) { &self.diags.push(^diag); return }
            if n.split_once('.') == .Val((alias, leaf)) && self.core_imports.get(alias) == .Val(module) && core_leaf_kind(module, leaf) == .Val(kind) {
                if kind == .Generic(arity) {
                    &self.diags.push(Diagnostic.error("E0119", "`{n}` expects {arity} type argument{if arity == 1 -> "" else -> "s"}, got 0", "every generic Core type needs a matching type argument", "write `{n}<...>` with exactly {arity} type argument{if arity == 1 -> "" else -> "s"}", Val(span)))
                }
                return
            }
            if !self.registry.contains(n) && core_generic_arity(n) == .Val(arity) {
                &self.diags.push(Diagnostic.error("E0119", "`{n}` expects {arity} type argument{if arity == 1 -> "" else -> "s"}, got 0", "every generic Core type needs a matching type argument", "write `{n}<...>` with exactly {arity} type argument{if arity == 1 -> "" else -> "s"}", Val(span)))
                return
            }
            if core_type_known(n) || self.type_param_scope.any(p -> p.name == n) || self.trait_reg.is_trait_name(n) -> return
            if self.registry.is_type_alias(n) {
                params :: self.registry.type_alias(n).map((params, _) -> params.map(p -> p.name).join(", ")) ?? ""
                &self.diags.push(Diagnostic.error("E0119", "`{n}` is a type alias and needs type arguments", "write `{n}`<{params}>", "instantiate the alias, like `{n}`<T>", Val(span)))
                return
            }
            if self.registry.contains(n) -> return
            if n.rsplit_once("::") == .Val((namespace, leaf)) && self.struct_owner_module(leaf, Val(namespace)) == .Val(owner) && (owner == self.module_idx || self.type_is_pub_in(owner, leaf)) -> return
            if n.rsplit_once('.') == .Val((module, leaf)) && self.modules == .Val(modules) && self.imports.get(module) == .Val(index) && modules[index].registry.contains(leaf) && self.type_is_pub_in(index, leaf) -> return
            if self.core_item_imports.get(n) == .Val(leaf) && self.struct_owner_module(n, None).is_some_and(owner -> self.type_is_pub_in(owner, leaf)) -> return
            if self.modules == .Val(modules) {
                found := [Int:Bool]{}
                loop idx in self.imports.values() {
                    if modules[idx].registry.contains(n) && self.type_is_pub_in(idx, n) -> &found.insert(idx, true)
                }
                if found.len() == 1 && self.struct_owner_module(n, None) != None -> return
            }
            if phantom_fact_menu_diag(n, span) == .Val(diag) { &self.diags.push(^diag); return }
            &self.diags.push(Diagnostic.error("E0119", "there's no type called `{n}`", "the types are `{Syntax.TYPE_INT}`, `{Syntax.TYPE_FLOAT}`, `{Syntax.TYPE_BOOL}`, and `{Syntax.TYPE_STRING}` (plus types you define)", "check the spelling, or define the struct or enum first", Val(span)))
        }
        .Apply(name, args) -> {
            (import_ns, lookup_name) :: Checker.split_type_name(name)
            canonical_owner :: if name.contains("::") -> self.name_ledger.nominal_module(name) else -> None
            if lookup_name == "Any" {
                &self.diags.push(no_any_type(span))
                loop arg in args -> self.check_declared_type_rules(arg, span)
                return
            }
            local_alias :: canonical_owner == None && import_ns == None
            if local_alias && self.registry.type_alias(lookup_name) == .Val((params, target)) {
                if params.len() != args.len() {
                    names :: params.map(p -> p.name).join(", ")
                    &self.diags.push(Diagnostic.error("E0119", "`{name}` expects {params.len()} type argument{if params.len() == 1 -> "" else -> "s"}, got {args.len()}", "every generic parameter needs a matching type argument", "write `{name}`<{names}>", Val(span)))
                }
                loop arg in args -> self.check_declared_type_rules(arg, span)
                subst := [String:Type]{}
                loop index in 0..<params.len().min(args.len()) -> &subst.insert(~params[index].name, ~args[index])
                self.check_declared_type_rules(substitute_type(target, subst), span)
                return
            }
            core_arity :: if import_ns == {
                .Val(namespace) -> self.core_imports.get(namespace).and_then(module -> if core_leaf_kind(module, lookup_name) == { .Val(.Generic(arity)) -> Val(arity); else -> None })
                .None -> core_generic_arity(lookup_name)
            }
            if core_arity == .Val(expected) && args.len() != expected {
                &self.diags.push(Diagnostic.error("E0119", "`{name}` expects {expected} type argument{if expected == 1 -> "" else -> "s"}, got {args.len()}", "every generic Core type needs a matching type argument", "write `{name}<...>` with exactly {expected} type argument{if expected == 1 -> "" else -> "s"}", Val(span)))
            }
            is_core_generic :: core_arity != None || (local_alias && (is_core_view_generic(ty) || if lookup_name == {
                "Task" | Syntax.TYPE_RECEIVER | "Sender" | "Ptr" | "Tensor" | "Vec" | "Matrix" | Syntax.TYPE_ATOMIC |
                "Set" | Syntax.TYPE_TALLY | Syntax.TYPE_QUEUE | Syntax.TYPE_ITER | Syntax.TYPE_RANK | "PriorityQueue" |
                "Cache" | "Decimal" | "Signal" | "Derived" | "Computed" | "Event" | "Hook" | "DecisionHook" |
                "HookDecision" | "HookOutcome" | "DispatchReport" | "Stream" | "StreamEventTime" | "KeyedStream" |
                "Window" | "Query" | "DataGroupedQuery" | "Group" | "DataJoin" | "Pool" | "ID" | "Cell" |
                "CellReadGuard" | "CellEditGuard" | "ExpiringSecret" | Syntax.TYPE_SHARED_GUARD | Syntax.TYPE_SHARED_WEAK |
                Syntax.TYPE_SHARED_SNAPSHOT | "KeyRef" | "MutationPlan" | "VaultWrite" | "Rotation" | "WrappedImportPlan" |
                "Point2" | "Delta2" | "Transform" | "Transform2" | "Ray2" -> true
                else -> false
            }))
            if is_core_generic && (lookup_name == "Point2" || lookup_name == "Delta2" || lookup_name == "Transform" || lookup_name == "Transform2" || lookup_name == "Ray2") {
                valid :: if {
                    lookup_name == "Point2" || lookup_name == "Delta2" -> args.len() == 2 && args[0].is_float() && (args[1] is Type.Named)
                    lookup_name == "Transform" -> args.len() == 2 && (args[0] is Type.Named) && (args[1] is Type.Named)
                    lookup_name == "Transform2" || lookup_name == "Ray2" -> args.len() == 3 && args[0].is_float() && (args[1] is Type.Named) && (args[2] is Type.Named)
                    else -> false
                }
                if !valid -> &self.diags.push(Diagnostic.error("E0119", "`{name}` is not a valid coordinate-space type", "Point2 and Delta2 are `<Float, Space>`; Transform is `<From, To>` and Transform2/Ray2 are `<Float, From, To>`", "use a known nominal space such as `Screen`, `World`, `View`, `Camera`, or `Device` and keep the argument order", Val(span)))
                loop arg in args -> self.check_declared_type_rules(arg, span)
                return
            }
            if is_core_generic && (lookup_name == "Vec" || lookup_name == "Matrix") {
                expected :: if lookup_name == "Vec" -> 1 else -> 2
                if args.len() != expected || args.any(arg -> arg.compute_dimension_value() == None) {
                    &self.diags.push(Diagnostic.error("E0119", "`{name}` needs {expected} literal shape dimension{if expected == 1 -> "" else -> "s"}", "compute aliases carry fixed dimensions that sema checks before codegen", if lookup_name == "Vec" -> "write `Vec<N>` with one non-negative integer" else -> "write `Matrix<M, N>` with two non-negative integers", Val(span)))
                }
                return
            }
            if is_core_generic && lookup_name == Syntax.TYPE_ATOMIC {
                if args.len() != 1 || !args.first().is_some_and(arg -> atomic_scalar_type(arg)) {
                    &self.diags.push(Diagnostic.error("E0119", "`{name}` accepts exactly one closed scalar: `Bool`, `I32`, `U32`, `I64`, `Int`, or `U64`", "Atomic values use one compiler-owned lock-free word; arbitrary widths and compound types have no portable representation", "use `Atomic<Bool>`, `Atomic<I32>`, `Atomic<U32>`, `Atomic<I64>`, `Atomic<Int>`, or `Atomic<U64>`", Val(span)))
                }
                loop arg in args -> self.check_declared_type_rules(arg, span)
                return
            }
            if is_core_generic && lookup_name == "ExpiringSecret" && (args.len() != 1 || !args.first().is_some_and(arg -> is_expiring_secret_member_type(arg))) {
                &self.diags.push(Diagnostic.error("E0112", "`ExpiringSecret<T>` requires a secret type", "only Secret, SigningKey, and X25519SecretKey have the audited move-only zeroizing contract required by this wrapper", "use `ExpiringSecret<crypto.Secret>`, `ExpiringSecret<crypto.SigningKey>`, or `ExpiringSecret<crypto.X25519SecretKey>`", Val(span)))
            }
            explicit_import_owner :: import_ns.filter(namespace -> !namespace.contains("::")).and_then(namespace -> self.struct_owner_module(lookup_name, Val(namespace)))
            imported_owners := [Int:Bool]{}
            if canonical_owner == .Val(owner) {
                if owner != self.module_idx && self.modules.is_some_and(modules -> modules[owner].registry.contains(lookup_name)) && self.type_is_pub_in(owner, lookup_name) -> &imported_owners.insert(owner, true)
            } else if explicit_import_owner == .Val(owner) {
                if owner != self.module_idx && self.type_is_pub_in(owner, lookup_name) -> &imported_owners.insert(owner, true)
            } else if self.modules == .Val(modules) {
                loop idx in self.imports.values() {
                    if modules[idx].registry.contains(lookup_name) && self.type_is_pub_in(idx, lookup_name) -> &imported_owners.insert(idx, true)
                }
            }
            imported_owner :: if imported_owners.len() == 1 -> imported_owners.keys().next() else -> None
            local_type :: self.registry.contains(lookup_name) && if canonical_owner == { .Val(owner) -> owner == self.module_idx; .None -> import_ns == None }
            if !is_core_generic && !local_type && imported_owner == None {
                &self.diags.push(Diagnostic.error("E0119", "there's no type called `{name}`", "generic types must name a struct or enum you defined", "check the spelling, or define the type first", Val(span)))
            }
            if !is_core_generic {
                expected_owner :: canonical_owner.or(imported_owner).or(if local_type -> Val(self.module_idx) else -> None)
                expected :: expected_owner.and_then(idx -> {
                    if idx == self.module_idx -> self.trait_reg.struct_params.get(lookup_name).or_else(() -> self.trait_reg.enum_params.get(lookup_name))
                    else -> self.modules.and_then(modules -> modules[idx].trait_reg.struct_params.get(lookup_name).or_else(() -> modules[idx].trait_reg.enum_params.get(lookup_name)))
                })
                if expected == .Val(params) {
                    if params.len() != args.len() {
                        names :: params.map(p -> p.name).join(", ")
                        &self.diags.push(Diagnostic.error("E0119", "`{name}` expects {params.len()} type argument{if params.len() == 1 -> "" else -> "s"}, got {args.len()}", "every generic parameter needs a matching type argument", "write `{name}`<{names}>", Val(span)))
                    }
                } else if !args.is_empty() {
                    &self.diags.push(Diagnostic.error("E0119", "`{name}` isn't generic", "only types declared with type parameters accept `<…>`", "use `{name}` without type arguments", Val(span)))
                }
            }
            loop arg in args {
                if lookup_name == "View" && arg == .Named("str") -> next
                self.check_declared_type_rules(arg, span)
            }
        }
        .TraitObject(ts) -> {
            loop t in ts {
                if !self.trait_reg.is_trait_name(t) -> &self.diags.push(Diagnostic.error("E0119", "there's no trait called `{t}`", "a trait name in type position must name a declared trait", "add `trait {t} {{ … }}` first", Val(span)))
            }
        }
        .Option(inner) -> {
            if inner is Type.Option -> &self.diags.push(Diagnostic.error("E0309", "an optional type can't hold another optional type", "`{inner.name()}?` isn't supported — use one `?` only (S32)", "drop the inner `?` or unwrap before wrapping again", Val(span)))
            self.check_declared_type_rules(inner, span)
        }
        .List(inner) | .Shared(inner) -> self.check_declared_type_rules(inner, span)
        .Map(key, key_span, value) -> {
            self.check_declared_type_rules(key, span)
            self.check_declared_type_rules(value, span)
            if !self.map_key_type_eligible(key) -> &self.diags.push(Diagnostic.error("E0502", "`{key.name()}` can't be a map key type (D-MAP-KEY1)", "map keys must be Int, String, Bool, Char, U8/IntN, a payload-free enum, or a tuple/struct whose fields recursively follow D-MAP-KEY1; Float, views, Shared, functions, lists, maps, sets, and payload-carrying enums are not key-eligible", "use an eligible scalar, enum, tuple, or struct key; remove non-key fields or store the value separately", Val(key_span ?? span)))
        }
        .Result(ok, err) -> {
            self.check_declared_type_rules(ok, span)
            domain_errors :: self.diags.len()
            self.check_declared_type_rules(err, span)
            resolved_error :: self.resolve_type(~err)
            generic_domain :: if resolved_error == { .Named(name) -> self.type_param_scope.any(param -> param.name == name); else -> false }
            if self.diags.len() == domain_errors && !generic_domain && !self.is_error_domain(resolved_error) -> &self.diags.push(Diagnostic.from_row("E2417", [("domain", resolved_error.show())], Val(span)))
        }
        .Union(members) -> {
            param_names := [String:Bool]{}
            loop p in self.type_param_scope -> &param_names.insert(~p.name, true)
            loop m in members {
                mentioned := [String:Bool]{}
                collect_type_param_mentions(m, param_names, &mentioned)
                if sema_union_member_has_open_shape(m) || !mentioned.is_empty() -> &self.diags.push(Diagnostic.error("E0363", "`{m.name()}` can't be a union member", "anonymous unions hold concrete closed types — not type parameters, trait objects, or function types", "use a named enum when a member needs an open shape", Val(span)))
                self.check_declared_type_rules(m, span)
            }
        }
        .Fn{params, ret, ..} -> { loop p in params -> self.check_declared_type_rules(p, span); if ret == .Val(r) -> self.check_declared_type_rules(r, span) }
        .Tuple(fields) -> { loop field in fields -> self.check_declared_type_rules(field.ty, span) }
        .Tagged(.User(name), inner) -> {
            if !self.tag_is_declared(name) -> &self.diags.push(undeclared_value_tag(name, self.closest_declared_tag(name), span))
            self.check_declared_type_rules(inner, span)
        }
        .Tagged(_, inner) | .InlineRange(inner, _, _) -> self.check_declared_type_rules(inner, span)
        else -> {}
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:939
pub fn tag_is_declared(self: Checker, name: String) -> Bool {
    Syntax.BUILTIN_TAGS.contains(name) || self.trait_reg.local_tags.contains(name) || self.modules.is_some_and(modules -> self.imports.values().any(idx -> modules[idx].trait_reg.local_tags.contains(name) && self.type_is_pub_in(idx, name)))
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:950
pub fn closest_declared_tag(self: Checker, name: String) -> String? {
    candidates := [String]{}
    loop tag in self.trait_reg.local_tags -> &candidates.push(~tag)
    loop tag in Syntax.BUILTIN_TAGS -> &candidates.push(~tag)
    if self.modules == .Val(modules) {
        loop idx in self.imports.values() {
            loop tag in modules[idx].trait_reg.local_tags {
                if self.type_is_pub_in(idx, tag) -> &candidates.push(~tag)
            }
        }
    }
    &candidates.sort()
    &candidates.dedup()
    suggest_field(name, candidates)
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:979
// Reject unchecked String at any checked-text slot, including nested carriers.
fn checked_text_string_target(self: Checker, want: Type, got: Type) -> Bool {
    if (want, got) == {
        (.Named(name), .String) -> self.is_checked_text_type_name(name) || self.type_param_has_bound(want, CHECKED_TEXT)
        (.List(want), .List(got)) | (.Shared(want), .Shared(got)) | (.Option(want), .Option(got)) |
        (.List(want), .FixedList(got, _)) | (.FixedList(want, _), .List(got)) |
        (.FixedList(want, _), .FixedList(got, _)) |
        (.Tagged(_, want), .Tagged(_, got)) | (.InlineRange(want, _, _), .InlineRange(got, _, _)) |
        (.Quantity(want, _), .Quantity(got, _)) -> self.checked_text_string_target(want, got)
        (.Map(wk, _, wv), .Map(gk, _, gv)) | (.Result(wk, wv), .Result(gk, gv)) -> self.checked_text_string_target(wk, gk) || self.checked_text_string_target(wv, gv)
        (.Apply(_, wa), .Apply(_, ga)) -> {
            loop index in 0..<wa.len().min(ga.len()) { if self.checked_text_string_target(wa[index], ga[index]) -> return true }
            false
        }
        (.Tuple(wf), .Tuple(gf)) -> {
            loop index in 0..<wf.len().min(gf.len()) { if self.checked_text_string_target(wf[index].ty, gf[index].ty) -> return true }
            false
        }
        (.Fn{params: wp, ret: wr, ..}, .Fn{params: gp, ret: gr, ..}) -> {
            loop index in 0..<wp.len().min(gp.len()) { if self.checked_text_string_target(wp[index], gp[index]) -> return true }
            if (wr, gr) == { (.Val(wr), .Val(gr)) -> self.checked_text_string_target(wr, gr); else -> false }
        }
        (.Union(wm), .Union(gm)) -> wm.any(want -> gm.any(got -> self.checked_text_string_target(want, got)))
        else -> false
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:1081
// Lift exactly one Present only after the destination type is fixed.
pub fn lift_optional_slot(self: &Checker, want: Type, got: Type, expr: &Expr) -> Type? {
    payload :: if want.without_user_tags() == { .Option(payload) -> payload; else -> return None }
    plain :: got.without_user_tags()
    if plain.unwrap_option() != None || plain.unwrap_result() != None || plain.is_never() -> return None
    if expr.without_parens() == { .Present(_, _) | .Absent(_) -> true; else -> false } -> return None
    fits :: got == payload || self.nominal_type_identity(payload, got) || if payload == { .Union(members) -> members.any(m -> m == got); else -> false }
    if !fits {
        if got.numeric_widening_to(payload) == None -> return None
        self.widen_numeric_expr(&expr, got, payload)
    }
    span :: expr.span()
    value :: ^expr
    expr = .Present(^value, span)
    Val(~want)
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:1126
pub fn lift_optional_argument(self: &Checker, expr: &Expr, ^got: Type, want: Type, convention: AccessConvention) -> Type {
    if convention == .Write -> return ^got
    self.lift_optional_slot(want, got, &expr) ?? ^got
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:1142
// True means compatibility handled or a diagnostic emitted.
pub fn check_type_assignable(self: &Checker, want: Type, got: Type, span: Span) -> Bool {
    if want == got {
        if !Type.obligations_satisfy(want, got) {
            if (want is Type.Fn) && (got is Type.Fn) -> return false
            &self.diags.push(Diagnostic.error("E0108", "this needs {want.show()}, but the callable obligations are not satisfied", "the callable value does not provide the obligations required here", "pass a callable with matching effects, labels, and view provenance", Val(span)))
        }
        return true
    }
    if (want.with_effective_fn_returns(), got.with_effective_fn_returns()) == (.Fn{ret: .Val(wr), ..}, .Fn{ret: .Val(gr), ..}) && wr.has_never_success() && !gr.has_never_success() {
        &self.diags.push(Diagnostic.from_row("E2426", [], Val(span)))
        return true
    }
    if self.checked_text_string_target(want, got) {
        &self.diags.push(Diagnostic.error("E0112", "this needs {want.show()}, but the value is {got.show()}", "a checked text type is nominal; a plain String needs validation before it crosses this boundary", "construct the checked text with its checked literal or `from(text)`", Val(span)))
        return true
    }
    if (got is Type.InlineRange) && got.erased_inline_ranges() == want {
        self.require_knowledge_gate(.Range, .BoundedArithmetic, span)
        return true
    }
    if (want, got) == (.Fn{param_contract: .Val(want_contract), ..}, .Fn{param_contract: .None, ..}) {
        strict :: want_contract.any((_, zone) -> zone == .PositionalOnly || zone == .LabelOnly)
        if fn_types_compatible(want, got) && strict {
            &self.diags.push(Diagnostic.error("E0771", "this needs {want.show()}, but the function value is {got.show()}", "public labels and parameter zones are part of a function's callable type", "use `{want.name()}` here", Val(span)))
            return true
        }
    }
    if (want is Type.Fn) && (got is Type.Fn) && fn_types_compatible(want, got) && Type.obligations_satisfy(want, got) -> return true
    if self.nominal_type_identity(want, got) || Type.compute_tensor_compatible(want, got) -> return true
    if plain_used_where_result_expected(want, got) -> return true
    if result_used_where_plain_expected(want, got) {
        if self.failure_carrier_inference {
            if self.failure_carrier == None { self.failure_carrier = Val(~got); self.ret = Val(~got) }
            self.task_body_propagates = true
            return true
        }
        &self.diags.push(Diagnostic.error("E0401", "this needs {want.show()}, but the value is {got.show()}", "a fallible result must be checked before its value is used", "use `{Syntax.OP_TRY_SUFFIX}`, `{Syntax.OP_FALLBACK}`, or test with `== {Syntax.LIT_OK}(...)` / `== {Syntax.LIT_ERR}(...)`", Val(span)))
        return true
    }
    if option_used_where_plain_expected(want, got) {
        &self.diags.push(Diagnostic.error("E0310", "this needs {want.show()}, but the value is {got.show()}", "a plain value is required here, not an optional one", "test with `== {Syntax.LIT_VALUE}(...)` or `== {Syntax.LIT_NULL}` first, e.g. `if x == {Syntax.LIT_VALUE}(n) {{ ... }}`", Val(span)))
        return true
    }
    if got == .Option(inner) {
        if want.unwrap_option() == .Val(want_inner) {
            if inner != want_inner -> self.report_option_mismatch(want, got, span)
        } else if inner != want -> self.report_option_mismatch(want, got, span)
        return true
    }
    if want.unwrap_option() == .Val(payload) && got.unwrap_option() == None {
        fix :: if payload == got -> "this position does not lift a plain value; write `{Syntax.LIT_VALUE}(...)`" else -> type_fix_hint(payload, got)
        &self.diags.push(Diagnostic.error("E0108", "this needs {want.show()}, but the value is {got.show()}", "`{want.name()}` means a `{payload.name()}` or `{Syntax.LIT_NULL}`", fix, Val(span)))
        return true
    }
    if (want, got) == {
        (.List(want_elem), .FixedList(got_elem, _)) if want_elem == got_elem -> return true
        (.Union(members), got) if members.any(m -> m == got) -> return true
        (.TraitObject(trait_names), got) -> {
            loop trait_name in trait_names {
                if !self.trait_reg.type_implements_trait(got, trait_name) {
                    &self.diags.push(e0905(got.name(), trait_name, span, trait_name == COMPARABLE || trait_name == "Serialize"))
                    return true
                }
            }
            return true
        }
        else -> {}
    }
    false
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:1406
// Single-trait slots use the ordinary slot-driven boxing lowering.
pub fn trait_slot_accepts(self: Checker, want: Type, got: Type) -> Bool {
    if want == got || (got is Type.TraitObject) -> return false
    trait_name :: if want == {
        .TraitObject(names) if names.len() == 1 -> names.first()
        .Named(name) if self.trait_reg.is_trait_name(name) && !self.registry.contains(name) -> Val(name)
        else -> None
    }
    trait_name.is_some_and(name -> self.trait_reg.type_implements_trait(got, name))
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:1438
pub fn nominal_type_identity(self: Checker, want: Type, got: Type) -> Bool {
    if want == got -> return true
    if (want, got) == {
        (.Named(wn), .Named(gn)) if Syntax.is_data_type_name(wn) && Syntax.is_data_type_name(gn) -> true
        (.Named(wn), .Named(gn)) -> self.same_declared_name_identity(wn, gn)
        (.Apply(wn, wa), .Apply(gn, ga)) -> {
            if wa.len() != ga.len() || !self.same_declared_name_identity(wn, gn) -> return false
            loop index in 0..<wa.len() { if !self.nominal_type_identity(wa[index], ga[index]) -> return false }
            true
        }
        (.List(w), .List(g)) | (.Shared(w), .Shared(g)) | (.Option(w), .Option(g)) -> self.nominal_type_identity(w, g)
        (.Result(wk, wv), .Result(gk, gv)) | (.Map(wk, _, wv), .Map(gk, _, gv)) -> self.nominal_type_identity(wk, gk) && self.nominal_type_identity(wv, gv)
        (.FixedList(we, wl), .FixedList(ge, gl)) -> wl == gl && self.nominal_type_identity(we, ge)
        (.Tuple(wf), .Tuple(gf)) -> {
            if wf.len() != gf.len() -> return false
            loop index in 0..<wf.len() {
                if wf[index].name != gf[index].name || !self.nominal_type_identity(wf[index].ty, gf[index].ty) -> return false
            }
            true
        }
        (.Union(wm), .Union(gm)) -> {
            if wm.len() != gm.len() -> return false
            matched := [Bool]{}
            loop _ in gm -> &matched.push(false)
            loop want_member in wm {
                found := false
                loop index in 0..<gm.len() {
                    if !matched[index] && self.nominal_type_identity(want_member, gm[index]) {
                        matched[index] = true
                        found = true
                        break
                    }
                }
                if !found -> return false
            }
            true
        }
        (.Tagged(wm, wi), .Tagged(gm, gi)) if wm == gm -> self.nominal_type_identity(wi, gi)
        (.Tagged(.Internal(.CoreCryptoNominal), inner), other) | (other, .Tagged(.Internal(.CoreCryptoNominal), inner)) -> self.nominal_type_identity(inner, other)
        (.Quantity(wb, wd), .Quantity(gb, gd)) if wd == gd -> self.nominal_type_identity(wb, gb)
        else -> false
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:1585
fn declared_nominal_identity(self: Checker, spelling: String) -> String? {
    (namespace, leaf) :: Checker.split_type_name(spelling)
    if self.struct_owner_module(leaf, namespace) == .Val(owner) -> return Val(self.canonical_nominal_name(owner, leaf))
    current_prefix :: self.modules.and_then(modules -> modules.get(self.module_idx)).map(module -> "{module.module_alias}.")
    modules :: self.modules ?? return None
    bare_builtin :: namespace == None && Syntax.typed_head_kind(spelling) != None
    loop (owner, module) in modules {
        loop candidate in module.registry.types.keys() {
            if owner != self.module_idx && !self.type_is_pub_in(owner, candidate) -> next
            if bare_builtin && self.record_distinct_from_builtin(owner, candidate) -> next
            display :: self.name_ledger.display_path(self.module_idx, candidate, Val(owner))
            loop visible in visible_spellings(spelling, current_prefix) {
                if visible == candidate || display.is_some_and(target -> visible == target) -> return Val(self.canonical_nominal_name(owner, candidate))
            }
        }
    }
    None
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:1603
// Iterator borrows its input; no temporary array of copied spellings.
fn visible_spellings(name: String, current_prefix: String?) -> Iter<String> {
    std.iter.once(name).chain(current_prefix.and_then(prefix -> name.strip_prefix(prefix)))
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:1642
fn core_source_type_key(self: Checker, spelling: String) -> (String, String)? {
    (namespace, leaf) :: Checker.split_type_name(spelling)
    modules :: self.modules ?? return None
    source := namespace.and_then(namespace -> self.core_imports.get(namespace).and_then(module -> core_source_module(module)).or_else(() -> core_source_module_by_alias(namespace)))
    if source == None {
        owner :: self.struct_owner_module(leaf, namespace) ?? return None
        module :: modules.get(owner) ?? return None
        source = core_source_modules().find(source -> core_source_text(source.module) == Val(module.source) && (module.module_alias == source.alias || module.package_scope == "."))
    }
    source_record :: source ?? return None
    owner := self.struct_owner_module(leaf, namespace)
    if owner == None {
        loop (idx, module) in modules {
            if module.module_alias == source_record.alias && module.registry.contains(leaf) { owner = Val(idx); break }
        }
    }
    idx :: owner ?? return None
    module :: modules.get(idx) ?? return None
    if !module.registry.contains(leaf) -> return None
    Val((source_record.module, leaf))
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:1685
fn same_declared_name_identity(self: Checker, want: String, got: String) -> Bool {
    if want == got -> return true
    if (self.core_source_type_key(want), self.core_source_type_key(got)) == (.Val((wm, wl)), .Val((gm, gl))) && wm == gm && wl == gl -> return true
    if (self.declared_nominal_identity(want), self.declared_nominal_identity(got)) == { (.Val(w), .Val(g)) -> w == g; else -> false }
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/type_assign.rs:1702
pub fn report_option_mismatch(self: &Checker, want: Type, got: Type, span: Span) -> {
    &self.diags.push(Diagnostic.error("E0108", "this needs {want.show()}, but the value is {got.show()}", "the types must match", type_fix_hint(want, got), Val(span)))
}
