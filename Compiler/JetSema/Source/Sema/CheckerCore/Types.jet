use jet_sema.Generics.[substitute_type, CHECKED_TEXT]
use jet_sema.Sema.[Checker, TypeRegistry]
use jet_foundation.[Type, Item, Func, FailureContract, TagMarker, InternalTag, numeric_type_from_name, canonicalize_union, Syntax]
use jet_foundation.CoreModuleExports.core_leaf_kind
use jet_sema.Sema.CheckerCoreLib.core_module_type_item
use jet_sema.Sema.Diagnostics.core_crypto_nominal
use jet_sema.Policy.rule_arg_declaration

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:6
// Resolve checked text through ordinary nominal and trait registries.
pub fn checked_text_type_name(self: Checker, name: String) -> (String, Type)? {
    (import_ns, leaf) :: Checker.split_type_name(name)
    owner :: self.struct_owner_module(leaf, import_ns) ?? return None
    (registry, trait_reg, items) :: if owner == self.module_idx -> (self.registry, self.trait_reg, self.items)
        else {
            module :: self.modules.and_then(modules -> modules.get(owner)) ?? return None
            (module.registry, module.trait_reg, module.items)
        }
    if registry.distinct_base(leaf) != Val(Type.String) || !trait_reg.implements_trait(leaf, CHECKED_TEXT) -> return None
    error :: items.find_map(item -> {
        blocks :: if item == {
            .Impl(implementation) if implementation.type_name == leaf && implementation.trait_name == Val(CHECKED_TEXT) -> Val(implementation.assoc_type_impls)
            .Struct(definition) if definition.name == leaf -> definition.trait_impls.find(block -> block.trait_name == CHECKED_TEXT).map(block -> block.assoc_type_impls)
            .Enum(definition) if definition.name == leaf -> definition.trait_impls.find(block -> block.trait_name == CHECKED_TEXT).map(block -> block.assoc_type_impls)
            else -> None
        } ?? return None
        blocks.find(entry -> entry.0 == "Error").map(entry -> entry.2)
    }) ?? return None
    canonical :: if owner == self.module_idx -> leaf else -> self.canonical_nominal_name(owner, leaf)
    Val((canonical, error))
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:57
// Shared consumer guard for nominal assignment boundaries (card #2185).
pub fn is_checked_text_type_name(self: Checker, name: String) -> Bool {
    self.checked_text_type_name(name).is_some()
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:63
fn imported_nominal_type(self: Checker, name: String) -> Type? {
    (import_ns, leaf) :: Checker.split_type_name(name)
    owner :: self.struct_owner_module(leaf, import_ns) ?? return None
    if owner == self.module_idx -> return None
    module :: self.modules.and_then(modules -> modules.get(owner)) ?? return None
    if module.trait_reg.is_trait_name(leaf) && !module.registry.contains(leaf) -> Val(Type.TraitObject([leaf]))
    else if module.registry.contains(leaf) -> Val(Type.Named(self.canonical_nominal_name(owner, leaf)))
    else -> None
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:80
// Lift declared field trait names against the owning module, as signatures do.
pub fn owner_trait_values(self: Checker, owner: Int, ty: Type) -> Type {
    (registry, trait_reg) :: if owner == self.module_idx -> (self.registry, self.trait_reg)
        else {
            module :: self.modules.and_then(modules -> modules.get(owner)) ?? return ty
            (module.registry, module.trait_reg)
        }
    traits := [String:Type]{}
    _ :: ty.map_named_types(name -> {
        if trait_reg.traits.contains_key(name) && !registry.contains(name) -> &traits.insert(name, Type.TraitObject([name]))
        None
    })
    if traits.is_empty() -> ty else -> substitute_type(ty, traits)
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:111
// Core crypto structs use owner identity; enums retain contextual leaf spelling.
fn core_crypto_struct_type(self: Checker, name: String) -> Type? {
    (import_ns, leaf) :: Checker.split_type_name(name)
    owner :: self.struct_owner_module(leaf, import_ns) ?? return None
    module :: self.modules.and_then(modules -> modules.get(owner)) ?? return None
    if owner == self.module_idx || module.registry.enum_variants(leaf).is_some() -> return None
    self.imported_nominal_type(name)
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:124
pub fn imported_nominal_head(self: Checker, name: String) -> String {
    if name.contains("::") -> return name
    (import_ns, leaf) :: Checker.split_type_name(name)
    if import_ns.and_then(alias -> self.core_imports.get(alias)) == .Val(module) {
        if core_leaf_kind(module, leaf).is_some() -> return self.core_nominal_shadowing_builtin(module, leaf) ?? leaf
    }
    owner :: self.struct_owner_module(leaf, import_ns) ?? return name
    if owner == self.module_idx -> name else -> self.canonical_nominal_name(owner, leaf)
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:146
fn record_type_import_use(self: &Checker, ty: Type) -> {
    name :: if ty == {
        .Named(name) | .Apply(name, _) -> name
        .TraitObject(names) -> {
            loop name in names -> self.record_type_import_name_use(name)
            return
        }
        else -> return
    }
    self.record_type_import_name_use(name)
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:160
pub fn record_type_import_name_use(self: &Checker, name: String) -> {
    alias :: name.split_once('.').map_or(name, parts -> parts.0)
    if self.lookup(alias).is_none() && (self.core_imports.contains_key(alias)
        || self.core_item_imports.contains_key(alias) || self.imports.contains_key(alias)
        || self.name_ledger.alias(self.module_idx, alias).is_some_and(binding -> binding.target_module.is_some())) {
        self.record_import_alias_use(alias)
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:175
pub fn resolve_type(self: &Checker, ty: Type) -> Type {
    self.record_type_import_use(ty)
    if ty == {
        // Typed numeric heads denote primitive carriers (D-NUMOPS1).
        .Named(n) if numeric_type_from_name(n).is_some() -> numeric_type_from_name(n).expect("numeric head was checked")
        // Dynamic encoding aliases all unify as Data (D-ENC-DYN1=A+).
        .Named(n) if Syntax.is_data_type_name(n) -> Type.Named(Syntax.TYPE_DATA)
        .Named(n) if Syntax.typed_head_kind(n).is_some_and(kind -> kind.internal_type_name() != n) -> {
            Type.Named(Syntax.typed_head_kind(n).expect("descriptor guard checked above").internal_type_name())
        }
        // Generated rule enums are decided by the rule table.
        .Named(n) if self.core_item_imports.get(n).zip(self.core_imports.get(n)).is_some_and(pair -> core_module_type_item(pair.1, pair.0)) -> {
            module :: self.core_imports.get(n).expect("Core item imports have a module alias")
            if module == "core.crypto" -> self.core_crypto_struct_type(n) ?? core_crypto_nominal(Type.Named(n))
            else {
                item :: self.core_item_imports.get(n) ?? n
                Type.Named(self.core_nominal_shadowing_builtin(module, item) ?? n)
            }
        }
        .Named(n) if n.rsplit_once('.').is_some_and(pair -> self.core_imports.get(pair.0).is_some_and(module -> module == "core.compiler.lang" && rule_arg_declaration(pair.1).is_some())) -> {
            Type.Named(n.rsplit_once('.').unwrap().1)
        }
        // Other qualified Core imports resolve through the shared exports table.
        .Named(n) if n.rsplit_once('.').is_some_and(pair -> self.core_imports.get(pair.0).is_some_and(module -> core_leaf_kind(module, pair.1).is_some())) -> {
            (alias, leaf) :: n.rsplit_once('.').unwrap()
            module :: self.core_imports.get(alias).unwrap()
            if module == "core.crypto" -> self.core_crypto_struct_type(n) ?? core_crypto_nominal(Type.Named(leaf))
            else -> Type.Named(self.core_nominal_shadowing_builtin(module, leaf) ?? leaf)
        }
        .Named(n) if n.rsplit_once('.').is_some_and(pair -> self.imports.get(pair.0).is_some_and(idx -> self.modules.is_some_and(modules -> modules[idx].registry.contains(pair.1) || modules[idx].trait_reg.is_trait_name(pair.1)))) -> {
            (alias, leaf) :: n.rsplit_once('.').unwrap()
            if self.modules.is_some_and(modules -> self.imports.get(alias).is_some_and(idx -> modules[idx].trait_reg.is_trait_name(leaf))) -> Type.TraitObject([leaf])
            else -> self.imported_nominal_type(n) ?? Type.Named(n)
        }
        .Named(n) if self.trait_reg.is_trait_name(n) && !self.registry.contains(n) -> Type.TraitObject([n])
        .Named(n) -> self.imported_nominal_type(n) ?? Type.Named(n)
        .List(inner) -> Type.List(self.resolve_type(inner))
        .Shared(inner) -> Type.Shared(self.resolve_type(inner))
        .Apply(name, args) -> {
            if self.registry.is_type_alias(name) {
                if self.registry.type_alias(name) == .Val((params, target)) {
                    subst := [String:Type]{}
                    loop (p, a) in params.zip(args) -> &subst.insert(p.name, a)
                    expanded :: substitute_type(target, subst)
                    return self.resolve_type(expanded)
                }
            }
            Type.Apply(self.imported_nominal_head(name), args.map(a -> self.resolve_type(a)))
        }
        .Option(inner) -> Type.Option(self.resolve_type(inner))
        .Map(key, key_span, value) -> Type.Map(self.resolve_type(key), key_span, self.resolve_type(value))
        .Result(ok, err) -> Type.Result(self.resolve_type(ok), self.resolve_type(err))
        .Tuple(fields) -> Type.Tuple(fields.map(field -> (field.0, self.resolve_type(field.1))))
        .FixedList(elem, len) -> Type.FixedList(self.resolve_type(elem), len)
        .InlineRange(base, lo, hi) -> Type.InlineRange(self.resolve_type(base), lo, hi)
        .Fn{params, ret, effect_bound, param_contract, call_metadata, return_view_provenance} -> Type.Fn{
            params: params.map(ty -> self.resolve_type(ty)),
            ret: ret.map(ty -> self.resolve_type(ty)),
            effect_bound: effect_bound, param_contract: param_contract,
            call_metadata: call_metadata, return_view_provenance: return_view_provenance
        }
        .Tagged(.Internal(.CoreCryptoNominal), inner) -> Type.Tagged(TagMarker.Internal(InternalTag.CoreCryptoNominal), inner)
        .Tagged(marker, inner) -> Type.Tagged(marker, self.resolve_type(inner))
        .Union(members) -> canonicalize_union(members.map(m -> self.resolve_type(m)))
        .Int -> Type.Int
        .Float -> Type.Float
        .Bool -> Type.Bool
        .String -> Type.String
        .Char -> Type.Char
        .TraitObject(names) -> Type.TraitObject(names)
        .IntN(signed, bits) -> Type.IntN(signed, bits)
        .Float32 -> Type.Float32
        .Quantity(base, dimension) -> Type.Quantity(self.resolve_type(base), dimension)
        .Measure(measure) -> Type.Measure(measure)
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:393
// Resolve a transparent return alias before projecting its failure carrier.
pub fn checked_return_types(self: &Checker, return_type: Type?, raw_protocol_return: Bool) -> (Type, Type) {
    has_declared_return :: return_type.is_some()
    declared :: return_type.map(ty -> self.resolve_type(ty))
    source :: declared ?? (if raw_protocol_return -> Type.Named(Syntax.INTERNAL_UNIT_TYPE)
        else -> FailureContract.from_return_type(None).effective_type())
    effective :: if raw_protocol_return -> source
        else if has_declared_return -> FailureContract.from_return_type(declared).effective_type()
        else -> source
    (source, effective)
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:420
// Publish the canonical return for body checking, signatures and TIR.
pub fn canonicalize_function_return_type(self: &Checker, function: &Func) -> {
    function.return_type = function.return_type.take().map(ty -> self.resolve_type(ty))
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:429
// Validate imported #Error domains in their owning registry.
pub fn is_error_domain(self: Checker, ty: Type) -> Bool {
    // Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:435
    fn visit(checker: Checker, ty: Type) -> Bool {
        if checker.registry.is_error_domain(ty) -> return true
        if ty == {
            .Union(members) -> !members.is_empty() && members.all(member -> visit(checker, member))
            .Named(name) -> {
                (_, leaf) :: Checker.split_type_name(name)
                checker.imported_error_registry(name).is_some_and(registry -> registry.is_error_domain(Type.Named(leaf)))
            }
            .Apply(name, args) -> {
                (_, leaf) :: Checker.split_type_name(name)
                checker.imported_error_registry(name).is_some_and(registry -> registry.is_error_domain(Type.Apply(leaf, args)))
            }
            else -> false
        }
    }
    visit(self, ty)
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:469
fn imported_error_registry(self: Checker, name: String) -> TypeRegistry? {
    (import_ns, leaf) :: Checker.split_type_name(name)
    owner :: self.struct_owner_module(leaf, import_ns) ?? return None
    if owner == self.module_idx -> Val(self.registry)
    else -> self.modules.and_then(modules -> modules.get(owner)).map(module -> module.registry)
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:479
pub fn type_param_has_bound(self: Checker, ty: Type, bound: String) -> Bool {
    if ty == {
        .Named(n) -> self.type_param_scope.find(p -> p.name == n).is_some_and(p -> p.bounds.any(b -> b == bound))
        else -> false
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:490
pub fn struct_subst(self: Checker, type_name: String, type_args: [Type]) -> [String:Type] {
    (import_ns, leaf) :: Checker.split_type_name(type_name)
    owner :: self.struct_owner_module(leaf, import_ns) ?? self.module_idx
    self.struct_subst_for_owner(owner, leaf, type_args)
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:502
pub fn struct_type_param_count(self: Checker, owner_mod: Int, type_name: String) -> Int {
    leaf :: Checker.split_type_name(type_name).1
    if owner_mod == self.module_idx -> self.trait_reg.struct_params.get(leaf).or_else(() -> self.trait_reg.enum_params.get(leaf)).map_or(0, params -> params.len())
    else -> self.modules.and_then(modules -> modules.get(owner_mod)).and_then(module -> module.trait_reg.struct_params.get(leaf).or_else(() -> module.trait_reg.enum_params.get(leaf))).map_or(0, params -> params.len())
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:525
pub fn struct_subst_for_owner(self: Checker, owner_mod: Int, type_name: String, type_args: [Type]) -> [String:Type] {
    leaf :: Checker.split_type_name(type_name).1
    params :: (if owner_mod == self.module_idx -> self.trait_reg.struct_params.get(leaf).or_else(() -> self.trait_reg.enum_params.get(leaf))
        else -> self.modules.and_then(modules -> modules.get(owner_mod)).and_then(module -> module.trait_reg.struct_params.get(leaf).or_else(() -> module.trait_reg.enum_params.get(leaf)))) ?? []
    subst := [String:Type]{}
    if params.is_empty() -> return subst
    if type_args.is_empty() {
        loop p in params -> &subst.insert(p.name, Type.Named(p.name))
    } else {
        loop (p, a) in params.zip(type_args) -> &subst.insert(p.name, a)
    }
    subst
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/types.rs:568
pub fn instantiate_type_for_owner(self: Checker, owner_mod: Int, ty: Type, subst: [String:Type]) -> Type {
    if owner_mod == self.module_idx -> self.trait_reg.instantiate_type(ty, subst)
    else -> self.modules.and_then(modules -> modules.get(owner_mod)).map(module -> module.trait_reg.instantiate_type(ty, subst)) ?? substitute_type(ty, subst)
}
