// Sema's checked loop proofs (#3039). Once a function's body is flat and
// typed (body_flat_function), each counted loop `loop i in a..<b` whose body
// sema can read completely gets AutoVectorizationFacts on its ForRange
// statement. That fact is the only one JetIR's range loop reads
// (ir_range_loop); lowering never re-derives eligibility. A `#Scalar` function,
// a stepped or non-literal range, or a body containing a shape this file does
// not read gets no facts, so lowering keeps the checked scalar path.
//
// The verdicts:
// - extent: `a` and `b` are Int literals with a >= 0 and the body neither
//   rebinds nor assigns `i`, so every read of `i` lies in a..<b (a..=b ends
//   at b + 1);
// - proven_indexes: the reads and writes `xs[i]` of a local fixed list
//   `[T#N]` with N >= extent, which cannot leave the list;
// - no_early_exit: no return, break or continue;
// - effect_free_body: no call, no trapping (checked) integer operator and no
//   list access outside proven_indexes, which could stop the round;
// - no_cross_iteration_deps: every write is `xs[i]` (op)= ... and no list
//   written at `i` is read at another position; a variable written each round
//   (a reduction) carries a value into the next one;
// - no_aliasing: every list read or written is a local's own value.
use jet_foundation.[AutoVectorizationFacts, BodyIfCond, BodyPlace, BodyTree, NodeKind, StmtKind, Type, body_node, body_stmt, body_type, measure_literal_value]

// What a scan of one loop body has read so far.
SemaLoopScan: struct {
    local: String
    extent: Int
    readable: Bool
    early_exit: Bool
    effect_free: Bool
    independent: Bool
    aliasing_free: Bool
    element: Type?
    proven: [Int]
    // The lists written at `i`, and the lists read at another position.
    written: [String]
    read_elsewhere: [String]
}

// Records the facts of every counted loop of `tree` that sema can prove
// (none in a `#Scalar` function).
sema_loop_facts: fn(tree: &BodyTree, scalar: Bool) Never! {
    if scalar -> return
    loop index in 0..<tree.stmts.len() {
        if tree.stmts[index] == {
            .ForRange(label, local, start, end, step, exclusive, body, vectorization, span) -> {
                if vectorization != None -> next
                facts: sema_loop_range_facts(tree, local.name, start, end, step, exclusive, body) ?? next
                tree.stmts[index] = StmtKind.ForRange{label: label, local: local, start: start, end: end, step: step, exclusive: exclusive, body: body, vectorization: Val(facts), span: span}
            }
            .Range(label, variable, source, start, end, step, exclusive, vectorization, body, span) -> {
                if vectorization != None || source != None -> next
                facts: sema_loop_range_facts(tree, variable.name, start, end, step, exclusive, body) ?? next
                tree.stmts[index] = StmtKind.Range{label: label, variable: variable, source: source, start: start, end: end, step: step, exclusive: exclusive, vectorization: Val(facts), body: body, span: span}
            }
            .Contract(_) | .ContractScope(_, _, _, _, _) | .Let(_, _, _, _, _, _) | .RefutableBind(_, _, _, _) | .TupleDestructure(_, _, _, _, _) | .StructDestructure(_, _, _, _, _) | .ListDestructure(_, _, _, _, _, _) | .Assign(_, _, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .ExprStmt(_, _) | .Return(_, _) | .TaskGroup(_, _, _, _) | .DeferClose(_, _, _) | .If(_, _, _, _, _) | .Loop(_, _, _) | .While(_, _, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) | .Match(_, _, _, _) | .EnumMatch(_, _, _, _, _) | .RangeSwitch(_, _, _, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, _, _) | .Inline(_, _) | .DebugOnly(_, _) | .DeepCheck(_, _) | .MixedSwitch(_, _, _, _, _) | .Unsafe(_, _) | .UnsafeBlock(_, _, _) | .SentryPolicy(_, _, _) | .Impure(_, _) | .Reactive(_, _) | .Region(_, _) | .Layout(_, _, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .Shield(_, _) | .Defer(_, _) | .ScopeMember(_, _, _) | .Transact(_, _, _, _, _) | .GCEdit(_, _, _, _, _, _, _) -> {}
        }
    }
}

// The facts of one counted loop over `local`, or None when its range or body
// is outside what this pass reads.
sema_loop_range_facts: fn(tree: BodyTree, local: String, start: Int, end: Int, step: Int?, exclusive: Bool, body: [Int]) -> AutoVectorizationFacts? Never! {
    if step != None -> return None
    low: sema_loop_int_literal(tree, start) ?? return None
    high: sema_loop_int_literal(tree, end) ?? return None
    if low < 0 || high >= SEMA_LOOP_EXTENT_LIMIT -> return None
    extent: if exclusive -> high else -> high + 1
    scan := SemaLoopScan{local: local, extent: extent, readable: true, early_exit: false, effect_free: true, independent: true, aliasing_free: true, element: None, proven: [Int]{}, written: [String]{}, read_elsewhere: [String]{}}
    loop row in body -> sema_loop_scan_stmt(tree, row, scan)
    if !scan.readable -> return None
    loop name in scan.read_elsewhere {
        if scan.written.contains(name) -> scan.independent = false
    }
    element: scan.element ?? return None
    Val(AutoVectorizationFacts{element_type: element, no_aliasing: scan.aliasing_free, no_early_exit: !scan.early_exit, effect_free_body: scan.effect_free, no_cross_iteration_deps: scan.independent, extent: Val(extent), proven_indexes: scan.proven})
}

// The range ends this pass reads (an inclusive end of Int.MAX has no extent).
SEMA_LOOP_EXTENT_LIMIT: 4611686018427387904

sema_loop_int_literal: fn(tree: BodyTree, id: Int) -> Int? Never! {
    if body_node(tree, id).kind == .IntLit(value, _) -> return Val(value)
    None
}

sema_loop_scan_stmt: fn(tree: BodyTree, row: Int, scan: &SemaLoopScan) Never! {
    statement: body_stmt(tree, row)
    if statement == {
        .Assign(place, op, value, _, _) -> {
            // A compound write of anything but a Float can overflow or divide by zero.
            if op != None && body_type(tree, value) != Type.Float -> scan.effect_free = false
            if place == {
                .Local(target) -> {
                    if target.name == scan.local -> scan.readable = false
                    scan.independent = false
                }
                .Expr(target) -> sema_loop_scan_write(tree, target, scan)
            }
            sema_loop_scan_expr(tree, value, scan)
        }
        .Let(bound, _, init, _, _, _) -> {
            if bound.name == scan.local -> scan.readable = false
            sema_loop_scan_expr(tree, init, scan)
        }
        .ExprStmt(value, _) -> sema_loop_scan_expr(tree, value, scan)
        .If(condition, then_body, else_body, _, _) -> {
            sema_loop_scan_condition(tree, condition, scan)
            loop inner in then_body -> sema_loop_scan_stmt(tree, inner, scan)
            if else_body == .Val(rows) {
                loop inner in rows -> sema_loop_scan_stmt(tree, inner, scan)
            }
        }
        .Return(value, _) -> {
            scan.early_exit = true
            if value == .Val(returned) -> sema_loop_scan_expr(tree, returned, scan)
        }
        .Break(_, _) | .Continue(_, _) -> scan.early_exit = true
        .Inline(rows, _) -> loop inner in rows -> sema_loop_scan_stmt(tree, inner, scan)
        .Contract(_) | .ContractScope(_, _, _, _, _) | .RefutableBind(_, _, _, _) | .TupleDestructure(_, _, _, _, _) | .StructDestructure(_, _, _, _, _) | .ListDestructure(_, _, _, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .ForRange(_, _, _, _, _, _, _, _, _) | .Range(_, _, _, _, _, _, _, _, _, _) | .TaskGroup(_, _, _, _) | .DeferClose(_, _, _) | .Loop(_, _, _) | .While(_, _, _, _) | .BreakValue(_, _, _) | .Match(_, _, _, _) | .EnumMatch(_, _, _, _, _) | .RangeSwitch(_, _, _, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, _, _) | .DebugOnly(_, _) | .DeepCheck(_, _) | .MixedSwitch(_, _, _, _, _) | .Unsafe(_, _) | .UnsafeBlock(_, _, _) | .SentryPolicy(_, _, _) | .Impure(_, _) | .Reactive(_, _) | .Region(_, _) | .Layout(_, _, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .Shield(_, _) | .Defer(_, _) | .ScopeMember(_, _, _) | .Transact(_, _, _, _, _) | .GCEdit(_, _, _, _, _, _, _) -> scan.readable = false
    }
}

sema_loop_scan_condition: fn(tree: BodyTree, condition: BodyIfCond, scan: &SemaLoopScan) Never! {
    if condition == {
        .Plain(value) -> sema_loop_scan_expr(tree, value, scan)
        .And(left, right) -> {
            sema_loop_scan_condition(tree, left, scan)
            sema_loop_scan_condition(tree, right, scan)
        }
        .IfLet(_, _) -> scan.readable = false
    }
}

// A write through place expression `target`: `xs[i]` of a local list keeps
// the rounds independent; any other place does not.
sema_loop_scan_write: fn(tree: BodyTree, target: Int, scan: &SemaLoopScan) Never! {
    if body_node(tree, target).kind == .Index(base, index, _, _, _, _) {
        if scan.element == None -> scan.element = Val(body_type(tree, target))
        name: sema_loop_local_name(tree, base) ?? ""
        if sema_loop_scan_access(tree, base, index, scan) && name != "" {
            if !scan.written.contains(name) -> scan.written.push(name)
        } else {
            scan.independent = false
        }
        sema_loop_scan_expr(tree, index, scan)
        return
    }
    scan.independent = false
    sema_loop_scan_expr(tree, target, scan)
}

// One read or write `base[index]`: whether it is at the loop index. An access
// at the index of a local fixed list the extent covers is proven; any other
// may stop the round.
sema_loop_scan_access: fn(tree: BodyTree, base: Int, index: Int, scan: &SemaLoopScan) -> Bool Never! {
    name: sema_loop_local_name(tree, base) ?? ""
    if name == "" -> scan.aliasing_free = false
    at_index: (sema_loop_local_name(tree, index) ?? "") == scan.local
    length: sema_loop_fixed_length(body_type(tree, base)) ?? -1
    if at_index && name != "" && length >= scan.extent {
        scan.proven.push(index)
    } else {
        scan.effect_free = false
    }
    at_index
}

// The length of a fixed list `[T#N]` with a literal N.
sema_loop_fixed_length: fn(ty: Type) -> Int? Never! {
    if ty == {
        .Tagged(_, inner) -> return sema_loop_fixed_length(inner)
        .FixedList(_, length) -> return measure_literal_value(length)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return None
    }
}

sema_loop_local_name: fn(tree: BodyTree, id: Int) -> String? Never! {
    if body_node(tree, id).kind == .Local(local) -> return Val(local.name)
    None
}

sema_loop_scan_expr: fn(tree: BodyTree, id: Int, scan: &SemaLoopScan) Never! {
    node: body_node(tree, id)
    if node.kind == {
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .Local(_) | .ConstRef(_) | .TraitConst(_, _, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) | .Unit -> {}
        .Binary(_, overflow, _, lhs, rhs) -> {
            // Float arithmetic and comparisons cannot stop; integer
            // arithmetic can overflow or divide by zero.
            ty: body_type(tree, id)
            if overflow || (ty != Type.Float && ty != Type.Bool) -> scan.effect_free = false
            sema_loop_scan_expr(tree, lhs, scan)
            sema_loop_scan_expr(tree, rhs, scan)
        }
        .CompareChain(operands, _, _) -> loop operand in operands -> sema_loop_scan_expr(tree, operand, scan)
        .Unary(_, operand) -> {
            // An Int negation can overflow; Float and Bool operators cannot stop.
            ty: body_type(tree, id)
            if ty != Type.Float && ty != Type.Bool -> scan.effect_free = false
            sema_loop_scan_expr(tree, operand, scan)
        }
        .Move(value) | .Clone(value, _) | .ExplicitCopy(value) -> sema_loop_scan_expr(tree, value, scan)
        .Field(receiver, _) -> sema_loop_scan_expr(tree, receiver, scan)
        .Index(base, index, _, _, _, _) -> {
            if scan.element == None -> scan.element = Val(body_type(tree, id))
            if !sema_loop_scan_access(tree, base, index, scan) {
                name: sema_loop_local_name(tree, base) ?? ""
                if name != "" -> scan.read_elsewhere.push(name)
            }
            sema_loop_scan_expr(tree, base, scan)
            sema_loop_scan_expr(tree, index, scan)
        }
        .Call(_, _, args) -> {
            scan.effect_free = false
            loop arg in args -> sema_loop_scan_expr(tree, arg.value, scan)
        }
        .StrLit(_) | .InlineBlock(_) | .Uninit | .CtLit(_) | .GlobalShared(_, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .RequireStop(_, _, _) | .StructLit(_) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) -> scan.readable = false
    }
}
