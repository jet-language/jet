use jet_foundation.[
    TField,
    TTypeDef,
    Type,
    ModuleID,
    core_identity_in_module,
    module_is_none,
]

SemaSerdeDirection: enum {
    Encode
    Decode
}

sema_serde_codec_name: fn(direction: SemaSerdeDirection) -> String Never! {
    if direction == SemaSerdeDirection.Encode -> "Encode" else -> "Decode"
}

sema_serde_named_leaf: fn(name: String) -> String Never! {
    // A plain name (no `::` or `.` path, "" included) is its own leaf.
    if !name.contains(":") && !name.contains(".") -> return name.copy()
    path := name.split("::").to_list()
    leaf: if path.len() > 0 -> path[path.len() - 1] else -> name
    parts := leaf.split(".").to_list()
    if parts.len() > 0 -> parts[parts.len() - 1] else -> leaf
}

sema_serde_type_definition: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, name: String) -> TTypeDef? {
    sema_serde_type_definition_in(environment, program, environment.module_identity, name)
}

// The checked declaration `name` names as module `module_identity` reads it.
sema_serde_type_definition_in: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID, name: String) -> TTypeDef? {
    if program.registration_graph == .Val(graph) {
        // A resolved type carries its canonical identity (`module::Name`),
        // which the graph lookup resolves in its declaring module.
        resolved: sema_type_graph_lookup_symbol(graph, module_identity, name) ?? return None
        row: sema_scope_checked_type_row(environment, program, resolved.target_module_identity, sema_resolved_name(graph, resolved)) ?? return None
        return Val(program.checked_types[row])
    }
    leaf := sema_serde_named_leaf(name)
    loop definition in program.checked_types {
        // A checked key is the qualified `module::Name` spelling.
        if definition.key == name || (definition.name == leaf && name == leaf) -> return Val(definition)
    }
    None
}

sema_serde_has_name: fn(values: [String], name: String) -> Bool Never! {
    loop value in values {
        if value == name -> return true
    }
    false
}

// E2411's fix for a type with no `direction` codec.
sema_serde_wire_fix: fn(shown: String, direction: SemaSerdeDirection) -> String Never! {
    "add `#[Codable]` or `#[{sema_serde_codec_name(direction)}]` to {shown}, or remove it from the encoded value"
}

// E2411's fix for a distinct type with no `direction` codec: it codes as its
// base only through `#CodableAsBase` (D-CAPBUNDLE1); the struct and enum
// markers do not apply to it.
sema_serde_distinct_wire_fix: fn(shown: String, direction: SemaSerdeDirection) -> String Never! {
    "add `#CodableAsBase` to {shown} so it is {if direction == SemaSerdeDirection.Encode -> "encoded" else -> "decoded"} as its base type, or remove it from the encoded value"
}

sema_serde_implementation: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, definition: TTypeDef, direction: SemaSerdeDirection) -> Bool Never! {
    if sema_serde_has_name(definition.derives, sema_serde_codec_name(direction)) || sema_serde_has_name(definition.derives, "Codable") -> return true
    if program.registration_graph == .Val(graph) {
        wanted: sema_serde_codec_name(direction)
        loop module_row_index in 0..<graph.modules.len() {
            loop implementation_index in 0..<graph.modules[module_row_index].impls.len() {
                trait_name: graph.modules[module_row_index].impls[implementation_index].trait_name ?? next
                if sema_serde_named_leaf(trait_name) != wanted -> next
                target_module := graph.modules[module_row_index].impls[implementation_index].target_module_identity
                if module_is_none(target_module) -> target_module = graph.modules[module_row_index].impls[implementation_index].source_module_identity
                if target_module == definition.module_identity && graph.modules[module_row_index].impls[implementation_index].target_type_name == definition.name -> return true
            }
        }
        // An `impl Decode { … }` block in the type's own body. Read in place.
        module_index: sema_registration_module_index(graph, definition.module_identity) ?? return false
        loop nominal_index in 0..<graph.modules[module_index].nominals.len() {
            if graph.modules[module_index].nominals[nominal_index].symbol.name != definition.name -> next
            if graph.modules[module_index].nominals[nominal_index].source == .SourceAST(item) {
                loop block in sema_registration_item_trait_blocks(item) {
                    if sema_serde_named_leaf(block.trait_name) == wanted -> return true
                }
            }
        }
    }
    false
}

sema_serde_generic_bound: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, name: String, direction: SemaSerdeDirection) -> Bool Never! {
    loop parameter in environment.generic_params {
        if parameter.name != name -> next
        codec := sema_serde_codec_name(direction)
        if parameter.bounds.len() > 0 {
            loop bound in parameter.bounds {
                if sema_program_symbol_key(program, bound).ends_with(":{codec}") -> return true
            }
        }
    }
    false
}

sema_serde_mentions_parameter: fn(ty: Type, name: String) -> Bool Never! {
    if ty == {
        .Named(candidate) -> candidate == name
        .List(inner) | .Shared(inner) | .Option(inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Tagged(_, inner) | .Case(_, inner) -> sema_serde_mentions_parameter(inner, name)
        .Map(key, _, value) | .Result(key, value) -> sema_serde_mentions_parameter(key, name) || sema_serde_mentions_parameter(value, name)
        .Tuple(fields) -> {
            loop field in fields {
                if sema_serde_mentions_parameter(field.ty, name) -> return true
            }
            false
        }
        .Union(members) -> {
            loop member in members {
                if sema_serde_mentions_parameter(member, name) -> return true
            }
            false
        }
        .Apply(_, args) -> {
            loop arg in args {
                if sema_serde_mentions_parameter(arg, name) -> return true
            }
            false
        }
        .Quantity(base, _) -> sema_serde_mentions_parameter(base, name)
        .Int | .Float | .Bool | .String | .Char | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> false
    }
}

sema_serde_field_reaches_wire: fn(field: TField, param: String) -> Bool Never! {
    !field.skip && sema_serde_mentions_parameter(field.ty, param)
}

sema_serde_definition_reaches_parameter: fn(definition: TTypeDef, param: String) -> Bool Never! {
    if definition.kind == {
        .Struct(fields, _) -> {
            loop field in fields {
                if sema_serde_field_reaches_wire(field, param) -> return true
            }
        }
        .Enum(variants, _) -> {
            loop variant in variants {
                if variant.payload == {
                    .Single(ty) -> {
                        if sema_serde_mentions_parameter(ty, param) -> return true
                    }
                    .Named(fields) -> {
                        loop field in fields {
                            if sema_serde_field_reaches_wire(field, param) -> return true
                        }
                    }
                    .Unit -> {}
                }
            }
        }
        .Distinct(base, _) | .Alias(base) -> return sema_serde_mentions_parameter(base, param)
        .UnitFamily(_, _) -> {}
    }
    false
}

sema_serde_apply_head: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID, name: String, args: [Type], direction: SemaSerdeDirection) -> Bool Never! {
    definition: sema_serde_type_definition_in(environment, program, module_identity, name) ?? return false
    if !sema_serde_implementation(environment, program, definition, direction) -> return false
    if definition.generic_params.len() == 0 -> return args.len() == 0
    if args.len() != definition.generic_params.len() -> return false
    loop (index, parameter) in definition.generic_params {
        if sema_serde_definition_reaches_parameter(definition, parameter.name) && !sema_serde_type_is_admissible_in(environment, program, module_identity, args[index], direction) -> return false
    }
    true
}

sema_serde_core_data_name: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID, name: String, direction: SemaSerdeDirection) -> Bool Never! {
    if name != "Dyn" && name != "JSON" && name != "TOML" && name != "YAML" && name != "CSV" -> return false
    if direction == SemaSerdeDirection.Decode && name != "Dyn" -> return false
    definition: sema_serde_type_definition_in(environment, program, module_identity, name) ?? return true
    if program.registration_graph == .Val(graph) {
        module_index: sema_registration_module_index(graph, definition.module_identity) ?? return false
        return graph.modules[module_index].module_name == "core.data" || graph.modules[module_index].module_name == "core.encoding"
    }
    true
}

sema_serde_type_is_admissible: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type, direction: SemaSerdeDirection) -> Bool Never! {
    sema_serde_type_is_admissible_in(environment, program, environment.module_identity, ty, direction)
}

// Whether `ty`, as module `module_identity` names it, has the `direction`
// codec; generic parameters are `environment`'s.
sema_serde_type_is_admissible_in: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID, ty: Type, direction: SemaSerdeDirection) -> Bool Never! {
    resolved := ty
    if program.registration_graph == .Val(graph) {
        resolved = sema_type_resolve_declared_with_generics(graph, ty, module_identity, environment.generic_params)
        // Demand: a data codec call requires the codecs of the
        // types it encodes or decodes.
        sema_codec_demand_type(graph, sema_serde_codec_name(direction), resolved)
    }
    return if resolved == {
        .Int | .Float | .Bool | .String | .Char | .Float32 | .IntN(_, _) | .InlineRange(_, _, _) -> true
        .List(inner) | .Option(inner) | .Shared(inner) | .FixedList(inner, _) -> sema_serde_type_is_admissible_in(environment, program, module_identity, inner, direction)
        .Map(key, _, value) -> key == Type.String && sema_serde_type_is_admissible_in(environment, program, module_identity, value, direction)
        .Union(members) -> {
            loop member in members {
                if !sema_serde_type_is_admissible_in(environment, program, module_identity, member, direction) -> return false
            }
            true
        }
        .Tagged(_, _) | .Case(_, _) -> false
        .Named(name) -> {
            if name == "Decimal" || name == "Date" || name == "LocalDate" || name == "LocalTime" || name == "DateTime" || name == "Duration" -> return true
            // Rust `is_encodable`/`is_decodable`: Core's ZonedDateTime is the
            // `Dyn.DateTime` payload, a built-in codec with no source impl.
            if sema_serde_named_leaf(name) == "ZonedDateTime" && (name == "ZonedDateTime" || core_identity_in_module(name, "core.time")) -> return true
            if sema_serde_core_data_name(environment, program, module_identity, name, direction) -> return true
            if direction == SemaSerdeDirection.Decode && name == "Secret" -> return true
            if sema_serde_generic_bound(environment, program, name, direction) -> return true
            definition: sema_serde_type_definition_in(environment, program, module_identity, name) ?? return false
            sema_serde_implementation(environment, program, definition, direction)
        }
        .Apply(name, args) -> sema_serde_apply_head(environment, program, module_identity, name, args, direction)
        .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}
