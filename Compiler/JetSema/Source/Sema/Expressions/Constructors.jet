// Checked struct and enum construction expressions.
use jet_foundation.[
    AccessConvention,
    ByteTextPart,
    Call,
    CallArg,
    Diagnostic,
    EnumLitArg,
    Expr,
    ExprField,
    ExprPair,
    Field,
    MIRTargetHardwareUse,
    MIRTypedHeadKind,
    ParamZone,
    Span,
    StrFormat,
    StrPart,
    Symbol,
    SymbolKind,
    TCoercionTarget,
    TComptimeValue,
    TEnumArg,
    TEnumPayload,
    TExpr,
    TExprKind,
    TFailureCarrier,
    TFieldRef,
    THostCall,
    TNamedEnumArg,
    TStrPart,
    TStructFieldValue,
    Type,
    TypeTupleField,
    TypedLitBody,
    Variant,
    ast_empty_call_arg_flags,
    core_enum_payload_variants,
    core_enum_variant_payload,
    core_enum_variants,
    core_record_literal_fields,
    core_call,
    expr_span,
    regex_syntax_validate,
    symbol_id,
    type_identity_key,
    tir_call_arg_copy_fact,
    type_name,
]

// D-MOD2: a type named by a local binding, through a module alias
// (`types.Kind`), or by the canonical identity a declared type resolves to
// (`module::Kind`, the form declared types carry after resolution) is the
// declared type itself, so constructors, leading-dot variants and field reads
// resolve it through the registration graph when no local type binding has
// that name.
fn sema_expression_type_symbol(scopes: &SemaScopeTable, environment: SemaScopeEnvironment, name: String) -> Symbol? {
    index := sema_scope_resolve_index(scopes, name)
    if index == .Val(found) {
        symbol :: scopes.bindings[found].symbol
        if symbol.kind == SymbolKind.Type -> return Val(symbol)
    }
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return None
    resolved :: sema_type_graph_lookup_symbol(graph, environment.module_identity, name) ?? return None
    if resolved.symbol.kind == SymbolKind.Type -> Val(resolved.symbol) else -> None
}

// Rust `infer_field` (`is_known_enum`): `Name.Variant` reads a variant when
// `Name` is a declared enum, a compiler-owned enum menu (`Ordering`,
// `RemoveBy`, the fact enums) or a Core enum, and no value binding shadows it.
fn sema_expression_names_enum(name: String, environment: SemaScopeEnvironment, scopes: &SemaScopeTable) -> Bool {
    index := sema_scope_resolve_index(scopes, name)
    if index == .Val(found) && scopes.bindings[found].symbol.kind != SymbolKind.Type -> return false
    if sema_fact_enum_menu(Type.Named{name: name}, environment) != None -> return true
    owner := sema_expression_type_symbol(&scopes, environment, name)
    if owner == .Val(symbol) {
        if sema_scope_declaration_is(environment, symbol.id, SemaScopeDeclarationKind.Enum) -> return true
    }
    sema_expression_core_enum_name(name)
}

// The tail of Rust `is_known_enum`: Core enum leaves
// (`CoreModuleExports::core_enum_variants`) and the compiler-owned Core enum
// families, known whether or not the program imports them.
fn sema_expression_core_enum_name(name: String) -> Bool Never! {
    if core_enum_variants(name) != None || core_enum_payload_variants(name) != None -> return true
    if name == {
        "Key" | "ProcessSignal" | "TextWidthAmbiguous" | "TextWidthControls" |
        "WatchDomain" | "WatchKind" | "DurationUnit" | "LateEventDisposition" |
        "Overflow" | "FailurePolicy" | "DispatchState" | "HookPolicy" | "HookDecision" | "HookOutcome" |
        "NetShutdown" | "NetReadyInterest" | "NetError" | "NetDnsError" |
        "SMTPSecurity" | "RecipientPolicy" | "EmailError" | "AuthError" |
        "DeliveryState" | "ServiceError" | "TaskOutcome" | "TaskStatus" -> true
        else -> false
    }
}

struct SemaExpressionEnumPath {
    enum_name: String
    variant: String
}

fn sema_expression_path_segments(expression: Expr) -> [String]? {
    if expression == {
        .Ident(name, _) -> Val([String]{name})
        .Field(inner, member, _) -> {
            segments := sema_expression_path_segments(inner) ?? return None
            &segments.push(member)
            Val(segments)
        }
        else -> None
    }
}

fn sema_expression_join_segments(segments: [String], start: Int) -> String Never! {
    parts := [String]{}
    loop index in start..<segments.len() -> &parts.push(segments[index])
    parts.join(".")
}

// Rust `fold_enum_variant_path`: the field chain `base.member` names a variant
// when its root is a known enum (`Kind.Beta`, grouped `Kind.Group.Leaf`), or a
// module alias whose next segment is one (`types.Kind.Beta`). A local value
// root names no variant.
fn sema_expression_enum_variant_path(base: Expr, member: String, environment: SemaScopeEnvironment, scopes: &SemaScopeTable) -> SemaExpressionEnumPath? {
    segments := sema_expression_path_segments(base) ?? return None
    &segments.push(member)
    root :: segments[0]
    index :: sema_scope_resolve_index(scopes, root)
    if index == .Val(found) {
        kind :: scopes.bindings[found].symbol.kind
        if kind != SymbolKind.Type && kind != SymbolKind.Module -> return None
    }
    if sema_expression_names_enum(root, environment, &scopes) -> return Val(SemaExpressionEnumPath{enum_name: root, variant: sema_expression_join_segments(segments, 1)})
    if segments.len() < 3 -> return None
    qualified :: "{root}.{segments[1]}"
    if !sema_expression_names_enum(qualified, environment, &scopes) -> return None
    Val(SemaExpressionEnumPath{enum_name: qualified, variant: sema_expression_join_segments(segments, 2)})
}

// Rust `infer_method_call` static-owner arm (`resolve_enum_variants`) and
// `fold_enum_variant_path`: `Enum.Variant(args)` / `Enum.Group.Leaf(args)`
// written as a call builds the variant when the enum declares it; any other
// member stays a static method call.
fn sema_expression_enum_variant_call(receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    unhandled :: SemaMethodSpecialCheck{handled: false, value: None}
    if type_args.len() > 0 -> return unhandled
    loop argument in args {
        if argument.label != None || argument.spread -> return unhandled
    }
    path :: sema_expression_enum_variant_path(receiver, method, environment, &scopes) ?? return unhandled
    if !sema_expression_enum_declares_variant(path.enum_name, path.variant, environment, &scopes) -> return unhandled
    enum_args :: loop argument in args -> EnumLitArg.Positional{value: argument.expr}
    end := method_span.end
    if args.len() > 0 && args[args.len() - 1].span.end > end -> end = args[args.len() - 1].span.end
    span :: Span{start: expr_span(receiver).start, end: end}
    SemaMethodSpecialCheck{handled: true, value: sema_expression_enum_literal(path.enum_name, owner_type_args, path.variant, enum_args, false, Val(method_span), span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)}
}

fn sema_expression_enum_declares_variant(enum_name: String, variant: String, environment: SemaScopeEnvironment, scopes: &SemaScopeTable) -> Bool {
    owner :: sema_expression_type_symbol(&scopes, environment, enum_name)
    if owner == .Val(symbol) {
        if sema_scope_declaration_is(environment, symbol.id, SemaScopeDeclarationKind.Enum) -> return sema_scope_declaration_enum_declares(environment, symbol.id, variant)
    }
    core_enum_variant_payload(enum_name, variant) != None
}

// Rust `canonical_nominal_name`: two spellings of one declared nominal
// (`Box`, `types.Box`, `module::Box`) name the same head.
fn sema_expression_same_nominal_head(left: String, right: String, environment: SemaScopeEnvironment) -> Bool Never! {
    if left == right -> return true
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return false
    sema_type_graph_resolve_apply_name(graph, left, environment.module_identity) == sema_type_graph_resolve_apply_name(graph, right, environment.module_identity)
}

struct SemaExpressionResolvedType {
    ty: Type
    owner: Symbol
}

fn sema_expression_struct_type(type_name: String, type_args: [Type], expected: Type?, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaExpressionResolvedType? {
    if type_name == "" {
        expected_ty :: expected ?? {
            &diagnostics.push(sema_error("E0119", span, "an inferred struct literal needs an expected type", "the `{{ ... }}` form uses the surrounding type to choose its fields", "write the struct name or add a type annotation"))
            return None
        }
        normalized :: sema_expr_unwrap_tag(expected_ty)
        if normalized == {
            .Named(name) -> {
                owner :: sema_expression_type_symbol(&scopes, environment, name) ?? {
                    &diagnostics.push(sema_error("E0119", span, "the expected type is not a registered struct", "inferred construction needs declaration metadata for its fields", "name a declared struct type"))
                    return None
                }
                return Val(SemaExpressionResolvedType{ty: normalized, owner: owner})
            }
            .Apply(name, args) -> {
                owner :: sema_expression_type_symbol(&scopes, environment, name) ?? {
                    &diagnostics.push(sema_error("E0119", span, "the expected type is not a registered struct", "inferred construction needs declaration metadata for its fields", "name a declared struct type"))
                    return None
                }
                return Val(SemaExpressionResolvedType{ty: normalized, owner: owner})
            }
            else -> {
                &diagnostics.push(sema_error("E0119", span, "`{{ ... }}` needs a known struct type", "inferred construction requires a nominal struct type from context", "name the type before the fields"))
                return None
            }
        }
    }
    owner :: sema_expression_type_symbol(&scopes, environment, type_name) ?? {
        &diagnostics.push(sema_unknown_name(type_name, span))
        return None
    }
    ty := if type_args.len() > 0 -> Type.Apply{name: type_name, args: type_args} else -> Type.Named{name: type_name}
    if type_args.len() == 0 && expected == .Val(expected_ty) {
        normalized_expected :: sema_expr_unwrap_tag(expected_ty)
        if normalized_expected == .Apply(name, _) {
            if sema_expression_same_nominal_head(name, type_name, environment) -> ty = normalized_expected
        }
    }
    Val(SemaExpressionResolvedType{ty: ty, owner: owner})
}

// One struct field initializer, written or a declared default, checked
// against the field type with the owner's generic arguments substituted. Its
// move is recorded at this point of the literal's evaluation order.
fn sema_expression_struct_field_value(field: Field, field_value: Expr, field_reference_span: Span, owner: Symbol, names: [String], args: [Type], environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStructFieldValue? {
    field_ty :: sema_inference_substitute_type(sema_expression_field_owner_type(environment, owner.module_name, field.ty, names), names, args)
    string_view :: sema_stmt_string_view_type(field_ty)
    if !string_view -> sema_copy_site_check_field(field_value, environment, scopes, &tail_store, &context, &diagnostics)
    checked_value := if string_view -> sema_string_view_check_field(field_value, field_ty, environment, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression_with_lambda_escapes(field_value, Val(field_ty), environment, &scopes, &state, &tail_store, &context, Val(true), &diagnostics)
    checked :: checked_value ?? return None
    compatible :: sema_expr_expected_assignable(field_ty, checked.ty, environment) ?? return None
    if !compatible {
        &diagnostics.push(sema_type_mismatch(sema_expr_expected_type(field_ty, environment), sema_expr_expected_type(checked.ty, environment), expr_span(field_value)))
        return None
    }
    if !string_view && !sema_copy_site_record_move(field_value, scopes, &state, &tail_store, &context, &diagnostics) -> return None
    field_id :: symbol_id(SymbolKind.Field, owner.module_name, owner.id.key, field.name)
    symbol :: Symbol{id: field_id, kind: SymbolKind.Field, name: field.name, module_name: owner.module_name, owner: Val(owner.id.key), span: field.name_span, ty: Val(field_ty), visibility: if field.is_pub -> 2 else -> if field.is_package_pub -> 1 else -> 0}
    &context.name_references.push(SemaNameReferenceFact{span: field_reference_span, symbol: symbol, kind: "field"})
    reference := sema_expression_field_ref(symbol, Val(owner.id), field_ty)
    reference.boxed = sema_scope_environment_boxed_edge(environment, owner.id, field.name)
    Val(TStructFieldValue{field: reference, value: checked, boxed: reference.boxed})
}

// A builtin Core record (`IOContext{...}`, `Tensor{...}`) has no Jet
// declaration; its literal checks against the generated Core record rows.
// A program declaration of the same name takes precedence.
fn sema_expression_core_record_name(struct_name: String, type_args: [Type], expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable) -> String? {
    if type_args.len() > 0 -> return None
    name := struct_name
    if name == "" {
        expected_ty :: expected ?? return None
        name = if sema_expr_unwrap_tag(expected_ty) == {
            .Named(expected_name) -> expected_name
            else -> { return None }
        }
    }
    if sema_expression_type_symbol(&scopes, environment, name) != None -> return None
    if core_record_literal_fields(name) == None -> return None
    Val(name)
}

fn sema_expression_core_record_field_value(owner_name: String, field: TypeTupleField, field_value: Expr, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStructFieldValue? {
    sema_copy_site_check_field(field_value, environment, scopes, &tail_store, &context, &diagnostics)
    checked :: sema_check_expression_with_lambda_escapes(field_value, Val(field.ty), environment, &scopes, &state, &tail_store, &context, Val(true), &diagnostics) ?? return None
    compatible :: sema_expr_expected_assignable(field.ty, checked.ty, environment) ?? return None
    if !compatible {
        &diagnostics.push(sema_type_mismatch(sema_expr_expected_type(field.ty, environment), sema_expr_expected_type(checked.ty, environment), expr_span(field_value)))
        return None
    }
    if !sema_copy_site_record_move(field_value, scopes, &state, &tail_store, &context, &diagnostics) -> return None
    reference :: TFieldRef{owner: None, field: symbol_id(SymbolKind.Field, "", owner_name, field.name), name: field.name, ty: field.ty, boxed: false}
    Val(TStructFieldValue{field: reference, value: checked, boxed: false})
}

fn sema_expression_core_record_literal(owner_name: String, fields: [ExprField], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    declared :: core_record_literal_fields(owner_name) ?? return None
    supplied := [Bool]{}
    loop _ in declared -> &supplied.push(false)
    loop source in fields {
        found := -1
        loop (index, row) in declared {
            if row.name == source.name {
                found = index
                break
            }
        }
        if found < 0 {
            &diagnostics.push(sema_error("E0302", source.name_span, "`{owner_name}` has no field `{source.name}`", "struct fields must be declared by the type", "use one of the declared field names"))
            return None
        }
        if supplied[found] {
            &diagnostics.push(sema_error("E0105", source.name_span, "field `{source.name}` is supplied more than once", "each struct field receives one value", "remove the duplicate field"))
            return None
        }
        supplied[found] = true
    }
    loop (index, row) in declared {
        if !supplied[index] {
            &diagnostics.push(sema_error("E0108", span, "field `{row.name}` needs a value", "a struct literal must initialize every field without a default", "supply `{row.name}: ...`"))
            return None
        }
    }
    values := [TStructFieldValue]{}
    loop source in fields {
        loop row in declared {
            if row.name != source.name -> next
            checked :: sema_expression_core_record_field_value(owner_name, row, source.value, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
            &values.push(checked)
            break
        }
    }
    value :: sema_tir_expr(Type.Named{name: owner_name}, TExprKind.StructLit{fields: values, extra: None, as_trait: None}, span)
    sema_expr_expected(value, expected, environment, &diagnostics)
}

fn sema_expression_struct_literal(struct_name: String, type_args: [Type], fields: [ExprField], inferred: Bool, as_trait: String?, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if as_trait == None {
        core_record :: sema_expression_core_record_name(struct_name, type_args, expected, environment, &scopes)
        if core_record == .Val(core_name) -> return sema_expression_core_record_literal(core_name, fields, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    resolved :: sema_expression_struct_type(struct_name, type_args, expected, span, environment, &scopes, &diagnostics) ?? return None
    owner := resolved.owner
    &context.name_references.push(SemaNameReferenceFact{span: span, symbol: owner, kind: "type"})
    result_ty := resolved.ty
    // The struct's fields and type parameters, read at the declaration
    // without copying its methods.
    if sema_scope_declaration_kind(environment, owner.id) == None {
        &diagnostics.push(sema_error("E0119", span, "struct `{type_name(result_ty)}` has no declaration metadata", "a struct literal must check every declared field before lowering", "use a registered struct declaration"))
        return None
    }
    struct_def :: sema_scope_declaration_struct(environment, owner.id) ?? {
        &diagnostics.push(sema_error("E0119", span, "`{type_name(result_ty)}` is not a struct", "struct literal syntax only constructs struct declarations", "use the enum variant constructor for an enum"))
        return None
    }
    names :: loop parameter in struct_def.type_params -> parameter.name
    args := type_args
    if struct_name == "" || type_args.len() == 0 {
        if result_ty == .Apply(_, rows) {
            args = rows
        }
    }
    if args.len() != names.len() {
        &diagnostics.push(sema_error("E0104", span, "struct `{type_name(result_ty)}` has the wrong number of type arguments", "each declared type parameter needs one concrete argument", "provide one type argument for every generic parameter"))
        return None
    }
    supplied := [Bool]{}
    loop _ in struct_def.fields -> &supplied.push(false)
    loop source in fields {
        found := -1
        loop (index, declared) in struct_def.fields {
            if declared.name == source.name {
                found = index
                break
            }
        }
        if found < 0 {
            &diagnostics.push(sema_error("E0302", source.name_span, "`{type_name(result_ty)}` has no field `{source.name}`", "struct fields must be declared by the type", "use one of the declared field names"))
            return None
        }
        if supplied[found] {
            &diagnostics.push(sema_error("E0105", source.name_span, "field `{source.name}` is supplied more than once", "each struct field receives one value", "remove the duplicate field"))
            return None
        }
        supplied[found] = true
    }
    // Rust `check_struct_lit`: supplied fields are checked (and their moves
    // recorded) in the order they are written, then omitted fields take their
    // defaults in declaration order. The TIR keeps that order, so lowering
    // evaluates the initializers exactly as written.
    values := [TStructFieldValue]{}
    loop source in fields {
        loop field in struct_def.fields {
            if field.name != source.name -> next
            checked :: sema_expression_struct_field_value(field, source.value, source.name_span, owner, names, args, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
            &values.push(checked)
            break
        }
    }
    loop (index, field) in struct_def.fields {
        if supplied[index] -> next
        default_value :: field.default ?? {
            &diagnostics.push(sema_error("E0108", span, "field `{field.name}` needs a value", "a struct literal must initialize every field without a default", "supply `{field.name}: ...` or declare a field default"))
            return None
        }
        checked :: sema_expression_struct_field_value(field, default_value, field.name_span, owner, names, args, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        &values.push(checked)
    }
    coercion := TCoercionTarget?{None}
    if as_trait == .Val(trait_name) {
        trait_symbol_index :: sema_scope_resolve_index(scopes, trait_name)
        if trait_symbol_index == None || scopes.bindings[trait_symbol_index ?? 0].symbol.kind != SymbolKind.Trait {
            &diagnostics.push(sema_error("E0119", span, "`{trait_name}` is not a registered trait", "trait coercion must retain the target trait identity", "name a declared trait"))
            return None
        }
        trait_symbol :: scopes.bindings[trait_symbol_index ?? 0].symbol
        &context.name_references.push(SemaNameReferenceFact{span: span, symbol: trait_symbol, kind: "trait"})
        coercion = Val(TCoercionTarget{trait_symbol: trait_symbol.id, concrete_type: owner.id})
        resolved_trait :: sema_expr_expected_type(Type.Named{name: trait_name}, environment)
        result_ty = if resolved_trait == {
            .TraitObject(_) -> resolved_trait
            else -> Type.TraitObject{bounds: [String]{trait_symbol.name}}
        }
    }
    value :: sema_tir_expr(result_ty, TExprKind.StructLit{fields: values, extra: None, as_trait: coercion}, span)
    sema_expr_expected(value, expected, environment, &diagnostics)
}

fn sema_expression_enum_literal(type_name: String, type_args: [Type], variant: String, args: [EnumLitArg], leading_dot: Bool, variant_span: Span?, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    contextual_allowed :: if {
        !leading_dot -> true
        else -> if sema_expr_unwrap_tag(expected ?? Type.Named{name: "Never"}) == {
            .Option(_) -> true
            else -> false
        }
    }
    if type_name == "" && contextual_allowed && variant == "Val" && args.len() == 1 {
        if args[0] == {
            .Positional(value) -> return sema_expression_present(value, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            else -> {}
        }
    }
    if type_name == "" && contextual_allowed && variant == "None" && args.len() == 0 {
        return sema_expression_absent(span, expected, &diagnostics)
    }
    // Leading-dot Result cases are contextual only when the expected type
    // is a Result; a declared enum's `.Ok` / `.Err` remains its own case.
    if type_name == "" && leading_dot && sema_expr_unwrap_tag(expected ?? Type.Named{name: "Never"}) == .Result(_, _) && args.len() == 1 {
        if args[0] == .Positional(value) {
            if variant == "Ok" -> return sema_expression_result_payload(value, true, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            if variant == "Err" {
                &context.failure_edges.push("")
                return sema_expression_result_payload(value, false, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            }
        }
    }
    resolved_name := type_name
    if resolved_name == "" {
        expected_ty :: expected ?? {
            &diagnostics.push(sema_error("E0330", span, "can't infer the enum type for `.{variant}`", "a leading-dot variant needs a known enum type from context", "add a type annotation, or write the full form `EnumName.{variant}`"))
            return None
        }
        normalized :: sema_expr_unwrap_tag(expected_ty)
        resolved_name = if normalized == {
            .Named(name) -> name
            .Apply(name, _) -> name
            .Option(inner) -> if inner == {
                .Named(name) -> name
                else -> ""
            }
            // D-ERR-CASES1=A: a case that exactly one union member declares
            // builds that member.
            .Union(_) -> sema_pattern_flat_union_owner(normalized, variant, environment, span) ?? ""
            else -> ""
        }
        if resolved_name == "" {
            &diagnostics.push(sema_error("E0330", span, "can't infer the enum type for `.{variant}`", "a leading-dot variant needs a known enum type from context", "add a type annotation, or write the full form `EnumName.{variant}`"))
            return None
        }
    }
    // D-FACT-ENUM-TIR: `ExactnessKind.Approximate` / `.Approximate` builds a
    // compiler-owned fact enum value, which has no registered declaration.
    fact_enum :: sema_fact_enum_literal(resolved_name, variant, args, span, variant_span, expected, environment, &diagnostics)
    if fact_enum.handled -> return fact_enum.value
    // A Core enum with no source declaration (`IOError`, `ProcessStreamMode`)
    // builds its variant from the generated Core enum rows.
    if sema_expression_type_symbol(&scopes, environment, resolved_name) == None {
        core_variants := core_enum_payload_variants(resolved_name)
        if core_variants == None -> core_variants = core_enum_variants(resolved_name)
        if core_variants == .Val(variants) -> return sema_expression_core_enum_literal(resolved_name, variants, variant, args, variant_span, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    if type_name == "" {
        inferred_owner :: sema_expression_type_symbol(&scopes, environment, resolved_name)
        inferred_is_enum := false
        if inferred_owner == .Val(owner_symbol) -> inferred_is_enum = sema_scope_declaration_is(environment, owner_symbol.id, SemaScopeDeclarationKind.Enum)
        if !inferred_is_enum {
            &diagnostics.push(sema_error("E0330", span, "can't infer the enum type for `.{variant}`", "a leading-dot variant needs a known enum type from context", "add a type annotation, or write the full form `EnumName.{variant}`"))
            return None
        }
    }
    owner :: sema_expression_type_symbol(&scopes, environment, resolved_name) ?? {
        &diagnostics.push(sema_unknown_name(resolved_name, span))
        return None
    }
    &context.name_references.push(SemaNameReferenceFact{span: span, symbol: owner, kind: "type"})
    // The enum's variants, groups and type parameters, read at the
    // declaration without copying its methods.
    if sema_scope_declaration_kind(environment, owner.id) == None {
        &diagnostics.push(sema_error("E0119", span, "enum `{resolved_name}` has no declaration metadata", "an enum constructor must check its variant payload", "use a registered enum declaration"))
        return None
    }
    enum_def :: sema_scope_declaration_enum(environment, owner.id) ?? {
        &diagnostics.push(sema_error("E0119", span, "`{resolved_name}` is not an enum", "enum literal syntax only constructs enum declarations", "use a struct literal for a struct type"))
        return None
    }
    selected := Variant?{None}
    loop candidate in enum_def.variants {
        if candidate.name == variant {
            selected = Val(candidate)
            break
        }
    }
    selected_variant :: selected ?? {
        // D-TAG1 (E0332): a group name in value position; a value is always a leaf.
        loop group in enum_def.groups {
            if group.path != variant -> next
            leaves := [String]{}
            loop candidate in enum_def.variants {
                if candidate.name.starts_with("{variant}.") -> &leaves.push("`{resolved_name}.{candidate.name}`")
            }
            &diagnostics.push(sema_error("E0332", variant_span ?? span, "`{variant}` is a group, not a value", "a group names its whole subtree in patterns; an actual value is always a leaf variant (D-TAG1)", "pick a leaf: {leaves.join(", ")}"))
            return None
        }
        variant_names :: loop candidate in enum_def.variants -> candidate.name
        &diagnostics.push(sema_enum_unknown_variant(resolved_name, variant, variant_names, span, variant_span))
        return None
    }
    variant_id :: symbol_id(SymbolKind.Variant, owner.module_name, owner.id.key, variant)
    variant_symbol :: Symbol{id: variant_id, kind: SymbolKind.Variant, name: variant, module_name: owner.module_name, owner: Val(owner.id.key), span: selected_variant.name_span, ty: sema_registration_variant_type(selected_variant.payload), visibility: owner.visibility}
    &context.name_references.push(SemaNameReferenceFact{span: variant_span ?? span, symbol: variant_symbol, kind: "variant"})
    generic_names :: loop parameter in enum_def.type_params -> parameter.name
    generic_args := type_args
    if generic_args.len() == 0 && expected == .Val(expected_ty) {
        normalized :: sema_expr_unwrap_tag(expected_ty)
        if normalized == .Apply(name, rows) {
            if name == resolved_name -> generic_args = rows
        }
    }
    if generic_args.len() != generic_names.len() {
        &diagnostics.push(sema_error("E0104", span, "enum `{resolved_name}` has the wrong number of type arguments", "each declared type parameter needs one concrete argument", "provide one type argument for every generic parameter"))
        return None
    }
    payload := TEnumPayload.Unit
    if selected_variant.payload == {
        .Unit -> {
            if args.len() != 0 {
                &diagnostics.push(sema_enum_unit_payload(resolved_name, variant, span))
                return None
            }
        }
        .Single(ty, _) -> {
            if args.len() != 1 {
                &diagnostics.push(sema_error("E0104", span, "variant `{variant}` expects one payload", "this enum variant has one positional field", "pass exactly one value"))
                return None
            }
            payload_expr :: if args[0] == {
                .Positional(value) -> value
                else -> {
                    &diagnostics.push(sema_error("E0764", span, "variant `{variant}` takes a positional payload", "single-payload variants do not have field labels", "pass the value without a label"))
                    return None
                }
            }
            // As a struct field: the payload type names types as the enum's
            // module sees them (Rust `owner_type_for_reader`).
            payload_ty :: sema_inference_substitute_type(sema_expression_field_owner_type(environment, owner.module_name, ty, generic_names), generic_names, generic_args)
            sema_copy_site_check_field(payload_expr, environment, scopes, &tail_store, &context, &diagnostics)
            checked :: sema_check_expression(payload_expr, Val(payload_ty), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
            compatible :: sema_expr_expected_assignable(payload_ty, checked.ty, environment) ?? return None
            if !compatible {
                &diagnostics.push(sema_type_mismatch(sema_expr_expected_type(payload_ty, environment), sema_expr_expected_type(checked.ty, environment), expr_span(payload_expr)))
                return None
            }
            if !sema_copy_site_record_move(payload_expr, scopes, &state, &tail_store, &context, &diagnostics) -> return None
            payload = TEnumPayload.Positional{args: [TEnumArg]{TEnumArg{value: checked, clone: false, move: false}}}
        }
        .Named(fields) -> {
            // Rust `check_enum_lit`: payload fields are checked and kept in the
            // order they are written; lowering evaluates them in that order and
            // places each into its declared slot afterwards.
            supplied := [Bool]{}
            loop _ in fields -> &supplied.push(false)
            named_values := [TNamedEnumArg]{}
            loop arg in args {
                label := ""
                payload_expr := Expr.Unit{span: span}
                if arg == {
                    .Named(name, value) -> {
                        label = name
                        payload_expr = value
                    }
                    .Positional(_) -> {
                        &diagnostics.push(sema_error("E0764", span, "variant `{variant}` needs named payload fields", "this enum variant declares labeled fields", "write each variant field as `name: value`"))
                        return None
                    }
                }
                found := -1
                loop (index, declared) in fields {
                    if declared.name == label {
                        found = index
                        break
                    }
                }
                if found < 0 {
                    &diagnostics.push(sema_error("E0302", expr_span(payload_expr), "variant `{variant}` has no field `{label}`", "named enum payloads use the declaration's field names", "use a declared payload field"))
                    return None
                }
                if supplied[found] {
                    &diagnostics.push(sema_error("E0105", expr_span(payload_expr), "variant field `{label}` is supplied more than once", "each enum payload field receives one value", "remove the duplicate field"))
                    return None
                }
                supplied[found] = true
                field_ty :: sema_inference_substitute_type(sema_expression_field_owner_type(environment, owner.module_name, fields[found].ty, generic_names), generic_names, generic_args)
                sema_copy_site_check_field(payload_expr, environment, scopes, &tail_store, &context, &diagnostics)
                checked :: sema_check_expression(payload_expr, Val(field_ty), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                compatible :: sema_expr_expected_assignable(field_ty, checked.ty, environment) ?? return None
                if !compatible {
                    &diagnostics.push(sema_type_mismatch(sema_expr_expected_type(field_ty, environment), sema_expr_expected_type(checked.ty, environment), expr_span(payload_expr)))
                    return None
                }
                if !sema_copy_site_record_move(payload_expr, scopes, &state, &tail_store, &context, &diagnostics) -> return None
                &named_values.push(TNamedEnumArg{name: label, value: TEnumArg{value: checked, clone: false, move: false}})
            }
            loop (index, was_supplied) in supplied {
                if !was_supplied {
                    &diagnostics.push(sema_error("E0108", span, "variant field `{fields[index].name}` needs a value", "named enum payloads initialize every declared field", "supply the missing payload field"))
                    return None
                }
            }
            payload = TEnumPayload.Named{fields: named_values}
        }
    }
    enum_ty :: if generic_args.len() > 0 -> Type.Apply{name: resolved_name, args: generic_args} else -> Type.Named{name: resolved_name}
    value :: sema_tir_expr(enum_ty, TExprKind.EnumCtor{owner: owner.id, variant: variant_id, payload: payload}, span)
    sema_expr_expected(value, expected, environment, &diagnostics)
}

// A variant of a Core enum without a source declaration: unit variants take no
// payload and payload variants take one positional value per row type.
fn sema_expression_core_enum_literal(enum_name: String, variants: [String], variant: String, args: [EnumLitArg], variant_span: Span?, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    payload_types :: core_enum_variant_payload(enum_name, variant) ?? {
        &diagnostics.push(sema_enum_unknown_variant(enum_name, variant, variants, span, variant_span))
        return None
    }
    if payload_types.len() == 0 && args.len() != 0 {
        &diagnostics.push(sema_enum_unit_payload(enum_name, variant, span))
        return None
    }
    if args.len() != payload_types.len() {
        &diagnostics.push(sema_error("E0104", span, "variant `{variant}` expects {payload_types.len()} payload values", "this Core enum variant has positional payload fields", "pass exactly {payload_types.len()} values"))
        return None
    }
    checked_args := [TEnumArg]{}
    loop (index, argument) in args {
        payload_expr :: if argument == {
            .Positional(value) -> value
            else -> {
                &diagnostics.push(sema_error("E0764", span, "variant `{variant}` takes a positional payload", "Core enum payload values do not have field labels", "pass the value without a label"))
                return None
            }
        }
        payload_ty :: payload_types[index]
        sema_copy_site_check_field(payload_expr, environment, scopes, &tail_store, &context, &diagnostics)
        checked :: sema_check_expression(payload_expr, Val(payload_ty), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        compatible :: sema_expr_expected_assignable(payload_ty, checked.ty, environment) ?? return None
        if !compatible {
            &diagnostics.push(sema_type_mismatch(sema_expr_expected_type(payload_ty, environment), sema_expr_expected_type(checked.ty, environment), expr_span(payload_expr)))
            return None
        }
        if !sema_copy_site_record_move(payload_expr, scopes, &state, &tail_store, &context, &diagnostics) -> return None
        &checked_args.push(TEnumArg{value: checked, clone: false, move: false})
    }
    payload :: if checked_args.len() == 0 -> TEnumPayload.Unit else -> TEnumPayload.Positional{args: checked_args}
    value :: sema_tir_expr(Type.Named{name: enum_name}, TExprKind.EnumLit{enum_type: enum_name, variant: variant, payload: payload}, span)
    sema_expr_expected(value, expected, environment, &diagnostics)
}
struct SemaExpressionTypedTextParts {
    pub literals: [String]
    pub holes: [TExpr]
    pub trusted_html: [Bool]
}

fn sema_expression_typed_literal_head_kind(head: Type) -> MIRTypedHeadKind? {
    if head == {
        .Named(name) -> {
            if name == "SQL" -> return Val(MIRTypedHeadKind.SQL)
            if name == "HTML" -> return Val(MIRTypedHeadKind.HTML)
            if name == "Sh" -> return Val(MIRTypedHeadKind.Sh)
            if name == "URL" -> return Val(MIRTypedHeadKind.URL)
            if name == "Path" -> return Val(MIRTypedHeadKind.Path)
            if name == "DateTime" -> return Val(MIRTypedHeadKind.DateTime)
        }
        else -> {}
    }
    None
}

fn sema_expression_typed_literal_printable_bound(ty: Type, environment: SemaScopeEnvironment) -> Bool Never! {
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return false
    sema_type_bound_satisfied_with_generics(graph, ty, "Printable", environment.module_identity, environment.generic_params) ?? false
}

fn sema_expression_typed_literal_printable(ty: Type, environment: SemaScopeEnvironment) -> Bool Never! {
    if ty == {
        .Int | .IntN(_, _) | .Float | .Float32 | .Bool | .String | .Char | .Quantity(_, _) -> return true
        .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) -> return sema_expression_typed_literal_printable(inner, environment)
        .Result(ok, err) -> return sema_expression_typed_literal_printable(ok, environment) && sema_expression_typed_literal_printable(err, environment)
        .Map(key, _, value) -> return sema_expression_typed_literal_printable(key, environment) && sema_expression_typed_literal_printable(value, environment)
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_expression_typed_literal_printable(field.ty, environment) -> return false
            }
            return true
        }
        .Union(members) -> {
            loop member in members {
                if !sema_expression_typed_literal_printable(member, environment) -> return false
            }
            return true
        }
        .Shared(_) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Measure(_) -> return false
        .Named(name) -> {
            if name == "Unit" -> return true
            if environment.registration_graph == .Val(graph) && sema_registration_unit_fact_for_type(graph, ty) != None -> return true
            loop row in sema_scope_checked_type_name_rows(environment, name) {
                if environment.checked_types[row].single_use -> return false
                if environment.checked_types[row].auto_printable -> return true
            }
            return sema_expression_typed_literal_printable_bound(ty, environment)
        }
        .Apply(name, args) -> {
            if name == "KeyRef" -> return true
            if name == "View" && args.len() == 1 && args[0] == (Type.Named{name: "str"}) -> return true
            loop argument in args {
                if !sema_expression_typed_literal_printable(argument, environment) -> return false
            }
            return sema_expression_typed_literal_printable_bound(ty, environment)
        }
    }
    false
}
struct SemaExpressionCheckedTextTarget {
    pub owner: Symbol
    pub implementation_module_identity: String
    pub check: SemaRegistrationFunction
    pub encode_hole: SemaRegistrationFunction
}

struct SemaExpressionCheckedTextLiteral {
    pub handled: Bool
    pub value: TExpr?
}

fn sema_expression_checked_text_target(head: Type, environment: SemaScopeEnvironment, scopes: &SemaScopeTable) -> SemaExpressionCheckedTextTarget? {
    name :: if head == {.Named(value) -> value else -> { return None }}
    owner :: sema_expression_type_symbol(&scopes, environment, name) ?? return None
    if owner.kind != SymbolKind.Type -> return None
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return None
    registered_row :: sema_type_graph_nominal_row(graph, owner.id.key) ?? return None
    registered :: graph.modules[registered_row.module_index].nominals[registered_row.row]
    if registered.kind != SemaRegistrationNominalKind.Distinct -> return None
    definition :: sema_registration_nominal_source_item(registered.source) ?? return None
    if definition == {
        .Distinct(value) -> {
            if value.base != Type.String -> return None
        }
        else -> return None
    }
    loop graph_module in graph.modules {
        loop implementation in graph_module.impls {
            if !sema_type_graph_is_checked_text_impl(graph, implementation) -> next
            if implementation.target_identity_key != registered.identity_key && (implementation.target_module_identity != Val(registered.symbol.module_name) || implementation.target_type_name != registered.symbol.name) -> next
            check := SemaRegistrationFunction?{None}
            encode_hole := SemaRegistrationFunction?{None}
            loop method in implementation.methods {
                if method.symbol.name == "check" -> check = Val(method)
                if method.symbol.name == "encode_hole" -> encode_hole = Val(method)
            }
            if check != None && encode_hole != None {
                return Val(SemaExpressionCheckedTextTarget{
                    owner: registered.symbol,
                    implementation_module_identity: graph_module.module_identity,
                    check: check ?? return None,
                    encode_hole: encode_hole ?? return None,
                })
            }
        }
    }
    None
}

fn sema_expression_checked_text_static_method_call(receiver: Expr, method_name: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    type_name :: if receiver == {.Ident(name, _) -> name else -> { return SemaMethodSpecialCheck{handled: false, value: None} }}
    target :: sema_expression_checked_text_target(Type.Named{name: type_name}, environment, &scopes) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if method_name == "raw" -> return sema_expression_checked_text_raw(target, type_name, method_span, args, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    function :: if method_name == "check" -> target.check else -> if method_name == "encode_hole" -> target.encode_hole else -> { return SemaMethodSpecialCheck{handled: false, value: None} }
    if owner_type_args.len() > 0 {
        &diagnostics.push(sema_error("E0119", method_span, "`{type_name}.{method_name}` has no owner type parameters", "CheckedText implementations target one concrete string-backed distinct type", "remove the explicit owner type arguments"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !function.declaration.is_pure {
        &diagnostics.push(sema_error("E0907", method_span, "`{type_name}.{method_name}` must be pure", "CheckedText methods are evaluated through the canonical pure Source evaluator", "declare this CheckedText method pure"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if environment.registration_graph == None -> return SemaMethodSpecialCheck{handled: true, value: None}
    direct :: sema_call_direct_target_from_registration(function, environment.registration_graph, environment.module_identity, environment.package_identity, environment.generic_params, type_args, method_span, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    call := Call{
        name: "{type_name}.{method_name}",
        name_span: method_span,
        type_args: type_args,
        args: args,
        resolved_ret: None,
        range_checked: false,
        widen_approx: false,
    }
    checked :: sema_call_check_direct_target_owned(&state, direct, call, [SemaCallDefaultValue]{}, expected, environment, &scopes, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if method_name == "encode_hole" && checked.value.ty != Type.String {
        &diagnostics.push(sema_error("E0112", method_span, "a checked text hole encoder must return String", "every interpolation is passed through the type's pure `encode_hole` method before it reaches the checker", "make `encode_hole` return a String"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    check_returns_unit_result :: if checked.value.ty == {
        .Result(ok, _) -> ok == Type.Named{name: "Unit"}
        else -> false
    }
    if method_name == "check" && !check_returns_unit_result {
        &diagnostics.push(sema_error("E0907", method_span, "`{type_name}.check` must return `Result<Unit, Error>`", "the canonical CheckedText contract reports rejection through its error result", "match the pure CheckedText.check signature"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    &context.call_return_views.push(SemaCallReturnView{span: method_span, facts: checked.return_view_facts})
    if !sema_expr_record_call_fact(environment, &scopes, &context, method_span, checked, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: Val(checked.value)}
}

// D-TEXTHEAD-TYPE1=A: `Type.raw(text)` is the expert escape that wraps one
// audited String without running the declared checker, so it needs an
// audited `#Unsafe` region (E0387).
fn sema_expression_checked_text_raw(target: SemaExpressionCheckedTextTarget, type_name: String, method_span: Span, args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    callee :: "{type_name}.raw"
    if args.len() != 1 {
        &diagnostics.push(sema_error("E0103", method_span, "`{callee}` takes exactly one String", "a checked text boundary receives one complete text value", "write `{callee}(text)`"))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    if context.unsafe_depth == 0 {
        &diagnostics.push(sema_error("E0387", method_span, "Checked text raw construction requires an audited `#Unsafe` region", "`Type.raw(text)` bypasses the declared CheckedText checker and is an expert-only escape", "Wrap the call in `#Unsafe(\"reason\") {{ … }}`, or use `Type.from(text)` for validation"))
    }
    if args.len() != 1 -> return SemaMethodSpecialCheck{handled: true, value: None}
    argument :: sema_check_expression(args[0].expr, Val(Type.String), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if argument.ty != Type.String {
        &diagnostics.push(sema_type_mismatch(Type.String, argument.ty, expr_span(args[0].expr)))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    params :: [SemaCallParam]{SemaCallParam{label: "arg0", name: "arg0", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.String), variadic: false}}
    ownership_args := args
    ownership := sema_ownership_check_call_arguments(&state, callee, params, &ownership_args, scopes, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    value := argument
    if ownership_args[0].flags.implicit_clone || ownership_args[0].flags.shared_auto_clone -> value = sema_tir_expr(value.ty, TExprKind.Clone{value: value, fact: tir_call_arg_copy_fact(ownership_args[0].flags.shared_auto_clone)}, value.span)
    constructed :: sema_tir_expr(Type.Named{name: type_name}, TExprKind.DistinctCtor{owner: target.owner.id, argument: value, base: Type.String}, method_span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(constructed, expected, environment, &diagnostics)}
}

fn sema_expression_checked_text_literal(head: Type, source_head: Type?, body: TypedLitBody, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaExpressionCheckedTextLiteral {
    target :: sema_expression_checked_text_target(head, environment, &scopes) ?? return SemaExpressionCheckedTextLiteral{handled: false, value: None}
    type_name := if head == {.Named(name) -> name else -> panic("checked text target lost its named owner")}
    body_value :: if body == {
        .Value(value) -> value
        else -> {
            &diagnostics.push(sema_error("E0112", span, "`{type_name}{{ … }}` needs a string recipe body", "a checked text type is constructed from a quoted template, not another expression shape", "write `{type_name}{{\"…\"}}` with interpolation holes as needed"))
            return SemaExpressionCheckedTextLiteral{handled: true, value: None}
        }
    }
    parts :: if body_value == {
        .Str(rows, _) -> rows
        else -> {
            &diagnostics.push(sema_error("E0112", expr_span(body_value), "`{type_name}{{ … }}` needs a string recipe body", "a checked text type is constructed from a quoted template, not another expression shape", "write `{type_name}{{\"…\"}}` with interpolation holes as needed"))
            return SemaExpressionCheckedTextLiteral{handled: true, value: None}
        }
    }
    encoded_parts := [StrPart]{}
    loop part in parts {
        if part == {
            .Lit(_) -> &encoded_parts.push(part)
            .Byte(value) -> &encoded_parts.push(StrPart.Lit{text: sema_expr_byte_text(value)})
            .Interp(value, _) -> {
                argument := CallArg{convention: AccessConvention.Read, expr: value, span: expr_span(value), flags: ast_empty_call_arg_flags(), label: None, spread: false}
                encoder := Expr.MethodCall{
                    receiver: Expr.Ident{name: type_name, span: expr_span(value)},
                    method: "encode_hole",
                    method_span: expr_span(value),
                    owner_type_args: [Type]{},
                    type_args: [Type]{},
                    args: [CallArg]{argument},
                    recv_type: Val(type_name),
                    resolved_ret: Val(Type.String),
                    operator_rhs: None,
                    checked_widen: false,
                }
                &encoded_parts.push(StrPart.Interp{expr: encoder, format: StrFormat.Display})
            }
        }
    }
    encoded_body := Expr.Str{parts: encoded_parts, span: expr_span(body_value)}
    check_argument := CallArg{convention: AccessConvention.Read, expr: encoded_body, span: expr_span(body_value), flags: ast_empty_call_arg_flags(), label: None, spread: false}
    check_call := Expr.MethodCall{
        receiver: Expr.Ident{name: type_name, span: span},
        method: "check",
        method_span: span,
        owner_type_args: [Type]{},
        type_args: [Type]{},
        args: [CallArg]{check_argument},
        recv_type: Val(type_name),
        resolved_ret: None,
        operator_rhs: None,
        checked_widen: false,
    }
    fact_start := context.call_facts.len()
    reference_start := context.name_references.len()
    register_access_start := context.hardware_use.register_accesses.len()
    interrupt_handler_start := context.hardware_use.interrupt_handlers.len()
    dma_operation_start := context.hardware_use.dma_operations.len()
    unresolved_hardware_start := context.hardware_use.unresolved_references.len()
    checked :: sema_check_expression(check_call, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaExpressionCheckedTextLiteral{handled: true, value: None}
    text :: if checked.kind == {
        .Call(_, _, args) -> if {
            args.len() == 1 -> args[0].value
            else -> {
                &diagnostics.push(sema_error("E0003", span, "the checked text checker call lost its complete body argument", "the staged checker evaluates the ordinary pure `CheckedText.check` method on the exact encoded body", "preserve the canonical static method call in checked TIR"))
                return SemaExpressionCheckedTextLiteral{handled: true, value: None}
            }
        }
        else -> {
            &diagnostics.push(sema_error("E0003", span, "the checked text checker call did not lower as a direct static call", "CheckedText methods are ordinary registered pure functions", "preserve the canonical registered call target"))
            return SemaExpressionCheckedTextLiteral{handled: true, value: None}
        }
    }
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return SemaExpressionCheckedTextLiteral{handled: true, value: None}
    functions := sema_comptime_reachable_function_keys(graph, context.call_facts)
    reachable := [String]{}
    loop key in functions {
        fact_index := fact_start
        loop fact_index < context.call_facts.len() {
            callee :: context.call_facts[fact_index].callee
            if callee == .Val(symbol) && symbol.key == key {
                &reachable.push(key)
                break
            }
            fact_index += 1
        }
    }
    loop method_key in ([String]{target.check.symbol.id.key, target.encode_hole.symbol.id.key}) {
        if !reachable.contains(method_key) -> &reachable.push(method_key)
    }
    dependencies := [String]{}
    loop reference_index in reference_start..<context.name_references.len() {
        reference := context.name_references[reference_index]
        if reference.symbol.kind != SymbolKind.Constant -> next
        if !dependencies.contains(reference.symbol.id.key) -> &dependencies.push(reference.symbol.id.key)
    }
    source_file := sema_source_file_at(environment.source_segments, environment.source_file, environment.source_origin, span)
    key := "{environment.module_identity}::checked-text::{target.owner.id.key}::{span.start}:{span.end}:{type_identity_key(head)}"
    evaluation := SemaCheckedTextEvaluation{
        module_identity: environment.module_identity,
        key: key,
        type_name: type_name,
        source_file: source_file,
        source_expression: Expr.TypedLit{head: source_head, body: body, span: span},
        expression: checked,
        hardware_use: MIRTargetHardwareUse{
            register_accesses: loop index in register_access_start..<context.hardware_use.register_accesses.len() -> context.hardware_use.register_accesses[index],
            interrupt_handlers: loop index in interrupt_handler_start..<context.hardware_use.interrupt_handlers.len() -> context.hardware_use.interrupt_handlers[index],
            dma_operations: loop index in dma_operation_start..<context.hardware_use.dma_operations.len() -> context.hardware_use.dma_operations[index],
            unresolved_references: loop index in unresolved_hardware_start..<context.hardware_use.unresolved_references.len() -> context.hardware_use.unresolved_references[index],
        },
        reachable_function_keys: reachable,
        dependencies: dependencies,
        span: span,
    }
    &context.comptime_requests.push(SemaComptimeRequest{
        callee_key: target.check.symbol.id.key,
        module_identity: target.implementation_module_identity,
        args: [TComptimeValue]{},
        span: span,
        checked_text: Val(evaluation),
    })
    value :: text
    result := sema_tir_expr(head, TExprKind.DistinctCtor{owner: target.owner.id, argument: value, base: Type.String}, span)
    SemaExpressionCheckedTextLiteral{handled: true, value: sema_expr_expected(result, expected, environment, &diagnostics)}
}


fn sema_expression_typed_literal_byte_text(parts: [ByteTextPart], head: Type, span: Span, diagnostics: &[Diagnostic]) -> [Expr]? {
    values := [Expr]{}
    loop part in parts {
        if part == {
            .Lit(text) -> {
                bytes := text.bytes()
                loop byte in bytes {
                    if Int.from_u8(byte) >= 128 {
                        &diagnostics.push(sema_error("E0119", span, "this body doesn't match typed-literal head `{type_name(head)}`", "byte-list text is ASCII so every character has one unambiguous byte value", "use ASCII text or numeric elements for a byte list"))
                        return None
                    }
                    number :: Int.from_u8(byte)
                    &values.push(Expr.Int{value: number, span: span, width: None, raw: Val("{number}")})
                }
            }
            .Byte(byte) -> {
                number :: Int.from_u8(byte)
                &values.push(Expr.Int{value: number, span: span, width: None, raw: Val("{number}")})
            }
        }
    }
    Val(values)
}

fn sema_expression_typed_literal_text_parts(parts: [StrPart], kind: MIRTypedHeadKind, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaExpressionTypedTextParts? {
    literals := [String]{""}
    holes := [TExpr]{}
    trusted_html := [Bool]{}
    loop part in parts {
        if part == {
            .Lit(text) -> {
                last := literals.len() - 1
                literals[last] = "{literals[last]}{text}"
            }
            .Byte(value) -> {
                last := literals.len() - 1
                literals[last] = "{literals[last]}{sema_expr_byte_text(value)}"
            }
            .Interp(value, _) -> {
                if kind == MIRTypedHeadKind.DateTime {
                    &diagnostics.push(sema_error("E0155", expr_span(value), "a `DateTime` literal cannot contain interpolation", "DateTime values are checked as complete RFC3339 literals before the program runs", "write a complete `DateTime{{\"…\"}}` literal, or parse a runtime String explicitly"))
                    return None
                }
                old_borrow := context.borrow_ctx
                old_string_view := context.allow_string_view_read
                context.borrow_ctx = true
                context.allow_string_view_read = true
                checked := sema_check_expression(value, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                context.borrow_ctx = old_borrow
                context.allow_string_view_read = old_string_view
                hole :: checked ?? return None
                trusted := kind == MIRTypedHeadKind.HTML && hole.ty == Type.Named{name: "HTML"}
                if !trusted && !sema_expression_typed_literal_printable(hole.ty, environment) {
                    &diagnostics.push(sema_error("E0112", expr_span(value), "`{type_name(hole.ty)}` can't be used in a typed literal hole", "typed literal holes use the shared JetShow rendering contract", "use a printable value, or convert it to String before the hole"))
                    return None
                }
                &holes.push(hole)
                &trusted_html.push(trusted)
                &literals.push("")
            }
        }
    }
    Val(SemaExpressionTypedTextParts{literals: literals, holes: holes, trusted_html: trusted_html})
}

fn sema_expression_validate_boundary_literal(kind: MIRTypedHeadKind, parts: [StrPart], span: Span, environment: SemaScopeEnvironment, diagnostics: &[Diagnostic]) -> Bool {
    name := if kind == {
        .URL -> "URL"
        .Path -> "Path"
        .DateTime -> "DateTime"
        else -> { return true }
    }
    literals := [String]{""}
    loop part in parts {
        if part == {
            .Lit(text) -> {
                last := literals.len() - 1
                literals[last] = "{literals[last]}{text}"
            }
            .Byte(byte) -> {
                last := literals.len() - 1
                literals[last] = "{literals[last]}{sema_expr_byte_text(byte)}"
            }
            .Interp(_, _) -> {
                if kind == MIRTypedHeadKind.DateTime {
                    &diagnostics.push(sema_error("E0155", span, "a `DateTime` literal cannot contain interpolation", "DateTime values are checked as complete RFC3339 literals before the program runs", "write a complete `DateTime{{\"…\"}}` literal, or parse a runtime String explicitly"))
                    return false
                }
                &literals.push("")
            }
        }
    }
    graph_option :: environment.registration_graph
    graph :: graph_option ?? panic("boundary literal checking has no canonical registration graph")
    validate :: graph.host_hooks.typed_boundary_literal_validate ?? panic("canonical Prelude boundary literal validator is not installed")
    if validate(kind, literals) == .Val(reason) {
        &diagnostics.push(sema_error("E0155", span, "this `{name}` literal is invalid", reason, "fix the literal, or parse a runtime String with the ordinary `{name}` constructor"))
        return false
    }
    true
}

fn sema_expression_typed_literal_text(kind: MIRTypedHeadKind, head: Type, value: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    parts := if value == {
        .Str(rows, _) -> rows
        else -> {
            &diagnostics.push(sema_error("E0112", span, "`{type_name(head)}.{{ … }}` needs a string recipe body", "checked typed heads are built from a quoted template, not from another expression shape", "write `{type_name(head)}.{{\"...\"}}` with `{{value}}` holes as needed"))
            return None
        }
    }
    if !sema_expression_validate_boundary_literal(kind, parts, expr_span(value), environment, &diagnostics) -> return None
    checked :: sema_expression_typed_literal_text_parts(parts, kind, span, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    result_head := if kind == MIRTypedHeadKind.URL -> Type.Named{name: "URL"} else -> head
    result := sema_tir_expr(result_head, TExprKind.HostCall{call: THostCall.TypedTextInterp{kind: kind, literals: checked.literals, holes: checked.holes, trusted_html: checked.trusted_html}}, span)
    if kind == MIRTypedHeadKind.HTML && checked.holes.len() == 0 {
        result = sema_tir_expr(head, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: checked.literals[0]}}}, span)
    }
    sema_expr_expected(result, expected, environment, &diagnostics)
}

fn sema_expression_typed_literal_regex(head: Type, value: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, diagnostics: &[Diagnostic]) -> TExpr? {
    parts := if value == {
        .Str(rows, _) -> rows
        else -> {
            &diagnostics.push(sema_error("E0152", span, "`Regex.{{ … }}` needs one quoted pattern", "a regex typed literal contains pattern text, not another expression shape", "write `Regex.{{\"...\"}}`"))
            return None
        }
    }
    pattern := ""
    loop part in parts {
        if part == {
            .Lit(text) -> pattern = "{pattern}{text}"
            .Byte(byte) -> pattern = "{pattern}{sema_expr_byte_text(byte)}"
            .Interp(expr, _) -> {
                &diagnostics.push(sema_error("E0152", expr_span(expr), "a `Regex` literal cannot contain interpolation", "the compiler must know the complete pattern before the program runs", "use a fixed `Regex.{{\"...\"}}` pattern, or build text and call `re.compile(text)`"))
                return None
            }
        }
    }
    if regex_syntax_validate(pattern) == .Val(error) {
        &diagnostics.push(sema_error("E0152", expr_span(value), "this regex pattern is invalid at position {error.offset}", error.reason, "fix the pattern at the reported position"))
        return None
    }
    record :: core_call("core.regex", "literal") ?? {
        &diagnostics.push(sema_error("E0906", span, "the core Regex literal route is unavailable", "typed Regex literals use the canonical `core.regex::literal` route", "restore the registered core Regex literal route"))
        return None
    }
    pattern_value := sema_tir_expr(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: pattern}}}, span)
    value_expr := sema_tir_expr(head, TExprKind.CoreCall{record: record, args: [TExpr]{pattern_value}, source_span: span, type_args: [Type]{}, widen_to_vec: [Bool]{false}, data_plan: None, fallibility: TFailureCarrier.Infallible}, span)
    sema_expr_expected(value_expr, expected, environment, &diagnostics)
}

fn sema_expression_typed_literal_mismatch(head: Type, span: Span, diagnostics: &[Diagnostic]) -> TExpr? {
    &diagnostics.push(sema_error("E0119", span, "this body doesn't match typed-literal head `{type_name(head)}`", "a typed literal body uses the head type's own literal shape", "use elements for lists, entries for maps, fields for records, or one expression for scalars"))
    None
}

// #3739 (amends D-DOTCTOR3=A): a list head's lone expression is the whole
// value when it checks as a value of the head the way a parameter of that
// type accepts it; otherwise it is the literal's single element. The probe
// runs on snapshots, so the caller re-checks the chosen reading and every
// diagnostic is reported once. Spreads and inferred-head bodies (`{…}`,
// `.{…}`) always use element notation.
fn sema_expression_typed_literal_whole_value(head: Type, value: Expr, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> Bool {
    if value == {
        .Spread(_, _) -> return false
        else -> {}
    }
    if sema_expression_list_element_needs_expected_type(value) -> return false
    probe_diagnostics := [Diagnostic]{}
    // The probe reads the enclosing statement tails (its liveness frames in
    // `context` index this store), so it shares the store, never a fresh one.
    checked :: sema_probe_expression(value, Val(head), environment, &scopes, state, &tail_store, &context, &probe_diagnostics) ?? return false
    if probe_diagnostics.len() != 0 -> return false
    _ := sema_expr_expected(checked, Val(head), environment, &probe_diagnostics) ?? return false
    probe_diagnostics.len() == 0
}

fn sema_expression_typed_literal_whole(head: Type, value: Expr, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    checked :: sema_check_expression(value, Val(head), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    typed :: sema_expr_expected(checked, Val(head), environment, &diagnostics) ?? return None
    sema_expr_expected(typed, expected, environment, &diagnostics)
}

struct SemaExpressionVariantHead {
    enum_name: String
    variant: String
}

// D-UITREE1/D-DOTCTOR1: `Enum.Variant{field: value}` constructs a
// named-payload variant. The parser reads the dotted head as a type path;
// resolve it here against the enum declaration so the payload is checked by
// the enum constructor, never by the struct-literal path.
fn sema_expression_variant_head(head: Type, environment: SemaScopeEnvironment, scopes: &SemaScopeTable) -> SemaExpressionVariantHead? {
    // A non-named head has no dotted path; the part count below rejects it.
    path :: if sema_expr_unwrap_tag(head) == {
        .Named(name) -> name
        else -> ""
    }
    parts :: path.split(".").to_list()
    if parts.len() != 2 -> return None
    owner :: sema_expression_type_symbol(&scopes, environment, parts[0]) ?? return None
    if sema_scope_declaration_enum_declares(environment, owner.id, parts[1]) -> Val(SemaExpressionVariantHead{enum_name: parts[0], variant: parts[1]}) else -> None
}

// D-DIST1/D-DIST3 (E0128): a distinct head never re-types its base value;
// the destination owns the explicit conversion. Returns true when reported.
fn sema_expression_typed_literal_distinct_mismatch(head: Type, value: TExpr, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if value.ty == head -> return false
    facts :: sema_expr_distinct_facts(head, environment, &scopes) ?? return false
    offered :: type_name(value.ty)
    method :: if value.ty == {
        .Int -> "from_int"
        .Float -> "from_float"
        .String -> "from_string"
        .Bool -> "from_bool"
        .Char -> "from_char"
        else -> "from_{offered}"
    }
    &diagnostics.push(sema_error("E0128", value.span, "a `{offered}` can't be used where a `{facts.name}` is expected", "`{facts.name}` and `{offered}` are different types — even though `{facts.name}` is built on `{type_name(facts.base)}`, one is never accepted in place of the other", "convert explicitly: `{facts.name}.{method}(expr)`"))
    true
}

fn sema_expression_typed_literal(head: Type?, body: TypedLitBody, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if head == .Val(written) {
        if sema_expression_variant_head(written, environment, &scopes) == .Val(variant_head) {
            if body == {
                .Fields(fields) -> {
                    args :: loop field in fields -> EnumLitArg.Named{label: field.name, expr: field.value}
                    return sema_expression_enum_literal(variant_head.enum_name, [Type]{}, variant_head.variant, args, false, None, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                }
                .Empty -> return sema_expression_enum_literal(variant_head.enum_name, [Type]{}, variant_head.variant, [EnumLitArg]{}, false, None, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                else -> {}
            }
        }
    }
    written_head :: head ?? (expected ?? {
        &diagnostics.push(sema_error("E0119", span, "this inferred typed literal needs a known type", "an inferred typed literal needs an expected type from the surrounding context", "add a type head, or annotate the binding with the intended type"))
        return None
    })
    source_kind := sema_expression_typed_literal_head_kind(written_head)
    result_head := sema_expr_expected_type(sema_expr_unwrap_tag(written_head), environment)
    kind := source_kind
    if kind == None -> kind = sema_expression_typed_literal_head_kind(result_head)
    checked_text := sema_expression_checked_text_literal(result_head, head, body, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if checked_text.handled -> return checked_text.value

    if result_head == {
        .List(_) | .FixedList(_, _) -> if body == {
            .ByteText(parts) -> {
                elements :: sema_expression_typed_literal_byte_text(parts, result_head, span, &diagnostics) ?? return None
                checked :: sema_expression_list(Expr.ListLit{elements: elements, span: span}, elements, span, Val(result_head), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected(checked, expected, environment, &diagnostics)
            }
            .Empty -> {
                checked :: sema_expression_list(Expr.ListLit{elements: [Expr]{}, span: span}, [Expr]{}, span, Val(result_head), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected(checked, expected, environment, &diagnostics)
            }
            .Elements(elements) -> {
                if elements.len() == 1 && sema_expression_typed_literal_whole_value(result_head, elements[0], environment, &scopes, &state, &tail_store, &context) -> return sema_expression_typed_literal_whole(result_head, elements[0], expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                checked :: sema_expression_list(Expr.ListLit{elements: elements, span: span}, elements, span, Val(result_head), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected(checked, expected, environment, &diagnostics)
            }
            .Value(value) -> {
                if sema_expression_typed_literal_whole_value(result_head, value, environment, &scopes, &state, &tail_store, &context) -> return sema_expression_typed_literal_whole(result_head, value, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                elements := [Expr]{value}
                checked :: sema_expression_list(Expr.ListLit{elements: elements, span: span}, elements, span, Val(result_head), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected(checked, expected, environment, &diagnostics)
            }
            else -> return sema_expression_typed_literal_mismatch(result_head, span, &diagnostics)
        }
        .Map(_, _, _) -> if body == {
            .Empty -> {
                checked :: sema_expression_map(Expr.MapLit{entries: [ExprPair]{}, span: span}, [ExprPair]{}, span, Val(result_head), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected(checked, expected, environment, &diagnostics)
            }
            .Entries(entries) -> {
                checked :: sema_expression_map(Expr.MapLit{entries: entries, span: span}, entries, span, Val(result_head), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected(checked, expected, environment, &diagnostics)
            }
            // #3739: a map body without `:` can only be the whole value.
            .Value(value) -> return sema_expression_typed_literal_whole(result_head, value, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            else -> return sema_expression_typed_literal_mismatch(result_head, span, &diagnostics)
        }
        .Named(name) -> if body == {
            .Fields(fields) -> {
                checked :: sema_expression_struct_literal(name, [Type]{}, fields, false, None, span, Val(result_head), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected(checked, expected, environment, &diagnostics)
            }
            .Empty -> {
                checked :: sema_expression_struct_literal(name, [Type]{}, [ExprField]{}, false, None, span, Val(result_head), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected(checked, expected, environment, &diagnostics)
            }
            else -> {}
        }
        .Apply(name, args) -> if body == {
            .Fields(fields) -> {
                checked :: sema_expression_struct_literal(name, args, fields, false, None, span, Val(result_head), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected(checked, expected, environment, &diagnostics)
            }
            .Empty -> {
                checked :: sema_expression_struct_literal(name, args, [ExprField]{}, false, None, span, Val(result_head), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected(checked, expected, environment, &diagnostics)
            }
            else -> {}
        }
        // D-DOTCTOR3 / D-TYPE-SUFFIX1=A: `T?{ body }` checks its one-expression
        // body in the expected `T?` position, so `None` and `Val(x)` both elaborate.
        .Option(_) -> if body == {
            .Value(value) -> {
                checked :: sema_check_expression(value, Val(result_head), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                typed :: sema_expr_expected(checked, Val(result_head), environment, &diagnostics) ?? return None
                return sema_expr_expected(typed, expected, environment, &diagnostics)
            }
            else -> return sema_expression_typed_literal_mismatch(result_head, span, &diagnostics)
        }
        else -> {}
    }

    if body == {
        .Value(value) -> {
            if kind == .Val(head_kind) {
                if head_kind == MIRTypedHeadKind.SQL || head_kind == MIRTypedHeadKind.HTML || head_kind == MIRTypedHeadKind.Sh || head_kind == MIRTypedHeadKind.URL || head_kind == MIRTypedHeadKind.Path || head_kind == MIRTypedHeadKind.DateTime {
                    return sema_expression_typed_literal_text(head_kind, result_head, value, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                }
            }
            // The written `Regex` head is the compile-checked pattern literal even when
            // `use core.regex` resolves the bare name to its source-owned record.
            regex_head :: Type.Named{name: "Regex"}
            if result_head == regex_head || sema_expr_unwrap_tag(written_head) == regex_head -> return sema_expression_typed_literal_regex(regex_head, value, span, expected, environment, &diagnostics)
            checked_optional := if sema_expression_typed_literal_value_needs_head(value, result_head) -> sema_check_expression(value, Val(result_head), environment, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(value, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            checked :: checked_optional ?? return None
            converted := checked
            value_span :: expr_span(value)
            line := sema_source_line_at(environment.source_segments, value_span) ?? 0
            needs_conversion := (checked.ty == Type.Int && (if result_head == {.IntN(_, _) -> true else -> false})) || (sema_expr_is_integer(checked.ty) && (result_head == Type.Float || result_head == Type.Float32)) || (checked.ty == Type.Float && result_head == Type.Float32) || sema_expression_typed_literal_fixed_widening(checked.ty, result_head)
            if needs_conversion {
                converted = sema_expr_numeric_literal_conversion(checked, result_head, value_span, line, &diagnostics) ?? return None
            }
            if sema_expression_typed_literal_distinct_mismatch(result_head, converted, environment, &scopes, &diagnostics) -> return None
            typed :: sema_expr_expected(converted, Val(result_head), environment, &diagnostics) ?? return None
            return sema_expr_expected(typed, expected, environment, &diagnostics)
        }
        .Elements(elements) -> if elements.len() == 1 {
            value := elements[0]
            checked_optional := if sema_expression_typed_literal_value_needs_head(value, result_head) -> sema_check_expression(value, Val(result_head), environment, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(value, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            checked :: checked_optional ?? return None
            converted := checked
            value_span :: expr_span(value)
            line := sema_source_line_at(environment.source_segments, value_span) ?? 0
            needs_conversion := (checked.ty == Type.Int && (if result_head == {.IntN(_, _) -> true else -> false})) || (sema_expr_is_integer(checked.ty) && (result_head == Type.Float || result_head == Type.Float32)) || (checked.ty == Type.Float && result_head == Type.Float32) || sema_expression_typed_literal_fixed_widening(checked.ty, result_head)
            if needs_conversion {
                converted = sema_expr_numeric_literal_conversion(checked, result_head, value_span, line, &diagnostics) ?? return None
            }
            if sema_expression_typed_literal_distinct_mismatch(result_head, converted, environment, &scopes, &diagnostics) -> return None
            typed :: sema_expr_expected(converted, Val(result_head), environment, &diagnostics) ?? return None
            return sema_expr_expected(typed, expected, environment, &diagnostics)
        }
        else -> {}
    }
    sema_expression_typed_literal_mismatch(result_head, span, &diagnostics)
}

// `U64{byte}` with `byte: U8`: a lossless fixed-width widening takes the
// canonical numeric conversion instead of relabelling the narrow carrier
// (Rust CheckerInfer/expr.rs typed-literal `numeric_widening_to` on IntN pairs).
fn sema_expression_typed_literal_fixed_widening(source: Type, head: Type) -> Bool {
    if source == .IntN(_, _) && head == .IntN(_, _) && source != head {
        // A contained fixed range reports `Val(true)` here (the Rust `Some`).
        return sema_expr_numeric_widening_to(source, head) == (Val(true))
    }
    false
}

// `Float{0.5}` / `F32{-1.5}`: the machine-float head is the decimal literal's
// expected carrier, as in Rust's typed-literal inference.
fn sema_expression_typed_literal_value_needs_head(value: Expr, head: Type) -> Bool Never! {
    if sema_expression_list_element_needs_expected_type(value) -> return true
    sema_expr_decimal_literal_operand(value, true) && sema_expr_expects_machine_float(Val(head))
}
