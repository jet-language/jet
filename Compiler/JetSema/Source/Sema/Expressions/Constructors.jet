    TLetTy,
    TLetWrapper,
    TPatternBindingFact,
    TPatternPosition,
    jet_target_layout_atomic_scalar_type,
    tir_generated_local,
]

// A type named by a local binding, through a module alias
// (`types.Kind`), or by the canonical identity a declared type resolves to
// (`module::Kind`, the form declared types carry after resolution) is the
// declared type itself, so constructors, leading-dot variants and field reads
// resolve it through the registration graph when no local type binding has
// that name.
fn sema_expression_type_symbol(scopes: &SemaScopeTable, environment: SemaScopeEnvironment, program: SemaProgramTables, name: String) -> Symbol? {
    index := sema_scope_resolve_index(scopes, name)
    if index == .Val(found) {
        if scopes.bindings[found].symbol.kind == SymbolKind.Type -> return Val(sema_scope_binding_symbol(environment, scopes, found))
    }
    if program.registration_graph == .Val(graph) {
    resolved :: sema_type_graph_lookup_symbol(graph, environment.module_identity, name) ?? return None
    return if resolved.symbol.kind == SymbolKind.Type -> Val(resolved.symbol) else -> None
    }
    None
}

// A type the Core export ledger owns without a source declaration
// (`use core.encoding.[DataEvent]`, `encoding.DataEvent`): the registered
// exporting module's catalog row authenticates the enum and its variants; a
// user module with a Core-like leaf or name never takes this path.
fn sema_expression_core_export_variants(environment: SemaScopeEnvironment, program: SemaProgramTables, symbol: Symbol) -> [String]? {
    if symbol.kind != SymbolKind.Type || !symbol.module_name.starts_with("<corelib>/") -> return None
    if sema_scope_declaration_site(environment, program, symbol.id) != None -> return None
    if program.registration_graph == .Val(graph) {
    module_index :: sema_registration_module_index(graph, symbol.module_name) ?? return None
    return core_module_enum_variants(graph.modules[module_index].module_name, symbol.name)
    }
    None
}

// Rust `infer_field` (`is_known_enum`): `Name.Variant` reads a variant when
// `Name` is a declared enum, a compiler-owned enum menu (`Ordering`,
// `RemoveBy`, the fact enums) or a Core enum, and no value binding shadows it.
fn sema_expression_names_enum(name: String, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> Bool {
    index := sema_scope_resolve_index(scopes, name)
    if index == .Val(found) && scopes.bindings[found].symbol.kind != SymbolKind.Type -> return false
    if sema_fact_enum_menu(Type.Named{name: name}, environment, program) != None -> return true
    owner := sema_expression_type_symbol(&scopes, environment, program, name)
    if owner == .Val(symbol) {
        if sema_scope_declaration_is(environment, program, symbol.id, SemaScopeDeclarationKind.Enum) -> return true
        if sema_expression_core_export_variants(environment, program, symbol) != None -> return true
    }
    sema_expression_core_enum_name(name)
}

// The tail of Rust `is_known_enum`: Core enum leaves
// (`CoreModuleExports::core_enum_variants`) and the compiler-owned Core enum
// families, known whether or not the program imports them.
fn sema_expression_core_enum_name(name: String) -> Bool Never! {
    if core_enum_variants(name) != None || core_enum_payload_variants(name) != None -> return true
    if name == {
        "Key" | "ProcessSignal" | "TextWidthAmbiguous" | "TextWidthControls" |
        "WatchDomain" | "WatchKind" | "DurationUnit" | "LateEventDisposition" |
        "Overflow" | "FailurePolicy" | "DispatchState" | "HookPolicy" | "HookDecision" | "HookOutcome" |
        "NetShutdown" | "NetReadyInterest" | "NetError" | "NetDNSError" |
        "SMTPSecurity" | "RecipientPolicy" | "EmailError" |
        "DeliveryState" | "ServiceError" | "TaskOutcome" | "TaskStatus" -> true
        else -> false
    }
}

struct SemaExpressionEnumPath {
    enum_name: String
    variant: String
}

fn sema_expression_path_segments(expression: Expr) -> [String]? {
    if expression == {
        .Ident(name, _, _) -> Val([String]{name})
        .Field(inner, member, _, _) -> {
            segments := sema_expression_path_segments(inner) ?? return None
            &segments.push(member)
            Val(segments)
        }
        else -> None
    }
}

fn sema_expression_join_segments(segments: [String], start: Int) -> String Never! {
    parts := [String]{}
    loop index in start..<segments.len() -> &parts.push(segments[index])
    parts.join(".")
}

// Rust `fold_enum_variant_path`: the field chain `base.member` names a variant
// when its root is a known enum (`Kind.Beta`, grouped `Kind.Group.Leaf`), or a
// module alias whose next segment is one (`types.Kind.Beta`). A local value
// root names no variant.
fn sema_expression_enum_variant_path(base: Expr, member: String, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> SemaExpressionEnumPath? {
    segments := sema_expression_path_segments(base) ?? return None
    &segments.push(member)
    root :: segments[0]
    index :: sema_scope_resolve_index(scopes, root)
    if index == .Val(found) {
        kind :: scopes.bindings[found].symbol.kind
        // A whole-module import binds its alias as an Import symbol
        // (`use core.encoding as enc` then `enc.EncodingFormat.JSON`).
        if kind != SymbolKind.Type && kind != SymbolKind.Module && kind != SymbolKind.Import -> return None
    }
    // `use core.encoding.[Dyn as Tree]`: an alias of a Core enum carrier
    // names that enum, whose variants are read by its Core leaf.
    enum_root :: sema_expression_core_enum_alias(root, &scopes) ?? root
    if sema_expression_names_enum(enum_root, environment, program, &scopes) -> return Val(SemaExpressionEnumPath{enum_name: enum_root, variant: sema_expression_join_segments(segments, 1)})
    if segments.len() < 3 -> return None
    qualified :: "{root}.{segments[1]}"
    if !sema_expression_names_enum(qualified, environment, program, &scopes) -> return None
    Val(SemaExpressionEnumPath{enum_name: qualified, variant: sema_expression_join_segments(segments, 2)})
}

// The Core enum leaf a local type alias binds (`Tree` for `Dyn`): an
// imported Core carrier keeps its builtin type under the local name.
fn sema_expression_core_enum_alias(name: String, scopes: &SemaScopeTable) -> String? {
    index :: sema_scope_resolve_index(scopes, name) ?? return None
    symbol :: scopes.bindings[index].symbol
    if symbol.kind != SymbolKind.Type -> return None
    ty :: symbol.ty ?? return None
    if ty == .Named(leaf) {
        if leaf != name && sema_expression_core_enum_name(leaf) -> return Val(leaf)
    }
    None
}

// Rust `infer_method_call` static-owner arm (`resolve_enum_variants`) and
// `fold_enum_variant_path`: `Enum.Variant(args)` / `Enum.Group.Leaf(args)`
// written as a call builds the variant when the enum declares it; any other
// member stays a static method call.
fn sema_expression_enum_variant_call(receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    unhandled :: SemaMethodSpecialCheck{handled: false, value: None}
    if type_args.len() > 0 -> return unhandled
    loop argument in args {
        if argument.label != None || argument.spread -> return unhandled
    }
    path :: sema_expression_enum_variant_path(receiver, method, environment, program, &scopes) ?? return unhandled
    // `Dyn.Text("jet")` / `Tree.Int(7)` under an alias of the Core
    // carrier builds the compiler-owned data literal, whose variants carry
    // payloads the unit-only Core enum rows don't list. A declared enum of
    // that name keeps its own variants.
    if path.variant == method && (path.enum_name == "DBValue" || sema_data_is_json_name(path.enum_name)) {
        owner :: sema_expression_type_symbol(&scopes, environment, program, path.enum_name)
        declared_enum := false
        if owner == .Val(symbol) -> declared_enum = sema_scope_declaration_is(environment, program, symbol.id, SemaScopeDeclarationKind.Enum)
        if !declared_enum -> return sema_call_try_data_literal(Type.Named{name: path.enum_name}, path.variant, args, method_span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    if !sema_expression_enum_declares_variant(path.enum_name, path.variant, environment, program, &scopes) -> return unhandled
    // Payload slots retain written access even though they have no CallArg.
    enum_args :: loop argument in args -> EnumLitArg.Positional{value: if argument.convention == {
        .Read -> argument.expr
        .Write -> Expr.Place{value: argument.expr, access: PlaceAccess.Write, span: argument.span, id: AST_NODE_GENERATED}
        .Move -> Expr.Place{value: argument.expr, access: PlaceAccess.Take, span: argument.span, id: AST_NODE_GENERATED}
    }}
    end := method_span.end
    if args.len() > 0 && args[args.len() - 1].span.end > end -> end = args[args.len() - 1].span.end
    span :: Span{start: expr_span(receiver).start, end: end}
    SemaMethodSpecialCheck{handled: true, value: sema_expression_enum_literal(path.enum_name, owner_type_args, path.variant, enum_args, false, Val(method_span), span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)}
}

fn sema_expression_enum_declares_variant(enum_name: String, variant: String, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> Bool {
    owner :: sema_expression_type_symbol(&scopes, environment, program, enum_name)
    if owner == .Val(symbol) {
        if sema_scope_declaration_is(environment, program, symbol.id, SemaScopeDeclarationKind.Enum) -> return sema_scope_declaration_enum_declares(environment, program, symbol.id, variant)
    }
    core_enum_variant_payload(enum_name, variant) != None
}

// Rust `canonical_nominal_name`: two spellings of one declared nominal
// (`Box`, `types.Box`, `module::Box`) name the same head.
fn sema_expression_same_nominal_head(left: String, right: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if left == right -> return true
    if program.registration_graph == .Val(graph) {
        caller :: sema_type_module_row(graph, environment.module_identity)
        return sema_type_graph_resolve_apply_name(graph, left, caller) == sema_type_graph_resolve_apply_name(graph, right, caller)
    }
    false
}

struct SemaExpressionResolvedType {
    ty: Type
    owner: Symbol
}

fn sema_expression_struct_type(type_name: String, type_args: [Type], expected: Type?, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaExpressionResolvedType? {
    if type_name == "" {
        expected_ty :: expected ?? {
            &diagnostics.push(sema_error("E0119", span, "an inferred struct literal needs an expected type", "the `{{ ... }}` form uses the surrounding type to choose its fields", "write the struct name or add a type annotation"))
            return None
        }
        normalized :: sema_expr_unwrap_tag(sema_expr_expected_type(expected_ty, environment, program))
        if normalized == {
            .Named(name) -> {
                owner :: sema_expression_type_symbol(&scopes, environment, program, name) ?? {
                    &diagnostics.push(sema_error("E0119", span, "the expected type is not a registered struct", "inferred construction needs declaration metadata for its fields", "name a declared struct type"))
                    return None
                }
                return Val(SemaExpressionResolvedType{ty: normalized, owner: owner})
            }
            .Apply(name, args) -> {
                owner :: sema_expression_type_symbol(&scopes, environment, program, name) ?? {
                    &diagnostics.push(sema_error("E0119", span, "the expected type is not a registered struct", "inferred construction needs declaration metadata for its fields", "name a declared struct type"))
                    return None
                }
                return Val(SemaExpressionResolvedType{ty: normalized, owner: owner})
            }
            else -> {
                &diagnostics.push(sema_error("E0119", span, "`{{ ... }}` needs a known struct type", "inferred construction requires a nominal struct type from context", "name the type before the fields"))
                return None
            }
        }
    }
    owner :: sema_expression_type_symbol(&scopes, environment, program, type_name) ?? {
        &diagnostics.push(sema_unknown_name(type_name, span))
        return None
    }
    ty := if type_args.len() > 0 -> Type.Apply{name: type_name, args: type_args} else -> Type.Named{name: type_name}
    if type_args.len() == 0 && expected == .Val(expected_ty) {
        normalized_expected :: sema_expr_unwrap_tag(expected_ty)
        if normalized_expected == .Apply(name, _) {
            if sema_expression_same_nominal_head(name, type_name, environment, program) -> ty = normalized_expected
        }
    }
    resolved_ty :: sema_expr_expected_type(ty, environment, program)
    resolved_name := if resolved_ty == {
        .Named(name) | .Apply(name, _) -> name
        else -> type_name
    }
    resolved_owner :: sema_expression_type_symbol(&scopes, environment, program, resolved_name) ?? owner
    Val(SemaExpressionResolvedType{ty: resolved_ty, owner: resolved_owner})
}

// Rust CheckerItems::atomic_field_inner: only supported Atomic
// fields take a scalar initializer. Ordinary generic owners keep their type.
fn sema_atomic_field_inner(ty: Type) -> Type? Never! {
    if ty == .Apply(name, args) {
        if sema_atomic_type_name(name) && args.len() > 0 && jet_target_layout_atomic_scalar_type(args[0]) -> return Val(args[0])
    }
    None
}

// Reuse the canonical Atomic.new row so typed field construction reaches the
// same MIR carrier as an explicit constructor, without rechecking/moving twice.
fn sema_atomic_field_initializer(field_ty: Type, value: TExpr, source: Expr) -> TExpr? {
    inner :: sema_atomic_field_inner(field_ty) ?? return Val(value)
    row :: sema_call_builtin_static_row("Atomic", "new", "") ?? return None
    argument :: CallArg{convention: row.parameter_convention, expr: source, span: expr_span(source), flags: ast_empty_call_arg_flags(), label: None, spread: false}
    bindings :: [SemaInferenceBinding]{SemaInferenceBinding{name: row.type_params[0], ty: inner, source: "atomic field initializer"}}
    kind :: sema_call_builtin_static_lowered(row, [TExpr]{value}, [CallArg]{^argument}, bindings, value.span) ?? return None
    Val(sema_tir_expr(field_ty, kind, value.span))
}

// One struct field initializer, written or a declared default, checked
// against the field type with the owner's generic arguments substituted. Its
// move is recorded at this point of the literal's evaluation order.
fn sema_expression_struct_field_value(field: Field, field_value: Expr, field_reference_span: Span, atomic_payload: Bool, owner: Symbol, names: [String], args: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStructFieldValue? {
    field_ty :: sema_inference_substitute_type(sema_expression_field_owner_type(environment, program, owner.module_name, field.ty, names), names, args)
    expected_ty :: if atomic_payload -> sema_atomic_field_inner(field_ty) ?? field_ty else -> field_ty
    string_view :: sema_stmt_string_view_type(field_ty)
    if !string_view -> sema_copy_site_check_field(field_value, environment, program, scopes, &tail_store, &context, &diagnostics)
    checked_value := if string_view -> sema_string_view_check_field(field_value, field_ty, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression_with_lambda_escapes(field_value, Val(expected_ty), environment, program, &scopes, &state, &tail_store, &context, Val(true), &diagnostics)
    checked :: checked_value ?? return None
    if !string_view && !sema_copy_site_check_guard_owned(checked, environment, program, scopes, context, &diagnostics, false) -> return None
    // A supported Atomic field checks its scalar initializer against the
    // scalar (`expected_ty`); the Atomic.new carrier is added below.
    compatible :: sema_expr_expected_assignable(expected_ty, checked.ty, environment, program) ?? return None
    if !compatible {
        &diagnostics.push(sema_type_mismatch(sema_expr_expected_type(expected_ty, environment, program), sema_expr_expected_type(checked.ty, environment, program), expr_span(field_value)))
        return None
    }
    if !string_view && !sema_copy_site_record_move(field_value, scopes, &state, &tail_store, &context, &diagnostics) -> return None
    field_id :: symbol_id(SymbolKind.Field, owner.module_name, owner.id.key, field.name)
    symbol :: Symbol{id: field_id, kind: SymbolKind.Field, name: field.name, module_name: owner.module_name, owner: Val(owner.id.key), span: field.name_span, ty: Val(field_ty), visibility: if field.is_pub -> 2 else -> if field.is_package_pub -> 1 else -> 0}
    &context.name_references.push(SemaNameReferenceFact{span: field_reference_span, symbol: symbol, kind: "field"})
    reference := sema_expression_field_ref(symbol, Val(owner.id), field_ty)
    reference.boxed = sema_scope_environment_boxed_edge(environment, program, owner.id, field.name)
    initialized :: if atomic_payload -> sema_atomic_field_initializer(field_ty, checked, field_value) ?? return None else -> checked
    Val(TStructFieldValue{field: reference, value: initialized, boxed: reference.boxed})
}

// An omitted field's declared default. Written in another module, it checks in
// that module's names (sema_default_owner_scope); a problem it reports there is
// anchored at this literal.
fn sema_expression_struct_field_default(field: Field, default_value: Expr, literal_span: Span, owner: Symbol, names: [String], args: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStructFieldValue? {
    owner_scope := sema_default_owner_scope(environment, program, scopes, owner.module_name, default_value)
    scope := ^owner_scope ?? {
        return sema_expression_struct_field_value(field, default_value, field.name_span, false, owner, names, args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    default_diagnostics := [Diagnostic]{}
    checked :: sema_expression_struct_field_value(field, default_value, field.name_span, false, owner, names, args, scope.environment, program, &scope.scopes, &scope.state, &tail_store, &context, &default_diagnostics)
    loop diagnostic in default_diagnostics -> &diagnostics.push(sema_default_use_site_diagnostic(diagnostic, literal_span))
    checked
}

// A builtin Core record (`IOContext{...}`, `Tensor{...}`) has no Jet
// declaration; its literal checks against the generated Core record rows.
// A program declaration of the same name takes precedence.
fn sema_expression_core_record_name(struct_name: String, type_args: [Type], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> String? {
    if type_args.len() > 0 -> return None
    name := struct_name
    if name == "" {
        expected_ty :: expected ?? return None
        name = if sema_expr_unwrap_tag(expected_ty) == {
            .Named(expected_name) -> expected_name
            else -> { return None }
        }
    }
    if sema_expression_type_symbol(&scopes, environment, program, name) != None -> return None
    if core_record_literal_fields(name) == None -> return None
    if core_record_literal_is_core_only(name) && !sema_module_is_core_source(environment.module_identity) -> return None
    Val(name)
}

fn sema_expression_core_record_field_value(owner_name: String, field: TypeTupleField, field_value: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStructFieldValue? {
    sema_copy_site_check_field(field_value, environment, program, scopes, &tail_store, &context, &diagnostics)
    checked :: sema_check_expression_with_lambda_escapes(field_value, Val(field.ty), environment, program, &scopes, &state, &tail_store, &context, Val(true), &diagnostics) ?? return None
    if !sema_copy_site_check_guard_owned(checked, environment, program, scopes, context, &diagnostics, false) -> return None
    compatible :: sema_expr_expected_assignable(field.ty, checked.ty, environment, program) ?? return None
    if !compatible {
        &diagnostics.push(sema_type_mismatch(sema_expr_expected_type(field.ty, environment, program), sema_expr_expected_type(checked.ty, environment, program), expr_span(field_value)))
        return None
    }
    if !sema_copy_site_record_move(field_value, scopes, &state, &tail_store, &context, &diagnostics) -> return None
    reference :: TFieldRef{owner: None, field: symbol_id(SymbolKind.Field, "", owner_name, field.name), name: field.name, ty: field.ty, boxed: false}
    Val(TStructFieldValue{field: reference, value: checked, boxed: false})
}

fn sema_expression_core_record_literal(owner_name: String, fields: [ExprField], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    declared :: core_record_literal_fields(owner_name) ?? return None
    supplied := [Bool]{}
    loop _ in declared -> &supplied.push(false)
    loop source in fields {
        found := -1
        loop (index, row) in declared {
            if row.name == source.name {
                found = index
                break
            }
        }
        if found < 0 {
            &diagnostics.push(sema_error("E0302", source.name_span, "`{owner_name}` has no field `{source.name}`", "struct fields must be declared by the type", "use one of the declared field names"))
            return None
        }
        if supplied[found] {
            &diagnostics.push(sema_error("E0105", source.name_span, "field `{source.name}` is supplied more than once", "each struct field receives one value", "remove the duplicate field"))
            return None
        }
        supplied[found] = true
    }
    loop (index, row) in declared {
        if !supplied[index] {
            &diagnostics.push(sema_error("E0108", span, "field `{row.name}` needs a value", "a struct literal must initialize every field without a default", "supply `{row.name}: ...`"))
            return None
        }
    }
    values := [TStructFieldValue]{}
    loop source in fields {
        loop row in declared {
            if row.name != source.name -> next
            checked :: sema_expression_core_record_field_value(owner_name, row, source.value, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
            &values.push(checked)
            break
        }
    }
    value :: sema_tir_node(Type.Named{name: owner_name}, TExprKind.StructLit{fields: values}, span)
    sema_expr_expected(value, expected, environment, program, &diagnostics)
}

fn sema_expression_struct_literal(struct_name: String, type_args: [Type], fields: [ExprField], inferred: Bool, as_trait: String?, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if !inferred && as_trait == None {
        head :: if type_args.len() > 0 -> Type.Apply{name: struct_name, args: type_args} else -> Type.Named{name: struct_name}
        if sema_expression_variant_head(head, environment, program, &scopes) == .Val(variant_head) {
            enum_args :: loop field in fields -> EnumLitArg.Named{label: field.name, expr: field.value}
            return sema_expression_enum_literal(variant_head.enum_name, type_args, variant_head.variant, enum_args, false, None, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        }
    }
    if as_trait == None {
        core_record :: sema_expression_core_record_name(struct_name, type_args, expected, environment, program, &scopes)
        if core_record == .Val(core_name) -> return sema_expression_core_record_literal(core_name, fields, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    resolved :: sema_expression_struct_type(struct_name, type_args, expected, span, environment, program, &scopes, &diagnostics) ?? return None
    owner := resolved.owner
    &context.name_references.push(SemaNameReferenceFact{span: span, symbol: owner, kind: "type"})
    result_ty := resolved.ty
    // The struct's fields and type parameters, read at the declaration
    // without copying its methods.
    if sema_scope_declaration_kind(environment, program, owner.id) == None {
        &diagnostics.push(sema_error("E0119", span, "struct `{type_name(result_ty)}` has no declaration metadata", "a struct literal must check every declared field before lowering", "use a registered struct declaration"))
        return None
    }
    struct_def :: sema_scope_declaration_struct(environment, program, owner.id) ?? {
        &diagnostics.push(sema_error("E0119", span, "`{type_name(result_ty)}` is not a struct", "struct literal syntax only constructs struct declarations", "use the enum variant constructor for an enum"))
        return None
    }
    names :: loop parameter in struct_def.type_params -> parameter.name
    args := if result_ty == {
        .Apply(_, rows) -> rows
        else -> [Type]{}
    }
    if args.len() != names.len() {
        &diagnostics.push(sema_error("E0104", span, "struct `{type_name(result_ty)}` has the wrong number of type arguments", "each declared type parameter needs one concrete argument", "provide one type argument for every generic parameter"))
        return None
    }
    supplied := [Bool]{}
    loop _ in struct_def.fields -> &supplied.push(false)
    loop source in fields {
        found := -1
        loop (index, declared) in struct_def.fields {
            if declared.name == source.name {
                found = index
                break
            }
        }
        if found < 0 {
            &diagnostics.push(sema_error("E0302", source.name_span, "`{type_name(result_ty)}` has no field `{source.name}`", "struct fields must be declared by the type", "use one of the declared field names"))
            return None
        }
        if supplied[found] {
            &diagnostics.push(sema_error("E0105", source.name_span, "field `{source.name}` is supplied more than once", "each struct field receives one value", "remove the duplicate field"))
            return None
        }
        supplied[found] = true
    }
    // Rust `check_struct_lit`: supplied fields are checked (and their moves
    // recorded) in the order they are written, then omitted fields take their
    // defaults in declaration order. The TIR keeps that order, so lowering
    // evaluates the initializers exactly as written.
    values := [TStructFieldValue]{}
    loop source in fields {
        loop field in struct_def.fields {
            if field.name != source.name -> next
            checked :: sema_expression_struct_field_value(field, source.value, source.name_span, true, owner, names, args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
            &values.push(checked)
            break
        }
    }
    loop (index, field) in struct_def.fields {
        if supplied[index] -> next
        default_value :: field.default ?? {
            &diagnostics.push(sema_error("E0108", span, "field `{field.name}` needs a value", "a struct literal must initialize every field without a default", "supply `{field.name}: ...` or declare a field default"))
            return None
        }
        checked :: sema_expression_struct_field_default(field, default_value, span, owner, names, args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        &values.push(checked)
    }
    value := sema_tir_node(result_ty, TExprKind.StructLit{fields: values}, span)
    if as_trait == .Val(trait_name) {
        trait_symbol_index :: sema_scope_resolve_index(scopes, trait_name)
        if trait_symbol_index == None || scopes.bindings[trait_symbol_index ?? 0].symbol.kind != SymbolKind.Trait {
            &diagnostics.push(sema_error("E0119", span, "`{trait_name}` is not a registered trait", "trait coercion must retain the target trait identity", "name a declared trait"))
            return None
        }
        trait_symbol :: sema_scope_binding_symbol(environment, scopes, trait_symbol_index ?? 0)
        &context.name_references.push(SemaNameReferenceFact{span: span, symbol: trait_symbol, kind: "trait"})
        resolved_trait :: sema_expr_expected_type(Type.Named{name: trait_name}, environment, program)
        target :: if resolved_trait == {
            .TraitObject(_) -> resolved_trait
            else -> Type.TraitObject{bounds: [String]{trait_symbol.name}}
        }
        value = sema_tir_node(target, TExprKind.TraitBox{value: value, target: target}, span)
    }
    sema_expr_expected(value, expected, environment, program, &diagnostics)
}

fn sema_expression_enum_literal(type_name: String, type_args: [Type], variant: String, args: [EnumLitArg], leading_dot: Bool, variant_span: Span?, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    contextual_allowed :: if {
        !leading_dot -> true
        else -> if sema_expr_unwrap_tag(expected ?? Type.Named{name: "Never"}) == {
            .Option(_) -> true
            else -> false
        }
    }
    if type_name == "" && contextual_allowed && variant == "Val" && args.len() == 1 {
        if args[0] == {
            .Positional(value) -> return sema_expression_present(value, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            else -> {}
        }
    }
    if type_name == "" && contextual_allowed && variant == "None" && args.len() == 0 {
        return sema_expression_absent(span, expected, &diagnostics)
    }
    // Leading-dot Result cases are contextual only when the expected type
    // is a Result; a declared enum's `.Ok` / `.Err` remains its own case.
    if type_name == "" && leading_dot && sema_expr_unwrap_tag(expected ?? Type.Named{name: "Never"}) == .Result(_, _) && args.len() == 1 {
        if args[0] == .Positional(value) {
            if variant == "Ok" -> return sema_expression_result_payload(value, true, false, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            if variant == "Err" {
                &context.failure_edges.push("")
                return sema_expression_result_payload(value, false, false, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            }
        }
    }
    resolved_name := type_name
    if resolved_name == "" {
        expected_ty :: expected ?? {
            &diagnostics.push(sema_error("E0330", span, "can't infer the enum type for `.{variant}`", "a leading-dot variant needs a known enum type from context", "write the full form `EnumName.{variant}`, or use it where its enum type is already expected"))
            return None
        }
        normalized :: sema_expr_unwrap_tag(expected_ty)
        resolved_name = if normalized == {
            .Named(name) -> name
            .Apply(name, _) -> name
            .Option(inner) -> if inner == {
                .Named(name) -> name
                else -> ""
            }
            // A case that exactly one union member declares
            // builds that member.
            .Union(_) -> sema_pattern_flat_union_owner_name(normalized, variant, environment, program, span) ?? ""
            else -> ""
        }
        if resolved_name == "" {
            &diagnostics.push(sema_error("E0330", span, "can't infer the enum type for `.{variant}`", "a leading-dot variant needs a known enum type from context", "write the full form `EnumName.{variant}`, or use it where its enum type is already expected"))
            return None
        }
    }
    // `ExactnessKind.Approximate` / `.Approximate` builds a
    // compiler-owned fact enum value, which has no registered declaration.
    fact_enum :: sema_fact_enum_literal(resolved_name, variant, args, span, variant_span, expected, environment, program, &diagnostics)
    if fact_enum.handled -> return fact_enum.value
    // Compiler-owned data cases have no user enum declaration metadata.
    // Route both qualified and contextual cases through the same payload
    // checker as the static-call spelling.
    if sema_data_is_json_name(resolved_name) || resolved_name == "DBValue" {
        if !sema_data_check_explicit_type_args(resolved_name, type_args, 0, span, &diagnostics) -> return None
        call_args := [CallArg]{}
        loop argument in args {
            payload_expr :: if argument == {
                .Positional(value) -> value
                else -> {
                    &diagnostics.push(sema_error("E0764", span, "variant `{variant}` takes a positional payload", "compiler-owned data cases do not have field labels", "pass the value without a label"))
                    return None
                }
            }
            &call_args.push(CallArg{convention: AccessConvention.Read, expr: payload_expr, span: expr_span(payload_expr), flags: ast_empty_call_arg_flags(), label: None, spread: false})
        }
        checked :: sema_call_try_data_literal(Type.Named{name: resolved_name}, variant, call_args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return checked.value
    }
    // A compiler-owned unit-only enum (`DurationUnit`) has neither a source
    // declaration nor generated Core rows.
    if sema_expression_compiler_unit_enum_variants(resolved_name) == .Val(compiler_variants) {
        if sema_expression_type_symbol(&scopes, environment, program, resolved_name) == None -> return sema_expression_compiler_unit_enum_literal(resolved_name, compiler_variants, variant, args, variant_span, span, expected, environment, program, &diagnostics)
    }
    // A Core enum with no source declaration (`IOError`, `ProcessStreamMode`)
    // builds its variant from the generated Core enum rows.
    owner_symbol :: sema_expression_type_symbol(&scopes, environment, program, resolved_name)
    if owner_symbol == None {
        core_variants := core_enum_payload_variants(resolved_name)
        if core_variants == None -> core_variants = core_enum_variants(resolved_name)
        if core_variants == .Val(variants) {
            // A source-owned Core enum is named by its canonical identity.
            modules :: core_type_modules(resolved_name)
            display_name :: if core_source_owns_type(resolved_name) && modules.len() == 1 -> "<corelib>/{modules[0]}::{core_module_type_leaf(resolved_name)}" else -> resolved_name
            return sema_expression_core_enum_literal(resolved_name, display_name, variants, variant, args, variant_span, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        }
    }
    if owner_symbol == .Val(core_owner) {
        if sema_expression_core_export_variants(environment, program, core_owner) == .Val(variants) {
            &context.name_references.push(SemaNameReferenceFact{span: span, symbol: core_owner, kind: "type"})
            // A payload diagnostic names a Core enum by its canonical
            // `<corelib>/module::Name` identity (Rust `display_type_name`).
            display_name :: "{core_owner.module_name}::{core_owner.name}"
            return sema_expression_core_enum_literal(core_owner.name, display_name, variants, variant, args, variant_span, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        }
    }
    if type_name == "" {
        inferred_owner :: sema_expression_type_symbol(&scopes, environment, program, resolved_name)
        inferred_is_enum := false
        if inferred_owner == .Val(inferred_symbol) -> inferred_is_enum = sema_scope_declaration_is(environment, program, inferred_symbol.id, SemaScopeDeclarationKind.Enum)
        if !inferred_is_enum {
            &diagnostics.push(sema_error("E0330", span, "can't infer the enum type for `.{variant}`", "a leading-dot variant needs a known enum type from context", "write the full form `EnumName.{variant}`, or use it where its enum type is already expected"))
            return None
        }
    }
    owner :: sema_expression_type_symbol(&scopes, environment, program, resolved_name) ?? {
        &diagnostics.push(sema_unknown_name(resolved_name, span))
        return None
    }
    &context.name_references.push(SemaNameReferenceFact{span: span, symbol: owner, kind: "type"})
    // The enum's variants, groups and type parameters, read at the
    // declaration without copying its methods.
    if sema_scope_declaration_kind(environment, program, owner.id) == None {
        &diagnostics.push(sema_error("E0119", span, "enum `{resolved_name}` has no declaration metadata", "an enum constructor must check its variant payload", "use a registered enum declaration"))
        return None
    }
    enum_def :: sema_scope_declaration_enum(environment, program, owner.id) ?? {
        &diagnostics.push(sema_error("E0119", span, "`{resolved_name}` is not an enum", "enum literal syntax only constructs enum declarations", "use a struct literal for a struct type"))
        return None
    }
    selected := Variant?{None}
    loop candidate in enum_def.variants {
        if candidate.name == variant {
            selected = Val(candidate)
            break
        }
    }
    selected_variant :: selected ?? {
        // E0332: a group name in value position; a value is always a leaf.
        loop group in enum_def.groups {
            if group.path != variant -> next
            leaves := [String]{}
            loop candidate in enum_def.variants {
                if candidate.name.starts_with("{variant}.") -> &leaves.push("`{resolved_name}.{candidate.name}`")
            }
            &diagnostics.push(sema_error("E0332", variant_span ?? span, "`{variant}` is a group, not a value", "a group names its whole subtree in patterns; an actual value is always a leaf variant", "pick a leaf: {leaves.join(", ")}"))
            return None
        }
        variant_names :: loop candidate in enum_def.variants -> candidate.name
        &diagnostics.push(sema_enum_unknown_variant(resolved_name, variant, variant_names, span, variant_span))
        return None
    }
    variant_id :: symbol_id(SymbolKind.Variant, owner.module_name, owner.id.key, variant)
    variant_symbol :: Symbol{id: variant_id, kind: SymbolKind.Variant, name: variant, module_name: owner.module_name, owner: Val(owner.id.key), span: selected_variant.name_span, ty: sema_registration_variant_type(selected_variant.payload), visibility: owner.visibility}
    &context.name_references.push(SemaNameReferenceFact{span: variant_span ?? span, symbol: variant_symbol, kind: "variant"})
    generic_names :: loop parameter in enum_def.type_params -> parameter.name
    generic_args := type_args
    if generic_args.len() == 0 && expected == .Val(expected_ty) {
        normalized :: sema_expr_unwrap_tag(expected_ty)
        if normalized == .Apply(name, rows) {
            if sema_expression_same_nominal_head(name, resolved_name, environment, program) -> generic_args = rows
        }
    }
    if generic_args.len() != generic_names.len() {
        &diagnostics.push(sema_error("E0104", span, "enum `{resolved_name}` has the wrong number of type arguments", "each declared type parameter needs one concrete argument", "provide one type argument for every generic parameter"))
        return None
    }
    payload := TEnumPayload.Unit
    // The enum as diagnostics name it: a Core enum by its canonical identity,
    // a program enum by its declared name.
    payload_owner :: if owner.module_name.starts_with("<corelib>/") -> "{owner.module_name}::{owner.name}" else -> owner.name
    if selected_variant.payload == {
        .Unit -> {
            if args.len() != 0 {
                &diagnostics.push(sema_enum_unit_payload(resolved_name, variant, span))
                return None
            }
        }
        .Single(ty, _) -> {
            if args.len() != 1 {
                &diagnostics.push(sema_error("E0104", span, "variant `{variant}` expects one payload", "this enum variant has one positional field", "pass exactly one value"))
                return None
            }
            payload_expr :: if args[0] == {
                // copy: `value` is a payload of read parameter `args`, which keeps the original; the assigned `payload_expr` owns this one
                .Positional(value) -> value.copy()
                else -> {
                    &diagnostics.push(sema_error("E0764", span, "variant `{variant}` takes a positional payload", "single-payload variants do not have field labels", "pass the value without a label"))
                    return None
                }
            }
            // As a struct field: the payload type names types as the enum's
            // module sees them (Rust `owner_type_for_reader`).
            payload_ty :: sema_inference_substitute_type(sema_expression_field_owner_type(environment, program, owner.module_name, ty, generic_names), generic_names, generic_args)
            sema_copy_site_check_field(payload_expr, environment, program, scopes, &tail_store, &context, &diagnostics)
            diagnostic_start :: diagnostics.len()
            checked :: sema_check_expression(payload_expr, Val(payload_ty), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? {
                sema_expression_enum_payload_replace_mismatch(payload_owner, variant, None, payload_ty, payload_expr, diagnostic_start, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                return None
            }
            if !sema_copy_site_check_guard_owned(checked, environment, program, scopes, context, &diagnostics, false) -> return None
            compatible :: sema_expr_expected_assignable(payload_ty, checked.ty, environment, program) ?? return None
            if !compatible {
                &diagnostics.push(sema_expression_enum_payload_mismatch(payload_owner, variant, None, payload_ty, checked.ty, expr_span(payload_expr), environment, program))
                return None
            }
            if !sema_copy_site_record_move(payload_expr, scopes, &state, &tail_store, &context, &diagnostics) -> return None
            payload = TEnumPayload.Positional{args: [TEnumArg]{TEnumArg{value: checked}}}
        }
        .Named(fields) -> {
            // Rust `check_enum_lit`: payload fields are checked and kept in the
            // order they are written; lowering evaluates them in that order and
            // places each into its declared slot afterwards.
            supplied := [Bool]{}
            loop _ in fields -> &supplied.push(false)
            named_values := [TNamedEnumArg]{}
            // A field whose value does not fit its slot is reported and the
            // remaining fields are still checked, so every bad field reports.
            failed := false
            loop arg in args {
                label := ""
                payload_expr := Expr.Unit{span: span, id: AST_NODE_GENERATED}
                if arg == {
                    .Named(name, value) -> {
                        label = name
                        payload_expr = value
                    }
                    .Positional(_) -> {
                        &diagnostics.push(sema_error("E0764", span, "variant `{variant}` needs named payload fields", "this enum variant declares labeled fields", "write each variant field as `name: value`"))
                        return None
                    }
                }
                found := -1
                loop (index, declared) in fields {
                    if declared.name == label {
                        found = index
                        break
                    }
                }
                if found < 0 {
                    &diagnostics.push(sema_error("E0302", expr_span(payload_expr), "variant `{variant}` has no field `{label}`", "named enum payloads use the declaration's field names", "use a declared payload field"))
                    return None
                }
                if supplied[found] {
                    &diagnostics.push(sema_error("E0105", expr_span(payload_expr), "variant field `{label}` is supplied more than once", "each enum payload field receives one value", "remove the duplicate field"))
                    return None
                }
                supplied[found] = true
                field_ty :: sema_inference_substitute_type(sema_expression_field_owner_type(environment, program, owner.module_name, fields[found].ty, generic_names), generic_names, generic_args)
                sema_copy_site_check_field(payload_expr, environment, program, scopes, &tail_store, &context, &diagnostics)
                diagnostic_start :: diagnostics.len()
                checked_value :: sema_check_expression(payload_expr, Val(field_ty), environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                if checked_value == None {
                    sema_expression_enum_payload_replace_mismatch(payload_owner, variant, Val(label), field_ty, payload_expr, diagnostic_start, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                    failed = true
                    next
                }
                checked :: checked_value
                if !sema_copy_site_check_guard_owned(checked, environment, program, scopes, context, &diagnostics, false) -> return None
                compatible :: sema_expr_expected_assignable(field_ty, checked.ty, environment, program) ?? return None
                if !compatible {
                    &diagnostics.push(sema_expression_enum_payload_mismatch(payload_owner, variant, Val(label), field_ty, checked.ty, expr_span(payload_expr), environment, program))
                    failed = true
                    next
                }
                if !sema_copy_site_record_move(payload_expr, scopes, &state, &tail_store, &context, &diagnostics) -> return None
                &named_values.push(TNamedEnumArg{name: label, value: TEnumArg{value: checked}})
            }
            loop (index, was_supplied) in supplied {
                if !was_supplied {
                    &diagnostics.push(sema_error("E0108", span, "variant field `{fields[index].name}` needs a value", "named enum payloads initialize every declared field", "supply the missing payload field"))
                    return None
                }
            }
            if failed -> return None
            payload = TEnumPayload.Named{fields: named_values}
        }
    }
    // The written spelling may be an import alias. The result carries the
    // actual declaration owner's type, just as its payload field types do.
    declared_enum_ty :: if generic_args.len() > 0 -> Type.Apply{name: owner.name, args: generic_args} else -> Type.Named{name: owner.name}
    enum_ty :: sema_expression_field_owner_type(environment, program, owner.module_name, declared_enum_ty, generic_names)
    value :: sema_tir_node(enum_ty, TExprKind.EnumCtor{owner: owner.id, variant: variant_id, payload: payload}, span)
    sema_expr_expected(value, expected, environment, program, &diagnostics)
}

// A variant of a Core enum without a source declaration: unit variants take no
// payload and payload variants take one positional value per row type.
fn sema_expression_core_enum_literal(enum_name: String, display_name: String, variants: [String], variant: String, args: [EnumLitArg], variant_span: Span?, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    payload_types :: core_enum_variant_payload(enum_name, variant) ?? {
        &diagnostics.push(sema_enum_unknown_variant(enum_name, variant, variants, span, variant_span))
        return None
    }
    if payload_types.len() == 0 && args.len() != 0 {
        &diagnostics.push(sema_enum_unit_payload(enum_name, variant, span))
        return None
    }
    if core_enum_variant_labels(enum_name, variant) == .Val(labels) {
        return sema_expression_core_enum_named_literal(enum_name, display_name, variant, labels, payload_types, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    if args.len() != payload_types.len() {
        &diagnostics.push(sema_error("E0104", span, "variant `{variant}` expects {payload_types.len()} payload values", "this Core enum variant has positional payload fields", "pass exactly {payload_types.len()} values"))
        return None
    }
    checked_args := [TEnumArg]{}
    loop (index, argument) in args {
        payload_expr :: if argument == {
            .Positional(value) -> value
            else -> {
                &diagnostics.push(sema_error("E0764", span, "variant `{variant}` takes a positional payload", "Core enum payload values do not have field labels", "pass the value without a label"))
                return None
            }
        }
        payload_ty :: payload_types[index]
        sema_copy_site_check_field(payload_expr, environment, program, scopes, &tail_store, &context, &diagnostics)
        diagnostic_start :: diagnostics.len()
        checked :: sema_check_expression(payload_expr, Val(payload_ty), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? {
            sema_expression_enum_payload_replace_mismatch(display_name, variant, None, payload_ty, payload_expr, diagnostic_start, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            return None
        }
        if !sema_copy_site_check_guard_owned(checked, environment, program, scopes, context, &diagnostics, false) -> return None
        compatible :: sema_expr_expected_assignable(payload_ty, checked.ty, environment, program) ?? return None
        if !compatible {
            &diagnostics.push(sema_expression_enum_payload_mismatch(display_name, variant, None, payload_ty, checked.ty, expr_span(payload_expr), environment, program))
            return None
        }
        if !sema_copy_site_record_move(payload_expr, scopes, &state, &tail_store, &context, &diagnostics) -> return None
        &checked_args.push(TEnumArg{value: checked})
    }
    payload :: if checked_args.len() == 0 -> TEnumPayload.Unit else -> TEnumPayload.Positional{args: checked_args}
    value :: sema_tir_node(Type.Named{name: enum_name}, TExprKind.EnumLit{enum_type: enum_name, variant: variant, payload: payload}, span)
    sema_expr_expected(value, expected, environment, program, &diagnostics)
}

// A named-payload case of a Core enum without a source declaration
// (`EmailError.Configuration{...}`), checked like a declared enum's named
// payload (Rust `check_enum_lit`): fields keep their written order and every
// declared field gets exactly one value.
fn sema_expression_core_enum_named_literal(enum_name: String, display_name: String, variant: String, labels: [String], payload_types: [Type], args: [EnumLitArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    supplied := [Bool]{}
    loop _ in labels -> &supplied.push(false)
    named_values := [TNamedEnumArg]{}
    failed := false
    loop arg in args {
        label := ""
        payload_expr := Expr.Unit{span: span, id: AST_NODE_GENERATED}
        if arg == {
            .Named(name, value) -> {
                label = name
                payload_expr = value
            }
            .Positional(_) -> {
                &diagnostics.push(sema_error("E0764", span, "variant `{variant}` needs named payload fields", "this enum variant declares labeled fields", "write each variant field as `name: value`"))
                return None
            }
        }
        found := -1
        loop (index, declared) in labels {
            if declared == label {
                found = index
                break
            }
        }
        if found < 0 {
            &diagnostics.push(sema_error("E0302", expr_span(payload_expr), "variant `{variant}` has no field `{label}`", "named enum payloads use the declaration's field names", "use a declared payload field"))
            return None
        }
        if supplied[found] {
            &diagnostics.push(sema_error("E0105", expr_span(payload_expr), "variant field `{label}` is supplied more than once", "each enum payload field receives one value", "remove the duplicate field"))
            return None
        }
        supplied[found] = true
        field_ty :: payload_types[found]
        sema_copy_site_check_field(payload_expr, environment, program, scopes, &tail_store, &context, &diagnostics)
        diagnostic_start :: diagnostics.len()
        checked_value :: sema_check_expression(payload_expr, Val(field_ty), environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        if checked_value == None {
            sema_expression_enum_payload_replace_mismatch(display_name, variant, Val(label), field_ty, payload_expr, diagnostic_start, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            failed = true
            next
        }
        checked :: checked_value
        if !sema_copy_site_check_guard_owned(checked, environment, program, scopes, context, &diagnostics, false) -> return None
        compatible :: sema_expr_expected_assignable(field_ty, checked.ty, environment, program) ?? return None
        if !compatible {
            &diagnostics.push(sema_expression_enum_payload_mismatch(display_name, variant, Val(label), field_ty, checked.ty, expr_span(payload_expr), environment, program))
            failed = true
            next
        }
        if !sema_copy_site_record_move(payload_expr, scopes, &state, &tail_store, &context, &diagnostics) -> return None
        &named_values.push(TNamedEnumArg{name: label, value: TEnumArg{value: checked}})
    }
    loop (index, was_supplied) in supplied {
        if !was_supplied {
            &diagnostics.push(sema_error("E0108", span, "variant field `{labels[index]}` needs a value", "named enum payloads initialize every declared field", "supply the missing payload field"))
            return None
        }
    }
    if failed -> return None
    value :: sema_tir_node(Type.Named{name: enum_name}, TExprKind.EnumLit{enum_type: enum_name, variant: variant, payload: TEnumPayload.Named{fields: named_values}}, span)
    sema_expr_expected(value, expected, environment, program, &diagnostics)
}

// Rust `core_duration_unit_variants`: the closed unit list `duration.in(unit)`
// and the Duration constructors take.
fn sema_expression_compiler_unit_enum_variants(name: String) -> [String]? Never! {
    if name == "DurationUnit" -> return Val([String]{"Nanoseconds", "Microseconds", "Milliseconds", "Seconds", "Minutes", "Hours"})
    None
}

fn sema_expression_compiler_unit_enum_literal(enum_name: String, variants: [String], variant: String, args: [EnumLitArg], variant_span: Span?, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> TExpr? {
    if !variants.contains(variant) {
        &diagnostics.push(sema_enum_unknown_variant(enum_name, variant, variants, span, variant_span))
        return None
    }
    if args.len() != 0 {
        &diagnostics.push(sema_enum_unit_payload(enum_name, variant, span))
        return None
    }
    value :: sema_tir_node(Type.Named{name: enum_name}, TExprKind.EnumLit{enum_type: enum_name, variant: variant, payload: TEnumPayload.Unit}, span)
    sema_expr_expected(value, expected, environment, program, &diagnostics)
}

// Rust `check_enum_payload_assignable`: a payload value that doesn't fit its
// declared slot is E0108 about that slot (`field` names a labeled payload).
fn sema_expression_enum_payload_mismatch(enum_name: String, variant: String, field: String?, declared: Type, offered: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Diagnostic {
    required :: sema_expr_expected_type(declared, environment, program)
    actual :: sema_expr_expected_type(offered, environment, program)
    slot :: if field == .Val(label) -> "field `{label}` of `{enum_name}.{variant}`" else -> "the payload of `{enum_name}.{variant}`"
    sema_error("E0108", span, "{slot} holds {sema_type_show(required)}, but this value is {sema_type_show(actual)}", "a variant payload keeps the type its enum declaration gives it", sema_type_fix_hint(required, actual))
}

// The payload's own check rejected it against the declared slot with the
// generic E0108 at the value; that report becomes the payload-specific one,
// with the value's own type inferred without the slot as a target.
fn sema_expression_enum_payload_replace_mismatch(enum_name: String, variant: String, field: String?, declared: Type, value: Expr, diagnostic_start: Int, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) {
    value_span :: expr_span(value)
    mismatch_index :: sema_value_mismatch_index(diagnostics, diagnostic_start, value_span) ?? return
    probe_diagnostics := [Diagnostic]{}
    offered :: sema_probe_expression(value, None, environment, program, &scopes, &state, &tail_store, &context, &probe_diagnostics) ?? return
    diagnostics[mismatch_index] = sema_expression_enum_payload_mismatch(enum_name, variant, field, declared, offered.ty, value_span, environment, program)
}

struct SemaExpressionTypedTextParts {
    literals: [String]
    holes: [TExpr]
    trusted_html: [Bool]
}

fn sema_expression_typed_literal_printable_bound(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if program.registration_graph == .Val(graph) -> return sema_type_bound_satisfied_with_generics(graph, ty, "Printable", environment.module_identity, environment.generic_params) ?? false
    false
}

fn sema_expression_typed_literal_printable(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if ty == {
        .Int | .IntN(_, _) | .Float | .Float32 | .Bool | .String | .Char | .Quantity(_, _) -> return true
        .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) -> return sema_expression_typed_literal_printable(inner, environment, program)
        .Result(ok, err) -> return sema_expression_typed_literal_printable(ok, environment, program) && sema_expression_typed_literal_printable(err, environment, program)
        .Map(key, _, value) -> return sema_expression_typed_literal_printable(key, environment, program) && sema_expression_typed_literal_printable(value, environment, program)
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_expression_typed_literal_printable(field.ty, environment, program) -> return false
            }
            return true
        }
        .Union(members) -> {
            loop member in members {
                if !sema_expression_typed_literal_printable(member, environment, program) -> return false
            }
            return true
        }
        .Shared(_) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Measure(_) -> return false
        .Named(name) -> {
            if name == "Unit" -> return true
            if program.registration_graph == .Val(graph) && sema_registration_unit_fact_for_type(graph, ty) != None -> return true
            loop row in sema_scope_checked_type_name_rows(environment, program, name) {
                if program.checked_types[row].single_use -> return false
                if program.checked_types[row].auto_printable -> return true
            }
            return sema_expression_typed_literal_printable_bound(ty, environment, program)
        }
        .Apply(name, args) -> {
            if name == "KeyRef" -> return true
            if name == "View" && args.len() == 1 && args[0] == (Type.Named{name: "str"}) -> return true
            loop argument in args {
                if !sema_expression_typed_literal_printable(argument, environment, program) -> return false
            }
            return sema_expression_typed_literal_printable_bound(ty, environment, program)
        }
    }
    false
}
struct SemaExpressionCheckedTextTarget {
    owner: Symbol
    implementation_module_identity: String
    check: SemaRegistrationFunction
    encode_hole: SemaRegistrationFunction
}

struct SemaExpressionCheckedTextLiteral {
    handled: Bool
    value: TExpr?
}

fn sema_expression_checked_text_target(head: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> SemaExpressionCheckedTextTarget? {
    name :: if head == {.Named(value) -> value else -> { return None }}
    owner :: sema_expression_type_symbol(&scopes, environment, program, name) ?? return None
    if owner.kind != SymbolKind.Type -> return None
    if program.registration_graph == .Val(graph) {
    registered_row :: sema_type_graph_nominal_row(graph, owner.id.key) ?? return None
    registered :: graph.modules[registered_row.module_index].nominals[registered_row.row]
    if registered.kind != SemaRegistrationNominalKind.Distinct -> return None
    definition :: sema_registration_nominal_source_item(registered.source) ?? return None
    if definition == {
        .Distinct(value) -> {
            if value.base != Type.String -> return None
        }
        else -> return None
    }
    loop graph_module_index in 0..<graph.modules.len() {
        loop implementation_index in 0..<graph.modules[graph_module_index].impls.len() {
            if !sema_type_graph_is_checked_text_impl(graph, graph.modules[graph_module_index].impls[implementation_index]) -> next
            if graph.modules[graph_module_index].impls[implementation_index].target_identity_key != registered.identity_key && (graph.modules[graph_module_index].impls[implementation_index].target_module_identity != Val(registered.symbol.module_name) || graph.modules[graph_module_index].impls[implementation_index].target_type_name != registered.symbol.name) -> next
            check := SemaRegistrationFunction?{None}
            encode_hole := SemaRegistrationFunction?{None}
            loop method_index in 0..<graph.modules[graph_module_index].impls[implementation_index].methods.len() {
                if graph.modules[graph_module_index].impls[implementation_index].methods[method_index].symbol.name == "check" -> check = Val(graph.modules[graph_module_index].impls[implementation_index].methods[method_index])
                if graph.modules[graph_module_index].impls[implementation_index].methods[method_index].symbol.name == "encode_hole" -> encode_hole = Val(graph.modules[graph_module_index].impls[implementation_index].methods[method_index])
            }
            if check != None && encode_hole != None {
                return Val(SemaExpressionCheckedTextTarget{
                    owner: registered.symbol,
                    implementation_module_identity: graph.modules[graph_module_index].module_identity,
                    check: check ?? return None,
                    encode_hole: encode_hole ?? return None,
                })
            }
        }
    }
    }
    None
}

fn sema_expression_checked_text_static_method_call(receiver: Expr, method_name: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    type_name :: if receiver == {.Ident(name, _, _) -> name else -> { return SemaMethodSpecialCheck{handled: false, value: None} }}
    target :: sema_expression_checked_text_target(Type.Named{name: type_name}, environment, program, &scopes) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if method_name == "raw" -> return sema_expression_checked_text_raw(target, type_name, method_span, args, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    function :: if method_name == "check" || method_name == "from" -> target.check else -> if method_name == "encode_hole" -> target.encode_hole else -> { return SemaMethodSpecialCheck{handled: false, value: None} }
    if owner_type_args.len() > 0 {
        &diagnostics.push(sema_error("E0119", method_span, "`{type_name}.{method_name}` has no owner type parameters", "CheckedText implementations target one concrete string-backed distinct type", "remove the explicit owner type arguments"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !function.declaration.is_pure {
        &diagnostics.push(sema_error("E0907", method_span, "`{type_name}.{method_name}` must be pure", "CheckedText methods are evaluated through the canonical pure Source evaluator", "declare this CheckedText method pure"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if program.registration_graph == None -> return SemaMethodSpecialCheck{handled: true, value: None}
    direct :: sema_call_direct_target_from_registration(function, program.registration_graph, environment.module_identity, environment.package_identity, environment.generic_params, type_args, method_span, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    call := Call{
        name: "{type_name}.{method_name}",
        name_span: method_span,
        type_args: type_args,
        args: args,
    }
    checked :: sema_call_check_direct_target_owned(&state, direct, call, [SemaCallDefaultValue]{}, if method_name == "from" -> None else -> expected, environment, program, &scopes, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if method_name == "encode_hole" && checked.value.ty != Type.String {
        &diagnostics.push(sema_error("E0112", method_span, "a checked text hole encoder must return String", "every interpolation is passed through the type's pure `encode_hole` method before it reaches the checker", "make `encode_hole` return a String"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    check_returns_unit_result :: if checked.value.ty == {
        .Result(ok, _) -> ok == Type.Named{name: "Unit"}
        else -> false
    }
    if (method_name == "check" || method_name == "from") && !check_returns_unit_result {
        &diagnostics.push(sema_error("E0907", method_span, "`{type_name}.check` must return `Result<Unit, Error>`", "the canonical CheckedText contract reports rejection through its error result", "match the pure CheckedText.check signature"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    &context.call_return_views.push(SemaCallReturnView{span: method_span, facts: checked.return_view_facts})
    if !sema_expr_record_call_fact(environment, program, &scopes, &context, method_span, checked, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    if method_name == "from" {
        value :: sema_expression_checked_text_from(target, type_name, checked.value, method_span) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
    }
    SemaMethodSpecialCheck{handled: true, value: Val(checked.value)}
}

// Preserve the ordinary checker error while moving the original text into the
// nominal wrapper on success. The argument and the checker each execute once.
fn sema_expression_checked_text_from(target: SemaExpressionCheckedTextTarget, type_name: String, checked: TExpr, span: Span) -> TExpr? {
    error_type :: if checked.ty == {.Result(_, error) -> error else -> { return None }}
    source_local :: tir_generated_local("__checked_text_source_{span.start}", span)
    error_local :: tir_generated_local("__checked_text_error_{span.start}", span)
    source_value :: sema_tir_node(Type.String, TExprKind.Local{local: source_local}, span)
    original := TExpr?{None}
    checker_call := TExpr?{None}
    if checked.kind == .Call(callee, type_args, args) {
        if args.len() == 1 {
            original = Val(args[0].value)
            checker_args := args
            checker_args[0].value = source_value
            checker_call = Val(sema_tir_node(checked.ty, TExprKind.Call{callee: callee, type_args: type_args, args: checker_args}, span))
        }
    }
    source_init :: original ?? return None
    checker :: checker_call ?? return None
    nominal :: Type.Named{name: type_name}
    result_type :: Type.Result{ok: nominal, err: error_type}
    wrapped :: sema_tir_node(nominal, TExprKind.DistinctCtor{argument: sema_tir_node(Type.String, TExprKind.Move{value: source_value}, span)}, span)
    ok_pattern :: TPattern{
        shape: TPatternShape.Ok{binding: "_", binding_span: span, inner: None, span: span},
        bindings: [TPatternBindingFact]{},
        enum_type: None,
        position: TPatternPosition.Arm,
        mutable: false,
        boxed: false,
    }
    err_pattern :: TPattern{
        shape: TPatternShape.Err{binding: error_local.name, binding_span: span, inner: None, span: span},
        bindings: [TPatternBindingFact]{TPatternBindingFact{name: error_local.name, span: span, ty: error_type, mutable: false, symbol_id: None}},
        enum_type: None,
        position: TPatternPosition.Arm,
        mutable: false,
        boxed: false,
    }
    error_value :: sema_tir_node(error_type, TExprKind.Local{local: error_local}, span)
    handler :: sema_tir_node(result_type, TExprKind.ResultHandler{
        subject: checker,
        ok_pattern: ok_pattern,
        ok_body: [TStmt]{},
        ok_value: sema_tir_node(result_type, TExprKind.Ok{value: wrapped}, span),
        err_pattern: err_pattern,
        err_body: [TStmt]{},
        err_value: sema_tir_node(result_type, TExprKind.Err{value: error_value}, span),
        terminal: sema_tir_node(result_type, TExprKind.Never{reason: "CheckedText.check has exactly Ok and Err outcomes"}, span),
    }, span)
    Val(sema_tir_node(result_type, TExprKind.InlineBlock{body: [TStmt]{
        TStmt.Let{local: source_local, let_ty: TLetTy.Annotated{ty: Type.String, wrapper: TLetWrapper.Plain}, init: source_init, gc_promotion: None, gc_transferred: false, span: span},
        TStmt.ExprStmt{value: handler, span: span},
    }}, span))
}

// `Type.raw(text)` is the expert escape that wraps one
// audited String without running the declared checker, so it needs an
// audited `#Unsafe` region (E0387).
fn sema_expression_checked_text_raw(target: SemaExpressionCheckedTextTarget, type_name: String, method_span: Span, args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    callee :: "{type_name}.raw"
    if args.len() != 1 {
        &diagnostics.push(sema_error("E0103", method_span, "`{callee}` takes exactly one String", "a checked text boundary receives one complete text value", "write `{callee}(text)`"))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    if context.unsafe_depth == 0 {
        &diagnostics.push(sema_error("E0387", method_span, "Checked text raw construction requires an audited `#Unsafe` region", "`Type.raw(text)` bypasses the declared CheckedText checker and is an expert-only escape", "Wrap the call in `#Unsafe(\"reason\") {{ … }}`, or use `Type.from(text)` for validation"))
    }
    if args.len() != 1 -> return SemaMethodSpecialCheck{handled: true, value: None}
    argument :: sema_check_expression(args[0].expr, Val(Type.String), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if argument.ty != Type.String {
        &diagnostics.push(sema_type_mismatch(Type.String, argument.ty, expr_span(args[0].expr)))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    params :: [SemaCallParam]{SemaCallParam{label: "arg0", name: "arg0", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.String), variadic: false}}
    ownership_args := args
    ownership := sema_ownership_check_call_arguments(&state, callee, params, &ownership_args, scopes, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    constructed :: sema_tir_node(Type.Named{name: type_name}, TExprKind.DistinctCtor{argument: argument}, method_span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(constructed, expected, environment, program, &diagnostics)}
}

fn sema_expression_checked_text_literal(head: Type, source_head: Type?, body: TypedLitBody, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaExpressionCheckedTextLiteral {
    target :: sema_expression_checked_text_target(head, environment, program, &scopes) ?? return SemaExpressionCheckedTextLiteral{handled: false, value: None}
    type_name := if head == {.Named(name) -> name else -> panic("checked text target lost its named owner")}
    body_value :: if body == {
        // copy: `value` is a payload of read parameter `body`, which keeps the original; the assigned `body_value` owns this one
        .Value(value) -> value.copy()
        else -> {
            &diagnostics.push(sema_error("E0112", span, "`{type_name}{{ … }}` needs a string recipe body", "a checked text type is constructed from a quoted template, not another expression shape", "write `{type_name}{{\"…\"}}` with interpolation holes as needed"))
            return SemaExpressionCheckedTextLiteral{handled: true, value: None}
        }
    }
    parts :: if body_value == {
        .Str(rows, _, _) -> rows
        else -> {
            &diagnostics.push(sema_error("E0112", expr_span(body_value), "`{type_name}{{ … }}` needs a string recipe body", "a checked text type is constructed from a quoted template, not another expression shape", "write `{type_name}{{\"…\"}}` with interpolation holes as needed"))
            return SemaExpressionCheckedTextLiteral{handled: true, value: None}
        }
    }
    encoded_parts := [StrPart]{}
    loop part in parts {
        if part == {
            .Lit(_) -> &encoded_parts.push(part)
            .Byte(value) -> &encoded_parts.push(StrPart.Lit{text: sema_expr_byte_text(value)})
            .Interp(value, _) -> {
                argument := CallArg{convention: AccessConvention.Read, expr: value, span: expr_span(value), flags: ast_empty_call_arg_flags(), label: None, spread: false}
                encoder := Expr.MethodCall{
                    receiver: Expr.Ident{name: type_name, span: expr_span(value), id: AST_NODE_GENERATED},
                    method: "encode_hole",
                    method_span: expr_span(value),
                    owner_type_args: [Type]{},
                    type_args: [Type]{},
                    args: [CallArg]{argument},
                    id: AST_NODE_GENERATED,
                }
                &encoded_parts.push(StrPart.Interp{expr: encoder, format: StrFormat.Display})
            }
        }
    }
    encoded_body := Expr.Str{parts: encoded_parts, span: expr_span(body_value), id: AST_NODE_GENERATED}
    check_argument := CallArg{convention: AccessConvention.Read, expr: encoded_body, span: expr_span(body_value), flags: ast_empty_call_arg_flags(), label: None, spread: false}
    check_call := Expr.MethodCall{
        receiver: Expr.Ident{name: type_name, span: span, id: AST_NODE_GENERATED},
        method: "check",
        method_span: span,
        owner_type_args: [Type]{},
        type_args: [Type]{},
        args: [CallArg]{check_argument},
        id: AST_NODE_GENERATED,
    }
    fact_start := context.call_facts.len()
    reference_start := context.name_references.len()
    register_access_start := context.hardware_use.register_accesses.len()
    interrupt_handler_start := context.hardware_use.interrupt_handlers.len()
    dma_operation_start := context.hardware_use.dma_operations.len()
    unresolved_hardware_start := context.hardware_use.unresolved_references.len()
    checked :: sema_check_expression(check_call, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaExpressionCheckedTextLiteral{handled: true, value: None}
    text :: if checked.kind == {
        .Call(_, _, args) -> if {
            args.len() == 1 -> args[0].value
            else -> {
                &diagnostics.push(sema_error("E0003", span, "the checked text checker call lost its complete body argument", "the staged checker evaluates the ordinary pure `CheckedText.check` method on the exact encoded body", "preserve the canonical static method call in checked TIR"))
                return SemaExpressionCheckedTextLiteral{handled: true, value: None}
            }
        }
        else -> {
            &diagnostics.push(sema_error("E0003", span, "the checked text checker call did not lower as a direct static call", "CheckedText methods are ordinary registered pure functions", "preserve the canonical registered call target"))
            return SemaExpressionCheckedTextLiteral{handled: true, value: None}
        }
    }
    if program.registration_graph == .Val(graph) {
    functions := sema_comptime_reachable_function_keys(graph, context.call_facts)
    reachable := [String]{}
    loop key in functions {
        fact_index := fact_start
        loop fact_index < context.call_facts.len() {
            callee :: context.call_facts[fact_index].callee
            if callee == .Val(symbol) && symbol.key == key {
                &reachable.push(key)
                break
            }
            fact_index += 1
        }
    }
    loop method_key in ([String]{target.check.symbol.id.key, target.encode_hole.symbol.id.key}) {
        if !reachable.contains(method_key) -> &reachable.push(method_key)
    }
    dependencies := [String]{}
    loop reference_index in reference_start..<context.name_references.len() {
        reference := context.name_references[reference_index]
        if reference.symbol.kind != SymbolKind.Constant -> next
        if !dependencies.contains(reference.symbol.id.key) -> &dependencies.push(reference.symbol.id.key)
    }
    source_file := sema_source_file_at(environment.source_segments, environment.source_file, environment.source_origin, span)
    key := "{environment.module_identity}::checked-text::{target.owner.id.key}::{span.start}:{span.end}:{type_identity_key(head)}"
    evaluation := SemaCheckedTextEvaluation{
        module_identity: environment.module_identity,
        key: key,
        type_name: type_name,
        source_file: source_file,
        source_expression: Expr.TypedLit{head: source_head, body: body, span: span, id: AST_NODE_GENERATED},
        expression: checked,
        hardware_use: TargetHardwareUse{
            register_accesses: loop index in register_access_start..<context.hardware_use.register_accesses.len() -> context.hardware_use.register_accesses[index],
            interrupt_handlers: loop index in interrupt_handler_start..<context.hardware_use.interrupt_handlers.len() -> context.hardware_use.interrupt_handlers[index],
            dma_operations: loop index in dma_operation_start..<context.hardware_use.dma_operations.len() -> context.hardware_use.dma_operations[index],
            unresolved_references: loop index in unresolved_hardware_start..<context.hardware_use.unresolved_references.len() -> context.hardware_use.unresolved_references[index],
        },
        reachable_function_keys: reachable,
        dependencies: dependencies,
        span: span,
    }
    &context.comptime_requests.push(SemaComptimeRequest{
        callee_key: target.check.symbol.id.key,
        module_identity: target.implementation_module_identity,
        args: [TComptimeValue]{},
        span: span,
        checked_text: Val(evaluation),
    })
    value :: text
    result := sema_tir_node(head, TExprKind.DistinctCtor{argument: value}, span)
    return SemaExpressionCheckedTextLiteral{handled: true, value: sema_expr_expected(result, expected, environment, program, &diagnostics)}
    }
    SemaExpressionCheckedTextLiteral{handled: true, value: None}
}

// The bytes a `[U8]{"…"}` body spells. ASCII text contributes
// one byte per character and `\xNN` the written byte; non-ASCII text is E0119.
fn sema_expression_typed_literal_byte_text(parts: [ByteTextPart], head: Type, span: Span, diagnostics: &[Diagnostic]) -> [U8]? {
    bytes := [U8]{}
    loop part in parts {
        if part == {
            .Lit(text) -> {
                loop byte in text.bytes() {
                    if Int.from_u8(byte) >= 128 {
                        &diagnostics.push(sema_error("E0119", span, "this body doesn't match typed-literal head `{type_name(head)}`", "byte-list text is ASCII so every character has one unambiguous byte value", "use ASCII text or numeric elements for a byte list"))
                        return None
                    }
                    &bytes.push(byte)
                }
            }
            .Byte(byte) -> &bytes.push(byte)
        }
    }
    Val(bytes)
}

// A `[U8]` byte-text value checks as one byte constant (Rust tir_to_mir_expr
// `constant_byte_list`), never one list element per byte: the generated
// Unicode assets spell up to 1.49 MB this way, and per-byte Int expressions
// cost every phase from sema to comptime a node per byte.
fn sema_expression_typed_literal_is_byte_list(head: Type) -> Bool Never! {
    if head == .List(element) -> return element == Type.IntN{signed: false, bits: 8}
    false
}

fn sema_expression_typed_literal_text_parts(parts: [StrPart], kind: TypedHeadKind, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaExpressionTypedTextParts? {
    literals := [String]{""}
    holes := [TExpr]{}
    trusted_html := [Bool]{}
    loop part in parts {
        if part == {
            .Lit(text) -> {
                last := literals.len() - 1
                literals[last] = "{literals[last]}{text}"
            }
            .Byte(value) -> {
                last := literals.len() - 1
                literals[last] = "{literals[last]}{sema_expr_byte_text(value)}"
            }
            .Interp(value, _) -> {
                if kind == TypedHeadKind.DateTime {
                    &diagnostics.push(sema_error("E0155", expr_span(value), "a `DateTime` literal cannot contain interpolation", "DateTime values are checked as complete RFC3339 literals before the program runs", "write a complete `DateTime{{\"…\"}}` literal, or parse a runtime String explicitly"))
                    return None
                }
                old_borrow := context.borrow_ctx
                old_string_view := context.allow_string_view_read
                context.borrow_ctx = true
                context.allow_string_view_read = true
                checked := sema_check_expression(value, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                context.borrow_ctx = old_borrow
                context.allow_string_view_read = old_string_view
                hole :: checked ?? return None
                trusted := kind == TypedHeadKind.HTML && hole.ty == Type.Named{name: "HTML"}
                if !trusted && !sema_expression_typed_literal_printable(hole.ty, environment, program) {
                    &diagnostics.push(sema_error("E0112", expr_span(value), "`{type_name(hole.ty)}` can't be used in a typed literal hole", "typed literal holes use the shared JetShow rendering contract", "use a printable value, or convert it to String before the hole"))
                    return None
                }
                &holes.push(hole)
                &trusted_html.push(trusted)
                &literals.push("")
            }
        }
    }
    Val(SemaExpressionTypedTextParts{literals: literals, holes: holes, trusted_html: trusted_html})
}

fn sema_expression_validate_boundary_literal(kind: TypedHeadKind, parts: [StrPart], span: Span, diagnostics: &[Diagnostic]) -> Bool {
    name := if kind == {
        .URL -> "URL"
        .Path -> "Path"
        .DateTime -> "DateTime"
        else -> { return true }
    }
    literals := [String]{""}
    loop part in parts {
        if part == {
            .Lit(text) -> {
                last := literals.len() - 1
                literals[last] = "{literals[last]}{text}"
            }
            .Byte(byte) -> {
                last := literals.len() - 1
                literals[last] = "{literals[last]}{sema_expr_byte_text(byte)}"
            }
            .Interp(_, _) -> {
                if kind == TypedHeadKind.DateTime {
                    &diagnostics.push(sema_error("E0155", span, "a `DateTime` literal cannot contain interpolation", "DateTime values are checked as complete RFC3339 literals before the program runs", "write a complete `DateTime{{\"…\"}}` literal, or parse a runtime String explicitly"))
                    return false
                }
                &literals.push("")
            }
        }
    }
    if sema_expression_boundary_literal_reason(kind, literals) == .Val(reason) {
        &diagnostics.push(sema_error("E0155", span, "this `{name}` literal is invalid", reason, "fix the literal, or parse a runtime String with the ordinary `{name}` constructor"))
        return false
    }
    true
}

// Why the literal text of a typed boundary head is invalid, or None when it
// is valid. URL and DateTime use the same Core parsers that build the value
// at runtime, so a literal accepted here never fails there.
fn sema_expression_boundary_literal_reason(kind: TypedHeadKind, literals: [String]) -> String? {
    if kind == {
        .URL -> sema_expression_url_literal_reason(literals)
        .Path -> {
            loop text in literals {
                loop byte in text.bytes() {
                    if byte == (U8{0}) -> return Val("a Path cannot contain a NUL character")
                }
            }
            None
        }
        .DateTime -> {
            _ :: boundary_time.parse_rfc3339(literals.join("")) ?? return Val(err.reason)
            None
        }
        else -> Val("typed head is not a checked boundary head")
    }
}

// The URL skeleton joins the literal pieces with a marker that occurs in none
// of them (as `core.net.url.literal` does), so scheme and port holes are
// found structurally and the rest parses with the Core URL grammar.
fn sema_expression_url_literal_reason(literals: [String]) -> String? {
    if literals.len() == 0 -> return Val("URL literal needs a quoted body")
    nonce := 0
    marker := "jet-hole-opaque-0-"
    loop sema_expression_any_contains(literals, marker) {
        nonce += 1
        marker = "jet-hole-opaque-{nonce}-"
    }
    skeleton :: boundary_unicode.trim(literals.join(marker))
    colon :: skeleton.find(":")
    if colon < 0 -> return sema_expression_url_skeleton_reason(skeleton)
    length :: skeleton.bytes().len()
    scheme :: sema_expression_bytes_text(skeleton, 0, colon)
    if scheme.contains(marker) -> return Val("URL scheme cannot contain interpolation")
    rest :: sema_expression_bytes_text(skeleton, colon + 1, length)
    if scheme.lower() == "data" {
        data_body := rest
        data_stops :: [String]{"?", "#"}
        loop stop in data_stops {
            end :: data_body.find(stop)
            if end >= 0 -> data_body = sema_expression_bytes_text(data_body, 0, end)
        }
        comma :: data_body.find(",")
        if comma >= 0 && sema_expression_bytes_text(data_body, 0, comma).contains(marker) -> return Val("data URL MIME metadata cannot contain interpolation")
        if comma < 0 && data_body.contains(marker) -> return Val("data URL payload needs a MIME separator")
    }
    if rest.starts_with("//") {
        authority := sema_expression_bytes_text(rest, 2, rest.bytes().len())
        authority_stops :: [String]{"/", "?", "#"}
        loop stop in authority_stops {
            end :: authority.find(stop)
            if end >= 0 -> authority = sema_expression_bytes_text(authority, 0, end)
        }
        at :: authority.rfind("@")
        host_port :: if at >= 0 -> sema_expression_bytes_text(authority, at + 1, authority.bytes().len()) else -> authority
        host_end :: host_port.bytes().len()
        bracket :: host_port.find("]")
        port := ""
        if bracket >= 0 {
            suffix :: sema_expression_bytes_text(host_port, bracket + 1, host_end)
            if suffix.starts_with(":") -> port = suffix
        } else {
            port_colon :: host_port.rfind(":")
            if port_colon >= 0 -> port = sema_expression_bytes_text(host_port, port_colon + 1, host_end)
        }
        if port.contains(marker) -> return Val("URL port cannot contain interpolation")
    }
    sema_expression_url_skeleton_reason(skeleton)
}

fn sema_expression_any_contains(texts: [String], needle: String) -> Bool {
    loop text in texts {
        if text.contains(needle) -> return true
    }
    false
}

// The bytes of `text` in `start..<end`.
fn sema_expression_bytes_text(text: String, start: Int, end: Int) -> String {
    String.from_bytes_lossy(text.bytes()[start..<end])
}

fn sema_expression_url_skeleton_reason(skeleton: String) -> String? {
    _ :: boundary_url.parse_recipe(skeleton, false) ?? return Val("the text is not a valid URL ({err})")
    None
}

fn sema_expression_typed_literal_text(kind: TypedHeadKind, head: Type, value: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    parts := if value == {
        .Str(rows, _, _) -> rows
        else -> {
            &diagnostics.push(sema_error("E0112", span, "`{type_name(head)}.{{ … }}` needs a string recipe body", "checked typed heads are built from a quoted template, not from another expression shape", "write `{type_name(head)}.{{\"...\"}}` with `{{value}}` holes as needed"))
            return None
        }
    }
    if !sema_expression_validate_boundary_literal(kind, parts, expr_span(value), &diagnostics) -> return None
    if kind == TypedHeadKind.DateTime {
        argument :: CallArg{convention: AccessConvention.Read, expr: value, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false}
        constructor :: Expr.MethodCall{
            receiver: Expr.Ident{name: "DateTime", span: span, id: AST_NODE_GENERATED},
            method: "__literal",
            method_span: span,
            owner_type_args: [Type]{},
            type_args: [Type]{},
            args: [CallArg]{argument},
            id: AST_NODE_GENERATED,
        }
        return sema_check_expression(constructor, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    checked :: sema_expression_typed_literal_text_parts(parts, kind, span, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if kind == TypedHeadKind.URL {
        literal_exprs := [Expr]{}
        hole_exprs := [Expr]{}
        loop text in checked.literals -> &literal_exprs.push(Expr.Str{parts: [StrPart]{StrPart.Lit{text: text}}, span: span, id: AST_NODE_GENERATED})
        loop part in parts {
            if part == .Interp(hole, _) -> &hole_exprs.push(Expr.Str{parts: [StrPart]{StrPart.Interp{expr: hole, format: StrFormat.Display}}, span: expr_span(hole), id: AST_NODE_GENERATED})
        }
        args := [CallArg]{}
        loop elements in ([ [Expr] ]{literal_exprs, hole_exprs}) {
            &args.push(CallArg{convention: AccessConvention.Read, expr: Expr.ListLit{elements: elements, span: span, id: AST_NODE_GENERATED}, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false})
        }
        // `core.net.url.literal` is declared `-> URL Never!`; the head yields its
        // success value exactly as the automatic `Never!` propagation of a call.
        url := sema_call_core_check_fixed(environment, program, "core.net.url", "literal", [Type]{}, args, span, None, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        if sema_expr_unwrap_tag(url.ty) == .Result(_, error) && sema_expr_unwrap_tag(error) == (Type.Named{name: "Never"}) {
            url = sema_expression_propagated(url, TTryConvert.Never, span) ?? return None
        }
        return sema_expr_expected(url, expected, environment, program, &diagnostics)
    }
    result := sema_tir_node(head, TExprKind.HostCall{call: THostCall.TypedTextInterp{kind: kind, literals: checked.literals, holes: checked.holes, trusted_html: checked.trusted_html}}, span)
    if kind == TypedHeadKind.HTML && checked.holes.len() == 0 {
        result = sema_tir_node(head, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: checked.literals[0]}}}, span)
    }
    sema_expr_expected(result, expected, environment, program, &diagnostics)
}

fn sema_expression_typed_literal_regex(value: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    parts := if value == {
        .Str(rows, _, _) -> rows
        else -> {
            &diagnostics.push(sema_error("E0152", span, "`Regex{{…}}` needs one quoted pattern", "a regex typed literal contains pattern text, not another expression shape", "write `Regex{{\"...\"}}`"))
            return None
        }
    }
    pattern := ""
    loop part in parts {
        if part == {
            .Lit(text) -> pattern = "{pattern}{text}"
            .Byte(byte) -> pattern = "{pattern}{sema_expr_byte_text(byte)}"
            .Interp(expr, _) -> {
                &diagnostics.push(sema_error("E0152", expr_span(expr), "a `Regex` literal cannot contain interpolation", "the compiler must know the complete pattern before the program runs", "use a fixed `Regex{{\"...\"}}` pattern, or build text and call `re.compile(text)`"))
                return None
            }
        }
    }
    // The literal is checked by the same Core parser that compiles it at run
    // time, so the two can never disagree about what a pattern means.
    _ :: boundary_regex.compile(pattern) ?? {
        &diagnostics.push(sema_error("E0152", expr_span(value), "this regex pattern is invalid at position {err.offset}", err.reason, "fix the pattern at that position; a `\\` before ASCII punctuation matches it literally"))
        return None
    }
    route :: sema_call_core_resolve_route(environment, program, "core.regex", "compile", [Type]{}, 1, false, span, &diagnostics) ?? return None
    if route == {
        .Source(target) -> {
            argument :: CallArg{convention: AccessConvention.Read, expr: Expr.Str{parts: [StrPart]{StrPart.Lit{text: pattern}}, span: expr_span(value), id: AST_NODE_GENERATED}, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false}
            compiled :: sema_call_core_check_source_owned(target, "core.regex.compile", [Type]{}, [CallArg]{argument}, span, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
            result_type :: if compiled.ty == {.Result(ok, _) -> ok else -> panic("source Regex compile producer is not fallible")}
            message :: sema_tir_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: "compiler-checked regex failed to compile"}}}, span)
            fallback :: TOrFallback.Panic{message: message, location: sema_expression_panic_location(environment, program, scopes, span)}
            checked :: sema_tir_node(result_type, TExprKind.OrFallback{value: compiled, fallback: fallback, ambient_err: None}, span)
            return sema_expr_expected_owned(^checked, expected, environment, program, &diagnostics)
        }
        else -> {
            &diagnostics.push(sema_error("E0906", span, "the source Regex literal producer is unavailable", "checked patterns and dynamic patterns use the same source-owned engine", "load the core.regex source module"))
            return None
        }
    }
}

// Whether `ty` names the Regex type: the written prelude head `Regex`, or the
// canonical `core.regex` record an expected slot resolves to.
fn sema_expression_is_regex_head(ty: Type) -> Bool Never! {
    if sema_expr_unwrap_tag(ty) == .Named(name) -> return name == "Regex" || core_identity_is(name, "core.regex", "Regex")
    false
}

fn sema_expression_typed_literal_mismatch(head: Type, span: Span, diagnostics: &[Diagnostic]) -> TExpr? {
    &diagnostics.push(sema_error("E0119", span, "this body doesn't match typed-literal head `{type_name(head)}`", "a typed literal body uses the head type's own literal shape", "use elements for lists, entries for maps, fields for records, or one expression for scalars"))
    None
}

// #3739 (amends): a list head's lone expression is the whole
// value when it checks as a value of the head the way a parameter of that
// type accepts it; otherwise it is the literal's single element. The probe
// runs on snapshots, so the caller re-checks the chosen reading and every
// diagnostic is reported once. Spreads and inferred-head bodies (`{…}`,
// `.{…}`) always use element notation.
fn sema_expression_typed_literal_whole_value(head: Type, value: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> Bool {
    if value == {
        .Spread(_, _, _) -> return false
        else -> {}
    }
    if sema_expression_list_element_needs_expected_type(value) || sema_expression_never_whole_list(value) -> return false
    probe_diagnostics := [Diagnostic]{}
    // The probe reads the enclosing statement tails (its liveness frames in
    // `context` index this store), so it shares the store, never a fresh one.
    checked :: sema_probe_expression(value, Val(head), environment, program, &scopes, &state, &tail_store, &context, &probe_diagnostics) ?? return false
    if probe_diagnostics.len() != 0 -> return false
    _ := sema_expr_expected(checked, Val(head), environment, program, &probe_diagnostics) ?? return false
    probe_diagnostics.len() == 0
}

// A lone element whose value can never be a list: a number, Bool or Char
// literal, or a named record or variant literal whose every field is written
// `name: value` (a shorthand body may be an alias head's elements). Its
// whole-value probe always fails, so the element reading is taken without it.
fn sema_expression_never_whole_list(value: Expr) -> Bool Never! {
    if value == {
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Char(_, _, _) -> true
        .StructLit(type_name, _, _, as_trait, fields, inferred, _, _) -> {
            if type_name == "" || inferred || as_trait != None || fields.len() == 0 -> return false
            loop field in fields {
                if sema_expression_field_is_shorthand(field) -> return false
            }
            true
        }
        else -> false
    }
}

fn sema_expression_typed_literal_whole(head: Type, value: Expr, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    checked :: sema_check_expression(value, Val(head), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    typed :: sema_expr_expected(checked, Val(head), environment, program, &diagnostics) ?? return None
    sema_expr_expected(typed, expected, environment, program, &diagnostics)
}

struct SemaExpressionVariantHead {
    enum_name: String
    variant: String
}

// `Enum.Variant{field: value}` constructs a
// named-payload variant. The parser reads the dotted head as a type path;
// resolve it here against the enum declaration so the payload is checked by
// the enum constructor, never by the struct-literal path.
fn sema_expression_variant_head(head: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> SemaExpressionVariantHead? {
    // Both named and applied heads retain the same dotted variant path.
    path :: if sema_expr_unwrap_tag(head) == {
        .Named(name) | .Apply(name, _) -> name
        else -> ""
    }
    parts :: path.split(".").to_list()
    if parts.len() != 2 -> return None
    head_value :: SemaExpressionVariantHead{enum_name: parts[0], variant: parts[1]}
    owner :: sema_expression_type_symbol(&scopes, environment, program, parts[0])
    if owner == .Val(symbol) {
        if sema_scope_declaration_enum_declares(environment, program, symbol.id, parts[1]) -> return Val(head_value)
        if sema_expression_core_export_variants(environment, program, symbol) == None -> return None
    }
    // A compiler-owned Core enum (`EmailError`) has no declaration; its
    // named-payload case comes from the generated Core enum payload rows.
    if core_enum_variant_labels(parts[0], parts[1]) != None -> Val(head_value) else -> None
}

// A record field written as the bare shorthand `{name}`: the parser gives its
// value the field name's own identifier and span.
fn sema_expression_field_is_shorthand(field: ExprField) -> Bool Never! {
    if field.value == .Ident(name, value_span, _) -> return name == field.name && value_span.start == field.name_span.start && value_span.end == field.name_span.end
    false
}

// E0128: a distinct head never re-types its base value;
// the destination owns the explicit conversion. Returns true when reported.
fn sema_expression_typed_literal_distinct_mismatch(head: Type, value: TExpr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if value.ty == head -> return false
    facts :: sema_expr_distinct_facts(head, environment, program, &scopes) ?? return false
    offered :: type_name(value.ty)
    method :: if value.ty == {
        .Int -> "from_int"
        .Float -> "from_float"
        .String -> "from_string"
        .Bool -> "from_bool"
        .Char -> "from_char"
        else -> "from_{offered}"
    }
    // The source spelling of the destination, never its resolved symbol identity.
    shown :: sema_type_nominal_leaf(Type.Named{name: facts.name})
    &diagnostics.push(sema_error("E0128", value.span, "a `{offered}` can't be used where a `{shown}` is expected", "`{shown}` and `{offered}` are different types — even though `{shown}` is built on `{type_name(facts.base)}`, one is never accepted in place of the other", "convert explicitly: `{shown}.{method}(expr)`"))
    true
}

fn sema_expression_typed_literal(head: Type?, body: TypedLitBody, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if head == .Val(written) {
        if sema_expression_variant_head(written, environment, program, &scopes) == .Val(variant_head) {
            owner_args :: if sema_expr_unwrap_tag(written) == { .Apply(_, rows) -> rows else -> [Type]{} }
            if body == {
                .Fields(fields) -> {
                    args :: loop field in fields -> EnumLitArg.Named{label: field.name, expr: field.value}
                    return sema_expression_enum_literal(variant_head.enum_name, owner_args, variant_head.variant, args, false, None, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                }
                .Empty -> return sema_expression_enum_literal(variant_head.enum_name, owner_args, variant_head.variant, [EnumLitArg]{}, false, None, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                else -> {}
            }
        }
    }
    written_head :: head ?? (expected ?? {
        &diagnostics.push(sema_error("E0119", span, "this inferred typed literal needs a known type", "an inferred typed literal needs an expected type from the surrounding context", "add a type head, or annotate the binding with the intended type"))
        return None
    })
    source_kind := typed_head_kind_of(written_head)
    result_head := sema_expr_expected_type(sema_expr_unwrap_tag(written_head), environment, program)
    kind := source_kind
    if kind == None -> kind = typed_head_kind_of(result_head)
    checked_text := sema_expression_checked_text_literal(result_head, head, body, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    if checked_text.handled -> return checked_text.value

    if result_head == {
        .List(_) | .FixedList(_, _) -> if body == {
            .ByteText(parts) -> {
                bytes :: sema_expression_typed_literal_byte_text(parts, result_head, span, &diagnostics) ?? return None
                if sema_expression_typed_literal_is_byte_list(result_head) {
                    constant :: sema_tir_node(result_head, TExprKind.CtLit{value: TComptimeValue.Bytes{value: bytes}}, span)
                    return sema_expr_expected_owned(^constant, expected, environment, program, &diagnostics)
                }
                // `[U8; N]{"…"}` and other element heads check each byte as an element.
                elements :: loop byte in bytes -> Expr.Int{value: Int.from_u8(byte), span: span, width: None, raw: Val("{Int.from_u8(byte)}"), id: AST_NODE_GENERATED}
                checked :: sema_expression_list(Expr.ListLit{elements: elements, span: span, id: AST_NODE_GENERATED}, elements, span, Val(result_head), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected_owned(^checked, expected, environment, program, &diagnostics)
            }
            .Empty -> {
                checked :: sema_expression_list(Expr.ListLit{elements: [Expr]{}, span: span, id: AST_NODE_GENERATED}, [Expr]{}, span, Val(result_head), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected_owned(^checked, expected, environment, program, &diagnostics)
            }
            .Elements(elements) -> {
                if elements.len() == 1 && sema_expression_typed_literal_whole_value(result_head, elements[0], environment, program, &scopes, &state, &tail_store, &context) -> return sema_expression_typed_literal_whole(result_head, elements[0], expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                checked :: sema_expression_list(Expr.ListLit{elements: elements, span: span, id: AST_NODE_GENERATED}, elements, span, Val(result_head), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected_owned(^checked, expected, environment, program, &diagnostics)
            }
            .Value(value) -> {
                if sema_expression_typed_literal_whole_value(result_head, value, environment, program, &scopes, &state, &tail_store, &context) -> return sema_expression_typed_literal_whole(result_head, value, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                elements := [Expr]{value}
                checked :: sema_expression_list(Expr.ListLit{elements: elements, span: span, id: AST_NODE_GENERATED}, elements, span, Val(result_head), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected_owned(^checked, expected, environment, program, &diagnostics)
            }
            else -> return sema_expression_typed_literal_mismatch(result_head, span, &diagnostics)
        }
        .Map(_, _, _) -> if body == {
            .Empty -> {
                checked :: sema_expression_map(Expr.MapLit{entries: [ExprPair]{}, span: span, id: AST_NODE_GENERATED}, [ExprPair]{}, span, Val(result_head), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected_owned(^checked, expected, environment, program, &diagnostics)
            }
            .Entries(entries) -> {
                checked :: sema_expression_map(Expr.MapLit{entries: entries, span: span, id: AST_NODE_GENERATED}, entries, span, Val(result_head), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected_owned(^checked, expected, environment, program, &diagnostics)
            }
            // #3739: a map body without `:` can only be the whole value.
            .Value(value) -> return sema_expression_typed_literal_whole(result_head, value, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            else -> return sema_expression_typed_literal_mismatch(result_head, span, &diagnostics)
        }
        .Named(name) -> if body == {
            .Fields(fields) -> {
                // (#4764): a distinct head is not a record, so `CustomerID{n}`
                // is its one-expression body (the parser reads `{n}` as a field
                // shorthand before types are known) and reaches the E0128 conversion rule.
                if fields.len() == 1 && sema_expression_field_is_shorthand(fields[0]) && sema_expr_distinct_facts(result_head, environment, program, &scopes) != None {
                    // copy: `fields` is a payload of read parameter `body`, which keeps the original
                    return sema_expression_typed_literal(head, TypedLitBody.Value{value: fields[0].value.copy()}, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                }
                checked :: sema_expression_struct_literal(name, [Type]{}, fields, false, None, span, Val(result_head), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected_owned(^checked, expected, environment, program, &diagnostics)
            }
            .Empty -> {
                checked :: sema_expression_struct_literal(name, [Type]{}, [ExprField]{}, false, None, span, Val(result_head), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected_owned(^checked, expected, environment, program, &diagnostics)
            }
            else -> {}
        }
        .Apply(name, args) -> if body == {
            .Fields(fields) -> {
                checked :: sema_expression_struct_literal(name, args, fields, false, None, span, Val(result_head), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected_owned(^checked, expected, environment, program, &diagnostics)
            }
            .Empty -> {
                checked :: sema_expression_struct_literal(name, args, [ExprField]{}, false, None, span, Val(result_head), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                return sema_expr_expected_owned(^checked, expected, environment, program, &diagnostics)
            }
            else -> {}
        }
        // `T?{ body }` checks its one-expression
        // body in the expected `T?` position, so `None` and `Val(x)` both elaborate.
        .Option(_) -> if body == {
            .Value(value) -> {
                checked :: sema_check_expression(value, Val(result_head), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                typed :: sema_expr_expected(checked, Val(result_head), environment, program, &diagnostics) ?? return None
                return sema_expr_expected_owned(^typed, expected, environment, program, &diagnostics)
            }
            else -> return sema_expression_typed_literal_mismatch(result_head, span, &diagnostics)
        }
        else -> {}
    }

    if body == {
        .Value(value) -> {
            if kind == .Val(head_kind) {
                if head_kind == TypedHeadKind.SQL || head_kind == TypedHeadKind.HTML || head_kind == TypedHeadKind.Sh || head_kind == TypedHeadKind.URL || head_kind == TypedHeadKind.Path || head_kind == TypedHeadKind.DateTime {
                    return sema_expression_typed_literal_text(head_kind, result_head, value, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                }
            }
            // The `Regex` head is the compile-checked pattern literal whether it is
            // written (`Regex{…}`, which `use core.regex` may resolve to the
            // source-owned record) or inferred from a Regex-typed slot (`{…}`).
            if sema_expression_is_regex_head(result_head) || sema_expression_is_regex_head(written_head) -> return sema_expression_typed_literal_regex(value, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            checked_optional := if sema_expression_typed_literal_value_needs_head(value, result_head) -> sema_check_expression(value, Val(result_head), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(value, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            checked :: checked_optional ?? return None
            if sema_expression_typed_literal_float_to_integer(result_head, checked.ty, checked.span, &diagnostics) -> return None
            converted := checked
            value_span :: expr_span(value)
            line := sema_source_line_at(environment.source_segments, value_span) ?? 0
            needs_conversion := (checked.ty == Type.Int && (if result_head == {.IntN(_, _) -> true else -> false})) || (sema_expr_is_integer(checked.ty) && (result_head == Type.Float || result_head == Type.Float32)) || (checked.ty == Type.Float && result_head == Type.Float32) || sema_expression_typed_literal_fixed_conversion(checked.ty, result_head)
            if needs_conversion {
                converted = sema_expr_numeric_literal_conversion(checked, result_head, value_span, line, &diagnostics) ?? return None
            }
            if sema_expression_typed_literal_distinct_mismatch(result_head, converted, environment, program, &scopes, &diagnostics) -> return None
            typed :: sema_expr_expected(converted, Val(result_head), environment, program, &diagnostics) ?? return None
            return sema_expr_expected_owned(^typed, expected, environment, program, &diagnostics)
        }
        .Elements(elements) -> if elements.len() == 1 {
            value := elements[0]
            checked_optional := if sema_expression_typed_literal_value_needs_head(value, result_head) -> sema_check_expression(value, Val(result_head), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(value, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            checked :: checked_optional ?? return None
            if sema_expression_typed_literal_float_to_integer(result_head, checked.ty, checked.span, &diagnostics) -> return None
            converted := checked
            value_span :: expr_span(value)
            line := sema_source_line_at(environment.source_segments, value_span) ?? 0
            needs_conversion := (checked.ty == Type.Int && (if result_head == {.IntN(_, _) -> true else -> false})) || (sema_expr_is_integer(checked.ty) && (result_head == Type.Float || result_head == Type.Float32)) || (checked.ty == Type.Float && result_head == Type.Float32) || sema_expression_typed_literal_fixed_conversion(checked.ty, result_head)
            if needs_conversion {
                converted = sema_expr_numeric_literal_conversion(checked, result_head, value_span, line, &diagnostics) ?? return None
            }
            if sema_expression_typed_literal_distinct_mismatch(result_head, converted, environment, program, &scopes, &diagnostics) -> return None
            typed :: sema_expr_expected(converted, Val(result_head), environment, program, &diagnostics) ?? return None
            return sema_expr_expected_owned(^typed, expected, environment, program, &diagnostics)
        }
        else -> {}
    }
    sema_expression_typed_literal_mismatch(result_head, span, &diagnostics)
}

// This rule scalar heads use parameter acceptance, never a numeric retag.
fn sema_expression_typed_literal_float_to_integer(head: Type, offered: Type, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if (offered == Type.Float || offered == Type.Float32) && sema_expr_is_integer(head) {
        &diagnostics.push(sema_error("E0112", span, "a `{type_name(offered)}` can't be used where a `{type_name(head)}` is expected", "a typed literal accepts its body like a parameter; converting a decimal value to a whole number must be explicit", "use `{type_name(head)}.from_float(value)` and handle its failure, or `math.round(value)` to round to the nearest Int"))
        return true
    }
    false
}

// Integer heads own an explicit conversion, including narrowing fixed carriers.
// A changed result annotation alone cannot change the value's representation.
fn sema_expression_typed_literal_fixed_conversion(source: Type, head: Type) -> Bool {
    if source == .IntN(_, _) {
        if head == Type.Int -> return true
        if head == .IntN(_, _) -> return source != head
    }
    false
}

// `Float{0.5}` / `F32{-1.5}`: the machine-float head is the decimal literal's
// expected carrier, as in Rust's typed-literal inference; `I8{200}` /
// `I8{-129}`: a fixed-width head is a bare integer literal's carrier, so the
// literal is range-checked against it.
// `through_binary = false`: bare/signed decimals contextualize, but compound
// numeric syntax keeps its operand types (ScalarConversionFixtures.jet).
fn sema_expression_typed_literal_value_needs_head(value: Expr, head: Type) -> Bool Never! {
    if sema_expression_list_element_needs_expected_type(value) -> return true
    if head == .IntN(_, _) {
        if sema_expression_typed_literal_integer_literal(value) -> return true
    }
    sema_expr_decimal_literal_operand(value, false) && sema_expr_expects_machine_float(Val(head))
}

fn sema_expression_typed_literal_integer_literal(value: Expr) -> Bool Never! {
    if value == {
        .Int(_, _, _, _, _) -> true
        .Paren(inner, _, _) -> sema_expression_typed_literal_integer_literal(inner)
        .Unary(op, inner, _, _) -> op == UnOp.Neg && sema_expression_typed_literal_integer_literal(inner)
        else -> false
    }
}
