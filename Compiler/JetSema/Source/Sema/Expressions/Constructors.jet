// Checked struct and enum construction expressions.
fn sema_expression_type_symbol(scopes: &SemaScopeTable, name: String) -> ?Symbol {
    index :: sema_scope_resolve_index(scopes, name) ?? return None
    symbol :: scopes.bindings[index].symbol
    if symbol.kind == SymbolKind.Type -> Val(symbol) else -> None
}

struct SemaExpressionResolvedType {
    ty: Type
    owner: Symbol
}

fn sema_expression_struct_type(type_name: String, type_args: [Type], expected: ?Type, span: Span, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> ?SemaExpressionResolvedType {
    if type_name == "" {
        expected_ty :: expected ?? {
            diagnostics.push(sema_error("E0119", span, "an inferred struct literal needs an expected type", "the `{{ ... }}` form uses the surrounding type to choose its fields", "write the struct name or add a type annotation"))
            return None
        }
        normalized :: sema_expr_unwrap_tag(expected_ty)
        if normalized == {
            .Named(name) -> {
                owner :: sema_expression_type_symbol(scopes, name) ?? {
                    diagnostics.push(sema_error("E0119", span, "the expected type is not a registered struct", "inferred construction needs declaration metadata for its fields", "name a declared struct type"))
                    return None
                }
                return Val(SemaExpressionResolvedType{ty: normalized, owner: owner})
            }
            .Apply(name, args) -> {
                owner :: sema_expression_type_symbol(scopes, name) ?? {
                    diagnostics.push(sema_error("E0119", span, "the expected type is not a registered struct", "inferred construction needs declaration metadata for its fields", "name a declared struct type"))
                    return None
                }
                return Val(SemaExpressionResolvedType{ty: normalized, owner: owner})
            }
            else -> {
                diagnostics.push(sema_error("E0119", span, "`{{ ... }}` needs a known struct type", "inferred construction requires a nominal struct type from context", "name the type before the fields"))
                return None
            }
        }
    }
    owner :: sema_expression_type_symbol(scopes, type_name) ?? {
        diagnostics.push(sema_unknown_name(type_name, span))
        return None
    }
    ty := if type_args.len() > 0 -> Type.Apply(type_name, type_args) else -> Type.Named(type_name)
    if type_args.len() == 0 && expected == .Val(expected_ty) {
        normalized_expected :: sema_expr_unwrap_tag(expected_ty)
        if normalized_expected == .Apply(name, _) {
            if name == type_name -> ty = normalized_expected
        }
    }
    Val(SemaExpressionResolvedType{ty: ty, owner: owner})
}

fn sema_expression_struct_literal(type_name: String, type_args: [Type], fields: [ExprField], inferred: Bool, as_trait: ?String, span: Span, expected: ?Type, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> ?TExpr {
    resolved :: sema_expression_struct_type(type_name, type_args, expected, span, scopes, &diagnostics) ?? return None
    owner := resolved.owner
    context.name_references.push(SemaNameReferenceFact{span: span, symbol: owner, kind: "type"})
    result_ty := resolved.ty
    declaration :: sema_scope_resolve_declaration(environment, owner.id) ?? {
        diagnostics.push(sema_error("E0119", span, "struct `{type_name(result_ty)}` has no declaration metadata", "a struct literal must check every declared field before lowering", "use a registered struct declaration"))
        return None
    }
    struct_def :: if declaration == {
        .Struct(value) -> value
        else -> {
            diagnostics.push(sema_error("E0119", span, "`{type_name(result_ty)}` is not a struct", "struct literal syntax only constructs struct declarations", "use the enum variant constructor for an enum"))
            return None
        }
    }
    names :: loop parameter in struct_def.type_params -> parameter.name
    args := type_args
    if type_name == "" || type_args.len() == 0 {
        if result_ty == .Apply(_, rows) {
            args = rows
        }
    }
    if args.len() != names.len() {
        diagnostics.push(sema_error("E0104", span, "struct `{type_name(result_ty)}` has the wrong number of type arguments", "each declared type parameter needs one concrete argument", "provide one type argument for every generic parameter"))
        return None
    }
    supplied := [Bool]{}
    loop _ in struct_def.fields -> supplied.push(false)
    loop source in fields {
        found := -1
        loop (index, declared) in struct_def.fields {
            if declared.name == source.name {
                found = index
                break
            }
        }
        if found < 0 {
            diagnostics.push(sema_error("E0302", source.name_span, "`{type_name(result_ty)}` has no field `{source.name}`", "struct fields must be declared by the type", "use one of the declared field names"))
            return None
        }
        if supplied[found] {
            diagnostics.push(sema_error("E0105", source.name_span, "field `{source.name}` is supplied more than once", "each struct field receives one value", "remove the duplicate field"))
            return None
        }
        supplied[found] = true
    }
    values := [TStructFieldValue]{}
    loop field in struct_def.fields {
        field_ty :: sema_inference_substitute_type(field.ty, names, args)
        value_expr := None
        field_reference_span := field.name_span
        loop source in fields {
            if source.name == field.name {
                field_reference_span = source.name_span
                value_expr = Val(source.value)
                break
            }
        }
        if value_expr == None && field.default != None -> value_expr = field.default
        if value_expr == None {
            diagnostics.push(sema_error("E0108", span, "field `{field.name}` needs a value", "a struct literal must initialize every field without a default", "supply `{field.name}: ...` or declare a field default"))
            return None
        }
        checked :: sema_check_expression_with_lambda_escapes(value_expr ?? Expr.Unit(field.name_span), Val(field_ty), environment, &scopes, &state, &tail_store, &context, Val(true), &diagnostics) ?? return None
        compatible :: sema_expr_expected_assignable(field_ty, checked.ty, environment) ?? return None
        if !compatible {
            diagnostics.push(sema_type_mismatch(sema_expr_expected_type(field_ty, environment), sema_expr_expected_type(checked.ty, environment), expr_span(value_expr ?? Expr.Unit(field.name_span))))
            return None
        }
        field_id :: symbol_id(SymbolKind.Field, owner.module_name, owner.id.key, field.name)
        symbol :: Symbol{id: field_id, kind: SymbolKind.Field, name: field.name, module_name: owner.module_name, owner: Val(owner.id.key), span: field.name_span, ty: Val(field_ty), visibility: if field.is_pub -> 2 else -> if field.is_package_pub -> 1 else -> 0}
        context.name_references.push(SemaNameReferenceFact{span: field_reference_span, symbol: symbol, kind: "field"})
        reference := sema_expression_field_ref(symbol, Val(owner.id), field_ty)
        reference.boxed = sema_scope_environment_boxed_edge(environment, owner.id, field.name)
        values.push(TStructFieldValue{field: reference, value: checked, boxed: reference.boxed})
    }
    coercion := None
    if as_trait == .Val(trait_name) {
        trait_symbol_index :: sema_scope_resolve_index(scopes, trait_name)
        if trait_symbol_index == None || scopes.bindings[trait_symbol_index ?? 0].symbol.kind != SymbolKind.Trait {
            diagnostics.push(sema_error("E0119", span, "`{trait_name}` is not a registered trait", "trait coercion must retain the target trait identity", "name a declared trait"))
            return None
        }
        trait_symbol :: scopes.bindings[trait_symbol_index ?? 0].symbol
        context.name_references.push(SemaNameReferenceFact{span: span, symbol: trait_symbol, kind: "trait"})
        coercion = Val(TCoercionTarget{trait_symbol: trait_symbol.id, concrete_type: owner.id})
        resolved_trait :: sema_expr_expected_type(Type.Named(trait_name), environment)
        result_ty = if resolved_trait == {
            .TraitObject(_) -> resolved_trait
            else -> Type.TraitObject([String]{trait_symbol.name})
        }
    }
    value :: sema_tir_expr(result_ty, TExprKind.StructLit(values, None, coercion), span)
    sema_expr_expected(value, expected, environment, &diagnostics)
}

fn sema_expression_enum_literal(type_name: String, type_args: [Type], variant: String, args: [EnumLitArg], leading_dot: Bool, variant_span: ?Span, span: Span, expected: ?Type, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> ?TExpr {
    contextual_allowed :: if {
        !leading_dot -> true
        else -> if sema_expr_unwrap_tag(expected ?? Type.Named("Never")) == {
            .Option(_) -> true
            else -> false
        }
    }
    if type_name == "" && contextual_allowed && variant == "Val" && args.len() == 1 {
        if args[0] == {
            .Positional(value) -> return sema_expression_present(value, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            else -> {}
        }
    }
    if type_name == "" && contextual_allowed && variant == "None" && args.len() == 0 {
        return sema_expression_absent(span, expected, &diagnostics)
    }
    resolved_name := type_name
    if resolved_name == "" {
        expected_ty :: expected ?? {
            diagnostics.push(sema_error("E0330", span, "can't infer the enum type for `.{variant}`", "a leading-dot variant needs a known enum type from context", "add a type annotation, or write the full form `EnumName.{variant}`"))
            return None
        }
        normalized :: sema_expr_unwrap_tag(expected_ty)
        resolved_name = if normalized == {
            .Named(name) -> name
            .Apply(name, _) -> name
            .Option(inner) -> if inner == {
                .Named(name) -> name
                else -> ""
            }
            else -> ""
        }
        if resolved_name == "" {
            diagnostics.push(sema_error("E0330", span, "can't infer the enum type for `.{variant}`", "a leading-dot variant needs a known enum type from context", "add a type annotation, or write the full form `EnumName.{variant}`"))
            return None
        }
    }
    if type_name == "" {
        inferred_owner_index :: sema_scope_resolve_index(scopes, resolved_name)
        inferred_declaration := None
        if inferred_owner_index == .Val(owner_index) {
            inferred_owner :: scopes.bindings[owner_index].symbol
            if inferred_owner.kind == SymbolKind.Type -> inferred_declaration = sema_scope_resolve_declaration(environment, inferred_owner.id)
        }
        inferred_is_enum :: if inferred_declaration == {
            .Val(inferred) -> if inferred == {
                .Enum(_) -> true
                else -> false
            }
            .None -> false
        }
        if !inferred_is_enum {
            diagnostics.push(sema_error("E0330", span, "can't infer the enum type for `.{variant}`", "a leading-dot variant needs a known enum type from context", "add a type annotation, or write the full form `EnumName.{variant}`"))
            return None
        }
    }
    owner :: sema_expression_type_symbol(scopes, resolved_name) ?? {
        diagnostics.push(sema_unknown_name(resolved_name, span))
        return None
    }
    context.name_references.push(SemaNameReferenceFact{span: span, symbol: owner, kind: "type"})
    declaration :: sema_scope_resolve_declaration(environment, owner.id) ?? {
        diagnostics.push(sema_error("E0119", span, "enum `{resolved_name}` has no declaration metadata", "an enum constructor must check its variant payload", "use a registered enum declaration"))
        return None
    }
    enum_def :: if declaration == {
        .Enum(value) -> value
        else -> {
            diagnostics.push(sema_error("E0119", span, "`{resolved_name}` is not an enum", "enum literal syntax only constructs enum declarations", "use a struct literal for a struct type"))
            return None
        }
    }
    selected := None
    loop candidate in enum_def.variants {
        if candidate.name == variant {
            selected = Val(candidate)
            break
        }
    }
    selected_variant :: selected ?? {
        diagnostics.push(sema_error("E0302", variant_span ?? span, "`{resolved_name}` has no variant `{variant}`", "enum constructors must name a declared variant", "use one of the declared variants"))
        return None
    }
    variant_id :: symbol_id(SymbolKind.Variant, owner.module_name, owner.id.key, variant)
    variant_symbol :: Symbol{id: variant_id, kind: SymbolKind.Variant, name: variant, module_name: owner.module_name, owner: Val(owner.id.key), span: selected_variant.name_span, ty: sema_registration_variant_type(selected_variant.payload), visibility: owner.visibility}
    context.name_references.push(SemaNameReferenceFact{span: variant_span ?? span, symbol: variant_symbol, kind: "variant"})
    generic_names :: loop parameter in enum_def.type_params -> parameter.name
    generic_args := type_args
    if generic_args.len() == 0 && expected == .Val(expected_ty) {
        normalized :: sema_expr_unwrap_tag(expected_ty)
        if normalized == .Apply(name, rows) {
            if name == resolved_name -> generic_args = rows
        }
    }
    if generic_args.len() != generic_names.len() {
        diagnostics.push(sema_error("E0104", span, "enum `{resolved_name}` has the wrong number of type arguments", "each declared type parameter needs one concrete argument", "provide one type argument for every generic parameter"))
        return None
    }
    payload_values := [TEnumArg]{}
    if selected_variant.payload == {
        .Unit -> {
            if args.len() != 0 {
                diagnostics.push(sema_error("E0104", span, "unit variant `{variant}` takes no payload", "the selected enum variant has no fields", "remove the constructor arguments"))
                return None
            }
        }
        .Single(ty, _) -> {
            if args.len() != 1 {
                diagnostics.push(sema_error("E0104", span, "variant `{variant}` expects one payload", "this enum variant has one positional field", "pass exactly one value"))
                return None
            }
            payload_expr :: if args[0] == {
                .Positional(value) -> value
                else -> {
                    diagnostics.push(sema_error("E0764", span, "variant `{variant}` takes a positional payload", "single-payload variants do not have field labels", "pass the value without a label"))
                    return None
                }
            }
            payload_ty :: sema_inference_substitute_type(ty, generic_names, generic_args)
            checked :: sema_check_expression(payload_expr, Val(payload_ty), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
            compatible :: sema_expr_expected_assignable(payload_ty, checked.ty, environment) ?? return None
            if !compatible {
                diagnostics.push(sema_type_mismatch(sema_expr_expected_type(payload_ty, environment), sema_expr_expected_type(checked.ty, environment), expr_span(payload_expr)))
                return None
            }
            payload_values.push(TEnumArg{value: checked, clone: false, move: false})
        }
        .Named(fields) -> {
            supplied := [Bool]{}
            loop _ in fields -> supplied.push(false)
            named_values := [?TExpr]{}
            loop _ in fields -> named_values.push(None)
            loop arg in args {
                label := ""
                payload_expr := Expr.Unit(span)
                if arg == {
                    .Named(name, value) -> {
                        label = name
                        payload_expr = value
                    }
                    .Positional(_) -> {
                        diagnostics.push(sema_error("E0764", span, "variant `{variant}` needs named payload fields", "this enum variant declares labeled fields", "write each variant field as `name: value`"))
                        return None
                    }
                }
                found := -1
                loop (index, declared) in fields {
                    if declared.name == label {
                        found = index
                        break
                    }
                }
                if found < 0 {
                    diagnostics.push(sema_error("E0302", expr_span(payload_expr), "variant `{variant}` has no field `{label}`", "named enum payloads use the declaration's field names", "use a declared payload field"))
                    return None
                }
                if supplied[found] {
                    diagnostics.push(sema_error("E0105", expr_span(payload_expr), "variant field `{label}` is supplied more than once", "each enum payload field receives one value", "remove the duplicate field"))
                    return None
                }
                supplied[found] = true
                field_ty :: sema_inference_substitute_type(fields[found].ty, generic_names, generic_args)
                checked :: sema_check_expression(payload_expr, Val(field_ty), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                compatible :: sema_expr_expected_assignable(field_ty, checked.ty, environment) ?? return None
                if !compatible {
                    diagnostics.push(sema_type_mismatch(sema_expr_expected_type(field_ty, environment), sema_expr_expected_type(checked.ty, environment), expr_span(payload_expr)))
                    return None
                }
                named_values[found] = Val(checked)
            }
            loop (index, was_supplied) in supplied {
                if !was_supplied {
                    diagnostics.push(sema_error("E0108", span, "variant field `{fields[index].name}` needs a value", "named enum payloads initialize every declared field", "supply the missing payload field"))
                    return None
                }
            }
            loop named_value in named_values -> payload_values.push(TEnumArg{value: named_value ?? sema_tir_expr(Type.Named("Unit"), TExprKind.Unit, span), clone: false, move: false})
        }
    }
    enum_ty :: if generic_args.len() > 0 -> Type.Apply(resolved_name, generic_args) else -> Type.Named(resolved_name)
    variant_id := symbol_id(SymbolKind.Variant, owner.module_name, owner.id.key, variant)
    value :: sema_tir_expr(enum_ty, TExprKind.EnumCtor(owner.id, variant_id, payload_values), span)
    sema_expr_expected(value, expected, environment, &diagnostics)
}
