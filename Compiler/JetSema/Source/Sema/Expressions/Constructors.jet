// Checked struct and enum construction expressions.
use {
    boundary_regex: core.regex
    jet_foundation.[
        AST_NODE_GENERATED,
        AccessConvention,
        ByteTextPart,
        Call,
        CallArg,
        CallContractRow,
        CallablePolicy,
        CallablePolicyChain,
        Diagnostic,
        EnumLitArg,
        Expr,
        FunctionCallMetadata,
        FunctionDefaultRef,
        Lambda,
        LambdaBody,
        LambdaParam,
        NamedSpan,
        IndexKind,
        NodeKind,
        OrFallback,
        ExprField,
        ExprPair,
        Field,
        ParamZone,
        PlaceAccess,
        Span,
        StrPart,
        Stmt,
        Symbol,
        SymbolKind,
        TComptimeReport,
        TComptimeValue,
        TFieldRef,
        TNarrowOutcome,
        Type,
        TypeParam,
        TypeTupleField,
        TupleField,
        TypedLitBody,
        Variant,
        AST_EMPTY_CALL_ARG_FLAGS,
        ast_empty_lambda_meta,
        core_enum_cases,
        core_enum_payload_variants,
        core_enum_variant_payload,
        core_module_enum_cases,
        core_module_type_leaf,
        core_record_field,
        core_record_literal_fields,
        core_record_literal_is_core_only,
        core_identity_is,
        expr_span,
        boundary_head_owner_module,
        symbol_find,
        symbol_table_key,
        type_identity_key,
        type_name,
        TLetTy,
        TLetWrapper,
        TPatternBindingFact,
        TPatternPosition,
        jet_target_layout_atomic_scalar_type,
        checked_generated_local,
        TextEdit,
        diagnostic_with_alternative_edit,
        diagnostic_with_edit,
        ModuleID,
        module_is_core,
        module_is_none,
        owned_trait_conversion,
        module_text,
        foundation_byte_text,
    ]
}

// A type named by a local binding, through a module alias
// (`types.Kind`), or by the canonical identity a declared type resolves to
// (`module.Kind`, the form declared types carry after resolution) is the
// declared type itself, so constructors, leading-dot variants and field reads
// resolve it through the registration graph when no local type binding has
// that name.
sema_expression_type_symbol: fn(scopes: ^SemaScopeTable, environment: SemaScopeEnvironment, program: SemaProgramTables, name: String) -> Symbol? {
    ^index: sema_scope_resolve_index(scopes, name)
    if index == .Val(found) {
        if scopes.bindings[found].symbol.kind == SymbolKind.Type {
            return Val(sema_scope_binding_symbol(environment, scopes, found))
        }
    }
    graph: program.registration_graph
    resolved: sema_type_graph_lookup_symbol_at(graph, sema_scope_caller_row(environment, graph), name) ?? return None
    if sema_resolved_kind(graph, resolved) == SymbolKind.Type -> Val(sema_resolved_symbol(graph, resolved)) else -> None
}

// A type name that resolves to nothing. `Never` has no values, so naming it
// in a constructor is E2422. `alias.Name` through a Core module
// alias, naming a declaration that module doesn't export, is the E0609 its
// `use core.X.[Name]` import gets; `alias.child.Name` into a `priv module`
// of the imported module, or `alias.Name` naming a declaration the source
// module `alias` keeps private, is E0605; anything else is an unknown name.
sema_expression_unknown_type: fn(name: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Diagnostic {
    if name == "Never" -> return sema_never_as_value(span)
    graph: program.registration_graph
    caller: sema_scope_caller_row(environment, graph)
    if caller >= 0 && name.split_once(".") == .Val(qualified) {
        if sema_registration_private_module_path(graph, graph.modules[caller].module_identity, name) == .Val(path) {
            return sema_registration_private_module_error(path, span)
        }
        if sema_registration_core_private_qualified(graph, graph.modules[caller].module_identity, qualified.before, qualified.after) == .Val(module_name) {
            return sema_registration_core_private_error(qualified.after, module_name, span)
        }
        if !qualified.after.contains(".") && sema_registration_private_member(graph, graph.modules[caller].module_identity, qualified.before, qualified.after) {
            return sema_registration_private_member_error(qualified.after, qualified.before, span)
        }
    }
    sema_unknown_name(name, span)
}

// A type the Core export ledger owns without a source declaration
// (`use core.encoding.[DataEvent]`, `encoding.DataEvent`): the registered
// exporting module's catalog row authenticates the enum and its variants; a
// user module with a Core-like leaf or name never takes this path.
sema_expression_core_export_variants: fn(check: SemaBodyCheck, symbol: Symbol) -> [String]? {
    if symbol.kind != SymbolKind.Type || !module_is_core(symbol.module_identity) -> return None
    if sema_scope_declaration_site(check.environment.*, check.program.*, symbol.id) != None {
        return None
    }
    graph: check.program.registration_graph
    module_index: sema_registration_module_index(graph, symbol.module_identity) ?? return None
    core_module_enum_cases(graph.modules[module_index].module_name, symbol.name)
}

// `Name.Variant` reads a variant when `Name` is a declared enum, a
// compiler-owned enum menu (`Ordering`, `RemoveBy`, the fact enums) or a Core
// enum, and no value binding shadows it. A struct or distinct type the program
// declares under a Core enum's name (`Severity`) is that type, not the Core
// enum.
sema_expression_names_enum: fn(name: String, check: ^SemaBodyCheck) -> Bool {
    ^index: sema_scope_resolve_index(check.scopes, name)
    if index == .Val(found) && check.scopes.bindings[found].symbol.kind != SymbolKind.Type {
        return false
    }
    if sema_fact_enum_menu(Type.Named{name: name}, check.environment.*, check.program.*) != None {
        return true
    }
    ^owner: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, name)
    if owner == .Val(symbol) {
        if sema_scope_declaration_is(check, symbol.id, SemaScopeDeclarationKind.Enum) -> return true
        user_declared: !module_is_core(symbol.module_identity)
        if user_declared && (sema_scope_declaration_is(check, symbol.id, SemaScopeDeclarationKind.Struct) || sema_scope_declaration_is(check, symbol.id, SemaScopeDeclarationKind.Distinct)) {
            return false
        }
        if sema_expression_core_export_variants(check, symbol) != None -> return true
    }
    sema_expression_core_enum_name(name)
}

// The rest of the known enums: Core enum leaves, the compiler-owned payload
// families and the compiler-owned hook enums, known whether or not the program
// imports them. A Core enum a loaded Core source declares (`NetError`)
// resolves through its symbol instead.
sema_expression_core_enum_name: fn(name: String) -> Bool Never! {
    core_enum_cases(name) != None || core_enum_payload_variants(name) != None || sema_expression_hook_decision_variants(name) != None
}

SemaExpressionEnumPath: struct {
    enum_name: String,
    variant: String,
}

sema_expression_path_segments: fn(expression: Expr) -> [String]? {
    if expression == {
        .Ident(name, _, _) -> Val([String]{name})
        // `Phantom<Space>.Marker`: the generic owner names its declaration.
        .TypeValue(ty, _, _) -> if ty == .Apply(name, _) -> Val([String]{name}) else -> None
        // A `$` member reads a compiler fact (`Event.$layout.size`): the
        // chain names a fact, not a variant or module path.
        .Field(inner, member, _, _) -> {
            if member.starts_with("$") -> return None
            ^segments: sema_expression_path_segments(inner) ?? return None
            segments.push(member.copy())
            Val(segments)
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) -> None
    }
}

// The type arguments a variant path's generic owner carries
// (`Phantom<Space>.Marker`, `Tree<Int>.Group.Leaf`); none for a bare owner.
sema_expression_path_type_args: fn(expression: Expr) -> [Type] {
    if expression == .Field(inner, _, _, _) -> return sema_expression_path_type_args(inner)
    if expression == .TypeValue(ty, _, _) {
        if ty == .Apply(_, args) -> return args
    }
    [Type]{}
}

sema_expression_join_segments: fn(segments: [String], start: Int) -> String Never! {
    parts: loop index in start..<segments.len() -> segments[index]
    parts.join(".")
}

// The field chain `base.member` names a variant when its root is a known enum
// (`Kind.Beta`, grouped `Kind.Group.Leaf`), or a module alias whose next
// segment is one (`types.Kind.Beta`). A local value root names no variant.
sema_expression_enum_variant_path: fn(base: Expr, member: String, check: ^SemaBodyCheck) -> SemaExpressionEnumPath? {
    ^segments: sema_expression_path_segments(base) ?? return None
    segments.push(member.copy())
    root: segments[0]
    index: sema_scope_resolve_index(check.scopes, root)
    if index == .Val(found) {
        kind: check.scopes.bindings[found].symbol.kind
        // A whole-module import binds its alias as an Import symbol
        // (`use enc: core.encoding` then `enc.EncodingFormat.JSON`).
        if kind != SymbolKind.Type && kind != SymbolKind.Module && kind != SymbolKind.Import {
            return None
        }
    }
    // `use Tree: core.encoding.Dyn`: an alias of a Core enum carrier
    // names that enum, whose variants are read by its Core leaf.
    enum_root: sema_expression_core_enum_alias(root, check.scopes) ?? root
    if sema_expression_names_enum(enum_root, check) {
        return Val(SemaExpressionEnumPath{enum_name: enum_root, variant: sema_expression_join_segments(segments, 1)})
    }
    if segments.len() < 3 -> return None
    qualified: "{root}.{segments[1]}"
    if !sema_expression_names_enum(qualified, check) -> return None
    Val(SemaExpressionEnumPath{enum_name: qualified, variant: sema_expression_join_segments(segments, 2)})
}

// The Core enum leaf a local type alias binds (`Tree` for `Dyn`): an
// imported Core carrier keeps its builtin type under the local name.
sema_expression_core_enum_alias: fn(name: String, scopes: SemaScopeTable) -> String? {
    index: sema_scope_resolve_index(scopes, name) ?? return None
    symbol: scopes.bindings[index].symbol
    if symbol.kind != SymbolKind.Type -> return None
    ty: symbol.ty ?? return None
    if ty == .Named(leaf) {
        if leaf != name && sema_expression_core_enum_name(leaf) -> return Val(leaf)
    }
    None
}

// A static-owner call `Enum.Variant(args)` / `Enum.Group.Leaf(args)` builds
// the variant when the enum declares it; any other member stays a static
// method call.
sema_expression_enum_variant_call: fn(receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    unhandled: SemaMethodSpecialCheck{handled: false, value: None}
    if type_args.len() > 0 -> return unhandled
    loop argument in args {
        if argument.label != None || argument.spread -> return unhandled
    }
    path: sema_expression_enum_variant_path(receiver, method, check) ?? return unhandled
    // `Dyn.Text("jet")` / `Tree.Int(7)` under an alias of the Core
    // carrier builds the compiler-owned data literal, whose variants carry
    // payloads the unit-only Core enum rows don't list. A declared enum of
    // that name keeps its own variants.
    // A module-qualified carrier (`encoding.Dyn.Float(1.5)`) names the same
    // data literal by its leaf.
    carrier: path.enum_name.split(".").to_list().last() ?? path.enum_name
    if path.variant == method && sema_data_is_json_name(carrier) {
        owner: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, path.enum_name)
        ^declared_enum: false
        if owner == .Val(symbol) {
            declared_enum = sema_scope_declaration_is(check, symbol.id, SemaScopeDeclarationKind.Enum)
        }
        if !declared_enum {
            return sema_call_try_data_literal(Type.Named{name: carrier}, path.variant, args, method_span, expected, check)
        }
    }
    if !sema_expression_enum_declares_variant(path.enum_name, path.variant, check) {
        return unhandled
    }
    // Payload slots retain written access even though they have no CallArg.
    enum_args: loop argument in args -> EnumLitArg.Positional{
        value: if argument.convention == {
            .Read -> argument.expr
            .Write -> Expr.Place{value: argument.expr, access: PlaceAccess.Write, span: argument.span, id: AST_NODE_GENERATED}
            .Move -> Expr.Place{value: argument.expr, access: PlaceAccess.Take, span: argument.span, id: AST_NODE_GENERATED}
        },
    }
    ^end: method_span.end
    if args.len() > 0 && args[args.len() - 1].span.end > end -> end = args[args.len() - 1].span.end
    span: Span{start: expr_span(receiver).start, end: end}
    type_args_written: if owner_type_args.len() > 0 -> owner_type_args else -> sema_expression_path_type_args(receiver)
    SemaMethodSpecialCheck{handled: true, value: sema_expression_enum_literal(path.enum_name, type_args_written, path.variant, enum_args, false, Val(method_span), span, expected, check)}
}

sema_expression_enum_declares_variant: fn(enum_name: String, variant: String, check: ^SemaBodyCheck) -> Bool {
    owner: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, enum_name)
    if owner == .Val(symbol) {
        if sema_scope_declaration_is(check, symbol.id, SemaScopeDeclarationKind.Enum) {
            return sema_scope_declaration_enum_declares(check, symbol.id, variant)
        }
    }
    if sema_expression_hook_decision_variants(enum_name) == .Val(variants) {
        return variants.contains(variant)
    }
    core_enum_variant_payload(enum_name, variant) != None
}

// Two spellings of one declared nominal (`Box`, `types.Box`, `module.Box`) name
// the same head.
sema_expression_same_nominal_head: fn(left: String, right: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if left == right -> return true
    graph: program.registration_graph
    caller: sema_scope_caller_row(environment, graph)
    sema_type_graph_resolve_apply_name(graph, left, caller) == sema_type_graph_resolve_apply_name(graph, right, caller)
}

SemaExpressionResolvedType: struct {
    ty: Type,
    owner: Symbol,
}

sema_expression_struct_type: fn(type_name: String, type_args: [Type], expected: Type?, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, diagnostics: ^[Diagnostic]) -> SemaExpressionResolvedType? {
    if type_name == "" {
        expected_ty: expected ?? {
            diagnostics.push(sema_error("E0119", span, "an inferred struct literal needs an expected type", "the `{{ ... }}` form uses the surrounding type to choose its fields", "write the struct name before the braces, like `Point{{ x: 1 }}`"))
            return None
        }
        normalized: sema_expr_unwrap_tag(sema_expr_expected_type(expected_ty, environment, program))
        if normalized == {
            .Named(name) -> {
                owner: sema_expression_type_symbol(scopes, environment, program, name) ?? {
                    diagnostics.push(sema_error("E0119", span, "the expected type is not a registered struct", "inferred construction needs declaration metadata for its fields", "name a declared struct type"))
                    return None
                }
                return Val(SemaExpressionResolvedType{ty: normalized, owner: owner})
            }
            .Apply(name, args) -> {
                owner: sema_expression_type_symbol(scopes, environment, program, name) ?? {
                    diagnostics.push(sema_error("E0119", span, "the expected type is not a registered struct", "inferred construction needs declaration metadata for its fields", "name a declared struct type"))
                    return None
                }
                return Val(SemaExpressionResolvedType{ty: normalized, owner: owner})
            }
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
                diagnostics.push(sema_error("E0119", span, "`{{ ... }}` needs a known struct type", "inferred construction requires a nominal struct type from context", "name the type before the fields"))
                return None
            }
        }
    }
    owner: sema_expression_type_symbol(scopes, environment, program, type_name) ?? {
        unknown: sema_expression_unknown_type(type_name, span, environment, program)
        // A struct literal head that names no struct is E0119.
        diagnostics.push(if unknown.code == "E0107" -> sema_error("E0119", span, "there's no type called `{type_name}`", "struct literals need a struct type name", "define the struct first, or check the spelling") else -> unknown)
        return None
    }
    ^ty: if type_args.len() > 0 -> Type.Apply{name: type_name, args: type_args} else -> Type.Named{name: type_name}
    if type_args.len() == 0 && expected == .Val(expected_ty) {
        normalized_expected: sema_expr_unwrap_tag(expected_ty)
        if normalized_expected == .Apply(name, _) {
            if sema_expression_same_nominal_head(name, type_name, environment, program) {
                ty = normalized_expected
            }
        }
    }
    resolved_ty: sema_expr_expected_type(ty, environment, program)
    ^resolved_name: if resolved_ty == {
        .Named(name) | .Apply(name, _) -> name
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> type_name
    }
    resolved_owner: sema_expression_type_symbol(scopes, environment, program, resolved_name) ?? owner
    Val(SemaExpressionResolvedType{ty: resolved_ty, owner: resolved_owner})
}

// Only supported Atomic fields take a scalar initializer. Ordinary generic
// owners keep their type.
sema_atomic_field_inner: fn(ty: Type) -> Type? Never! {
    if ty == .Apply(name, args) {
        if sema_atomic_type_name(name) && args.len() > 0 && jet_target_layout_atomic_scalar_type(args[0]) {
            return Val(args[0])
        }
    }
    None
}

// Reuse the canonical Atomic.new row so typed field construction reaches the
// same IR carrier as an explicit constructor, without rechecking/moving twice.
sema_atomic_field_initializer: fn(field_ty: Type, value: TExpr, source: Expr, check: ^SemaBodyCheck) -> TExpr? {
    inner: sema_atomic_field_inner(field_ty) ?? return Val(value)
    row: sema_call_builtin_static_row("Atomic", "new", "") ?? return None
    argument: CallArg{convention: row.parameter_convention, expr: source, span: expr_span(source), flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
    bindings: [SemaInferenceBinding]{SemaInferenceBinding{name: row.type_params[0], ty: inner, source: "atomic field initializer"}}
    kind: sema_call_builtin_static_lowered(row, [TExpr]{value}, [CallArg]{argument.move()}, bindings, value.span, 0, check.program.*, check.context) ?? return None
    Val(sema_tree_node(field_ty, kind.move(), value.span))
}

// One struct field as a literal of its owner fills it: its type with the
// owner's generic arguments substituted, whether that type is a string view,
// the field's symbol and whether its edge is boxed.
SemaStructFieldFact: struct {
    field_ty: Type,
    string_view: Bool,
    symbol: Symbol,
    boxed: Bool,
    // The field type holds a view (sema_check_type_contains_view).
    holds_view: Bool,
}

sema_expression_struct_field_fact: fn(field: Field, owner: Symbol, names: [String], args: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables, context: ^SemaCheckContext) -> SemaStructFieldFact {
    field_ty: sema_inference_substitute_type(sema_expression_field_owner_type(environment, program, owner.module_identity, field.ty, names), names, args)
    owner_key: sema_program_symbol_key(program, owner.id)
    field_id: sema_symbol_id(program, context, SymbolKind.Field, sema_scope_module_text(environment, program, owner.module_identity), owner_key, field.name)
    symbol: Symbol{id: field_id, kind: SymbolKind.Field, name: field.name, module_identity: owner.module_identity, owner: Val(owner_key), span: field.name_span, ty: Val(field_ty), visibility: if field.is_pub -> 2 else if field.is_package_pub -> 1 else -> 0}
    graph: program.registration_graph
    ^seen: [U32:Bool]{}
    // Snapshot: a lone program's check marks no field as holding a view.
    holds_view: graph.mode == .Program && sema_check_type_contains_view(graph, owner.module_identity, field_ty, seen)
    SemaStructFieldFact{field_ty: field_ty, string_view: sema_stmt_string_view_type(field_ty), symbol: symbol, boxed: sema_scope_environment_boxed_edge(environment, program, owner.id, field.name), holds_view: holds_view}
}

// The facts of a non-generic struct's fields, in declaration order, from the
// index this returns in `check.context.struct_field_facts`: the first literal of the
// struct this check meets resolves them, and every later one (a list of
// thousands of record rows) reads them back.
sema_expression_struct_field_facts: fn(owner: Symbol, fields: [Field], check: ^SemaBodyCheck) -> Int {
    if check.context.struct_field_fact_rows.get(owner.id.id) == .Val(known) -> return known
    first: check.context.struct_field_facts.len()
    loop field in fields {
        fact: sema_expression_struct_field_fact(field, owner, [String]{}, [Type]{}, check.environment.*, check.program.*, check.context)
        check.context.struct_field_facts.push(fact)
    }
    check.context.struct_field_fact_rows[owner.id.id] = first
    first
}

// One struct field initializer, written or a declared default, checked
// against the field type with the owner's generic arguments substituted. Its
// move is recorded at this point of the literal's evaluation order.
sema_expression_struct_field_value: fn(field: Field, field_value: Expr, field_reference_span: Span, atomic_payload: Bool, owner: Symbol, names: [String], args: [Type], check: ^SemaBodyCheck) -> TStructFieldValue? {
    fact: sema_expression_struct_field_fact(field, owner, names, args, check.environment.*, check.program.*, check.context)
    sema_expression_struct_field_checked(fact, field_value, field_reference_span, atomic_payload, owner, check)
}

sema_expression_struct_field_checked: fn(fact: SemaStructFieldFact, field_value: Expr, field_reference_span: Span, atomic_payload: Bool, owner: Symbol, check: ^SemaBodyCheck) -> TStructFieldValue? {
    field_ty: fact.field_ty
    expected_ty: if atomic_payload -> sema_atomic_field_inner(field_ty) ?? field_ty else -> field_ty
    string_view: fact.string_view
    if !string_view -> sema_copy_site_check_field(field_value, check)
    ^checked_value: if string_view -> sema_string_view_check_field(field_value, field_ty, check) else -> sema_check_expression_with_lambda_escapes(field_value, Val(expected_ty), check, Val(true))
    checked: checked_value ?? return None
    sema_expression_struct_field_finish(fact, checked, field_value, field_reference_span, atomic_payload, owner, check)
}

// A checked field value against its field: ownership, the field type, the
// move at this point of the literal's evaluation order, the field reference.
sema_expression_struct_field_finish: fn(fact: SemaStructFieldFact, checked: TExpr, field_value: Expr, field_reference_span: Span, atomic_payload: Bool, owner: Symbol, check: ^SemaBodyCheck) -> TStructFieldValue? {
    field_ty: fact.field_ty
    expected_ty: if atomic_payload -> sema_atomic_field_inner(field_ty) ?? field_ty else -> field_ty
    string_view: fact.string_view
    if !string_view && !sema_copy_site_check_guard_owned(checked, check, false) -> return None
    if !string_view -> sema_expression_struct_field_view_escape(field_value, check)
    // A supported Atomic field checks its scalar initializer against the
    // scalar (`expected_ty`); the Atomic.new carrier is added below.
    compatible: sema_expr_expected_assignable(expected_ty, checked.ty, check.environment.*, check.program.*) ?? return None
    if !compatible {
        check.diagnostics.push(sema_type_mismatch(sema_expr_expected_type(expected_ty, check.environment.*, check.program.*), sema_expr_expected_type(checked.ty, check.environment.*, check.program.*), expr_span(field_value), check.program.*))
        return None
    }
    if !string_view && !sema_copy_site_record_move(field_value, "the struct literal", check) {
        return None
    }
    check.context.name_references.push(sema_name_reference(field_reference_span, fact.symbol, Val(SymbolKind.Field)))
    if fact.holds_view -> check.context.view_field_values.push(expr_span(field_value))
    ^reference: sema_expression_field_ref(fact.symbol, Val(owner.id), field_ty)
    reference.boxed = fact.boxed
    initialized: if atomic_payload -> sema_atomic_field_initializer(field_ty, checked, field_value, check) ?? return None else -> checked
    Val(TStructFieldValue{field: reference, value: initialized, boxed: reference.boxed})
}

// A list window stored in a struct field needs a stable owner: a named
// `View`/`ViewMut` over a local would let the struct outlive the storage it
// reads, so only a window over a parameter (the receiver included) or a
// module-level value may be stored.
sema_expression_struct_field_view_escape: fn(field_value: Expr, check: ^SemaBodyCheck) {
    if field_value == .Ident(name, span, _) {
        index: sema_scope_resolve_index_at(check.scopes, name, span) ?? return
        ty: check.scopes.bindings[index].symbol.ty ?? return
        if check.scopes.bindings[index].string_view || sema_stmt_string_view_type(ty) {
            return
        }
        window: if sema_expr_unwrap_tag(ty) == {
            .Apply(view_name, _) -> view_name == "View" || view_name == "ViewMut"
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        if !window {
            return
        }
        id: check.scopes.bindings[index].symbol.id
        loop fact in check.state.views {
            if !fact.active || fact.carrier_id != id -> next
            owner_name: fact.source.root
            owner: sema_scope_resolve(check.scopes, owner_name) ?? return
            if owner.kind == SymbolKind.Parameter || owner.kind == SymbolKind.Constant {
                return
            }
            check.diagnostics.push(sema_error("E2305", span, "`{name}` cannot be shared — it does not live long enough to be stored in a struct field", "`{name}` is a view into `{owner_name}`; sharing it outside `{owner_name}`'s scope would let it outlive its owner and point into freed storage", "keep `{name}` inside `{owner_name}`'s scope, or copy what you need before it leaves"))
            return
        }
    }
}

// The owner's type arguments as far as `bindings` has inferred them; an
// unbound parameter stays itself.
sema_expression_struct_inferred_args: fn(names: [String], bindings: [SemaInferenceBinding]) -> [Type] Never! {
    args: loop name in names -> (sema_inference_binding_at(bindings, name) ?? SemaInferenceBinding{name: name.copy(), ty: Type.Named{name: name}, source: ""}).ty
    args
}

// A written field of a literal whose type arguments are inferred. A field
// whose type still names an unbound parameter checks its value with no
// expected type, and that value's type binds the parameter for the fields
// after it.
sema_expression_struct_field_inferred: fn(field: Field, field_value: Expr, field_reference_span: Span, owner: Symbol, type_params: [TypeParam], bindings: ^[SemaInferenceBinding], check: ^SemaBodyCheck) -> TStructFieldValue? {
    names: loop parameter in type_params -> parameter.name
    declared: sema_inference_substitute_type_bindings(sema_expression_field_owner_type(check.environment.*, check.program.*, owner.module_identity, field.ty, names), bindings)
    open: loop parameter in type_params if sema_inference_binding_at(bindings, parameter.name) == None && sema_inference_type_mentions_param(declared, parameter.name) -> parameter
    if open.len() == 0 {
        return sema_expression_struct_field_value(field, field_value, field_reference_span, true, owner, names, sema_expression_struct_inferred_args(names, bindings), check)
    }
    sema_copy_site_check_field(field_value, check)
    checked: sema_check_expression_with_lambda_escapes(field_value, None, check, Val(true)) ?? return None
    ^inference: sema_inference_context(check.environment.module_identity, check.environment.package_identity, sema_inference_type_params(open), check.environment.generic_params, None)
    result: sema_infer_callable(check.program.registration_graph, inference, [Type]{declared}, None, [Type]{checked.ty}, [Type]{}, expr_span(field_value), check.diagnostics) ?? return None
    loop binding in result.substitutions -> bindings.push(binding)
    fact: sema_expression_struct_field_fact(field, owner, names, sema_expression_struct_inferred_args(names, bindings), check.environment.*, check.program.*, check.context)
    sema_expression_struct_field_finish(fact, checked, field_value, field_reference_span, true, owner, check)
}

// An omitted field's declared default. Written in another module, it checks in
// that module's names (sema_default_owner_scope); a problem it reports there is
// anchored at this literal.
sema_expression_struct_field_default: fn(field: Field, default_value: Expr, literal_span: Span, owner: Symbol, names: [String], args: [Type], check: ^SemaBodyCheck) -> TStructFieldValue? {
    ^owner_scope: sema_default_owner_scope(check, owner.module_identity, default_value)
    ^scope: owner_scope.move() ?? {
        return sema_expression_struct_field_value(field, default_value, field.name_span, false, owner, names, args, check)
    }
    // The default checks on a record of its own, linked to the owner
    // module's environment and holding the owner scope's state and table,
    // lent this record's context and tail store for the check.
    ^owner_check: sema_body_check_init(check.program, @scope.environment)
    sema_body_check_swap_state(owner_check, scope.state)
    sema_body_check_swap_scopes(owner_check, scope.scopes)
    sema_body_check_swap_context(owner_check, check.context)
    sema_body_check_swap_tail_store(owner_check, check.tail_store)
    checked: sema_expression_struct_field_value(field, default_value, field.name_span, false, owner, names, args, owner_check)
    sema_body_check_swap_tail_store(owner_check, check.tail_store)
    sema_body_check_swap_context(owner_check, check.context)
    loop diagnostic in owner_check.diagnostics {
        check.diagnostics.push(sema_default_use_site_diagnostic(diagnostic, literal_span))
    }
    checked
}

// A builtin Core record (`IOContext{...}`, `Tensor{...}`) has no Jet
// declaration; its literal checks against the generated Core record rows.
// A program declaration of the same name takes precedence.
sema_expression_core_record_name: fn(struct_name: String, type_args: [Type], expected: Type?, check: ^SemaBodyCheck) -> String? {
    if type_args.len() > 0 -> return None
    ^name: struct_name
    if name == "" {
        expected_ty: expected ?? return None
        name = if sema_expr_unwrap_tag(expected_ty) == {
            .Named(expected_name) -> expected_name
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
                return None
            }
        }
    }
    if core_record_literal_fields(name) == None -> return None
    if sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, name) != None {
        return None
    }
    Val(name)
}

sema_expression_core_record_field_value: fn(owner_name: String, field: TypeTupleField, field_value: Expr, check: ^SemaBodyCheck) -> TStructFieldValue? {
    sema_copy_site_check_field(field_value, check)
    checked: sema_check_expression_with_lambda_escapes(field_value, Val(field.ty), check, Val(true)) ?? return None
    if !sema_copy_site_check_guard_owned(checked, check, false) -> return None
    compatible: sema_expr_expected_assignable(field.ty, checked.ty, check.environment.*, check.program.*) ?? return None
    if !compatible {
        check.diagnostics.push(sema_type_mismatch(sema_expr_expected_type(field.ty, check.environment.*, check.program.*), sema_expr_expected_type(checked.ty, check.environment.*, check.program.*), expr_span(field_value), check.program.*))
        return None
    }
    if !sema_copy_site_record_move(field_value, "the struct literal", check) -> return None
    reference: TFieldRef{owner: None, name: field.name, ty: field.ty, boxed: false}
    Val(TStructFieldValue{field: reference, value: checked, boxed: false})
}

sema_expression_core_record_literal: fn(owner_name: String, fields: [ExprField], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    declared: core_record_literal_fields(owner_name) ?? return None
    // Only Core writes a Core-only record's fields, as only its type's module
    // writes a `priv` field, so a literal elsewhere gets the ordinary
    // private-field error: at the first field it writes, or for the first
    // field it leaves out.
    sealed: core_record_literal_is_core_only(owner_name) && !module_is_core(check.environment.module_identity) && !sema_expr_sees_private_fields(check.context)
    ^supplied: [Bool]{}
    loop _ in declared -> supplied.push(false)
    loop source in fields {
        ^found: -1
        loop (index, row) in declared {
            if row.name == source.name {
                found = index
                break
            }
        }
        if found < 0 {
            check.diagnostics.push(sema_error("E0302", source.name_span, "`{owner_name}` has no field `{source.name}`", "struct fields must be declared by the type", "use one of the declared field names"))
            return None
        }
        if sealed {
            check.diagnostics.push(sema_expression_private_field_error(source.name, source.name_span))
            return None
        }
        if supplied[found] {
            check.diagnostics.push(sema_error("E0105", source.name_span, "field `{source.name}` is supplied more than once", "each struct field receives one value", "remove the duplicate field"))
            return None
        }
        supplied[found] = true
    }
    if sealed && declared.len() > 0 {
        check.diagnostics.push(sema_expression_private_field_omitted_error(owner_name, declared[0].name, span))
        return None
    }
    missing: loop (index, row) in declared if !supplied[index] -> row.name
    if missing.len() > 0 {
        check.diagnostics.push(sema_expression_missing_fields("struct literal for `{owner_name}`", "every field must appear exactly once", missing, span))
        return None
    }
    // The rows spell Core's field types bare; they stay Core's beside a
    // program type of the same name (`AsyncPolicy.overflow` is core.event's
    // `Overflow`).
    ^values: [TStructFieldValue]{}
    loop source in fields {
        loop row in declared {
            if row.name != source.name -> next
            field: TypeTupleField{name: row.name, ty: sema_expr_core_row_type(row.ty, check.environment.*, check.program.*)}
            checked: sema_expression_core_record_field_value(owner_name, field, source.value, check) ?? return None
            values.push(checked)
            break
        }
    }
    value: sema_tree_node(Type.Named{name: owner_name}, TExprKind.StructLit{fields: values}, span)
    sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

// The `VJPRun<G>` a `compute.vjp` transform builds (`type_args` is `[G]`).
// Only the compiler writes one: `VJPRun` has no source literal, so the
// generated node is checked here, field by field against the run's rows.
sema_expression_vjp_run_literal: fn(type_args: [Type], fields: [ExprField], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if type_args.len() != 1 -> return None
    gradient: type_args[0]
    values: loop source in fields -> {
        ty: sema_expression_vjp_run_field(gradient, source.name) ?? return None
        checked: sema_expression_core_record_field_value("VJPRun", TypeTupleField{name: source.name, ty: ty}, source.value, check) ?? return None
        checked
    }
    value: sema_tree_node(Type.Apply{name: "VJPRun", args: [Type]{gradient}}, TExprKind.StructLit{fields: values}, span)
    sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

// A compiler record only the compiler writes, checked field by field
// against its Core record rows: the `CompilerRejection` a marker rule's
// `reject` returns (sema_call_check_marker_reject), and the CompilerCall,
// CompilerName, CompilerArg and SourceSpan a rule batch builds its heard
// calls from (sema_call_rule_batch_expression). None has a source literal.
sema_expression_compiler_record_literal: fn(owner: String, fields: [ExprField], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    values: loop source in fields -> {
        ty: core_record_field(owner, source.name) ?? return None
        checked: sema_expression_core_record_field_value(owner, TypeTupleField{name: source.name, ty: sema_expr_core_row_type(ty, check.environment.*, check.program.*)}, source.value, check) ?? return None
        checked
    }
    value: sema_tree_node(Type.Named{name: owner}, TExprKind.StructLit{fields: values}, span)
    sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

sema_expression_struct_literal: fn(struct_name: String, type_args: [Type], fields: [ExprField], inferred: Bool, as_trait: String?, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if inferred && as_trait == None && sema_expression_brace_record(fields, expected, check) {
        members: loop field in fields -> TupleField{name: field.name, value: field.value}
        return sema_expression_tuple(members, span, expected, check)
    }
    if !inferred && as_trait == None {
        head: if type_args.len() > 0 -> Type.Apply{name: struct_name, args: type_args} else -> Type.Named{name: struct_name}
        if sema_expression_variant_head(head, check) == .Val(variant_head) {
            enum_args: loop field in fields -> EnumLitArg.Named{label: field.name, expr: field.value}
            return sema_expression_enum_literal(variant_head.enum_name, type_args, variant_head.variant, enum_args, false, None, span, expected, check)
        }
    }
    if as_trait == None {
        core_record: sema_expression_core_record_name(struct_name, type_args, expected, check)
        if core_record == .Val(core_name) {
            return sema_expression_core_record_literal(core_name, fields, span, expected, check)
        }
    }
    resolved: sema_expression_struct_type(struct_name, type_args, expected, span, check.environment.*, check.program.*, check.scopes, check.diagnostics) ?? return None
    ^owner: resolved.owner
    check.context.name_references.push(sema_name_reference(span, owner, Val(SymbolKind.Type)))
    ^result_ty: resolved.ty
    // The struct's fields and type parameters, read at the declaration
    // without copying its methods.
    struct_def: sema_scope_declaration_struct(check.environment.*, check.program.*, owner.id) ?? {
        if sema_scope_declaration_kind(check, owner.id) == None {
            check.diagnostics.push(sema_error("E0119", span, "struct `{type_name(result_ty)}` has no declaration metadata", "a struct literal must check every declared field before lowering", "use a registered struct declaration"))
        } else {
            check.diagnostics.push(sema_error("E0119", span, "`{type_name(result_ty)}` is not a struct", "struct literal syntax only constructs struct declarations", "use the enum variant constructor for an enum"))
        }
        return None
    }
    names: loop parameter in struct_def.type_params -> parameter.name
    ^args: if result_ty == {
        .Apply(_, rows) -> rows
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> [Type]{}
    }
    // `Top{value: 1}` writes no type arguments and has none to take from an
    // expected type: its written fields infer them, as a call's arguments do.
    inferring: !inferred && type_args.len() == 0 && args.len() == 0 && names.len() > 0
    if args.len() != names.len() && !inferring {
        check.diagnostics.push(sema_error("E0104", span, "struct `{type_name(result_ty)}` has the wrong number of type arguments", "each declared type parameter needs one concrete argument", "provide one type argument for every generic parameter"))
        return None
    }
    ^supplied: [Bool]{}
    loop _ in struct_def.fields -> supplied.push(false)
    // Each written field's declaration index; fields are mostly written in
    // declaration order, so the one after the previous match is tried first.
    ^positions: [Int]{}
    ^computed_written: false
    loop source in fields {
        ^found: -1
        next_index: if positions.len() == 0 -> 0 else -> positions[positions.len() - 1] + 1
        if next_index < struct_def.fields.len() && struct_def.fields[next_index].name == source.name {
            found = next_index
        } else {
            loop (index, declared) in struct_def.fields {
                if declared.name == source.name {
                    found = index
                    break
                }
            }
        }
        if found < 0 {
            field_names: loop declared in struct_def.fields -> declared.name
            suggestion: sema_suggest_field(source.name, field_names)
            fix: if suggestion == .Val(near) -> "did you mean `{near}`?" else -> "remove this field"
            ^diagnostic: sema_error("E0303", source.name_span, "struct literal for `{struct_name}` has no field `{source.name}`", "struct literals may only set fields that exist on the type", fix)
            if suggestion == .Val(near) {
                diagnostic = diagnostic_with_edit(diagnostic, TextEdit{span: source.name_span, new_text: near})
            }
            check.diagnostics.push(diagnostic)
            return None
        }
        // A computed field is recomputed on every read, so a struct literal can
        // never give it a value.
        if struct_def.fields[found].computed != None {
            check.diagnostics.push(sema_error("E0339", source.name_span, "`{source.name}` is a computed field on `{type_name(result_ty)}` — it can't be set", "`{source.name}` is declared `{source.name} -> …` — its value always comes from that formula, never from a struct literal", "remove `{source.name}` from this `.{{ … }}`"))
            computed_written = true
            next
        }
        // Only the type's own module writes a `priv` field, so a literal
        // elsewhere cannot forge a value whose invariant that field carries.
        if !sema_expression_field_visible(struct_def.fields[found].is_pub, struct_def.fields[found].is_package_pub, owner.module_identity, struct_def.inline_module, source.name_span, sema_expr_sees_private_fields(check.context), check.environment.*, check.program.*) {
            check.diagnostics.push(sema_expression_private_field_error(source.name, source.name_span))
            return None
        }
        if supplied[found] {
            check.diagnostics.push(sema_error("E0303", source.name_span, "field `{source.name}` appears more than once", "each field may be written only once in a struct literal", "remove the duplicate field"))
            return None
        }
        supplied[found] = true
        positions.push(found)
    }
    // A literal that sets a computed field is refused, and it still names the
    // first `priv` field it leaves out: a forged handle (`FileLock{path: …}`)
    // reports both.
    if computed_written {
        loop (index, field) in struct_def.fields {
            if supplied[index] || field.computed != None -> next
            if !sema_expression_field_visible(field.is_pub, field.is_package_pub, owner.module_identity, struct_def.inline_module, span, sema_expr_sees_private_fields(check.context), check.environment.*, check.program.*) {
                check.diagnostics.push(sema_expression_private_field_omitted_error(struct_name, field.name, span))
                return None
            }
        }
        return None
    }
    // Supplied fields are checked (and their moves recorded) in the order they are
    // written, then omitted fields take their defaults in declaration order. The
    // checked tree keeps that order, so lowering evaluates the initializers exactly
    // as written. A non-generic struct's field facts are resolved once per check
    // (sema_expression_struct_field_facts).
    facts: if names.len() == 0 -> sema_expression_struct_field_facts(owner, struct_def.fields, check) else -> -1
    ^values: [TStructFieldValue]{}
    // Every written field is checked, so one literal reports all of its bad
    // values together.
    ^failed: false
    // The type arguments the written fields have inferred so far.
    ^bindings: [SemaInferenceBinding]{}
    loop (written, source) in fields {
        position: positions[written]
        ^checked: TStructFieldValue?{None}
        if facts >= 0 {
            fact: check.context.struct_field_facts[facts + position]
            checked = sema_expression_struct_field_checked(fact, source.value, source.name_span, true, owner, check)
        } else if inferring {
            checked = sema_expression_struct_field_inferred(struct_def.fields[position], source.value, source.name_span, owner, struct_def.type_params, bindings, check)
        } else {
            checked = sema_expression_struct_field_value(struct_def.fields[position], source.value, source.name_span, true, owner, names, args, check)
        }
        if checked == None {
            failed = true
            next
        }
        values.push(checked ?? return None)
    }
    if failed -> return None
    if inferring {
        loop parameter in sema_inference_type_params(struct_def.type_params) {
            binding: sema_inference_binding_at(bindings, parameter.name) ?? {
                sema_inference_unresolved_diagnostic(parameter, span, check.diagnostics)
                return None
            }
            args.push(binding.ty)
        }
        head: if result_ty == {
            .Named(name) -> name
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> type_name(result_ty)
        }
        result_ty = Type.Apply{name: head, args: args}
    }
    ^missing: [String]{}
    loop (index, field) in struct_def.fields {
        if supplied[index] || field.computed != None -> next
        // An omitted `priv` field is still written, by its default or not at
        // all, so only the type's own module may build the value.
        if !sema_expression_field_visible(field.is_pub, field.is_package_pub, owner.module_identity, struct_def.inline_module, span, sema_expr_sees_private_fields(check.context), check.environment.*, check.program.*) {
            check.diagnostics.push(sema_expression_private_field_omitted_error(struct_name, field.name, span))
            return None
        }
        default_value: field.default ?? {
            missing.push(field.name)
            next
        }
        checked: sema_expression_struct_field_default(field, default_value, span, owner, names, args, check) ?? return None
        values.push(checked)
    }
    if missing.len() > 0 {
        check.diagnostics.push(sema_expression_missing_fields("struct literal for `{struct_name}`", "every field without a `{{…}}` default must appear exactly once", missing, span))
        return None
    }
    ^value: sema_tree_node(result_ty, TExprKind.StructLit{fields: values}, span)
    if as_trait == .Val(trait_name) {
        trait_symbol_index: sema_scope_resolve_index(check.scopes, trait_name)
        if trait_symbol_index == None || check.scopes.bindings[trait_symbol_index ?? 0].symbol.kind != SymbolKind.Trait {
            check.diagnostics.push(sema_error("E0119", span, "`{trait_name}` is not a registered trait", "trait coercion must retain the target trait identity", "name a declared trait"))
            return None
        }
        trait_symbol: sema_scope_binding_symbol(check.environment.*, check.scopes, trait_symbol_index ?? 0)
        check.context.name_references.push(sema_name_reference(span, trait_symbol, Val(SymbolKind.Trait)))
        resolved_trait: sema_expr_expected_type(Type.Named{name: trait_name}, check.environment.*, check.program.*)
        target: if resolved_trait == {
            .TraitObject(_) -> resolved_trait
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> Type.TraitObject{bounds: [String]{trait_symbol.name}}
        }
        value = sema_tree_node(target, TExprKind.TraitBox{value: value, target: target}, span)
    }
    // An inferring literal checked against its own bare written head (`Top`,
    // a typed literal's head) has no arguments to check against.
    if inferring && expected == .Val(expected_ty) {
        if expected_ty == .Named(expected_name) && expected_name == struct_name {
            return Val(value.move())
        }
    }
    sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

// A headless `{name: value, …}` is a record, an unnamed struct, when its
// context names no struct: no expected type, or an expected record type. A
// lone pun `{x}` is never a record.
sema_expression_brace_record: fn(fields: [ExprField], expected: Type?, check: SemaBodyCheck) -> Bool Never! {
    if fields.len() == 0 -> return false
    if fields.len() == 1 && fields[0].value == .Ident(_, value_span, _) {
        if value_span.start == fields[0].name_span.start && value_span.end == fields[0].name_span.end {
            return false
        }
    }
    expected_ty: expected ?? return true
    sema_expr_unwrap_tag(sema_expr_expected_type(expected_ty, check.environment.*, check.program.*)) == .Tuple(_)
}

sema_expression_enum_literal: fn(type_name: String, type_args: [Type], variant: String, args: [EnumLitArg], leading_dot: Bool, variant_span: Span?, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    contextual_allowed: if {
        !leading_dot -> true
        else -> if sema_expr_unwrap_tag(expected ?? Type.Named{name: "Never"}) == {
            .Option(_) -> true
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
    }
    if type_name == "" && contextual_allowed && variant == "Val" && args.len() == 1 {
        if args[0] == {
            .Positional(value) -> return sema_expression_present(value, span, expected, check)
            .Named(_, _) -> {}
        }
    }
    if type_name == "" && contextual_allowed && variant == "None" && args.len() == 0 {
        return sema_expression_absent(span, expected, check.context, check.diagnostics)
    }
    // Leading-dot Result cases are contextual only when the expected type
    // is a Result; a declared enum's `.Ok` / `.Err` remains its own case.
    if type_name == "" && leading_dot && sema_expr_unwrap_tag(expected ?? Type.Named{name: "Never"}) == .Result(_, _) && args.len() == 1 {
        if args[0] == .Positional(value) {
            if variant == "Ok" {
                if sema_expression_unit_success_with_argument(value, expr_span(value), expected, check) {
                    return None
                }
                return sema_expression_result_payload(value, true, false, span, expected, check)
            }
            if variant == "Err" {
                check.context.failure_edges.push("")
                return sema_expression_result_payload(value, false, false, span, expected, check)
            }
        }
    }
    // `.Celsius(value)` where the expected union lists the named case
    // `Celsius(Float)` builds that case of the union.
    if type_name == "" && leading_dot {
        if sema_expression_union_case_payload(expected, variant) == .Val(payload_ty) {
            return sema_expression_union_case_literal(sema_expr_unwrap_tag(expected ?? Type.Named{name: "Never"}), variant, payload_ty, args, span, expected, check)
        }
    }
    ^resolved_name: type_name
    if resolved_name == "" {
        expected_ty: expected ?? {
            check.diagnostics.push(sema_expression_uninferable_case(variant, span, None, check))
            return None
        }
        normalized: sema_expr_unwrap_tag(expected_ty)
        resolved_name = if normalized == {
            .Named(name) -> name
            .Apply(name, _) -> name
            .Option(inner) -> if inner == {
                .Named(name) -> name
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ""
            }
            // A case that exactly one union member declares
            // builds that member.
            .Union(_) | .Case(_, _) -> sema_pattern_flat_union_owner_name(normalized, variant, check, span) ?? ""
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Quantity(_, _) | .Measure(_) -> ""
        }
        if resolved_name == "" {
            check.diagnostics.push(sema_expression_uninferable_case(variant, span, Val(normalized), check))
            return None
        }
    }
    // `ExactnessKind.Approximate` / `.Approximate` builds a
    // compiler-owned fact enum value, which has no registered declaration.
    fact_enum: sema_fact_enum_literal(resolved_name, variant, args, span, variant_span, expected, check)
    if fact_enum.handled -> return fact_enum.value
    // `HookDecision.Transform(value)` / `HookDecision.Continue`: the
    // compiler-owned generic hook decision takes its payload types from the
    // expected `HookDecision<T, E>`, as its patterns do (Patterns.jet).
    if resolved_name == "HookDecision" && sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, resolved_name) == None {
        return sema_expression_hook_decision_literal(variant, args, variant_span, span, expected, check)
    }
    // Compiler-owned data cases have no user enum declaration metadata.
    // Route both qualified and contextual cases through the same payload
    // checker as the static-call spelling.
    if sema_data_is_json_name(resolved_name) {
        if !sema_data_check_explicit_type_args(resolved_name, type_args, 0, span, check.diagnostics) {
            return None
        }
        call_args: loop argument in args -> {
            payload_expr: if argument == {
                .Positional(value) -> value
                .Named(_, _) -> {
                    check.diagnostics.push(sema_error("E0764", span, "variant `{variant}` takes a positional payload", "compiler-owned data cases do not have field labels", "pass the value without a label"))
                    return None
                }
            }
            CallArg{convention: AccessConvention.Read, expr: payload_expr, span: expr_span(payload_expr), flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
        }
        checked: sema_call_try_data_literal(Type.Named{name: resolved_name}, variant, call_args, span, expected, check)
        return checked.value
    }
    // A Core enum with no loaded declaration (`IOError`, a bare `Key`) builds
    // its variant from the Core enum rows.
    owner_symbol: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, resolved_name)
    if owner_symbol == None {
        ^core_variants: core_enum_payload_variants(resolved_name)
        if core_variants == None -> core_variants = core_enum_cases(resolved_name)
        if core_variants == .Val(variants) {
            // A Core enum is named the way user code writes it, by its type
            // name (`DataEvent`), never its module path.
            return sema_expression_core_enum_literal(resolved_name, core_module_type_leaf(resolved_name), variants, variant, args, variant_span, span, expected, check)
        }
    }
    if owner_symbol == .Val(core_owner) {
        if sema_expression_core_export_variants(check, core_owner) == .Val(variants) {
            check.context.name_references.push(sema_name_reference(span, core_owner, Val(SymbolKind.Type)))
            return sema_expression_core_enum_literal(core_owner.name, core_owner.name, variants, variant, args, variant_span, span, expected, check)
        }
    }
    if type_name == "" {
        inferred_owner: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, resolved_name)
        ^inferred_is_enum: false
        if inferred_owner == .Val(inferred_symbol) {
            inferred_is_enum = sema_scope_declaration_is(check, inferred_symbol.id, SemaScopeDeclarationKind.Enum)
        }
        if !inferred_is_enum {
            check.diagnostics.push(sema_error("E0330", span, "can't infer the enum type for `.{variant}`", "a leading-dot variant needs a known enum type from context", "write the full form `EnumName.{variant}`, or use it where its enum type is already expected"))
            return None
        }
    }
    owner: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, resolved_name) ?? {
        check.diagnostics.push(sema_expression_unknown_type(resolved_name, span, check.environment.*, check.program.*))
        return None
    }
    check.context.name_references.push(sema_name_reference(span, owner, Val(SymbolKind.Type)))
    // The enum's variants, groups and type parameters, read at the
    // declaration without copying its methods.
    if sema_scope_declaration_kind(check, owner.id) == None {
        check.diagnostics.push(sema_error("E0119", span, "enum `{resolved_name}` has no declaration metadata", "an enum constructor must check its variant payload", "use a registered enum declaration"))
        return None
    }
    enum_def: sema_scope_declaration_enum(check, owner.id) ?? {
        check.diagnostics.push(sema_error("E0119", span, "`{resolved_name}` is not an enum", "enum literal syntax only constructs enum declarations", "use a struct literal for a struct type"))
        return None
    }
    ^selected: Variant?{None}
    loop candidate in enum_def.variants {
        if candidate.name == variant {
            selected = Val(candidate)
            break
        }
    }
    selected_variant: selected ?? {
        // E0332: a group name in value position; a value is always a leaf.
        loop group in enum_def.groups {
            if group.path != variant -> next
            ^leaves: [String]{}
            loop candidate in enum_def.variants {
                if candidate.name.starts_with("{variant}.") {
                    leaves.push("`{resolved_name}.{candidate.name}`")
                }
            }
            check.diagnostics.push(sema_error("E0332", variant_span ?? span, "`{variant}` is a group, not a value", "a group names its whole subtree in patterns; an actual value is always a leaf variant", "pick a leaf: {leaves.join(", ")}"))
            return None
        }
        variant_names: loop candidate in enum_def.variants -> candidate.name
        check.diagnostics.push(sema_enum_unknown_variant(resolved_name, variant, variant_names, span, variant_span))
        return None
    }
    owner_key: sema_program_symbol_key(check.program.*, owner.id)
    variant_id: sema_symbol_id(check.program.*, check.context, SymbolKind.Variant, sema_scope_module_text(check.environment.*, check.program.*, owner.module_identity), owner_key, variant)
    variant_symbol: Symbol{id: variant_id, kind: SymbolKind.Variant, name: variant, module_identity: owner.module_identity, owner: Val(owner_key), span: selected_variant.name_span, ty: sema_registration_variant_type(selected_variant.payload), visibility: owner.visibility}
    check.context.name_references.push(sema_name_reference(variant_span ?? span, variant_symbol, Val(SymbolKind.Variant)))
    generic_names: loop parameter in enum_def.type_params -> parameter.name
    ^generic_args: type_args
    if generic_args.len() == 0 && expected == .Val(expected_ty) {
        normalized: sema_expr_unwrap_tag(expected_ty)
        if normalized == .Apply(name, rows) {
            if sema_expression_same_nominal_head(name, resolved_name, check.environment.*, check.program.*) {
                generic_args = rows
            }
        }
    }
    if generic_args.len() != generic_names.len() {
        check.diagnostics.push(sema_error("E0104", span, "enum `{resolved_name}` has the wrong number of type arguments", "each declared type parameter needs one concrete argument", "provide one type argument for every generic parameter"))
        return None
    }
    ^payload: TEnumPayload.Unit
    if selected_variant.payload == {
        .Unit -> {
            if args.len() != 0 {
                check.diagnostics.push(sema_enum_unit_payload(resolved_name, variant, span))
                return None
            }
        }
        .Single(ty, _) -> {
            if args.len() != 1 {
                check.diagnostics.push(sema_error("E0104", span, "variant `{variant}` expects one payload", "this enum variant has one positional field", "pass exactly one value"))
                return None
            }
            payload_expr: if args[0] == {
                // copy: `value` is a payload of read parameter `args`, which keeps the original; the assigned `payload_expr` owns this one
                .Positional(value) -> value.copy()
                .Named(_, _) -> {
                    check.diagnostics.push(sema_error("E0764", span, "variant `{variant}` takes a positional payload", "single-payload variants do not have field labels", "pass the value without a label"))
                    return None
                }
            }
            // As a struct field: the payload type names types as the enum's
            // module sees them.
            payload_ty: sema_inference_substitute_type(sema_expression_field_owner_type(check.environment.*, check.program.*, owner.module_identity, ty, generic_names), generic_names, generic_args)
            sema_copy_site_check_field(payload_expr, check)
            diagnostic_start: check.diagnostics.len()
            checked: sema_check_expression(payload_expr, Val(payload_ty), check) ?? {
                sema_expression_enum_payload_replace_mismatch(owner.name, variant, None, payload_ty, payload_expr, diagnostic_start, check)
                return None
            }
            if !sema_copy_site_check_guard_owned(checked, check, false) -> return None
            compatible: sema_expr_expected_assignable(payload_ty, checked.ty, check.environment.*, check.program.*) ?? return None
            if !compatible {
                check.diagnostics.push(sema_expression_enum_payload_mismatch(owner.name, variant, None, payload_ty, checked.ty, expr_span(payload_expr), check))
                return None
            }
            if !sema_copy_site_record_move(payload_expr, "the variant payload", check) {
                return None
            }
            payload = TEnumPayload.Positional{args: [TEnumArg]{TEnumArg{value: checked}}}
        }
        .Named(fields) -> {
            // Payload fields are checked and kept in the order they are
            // written; lowering evaluates them in that order and places each
            // into its declared slot afterwards.
            ^supplied: [Bool]{}
            loop _ in fields -> supplied.push(false)
            ^named_values: [TNamedEnumArg]{}
            // A field whose value does not fit its slot is reported and the
            // remaining fields are still checked, so every bad field reports.
            ^failed: false
            loop arg in args {
                ^label: ""
                ^payload_expr: Expr.Unit{span: span, id: AST_NODE_GENERATED}
                if arg == {
                    .Named(name, value) -> {
                        label = name
                        payload_expr = value
                    }
                    .Positional(_) -> {
                        labels: loop declared in fields -> declared.name
                        check.diagnostics.push(sema_expression_enum_named_positional(owner.name, variant, labels, span))
                        return None
                    }
                }
                ^found: -1
                loop (index, declared) in fields {
                    if declared.name == label {
                        found = index
                        break
                    }
                }
                if found < 0 {
                    labels: loop declared in fields -> declared.name
                    check.diagnostics.push(sema_expression_unknown_payload_label(variant, label, labels, args, payload_expr, check))
                    return None
                }
                if supplied[found] {
                    check.diagnostics.push(sema_error("E0105", expr_span(payload_expr), "variant field `{label}` is supplied more than once", "each enum payload field receives one value", "remove the duplicate field"))
                    return None
                }
                supplied[found] = true
                field_ty: sema_inference_substitute_type(sema_expression_field_owner_type(check.environment.*, check.program.*, owner.module_identity, fields[found].ty, generic_names), generic_names, generic_args)
                sema_copy_site_check_field(payload_expr, check)
                diagnostic_start: check.diagnostics.len()
                checked_value: sema_check_expression(payload_expr, Val(field_ty), check)
                if checked_value == None {
                    sema_expression_enum_payload_replace_mismatch(owner.name, variant, Val(label), field_ty, payload_expr, diagnostic_start, check)
                    failed = true
                    next
                }
                checked: checked_value
                if !sema_copy_site_check_guard_owned(checked, check, false) -> return None
                compatible: sema_expr_expected_assignable(field_ty, checked.ty, check.environment.*, check.program.*) ?? return None
                if !compatible {
                    check.diagnostics.push(sema_expression_enum_payload_mismatch(owner.name, variant, Val(label), field_ty, checked.ty, expr_span(payload_expr), check))
                    failed = true
                    next
                }
                if !sema_copy_site_record_move(payload_expr, "the variant payload", check) {
                    return None
                }
                named_values.push(TNamedEnumArg{name: label, value: TEnumArg{value: checked}})
            }
            missing: loop (index, was_supplied) in supplied if !was_supplied -> fields[index].name
            if missing.len() > 0 {
                check.diagnostics.push(sema_expression_missing_fields("variant `{variant}`", "every payload field must appear exactly once", missing, span))
                return None
            }
            if failed -> return None
            payload = TEnumPayload.Named{fields: named_values}
        }
    }
    // The written spelling may be an import alias. The result carries the
    // actual declaration owner's type, just as its payload field types do.
    declared_enum_ty: if generic_args.len() > 0 -> Type.Apply{name: owner.name, args: generic_args} else -> Type.Named{name: owner.name}
    enum_ty: sema_expression_field_owner_type(check.environment.*, check.program.*, owner.module_identity, declared_enum_ty, generic_names)
    payload_rows: body_flat_enum_payload(payload, check.context.arena)
    value: sema_node(check.context, enum_ty, NodeKind.EnumCtor{owner: owner.id, variant: variant_id, payload: payload_rows}, span)
    sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

// The parameters and result of a payload case's constructor value: one
// parameter per payload slot, labeled for a named payload ("" for a
// positional one), and the enum the call builds.
SemaEnumConstructorSignature: struct {
    labels: [String],
    params: [Type],
    result: Type,
}

// A qualified payload case read without a call (`Message.Text`) is its
// constructor as an ordinary capture-free function value, checked as the
// lambda that makes the call: `fn(String) -> Message`, or
// `fn(*, left: Int, right: Int) -> Message` for a named payload, whose labels
// stay label-only as a declared function's would. A payload the copy law
// can't copy out of a read parameter is taken (`fn(^^File) -> Message`), so
// the value fits only a slot that marks the take, as a named function with a
// `^^` parameter does (E0227). Unhandled, so the literal's own diagnostics
// apply, for a unit case, a case of no known enum, unknown type arguments,
// or an expected type that is no function.
sema_expression_enum_constructor_value: fn(path: SemaExpressionEnumPath, type_args: [Type], variant_span: Span, span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    unhandled: SemaMethodSpecialCheck{handled: false, value: None}
    if expected == .Val(required) {
        callable: if sema_expr_unwrap_tag(required) == .Fn(_, _, _, _, _, _) -> true else -> false
        if !callable -> return unhandled
    }
    signature: sema_expression_enum_constructor_signature(path, type_args, expected, check) ?? return unhandled
    conventions: loop ty in signature.params -> if sema_expression_enum_payload_taken(ty, check) -> AccessConvention.Move else -> AccessConvention.Read
    display: "{path.enum_name}.{path.variant}"
    if sema_expression_enum_constructor_unmarked(conventions, expected) == .Val(index) {
        check.diagnostics.push(sema_expression_enum_constructor_taken(display, signature.labels[index], signature.params[index], span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    params: loop (index, convention) in conventions -> LambdaParam{name: "__payload_{index}", name_span: variant_span, ty: None, ty_span: None, convention: convention}
    args: loop (index, label) in signature.labels -> if label == "" -> EnumLitArg.Positional{value: Expr.Ident{name: "__payload_{index}", span: variant_span, id: AST_NODE_GENERATED}} else -> EnumLitArg.Named{label: label, expr: Expr.Ident{name: "__payload_{index}", span: variant_span, id: AST_NODE_GENERATED}}
    body: Expr.EnumLit{type_name: path.enum_name, variant: path.variant, variant_span: Val(variant_span), args: args, leading_dot: false, span: span, id: AST_NODE_GENERATED}
    lambda: Lambda{take_names: [NamedSpan]{}, params: params, effects: None, body: LambdaBody.Expr{value: body}, span: span, meta: ast_empty_lambda_meta()}
    labeled: loop label in signature.labels {
        if label != "" {
            break true
        }
    } ?? false
    ^contract: [CallContractRow]?{None}
    if labeled {
        contract = Val(loop label in signature.labels -> CallContractRow{label: label, zone: ParamZone.LabelOnly})
    }
    taken: loop convention in conventions {
        if convention == AccessConvention.Move {
            break true
        }
    } ?? false
    // As in a written function type, only a taken parameter needs call
    // metadata, whose names repeat the contract's labels.
    ^metadata: FunctionCallMetadata?{None}
    if taken {
        metadata = Val(FunctionCallMetadata{
            names: signature.labels,
            defaults: loop _ in conventions -> FunctionDefaultRef?{None},
            variadic: loop _ in conventions -> false,
            conventions: conventions,
            policies: CallablePolicyChain{policies: [CallablePolicy]{}},
        })
    }
    // A slot whose function fails (`fn(Reply<R>) -> M E!`) takes the
    // constructor as it takes the lambda written there: of that failing form,
    // with a body that never fails.
    ^slot_err: Type?{None}
    if expected == .Val(required) {
        if sema_expr_unwrap_tag(required) == .Fn(_, .Val(slot_ret), _, _, _, _) {
            if sema_expr_unwrap_tag(slot_ret) == .Result(_, err) -> slot_err = Val(err)
        }
    }
    returned: if slot_err == .Val(err) -> Type.Result{ok: signature.result, err: err} else -> signature.result
    constructor_ty: Type.Fn{params: signature.params, ret: Val(returned), effect_bound: None, param_contract: contract, call_metadata: metadata, return_view_provenance: None}
    value: sema_check_expression(Expr.Lambda{lambda: lambda, id: AST_NODE_GENERATED}, Val(constructor_ty), check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// The constructor signature of payload case `path`, with the enum's type
// arguments written on the path or read from the expected function type's
// result. None for a unit case, a case of no known enum, or type arguments
// neither gives.
sema_expression_enum_constructor_signature: fn(path: SemaExpressionEnumPath, type_args: [Type], expected: Type?, check: ^SemaBodyCheck) -> SemaEnumConstructorSignature? {
    if sema_data_is_json_name(path.enum_name) -> return None
    owner: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, path.enum_name) ?? return sema_expression_core_constructor_signature(path.enum_name, path.variant)
    if sema_expression_core_export_variants(check, owner) != None {
        return sema_expression_core_constructor_signature(owner.name, path.variant)
    }
    enum_def: sema_scope_declaration_enum(check, owner.id) ?? return None
    ^selected: Variant?{None}
    loop candidate in enum_def.variants {
        if candidate.name == path.variant {
            selected = Val(candidate)
            break
        }
    }
    variant: selected ?? return None
    generic_names: loop parameter in enum_def.type_params -> parameter.name
    ^generic_args: type_args
    if generic_args.len() == 0 && expected == .Val(required) {
        normalized: sema_expr_unwrap_tag(required)
        if normalized == .Fn(_, ret, _, _, _, _) {
            // A function-typed parameter takes the failing form of its
            // result, whose success row is the enum.
            ^returned: sema_expr_unwrap_tag(ret ?? Type.Named{name: "Unit"})
            if returned == .Result(ok, _) -> returned = sema_expr_unwrap_tag(ok)
            if returned == .Apply(name, rows) {
                if sema_expression_same_nominal_head(name, path.enum_name, check.environment.*, check.program.*) {
                    generic_args = rows
                }
            }
        }
    }
    if generic_args.len() != generic_names.len() -> return None
    ^labels: [String]{}
    ^params: [Type]{}
    if variant.payload == {
        .Unit -> return None
        .Single(ty, _) -> {
            labels.push("")
            params.push(sema_inference_substitute_type(sema_expression_field_owner_type(check.environment.*, check.program.*, owner.module_identity, ty, generic_names), generic_names, generic_args))
        }
        .Named(fields) -> {
            loop field in fields {
                labels.push(field.name)
                params.push(sema_inference_substitute_type(sema_expression_field_owner_type(check.environment.*, check.program.*, owner.module_identity, field.ty, generic_names), generic_names, generic_args))
            }
        }
    }
    declared: if generic_args.len() > 0 -> Type.Apply{name: owner.name, args: generic_args} else -> Type.Named{name: owner.name}
    Val(SemaEnumConstructorSignature{labels: labels, params: params, result: sema_expression_field_owner_type(check.environment.*, check.program.*, owner.module_identity, declared, generic_names)})
}

// The constructor signature of a payload case of a Core enum with no loaded
// declaration, from the Core enum payload rows: one unlabeled slot per row
// type.
sema_expression_core_constructor_signature: fn(enum_name: String, variant: String) -> SemaEnumConstructorSignature? {
    params: core_enum_variant_payload(enum_name, variant) ?? return None
    if params.len() == 0 -> return None
    labels: loop _ in params -> ""
    Val(SemaEnumConstructorSignature{labels: labels, params: params, result: Type.Named{name: enum_name}})
}

// A payload slot the constructor takes: a complete type whose clone the copy
// law refuses can't be copied out of a read parameter into the variant.
sema_expression_enum_payload_taken: fn(ty: Type, check: SemaBodyCheck) -> Bool {
    if sema_ownership_type_is_copy(ty) || sema_copy_site_is_type_parameter(ty, check.context) {
        return false
    }
    facts: sema_copy_classify(ty, SemaCopyIntent.Clone, check.environment.*, check.program.*, check.context.generic_params, false)
    facts.complete && !facts.accepted
}

// The first taken payload slot when `expected` doesn't mark every slot the
// way the constructor does: a call through it would read the value the
// variant has to own. None when the constructor takes nothing.
sema_expression_enum_constructor_unmarked: fn(conventions: [AccessConvention], expected: Type?) -> Int? Never! {
    taken: loop (index, convention) in conventions {
        if convention == AccessConvention.Move {
            break index
        }
    } ?? return None
    if expected == .Val(required) {
        if sema_expr_unwrap_tag(required) == .Fn(_, _, _, _, metadata, _) && metadata == .Val(slot) && slot.conventions == conventions {
            return None
        }
    }
    Val(taken)
}

sema_expression_enum_constructor_taken: fn(display: String, label: String, ty: Type, span: Span) -> Diagnostic {
    slot: if label == "" -> "payload" else -> "payload field `{label}`"
    direct: if label == "" -> "{display}(…)" else -> "{display}{{…}}"
    sema_error("E0227", span, "`{display}` can't be used as a function value here because it takes its {slot} (`^^{type_name(ty)}`)", "`{type_name(ty)}` can't be copied out of a read parameter into the variant, so the constructor takes it, and a function type gives each parameter plain read access unless it marks a take (`fn(^^T)`)", "mark the parameter in the function type (`fn(^^{type_name(ty)})`), or build the case directly with `{direct}`")
}

// A variant of a Core enum without a loaded declaration: unit variants take no
// payload and payload variants take one positional value per row type.
sema_expression_core_enum_literal: fn(enum_name: String, display_name: String, variants: [String], variant: String, args: [EnumLitArg], variant_span: Span?, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    payload_types: core_enum_variant_payload(enum_name, variant) ?? {
        check.diagnostics.push(sema_enum_unknown_variant(enum_name, variant, variants, span, variant_span))
        return None
    }
    if payload_types.len() == 0 && args.len() != 0 {
        check.diagnostics.push(sema_enum_unit_payload(enum_name, variant, span))
        return None
    }
    sema_expression_core_enum_positional_literal(enum_name, display_name, variant, payload_types, Type.Named{name: enum_name}, args, span, expected, check)
}

// `HookDecision` is compiler-owned: core.event exports it as a generic leaf,
// but no Core source declares it, so its cases live here beside the decision
// hook checks that read them.
sema_expression_hook_decision_variants: fn(name: String) -> [String]? Never! {
    if name == "HookDecision" -> return Val([String]{"Continue", "Transform", "Cancel", "Fail"})
    None
}

// A `HookDecision` variant: `Transform` carries the hook's `T`, `Fail` its
// `E`, and the other two are unit. The decision type is the expected
// `HookDecision<T, E>` (a decision hook handler's result).
sema_expression_hook_decision_literal: fn(variant: String, args: [EnumLitArg], variant_span: Span?, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    variants: sema_expression_hook_decision_variants("HookDecision") ?? return None
    if !variants.contains(variant) {
        check.diagnostics.push(sema_enum_unknown_variant("HookDecision", variant, variants, span, variant_span))
        return None
    }
    ^type_args: [Type]{}
    if expected == .Val(wanted) {
        if sema_expr_unwrap_tag(wanted) == .Apply(name, found) && name == "HookDecision" && found.len() == 2 {
            type_args = found
        }
    }
    if type_args.len() != 2 {
        check.diagnostics.push(sema_error("E0330", span, "can't infer the decision type for `HookDecision.{variant}`", "a hook decision takes its value and failure types from the decision hook it answers", "return it from a `DecisionHook<T, E>` handler"))
        return None
    }
    ^payload_types: [Type]{}
    if variant == "Transform" -> payload_types.push(type_args[0])
    if variant == "Fail" -> payload_types.push(type_args[1])
    if payload_types.len() == 0 && args.len() != 0 {
        check.diagnostics.push(sema_enum_unit_payload("HookDecision", variant, span))
        return None
    }
    decision_ty: Type.Apply{name: "HookDecision", args: type_args}
    sema_expression_core_enum_positional_literal("HookDecision", "HookDecision", variant, payload_types, decision_ty, args, span, expected, check)
}

// The payload of the named case `variant` that the expected union lists.
sema_expression_union_case_payload: fn(expected: Type?, variant: String) -> Type? {
    wanted: expected ?? return None
    if sema_expr_unwrap_tag(wanted) == .Union(members) {
        loop member in members {
            if member == .Case(name, payload) && name == variant -> return Val(payload.copy())
        }
    }
    None
}

// `.Celsius(value)`: the named case `variant` of `union_ty`, whose one
// positional value checks against the case payload `payload_ty`.
sema_expression_union_case_literal: fn(union_ty: Type, variant: String, payload_ty: Type, args: [EnumLitArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if args.len() != 1 || args[0] == .Named(_, _) {
        check.diagnostics.push(sema_error("E0104", span, "case `{variant}` takes one value", "a named union case carries exactly one positional payload value", "write `.{variant}(value)`"))
        return None
    }
    sema_expression_core_enum_positional_literal("", type_name(union_ty), variant, [Type]{payload_ty}, union_ty, args, span, expected, check)
}

// The positional payload of a Core enum variant without a source
// declaration, checked against `payload_types`; the literal has `result_ty`.
sema_expression_core_enum_positional_literal: fn(enum_name: String, display_name: String, variant: String, payload_types: [Type], result_ty: Type, args: [EnumLitArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if args.len() != payload_types.len() {
        check.diagnostics.push(sema_error("E0104", span, "variant `{variant}` expects {payload_types.len()} payload values", "this Core enum variant has positional payload fields", "pass exactly {payload_types.len()} values"))
        return None
    }
    checked_args: loop (index, argument) in args -> {
        payload_expr: if argument == {
            .Positional(value) -> value
            .Named(_, _) -> {
                check.diagnostics.push(sema_error("E0764", span, "variant `{variant}` takes a positional payload", "Core enum payload values do not have field labels", "pass the value without a label"))
                return None
            }
        }
        payload_ty: payload_types[index]
        sema_copy_site_check_field(payload_expr, check)
        diagnostic_start: check.diagnostics.len()
        checked: sema_check_expression(payload_expr, Val(payload_ty), check) ?? {
            sema_expression_enum_payload_replace_mismatch(display_name, variant, None, payload_ty, payload_expr, diagnostic_start, check)
            return None
        }
        if !sema_copy_site_check_guard_owned(checked, check, false) -> return None
        compatible: sema_expr_expected_assignable(payload_ty, checked.ty, check.environment.*, check.program.*) ?? return None
        if !compatible {
            check.diagnostics.push(sema_expression_enum_payload_mismatch(display_name, variant, None, payload_ty, checked.ty, expr_span(payload_expr), check))
            return None
        }
        if !sema_copy_site_record_move(payload_expr, "the variant payload", check) -> return None
        TEnumArg{value: checked}
    }
    payload: if checked_args.len() == 0 -> TEnumPayload.Unit else -> TEnumPayload.Positional{args: checked_args}
    value: sema_tree_node(result_ty, TExprKind.EnumLit{enum_type: enum_name, variant: variant, payload: payload}, span)
    sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

// E0764: positional values for a named-payload variant. The fix spells the
// labeled construction (`View.Box{ width: …, height: … }`).
sema_expression_enum_named_positional: fn(owner: String, variant: String, labels: [String], span: Span) -> Diagnostic {
    fields: loop label in labels -> "{label}: …"
    sema_error("E0764", span, "variant `{variant}` needs named payload fields", "`{owner}.{variant}` declares labeled fields, so each value names the field it fills", "write `{owner}.{variant}{{ {fields.join(", ")} }}`")
}

// E0302 for a named payload label `label` that `variant` does not declare,
// reported at the label. When sema_payload_label_suggestion names one field,
// the edit renames the label; a label written alone (`{height}`) keeps its
// value's name by becoming `h: height`. A label the source holds in neither
// form keeps the report at its value, with no edit.
sema_expression_unknown_payload_label: fn(variant: String, label: String, declared: [String], args: [EnumLitArg], value: Expr, check: SemaBodyCheck) -> Diagnostic {
    written: loop declared_name in declared -> {
        ^found: false
        loop arg in args {
            if arg == .Named(name, _) {
                if name == declared_name -> found = true
            }
        }
        found
    }
    value_span: expr_span(value)
    label_span: sema_expression_payload_label_span(label, value_span, check)
    suggestion: sema_payload_label_suggestion(label, declared, written)
    fix: if suggestion == .Val(near) -> "did you mean `{near}`?" else -> "use a declared payload field"
    diagnostic: sema_error("E0302", label_span ?? value_span, "variant `{variant}` has no field `{label}`", "named enum payloads use the declaration's field names", fix)
    near: suggestion ?? return diagnostic
    at: label_span ?? return diagnostic
    new_text: if at == value_span -> "{near}: {label}" else -> near
    diagnostic_with_edit(diagnostic, TextEdit{span: at, new_text: new_text})
}

// The span of the `label` written just before `: value`, or the value's own
// span when the label is written alone and the value is the name it stands
// for. None when the source holds anything else there.
sema_expression_payload_label_span: fn(label: String, value_span: Span, check: SemaBodyCheck) -> Span? {
    graph: check.program.registration_graph
    caller: sema_scope_caller_index(check.environment.*, graph) ?? return None
    raw: graph.modules[caller].source.bytes()
    if value_span.start < 1 || value_span.end > raw.len() -> return None
    ^at: value_span.start - 1
    loop at > 0 && sema_stmt_ascii_space(raw[at]) -> at -= 1
    if raw[at] != (U8{58}) {
        if (sema_stmt_source_text(raw, value_span) ?? "") == label -> return Val(value_span)
        return None
    }
    at -= 1
    loop at > 0 && sema_stmt_ascii_space(raw[at]) -> at -= 1
    end: at + 1
    start: end - label.bytes().len()
    if start < 0 -> return None
    if (sema_stmt_source_text(raw, Span{start: start, end: end}) ?? "") != label -> return None
    Val(Span{start: start, end: end})
}

// E0330 for a leading-dot case `.variant` whose enum no expected type
// settles. The enums that declare the case are its candidates: the members of
// an expected union, or, with no expected type, the enums this module
// declares. Two or more make the case ambiguous. The edit writes the first
// candidate's name before the dot, and each other candidate is an
// alternative edit.
sema_expression_uninferable_case: fn(variant: String, span: Span, expected: Type?, check: SemaBodyCheck) -> Diagnostic {
    owners: sema_expression_case_owners(variant, span, expected, check)
    if owners.len() == 0 {
        return sema_error("E0330", span, "can't infer the enum type for `.{variant}`", "a leading-dot variant needs a known enum type from context", "write the full form `EnumName.{variant}`, or use it where its enum type is already expected")
    }
    written: loop owner in owners -> "`{owner}.{variant}`"
    named: loop owner in owners -> "`{owner}`"
    single: owners.len() == 1
    what: if single -> "can't infer the enum type for `.{variant}`" else -> "`.{variant}` could be a case of {named.join(" or ")}"
    why: if single -> "a leading-dot variant needs a known enum type from context" else -> "a leading-dot case names one enum, and nothing here picks one of the enums that declare `{variant}`"
    fix: if single -> "write the full form {written[0]}" else -> "write the enum name: {written.join(" or ")}"
    ^diagnostic: sema_error("E0330", span, what, why, fix)
    graph: check.program.registration_graph
    caller: sema_scope_caller_index(check.environment.*, graph) ?? return diagnostic
    raw: graph.modules[caller].source.bytes()
    if span.start < 0 || span.start >= raw.len() || raw[span.start] != (U8{46}) -> return diagnostic
    at: Span{start: span.start, end: span.start}
    diagnostic = diagnostic_with_edit(diagnostic, TextEdit{span: at, new_text: owners[0]})
    loop index in 1..<owners.len() {
        diagnostic = diagnostic_with_alternative_edit(diagnostic, TextEdit{span: at, new_text: owners[index]})
    }
    diagnostic
}

// The names of the enums a leading-dot `.variant` could build, in written
// order: the members of an expected union that declare the case, or, with no
// expected type, this module's enums that declare it. Empty when a candidate
// is declared in another module, whose name this module may write otherwise.
sema_expression_case_owners: fn(variant: String, span: Span, expected: Type?, check: SemaBodyCheck) -> [String] {
    ^owners: [String]{}
    graph: check.program.registration_graph
    caller: sema_scope_caller_index(check.environment.*, graph) ?? return owners
    if expected == .Val(carrier) {
        if carrier == .Union(members) {
            loop member in members {
                if sema_pattern_union_tag(members, member) == variant -> return [String]{}
                ^probe: [Diagnostic]{}
                if !sema_pattern_payload(member, variant, check.environment.*, check.program.*, span, probe).known {
                    next
                }
                owner: sema_pattern_nominal_row(graph, check.environment.module_identity, sema_pattern_unwrap_tags(member)) ?? return [String]{}
                if owner.module_index != caller -> return [String]{}
                owners.push(graph.modules[caller].nominals[owner.row].symbol.name)
            }
        }
        return owners
    }
    loop nominal in graph.modules[caller].nominals {
        if nominal.kind != SemaRegistrationNominalKind.Enum || nominal.compiler_owned -> next
        loop row in nominal.variants {
            if row.symbol.name == variant {
                owners.push(nominal.symbol.name)
                break
            }
        }
    }
    owners
}

// Every field a literal leaves out is named in one E0303 at the literal.
sema_expression_missing_fields: fn(what: String, why: String, missing: [String], span: Span) -> Diagnostic {
    listed: missing.join(", ")
    sema_error("E0303", span, "{what} is missing fields: {listed}", why, "add: {listed}")
}

// A payload value that doesn't fit its declared slot is E0108 about that slot
// (`field` names a labeled payload).
sema_expression_enum_payload_mismatch: fn(enum_name: String, variant: String, field: String?, declared: Type, offered: Type, span: Span, check: SemaBodyCheck) -> Diagnostic {
    required: sema_expr_expected_type(declared, check.environment.*, check.program.*)
    actual: sema_expr_expected_type(offered, check.environment.*, check.program.*)
    // A hook decision's payload is checked against the hook's declared payload or error type.
    if field == None && (enum_name == "HookDecision" || enum_name == "HookOutcome") && (variant == "Transform" || variant == "Continue" || variant == "Fail") {
        return sema_error("E0108", span, "`{enum_name}.{variant}` needs {sema_type_show(required)}, not {sema_type_show(actual)}", "the decision payload must match the hook's declared payload or error type", sema_type_fix_hint(required, actual))
    }
    slot: if field == .Val(label) -> "field `{label}` of `{enum_name}.{variant}`" else -> "the payload of `{enum_name}.{variant}`"
    sema_error("E0108", span, "{slot} holds {sema_type_show(required)}, but this value is {sema_type_show(actual)}", "a variant payload keeps the type its enum declaration gives it", sema_type_fix_hint(required, actual))
}

// The payload's own check rejected it against the declared slot with the
// generic E0108 at the value; that report becomes the payload-specific one,
// with the value's own type inferred without the slot as a target.
sema_expression_enum_payload_replace_mismatch: fn(enum_name: String, variant: String, field: String?, declared: Type, value: Expr, diagnostic_start: Int, check: ^SemaBodyCheck) {
    value_span: expr_span(value)
    mismatch_index: sema_value_mismatch_index(check.diagnostics, diagnostic_start, value_span) ?? return
    ^probe_diagnostics: [Diagnostic]{}
    offered: sema_probe_expression(value, None, check, probe_diagnostics) ?? return
    check.diagnostics[mismatch_index] = sema_expression_enum_payload_mismatch(enum_name, variant, field, declared, offered.ty, value_span, check)
}

sema_expression_typed_literal_printable_bound: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    graph: program.registration_graph
    sema_type_bound_satisfied_at(graph, ty, "Printable", sema_scope_caller_row(environment, graph), environment.generic_params) ?? false
}

// Whether a trait value prints when its box holds a `held`: a secret-bearing
// type never prints, any other prints as itself or through its display.
sema_expression_trait_held_printable: fn(held: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if sema_call_reflection_secret_bearing(held) -> return false
    sema_expression_typed_literal_printable(held, environment, program) || sema_call_reflection_is_displayable(held, environment, program)
}

sema_expression_typed_literal_printable: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if ty == {
        .Int | .IntN(_, _) | .Float | .Float32 | .Bool | .String | .Char | .Quantity(_, _) -> return true
        .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .Case(_, inner) | .InlineRange(inner, _, _) -> return sema_expression_typed_literal_printable(inner, environment, program)
        .Result(ok, err) -> return sema_expression_typed_literal_printable(ok, environment, program) && sema_expression_typed_literal_printable(err, environment, program)
        .Map(key, _, value) -> return sema_expression_typed_literal_printable(key, environment, program) && sema_expression_typed_literal_printable(value, environment, program)
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_expression_typed_literal_printable(field.ty, environment, program) {
                    return false
                }
            }
            return true
        }
        .Union(members) -> {
            loop member in members {
                if !sema_expression_typed_literal_printable(member, environment, program) {
                    return false
                }
            }
            return true
        }
        .TraitObject(bounds) -> {
            graph: program.registration_graph
            holders: sema_call_reflection_trait_holders(graph, bounds) ?? return false
            loop reference in holders.impls {
                if !sema_expression_trait_held_printable(graph.modules[reference.module_index].impls[reference.row].target_type, environment, program) {
                    return false
                }
            }
            loop reference in holders.nominals {
                if !sema_expression_trait_held_printable(graph.modules[reference.module_index].nominals[reference.row].ty, environment, program) {
                    return false
                }
            }
            return true
        }
        .Shared(_) | .Fn(_, _, _, _, _, _) | .Measure(_) -> return false
        .Named(name) -> {
            graph: program.registration_graph
            if sema_registration_unit_fact_for_type(graph, ty) != None -> return true
            loop row in sema_scope_checked_type_name_rows(environment, program, name) {
                if program.checked_types[row].single_use -> return false
                if program.checked_types[row].auto_printable -> return true
            }
            return sema_expression_typed_literal_printable_bound(ty, environment, program)
        }
        .Apply(name, args) -> {
            if name == "KeyRef" -> return true
            if name == "View" && args.len() == 1 && args[0] == (Type.Named{name: "str"}) {
                return true
            }
            loop argument in args {
                if !sema_expression_typed_literal_printable(argument, environment, program) {
                    return false
                }
            }
            return sema_expression_typed_literal_printable_bound(ty, environment, program)
        }
    }
    false
}

// `build` is set when the type assembles its literal from the parts and the
// encoded holes; without it the type is a `distinct String` and the literal
// is the joined text. `accepts` is set when the type judges each hole's type
// for its slot; without it every hole is accepted.
SemaExpressionCheckedTextTarget: struct {
    owner: Symbol,
    implementation_module_identity: ModuleID,
    check: SemaRegistrationFunction,
    encode_hole: SemaRegistrationFunction,
    build: SemaRegistrationFunction?,
    accepts: SemaRegistrationFunction?,
}

SemaExpressionCheckedTextLiteral: struct {
    handled: Bool,
    value: TExpr?,
}

// A boundary head the program has not imported (`DateTime`, or the `Path`
// runtime handle, which has no nominal row) is its owner module's impl. Once
// the registration index is built, only the graph's CheckedText impl rows
// (`checked_text_impl_rows`) are read, the rows the full scan would accept in
// the same order; a typed literal or static call of any other type then costs
// no walk of every impl.
sema_expression_checked_text_target: fn(head: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable) -> SemaExpressionCheckedTextTarget? {
    name: if head == {
        .Named(value) -> value
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
            return None
        }
    }
    graph: program.registration_graph
    ^owner: Symbol?{None}
    ^owner_row: SemaRegistrationRowRef?{None}
    ^identity_key: ""
    ^string_backed: false
    if sema_expression_type_symbol(scopes, environment, program, name) == .Val(symbol) {
        if symbol.kind != SymbolKind.Type -> return None
        if sema_type_graph_nominal_row(graph, symbol.id) == .Val(registered_row) {
            registered: graph.modules[registered_row.module_index].nominals[registered_row.row]
            owner = Val(registered.symbol)
            owner_row = Val(SemaRegistrationRowRef{module_index: registered_row.module_index, row: registered_row.row})
            identity_key = registered.identity_key
            if registered.kind == SemaRegistrationNominalKind.Distinct {
                definition: sema_registration_nominal_source_item(registered.source) ?? return None
                if definition == .Distinct(value) -> string_backed = value.base == Type.String
            }
        }
    }
    head_module: if owner == None -> boundary_head_owner_module(name) else -> None
    if owner == None && head_module == None -> return None
    if graph.impl_traits_indexed {
        loop impl_row in graph.checked_text_impl_rows {
            found: sema_expression_checked_text_impl_target(graph, impl_row.module_index, impl_row.row, owner, identity_key, name, head_module, string_backed) ?? next
            return Val(found)
        }
    } else {
        loop graph_module_index in 0..<graph.modules.len() {
            loop implementation_index in 0..<graph.modules[graph_module_index].impls.len() {
                if !sema_type_graph_is_checked_text_impl(graph, graph.modules[graph_module_index].impls[implementation_index]) {
                    next
                }
                found: sema_expression_checked_text_impl_target(graph, graph_module_index, implementation_index, owner, identity_key, name, head_module, string_backed) ?? next
                return Val(found)
            }
        }
    }
    // An `impl CheckedText { … }` block in the type's own body, whose
    // methods the nominal registers, unless a user trait shares the name.
    // A type with no such block is passed over without copying its blocks.
    if owner_row == .Val(registered_row) {
        registered: graph.modules[registered_row.module_index].nominals[registered_row.row]
        if registered.source == .SourceAST(item) {
            if !sema_registration_item_has_trait_block(item, "CheckedText") -> return None
            loop block in sema_registration_item_trait_blocks(item) {
                if block.trait_name != "CheckedText" || sema_type_graph_trait_symbol(graph, graph.modules[registered_row.module_index].module_identity, "CheckedText") != None {
                    next
                }
                ^check: SemaRegistrationFunction?{None}
                ^encode_hole: SemaRegistrationFunction?{None}
                ^build: SemaRegistrationFunction?{None}
                ^accepts: SemaRegistrationFunction?{None}
                loop method in registered.methods {
                    ^written: false
                    loop declared in block.methods {
                        if declared.span == method.declaration.span -> written = true
                    }
                    if !written -> next
                    if method.symbol.name == "check" -> check = Val(method)
                    if method.symbol.name == "encode_hole" -> encode_hole = Val(method)
                    if method.symbol.name == "build" -> build = Val(method)
                    if method.symbol.name == "accepts" -> accepts = Val(method)
                }
                if check != None && encode_hole != None && (string_backed || build != None) {
                    return Val(SemaExpressionCheckedTextTarget{
                        owner: registered.symbol,
                        implementation_module_identity: graph.modules[registered_row.module_index].module_identity,
                        check: check ?? return None,
                        encode_hole: encode_hole ?? return None,
                        build: build,
                        accepts: accepts,
                    })
                }
            }
        }
    }
    None
}

// The checked-text target CheckedText impl row `row` of module `module_index`
// gives the head `name`: the impl targets the head's nominal `owner` (by
// identity key, or by module and type name), or for a head with no nominal
// row, the type `name` in its boundary owner module `head_module`; and it
// writes `check` and `encode_hole`, and `build` unless the head is
// string-backed. None when the row is not the head's.
sema_expression_checked_text_impl_target: fn(graph: SemaRegistrationGraph, module_index: Int, row: Int, owner: Symbol?, identity_key: String, name: String, head_module: String?, string_backed: Bool) -> SemaExpressionCheckedTextTarget? {
    if owner == .Val(nominal) {
        if graph.modules[module_index].impls[row].target_identity_key != identity_key && (module_is_none(graph.modules[module_index].impls[row].target_module_identity) || graph.modules[module_index].impls[row].target_module_identity != nominal.module_identity || graph.modules[module_index].impls[row].target_type_name != nominal.name) {
            return None
        }
    } else {
        if module_is_none(graph.modules[module_index].impls[row].target_module_identity) || graph.modules[module_index].impls[row].target_type_name != name || head_module != Val((graph.modules[module_index].module_name)) {
            return None
        }
    }
    ^check: SemaRegistrationFunction?{None}
    ^encode_hole: SemaRegistrationFunction?{None}
    ^build: SemaRegistrationFunction?{None}
    ^accepts: SemaRegistrationFunction?{None}
    loop method_index in 0..<graph.modules[module_index].impls[row].methods.len() {
        if graph.modules[module_index].impls[row].methods[method_index].symbol.name == "check" {
            check = Val(graph.modules[module_index].impls[row].methods[method_index])
        }
        if graph.modules[module_index].impls[row].methods[method_index].symbol.name == "encode_hole" {
            encode_hole = Val(graph.modules[module_index].impls[row].methods[method_index])
        }
        if graph.modules[module_index].impls[row].methods[method_index].symbol.name == "build" {
            build = Val(graph.modules[module_index].impls[row].methods[method_index])
        }
        if graph.modules[module_index].impls[row].methods[method_index].symbol.name == "accepts" {
            accepts = Val(graph.modules[module_index].impls[row].methods[method_index])
        }
    }
    if check == None || encode_hole == None || (!string_backed && build == None) -> return None
    Val(SemaExpressionCheckedTextTarget{
        owner: owner ?? graph.modules[module_index].impls[row].symbol,
        implementation_module_identity: graph.modules[module_index].module_identity,
        check: check ?? return None,
        encode_hole: encode_hole ?? return None,
        build: build,
        accepts: accepts,
    })
}

sema_expression_checked_text_static_method_call: fn(receiver: Expr, method_name: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    type_name: if receiver == {
        .Ident(name, _, _) -> name
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
            return SemaMethodSpecialCheck{handled: false, value: None}
        }
    }
    target: sema_expression_checked_text_target(Type.Named{name: type_name}, check.environment.*, check.program.*, check.scopes) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    // A type that assembles itself through `build` is no String wrapper:
    // its other statics (`SQL.raw`) are its own ordinary methods. `build`
    // and `accepts` go straight to the impl, which a runtime handle has no
    // row to reach.
    if target.build != None && method_name != "check" && method_name != "encode_hole" && method_name != "build" && method_name != "accepts" {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    if method_name == "raw" {
        return sema_expression_checked_text_raw(target, type_name, method_span, args, expected, check)
    }
    function: if {
        method_name == "check" || method_name == "from" -> target.check
        method_name == "encode_hole" -> target.encode_hole
        method_name == "build" && target.build != None -> target.build ?? target.check
        method_name == "accepts" && target.accepts != None -> target.accepts ?? target.check
        else -> {
            return SemaMethodSpecialCheck{handled: false, value: None}
        }
    }
    if owner_type_args.len() > 0 {
        check.diagnostics.push(sema_error("E0119", method_span, "`{type_name}.{method_name}` has no owner type parameters", "CheckedText implementations target one concrete string-backed distinct type", "remove the explicit owner type arguments"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    // No written row takes CheckedText's `-[]>`; the effect check holds the
    // body to it (E0742).
    if !sema_owned_pure(function.declaration) {
        check.diagnostics.push(sema_error("E0907", method_span, "`{type_name}.{method_name}` must be pure", "CheckedText methods are evaluated through the canonical pure Source evaluator", "declare this CheckedText method pure"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    // Snapshot: a CheckedText method is evaluated from its registered
    // callable, and a lone program registers none.
    if check.program.registration_graph.mode == .Snapshot {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    direct: sema_call_direct_target_from_registration(function, check.program.registration_graph, check.environment.module_identity, check.environment.package_identity, check.environment.generic_params, type_args, method_span, check.diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    ^call_args: args
    if method_name == "from" {
        if args.len() != 1 {
            check.diagnostics.push(sema_error("E0103", method_span, "`{type_name}.from` takes exactly one String", "a checked text boundary receives one complete text value", "write `{type_name}.from(text)`"))
            loop argument in args -> ^_: sema_check_expression(argument.expr, None, check)
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        // `from(text)` is `check([text])`: the whole text is the one part.
        call_args = [CallArg]{sema_expression_checked_text_parts_arg([Expr]{args[0].expr.copy()}, args[0].span)}
    }
    ^call: Call{
        name: "{type_name}.{method_name}",
        name_span: method_span,
        type_args: type_args,
        args: call_args,
    }
    checked: sema_call_check_direct_target_owned(check, direct, call, [SemaCallDefaultValue]{}, if method_name == "from" -> None else -> expected) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    // The registered signature keeps its declared spelling (`-[]> String`
    // reads back as the named `String`) and the default failure route.
    hole_type: if checked.value.ty == {
        .Result(ok, _) -> ok
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> checked.value.ty
    }
    if method_name == "encode_hole" && target.build == None && hole_type != Type.String && hole_type != (Type.Named{name: "String"}) {
        check.diagnostics.push(sema_error("E0112", method_span, "a checked text hole encoder must return String", "every interpolation is passed through the type's pure `encode_hole` method before it reaches the checker", "make `encode_hole` return a String"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if (method_name == "check" || method_name == "from") && sema_expression_checked_text_result_types(checked.value.ty) == None {
        check.diagnostics.push(sema_error("E0907", method_span, "`{type_name}.check` must return `Checked<Shape, Slot>` with the type's `Error`", "the canonical CheckedText contract returns what it learned from the parts and reports rejection through its error result", "match the pure CheckedText.check signature"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    check.context.call_return_views.push(SemaCallReturnView{span: method_span, facts: checked.return_view_facts})
    if !sema_expr_record_call_fact(check, method_span, checked) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if method_name == "from" {
        value: sema_expression_checked_text_from(type_name, checked.value, method_span, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
    }
    SemaMethodSpecialCheck{handled: true, value: Val(checked.value)}
}

// Preserve the ordinary checker error while moving the original text into the
// nominal wrapper on success. The argument and the checker each execute once:
// `checked` is `Type.check([text])`, and the checker reads a copy of the
// bound text as its one part.
sema_expression_checked_text_from: fn(type_name: String, checked: TExpr, span: Span, check: ^SemaBodyCheck) -> TExpr? {
    error_type: if checked.ty == {
        .Result(_, error) -> error
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
            return None
        }
    }
    source_local: checked_generated_local("__checked_text_source_{span.start}", span, Type.String)
    error_local: checked_generated_local("__checked_text_error_{span.start}", span, error_type)
    source_value: sema_tree_node(Type.String, TExprKind.Local{local: source_local}, span)
    split: sema_expression_checked_text_split(checked, source_value, span, check) ?? return None
    nominal: Type.Named{name: type_name}
    result_type: Type.Result{ok: nominal, err: error_type}
    wrapped: sema_tree_node(nominal, TExprKind.DistinctCtor{argument: sema_tree_node(Type.String, TExprKind.Move{value: source_value}, span)}, span)
    err_pattern: TPattern{
        shape: TPatternShape.Err{binding: error_local.name, binding_span: span, inner: None, span: span},
        bindings: [TPatternBindingFact]{TPatternBindingFact{name: error_local.name, span: span, ty: error_type, mutable: false, symbol_id: None}},
        enum_type: None,
        position: TPatternPosition.Arm,
        mutable: false,
        boxed: false,
    }
    error_value: sema_tree_node(error_type, TExprKind.Local{local: error_local}, span)
    // An ordinary `if` on the checker's Err arm: the lowering already owns
    // pattern conditions, so the outcome needs no node of its own.
    outcome: sema_tree_node(
        result_type,
        TExprKind.IfExpr{
            cond: TIfCond.IfLet{pattern: err_pattern, subj: split.checker},
            then_body: [TStmt]{},
            then_value: sema_tree_node(result_type, TExprKind.Err{value: error_value}, span),
            else_body: [TStmt]{},
            else_value: sema_tree_node(result_type, TExprKind.Ok{value: wrapped}, span),
        },
        span,
    )
    Val(sema_tree_node(
        result_type,
        TExprKind.InlineBlock{
            body: [TStmt]{
                TStmt.Let{local: source_local, let_ty: TLetTy.Annotated{ty: Type.String, wrapper: TLetWrapper.Plain}, init: split.text, gc_promotion: None, gc_transferred: false, span: span},
                TStmt.ExprStmt{value: outcome, span: span},
            },
        },
        span,
    ))
}

// `Type.raw(text)` is the expert escape that wraps one
// audited String without running the declared checker, so it needs an
// audited `#Unsafe` region (E0387).
sema_expression_checked_text_raw: fn(target: SemaExpressionCheckedTextTarget, type_name: String, method_span: Span, args: [CallArg], expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    callee: "{type_name}.raw"
    if args.len() != 1 {
        check.diagnostics.push(sema_error("E0103", method_span, "`{callee}` takes exactly one String", "a checked text boundary receives one complete text value", "write `{callee}(text)`"))
        loop argument in args -> ^_: sema_check_expression(argument.expr, None, check)
    }
    if check.context.unsafe_depth == 0 {
        check.diagnostics.push(sema_error("E0387", method_span, "Checked text raw construction requires an audited `#Unsafe` region", "`Type.raw(text)` bypasses the declared CheckedText checker and is an expert-only escape", "Wrap the call in `#Unsafe(\"reason\") {{ … }}`, or use `Type.from(text)` for validation"))
    }
    if args.len() != 1 -> return SemaMethodSpecialCheck{handled: true, value: None}
    argument: sema_check_expression(args[0].expr, Val(Type.String), check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if argument.ty != Type.String {
        check.diagnostics.push(sema_type_mismatch(Type.String, argument.ty, expr_span(args[0].expr), check.program.*))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    params: [SemaCallParam]{SemaCallParam{label: "arg0", name: "arg0", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.String), variadic: false}}
    ^ownership_args: args
    ^ownership: sema_ownership_check_call_arguments(check.state, callee, params, ownership_args, check.scopes, check.diagnostics)
    if !ownership.accepted || !ownership.complete {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    constructed: sema_tree_node(Type.Named{name: type_name}, TExprKind.DistinctCtor{argument: argument}, method_span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(constructed, expected, check.environment.*, check.program.*, check.diagnostics)}
}

sema_expression_checked_text_literal: fn(head: Type, source_head: Type?, body: TypedLitBody, span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaExpressionCheckedTextLiteral {
    // Only a named head has a checked text target (sema_expression_checked_text_target).
    type_name: if head == .Named(name) -> name else -> {
        return SemaExpressionCheckedTextLiteral{handled: false, value: None}
    }
    target: sema_expression_checked_text_target(head, check.environment.*, check.program.*, check.scopes) ?? return SemaExpressionCheckedTextLiteral{handled: false, value: None}
    // A type with `build` is also an ordinary record: only a quoted body is
    // its checked literal, and `Query{text: …}` stays a struct literal.
    building: target.build != None
    if building {
        ^quoted: false
        if body == .Value(value) {
            if value == .Str(_, _, _) -> quoted = true
        }
        if !quoted -> return SemaExpressionCheckedTextLiteral{handled: false, value: None}
    }
    body_value: if body == {
        // copy: `value` is a payload of read parameter `body`, which keeps the original; the assigned `body_value` owns this one
        .Value(value) -> value.copy()
        .Fields(_) | .Elements(_) | .Entries(_) | .ByteText(_) | .Empty -> {
            check.diagnostics.push(sema_error("E0112", span, "`{type_name}{{ … }}` needs a string recipe body", "a checked text type is constructed from a quoted template, not another expression shape", "write `{type_name}{{\"…\"}}` with interpolation holes as needed"))
            return SemaExpressionCheckedTextLiteral{handled: true, value: None}
        }
    }
    parts: if body_value == {
        .Str(rows, _, _) -> rows
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
            check.diagnostics.push(sema_error("E0112", expr_span(body_value), "`{type_name}{{ … }}` needs a string recipe body", "a checked text type is constructed from a quoted template, not another expression shape", "write `{type_name}{{\"…\"}}` with interpolation holes as needed"))
            return SemaExpressionCheckedTextLiteral{handled: true, value: None}
        }
    }
    // The literal's pieces, the text between its holes (one more than the
    // holes), and its holes.
    ^holes: [Expr]{}
    body_span: expr_span(body_value)
    // A type with `build` checks the pieces, since its holes stay values. A
    // text kind checks its complete text, each hole encoded in the one
    // `TextSlot`, as its one part.
    ^check_parts: [Expr]{}
    if building {
        ^current: ""
        loop part in parts {
            if part == {
                .Lit(text) -> { current = "{current}{text}" }
                .Byte(value) -> { current = "{current}{sema_expr_byte_text(value)}" }
                .Interp(value, _) -> {
                    check_parts.push(sema_expression_checked_text_piece(current.move(), body_span))
                    current = ""
                    holes.push(value.copy())
                }
            }
        }
        check_parts.push(sema_expression_checked_text_piece(current.move(), body_span))
    } else {
        ^encoded_parts: [StrPart]{}
        loop part in parts {
            if part == {
                .Lit(_) -> { encoded_parts.push(part) }
                .Byte(value) -> { encoded_parts.push(StrPart.Lit{text: sema_expr_byte_text(value)}) }
                .Interp(value, _) -> {
                    holes.push(value.copy())
                    encoded_parts.push(StrPart.Interp{expr: sema_expression_checked_text_encoder(type_name, value, sema_expression_checked_text_text_slot(expr_span(value))), format: None})
                }
            }
        }
        check_parts.push(Expr.Str{parts: encoded_parts, span: body_span, id: AST_NODE_GENERATED})
    }
    check_call: sema_expression_checked_text_check_call(type_name, check_parts.move(), span)
    runtime_owner: sema_expr_runtime_body_owner(check)
    ^fact_start: check.context.call_facts.len()
    ^reference_start: check.context.name_references.len()
    // A built literal's check runs only while building: in run-time code its
    // pieces are constant, and the shape it returns lands as a value.
    staged: building && runtime_owner != None
    if staged -> check.scopes.comptime_execution_depth += 1
    // The literal consumes the checker's Result itself: the call root keeps
    // its carrier instead of propagating into the enclosing function.
    checked_value: sema_check_expression_carrier(check_call, None, check)
    if staged -> check.scopes.comptime_execution_depth -= 1
    checked: checked_value ?? return SemaExpressionCheckedTextLiteral{handled: true, value: None}
    ^direct: false
    if checked.kind == .Call(_, _, _) -> direct = true
    if !direct {
        check.diagnostics.push(sema_error("E0003", span, "the checked text checker call did not lower as a direct static call", "CheckedText methods are ordinary registered pure functions", "preserve the canonical registered call target"))
        return SemaExpressionCheckedTextLiteral{handled: true, value: None}
    }
    // In run-time code `accepts` judges each hole while building; a text
    // kind's holes all sit in `.Text`, so its answers need no landed check.
    if !building && runtime_owner == .Val(accepts_owner) {
        if sema_expression_checked_text_refused(type_name, target, holes, [TComptimeValue]{}, None, accepts_owner, span, check) {
            return SemaExpressionCheckedTextLiteral{handled: true, value: None}
        }
    }
    // A hole the compiler cannot know (a local, a parameter, a call) makes
    // the complete text a run-time value: it is built and checked when the
    // literal runs. Only constant holes are checked here, before the program runs.
    if !building && !sema_expression_checked_text_holes_constant(parts, check.scopes) {
        value: sema_expression_checked_text_runtime(head, target.owner.name, checked, span, check) ?? return SemaExpressionCheckedTextLiteral{handled: true, value: None}
        return SemaExpressionCheckedTextLiteral{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
    }
    // In run-time code the check is staged through the body comptime
    // evaluator, as a `#run` value is, and what it returns replaces the
    // check when the body is checked again.
    if runtime_owner == .Val(owner_key) {
        if sema_stmt_comptime_site_refused(check, fact_start) -> return SemaExpressionCheckedTextLiteral{handled: true, value: None}
        landed: sema_comptime_body_value_find(check.context, check.environment.module_identity, owner_key, span, span) ?? {
            _: sema_comptime_body_capture(check.context, check.environment.*, check.program.*, check.scopes, "{type_name} checked text literal", check_call, checked.ty, span, span)
            // The literal stands in until the shape lands; nothing lowers it.
            if !building -> return sema_expression_checked_text_distinct(head, checked, span, expected, check)
            return SemaExpressionCheckedTextLiteral{handled: true, value: sema_expression_checked_text_inline(type_name, check_call, holes, span, expected, check)}
        }
        types: sema_expression_checked_text_result_types(checked.ty) ?? return SemaExpressionCheckedTextLiteral{handled: true, value: None}
        hole_count: if building -> holes.len() else -> 0
        shape: sema_expression_checked_text_landed(type_name, landed.value.move(), checked.ty, hole_count, body_value, span, check) ?? return SemaExpressionCheckedTextLiteral{handled: true, value: None}
        if !building -> return sema_expression_checked_text_distinct(head, checked, span, expected, check)
        if sema_expression_checked_text_refused(type_name, target, holes, shape.slots, Val(types[1]), owner_key, span, check) {
            return SemaExpressionCheckedTextLiteral{handled: true, value: None}
        }
        return SemaExpressionCheckedTextLiteral{handled: true, value: sema_expression_checked_text_prepared(type_name, shape, types, holes, owner_key, span, expected, check)}
    }
    // Code that runs while building calls the check as it runs; the staged
    // request reports a rejection as E2712 at the literal.
    graph: check.program.registration_graph
    // A check whose Error is Never cannot reject the body, so it is not run.
    rejects: if checked.ty == .Result(_, failure) -> failure != (Type.Named{name: "Never"}) else -> true
    if rejects {
        ^functions: sema_comptime_reachable_function_keys(graph, check.context.call_facts)
        ^reachable: [String]{}
        loop key in functions {
            id: symbol_find(graph.symbols, key) ?? next
            ^fact_index: fact_start
            loop fact_index < check.context.call_facts.len() {
                callee: check.context.call_facts[fact_index].callee
                if callee == .Val(symbol) && symbol == id {
                    reachable.push(key)
                    break
                }
                fact_index += 1
            }
        }
        loop method_key in
            ([String]{symbol_table_key(graph.symbols, target.check.symbol.id), symbol_table_key(graph.symbols, target.encode_hole.symbol.id)}) {
            if !reachable.contains(method_key) -> reachable.push(method_key)
        }
        ^dependencies: [String]{}
        loop reference_index in reference_start..<check.context.name_references.len() {
            ^reference: check.context.name_references[reference_index]
            if reference.symbol.kind != SymbolKind.Constant -> next
            dependency: sema_registration_symbol_key(graph, reference.symbol.id)
            if dependency != "" && !dependencies.contains(dependency) {
                dependencies.push(dependency)
            }
        }
        ^source_file: sema_source_file_at(check.environment.source_segments, check.environment.source_file, check.environment.source_origin, span)
        key: "{module_text(graph.module_table, check.environment.module_identity)}.checked-text.{symbol_table_key(graph.symbols, target.owner.id)}.{span.start}:{span.end}:{type_identity_key(head)}"
        ^evaluation: SemaCheckedTextEvaluation{
            module_identity: check.environment.module_identity,
            key: key,
            type_name: type_name,
            source_file: source_file,
            source_expression: Expr.TypedLit{head: source_head, body: body, span: span, id: AST_NODE_GENERATED},
            expression: sema_publish_expression(checked, check.program.*, check.context),
            ty: checked.ty,
            reachable_function_keys: reachable,
            dependencies: dependencies,
            span: span,
            code: "E2712",
            what: SEMA_CHECKED_TEXT_REJECTED_WHAT,
            fix: SEMA_CHECKED_TEXT_REJECTED_FIX,
        }
        check.context.comptime_requests.push(
            SemaComptimeRequest{
                callee_key: symbol_table_key(graph.symbols, target.check.symbol.id),
                module_identity: target.implementation_module_identity,
                args: [TComptimeValue]{},
                span: span,
                checked_text: Val(evaluation),
            },
        )
    }
    if !building -> return sema_expression_checked_text_distinct(head, checked, span, expected, check)
    SemaExpressionCheckedTextLiteral{handled: true, value: sema_expression_checked_text_inline(type_name, check_call, holes, span, expected, check)}
}

// What a refused checked text literal reports (E2712) for an error that
// implements no `Diagnostic` (sema_checked_text_reports): its Why is the
// error when that is text, else this one.
SEMA_CHECKED_TEXT_REJECTED_WHAT: "this checked text type rejected its body"
SEMA_CHECKED_TEXT_REJECTED_WHY: "the type's pure `CheckedText.check` method must accept the complete literal body"
SEMA_CHECKED_TEXT_REJECTED_FIX: "fix the body so it satisfies the type's declared text grammar"

// The locals a built literal's landed shape and slots are read through.
SEMA_CHECKED_TEXT_SHAPE_LOCAL: "__checked_text_shape"
SEMA_CHECKED_TEXT_SLOT_LOCAL: "__checked_text_slot_"
// The local an inline built literal binds its accepted check to.
SEMA_CHECKED_TEXT_CHECKED_LOCAL: "__checked_text_checked"
// The locals a hole's staged `accepts` reads its slot and its type through.
SEMA_CHECKED_TEXT_ACCEPTS_SLOT_LOCAL: "__checked_text_accepts_slot"
SEMA_CHECKED_TEXT_ACCEPTS_HOLE_LOCAL: "__checked_text_accepts_hole"
// What a refused hole's report (E2715) asks for.
SEMA_CHECKED_TEXT_HOLE_SLOT_FIX: "pass a value of a type this place accepts, or move the hole to a place that accepts its type"

// What a refused check reports: its error, or each item of an error type
// that is a list, at the spot its `at: TextSpot` names in the quoted body of
// `literal` (sema_checked_text_spot_span), else at `span`. An item whose type
// implements `Diagnostic`, each text one literal over `self` fields, reports
// under the impl's code (sema_derive_report_diagnostic); an item of an enum
// whose case holds one value whose type implements it reports that value so
// (sema_checked_text_case_reports); any other reports `code` with `what` and
// `fix`, its Why the item when that is text, else
// SEMA_CHECKED_TEXT_REJECTED_WHY. `result` is the check's Result type.
sema_checked_text_reports: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, result: Type, literal: Expr, report: TComptimeReport, span: Span, code: String, what: String, fix: String) -> [Diagnostic] Never! {
    ^reports: [Diagnostic]{}
    ^diagnostic: SemaDeriveReport?{None}
    ^cases: [SemaCheckedTextCaseReport]{}
    ^listed: false
    if result == .Result(_, error_type) {
        diagnostic = sema_type_diagnostic_report(graph, error_type, module_identity)
        cases = sema_checked_text_case_reports(graph, error_type, module_identity)
        if error_type == .List(item_type) {
            listed = true
            diagnostic = sema_type_diagnostic_report(graph, item_type, module_identity)
            cases = sema_checked_text_case_reports(graph, item_type, module_identity)
        }
    }
    if report == .Told(error) && listed && error == .List(items) {
        loop item in items -> reports.push(sema_checked_text_item_report(graph, module_identity, diagnostic, cases, literal, item, span, code, what, fix))
    }
    if report == .Told(error) && !listed -> reports.push(sema_checked_text_item_report(graph, module_identity, diagnostic, cases, literal, error, span, code, what, fix))
    if reports.len() == 0 -> reports.push(sema_error(code, span, what, SEMA_CHECKED_TEXT_REJECTED_WHY, fix))
    reports
}

// The `Diagnostic` impl that reports the one value an error enum's case
// `variant` holds.
SemaCheckedTextCaseReport: struct {
    variant: String,
    report: SemaDeriveReport,
}

// For an enum `error_type` read from `module_identity`, the `Diagnostic`
// impl of each case that holds one value of a type that has one; none for
// any other type.
sema_checked_text_case_reports: fn(graph: SemaRegistrationGraph, error_type: Type, module_identity: ModuleID) -> [SemaCheckedTextCaseReport] Never! {
    ^cases: [SemaCheckedTextCaseReport]{}
    owner: sema_type_resolve_nominal_row(graph, error_type, module_identity) ?? return cases
    source: sema_registration_nominal_source_item(graph.modules[owner.module_index].nominals[owner.row].source) ?? return cases
    if source == .Enum(definition) {
        // A case's payload type resolves from the module that declares the enum.
        declaring: graph.modules[owner.module_index].module_identity
        loop variant in definition.variants {
            if variant.payload == .Single(ty, _) {
                report: sema_type_diagnostic_report(graph, ty, declaring) ?? next
                cases.push(SemaCheckedTextCaseReport{variant: variant.name.copy(), report: report})
            }
        }
    }
    cases
}

// The report of one error `item` of a refused check (sema_checked_text_reports).
sema_checked_text_item_report: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, diagnostic: SemaDeriveReport?, cases: [SemaCheckedTextCaseReport], literal: Expr, item: TComptimeValue, span: Span, code: String, what: String, fix: String) -> Diagnostic Never! {
    if item == .Enum(_, variant, args) && args.len() == 1 {
        loop case in cases {
            if case.variant == variant {
                return sema_checked_text_item_report_with_derive(graph, module_identity, case.report, literal, args[0].value, span, code, what, fix)
            }
        }
    }
    if diagnostic == .Val(found) {
        return sema_checked_text_item_report_with_derive(graph, module_identity, found, literal, item, span, code, what, fix)
    }
    at: sema_checked_text_spot_span(graph, module_identity, literal, item) ?? span
    if item == .String(text) -> return sema_error(code, at, what, text, fix)
    sema_error(code, at, what, SEMA_CHECKED_TEXT_REJECTED_WHY, fix)
}

sema_checked_text_item_report_with_derive: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, found: SemaDeriveReport, literal: Expr, item: TComptimeValue, span: Span, code: String, what: String, fix: String) -> Diagnostic Never! {
    at: sema_checked_text_spot_span(graph, module_identity, literal, item) ?? span
    if sema_user_template_ct_value(item) == .Val(value) {
        ^texts: [String]{}
        loop name in ([String]{"what", "why", "fix"}) {
            if sema_derive_report_text(found.definition, name, value) == .Val(text) -> texts.push(text)
        }
        if texts.len() == 3 -> return sema_derive_report_diagnostic(found, at, texts)
    }
    if item == .String(text) -> return sema_error(code, at, what, text, fix)
    sema_error(code, at, what, SEMA_CHECKED_TEXT_REJECTED_WHY, fix)
}

// The `Shape` and `Slot` of a check's `Checked<Shape, Slot> Error!` result,
// or None when `ty` is not that result.
sema_expression_checked_text_result_types: fn(ty: Type) -> [Type]? Never! {
    if sema_expr_unwrap_tag(ty) == .Result(ok, _) {
        if sema_expr_unwrap_tag(ok) == .Apply(name, args) {
            if (name == "Checked" || name == "core.prelude.Checked" || name == "<corelib>/core.prelude.Checked") && args.len() == 2 -> return Val(args.copy())
        }
    }
    None
}

// What a built literal's check returned: its shape and one slot per hole.
SemaExpressionCheckedTextShape: struct {
    shape: TComptimeValue,
    slots: [TComptimeValue],
}

// The landed value of a literal's staged check: a rejection reports what
// its error gives (sema_checked_text_reports); an accepted `Checked` record
// gives its shape and its slots, one per hole. `result` is the check's
// Result type and `literal` the literal's quoted body.
sema_expression_checked_text_landed: fn(type_name: String, value: ^^TComptimeValue, result: Type, hole_count: Int, literal: Expr, span: Span, check: ^SemaBodyCheck) -> SemaExpressionCheckedTextShape? {
    if value == .Failed(report) {
        check.diagnostics.extend(sema_checked_text_reports(check.program.registration_graph, check.environment.module_identity, result, literal, report, span, "E2712", SEMA_CHECKED_TEXT_REJECTED_WHAT, SEMA_CHECKED_TEXT_REJECTED_FIX))
        return None
    }
    ^shape: TComptimeValue?{None}
    ^slots: [TComptimeValue]?{None}
    // An accepted check's `Ok` lands as `.Present`.
    accepted: if value == {
        .Present(inner) -> inner
        .Int(_) | .Float(_, _) | .Bool(_) | .Char(_) | .String(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Failed(_) | .Unit | .Function(_) -> value
    }
    if accepted == .Struct(_, fields) {
        ^remaining: fields
        loop remaining.len() > 0 {
            field: remaining.pop() ?? break
            if field.name == "shape" -> shape = Val(field.value)
            if field.name == "slots" {
                if field.value == .List(values) -> slots = Val(values)
            }
        }
    }
    found_shape: shape ?? {
        check.diagnostics.push(sema_error("E0003", span, "the staged `{type_name}.check` landed no `Checked` shape", "an accepted check returns `Checked{{shape, slots}}`", "preserve the check's landed value"))
        return None
    }
    found_slots: slots ?? {
        check.diagnostics.push(sema_error("E0003", span, "the staged `{type_name}.check` landed no `Checked` slots", "an accepted check returns `Checked{{shape, slots}}`", "preserve the check's landed value"))
        return None
    }
    if found_slots.len() != hole_count {
        check.diagnostics.push(sema_error("E2712", span, "`{type_name}.check` gave {found_slots.len()} slots for {hole_count} holes", "`check` returns one slot per hole, the kind of position the hole sits in", "return one slot in `Checked.slots` for each hole between the parts"))
        return None
    }
    Val(SemaExpressionCheckedTextShape{shape: found_shape, slots: found_slots})
}

// A spot a check's error names in its literal: the body part it is in (0
// for the first) and the byte offset inside that part's text.
SemaCheckedTextSpot: struct {
    part: Int,
    offset: Int,
}

// The source span an error item of a check's refusal points at in its
// literal: the item's `at: TextSpot` (core.grammar), read through the
// written body of `literal` (`Type{"…"}`, or its quoted body) the way the
// lexer reads a typed head's body. None when the item names no spot, the
// module's source is not the text its spans index, or the spot is not in
// the written text: a text kind's one part is its joined text, whose
// offsets past its first hole count encoded hole text.
sema_checked_text_spot_span: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, literal: Expr, item: TComptimeValue) -> Span? {
    spot: sema_checked_text_spot(item) ?? return None
    ^hole_ends: [Int]{}
    body: sema_checked_text_quoted_body(literal, hole_ends) ?? return None
    row: sema_registration_module_index(graph, module_identity) ?? return None
    source_row: sema_span_source_row(graph, row)
    if source_row < 0 -> return None
    sema_checked_text_spot_at(graph.modules[source_row].source.bytes(), body, hole_ends, spot)
}

// The span of the quoted body of `literal`, with the end of each hole's
// value pushed to `hole_ends`.
sema_checked_text_quoted_body: fn(literal: Expr, hole_ends: ^[Int]) -> Span? Never! {
    if literal == .TypedLit(_, written, _, _) && written == .Value(value) -> return sema_checked_text_quoted_body(value, hole_ends)
    if literal == .Str(parts, span, _) {
        loop part in parts {
            if part == .Interp(value, _) -> hole_ends.push(expr_span(value).end)
        }
        return Val(span)
    }
    None
}

// The `at: TextSpot` of an error item.
sema_checked_text_spot: fn(item: TComptimeValue) -> SemaCheckedTextSpot? Never! {
    if item == .Struct(_, fields) {
        loop field in fields {
            if field.name != "at" -> next
            if field.value == .Struct(spot_type, spot_fields) && (spot_type == "TextSpot" || spot_type.ends_with(".TextSpot")) {
                ^part: -1
                ^offset: -1
                loop spot_field in spot_fields {
                    if spot_field.name == "part" && spot_field.value == .Int(value) -> part = value
                    if spot_field.name == "offset" && spot_field.value == .Int(value) -> offset = value
                }
                if part >= 0 && offset >= 0 -> return Val(SemaCheckedTextSpot{part: part, offset: offset})
            }
        }
    }
    None
}

// Byte `at` of `bytes`, -1 past either end.
sema_checked_text_byte: fn(bytes: [U8], at: Int) -> Int Never! {
    if at < 0 || at >= bytes.len() -> return -1
    Int{bytes[at]}
}

// The span of `spot` in the quoted body written at `body` of `bytes`, whose
// holes end where `hole_ends` say. It reads the body as the lexer reads a
// typed head's (decode_string, decode_string_content): a triple-quoted
// body drops its opening and closing lines and the closing line's indent
// from each line, `{{` and `}}` are one brace, a backslash stays as
// written, a `\${…}` payload is copied byte for byte, and a hole ends one
// part, the next starting after its `}`.
sema_checked_text_spot_at: fn(bytes: [U8], body: Span, hole_ends: [Int], spot: SemaCheckedTextSpot) -> Span? Never! {
    if body.end > bytes.len() || body.end - body.start < 2 || sema_checked_text_byte(bytes, body.start) != 34 -> return None
    triple: body.end - body.start >= 6 && sema_checked_text_byte(bytes, body.start + 1) == 34 && sema_checked_text_byte(bytes, body.start + 2) == 34
    ^content_start: body.start + 1
    ^content_end: body.end - 1
    ^indent: 0
    if triple {
        open_end: body.start + 3
        close: body.end - 3
        ^close_line_start: close
        loop close_line_start > open_end && sema_checked_text_byte(bytes, close_line_start - 1) != 10 -> close_line_start -= 1
        ^only_indent: true
        loop at in close_line_start..<close {
            if sema_checked_text_byte(bytes, at) != 32 && sema_checked_text_byte(bytes, at) != 9 -> only_indent = false
        }
        if only_indent -> indent = close - close_line_start
        content_start = open_end
        ^line_end: open_end
        loop line_end < close && sema_checked_text_byte(bytes, line_end) != 10 -> line_end += 1
        if line_end < close -> content_start = line_end + 1
        content_end = close_line_start
        if content_end > content_start && sema_checked_text_byte(bytes, content_end - 1) == 10 -> content_end -= 1
        if content_end < content_start -> content_end = content_start
    }
    ^cursor: content_start
    ^at_line_start: triple
    ^part: 0
    ^offset: 0
    ^hole: 0
    ^payload: 0
    loop cursor < content_end {
        if at_line_start {
            ^stripped: 0
            loop stripped < indent && cursor < content_end && (sema_checked_text_byte(bytes, cursor) == 32 || sema_checked_text_byte(bytes, cursor) == 9) {
                cursor += 1
                stripped += 1
            }
            at_line_start = false
            if cursor >= content_end -> break
        }
        if part == spot.part && offset == spot.offset -> return Val(sema_checked_text_spot_char(bytes, cursor, body.end))
        value: sema_checked_text_byte(bytes, cursor)
        following: sema_checked_text_byte(bytes, cursor + 1)
        ^text_width: 1
        ^source_width: 1
        if {
            payload > 0 -> {
                if value == 123 -> payload += 1
                if value == 125 -> payload -= 1
            }
            value == 10 -> {
                if triple -> at_line_start = true
            }
            value == 92 && (following == 34 || following == 92) -> {
                text_width = 2
                source_width = 2
            }
            (value == 123 || value == 125) && following == value -> {
                source_width = 2
            }
            value == 123 && sema_checked_text_byte(bytes, cursor - 1) == 36 && sema_checked_text_byte(bytes, cursor - 2) == 92 -> {
                payload = 1
            }
            value == 123 -> {
                if hole >= hole_ends.len() -> return None
                ^close: hole_ends[hole]
                loop close < content_end && sema_checked_text_byte(bytes, close) != 125 -> close += 1
                hole += 1
                part += 1
                offset = 0
                cursor = close + 1
                next
            }
            else -> {}
        }
        if part == spot.part && spot.offset > offset && spot.offset < offset + text_width {
            return Val(sema_checked_text_spot_char(bytes, cursor + spot.offset - offset, body.end))
        }
        offset += text_width
        cursor += source_width
    }
    if part == spot.part && offset == spot.offset -> return Val(sema_checked_text_spot_char(bytes, cursor, body.end))
    None
}

// The one character of `bytes` at `at` as a span, no further than `end`.
sema_checked_text_spot_char: fn(bytes: [U8], at: Int, end: Int) -> Span Never! {
    lead: sema_checked_text_byte(bytes, at)
    width: if {
        lead >= 240 -> 4
        lead >= 224 -> 3
        lead >= 192 -> 2
        else -> 1
    }
    Span{start: at, end: if at + width > end -> end else -> at + width}
}

// `accepts`, when the literal's type declares it, judges each hole while
// building: given the slot the hole sits in (`slots[i]`, or `.Text` for a
// text kind, whose `slots` is empty) and the TypeId of the hole's type. Each
// call is staged through the body comptime evaluator, as the check is, at
// the hole's own place, with the slot and the TypeId as prepared locals; a
// reason it gives is E2715 at the hole. True when an answer refused its
// hole. A hole whose type names a type parameter is judged by no answer
// here.
sema_expression_checked_text_refused: fn(type_name: String, target: SemaExpressionCheckedTextTarget, holes: [Expr], slots: [TComptimeValue], slot_type: Type?, owner_key: String, span: Span, check: ^SemaBodyCheck) -> Bool {
    if target.accepts == None -> return false
    graph: check.program.registration_graph
    module_name: sema_scope_environment_module_text(check.environment.*, check.program.*)
    caller: sema_scope_caller_row(check.environment.*, graph)
    ^refused: false
    loop (index, hole) in holes {
        hole_span: expr_span(hole)
        if sema_comptime_body_value_find(check.context, check.environment.module_identity, owner_key, hole_span, span) == .Val(landed) {
            if landed.value == .Present(answer) && answer == .String(reason) {
                check.diagnostics.push(sema_error("E2715", hole_span, "`{type_name}` refuses this hole's type where it sits", reason, SEMA_CHECKED_TEXT_HOLE_SLOT_FIX))
                refused = true
            }
            next
        }
        ^probe_diagnostics: [Diagnostic]{}
        probed: sema_probe_expression(hole, None, check, probe_diagnostics) ?? next
        if sema_ownership_type_mentions_generic(probed.ty, check.environment.generic_params) -> next
        owner: "{owner_key}/checked-text-accepts@{hole_span.start}"
        mark: sema_scope_mark(check.scopes)
        sema_scope_enter(check.scopes, check.state, owner)
        type_id: sema_comptime_reflection_type_id(graph, check.context.type_delta, caller, probed.ty)
        ^declared: sema_expression_checked_text_prepare(SEMA_CHECKED_TEXT_ACCEPTS_HOLE_LOCAL, Type.Named{name: "TypeId"}, type_id, owner, module_name, hole_span, check)
        ^slot: sema_expression_checked_text_text_slot(hole_span)
        if index < slots.len() && slot_type == .Val(ty) {
            if !sema_expression_checked_text_prepare(SEMA_CHECKED_TEXT_ACCEPTS_SLOT_LOCAL, ty, slots[index], owner, module_name, hole_span, check) -> declared = false
            slot = Expr.Ident{name: SEMA_CHECKED_TEXT_ACCEPTS_SLOT_LOCAL, span: hole_span, id: AST_NODE_GENERATED}
        }
        if declared {
            call: Expr.MethodCall{
                receiver: Expr.Ident{name: type_name, span: hole_span, id: AST_NODE_GENERATED},
                method: "accepts",
                method_span: hole_span,
                owner_type_args: [Type]{},
                type_args: [Type]{},
                args: [CallArg]{sema_expression_checked_text_arg(slot, hole_span), sema_expression_checked_text_arg(Expr.Ident{name: SEMA_CHECKED_TEXT_ACCEPTS_HOLE_LOCAL, span: hole_span, id: AST_NODE_GENERATED}, hole_span)},
                id: AST_NODE_GENERATED,
            }
            _: sema_comptime_body_capture(check.context, check.environment.*, check.program.*, check.scopes, "{type_name} hole accepts", call, Type.Option{inner: Type.String}, hole_span, span)
        }
        sema_scope_leave(check.scopes, check.state)
        sema_scope_rollback(check.scopes, mark)
    }
    refused
}

// A text kind's literal: its complete text, the one part of the checked
// `Type.check([text])`, wrapped as the nominal type.
sema_expression_checked_text_distinct: fn(head: Type, checked: TExpr, span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaExpressionCheckedTextLiteral {
    text: sema_expression_checked_text_part(checked) ?? {
        check.diagnostics.push(sema_error("E0003", span, "the checked text checker call lost its complete body argument", "the staged checker evaluates the ordinary pure `CheckedText.check` method on the exact encoded body", "preserve the canonical static method call in the checked tree"))
        return SemaExpressionCheckedTextLiteral{handled: true, value: None}
    }
    result: sema_tree_node(head, TExprKind.DistinctCtor{argument: text}, span)
    SemaExpressionCheckedTextLiteral{handled: true, value: sema_expr_expected(result, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// The one part of the checked `Type.check([text])`.
sema_expression_checked_text_part: fn(checked: TExpr) -> TExpr? {
    if checked.kind == .Call(_, _, args) {
        if args.len() == 1 {
            if args[0].value.kind == .List(values, _) {
                if values.len() == 1 -> return Val(values[0])
            }
        }
    }
    None
}

// The checked `Type.check([text])` split in two: `text`, which the caller
// binds once as `source`, and `checker`, the same call on a copy of that
// binding, so the text and the checker each run once.
SemaExpressionCheckedTextSplit: struct {
    text: TExpr,
    checker: TExpr,
}

sema_expression_checked_text_split: fn(checked: TExpr, source: TExpr, span: Span, check: ^SemaBodyCheck) -> SemaExpressionCheckedTextSplit? {
    if checked.kind == .Call(callee, type_args, args) {
        if args.len() == 1 {
            if args[0].value.kind == .List(values, trait_coercion) {
                if values.len() == 1 {
                    copied: sema_expr_check_copy_typed(source, span, None, check.environment.*, check.program.*, check.context, check.diagnostics, false, false) ?? return None
                    ^checker_args: args
                    checker_args[0].value = sema_tree_node(args[0].value.ty, TExprKind.List{values: [TExpr]{copied}, trait_coercion: trait_coercion}, span)
                    return Val(SemaExpressionCheckedTextSplit{text: values[0], checker: sema_tree_node(checked.ty, TExprKind.Call{callee: callee, type_args: type_args, args: checker_args}, span)})
                }
            }
        }
    }
    None
}

// A built literal whose check landed: its shape and slots are read through
// prepared locals, as a `#run` value's are, in a frame of their own, so
// `build` receives the shape as constant data and `check` never runs with
// the program.
sema_expression_checked_text_prepared: fn(type_name: String, landed: SemaExpressionCheckedTextShape, types: [Type], holes: [Expr], owner_key: String, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    owner: "{owner_key}/checked-text@{span.start}"
    module_name: sema_scope_environment_module_text(check.environment.*, check.program.*)
    mark: sema_scope_mark(check.scopes)
    sema_scope_enter(check.scopes, check.state, owner)
    ^declared: sema_expression_checked_text_prepare(SEMA_CHECKED_TEXT_SHAPE_LOCAL, types[0], landed.shape, owner, module_name, span, check)
    ^slots: [Expr]{}
    loop (index, slot) in landed.slots {
        name: "{SEMA_CHECKED_TEXT_SLOT_LOCAL}{index}"
        if !sema_expression_checked_text_prepare(name, types[1], slot, owner, module_name, span, check) -> declared = false
        slots.push(Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED})
    }
    if !declared {
        sema_scope_leave(check.scopes, check.state)
        return None
    }
    value: sema_expression_checked_text_build(type_name, Expr.Ident{name: SEMA_CHECKED_TEXT_SHAPE_LOCAL, span: span, id: AST_NODE_GENERATED}, slots, holes, span, expected, check) ?? {
        sema_scope_leave(check.scopes, check.state)
        return None
    }
    sema_single_use_leave_scope(check)
    sema_scope_rollback(check.scopes, mark)
    Val(value)
}

// Declares the prepared local `name: ty` holding `value` in the current frame.
sema_expression_checked_text_prepare: fn(name: String, ty: Type, value: TComptimeValue, owner: String, module_name: String, span: Span, check: ^SemaBodyCheck) -> Bool {
    id: sema_symbol_id(check.program.*, check.context, SymbolKind.Local, module_name, owner, name)
    symbol: Symbol{id: id, kind: SymbolKind.Local, name: name, module_identity: check.environment.module_identity, owner: Val(owner.copy()), span: span, ty: Val(ty), visibility: 0}
    key: sema_symbol_key(check.program.*, check.context, id)
    if !sema_scope_declare_local(check.scopes, symbol, key, false, AccessConvention.Read, None, false) -> return false
    last: check.scopes.bindings.len() - 1
    sema_scope_note_binding_edit(check.scopes, last)
    check.scopes.bindings[last].prepared = Val(value)
    sema_ownership_declare_binding(check.state, symbol, false)
    true
}

// A built literal in code that runs while building, and the stand-in of
// one in run-time code until its shape lands: the check runs as the code
// does, bound once in a frame of its own, and `build` reads its shape and
// slots, as `c: Type.check(pieces) ?? panic(…)` then
// `Type.build(c.shape, [Type.encode_hole(h, c.slots[i]), …])`.
sema_expression_checked_text_inline: fn(type_name: String, check_call: Expr, holes: [Expr], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    accepted: sema_expression_checked_text_stops(check_call, "{type_name}.check rejected this {type_name} literal", span)
    binding: sema_expr_pipe_binding(SEMA_CHECKED_TEXT_CHECKED_LOCAL, accepted, span)
    shape: Expr.Field{base: sema_expression_checked_text_checked_ref(span), member: "shape", span: span, id: AST_NODE_GENERATED}
    slots: loop index in 0..<holes.len() -> Expr.Index{base: Expr.Field{base: sema_expression_checked_text_checked_ref(span), member: "slots", span: span, id: AST_NODE_GENERATED}, index: Expr.Int{value: index, span: span, width: None, raw: None, id: AST_NODE_GENERATED}, span: span, kind: IndexKind.Unknown, id: AST_NODE_GENERATED}
    return_type: check.scopes.return_type
    mark: sema_scope_mark(check.scopes)
    sema_scope_enter(check.scopes, check.state, "checked-text@{span.start}")
    checked_bindings: sema_check_statements([Stmt]{binding}, return_type, check, check.scopes.loop_depth)
    if !checked_bindings.complete {
        sema_scope_leave(check.scopes, check.state)
        return None
    }
    value: sema_expression_checked_text_build(type_name, shape, slots, holes, span, expected, check) ?? {
        sema_scope_leave(check.scopes, check.state)
        return None
    }
    sema_single_use_leave_scope(check)
    sema_scope_rollback(check.scopes, mark)
    ^body: checked_bindings.value
    body.push(TStmt.ExprStmt{value: value, span: span})
    Val(sema_tree_node(value.ty, TExprKind.InlineBlock{body: body}, span))
}

sema_expression_checked_text_checked_ref: fn(span: Span) -> Expr Never! {
    Expr.Ident{name: SEMA_CHECKED_TEXT_CHECKED_LOCAL, span: span, id: AST_NODE_GENERATED}
}

// `Type.check([part, …])`.
sema_expression_checked_text_check_call: fn(type_name: String, parts: ^^[Expr], span: Span) -> Expr Never! {
    Expr.MethodCall{
        receiver: Expr.Ident{name: type_name, span: span, id: AST_NODE_GENERATED},
        method: "check",
        method_span: span,
        owner_type_args: [Type]{},
        type_args: [Type]{},
        args: [CallArg]{sema_expression_checked_text_parts_arg(parts.move(), span)},
        id: AST_NODE_GENERATED,
    }
}

// The parts list `[part, …]` as one read argument.
sema_expression_checked_text_parts_arg: fn(parts: ^^[Expr], span: Span) -> CallArg Never! {
    sema_expression_checked_text_arg(Expr.ListLit{elements: parts.move(), span: span, id: AST_NODE_GENERATED}, span)
}

sema_expression_checked_text_arg: fn(value: Expr, span: Span) -> CallArg Never! {
    CallArg{convention: AccessConvention.Read, expr: value.copy(), span: span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
}

// One literal piece as a String part.
sema_expression_checked_text_piece: fn(text: ^^String, span: Span) -> Expr Never! {
    Expr.Str{parts: [StrPart]{StrPart.Lit{text: text.move()}}, span: span, id: AST_NODE_GENERATED}
}

// `.Text`, the one slot of a text kind's holes.
sema_expression_checked_text_text_slot: fn(span: Span) -> Expr Never! {
    Expr.EnumLit{type_name: "", variant: "Text", variant_span: None, args: [EnumLitArg]{}, leading_dot: true, span: span, id: AST_NODE_GENERATED}
}

// `Type.encode_hole(value, slot)` for one interpolation hole.
sema_expression_checked_text_encoder: fn(type_name: String, value: Expr, slot: Expr) -> Expr Never! {
    span: expr_span(value)
    Expr.MethodCall{
        receiver: Expr.Ident{name: type_name, span: span, id: AST_NODE_GENERATED},
        method: "encode_hole",
        method_span: span,
        owner_type_args: [Type]{},
        type_args: [Type]{},
        args: [CallArg]{sema_expression_checked_text_arg(value, span), sema_expression_checked_text_arg(slot, span)},
        id: AST_NODE_GENERATED,
    }
}

// `call ?? panic(message)`: a built checked text literal is a value and adds
// no failure route to the function it is in. `encode_hole` and `build` are
// written `-[]> T`, the default failure route, and `check` has already
// accepted the pieces, so a failure of either stops the program at the
// literal, as a rejected run-time check does.
sema_expression_checked_text_stops: fn(call: Expr, message: String, span: Span) -> Expr Never! {
    text: Expr.Str{parts: [StrPart]{StrPart.Lit{text: message}}, span: span, id: AST_NODE_GENERATED}
    argument: CallArg{convention: AccessConvention.Read, expr: text, span: span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
    stop: Expr.Call{call: Call{name: "panic", name_span: span, type_args: [Type]{}, args: [CallArg]{argument}}, id: AST_NODE_GENERATED}
    Expr.OrFallback{value: call, fallback: OrFallback.Value{value: stop}, is_option: false, span: span, id: AST_NODE_GENERATED}
}

// A literal of a type with `build` is `Type.build(shape, holes)`: the shape
// `check` learned from the literal's pieces, and each hole as
// `Type.encode_hole(value, slot)` for its slot, so a hole reaches the value
// as the type's `Hole`, never as spliced text.
sema_expression_checked_text_build: fn(type_name: String, shape: Expr, slots: [Expr], holes: [Expr], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    hole_exprs: loop index in 0..<holes.len() -> sema_expression_checked_text_stops(sema_expression_checked_text_encoder(type_name, holes[index], slots[index]), "{type_name}.encode_hole failed on a hole of this {type_name} literal", expr_span(holes[index]))
    build_call: Expr.MethodCall{
        receiver: Expr.Ident{name: type_name, span: span, id: AST_NODE_GENERATED},
        method: "build",
        method_span: span,
        owner_type_args: [Type]{},
        type_args: [Type]{},
        args: [CallArg]{sema_expression_checked_text_arg(shape, span), sema_expression_checked_text_arg(Expr.ListLit{elements: hole_exprs, span: span, id: AST_NODE_GENERATED}, span)},
        id: AST_NODE_GENERATED,
    }
    built: sema_expression_checked_text_stops(build_call, "{type_name}.build failed on this {type_name} literal", span)
    sema_check_expression(built, expected, check)
}

// Whether every hole of a checked text body is known before the program
// runs: literals, constants, and operators over them.
sema_expression_checked_text_holes_constant: fn(parts: [StrPart], scopes: SemaScopeTable) -> Bool Never! {
    loop part in parts {
        if part == .Interp(value, _) {
            if !sema_expression_checked_text_constant(value, scopes) -> return false
        }
    }
    true
}

sema_expression_checked_text_constant: fn(value: Expr, scopes: SemaScopeTable) -> Bool Never! {
    if value == {
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Char(_, _, _) | .Unit(_, _) -> true
        .Str(parts, _, _) -> sema_expression_checked_text_holes_constant(parts, scopes)
        .Paren(inner, _, _) | .Unary(_, inner, _, _) -> sema_expression_checked_text_constant(inner, scopes)
        .Binary(_, left, right, _, _) -> sema_expression_checked_text_constant(left, scopes) && sema_expression_checked_text_constant(right, scopes)
        .Ident(name, _, _) -> {
            index: sema_scope_resolve_index(scopes, name) ?? return false
            scopes.bindings[index].symbol.kind == SymbolKind.Constant
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// A checked text literal with a run-time hole: the encoded complete text is
// bound once, the type's ordinary `check` runs on it, and a rejection stops
// the program at the literal (E3001), so every value of the type passed its
// checker. The checker call is `checked`, the static `Type.check([text])`.
sema_expression_checked_text_runtime: fn(head: Type, head_name: String, checked: TExpr, span: Span, check: ^SemaBodyCheck) -> TExpr? {
    accepted_type: if checked.ty == {
        .Result(ok, _) -> ok
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
            return None
        }
    }
    source_local: checked_generated_local("__checked_text_source_{span.start}", span, Type.String)
    source_value: sema_tree_node(Type.String, TExprKind.Local{local: source_local}, span)
    split: sema_expression_checked_text_split(checked, source_value, span, check) ?? return None
    message: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: "{head_name}.check rejected the complete text of this {head_name} literal"}}}, span)
    fallback: TOrFallback.Panic{message: message, location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, span)}
    accepted: sema_tree_node(accepted_type, TExprKind.OrFallback{value: split.checker, fallback: fallback, ambient_err: None}, span)
    wrapped: sema_tree_node(head, TExprKind.DistinctCtor{argument: sema_tree_node(Type.String, TExprKind.Move{value: source_value}, span)}, span)
    Val(sema_tree_node(
        head,
        TExprKind.InlineBlock{
            body: [TStmt]{
                TStmt.Let{local: source_local, let_ty: TLetTy.Annotated{ty: Type.String, wrapper: TLetWrapper.Plain}, init: split.text, gc_promotion: None, gc_transferred: false, span: span},
                TStmt.ExprStmt{value: accepted, span: span},
                TStmt.ExprStmt{value: wrapped, span: span},
            },
        },
        span,
    ))
}

// The bytes a `[U8]{"…"}` body spells. ASCII text contributes
// one byte per character and `\xNN` the written byte; non-ASCII text is E0119.
sema_expression_typed_literal_byte_text: fn(parts: [ByteTextPart], head: Type, span: Span, diagnostics: ^[Diagnostic]) -> [U8]? {
    ^bytes: [U8]{}
    loop part in parts {
        if part == {
            .Lit(text) -> {
                loop byte in text.bytes() {
                    if (Int{byte}) >= 128 {
                        diagnostics.push(sema_error("E0119", span, "this body doesn't match typed-literal head `{type_name(head)}`", "a typed literal body uses the head type's own literal shape", "use ASCII text or numeric elements for a byte list"))
                        return None
                    }
                    bytes.push(byte)
                }
            }
            .Bytes(values) -> {
                loop value in values -> bytes.push(value)
            }
        }
    }
    Val(bytes)
}

// A `[U8]` byte-text value checks as one byte constant, never one list element per
// byte: the generated Unicode assets spell up to 1.49 MB this way, and per-byte Int
// expressions cost every phase from sema to comptime a node per byte.
sema_expression_typed_literal_is_byte_list: fn(head: Type) -> Bool Never! {
    if head == .List(element) -> return element == Type.IntN{signed: false, bits: 8}
    false
}

sema_expression_typed_literal_regex: fn(value: Expr, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    ^parts: if value == {
        .Str(rows, _, _) -> rows
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
            check.diagnostics.push(sema_error("E0152", span, "`Regex{{…}}` needs one quoted pattern", "a regex typed literal contains pattern text, not another expression shape", "write `Regex{{\"...\"}}`"))
            return None
        }
    }
    ^pattern: ""
    loop part in parts {
        if part == {
            .Lit(text) -> { pattern = "{pattern}{text}" }
            .Byte(byte) -> { pattern = "{pattern}{sema_expr_byte_text(byte)}" }
            .Interp(expr, _) -> {
                check.diagnostics.push(sema_error("E0152", expr_span(expr), "a `Regex` literal cannot contain interpolation", "the compiler must know the complete pattern before the program runs", "use a fixed `Regex{{\"...\"}}` pattern, or build text and call `re.compile(text)`"))
                return None
            }
        }
    }
    // The literal is checked by the same Core parser that compiles it at run
    // time, so the two can never disagree about what a pattern means.
    _: boundary_regex.compile(pattern) ?? {
        check.diagnostics.push(sema_error("E0152", expr_span(value), "this regex pattern is invalid at position {err.offset}", err.reason, "fix the pattern at that position; a `\\` before ASCII punctuation matches it literally"))
        return None
    }
    route: sema_call_core_resolve_route(check, "core.regex", "compile", [Type]{}, 1, false, span) ?? return None
    if route == {
        .Source(target) -> {
            argument: CallArg{convention: AccessConvention.Read, expr: Expr.Str{parts: [StrPart]{StrPart.Lit{text: pattern}}, span: expr_span(value), id: AST_NODE_GENERATED}, span: span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
            compiled: sema_call_core_check_source_owned(target, "core.regex.compile", [Type]{}, [CallArg]{argument}, span, None, check) ?? return None
            result_type: if compiled.ty == {
                .Result(ok, _) -> ok
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
                    check.context.incomplete_reasons.push("source Regex compile producer is not fallible")
                    return None
                }
            }
            message: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: "compiler-checked regex failed to compile"}}}, span)
            fallback: TOrFallback.Panic{message: message, location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, span)}
            checked: sema_tree_node(result_type, TExprKind.OrFallback{value: compiled, fallback: fallback, ambient_err: None}, span)
            return sema_expr_expected_owned(checked, expected, check.environment.*, check.program.*, check.diagnostics)
        }
        .Core(_) | .SharedSite(_) -> {
            check.diagnostics.push(sema_error("E0906", span, "the source Regex literal producer is unavailable", "checked patterns and dynamic patterns use the same source-owned engine", "load the core.regex source module"))
            return None
        }
    }
}

// Whether `ty` names the Regex type: the written prelude head `Regex`, or the
// canonical `core.regex` record an expected slot resolves to.
sema_expression_is_regex_head: fn(ty: Type) -> Bool Never! {
    if sema_expr_unwrap_tag(ty) == .Named(name) {
        return name == "Regex" || core_identity_is(name, "core.regex", "Regex")
    }
    false
}

sema_expression_typed_literal_mismatch: fn(head: Type, span: Span, diagnostics: ^[Diagnostic]) -> TExpr? {
    diagnostics.push(sema_error("E0119", span, "this body doesn't match typed-literal head `{type_name(head)}`", "a typed literal body uses the head type's own literal shape", "use elements for lists, entries for maps, fields for records, or one expression for scalars"))
    None
}

// #3739 (amends): a list head's lone expression is the whole
// value when it checks as a value of the head the way a parameter of that
// type accepts it; otherwise it is the literal's single element. The probe
// runs on snapshots, so the caller re-checks the chosen reading and every
// diagnostic is reported once. Spreads and inferred-head bodies (`{…}`,
// `.{…}`) always use element notation.
sema_expression_typed_literal_whole_value: fn(head: Type, value: Expr, check: ^SemaBodyCheck) -> Bool {
    if value == {
        .Spread(_, _, _) -> return false
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    if sema_expression_list_element_needs_expected_type(value) || sema_expression_never_whole_list(value) {
        return false
    }
    ^probe_diagnostics: [Diagnostic]{}
    // The probe reads the enclosing statement tails (its liveness frames in
    // `context` index this store), so it shares the store, never a fresh one.
    checked: sema_probe_expression(value, Val(head), check, probe_diagnostics) ?? return false
    if probe_diagnostics.len() != 0 -> return false
    ^_: sema_expr_expected(checked, Val(head), check.environment.*, check.program.*, probe_diagnostics) ?? return false
    probe_diagnostics.len() == 0
}

// A lone element whose value can never be a list: a number, Bool or Char
// literal, or a named record or variant literal whose every field is written
// `name: value` (a shorthand body may be an alias head's elements). Its
// whole-value probe always fails, so the element reading is taken without it.
sema_expression_never_whole_list: fn(value: Expr) -> Bool Never! {
    if value == {
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Char(_, _, _) -> true
        .StructLit(type_name, _, _, as_trait, fields, inferred, _, _) -> {
            if type_name == "" || inferred || as_trait != None || fields.len() == 0 -> return false
            loop field in fields {
                if sema_expression_field_is_shorthand(field) -> return false
            }
            true
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

sema_expression_typed_literal_whole: fn(head: Type, value: Expr, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    checked: sema_check_expression(value, Val(head), check) ?? return None
    typed: sema_expr_expected(checked, Val(head), check.environment.*, check.program.*, check.diagnostics) ?? return None
    sema_expr_expected(typed, expected, check.environment.*, check.program.*, check.diagnostics)
}

SemaExpressionVariantHead: struct {
    enum_name: String,
    variant: String,
}

// `Enum.Variant{field: value}` constructs a
// named-payload variant. The parser reads the dotted head as a type path;
// resolve it here against the enum declaration so the payload is checked by
// the enum constructor, never by the struct-literal path.
sema_expression_variant_head: fn(head: Type, check: ^SemaBodyCheck) -> SemaExpressionVariantHead? {
    // Both named and applied heads retain the same dotted variant path.
    path: if sema_expr_unwrap_tag(head) == {
        .Named(name) | .Apply(name, _) -> name
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ""
    }
    // The enum part is `Enum` or the module-alias-qualified `alias.Enum`; the
    // rest is the variant, a grouped case keeping its group (`Paint.Stroke`).
    // Each dot is tried from the left, cut in place with no part list.
    // spec.md:334-335: "An unshadowed module alias can qualify a declared enum
    // and its variants"; spec.md:518-519: labeled payloads use `Type.Variant{label: value}`.
    if !path.contains(".") -> return None
    bytes: path.bytes()
    loop separator in 1..<bytes.len() {
        if (Int{bytes[separator]}) != 46 -> next
        head_value: SemaExpressionVariantHead{enum_name: foundation_byte_text(bytes, 0, separator), variant: foundation_byte_text(bytes, separator + 1, bytes.len())}
        owner: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, head_value.enum_name)
        if owner == .Val(symbol) && sema_scope_declaration_enum_declares(check, symbol.id, head_value.variant) {
            return Val(head_value)
        }
    }
    None
}

// A record field written as the bare shorthand `{name}`: the parser gives its
// value the field name's own identifier and span.
sema_expression_field_is_shorthand: fn(field: ExprField) -> Bool Never! {
    if field.value == .Ident(name, value_span, _) {
        return name == field.name && value_span.start == field.name_span.start && value_span.end == field.name_span.end
    }
    false
}

// The written head of `Celsius{x}` when the declared type it names has a
// conversion impl (`impl From(Float)` in its body, or `impl Celsius.From(Float)`
// elsewhere), so the literal is `Celsius.from(x)`; a field shorthand
// (`shorthand`) that names one of the type's fields stays a struct literal.
sema_expression_conversion_head: fn(head: Type?, shorthand: String?, check: ^SemaBodyCheck) -> Bool {
    written: head ?? return false
    if sema_expr_unwrap_tag(written) == .Named(written_name) {
        graph: check.program.registration_graph
        symbol: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, written_name) ?? return false
        row: sema_type_graph_nominal_row(graph, symbol.id) ?? return false
        nominal: graph.modules[row.module_index].nominals[row.row]
        if shorthand == .Val(field_name) {
            loop field in nominal.fields {
                if field.symbol.name == field_name -> return false
            }
        }
        if nominal.source == .SourceAST(item) {
            if sema_expression_item_has_conversion_block(item) -> return true
        }
        loop impl_row in sema_registration_impl_rows_named(graph, nominal.symbol.name) {
            implementation: graph.modules[impl_row.module_index].impls[impl_row.row]
            trait_name: implementation.trait_name ?? next
            if !owned_trait_conversion(trait_name) -> next
            if implementation.target_identity_key == nominal.identity_key || (!module_is_none(implementation.target_module_identity) && implementation.target_module_identity == nominal.symbol.module_identity && implementation.target_type_name == nominal.symbol.name) {
                return true
            }
        }
    }
    false
}

sema_expression_conversion_for_head: fn(head: Type?, value: Expr, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    written: head ?? return None
    if sema_expr_unwrap_tag(written) == .Named(written_name) {
        return sema_expression_conversion(written_name, value, span, expected, check)
    }
    None
}

// Whether a struct or enum declaration holds a From impl in its body.
sema_expression_item_has_conversion_block: fn(item: Item) -> Bool Never! {
    if item == {
        .Struct(definition) -> return definition.trait_impls.any(fn(block) { owned_trait_conversion(block.trait_name) })
        .Enum(definition) -> return definition.trait_impls.any(fn(block) { owned_trait_conversion(block.trait_name) })
        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .ErrorConv(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    false
}

// `Celsius{x}` through a conversion is the static call `Celsius.from(x)`,
// which picks the impl by the type of `x`.
sema_expression_conversion: fn(written_name: String, value: Expr, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    ^receiver: Expr?{None}
    bytes: written_name.bytes()
    ^segment_start: 0
    loop index in 0..<(bytes.len() + 1) {
        if index < bytes.len() && (Int{bytes[index]}) != 46 -> next
        part: foundation_byte_text(bytes, segment_start, index)
        receiver = if receiver == {
            .Val(base) -> Val(Expr.Field{base: base, member: part, span: span, id: AST_NODE_GENERATED})
            .None -> Val(Expr.Ident{name: part, span: span, id: AST_NODE_GENERATED})
        }
        segment_start = index + 1
    }
    owner: receiver ?? return None
    argument: CallArg{convention: AccessConvention.Read, expr: value.copy(), span: expr_span(value), flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
    call: Expr.MethodCall{receiver: owner, method: "from", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{argument}, id: AST_NODE_GENERATED}
    sema_check_expression(call, expected, check)
}

// Whether `Float{c}` has a conversion into the built-in head
// (`impl Float.From(Celsius)`) that takes `value`'s type as its source; the
// value is probed, so its diagnostics and moves come from the call it becomes.
sema_expression_has_builtin_conversion: fn(head: Type, value: Expr, check: ^SemaBodyCheck) -> Bool {
    head_name: type_name(head)
    if sema_registration_builtin_scalar(head_name) == None -> return false
    graph: check.program.registration_graph
    sources: loop impl_row in sema_registration_impl_rows_named(graph, head_name) -> {
        implementation: graph.modules[impl_row.module_index].impls[impl_row.row]
        trait_name: implementation.trait_name ?? next
        if !owned_trait_conversion(trait_name) || !module_is_none(implementation.target_module_identity) {
            next
        }
        source: implementation.declaration.operator_rhs ?? next
        sema_expression_type_leaf(type_name(source))
    }
    if sources.len() == 0 -> return false
    ^probe_diagnostics: [Diagnostic]{}
    probed: sema_probe_expression(value, None, check, probe_diagnostics) ?? return false
    sources.contains(sema_expression_type_leaf(type_name(probed.ty)))
}

// The last segment of a written or resolved type name: `Celsius` for
// `units.Celsius` and for a resolved `units.Celsius`.
sema_expression_type_leaf: fn(text: String) -> String Never! {
    dot: text.rfind(".")
    colon: text.rfind(":")
    cut: if dot > colon -> dot else -> colon
    foundation_byte_text(text.bytes(), cut + 1, text.count_bytes())
}

// E0753: a distinct head never re-types its base value;
// the destination owns the explicit conversion. Returns true when reported.
sema_expression_typed_literal_distinct_mismatch: fn(head: Type, value: TExpr, check: ^SemaBodyCheck) -> Bool {
    if value.ty == head -> return false
    facts: sema_expr_distinct_facts(head, check) ?? return false
    // A value that already has the head's distinct type (`Meters{a + b}` for
    // `Meters` operands) is no re-typing, whatever spelling its type carries.
    if sema_expr_distinct_facts(sema_expr_unwrap_tag(value.ty), check) == .Val(own) {
        if own.key == facts.key -> return false
    }
    offered: type_name(value.ty)
    // The conversion is named by its source in snake case, as every distinct
    // conversion is (`from_int`, `from_u8`).
    method: sema_call_distinct_base_method(value.ty)
    // The source spelling of the destination, never its resolved symbol identity.
    shown: sema_type_nominal_leaf(Type.Named{name: facts.name})
    check.diagnostics.push(sema_error("E0753", value.span, "a `{offered}` can't be used where a `{shown}` is expected", "`{shown}` and `{offered}` are different types — even though `{shown}` is built on `{type_name(facts.base)}`, one is never accepted in place of the other", "convert explicitly: `{shown}.{method}(expr)`"))
    true
}

// An untyped numeric literal body elaborates
// against a distinct head, so `UserID{42}` is the base conversion
// `UserID.from_int(42)` and a range type checks the literal (E0135). A typed
// value body (`CustomerID{n}`) keeps the E0753 mismatch.
sema_expression_typed_literal_distinct_literal: fn(head: Type, value: Expr, span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    if sema_expression_typed_literal_written_integer(value) == None && !sema_expr_decimal_literal_operand(value, false) {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    facts: sema_expr_distinct_facts(head, check) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    owner: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, facts.name) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    argument: CallArg{convention: AccessConvention.Read, expr: value, span: expr_span(value), flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
    sema_call_try_distinct_conversion(owner, facts.name, sema_call_distinct_base_method(facts.base), [CallArg]{argument}, span, expected, check)
}

sema_expression_typed_literal: fn(head: Type?, body: TypedLitBody, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    // An overflow word written around this literal (sema_call_check_special_overflow)
    // covers this conversion alone, so it is taken before the body is checked.
    word: check.context.overflow_word
    check.context.overflow_word = None
    if check.context.compiler_records && head == .Val(written) && body == .Fields(fields) {
        if written == .Named(name) && SEMA_CALL_RULE_RECORDS.contains(name) {
            return sema_expression_compiler_record_literal(name, fields, span, expected, check)
        }
    }
    if head == .Val(written) {
        if sema_expression_variant_head(written, check) == .Val(variant_head) {
            owner_args: if sema_expr_unwrap_tag(written) == {
                .Apply(_, rows) -> rows
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> [Type]{}
            }
            if body == {
                .Fields(fields) -> {
                    args: loop field in fields -> EnumLitArg.Named{label: field.name, expr: field.value}
                    return sema_expression_enum_literal(variant_head.enum_name, owner_args, variant_head.variant, args, false, None, span, expected, check)
                }
                .Empty -> return sema_expression_enum_literal(variant_head.enum_name, owner_args, variant_head.variant, [EnumLitArg]{}, false, None, span, expected, check)
                .Elements(_) | .Entries(_) | .Value(_) | .ByteText(_) -> {}
            }
        }
    }
    ^type_value: sema_type_value_literal(head, body, expected, check)
    if type_value.handled -> return type_value.value
    // A head that names no type is that unknown type (E0119), not a body
    // that fails to match it, and so is a list or map head over one
    // (`[Nope]{14}`). A head naming a declared type or a Core record
    // (`IOContext`) is known whatever the written-name table says.
    graph: check.program.registration_graph
    if head == .Val(written) {
        unwrapped: sema_expr_unwrap_tag(written)
        judged: if unwrapped == {
            .Named(written_name) -> sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, written_name) == None && sema_expression_core_record_name(written_name, [Type]{}, expected, check) == None
            .List(_) | .FixedList(_, _) | .Map(_, _, _) -> true
            .Int | .Float | .Bool | .String | .Char | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        if judged {
            before: check.diagnostics.len()
            generic_names: loop parameter in check.environment.generic_params -> parameter.name
            sema_type_unknown_written_names(graph, sema_scope_caller_row(check.environment.*, graph), unwrapped, span, generic_names, check.diagnostics)
            if check.diagnostics.len() > before -> return None
        }
    }
    written_head: head ?? (expected ?? {
        check.diagnostics.push(sema_error("E0119", span, "this inferred typed literal needs a known type", "an inferred typed literal needs an expected type from the surrounding context", "add a type head, or annotate the binding with the intended type"))
        return None
    })
    ^result_head: sema_expr_expected_type(sema_expr_unwrap_tag(written_head), check.environment.*, check.program.*)
    if sema_loop_value_typed_head(result_head, body, span) == .Val(value_loop) {
        checked_loop: sema_check_expression(value_loop, Val(result_head), check) ?? return None
        return sema_expr_expected_owned(checked_loop, expected, check.environment.*, check.program.*, check.diagnostics)
    }
    ^checked_text: sema_expression_checked_text_literal(result_head, head, body, span, expected, check)
    if checked_text.handled -> return checked_text.value

    if result_head == {
        .List(_) | .FixedList(_, _) -> {
            if body == {
                .ByteText(parts) -> {
                    bytes: sema_expression_typed_literal_byte_text(parts, result_head, span, check.diagnostics) ?? return None
                    if sema_expression_typed_literal_is_byte_list(result_head) {
                        constant: sema_tree_node(result_head, TExprKind.CtLit{value: TComptimeValue.Bytes{value: bytes}}, span)
                        return sema_expr_expected_owned(constant, expected, check.environment.*, check.program.*, check.diagnostics)
                    }
                    // `[U8; N]{"…"}` and other element heads check each byte as an element.
                    elements: loop byte in bytes -> Expr.Int{value: (Int{byte}), span: span, width: None, raw: Val("{Int{byte}}"), id: AST_NODE_GENERATED}
                    checked: sema_expression_list(Expr.ListLit{elements: elements, span: span, id: AST_NODE_GENERATED}, elements, span, Val(result_head), check) ?? return None
                    return sema_expr_expected_owned(checked, expected, check.environment.*, check.program.*, check.diagnostics)
                }
                .Empty -> {
                    checked: sema_expression_list(Expr.ListLit{elements: [Expr]{}, span: span, id: AST_NODE_GENERATED}, [Expr]{}, span, Val(result_head), check) ?? return None
                    return sema_expr_expected_owned(checked, expected, check.environment.*, check.program.*, check.diagnostics)
                }
                .Elements(elements) -> {
                    if elements.len() == 1 && sema_expression_typed_literal_whole_value(result_head, elements[0], check) {
                        return sema_expression_typed_literal_whole(result_head, elements[0], expected, check)
                    }
                    checked: sema_expression_list(Expr.ListLit{elements: elements, span: span, id: AST_NODE_GENERATED}, elements, span, Val(result_head), check) ?? return None
                    return sema_expr_expected_owned(checked, expected, check.environment.*, check.program.*, check.diagnostics)
                }
                .Value(value) -> {
                    if sema_expression_typed_literal_whole_value(result_head, value, check) {
                        return sema_expression_typed_literal_whole(result_head, value, expected, check)
                    }
                    ^elements: [Expr]{value}
                    checked: sema_expression_list(Expr.ListLit{elements: elements, span: span, id: AST_NODE_GENERATED}, elements, span, Val(result_head), check) ?? return None
                    return sema_expr_expected_owned(checked, expected, check.environment.*, check.program.*, check.diagnostics)
                }
                // A list alias's items that are all bare names (`Grid<Int>{top, bottom}`)
                // parse as record shorthand before types are known; they are its elements.
                .Fields(fields) -> {
                    values: loop field in fields -> {
                        if !sema_expression_field_is_shorthand(field) {
                            return sema_expression_typed_literal_mismatch(result_head, span, check.diagnostics)
                        }
                        field.value.copy()
                    }
                    return sema_expression_typed_literal(head, TypedLitBody.Elements{elements: values}, span, expected, check)
                }
                .Entries(_) -> return sema_expression_typed_literal_mismatch(result_head, span, check.diagnostics)
            }
        }
        .Map(_, _, _) -> {
            if body == {
                .Empty -> {
                    checked: sema_expression_map(Expr.MapLit{entries: [ExprPair]{}, span: span, id: AST_NODE_GENERATED}, [ExprPair]{}, span, Val(result_head), check) ?? return None
                    return sema_expr_expected_owned(checked, expected, check.environment.*, check.program.*, check.diagnostics)
                }
                .Entries(entries) -> {
                    checked: sema_expression_map(Expr.MapLit{entries: entries, span: span, id: AST_NODE_GENERATED}, entries, span, Val(result_head), check) ?? return None
                    return sema_expr_expected_owned(checked, expected, check.environment.*, check.program.*, check.diagnostics)
                }
                // #3739: a map body without `:` can only be the whole value.
                .Value(value) -> return sema_expression_typed_literal_whole(result_head, value, expected, check)
                // A map alias's body parses as record fields when its keys are bare
                // names (`Table<Int>{key: 3}`); each is an entry keyed by that name's
                // value, as under a written map head, and a lone `{m}` is the whole value.
                .Fields(fields) -> {
                    if fields.len() == 1 && sema_expression_field_is_shorthand(fields[0]) {
                        return sema_expression_typed_literal_whole(result_head, fields[0].value, expected, check)
                    }
                    entries: loop field in fields -> {
                        if sema_expression_field_is_shorthand(field) {
                            return sema_expression_typed_literal_mismatch(result_head, span, check.diagnostics)
                        }
                        ExprPair{key: Expr.Ident{name: field.name.copy(), span: field.name_span, id: AST_NODE_GENERATED}, value: field.value.copy()}
                    }
                    return sema_expression_typed_literal(head, TypedLitBody.Entries{entries: entries}, span, expected, check)
                }
                .Elements(_) | .ByteText(_) -> return sema_expression_typed_literal_mismatch(result_head, span, check.diagnostics)
            }
        }
        .Named(name) -> {
            if body == {
                .Fields(fields) -> {
                    // (#4764): a distinct head is not a record, so `CustomerID{n}`
                    // is its one-expression body (the parser reads `{n}` as a field
                    // shorthand before types are known) and reaches the E0753 conversion rule.
                    if fields.len() == 1 && sema_expression_field_is_shorthand(fields[0]) && sema_expr_distinct_facts(result_head, check) != None {
                        if sema_expression_conversion_head(head, None, check) {
                            return sema_expression_conversion_for_head(head, fields[0].value, span, expected, check)
                        }
                        return sema_expression_typed_literal_single_value(written_head, result_head, fields[0].value, word, true, span, expected, check)
                    }
                    // `Celsius{reading}` converts `reading` through `Celsius.From`
                    // when `reading` names no field of `Celsius`.
                    if fields.len() == 1 && sema_expression_field_is_shorthand(fields[0]) {
                        if sema_expression_conversion_head(head, Val(fields[0].name), check) {
                            return sema_expression_conversion_for_head(head, fields[0].value, span, expected, check)
                        }
                    }
                    checked: sema_expression_struct_literal(name, [Type]{}, fields, false, None, span, Val(result_head), check) ?? return None
                    return sema_expr_expected_owned(checked, expected, check.environment.*, check.program.*, check.diagnostics)
                }
                .Empty -> {
                    checked: sema_expression_struct_literal(name, [Type]{}, [ExprField]{}, false, None, span, Val(result_head), check) ?? return None
                    return sema_expr_expected_owned(checked, expected, check.environment.*, check.program.*, check.diagnostics)
                }
                .Value(value) -> {
                    if sema_expression_conversion_head(head, None, check) {
                        return sema_expression_conversion_for_head(head, value, span, expected, check)
                    }
                }
                .Elements(elements) -> {
                    if elements.len() == 1 {
                        if sema_expression_conversion_head(head, None, check) {
                            return sema_expression_conversion_for_head(head, elements[0], span, expected, check)
                        }
                    }
                }
                .Entries(_) | .ByteText(_) -> {}
            }
        }
        .Apply(name, args) -> {
            if body == {
                .Fields(fields) -> {
                    checked: sema_expression_struct_literal(name, args, fields, false, None, span, Val(result_head), check) ?? return None
                    return sema_expr_expected_owned(checked, expected, check.environment.*, check.program.*, check.diagnostics)
                }
                .Empty -> {
                    checked: sema_expression_struct_literal(name, args, [ExprField]{}, false, None, span, Val(result_head), check) ?? return None
                    return sema_expr_expected_owned(checked, expected, check.environment.*, check.program.*, check.diagnostics)
                }
                .Elements(_) | .Entries(_) | .Value(_) | .ByteText(_) -> {}
            }
        }
        // `T?{ body }` checks its one-expression
        // body in the expected `T?` position, so `None` and `Val(x)` both elaborate.
        .Option(_) -> {
            if body == {
                .Value(value) -> {
                    checked: sema_check_expression(value, Val(result_head), check) ?? return None
                    typed: sema_expr_expected(checked, Val(result_head), check.environment.*, check.program.*, check.diagnostics) ?? return None
                    return sema_expr_expected_owned(typed, expected, check.environment.*, check.program.*, check.diagnostics)
                }
                .Fields(_) | .Elements(_) | .Entries(_) | .ByteText(_) | .Empty -> return sema_expression_typed_literal_mismatch(result_head, span, check.diagnostics)
            }
        }
        .Int | .Float | .Bool | .String | .Char | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }

    // `Float{c}` with `impl Float.From(Celsius)` is `Float.from(c)`.
    if body == {
        .Value(source) -> {
            if sema_expression_has_builtin_conversion(result_head, source, check) {
                return sema_expression_conversion(type_name(result_head), source, span, expected, check)
            }
        }
        .Elements(elements) -> {
            if elements.len() == 1 && sema_expression_has_builtin_conversion(result_head, elements[0], check) {
                return sema_expression_conversion(type_name(result_head), elements[0], span, expected, check)
            }
        }
        .Fields(_) | .Entries(_) | .ByteText(_) | .Empty -> {}
    }
    if body == {
        .Value(value) -> return sema_expression_typed_literal_single_value(written_head, result_head, value, word, true, span, expected, check)
        .Elements(elements) -> {
            if elements.len() == 1 {
                return sema_expression_typed_literal_single_value(written_head, result_head, elements[0], word, false, span, expected, check)
            }
        }
        // A scalar head reached through a type parameter (`T{ value }` in a
        // generic module body, `T` = Int) or a size name the file also binds
        // elsewhere (`fn<U32>` in another function, parser_bound_size_rows):
        // the parser read `{ value }` as a field shorthand before types were
        // known; it is the one-expression body, under the overflow word
        // written around this literal (`checked(U32{value})` stays `U32?`).
        .Fields(fields) -> {
            if fields.len() == 1 && sema_expression_field_is_shorthand(fields[0]) {
                return sema_expression_typed_literal_single_value(written_head, result_head, fields[0].value, word, true, span, expected, check)
            }
        }
        .Entries(_) | .ByteText(_) | .Empty -> {}
    }
    sema_expression_typed_literal_mismatch(result_head, span, check.diagnostics)
}

// One-expression typed literal body for scalar, distinct, regex, unit, and
// precise conversions, borrowing `value` directly without re-wrapping it.
sema_expression_typed_literal_single_value: fn(written_head: Type, result_head: Type, value: Expr, word: String?, allow_regex_and_unit: Bool, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if allow_regex_and_unit {
        // The `Regex` head is the compile-checked pattern literal whether it is
        // written (`Regex{…}`, which `use core.regex` may resolve to the
        // source-owned record) or inferred from a Regex-typed slot (`{…}`).
        if sema_expression_is_regex_head(result_head) || sema_expression_is_regex_head(written_head) {
            return sema_expression_typed_literal_regex(value, span, expected, check)
        }
    }
    if word == .Val(name) {
        if sema_expression_typed_literal_word_literal(name, result_head, value, check.diagnostics) {
            return None
        }
    }
    ^distinct_literal: sema_expression_typed_literal_distinct_literal(result_head, value, span, expected, check)
    if distinct_literal.handled -> return distinct_literal.value
    checked: sema_check_expression(value, sema_expression_typed_literal_body_expected(value, result_head), check) ?? return None
    if sema_expression_typed_literal_float_exact_applies(result_head, checked.ty) {
        exact_line: sema_source_line_at(check.environment.source_segments, expr_span(value)) ?? 0
        exact: sema_expression_typed_literal_float_exact(result_head, checked, value, word, exact_line, check.diagnostics) ?? return None
        return sema_expr_expected_owned(exact, expected, check.environment.*, check.program.*, check.diagnostics)
    }
    if sema_expression_typed_literal_precise_source(result_head, checked.ty) == .Val(precise) {
        exact: sema_expression_typed_literal_precise_int(precise.move(), checked.move(), word, expr_span(value), check.diagnostics) ?? return None
        return sema_expr_expected_owned(exact, expected, check.environment.*, check.program.*, check.diagnostics)
    }
    if sema_expression_typed_literal_float_to_integer(result_head, checked.ty, checked.span, check.diagnostics) {
        return None
    }
    ^converted: checked
    value_span: expr_span(value)
    ^line: sema_source_line_at(check.environment.source_segments, value_span) ?? 0
    ^needs_conversion: sema_expression_typed_literal_needs_conversion(checked.ty, result_head)
    if needs_conversion {
        converted = sema_expr_numeric_literal_conversion(checked, result_head, value_span, line, check.diagnostics) ?? return None
        outcome: sema_expr_narrow_outcome(word, check.context.arithmetic_policy)
        if outcome != TNarrowOutcome.Stop && sema_expr_narrowing_with(converted, outcome, line) == .Val(narrowed) {
            return sema_expr_expected_owned(narrowed, expected, check.environment.*, check.program.*, check.diagnostics)
        }
    }
    if allow_regex_and_unit {
        // `Millimeter{ 4meter }` converts another unit of the family.
        if sema_expr_unit_implicit_applies(result_head, converted.ty, check) {
            unit_value: sema_expr_unit_implicit_conversion(converted, result_head, check) ?? return None
            return sema_expr_expected_owned(unit_value, expected, check.environment.*, check.program.*, check.diagnostics)
        }
    }
    if sema_expression_typed_literal_distinct_mismatch(result_head, converted, check) {
        return None
    }
    diagnostic_start: check.diagnostics.len()
    typed: sema_expr_expected(converted, Val(result_head), check.environment.*, check.program.*, check.diagnostics) ?? {
        sema_expression_typed_literal_text_mismatch(result_head, value, diagnostic_start, check.diagnostics)
        return None
    }
    sema_expr_expected_owned(typed, expected, check.environment.*, check.program.*, check.diagnostics)
}

// A quoted body under a type head is a checked text literal (`SQL{"…"}`,
// `HTML{"…"}`). A named type with no `CheckedText` impl reads no text, so
// the generic mismatch its body reported becomes that lesson (#4276 c33).
sema_expression_typed_literal_text_mismatch: fn(head: Type, value: Expr, diagnostic_start: Int, diagnostics: ^[Diagnostic]) {
    if value == .Str(_, _, _) {
        if head == .Named(_) {
            value_span: expr_span(value)
            index: sema_value_mismatch_index(diagnostics, diagnostic_start, value_span) ?? return
            shown: type_name(head)
            diagnostics[index] = sema_error("E0108", value_span, "`{shown}` isn't a checked text type, so it reads no quoted body", "a quoted body under a type head is a checked text literal; only a type with a `CheckedText` impl, such as `SQL`, `HTML`, `Sh`, `Path` or `URL`, reads one", "build `{shown}` from its fields, or write `impl {shown}.CheckedText {{ … }}` to give it a text grammar")
        }
    }
}

// An integer head that isn't `Int` or a fixed width (an inline range) takes
// no Float body: it uses parameter acceptance, never a numeric retag.
sema_expression_typed_literal_float_to_integer: fn(head: Type, offered: Type, span: Span, diagnostics: ^[Diagnostic]) -> Bool {
    if (offered == Type.Float || offered == Type.Float32) && sema_expr_is_integer(head) {
        diagnostics.push(sema_error("E0112", span, "a `{type_name(offered)}` can't be used where a `{type_name(head)}` is expected", "a typed literal accepts its body like a parameter; converting a decimal value to a whole number must be explicit", "convert it to an integer first with `Int{{value}}`, which stops unless the value is whole, or round it first, as in `Int{{math.round(value)}}`"))
        return true
    }
    false
}

// Whether `head{body}` is the exact conversion of a Float or F32 body to an
// `Int` or fixed-width head (sema_expression_typed_literal_float_exact).
sema_expression_typed_literal_float_exact_applies: fn(head: Type, offered: Type) -> Bool Never! {
    if offered != Type.Float && offered != Type.Float32 -> return false
    head == Type.Int || head == .IntN(_, _)
}

// The exact number type (`Decimal`, `Fraction`) whose whole value `Int{x}`
// converts (sema_expression_typed_literal_precise_int), or None. The root
// name and Core's `core.math.Fraction` identity are one type.
sema_expression_typed_literal_precise_source: fn(head: Type, offered: Type) -> String? {
    if head != Type.Int -> return None
    name: sema_expr_precise_name(sema_expr_unwrap_tag(offered)) ?? return None
    if name == "Decimal" || name == "Fraction" -> return Val(name)
    None
}

// `Int{x}` over a Decimal or Fraction: a whole value converts exactly, and
// any other stops with E3010 naming the roundings (the `to_int` helper).
// Under `checked` it is None instead (`try_int`). An exact value converts
// whole or not at all, so `saturating` and `wrapping` have nothing to keep,
// and an active overflow mode leaves it alone.
sema_expression_typed_literal_precise_int: fn(precise: ^^String, checked: ^^TExpr, word: String?, span: Span, diagnostics: ^[Diagnostic]) -> TExpr? {
    outcome: sema_expr_narrow_outcome(word, None)
    absent: outcome == TNarrowOutcome.Absent
    if word == .Val(name) {
        if !absent {
            diagnostics.push(sema_error("E1005", span, "`{name}` has nothing to keep from a `{precise}` that isn't whole", "an exact number converts to an Int whole or not at all; the overflow word that applies to it is `checked` (None when it isn't whole)", "write `checked(Int{{value}})`"))
            return None
        }
    }
    ty: if absent -> Type.Option{inner: Type.Int} else -> Type.Int
    function: if absent -> "try_int" else -> "to_int"
    Val(TExpr{ty: ty, kind: TExprKind.PreciseBuiltin{type_name: precise.move(), function: function, args: [TExpr]{checked.move()}}, span: span})
}

// `Int{f}`, `U8{f}` and every fixed-width head over a Float or F32 body: a
// whole, finite value in the head's range converts exactly, and any other
// value stops (TNumericOp.FloatExact). Under `checked` it is None instead;
// under `saturating` it truncates, clamps and maps NaN to 0. `Int` has the
// signed 64-bit range here. A written literal body is checked now, so
// `Int{2.5}` is refused before it runs. Only a written word picks the
// outcome: an active overflow mode governs integer narrowing, not a Float.
sema_expression_typed_literal_float_exact: fn(head: Type, checked: TExpr, value: Expr, word: String?, line: Int, diagnostics: ^[Diagnostic]) -> TExpr? {
    value_span: expr_span(value)
    shown: type_name(head)
    if word == .Val(name) {
        if name == "wrapping" {
            diagnostics.push(sema_error("E1005", value_span, "`wrapping` has no low bits to keep from a `{type_name(checked.ty)}`", "a Float converts to a whole number exactly; the overflow words that apply to it are `checked` (None when it doesn't convert) and `saturating` (truncate and clamp)", "write `checked({shown}{{value}})` or `saturating({shown}{{value}})`"))
            return None
        }
    }
    outcome: sema_expr_narrow_outcome(word, None)
    if outcome == TNarrowOutcome.Stop {
        if sema_expression_typed_literal_written_float(value) == .Val(number) {
            if !sema_expression_typed_literal_float_fits(head, number, sema_expression_typed_literal_float_spelling(value, number), value_span, diagnostics) {
                return None
            }
        }
    }
    ty: if outcome == TNarrowOutcome.Absent -> Type.Option{inner: head} else -> head
    Val(TExpr{ty: ty, kind: TExprKind.NumericMethod{receiver: checked, operation: TNumericOp.FloatExact{outcome: outcome, line: line}}, span: value_span})
}

// A written Float literal under an integer head converts only when it is a
// whole number the head holds: `Int{2.5}` (E0112) and `U8{300.0}` (E1003)
// are refused where they are written, each naming the literal as written.
sema_expression_typed_literal_float_fits: fn(head: Type, number: Float, spelling: String, span: Span, diagnostics: ^[Diagnostic]) -> Bool {
    shown: type_name(head)
    roundings: "round it first, as in `{shown}{{math.trunc(value)}}`, or with `math.floor`, `math.ceil`, `math.round` or `math.round_even`"
    // Every finite Float of magnitude 2^52 or more is whole; a smaller one
    // is in Int's range, so it is whole when `checked(Int{…})` takes it.
    finite: number - number == 0.0
    large: number >= 4503599627370496.0 || number <= -4503599627370496.0
    whole: finite && (large || checked(Int{number}) != None)
    if !whole {
        diagnostics.push(sema_error("E0112", span, "`{spelling}` isn't a whole number, so `{shown}` can't hold it exactly", "an integer typed literal converts a Float only when no rounding is needed; it never picks a rounding for you", roundings))
        return false
    }
    bounds: if head == .IntN(signed, bits) -> sema_expr_integer_range(signed, bits) else -> SemaIntegerRange{lo: -9223372036854775808, hi: 9223372036854775807}
    if number >= approx(bounds.lo) && number < approx(bounds.hi + 1) -> return true
    diagnostics.push(sema_error("E1003", span, "`{spelling}` is outside the range of `{shown}`", "`{shown}` holds whole numbers from {bounds.lo} through {bounds.hi}, and an integer typed literal never clamps", "write a value in that range, or use `saturating({shown}{{value}})` to clamp"))
    false
}

// How a body sema_expression_typed_literal_written_float reads as `number`
// is written: the literal's source text (`1.0e19`, not `1e19`), after a `-`
// for a negation.
sema_expression_typed_literal_float_spelling: fn(value: Expr, number: Float) -> String Never! {
    if value == .Float(_, _, _, raw, _) -> return raw ?? "{number}"
    if value == .Paren(inner, _, _) {
        return sema_expression_typed_literal_float_spelling(inner, number)
    }
    if value == .Unary(_, inner, _, _) {
        return "-{sema_expression_typed_literal_float_spelling(inner, -number)}"
    }
    "{number}"
}

// The Float a body is written as: a decimal literal, or its negation.
sema_expression_typed_literal_written_float: fn(value: Expr) -> Float? Never! {
    if value == {
        .Float(number, _, _, _, _) -> return Val(number)
        .Paren(inner, _, _) -> return sema_expression_typed_literal_written_float(inner)
        .Unary(op, inner, _, _) -> {
            if op == UnOp.Neg {
                number: sema_expression_typed_literal_written_float(inner) ?? return None
                return Val(-number)
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    None
}

// Whether a typed literal's checked body converts to its head: an `Int`
// into a fixed-width head, any integer into `Float` or `F32`, a `Float` into
// `F32`, or a fixed-width carrier change. A tagged body (`#Key U64`) converts
// as its carrier does; the conversion keeps the value's tags in the taint flow.
sema_expression_typed_literal_needs_conversion: fn(body: Type, head: Type) -> Bool {
    source: sema_expr_unwrap_tag(body)
    integer_to_fixed: source == Type.Int && (if head == {
        .IntN(_, _) -> true
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    })
    integer_to_fixed || (sema_expr_is_integer(source) && (head == Type.Float || head == Type.Float32)) || (source == Type.Float && head == Type.Float32) || sema_expression_typed_literal_fixed_conversion(source, head)
}

// Integer heads own an explicit conversion, including narrowing fixed carriers.
// A changed result annotation alone cannot change the value's representation.
// A `Float` head widens an `F32` value.
sema_expression_typed_literal_fixed_conversion: fn(source: Type, head: Type) -> Bool {
    if source == .IntN(_, _) {
        if head == Type.Int -> return true
        if head == .IntN(_, _) -> return source != head
    }
    source == Type.Float32 && head == Type.Float
}

// The type a typed literal's one-expression body checks against: the head
// when it is the body's carrier, an applied head (`Stack<Int>`) so a generic
// call's type arguments come from it (`Stack<Int>{ empty_stack() }`, as the
// E0904 fix offers), and `Float` for a written decimal under an `Int` or
// fixed-width head. That decimal would otherwise be a `Decimal`, so
// `Int{3.7}` (E0112) and `I8{300.0}` (E1003) take the exact Float conversion
// and are refused where they are written
// (sema_expression_typed_literal_float_exact).
sema_expression_typed_literal_body_expected: fn(value: Expr, head: Type) -> Type? Never! {
    if head == .Apply(_, _) || sema_expression_typed_literal_value_needs_head(value, head) {
        return Val(head)
    }
    if (head == Type.Int || head == .IntN(_, _)) && sema_expression_typed_literal_written_float(value) != None {
        return Val(Type.Float)
    }
    None
}

// `Float{0.5}` / `F32{-1.5}`: the machine-float head is the decimal literal's
// expected carrier; `I8{200}` / `I8{-129}`: a fixed-width head is a bare
// integer literal's carrier, so the literal is range-checked against it.
// `through_binary = false`: bare/signed decimals contextualize, but compound
// numeric syntax keeps its operand types (ScalarConversionFixtures.jet).
sema_expression_typed_literal_value_needs_head: fn(value: Expr, head: Type) -> Bool Never! {
    if sema_expression_list_element_needs_expected_type(value) -> return true
    if head == .IntN(_, _) {
        if sema_expression_typed_literal_integer_literal(value) -> return true
    }
    sema_expr_decimal_literal_operand(value, false) && sema_expr_expects_machine_float(Val(head))
}

sema_expression_typed_literal_integer_literal: fn(value: Expr) -> Bool Never! {
    if value == {
        .Int(_, _, _, _, _) -> true
        .Paren(inner, _, _) -> sema_expression_typed_literal_integer_literal(inner)
        .Unary(op, inner, _, _) -> op == UnOp.Neg && sema_expression_typed_literal_integer_literal(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// The exact value of a bare written integer (`200`, `-129`, `(7)`), or None.
sema_expression_typed_literal_written_integer: fn(value: Expr) -> Int? Never! {
    if value == {
        .Int(integer, _, width, raw, _) -> {
            if width == None -> return Val(sema_expr_exact_integer_literal(integer, raw))
        }
        .Paren(inner, _, _) -> return sema_expression_typed_literal_written_integer(inner)
        .Unary(op, inner, _, _) -> {
            if op == UnOp.Neg {
                number: sema_expression_typed_literal_written_integer(inner) ?? return None
                return Val(-number)
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    None
}

// Inside an overflow word, a written literal the fixed-width head can't hold
// is still refused (E1003): the word decides what a value that doesn't fit
// becomes, and a literal's value is already known, so the fix names what the
// word would give. True when it was refused.
sema_expression_typed_literal_word_literal: fn(word: String, head: Type, value: Expr, diagnostics: ^[Diagnostic]) -> Bool Never! {
    number: sema_expression_typed_literal_written_integer(value) ?? return false
    if head == .IntN(signed, bits) {
        if sema_expr_integer_fits(number, signed, bits) -> return false
        bounds: sema_expr_integer_range(signed, bits)
        spelling: type_name(head)
        open: "{{"
        close: "}}"
        modulus: 1 << bits
        ^low_bits: (number - bounds.lo) % modulus
        if low_bits < 0 -> low_bits += modulus
        given: if word == {
            "wrapping" -> "`{spelling}{open}{low_bits + bounds.lo}{close}`"
            "saturating" -> if number < bounds.lo -> "`{spelling}{open}{bounds.lo}{close}`" else -> "`{spelling}{open}{bounds.hi}{close}`"
            else -> "`None`"
        }
        diagnostics.push(sema_error("E1003", expr_span(value), "`{number}` doesn't fit in `{spelling}`, which holds {bounds.lo}..{bounds.hi}", "`{word}` decides what a value that doesn't fit becomes, but a written literal is known now, so it must fit", "write {given}, which is what `{word}` gives for {number}"))
        return true
    }
    false
}
