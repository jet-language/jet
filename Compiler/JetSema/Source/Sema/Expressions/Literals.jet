// Checked collection, scalar, indexing, slicing, and range expressions.
use jet_foundation.[
    BodyHandleOp,
    AST_NODE_GENERATED,
    AccessConvention,
    Call,
    CallArg,
    Diagnostic,
    DiagnosticLabel,
    Expr,
    ExprMember,
    ExprPair,
    IndexKind,
    MARKER_CODABLE,
    Measure,
    NodeKind,
    OWNED_ROLE_INDEX,
    OrFallback,
    QuantityKind,
    Span,
    StrPart,
    SymbolKind,
    BinOp,
    TComptimeValue,
    TGenericParam,
    TIndexKind,
    TIndexProof,
    TupleField,
    Type,
    TypeTupleField,
    UnOp,
    UnitFamilyDef,
    UnitRatio,
    AST_EMPTY_CALL_ARG_FLAGS,
    expr_is_map_slot_or,
    expr_source_span,
    expr_span,
    is_compute_tensor_family,
    measure_expression,
    measure_literal_value,
    name_index,
    name_intern,
    name_table,
    owned_trait_bundle,
    owned_trait_codec,
    owned_role_method,
    owned_trait_for_role,
    type_identity_equal,
    type_name,
    module_is_core,
]

sema_expression_unit_literal_type_name: fn(name: String) -> String Never! {
    ^output: ""
    loop piece in name.split("_") {
        if piece == "" -> next
        ^bytes: piece.bytes()
        if bytes.len() == 0 -> next
        code: Int{bytes[0]}
        if code >= 97 && code <= 122 -> bytes[0] = U8{code - 32}
        output = "{output}{String.from_bytes(bytes) ?? piece}"
    }
    if output == "" -> name else -> output
}

sema_expression_unit_literal_time_fact: fn(suffix: String, graph: SemaRegistrationGraph) -> SemaRegistrationUnitFact? {
    loop module_row_index in 0..<graph.modules.len() {
        loop item_index in 0..<graph.modules[module_row_index].program.items.len() {
            if graph.modules[module_row_index].program.items[item_index] == {
                .UnitFamily(definition) -> {
                    owner: definition.resolved_owner ?? ""
                    if definition.family != "Time" || owner != "core.units" -> next
                    loop member in definition.members {
                        if member.name == suffix {
                            return Val(SemaRegistrationUnitFact{
                                name: "Duration",
                                package: definition.resolved_owner ?? "core.units",
                                family: "Time",
                                member: member.name,
                                dimension: definition.resolved_dimension,
                                scale: member.scale,
                                scale_provenance: member.scale_provenance,
                                offset: UnitRatio{numerator: 0, denominator: 1},
                                kind: QuantityKind.Delta,
                            })
                        }
                    }
                }
                .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
            }
        }
    }
    None
}

// The unit a literal's suffix names in the module at registration row
// `module_row`: a member of a family that module declares names its own
// literals, so a file's `#UnitFamily(Lag) { ms }` makes its `5ms` a `Ms`
// while a Core body's `5ms` stays a Duration. Elsewhere Core's time units
// come first, then any loaded family's member of that name.
sema_expression_unit_literal_fact: fn(suffix: String, graph: SemaRegistrationGraph, module_row: Int) -> SemaRegistrationUnitFact? {
    if module_row >= 0 && module_row < graph.modules.len() {
        loop item in graph.modules[module_row].program.items {
            if item == .UnitFamily(definition) && sema_expression_unit_literal_member_fact(suffix, graph, module_row, definition) == .Val(fact) {
                return Val(fact)
            }
        }
    }
    time_fact: sema_expression_unit_literal_time_fact(suffix, graph)
    if time_fact == .Val(fact) -> return Val(fact)
    type_name: sema_expression_unit_literal_type_name(suffix)
    registered: sema_registration_unit_fact_for_type(graph, Type.Named{name: type_name})
    if registered == .Val(fact) && fact.member == suffix && fact.kind == QuantityKind.Linear {
        return Val(fact)
    }
    loop module_row_index in 0..<graph.modules.len() {
        loop item in graph.modules[module_row_index].program.items {
            if item == .UnitFamily(definition) && sema_expression_unit_literal_member_fact(suffix, graph, module_row_index, definition) == .Val(fact) {
                return Val(fact)
            }
        }
    }
    None
}

// The linear unit member `suffix` of `definition`, a family the module at
// registration row `module_row_index` declares; None for Core's time family
// (sema_expression_unit_literal_time_fact) and a based family with an offset
// member.
sema_expression_unit_literal_member_fact: fn(suffix: String, graph: SemaRegistrationGraph, module_row_index: Int, definition: UnitFamilyDef) -> SemaRegistrationUnitFact? {
    owner: definition.resolved_owner ?? ""
    if definition.family == "Time" && owner == "core.units" -> return None
    has_offset_member: loop member in definition.members {
        if member.offset.numerator != 0 {
            break true
        }
    } ?? false
    if definition.base != None && has_offset_member -> return None
    loop member in definition.members {
        if member.name == suffix {
            return Val(SemaRegistrationUnitFact{
                name: sema_expression_unit_literal_type_name(member.name),
                package: definition.resolved_owner ?? graph.modules[module_row_index].package_identity,
                family: definition.family,
                member: member.name,
                dimension: definition.resolved_dimension,
                scale: member.scale,
                scale_provenance: member.scale_provenance,
                offset: member.offset,
                kind: QuantityKind.Linear,
            })
        }
    }
    None
}

sema_expression_unit_literal: fn(raw: String, int_value: Int?, float_value: Float?, suffix: String, suffix_span: Span, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    facts_graph: check.program.registration_graph
    if suffix != "" {
        fact: sema_expression_unit_literal_fact(suffix, facts_graph, sema_app_module_row(check.environment.*, facts_graph))
        if fact == .Val(unit) {
            if unit.name == "Duration" && unit.family == "Time" {
                ^is_float: float_value != None
                ^unit_value: if is_float -> sema_node(check.context, Type.Float, NodeKind.FloatLit{value: float_value ?? 0.0}, span) else -> sema_expr_unbounded_integer_literal(int_value ?? 0, span)
                if {
                    unit.scale.denominator != 1 -> {
                        unit_value = sema_node(check.context, Type.Float, NodeKind.FloatLit{value: approx(int_value ?? 0)}, span)
                        if is_float {
                            unit_value = sema_node(check.context, Type.Float, NodeKind.FloatLit{value: float_value ?? 0.0}, span)
                        }
                        is_float = true
                        factor: approx(unit.scale.numerator) / approx(unit.scale.denominator)
                        factor_value: sema_node(check.context, Type.Float, NodeKind.FloatLit{value: factor}, span)
                        line: sema_source_line_at(check.environment.source_segments, span) ?? 0
                        unit_value = sema_tree_node(Type.Float, TExprKind.Binary{op: BinOp.Mul, overflow: false, line: line, lhs: unit_value, rhs: factor_value}, span)
                    }
                    unit.scale.numerator != 1 -> {
                        factor_value: if is_float -> sema_node(check.context, Type.Float, NodeKind.FloatLit{value: approx(unit.scale.numerator)}, span) else -> sema_expr_unbounded_integer_literal(unit.scale.numerator, span)
                        line: sema_source_line_at(check.environment.source_segments, span) ?? 0
                        result_ty: if is_float -> Type.Float else -> Type.Int
                        unit_value = sema_tree_node(result_ty, TExprKind.Binary{op: BinOp.Mul, overflow: false, line: line, lhs: unit_value, rhs: factor_value}, span)
                    }
                }
                constructed_ty: Type.Result{ok: Type.Named{name: "Duration"}, err: Type.Named{name: "RangeError"}}
                constructed: sema_tree_node(constructed_ty, TExprKind.HandleMethod{receiver: unit_value, operation: BodyHandleOp.DurationNew{unit: 0, float: is_float}, args: [TExpr]{}}, span)
                message: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: "time literal is outside Duration's i64 range"}}}, span)
                fallback: TOrFallback.Panic{message: message, location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, suffix_span)}
                checked: sema_tree_node(Type.Named{name: "Duration"}, TExprKind.OrFallback{value: constructed, fallback: fallback, ambient_err: None}, span)
                return sema_expr_expected_owned(checked, expected, check.environment.*, check.program.*, check.diagnostics)
            }
            if int_value == None && float_value == None {
                check.diagnostics.push(sema_error("E0109", span, "this unit literal has no numeric value", "a literal needs an integer or floating-point payload", "write a numeric literal"))
                return None
            }
            numeric: if float_value != None -> sema_node(check.context, Type.Float, NodeKind.FloatLit{value: float_value}, span) else -> sema_node(check.context, Type.Float, NodeKind.FloatLit{value: approx(int_value ?? 0)}, span)
            value: sema_tree_node(Type.Named{name: unit.name}, TExprKind.DistinctCtor{argument: numeric}, span)
            return sema_expr_expected_owned(value, expected, check.environment.*, check.program.*, check.diagnostics)
        }
        if suffix == "i" {
            imaginary: float_value ?? approx(int_value ?? 0)
            real: sema_node(check.context, Type.Float, NodeKind.FloatLit{value: 0.0}, span)
            imaginary_value: sema_node(check.context, Type.Float, NodeKind.FloatLit{value: imaginary}, span)
            value: sema_tree_node(Type.Named{name: "Complex"}, TExprKind.PreciseBuiltin{type_name: "Complex", function: "from_parts", args: [TExpr]{real, imaginary_value}}, span)
            return sema_expr_expected_owned(value, expected, check.environment.*, check.program.*, check.diagnostics)
        }
        check.diagnostics.push(sema_error("E0134", suffix_span, "`{suffix}` isn't a unit in scope", "a unit suffix names a member of a `#UnitFamily` you've imported; this suffix isn't one here", "import the family that defines `{suffix}`, or write the number without a suffix"))
        return None
    }
    if suffix != "" {
        if suffix == "i" {
            imaginary: float_value ?? approx(int_value ?? 0)
            real: sema_node(check.context, Type.Float, NodeKind.FloatLit{value: 0.0}, span)
            imaginary_value: sema_node(check.context, Type.Float, NodeKind.FloatLit{value: imaginary}, span)
            value: sema_tree_node(Type.Named{name: "Complex"}, TExprKind.PreciseBuiltin{type_name: "Complex", function: "from_parts", args: [TExpr]{real, imaginary_value}}, span)
            return sema_expr_expected_owned(value, expected, check.environment.*, check.program.*, check.diagnostics)
        }
        check.diagnostics.push(sema_error("E0134", suffix_span, "`{suffix}` isn't a unit in scope", "a unit suffix names a member of a `#UnitFamily` you've imported; this suffix isn't one here", "import the family that defines `{suffix}`, or write the number without a suffix"))
        return None
    }
    if int_value != None {
        return sema_expr_expected_owned(sema_expr_unbounded_integer_literal(int_value, span), expected, check.environment.*, check.program.*, check.diagnostics)
    }
    if float_value != None {
        return sema_expr_expected_owned(sema_node(check.context, Type.Float, NodeKind.FloatLit{value: float_value}, span), expected, check.environment.*, check.program.*, check.diagnostics)
    }
    check.diagnostics.push(sema_error("E0109", span, "this unit literal has no numeric value", "a literal needs an integer or floating-point payload", "write a numeric literal"))
    None
}

sema_expression_list_trait_coercion: fn(ty: Type) -> Type? {
    if ty == {
        .List(element) | .FixedList(element, _) -> if element == {
            .TraitObject(bounds) -> if bounds.len() == 1 -> Val(element) else -> None
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
        }
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

SemaExpressionListCheckedParts: struct {
    parts: [TListSpreadPart],
    element_types: [Type],
}

sema_expression_list_element_needs_expected_type: fn(element: Expr) -> Bool Never! {
    if element == {
        .StructLit(_, _, _, _, _, inferred, _, _) -> inferred
        .TypedLit(head, _, _, _) -> head == None
        .Paren(inner, _, _) -> sema_expression_list_element_needs_expected_type(inner)
        .Unary(op, inner, _, _) -> op == UnOp.Neg && sema_expression_list_element_needs_expected_type(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

sema_expression_list_element_is_inferred_struct: fn(element: Expr) -> Bool Never! {
    if element == {
        .StructLit(_, _, _, _, _, inferred, _, _) -> inferred
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// `[{x: 1}, {x: 2}]`: a headless item with record fields is a record.
sema_expression_list_element_is_record: fn(element: Expr, check: SemaBodyCheck) -> Bool Never! {
    if element == .StructLit(_, _, _, as_trait, fields, inferred, _, _) {
        return inferred && as_trait == None && sema_expression_brace_record(fields, None, check)
    }
    false
}

// `[["41"], [], ["x"]]`: an empty item takes its type from a sibling.
sema_expression_list_element_is_empty_list: fn(element: Expr) -> Bool Never! {
    if element == {
        .ListLit(elements, _, _) -> elements.len() == 0
        .Paren(inner, _, _) -> sema_expression_list_element_is_empty_list(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

sema_expression_list_mark_owned_value: fn(value: Expr, check: ^SemaBodyCheck) -> Bool {
    if value == {
        .Ident(name, span, _) -> {
            binding_index: sema_scope_resolve_index_at(check.scopes, name, span) ?? return true
            ^binding: check.scopes.bindings[binding_index]
            if binding.symbol.kind != SymbolKind.Local -> return true
            // A share site copies; the source stays usable.
            if sema_ownership_is_share_site(check.state, span) -> return true
            if sema_ownership_report_invalidated_view(check.state, value, check.scopes, span, check.diagnostics) {
                return false
            }
            ^places: sema_ownership_places_from_expr_in_state(value, check.scopes, check.state)
            if places.len() == 0 -> return true
            if sema_ownership_report_own_place_moved(check.state, value, check.scopes, check.diagnostics) {
                return false
            }
            loop place in places {
                if sema_ownership_place_moved(check.state, place) == .Val(origin) {
                    sema_ownership_report_moved(check.state, origin, place, span, check.diagnostics)
                    return false
                }
                if sema_ownership_active_view_conflict_for_expr(check.state, place, AccessConvention.Move, value, check.scopes) {
                    check.diagnostics.push(sema_ownership_diag_live_reference(sema_ownership_place_name(place), span))
                    return false
                }
                // A view binding carries its own loan into the list
                // (sema_ownership_carrier_loan_exempt), so `[first, second]`
                // over disjoint windows moves both views.
                if sema_ownership_active_loan_conflict_for_expr(check.state, place, AccessConvention.Move, value, check.scopes) != None {
                    check.diagnostics.push(sema_ownership_diag_live_reference(sema_ownership_place_name(place), span))
                    return false
                }
            }
            if !sema_ownership_type_is_copy(binding.symbol.ty ?? Type.Named{name: "Unit"}) {
                origin: sema_ownership_move_origin(value, binding.symbol.ty ?? Type.Named{name: "Unit"}, "the list literal", true, check.scopes.copies_explicit)
                loop place in sema_ownership_moved_record_places(value, places, check.scopes, true) {
                    check.state.moved.push(SemaOwnershipMovedPlace{place: place, origin: origin.copy()})
                }
                loop place in places {
                    if !sema_ownership_note_place_reference(check.state, value, place, span, check.scopes, AccessConvention.Move) {
                        return false
                    }
                }
            }
            true
        }
        .Paren(inner, _, _) | .Present(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) | .Tainted(inner, _, _, _) -> sema_expression_list_mark_owned_value(inner, check)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> true
    }
}

sema_expression_list_check_clone: fn(element: Type, span: Span, check: ^SemaBodyCheck) -> Bool {
    ^facts: sema_copy_classify(element, SemaCopyIntent.Clone, check.environment.*, check.program.*, check.context.generic_params, false)
    ^effect_name: sema_copy_effect_name(facts)
    if effect_name != None {
        check.context.copy_events.push(SemaCopyEvent{span: span, facts: facts})
    }
    if !facts.accepted {
        ^diagnostic: sema_copy_refusal(facts, span, check.environment.*, check.program.*)
        if diagnostic != None {
            check.diagnostics.push(diagnostic ?? sema_error("E0211", span, "`{type_name(element)}` can't be copied", "list spread clones each element while building the result", "spread values whose elements support `Clone`"))
        }
        return false
    }
    if sema_copy_memory_operation(facts) != None && effect_name == None {
        check.context.copy_events.push(SemaCopyEvent{span: span, facts: facts})
    }
    true
}

sema_expression_list_inference_error: fn(element: Type, expected: Type, index: Int, span: Span, diagnostics: ^[Diagnostic]) {
    diagnostics.push(sema_error("E0504", span, "this list resolves to `{type_name(expected)}` but item {index + 1} is `{type_name(element)}`", "every item in a list literal must have the same type", "make every element the same type, or build the list in steps"))
}

// An item that does not fit the list's element type is E0112 about the list
// item, after a checked typed-text rejection and the missing implementation of
// a trait value's trait (E0905).
sema_expression_list_item_mismatch: fn(required: Type, offered: Type, span: Span, check: SemaBodyCheck) -> Diagnostic {
    want: sema_expr_expected_type(required, check.environment.*, check.program.*)
    got: sema_expr_expected_type(offered, check.environment.*, check.program.*)
    if sema_typed_text_mismatch(want, got, span, check.program.*) == .Val(typed_text) {
        return typed_text
    }
    if sema_trait_value_unimplemented(want, got, span) == .Val(unimplemented) {
        return unimplemented
    }
    sema_error("E0112", span, "a list item needs {sema_type_show(want)}, but this is {sema_type_show(got)}", "every list item must match the list's element type", sema_type_fix_hint(want, got))
}

// The item's own check rejected it against the element type with the generic
// E0108 at the item; that report becomes the list item's E0112, with the
// item's own type inferred without the element type as a target.
sema_expression_list_item_replace_mismatch: fn(required: Type, element: Expr, diagnostic_start: Int, check: ^SemaBodyCheck) {
    element_span: expr_span(element)
    mismatch_index: sema_value_mismatch_index(check.diagnostics, diagnostic_start, element_span) ?? return
    ^probe_diagnostics: [Diagnostic]{}
    offered: sema_probe_expression(element, None, check, probe_diagnostics) ?? return
    check.diagnostics[mismatch_index] = sema_expression_list_item_mismatch(required, offered.ty, element_span, check)
}

sema_expression_list_elements: fn(elements: [Expr], expected_element: Type?, check: ^SemaBodyCheck) -> SemaExpressionListCheckedParts? {
    ^checked_parts: [TListSpreadPart?]{}
    ^element_types: [Type?]{}
    ^deferred: [Int]{}
    ^index: 0
    loop index < elements.len() {
        ^element: elements[index]
        if expected_element == None && (sema_expression_list_element_needs_expected_type(element) || sema_expression_list_element_is_empty_list(element)) {
            checked_parts.push(None)
            element_types.push(None)
            deferred.push(index)
            index += 1
            next
        }
        if element == {
            .Spread(value, spread_span, _) -> {
                checked: sema_check_expression(value, None, check) ?? return None
                if !sema_copy_site_check_guard_owned(checked, check, false) -> return None
                if !sema_expression_list_mark_owned_value(value, check) -> return None
                normalized: sema_expr_expected_type(sema_expr_unwrap_tag(checked.ty), check.environment.*, check.program.*)
                ^spread_element: if normalized == {
                    .List(inner) -> inner
                    .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
                        check.diagnostics.push(sema_error("E1311", spread_span, "spread needs a list, not `{type_name(normalized)}`", "list spread `[...xs, y]` expands a list's elements in place", "spread a `[T]` value here"))
                        return None
                    }
                }
                if expected_element == .Val(required) {
                    compatible: sema_expr_expected_assignable(required, spread_element, check.environment.*, check.program.*) ?? return None
                    if !compatible {
                        check.diagnostics.push(sema_type_mismatch(sema_expr_expected_type(required, check.environment.*, check.program.*), sema_expr_expected_type(spread_element, check.environment.*, check.program.*), spread_span, check.program.*))
                        return None
                    }
                }
                checked_parts.push(Val(TListSpreadPart.Spread{value: checked}))
                element_types.push(Val(spread_element))
            }
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
                // A `[View<str>]` item reads a string view as itself, as a
                // `View<str>` field does.
                string_view: if expected_element == .Val(required) -> sema_stmt_string_view_type(required) else -> false
                checked_start: check.diagnostics.len()
                checked: if string_view -> sema_string_view_check_field(element, expected_element ?? Type.String, check) else if expected_element != None -> sema_check_expression(element, expected_element, check) else -> sema_check_expression(element, None, check)
                value: checked ?? {
                    if expected_element == .Val(required) {
                        sema_expression_list_item_replace_mismatch(required, element, checked_start, check)
                    }
                    return None
                }
                if !sema_copy_site_check_guard_owned(value, check, false) -> return None
                if !sema_copy_site_refuse_borrowed_copy(element, "the list literal", check) {
                    return None
                }
                if !sema_expression_list_mark_owned_value(element, check) -> return None
                if expected_element == .Val(required) {
                    compatible: sema_expr_expected_assignable(required, value.ty, check.environment.*, check.program.*) ?? return None
                    if !compatible {
                        check.diagnostics.push(sema_expression_list_item_mismatch(required, value.ty, expr_span(element), check))
                        return None
                    }
                }
                checked_parts.push(Val(TListSpreadPart.Element{value: value}))
                element_types.push(Val(value.ty))
            }
        }
        index += 1
    }
    if expected_element == None && elements.len() > 0 {
        ^first: Type?{None}
        loop item_type in element_types {
            if item_type == .Val(ty) {
                first = Val(ty)
                break
            }
        }
        if first == None {
            loop deferred_index in deferred {
                ^element: elements[deferred_index]
                // No sibling names a type, so an inferred struct item has
                // none; the first record item names the list's record type.
                record: sema_expression_list_element_is_inferred_struct(element) && sema_expression_list_element_is_record(element, check)
                if sema_expression_list_element_is_inferred_struct(element) && !(record && first == None) {
                    if !record {
                        check.diagnostics.push(sema_error("E0119", expr_span(element), "`{{ … }}` needs a known struct type here", "the inferred construction form requires an expected type from the surrounding context (binding annotation, return type, etc.)", "name the type at the value, e.g. `x: Point{{x: 1, y: 2}}`, or inside a list `[Point{{ … }}, {{ … }}]`"))
                    }
                    next
                }
                checked: sema_check_expression(element, None, check)
                if checked == .Val(value) {
                    if !sema_copy_site_check_guard_owned(value, check, false) -> return None
                    if !sema_copy_site_refuse_borrowed_copy(element, "the list literal", check) {
                        return None
                    }
                    if !sema_expression_list_mark_owned_value(element, check) -> return None
                    checked_parts[deferred_index] = Val(TListSpreadPart.Element{value: value})
                    element_types[deferred_index] = Val(value.ty)
                    if first == None -> first = Val(value.ty)
                }
            }
        }
        first_type: first ?? return None
        loop deferred_index in deferred {
            if checked_parts[deferred_index] != None -> next
            ^element: elements[deferred_index]
            value: sema_check_expression(element, Val(first_type), check) ?? return None
            if !sema_copy_site_check_guard_owned(value, check, false) -> return None
            if !sema_copy_site_refuse_borrowed_copy(element, "the list literal", check) {
                return None
            }
            if !sema_expression_list_mark_owned_value(element, check) -> return None
            checked_parts[deferred_index] = Val(TListSpreadPart.Element{value: value})
            element_types[deferred_index] = Val(value.ty)
        }
        ^inferred_element: first_type
        loop item_type in element_types {
            if item_type == .Val(candidate) && !type_identity_equal(inferred_element, candidate) {
                joined: sema_expr_numeric_join(inferred_element, candidate)
                if joined == .Val(common) -> inferred_element = common
            }
        }
        ^inference_failed: false
        loop part_index in 0..<checked_parts.len() {
            item_type: element_types[part_index] ?? next
            if type_identity_equal(item_type, inferred_element) -> next
            source_part: checked_parts[part_index] ?? next
            if source_part == {
                .Spread(_) -> {
                    sema_expression_list_inference_error(item_type, inferred_element, part_index, expr_span(elements[part_index]), check.diagnostics)
                    inference_failed = true
                }
                .Element(value) -> {
                    // The join picked this type, so the item widens into it,
                    // safely (`U8` into `U16`) or checked (`Int` into `Float`).
                    can_widen: sema_expr_numeric_widening_to(item_type, inferred_element) != None
                    if {
                        can_widen -> {
                            line: sema_source_line_at(check.environment.source_segments, expr_span(elements[part_index])) ?? 0
                            converted: sema_expr_numeric_literal_conversion(value, inferred_element, expr_span(elements[part_index]), line, check.diagnostics) ?? return None
                            checked_parts[part_index] = Val(TListSpreadPart.Element{value: converted})
                            element_types[part_index] = Val(inferred_element)
                        }
                        // A later record with the first item's members in
                        // another order converts to the first item's type.
                        sema_type_record_converts(inferred_element, item_type) -> {
                            element_types[part_index] = Val(inferred_element)
                        }
                        else -> {
                            sema_expression_list_inference_error(item_type, inferred_element, part_index, expr_span(elements[part_index]), check.diagnostics)
                            inference_failed = true
                        }
                    }
                }
            }
        }
        if inference_failed -> return None
    }
    ^parts: [TListSpreadPart]{}
    resolved_types: loop slot in 0..<checked_parts.len() -> {
        part: checked_parts[slot] ?? {
            check.context.incomplete_reasons.push("checked list element inference left an unresolved part")
            return None
        }
        item_type: element_types[slot] ?? {
            check.context.incomplete_reasons.push("checked list element inference lost its element type")
            return None
        }
        parts.push(part)
        item_type
    }
    Val(SemaExpressionListCheckedParts{parts: parts, element_types: resolved_types})
}

sema_expression_member_spread_fields: fn(base: Expr, members: [ExprMember], span: Span) -> [Expr] Never! {
    fields: loop member in members -> Expr.Field{base: base, member: member.name, span: Span{start: span.start, end: member.span.end}, id: AST_NODE_GENERATED}
    fields
}

sema_expression_list_member_spreads: fn(elements: [Expr]) -> [Expr] Never! {
    ^expanded: [Expr]{}
    loop element in elements {
        if element == {
            .MemberSpread(base, members, span, _) -> {
                loop field in sema_expression_member_spread_fields(base, members, span) {
                    expanded.push(field)
                }
            }
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
                expanded.push(element.copy())
            }
        }
    }
    expanded
}

sema_expression_list: fn(expr: Expr, elements: [Expr], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    ^has_spread: false
    loop element in elements {
        if element == {
            .Spread(_, _, _) -> has_spread = true
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
        }
    }
    ^expected_element: Type?{None}
    ^result_ty: Type?{None}
    if expected == .Val(expected_ty) {
        normalized: sema_expr_expected_type(sema_expr_unwrap_tag(expected_ty), check.environment.*, check.program.*)
        if normalized == {
            .Named(name) -> {
                if name == "Dyn" {
                    expected_element = Val(sema_dyn_type())
                    result_ty = Val(Type.List{element: sema_dyn_type()})
                }
            }
            .List(element) -> {
                expected_element = Val(element)
                result_ty = Val(normalized)
            }
            .FixedList(element, len) -> {
                graph: check.program.registration_graph
                if sema_type_measure_type_name(graph, check.environment.module_identity, len) == .Val(named) {
                    check.diagnostics.push(sema_error("E0963", span, "`{named}` is a type, not a fixed-size list length", "a fixed-size list `[T#N]` takes a compile-time integer length: a literal or an integer constant", "write the length as an integer, like `[T#{elements.len()}]`"))
                    return None
                }
                if sema_expression_runtime_measure_name(len, check.scopes) == .Val(local) {
                    check.diagnostics.push(sema_error("E0963", span, "`[T#{measure_expression(len)}]` reads `{local}`, a run-time value of the function around it", "a fixed-size list `[T#N]` takes a length computed while compiling: a literal, an integer constant, a number parameter or a `#run` value", "make the length a constant, or bind it with `{local}: #run {{ … }}`"))
                    return None
                }
                if has_spread {
                    check.diagnostics.push(sema_error("E1311", span, "list spread can't build a fixed-size `[T#N]` list", "spread expands a growable list — a `[T#N]` has a fixed compile-time length", "use a growable `[T]` binding (`:`/`:=`) instead of `[T#N]`"))
                    return None
                }
                expected_element = Val(element)
                if measure_literal_value(len) == .Val(expected_len) && expected_len != elements.len() {
                    ^element_suffix: if elements.len() == 1 -> "" else -> "s"
                    ^expected_suffix: if expected_len == 1 -> "" else -> "s"
                    check.diagnostics.push(sema_error("E0963", span, "this list has {elements.len()} element{element_suffix}, but `[T#{measure_expression(len)}]` expects exactly {expected_len}", "a fixed-size list `[T#N]` requires exactly N elements", "provide exactly {expected_len} element{expected_suffix}"))
                    return None
                }
                result_ty = Val(normalized)
            }
            // `[]` is the one empty spelling for both collections: a map
            // context makes it an empty map.
            .Map(_, _, _) -> {
                if elements.len() == 0 {
                    return sema_expression_map(Expr.MapLit{entries: [ExprPair]{}, span: span, id: AST_NODE_GENERATED}, [ExprPair]{}, span, Val(normalized), check)
                }
            }
            .Int | .Float | .Bool | .String | .Char | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
        }
    }
    // `ViewMut` elements coexist in the list: their overlap is the list's
    // alias check below, not the window each element opens.
    deferred_before: check.state.deferred_view_opens.len()
    mutable_view_elements: if expected_element == {
        .Val(element_ty) -> if element_ty == {
            .Apply(name, _) -> name == "ViewMut"
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .None -> false
    }
    if mutable_view_elements {
        loop element_span in sema_ownership_list_view_element_spans(elements) {
            check.state.deferred_view_opens.push(element_span)
        }
    }
    ^checked_elements: sema_expression_list_elements(elements, expected_element, check)
    loop check.state.deferred_view_opens.len() > deferred_before {
        ^_: check.state.deferred_view_opens.pop()
    }
    checked: checked_elements ?? return None
    if result_ty == None {
        if checked.parts.len() == 0 {
            check.diagnostics.push(sema_error("E0501", span, "an empty list needs a type", "write `[]` only where the list type is already known from around it", "name the element type on the literal: `[T]{{}}` for a list of `T`"))
            return None
        }
        result_ty = Val(Type.List{element: checked.element_types[0]})
    }
    if !has_spread {
        sema_ownership_check_list_view_element_aliases(check, elements, expected_element ?? checked.element_types[0])
    }
    ty: result_ty ?? Type.List{element: Type.Named{name: "Unit"}}
    if has_spread {
        element_type: if ty == {
            .List(element) -> element
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
                check.context.incomplete_reasons.push("checked list spread result is not a growable list")
                return None
            }
        }
        if !sema_expression_list_check_clone(element_type, span, check) -> return None
        return sema_expr_expected_owned(sema_tree_node(ty, TExprKind.ListSpread{parts: checked.parts}, span), expected, check.environment.*, check.program.*, check.diagnostics)
    }
    ^values: [TExpr]{}
    loop part in checked.parts {
        if part == {
            .Element(value) -> { values.push(value) }
            .Spread(_) -> {
                check.context.incomplete_reasons.push("list without spread contains a spread part")
                return None
            }
        }
    }
    trait_coercion: sema_expression_list_trait_coercion(ty)
    sema_expr_expected_owned(sema_tree_node(ty, TExprKind.List{values: values, trait_coercion: trait_coercion}, span), expected, check.environment.*, check.program.*, check.diagnostics)
}

// The first name in fixed length `measure` that is a run-time local or
// parameter of the function being checked. A `name: #run { … }` local
// holds a value computed while compiling, and a name with no binding is a
// constant, number parameter or module value the length checks resolve.
sema_expression_runtime_measure_name: fn(measure: Measure, scopes: SemaScopeTable) -> String? Never! {
    if measure == {
        .Symbol(_, name) -> {
            index: sema_scope_resolve_index(scopes, name) ?? return None
            kind: scopes.bindings[index].symbol.kind
            if kind != SymbolKind.Local && kind != SymbolKind.Parameter -> return None
            if scopes.bindings[index].prepared != None -> return None
            Val(name.copy())
        }
        .Combined(_, _, left, right) -> {
            found: sema_expression_runtime_measure_name(left, scopes)
            if found != None -> return found
            sema_expression_runtime_measure_name(right, scopes)
        }
        .Literal(_, _) | .SignedLiteral(_, _) -> None
    }
}

sema_expression_map: fn(expr: Expr, entries: [ExprPair], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    ^expected_key: Type?{None}
    ^expected_value: Type?{None}
    ^result_ty: Type?{None}
    if expected == .Val(expected_ty) {
        normalized: sema_expr_unwrap_tag(expected_ty)
        if normalized == {
            .Named(name) -> {
                if name == "Dyn" {
                    expected_key = Val(Type.String)
                    expected_value = Val(sema_dyn_type())
                    result_ty = Val(Type.Map{key: Type.String, key_span: None, value: sema_dyn_type()})
                }
            }
            .Map(key, key_span, value) -> {
                expected_key = Val(key)
                expected_value = Val(value)
                result_ty = Val(normalized)
                if entries.len() == 0 && !sema_type_map_key_eligible(check.environment.*, check.program.*, key) {
                    check.diagnostics.push(sema_type_map_key_refusal(check.environment.*, check.program.*, key, "`{type_name(key)}` can't be a map key type", key_span ?? span))
                }
            }
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
        }
    }
    if entries.len() == 0 {
        if result_ty == None {
            check.diagnostics.push(sema_error("E0501", span, "an empty map needs a type", "write `[]` only where the map type is already known from around it", "name the key and value types on the literal: `[K:V]{{}}` for a map from `K` to `V`"))
            return None
        }
        ty: result_ty ?? Type.Map{key: Type.Int, key_span: None, value: Type.Int}
        return sema_expr_expected_owned(sema_tree_node(ty, TExprKind.Map{entries: [TMapEntry]{}}, span), expected, check.environment.*, check.program.*, check.diagnostics)
    }
    ^lowered: [TMapEntry]{}
    ^inferred_key: Type?{None}
    ^inferred_value: Type?{None}
    // Each written key's spelling by name id, and its first entry.
    ^written: name_table()
    ^first_at: [Int?]{None}
    ^position: 0
    loop entry in entries {
        key: if expected_key != None -> sema_check_expression(entry.key, expected_key, check) else -> sema_check_expression(entry.key, None, check)
        value: if expected_value != None -> sema_check_expression(entry.value, expected_value, check) else -> sema_check_expression(entry.value, None, check)
        checked_key: key ?? return None
        checked_value: value ?? return None
        if !sema_copy_site_check_guard_owned(checked_key, check, false) -> return None
        if !sema_copy_site_check_guard_owned(checked_value, check, false) -> return None
        if !sema_type_map_key_eligible(check.environment.*, check.program.*, checked_key.ty) {
            check.diagnostics.push(sema_type_map_key_refusal(check.environment.*, check.program.*, checked_key.ty, "`{type_name(checked_key.ty)}` can't be a map key", expr_span(entry.key)))
        }
        if expected_key == .Val(key_ty) {
            compatible_key: sema_expr_expected_assignable(key_ty, checked_key.ty, check.environment.*, check.program.*) ?? return None
            if !compatible_key -> return None
        }
        if expected_value == .Val(value_ty) {
            compatible_value: sema_expr_expected_assignable(value_ty, checked_value.ty, check.environment.*, check.program.*) ?? return None
            if !compatible_value -> return None
        }
        if {
            inferred_key == None -> inferred_key = Val(checked_key.ty)
            !type_identity_equal(inferred_key ?? checked_key.ty, checked_key.ty) -> {
                check.diagnostics.push(sema_error("E0108", expr_span(entry.key), "map keys need one common type", "all entries in a map share one key type", "use keys of the same type"))
                return None
            }
        }
        if {
            inferred_value == None -> inferred_value = Val(checked_value.ty)
            !type_identity_equal(inferred_value ?? checked_value.ty, checked_value.ty) -> {
                check.diagnostics.push(sema_error("E0108", expr_span(entry.value), "map values need one common type", "all entries in a map share one value type", "use values of the same type"))
                return None
            }
        }
        if sema_map_written_key(checked_key, check.context) == .Val(same) {
            id: name_index(name_intern(written, same))
            if id == first_at.len() -> first_at.push(None)
            if first_at[id] == {
                .Val(first) -> {
                    check.diagnostics.push(sema_map_duplicate_key(entries[first].key, entry.key, same))
                }
                .None -> first_at[id] = Val(position)
            }
        }
        lowered.push(TMapEntry{key: checked_key, value: checked_value})
        position += 1
    }
    if result_ty == None {
        result_ty = Val(Type.Map{key: inferred_key ?? Type.Int, key_span: Val(expr_span(entries[0].key)), value: inferred_value ?? Type.Int})
    }
    ty: result_ty ?? Type.Map{key: Type.Int, key_span: None, value: Type.Int}
    sema_expr_expected_owned(sema_tree_node(ty, TExprKind.Map{entries: lowered}, span), expected, check.environment.*, check.program.*, check.diagnostics)
}

// E0502: one why/fix for every rejected map key, at declared-type and
// map-literal sites alike.
sema_map_key_error: fn(what: String, span: Span) -> Diagnostic {
    sema_error("E0502", span, what, "map keys must be Int, String, Bool, Char, U8/IntN, a payload-free enum, a list, tuple or struct whose parts recursively follow these rules, or a `KeyBy` type whose key does; Float, views, Shared, functions, maps, sets, and payload-carrying enums are not key-eligible", "use an eligible scalar, enum, list, tuple, or struct key, or implement `KeyBy` to name the key; remove non-key fields or store the value separately")
}

// A map literal key written out in the source, as text two keys of one
// literal share exactly when they are equal: an integer, text, Bool or Char
// literal, a payload-free enum case, or a constant (equal to itself). Any
// other key is computed, and building the literal checks it (JetIR
// ir_map_literal).
sema_map_written_key: fn(key: TExpr, context: SemaCheckContext) -> String? Never! {
    if key.kind == .IntLit(value, _) -> return Val("{value}")
    if key.kind == .CtLit(value) -> return sema_map_written_value(value)
    if key.kind == .EnumLit(_, variant, payload) {
        if payload == .Unit -> return Val(".{variant}")
        return None
    }
    if key.kind == .StrLit(parts) {
        ^text: ""
        loop part in parts {
            if part == {
                .Literal(piece) -> text = "{text}{piece}"
                .Interpolation(_, _) -> return None
            }
        }
        return Val("\"{text}\"")
    }
    if key.kind == .Flat(index) {
        return sema_map_written_node(context.arena.tree.nodes[index - context.arena.tree.node_base].kind)
    }
    None
}

sema_map_written_node: fn(node: NodeKind) -> String? Never! {
    if node == .IntLit(value, _) -> return Val("{value}")
    if node == .BoolLit(value) -> return Val("{value}")
    if node == .CharLit(value) -> return Val("char {value}")
    if node == .CtLit(value) -> return sema_map_written_value(value)
    if node == .ConstRef(symbol) -> return Val("constant {symbol.id}")
    if node == .EnumLit(_, variant, payload) {
        if payload == .Unit -> return Val(".{variant}")
        return None
    }
    if node == .EnumCtor(_, variant, payload) {
        if payload == .Unit -> return Val("case {variant.id}")
        return None
    }
    if node == .StrLit(parts) {
        ^text: ""
        loop part in parts {
            if part == {
                .Literal(piece) -> text = "{text}{piece}"
                .Interpolation(_, _) -> return None
            }
        }
        return Val("\"{text}\"")
    }
    None
}

sema_map_written_value: fn(value: TComptimeValue) -> String? Never! {
    if value == .Int(number) -> return Val("{number}")
    if value == .BigInt(decimal) -> return Val(decimal)
    if value == .Bool(flag) -> return Val("{flag}")
    if value == .Char(code) -> return Val("char {code}")
    if value == .String(text) -> return Val("\"{text}\"")
    if value == .Enum(_, variant, args) {
        if args.len() == 0 -> return Val(".{variant}")
    }
    None
}

// E0508: entry `second` of a map literal writes the key entry `first` wrote.
// Both spans cover the key as written, so `Level.Low` spans its owner too.
sema_map_duplicate_key: fn(first: Expr, second: Expr, same: String) -> Diagnostic {
    written: sema_map_key_text(second)
    key: if written == "" -> same else -> written
    ^diagnostic: sema_error("E0508", expr_source_span(second), "This map literal writes the key `{key}` twice", "A map holds one value per key, so one of the two values would be lost without a word.", "Delete one of the two entries; to replace a value on purpose, assign it after the literal, as in `stats[\"level\"] = 99`.")
    diagnostic.labels.push(DiagnosticLabel{span: expr_source_span(first), message: "first written here"})
    diagnostic
}

// A key as the source writes it, or "" for a form it doesn't spell back.
sema_map_key_text: fn(key: Expr) -> String Never! {
    if key == .Paren(value, _, _) -> return sema_map_key_text(value)
    if key == .Int(value, _, _, raw, _) -> return raw ?? "{value}"
    if key == .Bool(value, _, _) -> return "{value}"
    if key == .Char(value, _, _) -> return "'{value}'"
    if key == .Ident(name, _, _) -> return name
    if key == .EnumLit(owner, variant, _, _, leading_dot, _, _) {
        if leading_dot -> return ".{variant}"
        return "{owner}.{variant}"
    }
    if key == .Field(base, member, _, _) {
        owner: sema_map_key_text(base)
        if owner == "" -> return ""
        return "{owner}.{member}"
    }
    if key == .Str(parts, _, _) {
        ^text: ""
        loop part in parts {
            if part == {
                .Lit(piece) -> text = "{text}{piece}"
                .Interp(_, _) | .Byte(_) -> return ""
            }
        }
        return "\"{text}\""
    }
    ""
}

sema_expression_tuple: fn(fields: [TupleField], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    ^expected_fields: [TypeTupleField]?{None}
    if expected == .Val(expected_ty) {
        normalized: sema_expr_unwrap_tag(expected_ty)
        if normalized == .Tuple(items) -> expected_fields = Val(items)
    }
    if expected != None && expected_fields == None {
        check.diagnostics.push(sema_type_mismatch(expected, Type.Tuple{fields: [TypeTupleField]{}}, span, check.program.*))
        return None
    }
    ^values: [TExpr]{}
    ^types: [TypeTupleField]{}
    loop field in fields {
        duplicate: loop previous in types {
            if previous.name == field.name {
                break true
            }
        } ?? false
        if duplicate {
            check.diagnostics.push(sema_error("E0105", span, "tuple field `{field.name}` is supplied more than once", "tuple field names must be unique", "remove the duplicate tuple field"))
            return None
        }
        // Members match the expected record by name, written in any order.
        ^field_expected: Type?{None}
        if expected_fields == .Val(rows) {
            loop row in rows {
                if row.name == field.name {
                    field_expected = Val(row.ty)
                    break
                }
            }
            if field_expected == None {
                check.diagnostics.push(sema_error("E0108", span, "tuple fields do not match the expected tuple type", "tuple member names are part of the tuple type", "use the declared tuple field names"))
                return None
            }
        }
        value: sema_check_expression(field.value, field_expected, check) ?? return None
        if !sema_copy_site_check_guard_owned(value, check, false) -> return None
        if field_expected == .Val(field_ty) {
            compatible: sema_expr_expected_assignable(field_ty, value.ty, check.environment.*, check.program.*) ?? return None
            if !compatible -> return None
        }
        values.push(value.copy())
        types.push(TypeTupleField{name: field.name, ty: value.ty})
    }
    if expected_fields != None && fields.len() != (expected_fields ?? [TypeTupleField]{}).len() {
        check.diagnostics.push(sema_error("E0108", span, "tuple fields do not match the expected tuple type", "tuple arity is part of the tuple type", "provide every tuple field exactly once"))
        return None
    }
    // An expected record's member order is part of its type: the literal
    // evaluates its members in written order and arranges them in the
    // expected order, storing each by name.
    if expected_fields == .Val(rows) {
        reordered: loop (index, row) in rows {
            if row.name != types[index].name {
                break true
            }
        } ?? false
        if reordered {
            record: Type.Tuple{fields: rows.copy()}
            ^members: [TStructFieldValue]{}
            loop (index, written) in types {
                member_ty: loop row in rows {
                    if row.name == written.name {
                        break row.ty.copy()
                    }
                } ?? written.ty.copy()
                members.push(TStructFieldValue{field: sema_expression_tuple_field_ref(written.name, member_ty), value: values[index], boxed: false})
            }
            return sema_expr_expected_owned(sema_tree_node(record, TExprKind.StructLit{fields: members}, span), expected, check.environment.*, check.program.*, check.diagnostics)
        }
    }
    sema_expr_expected_owned(sema_tree_node(Type.Tuple{fields: types}, TExprKind.Tuple{values: values}, span), expected, check.environment.*, check.program.*, check.diagnostics)
}

sema_expression_range: fn(start: Expr, end: Expr, exclusive: Bool, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    lhs: sema_check_expression(start, None, check) ?? return None
    rhs: sema_check_expression(end, None, check) ?? return None
    if !sema_expr_is_integer(lhs.ty) {
        check.diagnostics.push(sema_error("E0505", expr_span(start), "range bounds must be Int", "a Range stores whole-number start and end bounds", "use Int values on both sides of the range"))
        return None
    }
    if !sema_expr_is_integer(rhs.ty) {
        check.diagnostics.push(sema_error("E0505", expr_span(end), "range bounds must be Int", "a Range stores whole-number start and end bounds", "use Int values on both sides of the range"))
        return None
    }
    // A stored range or slice with written ends in the
    // wrong order is E0170; computed ends stay empty at run time.
    if sema_range_backward_diagnostic(start, end, None, exclusive, false) == .Val(backward) {
        check.diagnostics.push(backward)
    }
    value: sema_tree_node(Type.Named{name: "Range"}, TExprKind.Range{start: lhs, end: rhs, exclusive: exclusive}, span)
    sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

sema_expression_char_codepoint: fn(text: String) -> Int? {
    bytes: text.bytes()
    if bytes.len() == 0 -> return None
    first: Int{bytes[0]}
    if first < 128 -> return Val(first)
    width: if {
        first >= 192 && first < 224 -> 2
        first >= 224 && first < 240 -> 3
        first >= 240 && first < 248 -> 4
        else -> 0
    }
    if width == 0 || bytes.len() < width -> return None
    value: if width == {
        2 -> (first - 192) * 64 + (Int{bytes[1]} - 128)
        3 -> (first - 224) * 4096 + (Int{bytes[1]} - 128) * 64 + (Int{bytes[2]} - 128)
        4 -> (first - 240) * 262144 + (Int{bytes[1]} - 128) * 4096 + (Int{bytes[2]} - 128) * 64 + (Int{bytes[3]} - 128)
        else -> 0
    }
    Val(value)
}

sema_expression_char: fn(text: String, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    value: sema_expression_char_codepoint(text) ?? {
        check.diagnostics.push(sema_error("E0001", span, "this character literal is not valid UTF-8", "a Char stores one Unicode scalar value", "write one valid character between single quotes"))
        return None
    }
    sema_expr_expected_owned(sema_node(check.context, Type.Char, NodeKind.CharLit{value: value}, span), expected, check.environment.*, check.program.*, check.diagnostics)
}

// `map[key, or: start]`: the value under `key`, which starts as `start` when
// the key is missing. The index is the key and the starting value as one
// pair (TIndexKind.MapOr), so every walk of the node reaches both; the
// lowering finds the key once and runs `start` only on a miss.
sema_expression_map_slot: fn(base: Expr, key: Expr, start: Expr, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    checked_base: sema_check_expression(base, None, check) ?? return None
    map_ty: sema_expr_unwrap_tag(checked_base.ty)
    if map_ty == .Map(key_ty, _, value_ty) {
        checked_key: sema_check_expression(key, Val(key_ty), check) ?? return None
        checked_start: sema_check_expression(start, Val(value_ty), check) ?? return None
        owned_start: sema_expr_expected_owned(checked_start, Val(value_ty), check.environment.*, check.program.*, check.diagnostics) ?? return None
        pair_ty: Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "key", ty: key_ty}, TypeTupleField{name: "start", ty: value_ty}}}
        pair: sema_tree_node(pair_ty, TExprKind.Tuple{values: [TExpr]{checked_key, owned_start}}, span)
        slot: sema_tree_node(value_ty, TExprKind.Index{base: checked_base, index: pair, kind: TIndexKind.MapOr, access: AccessConvention.Read, checked_call: None, location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, span)}, span)
        return sema_expr_expected(slot, expected, check.environment.*, check.program.*, check.diagnostics)
    }
    check.diagnostics.push(sema_error("E0505", span, "only a map slot takes a starting value, not an index of {type_name(checked_base.ty)}", "`or:` names the value a missing map key starts with; other collections have no missing keys", "drop `, or: …`, or index a Map"))
    None
}

sema_expression_index: fn(base: Expr, index: Expr, ast_kind: IndexKind, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    sema_expression_index_inner(base, index, ast_kind, true, span, expected, check)
}

sema_expression_index_for_write: fn(base: Expr, index: Expr, ast_kind: IndexKind, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    sema_expression_index_inner(base, index, ast_kind, false, span, expected, check)
}

sema_expression_index_inner: fn(base: Expr, index: Expr, ast_kind: IndexKind, read_only: Bool, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if index == .Call(call, _) {
        if expr_is_map_slot_or(call) {
            return sema_expression_map_slot(base, call.args[0].expr, call.args[1].expr, span, expected, check)
        }
    }
    ^checked_base: sema_check_expression(base, None, check) ?? return None
    ^base_ty: sema_expr_unwrap_tag(checked_base.ty)
    index_expected: if base_ty == {
        .List(_) -> Val(Type.Int)
        .FixedList(_, _) -> Val(Type.Int)
        .Map(key, _, _) -> Val(key)
        .Apply(name, args) -> if (name == "View" || name == "ViewMut") && args.len() == 1 -> Val(Type.Int) else if name == "Pool" && args.len() == 1 -> Val(Type.Apply{name: "ID", args: [Type]{args[0]}}) else -> None
        .Named(_) -> if sema_call_math_lane_name(base_ty) != None -> Val(Type.Int) else -> None
        .Int | .Float | .Bool | .String | .Char | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
    // The positional `Int` is only a hint, so a named or written-type index
    // (`i`, `U8{1}`) keeps its own type when it is a stored `Range` (a window
    // selection, classified below) or a sized integer (every integer indexes);
    // any other such index meets `Int` as before.
    named_position: sema_expression_index_self_typed(index) && index_expected == (Val(Type.Int))
    borrows_map_string_key: read_only && index_expected == (Val(Type.String))
    view_str_key: borrows_map_string_key && sema_stmt_string_view_type(sema_stmt_return_known_type(index, check.environment.*, check.scopes) ?? Type.Int)
    hint: if named_position || view_str_key -> Type?{None} else -> index_expected
    index_start: check.diagnostics.len()
    previous_borrow: check.context.borrow_ctx
    previous_view_read: check.context.allow_string_view_read
    if borrows_map_string_key {
        check.context.borrow_ctx = true
        check.context.allow_string_view_read = true
    } else if !read_only && index_expected == (Val(Type.String)) {
        check.context.borrow_ctx = false
        check.context.allow_string_view_read = false
    }
    checked_index_opt: sema_check_expression(index, hint, check)
    check.context.borrow_ctx = previous_borrow
    check.context.allow_string_view_read = previous_view_read
    ^inferred_index: checked_index_opt ?? {
        if sema_value_mismatch_index(check.diagnostics, index_start, expr_span(index)) != None {
            ^probe_diagnostics: [Diagnostic]{}
            if sema_probe_expression(index, None, check, probe_diagnostics) == .Val(offered) {
                sema_expression_index_replace_mismatch(base_ty, offered.ty, expr_span(index), index_start, check.diagnostics)
            }
        }
        return None
    }
    if view_str_key && sema_stmt_string_view_type(inferred_index.ty) {
        tree_expr_retype(inferred_index, Type.String)
    }
    // A `distinct Int(lo..hi)` position on a `[T#N]` indexes by its raw Int,
    // and its declared range is the interval the bounds proof reads.
    distinct_range: if base_ty == .FixedList(_, _) -> sema_contract_distinct_range(inferred_index.ty, check) else -> None
    ^index_bounds: tree_expr_known_bounds(inferred_index)
    if index_bounds == None && distinct_range == .Val(range) {
        index_bounds = Val(TIntegerBounds{lo: range.lo, hi: range.hi})
    }
    // An index with no bounds of its own reads its interval off
    // its parts (`faces[roll.raw() - 1]` over a `distinct Int(1..6)`); one that
    // fits the list proves the read, and any other keeps the runtime check.
    derived_range: if index_bounds == None && base_ty == .FixedList(_, _) -> sema_contract_index_interval(inferred_index, check) else -> None
    named_mismatch: named_position && distinct_range == None && inferred_index.ty != (Type.Named{name: "Range"}) && !sema_expr_is_integer(inferred_index.ty)
    named_ty: inferred_index.ty
    ^checked_index: if named_mismatch -> sema_expr_expected(inferred_index, index_expected, check.environment.*, check.program.*, check.diagnostics) ?? {
        sema_expression_index_replace_mismatch(base_ty, named_ty, expr_span(index), index_start, check.diagnostics)
        return None
    } else -> inferred_index
    if distinct_range != None {
        checked_index = sema_tree_node(Type.Int, TExprKind.DistinctRaw{value: checked_index}, checked_index.span)
    }
    // A fixed-width position is the Int it names; one outside the list fails
    // the bounds check like any other position.
    if index_expected == (Val(Type.Int)) && sema_expr_unwrap_tag(checked_index.ty) == .IntN(_, _) {
        line: sema_source_line_at(check.environment.source_segments, checked_index.span) ?? 0
        checked_index = sema_expr_numeric_conversion(checked_index, Type.Int, checked_index.span, line) ?? return None
    }
    // `tree[key]` / `tree[i]` on a `Dyn` reads an object member or array
    // position as a checked Dyn.
    if sema_dyn_is_type(sema_expr_expected_type(base_ty, check.environment.*, check.program.*)) {
        site: "{sema_dyn_site(base)}[{sema_dyn_site(index)}]"
        operation: sema_dyn_index_operation(checked_index.ty, site, span, expr_span(index), check) ?? return None
        value: sema_tree_node(sema_dyn_type(), TExprKind.HandleMethod{receiver: checked_base, operation: operation, args: [TExpr]{checked_index}}, span)
        return sema_expr_expected_owned(value, expected, check.environment.*, check.program.*, check.diagnostics)
    }
    // Fixed lists refine lists (spec: fixed-size lists), so range selection
    // erases only the length fact. Reuse Slice for read/write window typing.
    if checked_index.ty == (Type.Named{name: "Range"}) {
        if is_compute_tensor_family(base_ty) {
            window: sema_call_compute_tensor_window(base, checked_base, checked_index, span, check) ?? return None
            return sema_expr_expected_owned(window, expected, check.environment.*, check.program.*, check.diagnostics)
        }
        element: if base_ty == {
            .List(item) | .FixedList(item, _) -> Val(item)
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
        }
        if element == .Val(item) {
            // L0501: a list window copies its range, so one taken on every loop
            // pass copies every pass. A `View` subrange reborrows instead and
            // is not reported.
            if check.scopes.loop_depth > 0 {
                check.diagnostics.push(sema_lint("L0501", span, "slicing inside a loop copies every time", "each slice makes a fresh copy of the range — that adds up in a loop", "build indices outside the loop, or collect into one list"))
            }
            zero: sema_tree_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span)
            value: sema_tree_node(Type.List{element: item}, TExprKind.Slice{base: checked_base, start: zero, end: zero, range: Val(checked_index), location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, span)}, span)
            return sema_expr_expected_owned(value, expected, check.environment.*, check.program.*, check.diagnostics)
        }
    }
    // Tensor brackets are first-axis Range windows only (core-library.md
    // "Tensor bracket write windows"); a scalar index has no one-axis result.
    if is_compute_tensor_family(base_ty) {
        check.diagnostics.push(sema_error("E0505", expr_span(index), "Tensor indexes must be Range, not {sema_type_show(checked_index.ty)}", "Tensor brackets select a first-axis window with an inclusive or exclusive Range", "use `tensor[start..end]` or `tensor[window]`"))
        return None
    }
    // `v[i]` on a Core SIMD lane type reads its `lanes` fixed array,
    // so the read is the fixed-list index; a written literal must name a lane.
    if sema_call_math_lane_name(base_ty) == .Val(lane) {
        lanes: sema_call_math_arity(lane)
        if index == .Int(number, _, _, _, _) {
            if number < 0 || number >= lanes {
                check.diagnostics.push(sema_error("E0965", expr_span(index), "lane {number} is out of range for `{lane}` ({lanes} lanes)", "the valid lanes for `{lane}` are 0 through {lanes - 1}", "use a lane index between 0 and {lanes - 1}"))
                return None
            }
        }
        lane_array: sema_expression_field_checked(checked_base, "lanes", span, None, check.environment.*, check.program.*, check.scopes, check.context, check.diagnostics) ?? return None
        base_ty = lane_array.ty
        checked_base = lane_array
    }
    ^result_ty: Type?{None}
    ^resolved_kind: ast_kind
    if base_ty == {
        .List(element) -> {
            if {
                checked_index.ty == (Type.Named{name: "Range"}) -> {
                    resolved_kind = IndexKind.Range
                    result_ty = Val(Type.List{element: element})
                }
                else -> {
                    if !sema_expression_integer_index(checked_index, expr_span(index), check.diagnostics) {
                        return None
                    }
                    result_ty = Val(element)
                }
            }
        }
        .FixedList(element, len) -> {
            if !sema_expression_integer_index(checked_index, expr_span(index), check.diagnostics) {
                return None
            }
            // `[T#N]` with `N` a number parameter in scope (`Inline: struct<N:
            // Int>`): each instance has its own length, so the read keeps the
            // runtime bounds check that IR builds per instance.
            if len == .Symbol(_, name) && sema_expression_number_param(check.context.generic_params, name) {
                if index_bounds == .Val(bounds) && bounds.lo < 0 {
                    check.diagnostics.push(sema_error("E0965", expr_span(index), "index {bounds.lo} is out of range for a fixed-size list", "the valid indexes for `[T#{name}]` are 0 through {name}-1", "use an index of 0 or more"))
                    return None
                }
                resolved_kind = IndexKind.List
            } else {
                length: measure_literal_value(len) ?? {
                    check.diagnostics.push(sema_error("E0965", expr_span(index), "a fixed-list length is not a checked integer measure", "fixed indexing needs a concrete list length", "use a literal fixed-list length"))
                    return None
                }
                if index_bounds == {
                    .Val(bounds) -> {
                        if bounds.lo < 0 || bounds.hi >= length {
                            check.diagnostics.push(sema_error("E0965", expr_span(index), "index {if bounds.lo < 0 -> bounds.lo else -> bounds.hi} is out of range for a fixed-size list of {length} elements", "the valid indexes for `[T#N]` are 0 through N-1", "use an index between 0 and {length - 1}"))
                            return None
                        }
                        resolved_kind = IndexKind.FixedListProof
                        // The claim is the whole `base[index]`, as the source shows it.
                        check.context.index_proofs.push(TIndexProof{span: Span{start: expr_span(base).start, end: span.end}, lo: bounds.lo, hi: bounds.hi, len: length})
                    }
                    .None -> {
                        resolved_kind = if ast_kind == IndexKind.FixedListProof -> IndexKind.FixedListProof else -> IndexKind.List
                        if derived_range == .Val(range) && range.lo >= 0 && range.hi < length {
                            resolved_kind = IndexKind.FixedListProof
                            check.context.index_proofs.push(TIndexProof{span: Span{start: expr_span(base).start, end: span.end}, lo: range.lo, hi: range.hi, len: length})
                        }
                    }
                }
            }
            result_ty = Val(element)
        }
        .Map(_, _, value) -> {
            resolved_kind = IndexKind.Map
            result_ty = Val(value)
        }
        .Apply(name, args) -> {
            if (name == "View" || name == "ViewMut") && args.len() == 1 {
                // `view[a..b]` is a `Slice` typed `View<T>`, a read reborrow of
                // the view's owner.
                if checked_index.ty == (Type.Named{name: "Range"}) {
                    if sema_expression_view_subrange_type(base_ty) == .Val(window) {
                        zero_start: sema_tree_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span)
                        zero_end: sema_tree_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span)
                        subrange: sema_tree_node(window, TExprKind.Slice{base: checked_base, start: zero_start, end: zero_end, range: Val(checked_index), location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, span)}, span)
                        return sema_expr_expected_owned(subrange, expected, check.environment.*, check.program.*, check.diagnostics)
                    }
                }
                if !sema_expression_integer_index(checked_index, expr_span(index), check.diagnostics) {
                    return None
                }
                resolved_kind = IndexKind.List
                result_ty = Val(args[0])
            }
            // `pool[id]` reads the slot its own `ID<T>` names; a stale id
            // panics at run time (`jet_pool_get`).
            if name == "Pool" && args.len() == 1 {
                id_type: Type.Apply{name: "ID", args: [Type]{args[0]}}
                if !type_identity_equal(checked_index.ty, id_type) {
                    check.diagnostics.push(sema_error("E0112", expr_span(index), "`Pool` indexes need a matching `ID<T>`, not {sema_type_show(checked_index.ty)}", "a pool slot is only reached through the `ID<T>` its own `.add()` returned", "index with the `ID<T>` handle from `.add(...)`"))
                    return None
                }
                location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, span)
                slot: sema_tree_node(args[0], TExprKind.PoolSlot{pool: checked_base, id: checked_index, mutable: false, field: None, line: location.line, source_line: location.source_line}, span)
                return sema_expr_expected_owned(slot, expected, check.environment.*, check.program.*, check.diagnostics)
            }
            // `table[row]` on a Core `Rows<T>` reads (or, as an
            // assignment place, writes) the row its own `Row<T>` names: the
            // table's row list indexed by the handle's 4-byte slot.
            if args.len() == 1 && sema_expression_rows_type(name, "Rows", check) {
                return sema_expression_rows_index(checked_base, checked_index, args[0], expr_span(index), span, expected, check)
            }
        }
        .String -> {
            check.diagnostics.push(sema_error("E0503", span, "strings aren't indexed with `[ ]`", "text is counted in characters — walk them with `.chars()` or take a piece with `.slice(start..end)`", "e.g. `loop c in s.chars() {{ }}` or `s.slice(0..2)`"))
            return None
        }
        .Int | .Float | .Bool | .Char | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    // A type with an `Index` impl reads `base[key]` as its `get(key)`, and a
    // key it has no value for stops the program like a missing map key.
    if result_ty == None && sema_expression_index_hook(check, base_ty, OWNED_ROLE_INDEX) {
        read: Expr.OrFallback{value: sema_expression_index_hook_call(base, sema_expression_index_hook_method(OWNED_ROLE_INDEX), [Expr]{index}, span), fallback: OrFallback.Value{value: Expr.Call{call: Call{name: "panic", name_span: span, type_args: [Type]{}, args: [CallArg]{sema_expression_index_hook_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: "index miss"}}, span: span, id: AST_NODE_GENERATED})}}, id: AST_NODE_GENERATED}}, is_option: false, span: span, id: AST_NODE_GENERATED}
        return sema_check_expression(read, expected, check)
    }
    if result_ty == None {
        check.diagnostics.push(sema_error("E0505", span, "only lists and maps can be indexed, not {type_name(checked_base.ty)}", "indexing needs a collection with a declared element or value type", "use `[ ]` on a List or Map"))
        return None
    }
    kind: sema_expression_index_kind(resolved_kind, base_ty)
    value: sema_tree_node(result_ty ?? Type.Named{name: "Unit"}, TExprKind.Index{base: checked_base, index: checked_index, kind: kind, access: AccessConvention.Read, checked_call: None, location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, span)}, span)
    sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

// Whether `name` is a number parameter (`<N: Int>`) of the body being checked.
sema_expression_number_param: fn(params: [TGenericParam], name: String) -> Bool {
    loop parameter in params {
        if parameter.number && parameter.name == name -> return true
    }
    false
}

// An index of the wrong type is reported for the collection it addresses
// (E0505, or E0112 for a pool), in place of the generic E0108 its check against
// the index type reported.
sema_expression_index_replace_mismatch: fn(base_ty: Type, offered: Type, index_span: Span, diagnostic_start: Int, diagnostics: ^[Diagnostic]) {
    mismatch_index: sema_value_mismatch_index(diagnostics, diagnostic_start, index_span) ?? return
    diagnostics[mismatch_index] = sema_expression_index_mismatch(base_ty, offered, index_span) ?? return
}

sema_expression_index_mismatch: fn(base_ty: Type, offered: Type, span: Span) -> Diagnostic? {
    list_index: Val(sema_error("E0505", span, "list indexes must be {sema_type_show(Type.Int)}, not {sema_type_show(offered)}", "count positions with a whole number starting at 0", "use an Int index, like `items[0]`"))
    if base_ty == {
        .List(_) | .FixedList(_, _) -> return list_index
        .Map(key, _, _) -> return Val(sema_error("E0505", span, "this map holds keys of type {sema_type_show(key)}, not {sema_type_show(offered)}", "the key in `map[key]` must match the map's key type", "use a {type_name(key)} key here"))
        .Apply(name, args) -> {
            if (name == "View" || name == "ViewMut") && args.len() == 1 -> return list_index
            if name == "Pool" && args.len() == 1 {
                return Val(sema_error("E0112", span, "`Pool` indexes need a matching `ID<T>`, not {sema_type_show(offered)}", "a pool slot is only reached through the `ID<T>` its own `.add()` returned", "index with the `ID<T>` handle from `.add(...)`"))
            }
        }
        .Int | .Float | .Bool | .String | .Char | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    if sema_call_math_lane_name(base_ty) != None {
        return Val(sema_error("E0505", span, "lane indexes must be {sema_type_show(Type.Int)}, not {sema_type_show(offered)}", "a SIMD lane is read by position with a whole-number index starting at 0", "use an Int index, like `v[0]`"))
    }
    None
}

// Whether the nominal `ty` has an impl of the prelude trait that fills index
// role `role` (OWNED_ROLE_INDEX for `[ ]`, OWNED_ROLE_INDEX_MUT for
// `[ ] =`). A user trait that shares that trait's name is not the hook, so
// its impl never routes `[ ]`.
sema_expression_index_hook: fn(check: SemaBodyCheck, ty: Type, role: String) -> Bool {
    if ty == {
        .Named(_) | .Apply(_, _) -> {}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return false
    }
    owned: owned_trait_for_role(role) ?? return false
    trait_name: owned.name
    graph: check.program.registration_graph
    row: sema_type_resolve_nominal_row_at(graph, ty, sema_scope_caller_row(check.environment.*, graph)) ?? return false
    identity: graph.modules[row.module_index].nominals[row.row].identity_key
    loop module_row in graph.modules {
        loop implementation in module_row.impls {
            if implementation.trait_name != (Val(trait_name)) || implementation.target_identity_key != identity {
                next
            }
            if implementation.trait_symbol != None || sema_type_graph_trait_symbol(graph, implementation.source_module_identity, trait_name) != None {
                next
            }
            return true
        }
    }
    // An `impl Index { … }` block in the type's own body is the hook the
    // same way, unless the name is a user trait of the type's module.
    if graph.modules[row.module_index].nominals[row.row].source == .SourceAST(item) {
        loop block in sema_registration_item_trait_blocks(item) {
            if block.trait_name != trait_name -> next
            if sema_type_graph_trait_symbol(graph, graph.modules[row.module_index].module_identity, trait_name) != None {
                next
            }
            return true
        }
    }
    false
}

// The method a `[ ]` read or write calls through the trait that fills index
// role `role`: that trait's one method (`get`, `set`).
sema_expression_index_hook_method: fn(role: String) -> String Never! {
    owned_role_method(role) ?? ""
}

// `receiver.method(args…)`, a generated hook call.
sema_expression_index_hook_call: fn(receiver: Expr, method: String, args: [Expr], span: Span) -> Expr Never! {
    call_args: loop value in args -> sema_expression_index_hook_arg(value)
    Expr.MethodCall{receiver: receiver, method: method, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: call_args, id: AST_NODE_GENERATED}
}

sema_expression_index_hook_arg: fn(value: Expr) -> CallArg Never! {
    CallArg{convention: AccessConvention.Read, expr: value, span: expr_span(value), flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
}

// An index whose type is its own: a name or a literal that writes its type.
sema_expression_index_self_typed: fn(index: Expr) -> Bool Never! {
    if index == {
        .Ident(_, _, _) | .StructLit(_, _, _, _, _, _, _, _) -> true
        .TypedLit(head, _, _, _) -> head != None
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// Whether the applied type `name` is Core's `kind` (`Rows` or
// `Row`) rather than a user type spelled the same: its struct declares
// the reserved field `__rows` (`__slot` for `Row`), which only Core may name.
sema_expression_rows_type: fn(name: String, kind: String, check: ^SemaBodyCheck) -> Bool {
    ^owner: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, name)
    if owner == None {
        owner = sema_expression_carrier_type_symbol(check.environment.*, check.program.*, name)
    }
    symbol: owner ?? return false
    declared: sema_scope_declaration_struct(check.environment.*, check.program.*, symbol.id) ?? return false
    fields: loop field in declared.fields -> field.name
    fields.contains(if kind == "Rows" -> "__rows" else -> "__slot")
}

// `table[row]` on a `Rows<T>` (`element` is T): the table's row list indexed
// by the handle's slot. A handle of another row type is E0112.
sema_expression_rows_index: fn(table: TExpr, row: TExpr, element: Type, row_span: Span, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    ^handle: Type?{None}
    if sema_expr_unwrap_tag(row.ty) == .Apply(row_name, row_args) {
        if row_args.len() == 1 && sema_expression_rows_type(row_name, "Row", check) {
            handle = Val(row_args[0])
        }
    }
    if handle == .Val(handled) {
        if type_identity_equal(handled, element) {
            rows: sema_expression_field_checked(table, "__rows", span, None, check.environment.*, check.program.*, check.scopes, check.context, check.diagnostics) ?? return None
            slot: sema_expression_field_checked(row, "__slot", row_span, None, check.environment.*, check.program.*, check.scopes, check.context, check.diagnostics) ?? return None
            position: sema_expr_numeric_conversion(slot, Type.Int, row_span, sema_source_line_at(check.environment.source_segments, row_span) ?? 0) ?? return None
            kind: sema_expression_index_kind(IndexKind.List, rows.ty)
            value: sema_tree_node(element, TExprKind.Index{base: rows, index: position, kind: kind, access: AccessConvention.Read, checked_call: None, location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, span)}, span)
            return sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
        }
    }
    // The core.collections types by their own names, not module-qualified.
    shown: if handle == .Val(handled) -> "Row<{type_name(handled)}>" else -> type_name(row.ty)
    check.diagnostics.push(sema_error("E0112", row_span, "{shown} cannot index Rows<{type_name(element)}>", "a `Row<T>` handle reaches only a row of a `Rows<T>` table of the same row type", "index with the `Row<{type_name(element)}>` this table's `.add(...)` returned"))
    None
}

sema_expression_slice: fn(base: Expr, start: Expr, end: Expr, range: Expr?, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    checked_base: sema_check_expression(base, None, check) ?? return None
    if is_compute_tensor_family(checked_base.ty) && range == .Val(tensor_range) {
        range_checked: sema_check_expression(tensor_range, Val(Type.Named{name: "Range"}), check) ?? return None
        if range_checked.ty != (Type.Named{name: "Range"}) -> return None
        window: sema_call_compute_tensor_window(base, checked_base, range_checked, span, check) ?? return None
        return sema_expr_expected(window, expected, check.environment.*, check.program.*, check.diagnostics)
    }
    // L0501: an owned slice taken inside a loop copies on every pass; a `View`
    // subrange reborrows its owner and is not reported.
    if check.scopes.loop_depth > 0 && sema_expression_view_subrange_type(checked_base.ty) == None {
        check.diagnostics.push(sema_lint("L0501", span, "slicing inside a loop copies every time", "each slice makes a fresh copy of the range — that adds up in a loop", "build indices outside the loop, or collect into one list"))
    }
    ^result_ty: Type?{None}
    ^range_value: TExpr?{None}
    ^checked_start: TExpr?{None}
    ^checked_end: TExpr?{None}
    if range == {
        .Val(range_expr) -> {
            range_checked: sema_check_expression(range_expr, Val(Type.Named{name: "Range"}), check) ?? return None
            if range_checked.ty != (Type.Named{name: "Range"}) -> return None
            range_value = Val(range_checked)
            if sema_expr_unwrap_tag(checked_base.ty) == {
                .List(element) -> { result_ty = Val(Type.List{element: element}) }
                .FixedList(element, _) -> { result_ty = Val(Type.List{element: element}) }
                .String -> result_ty = Val(Type.String)
                .Int | .Float | .Bool | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
                    result_ty = sema_expression_view_subrange_type(checked_base.ty)
                }
            }
        }
        .None -> {
            start_checked: sema_check_expression(start, Val(Type.Int), check) ?? return None
            end_checked: sema_check_expression(end, Val(Type.Int), check) ?? return None
            if !sema_expr_is_integer(start_checked.ty) || !sema_expr_is_integer(end_checked.ty) {
                return None
            }
            checked_start = Val(start_checked)
            checked_end = Val(end_checked)
            if sema_expr_unwrap_tag(checked_base.ty) == {
                .List(element) -> { result_ty = Val(Type.List{element: element}) }
                .FixedList(element, _) -> { result_ty = Val(Type.List{element: element}) }
                .String -> result_ty = Val(Type.String)
                .Int | .Float | .Bool | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
                    result_ty = sema_expression_view_subrange_type(checked_base.ty)
                }
            }
        }
    }
    if result_ty == None {
        check.diagnostics.push(sema_error("E0505", span, "only lists and strings can be sliced, not {type_name(checked_base.ty)}", "a Range projects a window from indexed storage", "slice a List or String value"))
        return None
    }
    if sema_columnar_list_element(check, checked_base.ty) == .Val(element) {
        check.diagnostics.push(sema_error("E1108", span, "slicing isn't supported on a columnar list `{sema_type_show(sema_expr_unwrap_tag(checked_base.ty))}` yet", "`#Layout(columnar)` lists support the core surface in v1: indexing, field access, `len`, `is_empty`, `push`, and iteration", "drop `#Layout(columnar)` from `{element}` to slice, or index the elements you need in a loop"))
        return None
    }
    zero_start: sema_tree_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span)
    zero_end: sema_tree_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span)
    result: sema_tree_node(result_ty ?? Type.Named{name: "Unit"}, TExprKind.Slice{base: checked_base, start: checked_start ?? zero_start, end: checked_end ?? zero_end, range: range_value, location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, span)}, span)
    sema_expr_expected(result, expected, check.environment.*, check.program.*, check.diagnostics)
}

// A subrange of a declared `View<T>`/`ViewMut<T>` is a `View<T>` read reborrow
// of the same owner; `^view[a..b]` on a `ViewMut<T>` reopens the write window
// in the place.
sema_expression_view_subrange_type: fn(ty: Type) -> Type? Never! {
    if sema_expr_unwrap_tag(ty) == .Apply(name, args) {
        if (name == "View" || name == "ViewMut") && args.len() == 1 {
            if args[0] == (Type.Named{name: "str"}) -> return None
            return Val(Type.Apply{name: "View", args: [Type]{args[0]}})
        }
    }
    None
}

// A nominal type whose `Display` comes from a derive: a
// `#Printable` or `#Display` marker, or the auto-derived `Printable` the
// declaration-marker rule selects for it. A Core runtime handle the IR lays
// out opaquely, with no form that renders it, derives none: its declared
// fields are not what the value holds.
sema_expression_interpolation_derived: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    graph: program.registration_graph
    name: sema_type_graph_base_name(ty) ?? return false
    resolved: sema_type_graph_lookup_symbol_at(graph, sema_scope_caller_row(environment, graph), name) ?? return false
    if sema_resolved_kind(graph, resolved) != SymbolKind.Type -> return false
    if module_is_core(resolved.target_module_identity) && sema_comparability_core_declaration_unrendered(graph, resolved.target_module_identity, ty, resolved, "Printable") {
        return false
    }
    if sema_scope_checked_type_row(environment, program, resolved.target_module_identity, sema_resolved_name(graph, resolved)) == .Val(checked_row) {
        if sema_serde_has_name(program.checked_types[checked_row].derives, "Printable") || sema_serde_has_name(program.checked_types[checked_row].derives, "Display") {
            return true
        }
    }
    module_index: sema_registration_module_index(graph, resolved.target_module_identity) ?? return false
    row: sema_type_graph_resolved_nominal_row(graph, resolved) ?? return false
    // Matched in place: a pattern on the indexed path copies the whole item.
    nominal: graph.modules[row.module_index].nominals[row.row]
    if nominal.source == .SourceAST(item) {
        return sema_type_metadata_auto_derives(item, graph.modules[module_index].declared_trait_impls).printable && !sema_comparability_rendering_blocked(graph, resolved.target_module_identity, item, "Printable")
    }
    false
}

// A nominal type of the program that bare `{value}` shows only through its
// auto-derived `Printable`: no `#Printable`/`#Display` marker and no authored
// `Display` or `Printable` implementation. Display has no default, so the
// interpolation is flagged for the explicit debug selector (L0520). Core
// types are not flagged: their display is the library's, not the caller's.
sema_expression_interpolation_auto_printable: fn(ty: Type, check: SemaBodyCheck) -> Bool {
    graph: check.program.registration_graph
    name: sema_type_graph_base_name(ty) ?? return false
    resolved: sema_type_graph_lookup_symbol_at(graph, sema_scope_caller_row(check.environment.*, graph), name) ?? return false
    if sema_resolved_kind(graph, resolved) != SymbolKind.Type || module_is_core(resolved.target_module_identity) {
        return false
    }
    if sema_scope_checked_type_row(check.environment.*, check.program.*, resolved.target_module_identity, sema_resolved_name(graph, resolved)) == .Val(checked_row) {
        if sema_serde_has_name(check.program.checked_types[checked_row].derives, "Printable") || sema_serde_has_name(check.program.checked_types[checked_row].derives, "Display") {
            return false
        }
    }
    if sema_call_reflection_bound(ty, "Display", check.environment.*, check.program.*) {
        return false
    }
    module_index: sema_registration_module_index(graph, resolved.target_module_identity) ?? return false
    row: sema_type_graph_resolved_nominal_row(graph, resolved) ?? return false
    // Matched in place: a pattern on the indexed path copies the whole item.
    nominal: graph.modules[row.module_index].nominals[row.row]
    if nominal.source == .SourceAST(item) {
        declared: graph.modules[module_index].declared_trait_impls
        if !sema_type_metadata_auto_derives(item, declared).printable -> return false
        if item == {
            .Struct(value) -> return !sema_type_metadata_has_trait_block(value.trait_impls, "Display") && !sema_type_metadata_has_explicit_impl(declared, value.name, "Display")
            .Enum(value) -> return !sema_type_metadata_has_trait_block(value.trait_impls, "Display") && !sema_type_metadata_has_explicit_impl(declared, value.name, "Display")
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> return false
        }
    }
    false
}

// Bare `{value}` needs a value whose type can be shown through `Display`. The
// shared reflection gate owns the structural rules; a nominal type also counts
// when it derives its display or is a unit-family member. In a snapshot
// check the nominal facts are unknown, so a nominal type is not refused.
sema_expression_displayable: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    if sema_call_reflection_secret_bearing(ty) || sema_call_reflection_one_pass(ty) -> return false
    if ty == {
        .Named(name) -> {
            graph: program.registration_graph
            // Snapshot: a lone program's nominal facts are unknown, so the type is not refused.
            if graph.mode == .Snapshot -> return true
            if sema_call_reflection_named_displayable(name, ty, environment, program) -> return true
            return sema_registration_unit_member_type(graph, ty) || sema_expression_interpolation_derived(ty, environment, program)
        }
        .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .Case(_, inner) | .InlineRange(inner, _, _) -> return sema_expression_displayable(inner, environment, program)
        .Result(ok, err) -> return sema_expression_displayable(ok, environment, program) && sema_expression_displayable(err, environment, program)
        .Map(key, _, value) -> return sema_expression_displayable(key, environment, program) && sema_expression_displayable(value, environment, program)
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_expression_displayable(field.ty, environment, program) -> return false
            }
            return true
        }
        .Union(members) -> {
            loop member in members {
                if !sema_expression_displayable(member, environment, program) -> return false
            }
            return true
        }
        .Apply(name, args) -> {
            // A string view shows its text, as the String it borrows from.
            if sema_stmt_string_view_type(ty) -> return true
            // A pool's `ID<T>` shows its index and generation, never `T`.
            if sema_call_reflection_pool_id(ty) -> return true
            // The owner's own rule is the reflection gate's, applied to the
            // bare owner; every argument is then shown in turn. A `Cache`'s
            // rule reads its arguments, so it is asked of the whole type.
            if !sema_call_reflection_cache(ty) && !sema_call_reflection_is_displayable(Type.Apply{name: name, args: [Type]{}}, environment, program) && !sema_expression_interpolation_derived(ty, environment, program) {
                return false
            }
            if sema_call_reflection_leaf_name(name) == "KeyRef" -> return true
            loop argument in args {
                if !sema_expression_displayable(argument, environment, program) -> return false
            }
            return true
        }
        // A trait value shows the concrete value its box holds, so it
        // interpolates when every type it may hold does.
        .TraitObject(bounds) -> {
            if sema_call_reflection_has_name(bounds, "Renderable") -> return true
            graph: program.registration_graph
            holders: sema_call_reflection_trait_holders(graph, bounds) ?? return false
            loop reference in holders.impls {
                if !sema_expression_displayable(graph.modules[reference.module_index].impls[reference.row].target_type, environment, program) {
                    return false
                }
            }
            loop reference in holders.nominals {
                if !sema_expression_displayable(graph.modules[reference.module_index].nominals[reference.row].ty, environment, program) {
                    return false
                }
            }
            return true
        }
        .Int | .Float | .Bool | .String | .Char | .Shared(_) | .Fn(_, _, _, _, _, _) | .IntN(_, _) | .Float32 | .Quantity(_, _) | .Measure(_) -> return sema_call_reflection_is_displayable(ty, environment, program)
    }
}

// The markers that grant a distinct type named in this scope its forwarded
// operations, in the order its derives came from them: each bundle trait's
// own, and `#Codable` for a codec it asked for.
sema_expression_distinct_bundles: fn(name: String, check: ^SemaBodyCheck) -> [String]? {
    owner: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, name) ?? return None
    definition: sema_scope_declaration_distinct(check, owner.id) ?? return None
    ^granted: [String]{}
    loop derived in definition.derives {
        ^marker: ""
        if {
            owned_trait_bundle(derived.name) -> marker = "#{derived.name}"
            owned_trait_codec(derived.name) -> marker = "#{MARKER_CODABLE}"
            else -> next
        }
        if !granted.contains(marker) -> granted.push(marker)
    }
    Val(granted)
}

// The call that turns a one-pass source into a showable value, when it has one.
sema_expression_one_pass_fix: fn(ty: Type) -> String Never! {
    if ty == {
        .Apply(name, _) -> {
            leaf: sema_call_reflection_leaf_name(name)
            if leaf == "Iter" || leaf == "ViewIter" {
                return "materialize it first: add `.to_list()` before the interpolation"
            }
        }
        .Named(name) -> {
            if sema_call_reflection_leaf_name(name) == "Body" {
                return "materialize it first: add `.text(limit)` before the interpolation"
            }
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    "consume it with a `loop` and show each item instead"
}

// Bare `{value}` interpolation calls
// `Display`, which has no default. A value without it is refused here
// (E0915); a nominal `distinct` type without `#Printable` names the bundles
// it was granted instead (E0138). Returns whether the value can be shown.
sema_expression_interpolation_display: fn(value: TExpr, check: ^SemaBodyCheck) -> Bool {
    ty: value.ty
    if sema_expression_displayable(ty, check.environment.*, check.program.*) {
        // The lint's one edit is `:Debug`, so a type that opted out of Debug
        // (where that hole is E0112) isn't flagged.
        if sema_expression_interpolation_auto_printable(ty, check) && sema_call_debug_traceable(ty, check) {
            shown: sema_type_show(ty)
            written: sema_expression_interpolation_text(value.span, check)
            check.diagnostics.push(sema_lint("L0520", value.span, "{shown} has no `Display` impl; use the explicit debug selector for this interpolation.", "Bare interpolation is moving to the explicit `Display` hook; the canonical migration edit keeps the value user-owned.", "Replace `{written}` with `{{{written}:Debug}}`."))
        }
        return true
    }
    if sema_call_reflection_secret_bearing(ty) {
        check.diagnostics.push(sema_error("E0915", value.span, "secret-bearing `{type_name(ty)}` has no `Display` implementation", "cryptographic secrets cannot enter logs or strings through interpolation", "remove the interpolation; log a public operation label or key identifier instead"))
        return false
    }
    if sema_call_reflection_one_pass(ty) {
        check.diagnostics.push(sema_error("E0915", value.span, "the one-pass source {sema_type_show(ty)} has no `Display` implementation", "reading this value consumes it, so showing it would spend the only pass", sema_expression_one_pass_fix(ty)))
        return false
    }
    if ty == .Named(name) {
        if sema_expression_distinct_bundles(name, check) == .Val(granted) {
            has: if granted.len() == 0 -> "no operation bundles" else -> "only {granted.join(", ")}"
            check.diagnostics.push(sema_error("E0138", value.span, "`{name}` doesn't support string interpolation", "a nominal type only gets the operations its operation bundles grant; `{name}` has {has}", "add `#Printable` before the declaration, or convert to the base type first"))
            return false
        }
    }
    // A function named in a hole is code, not a value to show: the lesson is the call.
    if ty == .Fn(_, _, _, _, _, _) {
        written: sema_expression_interpolation_text(value.span, check)
        check.diagnostics.push(sema_error("E0915", value.span, "the function `{written}` has no `Display` implementation", "a hole shows a value, and a function is code to run, not text", "call it in the hole: `{{{written}()}}`"))
        return false
    }
    // sema_type_show quotes a nominal name itself; the impl head is bare code.
    // The Fix offers only spellings that compile for this value: an `impl`
    // where the orphan rule (E0902) admits one, nested in the type's body
    // when this module declares it as a struct or enum (impl placement,
    // L0535), and `:Debug` where the value has a Debug form (else that hole
    // is E0112).
    written: sema_expression_interpolation_text(value.span, check)
    ^fixes: [String]{}
    if sema_expression_impl_allowed(ty, check) {
        if sema_expression_impl_in_body(ty, check) {
            fixes.push("add `impl Display {{ display: fn(self) -> String {{ … }} }}` to the body of `{type_name(ty)}`")
        } else {
            fixes.push("add `impl {type_name(ty)}.Display {{ display: fn(self) -> String {{ … }} }}`")
        }
    }
    if sema_call_debug_traceable(ty, check) {
        fixes.push("use `{{{written}:Debug}}` for debug output")
    }
    fix: if fixes.len() > 0 -> fixes.join(", or ") else -> "show a part of `{written}` that has `Display`, or write the text yourself instead of interpolating it"
    check.diagnostics.push(sema_error("E0915", value.span, "{sema_type_show(ty)} has no `Display` implementation", "bare `{{value}}` interpolation calls `Display` — there is no default for user types", fix))
    false
}

// Whether this program may write an `impl` for `ty`'s own trait set: the
// orphan rule (E0902) admits one for a type declared outside Core.
sema_expression_impl_allowed: fn(ty: Type, check: ^SemaBodyCheck) -> Bool {
    if ty == .Tagged(_, _) -> return false
    name: sema_type_graph_base_name(ty) ?? return false
    owner: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, name) ?? return false
    !sema_module_is_core_source(sema_scope_module_text(check.environment.*, check.program.*, owner.module_identity))
}

// Whether `ty` is a struct or enum the environment's own module declares,
// whose body then holds its impls (L0535).
sema_expression_impl_in_body: fn(ty: Type, check: SemaBodyCheck) -> Bool Never! {
    graph: check.program.registration_graph
    caller: sema_scope_caller_index(check.environment.*, graph) ?? return false
    row: sema_type_resolve_nominal_row_at(graph, ty, caller) ?? return false
    if row.module_index != caller -> return false
    kind: graph.modules[row.module_index].nominals[row.row].kind
    kind == .Struct || kind == .Enum
}

// The source text of the interpolated expression at `span`, or `value` when
// the module source does not hold it.
sema_expression_interpolation_text: fn(span: Span, check: SemaBodyCheck) -> String {
    graph: check.program.registration_graph
    if sema_scope_caller_index(check.environment.*, graph) == .Val(caller) {
        raw: graph.modules[caller].source.bytes()
        if span.start >= 0 && span.end <= raw.len() && span.start < span.end {
            text: String.from_bytes(raw[span.start..<span.end]) ?? ""
            if text != "" -> return text
        }
    }
    "value"
}
