// Checked collection, scalar, indexing, slicing, and range expressions.
fn sema_expression_unit_literal_type_name(name: String) -> String {
    output := ""
    loop piece in name.split("_") {
        if piece == "" -> next
        bytes := piece.bytes()
        if bytes.len() == 0 -> next
        code :: Int.from_u8(bytes[0])
        if code >= 97 && code <= 122 -> bytes[0] = U8{code - 32}
        output = "{output}{String.from_bytes(bytes) ?? piece}"
    }
    if output == "" -> name else -> output
}

fn sema_expression_unit_literal_time_fact(suffix: String, graph: SemaRegistrationGraph) -> ?SemaRegistrationUnitFact {
    loop module_row in graph.modules {
        loop item in module_row.program.items {
            if item == {
                .UnitFamily(definition) -> {
                    owner :: definition.resolved_owner ?? ""
                    if definition.family != "Time" || owner != "core.units" -> next
                    loop member in definition.members {
                        if member.name == suffix {
                            return Val(SemaRegistrationUnitFact{
                                name: "Duration",
                                package: definition.resolved_owner ?? "core.units",
                                family: "Time",
                                member: member.name,
                                dimension: definition.resolved_dimension,
                                scale: member.scale,
                                scale_provenance: member.scale_provenance,
                                offset: UnitRatio{numerator: 0, denominator: 1},
                                kind: QuantityKind.Delta,
                            })
                        }
                    }
                }
                else -> {}
            }
        }
    }
    None
}

fn sema_expression_unit_literal_fact(suffix: String, graph: SemaRegistrationGraph) -> ?SemaRegistrationUnitFact {
    time_fact :: sema_expression_unit_literal_time_fact(suffix, graph)
    if time_fact == .Val(fact) -> return Val(fact)
    type_name :: sema_expression_unit_literal_type_name(suffix)
    registered :: sema_registration_unit_fact_for_type(graph, Type.Named(type_name))
    if registered == .Val(fact) && fact.member == suffix && fact.kind == QuantityKind.Linear -> return Val(fact)
    loop module_row in graph.modules {
        loop item in module_row.program.items {
            if item == {
                .UnitFamily(definition) -> {
                    owner :: definition.resolved_owner ?? ""
                    if definition.family == "Time" && owner == "core.units" -> next
                    has_offset_member :: loop member in definition.members {
                        if member.offset.numerator != 0 -> break true
                    } ?? false
                    if definition.base != None && has_offset_member -> next
                    loop member in definition.members {
                        if member.name == suffix {
                            return Val(SemaRegistrationUnitFact{
                                name: sema_expression_unit_literal_type_name(member.name),
                                package: definition.resolved_owner ?? module_row.package_identity,
                                family: definition.family,
                                member: member.name,
                                dimension: definition.resolved_dimension,
                                scale: member.scale,
                                scale_provenance: member.scale_provenance,
                                offset: member.offset,
                                kind: QuantityKind.Linear,
                            })
                        }
                    }
                }
                else -> {}
            }
        }
    }
    None
}

fn sema_expression_unit_literal(raw: String, int_value: ?Int, float_value: ?Float, suffix: String, suffix_span: Span, span: Span, expected: ?Type, environment: SemaScopeEnvironment, diagnostics: &[Diagnostic]) -> ?TExpr {
    graph :: environment.registration_graph
    if suffix != "" && graph == .Val(facts_graph) {
        fact :: sema_expression_unit_literal_fact(suffix, facts_graph)
        if fact == .Val(unit) {
            if unit.name == "Duration" && unit.family == "Time" {
                is_float := float_value != None
                unit_value := if is_float -> sema_tir_expr(Type.Float, TExprKind.FloatLit(float_value ?? 0.0), span) else -> sema_tir_expr(Type.Int, TExprKind.IntLit(int_value ?? 0, None), span)
                if {
                    unit.scale.denominator != 1 -> {
                        unit_value = sema_tir_expr(Type.Float, TExprKind.FloatLit(Float.from_int(int_value ?? 0)), span)
                        if is_float -> unit_value = sema_tir_expr(Type.Float, TExprKind.FloatLit(float_value ?? 0.0), span)
                        is_float = true
                        factor :: Float.from_int(unit.scale.numerator) / Float.from_int(unit.scale.denominator)
                        factor_value :: sema_tir_expr(Type.Float, TExprKind.FloatLit(factor), span)
                        line :: sema_source_line_at(environment.source_segments, span) ?? 0
                        unit_value = sema_tir_expr(Type.Float, TExprKind.Binary(TBinaryOp.Mul, false, line, unit_value, factor_value), span)
                    }
                    unit.scale.numerator != 1 -> {
                        factor_value :: if is_float -> sema_tir_expr(Type.Float, TExprKind.FloatLit(Float.from_int(unit.scale.numerator)), span) else -> sema_tir_expr(Type.Int, TExprKind.IntLit(unit.scale.numerator, None), span)
                        line :: sema_source_line_at(environment.source_segments, span) ?? 0
                        result_ty :: if is_float -> Type.Float else -> Type.Int
                        unit_value = sema_tir_expr(result_ty, TExprKind.Binary(TBinaryOp.Mul, false, line, unit_value, factor_value), span)
                    }
                }
                constructed_ty :: Type.Result(Type.Named("Duration"), Type.Named("RangeError"))
                constructed :: sema_tir_expr(constructed_ty, TExprKind.HandleMethod(unit_value, THandleOp.DurationNew("Nanoseconds", is_float), [TExpr]{}), span)
                message :: sema_tir_expr(Type.String, TExprKind.StrLit([TStrPart]{TStrPart.Literal("time literal is outside Duration's i64 range")}), span)
                fallback :: TOrFallback.Panic(message, sema_expression_panic_location(environment, suffix_span))
                checked :: sema_tir_expr(Type.Named("Duration"), TExprKind.OrFallback(constructed, fallback), span)
                return sema_expr_expected(checked, expected, environment, &diagnostics)
            }
            if int_value == None && float_value == None {
                diagnostics.push(sema_error("E0109", span, "this unit literal has no numeric value", "a literal needs an integer or floating-point payload", "write a numeric literal"))
                return None
            }
            numeric :: if float_value != None -> sema_tir_expr(Type.Float, TExprKind.FloatLit(float_value ?? 0.0), span) else -> sema_tir_expr(Type.Float, TExprKind.FloatLit(Float.from_int(int_value ?? 0)), span)
            destination_symbol :: symbol_id(SymbolKind.Type, unit.package, "", unit.name)
            value :: sema_tir_expr(Type.Named(unit.name), TExprKind.DistinctCtor(destination_symbol, numeric, Type.Float), span)
            return sema_expr_expected(value, expected, environment, &diagnostics)
        }
        if suffix == "i" {
            imaginary :: float_value ?? Float.from_int(int_value ?? 0)
            real :: sema_tir_expr(Type.Float, TExprKind.FloatLit(0.0), span)
            imaginary_value :: sema_tir_expr(Type.Float, TExprKind.FloatLit(imaginary), span)
            value :: sema_tir_expr(Type.Named("Complex"), TExprKind.PreciseBuiltin("Complex", "from_parts", [TExpr]{real, imaginary_value}), span)
            return sema_expr_expected(value, expected, environment, &diagnostics)
        }
        diagnostics.push(sema_error("E0134", suffix_span, "`{suffix}` isn't a unit in scope", "a unit suffix names a member of a `#UnitFamily` you've imported; this suffix isn't one here", "import the family that defines `{suffix}`, or write the number without a suffix"))
        return None
    }
    if suffix != "" {
        if suffix == "i" {
            imaginary :: float_value ?? Float.from_int(int_value ?? 0)
            real :: sema_tir_expr(Type.Float, TExprKind.FloatLit(0.0), span)
            imaginary_value :: sema_tir_expr(Type.Float, TExprKind.FloatLit(imaginary), span)
            value :: sema_tir_expr(Type.Named("Complex"), TExprKind.PreciseBuiltin("Complex", "from_parts", [TExpr]{real, imaginary_value}), span)
            return sema_expr_expected(value, expected, environment, &diagnostics)
        }
        diagnostics.push(sema_error("E0134", suffix_span, "`{suffix}` isn't a unit in scope", "a unit suffix names a member of a `#UnitFamily` you've imported; this suffix isn't one here", "import the family that defines `{suffix}`, or write the number without a suffix"))
        return None
    }
    if int_value != None -> return sema_expr_expected(sema_tir_expr(Type.Int, TExprKind.IntLit(int_value ?? 0, None), span), expected, environment, &diagnostics)
    if float_value != None -> return sema_expr_expected(sema_tir_expr(Type.Float, TExprKind.FloatLit(float_value ?? 0.0), span), expected, environment, &diagnostics)
    diagnostics.push(sema_error("E0109", span, "this unit literal has no numeric value", "a literal needs an integer or floating-point payload", "write a numeric literal"))
    None
}

fn sema_expression_list_trait_coercion(ty: Type) -> ?Type {
    if ty == {
        .List(element) | .FixedList(element, _) -> if element == {
            .TraitObject(bounds) -> if bounds.len() == 1 -> Val(element) else -> None
            else -> None
        }
        else -> None
    }
}

fn sema_expression_list_elements(elements: [Expr], expected_element: ?Type, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> ?[TExpr] {
    values := [TExpr]{}
    loop element in elements {
        if element == {
            .Spread(value, span) -> {
                _ := value
                diagnostics.push(sema_error("E1311", span, "a spread must be expanded before list checking", "the checked list TIR stores each element explicitly", "use a list value without `...`, or expand the list at its source"))
                return None
            }
            else -> {}
        }
        checked :: if expected_element != None -> sema_check_expression(element, expected_element, environment, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(element, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        value :: checked ?? return None
        if expected_element == .Val(required) {
            compatible :: sema_expr_expected_assignable(required, value.ty, environment) ?? return None
            if !compatible {
                diagnostics.push(sema_type_mismatch(sema_expr_expected_type(required, environment), sema_expr_expected_type(value.ty, environment), expr_span(element)))
                return None
            }
        }
        values.push(value)
    }
    Val(values)
}

fn sema_expression_list(expr: Expr, elements: [Expr], span: Span, expected: ?Type, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> ?TExpr {
    expected_element := None
    result_ty := None
    if expected == .Val(expected_ty) {
        normalized :: sema_expr_expected_type(sema_expr_unwrap_tag(expected_ty), environment)
        if normalized == {
            .List(element) -> {
                expected_element = Val(element)
                result_ty = Val(normalized)
            }
            .FixedList(element, len) -> {
                expected_element = Val(element)
                if measure_literal_value(len) == None || (measure_literal_value(len) ?? 0) != elements.len() {
                    diagnostics.push(sema_error("E0108", span, "this fixed list has the wrong number of elements", "a fixed list's length is part of its type", "provide exactly {measure_expression(len)} elements"))
                    return None
                }
                result_ty = Val(normalized)
            }
            else -> {}
        }
    }
    values :: sema_expression_list_elements(elements, expected_element, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if result_ty == None {
        if values.len() == 0 {
            diagnostics.push(sema_error("E0119", span, "an empty list needs an expected element type", "there is no element from which to infer `[]`", "annotate the list as `[T]` or bind it to a typed value"))
            return None
        }
        first :: values[0].ty
        loop index in 1..<values.len() {
            compatible :: sema_expr_expected_assignable(first, values[index].ty, environment) ?? return None
            if !compatible {
                diagnostics.push(sema_type_mismatch(sema_expr_expected_type(first, environment), sema_expr_expected_type(values[index].ty, environment), expr_span(elements[index])))
                return None
            }
        }
        result_ty = Val(Type.List(first))
    }
    ty :: result_ty ?? Type.List(Type.Named("Unit"))
    trait_coercion :: sema_expression_list_trait_coercion(ty)
    sema_expr_expected(sema_tir_expr(ty, TExprKind.List(values, trait_coercion), span), expected, environment, &diagnostics)
}

fn sema_expression_map(expr: Expr, entries: [ExprPair], span: Span, expected: ?Type, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> ?TExpr {
    expected_key := None
    expected_value := None
    result_ty := None
    if expected == .Val(expected_ty) {
        normalized :: sema_expr_unwrap_tag(expected_ty)
        if normalized == {
            .Map(key, _, value) -> {
                expected_key = Val(key)
                expected_value = Val(value)
                result_ty = Val(normalized)
            }
            else -> {}
        }
    }
    if entries.len() == 0 {
        if result_ty == None {
            diagnostics.push(sema_error("E0119", span, "an empty map needs an expected key and value type", "there is no entry from which to infer `[:]`", "annotate the map before constructing it"))
            return None
        }
        ty :: result_ty ?? Type.Map(Type.Int, None, Type.Int)
        return sema_expr_expected(sema_tir_expr(ty, TExprKind.Map([TMapEntry]{}), span), expected, environment, &diagnostics)
    }
    lowered := [TMapEntry]{}
    inferred_key := None
    inferred_value := None
    loop entry in entries {
        key :: if expected_key != None -> sema_check_expression(entry.key, expected_key, environment, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(entry.key, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        value :: if expected_value != None -> sema_check_expression(entry.value, expected_value, environment, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(entry.value, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        checked_key :: key ?? return None
        checked_value :: value ?? return None
        if expected_key == .Val(key_ty) {
            compatible_key :: sema_expr_expected_assignable(key_ty, checked_key.ty, environment) ?? return None
            if !compatible_key -> return None
        }
        if expected_value == .Val(value_ty) {
            compatible_value :: sema_expr_expected_assignable(value_ty, checked_value.ty, environment) ?? return None
            if !compatible_value -> return None
        }
        if {
            inferred_key == None -> inferred_key = Val(checked_key.ty)
            !type_identity_equal(inferred_key ?? checked_key.ty, checked_key.ty) -> {
                diagnostics.push(sema_error("E0108", expr_span(entry.key), "map keys need one common type", "all entries in a map share one key type", "use keys of the same type"))
                return None
            }
        }
        if {
            inferred_value == None -> inferred_value = Val(checked_value.ty)
            !type_identity_equal(inferred_value ?? checked_value.ty, checked_value.ty) -> {
                diagnostics.push(sema_error("E0108", expr_span(entry.value), "map values need one common type", "all entries in a map share one value type", "use values of the same type"))
                return None
            }
        }
        lowered.push(TMapEntry{key: checked_key, value: checked_value})
    }
    if result_ty == None -> result_ty = Val(Type.Map(inferred_key ?? Type.Int, Val(expr_span(entries[0].key)), inferred_value ?? Type.Int))
    ty :: result_ty ?? Type.Map(Type.Int, None, Type.Int)
    sema_expr_expected(sema_tir_expr(ty, TExprKind.Map(lowered), span), expected, environment, &diagnostics)
}

fn sema_expression_tuple(fields: [TupleField], span: Span, expected: ?Type, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> ?TExpr {
    expected_fields := None
    if expected == .Val(expected_ty) {
        normalized :: sema_expr_unwrap_tag(expected_ty)
        if normalized == .Tuple(items) {
            expected_fields = Val(items)
        }
    }
    if expected != None && expected_fields == None {
        diagnostics.push(sema_type_mismatch(expected ?? Type.Int, Type.Tuple([TypeTupleField]{}), span))
        return None
    }
    values := [TExpr]{}
    types := [TypeTupleField]{}
    loop (index, field) in fields {
        duplicate :: loop previous in types {
            if previous.name == field.name -> break true
        } ?? false
        if duplicate {
            diagnostics.push(sema_error("E0105", span, "tuple field `{field.name}` is supplied more than once", "tuple field names must be unique", "remove the duplicate tuple field"))
            return None
        }
        field_expected := None
        if expected_fields == .Val(rows) {
            if index >= rows.len() || rows[index].name != field.name {
                diagnostics.push(sema_error("E0108", span, "tuple fields do not match the expected tuple type", "tuple names and positions are part of the tuple type", "use the declared tuple field names and order"))
                return None
            }
            field_expected = Val(rows[index].ty)
        }
        value :: sema_check_expression(field.value, field_expected, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        if field_expected == .Val(field_ty) {
            compatible :: sema_expr_expected_assignable(field_ty, value.ty, environment) ?? return None
            if !compatible -> return None
        }
        values.push(value)
        types.push(TypeTupleField{name: field.name, ty: value.ty})
    }
    if expected_fields != None && fields.len() != (expected_fields ?? [TypeTupleField]{}).len() {
        diagnostics.push(sema_error("E0108", span, "tuple fields do not match the expected tuple type", "tuple arity is part of the tuple type", "provide every tuple field exactly once"))
        return None
    }
    ty :: Type.Tuple(types)
    sema_expr_expected(sema_tir_expr(Type.Tuple(types), TExprKind.Tuple(values), span), expected, environment, &diagnostics)
}

fn sema_expression_range(start: Expr, end: Expr, exclusive: Bool, span: Span, expected: ?Type, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> ?TExpr {
    lhs :: sema_check_expression(start, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    rhs :: sema_check_expression(end, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if !sema_expr_is_integer(lhs.ty) {
        diagnostics.push(sema_error("E0505", expr_span(start), "range bounds must be Int", "a Range stores whole-number start and end bounds", "use Int values on both sides of the range"))
        return None
    }
    if !sema_expr_is_integer(rhs.ty) {
        diagnostics.push(sema_error("E0505", expr_span(end), "range bounds must be Int", "a Range stores whole-number start and end bounds", "use Int values on both sides of the range"))
        return None
    }
    value :: sema_tir_expr(Type.Named("Range"), TExprKind.Range(lhs, rhs, exclusive), span)
    sema_expr_expected(value, expected, environment, &diagnostics)
}

fn sema_expression_char_codepoint(text: String) -> ?Int {
    bytes :: text.bytes()
    if bytes.len() == 0 -> return None
    first :: Int.from_u8(bytes[0])
    if first < 128 -> return Val(first)
    width :: if {
        first >= 192 && first < 224 -> 2
        first >= 224 && first < 240 -> 3
        first >= 240 && first < 248 -> 4
        else -> 0
    }
    if width == 0 || bytes.len() < width -> return None
    value :: if width == {
        2 -> (first - 192) * 64 + (Int.from_u8(bytes[1]) - 128)
        3 -> (first - 224) * 4096 + (Int.from_u8(bytes[1]) - 128) * 64 + (Int.from_u8(bytes[2]) - 128)
        4 -> (first - 240) * 262144 + (Int.from_u8(bytes[1]) - 128) * 4096 + (Int.from_u8(bytes[2]) - 128) * 64 + (Int.from_u8(bytes[3]) - 128)
        else -> 0
    }
    Val(value)
}

fn sema_expression_char(text: String, span: Span, expected: ?Type, environment: SemaScopeEnvironment, diagnostics: &[Diagnostic]) -> ?TExpr {
    value :: sema_expression_char_codepoint(text) ?? {
        diagnostics.push(sema_error("E0001", span, "this character literal is not valid UTF-8", "a Char stores one Unicode scalar value", "write one valid character between single quotes"))
        return None
    }
    sema_expr_expected(sema_tir_expr(Type.Char, TExprKind.CharLit(value), span), expected, environment, &diagnostics)
}

fn sema_expression_index(base: Expr, index: Expr, ast_kind: IndexKind, span: Span, expected: ?Type, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> ?TExpr {
    checked_base :: sema_check_expression(base, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    base_ty :: sema_expr_unwrap_tag(checked_base.ty)
    index_expected :: if base_ty == {
        .List(_) -> Val(Type.Int)
        .FixedList(_, _) -> Val(Type.Int)
        .Map(key, _, _) -> Val(key)
        .Apply(name, args) -> if (name == "View" || name == "ViewMut") && args.len() == 1 -> Val(Type.Int) else -> None
        else -> None
    }
    checked_index :: if index_expected != None -> sema_check_expression(index, index_expected, environment, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(index, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    result_ty := None
    resolved_kind := ast_kind
    if base_ty == {
        .List(element) -> {
            if checked_index.ty == Type.Named("Range") {
                resolved_kind = IndexKind.Range
                result_ty = Val(Type.List(element))
            } else {
                if !sema_expression_integer_index(checked_index, expr_span(index), &diagnostics) -> return None
                result_ty = Val(element)
            }
        }
        .FixedList(element, len) -> {
            if !sema_expression_integer_index(checked_index, expr_span(index), &diagnostics) -> return None
            length :: measure_literal_value(len) ?? {
                diagnostics.push(sema_error("E0965", expr_span(index), "a fixed-list length is not a checked integer measure", "fixed indexing needs a concrete list length", "use a literal fixed-list length"))
                return None
            }
            if checked_index.integer_bounds == .Val(bounds) {
                if bounds.lo < 0 || bounds.hi >= length {
                    diagnostics.push(sema_error("E0965", expr_span(index), "the index is outside this fixed-size list", "valid indexes run from 0 through {length - 1}", "use an index inside the fixed-list bounds"))
                    return None
                }
                resolved_kind = IndexKind.FixedListProof
            } else {
                resolved_kind = if ast_kind == IndexKind.FixedListProof -> IndexKind.FixedListProof else -> IndexKind.List
            }
            result_ty = Val(element)
        }
        .Map(_, _, value) -> {
            resolved_kind = IndexKind.Map
            result_ty = Val(value)
        }
        .Apply(name, args) -> {
            if (name == "View" || name == "ViewMut") && args.len() == 1 {
                if !sema_expression_integer_index(checked_index, expr_span(index), &diagnostics) -> return None
                resolved_kind = IndexKind.List
                result_ty = Val(args[0])
            }
        }
        .String -> {
            diagnostics.push(sema_error("E0503", span, "strings are not indexed with `[ ]`", "text is counted in characters, while brackets index storage positions", "use `.chars()` or slice the string with a Range"))
            return None
        }
        else -> {}
    }
    if result_ty == None {
        diagnostics.push(sema_error("E0505", span, "only lists and maps can be indexed, not {type_name(checked_base.ty)}", "indexing needs a collection with a declared element or value type", "use `[ ]` on a List or Map"))
        return None
    }
    kind :: sema_expression_index_kind(resolved_kind, base_ty)
    value :: sema_tir_expr(result_ty ?? Type.Named("Unit"), TExprKind.Index(checked_base, checked_index, kind, AccessConvention.Read, None, sema_expression_panic_location(environment, span)), span)
    sema_expr_expected(value, expected, environment, &diagnostics)
}

fn sema_expression_slice(base: Expr, start: Expr, end: Expr, range: ?Expr, span: Span, expected: ?Type, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> ?TExpr {
    checked_base :: sema_check_expression(base, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    result_ty := None
    range_value := None
    checked_start := None
    checked_end := None
    if range == .Val(range_expr) {
        range_checked :: sema_check_expression(range_expr, Val(Type.Named("Range")), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        if range_checked.ty != Type.Named("Range") -> return None
        range_value = Val(range_checked)
        if sema_expr_unwrap_tag(checked_base.ty) == {
            .List(element) -> result_ty = Val(Type.List(element))
            .FixedList(element, _) -> result_ty = Val(Type.List(element))
            .String -> result_ty = Val(Type.String)
            else -> {}
        }
    } else {
        start_checked :: sema_check_expression(start, Val(Type.Int), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        end_checked :: sema_check_expression(end, Val(Type.Int), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        if !sema_expr_is_integer(start_checked.ty) || !sema_expr_is_integer(end_checked.ty) -> return None
        checked_start = Val(start_checked)
        checked_end = Val(end_checked)
        if sema_expr_unwrap_tag(checked_base.ty) == {
            .List(element) -> result_ty = Val(Type.List(element))
            .FixedList(element, _) -> result_ty = Val(Type.List(element))
            .String -> result_ty = Val(Type.String)
            else -> {}
        }
    }
    if result_ty == None {
        diagnostics.push(sema_error("E0505", span, "only lists and strings can be sliced, not {type_name(checked_base.ty)}", "a Range projects a window from indexed storage", "slice a List or String value"))
        return None
    }
    zero_start :: sema_tir_expr(Type.Int, TExprKind.IntLit(0, None), span)
    zero_end :: sema_tir_expr(Type.Int, TExprKind.IntLit(0, None), span)
    result :: sema_tir_expr(result_ty ?? Type.Named("Unit"), TExprKind.Slice(checked_base, checked_start ?? zero_start, checked_end ?? zero_end, range_value, sema_expression_panic_location(scopes, span)), span)
    sema_expr_expected(result, expected, environment, &diagnostics)
}
