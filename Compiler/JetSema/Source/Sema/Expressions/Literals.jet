// Checked collection, scalar, indexing, slicing, and range expressions.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    Diagnostic,
    Expr,
    ExprMember,
    ExprPair,
    IndexKind,
    QuantityKind,
    Span,
    SymbolKind,
    TBinaryOp,
    TExpr,
    TExprKind,
    THandleOp,
    TListSpreadPart,
    TMapEntry,
    TOrFallback,
    TStrPart,
    TupleField,
    Type,
    TypeTupleField,
    UnOp,
    UnitRatio,
    expr_span,
    measure_expression,
    measure_literal_value,
    symbol_id,
    tir_expr_known_bounds,
    type_identity_equal,
    type_name,
    type_tuple_fields_canonical,
]

fn sema_expression_unit_literal_type_name(name: String) -> String Never! {
    output := ""
    loop piece in name.split("_") {
        if piece == "" -> next
        bytes := piece.bytes()
        if bytes.len() == 0 -> next
        code :: Int.from_u8(bytes[0])
        if code >= 97 && code <= 122 -> bytes[0] = U8{code - 32}
        output = "{output}{String.from_bytes(bytes) ?? piece}"
    }
    if output == "" -> name else -> output
}

fn sema_expression_unit_literal_time_fact(suffix: String, graph: SemaRegistrationGraph) -> SemaRegistrationUnitFact? {
    loop module_row_index in 0..<graph.modules.len() {
        loop item_index in 0..<graph.modules[module_row_index].program.items.len() {
            if graph.modules[module_row_index].program.items[item_index] == {
                .UnitFamily(definition) -> {
                    owner :: definition.resolved_owner ?? ""
                    if definition.family != "Time" || owner != "core.units" -> next
                    loop member in definition.members {
                        if member.name == suffix {
                            return Val(SemaRegistrationUnitFact{
                                name: "Duration",
                                package: definition.resolved_owner ?? "core.units",
                                family: "Time",
                                member: member.name,
                                dimension: definition.resolved_dimension,
                                scale: member.scale,
                                scale_provenance: member.scale_provenance,
                                offset: UnitRatio{numerator: 0, denominator: 1},
                                kind: QuantityKind.Delta,
                            })
                        }
                    }
                }
                else -> {}
            }
        }
    }
    None
}

fn sema_expression_unit_literal_fact(suffix: String, graph: SemaRegistrationGraph) -> SemaRegistrationUnitFact? {
    time_fact :: sema_expression_unit_literal_time_fact(suffix, graph)
    if time_fact == .Val(fact) -> return Val(fact)
    type_name :: sema_expression_unit_literal_type_name(suffix)
    registered :: sema_registration_unit_fact_for_type(graph, Type.Named{name: type_name})
    if registered == .Val(fact) && fact.member == suffix && fact.kind == QuantityKind.Linear -> return Val(fact)
    loop module_row_index in 0..<graph.modules.len() {
        loop item_index in 0..<graph.modules[module_row_index].program.items.len() {
            if graph.modules[module_row_index].program.items[item_index] == {
                .UnitFamily(definition) -> {
                    owner :: definition.resolved_owner ?? ""
                    if definition.family == "Time" && owner == "core.units" -> next
                    has_offset_member :: loop member in definition.members {
                        if member.offset.numerator != 0 -> break true
                    } ?? false
                    if definition.base != None && has_offset_member -> next
                    loop member in definition.members {
                        if member.name == suffix {
                            return Val(SemaRegistrationUnitFact{
                                name: sema_expression_unit_literal_type_name(member.name),
                                package: definition.resolved_owner ?? graph.modules[module_row_index].package_identity,
                                family: definition.family,
                                member: member.name,
                                dimension: definition.resolved_dimension,
                                scale: member.scale,
                                scale_provenance: member.scale_provenance,
                                offset: member.offset,
                                kind: QuantityKind.Linear,
                            })
                        }
                    }
                }
                else -> {}
            }
        }
    }
    None
}

fn sema_expression_unit_literal(raw: String, int_value: Int?, float_value: Float?, suffix: String, suffix_span: Span, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> TExpr? {
    if suffix != "" && program.registration_graph == .Val(facts_graph) {
        fact :: sema_expression_unit_literal_fact(suffix, facts_graph)
        if fact == .Val(unit) {
            if unit.name == "Duration" && unit.family == "Time" {
                is_float := float_value != None
                unit_value := if is_float -> sema_tir_node(Type.Float, TExprKind.FloatLit{value: float_value ?? 0.0}, span) else -> sema_expr_unbounded_integer_literal(int_value ?? 0, span)
                if {
                    unit.scale.denominator != 1 -> {
                        unit_value = sema_tir_node(Type.Float, TExprKind.FloatLit{value: Float.from_int(int_value ?? 0)}, span)
                        if is_float -> unit_value = sema_tir_node(Type.Float, TExprKind.FloatLit{value: float_value ?? 0.0}, span)
                        is_float = true
                        factor :: Float.from_int(unit.scale.numerator) / Float.from_int(unit.scale.denominator)
                        factor_value :: sema_tir_node(Type.Float, TExprKind.FloatLit{value: factor}, span)
                        line :: sema_source_line_at(environment.source_segments, span) ?? 0
                        unit_value = sema_tir_node(Type.Float, TExprKind.Binary{op: TBinaryOp.Mul, overflow: false, line: line, lhs: unit_value, rhs: factor_value}, span)
                    }
                    unit.scale.numerator != 1 -> {
                        factor_value :: if is_float -> sema_tir_node(Type.Float, TExprKind.FloatLit{value: Float.from_int(unit.scale.numerator)}, span) else -> sema_expr_unbounded_integer_literal(unit.scale.numerator, span)
                        line :: sema_source_line_at(environment.source_segments, span) ?? 0
                        result_ty :: if is_float -> Type.Float else -> Type.Int
                        unit_value = sema_tir_node(result_ty, TExprKind.Binary{op: TBinaryOp.Mul, overflow: false, line: line, lhs: unit_value, rhs: factor_value}, span)
                    }
                }
                constructed_ty :: Type.Result{ok: Type.Named{name: "Duration"}, err: Type.Named{name: "RangeError"}}
                constructed :: sema_tir_node(constructed_ty, TExprKind.HandleMethod{receiver: unit_value, operation: THandleOp.DurationNew{unit: "Nanoseconds", float: is_float}, args: [TExpr]{}}, span)
                message :: sema_tir_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: "time literal is outside Duration's i64 range"}}}, span)
                fallback :: TOrFallback.Panic{message: message, location: sema_expression_panic_location(environment, program, scopes, suffix_span)}
                checked :: sema_tir_node(Type.Named{name: "Duration"}, TExprKind.OrFallback{value: constructed, fallback: fallback, ambient_err: None}, span)
                return sema_expr_expected_owned(^checked, expected, environment, program, &diagnostics)
            }
            if int_value == None && float_value == None {
                &diagnostics.push(sema_error("E0109", span, "this unit literal has no numeric value", "a literal needs an integer or floating-point payload", "write a numeric literal"))
                return None
            }
            numeric :: if float_value != None -> sema_tir_node(Type.Float, TExprKind.FloatLit{value: float_value}, span) else -> sema_tir_node(Type.Float, TExprKind.FloatLit{value: Float.from_int(int_value ?? 0)}, span)
            value :: sema_tir_node(Type.Named{name: unit.name}, TExprKind.DistinctCtor{argument: numeric}, span)
            return sema_expr_expected_owned(^value, expected, environment, program, &diagnostics)
        }
        if suffix == "i" {
            imaginary :: float_value ?? Float.from_int(int_value ?? 0)
            real :: sema_tir_node(Type.Float, TExprKind.FloatLit{value: 0.0}, span)
            imaginary_value :: sema_tir_node(Type.Float, TExprKind.FloatLit{value: imaginary}, span)
            value :: sema_tir_node(Type.Named{name: "Complex"}, TExprKind.PreciseBuiltin{type_name: "Complex", function: "from_parts", args: [TExpr]{real, imaginary_value}}, span)
            return sema_expr_expected_owned(^value, expected, environment, program, &diagnostics)
        }
        &diagnostics.push(sema_error("E0134", suffix_span, "`{suffix}` isn't a unit in scope", "a unit suffix names a member of a `#UnitFamily` you've imported; this suffix isn't one here", "import the family that defines `{suffix}`, or write the number without a suffix"))
        return None
    }
    if suffix != "" {
        if suffix == "i" {
            imaginary :: float_value ?? Float.from_int(int_value ?? 0)
            real :: sema_tir_node(Type.Float, TExprKind.FloatLit{value: 0.0}, span)
            imaginary_value :: sema_tir_node(Type.Float, TExprKind.FloatLit{value: imaginary}, span)
            value :: sema_tir_node(Type.Named{name: "Complex"}, TExprKind.PreciseBuiltin{type_name: "Complex", function: "from_parts", args: [TExpr]{real, imaginary_value}}, span)
            return sema_expr_expected_owned(^value, expected, environment, program, &diagnostics)
        }
        &diagnostics.push(sema_error("E0134", suffix_span, "`{suffix}` isn't a unit in scope", "a unit suffix names a member of a `#UnitFamily` you've imported; this suffix isn't one here", "import the family that defines `{suffix}`, or write the number without a suffix"))
        return None
    }
    if int_value != None -> return sema_expr_expected_owned(sema_expr_unbounded_integer_literal(int_value, span), expected, environment, program, &diagnostics)
    if float_value != None -> return sema_expr_expected_owned(sema_tir_node(Type.Float, TExprKind.FloatLit{value: float_value}, span), expected, environment, program, &diagnostics)
    &diagnostics.push(sema_error("E0109", span, "this unit literal has no numeric value", "a literal needs an integer or floating-point payload", "write a numeric literal"))
    None
}

fn sema_expression_list_trait_coercion(ty: Type) -> Type? {
    if ty == {
        .List(element) | .FixedList(element, _) -> if element == {
            .TraitObject(bounds) -> if bounds.len() == 1 -> Val(element) else -> None
            else -> None
        }
        else -> None
    }
}

struct SemaExpressionListCheckedParts {
    parts: [TListSpreadPart]
    element_types: [Type]
}

fn sema_expression_list_element_needs_expected_type(element: Expr) -> Bool Never! {
    if element == {
        .StructLit(_, _, _, _, _, inferred, _, _) -> inferred
        .TypedLit(head, _, _, _) -> head == None
        .Paren(inner, _, _) -> sema_expression_list_element_needs_expected_type(inner)
        .Unary(op, inner, _, _) -> op == UnOp.Neg && sema_expression_list_element_needs_expected_type(inner)
        else -> false
    }
}

// `[["41"], [], ["x"]]`: an empty item takes its type from a sibling.
fn sema_expression_list_element_is_empty_list(element: Expr) -> Bool Never! {
    if element == {
        .ListLit(elements, _, _) -> elements.len() == 0
        .Paren(inner, _, _) -> sema_expression_list_element_is_empty_list(inner)
        else -> false
    }
}

fn sema_expression_list_mark_owned_value(value: Expr, state: &SemaOwnershipState, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if value == {
        .Ident(name, span, _) -> {
            binding_index :: sema_scope_resolve_index_at(scopes, name, span) ?? return true
            binding := scopes.bindings[binding_index]
            if binding.symbol.kind != SymbolKind.Local -> return true
            // A share site copies; the source stays usable.
            if sema_ownership_is_share_site(state, span) -> return true
            if sema_ownership_report_invalidated_view(&state, value, scopes, span, &diagnostics) -> return false
            places := sema_ownership_places_from_expr_in_state(value, scopes, &state)
            if places.len() == 0 -> return true
            if sema_ownership_report_own_place_moved(&state, value, scopes, &diagnostics) -> return false
            loop place in places {
                if sema_ownership_place_moved(&state, place) == .Val(origin) {
                    sema_ownership_report_moved(&state, place, origin, span, &diagnostics)
                    return false
                }
                if sema_ownership_active_view_conflict_for_expr(&state, place, AccessConvention.Move, value, scopes) {
                    &diagnostics.push(sema_ownership_diag_live_reference(sema_ownership_place_name(place), span))
                    return false
                }
                if sema_ownership_active_loan_conflict(&state, place, AccessConvention.Move) != None {
                    &diagnostics.push(sema_ownership_diag_live_reference(sema_ownership_place_name(place), span))
                    return false
                }
            }
            if !sema_ownership_type_is_copy(binding.symbol.ty ?? Type.Named{name: "Unit"}) {
                origin :: sema_ownership_move_origin(value, binding.symbol.ty ?? Type.Named{name: "Unit"}, "the list literal", true)
                loop place in sema_ownership_moved_record_places(value, places, scopes, true) {
                    &state.moved.push(SemaOwnershipMovedPlace{place: place, origin: origin})
                }
                loop place in places {
                    if !sema_ownership_note_place_reference(&state, value, place, span, scopes, SemaOwnershipReferenceKind.Move) -> return false
                }
            }
            true
        }
        .Paren(inner, _, _) | .Present(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) | .Tainted(inner, _, _, _) -> sema_expression_list_mark_owned_value(inner, &state, &scopes, &diagnostics)
        else -> true
    }
}

fn sema_expression_list_check_clone(element: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    facts := sema_copy_classify(element, SemaCopyIntent.Clone, environment, program, context.generic_params, false)
    effect_name := sema_copy_effect_name(facts)
    if effect_name != None -> &context.copy_events.push(SemaCopyEvent{span: span, facts: facts})
    if !facts.accepted {
        diagnostic := sema_copy_diagnostic(facts, span)
        if diagnostic != None -> &diagnostics.push(diagnostic ?? sema_error("E0211", span, "`{type_name(element)}` can't be copied", "list spread clones each element while building the result", "spread values whose elements support `Clone`"))
        return false
    }
    if sema_copy_memory_operation(facts) != None && effect_name == None -> &context.copy_events.push(SemaCopyEvent{span: span, facts: facts})
    true
}

fn sema_expression_list_inference_error(element: Type, expected: Type, index: Int, span: Span, diagnostics: &[Diagnostic]) {
    &diagnostics.push(sema_error("E0504", span, "this list resolves to `{type_name(expected)}` but item {index + 1} is `{type_name(element)}`", "every item in a list literal must have the same type", "make every element the same type, or build the list in steps"))
}

fn sema_expression_list_elements(elements: [Expr], expected_element: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaExpressionListCheckedParts? {
    checked_parts := [TListSpreadPart?]{}
    element_types := [Type?]{}
    deferred := [Int]{}
    index := 0
    loop index < elements.len() {
        element := elements[index]
        if expected_element == None && (sema_expression_list_element_needs_expected_type(element) || sema_expression_list_element_is_empty_list(element)) {
            &checked_parts.push(None)
            &element_types.push(None)
            &deferred.push(index)
            index += 1
            next
        }
        if element == {
            .Spread(value, spread_span, _) -> {
                checked :: sema_check_expression(value, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
                if !sema_copy_site_check_guard_owned(checked, environment, program, scopes, context, &diagnostics, false) -> return None
                if !sema_expression_list_mark_owned_value(value, &state, &scopes, &diagnostics) -> return None
                normalized :: sema_expr_expected_type(sema_expr_unwrap_tag(checked.ty), environment, program)
                spread_element := if normalized == {
                    .List(inner) -> inner
                    else -> {
                        &diagnostics.push(sema_error("E1311", spread_span, "spread needs a list, not `{type_name(normalized)}`", "list spread `[...xs, y]` expands a list's elements in place", "spread a `[T]` value here"))
                        return None
                    }
                }
                if expected_element == .Val(required) {
                    compatible :: sema_expr_expected_assignable(required, spread_element, environment, program) ?? return None
                    if !compatible {
                        &diagnostics.push(sema_type_mismatch(sema_expr_expected_type(required, environment, program), sema_expr_expected_type(spread_element, environment, program), spread_span))
                        return None
                    }
                }
                &checked_parts.push(Val(TListSpreadPart.Spread{value: checked}))
                &element_types.push(Val(spread_element))
            }
            else -> {
                checked :: if expected_element != None -> sema_check_expression(element, expected_element, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(element, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                value :: checked ?? return None
                if !sema_copy_site_check_guard_owned(value, environment, program, scopes, context, &diagnostics, false) -> return None
                if !sema_expression_list_mark_owned_value(element, &state, &scopes, &diagnostics) -> return None
                if expected_element == .Val(required) {
                    compatible :: sema_expr_expected_assignable(required, value.ty, environment, program) ?? return None
                    if !compatible {
                        &diagnostics.push(sema_error("E0112", expr_span(element), "A list item needs {sema_type_show(sema_expr_expected_type(required, environment, program))}, but this is {sema_type_show(sema_expr_expected_type(value.ty, environment, program))}", "Every list item must match the list's element type", "Use {sema_type_show(sema_expr_expected_type(required, environment, program))} here"))
                        return None
                    }
                }
                &checked_parts.push(Val(TListSpreadPart.Element{value: value}))
                &element_types.push(Val(value.ty))
            }
        }
        index += 1
    }
    if expected_element == None && elements.len() > 0 {
        first := Type?{None}
        loop item_type in element_types {
            if item_type == .Val(ty) {
                first = Val(ty)
                break
            }
        }
        if first == None {
            loop deferred_index in deferred {
                element := elements[deferred_index]
                checked :: sema_check_expression(element, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                if checked == .Val(value) {
                    if !sema_copy_site_check_guard_owned(value, environment, program, scopes, context, &diagnostics, false) -> return None
                    if !sema_expression_list_mark_owned_value(element, &state, &scopes, &diagnostics) -> return None
                    checked_parts[deferred_index] = Val(TListSpreadPart.Element{value: value})
                    element_types[deferred_index] = Val(value.ty)
                    if first == None -> first = Val(value.ty)
                }
            }
        }
        first_type :: first ?? return None
        loop deferred_index in deferred {
            if checked_parts[deferred_index] != None -> next
            element := elements[deferred_index]
            value :: sema_check_expression(element, Val(first_type), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
            if !sema_copy_site_check_guard_owned(value, environment, program, scopes, context, &diagnostics, false) -> return None
            if !sema_expression_list_mark_owned_value(element, &state, &scopes, &diagnostics) -> return None
            checked_parts[deferred_index] = Val(TListSpreadPart.Element{value: value})
            element_types[deferred_index] = Val(value.ty)
        }
        inferred_element := first_type
        loop item_type in element_types {
            if item_type == .Val(candidate) && !type_identity_equal(inferred_element, candidate) {
                joined :: sema_expr_numeric_join(inferred_element, candidate)
                if joined == .Val(common) -> inferred_element = common
            }
        }
        inference_failed := false
        loop part_index in 0..<checked_parts.len() {
            item_type :: element_types[part_index] ?? next
            if type_identity_equal(item_type, inferred_element) -> next
            source_part :: checked_parts[part_index] ?? next
            if source_part == {
                .Spread(_) -> {
                    sema_expression_list_inference_error(item_type, inferred_element, part_index, expr_span(elements[part_index]), &diagnostics)
                    inference_failed = true
                }
                .Element(value) -> {
                    can_widen :: sema_expr_numeric_widening_to(item_type, inferred_element) ?? false
                    if {
                        can_widen -> {
                            line :: sema_source_line_at(environment.source_segments, expr_span(elements[part_index])) ?? 0
                            converted :: sema_expr_numeric_literal_conversion(value, inferred_element, expr_span(elements[part_index]), line, &diagnostics) ?? return None
                            checked_parts[part_index] = Val(TListSpreadPart.Element{value: converted})
                            element_types[part_index] = Val(inferred_element)
                        }
                        else -> {
                            sema_expression_list_inference_error(item_type, inferred_element, part_index, expr_span(elements[part_index]), &diagnostics)
                            inference_failed = true
                        }
                    }
                }
            }
        }
        if inference_failed -> return None
    }
    parts := [TListSpreadPart]{}
    resolved_types := [Type]{}
    loop slot in 0..<checked_parts.len() {
        part :: checked_parts[slot] ?? panic("checked list element inference left an unresolved part")
        item_type :: element_types[slot] ?? panic("checked list element inference lost its element type")
        &parts.push(part)
        &resolved_types.push(item_type)
    }
    Val(SemaExpressionListCheckedParts{parts: parts, element_types: resolved_types})
}

fn sema_expression_member_spread_fields(base: Expr, members: [ExprMember], span: Span) -> [Expr] Never! {
    fields := [Expr]{}
    loop member in members {
        &fields.push(Expr.Field{base: base, member: member.name, span: Span{start: span.start, end: member.span.end}, id: AST_NODE_GENERATED})
    }
    fields
}

fn sema_expression_list_member_spreads(elements: [Expr]) -> [Expr] Never! {
    expanded := [Expr]{}
    loop element in elements {
        if element == {
            .MemberSpread(base, members, span, _) -> {
                loop field in sema_expression_member_spread_fields(base, members, span) -> &expanded.push(field)
            }
            else -> &expanded.push(element)
        }
    }
    expanded
}

fn sema_expression_list(expr: Expr, elements: [Expr], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if sema_scope_environment_no_os(environment) -> &diagnostics.push(sema_error("E3303", span, "This no-OS program allocates memory but has no allocator fact.", "No-OS targets do not provide an implicit system heap.", "Select a typed allocator provider, or use heap-free Core operations."))
    has_spread := false
    loop element in elements {
        if element == {
            .Spread(_, _, _) -> has_spread = true
            else -> {}
        }
    }
    expected_element := Type?{None}
    result_ty := Type?{None}
    if expected == .Val(expected_ty) {
        normalized :: sema_expr_expected_type(sema_expr_unwrap_tag(expected_ty), environment, program)
        if normalized == {
            .Named(name) -> {
                if name == "Dyn" {
                    expected_element = Val(sema_dyn_type())
                    result_ty = Val(Type.List{element: sema_dyn_type()})
                }
            }
            .List(element) -> {
                expected_element = Val(element)
                result_ty = Val(normalized)
            }
            .FixedList(element, len) -> {
                if has_spread {
                    &diagnostics.push(sema_error("E1311", span, "list spread can't build a fixed-size `[T#N]` list", "spread expands a growable list — a `[T#N]` has a fixed compile-time length", "use a growable `[T]` binding (`::`/`:=`) instead of `[T#N]`"))
                    return None
                }
                expected_element = Val(element)
                if measure_literal_value(len) == .Val(expected_len) && expected_len != elements.len() {
                    element_suffix := if elements.len() == 1 -> "" else -> "s"
                    expected_suffix := if expected_len == 1 -> "" else -> "s"
                    &diagnostics.push(sema_error("E0963", span, "this list has {elements.len()} element{element_suffix}, but `[T#{measure_expression(len)}]` expects exactly {expected_len}", "a fixed-size list `[T#N]` requires exactly N elements", "provide exactly {expected_len} element{expected_suffix}"))
                    return None
                }
                result_ty = Val(normalized)
            }
            else -> {}
        }
    }
    // `ViewMut` elements coexist in the list: their overlap is the list's
    // alias check below, not the window each element opens.
    deferred_before :: state.deferred_view_opens.len()
    mutable_view_elements :: if expected_element == {
        .Val(element_ty) -> if element_ty == {
            .Apply(name, _) -> name == "ViewMut"
            else -> false
        }
        .None -> false
    }
    if mutable_view_elements {
        loop element_span in sema_ownership_list_view_element_spans(elements) -> &state.deferred_view_opens.push(element_span)
    }
    checked_elements := sema_expression_list_elements(elements, expected_element, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    loop state.deferred_view_opens.len() > deferred_before -> _ := &state.deferred_view_opens.pop()
    checked :: checked_elements ?? return None
    if result_ty == None {
        if checked.parts.len() == 0 {
            &diagnostics.push(sema_error("E0501", span, "an empty list needs a type", "write `[]` only where the list type is already known from around it", "name the element type on the literal, such as `[Int]{{}}`"))
            return None
        }
        result_ty = Val(Type.List{element: checked.element_types[0]})
    }
    if !has_spread -> sema_ownership_check_list_view_element_aliases(&state, elements, expected_element ?? checked.element_types[0], scopes, &diagnostics)
    ty :: result_ty ?? Type.List{element: Type.Named{name: "Unit"}}
    if has_spread {
        element_type :: if ty == {
            .List(element) -> element
            else -> panic("checked list spread result is not a growable list")
        }
        if !sema_expression_list_check_clone(element_type, span, environment, program, &context, &diagnostics) -> return None
        return sema_expr_expected_owned(sema_tir_node(ty, TExprKind.ListSpread{parts: checked.parts}, span), expected, environment, program, &diagnostics)
    }
    values := [TExpr]{}
    loop part in checked.parts {
        if part == {
            .Element(value) -> &values.push(value)
            else -> panic("list without spread contains a spread part")
        }
    }
    trait_coercion :: sema_expression_list_trait_coercion(ty)
    sema_expr_expected_owned(sema_tir_node(ty, TExprKind.List{values: values, trait_coercion: trait_coercion}, span), expected, environment, program, &diagnostics)
}

fn sema_expression_map(expr: Expr, entries: [ExprPair], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if sema_scope_environment_no_os(environment) -> &diagnostics.push(sema_error("E3303", span, "This no-OS program allocates memory but has no allocator fact.", "No-OS targets do not provide an implicit system heap.", "Select a typed allocator provider, or use heap-free Core operations."))
    expected_key := Type?{None}
    expected_value := Type?{None}
    result_ty := Type?{None}
    if expected == .Val(expected_ty) {
        normalized :: sema_expr_unwrap_tag(expected_ty)
        if normalized == {
            .Named(name) -> {
                if name == "Dyn" {
                    expected_key = Val(Type.String)
                    expected_value = Val(sema_dyn_type())
                    result_ty = Val(Type.Map{key: Type.String, key_span: None, value: sema_dyn_type()})
                }
            }
            .Map(key, key_span, value) -> {
                expected_key = Val(key)
                expected_value = Val(value)
                result_ty = Val(normalized)
                if entries.len() == 0 && !sema_type_map_key_eligible(environment, program, key) -> &diagnostics.push(sema_map_key_error("`{type_name(key)}` can't be a map key type", key_span ?? span))
            }
            else -> {}
        }
    }
    if entries.len() == 0 {
        if result_ty == None {
            &diagnostics.push(sema_error("E0501", span, "an empty map needs a type", "write `[]` only where the map type is already known from around it", "name the key and value types on the literal: `[String:Int].{{}}`"))
            return None
        }
        ty :: result_ty ?? Type.Map{key: Type.Int, key_span: None, value: Type.Int}
        return sema_expr_expected_owned(sema_tir_node(ty, TExprKind.Map{entries: [TMapEntry]{}}, span), expected, environment, program, &diagnostics)
    }
    lowered := [TMapEntry]{}
    inferred_key := Type?{None}
    inferred_value := Type?{None}
    loop entry in entries {
        key :: if expected_key != None -> sema_check_expression(entry.key, expected_key, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(entry.key, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        value :: if expected_value != None -> sema_check_expression(entry.value, expected_value, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(entry.value, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        checked_key :: key ?? return None
        checked_value :: value ?? return None
        if !sema_copy_site_check_guard_owned(checked_key, environment, program, scopes, context, &diagnostics, false) -> return None
        if !sema_copy_site_check_guard_owned(checked_value, environment, program, scopes, context, &diagnostics, false) -> return None
        if !sema_type_map_key_eligible(environment, program, checked_key.ty) -> &diagnostics.push(sema_map_key_error("`{type_name(checked_key.ty)}` can't be a map key", expr_span(entry.key)))
        if expected_key == .Val(key_ty) {
            compatible_key :: sema_expr_expected_assignable(key_ty, checked_key.ty, environment, program) ?? return None
            if !compatible_key -> return None
        }
        if expected_value == .Val(value_ty) {
            compatible_value :: sema_expr_expected_assignable(value_ty, checked_value.ty, environment, program) ?? return None
            if !compatible_value -> return None
        }
        if {
            inferred_key == None -> inferred_key = Val(checked_key.ty)
            !type_identity_equal(inferred_key ?? checked_key.ty, checked_key.ty) -> {
                &diagnostics.push(sema_error("E0108", expr_span(entry.key), "map keys need one common type", "all entries in a map share one key type", "use keys of the same type"))
                return None
            }
        }
        if {
            inferred_value == None -> inferred_value = Val(checked_value.ty)
            !type_identity_equal(inferred_value ?? checked_value.ty, checked_value.ty) -> {
                &diagnostics.push(sema_error("E0108", expr_span(entry.value), "map values need one common type", "all entries in a map share one value type", "use values of the same type"))
                return None
            }
        }
        &lowered.push(TMapEntry{key: checked_key, value: checked_value})
    }
    if result_ty == None -> result_ty = Val(Type.Map{key: inferred_key ?? Type.Int, key_span: Val(expr_span(entries[0].key)), value: inferred_value ?? Type.Int})
    ty :: result_ty ?? Type.Map{key: Type.Int, key_span: None, value: Type.Int}
    sema_expr_expected_owned(sema_tir_node(ty, TExprKind.Map{entries: lowered}, span), expected, environment, program, &diagnostics)
}

// E0502: one why/fix for every rejected map key, as the Rust
// reference's declared-type and map-literal sites print it.
fn sema_map_key_error(what: String, span: Span) -> Diagnostic {
    sema_error("E0502", span, what, "map keys must be Int, String, Bool, Char, U8/IntN, a payload-free enum, or a tuple/struct whose fields recursively follow these rules; Float, views, Shared, functions, lists, maps, sets, and payload-carrying enums are not key-eligible", "use an eligible scalar, enum, tuple, or struct key; remove non-key fields or store the value separately")
}

fn sema_expression_tuple(fields: [TupleField], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    expected_fields := [TypeTupleField]?{None}
    if expected == .Val(expected_ty) {
        normalized :: sema_expr_unwrap_tag(expected_ty)
        if normalized == .Tuple(items) {
            expected_fields = Val(items)
        }
    }
    if expected != None && expected_fields == None {
        &diagnostics.push(sema_type_mismatch(expected, Type.Tuple{fields: [TypeTupleField]{}}, span))
        return None
    }
    values := [TExpr]{}
    types := [TypeTupleField]{}
    loop field in fields {
        duplicate :: loop previous in types {
            if previous.name == field.name -> break true
        } ?? false
        if duplicate {
            &diagnostics.push(sema_error("E0105", span, "tuple field `{field.name}` is supplied more than once", "tuple field names must be unique", "remove the duplicate tuple field"))
            return None
        }
        // S73: members match the expected tuple by name, in any order (Rust
        // `infer_tuple_lit`).
        field_expected := Type?{None}
        if expected_fields == .Val(rows) {
            loop row in rows {
                if row.name == field.name {
                    field_expected = Val(row.ty)
                    break
                }
            }
            if field_expected == None {
                &diagnostics.push(sema_error("E0108", span, "tuple fields do not match the expected tuple type", "tuple member names are part of the tuple type", "use the declared tuple field names"))
                return None
            }
        }
        value :: sema_check_expression(field.value, field_expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        if !sema_copy_site_check_guard_owned(value, environment, program, scopes, context, &diagnostics, false) -> return None
        if field_expected == .Val(field_ty) {
            compatible :: sema_expr_expected_assignable(field_ty, value.ty, environment, program) ?? return None
            if !compatible -> return None
        }
        &values.push(value)
        &types.push(TypeTupleField{name: field.name, ty: value.ty})
    }
    if expected_fields != None && fields.len() != (expected_fields ?? [TypeTupleField]{}).len() {
        &diagnostics.push(sema_error("E0108", span, "tuple fields do not match the expected tuple type", "tuple arity is part of the tuple type", "provide every tuple field exactly once"))
        return None
    }
    // S73: the tuple type and its values take the canonical member order, as
    // the Rust reference types the literal and lowers each member by name.
    canonical :: type_tuple_fields_canonical(types)
    ordered := [TExpr]{}
    loop member in canonical {
        loop (index, written) in types {
            if written.name == member.name {
                &ordered.push(values[index])
                break
            }
        }
    }
    sema_expr_expected_owned(sema_tir_node(Type.Tuple{fields: canonical}, TExprKind.Tuple{values: ordered}, span), expected, environment, program, &diagnostics)
}

fn sema_expression_range(start: Expr, end: Expr, exclusive: Bool, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    lhs :: sema_check_expression(start, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    rhs :: sema_check_expression(end, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if !sema_expr_is_integer(lhs.ty) {
        &diagnostics.push(sema_error("E0505", expr_span(start), "range bounds must be Int", "a Range stores whole-number start and end bounds", "use Int values on both sides of the range"))
        return None
    }
    if !sema_expr_is_integer(rhs.ty) {
        &diagnostics.push(sema_error("E0505", expr_span(end), "range bounds must be Int", "a Range stores whole-number start and end bounds", "use Int values on both sides of the range"))
        return None
    }
    // A stored range or slice with written ends in the
    // wrong order is E0170; computed ends stay empty at run time.
    if sema_range_backward_diagnostic(start, end, None, exclusive, false) == .Val(backward) -> &diagnostics.push(backward)
    value :: sema_tir_node(Type.Named{name: "Range"}, TExprKind.Range{start: lhs, end: rhs, exclusive: exclusive}, span)
    sema_expr_expected(value, expected, environment, program, &diagnostics)
}

fn sema_expression_char_codepoint(text: String) -> Int? {
    bytes :: text.bytes()
    if bytes.len() == 0 -> return None
    first :: Int.from_u8(bytes[0])
    if first < 128 -> return Val(first)
    width :: if {
        first >= 192 && first < 224 -> 2
        first >= 224 && first < 240 -> 3
        first >= 240 && first < 248 -> 4
        else -> 0
    }
    if width == 0 || bytes.len() < width -> return None
    value :: if width == {
        2 -> (first - 192) * 64 + (Int.from_u8(bytes[1]) - 128)
        3 -> (first - 224) * 4096 + (Int.from_u8(bytes[1]) - 128) * 64 + (Int.from_u8(bytes[2]) - 128)
        4 -> (first - 240) * 262144 + (Int.from_u8(bytes[1]) - 128) * 4096 + (Int.from_u8(bytes[2]) - 128) * 64 + (Int.from_u8(bytes[3]) - 128)
        else -> 0
    }
    Val(value)
}

fn sema_expression_char(text: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> TExpr? {
    value :: sema_expression_char_codepoint(text) ?? {
        &diagnostics.push(sema_error("E0001", span, "this character literal is not valid UTF-8", "a Char stores one Unicode scalar value", "write one valid character between single quotes"))
        return None
    }
    sema_expr_expected_owned(sema_tir_node(Type.Char, TExprKind.CharLit{value: value}, span), expected, environment, program, &diagnostics)
}

fn sema_expression_index(base: Expr, index: Expr, ast_kind: IndexKind, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    checked_base :: sema_check_expression(base, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    base_ty :: sema_expr_unwrap_tag(checked_base.ty)
    index_expected :: if base_ty == {
        .List(_) -> Val(Type.Int)
        .FixedList(_, _) -> Val(Type.Int)
        .Map(key, _, _) -> Val(key)
        .Apply(name, args) -> if (name == "View" || name == "ViewMut") && args.len() == 1 -> Val(Type.Int) else if name == "Pool" && args.len() == 1 -> Val(Type.Apply{name: "ID", args: [Type]{args[0]}}) else -> None
        .Named(name) -> if sema_call_math_is_lane(name) -> Val(Type.Int) else -> None
        else -> None
    }
    // Rust `infer_with_expected`: the positional `Int` is only a hint, so a
    // named index keeps its own type when it is a stored `Range` (a window
    // selection, classified below); any other named index meets `Int` as before.
    named_position :: index == .Ident(_, _, _) && index_expected == (Val(Type.Int))
    hint :: if named_position -> Type?{None} else -> index_expected
    inferred_index :: sema_check_expression(index, hint, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    checked_index :: if named_position && inferred_index.ty != (Type.Named{name: "Range"}) -> sema_expr_expected(inferred_index, index_expected, environment, program, &diagnostics) ?? return None else -> inferred_index
    // (Rust `infer` Index arm): `tree[key]` / `tree[i]` on a
    // `Dyn` reads an object member or array position as a checked Dyn.
    if sema_dyn_is_type(sema_expr_expected_type(base_ty, environment, program)) {
        site :: "{sema_dyn_site(base)}[{sema_dyn_site(index)}]"
        operation :: sema_dyn_index_operation(checked_index.ty, site, span, environment, program, scopes, &diagnostics) ?? return None
        value :: sema_tir_node(sema_dyn_type(), TExprKind.HandleMethod{receiver: checked_base, operation: operation, args: [TExpr]{checked_index}}, span)
        return sema_expr_expected_owned(^value, expected, environment, program, &diagnostics)
    }
    // Fixed lists refine lists (spec: fixed-size lists), so range selection
    // erases only the length fact. Reuse Slice for read/write window typing.
    if checked_index.ty == (Type.Named{name: "Range"}) {
        element :: if base_ty == {
            .List(item) | .FixedList(item, _) -> Val(item)
            else -> None
        }
        if element == .Val(item) {
            zero :: sema_tir_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span)
            value :: sema_tir_node(Type.List{element: item}, TExprKind.Slice{base: checked_base, start: zero, end: zero, range: Val(checked_index), location: sema_expression_panic_location(environment, program, scopes, span)}, span)
            return sema_expr_expected_owned(^value, expected, environment, program, &diagnostics)
        }
    }
    if sema_call_math_builtin_name(base_ty, environment, program) == .Val(lane) && sema_call_math_is_lane(lane) {
        read :: sema_call_math_lane_index(lane, checked_base, index, checked_index, span, environment, &diagnostics) ?? return None
        return sema_expr_expected_owned(^read, expected, environment, program, &diagnostics)
    }
    result_ty := Type?{None}
    resolved_kind := ast_kind
    if base_ty == {
        .List(element) -> {
            if {
                checked_index.ty == (Type.Named{name: "Range"}) -> {
                    resolved_kind = IndexKind.Range
                    result_ty = Val(Type.List{element: element})
                }
                else -> {
                    if !sema_expression_integer_index(checked_index, expr_span(index), &diagnostics) -> return None
                    result_ty = Val(element)
                }
            }
        }
        .FixedList(element, len) -> {
            if !sema_expression_integer_index(checked_index, expr_span(index), &diagnostics) -> return None
            length :: measure_literal_value(len) ?? {
                &diagnostics.push(sema_error("E0965", expr_span(index), "a fixed-list length is not a checked integer measure", "fixed indexing needs a concrete list length", "use a literal fixed-list length"))
                return None
            }
            if tir_expr_known_bounds(checked_index) == {
                .Val(bounds) -> {
                    if bounds.lo < 0 || bounds.hi >= length {
                        &diagnostics.push(sema_error("E0965", expr_span(index), "the index is outside this fixed-size list", "valid indexes run from 0 through {length - 1}", "use an index inside the fixed-list bounds"))
                        return None
                    }
                    resolved_kind = IndexKind.FixedListProof
                }
                else -> {
                    resolved_kind = if ast_kind == IndexKind.FixedListProof -> IndexKind.FixedListProof else -> IndexKind.List
                }
            }
            result_ty = Val(element)
        }
        .Map(_, _, value) -> {
            resolved_kind = IndexKind.Map
            result_ty = Val(value)
        }
        .Apply(name, args) -> {
            if (name == "View" || name == "ViewMut") && args.len() == 1 {
                // (Rust `infer_index`): `view[a..b]` is a
                // `Slice` typed `View<T>`, a read reborrow of the view's owner.
                if checked_index.ty == (Type.Named{name: "Range"}) {
                    if sema_expression_view_subrange_type(base_ty) == .Val(window) {
                        zero_start :: sema_tir_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span)
                        zero_end :: sema_tir_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span)
                        subrange :: sema_tir_node(window, TExprKind.Slice{base: checked_base, start: zero_start, end: zero_end, range: Val(checked_index), location: sema_expression_panic_location(environment, program, scopes, span)}, span)
                        return sema_expr_expected_owned(^subrange, expected, environment, program, &diagnostics)
                    }
                }
                if !sema_expression_integer_index(checked_index, expr_span(index), &diagnostics) -> return None
                resolved_kind = IndexKind.List
                result_ty = Val(args[0])
            }
            // Rust `infer_index` Pool arm: `pool[id]` reads the slot its own
            // `ID<T>` names; a stale id panics at run time (`jet_pool_get`).
            if name == "Pool" && args.len() == 1 {
                id_type :: Type.Apply{name: "ID", args: [Type]{args[0]}}
                if !type_identity_equal(checked_index.ty, id_type) {
                    &diagnostics.push(sema_error("E0112", expr_span(index), "`Pool` indexes need a matching `ID<T>`, not {sema_type_show(checked_index.ty)}", "a pool slot is only reached through the `ID<T>` its own `.add()` returned", "index with the `ID<T>` handle from `.add(...)`"))
                    return None
                }
                location :: sema_expression_panic_location(environment, program, scopes, span)
                slot :: sema_tir_node(args[0], TExprKind.PoolSlot{pool: checked_base, id: checked_index, mutable: false, field: None, line: location.line, source_line: location.source_line}, span)
                return sema_expr_expected_owned(^slot, expected, environment, program, &diagnostics)
            }
        }
        .String -> {
            &diagnostics.push(sema_error("E0503", span, "strings are not indexed with `[ ]`", "text is counted in characters, while brackets index storage positions", "use `.chars()` or slice the string with a Range"))
            return None
        }
        else -> {}
    }
    if result_ty == None {
        &diagnostics.push(sema_error("E0505", span, "only lists and maps can be indexed, not {type_name(checked_base.ty)}", "indexing needs a collection with a declared element or value type", "use `[ ]` on a List or Map"))
        return None
    }
    kind :: sema_expression_index_kind(resolved_kind, base_ty)
    value :: sema_tir_node(result_ty ?? Type.Named{name: "Unit"}, TExprKind.Index{base: checked_base, index: checked_index, kind: kind, access: AccessConvention.Read, checked_call: None, location: sema_expression_panic_location(environment, program, scopes, span)}, span)
    sema_expr_expected(value, expected, environment, program, &diagnostics)
}

fn sema_expression_slice(base: Expr, start: Expr, end: Expr, range: Expr?, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    checked_base :: sema_check_expression(base, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    result_ty := Type?{None}
    range_value := TExpr?{None}
    checked_start := TExpr?{None}
    checked_end := TExpr?{None}
    if range == {
        .Val(range_expr) -> {
            range_checked :: sema_check_expression(range_expr, Val(Type.Named{name: "Range"}), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
            if range_checked.ty != (Type.Named{name: "Range"}) -> return None
            range_value = Val(range_checked)
            if sema_expr_unwrap_tag(checked_base.ty) == {
                .List(element) -> result_ty = Val(Type.List{element: element})
                .FixedList(element, _) -> result_ty = Val(Type.List{element: element})
                .String -> result_ty = Val(Type.String)
                else -> result_ty = sema_expression_view_subrange_type(checked_base.ty)
            }
        }
        else -> {
            start_checked :: sema_check_expression(start, Val(Type.Int), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
            end_checked :: sema_check_expression(end, Val(Type.Int), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
            if !sema_expr_is_integer(start_checked.ty) || !sema_expr_is_integer(end_checked.ty) -> return None
            checked_start = Val(start_checked)
            checked_end = Val(end_checked)
            if sema_expr_unwrap_tag(checked_base.ty) == {
                .List(element) -> result_ty = Val(Type.List{element: element})
                .FixedList(element, _) -> result_ty = Val(Type.List{element: element})
                .String -> result_ty = Val(Type.String)
                else -> result_ty = sema_expression_view_subrange_type(checked_base.ty)
            }
        }
    }
    if result_ty == None {
        &diagnostics.push(sema_error("E0505", span, "only lists and strings can be sliced, not {type_name(checked_base.ty)}", "a Range projects a window from indexed storage", "slice a List or String value"))
        return None
    }
    if sema_columnar_list_element(environment, program, checked_base.ty) == .Val(element) {
        &diagnostics.push(sema_error("E1108", span, "slicing isn't supported on a columnar list `{sema_type_show(sema_expr_unwrap_tag(checked_base.ty))}` yet", "`#Layout(columnar)` lists support the core surface in v1: indexing, field access, `len`, `is_empty`, `push`, and iteration", "drop `#Layout(columnar)` from `{element}` to slice, or index the elements you need in a loop"))
        return None
    }
    zero_start :: sema_tir_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span)
    zero_end :: sema_tir_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span)
    result :: sema_tir_node(result_ty ?? Type.Named{name: "Unit"}, TExprKind.Slice{base: checked_base, start: checked_start ?? zero_start, end: checked_end ?? zero_end, range: range_value, location: sema_expression_panic_location(environment, program, scopes, span)}, span)
    sema_expr_expected(result, expected, environment, program, &diagnostics)
}

// (Rust `view_subrange_type`): a subrange of a declared
// `View<T>`/`ViewMut<T>` is a `View<T>` read reborrow of the same owner;
// `&view[a..b]` on a `ViewMut<T>` reopens the write window in the place.
fn sema_expression_view_subrange_type(ty: Type) -> Type? Never! {
    if sema_expr_unwrap_tag(ty) == .Apply(name, args) {
        if (name == "View" || name == "ViewMut") && args.len() == 1 {
            if args[0] == (Type.Named{name: "str"}) -> return None
            return Val(Type.Apply{name: "View", args: [Type]{args[0]}})
        }
    }
    None
}

// A nominal type whose `Display` comes from a derive: a
// `#Printable` or `#Display` marker, or the auto-derived `Printable` the
// declaration-marker rule selects for it.
fn sema_expression_interpolation_derived(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    if program.registration_graph == .Val(graph) {
    name :: sema_type_graph_base_name(ty) ?? return false
    resolved :: sema_type_graph_lookup_symbol(graph, environment.module_identity, name) ?? return false
    if resolved.symbol.kind != SymbolKind.Type -> return false
    if sema_scope_checked_type_row(environment, program, resolved.target_module_identity, resolved.symbol.name) == .Val(checked_row) {
        if sema_serde_has_name(program.checked_types[checked_row].derives, "Printable") || sema_serde_has_name(program.checked_types[checked_row].derives, "Display") -> return true
    }
    module_index :: sema_registration_module_index(graph, resolved.target_module_identity) ?? return false
    row :: sema_type_graph_resolved_nominal_row(graph, resolved) ?? return false
    // Matched in place: a pattern on the indexed path copies the whole item.
    nominal :: graph.modules[row.module_index].nominals[row.row]
    if nominal.source == .SourceAST(item) -> return sema_type_metadata_auto_derives(item, graph.modules[module_index].declared_trait_impls).printable
    }
    false
}

// (Rust `is_displayable`): bare `{value}` needs a value whose
// type can be shown through `Display`. The shared reflection gate owns the
// structural rules; a nominal type also counts when it derives its display
// or is a unit-family member. Without a registration graph the nominal
// facts are unknown, so a nominal type is not refused.
fn sema_expression_displayable(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    if sema_call_reflection_secret_bearing(ty) || sema_call_reflection_one_pass(ty) -> return false
    if ty == {
        .Named(name) -> {
            if program.registration_graph == None -> return true
            if sema_call_reflection_leaf_name(name) == "Unit" || sema_call_reflection_named_displayable(name, ty, environment, program) -> return true
            return sema_expr_unit_fact(ty, environment, program) != None || sema_expression_interpolation_derived(ty, environment, program)
        }
        .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) -> return sema_expression_displayable(inner, environment, program)
        .Result(ok, err) -> return sema_expression_displayable(ok, environment, program) && sema_expression_displayable(err, environment, program)
        .Map(key, _, value) -> return sema_expression_displayable(key, environment, program) && sema_expression_displayable(value, environment, program)
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_expression_displayable(field.ty, environment, program) -> return false
            }
            return true
        }
        .Union(members) -> {
            loop member in members {
                if !sema_expression_displayable(member, environment, program) -> return false
            }
            return true
        }
        .Apply(name, args) -> {
            // The owner's own rule is the reflection gate's, applied to the
            // bare owner; every argument is then shown in turn.
            if !sema_call_reflection_is_displayable(Type.Apply{name: name, args: [Type]{}}, environment, program) && !sema_expression_interpolation_derived(ty, environment, program) -> return false
            if sema_call_reflection_leaf_name(name) == "KeyRef" -> return true
            loop argument in args {
                if !sema_expression_displayable(argument, environment, program) -> return false
            }
            return true
        }
        else -> return sema_call_reflection_is_displayable(ty, environment, program)
    }
}

// The bundle markers of a distinct type named in this scope.
fn sema_expression_distinct_bundles(name: String, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> [String]? {
    owner :: sema_expression_type_symbol(&scopes, environment, program, name) ?? return None
    definition :: sema_scope_declaration_distinct(environment, program, owner.id) ?? return None
    derives :: loop marker in definition.derives -> marker.name
    granted := [String]{}
    if sema_serde_has_name(derives, "Numeric") -> &granted.push("#Numeric")
    if sema_serde_has_name(derives, "Comparable") -> &granted.push("#Comparable")
    if sema_serde_has_name(derives, "Printable") -> &granted.push("#Printable")
    if sema_serde_has_name(derives, "Encode") -> &granted.push("#CodableAsBase")
    Val(granted)
}

// Rust `one_pass_materializer`: the call that turns a one-pass source into
// a showable value, when it has one.
fn sema_expression_one_pass_fix(ty: Type) -> String Never! {
    if ty == {
        .Apply(name, _) -> {
            leaf :: sema_call_reflection_leaf_name(name)
            if leaf == "Iter" || leaf == "ViewIter" -> return "materialize it first: add `.to_list()` before the interpolation"
        }
        .Named(name) -> {
            if sema_call_reflection_leaf_name(name) == "Body" -> return "materialize it first: add `.text(limit)` before the interpolation"
        }
        else -> {}
    }
    "consume it with a `loop` and show each item instead"
}

// Bare `{value}` interpolation calls
// `Display`, which has no default. A value without it is refused here
// (E0915); a nominal `distinct` type without `#Printable` names the bundles
// it was granted instead (E0138). Returns whether the value can be shown.
fn sema_expression_interpolation_display(value: TExpr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    ty :: value.ty
    if sema_expression_displayable(ty, environment, program) -> return true
    if sema_call_reflection_secret_bearing(ty) {
        &diagnostics.push(sema_error("E0915", value.span, "secret-bearing `{type_name(ty)}` has no `Display` implementation", "cryptographic secrets cannot enter logs or strings through interpolation", "remove the interpolation; log a public operation label or key identifier instead"))
        return false
    }
    if sema_call_reflection_one_pass(ty) {
        &diagnostics.push(sema_error("E0915", value.span, "the one-pass source {sema_type_show(ty)} has no `Display` implementation", "reading this value consumes it, so showing it would spend the only pass", sema_expression_one_pass_fix(ty)))
        return false
    }
    if ty == .Named(name) {
        if sema_expression_distinct_bundles(name, environment, program, &scopes) == .Val(granted) {
            has :: if granted.len() == 0 -> "no operation bundles" else -> "only {granted.join(", ")}"
            &diagnostics.push(sema_error("E0138", value.span, "`{name}` doesn't support string interpolation", "a nominal type only gets the operations its operation bundles grant; `{name}` has {has}", "add `#Printable` before the declaration, or convert to the base type first"))
            return false
        }
    }
    shown :: sema_type_show(ty)
    &diagnostics.push(sema_error("E0915", value.span, "`{shown}` has no `Display` implementation", "bare `{{value}}` interpolation calls `Display` — there is no default for user types", "add `impl {shown}.Display {{ fn display(self) -> String {{ … }} }}`, or use `{{value:Debug}}` for debug output"))
    false
}

