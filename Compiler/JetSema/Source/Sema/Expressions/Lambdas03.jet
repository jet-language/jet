                    closure_taken :: if self.http_handler_depth > 0 { true } else { taken || !cloneable }
                    if self.crossing_problem_for_name(name, cap_ty, crossing, closure_taken) == .Val(problem) {
                        &self.report_unsendable(name, cap_ty, problem, crossing, lam.span)
                        continue
