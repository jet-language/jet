fn lambda_slot_matches(expected: Type, actual: Type) -> Bool Never! { expected == actual || (is_unit_type(expected) && is_unit_type(actual)) }
// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/lambdas.rs:1197
fn lambda_body_matches_return(expected: Type, actual: Type) -> Bool Never! {
    expected == actual || if expected == { .Result(ok, _) -> lambda_slot_matches(ok, actual); else -> false }
}
