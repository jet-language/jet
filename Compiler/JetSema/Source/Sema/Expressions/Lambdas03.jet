fn install_inline_loop_label(body: &LambdaBody, label: String, span: Span) Never! {
    if body != .Block -> return
    if body == .Block(stmts) {
        if stmts.is_empty() -> return
        old := String?{None}
        if stmts[0] == {
            .Loop(_, _, root_label) | .While(_, _, _, _, root_label) | .For(_, _, _, _, _, _, root_label, _) | .CountedLoop(_, _, _, root_label, _) -> {
                old = root_label.map(fn(pair) { pair.0 })
                root_label = Val((label, span))
            }
            else -> {}
        }
        if old == .Val(old) -> rewrite_inline_loop_target(&stmts, old, label)
    }
}
