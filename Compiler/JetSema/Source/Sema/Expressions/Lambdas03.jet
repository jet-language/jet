fn rewrite_inline_loop_target(stmts: &[Stmt], old: String, new: String) Never! {
    loop stmt in &stmts {
        if stmt == {
            .BreakLabel(name, _) | .ContinueLabel(name, _) | .BreakLabelValue(name, _, _, _) -> { if name == old -> name = new }
            .Switch(_, arms, else_body, _) | .ComptimeSwitch(_, arms, else_body, _) -> {
                loop arm in &arms -> rewrite_inline_loop_target(&arm.body, old, new)
                if else_body == .Val(body) -> rewrite_inline_loop_target(&body, old, new)
            }
            .Loop(body, _, _) | .While(_, body, _, _, _) | .For(_, _, _, _, body, _, _, _) | .CountedLoop(_, body, _, _, _) |
            .Unsafe(_, body, _) | .Impure(body, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(body, _, _) |
            .Region(_, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, body, _, _) | .Layout(_, _, body, _) |
            .AuthorityScope(_, body, _) | .ComptimeBlock(body, _) | .ContextBlock(_, body, _) | .Live(body, _, _) |
            .AssumeDet(body, _) | .Transact(_, body, _, _) | .ScopeMember(_, _, _, _, _, _, body, _) -> rewrite_inline_loop_target(&body, old, new)
            .ComptimeIf(_, then_body, else_body, _) -> {
                rewrite_inline_loop_target(&then_body, old, new)
                if else_body == .Val(body) -> rewrite_inline_loop_target(&body, old, new)
            }
            else -> {}
        }
    }
}
