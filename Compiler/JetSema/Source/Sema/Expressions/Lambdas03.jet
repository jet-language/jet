        saved_statement_expr_inference :: self.statement_expr_inference
        self.failure_carrier_inference = infer_failure_carrier
        self.failure_carrier = None
        self.statement_expr_inference = false
        if infer_failure_carrier { self.ret = None } else if effective_ret == .Val(ret) { self.ret = Val(ret) }
        saved_in_lambda_body :: self.in_lambda_body
        saved_inferred_mut_captures :: ^self.inferred_lambda_mut_captures
        self.inferred_lambda_mut_captures = [:]
        saved_task_body_propagates :: self.task_body_propagates
        self.task_body_propagates = false
        self.in_lambda_body = true
        if effective_ret == .Val(.Apply(name, _)) && name == "View" {
