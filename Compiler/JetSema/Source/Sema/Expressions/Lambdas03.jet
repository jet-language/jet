                    &self.diags.push(Diagnostic.error("E0120", "`{name}` was not moved here, so it cannot be captured by {destination}", "this function can access the parameter, but it does not own the value; capture requires the move marker `^`", "make the parameter owned with the move marker `^`: `{name}: {Syntax.SIGIL_MOVE}{cap_ty.name()}`", Val(lam.span)))
                    continue
                }
                if self.is_task_spawn || self.http_handler_depth > 0 {
