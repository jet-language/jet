                frozen_site :: self.frozen_for(name)
                if self.is_task_spawn && frozen_site != None && !lam.meta.frozen_captures.contains(name) -> &lam.meta.frozen_captures.push(name)
                cloneable :: self.is_cloneable_type(cap_ty)
                if self.in_taskgroup_spawn && self.http_handler_depth == 0 && !taken && frozen_site == None {
                    fallback :: if cap_conv == { .Val(.Write) -> Val(ViewAccess.Write); .Val(.Read) -> Val(ViewAccess.Read); else -> None }
                    if self.admit_scoped_borrow(name, fallback, lam.span) == {
