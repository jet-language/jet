// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/lambdas.rs:1181
fn lambda_return_slots(ret: Type?) -> (Type?, Type?) Never! {
    if ret == { .Val(.Result(ok, err)) -> (Val(ok), Val(err)); .Val(ret) -> (Val(ret), None); .None -> (None, None) }
}
