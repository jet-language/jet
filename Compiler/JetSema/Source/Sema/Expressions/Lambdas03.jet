                    copy_ty :: owned_type_for_read_view(cap_ty).or_else(fn() { if self.is_string_view(name) && cap_ty == Type.String { Val(Type.String) } else { None } })
                    if !self.is_task_spawn && !self.copies_explicit() && read_only && copy_ty.is_some_and(fn(ty) { self.is_cloneable_type(ty) }) {
