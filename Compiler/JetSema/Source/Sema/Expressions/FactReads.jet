// A compiler fact is a `$` member of the
// thing it describes (`Severity.reflect().range`, `send_report.reflect().effects`,
// `Meter.reflect().unit_scale_provenance`). Sema resolves one registered plane on the
// subject and replaces the read with its typed compile-time value, so a fact
// never reaches code generation as a runtime member read and cannot select
// runtime behavior. Mirrors Rust `CheckerInfer::fold_fact_read`,
// `reflected_fact_type`, `Comptime::reflected_fact_field` and the reflection
// rows of `CheckerCoreLib::core_struct_field`.
use jet_foundation.[
    COMPILER_BUILD_CPU_CACHE_LINE_GENERIC,
    Diagnostic,
    EnumLitArg,
    Expr,
    FactRead,
    Func,
    Item,
    NodeKind,
    PatSlot,
    Span,
    StructDef,
    Symbol,
    SymbolID,
    SymbolKind,
    TAppliedRule,
    TAppliedRuleArgumentMenu,
    TAppliedRuleCatalog,
    TComptimeEnumArg,
    TComptimeField,
    TComptimeValue,
    TFieldRef,
    TIntegerWidth,
    TPatternBindingFact,
    TargetMachine,
    TextEdit,
    Type,
    UnitScaleProvenance,
    VariantPayload,
    ViewProvenance,
    ViewSourcePath,
    core_record_field,
    diagnostic_with_edit,
    jet_target_layout_cache_line,
    jet_target_layout_cpu_features,
    jet_target_layout_pointer_size,
    symbol_id,
    type_name,
    fact_read_detail_field,
    fact_read_kind,
    fact_read_reflection_kind,
]

SemaFactReadCheck: struct {
    handled: Bool
    value: TExpr?
}

sema_fact_read_unhandled: fn() -> SemaFactReadCheck Never! {
    SemaFactReadCheck{handled: false, value: None}
}

sema_fact_read_failed: fn() -> SemaFactReadCheck Never! {
    SemaFactReadCheck{handled: true, value: None}
}

// The typed reader named by a `$` member (Rust `Syntax::fact_read_kind` over
// the registry's fact reads). The build-snapshot reads are not sema fact
// reads here: `build`/`#package` roots carry them instead.
sema_fact_read_kind: fn(member: String) -> FactRead? Never! {
    read: fact_read_kind(member) ?? return None
    if read == {
        .BuildPackageName | .BuildPackageVersion | .BuildOS | .BuildProfile | .BuildStampGit | .BuildStampDirty | .BuildStampToolchain | .BuildStampAt -> None
        .Layout | .Name | .Fields | .Range | .Dimension | .Measure | .Exactness | .Classification | .Obligation | .States | .Effects | .Sendability | .Movedness | .Attribution | .Origin | .ViewProvenance | .UnitScaleProvenance | .Maturity | .RegisteredPlane(_) -> Val(read)
    }
}

// How a diagnostic names the fact member `$fact`: the source spelling
// `reflect().fact`.
sema_fact_member_display: fn(member: String) -> String Never! {
    if member.starts_with("$") -> "reflect().{member.slice(1, member.len())}" else -> member.copy()
}

sema_fact_read_is_plane: fn(read: FactRead) -> Bool Never! {
    read == .RegisteredPlane(_)
}

sema_fact_named: fn(name: String) -> Type Never! {
    Type.Named{name: name}
}

sema_fact_list_of: fn(name: String) -> Type Never! {
    Type.List{element: Type.Named{name: name}}
}

sema_fact_optional: fn(name: String) -> Type Never! {
    Type.Option{inner: Type.Named{name: name}}
}

// Reflection fact kinds and their detail enums are closed,
// compiler-owned menus (Rust `core_fact_kind_variants`). `FactKind` is the
// registered plane projection: `Effect`, `State`, `Tag`, then each value
// plane's reflection kind in Prelude `Facts.jet` row order.
sema_fact_enum_variants: fn(enum_name: String) -> [String]? {
    if {
        enum_name == "FactKind" -> Val([String]{"Effect", "State", "Tag", "Nominal", "Range", "Layout", "Measure", "Dimension", "Classification", "Exactness", "Obligation", "Flow", "Taint", "Duty", "Effects", "States", "Sendability", "ViewProvenance", "Movedness", "Attribution", "Origin", "UnitScaleProvenance", "Maturity"})
        enum_name == "Maturity" -> Val([String]{"Experimental", "Tested", "Hardened"})
        enum_name == "ExactnessKind" -> Val([String]{"Exact", "Approximate", "Measured"})
        enum_name == "ParamZone" -> Val([String]{"PositionalOnly", "Either", "LabelOnly"})
        enum_name == "UnitScaleProvenanceKind" -> Val([String]{"Rational", "SymbolicPi", "Conventional", "Measured"})
        else -> None
    }
}

// Rust `builtin_type_registry`: the compiler-owned runtime enums every module
// sees without a declaration. `<=>` and `compare` produce an `Ordering`;
// checked removals select by `RemoveBy`. They share the closed menu checks
// below, but they are runtime values, so codegen never folds them.
sema_compiler_enum_variants: fn(enum_name: String) -> [String]? {
    if {
        enum_name == "Ordering" -> Val([String]{"Less", "Equal", "Greater"})
        enum_name == "RemoveBy" -> Val([String]{"Val", "Slot"})
        else -> None
    }
}

// The fact-enum or compiler-owned enum menu for `ty`, unless a declared enum
// of that name is in scope (the compiler's own sources declare a `ParamZone`).
// The registered compiler-owned `Ordering`/`RemoveBy` nominals keep this menu.
sema_fact_enum_menu: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> [String]? {
    name := ""
    if sema_expr_unwrap_tag(ty) == {
        .Named(value) -> name = value
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> return None
    }
    found := sema_fact_enum_variants(name)
    if found == None -> found = sema_compiler_enum_variants(name)
    variants: found ?? return None
    if program.registration_graph == .Val(graph) {
        declared: sema_type_resolve_nominal_row(graph, Type.Named{name: name}, environment.module_identity)
        if declared == .Val(row) {
            if !graph.modules[row.module_index].nominals[row.row].compiler_owned -> return None
        }
    }
    Val(variants)
}

sema_fact_enum_unknown_variant: fn(owner: String, variant: String, variants: [String], span: Span) -> Diagnostic {
    if sema_fact_enum_variants(owner) == None -> return sema_error("E0302", span, "`{owner}` has no variant `{variant}`", "enum constructors must name a declared variant", "use one of the declared variants")
    sema_error("E0302", span, "`{owner}` has no variant `{variant}`", "`{owner}` is a closed compiler fact menu: {variants.join(", ")}", "use one of the listed variants")
}

// Rust `suggest_field`: the one nearest candidate within two edits, never the
// refused name itself, and none when two candidates tie.
sema_suggest_field: fn(name: String, candidates: [String]) -> String? {
    best := ""
    best_distance := 3
    ambiguous := false
    loop candidate in candidates {
        distance: sema_taint_edit_distance(name, candidate)
        if distance == 0 || distance > 2 -> next
        if {
            distance < best_distance -> {
                best = candidate
                best_distance = distance
                ambiguous = false
            }
            distance == best_distance && best != candidate -> {
                ambiguous = true
            }
        }
    }
    if best == "" || ambiguous -> None else -> Val(best)
}

// Rust `check_enum_lit` E0304: an enum literal names a variant the enum lacks.
sema_enum_unknown_variant: fn(display_type_name: String, variant: String, variants: [String], span: Span, variant_span: Span?) -> Diagnostic {
    suggestion: sema_suggest_field(variant, variants)
    fix: if suggestion == .Val(candidate) -> "did you mean `{candidate}`?" else -> "check the variant name"
    diagnostic: sema_error("E0304", span, "`{display_type_name}` has no variant `{variant}`", "enum literals must name a variant on the type", fix)
    if suggestion == .Val(candidate) {
        if variant_span == .Val(edit_span) -> return diagnostic_with_edit(diagnostic, TextEdit{span: edit_span, new_text: candidate})
    }
    diagnostic
}

// Rust `check_enum_lit` E0303: a unit variant written with a payload.
sema_enum_unit_payload: fn(display_type_name: String, variant: String, span: Span) -> Diagnostic {
    sema_error("E0303", span, "variant `{variant}` takes no payload", "unit variants are written without parentheses", "write `{display_type_name}.{variant}` with no `(...)`")
}

// `EXACTNESS.kind == .Approximate` tests a compiler fact enum
// against one binding-free variant. Codegen folds the test once the subject's
// prepared value is known (Rust `fold_typed_fact_enum_pattern`).
sema_fact_enum_pattern: fn(subject_ty: Type, variant: String, slots: [PatSlot], leading_dot: Bool, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> SemaPatternValidation? {
    variants: sema_fact_enum_menu(subject_ty, environment, program) ?? return None
    shape: TPatternShape.Variant{variant: variant, bindings: [TPatternBinding]{}, leading_dot: leading_dot, span: span}
    complete := true
    compiler_enum: sema_fact_enum_variants(type_name(subject_ty)) == None
    if !variants.contains(variant) {
        // Rust `validate_pattern`: a compiler-owned runtime enum (`Ordering`,
        // `RemoveBy`) reports like any declared enum.
        diagnostic: if compiler_enum -> sema_error("E0305", span, "pattern `{variant}` doesn't belong to `{type_name(subject_ty)}`", "pattern tests must name a variant on the value's enum type", "check the variant spelling") else -> sema_fact_enum_unknown_variant(type_name(subject_ty), variant, variants, span)
        diagnostics.push(diagnostic)
        complete = false
    } else if slots.len() != 0 {
        diagnostic: if compiler_enum -> sema_error("E0306", span, "pattern `{variant}` expects 0 bindings, got {slots.len()}", "each payload field needs its own binding name", "write `{variant}()") else -> sema_error("E0306", span, "pattern `{variant}` expects no bindings", "compiler fact enum variants carry no payload", "match `.{variant}` without bindings")
        diagnostics.push(diagnostic)
        complete = false
    }
    // A runtime compiler enum tests against its registered compiler-owned
    // nominal, so codegen lowers the test like any declared enum's.
    enum_type := SymbolID?{None}
    if compiler_enum {
        if program.registration_graph == .Val(graph) {
            if sema_registration_compiler_builtin_row(graph, type_name(sema_expr_unwrap_tag(subject_ty))) == .Val(owner) -> enum_type = Val(graph.modules[owner.module_index].nominals[owner.row].symbol.id)
        }
    }
    Val(SemaPatternValidation{shape: shape, enum_type: enum_type, bindings: [TPatternBindingFact]{}, complete: complete})
}

// A payload-free variant of a compiler fact enum (`.Approximate` where an
// `ExactnessKind` is expected, or `ExactnessKind.Approximate`).
sema_fact_enum_literal: fn(enum_name: String, variant: String, args: [EnumLitArg], span: Span, variant_span: Span?, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> SemaFactReadCheck {
    ty: Type.Named{name: enum_name}
    variants: sema_fact_enum_menu(ty, environment, program) ?? return sema_fact_read_unhandled()
    compiler_enum: sema_fact_enum_variants(enum_name) == None
    if !variants.contains(variant) {
        diagnostic: if compiler_enum -> sema_enum_unknown_variant(enum_name, variant, variants, span, variant_span) else -> sema_fact_enum_unknown_variant(enum_name, variant, variants, variant_span ?? span)
        diagnostics.push(diagnostic)
        return sema_fact_read_failed()
    }
    if args.len() != 0 {
        diagnostic: if compiler_enum -> sema_enum_unit_payload(enum_name, variant, span) else -> sema_error("E0104", span, "`{enum_name}.{variant}` takes no payload", "compiler fact enum variants carry no payload", "write `.{variant}` without arguments")
        diagnostics.push(diagnostic)
        return sema_fact_read_failed()
    }
    value: sema_tree_node(ty, TExprKind.EnumLit{enum_type: enum_name, variant: variant, payload: TEnumPayload.Unit}, span)
    SemaFactReadCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

sema_fact_field_when: fn(condition: Bool, ty: Type) -> Type? {
    if condition -> return Val(ty)
    None
}

// The typed field rows of the compiler-owned reflection records
// (Rust `core_struct_field`). These records exist only as compile-time values.
sema_fact_reflection_field_type: fn(type_name: String, field: String) -> Type? {
    string: Type.String
    if type_name == "Range" -> return sema_fact_field_when(field == "start" || field == "end", Type.Int)
    if type_name == "TypeInfo" {
        return if {
            field == "name" || field == "path" || field == "module" || field == "identity" || field == "kind" || field == "base" -> Val(string)
            field == "layout" -> Val(sema_fact_named("LayoutInfo"))
            field == "fields" -> Val(sema_fact_list_of("FieldInfo"))
            field == "methods" -> Val(sema_fact_list_of("MethodInfo"))
            field == "type_params" -> Val(sema_fact_list_of("TypeParamInfo"))
            field == "markers" || field == "expanded_markers" -> Val(sema_fact_list_of("MarkerInfo"))
            field == "traits" -> Val(sema_fact_list_of("TraitInfo"))
            field == "constants" -> Val(sema_fact_list_of("ConstantInfo"))
            field == "generic_bindings" -> Val(sema_fact_list_of("GenericBindingInfo"))
            field == "numeric" -> Val(sema_fact_optional("NumericInfo"))
            field == "states" -> Val(sema_fact_list_of("StateInfo"))
            field == "transitions" -> Val(sema_fact_list_of("TransitionInfo"))
            field == "facts" -> Val(sema_fact_list_of("FactInfo"))
            field == "dimensions" -> Val(sema_fact_list_of("DimensionInfo"))
            field == "span" -> Val(sema_fact_named("SourceSpan"))
            else -> None
        }
    }
    if type_name == "LayoutInfo" {
        return if {
            field == "kind" || field == "target" || field == "guarantee" || field == "source" -> Val(string)
            field == "size" || field == "alignment" || field == "stride" || field == "requested_alignment" || field == "effective_alignment" -> Val(Type.Option{inner: Type.Int})
            field == "fields" -> Val(sema_fact_list_of("LayoutField"))
            else -> None
        }
    }
    if type_name == "LayoutField" {
        return if {
            field == "name" || field == "type" || field == "target" || field == "guarantee" || field == "source" -> Val(string)
            field == "offset" || field == "size" -> Val(Type.Option{inner: Type.Int})
            else -> None
        }
    }
    if type_name == "MarkerInfo" {
        return if {
            field == "name" -> Val(string)
            field == "args" -> Val(sema_fact_list_of("MarkerArgInfo"))
            else -> None
        }
    }
    if type_name == "StateInfo" {
        return if {
            field == "name" -> Val(string)
            field == "path" -> Val(sema_fact_named("StateRef"))
            field == "terminal" -> Val(Type.Bool)
            field == "reachable" -> Val(Type.Option{inner: Type.Bool})
            else -> None
        }
    }
    if type_name == "StateRef" -> return sema_fact_field_when(field == "owner" || field == "name" || field == "path", string)
    if type_name == "TransitionInfo" {
        return if {
            field == "operation" -> Val(string)
            field == "from" || field == "to" -> Val(sema_fact_named("StateRef"))
            else -> None
        }
    }
    if type_name == "FactInfo" {
        return if {
            field == "kind" -> Val(sema_fact_named("FactKind"))
            field == "name" || field == "path" -> Val(string)
            field == "value" -> Val(sema_fact_named("FactValue"))
            else -> None
        }
    }
    if type_name == "FactValue" {
        return if {
            field == "kind" -> Val(sema_fact_named("FactKind"))
            field == "name" -> Val(string)
            field == "members" -> Val(Type.List{element: string})
            field == "range" -> Val(sema_fact_optional("Range"))
            field == "dimension" -> Val(sema_fact_optional("DimensionInfo"))
            field == "measure" -> Val(sema_fact_optional("MeasureInfo"))
            field == "exactness" -> Val(sema_fact_optional("ExactnessInfo"))
            field == "layout" -> Val(sema_fact_optional("LayoutFact"))
            field == "classification" -> Val(sema_fact_optional("ClassificationInfo"))
            field == "nominal" -> Val(sema_fact_optional("NominalInfo"))
            field == "obligation" -> Val(sema_fact_optional("ObligationInfo"))
            field == "state" -> Val(sema_fact_optional("StateRef"))
            field == "sendability" -> Val(sema_fact_optional("SendabilityInfo"))
            field == "view_provenance" -> Val(sema_fact_optional("ViewProvenanceInfo"))
            field == "movedness" -> Val(sema_fact_optional("MovednessInfo"))
            field == "attribution" -> Val(sema_fact_optional("AttributionInfo"))
            field == "origin" -> Val(sema_fact_optional("OriginInfo"))
            field == "unit_scale_provenance" -> Val(sema_fact_optional("UnitScaleProvenanceInfo"))
            field == "maturity" -> Val(sema_fact_optional("MaturityInfo"))
            else -> None
        }
    }
    if type_name == "MeasureInfo" {
        return if {
            field == "kind" -> Val(string)
            field == "value" -> Val(Type.Option{inner: Type.Int})
            field == "symbol" -> Val(Type.Option{inner: string})
            else -> None
        }
    }
    if type_name == "ExactnessInfo" {
        return if {
            field == "kind" -> Val(sema_fact_named("ExactnessKind"))
            field == "precision" -> Val(Type.Option{inner: Type.Int})
            else -> None
        }
    }
    if type_name == "LayoutFact" -> return sema_fact_field_when(field == "bytes", Type.Int)
    if type_name == "ClassificationInfo" || type_name == "NominalInfo" -> return sema_fact_field_when(field == "name", string)
    if type_name == "ObligationParamInfo" {
        return if {
            field == "name" -> Val(string)
            field == "zone" -> Val(sema_fact_named("ParamZone"))
            else -> None
        }
    }
    if type_name == "ObligationInfo" {
        return if {
            field == "effect_bound" -> Val(Type.List{element: string})
            field == "param_contract" -> Val(sema_fact_list_of("ObligationParamInfo"))
            field == "variadic" -> Val(Type.List{element: Type.Bool})
            else -> None
        }
    }
    if type_name == "SendabilityInfo" || type_name == "MovednessInfo" -> return sema_fact_field_when(field == "known", Type.Bool)
    if type_name == "ViewProvenanceInfo" {
        return if {
            field == "sources" -> Val(Type.List{element: string})
            field == "mutable" -> Val(Type.Bool)
            else -> None
        }
    }
    if type_name == "AttributionInfo" {
        return if {
            field == "source" -> Val(string)
            field == "code" -> Val(Type.Option{inner: string})
            else -> None
        }
    }
    if type_name == "OriginInfo" {
        return if {
            field == "tracked" || field == "ambiguity" -> Val(Type.Bool)
            field == "source" -> Val(Type.Option{inner: string})
            field == "line" || field == "column" -> Val(Type.Option{inner: Type.Int})
            else -> None
        }
    }
    if type_name == "UnitScaleProvenanceInfo" {
        return if {
            field == "kind" -> Val(sema_fact_named("UnitScaleProvenanceKind"))
            field == "value" || field == "source" || field == "uncertainty" -> Val(Type.Option{inner: string})
            else -> None
        }
    }
    if type_name == "MaturityInfo" -> return sema_fact_field_when(field == "level", sema_fact_named("Maturity"))
    if type_name == "DimensionInfo" {
        return if {
            field == "axes" -> Val(sema_fact_list_of("DimensionAxis"))
            field == "identity" || field == "display" -> Val(string)
            else -> None
        }
    }
    if type_name == "DimensionAxis" {
        return if {
            field == "name" -> Val(string)
            field == "exponent" -> Val(Type.Int)
            else -> None
        }
    }
    if type_name == "FunctionInfo" {
        return if {
            field == "name" || field == "module" || field == "identity" || field == "package" -> Val(string)
            field == "params" -> Val(Type.List{element: string})
            field == "span" -> Val(sema_fact_named("SourceSpan"))
            field == "effects" -> Val(sema_fact_named("EffectInfo"))
            field == "reaches_panic" -> Val(Type.Bool)
            field == "arithmetic" -> Val(sema_fact_list_of("ArithmeticOperationInfo"))
            field == "facts" -> Val(sema_fact_list_of("FactInfo"))
            field == "markers" -> Val(sema_fact_list_of("MarkerInfo"))
            else -> None
        }
    }
    if type_name == "ArithmeticOperationInfo" {
        return if {
            field == "operation" || field == "policy" -> Val(string)
            field == "operation_span" || field == "scope_span" -> Val(sema_fact_named("SourceSpan"))
            else -> None
        }
    }
    if type_name == "PackageInfo" {
        return if {
            field == "name" || field == "identity" -> Val(string)
            field == "types" -> Val(sema_fact_list_of("TypeInfo"))
            field == "functions" -> Val(sema_fact_list_of("FunctionInfo"))
            else -> None
        }
    }
    if type_name == "EffectInfo" -> return sema_fact_field_when(field == "values", Type.List{element: string})
    if type_name == "MethodInfo" {
        return if {
            field == "name" || field == "module" || field == "identity" || field == "return_type" || field == "signature" -> Val(string)
            field == "params" -> Val(Type.List{element: string})
            field == "effects" -> Val(sema_fact_named("EffectInfo"))
            field == "markers" -> Val(sema_fact_list_of("MarkerInfo"))
            field == "dimensions" -> Val(sema_fact_list_of("DimensionInfo"))
            field == "facts" -> Val(sema_fact_list_of("FactInfo"))
            field == "arithmetic" -> Val(sema_fact_list_of("ArithmeticOperationInfo"))
            field == "is_pub" -> Val(Type.Bool)
            field == "span" -> Val(sema_fact_named("SourceSpan"))
            else -> None
        }
    }
    if type_name == "FieldInfo" {
        return if {
            field == "name" || field == "type" -> Val(string)
            field == "index" -> Val(Type.Int)
            field == "fields" -> Val(sema_fact_list_of("FieldInfo"))
            field == "markers" -> Val(sema_fact_list_of("MarkerInfo"))
            field == "dimensions" -> Val(sema_fact_list_of("DimensionInfo"))
            field == "facts" -> Val(sema_fact_list_of("FactInfo"))
            field == "is_pub" -> Val(Type.Bool)
            field == "span" -> Val(sema_fact_named("SourceSpan"))
            field == "default" -> Val(Type.Option{inner: sema_fact_named("DefaultInfo")})
            field == "offset" -> Val(Type.Option{inner: Type.Int})
            else -> None
        }
    }
    if type_name == "DefaultInfo" -> return sema_fact_field_when(field == "source", sema_fact_named("SourceSpan"))
    if type_name == "TypeParamInfo" {
        return if {
            field == "name" -> Val(string)
            field == "bounds" -> Val(Type.List{element: string})
            field == "span" -> Val(sema_fact_named("SourceSpan"))
            else -> None
        }
    }
    if type_name == "TraitInfo" {
        return if {
            field == "name" -> Val(string)
            field == "associated_types" -> Val(sema_fact_list_of("AssociatedTypeInfo"))
            field == "methods" -> Val(sema_fact_list_of("MethodInfo"))
            else -> None
        }
    }
    if type_name == "AssociatedTypeInfo" || type_name == "GenericBindingInfo" -> return sema_fact_field_when(field == "name" || field == "type", string)
    if type_name == "NumericInfo" {
        return if {
            field == "signed" || field == "is_float" -> Val(Type.Bool)
            field == "bits" -> Val(Type.Int)
            else -> None
        }
    }
    if type_name == "ConstantInfo" {
        return if {
            field == "name" || field == "trait_name" || field == "type" -> Val(string)
            field == "value" -> Val(Type.Option{inner: string})
            else -> None
        }
    }
    if type_name == "SourceSpan" -> return sema_fact_field_when(field == "start" || field == "end", Type.Int)
    None
}

// The type of `$fact` read over an aggregate reflection record
// (Rust `reflected_fact_type`).
sema_fact_reflected_type: fn(base: Type, read: FactRead) -> Type? {
    owner := ""
    if base == {
        .Named(name) -> owner = name
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> return None
    }
    if owner == "TypeInfo" && read == FactRead.States -> return Val(sema_fact_list_of("StateInfo"))
    if (owner == "TypeInfo" || owner == "FieldInfo") && read == FactRead.Dimension -> return Val(sema_fact_named("DimensionInfo"))
    if (owner == "TypeInfo" || owner == "FactInfo" || owner == "FactValue") && read == FactRead.Range -> return Val(sema_fact_named("Range"))
    if (owner == "FunctionInfo" || owner == "MethodInfo") && read == FactRead.Effects -> return Val(sema_fact_named("EffectInfo"))
    aggregate: owner == "TypeInfo" || owner == "FunctionInfo" || owner == "MethodInfo" || owner == "FieldInfo" || owner == "FactInfo" || owner == "FactValue"
    if aggregate && sema_fact_read_is_plane(read) -> return Val(sema_fact_named("FactValue"))
    if owner == "TypeInfo" || owner == "FunctionInfo" || owner == "MethodInfo" || owner == "FactInfo" || owner == "FactValue" {
        detail: fact_read_detail_field(read) ?? return None
        if sema_fact_reflection_field_type("FactValue", detail) == .Val(.Option(inner)) -> return Val(inner)
    }
    None
}

sema_fact_struct_field: fn(value: TComptimeValue, name: String) -> TComptimeValue? {
    if value == .Struct(_, fields) {
        loop field in fields {
            if field.name == name -> return Val(field.value)
        }
    }
    None
}

sema_fact_value_detail: fn(value: TComptimeValue, read: FactRead) -> TComptimeValue? {
    kind: sema_fact_struct_field(value, "kind") ?? return None
    kind_name := ""
    if kind == {
        .Enum(_, variant, _) -> kind_name = variant
        .Int(_) | .Float(_, _) | .Bool(_) | .Char(_) | .String(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Present(_) | .Failed(_) | .Unit -> return None
    }
    if Val(kind_name) != fact_read_reflection_kind(read) -> return None
    if sema_fact_read_is_plane(read) -> return Val(value)
    detail: fact_read_detail_field(read) ?? return None
    if sema_fact_struct_field(value, detail) == .Val(.Present(inner)) -> return Val(inner)
    None
}

sema_fact_info_detail: fn(fact: TComptimeValue, read: FactRead) -> TComptimeValue? {
    sema_fact_value_detail(sema_fact_struct_field(fact, "value") ?? return None, read)
}

sema_fact_list_detail: fn(facts: TComptimeValue?, read: FactRead) -> TComptimeValue? {
    if facts == .Val(.List(values)) {
        loop fact in values {
            detail: sema_fact_info_detail(fact, read)
            if detail != None -> return detail
        }
    }
    None
}

sema_fact_first_dimension: fn(value: TComptimeValue) -> TComptimeValue? {
    if sema_fact_struct_field(value, "dimensions") == .Val(.List(values)) {
        if values.len() > 0 -> return Val(values[0])
    }
    None
}

// Project one registered fact from an aggregate reflection value through its
// typed FactInfo/FactValue carrier (Rust `Comptime::reflected_fact_field`).
// Codegen reuses this for `$` steps of a prepared-constant path.
sema_fact_reflected_field: fn(value: TComptimeValue, member: String) -> TComptimeValue? {
    read: sema_fact_read_kind(member) ?? return None
    sema_fact_reflected_read(value, read)
}

sema_fact_reflected_read: fn(value: TComptimeValue, read: FactRead) -> TComptimeValue? {
    owner := ""
    if value == {
        .Struct(type_name, _) -> owner = type_name
        .Int(_) | .Float(_, _) | .Bool(_) | .Char(_) | .String(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit -> return None
    }
    facts: sema_fact_struct_field(value, "facts")
    if owner == "FactInfo" -> return sema_fact_info_detail(value, read)
    if owner == "FactValue" -> return sema_fact_value_detail(value, read)
    if owner == "TypeInfo" {
        if read == FactRead.States -> return sema_fact_struct_field(value, "states")
        listed: sema_fact_list_detail(facts, read)
        if listed == None && read == FactRead.Dimension -> return sema_fact_first_dimension(value)
        return listed
    }
    if owner == "FunctionInfo" || owner == "MethodInfo" {
        if read == FactRead.Effects -> return sema_fact_struct_field(value, "effects")
        return sema_fact_list_detail(facts, read)
    }
    if owner == "FieldInfo" {
        if read == FactRead.Dimension -> return sema_fact_first_dimension(value)
        return sema_fact_list_detail(facts, read)
    }
    None
}

// A checked value whose content is known before code generation: a literal
// compile-time value, a prepared constant, or a field/`[i]` projection of one.
// Only these carry compiler-owned reflection records.
sema_fact_constant_path: fn(value: TExpr, context: SemaCheckContext) -> Bool Never! {
    if value.kind == {
        .CtLit(_) -> true
        // A constant reference is a flat row (sema_node).
        .Flat(index) -> context.arena.tree.nodes[index - context.arena.tree.node_base].kind == .ConstRef(_)
        .Field(receiver, _) -> sema_fact_constant_path(receiver, context)
        .Index(base, index, _, _, _, _) -> index.kind == .IntLit(_, _) && sema_fact_constant_path(base, context)
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) -> false
    }
}

// `record.field` over a compiler-owned reflection record. The checked read
// keeps a field reference with no nominal owner; codegen folds the prepared
// constant path to its value.
sema_fact_reflection_field: fn(base: TExpr, member: String, span: Span, context: SemaCheckContext) -> TExpr? {
    owner_name := ""
    if base.ty == {
        .Named(name) -> owner_name = name
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> return None
    }
    if !sema_fact_constant_path(base, context) -> return None
    field_ty: sema_fact_reflection_field_type(owner_name, member) ?? return None
    reference: TFieldRef{owner: None, field: symbol_id(SymbolKind.Field, "", owner_name, member), name: member, ty: field_ty, boxed: false}
    Val(sema_tree_node(field_ty, TExprKind.Field{receiver: base, field: reference}, span))
}

sema_fact_path_text: fn(base: Expr, member: String) -> String? {
    if base == {
        .Ident(name, _, _) -> return Val("{name}.{member}")
        .Field(inner, inner_member, _, _) -> {
            prefix: sema_fact_path_text(inner, inner_member) ?? return None
            return Val("{prefix}.{member}")
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_fact_expr_path: fn(expr: Expr) -> String? {
    if expr == {
        .Ident(name, _, _) -> return Val(name)
        .Field(base, member, _, _) -> return sema_fact_path_text(base, member)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// `#build` and `#package` are compiler values, which no binding shadows.
sema_fact_build_rooted: fn(base: Expr) -> Bool Never! {
    if base == {
        .Ident(name, _, _) -> return name == "#build" || name == "#package"
        .Field(inner, _, _, _) -> return sema_fact_build_rooted(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return false
    }
}

// The registered build-fact paths (Rust `Registry::build_fact_read`) and the
// typed value each one takes from the snapshot (Rust `BuildFactSnapshot::value`).
// `#build.target.*` reads the facts of the machine the build targets, the
// ones `core.target` declares for each machine.
sema_fact_build_value: fn(path: String, facts: SemaBuildFacts, machine: TargetMachine) -> SemaFactReadValue? {
    if {
        path == "#package.name" -> Val(SemaFactReadValue{ty: Type.String, value: TComptimeValue.String{value: facts.package_name}})
        path == "#package.version" -> Val(SemaFactReadValue{ty: Type.String, value: TComptimeValue.String{value: facts.package_version}})
        path == "#build.target.os" -> Val(SemaFactReadValue{ty: Type.String, value: TComptimeValue.String{value: facts.os}})
        path == "#build.profile" -> Val(SemaFactReadValue{ty: Type.String, value: TComptimeValue.String{value: facts.profile}})
        path == "#build.stamp.git" -> Val(SemaFactReadValue{ty: Type.Option{inner: Type.String}, value: sema_fact_optional_string(facts.stamp_git)})
        path == "#build.stamp.dirty" -> Val(SemaFactReadValue{ty: Type.Bool, value: TComptimeValue.Bool{value: facts.stamp_dirty}})
        path == "#build.stamp.toolchain" -> Val(SemaFactReadValue{ty: Type.String, value: TComptimeValue.String{value: facts.stamp_toolchain}})
        path == "#build.stamp.at" -> Val(SemaFactReadValue{ty: Type.String, value: TComptimeValue.String{value: facts.stamp_at}})
        path == "#build.cpu.cache_line" -> Val(SemaFactReadValue{ty: Type.Int, value: TComptimeValue.Int{value: COMPILER_BUILD_CPU_CACHE_LINE_GENERIC}})
        path == "#build.target.triple" -> Val(SemaFactReadValue{ty: Type.String, value: TComptimeValue.String{value: machine.triple}})
        path == "#build.target.layout.pointer_bits" || path == "#build.target.layout.word_bits" -> Val(SemaFactReadValue{ty: Type.Int, value: TComptimeValue.Int{value: jet_target_layout_pointer_size(machine.triple) * 8}})
        path == "#build.target.layout.cache_line" -> Val(SemaFactReadValue{ty: Type.Int, value: TComptimeValue.Int{value: jet_target_layout_cache_line(machine.triple)}})
        path == "#build.target.cpu_features" -> Val(SemaFactReadValue{ty: Type.List{element: Type.String}, value: TComptimeValue.List{values: loop feature in jet_target_layout_cpu_features(machine.triple) -> TComptimeValue.String{value: feature}}})
        else -> None
    }
}

// `#build.settings.<key>` names one declared setting (Rust
// `Registry::build_setting_key`): a single non-empty key segment.
sema_fact_build_setting_key: fn(path: String) -> String? {
    prefix: "#build.settings."
    if !path.starts_with(prefix) -> return None
    key: path.slice(prefix.len(), path.len())
    if key.len() == 0 || key.contains(".") -> return None
    Val(key)
}

sema_fact_build_setting_undeclared: fn(key: String, span: Span) -> Diagnostic {
    sema_error("E0302", span, "`#build.settings.{key}` is undeclared", "a setting must be declared with a type and default in the package manifest before it can be read", "add `{key}: Type = default` to the package `settings: {{ … }}` block")
}

// A setting value the package cannot use as its declared type (Rust
// `setting_value_diagnostic`).
sema_fact_build_setting_invalid: fn(setting: SemaBuildSetting, detail: String, span: Span) -> Diagnostic {
    sema_error("E0302", span, "setting `{setting.name}` cannot use `{setting.value}` as `{setting.ty}`", detail, "use a `{setting.ty}` value for the declared setting `{setting.name}`")
}

// Rust `unquote_setting`: the text between `"` quotes, with `\n`, `\r`, `\t`
// and `\<c>` escapes decoded. Unquoted text is kept as written.
sema_fact_build_setting_unquote: fn(raw: String) -> String Never! {
    text: raw.trim()
    body := text
    if text.count_bytes() >= 2 && text.starts_with("\"") && text.ends_with("\"") -> body = text.slice(1, text.len() - 1)
    out := ""
    escaped := false
    loop ch in body.chars() {
        if escaped {
            if ch == {
                'n' -> out = "{out}\n"
                'r' -> out = "{out}{String.from_bytes([U8]{U8{13}}) ?? ""}"
                't' -> out = "{out}\t"
                else -> out = "{out}{ch}"
            }
            escaped = false
        } else if ch == '\\' {
            escaped = true
        } else {
            out = "{out}{ch}"
        }
    }
    if escaped -> out = "{out}\\"
    out
}

// The declared setting's typed value for this build (Rust
// `parse_setting_value`): `Bool`, `Int`, `Char`, `String` or a fieldless
// enum the reading module resolves, written `.Variant` or `Variant`.
sema_fact_build_setting_value: fn(setting: SemaBuildSetting, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> SemaFactReadValue? {
    raw: setting.value.trim()
    ty: setting.ty.trim()
    if ty == "Bool" {
        if raw == "true" -> return Val(SemaFactReadValue{ty: Type.Bool, value: TComptimeValue.Bool{value: true}})
        if raw == "false" -> return Val(SemaFactReadValue{ty: Type.Bool, value: TComptimeValue.Bool{value: false}})
        diagnostics.push(sema_fact_build_setting_invalid(setting, "Bool settings use `true` or `false`", span))
        return None
    }
    if ty == "Int" {
        number: Int.parse(raw) ?? {
            diagnostics.push(sema_fact_build_setting_invalid(setting, "Int settings use a signed 64-bit whole number", span))
            return None
        }
        return Val(SemaFactReadValue{ty: Type.Int, value: TComptimeValue.Int{value: number}})
    }
    if ty == "String" -> return Val(SemaFactReadValue{ty: Type.String, value: TComptimeValue.String{value: sema_fact_build_setting_unquote(raw)}})
    if ty == "Char" {
        text := raw
        if raw.count_bytes() >= 2 && raw.starts_with("'") && raw.ends_with("'") -> text = sema_fact_build_setting_unquote(raw.slice(1, raw.len() - 1))
        code: sema_checked_const_char(text) ?? -1
        count := 0
        loop _ in text.chars() -> count += 1
        if code < 0 || count != 1 {
            diagnostics.push(sema_fact_build_setting_invalid(setting, "Char settings use one quoted character", span))
            return None
        }
        return Val(SemaFactReadValue{ty: Type.Char, value: TComptimeValue.Char{value: code}})
    }
    variant := raw
    if raw.starts_with(".") -> variant = raw.slice(1, raw.len()).trim()
    if program.registration_graph == .Val(graph) {
        row: sema_type_resolve_nominal_row(graph, Type.Named{name: ty}, environment.module_identity) ?? {
            diagnostics.push(sema_fact_build_setting_invalid(setting, "`{ty}` is not a declared fieldless enum", span))
            return None
        }
        nominal: graph.modules[row.module_index].nominals[row.row]
        if nominal.kind != SemaRegistrationNominalKind.Enum {
            diagnostics.push(sema_fact_build_setting_invalid(setting, "settings use Bool, Int, Char, String, or a fieldless enum type", span))
            return None
        }
        loop row_variant in nominal.variants {
            if row_variant.symbol.name != variant -> next
            if row_variant.payload == {
                .Unit -> {}
                .Single(_, _) | .Named(_) -> break
            }
            return Val(SemaFactReadValue{ty: Type.Named{name: ty}, value: TComptimeValue.Enum{type_name: ty, variant: variant, args: [TComptimeEnumArg]{}}})
        }
        diagnostics.push(sema_fact_build_setting_invalid(setting, "`{ty}` has no fieldless variant `{variant}`", span))
    }
    None
}

// `#build.settings.<key>`: the package's declared setting, read as its type.
// The package declares it in `package.jet` (`settings: {{ key: Type = default }}`);
// a `build:` profile may set it.
sema_fact_build_setting: fn(key: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> SemaFactReadValue? {
    if program.registration_graph == .Val(graph) {
        loop setting in graph.build_facts.settings {
            if setting.name == key -> return sema_fact_build_setting_value(setting, span, environment, program, diagnostics)
        }
    }
    diagnostics.push(sema_fact_build_setting_undeclared(key, span))
    None
}

// A complete `#package.*` / `#build.*` path folds to its
// typed snapshot value (Rust `fold_fact_read`, which reads build paths before
// the compile-time-only gate); `#build.settings.<key>` reads a declared setting.
sema_fact_build_read: fn(base: Expr, member: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaFactReadCheck {
    if !sema_fact_build_rooted(base) -> return sema_fact_read_unhandled()
    path: sema_fact_path_text(base, member) ?? return sema_fact_read_unhandled()
    if sema_fact_build_setting_key(path) == .Val(key) {
        resolved: sema_fact_build_setting(key, span, environment, program, diagnostics) ?? return sema_fact_read_failed()
        prepared: sema_fact_prepared_expr(resolved.value, resolved.ty, span, environment, program, context) ?? return sema_fact_read_failed()
        return SemaFactReadCheck{handled: true, value: sema_expr_expected(prepared, expected, environment, program, diagnostics)}
    }
    if program.registration_graph == .Val(graph) {
    resolved: sema_fact_build_value(path, graph.build_facts, graph.target_machine) ?? return sema_fact_read_unhandled()
    prepared: sema_fact_prepared_expr(resolved.value, resolved.ty, span, environment, program, context) ?? return sema_fact_read_failed()
    return SemaFactReadCheck{handled: true, value: sema_expr_expected(prepared, expected, environment, program, diagnostics)}
    }
    sema_fact_read_unhandled()
}

// A prepared value as a checked expression: scalars keep their literal forms,
// records and lists stay one compile-time literal.
sema_fact_prepared_expr: fn(value: TComptimeValue, ty: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, context: &SemaCheckContext) -> TExpr? {
    if value == .Int(number) {
        width := TIntegerWidth?{None}
        if sema_expr_numeric_base(ty) == .IntN(signed, bits) -> width = Val(TIntegerWidth{signed: signed, bits: bits})
        return sema_expr_int_literal_tree(number, ty, width, span, environment, program)
    }
    if value == .Bool(flag) -> return Val(sema_node(context, ty, NodeKind.BoolLit{value: flag}, span))
    kind: if value == {
        .String(text) -> TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: text}}}
        .Int(_) | .Float(_, _) | .Bool(_) | .Char(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit -> TExprKind.CtLit{value: value}
    }
    sema_tree_expr(ty, kind, span)
}

// The value of a checked prepared-constant path over a literal compile-time
// record (`FACT.field`, `FACTS[0]`, `x.reflect().sendability.known`). Codegen folds the
// same paths (`PreparedConstants.jet`).
sema_fact_constant_path_value: fn(value: TExpr, context: SemaCheckContext) -> TComptimeValue? {
    if value.kind == {
        .IntLit(number, _) -> return Val(TComptimeValue.Int{value: number})
        .Flat(row) -> {
            if context.arena.tree.nodes[row - context.arena.tree.node_base].kind == .BoolLit(flag) -> return Val(TComptimeValue.Bool{value: flag})
            return None
        }
        // copy: `known` is a payload of read parameter `value`, which keeps the original; the Val carrier owns this one
        .CtLit(known) -> return Val(known.copy())
        .Field(receiver, field) -> {
            base: sema_fact_constant_path_value(receiver, context) ?? return None
            if field.name.starts_with("$") -> return sema_fact_reflected_field(base, field.name)
            return sema_fact_struct_field(base, field.name)
        }
        .Index(receiver, index, _, _, _, _) -> {
            base: sema_fact_constant_path_value(receiver, context) ?? return None
            position := -1
            if index.kind == .IntLit(number, _) -> position = number
            if base == .List(values) {
                if position >= 0 && position < values.len() -> return Val(values[position])
            }
            return None
        }
        .StrLit(_) | .Local(_) | .InlineBlock(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) -> None
    }
}

sema_fact_struct: fn(type_name: String, fields: [TComptimeField]) -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: type_name, fields: fields}
}

sema_fact_optional_string: fn(value: String?) -> TComptimeValue Never! {
    if value == .Val(text) -> sema_comptime_reflection_some(TComptimeValue.String{value: text}) else -> sema_comptime_reflection_none(Type.String)
}

sema_fact_unit_scale_provenance: fn(value: UnitScaleProvenance) -> TComptimeValue Never! {
    kind := "Rational"
    detail := String?{None}
    source := String?{None}
    uncertainty := String?{None}
    if value == {
        .Rational -> {}
        .SymbolicPi(numerator, denominator) -> {
            kind = "SymbolicPi"
            detail = Val("{sema_plugin_unit_ratio(numerator)}/{sema_plugin_unit_ratio(denominator)}")
        }
        .Conventional(text, origin) -> {
            kind = "Conventional"
            detail = Val(text)
            source = Val(origin)
        }
        .Measured(central_value, standard_uncertainty, origin) -> {
            kind = "Measured"
            detail = Val(central_value)
            source = Val(origin)
            uncertainty = Val(standard_uncertainty)
        }
    }
    sema_fact_struct("UnitScaleProvenanceInfo", [TComptimeField]{
        TComptimeField{name: "kind", value: TComptimeValue.Enum{type_name: "UnitScaleProvenanceKind", variant: kind, args: [TComptimeEnumArg]{}}},
        TComptimeField{name: "value", value: sema_fact_optional_string(detail)},
        TComptimeField{name: "source", value: sema_fact_optional_string(source)},
        TComptimeField{name: "uncertainty", value: sema_fact_optional_string(uncertainty)},
    })
}

sema_fact_known: fn(type_name: String, known: Bool) -> TComptimeValue Never! {
    sema_fact_struct(type_name, [TComptimeField]{TComptimeField{name: "known", value: TComptimeValue.Bool{value: known}}})
}

sema_fact_untracked_origin: fn() -> TComptimeValue Never! {
    sema_fact_struct("OriginInfo", [TComptimeField]{
        TComptimeField{name: "tracked", value: TComptimeValue.Bool{value: false}},
        TComptimeField{name: "source", value: sema_comptime_reflection_none(Type.String)},
        TComptimeField{name: "line", value: sema_comptime_reflection_none(Type.Int)},
        TComptimeField{name: "column", value: sema_comptime_reflection_none(Type.Int)},
        TComptimeField{name: "ambiguity", value: TComptimeValue.Bool{value: false}},
    })
}

sema_fact_function_view_provenance: fn(function: Func) -> TComptimeValue Never! {
    if function.return_view_provenance == .Val(map) {
        if map.entries.len() > 0 -> return sema_comptime_reflection_view_provenance(map.entries[0].value)
    }
    sema_comptime_reflection_view_provenance(ViewProvenance{sources: [ViewSourcePath]{}, mutable: false})
}

sema_fact_function_effects: fn(function: Func) -> TComptimeValue Never! {
    names := [String]{}
    if function.declared_effects == .Val(rows) {
        loop row in rows -> names.push(row.name)
    }
    sema_fact_struct("EffectInfo", [TComptimeField]{TComptimeField{name: "values", value: sema_comptime_reflection_string_list(names)}})
}

// The declaration a subject name resolves to, if it is a module-level item.
sema_fact_subject_item: fn(symbol: Symbol?, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Item? {
    resolved: symbol ?? return None
    if resolved.kind != SymbolKind.Type && resolved.kind != SymbolKind.Function -> return None
    sema_scope_resolve_declaration(environment, program, resolved.id)
}

// `TypeInfo` for a registered nominal subject. Fact reads need only the
// type's own fact rows, so the marker catalog is empty here. A type the
// module scope does not bind (a Core type, `module.Type`) is the nominal row
// its path names from this module.
sema_fact_type_info: fn(symbol: Symbol?, name: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TComptimeValue? {
    catalog: TAppliedRuleCatalog{rows: [TAppliedRule]{}, argument_menus: [TAppliedRuleArgumentMenu]{}}
    if program.registration_graph == .Val(graph) {
        if symbol == .Val(resolved) {
            if resolved.kind != SymbolKind.Type -> return None
            return sema_comptime_reflection_type_info(graph, resolved.module_name, name, catalog)
        }
        row: sema_type_resolve_nominal_row(graph, Type.Named{name: name}, environment.module_identity) ?? return None
        return sema_comptime_reflection_type_info(graph, graph.modules[row.module_index].module_identity, graph.modules[row.module_index].nominals[row.row].symbol.name, catalog)
    }
    None
}

// A reflection record folded into a program value keeps only the fields its
// Core record rows declare. Producer-only members (a marker's `sites`) feed
// derive templates; no program can name them, and the IR builds a record
// constant from its declared layout. A struct with no declared row at all is
// not a Core record and keeps every field. A written marker argument keeps its
// value too (sema_fact_answered_member).
sema_fact_declared_value: fn(value: TComptimeValue) -> TComptimeValue Never! {
    if value == {
        .Struct(type_name, fields) -> {
            declared: loop field in fields {
                if core_record_field(type_name, field.name) != None -> break true
            } ?? false
            kept := [TComptimeField]{}
            loop field in fields {
                if declared && core_record_field(type_name, field.name) == None && !sema_fact_answered_member(type_name, field.name) -> next
                kept.push(TComptimeField{name: field.name, value: sema_fact_declared_value(field.value)})
            }
            return TComptimeValue.Struct{type_name: type_name, fields: kept}
        }
        .List(values) -> return TComptimeValue.List{values: loop item in values -> sema_fact_declared_value(item)}
        .Present(inner) -> return TComptimeValue.Present{value: sema_fact_declared_value(inner)}
        // copy: a scalar leaf of the read producer value; the caller keeps the original
        .Int(_) | .Float(_, _) | .Bool(_) | .Char(_) | .String(_) | .BigInt(_) | .Bytes(_) | .Map(_) | .Enum(_, _, _) | .Failed(_) | .Unit -> return value.copy()
    }
}

// A member with no Core record row that the compiler still answers from: a
// written marker argument's `value` (its type is the marker parameter's) is
// what `info.marker(T)` reads into its `T` (jet_eval_reflection_marker_value).
// The IR lays the record out from its declared rows, so a program never sees it.
sema_fact_answered_member: fn(type_name: String, field: String) -> Bool Never! {
    type_name == "MarkerArgInfo" && field == "value"
}

sema_fact_state_infos: fn(definition: StructDef, symbol: Symbol, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TComptimeValue? {
    if definition.state == None -> return None
    graph_fact := SemaStateGraphFact?{None}
    if program.registration_graph == .Val(graph) {
        module_index: sema_registration_module_index(graph, symbol.module_name)
        if module_index == .Val(index) {
            loop fact in sema_state_graph_facts(graph.modules[index].program.items) {
                if fact.type_name == definition.name {
                    graph_fact = Val(fact)
                    break
                }
            }
        }
    }
    Val(sema_comptime_reflection_state_view(definition, graph_fact).states)
}

sema_fact_unit: fn(name: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaRegistrationUnitFact? {
    if program.registration_graph == .Val(graph) -> return sema_registration_unit_fact_for_type(graph, Type.Named{name: name})
    None
}

// One subject named by a bare identifier that is not a local: a type, a
// function, a unit member, or the `report` attribution subject.
sema_fact_subject_value: fn(read: FactRead, name: String, symbol: Symbol?, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaFactReadValue? {
    item: sema_fact_subject_item(symbol, environment, program)
    unit: sema_fact_unit(name, environment, program)
    declared: item != None || unit != None
    if read == FactRead.Layout || read == FactRead.Name || read == FactRead.Fields {
        // A builtin scalar has no declaration, only its fixed target layout.
        if read == FactRead.Layout && symbol == None && program.registration_graph == .Val(graph) {
            if sema_comptime_reflection_builtin_layout(graph, name) == .Val(layout) -> return Val(SemaFactReadValue{ty: sema_fact_named("LayoutInfo"), value: sema_fact_declared_value(layout)})
        }
        info: sema_fact_type_info(symbol, name, environment, program) ?? return None
        field: if read == FactRead.Layout -> "layout" else -> if read == FactRead.Name -> "name" else -> "fields"
        value: sema_fact_declared_value(sema_fact_struct_field(info, field) ?? return None)
        ty: sema_fact_reflection_field_type("TypeInfo", field) ?? return None
        return Val(SemaFactReadValue{ty: ty, value: value})
    }
    if read == FactRead.Range {
        if item == .Val(.Distinct(definition)) {
            if definition.range == .Val(range) -> return Val(SemaFactReadValue{ty: sema_fact_named("Range"), value: sema_comptime_reflection_range(range.lo, range.hi)})
        }
        return None
    }
    if read == FactRead.Dimension {
        fact: unit ?? return None
        dimension: fact.dimension ?? return None
        return Val(SemaFactReadValue{ty: sema_fact_named("DimensionInfo"), value: sema_comptime_reflection_dimension(dimension)})
    }
    if read == FactRead.Measure || read == FactRead.Exactness || read == FactRead.Classification || read == FactRead.Obligation {
        info: sema_fact_type_info(symbol, name, environment, program) ?? return None
        value: sema_fact_reflected_read(info, read) ?? return None
        ty: sema_fact_reflected_type(sema_fact_named("TypeInfo"), read) ?? return None
        return Val(SemaFactReadValue{ty: ty, value: value})
    }
    if read == FactRead.States {
        if item == .Val(.Struct(definition)) {
            resolved: symbol ?? return None
            states: sema_fact_state_infos(definition, resolved, environment, program) ?? return None
            return Val(SemaFactReadValue{ty: sema_fact_list_of("StateInfo"), value: states})
        }
        return None
    }
    if read == FactRead.Effects {
        if item == .Val(.Func(function)) -> return Val(SemaFactReadValue{ty: sema_fact_named("EffectInfo"), value: sema_fact_function_effects(function)})
        return None
    }
    if !declared && (read == FactRead.Sendability || read == FactRead.Movedness || read == FactRead.Origin) -> return None
    if read == FactRead.Sendability -> return Val(SemaFactReadValue{ty: sema_fact_named("SendabilityInfo"), value: sema_fact_known("SendabilityInfo", true)})
    if read == FactRead.Movedness -> return Val(SemaFactReadValue{ty: sema_fact_named("MovednessInfo"), value: sema_fact_known("MovednessInfo", false)})
    if read == FactRead.Origin -> return Val(SemaFactReadValue{ty: sema_fact_named("OriginInfo"), value: sema_fact_untracked_origin()})
    if read == FactRead.Attribution {
        if name != "report" -> return None
        value: sema_fact_struct("AttributionInfo", [TComptimeField]{
            TComptimeField{name: "source", value: TComptimeValue.String{value: "report"}},
            TComptimeField{name: "code", value: sema_comptime_reflection_none(Type.String)},
        })
        return Val(SemaFactReadValue{ty: sema_fact_named("AttributionInfo"), value: value})
    }
    if read == FactRead.ViewProvenance {
        if item == .Val(.Func(function)) -> return Val(SemaFactReadValue{ty: sema_fact_named("ViewProvenanceInfo"), value: sema_fact_function_view_provenance(function)})
        return None
    }
    if read == FactRead.UnitScaleProvenance {
        fact: unit ?? return None
        return Val(SemaFactReadValue{ty: sema_fact_named("UnitScaleProvenanceInfo"), value: sema_fact_unit_scale_provenance(fact.scale_provenance)})
    }
    if read == FactRead.Maturity {
        if item == .Val(.Func(function)) -> return Val(SemaFactReadValue{ty: sema_fact_named("MaturityInfo"), value: sema_comptime_reflection_maturity(function)})
        return None
    }
    plane: if read == .RegisteredPlane(registered) -> registered else -> { return None }
    if name != plane -> return None
    Val(SemaFactReadValue{ty: sema_fact_named("FactValue"), value: sema_comptime_reflection_fact_value(plane, plane, [String]{}, None, None, "", None)})
}

SemaFactReadValue: struct {
    ty: Type
    value: TComptimeValue
}

sema_fact_read_no_value: fn(member: String, span: Span, diagnostics: &[Diagnostic]) -> SemaFactReadCheck {
    diagnostics.push(sema_error("E0302", span, "`{sema_fact_member_display(member)}` has no registered value for this subject", "fact reads answer typed values from the subject's registered plane", "read the fact on a matching type, function, or the `build` subject"))
    sema_fact_read_failed()
}

// Resolve `base.$member`. `handled: false` leaves an unregistered `$` member
// (or a nominal fact the subject cannot answer) to the ordinary field path.
sema_fact_read_check: fn(base: Expr, member: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaFactReadCheck {
    read: sema_fact_read_kind(member) ?? return sema_fact_read_unhandled()
    if scopes.comptime_execution_depth == 0 {
        fix: if sema_fact_path_text(base, member) == .Val(path) -> "Write `FACT: comptime {{ {path.replace(".$", ".reflect().")} }}`, then use `FACT` in this expression" else -> "Move the read into a prepared value `NAME: comptime {{ … }}` or a `comptime {{ … }}` block"
        diagnostics.push(sema_error("E0302", span, "fact read `{sema_fact_member_display(member)}` is compile-time only", "a fact is a value known before code generation; it never selects runtime behavior", fix))
        return sema_fact_read_failed()
    }
    if base == .Ident(name, _, _) {
        index: sema_scope_resolve_index(scopes, name)
        symbol := Symbol?{None}
        if index == .Val(binding_index) -> symbol = Val(sema_scope_binding_symbol(environment, scopes, binding_index))
        is_local := false
        is_constant := false
        if symbol == .Val(found) {
            is_local = found.kind == SymbolKind.Local || found.kind == SymbolKind.Parameter
            is_constant = found.kind == SymbolKind.Constant
        }
        if is_local {
            // A bound local answers the ownership planes the checker holds for
            // it; reading them neither uses nor moves the local.
            bound: symbol ?? return sema_fact_read_failed()
            if read == FactRead.Sendability {
                local_ty: bound.ty ?? return sema_fact_read_no_value(member, span, diagnostics)
                problem: sema_ownership_crossing_problem_for_name(name, local_ty, SemaSendCrossing.TaskCapture, true, environment, program, scopes, state, context)
                value: sema_fact_known("SendabilityInfo", problem == None)
                return SemaFactReadCheck{handled: true, value: sema_expr_expected_owned(sema_tree_node(sema_fact_named("SendabilityInfo"), TExprKind.CtLit{value: value}, span), expected, environment, program, diagnostics)}
            }
            if read == FactRead.Movedness {
                moved := false
                place: sema_ownership_place_from_expr_inner(base, scopes)
                if place == .Val(found) -> moved = sema_ownership_place_moved(state, found) != None
                value: sema_fact_known("MovednessInfo", moved)
                return SemaFactReadCheck{handled: true, value: sema_expr_expected_owned(sema_tree_node(sema_fact_named("MovednessInfo"), TExprKind.CtLit{value: value}, span), expected, environment, program, diagnostics)}
            }
            if read == FactRead.Origin {
                binding_index: index ?? return sema_fact_read_failed()
                origin := scopes.bindings[binding_index].origin
                place: sema_ownership_place_from_expr_inner(base, scopes)
                if place == .Val(found) && sema_ownership_place_moved(state, found) != None -> origin = None
                value: sema_fact_local_origin(origin)
                return SemaFactReadCheck{handled: true, value: sema_expr_expected_owned(sema_tree_node(sema_fact_optional("OriginInfo"), TExprKind.CtLit{value: value}, span), expected, environment, program, diagnostics)}
            }
            if read == FactRead.Origin {
                binding_index: index ?? return sema_fact_read_failed()
                origin := scopes.bindings[binding_index].origin
                place: sema_ownership_place_from_expr_inner(base, scopes)
                if place == .Val(found) && sema_ownership_place_moved(state, found) != None -> origin = None
                value: sema_fact_local_origin(origin)
                return SemaFactReadCheck{handled: true, value: sema_expr_expected_owned(sema_tree_node(sema_fact_optional("OriginInfo"), TExprKind.CtLit{value: value}, span), expected, environment, program, diagnostics)}
            }
            if read == FactRead.Layout || read == FactRead.Name || read == FactRead.Fields -> return sema_fact_read_unhandled()
            return sema_fact_read_no_value(member, span, diagnostics)
        }
        if !is_constant {
            resolved: sema_fact_subject_value(read, name, symbol, environment, program) ?? {
                if read == FactRead.Layout || read == FactRead.Name || read == FactRead.Fields -> return sema_fact_read_unhandled()
                return sema_fact_read_no_value(member, span, diagnostics)
            }
            folded: sema_tree_node(resolved.ty, TExprKind.CtLit{value: resolved.value}, span)
            return SemaFactReadCheck{handled: true, value: sema_expr_expected(folded, expected, environment, program, diagnostics)}
        }
    }
    // `module.Type.reflect().name`: a qualified type path is no value to check; it reads
    // the reflected type it names.
    if base == .Field(_, _, _, _) && (read == FactRead.Layout || read == FactRead.Name || read == FactRead.Fields) {
        if sema_fact_expr_path(base) == .Val(path) {
            if sema_fact_subject_value(read, path, None, environment, program) == .Val(resolved) {
                folded: sema_tree_node(resolved.ty, TExprKind.CtLit{value: resolved.value}, span)
                return SemaFactReadCheck{handled: true, value: sema_expr_expected(folded, expected, environment, program, diagnostics)}
            }
        }
    }
    checked_base: sema_check_expression(base, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return sema_fact_read_failed()
    aggregate_ty: sema_fact_reflected_type(checked_base.ty, read)
    if aggregate_ty == .Val(ty) {
        if checked_base.kind == .CtLit(aggregate) {
            value: sema_fact_reflected_field(aggregate, member) ?? return sema_fact_read_no_value(member, span, diagnostics)
            return SemaFactReadCheck{handled: true, value: sema_expr_expected_owned(sema_tree_node(ty, TExprKind.CtLit{value: value}, span), expected, environment, program, diagnostics)}
        }
        if sema_fact_constant_path(checked_base, context) {
            owner_name: type_name(checked_base.ty)
            reference: TFieldRef{owner: None, field: symbol_id(SymbolKind.Field, "", owner_name, member), name: member, ty: ty, boxed: false}
            return SemaFactReadCheck{handled: true, value: sema_expr_expected_owned(sema_tree_node(ty, TExprKind.Field{receiver: checked_base, field: reference}, span), expected, environment, program, diagnostics)}
        }
        return sema_fact_read_no_value(member, span, diagnostics)
    }
    if read == FactRead.Layout || read == FactRead.Name || read == FactRead.Fields -> return sema_fact_read_unhandled()
    sema_fact_read_no_value(member, span, diagnostics)
}
