// Fixed arrays of numbers combine slot by slot. `a + b` on two `[T#N]`, `a * k`
// and `k * a` with one number `k`, and `-a` and `~a` are each the hand-written
// `[T#N]{a[0] + b[0], …, a[N-1] + b[N-1]}`: each operand is evaluated once
// into a local of its own, and each slot is checked as the scalar operator on
// that slot's elements. So a slot means what the scalar operator means, on
// every tier: its overflow stop, its zero-divisor stop, and `Int / Int` making
// a Fraction. A number literal beside an array is read as an element, as in
// `[T#N]{k, …}`. Two arrays of different lengths or element types, or an
// array beside a value that is not one of its elements, are E0446. `==` and
// `!=` compare whole arrays and are not slot by slot.
//
// A Core integer lane type (`I32x4`) whose declaration has `__with_lanes`
// takes the bit operators, the shifts and `~` the same way, lane by lane on
// its `lanes` field, with another value of that lane type or one integer;
// the result is `__with_lanes` of the slots. Its arithmetic is its own.
use jet_foundation.[
    AST_EMPTY_CALL_ARG_FLAGS,
    AST_NODE_GENERATED,
    AccessConvention,
    BinOp,
    CallArg,
    Diagnostic,
    Expr,
    IndexKind,
    Measure,
    Span,
    Symbol,
    SymbolKind,
    TLetTy,
    Type,
    UnOp,
    checked_symbol_local,
    measure_literal_value,
    symbol_key_text,
    type_identity_equal,
    type_name,
]

// A fixed array of numbers whose length is known while building, or the
// lanes of an integer lane type (`lanes`).
SemaFixedShape: struct {
    element: Type,
    length: Int,
    measure: Measure,
    lanes: Bool,
}

sema_expr_fixed_shape: fn(ty: Type) -> SemaFixedShape? {
    if ty == .FixedList(element, measure) {
        if !sema_expr_is_numeric(element) && sema_expr_precise_name(element) == None -> return None
        length: measure_literal_value(measure) ?? return None
        return Val(SemaFixedShape{element: element, length: length, measure: measure, lanes: false})
    }
    None
}

// The lanes of a Core integer lane type whose declaration rebuilds itself
// with `__with_lanes`, or None for any other type.
sema_expr_lane_shape: fn(ty: Type, check: SemaBodyCheck) -> SemaFixedShape? {
    if ty == .FixedList(_, _) -> return None
    slots: sema_expression_swizzle_slots(ty, check) ?? return None
    if !slots.lanes || slots.declared & (1 << SEMA_WITH_LANES_BIT) == 0 || !sema_expr_is_integer(slots.element) {
        return None
    }
    Val(SemaFixedShape{element: slots.element, length: slots.length, measure: Measure.Literal{kind: "length", value: slots.length}, lanes: true})
}

// The slots of one operand of `op`: a fixed array of numbers, or, for a bit
// operator or shift, the lanes of an integer lane type.
sema_expr_fixed_operand_shape: fn(op: BinOp, ty: Type, check: SemaBodyCheck) -> SemaFixedShape? {
    if sema_expr_fixed_shape(ty) == .Val(shape) -> return Val(shape)
    if !sema_expr_fixed_integer_operator(op) -> return None
    sema_expr_lane_shape(ty, check)
}

// The type as E0446 names it: `I32x4`, not its Core identity.
sema_expr_fixed_shown: fn(ty: Type) -> String { sema_expr_math_leaf_name(ty) ?? type_name(ty) }

// The bit operators, which need integer slots.
sema_expr_fixed_integer_operator: fn(op: BinOp) -> Bool Never! {
    op == BinOp.BitAnd || op == BinOp.BitOr || op == BinOp.BitXor || op == BinOp.Shl || op == BinOp.Shr
}

// Whether `op` on these operands works slot by slot: an arithmetic operator
// beside a fixed array of numbers, or a bit operator beside one of integers
// or beside an integer lane type.
sema_expr_fixed_elementwise_applies: fn(op: BinOp, left: Type, right: Type, check: SemaBodyCheck) -> Bool {
    arithmetic: op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div || op == BinOp.FloorDiv || op == BinOp.Mod || op == BinOp.Rem || op == BinOp.Pow
    integer: sema_expr_fixed_integer_operator(op)
    if !arithmetic && !integer -> return false
    shape: sema_expr_fixed_operand_shape(op, left, check) ?? sema_expr_fixed_operand_shape(op, right, check) ?? return false
    !integer || sema_expr_is_integer(shape.element)
}

// Whether a prefix operator works slot by slot on `ty`: `-` on a fixed array
// of numbers, `~` on one of integers or on an integer lane type.
sema_expr_fixed_unary_applies: fn(op: UnOp, ty: Type, check: SemaBodyCheck) -> Bool {
    if op == UnOp.Complement && sema_expr_lane_shape(ty, check) != None -> return true
    shape: sema_expr_fixed_shape(ty) ?? return false
    if op == {
        .Neg -> true
        .Complement -> sema_expr_is_integer(shape.element)
        .Not -> false
    }
}

// A number literal, which a slot reads as it would beside one element.
sema_expr_fixed_number_literal: fn(expr: Expr) -> Bool {
    if expr == .Int(_, _, _, _, _) || expr == .Float(_, _, _, _, _) -> return true
    if expr == .Paren(inner, _, _) -> return sema_expr_fixed_number_literal(inner)
    if expr == .Unary(op, inner, _, _) {
        return op == UnOp.Neg && sema_expr_fixed_number_literal(inner)
    }
    false
}

// E0446 for an operand that can't combine with a fixed array or lane type
// slot by slot, or None when the pair can.
sema_expr_fixed_mismatch: fn(op: BinOp, lhs: Type, rhs: Type, left: Expr, right: Expr, span: Span, check: SemaBodyCheck) -> Diagnostic? {
    operator: sema_expr_binary_name(op)
    left_shape: sema_expr_fixed_operand_shape(op, lhs, check)
    right_shape: sema_expr_fixed_operand_shape(op, rhs, check)
    if left_shape == .Val(left_array) && right_shape == .Val(right_array) {
        if left_array.lanes || right_array.lanes {
            if left_array.lanes && right_array.lanes && type_identity_equal(lhs, rhs) -> return None
            return Val(sema_error("E0446", span, "`{operator}` needs two values of one lane type, but these are `{sema_expr_fixed_shown(lhs)}` and `{sema_expr_fixed_shown(rhs)}`", "an operator on lanes pairs each lane of one value with the same lane of the other", "convert one side to the other's type, through `to_array()` or `from_array`"))
        }
        if left_array.length != right_array.length {
            return Val(sema_error("E0446", span, "`{operator}` needs two arrays of one length, but these are `{type_name(lhs)}` and `{type_name(rhs)}`", "an operator on two fixed arrays pairs each slot of one with the same slot of the other, so every slot needs a partner", "make both arrays the same length, or take a slice of the longer one"))
        }
        if !type_identity_equal(left_array.element, right_array.element) {
            return Val(sema_error("E0446", span, "`{operator}` needs two arrays of one element type, but these are `{type_name(lhs)}` and `{type_name(rhs)}`", "each slot is the scalar `{operator}` on two elements, and that needs one number type on both sides", "convert one array's elements to the other's type first"))
        }
        return None
    }
    array: if left_shape == .Val(shape) -> shape else -> right_shape ?? return None
    array_type: if left_shape != None -> lhs else -> rhs
    other_type: if left_shape != None -> rhs else -> lhs
    other: if left_shape != None -> right else -> left
    if sema_expr_fixed_number_literal(other) -> return None
    shift_count: (op == BinOp.Shl || op == BinOp.Shr) && left_shape != None && sema_expr_is_integer(other_type)
    if shift_count || type_identity_equal(other_type, array.element) -> return None
    shown: sema_expr_fixed_shown(array_type)
    element: type_name(array.element)
    why: if array.lanes -> "a value beside a lane type is applied to every lane, so it needs the lanes' type" else -> "a value beside a fixed array is applied to every slot, so it needs the slots' type"
    fix: if array.lanes -> "convert the value to `{element}`, or make it a `{shown}`" else -> "convert the value to `{element}`, or make it an array of the same shape"
    Val(sema_error("E0446", span, "`{operator}` combines `{shown}` with another `{shown}` or with one `{element}`, but this is `{type_name(other_type)}`", why, fix))
}

// One operand of a slot-by-slot operator as a local of the block the
// operator becomes.
sema_expr_fixed_bind: fn(name: String, value: ^^TExpr, span: Span, check: ^SemaBodyCheck) -> TStmt {
    owner: sema_scope_local_owner_key(check.scopes)
    key: symbol_key_text(SymbolKind.Local, sema_scope_environment_module_text(check.environment.*, check.program.*), owner, name)
    id: sema_symbol_id_of(check.program.*, check.context, key)
    symbol: Symbol{id: id, kind: SymbolKind.Local, name: name, module_identity: check.environment.module_identity, owner: Val(owner), span: span, ty: Val(value.ty), visibility: 0}
    ^_: sema_scope_declare_local(check.scopes, symbol, key, false, AccessConvention.Read, None, false)
    sema_ownership_declare_binding(check.state, symbol, false)
    ^local: checked_symbol_local(name, span, id, value.ty)
    local.generated = true
    TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: value, gc_promotion: None, gc_transferred: false, span: span}
}

sema_expr_fixed_bind_read: fn(name: String, value: TExpr, span: Span, check: ^SemaBodyCheck) -> TStmt {
    owner: sema_scope_local_owner_key(check.scopes)
    key: symbol_key_text(SymbolKind.Local, sema_scope_environment_module_text(check.environment.*, check.program.*), owner, name)
    id: sema_symbol_id_of(check.program.*, check.context, key)
    symbol: Symbol{id: id, kind: SymbolKind.Local, name: name, module_identity: check.environment.module_identity, owner: Val(owner), span: span, ty: Val(value.ty), visibility: 0}
    ^_: sema_scope_declare_local(check.scopes, symbol, key, false, AccessConvention.Read, None, false)
    sema_ownership_declare_binding(check.state, symbol, false)
    ^local: checked_symbol_local(name, span, id, value.ty)
    local.generated = true
    TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: value, gc_promotion: None, gc_transferred: false, span: span}
}

// What a slot reads of one operand's local: its element at `slot` when the
// operand is an array, its lane at `slot` when it is a lane type, else the
// operand.
sema_expr_fixed_slot: fn(name: String, slot: Int?, lanes: Bool, span: Span) -> Expr {
    read: Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}
    at: slot ?? return read
    base: if lanes -> Expr.Field{base: read, member: "lanes", span: span, id: AST_NODE_GENERATED} else -> read
    Expr.Index{base: base, index: Expr.Int{value: at, span: span, width: None, raw: None, id: AST_NODE_GENERATED}, span: span, kind: IndexKind.Unknown, id: AST_NODE_GENERATED}
}

// One operand of `lhs op rhs` as written (`written`) and checked
// (`checked`), bound to the local `name`; `slots` tells whether it is an
// array or lane type. A number literal beside one is checked again as one of
// its elements.
sema_expr_fixed_operand: fn(name: String, written: Expr, checked: ^^TExpr, slots: Bool, shape: SemaFixedShape, span: Span, check: ^SemaBodyCheck) -> TStmt? {
    if slots || !sema_expr_fixed_number_literal(written) {
        return Val(sema_expr_fixed_bind(name, checked, span, check))
    }
    element: sema_check_expression(written, Val(shape.element), check) ?? return None
    Val(sema_expr_fixed_bind(name, element, span, check))
}

// The slots `[T#N]{…}` of a slot-by-slot operator, each checked in the block
// that holds the operand locals in `body`, as the value of that block. When
// `lanes` names the local of a lane-type operand, the value is that type's
// `__with_lanes` of the slots instead.
sema_expr_fixed_slots: fn(slots: [Expr], shape: SemaFixedShape, lanes: String?, body: ^^[TStmt], mark: SemaScopeMark, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    values: loop slot in slots -> {
        // Every slot has one type, so a slot the operator refuses is
        // reported once, at the first.
        value: sema_check_expression(slot, None, check) ?? {
            sema_scope_leave(check.scopes, check.state)
            return None
        }
        value
    }
    element: if values.len() > 0 -> values[0].ty else -> shape.element
    ^list: sema_tree_node(Type.FixedList{elem: element, len: shape.measure}, TExprKind.List{values: values, trait_coercion: None}, span)
    ^statements: body.move()
    if lanes == .Val(holder) {
        at: "{span.start}_{span.end}"
        slots_name: "__jet_slots_value_{at}"
        statements.push(sema_expr_fixed_bind(slots_name, list, span, check))
        argument: CallArg{convention: AccessConvention.Read, expr: Expr.Ident{name: slots_name, span: span, id: AST_NODE_GENERATED}, span: span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
        rebuild: Expr.MethodCall{receiver: Expr.Ident{name: "{holder}", span: span, id: AST_NODE_GENERATED}, method: "__with_lanes", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{argument}, id: AST_NODE_GENERATED}
        list = sema_check_expression(rebuild, None, check) ?? {
            sema_scope_leave(check.scopes, check.state)
            return None
        }
    }
    sema_single_use_leave_scope(check)
    sema_scope_rollback(check.scopes, mark)
    value_ty: list.ty
    statements.push(TStmt.ExprStmt{value: list, span: span})
    sema_expr_expected_owned(sema_tree_node(value_ty, TExprKind.InlineBlock{body: statements}, span), expected, check.environment.*, check.program.*, check.diagnostics)
}

// `lhs op rhs` slot by slot, where sema_expr_fixed_elementwise_applies holds;
// `left` and `right` are the operands as written.
sema_expr_check_fixed_binary: fn(op: BinOp, left: Expr, right: Expr, lhs: ^^TExpr, rhs: ^^TExpr, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if sema_expr_fixed_mismatch(op, lhs.ty, rhs.ty, left, right, span, check) == .Val(refused) {
        check.diagnostics.push(refused)
        return None
    }
    left_shape: sema_expr_fixed_operand_shape(op, lhs.ty, check)
    right_shape: sema_expr_fixed_operand_shape(op, rhs.ty, check)
    left_slots: left_shape != None
    right_slots: right_shape != None
    left_lanes: if left_shape == .Val(found) -> found.lanes else -> false
    right_lanes: if right_shape == .Val(found) -> found.lanes else -> false
    shape: left_shape ?? right_shape ?? return None
    at: "{span.start}_{span.end}"
    left_name: "__jet_slots_left_{at}"
    right_name: "__jet_slots_right_{at}"
    mark: sema_scope_mark(check.scopes)
    sema_scope_enter(check.scopes, check.state, "elementwise@{at}")
    left_bound: sema_expr_fixed_operand(left_name, left, lhs, left_slots, shape, span, check) ?? {
        sema_scope_leave(check.scopes, check.state)
        return None
    }
    right_bound: sema_expr_fixed_operand(right_name, right, rhs, right_slots, shape, span, check) ?? {
        sema_scope_leave(check.scopes, check.state)
        return None
    }
    body: [TStmt]{left_bound, right_bound}
    slots: loop slot in 0..<shape.length -> Expr.Binary{op: op, left: sema_expr_fixed_slot(left_name, if left_slots -> Val(slot) else -> None, left_lanes, span), right: sema_expr_fixed_slot(right_name, if right_slots -> Val(slot) else -> None, right_lanes, span), span: span, id: AST_NODE_GENERATED}
    holder: if {
        left_lanes -> Val(left_name)
        right_lanes -> Val(right_name)
        else -> String?{None}
    }
    sema_expr_fixed_slots(slots, shape, holder, body, mark, span, expected, check)
}

// `-a` or `~a` slot by slot, where sema_expr_fixed_unary_applies holds.
sema_expr_check_fixed_unary: fn(op: UnOp, value: ^^TExpr, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    shape: sema_expr_fixed_shape(value.ty) ?? sema_expr_lane_shape(value.ty, check) ?? return None
    at: "{span.start}_{span.end}"
    mark: sema_scope_mark(check.scopes)
    sema_scope_enter(check.scopes, check.state, "elementwise@{at}")
    name: "__jet_slots_operand_{at}"
    body: [TStmt]{sema_expr_fixed_bind(name, value, span, check)}
    slots: loop slot in 0..<shape.length -> Expr.Unary{op: op, operand: sema_expr_fixed_slot(name, Val(slot), shape.lanes, span), span: span, id: AST_NODE_GENERATED}
    holder: if shape.lanes -> Val(name) else -> String?{None}
    sema_expr_fixed_slots(slots, shape, holder, body, mark, span, expected, check)
}

// The slots `.swizzle(i, ...)` picks from: any fixed array `[T#N]` (N >= 1)
// or any Core vector/lane type whose declaration has a `lanes` array and
// `lane` reader.
sema_expr_numeric_swizzle_slots: fn(ty: Type, check: SemaBodyCheck) -> SemaSwizzleSlots? {
    if ty == .FixedList(element, measure) {
        length: measure_literal_value(measure) ?? return None
        if length < 1 -> return None
        return Val(SemaSwizzleSlots{shown: type_name(ty), element: element, length: length, reach: length, lanes: false, declared: 0})
    }
    graph: check.program.registration_graph
    row: sema_type_resolve_nominal_row(graph, ty, check.environment.module_identity) ?? return None
    sema_expression_swizzle_lane_slots(graph, graph.modules[row.module_index].nominals[row.row], ty)
}

// The legal result lane/vector type name for a numeric `.swizzle` of `count`
// picks from a Core lane or vector type `shown` with element type `element`.
sema_expr_numeric_swizzle_lane_target: fn(shown: String, element: Type, count: Int) -> String? Never! {
    if shown == "Vec2" || shown == "Vec3" || shown == "Vec4" {
        return if count == {
            2 -> Val("Vec2")
            3 -> Val("Vec3")
            4 -> Val("Vec4")
            else -> None
        }
    }
    if element == {
        .Float32 -> if count == 4 -> Val("F32x4") else if count == 8 -> Val("F32x8") else -> None
        .Float -> if count == 2 -> Val("F64x2") else if count == 4 -> Val("F64x4") else -> None
        .IntN(signed, bits) -> {
            prefix: if signed -> "I" else -> "U"
            if bits == {
                8 -> if count == 16 || count == 32 -> Val("{prefix}8x{count}") else -> None
                16 -> if count == 8 || count == 16 -> Val("{prefix}16x{count}") else -> None
                32 -> if count == 4 || count == 8 -> Val("{prefix}32x{count}") else -> None
                64 -> if count == 2 || count == 4 -> Val("{prefix}64x{count}") else -> None
                else -> None
            }
        }
        .Int | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// Compile-time integer expression for a numeric `.swizzle` index: literals,
// unary negation, `+`/`-`/`*`, and immutable top-level constants.
sema_expr_swizzle_const_int: fn(expr: Expr, check: SemaBodyCheck, depth: Int) -> Int? {
    if depth <= 0 -> return None
    if expr == {
        .Int(value, _, _, _, _) -> Val(value)
        .Paren(inner, _, _) -> sema_expr_swizzle_const_int(inner, check, depth - 1)
        .Unary(op, operand, _, _) -> {
            if op != UnOp.Neg -> return None
            number: sema_expr_swizzle_const_int(operand, check, depth - 1) ?? return None
            Val(-number)
        }
        .Binary(op, left, right, _, _) -> {
            lhs: sema_expr_swizzle_const_int(left, check, depth - 1) ?? return None
            rhs: sema_expr_swizzle_const_int(right, check, depth - 1) ?? return None
            if op == {
                .Add -> Val(lhs + rhs)
                .Sub -> Val(lhs - rhs)
                .Mul -> Val(lhs * rhs)
                .Div | .FloorDiv | .Mod | .Rem | .Pow | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Gt | .Le | .Ge | .Compare | .And | .Or -> None
            }
        }
        .ComptimeName(_, _, value, _) -> if value == .Val(inner) && inner == .Int(number) -> Val(number) else -> None
        .Ident(name, _, _) -> {
            index: sema_scope_resolve_index(check.scopes, name) ?? return None
            symbol: check.scopes.bindings[index].symbol
            if symbol.kind != SymbolKind.Constant -> return None
            if sema_scope_resolve_declaration(check.environment.*, check.program.*, symbol.id) == .Val(declaration) {
                if declaration == .Const(definition) {
                    if definition.mutable -> return None
                    if definition.ct == .Val(inner) && inner == .Int(number) -> return Val(number)
                    return sema_expr_swizzle_const_int(definition.value, check, depth - 1)
                }
            }
            graph: check.program.registration_graph
            module_index: sema_registration_module_index(graph, symbol.module_identity) ?? return None
            loop row in graph.modules[module_index].constants {
                if row.symbol.id != symbol.id -> next
                if row.declaration.mutable -> return None
                if row.declaration.ct == .Val(inner) && inner == .Int(number) -> return Val(number)
                return sema_expr_swizzle_const_int(row.declaration.value, check, depth - 1)
            }
            None
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// Numeric swizzle `a.swizzle(i0, i1, ...)` on fixed arrays and exact lanes.
sema_expr_try_numeric_swizzle: fn(receiver: Expr, receiver_value: TExpr, method: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    if method != "swizzle" -> return SemaMethodSpecialCheck{handled: false, value: None}
    slots: sema_expr_numeric_swizzle_slots(receiver_value.ty, check) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if type_args.len() != 0 {
        check.diagnostics.push(sema_error("E3110", span, "`{slots.shown}.swizzle` takes no type arguments", "numeric swizzle keeps the receiver's element type and takes only constant slot indexes", "remove the type arguments from `.swizzle(...)`"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if args.len() == 0 {
        check.diagnostics.push(sema_error("E3110", span, "`{slots.shown}.swizzle` needs at least one constant slot index", "numeric swizzle selects one or more fixed slots from `{slots.shown}` at compile time", "pass constant slot indexes in `0..<{slots.length}`, such as `.swizzle(0)`"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    ^indices: [Int]{}
    ^valid: true
    loop arg in args {
        if arg.label != None || arg.spread {
            check.diagnostics.push(sema_error("E3110", arg.span, "swizzle slot indexes must be positional constant integers", "numeric swizzle takes plain constant `Int` slot numbers without labels or spreads", "write constant slot numbers such as `.swizzle(2, 1, 0)`"))
            valid = false
            next
        }
        checked_arg: sema_check_expression(arg.expr, Val(Type.Int), check) ?? {
            valid = false
            next
        }
        if checked_arg.ty != Type.Int {
            check.diagnostics.push(sema_error("E3110", arg.span, "swizzle slot index must be a constant `Int`, got `{type_name(checked_arg.ty)}`", "numeric swizzle indexes slots with compile-time `Int` constants", "pass a constant integer between `0` and `{slots.length - 1}`"))
            valid = false
            next
        }
        ^folded: sema_expr_swizzle_const_int(arg.expr, check, 16)
        if folded == None -> folded = sema_call_memory_compiletime_int(arg.expr, checked_arg, check)
        if folded == None -> folded = tree_expr_fold_int(checked_arg)
        idx: folded ?? {
            check.diagnostics.push(sema_error("E3110", arg.span, "swizzle slot index must be a compile-time constant integer", "numeric swizzle selects fixed slots while compiling, so every index must be known at compile time", "pass a constant integer between `0` and `{slots.length - 1}`"))
            valid = false
            next
        }
        if idx < 0 || idx >= slots.length {
            check.diagnostics.push(sema_error("E3110", arg.span, "swizzle index `{idx}` is out of range for `{slots.shown}`", "`{slots.shown}` has {slots.length} slots (`0` through `{slots.length - 1}`)", "use slot indexes between `0` and `{slots.length - 1}`"))
            valid = false
            next
        }
        indices.push(idx)
    }
    if !valid -> return SemaMethodSpecialCheck{handled: true, value: None}
    if !slots.lanes {
        graph: check.program.registration_graph
        caller: sema_type_module_row(graph, check.environment.module_identity)
        ^walk: sema_copy_walk()
        copy_facts: sema_copy_type_facts(slots.element, check.program.registration_graph, check.program.copy_facts, caller, check.context.generic_params, walk)
        if !copy_facts.copyable {
            check.diagnostics.push(sema_error("E3110", span, "can't swizzle `{slots.shown}` because `{type_name(slots.element)}` is not copyable", "numeric swizzle reads slots by value and may repeat them, so the element type must be copyable", "swizzle a fixed array of a copyable type, or move elements explicitly"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    ^target_lane: String?{None}
    if slots.lanes {
        lane_name: sema_expr_numeric_swizzle_lane_target(slots.shown, slots.element, indices.len()) ?? {
            check.diagnostics.push(sema_error("E3110", span, "`{slots.shown}.swizzle` has no {indices.len()}-lane result type for `{type_name(slots.element)}`", "exact lane swizzles return a legal lane type with the same element type", "pass a supported lane count for `{type_name(slots.element)}`"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        target_lane = Val(lane_name)
    }
    at: "{span.start}_{span.end}"
    src_name: "__jet_swizzle_src_{at}"
    mark: sema_scope_mark(check.scopes)
    sema_scope_enter(check.scopes, check.state, "swizzle@{at}")
    ^body: [TStmt]{sema_expr_fixed_bind_read(src_name, receiver_value, span, check)}
    picked: loop idx in indices -> {
        slot_expr: sema_expr_fixed_slot(src_name, Val(idx), slots.lanes, span)
        checked_slot: sema_check_expression(slot_expr, None, check) ?? {
            sema_scope_leave(check.scopes, check.state)
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        checked_slot
    }
    result_measure: Measure.Literal{kind: "length", value: indices.len()}
    ^result_expr: sema_tree_node(Type.FixedList{elem: slots.element, len: result_measure}, TExprKind.List{values: picked, trait_coercion: None}, span)
    if target_lane == .Val(lane_name) {
        lanes_name: "__jet_swizzle_lanes_{at}"
        body.push(sema_expr_fixed_bind(lanes_name, result_expr, span, check))
        argument: CallArg{convention: AccessConvention.Read, expr: Expr.Ident{name: lanes_name, span: span, id: AST_NODE_GENERATED}, span: span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
        construct: Expr.MethodCall{receiver: Expr.Ident{name: lane_name, span: span, id: AST_NODE_GENERATED}, method: "from_array", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{argument}, id: AST_NODE_GENERATED}
        result_expr = sema_check_expression(construct, None, check) ?? {
            sema_scope_leave(check.scopes, check.state)
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    sema_single_use_leave_scope(check)
    sema_scope_rollback(check.scopes, mark)
    result_ty: result_expr.ty
    body.push(TStmt.ExprStmt{value: result_expr, span: span})
    built: sema_expr_expected_owned(sema_tree_node(result_ty, TExprKind.InlineBlock{body: body}, span), expected, check.environment.*, check.program.*, check.diagnostics)
    SemaMethodSpecialCheck{handled: true, value: built}
}
