// Checked lambda expressions and capture analysis.
use jet_foundation.[
    AccessConvention,
    Binding,
    CallContractRow,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionCallMetadata,
    LValue,
    Lambda,
    NamedSpan,
    Pattern,
    PlaceAccess,
    Span,
    Stmt,
    SwitchArm,
    Symbol,
    SymbolID,
    SymbolKind,
    TCapture,
    TCaptureFacts,
    TCoreClosureKind,
    TEffectFacts,
    TEffectSpan,
    TExpr,
    TExprKind,
    TFailureCarrier,
    TFnValueKind,
    TIfCond,
    TLambda,
    TLambdaBody,
    TLocal,
    TOrFallback,
    TPlace,
    TStmt,
    Type,
    ViewProvenanceMap,
    expr_span,
    symbol_id,
    tir_symbol_local,
    type_identity_equal,
]

fn sema_expression_lambda_binding_frame(name: String, use_span: Span, scopes: &SemaScopeTable) -> Int Never! {
    selected_frame := -1
    selected_start := -1
    // Only bindings named `name` can match; visit them in table order.
    slot :: scopes.name_slots.get(name) ?? return selected_frame
    loop position in 0..<scopes.name_positions[slot].len() {
        binding :: scopes.bindings[scopes.name_positions[slot][position]]
        if (binding.symbol.kind == SymbolKind.Local || binding.symbol.kind == SymbolKind.Parameter) && binding.symbol.span.start <= use_span.start && binding.symbol.span.start >= selected_start {
            selected_frame = binding.frame
            selected_start = binding.symbol.span.start
        }
    }
    selected_frame
}

fn sema_expression_lambda_lvalue_use_outer(target: LValue, frame: Int, params: [String], scopes: &SemaScopeTable) -> Bool {
    return if target == {
        .Local(name, name_span) -> sema_expression_lambda_uses_outer(Expr.Ident{name: name, span: name_span}, frame, params, &scopes)
        .Index(base, index, _, _) -> sema_expression_lambda_uses_outer(base, frame, params, &scopes) || sema_expression_lambda_uses_outer(index, frame, params, &scopes)
        .Field(base, _, _) -> sema_expression_lambda_uses_outer(base, frame, params, &scopes)
    }
}

fn sema_expression_lambda_pattern_use_outer(pattern: Pattern, frame: Int, params: [String], scopes: &SemaScopeTable) -> Bool {
    return if pattern == {
        .Or(alternatives, _) -> {
            index := 0
            loop index < alternatives.len() {
                if sema_expression_lambda_pattern_use_outer(alternatives[index], frame, params, &scopes) -> return true
                index += 1
            }
            false
        }
        .Struct(fields, _, _) -> {
            index := 0
            loop index < fields.len() {
                if fields[index] == .Value(_, _, value) {
                    if sema_expression_lambda_uses_outer(value, frame, params, &scopes) {
                        return true
                    }
                }
                index += 1
            }
            false
        }
        else -> false
    }
}

fn sema_expression_lambda_uses_outer(expr: Expr, frame: Int, params: [String], scopes: &SemaScopeTable) -> Bool {
    return if expr == {
        .Str(parts, _) -> {
            index := 0
            loop index < parts.len() {
                if parts[index] == .Interp(value, _) {
                    if sema_expression_lambda_uses_outer(value, frame, params, &scopes) {
                        return true
                    }
                }
                index += 1
            }
            false
        }
        .MemberSpread(base, _, _) -> sema_expression_lambda_uses_outer(base, frame, params, &scopes)
        .Spread(value, _) -> sema_expression_lambda_uses_outer(value, frame, params, &scopes)
        .TypedLit(_, body, _) -> {
            if body == {
                .Fields(fields) -> loop field in fields {
                    if sema_expression_lambda_uses_outer(field.value, frame, params, &scopes) -> return true
                }
                .Elements(elements) -> loop element in elements {
                    if sema_expression_lambda_uses_outer(element, frame, params, &scopes) -> return true
                }
                .Entries(entries) -> loop entry in entries {
                    if sema_expression_lambda_uses_outer(entry.key, frame, params, &scopes) || sema_expression_lambda_uses_outer(entry.value, frame, params, &scopes) -> return true
                }
                .Value(value) -> return sema_expression_lambda_uses_outer(value, frame, params, &scopes)
                else -> {}
            }
            false
        }
        .Ident(name, span) -> {
            binding_frame := sema_expression_lambda_binding_frame(name, span, &scopes)
            if binding_frame >= frame -> return false
            if binding_frame >= 0 -> return true
            index :: sema_scope_resolve_index(scopes, name)
            if index == None -> return false
            binding :: scopes.bindings[index]
            if binding.symbol.span.start > span.start -> return false
            if binding.frame < frame && (binding.symbol.kind == SymbolKind.Local || binding.symbol.kind == SymbolKind.Parameter) -> return true
            false
        }
        .Paren(value, _) -> sema_expression_lambda_uses_outer(value, frame, params, &scopes)
        .Unary(_, value, _) -> sema_expression_lambda_uses_outer(value, frame, params, &scopes)
        .Binary(_, left, right, _) -> sema_expression_lambda_uses_outer(left, frame, params, &scopes) || sema_expression_lambda_uses_outer(right, frame, params, &scopes)
        .CompareChain(values, _, _, _) -> {
            index := 0
            loop index < values.len() {
                if sema_expression_lambda_uses_outer(values[index], frame, params, &scopes) -> return true
                index += 1
            }
            false
        }
        .ListLit(values, _) -> {
            index := 0
            loop index < values.len() {
                if sema_expression_lambda_uses_outer(values[index], frame, params, &scopes) -> return true
                index += 1
            }
            false
        }
        .MapLit(entries, _) -> {
            index := 0
            loop index < entries.len() {
                if sema_expression_lambda_uses_outer(entries[index].key, frame, params, &scopes) || sema_expression_lambda_uses_outer(entries[index].value, frame, params, &scopes) -> return true
                index += 1
            }
            false
        }
        .TupleLit(fields, _, _) -> {
            index := 0
            loop index < fields.len() {
                if sema_expression_lambda_uses_outer(fields[index].value, frame, params, &scopes) -> return true
                index += 1
            }
            false
        }
        .Index(base, index, _, _) -> sema_expression_lambda_uses_outer(base, frame, params, &scopes) || sema_expression_lambda_uses_outer(index, frame, params, &scopes)
        .Slice(base, start, end, range, _) -> {
            if sema_expression_lambda_uses_outer(base, frame, params, &scopes) || sema_expression_lambda_uses_outer(start, frame, params, &scopes) || sema_expression_lambda_uses_outer(end, frame, params, &scopes) -> return true
            if range != None -> return sema_expression_lambda_uses_outer(range, frame, params, &scopes)
            false
        }
        .Range(start, end, _, _) -> sema_expression_lambda_uses_outer(start, frame, params, &scopes) || sema_expression_lambda_uses_outer(end, frame, params, &scopes)
        .Field(base, _, _) -> sema_expression_lambda_uses_outer(base, frame, params, &scopes)
        .OptField(base, _, _, _, _) -> sema_expression_lambda_uses_outer(base, frame, params, &scopes)
        .Present(value, _) -> sema_expression_lambda_uses_outer(value, frame, params, &scopes)
        .Ok(value, _) -> sema_expression_lambda_uses_outer(value, frame, params, &scopes)
        .Err(value, _) -> sema_expression_lambda_uses_outer(value, frame, params, &scopes)
        .Try(value, _, _, note) -> {
            if sema_expression_lambda_uses_outer(value, frame, params, &scopes) -> return true
            if note != None -> return sema_expression_lambda_uses_outer(note, frame, params, &scopes)
            false
        }
        .Tainted(value, _, _) -> sema_expression_lambda_uses_outer(value, frame, params, &scopes)
        .Deref(value, _) -> sema_expression_lambda_uses_outer(value, frame, params, &scopes)
        .RawOf(value, _) -> sema_expression_lambda_uses_outer(value, frame, params, &scopes)
        .Copy(value, _) -> sema_expression_lambda_uses_outer(value, frame, params, &scopes)
        .Place(value, _, _) -> sema_expression_lambda_uses_outer(value, frame, params, &scopes)
        .CallValue(callee, args, _) -> {
            if sema_expression_lambda_uses_outer(callee, frame, params, &scopes) -> return true
            index := 0
            loop index < args.len() {
                if sema_expression_lambda_uses_outer(args[index].expr, frame, params, &scopes) -> return true
                index += 1
            }
            false
        }
        .Call(call) -> {
            index := 0
            loop index < call.args.len() {
                if sema_expression_lambda_uses_outer(call.args[index].expr, frame, params, &scopes) -> return true
                index += 1
            }
            false
        }
        .MethodCall(receiver, _, _, _, _, args, _, _, _, _) | .OptMethodCall(receiver, _, _, _, args, _) -> {
            if sema_expression_lambda_uses_outer(receiver, frame, params, &scopes) -> return true
            index := 0
            loop index < args.len() {
                if sema_expression_lambda_uses_outer(args[index].expr, frame, params, &scopes) -> return true
                index += 1
            }
            false
        }
        .StructLit(_, _, _, _, fields, _, _) -> {
            index := 0
            loop index < fields.len() {
                if sema_expression_lambda_uses_outer(fields[index].value, frame, params, &scopes) -> return true
                index += 1
            }
            false
        }
        .EnumLit(_, _, _, args, _, _) -> {
            index := 0
            loop index < args.len() {
                if args[index] == {
                    .Positional(value) -> {
                        if sema_expression_lambda_uses_outer(value, frame, params, &scopes) {
                            return true
                        }
                    }
                    .Named(_, value) -> {
                        if sema_expression_lambda_uses_outer(value, frame, params, &scopes) {
                            return true
                        }
                    }
                    else -> {}
                }
                index += 1
            }
            false
        }
        .If(condition, then_body, then_value, else_body, else_value, _) -> {
            if sema_expression_lambda_uses_outer(condition, frame, params, &scopes) || sema_expression_lambda_statements_use_outer(then_body, frame, params, &scopes) -> return true
            if sema_expression_lambda_uses_outer(then_value, frame, params, &scopes) -> return true
            if sema_expression_lambda_statements_use_outer(else_body, frame, params, &scopes) -> return true
            sema_expression_lambda_uses_outer(else_value, frame, params, &scopes)
        }
        .OrFallback(value, fallback, _, _) -> {
            if sema_expression_lambda_uses_outer(value, frame, params, &scopes) -> return true
            if fallback == {
                .Value(other) -> {
                    return sema_expression_lambda_uses_outer(other, frame, params, &scopes)
                }
                .Block(body, tail, _) -> {
                    if sema_expression_lambda_statements_use_outer(body, frame, params, &scopes) {
                        return true
                    }
                    if tail != None {
                        return sema_expression_lambda_uses_outer(tail, frame, params, &scopes)
                    }
                    return false
                }
                .Return(other, _) -> {
                    if other != None {
                        return sema_expression_lambda_uses_outer(other, frame, params, &scopes)
                    }
                    return false
                }
                .Panic(_, args) -> {
                    index := 0
                    loop index < args.len() {
                        if sema_expression_lambda_uses_outer(args[index].expr, frame, params, &scopes) {
                            return true
                        }
                        index += 1
                    }
                    return false
                }
                else -> false
            }
        }
        .Lambda(nested) -> {
            return if nested.body == {
                .Expr(value) -> sema_expression_lambda_uses_outer(value, frame, params, &scopes)
                .Block(body) -> sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
                else -> false
            }
        }
        .PatternTest(subject, pattern, _) -> sema_expression_lambda_uses_outer(subject, frame, params, &scopes) || sema_expression_lambda_pattern_use_outer(pattern, frame, params, &scopes)
        .PtrFromAddr(_, _, _, addr, _) -> sema_expression_lambda_uses_outer(addr, frame, params, &scopes)
        else -> false
    }
}

fn sema_expression_lambda_statements_use_outer(statements: [Stmt], frame: Int, params: [String], scopes: &SemaScopeTable) -> Bool {
    index := 0
    loop index < statements.len() {
        if sema_expression_lambda_statement_use_outer(statements[index], frame, params, &scopes) -> return true
        index += 1
    }
    false
}

fn sema_expression_lambda_statement_use_outer(statement: Stmt, frame: Int, params: [String], scopes: &SemaScopeTable) -> Bool {
    return if statement == {
        .Expr(value) -> sema_expression_lambda_uses_outer(value, frame, params, &scopes)
        .Val(binding) -> sema_expression_lambda_uses_outer(binding.init, frame, params, &scopes)
        .Assign(target, _, _, value) -> sema_expression_lambda_lvalue_use_outer(target, frame, params, &scopes) || sema_expression_lambda_uses_outer(value, frame, params, &scopes)
        .Return(value, _) -> if value != None -> sema_expression_lambda_uses_outer(value, frame, params, &scopes) else -> false
        .BreakValue(value, _) -> sema_expression_lambda_uses_outer(value, frame, params, &scopes)
        .BreakLabelValue(_, _, value, _) -> sema_expression_lambda_uses_outer(value, frame, params, &scopes)
        .While(condition, body, _, _, _) -> sema_expression_lambda_uses_outer(condition, frame, params, &scopes) || sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        .For(_, _, _, kind, body, _, _, _, _) -> {
            if kind == {
                .Range(start, end, step, _) -> {
                    if sema_expression_lambda_uses_outer(start, frame, params, &scopes) || sema_expression_lambda_uses_outer(end, frame, params, &scopes) {
                        return true
                    }
                    if step != None {
                        if sema_expression_lambda_uses_outer(step, frame, params, &scopes) {
                            return true
                        }
                    }
                }
                .In(collection, step) -> {
                    if sema_expression_lambda_uses_outer(collection, frame, params, &scopes) {
                        return true
                    }
                    if step != None {
                        if sema_expression_lambda_uses_outer(step, frame, params, &scopes) {
                            return true
                        }
                    }
                }
                else -> {}
            }
            sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        }
        .Switch(subject, arms, else_body, _) -> {
            if sema_expression_lambda_uses_outer(subject, frame, params, &scopes) -> return true
            index := 0
            loop index < arms.len() {
                if sema_expression_lambda_uses_outer(arms[index].cond, frame, params, &scopes) || sema_expression_lambda_statements_use_outer(arms[index].body, frame, params, &scopes) -> return true
                index += 1
            }
            if else_body != None -> return sema_expression_lambda_statements_use_outer(else_body, frame, params, &scopes)
            false
        }
        .Loop(body, _, _, _) -> sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        .CountedLoop(init, condition, step, body, _, _, _) -> {
            if sema_expression_lambda_uses_outer(init.init, frame, params, &scopes) || sema_expression_lambda_uses_outer(condition, frame, params, &scopes) -> return true
            if step != None && sema_expression_lambda_statement_use_outer(step, frame, params, &scopes) -> return true
            sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        }
        .Unsafe(_, audit_expr, body, _) -> {
            if audit_expr != None && sema_expression_lambda_uses_outer(audit_expr, frame, params, &scopes) -> return true
            sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        }
        .Impure(_, reason_expr, body, _) -> {
            if reason_expr != None && sema_expression_lambda_uses_outer(reason_expr, frame, params, &scopes) -> return true
            sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        }
        .Reactive(body, _) -> sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        .Shield(body, _) -> sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        .Switched(_, body, _) -> sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        .Region(_, _, body, _) -> sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        .Policy(_, body, _) -> sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        .TaskGroup(_, _, limit, body, _) -> {
            if limit != None && sema_expression_lambda_uses_outer(limit, frame, params, &scopes) -> return true
            sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        }
        .Layout(_, _, body, _) -> sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        .AuthorityScope(_, _, _, body, _) -> sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        .ComptimeIf(condition, _, then_body, else_body, _, _) -> {
            if sema_expression_lambda_uses_outer(condition, frame, params, &scopes) -> return true
            if sema_expression_lambda_statements_use_outer(then_body, frame, params, &scopes) -> return true
            if else_body != None -> return sema_expression_lambda_statements_use_outer(else_body, frame, params, &scopes)
            false
        }
        .ComptimeSwitch(subject, arms, else_body, _) -> {
            if sema_expression_lambda_uses_outer(subject, frame, params, &scopes) -> return true
            index := 0
            loop index < arms.len() {
                if sema_expression_lambda_uses_outer(arms[index].cond, frame, params, &scopes) || sema_expression_lambda_statements_use_outer(arms[index].body, frame, params, &scopes) -> return true
                index += 1
            }
            if else_body != None -> return sema_expression_lambda_statements_use_outer(else_body, frame, params, &scopes)
            false
        }
        .ComptimeBlock(body, _, _) -> sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        .ContextBlock(fields, body, _) -> {
            index := 0
            loop index < fields.len() {
                if sema_expression_lambda_uses_outer(fields[index].value, frame, params, &scopes) -> return true
                index += 1
            }
            sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        }
        .Live(body, _) -> sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        .AssumeDet(_, reason_expr, body, _) -> sema_expression_lambda_uses_outer(reason_expr, frame, params, &scopes) || sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        .Transact(_, _, body, _, _) -> sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        .Yield(value, _) -> sema_expression_lambda_uses_outer(value, frame, params, &scopes)
        .ScopeMember(_, _, args, _, body, _, _, _) -> {
            index := 0
            loop index < args.len() {
                if sema_expression_lambda_uses_outer(args[index], frame, params, &scopes) -> return true
                index += 1
            }
            sema_expression_lambda_statements_use_outer(body, frame, params, &scopes)
        }
        .DeferClose(close, _) -> sema_expression_lambda_uses_outer(close, frame, params, &scopes)
        else -> false
    }
}

fn sema_expression_lambda_effects(lambda: &Lambda) -> TEffectFacts Never! {
    direct := [String]{}
    loop name in lambda.meta.effect_direct {
        sema_expression_lambda_append_name(&direct, name)
    }
    spans := [TEffectSpan]{}
    loop row in lambda.meta.effect_direct_spans {
        &spans.push(TEffectSpan{name: row.name, span: row.span})
    }
    TEffectFacts{direct: direct, solved: lambda.meta.effect_solved, call_edges: lambda.meta.effect_call_edges, maximal: lambda.meta.effect_maximal, direct_spans: spans}
}

fn sema_expression_lambda_add_effect_facts(source: &SemaCheckContext, first_call: Int, direct: &[String], edges: &[String], spans: &[TEffectSpan], maximal: &Bool) Never! {
    index := first_call
    loop index < source.call_facts.len() {
        fact := source.call_facts[index]
        if {
            fact.callee != None -> {
                callee :: fact.callee ?? SymbolID{key: ""}
                sema_expression_lambda_append_name(&edges, callee.key)
            }
            fact.facts.effect_bound != None -> {
                row :: fact.facts.effect_bound ?? [EffectRowEntry]{}
                loop entry in row {
                    if entry.name.starts_with("!") || entry.name.starts_with("..") -> next
                    sema_expression_lambda_append_name(&direct, entry.name)
                    &spans.push(TEffectSpan{name: entry.name, span: fact.span})
                }
            }
            else -> {
                maximal = true
            }
        }
        index += 1
    }
}

fn sema_expression_lambda_bound_optional_expr(value: Expr?, name: String) -> Bool {
    if value != None {
        actual :: value
        return sema_expression_lambda_bound_expr_use(actual, name)
    }
    false
}

fn sema_expression_lambda_bound_expr_use(expr: Expr, name: String) -> Bool {
    if expr == {
        .Ident(value, _) -> return value == name
        .Call(call) -> {
            loop argument in call.args {
                if sema_expression_lambda_bound_expr_use(argument.expr, name) -> return true
            }
        }
        .CallValue(callee, args, _) -> {
            if sema_expression_lambda_bound_expr_use(callee, name) -> return true
            loop argument in args {
                if sema_expression_lambda_bound_expr_use(argument.expr, name) -> return true
            }
        }
        .MethodCall(receiver, _, _, _, _, args, _, _, _, _) | .OptMethodCall(receiver, _, _, _, args, _) -> {
            if sema_expression_lambda_bound_expr_use(receiver, name) -> return true
            loop argument in args {
                if sema_expression_lambda_bound_expr_use(argument.expr, name) -> return true
            }
        }
        .Binary(_, left, right, _) -> return sema_expression_lambda_bound_expr_use(left, name) || sema_expression_lambda_bound_expr_use(right, name)
        .Unary(_, operand, _) | .Deref(operand, _) | .RawOf(operand, _) | .Copy(operand, _) | .Place(operand, _, _) | .Tainted(operand, _, _) | .Present(operand, _) | .Ok(operand, _) | .Err(operand, _) | .Paren(operand, _) -> return sema_expression_lambda_bound_expr_use(operand, name)
        .Index(base, index, _, _) -> return sema_expression_lambda_bound_expr_use(base, name) || sema_expression_lambda_bound_expr_use(index, name)
        .Slice(base, start, end, range, _) -> {
            if sema_expression_lambda_bound_expr_use(base, name) || sema_expression_lambda_bound_expr_use(start, name) || sema_expression_lambda_bound_expr_use(end, name) -> return true
            return sema_expression_lambda_bound_optional_expr(range, name)
        }
        .Range(start, end, _, _) -> return sema_expression_lambda_bound_expr_use(start, name) || sema_expression_lambda_bound_expr_use(end, name)
        .Field(base, _, _) | .OptField(base, _, _, _, _) -> return sema_expression_lambda_bound_expr_use(base, name)
        .ListLit(elements, _) -> loop item in elements { if sema_expression_lambda_bound_expr_use(item, name) -> return true }
        .Spread(value, _) -> return sema_expression_lambda_bound_expr_use(value, name)
        .MemberSpread(base, _, _) -> return sema_expression_lambda_bound_expr_use(base, name)
        .MapLit(entries, _) -> loop entry in entries { if sema_expression_lambda_bound_expr_use(entry.key, name) || sema_expression_lambda_bound_expr_use(entry.value, name) -> return true }
        .If(condition, then_body, then_value, else_body, else_value, _) -> {
            if sema_expression_lambda_bound_expr_use(condition, name) || sema_expression_lambda_bound_statements_use(then_body, name) || sema_expression_lambda_bound_expr_use(then_value, name) -> return true
            if sema_expression_lambda_bound_statements_use(else_body, name) || sema_expression_lambda_bound_expr_use(else_value, name) -> return true
        }
        .Lambda(inner) -> {
            shadowed := false
            loop parameter in inner.params {
                if parameter.name == name -> shadowed = true
            }
            if !shadowed {
                loop capture in inner.take_names {
                    if capture.name == name -> return true
                }
                if inner.body == .Expr(value) {
                    if sema_expression_lambda_bound_expr_use(value, name) -> return true
                }
                if inner.body == .Block(body) {
                    if sema_expression_lambda_bound_statements_use(body, name) -> return true
                }
            }
        }
        else -> {}
    }
    false
}

fn sema_expression_lambda_bound_statement_use(statement: Stmt, name: String) -> Bool {
    if statement == {
        .Expr(value) -> {
            if value == .Call(call) && call.name == name -> return true
            return sema_expression_lambda_bound_expr_use(value, name)
        }
        .Val(binding) -> return sema_expression_lambda_bound_expr_use(binding.init, name)
        .Assign(target, _, _, value) -> {
            if target == .Local(target_name, _) && target_name == name -> return true
            return sema_expression_lambda_bound_expr_use(value, name)
        }
        .Return(value, _) -> return sema_expression_lambda_bound_optional_expr(value, name)
        .BreakValue(value, _) | .BreakLabelValue(_, _, value, _) -> return sema_expression_lambda_bound_expr_use(value, name)
        .While(condition, body, _, _, _) -> return sema_expression_lambda_bound_expr_use(condition, name) || sema_expression_lambda_bound_statements_use(body, name)
        .For(_, _, _, kind, body, _, _, _, _) -> {
            if kind == {
                .Range(start, end, step, _) -> {
                    if sema_expression_lambda_bound_expr_use(start, name) || sema_expression_lambda_bound_expr_use(end, name) -> return true
                    if sema_expression_lambda_bound_optional_expr(step, name) -> return true
                }
                .In(collection, step) -> {
                    if sema_expression_lambda_bound_expr_use(collection, name) || sema_expression_lambda_bound_optional_expr(step, name) -> return true
                }
            }
            return sema_expression_lambda_bound_statements_use(body, name)
        }
        .CountedLoop(init, condition, step, body, _, _, _) -> {
            if sema_expression_lambda_bound_expr_use(init.init, name) || sema_expression_lambda_bound_expr_use(condition, name) -> return true
            if step != None && sema_expression_lambda_bound_statement_use(step, name) -> return true
            return sema_expression_lambda_bound_statements_use(body, name)
        }
        .Loop(body, _, _, _) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .Live(body, _) | .ComptimeBlock(body, _, _) -> return sema_expression_lambda_bound_statements_use(body, name)
        .Switch(subject, arms, else_body, _) -> {
            if sema_expression_lambda_bound_expr_use(subject, name) -> return true
            loop arm in arms { if sema_expression_lambda_bound_statements_use(arm.body, name) -> return true }
            if else_body != None -> return sema_expression_lambda_bound_statements_use(else_body, name)
        }
        .ContextBlock(fields, body, _) -> {
            loop field in fields { if sema_expression_lambda_bound_expr_use(field.value, name) -> return true }
            return sema_expression_lambda_bound_statements_use(body, name)
        }
        .ComptimeIf(condition, _, then_body, else_body, _, _) -> {
            if sema_expression_lambda_bound_expr_use(condition, name) || sema_expression_lambda_bound_statements_use(then_body, name) -> return true
            if else_body != None -> return sema_expression_lambda_bound_statements_use(else_body, name)
        }
        .ComptimeSwitch(subject, arms, else_body, _) -> {
            if sema_expression_lambda_bound_expr_use(subject, name) -> return true
            loop arm in arms { if sema_expression_lambda_bound_statements_use(arm.body, name) -> return true }
            if else_body != None -> return sema_expression_lambda_bound_statements_use(else_body, name)
        }
        .AssumeDet(_, reason, body, _) -> return sema_expression_lambda_bound_expr_use(reason, name) || sema_expression_lambda_bound_statements_use(body, name)
        .Transact(_, _, body, _, _) -> return sema_expression_lambda_bound_statements_use(body, name)
        .ScopeMember(_, _, args, _, body, _, _, _) -> {
            loop argument in args { if sema_expression_lambda_bound_expr_use(argument, name) -> return true }
            return sema_expression_lambda_bound_statements_use(body, name)
        }
        .Yield(value, _) | .DeferClose(value, _) -> return sema_expression_lambda_bound_expr_use(value, name)
        else -> {}
    }
    false
}

fn sema_expression_lambda_bound_statements_use(statements: [Stmt], name: String) -> Bool {
    loop statement in statements {
        if sema_expression_lambda_bound_statement_use(statement, name) -> return true
    }
    false
}

fn sema_expression_lambda_bound_direct_callee(expr: Expr, name: String) -> Bool Never! {
    if expr == {
        .Ident(value, _) -> return value == name
        .Paren(inner, _) -> return sema_expression_lambda_bound_direct_callee(inner, name)
        else -> return false
    }
}

fn sema_expression_lambda_bound_expr_non_direct_use(expr: Expr, name: String) -> Bool {
    if expr == {
        .Call(call) -> {
            loop argument in call.args {
                if sema_expression_lambda_bound_expr_non_direct_use(argument.expr, name) -> return true
            }
            return false
        }
        .CallValue(callee, args, _) -> {
            if !sema_expression_lambda_bound_direct_callee(callee, name) && sema_expression_lambda_bound_expr_use(callee, name) -> return true
            loop argument in args {
                if sema_expression_lambda_bound_expr_non_direct_use(argument.expr, name) -> return true
            }
            return false
        }
        .MethodCall(receiver, method, _, _, _, args, _, _, _, _) | .OptMethodCall(receiver, method, _, _, args, _) -> {
            if !(method == "call" && sema_expression_lambda_bound_direct_callee(receiver, name)) && sema_expression_lambda_bound_expr_use(receiver, name) -> return true
            loop argument in args {
                if sema_expression_lambda_bound_expr_non_direct_use(argument.expr, name) -> return true
            }
            return false
        }
        .Lambda(_) -> return sema_expression_lambda_bound_expr_use(expr, name)
        else -> return sema_expression_lambda_bound_expr_use(expr, name)
    }
}

fn sema_expression_lambda_bound_statement_non_direct_use(statement: Stmt, name: String) -> Bool {
    if statement == {
        .Expr(value) -> return sema_expression_lambda_bound_expr_non_direct_use(value, name)
        .Val(binding) -> return sema_expression_lambda_bound_expr_non_direct_use(binding.init, name)
        .Assign(target, _, _, value) -> {
            if target == .Local(target_name, _) && target_name == name -> return true
            if target == {
                .Index(base, index, _, _) -> {
                    if sema_expression_lambda_bound_expr_use(base, name) || sema_expression_lambda_bound_expr_use(index, name) -> return true
                }
                .Field(base, _, _) -> {
                    if sema_expression_lambda_bound_expr_use(base, name) -> return true
                }
                else -> {}
            }
            return sema_expression_lambda_bound_expr_non_direct_use(value, name)
        }
        .Return(value, _) -> {
            if value != None -> return sema_expression_lambda_bound_expr_non_direct_use(value, name)
            return false
        }
        .BreakValue(value, _) | .BreakLabelValue(_, _, value, _) -> return sema_expression_lambda_bound_expr_non_direct_use(value, name)
        .While(condition, body, _, _, _) -> return sema_expression_lambda_bound_expr_non_direct_use(condition, name) || sema_expression_lambda_bound_statements_non_direct_use(body, name)
        .For(_, _, _, kind, body, _, _, _, _) -> {
            if kind == {
                .Range(start, end, step, _) -> {
                    if sema_expression_lambda_bound_expr_non_direct_use(start, name) || sema_expression_lambda_bound_expr_non_direct_use(end, name) -> return true
                    if step != None && sema_expression_lambda_bound_expr_non_direct_use(step, name) -> return true
                }
                .In(collection, step) -> {
                    if sema_expression_lambda_bound_expr_non_direct_use(collection, name) -> return true
                    if step != None && sema_expression_lambda_bound_expr_non_direct_use(step, name) -> return true
                }
            }
            return sema_expression_lambda_bound_statements_non_direct_use(body, name)
        }
        .CountedLoop(init, condition, step, body, _, _, _) -> {
            if sema_expression_lambda_bound_expr_non_direct_use(init.init, name) || sema_expression_lambda_bound_expr_non_direct_use(condition, name) -> return true
            if step != None && sema_expression_lambda_bound_statement_non_direct_use(step, name) -> return true
            return sema_expression_lambda_bound_statements_non_direct_use(body, name)
        }
        .Loop(body, _, _, _) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .Live(body, _) | .ComptimeBlock(body, _, _) -> return sema_expression_lambda_bound_statements_non_direct_use(body, name)
        .Switch(subject, arms, else_body, _) -> {
            if sema_expression_lambda_bound_expr_non_direct_use(subject, name) -> return true
            loop arm in arms { if sema_expression_lambda_bound_statements_non_direct_use(arm.body, name) -> return true }
            if else_body != None -> return sema_expression_lambda_bound_statements_non_direct_use(else_body, name)
        }
        .ContextBlock(fields, body, _) -> {
            loop field in fields { if sema_expression_lambda_bound_expr_non_direct_use(field.value, name) -> return true }
            return sema_expression_lambda_bound_statements_non_direct_use(body, name)
        }
        .ComptimeIf(condition, _, then_body, else_body, _, _) -> {
            if sema_expression_lambda_bound_expr_non_direct_use(condition, name) || sema_expression_lambda_bound_statements_non_direct_use(then_body, name) -> return true
            if else_body != None -> return sema_expression_lambda_bound_statements_non_direct_use(else_body, name)
        }
        .ComptimeSwitch(subject, arms, else_body, _) -> {
            if sema_expression_lambda_bound_expr_non_direct_use(subject, name) -> return true
            loop arm in arms { if sema_expression_lambda_bound_statements_non_direct_use(arm.body, name) -> return true }
            if else_body != None -> return sema_expression_lambda_bound_statements_non_direct_use(else_body, name)
        }
        .AssumeDet(_, reason, body, _) -> return sema_expression_lambda_bound_expr_non_direct_use(reason, name) || sema_expression_lambda_bound_statements_non_direct_use(body, name)
        .Transact(_, _, body, _, _) -> return sema_expression_lambda_bound_statements_non_direct_use(body, name)
        .ScopeMember(_, _, args, _, body, _, _, _) -> {
            loop argument in args { if sema_expression_lambda_bound_expr_non_direct_use(argument, name) -> return true }
            return sema_expression_lambda_bound_statements_non_direct_use(body, name)
        }
        .Yield(value, _) | .DeferClose(value, _) -> return sema_expression_lambda_bound_expr_non_direct_use(value, name)
        else -> {}
    }
    false
}

fn sema_expression_lambda_bound_statements_non_direct_use(statements: [Stmt], name: String) -> Bool {
    loop statement in statements {
        if sema_expression_lambda_bound_statement_non_direct_use(statement, name) -> return true
    }
    false
}


fn sema_expression_lambda_bound_tail_use(statements: [Stmt], start_index: Int, name: String, saw_use: &Bool) -> Bool {
    if start_index >= statements.len() -> return false
    index := start_index
    loop index < statements.len() {
        if sema_expression_lambda_bound_statement_use(statements[index], name) {
            saw_use = true
            if sema_expression_lambda_bound_statement_non_direct_use(statements[index], name) -> return true
        }
        index += 1
    }
    false
}

fn sema_expression_lambda_bound_expr_mut_use(expr: Expr, name: String) -> Bool {
    if expr == {
        .Place(value, access, _) -> {
            if access == PlaceAccess.Write -> return sema_expression_lambda_bound_expr_use(value, name)
            return sema_expression_lambda_bound_expr_mut_use(value, name)
        }
        .Call(call) -> {
            loop argument in call.args {
                if argument.convention == AccessConvention.Write && sema_expression_lambda_bound_expr_use(argument.expr, name) -> return true
                if sema_expression_lambda_bound_expr_mut_use(argument.expr, name) -> return true
            }
        }
        .CallValue(callee, args, _) -> {
            if sema_expression_lambda_bound_expr_mut_use(callee, name) -> return true
            loop argument in args {
                if argument.convention == AccessConvention.Write && sema_expression_lambda_bound_expr_use(argument.expr, name) -> return true
                if sema_expression_lambda_bound_expr_mut_use(argument.expr, name) -> return true
            }
        }
        .MethodCall(receiver, _, _, _, _, args, _, _, _, _) | .OptMethodCall(receiver, _, _, _, args, _) -> {
            if sema_expression_lambda_bound_expr_mut_use(receiver, name) -> return true
            loop argument in args {
                if argument.convention == AccessConvention.Write && sema_expression_lambda_bound_expr_use(argument.expr, name) -> return true
                if sema_expression_lambda_bound_expr_mut_use(argument.expr, name) -> return true
            }
        }
        .Binary(_, left, right, _) -> return sema_expression_lambda_bound_expr_mut_use(left, name) || sema_expression_lambda_bound_expr_mut_use(right, name)
        .Unary(_, value, _) | .Deref(value, _) | .RawOf(value, _) | .Copy(value, _) | .Tainted(value, _, _) | .Present(value, _) | .Ok(value, _) | .Err(value, _) | .Paren(value, _) -> return sema_expression_lambda_bound_expr_mut_use(value, name)
        .Field(base, _, _) | .OptField(base, _, _, _, _) | .Index(base, _, _, _) -> return sema_expression_lambda_bound_expr_mut_use(base, name)
        .Lambda(_) -> return false
        else -> {}
    }
    false
}

fn sema_expression_lambda_bound_statement_mut_use(statement: Stmt, name: String) -> Bool {
    if statement == {
        .Assign(target, _, _, value) -> {
            if target == .Local(target_name, _) && target_name == name -> return true
            if target == .Index(base, index, _, _) && (sema_expression_lambda_bound_expr_use(base, name) || sema_expression_lambda_bound_expr_use(index, name)) -> return true
            if target == .Field(base, _, _) && sema_expression_lambda_bound_expr_use(base, name) -> return true
            return sema_expression_lambda_bound_expr_mut_use(value, name)
        }
        .Expr(value) | .Yield(value, _) | .DeferClose(value, _) -> return sema_expression_lambda_bound_expr_mut_use(value, name)
        .Val(binding) -> return sema_expression_lambda_bound_expr_mut_use(binding.init, name)
        .Return(value, _) -> if value != None -> return sema_expression_lambda_bound_expr_mut_use(value, name)
        .BreakValue(value, _) | .BreakLabelValue(_, _, value, _) -> return sema_expression_lambda_bound_expr_mut_use(value, name)
        .While(condition, body, _, _, _) -> return sema_expression_lambda_bound_expr_mut_use(condition, name) || sema_expression_lambda_bound_statements_mut_use(body, name)
        .For(_, _, _, kind, body, _, _, _, _) -> {
            if kind == {
                .Range(start, end, step, _) -> {
                    if sema_expression_lambda_bound_expr_mut_use(start, name) || sema_expression_lambda_bound_expr_mut_use(end, name) -> return true
                    if step != None && sema_expression_lambda_bound_expr_mut_use(step, name) -> return true
                }
                .In(collection, step) -> {
                    if sema_expression_lambda_bound_expr_mut_use(collection, name) -> return true
                    if step != None && sema_expression_lambda_bound_expr_mut_use(step, name) -> return true
                }
            }
            return sema_expression_lambda_bound_statements_mut_use(body, name)
        }
        .CountedLoop(init, condition, step, body, _, _, _) -> {
            if sema_expression_lambda_bound_expr_mut_use(init.init, name) || sema_expression_lambda_bound_expr_mut_use(condition, name) -> return true
            if step != None && sema_expression_lambda_bound_statement_mut_use(step, name) -> return true
            return sema_expression_lambda_bound_statements_mut_use(body, name)
        }
        .Loop(body, _, _, _) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .Live(body, _) | .ComptimeBlock(body, _, _) -> return sema_expression_lambda_bound_statements_mut_use(body, name)
        .Switch(subject, arms, else_body, _) -> {
            if sema_expression_lambda_bound_expr_mut_use(subject, name) -> return true
            loop arm in arms { if sema_expression_lambda_bound_statements_mut_use(arm.body, name) -> return true }
            if else_body != None -> return sema_expression_lambda_bound_statements_mut_use(else_body, name)
        }
        .ContextBlock(fields, body, _) -> {
            loop field in fields { if sema_expression_lambda_bound_expr_mut_use(field.value, name) -> return true }
            return sema_expression_lambda_bound_statements_mut_use(body, name)
        }
        .ComptimeIf(condition, _, then_body, else_body, _, _) -> {
            if sema_expression_lambda_bound_expr_mut_use(condition, name) || sema_expression_lambda_bound_statements_mut_use(then_body, name) -> return true
            if else_body != None -> return sema_expression_lambda_bound_statements_mut_use(else_body, name)
        }
        .ComptimeSwitch(subject, arms, else_body, _) -> {
            if sema_expression_lambda_bound_expr_mut_use(subject, name) -> return true
            loop arm in arms { if sema_expression_lambda_bound_statements_mut_use(arm.body, name) -> return true }
            if else_body != None -> return sema_expression_lambda_bound_statements_mut_use(else_body, name)
        }
        .AssumeDet(_, reason, body, _) -> return sema_expression_lambda_bound_expr_mut_use(reason, name) || sema_expression_lambda_bound_statements_mut_use(body, name)
        .Transact(_, _, body, _, _) -> return sema_expression_lambda_bound_statements_mut_use(body, name)
        .ScopeMember(_, _, args, _, body, _, _, _) -> {
            loop argument in args { if sema_expression_lambda_bound_expr_mut_use(argument, name) -> return true }
            return sema_expression_lambda_bound_statements_mut_use(body, name)
        }
        else -> {}
    }
    false
}

fn sema_expression_lambda_bound_statements_mut_use(statements: [Stmt], name: String) -> Bool {
    loop statement in statements {
        if sema_expression_lambda_bound_statement_mut_use(statement, name) -> return true
    }
    false
}

// S47/M2: a direct-call-only bound lambda borrows the `:=` locals it writes, so
// every write lands on the owner. Without a written local, copyable captures
// are copied at closure creation (the escaping route).
fn sema_expression_lambda_bound_capture_escapes(lambda: Lambda, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool? {
    parameter_names := [String]{}
    loop parameter in lambda.params -> &parameter_names.push(parameter.name)
    used_indexes := [Int]{}
    mutated_flags := [Bool]{}
    writes_local := false
    index := 0
    loop index < scopes.bindings.len() {
        candidate :: scopes.bindings[index]
        index += 1
        active_index :: sema_scope_resolve_index_at(scopes, candidate.symbol.name, lambda.span) ?? next
        if scopes.bindings[active_index].symbol.id.key != candidate.symbol.id.key -> next
        skip_parameter := false
        loop parameter_name in parameter_names {
            if candidate.symbol.name == parameter_name -> skip_parameter = true
        }
        if skip_parameter -> next
        used := false
        mutated := false
        if lambda.body == .Expr(value) {
            used = sema_expression_lambda_bound_expr_use(value, candidate.symbol.name)
            mutated = sema_expression_lambda_bound_expr_mut_use(value, candidate.symbol.name)
        }
        if lambda.body == .Block(body) {
            used = sema_expression_lambda_bound_statements_use(body, candidate.symbol.name)
            mutated = sema_expression_lambda_bound_statements_mut_use(body, candidate.symbol.name)
        }
        if !used -> next
        &used_indexes.push(index - 1)
        &mutated_flags.push(mutated)
        if mutated && candidate.mutable && !candidate.string_view && candidate.symbol.ty != None {
            capture_ty :: candidate.symbol.ty ?? return None
            shared := capture_ty == .Shared(_)
            if !shared && !sema_expression_lambda_is_view_type(capture_ty, candidate.string_view) -> writes_local = true
        }
    }
    position := 0
    loop position < used_indexes.len() {
        candidate :: scopes.bindings[used_indexes[position]]
        mutated :: mutated_flags[position]
        position += 1
        if candidate.string_view -> return Val(false)
        if candidate.symbol.ty == None -> return None
        capture_ty :: candidate.symbol.ty ?? return None
        if sema_expression_lambda_is_view_type(capture_ty, candidate.string_view) -> return Val(false)
        shared_capture :: if capture_ty == .Shared(_) -> true else -> false
        if mutated && candidate.mutable && !shared_capture -> next
        facts := sema_copy_classify(capture_ty, SemaCopyIntent.Clone, environment, context.generic_params, candidate.string_view)
        if !facts.complete -> return None
        if facts.cloneable && !writes_local -> return Val(true)
        if facts.resource && !mutated -> return Val(true)
    }
    Val(false)
}

// Borrowed-tail liveness is decided before the binding enters the scope.
// Non-call uses escape immediately; direct-call-only uses use the native
// capture classification rather than assuming capture-free identity.
fn sema_expression_lambda_bound_escapes(binding: Binding, statements: [Stmt], start_index: Int, tail_store: &SemaStatementTailStore, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool? {
    is_lambda :: if binding.init == .Lambda(_) -> true else -> false
    if !is_lambda -> return None
    saw_use := false
    if sema_expression_lambda_bound_tail_use(statements, start_index, binding.name, &saw_use) -> return Val(true)
    tail_index := 0
    tail_count := context.lambda_statement_tails.len()
    last_tail := tail_count - 1
    loop tail_index < last_tail {
        frame :: context.lambda_statement_tails[tail_index]
        tail :: tail_store.bodies[frame.body_id]
        if sema_expression_lambda_bound_tail_use(tail.statements, frame.start_index, binding.name, &saw_use) -> return Val(true)
        tail_index += 1
    }
    if !saw_use -> return Val(true)
    if binding.init == .Lambda(lambda) {
        return sema_expression_lambda_bound_capture_escapes(lambda, environment, &scopes, &context, &diagnostics)
    }
    None
}


fn sema_expression_lambda_outer_binding(name: String, use_span: Span, frame: Int, scopes: &SemaScopeTable) -> Int? {
    index :: sema_scope_resolve_index_at(scopes, name, use_span) ?? return None
    binding :: scopes.bindings[index]
    if binding.frame < frame && (binding.symbol.kind == SymbolKind.Local || binding.symbol.kind == SymbolKind.Parameter) {
        return Val(index)
    }
    None
}

fn sema_expression_lambda_outer_binding_key(key: String, frame: Int, scopes: &SemaScopeTable) -> Int? {
    index := 0
    loop index < scopes.bindings.len() {
        binding :: scopes.bindings[index]
        if binding.frame < frame && (binding.symbol.kind == SymbolKind.Local || binding.symbol.kind == SymbolKind.Parameter) && binding.symbol.id.key == key {
            return Val(index)
        }
        index += 1
    }
    None
}

fn sema_expression_lambda_add_capture_key(keys: &[String], key: String) Never! {
    loop existing in keys {
        if existing == key -> return
    }
    &keys.push(key)
}

fn sema_expression_lambda_collect_reference_keys(state: &SemaOwnershipState, first_reference: Int, frame: Int, scopes: &SemaScopeTable, keys: &[String], mutable_keys: &[String]) Never! {
    index := first_reference
    loop index < state.references.len() {
        reference :: state.references[index]
        if sema_expression_lambda_outer_binding_key(reference.def_key, frame, &scopes) != None {
            sema_expression_lambda_add_capture_key(&keys, reference.def_key)
            if reference.kind == SemaOwnershipReferenceKind.Write {
                sema_expression_lambda_add_capture_key(&mutable_keys, reference.def_key)
            }
        }
        index += 1
    }
}

fn sema_expression_lambda_collect_tir_capture_local(local: TLocal, frame: Int, scopes: &SemaScopeTable, keys: &[String]) Never! {
    if local.symbol_id == None -> return
    symbol :: local.symbol_id ?? return
    if sema_expression_lambda_outer_binding_key(symbol.key, frame, &scopes) != None {
        sema_expression_lambda_add_capture_key(&keys, symbol.key)
    }
}

fn sema_expression_lambda_collect_tir_place(place: TPlace, frame: Int, scopes: &SemaScopeTable, keys: &[String]) {
    if place == {
        .Local(local) -> sema_expression_lambda_collect_tir_capture_local(local, frame, &scopes, &keys)
        .Expr(value) -> sema_expression_lambda_collect_tir_expr(value, frame, &scopes, &keys)
    }
}

fn sema_expression_lambda_collect_tir_optional_expr(value: TExpr?, frame: Int, scopes: &SemaScopeTable, keys: &[String]) {
    if value != None {
        actual :: value
        sema_expression_lambda_collect_tir_expr(actual, frame, &scopes, &keys)
    }
}

fn sema_expression_lambda_collect_tir_optional_statement(value: TStmt?, frame: Int, scopes: &SemaScopeTable, keys: &[String]) {
    if value != None {
        actual :: value
        sema_expression_lambda_collect_tir_statements([TStmt]{actual}, frame, &scopes, &keys)
    }
}

fn sema_expression_lambda_collect_tir_condition(condition: TIfCond, frame: Int, scopes: &SemaScopeTable, keys: &[String]) {
    if condition == {
        .Plain(value) -> sema_expression_lambda_collect_tir_expr(value, frame, &scopes, &keys)
        .And(left, right) -> {
            sema_expression_lambda_collect_tir_condition(left, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_condition(right, frame, &scopes, &keys)
        }
        .IfLet(_, subject) | .Matches(_, subject) | .IsNone(subject) -> sema_expression_lambda_collect_tir_expr(subject, frame, &scopes, &keys)
        .WithPrelude(prelude, inner) -> {
            sema_expression_lambda_collect_tir_statements(prelude, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_condition(inner, frame, &scopes, &keys)
        }
    }
}

fn sema_expression_lambda_collect_tir_lambda(lambda: TLambda, frame: Int, scopes: &SemaScopeTable, keys: &[String]) {
    loop capture in lambda.captures {
        sema_expression_lambda_collect_tir_capture_local(capture.local, frame, &scopes, &keys)
    }
    if lambda.executable == {
        .Expr(value) -> sema_expression_lambda_collect_tir_expr(value, frame, &scopes, &keys)
        .Block(body) -> sema_expression_lambda_collect_tir_statements(body, frame, &scopes, &keys)
        .SharedBlock(body) -> sema_expression_lambda_collect_tir_statements(body, frame, &scopes, &keys)
    }
}

fn sema_expression_lambda_collect_tir_optional_lambda(lambda: TLambda?, frame: Int, scopes: &SemaScopeTable, keys: &[String]) {
    if lambda != None {
        value :: lambda
        sema_expression_lambda_collect_tir_lambda(value, frame, &scopes, &keys)
    }
}

fn sema_expression_lambda_collect_tir_fn_value(kind: TFnValueKind, frame: Int, scopes: &SemaScopeTable, keys: &[String]) {
    if kind == {
        .NamedFn(_, lambda) -> sema_expression_lambda_collect_tir_optional_lambda(lambda, frame, &scopes, &keys)
        .Call(callee, args) -> {
            sema_expression_lambda_collect_tir_expr(callee, frame, &scopes, &keys)
            loop argument in args -> sema_expression_lambda_collect_tir_expr(argument.value, frame, &scopes, &keys)
        }
        .Policy(_, args, _, _, captures, callee) -> {
            loop argument in args -> sema_expression_lambda_collect_tir_expr(argument.value, frame, &scopes, &keys)
            loop capture in captures -> sema_expression_lambda_collect_tir_capture_local(capture.local, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(callee, frame, &scopes, &keys)
        }
        .Send(value) -> sema_expression_lambda_collect_tir_expr(value, frame, &scopes, &keys)
    }
}

fn sema_expression_lambda_collect_tir_core_closure(kind: TCoreClosureKind, frame: Int, scopes: &SemaScopeTable, keys: &[String]) {
    if kind == {
        .Spawn(group, _, _, executable) -> {
            sema_expression_lambda_collect_tir_optional_expr(group, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_lambda(executable, frame, &scopes, &keys)
        }
        .Realtime(rate, frames, executable) -> {
            sema_expression_lambda_collect_tir_expr(rate, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(frames, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_lambda(executable, frame, &scopes, &keys)
        }
        .Serve(address, executable) -> {
            sema_expression_lambda_collect_tir_expr(address, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_lambda(executable, frame, &scopes, &keys)
        }
        .OnInterrupt(callback) -> sema_expression_lambda_collect_tir_expr(callback, frame, &scopes, &keys)
        .Guard(executable) -> sema_expression_lambda_collect_tir_lambda(executable, frame, &scopes, &keys)
        .OnCommit(_, executable) | .OnRollback(_, executable) -> sema_expression_lambda_collect_tir_lambda(executable, frame, &scopes, &keys)
        .UIButtonOnClick(label, shortcut, accessible, executable, _) -> {
            sema_expression_lambda_collect_tir_expr(label, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(shortcut, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(accessible, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_lambda(executable, frame, &scopes, &keys)
        }
        .UITextInputOnDrop(state, ime, executable, _) -> {
            sema_expression_lambda_collect_tir_expr(state, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(ime, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_lambda(executable, frame, &scopes, &keys)
        }
        .UIPreview(name, viewport, executable, _, _, _, _, _, _, _, _, _, _) -> {
            sema_expression_lambda_collect_tir_expr(name, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_optional_expr(viewport, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_lambda(executable, frame, &scopes, &keys)
        }
        .ReactiveDerived(executable, _) | .ReactiveEffect(executable, _) | .UIReactiveRender(executable, _) -> sema_expression_lambda_collect_tir_lambda(executable, frame, &scopes, &keys)
    }
}

fn sema_expression_lambda_collect_tir_fallback(fallback: TOrFallback, frame: Int, scopes: &SemaScopeTable, keys: &[String]) {
    if fallback == {
        .Value(value) -> sema_expression_lambda_collect_tir_expr(value, frame, &scopes, &keys)
        .Return(value) -> sema_expression_lambda_collect_tir_optional_expr(value, frame, &scopes, &keys)
        .Panic(message, _) -> sema_expression_lambda_collect_tir_expr(message, frame, &scopes, &keys)
        else -> {}
    }
}

fn sema_expression_lambda_collect_tir_expr(value: TExpr, frame: Int, scopes: &SemaScopeTable, keys: &[String]) {
    if value.kind == {
        .Local(local) -> sema_expression_lambda_collect_tir_capture_local(local, frame, &scopes, &keys)
        .Call(_, _, args) -> loop argument in args -> sema_expression_lambda_collect_tir_expr(argument.value, frame, &scopes, &keys)
        .IndirectCall(callee, _, args, _) -> {
            sema_expression_lambda_collect_tir_expr(callee, frame, &scopes, &keys)
            loop argument in args -> sema_expression_lambda_collect_tir_expr(argument.value, frame, &scopes, &keys)
        }
        .MethodCall(receiver, _, _, args) -> {
            sema_expression_lambda_collect_tir_expr(receiver, frame, &scopes, &keys)
            loop argument in args -> sema_expression_lambda_collect_tir_expr(argument.value, frame, &scopes, &keys)
        }
        .OptField(base, _, _) -> sema_expression_lambda_collect_tir_expr(base, frame, &scopes, &keys)
        .OptMethodCall(base, _, call, _) -> {
            sema_expression_lambda_collect_tir_expr(base, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(call, frame, &scopes, &keys)
        }
        .Lambda(lambda) -> sema_expression_lambda_collect_tir_lambda(lambda, frame, &scopes, &keys)
        .LambdaValue(lambda) -> sema_expression_lambda_collect_tir_lambda(lambda, frame, &scopes, &keys)
        .InlineBlock(body) -> sema_expression_lambda_collect_tir_statements(body, frame, &scopes, &keys)
        .Binary(_, _, _, left, right) -> {
            sema_expression_lambda_collect_tir_expr(left, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(right, frame, &scopes, &keys)
        }
        .CompareChain(values, _, _) -> loop item in values -> sema_expression_lambda_collect_tir_expr(item, frame, &scopes, &keys)
        .Unary(_, operand) -> sema_expression_lambda_collect_tir_expr(operand, frame, &scopes, &keys)
        .Field(receiver, _) -> sema_expression_lambda_collect_tir_expr(receiver, frame, &scopes, &keys)
        .Index(base, index, _, _, _, _) -> {
            sema_expression_lambda_collect_tir_expr(base, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(index, frame, &scopes, &keys)
        }
        .Slice(base, start, end, range, _) -> {
            sema_expression_lambda_collect_tir_expr(base, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(start, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(end, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_optional_expr(range, frame, &scopes, &keys)
        }
        .Range(start, end, _) -> {
            sema_expression_lambda_collect_tir_expr(start, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(end, frame, &scopes, &keys)
        }
        .Tuple(values) -> loop item in values -> sema_expression_lambda_collect_tir_expr(item, frame, &scopes, &keys)
        .List(values, _) -> loop item in values -> sema_expression_lambda_collect_tir_expr(item, frame, &scopes, &keys)
        .Map(entries) -> loop entry in entries {
            sema_expression_lambda_collect_tir_expr(entry.key, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(entry.value, frame, &scopes, &keys)
        }
        .Try(item, _, _) | .Clone(item, _) | .ExplicitCopy(item) | .MaterializeView(item) | .Deref(item) | .RawOf(item) | .Present(item) | .Ok(item) | .Err(item) -> sema_expression_lambda_collect_tir_expr(item, frame, &scopes, &keys)
        .TryWithContext(inner, note, _, _, _, _) -> {
            sema_expression_lambda_collect_tir_expr(inner, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_optional_expr(note, frame, &scopes, &keys)
        }
        .Borrow(place, _) -> sema_expression_lambda_collect_tir_expr(place, frame, &scopes, &keys)
        .AddressOf(place, _, _) | .RawAddressOf(place) -> sema_expression_lambda_collect_tir_place(place, frame, &scopes, &keys)
        .PtrFromAddr(address, _) | .LayoutLiteral(address) | .LayoutLit(address) -> sema_expression_lambda_collect_tir_expr(address, frame, &scopes, &keys)
        .LayoutCompare(_, left, right) -> {
            sema_expression_lambda_collect_tir_expr(left, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(right, frame, &scopes, &keys)
        }
        .IfExpr(condition, then_body, then_value, else_body, else_value) -> {
            sema_expression_lambda_collect_tir_condition(condition, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_statements(then_body, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(then_value, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_statements(else_body, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(else_value, frame, &scopes, &keys)
        }
        .OrFallback(inner, fallback, _) -> {
            sema_expression_lambda_collect_tir_expr(inner, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_fallback(fallback, frame, &scopes, &keys)
        }
        .BuiltinMethod(receiver, _, args) -> {
            sema_expression_lambda_collect_tir_expr(receiver, frame, &scopes, &keys)
            loop argument in args -> sema_expression_lambda_collect_tir_expr(argument, frame, &scopes, &keys)
        }
        .ClosureMethod(receiver, _, args) -> {
            sema_expression_lambda_collect_tir_expr(receiver, frame, &scopes, &keys)
            loop argument in args -> sema_expression_lambda_collect_tir_expr(argument, frame, &scopes, &keys)
        }
        .HandleMethod(receiver, _, args) -> {
            sema_expression_lambda_collect_tir_expr(receiver, frame, &scopes, &keys)
            loop argument in args -> sema_expression_lambda_collect_tir_expr(argument, frame, &scopes, &keys)
        }
        .NumericMethod(receiver, _) -> sema_expression_lambda_collect_tir_expr(receiver, frame, &scopes, &keys)
        .NumericBinaryMethod(receiver, _, argument) -> {
            sema_expression_lambda_collect_tir_expr(receiver, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(argument, frame, &scopes, &keys)
        }
        .CoreClosureCall(kind) -> sema_expression_lambda_collect_tir_core_closure(kind, frame, &scopes, &keys)
        .TaskGroupAll(tasks) | .TaskGroupRace(tasks) | .TaskGroupAny(tasks) -> sema_expression_lambda_collect_tir_expr(tasks, frame, &scopes, &keys)
        .SelectRecv(builder, channel) -> {
            sema_expression_lambda_collect_tir_expr(builder, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(channel, frame, &scopes, &keys)
        }
        .SelectAfter(builder, duration, after_value) -> {
            sema_expression_lambda_collect_tir_expr(builder, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_expr(duration, frame, &scopes, &keys)
            sema_expression_lambda_collect_tir_optional_expr(after_value, frame, &scopes, &keys)
        }
        .FnValue(kind) -> sema_expression_lambda_collect_tir_fn_value(kind, frame, &scopes, &keys)
        .ModuleCall(_, _, _, _, args) -> loop argument in args -> sema_expression_lambda_collect_tir_expr(argument.value, frame, &scopes, &keys)
        .ExternCall(_, _, args) -> loop argument in args -> sema_expression_lambda_collect_tir_expr(argument.value, frame, &scopes, &keys)
        else -> {}
    }
}

fn sema_expression_lambda_collect_tir_statements(statements: [TStmt], frame: Int, scopes: &SemaScopeTable, keys: &[String]) {
    loop statement in statements {
        if statement == {
            .Let(_, _, init, _, _, _) -> sema_expression_lambda_collect_tir_expr(init, frame, &scopes, &keys)
            .RefutableBind(_, init, fallback, _) -> {
                sema_expression_lambda_collect_tir_expr(init, frame, &scopes, &keys)
                sema_expression_lambda_collect_tir_statements(fallback, frame, &scopes, &keys)
            }
            .Assign(place, _, value, _, _, _) -> {
                sema_expression_lambda_collect_tir_place(place, frame, &scopes, &keys)
                sema_expression_lambda_collect_tir_expr(value, frame, &scopes, &keys)
            }
            .ExprStmt(value, _) -> sema_expression_lambda_collect_tir_expr(value, frame, &scopes, &keys)
            .CountedLoop(_, init, condition, step, _, body, _) -> {
                sema_expression_lambda_collect_tir_statements([TStmt]{init}, frame, &scopes, &keys)
                sema_expression_lambda_collect_tir_expr(condition, frame, &scopes, &keys)
                sema_expression_lambda_collect_tir_optional_statement(step, frame, &scopes, &keys)
                sema_expression_lambda_collect_tir_statements(body, frame, &scopes, &keys)
            }
            .ForRange(_, _, start, end, step, _, body, _, _) -> {
                sema_expression_lambda_collect_tir_expr(start, frame, &scopes, &keys)
                sema_expression_lambda_collect_tir_expr(end, frame, &scopes, &keys)
                sema_expression_lambda_collect_tir_optional_expr(step, frame, &scopes, &keys)
                sema_expression_lambda_collect_tir_statements(body, frame, &scopes, &keys)
            }
            .Range(_, _, source, start, end, step, _, _, body, _) -> {
                sema_expression_lambda_collect_tir_optional_expr(source, frame, &scopes, &keys)
                sema_expression_lambda_collect_tir_expr(start, frame, &scopes, &keys)
                sema_expression_lambda_collect_tir_expr(end, frame, &scopes, &keys)
                sema_expression_lambda_collect_tir_optional_expr(step, frame, &scopes, &keys)
                sema_expression_lambda_collect_tir_statements(body, frame, &scopes, &keys)
            }
            .If(condition, then_body, else_body, _, _) -> {
                sema_expression_lambda_collect_tir_condition(condition, frame, &scopes, &keys)
                sema_expression_lambda_collect_tir_statements(then_body, frame, &scopes, &keys)
                if else_body == .Val(else_statements) -> sema_expression_lambda_collect_tir_statements(else_statements, frame, &scopes, &keys)
            }
            .Loop(_, body, _) -> sema_expression_lambda_collect_tir_statements(body, frame, &scopes, &keys)
            .While(_, condition, body, _) -> {
                sema_expression_lambda_collect_tir_expr(condition, frame, &scopes, &keys)
                sema_expression_lambda_collect_tir_statements(body, frame, &scopes, &keys)
            }
            .TaskGroup(_, limit, body, _) -> {
                sema_expression_lambda_collect_tir_optional_expr(limit, frame, &scopes, &keys)
                sema_expression_lambda_collect_tir_statements(body, frame, &scopes, &keys)
            }
            .Inline(body, _) | .DebugOnly(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) -> sema_expression_lambda_collect_tir_statements(body, frame, &scopes, &keys)
            .Unsafe(_, body) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Impure(body, _) | .ScopeMember(_, body, _) -> sema_expression_lambda_collect_tir_statements(body, frame, &scopes, &keys)
            .Reactive(executable, _) -> sema_expression_lambda_collect_tir_lambda(executable, frame, &scopes, &keys)
            .Layout(_, _, body, _) | .ContextBlock(_, body, _) | .Transact(_, _, _, body, _) -> sema_expression_lambda_collect_tir_statements(body, frame, &scopes, &keys)
            .Match(subject, arms, _, _) -> {
                sema_expression_lambda_collect_tir_expr(subject, frame, &scopes, &keys)
                loop arm in arms -> sema_expression_lambda_collect_tir_statements(arm.body, frame, &scopes, &keys)
            }
            .EnumMatch(scrutinee, _, arms, else_body, _, _) -> {
                sema_expression_lambda_collect_tir_expr(scrutinee, frame, &scopes, &keys)
                loop arm in arms -> sema_expression_lambda_collect_tir_statements(arm.body, frame, &scopes, &keys)
                if else_body == .Val(else_statements) -> sema_expression_lambda_collect_tir_statements(else_statements, frame, &scopes, &keys)
            }
            .RangeSwitch(subject, arms, else_body, _) -> {
                sema_expression_lambda_collect_tir_expr(subject, frame, &scopes, &keys)
                loop arm in arms -> sema_expression_lambda_collect_tir_statements(arm.body, frame, &scopes, &keys)
                sema_expression_lambda_collect_tir_statements(else_body, frame, &scopes, &keys)
            }
            .MixedSwitch(subject, _, arms, else_body, _) -> {
                sema_expression_lambda_collect_tir_expr(subject, frame, &scopes, &keys)
                loop arm in arms {
                    sema_expression_lambda_collect_tir_expr(arm.condition, frame, &scopes, &keys)
                    sema_expression_lambda_collect_tir_statements(arm.body, frame, &scopes, &keys)
                }
                if else_body != None -> sema_expression_lambda_collect_tir_statements(else_body, frame, &scopes, &keys)
            }
            else -> {}
        }
    }
}


fn sema_expression_lambda_name_contains(names: [String], name: String) -> Bool Never! {
    loop existing in names {
        if existing == name -> return true
    }
    false
}

fn sema_expression_lambda_append_name(names: &[String], name: String) Never! {
    if !sema_expression_lambda_name_contains(names, name) -> &names.push(name)
}

fn sema_expression_lambda_is_view_type(ty: Type, string_view: Bool) -> Bool Never! {
    if string_view -> return true
    if ty == {
        .Apply(name, _) -> return name == "View" || name == "ViewMut" || name == "ViewIter"
        else -> false
    }
}

fn sema_expression_lambda_block_value_type(statements: [TStmt], fallback: Type) -> Type Never! {
    if statements.len() == 0 -> return ~fallback
    index := statements.len() - 1
    loop index >= 0 {
        if statements[index] == {
            .Return(value, _) -> {
                if value != None {
                    actual :: value
                    return actual.ty
                }
            }
            .ExprStmt(value, _) -> return value.ty
            else -> {}
        }
        index -= 1
    }
    ~fallback
}

fn sema_expression_lambda_capture_diagnostic(name: String, ty: Type, span: Span) -> Diagnostic {
    sema_error("E0120", span, "`{name}` was not moved here, so it cannot be captured by a stored lambda", "this lambda would retain a borrowed value after the current access window ends", "make the parameter owned with the move marker `^`, or capture an owned copy")
}

fn sema_expression_lambda_view_diagnostic(name: String, span: Span) -> Diagnostic {
    sema_error("E0631", span, "`{name}` cannot be shared — it does not live long enough to be captured by a stored lambda", "a view borrows storage owned by the surrounding scope; retaining the lambda could outlive that storage", "copy the view into an owned value before capturing it, or keep the lambda inside the view's scope")
}
fn sema_expression_lambda_merge_context_facts(source: &SemaCheckContext, target: &SemaCheckContext, call_start: Int, name_start: Int, comptime_start: Int, body_source_start: Int, compute_call_start: Int, autodiff_obligation_start: Int, copy_start: Int) Never! {
    index := call_start
    loop index < source.call_facts.len() {
        &target.call_facts.push(source.call_facts[index])
        index += 1
    }
    index = name_start
    loop index < source.name_references.len() {
        &target.name_references.push(source.name_references[index])
        index += 1
    }
    index = comptime_start
    loop index < source.comptime_requests.len() {
        &target.comptime_requests.push(source.comptime_requests[index])
        index += 1
    }
    index = body_source_start
    loop index < source.comptime_body_sources.len() {
        &target.comptime_body_sources.push(source.comptime_body_sources[index])
        index += 1
    }
    index = compute_call_start
    loop index < source.compute_calls.len() {
        &target.compute_calls.push(source.compute_calls[index])
        index += 1
    }
    index = autodiff_obligation_start
    loop index < source.autodiff_obligations.len() {
        &target.autodiff_obligations.push(source.autodiff_obligations[index])
        index += 1
    }
    if source.autodiff_safe_panic -> target.autodiff_safe_panic = true
    if source.autodiff_unsafe_panic -> target.autodiff_unsafe_panic = true
    index = copy_start
    loop index < source.copy_events.len() {
        &target.copy_events.push(source.copy_events[index])
        index += 1
    }
}

fn sema_expression_lambda_type_is_result(ty: Type) -> Bool Never! {
    if ty == .Result(_, _) -> return true
    false
}

fn sema_expression_lambda_apply_capture_facts(state: &SemaOwnershipState, lambda: Lambda, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if !sema_ownership_check_lambda_captures(&state, lambda, scopes, &diagnostics) -> return false
    moved := [String]{}
    loop capture in lambda.take_names -> sema_expression_lambda_append_name(&moved, capture.name)
    loop name in lambda.meta.moved_captures {
        if sema_expression_lambda_name_contains(moved, name) -> next
        binding_index :: sema_scope_resolve_index(scopes, name) ?? return false
        binding :: scopes.bindings[binding_index]
        if !sema_ownership_mark_move(&state, Expr.Ident{name: binding.symbol.name, span: binding.symbol.span}, scopes, "an escaping lambda", &diagnostics) -> return false
    }
    true
}

fn sema_expression_lambda(lambda: Lambda, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    sema_expression_lambda_with_host(lambda, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics, false, false, false, false)
}

// Rust builtin_methods.rs collection callbacks: an expected `Fn` whose result
// is open (`ret: None`) adopts the callback's own result, whether a lambda or
// a named function value; the collection method then checks that result
// against its own callback contract (`open_ret` skips E0108).
pub fn sema_expression_lambda_collection_callback(expr: Expr, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    previous_lambda_escapes := context.lambda_escapes
    context.lambda_escapes = Val(false)
    open_result := false
    if expected == .Val(.Fn(_, ret, _, _, _, _)) && ret == None -> open_result = true
    // D-SUBJECT-CALL1=A: `.member` shorthand is the ordinary unary lambda.
    shorthand :: sema_expr_subject_shorthand(expr, expected, context, &diagnostics)
    if shorthand != None -> context.subject_shorthand_depth += 1
    source :: if shorthand == .Val(lambda) -> Expr.Lambda{lambda: lambda} else -> expr
    checked := if source == {
        .Lambda(lambda) -> sema_expression_lambda_with_host(lambda, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics, false, false, false, true)
        else -> sema_check_expression(source, if open_result -> None else -> expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    if shorthand != None -> context.subject_shorthand_depth -= 1
    context.lambda_escapes = previous_lambda_escapes
    checked
}

pub fn sema_expression_lambda_host_callback(expr: Expr, expected: Type?, write: Bool, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if expr == {
        .Lambda(lambda) -> return sema_expression_lambda_with_host(lambda, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics, true, write, false, false)
        else -> sema_check_expression(expr, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
}

pub fn sema_expression_lambda_host_callback_stored(expr: Expr, expected: Type?, write: Bool, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if expr == {
        .Lambda(lambda) -> return sema_expression_lambda_with_host(lambda, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics, true, write, true, false)
        else -> sema_check_expression(expr, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
}

fn sema_expression_lambda_rewrite_arm_labels(arms: [SwitchArm], old_label: String, new_label: String) -> [SwitchArm] Never! {
    updated := ~arms
    loop index in 0..<updated.len() {
        body := updated[index].body
        sema_expression_lambda_rewrite_loop_label(&body, old_label, new_label)
        updated[index].body = body
    }
    updated
}

fn sema_expression_lambda_rewrite_optional_labels(statements: [Stmt]?, old_label: String, new_label: String) -> [Stmt]? Never! {
    present :: statements ?? return None
    body := ~present
    sema_expression_lambda_rewrite_loop_label(&body, old_label, new_label)
    Val(body)
}

fn sema_expression_lambda_rewrite_loop_label(statements: &[Stmt], old_label: String, new_label: String) Never! {
    index := 0
    loop index < statements.len() {
        statement := statements[index]
        if statement == {
            .BreakLabel(name, span) -> if name == old_label -> statements[index] = Stmt.BreakLabel{name: new_label, span: span}
            .ContinueLabel(name, span) -> if name == old_label -> statements[index] = Stmt.ContinueLabel{name: new_label, span: span}
            .BreakLabelValue(name, name_span, value, span) -> if name == old_label -> statements[index] = Stmt.BreakLabelValue{name: new_label, name_span: name_span, value: value, span: span}
            .Switch(subject, arms, else_body, span) -> {
                statements[index] = Stmt.Switch{subject: subject, arms: sema_expression_lambda_rewrite_arm_labels(arms, old_label, new_label), else_body: sema_expression_lambda_rewrite_optional_labels(else_body, old_label, new_label), span: span}
            }
            .ComptimeSwitch(subject, arms, else_body, span) -> {
                statements[index] = Stmt.ComptimeSwitch{subject: subject, arms: sema_expression_lambda_rewrite_arm_labels(arms, old_label, new_label), else_body: sema_expression_lambda_rewrite_optional_labels(else_body, old_label, new_label), span: span}
            }
            .ComptimeIf(condition, condition_span, then_body, else_body, span, selected_then) -> {
                updated_then_body := then_body
                sema_expression_lambda_rewrite_loop_label(&updated_then_body, old_label, new_label)
                statements[index] = Stmt.ComptimeIf{cond: condition, cond_span: condition_span, then_body: updated_then_body, else_body: sema_expression_lambda_rewrite_optional_labels(else_body, old_label, new_label), span: span, selected_then: selected_then}
            }
            .Loop(body, span, arrow_body, label) | .While(_, body, span, arrow_body, label) | .CountedLoop(_, _, _, body, span, arrow_body, label) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                if statement == {
                    .Loop(_, _, _, _) -> statements[index] = Stmt.Loop{body: updated_body, span: span, arrow_body: arrow_body, label: label}
                    .While(condition, _, _, _, _) -> statements[index] = Stmt.While{cond: condition, body: updated_body, span: span, arrow_body: arrow_body, label: label}
                    .CountedLoop(init, condition, step, _, _, _, _) -> statements[index] = Stmt.CountedLoop{init: init, cond: condition, step: step, body: updated_body, span: span, arrow_body: arrow_body, label: label}
                    else -> {}
                }
            }
            .For(variable, variable_span, variable_two, kind, body, span, arrow_body, label, vectorization) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.For{var: variable, var_span: variable_span, var2: variable_two, kind: kind, body: updated_body, span: span, arrow_body: arrow_body, label: label, auto_vectorization: vectorization}
            }
            .Unsafe(audit, audit_expr, body, span) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.Unsafe{audit: audit, audit_expr: audit_expr, body: updated_body, span: span}
            }
            .Impure(reason, reason_expr, body, span) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.Impure{reason: reason, reason_expr: reason_expr, body: updated_body, span: span}
            }
            .Reactive(body, span) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.Reactive{body: updated_body, span: span}
            }
            .Shield(body, span) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.Shield{body: updated_body, span: span}
            }
            .Switched(marker, body, span) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.Switched{marker: marker, body: updated_body, span: span}
            }
            .Region(name, name_span, body, span) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.Region{name: name, name_span: name_span, body: updated_body, span: span}
            }
            .Policy(declarations, body, span) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.Policy{declarations: declarations, body: updated_body, span: span}
            }
            .TaskGroup(name, name_span, limit, body, span) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.TaskGroup{name: name, name_span: name_span, limit: limit, body: updated_body, span: span}
            }
            .Layout(name, name_span, body, span) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.Layout{name: name, name_span: name_span, body: updated_body, span: span}
            }
            .AuthorityScope(caps, caps_span, binding, body, span) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.AuthorityScope{caps: caps, caps_span: caps_span, binding: binding, body: updated_body, span: span}
            }
            .ComptimeBlock(body, is_template_loop, span) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.ComptimeBlock{body: updated_body, is_template_loop: is_template_loop, span: span}
            }
            .ContextBlock(fields, body, span) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.ContextBlock{fields: fields, body: updated_body, span: span}
            }
            .Live(body, span) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.Live{body: updated_body, span: span}
            }
            .AssumeDet(reason, reason_expr, body, span) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.AssumeDet{reason: reason, reason_expr: reason_expr, body: updated_body, span: span}
            }
            .Transact(name, name_span, body, implicit, span) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.Transact{name: name, name_span: name_span, body: updated_body, implicit: implicit, span: span}
            }
            .ScopeMember(name, name_span, args, args_span, body, dsl, dot_span, span) -> {
                updated_body := body
                sema_expression_lambda_rewrite_loop_label(&updated_body, old_label, new_label)
                statements[index] = Stmt.ScopeMember{name: name, name_span: name_span, args: args, args_span: args_span, body: updated_body, dsl: dsl, dot_span: dot_span, span: span}
            }
            else -> {}
        }
        index += 1
    }
}

fn sema_expression_lambda_install_loop_label(lambda: &Lambda, label: NamedSpan) Never! {
    if lambda.body == {
        .Block(statements) -> {
            updated_statements := statements
            if updated_statements.len() == 0 -> return
            root := updated_statements[0]
            old_label := String?{None}
            if root == {
                .Loop(body, span, arrow_body, previous) -> {
                    if previous != None -> old_label = Val(previous.name)
                    updated_statements[0] = Stmt.Loop{body: body, span: span, arrow_body: arrow_body, label: Val(label)}
                }
                .While(condition, body, span, arrow_body, previous) -> {
                    if previous != None -> old_label = Val(previous.name)
                    updated_statements[0] = Stmt.While{cond: condition, body: body, span: span, arrow_body: arrow_body, label: Val(label)}
                }
                .For(variable, variable_span, variable_two, kind, body, span, arrow_body, previous, vectorization) -> {
                    if previous != None -> old_label = Val(previous.name)
                    updated_statements[0] = Stmt.For{var: variable, var_span: variable_span, var2: variable_two, kind: kind, body: body, span: span, arrow_body: arrow_body, label: Val(label), auto_vectorization: vectorization}
                }
                .CountedLoop(init, condition, step, body, span, arrow_body, previous) -> {
                    if previous != None -> old_label = Val(previous.name)
                    updated_statements[0] = Stmt.CountedLoop{init: init, cond: condition, step: step, body: body, span: span, arrow_body: arrow_body, label: Val(label)}
                }
                else -> {}
            }
            if old_label == .Val(old) && old != label.name -> sema_expression_lambda_rewrite_loop_label(&updated_statements, old, label.name)
        }
        else -> {}
    }
}

// The lambda is checked in its own frame on the live scope table and rolled
// back, instead of on a copy of the whole table (every module binding) per
// lambda; no scope state of the lambda flows back to the enclosing table.
fn sema_expression_lambda_with_host(lambda: Lambda, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], host_callback: Bool, host_write: Bool, host_stored: Bool, open_result: Bool) -> TExpr? {
    outer_return_type :: ~scopes.return_type
    outer_failure_carrier :: ~scopes.failure_carrier
    lambda_mark :: sema_scope_mark(&scopes)
    checked :: sema_expression_lambda_with_host_in_frame(lambda, expected, environment, &scopes, outer_return_type, outer_failure_carrier, &state, &tail_store, &context, &diagnostics, host_callback, host_write, host_stored, open_result)
    sema_scope_rollback(&scopes, lambda_mark)
    checked
}

// A lambda's written, expected and inferred returns are one type when they
// agree in resolved form: an expected `[module::Name]` (resolved by the slot
// that supplied it) and a body's bare `[Name]` name the same declaration.
fn sema_expression_lambda_return_fits(required: Type, offered: Type, environment: SemaScopeEnvironment) -> Bool Never! {
    if sema_type_assignable(required, offered) -> return true
    sema_type_assignable(sema_expr_expected_type(required, environment), sema_expr_expected_type(offered, environment))
}

fn sema_expression_lambda_with_host_in_frame(lambda: Lambda, expected: Type?, environment: SemaScopeEnvironment, lambda_scopes: &SemaScopeTable, outer_return_type: Type?, outer_failure_carrier: TFailureCarrier?, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], host_callback: Bool, host_write: Bool, host_stored: Bool, open_result: Bool) -> TExpr? {
    lambda_work := lambda
    inline_loop := lambda_work.params.len() == 0 && (lambda_work.meta.collecting_loop || lambda_work.meta.result_loop)
    if inline_loop && lambda_work.meta.loop_label == .Val(named) -> sema_expression_lambda_install_loop_label(&lambda_work, named)
    parent_last_loop_result := context.last_loop_result_type
    parent_arrow_loop_body := context.arrow_loop_body
    expected_params := [Type]?{None}
    expected_ret := Type?{None}
    expected_effects := [EffectRowEntry]?{None}
    expected_contract := [CallContractRow]?{None}
    expected_metadata := FunctionCallMetadata?{None}
    expected_provenance := ViewProvenanceMap?{None}
    if expected != None {
        normalized :: sema_expr_unwrap_tag(expected)
        if normalized == {
            .Fn(params, ret, effects, contract, metadata, provenance) -> {
                expected_params = Val(params)
                expected_ret = ret
                expected_effects = effects
                expected_contract = contract
                expected_metadata = metadata
                expected_provenance = provenance
            }
            else -> {
                &diagnostics.push(sema_type_mismatch(normalized, Type.Fn{params: [Type]{}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}, lambda.span))
                return None
            }
        }
    }
    if expected_effects == .Val(bound) {
        if lambda.effects == .Val(written) {
            open := false
            loop entry in bound -> if entry.name.starts_with("..") -> open = true
            exceeds := false
            loop entry in written {
                if entry.name.starts_with("!") || entry.name.starts_with("..") -> next
                covered := false
                loop allowed in bound -> if sema_effect_covers(allowed.name, entry.name) -> covered = true
                if !covered -> exceeds = true
            }
            if !open && exceeds {
                offered := [String]{}
                allowed := [String]{}
                loop entry in written -> &offered.push(entry.name)
                loop entry in bound -> &allowed.push(entry.name)
                if !sema_effect_check_callback_bound(offered, allowed, lambda.span, &diagnostics) -> return None
            }
        }
    }
    if lambda.effects != None -> expected_effects = lambda.effects
    if expected_params != None && lambda.params.len() != (expected_params ?? [Type]{}).len() {
        &diagnostics.push(sema_error("E0104", lambda.span, "this lambda has {lambda.params.len()} parameters, but {(expected_params ?? [Type]{}).len()} were expected", "function values have a fixed parameter count", "match the expected function type"))
        return None
    }

    // Host callback bodies and explicitly escaping hooks are checked outside
    // the enclosing authored transaction wall.
    if host_callback || (!inline_loop && context.lambda_escapes == (Val(true))) {
        lambda_scopes.transaction_depth = 0
        lambda_scopes.transaction_wall_depth = 0
    }
    lambda_parent_state := sema_ownership_state_snapshot(state)
    lambda_state := sema_ownership_state_snapshot(state)
    lambda_context := sema_check_context_snapshot(context)
    if !inline_loop {
        lambda_context.loop_value_frames = [SemaLoopValueFrame]{}
        lambda_context.loop_break_flows = [SemaLoopBreakFlows]{}
        lambda_context.pending_loop_value = None
        lambda_context.collect_item_types = [Type?]{}
        lambda_context.last_loop_result_type = None
        lambda_context.arrow_loop_body = false
    }
    lambda_context.local_view_provenance = [SemaLocalViewProvenance]{}
    lambda_context.return_view_receiver_key = ""
    lambda_context.return_view_parameter_keys = [String]{}
    lambda_context.return_view_provenance = None
    call_fact_start := lambda_context.call_facts.len()
    name_reference_start := lambda_context.name_references.len()
    comptime_request_start := lambda_context.comptime_requests.len()
    copy_event_start := lambda_context.copy_events.len()
    body_source_start := lambda_context.comptime_body_sources.len()
    compute_call_start := lambda_context.compute_calls.len()
    autodiff_obligation_start := lambda_context.autodiff_obligations.len()
    failure_edge_start := lambda_context.failure_edges.len()
    lambda_context.autodiff_safe_panic = false
    lambda_context.autodiff_unsafe_panic = false
    frame := sema_scope_enter(&lambda_scopes, &lambda_state, "lambda@{lambda.span.start}")
    param_types := [Type]{}
    param_names := [String]{}
    param_symbols := [SymbolID]{}
    index := 0
    loop index < lambda.params.len() {
        parameter :: lambda.params[index]
        parameter_ty := parameter.ty
        if parameter_ty == None && expected_params != None && index < (expected_params ?? [Type]{}).len() -> parameter_ty = Val((expected_params ?? [Type]{})[index])
        parameter_type :: parameter_ty ?? {
            &diagnostics.push(sema_error("E0801", parameter.name_span, "tell me the type of `{parameter.name}`", "this lambda parameter has no type to go on", "write `({parameter.name}: Int) -> …` (or whatever type fits)"))
            return None
        }
        if parameter.ty != None && expected_params == .Val(required_params) {
            if index < required_params.len() && !type_identity_equal(parameter_type, required_params[index]) {
                &diagnostics.push(sema_type_mismatch(required_params[index], parameter_type, parameter.ty_span ?? parameter.name_span))
                return None
            }
        }
        parameter_owner := sema_scope_local_owner_key(lambda_scopes)
        parameter_id := symbol_id(SymbolKind.Parameter, environment.module_identity, parameter_owner, parameter.name)
        parameter_symbol := Symbol{id: parameter_id, kind: SymbolKind.Parameter, name: parameter.name, module_name: environment.module_identity, owner: Val(parameter_owner), span: parameter.name_span, ty: Val(parameter_type), visibility: 0}
        if !sema_scope_declare_local(&lambda_scopes, parameter_symbol, host_callback && host_write, AccessConvention.Read, None, false) {
            &diagnostics.push(sema_already_defined(parameter.name, parameter.name_span))
            return None
        }
        &param_symbols.push(parameter_id)
        &lambda_context.return_view_parameter_keys.push(parameter_id.key)
        &param_types.push(parameter_type)
        &param_names.push(parameter.name)
        index += 1
    }

    body_expected := if expected_ret == .Val(.Result(ok, _)) -> Val(ok) else -> expected_ret
    child_return :: body_expected
    if {
        inline_loop -> {
            lambda_scopes.return_type = outer_return_type
            lambda_scopes.failure_carrier = outer_failure_carrier
        }
        else -> {
            lambda_scopes.return_type = child_return
            // D-FAILURE-FOUNDATION1=A: a callback expected to return a Result
            // propagates into that carrier. An unannotated callback whose
            // expected function type returns a plain non-Unit value (or
            // nothing), or that has no expected function type at all, infers
            // its carrier from its first propagated call (the Rust reference's
            // callback failure-carrier inference), so the closure's own type
            // carries the failure. Every other callback has no failure route:
            // a fallible call in it is E0403.
            carrier_source := child_return
            if expected_ret == .Val(.Result(_, _)) -> carrier_source = expected_ret
            infers :: expected_ret != (Val(Type.Named{name: "Unit"})) && !sema_expression_lambda_type_is_result(expected_ret ?? Type.Named{name: "Unit"})
            lambda_scopes.failure_carrier = if infers -> None else -> Val(sema_expression_failure_carrier(carrier_source ?? Type.Named{name: "Unit"}))
            lambda_context.failure_inference = infers
            lambda_context.inferred_failure_carrier = None
        }
    }
    loop_label := String?{None}
    if lambda_work.meta.loop_label == .Val(named) -> loop_label = Val(named.name)
    if {
        inline_loop && lambda_work.meta.collecting_loop -> {
            sema_loop_value_push_collecting_type(&lambda_context)
            sema_loop_value_set_pending_type(&lambda_context, SemaLoopValueKind.Collecting, loop_label, None)
        }
        inline_loop && lambda_work.meta.result_loop -> {
            sema_loop_value_set_pending_type(&lambda_context, SemaLoopValueKind.Result, loop_label, body_expected)
        }
    }
    if !inline_loop -> lambda_scopes.loop_depth = 0

    first_reference := lambda_state.references.len()
    // D-COPY-DEFAULT1=A (Rust `record_share_site` keeps one checker-wide
    // list): a share site the body finds is found for the enclosing function
    // too, even when that use stops this body's check with its E0121.
    body_result_ty := Type.Named{name: "Unit"}
    executable := TLambdaBody?{None}
    if lambda.body == {
        .Expr(value) -> {
            checked_value := sema_check_expression(value, body_expected, environment, &lambda_scopes, &lambda_state, &tail_store, &lambda_context, &diagnostics)
            sema_ownership_keep_share_found(&state, lambda_state)
            checked :: checked_value ?? return None
            body_result_ty = checked.ty
            executable = Val(TLambdaBody.Expr{value: checked})
        }
        .Block(statements) -> {
            statement_return := if inline_loop -> outer_return_type else -> body_expected
            statement_body := [Stmt]{}
            tail_source := Expr?{None}
            statement_index := 0
            loop statement_index < statements.len() {
                if {
                    statement_index == statements.len() - 1 && statements[statement_index] == .Expr(value) -> {
                        tail_source = Val(value)
                    }
                    else -> {
                        &statement_body.push(statements[statement_index])
                    }
                }
                statement_index += 1
            }
            checked_block :: sema_check_statements(statement_body, statement_return, environment, &lambda_scopes, &lambda_state, &tail_store, &lambda_context, &diagnostics, 0)
            sema_ownership_keep_share_found(&state, lambda_state)
            sema_single_use_check_scope_end(lambda_state, &diagnostics)
            if !checked_block.complete {
                loop reason in lambda_context.incomplete_reasons -> sema_check_unsupported(&context, "closure body: {reason}")
                return None
            }
            if !inline_loop && body_expected != None && (body_expected ?? Type.Named{name: "Unit"}) != (Type.Named{name: "Unit"}) && tail_source == None && sema_stmt_tir_block_can_fall_through(checked_block.value) && !sema_stmt_block_definitely_returns(statements) {
                &diagnostics.push(sema_error("E0113", lambda.span, "this block closure can fall through without returning its value", "a non-Unit closure needs a return on every reachable path", "return a value from every path or make the closure return Unit"))
                return None
            }
            checked_body := checked_block.value
            if {
                tail_source != None -> {
                    tail :: tail_source ?? Expr.Unit{span: lambda.span}
                    checked_tail_value := sema_check_expression(tail, body_expected, environment, &lambda_scopes, &lambda_state, &tail_store, &lambda_context, &diagnostics)
                    sema_ownership_keep_share_found(&state, lambda_state)
                    checked_tail :: checked_tail_value ?? return None
                    body_result_ty = checked_tail.ty
                    &checked_body.push(TStmt.Return{value: Val(checked_tail), span: expr_span(tail)})
                }
                else -> {
                    body_result_ty = sema_expression_lambda_block_value_type(checked_body, body_expected ?? Type.Named{name: "Unit"})
                }
            }
            executable = Val(TLambdaBody.Block{body: checked_body})
        }
    }
    if {
        inline_loop && lambda_work.meta.collecting_loop -> {
            item_type :: sema_loop_value_pop_collecting_type(&lambda_context) ?? {
                &diagnostics.push(sema_error("E0073", lambda.span, "this collecting loop path produces no item", "every accepted iteration must contribute one non-unit value unless `next` omits it", "return a value on this path, or remove `->`"))
                return None
            }
            // A declared `module::Name` slot and a written `Name` item are one
            // type: both sides are compared in their resolved form.
            if expected_ret == .Val(.List(expected_item)) {
                resolved_expected :: sema_expr_expected_type(expected_item, environment)
                resolved_item :: sema_expr_expected_type(item_type, environment)
                if !type_identity_equal(resolved_item, resolved_expected) {
                    common :: sema_expr_numeric_join(resolved_item, resolved_expected) ?? {
                        &diagnostics.push(sema_type_mismatch(Type.List{element: expected_item}, Type.List{element: item_type}, lambda.span))
                        return None
                    }
                    if !type_identity_equal(common, resolved_expected) {
                        &diagnostics.push(sema_type_mismatch(Type.List{element: expected_item}, Type.List{element: item_type}, lambda.span))
                        return None
                    }
                }
            }
            lambda_work.meta.collect_item_type = Val(item_type)
            body_result_ty = Type.List{element: item_type}
            if executable == .Val(.Block(checked_body)) {
                lowered_body :: sema_loop_value_lower_collecting_body(checked_body, item_type, lambda.span, environment, &diagnostics) ?? return None
                executable = Val(TLambdaBody.Block{body: lowered_body})
            }
        }
        inline_loop && lambda_work.meta.result_loop -> {
            result_type :: lambda_context.last_loop_result_type ?? {
                &diagnostics.push(sema_error("E0073", lambda.span, "this loop has no final break value", "a loop used as a value must return one value through `break value`", "add `break value`, or use the loop only for effects"))
                return None
            }
            lambda_work.meta.loop_result_type = Val(result_type)
            body_result_ty = result_type
            if lambda_work.meta.requires_exhaustion_route && !lambda_work.meta.exhaustion_route_attached {
                &diagnostics.push(sema_error("E0078", lambda_work.meta.exhaustion_span ?? lambda.span, "this finite value loop needs a written exhaustion route", "the source can end without a matching break, so the expression must state what exhaustion means", "add `?? fallback` after the closing `}}`, or use the labeled loop form for `next` or `break`"))
                return None
            }
        }
    }
    if inline_loop -> lambda_context.last_loop_result_type = parent_last_loop_result
    executable_value :: executable ?? return None
    lambda_owner := "lambda@{lambda.span.start}"
    enclosing_owner := sema_scope_function_owner_key(lambda_scopes)
    if !inline_loop {
        call_index := call_fact_start
        loop call_index < lambda_context.call_facts.len() {
            if lambda_context.call_facts[call_index].caller_key == enclosing_owner {
                lambda_context.call_facts[call_index].caller_key = lambda_owner
            }
            call_index += 1
        }
    }
    direct_effects := [String]{}
    effect_edges := [String]{}
    effect_spans := [TEffectSpan]{}
    effect_maximal := false
    sema_expression_lambda_add_effect_facts(&lambda_context, call_fact_start, &direct_effects, &effect_edges, &effect_spans, &effect_maximal)
    effect_seed := [String]{}
    loop name in direct_effects -> sema_expression_lambda_append_name(&effect_seed, name)
    lambda_work.meta.effect_direct = direct_effects
    lambda_work.meta.effect_solved = effect_seed
    // Rust `check_lambda` (D-EFFECT-LAMBDA1): the lambda's call edges, so the
    // enclosing function's effect node and the lambda's projected row both
    // reach its callees.
    lambda_work.meta.effect_call_edges = effect_edges
    lambda_work.meta.effect_direct_spans = [EffectRowEntry]{}
    loop effect_span in effect_spans {
        &lambda_work.meta.effect_direct_spans.push(EffectRowEntry{name: effect_span.name, span: effect_span.span})
    }
    lambda_work.meta.effect_maximal = effect_maximal

    captures := [TCapture]{}
    escapes := false
    if {
        inline_loop -> {
        lambda_work.meta.cloned_captures = [String]{}
        lambda_work.meta.frozen_captures = [String]{}
        lambda_work.meta.materialized_captures = [String]{}
        lambda_work.meta.moved_captures = [String]{}
        lambda_work.meta.mut_captures = [String]{}
        lambda_work.meta.needs_fn_mut = false
        lambda_work.meta.escapes = false
        }
        else -> {
    capture_keys := [String]{}
    mutable_keys := [String]{}
    sema_expression_lambda_collect_reference_keys(&lambda_state, first_reference, frame, &lambda_scopes, &capture_keys, &mutable_keys)
    if executable_value == {
        .Expr(value) -> sema_expression_lambda_collect_tir_expr(value, frame, &lambda_scopes, &capture_keys)
        .Block(body) -> sema_expression_lambda_collect_tir_statements(body, frame, &lambda_scopes, &capture_keys)
        .SharedBlock(body) -> sema_expression_lambda_collect_tir_statements(body, frame, &lambda_scopes, &capture_keys)
    }
    lambda_work.meta.cloned_captures = [String]{}
    lambda_work.meta.frozen_captures = [String]{}
    lambda_work.meta.materialized_captures = [String]{}
    lambda_work.meta.moved_captures = [String]{}
    loop capture in lambda.take_names {
        outer_index := sema_expression_lambda_outer_binding(capture.name, capture.span, frame, &lambda_scopes)
        if outer_index == None {
            &diagnostics.push(sema_unknown_name(capture.name, capture.span))
            return None
        }
        sema_expression_lambda_add_capture_key(&capture_keys, lambda_scopes.bindings[outer_index ?? 0].symbol.id.key)
        sema_expression_lambda_append_name(&lambda_work.meta.moved_captures, capture.name)
    }
    declared_mutable := [String]{}
    loop name in lambda_work.meta.mut_captures -> &declared_mutable.push(name)
    lambda_work.meta.mut_captures = [String]{}
    loop name in declared_mutable {
        outer_index := sema_expression_lambda_outer_binding(name, lambda.span, frame, &lambda_scopes)
        if outer_index != None {
            key :: lambda_scopes.bindings[outer_index ?? 0].symbol.id.key
            sema_expression_lambda_add_capture_key(&capture_keys, key)
            sema_expression_lambda_add_capture_key(&mutable_keys, key)
        }
    }
    if capture_keys.len() == 0 && lambda.body == .Expr(value) && sema_expression_lambda_uses_outer(value, frame, param_names, &lambda_scopes) -> return None
    if capture_keys.len() == 0 && lambda.body == .Block(statements) && sema_expression_lambda_statements_use_outer(statements, frame, param_names, &lambda_scopes) -> return None
    loop key in mutable_keys {
        binding_index := sema_expression_lambda_outer_binding_key(key, frame, &lambda_scopes)
        if binding_index != None -> sema_expression_lambda_append_name(&lambda_work.meta.mut_captures, lambda_scopes.bindings[binding_index ?? 0].symbol.name)
    }
    lambda_work.meta.needs_fn_mut = lambda_work.meta.mut_captures.len() > 0

    escape_fact := context.lambda_escapes
    if {
        host_stored -> escape_fact = Val(true)
        host_callback -> escape_fact = Val(false)
    }
    if capture_keys.len() > 0 && escape_fact == None -> return None
    escapes = escape_fact ?? false
    lambda_work.meta.escapes = escapes
    if !sema_ownership_check_lambda_captures(&lambda_state, lambda_work, lambda_scopes, &diagnostics) -> return None

    found_capture_keys := [String]{}
    index = 0
    // Only a capture key can match; a capture-free lambda skips the table walk.
    loop capture_keys.len() > 0 && index < lambda_scopes.bindings.len() {
        binding :: lambda_scopes.bindings[index]
        key :: binding.symbol.id.key
        if binding.frame < frame && sema_expression_lambda_name_contains(capture_keys, key) {
            sema_expression_lambda_add_capture_key(&found_capture_keys, key)
            capture_ty :: binding.symbol.ty ?? return None
            local := tir_symbol_local(binding.symbol.name, binding.symbol.span, binding.symbol.id)
            local.mutable = binding.mutable
            local.integer_bounds = binding.integer_bounds
            &captures.push(TCapture{source: binding.symbol.name, local: local, ty: capture_ty})
            sema_cell_guard_check_capture(binding.symbol.name, capture_ty, lambda.span, &diagnostics)
            explicit_move := sema_expression_lambda_name_contains(lambda_work.meta.moved_captures, binding.symbol.name)
            is_view := sema_expression_lambda_is_view_type(capture_ty, binding.string_view)
            borrowed := binding.symbol.kind == SymbolKind.Parameter && binding.access != AccessConvention.Move
            if {
                !escapes -> {
                    if explicit_move -> sema_expression_lambda_append_name(&lambda_work.meta.moved_captures, binding.symbol.name) else -> sema_expression_lambda_append_name(&lambda_work.meta.frozen_captures, binding.symbol.name)
                }
                is_view -> {
                    if explicit_move || binding.mutable {
                        &diagnostics.push(sema_expression_lambda_view_diagnostic(binding.symbol.name, binding.symbol.span))
                        return None
                    }
                    facts := sema_copy_classify(capture_ty, SemaCopyIntent.Clone, environment, context.generic_params, binding.string_view)
                    if !facts.complete -> return None
                    if !facts.accepted || !facts.materializes_view {
                        &diagnostics.push(sema_expression_lambda_view_diagnostic(binding.symbol.name, binding.symbol.span))
                        return None
                    }
                    sema_expression_lambda_append_name(&lambda_work.meta.materialized_captures, binding.symbol.name)
                    sema_expression_lambda_append_name(&lambda_work.meta.cloned_captures, binding.symbol.name)
                    &lambda_context.copy_events.push(SemaCopyEvent{span: binding.symbol.span, facts: facts})
                }
                explicit_move -> {
                    sema_expression_lambda_append_name(&lambda_work.meta.moved_captures, binding.symbol.name)
                }
                else -> {
                    facts := sema_copy_classify(capture_ty, SemaCopyIntent.Clone, environment, context.generic_params, binding.string_view)
                    if !facts.complete -> return None
                    if {
                        facts.accepted -> {
                            sema_expression_lambda_append_name(&lambda_work.meta.cloned_captures, binding.symbol.name)
                            &lambda_context.copy_events.push(SemaCopyEvent{span: binding.symbol.span, facts: facts})
                        }
                        borrowed -> {
                            &diagnostics.push(sema_expression_lambda_capture_diagnostic(binding.symbol.name, capture_ty, binding.symbol.span))
                            return None
                        }
                        else -> {
                            sema_expression_lambda_append_name(&lambda_work.meta.moved_captures, binding.symbol.name)
                            if !sema_ownership_mark_move(&lambda_state, Expr.Ident{name: binding.symbol.name, span: binding.symbol.span}, lambda_scopes, "an escaping lambda", &diagnostics) -> return None
                        }
                    }
                }
            }
        }
        index += 1
    }
    if found_capture_keys.len() != capture_keys.len() -> return None
    }
    }

    success_ty := body_result_ty
    ret_ty := success_ty
    if expected_ret == {
        .Val(.Result(_, err)) -> {
            if !sema_expression_lambda_type_is_result(success_ty) -> ret_ty = Type.Result{ok: success_ty, err: err}
        }
        else -> {}
    }
    // A callback that inferred its carrier returns it around the success value.
    if !inline_loop && lambda_context.failure_inference && lambda_context.inferred_failure_carrier == .Val(inferred) {
        if inferred == .Result(_, err) {
            if !sema_expression_lambda_type_is_result(success_ty) -> ret_ty = Type.Result{ok: success_ty, err: err}
            lambda_work.meta.fallible_propagation = true
            lambda_work.meta.fallible_carrier = Val(ret_ty)
        }
    }
    if expected_ret != None && !sema_expression_lambda_return_fits(expected_ret ?? ret_ty, ret_ty, environment) {
        // The inferred carrier cannot fit a plain expected return: the
        // failure has no route out of this callback (lambdas.rs E0403).
        if lambda_work.meta.fallible_propagation && ret_ty == .Result(_, inferred_error) {
            body_span :: if lambda.body == .Expr(body_value) -> expr_span(body_value) else -> lambda.span
            &diagnostics.push(sema_failure_no_carrier(inferred_error, body_span, true))
            return None
        }
        &diagnostics.push(sema_type_mismatch(expected_ret ?? ret_ty, ret_ty, lambda.span))
        return None
    }
    ret_slot := Type?{None}
    if ret_ty != (Type.Named{name: "Unit"}) -> ret_slot = Val(ret_ty)
    lambda_return_provenance := lambda_context.return_view_provenance
    lambda_work.meta.return_view_provenance = lambda_return_provenance
    fn_ty := Type.Fn{params: param_types, ret: ret_slot, effect_bound: expected_effects, param_contract: expected_contract, call_metadata: expected_metadata, return_view_provenance: lambda_return_provenance}
    captures_facts := TCaptureFacts{escapes: escapes, needs_fn_mut: lambda_work.meta.needs_fn_mut, mutable: lambda_work.meta.mut_captures, cloned: lambda_work.meta.cloned_captures, frozen: lambda_work.meta.frozen_captures, materialized: lambda_work.meta.materialized_captures, moved: lambda_work.meta.moved_captures}
    lambda_effects := sema_expression_lambda_effects(&lambda_work)
    host_param_conventions := [AccessConvention]?{None}
    if host_callback && host_write -> host_param_conventions = Val([AccessConvention]{AccessConvention.Write})
    lambda_value := TLambda{
        executable: if inline_loop -> executable_value else -> sema_expression_lambda_lift_returns(executable_value, ret_ty),
        source_span: lambda.span,
        frame_schedule: lambda_work.meta.frame_schedule,
        frame_schedule_derivation: lambda_work.meta.frame_schedule_derivation,
        capture_facts: captures_facts,
        failure_carrier: sema_expression_failure_carrier(ret_ty),
        effects: lambda_effects,
        host_param_conventions: host_param_conventions,
        source_params: param_names,
        source_param_symbols: param_symbols,
        jit_name: lambda_owner,
        param_types: param_types,
        ret: ret_slot,
        is_move: false,
        boxed: false,
        rc: false,
        arc: false,
        captures: captures,
        materialized_captures: lambda_work.meta.materialized_captures,
        frozen_captures: lambda_work.meta.frozen_captures,
        uses_stack_sentry: false,
    }
    result := sema_tir_expr(fn_ty, TExprKind.Lambda{value: lambda_value}, lambda.span)
    checked :: if (host_callback || open_result) && expected_ret == None -> result else -> sema_expr_expected(result, expected, environment, &diagnostics) ?? return None
    if inline_loop {
        sema_scope_leave(&lambda_scopes, &lambda_state)
        sema_ownership_join_paths(&state, lambda_parent_state, lambda_state, lambda_parent_state, true)
        context.loop_value_frames = lambda_context.loop_value_frames
        context.loop_break_flows = lambda_context.loop_break_flows
        context.pending_loop_value = lambda_context.pending_loop_value
        context.collect_item_types = lambda_context.collect_item_types
        context.last_loop_result_type = parent_last_loop_result
        context.arrow_loop_body = parent_arrow_loop_body
        // An inline loop shares its owner's failure route, including an
        // adopted open-callback carrier.
        context.inferred_failure_carrier = lambda_context.inferred_failure_carrier
    }
    sema_expression_lambda_merge_context_facts(&lambda_context, &context, call_fact_start, name_reference_start, comptime_request_start, body_source_start, compute_call_start, autodiff_obligation_start, copy_event_start)
    // #3708: the callback's propagated failures stay rows of the enclosing
    // body (the Rust body walk reads callbacks too); a callback that
    // propagates into its own inferred carrier is a failure source. Statement
    // direct sources stay in the lambda body, inline loops included: a
    // collecting loop's item `Yield` or a `return` inside it never makes the
    // owner fallible (the Rust reference's `in_lambda_body` gate).
    loop edge_index in failure_edge_start..<lambda_context.failure_edges.len() -> &context.failure_edges.push(lambda_context.failure_edges[edge_index])
    if lambda_work.meta.fallible_propagation {
        &context.failure_edges.push("")
        // D-FAIL-INFER-UNION1=A: the callback's failures belong to its own
        // carrier, so the enclosing default route only learns that the
        // general `Err` reaches it.
        context.failure_union_general = true
    }
    if inline_loop {
        // An inline loop body is the owner's body: its default-route failures
        // join the owner's failure-union row.
        context.failure_union_members = ~lambda_context.failure_union_members
        context.failure_union_cases = ~lambda_context.failure_union_cases
        context.failure_union_edges = ~lambda_context.failure_union_edges
        context.failure_union_general = context.failure_union_general || lambda_context.failure_union_general
    }
    Val(checked)
}

// Rust `fallible_lambda_value` (codegen lower/lambdas.rs): a callback whose
// return is a `Result` carrier (its fn slot's, its written error type's, or
// its inferred one) had its body checked against the success type, so every
// success route hands back `Ok(value)`. A value already in a carrier keeps
// it; one in the default `Err` carrier with the same success type takes the
// callback's carrier. A `Never` value stops before it returns anything.
fn sema_expression_lambda_lift_value(value: TExpr, carrier: Type) -> TExpr Never! {
    if carrier == .Result(carrier_ok, _) {
        if value.ty == .Result(value_ok, value_err) {
            if value_err == (Type.Named{name: "Err"}) && type_identity_equal(value_ok, carrier_ok) {
                rehomed := value
                rehomed.ty = carrier
                return rehomed
            }
            return ~value
        }
        if value.ty == (Type.Named{name: "Never"}) -> return ~value
        return sema_tir_expr(carrier, TExprKind.Ok{value: value}, value.span)
    }
    ~value
}

// Rust `lift_fallible_lambda_returns`: lift the expression body, or every
// `return` of a block body (its tail is one), into the `Result` carrier. A
// shared block body stays as checked, as Rust reuses it unlifted.
fn sema_expression_lambda_lift_returns(executable: TLambdaBody, carrier: Type) -> TLambdaBody Never! {
    if !sema_expression_lambda_type_is_result(carrier) -> return ~executable
    if executable == {
        .Expr(value) -> TLambdaBody.Expr{value: sema_expression_lambda_lift_value(value, carrier)}
        .Block(body) -> {
            lifted := body
            sema_expression_lambda_lift_block(&lifted, carrier)
            TLambdaBody.Block{body: lifted}
        }
        .SharedBlock(_) -> ~executable
    }
}

// Nested lambdas and reactive bodies are their own callables and keep their
// own returns; every other statement body belongs to this callback.
fn sema_expression_lambda_lift_block(statements: &[TStmt], carrier: Type) Never! {
    loop index in 0..<statements.len() {
        statement := statements[index]
        if statement == {
            .Return(value, span) -> {
                if value == .Val(returned) -> statements[index] = TStmt.Return{value: Val(sema_expression_lambda_lift_value(returned, carrier)), span: span}
            }
            .ContractScope(pre, body, post, result, span) -> {
                updated := body
                sema_expression_lambda_lift_block(&updated, carrier)
                statements[index] = TStmt.ContractScope{pre: pre, body: updated, post: post, result: result, span: span}
            }
            .RefutableBind(pattern, init, fallback, span) -> {
                updated := fallback
                sema_expression_lambda_lift_block(&updated, carrier)
                statements[index] = TStmt.RefutableBind{pattern: pattern, init: init, fallback: updated, span: span}
            }
            .CountedLoop(label, init, condition, step, vectorization, body, span) -> {
                updated := body
                sema_expression_lambda_lift_block(&updated, carrier)
                statements[index] = TStmt.CountedLoop{label: label, init: init, condition: condition, step: step, vectorization: vectorization, body: updated, span: span}
            }
            .ForRange(label, variable, start, end, step, exclusive, body, vectorization, span) -> {
                updated := body
                sema_expression_lambda_lift_block(&updated, carrier)
                statements[index] = TStmt.ForRange{label: label, local: variable, start: start, end: end, step: step, exclusive: exclusive, body: updated, vectorization: vectorization, span: span}
            }
            .Range(label, variable, source, start, end, step, exclusive, vectorization, body, span) -> {
                updated := body
                sema_expression_lambda_lift_block(&updated, carrier)
                statements[index] = TStmt.Range{label: label, variable: variable, source: source, start: start, end: end, step: step, exclusive: exclusive, vectorization: vectorization, body: updated, span: span}
            }
            .ForIn(label, variable, variable_two, source, collection, step, method_kind, columnar, by_value, source_stable, body, span) -> {
                updated := body
                sema_expression_lambda_lift_block(&updated, carrier)
                statements[index] = TStmt.ForIn{label: label, variable: variable, variable_two: variable_two, source: source, collection: collection, step: step, method_kind: method_kind, columnar: columnar, by_value: by_value, source_stable: source_stable, body: updated, span: span}
            }
            .While(label, condition, body, span) -> {
                updated := body
                sema_expression_lambda_lift_block(&updated, carrier)
                statements[index] = TStmt.While{label: label, condition: condition, body: updated, span: span}
            }
            .Loop(label, body, span) -> {
                updated := body
                sema_expression_lambda_lift_block(&updated, carrier)
                statements[index] = TStmt.Loop{label: label, body: updated, span: span}
            }
            .TaskGroup(group, limit, body, span) -> {
                updated := body
                sema_expression_lambda_lift_block(&updated, carrier)
                statements[index] = TStmt.TaskGroup{group: group, limit: limit, body: updated, span: span}
            }
            .If(condition, then_body, else_body, else_is_elseif, span) -> {
                updated_then := then_body
                sema_expression_lambda_lift_block(&updated_then, carrier)
                updated_else := else_body
                if else_body == .Val(else_statements) {
                    lifted := ~else_statements
                    sema_expression_lambda_lift_block(&lifted, carrier)
                    updated_else = Val(lifted)
                }
                statements[index] = TStmt.If{condition: condition, then_body: updated_then, else_body: updated_else, else_is_elseif: else_is_elseif, span: span}
            }
            .Match(subject, arms, exhaustive, span) -> {
                updated_arms := ~arms
                loop arm_index in 0..<updated_arms.len() {
                    arm_body := updated_arms[arm_index].body
                    sema_expression_lambda_lift_block(&arm_body, carrier)
                    updated_arms[arm_index].body = arm_body
                }
                statements[index] = TStmt.Match{subject: subject, arms: updated_arms, exhaustive: exhaustive, span: span}
            }
            .EnumMatch(subject, clone_subject, arms, else_body, fallthrough, span) -> {
                updated_arms := ~arms
                loop arm_index in 0..<updated_arms.len() {
                    arm_body := updated_arms[arm_index].body
                    sema_expression_lambda_lift_block(&arm_body, carrier)
                    updated_arms[arm_index].body = arm_body
                }
                updated_else := else_body
                if else_body == .Val(else_statements) {
                    lifted := ~else_statements
                    sema_expression_lambda_lift_block(&lifted, carrier)
                    updated_else = Val(lifted)
                }
                statements[index] = TStmt.EnumMatch{scrutinee: subject, clone_subject: clone_subject, arms: updated_arms, else_body: updated_else, fallthrough: fallthrough, span: span}
            }
            .RangeSwitch(subject, arms, else_body, span) -> {
                updated_arms := ~arms
                loop arm_index in 0..<updated_arms.len() {
                    arm_body := updated_arms[arm_index].body
                    sema_expression_lambda_lift_block(&arm_body, carrier)
                    updated_arms[arm_index].body = arm_body
                }
                updated_else := else_body
                sema_expression_lambda_lift_block(&updated_else, carrier)
                statements[index] = TStmt.RangeSwitch{subject: subject, arms: updated_arms, else_body: updated_else, span: span}
            }
            .MixedSwitch(subject, branch_class, arms, else_body, span) -> {
                updated_arms := ~arms
                loop arm_index in 0..<updated_arms.len() {
                    arm_body := updated_arms[arm_index].body
                    sema_expression_lambda_lift_block(&arm_body, carrier)
                    updated_arms[arm_index].body = arm_body
                }
                updated_else := else_body
                if else_body == .Val(else_statements) {
                    lifted := ~else_statements
                    sema_expression_lambda_lift_block(&lifted, carrier)
                    updated_else = Val(lifted)
                }
                statements[index] = TStmt.MixedSwitch{subject: subject, class: branch_class, arms: updated_arms, else_body: updated_else, span: span}
            }
            .Layout(handle, label, body, span) -> {
                updated := body
                sema_expression_lambda_lift_block(&updated, carrier)
                statements[index] = TStmt.Layout{handle: handle, label: label, body: updated, span: span}
            }
            .ContextBlock(guards, body, span) -> {
                updated := body
                sema_expression_lambda_lift_block(&updated, carrier)
                statements[index] = TStmt.ContextBlock{guards: guards, body: updated, span: span}
            }
            .Transact(handle, snapshots, stm, body, span) -> {
                updated := body
                sema_expression_lambda_lift_block(&updated, carrier)
                statements[index] = TStmt.Transact{handle: handle, snapshots: snapshots, stm: stm, body: updated, span: span}
            }
            .GCEdit(root, slot, edges, replace_all, index_temp, nested, span) -> {
                updated := [TStmt]{nested}
                sema_expression_lambda_lift_block(&updated, carrier)
                statements[index] = TStmt.GCEdit{root: root, slot: slot, edges: edges, replace_all: replace_all, index_temp: index_temp, statement: updated[0], span: span}
            }
            .Unsafe(gate, body) -> {
                updated := body
                sema_expression_lambda_lift_block(&updated, carrier)
                statements[index] = TStmt.Unsafe{gate: gate, body: updated}
            }
            .Inline(body, span) | .DebugOnly(body, span) | .UnsafeBlock(_, body, span) | .SentryPolicy(_, body, span) | .Impure(body, span) | .Region(body, span) | .Live(body, span) | .Shield(body, span) | .ScopeMember(_, body, span) -> {
                updated := body
                sema_expression_lambda_lift_block(&updated, carrier)
                if statement == {
                    .Inline(_, _) -> statements[index] = TStmt.Inline{body: updated, span: span}
                    .DebugOnly(_, _) -> statements[index] = TStmt.DebugOnly{body: updated, span: span}
                    .UnsafeBlock(gate, _, _) -> statements[index] = TStmt.UnsafeBlock{gate: gate, body: updated, span: span}
                    .SentryPolicy(enabled, _, _) -> statements[index] = TStmt.SentryPolicy{enabled: enabled, body: updated, span: span}
                    .Impure(_, _) -> statements[index] = TStmt.Impure{body: updated, span: span}
                    .Region(_, _) -> statements[index] = TStmt.Region{body: updated, span: span}
                    .Live(_, _) -> statements[index] = TStmt.Live{body: updated, span: span}
                    .Shield(_, _) -> statements[index] = TStmt.Shield{body: updated, span: span}
                    .ScopeMember(kind, _, _) -> statements[index] = TStmt.ScopeMember{kind: kind, body: updated, span: span}
                    else -> {}
                }
            }
            else -> {}
        }
    }
}
