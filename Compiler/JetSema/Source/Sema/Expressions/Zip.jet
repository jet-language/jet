// Shared checker and checked-tree producer for the zip family.
use jet_foundation.[
    AccessConvention,
    Call,
    CallArg,
    Diagnostic,
    Expr,
    Span,
    SymbolKind,
    TBuiltinOp,
    TZipFillMode,
    TZipMode,
    Type,
    TypeTupleField,
    expr_span,
    type_name,
]

sema_expression_zip_family_name: fn(name: String) -> Bool Never! {
    name == "zip" || name == "zip_short" || name == "zip_pad"
}

sema_expression_zip_sequence_elem: fn(ty: Type) -> Type? {
    if ty == {
        .Tagged(_, inner) -> return sema_expression_zip_sequence_elem(inner)
        // copy: `inner` is a payload of read parameter `ty`, which keeps the original; the Val carrier owns this one
        .List(inner) -> return Val(inner.copy())
        // copy: `inner` is a payload of read parameter `ty`, which keeps the original; the Val carrier owns this one
        .FixedList(inner, _) -> return Val(inner.copy())
        .Apply(name, args) -> {
            if (name == "Iter" || name == "ViewIter") && args.len() == 1 -> return Val(args[0])
        }
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    None
}

sema_expression_zip_is_iter: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, args) -> return (name == "Iter" || name == "ViewIter") && args.len() == 1
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_expression_zip_field_name: fn(index: Int, label: String?) -> String Never! {
    if label == .Val(name) -> return name
    if index == 0 -> return "a"
    if index == 1 -> return "b"
    if index == 2 -> return "c"
    if index == 3 -> return "d"
    if index == 4 -> return "e"
    if index == 5 -> return "f"
    "column_{index}"
}

sema_expression_zip_type_error: fn(message: String, span: Span, diagnostics: ^[Diagnostic]) {
    diagnostics.push(sema_error("E0112", span, message, "zip inputs and fill values must have one statically known column type", "pass lists or iterators with matching element types, or use a typed fill value"))
}

sema_expression_zip_cloneable: fn(ty: Type, span: Span, message: String, check: ^SemaBodyCheck) {
    ^facts: sema_copy_classify(ty, SemaCopyIntent.Clone, check.environment.*, check.program.*, check.environment.generic_params, false)
    if facts.complete && !facts.accepted {
        sema_expression_zip_type_error(message, span, check.diagnostics)
    }
}

// `literal` is the fill's value when it is an untyped whole-number literal,
// which takes any fixed-width column it fits (a fill of `0` on a `[U8]`).
sema_expression_zip_numeric_fill: fn(fill: Type, literal: Int?, element: Type, common: Bool, field: String, index: Int, span: Span, check: ^SemaBodyCheck) {
    if fill == element {
        return
    }
    if literal == .Val(number) && element == .IntN(signed, bits) && sema_expr_integer_fits(number, signed, bits) {
        return
    }
    if {
        sema_expr_numeric_widening_to(fill, element) == None -> {
            if {
                common -> {
                    sema_expression_zip_type_error("common zip fill `{type_name(fill)}` does not fit column `{type_name(element)}`", span, check.diagnostics)
                }
                else -> {
                    sema_expression_zip_type_error("fill `{field}` does not fit column {index + 1}", span, check.diagnostics)
                }
            }
        }
        else -> {
            if fill == {
                .InlineRange(_, _, _) -> {
                    ^_: sema_scope_require_knowledge_gate(check, SemaKnowledgePlane.Range, SemaKnowledgeGate.BoundedArithmetic, span)
                }
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
            }
        }
    }
}

sema_expression_zip_family: fn(method: String, inputs: [TExpr], fields: [String], common_fill_index: Int, column_fills_index: Int, fill_args: ^^[TExpr], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    ^elements: [Type]{}
    loop input in inputs {
        if sema_expression_zip_sequence_elem(input.ty) == {
            .Val(element) -> { elements.push(element) }
            .None -> {
                sema_expression_zip_type_error("`{method}` expects a list or `Iter`, got `{type_name(input.ty)}`", span, check.diagnostics)
                elements.push(Type.Int)
            }
        }
    }

    names: loop (index, _) in elements -> {
        name: if index < fields.len() -> fields[index] else -> sema_expression_zip_field_name(index, None)
        name
    }
    ^seen: [String]{}
    loop name in names {
        if {
            seen.contains(name) -> {
                check.diagnostics.push(sema_error("E0765", span, "zip output field `{name}` is repeated", "each input column needs one distinct row-field name", "rename the repeated input label"))
            }
            else -> { seen.push(name) }
        }
    }

    // Zero columns yield Iter<Unit>; one column is the identity sequence.
    if elements.len() <= 1 {
        ^result_element: if elements.len() == 1 -> elements[0] else -> Type.Named{name: "Unit"}
        ^result_ty: Type.Apply{name: "Iter", args: [Type]{result_element}}
        if inputs.len() == 0 {
            ^empty: sema_tree_node(Type.List{element: Type.Named{name: "Unit"}}, TExprKind.ListLit{values: [TExpr]{}}, span)
            ^value: sema_tree_node(result_ty, TExprKind.BuiltinMethod{receiver: empty, operation: TBuiltinOp.ListLazy, args: [TExpr]{}}, span)
            return sema_expr_expected_owned(value, expected, check.environment.*, check.program.*, check.diagnostics)
        }
        ^receiver: inputs[0]
        if sema_expression_zip_is_iter(receiver.ty) {
            return sema_expr_expected(receiver, expected, check.environment.*, check.program.*, check.diagnostics)
        }
        ^value: sema_tree_node(result_ty, TExprKind.BuiltinMethod{receiver: receiver, operation: TBuiltinOp.ListLazy, args: [TExpr]{}}, span)
        return sema_expr_expected_owned(value, expected, check.environment.*, check.program.*, check.diagnostics)
    }

    ^output_elements: elements
    if method == "zip_pad" {
        if common_fill_index >= 0 && column_fills_index >= 0 {
            sema_expression_zip_type_error("`zip_pad` accepts either `fill:` or `fills:`, not both", span, check.diagnostics)
        }
        if common_fill_index >= 0 {
            fill: fill_args[common_fill_index]
            sema_expression_zip_cloneable(fill.ty, span, "zip fill type `{type_name(fill.ty)}` is not cloneable", check)
            loop element in elements {
                sema_expression_zip_numeric_fill(fill.ty, sema_expr_integer_literal_value(fill), element, true, "", 0, span, check)
            }
        }
        if column_fills_index >= 0 {
            fills: fill_args[column_fills_index]
            if fills.ty == {
                .Tuple(fill_fields) -> {
                    loop (index, element) in elements {
                        field_name: names[index]
                        ^field: Type?{None}
                        loop candidate in fill_fields {
                            if candidate.name == field_name {
                                field = Val(candidate.ty)
                                break
                            }
                        }
                        if field == None {
                            sema_expression_zip_type_error("per-column fills omit `{field_name}`", span, check.diagnostics)
                            next
                        }
                        if field == .Val(fill_type) {
                            sema_expression_zip_cloneable(fill_type, span, "zip fill `{field_name}` has non-cloneable type `{type_name(fill_type)}`", check)
                            ^literal: Int?{None}
                            if fills.kind == .Tuple(values) {
                                loop (position, candidate) in fill_fields {
                                    if candidate.name == field_name && position < values.len() {
                                        literal = sema_expr_integer_literal_value(values[position])
                                    }
                                }
                            }
                            sema_expression_zip_numeric_fill(fill_type, literal, element, false, field_name, index, span, check)
                        }
                    }
                }
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
                    sema_expression_zip_type_error("`fills:` expects a named tuple of column values", span, check.diagnostics)
                }
            }
        }
        if common_fill_index < 0 && column_fills_index < 0 {
            output_elements = [Type]{}
            loop element in elements -> output_elements.push(Type.Option{inner: element})
        }
    }

    tuple_fields: loop index in 0..<elements.len() -> TypeTupleField{name: names[index], ty: output_elements[index]}
    ^tuple_ty: Type.Tuple{fields: tuple_fields}
    ^result_ty: Type.Apply{name: "Iter", args: [Type]{tuple_ty}}
    ^receiver: inputs[0]
    field_types: loop field in tuple_fields -> field.ty
    ^fill_mode: TZipFillMode.DefaultNone
    if method == "zip_pad" && fill_args.len() == 1 {
        if fill_args[0].ty == {
            .Tuple(_) -> { fill_mode = TZipFillMode.Columns }
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
                fill_mode = TZipFillMode.Common
            }
        }
    }
    ^mode: TZipMode.Strict
    if method == "zip_short" -> mode = TZipMode.Short
    if method == "zip_pad" -> mode = TZipMode.Pad
    ^operation: TBuiltinOp.Zip{mode: mode, fields: names, flatten: false, input_count: inputs.len(), fill_mode: fill_mode, field_types: field_types}
    ^lowered_args: [TExpr]{}
    loop index in 1..<inputs.len() -> lowered_args.push(inputs[index])
    lowered_args.extend(fill_args.move())
    ^value: sema_tree_node(result_ty, TExprKind.BuiltinMethod{receiver: receiver, operation: operation, args: lowered_args}, span)
    return sema_expr_expected_owned(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

sema_expression_zip_infer_arg: fn(argument: CallArg, check: ^SemaBodyCheck) -> TExpr? {
    sema_check_expression(argument.expr, None, check)
}

sema_expression_zip_free_call: fn(call: Call, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if !sema_expression_zip_family_name(call.name) || sema_scope_resolve_index(check.scopes, call.name) != None {
        return None
    }
    ^method: call.name
    ^is_pad: method == "zip_pad"
    ^inputs: [TExpr]{}
    ^fields: [String]{}
    loop arg_index in 0..<call.args.len() {
        ^label: if call.args[arg_index].label == {
            .Val(value) -> Val(value.name)
            .None -> None
        }
        if is_pad && (label == (Val("fill")) || label == (Val("fills"))) -> next
        checked: sema_expression_zip_infer_arg(call.args[arg_index], check) ?? return None
        fields.push(sema_expression_zip_field_name(inputs.len(), label))
        inputs.push(checked)
    }

    ^common_fill_index: -1
    ^column_fills_index: -1
    ^fill_args: [TExpr]{}
    loop arg_index in 0..<call.args.len() {
        ^label: if call.args[arg_index].label == {
            .Val(value) -> Val(value.name)
            .None -> None
        }
        if {
            is_pad && label == (Val("fill")) -> {
                checked: sema_expression_zip_infer_arg(call.args[arg_index], check) ?? return None
                common_fill_index = fill_args.len()
                fill_args.push(checked)
            }
            is_pad && label == (Val("fills")) -> {
                checked: sema_expression_zip_infer_arg(call.args[arg_index], check) ?? return None
                column_fills_index = fill_args.len()
                fill_args.push(checked)
            }
        }
    }
    sema_expression_zip_family(method, inputs, fields, common_fill_index, column_fills_index, fill_args.move(), call.name_span, expected, check)
}

sema_expression_zip_consume_receiver: fn(receiver: Expr, receiver_type: Type, method: String, check: ^SemaBodyCheck) -> Bool {
    if receiver == {
        .Ident(name, receiver_span, _) -> {
            index: sema_scope_resolve_index(check.scopes, name) ?? return true
            ^binding: check.scopes.bindings[index]
            if binding.symbol.kind == SymbolKind.Parameter && !sema_ownership_type_is_copy(receiver_type) && (binding.access == AccessConvention.Read || binding.access == AccessConvention.Write) {
                check.diagnostics.push(sema_error("E0120", receiver_span, "`{name}` was not moved here, so `.{method}()` can't take it", "this function has read access only and does not own the value", "call it on a copy, or take ownership: `{name}: ^^{type_name(receiver_type)}`"))
                return false
            }
            return sema_ownership_check_method_receiver(check, receiver, AccessConvention.Move, method, receiver_span)
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    true
}

sema_expression_zip_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    if method == "zip" && receiver_value.ty == .Option(_) {
        return sema_expression_option_zip(receiver_value, args, span, expected, check)
    }
    if !sema_expression_zip_family_name(method) || sema_expression_zip_sequence_elem(receiver_value.ty) == None {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    ^is_pad: method == "zip_pad"
    ^inputs: [TExpr]{receiver_value}
    ^fields: [String]{sema_expression_zip_field_name(0, None)}
    ^common_fill_index: -1
    ^column_fills_index: -1
    ^fill_args: [TExpr]{}
    loop arg in args {
        ^label: if arg.label == {
            .Val(value) -> Val(value.name)
            .None -> None
        }
        if {
            is_pad && label == (Val("fill")) -> {
                checked: sema_expression_zip_infer_arg(arg, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
                common_fill_index = fill_args.len()
                fill_args.push(checked)
            }
            is_pad && label == (Val("fills")) -> {
                checked: sema_expression_zip_infer_arg(arg, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
                column_fills_index = fill_args.len()
                fill_args.push(checked)
            }
            else -> {
                checked: sema_expression_zip_infer_arg(arg, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
                fields.push(sema_expression_zip_field_name(inputs.len(), label))
                inputs.push(checked)
            }
        }
    }
    if sema_expression_zip_is_iter(receiver_value.ty) {
        if !sema_expression_zip_consume_receiver(receiver, receiver_value.ty, method, check) {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    value: sema_expression_zip_family(method, inputs, fields, common_fill_index, column_fills_index, fill_args.move(), span, expected, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: Val(value)}
}

// finish_option_zip: `a: T?`.zip(`b: U?`) is `{a: T, b: U}?`, present only when
// both are.
sema_expression_option_zip: fn(receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    if args.len() != 1 {
        check.diagnostics.push(sema_error("E0104", span, "`.zip()` takes one optional argument, got {args.len()}", "`.zip(other)` pairs this optional with another: present only when both are", "call `a.zip(b)` with exactly one `T?` argument"))
        loop argument in args -> ^_: sema_expression_zip_infer_arg(argument, check)
        return failed
    }
    other: sema_expression_zip_infer_arg(args[0], check) ?? return failed
    ^fields: [TypeTupleField]{}
    if receiver_value.ty == .Option(left) && other.ty == .Option(right) {
        // copy: `left` and `right` are payloads of the operands' types, which the operands keep
        fields = [TypeTupleField]{TypeTupleField{name: "a", ty: left.copy()}, TypeTupleField{name: "b", ty: right}}
    }
    if fields.len() == 0 {
        check.diagnostics.push(sema_error("E0108", expr_span(args[0].expr), "`.zip()` needs an optional argument, got {sema_type_show(other.ty)}", "`.zip(other)` combines two optionals into one paired optional", "pass a `T?` value"))
        return failed
    }
    pair: Type.Tuple{fields: fields}
    // copy: the operation names the pair type the result's Option also owns
    operation: TBuiltinOp.OptionZip{elem_ty: pair.copy()}
    value: sema_tree_node(Type.Option{inner: pair}, TExprKind.BuiltinMethod{receiver: receiver_value, operation: operation, args: [TExpr]{other}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected_owned(value, expected, check.environment.*, check.program.*, check.diagnostics)}
}
