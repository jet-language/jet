// Axis-aware layout producers and generic Measurement<T> accessors.
// Layout statement bodies remain owned by Statements.jet.
use jet_foundation.[
    AccessConvention,
    BinOp,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    ParamZone,
    Span,
    Symbol,
    SymbolID,
    SymbolKind,
    TExpr,
    TExprKind,
    TFailureCarrier,
    TFieldRef,
    THandleOp,
    Type,
    symbol_id,
    type_identity_equal,
    type_name,
]

pub enum SemaExpressionLayoutAxis {
    Horizontal
    Vertical
    Neutral
}

pub struct SemaExpressionLayoutBinaryResult {
    pub result_type: Type?
    pub axis_mismatch: Bool
}

pub struct SemaExpressionLayoutBinaryCheck {
    pub handled: Bool
    pub value: TExpr?
}

pub struct SemaExpressionCoreFieldFact {
    pub owner: SymbolID
    pub field: Symbol
    pub ty: Type
}

pub fn sema_expression_layout_is_axis_type(name: String) -> Bool Never! {
    name == "HVar" || name == "VVar" || name == "LengthVar"
}

pub fn sema_expression_layout_is_type(name: String) -> Bool Never! {
    sema_expression_layout_is_axis_type(name) || name == "Constraint" || name == "Layout"
}

pub fn sema_expression_layout_axis_of(ty: Type) -> SemaExpressionLayoutAxis? {
    if ty == (Type.Named{name: "HVar"}) -> return Val(SemaExpressionLayoutAxis.Horizontal)
    if ty == (Type.Named{name: "VVar"}) -> return Val(SemaExpressionLayoutAxis.Vertical)
    if ty == (Type.Named{name: "LengthVar"}) -> return Val(SemaExpressionLayoutAxis.Neutral)
    if ty == Type.Int || ty == Type.Float || ty == .InlineRange(_, _, _) -> return Val(SemaExpressionLayoutAxis.Neutral)
    None
}

fn sema_expression_layout_axis_combine(left: SemaExpressionLayoutAxis, right: SemaExpressionLayoutAxis) -> SemaExpressionLayoutAxis? {
    if left == SemaExpressionLayoutAxis.Horizontal && right == SemaExpressionLayoutAxis.Vertical -> return None
    if left == SemaExpressionLayoutAxis.Vertical && right == SemaExpressionLayoutAxis.Horizontal -> return None
    if left == SemaExpressionLayoutAxis.Horizontal || right == SemaExpressionLayoutAxis.Horizontal -> return Val(SemaExpressionLayoutAxis.Horizontal)
    if left == SemaExpressionLayoutAxis.Vertical || right == SemaExpressionLayoutAxis.Vertical -> return Val(SemaExpressionLayoutAxis.Vertical)
    Val(SemaExpressionLayoutAxis.Neutral)
}

fn sema_expression_layout_axis_type_name(axis: SemaExpressionLayoutAxis) -> String Never! {
    if axis == {
        .Horizontal -> "HVar"
        .Vertical -> "VVar"
        .Neutral -> "LengthVar"
    }
}

pub fn sema_expression_layout_binop_result(op: BinOp, left: Type, right: Type) -> SemaExpressionLayoutBinaryResult? {
    left_layout := if left == {.Named(name) -> sema_expression_layout_is_axis_type(name) else -> false}
    right_layout := if right == {.Named(name) -> sema_expression_layout_is_axis_type(name) else -> false}
    if !left_layout && !right_layout -> return None
    left_axis :: sema_expression_layout_axis_of(left) ?? return None
    right_axis :: sema_expression_layout_axis_of(right) ?? return None
    if op != BinOp.Add && op != BinOp.Sub && op != BinOp.Ge && op != BinOp.Le && op != BinOp.Eq -> return None
    combined :: sema_expression_layout_axis_combine(left_axis, right_axis)
    if combined == None -> return Val(SemaExpressionLayoutBinaryResult{result_type: None, axis_mismatch: true})
    result_type := if op == BinOp.Ge || op == BinOp.Le || op == BinOp.Eq -> Type.Named{name: "Constraint"} else -> Type.Named{name: sema_expression_layout_axis_type_name(combined)}
    Val(SemaExpressionLayoutBinaryResult{result_type: Val(result_type), axis_mismatch: false})
}

pub fn sema_expression_layout_literal(value: TExpr) -> TExpr Never! {
    if value.ty == Type.Int || value.ty == Type.Float || value.ty == .InlineRange(_, _, _) {
        return sema_tir_expr(Type.Named{name: "LengthVar"}, TExprKind.LayoutLiteral{value: value}, value.span)
    }
    ~value
}

fn sema_expression_layout_binary_axis_diagnostic(left: Type, right: Type, span: Span, diagnostics: &[Diagnostic]) {
    &diagnostics.push(sema_error(
        "E2932",
        span,
        "layout constraint mixes a horizontal and vertical value (`{type_name(left)}` and `{type_name(right)}`)",
        "`left`/`right`/`width` are horizontal (`HVar`); `top`/`bottom`/`height` are vertical (`VVar`) — combining or comparing across axes is caught at compile time instead of producing a nonsensical layout",
        "compare or combine values from the same axis (a `LengthVar`, or a plain number, fits either axis)",
    ))
}

pub fn sema_expr_check_layout_binary(op: BinOp, left: TExpr, right: TExpr, span: Span, line: Int, expected: Type?, environment: SemaScopeEnvironment, diagnostics: &[Diagnostic]) -> SemaExpressionLayoutBinaryCheck {
    contract :: sema_expression_layout_binop_result(op, left.ty, right.ty)
    if contract == None -> return SemaExpressionLayoutBinaryCheck{handled: false, value: None}
    result :: contract
    if result.axis_mismatch {
        sema_expression_layout_binary_axis_diagnostic(left.ty, right.ty, span, &diagnostics)
        return SemaExpressionLayoutBinaryCheck{handled: true, value: None}
    }
    result_type :: result.result_type ?? return SemaExpressionLayoutBinaryCheck{handled: true, value: None}
    lowered_left :: sema_expression_layout_literal(left)
    lowered_right :: sema_expression_layout_literal(right)
    value :: if op == BinOp.Add || op == BinOp.Sub -> sema_tir_expr(result_type, TExprKind.Binary{op: sema_expr_tir_binary_op(op), overflow: false, line: line, lhs: lowered_left, rhs: lowered_right}, span) else -> sema_tir_expr(result_type, TExprKind.LayoutCompare{op: sema_expr_tir_binary_op(op), lhs: lowered_left, rhs: lowered_right}, span)
    checked :: sema_expr_expected(value, expected, environment, &diagnostics)
    SemaExpressionLayoutBinaryCheck{handled: true, value: checked}
}

fn sema_expression_layout_method_return(owner: String, method: String, argument_count: Int) -> Type? {
    if owner == "Layout" {
        if method == "h" && argument_count == 2 -> return Val(Type.Named{name: "HVar"})
        if method == "v" && argument_count == 2 -> return Val(Type.Named{name: "VVar"})
        if method == "value" && argument_count == 1 -> return Val(Type.Float)
        if method == "suggest" && argument_count == 2 -> return Val(Type.Named{name: "Unit"})
        if method == "is_feasible" && argument_count == 0 -> return Val(Type.Bool)
        if method == "conflict" && argument_count == 0 -> return Val(Type.List{element: Type.String})
    }
    if owner == "Constraint" && argument_count == 0 {
        if method == "required" || method == "strong" || method == "medium" || method == "weak" -> return Val(Type.Named{name: "Constraint"})
    }
    None
}

fn sema_expression_layout_method_arity(owner: String, method: String) -> Int? {
    if owner == "Layout" {
        if method == "h" || method == "v" || method == "suggest" -> return Val(2)
        if method == "value" -> return Val(1)
        if method == "is_feasible" || method == "conflict" -> return Val(0)
    }
    if owner == "Constraint" && (method == "required" || method == "strong" || method == "medium" || method == "weak") -> return Val(0)
    None
}

fn sema_expression_layout_method_arg_type(method: String, index: Int) -> Type? {
    if (method == "h" || method == "v") && (index == 0 || index == 1) -> return Val(Type.String)
    if method == "suggest" && index == 1 -> return Val(Type.Float)
    None
}

fn sema_expression_layout_method_axis_arg(method: String, index: Int) -> Bool Never! {
    (method == "value" || method == "suggest") && index == 0
}

fn sema_expression_layout_call_facts(result_type: Type) -> SemaCallFacts Never! {
    failure_carrier := if result_type == {.Result(ok, err) -> TFailureCarrier.Result{success: ok, error: err} else -> TFailureCarrier.Infallible}
    SemaCallFacts{return_type: result_type, failure_carrier: failure_carrier, effect_bound: Val([EffectRowEntry]{}), type_args: [Type]{}, default_refs: [FunctionDefaultRef]{}}
}

fn sema_expression_layout_discard_arguments(args: [CallArg], environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
}

fn sema_expression_layout_argument_mismatch(owner: String, method: String, expected: Type, actual: Type, span: Span, diagnostics: &[Diagnostic]) {
    &diagnostics.push(sema_error("E0128", span, "`.{method}()` on `{owner}` expects a `{type_name(expected)}`, got `{type_name(actual)}`", "`{owner}.{method}(…)` operates on a `{type_name(expected)}`", "pass a `{type_name(expected)}` value"))
}

fn sema_expression_layout_axis_argument_mismatch(owner: String, method: String, actual: Type, span: Span, diagnostics: &[Diagnostic]) {
    &diagnostics.push(sema_error("E0128", span, "`.{method}()` on `{owner}` expects a layout value (`HVar`/`VVar`/`LengthVar`), got `{type_name(actual)}`", "layout variables come from `handle.h(box, anchor)` / `handle.v(box, anchor)`, or a `box.anchor` read inside a `layout {{ … }}` block", "pass a layout variable, not a plain value"))
}

fn sema_expression_layout_method_params(types: [Type]) -> [SemaCallParam] Never! {
    params :: loop (index, ty) in types -> SemaCallParam{label: "arg{index + 1}", name: "arg{index + 1}", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(ty), variadic: false}
    params
}

pub fn sema_call_try_layout_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    updated_args := args
    owner := if receiver_value.ty == {.Named(name) -> if name == "Layout" || name == "Constraint" -> name else -> "" else -> ""}
    if owner == "" -> return SemaMethodSpecialCheck{handled: false, value: None}
    expected_count :: sema_expression_layout_method_arity(owner, method) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if updated_args.len() != expected_count {
        if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        &diagnostics.push(sema_call_arity_diagnostic("{owner}.{method}", expected_count, updated_args.len(), false, span))
        sema_expression_layout_discard_arguments(updated_args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    result_type :: sema_expression_layout_method_return(owner, method, expected_count) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    values := [TExpr]{}
    required_types := [Type]{}
    valid := true
    loop (index, argument) in updated_args {
        wanted := sema_expression_layout_method_arg_type(method, index)
        checked :: if wanted == .Val(required) -> sema_check_expression(argument.expr, Val(required), environment, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        if checked == None {
            valid = false
            &required_types.push(wanted ?? Type.Named{name: "Unit"})
            next
        }
        value :: checked
        axis_type := if value.ty == {.Named(name) -> sema_expression_layout_is_axis_type(name) else -> false}
        if sema_expression_layout_method_axis_arg(method, index) && !axis_type {
            sema_expression_layout_axis_argument_mismatch(owner, method, value.ty, argument.span, &diagnostics)
            valid = false
        }
        if wanted == .Val(required) && !type_identity_equal(value.ty, required) {
            sema_expression_layout_argument_mismatch(owner, method, required, value.ty, argument.span, &diagnostics)
            valid = false
        }
        &values.push(value)
        &required_types.push(wanted ?? value.ty)
    }
    ownership := sema_ownership_check_method_call(&state, "{owner}.{method}", receiver, AccessConvention.Read, sema_expression_layout_method_params(required_types), &updated_args, scopes, span, &diagnostics)
    if !ownership.accepted || !ownership.complete -> valid = false
    if !valid -> return SemaMethodSpecialCheck{handled: true, value: None}
    value :: sema_tir_expr(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: THandleOp.LayoutMethod{method: method}, args: values}, span)
    if !sema_effect_record_intrinsic_fact(environment, &scopes, &context, "{owner}.{method}", span, sema_expression_layout_call_facts(result_type), &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, &diagnostics)}
}

fn sema_expression_measurement_inner(ty: Type, environment: SemaScopeEnvironment) -> Type? {
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return None
    resolved :: sema_type_resolve_declared_with_generics(graph, ty, environment.module_identity, environment.generic_params)
    name :: if resolved == {
        .Apply(name, args) -> {
            if args.len() == 1 -> name else -> ""
        }
        else -> ""
    }
    if name != "Measurement" && name != "core.units::Measurement" -> return None
    nominal :: sema_type_resolve_nominal(graph, resolved, environment.module_identity)
    if nominal == .Val(owner) && (owner.symbol.module_name != "core.units" || owner.symbol.name != "Measurement") -> return None
    if nominal == None && name != "Measurement" -> return None
    if resolved == {
        .Apply(_, args) -> {
            if args.len() == 1 -> return Val(args[0])
        }
        else -> {}
    }
    None
}

pub fn sema_call_try_measurement_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != "value" && method != "uncertainty" -> return SemaMethodSpecialCheck{handled: false, value: None}
    _ := sema_expression_measurement_inner(receiver_value.ty, environment) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != 0 {
        if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        &diagnostics.push(sema_call_arity_diagnostic("Measurement.{method}", 0, args.len(), false, span))
        sema_expression_layout_discard_arguments(args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    result_type := Type.Float
    value :: sema_tir_expr(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: THandleOp.MeasurementMethod{method: method}, args: [TExpr]{}}, span)
    if !sema_effect_record_intrinsic_fact(environment, &scopes, &context, "Measurement.{method}", span, sema_expression_layout_call_facts(result_type), &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, &diagnostics)}
}

pub fn sema_expression_core_field_fact(ty: Type, member: String, environment: SemaScopeEnvironment) -> SemaExpressionCoreFieldFact? {
    inner :: sema_expression_measurement_inner(ty, environment) ?? return None
    if member != "value" && member != "uncertainty" -> return None
    owner_id :: symbol_id(SymbolKind.Type, "core.units", "", "Measurement")
    field_id :: symbol_id(SymbolKind.Field, "core.units", owner_id.key, member)
    field_symbol :: Symbol{id: field_id, kind: SymbolKind.Field, name: member, module_name: "core.units", owner: Val(owner_id.key), span: Span{start: 0, end: 0}, ty: Val(inner), visibility: 2}
    Val(SemaExpressionCoreFieldFact{owner: owner_id, field: field_symbol, ty: inner})
}

pub fn sema_expression_core_field_projection(base: TExpr, member: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    fact :: sema_expression_core_field_fact(base.ty, member, environment) ?? return None
    symbol := fact.field
    symbol.span = span
    &context.name_references.push(SemaNameReferenceFact{span: span, symbol: symbol, kind: "field"})
    reference :: TFieldRef{owner: Val(fact.owner), field: symbol.id, name: member, ty: fact.ty, boxed: false}
    value :: sema_tir_expr(fact.ty, TExprKind.Field{receiver: base, field: reference}, span)
    sema_expr_expected(value, expected, environment, &diagnostics)
}
