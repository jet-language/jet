// Axis-aware layout producers, the `name: Layout{ … }` statement and
// generic Measurement<T> accessors.
use jet_foundation.[
    AccessConvention,
    BinOp,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    ParamZone,
    Span,
    Stmt,
    Symbol,
    SymbolID,
    SymbolKind,
    TFailureCarrier,
    Type,
    checked_symbol_local,
    expr_span,
    symbol_id,
    type_identity_equal,
    type_name,
    core_source_owns_type,
    core_identity_is,
]

SemaExpressionLayoutAxis: enum {
    Horizontal
    Vertical
    Neutral
}

SemaExpressionLayoutBinaryResult: struct {
    result_type: Type?
    axis_mismatch: Bool
}

SemaExpressionLayoutBinaryCheck: struct {
    handled: Bool
    value: TExpr?
}

sema_expression_layout_is_axis_type: fn(name: String) -> Bool Never! {
    name == "HVar" || name == "VVar" || name == "LengthVar"
}

sema_expression_layout_axis_of: fn(ty: Type) -> SemaExpressionLayoutAxis? {
    if ty == (Type.Named{name: "HVar"}) -> return Val(SemaExpressionLayoutAxis.Horizontal)
    if ty == (Type.Named{name: "VVar"}) -> return Val(SemaExpressionLayoutAxis.Vertical)
    if ty == (Type.Named{name: "LengthVar"}) -> return Val(SemaExpressionLayoutAxis.Neutral)
    if ty == Type.Int || ty == Type.Float || ty == .InlineRange(_, _, _) -> return Val(SemaExpressionLayoutAxis.Neutral)
    None
}

sema_expression_layout_axis_combine: fn(left: SemaExpressionLayoutAxis, right: SemaExpressionLayoutAxis) -> SemaExpressionLayoutAxis? {
    if left == SemaExpressionLayoutAxis.Horizontal && right == SemaExpressionLayoutAxis.Vertical -> return None
    if left == SemaExpressionLayoutAxis.Vertical && right == SemaExpressionLayoutAxis.Horizontal -> return None
    if left == SemaExpressionLayoutAxis.Horizontal || right == SemaExpressionLayoutAxis.Horizontal -> return Val(SemaExpressionLayoutAxis.Horizontal)
    if left == SemaExpressionLayoutAxis.Vertical || right == SemaExpressionLayoutAxis.Vertical -> return Val(SemaExpressionLayoutAxis.Vertical)
    Val(SemaExpressionLayoutAxis.Neutral)
}

sema_expression_layout_axis_type_name: fn(axis: SemaExpressionLayoutAxis) -> String Never! {
    if axis == {
        .Horizontal -> "HVar"
        .Vertical -> "VVar"
        .Neutral -> "LengthVar"
    }
}

sema_expression_layout_binop_result: fn(op: BinOp, left: Type, right: Type) -> SemaExpressionLayoutBinaryResult? {
    left_layout := if left == {
        .Named(name) -> sema_expression_layout_is_axis_type(name)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
    right_layout := if right == {
        .Named(name) -> sema_expression_layout_is_axis_type(name)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
    if !left_layout && !right_layout -> return None
    left_axis: sema_expression_layout_axis_of(left) ?? return None
    right_axis: sema_expression_layout_axis_of(right) ?? return None
    if op != BinOp.Add && op != BinOp.Sub && op != BinOp.Ge && op != BinOp.Le && op != BinOp.Eq -> return None
    combined: sema_expression_layout_axis_combine(left_axis, right_axis)
    if combined == None -> return Val(SemaExpressionLayoutBinaryResult{result_type: None, axis_mismatch: true})
    result_type := if op == BinOp.Ge || op == BinOp.Le || op == BinOp.Eq -> Type.Named{name: "Constraint"} else -> Type.Named{name: sema_expression_layout_axis_type_name(combined)}
    Val(SemaExpressionLayoutBinaryResult{result_type: Val(result_type), axis_mismatch: false})
}

sema_expression_layout_literal: fn(value: TExpr) -> TExpr Never! {
    if value.ty == Type.Int || value.ty == Type.Float || value.ty == .InlineRange(_, _, _) {
        return sema_tree_node(Type.Named{name: "LengthVar"}, TExprKind.LayoutLiteral{value: value}, value.span)
    }
    value.copy()
}

sema_expression_layout_binary_axis_diagnostic: fn(left: Type, right: Type, span: Span, diagnostics: &[Diagnostic]) {
    diagnostics.push(sema_error(
        "E2932",
        span,
        "layout constraint mixes a horizontal and vertical value (`{type_name(left)}` and `{type_name(right)}`)",
        "`left`/`right`/`width` are horizontal (`HVar`); `top`/`bottom`/`height` are vertical (`VVar`) — combining or comparing across axes is caught at compile time instead of producing a nonsensical layout",
        "compare or combine values from the same axis (a `LengthVar`, or a plain number, fits either axis)",
    ))
}

sema_expr_check_layout_binary: fn(op: BinOp, left: TExpr, right: TExpr, span: Span, line: Int, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> SemaExpressionLayoutBinaryCheck {
    contract: sema_expression_layout_binop_result(op, left.ty, right.ty)
    if contract == None -> return SemaExpressionLayoutBinaryCheck{handled: false, value: None}
    result: contract
    if result.axis_mismatch {
        sema_expression_layout_binary_axis_diagnostic(left.ty, right.ty, span, diagnostics)
        return SemaExpressionLayoutBinaryCheck{handled: true, value: None}
    }
    result_type: result.result_type ?? return SemaExpressionLayoutBinaryCheck{handled: true, value: None}
    lowered_left: sema_expression_layout_literal(left)
    lowered_right: sema_expression_layout_literal(right)
    value: if op == BinOp.Add || op == BinOp.Sub -> sema_tree_node(result_type, TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: lowered_left, rhs: lowered_right}, span) else -> sema_tree_node(result_type, TExprKind.LayoutCompare{op: sema_expr_tree_binary_op(op), lhs: lowered_left, rhs: lowered_right}, span)
    checked: sema_expr_expected(value, expected, environment, program, diagnostics)
    SemaExpressionLayoutBinaryCheck{handled: true, value: checked}
}

sema_expression_layout_method_return: fn(owner: String, method: String, argument_count: Int) -> Type? {
    if owner == "Layout" {
        if method == "h" && argument_count == 2 -> return Val(Type.Named{name: "HVar"})
        if method == "v" && argument_count == 2 -> return Val(Type.Named{name: "VVar"})
        if method == "value" && argument_count == 1 -> return Val(Type.Float)
        if method == "suggest" && argument_count == 2 -> return Val(Type.Named{name: "Unit"})
        if method == "is_feasible" && argument_count == 0 -> return Val(Type.Bool)
        if method == "conflict" && argument_count == 0 -> return Val(Type.List{element: Type.String})
    }
    if owner == "Constraint" && argument_count == 0 {
        if method == "required" || method == "strong" || method == "medium" || method == "weak" -> return Val(Type.Named{name: "Constraint"})
    }
    None
}

sema_expression_layout_method_arity: fn(owner: String, method: String) -> Int? {
    if owner == "Layout" {
        if method == "h" || method == "v" || method == "suggest" -> return Val(2)
        if method == "value" -> return Val(1)
        if method == "is_feasible" || method == "conflict" -> return Val(0)
    }
    if owner == "Constraint" && (method == "required" || method == "strong" || method == "medium" || method == "weak") -> return Val(0)
    None
}

sema_expression_layout_method_arg_type: fn(method: String, index: Int) -> Type? {
    if (method == "h" || method == "v") && (index == 0 || index == 1) -> return Val(Type.String)
    if method == "suggest" && index == 1 -> return Val(Type.Float)
    None
}

sema_expression_layout_method_axis_arg: fn(method: String, index: Int) -> Bool Never! {
    (method == "value" || method == "suggest") && index == 0
}

sema_expression_layout_call_facts: fn(result_type: Type) -> SemaCallFacts Never! {
    failure_carrier := if result_type == {
        .Result(ok, err) -> TFailureCarrier.Result{success: ok, error: err}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> TFailureCarrier.Infallible
    }
    SemaCallFacts{return_type: result_type, failure_carrier: failure_carrier, effect_bound: Val([EffectRowEntry]{}), type_args: [Type]{}, default_refs: [FunctionDefaultRef]{}}
}

sema_expression_layout_discard_arguments: fn(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
}

sema_expression_layout_argument_mismatch: fn(owner: String, method: String, expected: Type, actual: Type, span: Span, diagnostics: &[Diagnostic]) {
    diagnostics.push(sema_error("E0112", span, "`.{method}()` on `{owner}` expects a `{type_name(expected)}`, got `{type_name(actual)}`", "`{owner}.{method}(…)` operates on a `{type_name(expected)}`", "pass a `{type_name(expected)}` value"))
}

sema_expression_layout_axis_argument_mismatch: fn(owner: String, method: String, actual: Type, span: Span, diagnostics: &[Diagnostic]) {
    diagnostics.push(sema_error("E0112", span, "`.{method}()` on `{owner}` expects a layout value (`HVar`/`VVar`/`LengthVar`), got `{type_name(actual)}`", "layout variables come from `handle.h(box, anchor)` / `handle.v(box, anchor)`, or a `box.anchor` read inside a `layout {{ … }}` block", "pass a layout variable, not a plain value"))
}

sema_expression_layout_method_params: fn(types: [Type]) -> [SemaCallParam] Never! {
    params: loop (index, ty) in types -> SemaCallParam{label: "arg{index + 1}", name: "arg{index + 1}", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(ty), variadic: false}
    params
}

sema_call_try_layout_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    updated_args := args
    owner := if receiver_value.ty == {
        .Named(name) -> if name == "Layout" || name == "Constraint" -> name else -> ""
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> ""
    }
    if owner == "" -> return SemaMethodSpecialCheck{handled: false, value: None}
    expected_count: sema_expression_layout_method_arity(owner, method) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if updated_args.len() != expected_count {
        if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        diagnostics.push(sema_call_arity_diagnostic("{owner}.{method}", expected_count, updated_args.len(), false, span))
        sema_expression_layout_discard_arguments(updated_args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    result_type: sema_expression_layout_method_return(owner, method, expected_count) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    values := [TExpr]{}
    required_types := [Type]{}
    valid := true
    loop (index, argument) in updated_args {
        wanted := sema_expression_layout_method_arg_type(method, index)
        checked: if wanted == .Val(required) -> sema_check_expression(argument.expr, Val(required), environment, program, scopes, state, tail_store, context, diagnostics) else -> sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        if checked == None {
            valid = false
            required_types.push(wanted ?? Type.Named{name: "Unit"})
            next
        }
        value: checked
        axis_type := if value.ty == {
            .Named(name) -> sema_expression_layout_is_axis_type(name)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        if sema_expression_layout_method_axis_arg(method, index) && !axis_type {
            sema_expression_layout_axis_argument_mismatch(owner, method, value.ty, argument.span, diagnostics)
            valid = false
        }
        if wanted == .Val(required) && !type_identity_equal(value.ty, required) {
            sema_expression_layout_argument_mismatch(owner, method, required, value.ty, argument.span, diagnostics)
            valid = false
        }
        values.push(value.copy())
        required_types.push(wanted ?? value.ty)
    }
    ownership := sema_ownership_check_method_call(state, "{owner}.{method}", receiver, AccessConvention.Read, sema_expression_layout_method_params(required_types), updated_args, scopes, span, diagnostics)
    if !ownership.accepted || !ownership.complete -> valid = false
    if !valid -> return SemaMethodSpecialCheck{handled: true, value: None}
    value: sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: THandleOp.LayoutMethod{method: method}, args: values}, span)
    if !sema_effect_record_intrinsic_fact(environment, program, scopes, context, "{owner}.{method}", span, sema_expression_layout_call_facts(result_type), diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

// `name: Layout{ … }` (Rust Stmt::Layout): `name` is a
// fresh layout handle in the enclosing scope, and every element of the body
// (the parser rewrote its `box.anchor` reads to `name.h` / `name.v` calls)
// is a Constraint, which registers with the handle as it is built (E2933
// otherwise).
sema_stmt_check_layout: fn(name: String, name_span: Span, body: [Stmt], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], output: &[TStmt]) -> Bool {
    layout_ty: Type.Named{name: "Layout"}
    owner: sema_scope_local_owner_key(scopes)
    id: symbol_id(SymbolKind.Local, environment.module_identity, owner, name)
    symbol: Symbol{id: id, kind: SymbolKind.Local, name: name, module_name: environment.module_identity, owner: Val(owner), span: name_span, ty: Val(layout_ty), visibility: 0}
    if !sema_scope_declare_local(scopes, symbol, false, AccessConvention.Read, None, false) {
        diagnostics.push(sema_already_defined(name, name_span))
        return false
    }
    sema_ownership_declare_binding(state, symbol, false)
    complete := true
    checked := [TStmt]{}
    seen := [String]{}
    loop statement in body {
        if statement == .Expr(expr) {
            value: sema_check_expression(expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
                complete = false
                next
            }
            if value.ty != (Type.Named{name: "Constraint"}) {
                diagnostics.push(sema_error("E2933", expr_span(expr), "This element inside `{name}: Layout.{{ … }}` doesn't produce a constraint (found `{type_name(value.ty)}`)", "Every element inside a `Layout.{{ … }}` body must be a `>=`/`<=`/`==` comparison of layout values (a `Constraint`), comma-separated", "Write a comparison, e.g. `label.width >= 80.0`"))
                complete = false
                next
            }
            if sema_layout_element_key(expr) == .Val(key) {
                if seen.contains(key) {
                    diagnostics.push(sema_lint("E2934", expr_span(expr), "This constraint repeats one already written in this `Layout{{ … }}` body", "An exact duplicate constraint doesn't tighten the layout — it's almost always a copy-paste leftover", "Remove the duplicate line, or change it if a different constraint was meant"))
                } else {
                    seen.push(key)
                }
            }
            checked.push(TStmt.ExprStmt{value: value, span: expr_span(expr)})
        }
    }
    if !complete -> return false
    output.push(TStmt.Layout{handle: checked_symbol_local(name, name_span, id, layout_ty), label: name, body: checked, span: span})
    true
}

// The spelling of a layout element with spans and node ids left out, for
// the duplicate-constraint lint (E2934): equal keys are one constraint.
sema_layout_element_key: fn(expr: Expr) -> String? {
    if expr == {
        .Ident(name, _, _) -> return Val(name)
        .Int(value, _, _, _, _) -> return Val("{value}")
        .Float(value, _, _, _, _) -> return Val("{value}")
        .Paren(value, _, _) -> return sema_layout_element_key(value)
        .Binary(op, left, right, _, _) -> {
            lhs: sema_layout_element_key(left) ?? return None
            rhs: sema_layout_element_key(right) ?? return None
            return Val("({lhs} {sema_expr_binary_name(op)} {rhs})")
        }
        .MethodCall(receiver, method, _, _, _, args, _) -> {
            base: sema_layout_element_key(receiver) ?? return None
            key := "{base}.{method}("
            loop argument in args {
                item: sema_layout_element_key(argument.expr) ?? return None
                key = "{key}{item},"
            }
            return Val("{key})")
        }
        .Str(parts, _, _) -> {
            text := ""
            loop part in parts {
                if part == .Lit(piece) {
                    text = "{text}{piece}"
                } else {
                    return None
                }
            }
            return Val("\"{text}\"")
        }
        .TypedLit(head, body, _, _) -> {
            ty: head ?? return None
            if body == {
                .Value(value) -> {
                    item: sema_layout_element_key(value) ?? return None
                    return Val("{type_name(ty)}{{{item}}}")
                }
                .Elements(elements) -> {
                    if elements.len() != 1 -> return None
                    item: sema_layout_element_key(elements[0]) ?? return None
                    return Val("{type_name(ty)}{{{item}}}")
                }
                .Fields(_) | .Entries(_) | .ByteText(_) | .Empty -> return None
            }
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
}

// `a.width == 200.0` inside a layout: the bare fractional literal compared
// against a layout value is a Float length (Rust lowered the comparison's
// literal side as an f64), not the default Decimal; arithmetic (`+ 8.0`)
// keeps the Decimal default and its E0133.
sema_expr_layout_compare_literal: fn(op: BinOp, lhs: Type, right: Expr) -> Bool Never! {
    if op != BinOp.Ge && op != BinOp.Le && op != BinOp.Eq -> return false
    if !sema_expr_decimal_literal_operand(right, false) -> return false
    if lhs == .Named(name) -> return sema_expression_layout_is_axis_type(name)
    false
}

sema_expression_measurement_inner: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Type? {
    if program.registration_graph == .Val(graph) {
    resolved: sema_type_resolve_declared_with_generics(graph, ty, environment.module_identity, environment.generic_params)
    name: if resolved == {
        .Apply(name, args) -> {
            if args.len() == 1 -> name else -> ""
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> ""
    }
    if name != "Measurement" && name != "core.units::Measurement" && !(core_source_owns_type(name) && core_identity_is(name, "core.units", "Measurement")) -> return None
    nominal_row: sema_type_resolve_nominal_row(graph, resolved, environment.module_identity)
    if nominal_row == .Val(row) {
        if graph.modules[row.module_index].module_name != "core.units" || graph.modules[row.module_index].nominals[row.row].symbol.name != "Measurement" -> return None
    }
    if nominal_row == None && name != "Measurement" && !core_source_owns_type(name) -> return None
    if resolved == {
        .Apply(_, args) -> {
            if args.len() == 1 -> return Val(args[0])
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> {}
    }
    }
    None
}

sema_expression_is_float_measurement: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    inner: sema_expression_measurement_inner(ty, environment, program) ?? return false
    inner == Type.Float
}

sema_expression_measurement_source_call: fn(function: String, values: [TExpr], result_type: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TExpr? {
    source_identity: sema_call_core_module_identity(environment, program, "core.units") ?? return None
    if program.registration_graph == .Val(graph) {
    source_index: sema_registration_module_index(graph, source_identity) ?? return None
    callee: sema_registration_direct_symbol(graph.modules[source_index], function) ?? return None
    callee_id: sema_registration_callable_id(graph, callee.symbol.id.key) ?? return None
    arguments: loop value in values -> TCallArg{value: value, template_items: [SymbolID]{}, borrow: !sema_call_is_scalar(value.ty), mut_borrow: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false}
    // copy: `error` is a payload of read parameter `result_type`, which keeps the original; the list literal owns this one
    type_args: if function == "__measurement_result" && result_type == .Result(_, error) -> [Type]{error.copy()} else -> [Type]{}
    return Val(sema_tree_node(result_type, TExprKind.Call{callee: callee_id, type_args: type_args, args: arguments}, span))
    }
    None
}

sema_call_try_measurement_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != "value" && method != "uncertainty" -> return SemaMethodSpecialCheck{handled: false, value: None}
    _ := sema_expression_measurement_inner(receiver_value.ty, environment, program) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != 0 {
        if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        diagnostics.push(sema_call_arity_diagnostic("Measurement.{method}", 0, args.len(), false, span))
        sema_expression_layout_discard_arguments(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    result_type := Type.Float
    value: sema_expression_measurement_source_call("__measurement_{method}", [TExpr]{receiver_value}, result_type, span, environment, program) ?? {
        context.incomplete_reasons.push("checked Measurement accessor has no source declaration")
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !sema_effect_record_intrinsic_fact(environment, program, scopes, context, "Measurement.{method}", span, sema_expression_layout_call_facts(result_type), diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}
