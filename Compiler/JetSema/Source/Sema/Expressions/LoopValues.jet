// Loop-expression state transitions shared by statement dispatch and inline-loop lowering.
use jet_foundation.[
    AST_EMPTY_CALL_ARG_FLAGS,
    AST_NODE_GENERATED,
    AccessConvention,
    CallArg,
    Diagnostic,
    Expr,
    IndexKind,
    LValue,
    Lambda,
    LambdaBody,
    LambdaParam,
    NamedSpan,
    Span,
    Stmt,
    SwitchArm,
    TBuiltinOp,
    TLetTy,
    TLetWrapper,
    TLocal,
    Type,
    TypedLitBody,
    ast_binding,
    ast_empty_lambda_meta,
    checked_generated_local,
    expr_span,
    type_identity_equal,
    type_name,
]

sema_loop_value_check_result_exit: fn(context: ^SemaCheckContext, frame_index: Int, value: TExpr, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: ^[Diagnostic]) -> TExpr? {
    frame: if frame_index >= 0 && frame_index < context.loop_value_frames.len() -> Val(context.loop_value_frames[frame_index]) else -> None
    target: frame ?? return None
    if target.kind != SemaLoopValueKind.Result -> return None
    if target.ty == None {
        sema_loop_value_set_result_type(context, frame_index, value.ty)
        return Val(value)
    }
    expected: target.ty ?? value.ty
    if type_identity_equal(expected, value.ty) -> return Val(value)
    common: sema_expr_numeric_join(expected, value.ty) ?? {
        diagnostics.push(sema_error("E0076", value.span, "this loop breaks with `{type_name(value.ty)}`, but another exit uses `{type_name(expected)}`", "an ordinary loop used as a value has one result type", "make every break payload use the same type"))
        return None
    }
    sema_loop_value_set_result_type(context, frame_index, common)
    if type_identity_equal(common, value.ty) -> return Val(value)
    if sema_expr_numeric_value_widening(value, common) == (Val(true)) {
        line: sema_source_line_at(environment.source_segments, value.span) ?? 0
        return sema_expr_numeric_literal_conversion(value, common, value.span, line, diagnostics)
    }
    Val(value)
}

sema_loop_value_check_collecting_item: fn(value: Expr, span: Span, check: ^SemaBodyCheck) -> TExpr? {
    if check.context.collect_item_types.len() == 0 -> return None
    expected := sema_loop_value_collecting_type(check.context)
    checked_expected := expected
    if expected == .Val(expected_type) && sema_expr_is_numeric(expected_type) {
        checked_expected = None
    }
    outer_item_if: check.context.collect_item_if
    check.context.collect_item_if = if value == .If(_, _, _, _, _, _, _) -> Val(span) else -> None
    checked_value: sema_check_expression(value, checked_expected, check)
    check.context.collect_item_if = outer_item_if
    checked: checked_value ?? return None
    if checked.ty == (Type.Named{name: "Unit"}) {
        check.diagnostics.push(sema_error("E0073", span, "this collecting loop path produces no item", "every accepted iteration must contribute one non-unit value unless `next` omits it", "return a value on this path, or remove `->`"))
        return None
    }
    if expected == None {
        sema_loop_value_set_collecting_type(check.context, checked.ty)
        return Val(checked)
    }
    required: expected ?? checked.ty
    if type_identity_equal(required, checked.ty) -> return Val(checked)
    common: sema_expr_numeric_join(required, checked.ty) ?? {
        check.diagnostics.push(sema_error("E0074", span, "this collecting loop produces incompatible item types", "one collecting loop builds one List, but this item is `{type_name(checked.ty)}` instead of `{type_name(required)}`", "convert every item to one type, or split the loops"))
        return None
    }
    sema_loop_value_set_collecting_type(check.context, common)
    if type_identity_equal(common, checked.ty) -> return Val(checked)
    if sema_expr_numeric_value_widening(checked, common) == (Val(true)) {
        line: sema_source_line_at(check.environment.source_segments, checked.span) ?? 0
        return sema_expr_numeric_literal_conversion(checked, common, checked.span, line, check.diagnostics)
    }
    Val(checked)
}

sema_loop_value_collect_local_expr: fn(local: TLocal, item_type: Type, span: Span) -> TExpr Never! {
    sema_tree_node(Type.List{element: item_type}, TExprKind.Local{local: local}, span)
}

sema_loop_value_collect_push: fn(local: TLocal, item_type: Type, value: TExpr, span: Span) -> TStmt Never! {
    receiver: sema_loop_value_collect_local_expr(local, item_type, span)
    call := sema_tree_node(Type.Named{name: "Unit"}, TExprKind.BuiltinMethod{receiver: receiver, operation: TBuiltinOp.Push, args: [TExpr]{value}}, span)
    TStmt.ExprStmt{value: call, span: span}
}

sema_loop_value_collect_widen: fn(value: TExpr, item_type: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: ^[Diagnostic]) -> TExpr? {
    if type_identity_equal(value.ty, item_type) -> return Val(value)
    if sema_expr_numeric_value_widening(value, item_type) != (Val(true)) -> return None
    line: sema_source_line_at(environment.source_segments, value.span) ?? 0
    sema_expr_numeric_literal_conversion(value, item_type, value.span, line, diagnostics)
}

sema_loop_value_rewrite_collecting_statements: fn(statements: ^[TStmt], local: TLocal, item_type: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: ^[Diagnostic]) -> Bool Never! {
    index := 0
    loop index < statements.len() {
        statement := statements[index]
        if statement == {
            .ExprStmt(value, span) -> {
                if span.start == span.end {
                    widened: sema_loop_value_collect_widen(value, item_type, environment, program, diagnostics) ?? return false
                    statements[index] = sema_loop_value_collect_push(local, item_type, widened, span)
                }
            }
            .CountedLoop(label, init, condition, step, vectorization, body, span) -> {
                updated_body := body
                if !sema_loop_value_rewrite_collecting_statements(updated_body, local, item_type, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.CountedLoop{label: label, init: init, condition: condition, step: step, vectorization: vectorization, body: updated_body, span: span}
            }
            .ForRange(label, variable, start, end, step, exclusive, body, vectorization, span) -> {
                updated_body := body
                if !sema_loop_value_rewrite_collecting_statements(updated_body, local, item_type, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.ForRange{label: label, local: variable, start: start, end: end, step: step, exclusive: exclusive, body: updated_body, vectorization: vectorization, span: span}
            }
            .Range(label, variable, source, start, end, step, exclusive, vectorization, body, span) -> {
                updated_body := body
                if !sema_loop_value_rewrite_collecting_statements(updated_body, local, item_type, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.Range{label: label, variable: variable, source: source, start: start, end: end, step: step, exclusive: exclusive, vectorization: vectorization, body: updated_body, span: span}
            }
            .ForIn(label, variable, variable_two, source, collection, step, method_kind, columnar, by_value, source_stable, body, span) -> {
                updated_body := body
                if !sema_loop_value_rewrite_collecting_statements(updated_body, local, item_type, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.ForIn{label: label, variable: variable, variable_two: variable_two, source: source, collection: collection, step: step, method_kind: method_kind, columnar: columnar, by_value: by_value, source_stable: source_stable, body: updated_body, span: span}
            }
            .While(label, condition, body, span) -> {
                updated_body := body
                if !sema_loop_value_rewrite_collecting_statements(updated_body, local, item_type, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.While{label: label, condition: condition, body: updated_body, span: span}
            }
            .Loop(label, body, span) -> {
                updated_body := body
                if !sema_loop_value_rewrite_collecting_statements(updated_body, local, item_type, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.Loop{label: label, body: updated_body, span: span}
            }
            .If(condition, then_body, else_body, else_is_elseif, span) -> {
                updated_then_body := then_body
                if !sema_loop_value_rewrite_collecting_statements(updated_then_body, local, item_type, environment, program, diagnostics) {
                    return false
                }
                updated_else_body := else_body.copy()
                if else_body == .Val(else_statements) {
                    rewritten := else_statements.copy()
                    if !sema_loop_value_rewrite_collecting_statements(rewritten, local, item_type, environment, program, diagnostics) {
                        return false
                    }
                    updated_else_body = Val(rewritten)
                }
                statements[index] = TStmt.If{condition: condition, then_body: updated_then_body, else_body: updated_else_body, else_is_elseif: else_is_elseif, span: span}
            }
            .Match(subject, arms, exhaustive, span) -> {
                updated_arms := arms.copy()
                loop arm_index in 0..<updated_arms.len() {
                    arm_body := updated_arms[arm_index].body
                    if !sema_loop_value_rewrite_collecting_statements(arm_body, local, item_type, environment, program, diagnostics) {
                        return false
                    }
                    updated_arms[arm_index].body = arm_body
                }
                statements[index] = TStmt.Match{subject: subject, arms: updated_arms, exhaustive: exhaustive, span: span}
            }
            .EnumMatch(subject, arms, else_body, fallthrough, span) -> {
                updated_arms := arms.copy()
                loop arm_index in 0..<updated_arms.len() {
                    arm_body := updated_arms[arm_index].body
                    if !sema_loop_value_rewrite_collecting_statements(arm_body, local, item_type, environment, program, diagnostics) {
                        return false
                    }
                    updated_arms[arm_index].body = arm_body
                }
                updated_else_body := else_body.copy()
                if else_body == .Val(else_statements) {
                    rewritten := else_statements.copy()
                    if !sema_loop_value_rewrite_collecting_statements(rewritten, local, item_type, environment, program, diagnostics) {
                        return false
                    }
                    updated_else_body = Val(rewritten)
                }
                statements[index] = TStmt.EnumMatch{scrutinee: subject, arms: updated_arms, else_body: updated_else_body, fallthrough: fallthrough, span: span}
            }
            .RangeSwitch(subject, arms, else_body, span) -> {
                updated_else_body := else_body
                updated_arms := arms.copy()
                loop arm_index in 0..<updated_arms.len() {
                    arm_body := updated_arms[arm_index].body
                    if !sema_loop_value_rewrite_collecting_statements(arm_body, local, item_type, environment, program, diagnostics) {
                        return false
                    }
                    updated_arms[arm_index].body = arm_body
                }
                if !sema_loop_value_rewrite_collecting_statements(updated_else_body, local, item_type, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.RangeSwitch{subject: subject, arms: updated_arms, else_body: updated_else_body, span: span}
            }
            .MixedSwitch(subject, branch_class, arms, else_body, span) -> {
                updated_arms := arms.copy()
                loop arm_index in 0..<updated_arms.len() {
                    arm_body := updated_arms[arm_index].body
                    if !sema_loop_value_rewrite_collecting_statements(arm_body, local, item_type, environment, program, diagnostics) {
                        return false
                    }
                    updated_arms[arm_index].body = arm_body
                }
                updated_else_body := else_body.copy()
                if else_body == .Val(else_statements) {
                    rewritten := else_statements.copy()
                    if !sema_loop_value_rewrite_collecting_statements(rewritten, local, item_type, environment, program, diagnostics) {
                        return false
                    }
                    updated_else_body = Val(rewritten)
                }
                statements[index] = TStmt.MixedSwitch{subject: subject, class: branch_class, arms: updated_arms, else_body: updated_else_body, span: span}
            }
            .RefutableBind(pattern, init, fallback, span) -> {
                updated_fallback := fallback
                if !sema_loop_value_rewrite_collecting_statements(updated_fallback, local, item_type, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.RefutableBind{pattern: pattern, init: init, fallback: updated_fallback, span: span}
            }
            .ContractScope(pre, body, post, result, span) -> {
                updated_body := body
                if !sema_loop_value_rewrite_collecting_statements(updated_body, local, item_type, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.ContractScope{pre: pre, body: updated_body, post: post, result: result, span: span}
            }
            .TaskGroup(group, args, body, span) -> {
                updated_body := body
                if !sema_loop_value_rewrite_collecting_statements(updated_body, local, item_type, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.TaskGroup{group: group, args: args, body: updated_body, span: span}
            }
            .Layout(handle, label, body, span) -> {
                updated_body := body
                if !sema_loop_value_rewrite_collecting_statements(updated_body, local, item_type, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.Layout{handle: handle, label: label, body: updated_body, span: span}
            }
            .ContextBlock(guards, body, span) -> {
                updated_body := body
                if !sema_loop_value_rewrite_collecting_statements(updated_body, local, item_type, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.ContextBlock{guards: guards, body: updated_body, span: span}
            }
            .GCEdit(root, slot, edges, replace_all, index_temp, nested, span) -> {
                nested_body := [TStmt]{nested}
                if !sema_loop_value_rewrite_collecting_statements(nested_body, local, item_type, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.GCEdit{root: root, slot: slot, edges: edges, replace_all: replace_all, index_temp: index_temp, statement: nested_body[0], span: span}
            }
            .Unsafe(gate, body) -> {
                updated_body := body
                if !sema_loop_value_rewrite_collecting_statements(updated_body, local, item_type, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.Unsafe{gate: gate, body: updated_body}
            }
            .Inline(body, span) | .DebugOnly(body, span) | .DeepCheck(body, span) | .UnsafeBlock(_, body, span) | .SentryPolicy(_, body, span) | .Impure(body, span) | .Region(body, span) | .Live(body, span) | .Shield(body, span) | .Defer(body, span) | .ScopeMember(_, body, span) -> {
                updated_body := body
                if !sema_loop_value_rewrite_collecting_statements(updated_body, local, item_type, environment, program, diagnostics) {
                    return false
                }
                if statement == {
                    .Inline(_, _) -> {
                        statements[index] = TStmt.Inline{body: updated_body, span: span}
                    }
                    .DebugOnly(_, _) -> {
                        statements[index] = TStmt.DebugOnly{body: updated_body, span: span}
                    }
                    .DeepCheck(_, _) -> {
                        statements[index] = TStmt.DeepCheck{body: updated_body, span: span}
                    }
                    .UnsafeBlock(gate, _, _) -> {
                        statements[index] = TStmt.UnsafeBlock{gate: gate, body: updated_body, span: span}
                    }
                    .SentryPolicy(enabled, _, _) -> {
                        statements[index] = TStmt.SentryPolicy{enabled: enabled, body: updated_body, span: span}
                    }
                    .Impure(_, _) -> {
                        statements[index] = TStmt.Impure{body: updated_body, span: span}
                    }
                    .Region(_, _) -> {
                        statements[index] = TStmt.Region{body: updated_body, span: span}
                    }
                    .Live(_, _) -> {
                        statements[index] = TStmt.Live{body: updated_body, span: span}
                    }
                    .Shield(_, _) -> {
                        statements[index] = TStmt.Shield{body: updated_body, span: span}
                    }
                    .Defer(_, _) -> {
                        statements[index] = TStmt.Defer{body: updated_body, span: span}
                    }
                    .ScopeMember(kind, _, _) -> {
                        statements[index] = TStmt.ScopeMember{kind: kind, body: updated_body, span: span}
                    }
                    .Contract(_) | .ContractScope(_, _, _, _, _) | .Let(_, _, _, _, _, _) | .RefutableBind(_, _, _, _) | .TupleDestructure(_, _, _, _, _) | .StructDestructure(_, _, _, _, _) | .ListDestructure(_, _, _, _, _, _) | .Assign(_, _, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .ForRange(_, _, _, _, _, _, _, _, _) | .Range(_, _, _, _, _, _, _, _, _, _) | .ExprStmt(_, _) | .Return(_, _) | .TaskGroup(_, _, _, _) | .DeferClose(_, _, _) | .If(_, _, _, _, _) | .Loop(_, _, _) | .While(_, _, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) | .Match(_, _, _, _) | .EnumMatch(_, _, _, _, _) | .RangeSwitch(_, _, _, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, _, _) | .MixedSwitch(_, _, _, _, _) | .Unsafe(_, _) | .Reactive(_, _) | .Layout(_, _, _, _) | .ContextBlock(_, _, _) | .Transact(_, _, _, _, _) | .GCEdit(_, _, _, _, _, _, _) -> {}
                }
            }
            .Transact(handle, snapshots, stm, body, span) -> {
                updated_body := body
                if !sema_loop_value_rewrite_collecting_statements(updated_body, local, item_type, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.Transact{handle: handle, snapshots: snapshots, stm: stm, body: updated_body, span: span}
            }
            .Contract(_) | .Let(_, _, _, _, _, _) | .TupleDestructure(_, _, _, _, _) | .StructDestructure(_, _, _, _, _) | .ListDestructure(_, _, _, _, _, _) | .Assign(_, _, _, _, _) | .Return(_, _) | .DeferClose(_, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) | .Reactive(_, _) -> {}
        }
        index += 1
    }
    true
}

sema_loop_value_lower_collecting_body: fn(body: [TStmt], item_type: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: ^[Diagnostic]) -> [TStmt]? {
    collector_type := Type.List{element: item_type}
    local := checked_generated_local("__jet_collect_{span.start}", span, collector_type)
    local.mutable = true
    empty := sema_tree_node(collector_type, TExprKind.List{values: [TExpr]{}, trait_coercion: None}, span)
    lowered := [TStmt]{TStmt.Let{local: local, let_ty: TLetTy.Annotated{ty: collector_type, wrapper: TLetWrapper.Plain}, init: empty, gc_promotion: None, gc_transferred: false, span: span}}
    loop statement in body -> lowered.push(statement.copy())
    if !sema_loop_value_rewrite_collecting_statements(lowered, local, item_type, environment, program, diagnostics) {
        return None
    }
    result := sema_loop_value_collect_local_expr(local, item_type, span)
    lowered.push(TStmt.ExprStmt{value: result, span: span})
    Val(lowered)
}

sema_loop_value_result_exit_matches: fn(label: String?, root_label: String?, allow_unlabeled: Bool) -> Bool Never! {
    if label == .Val(name) -> return root_label == (Val(name))
    allow_unlabeled && root_label == None
}

sema_loop_value_widen_result_breaks_in: fn(statements: ^[TStmt], root_label: String?, result_type: Type, allow_unlabeled: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: ^[Diagnostic]) -> Bool {
    index := 0
    loop index < statements.len() {
        statement := statements[index]
        if statement == {
            .BreakValue(label, value, span) -> {
                if sema_loop_value_result_exit_matches(label, root_label, allow_unlabeled) && !type_identity_equal(value.ty, result_type) {
                    if sema_expr_numeric_value_widening(value, result_type) != (Val(true)) {
                        diagnostics.push(sema_error("E0076", value.span, "this loop breaks with `{type_name(value.ty)}`, but another exit uses `{type_name(result_type)}`", "an ordinary loop used as a value has one result type", "make every break payload use the same type"))
                        return false
                    }
                    line: sema_source_line_at(environment.source_segments, value.span) ?? 0
                    widened: sema_expr_numeric_literal_conversion(value, result_type, value.span, line, diagnostics) ?? return false
                    statements[index] = TStmt.BreakValue{label: label, value: widened, span: span}
                }
            }
            .CountedLoop(label, init, condition, step, vectorization, body, span) -> {
                updated_body := body
                if !sema_loop_value_widen_result_breaks_in(updated_body, root_label, result_type, false, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.CountedLoop{label: label, init: init, condition: condition, step: step, vectorization: vectorization, body: updated_body, span: span}
            }
            .ForRange(label, variable, start, end, step, exclusive, body, vectorization, span) -> {
                updated_body := body
                if !sema_loop_value_widen_result_breaks_in(updated_body, root_label, result_type, false, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.ForRange{label: label, local: variable, start: start, end: end, step: step, exclusive: exclusive, body: updated_body, vectorization: vectorization, span: span}
            }
            .Range(label, variable, source, start, end, step, exclusive, vectorization, body, span) -> {
                updated_body := body
                if !sema_loop_value_widen_result_breaks_in(updated_body, root_label, result_type, false, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.Range{label: label, variable: variable, source: source, start: start, end: end, step: step, exclusive: exclusive, vectorization: vectorization, body: updated_body, span: span}
            }
            .ForIn(label, variable, variable_two, source, collection, step, method_kind, columnar, by_value, source_stable, body, span) -> {
                updated_body := body
                if !sema_loop_value_widen_result_breaks_in(updated_body, root_label, result_type, false, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.ForIn{label: label, variable: variable, variable_two: variable_two, source: source, collection: collection, step: step, method_kind: method_kind, columnar: columnar, by_value: by_value, source_stable: source_stable, body: updated_body, span: span}
            }
            .While(label, condition, body, span) -> {
                updated_body := body
                if !sema_loop_value_widen_result_breaks_in(updated_body, root_label, result_type, false, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.While{label: label, condition: condition, body: updated_body, span: span}
            }
            .Loop(label, body, span) -> {
                updated_body := body
                if !sema_loop_value_widen_result_breaks_in(updated_body, root_label, result_type, false, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.Loop{label: label, body: updated_body, span: span}
            }
            .If(condition, then_body, else_body, else_is_elseif, span) -> {
                updated_then_body := then_body
                if !sema_loop_value_widen_result_breaks_in(updated_then_body, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                    return false
                }
                updated_else_body := else_body.copy()
                if else_body == .Val(else_statements) {
                    rewritten := else_statements.copy()
                    if !sema_loop_value_widen_result_breaks_in(rewritten, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                        return false
                    }
                    updated_else_body = Val(rewritten)
                }
                statements[index] = TStmt.If{condition: condition, then_body: updated_then_body, else_body: updated_else_body, else_is_elseif: else_is_elseif, span: span}
            }
            .Match(subject, arms, exhaustive, span) -> {
                updated_arms := arms.copy()
                loop arm_index in 0..<updated_arms.len() {
                    arm_body := updated_arms[arm_index].body
                    if !sema_loop_value_widen_result_breaks_in(arm_body, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                        return false
                    }
                    updated_arms[arm_index].body = arm_body
                }
                statements[index] = TStmt.Match{subject: subject, arms: updated_arms, exhaustive: exhaustive, span: span}
            }
            .EnumMatch(subject, arms, else_body, fallthrough, span) -> {
                updated_arms := arms.copy()
                loop arm_index in 0..<updated_arms.len() {
                    arm_body := updated_arms[arm_index].body
                    if !sema_loop_value_widen_result_breaks_in(arm_body, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                        return false
                    }
                    updated_arms[arm_index].body = arm_body
                }
                updated_else_body := else_body.copy()
                if else_body == .Val(else_statements) {
                    rewritten := else_statements.copy()
                    if !sema_loop_value_widen_result_breaks_in(rewritten, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                        return false
                    }
                    updated_else_body = Val(rewritten)
                }
                statements[index] = TStmt.EnumMatch{scrutinee: subject, arms: updated_arms, else_body: updated_else_body, fallthrough: fallthrough, span: span}
            }
            .RangeSwitch(subject, arms, else_body, span) -> {
                updated_else_body := else_body
                updated_arms := arms.copy()
                loop arm_index in 0..<updated_arms.len() {
                    arm_body := updated_arms[arm_index].body
                    if !sema_loop_value_widen_result_breaks_in(arm_body, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                        return false
                    }
                    updated_arms[arm_index].body = arm_body
                }
                if !sema_loop_value_widen_result_breaks_in(updated_else_body, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.RangeSwitch{subject: subject, arms: updated_arms, else_body: updated_else_body, span: span}
            }
            .MixedSwitch(subject, branch_class, arms, else_body, span) -> {
                updated_arms := arms.copy()
                loop arm_index in 0..<updated_arms.len() {
                    arm_body := updated_arms[arm_index].body
                    if !sema_loop_value_widen_result_breaks_in(arm_body, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                        return false
                    }
                    updated_arms[arm_index].body = arm_body
                }
                updated_else_body := else_body.copy()
                if else_body == .Val(else_statements) {
                    rewritten := else_statements.copy()
                    if !sema_loop_value_widen_result_breaks_in(rewritten, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                        return false
                    }
                    updated_else_body = Val(rewritten)
                }
                statements[index] = TStmt.MixedSwitch{subject: subject, class: branch_class, arms: updated_arms, else_body: updated_else_body, span: span}
            }
            .RefutableBind(pattern, init, fallback, span) -> {
                updated_fallback := fallback
                if !sema_loop_value_widen_result_breaks_in(updated_fallback, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.RefutableBind{pattern: pattern, init: init, fallback: updated_fallback, span: span}
            }
            .ContractScope(pre, body, post, result, span) -> {
                updated_body := body
                if !sema_loop_value_widen_result_breaks_in(updated_body, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.ContractScope{pre: pre, body: updated_body, post: post, result: result, span: span}
            }
            .TaskGroup(group, args, body, span) -> {
                updated_body := body
                if !sema_loop_value_widen_result_breaks_in(updated_body, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.TaskGroup{group: group, args: args, body: updated_body, span: span}
            }
            .Layout(handle, label, body, span) -> {
                updated_body := body
                if !sema_loop_value_widen_result_breaks_in(updated_body, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.Layout{handle: handle, label: label, body: updated_body, span: span}
            }
            .ContextBlock(guards, body, span) -> {
                updated_body := body
                if !sema_loop_value_widen_result_breaks_in(updated_body, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.ContextBlock{guards: guards, body: updated_body, span: span}
            }
            .GCEdit(root, slot, edges, replace_all, index_temp, nested, span) -> {
                nested_body := [TStmt]{nested}
                if !sema_loop_value_widen_result_breaks_in(nested_body, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.GCEdit{root: root, slot: slot, edges: edges, replace_all: replace_all, index_temp: index_temp, statement: nested_body[0], span: span}
            }
            .Inline(body, span) | .DebugOnly(body, span) | .DeepCheck(body, span) | .UnsafeBlock(_, body, span) | .SentryPolicy(_, body, span) | .Impure(body, span) | .Region(body, span) | .Live(body, span) | .Shield(body, span) | .Defer(body, span) | .ScopeMember(_, body, span) -> {
                updated_body := body
                if !sema_loop_value_widen_result_breaks_in(updated_body, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                    return false
                }
                if statement == {
                    .Inline(_, _) -> {
                        statements[index] = TStmt.Inline{body: updated_body, span: span}
                    }
                    .DebugOnly(_, _) -> {
                        statements[index] = TStmt.DebugOnly{body: updated_body, span: span}
                    }
                    .DeepCheck(_, _) -> {
                        statements[index] = TStmt.DeepCheck{body: updated_body, span: span}
                    }
                    .UnsafeBlock(gate, _, _) -> {
                        statements[index] = TStmt.UnsafeBlock{gate: gate, body: updated_body, span: span}
                    }
                    .SentryPolicy(enabled, _, _) -> {
                        statements[index] = TStmt.SentryPolicy{enabled: enabled, body: updated_body, span: span}
                    }
                    .Impure(_, _) -> {
                        statements[index] = TStmt.Impure{body: updated_body, span: span}
                    }
                    .Region(_, _) -> {
                        statements[index] = TStmt.Region{body: updated_body, span: span}
                    }
                    .Live(_, _) -> {
                        statements[index] = TStmt.Live{body: updated_body, span: span}
                    }
                    .Shield(_, _) -> {
                        statements[index] = TStmt.Shield{body: updated_body, span: span}
                    }
                    .Defer(_, _) -> {
                        statements[index] = TStmt.Defer{body: updated_body, span: span}
                    }
                    .ScopeMember(kind, _, _) -> {
                        statements[index] = TStmt.ScopeMember{kind: kind, body: updated_body, span: span}
                    }
                    .Contract(_) | .ContractScope(_, _, _, _, _) | .Let(_, _, _, _, _, _) | .RefutableBind(_, _, _, _) | .TupleDestructure(_, _, _, _, _) | .StructDestructure(_, _, _, _, _) | .ListDestructure(_, _, _, _, _, _) | .Assign(_, _, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .ForRange(_, _, _, _, _, _, _, _, _) | .Range(_, _, _, _, _, _, _, _, _, _) | .ExprStmt(_, _) | .Return(_, _) | .TaskGroup(_, _, _, _) | .DeferClose(_, _, _) | .If(_, _, _, _, _) | .Loop(_, _, _) | .While(_, _, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) | .Match(_, _, _, _) | .EnumMatch(_, _, _, _, _) | .RangeSwitch(_, _, _, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, _, _) | .MixedSwitch(_, _, _, _, _) | .Unsafe(_, _) | .Reactive(_, _) | .Layout(_, _, _, _) | .ContextBlock(_, _, _) | .Transact(_, _, _, _, _) | .GCEdit(_, _, _, _, _, _, _) -> {}
                }
            }
            .Unsafe(gate, body) -> {
                updated_body := body
                if !sema_loop_value_widen_result_breaks_in(updated_body, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.Unsafe{gate: gate, body: updated_body}
            }
            .Transact(handle, snapshots, stm, body, span) -> {
                updated_body := body
                if !sema_loop_value_widen_result_breaks_in(updated_body, root_label, result_type, allow_unlabeled, environment, program, diagnostics) {
                    return false
                }
                statements[index] = TStmt.Transact{handle: handle, snapshots: snapshots, stm: stm, body: updated_body, span: span}
            }
            .Contract(_) | .Let(_, _, _, _, _, _) | .TupleDestructure(_, _, _, _, _) | .StructDestructure(_, _, _, _, _) | .ListDestructure(_, _, _, _, _, _) | .Assign(_, _, _, _, _) | .ExprStmt(_, _) | .Return(_, _) | .DeferClose(_, _, _) | .Break(_, _) | .Continue(_, _) | .Reactive(_, _) -> {}
        }
        index += 1
    }
    true
}

sema_loop_value_widen_result_breaks: fn(body: ^[TStmt], root_label: String?, result_type: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: ^[Diagnostic]) -> Bool {
    sema_loop_value_widen_result_breaks_in(body, root_label, result_type, true, environment, program, diagnostics)
}

// A set or map head written around one collecting loop builds that collection
// from the loop's items, in loop order: `Set<Int>{loop n in counts -> n}`.
// A map loop's item is the head's own `key: value` form. The parser reads it
// as one entry keyed by the loop (`[Int: Int]{loop n in counts -> n: n * n}`),
// and each item sets its key, so a later key replaces an earlier one. A list
// head needs none of this, because its loop's List is already the value. The
// head is checked as the value loop it means:
// `loop { head := <empty head>; <the loop, adding each item to head>; break head }`.
// Copies: the parts come from the read parameter `body`, and the generated
// tree owns its own.
sema_loop_value_typed_head: fn(result_head: Type, body: TypedLitBody, span: Span) -> Expr? Never! {
    loop_body := [Stmt]?{None}
    entry_value := Expr?{None}
    empty := Expr?{None}
    if result_head == {
        .Map(_, _, _) -> {
            if body == .Entries(entries) && entries.len() == 1 {
                loop_body = sema_loop_value_collecting_body(entries[0].key)
                if loop_body != None {
                    entry_value = Val(entries[0].value.copy())
                    empty = Val(Expr.TypedLit{head: Val(result_head.copy()), body: TypedLitBody.Empty, span: span, id: AST_NODE_GENERATED})
                }
            }
        }
        .Apply(name, args) -> {
            if name == "Set" && args.len() == 1 && body == .Value(value) {
                loop_body = sema_loop_value_collecting_body(value)
                if loop_body != None {
                    empty = Val(Expr.MethodCall{receiver: Expr.Ident{name: "Set", span: span, id: AST_NODE_GENERATED}, method: "new", method_span: span, owner_type_args: args.copy(), type_args: [Type]{}, args: [CallArg]{}, id: AST_NODE_GENERATED})
                }
            }
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    filled := loop_body ?? return None
    head_name: "__jet_head_{span.start}"
    head: Expr.Ident{name: head_name, span: span, id: AST_NODE_GENERATED}
    sema_loop_value_head_items(filled, head, entry_value)
    statements := [Stmt]{Stmt.Val{binding: ast_binding(head_name, span, true, empty ?? return None, Val(span))}}
    loop statement in filled -> statements.push(statement)
    statements.push(Stmt.BreakValue{value: head, span: span})
    meta := ast_empty_lambda_meta()
    meta.result_loop = true
    value_loop: Stmt.Loop{body: statements, span: span, arrow_body: false, label: None}
    lambda: Lambda{take_names: [NamedSpan]{}, params: [LambdaParam]{}, effects: None, body: LambdaBody.Block{body: [Stmt]{value_loop}}, span: span, meta: meta}
    Val(Expr.CallValue{callee: Expr.Lambda{lambda: lambda, id: AST_NODE_GENERATED}, args: [CallArg]{}, span: span, id: AST_NODE_GENERATED})
}

// The statements of a parsed collecting loop (`loop … -> item`), which the
// parser builds as a call of a no-parameter lambda.
sema_loop_value_collecting_body: fn(value: Expr) -> [Stmt]? Never! {
    if value == .CallValue(callee, _, _, _) {
        if callee == .Lambda(lambda, _) {
            if lambda.meta.collecting_loop && lambda.params.len() == 0 && lambda.body == .Block(statements) {
                return Val(statements.copy())
            }
        }
    }
    None
}

// Each item a collecting loop yields becomes an addition to `head`:
// `head.add(item)` for a set, `head[item] = value` for a map, where `value` is
// the entry's value. Every nested block is walked, loops included, because a
// `yield` there still feeds this loop. Nested loop values are expressions and
// keep their own items.
sema_loop_value_head_items: fn(statements: ^[Stmt], head: Expr, entry_value: Expr?) Never! {
    loop index in 0..<statements.len() {
        // An owned copy, so its nested bodies can move into the rebuilt statement.
        statement := statements[index]
        if statement == {
            .Yield(item, _) -> {
                item_span: expr_span(item)
                statements[index] = if entry_value == {
                    .Val(value) -> Stmt.Assign{target: LValue.Index{base: head.copy(), index: item, span: item_span, kind: IndexKind.Unknown}, op: None, op_span: item_span, value: value.copy()}
                    .None -> {
                        argument: CallArg{convention: AccessConvention.Read, expr: item, span: item_span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
                        Stmt.Expr{expr: Expr.MethodCall{receiver: head.copy(), method: "add", method_span: item_span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{argument}, id: AST_NODE_GENERATED}}
                    }
                }
            }
            .While(cond, body, span, arrow_body, label) -> {
                statements[index] = Stmt.While{cond: cond, body: sema_loop_value_head_items_in(body, head, entry_value), span: span, arrow_body: arrow_body, label: label}
            }
            .For(var, var_span, var2, kind, body, span, arrow_body, label, auto_vectorization) -> {
                statements[index] = Stmt.For{var: var, var_span: var_span, var2: var2, kind: kind, body: sema_loop_value_head_items_in(body, head, entry_value), span: span, arrow_body: arrow_body, label: label, auto_vectorization: auto_vectorization}
            }
            .Loop(body, span, arrow_body, label) -> {
                statements[index] = Stmt.Loop{body: sema_loop_value_head_items_in(body, head, entry_value), span: span, arrow_body: arrow_body, label: label}
            }
            .CountedLoop(init, cond, step, body, span, arrow_body, label) -> {
                statements[index] = Stmt.CountedLoop{init: init, cond: cond, step: step, body: sema_loop_value_head_items_in(body, head, entry_value), span: span, arrow_body: arrow_body, label: label}
            }
            .Switch(subject, arms, else_body, span) -> {
                statements[index] = Stmt.Switch{subject: subject, arms: sema_loop_value_head_items_arms(arms, head, entry_value), else_body: sema_loop_value_head_items_else(else_body, head, entry_value), span: span}
            }
            .ComptimeSwitch(subject, arms, else_body, span) -> {
                statements[index] = Stmt.ComptimeSwitch{subject: subject, arms: sema_loop_value_head_items_arms(arms, head, entry_value), else_body: sema_loop_value_head_items_else(else_body, head, entry_value), span: span}
            }
            .ComptimeIf(cond, cond_span, then_body, else_body, span, selected_then) -> {
                statements[index] = Stmt.ComptimeIf{cond: cond, cond_span: cond_span, then_body: sema_loop_value_head_items_in(then_body, head, entry_value), else_body: sema_loop_value_head_items_else(else_body, head, entry_value), span: span, selected_then: selected_then}
            }
            .Unsafe(audit, audit_expr, body, span) -> {
                statements[index] = Stmt.Unsafe{audit: audit, audit_expr: audit_expr, body: sema_loop_value_head_items_in(body, head, entry_value), span: span}
            }
            .Impure(reason, reason_expr, body, span) -> {
                statements[index] = Stmt.Impure{reason: reason, reason_expr: reason_expr, body: sema_loop_value_head_items_in(body, head, entry_value), span: span}
            }
            .Reactive(body, span) -> {
                statements[index] = Stmt.Reactive{body: sema_loop_value_head_items_in(body, head, entry_value), span: span}
            }
            .Shield(body, span) -> {
                statements[index] = Stmt.Shield{body: sema_loop_value_head_items_in(body, head, entry_value), span: span}
            }
            .Defer(body, span) -> {
                statements[index] = Stmt.Defer{body: sema_loop_value_head_items_in(body, head, entry_value), span: span}
            }
            .Switched(marker, body, span) -> {
                statements[index] = Stmt.Switched{marker: marker, body: sema_loop_value_head_items_in(body, head, entry_value), span: span}
            }
            .Region(name, name_span, body, span) -> {
                statements[index] = Stmt.Region{name: name, name_span: name_span, body: sema_loop_value_head_items_in(body, head, entry_value), span: span}
            }
            .Policy(declarations, body, span) -> {
                statements[index] = Stmt.Policy{declarations: declarations, body: sema_loop_value_head_items_in(body, head, entry_value), span: span}
            }
            .TaskGroup(name, name_span, args, body, span) -> {
                statements[index] = Stmt.TaskGroup{name: name, name_span: name_span, args: args, body: sema_loop_value_head_items_in(body, head, entry_value), span: span}
            }
            .Layout(name, name_span, body, span) -> {
                statements[index] = Stmt.Layout{name: name, name_span: name_span, body: sema_loop_value_head_items_in(body, head, entry_value), span: span}
            }
            .AuthorityScope(caps, caps_span, binding, body, span) -> {
                statements[index] = Stmt.AuthorityScope{caps: caps, caps_span: caps_span, binding: binding, body: sema_loop_value_head_items_in(body, head, entry_value), span: span}
            }
            .ComptimeBlock(body, is_template_loop, span) -> {
                statements[index] = Stmt.ComptimeBlock{body: sema_loop_value_head_items_in(body, head, entry_value), is_template_loop: is_template_loop, span: span}
            }
            .ContextBlock(fields, body, span) -> {
                statements[index] = Stmt.ContextBlock{fields: fields, body: sema_loop_value_head_items_in(body, head, entry_value), span: span}
            }
            .Live(body, span) -> {
                statements[index] = Stmt.Live{body: sema_loop_value_head_items_in(body, head, entry_value), span: span}
            }
            .AssumeDet(reason, reason_expr, body, span) -> {
                statements[index] = Stmt.AssumeDet{reason: reason, reason_expr: reason_expr, body: sema_loop_value_head_items_in(body, head, entry_value), span: span}
            }
            .Transact(name, name_span, body, implicit, span) -> {
                statements[index] = Stmt.Transact{name: name, name_span: name_span, body: sema_loop_value_head_items_in(body, head, entry_value), implicit: implicit, span: span}
            }
            .ScopeMember(name, name_span, args, args_span, body, dsl, dot_span, span) -> {
                statements[index] = Stmt.ScopeMember{name: name, name_span: name_span, args: args, args_span: args_span, body: sema_loop_value_head_items_in(body, head, entry_value), dsl: dsl, dot_span: dot_span, span: span}
            }
            .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .DeferClose(_, _) -> {}
        }
    }
}

sema_loop_value_head_items_in: fn(body: ^^[Stmt], head: Expr, entry_value: Expr?) -> [Stmt] Never! {
    updated := body
    sema_loop_value_head_items(updated, head, entry_value)
    updated
}

sema_loop_value_head_items_arms: fn(arms: ^^[SwitchArm], head: Expr, entry_value: Expr?) -> [SwitchArm] Never! {
    updated := arms
    loop arm_index in 0..<updated.len() {
        arm := updated[arm_index]
        arm.body = sema_loop_value_head_items_in(arm.body.move(), head, entry_value)
        updated[arm_index] = arm
    }
    updated
}

sema_loop_value_head_items_else: fn(else_body: ^^[Stmt]?, head: Expr, entry_value: Expr?) -> [Stmt]? Never! {
    if else_body == {
        .Val(body) -> Val(sema_loop_value_head_items_in(body, head, entry_value))
        .None -> None
    }
}
