                    &self.diags.push(Diagnostic.error("E3110", "lane `{lane}` isn't valid on `{display_type_name}`", "swizzle members name lanes with x/y/z/w — `{display_type_name}` only has {valid}", "use only the lanes defined for `{display_type_name}`", Val(span)))
                    return None
                }
                .NotSwizzle -> {}
            }
        }
        (owner_import_ns, lookup_name) :: self.struct_type_name_parts(type_name)
        if self.struct_owner_module(lookup_name, owner_import_ns) == .Val(owner_mod) {
            display_name :: self.display_type_name(lookup_name, Val(owner_mod))
            if self.struct_fields_of(owner_mod, lookup_name) == .Val(fields) {
                loop (fname, _, fty) in fields {
                    if fname != member -> next
                    if owner_mod != self.module_idx && !self.field_is_pub_in(owner_mod, lookup_name, member) { &self.diags.push(private_item(member, span)); return None } else if owner_mod != self.module_idx && Syntax.classify_identifier(member) == Syntax.IdentifierClass.SoftPublic -> &self.diags.push(soft_public_use(member, span))
                    self.record_field_reference(owner_mod, lookup_name, member, span)
                    owned :: self.owner_trait_values(owner_mod, fty)
                    return Val(self.owner_type_for_reader(owner_mod, lookup_name, owned))
                }
                if self.computed_field_types_of(owner_mod, lookup_name) == .Val(computed) {
                    if computed.get(member) == .Val((_, cty)) -> return Val(cty)
                }
                field_names := [String]{}
                loop (name, _, _) in fields -> &field_names.push(name)
                suggestion :: suggest_field(member, field_names)
                fix :: if suggestion == { .Val(suggest) -> "did you mean `{suggest}`?"; .None -> "check the field names on `{display_name}`" }
                diagnostic := Diagnostic.error("E0302", "`{display_name}` has no field `{member}`", "field access only works on names declared in the struct", fix, Val(span))
                if suggestion == .Val(suggest) -> diagnostic = diagnostic.with_edit(TextEdit{span: span, new_text: suggest})
                &self.diags.push(diagnostic)
                return None
            }
        }
        if core_struct_field(type_name, member) == .Val(fty) -> return Val(fty)
        if type_name == "Instant" && member == "unix_ns" {
            &self.diags.push(Diagnostic.error("E0302", "`Instant` has no field `unix_ns`", "`Instant` is a monotonic Time point with no epoch; wall-clock Unix nanoseconds are a separate clock read", "call `time.unix_ns()` for wall-clock Unix nanoseconds", Val(span)))
            return None
        }
    }
    if t == .Apply(name, args) {
        (owner_import_ns, leaf) :: Checker.split_type_name(name)
        owner :: self.struct_owner_module(leaf, owner_import_ns)
        wrong_arity :: if owner == { .Val(owner_mod) -> self.struct_type_param_count(owner_mod, leaf) != args.len(); .None -> false }
        if owner_import_ns == None && wrong_arity { if core_generic_struct_field(leaf, member, args) == .Val(fty) -> return Val(fty) }
        if owner == {
            .Val(owner_mod) -> {
                if self.struct_fields_of(owner_mod, leaf) == .Val(fields) {
                    subst :: self.struct_subst_for_owner(owner_mod, leaf, args)
                    loop (fname, _, fty) in fields {
                        if fname != member -> next
                        if owner_mod != self.module_idx && !self.field_is_pub_in(owner_mod, leaf, member) { &self.diags.push(private_item(member, span)); return None } else if owner_mod != self.module_idx && Syntax.classify_identifier(member) == Syntax.IdentifierClass.SoftPublic -> &self.diags.push(soft_public_use(member, span))
                        self.record_field_reference(owner_mod, leaf, member, span)
                        owned_trait :: self.owner_trait_values(owner_mod, fty)
                        owned_type :: self.owner_type_for_reader(owner_mod, leaf, owned_trait)
                        return Val(self.instantiate_type_for_owner(owner_mod, owned_type, subst))
                    }
                    if self.computed_field_types_of(owner_mod, leaf) == .Val(computed) {
                        if computed.get(member) == .Val((_, cty)) -> return Val(self.instantiate_type_for_owner(owner_mod, cty, subst))
                    }
                    field_names := [String]{}
                    loop (field_name, _, _) in fields -> &field_names.push(field_name)
                    suggestion :: suggest_field(member, field_names)
                    fix :: if suggestion == { .Val(suggest) -> "did you mean `{suggest}`?"; .None -> "check the field names on `{name}`" }
                    diagnostic := Diagnostic.error("E0302", "`{name}` has no field `{member}`", "field access only works on names declared in the struct", fix, Val(span))
                    if suggestion == .Val(suggest) -> diagnostic = diagnostic.with_edit(TextEdit{span: span, new_text: suggest})
                    &self.diags.push(diagnostic)
                    return None
                }
            }
            .None -> { if owner_import_ns == None { if core_generic_struct_field(leaf, member, args) == .Val(fty) -> return Val(fty) } }
        }
    }
    if t == .Tuple(fields) {
        loop field in fields { if field.name == member -> return Val(field.ty) }
        field_names := [String]{}
        loop field in fields -> &field_names.push(field.name)
        suggestion :: suggest_field(member, field_names)
        fix :: if suggestion == { .Val(suggest) -> "did you mean `{suggest}`?"; .None -> "check the member names in this tuple" }
        diagnostic := Diagnostic.error("E0302", "this tuple has no member `{member}`", "field access only works on names declared in the tuple", fix, Val(span))
        if suggestion == .Val(suggest) -> diagnostic = diagnostic.with_edit(TextEdit{span: span, new_text: suggest})
        &self.diags.push(diagnostic)
        return None
    }
    if t == .Option(inner) {
        &self.diags.push(Diagnostic.error("E0310", "`.{member}` needs a `{inner.show()}`, but this value is `{t.show()}` and might be missing", "a missing value never leaves the function by itself; it stays an ordinary value until the code handles it (D-OUTCOME-SHAPE1=A)", "write `?.{member}` to keep the result optional, add `?? fallback` for a default, or match `.Val(x)` / `.None`", Val(span)))
        return None
    }
    &self.diags.push(Diagnostic.error("E0302", "`.{member}` only works on struct and tuple values", "enums and other values use methods or pattern tests instead", "use a struct or tuple value before `.{member}`", Val(span)))
    None
}
