// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:7129
fn infer_slice(self: &Checker, base: &Expr, start: &Expr, end: &Expr, span: Span) -> Type? {
    if self.loop_depth > 0 -> &self.diags.push(Diagnostic.lint("L0501", "slicing inside a loop copies every time", "each slice makes a fresh copy of the range — that adds up in a loop", "build indices outside the loop, or collect into one list", Val(span)))
    self.borrow_ctx = true
    base_ty :: self.infer(&base) ?? return None
    loop e in [&start, &end] {
        t :: self.infer(&e) ?? return None
        if !(if t == { .Int | .InlineRange(_, _, _) -> true; else -> false }) -> &self.diags.push(Diagnostic.error("E0505", "slice bounds must be {Type.Int.show()}, not {t.show()}", "both ends of `a..b` must be whole numbers (S22, inclusive)", "use Int positions", Val(e.span())))
    }
    if base_ty == {
        .List(inner) -> {
            if inner == .Named(elem) {
                if self.registry.is_columnar(elem) {
                    &self.diags.push(Diagnostic.error("E1108", "slicing isn't supported on a columnar list `{Type.List{element: inner}.show()}` yet", "`#Layout(columnar)` lists support the core surface in v1: indexing, field access, `len`, `is_empty`, `push`, and iteration", "drop `#Layout(columnar)` from `{elem}` to slice, or index the elements you need in a loop", Val(span)))
                    return None
                }
            }
            Val(Type.List{element: inner})
        }
        .String -> Val(Type.String)
        ty if ty.is_compute_tensor_family() -> Val(Type.Named{name: "Tensor"})
        other -> {
            &self.diags.push(Diagnostic.error("E0505", "only lists and strings can be sliced, not {other.show()}", "a Range can project a window only from indexed storage", "use `xs[a..b]` on a list or a text range operation on String", Val(span)))
            None
        }
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:7202
fn infer_range(self: &Checker, start: &Expr, end: &Expr, _span: Span) -> Type? {
    valid := true
    loop bound in [&start, &end] {
        ty :: self.infer(&bound) ?? return None
