// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:7501
fn is_core_files_handle_path(self: Checker, ty: Type, member: String) -> Bool {
    if member != "path" -> return false
    type_name :: if ty == { .Named(name) | .Apply(name, _) -> name; else -> return false }
    (owner_import_ns, leaf) :: self.struct_type_name_parts(type_name)
    if !(if leaf == { "FileReader" | "FileWriter" | "FileLock" | "TempDir" | "TempFile" -> true; else -> false }) -> return false
    if self.struct_owner_module(leaf, owner_import_ns) == {
        .Val(owner) -> {
            modules :: self.modules ?? return false
            files := None
            loop source in core_source_modules() { if source.module == "core.files" { files = Val(source); break } }
            files_source :: files ?? return false
            owner < modules.len() && modules[owner].module_alias == files_source.alias
        }
        .None -> owner_import_ns == None && core_struct_field_type(leaf, "path", []) != None
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:7540
fn field_is_computed(self: Checker, t: Type, member: String) -> Bool {
    if self.is_core_files_handle_path(t, member) -> return true
    type_name :: if t == { .Named(n) | .Apply(n, _) -> n; else -> return false }
    (owner_import_ns, lookup_name) :: self.struct_type_name_parts(type_name)
    owner_mod :: self.struct_owner_module(lookup_name, owner_import_ns) ?? return false
    if self.computed_field_types_of(owner_mod, lookup_name) == { .Val(c) -> c.contains_key(member); .None -> false }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:7559
fn field_type(self: &Checker, t: Type, member: String, span: Span) -> Type? {
    if t == .Tagged(TagMarker.Internal{internal_tag: InternalTag.CoreCryptoNominal}, inner) -> return self.field_type(inner, member, span)
    if t == .Apply(name, args) { if name == Syntax.TYPE_PIN && args.len() == 1 -> return self.field_type(args[0], member, span) }
    if self.is_core_files_handle_path(t, member) -> return Val(Type.String)
    if member == "value" {
        if t == .Apply(name, args) { if name == Syntax.TYPE_SHARED_GUARD && args.len() == 1 -> return Val(args[0]) }
        if t == .Tagged(marker, inner) {
            if marker == TagMarker.Internal{internal_tag: InternalTag.SharedGuardRead} || marker == TagMarker.Internal{internal_tag: InternalTag.SharedGuardEdit} {
                if inner == .Apply(name, args) { if name == Syntax.TYPE_SHARED_GUARD && args.len() == 1 -> return Val(args[0]) }
            }
        }
    }
    if t == .Named(type_name) {
        display_type_name :: self.display_type_name(type_name, None)
        if is_swizzleable_math_type(type_name) && !self.registry.contains(type_name) {
            if parse_swizzle_member(member, type_name) == {
