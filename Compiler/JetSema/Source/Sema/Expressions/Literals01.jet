                        .Ident(name, _) -> ("`{name}` proves {proven.lo}..{proven.hi}, which is not inside this fixed-size list's indexes", "this `[T#{len}]` value only has proven indexes 0 through {last}", "use a refinement whose invariant fits the list length")
                        else -> ("the index interval {proven.lo}..{proven.hi} is not inside this fixed-size list's indexes", "this `[T#{len}]` value only has proven indexes 0 through {last}", "use an index whose proven interval fits the list length")
