// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5846
fn byte_text_elements(parts: [ByteTextPart], span: Span) -> [Expr]? {
    bytes :: TypedLitBody.byte_text_bytes(parts) ?? return None
    elements := [Expr]{}
    loop byte in bytes -> &elements.push(Expr.Int{value: Int.from_u8(byte), span: span, width: None, raw: Val(byte.to_string())})
    Val(elements)
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5861
fn typed_lit_whole_value(self: &Checker, head: Type, body: Expr) -> Bool {
    if body == {
        .Spread(_, _) | .TypedLit(.None, _, _) | .StructLit(_, _, _, _, _, true, _) -> return false
        else -> {}
    }
    saved_expected :: self.expected_type
    self.expected_type = Val(head)
    diagnostics_start :: self.diags.len()
    flow :: self.flow.clone()
    probe := body.clone()
    whole :: if self.infer(&probe) == {
        .Val(got) -> self.diags.len() == diagnostics_start && self.check_type_assignable(head, got, probe.span()) && self.diags.len() == diagnostics_start
        .None -> false
    }
    &self.diags.truncate(diagnostics_start)
    self.flow = flow
    self.expected_type = saved_expected
    whole
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5890
fn elaborate_typed_lit(self: &Checker, e: &Expr) -> Type? {
    original :: replace(&e, Expr.Absent{span: Span.new(0, 0)})
    (written_head, body, span) :: if original == { .TypedLit(head, body, span) -> (head, body, span); else -> panic("elaborate_typed_lit only for TypedLit") }
    unresolved_head :: written_head ?? self.expected_type ?? {
        e = Expr.TypedLit{head: None, body: body, span: span}
        &self.diags.push(Diagnostic.error("E0119", "`.{{ … }}` needs a known type here", "an inferred typed literal needs an expected type from the surrounding context", "add a type head, e.g. `[U8].{{ 1, 2 }}`, or annotate the binding", Val(span)))
        return None
    }
    // Read source descriptors before resolution rewrites URL to Url.
    head_kind :: if unresolved_head == { .Named(name) -> Syntax.typed_head_kind(name); else -> None }
    regex_head :: unresolved_head == Type.Named{name: Syntax.TYPE_REGEX}
    head :: self.resolve_type(unresolved_head)
    keep_head := false
    if (head, body) == {
        (.List(_) | .FixedList(_, _), .ByteText(parts)) -> {
            elems :: byte_text_elements(parts, span) ?? {
                e = Expr.TypedLit{head: Val(head), body: TypedLitBody.ByteText{parts: parts}, span: span}
                &self.diags.push(Diagnostic.error("E0119", "this body doesn't match typed-literal head `{head.name()}`", "a typed literal body uses the head type's own literal shape", "use ASCII text or numeric elements for a byte list", Val(span)))
                return Val(head)
            }
            e = Expr.ListLit{elements: elems, span: span}
        }
        (.List(_) | .FixedList(_, _), .Empty) -> { e = Expr.ListLit{elements: [], span: span}; keep_head = true }
        (.List(_) | .FixedList(_, _), .Elements(elems)) if elems.len() == 1 && self.typed_lit_whole_value(head, elems[0]) -> e = elems[0]
        (.List(_) | .FixedList(_, _), .Elements(elems)) -> e = Expr.ListLit{elements: elems, span: span}
        (.List(_) | .FixedList(_, _), .Value(inner)) -> e = if self.typed_lit_whole_value(head, inner) -> inner else -> Expr.ListLit{elements: [inner], span: span}
        (.Map(_, _, _), .Value(inner)) -> e = inner
        (.Map(_, _, _), .Empty) -> { e = Expr.MapLit{entries: [], span: span}; keep_head = true }
        (.Map(_, _, _), .Entries(entries)) -> e = Expr.MapLit{entries: entries, span: span}
        (.Named(name), .Fields(fields)) -> e = Expr.StructLit{type_name: name, type_args: [], import_ns: None, as_trait: None, fields: fields, inferred: false, span: span}
        (.Apply(name, args), .Fields(fields)) -> e = Expr.StructLit{type_name: name, type_args: args, import_ns: None, as_trait: None, fields: fields, inferred: false, span: span}
        (.Named(name), .Empty) -> e = Expr.StructLit{type_name: name, type_args: [], import_ns: None, as_trait: None, fields: [], inferred: false, span: span}
        (.Apply(name, args), .Empty) -> e = Expr.StructLit{type_name: name, type_args: args, import_ns: None, as_trait: None, fields: [], inferred: false, span: span}
        (.Named(_), .Value(inner)) if (if head_kind == { .Val(kind) -> kind.is_typed_text(); .None -> false }) -> {
            kind :: head_kind.expect("guard read the head descriptor")
            e = inner
            return self.rewrite_typed_text_literal(&e, kind.source_name(), span)
        }
        (.Named(type_name), .Value(inner)) if regex_head || type_name == Syntax.TYPE_REGEX -> {
            e = inner
            return self.rewrite_regex_literal(&e, span)
        }
        (.Named(_), .Value(inner)) if (if head_kind == { .Val(kind) -> kind.is_boundary(); .None -> false }) -> {
            kind :: head_kind.expect("guard read the head descriptor")
            e = inner
            return self.rewrite_typed_boundary_literal(&e, kind.source_name(), span)
        }
        (.Named(type_name), .Value(inner)) if self.checked_text_type_name(type_name) != None -> {
            e = inner
            return self.rewrite_checked_text_literal(&e, type_name, span)
        }
        (_, .Value(inner)) -> e = inner
        (_, .Elements(elems)) if elems.len() == 1 -> e = elems[0]
        (_, unmatched_body) -> {
            e = Expr.TypedLit{head: Val(head), body: unmatched_body, span: span}
            &self.diags.push(Diagnostic.error("E0119", "this body doesn't match typed-literal head `{head.name()}`", "a typed literal body uses the head type's own literal shape", "use elements for lists, entries for maps, fields for records, or one expression for scalars", Val(span)))
            return Val(head)
        }
    }
    saved :: self.expected_type
    self.expected_type = Val(head)
    ty :: self.infer(&e)
    self.expected_type = saved
    if keep_head -> e = Expr.TypedLit{head: Val(head), body: TypedLitBody.Empty, span: span}
    if ty == .Val(got) {
        if got != head {
            if (if got == { .IntN(_, _) -> true; else -> false }) && (if head == { .IntN(_, _) -> true; else -> false }) && got.numeric_widening_to(head) != None {
                self.widen_numeric_expr(&e, got, head)
                return Val(head)
            }
            if (got == Type.Int && (if head == { .IntN(_, _) -> true; else -> false })) || ((if got == { .Int | .IntN(_, _) -> true; else -> false }) && (head == Type.Float || head == Type.Float32)) {
                source_span :: e.span()
                source :: replace(&e, Expr.Absent{span: source_span})
                e = Expr.MethodCall{receiver: Expr.Ident{name: head.name(), span: source_span}, method: Syntax.conversion_method_for_source(got.name()), method_span: source_span, owner_type_args: [], type_args: [], args: [CallArg{convention: AccessConvention.Read, expr: source, span: source_span, flags: CallArgFlags.default(), label: None, spread: false}], recv_type: None, resolved_ret: Val(head), operator_rhs: None, checked_widen: true}
                return Val(head)
            }
            if self.lift_optional_slot(head, got, &e) != None -> return Val(head)
            numeric :: fn(ty: Type) { if ty.without_user_tags() == { .Int | .IntN(_, _) | .Float | .Float32 | .InlineRange(_, _, _) -> true; else -> false } }
            if !self.check_type_assignable(head, got, e.span()) && !(numeric(head) && numeric(got)) {
                distinct :: if head == { .Named(name) if self.registry.is_distinct(name) -> Val(name); else -> None }
                if distinct == {
                    .Val(name) -> {
                        base_name :: if self.registry.distinct_base(name) == { .Val(base) -> base.name(); .None -> "" }
                        &self.diags.push(Diagnostic.error("E0128", "a `{got.name()}` can't be used where a `{name}` is expected", "`{name}` and `{got.name()}` are different types — even though `{name}` is built on `{base_name}`, one is never accepted in place of the other", "convert explicitly: `{name}.{Syntax.conversion_method_for_source(got.name())}(expr)`", Val(e.span())))
                    }
                    .None -> &self.diags.push(Diagnostic.error("E0108", "this needs {head.show()}, but the value is {got.show()}", "the value here does not have the type required by this declaration", "use a value of the required type or convert it explicitly", Val(e.span())))
                }
            }
        }
    }
    Val(head)
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:6229
fn check_list_element_assignable(self: &Checker, want: Type, got: Type, span: Span) {
    reported :: self.check_type_assignable(want, got, span)
    fixed_widens :: if (want, got) == { (.List(want_elem), .FixedList(got_elem, _)) -> want_elem == got_elem && type_obligations_satisfy(want_elem, got_elem); else -> false }
    union_widens :: if want == { .Union(members) -> members.any(fn(member: Type) { member == got && type_obligations_satisfy(member, got) }); else -> false }
    trait_box :: self.trait_slot_accepts(want, got)
    if !reported && got != want && !fixed_widens && got.numeric_widening_to(want) == None && !union_widens && !trait_box {
        if typed_text_mismatch(want, got, span) == {
            .Val(diag) -> &self.diags.push(diag)
            .None -> &self.diags.push(Diagnostic.error("E0112", "a list item needs {want.show()}, but this is {got.show()}", "every list item must match the list's element type", type_fix_hint(want, got), Val(span)))
        }
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:6273
fn infer_owned_list_element(self: &Checker, elem: &Expr) -> Type? {
    ty :: self.infer_aggregate_value(&elem, None)
    if ty != None -> self.note_move_if_direct_ident(elem, "the list literal")
    ty
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:6281
fn list_elem_needs_expected_type(elem: Expr) -> Bool {
    if elem == {
        .StructLit(_, _, _, _, _, true, _) | .TypedLit(.None, _, _) -> true
        .ListLit(elems, _) -> elems.len() == 0
        .Paren(inner, _) | .Unary(UnOp.Neg, inner, _) -> list_elem_needs_expected_type(inner)
        else -> false
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:6293
fn infer_list_lit(self: &Checker, elems: &[Expr], span: Span) -> Type? {
    loop elem in elems -> self.reject_fixed_storage(elem, "be stored in a list")
    if self.no_os -> &self.diags.push(e3303(span))
    if elems.len() == 0 {
        if self.expected_type == .Val(.List(inner)) -> return Val(Type.List{element: inner})
        &self.diags.push(Diagnostic.error("E0501", "an empty list needs a type", "write `[]` only where the list type is already known from around it", "name the element type on the literal, such as `[Int]{{}}`", Val(span)))
        return None
    }
    if self.expected_type == .Val(.FixedList(expected_inner, len)) {
        if elems.any(fn(e: Expr) { if e == { .Spread(_, _) -> true; else -> false } }) {
            &self.diags.push(Diagnostic.error("E1311", "list spread can't build a fixed-size `[T#N]` list", "spread expands a growable list — a `[T#N]` has a fixed compile-time length", "use a growable `[T]` binding (`::`/`:=`) instead of `[T#N]`", Val(span)))
            return None
        }
        if len.literal_value() == .Val(expected_len) {
            if U64.from_int(elems.len()) != expected_len {
                actual_suffix :: if elems.len() == 1 -> "" else -> "s"
                expected_suffix :: if expected_len == 1 -> "" else -> "s"
                &self.diags.push(Diagnostic.error("E0963", "this list has {elems.len()} element{actual_suffix}, but `[T#{len.expression()}]` expects exactly {expected_len}", "a fixed-size list `[T#N]` requires exactly N elements", "provide exactly {expected_len} element{expected_suffix}", Val(span)))
                return None
            }
        }
        saved :: self.expected_type
        self.expected_type = Val(expected_inner)
        loop e in &elems { if self.infer_owned_list_element(&e) == .Val(t) -> self.check_list_element_assignable(expected_inner, t, e.span()) }
        self.expected_type = saved
        return Val(Type.FixedList{elem: expected_inner, len: len})
    }
    if self.expected_type == .Val(.List(expected_inner)) {
        if expected_inner == .TraitObject(trait_names) {
            trait_name :: if trait_names.len() == 1 -> Val(trait_names[0]) else -> None
            loop e in &elems {
                if self.infer_owned_list_element(&e) == .Val(t) {
                    coercion :: if (t, trait_name) == {
                        (.Named(name), .Val(trait_name)) | (.Apply(name, _), .Val(trait_name)) -> self.trait_reg.implements_trait(name, trait_name)
                        else -> false
                    }
                    if coercion {
                        if e == .StructLit(type_name, type_args, import_ns, _, fields, inferred, struct_span) -> e = Expr.StructLit{type_name: type_name, type_args: type_args, import_ns: import_ns, as_trait: trait_name, fields: fields, inferred: inferred, span: struct_span}
                    } else { self.check_list_element_assignable(expected_inner, t, e.span()) }
                }
            }
            return Val(Type.List{element: expected_inner})
        }
        saved :: self.expected_type
        saved_string_view_read :: self.allow_string_view_read
        string_view_elements :: expected_inner == Type.Apply{name: "View", args: [Type.Named{name: "str"}]}
        if string_view_elements -> self.allow_string_view_read = true
        self.expected_type = Val(expected_inner)
        loop e in &elems {
            if e == {
                .Spread(inner, spread_span) -> {
                    if self.infer_owned_list_element(&inner) == {
                        .Val(.List(spread_elem)) -> self.check_list_element_assignable(expected_inner, spread_elem, spread_span)
                        .Val(other) -> &self.diags.push(Diagnostic.error("E1311", "spread needs a list, not `{other.name()}`", "list spread `[...xs, y]` expands a list's elements in place", "spread a `[T]` value here", Val(spread_span)))
                        .None -> {}
                    }
                }
                else -> {
                    if self.infer_owned_list_element(&e) == .Val(inferred) {
                        t :: self.lift_optional_slot(expected_inner, inferred, &e) ?? inferred
                        explicit_result :: if e.without_parens() == { .Ok(_, _) | .Err(_, _) -> true; else -> false }
                        if plain_used_where_result_expected(expected_inner, t) && !explicit_result {
                            elem_span :: e.span()
                            inner :: replace(&e, Expr.Absent{span: elem_span})
                            e = Expr.Ok{value: inner, span: elem_span}
                        } else {
                            string_view_compatible :: string_view_elements && t == Type.String && ((if e == { .Ident(name, _) -> self.is_string_view(name); else -> false }) || self.string_view_call_source(e) != None)
                            if !string_view_compatible -> self.check_list_element_assignable(expected_inner, t, e.span())
                        }
                    }
                }
            }
        }
        self.expected_type = saved
        self.allow_string_view_read = saved_string_view_read
        self.check_list_view_element_aliases(elems, expected_inner)
        return Val(Type.List{element: expected_inner})
    }
    elem_types := [Type?]{}
    loop _ in 0..elems.len() -> &elem_types.push(None)
    deferred := [Int]{}
    loop index in 0..elems.len() {
        if list_elem_needs_expected_type(elems[index]) { &deferred.push(index); next }
        elem_types[index] = if elems[index] == {
            .Spread(inner, spread_span) -> {
                if self.infer_owned_list_element(&inner) == {
                    .Val(.List(spread_elem)) -> Val(spread_elem)
                    .Val(other) -> {
                        &self.diags.push(Diagnostic.error("E1311", "spread needs a list, not `{other.name()}`", "list spread `[...xs, y]` expands a list's elements in place", "spread a `[T]` value here", Val(spread_span)))
                        None
                    }
                    .None -> None
                }
            }
            else -> self.infer_owned_list_element(&elems[index])
        }
    }
    first_option := None
    loop ty in elem_types { if ty != None { first_option = ty; break } }
    first := first_option ?? {
        loop index in deferred -> elem_types[index] = self.infer_owned_list_element(&elems[index])
        return None
    }
    saw_first := false
    loop ty in elem_types {
        if ty == .Val(t) {
            if !saw_first { saw_first = true; next }
            if t != first { if first.numeric_join(t) == .Val(joined) -> first = joined }
        }
    }
    loop index in deferred {
        saved :: self.expected_type
        self.expected_type = Val(first)
        elem_types[index] = self.infer_owned_list_element(&elems[index])
        self.expected_type = saved
    }
    loop i in 0..elems.len() {
        t :: elem_types[i] ?? next
        spread_needs_conversion :: (if elems[i] == { .Spread(_, _) -> true; else -> false }) && t != first
        if spread_needs_conversion || (t != first && t.numeric_widening_to(first) == None) -> &self.diags.push(Diagnostic.error("E0504", "this list resolves to `{first.name()}` but item {i + 1} is `{t.name()}`", "every item in a list literal must have the same type", "make every element the same type, or build the list in steps", Val(elems[i].span())))
    }
    loop i in 0..elems.len() {
        source :: elem_types[i] ?? next
        if !(if elems[i] == { .Spread(_, _) -> true; else -> false }) -> self.widen_numeric_expr(&elems[i], source, first)
    }
    self.check_list_view_element_aliases(elems, first)
    Val(Type.List{element: first})
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:6557
fn infer_tuple_lit(self: &Checker, fields: &[TupleField], _span: Span) -> Type? {
    seen := [String:Bool]{}
    typed := [TypeTupleField]{}
    loop field in &fields {
        self.reject_fixed_storage(field.value, "be stored in a tuple")
        if seen.contains_key(field.name) -> &self.diags.push(Diagnostic.error("E0003", "tuple member `{field.name}` appears more than once", "each named member in a tuple must have a unique name", "rename or remove the duplicate member", Val(field.value.span())))
        &seen.insert(field.name, true)
        expected_field := None
        if self.expected_type == .Val(.Tuple(expected_fields)) {
            loop expected in expected_fields { if expected.name == field.name { expected_field = Val(expected.ty); break } }
        }
        ty :: self.infer_aggregate_value(&field.value, expected_field) ?? Type.Int
        &typed.push(TypeTupleField{name: field.name, ty: ty})
    }
    canonical :: canonicalize_tuple_fields(^typed)
    Val(Type.Tuple{fields: canonical})
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:6597
fn infer_map_lit(self: &Checker, entries: &[ExprPair], span: Span) -> Type? {
    if self.no_os -> &self.diags.push(e3303(span))
    if entries.len() == 0 {
        if self.expected_type == .Val(.Map(key, key_span, value)) {
            if !self.map_key_type_eligible(key) -> &self.diags.push(Diagnostic.error("E0502", "`{key.name()}` can't be a map key type (D-MAP-KEY1)", "map keys must be Int, String, Bool, Char, U8/IntN, a payload-free enum, or a tuple/struct whose fields recursively follow D-MAP-KEY1; Float, views, Shared, functions, lists, maps, sets, and payload-carrying enums are not key-eligible", "use an eligible scalar, enum, tuple, or struct key; remove non-key fields or store the value separately", Val(key_span ?? span)))
            return Val(Type.Map{key: key, key_span: key_span, value: value})
        }
        &self.diags.push(Diagnostic.error("E0501", "an empty map needs a type", "write `[]` only where the map type is already known from around it", "name the key and value types on the literal: `[String:Int].{{}}`", Val(span)))
        return None
    }
    key_ty := None
    val_ty := None
    expected_map :: if self.expected_type == { .Val(.Map(key, _, value)) -> Val((key, value)); else -> None }
    remaining_value_idents := [String:Int]{}
    loop entry in entries { if entry.value == .Ident(name, _) -> &remaining_value_idents.insert(name, (remaining_value_idents.get(name) ?? 0) + 1) }
    loop entry in &entries {
        value_name :: if entry.value == { .Ident(name, _) -> Val(name); else -> None }
        repeated_owned_value := false
        if value_name == .Val(name) {
            remaining :: remaining_value_idents.get(name) ?? 0
            repeated_owned_value = remaining > 1
            &remaining_value_idents.insert(name, max(remaining - 1, 0))
        }
        self.reject_fixed_storage(entry.key, "be stored in a map")
        self.reject_fixed_storage(entry.value, "be stored in a map")
        expected_key :: if expected_map == { .Val((key, _)) -> Val(key); .None -> None }
        expected_value :: if expected_map == { .Val((_, value)) -> Val(value); .None -> None }
        kt :: self.infer_aggregate_value(&entry.key, expected_key) ?? next
        vt_inferred :: self.infer_aggregate_value(&entry.value, expected_value) ?? next
        copy_owned_value := false
        if value_name == .Val(name) {
            if self.lookup(name) == .Val(info) -> copy_owned_value = info.param_conv == None && !type_is_copy(info.ty) && (repeated_owned_value || self.is_name_live_after(name))
        }
        if copy_owned_value && self.is_cloneable_type(vt_inferred) -> self.insert_implicit_copy(&entry.value, vt_inferred, vt_inferred)
        vt :: if expected_value == { .Val(want) -> self.lift_optional_slot(want, vt_inferred, &entry.value) ?? vt_inferred; .None -> vt_inferred }
        // GATE #4499: sema admits exact composite keys, never string encodings.
        if !self.map_key_type_eligible(kt) -> &self.diags.push(Diagnostic.error("E0502", "`{kt.name()}` can't be a map key (D-MAP-KEY1)", "map keys must be Int, String, Bool, Char, U8/IntN, a payload-free enum, or a tuple/struct whose fields recursively follow D-MAP-KEY1; Float, views, Shared, functions, lists, maps, sets, and payload-carrying enums are not key-eligible", "use an eligible scalar, enum, tuple, or struct key; remove non-key fields or store the value separately", Val(entry.key.span())))
        if key_ty == {
            .Val(fk) -> { if kt != fk -> &self.diags.push(Diagnostic.error("E0504", "this map started with `{fk.name()}` keys but another key is `{kt.name()}`", "every key in a map literal must have the same type", "use the same key type throughout", Val(entry.key.span()))) }
            .None -> key_ty = Val(kt)
        }
        if val_ty == {
            .Val(fv) -> { if vt != fv -> &self.diags.push(Diagnostic.error("E0504", "this map started with `{fv.name()}` values but another value is `{vt.name()}`", "every value in a map literal must have the same type", "use the same value type throughout", Val(entry.value.span()))) }
            .None -> val_ty = Val(vt)
        }
    }
    if (key_ty, val_ty) == { (.Val(k), .Val(v)) -> Val(Type.Map{key: k, key_span: None, value: v}); else -> None }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:6766
fn proven_type_integer_interval(self: Checker, ty: Type) -> IntegerInterval? {
    untagged :: ty.without_user_tags()
    bounds :: untagged.integer_range() ?? self.registry.integer_interval(untagged) ?? return None
    Val(IntegerInterval.from_bounds(bounds))
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:6773
fn proven_integer_interval(self: Checker, expr: Expr) -> IntegerInterval? {
    if expr == {
        .Int(value, _, _, raw) -> {
            exact :: exact_integer_literal(value, raw).try_i128() ?? return None
            Val(IntegerInterval.new(exact, exact))
        }
        .Paren(inner, _) -> self.proven_integer_interval(inner)
        .Ident(name, _) -> { local :: self.lookup(name) ?? return None; self.proven_type_integer_interval(local.ty) }
        .MethodCall(receiver, method, _, _, _, args, _, _, _, _) if method == "raw" && args.len() == 0 -> self.proven_integer_interval(receiver)
        .Unary(UnOp.Neg, inner, _) -> { interval :: self.proven_integer_interval(inner) ?? return None; interval.negated() }
        .Binary(op, lhs, rhs, _) -> {
            left :: self.proven_integer_interval(lhs) ?? return None
            right :: self.proven_integer_interval(rhs) ?? return None
            if op == { .Add -> left.add(right); .Sub -> left.sub(right); .Mul -> left.mul(right); else -> None }
        }
        else -> None
    }
}
