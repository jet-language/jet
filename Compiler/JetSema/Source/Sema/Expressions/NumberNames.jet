// A name for a number reads as its number would. A `:` name bound to a number
// literal (`y: 2.5`), or to arithmetic on such literals and names, keeps that
// literal; where a use refuses the name's own type, the name reads as the
// literal written at that use, checked as the literal would be there:
// `half(y)` with `half: fn(x: Float)` reads `y` as the Float 2.5, and `n: 200`
// passed to a U8 parameter reads as the U8 200. A use the name's own type
// serves reads the name, so a program that checked before means the same.
//
// A `:=` name keeps its default type (Int or Decimal) unless a use refuses
// it. The first refusing use whose type the literal takes decides the
// binding's type: the function is checked again with the binding declared at
// that type (sema_function_check_passes). A later use that needs yet another
// type is one E0112 that names both uses, and a later write of a value that
// type refuses also points at the use that decided it.
//
// A number that does not fit where its name is used is the error that number
// written there would be (`big: 300` read as a U8 is E1003), reported at the
// use and pointing at the number.
//
// A module constant bound to a number literal with no written type
// (`LIMIT: 200`) reads as its literal at a use in its own module that refuses
// its type, as a `:` name in a body does: a call argument, a typed slot, an
// operator operand and a written value alike. A constant computed from other
// constants keeps its own type.
use jet_foundation.[
    BinOp,
    DIAGNOSTIC_ERROR,
    Diagnostic,
    Expr,
    Span,
    Symbol,
    SymbolKind,
    Type,
    UnOp,
    diagnostic_with_label,
    expr_span,
    type_identity_equal,
    type_name,
    module_none,
]

// The read of a number name at one use: `handled` when this module decided
// it, with the checked literal, or None after an error.
SemaNumberNameRead: struct {
    handled: Bool
    value: TExpr?
}

// The literal a binding of `init` keeps: `init` itself when it is a number
// literal with no width or type suffix, a negated one, or arithmetic on them,
// with each immutable number name replaced by its own literal. None for any
// other initializer.
sema_expr_number_literal_init: fn(init: Expr, scopes: SemaScopeTable) -> Expr? Never! {
    if init == .Int(_, _, width, _, _) {
        if width != None -> return None
        // copy: the binding statement keeps its initializer; the scope row keeps this one.
        return Val(init.copy())
    }
    if init == .Float(_, _, is_f32, _, _) {
        if is_f32 -> return None
        // copy: the binding statement keeps its initializer; the scope row keeps this one.
        return Val(init.copy())
    }
    if init == .Unary(op, operand, span, id) {
        if op != UnOp.Neg -> return None
        inner: sema_expr_number_literal_init(operand, scopes) ?? return None
        return Val(Expr.Unary{op: op, operand: inner, span: span, id: id})
    }
    if init == .Binary(op, left, right, span, id) {
        if !sema_expr_number_literal_operator(op) -> return None
        left_literal: sema_expr_number_literal_init(left, scopes) ?? return None
        right_literal: sema_expr_number_literal_init(right, scopes) ?? return None
        return Val(Expr.Binary{op: op, left: left_literal, right: right_literal, span: span, id: id})
    }
    if init == .Ident(name, _, _) {
        index: sema_scope_resolve_index(scopes, name) ?? return None
        if scopes.bindings[index].mutable -> return None
        // copy: the named binding's row keeps its literal for its own uses.
        return Val((scopes.bindings[index].number_literal ?? return None).copy())
    }
    None
}

// The operators of number arithmetic: a literal on each side gives a number.
sema_expr_number_literal_operator: fn(op: BinOp) -> Bool Never! {
    if op == {
        .Add | .Sub | .Mul | .Div | .FloorDiv | .Mod | .Rem | .Pow -> true
        .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Gt | .Le | .Ge | .Compare | .And | .Or -> false
    }
}

// Whether `name` is a number name whose own type a numeric slot of type
// `required` refuses: neither that type nor one that widens into it.
sema_expr_number_name_refused: fn(name: String, required: Type, scopes: SemaScopeTable) -> Bool Never! {
    index: sema_scope_resolve_index(scopes, name) ?? return false
    if scopes.bindings[index].number_literal == None -> return false
    own: scopes.bindings[index].symbol.ty ?? return false
    !type_identity_equal(own, required) && sema_expr_numeric_widening_to(own, required) != (Val(true))
}

// Reads the number name `name` (scope row `index`) at `span`, where `expected`
// is asked for. Not handled when the name's own type serves the use or its
// literal doesn't fit there either: the caller reads the name as usual and
// reports the mismatch. `noted` when the caller already read the name at
// `span` (an operator's left operand, read before its right one is known).
sema_expr_number_name_read: fn(name: String, span: Span, index: Int, expected: Type?, noted: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaNumberNameRead {
    unhandled: SemaNumberNameRead{handled: false, value: None}
    wanted: expected ?? return unhandled
    // copy: the scope row keeps its literal for the name's other uses.
    literal: (scopes.bindings[index].number_literal ?? return unhandled).copy()
    own: sema_scope_binding_type(environment, scopes, index) ?? return unhandled
    // A use the name's own type serves, or widens into, reads the name.
    required: sema_call_resolved_type(wanted, environment, program)
    if sema_call_type_assignable(required, own, environment, program) ?? true -> return unhandled
    if sema_expr_numeric_widening_to(own, required) == (Val(true)) -> return unhandled
    // A literal's check opens no statement tail.
    tail_store := sema_statement_tail_store_init()
    trial := [Diagnostic]{}
    fitted := sema_probe_expression(literal, expected, environment, program, scopes, state, tail_store, context, trial) ?? return sema_expr_number_unfit(name, span, required, literal, trial, diagnostics)
    if sema_has_error_since(trial, 0) -> return sema_expr_number_unfit(name, span, required, literal, trial, diagnostics)
    binding: scopes.bindings[index].symbol.span
    if scopes.bindings[index].mutable {
        loop decided in context.number_retypes_known {
            if sema_expr_number_same_binding(decided.binding, binding) {
                diagnostics.push(sema_expr_number_retype_conflict(name, decided, fitted.ty, span, environment))
                return SemaNumberNameRead{handled: true, value: None}
            }
        }
        // The probe's type is recorded for the next pass; the probe's result is dropped.
        context.number_retypes_found.push(SemaNumberRetype{binding: binding, ty: fitted.ty.move(), use_span: span})
        return unhandled
    }
    if !noted {
        context.name_references.push(SemaNameReferenceFact{span: span, symbol: sema_scope_binding_symbol(environment, scopes, index), kind: "local"})
        if !sema_ownership_note_reference(state, name, span, scopes, SemaOwnershipReferenceKind.Read) -> return SemaNumberNameRead{handled: true, value: None}
    }
    value := sema_check_expression(literal, expected, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaNumberNameRead{handled: true, value: None}
    value.span = span
    SemaNumberNameRead{handled: true, value: Val(value)}
}

// Reads the module constant `symbol` (scope row `index`) at `span` as its
// number literal, where `expected` refuses the constant's own type, and notes
// the reference. Not handled for a constant of another module, one with a
// written type, a mutable, `#Persist` or comptime one, or one whose value is
// not a literal.
sema_expr_number_constant_read: fn(name: String, span: Span, index: Int, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaNumberNameRead {
    read: sema_expr_number_constant_reread(name, span, index, expected, environment, program, scopes, state, context, diagnostics)
    if read.value != None -> context.name_references.push(SemaNameReferenceFact{span: span, symbol: sema_scope_binding_symbol(environment, scopes, index), kind: "const"})
    read
}

// sema_expr_number_constant_read without noting the reference: the caller
// already read the name at `span` (an operator's left operand, read before
// its right one is known).
sema_expr_number_constant_reread: fn(name: String, span: Span, index: Int, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaNumberNameRead {
    unhandled: SemaNumberNameRead{handled: false, value: None}
    wanted: expected ?? return unhandled
    symbol: sema_scope_binding_symbol(environment, scopes, index)
    if symbol.module_identity != environment.module_identity -> return unhandled
    own: sema_scope_binding_type(environment, scopes, index) ?? return unhandled
    required: sema_call_resolved_type(wanted, environment, program)
    if sema_call_type_assignable(required, own, environment, program) ?? true -> return unhandled
    if sema_expr_numeric_widening_to(own, required) == (Val(true)) -> return unhandled
    literal: sema_expr_number_constant_literal(symbol, program) ?? return unhandled
    // A literal's check opens no statement tail.
    tail_store := sema_statement_tail_store_init()
    trial := [Diagnostic]{}
    _: sema_probe_expression(literal, expected, environment, program, scopes, state, tail_store, context, trial) ?? return sema_expr_number_unfit(name, span, required, literal, trial, diagnostics)
    if sema_has_error_since(trial, 0) -> return sema_expr_number_unfit(name, span, required, literal, trial, diagnostics)
    value := sema_check_expression(literal, expected, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaNumberNameRead{handled: true, value: None}
    value.span = span
    SemaNumberNameRead{handled: true, value: Val(value)}
}

// The number literal the module constant `symbol` is bound to, when it has
// no written type and is neither mutable, `#Persist` nor comptime. The row's
// `typed`, not its declaration's type, tells a written type: the compile-time
// run types every constant's declaration with its staged value's type.
sema_expr_number_constant_literal: fn(symbol: Symbol, program: SemaProgramTables) -> Expr? {
    if program.registration_graph == .Val(graph) {
        module_index: sema_registration_module_index(graph, symbol.module_identity) ?? return None
        loop constant in graph.modules[module_index].constants {
            if constant.symbol.id != symbol.id -> next
            if constant.typed || constant.declaration.mutable || constant.declaration.is_persist || constant.declaration.is_comptime || constant.declaration.ct != None -> return None
            // A constant's value names no local, so no body scope is consulted.
            return sema_expr_number_literal_init(constant.declaration.value, sema_scope_init(module_none()))
        }
    }
    None
}

// The scope row of `name` when it is a module constant of this module bound
// to a number literal (sema_expr_number_constant_literal).
sema_expr_number_constant_row: fn(name: String, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> Int? {
    index: sema_scope_resolve_index(scopes, name) ?? return None
    if scopes.bindings[index].symbol.kind != SymbolKind.Constant -> return None
    symbol: sema_scope_binding_symbol(environment, scopes, index)
    if symbol.module_identity != environment.module_identity -> return None
    if sema_expr_number_constant_literal(symbol, program) == None -> return None
    Val(index)
}

// A number name whose literal a numeric use refuses (`big: 300` read as a
// U8): the refusals the literal written at the use gets, reported at the use
// and pointing at the number. Handled once one is reported; any other
// refusal is the caller's ordinary mismatch.
sema_expr_number_unfit: fn(name: String, span: Span, required: Type, literal: Expr, trial: [Diagnostic], diagnostics: &[Diagnostic]) -> SemaNumberNameRead {
    reported := false
    if !sema_expr_is_numeric(required) && sema_expr_precise_name(required) == None -> return SemaNumberNameRead{handled: false, value: None}
    number: expr_span(literal)
    loop refusal in trial {
        if refusal.severity != DIAGNOSTIC_ERROR -> next
        // copy: the trial's report moves to the use; the trial list is dropped.
        moved := refusal.copy()
        moved.span = Val(span)
        diagnostics.push(diagnostic_with_label(moved, number, "`{name}` is this number"))
        reported = true
    }
    SemaNumberNameRead{handled: reported, value: None}
}

// Whether no operator rule combines numbers of types `left` and `right`:
// both are numbers, neither widens into the other, and they are not an exact
// number beside an Int (which meets it as the same value) or a Complex beside
// a plain number (which lifts into it).
sema_expr_number_types_refused: fn(left: Type, right: Type) -> Bool {
    if type_identity_equal(left, right) -> return false
    left_precise: sema_expr_precise_name(left)
    right_precise: sema_expr_precise_name(right)
    if !sema_expr_is_numeric(left) && left_precise == None -> return false
    if !sema_expr_is_numeric(right) && right_precise == None -> return false
    if left_precise == (Val("Complex")) || right_precise == (Val("Complex")) -> return false
    if (left_precise != None && right == Type.Int) || (right_precise != None && left == Type.Int) -> return false
    sema_expr_numeric_join(left, right) == None
}

// Whether `expr` is a bare number name: a local bound to a number literal, or
// a module constant of this module bound to one.
sema_expr_number_name_operand: fn(expr: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> Bool {
    if expr == .Ident(name, _, _) {
        index: sema_scope_resolve_index(scopes, name) ?? return false
        if scopes.bindings[index].number_literal != None -> return true
        return sema_expr_number_constant_row(name, environment, program, scopes) != None
    }
    false
}

// An operator operand that is a number name whose own type the other
// operand's type `other` refuses reads at `other` (sema_expr_number_name_read,
// sema_expr_number_constant_read): `price * rate` with `price: Float` and
// `rate: 0.5` multiplies two Floats, as does `price * RATE` with a module
// constant `RATE: 0.5`, and `total + price` makes a `:=` name `total` a Float.
sema_expr_number_operand_read: fn(operand: Expr, other: Type, noted: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaNumberNameRead {
    unhandled: SemaNumberNameRead{handled: false, value: None}
    if operand == .Ident(name, span, _) {
        index: sema_scope_resolve_index(scopes, name) ?? return unhandled
        own: sema_scope_binding_type(environment, scopes, index) ?? return unhandled
        if !sema_expr_number_types_refused(own, other) -> return unhandled
        if scopes.bindings[index].number_literal != None -> return sema_expr_number_name_read(name, span, index, Val(other), noted, environment, program, scopes, state, context, diagnostics)
        if scopes.bindings[index].symbol.kind != SymbolKind.Constant -> return unhandled
        if noted -> return sema_expr_number_constant_reread(name, span, index, Val(other), environment, program, scopes, state, context, diagnostics)
        return sema_expr_number_constant_read(name, span, index, Val(other), environment, program, scopes, state, context, diagnostics)
    }
    unhandled
}

// Whether the scope row `index` is a `:=` number name no pass has decided a
// type for yet, so a write may decide it (sema_expr_number_target_retype).
sema_expr_number_target_open: fn(index: Int, scopes: SemaScopeTable, context: SemaCheckContext) -> Bool Never! {
    if !scopes.bindings[index].mutable || scopes.bindings[index].number_literal == None -> return false
    sema_expr_number_retype(scopes.bindings[index].symbol.span, context.number_retypes_known) == None
}

// A value a written `:=` number name reads without a type asked for: a name
// that is not itself a number name, a field, or an element. It has its own
// type, which may decide the target's (`total = price`).
sema_expr_number_target_value_typed: fn(expr: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> Bool {
    if expr == .Ident(_, _, _) -> return !sema_expr_number_name_operand(expr, environment, program, scopes)
    if expr == .Field(_, _, _, _) || expr == .Index(_, _, _, _, _) -> return true
    if expr == .Paren(inner, _, _) -> return sema_expr_number_target_value_typed(inner, environment, program, scopes)
    false
}

// A write `total = price` or `total += price` to the open `:=` number name
// at scope row `index` (sema_expr_number_target_open), whose value has the
// type `offered` that the name's own type refuses, is a use of that type:
// when the name's literal takes it, the next pass declares the name at it.
sema_expr_number_target_retype: fn(index: Int, offered: Type, name_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext) {
    if !sema_expr_number_target_open(index, scopes, context) -> return
    own: scopes.bindings[index].symbol.ty ?? return
    if !sema_expr_number_types_refused(own, offered) -> return
    // copy: the scope row keeps its literal for the name's other uses.
    literal: (scopes.bindings[index].number_literal ?? return).copy()
    // A literal's check opens no statement tail.
    tail_store := sema_statement_tail_store_init()
    trial := [Diagnostic]{}
    fitted := sema_probe_expression(literal, Val(offered), environment, program, scopes, state, tail_store, context, trial) ?? return
    if sema_has_error_since(trial, 0) -> return
    // The probe's type is recorded for the next pass; the probe's result is dropped.
    context.number_retypes_found.push(SemaNumberRetype{binding: scopes.bindings[index].symbol.span, ty: fitted.ty.move(), use_span: name_span})
}

// The type an earlier pass decided for the `:=` number binding `binding`, or
// None.
sema_expr_number_retype: fn(binding: Span, known: [SemaNumberRetype]) -> Type? Never! {
    loop decided in known {
        // copy: the decided type stays in the pass's list; the binding declares its own.
        if sema_expr_number_same_binding(decided.binding, binding) -> return Val(decided.ty.copy())
    }
    None
}

// The refusals found by a check pass become known decisions: the earliest
// use of each binding not yet decided. Returns whether one was added, which is
// when another pass is due.
sema_expr_number_accept_retypes: fn(known: &[SemaNumberRetype], found: [SemaNumberRetype]) -> Bool Never! {
    known_before: known.len()
    loop retype in found {
        decided := -1
        loop index in 0..<known.len() {
            if sema_expr_number_same_binding(known[index].binding, retype.binding) {
                decided = index
                break
            }
        }
        if decided < 0 {
            // copy: `found` is the pass's list, which the pass drops.
            known.push(retype.copy())
        } else if decided >= known_before && retype.use_span.start < known[decided].use_span.start {
            // copy: `found` is the pass's list, which the pass drops.
            known[decided] = retype.copy()
        }
    }
    known.len() > known_before
}

// E0112 for a `:=` number name that an earlier use already made `decided.ty`,
// at a use that needs `wanted`: one error that names both uses.
sema_expr_number_retype_conflict: fn(name: String, decided: SemaNumberRetype, wanted: Type, span: Span, environment: SemaScopeEnvironment) -> Diagnostic {
    line: sema_source_line_at(environment.source_segments, decided.use_span) ?? 0
    report: sema_error("E0112", span, "`{name}` is a {type_name(decided.ty)} for its use on line {line}, but this use needs a {type_name(wanted)}", "a `:=` number name takes the type of the first use that refuses its default, and one name holds one type", "convert the value at one of the two uses, or give each use its own name")
    diagnostic_with_label(report, decided.use_span, "this use makes `{name}` a {type_name(decided.ty)}")
}

// A write to the `:=` number name `name` whose value the type an earlier use
// decided refuses (`count := 0`, made a U8 by `take8(count)`, then
// `count = line.len()`): each E0108 reported since `since` at the written
// value or at the name also points at the use that decided the type.
sema_expr_number_label_write: fn(name: String, name_span: Span, value: Span, since: Int, scopes: SemaScopeTable, context: SemaCheckContext, diagnostics: &[Diagnostic]) {
    index: sema_scope_resolve_index(scopes, name) ?? return
    if !scopes.bindings[index].mutable || scopes.bindings[index].number_literal == None -> return
    binding: scopes.bindings[index].symbol.span
    loop decided in context.number_retypes_known {
        if !sema_expr_number_same_binding(decided.binding, binding) -> next
        loop at in since..<diagnostics.len() {
            reported: diagnostics[at].span ?? next
            if diagnostics[at].code != "E0108" || (reported.start != value.start && reported.start != name_span.start) -> next
            diagnostics[at] = diagnostic_with_label(diagnostics[at], decided.use_span, "this use makes `{name}` a {type_name(decided.ty)}")
        }
        return
    }
}

sema_expr_number_same_binding: fn(left: Span, right: Span) -> Bool Never! {
    left.start == right.start && left.end == right.end
}
