    fn bound_lambda_escapes(self, name: String, lambda: Lambda) -> Bool Never! {
        if self.stmt_tail_ptr.is_null() -> return true
        saw_direct_use := false
        saw_other_use := false
        inspect_tail :: |tail: [Stmt]| {
            loop stmt in tail {
                if !stmt_refs_name(stmt, name) -> continue
                if stmt_uses_name_only_as_direct_call(stmt, name) { saw_direct_use = true }
                else { saw_other_use = true }
            }
        }
        // GATE #4494: frame slices borrow the live Program AST; the recursive checker installs/restores them.
        #Unsafe("statement tail and liveness frames remain live during checking") {
            inspect_tail(from_raw_parts(self.stmt_tail_ptr, self.stmt_tail_len))
            loop (ptr, len) in self.liveness_frames.rev() {
                if !ptr.is_null() && len > 0 { inspect_tail(from_raw_parts(ptr, len)) }
            }
        }
        if saw_other_use || !saw_direct_use -> return true
        param_names := [String:Bool]{}
        take_names := [String:Bool]{}
        loop param in lambda.params { param_names[~param.name] = true }
        loop (capture, _) in lambda.take_names { take_names[~capture] = true }
        read_caps := [String:Bool]{}
        mut_caps := [String:Bool]{}
        lambda_collect_captures(lambda.body, param_names, &read_caps, &mut_caps)
        loop (capture, _) in lambda.take_names { read_caps[~capture] = true }
        written_locals := [String:Bool]{}
        loop capture in mut_caps.keys() {
            if param_names.has_key(capture) || take_names.has_key(capture) || self.is_view(capture) -> continue
            if self.lookup(capture) == .Val(info) && info.mutable && info.ty != .Shared { written_locals[~capture] = true }
        }
        loop capture in read_caps.keys().chain(mut_caps.keys()) {
            if param_names.has_key(capture) || take_names.has_key(capture) || self.is_view(capture) -> continue
            cap_ty := Type?{None}
            if self.lookup(capture) == .Val(info) { cap_ty = Val(info.ty) }
            else if self.consts.get(capture) == .Val(ty) { cap_ty = Val(ty) }
            if cap_ty != .Val(ty) -> continue
            if written_locals.has_key(capture) -> continue
            if written_locals.is_empty() && self.is_cloneable_type(ty) -> return true
            if self.is_resource_type(ty) && !mut_caps.has_key(capture) -> return true
        }
        false
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:600
    pub fn checked_comptime_nominals(self) -> MirFragmentNominalFacts? Never! {
        if self.modules != .Val(modules) -> return None
        checked_comptime_nominals_for_context(modules, self.module_idx, self.name_ledger)
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:611
pub fn checked_comptime_nominals_for_context(modules: [ModuleState], module_idx: Int, name_ledger: NameLedger) -> MirFragmentNominalFacts? Never! {
    if modules.get(module_idx) != .Val(current) -> return None
    reexports :: current.reexports
    struct_identities := [(Int, String):String]{}
    known_identities := [String:Bool]{}
    loop owner in 0..<modules.len() {
        loop item in modules[owner].items {
            name :: if item == { .Struct(def) -> def.name; .Enum(def) -> def.name; else -> continue }
            if name_ledger.nominal_identity(owner, name) != .Val(identity) -> continue
            struct_identities[(owner, ~name)] = ~identity
            known_identities[^identity] = true
        }
    }
    source_paths := [(Int, String):String]{}
    loop owner in 0..<modules.len() {
        loop (source, path) in name_ledger.canonical_paths(owner) {
            if known_identities.has_key(path) { source_paths[(owner, ^source)] = ^path }
        }
    }
    // Append-only queue plus cursor retains VecDeque's linear traversal.
    queue := [Int]{}
    queued := [Int:Bool]{}
    enqueue :: |target: Int| {
        if !queued.has_key(target) { queued[target] = true; queue.push(target) }
    }
    loop target in current.imports.values() { enqueue(target) }
    loop (_, target) in current.unqualified_file.values() { enqueue(target) }
    loop (_, target) in reexports.values() { enqueue(target) }
    loop module in current.core_imports.values() {
        if core_source_target(modules, module) == .Val(target) { enqueue(target) }
    }
    // A package is one namespace even before its import table is resolved.
    siblings :: name_ledger.namespace_siblings(module_idx)
    loop sibling in siblings { enqueue(sibling) }
    facts := MirFragmentNominalFacts.default()
    loop item in current.items {
        if item == .Enum(def) {
            row := ~def
            row.methods.clear()
            row.trait_impls.clear()
            row.derives.clear()
            facts.enums[~row.name] = ^row
        }
    }
    loop (alias, target) in current.imports {
        if modules.get(target) == .Val(state) { facts.import_modules[~alias] = ~state.module_alias }
    }
    loop (alias, module) in current.core_imports {
        if core_source_target(modules, module) == .Val(target) && modules.get(target) == .Val(state) {
            facts.import_modules[~alias] = ~state.module_alias
        }
    }
    cursor := 0
    loop cursor < queue.len() {
        target :: queue[cursor]
        cursor += 1
        if modules.get(target) != .Val(state) -> continue
        loop nested in state.imports.values() { enqueue(nested) }
        loop (_, nested) in state.unqualified_file.values() { enqueue(nested) }
        loop module in state.core_imports.values() {
            if core_source_target(modules, module) == .Val(nested) { enqueue(nested) }
        }
        if target == module_idx -> continue
        source_module :: CoreModuleExports.core_source_module_by_alias(state.module_alias)
        module_identity := ~state.module_path
        if name_ledger.module_identity(target) == .Val(identity) { module_identity = ^identity }
        body_module := MirFragmentCoreSourceModule{alias: ~state.module_alias, module_identity: ^module_identity, core_imports: ~state.core_imports, functions: [:], constants: [], module_imports: [:], imported_functions: [:], import_signatures: [:], nominal_identities: [:]}
        loop item in state.items {
            if item == .Const(constant) { body_module.constants.push(~constant); continue }
            if item != .Func(function) -> continue
            body_module.functions[~function.name] = ~function
            if source_module != .Val(source) -> continue
            if !function.is_pub || !CoreModuleExports.core_source_owns(source.module, function.name) -> continue
            facts.core_source_sigs[(~source.module, ~function.name)] = fragment_signature(function, target, modules, source_paths, struct_identities, known_identities)
        }
        row_key := ~state.module_alias
        if source_module == .Val(source) { row_key = ~source.module }
        else {
            (module_imports, imported_functions, import_signatures) :: fragment_module_imports(target, modules, source_paths, struct_identities, known_identities)
            body_module.module_imports = ^module_imports
            body_module.imported_functions = ^imported_functions
            body_module.import_signatures = ^import_signatures
            body_module.nominal_identities = fragment_module_nominals(target, modules, source_paths, struct_identities, known_identities)
        }
        // GATE #4494: Arc copy-on-write retains shared body rows and clones only on mutation.
        Arc.make_mut(&facts.core_source_bodies)[^row_key] = ^body_module
        source_leaf_visible :: |name: String| {
            if source_module == .Val(source) -> return CoreModuleExports.core_leaf_kind(source.module, name).is_some()
            true
        }
        canonical :: |ty: Type| canonical_fragment_type(ty, target, modules, source_paths, struct_identities, known_identities)
        loop item in state.items {
            if item == .Enum(def) {
                if !source_leaf_visible(def.name) -> continue
                if struct_identities.get((target, def.name)) != .Val(identity) -> continue
                row := ~def
                row.name = ~identity
                row.methods.clear()
                row.trait_impls.clear()
                row.derives.clear()
                loop variant in &row.variants {
                    if variant.payload == {
                        .Unit -> {}
                        .Single(ty, _) -> ty = canonical(ty)
                        .Named(fields) -> { loop field in &fields { field.ty = canonical(field.ty) } }
                    }
                }
                facts.foreign_modules[~identity] = ~state.module_alias
                if !facts.enums.has_key(identity) { facts.enums[~identity] = ^row }
                continue
            }
            if item != .Struct(def) -> continue
            if !source_leaf_visible(def.name) -> continue
            if struct_identities.get((target, def.name)) != .Val(identity) -> continue
            row := ~def
            row.name = ~identity
            row.methods.clear()
            row.trait_impls.clear()
            row.derives.clear()
            loop field in &row.fields { field.ty = canonical(field.ty) }
            facts.foreign_modules[~identity] = ~state.module_alias
            if !facts.structs.has_key(identity) { facts.structs[~identity] = ^row }
        }
    }
    (_, imported_functions, import_signatures) :: fragment_module_imports(module_idx, modules, source_paths, struct_identities, known_identities)
    facts.imported_functions = ^imported_functions
    facts.import_signatures = ^import_signatures
    foreign_identities := [String:Bool]{}
    loop identity in facts.foreign_modules.keys() {
        foreign_identities[~identity] = true
        facts.nominal_identities[~identity] = ~identity
    }
    loop (source, path) in name_ledger.canonical_paths(module_idx) {
        if foreign_identities.has_key(path) { facts.nominal_identities[^source] = ^path }
    }
    loop (alias, target) in current.imports {
        loop ((owner, leaf), identity) in struct_identities {
            if owner == target && foreign_identities.has_key(identity) { facts.nominal_identities[alias + "." + leaf] = ~identity }
        }
    }
    loop (alias, module) in current.core_imports {
        if core_source_target(modules, module) != .Val(target) -> continue
        loop ((owner, leaf), identity) in struct_identities {
            if owner == target && foreign_identities.has_key(identity) { facts.nominal_identities[alias + "." + leaf] = ~identity }
        }
    }
    loop (local, original) in current.core_item_imports {
        if current.core_imports.get(local) != .Val(module) -> continue
        if core_source_target(modules, module) != .Val(target) -> continue
        leaf := original
        if original.rsplit_once('.') == .Val((_, last)) { leaf = last }
        if struct_identities.get((target, leaf)) == .Val(identity) && foreign_identities.has_key(identity) {
            facts.nominal_identities[~local] = ~identity
        }
    }
    loop (local, (original, target)) in current.unqualified_file {
        if struct_identities.get((target, original)) == .Val(identity) && foreign_identities.has_key(identity) {
            facts.nominal_identities[~local] = ~identity
        }
    }
    loop sibling in siblings {
        if modules.get(sibling) != .Val(state) -> continue
        loop item in state.items {
            name :: if item == { .Struct(def) -> def.name; .Enum(def) -> def.name; else -> continue }
            if struct_identities.get((sibling, name)) == .Val(identity) && foreign_identities.has_key(identity) && !facts.nominal_identities.has_key(name) {
                facts.nominal_identities[~name] = ~identity
            }
        }
    }
    loop (local, (original, target)) in reexports {
        if struct_identities.get((target, original)) == .Val(identity) && foreign_identities.has_key(identity) {
            facts.nominal_identities[~local] = ~identity
        }
    }
    Val(^facts)
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:989
fn direct_fixed_constructor(expr: Expr) -> Bool Never! {
    if expr != .MethodCall -> return false
    if expr.receiver != .Field(_, name, _) -> return false
    name == "Fixed" && (expr.method == "new" || expr.method == "over")
}
impl Checker {
    // Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:999
    fn normalized_path_string_source(self, expr: Expr) -> String? Never! {
        outer :: expr.without_parens()
        if outer != .MethodCall || outer.method != "to_string" || !outer.args.is_empty() -> return None
        normalized :: outer.receiver.without_parens()
        if normalized != .MethodCall || normalized.method != "normalize" || !normalized.args.is_empty() -> return None
        if self.registry.contains("Path") -> return None
        path :: normalized.receiver
        constructor :: path.without_parens()
        direct_path_constructor :: constructor == .MethodCall && constructor.method == "from" && constructor.args.len() == 1 && constructor.receiver.without_parens() == .Ident("Path", _) && !self.registry.contains("Path")
        if normalized.recv_type != Val("Path") && !direct_path_constructor -> return None
        start :: source_expr_start(path)
        if source_expr_end(self.source, normalized) != .Val(end) -> return None
        if self.source.get(start..<end) == .Val(text) -> return Val(text.to_string())
        None
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:1053
fn interrupt_callback_name(expr: Expr) -> String? Never! from expr {
    if expr == { .Ident(name, _) -> Val(name); .Paren(inner, _) -> interrupt_callback_name(inner); else -> None }
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:1061
fn interrupt_callback_lambda(expr: Expr) -> Lambda? Never! from expr {
    if expr == { .Lambda(lambda) -> Val(lambda); .Paren(inner, _) -> interrupt_callback_lambda(inner); else -> None }
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:1069
fn contains_taskgroup(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> name == Syntax.TYPE_TASKGROUP
        .List(inner), .Shared(inner), .Option(inner), .FixedList(inner, _), .Tagged(_, inner), .InlineRange(inner, _, _) -> contains_taskgroup(inner)
        .Map(key, _, value), .Result(key, value) -> contains_taskgroup(key) || contains_taskgroup(value)
        // Signatures have their own Group parameter/return checks.
        .Fn -> false
        .Apply(_, args), .Union(args) -> {
            loop arg in args { if contains_taskgroup(arg) -> return true }
            false
        }
        .Tuple(fields) -> {
            loop (_, field) in fields { if contains_taskgroup(field) -> return true }
            false
        }
        .Int, .Float, .Bool, .String, .Char, .TraitObject, .IntN, .Float32, .Quantity, .Measure -> false
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:1100
pub fn check_meta_attr_fields(meta: MetaAttr) -> [Diagnostic] Never! {
    diags := [Diagnostic]{}
    seen_category := false
    seen_tunable := false
    seen_maturity := false
    loop field in meta.fields {
