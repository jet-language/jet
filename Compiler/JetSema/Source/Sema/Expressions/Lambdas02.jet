            }
            .Tunable(span) -> {
                if seen_tunable { diags.push(Diagnostic.error("E0346", "`#Meta` repeats `tunable`", "`tunable` is a flag; writing it twice does not add meaning", "keep one `tunable` field", Val(span))) }
