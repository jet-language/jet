impl Checker {
    // Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:1241
    pub fn ct_value_fits_binding(self, value: CtValue, ty: Type) -> Bool Never! {
        if ty == .Named(name) && name.ends_with(".Patch") -> return false
        if !self.ct_value_is_emittable(value) -> return false
        if value == {
            .List, .Bytes -> ty == .List || ty == .FixedList
            .Map -> ty == .Map
            .Present -> ty == .Option || ty == .Result
            .Failed(.Clean(_)) -> ty == .Option
            .Failed(.Told(_)) -> ty == .Result
            // Unit placeholders for procedural guard registrations must not become a non-Unit literal.
            .Unit -> ty == Type.Named("Unit")
            else -> true
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:1279
    pub fn ct_value_is_emittable(self, value: CtValue) -> Bool Never! {
        if value == {
            .Struct(type_name, fields) -> {
                if !self.registry.is_user_struct(type_name) || self.registry.is_published_schema_struct(type_name) -> return false
                loop (_, field) in fields { if !self.ct_value_is_emittable(field) -> return false }
                true
            }
            .Enum(type_name, _, args) -> {
                if !self.registry.is_user_enum(type_name) -> return false
                loop (_, arg) in args { if !self.ct_value_is_emittable(arg) -> return false }
                true
            }
            .List(items) -> {
                loop item in items { if !self.ct_value_is_emittable(item) -> return false }
                true
            }
            .Map(entries) -> {
                loop entry in entries.values() { if !self.ct_value_is_emittable(entry) -> return false }
                true
            }
            .Present(inner), .Failed(.Told(inner)) -> self.ct_value_is_emittable(inner)
            .Closure -> false
            else -> true
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:1315
    pub fn check_meta_attr(&self, meta: &MetaAttr) Never! {
        if self.take_rule_fact(Syntax.MARKER_META, meta.span) == .Val(marker) {
            if self.validate_rule_signature(&marker) != .Val(arguments) -> return
            normalized := [MetaField].with_capacity(meta.fields.len())
            loop (source_index, field) in meta.fields.drain(..).enumerate() {
                parameter := Int?{None}
                loop binding in arguments.bindings {
                    if binding.source_index == source_index { parameter = binding.parameter_index; break }
                }
                constant :: arguments.constant_for_source(source_index)
                if parameter == Val(0) && constant == .Val(.Str(value)) && field == .Category(expression, _) {
                    span :: expression.span()
                    expression = Expr.Str([StrPart.Lit(~value)], span)
                    normalized.push(^field)
                } else if parameter == Val(1) && constant == .Val(.Bool(true)) {
                    normalized.push(MetaField.Tunable(marker.args[source_index].span()))
                } else if parameter == Val(1) && constant == .Val(.Bool(false)) {
                    // A known false tunable flag is absent, exactly as in the source.
                } else { normalized.push(^field) }
            }
            meta.fields = ^normalized
        }
        self.diags.extend(check_meta_attr_fields(meta))
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:1362
    pub fn check_uninit_binding(&self, b: &Binding) Never! {
        has_mem := false
        loop module in self.core_imports.values() { if module == Syntax.CORE_MEM_MODULE { has_mem = true; break } }
        if !has_mem {
            self.diags.push(Diagnostic.error("E0424", "`" + Syntax.KW_UNINIT + "` needs the low-level memory tier", "`" + Syntax.KW_UNINIT + "` skips the automatic zero-fill — an expert-tier operation", "add `use " + Syntax.CORE_MEM_MODULE + "` at the top of this file to opt in", Val(b.name_span)))
        }
        if b.ty != .Val(t) || b.ty_span != .Val(ty_span) -> return
        ty :: self.resolve_type(~t)
        b.ty = Val(~ty)
        self.check_declared_type(ty, ty_span)
        if !is_pod_uninit_type(ty) {
            self.diags.push(Diagnostic.error("E0423", "`" + Syntax.KW_UNINIT + "` needs a plain-data type", "`" + ty.show() + "` may own heap memory or need cleanup, so leaving it uninitialized is unsafe", "use plain data — a number, `Bool`, `Char`, `U8`, or a fixed array of those (e.g. `[4096]U8`)", Val(ty_span)))
        }
        state :: if ty == { .FixedList(_, len) -> UninitState.fixed(len.require_literal()); else -> UninitState.scalar() }
        self.declare(b.name, b.name_span, LocalInfo{def_span: b.name_span, binding_sigil_span: b.sigil_span, ty: ^ty, mutable: true, param_conv: None, decl_loop_depth: self.loop_depth, interrupt_sendable: false, reactive_local: false, reactive_shared: false, single_use_span: None, invalid: false})
        self.flow.uninit.set(b.name, ^state)
