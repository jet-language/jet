                    if parts.len() == 1 && parts[0] == .Lit(s) {
                        if s.is_empty() { diags.push(Diagnostic.error("E0348", "`#Meta` category cannot be empty", "Canvas groups use this text as a visible label", "write a non-empty category, e.g. `category: \"Movement\"`", Val(value.span()))) }
                    } else {
                        diags.push(Diagnostic.error("E0347", "`#Meta` category needs plain quoted text", "`category` is compile-time tooling data, not a runtime string", "write a string literal, e.g. `category: \"Movement\"`", Val(value.span())))
                    }
                } else {
                    diags.push(Diagnostic.error("E0347", "`#Meta` category needs plain quoted text", "`category` is compile-time tooling data, not a runtime value", "write a string literal, e.g. `category: \"Movement\"`", Val(value.span())))
