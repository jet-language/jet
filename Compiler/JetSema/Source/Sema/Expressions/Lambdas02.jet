// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:14
fn core_source_target(modules: [ModuleState], module: String) -> Int? Never! {
    if CoreModuleExports.core_source_module(module) != .Val(source) -> return None
    loop index in 0..<modules.len() { if modules[index].module_alias == source.alias -> return Val(index) }
    None
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:21
fn canonical_fragment_name(owner: Int, name: String, modules: [ModuleState], source_paths: [(Int, String):String], struct_identities: [(Int, String):String], known_identities: [String:Bool]) -> String? Never! {
    // GATE #4499: tuple keys keep their exact equality/hash, not a string encoding.
    if known_identities.has_key(name) -> return Val(~name)
    if source_paths.get((owner, name)) == .Val(identity) -> return Val(~identity)
    if name.rsplit_once('.') == .Val((namespace, leaf)) {
        if modules.get(owner) != .Val(state) -> return None
        target := state.imports.get(namespace)
        if target.is_none() && state.core_imports.get(namespace) == .Val(module) { target = core_source_target(modules, module) }
        if target == .Val(index) && struct_identities.get((index, leaf)) == .Val(identity) -> return Val(~identity)
    }
    if modules.get(owner) == .Val(state) && state.core_item_imports.get(name) == .Val(original) {
        if state.core_imports.get(name) != .Val(module) -> return None
        if core_source_target(modules, module) != .Val(target) -> return None
        leaf := original
        if original.rsplit_once('.') == .Val((_, last)) { leaf = last }
        if struct_identities.get((target, leaf)) == .Val(identity) -> return Val(~identity)
    }
    if struct_identities.get((owner, name)) == .Val(identity) -> return Val(~identity)
    None
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:64
fn canonical_fragment_type(ty: Type, owner: Int, modules: [ModuleState], source_paths: [(Int, String):String], struct_identities: [(Int, String):String], known_identities: [String:Bool]) -> Type Never! {
    canonical :: |inner: Type| canonical_fragment_type(inner, owner, modules, source_paths, struct_identities, known_identities)
    map_name :: |name: String| canonical_fragment_name(owner, name, modules, source_paths, struct_identities, known_identities)
    if ty == {
        .Named(name) -> { if map_name(name) == .Val(mapped) -> return Type.Named(^mapped); ~ty }
        .List(inner) -> Type.List(canonical(inner))
        .Map(key, key_span, value) -> Type.Map(canonical(key), key_span, canonical(value))
        .Shared(inner) -> Type.Shared(canonical(inner))
        .Option(inner) -> Type.Option(canonical(inner))
        .Result(ok, err) -> Type.Result(canonical(ok), canonical(err))
        .Fn -> {
            params := [Type]{}
            loop param in ty.params { params.push(canonical(param)) }
            ret := Type?{None}
            if ty.ret == .Val(value) { ret = Val(canonical(value)) }
            Type.Fn{params: ^params, ret: ^ret, effect_bound: ~ty.effect_bound, param_contract: ~ty.param_contract, call_metadata: ~ty.call_metadata, return_view_provenance: ~ty.return_view_provenance}
        }
        .Apply(name, args) -> {
            mapped := ~name
            if map_name(name) == .Val(identity) { mapped = ^identity }
            parameters := [Type]{}
            loop arg in args { parameters.push(canonical(arg)) }
            Type.Apply(^mapped, ^parameters)
        }
        .Tuple(fields) -> {
            result := [(String, Type)]{}
            loop (name, field) in fields { result.push((~name, canonical(field))) }
            Type.Tuple(^result)
        }
        .FixedList(elem, len) -> Type.FixedList(canonical(elem), ~len)
        .InlineRange(base, lo, hi) -> Type.InlineRange(canonical(base), lo, hi)
        .Tagged(marker, inner) -> Type.Tagged(~marker, canonical(inner))
        .Union(members) -> {
            result := [Type]{}
            loop member in members { result.push(canonical(member)) }
            canonicalize_union(^result)
        }
        .Quantity(base, dimension) -> Type.Quantity(canonical(base), ~dimension)
        else -> ~ty
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:285
fn fragment_signature(function: Func, owner: Int, modules: [ModuleState], source_paths: [(Int, String):String], struct_identities: [(Int, String):String], known_identities: [String:Bool]) -> MirFragmentCoreSourceSignature Never! {
    canonical :: |ty: Type| canonical_fragment_type(ty, owner, modules, source_paths, struct_identities, known_identities)
    type_params := [String]{}
    loop param in function.type_params { type_params.push(~param.name) }
    params := [(AccessConvention, Type)]{}
    loop param in function.params {
        ty :: if param.variadic { Type.List(~param.ty) } else { ~param.ty }
        params.push((param.convention, canonical(ty)))
    }
    return_type := Type?{None}
    if function.return_type == .Val(ty) { return_type = Val(canonical(ty)) }
    MirFragmentCoreSourceSignature{type_params: ^type_params, params: ^params, return_type: ^return_type}
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:327
// GATE #4499: the (alias, function) key is a tuple, with canonical map equality.
type FragmentImportSignatures = [(String, String):MirFragmentCoreSourceSignature]
// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:334
fn fragment_module_imports(owner: Int, modules: [ModuleState], source_paths: [(Int, String):String], struct_identities: [(Int, String):String], known_identities: [String:Bool]) -> ([String:String], [String:(String, String)], FragmentImportSignatures) Never! {
    module_imports := [String:String]{}
    imported_functions := [String:(String, String)]{}
    signatures := FragmentImportSignatures{}
    if modules.get(owner) != .Val(state) -> return (^module_imports, ^imported_functions, ^signatures)
    loop (alias, target) in state.imports {
        if modules.get(target) != .Val(target_state) -> continue
        if CoreModuleExports.core_source_module_by_alias(target_state.module_alias).is_some() -> continue
        module_imports[~alias] = ~target_state.module_alias
        loop item in target_state.items {
            if item == .Func(function) { signatures[(~alias, ~function.name)] = fragment_signature(function, target, modules, source_paths, struct_identities, known_identities) }
        }
    }
    loop (local, (name, target)) in state.unqualified_file {
        if modules.get(target) != .Val(target_state) -> continue
        if CoreModuleExports.core_source_module_by_alias(target_state.module_alias).is_some() -> continue
        loop item in target_state.items {
            if item == .Func(function) && function.name == name {
                imported_functions[~local] = (~target_state.module_alias, ~name)
                signatures[(~local, ~name)] = fragment_signature(function, target, modules, source_paths, struct_identities, known_identities)
                break
            }
        }
    }
    (^module_imports, ^imported_functions, ^signatures)
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:405
fn fragment_module_nominals(owner: Int, modules: [ModuleState], source_paths: [(Int, String):String], struct_identities: [(Int, String):String], known_identities: [String:Bool]) -> [String:String] Never! {
    identities := [String:String]{}
    loop identity in known_identities.keys() { identities[~identity] = ~identity }
    loop ((module, source), path) in source_paths { if module == owner { identities[~source] = ~path } }
    loop ((module, leaf), identity) in struct_identities { if module == owner { identities[~leaf] = ~identity } }
    if modules.get(owner) == .Val(state) {
        loop (alias, target) in state.imports {
            loop ((module, leaf), identity) in struct_identities {
                if module == target { identities[alias + "." + leaf] = ~identity }
            }
        }
    }
    identities
}
