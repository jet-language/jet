//RS impl<'a> Checker<'a> {
//RS     /// Can codegen write this folded value back out as Rust?
//RS     ///
//RS     /// `CtValue::serialize` renders a struct or enum as `__jet_<Name> { … }`,
//RS     /// which only names a real Rust type when `<Name>` is a user-declared type.
//RS     /// The comptime evaluator also models builtins as structs with an internal
//RS     /// field encoding, and those have no such Rust type. A container is only
//RS     /// emittable when everything inside it is.
//RS     /// As `ct_value_is_emittable`, and additionally that the value's literal
//RS     /// form has the Rust type this binding declares. `Iter<T>` lowers to
//RS     /// `JetIter<T>` but folds to a plain list, so writing the list back out
//RS     /// would assign a `Vec` to a `JetIter` binding.
//RS     pub(crate) fn ct_value_fits_binding(&self, value: &crate::AST::CtValue, ty: &Type) -> bool {
//RS         use crate::AST::{CtReport, CtValue};
//RS         // D-PATCH1: patch literals are intentionally partial source values.
//RS         // Their runtime carrier completes omitted fields, so a raw comptime
//RS         // struct would erase that shape and emit missing/mismatched fields.
//RS         if matches!(ty, Type::Named(name) if name.ends_with(".Patch")) {
//RS             return false;
//RS         }
//RS         if !self.ct_value_is_emittable(value) {
//RS             return false;
//RS         }
//RS         match (value, ty) {
//RS             (CtValue::List(_) | CtValue::Bytes(_), Type::List(_) | Type::FixedList { .. }) => true,
//RS             (CtValue::List(_) | CtValue::Bytes(_), _) => false,
//RS             (CtValue::Map(_), Type::Map { .. }) => true,
//RS             (CtValue::Map(_), _) => false,
//RS             // D-FAIL-CARRIER1=A: one carrier, so a payload fits either view of
//RS             // it; only the report says which view the value came from.
//RS             (CtValue::Present(_), Type::Option(_) | Type::Result { .. }) => true,
//RS             (CtValue::Present(_), _) => false,
//RS             (CtValue::Failed(CtReport::Clean(_)), Type::Option(_)) => true,
//RS             (CtValue::Failed(CtReport::Clean(_)), _) => false,
//RS             (CtValue::Failed(CtReport::Told(_)), Type::Result { .. }) => true,
//RS             (CtValue::Failed(CtReport::Told(_)), _) => false,
//RS             // A folded Unit is a real value only when the binding is itself
//RS             // Unit-typed. `CtValue::Unit` also stands in as a placeholder for
//RS             // constructs the evaluator can't represent as a literal (e.g. a
//RS             // `scope.guard`/`on_commit`/`on_rollback` closure registration —
//RS             // eval/exprs.rs pushes the guard and returns `Ok(CtValue::Unit)`
//RS             // because real execution drains it procedurally at scope exit).
//RS             // Accepting that placeholder as a fold for a non-Unit binding
//RS             // would serialize a bare `()` in place of the real construct.
//RS             (CtValue::Unit, Type::Named(n)) if n == "Unit" => true,
//RS             (CtValue::Unit, _) => false,
//RS             _ => true,
//RS         }
//RS     }
