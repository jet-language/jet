//RS fn contains_taskgroup(ty: &Type) -> bool {
//RS     match ty {
//RS         Type::Named(name) => name == Syntax::TYPE_TASKGROUP,
//RS         Type::List(inner)
//RS         | Type::Shared(inner)
//RS         | Type::Option(inner)
//RS         | Type::FixedList { elem: inner, .. }
//RS         | Type::Tagged { inner, .. }
//RS         | Type::InlineRange { base: inner, .. } => contains_taskgroup(inner),
//RS         Type::Map { key, value, .. }
//RS         | Type::Result {
//RS             ok: key,
//RS             err: value,
//RS         } => contains_taskgroup(key) || contains_taskgroup(value),
//RS         // Function signatures have their own direct Group parameter/return
//RS         // checks; do not duplicate those diagnostics at the binding site.
//RS         Type::Fn { .. } => false,
//RS         Type::Apply { args, .. } | Type::Union(args) => args.iter().any(contains_taskgroup),
//RS         Type::Tuple(fields) => fields.iter().any(|(_, field)| contains_taskgroup(field)),
//RS         Type::Int
//RS         | Type::Float
//RS         | Type::Bool
//RS         | Type::String
//RS         | Type::Char
//RS         | Type::TraitObject(_)
//RS         | Type::IntN { .. }
//RS         | Type::Float32 => false,
//RS         Type::Quantity { .. } => false,
//RS         Type::Measure(_) => false,
//RS     }
//RS }
