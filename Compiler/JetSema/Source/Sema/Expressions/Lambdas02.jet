    // Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:1429
    pub fn clear_uninit_mut_args(&self, args: [CallArg]) Never! {
        if self.flow.uninit.is_empty() -> return
        loop arg in args {
            if arg.convention == AccessConvention.Write && arg.expr == .Ident(n, span) && self.flow.uninit.contains(n) {
                self.diags.push(Diagnostic.error("E0420", "`" + n + "` may be read before it is given a value", "passing `" + n + "` with write access does not prove that the callee initializes it", "write every value in `" + n + "` here before passing it to another function", Val(span)))
            }
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:1458
    pub fn check_refutable_binding(&self, b: &Binding) Never! {
        pattern_copy :: ~b.pattern
        if pattern_copy != .Val(.Refutable(pattern, fallback, names, span, synthesized)) -> return
        subject_span :: b.init.span()
        subject := ^b.init
        b.init = Expr.Absent(subject_span)
        (subject_ty, bindings) :: self.check_pattern_test_typed(&subject, &pattern, span)
        b.init = ^subject
        if subject_ty != .Val(ty) {
            loop name in names { self.declare_bound(name.local_name(), name.span, Type.Int, false, b.sigil_span) }
            return
        }
        self.check_diverging_fallback(&fallback, ty, span)
        if b.pattern == .Val(.Refutable(stored_pattern, stored_fallback, _, _, _)) {
            stored_pattern = ^pattern
            stored_fallback = ^fallback
        }
        loop name in names {
            binding_ty := Type.Int
            if bindings.get(name.local_name()) == .Val(found) { binding_ty = ~found }
            else if bindings.get(name.name) == .Val(found) { binding_ty = ~found }
            refines_subject :: synthesized && b.init == .Ident(subject_name, _) && subject_name == name.local_name() && self.is_optional_flow_refine(name.local_name(), binding_ty)
            if refines_subject {
                self.flow.moved.remove(name.local_name())
                self.record_optional_flow_narrow(name.local_name(), name.span, ^binding_ty)
            } else { self.declare_bound(name.local_name(), name.span, ^binding_ty, false, b.sigil_span) }
        }
    }
