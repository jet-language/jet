fn direct_call_is_name(expr: Expr, name: String) -> Bool Never! {
    if expr == { .Ident(candidate, _) -> candidate == name; .Paren(inner, _) -> direct_call_is_name(inner, name); else -> false }
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:481
// The identical nested is_name helper uses direct_call_is_name above.
// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:442
fn stmt_uses_name_only_as_direct_call(stmt: Stmt, name: String) -> Bool Never! {
    nested_capture := false
    stmt.for_each_expr(|expr: Expr| {
        if expr != .Lambda(lambda) -> return
        loop param in lambda.params { if param.name == name -> return }
        taken := false
        loop (capture, _) in lambda.take_names { if capture == name { taken = true; break } }
        if !taken && !lambda_body_refs_name(lambda.body, name) -> return
        nested_capture = true
    })
    if nested_capture -> return false
    residual := ~stmt
    residual.for_each_expr_mut(|expr: &Expr| {
        direct :: if expr == {
            .Call(call) -> call.name == name
            .CallValue(callee, _) -> direct_call_is_name(callee, name)
            .MethodCall -> expr.method == "call" && direct_call_is_name(expr.receiver, name)
            else -> false
        }
        if direct { span :: expr.span(); expr = Expr.Absent(span) }
    })
    !stmt_refs_name(residual, name)
}
