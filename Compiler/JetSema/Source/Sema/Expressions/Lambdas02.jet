            }
            .Maturity(value, span) -> {
                if seen_maturity { diags.push(Diagnostic.error("E0346", "`#Meta` repeats `maturity`", "a declaration has one maturity value", "keep one `maturity: .Experimental`, `.Tested`, or `.Hardened` field", Val(span))) }
                seen_maturity = true
                valid :: value == .EnumLit && value.type_name.is_empty() && value.args.is_empty() && (value.variant == Syntax.MARKER_EXPERIMENTAL || value.variant == Syntax.MARKER_TESTED || value.variant == Syntax.MARKER_HARDENED)
                if !valid { diags.push(Diagnostic.error("E0352", "`#Meta` maturity needs a known maturity value", "maturity metadata is a closed documentation scale", "write `maturity: .Experimental`, `.Tested`, or `.Hardened`", Val(value.span()))) }
            }
            .Unknown(name, span, _) -> {
                suggestion := String?{None}
                if edit_distance(name, Syntax.META_FIELD_CATEGORY) <= 2 { suggestion = Val(Syntax.META_FIELD_CATEGORY) }
                else if edit_distance(name, Syntax.META_FIELD_TUNABLE) <= 2 { suggestion = Val(Syntax.META_FIELD_TUNABLE) }
                else if edit_distance(name, Syntax.META_FIELD_MATURITY) <= 2 { suggestion = Val(Syntax.META_FIELD_MATURITY) }
                fix :: if suggestion == {
                    .Val(candidate) -> "did you mean `" + candidate + "`?"
                    .None -> "use one of `" + Syntax.META_FIELD_CATEGORY + "`, `" + Syntax.META_FIELD_TUNABLE + "`, `" + Syntax.META_FIELD_MATURITY + "`"
