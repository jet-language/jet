// A field as a value: the prelude's `FieldRef<Model, T>`. Where one is
// expected (a parameter, field or result), a bare `.name` is one: `.carrier`
// names `Model`'s stored field `carrier`, visible where the dot is written,
// and settles `T` as that field's type. A name `Model` doesn't declare is
// E0302 at the dot, listing the fields it does; a chain (`.carrier.text`), a
// call (`.carrier()`) or an upper-case selector (`.Carrier`) names no field.
// A computed field stores nothing, so it is no `FieldRef` either.
//
// Inside a loop with no binding a bare `.name` reads the loop's item (`it`)
// before any expected type does, so there it is no field reference; the
// error says so and names `it`.
//
// The value is the struct literal of `FieldRef`'s one private field, `name`:
// the field's declared name. Only the compiler writes that literal; no text
// becomes a `FieldRef`.
use jet_foundation.[
    Diagnostic,
    Expr,
    Field,
    Span,
    SymbolKind,
    TextEdit,
    Type,
    core_identity_in_module,
    diagnostic_with_edit,
    expr_source_start,
    expr_span,
    type_name,
]

// Whether `wanted` is the prelude's `FieldRef<M, T>` as resolved: a resolved
// Core nominal is spelled `<module>.<leaf>`.
sema_field_ref_resolved: fn(wanted: Type) -> Bool Never! {
    if wanted == .Apply(written, args) -> return args.len() == 2 && sema_field_ref_name(written)
    false
}

// The prelude's `FieldRef<M, T>`, resolved, when `wanted` is one written
// unresolved; None when it is none, or is one resolved already
// (sema_field_ref_resolved). Only a name ending in the leaf is resolved,
// which keeps the test off every other type.
sema_field_ref_resolve: fn(wanted: Type, check: SemaBodyCheck) -> Type? {
    if wanted == .Apply(written, args) && args.len() == 2 && written.ends_with("FieldRef") && !sema_field_ref_name(written) {
        resolved: sema_expr_expected_type(wanted, check.environment.*, check.program.*)
        if resolved == .Apply(name, _) && sema_field_ref_name(name) -> return Val(resolved)
    }
    None
}

sema_field_ref_name: fn(name: String) -> Bool Never! {
    name.ends_with(".FieldRef") && core_identity_in_module(name, "core.prelude")
}

// Whether `expr` is written as a field selector: a bare member chain or a
// leading-dot upper-case name. Only these meet the `FieldRef` rule; any other
// argument is an ordinary value of the parameter's type.
sema_field_ref_selector: fn(expr: Expr) -> Bool Never! {
    if sema_expr_is_bare_member_chain(expr) -> return true
    if expr == .EnumLit(type_name, _, _, _, leading_dot, _, _) {
        return leading_dot && type_name == ""
    }
    false
}

// The type a selector `expr` has where `ref_type` (a resolved `FieldRef<M,
// T>`) is expected: `FieldRef<M, F>` for `M`'s field of type `F`. None after
// a diagnostic in `diagnostics` when it names no field of `M`.
sema_field_ref_probe: fn(expr: Expr, ref_type: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> Type? {
    fact: sema_field_ref_field(expr, ref_type, environment, program, scopes, context, diagnostics) ?? return None
    sema_field_ref_value_type(ref_type, fact.field_ty)
}

// `FieldRef<M, field_ty>` from a resolved `FieldRef<M, T>`; None for any
// type that is not applied.
sema_field_ref_value_type: fn(ref_type: Type, field_ty: Type) -> Type? Never! {
    if ref_type == .Apply(name, args) {
        return Val(Type.Apply{name: name, args: [Type]{args[0].copy(), field_ty}})
    }
    None
}

// A selector where a `FieldRef<M, T>` is expected: the field reference it
// names, checked against `expected`. Unhandled for any other expression or
// expectation.
sema_field_ref_check: fn(expr: Expr, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    wanted: expected ?? return SemaDirectSpecialCheck{handled: false, value: None}
    if !sema_field_ref_selector(expr) -> return SemaDirectSpecialCheck{handled: false, value: None}
    if sema_field_ref_resolved(wanted) {
        return sema_field_ref_check_as(expr, wanted, expected, check)
    }
    ref_type: sema_field_ref_resolve(wanted, check) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    sema_field_ref_check_as(expr, ref_type, expected, check)
}

// The selector `expr` checked as the resolved `FieldRef<M, T>` `ref_type`.
sema_field_ref_check_as: fn(expr: Expr, ref_type: Type, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    fact: sema_field_ref_field(expr, ref_type, check.environment.*, check.program.*, check.scopes, check.context, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    member_span: expr_span(expr)
    value_type: sema_field_ref_value_type(ref_type, fact.field_ty) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    value: sema_field_ref_value(value_type, fact.symbol.name, member_span, check)
    check.context.name_references.push(sema_name_reference(member_span, fact.symbol, Val(SymbolKind.Field)))
    checked: value ?? return SemaDirectSpecialCheck{handled: true, value: None}
    SemaDirectSpecialCheck{handled: true, value: sema_expr_expected_owned(checked, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// `M`'s stored field the selector `expr` names, `M` being `ref_type`'s
// model. None after a diagnostic at the selector.
sema_field_ref_field: fn(expr: Expr, ref_type: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> SemaStructFieldFact? {
    if ref_type == .Apply(_, ref_args) && ref_args.len() == 2 {
        model: ref_args[0]
        span: Span{start: expr_source_start(expr), end: expr_span(expr).end}
        chain: if expr == .EnumLit(_, variant, _, _, _, _, _) -> ".{variant}" else -> sema_expr_bare_member_chain_text(expr)
        if context.implicit_loop_subject_depth > 0 && sema_expr_is_bare_member_chain(expr) {
            diagnostics.push(sema_error("E-SUBJECT-CALL", span, "`{chain}` reads the loop's item `it` here, not a field of `{type_name(model)}`", "inside a loop with no binding a bare `.name` is `it{chain}`, a value of the item, before any expected type makes it a field reference", "name the loop's binding (`loop item in …`) so `{chain}` names the field, or write the item's field as `it{chain}`"))
            return None
        }
        if model == .Named(name) {
            return sema_field_ref_owner_field(expr, model, name, [Type]{}, chain, span, environment, program, scopes, context, diagnostics)
        }
        if model == .Apply(name, args) {
            return sema_field_ref_owner_field(expr, model, name, args, chain, span, environment, program, scopes, context, diagnostics)
        }
        diagnostics.push(sema_field_ref_no_struct(chain, model, span))
    }
    None
}

// The field the selector `expr` (written `chain` at `span`) names of
// `model`, the type `owner_name` applied to `owner_args`.
sema_field_ref_owner_field: fn(
    expr: Expr,
    model: Type,
    owner_name: String,
    owner_args: [Type],
    chain: String,
    span: Span,
    environment: SemaScopeEnvironment,
    program: SemaProgramTables,
    scopes: ^SemaScopeTable,
    context: ^SemaCheckContext,
    diagnostics: ^[Diagnostic],
) -> SemaStructFieldFact? {
    if owner_name == "" || sema_type_name_is_generic(environment.generic_params, owner_name) {
        diagnostics.push(sema_field_ref_no_struct(chain, model, span))
        return None
    }
    owner_symbol: sema_expression_type_symbol(scopes, environment, program, owner_name) ?? {
        diagnostics.push(sema_field_ref_no_struct(chain, model, span))
        return None
    }
    struct_def: sema_scope_declaration_struct(environment, program, owner_symbol.id) ?? {
        diagnostics.push(sema_field_ref_no_struct(chain, model, span))
        return None
    }
    shown: owner_symbol.name
    sees_private: sema_expr_sees_private_fields(context)
    // The rows of the stored fields visible at the selector.
    visible: loop (row, field) in struct_def.fields -> {
        if field.computed != None -> next
        if !sema_expression_field_visible(field.is_pub, field.is_package_pub, owner_symbol.module_identity, struct_def.inline_module, span, sees_private, environment, program) {
            next
        }
        row
    }
    if expr == .Field(base, member, _, _) && sema_expr_is_bare_subject(base) {
        names: loop param in struct_def.type_params -> param.name
        loop field in struct_def.fields {
            if field.name != member -> next
            if field.computed != None {
                diagnostics.push(sema_error("E0302", span, "`{chain}` is a computed field of `{shown}`", "a field reference names a stored field; a computed field stores nothing to name", "name one of `{shown}`'s stored fields: {sema_field_ref_list(struct_def.fields, visible)}"))
                return None
            }
            if !sema_expression_field_visible(field.is_pub, field.is_package_pub, owner_symbol.module_identity, struct_def.inline_module, span, sees_private, environment, program) {
                diagnostics.push(sema_expression_private_field_error(member, expr_span(expr)))
                return None
            }
            return Val(sema_expression_struct_field_fact(field, owner_symbol, names, owner_args, environment, program, context))
        }
        nearest: sema_field_ref_nearest(member, struct_def.fields, visible)
        fix: if nearest == .Val(row) -> "did you mean `.{struct_def.fields[row].name}`?" else -> "name one of `{shown}`'s fields: {sema_field_ref_list(struct_def.fields, visible)}"
        diagnostic: sema_error("E0302", span, "`{shown}` has no field `{member}`", "a field reference names a field `{shown}` declares; its fields are {sema_field_ref_list(struct_def.fields, visible)}", fix)
        if nearest == .Val(row) {
            diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: expr_span(expr), new_text: struct_def.fields[row].name}))
        } else { diagnostics.push(diagnostic) }
        return None
    }
    sema_field_ref_refused(expr, chain, shown, struct_def.fields, visible, span, diagnostics)
    None
}

// The row in `visible` of the field of `fields` nearest `name`, as
// sema_suggest_field picks it: within two edits, never `name` itself, and
// none when two tie.
sema_field_ref_nearest: fn(name: String, fields: [Field], visible: [Int]) -> Int? Never! {
    ^best: -1
    ^best_distance: 3
    ^ambiguous: false
    loop row in visible {
        distance: sema_taint_edit_distance(name, fields[row].name)
        if distance == 0 || distance > 2 -> next
        if {
            distance < best_distance -> {
                best = row
                best_distance = distance
                ambiguous = false
            }
            distance == best_distance && fields[best].name != fields[row].name -> {
                ambiguous = true
            }
        }
    }
    if best < 0 || ambiguous -> None else -> Val(best)
}

// A selector whose `FieldRef` names a model this check doesn't know as a
// struct: a type parameter, or a type that declares no fields.
sema_field_ref_no_struct: fn(chain: String, model: Type, span: Span) -> Diagnostic Never! {
    sema_error("E0302", span, "`{chain}` names no field: `{type_name(model)}` is no struct this code knows", "a field reference names a stored field of its `FieldRef`'s model, so the model must be a struct named here, not a type parameter", "take the `FieldRef` as a parameter from a caller that names the struct")
}

// A selector that names no single field: a chain, a call, or an
// upper-case or payload-carrying name. `visible` are the rows of the fields
// of `fields` it may name.
sema_field_ref_refused: fn(expr: Expr, chain: String, shown: String, fields: [Field], visible: [Int], span: Span, diagnostics: ^[Diagnostic]) {
    if expr == .EnumLit(_, variant, _, payload, _, _, _) {
        lower: variant.lower()
        written: if payload.len() > 0 -> "`.{variant}(…)`" else -> "`.{variant}`"
        ^named: false
        loop row in visible {
            if fields[row].name == lower -> named = true
        }
        fix: if named -> "write `.{lower}`" else -> "name one of `{shown}`'s fields: {sema_field_ref_list(fields, visible)}"
        diagnostics.push(sema_error("E0302", span, "{written} names no field of `{shown}`", "a field reference is the field's own lower-case name, with no payload; an upper-case `.Name` is an enum case", fix))
        return
    }
    diagnostics.push(sema_error("E0302", span, "`{chain}` names no field of `{shown}`", "a field reference is one field's name; a longer chain or a call reads a value", "name the field itself, one of {sema_field_ref_list(fields, visible)}"))
}

// The fields of `fields` at the rows `visible`, each in backticks.
sema_field_ref_list: fn(fields: [Field], visible: [Int]) -> String Never! {
    if visible.len() == 0 -> return "none is visible here"
    shown: loop row in visible -> "`{fields[row].name}`"
    shown.join(", ")
}

// The `FieldRef` value naming field `name`, typed `value_type`.
sema_field_ref_value: fn(value_type: Type, name: String, span: Span, check: ^SemaBodyCheck) -> TExpr? {
    if value_type == .Apply(ref_name, ref_args) {
        if sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, ref_name) == .Val(owner) {
            if sema_scope_declaration_struct(check.environment.*, check.program.*, owner.id) == .Val(shape) {
                names: loop param in shape.type_params -> param.name
                loop field in shape.fields {
                    if field.name != "name" || field.computed != None -> next
                    text: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: name}}}, span)
                    fact: sema_expression_struct_field_fact(field, owner, names, ref_args, check.environment.*, check.program.*, check.context)
                    ^reference: sema_expression_field_ref(fact.symbol, Val(owner.id), fact.field_ty)
                    reference.boxed = fact.boxed
                    return Val(sema_tree_node(value_type, TExprKind.StructLit{fields: [TStructFieldValue]{TStructFieldValue{field: reference, value: text, boxed: fact.boxed}}}, span))
                }
            }
        }
    }
    sema_check_unsupported(check.context, "the field `{name}` (at offset {span.start}) has no `FieldRef` value: the prelude `FieldRef` declares no `name` field")
    None
}
