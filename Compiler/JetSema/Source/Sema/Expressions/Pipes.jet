// E0438, a pipe step that never reads `<>`, and its fix: the fix writes `<>`
// in the one place it fits. A bare function name gets `(<>)`,
// a call one argument short gets `<>` in each argument slot, and a name that
// fits no function form, only a method of the value, gets `<>.name(…)`. Each
// placement is probed with the step's hidden name bound to the value it
// receives; one that checks without an error fits. One fit is the Safe edit
// `jet fix` applies. With several, the error lists each and offers each as a
// suggested edit, first slot first, and `jet fix` leaves the step for a person.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    Call,
    CallArg,
    Diagnostic,
    DiagnosticFixApplicability,
    DiagnosticFixSafety,
    Expr,
    PipeStep,
    Span,
    TextEdit,
    Type,
    ast_empty_call_arg_flags,
    diagnostic_with_alternative_edit,
    diagnostic_with_edit,
    diagnostic_with_edit_grade,
]

// One place `<>` can go: the step as rewritten, the edit that writes it, the
// step as the error shows it, and whether it is the method form.
SemaPipePlacement: struct {
    value: Expr
    edit: TextEdit
    shown: String
    method: Bool
}

// The first step that never reads `<>`.
sema_expr_pipe_unread_step: fn(steps: [PipeStep]) -> Int? Never! {
    loop index in 0..<steps.len() {
        if steps[index].reads == 0 -> return Val(index)
    }
    None
}

// E0438 for `step`, whose hidden name `scopes` binds to the value it
// receives.
sema_expr_pipe_step_without_value: fn(step: PipeStep, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> Diagnostic {
    what: "This pipe step doesn't use `<>`"
    why: "Each `|>` step receives the value of the line above as `<>`; a step that never reads it drops that value"
    // The method form is a placement only when no function placement fits.
    placements: sema_expr_pipe_placements(step, environment, program, scopes, state, tail_store, context)
    fits := [SemaPipePlacement]{}
    forms: [Bool]{false, true}
    loop method in forms {
        if fits.len() > 0 -> break
        loop placement in placements {
            if placement.method != method -> next
            // copy: the placement list is dropped once the fitting ones are kept.
            if sema_expr_pipe_fits(placement.value, environment, program, scopes, state, tail_store, context) -> fits.push(placement.copy())
        }
    }
    if fits.len() == 0 -> return sema_error("E0438", step.span, what, why, "Write `<>` where the value goes, such as `|> f(<>)`, or end the pipe before this step")
    if fits.len() == 1 -> return diagnostic_with_edit(sema_error("E0438", step.span, what, why, "Write `<>` where the value goes: `{fits[0].shown}`"), fits[0].edit)
    shown: (loop fit in fits -> "`{fit.shown}`").join(", ")
    diagnostic := diagnostic_with_edit_grade(sema_error("E0438", step.span, what, why, "`<>` fits in more than one place: {shown}; write it where the value goes"), fits[0].edit, DiagnosticFixApplicability.Suggested, DiagnosticFixSafety.NeedsReview)
    loop index in 1..<fits.len() -> diagnostic = diagnostic_with_alternative_edit(diagnostic, fits[index].edit)
    diagnostic
}

// Whether `value` checks without an error; the probe leaves nothing behind.
sema_expr_pipe_fits: fn(value: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> Bool {
    probe_diagnostics := [Diagnostic]{}
    probed: sema_probe_expression(value, None, environment, program, scopes, state, tail_store, context, probe_diagnostics)
    probed != None && !sema_has_error_since(probe_diagnostics, 0)
}

// The places `<>` can go in `step`, in the order the error lists them: a
// function call's argument slots first to last, then the method form of a
// name with no dot. A call that already checks takes no value: its step
// drops it, and only a person can say where the value goes.
sema_expr_pipe_placements: fn(step: PipeStep, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> [SemaPipePlacement] {
    placements := [SemaPipePlacement]{}
    if step.value == .Ident(name, span, id) {
        // copy: each placement owns its rewritten step.
        call: Call{name: name.copy(), name_span: span, type_args: [Type]{}, args: [CallArg]{sema_expr_pipe_argument(step)}}
        placements.push(SemaPipePlacement{value: Expr.Call{call: call, id: id}, edit: TextEdit{span: Span{start: span.end, end: span.end}, new_text: "(<>)"}, shown: "{name}(<>)", method: false})
        if !name.contains(".") {
            // copy: each placement owns its rewritten step.
            method: Expr.MethodCall{receiver: sema_expr_pipe_value(step), method: name.copy(), method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{}, id: id}
            placements.push(SemaPipePlacement{value: method, edit: TextEdit{span: span, new_text: "<>.{name}()"}, shown: "<>.{name}()", method: true})
        }
        return placements
    }
    if step.value == .Call(call, id) {
        if sema_expr_pipe_fits(step.value, environment, program, scopes, state, tail_store, context) -> return placements
        written: loop arg in call.args -> sema_expr_pipe_argument_text(arg)
        // The step ends at the call's `)`.
        close: step.span.end - 1
        loop slot in 0..call.args.len() {
            args := [CallArg]{}
            shown := [String]{}
            loop index in 0..<call.args.len() {
                if index == slot {
                    args.push(sema_expr_pipe_argument(step))
                    shown.push("<>")
                }
                // copy: each placement owns its rewritten step.
                args.push(call.args[index].copy())
                // copy: each placement's text lists every written argument.
                shown.push(written[index].copy())
            }
            if slot == call.args.len() {
                args.push(sema_expr_pipe_argument(step))
                shown.push("<>")
            }
            edit: sema_expr_pipe_slot_edit(call.args, slot, close)
            // copy: each placement owns its rewritten step.
            rewritten: Call{name: call.name.copy(), name_span: call.name_span, type_args: call.type_args.copy(), args: args}
            placements.push(SemaPipePlacement{value: Expr.Call{call: rewritten, id: id}, edit: edit, shown: "{call.name}({shown.join(", ")})", method: false})
        }
        if !call.name.contains(".") {
            // copy: each placement owns its rewritten step.
            method: Expr.MethodCall{receiver: sema_expr_pipe_value(step), method: call.name.copy(), method_span: call.name_span, owner_type_args: [Type]{}, type_args: call.type_args.copy(), args: call.args.copy(), id: id}
            placements.push(SemaPipePlacement{value: method, edit: TextEdit{span: Span{start: call.name_span.start, end: call.name_span.start}, new_text: "<>."}, shown: "<>.{call.name}({written.join(", ")})", method: true})
        }
    }
    placements
}

// The edit that writes `<>` as argument `slot` of a call whose `)` is at
// `close`: before the argument now in that slot, or after the last one.
sema_expr_pipe_slot_edit: fn(args: [CallArg], slot: Int, close: Int) -> TextEdit Never! {
    if slot < args.len() -> return TextEdit{span: Span{start: args[slot].span.start, end: args[slot].span.start}, new_text: "<>, "}
    if args.len() > 0 -> return TextEdit{span: Span{start: close, end: close}, new_text: ", <>"}
    TextEdit{span: Span{start: close, end: close}, new_text: "<>"}
}

// `<>` as the value `step` receives: its hidden name.
sema_expr_pipe_value: fn(step: PipeStep) -> Expr Never! {
    // copy: the rewritten step owns its own name.
    Expr.Ident{name: step.name.copy(), span: step.span, id: AST_NODE_GENERATED}
}

sema_expr_pipe_argument: fn(step: PipeStep) -> CallArg Never! {
    CallArg{convention: AccessConvention.Read, expr: sema_expr_pipe_value(step), span: step.span, flags: ast_empty_call_arg_flags(), label: None, spread: false}
}

// A written argument as the error shows it: a name or a literal as written,
// anything longer as `…`.
sema_expr_pipe_argument_text: fn(arg: CallArg) -> String Never! {
    text := "…"
    // copy: the text outlives the argument it reads.
    if arg.expr == .Ident(name, _, _) -> text = name.copy()
    if arg.expr == .Int(value, _, _, raw, _) -> text = raw ?? "{value}"
    if arg.expr == .Bool(value, _, _) -> text = "{value}"
    if arg.label == .Val(label) -> return "{label.name}: {text}"
    text
}
