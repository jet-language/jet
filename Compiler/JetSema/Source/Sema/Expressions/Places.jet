// Checked field, place, borrow, dereference, and mutation expressions.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    EnumLitArg,
    Expr,
    IndexKind,
    InternalTag,
    PlaceAccess,
    Span,
    Symbol,
    SymbolID,
    SymbolKind,
    TExpr,
    TExprKind,
    TFieldRef,
    TGenericParam,
    TIndexKind,
    THostCall,
    TagMarker,
    TextEdit,
    Type,
    builtin_numeric_kind,
    core_record_field,
    diagnostic_with_edit,
    expr_optional_method_call_as_call,
    expr_span,
    is_compute_tensor_family,
    mir_boundary_head_carrier_module,
    symbol_id,
    tir_symbol_local,
    type_name,
]

fn sema_expression_index_kind(kind: IndexKind, base: Type) -> TIndexKind Never! {
    if kind == {
        .Unknown -> if base == .Map(_, _, _) -> TIndexKind.Map else -> TIndexKind.List
        .List -> TIndexKind.List
        .Range -> TIndexKind.Range
        .FixedListProof -> TIndexKind.FixedListProof
        .Map -> TIndexKind.Map
        .Lane(name) -> TIndexKind.Lane{name: name}
        .User(name) -> TIndexKind.User{name: name}
        .LayoutField(name) -> TIndexKind.LayoutField{name: name}
        .Pool -> TIndexKind.Pool
    }
}

fn sema_expression_integer_index(value: TExpr, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if sema_expr_is_integer(value.ty) -> return true
    &diagnostics.push(sema_error(
        "E0505",
        span,
        "an index must be an Int, not {type_name(value.ty)}",
        "indexed storage is addressed by whole-number positions",
        "use an Int index here",
    ))
    false
}

fn sema_expression_field_ref(symbol: Symbol, owner: SymbolID?, fallback_ty: Type) -> TFieldRef Never! {
    field_ty :: symbol.ty ?? fallback_ty
    TFieldRef{owner: owner, field: symbol.id, name: symbol.name, ty: field_ty, boxed: false}
}

fn sema_expression_tuple_field_ref(owner: Type, name: String, ty: Type) -> TFieldRef Never! {
    owner_name :: type_name(owner)
    field :: symbol_id(SymbolKind.Field, "", owner_name, name)
    TFieldRef{owner: None, field: field, name: name, ty: ty, boxed: false}
}

fn sema_expression_is_place(expr: Expr) -> Bool Never! {
    if expr == {
        .Ident(_, _) | .Field(_, _, _) | .Index(_, _, _, _) | .Slice(_, _, _, _, _) | .Deref(_, _) | .Place(_, _, _) -> true
        else -> false
    }
}

// D-COPY-DEFAULT1=A (#3714): `^place` in a value position is the
// programmer's exact move. The method-call path removes a receiver's take
// mark before this point, so a take mark here stands on a bare place. The
// place gives its value away even when it is read later (any later use is
// E0121 naming the mark); borrowed storage cannot be moved (E0201), and an
// element stays owned by its collection (E0225). The checked value is the
// bare place, which every owning position already moves.
fn sema_expression_move_mark_text(expr: Expr) -> String Never! {
    if expr == {
        .Ident(name, _) -> name
        .Field(base, member, _) -> "{sema_expression_move_mark_text(base)}.{member}"
        else -> "…"
    }
}

// Rust `note_exact_move`, after the place is typed: a Copy value simply
// copies (any place, an element included); an element otherwise stays in its
// collection (E0225); a read or write parameter owns nothing to give away
// (E0201 at the mark). Pins are judged after the read, as Rust's move record
// does.
fn sema_expression_exact_move(value: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    mark_span :: Span{start: span.start, end: span.start + 1}
    checked :: sema_check_expression(value, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if sema_ownership_type_is_copy(checked.ty) -> return Val(checked)
    if value == .Index(_, _, _, _) {
        &diagnostics.push(diagnostic_with_edit(sema_error("E0225", mark_span, "the move marker `^` cannot take an element out of its collection", "`^` moves a name or one of its fields; an element stays owned by its collection, which has no hole to leave behind", "remove `^` to copy the element"), TextEdit{span: mark_span, new_text: ""}))
        return None
    }
    binding :: sema_ownership_binding_for_expr(&state, value, scopes)
    if binding != None {
        info :: binding
        if sema_ownership_binding_is_borrowed_param(info) {
            &diagnostics.push(sema_error("E0201", mark_span, "`{info.symbol.name}` cannot be moved from borrowed storage", "read and write parameters and named windows keep ownership with their source", "copy the value with `~`, or accept it with the move marker `^`"))
            return None
        }
    }
    if !sema_pin_check_move(&state, value, scopes, &diagnostics) -> return None
    if !sema_ownership_consume_expression(&state, Expr.Place{value: value, access: PlaceAccess.Take, span: span}, scopes, "the move `^{sema_expression_move_mark_text(value)}`", &diagnostics) -> return None
    Val(checked)
}

fn sema_expression_place(value: Expr, access: PlaceAccess, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if access == PlaceAccess.Take -> return sema_expression_exact_move(value, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if !sema_expression_is_place(value) {
        nested :: sema_check_expression(value, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        &diagnostics.push(sema_error("E0213", span, "a window must start from a place", "a borrowed place needs stable storage", "bind a temporary before taking a place"))
        return None
    }
    // Rust `Expr::Place`: the ownership walk opened this window on the
    // complete place, so the place's own base reads answer only for a move
    // of the whole name (`s` in `&s` would otherwise meet its own loan).
    previous_root_read :: context.suppress_partial_move_root_read
    context.suppress_partial_move_root_read = true
    checked_value :: sema_check_expression(value, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    context.suppress_partial_move_root_read = previous_root_read
    checked :: checked_value ?? return None
    convention :: if access == PlaceAccess.Write -> AccessConvention.Write else -> AccessConvention.Read
    // Rust `Expr::Place`: a list range is a `View`/`ViewMut` of its element,
    // a compute tensor range views `Float`, any other ranged value (a
    // `String`) keeps its own type.
    element := Type?{None}
    if checked.kind == .Slice(_, _, _, _, _) {
        if checked.ty == {
            .List(item) -> element = Val(item)
            .FixedList(item, _) -> element = Val(item)
            else -> {
                if is_compute_tensor_family(checked.ty) -> element = Val(Type.Float)
            }
        }
    }
    result_ty :: if element == .Val(item) -> Type.Apply{name: if convention == AccessConvention.Write -> "ViewMut" else -> "View", args: [item]} else -> checked.ty
    result :: sema_tir_expr(result_ty, TExprKind.Borrow{place: checked, access: convention}, span)
    sema_expr_expected(result, expected, environment, &diagnostics)
}

fn sema_expression_deref(value: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    checked :: sema_check_expression(value, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if checked.ty == .Apply(name, args) {
        if name == "Ptr" && args.len() == 1 {
            if !sema_expr_require_unsafe("pointer dereference", span, &context, &diagnostics) -> return None
            result :: sema_tir_expr(args[0], TExprKind.Deref{value: checked}, span)
            return sema_expr_expected(result, expected, environment, &diagnostics)
        }
    }
    &diagnostics.push(sema_error("E0112", span, "dereference needs a Ptr value", "only a checked pointer carries an element type through `.*`", "use a Ptr<T> value here"))
    None
}

fn sema_expression_tuple_field(base: TExpr, member: String, span: Span, diagnostics: &[Diagnostic]) -> TExpr? {
    if base.ty == {
        .Tuple(fields) -> {
            loop field in fields {
                if field.name == member {
                    reference :: sema_expression_tuple_field_ref(base.ty, member, field.ty)
                    return Val(sema_tir_expr(field.ty, TExprKind.Field{receiver: base, field: reference}, span))
                }
            }
            &diagnostics.push(sema_error("E0302", span, "this tuple has no member `{member}`", "field access only works on names declared in the tuple", "use one of the tuple's declared member names"))
            None
        }
        else -> None
    }
}

// A bare built-in boundary spelling with a Core carrier record (`URL` in
// `core.net.url`) names that record wherever it is read, so its documented
// fields resolve through the declaration (Rust `struct_owner_module`).
fn sema_expression_carrier_type_symbol(environment: SemaScopeEnvironment, name: String) -> Symbol? {
    carrier :: mir_boundary_head_carrier_module(name) ?? return None
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return None
    loop module_row in graph.modules {
        if module_row.module_name != carrier -> next
        loop nominal in module_row.nominals {
            if nominal.symbol.name == name -> return Val(nominal.symbol)
        }
    }
    None
}

// Rust `field_type` for `.value`: an untagged `SharedGuard<T>` or a guard
// tagged by its acquisition (`guard_read()` / `guard_edit()`) holds `T`. Only
// the edit tag makes the held place editable when lowered.
fn sema_expression_shared_guard_value(ty: Type) -> SemaCallMemoryGuard? {
    marker := TagMarker.Internal{internal_tag: InternalTag.SharedGuardRead}
    guard_type := ty
    if ty == .Tagged(found, inner) {
        if found != (TagMarker.Internal{internal_tag: InternalTag.SharedGuardRead}) && found != (TagMarker.Internal{internal_tag: InternalTag.SharedGuardEdit}) -> return None
        marker = found
        guard_type = inner
    }
    if guard_type == .Apply(name, args) {
        if name == "SharedGuard" && args.len() == 1 -> return Val(SemaCallMemoryGuard{value_type: args[0], marker: marker, editable: marker == (TagMarker.Internal{internal_tag: InternalTag.SharedGuardEdit})})
    }
    None
}

// Rust `owner_type_for_reader`: a field's declared type names types as its
// owning module sees them, so it resolves there (the owner's type parameters
// stay parameters) before the owner's type arguments are substituted.
fn sema_expression_field_owner_type(environment: SemaScopeEnvironment, owner_module: String, declared: Type, generic_names: [String]) -> Type Never! {
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return ~declared
    if owner_module == "" -> return ~declared
    generics :: loop name in generic_names -> TGenericParam{name: name, bounds: [SymbolID]{}}
    sema_type_resolve_declared_with_generics(graph, declared, owner_module, generics)
}

fn sema_expression_field_checked(base: TExpr, member: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if base.ty == .Tuple(_) {
        tuple_field :: sema_expression_tuple_field(base, member, span, &diagnostics) ?? return None
        tuple_owner :: type_name(base.ty)
        tuple_field_id :: symbol_id(SymbolKind.Field, "", tuple_owner, member)
        tuple_field_symbol :: Symbol{id: tuple_field_id, kind: SymbolKind.Field, name: member, module_name: "", owner: None, span: span, ty: Val(tuple_field.ty), visibility: 0}
        &context.name_references.push(SemaNameReferenceFact{span: span, symbol: tuple_field_symbol, kind: "field"})
        return sema_expr_expected(tuple_field, expected, environment, &diagnostics)
    }
    // D-SHAREDGUARD2=A: a guard's held value is a compiler-known place, not
    // a stored struct field. The hidden tag records whether the place is
    // editable while diagnostics show one public `SharedGuard<T>`.
    if member == "value" {
        guard :: sema_expression_shared_guard_value(base.ty)
        if guard == .Val(held) {
            value :: sema_tir_expr(held.value_type, TExprKind.SharedGuardValue{guard: base, editable: held.editable}, span)
            return sema_expr_expected(value, expected, environment, &diagnostics)
        }
    }
    owner_name :: if base.ty == {
        .Named(name) -> name
        .Apply(name, _) -> name
        else -> ""
    }
    owner_args :: if base.ty == {
        .Apply(_, args) -> args
        else -> [Type]{}
    }
    if owner_name != "" {
        owner := sema_expression_type_symbol(&scopes, environment, owner_name)
        if owner == None -> owner = sema_expression_carrier_type_symbol(environment, owner_name)
        if owner == .Val(owner_symbol) {
            &context.name_references.push(SemaNameReferenceFact{span: span, symbol: owner_symbol, kind: "type"})
            // The struct's fields, read at the declaration without copying
            // its methods.
            if sema_scope_declaration_struct(environment, owner_symbol.id) == .Val(struct_def) {
                names :: loop param in struct_def.type_params -> param.name
                loop field in struct_def.fields {
                    if field.name == member {
                        field_ty :: sema_inference_substitute_type(sema_expression_field_owner_type(environment, owner_symbol.module_name, field.ty, names), names, owner_args)
                        field_id :: symbol_id(SymbolKind.Field, owner_symbol.module_name, owner_symbol.id.key, field.name)
                        field_symbol :: Symbol{id: field_id, kind: SymbolKind.Field, name: field.name, module_name: owner_symbol.module_name, owner: Val(owner_symbol.id.key), span: field.name_span, ty: Val(field_ty), visibility: if field.is_pub -> 2 else -> if field.is_package_pub -> 1 else -> 0}
                        &context.name_references.push(SemaNameReferenceFact{span: span, symbol: field_symbol, kind: "field"})
                        reference := sema_expression_field_ref(field_symbol, Val(owner_symbol.id), field_ty)
                        reference.boxed = sema_scope_environment_boxed_edge(environment, owner_symbol.id, member)
                        value :: sema_tir_expr(field_ty, TExprKind.Field{receiver: base, field: reference}, span)
                        return sema_expr_expected(value, expected, environment, &diagnostics)
                    }
                }
                &diagnostics.push(sema_error("E0302", span, "`{owner_name}` has no field `{member}`", "field access only works on names declared in the struct", "use one of the declared field names"))
                return None
            }
        }
    }
    // D-TIME-INSTANT1=A: the compiler-owned `Instant` is a monotonic Time
    // point with no epoch and no fields; the wall clock is its own read.
    if owner_name == "Instant" && member == "unix_ns" {
        &diagnostics.push(sema_error("E0302", span, "`Instant` has no field `unix_ns`", "`Instant` is a monotonic Time point with no epoch; wall-clock Unix nanoseconds are a separate clock read", "call `time.unix_ns()` for wall-clock Unix nanoseconds"))
        return None
    }
    // D-OUTCOME-SHAPE1=A: a missing value never leaves the function by
    // itself, so a field read on `T?` is refused with the ways to handle
    // absence rather than unwrapping or returning early.
    if sema_expr_unwrap_tag(base.ty) == .Option(inner) {
        &diagnostics.push(sema_error("E0310", span, "`.{member}` needs a `{type_name(inner)}`, but this value is `{type_name(base.ty)}` and might be missing", "a missing value never leaves the function by itself; it stays an ordinary value until the code handles it (D-OUTCOME-SHAPE1=A)", "write `?.{member}` to keep the result optional, add `?? fallback` for a default, or match `.Val(x)` / `.None`"))
        return None
    }
    // D-FACT-READ1=A: a compiler-owned reflection record (`RANGE.start`,
    // `EXACTNESS.kind`) exists only as a compile-time value; its rows are typed
    // for prepared-constant paths, which codegen folds to their values.
    reflection :: sema_fact_reflection_field(base, member, span)
    if reflection == .Val(value) -> return sema_expr_expected(value, expected, environment, &diagnostics)
    // A builtin Core record (`ProcessReceipt.success`, `IOContext.operation`)
    // has no Jet declaration; its fields are the generated Core record rows.
    if owner_name != "" {
        core_field :: core_record_field(owner_name, member)
        if core_field == .Val(core_field_ty) {
            core_reference :: TFieldRef{owner: None, field: symbol_id(SymbolKind.Field, "", owner_name, member), name: member, ty: core_field_ty, boxed: false}
            core_value :: sema_tir_expr(core_field_ty, TExprKind.Field{receiver: base, field: core_reference}, span)
            return sema_expr_expected(core_value, expected, environment, &diagnostics)
        }
    }
    &diagnostics.push(sema_error("E0302", span, "`.{member}` only works on a declared struct or tuple field", "field access needs declaration metadata instead of guessing a successful type", "use a declared field on a struct or tuple"))
    None
}

fn sema_expression_field(base: Expr, member: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    // D-BUILD-FACT3=A: `$package.*` / `$build.*` fold from the build snapshot.
    build_fact :: sema_fact_build_read(base, member, span, expected, environment, &diagnostics)
    if build_fact.handled -> return build_fact.value
    // D-FACT-READ1=A / D-META-ROOT3=A: `subject.$fact` reads a compiler-held plane.
    if member.starts_with("$") {
        fact :: sema_fact_read_check(base, member, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        if fact.handled -> return fact.value
    }
    // Rust reports the E0220 owner read at the member name.
    member_span :: Span{start: span.end - member.len(), end: span.end}
    // D-NUMOPS1 (Rust `infer_field` + `numeric_const_type`): `U8.MAX`,
    // `Int.MIN`, `Float.INFINITY`/`NEG_INFINITY`/`NAN`/`EPSILON` are the
    // numeric type's own constants.
    if sema_expression_numeric_bound_type(base, member) == .Val(bound_type) {
        bound :: sema_tir_expr(bound_type, TExprKind.HostCall{call: THostCall.NumericBounds{ty: bound_type, member: member}}, span)
        return sema_expr_expected(bound, expected, environment, &diagnostics)
    }
    // Rust `infer_field` (`fold_enum_variant_path`, `is_known_enum`):
    // `Enum.Variant`, `Enum.Group.Leaf` or `types.Enum.Variant` builds the variant.
    if sema_expression_enum_variant_path(base, member, environment, &scopes) == .Val(path) {
        return sema_expression_enum_literal(path.enum_name, [Type]{}, path.variant, [EnumLitArg]{}, false, Val(member_span), span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    if !sema_ownership_check_owner_read(&state, Expr.Field{base: base, member: member, span: member_span}, scopes, &diagnostics) -> return None
    // Rust `infer_field`: the complete place answers for moves (a moved
    // sibling leaves this field readable); the base is only its owner.
    if !sema_ownership_check_moved_place_use(&state, Expr.Field{base: base, member: member, span: span}, scopes, &diagnostics) -> return None
    // The base is checked once, for real. When it is a shared handle, that
    // check is rolled back and the locked-read rewrite is checked instead.
    // (Probing the base before checking it re-checked every prefix of a field
    // chain twice per level: exponential in the chain depth.)
    base_scope_mark :: sema_scope_mark(&scopes)
    base_context_mark :: sema_check_context_save(context)
    base_state :: ~state
    base_diagnostic_count :: diagnostics.len()
    base_tail_body_count :: tail_store.bodies.len()
    previous_root_read :: context.suppress_partial_move_root_read
    context.suppress_partial_move_root_read = true
    checked_base_value :: sema_check_expression(base, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    context.suppress_partial_move_root_read = previous_root_read
    if checked_base_value == .Val(probe_value) {
        rewritten :: sema_shared_access_desugar_field_read(base, member, span, probe_value.ty)
        if rewritten == .Val(generated) {
            sema_check_context_rollback(&context, base_context_mark)
            sema_scope_rollback(&scopes, base_scope_mark)
            sema_ownership_state_restore(&state, base_state)
            loop diagnostics.len() > base_diagnostic_count -> _ := &diagnostics.pop()
            loop tail_store.bodies.len() > base_tail_body_count -> _ := &tail_store.bodies.pop()
            checked_generated :: sema_check_expression(generated, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
            return Val(checked_generated)
        }
    }
    sema_scope_commit(&scopes, base_scope_mark)
    checked_base :: checked_base_value ?? return None
    if !sema_expression_secret_exposure_allowed(checked_base.ty, member, span, environment, &context, &diagnostics) -> return None
    sema_expression_field_checked(checked_base, member, span, expected, environment, &scopes, &context, &diagnostics)
}

// Rust `numeric_type_from_name` + `numeric_const_type`: the type of
// `Numeric.MEMBER`, or None when `base` is not a numeric type name or
// `member` is not one of its constants.
fn sema_expression_numeric_bound_type(base: Expr, member: String) -> Type? {
    if base == .Ident(owner_name, _) {
        kind :: builtin_numeric_kind(owner_name) ?? return None
        if member == "MIN" || member == "MAX" -> return Val(kind.ty)
        if !kind.integer && (member == "INFINITY" || member == "NEG_INFINITY" || member == "NAN" || member == "EPSILON") -> return Val(kind.ty)
    }
    None
}

// D-CRYPTO-API1: reading a secret-bearing value's raw bytes is an exposure.
// Outside Core source it needs an audited `#Unsafe` region, exactly like the
// `core.crypto.expert` exposure functions.
fn sema_expression_secret_exposure_allowed(ty: Type, member: String, span: Span, environment: SemaScopeEnvironment, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if member != "bytes" || context.unsafe_depth > 0 || !sema_call_reflection_secret_bearing(ty) -> return true
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return true
    caller_index :: sema_registration_module_index(graph, environment.module_identity) ?? return true
    caller_name :: graph.modules[caller_index].module_name
    if caller_name == "core" || caller_name.starts_with("core.") -> return true
    shown :: type_name(ty)
    exposure :: if {
        shown.ends_with("SigningKey") -> "signing_key_bytes"
        shown.ends_with("X25519SecretKey") -> "x25519_secret_bytes"
        shown.ends_with("SharedSecret") -> "shared_secret_bytes"
        else -> "secret_bytes"
    }
    &diagnostics.push(sema_error("E0510", span, "reading `{shown}.bytes` exposes secret key material", "secret-bearing values cannot be printed, interpolated, or read as raw bytes outside an audited expert gate (D-CRYPTO-API1)", "keep the value inside `crypto` operations, or call `expert.{exposure}(value)` inside `#Unsafe(\"reason\") {{ … }}`"))
    false
}

// S71 (D-SG6): the chain yields `T?`; an already-optional member flattens, so
// `user?.address?.city` stays one optional layer deep.
fn sema_expression_optional_field(base: Expr, member: String, member_span: Span, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    checked_base :: sema_check_expression(base, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    inner_ty :: if checked_base.ty == {
        .Option(value) -> value
        else -> {
            &diagnostics.push(sema_error("E0047", member_span, "`?.` needs an optional on the left, but this is `{type_name(checked_base.ty)}`", "optional chaining short-circuits a T? when a link is absent", "use plain `.` here, or make the value optional first"))
            return None
        }
    }
    inner_base :: TExpr{ty: inner_ty, kind: checked_base.kind, span: checked_base.span, integer_bounds: checked_base.integer_bounds, cost: checked_base.cost}
    checked_field :: sema_expression_field_checked(inner_base, member, span, None, environment, &scopes, &context, &diagnostics) ?? return None
    field_ty :: checked_field.ty
    flatten :: if field_ty == {.Option(_) -> true else -> false}
    result_ty :: if flatten -> field_ty else -> Type.Option{inner: field_ty}
    value :: sema_tir_expr(result_ty, TExprKind.OptField{base: checked_base, member: member, flatten: flatten}, span)
    sema_expr_expected(value, expected, environment, &diagnostics)
}

// S71 / D-SUGAR6: `receiver?.method(args)` checks the ordinary method call on
// a read-only view of the present payload. The call runs only when the
// receiver is present; its result lifts to `R?` and flattens like `?.field`.
// The call keeps its own failure rule: a fallible method propagates exactly as
// the same call on a plain receiver would.
fn sema_expression_optional_method_call(receiver: Expr, method: String, method_span: Span, type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    checked_base :: sema_check_expression(receiver, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    inner_ty :: if checked_base.ty == {
        .Option(value) -> value
        else -> {
            &diagnostics.push(sema_error("E0047", method_span, "`?.` needs an optional on the left, but this is `{type_name(checked_base.ty)}`", "optional chaining short-circuits a T? when a link is absent", "use plain `.` here, or make the value optional first"))
            return None
        }
    }
    receiver_span :: expr_span(receiver)
    name :: "__jet_optional_receiver_{method_span.start}"
    sema_scope_enter(&scopes, &state, "optional-call@{method_span.start}")
    module_name :: environment.module_identity
    owner :: sema_scope_local_owner_key(scopes)
    symbol :: Symbol{
        id: symbol_id(SymbolKind.Local, module_name, owner, name),
        kind: SymbolKind.Local,
        name: name,
        module_name: module_name,
        owner: Val(owner),
        span: receiver_span,
        ty: Val(inner_ty),
        visibility: 0,
    }
    if !sema_scope_declare_local(&scopes, symbol, false, AccessConvention.Read, None, false) {
        sema_scope_leave(&scopes, &state)
        &diagnostics.push(sema_already_defined(name, receiver_span))
        return None
    }
    sema_ownership_declare_binding(&state, symbol, false)
    call_expr :: expr_optional_method_call_as_call(Expr.Ident{name: name, span: receiver_span}, method, method_span, type_args, args)
    checked_call := sema_check_expression(call_expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    sema_scope_leave(&scopes, &state)
    call :: checked_call ?? return None
    flatten :: if call.ty == {.Option(_) -> true else -> false}
    result_ty :: if flatten -> call.ty else -> Type.Option{inner: call.ty}
    binding :: tir_symbol_local(name, receiver_span, symbol.id)
    value :: sema_tir_expr(result_ty, TExprKind.OptMethodCall{base: checked_base, binding: binding, call: call, flatten: flatten}, span)
    sema_expr_expected(value, expected, environment, &diagnostics)
}
