// Checked field, place, borrow, dereference, and mutation expressions.
use {
    jet_foundation.[
        BodyHandleOp,
        AST_NODE_GENERATED,
        AccessConvention,
        CallArg,
        Diagnostic,
        DiagnosticFixApplicability,
        DiagnosticFixSafety,
        EnumLitArg,
        Expr,
        IndexKind,
        InternalTag,
        NodeKind,
        PlaceAccess,
        Span,
        Symbol,
        SymbolID,
        SymbolKind,
        TFieldRef,
        TGenericParam,
        TIndexKind,
        TERMINAL_FACTS,
        TagMarker,
        TextEdit,
        Type,
        type_none,
        builtin_numeric_kind,
        foundation_named_type,
        AST_EMPTY_CALL_ARG_FLAGS,
        ast_program,
        core_source_owns_type,
        core_record_field,
        core_record_field_is_core_only,
        diagnostic_with_edit,
        diagnostic_with_edit_grade,
        expr_optional_method_call_as_call,
        expr_span,
        foundation_link_inner,
        boundary_head_carrier_module,
        symbol_key_text,
        checked_symbol_local,
        type_name,
        EffectRowEntry,
        ForKind,
        Lambda,
        LambdaBody,
        LambdaParam,
        NamedSpan,
        Stmt,
        ast_empty_lambda_meta,
        ModuleID,
        module_is_core,
        module_none,
        module_is_none,
        module_text,
        Measure,
        TypedLitBody,
        measure_literal_value,
        name_find,
        PipeStep,
        expr_source_start,
        pipe_value_name,
    ]
    jet_lexer.[Token]
    jet_parser.[jfmt_fmt_expr, jfmt_new, jfmt_out_text]
}

sema_expression_index_kind: fn(kind: IndexKind, base: Type) -> TIndexKind Never! {
    if kind == {
        .Unknown -> if base == .Map(_, _, _) -> TIndexKind.Map else -> TIndexKind.List
        .List -> TIndexKind.List
        .Range -> TIndexKind.Range
        .FixedListProof -> TIndexKind.FixedListProof
        .Map -> TIndexKind.Map
        .Lane(name) -> TIndexKind.Lane{name: name}
        .User(name) -> TIndexKind.User{name: name}
        .LayoutField(name) -> TIndexKind.LayoutField{name: name}
        .Pool -> TIndexKind.Pool
    }
}

sema_expression_integer_index: fn(value: TExpr, span: Span, diagnostics: ^[Diagnostic]) -> Bool {
    if sema_expr_is_integer(value.ty) -> return true
    diagnostics.push(
        sema_error(
            "E0505",
            span,
            "an index must be an Int, not {type_name(value.ty)}",
            "indexed storage is addressed by whole-number positions",
            "use an Int index here",
        ),
    )
    false
}

// The interval every value of an integer type holds: a sized integer's width
// or an inline range's bounds. Int, and a width as wide as Int or wider,
// states none.
sema_expression_type_interval: fn(ty: Type) -> TIntegerBounds? Never! {
    if sema_expr_unwrap_tag(ty) == {
        .IntN(signed, bits) -> {
            if bits <= 0 || bits >= 63 -> return None
            half: 1 << (bits - 1)
            if signed -> return Val(TIntegerBounds{lo: 0 - half, hi: half - 1})
            Val(TIntegerBounds{lo: 0, hi: half * 2 - 1})
        }
        .InlineRange(_, lo, hi) -> Val(TIntegerBounds{lo: lo, hi: hi})
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

sema_expression_field_ref: fn(symbol: Symbol, owner: SymbolID?, fallback_ty: Type) -> TFieldRef Never! {
    field_ty: symbol.ty ?? fallback_ty
    TFieldRef{owner: owner, name: symbol.name, ty: field_ty, boxed: false}
}

sema_expression_tuple_field_ref: fn(name: String, ty: Type) -> TFieldRef Never! {
    TFieldRef{owner: None, name: name, ty: ty, boxed: false}
}

sema_expression_is_place: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Ident(_, _, _) | .Field(_, _, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Deref(_, _, _) | .Place(_, _, _, _) -> true
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// (#3714): `place.move()` in a value position is the
// programmer's exact move. The method-call path removes a receiver's take
// mark before this point, so a take mark here stands on a bare place. The
// place gives its value away even when it is read later (any later use is
// E0121 naming the mark); borrowed storage cannot be moved (E0201), and an
// element stays owned by its collection (E0225). Preserve the checked move
// in the checked tree so field projections leave an empty slot rather than a copied value.
sema_expression_move_mark_text: fn(expr: Expr) -> String Never! {
    if expr == {
        .Ident(name, _, _) -> name
        .Field(base, member, _, _) -> "{sema_expression_move_mark_text(base)}.{member}"
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> "…"
    }
}

// The source text of a place whose reads have no effects (`e.addr`,
// `e.items[i + 1].text`), for a diagnostic that names it; None for a place
// read through a call, a branch or another computed index.
sema_expression_simple_place_text: fn(expr: Expr) -> String? {
    if !sema_expression_simple_place(expr, false) -> return None
    ^formatter: jfmt_new(ast_program(), "", [Token]{}, false)
    jfmt_fmt_expr(formatter, expr, 0)
    Val(jfmt_out_text(formatter))
}

sema_expression_simple_place: fn(expr: Expr, index_part: Bool) -> Bool Never! {
    if expr == {
        .Ident(_, _, _) -> true
        .Field(base, _, _, _) -> sema_expression_simple_place(base, index_part)
        .Index(base, index, _, _, _) -> sema_expression_simple_place(base, index_part) && sema_expression_simple_place(index, true)
        .Paren(inner, _, _) -> sema_expression_simple_place(inner, index_part)
        .Int(_, _, _, _, _) -> index_part
        .Unary(_, operand, _, _) -> index_part && sema_expression_simple_place(operand, true)
        .Binary(_, left, right, _, _) -> index_part && sema_expression_simple_place(left, true) && sema_expression_simple_place(right, true)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// A place whose field or paren chain passes through an index names storage
// inside a collection element.
sema_expression_place_below_element: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Field(base, _, _, _) | .Paren(base, _, _) -> sema_expression_place_below_element(base)
        .Index(_, _, _, _, _) -> true
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// An exact move, after the place is typed: a Copy value simply copies (any
// place, an element included); a place below an element stays in its
// collection (E0225); a read or write parameter owns nothing to give away
// (E0201). Pins are judged after the read. `span` covers `p.move()`; only a
// name or a field reaches here.
sema_expression_exact_move: fn(value: Expr, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    checked: sema_check_expression(value, expected, check) ?? return None
    if sema_ownership_type_is_copy(checked.ty) -> return Val(checked)
    // A computed field has no storage to give away.
    if sema_expression_refuse_computed_place(checked, "taken", check) -> return None
    if !sema_copy_site_check_guard_owned(checked, check, true) -> return None
    // A field below an element (`items[i].tags.move()`): the element keeps
    // owning its fields, so the value can only be a copy, spelled `.copy()`.
    if sema_expression_place_below_element(value) {
        ^diagnostic: sema_error("E0225", span, "`.move()` can't take a field out of a collection element", "an element stays owned by its collection together with every field inside it, so this value can only be a copy", "call `.copy()` on the field instead")
        facts: sema_copy_classify(checked.ty, SemaCopyIntent.Clone, check.environment.*, check.program.*, check.context.generic_params, false)
        if check.environment.source_origin == SemaSourceOrigin.Snapshot && facts.complete && facts.cloneable && !facts.resource {
            ^formatter: jfmt_new(ast_program(), "", [Token]{}, false)
            jfmt_fmt_expr(formatter, value, 0)
            replacement: "{jfmt_out_text(formatter)}.copy()"
            diagnostic = diagnostic_with_edit_grade(diagnostic, TextEdit{span: span, new_text: replacement}, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving)
        }
        check.diagnostics.push(diagnostic)
        return None
    }
    // A read or write parameter owns nothing to give away. A call argument
    // `p.f.move()` to a take parameter is the call's own take
    // (sema_expr_argument_move_place) and never reaches here.
    binding: sema_ownership_binding_for_expr(check.state, value, check.scopes)
    if binding != None {
        info: binding
        if sema_ownership_binding_is_borrowed_param(info) {
            check.diagnostics.push(sema_ownership_diag_move_from_borrowed(info.symbol.name, info.symbol.ty, span))
            return None
        }
    }
    if !sema_pin_check_move(check, value) -> return None
    // `p.move()` of a match payload takes it out of its subject, never a copy.
    payload: sema_ownership_move_pattern_payload(check, value, span)
    if payload < 0 -> return None
    if !sema_ownership_consume_expression(check.state, Expr.Place{value: value, access: PlaceAccess.Take, span: span, id: AST_NODE_GENERATED}, check.scopes, "`{sema_expression_move_mark_text(value)}.move()`", check.diagnostics) {
        return None
    }
    moved: if payload > 0 -> sema_expression_payload_take(checked) else -> checked.move()
    Val(sema_tree_node(moved.ty, TExprKind.Move{value: moved}, span))
}

// Marks the checked `p.move()` of a match payload binding (TLocal.payload_take):
// lowering may take the payload out of the subject's storage, which sema
// has marked moved (sema_ownership_move_pattern_payload).
sema_expression_payload_take: fn(value: ^^TExpr) -> TExpr Never! {
    ^taken: value
    if taken.kind.in_place() == {
        .Local(local) -> local.payload_take = true
        .IntLit(_, _) | .StrLit(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> {}
    }
    taken
}

sema_expression_place: fn(value: Expr, access: PlaceAccess, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if access == PlaceAccess.Take -> return sema_expression_exact_move(value, span, expected, check)
    if !sema_expression_is_place(value) {
        nested: sema_check_expression(value, None, check)
        check.diagnostics.push(sema_error("E0213", span, "a window must start from a place", "a borrowed place needs stable storage", "bind a temporary before taking a place"))
        return None
    }
    // The ownership walk opened this window on the complete place, so the
    // place's own base reads answer only for a move of the whole name (`s` in
    // `^s` would otherwise meet its own loan).
    previous_root_read: check.context.suppress_partial_move_root_read
    check.context.suppress_partial_move_root_read = true
    checked_value: sema_check_expression(value, None, check)
    check.context.suppress_partial_move_root_read = previous_root_read
    checked: checked_value ?? return None
    convention: if access == PlaceAccess.Write -> AccessConvention.Write else -> AccessConvention.Read
    // A computed field has no storage to lend for writing.
    if convention == AccessConvention.Write && sema_expression_refuse_computed_place(checked, "lent for writing", check) {
        return None
    }
    // A subrange of a declared view takes its write window from the view's own
    // access; a `View<T>` never lends one.
    if convention == AccessConvention.Write && checked.kind == .Slice(view_base, _, _, _, _) {
        if sema_expr_unwrap_tag(view_base.ty) == .Apply(view_name, _) {
            if view_name == "View" {
                check.diagnostics.push(sema_error("E0205", span, "cannot take a write window through {sema_type_show(view_base.ty)} — it has read access only", "a `View<T>` may inspect its owner's elements, but it cannot change them", "take the write window from a `ViewMut<T>` or from the mutable owner instead"))
            }
        }
    }
    // A list range (a compute tensor range is one on the tensor's `data`) is a
    // `View`/`ViewMut` of its element, any other ranged value (a `String`)
    // keeps its own type.
    ^element: Type?{None}
    if checked.kind == .Slice(_, _, _, _, _) {
        if checked.ty == {
            .List(item) -> { element = Val(item) }
            .FixedList(item, _) -> { element = Val(item) }
            .Apply(view_name, view_args) -> {
                if view_name == "View" && view_args.len() == 1 -> element = Val(view_args[0])
            }
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
        }
    }
    result_ty: if element == .Val(item) -> Type.Apply{name: if convention == AccessConvention.Write -> "ViewMut" else -> "View", args: [item]} else -> checked.ty
    result: sema_tree_node(result_ty, TExprKind.Borrow{place: checked, access: convention}, span)
    sema_expr_expected(result, expected, check.environment.*, check.program.*, check.diagnostics)
}

sema_expression_deref: fn(value: Expr, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    checked: sema_check_expression(value, None, check) ?? return None
    if checked.ty == .Apply(name, args) {
        if name == "Ptr" && args.len() == 1 {
            if !sema_expr_require_unsafe("pointer dereference", span, check) -> return None
            result: sema_tree_node(args[0], TExprKind.Deref{value: checked}, span)
            return sema_expr_expected_owned(result, expected, check.environment.*, check.program.*, check.diagnostics)
        }
    }
    // An allocator view (`arena.alloc(v)`) reaches its value in the
    // allocator's storage: `view.*` is that value's place.
    if checked.ty == .Tagged(marker, inner) {
        if marker == (TagMarker.Internal{internal_tag: InternalTag.AllocatorView}) {
            result: sema_tree_node(inner, TExprKind.Deref{value: checked}, span)
            return sema_expr_expected_owned(result, expected, check.environment.*, check.program.*, check.diagnostics)
        }
    }
    // A live link (`@T`) dereferences safely to its target value.
    if foundation_link_inner(checked.ty) == .Val(link_inner) {
        result: sema_tree_node(link_inner, TExprKind.Deref{value: checked}, span)
        return sema_expr_expected_owned(result, expected, check.environment.*, check.program.*, check.diagnostics)
    }
    check.diagnostics.push(sema_error("E0112", span, "dereference needs a Ptr value", "only a checked pointer carries an element type through `.*`", "use a Ptr<T> value here"))
    None
}

sema_expression_tuple_field: fn(base: TExpr, member: String, span: Span, diagnostics: ^[Diagnostic]) -> TExpr? {
    if base.ty == {
        .Tuple(fields) -> {
            loop field in fields {
                if field.name == member {
                    reference: sema_expression_tuple_field_ref(member, field.ty)
                    return Val(sema_tree_node(field.ty, TExprKind.Field{receiver: base, field: reference}, span))
                }
            }
            diagnostics.push(sema_error("E0302", span, "this tuple has no member `{member}`", "field access only works on names declared in the tuple", "use one of the tuple's declared member names"))
            None
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// A bare built-in boundary spelling with a Core carrier record (`URL` in
// `core.net.url`) names that record wherever it is read, so its documented
// fields resolve through the declaration.
sema_expression_carrier_type_symbol: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, name: String) -> Symbol? {
    carrier: boundary_head_carrier_module(name) ?? return None
    graph: program.registration_graph
    loop module_row_index in 0..<graph.modules.len() {
        if graph.modules[module_row_index].module_name != carrier -> next
        loop nominal_index in 0..<graph.modules[module_row_index].nominals.len() {
            if graph.modules[module_row_index].nominals[nominal_index].symbol.name == name {
                return Val(graph.modules[module_row_index].nominals[nominal_index].symbol)
            }
        }
    }
    None
}

// An untagged `SharedGuard<T>` or a guard tagged by its acquisition
// (`guard_read()` / `guard_edit()`) holds `T`. Only the edit tag makes the held
// place editable when lowered.
sema_expression_shared_guard_value: fn(ty: Type) -> SemaCallMemoryGuard? {
    ^marker: TagMarker.Internal{internal_tag: InternalTag.SharedGuardRead}
    ^guard_type: ty
    if ty == .Tagged(found, inner) {
        if found != (TagMarker.Internal{internal_tag: InternalTag.SharedGuardRead}) && found != (TagMarker.Internal{internal_tag: InternalTag.SharedGuardEdit}) {
            return None
        }
        marker = found
        guard_type = inner
    }
    if guard_type == .Apply(name, args) {
        if name == "SharedGuard" && args.len() == 1 {
            return Val(SemaCallMemoryGuard{value_type: args[0], marker: marker, editable: marker == (TagMarker.Internal{internal_tag: InternalTag.SharedGuardEdit})})
        }
    }
    None
}

// A field's declared type names types as its owning module sees them, so it
// resolves there (the owner's type parameters stay parameters) before the
// owner's type arguments are substituted.
sema_expression_field_owner_type: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, owner_module: ModuleID, declared: Type, generic_names: [String]) -> Type Never! {
    graph: program.registration_graph
    if !module_is_none(owner_module) {
        generics: loop name in generic_names -> TGenericParam{name: name, bounds: [SymbolID]{}}
        return sema_type_resolve_declared_with_generics(graph, declared, owner_module, generics)
    }
    // copy: the owner type is a new owned Type. Without a registration graph
    // or an owner module it equals `declared`, the field's declared type (a
    // read parameter), which stays in the nominal.
    declared.copy()
}

// Whether code in the checked module may read or write a field declared in
// `owner_module`: a `priv` field belongs to its type's module, and a type a
// memory kernel file declares keeps it to the package's kernel files
// (sema_expression_kernel_field_hidden). A struct hoisted
// from an inline module keeps that module's span (`inline_module`), so a use
// at `use_span` elsewhere in the same file is refused too; the inline module's
// own functions, methods and child modules lie inside it. The spans of one
// module's source segments never overlap. Compiler-generated bodies (derives,
// codecs) belong to the type.
sema_expression_field_visible: fn(is_pub: Bool, is_package_pub: Bool, owner_module: ModuleID, inline_module: Span?, use_span: Span, generated: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if is_pub -> return true
    ^owner_package: ""
    ^owner_id: module_none()
    graph: program.registration_graph
    owner_id = owner_module
    if sema_registration_module_index(graph, owner_id) == .Val(owner_index) {
        owner_package = graph.modules[owner_index].package_identity
    }
    visibility: if is_package_pub -> 1 else -> 0
    if !sema_registration_visible(visibility, environment.module_identity, environment.package_identity, owner_id, owner_package) {
        return false
    }
    if visibility == 0 && !generated && sema_expression_kernel_field_hidden(owner_id, environment, program) {
        return false
    }
    declared: inline_module ?? return true
    generated || (use_span.start >= declared.start && use_span.end <= declared.end)
}

// Whether a `priv` field of a type a memory kernel file declares is used from
// a file of its package that `policy.memory` does not name. The files of a
// package share their `priv` names, so without this a sibling file could
// build or rewrite a kernel owner around an address of its choosing.
sema_expression_kernel_field_hidden: fn(owner_module: ModuleID, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if environment.module_identity == owner_module -> return false
    graph: program.registration_graph
    owner_index: sema_registration_module_index(graph, owner_module) ?? return false
    if !graph.modules[owner_index].memory_kernel -> return false
    user_index: sema_registration_module_index(graph, environment.module_identity) ?? return false
    !graph.modules[user_index].memory_kernel
}

sema_expression_private_field_error: fn(member: String, span: Span) -> Diagnostic Never! {
    sema_error("E0605", span, "`{member}` is private to its module", "a `priv module` is usable only by its enclosing module (`priv(package)`: by its package), and a `priv` field only by its type's module", "use `{member}` from inside its module, or remove `priv` from its module or field")
}

// A literal that leaves a `priv` field out still decides its value, so it is
// refused outside the type's module like a literal that writes the field.
sema_expression_private_field_omitted_error: fn(type_name: String, member: String, span: Span) -> Diagnostic Never! {
    sema_error("E0605", span, "`{type_name}` can't be built here: its field `{member}` is private to its module", "a `priv module` is usable only by its enclosing module (`priv(package)`: by its package), and a `priv` field only by its type's module", "get a `{type_name}` from a function of its module, or remove `priv` from `{member}`")
}

sema_expression_field_checked: fn(base: TExpr, member: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> TExpr? {
    // An allocator view (`fixed.alloc(Point{…})`) holds its value in place,
    // so its fields are the held value's fields.
    if base.ty == .Tagged(marker, inner) {
        if marker == (TagMarker.Internal{internal_tag: InternalTag.AllocatorView}) {
            ^viewed: base
            viewed.ty = inner
            viewed.type_id = type_none()
            return sema_expression_field_checked(viewed, member, span, expected, environment, program, scopes, context, diagnostics)
        }
    }
    // A live link (`@T`) reaches its target's fields directly without `.*`.
    if foundation_link_inner(base.ty) == .Val(link_inner) {
        derefed: sema_tree_node(link_inner, TExprKind.Deref{value: base}, base.span)
        return sema_expression_field_checked(derefed, member, span, expected, environment, program, scopes, context, diagnostics)
    }
    if base.ty == .Tuple(_) {
        tuple_field: sema_expression_tuple_field(base, member, span, diagnostics) ?? return None
        tuple_owner: type_name(base.ty)
        tuple_field_id: sema_symbol_id(program, context, SymbolKind.Field, "", tuple_owner, member)
        tuple_field_symbol: Symbol{id: tuple_field_id, kind: SymbolKind.Field, name: member, module_identity: module_none(), owner: None, span: span, ty: Val(tuple_field.ty), visibility: 0}
        context.name_references.push(sema_name_reference(span, tuple_field_symbol, Val(SymbolKind.Field)))
        return sema_expr_expected_owned(tuple_field, expected, environment, program, diagnostics)
    }
    // A guard's held value is a compiler-known place, not
    // a stored struct field. The hidden tag records whether the place is
    // editable while diagnostics show one public `SharedGuard<T>`.
    if member == "value" {
        guard: sema_expression_shared_guard_value(base.ty)
        if guard == .Val(held) {
            value: sema_tree_node(held.value_type, TExprKind.SharedGuardValue{guard: base}, span)
            return sema_expr_expected_owned(value, expected, environment, program, diagnostics)
        }
    }
    // A field reached through `Pin<T>` resolves against
    // `T`, read or written in the pinned place; the field's own declared type
    // is the mark (a `Pin<U>` field comes back as `Pin<U>`). A tagged value's
    // field (`key.limbs` of a `#Secret Key`) resolves on the struct; the
    // taint check carries the value's tags into the read.
    owner_ty: sema_expr_unwrap_tag(sema_pin_target(base.ty) ?? base.ty)
    owner_name: if owner_ty == {
        .Named(name) -> name
        .Apply(name, _) -> name
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ""
    }
    owner_args: if owner_ty == {
        .Apply(_, args) -> args
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> [Type]{}
    }
    // A Core `SocketAddr` keeps the provider's native address, so its
    // declared `host` and `port` are read through their core.net accessors
    // (`addr.port` is `net.socket_port(addr)`, #6121), never as stored fields.
    if owner_name.ends_with("/core.net.SocketAddr") && (member == "host" || member == "port") {
        if sema_call_core_module_identity(environment, program, "core.net") == .Val(net_identity) {
            target: sema_call_core_source_target(environment, program, net_identity, "socket_{member}", [Type]{}, span, true, diagnostics) ?? return None
            callee: sema_call_callee_decl(program, target.symbol.id, span, diagnostics) ?? return None
            argument: TCallArg{value: base, template_items: [SymbolID]{}, borrow: false, mut_borrow: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false}
            accessor_ty: if member == "port" -> Type.Int else -> Type.String
            accessor: sema_tree_node(accessor_ty, TExprKind.Call{callee: callee, type_args: [Type]{}, args: [TCallArg]{argument}}, span)
            return sema_expr_expected_owned(accessor, expected, environment, program, diagnostics)
        }
    }
    if owner_name != "" {
        ^owner: sema_expression_type_symbol(scopes, environment, program, owner_name)
        if owner == None {
            owner = sema_expression_carrier_type_symbol(environment, program, owner_name)
        }
        if owner == .Val(owner_symbol) {
            context.name_references.push(sema_name_reference(span, owner_symbol, Val(SymbolKind.Type)))
            // The struct's fields, read at the declaration without copying
            // its methods.
            if sema_scope_declaration_struct(environment, program, owner_symbol.id) == .Val(struct_def) {
                if struct_def.type_params.len() != owner_args.len() {
                    // A bare generic name the signature wrote already
                    // reported E0104 there (sema_type_bare_generic_names).
                    if owner_args.len() == 0 && context.bare_generic_signature -> return None
                    diagnostics.push(sema_error("E0104", span, "struct `{type_name(base.ty)}` has the wrong number of type arguments", "each declared type parameter needs one concrete argument", "provide one type argument for every generic parameter"))
                    return None
                }
                names: loop param in struct_def.type_params -> param.name
                loop field in struct_def.fields {
                    if field.name == member {
                        if !sema_expression_field_visible(field.is_pub, field.is_package_pub, owner_symbol.module_identity, struct_def.inline_module, span, sema_expr_sees_private_fields(context), environment, program) {
                            diagnostics.push(sema_expression_private_field_error(member, Span{start: span.end - member.len(), end: span.end}))
                            return None
                        }
                        field_ty: sema_inference_substitute_type(sema_expression_field_owner_type(environment, program, owner_symbol.module_identity, field.ty, names), names, owner_args)
                        owner_key: sema_program_symbol_key(program, owner_symbol.id)
                        field_id: sema_symbol_id(program, context, SymbolKind.Field, sema_scope_module_text(environment, program, owner_symbol.module_identity), owner_key, field.name)
                        field_symbol: Symbol{id: field_id, kind: SymbolKind.Field, name: field.name, module_identity: owner_symbol.module_identity, owner: Val(owner_key), span: field.name_span, ty: Val(field_ty), visibility: if field.is_pub -> 2 else if field.is_package_pub -> 1 else -> 0}
                        context.name_references.push(sema_name_reference(span, field_symbol, Val(SymbolKind.Field)))
                        ^reference: sema_expression_field_ref(field_symbol, Val(owner_symbol.id), field_ty)
                        reference.boxed = sema_scope_environment_boxed_edge(environment, program, owner_symbol.id, member)
                        value: sema_tree_node(field_ty, TExprKind.Field{receiver: base, field: reference}, span)
                        return sema_expr_expected_owned(value, expected, environment, program, diagnostics)
                    }
                }
                // A method of that name read without parentheses where no
                // function type is expected is a forgotten call.
                if sema_expression_method_candidates(base.ty, member, span, environment, program).len() > 0 {
                    diagnostics.push(sema_expression_method_read_without_call(owner_name, member, span))
                    return None
                }
                // The nearest declared field is the suggested fix and its edit;
                // otherwise name the owner.
                suggestion: sema_suggest_field(member, loop field in struct_def.fields -> field.name)
                fix: if suggestion == .Val(candidate) -> "did you mean `{candidate}`?" else -> "check the field names on `{owner_name}`"
                diagnostic: sema_error("E0302", span, "`{owner_name}` has no field `{member}`", "field access only works on names declared in the struct", fix)
                if suggestion == .Val(candidate) {
                    diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: candidate}))
                } else { diagnostics.push(diagnostic) }
                return None
            }
        }
    }
    // The compiler-owned `Instant` is a monotonic Time
    // point with no epoch and no fields; the wall clock is its own read.
    if owner_name == "Instant" && member == "unix_ns" {
        diagnostics.push(sema_error("E0302", span, "`Instant` has no field `unix_ns`", "`Instant` is a monotonic Time point with no epoch; wall-clock Unix nanoseconds are a separate clock read", "call `time.unix_ns()` for wall-clock Unix nanoseconds"))
        return None
    }
    // A missing value never leaves the function by
    // itself, so a field read on `T?` is refused with the ways to handle
    // absence rather than unwrapping or returning early.
    if sema_expr_unwrap_tag(base.ty) == .Option(inner) {
        diagnostics.push(sema_error("E0310", span, "`.{member}` needs a `{type_name(inner)}`, but this value is `{type_name(base.ty)}` and might be missing", "a missing value never leaves the function by itself; it stays an ordinary value until the code handles it", "write `?.{member}` to keep the result optional, add `?? fallback` for a default, or match `.Val(x)` / `.None`"))
        return None
    }
    // A compiler-owned reflection record (`RANGE.start`,
    // `EXACTNESS.kind`) exists only as a compile-time value; its rows are typed
    // for prepared-constant paths, which codegen folds to their values.
    reflection: sema_fact_reflection_field(base, member, span, context)
    if reflection == .Val(value) {
        return sema_expr_expected(value, expected, environment, program, diagnostics)
    }
    // A `VJPRun` carries
    // `.value`, `.pull(seed)` and `.grads` (field_type); any other member falls
    // through to the undeclared-field error below.
    if owner_name == "VJPRun" && owner_args.len() == 1 {
        if sema_expression_vjp_run_field(owner_args[0], member) == .Val(run_field_ty) {
            run_reference: TFieldRef{owner: None, name: member, ty: run_field_ty, boxed: false}
            run_value: sema_tree_node(run_field_ty, TExprKind.Field{receiver: base, field: run_reference}, span)
            return sema_expr_expected_owned(run_value, expected, environment, program, diagnostics)
        }
    }
    if owner_name == "FfiCallbackEvent" && owner_args.len() == 1 && member == "value" {
        event_reference: TFieldRef{owner: None, name: member, ty: owner_args[0], boxed: false}
        event_value: sema_tree_node(owner_args[0], TExprKind.Field{receiver: base, field: event_reference}, span)
        return sema_expr_expected_owned(event_value, expected, environment, program, diagnostics)
    }
    // A builtin Core record (`ProcessReceipt.success`, `IOContext.operation`)
    // has no Jet declaration; its fields are the generated Core record rows.
    // A core_only field is private storage: outside Core source it does not
    // exist, so reads and writes alike get the missing-field error below.
    if owner_name != "" {
        core_field: core_record_field(owner_name, member)
        visible: !core_record_field_is_core_only(owner_name, member) || module_is_core(environment.module_identity)
        if visible && core_field == .Val(row_ty) {
            core_field_ty: sema_expr_core_row_type(row_ty, environment, program)
            core_reference: TFieldRef{owner: None, name: member, ty: core_field_ty, boxed: false}
            core_value: sema_tree_node(core_field_ty, TExprKind.Field{receiver: base, field: core_reference}, span)
            return sema_expr_expected_owned(core_value, expected, environment, program, diagnostics)
        }
    }
    // A reflected record names its type `type`, never `ty`.
    if owner_name != "" && member == "ty" && core_record_field(owner_name, "type") != None {
        renamed: sema_error("E0302", span, "`{owner_name}` has no field `ty`", "a reflected record names its type `type`, as `field.type`", "write `.type`")
        diagnostics.push(diagnostic_with_edit(renamed, TextEdit{span: Span{start: span.end - member.len(), end: span.end}, new_text: "type"}))
        return None
    }
    // `items.length`: a field another language reads where Jet calls a
    // method (an idiom row in Calls/Methods.jet).
    idiom: sema_call_method_idiom_index(base.ty, member)
    if idiom >= 0 && SEMA_METHOD_IDIOMS[idiom].rename != "" {
        called: sema_error("E0302", span, "`.{member}` isn't a field of this value", SEMA_METHOD_IDIOMS[idiom].note, "write `{SEMA_METHOD_IDIOMS[idiom].spelling}`")
        diagnostics.push(diagnostic_with_edit(called, TextEdit{span: Span{start: span.end - member.len(), end: span.end}, new_text: "{SEMA_METHOD_IDIOMS[idiom].rename}()"}))
        return None
    }
    diagnostics.push(sema_error("E0302", span, "`.{member}` only works on a declared struct or tuple field", "field access needs declaration metadata instead of guessing a successful type", "use a declared field on a struct or tuple"))
    None
}

// `#As`: a struct whose stored field carries `#As` passes
// where that field's type is expected, read as the field. `offered` is the
// value's resolved type. None when it names no struct, the struct has no
// visible `#As` field, or that field's type does not fill `required`.
SemaExpressionAsField: struct {
    ty: Type,
    field: TFieldRef,
}

sema_expression_as_field: fn(offered: Type, required: Type, use_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaExpressionAsField? {
    ^owner_name: ""
    ^owner_args: [Type]{}
    if offered == .Named(name) -> owner_name = name
    if offered == .Apply(name, args) {
        owner_name = name
        // copy: the owner's type arguments substitute into the field type; `offered` keeps its own.
        owner_args = args.copy()
    }
    if owner_name == "" -> return None
    owner_symbol: sema_expression_graph_type_symbol(environment, program, owner_name) ?? return None
    struct_def: sema_scope_declaration_struct(environment, program, owner_symbol.id) ?? return None
    if struct_def.type_params.len() != owner_args.len() -> return None
    loop field in struct_def.fields {
        if field.computed != None || sema_registration_as_marker(field.serde_markers) == None {
            next
        }
        if !sema_expression_field_visible(field.is_pub, field.is_package_pub, owner_symbol.module_identity, struct_def.inline_module, use_span, false, environment, program) {
            return None
        }
        names: loop param in struct_def.type_params -> param.name
        field_ty: sema_inference_substitute_type(sema_expression_field_owner_type(environment, program, owner_symbol.module_identity, field.ty, names), names, owner_args)
        fits: sema_expr_expected_assignable(required, sema_expr_expected_type(field_ty, environment, program), environment, program) ?? return None
        if !fits -> return None
        owner_key: sema_program_symbol_key(program, owner_symbol.id)
        field_id: sema_symbol_find(program, symbol_key_text(SymbolKind.Field, sema_scope_module_text(environment, program, owner_symbol.module_identity), owner_key, field.name)) ?? return None
        field_symbol: Symbol{id: field_id, kind: SymbolKind.Field, name: field.name, module_identity: owner_symbol.module_identity, owner: Val(owner_key), span: field.name_span, ty: Val(field_ty), visibility: if field.is_pub -> 2 else if field.is_package_pub -> 1 else -> 0}
        ^reference: sema_expression_field_ref(field_symbol, Val(owner_symbol.id), field_ty)
        reference.boxed = sema_scope_environment_boxed_edge(environment, program, owner_symbol.id, field.name)
        return Val(SemaExpressionAsField{ty: field_ty, field: reference})
    }
    None
}

// A type's symbol by the name its resolved type carries, read through the
// registration graph in place (as sema_expression_type_symbol does without
// a local binding).
sema_expression_graph_type_symbol: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, name: String) -> Symbol? {
    graph: program.registration_graph
    resolved: sema_type_graph_lookup_symbol_at(graph, sema_scope_caller_row(environment, graph), name) ?? return None
    if sema_resolved_kind(graph, resolved) == SymbolKind.Type -> Val(sema_resolved_symbol(graph, resolved)) else -> None
}

// Whether `member` is a field of a module's Module record `record`, so
// `pricing.category` reads the record and `pricing.missing` stays the module
// member report.
sema_expression_module_record_field: fn(record: TExpr, member: String, check: ^SemaBodyCheck) -> Bool {
    ^owner_name: ""
    if record.ty == .Named(name) -> owner_name = name
    if owner_name == "" -> return false
    owner_symbol: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, owner_name) ?? return false
    struct_def: sema_scope_declaration_struct(check.environment.*, check.program.*, owner_symbol.id) ?? return false
    loop field in struct_def.fields {
        if field.name == member -> return true
    }
    false
}

// The `VJPRun<G>` members over gradient tuple `G`: `.value`
// is the primal Tensor, `.pull` maps a seed Tensor to `G`, and `.grads` is the
// unit-seed pull's `G`.
sema_expression_vjp_run_field: fn(gradient: Type, member: String) -> Type? {
    if member == "value" -> return Val(Type.Named{name: "Tensor"})
    if member == "pull" {
        return Val(Type.Fn{params: [Type]{Type.Named{name: "Tensor"}}, ret: Val(gradient), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None})
    }
    if member == "grads" -> return Val(gradient)
    None
}

// `field` is the whole `base.member` expression (spanning `span`): the moved
// checks read it in place instead of rebuilding it around a copy of `base`.
sema_expression_field: fn(field: Expr, base: Expr, member: String, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    ^base_local_slot: Int?{None}
    if base == .Ident(root, _, _) {
        if sema_scope_resolve_index(check.scopes, root) == .Val(found) {
            kind: check.scopes.bindings[found].symbol.kind
            if kind == SymbolKind.Local || kind == SymbolKind.Parameter {
                base_local_slot = Val(found)
            }
        }
    }
    member_span: Span{start: span.end - member.len(), end: span.end}
    if base_local_slot == None {
        if sema_core_path_unimported(base, member, "", check.scopes) == .Val(report) {
            check.diagnostics.push(report)
            return None
        }
        // `task.x` with no local named `task` in scope: `x` is not a task
        // combinator (the parser takes only the complete task surface), so teach
        // the selectors rather than report an unknown `task`.
        if base == .Ident(root, _, _) && root == "task" && sema_scope_resolve_index(check.scopes, root) == None {
            check.diagnostics.push(sema_error("E0003", member_span, "unknown task selector `{member}`", "task selectors use `timeout`, `all`, `race`, or `any`", "write `task.timeout(duration)`, `task.all {{ … }}`, `task.race {{ … }}`, or `task.any {{ … }}`"))
            return None
        }
        // `context.field`, where the root names the task context (a bare
        // `context` nothing in scope declares, or an import of `core.context`),
        // reads the task context.
        if base == .Ident(root, root_span, _) {
            if sema_context_root(root, root_span, check) {
                return sema_expression_context_read(member, member_span, span, expected, check)
            }
        }
        // `#package.*` / `#build.*` fold from the build snapshot.
        build_fact: sema_fact_build_read(base, member, span, expected, check.environment.*, check.program.*, check.context, check.diagnostics)
        if build_fact.handled -> return build_fact.value
    }
    // `subject.$fact` reads a compiler-held plane.
    if member.starts_with("$") {
        fact: sema_fact_read_check(base, member, span, expected, check)
        if fact.handled -> return fact.value
    }
    // `T.reflect().values` is enum `T`'s typed catalog of case values.
    if member == "values" {
        catalog: sema_fact_enum_values(base, span, expected, check)
        if catalog.handled -> return catalog.value
    }
    // `U8.MAX`, `Int.MIN`, `Float.INFINITY`/`NEG_INFINITY`/`NAN`/`EPSILON` are
    // the numeric type's own constants.
    if base_local_slot == None || member == "MIN" || member == "MAX" || member == "INFINITY" || member == "NEG_INFINITY" || member == "NAN" || member == "EPSILON" {
        if sema_expression_numeric_bound_type(base, member, check) == .Val(bound_type) {
            // A numeric constant is a value, not a call, so the site is
            // known-pure rather than an unknown callee.
            if !sema_effect_record_intrinsic_effects(check, "{type_name(bound_type)}.{member}", span, [EffectRowEntry]{}) {
                return None
            }
            bound: sema_tree_node(bound_type, TExprKind.HostCall{call: THostCall.NumericBounds{ty: bound_type, member: member}}, span)
            return sema_expr_expected_owned(bound, expected, check.environment.*, check.program.*, check.diagnostics)
        }
    }
    if base_local_slot == None {
        // `TerminalFact.resize` is a stable key of the terminal fact report
        // (`ProcessSpec.abilities()`), read as its key text, unless the program
        // declares its own `TerminalFact`.
        if base == .Ident(owner, _, _) && owner == "TerminalFact" && sema_scope_resolve_index(check.scopes, owner) == None && sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, owner) == None {
            return sema_expression_terminal_fact(member, member_span, expected, check)
        }
        // `Enum.Variant`, `Enum.Group.Leaf` or `types.Enum.Variant` builds the
        // variant; a payload case read without a call is its constructor value.
        if sema_expression_enum_variant_path(base, member, check) == .Val(path) {
            type_args: sema_expression_path_type_args(base)
            constructor: sema_expression_enum_constructor_value(path, type_args, member_span, Span{start: expr_span(base).start, end: span.end}, expected, check)
            if constructor.handled -> return constructor.value
            return sema_expression_enum_literal(path.enum_name, type_args, path.variant, [EnumLitArg]{}, false, Val(member_span), span, expected, check)
        }
        // `alias.NAME` where `alias` is a whole-module import reads that
        // module's constant `NAME`, and `core.math.NAME` through
        // `use core: core` the nested module's.
        if base == .Ident(alias, _, _) {
            module_constant: sema_expression_module_constant(alias, member, member_span, span, expected, check)
            if module_constant.handled -> return module_constant.value
            if sema_call_taken_over_file_member(alias, member, member_span, check) == .Val(taken) {
                check.diagnostics.push(taken)
                return None
            }
            // `m: lib.inner`: a module named through its parent is not a value.
            if sema_expr_core_module_alias_visible(alias, check.scopes) && sema_call_module_member_is_module(check, alias, member) {
                check.diagnostics.push(sema_module_used_as_value("{alias}.{member}", span))
                return None
            }
        }
        if base == .Field(root, nested, _, _) {
            if root == .Ident(alias, _, _) {
                nested_constant: sema_expression_core_nested_constant(alias, nested, member, member_span, span, expected, check)
                if nested_constant.handled -> return nested_constant.value
            }
        }
        // `Type.member` on a declared struct reads no value. A typestate label
        // is a compile-time fact, and any other member is not a static member
        // of the struct. A trait constant (`Type.name`, `T.name`) is the one
        // static member a type has.
        if base == .Ident(type_name, _, _) {
            trait_constant: sema_expression_trait_constant(type_name, member, member_span, span, expected, check)
            if trait_constant.handled -> return trait_constant.value
            owner: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, type_name)
            if owner == .Val(symbol) {
                if sema_scope_declaration_struct_states(check, symbol.id) == .Val(states) {
                    check.diagnostics.push(sema_expression_struct_static_member_error(type_name, member, states, member_span))
                    return None
                }
            }
        }
    }
    // copy: the owner read is reported at the member name, so it checks the
    // place under that span; `field` itself spans the whole path. With no
    // live view the check cannot fail and reads nothing else, so it is skipped.
    if check.state.views.len() > 0 && !sema_ownership_check_owner_read(check, Expr.Field{base: base.copy(), member: member, span: member_span, id: AST_NODE_GENERATED}) {
        return None
    }
    // A projected base suppresses descendant moves, but still answers for
    // moves of itself or its ancestors. The complete place checks all moves.
    moved_ok: if check.context.suppress_partial_move_root_read -> sema_ownership_check_root_base_use(check, field) else -> sema_ownership_check_moved_place_use(check.state, field, check.scopes, check.diagnostics)
    if !moved_ok -> return None
    // Plain local/parameter bases whose known type is a non-generic nominal
    // cannot trigger Shared, Rows, computed-field, swizzle, or bound-method
    // rewrites when none of those surfaces apply, so skip rollback snapshots.
    ^skip_rollback: false
    if base_local_slot == .Val(slot) && !check.program.has_computed_fields && !sema_expression_is_swizzle_member(member) {
        if sema_scope_binding_type(check.environment.*, check.scopes, slot) == .Val(known_ty) {
            if known_ty == .Named(_) && (expected == None || sema_expression_fn_slot(expected, check) == None) {
                skip_rollback = true
            }
        }
    }
    ^checked_base_value: TExpr?{None}
    if skip_rollback {
        previous_root_read: check.context.suppress_partial_move_root_read
        check.context.suppress_partial_move_root_read = true
        checked_base_value = sema_check_expression(base, None, check)
        check.context.suppress_partial_move_root_read = previous_root_read
    } else {
        // The base is checked once, for real. When it is a shared handle, that
        // check is rolled back and the locked-read rewrite is checked instead.
        // (Probing the base before checking it re-checked every prefix of a field
        // chain twice per level: exponential in the chain depth.)
        base_scope_mark: sema_scope_mark(check.scopes)
        base_context_mark: sema_check_context_save(check.context)
        base_fork: sema_ownership_mark(check.state)
        base_diagnostic_count: check.diagnostics.len()
        base_tail_body_count: check.tail_store.bodies.len()
        previous_root_read: check.context.suppress_partial_move_root_read
        check.context.suppress_partial_move_root_read = true
        checked_base_value = sema_check_expression(base, None, check)
        check.context.suppress_partial_move_root_read = previous_root_read
        if checked_base_value == .Val(probe_value) {
            ^rewritten: sema_shared_access_desugar_field_read(base, member, span, probe_value.ty, check.scopes)
            if rewritten == None {
                rewritten = sema_expression_rows_view(base, member, span, probe_value.ty, check)
            }
            if rewritten == None {
                rewritten = sema_expression_computed_field_read(base, member, span, probe_value.ty, check)
            }
            if rewritten == None {
                swizzle: sema_expression_swizzle_read(base, member, span, probe_value.ty, check)
                if swizzle.invalid {
                    sema_scope_commit(check.scopes, base_scope_mark)
                    sema_ownership_fork_commit(check.state)
                    return None
                }
                rewritten = swizzle.read
            }
            if rewritten == None {
                bound: sema_expression_bound_method(base, member, span, probe_value.ty, expected, check)
                if bound.invalid {
                    sema_scope_commit(check.scopes, base_scope_mark)
                    sema_ownership_fork_commit(check.state)
                    return None
                }
                rewritten = bound.read
            }
            if rewritten == .Val(generated) {
                sema_check_context_rollback(check.context, base_context_mark.move())
                sema_scope_rollback(check.scopes, base_scope_mark)
                sema_ownership_fork_rollback(check.state, base_fork)
                sema_ownership_fork_close(check.state, base_fork)
                loop check.diagnostics.len() > base_diagnostic_count -> ^_: check.diagnostics.pop()
                loop check.tail_store.bodies.len() > base_tail_body_count {
                    ^_: check.tail_store.bodies.pop()
                }
                checked_generated: sema_check_expression(generated, expected, check) ?? return None
                return Val(checked_generated)
            }
        }
        sema_scope_commit(check.scopes, base_scope_mark)
        sema_ownership_fork_commit(check.state)
    }
    checked_base: checked_base_value ?? return None
    // `tree.member` on a Dyn reads the object member as a checked Dyn; method
    // names stay reserved.
    if checked_base.ty == .Named(_) && sema_dyn_is_type(sema_expr_expected_type(checked_base.ty, check.environment.*, check.program.*)) {
        if sema_dyn_is_member(member) {
            check.diagnostics.push(sema_dyn_member_error(member, member_span))
            return None
        }
        key: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: member}}}, member_span)
        operation: BodyHandleOp.DynIndexKey{site: "{sema_dyn_site(base)}.{member}", location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, span)}
        value: sema_tree_node(sema_dyn_type(), TExprKind.HandleMethod{receiver: checked_base, operation: operation, args: [TExpr]{key}}, span)
        return sema_expr_expected_owned(value, expected, check.environment.*, check.program.*, check.diagnostics)
    }
    sema_ownership_note_close_owner(check, base, checked_base.ty)
    if !sema_expression_secret_exposure_allowed(checked_base.ty, member, span, check) -> return None
    value: sema_expression_field_checked(checked_base, member, span, expected, check.environment.*, check.program.*, check.scopes, check.context, check.diagnostics) ?? return None
    // Lambda capture moves ask whether the captured field is a copy type.
    sema_ownership_note_place_type(check.state, span, value.ty)
    Val(value)
}

// `context.<field>`: a read of the current task context, an implicit input of
// every function. Its site records no effect, so the read is known to need
// none and pure code reads it too; what depends on the read follows it
// instead: a value computed while building never reads it
// (ComptimeItems.jet sema_comptime_body_unfoldable), and a `#Memo` key holds
// each field and key the function reaches (Effects/Checks.jet
// sema_effect_context_reach). `deadline` is the installed absolute
// wall-millisecond deadline (`Int?`, None outside a `#Deadline` block or
// function and `task.timeout`), `thread` the running thread's index (`Int`,
// 0 on the main thread), `logger` core.log's `logger` key (a
// `log.Handler`), read as `context.get(logger)` is, `on_stop` the stop
// handler (a `fn(debug.Stop)`, the core.debug function that fills the
// ContextOnStop role where no block set one), `print` core.term's print
// style (a `term.PrintStyle`, its defaults where no block set one)
// (ContextKeys.jet sema_context_field_key),
// `scratch` the task's scratch arena and `trace` the calling frames
// (sema_expression_context_trace), and `allocator` the current allocator
// (sema_expression_context_allocator). The task owns its scratch arena, so a
// read of it is a borrow, as a read of a field of a value the reader
// doesn't own is: an allocator view of the `mem.Arena` (the view
// `arena.alloc(v)` answers), which owns nothing and may not leave the
// region (Ownership/Checks.jet sema_ownership_scratch_read). IR
// BuildTransact.jet ir_context_read and ir_context_get lower them.
sema_expression_context_read: fn(member: String, member_span: Span, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if member == "trace" -> return sema_expression_context_trace(span, expected, check)
    if member == "allocator" -> return sema_expression_context_allocator(span, expected, check)
    if member == "dir" || member == "env" -> return sema_expression_context_sys_field(member, span, expected, check)
    keyed: if sema_context_field_module(member) != None -> sema_context_field_key(member, check.program.*) else -> SemaContextFieldKey?{None}
    ty: if keyed == {
        .Val(field) -> field.key.ty.copy()
        .None -> if member == {
            "deadline" -> Type.Option{inner: Type.Int}
            "thread" -> Type.Int
            "scratch" -> Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.AllocatorView}, inner: Type.Named{name: SEMA_MEMORY_ARENA}}
            else -> {
                check.diagnostics.push(sema_error("E0302", member_span, "`context` has no readable field `{member}`", "the task context reads `allocator` (a `mem.Allocator`), `deadline` (`Int?`, absolute wall milliseconds), `thread` (`Int`, the running thread's index), `logger` (a `log.Handler`), `on_stop` (a `fn(debug.Stop)`), `print` (a `term.PrintStyle`), `scratch` (the task's `mem.Arena`) and `trace` (`[SourceLocation]`, the calling frames)", "write `context.allocator`, `context.deadline`, `context.thread`, `context.logger`, `context.on_stop`, `context.print`, `context.scratch` or `context.trace`"))
                return None
            }
        }
    }
    if !sema_effect_record_intrinsic_effects(check, "context.{member}", span, [EffectRowEntry]{}) {
        return None
    }
    call: if keyed == {
        .Val(field) -> THostCall.ContextGet{key: field.key.key, default: sema_context_field_default(field, ty, span, check.context), equatable: sema_type_equatable(check.environment.*, check.program.*, ty)}
        .None -> THostCall.ContextRead{field: member}
    }
    read: sema_tree_node(ty, TExprKind.HostCall{call: call}, span)
    if member == "scratch" {
        return sema_expr_expected(read, expected, check.environment.*, check.program.*, check.diagnostics)
    }
    sema_expr_expected_owned(read, expected, check.environment.*, check.program.*, check.diagnostics)
}

// The fields `context.<field>` reads (sema_expression_context_read), in the
// order a `#Memo` key holds them (Effects/Checks.jet
// sema_effect_context_reach), which then holds `trace` when it can be read.
sema_context_read_fields: fn() -> [String] Never! { [String]{"deadline", "thread"} }

// `context.trace`: the calling task's Jet frames, innermost first, as
// `[SourceLocation]`, read from the frame chain and location table the
// fault report reads. The runtime's walk (JetRuntime Fault.jet
// jet_rt_context_trace, the ContextRead "trace") writes them as text, and
// the core.debug function that fills the ContextTrace role makes the
// records: the reading function first, then its callers. The table names no
// column or module, so `column` is 0 and `module` "". Like every context
// read it records no effect, and a `#Memo` function that can read it keys
// its results on the frames (Effects/Checks.jet sema_effect_context_reach).
sema_expression_context_trace: fn(span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if !sema_effect_record_intrinsic_effects(check, "context.trace", span, [EffectRowEntry]{}) {
        return None
    }
    unavailable: sema_error("E0906", span, "the core.debug function that fills the ContextTrace role for `context.trace` is unavailable", "`context.trace` makes its records through the Core debug source", "restore the `core.debug` source module")
    if sema_call_core_module_identity(check.environment.*, check.program.*, "core.debug") == None {
        check.diagnostics.push(unavailable)
        return None
    }
    filler: sema_core_role_function(check.program.registration_graph, "ContextTrace") ?? {
        check.diagnostics.push(sema_missing_core_role("ContextTrace", span))
        return None
    }
    target: sema_call_core_source_target(check.environment.*, check.program.*, filler.module_identity, filler.name, [Type]{}, span, true, check.diagnostics) ?? {
        check.diagnostics.push(unavailable)
        return None
    }
    callee: sema_call_callee_decl(check.program.*, target.symbol.id, span, check.diagnostics) ?? return None
    returned: sema_call_signature_return(target.signature) ?? return None
    records: if returned == .Result(ok, _) -> ok.copy() else -> returned
    frames: sema_tree_node(Type.String, TExprKind.HostCall{call: THostCall.ContextRead{field: "trace"}}, span)
    read: sema_tree_node(records, TExprKind.Call{callee: callee, type_args: [Type]{}, args: [TCallArg]{sema_value_method_source_arg(frames)}}, span)
    sema_expr_expected_owned(read, expected, check.environment.*, check.program.*, check.diagnostics)
}

// `context.allocator`: the current allocator, as a `mem.Allocator` value,
// the call of the core.mem function that fills the ContextAllocator role.
// Its allocator holds no state: each of its calls goes to whichever
// allocator is current then, the innermost `#Context(allocator:)` block's,
// else the program heap, so the value is the same one wherever it is read,
// passed or kept. Like every context read it records no effect.
sema_expression_context_allocator: fn(span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if !sema_effect_record_intrinsic_effects(check, "context.allocator", span, [EffectRowEntry]{}) {
        return None
    }
    graph: check.program.registration_graph
    // Snapshot: a lone program loads no core.mem to fill the ContextAllocator role.
    if graph.mode == .Snapshot -> return None
    filler: sema_core_role_function(graph, "ContextAllocator") ?? {
        check.diagnostics.push(sema_missing_core_role("ContextAllocator", span))
        return None
    }
    target: sema_call_core_source_target(check.environment.*, check.program.*, filler.module_identity, filler.name, [Type]{}, span, true, check.diagnostics) ?? {
        check.diagnostics.push(sema_error("E0906", span, "the core.mem ContextAllocator function for `context.allocator` is unavailable", "`context.allocator` is read through the Core mem source", "restore the `core.mem` source module"))
        return None
    }
    callee: sema_call_callee_decl(check.program.*, target.symbol.id, span, check.diagnostics) ?? return None
    // The ContextAllocator function cannot fail (`Allocator Never!`): the
    // read is its success value.
    returned: sema_call_signature_return(target.signature) ?? return None
    allocator: if returned == .Result(ok, _) -> ok.copy() else -> returned
    read: sema_tree_node(allocator, TExprKind.Call{callee: callee, type_args: [Type]{}, args: [TCallArg]{}}, span)
    sema_expr_expected_owned(read, expected, check.environment.*, check.program.*, check.diagnostics)
}

// `context.dir` (`String`) and `context.env` (`[String:String]`): read the
// current task's working directory and merged environment map through
// `core.sys.context_dir_current` / `core.sys.context_env_current`. Like every
// context read it records no effect row of its own.
sema_expression_context_sys_field: fn(member: String, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if !sema_effect_record_intrinsic_effects(check, "context.{member}", span, [EffectRowEntry]{}) {
        return None
    }
    graph: check.program.registration_graph
    // Snapshot: a lone program loads no core.sys to read context.dir or context.env.
    if graph.mode == .Snapshot -> return None
    identity: sema_call_core_module_identity(check.environment.*, check.program.*, "core.sys") ?? {
        check.diagnostics.push(sema_error("E0906", span, "the core.sys module for `context.{member}` is unavailable", "`context.{member}` reads the task context through `core.sys`", "restore the `core.sys` source module"))
        return None
    }
    helper: if member == "dir" -> "context_dir_current" else -> "context_env_current"
    target: sema_call_core_source_target(check.environment.*, check.program.*, identity, helper, [Type]{}, span, true, check.diagnostics) ?? {
        check.diagnostics.push(sema_error("E0906", span, "the core.sys helper `{helper}` for `context.{member}` is unavailable", "`context.{member}` reads the task context through `core.sys`", "restore `core.sys`"))
        return None
    }
    callee: sema_call_callee_decl(check.program.*, target.symbol.id, span, check.diagnostics) ?? return None
    result_ty: if member == "dir" -> Type.String else -> Type.Map{key: Type.String, key_span: None, value: Type.String}
    read: sema_tree_node(result_ty, TExprKind.Call{callee: callee, type_args: [Type]{}, args: [TCallArg]{}}, span)
    sema_expr_expected_owned(read, expected, check.environment.*, check.program.*, check.diagnostics)
}

// Column field view: `table.field` on a Core `Rows<T>` (`ty`) is the
// field of every row in row order, generated as the collecting loop
// `loop __row in table.__rows -> __row.field` (the parser's own shape for
// it). None for any other base or for the table's own field.
sema_expression_rows_view: fn(base: Expr, member: String, span: Span, ty: Type, check: ^SemaBodyCheck) -> Expr? {
    if member == "__rows" -> return None
    if sema_expr_unwrap_tag(ty) == .Apply(name, args) {
        if args.len() != 1 || !sema_expression_rows_type(name, "Rows", check) -> return None
    } else { return None }
    row: Expr.Ident{name: "__row", span: span, id: AST_NODE_GENERATED}
    item: Expr.Field{base: row, member: member, span: span, id: AST_NODE_GENERATED}
    rows: Expr.Field{base: base.copy(), member: "__rows", span: span, id: AST_NODE_GENERATED}
    label: NamedSpan{name: "__jet_collect_loop_{span.start}", span: span}
    body: [Stmt]{Stmt.Yield{value: item, span: Span{start: span.start, end: span.start}}}
    walk: Stmt.For{var: "__row", var_span: span, var2: None, kind: ForKind.In{collection: rows, step: None}, body: body, span: span, arrow_body: false, label: Val(label), auto_vectorization: None}
    ^meta: ast_empty_lambda_meta()
    meta.collecting_loop = true
    lambda: Lambda{take_names: [NamedSpan]{}, params: [LambdaParam]{}, effects: None, body: LambdaBody.Block{body: [Stmt]{walk}}, span: span, meta: meta}
    Val(Expr.CallValue{callee: Expr.Lambda{lambda: lambda, id: AST_NODE_GENERATED}, args: [CallArg]{}, span: span, id: AST_NODE_GENERATED})
}

// `value.name` for a computed field `name: T -> formula` of a struct: a call
// of its generated getter (Registration `sema_derive_computed_getters`).
// None for a stored field or any other base.
sema_expression_computed_field_read: fn(base: Expr, member: String, span: Span, ty: Type, check: ^SemaBodyCheck) -> Expr? {
    if sema_expression_computed_field_named(ty, member, false, check) == None -> return None
    Val(Expr.MethodCall{receiver: base.copy(), method: sema_computed_field_getter(member), method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{}, id: AST_NODE_GENERATED})
}

// The computed field of the struct `ty` that `member` names, or whose
// generated getter it names when `getter` is set. None for a stored field,
// an unknown member or a base that is no struct.
sema_expression_computed_field_named: fn(ty: Type, member: String, getter: Bool, check: ^SemaBodyCheck) -> String? {
    if !check.program.has_computed_fields -> return None
    ^owner_name: ""
    if sema_expr_unwrap_tag(ty) == {
        .Named(name) -> owner_name = name
        .Apply(name, _) -> owner_name = name
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return None
    }
    owner: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, owner_name) ?? return None
    definition: sema_scope_declaration_struct(check.environment.*, check.program.*, owner.id) ?? return None
    loop field in definition.fields {
        named: if getter -> sema_computed_field_getter(field.name) == member else -> field.name == member
        if !named -> next
        if field.computed == None -> return None
        return Val(field.name)
    }
    None
}

// A computed field has no storage, so nothing writes it,
// not even its own module: no assignment or compound assignment, no write
// window or write argument and no take reaches it, directly or through a
// field, element or range below it. A read stays its getter's value.
SemaComputedPlace: struct {
    owner: Type,
    member: String,
    span: Span,
}

// The first computed step of the checked write place `place`: a stored-field
// projection that names a computed field (an assignment target) or a read of
// a computed getter the place runs through. None when the place has storage.
sema_expression_computed_place: fn(place: TExpr, check: ^SemaBodyCheck) -> SemaComputedPlace? {
    if place.kind == {
        .Field(receiver, field) -> {
            if sema_expression_computed_field_named(receiver.ty, field.name, false, check) == .Val(member) {
                return Val(SemaComputedPlace{owner: receiver.ty.copy(), member: member, span: place.span})
            }
            return sema_expression_computed_place(receiver, check)
        }
        .MethodCall(receiver, method, _, _) -> {
            member: sema_expression_computed_field_named(receiver.ty, method.name, true, check) ?? return None
            return Val(SemaComputedPlace{owner: receiver.ty.copy(), member: member, span: place.span})
        }
        .Index(base, _, _, _, _, _) | .Slice(base, _, _, _, _) -> return sema_expression_computed_place(base, check)
        .TryWithContext(inner, _, _, _, _, _) -> return sema_expression_computed_place(inner, check)
        .Try(value, _, _) | .Borrow(value, _) | .Move(value) -> return sema_expression_computed_place(value, check)
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Lambda(_) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> return None
    }
}

// E0339 when the checked write place `place` runs through a computed field
// (sema_expression_computed_place); `action` names the write. True when
// reported.
sema_expression_refuse_computed_place: fn(place: TExpr, action: String, check: ^SemaBodyCheck) -> Bool {
    found: sema_expression_computed_place(place, check) ?? return false
    shown: type_name(found.owner)
    check.diagnostics.push(sema_error("E0339", found.span, "`{found.member}` is a computed field on `{shown}` — it can't be {action}", "`{found.member}` is declared `{found.member} -> …`: its value always comes from that formula, so it has no storage to write, lend for writing or take", "change the stored field its formula reads, or call a method of `{shown}` that does"))
    true
}

// E0339 for a checked method call that writes its receiver (the receiver
// frame noted `^`) when that receiver is a computed place. True when reported.
sema_expression_refuse_computed_receiver: fn(call: TExpr, check: ^SemaBodyCheck) -> Bool {
    if call.kind == {
        .MethodCall(receiver, _, _, _) | .BuiltinMethod(receiver, _, _) -> return sema_expression_refuse_computed_place(receiver, "lent for writing", check)
        .TryWithContext(inner, _, _, _, _, _) -> return sema_expression_refuse_computed_receiver(inner, check)
        .Try(inner, _, _) -> return sema_expression_refuse_computed_receiver(inner, check)
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> return false
    }
}

sema_expression_terminal_fact: fn(member: String, member_span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if !TERMINAL_FACTS.contains(member) {
        keys: loop fact in TERMINAL_FACTS -> "`TerminalFact.{fact}`"
        fix: if sema_suggest_field(member, TERMINAL_FACTS) == .Val(fact) -> "did you mean `TerminalFact.{fact}`?" else -> "write one of {keys.join(", ")}"
        check.diagnostics.push(sema_error("E0302", member_span, "`TerminalFact` has no key `{member}`", "stable terminal fact keys use the checked TerminalFact namespace", fix))
        return None
    }
    key: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: member}}}, member_span)
    sema_expr_expected_owned(key, expected, check.environment.*, check.program.*, check.diagnostics)
}

sema_expression_struct_static_member_error: fn(type_name: String, member: String, states: [String], span: Span) -> Diagnostic Never! {
    loop state in states {
        if state == member {
            return sema_error("E0302", span, "`{type_name}.{member}` is not a value", "struct fields need a value before the dot; typestate names are compile-time facts, not runtime values", "use a `{type_name}` value before a field, or call a static method on `{type_name}`")
        }
    }
    sema_error("E0302", span, "`{type_name}` has no static member `{member}`", "`{type_name}` names a struct type; fields need a value before the dot", "use a `{type_name}` value before an instance field, or call a static method that exists on `{type_name}`")
}

// `alias.NAME` through a whole-module import `alias`: a ConstRef to the target
// module's constant, typed by its staged value. A member the module does not
// declare is a field of its Module record (`pricing.category`) when it has one;
// any other is the call path's import-member report, not an untyped base.
sema_expression_module_constant: fn(alias: String, member: String, member_span: Span, span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    index: sema_scope_resolve_index(check.scopes, alias) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if check.scopes.bindings[index].symbol.kind != SymbolKind.Import {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    // Snapshot: a module constant resolves only through registered imports.
    if check.program.registration_graph.mode == .Snapshot {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    graph: check.program.registration_graph
    // An inline module of the imported file (`lib.inner`) is its record.
    if sema_expression_module_nested_record(graph, alias, member, check) == .Val(nested) {
        return sema_expression_module_constant_read(graph, nested, "{alias}.{member}", span, expected, check)
    }
    resolved: sema_registration_lookup_qualified(graph, check.environment.module_identity, alias, member) ?? {
        if sema_registration_lookup_qualified(graph, check.environment.module_identity, alias, SEMA_MODULE_META) == .Val(record) {
            read: sema_expression_module_constant_read(graph, record, alias, span, None, check)
            if read.value == .Val(value) && sema_expression_module_record_field(value, member, check) {
                return SemaMethodSpecialCheck{handled: true, value: sema_expression_field_checked(value, member, span, expected, check.environment.*, check.program.*, check.scopes, check.context, check.diagnostics)}
            }
        }
        unknown: sema_expression_module_member_unknown(graph, check.environment.module_identity, alias, member, member_span) ?? return SemaMethodSpecialCheck{handled: false, value: None}
        check.diagnostics.push(unknown)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    unexposed: sema_expression_module_file_child(graph, resolved, alias, member, member_span)
    if unexposed == .Val(diagnostic) {
        check.diagnostics.push(diagnostic)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    sema_expression_module_constant_read(graph, resolved, "{alias}.{member}", span, expected, check)
}

// The Module record of the inline module `member` that the file module
// `alias` declares, hoisted under its member identity in that file.
sema_expression_module_nested_record: fn(graph: SemaRegistrationGraph, alias: String, member: String, check: SemaBodyCheck) -> SemaRegistrationResolvedSymbol? {
    imported: sema_call_source_import_target(check.environment.*, check.program.*, alias) ?? return None
    module_id: sema_registration_module_id(graph, imported.module_identity)
    module_index: sema_registration_module_index(graph, module_id) ?? return None
    loop surface in graph.modules[module_index].inline_bindings.modules {
        if surface.name != member || surface.private_to != None || name_find(surface.constants, SEMA_MODULE_META) == None {
            next
        }
        return sema_registration_lookup_name(graph, module_id, sema_inline_member_name(surface.path, SEMA_MODULE_META))
    }
    None
}

// E0605 for `alias.child` where `child` is a file module that the imported
// source module declares (`child: module` with no body) and `alias.child`
// still names that file. A folder module offers only what it re-exports, so
// its file modules are never reachable through it; when the folder takes the
// file's same-named item (`child: child.child`), `alias.child` is that item.
// Core module paths such as `core.text.wrap` name published modules and keep
// their own route.
sema_expression_module_file_child: fn(graph: SemaRegistrationGraph, resolved: SemaRegistrationResolvedSymbol, alias: String, member: String, member_span: Span) -> Diagnostic? {
    if module_is_core(resolved.target_module_identity) || sema_resolved_kind(graph, resolved) != SymbolKind.Import {
        return None
    }
    owner_index: sema_registration_module_index(graph, resolved.target_module_identity) ?? return None
    loop declaration in graph.modules[owner_index].declarations {
        if declaration == .CodeModule(definition) && definition.name == member && definition.body == None {
            return Val(sema_error("E0605", member_span, "module `{alias}` does not expose its file module `{member}`", "a folder module offers other files only the items it re-exports, so its file modules stay inside it", "call an item that `{alias}` re-exports, or re-export the one you need in `{alias}` with `item: {member}.item`"))
        }
    }
    None
}

// `core.math.NAME` through `use core: core`: the nested Core module's
// constant, read as `math.NAME` reads it through `use math: core.math`.
sema_expression_core_nested_constant: fn(alias: String, nested: String, member: String, member_span: Span, span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    unhandled: SemaMethodSpecialCheck{handled: false, value: None}
    index: sema_scope_resolve_index(check.scopes, alias) ?? return unhandled
    if check.scopes.bindings[index].symbol.kind != SymbolKind.Import -> return unhandled
    target: sema_call_core_import_target(check.environment.*, check.program.*, alias) ?? return unhandled
    if target.item != None -> return unhandled
    module_name: "{target.module_name}.{nested}"
    module_identity: sema_call_core_module_identity(check.environment.*, check.program.*, module_name) ?? return unhandled
    graph: check.program.registration_graph
    module_index: sema_registration_module_index(graph, module_identity) ?? return unhandled
    export: sema_registration_resolve_export(graph, module_index, member, check.environment.module_identity, check.environment.package_identity) ?? {
        check.diagnostics.push(sema_expression_core_member_unknown(graph.modules[module_index], member, member_span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    resolved: SemaRegistrationResolvedSymbol{place: SemaRegistrationSymbolPlace.Detached{symbol: sema_registration_export_symbol(graph, export)}, source_module_identity: export.source_module_identity, target_module_identity: module_identity, visibility: export.visibility}
    sema_expression_module_constant_read(graph, resolved, "{alias}.{nested}.{member}", span, expected, check)
}

// The read of a resolved module member: a constant is a ConstRef typed by its
// staged value. A constant whose value has not landed is a dependency wait
// (the reference names it) and, after the comptime run, a recorded
// incomplete reason. A source function member (`f: text.shout`) reads as
// the function value, as the bare name does once imported; Core functions
// keep their own value route. Any other member kind is not a value read here.
sema_expression_module_constant_read: fn(graph: SemaRegistrationGraph, resolved: SemaRegistrationResolvedSymbol, label: String, span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    kind: sema_resolved_kind(graph, resolved)
    source_function: kind == SymbolKind.Function && !module_is_core(resolved.source_module_identity)
    if kind != SymbolKind.Constant && !source_function {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    symbol: sema_resolved_symbol(graph, resolved)
    if source_function {
        signature: symbol.ty ?? return SemaMethodSpecialCheck{handled: false, value: None}
        check.context.name_references.push(sema_name_reference(span, symbol, Val(SymbolKind.Function)))
        if sema_expr_marked_function_value(label, symbol.id, span, expected, check.environment.*, check.program.*, check.diagnostics) {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        value_type: sema_function_value_type(check.program.*, signature, symbol.module_identity, expected)
        // A C `#Import` function crosses only by a direct call: as a value it
        // would be a Jet function type, which has no C ABI.
        if sema_registration_callable_row_of(graph, symbol.id) == .Val(.Foreign(module_index, index)) && graph.modules[module_index].foreign_functions[index].owner == SemaRegistrationForeignOwner.CModule {
            check.diagnostics.push(sema_checked_foreign_type_error(value_type, span, true))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        function: sema_node(check.context, value_type, NodeKind.ConstRef{symbol: symbol.id}, span)
        return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(function, expected, check.environment.*, check.program.*, check.diagnostics)}
    }
    check.context.name_references.push(sema_name_reference(span, symbol, Val(SymbolKind.Constant)))
    ty: symbol.ty ?? {
        sema_check_unsupported(check.context, "constant `{label}` (read at offset {span.start}) has no staged compile-time value")
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    sema_scope_record_module_constant_read(check.environment.*, check.program.*, check.context, symbol, label, ty, span)
    value: sema_node(check.context, ty, NodeKind.ConstRef{symbol: symbol.id}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// The report for `alias.member` when the whole-module import `alias` names
// a module without `member`, as the call path reports `alias.member(..)`:
// E0605 for an item its own declaration keeps private, E1004 for another
// Core item and E0102 otherwise.
// None when `alias` is not a whole-module import (a binding with no
// declaration, as `sema_call_source_import_target` reads it).
sema_expression_module_member_unknown: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, alias: String, member: String, member_span: Span) -> Diagnostic? {
    module_index: sema_registration_module_index(graph, module_identity) ?? return None
    loop import in graph.modules[module_index].imports {
        loop binding in import.bindings {
            if binding.local != alias || binding.symbol.kind != SymbolKind.Import || binding.declaration_position != None {
                next
            }
            target_index: sema_registration_module_index(graph, binding.target_module_identity) ?? return None
            target: graph.modules[target_index]
            declared_private: if sema_registration_direct_symbol(target, member) == {
                .Val(declared) -> !sema_registration_visible(declared.visibility, module_identity, graph.modules[module_index].package_identity, target.module_identity, target.package_identity)
                .None -> false
            }
            if module_is_core(target.module_identity) && !declared_private {
                return Val(sema_expression_core_member_unknown(target, member, member_span))
            }
            if sema_registration_direct_symbol(target, member) != None {
                return Val(sema_error("E0605", member_span, "`{alias}.{member}` is private to its module", "a `priv module` is usable only by its enclosing module (`priv(package)`: by its package), and a `priv` field only by its type's module", "use `{alias}.{member}` from inside its module, or remove `priv` from its module or field"))
            }
            return Val(sema_call_import_member_unknown(target.module_name, member, member_span))
        }
    }
    None
}

// E1004 for a Core module value read: a constant spelled in another case
// (`math.pi` for `PI`) is the suggestion, ahead of the module's call menu.
sema_expression_core_member_unknown: fn(module_row: SemaRegistrationModule, member: String, member_span: Span) -> Diagnostic {
    loop symbol in module_row.symbols {
        if symbol.kind != SymbolKind.Constant || symbol.name == member || symbol.name.lower() != member.lower() {
            next
        }
        diagnostic: sema_error("E1004", member_span, "`{module_row.module_name}` has no item `{member}`", "standard library modules expose a fixed set of public items", "did you mean `{symbol.name}`?")
        return diagnostic_with_edit(diagnostic, TextEdit{span: member_span, new_text: symbol.name})
    }
    sema_call_core_unknown_item(module_row.module_name, member, member_span)
}

// A method read without parentheses where a function type is expected
// (`each(ids, crew.tell)`, or a `(fn(Int) -> String)?` slot) is the method
// with its receiver bound: the lambda `fn(a, …) { crew.tell(a, …) }`, checked
// against that function type, so the method's parameters, result, error
// type and effects must fit it, and a generic method takes its type
// arguments from it. A name or field path is captured as a closure captures
// it, so a closure that cannot keep it is refused naming it, and a `^self`
// method whose closure would copy it is E0924 (Lambdas.jet, `bound_write`).
// Any other receiver is evaluated once, at the read,
// into a hidden binding the lambda captures. A `^^self` method is E0924, and
// a type with both a field and a method of that name makes the read E0950.
// `read` is None where no function type is expected or the type has no such
// method.
SemaBoundMethodRead: struct {
    read: Expr?,
    invalid: Bool,
}

sema_expression_bound_method: fn(base: Expr, member: String, span: Span, receiver: Type, expected: Type?, check: ^SemaBodyCheck) -> SemaBoundMethodRead {
    none: SemaBoundMethodRead{read: None, invalid: false}
    slot: sema_expression_fn_slot(expected, check) ?? return none
    candidates: sema_expression_method_candidates(receiver, member, span, check.environment.*, check.program.*)
    if candidates.len() == 0 -> return none
    count: if slot == .Fn(params, _, _, _, _, _) -> params.len() else -> 0
    if sema_expression_declares_field(receiver, member, check) {
        check.diagnostics.push(sema_expression_field_method_clash(base, member, span, count))
        return SemaBoundMethodRead{read: None, invalid: true}
    }
    receiver_convention: candidates[0].receiver_convention
    if receiver_convention == AccessConvention.Move {
        check.diagnostics.push(sema_error("E0924", span, "`{member}` takes `^^self`, so `{sema_expression_move_mark_text(base)}.{member}` is no function value", "every call of a bound value would consume the same receiver", "call `{member}` once where it is needed, or write a closure that moves the receiver in"))
        return SemaBoundMethodRead{read: None, invalid: true}
    }
    ^conventions: [AccessConvention]{}
    if slot == .Fn(_, _, _, _, call_metadata, _) {
        loop index in 0..<count {
            conventions.push(sema_call_fn_param_convention(call_metadata, index))
        }
    }
    hidden: pipe_value_name(expr_source_start(base))
    // copy: the generated read owns its receiver; `base` is the caller's AST
    // node. A path receiver is read again inside the lambda; any other is the
    // head of the hidden binding the lambda captures.
    owned: base.copy()
    ^receiver_expr: Expr.Ident{name: hidden, span: expr_span(base), id: AST_NODE_GENERATED}
    ^head: Expr?{None}
    if {
        sema_expression_bound_receiver_rooted(base) -> receiver_expr = owned
        else -> head = Val(owned)
    }
    params: loop index in 0..<count -> LambdaParam{name: "__jet_bound_{index}", name_span: span, ty: None, ty_span: None, convention: conventions[index]}
    args: loop index in 0..<count -> CallArg{convention: conventions[index], expr: Expr.Ident{name: "__jet_bound_{index}", span: span, id: AST_NODE_GENERATED}, span: span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
    member_span: Span{start: span.end - member.len(), end: span.end}
    call: Expr.MethodCall{receiver: receiver_expr, method: member, method_span: member_span, owner_type_args: [Type]{}, type_args: [Type]{}, args: args, id: AST_NODE_GENERATED}
    ^meta: ast_empty_lambda_meta()
    meta.bound_write = head == None && receiver_convention == AccessConvention.Write
    lambda: Expr.Lambda{lambda: Lambda{take_names: [NamedSpan]{}, params: params, effects: None, body: LambdaBody.Expr{value: call}, span: span, meta: meta}, id: AST_NODE_GENERATED}
    pipe_head: head ?? return SemaBoundMethodRead{read: Val(lambda), invalid: false}
    // The hidden binding is declared at the receiver, where the lambda reads
    // it: a binding is visible only from its declaration on, and the read's
    // own span starts at the member name, after the receiver.
    step: PipeStep{name: hidden, value: lambda, reads: 1, span: expr_span(base)}
    SemaBoundMethodRead{read: Val(Expr.Pipe{head: pipe_head, steps: [PipeStep]{step}, span: span, id: AST_NODE_GENERATED}), invalid: false}
}

// The function type a slot expects: `F` itself or the `F` of an optional
// `(F)?`, read through aliases; None for any other expectation.
sema_expression_fn_slot: fn(expected: Type?, check: SemaBodyCheck) -> Type? {
    wanted: expected ?? return None
    if wanted == {
        .Fn(_, _, _, _, _, _) | .Option(_) | .Named(_) | .Apply(_, _) | .Tagged(_, _) -> {}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return None
    }
    resolved: sema_expr_unwrap_tag(sema_call_resolved_type(wanted, check.environment.*, check.program.*))
    if resolved == .Fn(_, _, _, _, _, _) -> return Val(resolved)
    sema_expression_optional_fn_slot(expected, check)
}

// Whether a closure can capture the receiver as written: a name, or a field
// path of one.
sema_expression_bound_receiver_rooted: fn(expr: Expr) -> Bool Never! {
    if expr == .Ident(_, _, _) -> return true
    if expr == .Field(base, _, _, _) -> return sema_expression_bound_receiver_rooted(base)
    false
}

// The methods `member` names on a value of type `receiver`; the lookup only
// asks which exist, so its own reports are dropped.
sema_expression_method_candidates: fn(receiver: Type, member: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables) -> [SemaCallMethodCandidate] {
    graph: program.registration_graph
    ^probe: [Diagnostic]{}
    sema_expr_registration_method_candidates(graph, environment.module_identity, receiver, member, [Type]{}, [Type]{}, span, environment, program, probe)
}

// Whether the struct a value of type `receiver` is declares a field `member`.
sema_expression_declares_field: fn(receiver: Type, member: String, check: ^SemaBodyCheck) -> Bool {
    pinned: sema_pin_target(receiver)
    found_name: if pinned == .Val(target) -> sema_expr_type_base_name(sema_expr_unwrap_tag(target)) else -> sema_expr_type_base_name(sema_expr_unwrap_tag(receiver))
    owner_name: found_name ?? return false
    ^owner: sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, owner_name)
    if owner == None {
        owner = sema_expression_carrier_type_symbol(check.environment.*, check.program.*, owner_name)
    }
    symbol: owner ?? return false
    struct_def: sema_scope_declaration_struct(check.environment.*, check.program.*, symbol.id) ?? return false
    loop field in struct_def.fields {
        if field.name == member -> return true
    }
    false
}

// E0950: where a function type is expected, `value.name` names both a field
// and a method of the value's type. The fix offers the closure for each.
sema_expression_field_method_clash: fn(base: Expr, member: String, span: Span, count: Int) -> Diagnostic Never! {
    receiver: sema_expression_move_mark_text(base)
    names: if count == 1 -> "x" else -> (loop index in 0..<count -> "x{index + 1}").join(", ")
    sema_error("E0950", span, "`{receiver}.{member}` names both a field and a method `{member}`", "where a function type is expected, a method read without parentheses passes the method with `{receiver}` bound, and a field read passes the field's value; with both, the read could silently switch from one to the other", "write `fn({names}) {{ {receiver}.{member}({names}) }}` to pass the method, or `fn({names}) {{ {receiver}.{member}.call({names}) }}` to pass the field")
}

// E0924: a method read without parentheses where no function type is
// expected; the fix adds the call's parentheses.
sema_expression_method_read_without_call: fn(owner_name: String, member: String, span: Span) -> Diagnostic Never! {
    diagnostic: sema_error("E0924", span, "`{member}` is a method of `{owner_name}`, not a field; call it: `.{member}()`", "a method read without parentheses is a value only where a function type is expected; anywhere else it is a forgotten call", "add `()` to call `{member}`, or write a closure that calls it")
    diagnostic_with_edit(diagnostic, TextEdit{span: Span{start: span.end, end: span.end}, new_text: "()"})
}

// `.xyzw` and `.rgba` name the slots of a value whose type has them: every
// slot of a fixed array of one to four, or the first four lanes of a Core
// vector or lane type. That is a Core struct that stores its lanes as
// `lanes: [T#N]` and reads one with `lane(index)`; a matrix stores `lanes`
// but reads no lane. One letter reads that slot. Several read the
// declaration's own `__swizzleK` when it has one, so `Vec3.zyx` is a `Vec3`
// and `F32x4.xy` a `Vec2`; otherwise they read `[T#K]` of those slots, with
// the value evaluated once. A write is the declaration's `__swizzle_setK`,
// else a write of the slots (Statements/Assignments.jet).
SemaSwizzleSlots: struct {
    // The type as diagnostics name it.
    shown: String,
    element: Type,
    // How many slots the value has, and how many of them letters reach.
    length: Int,
    reach: Int,
    // Whether the slots are the value's `lanes` field.
    lanes: Bool,
    // Bit K: the declaration has `__swizzleK`; bit
    // SEMA_SWIZZLE_SET_BIT + K: it has `__swizzle_setK`; bit
    // SEMA_WITH_LANES_BIT: it has `__with_lanes`, which bit operators and
    // shifts on its integer lanes build their result with
    // (Expressions/FixedArithmetic.jet).
    declared: Int,
}

SEMA_SWIZZLE_SET_BIT: 8

SEMA_WITH_LANES_BIT: 16

SemaSwizzleRead: struct {
    read: Expr?,
    invalid: Bool,
}

// Fast pre-filter: only 1..4 ASCII swizzle letters (x/y/z/w/r/g/b/a) can
// ever parse as a swizzle member, avoiding nominal graph lookups on ordinary fields.
sema_expression_is_swizzle_member: fn(member: String) -> Bool Never! {
    len: member.count_bytes()
    if len == 0 || len > 4 -> return false
    loop byte in member.bytes() {
        if sema_expression_swizzle_letter(byte) == None -> return false
    }
    true
}

sema_expression_swizzle_read: fn(base: Expr, member: String, span: Span, ty: Type, check: ^SemaBodyCheck) -> SemaSwizzleRead {
    none: SemaSwizzleRead{read: None, invalid: false}
    if !sema_expression_is_swizzle_member(member) -> return none
    slots: sema_expression_swizzle_slots(ty, check) ?? return none
    parsed: sema_expression_math_swizzle_parse(slots, member, span, check.diagnostics)
    if parsed == {
        .NotSwizzle -> none
        .InvalidLane -> SemaSwizzleRead{read: None, invalid: true}
        // copy: the generated read owns its receiver; `base` stays the field's.
        .Lanes(packed, count, _) -> SemaSwizzleRead{read: Val(sema_expression_swizzle_read_expr(base.copy(), slots, packed, count, span)), invalid: false}
    }
}

// The read of `count` lanes, packed two bits each, of `base`.
sema_expression_swizzle_read_expr: fn(base: Expr, slots: SemaSwizzleSlots, packed: Int, count: Int, span: Span) -> Expr {
    if slots.lanes && (count == 1 || slots.declared & (1 << count) != 0) {
        args: loop index in 0..<count -> {
            lane: (packed >> (index * 2)) & 3
            CallArg{convention: AccessConvention.Read, expr: Expr.Int{value: lane, span: span, width: None, raw: None, id: AST_NODE_GENERATED}, span: span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
        }
        method: if count == 1 -> "lane" else -> "__swizzle{count}"
        return Expr.MethodCall{receiver: base, method: method, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: args, id: AST_NODE_GENERATED}
    }
    if count == 1 -> return sema_expression_swizzle_slot(base, slots, packed & 3, span)
    // A name is read in place; any other value is bound once, as a pipe binds
    // its head.
    name: if base == .Ident(local, _, _) -> "{local}" else -> pipe_value_name(span.start)
    elements: loop index in 0..<count -> sema_expression_swizzle_slot(Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}, slots, (packed >> (index * 2)) & 3, span)
    sema_expression_swizzle_bound(base, name, count, sema_expression_swizzle_literal(slots.element, elements, span), span)
}

// The array holding the slots of `value`: its `lanes` field, or itself.
sema_expression_swizzle_owner: fn(value: Expr, slots: SemaSwizzleSlots, span: Span) -> Expr Never! {
    if slots.lanes -> Expr.Field{base: value, member: "lanes", span: span, id: AST_NODE_GENERATED} else -> value
}

// Slot `lane` of `value`.
sema_expression_swizzle_slot: fn(value: Expr, slots: SemaSwizzleSlots, lane: Int, span: Span) -> Expr Never! {
    Expr.Index{base: sema_expression_swizzle_owner(value, slots, span), index: Expr.Int{value: lane, span: span, width: None, raw: None, id: AST_NODE_GENERATED}, span: span, kind: IndexKind.Unknown, id: AST_NODE_GENERATED}
}

// `[T#N]{elements…}`.
sema_expression_swizzle_literal: fn(element: Type, elements: [Expr], span: Span) -> Expr Never! {
    head: Type.FixedList{elem: element, len: Measure.Literal{kind: "length", value: elements.len()}}
    Expr.TypedLit{head: Val(head), body: TypedLitBody.Elements{elements: elements}, span: span, id: AST_NODE_GENERATED}
}

// `head |> value`, where `value` reads `head` as `name` `reads` times.
sema_expression_swizzle_bound: fn(head: Expr, name: String, reads: Int, value: Expr, span: Span) -> Expr Never! {
    Expr.Pipe{head: head, steps: [PipeStep]{PipeStep{name: name, value: value, reads: reads, span: span}}, span: span, id: AST_NODE_GENERATED}
}

// The slots `.xyzw` and `.rgba` name on a value of `ty`, or None when it has
// none.
sema_expression_swizzle_slots: fn(ty: Type, check: SemaBodyCheck) -> SemaSwizzleSlots? {
    if ty == .FixedList(element, measure) {
        length: measure_literal_value(measure) ?? return None
        if length < 1 || length > 4 -> return None
        return Val(SemaSwizzleSlots{shown: type_name(ty), element: element, length: length, reach: length, lanes: false, declared: 0})
    }
    graph: check.program.registration_graph
    row: sema_type_resolve_nominal_row(graph, ty, check.environment.module_identity) ?? return None
    sema_expression_swizzle_lane_slots(graph, graph.modules[row.module_index].nominals[row.row], ty)
}

// The lanes of a Core vector or lane type `nominal` declares, or None for any
// other declaration.
sema_expression_swizzle_lane_slots: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, ty: Type) -> SemaSwizzleSlots? {
    if !core_source_owns_type("{module_text(graph.module_table, nominal.symbol.module_identity)}.{nominal.symbol.name}") {
        return None
    }
    ^reads_lane: false
    ^declared: 0
    loop function in nominal.methods {
        if function.symbol.name == "lane" -> reads_lane = true
        declared |= sema_expression_swizzle_method_bit(function.symbol.name)
    }
    if !reads_lane -> return None
    loop field in nominal.fields {
        if field.symbol.name != "lanes" -> next
        if field.ty == .FixedList(element, measure) {
            length: measure_literal_value(measure) ?? return None
            shown: sema_expr_math_leaf_name(ty) ?? type_name(ty)
            return Val(SemaSwizzleSlots{shown: shown, element: element, length: length, reach: if length < 4 -> length else -> 4, lanes: true, declared: declared})
        }
    }
    None
}

// The `declared` bit of a declaration's own swizzle or `__with_lanes`
// method, or 0.
sema_expression_swizzle_method_bit: fn(name: String) -> Int Never! {
    if name == {
        "__swizzle2" -> 1 << 2
        "__swizzle3" -> 1 << 3
        "__swizzle4" -> 1 << 4
        "__swizzle_set1" -> 1 << (SEMA_SWIZZLE_SET_BIT + 1)
        "__swizzle_set2" -> 1 << (SEMA_SWIZZLE_SET_BIT + 2)
        "__swizzle_set3" -> 1 << (SEMA_SWIZZLE_SET_BIT + 3)
        "__swizzle_set4" -> 1 << (SEMA_SWIZZLE_SET_BIT + 4)
        "__with_lanes" -> 1 << SEMA_WITH_LANES_BIT
        else -> 0
    }
}

// A swizzle letter: x, y, z and w name slots 0 to 3, as 0 to 3; r, g, b and a
// name them too, as 4 to 7. None for any other byte.
sema_expression_swizzle_letter: fn(code: Int) -> Int? Never! {
    if code == {
        120 -> Val(0)
        121 -> Val(1)
        122 -> Val(2)
        119 -> Val(3)
        114 -> Val(4)
        103 -> Val(5)
        98 -> Val(6)
        97 -> Val(7)
        else -> None
    }
}

// The letter `sema_expression_swizzle_letter` reads as `named`.
sema_expression_swizzle_letter_name: fn(named: Int) -> String Never! {
    if named == {
        0 -> "x"
        1 -> "y"
        2 -> "z"
        3 -> "w"
        4 -> "r"
        5 -> "g"
        6 -> "b"
        else -> "a"
    }
}

// `v.xy` names up to four slots, with letters of one set. One lane reads the
// scalar; several read as the declaration says, or a fixed array.
SemaMathSwizzleParse: enum {
    NotSwizzle,
    InvalidLane,
    Lanes(packed: Int, count: Int, overlaps: Bool),
}

sema_expression_math_swizzle_parse: fn(slots: SemaSwizzleSlots, member: String, span: Span, diagnostics: ^[Diagnostic]) -> SemaMathSwizzleParse {
    if member.len() == 0 || member.len() > 4 -> return .NotSwizzle
    // Four two-bit lane indexes fit in one scalar. Write validation needs
    // no temporary collection; reads allocate only their final checked lane list.
    ^packed: 0
    ^count: 0
    ^seen: 0
    ^overlaps: false
    ^letters: -1
    loop byte in member.bytes() {
        named: sema_expression_swizzle_letter(Int{byte}) ?? return .NotSwizzle
        set: named >> 2
        if letters >= 0 && set != letters -> return .NotSwizzle
        letters = set
        lane: named & 3
        if lane >= slots.reach {
            ^valid: loop slot in 0..<slots.reach -> sema_expression_swizzle_letter_name(set * 4 + slot)
            last: valid.pop() ?? ""
            listed: if valid.len() == 0 -> last else if valid.len() == 1 -> "{valid[0]} and {last}" else -> "{valid.join(", ")}, and {last}"
            family: if set == 0 -> "x/y/z/w" else -> "r/g/b/a"
            diagnostics.push(sema_error("E3110", span, "lane `{sema_expression_swizzle_letter_name(named)}` isn't valid on `{slots.shown}`", "swizzle members name lanes with {family} — `{slots.shown}` only has {listed}", "use only the lanes defined for `{slots.shown}`"))
            return .InvalidLane
        }
        bit: 1 << lane
        if seen & bit != 0 -> overlaps = true
        seen |= bit
        packed |= lane << (count * 2)
        count += 1
    }
    SemaMathSwizzleParse.Lanes{packed: packed, count: count, overlaps: overlaps}
}

// The type of `Numeric.MEMBER`, or None when `base` is not a numeric type name
// or `member` is not one of its constants. The name means what it means where
// it is written: a program's `Byte: Unsigned<8>` is U8, and its own type
// spelled `U8` has no such constants.
sema_expression_numeric_bound_type: fn(base: Expr, member: String, check: ^SemaBodyCheck) -> Type? {
    integer_member: member == "MIN" || member == "MAX"
    if !integer_member && member != "INFINITY" && member != "NEG_INFINITY" && member != "NAN" && member != "EPSILON" {
        return None
    }
    if base == .Ident(owner_name, _, _) {
        written: sema_expression_written_type(owner_name, check)
        if written == .Named(_) -> return None
        kind: builtin_numeric_kind(type_name(written)) ?? return None
        if integer_member -> return Val(kind.ty)
        if !kind.integer -> return Val(kind.ty)
    }
    None
}

// The type the bare type name `name` spells where it is written: the type
// a declaration or import the scope sees names (`Byte: Unsigned<8>` is U8,
// a program's own `U8` struct is its own), else the compiler's own type
// the spelling names (`U8`, `Int`).
sema_expression_written_type: fn(name: String, check: ^SemaBodyCheck) -> Type {
    if sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, name) == None {
        return foundation_named_type(name)
    }
    graph: check.program.registration_graph
    sema_type_graph_resolve_named(graph, name, sema_scope_caller_row(check.environment.*, graph))
}

// Reading a secret-bearing value's raw bytes is an exposure.
// Only the module that declares the secret type reads its bytes freely, as a
// module reads its own type's fields. Every other module, a Core one included,
// needs an audited `#Unsafe` region, exactly like the `core.crypto.expert`
// exposure functions.
sema_expression_secret_exposure_allowed: fn(ty: Type, member: String, span: Span, check: ^SemaBodyCheck) -> Bool {
    if member != "bytes" || check.context.unsafe_depth > 0 || !sema_call_reflection_secret_bearing(ty) {
        return true
    }
    graph: check.program.registration_graph
    caller_index: sema_scope_caller_index(check.environment.*, graph) ?? return true
    if sema_expression_secret_declared_by(graph, ty, caller_index) -> return true
    shown: type_name(ty)
    exposure: if {
        shown.ends_with("SigningKey") -> "signing_key_bytes"
        shown.ends_with("X25519SecretKey") -> "x25519_secret_bytes"
        shown.ends_with("SharedSecret") -> "shared_secret_bytes"
        else -> "secret_bytes"
    }
    check.diagnostics.push(sema_error("E0510", span, "reading `{shown}.bytes` exposes secret key material", "secret-bearing values cannot be printed, interpolated, or read as raw bytes outside an audited expert gate", "keep the value inside `crypto` operations, or call `expert.{exposure}(value)` inside `#Unsafe(\"reason\") {{ … }}`"))
    false
}

// Whether module row `caller` declares the secret type `ty` names: one of its
// own nominals of that leaf is a secret-bearing declaration.
sema_expression_secret_declared_by: fn(graph: SemaRegistrationGraph, ty: Type, caller: Int) -> Bool Never! {
    name: sema_type_graph_base_name(ty) ?? return false
    leaf: sema_call_reflection_leaf_name(name)
    loop row in 0..<graph.modules[caller].nominals.len() {
        if graph.modules[caller].nominals[row].symbol.name != leaf -> next
        if sema_call_reflection_secret_bearing(Type.Named{name: "{module_text(graph.module_table, graph.modules[caller].nominals[row].symbol.module_identity)}.{leaf}"}) {
            return true
        }
    }
    false
}

// S71 the chain yields `T?`; an already-optional member flattens, so
// `user?.address?.city` stays one optional layer deep.
sema_expression_optional_field: fn(base: Expr, member: String, member_span: Span, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    checked_base: sema_check_expression(base, None, check) ?? return None
    inner_ty: if checked_base.ty == {
        .Option(value) -> value
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
            check.diagnostics.push(sema_error("E0047", member_span, "`?.` needs an optional on the left, but this is `{sema_registration_serde_label(checked_base.ty)}`", "optional chaining short-circuits a `T?` to absent on a missing link", "use plain `.` here, or make the value optional first"))
            return None
        }
    }
    inner_base: TExpr{ty: inner_ty, kind: checked_base.kind, span: checked_base.span}
    checked_field: sema_expression_field_checked(inner_base, member, span, None, check.environment.*, check.program.*, check.scopes, check.context, check.diagnostics) ?? return None
    field_ty: checked_field.ty
    flatten: if field_ty == {
        .Option(_) -> true
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
    result_ty: if flatten -> field_ty else -> Type.Option{inner: field_ty}
    value: sema_tree_node(result_ty, TExprKind.OptField{base: checked_base, member: member, flatten: flatten}, span)
    sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

// S71 `receiver?.method(args)` checks the ordinary method call on
// a read-only view of the present payload. The call runs only when the
// receiver is present; its result lifts to `R?` and flattens like `?.field`.
// The call keeps its own failure rule: a fallible method propagates exactly as
// the same call on a plain receiver would.
sema_expression_optional_method_call: fn(receiver: Expr, method: String, method_span: Span, type_args: [Type], args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    checked_base: sema_check_expression(receiver, None, check) ?? return None
    inner_ty: if checked_base.ty == {
        .Option(value) -> value
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
            check.diagnostics.push(sema_error("E0047", method_span, "`?.` needs an optional on the left, but this is `{sema_registration_serde_label(checked_base.ty)}`", "optional chaining short-circuits a `T?` to absent on a missing link", "use plain `.` here, or make the value optional first"))
            return None
        }
    }
    receiver_span: expr_span(receiver)
    name: "__jet_optional_receiver_{method_span.start}"
    sema_scope_enter(check.scopes, check.state, "optional-call@{method_span.start}")
    module_name: sema_scope_environment_module_text(check.environment.*, check.program.*)
    owner: sema_scope_local_owner_key(check.scopes)
    key: symbol_key_text(SymbolKind.Local, module_name, owner, name)
    symbol: Symbol{
        id: sema_symbol_id_of(check.program.*, check.context, key),
        kind: SymbolKind.Local,
        name: name,
        module_identity: check.environment.module_identity,
        owner: Val(owner),
        span: receiver_span,
        ty: Val(inner_ty),
        visibility: 0,
    }
    if !sema_scope_declare_local(check.scopes, symbol, key, false, AccessConvention.Read, None, false) {
        sema_scope_leave(check.scopes, check.state)
        check.diagnostics.push(sema_already_defined(name, receiver_span))
        return None
    }
    sema_ownership_declare_binding(check.state, symbol, false)
    call_expr: expr_optional_method_call_as_call(Expr.Ident{name: name, span: receiver_span, id: AST_NODE_GENERATED}, method, method_span, type_args, args)
    ^checked_call: sema_check_expression(call_expr, None, check)
    sema_scope_leave(check.scopes, check.state)
    call: checked_call ?? return None
    flatten: if call.ty == {
        .Option(_) -> true
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
    result_ty: if flatten -> call.ty else -> Type.Option{inner: call.ty}
    binding: checked_symbol_local(name, receiver_span, symbol.id, inner_ty)
    value: sema_tree_node(result_ty, TExprKind.OptMethodCall{base: checked_base, binding: binding, call: call, flatten: flatten}, span)
    sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
}
