                        } else {
                            self.diags.push(Diagnostic.error("E0405", "`{Syntax.OP_FALLBACK} return` can't return a value here", "this function returns nothing, so `return` can't carry a value", "drop the value, or add a return type before `->`", Val(e.span())))
                        }
                    }
                    (.None, .None) -> {}
                }
