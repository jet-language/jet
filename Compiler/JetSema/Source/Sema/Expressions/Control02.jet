                        }
                    }
                }
                Val(~payload)
            }
            .Return(ret_expr, ret_span) -> {
                ret :: self.return_route_type()
                if (ret, ret_expr) == {
                    (.Val(rt), .Val(e)) -> {
                        saved :: ~self.expected_type
                        self.expected_type = Val(~rt)
                        et :: self.infer(&e)
                        self.expected_type = ^saved
                        if et == .Val(checked) {
                            widened :: self.widen_numeric_return(&e, checked, rt) ?? checked
                            lifted :: self.lift_optional_slot(rt, widened, &e) ?? widened
                            _ :: self.check_type_assignable(rt, lifted, e.span())
                        }
                    }
                    (.Val(rt), .None) -> self.diags.push(Diagnostic.error("E0405", "`{Syntax.OP_FALLBACK} return` here needs a value", "a bare `return` needs a value here because the function returns {rt.show()}", "give a fallback value: `{Syntax.OP_FALLBACK} return <value>`", Val(ret_span)))
                    (.None, .Val(e)) -> {
                        if self.declared_return_type == .Val(declared) && declared.unwrap_result().is_some() {
