            }
            .Panic -> {
                call := Call{name: Syntax.BUILTIN_PANIC, name_span: fallback.name_span, type_args: [Type]{}, args: ^fallback.args, resolved_ret: None, range_checked: false, widen_approx: false}
                fallback.args = [CallArg]{}
                saved :: self.autodiff_safe_panic_context
                self.autodiff_safe_panic_context = compute_failure_fallback
                self.check_panic_call(&call)
