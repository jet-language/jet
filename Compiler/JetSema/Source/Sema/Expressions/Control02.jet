        self.reject_borrowed_param_subplace(&value, Val(ty), "supply an owned fallback payload")
        compute_failure_fallback :: payload.is_compute_tensor_family() && self.is_core_compute_call(value)
        saved_fallback_has_err :: self.fallback_has_err
        saved_fallback_is_shape_miss :: self.fallback_is_shape_miss
        self.fallback_is_shape_miss = false
        self.fallback_has_err = Val(!is_option)
        ambient_scope :: !is_option
        if ambient_scope {
            if ty != .Result(_, err_ty) -> panic("non-result fallback cannot expose err")
            self.push_scope()
            self.declare_in_scope(Syntax.AMBIENT_ERR, LocalInfo{def_span: span, binding_sigil_span: None, ty: ~err_ty, mutable: false, param_conv: None, decl_loop_depth: self.loop_depth, interrupt_sendable: false, reactive_local: false, reactive_shared: false, single_use_span: None, invalid: false})
        }
        success_path :: ~self.flow
        result :: if fallback == {
            .Value(e) -> {
                saved :: ~self.expected_type
                self.expected_type = if !success_never { Val(~payload) } else { None }
                fallback_diverges :: self.expr_diverges(e)
                ft :: self.infer(&e)
                self.expected_type = ^saved
                checked :: ft ?? {
