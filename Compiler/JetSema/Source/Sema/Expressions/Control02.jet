// Type inference: fallible forms (Ok/Err/try/?? fallback).
use jet_foundation.[Diagnostic, FixApplicability, FixSafety, Span, TextEdit, Call, CallArg, AccessConvention, Expr, EnumLitArg, LambdaBody, OrFallback, Stmt, TryConvert, Type, FuncSig, FailureContract, CoreModuleExports, union_enum_name, union_member_tag, member_name, span_line_col, ast_empty_call_arg_flags]
use jet_sema.[Checker, LocalInfo, FailureCase, FlowFacts, FAILURE_OBLIGATION_MARK, is_core_error_family_type, is_default_error, type_fix_hint, error_conv_fn_name, loop_control_outside, undefined_loop_label, block_definitely_exits]
use jet_syntax as Syntax
use jet_collections.[builtin_method_return]

// Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:12
struct FailureCallProvenance {
    callee: String,
    definition: String,
    contract: String,
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:18
fn publish_try_call_carrier(inner: &Expr, carrier: () -> Type) Never! {
    carrier_expr := &inner
    loop carrier_expr == .Paren(paren, _) { carrier_expr = &paren }
    if carrier_expr == {
        .Call(call) -> {
            if call.resolved_ret == .Val(checked_return) && !checked_return.is_fallible() { call.resolved_ret = Val(carrier()) }
        }
        .MethodCall -> {
            if carrier_expr.resolved_ret == .Val(checked_return) && !checked_return.is_fallible() { carrier_expr.resolved_ret = Val(carrier()) }
        }
        else -> {}
    }
}

impl Checker {
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:36
    pub fn infer_ok(self: &Self, inner: &Expr, span: Span) -> Type? Never! {
        expected_result := (Type, Type)?{None}
        if self.expected_type == .Val(expected) && expected.unwrap_result() == .Val((ok_ty, err_ty)) { expected_result = Val((~ok_ty, ~err_ty)) }
        payload :: if expected_result == .Val((ok_ty, _)) { self.infer_with_expected(&inner, ok_ty) ?? return None } else { self.infer_owning_value(&inner) ?? return None }
        if expected_result == .Val((ok_ty, err_ty)) {
            ok_payload :: payload == ok_ty || (if ok_ty == { .Union(members) -> members.any(|m| m == payload); else -> false })
            if !ok_payload {
                self.diags.push(Diagnostic.error("E0108", "this `{Syntax.LIT_OK}` holds {payload.show()}, but {ok_ty.show()} was expected", "the success value must match the result's value type", type_fix_hint(ok_ty, payload), Val(span)))
            }
            return Val(Type.Result(^ok_ty, ^err_ty))
        }
        self.diags.push(Diagnostic.error("E0404", "`{Syntax.LIT_OK}(...)` only fits where a fallible result is expected", "`{Syntax.LIT_OK}` builds the success side of a `T !E` result", "use it in a `T !E` return type, a `T !E` binding annotation, or a call that expects one", Val(span)))
        None
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:85
    pub fn failure_union_probing(self) -> Bool Never! {
        self.failure_union_probe.is_some() && !self.in_lambda_body
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:93
    fn probe_failure_value(self: &Self, inner: &Expr) Never! {
        saved_expected :: ^self.expected_type
        self.expected_type = None
        if inner == .EnumLit && inner.type_name.is_empty() {
            name :: ~inner.variant
            span :: inner.span
            payload := [(String?, Type)]{}
            payload.reserve(inner.args.len())
            loop arg in &inner.args {
                if arg == {
                    .Positional(expr) -> {
                        ty :: self.infer_owning_value(&expr) ?? Type.Named("_")
                        payload.push((None, ^ty))
                    }
                    .Named -> {
                        ty :: self.infer_owning_value(&arg.expr) ?? Type.Named("_")
                        payload.push((Val(~arg.label), ^ty))
                    }
                }
            }
            self.expected_type = ^saved_expected
            if self.failure_union_probe == .Val(probe) { probe.cases.push(FailureCase{name: ^name, payload: ^payload, span: span}) }
            return
        }
        payload :: self.infer_owning_value(&inner)
        self.expected_type = ^saved_expected
        if self.failure_union_probe == .Val(probe) {
            if payload == { .Val(ty) -> probe.add_member(ty); .None -> probe.general = true }
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:140
    pub fn infer_err(self: &Self, inner: &Expr, span: Span) -> Type? Never! {
        expected_result := (Type, Type)?{None}
        if self.expected_type == .Val(expected) && expected.unwrap_result() == .Val((ok_ty, err_ty)) { expected_result = Val((~ok_ty, ~err_ty)) }
        if expected_result == .Val((ok_ty, err_ty)) && is_default_error(err_ty) && self.failure_union_probing() {
            carrier :: Type.Result(~ok_ty, ~err_ty)
            self.probe_failure_value(&inner)
            return Val(^carrier)
        }
        general_target :: if expected_result == { .Val((_, err_ty)) -> is_default_error(err_ty) || err_ty.union_contains(Type.Named(Syntax.TYPE_ERR)); else -> false }
        message_literal :: if inner.without_parens() == { .Str -> true; else -> false }
        payload_expected := Type?{None}
        if expected_result == .Val((_, err_ty)) { payload_expected = Val(if is_default_error(err_ty) || (general_target && message_literal) { Type.String } else { ~err_ty }) }
        payload := if payload_expected == .Val(expected) { self.infer_with_expected(&inner, expected) ?? return None } else { self.infer_owning_value(&inner) ?? return None }
        if expected_result == .Val((ok_ty, err_ty)) {
            if general_target && payload == Type.String {
                message :: ^inner
                inner = Expr.Absent(span)
                call :: Call{name: Syntax.LIT_ERR, name_span: span, type_args: [Type]{}, args: [CallArg]{CallArg{convention: AccessConvention.Read, span: span, expr: ^message, flags: ast_empty_call_arg_flags(), label: None, spread: false}}, resolved_ret: None, range_checked: false, widen_approx: false}
                inner = self.default_err_value(^call, false)
                payload = Type.Named(Syntax.TYPE_ERR)
            }
            ok_payload :: payload == err_ty || (if err_ty == { .Union(members) -> members.any(|m| m == payload); else -> false })
            if !ok_payload {
                self.diags.push(Diagnostic.error("E0108", "this `{Syntax.LIT_ERR}` holds {payload.show()}, but {err_ty.show()} was expected", "the failure value must match the result's error type", type_fix_hint(err_ty, payload), Val(span)))
            }
            return Val(Type.Result(^ok_ty, ^err_ty))
        }
        self.diags.push(Diagnostic.error("E0404", "`{Syntax.LIT_ERR}(...)` only fits where a fallible result is expected", "`{Syntax.LIT_ERR}` builds the failure side of a `T !E` result", "use it in a `T !E` return type, a `T !E` binding annotation, or a call that expects one", Val(span)))
        None
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:232
    fn resolve_failure_function_in_module(self, module_idx: Int, name: String) -> (Int, String, FuncSig)? Never! {
        modules :: self.modules ?? return None
        index := module_idx
        current := ~name
        visited := [(Int, String):Bool]{}
        // GATE #4499: exact tuple-key hashing/equality.
        loop {
            key :: (index, ~current)
            if visited.has_key(key) -> return None
            visited[^key] = true
            module :: modules.get(index) ?? return None
            if module.reexports.get(current) == .Val((real_name, real_module)) {
                current = ~real_name
                index = real_module
                continue
            }
            semantic_name := ~current
            if current.split_once('.') == .Val((inline_module, item)) && module.code_modules.get(inline_module) == .Val(canonical) { semantic_name = member_name(canonical, item) }
            signature :: module.funcs.get(semantic_name) ?? return None
            return Val((index, ^semantic_name, ~signature))
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:263
    fn resolve_failure_function(self, name: String) -> (Int, String, FuncSig)? Never! {
        if self.funcs.get(name) == .Val(signature) -> return Val((self.module_idx, ~name, ~signature))
        if self.inline_module == .Val(module) && self.inline_unqualified.get((module, name)) == .Val(mangled) && self.funcs.get(mangled) == .Val(signature) -> return Val((self.module_idx, ~mangled, ~signature))
        if self.unqualified.get(name) == .Val(mangled) && self.funcs.get(mangled) == .Val(signature) -> return Val((self.module_idx, ~mangled, ~signature))
        if self.inline_module == .Val(module) && self.inline_unqualified_file.get((module, name)) == .Val((function, module_idx)) {
            if self.resolve_failure_function_in_module(module_idx, function) == .Val(target) -> return Val(^target)
        }
        if self.unqualified_file.get(name) == .Val((function, module_idx)) {
            if self.resolve_failure_function_in_module(module_idx, function) == .Val(target) -> return Val(^target)
        }
        if self.resolve_import_call_path(name) == .Val((_, module_idx, function)) {
            if self.resolve_failure_function_in_module(module_idx, function) == .Val(target) -> return Val(^target)
        }
        (alias, item) :: name.split_once('.') ?? return None
        if self.code_modules.get(alias) == .Val(canonical) {
            mangled :: member_name(canonical, item)
            if self.funcs.get(mangled) == .Val(signature) -> return Val((self.module_idx, ^mangled, ~signature))
        }
        if self.inline_reexport_inline.get((alias, item)) == .Val((_, mangled)) && self.funcs.get(mangled) == .Val(signature) -> return Val((self.module_idx, ~mangled, ~signature))
        if self.inline_reexport_file.get((alias, item)) == .Val((function, module_idx)) -> return self.resolve_failure_function_in_module(module_idx, function)
        None
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:326
    fn definition_location(self, module_idx: Int, span: Span) -> String? Never! {
        modules :: self.modules ?? return None
        module :: modules.get(module_idx) ?? return None
        if module.module_path.is_empty() || module.source.is_empty() -> return None
        (line, col) :: span_line_col(module.source, span.start)
        Val("{module.module_path}:{line}:{col}")
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:335
    fn definition_span_text(self, owner: Int, name: String) -> String Never! {
        declaration :: self.name_ledger.declaration(owner, name) ?? return "Core or generated callable (no user source location)"
        self.definition_location(declaration.module, declaration.span) ?? "Core or generated callable (no user source location)"
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:343
    fn definition_fallback_text(self) -> String Never! { "Core or generated callable (no user source location)" }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:347
    fn failure_call_provenance(self, inner: Expr) -> FailureCallProvenance Never! {
        if inner == {
            .Call(call) -> {
                definition := self.definition_span_text(self.module_idx, call.name)
                contract := "inferred failure contract"
                if self.resolve_failure_function(call.name) == .Val((owner, name, signature)) {
                    definition = self.definition_span_text(owner, name)
                    contract = signature.failure_contract().source()
                } else if call.resolved_ret == .Val(return_type) { contract = FailureContract.from_return_type(Val(return_type)).source() }
                FailureCallProvenance{callee: ~call.name, definition: ^definition, contract: ^contract}
            }
            .MethodCall -> {
                contract := "inferred failure contract"
                definition := self.definition_fallback_text()
                if inner.recv_type == .Val(type_name) && self.resolve_method_sig(type_name, inner.method) == .Val((owner, signature)) {
                    contract = signature.failure_contract().source()
                    (_, leaf) :: self.struct_type_name_parts(type_name)
                    if self.name_ledger.declaration(owner, "{leaf}.{inner.method}") == .Val(declaration) { definition = self.definition_location(declaration.module, declaration.span) ?? self.definition_fallback_text() }
                }
                FailureCallProvenance{callee: "{inner.method}()", definition: ^definition, contract: ^contract}
            }
            else -> FailureCallProvenance{callee: "this fallible expression", definition: self.definition_fallback_text(), contract: "inferred failure contract"}
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:415
    fn inferable_failure_callee(self, inner: Expr) -> (Int, String)? Never! {
        target := (Int, String, FuncSig)?{None}
        operand :: inner.without_parens()
        if operand == {
            .Call(call) -> target = self.resolve_failure_function(call.name)
            .MethodCall -> {
                if self.core_module_path_from_receiver(operand.receiver) == .Val((module, _, _)) {
                    source :: CoreModuleExports.core_source_module(module) ?? return None
                    if !CoreModuleExports.core_source_owns_call(module, operand.method, operand.args.len()) -> return None
                    modules :: self.modules ?? return None
                    source_idx := Int?{None}
                    loop index in 0..<modules.len() { if modules[index].module_alias == source.alias { source_idx = Val(index); break } }
                    target = self.resolve_failure_function_in_module(source_idx ?? return None, operand.method)
                } else {
                    if operand.receiver.without_parens() != .Ident(alias, _) -> return None
                    target = self.resolve_failure_function("{alias}.{operand.method}")
                }
            }
            else -> return None
        }
        (module_idx, name, signature) :: target ?? return None
        if !signature.is_extern && signature.failure_contract().is_default() -> Val((module_idx, ^name)) else -> None
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:455
    fn defer_failure_obligation(self: &Self, callee: (Int, String), inner: &Expr, convert: &TryConvert, ok: Type, err: Type) -> Type? Never! {
        (module_idx, name) :: callee
        if self.diags.last_mut() == .Val(diagnostic) {
            detail :: diagnostic.detail ?? ""
            diagnostic.detail = Val("{FAILURE_OBLIGATION_MARK}{module_idx}:{name}\n{detail}")
        }
        convert = TryConvert.Never
        publish_try_call_carrier(&inner, || Type.Result(~ok, ~err))
        Val(~ok)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:483
    fn failure_domain_caller_edit(self, source_name: String) -> TextEdit? Never! {
        if self.current_return_type_span == .Val(span) {
            success := ""
            authored :: self.source.get(span.start..<span.end) // #4303
            if authored == .Val(text) && Self.authored_contract_success(text) == .Val(spelling) { success = spelling } else if self.declared_return_type == .Val(return_type) && return_type.unwrap_result() == .Val((ok, _)) { success = ok.name() }
            new_text :: if success.is_empty() { "{source_name}{Syntax.TYPE_FALLIBLE_MARK}" } else { "{success} {source_name}{Syntax.TYPE_FALLIBLE_MARK}" }
            return Val(TextEdit{span: span, new_text: ^new_text})
        }
        body :: self.source.get(self.current_function_span.start..<self.current_function_span.end) ?? return None // #4303
        body_offset :: body.find('{') ?? body.find(Syntax.OP_UNIFIED_ARROW) ?? return None
        insertion :: self.current_function_span.start + body_offset
        Val(TextEdit{span: Span.new(insertion, insertion), new_text: "{source_name}{Syntax.TYPE_FALLIBLE_MARK} "})
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:524
    fn authored_contract_success(text: String) -> String? Never! {
        trimmed := text.trim_end() // #4303
        body := trimmed.strip_suffix(Syntax.TYPE_FALLIBLE_MARK) ?? return None // #4303
        depth := 0
        loop (index, ch) in body.char_indices().rev() {
            if ch == {
                '>' -> { prefix := body[0..<index] // #4303
                    if !prefix.ends_with('-') { depth += 1 }
                }
                ')' | ']' -> depth += 1
                '(' | '<' | '[' -> depth -= 1
                else -> {
                    if ch.is_whitespace() && depth == 0 { success := body[0..<index].trim() // #4303
                        return Val(success)
                    }
                }
            }
        }
        Val("")
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:542
    fn failure_domain_conversion_edit(self, source_name: String, target_name: String) -> TextEdit? Never! {
        if source_name.is_empty() || target_name.is_empty() -> return None
        loop character in source_name.chars() { if character.is_whitespace() || character == '|' -> return None }
        loop character in target_name.chars() { if character.is_whitespace() || character == '|' -> return None }
        separator :: if self.source.ends_with('\n') { "\n" } else { "\n\n" }
        Val(TextEdit{span: Span.new(self.source.len(), self.source.len()), new_text: "{separator}impl {source_name} -> {target_name} {{\n    // map each {source_name} case into {target_name}\n}}\n"})
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:569
    fn report_failure_domain_mismatch(self: &Self, span: Span, inner: Expr, source: Type, target: Type) Never! {
        provenance :: self.failure_call_provenance(inner)
        callee :: provenance.callee
        definition :: provenance.definition
        contract :: provenance.contract
        caller :: if self.declared_return_type == .Val(return_type) { FailureContract.from_return_type(Val(return_type)).source() } else { "no declared failure contract" }
        source_name :: source.name()
        target_name :: target.name()
        diagnostic := Diagnostic.from_row("E2404", [(String, String)]{("Source", source_name), ("Target", target_name), ("callee", callee), ("definition", definition), ("contract", contract), ("caller", caller)}, Val(span)).with_detail("failure-domain:{callee}|{source_name}|{target_name}\ncallee: {callee}\ndefinition: {definition}\neffective contract: {contract}\ncaller contract: {caller}")
        if self.failure_domain_caller_edit(source_name) == .Val(edit) { diagnostic = diagnostic.with_edit_grade(^edit, FixApplicability.Suggested, FixSafety.NeedsReview) }
        if target_name != Syntax.TYPE_NEVER && self.failure_domain_conversion_edit(source_name, target_name) == .Val(edit) { diagnostic = diagnostic.with_alternative_edit(^edit) }
        self.diags.push(^diagnostic)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:619
    pub fn infer_try(self: &Self, inner: &Expr, span: Span, convert: &TryConvert, note: &Expr?) -> Type? Never! {
        self.infer_try_with_inner_type(&inner, span, &convert, &note, None)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:629
    pub fn infer_try_with_inner_type(self: &Self, inner: &Expr, span: Span, convert: &TryConvert, note: &Expr?, checked_inner_type: Type?) -> Type? Never! {
        implicit_propagation :: if checked_inner_type == { .Val(ty) -> ty.is_fallible(); else -> false }
        if note == .Val(note_expr) {
            saved :: ~self.expected_type
            self.expected_type = Val(Type.String)
            note_ty :: self.infer(&note_expr)
            self.expected_type = ^saved
            if note_ty == .Val(ty) { _ :: self.check_type_assignable(Type.String, ty, note_expr.span()) }
        }
        if inner == .Call(call) && self.registry.distinct_range(call.name).is_some() { call.range_checked = true }
        inner_ty := Type?{None}
        if checked_inner_type == .Val(ty) { inner_ty = Val(~ty) } else {
            self.failure_auto_depth += 1
            inner_ty = self.infer_without_auto_propagation(&inner)
            self.failure_auto_depth -= 1
        }
        ty :: inner_ty ?? return None
        if ty == {
            .Result(ok, err) -> {
                ret :: self.resolve_type(self.ret ?? Type.Int)
                if err == .Named(name) && name == Syntax.TYPE_NEVER {
                    convert = TryConvert.Never
                    publish_try_call_carrier(&inner, || Type.Result(~ok, ~err))
                    return Val(~ok)
                }
                if ret == .Result(_, ret_err) {
                    if is_default_error(ret_err) && self.failure_union_probing() {
                        callee :: if is_default_error(err) { self.inferable_failure_callee(inner) } else { None }
                        if self.failure_union_probe == .Val(probe) {
                            if callee == .Val(edge) { probe.edges.insert(^edge) } else { probe.add_member(err) }
                        }
                        self.task_body_propagates = true
                        publish_try_call_carrier(&inner, || Type.Result(~ok, ~err))
                        return Val(~ok)
                    }
                    if ret_err == .Named(name) && name == "_" -> return Val(~ok)
                    if ret_err == .Named(name) && name == Syntax.TYPE_NEVER {
                        pending_callee :: self.inferable_failure_callee(inner)
                        self.report_failure_domain_mismatch(span, inner, err, ret_err)
                        return self.defer_failure_obligation(pending_callee ?? return None, &inner, &convert, ok, err)
                    }
                    if ret_err == err {
                        self.task_body_propagates = true
                        publish_try_call_carrier(&inner, || Type.Result(~ok, ~err))
                        return Val(~ok)
                    }
                    if is_default_error(ret_err) && err == Type.String {
                        convert = TryConvert.DefaultErr
                        self.task_body_propagates = true
                        publish_try_call_carrier(&inner, || Type.Result(~ok, ~err))
                        return Val(~ok)
                    }
                    if ret_err.union_contains(err) {
                        members :: ret_err.unwrap_union().expect("union_contains implies Union")
                        convert = TryConvert.WidenUnion{enum_name: union_enum_name(members), tag: union_member_tag(err)}
                        self.task_body_propagates = true
                        publish_try_call_carrier(&inner, || Type.Result(~ok, ~err))
                        return Val(~ok)
                    }
                    err_type_name :: err.name()
                    ret_err_name :: ret_err.name()
                    if self.trait_reg.has_error_conv(err_type_name, ret_err_name) {
                        convert = TryConvert.Typed{fn_name: error_conv_fn_name(err_type_name, ret_err_name), source: ~err, target: ~ret_err}
                        self.task_body_propagates = true
                        publish_try_call_carrier(&inner, || Type.Result(~ok, ~err))
                        return Val(~ok)
                    }
                    if is_default_error(ret_err) {
                        err_name :: err.name()
                        if !self.no_prelude && is_core_error_family_type(err_name) {
                            convert = TryConvert.Typed{fn_name: error_conv_fn_name(err_name, Syntax.TYPE_ERR), source: ~err, target: Type.Named(Syntax.TYPE_ERR)}
                            self.task_body_propagates = true
                            publish_try_call_carrier(&inner, || Type.Result(~ok, ~err))
                            return Val(~ok)
                        }
                        (what, why, fix) :: if implicit_propagation {
                            ("this implicit fallible call can't convert `{err_name}` into `{Syntax.TYPE_ERR}` — no declared conversion exists", "ordinary fallible calls propagate automatically; `{err_name}` can reach `{Syntax.TYPE_ERR}` only through `impl {err_name} -> {Syntax.TYPE_ERR}`", "handle this call locally with `??`, add `impl {err_name} -> {Syntax.TYPE_ERR} {{ … }}`, or change the return type")
                        } else {
                            ("`?` can't convert `{err_name}` into `{Syntax.TYPE_ERR}` — no declared conversion exists", "`?` uses the declared conversion rail; `{err_name}` can reach `{Syntax.TYPE_ERR}` only through `impl {err_name} -> {Syntax.TYPE_ERR}`", "add `impl {err_name} -> {Syntax.TYPE_ERR} {{ … }}` before this function, or change the return type")
                        }
                        self.diags.push(Diagnostic.error("E2402", ^what, ^why, ^fix, Val(span)))
                        return None
                    }
                    pending_callee :: self.inferable_failure_callee(inner)
                    self.report_failure_domain_mismatch(span, inner, err, ret_err)
                    return self.defer_failure_obligation(pending_callee ?? return None, &inner, &convert, ok, err)
                }
                (what, why, fix) :: if implicit_propagation {
                    ("this fallible call only works inside a function that returns a fallible result", "ordinary fallible calls propagate their failure automatically to the caller", "declare `{err.name()}` in the return type before `->`, or handle the result with `{Syntax.OP_FALLBACK}`")
                } else {
                    ("`{Syntax.OP_TRY_SUFFIX}` only works inside a function that returns a fallible result", "propagation early-returns the failure to the caller", "declare the failure in the return type — `{err.name()}` before `->` — or handle the result with `{Syntax.OP_FALLBACK}`")
                }
                pending_callee :: self.inferable_failure_callee(inner)
