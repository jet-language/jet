    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:966
    pub fn infer_value_loop_fallback(self: &Self, expr: &Expr) -> Type? Never! {
        span :: expr.span()
        original :: ^expr
        expr = Expr.Absent(span)
        if original != .OrFallback -> panic("value-loop fallback dispatch only accepts OrFallback")
        value := ^original.value
        fallback := ^original.fallback
        mark_value_loop_route_attached(&value)
        checked :: self.infer(&value) ?? { expr = ^value; return None }
        resolved :: self.resolve_type(^checked).erased_carrier()
        value_ty :: if resolved == { .Result(ok, _) | .Option(ok) -> ok.erased_carrier(); else -> ^resolved }
        self.reject_borrowed_param_subplace(&value, Val(value_ty), "supply an owned exhaustion-route payload")
        compute_failure_fallback :: value_ty.is_compute_tensor_family() && self.is_core_compute_call(value)
        label :: value_loop_route_label(&value) ?? { expr = ^value; return Val(^value_ty) }
        if fallback == {
            .Value(fallback_expr) -> {
                fallback_span :: fallback_expr.span()
                if self.infer_with_expected(&fallback_expr, value_ty) == .Val(fallback_ty) {
                    widened :: self.widen_numeric_argument(&fallback_expr, ^fallback_ty, value_ty, AccessConvention.Read)
                    reported :: self.check_type_assignable(value_ty, widened, fallback_span)
                    if widened != value_ty && !reported {
                        self.diags.push(Diagnostic.error("E0405", "the fallback is {widened.show()}, but the loop value is {value_ty.show()}", "both sides of `{Syntax.OP_FALLBACK}` must be the same type", type_fix_hint(value_ty, widened), Val(fallback_span)))
                    }
                }
                _ :: attach_value_loop_route(&value, Stmt.BreakLabelValue(^label, span, ^fallback_expr, fallback_span))
            }
            .Return(ret_expr, ret_span) -> {
                ret :: ~self.ret
                if (ret, ret_expr) == {
                    (.Val(ret_ty), .Val(e)) -> {
                        saved :: ~self.expected_type
                        self.expected_type = Val(~ret_ty)
                        expr_ty :: self.infer(&e)
                        self.expected_type = ^saved
                        if expr_ty == .Val(ty) {
                            widened :: self.widen_numeric_return(&e, ty, ret_ty) ?? ty
                            lifted :: self.lift_optional_slot(ret_ty, widened, &e) ?? widened
                            _ :: self.check_type_assignable(ret_ty, lifted, e.span())
                        }
                    }
                    (.Val(ret_ty), .None) -> self.diags.push(Diagnostic.error("E0405", "`{Syntax.OP_FALLBACK} return` here needs a value", "a bare `return` needs a value here because the function returns {ret_ty.show()}", "give a fallback value: `{Syntax.OP_FALLBACK} return <value>`", Val(ret_span)))
                    (.None, .Val(e)) -> self.diags.push(Diagnostic.error("E0405", "`{Syntax.OP_FALLBACK} return` can't return a value here", "this function returns nothing, so `return` can't carry a value", "drop the value, or add a return type before `->`", Val(e.span())))
                    (.None, .None) -> {}
                }
                _ :: attach_value_loop_route(&value, Stmt.Return(^ret_expr, span))
            }
            .Block -> {
                mark_value_loop_route_unattached(&value)
                self.diags.push(Diagnostic.error("E0405", "a finite value loop cannot use a multi-step `??` fallback", "the loop's exhaustion route carries one value or control action, not a fallback block", "use one fallback value, or move the loop into a named block and handle the report there", Val(fallback.span)))
            }
            .Panic -> {
                call := Call{name: Syntax.BUILTIN_PANIC, name_span: fallback.name_span, type_args: [Type]{}, args: ^fallback.args, resolved_ret: None, range_checked: false, widen_approx: false}
                saved :: self.autodiff_safe_panic_context
                self.autodiff_safe_panic_context = compute_failure_fallback
                self.check_panic_call(&call)
                self.autodiff_safe_panic_context = saved
                _ :: attach_value_loop_route(&value, Stmt.Expr(Expr.Call(^call)))
            }
            .Break(route_span) | .Continue(route_span) -> {
                route :: if fallback == { .Break -> "break"; .Continue -> "next"; else -> panic("matched immediate loop-control fallback") }
                mark_value_loop_route_unattached(&value)
                self.diags.push(Diagnostic.error("E0078", "this finite value loop cannot use `{Syntax.OP_FALLBACK} {route}` after its closing brace", "the route would control the loop that just closed; use a labeled loop to name the target", "write a labeled search such as `found :: loop {{ ... break(found, value) }}`", Val(route_span)))
            }
            .BreakLabel(name, route_span) -> {
                if self.loop_depth == 0 {
                    mark_value_loop_route_unattached(&value)
                    self.diags.push(loop_control_outside(Syntax.KW_BREAK, route_span))
                } else if !self.loop_labels.any(|label| label == name) {
                    mark_value_loop_route_unattached(&value)
                    self.diags.push(undefined_loop_label(name, self.loop_labels, route_span))
                } else {
                    self.check_break_without_value(Val((name, route_span)), route_span)
                    _ :: attach_value_loop_route(&value, Stmt.BreakLabel(^name, route_span))
                }
            }
            .ContinueLabel(name, route_span) -> {
                if self.loop_depth == 0 {
                    mark_value_loop_route_unattached(&value)
                    self.diags.push(loop_control_outside(Syntax.KW_NEXT, route_span))
                } else if !self.loop_labels.any(|label| label == name) {
                    mark_value_loop_route_unattached(&value)
                    self.diags.push(undefined_loop_label(name, self.loop_labels, route_span))
                } else { _ :: attach_value_loop_route(&value, Stmt.ContinueLabel(^name, route_span)) }
            }
        }
        expr = ^value
        Val(^value_ty)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:1178
    fn is_core_compute_call(self, expr: Expr) -> Bool Never! {
        operand :: expr.without_parens()
        if operand != .MethodCall -> return false
        if operand.receiver.without_parens() == .Ident(alias, _) -> self.core_imports.get(alias) == Val("core.compute") else -> false
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:1191
    fn return_route_type(self) -> Type? Never! {
        ret :: self.ret ?? return None
        if ret == .Result(ok, _) {
            if (if ok == { .Named(name) -> name == Syntax.INTERNAL_UNIT_TYPE; else -> false }) || self.is_unit_type(ok) -> return None
        }
        if (if ret == { .Named(name) -> name == Syntax.INTERNAL_UNIT_TYPE; else -> false }) || self.is_unit_type(ret) -> return None
        Val(~ret)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:1209
    pub fn infer_or_fallback(self: &Self, value: &Expr, fallback: &OrFallback, span: Span, is_option: &Bool) -> Type? Never! {
        suppress_auto :: if value.without_parens() == { .Call | .MethodCall | .CallValue -> true; else -> false }
        saved_failure_carrier :: ~self.failure_carrier
        saved_task_body_propagates :: self.task_body_propagates
        saved_ret :: ~self.ret
        val_ty := Type?{None}
        if suppress_auto {
            self.failure_auto_depth += 1
            val_ty = self.infer_without_auto_propagation(&value)
            self.failure_auto_depth -= 1
        } else { val_ty = self.infer(&value) }
        self.failure_carrier = ^saved_failure_carrier
        self.task_body_propagates = saved_task_body_propagates
        self.ret = ^saved_ret
        if val_ty.is_none() {
            callback_error := Type?{None}
            operand :: value.without_parens()
            if operand == .MethodCall {
                receiver_ty := Type?{None}
                if operand.receiver.without_parens() == .Ident(name, _) {
                    if self.lookup(name) == .Val(info) { receiver_ty = Val(~info.ty) }
                } else {
                    receiver := ~operand.receiver
                    receiver_ty = self.infer_without_auto_propagation(&receiver)
                }
                if receiver_ty == .Val(recv_ty) && builtin_method_return(recv_ty, operand.method, operand.args.len(), false) == Val(None) {
                    if operand.args.first() == .Val(arg) && arg.expr.without_parens() == .Lambda(lambda) && lambda.meta.fallible_carrier == .Val(.Result(_, err)) { callback_error = Val(~err) }
                }
            }
            if callback_error == .Val(err) { val_ty = Val(Type.Result(Type.Named(Syntax.INTERNAL_UNIT_TYPE), ^err)) }
        }
        ty :: val_ty ?? return None
        is_option = if ty == { .Option -> true; else -> false }
        payload := if ty == {
            .Result(ok, _) -> if ok == { .Option(inner) -> ~inner; else -> ~ok }
            .Option(inner) -> ~inner
            else -> {
                self.diags.push(Diagnostic.error("E0405", "`{Syntax.OP_FALLBACK}` only works on a fallible value, not {ty.show()}", "the left side must be a `Result` or optional value", "call something that can fail, then write `... {Syntax.OP_FALLBACK} fallback`", Val(span)))
                return None
