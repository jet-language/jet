                }
                Val(~payload)
            }
            .Block -> {
                self.check_block(&fallback.body, false)
                if fallback.value == .Val(tail) {
                    saved :: ~self.expected_type
                    self.expected_type = if !success_never { Val(~payload) } else { None }
                    value_ty :: self.infer(&tail)
                    self.expected_type = ^saved
