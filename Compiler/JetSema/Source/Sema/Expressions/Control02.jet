    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:1600
    fn join_fallback_path(self: &Self, success_path: FlowFacts, fallback: OrFallback) Never! {
        miss_path := ^self.flow
        self.flow = FlowFacts.default()
        if fallback != .Value && fallback != .Block { miss_path.reachable = false }
        self.flow = FlowFacts.merge_paths(success_path, [FlowFacts]{~success_path, ^miss_path})
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:1618
    pub fn check_diverging_fallback(self: &Self, fallback: &OrFallback, subject_ty: Type, span: Span) Never! {
        saved_fallback_has_err :: self.fallback_has_err
        saved_fallback_is_shape_miss :: self.fallback_is_shape_miss
        self.fallback_is_shape_miss = if subject_ty == { .Option | .Result -> false; else -> true }
        has_err :: if subject_ty == { .Result -> true; else -> false }
        self.fallback_has_err = Val(has_err)
        if has_err {
            if subject_ty != .Result(_, err) -> panic("result fallback marker changed shape")
            self.push_scope()
            self.declare_in_scope(Syntax.AMBIENT_ERR, LocalInfo{def_span: span, binding_sigil_span: None, ty: ~err, mutable: false, param_conv: None, decl_loop_depth: self.loop_depth, interrupt_sendable: false, reactive_local: false, reactive_shared: false, single_use_span: None, invalid: false})
        }
        success_path :: ~self.flow
        if fallback == {
            .Value(value) -> {
                _ :: self.infer(&value)
                self.diags.push(Diagnostic.error("E0405", "`{Syntax.OP_FALLBACK}` must diverge after a refutable binding", "a failed pattern match cannot continue without defining the captures", "use `return`, `panic(...)`, `break`, or `next` as the fallback", Val(value.span())))
            }
            .Block -> {
                diverges :: fallback.value.is_none() && fallback_block_diverges(fallback.body)
                self.check_block(&fallback.body, false)
                if fallback.value == .Val(value) { _ :: self.infer(&value) }
                if !diverges { self.diags.push(Diagnostic.error("E0405", "`{Syntax.OP_FALLBACK}` fallback blocks cannot continue after a refutable binding", "a refutable binding needs one direct diverging miss route", "end the block with `return`, `panic(...)`, `break`, or `next`", Val(fallback.span))) }
            }
            .Return(ret_expr, ret_span) -> {
                ret :: self.return_route_type()
                if (ret, ret_expr) == {
                    (.Val(ret_ty), .Val(expr)) -> {
                        saved :: ~self.expected_type
                        self.expected_type = Val(~ret_ty)
                        expr_ty :: self.infer(&expr)
                        self.expected_type = ^saved
                        if expr_ty == .Val(checked) {
                            widened :: self.widen_numeric_return(&expr, checked, ret_ty) ?? checked
                            lifted :: self.lift_optional_slot(ret_ty, widened, &expr) ?? widened
                            _ :: self.check_type_assignable(ret_ty, lifted, expr.span())
                        }
                    }
                    (.Val(ret_ty), .None) -> self.diags.push(Diagnostic.error("E0405", "`{Syntax.OP_FALLBACK} return` here needs a value", "this function returns {ret_ty.show()}, so its return route needs a value", "write `{Syntax.OP_FALLBACK} return <value>`", Val(ret_span)))
                    (.None, .Val(expr)) -> self.diags.push(Diagnostic.error("E0405", "`{Syntax.OP_FALLBACK} return` cannot return a value here", "this function returns nothing", "drop the value from the return route", Val(expr.span())))
                    (.None, .None) -> {}
                }
            }
            .Panic -> {
                call := Call{name: Syntax.BUILTIN_PANIC, name_span: fallback.name_span, type_args: [Type]{}, args: ^fallback.args, resolved_ret: None, range_checked: false, widen_approx: false}
                fallback.args = [CallArg]{}
                self.check_panic_call(&call)
                fallback.args = ^call.args
            }
            .Break(route_span) -> self.check_break_without_value(None, route_span)
            .Continue(route_span) -> { if self.loop_depth == 0 { self.diags.push(loop_control_outside(Syntax.KW_NEXT, route_span)) } }
            .BreakLabel(name, route_span) -> {
                if self.loop_depth == 0 { self.diags.push(loop_control_outside(Syntax.KW_BREAK, route_span)) } else if !self.loop_labels.any(|label| label == name) { self.diags.push(undefined_loop_label(name, self.loop_labels, route_span)) } else { self.check_break_without_value(Val((name, route_span)), route_span) }
            }
            .ContinueLabel(name, route_span) -> {
                if self.loop_depth == 0 { self.diags.push(loop_control_outside(Syntax.KW_NEXT, route_span)) } else if !self.loop_labels.any(|label| label == name) { self.diags.push(undefined_loop_label(name, self.loop_labels, route_span)) }
            }
        }
        self.join_fallback_path(success_path, fallback)
        if has_err { self.pop_scope() }
        self.fallback_has_err = saved_fallback_has_err
        self.fallback_is_shape_miss = saved_fallback_is_shape_miss
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:1790
    pub fn infer_fallible_stmt(self: &Self, expr: &Expr) -> Type? Never! {
        self.normalize_imported_core_expr(&expr)
        self.normalize_prelude_expr(&expr)
        expression_diverges :: self.expr_diverges(expr)
        if expr == .Call(call) {
            self.clear_uninit_mut_args(call.args)
            checked :: self.check_call(&call, false)
            result :: if checked == {
                .Val(.Val(ty)) -> if ty.is_fallible() { self.auto_propagate_call(&expr, Val(^ty)) } else { Val(^ty) }
                .Val(.None) -> Val(Type.Named(Syntax.INTERNAL_UNIT_TYPE))
                .None -> None
            }
            if expression_diverges { self.flow.reachable = false }
            return result
        }
        self.infer(&expr)
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:1816
pub fn value_loop_requires_route(expr: Expr) -> Bool Never! {
    if expr != .CallValue || !expr.args.is_empty() -> return false
    if expr.callee == .Lambda(lam) -> lam.meta.result_loop && lam.meta.requires_exhaustion_route && !lam.meta.exhaustion_route_attached else -> false
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:1831
fn fallback_block_diverges(body: [Stmt]) -> Bool Never! { block_definitely_exits(body) }

// Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:1835
fn mark_value_loop_route_attached(expr: &Expr) Never! {
    if expr != .CallValue || !expr.args.is_empty() -> return
    if expr.callee == .Lambda(lam) { lam.meta.exhaustion_route_attached = true }
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:1847
fn mark_value_loop_route_unattached(expr: &Expr) Never! {
    if expr != .CallValue || !expr.args.is_empty() -> return
    if expr.callee == .Lambda(lam) { lam.meta.exhaustion_route_attached = false }
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:1859
fn value_loop_route_label(expr: &Expr) -> String? Never! {
    if expr != .CallValue || !expr.args.is_empty() -> return None
    if expr.callee != .Lambda(lam) -> return None
    if lam.body != .Block(stmts) -> return None
    if stmts.first() != .Val(.Loop) -> return None
    first :: stmts.first().expect("first loop exists")
    if first.label == .Val((label, _)) -> Val(~label) else -> None
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/fallible.rs:1882
fn attach_value_loop_route(expr: &Expr, route: Stmt) -> Bool Never! {
    if expr != .CallValue || !expr.args.is_empty() -> return false
    if expr.callee != .Lambda(lam) -> return false
    if lam.body != .Block(stmts) -> return false
    if stmts.first_mut() != .Val(first) || first != .Loop -> return false
    first.body.push(^route)
    true
}
