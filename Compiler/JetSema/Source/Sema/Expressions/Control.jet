// Checked fallible control-flow and value-producing control expressions.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    BinOp,
    BindName,
    Call,
    CallArg,
    Diagnostic,
    Expr,
    Func,
    Lambda,
    LambdaBody,
    NamedSpan,
    NodeKind,
    OrFallback,
    PatSlot,
    Pattern,
    PlaceAccess,
    Span,
    Stmt,
    Symbol,
    SymbolID,
    SymbolKind,
    TBinaryOp,
    TFailureCarrier,
    TLetTy,
    TLocal,
    TPanicLoc,
    TPanicLocal,
    TPatternBindingFact,
    TPatternPosition,
    TTryConvert,
    TryConvert,
    Type,
    ast_empty_call_arg_flags,
    diagnostic_with_detail,
    expr_span,
    failure_contract_of_function,
    symbol_id,
    checked_symbol_local,
    type_identity_equal,
    type_name,
]

// The source location of a panic at `span` (Rust capture_panic_loc), naming the
// function being checked: `scopes.location_function` on a compiler thread,
// which never writes the shared environment, else the environment's
// `function_name`. `column` is the 1-based byte column of the span's start
// and `caret` the span's byte length; the backend, which holds the source
// text, supplies the report's source line and character column.
fn sema_expression_panic_location(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, span: Span) -> TPanicLoc Never! {
    file := environment.source_file
    line := 0
    column := 0
    loop segment in environment.source_segments {
        if span.start >= segment.generated.start && span.start < segment.generated.end {
            file = segment.source_file
            local :: span.start - segment.generated.start
            if segment.line_starts.len() == 0 {
                line = 1
                column = local + 1
                break
            }
            low := 0
            high := segment.line_starts.len()
            loop low < high {
                middle :: (low + high) /% 2
                if segment.line_starts[middle] <= local -> low = middle + 1 else -> high = middle
            }
            line_index :: if low > 0 -> low - 1 else -> 0
            line = line_index + 1
            column = local - segment.line_starts[line_index] + 1
        }
    }
    function :: scopes.location_function ?? environment.function_name
    TPanicLoc{file: file, source_line: "", line: line, column: column, caret: span.end - span.start, function: function, locals: [TPanicLocal]{}}
}

// The `assert`/`assert_eq` report's safe locals (Rust safe_locals_snapshot):
// the visible Int, Float and Bool locals and parameters of the body being
// checked, sorted by name. A lambda body's locals end at its own frame;
// compiler-generated `__` names are not the program's locals.
fn sema_expression_panic_locals(scopes: SemaScopeTable, span: Span) -> [TPanicLocal] Never! {
    chain := [Int:Bool]{}
    frame := scopes.current
    loop frame > 0 && scopes.frames[frame].parent >= 0 {
        chain[frame] = true
        if scopes.frames[frame].owner.starts_with("lambda@") -> break
        frame = scopes.frames[frame].parent
    }
    seen := [String:Bool]{}
    names := [String]{}
    rows := [String:Int]{}
    index := scopes.bindings.len() - 1
    loop index >= 0 {
        row :: index
        index -= 1
        binding :: scopes.bindings[row]
        if chain.get(binding.frame) == None || binding.symbol.span.start > span.start -> next
        name :: binding.symbol.name
        if name == "_" || name.starts_with("__") || seen.get(name) != None -> next
        seen[name] = true
        if binding.symbol.kind != SymbolKind.Local && binding.symbol.kind != SymbolKind.Parameter -> next
        ty :: binding.symbol.ty ?? { next }
        if ty != Type.Int && ty != Type.Float && ty != Type.Bool -> next
        &names.push(name)
        rows[name] = row
    }
    &names.sort()
    locals := [TPanicLocal]{}
    loop name in names {
        row :: rows.get(name) ?? { next }
        symbol :: scopes.bindings[row].symbol
        &locals.push(TPanicLocal{display_name: name, local: checked_symbol_local(name, symbol.span, symbol.id)})
    }
    locals
}

fn sema_expression_failure_carrier(ty: Type) -> TFailureCarrier Never! {
    if ty == {
        // copy: `ok` and `err` are payloads of read parameter `ty`, which keeps the originals; the new TFailureCarrier.Result's fields own `ok` and `err`
        .Result(ok, err) -> TFailureCarrier.Result{success: ok.copy(), error: err.copy()}
        // copy: `value` is a payload of read parameter `ty`, which keeps the original; field `value` of the new TFailureCarrier.Optional owns this one
        .Option(value) -> TFailureCarrier.Optional{value: value.copy()}
        .Named(name) -> if name == "Never" -> TFailureCarrier.Diverges{value: ty} else -> TFailureCarrier.Infallible
        else -> TFailureCarrier.Infallible
    }
}

fn sema_expression_present(value: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    expected_inner := Type?{None}
    result_ty := Type?{None}
    if expected == .Val(expected_ty) {
        normalized :: sema_expr_unwrap_tag(expected_ty)
        if normalized == {
            .Option(inner) -> {
                expected_inner = Val(inner)
                result_ty = Val(normalized)
            }
            else -> {
                &diagnostics.push(sema_type_mismatch(normalized, Type.Option{inner: Type.Named{name: "Unit"}}, span))
                return None
            }
        }
    }
    payload :: sema_check_expression(value, expected_inner, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    // The payload fills the declared slot through the registration graph: a
    // declared `module::Name` and a literal's written `Name` are one type. A
    // refusal is reported here, never dropped silently.
    if expected_inner == .Val(inner_ty) {
        fits :: sema_expr_expected_assignable(inner_ty, payload.ty, environment, program) ?? return None
        if !fits {
            &diagnostics.push(sema_type_mismatch(sema_expr_expected_type(inner_ty, environment, program), sema_expr_expected_type(payload.ty, environment, program), expr_span(value)))
            return None
        }
    }
    sema_expr_expected_owned(sema_tir_node(result_ty ?? Type.Option{inner: payload.ty}, TExprKind.Present{value: payload}, span), expected, environment, program, &diagnostics)
}

fn sema_expression_absent(span: Span, expected: Type?, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    required :: expected ?? {
        &diagnostics.push(sema_error("E0308", span, "bare `None` needs a known optional type here", "`None` only fits where a `T?` is expected (S32)", "write the optional type on the value, for example `Int?{{None}}`, or use `None` where a `T?` is already expected"))
        return None
    }
    normalized :: sema_expr_unwrap_tag(required)
    if normalized == {
        .Option(_) -> Val(sema_node(&context, normalized, NodeKind.Absent, span))
        else -> {
            &diagnostics.push(sema_error("E0308", span, "bare `None` needs a known optional type here", "`None` only fits where a `T?` is expected (S32)", "write the optional type on the value, for example `Int?{{None}}`, or use `None` where a `T?` is already expected"))
            None
        }
    }
}

// A bare `None` value-if arm. With `nested`, also a nested value-if (the rest
// of a match or decision table) whose every arm is a bare `None`; the parser's
// `NoElse` tail of an else-less table adds no arm.
fn sema_expression_bare_absent_arm(value: Expr, nested: Bool) -> Bool Never! {
    if sema_expression_absent_none(value) -> return true
    if value == {
        .Paren(inner, _, _) -> sema_expression_bare_absent_arm(inner, nested)
        .If(_, _, then_value, _, else_value, _, _) -> nested && sema_expression_bare_absent_arm(then_value, true) && (else_value == .NoElse(_, _) || sema_expression_bare_absent_arm(else_value, true))
        else -> false
    }
}

// Whether the value slot already expects a `T?`.
fn sema_expression_expects_optional(expected: Type?) -> Bool Never! {
    required :: expected ?? return false
    if sema_expr_unwrap_tag(required) == {
        .Option(_) -> true
        else -> false
    }
}

// The optional type a bare `None` arm adopts from its checked sibling arm.
fn sema_expression_absent_sibling(sibling: TExpr?) -> Type? Never! {
    checked :: sibling ?? return None
    if sema_expr_unwrap_tag(checked.ty) == {
        .Option(_) -> Val(checked.ty)
        else -> None
    }
}

// Result constructors stay calls in the parsed AST so a user declaration
// can shadow them. Classify only the unshadowed contextual spellings, as
// Rust `normalize_contextual_expr` does before checking their payloads.
// The flag selects success (`Ok`) or failure (`Err`) without building a
// throwaway AST node when a return-carrier predicate asks the same question.
fn sema_expression_contextual_result_call(call: Call, expected: Type?, scopes: SemaScopeTable) -> Bool? Never! {
    if call.name != "Ok" && call.name != "Err" -> return None
    if sema_scope_resolve_index(scopes, call.name) == .Val(index) {
        if !sema_scope_binding_is_compiler_builtin(scopes.bindings[index], "Err") -> return None
    }
    result_expected :: sema_expr_unwrap_tag(expected ?? Type.Named{name: "Never"})
    if call.name == "Ok" && call.args.len() == 0 {
        if result_expected == .Result(ok, _) && ok == (Type.Named{name: "Unit"}) {
            return Val(true)
        }
        return None
    }
    if call.args.len() != 1 || call.args[0].label != None -> return None
    // Outside a Result slot, `Err(...)` builds the Prelude error value
    // through the existing default-error constructor rather than a carrier.
    if call.name == "Err" && !(result_expected == .Result(_, _)) -> return None
    Val(call.name == "Ok")
}

// Classify before expression checking turns an uncontextual Err call into
// the default-error record. A user declaration still owns its spelling.
fn sema_expression_uncontextual_err_arm(value: Expr, scopes: SemaScopeTable) -> Bool Never! {
    if value == {
        .Paren(inner, _, _) -> sema_expression_uncontextual_err_arm(inner, scopes)
        .Err(_, _, _) -> true
        .Call(call, _) -> {
            carrier :: Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "Err"}}
            sema_expression_contextual_result_call(call, Val(carrier), scopes) == (Val(false))
        }
        else -> false
    }
}

// Only a fallible sibling supplies the missing carrier. Plain success
// values do not establish a failure domain.
fn sema_expression_err_sibling(sibling: TExpr?) -> Type? Never! {
    checked :: sibling ?? return None
    if sema_expr_unwrap_tag(checked.ty) == {
        .Result(_, _) -> Val(checked.ty)
        else -> None
    }
}

fn sema_expression_default_err_struct(value: Expr) -> Bool Never! {
    if value == {
        .Paren(inner, _, _) -> sema_expression_default_err_struct(inner)
        .StructLit(type_name, _, _, _, _, _, _, _) -> type_name == "Err"
        else -> false
    }
}

// Rust `infer_err`: the payload of `Err(x)` toward the default `Err` domain is
// inferred first, and only a `String` builds the default error from a message;
// a value that already is an `Err` (`?? return Err(err)`) is the failure itself.
fn sema_expression_err_payload_is_err(value: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> Bool {
    probe_diagnostics := [Diagnostic]{}
    probed :: sema_probe_expression(value, None, environment, program, &scopes, &state, &tail_store, &context, &probe_diagnostics) ?? return false
    sema_expr_unwrap_tag(probed.ty) == Type.Named{name: "Err"}
}

fn sema_expression_default_err_call(value: Expr, span: Span, expected: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    argument :: CallArg{convention: AccessConvention.Read, expr: value, span: expr_span(value), flags: ast_empty_call_arg_flags(), label: None, spread: false}
    call :: Call{name: "Err", name_span: span, type_args: [Type]{}, args: [CallArg]{argument}}
    sema_call_check_default_err(call, Val(expected), environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
}

// The parser stores `Ok(^x.f)`'s move mark on the CallArg. A marked field
// read keeps it as the exact-place move an ordinary consuming argument gets
// (Calls/Checking.jet), so the payload moves out of its owner instead of
// materializing a copy (the Rust reference's contextual Ok/Err normalization).
// A field of a borrowed parameter has no storage to give up and keeps its copy.
fn sema_expression_result_call_takes_field(call: Call, state: &SemaOwnershipState, scopes: SemaScopeTable) -> Bool {
    if call.args.len() != 1 || call.args[0].convention != AccessConvention.Move || !(call.args[0].expr == .Field(_, _, _, _)) -> return false
    root :: sema_ownership_binding_for_expr(&state, call.args[0].expr, scopes) ?? return true
    !sema_ownership_binding_is_borrowed_param(root)
}

fn sema_expression_result_payload(value: Expr, success: Bool, take_field: Bool, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    expected_ok := Type?{None}
    expected_err := Type?{None}
    if expected == {
        .Val(expected_ty) -> {
            normalized :: sema_expr_unwrap_tag(expected_ty)
            if normalized == {
                .Result(ok, err) -> {
                    expected_ok = Val(ok)
                    expected_err = Val(err)
                }
                else -> {
                    if {
                        success -> {
                            &diagnostics.push(sema_error("E0404", span, "`Ok(...)` only fits where a fallible result is expected", "`Ok` builds the success side of a `T ! E` result", "use it in a `T ! E` return type, a `T ! E` binding annotation, or a call that expects one"))
                        }
                        else -> {
                            &diagnostics.push(sema_error("E0404", span, "`Err(...)` only fits where a fallible result is expected", "`Err` builds the failure side of a `T ! E` result", "use it in a `T ! E` return type, a `T ! E` binding annotation, or a call that expects one"))
                        }
                    }
                    return None
                }
            }
        }
        else -> {
            if {
                success -> {
                    &diagnostics.push(sema_error("E0404", span, "`Ok(...)` only fits where a fallible result is expected", "`Ok` builds the success side of a `T ! E` result", "use it in a `T ! E` return type, a `T ! E` binding annotation, or a call that expects one"))
                }
                else -> {
                    &diagnostics.push(sema_error("E0404", span, "`Err(...)` only fits where a fallible result is expected", "`Err` builds the failure side of a `T ! E` result", "use it in a `T ! E` return type, a `T ! E` binding annotation, or a call that expects one"))
                }
            }
            return None
        }
    }
    message_payload :: !success && expected_err == (Val(Type.Named{name: "Err"})) && !sema_expression_default_err_struct(value) && !sema_expression_err_payload_is_err(value, environment, program, &scopes, &state, &tail_store, &context)
    if message_payload {
        result_type :: Type.Result{ok: expected_ok ?? Type.Named{name: "Unit"}, err: expected_err ?? Type.Named{name: "Err"}}
        checked_default :: sema_expression_default_err_call(value, span, result_type, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        return Val(checked_default)
    }
    payload_expected := if success -> expected_ok else -> expected_err
    checked_payload :: sema_check_expression(value, payload_expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    payload :: if take_field -> sema_tir_node(checked_payload.ty, TExprKind.Move{value: checked_payload}, checked_payload.span) else -> checked_payload
    ok_ty := expected_ok ?? Type.Named{name: "Unit"}
    err_ty := expected_err ?? Type.Named{name: "Err"}
    required :: if success -> ok_ty else -> err_ty
    if expected != None {
        fits :: sema_expr_expected_assignable(required, payload.ty, environment, program) ?? return None
        if !fits {
            &diagnostics.push(sema_type_mismatch(sema_expr_expected_type(required, environment, program), sema_expr_expected_type(payload.ty, environment, program), expr_span(value)))
            return None
        }
    }
    if expected == None {
        if success -> ok_ty = payload.ty else -> err_ty = payload.ty
    }
    result_ty :: Type.Result{ok: ok_ty, err: err_ty}
    kind :: if success -> TExprKind.Ok{value: payload} else -> TExprKind.Err{value: payload}
    sema_expr_expected_owned(sema_tir_expr(result_ty, kind, span), expected, environment, program, &diagnostics)
}

fn sema_expression_try_union_conversion(target: Type, source: Type) -> TTryConvert? {
    if target == {
        .Union(members) -> {
            found :: loop member in members {
                if type_identity_equal(member, source) -> break true
            } ?? false
            if !found -> return None
            tags :: loop member in members -> type_name(member)
            Val(TTryConvert.WidenUnion{enum_name: "__JetUnion_{tags.join("_")}", tag: type_name(source)})
        }
        else -> None
    }
}

// A call is a value-producing expression, and its
// Result carrier is transparent in an ordinary value position. An expectation
// is the carrier itself only when it names a reachable failure domain, or when
// both sides agree that failure is unreachable (`Never!`).
fn sema_expression_failure_carrier_position(expected: Type?, offered: Type) -> Bool Never! {
    required :: expected ?? return false
    required_error :: sema_expression_result_error(required) ?? return false
    if required_error != (Type.Named{name: "Never"}) -> return true
    if sema_expr_unwrap_tag(offered) == {
        .Result(_, offered_error) -> sema_expr_unwrap_tag(offered_error) == Type.Named{name: "Never"}
        else -> false
    }
}

// The failure domain of a `T E!` carrier, or None when the type is not one.
fn sema_expression_result_error(ty: Type) -> Type? {
    if sema_expr_unwrap_tag(ty) == {
        .Result(_, error) -> return Val(sema_expr_unwrap_tag(error))
        else -> return None
    }
}

// The success payload a propagated `Result` or `Option` carrier yields.
fn sema_expression_carrier_payload(ty: Type) -> Type? {
    if sema_expr_unwrap_tag(ty) == {
        .Result(ok, _) -> return Val(ok)
        .Option(value) -> return Val(value)
        else -> return None
    }
}

// A call root that may acquire the automatic propagation `Try`. Contextual
// `Ok`/`Err` constructors build a carrier, and a finite value loop keeps its
// own exhaustion route.
fn sema_expression_propagating_call(expr: Expr) -> Bool Never! {
    if expr == {
        .Call(call, _) -> call.name != "Ok" && call.name != "Err"
        .MethodCall(_, _, _, _, _, _, _) -> true
        .CallValue(callee, args, _, _) -> !sema_call_value_is_inline_loop(callee, args)
        else -> false
    }
}

// A pattern that inspects the Result carrier itself (the Rust reference's
// `pattern_consumes_result_carrier`).
fn sema_pattern_consumes_result_carrier(pattern: Pattern) -> Bool Never! {
    if pattern == {
        .Ok(_, _, _, _) | .Err(_, _, _, _) -> true
        .Or(alternatives, _) -> loop alternative in alternatives {
            if sema_pattern_consumes_result_carrier(alternative) -> break true
        } ?? false
        .Variant(variant, bindings, _, _) -> bindings.len() == 1 && (variant == "Ok" || variant == "Err")
        else -> false
    }
}

// Call checkers finish through this check. While the dispatcher has opened a
// success view for this call, a Result result is compared by its success side;
// `sema_expression_auto_propagate` then inserts the one `Try`.
fn sema_expression_call_expected(value: TExpr, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, context: SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    // Rust `expr_definitely_diverges` / `infer_or_fallback`: a call whose
    // checked result has a `Never` success (`Never`, or `Never !E`) diverges,
    // and the slot type is only an inference hint for it; its consumer (`??`,
    // a branch) accepts divergence. This is `x ?? fail(...)` with
    // `fn fail() -> Never Never!`, and the fixed Core route of
    // `x ?? core.math.__numeric_stop(...)`.
    if sema_expr_never_success(Val(sema_expr_unwrap_tag(value.ty))) -> return Val(value)
    if context.failure_success_view && expected != None && !sema_expression_failure_carrier_position(expected, value.ty) {
        if sema_expr_unwrap_tag(value.ty) == .Result(success, _) {
            required := sema_expr_expected_type(expected, environment, program)
            if sema_expr_unwrap_tag(required) == .Result(required_success, _) -> required = required_success
            offered :: sema_expr_expected_type(success, environment, program)
            compatible :: sema_expr_expected_assignable(required, offered, environment, program) ?? return None
            if !compatible {
                &diagnostics.push(sema_type_mismatch(required, offered, value.span))
                return None
            }
            return Val(value)
        }
    }
    sema_expr_expected(value, expected, environment, program, &diagnostics)
}

fn sema_failure_conversion_name_part(name: String) -> String Never! {
    bytes :: name.bytes()
    plain := true
    loop byte in bytes {
        code :: Int.from_u8(byte)
        if !((code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)) -> plain = false
    }
    if plain -> return name.copy()
    digits :: "0123456789abcdef".bytes()
    encoded := [U8]{}
    loop byte in bytes {
        code :: Int.from_u8(byte)
        &encoded.push(digits[((code >> 4)).bit_and(15)])
        &encoded.push(digits[(code).bit_and(15)])
    }
    "__{bytes.len()}_{String.from_bytes(encoded) ?? ""}"
}

// The canonical routine name of `impl Source -> Target`,
// matching the Rust reference's `error_conv_fn_name`.
fn sema_failure_conversion_function_name(source: Type, target: Type) -> String Never! {
    "errconv_{sema_failure_conversion_name_part(type_name(source))}_to_{sema_failure_conversion_name_part(type_name(target))}"
}

// A declared `impl Source -> Target` registers under the leaf names of both
// sides (the Rust reference names the routine by the declared names), so a
// site whose failure types are canonical owner identities
// (`module:…::OuterError`) or qualified spellings finds the same routine.
fn sema_failure_declared_conversion_name(source_leaf: String, target_leaf: String) -> String Never! {
    "errconv_{sema_failure_conversion_name_part(source_leaf)}_to_{sema_failure_conversion_name_part(target_leaf)}"
}

fn sema_failure_conversion_leaf(ty: Type) -> String Never! {
    normalized :: sema_expr_unwrap_tag(ty)
    if normalized == .Named(name) -> return sema_error_conversion_leaf(name)
    type_name(normalized)
}

// A declared conversion is one registered function under the canonical name;
// the checked route carries that routine's symbol key, the identity lowering
// resolves. 's standard-library family takes the same route
// through `sema_prelude_error_conversion_key`.
fn sema_failure_declared_conversion(source: Type, target: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> String? {
    name :: sema_failure_declared_conversion_name(sema_failure_conversion_leaf(source), sema_failure_conversion_leaf(target))
    index :: sema_scope_resolve_index(scopes, name) ?? return sema_failure_namespace_conversion(name, environment, program)
    if scopes.bindings[index].symbol.kind != SymbolKind.Function -> return None
    Val(scopes.bindings[index].symbol.id.key)
}

// A conversion declared in another member file of the same package. Its routine is a
// generated name no source spells, so the namespace never binds it into this file's
// scope; the package is still one namespace, so its routine applies here.
fn sema_failure_namespace_conversion(name: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> String? {
    if !sema_registration_package_is_namespace(environment.package_identity) || environment.module_identity.starts_with("<corelib>/") -> return None
    if program.registration_graph == .Val(graph) {
        loop module_row in graph.modules {
            if module_row.package_identity != environment.package_identity -> next
            loop function in module_row.functions {
                if function.symbol.name == name -> return Val(function.symbol.id.key)
            }
        }
    }
    None
}

struct SemaFailureProvenance {
    callee: String
    definition: String
    contract: String
}

fn sema_failure_definition_location(environment: SemaScopeEnvironment, program: SemaProgramTables, symbol: Symbol) -> String? {
    if program.registration_graph == .Val(graph) {
    loop module_row_index in 0..<graph.modules.len() {
        if graph.modules[module_row_index].module_identity != symbol.module_name && graph.modules[module_row_index].module_name != symbol.module_name -> next
        if graph.modules[module_row_index].module_path == "" -> return None
        line :: sema_source_line_at(graph.modules[module_row_index].source_segments, symbol.span) ?? return None
        loop segment_index in 0..<graph.modules[module_row_index].source_segments.len() {
            if symbol.span.start >= graph.modules[module_row_index].source_segments[segment_index].generated.start && symbol.span.start < graph.modules[module_row_index].source_segments[segment_index].generated.end && line <= graph.modules[module_row_index].source_segments[segment_index].line_starts.len() {
                column :: symbol.span.start - graph.modules[module_row_index].source_segments[segment_index].generated.start - graph.modules[module_row_index].source_segments[segment_index].line_starts[line - 1] + 1
                return Val("{graph.modules[module_row_index].module_path}:{line}:{column}")
            }
        }
        return None
    }
    }
    None
}

fn sema_failure_call_provenance(expr: Expr?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> SemaFailureProvenance Never! {
    fallback :: "Core or generated callable (no user source location)"
    source :: expr ?? return SemaFailureProvenance{callee: "this fallible expression", definition: fallback, contract: "inferred failure contract"}
    if source == {
        .Paren(inner, _, _) -> return sema_failure_call_provenance(Val(inner), environment, program, scopes)
        .Try(inner, _, _, _, _) -> return sema_failure_call_provenance(Val(inner), environment, program, scopes)
        .Call(call, _) -> {
            definition := fallback
            contract := "inferred failure contract"
            if sema_scope_resolve_index(scopes, call.name) == .Val(index) {
                symbol :: scopes.bindings[index].symbol
                definition = sema_failure_definition_location(environment, program, symbol) ?? fallback
                if sema_scope_resolve_declaration(environment, program, symbol.id) == .Val(item) {
                    if item == .Func(func) -> contract = sema_failure_contract_source(func.return_type)
                }
            }
            return SemaFailureProvenance{callee: call.name, definition: definition, contract: contract}
        }
        .MethodCall(_, method, _, _, _, _, _) -> return SemaFailureProvenance{callee: "{method}()", definition: fallback, contract: "inferred failure contract"}
        else -> {}
    }
    SemaFailureProvenance{callee: "this fallible expression", definition: fallback, contract: "inferred failure contract"}
}

// #3708: the declared function a failing call names, by symbol key, and
// whether it writes no failure contract (so the bundle failure solve may
// still prove its failure set empty).
struct SemaFailureCallee {
    key: String
    inferable: Bool
}

fn sema_failure_callee(expr: Expr?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> SemaFailureCallee? {
    source :: expr ?? return None
    if source == {
        .Paren(inner, _, _) -> return sema_failure_callee(Val(inner), environment, program, scopes)
        .Call(call, _) -> {
            index :: sema_scope_resolve_index(scopes, call.name) ?? return None
            symbol :: scopes.bindings[index].symbol
            if symbol.kind != SymbolKind.Function -> return None
            inferable :: sema_failure_callee_inferable(environment, program, symbol.id) ?? return None
            return Val(SemaFailureCallee{key: symbol.id.key, inferable: inferable})
        }
        // Rust `inferable_failure_callee`: `alias.member(...)` through a
        // whole-module import names that module's source function, which the
        // bundle solve settles like a same-module callee.
        .MethodCall(receiver, method, _, _, _, _, _) -> {
            alias :: if receiver == {
                .Ident(name, _, _) -> name
                else -> { return None }
            }
            imported :: sema_call_core_import_target(environment, program, alias) ?? sema_call_source_import_target(environment, program, alias) ?? return None
            if imported.item != None -> return None
            if program.registration_graph == .Val(graph) {
                module_index :: sema_registration_module_index(graph, imported.module_identity) ?? return None
                loop index in 0..<graph.modules[module_index].functions.len() {
                    if graph.modules[module_index].functions[index].symbol.name != method -> next
                    return Val(SemaFailureCallee{key: graph.modules[module_index].functions[index].symbol.id.key, inferable: sema_failure_function_inferable(graph.modules[module_index].functions[index].declaration)})
                }
            }
            return None
        }
        else -> return None
    }
}

// For a declared function `id`: whether it is an ordinary body with no failure
// contract written (sema_failure_callee); None when `id` declares no function.
// A graph function is read at its row: resolving the declaration copied the
// callee's whole body on every failing call.
fn sema_failure_callee_inferable(environment: SemaScopeEnvironment, program: SemaProgramTables, id: SymbolID) -> Bool? {
    site :: sema_scope_declaration_site(environment, program, id) ?? return None
    if site == .Function(module_index, row) {
        if program.registration_graph == .Val(graph) -> return Val(sema_failure_function_inferable(graph.modules[module_index].functions[row].declaration))
        return None
    }
    item :: sema_scope_resolve_declaration(environment, program, id) ?? return None
    if item == .Func(func) -> return Val(sema_failure_function_inferable(func))
    None
}

fn sema_failure_function_inferable(func: Func) -> Bool {
    func.inline_foreign == None && sema_failure_contract_is_default(func.return_type)
}

// Whether the callee of `expr` declares a failure route on its declared
// return (the Rust reference's `resolved_ret`): a direct call of a function
// with no written return (the default `Err` route) or a written fallible one.
// A written plain return (`-> Int`) declares none even though the call carries
// the default route; any other fallible source declares its own.
fn sema_failure_source_declares_failure(expr: Expr?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> Bool {
    source :: expr ?? return true
    if source == {
        .Paren(inner, _, _) -> return sema_failure_source_declares_failure(Val(inner), environment, program, scopes)
        .Call(call, _) -> {
            index :: sema_scope_resolve_index(scopes, call.name) ?? return true
            symbol :: scopes.bindings[index].symbol
            if symbol.kind != SymbolKind.Function -> return true
            site :: sema_scope_declaration_site(environment, program, symbol.id) ?? return true
            if site == .Function(module_index, row) {
                if program.registration_graph == .Val(graph) -> return sema_failure_written_return_fails(graph.modules[module_index].functions[row].declaration.return_type)
                return true
            }
            item :: sema_scope_resolve_declaration(environment, program, symbol.id) ?? return true
            if item == .Func(func) -> return sema_failure_written_return_fails(func.return_type)
            return true
        }
        else -> return true
    }
}

fn sema_failure_written_return_fails(return_type: Type?) -> Bool Never! {
    written :: return_type ?? return true
    if sema_expr_unwrap_tag(written) == .Result(_, error) -> return sema_expr_unwrap_tag(error) != (Type.Named{name: "Never"})
    false
}

// #3708: one propagated failure of this body: the callee's key when the
// propagated value is a call of a declared function, else "" (a failure
// source the solve can never discharge).
fn sema_failure_record_edge(callee: SemaFailureCallee?, context: &SemaCheckContext) Never! {
    if callee == .Val(found) {
        &context.failure_edges.push(found.key)
        return
    }
    &context.failure_edges.push("")
}

// A failure passing up into the default `Err` route
// joins this body's failure-union row: an unannotated callee as an edge the
// bundle solve joins, any other failure as a member (the Rust reference's
// failure-union probe arm of `infer_try`).
fn sema_failure_union_record_propagation(callee: SemaFailureCallee?, error: Type, context: &SemaCheckContext) Never! {
    if callee == .Val(found) {
        if found.inferable {
            loop edge in context.failure_union_edges {
                if edge == found.key -> return
            }
            &context.failure_union_edges.push(found.key)
            return
        }
    }
    sema_failure_union_add_member(&context, error)
}

// The detail prefix of a failure-domain diagnostic that the bundle failure
// solve emits or discharges once every body is checked (#3708).
fn sema_failure_obligation_mark() -> String Never! {
    "inferred-failure-obligation:"
}

// #3708: the diagnostic just reported against an unannotated callee becomes
// an obligation of the bundle failure solve. The call checks as the `T Never!`
// plain return it has when the solve discharges the obligation; otherwise the
// solve emits the diagnostic unchanged.
fn sema_failure_defer_obligation(callee: SemaFailureCallee?, diagnostics: &[Diagnostic]) -> TTryConvert? {
    found :: callee ?? return None
    if !found.inferable || diagnostics.len() == 0 -> return None
    last :: diagnostics.len() - 1
    detail :: diagnostics[last].detail ?? ""
    diagnostics[last].detail = Val("{sema_failure_obligation_mark()}{found.key}\n{detail}")
    Val(TTryConvert.Never)
}

// #3708: whether `callee` is an unannotated function the bundle failure solve
// projected onto its span-less `T Never!` contract ("inferred: none").
fn sema_failure_callee_inferred_never(callee: SemaFailureCallee?, program: SemaProgramTables) -> Bool Never! {
    found :: callee ?? return false
    if program.registration_graph == .Val(graph) {
        row :: sema_registration_callable_row(graph, found.key) ?? return false
        if row == .Function(module_index, index) {
            declaration :: graph.modules[module_index].functions[index].declaration
            if failure_contract_of_function(declaration.return_type, declaration.return_type_span) == .InferredNever(_) -> return true
        }
    }
    false
}

// E2404: no declared route from the operand's failure domain to the caller's.
// The `failure-domain:` detail keys the bundle-level one-root dedupe.
fn sema_failure_domain_mismatch(expr: Expr?, span: Span, source: Type, target: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, context: SemaCheckContext) -> Diagnostic {
    provenance :: sema_failure_call_provenance(expr, environment, program, scopes)
    callee :: provenance.callee
    source_name :: type_name(source)
    target_name :: type_name(target)
    caller :: context.failure_contract_source
    diagnostic :: sema_error(
        "E2404",
        span,
        "`{callee}` fails with `{source_name}`, which can't propagate into `{target_name}` here",
        "`{callee}` is defined at `{provenance.definition}` with effective failure contract `{provenance.contract}`; the caller's `{caller}` contract has no route from `{source_name}` to `{target_name}`",
        "Declare the caller with `{source_name}` as its failure domain, or add `impl {source_name} -> {target_name} {{ … }}`; otherwise handle `{callee}` locally with `??`",
    )
    diagnostic_with_detail(^diagnostic, "failure-domain:{callee}|{source_name}|{target_name}\ncallee: {callee}\ndefinition: {provenance.definition}\neffective contract: {provenance.contract}\ncaller contract: {caller}")
}

fn sema_failure_no_carrier(error: Type, span: Span, implicit: Bool) -> Diagnostic {
    if implicit -> return sema_error("E0403", span, "this fallible call only works inside a function that returns a fallible result", "ordinary fallible calls propagate their failure automatically to the caller", "declare `{type_name(error)}!` in the return type, or handle the result with `??`")
    sema_error("E0403", span, "`?` only works inside a function that returns a fallible result", "propagation early-returns the failure to the caller", "declare the failure in the return type — `{type_name(error)}!` — or handle the result with `??`")
}

fn sema_failure_no_default_conversion(error: Type, span: Span, implicit: Bool) -> Diagnostic {
    name :: type_name(error)
    if implicit -> return sema_error("E2402", span, "this implicit fallible call can't convert `{name}` into `Err` — no declared conversion exists", "ordinary fallible calls propagate automatically; `{name}` can reach `Err` only through `impl {name} -> Err`", "handle this call locally with `??`, add `impl {name} -> Err {{ … }}`, or change the return type")
    sema_error("E2402", span, "`?` can't convert `{name}` into `Err` — no declared conversion exists", "`?` uses the declared conversion rail; `{name}` can reach `Err` only through `impl {name} -> Err`", "add `impl {name} -> Err {{ … }}` before this function, or change the return type")
}

// The error domain receiving an early return. An open callback adopts the
// Result carrier of its first propagated call; `Diverges`, `Optional`, and a
// missing carrier have no failure route. `-> T Never!` checks as the
// Infallible carrier of `Result<T, Never>` and answers `Never`.
fn sema_failure_parent_error(operand_error: Type, scopes: SemaScopeTable, context: &SemaCheckContext) -> Type? {
    carrier := scopes.failure_carrier
    if carrier == None && context.failure_inference {
        if context.inferred_failure_carrier == None -> context.inferred_failure_carrier = Val(TFailureCarrier.Result{success: Type.Named{name: "Unit"}, error: operand_error})
        carrier = context.inferred_failure_carrier
    }
    parent :: carrier ?? return None
    if parent == .Result(_, error) -> return Val(error)
    if scopes.return_type == .Val(return_type) {
        if sema_expr_unwrap_tag(return_type) == .Result(_, error) {
            if sema_expr_unwrap_tag(error) == (Type.Named{name: "Never"}) -> return Val(error)
        }
    }
    None
}

// 2 and the one conversion law shared by
// explicit `?` and automatic call propagation. `implicit` selects wording only.
fn sema_expression_propagation_conversion(operand_ty: Type, source_expr: Expr?, span: Span, implicit: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TTryConvert? {
    operand :: sema_expr_unwrap_tag(operand_ty)
    if operand == {
        .Result(_, error) -> {
            // `Never` is uninhabited whatever the caller's rail. A callee the
            // bundle failure solve projected onto `T Never!` still propagated
            // the default `Err` in the Rust reference's one body check, which
            // precedes that projection; a spawned task body records it so a
            // recheck keeps the task element it was first checked with.
            if sema_expr_unwrap_tag(error) == (Type.Named{name: "Never"}) {
                if context.taskgroups.in_spawn && sema_failure_callee_inferred_never(sema_failure_callee(source_expr, environment, program, scopes), program) -> context.task_body_propagates = true
                return Val(TTryConvert.Never)
            }
            callee :: sema_failure_callee(source_expr, environment, program, scopes)
            sema_failure_record_edge(callee, &context)
            target :: sema_failure_parent_error(error, scopes, &context) ?? {
                &diagnostics.push(sema_failure_no_carrier(error, span, implicit))
                return sema_failure_defer_obligation(callee, &diagnostics)
            }
            // A callback with no return row takes the carrier of its first
            // propagated call whose callee declares a failure route.
            if context.callback_return_open && context.callback_return_row == None && scopes.failure_carrier == None && sema_failure_source_declares_failure(source_expr, environment, program, scopes) -> context.callback_return_row = Val(sema_expr_unwrap_tag(operand_ty))
            normalized_target :: sema_expr_unwrap_tag(target)
            if normalized_target == (Type.Named{name: "Err"}) -> sema_failure_union_record_propagation(callee, error, &context)
            // `Never!` proves no failure route remains, even when a
            // conversion happens to be declared.
            if normalized_target == (Type.Named{name: "Never"}) {
                &diagnostics.push(sema_failure_domain_mismatch(source_expr, span, error, target, environment, program, scopes, context))
                return sema_failure_defer_obligation(callee, &diagnostics)
            }
            // Rust `*ret_err == err || nominal_type_identity(ret_err, &err)`: a
            // callee may publish its failure by the declared spelling
            // (`NetError`) while the caller's contract carries the canonical
            // identity; both name one nominal type in this module.
            if type_identity_equal(error, target) || type_identity_equal(sema_expr_expected_type(error, environment, program), sema_expr_expected_type(target, environment, program)) -> return sema_expression_propagation_taken(&context, TTryConvert.NoConversion)
            if normalized_target == (Type.Named{name: "Err"}) && sema_expr_unwrap_tag(error) == Type.String -> return sema_expression_propagation_taken(&context, TTryConvert.DefaultErr)
            widened :: sema_expression_try_union_conversion(normalized_target, error)
            if widened == .Val(widening) -> return sema_expression_propagation_taken(&context, widening)
            if sema_failure_declared_conversion(error, target, environment, program, scopes) == .Val(key) -> return sema_expression_propagation_taken(&context, TTryConvert.Typed{fn_name: key, source: error, target: target})
            if sema_prelude_error_conversion_key(error, target, environment, program) == .Val(key) -> return sema_expression_propagation_taken(&context, TTryConvert.Typed{fn_name: key, source: error, target: target})
            if normalized_target == (Type.Named{name: "Err"}) {
                &diagnostics.push(sema_failure_no_default_conversion(error, span, implicit))
                return None
            }
            // D9: a `_` hole domain already has its one E0119 at the
            // signature; keep the success value typed and report nothing more.
            if normalized_target == (Type.Named{name: "_"}) -> return sema_expression_propagation_taken(&context, TTryConvert.NoConversion)
            &diagnostics.push(sema_failure_domain_mismatch(source_expr, span, error, target, environment, program, scopes, context))
            return sema_failure_defer_obligation(callee, &diagnostics)
        }
        .Option(value) -> {
            if scopes.failure_carrier == .Val(parent) {
                if parent == .Optional(target_value) {
                    if type_identity_equal(value, target_value) -> return sema_expression_propagation_taken(&context, TTryConvert.NoConversion)
                }
            }
            &diagnostics.push(sema_error("E0403", span, "`?` on `{type_name(operand_ty)}` needs a function that returns the same optional type", "propagation passes `None` back to the caller", "declare `{type_name(operand_ty)}` as the optional return type, or handle it with `??`"))
            return None
        }
        else -> {
            &diagnostics.push(sema_error("E0403", span, "`?` only works on a fallible value, not {type_name(operand_ty)}", "`?` unwraps success or returns early with the failure", "call something that returns `T E!` or an optional value, or remove `?`"))
            return None
        }
    }
}

// (Rust `task_body_propagates`): a failure that leaves this
// body through the enclosing carrier. A lambda scopes and harvests the fact.
fn sema_expression_propagation_taken(context: &SemaCheckContext, conversion: TTryConvert) -> TTryConvert? Never! {
    context.task_body_propagates = true
    Val(conversion)
}

// A conversion already carried by the AST is validated, never re-derived.
fn sema_expression_try_declared_conversion(inner: TExpr, conversion: TryConvert, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, check_context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TTryConvert? {
    source_error :: if sema_expr_unwrap_tag(inner.ty) == {
        .Result(_, err) -> Val(err)
        else -> None
    }
    source :: source_error ?? Type.Named{name: "Unit"}
    target_error := Type?{None}
    if scopes.failure_carrier == .Val(parent) {
        if parent == .Result(_, err) -> target_error = Val(err)
    }
    target :: target_error ?? Type.Named{name: "Unit"}
    if conversion == {
        .NoConversion -> return Val(TTryConvert.NoConversion)
        .Never -> {
            if source_error == None || source != (Type.Named{name: "Never"}) {
                &diagnostics.push(sema_error("E2402", span, "`?` is marked unreachable, but the operand can fail", "the Never conversion is valid only for an uninhabited error arm", "use a normal propagation conversion for this error type"))
                return None
            }
            return Val(TTryConvert.Never)
        }
        .DefaultErr -> {
            if source != Type.String || target != (Type.Named{name: "Err"}) {
                &diagnostics.push(sema_error("E2402", span, "the default error conversion is not valid for this failure domain", "the built-in conversion accepts String and returns Err", "use a declared conversion for the source error type"))
                return None
            }
            return Val(TTryConvert.DefaultErr)
        }
        .Typed(fn_name, declared_source, declared_target) -> {
            if !type_identity_equal(source, declared_source) || !type_identity_equal(target, declared_target) {
                &diagnostics.push(sema_error("E2402", span, "the declared error conversion does not match this `?` site", "conversion metadata must name the operand and enclosing failure domains exactly", "use the conversion declared for these two error types"))
                return None
            }
            symbol_index :: sema_scope_resolve_index(scopes, fn_name) ?? {
                &diagnostics.push(sema_error("E2402", span, "the declared error conversion `{fn_name}` is not in scope", "a checked conversion must resolve to one registered function", "declare or import the conversion before using `?`"))
                return None
            }
            symbol :: sema_scope_binding_symbol(environment, scopes, symbol_index)
            if symbol.kind != SymbolKind.Function || symbol.ty == None {
                &diagnostics.push(sema_error("E2402", span, "`{fn_name}` is not a checked error-conversion function", "the conversion route must retain a callable symbol and signature", "declare a function taking the source error and returning the target error"))
                return None
            }
            &check_context.name_references.push(SemaNameReferenceFact{span: span, symbol: symbol, kind: "function"})
            // A conversion routine cannot fail: `fn(Source) -> Target Never!`.
            valid_signature :: if symbol.ty == .Val(function_type) -> if function_type == {
                .Fn(params, ret, _, _, _, _) -> params.len() == 1 && type_identity_equal(params[0], source) && ret == (Val(Type.Result{ok: target, err: Type.Named{name: "Never"}}))
                else -> false
            } else -> false
            if !valid_signature {
                &diagnostics.push(sema_error("E2402", span, "`{fn_name}` has the wrong error-conversion signature", "a conversion consumes the source error and returns the enclosing error", "declare `fn(Source) Target` for this conversion"))
                return None
            }
            return Val(TTryConvert.Typed{fn_name: symbol.id.key, source: source, target: target})
        }
        .WidenUnion(enum_name, union_tag) -> {
            members :: if sema_expr_unwrap_tag(target) == {
                .Union(values) -> values
                else -> {
                    &diagnostics.push(sema_error("E2402", span, "the union error conversion needs a union return carrier", "widening adds one source error member to an enclosing error union", "return a declared error union or use a typed conversion"))
                    return None
                }
            }
            found :: loop member in members {
                if type_identity_equal(member, source) -> break true
            } ?? false
            if !found {
                &diagnostics.push(sema_error("E2402", span, "the operand error is not a member of the enclosing error union", "union widening is valid only for a declared source member", "add the source error type to the return union"))
                return None
            }
            return Val(TTryConvert.WidenUnion{enum_name: enum_name, tag: union_tag})
        }
    }
}

// The success payload of a propagated carrier, wrapped in the shared Try node.
fn sema_expression_propagated(inner: TExpr, conversion: TTryConvert, span: Span) -> TExpr? {
    payload :: sema_expression_carrier_payload(inner.ty) ?? return None
    Val(sema_tir_node(payload, TExprKind.Try{value: inner, conversion: conversion, failure: sema_expression_failure_carrier(inner.ty)}, span))
}

// Automatic propagation of a call root. Only a
// Result carrier propagates; an optional result is an ordinary value. The
// propagation site joins the failure journey like an explicit `?(text)` hop,
// without a note (#3713).
fn sema_expression_auto_propagate(expr: Expr, value: ^TExpr, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    // Own only the checked tree, never the READ source AST. Carrier metadata
    // and conversion reads finish before its owner enters the replacement.
    if !sema_expression_auto_propagates(value.ty, expected, context) -> return Val(^value)
    span :: expr_span(expr)
    conversion :: sema_expression_propagation_conversion(value.ty, Val(expr), span, true, environment, program, &scopes, &context, &diagnostics) ?? return None
    payload :: sema_expression_carrier_payload(value.ty) ?? return None
    location :: sema_expression_panic_location(environment, program, scopes, span)
    propagated :: sema_tir_node(payload, TExprKind.TryWithContext{inner: ^value, note: None, convert: conversion, file: location.file, line: location.line, function: location.function}, span)
    sema_expr_expected(propagated, expected, environment, program, &diagnostics)
}

// Whether a call root's checked carrier propagates automatically: only a
// Result does. Compiler-generated bodies (derived codecs) spell their
// carriers out and keep the Result; only a proven `Never` rail still unwraps.
fn sema_expression_auto_propagates(ty: Type, expected: Type?, context: SemaCheckContext) -> Bool Never! {
    if sema_expr_unwrap_tag(ty) == {
        .Result(_, _) -> {}
        else -> return false
    }
    if context.compiler_generated {
        if sema_expr_unwrap_tag(ty) == .Result(_, generated_error) {
            if sema_expr_unwrap_tag(generated_error) != (Type.Named{name: "Never"}) -> return false
        }
    }
    !sema_expression_failure_carrier_position(expected, ty)
}

// A call root rejected after its callee was resolved still has the callee's
// result carrier; as in the reference, its automatic propagation is checked
// as for an accepted call.
fn sema_expression_rejected_call_propagation(result_type: Type, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) {
    if !context.failure_success_view || !sema_expression_auto_propagates(result_type, expected, context) -> return
    _ := sema_expression_propagation_conversion(result_type, None, span, true, environment, program, &scopes, &context, &diagnostics)
}

fn sema_expression_try(value: Expr, span: Span, conversion: TryConvert, context_expr: Expr?, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, check_context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    // Explicit `?` owns its operand's carrier: the call root must not
    // propagate a second time before this check sees it.
    inner :: sema_check_expression_carrier(value, None, environment, program, &scopes, &state, &tail_store, &check_context, &diagnostics) ?? return None
    try_conversion :: if conversion == {
        .NoConversion -> sema_expression_propagation_conversion(inner.ty, Val(value), span, false, environment, program, &scopes, &check_context, &diagnostics) ?? return None
        else -> {
            unreachable_route :: if conversion == {
                .Never -> true
                else -> false
            }
            if !unreachable_route -> sema_failure_record_edge(sema_failure_callee(Val(value), environment, program, scopes), &check_context)
            sema_expression_try_declared_conversion(inner, conversion, span, environment, &scopes, &check_context, &diagnostics) ?? return None
        }
    }
    value_tir := sema_expression_propagated(inner, try_conversion, span) ?? return None
    if context_expr == .Val(context_source) {
        // The note's ownership effects are discarded: it is checked inside a
        // fork and rolled back.
        context_fork :: sema_ownership_fork(&state)
        checked_note :: sema_check_expression(context_source, Val(Type.String), environment, program, &scopes, &state, &tail_store, &check_context, &diagnostics)
        sema_ownership_fork_rollback(&state, context_fork)
        sema_ownership_fork_close(&state, context_fork)
        note :: checked_note ?? return None
        location :: sema_expression_panic_location(environment, program, scopes, span)
        value_tir = sema_tir_node(value_tir.ty, TExprKind.TryWithContext{inner: inner, note: Val(note), convert: try_conversion, file: location.file, line: location.line, function: location.function}, span)
    }
    sema_expr_expected(value_tir, expected, environment, program, &diagnostics)
}

fn sema_control_value_loop_requires_route(value: Expr) -> Bool Never! {
    if value == {
        .CallValue(callee, args, _, _) -> {
            if args.len() != 0 -> return false
            if callee == {
                .Lambda(lambda, _) -> return lambda.meta.result_loop && lambda.meta.requires_exhaustion_route && !lambda.meta.exhaustion_route_attached
                else -> return false
            }
        }
        else -> return false
    }
}

fn sema_control_value_loop_root_label(lambda: Lambda) -> NamedSpan? {
    if lambda.meta.loop_label != None -> return lambda.meta.loop_label
    if lambda.body == {
        .Block(statements) -> {
            if statements.len() == 0 -> return None
            if statements[0] == {
                .Loop(_, _, _, label) | .While(_, _, _, _, label) | .For(_, _, _, _, _, _, _, label, _) | .CountedLoop(_, _, _, _, _, _, label) -> return label
                else -> return None
            }
        }
        else -> return None
    }
}

fn sema_control_value_loop_fallback_stmt(fallback: OrFallback, loop_label: NamedSpan?, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Stmt? {
    if fallback == {
        .Value(value) -> {
            root :: loop_label ?? {
                &diagnostics.push(sema_error("E0078", expr_span(value), "this finite value loop has no exhaustion label", "its fallback must become a result exit on the loop root", "use a finite value loop expression"))
                return None
            }
            return Val(Stmt.BreakLabelValue{name: root.name, name_span: root.span, value: value, span: expr_span(value)})
        }
        // copy: `value` is a payload of read parameter `fallback`, which keeps the original; field `value` of the new Stmt.Return owns this one
        .Return(value, span) -> return Val(Stmt.Return{value: value.copy(), span: span})
        .Panic(name_span, args) -> {
            call := Call{name: "panic", name_span: name_span, type_args: [Type]{}, args: args}
            return Val(Stmt.Expr{expr: Expr.Call{call: call, id: AST_NODE_GENERATED}})
        }
        .BreakLabel(name, span) -> {
            if scopes.loop_depth <= 0 {
                &diagnostics.push(sema_error("E0115", span, "`break` only works inside a loop", "`?? break(label)` must name an enclosing loop", "move this expression inside a loop"))
                return None
            }
            if !sema_scope_has_loop_label(scopes, name) {
                &diagnostics.push(sema_stmt_unknown_loop_label(name, span))
                return None
            }
            return Val(Stmt.BreakLabel{name: name, span: span})
        }
        .ContinueLabel(name, span) -> {
            if scopes.loop_depth <= 0 {
                &diagnostics.push(sema_error("E0115", span, "`next` only works inside a loop", "`?? next(label)` must name an enclosing loop", "move this expression inside a loop"))
                return None
            }
            if !sema_scope_has_loop_label(scopes, name) {
                &diagnostics.push(sema_stmt_unknown_loop_label(name, span))
                return None
            }
            return Val(Stmt.ContinueLabel{name: name, span: span})
        }
        .Break(span) | .Continue(span) -> {
            &diagnostics.push(sema_error("E0078", span, "this finite value loop can't use an unlabeled exhaustion control route", "the route would control the loop that just closed", "write a labeled route to an enclosing loop"))
            return None
        }
        .Block(_, _, span) -> {
            &diagnostics.push(sema_error("E0405", span, "a finite value loop can't use a multi-step exhaustion block", "its exhaustion route carries one value or control action", "use one fallback value or a single control route"))
            return None
        }
    }
}

fn sema_control_value_loop_append_route(statements: &[Stmt], route: Stmt) -> Bool Never! {
    if statements.len() == 0 -> return false
    root := statements[0]
    if root == {
        .Loop(body, span, arrow_body, label) -> {
            updated_body := body.copy()
            &updated_body.push(route)
            statements[0] = Stmt.Loop{body: updated_body, span: span, arrow_body: arrow_body, label: label}
            return true
        }
        .While(condition, body, span, arrow_body, label) -> {
            updated_body := body.copy()
            &updated_body.push(route)
            statements[0] = Stmt.While{cond: condition, body: updated_body, span: span, arrow_body: arrow_body, label: label}
            return true
        }
        .For(variable, variable_span, variable_two, kind, body, span, arrow_body, label, vectorization) -> {
            updated_body := body.copy()
            &updated_body.push(route)
            statements[0] = Stmt.For{var: variable, var_span: variable_span, var2: variable_two, kind: kind, body: updated_body, span: span, arrow_body: arrow_body, label: label, auto_vectorization: vectorization}
            return true
        }
        .CountedLoop(init, condition, step, body, span, arrow_body, label) -> {
            updated_body := body.copy()
            &updated_body.push(route)
            statements[0] = Stmt.CountedLoop{init: init, cond: condition, step: step, body: updated_body, span: span, arrow_body: arrow_body, label: label}
            return true
        }
        else -> return false
    }
}

fn sema_control_value_loop_attach_fallback(value: Expr, fallback: OrFallback, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Expr? {
    if value == {
        .CallValue(callee, args, span, _) -> {
            if args.len() != 0 -> return None
            if callee == {
                .Lambda(lambda, _) -> {
                    updated_lambda := lambda
                    if !updated_lambda.meta.result_loop || !updated_lambda.meta.requires_exhaustion_route -> return None
                    route :: sema_control_value_loop_fallback_stmt(fallback, sema_control_value_loop_root_label(updated_lambda), scopes, &diagnostics) ?? return None
                    if updated_lambda.body == {
                        .Block(statements) -> {
                            updated_statements := statements
                            if !sema_control_value_loop_append_route(&updated_statements, route) {
                                &diagnostics.push(sema_error("E0078", updated_lambda.span, "this finite value loop has no root loop for its exhaustion route", "the route must be attached to the expression loop itself", "use the finite loop-expression form"))
                                return None
                            }
                            // The route belongs to the lambda's own root loop
                            // (Rust `attach_value_loop_route` pushes in place).
                            updated_lambda.body = LambdaBody.Block{body: updated_statements}
                        }
                        else -> {
                            &diagnostics.push(sema_error("E0078", updated_lambda.span, "this finite value loop has no block body for its exhaustion route", "the route must be attached to the expression loop itself", "use the finite loop-expression form"))
                            return None
                        }
                    }
                    updated_lambda.meta.exhaustion_route_attached = true
                    return Val(Expr.CallValue{callee: Expr.Lambda{lambda: updated_lambda, id: AST_NODE_GENERATED}, args: args, span: span, id: AST_NODE_GENERATED})
                }
                else -> return None
            }
        }
        else -> return None
    }
}

fn sema_expression_or_fallback(value: Expr, fallback: OrFallback, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if sema_control_value_loop_requires_route(value) {
        routed :: sema_control_value_loop_attach_fallback(value, fallback, scopes, &diagnostics) ?? return None
        return sema_check_expression(routed, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    // `??` owns its subject's carrier; the call root must not auto-propagate.
    subject :: sema_check_expression_carrier(value, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    payload_ty :: if subject.ty == {
        .Result(ok, _) -> if ok == {
            .Option(inner) -> Val(inner)
            else -> Val(ok)
        }
        .Option(inner) -> Val(inner)
        else -> None
    }
    payload :: payload_ty ?? {
        &diagnostics.push(sema_error("E0405", span, "`??` only works on a fallible value, not {type_name(subject.ty)}", "the left side must be a `Result` or optional value", "call something that can fail, then write `... ?? fallback`"))
        return None
    }
    // The fallback route runs in its own frame on the live scope table and on
    // the live ownership state, both rolled back (sema_ownership_fork),
    // instead of on copies of the whole table and state.
    fork :: sema_ownership_fork(&state)
    fallback_mark :: sema_scope_mark(&scopes)
    route :: sema_expression_or_fallback_route(fallback, span, subject.ty, payload, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    sema_scope_rollback(&scopes, fallback_mark)
    fallback_path :: sema_ownership_fork_path(state, fork)
    checked_route :: route ?? {
        sema_ownership_fork_drop(&state, fork, fallback_path.share_found, [SemaOwnershipShareSite]{})
        return None
    }
    if checked_route.reaches_merge {
        sema_ownership_fork_rollback(&state, fork)
        joined :: sema_ownership_path_join(state, fork, sema_ownership_fork_base(fork), fallback_path, true, state.share_found)
        sema_ownership_fork_apply(&state, joined)
        sema_ownership_fork_close(&state, fork)
    } else {
        sema_ownership_fork_drop(&state, fork, fallback_path.share_found, [SemaOwnershipShareSite]{})
    }
    route_value :: checked_route.value ?? TOrFallback.Value{value: sema_node(&context, checked_route.payload, NodeKind.Unit, span)}
    // (Rust `lower_or_fallback`): a mixed `T? E!`
    // carrier has two failure routes, so `??` removes them one at a time:
    // first its Result route (where `err` is bound and a value fallback is
    // lifted to `Val(fallback)`), then the remaining Option route. Only one
    // route runs, so the fallback is still evaluated at most once.
    if subject.ty == .Result(ok, _) && ok == .Option(_) {
        failure_route :: if route_value == {
            .Value(fallback_value) -> TOrFallback.Value{value: sema_tir_node(ok, TExprKind.Present{value: fallback_value}, fallback_value.span)}
            else -> route_value
        }
        after_result :: sema_tir_node(ok, TExprKind.OrFallback{value: subject, fallback: failure_route, ambient_err: checked_route.ambient_err}, span)
        mixed :: sema_tir_node(checked_route.payload, TExprKind.OrFallback{value: after_result, fallback: route_value, ambient_err: None}, span)
        return sema_expr_expected_owned(^mixed, expected, environment, program, &diagnostics)
    }
    result :: sema_tir_node(checked_route.payload, TExprKind.OrFallback{value: subject, fallback: route_value, ambient_err: checked_route.ambient_err}, span)
    sema_expr_expected(result, expected, environment, program, &diagnostics)
}

struct SemaOrFallbackRoute {
    payload: Type
    value: TOrFallback?
    reaches_merge: Bool
    ambient_err: TLocal?
}

// A valueless builtin call (`print`, `assert`, `assert_eq`, `consume`,
// `close`) is a statement, not a fallback value (Rust `infer_call_like`:
// `check_call` hands back no type only for these unshadowed builtins; a
// declared function without `->` hands back `Unit`). Name the legal tails of
// this already-braced block rather than recommending braces.
fn sema_fallback_unit_call_name(value: Expr, scopes: SemaScopeTable) -> String? Never! {
    if value == {
        .Paren(inner, _, _) -> sema_fallback_unit_call_name(inner, scopes)
        .Call(call, _) -> {
            if call.name == "close" -> return Val(call.name)
            valueless := call.name == "print" || call.name == "assert" || call.name == "assert_eq" || call.name == "consume"
            if valueless && sema_call_gate_is_unshadowed(call.name, scopes) -> Val(call.name) else -> None
        }
        else -> None
    }
}

// The fallback route of `??`, checked in its own frame on the caller's marked
// scope table; the caller rolls the table back on every path.
fn sema_expression_or_fallback_route(fallback: OrFallback, span: Span, subject_ty: Type, payload: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, fallback_state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaOrFallbackRoute? {
    fallback_payload := payload
    fallback_tir := TOrFallback?{None}
    // copy: `outer_return_type` restores scopes.return_type after the fallback frame, which
    // overwrites it. Jet has no exchange on a field of the write-borrowed `scopes`, so the old
    // value is copied out before it is overwritten.
    outer_return_type :: scopes.return_type.copy()
    outer_loop_depth := scopes.loop_depth
    sema_scope_enter(&scopes, &fallback_state, "or.fallback@{span.start}")
    ambient_err := TLocal?{None}
    if subject_ty == .Result(_, error_type) {
        // Rust `declare_in_scope(AMBIENT_ERR, …)`: the report is declared in
        // this fallback's own frame with none of `declare`'s redefinition
        // checks and no single-use duty, so a nested fallible `??` shadows an
        // enclosing `err` (as the refutable fallback's `err` already does).
        owner :: sema_scope_local_owner_key(scopes)
        symbol :: Symbol{id: symbol_id(SymbolKind.Local, environment.module_identity, owner, "err"), kind: SymbolKind.Local, name: "err", module_name: environment.module_identity, owner: Val(owner), span: span, ty: Val(error_type), visibility: 0}
        frame :: scopes.current
        sema_scope_push_binding(&scopes, SemaScopeBinding{frame: frame, symbol: symbol, mutable: false, access: AccessConvention.Read, integer_bounds: None, string_view: false, compiler_builtin: false})
        sema_ownership_declare_ambient_binding(&fallback_state, symbol)
        ambient_err = Val(checked_symbol_local("err", span, symbol.id))
    }
    fallback_reaches_merge := false
    // copy: `enclosing_err_denial` restores context.fallback_err_denial after this fallback, which
    // overwrites it. Jet has no exchange on a field of the write-borrowed `context`.
    enclosing_err_denial :: context.fallback_err_denial.copy()
    context.fallback_err_denial = sema_fallback_err_denial_for(subject_ty)
    // Ok(None) shares the mixed carrier's fallback but carries no report.
    if subject_ty == .Result(ok, _) && ok == .Option(_) -> context.fallback_err_denial = Val("E0408")
    if fallback == {
        .Value(other) -> {
            fallback_expected :: if payload == (Type.Named{name: "Never"}) -> None else -> Val(payload)
            checked :: sema_check_expression(other, fallback_expected, environment, program, &scopes, &fallback_state, &tail_store, &context, &diagnostics) ?? return None
            fallback_fits := true
            if payload != (Type.Named{name: "Never"}) && checked.ty != (Type.Named{name: "Never"}) -> fallback_fits = sema_expr_expected_assignable(payload, checked.ty, environment, program) ?? return None
            if {
                payload == (Type.Named{name: "Never"}) -> fallback_payload = checked.ty
                checked.ty != (Type.Named{name: "Never"}) && !fallback_fits -> {
                    &diagnostics.push(sema_error("E0405", expr_span(other), "the fallback is {type_name(checked.ty)}, but the success value is {type_name(payload)}", "both sides of `??` must be the same type", "make the fallback produce {type_name(payload)}"))
                    return None
                }
            }
            fallback_tir = Val(TOrFallback.Value{value: checked})
            fallback_reaches_merge = checked.ty != Type.Named{name: "Never"}
        }
        .Block(body, tail, block_span) -> {
            // Rust `parse_or_fallback_block` (binary_unary.rs:229-259): a
            // block with no value line must end in a real exit, which then
            // needs no value of the success payload's type.
            if tail == None {
                last_exits := false
                last_span := Span{start: block_span.end - 1, end: block_span.end}
                seen := 0
                loop statement in body {
                    seen += 1
                    if seen < body.len() -> next
                    last_exits = sema_stmt_refutable_statement_exits(statement)
                    last_span = sema_compiler_index_stmt_span(statement)
                }
                if !last_exits {
                    if body.len() == 0 -> &diagnostics.push(sema_error("E0003", last_span, "a `??` fallback block needs a final value or exit", "a fallback block runs its statements and then produces one value or leaves control", "add a final value or exit, such as `{{ log(err); default_value }}` or `{{ log(err); return }}`")) else -> &diagnostics.push(sema_error("E0114", last_span, "this fallback ends with a statement instead of a value", "a value-expected fallback block must end with one unadorned expression; statements yield unit", "put one unadorned expression last, or use `return ...` for an early exit"))
                    return None
                }
            }
            // The block's own frame is rolled back after it, as its copy was.
            block_mark :: sema_scope_mark(&scopes)
            sema_scope_enter(&scopes, &fallback_state, "or.fallback@{block_span.start}")
            checked_block :: sema_check_statements(body, outer_return_type, environment, program, &scopes, &fallback_state, &tail_store, &context, &diagnostics, outer_loop_depth)
            if !checked_block.complete {
                sema_scope_leave(&scopes, &fallback_state)
                return None
            }
            tail_value := TExpr?{None}
            if tail != None {
                fallback_expected :: if payload == (Type.Named{name: "Never"}) -> None else -> Val(payload)
                tail_value = sema_check_expression(tail, fallback_expected, environment, program, &scopes, &fallback_state, &tail_store, &context, &diagnostics)
                if tail_value == None {
                    sema_scope_leave(&scopes, &fallback_state)
                    return None
                }
                checked_tail :: tail_value ?? return None
                if sema_expr_unwrap_tag(checked_tail.ty) == (Type.Named{name: "Unit"}) && sema_fallback_unit_call_name(tail, scopes) == .Val(call_name) {
                    &diagnostics.push(sema_error("E0116", expr_span(tail), "`{call_name}` doesn't hand back a value", "a `??` fallback block ends with a value or leaves the enclosing function; a call that returns nothing is only a statement", "end the block with `()` after the call, or use `return` to leave the enclosing function"))
                    sema_scope_leave(&scopes, &fallback_state)
                    return None
                }
                if payload == (Type.Named{name: "Never"}) -> fallback_payload = if tail_value == .Val(value) -> value.ty else -> Type.Named{name: "Never"}
            }
            sema_single_use_leave_scope(&scopes, &fallback_state, &diagnostics)
            sema_scope_rollback(&scopes, block_mark)
            if {
                checked_block.value.len() == 0 && tail_value != None -> {
                    fallback_tir = Val(TOrFallback.Value{value: tail_value ?? sema_node(&context, fallback_payload, NodeKind.Unit, block_span)})
                }
                else -> {
                    block_values := checked_block.value
                    if tail_value != None -> &block_values.push(TStmt.ExprStmt{value: tail_value ?? sema_node(&context, fallback_payload, NodeKind.Unit, block_span), span: expr_span(tail ?? Expr.Unit{span: block_span, id: AST_NODE_GENERATED})})
                    fallback_expr :: sema_tir_node(fallback_payload, TExprKind.InlineBlock{body: block_values}, block_span)
                    fallback_tir = Val(TOrFallback.Value{value: fallback_expr})
                }
            }
            // Both block shapes reach the merge unless the body or its tail
            // value diverges.
            fallback_reaches_merge = !sema_stmt_block_has_no_fallthrough(body) && !sema_stmt_refutable_block_exits(body)
            if tail_value == .Val(value) {
                if value.ty == (Type.Named{name: "Never"}) -> fallback_reaches_merge = false
            }
        }
        .Return(return_value, return_span) -> {
            return_type :: outer_return_type
            if return_value == {
                .None -> {
                    if !sema_stmt_return_allows_empty(return_type) {
                        &diagnostics.push(sema_error("E0405", return_span, "`or return` needs a value here", "the enclosing function returns a value on its success route", "write `or return value`"))
                        return None
                    }
                    fallback_tir = Val(TOrFallback.Return{value: None})
                }
                .Val(returned_expr) -> {
                    if !sema_stmt_return_is_carrier(return_type) && sema_stmt_return_success_type(return_type) == (Type.Named{name: "Unit"}) {
                        &diagnostics.push(sema_error("E0405", return_span, "`or return value` cannot return a value from a Unit function", "the enclosing function has no return payload", "use bare `or return` or declare a return type"))
                        return None
                    }
                    checked_return :: sema_stmt_check_return_value(returned_expr, return_type, environment, program, &scopes, &fallback_state, &tail_store, &context, &diagnostics) ?? return None
                    if !sema_stmt_record_return_views(returned_expr, checked_return.ty, scopes, &fallback_state, &context, &diagnostics) -> return None
                    if !sema_stmt_move_direct(returned_expr, &fallback_state, scopes, "`or return`", &diagnostics) -> return None
                    fallback_tir = Val(TOrFallback.Return{value: Val(checked_return)})
                }
            }
        }
        .Panic(name_span, args) -> {
            if args.len() != 1 {
                &diagnostics.push(sema_error("E0103", name_span, "`panic` needs exactly one message", "a panic report needs something to show the user", "write `or panic(\"message\")`"))
                return None
            }
            message :: sema_check_expression(args[0].expr, Val(Type.String), environment, program, &scopes, &fallback_state, &tail_store, &context, &diagnostics) ?? return None
            fallback_tir = Val(TOrFallback.Panic{message: message, location: sema_expression_panic_location(environment, program, scopes, name_span)})
        }
        .Break(route_span) -> {
            if outer_loop_depth <= 0 {
                &diagnostics.push(sema_error("E0405", route_span, "`or break` is only valid inside a loop", "the fallback route must have an enclosing loop to leave", "move this expression into a loop"))
                return None
            }
            fallback_tir = Val(TOrFallback.Break)
        }
        .Continue(route_span) -> {
            if outer_loop_depth <= 0 {
                &diagnostics.push(sema_error("E0405", route_span, "`or continue` is only valid inside a loop", "the fallback route must have an enclosing loop to continue", "move this expression into a loop"))
                return None
            }
            fallback_tir = Val(TOrFallback.Continue)
        }
        .BreakLabel(label, route_span) -> {
            if outer_loop_depth <= 0 || !sema_scope_has_loop_label(scopes, label) {
                &diagnostics.push(sema_error("E0405", route_span, "the `or break` label is not an enclosing loop", "the fallback route must name an active loop label", "use an enclosing loop label"))
                return None
            }
            fallback_tir = Val(TOrFallback.BreakLabel{label: label})
        }
        .ContinueLabel(label, route_span) -> {
            if outer_loop_depth <= 0 || !sema_scope_has_loop_label(scopes, label) {
                return None
            }
            fallback_tir = Val(TOrFallback.ContinueLabel{label: label})
        }
    }
    context.fallback_err_denial = enclosing_err_denial
    sema_single_use_leave_scope(&scopes, &fallback_state, &diagnostics)
    Val(SemaOrFallbackRoute{payload: fallback_payload, value: fallback_tir, reaches_merge: fallback_reaches_merge, ambient_err: ambient_err})
}

// A value-form dispatch table repeats its subject in every arm's test. The
// chain head binds a non-place subject once to a compiler local and checks
// the table against that local, so a call subject and its side effects run
// exactly once.
fn sema_expression_if_dispatch_subject(condition: Expr, else_value: Expr) -> Expr? {
    subject :: sema_expression_if_condition_subject(condition) ?? return None
    if sema_expression_if_subject_is_place(subject) -> return None
    next := else_value
    loop {
        if next == {
            .Paren(inner, _, _) -> next = inner
            .If(next_condition, _, _, _, _, _, _) -> {
                next_subject :: sema_expression_if_condition_subject(next_condition) ?? return None
                return if expr_span(next_subject) == expr_span(subject) -> Val(subject) else -> None
            }
            else -> return None
        }
    }
}

fn sema_expression_if_condition_subject(condition: Expr) -> Expr? {
    return if condition == {
        // copy: `subject` is a payload of read parameter `condition`, which keeps the original; the Val carrier owns this one
        .PatternTest(subject, _, _, _) -> Val(subject.copy())
        .Binary(op, left, right, _, _) -> if {
            op == BinOp.And || op == BinOp.Or -> {
                left_subject :: sema_expression_if_condition_subject(left)
                if left_subject == .Val(subject) -> Val(subject) else -> sema_expression_if_condition_subject(right)
            }
            sema_expression_if_dispatch_comparison(op) -> Val(left)
            else -> None
        }
        .Paren(inner, _, _) -> sema_expression_if_condition_subject(inner)
        else -> None
    }
}

fn sema_expression_if_dispatch_comparison(op: BinOp) -> Bool {
    op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge
}

// A local or field path reads the same value in every arm and runs nothing;
// so does a `&path` window over one, which every arm then matches in place.
fn sema_expression_if_subject_is_place(subject: Expr) -> Bool {
    return if subject == {
        .Ident(_, _, _) -> true
        .Field(base, _, _, _) | .Copy(base, _, _) | .Paren(base, _, _) -> sema_expression_if_subject_is_place(base)
        .Place(base, access, _, _) -> access != PlaceAccess.Take && sema_expression_if_subject_is_place(base)
        else -> false
    }
}

fn sema_expression_if_condition_consumes_carrier(condition: Expr) -> Bool {
    return if condition == {
        .PatternTest(_, pattern, _, _) -> sema_pattern_consumes_result_carrier(pattern)
        .Binary(op, left, right, _, _) -> (op == BinOp.And || op == BinOp.Or) && (sema_expression_if_condition_consumes_carrier(left) || sema_expression_if_condition_consumes_carrier(right))
        .Paren(inner, _, _) -> sema_expression_if_condition_consumes_carrier(inner)
        else -> false
    }
}

fn sema_expression_if_replace_subject(condition: Expr, subject_span: Span, local: Expr) -> Expr {
    return if condition == {
        // copy: `pattern` is a payload of read parameter `condition`, which keeps the original; field `pattern` of the new Expr.PatternTest owns this one
        .PatternTest(subject, pattern, span, node) -> if expr_span(subject) == subject_span -> Expr.PatternTest{subject: local, pattern: pattern.copy(), span: span, id: node} else -> condition
        .Binary(op, left, right, span, node) -> if {
            op == BinOp.And || op == BinOp.Or -> Expr.Binary{op: op, left: sema_expression_if_replace_subject(left, subject_span, local), right: sema_expression_if_replace_subject(right, subject_span, local), span: span, id: node}
            sema_expression_if_dispatch_comparison(op) && expr_span(left) == subject_span -> Expr.Binary{op: op, left: local, right: right, span: span, id: node}
            else -> condition
        }
        .Paren(inner, span, node) -> Expr.Paren{value: sema_expression_if_replace_subject(inner, subject_span, local), span: span, id: node}
        else -> condition
    }
}

// Every arm of the chain that tests the hoisted subject reads the local.
fn sema_expression_if_rebind_chain(value: Expr, subject_span: Span, local: Expr) -> Expr {
    return if value == {
        .Paren(inner, _, _) -> sema_expression_if_rebind_chain(inner, subject_span, local)
        .If(condition, then_body, then_value, else_body, else_value, span, node) -> {
            subject :: sema_expression_if_condition_subject(condition) ?? return value
            // copy: the rebound chain is a new owned Expr. When the subject span differs it equals
            // `value`, the caller's condition (a read parameter), which the caller keeps in its
            // AST.
            if expr_span(subject) != subject_span -> return value.copy()
            Expr.If{cond: sema_expression_if_replace_subject(condition, subject_span, local), then_body: then_body, then_value: then_value, else_body: else_body, else_value: sema_expression_if_rebind_chain(else_value, subject_span, local), span: span, id: node}
        }
        else -> value
    }
}

fn sema_expression_if_chain_consumes_carrier(value: Expr, subject_span: Span) -> Bool {
    return if value == {
        .Paren(inner, _, _) -> sema_expression_if_chain_consumes_carrier(inner, subject_span)
        .If(condition, _, _, _, else_value, _, _) -> {
            subject :: sema_expression_if_condition_subject(condition) ?? return false
            if expr_span(subject) != subject_span -> return false
            sema_expression_if_condition_consumes_carrier(condition) || sema_expression_if_chain_consumes_carrier(else_value, subject_span)
        }
        else -> false
    }
}

// Check a hoisted dispatch subject once and bind it to the compiler local
// that the rebound chain reads. The value form and the statement form share it.
fn sema_expression_if_bind_subject(subject: Expr, condition: Expr, else_value: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TStmt? {
    subject_span :: expr_span(subject)
    carrier :: sema_expression_if_condition_consumes_carrier(condition) || sema_expression_if_chain_consumes_carrier(else_value, subject_span)
    checked_subject :: if carrier -> sema_check_expression_carrier(subject, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(subject, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    init :: checked_subject ?? return None
    name :: sema_expression_if_subject_local_name(subject)
    owner :: sema_scope_local_owner_key(scopes)
    id :: symbol_id(SymbolKind.Local, environment.module_identity, owner, name)
    symbol :: Symbol{id: id, kind: SymbolKind.Local, name: name, module_name: environment.module_identity, owner: Val(owner), span: subject_span, ty: Val(init.ty), visibility: 0}
    // (#3974): a hoisted `&place` subject aliases its place, so
    // the arm patterns that test it bind write windows.
    window :: if init.kind == {
        .Borrow(_, access) -> access == AccessConvention.Write
        else -> false
    }
    bounds :: tir_expr_known_bounds(init)
    _ := sema_scope_declare_local(&scopes, symbol, window, if window -> AccessConvention.Write else -> AccessConvention.Read, bounds, false)
    sema_ownership_declare_binding(&state, symbol, false)
    _ := sema_ownership_record_pattern_views(&state, name, subject_span, [Expr]{subject}, if window -> AccessConvention.Write else -> AccessConvention.Read, scopes)
    local := checked_symbol_local(name, subject_span, id)
    local.generated = true
    local.integer_bounds = bounds
    Val(TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: init, gc_promotion: None, gc_transferred: false, span: subject_span})
}

fn sema_expression_if_subject_local_name(subject: Expr) -> String {
    "__jet_switch_subject_{expr_span(subject).start}"
}

// A pattern binding a checked condition introduces into its success branch.
struct SemaConditionBinding {
    symbol: Symbol
    // Borrowed payloads alias storage; only `&place` grants write access.
    window: Bool
    sources: [Expr]
}

// A checked `if`/arm condition: the TIR condition, its Bool value for
// coverage, and the pattern bindings its success branch declares.
struct SemaCheckedCondition {
    condition: TIfCond
    value: TExpr
    bindings: [SemaConditionBinding]
}

// A condition check: the checked condition when it checked, and the bindings
// its success branch declares either way. A pattern test that reported its
// own error still names its bindings, so the branch does not cascade into
// E0107 for them.
struct SemaConditionCheck {
    checked: SemaCheckedCondition?
    bindings: [SemaConditionBinding]
}

fn sema_expression_condition_checked(checked: SemaCheckedCondition) -> SemaConditionCheck Never! {
    SemaConditionCheck{checked: Val(checked), bindings: checked.bindings}
}

fn sema_expression_condition_failed(bindings: [SemaConditionBinding]) -> SemaConditionCheck Never! {
    SemaConditionCheck{checked: None, bindings: bindings}
}

// Whether a condition tests a pattern at its top level or along a `&&` chain,
// so its success branch may see pattern bindings.
fn sema_expression_condition_binds(condition: Expr) -> Bool Never! {
    return if condition == {
        .PatternTest(_, _, _, _) -> true
        .Paren(inner, _, _) -> sema_expression_condition_binds(inner)
        .Binary(op, left, right, _, _) -> op == BinOp.And && (sema_expression_condition_binds(left) || sema_expression_condition_binds(right))
        else -> false
    }
}

// (#3974): the place a pattern subject windows when it is a
// `&place` write window, or the hoisted switch local bound to one.
fn sema_expression_window_source(subject: Expr, scopes: SemaScopeTable) -> Expr? {
    return if subject == {
        .Paren(inner, _, _) -> sema_expression_window_source(inner, scopes)
        // copy: `value` is a payload of read parameter `subject`, which keeps the original; the Val carrier owns this one
        .Place(value, access, _, _) -> if access == PlaceAccess.Write -> Val(value.copy()) else -> None
        .Ident(name, _, _) -> {
            if !name.starts_with("__jet_switch_subject_") -> return None
            index :: sema_scope_resolve_index(scopes, name) ?? return None
            if scopes.bindings[index].access == AccessConvention.Write -> Val(subject) else -> None
        }
        else -> None
    }
}

// Whether a pattern subject is spelled `^place`: the subject itself moves
// into the match, so its payload bindings own what they bind and record no
// subject places (`^name` is an ordinary move of an owned local, never a
// take out of a subject that stays live).
fn sema_expression_subject_moved(subject: Expr) -> Bool Never! {
    return if subject == {
        .Paren(inner, _, _) -> sema_expression_subject_moved(inner)
        .Place(_, access, _, _) -> access == PlaceAccess.Take
        else -> false
    }
}

// Names `pattern` binds as write windows under a `&place` subject. An
// or-pattern's alternatives bind plain read-only values: one name cannot
// alias two different payload slots.
fn sema_expression_window_names(pattern: Pattern, names: &[String]) {
    if pattern == {
        .Present(binding, _, inner, _) | .Ok(binding, _, inner, _) | .Err(binding, _, inner, _) -> {
            if inner == .Val(nested) {
                sema_expression_window_names(nested, &names)
            } else {
                &names.push(binding)
            }
        }
        .Variant(_, slots, _, _) -> {
            loop slot in slots -> sema_expression_window_slot_names(slot, &names)
        }
        .Struct(fields, _, _, _) -> {
            loop field in fields {
                if field == .Bind(_, _, local, _) -> &names.push(local)
                if field == .Nested(_, _, inner) -> sema_expression_window_names(inner, &names)
            }
        }
        else -> {}
    }
}

fn sema_expression_window_slot_names(slot: PatSlot, names: &[String]) {
    if slot == {
        .Bind(name, _) -> &names.push(name)
        .Nested(nested) -> sema_expression_window_names(nested, &names)
        .Named(_, _, inner) -> sema_expression_window_slot_names(inner, &names)
        else -> {}
    }
}

// Use checked slot order, not binding spelling: renaming a payload does not
// change its origin. Carrier payloads retain the existing empty-prefix ABI.
fn sema_expression_pattern_binding_sources(shape: TPatternShape, subject_ty: Type, source: Expr, name: String, environment: SemaScopeEnvironment, program: SemaProgramTables, sources: &[Expr], diagnostics: &[Diagnostic]) {
    if shape == {
        .Variant(variant, slots, _, span) -> {
            payload :: sema_pattern_payload(subject_ty, variant, environment, program, span, &diagnostics)
            variant_source :: Expr.Field{base: source, member: variant, span: span, id: AST_NODE_GENERATED}
            loop (index, slot) in slots {
                field := "{index}"
                if payload.payload == .Val(named_payload) {
                    if named_payload == .Named(fields) && index < fields.len() -> field = fields[index].name
                }
                projected :: Expr.Field{base: variant_source, member: field, span: span, id: AST_NODE_GENERATED}
                ty :: if index < payload.types.len() -> payload.types[index] else -> subject_ty
                sema_expression_pattern_slot_sources(slot, ty, projected, name, environment, program, &sources, &diagnostics)
            }
        }
        .Present(binding, _, inner, _) | .Ok(binding, _, inner, _) | .Err(binding, _, inner, _) -> {
            if inner == .Val(nested) {
                ty :: if sema_pattern_unwrap_tags(subject_ty) == {
                    .Option(payload) -> payload
                    .Result(ok, err) -> if shape == .Err(_, _, _, _) -> err else -> ok
                    else -> subject_ty
                }
                sema_expression_pattern_binding_sources(nested.shape, ty, source, name, environment, program, &sources, &diagnostics)
            } else if binding == name -> &sources.push(source)
        }
        .Struct(fields, _) -> {
            loop field in fields {
                if field == {
                    .Bind(member, local, span) -> if local == name -> &sources.push(Expr.Field{base: source, member: member, span: span, id: AST_NODE_GENERATED})
                    .Nested(member, nested, span) -> {
                        projected :: Expr.Field{base: source, member: member, span: span, id: AST_NODE_GENERATED}
                        if program.registration_graph == .Val(graph) {
                            row :: sema_pattern_nominal_row(graph, environment.module_identity, subject_ty) ?? return
                            nominal :: graph.modules[row.module_index].nominals[row.row]
                            names :: loop parameter in nominal.generic_params -> parameter.name
                            actuals :: sema_pattern_subject_args(subject_ty)
                            ty := subject_ty
                            loop registered in nominal.fields {
                                if registered.symbol.name == member -> ty = sema_inference_substitute_type(registered.ty, names, actuals)
                            }
                            sema_expression_pattern_binding_sources(nested.shape, ty, projected, name, environment, program, &sources, &diagnostics)
                        } else {
                            return
                        }
                    }
                    else -> {}
                }
            }
        }
        .Or(alternatives, _) -> loop alternative in alternatives -> sema_expression_pattern_binding_sources(alternative, subject_ty, source, name, environment, program, &sources, &diagnostics)
        // List/map payload relations conservatively view the entire subject,
        // matching their existing return-provenance convention.
        .List(_, _, _) | .Map(_, _, _) -> &sources.push(source)
        else -> {}
    }
}

fn sema_expression_pattern_slot_sources(slot: TPatternBinding, ty: Type, source: Expr, name: String, environment: SemaScopeEnvironment, program: SemaProgramTables, sources: &[Expr], diagnostics: &[Diagnostic]) {
    if slot == {
        .Bind(binding, _) -> if binding == name -> &sources.push(source)
        .Nested(nested) -> sema_expression_pattern_binding_sources(nested.shape, ty, source, name, environment, program, &sources, &diagnostics)
        else -> {}
    }
}

// One pattern test condition, with payload aliases for the success branch.
fn sema_expression_check_pattern_condition(subject: Expr, pattern: Pattern, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaConditionCheck {
    // An `.Ok`/`.Err` pattern consumes the subject's
    // Result carrier, so its call root must not propagate.
    subject_value :: if sema_pattern_consumes_result_carrier(pattern) -> sema_check_expression_carrier(subject, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(subject, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    checked_subject :: subject_value ?? return sema_expression_condition_failed([SemaConditionBinding]{})
    source :: sema_expression_window_source(subject, scopes)
    window_names := [String]{}
    if source != None -> sema_expression_window_names(pattern, &window_names)
    checked_pattern := sema_check_pattern(checked_subject, pattern, TPatternPosition.Arm, false, false, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    owner :: sema_scope_local_owner_key(scopes)
    checked :: checked_pattern.checked ?? return sema_expression_condition_failed(sema_expression_recovery_condition_bindings(checked_pattern.bindings, window_names, owner, environment))
    facts := [TPatternBindingFact]{}
    bindings := [SemaConditionBinding]{}
    loop fact in checked.bindings {
        updated := fact
        if fact.name != "" && fact.name != "_" {
            window :: window_names.contains(fact.name)
            id :: symbol_id(SymbolKind.Local, environment.module_identity, owner, fact.name)
            updated.symbol_id = Val(id)
            if window -> updated.mutable = true
            symbol :: Symbol{id: id, kind: SymbolKind.Local, name: fact.name, module_name: environment.module_identity, owner: Val(owner), span: fact.span, ty: Val(fact.ty), visibility: 0}
            sources := [Expr]{}
            sema_expression_pattern_binding_sources(checked.pattern.shape, checked_subject.ty, source ?? subject, fact.name, environment, program, &sources, &diagnostics)
            // An explicit `^name` takes this payload out of its subject
            // (sema_ownership_move_pattern_payload) when the subject stays
            // live. A `^subject` moves into the match, so its bindings own
            // their payloads; a list or map pattern names its whole subject,
            // so its bindings record none.
            collection :: if checked.pattern.shape == {
                .List(_, _, _) | .Map(_, _, _) -> true
                else -> false
            }
            // copy: the ownership state keeps the payload's subject places
            // for a later `^name`, while the condition binding keeps them for
            // its view provenance (sema_ownership_record_pattern_views).
            if !window && !collection && !sema_expression_subject_moved(subject) -> sema_ownership_note_pattern_sources(&state, symbol, sources.copy())
            &bindings.push(SemaConditionBinding{symbol: symbol, window: window, sources: sources})
        }
        &facts.push(updated)
    }
    tested := checked.pattern
    tested.bindings = facts
    value :: sema_tir_node(Type.Bool, TExprKind.PatternMatches{subject: checked.subject, pattern: tested}, span)
    sema_expression_condition_checked(SemaCheckedCondition{condition: TIfCond.IfLet{pattern: tested, subj: checked.subject}, value: value, bindings: bindings})
}

// The bindings a failed pattern test still declares: each named recovery
// binding with its recovered type and no payload sources.
fn sema_expression_recovery_condition_bindings(facts: [TPatternBindingFact], window_names: [String], owner: String, environment: SemaScopeEnvironment) -> [SemaConditionBinding] {
    bindings := [SemaConditionBinding]{}
    loop fact in facts {
        if fact.name == "" || fact.name == "_" -> next
        id :: symbol_id(SymbolKind.Local, environment.module_identity, owner, fact.name)
        symbol :: Symbol{id: id, kind: SymbolKind.Local, name: fact.name, module_name: environment.module_identity, owner: Val(owner), span: fact.span, ty: Val(fact.ty), visibility: 0}
        &bindings.push(SemaConditionBinding{symbol: symbol, window: window_names.contains(fact.name), sources: [Expr]{}})
    }
    bindings
}

fn sema_expression_check_condition_inner(condition: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaConditionCheck {
    if condition == {
        .Paren(inner, _, _) -> return sema_expression_check_condition_inner(inner, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        .PatternTest(subject, pattern, span, _) -> return sema_expression_check_pattern_condition(subject, pattern, span, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        .Binary(op, left, right, span, _) -> {
            if op == BinOp.And && sema_expression_condition_binds(condition) {
                left_check :: sema_expression_check_condition_inner(left, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                left_checked :: left_check.checked ?? return left_check
                // The right side of `&&` reads the names the left side bound.
                sema_expression_declare_condition_bindings(left_checked.bindings, &scopes, &state, false, &diagnostics)
                right_check :: sema_expression_check_condition_inner(right, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                bindings := left_checked.bindings
                loop binding in right_check.bindings -> &bindings.push(binding)
                right_checked :: right_check.checked ?? return sema_expression_condition_failed(bindings)
                value :: sema_tir_node(Type.Bool, TExprKind.Binary{op: TBinaryOp.And, overflow: false, line: 0, lhs: left_checked.value, rhs: right_checked.value}, span)
                return sema_expression_condition_checked(SemaCheckedCondition{condition: TIfCond.And{left: left_checked.condition, right: right_checked.condition}, value: value, bindings: bindings})
            }
        }
        else -> {}
    }
    value :: sema_check_expression(condition, Val(Type.Bool), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return sema_expression_condition_failed([SemaConditionBinding]{})
    sema_expression_condition_checked(SemaCheckedCondition{condition: TIfCond.Plain{value: value}, value: value, bindings: [SemaConditionBinding]{}})
}

// Whether `expr` is a bare `None` / `.None`.
fn sema_expression_absent_none(expr: Expr) -> Bool Never! {
    if expr == {
        .Absent(_, _) -> true
        .EnumLit(enum_type, variant, _, args, _, _, _) -> enum_type == "" && variant == "None" && args.len() == 0
        .Paren(inner, _, _) | .Copy(inner, _, _) -> sema_expression_absent_none(inner)
        else -> false
    }
}

fn sema_expression_ident_name(expr: Expr) -> BindName? {
    if expr == {
        .Ident(name, span, _) -> Val(BindName{name: name, span: span, rename: None})
        else -> None
    }
}

// The name and test span of an atomic `x == None` /
// `x == .None` test (Rust `atomic_absent_optional_subject`).
fn sema_expression_absent_optional_test(condition: Expr) -> (name: BindName, span: Span)? {
    if condition == {
        .Binary(op, left, right, span, _) -> {
            if op != BinOp.Eq -> return None
            subject := left
            if !sema_expression_absent_none(right) {
                if !sema_expression_absent_none(left) -> return None
                subject = right
            }
            name :: sema_expression_ident_name(subject) ?? return None
            Val((name: name, span: span))
        }
        .PatternTest(subject, pattern, span, _) -> {
            absent :: if pattern == {
                .Absent(_) -> true
                .Variant(variant, bindings, _, _) -> variant == "None" && bindings.len() == 0
                else -> false
            }
            if !absent -> return None
            name :: sema_expression_ident_name(subject) ?? return None
            Val((name: name, span: span))
        }
        .Paren(inner, _, _) | .Copy(inner, _, _) -> sema_expression_absent_optional_test(inner)
        else -> None
    }
}

// The payload type of a stable Optional, an immutable local or
// parameter of type `T?` that a proven test may refine to `T` (Rust
// `flow_narrowable_optional_inner`).
fn sema_expression_flow_optional_payload(scopes: SemaScopeTable, name: String) -> Type? {
    index :: sema_scope_resolve_index(scopes, name) ?? return None
    binding :: scopes.bindings[index]
    if binding.mutable || (binding.symbol.kind != SymbolKind.Local && binding.symbol.kind != SymbolKind.Parameter) -> return None
    declared :: binding.symbol.ty ?? return None
    if declared == {
        .Option(inner) -> Val(inner)
        else -> None
    }
}

// The S31 presence test `x == .Val(x)`, whose success branch
// holds the payload of the Optional `x` under the same name.
fn sema_expression_presence_test(name: BindName, span: Span) -> Expr Never! {
    Expr.PatternTest{subject: Expr.Ident{name: name.name, span: name.span, id: AST_NODE_GENERATED}, pattern: Pattern.Present{binding: name.name, binding_span: name.span, inner: None, span: span}, span: span, id: AST_NODE_GENERATED}
}

// A stable `x != None` test, alone or along a `&&` chain, reads
// as the presence test `x == .Val(x)` (Rust `rewrite_optional_flow_ne_none`).
// None when the condition has no such test.
fn sema_expression_rewrite_optional_ne_none(condition: Expr, scopes: SemaScopeTable) -> Expr? {
    if condition == {
        .Binary(op, left, right, span, node) -> {
            if op == BinOp.Ne {
                if !sema_expression_absent_none(right) -> return None
                name :: sema_expression_ident_name(left) ?? return None
                if sema_expression_flow_optional_payload(scopes, name.name) == None -> return None
                return Val(sema_expression_presence_test(name, span))
            }
            if op != BinOp.And -> return None
            rewritten_left :: sema_expression_rewrite_optional_ne_none(left, scopes)
            rewritten_right :: sema_expression_rewrite_optional_ne_none(right, scopes)
            if rewritten_left == None && rewritten_right == None -> return None
            Val(Expr.Binary{op: op, left: rewritten_left ?? left, right: rewritten_right ?? right, span: span, id: node})
        }
        .Paren(inner, span, node) -> {
            rewritten :: sema_expression_rewrite_optional_ne_none(inner, scopes) ?? return None
            Val(Expr.Paren{value: rewritten, span: span, id: node})
        }
        else -> None
    }
}

// Checks an `if`/arm condition. A pattern test, alone or along a `&&` chain,
// lowers to an IfLet whose bindings the success branch declares with
// `sema_expression_declare_condition_bindings`. The condition's own frame
// (`pattern@…`) keeps chain bindings out of later arms and fixes their
// symbol identities for the branch.
fn sema_expression_check_condition(condition: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaConditionCheck {
    rewritten :: sema_expression_rewrite_optional_ne_none(condition, scopes)
    if rewritten == .Val(presence) -> return sema_expression_check_condition(presence, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    if !sema_expression_condition_binds(condition) -> return sema_expression_check_condition_inner(condition, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    _ := sema_scope_enter(&scopes, &state, "pattern@{expr_span(condition).start}")
    checked := sema_expression_check_condition_inner(condition, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    sema_scope_leave(&scopes, &state)
    checked
}

// Declares a condition's pattern bindings into its success branch. A write
// window carries the write capability of a write parameter, so edits through
// it (and `&binding.field` passes onward) reach the owner's storage, and it
// holds a write view on its subject place while live. `track` is false for
// the in-condition declaration a `&&` chain reads, which the branch repeats.
fn sema_expression_declare_condition_bindings(bindings: [SemaConditionBinding], scopes: &SemaScopeTable, state: &SemaOwnershipState, track: Bool, diagnostics: &[Diagnostic]) {
    loop binding in bindings {
        access :: if binding.window -> AccessConvention.Write else -> AccessConvention.Read
        if !sema_scope_declare_local(&scopes, binding.symbol, binding.window, access, None, false) {
            if binding.window || !sema_expression_refines_optional(scopes, binding.symbol) {
                if track -> &diagnostics.push(sema_already_defined(binding.symbol.name, binding.symbol.span))
                next
            }
            // `x == .Val(x)` over a stable Optional refines
            // `x` to its payload (Rust `declare_condition_binding`).
            sema_scope_refine_local(&scopes, binding.symbol)
        }
        if track -> sema_ownership_declare_binding(&state, binding.symbol, false)
        // Also track the temporary `&&` bindings: later tests must resolve
        // their payload origin and reborrow ancestry, not a new local owner.
        _ := sema_ownership_record_pattern_views(&state, binding.symbol.name, binding.symbol.span, binding.sources, access, scopes)
    }
}

// A payload binding that shadows the stable Optional it was
// tested from refines that name (Rust `is_optional_flow_refine`).
fn sema_expression_refines_optional(scopes: SemaScopeTable, symbol: Symbol) -> Bool {
    payload :: sema_expression_flow_optional_payload(scopes, symbol.name) ?? return false
    bound :: symbol.ty ?? return false
    type_identity_equal(payload, bound)
}

// The condition with the hoisted subject replaced by its local.
fn sema_expression_if_rebound_condition(subject: Expr, condition: Expr) -> Expr {
    sema_expression_if_replace_subject(condition, expr_span(subject), Expr.Ident{name: sema_expression_if_subject_local_name(subject), span: expr_span(subject), id: AST_NODE_GENERATED})
}

// The rest of the chain with every arm that tests the hoisted subject reading its local.
fn sema_expression_if_rebound_chain(subject: Expr, else_value: Expr) -> Expr {
    sema_expression_if_rebind_chain(else_value, expr_span(subject), Expr.Ident{name: sema_expression_if_subject_local_name(subject), span: expr_span(subject), id: AST_NODE_GENERATED})
}

fn sema_expression_if_hoisted(subject: Expr, condition: Expr, then_body: [Stmt], then_value: Expr, else_body: [Stmt], else_value: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    binding :: sema_expression_if_bind_subject(subject, condition, else_value, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    table :: sema_expression_if(sema_expression_if_rebound_condition(subject, condition), then_body, then_value, else_body, sema_expression_if_rebound_chain(subject, else_value), span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    Val(sema_tir_node(table.ty, TExprKind.InlineBlock{body: [TStmt]{binding, TStmt.ExprStmt{value: table, span: span}}}, span))
}

// A multi-arm table (`if x == { None -> a  Val(v) -> b }`) reads as an `if`
// chain whose next level tests the same name again. Rust checks such a table
// as one switch over the declared type, so the `None` arm does not narrow
// `x` for the arms after it; only a two-way `if x == None` swaps.
fn sema_expression_if_continues_dispatch(else_value: Expr, name: String) -> Bool Never! {
    if else_value == .If(next_condition, _, _, _, _, _, _) {
        if sema_expression_if_condition_subject(next_condition) == .Val(subject) {
            if subject == .Ident(subject_name, _, _) -> return subject_name == name
        }
    }
    false
}

// Whether a stable `x == None` level swaps into the presence
// test. The last arm of an else-less table (`else_value` is `NoElse`) never
// does: Rust checks the table as one switch, the swapped payload branch would
// be the empty `NoElse`, and the table's E0307 coverage would then read the
// `None` arm as `.Val` and report `None` missing.
fn sema_expression_if_absent_test_swaps(else_value: Expr, name: String) -> Bool Never! {
    if else_value == .NoElse(_, _) -> return false
    !sema_expression_if_continues_dispatch(else_value, name)
}

fn sema_expression_if(condition: Expr, then_body: [Stmt], then_value: Expr, else_body: [Stmt], else_value: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    dispatch_subject :: sema_expression_if_dispatch_subject(condition, else_value)
    if dispatch_subject == .Val(subject) -> return sema_expression_if_hoisted(subject, condition, then_body, then_value, else_body, else_value, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    // A stable `x == None` test reads as the presence test
    // with the branches swapped, so the other branch holds the payload (Rust
    // value `if`). Source order of evaluation is unchanged.
    if sema_expression_absent_optional_test(condition) == .Val(test) {
        if sema_expression_flow_optional_payload(scopes, test.name.name) != None && sema_expression_if_absent_test_swaps(else_value, test.name.name) -> return sema_expression_if(sema_expression_presence_test(test.name, test.span), else_body, else_value, then_body, then_value, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    // Card #1440 / E0307: the outermost level of an else-less dispatch chain
    // proves coverage once, after every nested level has been checked.
    chain_head :: sema_coverage_is_noelse_chain(else_body, else_value, span) && !context.noelse_chain_starts.contains(span.start)
    if chain_head -> &context.noelse_chain_starts.push(span.start)
    // L0303 (#3716): the outermost level of a table with an `else` arm checks
    // whether that arm can ever run.
    else_table_head :: !chain_head && !context.noelse_chain_starts.contains(span.start) && sema_coverage_is_else_table(environment, program, span)
    if else_table_head -> &context.noelse_chain_starts.push(span.start)
    checked :: sema_expression_check_condition(condition, environment, program, &scopes, &state, &tail_store, &context, &diagnostics).checked ?? return None
    checked_condition :: checked.value
    // Each arm runs in its own frame on the live scope table and on the live
    // ownership state, both rolled back (sema_ownership_fork). Only a deferred
    // bare `None` then-value, checked after the else arm, keeps a copy of the
    // then-arm table and state.
    fork :: sema_ownership_fork(&state)
    then_mark :: sema_scope_mark(&scopes)
    sema_scope_enter(&scopes, &state, "if.then@{span.start}")
    sema_expression_declare_condition_bindings(checked.bindings, &scopes, &state, true, &diagnostics)
    then_result :: sema_check_statements(then_body, then_mark.saved.return_type, environment, program, &scopes, &state, &tail_store, &context, &diagnostics, then_mark.saved.loop_depth)
    if !then_result.complete {
        sema_scope_leave(&scopes, &state)
        sema_scope_rollback(&scopes, then_mark)
        found_sites :: state.share_found.copy()
        sema_ownership_fork_drop(&state, fork, found_sites, [SemaOwnershipShareSite]{})
        return None
    }
    // Owner rule (bare `None`): without an optional expected type, a bare
    // `None` arm takes its optional type from the sibling arm of the same
    // value-if or match. A leading `None` arm waits for the else arm's type.
    sibling_rule :: !sema_expression_expects_optional(expected)
    // Arm-result unification an uncontextual Err arm adopts
    // a fallible sibling's carrier in either order. Keep only that sibling
    // root from propagating; its nested calls still propagate normally.
    // The paired root-26 corpus also covers deferred payload moves/scopes.
    defer_then_err :: expected == None && sema_expression_uncontextual_err_arm(then_value, scopes)
    defer_then :: defer_then_err || (sibling_rule && sema_expression_bare_absent_arm(then_value, false))
    then_first := TExpr?{None}
    deferred_then_scopes := sema_scope_init("")
    deferred_then_state := sema_ownership_state_init()
    then_path := sema_ownership_fork_base(fork)
    // The then-arm scope exit (its table is gone, so only the ownership side
    // of sema_single_use_leave_scope remains); reported after the else arm.
    then_end_diagnostics := [Diagnostic]{}
    if defer_then {
        deferred_then_scopes = sema_scope_snapshot(scopes)
        deferred_then_state = sema_ownership_state_snapshot(state)
    } else {
        carrier_sibling :: expected == None && sema_expression_uncontextual_err_arm(else_value, scopes)
        first_value :: if carrier_sibling -> sema_check_expression_carrier(then_value, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(then_value, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        first :: first_value ?? {
            sema_scope_leave(&scopes, &state)
            sema_scope_rollback(&scopes, then_mark)
            found_sites :: state.share_found.copy()
            sema_ownership_fork_drop(&state, fork, found_sites, [SemaOwnershipShareSite]{})
            return None
        }
        then_first = Val(first)
        sema_single_use_check_scope_end(state, &then_end_diagnostics)
        sema_ownership_leave_scope(&state)
        then_path = sema_ownership_fork_path(state, fork)
    }
    sema_scope_rollback(&scopes, then_mark)
    sema_ownership_fork_rollback(&state, fork)
    then_found :: if defer_then -> deferred_then_state.share_found else -> then_path.share_found

    else_mark :: sema_scope_mark(&scopes)
    sema_scope_enter(&scopes, &state, "if.else@{span.start}")
    else_result :: sema_check_statements(else_body, else_mark.saved.return_type, environment, program, &scopes, &state, &tail_store, &context, &diagnostics, else_mark.saved.loop_depth)
    if !else_result.complete {
        sema_scope_leave(&scopes, &state)
        sema_scope_rollback(&scopes, else_mark)
        else_found :: state.share_found.copy()
        sema_ownership_fork_drop(&state, fork, then_found, else_found)
        return None
    }
    // Decision-table continuations retain a live optional sibling even when
    // a later error arm diverges instead of producing an optional value.
    optional_continuation :: if else_value == .If(_, _, _, _, _, _, _) -> true else -> sema_expression_bare_absent_arm(else_value, true)
    sibling_expected :: sema_expression_absent_sibling(then_first)
    else_expected :: if {
        sibling_rule && optional_continuation && sibling_expected != None -> Val(sibling_expected)
        expected == None && sema_expression_uncontextual_err_arm(else_value, scopes) -> sema_expression_err_sibling(then_first)
        else -> expected
    }
    else_value_checked :: if defer_then_err -> sema_check_expression_carrier(else_value, else_expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(else_value, else_expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    else_checked :: else_value_checked ?? {
        sema_scope_leave(&scopes, &state)
        sema_scope_rollback(&scopes, else_mark)
        else_found :: state.share_found.copy()
        sema_ownership_fork_drop(&state, fork, then_found, else_found)
        return None
    }
    else_reaches_merge :: !sema_stmt_block_has_no_fallthrough(else_body) && else_checked.ty != Type.Named{name: "Never"}
    sema_single_use_leave_scope(&scopes, &state, &diagnostics)
    sema_scope_rollback(&scopes, else_mark)
    else_path :: sema_ownership_fork_path(state, fork)
    sema_ownership_fork_rollback(&state, fork)

    then_checked :: then_first ?? {
        deferred_expected :: if defer_then_err -> sema_expression_err_sibling(Val(else_checked)) else -> sema_expression_absent_sibling(Val(else_checked))
        sema_check_expression(then_value, deferred_expected, environment, program, &deferred_then_scopes, &deferred_then_state, &tail_store, &context, &diagnostics) ?? {
            sema_scope_leave(&deferred_then_scopes, &deferred_then_state)
            sema_ownership_fork_drop(&state, fork, deferred_then_state.share_found, else_path.share_found)
            return None
        }
    }
    then_reaches_merge :: !sema_stmt_block_has_no_fallthrough(then_body) && then_checked.ty != Type.Named{name: "Never"}
    if defer_then {
        sema_single_use_check_scope_end(deferred_then_state, &diagnostics)
        sema_ownership_leave_scope(&deferred_then_state)
        then_path = sema_ownership_fork_path(deferred_then_state, fork)
    } else {
        loop diagnostic in then_end_diagnostics -> &diagnostics.push(diagnostic)
    }
    // The single-use check reads the state before the `if`, which the
    // rollback left live; the join and share notes report nothing.
    single_use_paths := [SemaOwnershipPath]{}
    if then_reaches_merge -> &single_use_paths.push(then_path)
    if else_reaches_merge -> &single_use_paths.push(else_path)
    sema_single_use_check_paths(state, single_use_paths, &diagnostics)
    base :: sema_ownership_fork_base(fork)
    joined :: if {
        then_reaches_merge && else_reaches_merge -> sema_ownership_path_join(state, fork, then_path, else_path, true, state.share_found)
        then_reaches_merge -> sema_ownership_path_join(state, fork, then_path, base, false, state.share_found)
        else_reaches_merge -> sema_ownership_path_join(state, fork, else_path, base, false, state.share_found)
        else -> sema_ownership_path_join(state, fork, base, base, false, state.share_found)
    }
    sema_ownership_fork_apply(&state, joined)
    sema_ownership_fork_close(&state, fork)
    // A share site found on an arm that leaves is still found.
    loop site in then_path.share_found -> sema_ownership_note_share_found(&state, site)
    loop site in else_path.share_found -> sema_ownership_note_share_found(&state, site)
    joined_then := then_checked
    joined_else := else_checked
    result_ty :: if {
        then_reaches_merge && else_reaches_merge -> if {
            sema_expression_nominal_identity(then_checked.ty, else_checked.ty, environment, program) -> then_checked.ty
            else -> {
                // A decision table in a fallible context mixes `Ok`/`Err`
                // arms with plain success values; the plain side lifts into
                // the expected carrier through the one `Ok` constructor.
                if sema_expression_if_carrier(expected, then_checked.ty, else_checked.ty) == {
                    .Val(carrier) -> {
                        joined_then = sema_expression_lift_into_carrier(then_checked, carrier)
                        joined_else = sema_expression_lift_into_carrier(else_checked, carrier)
                        carrier
                    }
                    .None -> {
                        // Two numeric producers follow the one widening law, as
                        // an operator's operands do.
                        numeric :: sema_expr_numeric_join(then_checked.ty, else_checked.ty) ?? {
                            &diagnostics.push(sema_error("E0124", span, "this `if` has branches with different types", "a value-producing `if` must agree on one type at its merge point", "make both branches produce the same type"))
                            return None
                        }
                        line :: sema_source_line_at(environment.source_segments, span) ?? 0
                        joined_then = sema_expr_numeric_literal_conversion(then_checked, numeric, then_checked.span, line, &diagnostics) ?? return None
                        joined_else = sema_expr_numeric_literal_conversion(else_checked, numeric, else_checked.span, line, &diagnostics) ?? return None
                        numeric
                    }
                }
            }
        }
        then_reaches_merge -> then_checked.ty
        else_reaches_merge -> else_checked.ty
        else -> expected ?? Type.Named{name: "Never"}
    }
    if chain_head {
        chain_conditions :: sema_coverage_noelse_chain_conditions(checked_condition, else_checked, span, context)
        if chain_conditions == .Val(table) {
            sema_coverage_check_unreachable_arms(table, false, &diagnostics)
            sema_coverage_check_table(table, false, span, environment, program, &diagnostics)
        }
    }
    if else_table_head -> sema_coverage_check_redundant_else(sema_coverage_else_chain_conditions(checked_condition, else_checked, span), span, environment, program, &diagnostics)
    value :: sema_tir_node(result_ty, TExprKind.IfExpr{cond: checked.condition, then_body: then_result.value, then_value: joined_then, else_body: else_result.value, else_value: joined_else}, span)
    sema_expr_expected(value, expected, environment, program, &diagnostics)
}

// Rust `nominal_type_identity`: two spellings of one declared type (the
// written `Kind` and the canonical `module::Kind` a resolved type carries)
// are the same type at a merge.
fn sema_expression_nominal_identity(left: Type, right: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if type_identity_equal(left, right) -> return true
    type_identity_equal(sema_expr_expected_type(left, environment, program), sema_expr_expected_type(right, environment, program))
}

// The expected `T E!` carrier when one branch already produces it and the
// other produces its plain success type `T`.
fn sema_expression_if_carrier(expected: Type?, then_ty: Type, else_ty: Type) -> Type? {
    carrier :: expected ?? return None
    if carrier == {
        .Result(ok, _) -> {
            then_fits :: type_identity_equal(then_ty, carrier) || type_identity_equal(then_ty, ok)
            else_fits :: type_identity_equal(else_ty, carrier) || type_identity_equal(else_ty, ok)
            if then_fits && else_fits -> return Val(carrier)
            None
        }
        else -> None
    }
}

fn sema_expression_lift_into_carrier(value: TExpr, carrier: Type) -> TExpr {
    // copy: the lifted value is a new owned TExpr. When the carrier already matches it equals
    // `value`, the caller's checked operand (a read parameter), which the caller keeps.
    if type_identity_equal(value.ty, carrier) -> return value.copy()
    sema_tir_node(carrier, TExprKind.Ok{value: value}, value.span)
}

fn sema_expression_compare_chain(operands: [Expr], ops: [BinOp], hooks: [Bool], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if operands.len() == 0 || ops.len() + 1 != operands.len() {
        &diagnostics.push(sema_error("E0109", span, "a comparison chain needs one operator between each pair of operands", "each comparison joins two neighboring values", "write a complete comparison expression"))
        return None
    }
    checked := [TExpr]{}
    loop operand in operands {
        value :: sema_check_expression(operand, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        &checked.push(value)
    }
    line :: sema_source_line_at(environment.source_segments, span) ?? return None
    tir_ops := [TBinaryOp]{}
    loop (index, op) in ops {
        if op == BinOp.And || op == BinOp.Or || op == BinOp.Compare {
            &diagnostics.push(sema_error("E0109", expr_span(operands[index + 1]), "this operator cannot join a comparison chain", "a chain combines ordered or equality comparisons", "use a separate boolean expression"))
            return None
        }
        pair := sema_comparability_check_binary(op, checked[index], checked[index + 1], expr_span(operands[index + 1]), line, environment, program, &diagnostics)
        if {
            pair.handled -> {
                if pair.value == None -> return None
            }
            else -> {
                _ :: sema_expr_binary_type(op, checked[index].ty, checked[index + 1].ty, expr_span(operands[index + 1]), &diagnostics) ?? return None
            }
        }
        &tir_ops.push(sema_expr_tir_binary_op(op))
    }
    value :: sema_tir_node(Type.Bool, TExprKind.CompareChain{operands: checked, operators: tir_ops, hooks: hooks}, span)
    sema_expr_expected(value, expected, environment, program, &diagnostics)
}
