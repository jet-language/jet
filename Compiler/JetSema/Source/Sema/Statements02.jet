// Private continuation of Sema.Statements: binding admission and destructuring.
// Existing sema_stmt_check_binding/prepared_binding/destructure remain canonical
// TIR owners; the Rust admission paths below supply their missing checker logic.
use jet_foundation.[Binding, BindPattern, Expr, Type, Span, Diagnostic, Severity, AccessConvention, PlaceAccess, expr_span, AMBIENT_ERR, SIGIL_BIND_MUT, SIGIL_BIND_IMMUT, SIGIL_COPY, INTERNAL_UNIT_TYPE, TYPE_TASKGROUP, numeric_conversion_source, conversion_method_for_source, span_line_col, is_money_like_name]
use jet_sema.Sema.[Checker, LocalInfo, ViewAccess]
use jet_sema.Sema.FlowFacts.[PathStringFact, OriginFact]
use jet_sema.Sema.Diagnostics.[expr_root_ident, type_is_copy, inline_range_runtime_conversion, contains_expiring_secret_loan, is_clock_type, is_deterministic_clock_type, is_system_clock_type, typed_text_mismatch]
use jet_sema.Sema.CheckerOwnership.[l1101_unjoined_task, e0140_discarded_wildcard]
use jet_sema.Sema.CheckerInfer.[is_reactive_handle_ty]
use jet_sema.Sema.Statements.[field_read_to_clone, direct_fixed_constructor, type_fix_hint, contains_taskgroup, is_task_type, interrupt_callback_name, interrupt_callback_lambda]
use jet_comptime.[check_build_time_io, evaluate_owned_with_imports_opts_collecting_items, CtValue]

// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:1519
pub fn check_binding(self: &Checker, b: &Binding) {
    if b.meta == .Val(meta) -> self.check_meta_attr(&meta)
    if b.name == AMBIENT_ERR {
        &self.diags.push(Diagnostic.lint("L0511", "binding `err` shadows the fallback's ambient failure report", "`err` has a special meaning inside a fallible `??` fallback, so the same name is easy to misread as the report there", "rename the binding, or use it outside a fallback", Val(b.name_span)))
    }
    prev_binding_name :: self.current_binding_name.take()
    self.current_binding_name = Val(~b.name)
    if b.pattern == .Val(.Refutable(..)) {
        self.check_refutable_binding(&b)
        self.current_binding_name = ^prev_binding_name
        return
    }
    if b.pattern.is_some() {
        check_destructuring_binding(&self, &b)
        self.current_binding_name = ^prev_binding_name
        return
    }
    if b.uninit {
        self.check_uninit_binding(&b)
        self.current_binding_name = ^prev_binding_name
        return
    }
    annot_valid := true
    // An enclosing tail's expectation never flows into an unannotated local.
    saved_expected :: self.expected_type.take()
    if b.ty == .Val(ty) && b.ty_span == .Val(span) {
        resolved :: self.resolve_type(~ty)
        ty = ~resolved
        self.expected_type = Val(~resolved)
        before :: self.diags.len()
        self.check_declared_type(resolved, span)
        if self.diags.len() > before -> annot_valid = false
    }
    if !b.mutable && b.init == .Ident(name, name_span) {
        if self.lookup(name) == .Val(info) {
            if !info.ty.is_scalar() && (info.param_conv == Val(AccessConvention.Read) || info.param_conv == Val(AccessConvention.Write)) {
                source_ty :: ~info.ty
                sigil :: if b.mutable -> SIGIL_BIND_MUT else -> SIGIL_BIND_IMMUT
                diagnostic :: Diagnostic.error("E0120", "`{name}` was not moved here, so it cannot be taken with the move marker `^`", "this function has read access only and does not own the value", "copy it instead: `{b.name} {sigil} {SIGIL_COPY}{name}`", Val(name_span))
                &self.diags.push(self.with_ownership_copy_edit(diagnostic, name_span, Val(source_ty)))
            }
        }
    }
    saved_esc :: self.lambda_escapes
    saved_bind :: ~self.lambda_binding
    if b.init == .Lambda(lambda) {
        self.lambda_escapes = self.bound_lambda_escapes(b.name, lambda)
        self.lambda_binding = Val(~b.name)
    }
    if b.is_comptime -> self.in_comptime = true
    borrowed_param_place :: expr_root_ident(b.init).is_some_and(root -> self.lookup(root).is_some_and(info ->
        (info.param_conv == Val(AccessConvention.Read) || info.param_conv == Val(AccessConvention.Write)) && !self.type_contains_shared(info.ty)))
    // Copy fields/names have no live storage loan; range indices remain windows.
    copy_field_read :: if b.init == {
        .Field(..) -> self.compound_expr_type(b.init).is_some_and(type_is_copy)
        .Ident(name, _) -> self.lookup(name).is_some_and(info -> type_is_copy(info.ty))
        _ -> false
    }
    explicit_copy_or_place :: if b.init == {
        .Copy(..) | .Place(..) -> true
        _ -> false
    }
    if !b.mutable && !copy_field_read && !explicit_copy_or_place
        && self.place_from_expr(b.init).is_some()
        && (borrowed_param_place || !field_read_to_clone(b.init, self.registry, self.imports)) {
        span :: expr_span(b.init)
        inner :: b.init.replace(Expr.Absent{span: span})
        b.init = Expr.Place{value: ^inner, access: PlaceAccess.Read, span: span}
    }
    if !b.mutable && b.init == .OrFallback(value, ..) {
        projection :: if value == {
            .Field(..) | .Index(..) -> true
            _ -> false
        }
        borrowed_view :: projection && expr_root_ident(value).is_some_and(root -> self.lookup(root).is_some_and(info ->
            (info.param_conv == Val(AccessConvention.Read) || info.param_conv == Val(AccessConvention.Write)) && !self.type_contains_shared(info.ty))) && self.place_from_expr(value).is_some()
        if borrowed_view {
            span :: expr_span(value)
            inner :: value.replace(Expr.Absent{span: span})
            value = Expr.Place{value: ^inner, access: PlaceAccess.Read, span: span}
        }
    }
    saved_fixed_constructor :: self.allow_fixed_constructor
    self.allow_fixed_constructor = direct_fixed_constructor(b.init)
    if b.init == .CallValue(callee, ..) && callee == .Lambda(lambda) {
        if lambda.meta.result_loop || lambda.meta.collecting_loop -> lambda.meta.loop_label = Val((~b.name, b.name_span))
    }
    arena_alloc_source := self.arena_alloc_source(b.init)
    diagnostics_before_init :: self.diags.len()
    invalid_reads_before_init :: self.invalid_binding_reads
    explicit_init :: if b.init == {
        .Copy(..) | .Place(..) -> true
        _ -> false
    }
    implicit_field_read :: !b.mutable && !explicit_init && field_read_to_clone(b.init, self.registry, self.imports)
    saved_borrow_ctx :: self.borrow_ctx
    if implicit_field_read -> self.borrow_ctx = true
    distinct_range_constructor :: if b.init == {
        .MethodCall(receiver, method, _, _, _, args, ..) -> args.len() == 1 && numeric_conversion_source(method).is_some() && (if receiver == {
            .Ident(type_name, _) -> self.registry.distinct_range(type_name).is_some()
            _ -> false
        })
        _ -> false
    }
    if_initializer :: if b.init.without_parens() == {
        .If(..) -> true
        _ -> false
    }
    view_annotation :: if b.ty == {
        .Val(.Apply(name, _)) -> name == "View" || name == "ViewMut"
        _ -> false
    }
    owning_if_value :: if_initializer && !view_annotation
    it := if distinct_range_constructor -> self.infer_without_auto_propagation(&b.init)
        else if b.mutable || owning_if_value -> self.infer_owning_value(&b.init)
        else -> self.infer(&b.init)
    self.borrow_ctx = saved_borrow_ctx
    arena_alloc_source = arena_alloc_source.or_else(() -> self.arena_alloc_source(b.init))
    if implicit_field_read && it.is_some_and(ty -> self.is_cloneable_type(ty)) {
        span :: expr_span(b.init)
        inner :: b.init.replace(Expr.Absent{span: span})
        b.init = Expr.Copy{value: ^inner, span: span}
    }
    init_has_error :: self.diags[diagnostics_before_init..<self.diags.len()].any(diagnostic -> diagnostic.severity == Severity.Error)
    self.allow_fixed_constructor = saved_fixed_constructor
    if it == .Val(.Result(ok, _)) && b.init == .MethodCall(receiver, method, _, _, _, args, ..) {
        if ok == .Named(type_name) {
            same_receiver :: if receiver == {
                .Ident(name, _) -> name == type_name
                _ -> false
            }
            if self.registry.distinct_range(type_name).is_some() && same_receiver && numeric_conversion_source(method).is_some() && args.len() == 1 {
                &self.diags.push(Diagnostic.error("E0136", "making a `{type_name}` from a runtime value can fail", "only a literal is checked at compile time; a runtime number needs the fallible form so a bad value is handled", "write `{type_name}.{method}(raw)?` and handle the failure", Val(expr_span(args[0].expr))))
                it = Val(Type.Named{name: ~type_name})
            }
        }
    }
    inline_target :: if it == {
        .Val(.Result(ok, _)) -> if ok == {
            .InlineRange(lo, hi, _) -> Val((lo, hi, ~ok))
            _ -> None
        }
        _ -> None
    }
    if inline_target == .Val((lo, hi, target)) && b.init == .MethodCall(receiver, method, _, _, _, args, ..) {
        descriptor :: if receiver == {
            .Call(call) -> call.resolved_ret.is_some_and(ty -> ty == target)
            _ -> false
        }
        if descriptor && method == conversion_method_for_source("Int") && args.len() == 1 {
            &self.diags.push(inline_range_runtime_conversion(lo, hi, method, expr_span(args[0].expr)))
            it = Val(^target)
        }
    }
    if b.is_comptime -> self.in_comptime = false
    self.lambda_escapes = saved_esc
    self.lambda_binding = ^saved_bind
    self.expected_type = ^saved_expected
    self.reject_borrowed_param_subplace(&b.init, it, "be stored in a binding")
    if it.is_some_and(contains_expiring_secret_loan) {
        &self.diags.push(Diagnostic.error("E0201", "an ExpiringSecret loan cannot be stored", "the callback parameter is a temporary read-only loan that ends when `.with` returns", "use the loan inside the callback and store only a non-secret result", Val(expr_span(b.init))))
    }
    if it == .Val(.Named(name)) && (name == "FileLines" || name == "StdinLines" || name == "ProcessLines") {
        variable :: if b.name.is_empty() -> "line" else -> b.name
        &self.diags.push(Diagnostic.error("E2502", "a line stream can only be used directly in a loop", "`.lines()` hands back a lazy line reader meant to be iterated in place; storing it in a name would let it leave the loop, where it has no use", "iterate it directly: `loop {variable} in handle.lines() {{ … }}`", Val(expr_span(b.init))))
    }
    if b.init == .Lambda(lambda) && lambda.meta.escapes {
        loop name in lambda.meta.mut_captures -> self.lambda_mut_borrow_stack.last_mut().unwrap().insert(~name)
        loop name in lambda.meta.moved_captures -> self.mark_moved_exact(~name, lambda.span, "an escaping lambda")
    }
    if b.init == .Ident(name, span) {
        if self.lookup(name) == .Val(info) {
            if !info.ty.is_scalar() && info.param_conv.is_none() -> self.mark_moved(~name, span, "the binding `{b.name}`")
        }
    }
    initializer_type_error :: self.diags[diagnostics_before_init..<self.diags.len()].any(diagnostic -> diagnostic.code == "E0801" || diagnostic.code == "E3203")
    init_read_invalid :: self.invalid_binding_reads != invalid_reads_before_init
    init_type_unusable :: (b.ty.is_none() && it.is_none() && (init_has_error || init_read_invalid)) || (init_has_error && initializer_type_error)
    if b.ty.is_none() && it.is_none() && !init_has_error && !init_read_invalid {
        if b.init.without_parens() == .MethodCall(_, method, method_span, ..) {
            &self.diags.push(Diagnostic.error("E0116", "`.{method}()` doesn't hand back a value", "a call is a value only when its function declares a result after the parameter list", "put `{method}` on its own line, or declare a result after the parameter list", Val(method_span)))
        }
    }
    final_ty := if (b.ty, it) == {
        (.Val(_), .Val(actual)) if !annot_valid -> actual
        (.Val(annotated), .Val(inferred)) -> {
            annot :: self.resolve_type(~annotated)
            actual := self.resolve_type(~inferred)
            preserve_clock_provenance :: is_clock_type(annot) && (is_deterministic_clock_type(actual) || is_system_clock_type(actual))
            if annot != actual && self.implicitly_convert_unit(&b.init, annot, actual) -> actual = ~annot
            if self.lift_optional_slot(annot, actual, &b.init) == .Val(lifted) -> actual = ^lifted
            if annot != actual {
                distinct_name :: if annot == {
                    .Named(name) -> if self.registry.is_distinct(name) -> Val(~name) else -> None
                    _ -> None
                }
                if distinct_name == .Val(dt) {
                    base :: self.registry.distinct_base(dt).map(ty -> ty.name()) ?? ""
                    &self.diags.push(Diagnostic.error("E0128", "a `{actual.name()}` can't be used where a `{dt}` is expected", "`{dt}` and `{actual.name()}` are different types — even though `{dt}` is built on `{base}`, one is never accepted in place of the other", "construct a `{dt}`: `{dt}(expr)`", Val(expr_span(b.init))))
                } else if typed_text_mismatch(annot, actual, expr_span(b.init)) == .Val(diag) {
                    &self.diags.push(^diag)
                } else {
                    &self.diags.push(Diagnostic.error("E0108", "`{b.name}` says its type is {annot.show()}, but the value is {actual.show()}", "the type written after `:` must match the value", type_fix_hint(annot, actual), Val(expr_span(b.init))))
                }
            }
            if preserve_clock_provenance -> actual else -> annot
        }
        (.Val(annot), .None) -> self.resolve_type(~annot)
        (.None, .Val(actual)) -> actual
        (.None, .None) -> Type.Named{name: "Unknown"}
    }
    direct_group :: if final_ty == {
        .Named(name) -> name == TYPE_TASKGROUP
        _ -> false
    }
    if contains_taskgroup(final_ty) && !direct_group {
        &self.diags.push(Diagnostic.error("E1110", "`Group` cannot be stored inside another value", "a task group is call-stack-only spawn authority; aliases and aggregates could outlive its owner", "pass `group: Group` directly to a helper function or method and use it there", Val(b.name_span)))
    }
    if b.ty.is_none() -> b.ty = Val(~final_ty)
    self.report_lending_view_escape(b.init, "be stored in a binding")
    if final_ty.is_float() && is_money_like_name(b.name) {
        &self.diags.push(Diagnostic.lint("L0504", "binding `{b.name}` looks like money but has type `Float`", "floating-point money loses cents on common values like `0.1 + 0.2`", "use `Decimal` for exact money: `price: Decimal := Decimal(\"9.99\")`", Val(b.name_span)))
    }
    if !self.defer_ct_evaluation && b.is_comptime {
        if check_build_time_io(b.init, self.ct_base_dir, &self.diags) {
            is_patch_binding :: if final_ty == {
                .Named(name) -> name.ends_with(".Patch")
                _ -> false
            }
            globals :: self.current_ct_globals().into_owned()
            binding_types :: self.current_ct_binding_types(globals)
            mutated := [String:CtValue]{}
            checked_nominals :: self.checked_comptime_nominals()
            ct_checked_funcs :: self.ct_checked_funcs_for_evaluation()
            folded :: evaluate_owned_with_imports_opts_collecting_items(b.init, ct_checked_funcs, self.ct_externs, self.ct_base_dir, globals, binding_types, self.core_imports, self.gates, self.ct_impure_depth, self.ct_items, checked_nominals, Val(&mutated))
            self.apply_ct_mutations(^mutated)
            if folded == {
                .Ok((value, inputs)) -> {
                    if final_ty == .Named("Unknown") {
                        final_ty = value.jet_type()
                        if b.ty == .Val(.Named("Unknown")) -> b.ty = Val(~final_ty)
                    }
                    if self.ct_value_fits_binding(value, final_ty) -> b.ct = Val(~value)
                    if !is_patch_binding -> self.ct_scopes.last_mut().unwrap().insert(~b.name, ^value)
                    &self.ct_embed_inputs.extend(^inputs)
                }
                .Err(diagnostic) -> &self.diags.push(^diagnostic)
            }
        }
    }
    if b.name == "_" {
        if is_task_type(final_ty) && !self.in_taskgroup_spawn {
            &self.diags.push(l1101_unjoined_task("this task", "discarding it into `_` skips the join before the task finishes", b.name_span))
        } else if self.type_is_single_use(final_ty) -> &self.diags.push(e0140_discarded_wildcard(b.name_span))
        propagated_call :: if b.init.without_parens() == {
            .Try(inner, ..) -> if inner.without_parens() == {
                .Call(..) | .MethodCall(..) -> true
                _ -> false
            }
            _ -> false
        }
        unit_success :: if final_ty == {
            .Named(name) -> name == INTERNAL_UNIT_TYPE
            _ -> false
        }
        if !init_has_error && !b.is_comptime && unit_success && propagated_call -> &self.diags.push(Diagnostic.from_row("L0531", [], Val(b.name_span)))
        self.current_binding_name = ^prev_binding_name
        return
    }
    binding_sendable :: if b.init == {
        .Lambda(lambda) -> self.lambda_value_sendable(lambda, final_ty)
        _ -> self.sendability_problem(final_ty, true).is_none()
    }
    function_type :: if final_ty == {
        .Fn(..) -> true
        _ -> false
    }
    interrupt_sendable := false
    if function_type {
        if interrupt_callback_name(b.init) == .Val(name) {
            interrupt_sendable = if self.lookup(name) == {
                .Val(info) -> info.param_conv.is_none() && info.interrupt_sendable
                .None -> self.funcs.contains_key(name) || self.unqualified.contains_key(name) || self.unqualified_file.contains_key(name)
            }
        } else if interrupt_callback_lambda(b.init) == .Val(lambda) -> interrupt_sendable = self.lambda_interrupt_sendable(lambda, final_ty)
    }
    single_use_span :: if self.type_is_single_use(final_ty) -> Val(b.name_span) else -> None
    if arena_alloc_source.is_some() -> b.arena_view = true
    else if b.init == .Ident(src, span) {
        if self.is_arena_view(src) || self.is_fixed_backing_view(src) -> self.report_view_escape(src, "be stored in another binding", span)
    }
    if final_ty == .Named("Fixed") {
        if self.fixed_backing_source(b.init) == .Val(owner) -> self.record_fixed_backing(b.name, owner, b.name_span)
    }
    direct_mutable_view :: if final_ty == {
        .Apply(name, _) -> name == "ViewMut"
        _ -> false
    }
    transferred_view_root :: if direct_mutable_view -> self.mutable_view_aggregate_root(b.init) else -> None
    loop (output_path, place, kind, original_access) in self.view_call_sources(b.init) {
        access :: if direct_mutable_view && output_path.is_empty() -> ViewAccess.Write else -> original_access
        self.record_list_view(b.name, output_path, place, kind, access, b.name_span, final_ty, transferred_view_root)
    }
    self.finish_mutable_view_aggregate_transfer(transferred_view_root, expr_span(b.init), "the binding `{b.name}`")
    if b.init == .Ident(src, _) -> self.transfer_named_view(b.name, src, b.name_span)
    if !b.mutable && self.string_view_call_source(b.init) == .Val(owner) {
        b.string_view = true
        self.record_string_view(b.name, owner, b.name_span)
    }
    concrete_unit_value :: if !b.mutable -> self.concrete_unit_value(b.init) else -> None
    normalized_path_source :: if !b.mutable && !init_has_error && final_ty == Type.String -> self.normalized_path_string_source(b.init) else -> None
    self.declare_with_sendability(b.name, b.name_span, LocalInfo{
        def_span: b.name_span, binding_sigil_span: if b.is_comptime -> None else -> b.sigil_span,
        ty: ~final_ty, mutable: b.mutable && !b.is_comptime, param_conv: None,
        decl_loop_depth: self.loop_depth, interrupt_sendable: interrupt_sendable,
        reactive_local: b.reactive_local(), reactive_shared: b.reactive_shared(),
        single_use_span: single_use_span, invalid: init_type_unusable,
    }, binding_sendable)
    if normalized_path_source == .Val(source) -> self.flow.path_strings.set_at(b.name, self.scope_depth(), PathStringFact{source: source})
    if arena_alloc_source == .Val(arena) -> self.record_arena_view(b.name, arena, b.name_span)
    if b.track() && !b.name.is_empty() {
        depth :: self.flow.origins.depth_of(b.name) ?? self.scope_depth()
        (line, column) :: span_line_col(self.source, b.name_span.start)
        self.flow.origins.set_at(b.name, depth, OriginFact{tracked: true, source: Val(~b.name), line: Val(line), column: Val(column), ambiguity: false})
    }
    if self.frozen_expr_site(b.init) == .Val(site) {
        depth :: self.binding_fact_depth(b.name) ?? self.scope_depth()
        self.flow.frozen.set_at(b.name, depth, site)
    }
    if b.reactive_shared() && is_reactive_handle_ty(final_ty) {
        self.note_reactive_upgrade(b.name, final_ty, "#Shared pin")
        b.reactive_upgrade = true
    }
    if concrete_unit_value == .Val(value) -> self.concrete_unit_values.last_mut().expect("binding scope exists").insert(~b.name, value)
    self.current_binding_name = ^prev_binding_name
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/bindings.rs:2341
pub fn check_destructuring_binding(self: &Checker, b: &Binding) {
    inferred :: self.infer(&b.init)
    pattern :: b.pattern.expect("destructuring binding has a pattern")
    it :: inferred ?? {
        loop name in pattern.names() -> self.declare_bound(name.local_name(), name.span, Type.Int, b.mutable, b.sigil_span)
        return
    }
    resolved :: self.resolve_type(it)
    if pattern == {
        .Struct(type_name, type_span, fields, rest, pat_span) -> {
            display_type_name :: self.display_type_name(type_name, None)
            actual :: if resolved == {
                .Named(name) | .Apply(name, _) -> Val(~name)
                _ -> None
            }
            is_struct :: actual.is_some_and(name -> {
                (import_ns, lookup_name) :: self.struct_type_name_parts(name)
                self.struct_owner_module(lookup_name, import_ns).and_then(owner -> self.struct_fields_of(owner, lookup_name)).is_some()
            })
            if !is_struct {
                &self.diags.push(Diagnostic.error("E0313", "`{display_type_name} {{ … }}` can only destructure a `{display_type_name}` value, but this is {resolved.show()}", "destructuring with `{{ }}` pulls fields out of a struct value", "destructure a `{display_type_name}`, or bind the whole value with a name", Val(type_span)))
                loop name in pattern.names() -> self.declare_bound(name.local_name(), name.span, Type.Int, b.mutable, b.sigil_span)
                return
            }
            actual_name :: actual.unwrap()
            pattern_matches :: if resolved == {
                .Apply(head, _) -> {
                    (pattern_ns, pattern_name) :: self.struct_type_name_parts(type_name)
                    (actual_ns, actual_head) :: self.struct_type_name_parts(head)
                    pattern_owner :: self.struct_owner_module(pattern_name, pattern_ns)
                    actual_owner :: self.struct_owner_module(actual_head, actual_ns)
                    pattern_name == actual_head && pattern_owner.is_some() && actual_owner.is_some() && pattern_owner == actual_owner
                }
                _ -> self.nominal_type_identity(Type.Named{name: ~type_name}, resolved)
            }
            if !pattern_matches {
                &self.diags.push(Diagnostic.error("E0313", "this value is a `{actual_name}`, not a `{display_type_name}`", "the type named before `{{ }}` must match the value you destructure", "write `{actual_name} {{ … }}` to match the value", Val(type_span)))
                loop name in pattern.names() -> self.declare_bound(name.local_name(), name.span, Type.Int, b.mutable, b.sigil_span)
                return
            }
            loop field in fields {
                field_ty :: self.field_type(resolved, field.name, field.span) ?? Type.Int
                self.declare_bound(field.local_name(), field.span, field_ty, b.mutable, b.sigil_span)
            }
            (import_ns, lookup_name) :: self.struct_type_name_parts(actual_name)
            total_fields :: self.struct_owner_module(lookup_name, import_ns).and_then(owner -> self.struct_fields_of(owner, lookup_name)).map(all_fields -> all_fields.len())
            if total_fields == .Val(total) {
                partial :: fields.len() < total
                if partial && rest.is_none() {
                    &self.diags.push(Diagnostic.error("E0326", "this pattern leaves out fields of `{display_type_name}`", "a destructure that doesn't name every field must end with `..` so the skipped fields are visible at a glance", "add `, ..` before the closing `}}`, or name the remaining fields", Val(pat_span)))
                } else if !partial && rest == .Val(rest_span) {
                    &self.diags.push(Diagnostic.error("E0327", "`..` is redundant — this pattern already names every field of `{display_type_name}`", "a trailing `..` only makes sense when some fields are left unnamed", "remove the `..`", Val(rest_span)))
                }
            }
        }
        .List(elems, span) -> {
            (elem_ty, fixed_len) :: if resolved == {
                .List(inner) -> (~inner, None)
                .FixedList(elem, len) -> (~elem, Val(len.require_literal()))
                _ -> {
                    &self.diags.push(Diagnostic.error("E0313", "`[ … ]` can only destructure a list, but this is {resolved.show()}", "destructuring with `[ ]` pulls elements out of a list value", "destructure a list, or bind the whole value with a name", Val(span)))
                    loop name in pattern.names() -> self.declare_bound(name.local_name(), name.span, Type.Int, b.mutable, b.sigil_span)
                    return
                }
            }
            if fixed_len == .Val(fixed) && U64.from_int(elems.len()) != fixed {
                names_suffix :: if elems.len() == 1 -> "" else -> "s"
                fixed_suffix :: if fixed == 1 -> "" else -> "s"
                &self.diags.push(Diagnostic.error("E0963", "destructuring with {elems.len()} name{names_suffix}, but this fixed-size list has {fixed} element{fixed_suffix}", "a fixed-size list `[T#N]` has a known length — the pattern must match exactly", "use {fixed} name{fixed_suffix} in the pattern", Val(span)))
            }
            if b.init == .ListLit(items, _) && items.len() != elems.len() {
                suffix :: if elems.len() == 1 -> "" else -> "s"
                count_suffix :: if items.len() == 1 -> "" else -> "s"
                &self.diags.push(Diagnostic.error("E0315", "this pattern binds {elems.len()} item{suffix}, but the list has {items.len()}", "a list pattern must name exactly as many items as the list holds", "name {items.len()} item{count_suffix} to match the list", Val(span)))
            }
            loop elem in elems -> self.declare_bound(elem.name, elem.span, ~elem_ty, b.mutable, b.sigil_span)
        }
        .Tuple(elems, span) -> {
            if resolved == .Apply(name, args) {
                if Checker.split_type_name(name).1 == "VJPRun" && args.len() == 1 && elems.len() == 2 {
                    pull_ty :: Type.Fn{params: [Type.Named{name: "Tensor"}], ret: Val(~args[0]), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
                    self.declare_bound(elems[0].name, elems[0].span, Type.Named{name: "Tensor"}, b.mutable, b.sigil_span)
                    self.declare_bound(elems[1].name, elems[1].span, pull_ty, b.mutable, b.sigil_span)
                    return
                }
            }
            if resolved != .Tuple(fields) {
                &self.diags.push(Diagnostic.error("E0313", "`( … )` can only destructure a tuple, but this is {resolved.show()}", "destructuring with `( )` pulls named members out of a tuple value", "destructure a tuple, or bind the whole value with a name", Val(span)))
                loop name in pattern.names() -> self.declare_bound(name.local_name(), name.span, Type.Int, b.mutable, b.sigil_span)
                return
            }
            if elems.len() != fields.len() {
                suffix :: if elems.len() == 1 -> "" else -> "s"
                count_suffix :: if fields.len() == 1 -> "" else -> "s"
                &self.diags.push(Diagnostic.error("E0315", "this pattern binds {elems.len()} member{suffix}, but the tuple has {fields.len()}", "a tuple pattern must name exactly as many members as the tuple holds", "name {fields.len()} member{count_suffix} to match the tuple", Val(span)))
            } else if b.init == .TupleLit(items, _, _) && items.len() != elems.len() {
                suffix :: if elems.len() == 1 -> "" else -> "s"
                count_suffix :: if items.len() == 1 -> "" else -> "s"
                &self.diags.push(Diagnostic.error("E0315", "this pattern binds {elems.len()} member{suffix}, but the tuple literal has {items.len()}", "a tuple pattern must name exactly as many members as the literal holds", "name {items.len()} member{count_suffix} to match the tuple", Val(span)))
            }
            count :: if elems.len() < fields.len() -> elems.len() else -> fields.len()
            loop index in 0..<count -> self.declare_bound(elems[index].name, elems[index].span, ~fields[index].ty, b.mutable, b.sigil_span)
        }
        .Refutable(..) -> panic("refutable bindings use check_refutable_binding")
    }
    if b.init == .Ident(name, span) {
        if self.lookup(name) == .Val(info) {
            if !info.ty.is_scalar() && info.param_conv.is_none() -> self.mark_moved(~name, span, "the destructuring binding")
        }
    }
}
