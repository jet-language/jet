use jet_sema.[Checker, LoopValueFrame, LoopValueKind, FlowFacts, DiscardedResultFact, type_fix_hint, core_struct_field_type, undefined_loop_label, loop_control_outside, stmt_refs_name, fallback_refs_name, contains_expiring_secret_loan]

// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:24
fn division_fix_hint(want: Type, got: Type, value: Expr) -> String Never! {
    divides :: if value == .Binary(BinOp.Div, _, _, _) -> true else -> false
    exact_quotient :: got == Type.Float || got == Type.Float32 || got == Type.Named{name: TYPE_FRACTION}
    if divides && want == Type.Int && exact_quotient -> return "use `/%` to divide and round down (`/%=` in place), or make the binding a Float"
    type_fix_hint(want, got)
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:42
fn return_value_fix(want: Type, got: Type) -> String Never! {
    required :: want.without_user_tags()
    actual :: got.without_user_tags()
    if required == Type.Int && actual == Type.Named{name: TYPE_FRACTION} -> return "`/` on whole numbers makes an exact Fraction; divide with `/%` to get a whole number rounded down"
    if required == .List(item) { if item == actual -> return "wrap the value in a list: `[value]`" }
    if actual == .List(item) { if item == required -> return "this is a whole list; hand back one element, or combine the elements into one value" }
    if actual == .Option(item) { if item == required -> return "the value may be missing; supply a fallback with `?? default`, or leave early when it is `None`" }
    if required.name() == "String" -> return "put the value in text with interpolation: \"{{value}}\""
    hint :: type_fix_hint(required, actual)
    if hint.starts_with("use ") && hint.ends_with(" here") -> return "hand back a {required.name()} value: convert this value to {required.name()}, or return the value you meant"
    hint
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:79
fn encoding_reader_item_type(name: String) -> Type? Never! {
    if name == {
        "JSONReader" | "CBORReader" -> Val(Type.Named{name: "DataEvent"})
        "JSONLReader" | "XMLReader" -> Val(Type.Named{name: "DataTree"})
        "CSVReader" -> Val(Type.Named{name: "CSVRow"})
        else -> None
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:88
fn stream_element_type(ty: Type?) -> Type? Never! {
    if ty == .Val(.Apply(name, args)) { if name == TYPE_STREAM && args.len() == 1 -> return Val(args[0]) }
    None
}
// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:100
fn exits_current_block(stmt: Stmt) -> Bool Never! {
    if stmt == {
        .Return(_, _) | .Break(_) | .BreakValue(_, _) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .Continue(_) | .ContinueLabel(_, _) -> return true
        .Expr(expr) -> {
            if expr.without_parens() == .Todo(_, _) -> return true
            if expr.without_parens() == .Call(call) -> return call.name == BUILTIN_PANIC
        }
        else -> {}
    }
    false
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:125
fn drained_collection(cond: Expr, body: [Stmt]) -> (String, Span)? Never! {
    if cond.without_parens() != .Binary(BinOp.Gt, lhs, rhs, _) -> return None
    if lhs.without_parens() != .MethodCall(receiver, method, _, _, _, args, _, _, _, _) -> return None
    if receiver.without_parens() != .Ident(name, name_span) -> return None
    if method != "len" || !args.is_empty() -> return None
    if rhs.without_parens() != .Int(0, _, _, _) -> return None
    loop stmt in body { if stmt != .Val(_) && stmt != .Expr(_) -> return None }
    loop stmt in body.iter().skip(1) { if stmt_refs_name(stmt, name) -> return None }
    first :: body.first() ?? return None
    if first != .Val(binding) -> return None
    value := binding.init.without_parens()
    if value == .OrFallback(inner, fallback, _) {
        if fallback_refs_name(fallback, name) -> return None
        value = inner.without_parens()
    }
    if value != .MethodCall(popped, pop_method, _, _, _, pop_args, _, _, _, _) -> return None
    if pop_method == "pop" && pop_args.is_empty() {
        if popped.without_parens() == .Ident(popped_name, _) { if popped_name == name -> return Val((name, name_span)) }
    }
    None
}

