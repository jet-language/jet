    fn join_loop_flow(self: &Self, before_loop: FlowFacts, after_body: FlowFacts, may_skip: Bool) Never! {
        break_paths := &self.loop_break_flows.pop() ?? panic("loop break frame matches loop value frame")
        depth :: self.flow.depth
        loop path in &break_paths {
            loop path.depth > depth -> path.leave_scope()
