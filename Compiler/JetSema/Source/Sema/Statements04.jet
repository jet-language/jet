    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:379
    fn compound_owner_field_type(self: Self, owner: Type, field: String) -> Type? Never! {
        if owner == .Apply(name, args) { if field == "value" && name == TYPE_SHARED_GUARD && args.len() == 1 -> return Val(args[0]) }
        (owner_name, args) :: if owner == {
            .Named(name) -> (name, [Type]{})
            .Apply(name, args) -> (name, args)
            .Tagged(_, inner) -> return self.compound_owner_field_type(inner, field)
            else -> return None
        }
        (import_ns, leaf) :: self.struct_type_name_parts(owner_name)
        owner_mod :: self.struct_owner_module(leaf, import_ns) ?? {
            if import_ns == None -> return core_struct_field_type(leaf, field, args)
            return None
        }
        fields :: self.struct_fields_of(owner_mod, leaf) ?? return None
        subst :: self.struct_subst_for_owner(owner_mod, leaf, args)
        fields.iter().find(|(name, _, _)| name == field).map(|(_, _, ty)| self.instantiate_type_for_owner(owner_mod, ty, subst))
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:409
    fn compound_expr_type(self: Self, expr: Expr) -> Type? Never! {
        if expr == {
            .Ident(name, _) -> self.lookup(name).map(|info| info.ty)
            .Field(base, field, _) -> self.compound_field_type(base, field)
            .Index(base, _, _, _) -> {
                ty :: self.compound_expr_type(base) ?? return None
                if ty == {
                    .List(elem) | .FixedList(elem, _) -> Val(elem)
                    .Map(_, value) -> Val(value)
                    else -> None
                }
            }
            else -> None
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:423
    fn lvalue_type(self: Self, target: LValue) -> Type? Never! {
