                    }
                }
                self.reject_borrowed_param_subplace(e, et, "be returned as an owned value")
                if payload_matches {
                    value_span :: e.span()
                    inner :: ^e
                    e = .Ok(inner, value_span)
                    et = Val(rt)
                }
                if !self.in_lambda_body && e.without_parens() != .Ok(_, _) && e.without_parens() != .Err(_, _) {
                    if et == .Val(.Result(_, err)) { if !err.is_never() -> self.failure_direct_source = true }
                }
                if et == .Val(actual) {
                    if self.lift_optional_slot(rt, actual, &e) == .Val(lifted) -> et = Val(lifted)
                    else if rt == .Result(ok, _) {
                        if self.lift_optional_slot(ok, actual, &e) != None {
                            value_span :: e.span()
                            inner :: ^e
                            e = .Ok(inner, value_span)
                            et = Val(rt)
                        }
                    }
                }
                if et.is_some_and(|ty| contains_expiring_secret_loan(ty)) -> &self.diags.push(Diagnostic.error("E0201", "an ExpiringSecret loan cannot be returned", "the callback parameter is valid only while `.with` is running", "return a non-secret result computed from the loan", Val(e.span())))
                ownership_ident :: if e == .Ident(name, name_span) -> Val((name, name_span)) else -> returned_ident
                if ownership_ident == .Val((n, nspan)) {
                    if self.lookup(n) == .Val(info) {
                        is_type_param :: if info.ty == .Named(name) -> self.type_param_scope.iter().any(|param| param.name == name) else -> false
                        if !info.ty.is_scalar() && !is_type_param && (info.param_conv == Val(AccessConvention.Read) || info.param_conv == Val(AccessConvention.Write)) {
                            source_ty :: info.ty
                            display_type :: self.display_type(source_ty).name()
                            diagnostic :: Diagnostic.error("E0120", "`{n}` was not moved here, so it cannot be returned as-is", "this function has read access only and does not own the value", "return a copy: `return {SIGIL_COPY}{n};` — or take ownership with the move marker `^`: `{n}: {SIGIL_MOVE}{display_type}`. There's no borrow-return in v1 — to share the value without a full copy, store an owned field, or reach for `Shared<T>`/`ID<T>` once a real program needs shared ownership", Val(nspan))
                            &self.diags.push(self.with_ownership_copy_edit(diagnostic, nspan, Val(source_ty)))
                        }
                    }
                }
                if !string_view_return -> self.note_move_if_direct_ident(e, "`return`")
                if et == .Val(actual) {
                    http_handler_lambda := false
                    if rt.without_user_tags() == .Named(name) {
                        if name.split(".").last() == Val("HTTPHandler") {
                            if actual.without_user_tags() == .Fn(params, ret, _, effect_bound, _, _) {
                                if ret == .Val(handler_ret) {
                                    returns_http_handler :: if handler_ret.without_user_tags() == {
                                        .Result(ok, err) -> {
                                            ok_response :: if ok.without_user_tags() == .Named(ok_name) -> ok_name.split(".").last() == Val("HTTPResponse") else -> false
                                            err_error :: if err.without_user_tags() == .Named(err_name) -> err_name.split(".").last() == Val("HTTPError") else -> false
                                            ok_response && err_error
                                        }
                                        .Named(ret_name) -> {
                                            if ret_name.split(".").last() != Val("HTTPResponse") -> false
                                            else -> effect_bound.is_some_and(|effects| effects.iter().any(|(effect_name, _)| {
                                                clean := effect_name.trim() // #4303
                                                stripped := clean.trim_start_matches("!")
                                                stripped.split(".").last() == Val("HTTPError")
                                            }))
                                        }
                                        else -> false
                                    }
                                    request_param :: if params.len() == 1 -> {
                                        if params[0].without_user_tags() == .Named(param_name) -> param_name.split(".").last() == Val("HTTPRequest") else -> false
                                    } else -> false
                                    http_handler_lambda = request_param && returns_http_handler
                                }
                            }
                        }
                    }
                    string_view_compatible :: string_view_return && actual == Type.String
                    union_member_widen :: if rt == .Union(members) -> members.contains(actual) else -> false
                    reported :: self.check_type_assignable(rt, actual, e.span())
                    if actual != rt && !reported && !http_handler_lambda && !string_view_compatible && !union_member_widen {
                        display_return :: self.display_type(rt)
                        display_actual :: self.display_type(actual)
                        &self.diags.push(Diagnostic.error("E0113", "this value is {display_actual.show()}, but `{self.fn_name}` returns {display_return.name()}", "`{self.fn_name}` declares {display_return.name()} as its result, so the value it hands back must be {display_return.name()}", return_value_fix(display_return, display_actual), Val(e.span())))
                    }
                }
            }
            (.Val(e), .None) -> {
                ty_name :: self.infer_name_or(&e, "Int")
                &self.diags.push(Diagnostic.error("E0113", "`{self.fn_name}` doesn't return a value", "a function hands back a value only when it declares a return type", "remove the value (a bare `return`), or write `-> {ty_name}` after the parameter list", Val(e.span())))
            }
            (.None, .Val(rt)) -> {
                fallible_void :: if rt == .Result(ok, _) -> ok == Type.Named{name: INTERNAL_UNIT_TYPE} else -> false
                if !fallible_void -> &self.diags.push(Diagnostic.error("E0113", "`{self.fn_name}` promises to return {rt.show()}, but this `return` is empty", "the value handed back must match the declared return type", "add the value: `return ...;`", Val(span)))
            }
            (.None, .None) -> {}
        }
    }
}
