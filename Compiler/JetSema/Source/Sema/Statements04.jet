    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:495
    fn record_discarded_result(self: &Self, expr: Expr, ty: Type, calls_start: Int, diagnostics_start: Int) Never! {
        if ty == Type.Named{name: INTERNAL_UNIT_TYPE} || ty.is_never() -> return
        if self.diags[diagnostics_start..].iter().any(|diagnostic| diagnostic.severity == Severity.Error) -> return
        transparent := expr.without_parens()
        under_try := false
        if transparent == .Try(inner, _) { transparent = inner.without_parens(); under_try = true }
        (callee_spans, callee_name, args, receiver, declared_return) :: if transparent == {
            .Call(call) -> ([call.name_span, call.name_span], call.name, call.args, None, call.resolved_ret)
            .MethodCall(receiver, method, method_span, _, _, args, _, resolved_ret, _, _) -> ([method_span, transparent.span()], method, args, Val(receiver), resolved_ret)
            else -> return
        }
        never_failure :: if declared_return == .Val(.Result(_, err)) -> err.is_never() else -> false
        failure_open :: under_try && !never_failure
        marks_place :: |value| if value == .Place(_, PlaceAccess.Write, _) || value == .Place(_, PlaceAccess.Take, _) -> true else -> false
        if receiver.is_some_and(|value| marks_place(value)) -> return
        effectful_argument :: args.iter().any(|arg| {
            if arg.convention == AccessConvention.Write || marks_place(arg.expr) -> return true
            if arg.expr == .Lambda(_) -> return true
            if arg.expr == .Ident(name, _) {
                if self.lookup(name) == .Val(info) -> return if info.ty == .Fn(_, _, _, _, _, _) -> true else -> false
                return true
            }
            false
        })
        if effectful_argument -> return
        callee :: self.fx_memory_calls[calls_start..].iter().find(|call| callee_spans.contains(call.span)).map(|call| call.callee) ?? return
        span :: transparent.span()
        call_text := "{callee_name}(…)"
        if self.source.get(span.start..span.end) == .Val(source) {
            text := source.trim() // #4303
            if !text.is_empty() && !text.contains("\n") -> call_text = text.to_string()
        }
        &self.fx_discarded_results.push(DiscardedResultFact{callee: callee, callee_name: callee_name, call_text: call_text, span: span, failure_open: failure_open})
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:593
    fn check_stmt(self: &Self, stmt: &Stmt) Never! {
        if !self.enter_source_nesting(stmt.span()) -> return
        if !self.in_lambda_body {
            if stmt == .TaskGroup(_, _, _, _, _) || stmt == .Transact(_, _, _, _) || stmt == .Live(_, _, _) || stmt == .Reactive(_, _) || stmt == .Shield(_, _) || stmt == .Switched(_, _, _) || stmt == .ScopeMember(_, _, _, _, _, _, _, _) || stmt == .Yield(_, _) || stmt == .DeferClose(_, _) -> self.failure_direct_source = true
        }
        before :: ~self.flow
        before_direct :: ~self.fx_direct
        before_edges :: ~self.fx_edges
        before_maximal :: self.fx_maximal
        diagnostics_start :: self.diags.len()
        allows_start :: self.statement_lint_allows.len()
        effect_free :: if before.reachable -> {
            self.check_stmt_inner(stmt)
            self.fx_direct == before_direct && self.fx_edges == before_edges && self.fx_maximal == before_maximal
        } else -> self.with_erased_scope(|checker| {
            checker.check_stmt_inner(stmt)
            checker.fx_direct == before_direct && checker.fx_edges == before_edges && checker.fx_maximal == before_maximal
        })
        self.emit_stdlib_lints_for_stmt(stmt)
        self.emit_loop_liveness_lints_for_stmt(stmt, before.reachable, effect_free)
        allows :: &self.statement_lint_allows.split_off(allows_start)
        if !allows.is_empty() {
            retained :: &self.diags.split_off(diagnostics_start)
            loop diagnostic in retained {
                if diagnostic.severity != Severity.Lint || allows.iter().all(|name| name_for_code(diagnostic.code) != Val(name)) -> &self.diags.push(diagnostic)
            }
        }
        if !before.reachable -> self.flow = ^before
        else if exits_current_block(stmt) -> self.flow.reachable = false
        self.leave_source_nesting()
    }
