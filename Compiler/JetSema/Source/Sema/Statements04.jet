    fn compound_nested_hook(self: Self, base: Expr, field: String, op: BinOp) -> Bool Never! {
        trait_name :: if op == { .Add -> TRAIT_ADD; .Sub -> TRAIT_SUB; .Mul -> TRAIT_MUL; .Div -> TRAIT_DIV; else -> return false }
        ty :: self.compound_field_type(base, field) ?? return false
        if ty.is_numeric() || !self.compound_type_implements(ty, trait_name) -> return false
        if base == {
            .Ident(_, _) -> false
            .Index(_, _, _, _) -> if ty == .Named(_) || ty == .Apply(_, _) -> true else -> false
            else -> true
        }
    }
