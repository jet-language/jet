            .Local(name, _) -> self.lookup(name).map(|info| info.ty) ?? (if self.is_global_mutable_binding(name) -> self.consts.get(name) else -> None)
            .Field(base, field, _) -> self.compound_field_type(base, field)
            .Index(base, _, _, _) -> {
                ty :: self.compound_expr_type(base) ?? return None
                if ty == { .List(elem) | .FixedList(elem, _) -> Val(elem); .Map(_, value) -> Val(value); else -> None }
            }
        }
    }
