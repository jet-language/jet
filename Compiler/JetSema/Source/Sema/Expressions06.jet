// Private continuation of canonical Sema/Expressions (method-call head).
// Existing checked static/handle routes stay at their canonical owners. The
// functions below supply the genuine head gaps; they do not create a Checker
// clone, a second method catalog, or a second expression-inference pass.
use jet_foundation.[CallArg, CtBigInt, Diagnostic, Expr, ExprField, INTERNAL_VALIDATE_OVER, METHOD_MEMO_CACHE, METHOD_RECEIPT_ATTACH, Span, StrPart, SymbolKind, TExpr, TExprKind, TFieldRef, THostCall, THandleOp, TMethodRef, TPreludeArg, TStaticOwner, TStrPart, TStructFieldValue, TYPE_MEMO_STATS, TYPE_VALIDATE, TYPE_VALIDATE_BUILDER, Type, core_module_export, expr_span, memo_bound_from_markers, symbol_id]
use core.math as method_head_math

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:1032
// infer_method_call -> sema_expr_check_method_call, Expressions.jet:2663.
// Preserve handled/failed versus unclaimed with SemaMethodSpecialCheck. Publish
// this file as a PRIVATE continuation of that owner, not a new public checker.

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:1082-1096
// Immutable AST checking does not re-elaborate a materialized Validate.over;
// the original compiler-owned sentinel remains recognized for stored ASTs.
fn sema_expr_method_validate_over_idempotent(receiver: Expr, method: String, args: [CallArg], recv_type: String?, resolved_ret: Type?) -> Type? Never! {
    if recv_type != Val(INTERNAL_VALIDATE_OVER) || method != "over" || args.len() != 0 -> return None
    if receiver == .StructLit(name, _, _, _, _, _, _) && name == TYPE_VALIDATE_BUILDER -> return resolved_ret
    None
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:1097-1112
fn sema_expr_method_memo_cache(receiver: Expr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != METHOD_MEMO_CACHE || args.len() != 0 -> return SemaMethodSpecialCheck{handled: false, value: None}
    name :: if receiver == {.Ident(found, _) -> found else -> return SemaMethodSpecialCheck{handled: false, value: None}}
    index :: sema_scope_resolve_index(scopes, name) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    symbol :: scopes.bindings[index].symbol
    if symbol.kind != SymbolKind.Function -> return SemaMethodSpecialCheck{handled: false, value: None}
    declaration :: sema_scope_resolve_declaration(environment, symbol.id) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    function :: if declaration == {.Func(found) -> found else -> return SemaMethodSpecialCheck{handled: false, value: None}}
    if memo_bound_from_markers(function.markers) == None -> return SemaMethodSpecialCheck{handled: false, value: None}
    stats :: sema_tir_expr(Type.Named{name: TYPE_MEMO_STATS}, TExprKind.HostCall{call: THostCall.MemoStats{name: name}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(stats, expected, environment, &diagnostics)}
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:1157-1204
// Use the declaration-owned registry and the existing serde eligibility/error
// oracle. The same typed payload and receipt metadata reach ReceiptAttach;
// there is no runtime receiver, synthetic schema, or String payload fallback.
fn sema_expr_method_receipt(receiver: Expr, method: String, args: [CallArg], registry: TraitRegistry, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != METHOD_RECEIPT_ATTACH || receiver != Expr.Ident{name: "receipt", span: expr_span(receiver)} || sema_scope_resolve_index(scopes, "receipt") != None -> return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != 1 {
        &diagnostics.push(sema_error("E0103", span, "`receipt.attach` takes exactly one argument", "one typed value becomes one named receipt section", "write `receipt.attach(value)`"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    payload :: sema_check_expression(args[0].expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    name :: if payload.ty == {
        .Named(found) | .Apply(found, _) -> found
        else -> {
            &diagnostics.push(sema_error("E2411", expr_span(args[0].expr), "receipt sections require a named `#Receipt` type", "the section schema and wire encoder are declaration-owned", "declare a `#Codable` record with `#Receipt(\"name\")`"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    section :: registry.receipt_section(name) ?? {
        &diagnostics.push(sema_error("E2411", expr_span(args[0].expr), "type `{name}` is not a `#Receipt` section", "receipt attachment accepts only declaration-owned typed sections", "add `#Receipt(\"name\")` and `#Codable` to the record"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !is_encodable_ty(payload.ty, registry) -> &diagnostics.push(e2411(payload.ty, true, expr_span(args[0].expr)))
    values :: [TExpr]{payload,
        sema_tir_expr(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: section.name}}}, span),
        sema_tir_expr(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: section.type_name}}}, span),
        sema_tir_expr(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: section.schema_digest}}}, span),
    }
    unit :: sema_tir_expr(Type.Named{name: "Unit"}, TExprKind.Unit, span)
    call :: sema_tir_expr(Type.Named{name: "Unit"}, TExprKind.HandleMethod{receiver: unit, operation: THandleOp.ReceiptAttach, args: values}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(call, expected, environment, &diagnostics)}
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:1205-1222,1276-1290,1368-1385
// Preserve original receiver/argument diagnostic order. File.open deliberately
// does not resolve the retired File receiver; view/read_dir still check it.
fn sema_expr_method_retired(receiver: Expr, method: String, args: [CallArg], span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    file_open :: method == "open" && receiver == Expr.Ident{name: "File", span: expr_span(receiver)}
    if method != "view" && method != "read_dir" && !file_open -> return SemaMethodSpecialCheck{handled: false, value: None}
    if file_open -> &diagnostics.push(sema_error("E0038", span, "`File.open` is not the M10 file API", "M10 uses whole-file helpers in `core.files`, not a `File.open` handle type", "import `core.files as fs` and call `fs.read(path)` or `fs.write(path, text)` (or `fs.open(path)` for a streaming handle)"))
    else -> _ := sema_check_expression(receiver, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if method == "view" -> &diagnostics.push(sema_error("E0214", span, "`.view(a..b)` is now a bare range place", "place access follows the sigil reading rule", "replace `value.view(a..b)` with `value[a..b]`"))
    if method == "read_dir" -> &diagnostics.push(sema_error("E0340", span, "`read_dir` is not a method in Jet", "Jet uses typed paths; raw-string directory helpers are not exposed", "write `Path.from(path).walk()` to list a directory recursively"))
    SemaMethodSpecialCheck{handled: true, value: None}
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:1340-1367
// A valid snapshot has no value return; do not confuse that with an unclaimed
// route. A Core module receiver named snapshot is handled by the Core route.
fn sema_expr_method_snapshot(receiver: Expr, method: String, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != "snapshot" || sema_expr_method_core_path(receiver, environment, scopes) != None -> return SemaMethodSpecialCheck{handled: false, value: None}
    checked := sema_check_expression(receiver, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if checked == .Val(value) && value.ty == Type.Named{name: "__JetExpect__"} -> return SemaMethodSpecialCheck{handled: true, value: None}
    &diagnostics.push(sema_error("E2901", span, "`.snapshot()` is only valid on the result of `expect(…)`", "snapshot testing: call `expect(value).snapshot()` in a test block", "e.g. `expect(my_result).snapshot()`"))
    SemaMethodSpecialCheck{handled: true, value: None}
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:1351-1353
// The accepted void snapshot still has a real execution node. Parent carries
// the already-checked expect payload into this helper rather than inferring it
// again; path construction is the canonical CoreCallRows lowering projection.
fn sema_expr_method_snapshot_value(value: TExpr, file: String, line: Int, span: Span) -> TExpr Never! {
    bytes := file.bytes()
    loop index in 0..<bytes.len() {
        if bytes[index] == U8{47} || bytes[index] == U8{92} || bytes[index] == U8{46} -> bytes[index] = U8{95}
    }
    source :: String.from_bytes(bytes) ?? panic("snapshot source UTF-8 invariant")
    path :: "snapshots/{source}_{line}.snap"
    sema_tir_expr(Type.Named{name: "Unit"}, TExprKind.HostCall{call: THostCall.ExpectSnapshot{value: value, snap_path: path}}, span)
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:1409-1416,2088-2127
struct SemaMethodCorePath {
    pub module_name: String
    pub alias: String
    pub alias_span: Span
}
fn sema_expr_method_core_path(receiver: Expr, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> SemaMethodCorePath? {
    if receiver == {
        .Ident(alias, alias_span) -> {
            if !sema_expr_core_module_alias_visible(alias, scopes) -> return None
            module_name :: sema_call_core_import_module(environment, alias) ?? return None
            Val(SemaMethodCorePath{module_name: module_name, alias: alias, alias_span: alias_span})
        }
        .Field(base, leaf, _) -> {
            parent :: sema_expr_method_core_path(base, environment, scopes) ?? return None
            module_name :: "{parent.module_name}.{leaf}"
            if core_module_export(module_name) == None -> return None
            Val(SemaMethodCorePath{module_name: module_name, alias: parent.alias, alias_span: parent.alias_span})
        }
        else -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:2253-2306
fn sema_expr_method_shortcut_literal(expr: Expr) -> String? Never! {
    if expr == {
        .Paren(inner, _) -> sema_expr_method_shortcut_literal(inner)
        .Str(parts, _) -> if parts.len() == 1 && parts[0] == .Lit(text) -> Val(text) else -> None
        else -> None
    }
}
fn sema_expr_method_shortcut_reason(argument: CallArg) -> String? Never! {
    if argument.label != None -> return Val("the key must be positional")
    literal :: sema_expr_method_shortcut_literal(argument.expr) ?? return Val("the key must be one plain string literal")
    if literal.trim().is_empty() -> Val("the key must not be empty") else -> None
}
fn sema_expr_method_shortcut(receiver: Expr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    owner :: if receiver == {.Ident(name, _) -> name else -> return SemaMethodSpecialCheck{handled: false, value: None}}
    if method != "cmd" || (owner != "" && owner != "UIShortcut") -> return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != 1 {
        &diagnostics.push(wrong_core_arity("UIShortcut.cmd", 1, args.len(), span))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    checked :: sema_check_expression(args[0].expr, Val(Type.String), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if sema_expr_method_shortcut_reason(args[0]) == .Val(reason) {
        shortcut :: sema_expr_method_shortcut_literal(args[0].expr) ?? "<expression>"
        &diagnostics.push(Diagnostic.from_row("E2938", [("shortcut", shortcut), ("reason", reason)], Val(args[0].span)))
    }
    call :: sema_tir_expr(Type.Named{name: "UIShortcut"}, TExprKind.StaticCall{
        owner: TStaticOwner.Prelude{rooted: true, path: "JetUiShortcut", generics: [TPreludeArg]{}}, owner_type: None,
        method: TMethodRef{symbol: symbol_id(SymbolKind.Function, "", "JetUiShortcut", "cmd"), name: "cmd", mangled: false, trait_owner: None, operator_identity: None},
        type_args: [Type]{}, args: [TCallArg]{sema_call_builtin_static_call_arg(checked, args[0])},
    }, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(call, expected, environment, &diagnostics)}
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:2309-2352
// The ordinary generated builder owns storage and check/finish code. This
// source transformation is the same StructLit consumed by normal sema; no
// private validation runtime is introduced.
fn sema_expr_method_validate_over_ast(value: Expr, value_type: Type, span: Span) -> Expr Never! {
    Expr.StructLit{type_name: TYPE_VALIDATE_BUILDER, type_args: [Type]{value_type}, import_ns: None, as_trait: None,
        fields: [ExprField]{
            ExprField{name: "value", name_span: span, value: Expr.Copy{value: value, span: span}},
            ExprField{name: "errors", name_span: span, value: Expr.ListLit{elements: [], span: span}},
        }, inferred: false, span: span}
}
fn sema_expr_method_validate_over(receiver: Expr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != "over" || receiver != Expr.Ident{name: TYPE_VALIDATE, span: expr_span(receiver)} || sema_scope_resolve_index(scopes, TYPE_VALIDATE) != None -> return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != 1 {
        &diagnostics.push(wrong_core_arity("Validate.over", 1, args.len(), span))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    subject :: sema_check_expression(args[0].expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    copied :: sema_expr_check_copy_typed(subject, span, None, environment, &context, &diagnostics, sema_expr_copy_string_view(args[0].expr, &scopes), false) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    resolved :: sema_expression_struct_type(TYPE_VALIDATE_BUILDER, [Type]{subject.ty}, None, span, environment, &scopes, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    definition :: sema_scope_resolve_declaration(environment, resolved.owner.id) ?? {
        &context.incomplete_reasons.push("Validate.over has no generated builder declaration")
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    fields :: if definition == {.Struct(value) -> value.fields else -> {
        &context.incomplete_reasons.push("Validate.over generated owner is not a struct")
        return SemaMethodSpecialCheck{handled: true, value: None}
    }}
    if fields.len() != 2 {
        &context.incomplete_reasons.push("Validate.over generated builder does not have value/errors fields")
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    values := [TStructFieldValue]{}
    loop field in fields {
        field_value :: if field.name == {
            "value" -> copied
            "errors" -> sema_tir_expr(decode_error_ty(), TExprKind.ListLit{elements: []}, span)
            else -> {
                &context.incomplete_reasons.push("Validate.over generated builder has an unexpected field")
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
        }
        boxed :: sema_scope_environment_boxed_edge(environment, resolved.owner.id, field.name)
        reference :: TFieldRef{owner: Val(resolved.owner.id), field: symbol_id(SymbolKind.Field, resolved.owner.module_name, resolved.owner.id.key, field.name), name: field.name, ty: field_value.ty, boxed: boxed}
        &values.push(TStructFieldValue{field: reference, value: field_value, boxed: boxed})
    }
    builder :: sema_tir_expr(resolved.ty, TExprKind.StructLit{fields: values, extra: None, as_trait: None}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(builder, expected, environment, &diagnostics)}
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:2367-2388
fn sema_expr_method_field_error_under(receiver: Expr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != "under" || receiver != Expr.Ident{name: "FieldError", span: expr_span(receiver)} -> return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != 2 {
        &diagnostics.push(wrong_core_arity("FieldError.under", 2, args.len(), span))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    segment :: sema_check_expression(args[0].expr, Val(Type.String), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    saved_carrier :: context.failure_carrier_root
    context.failure_carrier_root = true
    inner_checked := sema_check_expression(args[1].expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    context.failure_carrier_root = saved_carrier
    inner :: inner_checked ?? return SemaMethodSpecialCheck{handled: true, value: None}
    valid :: if inner.ty == {.Result(_, err) -> err == decode_error_ty() else -> false}
    if !valid -> &diagnostics.push(sema_error("E0905", expr_span(args[1].expr), "`FieldError.under` expects a result with `[FieldError]` errors", "the framing helper preserves the child result and prefixes every accumulated decode failure", "pass a typed decode/accessor result, such as `tree.field(\"name\")?.decode<T>()`"))
    result :: sema_tir_expr(inner.ty, TExprKind.DecodeUnder{segment: segment, inner: inner}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(result, expected, environment, context, &diagnostics)}
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:3322-3427
// This edits only the compiler-owned path argument. Parent ordinary method
// checking subsequently binds the generated method against this same array.
fn sema_expr_method_validate_rule(args: &[CallArg], subject_fields: [jet_foundation.Field], already_elaborated: Bool, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if args.len() != 3 {
        &diagnostics.push(e0353_bad_validate_rule(span))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return false
    }
    valid_shape :: args[0].label == None && args[2].label == None && args[1].label == .Val(label) && label.name == "at"
    field_name := String?{None}
    field_span := expr_span(args[1].expr)
    if args[1].expr == {
        .Ident(name, named_span) -> { field_name = Val(name); field_span = named_span }
        .Str(parts, literal_span) -> if already_elaborated && parts.len() == 1 && parts[0] == .Lit(name) { field_name = Val(name); field_span = literal_span }
        else -> {}
    }
    name :: field_name ?? {
        &diagnostics.push(e0353_bad_validate_rule(args[1].span))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return false
    }
    if !valid_shape {
        &diagnostics.push(e0353_bad_validate_rule(args[1].span))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return false
    }
    has_field :: loop field in subject_fields { if field.name == name -> break true } ?? false
    if !has_field -> &diagnostics.push(e0354_unknown_validate_field(name, field_span))
    args[1].expr = Expr.Str{parts: [StrPart]{StrPart.Lit{text: name}}, span: expr_span(args[1].expr)}
    _ := sema_check_expression(args[0].expr, Val(Type.Bool), environment, &scopes, &state, &tail_store, &context, &diagnostics)
    _ := sema_check_expression(args[2].expr, Val(Type.String), environment, &scopes, &state, &tail_store, &context, &diagnostics)
    true
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:2705-2770
// Exact literal evidence for distinct/range conversions. The Int token carrier
// may have saturated; raw spelling is the value, including U64-width literals.
fn sema_expr_method_exact_integer(value: Int, raw: String?) -> CtBigInt Never! {
    if raw == .Val(text) -> if CtBigInt.from_literal(text) == .Ok(exact) -> return exact
    CtBigInt.from_int(I64{value})
}
fn sema_expr_method_literal_in_bounds(value: CtBigInt, lo: I128, hi: I128) -> Bool Never! {
    exact :: value.try_i128() ?? return false
    exact >= lo && exact <= hi
}
fn sema_expr_method_converted_literal(argument: Expr, source: Type, base: Type, base_bounds: (lo: I128, hi: I128)?) -> (value: CtBigInt, span: Span)? {
    if argument == {
        .Int(value, literal_span, _, raw) -> {
            if !sema_expr_is_integer(source) || !sema_expr_is_integer(base) -> return None
            exact :: sema_expr_method_exact_integer(value, raw)
            if base_bounds == .Val(bounds) && !sema_expr_method_literal_in_bounds(exact, bounds.lo, bounds.hi) -> return None
            Val((value: exact, span: literal_span))
        }
        .Float(value, literal_span, _, _) -> {
            if (source != Type.Float && source != Type.Float32) || !sema_expr_is_integer(base) || !value.is_finite() -> return None
            truncated :: method_head_math.trunc(value)
            lo :: if base == Type.Int -> -9223372036854775808.0 else -> Float{(base_bounds ?? return None).lo}
            upper :: if base == Type.Int -> 9223372036854775808.0 else -> Float{(base_bounds ?? return None).hi} + 1.0
            if truncated < lo || truncated >= upper -> return None
            // Rust `as i64` saturates at this boundary even for an unsigned base.
            integer :: if truncated >= 9223372036854775808.0 -> I64{9223372036854775807} else -> I64{truncated}
            Val((value: CtBigInt.from_int(integer), span: literal_span))
        }
        else -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:3456-3487
// The slice ended inside this arm; close it with the original transparent
// alternatives (3485-3487). Do not strip any of these policy-bearing markers.
fn sema_expr_method_receiver_type(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(marker, inner) -> if marker == {
            .Internal(tag) -> if tag == .SharedGuardRead || tag == .SharedGuardEdit || tag == .TerminalFactSet || tag == .CoreCryptoNominal || tag == .SystemClock -> ty else -> inner
            else -> inner
        }
        else -> ty
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:2820-2923,3075-3138
// Missing static rows only. Caller supplies an already-resolved static owner,
// so user declarations/value bindings retain the ordinary canonical route.
fn sema_expr_method_static_gap(owner: String, method: String, owner_type_args: [Type], type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    list_from :: (owner == "Rank" || owner == "PriorityQueue") && method == "from" && args.len() == 1
    empty_new :: (owner == "PriorityQueue" || owner == "Pool" || owner == "Bits") && method == "new" && args.len() == 0
    cache_new :: owner == "Cache" && method == "new" && args.len() == 1
    cell_new :: owner == "Cell" && method == "new"
    if !list_from && !empty_new && !cache_new && !cell_new -> return SemaMethodSpecialCheck{handled: false, value: None}
    if cell_new && args.len() != 1 {
        &diagnostics.push(sema_error("E0104", span, "`Cell.new` takes exactly one value, got {args.len()}", "a `Cell<T>` stores exactly one starting value", "write `Cell.new(value)`"))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if list_from {
        list :: sema_check_expression(args[0].expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        element :: if list.ty == {.List(inner) -> inner else -> Type.Int}
        result :: Type.Apply{name: owner, args: [Type]{element}}
        operation :: if owner == "Rank" -> jet_foundation.TBuiltinOp.SortedSetFrom else -> jet_foundation.TBuiltinOp.PriorityQueueFrom
        value :: sema_tir_expr(result, TExprKind.BuiltinMethod{receiver: list, operation: operation, args: []}, span)
        return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, &diagnostics)}
    }
    generics := [TPreludeArg]{}
    result := Type.Named{name: owner}
    call_args := [jet_foundation.TCallArg]{}
    path := ""
    rooted := true
    if owner == {
        "PriorityQueue" -> {
            element :: if expected == .Val(ty) && ty == .Apply(name, rows) && name == owner && rows.len() > 0 -> rows[0] else -> Type.Int
            result = Type.Apply{name: owner, args: [Type]{element}}
            generics = [TPreludeArg]{TPreludeArg.Jet{ty: element}}
            path = "std::collections::BinaryHeap"
            rooted = false
        }
        "Pool" -> {
            element :: if type_args.len() > 0 -> type_args[0] else if owner_type_args.len() > 0 -> owner_type_args[0] else if expected == .Val(ty) && ty == .Apply(name, rows) && name == owner && rows.len() > 0 -> rows[0] else -> Type.Int
            result = Type.Apply{name: owner, args: [Type]{element}}
            generics = [TPreludeArg]{TPreludeArg.Jet{ty: element}}
            path = "jet_std::JetPool"
        }
        "Bits" -> path = "JetBitSet"
        "Cache" -> {
            key := Type.String
            item := Type.Int
            if expected == .Val(ty) && ty == .Apply(name, rows) && name == owner && rows.len() >= 2 { key = rows[0]; item = rows[1] }
            capacity :: sema_check_expression(args[0].expr, Val(Type.Int), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
            result = Type.Apply{name: owner, args: [Type]{key, item}}
            call_args = [jet_foundation.TCallArg]{sema_call_builtin_static_call_arg(capacity, args[0])}
            path = "JetCache"
        }
        "Cell" -> {
            element_expected :: if type_args.len() > 0 -> Val(type_args[0]) else if expected == .Val(ty) && ty == .Apply(name, rows) && name == owner && rows.len() > 0 -> Val(rows[0]) else -> None
            value :: sema_check_expression(args[0].expr, element_expected, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
            element :: element_expected ?? value.ty
            result = Type.Apply{name: owner, args: [Type]{element}}
            generics = [TPreludeArg]{TPreludeArg.Jet{ty: element}}
            call_args = [jet_foundation.TCallArg]{sema_call_builtin_static_call_arg(value, args[0])}
            path = "jet_std::JetCell"
        }
        else -> return SemaMethodSpecialCheck{handled: false, value: None}
    }
    reference :: TMethodRef{symbol: symbol_id(SymbolKind.Function, "", path, "new"), name: "new", mangled: false, trait_owner: None, operator_identity: None}
    value :: sema_tir_expr(result, TExprKind.StaticCall{owner: TStaticOwner.Prelude{rooted: rooted, path: path, generics: generics}, owner_type: None, method: reference, type_args: [], args: call_args}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, &diagnostics)}
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:1679-1757
fn sema_expr_method_expiring_secret(receiver: Expr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != "new" -> return SemaMethodSpecialCheck{handled: false, value: None}
    alias :: if receiver == .Field(base, "ExpiringSecret", _) && base == .Ident(name, _) -> name else -> return SemaMethodSpecialCheck{handled: false, value: None}
    if !sema_expr_core_module_alias_visible(alias, scopes) || sema_call_core_import_module(environment, alias) != Val("core.crypto.vault") -> return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != 3 {
        &diagnostics.push(wrong_core_arity("ExpiringSecret.new", 3, args.len(), span))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    value :: sema_check_expression(args[0].expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !is_expiring_secret_member_type(value.ty) -> &diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`ExpiringSecret.new` cannot own {jet_foundation.type_name(value.ty)}", "expiring secrets accept only the closed, move-only secret family with audited zeroizing Drop behavior", "convert text or bytes to `crypto.Secret`, or use `crypto.SigningKey` / `crypto.X25519SecretKey`"))
    moving := [CallArg]{args[0]}
    parameter :: SemaCallParam{label: "arg0", name: "arg0", zone: jet_foundation.ParamZone.PositionalOnly, default: None, default_ref: None, convention: jet_foundation.AccessConvention.Move, ty: Val(value.ty), variadic: false}
    ownership := sema_ownership_check_call_arguments(&state, "ExpiringSecret.new", [SemaCallParam]{parameter}, &moving, scopes, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    duration :: sema_check_expression(args[1].expr, Val(Type.Named{name: "Duration"}), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    old_borrow :: context.borrow_ctx
    context.borrow_ctx = true
    clock_checked := sema_check_expression(args[2].expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    context.borrow_ctx = old_borrow
    clock :: clock_checked ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !is_clock_type(clock.ty) -> &diagnostics.push(sema_error("E0112", expr_span(args[2].expr), "`ExpiringSecret.new` wants `Clock` for argument 3, but this is {jet_foundation.type_name(clock.ty)}", "secret expiry must observe the explicitly injected clock", "use `Clock.new(...)` for deterministic code or `Clock.system()` for production"))
    plain :: Type.Apply{name: "ExpiringSecret", args: [Type]{value.ty}}
    result :: if is_deterministic_clock_type(clock.ty) -> deterministic_clock_type(plain) else if is_system_clock_type(clock.ty) -> system_clock_type(plain) else -> plain
    constructed :: sema_tir_expr(result, TExprKind.HostCall{call: THostCall.ExpiringSecretNew{value: value, duration: duration, clock: clock, element: value.ty}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(constructed, expected, environment, &diagnostics)}
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:2577-2594
fn sema_expr_method_perf(receiver: Expr, method: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if receiver != Expr.Ident{name: "Perf", span: expr_span(receiver)} -> return SemaMethodSpecialCheck{handled: false, value: None}
    if sema_expression_type_symbol(&scopes, environment, "Perf") == .Val(symbol) && symbol.kind == SymbolKind.Type && !sema_expr_canonical_type_binding("Perf", scopes) -> return SemaMethodSpecialCheck{handled: false, value: None}
    value := sema_call_core_check_fixed(environment, "core.perf", method, type_args, args, span, expected, &scopes, &state, &tail_store, &context, &diagnostics)
    SemaMethodSpecialCheck{handled: true, value: value}
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:3018-3028,3075-3082
fn sema_expr_method_storage_events(owner: String, method: String, span: Span, events: &[MemoryEvent]) Never! {
    if method != "new" -> return
    if owner == "Shared" {
        &events.push(MemoryEvent{kind: MemoryEventKind.Allocation, span: span, source: "`shared` allocates shared storage"})
        &events.push(MemoryEvent{kind: MemoryEventKind.RetainRelease, span: span, source: "`shared` introduces reference-counted ownership"})
    }
    if owner == "Cell" -> &events.push(MemoryEvent{kind: MemoryEventKind.Allocation, span: span, source: "`Cell.new` allocates local storage"})
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:1658-1678,2424-2443
fn sema_expr_method_crypto_generate(receiver: Expr, method: String, args: [CallArg], span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != "generate" -> return SemaMethodSpecialCheck{handled: false, value: None}
    owner :: if receiver == {
        .Ident(name, _) -> {
            if sema_scope_resolve_index(scopes, name) != None -> return SemaMethodSpecialCheck{handled: false, value: None}
            name
        }
        .Field(base, leaf, _) -> {
            alias :: if base == {.Ident(name, _) -> name else -> return SemaMethodSpecialCheck{handled: false, value: None}}
            if !sema_expr_core_module_alias_visible(alias, scopes) || sema_call_core_import_module(environment, alias) != Val("core.crypto") -> return SemaMethodSpecialCheck{handled: false, value: None}
            leaf
        }
        else -> return SemaMethodSpecialCheck{handled: false, value: None}
    }
    if owner != "SigningKey" && owner != "X25519SecretKey" -> return SemaMethodSpecialCheck{handled: false, value: None}
    &diagnostics.push(sema_error("E1004", span, "`{owner}.generate` was retired", "constructors that draw entropy use `new_random` (D-SHAPE-CTORVERB1)", "use `{owner}.new_random()`"))
    loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    SemaMethodSpecialCheck{handled: true, value: None}
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:2353-2366
fn sema_expr_method_data_retired(receiver: Expr, args: [CallArg], environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if receiver != Expr.Ident{name: "Data", span: expr_span(receiver)} -> return SemaMethodSpecialCheck{handled: false, value: None}
    &diagnostics.push(data_renamed_to_datatree(expr_span(receiver)))
    loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    SemaMethodSpecialCheck{handled: true, value: None}
}

