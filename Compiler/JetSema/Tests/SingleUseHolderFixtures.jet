// Assemble with production Bootstrap sources, replacing the CLI entry.
// A record or enum holding a `#SingleUse` value owes its duty (E0140) until
// it is moved whole or each field that holds the duty is moved out.
use {
    jet_driver.[JetDriverCompileMode, jet_driver_present_diagnostics]
    jet_cli.[jet_cli_compile_file]
    jet_foundation.[DIAGNOSTIC_ERROR]
}

// The error codes `file` is refused with, in report order.
single_use_holder_errors: fn(file: String) -> [String] {
    codes := [String]{}
    checked: jet_cli_compile_file(file, false, None, JetDriverCompileMode.Program)
    if checked == {
        .Refused(refusal) -> panic("{file}: refused before checking: {refusal.stderr}")
        .Compiled(result, snapshot) -> {
            if result.internal_problem != None -> panic("{file}: internal compiler failure")
            loop diagnostic in jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files) {
                if diagnostic.severity == DIAGNOSTIC_ERROR -> codes.push(diagnostic.code)
            }
        }
    }
    codes
}

#Test("single_use_holder_fixtures") {
    dropped: single_use_holder_errors("tests/ui/ownership/single_use_holder_dropped_owes_consume.jet")
    if dropped != ["E0140", "E0140", "E0140", "E0140"] -> panic("dropped holders: {dropped}")
    consumed: single_use_holder_errors("tests/cases/single_use/holder_consumed_compiles.fixture/main.jet")
    if consumed.len() != 0 -> panic("consumed holders: {consumed}")
    containers: single_use_holder_errors("tests/ui/ownership/single_use_duty_covers_every_container.jet")
    if containers != ["E0140", "E0140", "E0140", "E0140", "E0140", "E0140"] -> panic("containers: {containers}")
    print("single-use holders: passed")
}
