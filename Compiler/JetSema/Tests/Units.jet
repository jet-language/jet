    assert_eq(unit_test_codes("#UnitFamily(Speed) {{ m_per_s }}\nfn run() {{\n v :: MPerS.from_float(3.0)\n print(\"{{(v.raw())}}\")\n}}\n"), [String]{})
    assert_eq(unit_family_type_name("m_per_s"), "MPerS")
}
#Test("currency_keeps_nominal_arithmetic_behavior") {
    assert_eq(unit_test_codes("#UnitFamily(Currency) {{ usd eur }}\nfn run() {{\n total :: 2usd * 3usd\n print(\"{{(total.raw())}}\")\n}}\n"), [String]{})
}
#Test("physical_dimension_mismatch_is_rejected_in_sema") {
    assert_eq(unit_test_codes("#UnitFamily(Length, dimension) {{ meter }}\nfn run() {{ bad :: 1meter + 1s }}\n"), [String]{"E0359"})
}
#Test("physical_value_cannot_compare_with_scalar") {
    assert_eq(unit_test_codes("#UnitFamily(Length, dimension) {{ meter }}\nfn run() {{ bad :: 1meter < 1.0 }}\n"), [String]{"E0359"})
}
#Test("dimension_exponent_limit_is_a_sema_error_not_a_panic") {
    parts := [String]{"#UnitFamily(Length, dimension) {{ meter }}\nfn run() {{\n q0 :: 1meter\n"}
    loop exponent in 1..<32 -> &parts.push(" q{exponent} :: q{exponent - 1} * q{exponent - 1}\n")
    &parts.push("}}\n")
    codes :: unit_test_codes(parts.join(""))
    found := false
    loop code in codes { if code == "E0359" -> found = true }
    assert(found)
}
#Test("quantity_generic_bound_preserves_concrete_unit_and_kind") {
    assert_eq(unit_test_codes("#UnitFamily(Length, dimension, base: meter) {{ meter }}\nfn keep<Q: Quantity<Length, .Linear>>(value: ^Q) -> Q {{ return value }}\nfn run() {{\n source :: 3meter\n value :: keep(^source)\n print(\"{{(value.raw())}}\")\n}}\n"), [String]{})
}
#Test("quantity_generic_bound_rejects_wrong_dimension_and_kind") {
    assert_eq(unit_test_codes("#UnitFamily(Length, dimension) {{ meter }}\nfn keep<Q: Quantity<Length, .Linear>>(value: ^Q) -> Q {{ return value }}\nfn run() {{\n source :: 3s\n keep(^source)\n}}\n"), [String]{"E0905"})
    assert_eq(unit_test_codes("#UnitFamily(Temperature, dimension, base: kelvin) {{ kelvin celsius(offset: 27315/100) }}\nfn keep<Q: Quantity<Temperature, .Delta>>(value: ^Q) -> Q {{ return value }}\nfn run() {{\n source :: CelsiusPoint.from_float(Float{{3.0}})\n keep(^source)\n}}\n"), [String]{"E0905"})
    assert_eq(unit_test_codes("fn choose<Q: Quantity<Length, .Linear>>() {{}}\nfn run() {{ choose() }}\n"), [String]{"E0904"})
}
#Test("imported_explicit_quantity_argument_checks_its_bound") {
    dep :: unit_test_input("pub fn keep<Q: Quantity<Length, .Linear>>(value: ^Q) -> Q {{ return value }}\n", "units", "units", "units.jet")
    main :: unit_test_input("use \"units\" as units\nfn run() {{\n source :: 1s\n bad :: units.keep<Duration>(^source)\n print(bad.raw())\n}}\n", "main", "units", "main.jet")
    graph :: unit_test_graph([SemaRegistrationModuleInput]{main, dep}, [SemaRegistrationImportEdge]{unit_test_edge(main, dep, 0)})
    stage :: sema_collect_comptime_declarations(graph, [], None)
    root :: unit_test_native.canonicalize(unit_test_path.from_text(".", unit_test_path.PathPlatform.Unix)) ?? panic("fixture root missing")
    checked :: sema_finalize_registration_graph(graph, stage, [], [], None, None, root)
    found := false
    loop diagnostic in checked.diagnostics { if diagnostic.code == "E0905" -> found = true }
    assert(found)
}
#Test("unit_member_source_dimension_composition_registration_positive") {
    // The complete original runtime fixture from unit_family.rs:282 is retained
    // here for checked producer closure. Stdout=3.0 is a separate AOT gate.
    source :: "#UnitFamily(Mass, dimension, base: kilogram) {{ kilogram }}\n#UnitFamily(Length, dimension, base: meter) {{ meter }}\n#UnitFamily(Force, dimension: Mass * Length / Time / Time, base: newton) {{ newton }}\nfn accept(force: Newton) {{ print(\"{{force.raw()}}\") }}\nfn keep<Q: Quantity<Force, .Linear>>(value: ^Q) -> Q {{ return value }}\nfn run() {{\n momentum :: 4kilogram * 3meter\n acceleration_step :: momentum / 2s\n force :: acceleration_step / 2s\n named :: 1newton\n keep(^named)\n keep(^force)\n accept(force)\n}}\n"
    assert_eq(unit_test_codes(source), [String]{})
}
#Test("canonical_time_timeout_and_sleep_spellings_compile") {
    assert_eq(unit_test_codes("use core.time.[sleep]\nfn run() {{\n #FX(authority: Time) {{\n  wait :: 500ms\n  task.timeout(wait)\n  sleep(500ms)\n }}\n}}\n"), [String]{})
}
#Test("scalar_unit_boundaries_and_nominal_currency_stay_rejected") {
    affine :: "#UnitFamily(Temperature, dimension, base: kelvin) {{\n kelvin\n celsius(scale: 1, offset: 27315/100)\n}}\n"
    assert_eq(unit_test_codes("{affine}fn run() {{ point :: CelsiusPoint.from_float(Float{{20.0}})\n bad :: point * 2 }}\n"), [String]{"E0109"})
    assert_eq(unit_test_codes("{affine}fn run() {{ point :: CelsiusPoint.from_float(Float{{20.0}})\n bad :: point * point }}\n"), [String]{"E0127"})
    length :: "#UnitFamily(Length, dimension, base: meter) {{ meter }}\n"
    assert_eq(unit_test_codes("{length}fn run() {{ bad :: 2 / 1meter\n bad_float :: 2.0 / 1meter }}\n"), [String]{"E0109", "E0109"})
    assert_eq(unit_test_codes("{length}fn run() {{ bad :: 1meter * true }}\n"), [String]{"E0109"})
    assert_eq(unit_test_codes("{length}fn run() {{ scale :: 1.5\n bad :: 1meter * scale }}\n"), [String]{"E0109"})
    assert_eq(unit_test_codes("{length}#UnitFamily(Mass, dimension, base: gram) {{ gram }}\nfn run() {{ bad :: 1meter + 1gram }}\n"), [String]{"E0359"})
    currency :: "#UnitFamily(Currency) {{ usd eur }}\n"
    assert_eq(unit_test_codes("{currency}fn run() {{ price :: Usd.from_float(Float{{2.0}})\n bad :: price * 2 }}\n"), [String]{"E0127"})
    assert_eq(unit_test_codes("{currency}fn run() {{ left :: Usd.from_float(Float{{2.0}})\n right :: Eur.from_float(Float{{3.0}})\n bad :: left * right }}\n"), [String]{"E0127"})
}

#Test("symbolic_and_measured_standard_scales_keep_one_explicit_boundary") {
    assert_eq(unit_test_codes("fn accept(value: Radian) {{}}\nfn run() {{ accept(1degree) }}\n"), [String]{})
    assert_eq(unit_test_codes("fn run() {{\n mass :: Kilogram.from_dalton_rounded(1dalton, .NearestEven, digits: 30) ?? panic(\"rounded measured conversion\")\n print(mass.value())\n print(mass.uncertainty())\n}}\n"), [String]{})
}
#Test("measure_rules_cover_fixed_lengths_and_matrix_shapes") {
    assert_eq(unit_test_codes("fn join(left: [Int#2], right: [Int#3]) -> [Int#5] {{ return left.concat(right) }}\nfn run() {{}}\n"), [String]{})
    assert_eq(unit_test_codes("fn compose(left: Matrix<3, 4>, right: Matrix<4, 2>) -> Matrix<3, 2> ComputeError! {{ return left * right }}\nfn run() {{}}\n"), [String]{})
}
#Test("affine_point_delta_algebra_and_conversion_compile") {
    source :: "#UnitFamily(Temperature, dimension, base: kelvin) {{\n kelvin\n celsius(scale: 1, offset: 27315/100)\n}}\nfn run() {{\n freezing :: CelsiusPoint.from_float(Float{{0.0}})\n step :: CelsiusDelta.from_float(Float{{5.0}})\n warmer :: freezing + step\n drift :: warmer - freezing\n total :: drift + step\n absolute :: KelvinPoint.from_celsius_point_rounded(warmer, .NearestEven, digits: 0) ?? panic(\"rounded point conversion\")\n relative :: KelvinDelta.from_celsius_delta(total) ?? panic(\"exact delta conversion\")\n print(\"{{(absolute.raw())}} {{(relative.raw())}}\")\n}}\n"
    assert_eq(unit_test_codes(source), [String]{})
}
#Test("exact_same_dimension_conversion_covers_arithmetic_arguments_and_bindings") {
    source :: "#UnitFamily(Length, dimension, base: meter) {{\n meter\n millimeter(scale: 1/1000)\n}}\nfn takes_millimeter(value: Millimeter) {{ print(\"{{(value.raw())}}\") }}\nfn run() {{\n coarse :: 3meter\n fine :: 42millimeter\n total :: coarse + fine\n takes_millimeter(3meter)\n binding :: Millimeter{{ 4meter }}\n print(\"{{(total.raw())}} {{(binding.raw())}}\")\n}}\n"
    assert_eq(unit_test_codes(source), [String]{})
}
#Test("explicit_units_policy_requires_destination_owned_conversion") {
    family :: "#UnitFamily(Length, dimension, base: meter) {{ meter millimeter(scale: 1/1000) }}\n"
    assert_eq(unit_test_codes("{family}#Policy(explicit_units)\nfn run() {{ total :: 1meter + 1millimeter\n print(\"{{(total.raw())}}\") }}\n"), [String]{"E0127"})
    assert_eq(unit_test_codes("{family}#Policy(explicit_units)\nfn run() {{ converted :: Meter.from_millimeter(1000millimeter) ?? panic(\"exact conversion\")\n total :: 1meter + converted\n print(\"{{(total.raw())}}\") }}\n"), [String]{})
    assert_eq(unit_test_codes("#Policy(explicit_units)\n{family}fn run() {{ total :: 1meter + 1millimeter\n print(total.raw()) }}\n"), [String]{"E0127"})
    assert_eq(unit_test_codes("{family}fn run() {{ #Policy(explicit_units) {{ total :: 1meter + 1millimeter\n print(total.raw()) }} }}\n"), [String]{"E0127"})
}
#Test("implicit_unit_conversion_rejects_rounding_and_overflow_boundaries") {
    assert_eq(unit_test_codes("#UnitFamily(Length, dimension, base: meter) {{ meter thirdish(scale: 2/3) }}\nfn run() {{ value :: 1meter + 1thirdish\n print(\"{{(value.raw())}}\") }}\n"), [String]{"E0127"})
    digits :: (loop _ in 0..<400 -> "9").join("")
    family :: "#UnitFamily(Length, dimension, base: meter) {{ meter giant(scale: {digits}) }}\n"
    assert_eq(unit_test_codes("{family}fn run() {{ value :: 1giant + 1meter\n print(\"{{(value.raw())}}\") }}\n"), [String]{"E0127"})
    assert_eq(unit_test_codes("{family}fn run() {{ value :: Meter.from_giant(1giant)\n print(\"{{(value.raw())}}\") }}\n"), [String]{"E0127"})
}
#Test("unit_scalar_rewrap_lint_requires_the_direct_policy_free_identity") {
    source :: "#UnitFamily(Length, base: meter) {{ meter half(scale: 1/2) }}\n#UnitFamily(Temperature, base: kelvin) {{ kelvin celsius(scale: 1, offset: 27315/100) }}\nfn external_scale(value: Float) -> Float -> calibrate(value)\nfn calibrate(value: Float) -> Float -> value * 2\nfn run() {{\n value :: Meter.from_float(Float{{4.0}})\n print(Meter.from_float(value.raw() * 2).raw())\n print(Meter.from_float(value.raw() * calibrate(2.0)).raw())\n print(Meter.from_float(value.raw() * external_scale(2.0)).raw())\n print(Meter.from_float(value.raw() * Float.from_float(calibrate(2.0))).raw())\n print(Meter.from_float(value.raw() * Float.from_float(external_scale(2.0))).raw())\n rounded :: Meter.from_half_rounded(1half, .NearestEven, digits: 0) ?? Meter.from_float(Float{{0.0}})\n print(rounded.raw())\n point :: CelsiusPoint.from_float(Float{{20.0}})\n print(CelsiusPoint.from_float(point.raw() * 2).raw())\n #Arithmetic(.Wrapping) {{ print(Meter.from_float(value.raw() * 2).raw()) }}\n}}\n"
    checked :: unit_test_checked(source)
    assert(checked.complete)
    count := 0
    loop diagnostic in checked.diagnostics { if diagnostic.code == "L0519" -> count += 1 }
    assert_eq(count, 1)
}

#Test("imported_same_leaf_units_keep_distinct_dimensions") {
    length :: unit_test_input("#UnitFamily(Length, dimension) {{ unit }}\npub fn sample() -> [[String: [Unit]]] {{ return [[\"values\": [1unit]]] }}\npub fn first(container: [[String: [Unit]]]) -> Unit {{ return container[0][\"values\"][0] }}\n", "length", "units", "length.jet")
    time :: unit_test_input("#UnitFamily(Time, dimension) {{ unit }}\npub fn sample() -> [[String: [Unit]]] {{ return [[\"values\": [1unit]]] }}\npub fn first(container: [[String: [Unit]]]) -> Unit {{ return container[0][\"values\"][0] }}\n", "time", "units", "time.jet")
    main :: unit_test_input("use \"length\" as length\nuse \"time\" as time\nfn run() {{ bad :: length.first(length.sample()) + time.first(time.sample()) }}\n", "main", "units", "main.jet")
    checked :: unit_test_checked_modules([SemaRegistrationModuleInput]{main, length, time}, [SemaRegistrationImportEdge]{unit_test_edge(main, length, 0), unit_test_edge(main, time, 1)})
    assert_eq(loop diagnostic in checked.diagnostics { if diagnostic.severity == 1 -> diagnostic.code }, [String]{"E0359"})
}
#Test("physical_dimensions_cross_file_boundaries_canonically_checked_producer") {
    // Original's generated-text assertion is retained as a separate native
    // backend witness; the complete original checked source is exercised here.
    units :: unit_test_input("#UnitFamily(Length, dimension) {{ meter }}\npub fn distance() -> Meter {{ return 12meter }}\npub fn elapsed() -> Duration {{ return 3s }}\n", "units", "units", "units.jet")
    main :: unit_test_input("use \"units\" as units\nfn run() {{\n speed :: units.distance() / units.elapsed()\n recovered :: speed * units.elapsed()\n print(\"ok\")\n}}\n", "main", "units", "main.jet")
    checked :: unit_test_checked_modules([SemaRegistrationModuleInput]{main, units}, [SemaRegistrationImportEdge]{unit_test_edge(main, units, 0)})
    assert(checked.complete)
}
#Test("exact_concrete_coercion_checked_conversion_paths") {
    source :: "#UnitFamily(Length, dimension, base: meter) {{ meter millimeter(scale: 1/1000) }}\nfn takes_meter(value: Meter) {{ print(\"{{(value.raw())}}\") }}\nfn run() {{ takes_meter(3000millimeter) }}\n"
    assert_eq(unit_test_codes(source), [String]{})
    family :: "#UnitFamily(Length, dimension, base: meter) {{ meter double(scale: 2) }}\nfn takes_meter(value: Meter) {{ print(value.raw()) }}\n"
    loop value in [String]{"0.25", "1.7976931348623157e308"} {
        assert_eq(unit_test_codes("{family}fn relay(value: Double) {{ takes_meter(value) }}\nfn run() {{ relay(Double.from_float(Float{{{value}}})) }}\n"), [String]{"E0127"})
    }
    assert_eq(unit_test_codes("{family}fn run() {{ takes_meter(Double.from_float(Float{{-1.0}})) }}\n"), [String]{})
    assert_eq(unit_test_codes("{family}fn run() {{ value :: Double.from_float(Float{{-2.0}})\n takes_meter(value) }}\n"), [String]{})
    assert_eq(unit_test_codes("{family}fn run() {{ takes_meter(Double.from_float(Float{{-0.25}})) }}\n"), [String]{"E0127"})
    assert_eq(unit_test_codes("#UnitFamily(Length, dimension, base: meter) {{ meter alias(scale: 1) }}\nfn takes_meter(value: Meter) {{ print(value.raw()) }}\nfn relay(value: Alias) {{ takes_meter(value) }}\nfn run() {{ relay(Alias.from_float(Float{{0.25}})) }}\n"), [String]{})
}
