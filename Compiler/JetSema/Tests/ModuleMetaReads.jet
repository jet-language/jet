// A module carries its Module record when some user source reads it as a
// value. Compiler-owned text never does: the loader decides whether
// core.meta loads from the user sources alone, so a word of the Prelude's
// text (the `a` of "send on a closed channel") must not mark a user module
// named `a` as read.
use {
    jet_foundation.[
        ModuleTable,
        Span,
        module_intern,
        module_table,
        name_find,
    ]
    jet_parser.[parse_generated_source]
    jet_sema.[
        SemaRegistrationForeignHandleFacts,
        SemaRegistrationModuleInput,
        SemaSourceOrigin,
        SemaSourceSegment,
        sema_module_meta_mark_reads,
        sema_registration_original_error_module,
    ]
}

module_meta_user_input: fn(table: ^ModuleTable, source: ^^String) -> SemaRegistrationModuleInput {
    ^parsed: parse_generated_source(source.bytes())
    if parsed.diagnostics.len() != 0 -> panic("fixture did not parse")
    segment: SemaSourceSegment{generated: Span{start: 0, end: source.len()}, source_file: "user/main.jet", source_start: 0, line_starts: [Int]{0}, origin: SemaSourceOrigin.Snapshot}
    SemaRegistrationModuleInput{package_identity: "source-root:user", module_identity: module_intern(table, "user/main"), module_name: "main", core_source_alias: "", module_path: "main.jet", source_file: "user/main.jet", source_segments: [SemaSourceSegment]{segment}, source_origin: SemaSourceOrigin.Snapshot, program: parsed.program.move(), foreign_handles: [SemaRegistrationForeignHandleFacts]{}, source: source.move()}
}

// Whether the user module of `source`, loaded beside the Prelude's error
// module, finds module `name` among the modules read as values.
module_meta_reads_name: fn(source: ^^String, name: String) -> Bool {
    ^table: module_table()
    user: module_meta_user_input(table, source.move())
    errors: sema_registration_original_error_module(table)
    if !errors.source.contains("on a closed channel") {
        panic("the Prelude error text no longer holds the word `a`")
    }
    ^inputs: [SemaRegistrationModuleInput]{user, errors}
    sema_module_meta_mark_reads(inputs)
    name_find(inputs[0].meta.reads, name) != None
}

#Test("module reads: the Prelude's text reads no one-letter inline module") {
    assert(
        !module_meta_reads_name(
            `a: module {
    World: struct {}
}

run: fn() {
    w: a.World{}
    print(w)
}
`,
            "a",
        ),
    )
}

#Test("module reads: a user's value read still marks the module") {
    assert(
        module_meta_reads_name(
            `a: module {
    World: struct {}
}

run: fn() {
    print(a.name)
}
`,
            "a",
        ),
    )
}
