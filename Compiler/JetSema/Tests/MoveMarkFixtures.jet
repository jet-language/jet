// Assemble with production Bootstrap sources, replacing the CLI entry.
// An explicit `.move()` never lowers to a copy: a call argument `p.move()` / `p.f.move()`
// on a read parameter is E0201, `xs[i].move()` is E0225, and on an owned root it
// is a checked move.
use {
    jet_driver.[JetDriverCompileMode, jet_driver_present_diagnostics]
    jet_cli.[jet_cli_compile_file]
    jet_foundation.[DIAGNOSTIC_ERROR]
}

move_mark_fixture_reject: fn(file: String, code: String) {
    checked: jet_cli_compile_file(file, false, None, JetDriverCompileMode.Program)
    if checked == {
        .Refused(refusal) -> {
            if !refusal.stderr.contains(code) -> panic("{file}: refusal lost {code}")
            return
        }
        .Compiled(result, snapshot) -> {
            if result.internal_problem != None -> panic("{file}: internal compiler failure")
            loop diagnostic in jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files) {
                if diagnostic.severity == DIAGNOSTIC_ERROR && diagnostic.code == code -> return
            }
            panic("{file}: expected checked refusal {code}")
        }
    }
}

move_mark_fixture_accept: fn(file: String) {
    checked: jet_cli_compile_file(file, false, None, JetDriverCompileMode.Program)
    if checked == {
        .Refused(refusal) -> panic("{file}: {refusal.stderr}")
        .Compiled(result, snapshot) -> {
            if result.internal_problem != None -> panic("{file}: internal compiler failure")
            loop diagnostic in jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files) {
                if diagnostic.severity == DIAGNOSTIC_ERROR -> panic("{file}: unexpected {diagnostic.code}")
            }
        }
    }
}

#Test("move_mark_fixtures") {
    fixture_root: "Compiler/JetSema/Tests/fixtures"
    move_mark_fixture_reject("{fixture_root}/MoveReadParamArgument.fixture/MoveReadParamArgument.jet", "E0201")
    move_mark_fixture_reject("{fixture_root}/MoveReadParamFieldArgument.fixture/MoveReadParamFieldArgument.jet", "E0201")
    move_mark_fixture_reject("{fixture_root}/MoveReadParamPush.fixture/MoveReadParamPush.jet", "E0201")
    move_mark_fixture_reject("{fixture_root}/MoveElementArgument.fixture/MoveElementArgument.jet", "E0225")
    move_mark_fixture_reject("{fixture_root}/MoveElementPush.fixture/MoveElementPush.jet", "E0225")
    move_mark_fixture_reject("{fixture_root}/MovePayloadReadParam.fixture/MovePayloadReadParam.jet", "E0201")
    move_mark_fixture_reject("{fixture_root}/MovePayloadSubjectReuse.fixture/MovePayloadSubjectReuse.jet", "E0121")
    move_mark_fixture_reject("{fixture_root}/MoveStaticReadParam.fixture/MoveStaticReadParam.jet", "E0201")
    move_mark_fixture_reject("{fixture_root}/MoveStaticReuse.fixture/MoveStaticReuse.jet", "E0121")
    move_mark_fixture_accept("{fixture_root}/MoveOwnedParamArgument.fixture/MoveOwnedParamArgument.jet")
    move_mark_fixture_accept("{fixture_root}/MovePayloadOwned.fixture/MovePayloadOwned.jet")
    move_mark_fixture_accept("{fixture_root}/MovePayloadMovedSubject.fixture/MovePayloadMovedSubject.jet")
    print("explicit move marks on call arguments: passed")
}
