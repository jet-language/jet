// #6251 c1: a `fn(…) { … }` lambda checks as a function
// value. The call fixes what a passed lambda leaves out, and a written result
// is the type its body must produce.
fn_lambda_errors: fn(source: String) -> [String] {
    codes := [String]{}
    loop diagnostic in core_failure_record_diagnostics(source, "user/fixture") {
        if diagnostic.code.starts_with("E") -> codes.push("{diagnostic.code}: {diagnostic.what}")
    }
    codes
}

#Test("fn_lambda_fixtures") {
    accepted: `apply: fn(f: fn(Int) -> Int, n: Int) -> Int { f(n) }
run: fn() {
    a: apply(fn(n) { n * 2 }, 3)
    square: fn(n: Int) -> Int { n * n }
    b: apply(square, a)
    c: apply(fn(n: Int) -> Int {
        doubled: n * 2
        if doubled > 100 -> return 0
        doubled + 1
    }, b)
    d: apply(fn(n) { n - c }, c)
}
`
    assert_eq(fn_lambda_errors(accepted).join("; "), "")
    stored_mismatch: `run: fn() {
    bad: fn(n: Int) -> Int { "text" }
}
`
    assert(fn_lambda_errors(stored_mismatch).len() > 0, "a stored lambda's body must produce its written result")
    passed_mismatch: `apply: fn(f: fn(Int) -> Int, n: Int) -> Int { f(n) }
run: fn() {
    a: apply(fn(n) -> String { "x" }, 1)
}
`
    assert(fn_lambda_errors(passed_mismatch).len() > 0, "a written result must match the expected callable type")
}

#Test("a named function that can't fail binds a callback's failure parameter to Never") {
    accepted: `apply: fn<E>(f: fn(Int) -> Int? E!, n: Int) -> Int? E! { f(n) }
step: fn<E>(f: fn(Int) -> Int E!, n: Int) -> Int E! { f(n) }
run: fn() {
    lower: fn(n: Int) -> Int? {
        if n > 0 -> Val(n - 1) else -> None
    }
    a: apply(lower, 4) ?? 0
    next: fn(n: Int) -> Int { n + 1 }
    b: step(next, a)
    assert(b > 0)
}
`
    assert_eq(fn_lambda_errors(accepted).join("; "), "")
}

#Test("a stored lambda that writes a captured local refuses that local's later use") {
    holder: `Holder: struct {
    action: fn() -[]>,
}
`
    in_field: `run: fn() {
    k := 0
    h: Holder{action: fn() { k += 1 }}
    h.action()
    print(k)
}
`
    in_list: `run: fn() {
    j := 0
    list: [fn() -[]>]{fn() { j += 1 }}
    act: list[0]
    act()
    print(j)
}
`
    by_method: `run: fn() {
    items := [Int]{}
    h: Holder{action: fn() { items.push(1) }}
    h.action()
    print(items.len())
}
`
    assigned_later: `run: fn() {
    n := 0
    stored: fn() { n += 1 }
    kept: [stored]
    act: kept[0]
    act()
    n = 5
}
`
    loop body in [in_field, in_list, by_method, assigned_later] {
        source: "{holder}{body}"
        found: fn_lambda_errors(source)
        assert(found.len() == 1 && found[0].starts_with("E0204") && found[0].contains("stored lambda"), "{found.join("; ")}: {source}")
    }
    accepted: `counter: fn() -> fn() -> Int {
    n := 0
    fn() {
        n += 1
        n
    }
}
fill: fn(values: &[Int]) {
    h: Holder{action: fn() { values.push(1) }}
    h.action()
    print(values.len())
}
run: fn() {
    k := 0
    bump: fn(n: Int) { k += n }
    bump(2)
    print(k)
    tick: counter()
    print(tick())
    values := [Int]{}
    fill(values)
    base := 10
    reads: [fn() -[]> Int]{fn() { base + 1 }}
    base = 20
    read: reads[0]
    print(read() + base)
}
`
    assert_eq(fn_lambda_errors("{holder}{accepted}").join("; "), "")
}
