// A reflection record folded into a program value keeps the members its Core
// record rows declare and the ones the compiler answers from: a TypeId's
// handle and table, which name the type row it is read back by.
use {
    jet_sema.[sema_fact_declared_value]
    jet_foundation.[TComptimeField, TComptimeValue, comptime_type_id_row]
}

// A TypeId of row `handle` in the compile's own table, with every declared
// member present.
fact_declared_type_id: fn(handle: Int) -> TComptimeValue {
    TComptimeValue.Struct{
        type_name: "TypeId",
        fields: [TComptimeField]{
            TComptimeField{name: "identity", value: TComptimeValue.String{value: "geo.Point"}},
            TComptimeField{name: "name", value: TComptimeValue.String{value: "Point"}},
            TComptimeField{name: "generic_bindings", value: TComptimeValue.List{values: [TComptimeValue]{}}},
            TComptimeField{name: "handle", value: TComptimeValue.Int{value: handle}},
            TComptimeField{name: "table", value: TComptimeValue.Int{value: 0}},
        },
    }
}

#Test("a folded TypeId keeps the handle and table it is read back by") {
    folded: sema_fact_declared_value(fact_declared_type_id(40))
    row: comptime_type_id_row(folded) ?? panic("the folded TypeId names no row: {folded:Debug}")
    assert_eq(Int{row.id}, 40)
}

#Test("a TypeId nested in a folded record keeps its handle") {
    field: TComptimeValue.Struct{
        type_name: "LayoutField",
        fields: [TComptimeField]{
            TComptimeField{name: "name", value: TComptimeValue.String{value: "x"}},
            TComptimeField{name: "type", value: fact_declared_type_id(41)},
        },
    }
    folded: sema_fact_declared_value(TComptimeValue.List{values: [TComptimeValue]{field}})
    ^kept: -1
    if folded == .List(values) && values.len() == 1 && values[0] == .Struct(_, fields) {
        loop member in fields {
            if member.name == "type" && comptime_type_id_row(member.value) == .Val(row) {
                kept = Int{row.id}
            }
        }
    }
    assert_eq(kept, 41)
}
