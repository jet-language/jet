// A network handle method call is typed from one row table: each form of a
// method is a row whose parameter count is its arity, so the known methods,
// the owner's Core module, the arity diagnostic and the canonical spellings
// all read the same rows.
use jet_sema.[
    SEMA_NETWORK_HANDLE_METHODS,
    SEMA_NETWORK_HANDLE_METHODS_CHECKED,
    sema_network_handle_dispatch_name,
    sema_network_handle_expected_arity,
    sema_network_handle_known_method,
    sema_network_handle_method_row,
    sema_network_handle_owner_module,
]

#Test("a method form is found by owner, method and arity") {
    row: sema_network_handle_method_row("TCPStream", "read_into", 3) ?? panic("TCPStream.read_into with 3 arguments has no row")
    assert_eq(SEMA_NETWORK_HANDLE_METHODS[row].params.len(), 3)
    assert_eq(SEMA_NETWORK_HANDLE_METHODS[row].params[0].name, "buffer")
    assert(SEMA_NETWORK_HANDLE_METHODS[row].params[0].write, "`read_into` writes its buffer in place")
    assert(SEMA_NETWORK_HANDLE_METHODS[row].params[2].label_only, "the deadline is passed by label")
    assert(sema_network_handle_method_row("TCPStream", "read_into", 1) == None, "TCPStream.read_into has no 1-argument form")
    assert(sema_network_handle_method_row("TCPStream", "send", 1) == None, "TCPStream has no `send`")
    assert_eq(SEMA_NETWORK_HANDLE_METHODS_CHECKED, SEMA_NETWORK_HANDLE_METHODS.len())
}

#Test("the expected arity lists a method's forms") {
    assert_eq(sema_network_handle_expected_arity("TCPStream", "read"), "0, 1, or 2")
    assert_eq(sema_network_handle_expected_arity("TCPListener", "accept"), "0 or 1")
    assert_eq(sema_network_handle_expected_arity("TCPStream", "read_into"), "2 or 3")
    assert_eq(sema_network_handle_expected_arity("UDPSocket", "send_to"), "3")
    assert_eq(sema_network_handle_expected_arity("WsMessage", "text"), "0")
}

#Test("an owner's methods, module and canonical spelling come from its rows") {
    assert(sema_network_handle_known_method("WsConn", "recv"))
    assert(!sema_network_handle_known_method("WsConn", "read"))
    assert(!sema_network_handle_known_method("Socket", "read"))
    assert_eq(sema_network_handle_owner_module("UnixStream"), "core.net")
    assert_eq(sema_network_handle_owner_module("WsMessage"), "core.net.ws")
    assert_eq(sema_network_handle_owner_module("Socket"), "")
    assert_eq(sema_network_handle_dispatch_name("<corelib>/core.net::TCPStream"), Val("TCPStream"))
    assert_eq(sema_network_handle_dispatch_name("<corelib>/core.net.ws::WsConn"), Val("WsConn"))
    assert_eq(sema_network_handle_dispatch_name("UDPSocket"), Val("UDPSocket"))
    assert(sema_network_handle_dispatch_name("<corelib>/core.net::WsConn") == None, "WsConn is not core.net's")
}
