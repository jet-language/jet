// Regression tests for #7032 c6 task safety on changeable module storage
// globals: `task.group` workers may borrow and disjointly write globals,
// `para_map` may read sendable globals, and `Shared` holders stay usable in
// any task; outliving handle tasks, `Group`-parameter spawns, concurrent races,
// `para_map` writes, and detaching global-borrowing tasks are refused.
use {
    jet_foundation.[Diagnostic]
}

global_state_task_count: fn(diagnostics: [Diagnostic], code: String) -> Int {
    ^count: 0
    loop item in diagnostics {
        if item.code == code -> count += 1
    }
    count
}

#Test("global_state_task_group_and_para_reads_allowed") {
    diagnostics: global_state_purity_compile("Compiler/JetSema/Tests/Fixtures/GlobalStateTaskAllowed.fixture/TaskAllowed.jet")
    if diagnostics.len() != 0 {
        panic("expected 0 errors, got {diagnostics.len()}: {global_state_purity_show(diagnostics)}")
    }
}

#Test("global_state_task_outliving_and_group_param_refused_e1102") {
    diagnostics: global_state_purity_compile("Compiler/JetSema/Tests/Fixtures/GlobalStateTaskOutliving.fixture/TaskOutliving.jet")
    count: global_state_task_count(diagnostics, "E1102")
    if count != 3 {
        panic("expected 3 E1102 errors, got {count} (total {diagnostics.len()}): {global_state_purity_show(diagnostics)}")
    }
}

#Test("global_state_task_races_and_detach_refused") {
    diagnostics: global_state_purity_compile("Compiler/JetSema/Tests/Fixtures/GlobalStateTaskRaces.fixture/TaskRaces.jet")
    e1101: global_state_task_count(diagnostics, "E1101")
    e1106: global_state_task_count(diagnostics, "E1106")
    if e1101 != 3 || e1106 != 1 {
        panic("expected 3 E1101 and 1 E1106, got {e1101} E1101 and {e1106} E1106: {global_state_purity_show(diagnostics)}")
    }
}

#Test("global_state_export_c_and_raw_words") {
    diagnostics: global_state_purity_compile("Compiler/JetSema/Tests/Fixtures/GlobalStateExportSafety.fixture/ExportSafety.jet")
    e3203: global_state_task_count(diagnostics, "E3203")
    if e3203 != 2 || diagnostics.len() != 2 {
        panic("expected 2 E3203 errors, got {e3203} E3203 (total {diagnostics.len()}): {global_state_purity_show(diagnostics)}")
    }
}

#Test("global_state_transitive_task_and_para_races") {
    diagnostics: global_state_purity_compile("Compiler/JetSema/Tests/Fixtures/GlobalStateTransitiveRaces.fixture/TransitiveRaces.jet")
    e1101: global_state_task_count(diagnostics, "E1101")
    e1106: global_state_task_count(diagnostics, "E1106")
    if e1101 != 5 || e1106 != 1 || diagnostics.len() != 6 {
        panic("expected 5 E1101 and 1 E1106, got {e1101} E1101 and {e1106} E1106 (total {diagnostics.len()}): {global_state_purity_show(diagnostics)}")
    }
}
