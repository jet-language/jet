// Unsafe obligations over the compiler's own sources.
use {
    jet_foundation.[AST_NODE_GENERATED, Expr, GateSet, PolicyDeclaration, PolicyKey, PolicyScope, PolicyValue, Span, Type]
    jet_parser.[parse_source]
    jet_sema.[SemaGateModule, SemaUnsafeOperation, UnsafeInspection, sema_unsafe_expr_operations, sema_unsafe_inspect, sema_unsafe_unit_map]
}

unsafe_test_require: fn(ok: Bool, message: String) Never! {
    if !ok -> panic("UnsafeObligations: {message}")
}

unsafe_test_inspect: fn(source: String, policy: PolicyValue) -> UnsafeInspection Never! {
    parsed: parse_source(source.bytes())
    unsafe_test_require(parsed.diagnostics.len() == 0, "fixture parse: {parsed.diagnostics:Debug}")
    declaration: PolicyDeclaration{key: PolicyKey.Unsafe, value: policy, scope: PolicyScope.Package, span: Span{start: 0, end: 0}, target: None, source: "package.jet"}
    sema_unsafe_inspect([SemaGateModule{source: "app.jet", program: parsed.program, declarations: [declaration]}], GateSet{})
}

run: fn() Never! {
    source: "run: fn() {{\n#Unsafe(\"cell stays live\") {{\n^p: *cell\nassert no_alias\n^x: p.*\nassert aligned, valid_ptr, valid_ptr\n}}\n}}\n"
    tracked: unsafe_test_inspect(source, PolicyValue.Obligations)
    unsafe_test_require(tracked.gates.len() == 1, "one gate")
    unsafe_test_require(tracked.gates[0].mode == "Obligations", "resolved obligation mode")
    unsafe_test_require(tracked.gates[0].operations.len() == 2, "pointer and dereference")
    unsafe_test_require(tracked.gates[0].operations[0].kind == "raw_pointer", "operation kind")
    unsafe_test_require(tracked.gates[0].operations[0].discharged && tracked.gates[0].operations[1].discharged, "adjacent proofs discharge")
    unsafe_test_require(tracked.gates[0].operations[1].asserted == ([String]{"aligned", "valid_ptr"}), "assertions sorted and deduplicated")
    unsafe_test_require(tracked.diagnostics.len() == 0, "valid obligations")
    missing: unsafe_test_inspect("run: fn() {{ #Unsafe(\"live\") {{ ^x: p.* }} }}", PolicyValue.Obligations)
    unsafe_test_require(missing.diagnostics.len() == 1 && missing.diagnostics[0].diagnostic.code == "E3107", "missing proof diagnostic")
    unsafe_test_require(!missing.gates[0].operations[0].discharged, "missing proof retained")
    ordinary: unsafe_test_inspect("run: fn() {{ #Unsafe(\"live\") {{ ^x: p.* }} }}", PolicyValue.Default)
    unsafe_test_require(ordinary.gates[0].operations[0].discharged && ordinary.diagnostics.len() == 0, "gate-only mode retains operation without demanding proof")
    nested: unsafe_test_inspect("run: fn() {{ #Unsafe(\"outer\") {{ ^x: p.*\n#Unsafe(\"inner\") {{ ^y: q.*\nassert valid_ptr, aligned }}\nassert valid_ptr, aligned }} }}", PolicyValue.Obligations)
    unsafe_test_require(nested.gates.len() == 2 && nested.gates[0].operations.len() == 1 && nested.gates[1].operations.len() == 1, "nested gate proofs remain independent")
    unsafe_test_require(nested.diagnostics.len() == 2, "nested gate breaks proof adjacency")
    outside: unsafe_test_inspect("run: fn() {{ assert valid_ptr }}", PolicyValue.Default)
    unsafe_test_require(outside.diagnostics.len() == 1 && outside.diagnostics[0].diagnostic.code == "E3108", "outside-gate assertion")
    denied: unsafe_test_inspect(source, PolicyValue.Forbid)
    unsafe_test_require(denied.diagnostics[0].diagnostic.code == "E3105", "outer refusal")
    per_site: unsafe_test_inspect(source, PolicyValue.PerSite)
    unsafe_test_require(per_site.diagnostics[0].diagnostic.code == "E3106", "per-site needs mode")
    parsed: parse_source(source.bytes())
    restricted: sema_unsafe_inspect([SemaGateModule{source: "app.jet", program: parsed.program, policy_path: Val("src/app.jet"), unsafe_paths: Val([String]{"src/audited"})}], GateSet{})
    unsafe_test_require(restricted.diagnostics[0].diagnostic.code == "E2960", "package path refusal")
    raw: parse_source("run: fn() {{ #Unsafe(\"live\") {{ ^q: mem.alloc_raw(16, 8)\n^x: q.offset(1)\nmem.copy(x, q, 1) }} }}".bytes())
    outside_kernel: sema_unsafe_inspect([SemaGateModule{source: "app.jet", program: raw.program, policy_path: Val("src/app.jet"), memory_kernel: Val([String]{"src/kernel"})}], GateSet{})
    // alloc_raw, offset and copy: each is refused.
    unsafe_test_require(outside_kernel.diagnostics.len() == 3, "each raw memory call outside the kernel is refused")
    loop refused in outside_kernel.diagnostics {
        unsafe_test_require(refused.diagnostic.code == "E3113", "raw memory refusal code")
    }
    unsafe_test_require(outside_kernel.gates[0].operations.len() == 0 && outside_kernel.gates[0].memory_operations.len() == 3, "raw memory calls carry no obligation")
    inside_kernel: sema_unsafe_inspect([SemaGateModule{source: "app.jet", program: raw.program, policy_path: Val("src/kernel/app.jet"), memory_kernel: Val([String]{"src/kernel"})}], GateSet{})
    unsafe_test_require(inside_kernel.diagnostics.len() == 0, "a kernel file holds raw memory calls")
    // A bulk List move reads or writes raw memory too; its address is the
    // raw pointer, never the List.
    moves: parse_source("run: fn() {{ #Unsafe(\"live\") {{ ^_: mem.list_append<U8>(bytes, p, n)\nmem.list_copy<U8>(q, bytes, 0, n) }} }}".bytes())
    moves_refused: sema_unsafe_inspect([SemaGateModule{source: "app.jet", program: moves.program, policy_path: Val("src/app.jet"), memory_kernel: Val([String]{"src/kernel"})}], GateSet{})
    unsafe_test_require(moves_refused.diagnostics.len() == 2 && moves_refused.diagnostics[0].diagnostic.what.contains("`list_append`") && moves_refused.diagnostics[1].diagnostic.what.contains("`list_copy`"), "each bulk List move outside the kernel is refused: {moves_refused.diagnostics:Debug}")
    moved: moves_refused.gates[0].memory_operations
    unsafe_test_require(moved.len() == 2 && moved[0].address.len() == 1 && moved[0].address[0] == "p" && moved[1].address.len() == 1 && moved[1].address[0] == "q", "a bulk List move's address is its raw pointer")
    // The sentry's mapping account stands only in the kernel's mapping
    // primitives: even a kernel file or a single program elsewhere is refused.
    account: parse_source("run: fn() {{ #Unsafe(\"fresh\") {{ mem.mapped(p, n)\nmem.unmapping(p, n) }} }}".bytes())
    keeper: sema_unsafe_inspect([SemaGateModule{source: "Linux.jet", program: account.program, policy_path: Val("Source/OS/Linux.jet"), memory_kernel: Val([String]{"Source/OS/Linux.jet"}), package_identity: "package:11:jet_backend:0.0.1"}], GateSet{})
    unsafe_test_require(keeper.diagnostics.len() == 0 && keeper.gates[0].memory_operations.len() == 2 && keeper.gates[0].memory_operations[0].address.len() == 0, "the mapping primitives keep the sentry's account: {keeper.diagnostics:Debug}")
    loader: sema_unsafe_inspect([SemaGateModule{source: "Loader.jet", program: account.program, policy_path: Val("Source/Image/Loader.jet"), memory_kernel: Val([String]{"Source/Image/Loader.jet"}), package_identity: "package:11:jet_backend:0.0.1"}], GateSet{})
    unsafe_test_require(loader.diagnostics.len() == 2 && loader.diagnostics[0].diagnostic.code == "E3113" && loader.diagnostics[0].diagnostic.what.contains("`mapped`") && loader.diagnostics[1].diagnostic.what.contains("`unmapping`"), "another kernel file is refused: {loader.diagnostics:Debug}")
    lone: sema_unsafe_inspect([SemaGateModule{source: "app.jet", program: account.program, policy_path: Val("app.jet")}], GateSet{})
    unsafe_test_require(lone.diagnostics.len() == 2, "a single program is refused too: {lone.diagnostics:Debug}")
    no_kernel: sema_unsafe_inspect([SemaGateModule{source: "app.jet", program: parsed.program, policy_path: Val("src/app.jet"), memory_kernel: Val([String]{})}], GateSet{})
    // The raw pointer `*cell` and the dereference `p.*`.
    unsafe_test_require(no_kernel.diagnostics.len() == 2 && no_kernel.diagnostics[0].diagnostic.code == "E3113", "a package naming no kernel refuses raw pointers")
    single_program: sema_unsafe_inspect([SemaGateModule{source: "app.jet", program: raw.program, policy_path: Val("app.jet")}], GateSet{})
    unsafe_test_require(single_program.diagnostics.len() == 0, "a single program is its own kernel")
    // The runtime's raw intrinsics are raw memory operations too, a system
    // call only when it maps memory (mmap is 9, exit 231).
    intrinsics: parse_source("run: fn() {{ #Unsafe(\"live\") {{ ^x: os_load_i64(p)\nos_store_u8(p, I64{{1}})\n^_: os_syscall_i64(I64{{9}}, I64{{0}})\n^_: os_syscall_i64(I64{{231}}, I64{{1}})\nos_copy_ascending_i64(p, q, n) }} }}".bytes())
    os_refused: sema_unsafe_inspect([SemaGateModule{source: "app.jet", program: intrinsics.program, policy_path: Val("src/app.jet"), memory_kernel: Val([String]{"src/kernel"})}], GateSet{})
    unsafe_test_require(os_refused.diagnostics.len() == 4, "each raw intrinsic outside the kernel is refused: {os_refused.diagnostics:Debug}")
    loop refused in os_refused.diagnostics {
        unsafe_test_require(refused.diagnostic.code == "E3113", "raw intrinsic refusal code")
    }
    unsafe_test_require(os_refused.diagnostics[0].diagnostic.what.contains("`os_load_i64`") && os_refused.diagnostics[2].diagnostic.what.contains("`os_syscall_i64`"), "the intrinsic is named")
    os_kernel: sema_unsafe_inspect([SemaGateModule{source: "app.jet", program: intrinsics.program, policy_path: Val("src/kernel/app.jet"), memory_kernel: Val([String]{"src/kernel"})}], GateSet{})
    unsafe_test_require(os_kernel.diagnostics.len() == 0, "a kernel file holds raw intrinsics")
    // The kernel map primitive's untracked forms are raw mapping calls too.
    untracked: parse_source("run: fn() {{ #Unsafe(\"fresh\") {{ ^p: os_map_untracked_i64(I64{{0}}, n, I64{{3}}, I64{{34}}, I64{{-1}}, I64{{0}})\n^q: os_remap_untracked_i64(p, n, m, I64{{1}})\n^_: os_unmap_untracked_i64(q, m) }} }}".bytes())
    untracked_refused: sema_unsafe_inspect([SemaGateModule{source: "app.jet", program: untracked.program, policy_path: Val("src/app.jet"), memory_kernel: Val([String]{"src/kernel"})}], GateSet{})
    unsafe_test_require(untracked_refused.diagnostics.len() == 3 && untracked_refused.diagnostics[0].diagnostic.code == "E3113" && untracked_refused.diagnostics[0].diagnostic.what.contains("`os_map_untracked_i64`") && untracked_refused.diagnostics[1].diagnostic.what.contains("`os_remap_untracked_i64`") && untracked_refused.diagnostics[2].diagnostic.what.contains("`os_unmap_untracked_i64`"), "the untracked map, remap and unmap outside the kernel are refused: {untracked_refused.diagnostics:Debug}")
    untracked_kernel: sema_unsafe_inspect([SemaGateModule{source: "app.jet", program: untracked.program, policy_path: Val("src/kernel/app.jet"), memory_kernel: Val([String]{"src/kernel"})}], GateSet{})
    unsafe_test_require(untracked_kernel.diagnostics.len() == 0, "a kernel file maps untracked: {untracked_kernel.diagnostics:Debug}")
    // A composed runtime unit answers per source: its marks name each
    // source, and a refusal names the source's own path and line.
    unit_text: "\n// [unit source: R/Kernel.jet]\nkeep: fn() {{ #Unsafe(\"live\") {{ ^x: os_load_i64(p) }} }}\n// [unit source: R/Host.jet]\n\nrun: fn() {{ #Unsafe(\"live\") {{ ^y: os_load_i64(p) }} }}\n"
    unit_parsed: parse_source(unit_text.bytes())
    unit_map: sema_unsafe_unit_map("package:11:jet_runtime:", unit_text) ?? panic("UnsafeObligations: a runtime unit maps its sources")
    unsafe_test_require(unit_map.sources.len() == 2 && unit_map.sources[1].path == "R/Host.jet" && unit_map.sources[1].line == 5, "unit sources and their first lines")
    unsafe_test_require(sema_unsafe_unit_map("package:3:app:", unit_text) == None, "another package's marks rename nothing")
    unit_refused: sema_unsafe_inspect([SemaGateModule{source: "unit.jet", program: unit_parsed.program, policy_path: Val("unit.jet"), memory_kernel: Val([String]{"R/Kernel.jet"}), unit: Val(unit_map)}], GateSet{})
    unsafe_test_require(unit_refused.diagnostics.len() == 1 && unit_refused.diagnostics[0].diagnostic.code == "E3113", "only the non-kernel source is refused: {unit_refused.diagnostics:Debug}")
    unsafe_test_require(unit_refused.diagnostics[0].diagnostic.what.starts_with("`os_load_i64` at R/Host.jet:2 is") && unit_refused.diagnostics[0].diagnostic.fix.contains("`R/Host.jet`"), "the refusal names the source and line: {unit_refused.diagnostics:Debug}")
    // A kernel file's public function may not carry a caller's address to a
    // raw operation, nor may a kernel record's public field; a `priv` function,
    // a `priv` field and an `#Unsafe` function may.
    kernel: parse_source("peek: fn(address: Int) -> Int {{\n#Unsafe(\"the caller hands a live cell\") {{\np: mem.Ptr<Int>.from_addr(address)\nreturn mem.volatile_read(p)\n}}\n}}\npriv inner: fn(address: Int) -> Int {{\n#Unsafe(\"only kernel code calls this\") {{\nreturn mem.Ptr<Int>.from_addr(address).*\n}}\n}}\n#Unsafe(\"each caller vouches for the address\") raw: fn(address: Int) -> Int {{\nreturn mem.Ptr<Int>.from_addr(address).*\n}}\nbounded: fn(index: Int) -> Int {{\n#Unsafe(\"the index stays inside the owned cells\") {{\nreturn mem.volatile_read(owned().offset(index))\n}}\n}}\nCell: struct {{\nbase: Int,\npriv held: Int,\nread: fn(self) -> Int {{\n#Unsafe(\"the cell owns its storage\") {{\nreturn mem.Ptr<Int>.from_addr(self.base).* + mem.Ptr<Int>.from_addr(self.held).*\n}}\n}}\n}}\n".bytes())
    unsafe_test_require(kernel.diagnostics.len() == 0, "kernel fixture parse: {kernel.diagnostics:Debug}")
    boundary: sema_unsafe_inspect([SemaGateModule{source: "cell.jet", program: kernel.program, policy_path: Val("src/kernel/cell.jet"), memory_kernel: Val([String]{"src/kernel"})}], GateSet{})
    unsafe_test_require(boundary.diagnostics.len() == 2, "one refusal per caller-chosen address: {boundary.diagnostics:Debug}")
    loop refused in boundary.diagnostics {
        unsafe_test_require(refused.diagnostic.code == "E3114", "kernel address refusal code")
    }
    unsafe_test_require(boundary.diagnostics[0].diagnostic.what.contains("`peek`") && boundary.diagnostics[1].diagnostic.what.contains("`Cell.base`"), "the parameter and the public field are named")
    // The runtime's kernel answers the same rule: its address helpers are
    // `priv`, so a public one raises E3114 there too, in a package check and
    // in a composed runtime unit alike.
    runtime_kernel: sema_unsafe_inspect([SemaGateModule{source: "cell.jet", program: kernel.program, policy_path: Val("src/kernel/cell.jet"), memory_kernel: Val([String]{"src/kernel"}), package_identity: "package:11:jet_runtime:0.0.1"}], GateSet{})
    unsafe_test_require(runtime_kernel.diagnostics.len() == 2 && runtime_kernel.diagnostics[0].diagnostic.code == "E3114", "the runtime package's kernel answers E3114: {runtime_kernel.diagnostics:Debug}")
    runtime_unit_text: "\n// [unit source: R/Kernel.jet]\npeek: fn(address: Int) -> Int {{ #Unsafe(\"live\") {{ return mem.Ptr<Int>.from_addr(address).* }} }}\npriv inner: fn(address: Int) -> Int {{ #Unsafe(\"live\") {{ return mem.Ptr<Int>.from_addr(address).* }} }}\n// [unit source: R/Host.jet]\nhost: fn(address: Int) -> Int {{ inner(address) }}\n"
    runtime_unit: parse_source(runtime_unit_text.bytes())
    runtime_unit_map: sema_unsafe_unit_map("package:11:jet_runtime:", runtime_unit_text) ?? panic("UnsafeObligations: a runtime unit maps its sources")
    runtime_unit_refused: sema_unsafe_inspect([SemaGateModule{source: "unit.jet", program: runtime_unit.program, policy_path: Val("unit.jet"), memory_kernel: Val([String]{"R/Kernel.jet"}), unit: Val(runtime_unit_map), package_identity: "package:11:jet_runtime:0.0.1"}], GateSet{})
    unsafe_test_require(runtime_unit_refused.diagnostics.len() == 1 && runtime_unit_refused.diagnostics[0].diagnostic.code == "E3114" && runtime_unit_refused.diagnostics[0].diagnostic.what.contains("`peek`"), "a composed unit's public kernel function answers E3114, its `priv` one and a host source do not: {runtime_unit_refused.diagnostics:Debug}")
    invocation: GateSet{allowed: [PolicyKey.Unsafe]}
    declaration: PolicyDeclaration{key: PolicyKey.Unsafe, value: PolicyValue.Forbid, scope: PolicyScope.Organization, span: Span{start: 0, end: 1}, target: None, source: "org.jet"}
    refusal: sema_unsafe_inspect([SemaGateModule{source: "app.jet", program: parsed.program, declarations: [declaration]}], invocation)
    unsafe_test_require(refusal.diagnostics[0].diagnostic.code == "E3415", "invocation cannot widen refusal")
    span: Span{start: 10, end: 20}
    pointer: Expr.Ident{name: "pointer", span: span, id: AST_NODE_GENERATED}
    ^operations: [SemaUnsafeOperation]{}
    sema_unsafe_expr_operations(Expr.PtrFromAddr{alias: "mem", alias_span: span, elem: Type.Int, addr: pointer, span: span, id: AST_NODE_GENERATED}, operations)
    methods: [String]{"volatile_read", "volatile_write", "cast_ptr"}
    loop method in methods {
        // Each call owns its receiver, so each names the pointer anew.
        sema_unsafe_expr_operations(Expr.MethodCall{receiver: Expr.Ident{name: "pointer", span: span, id: AST_NODE_GENERATED}, method: method, method_span: span, owner_type_args: [], type_args: [], args: [], id: AST_NODE_GENERATED}, operations)
    }
    unsafe_test_require(operations.len() == 4, "pointer, volatile reads/writes, cast collection")
    unsafe_test_require(operations[0].kind == "pointer_from_address" && operations[3].kind == "pointer_cast", "pointer operation names")
    unsafe_test_require(operations[2].required == ([String]{"valid_ptr", "aligned", "no_alias"}), "volatile write requires alias proof")
}
