// Assemble with Compiler/Bootstrap/sources.list, replacing the CLI entry.
fn unsafe_test_require(ok: Bool, message: String) Never! {
    if !ok -> panic("UnsafeObligations: {message}")
}

fn unsafe_test_inspect(source: String, policy: PolicyValue) -> UnsafeInspection Never! {
    parsed :: parse_source(source.bytes())
    unsafe_test_require(parsed.diagnostics.len() == 0, "fixture parse")
    declaration :: PolicyDeclaration{key: PolicyKey.Unsafe, value: policy, scope: PolicyScope.Package, span: Span{start: 0, end: 0}, target: None, source: "package.jet"}
    sema_unsafe_inspect([SemaGateModule{source: "app.jet", program: parsed.program, declarations: [declaration]}], GateSet{})
}

fn run() Never! {
    source :: "fn run() {{\n#Unsafe(\"cell stays live\") {{\np := *cell\nassert no_alias\nx := p.*\nassert aligned, valid_ptr, valid_ptr\n}}\n}}\n"
    tracked :: unsafe_test_inspect(source, PolicyValue.Obligations)
    unsafe_test_require(tracked.gates.len() == 1, "one gate")
    unsafe_test_require(tracked.gates[0].mode == "Obligations", "resolved obligation mode")
    unsafe_test_require(tracked.gates[0].operations.len() == 2, "pointer and dereference")
    unsafe_test_require(tracked.gates[0].operations[0].kind == "raw_pointer", "operation kind")
    unsafe_test_require(tracked.gates[0].operations[0].discharged && tracked.gates[0].operations[1].discharged, "adjacent proofs discharge")
    unsafe_test_require(tracked.gates[0].operations[1].asserted == ([String]{"aligned", "valid_ptr"}), "assertions sorted and deduplicated")
    unsafe_test_require(tracked.diagnostics.len() == 0, "valid obligations")
    missing :: unsafe_test_inspect("fn run() {{ #Unsafe(\"live\") {{ x := p.* }} }}", PolicyValue.Obligations)
    unsafe_test_require(missing.diagnostics.len() == 1 && missing.diagnostics[0].diagnostic.code == "E3107", "missing proof diagnostic")
    unsafe_test_require(!missing.gates[0].operations[0].discharged, "missing proof retained")
    ordinary :: unsafe_test_inspect("fn run() {{ #Unsafe(\"live\") {{ x := p.* }} }}", PolicyValue.Default)
    unsafe_test_require(ordinary.gates[0].operations[0].discharged && ordinary.diagnostics.len() == 0, "gate-only mode retains operation without demanding proof")
    nested :: unsafe_test_inspect("fn run() {{ #Unsafe(\"outer\") {{ x := p.*\n#Unsafe(\"inner\") {{ y := q.*\nassert valid_ptr, aligned }}\nassert valid_ptr, aligned }} }}", PolicyValue.Obligations)
    unsafe_test_require(nested.gates.len() == 2 && nested.gates[0].operations.len() == 1 && nested.gates[1].operations.len() == 1, "nested gate proofs remain independent")
    unsafe_test_require(nested.diagnostics.len() == 2, "nested gate breaks proof adjacency")
    outside :: unsafe_test_inspect("fn run() {{ assert valid_ptr }}", PolicyValue.Default)
    unsafe_test_require(outside.diagnostics.len() == 1 && outside.diagnostics[0].diagnostic.code == "E3108", "outside-gate assertion")
    denied :: unsafe_test_inspect(source, PolicyValue.Forbid)
    unsafe_test_require(denied.diagnostics[0].diagnostic.code == "E3105", "outer refusal")
    per_site :: unsafe_test_inspect(source, PolicyValue.PerSite)
    unsafe_test_require(per_site.diagnostics[0].diagnostic.code == "E3106", "per-site needs mode")
    parsed :: parse_source(source.bytes())
    restricted :: sema_unsafe_inspect([SemaGateModule{source: "app.jet", program: parsed.program, policy_path: Val("src/app.jet"), unsafe_paths: Val([String]{"src/audited"})}], GateSet{})
    unsafe_test_require(restricted.diagnostics[0].diagnostic.code == "E2960", "package path refusal")
    invocation :: GateSet{allowed: [PolicyKey.Unsafe]}
    declaration :: PolicyDeclaration{key: PolicyKey.Unsafe, value: PolicyValue.Forbid, scope: PolicyScope.Organization, span: Span{start: 0, end: 1}, target: None, source: "org.jet"}
    refusal :: sema_unsafe_inspect([SemaGateModule{source: "app.jet", program: parsed.program, declarations: [declaration]}], invocation)
    unsafe_test_require(refusal.diagnostics[0].diagnostic.code == "E3415", "invocation cannot widen refusal")
    span :: Span{start: 10, end: 20}
    pointer :: Expr.Ident{name: "pointer", span: span}
    operations := [SemaUnsafeOperation]{}
    sema_unsafe_expr_operations(Expr.PtrFromAddr{alias: "mem", alias_span: span, elem: Type.Int, addr: pointer, span: span}, &operations)
    methods :: [String]{"volatile_read", "volatile_write", "cast_ptr"}
    loop method in methods {
        sema_unsafe_expr_operations(Expr.MethodCall{receiver: pointer, method: method, method_span: span, owner_type_args: [], type_args: [], args: [], recv_type: None, resolved_ret: None}, &operations)
    }
    unsafe_test_require(operations.len() == 4, "pointer, volatile reads/writes, cast collection")
    unsafe_test_require(operations[0].kind == "pointer_from_address" && operations[3].kind == "pointer_cast", "pointer operation names")
    unsafe_test_require(operations[2].required == ([String]{"valid_ptr", "aligned", "no_alias"}), "volatile write requires alias proof")
}
