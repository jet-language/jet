// Production Source contracts for the recovered policy and guest boundaries.
use {
    jet_driver.[jet_driver_canonical_effect_module]
    jet_foundation.[DIAGNOSTIC_ERROR, FnBody, Span, Type, body_node, compiler_threads_single, effect_vocabulary_module, jet_target_machine_hosted, module_intern, module_table]
    jet_parser.[parse_source]
    jet_sema.[SemaBuildFacts, SemaComptimeFunctionResult, SemaComptimeItemValue, SemaForeignProviderInput, SemaRegistrationForeignHandleFacts, SemaRegistrationHostHooks, SemaRegistrationImportEdge, SemaRegistrationModuleInput, SemaRegistrationPackagePolicy, SemaSourceOrigin, SemaSourceSegment, sema_collect_comptime_declarations, sema_finalize_registration_graph, sema_guest_export_value_type, sema_registration_prepare_graph]
}

bd_require: fn(ok: Bool, message: String) Never! {
    if !ok -> panic("recovered Source contract: {message}")
}

// The call `function` returns: `direct` fails by the implicit default, so the
// checker wraps its value as `Ok(value)` and propagates the call's failure
// (`TryWithContext`).
bd_returned: fn(function: FnBody) -> Int Never! {
    loop statement in function.body {
        if function.tree.stmts[statement] == .Return(value, _) {
            returned := value ?? panic("missing returned policy value")
            if body_node(function.tree, returned).kind == .Ok(inner) -> returned = inner
            if body_node(function.tree, returned).kind == .TryWithContext(inner, _, _, _, _, _) -> returned = inner
            return returned
        }
    }
    panic("missing policy return")
}

// The checked functions of `source` as the module `policy_fixture.main`,
// through the production registration graph: prepare, the declaration stage
// and finalization. A direct call names the DeclID its callee registered, so
// no check without a graph reaches the bodies.
bd_checked: fn(source: &&String) -> [FnBody] Never! {
    parsed := parse_source(source.bytes())
    bd_require(parsed.diagnostics.len() == 0, "policy parses")
    table := module_table()
    main_id: module_intern(table, "policy_fixture.main")
    effects: jet_driver_canonical_effect_module(effect_vocabulary_module("IO: struct {{\n    impl Effect {{}}\n}}\nPanic: struct {{\n    impl Effect {{}}\n}}\n"), table) ?? panic("canonical effect module declares no effects")
    effects_id: effects.module_identity
    facts: SemaBuildFacts{package_name: "policy_fixture", package_version: "0.1.0", os: "linux", profile: "dev", stamp_git: None, stamp_dirty: false, stamp_toolchain: "fixture", stamp_at: ""}
    segment: SemaSourceSegment{generated: Span{start: 0, end: source.len()}, source_file: "policy.jet", source_start: 0, line_starts: [Int]{0}, origin: SemaSourceOrigin.Snapshot}
    input: SemaRegistrationModuleInput{package_identity: "policy_fixture", module_identity: main_id, module_name: "main", core_source_alias: "", module_path: "policy.jet", source_file: "policy.jet", source_segments: [SemaSourceSegment]{segment}, source_origin: SemaSourceOrigin.Snapshot, program: parsed.program.move(), foreign_handles: [SemaRegistrationForeignHandleFacts]{}, source: source.move()}
    graph := sema_registration_prepare_graph([SemaRegistrationModuleInput]{input, effects}, [SemaRegistrationImportEdge]{}, "policy_fixture", main_id, effects_id, table, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), facts, false, compiler_threads_single()) ?? panic("policy registration: {err}")
    hooks: Shared{SemaRegistrationHostHooks{numeric_unit_conversion_exact: None}}
    // Declaration checking loans the graph to its stage, which returns it.
    stage := sema_collect_comptime_declarations(graph, [SemaRegistrationPackagePolicy]{}, compiler_threads_single(), None) ?? panic("policy declaration checking: {err}")
    declared := stage.graph.move()
    stage.graph = None
    registration := declared.move() ?? panic("the declaration pass lost its registration graph")
    checked := sema_finalize_registration_graph(registration, None, stage, [SemaComptimeItemValue]{}, [SemaComptimeFunctionResult]{}, hooks, compiler_threads_single(), None) ?? panic("policy finalization: {err}")
    loop diagnostic in checked.diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR {
            panic("policy checker: {diagnostic.code}: {diagnostic.what}")
        }
    }
    bd_require(checked.complete, "policy uses the complete Source path")
    loop checked_module in checked.modules.move() {
        if checked_module.module_identity == main_id -> return checked_module.functions.move()
    }
    panic("the checked graph has no policy_fixture.main module")
}

bd_policy: fn() Never! {
    functions: bd_checked("policy audit(topic: String{{\"users\"}}) {{ wrap(call) {{ return call() }} }}\n#Policy(audit()) value: fn() -> Int {{ 7 }}\ndirect: fn() -> Int {{ value() }}\nselected: fn() -> Int {{ chosen: apply(audit(), value)\n chosen() }}\nbare: fn() -> Int {{ chosen: apply(value)\n chosen() }}\n")
    saw_direct := false
    saw_wrapper := false
    loop function in functions {
        if function.name == "__jet_policy_audit_value" -> saw_wrapper = true
        if function.name == "direct" {
            returned: body_node(function.tree, bd_returned(function))
            bd_require(if returned.kind == .IndirectCall(callee, _, _, _) -> if body_node(function.tree, callee).kind == .FnValue(kind) -> if kind == .Policy(_, arguments, _, _, _, _) -> arguments.len() == 1 else -> false else -> false else -> false, "direct #Policy call uses its checked wrapper and default")
            saw_direct = true
        }
    }
    bd_require(saw_direct && saw_wrapper, "direct callable and generated wrapper are both checked")
}

run: fn() Never! {
    bd_policy()
    scalar: sema_guest_export_value_type(Val(Type.Result{ok: Type.Int, err: Type.Named{name: "Never"}}))
    bd_require(scalar == Val(Type.Int), "guest inferred infallible scalar is one value")
    fallible: Type.Result{ok: Type.Int, err: Type.String}
    bd_require(sema_guest_export_value_type(Val(fallible)) == Val((fallible)), "guest declared failure rail is retained")
    diverging: Type.Result{ok: Type.Named{name: "Never"}, err: Type.Named{name: "Never"}}
    bd_require(sema_guest_export_value_type(Val(diverging)) == Val((diverging)), "guest divergence is not a scalar")
    print("recovered Source policy/guest contracts: passed")
}
