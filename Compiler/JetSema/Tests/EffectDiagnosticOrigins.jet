// Exercise the production graph traversal and source publication: the ceiling
// belongs to main, but its unbounded trait dispatch belongs to a helper module.
fn effect_origin_node(key: String, module_index: Int) -> SemaEffectNode Never! {
    SemaEffectNode{
        key: key, name: key, module_identity: key, module_index: module_index,
        span: Span{start: 1, end: 5}, name_span: Span{start: 1, end: 5},
        direct: [String]{}, direct_spans: [TEffectSpan]{}, call_edges: [String]{},
        maximal: false, maximal_span: None, declared: [String]{},
        prohibited: [String]{}, has_declared_row: false, is_pure: false,
        is_replayable: false, replayable_span: None, is_unsafe: false,
        unsafe_reason: None, unsafe_span: None, effect_via: None,
        dispatches: [TEffectSpan]{},
    }
}

fn effect_origin_input(module_index: Int, file: String) -> SemaEffectModuleInput Never! {
    SemaEffectModuleInput{
        module_index: module_index,
        sources: [SemaEffectFunctionSource]{},
        source_segments: [SemaSourceSegment]{SemaSourceSegment{
            generated: Span{start: 0, end: 100}, source_file: file,
            source_start: 0, line_starts: [Int]{0, 1, 2, 30},
            origin: SemaSourceOrigin.Snapshot,
        }},
    }
}

fn run() {
    caller := effect_origin_node("main::ceiling", 0)
    caller.has_declared_row = true
    caller.declared = [String]{"IO"}
    caller.call_edges = [String]{"worker::inspect"}
    helper := effect_origin_node("worker::inspect", 1)
    helper.dispatches = [TEffectSpan]{TEffectSpan{name: "Shape::area", span: Span{start: 30, end: 34}}}
    nodes :: [SemaEffectNode]{caller, helper}
    by_key :: [String:Int]{"main::ceiling": 0, "worker::inspect": 1}
    inputs := [SemaEffectModuleInput]{effect_origin_input(0, "main.jet"), effect_origin_input(1, "worker.jet")}
    seen := [Bool]{false, false}
    site :: sema_effect_find_dispatch(nodes, by_key, 0, &seen) ?? panic("transitive dispatch not found")
    if site.module_index != 1 || site.dispatch.span != (Span{start: 30, end: 34}) -> panic("dispatch lost its declaring module")
    located :: sema_effect_locate_dispatch(site, inputs)
    if located.source_path != Val("worker.jet") || located.span != Val(site.dispatch.span) -> panic("foreign dispatch lost its source location")
    batch := [Diagnostic]{}
    sema_effect_check_node(caller, [String]{"IO"}, false, Val(located), &batch)
    all := [Diagnostic]{}
    sema_effect_publish_diagnostics(&all, inputs[0].source_segments, batch)
    if all.len() != 1 || all[0].code != "E0743" || all[0].source_path != Val("worker.jet") -> panic("publication rebound the foreign dispatch to main")
    entry_site :: SemaEffectDispatchSite{dispatch: site.dispatch, module_index: 0}
    entry_located :: sema_effect_locate_dispatch(entry_site, inputs)
    entry_original :: sema_diagnostic_with_source_location(sema_effect_unbounded_dispatch_diagnostic(entry_site.dispatch), inputs[0].source_segments)
    if entry_located.source_path != entry_original.source_path || entry_located.source_offset != entry_original.source_offset || entry_located.source_start != entry_original.source_start || entry_located.span != entry_original.span -> panic("entry dispatch mapping changed its existing rendering context")
    inputs[1].source_segments = [SemaSourceSegment]{}
    unknown :: sema_effect_locate_dispatch(site, inputs)
    if unknown.span != None || unknown.source_path != None -> panic("unknown dispatch origin invented a position")

    bounded := helper
    bounded.dispatches = [TEffectSpan]{}
    bounded.declared = [String]{"Net"}
    bounded.has_declared_row = true
    boundary := [Diagnostic]{}
    sema_effect_check_node(bounded, [String]{"IO"}, false, None, &boundary)
    inputs[1] = effect_origin_input(1, "worker.jet")
    boundary_all := [Diagnostic]{}
    sema_effect_publish_diagnostics(&boundary_all, inputs[1].source_segments, boundary)
    if boundary_all.len() != 1 || boundary_all[0].code != "E0740" || boundary_all[0].source_path != Val("worker.jet") -> panic("effect boundary lost its declaring module")
    // Unlocated diagnostics still acquire the declaring module's source;
    // already located foreign diagnostics above must never be rebound.
    local := [Diagnostic]{}
    sema_effect_publish_diagnostics(&local, inputs[0].source_segments, [Diagnostic]{sema_effect_unbounded_dispatch_diagnostic(entry_site.dispatch)})
    if local.len() != 1 || local[0].source_path != Val("main.jet") || local[0].span != Val(entry_site.dispatch.span) -> panic("local effect publication lost its source location")
    print("effect diagnostic origins: passed")
}
