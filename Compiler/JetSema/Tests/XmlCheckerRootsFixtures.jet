// XML checker roots: lexical call precedence, audited value tails, direct read windows.
text: fn(key: String) -> String Never! { key.copy() }
object: fn(key: Int) -> Int Never! { key }
xml_roots_predicate: fn() -> Bool Never! {
    text: (key: String) -[]> key == "value"
    object: (key: String) -[]> text(key)
    object("value")
}
xml_roots_byte: fn() -> U8 Never! {
    #Unsafe("no raw operations in this regression") {
        #Unsafe("nested tail retains its value grammar") { U8{7} }
    }
}
xml_roots_first: fn(bytes: View<U8>) -> U8 Never! { bytes[0] }
xml_roots_window: fn(bytes: [U8]) -> U8 Never! {
    xml_roots_first(bytes[0..<bytes.len()])
}
has: fn(key: String) -> Bool { Err("global failure") }
xml_roots_local_failure_contract: fn() -> Bool Never! {
    has: (key: String) -> !(key == "")
    text: (key: String) -> has(key)
    text("value")
}
xml_roots_next: fn() -> Int Never! {
    loop {
        event: 1
        node: if event == { 0 -> { next } else -> 1 }
        return node
    }
}
xml_roots_prefix: fn(name: String?) Never! {
    if name == .Val(prefix) { _: prefix.len() }
}
xml_roots_shared: fn<T>(x: &&T) -> Shared<T?> {
    Shared{(T?{Val(x.move())})}
}
#Test("xml_checker_roots_fixtures") {
    print(xml_roots_predicate())
    print(xml_roots_byte())
    print(xml_roots_window([U8]{9}))
    print('\'')
}
