// Code handed the root's `Compiler` value launches no process: a hook that
// takes the value and a `meta.events` handler reaching a launch through a
// helper are refused (E3410), with the call path to the launch, while a build
// that makes the value and declares a process step checks clean, and a
// program's own `Compiler` type is no compiler value.
use {
    hook_sys: core.sys
    hook_process: core.process
    jet_driver.[JetDriverCompileMode, jet_driver_present_diagnostics]
    jet_cli.[JetCLIOverlay, JetCLIPrepared, jet_cli_compile_prepared, jet_cli_native_session_at, jet_cli_prepare_overlays]
    jet_foundation.[DIAGNOSTIC_ERROR]
}

// The compiler under test, never this test binary, owns the runtime pack a
// build's `fn build` runs on: a compile runs it to hear its `meta.events`
// watches.
compiler_hook_runtime_dir: fn() -> String {
    jet: hook_sys.get("JET") ?? (hook_process.which("jet") ?? panic("set JET to the compiler under test"))
    parts := jet.split("/").to_list()
    _ := parts.pop()
    "{parts.join("/")}/jet-runtime"
}

compiler_hook_errors: fn(file: String) -> [String] {
    prepared := jet_cli_prepare_overlays(file, file, [JetCLIOverlay]{}, false, None, JetDriverCompileMode.Program)
    native: if prepared.move() == {
        .Refused(refusal) -> {
            return [String]{refusal.stderr}
        }
        .Prepared(request, snapshot) -> {
            selected := request
            selected.eval_config.native = Val(jet_cli_native_session_at(compiler_hook_runtime_dir()) ?? panic("the compiler under test has no runtime pack"))
            JetCLIPrepared.Prepared{request: selected, snapshot: snapshot}
        }
    }
    errors := [String]{}
    checked: jet_cli_compile_prepared(native, None, None)
    if checked == {
        .Refused(refusal) -> { errors.push(refusal.stderr) }
        .Compiled(result, snapshot) -> {
            if result.internal_problem != None -> panic("{file}: internal compiler failure")
            loop diagnostic in jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files) {
                if diagnostic.severity == DIAGNOSTIC_ERROR {
                    errors.push("{diagnostic.code}: {diagnostic.what} [{diagnostic.call_chain.join(" → ")}]")
                }
            }
        }
    }
    errors
}

#Test("compiler_hook_launch") {
    hook: compiler_hook_errors("Tests/Cases/BuildEntry/OnlyTheRootsCompilerValueRunsTheHook.fixture/spawn/main.jet")
    assert_eq(hook, [String]{"E3410: `launch` takes the root's `Compiler` value and launches a process through launch → start → core.process.call [launch → start → core.process.call]"})
    handler: compiler_hook_errors("Tests/UI/MetaLadderBuildLaunchesAProcess/run.jet")
    assert_eq(handler, [String]{"E3410: The `meta.events` handler hears the root's `Compiler` value and launches a process through meta.events handler → start → core.process.call [meta.events handler → start → core.process.call]"})
    assert_eq(compiler_hook_errors("Tests/Cases/BuildEntry/OnlyTheRootsCompilerValueRunsTheHook.fixture/steps/main.jet"), [String]{})
    gate: compiler_hook_errors("Tools/Perf/Scaling/Gate/Source/Gate.jet").filter(fn(line) { line.contains("E3410") })
    assert_eq(gate, [String]{})
}
