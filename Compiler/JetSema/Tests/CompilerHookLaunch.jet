// Code handed the root's `Compiler` value launches no process: a hook that
// takes the value and a `meta.events` handler reaching a launch through a
// helper are refused (E3410), with the call path to the launch, while a build
// that makes the value and declares a process step checks clean, and a
// program's own `Compiler` type is no compiler value.
use {
    jet_driver.[JetDriverCompileMode, jet_driver_present_diagnostics]
    jet_cli.[jet_cli_compile_file]
    jet_foundation.[DIAGNOSTIC_ERROR]
}

compiler_hook_errors: fn(file: String) -> [String] {
    errors := [String]{}
    checked: jet_cli_compile_file(file, false, None, JetDriverCompileMode.Program)
    if checked == {
        .Refused(refusal) -> errors.push(refusal.stderr)
        .Compiled(result, snapshot) -> {
            if result.internal_problem != None -> panic("{file}: internal compiler failure")
            loop diagnostic in jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files) {
                if diagnostic.severity == DIAGNOSTIC_ERROR -> errors.push("{diagnostic.code}: {diagnostic.what} [{diagnostic.call_chain.join(" → ")}]")
            }
        }
    }
    errors
}

#Test("compiler_hook_launch") {
    hook: compiler_hook_errors("tests/cases/build_entry/only_the_roots_compiler_value_runs_the_hook.fixture/spawn/main.jet")
    assert_eq(hook, [String]{"E3410: `launch` takes the root's `Compiler` value and launches a process through launch → start → core.process.call [launch → start → core.process.call]"})
    handler: compiler_hook_errors("tests/ui/meta_ladder_build_launches_a_process/run.jet")
    assert_eq(handler, [String]{"E3410: The `meta.events` handler hears the root's `Compiler` value and launches a process through meta.events handler → start → core.process.call [meta.events handler → start → core.process.call]"})
    assert_eq(compiler_hook_errors("tests/cases/build_entry/only_the_roots_compiler_value_runs_the_hook.fixture/steps/main.jet"), [String]{})
    gate: compiler_hook_errors("Tools/perf/scaling/gate/Source/Gate.jet").filter(line -> line.contains("E3410"))
    assert_eq(gate, [String]{})
}
