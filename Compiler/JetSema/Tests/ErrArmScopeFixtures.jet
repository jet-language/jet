// Deferred Err payloads retain then-arm locals and pattern refinements.
fn scope_payload() -> (value: Int, tag: Int) Err! { return Ok((value: 7, tag: 0)) }
fn local_message(flag: Bool) -> Int {
    result :: if flag -> {
        message :: "bad"
        Err(message)
    } else -> {
        message :: 7
        print(message)
        scope_payload()
    }
    if result == {
        .Ok(payload) -> payload.value
        .Err(error) -> 0
    }
}
fn present_message(message: String?) -> Int {
    result :: if message == .Val(message) -> Err(message) else -> scope_payload()
    if result == {
        .Ok(payload) -> payload.value
        .Err(error) -> 0
    }
}
// Explicit return-carrier expectations keep their existing arm checking path.
fn expected_carrier(flag: Bool) -> (value: Int, tag: Int) Err! {
    if flag -> Err("bad") else -> scope_payload()
}
fn run() {
    print(local_message(false))
    print(present_message(None))
    print(expected_carrier(false) ?? (value: 0, tag: 0))
}
