// `#Rename` takes a label for every `impl Format` name the program's graph
// declares: a package's codec (`msgpack`) as Core's six.
use {
    labels_sys: core.sys
    labels_process: core.process
    jet_driver.[JetDriverCompileMode, JetDriverSourceDocument, jet_driver_present_diagnostics]
    jet_cli.[JetCLIPrepared, jet_cli_compile_prepared, jet_cli_native_session_at, jet_cli_prepare_overlays]
    jet_foundation.[DIAGNOSTIC_ERROR]
}

// The compiler under test's runtime pack, which a marker's expansion runs on.
rename_labels_runtime_dir: fn() -> String {
    jet: labels_sys.get("JET") ?? (labels_process.which("jet") ?? panic("set JET to the compiler under test"))
    parts := jet.split("/").to_list()
    _ := parts.pop()
    "{parts.join("/")}/jet-runtime"
}

rename_labels_errors: fn(file: String) -> [String] {
    prepared := jet_cli_prepare_overlays(file, file, [JetDriverSourceDocument]{}, false, None, JetDriverCompileMode.Program)
    native: if prepared.move() == {
        .Refused(refusal) -> {
            return [String]{refusal.stderr}
        }
        .Prepared(request, snapshot) -> {
            selected := request
            selected.eval_config.native = Val(jet_cli_native_session_at(rename_labels_runtime_dir()) ?? panic("the compiler under test has no runtime pack"))
            JetCLIPrepared.Prepared{request: selected, snapshot: snapshot}
        }
    }
    errors := [String]{}
    checked: jet_cli_compile_prepared(native, None, None)
    if checked == {
        .Refused(refusal) -> { errors.push(refusal.stderr) }
        .Compiled(result, snapshot) -> {
            if result.internal_problem != None -> panic("{file}: internal compiler failure")
            loop diagnostic in jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files) {
                if diagnostic.severity == DIAGNOSTIC_ERROR {
                    errors.push("{diagnostic.code}: {diagnostic.what}")
                }
            }
        }
    }
    errors
}

#Test("a package's Format name is a #Rename label") {
    assert_eq(rename_labels_errors("Examples/Modules/Packages/MsgpackRename/run.jet"), [String]{})
}
