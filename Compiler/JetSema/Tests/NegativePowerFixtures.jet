// D-EXPNEG1: literal sign selects Fraction; dynamic exponents remain Int.
fn negative_power_int(value: Int) -> Int { value }
fn negative_power_dynamic(exponent: Int) -> Int { (2).pow(exponent) }
fn negative_power_negated_dynamic(exponent: Int) -> Int { (2).pow(-exponent) }
fn run() {
    reciprocal :: (2).pow(-1)
    grouped :: (2).pow((-1))
    print(reciprocal.numerator())
    print(reciprocal.denominator())
    print(grouped.denominator())
    print(negative_power_int((2).pow(-0)))
    print(negative_power_int((2).pow(3)))
    print(negative_power_dynamic(3))
    print(negative_power_negated_dynamic(-3))
}
