// Literal sign selects Fraction; dynamic exponents remain Int.
negative_power_int: fn(value: Int) -> Int { value }
negative_power_dynamic: fn(exponent: Int) -> Int { (2).pow(exponent) }
negative_power_negated_dynamic: fn(exponent: Int) -> Int { (2).pow(-exponent) }
#Test("negative_power_fixtures") {
    reciprocal: (2).pow(-1)
    grouped: (2).pow((-1))
    print(reciprocal.numerator())
    print(reciprocal.denominator())
    print(grouped.denominator())
    print(negative_power_int((2).pow(-0)))
    print(negative_power_int((2).pow(3)))
    print(negative_power_dynamic(3))
    print(negative_power_negated_dynamic(-3))
}
