// Assembled with the production bootstrap inventory by run-gate-fixtures.mjs.
// Source padding admits real independent method jobs under the unchanged byte
// threshold; it is not a performance corpus or a substitute task implementation.
fn method_wave_require(ok: Bool, message: String) Never! {
    if !ok -> panic("BodyMethodWaveFixtures: {message}")
}

fn method_wave_source(negative: Bool) -> String Never! {
    methods := [String]{}
    loop index in 0..<8 {
        padding := [U8]{}
        loop _ in 0..<(4096 + index * 1024) -> &padding.push(U8{120})
        comment :: String.from_bytes(padding) ?? panic("ASCII padding is not UTF-8")
        body :: if negative && index == 2 -> "missing_method_value" else -> "self.value"
        &methods.push("fn method_{index}(&self) -> Int Never! {{\n//{comment}\n{body}\n}}\n")
    }
    "struct Counter {{ value: Int\n{methods.join("")}\nfn window(&self, values: [Int]) -> View<Int> {{ first(values) }}\nfn fail(&self) -> Int Never! {{ panic(\"method panic\") }}\n}}\ntrait MethodTag {{ fn label_value(&self) -> Int Never!\nfn second_value(&self) -> Int Never! }}\nimpl Counter.MethodTag {{ fn label_value(&self) -> Int Never! {{ 8 }}\nfn second_value(&self) -> Int Never! {{ 9 }} }}\nstruct GenericOwner<T> {{ value: T\nfn owner_value(&self) -> Int Never! {{ 7 }}\nfn identity<U>(&self, value: U) -> U Never! {{ value }}\n}}\nstruct Rendered {{ value: Int }}\nimpl Rendered.Display {{ fn display(self) -> String {{ \"rendered\" }} }}\nimpl Rendered.Comparable {{ fn compare(self, other: Rendered) -> Ordering {{ .Equal }} }}\nfn first(values: [Int]) -> View<Int> {{ values[0..<1] }}\nfn run() {{}}\n"
}

fn method_wave_registration(source: String, keep_going: Bool, effects_source: String) -> SemaRegistrationGraph {
    parsed := parse_source(source.bytes())
    method_wave_require(parsed.diagnostics.len() == 0, "real fixture source parses")
    canonical := jet_driver_canonical_effect_module(effects_source) ?? panic("fixture effect declaration does not parse")
    line_starts := [Int]{0}
    bytes :: source.bytes()
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{10}) -> &line_starts.push(index + 1)
    }
    segment :: SemaSourceSegment{generated: Span{start: 0, end: bytes.len()}, source_file: "method-wave.jet", source_start: 0, line_starts: line_starts, origin: SemaSourceOrigin.Snapshot}
    input :: SemaRegistrationModuleInput{package_identity: "method-wave", module_identity: "method-wave::main", module_name: "main", core_source_alias: "", module_path: "main.jet", source_file: "method-wave.jet", source_segments: [SemaSourceSegment]{segment}, source_origin: SemaSourceOrigin.Snapshot, program: parsed.program, foreign_handles: [SemaRegistrationForeignHandleFacts]{}, source: source}
    canonical_identity :: canonical.module_identity
    facts :: SemaBuildFacts{package_name: "method-wave", package_version: "0.1.0", os: "linux", profile: "dev", stamp_git: None, stamp_dirty: false, stamp_toolchain: "fixture", stamp_at: ""}
    graph := sema_registration_prepare_graph([SemaRegistrationModuleInput]{input, canonical}, [SemaRegistrationImportEdge]{}, "method-wave", "method-wave::main", canonical_identity, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), facts, false)
    graph.keep_going = keep_going
    method_wave_require(graph.complete && graph.internal_problem == None, "registration is complete")
    graph
}

fn method_wave_comptime_rows(graph: SemaRegistrationGraph, hooks: Shared<SemaRegistrationHostHooks>, negative: Bool) -> [SemaComptimeFunctionResult] {
    memory_plan :: sema_function_memory_plan_from_graph(graph)
    environment := sema_comptime_environment(graph.copy(), [SemaComptimeItemValue]{}, None)
    program :: sema_program_tables_init(^environment.registration_graph, [TTypeDef]{})
    environment.registration_graph = None
    probe := sema_comptime_probe_init(sema_host_hook_access(hooks))
    available :: sema_comptime_available_constants(graph, [SemaComptimeItemValue]{})
    name :: if negative -> "method_2" else -> "method_0"
    loop nominal in graph.modules[0].nominals {
        loop method in nominal.methods {
            if method.declaration.name != name -> next
            checked :: sema_check_comptime_function(graph, &environment, program, &probe, available, memory_plan, [SemaComptimeItemValue]{}, graph.modules[0].module_identity, method.symbol.id.key)
            method_wave_require(checked.complete == !negative, "the cached comptime row is a real checker result")
            return [SemaComptimeFunctionResult]{checked}
        }
    }
    panic("the comptime method witness is not registered")
}

fn method_wave_checked(graph: SemaRegistrationGraph, threads: CompilerThreads, cached: [SemaComptimeFunctionResult]) -> SemaGraphResult {
    hooks :: shared SemaRegistrationHostHooks{numeric_unit_conversion_exact: None, typed_boundary_literal_validate: None}
    stage := sema_collect_comptime_declarations(graph, [SemaRegistrationPackagePolicy]{}, None)
    sema_finalize_registration_graph(graph, None, ^stage, [SemaComptimeItemValue]{}, cached, hooks, threads, None, None)
}

fn method_wave_lowered(checked: SemaGraphResult, source: String) -> JetCodegenFunctions {
    modules := checked.modules.copy()
    functions := [TFunc]{}
    loop module_result in modules {
        loop function in module_result.functions -> &functions.push(function)
    }
    lower_functions(&functions, &modules, [MIRSourceFile]{MIRSourceFile{id: mir_source_file_id("method-wave.jet"), path: "method-wave.jet", source: source}}, compiler_threads_single(), None, false, "2028", false)
}

fn method_wave_panic_witness(value: TExpr, function_name: String) -> Int Never! {
    found := 0
    if value.kind == .RequireStop(_, location, _) {
        method_wave_require(location.function == function_name && location.file == "method-wave.jet" && location.line > 0, "panic retains the current method and authored source coordinates after worker/inline drain")
        found += 1
    }
    tir_each_expr_child(value, (child: TExpr) -> {
        found += method_wave_panic_witness(child, function_name)
    })
    found
}

fn method_wave_product_witnesses(graph: SemaRegistrationGraph, checked: SemaGraphResult, negative: Bool, keep_going: Bool, host_retry: Bool) {
    raw_rows := 0
    generated_anchor := Span?{None}
    loop implementation in graph.modules[0].impls {
        loop method in implementation.methods {
            if method.declaration.name == "display" || method.declaration.name == "compare" {
                method_wave_require(method.raw_protocol_return, "registered raw protocol return law is retained")
                raw_rows += 1
            }
        }
    }
    method_wave_require(raw_rows == 2, "both real Display and Comparable impl rows are exercised")
    loop nominal in graph.modules[0].nominals {
        if nominal.symbol.name != "GeneratedOwner" -> next
        loop method in nominal.methods {
            if method.declaration.name == "generated_value" {
                method_wave_require(method.declaration.compiler_generated, "the real derive provider produced a generated method")
                generated_anchor = Val(nominal.symbol.span)
            }
        }
    }
    if generated_anchor == .Val(anchor) {
        remapped := false
        loop diagnostic in checked.diagnostics {
            if diagnostic.severity == DIAGNOSTIC_ERROR && diagnostic.span == Val((anchor)) && diagnostic.what.contains("missing_generated_value") {
                method_wave_require(diagnostic.fix == "" && diagnostic.edit == None, "generated diagnostic keeps no non-authorable fix")
                remapped = true
            }
        }
        method_wave_require(remapped, "generated method error is remapped to the authored nominal")
    }
    publisher := false
    consumer := false
    raw_products := 0
    panic_sites := 0
    stub_sites := 0
    loop module_result in checked.modules {
        loop function in module_result.functions {
            if function.name == "first" -> publisher = function.return_view_provenance != None
            if function.name == "window" -> consumer = function.return_view_provenance != None
            if function.name == "display" || function.name == "compare" {
                expected :: if function.name == "display" -> Type.String else -> Type.Named{name: "Ordering"}
                method_wave_require(function.ret == Val((expected)) && function.params.len() > 0 && function.params[0].name == "self" && function.params[0].convention == AccessConvention.Read, "raw return and read receiver survive checking")
                raw_products += 1
            }
            if function.name != "fail" && function.name != "method_2" -> next
            name :: function.name
            loop statement in function.body {
                tir_each_stmt_child(statement, (value: TExpr) -> {
                    if name == "fail" -> panic_sites += method_wave_panic_witness(value, name)
                    if name == "method_2" && negative && keep_going -> stub_sites += method_wave_panic_witness(value, name)
                })
            }
        }
    }
    method_wave_require(publisher && consumer, "top-level return-view publication is consumed by a method")
    method_wave_require(raw_products == 2 && panic_sites > 0, "raw protocol products and actual method panic are present")
    if negative && keep_going && graph.modules[0].source.contains("missing_method_value") -> method_wave_require(stub_sites > 0, "real failed/cached-incomplete method produces its correctly located keep-going trap")
    if !host_retry -> return
    memory_plan :: sema_function_memory_plan_from_graph(graph)
    types := [TTypeDef]{}
    loop module_result in checked.modules {
        loop type_definition in module_result.declarations.type_defs -> &types.push(type_definition)
    }
    environment := sema_check_pass_environment(graph.copy(), types, SemaComptimeBodyValues{})
    program := SemaProgramTables{
        registration_graph: ^environment.registration_graph,
        checked_types: ^environment.checked_types,
        checked_type_rows: ^environment.checked_type_rows,
        checked_type_name_slots: ^environment.checked_type_name_slots,
        checked_type_name_rows: ^environment.checked_type_name_rows,
        boxed_edges: ^environment.boxed_edges,
    }
    environment.registration_graph = None
    hooks :: shared SemaRegistrationHostHooks{numeric_unit_conversion_exact: None, typed_boundary_literal_validate: None}
    scopes := sema_check_module_summary_scopes(&environment, &program, sema_host_hook_access(hooks), memory_plan, 0, [SemaComptimeFunctionResult]{}, [String:Int]{}, "fixture", None)
    jobs := [SemaBodyJob]{}
    loop nominal_index in 0..<graph.modules[0].nominals.len() {
        nominal :: graph.modules[0].nominals[nominal_index]
        loop method_index in 0..<nominal.methods.len() {
            name :: nominal.methods[method_index].declaration.name
            if name == "unit_value" || name == "after_unit" -> &jobs.push(SemaBodyJob.NominalMethod{ordinal: jobs.len(), nominal_index: nominal_index, method_index: method_index})
        }
    }
    method_wave_require(jobs.len() == 2, "real host-reaching method and adjacent normal method are registered")
    plan :: shared SemaBodyPlan{jobs: [SemaBodyJob]{}, order: [Int]{}, replay: [Bool]{}, observe: false}
    order := [Int]{0, 1}
    replay := [Bool]{}
    sema_check_body_plan_fill(plan, ^jobs, ^order, ^replay)
    queue :: shared SemaBodyQueue{next: 0}
    part := SemaBodyPart{scopes: ^scopes, bodies: [SemaPreparedBody]{}, positions: [Int]{}}
    method_wave_require(sema_check_body_part_in(environment, program, memory_plan, &part, plan, queue, 0) == 2, "both real method jobs were checked by the canonical worker")
    method_wave_require(part.bodies.len() == 2 && part.positions[0] == 0 && part.positions[1] == 1, "both worker products are present, in claim order")
    first :: if part.bodies[0] == {
        .Checked(body) -> body.wanted_hooks
        .Replay(_) -> panic("a cold host witness became a replay descriptor")
    }
    second :: if part.bodies[1] == {
        .Checked(body) -> body.wanted_hooks
        .Replay(_) -> panic("a cold normal witness became a replay descriptor")
    }
    method_wave_require(first && !second, "actual conversion requests ordered owner retry; adjacent method does not inherit wanted")
}

fn method_wave_case(source: String, negative: Bool, keep_going: Bool, use_comptime: Bool, host_retry: Bool) {
    graph :: method_wave_registration(source, keep_going, "effect IO\n")
    threads :: CompilerThreads{cap: Val(2), cores: 2, memory_available: Val(268435456)}
    memory_plan :: sema_function_memory_plan_from_graph(graph)
    scanned := 0
    all_jobs :: sema_check_method_jobs(graph, graph.modules[0], &scanned, false)
    weights := [Int]{}
    jobs :: sema_check_parallel_method_jobs(graph, graph.modules[0], memory_plan, [TGenericParam]{}, all_jobs, [String:Int]{}, &weights)
    excluded := 0
    loop nominal in graph.modules[0].nominals {
        if nominal.generic_params.len() == 0 -> next
        loop method in nominal.methods {
            method_wave_require(!sema_check_method_parallel_eligible(graph, graph.modules[0], memory_plan, method, nominal.ty, [String:Int]{}), "declared generic owners stay inline")
            excluded += 1
        }
    }
    method_wave_require(excluded >= 2, "generic-owner and generic-method exclusion is exercised")
    work := 0
    loop weight in weights -> work += weight
    method_wave_require(compiler_threads_admit(threads, jobs.len(), work, SEMA_BODY_MIN_BYTES_PER_THREAD, graph.modules[0].program.items.len() * SEMA_BODY_SCOPE_BYTES_PER_ITEM, 0) == 2, "real method wave admits two threads")
    hooks :: shared SemaRegistrationHostHooks{numeric_unit_conversion_exact: None, typed_boundary_literal_validate: None}
    cached :: if use_comptime -> method_wave_comptime_rows(graph, hooks, negative) else -> [SemaComptimeFunctionResult]{}
    single :: method_wave_checked(graph, compiler_threads_single(), cached)
    parallel :: method_wave_checked(graph, threads, cached)
    default_threads :: CompilerThreads{cap: None, cores: 2, memory_available: Val(268435456)}
    default_checked :: method_wave_checked(graph, default_threads, cached)
    method_wave_require(single.complete == !negative, "baseline verdict is the expected real verdict")
    method_wave_require("{single:Debug}" == "{parallel:Debug}", "all checked rows, diagnostics, spans and facts are byte-identical")
    method_wave_require("{single:Debug}" == "{default_checked:Debug}", "default thread policy has identical checked products")
    method_wave_product_witnesses(graph, single, negative, keep_going, host_retry)
    single_lowered :: method_wave_lowered(single, source)
    parallel_lowered :: method_wave_lowered(parallel, source)
    method_wave_require("{single_lowered:Debug}" == "{parallel_lowered:Debug}", "lowered MIR rows and diagnostics are byte-identical")
    default_lowered :: method_wave_lowered(default_checked, source)
    method_wave_require("{single_lowered:Debug}" == "{default_lowered:Debug}", "default thread policy has identical lowered products")
}

fn method_wave_cached_checked(graph: SemaRegistrationGraph, threads: CompilerThreads, cache: SemaIncrementalCache) -> SemaGraphResult {
    hooks :: shared SemaRegistrationHostHooks{numeric_unit_conversion_exact: None, typed_boundary_literal_validate: None}
    stage := sema_collect_comptime_declarations(graph, [SemaRegistrationPackagePolicy]{}, None)
    sema_finalize_registration_graph(graph, None, ^stage, [SemaComptimeItemValue]{}, [SemaComptimeFunctionResult]{}, hooks, threads, Val(cache), None)
}

fn method_wave_cache_case(source: String) {
    graph :: method_wave_registration(source, false, "effect IO\n")
    serial :: CompilerThreads{cap: Val(1), cores: 2, memory_available: Val(268435456)}
    parallel :: CompilerThreads{cap: Val(2), cores: 2, memory_available: Val(268435456)}
    cache :: sema_incremental_cache_new()
    baseline :: method_wave_checked(graph, serial, [SemaComptimeFunctionResult]{})
    first :: method_wave_cached_checked(graph, parallel, cache)
    method_wave_require("{baseline:Debug}" == "{first:Debug}", "memo cold check retains the identical full graph products")
    primed :: sema_incremental_cache_stats(cache)
    method_wave_require(primed.hits == 0 && primed.recomputes > 0 && primed.live_items > 0 && primed.live_item_bytes > 0, "cold memo records real recomputes and retainable products")
    sema_incremental_cache_clear_measurement(cache)
    method_wave_require(sema_incremental_cache_stats(cache).recomputed_items.len() == 0, "measurement clear does not discard rows")
    warm :: method_wave_cached_checked(graph, serial, cache)
    method_wave_require("{baseline:Debug}" == "{warm:Debug}", "ordered warm replay retains full checked rows, diagnostics, spans and facts")
    measured :: sema_incremental_cache_stats(cache)
    method_wave_require(measured.hits > primed.hits, "a warm hit counts only a consumed real body product")
    sema_incremental_cache_clear(cache)
    cleared :: sema_incremental_cache_stats(cache)
    method_wave_require(cleared.live_items == 0 && cleared.live_item_bytes == 0 && cleared.hits == measured.hits && cleared.recomputes == measured.recomputes, "cache clear removes retained data and preserves cumulative logical counters")
    again :: method_wave_cached_checked(graph, parallel, cache)
    method_wave_require("{baseline:Debug}" == "{again:Debug}", "clear forces a real identical check")
    final :: sema_incremental_cache_stats(cache)
    method_wave_require(final.recomputes > measured.recomputes && final.hits == measured.hits, "generation change prevents a stale replay")
}

fn method_wave_cache_host_case(source: String) {
    graph :: method_wave_registration(source, true, "effect IO\n")
    serial :: CompilerThreads{cap: Val(1), cores: 2, memory_available: Val(268435456)}
    parallel :: CompilerThreads{cap: Val(2), cores: 2, memory_available: Val(268435456)}
    key := ""
    loop nominal in graph.modules[0].nominals {
        loop method in nominal.methods {
            if method.declaration.name == "unit_value" -> key = method.symbol.id.key
        }
    }
    method_wave_require(key != "", "the volatile witness is an actual registered conversion method")
    cache :: sema_incremental_cache_new()
    baseline :: method_wave_checked(graph, serial, [SemaComptimeFunctionResult]{})
    first :: method_wave_cached_checked(graph, parallel, cache)
    method_wave_require("{baseline:Debug}" == "{first:Debug}", "withheld retry retains identical failed host products")
    primed :: sema_incremental_cache_stats(cache)
    first_count := 0
    loop item in primed.recomputed_items {
        if item == key -> first_count += 1
    }
    method_wave_require(first_count == 1, "worker and owner retry count one actual logical recompute")
    sema_incremental_cache_clear_measurement(cache)
    second :: method_wave_cached_checked(graph, serial, cache)
    method_wave_require("{baseline:Debug}" == "{second:Debug}", "configured None callback never replays a host-dependent product")
    measured :: sema_incremental_cache_stats(cache)
    second_count := 0
    loop item in measured.recomputed_items {
        if item == key -> second_count += 1
    }
    method_wave_require(second_count == 1 && measured.recomputes > primed.recomputes, "host reach remains volatile across requests and thread modes")
}

fn method_wave_cache_line_case() {
    before :: "struct LineOwner {{ fn point(self) -> Int Never! {{  panic(\"line\") }} }}\n"
    after :: "struct LineOwner {{ fn point(self) -> Int Never! {{ \npanic(\"line\") }} }}\n"
    before_graph :: method_wave_registration(before, false, "effect IO\n")
    after_graph :: method_wave_registration(after, false, "effect IO\n")
    before_func :: before_graph.modules[0].nominals[0].methods[0].declaration
    after_func :: after_graph.modules[0].nominals[0].methods[0].declaration
    method_wave_require(before.bytes().len() == after.bytes().len() && "{before_func:Debug}" == "{after_func:Debug}", "the source-map regression preserves full AST and byte offsets")
    threads :: CompilerThreads{cap: Val(1), cores: 2, memory_available: Val(268435456)}
    cache :: sema_incremental_cache_new()
    first :: method_wave_cached_checked(before_graph, threads, cache)
    baseline_before :: method_wave_checked(before_graph, threads, [SemaComptimeFunctionResult]{})
    method_wave_require("{first:Debug}" == "{baseline_before:Debug}", "the first line-sensitive check has canonical products")
    primed :: sema_incremental_cache_stats(cache)
    sema_incremental_cache_clear_measurement(cache)
    second :: method_wave_cached_checked(after_graph, threads, cache)
    baseline_after :: method_wave_checked(after_graph, threads, [SemaComptimeFunctionResult]{})
    method_wave_require("{second:Debug}" == "{baseline_after:Debug}", "same-byte newlines invalidate cached panic and diagnostic locations")
    measured :: sema_incremental_cache_stats(cache)
    method_wave_require(measured.hits == primed.hits && measured.recomputes > primed.recomputes, "actual source segments prevent a span-preserving stale hit")
}

fn method_wave_cache_binding_case() {
    before :: "struct Bound {{ value: Int }}\nstruct BindingOwner {{ fn read(self, bound: Bound) -> Int Never! {{ bound.value }} }}\n"
    after :: "struct Bound {{ other: Int }}\nstruct BindingOwner {{ fn read(self, bound: Bound) -> Int Never! {{ bound.value }} }}\n"
    before_graph :: method_wave_registration(before, false, "effect IO\n")
    after_graph :: method_wave_registration(after, false, "effect IO\n")
    before_func :: before_graph.modules[0].nominals[1].methods[0].declaration
    after_func :: after_graph.modules[0].nominals[1].methods[0].declaration
    method_wave_require(before.bytes().len() == after.bytes().len() && "{before_func:Debug}" == "{after_func:Debug}", "the binding regression preserves the complete method AST and source spans")
    threads :: CompilerThreads{cap: Val(1), cores: 2, memory_available: Val(268435456)}
    cache :: sema_incremental_cache_new()
    first :: method_wave_cached_checked(before_graph, threads, cache)
    baseline_before :: method_wave_checked(before_graph, threads, [SemaComptimeFunctionResult]{})
    method_wave_require("{first:Debug}" == "{baseline_before:Debug}", "the first resolved-field check has canonical products")
    primed :: sema_incremental_cache_stats(cache)
    sema_incremental_cache_clear_measurement(cache)
    second :: method_wave_cached_checked(after_graph, threads, cache)
    baseline_after :: method_wave_checked(after_graph, threads, [SemaComptimeFunctionResult]{})
    method_wave_require("{second:Debug}" == "{baseline_after:Debug}", "a changed resolved field cannot replay the old successful method")
    method_wave_require(baseline_before.complete && !baseline_after.complete, "the real field lookup distinguishes the two binding inputs")
    measured :: sema_incremental_cache_stats(cache)
    method_wave_require(measured.hits == primed.hits && measured.recomputes > primed.recomputes, "the frozen nominal and scope inputs force a real binding recheck")
}

fn method_wave_cache_foreign_body_case() {
    prefix :: method_wave_source(false)
    before :: "{prefix}\nfn route_handler() -> HTTPResponse HTTPError! {{ panic(\"alpha\") }}\nstruct Routes {{ fn bind(&self, mux: HTTPMux) -> Unit Never! {{ mux.get(\"/\", route_handler) }} }}\n"
    after :: "{prefix}\nfn route_handler() -> HTTPResponse HTTPError! {{ panic(\"bravo\") }}\nstruct Routes {{ fn bind(&self, mux: HTTPMux) -> Unit Never! {{ mux.get(\"/\", route_handler) }} }}\n"
    // Real canonical Net effect; no fabricated Core, hook or cache products.
    before_graph :: method_wave_registration(before, false, "effect IO\neffect Net\n")
    after_graph :: method_wave_registration(after, false, "effect IO\neffect Net\n")
    routes_index := -1
    loop index in 0..<before_graph.modules[0].nominals.len() {
        if before_graph.modules[0].nominals[index].symbol.name == "Routes" -> routes_index = index
    }
    method_wave_require(routes_index >= 0, "the real route owner is registered")
    before_method :: before_graph.modules[0].nominals[routes_index].methods[0]
    after_method :: after_graph.modules[0].nominals[routes_index].methods[0]
    method_wave_require(before.bytes().len() == after.bytes().len() && "{before_method:Debug}" == "{after_method:Debug}", "the foreign-body edit preserves the complete route method and spans")
    key :: before_method.symbol.id.key
    serial :: CompilerThreads{cap: Val(1), cores: 2, memory_available: Val(268435456)}
    parallel :: CompilerThreads{cap: Val(2), cores: 2, memory_available: Val(268435456)}
    cache :: sema_incremental_cache_new()
    first :: method_wave_cached_checked(before_graph, parallel, cache)
    baseline_before :: method_wave_checked(before_graph, serial, [SemaComptimeFunctionResult]{})
    method_wave_require(baseline_before.complete && "{first:Debug}" == "{baseline_before:Debug}", "real named HTTP registration has identical cold cached products")
    sema_incremental_cache_clear_measurement(cache)
    warm :: method_wave_cached_checked(before_graph, serial, cache)
    method_wave_require("{warm:Debug}" == "{baseline_before:Debug}", "owning-thread callbacks retain identical warm route products")
    warm_measurement :: sema_incremental_cache_stats(cache)
    warm_bind_checks := 0
    loop item in warm_measurement.recomputed_items { if item == key -> warm_bind_checks += 1 }
    method_wave_require(warm_bind_checks == 1, "the accepted warm route query recomputes once despite an unchanged own body")
    sema_incremental_cache_clear_measurement(cache)
    changed :: method_wave_cached_checked(after_graph, parallel, cache)
    baseline_after :: method_wave_checked(after_graph, serial, [SemaComptimeFunctionResult]{})
    method_wave_require(baseline_after.complete && "{changed:Debug}" == "{baseline_after:Debug}", "a real foreign handler-body change preserves canonical route products")
    changed_measurement :: sema_incremental_cache_stats(cache)
    changed_bind_checks := 0
    loop item in changed_measurement.recomputed_items { if item == key -> changed_bind_checks += 1 }
    method_wave_require(changed_bind_checks == 1, "worker foreign-raw reads count one accepted route recompute, independently of handler hits")
}

fn method_wave_cache_utf8_bytes_case() {
    source :: "struct TextOwner {{ fn text(&self) -> String Never! {{ \"é\" }} }}\n"
    graph :: method_wave_registration(source, false, "effect IO\n")
    cache :: sema_incremental_cache_new()
    checked :: method_wave_cached_checked(graph, compiler_threads_single(), cache)
    baseline :: method_wave_checked(graph, compiler_threads_single(), [SemaComptimeFunctionResult]{})
    method_wave_require(checked.complete && "{checked:Debug}" == "{baseline:Debug}", "the UTF-8 cache case uses real identical checker products")
    stats :: sema_incremental_cache_stats(cache)
    expected := 0
    permit :: cache.state.guard_read()
    expected += permit.value.frozen.bytes().len()
    loop key in permit.value.scope_inputs.keys() {
        expected += key.bytes().len() + permit.value.scope_inputs[key].bytes().len()
    }
    loop key in permit.value.rows.keys() {
        row :: permit.value.rows[key]
        expected += key.bytes().len() + row.input.bytes().len() + "{row.value:Debug}".bytes().len()
    }
    method_wave_require("é".len() == 1 && "é".count_bytes() == 2, "Unicode scalar length is not retained UTF-8 byte volume")
    method_wave_require(stats.live_items > 0 && stats.live_item_bytes == expected, "live_item_bytes matches the actual retained UTF-8 strings, not character counts or allocator RSS")
}

fn run() {
    positive :: method_wave_source(false)
    negative :: method_wave_source(true)
    method_wave_case(positive, false, false, false, false)
    method_wave_case(negative, true, false, false, false)
    method_wave_case(negative, true, true, false, false)
    method_wave_case(positive, false, false, true, false)
    method_wave_case(negative, true, true, true, false)
    method_wave_cache_case(positive)
    method_wave_cache_line_case()
    method_wave_cache_binding_case()
    method_wave_cache_foreign_body_case()
    method_wave_cache_utf8_bytes_case()
    unit_source :: "{positive}\n#UnitFamily(WaveLength, base: meter) {{ meter\nfoot(scale: 381/1250) }}\nstruct UnitOwner {{ value: Int\nfn unit_value(&self) -> Meter Never! {{ converted :: Meter{{Foot.from_float(Float{{8.0}})}}\nconverted }}\nfn after_unit(&self) -> Int Never! {{ self.value }} }}\n"
    method_wave_case(unit_source, true, true, false, true)
    method_wave_cache_host_case(unit_source)
    generated_source :: "{positive}\nderive T.BrokenWave {{ fn generated_value(self) -> Int Never! {{ missing_generated_value }} }}\n#BrokenWave\nstruct GeneratedOwner {{ value: Int }}\n"
    method_wave_case(generated_source, true, true, false, false)
    print("method body wave: real serial/parallel checked and lowered equivalence passed")
}
