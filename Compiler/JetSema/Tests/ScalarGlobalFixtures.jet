// Type belongs on tier-stable scalar data.
root := I64{0}
argc := I64{-1}
small := U8{255}
enabled := Bool{false}
fraction := F32{1.25}
precise := Float{1.5}
CONSTANT_I64 :: I64{3}

fn read_root() -> I64 { root }
fn read_argc() -> I64 { argc }
fn read_small() -> U8 { small }
fn read_enabled() -> Bool { enabled }
fn read_fraction() -> F32 { fraction }
fn read_precise() -> Float { precise }
fn read_constant() -> I64 { CONSTANT_I64 }

// A function writes a plain module `:=` only inside `#Unsafe`
// (D-MODULE-WRITE1=A); the writes still check against each declared type.
#Test("scalar_global_fixtures") {
    #Unsafe("single-threaded test: plain module writes of each scalar type") {
        root = I64{3}
        argc = I64{-2}
        small = U8{1}
        enabled = Bool{true}
        fraction = F32{2.5}
        precise = Float{3.5}
    }
}
