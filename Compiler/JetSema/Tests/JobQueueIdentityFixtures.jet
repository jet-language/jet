// Assemble with production compiler sources and this replacement run.
// Admission is covered by the paired accepted/rejected Core corpus fixtures;
// this assertion pins the production Jet diagnostic to the Rust contract.
fn run() {
    span :: Span{start: 7, end: 15}
    diagnostic :: sema_job_queue_identity_error("enqueue", span)
    assert(diagnostic.code == "E0112")
    assert(diagnostic.span == Val((span)))
    assert(diagnostic.what == "`JobQueue.enqueue` expects a checked `#Job` function")
    assert(diagnostic.why == "the queue identity is attached to the declared #Job and cannot be selected by an arbitrary function value")
    assert(diagnostic.fix == "pass the name of a #Job function with exactly one payload parameter")
}
