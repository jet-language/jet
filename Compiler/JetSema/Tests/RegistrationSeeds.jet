// Graph preparation takes seeded module rows, which come registered (the
// precompiled Core record's, rebased to the graph): they hold the first module
// indexes, keep the rows registration gave them, and the input modules after
// them register against them. A check that reports on a module's own
// declarations doesn't report on a seeded one again, and a seeded module that
// comes with its finalized result is taken as it is: finalization checks none
// of its bodies and writes none of its slot, and its Core usage, when it
// comes with it, is that row, not walked again. A finalized row splits into
// the Core record's body packets, which take back to the same row. A taken
// seeded module's comptime sources are not collected again: its values come
// from the record.
use {
    jet_parser.[parse_source]
    jet_sema.[
        SemaBuildFacts, SemaComptimeFunctionResult, SemaComptimeItemValue,
        SemaCoreModuleUsageResult, SemaCoreUsageSpan,
        SemaForeignProviderInput, SemaGraphModuleResult, SemaGraphResult,
        SemaRegistrationForeignHandleFacts, SemaRegistrationGraph,
        SemaRegistrationHostHooks, SemaRegistrationImportEdge,
        SemaRegistrationModule, SemaRegistrationModuleInput,
        SemaRegistrationPackagePolicy, SemaSourceOrigin, SemaSourceSegment,
        sema_collect_comptime_declarations, sema_core_body_packet_take,
        sema_core_body_packets, sema_finalize_graph, sema_graph_trail_init,
        sema_marker_rules_check_inline_always,
        sema_registration_module_index, sema_registration_prepare_graph,
        sema_registration_reserved_symbols,
    ]
    jet_driver.[jet_driver_canonical_effect_module]
    jet_foundation.[Diagnostic, FnBody, ModuleID, ModuleTable, RuntimeLayer, Span, SymbolKeys, compiler_threads_single, jet_target_machine_hosted, module_intern, module_table]
}

SEEDS_EFFECTS: "IO: struct {{\n    impl Effect {{}}\n}}\nPanic: struct {{\n    impl Effect {{}}\n}}\n"
SEEDS_MAIN: "Point: struct {{\n    x: Int\n}}\n\nmain: fn() {{\n}}\n"
// A promise E0917 refuses: `#Inline(Always)` on a function that calls itself.
SEEDS_INLINE: "#Inline(Always)\nspin: fn() {{\n    spin()\n}}\n\nmain: fn() {{\n}}\n"
// A module whose bodies call one another, for a finalized result to seed.
SEEDS_CALLS: "Point: struct {{\n    x: Int\n}}\n\nnorm: fn(point: Point) -> Int {{\n    point.x * point.x\n}}\n\nmain: fn() {{\n    _: norm(Point{{x: 3}})\n}}\n"
// A module whose constant is computed while building: a comptime source.
SEEDS_VALUE: "square: fn(x: Int) -> Int {{\n    x * x\n}}\n\nLIMIT: square(4)\n\nmain: fn() {{\n}}\n"

registration_seeds_input: fn(source: String, table: &ModuleTable) -> SemaRegistrationModuleInput {
    parsed := parse_source(source.bytes())
    assert_eq(parsed.diagnostics.len(), 0)
    segment: SemaSourceSegment{generated: Span{start: 0, end: source.len()}, source_file: "main.jet", source_start: 0, line_starts: [Int]{0}, origin: SemaSourceOrigin.Snapshot}
    SemaRegistrationModuleInput{package_identity: "seeds", module_identity: module_intern(table, "seeds::main"), module_name: "main", core_source_alias: "", module_path: "main.jet", source_file: "main.jet", source_segments: [SemaSourceSegment]{segment}, source_origin: SemaSourceOrigin.Snapshot, program: parsed.program.move(), foreign_handles: [SemaRegistrationForeignHandleFacts]{}, source: source}
}

registration_seeds_facts: fn() -> SemaBuildFacts {
    SemaBuildFacts{package_name: "seeds", package_version: "0.1.0", os: "linux", profile: "dev", stamp_git: None, stamp_dirty: false, stamp_toolchain: "fixture", stamp_at: ""}
}

// The `main` row of the consumed `graph`.
registration_seeds_take: fn(graph: &&SemaRegistrationGraph, main: ModuleID) -> [SemaRegistrationModule] {
    rows := graph.modules.move()
    seeds := [SemaRegistrationModule]{}
    loop rows.len() > 0 {
        row := rows.pop() ?? break
        if row.module_identity == main -> seeds.push(row)
    }
    seeds
}

// `graph` declared and finalized, its registration graph kept on the result.
registration_seeds_finalize: fn(graph: &&SemaRegistrationGraph) -> SemaGraphResult {
    stage := sema_collect_comptime_declarations(graph, [SemaRegistrationPackagePolicy]{}, compiler_threads_single(), None) ?? panic("declaration checking failed: {err}")
    declared := stage.graph.move()
    stage.graph = None
    registration := declared.move() ?? panic("the declaration pass lost its registration graph")
    trail := sema_graph_trail_init()
    hooks: Shared{SemaRegistrationHostHooks{numeric_unit_conversion_exact: None}}
    sema_finalize_graph(registration, trail, stage, [SemaComptimeItemValue]{}, [SemaComptimeFunctionResult]{}, hooks, compiler_threads_single(), None, true, None)
}

// The finalized `seeds::main` module result of `source` checked beside the
// canonical effect module; its finalized registration row goes to `seeds`,
// the module table its ids index to `seeded_table` and the symbol ranges a
// graph seeded with it reserves to `reserved`.
registration_seeds_finalized: fn(source: String, seeds: &[SemaRegistrationModule], seeded_table: &ModuleTable, reserved: &[SymbolKeys]) -> SemaGraphModuleResult {
    table := module_table()
    main_id: module_intern(table, "seeds::main")
    effects := jet_driver_canonical_effect_module(SEEDS_EFFECTS, table) ?? panic("the canonical effect source does not parse")
    effect_identity: effects.module_identity
    first := sema_registration_prepare_graph([SemaRegistrationModuleInput]{registration_seeds_input(source, table), effects}, [SemaRegistrationModule]{}, [SymbolKeys]{}, [SemaRegistrationImportEdge]{}, "seeds", main_id, effect_identity, table, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), registration_seeds_facts(), false, compiler_threads_single())
    checked := registration_seeds_finalize(first)
    assert(checked.complete)
    finalized := checked.registration_graph.move() ?? panic("finalization kept no registration graph")
    checked.registration_graph = None
    index: sema_registration_module_index(finalized, main_id) ?? panic("the main module was not registered")
    module_result := checked.modules[index].copy()
    seeded_table = finalized.module_table.copy()
    reserved = sema_registration_reserved_symbols(finalized.symbols, [ModuleID]{main_id})
    seeds = registration_seeds_take(finalized, main_id)
    module_result
}

// `seeds` with their finalized `results` and Core `usage` rows (none: each
// is walked) taken by a graph of the canonical effect module over the seeds'
// module `table` and `reserved` symbol ranges, finalized.
registration_seeds_refinalize: fn(seeds: &&[SemaRegistrationModule], results: &&[SemaGraphModuleResult], usage: &&[SemaCoreModuleUsageResult], table: &&ModuleTable, reserved: &&[SymbolKeys]) -> SemaGraphResult {
    owned := table.move()
    main_id: module_intern(owned, "seeds::main")
    effects := jet_driver_canonical_effect_module(SEEDS_EFFECTS, owned) ?? panic("the canonical effect source does not parse")
    effect_identity: effects.module_identity
    second := sema_registration_prepare_graph([SemaRegistrationModuleInput]{effects}, seeds, reserved, [SemaRegistrationImportEdge]{}, "seeds", main_id, effect_identity, owned, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), registration_seeds_facts(), false, compiler_threads_single())
    assert_eq(second.seeded, 1)
    second.seeded_results = results.move()
    second.seeded_core_usage = usage.move()
    registration_seeds_finalize(second)
}

// How many comptime sources of module `main` the declaration pass of `graph`
// collects.
registration_seeds_sources: fn(graph: &&SemaRegistrationGraph, main: ModuleID) -> Int {
    stage := sema_collect_comptime_declarations(graph, [SemaRegistrationPackagePolicy]{}, compiler_threads_single(), None)
    count := 0
    loop source in stage.sources {
        if source.module_identity == main -> count += 1
    }
    count
}

#Test("seeded rows take the first module indexes and keep their registration") {
    table := module_table()
    main_id: module_intern(table, "seeds::main")
    effects := jet_driver_canonical_effect_module(SEEDS_EFFECTS, table) ?? panic("the canonical effect source does not parse")
    effect_identity: effects.module_identity
    first := sema_registration_prepare_graph([SemaRegistrationModuleInput]{registration_seeds_input(SEEDS_MAIN, table), effects}, [SemaRegistrationModule]{}, [SymbolKeys]{}, [SemaRegistrationImportEdge]{}, "seeds", main_id, effect_identity, table, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), registration_seeds_facts(), false, compiler_threads_single())
    assert_eq(first.seeded, 0)
    first_complete: first.complete
    first_diagnostics: first.diagnostics.len()
    module_count: first.modules.len()
    seeded_table := first.module_table.copy()
    reserved := sema_registration_reserved_symbols(first.symbols, [ModuleID]{main_id})
    seeds := registration_seeds_take(first, main_id)
    assert_eq(seeds.len(), 1)
    nominals: seeds[0].nominals.len()
    impls: seeds[0].impls.len()
    functions: seeds[0].functions.len()
    assert(nominals > 0)
    again := jet_driver_canonical_effect_module(SEEDS_EFFECTS, seeded_table) ?? panic("the canonical effect source does not parse")
    second := sema_registration_prepare_graph([SemaRegistrationModuleInput]{again}, seeds, reserved, [SemaRegistrationImportEdge]{}, "seeds", main_id, effect_identity, seeded_table, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), registration_seeds_facts(), false, compiler_threads_single())
    assert_eq(second.seeded, 1)
    // The same modules (the retained Prelude error module among them), the
    // seeded one first.
    assert_eq(second.modules.len(), module_count)
    assert_eq(second.modules[0].module_identity, main_id)
    assert_eq(sema_registration_module_index(second, main_id) ?? -1, 0)
    assert_eq(sema_registration_module_index(second, effect_identity) ?? -1, 1)
    // The seeded row keeps exactly the rows it registered with: no pass
    // registered, attached or injected into it again.
    assert_eq(second.modules[0].nominals.len(), nominals)
    assert_eq(second.modules[0].impls.len(), impls)
    assert_eq(second.modules[0].functions.len(), functions)
    // The input modules register against the seed as they did beside its
    // source.
    assert_eq(second.complete, first_complete)
    assert_eq(second.diagnostics.len(), first_diagnostics)
}

#Test("a seed and an input with one identity are one module defined twice") {
    table := module_table()
    main_id: module_intern(table, "seeds::main")
    effects := jet_driver_canonical_effect_module(SEEDS_EFFECTS, table) ?? panic("the canonical effect source does not parse")
    effect_identity: effects.module_identity
    first := sema_registration_prepare_graph([SemaRegistrationModuleInput]{registration_seeds_input(SEEDS_MAIN, table), effects}, [SemaRegistrationModule]{}, [SymbolKeys]{}, [SemaRegistrationImportEdge]{}, "seeds", main_id, effect_identity, table, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), registration_seeds_facts(), false, compiler_threads_single())
    module_count: first.modules.len()
    seeded_table := first.module_table.copy()
    reserved := sema_registration_reserved_symbols(first.symbols, [ModuleID]{main_id})
    seeds := registration_seeds_take(first, main_id)
    again := jet_driver_canonical_effect_module(SEEDS_EFFECTS, seeded_table) ?? panic("the canonical effect source does not parse")
    second := sema_registration_prepare_graph([SemaRegistrationModuleInput]{registration_seeds_input(SEEDS_MAIN, seeded_table), again}, seeds, reserved, [SemaRegistrationImportEdge]{}, "seeds", main_id, effect_identity, seeded_table, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), registration_seeds_facts(), false, compiler_threads_single())
    assert_eq(second.seeded, 1)
    // The duplicate input adds no row.
    assert_eq(second.modules.len(), module_count)
    assert(!second.complete)
    found := false
    loop diagnostic in second.diagnostics {
        if diagnostic.code == "E0105" && diagnostic.what.contains("seeds::main") -> found = true
    }
    assert(found)
}

#Test("a seeded module's own declarations are not reported on again") {
    table := module_table()
    main_id: module_intern(table, "seeds::main")
    effects := jet_driver_canonical_effect_module(SEEDS_EFFECTS, table) ?? panic("the canonical effect source does not parse")
    effect_identity: effects.module_identity
    first := sema_registration_prepare_graph([SemaRegistrationModuleInput]{registration_seeds_input(SEEDS_INLINE, table), effects}, [SemaRegistrationModule]{}, [SymbolKeys]{}, [SemaRegistrationImportEdge]{}, "seeds", main_id, effect_identity, table, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), registration_seeds_facts(), false, compiler_threads_single())
    reported := [Diagnostic]{}
    assert(sema_marker_rules_check_inline_always(first, [SemaGraphModuleResult]{}, reported))
    assert_eq(reported.len(), 1)
    assert_eq(reported[0].code, "E0917")
    seeded_table := first.module_table.copy()
    reserved := sema_registration_reserved_symbols(first.symbols, [ModuleID]{main_id})
    seeds := registration_seeds_take(first, main_id)
    again := jet_driver_canonical_effect_module(SEEDS_EFFECTS, seeded_table) ?? panic("the canonical effect source does not parse")
    second := sema_registration_prepare_graph([SemaRegistrationModuleInput]{again}, seeds, reserved, [SemaRegistrationImportEdge]{}, "seeds", main_id, effect_identity, seeded_table, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), registration_seeds_facts(), false, compiler_threads_single())
    assert_eq(second.seeded, 1)
    // The marker check left the seeded row an empty list of its own.
    assert_eq(second.unknown_rule_diagnostics.len(), second.modules.len())
    assert_eq(second.unknown_rule_diagnostics[0].len(), 0)
    reported_again := [Diagnostic]{}
    assert(!sema_marker_rules_check_inline_always(second, [SemaGraphModuleResult]{}, reported_again))
    assert_eq(reported_again.len(), 0)
}

#Test("a seeded module's finalized result is taken as it is and not written") {
    seeds := [SemaRegistrationModule]{}
    seeded_table := module_table()
    reserved := [SymbolKeys]{}
    module_result := registration_seeds_finalized(SEEDS_CALLS, seeds, seeded_table, reserved)
    assert(module_result.functions.len() >= 2)
    taken := [SemaGraphModuleResult]{module_result.copy()}
    walked := [SemaCoreModuleUsageResult]{}
    checked := registration_seeds_refinalize(seeds, taken, walked, seeded_table, reserved)
    assert(checked.complete)
    // Finalizing against the same Core changes nothing on the taken slot.
    assert_eq(checked.seeded_writes, 0)
    assert_eq(checked.modules[0].module_identity, module_result.module_identity)
    assert_eq("{checked.modules[0].functions:Debug}", "{module_result.functions:Debug}")
    assert_eq("{checked.modules[0].call_facts:Debug}", "{module_result.call_facts:Debug}")
}

#Test("a taken seeded slot a finalization would change is counted, not written") {
    seeds := [SemaRegistrationModule]{}
    seeded_table := module_table()
    reserved := [SymbolKeys]{}
    module_result := registration_seeds_finalized(SEEDS_CALLS, seeds, seeded_table, reserved)
    // A stale effect row on a taken body: the solve finds another one.
    stale := module_result.copy()
    loop index in 0..<stale.functions.len() -> stale.functions[index].effects.solved.push("Stale")
    taken := [SemaGraphModuleResult]{stale.copy()}
    walked := [SemaCoreModuleUsageResult]{}
    checked := registration_seeds_refinalize(seeds, taken, walked, seeded_table, reserved)
    assert(checked.seeded_writes > 0)
    // The slot stays as it was given.
    assert_eq("{checked.modules[0].functions:Debug}", "{stale.functions:Debug}")
}

#Test("a taken seeded module's Core usage is the row it came with, not walked again") {
    seeds := [SemaRegistrationModule]{}
    seeded_table := module_table()
    reserved := [SymbolKeys]{}
    module_result := registration_seeds_finalized(SEEDS_CALLS, seeds, seeded_table, reserved)
    identity: module_result.module_identity
    // A usage no walk of the module notes: it can only come from the row.
    given := [SemaCoreModuleUsageResult]{SemaCoreModuleUsageResult{
        module_identity: identity,
        used_core: [String]{"core.fixture::given"},
        usage_spans: [SemaCoreUsageSpan]{},
        ffi_callback_keys: [String]{},
        closure: [String]{"core.fixture::given"},
        inferred_layer: RuntimeLayer.Core,
    }}
    taken := [SemaGraphModuleResult]{module_result.move()}
    checked := registration_seeds_refinalize(seeds, taken, given, seeded_table, reserved)
    assert(checked.complete)
    assert(checked.core_usage.modules[0].module_identity == identity)
    assert_eq(checked.core_usage.modules[0].used_core, [String]{"core.fixture::given"})
    found := 0
    loop name in checked.core_usage.used_core {
        if name == "core.fixture::given" -> found += 1
    }
    assert_eq(found, 1)
}

#Test("a taken seeded module's comptime sources are not collected again") {
    table := module_table()
    main_id: module_intern(table, "seeds::main")
    effects := jet_driver_canonical_effect_module(SEEDS_EFFECTS, table) ?? panic("the canonical effect source does not parse")
    effect_identity: effects.module_identity
    first := sema_registration_prepare_graph([SemaRegistrationModuleInput]{registration_seeds_input(SEEDS_VALUE, table), effects}, [SemaRegistrationModule]{}, [SymbolKeys]{}, [SemaRegistrationImportEdge]{}, "seeds", main_id, effect_identity, table, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), registration_seeds_facts(), false, compiler_threads_single())
    stage := sema_collect_comptime_declarations(first, [SemaRegistrationPackagePolicy]{}, compiler_threads_single(), None)
    collected := 0
    loop source in stage.sources {
        if source.module_identity == main_id -> collected += 1
    }
    assert(collected > 0)
    staged := stage.graph.move()
    stage.graph = None
    registered := staged.move() ?? panic("the declaration pass lost its registration graph")
    index: sema_registration_module_index(registered, main_id) ?? panic("the main module was not registered")
    declared := stage.modules[index].copy()
    seeded_table := registered.module_table.copy()
    reserved := sema_registration_reserved_symbols(registered.symbols, [ModuleID]{main_id})
    seeds := registration_seeds_take(registered, main_id)
    // Seeded without its result, the module is not taken: its sources are
    // collected as before.
    kept_table := seeded_table.copy()
    again := jet_driver_canonical_effect_module(SEEDS_EFFECTS, kept_table) ?? panic("the canonical effect source does not parse")
    kept := seeds.copy()
    second := sema_registration_prepare_graph([SemaRegistrationModuleInput]{again}, kept, reserved.copy(), [SemaRegistrationImportEdge]{}, "seeds", main_id, effect_identity, kept_table, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), registration_seeds_facts(), false, compiler_threads_single())
    assert_eq(registration_seeds_sources(second, main_id), collected)
    // Taken with its result, it comes with its values: none is collected.
    third_effects := jet_driver_canonical_effect_module(SEEDS_EFFECTS, seeded_table) ?? panic("the canonical effect source does not parse")
    third := sema_registration_prepare_graph([SemaRegistrationModuleInput]{third_effects}, seeds, reserved, [SemaRegistrationImportEdge]{}, "seeds", main_id, effect_identity, seeded_table, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), registration_seeds_facts(), false, compiler_threads_single())
    third.seeded_results = [SemaGraphModuleResult]{declared.move()}
    assert_eq(registration_seeds_sources(third, main_id), 0)
}

// `texts` sorted: two lists of the same item texts in any order compare equal.
registration_seeds_sorted: fn(texts: &&[String]) -> [String] {
    owned := texts.move()
    owned.sort()
    owned
}

#Test("a finalized module row splits into body packets that take back to the same row") {
    seeds := [SemaRegistrationModule]{}
    seeded_table := module_table()
    reserved := [SymbolKeys]{}
    module_result := registration_seeds_finalized(SEEDS_CALLS, seeds, seeded_table, reserved)
    whole := module_result.copy()
    bodies := whole.functions.move()
    whole.functions = [FnBody]{}
    keys := loop function in bodies -> function.key.copy()
    assert(keys.len() >= 2)
    packets := [SemaComptimeFunctionResult]{}
    row := sema_core_body_packets(whole, bodies, packets)
    assert_eq(packets.len(), keys.len())
    assert_eq(row.functions.len(), 0)
    // Each packet holds its own body and the call facts it recorded; the
    // row keeps none of a body's.
    with_calls := 0
    loop (index, packet) in packets {
        assert_eq(packet.function_key, keys[index])
        assert(packet.function != None)
        loop fact in packet.call_facts -> assert_eq(fact.caller_key, packet.function_key)
        if packet.call_facts.len() > 0 -> with_calls += 1
    }
    assert(with_calls > 0)
    loop fact in row.call_facts -> assert(!keys.contains(fact.caller_key))
    loop packets.len() > 0 {
        packet := packets.pop() ?? break
        sema_core_body_packet_take(row, packet)
    }
    assert_eq(registration_seeds_sorted(loop item in row.functions -> "{item:Debug}"), registration_seeds_sorted(loop item in module_result.functions -> "{item:Debug}"))
    assert_eq(registration_seeds_sorted(loop item in row.call_facts -> "{item:Debug}"), registration_seeds_sorted(loop item in module_result.call_facts -> "{item:Debug}"))
    assert_eq(registration_seeds_sorted(loop item in row.name_references -> "{item:Debug}"), registration_seeds_sorted(loop item in module_result.name_references -> "{item:Debug}"))
    assert_eq(registration_seeds_sorted(loop item in row.failure_facts -> "{item:Debug}"), registration_seeds_sorted(loop item in module_result.failure_facts -> "{item:Debug}"))
    assert_eq(registration_seeds_sorted(loop item in row.compute_facts -> "{item:Debug}"), registration_seeds_sorted(loop item in module_result.compute_facts -> "{item:Debug}"))
    assert_eq(registration_seeds_sorted(loop item in row.copy_events -> "{item:Debug}"), registration_seeds_sorted(loop item in module_result.copy_events -> "{item:Debug}"))
    assert_eq(registration_seeds_sorted(loop item in row.comptime_requests -> "{item:Debug}"), registration_seeds_sorted(loop item in module_result.comptime_requests -> "{item:Debug}"))
}
