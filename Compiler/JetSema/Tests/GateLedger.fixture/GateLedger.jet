// Rust GateLedger unit cases, plus source projection through production visitors.
fn gate_test_require(ok: Bool, message: String) Never! {
    if !ok -> panic("GateLedger: {message}")
}

fn gate_test_entry(kind: GateKind, source: String, offset: Int) -> GateEntry Never! {
    gate_source_entry(kind, "test", "test", source, Span{start: offset, end: offset + 1}, "x", None, "x", "recorded")
}

fn gate_test_names() -> NameLedger Never! {
    name_ledger_from_facts(NameFacts{modules: [], declarations: [], aliases: [], references: [], structure_facts: []})
}

fn gate_test_same_entry(left: GateEntry, right: GateEntry) -> Bool Never! {
    if left.kind != right.kind || left.domain != right.domain || left.scope != right.scope || left.source != right.source || left.span != right.span || left.subject != right.subject || left.reason != right.reason || left.status != right.status || left.detail != right.detail || left.provenance != right.provenance || left.operations.len() != right.operations.len() -> return false
    loop index in 0..<left.operations.len() {
        a :: left.operations[index]
        b :: right.operations[index]
        if a.kind != b.kind || a.span != b.span || a.required != b.required || a.asserted != b.asserted || a.discharged != b.discharged -> return false
    }
    true
}

// The unchanged source fixture's top-level `approx` initializer is projected
// directly as a reference; the callback walker must collect the exact same
// ordered rows without losing a pre-existing row or copying its visitor.
fn gate_test_callback_borrow(rows: [SemaGateModule], projected: GateLedger) Never! {
    inspection :: sema_unsafe_inspect(rows, GateSet{})
    context :: shared SemaGateContext{checked_text_types: [String:Bool]{}, unsafe_gates: inspection.gates}
    seed :: gate_test_entry(GateKind.TrustGrant, "seed", 0)
    wrapped := SemaGateVisitor{source: "app.jet", ledger: GateLedger{rows: [GateEntry]{seed}}, context: context}
    reference := SemaGateVisitor{source: "app.jet", ledger: GateLedger{rows: [GateEntry]{seed}}, context: context}
    loop item in rows[0].program.items {
        if item == .Func(function) {
            loop statement in function.body {
                ast_visit_statement(statement, (expression: Expr) -> &wrapped.visit(expression), false)
                if statement == .Val(binding) -> &reference.visit(binding.init)
            }
        }
    }
    gate_test_require(wrapped.ledger.rows.len() == 2, "borrowed callback retains seed and appends fixture precision row")
    gate_test_require(wrapped.ledger.rows.len() == reference.ledger.rows.len(), "callback walk and direct fixture projection collect identical row counts")
    loop index in 0..<reference.ledger.rows.len() {
        gate_test_require(gate_test_same_entry(wrapped.ledger.rows[index], reference.ledger.rows[index]), "callback walk and direct fixture projection collect identical ordered rows")
    }
    matches := 0
    loop entry in projected.rows {
        if gate_test_same_entry(entry, wrapped.ledger.rows[1]) -> matches += 1
    }
    gate_test_require(matches == 1, "borrowed visitor row matches the unchanged complete gate fixture")
}

fn run() Never! {
    ledger := GateLedger{}
    gate_ledger_push(&ledger, gate_test_entry(GateKind.PrecisionDemotion, "a.jet", 1))
    gate_ledger_push(&ledger, gate_test_entry(GateKind.Unsafe, "a.jet", 2))
    gate_ledger_sort(&ledger)
    gate_test_require(ledger.rows[0].kind == GateKind.Unsafe, "security before knowledge")
    first := gate_test_entry(GateKind.TrustGrant, "trust", 0)
    first.provenance = ["trust store"]
    second := first
    second.provenance = ["lockfile"]
    duplicate := GateLedger{}
    gate_ledger_push(&duplicate, ^first)
    gate_ledger_push(&duplicate, ^second)
    gate_test_require(duplicate.rows.len() == 1 && duplicate.rows[0].provenance == ([String]{"lockfile", "trust store"}), "coalesced fact preserves both provenance rows")
    external := gate_test_entry(GateKind.TrustGrant, "store", 0)
    external.span = None
    written := external
    written.source = "lock"
    written.reason = Val("verified publisher")
    gate_ledger_push(&duplicate, ^external)
    gate_ledger_push(&duplicate, ^written)
    gate_test_require(duplicate.rows.len() == 2 && duplicate.rows[1].reason == (Val("verified publisher")), "spanless writer coalescing and reason enrichment")
    names := gate_test_names()
    &names.facts.structure_facts.push(StructureFact{kind: StructureFactKind.Liveness, subject: "files", source: "app.jet", span: Span{start: 4, end: 9}, status: "unused", detail: "remove or rename to _files", gate: Val("_name")})
    structure := GateLedger{}
    sema_gate_append_structure(&structure, names)
    gate_test_require(structure.rows.len() == 1 && structure.rows[0].kind == GateKind.Structure && structure.rows[0].reason == (Val("_name")), "structure facts use canonical ledger")
    parsed :: parse_source("fn _helper(_input: Int) {{\n_unused := approx(7)\n#Unsafe(\"live\") {{ value := pointer.* }}\n}}".bytes())
    gate_test_require(parsed.diagnostics.len() == 0, "source fixture parse")
    rows :: [SemaGateModule]{SemaGateModule{source: "app.jet", program: parsed.program}}
    projected :: sema_gate_ledger_collect(rows, gate_test_names(), GateSet{build_flag: true, session_flag: true}, [GateEntry]{}, sema_gate_checked_text_names([parsed.program]))
    unsafe_count := 0
    structure_count := 0
    precision_count := 0
    invocation_count := 0
    loop entry in projected.rows {
        if entry.kind == {
            .Unsafe -> {
                unsafe_count += 1
                gate_test_require(entry.operations.len() == 1 && entry.operations[0].kind == "dereference", "unsafe operation projection")
            }
            .Structure -> { structure_count += 1 }
            .PrecisionDemotion -> precision_count += 1
            .BuildFlag | .SessionFlag -> invocation_count += 1
            else -> {}
        }
    }
    gate_test_require(unsafe_count == 1 && structure_count == 3 && precision_count == 1 && invocation_count == 2, "source and invocation rows")
    gate_test_callback_borrow(rows, projected)
    refusal := rows
    refusal[0].declarations = [PolicyDeclaration{key: PolicyKey.PrecisionDemotion, value: PolicyValue.Forbid, scope: PolicyScope.Organization, span: Span{start: 0, end: 1}, target: None, source: "org.jet"}]
    diagnostics :: sema_gate_policy_diagnostics(projected, refusal, 0)
    gate_test_require(diagnostics.len() == 1 && diagnostics[0].diagnostic.code == "E3415", "new gate kinds obey owning policy")
    gate_test_require(gate_kind_parse("roundED") == (Val(GateKind.PrecisionDemotion)), "kind parsing")
    gate_test_require(gate_kind_policy_key(GateKind.LintAllow) == PolicyKey.LintAllow, "gate and policy closed sets match")
    context :: SemaGateContext{
        checked_text_types: [String:Bool]{},
        unsafe_gates: [
            UnsafeGateInspection{source: "app.jet", span: Span{start: 0, end: 100}, reason: Val("outer"), mode: "GateOnly", provenance: [], operations: []},
            UnsafeGateInspection{source: "app.jet", span: Span{start: 20, end: 80}, reason: Val("inner"), mode: "GateOnly", provenance: [], operations: []},
        ],
    }
    raw :: sema_gate_checked_raw("app.jet", Span{start: 30, end: 40}, context)
    gate_test_require(raw.kind == GateKind.Unsafe && raw.reason == (Val("inner")) && raw.provenance.len() == 2, "checked-text raw uses innermost unsafe provenance")
    unguarded :: sema_gate_checked_raw("other.jet", Span{start: 30, end: 40}, context)
    gate_test_require(unguarded.status == (Val("missing")) && unguarded.reason == .None, "checked-text raw does not cross source boundaries")
}
