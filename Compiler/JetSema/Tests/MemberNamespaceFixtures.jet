// Paired checking fixture: no namespace selection depends on call validity.
Generic: struct<T> {
    value: T
    step: fn(Int) -> Int
    step: fn<U>(self, amount: U) -> Int Never! { 20 }
}
Step: trait {
    step: fn(self, amount: Int) -> Int Never! { amount + 5 }
}
DefaultWorker: struct { step: fn(Int) -> Int }
impl DefaultWorker.Step {}
Hook: struct { mul: fn(Int) -> Int }
impl Hook.Mul(Int) {
    mul: fn(self, rhs: Int) -> Int Never! { rhs + 10 }
}
MutableWorker: struct {
    value: Int
    step: fn(Int) -> Int
    step: fn(&self, amount: Int) -> Int Never! {
        self.value += amount
        self.value
    }
}
via_bound: fn<T: Step>(value: T) -> Int Never! { value.step(1) }
#Test("member_namespace_fixtures") {
    generic: Generic<Int>{value: 1, step: n -> n}
    print(generic.step<Int>(1))
    print(generic.step.call(1))
    inherited: DefaultWorker{step: n -> n * 2}
    print(inherited.step(1))
    print(inherited.step.call(1))
    print(via_bound(inherited))
    computed: Computed{base: 3}
    print(computed.value)
    print(computed.value())
    hook: Hook{mul: n -> n * 2}
    print(hook.mul(3))
    print(hook.mul.call(3))
    print(hook * 3)
    mutable := MutableWorker{value: 1, step: n -> n * 2}
    print(&mutable.step(2))
    print(mutable.value)
    print(mutable.step.call(2))
}
