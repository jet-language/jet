// Exercise the production E0113 builder after the failure solver adds its
// uninhabited rail, through the production checker and emitter.
use jet_foundation.[Diagnostic, Span, Type]
use jet_sema.[sema_check_context_init, sema_effective_return_type, sema_expression_absent, sema_expression_typed_literal_float_to_integer, sema_return_value_mismatch, sema_stmt_return_success_type]

rd_expect: fn(name: String, wanted: Type, offered: Type, fix: String) {
    span: Span{start: 0, end: 1}
    inferred: Type.Result{ok: wanted, err: Type.Named{name: "Never"}}
    diagnostic: sema_return_value_mismatch(name, inferred, offered, span)
    if diagnostic.code != "E0113" || diagnostic.span != (Val(span)) -> panic("return diagnostic lost its identity or span")
    if diagnostic.what.contains("Never!") || diagnostic.why.contains("Never!") -> panic("erased failure rail leaked into return advice")
    if diagnostic.fix != fix -> panic("wrong return repair: {diagnostic.fix}")
    if diagnostic.fix.contains("change the return type") -> panic("return repair changes the written contract")
    print("{name}: {diagnostic.fix}")
}

run: fn() {
    rd_expect("average", Type.Int, Type.Named{name: "Fraction"}, "`/` on whole numbers makes an exact Fraction; divide with `/%` to get a whole number rounded down")
    rd_expect("names", Type.List{element: Type.String}, Type.String, "Wrap the value in a list: `[value]`")
    rd_expect("label", Type.String, Type.Int, "Put the value in text with interpolation: \"{{value}}\"")
    rd_expect("first", Type.Int, Type.List{element: Type.Int}, "This is a whole list; hand back one element, or combine the elements into one value")
    rd_expect("answer", Type.Int, Type.String, "Hand back a Int value: convert this value to Int, or return the value you meant")
    // #4745: Core imports use the effective signature, and bare None
    // is checked against the optional success slot of the enclosing Result.
    implicit: sema_effective_return_type(Val(Type.String))
    if implicit != (Type.Result{ok: Type.String, err: Type.Named{name: "Err"}}) -> panic("import discarded implicit Err")
    slot: Type.Option{inner: Type.String}
    carrier: Type.Result{ok: slot, err: Type.Named{name: "Err"}}
    payload: sema_stmt_return_success_type(Val(carrier))
    diagnostics := [Diagnostic]{}
    context := sema_check_context_init()
    absent: sema_expression_absent(Span{start: 0, end: 1}, Val(payload), context, diagnostics) ?? panic("optional Result success rejected None")
    if absent.ty != slot || diagnostics.len() != 0 -> panic("None lost the enclosing success type")
    print("E0113 return repairs: passed")
    narrowing := [Diagnostic]{}
    span: Span{start: 12, end: 17}
    if !sema_expression_typed_literal_float_to_integer(Type.Int, Type.Float, span, narrowing) -> panic("Float typed body became Int")
    if narrowing.len() != 1 || narrowing[0].code != "E0112" || narrowing[0].span != (Val(span)) -> panic("typed body diagnostic lost its identity or span")
    if !narrowing[0].fix.contains("Int{{value}}") || !narrowing[0].fix.contains("Int{{math.round(value)}}") -> panic("typed body diagnostic lost its conversion repair")
    if sema_expression_typed_literal_float_to_integer(Type.Float, Type.Int, span, narrowing) -> panic("valid numeric widening was rejected")
    if sema_expression_typed_literal_float_to_integer(Type.Int, Type.Int, span, narrowing) -> panic("same-type body was rejected")
    print("E0112 typed scalar narrowing: passed")
}
