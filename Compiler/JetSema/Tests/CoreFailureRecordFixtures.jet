// The production constructor and field-access tables must agree. Assemble
// with the Foundation rung; UI source core_failure_record_literal_ok.jet
// exercises the full expression checker with these same compiler records.
fn core_failure_record_expect(owner: String, field: String) {
    fields :: core_record_literal_fields(owner) ?? panic("failure record is not constructable")
    if fields.len() != 1 -> panic("failure record has the wrong field count")
    if fields[0].name != field || fields[0].ty != Type.String -> panic("failure record literal has the wrong shape")
    actual :: core_record_field(owner, field) ?? panic("failure field cannot be read")
    if actual != fields[0].ty -> panic("failure literal and field access disagree")
}

fn run() {
    core_failure_record_expect("TextError", "message")
    core_failure_record_expect("RangeError", "reason")
    print("Core failure record literals: passed")
}
