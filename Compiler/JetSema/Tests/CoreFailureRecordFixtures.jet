// The production constructor and field-access tables must agree. The full
// fixture assembler uses the real parser, registration graph and checker with
// Core and user module origins; the user-module UI fixture must retain E0119.
use {
    jet_foundation.[
        Diagnostic, Span, SymbolKeys, Type, compiler_threads_single, core_record_field, core_record_literal_fields,
        core_record_literal_is_core_only, jet_target_machine_hosted, module_intern, module_table,
    ]
    jet_parser.[parse_generated_source]
    jet_driver.[jet_driver_canonical_effect_module]
    jet_sema.[
        SemaBuildFacts, SemaComptimeFunctionResult, SemaComptimeItemValue, SemaForeignProviderInput,
        SemaRegistrationForeignHandleFacts, SemaRegistrationHostHooks, SemaRegistrationImportEdge,
        SemaRegistrationModule, SemaRegistrationModuleInput, SemaRegistrationPackagePolicy, SemaSourceOrigin, SemaSourceSegment,
        sema_collect_comptime_declarations, sema_finalize_registration_graph, sema_registration_prepare_graph,
    ]
}

core_failure_record_expect: fn(owner: String, field: String) {
    fields: core_record_literal_fields(owner) ?? panic("failure record is not constructable")
    if !core_record_literal_is_core_only(owner) -> panic("failure record construction widened to user modules")
    if fields.len() != 1 -> panic("failure record has the wrong field count")
    if fields[0].name != field || fields[0].ty != Type.String -> panic("failure record literal has the wrong shape")
    actual: core_record_field(owner, field) ?? panic("failure field cannot be read")
    if actual != fields[0].ty -> panic("failure literal and field access disagree")
}

core_failure_record_diagnostics: fn(source: String, module_identity: String) -> [Diagnostic] {
    parsed := parse_generated_source(source.bytes())
    if parsed.diagnostics.len() != 0 -> panic("failure fixture did not parse: {source}")
    table := module_table()
    module_id: module_intern(table, module_identity)
    effects: jet_driver_canonical_effect_module("IO: struct {{\n    impl Effect {{}}\n}}\nPanic: struct {{\n    impl Effect {{}}\n}}\n", table) ?? panic("canonical effect source did not parse")
    effects_id: effects.module_identity
    package_identity: module_identity.split("/").to_list()[0]
    file: "{module_identity}/fixture.jet"
    facts: SemaBuildFacts{package_name: package_identity.copy(), package_version: "0.1.0", os: "linux", profile: "dev", stamp_git: None, stamp_dirty: false, stamp_toolchain: "fixture", stamp_at: ""}
    segment: SemaSourceSegment{generated: Span{start: 0, end: source.len()}, source_file: file.copy(), source_start: 0, line_starts: [Int]{0}, origin: SemaSourceOrigin.Snapshot}
    input: SemaRegistrationModuleInput{package_identity: package_identity.copy(), module_identity: module_id, module_name: "fixture", core_source_alias: "", module_path: "fixture.jet", source_file: file.copy(), source_segments: [SemaSourceSegment]{segment}, source_origin: SemaSourceOrigin.Snapshot, program: parsed.program.move(), foreign_handles: [SemaRegistrationForeignHandleFacts]{}, source: source.copy()}
    graph := sema_registration_prepare_graph([SemaRegistrationModuleInput]{input, effects}, [SemaRegistrationModule]{}, [SymbolKeys]{}, [SemaRegistrationImportEdge]{}, package_identity, module_id, effects_id, table, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), facts, false, compiler_threads_single()) ?? panic("registration failed {err}: {source}")
    hooks: Shared{SemaRegistrationHostHooks{numeric_unit_conversion_exact: None}}
    // Declaration checking loans the graph to its stage, which returns it.
    stage := sema_collect_comptime_declarations(graph, [SemaRegistrationPackagePolicy]{}, compiler_threads_single(), None) ?? panic("declaration checking failed {err}: {source}")
    declared := stage.graph.move()
    stage.graph = None
    registration := declared.move() ?? panic("the declaration pass lost its registration graph: {source}")
    checked := sema_finalize_registration_graph(registration, None, stage, [SemaComptimeItemValue]{}, [SemaComptimeFunctionResult]{}, hooks, compiler_threads_single(), None, None) ?? panic("finalization failed {err}: {source}")
    checked.diagnostics.move()
}

core_failure_record_check: fn(source: String, module_identity: String, expected_error: String) {
    found := false
    loop diagnostic in core_failure_record_diagnostics(source, module_identity) {
        if !diagnostic.code.starts_with("E") -> next
        if diagnostic.code != expected_error -> panic("unexpected failure literal diagnostic in {module_identity}: {diagnostic.code}: {diagnostic.what}: {source}")
        found = true
    }
    if found != (expected_error != "") -> panic("failure literal visibility did not match its module origin {module_identity} (expected `{expected_error}`): {source}")
}

#Test("core_failure_record_fixtures") {
    core_failure_record_expect("TextError", "message")
    core_failure_record_expect("RangeError", "reason")
    text_source: "failure: fn() -> TextError Never! {{ TextError{{message: \"invalid\"}} }}\nrun: fn() {{}}"
    range_source: "failure: fn() -> RangeError Never! {{ RangeError{{reason: \"out of range\"}} }}\nrun: fn() {{}}"
    core_failure_record_check(text_source, "<corelib>/fixture", "")
    core_failure_record_check(range_source, "<corelib>/fixture", "")
    core_failure_record_check(text_source, "user/fixture", "E0119")
    core_failure_record_check(range_source, "user/fixture", "E0119")
    io_source: "retain: fn(operation: &&IOOperation) -> IOOperation Never! {{ operation }}\nrun: fn() {{}}"
    core_failure_record_check(io_source, "<corelib>/fixture", "")
    core_failure_record_check(io_source, "user/fixture", "E0119")
    copy_source: "#Policy(copies: .Explicit)\ncontext: fn(operation: IOOperation) -> IOContext Never! {{ IOContext{{operation: operation.copy(), resource: None, os_code: None, cause: None}} }}\nretain: fn(operation: IOOperation) -> IOOperation Never! {{ operation.copy() }}\nrun: fn() {{}}"
    core_failure_record_check(copy_source, "<corelib>/fixture", "")
    display_source: "#Error AuthoredError: struct {{ reason: String }}\nimpl AuthoredError.Display {{ display: fn(self) -> String {{ self.reason.copy() }} }}\nrender: fn(error: AuthoredError) -> String {{ \"{{error}}\" }}\nrun: fn() {{}}"
    core_failure_record_check(display_source, "user/fixture", "")
    // A second `Display` impl repeats its method (E0105) and the impl (E0908).
    duplicate_display: "{display_source}\nimpl AuthoredError.Display {{ display: fn(self) -> String {{ \"duplicate\" }} }}"
    duplicate_codes := [String:Bool]{}
    loop diagnostic in core_failure_record_diagnostics(duplicate_display, "user/fixture") {
        if diagnostic.code.starts_with("E") -> duplicate_codes[diagnostic.code.copy()] = true
    }
    if duplicate_codes.len() != 2 || duplicate_codes.get("E0105") == None || duplicate_codes.get("E0908") == None -> panic("duplicate Display impl reported {duplicate_codes}, expected E0105 and E0908")
    writer_source: "jetc: module {{ Writer: struct {{ prefix: String }} }}\nprefix: fn(writer: jetc.Writer) -> String {{ writer.prefix.copy() }}\nrun: fn() {{}}"
    core_failure_record_check(writer_source, "user/fixture", "")
    optional_dispatch: "#Error Fault: enum {{ Bad }}\nread: fn() -> Int? Fault! {{ None }}\nproject: fn() -> Int? Fault! {{\n value: if read() == {{\n .Val(value) -> Val(value)\n .None -> None\n .Err(error) -> {{ return Err(error) }}\n }}\n value\n}}\nrun: fn() {{}}"
    core_failure_record_check(optional_dispatch, "user/fixture", "")
    print("Core failure record literals: passed")
}

// Core reads only the target's facts. A fact of one program (its package,
// profile, stamp or settings) is refused in Core and read in a user module.
core_target_fact_codes: fn(source: String, module_identity: String) -> [String] {
    codes := [String]{}
    loop diagnostic in core_failure_record_diagnostics(source, module_identity) {
        if diagnostic.code.starts_with("E") -> codes.push(diagnostic.code.copy())
    }
    codes
}

#Test("core_reads_only_target_facts") {
    target_source: "os: fn() -> String {{ #build.target.os }}\nrun: fn() {{}}"
    if core_target_fact_codes(target_source, "<corelib>/fixture").len() != 0 -> panic("Core refused a target fact read")
    program_sources: [String]{
        "name: fn() -> String {{ #package.name }}\nrun: fn() {{}}",
        "profile: fn() -> String {{ #build.profile }}\nrun: fn() {{}}",
        "dirty: fn() -> Bool {{ #build.stamp.dirty }}\nrun: fn() {{}}",
    }
    loop source in program_sources {
        core_codes: core_target_fact_codes(source, "<corelib>/fixture")
        if core_codes.len() != 1 || core_codes[0] != "E0302" -> panic("Core read a program fact ({core_codes}): {source}")
        user_codes: core_target_fact_codes(source, "user/fixture")
        if user_codes.len() != 0 -> panic("a user module could not read a program fact ({user_codes}): {source}")
    }
    print("Core target fact reads: passed")
}
