// The production constructor and field-access tables must agree. The full
// fixture assembler uses the real parser/checker with Core and user module
// origins; the user-module UI fixture must retain E0119.
fn core_failure_record_expect(owner: String, field: String) {
    fields :: core_record_literal_fields(owner) ?? panic("failure record is not constructable")
    if !core_record_literal_is_core_only(owner) -> panic("failure record construction widened to user modules")
    if fields.len() != 1 -> panic("failure record has the wrong field count")
    if fields[0].name != field || fields[0].ty != Type.String -> panic("failure record literal has the wrong shape")
    actual :: core_record_field(owner, field) ?? panic("failure field cannot be read")
    if actual != fields[0].ty -> panic("failure literal and field access disagree")
}

fn core_failure_record_check(source: String, module_identity: String, expected_error: String) {
    parsed :: parse_generated_source(source.bytes())
    if parsed.diagnostics.len() != 0 -> panic("failure fixture did not parse")
    result :: check_program(parsed.program, module_identity, "{module_identity}/fixture.jet", [SemaSourceSegment]{})
    found := false
    loop diagnostic in result.diagnostics {
        if !diagnostic.code.starts_with("E") -> next
        if diagnostic.code != expected_error -> panic("unexpected failure literal diagnostic: {diagnostic.code}: {diagnostic.what}")
        found = true
    }
    if found != (expected_error != "") -> panic("failure literal visibility did not match its module origin")
}

fn run() {
    core_failure_record_expect("TextError", "message")
    core_failure_record_expect("RangeError", "reason")
    text_source :: "fn failure() -> TextError Never! {{ TextError{{message: \"invalid\"}} }}\nfn run() {{}}"
    range_source :: "fn failure() -> RangeError Never! {{ RangeError{{reason: \"out of range\"}} }}\nfn run() {{}}"
    core_failure_record_check(text_source, "<corelib>/fixture", "")
    core_failure_record_check(range_source, "<corelib>/fixture", "")
    core_failure_record_check(text_source, "user/fixture", "E0119")
    core_failure_record_check(range_source, "user/fixture", "E0119")
    io_source :: "fn retain(operation: IOOperation) -> IOOperation Never! {{ operation }}\nfn run() {{}}"
    core_failure_record_check(io_source, "<corelib>/fixture", "")
    core_failure_record_check(io_source, "user/fixture", "E0119")
    copy_source :: "#Policy(copies: .Explicit)\nfn context(operation: IOOperation) -> IOContext Never! {{ IOContext{{operation: operation.copy(), resource: None, os_code: None, cause: None}} }}\nfn retain(operation: IOOperation) -> IOOperation Never! {{ operation.copy() }}\nfn run() {{}}"
    core_failure_record_check(copy_source, "<corelib>/fixture", "")
    display_source :: "#Error struct AuthoredError {{ reason: String }}\nimpl AuthoredError.Display {{ fn display(self) -> String {{ self.reason.copy() }} }}\nfn render(error: AuthoredError) -> String {{ \"{{error}}\" }}\nfn run() {{}}"
    core_failure_record_check(display_source, "user/fixture", "")
    duplicate_display :: "{display_source}\nimpl AuthoredError.Display {{ fn display(self) -> String {{ \"duplicate\" }} }}"
    core_failure_record_check(duplicate_display, "user/fixture", "E0908")
    writer_source :: "module jetc {{ struct Writer {{ prefix: String }} }}\nfn prefix(writer: jetc.Writer) -> String {{ writer.prefix.copy() }}\nfn run() {{}}"
    core_failure_record_check(writer_source, "user/fixture", "")
    optional_dispatch :: "#Error enum Fault {{ Bad }}\nfn read() -> Int? Fault! {{ None }}\nfn project() -> Int? Fault! {{\n value :: if read() == {{\n .Val(value) -> Val(value)\n .None -> None\n .Err(error) -> {{ return Err(error) }}\n }}\n value\n}}\nfn run() {{}}"
    core_failure_record_check(optional_dispatch, "user/fixture", "")
    print("Core failure record literals: passed")
}
