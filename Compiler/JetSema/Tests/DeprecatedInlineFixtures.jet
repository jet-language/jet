// Production parser + registration graph + checker coverage for
// `#Deprecated(inline: true)`: a call's L2001 carries the edit that puts the
// function's body in place of the call, each argument where its parameter is
// read, or no edit and a Fix that says to edit it by hand when the body
// would change what the call does.
use {
    jet_parser.[parse_source]
    jet_sema.[
        SemaBuildFacts,
        SemaComptimeFunctionResult,
        SemaComptimeItemValue,
        SemaForeignProviderInput,
        SemaRegistrationForeignHandleFacts,
        SemaRegistrationHostHooks,
        SemaRegistrationImportEdge,
        SemaRegistrationModuleInput,
        SemaRegistrationPackagePolicy,
        SemaSourceOrigin,
        SemaSourceSegment,
        sema_collect_comptime_declarations,
        sema_finalize_registration_graph,
        sema_registration_prepare_graph,
    ]
    jet_driver.[jet_driver_canonical_effect_module]
    jet_foundation.[DIAGNOSTIC_ERROR, Span, compiler_threads_single, effect_vocabulary_module, jet_target_machine_hosted, module_intern, module_table]
}

// Each L2001 the checked `source` reports, as the source its edit gives, or
// `by hand: <fix>` when it has no edit. None, with the failure recorded,
// when the source doesn't check.
deprecated_inline_results: fn(failures: &[String], source: String) -> [String]? {
    raw: source.bytes()
    parsed := parse_source(raw)
    if parsed.diagnostics.len() != 0 {
        failures.push("parse failed: {source}")
        return None
    }
    table := module_table()
    main_id: module_intern(table, "deprecated-inline::main")
    effects: jet_driver_canonical_effect_module(effect_vocabulary_module("IO: struct {{\n    impl Effect {{}}\n}}\nPanic: struct {{\n    impl Effect {{}}\n}}\n"), table) ?? {
        failures.push("canonical effect module declares no effects")
        return None
    }
    effects_id: effects.module_identity
    facts: SemaBuildFacts{package_name: "deprecated-inline", package_version: "0.1.0", os: "linux", profile: "dev", stamp_git: None, stamp_dirty: false, stamp_toolchain: "fixture", stamp_at: ""}
    segment: SemaSourceSegment{generated: Span{start: 0, end: raw.len()}, source_file: "main.jet", source_start: 0, line_starts: [Int]{0}, origin: SemaSourceOrigin.Snapshot}
    input: SemaRegistrationModuleInput{package_identity: "deprecated-inline", module_identity: main_id, module_name: "main", core_source_alias: "", module_path: "main.jet", source_file: "main.jet", source_segments: [SemaSourceSegment]{segment}, source_origin: SemaSourceOrigin.Snapshot, program: parsed.program.move(), foreign_handles: [SemaRegistrationForeignHandleFacts]{}, source: "{source}"}
    graph := sema_registration_prepare_graph([SemaRegistrationModuleInput]{input, effects}, [SemaRegistrationImportEdge]{}, "deprecated-inline", main_id, effects_id, table, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), facts, false, compiler_threads_single()) ?? {
        failures.push("registration failed {err}: {source}")
        return None
    }
    hooks: Shared{SemaRegistrationHostHooks{numeric_unit_conversion_exact: None}}
    stage := sema_collect_comptime_declarations(graph, [SemaRegistrationPackagePolicy]{}, compiler_threads_single(), None) ?? {
        failures.push("declaration checking failed {err}: {source}")
        return None
    }
    declared := stage.graph.move()
    stage.graph = None
    registration := declared.move() ?? {
        failures.push("the declaration pass lost its registration graph: {source}")
        return None
    }
    checked := sema_finalize_registration_graph(registration, None, stage, [SemaComptimeItemValue]{}, [SemaComptimeFunctionResult]{}, hooks, compiler_threads_single(), None) ?? {
        failures.push("finalization failed {err}: {source}")
        return None
    }
    results := [String]{}
    loop diagnostic in checked.diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR {
            failures.push("unexpected {diagnostic.code}: {diagnostic.what} in {source}")
            next
        }
        if diagnostic.code != "L2001" -> next
        if {
            diagnostic.edit == .Val(edit) -> {
                before: String.from_bytes(raw[0..<edit.span.start]) ?? ""
                after: String.from_bytes(raw[edit.span.end..<raw.len()]) ?? ""
                results.push("{before}{edit.new_text}{after}")
            }
            else -> results.push("by hand: {diagnostic.fix}")
        }
    }
    Val(results)
}

// `call` is the body of `run`, after DEPRECATED_INLINE_LIBRARY; it reports
// one L2001, whose edit leaves `run`'s body `wanted`, or, when `wanted` is
// "", which has no edit.
deprecated_inline_expect: fn(failures: &[String], call: String, wanted: String) {
    results: deprecated_inline_results(failures, "{DEPRECATED_INLINE_LIBRARY}run: fn() -> Int {{\n    {call}\n}}\n") ?? return
    if results.len() != 1 {
        failures.push("`{call}` reports {results.len()} deprecations: [{results.join("; ")}]")
        return
    }
    if wanted == "" {
        if !results[0].starts_with("by hand: ") || !results[0].contains("can't change what the call does") {
            failures.push("`{call}` should be edited by hand, but gives: {results[0]}")
        }
        return
    }
    expected: "{DEPRECATED_INLINE_LIBRARY}run: fn() -> Int {{\n    {wanted}\n}}\n"
    if results[0] != expected -> failures.push("`{call}` gives:\n{results[0]}\nwanted:\n{expected}")
}

DEPRECATED_INLINE_LIBRARY: "scaled: fn(n: Int, by: Int) -> Int {{\n    n * by\n}}\n\n#Deprecated(since: \"1.2\", use: \"scaled\", inline: true)\ndouble: fn(n: Int) -> Int {{\n    scaled(n, 2)\n}}\n\n#Deprecated(since: \"1.2\", use: \"scaled\", inline: true)\ntwice: fn(n: Int) -> Int {{\n    n + n\n}}\n\n#Deprecated(since: \"1.2\", use: \"scaled\", inline: true)\nafter: fn(n: Int) -> Int {{\n    scaled(2, 3) + n\n}}\n\n#Deprecated(since: \"1.2\", use: \"scaled\", inline: true)\nless: fn(n: Int) -> Int {{\n    n - 1\n}}\n\n#Deprecated(since: \"1.2\", use: \"scaled\", inline: true)\nswapped: fn(n: Int, by: Int) -> Int {{\n    scaled(by, n)\n}}\n\n"

#Test("deprecated_inline_fixtures") {
    failures := [String]{}
    // A name or literal argument goes in place of every read.
    deprecated_inline_expect(failures, "double(4)", "scaled(4, 2)")
    deprecated_inline_expect(failures, "twice(4)", "(4 + 4)")
    // Any other argument is read once, before the body runs anything else.
    deprecated_inline_expect(failures, "double(scaled(1, 3))", "scaled(scaled(1, 3), 2)")
    // An argument that isn't one term keeps its parentheses as an operand.
    deprecated_inline_expect(failures, "less(1 + 3)", "((1 + 3) - 1)")
    deprecated_inline_expect(failures, "swapped(3, 4)", "scaled(4, 3)")
    // Arguments the body would run in another order: by hand.
    deprecated_inline_expect(failures, "swapped(scaled(1, 3), scaled(2, 2))", "")
    // Read twice, or after the body has called something: by hand.
    deprecated_inline_expect(failures, "twice(scaled(1, 3))", "")
    deprecated_inline_expect(failures, "after(scaled(1, 3))", "")
    // A local at the call takes a name the body reads: by hand.
    shadowed: deprecated_inline_results(failures, "{DEPRECATED_INLINE_LIBRARY}run: fn() -> Int {{\n    scaled := 3\n    double(scaled)\n}}\n") ?? [String]{}
    if shadowed.len() != 1 || !shadowed[0].starts_with("by hand: ") {
        failures.push("a local named like the body's callee should leave the call to edit by hand: [{shadowed.join("; ")}]")
    }
    if failures.len() > 0 {
        panic("DeprecatedInlineFixtures collected {failures.len()} failures:\n{failures.join("\n")}")
    }
}
