// Assemble with production Bootstrap sources, replacing the CLI entry.
// The fixtures exercise the Jet checker; no reference front end supplies facts.
use {
    jet_driver.[JetDriverCompileMode, jet_driver_present_diagnostics]
    jet_cli.[jet_cli_compile_file]
    jet_foundation.[DIAGNOSTIC_ERROR]
}

variadic_fixture_reject: fn(file: String, code: String) {
    checked: jet_cli_compile_file(file, false, None, JetDriverCompileMode.Program)
    if checked == {
        .Refused(refusal) -> {
            if !refusal.stderr.contains(code) -> panic("{file}: refusal lost {code}")
            return
        }
        .Compiled(result, snapshot) -> {
            if result.internal_problem != None -> panic("{file}: internal compiler failure")
            loop diagnostic in jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files) {
                if diagnostic.severity == DIAGNOSTIC_ERROR && diagnostic.code == code -> return
            }
            panic("{file}: expected checked refusal {code}")
        }
    }
}

variadic_fixture_accept: fn(file: String) {
    checked: jet_cli_compile_file(file, false, None, JetDriverCompileMode.Program)
    if checked == {
        .Refused(refusal) -> panic("{file}: {refusal.stderr}")
        .Compiled(result, snapshot) -> {
            if result.internal_problem != None -> panic("{file}: internal compiler failure")
            loop diagnostic in jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files) {
                if diagnostic.severity == DIAGNOSTIC_ERROR -> panic("{file}: unexpected {diagnostic.code}")
            }
        }
    }
}

#Test("variadic_fixtures") {
    fixture_root: "Compiler/JetSema/Tests/fixtures"
    variadic_fixture_reject("{fixture_root}/VariadicSpreadNonTail.fixture/VariadicSpreadNonTail.jet", "E1312")
    variadic_fixture_reject("{fixture_root}/VariadicMoveBorrowed.fixture/VariadicMoveBorrowed.jet", "E0201")
    variadic_fixture_reject("{fixture_root}/VariadicNonCloneSpread.fixture/VariadicNonCloneSpread.jet", "E0211")
    variadic_fixture_reject("{fixture_root}/VariadicSpreadElementMismatch.fixture/VariadicSpreadElementMismatch.jet", "E0112")
    variadic_fixture_accept("Examples/Basics/Functions/VariadicsSpread.jet")
    stems: [String]{"VariadicsOwnedLists", "VariadicsBorrowedLists", "VariadicsMixedLists", "VariadicsEvalOrder", "VariadicsCoercions"}
    loop stem in stems -> variadic_fixture_accept("tests/run/ControlAndData/{stem}.jet")
    variadic_fixture_accept("{fixture_root}/VariadicSlotCoercions.fixture/VariadicSlotCoercions.jet")
    variadic_fixture_accept("{fixture_root}/VariadicTimeReordered.fixture/VariadicTimeReordered.jet")
    print("checked variadic calls and refusals: passed")
}
