// A type's inferred effect row through the production parser, registration
// graph and checker: one fixture pins each source (a method's solved row, a
// function-typed field's row, a field's type, a trait's implementations) and
// the fixed point over a recursive and a mutually recursive type.
use {
    jet_sema.[
        SemaBuildFacts, SemaComptimeFunctionResult, SemaComptimeItemValue, SemaEffectTypeRow,
        SemaForeignProviderInput, SemaRegistrationForeignHandleFacts, SemaRegistrationGraph,
        SemaRegistrationHostHooks, SemaRegistrationImportEdge, SemaRegistrationModule, SemaRegistrationModuleInput,
        SemaRegistrationPackagePolicy, SemaSourceOrigin, SemaSourceSegment,
        sema_collect_comptime_declarations, sema_effect_graph_type_rows, sema_finalize_registration_graph,
        sema_has_error_since, sema_registration_prepare_graph, sema_type_graph_trait_symbol,
    ]
    jet_parser.[parse_source]
    jet_driver.[jet_driver_canonical_effect_module]
    jet_foundation.[Span, compiler_threads_single, jet_target_machine_hosted]
}

TYPE_ROW_EFFECTS: "IO: struct {{\n    impl Effect {{}}\n}}\nNet: struct {{\n    impl Effect {{}}\n}}\nEnv: struct {{\n    impl Effect {{}}\n}}\n"

TYPE_ROW_SOURCE: "Logger: struct {{\n    prefix: String\n\n    say: fn(self, text: String) {{ print(\"{{self.prefix}}{{text}}\") }}\n}}\n\nFetcher: struct {{\n    get: fn(String) -[Net]> String\n}}\n\nService: struct {{\n    log: Logger\n    fetch: Fetcher\n}}\n\nTree: struct {{\n    children: [Tree]\n    hook: fn() -[Env]> Int\n}}\n\nForest: struct {{\n    trees: [Tree]\n}}\n\nPing: struct {{\n    pongs: [Pong]\n\n    ping: fn(self) {{ print(\"ping\") }}\n}}\n\nPong: struct {{\n    pings: [Ping]\n    send: fn() -[Net]> Int\n}}\n\nShape: trait {{\n    draw: fn(self)\n}}\n\nSquare: struct {{\n    side: Int\n}}\n\nimpl Square.Shape {{\n    draw: fn(self) {{ print(\"square {{self.side}}\") }}\n}}\n\nCanvas: struct {{\n    shapes: [Shape]\n}}\n\nrun: fn() {{\n    Logger{{prefix: \"> \"}}.say(\"hi\")\n}}\n"

TYPE_ROW_MODULE: "type-rows::main"

effect_type_row_graph: fn(failures: &[String]) -> SemaRegistrationGraph? {
    parsed := parse_source(TYPE_ROW_SOURCE.bytes())
    if sema_has_error_since(parsed.diagnostics, 0) {
        failures.push("source parsing failed: {parsed.diagnostics:Debug}")
        return None
    }
    canonical: jet_driver_canonical_effect_module(TYPE_ROW_EFFECTS) ?? {
        failures.push("canonical effect declaration failed parsing")
        return None
    }
    facts: SemaBuildFacts{package_name: "type-rows", package_version: "0.1.0", os: "linux", profile: "dev", stamp_git: None, stamp_dirty: false, stamp_toolchain: "fixture", stamp_at: ""}
    segment: SemaSourceSegment{generated: Span{start: 0, end: TYPE_ROW_SOURCE.len()}, source_file: "main.jet", source_start: 0, line_starts: [Int]{0}, origin: SemaSourceOrigin.Snapshot}
    input: SemaRegistrationModuleInput{package_identity: "type-rows", module_identity: TYPE_ROW_MODULE, module_name: "main", core_source_alias: "", module_path: "main.jet", source_file: "main.jet", source_segments: [SemaSourceSegment]{segment}, source_origin: SemaSourceOrigin.Snapshot, program: parsed.program, foreign_handles: [SemaRegistrationForeignHandleFacts]{}, source: TYPE_ROW_SOURCE}
    graph: sema_registration_prepare_graph([SemaRegistrationModuleInput]{input, canonical}, [SemaRegistrationModule]{}, [SemaRegistrationImportEdge]{}, "type-rows", TYPE_ROW_MODULE, canonical.module_identity, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), facts, false, compiler_threads_single()) ?? {
        failures.push("registration failed: {err:Debug}")
        return None
    }
    if !graph.complete || graph.internal_problem != None {
        failures.push("registration failed: {graph.diagnostics:Debug}")
        return None
    }
    Val(graph)
}

// The row of the struct, enum or trait `name` the fixture declares.
effect_type_row_find: fn(graph: SemaRegistrationGraph, rows: [SemaEffectTypeRow], name: String) -> SemaEffectTypeRow? {
    key := ""
    loop nominal in graph.modules[0].nominals {
        if nominal.symbol.name == name -> key = nominal.symbol.id.key.copy()
    }
    if key == "" {
        symbol: sema_type_graph_trait_symbol(graph, TYPE_ROW_MODULE, name) ?? return None
        key = symbol.id.key.copy()
    }
    loop row in rows {
        if row.key == key -> return Val(row.copy())
    }
    None
}

// `name`'s row holds `effect_name`, first brought in by a source of `kind`
// labeled `label`; with `kind` "" the row must not hold `effect_name`.
effect_type_row_expect: fn(graph: SemaRegistrationGraph, rows: [SemaEffectTypeRow], name: String, effect_name: String, kind: String, label: String, failures: &[String]) {
    row: effect_type_row_find(graph, rows, name) ?? {
        failures.push("{name}: no inferred row")
        return
    }
    reach := Int?{None}
    loop found in row.reaches {
        if found.name == effect_name -> reach = Val(found.source)
    }
    if kind == "" {
        if reach != None -> failures.push("{name}: row {row.effects:Debug} holds {effect_name}")
        return
    }
    position: reach ?? {
        failures.push("{name}: row {row.effects:Debug} lacks {effect_name}")
        return
    }
    source: row.sources[position]
    if source.kind != kind || source.label != label -> failures.push("{name}: {effect_name} comes from {source.kind} `{source.label}`, expected {kind} `{label}`")
}

effect_type_row_run: fn() {
    failures := [String]{}
    graph := effect_type_row_graph(failures) ?? panic("EffectTypeRowFixtures collected {failures.len()} failures:\n{failures.join("\n")}")
    hooks: Shared{SemaRegistrationHostHooks{numeric_unit_conversion_exact: None}}
    stage := sema_collect_comptime_declarations(graph, [SemaRegistrationPackagePolicy]{}, compiler_threads_single(), None)
    declared := stage.graph.move()
    stage.graph = None
    graph = declared.move() ?? panic("EffectTypeRowFixtures: the declaration pass lost its registration graph")
    checked := sema_finalize_registration_graph(graph.copy(), None, stage, [SemaComptimeItemValue]{}, [SemaComptimeFunctionResult]{}, hooks, compiler_threads_single(), None, None)
    if !checked.complete -> panic("EffectTypeRowFixtures: the body and effect check failed {checked.diagnostics:Debug}")
    rows: sema_effect_graph_type_rows(graph, checked.modules)
    // A method's solved row.
    effect_type_row_expect(graph, rows, "Logger", "IO", "method", "say", failures)
    effect_type_row_expect(graph, rows, "Logger", "Net", "", "", failures)
    // A function-typed field's row.
    effect_type_row_expect(graph, rows, "Fetcher", "Net", "field", "get", failures)
    effect_type_row_expect(graph, rows, "Fetcher", "IO", "", "", failures)
    // Field types.
    effect_type_row_expect(graph, rows, "Service", "IO", "field type", "log", failures)
    effect_type_row_expect(graph, rows, "Service", "Net", "field type", "fetch", failures)
    // A recursive type, and a type that holds it through a list.
    effect_type_row_expect(graph, rows, "Tree", "Env", "field", "hook", failures)
    effect_type_row_expect(graph, rows, "Forest", "Env", "field type", "trees", failures)
    // A cycle settles on the union of both types' own effects.
    effect_type_row_expect(graph, rows, "Ping", "IO", "method", "ping", failures)
    effect_type_row_expect(graph, rows, "Ping", "Net", "field type", "pongs", failures)
    effect_type_row_expect(graph, rows, "Pong", "Net", "field", "send", failures)
    effect_type_row_expect(graph, rows, "Pong", "IO", "field type", "pings", failures)
    // A trait's implementations, and a type that holds trait values.
    effect_type_row_expect(graph, rows, "Square", "IO", "method", "draw", failures)
    effect_type_row_expect(graph, rows, "Shape", "IO", "impl", "Square", failures)
    effect_type_row_expect(graph, rows, "Canvas", "IO", "field type", "shapes", failures)
    effect_type_row_expect(graph, rows, "Canvas", "Env", "", "", failures)
    if failures.len() > 0 -> panic("EffectTypeRowFixtures collected {failures.len()} failures:\n{failures.join("\n")}")
}

#Test("effect_type_row_fixtures") {
    effect_type_row_run() ?? panic("EffectTypeRowFixtures: {err:Debug}")
}
