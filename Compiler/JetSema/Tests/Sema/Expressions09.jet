use jet_foundation.[Span]
use jet_sema.[ViewAccess, ViewFact, ViewKind, ViewOwnerId, ViewOwnerOrigin, ViewPlace, ViewProjection, ViewStore, current_view_fact, current_view_fact_for_binding, push_view_fact]
use jet_sema.Ownership.Checks.[invalidate_view_owner]

// Rust: crates/jet-sema/src/Sema/mod.rs:1648
fn fact(owner_span: USize, scope_len: USize, kind: ViewKind) -> ViewFact {
    ViewFact{seq: 0, binding_span: Span.new(owner_span + 10, owner_span + 11), output_path: [String]{}, place: ViewPlace{owner: ViewOwnerId{name: "owner", def_span: Span.new(owner_span, owner_span + 1), origin: .Local}, projections: [ViewProjection]{}}, kind: kind, access: .Read, scope_len: scope_len, invalidated: None}
}

// Rust: crates/jet-sema/src/Sema/mod.rs:1669
#Test("nested_shadow_reveals_outer_fact_after_scope_exit") {
    graph := ViewStore.new()
    push_view_fact(&graph, "window", fact(1, 1, .List))
    push_view_fact(&graph, "window", fact(2, 2, .String))
    assert(current_view_fact(&graph, "window").map(f -> f.kind) == Val(ViewKind.String))
    &graph.leave_depth(2)
    assert(current_view_fact(&graph, "window").map(f -> f.kind) == Val(ViewKind.List))
}

// Rust: crates/jet-sema/src/Sema/mod.rs:1685
#Test("non_view_binding_identity_hides_stale_same_spelling_fact") {
    graph := ViewStore.new()
    push_view_fact(&graph, "window", fact(1, 1, .List))
    assert(current_view_fact_for_binding(&graph, "window", Span.new(99, 100)) == None)
}

// Rust: crates/jet-sema/src/Sema/mod.rs:1692
#Test("stable_owner_identity_distinguishes_same_spelling") {
    a :: fact(1, 1, .Buffer).place
    b :: fact(2, 1, .Matrix).place
    assert(!a.overlaps(&b))
}

// Rust: crates/jet-sema/src/Sema/mod.rs:1699
#Test("invalidation_uses_owner_identity_not_spelling") {
    graph := ViewStore.new()
    outer :: fact(1, 1, .Arena)
    inner :: fact(2, 2, .Arena)
    inner_owner :: inner.place.owner.clone()
    push_view_fact(&graph, "outer", ^outer)
    push_view_fact(&graph, "inner", ^inner)
    invalidate_view_owner(&graph, &inner_owner, "reset", Span.new(40, 41))
    assert((current_view_fact(&graph, "outer") ?? panic("outer fact missing")).invalidated == None)
    assert((current_view_fact(&graph, "inner") ?? panic("inner fact missing")).invalidated != None)
}

// Rust: crates/jet-sema/src/Sema/mod.rs:1725
#Test("different_fields_do_not_alias") {
    a := fact(1, 1, .List).place
    b := a.clone()
    &a.projections.push(.Field("left"))
    &b.projections.push(.Field("right"))
    assert(!a.overlaps(&b))
}

// Rust: crates/jet-sema/src/Sema/mod.rs:1736
#Test("dynamic_indexes_are_conservatively_overlapping") {
    a := fact(1, 1, .List).place
    b := a.clone()
    &a.projections.push(.Index(None, Span.new(20, 21)))
    &b.projections.push(.Index(None, Span.new(30, 31)))
    assert(a.overlaps(&b))
}

// Rust: crates/jet-sema/src/Sema/mod.rs:1751
#Test("distinct_constant_indexes_are_disjoint") {
    a := fact(1, 1, .List).place
    b := a.clone()
    &a.projections.push(.Index(Val(0), Span.new(20, 21)))
    &b.projections.push(.Index(Val(1), Span.new(30, 31)))
    assert(!a.overlaps(&b))
}

// Rust: crates/jet-sema/src/Sema/mod.rs:1766
#Test("constant_index_outside_range_is_disjoint") {
    index := fact(1, 1, .List).place
    range := index.clone()
    &index.projections.push(.Index(Val(0), Span.new(20, 21)))
    &range.projections.push(.Range(Val(1), Val(3), Span.new(30, 34)))
    assert(!index.overlaps(&range))
}

// Rust: crates/jet-sema/src/Sema/mod.rs:1782
#Test("separated_constant_ranges_are_disjoint") {
    a := fact(1, 1, .List).place
    b := a.clone()
    &a.projections.push(.Range(Val(0), Val(1), Span.new(20, 24)))
    &b.projections.push(.Range(Val(2), Val(3), Span.new(30, 34)))
    assert(!a.overlaps(&b))
}
