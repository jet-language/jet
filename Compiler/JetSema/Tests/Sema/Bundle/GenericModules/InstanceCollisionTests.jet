use jet_foundation.[ProgramBundle, DevtoolsRegistry, CFfi, NameLedger, ModuleInstanceIdentity, Span, Item]
use jet_foundation.SHA256
use jet_syntax.[RuntimeLayer, OSTarget, PAYLOAD_FILE, UNIFIED_LOCK_FILE]
use jet_sema.[package_identity, definition_full_key, ModuleInstanceKey, register_instance_fingerprint, module_type_name]
use jet_lexer.lex
use jet_parser.parse
use jet_foundation.CanonicalAST
use std.[fs, env, process, time, panic] // GATE #4494: native filesystem, clock, process id and panic capture.

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/InstanceCollisionTests.rs:4
fn identity_bundle(project_root: OSPath) -> ProgramBundle {
    ProgramBundle{
        entry: 0, project_root: project_root, modules: [],
        devtools_registry: DevtoolsRegistry.default(), parse_teaching: [],
        used_core: Set.new<String>(), ffi_callback_fns: Set.new<String>(),
        cffi: CFfi.default(), comptime_inputs: [], name_ledger: NameLedger.default(),
        layer_ceiling: None, inferred_layer: RuntimeLayer.Core,
        web_partitions: [:], web_partition_enforced: false, web_partition_report: None,
        dep_roots: [:], package_guarantees: Default.default(), program_allocator: Default.default(),
        active_os: OSTarget.host(), build_facts: Default.default(), edition: "2027",
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/InstanceCollisionTests.rs:31
#Test("package_identity_uses_canonical_source_not_credentials_paths_or_formatting") {
    nonce :: time.SystemTime.now().duration_since(time.UNIX_EPOCH).as_nanos()
    base :: env.temp_dir().join("jet_package_identity_{nonce}")
    project_a :: base.join("checkout-a/project")
    project_b :: base.join("checkout-b/project")
    dep_a :: base.join("private-a/dependency")
    dep_b :: base.join("private-b/dependency")
    loop path in [project_a, project_b, dep_a, dep_b] -> fs.create_dir_all(path)
    fs.create_dir_all(project_a.join(".jet"))
    fs.create_dir_all(project_b.join(".jet"))
    fs.write(dep_a.join(PAYLOAD_FILE), "payload: {{ name: \"demo\", version: \"1.2.3\" }}")
    fs.write(dep_b.join(PAYLOAD_FILE), "payload: {{\n  version: \"1.2.3\",\n  name: \"demo\"\n}}\n")
    fs.write(project_a.join(UNIFIED_LOCK_FILE), "version=1\n[[package]]\nname=\"demo\"\nversion=\"1.2.3\"\nsource={{ git=\"https://alice:secret@example.com/acme/demo.git?token=one\", rev=\"main\" }}\nlocked={{ rev=\"abc\", tree-hash=\"tree\", last-modified=1 }}\n")
    fs.write(project_b.join(UNIFIED_LOCK_FILE), "version = 1\n\n[[package]]\nsource = {{ git = \"https://bob:other@example.com/acme/demo.git#credential\", rev = \"main\" }}\nname = \"demo\"\nlocked = {{ tree-hash = \"tree\", rev = \"abc\", last-modified = 99 }}\nversion = \"1.2.3\"\n")
    a :: package_identity(identity_bundle(~project_a), dep_a, Val("demo"))
    b :: package_identity(identity_bundle(~project_b), dep_b, Val("demo"))
    assert(a == b, "formatting, credentials, timestamps, and host paths are non-semantic")
    fs.write(project_b.join(UNIFIED_LOCK_FILE), "version=1\n[[package]]\nname=\"demo\"\nversion=\"1.2.3\"\nsource={{ git=\"https://example.com/acme/demo.git\", rev=\"main\" }}\nlocked={{ rev=\"different\", tree-hash=\"tree\" }}\n")
    changed :: package_identity(identity_bundle(project_b), dep_b, Val("demo"))
    assert(a != changed, "locked git revision is semantic package source identity")
    _ :: fs.remove_dir_all(base) catch _ {}
}

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/InstanceCollisionTests.rs:74
#Test("same_template_path_in_different_packages_has_distinct_definition_identity") {
    root :: env.temp_dir().join("jet_package_nominal_{process.id()}")
    first :: root.join("first")
    second :: root.join("second")
    fs.create_dir_all(first)
    fs.create_dir_all(second)
    fs.write(first.join(PAYLOAD_FILE), "payload: {{ name: \"first\", version: \"1.0.0\" }}")
    fs.write(second.join(PAYLOAD_FILE), "payload: {{ name: \"second\", version: \"1.0.0\" }}")
    bundle :: identity_bundle(~root)
    a :: definition_full_key(package_identity(bundle, first, Val("first")), "src/template.jet", "", "Boxed")
    b :: definition_full_key(package_identity(bundle, second, Val("second")), "src/template.jet", "", "Boxed")
    assert(a != b)
    assert(!String.from_utf8_lossy(a).contains(root.to_string_lossy()))
    _ :: fs.remove_dir_all(root) catch _ {}
}

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/InstanceCollisionTests.rs:109
#Test("path_lock_content_changes_definition_and_instance_identity_but_host_path_does_not") {
    root :: env.temp_dir().join("jet_path_lock_identity_{process.id()}")
    project :: root.join("project")
    dependency :: root.join("dependency")
    fs.create_dir_all(project.join(".jet"))
    fs.create_dir_all(dependency)
    fs.write(dependency.join(PAYLOAD_FILE), "payload: {{ name: \"dep\", version: \"1.2.3\" }}")
    lock :: (path: String, content: String) -> "version=1\n[[package]]\nname=\"dep\"\nversion=\"1.2.3\"\nsource={{path=\"{path}\"}}\ncontent-hash=\"{content}\"\n"
    bundle :: identity_bundle(~project)
    fs.write(project.join(UNIFIED_LOCK_FILE), lock("/host/a/dep", "tree-a"))
    package_a :: package_identity(bundle, dependency, Val("dep"))
    fs.write(project.join(UNIFIED_LOCK_FILE), lock("/host/b/dep", "tree-a"))
    assert(package_a == package_identity(bundle, dependency, Val("dep")))
    fs.write(project.join(UNIFIED_LOCK_FILE), lock("/host/b/dep", "tree-b"))
    package_b :: package_identity(bundle, dependency, Val("dep"))
    definition_a :: definition_full_key(package_a, "template.jet", "", "Boxed")
    definition_b :: definition_full_key(package_b, "template.jet", "", "Boxed")
    assert(SHA256.sha256_hex(definition_a) != SHA256.sha256_hex(definition_b))
    instance :: (definition_full_key: [U8]) -> ModuleInstanceKey{definition_full_key: definition_full_key, parameters: [1], args: [[2]]}
    assert(SHA256.sha256_hex(instance(definition_a).bytes()) != SHA256.sha256_hex(instance(definition_b).bytes()))
    _ :: fs.remove_dir_all(root) catch _ {}
}

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/InstanceCollisionTests.rs:167
#Test("different_full_keys_with_same_digest_fail_closed_before_codegen") {
    registry := [String:[U8]]{}
    make :: (full_key: [U8]) -> ModuleInstanceIdentity{full_key: full_key, fingerprint: "forced-digest", definition_id: "def", argument_keys: [], argument_values: [], argument_provenance: [], template_span: Span.new(0, 0), applications: []}
    first :: make([1])
    second :: make([2])
    register_instance_fingerprint(&registry, first, Span.new(1, 2))
    // GATE #4494: catch the real compiler panic; require its exact expected diagnostic.
    result :: panic.catch_unwind(() -> register_instance_fingerprint(&registry, second, Span.new(3, 4)))
    if result == {
        .Err(payload) -> assert(panic.message(payload).contains("internal compiler error: E0859 generic module instance fingerprint collision"))
        .Ok(_) -> assert(false, "different full keys with equal digest must panic before codegen")
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/InstanceCollisionTests.rs:186
#Test("generated_nominal_names_encode_module_alias_boundaries") {
    assert(module_type_name("foo", "BarBaz") != module_type_name("foo_bar", "Baz"))
    assert(module_type_name("foo_bar", "Baz") != module_type_name("fo_obar", "Baz"))
    assert(module_type_name("_cache", "Item") == "_M5CacheItem")
}

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/InstanceCollisionTests.rs:199
#Test("generic_template_snapshot_never_filters_parser_admitted_items") {
    source :: """
module everything<T> {{
    @answer :: 42
    tag Marked {{ deny: [Net] }}
    trait Show {{ fn show(self) -> T }}
    struct Boxed {{ value: T }}
    enum Maybe {{ Empty Value(T) }}
    impl Boxed.Show {{ fn show(self) -> T {{ return self.value }} }}
    fn id(value: T) -> T {{ return ~value }}
    module nested {{ fn nested() {{}} }}
    module inner<U> {{ fn inner(value: U) -> U {{ return ~value }} }}
    module int_inner :: inner<Int>
    #Test("smoke") {{ expect(@answer == 42) }}
    #Test("work") {{ .measure {{ assert(@answer == 42) }} }}
}}
fn run() {{}}
"""
    (tokens, diagnostics) :: lex(source)
    assert(diagnostics.is_empty(), "{diagnostics:?}")
    program :: parse(tokens) catch _ { panic("parser-admitted generic body") }
    template :: program.items.find_map((item) -> if item == {
        .GenericModule(template) -> Val(template)
        else -> None
    }) ?? panic("generic template")
    snapshot :: ~template
    assert(snapshot.body.len() == template.body.len())
    assert(CanonicalAST.canonical_fragment(snapshot.body) == CanonicalAST.canonical_fragment(template.body))
}
