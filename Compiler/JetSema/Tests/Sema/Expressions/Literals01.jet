use jet_foundation.[Diagnostic, DIAGNOSTIC_ERROR]
use JetSema.Tests.Sema.Statements05.[statements05_diagnostics]

// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5861-5884 (behavioral control; no inline Rust tests)
#Test("single_list_body_can_be_a_whole_list_value") {
    diagnostics :: statements05_diagnostics("fn run() {{ values :: [Int]{{1, 2}}\n same :: [Int].{{values}}\n _ :: same }}\n")
    assert(!diagnostics.any(fn(d: Diagnostic) { d.severity == DIAGNOSTIC_ERROR }), "{diagnostics:?}")
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5890-5929 (behavioral control)
#Test("inferred_typed_literal_requires_context") {
    diagnostics :: statements05_diagnostics("fn run() {{ _ :: .{{1}} }}\n")
    assert(diagnostics.any(fn(d: Diagnostic) { d.code == "E0119" && d.what.contains("needs a known type") }))
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:6333-6354 (behavioral control)
#Test("fixed_list_literal_count_is_checked") {
    diagnostics :: statements05_diagnostics("fn run() {{ values :: [Int#2]{{1}}\n _ :: values }}\n")
    assert(diagnostics.any(fn(d: Diagnostic) { d.code == "E0963" }))
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:6493-6527 (behavioral control)
#Test("empty_nested_item_gets_its_type_from_a_sibling") {
    diagnostics :: statements05_diagnostics("fn run() {{ values :: [[\"41\"], [], [\"x\"]]\n _ :: values }}\n")
    assert(!diagnostics.any(fn(d: Diagnostic) { d.severity == DIAGNOSTIC_ERROR }), "{diagnostics:?}")
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:6621-6633/6708-6721 (behavioral control)
#Test("map_keys_do_not_admit_float") {
    diagnostics :: statements05_diagnostics("fn run() {{ values :: [Float:Int].{{1.0: 2}}\n _ :: values }}\n")
    assert(diagnostics.any(fn(d: Diagnostic) { d.code == "E0502" }))
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:6900-6966 (behavioral control)
#Test("fixed_list_literal_index_outside_length_is_rejected") {
    diagnostics :: statements05_diagnostics("fn run() {{ values :: [Int#2]{{1, 2}}\n _ :: values[2] }}\n")
    assert(diagnostics.any(fn(d: Diagnostic) { d.code == "E0965" && d.what.contains("out of range") }))
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:7106-7115 (behavioral control)
#Test("string_brackets_do_not_turn_into_byte_indexes") {
    diagnostics :: statements05_diagnostics("fn run() {{ text :: \"hello\"\n _ :: text[0] }}\n")
    assert(diagnostics.any(fn(d: Diagnostic) { d.code == "E0503" && d.what == "strings aren't indexed with `[ ]`" }))
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:7202-7221 (behavioral control)
#Test("range_bounds_are_whole_numbers") {
    diagnostics :: statements05_diagnostics("fn run() {{ _ :: \"a\"..\"b\" }}\n")
    assert(diagnostics.any(fn(d: Diagnostic) { d.code == "E0505" && d.what == "range bounds must be Int" }))
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:7814-7831 (behavioral control)
#Test("optional_record_field_does_not_implicitly_unwrap") {
    diagnostics :: statements05_diagnostics("struct Row {{ value: Int }}\nfn read(row: Row?) -> Int Never! {{ row.value }}\nfn run() {{}}\n")
    assert(diagnostics.any(fn(d: Diagnostic) { d.code == "E0310" && d.what.contains("might be missing") }))
}
