use jet_foundation.[DIAGNOSTIC_ERROR]
use JetSema.Tests.Sema.Statements05.[statements05_diagnostics]

// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2142-2283 (behavioral control; no inline Rust tests)
#Test("ordinary_nested_calls_propagate_failure_once_through_grouping") {
    diagnostics :: statements05_diagnostics("fn value() Int String! -> 4\nfn twice(x: Int) Int -> x + x\nfn run() Int String! -> twice((value()))\n")
    assert(!diagnostics.any(d -> d.severity == DIAGNOSTIC_ERROR), "{diagnostics:?}")
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:1982-2140 (behavioral control)
#Test("incompatible_automatic_failure_keeps_provenance_diagnostic") {
    diagnostics :: statements05_diagnostics("fn value() Int String! -> 4\nfn run() Int Never! -> value() + 1\n")
    assert(diagnostics.any(d -> d.code == "E2404"), "{diagnostics:?}")
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2652-2687 (behavioral control)
#Test("valueless_direct_call_is_not_a_value") {
    diagnostics :: statements05_diagnostics("fn effect() {{}}\nfn run() {{ result :: effect() }}\n")
    assert(diagnostics.any(d -> d.code == "E0116" && d.what.contains("doesn't hand back a value")), "{diagnostics:?}")
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:1944-1980 (behavioral control)
#Test("grouped_valueless_statement_call_keeps_statement_root") {
    diagnostics :: statements05_diagnostics("fn effect() {{}}\nfn run() {{ (effect()) }}\n")
    assert(!diagnostics.any(d -> d.code == "E0116"), "{diagnostics:?}")
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:3020-3167 (behavioral control)
#Test("contextual_result_constructors_and_user_call_shadowing_are_distinct") {
    contextual :: statements05_diagnostics("fn run() Int String! -> Ok(3)\n")
    assert(!contextual.any(d -> d.severity == DIAGNOSTIC_ERROR), "{contextual:?}")
    shadowed :: statements05_diagnostics("fn Ok(x: Int) Int -> x\nfn run() Int -> Ok(3)\n")
    assert(!shadowed.any(d -> d.severity == DIAGNOSTIC_ERROR), "{shadowed:?}")
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:3169-3268 (behavioral control)
#Test("statement_dispatch_arms_accept_valueless_call_but_value_arms_do_not") {
    statement :: statements05_diagnostics("fn effect() {{}}\nfn run(flag: Bool) {{ if flag -> effect() else -> effect() }}\n")
    assert(!statement.any(d -> d.code == "E0116"), "{statement:?}")
    value :: statements05_diagnostics("fn effect() {{}}\nfn run(flag: Bool) {{ result :: if flag -> effect() else -> effect() }}\n")
    assert(value.any(d -> d.code == "E0116"), "{value:?}")
}
