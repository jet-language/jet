// The sandbox/C export boundary on the Jet compiler: the MIR Component export
// law, the sandbox interface freeze (E1257) and E1260 wording, and the guest
// producer's canonical-ABI tables (ports of the Rust Plugin.rs unit tests).
fn export_test_require(ok: Bool, message: String) Never! {
    if !ok -> panic("ExportBoundary: {message}")
}

fn export_test_type(kind: MIRTypeKind) -> MIRType Never! {
    MIRType{kind: kind, identity: None, layout: mir_type_layout(kind)}
}

fn export_test_descriptor(kind: MIRTypeKind) -> MIRComponentTypeDescriptor? {
    mir_component_type_descriptor([MIRTypeDef]{}, [String]{}, export_test_type(kind), [MIRTypeID]{})
}

fn export_test_is(actual: MIRComponentTypeDescriptor?, expected: MIRComponentTypeDescriptor) -> Bool Never! {
    if actual == .Val(value) -> return value == expected
    false
}

fn export_test_law() Never! {
    export_test_require(export_test_is(export_test_descriptor(MIRTypeKind.Int), MIRComponentTypeDescriptor.Int), "Int is a Component scalar")
    export_test_require(export_test_is(export_test_descriptor(MIRTypeKind.String), MIRComponentTypeDescriptor.String), "String is a Component scalar")
    export_test_require(export_test_descriptor(MIRTypeKind.IntN{signed: false, bits: 8}) == None, "U8 crosses only the C boundary")
    export_test_require(export_test_descriptor(MIRTypeKind.Float32) == None, "F32 crosses only the C boundary")
    list :: export_test_descriptor(MIRTypeKind.List{inner: export_test_type(MIRTypeKind.Float)})
    export_test_require(export_test_is(list, MIRComponentTypeDescriptor.List{inner: MIRComponentTypeDescriptor.Float}), "[Float] is a Component list")
    result :: export_test_descriptor(MIRTypeKind.Result{ok: export_test_type(MIRTypeKind.Int), err: export_test_type(MIRTypeKind.String)})
    export_test_require(export_test_is(result, MIRComponentTypeDescriptor.Result{ok: MIRComponentTypeDescriptor.Int, err: MIRComponentTypeDescriptor.String}), "Result<Int, String> is a Component result")
    export_test_require(export_test_descriptor(MIRTypeKind.Option{inner: export_test_type(MIRTypeKind.IntN{signed: true, bits: 32})}) == None, "a fixed width stays C-only inside an Option")
    export_test_require(export_test_descriptor(MIRTypeKind.Map{key: export_test_type(MIRTypeKind.String), value: export_test_type(MIRTypeKind.Int)}) == None, "maps have no Component shape")
    nominal :: MIRTypeKind.Apply{name: MIRNominalRef{id: MIRTypeID{value: 7}, name: "Point"}, args: [MIRType]{}}
    export_test_require(export_test_descriptor(nominal) == None, "an undeclared nominal has no Component shape")
}

fn export_test_freeze() Never! {
    text :: "api_version = 3\npackage = plugin__mathkit\npublished_version = 0.1.0\nfn gcd(a: Int, b: Int) Int\nfn greet(name: String) String\n"
    prior :: sema_sandbox_parse_snapshot(text) ?? panic("ExportBoundary: the frozen mathkit snapshot parses")
    export_test_require(prior.package == "plugin__mathkit" && prior.funcs.len() == 2, "snapshot header and rows")
    export_test_require(prior.funcs[0].name == "gcd" && prior.funcs[1].name == "greet", "snapshot rows keep their export names")
    export_test_require(sema_sandbox_snapshot_text(prior, "0.1.0") == text, "snapshot text round-trips")
    export_test_require(sema_sandbox_snapshot_package("mathkit") == "plugin__mathkit", "sandbox snapshots are namespaced")
    export_test_require(sema_sandbox_parse_snapshot("api_version = 2\npackage = plugin__x\n") == None, "another snapshot schema is refused")
    export_test_require(sema_sandbox_freeze_diagnostics(prior, Val(prior)).len() == 0, "an unchanged interface freezes silently")
    added := prior
    &added.funcs.push(SemaPluginFrozenExportInput{name: "scale", signature: "fn scale(a: Float, b: Float) Float"})
    export_test_require(sema_sandbox_freeze_diagnostics(added, Val(prior)).len() == 0, "adding an export is compatible")
    changed :: SemaPluginFrozenSnapshotInput{package: prior.package, funcs: [SemaPluginFrozenExportInput]{SemaPluginFrozenExportInput{name: "gcd", signature: "fn gcd(a: Int) Int"}}}
    drift :: sema_sandbox_freeze_diagnostics(changed, Val(prior))
    export_test_require(drift.len() == 2 && drift[0].code == "E1257" && drift[1].code == "E1257", "a changed and a removed export are each E1257")
    export_test_require(sema_sandbox_freeze_diagnostics(changed, None).len() == 0, "no prior snapshot freezes the current interface")
    span :: Span{start: 0, end: 1}
    export_test_require(sema_export_unsupported_diagnostic(SemaExportBoundary.Sandbox, "probe", span).code == "E1260", "a sandbox export outside the Component law is E1260")
    export_test_require(sema_export_unsupported_diagnostic(SemaExportBoundary.C, "probe", span).code == "E1260", "a C export outside the U3 law is the same E1260")
}

fn export_test_producer() Never! {
    export_test_require(jet_plugin_sanitize_package_name("Math_Kit 2") == "math-kit-2", "WIT package names are lowercase kebab")
    export_test_require(jet_plugin_sanitize_package_name("9lives") == "plugin-9lives", "WIT package names start with a letter")
    export_test_require(jet_plugin_kebab("is_enabled") == "is-enabled", "exports are kebab-case")
    record :: MIRComponentTypeDescriptor.Record{name: "PointRow", fields: [MIRComponentTypeField]{
        MIRComponentTypeField{index: 0, name: "x", ty: MIRComponentTypeDescriptor.Int},
        MIRComponentTypeField{index: 1, name: "label", ty: MIRComponentTypeDescriptor.String},
    }}
    export_test_require(jet_plugin_wit_type(record) == "point-row", "records name their WIT definition")
    nested :: MIRComponentTypeDescriptor.Result{ok: MIRComponentTypeDescriptor.List{inner: MIRComponentTypeDescriptor.String}, err: MIRComponentTypeDescriptor.Option{inner: MIRComponentTypeDescriptor.Int}}
    export_test_require(jet_plugin_wit_type(nested) == "result<list<string>, option<s64>>", "nested WIT spelling")
    slots :: jet_plugin_flat_slots(MIRComponentTypeDescriptor.Result{ok: MIRComponentTypeDescriptor.Float, err: MIRComponentTypeDescriptor.Int})
    export_test_require(slots.len() == 2 && slots[0] == JetPluginCoreSlot.I32 && slots[1] == JetPluginCoreSlot.I64, "result payload slots join f64 and i64 as i64")
    export_test_require(jet_plugin_flat_slots(record).len() == 3, "a record flattens field by field")
    record_layout :: jet_plugin_memory_layout(record)
    export_test_require(record_layout.size == 16 && record_layout.align == 8, "record (s64, string) is 16 bytes aligned 8")
    option_layout :: jet_plugin_memory_layout(MIRComponentTypeDescriptor.Option{inner: MIRComponentTypeDescriptor.Bool})
    export_test_require(option_layout.size == 2 && option_layout.align == 1, "option<bool> is 2 bytes aligned 1")
    result_layout :: jet_plugin_memory_layout(MIRComponentTypeDescriptor.Result{ok: MIRComponentTypeDescriptor.String, err: MIRComponentTypeDescriptor.Int})
    export_test_require(result_layout.size == 16 && result_layout.align == 8 && jet_plugin_payload_offset(MIRComponentTypeDescriptor.Result{ok: MIRComponentTypeDescriptor.String, err: MIRComponentTypeDescriptor.Int}) == 8, "result<string, s64> payload sits at 8")
    export_test_require(jet_plugin_needs_post_return(record) && !jet_plugin_needs_post_return(MIRComponentTypeDescriptor.Bool), "string-bearing results need cabi_post")
    defined := [String]{}
    definitions := [String]{}
    jet_plugin_wit_definitions(MIRComponentTypeDescriptor.List{inner: record}, &defined, &definitions)
    jet_plugin_wit_definitions(record, &defined, &definitions)
    export_test_require(definitions.len() == 1 && definitions[0] == "record point-row {{\n  x: s64,\n  label: string,\n}}", "each record definition is declared once")
    wit :: jet_plugin_host_io_wit_definitions()
    variants :: "variant io-error {{\n  invalid-input(io-context),\n  not-found(io-context),\n  permission-denied(io-context),\n  timed-out(io-context),\n  cancelled(io-context),\n  closed(io-context),\n  protocol(io-context),\n  other(io-context),\n  resource-limit(process-resource-limit),\n  already-exists(io-context),\n  unsupported(io-context),\n}}"
    export_test_require(wit.contains(variants), "the io-error WIT keeps Core IOError's variant order and payloads")
    helpers :: jet_plugin_io_error_helpers("")
    guard :: "if tag <= 7 || tag == 9 || tag == 10 {{"
    halves :: helpers.split("fn {jet_plugin_generated("free_io_error")}").to_list()
    export_test_require(halves.len() == 2 && halves[0].contains(guard) && halves[1].contains(guard), "decode and free share every context-variant guard")
    export_test_require(halves[0].contains("9 => jet_std::IOError::AlreadyExists(context),") && halves[0].contains("10 => jet_std::IOError::Unsupported(context),"), "decode maps AlreadyExists and Unsupported")
    export_test_require(halves[0].contains("jet_std::IOError::ResourceLimit(limit)") && halves[1].contains("if limit > 4"), "resource limits decode and validate")
    export_test_require(halves[1].split("{jet_plugin_generated("cabi_realloc_impl")}(value_ptr, value_len, 1, 0);").to_list().len() == 3, "resource and cause keep their separate conditional releases")
    bridge :: jet_plugin_host_import_bridge("", [String]{"FS.Read", "FS.Write"})
    sequence :: "let value = {jet_plugin_generated("read_io_error")}((ret_ptr as usize + 8) as i32); {jet_plugin_generated("free_io_error")}((ret_ptr as usize + 8) as i32); Err(value)"
    export_test_require(bridge.split(sequence).to_list().len() == 3, "each FS error arm decodes before its one payload release")
    export_test_require(jet_plugin_host_import_bridge("", [String]{}) == "", "no declared imports, no bridge")
}

fn run() {
    export_test_law()
    export_test_freeze()
    export_test_producer()
    print("export boundary: passed")
}
