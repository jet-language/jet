// A lambda passed to a call keeps its read borrow while the callee may run
// it, so a later argument of that call cannot change the captured local.
grow: fn(count: fn() -> Int, values: &[Int]) { values.push(count()) }

run: fn() {
    values := [1, 2]
    grow(fn() -> Int { values.len() }, values)
    print(values.len())
}
