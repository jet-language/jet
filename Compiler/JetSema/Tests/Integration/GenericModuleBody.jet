// Rust: crates/jet-sema/tests/generic_module_body.rs:469
#Test("instance_fingerprint_is_nominal_and_ignores_body_shape") {
    base :: "module boxed<T>(n: Int) { fn value() -> Int { return n } }\nmodule instance :: boxed<Int>(3)\nfn run() {}"
    shifted :: "\n\nmodule boxed<T>(n: Int) {   fn value() -> Int { return n } }\nmodule renamed :: boxed<Int>(3)\nfn run() {}"
    body :: "module boxed<T>(n: Int) { fn value() -> Int { return n + 1 } }\nmodule instance :: boxed<Int>(3)\nfn run() {}"
    arg :: "module boxed<T>(n: Int) { fn value() -> Int { return n } }\nmodule instance :: boxed<Int>(4)\nfn run() {}"
    fp :: only_instance_fingerprint(base, "pkg-a")
    assert(fp == only_instance_fingerprint(shifted, "pkg-a"))
    assert(fp == only_instance_fingerprint(body, "pkg-a"))
    assert(fp != only_instance_fingerprint(arg, "pkg-a"))
    assert(fp == only_instance_fingerprint(base, "pkg-b"), "manifest-less host paths are non-semantic")
    // GATE #4494: real native temporary directories and process id.
    roots :: env.temp_dir().join("jet_genmod_nominal_packages_{process.id()}")
    package_a :: roots.join("checkout-a")
    package_b :: roots.join("checkout-b")
    files.mkdir(package_a, true).unwrap()
    files.mkdir(package_b, true).unwrap()
    files.write(package_a.join("pkg.jet"), "payload: { name: \"package-a\", version: \"1.0.0\" }").unwrap()
    files.write(package_b.join("pkg.jet"), "payload: { name: \"package-b\", version: \"1.0.0\" }").unwrap()
    assert(only_instance_fingerprint(base, package_a.to_str().unwrap()) != only_instance_fingerprint(base, package_b.to_str().unwrap()), "canonical package identity remains nominal")
    _ :: files.remove_dir_all(roots)
}
// Rust: crates/jet-sema/tests/generic_module_body.rs:511
#Test("instance_definition_identity_tracks_manifest_semver_not_formatting_or_workspace_lock_noise") {
    base :: env.temp_dir().join("jet_genmod_identity_{process.id()}")
    a :: base.join("a")
    b :: base.join("b")
    files.mkdir(a.join(".jet"), true).unwrap()
    files.mkdir(b.join(".jet"), true).unwrap()
    files.write(a.join("pkg.jet"), "payload: {\n name: \"demo\",\n version: \"1.0.0\"\n}").unwrap()
    files.write(b.join("pkg.jet"), "payload: {\n name: \"demo\",\n version: \"2.0.0\"\n}").unwrap()
    files.write(a.join(".jet/lock"), "source = a").unwrap()
    files.write(b.join(".jet/lock"), "source = b").unwrap()
    src :: "module boxed<T> { fn value(v: T) -> T { return v } }\nmodule instance :: boxed<Int>\nfn run() {}"
    assert(only_instance_fingerprint(src, a.to_str().unwrap()) != only_instance_fingerprint(src, b.to_str().unwrap()))
    files.write(b.join("pkg.jet"), "payload: { name: \"demo\", version: \"1.0.0\" }").unwrap()
    assert(only_instance_fingerprint(src, a.to_str().unwrap()) == only_instance_fingerprint(src, b.to_str().unwrap()))
    files.write(b.join(".jet/lock"), "source = a\n").unwrap()
    assert(only_instance_fingerprint(src, a.to_str().unwrap()) == only_instance_fingerprint(src, b.to_str().unwrap()))
    _ :: files.remove_dir_all(base)
}
// Rust: crates/jet-sema/tests/generic_module_body.rs:552
#Test("trait_impl_and_error_conversion_are_specialized_as_one_local_identity_graph") {
    src :: "\nmodule laws<T> {\n    tag Audited { deny: [Net] }\n    fn audited(value: #Audited T) -> #Audited T { return ~value }\n    trait Reveal {\n        type Output\n        fn reveal(self) -> T\n    }\n    struct Wrapped { value: T }\n    impl Wrapped.Reveal {\n        type Output = T\n        fn reveal(self) -> T { return self.value }\n    }\n    enum SourceErr { Bad(T) }\n    enum TargetErr { Wrapped(SourceErr) }\n    impl SourceErr -> TargetErr { return TargetErr.Wrapped(self) }\n}\nmodule int_laws :: laws<Int>\nfn run() {}\n"
    (bundle, diagnostics) :: check(src)
    assert(error_codes(diagnostics).is_empty(), "{diagnostics:#?}")
    items :: bundle.modules[0].items
    assert(items.any(fn(item) { if item == { .Trait(t) -> t.name == "M3Int4LawsReveal" && t.methods[0].return_type == Val(Type.Int); else -> false } }))
    assert(items.any(fn(item) { if item == { .Tag(t) -> t.name == "M3Int4LawsAudited"; else -> false } }))
    instance :: items.find_map(fn(item) { if item == { .CodeModule(m) -> if m.name == "int_laws" -> Val(m) else -> None; else -> None } }).unwrap()
    tagged :: instance.body.unwrap().find_map(fn(item) { if item == { .Func(f) -> if f.name == "audited" -> Val(f.params[0].ty) else -> None; else -> None } }).unwrap()
    assert(if tagged == { .Tagged{marker, inner} -> (if marker == { .User(name) -> name == "M3Int4LawsAudited"; else -> false }) && inner == Type.Int; else -> false }, "{tagged:?}")
    assert(items.any(fn(item) { if item == { .Impl(i) -> i.type_name == "M3Int4LawsWrapped" && i.trait_name == Val("M3Int4LawsReveal") && i.assoc_type_impls[0].2 == Type.Int; else -> false } }))
    assert(items.any(fn(item) { if item == { .ErrorConv(ec) -> ec.from_ty == "M3Int4LawsSourceErr" && ec.to_ty == "M3Int4LawsTargetErr"; else -> false } }))
}
