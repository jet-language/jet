}
// Rust: crates/jet-sema/tests/generic_module_body.rs:788
#Test("measured_tests_are_specialized_once_per_instance_with_unique_names") {
    (bundle, diagnostics) :: check("\nmodule checks<T>(count: Int) {\n    #Test fn identity(value: T) { expect(count == count) }\n    #Test(\"work\") { .measure { assert(count == count) } }\n}\nmodule int_checks :: checks<Int>(2)\nmodule text_checks :: checks<String>(4)\nfn run() {}\n")
    assert(error_codes(diagnostics).is_empty(), "{diagnostics:#?}")
    tests :: bundle.modules[0].items.filter_map(fn(item) { if item == { .Test(t) -> Val(t); else -> None } }).to_array()
    assert(tests.map(fn(t) { t.name }).to_array() == [Val("int_checks_identity"), Val("text_checks_identity")])
    assert(tests[0].params[0].ty == Type.Int)
    assert(tests[1].params[0].ty == Type.String)
}
// Rust: crates/jet-sema/tests/generic_module_body.rs:818
#Test("qualified_core_alias_counts_as_import_use") {
    (_, diagnostics) :: check("\nuse core.compute.solve as solve\nuse core.files as files\n\nfn run() {\n    solver := solve.Solver.new(42)\n    print(solver.status())\n}\n")
    lints :: diagnostics.filter(fn(diagnostic) { diagnostic.severity == Severity.Lint }).to_array()
    assert(lints.map(fn(diagnostic) { diagnostic.code }).to_array() == ["L0103"])
    assert(lints[0].span == Val(Span.new(51, 56)))
}
// Rust: crates/jet-sema/tests/generic_module_body.rs:848
#Test("qualified_core_alias_does_not_consume_same_target_alias") {
    (_, diagnostics) :: check("\nuse core.compute.solve as solve\nuse core.compute.solve as other\n\nfn run() {\n    solver := solve.Solver.new(42)\n    print(solver.status())\n}\n")
    lints :: diagnostics.filter(fn(diagnostic) { diagnostic.severity == Severity.Lint }).to_array()
    assert(lints.map(fn(diagnostic) { diagnostic.code }).to_array() == ["L0103"])
    assert(lints[0].what.contains("other"))
}
// Rust: crates/jet-sema/tests/generic_module_body.rs:872
#Test("failed_qualified_core_use_does_not_consume_alias") {
    (_, diagnostics) :: check("\nuse core.compute.solve as solve\n\nfn run() {\n    solve.not_a_real_call()\n}\n")
    assert(diagnostics.any(fn(diagnostic) { diagnostic.code == "L0103" && diagnostic.what.contains("solve") }), "failed qualified use must leave alias unused: {diagnostics:#?}")
}
// Rust: crates/jet-sema/tests/generic_module_body.rs:891
#Test("selective_alias_ledger_keeps_local_binding_span") {
    src :: "\nmodule util {\n    pub fn double(x: Int) -> Int -> x * 2\n    pub fn triple(x: Int) -> Int -> x * 3\n}\nuse util.[double as d, triple as t]\nfn run() { print(d(5)) }\n"
    (bundle, diagnostics) :: check(src)
    assert(error_codes(diagnostics).is_empty(), "{diagnostics:#?}")
    alias :: bundle.name_ledger.alias(0, "t").expect("selective import alias")
    alias_start :: src.find("triple as t").expect("alias source") + "triple as ".len()
    expected_span :: Span.new(alias_start, alias_start + 1)
    assert(alias.span == expected_span)
    lint :: diagnostics.find(fn(diagnostic) { diagnostic.code == "L0103" && diagnostic.what.contains("t") }).expect("unused selective alias lint")
    assert(lint.span == Val(expected_span))
}
