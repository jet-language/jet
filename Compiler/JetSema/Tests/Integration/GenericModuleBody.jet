// Rust: crates/jet-sema/tests/generic_module_body.rs:9
fn ensure_mir_bridge() Never! {
    // GATE #4494: installs the canonical Jet comptime evaluator once.
    static INSTALL: Once = Once.new()
    INSTALL.call_once(fn() { install_mir_bridge() })
}
// Rust: crates/jet-sema/tests/generic_module_body.rs:16
fn check(src: String) -> (ProgramBundle, [Diagnostic]) { check_at(src, ".") }
// Rust: crates/jet-sema/tests/generic_module_body.rs:20
fn check_at(src: String, root: String) -> (ProgramBundle, [Diagnostic]) {
    ensure_mir_bridge()
    (tokens, lex) :: Lexer.lex(src)
    assert(lex.is_empty(), "lexer diagnostics: {lex:?}")
    program := Parser.parse(tokens).expect("source parses")
    bundle := ProgramBundle{
        entry: 0, project_root: OSPath.from(root),
        modules: [LoadedModule{path: OSPath.from("generic_module_body.jet"), display: "generic_module_body.jet", alias: "main",
            imports: ^program.imports, items: ^program.items, script_body: ^program.script_body, source: src,
            block_spans: ^program.block_spans, web_target_ceiling: program.web_target_ceiling, pub_file: program.pub_file,
            no_prelude: program.no_prelude, default_target: program.default_target, html_path: ^program.html_path,
            policy_declarations: ^program.policy_declarations, user_policy_declarations: ^program.user_policy_declarations, rule_facts: ^program.rule_facts}],
        devtools_registry: DevtoolsRegistry.default(), parse_teaching: [], used_core: HashSet[String].new(), ffi_callback_fns: HashSet[String].new(),
        cffi: CFfi.default(), comptime_inputs: [], name_ledger: NameLedger.default(), layer_ceiling: None, inferred_layer: Syntax.RuntimeLayer.Core,
        web_partitions: [:], web_partition_enforced: false, web_partition_report: None, dep_roots: [:], package_guarantees: .default(),
        program_allocator: .default(), active_os: Syntax.OSTarget.host(), build_facts: .default(), edition: "2027"
    }
    diagnostics :: check_bundle(&bundle, CompileMode.Eval)
    (bundle, diagnostics)
}
// Rust: crates/jet-sema/tests/generic_module_body.rs:69
fn only_instance_fingerprint(src: String, root: String) -> String {
    (bundle, diagnostics) :: check_at(src, root)
    assert(error_codes(diagnostics).is_empty(), "{diagnostics:#?}")
    bundle.modules[0].items.find_map(fn(item) { if item == { .CodeModule(module) -> module.instance_identity.map(fn(identity) { identity.fingerprint }); else -> None } }).expect("generic instance fingerprint")
}
// Rust: crates/jet-sema/tests/generic_module_body.rs:85
fn check_modules(sources: [(String, String, [(String, Int)])]) -> (ProgramBundle, [Diagnostic]) {
    ensure_mir_bridge()
    modules := [LoadedModule]{}
    name_ledger := NameLedger.default()
    loop (module_idx, (path, src, targets)) in sources.enumerate() {
        (tokens, lex) :: Lexer.lex(src)
        assert(lex.is_empty(), "lexer diagnostics: {lex:?}")
        program := Parser.parse(tokens).expect("source parses")
        loop (alias, target) in targets {
            import :: program.imports.find(fn(import) { import.import_alias() == alias && !(import.kind is ImportKind.Unqualified) }).unwrap()
            &name_ledger.record_import_target(module_idx, import.span, target)
        }
        &modules.push(LoadedModule{path: OSPath.from(path), display: path, alias: path.trim_end_matches(".jet").to_string(),
            imports: ^program.imports, items: ^program.items, script_body: ^program.script_body, source: src,
            block_spans: ^program.block_spans, web_target_ceiling: program.web_target_ceiling, pub_file: program.pub_file,
            no_prelude: program.no_prelude, default_target: program.default_target, html_path: ^program.html_path,
            policy_declarations: ^program.policy_declarations, user_policy_declarations: ^program.user_policy_declarations, rule_facts: ^program.rule_facts})
    }
    bundle := ProgramBundle{entry: sources.len() - 1, project_root: OSPath.from("pkg-a"), modules: ^modules,
        devtools_registry: DevtoolsRegistry.default(), parse_teaching: [], used_core: HashSet[String].new(), ffi_callback_fns: HashSet[String].new(),
        cffi: CFfi.default(), comptime_inputs: [], name_ledger: ^name_ledger, layer_ceiling: None, inferred_layer: Syntax.RuntimeLayer.Core,
        web_partitions: [:], web_partition_enforced: false, web_partition_report: None, dep_roots: [:], package_guarantees: .default(),
        program_allocator: .default(), active_os: Syntax.OSTarget.host(), build_facts: .default(), edition: "2027"}
    diagnostics :: check_bundle(&bundle, CompileMode.Eval)
    (bundle, diagnostics)
}
// Rust: crates/jet-sema/tests/generic_module_body.rs:150
fn error_codes(diags: [Diagnostic]) -> [String] Never! {
    diags.filter(fn(d) { d.severity == Severity.Error }).map(fn(d) { d.code }).to_array()
}
// Rust: crates/jet-sema/tests/generic_module_body.rs:159
#Test("equivalent_instances_are_interned_and_project_one_nominal_identity") {
    src :: "\nmodule boxed<T>(size: Int) {\n    struct Box { value: T }\n    fn identity(value: Box) -> Box { return ~value }\n}\nmodule other<T>(size: Int) { struct Box { value: T } }\nmodule first :: boxed<Int>(3)\nmodule equivalent :: boxed<Int>(3)\nmodule forward :: equivalent\nmodule different_type :: boxed<String>(3)\nmodule different_value :: boxed<Int>(4)\nmodule different_template :: other<Int>(3)\nfn accepts_first(value: first.Box) -> first.Box { return ~value }\nfn accepts_projection(value: equivalent.Box) -> first.Box { return ~value }\nfn accepts_chain(value: forward.Box) -> first.Box { return ~value }\nfn accepts_surface(value: first.Box) -> first.Box { return ~value }\nfn accepts_forward_surface(value: forward.Box) -> first.Box { return ~value }\nfn run() {}\n"
    (bundle, diagnostics) :: check(src)
    assert(error_codes(diagnostics).is_empty(), "{diagnostics:#?}")
    assert(bundle.name_ledger.display_path(0, "M5FirstBox", Val(0)) == Val("first.Box"), "generic nominal names stay internal to diagnostics and tooling")
    items :: bundle.modules[0].items
    modules :: items.filter_map(fn(item) { if item == { .CodeModule(module) -> Val(module.name); else -> None } }).to_array()
    assert(modules.filter(fn(name) { name == "first" }).count() == 1)
    assert(!modules.contains("equivalent"))
    assert(!modules.contains("forward"))
    assert(modules.contains("different_type"))
    assert(modules.contains("different_value"))
    assert(modules.contains("different_template"))
    assert(items.filter(fn(item) { if item == { .Struct(definition) -> definition.name == "M5FirstBox"; else -> false } }).count() == 1)
    loop name in ["accepts_projection", "accepts_chain"] {
        function :: items.find_map(fn(item) { if item == { .Func(f) -> if f.name == name -> Val(f) else -> None; else -> None } }).unwrap()
        assert(function.params[0].ty == Type.Named("M5FirstBox"))
        assert(function.return_type == Val(Type.Named("M5FirstBox")))
    }
    loop name in ["accepts_surface", "accepts_forward_surface"] {
        function :: items.find_map(fn(item) { if item == { .Func(f) -> if f.name == name -> Val(f) else -> None; else -> None } }).unwrap()
        assert(function.params[0].ty == Type.Named("M5FirstBox"))
        assert(function.return_type == Val(Type.Named("M5FirstBox")))
    }
}
// Rust: crates/jet-sema/tests/generic_module_body.rs:232
#Test("generic_module_comptime_bindings_survive_item_registration") {
    (bundle, diagnostics) :: check("\nmodule cache<K>(capacity: Int) {\n    BASE :: prep { capacity }\n    COMPUTED_SIZE :: prep { BASE + 1 }\n    fn size() -> Int -> COMPUTED_SIZE\n}\nmodule instance :: cache<Int>(3)\nfn run() {}\n")
    assert(error_codes(diagnostics).is_empty(), "{diagnostics:#?}")
    items :: bundle.modules[0].items
    assert(items.any(fn(item) { if item == { .Const(c) -> c.name == "instance_@base" && c.ct == Val(CtValue.Int(3)); else -> false } }))
    assert(items.any(fn(item) { if item == { .Const(c) -> c.name == "instance_@computed_size" && c.ct == Val(CtValue.Int(4)); else -> false } }))
}
// Rust: crates/jet-sema/tests/generic_module_body.rs:261
#Test("soft_public_aliases_keep_distinct_casing_safe_type_names") {
    (bundle, diagnostics) :: check("\nmodule holder<T> { struct Item { value: T } }\nmodule cache :: holder<Int>\nmodule _cache :: holder<String>\nfn run() {}\n")
    assert(error_codes(diagnostics).is_empty(), "{diagnostics:#?}")
    names :: bundle.modules[0].items.filter_map(fn(item) { if item == { .Struct(definition) -> Val(definition.name); else -> None } }).to_array()
    assert(names.contains("M5CacheItem"), "{names:?}")
    assert(names.contains("_M5CacheItem"), "{names:?}")
}
// Rust: crates/jet-sema/tests/generic_module_body.rs:284
#Test("imported_template_is_interned_once_across_consumers") {
    template :: "\npub module boxed<T>(size: Int) { pub struct Box { value: T } }\npub module other<T>(size: Int) { pub struct Box { value: T } }\n"
    first :: "\nuse \"./templates\" as templates\nuse templates.[boxed]\npub module first :: boxed<Int>(3)\nfn run() {}\n"
    second :: "\nuse \"./templates\" as templates\nuse templates.[boxed, other]\nmodule second :: boxed<Int>(3)\nmodule different_arg :: boxed<Int>(4)\nmodule different_template :: other<Int>(3)\nfn accepts_projection(value: second.Box) -> first.Box { return ~value }\nfn run() {}\n"
    (bundle, diagnostics) :: check_modules([("templates.jet", template, []), ("first.jet", first, [("templates", 0)]), ("second.jet", second, [("templates", 0)])])
    assert(error_codes(diagnostics).is_empty(), "{diagnostics:#?}")
    count := 0
    loop module in bundle.modules {
        count += module.items.filter(fn(item) { if item == { .Struct(definition) -> definition.name == "M5FirstBox"; else -> false } }).count()
    }
    assert(count == 1)
    assert(!bundle.modules[2].items.any(fn(item) { if item == { .CodeModule(m) -> m.name == "second"; else -> false } }))
    assert(bundle.modules[2].items.any(fn(item) { if item == { .CodeModule(m) -> m.name == "different_arg"; else -> false } }))
    assert(bundle.modules[2].items.any(fn(item) { if item == { .CodeModule(m) -> m.name == "different_template"; else -> false } }))
}
// Rust: crates/jet-sema/tests/generic_module_body.rs:333
#Test("imported_struct_returns_expose_all_fields_but_scalars_keep_e0302") {
    provider :: "\npub struct IngestResult {\n    pub provider: String\n    pub name: String\n    pub version: String\n    pub reference: String\n    pub source: String\n    pub expected_hash: String\n}\n\npub struct RealizeResult {\n    pub provider: String\n    pub name: String\n    pub version: String\n    pub reference: String\n    pub source: String\n    pub expected_hash: String\n}\n\npub fn ingest() -> IngestResult {\n    return IngestResult{\n        provider: \"local\",\n        name: \"demo\",\n        version: \"1\",\n        reference: \"main\",\n        source: \"/tmp/demo\",\n        expected_hash: \"hash\"\n    }\n}\n\npub fn realize() -> RealizeResult {\n    return RealizeResult{\n        provider: \"local\",\n        name: \"demo\",\n        version: \"1\",\n        reference: \"main\",\n        source: \"/tmp/demo\",\n        expected_hash: \"hash\"\n    }\n}\n"
    consumer :: "\nuse \"./provider\" as provider\n\nfn run() {\n    ingested :: provider.ingest() ?? panic(\"ingest\")\n    print(ingested.provider)\n    print(ingested.name)\n    print(ingested.version)\n    print(ingested.reference)\n    print(ingested.source)\n    print(ingested.expected_hash)\n\n    realized :: provider.realize() ?? panic(\"realize\")\n    print(realized.provider)\n    print(realized.name)\n    print(realized.version)\n    print(realized.reference)\n    print(realized.source)\n    print(realized.expected_hash)\n\n    scalar :: 1\n    print(scalar.provider)\n}\n"
    (_, diagnostics) :: check_modules([("provider.jet", provider, []), ("consumer.jet", consumer, [("provider", 0)])])
    assert(error_codes(diagnostics) == ["E0302"], "{diagnostics:#?}")
}
