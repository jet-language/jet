// Rust: crates/jet-sema/tests/generic_module_body.rs:674
#Test("nested_generic_alias_closes_over_outer_type_and_value_arguments") {
    (bundle, diagnostics) :: check("\nmodule outer<T>(count: Int) {\n    module inner<U> { pub fn keep(value: T, other: U) -> T { return ~value } }\n    module fixed :: inner<Int>\n    module forward :: fixed\n}\nmodule text_outer :: outer<String>(3)\nmodule other_outer :: outer<String>(4)\nfn run() {}\n")
    assert(error_codes(diagnostics).is_empty(), "{diagnostics:#?}")
    inner :: bundle.modules[0].items.find_map(fn(item) { if item == { .CodeModule(m) -> if m.name == "text_outer_fixed" -> Val(m) else -> None; else -> None } }).expect("nested alias expanded into a checked module")
    keep :: if inner.body.unwrap()[0] == { .Func(f) -> f; else -> panic("nested function") }
    assert(keep.params[0].ty == Type.String)
    assert(keep.params[1].ty == Type.Int)
    assert(keep.return_type == Val(Type.String))
    assert(!bundle.modules[0].items.any(fn(item) { if item == { .CodeModule(m) -> m.name == "text_outer_forward"; else -> false } }))
    identity :: inner.instance_identity.expect("nested applicative identity")
    assert(identity.applications.map(fn(application) { application.name }).to_array() == ["text_outer_fixed", "text_outer_forward"])
    other :: bundle.modules[0].items.find_map(fn(item) { if item == { .CodeModule(m) -> if m.name == "other_outer_fixed" -> Val(m) else -> None; else -> None } }).expect("different enclosing values keep distinct nested identities")
    assert(identity.fingerprint != other.instance_identity.unwrap().fingerprint)
}
// Rust: crates/jet-sema/tests/generic_module_body.rs:731
#Test("ordinary_nested_module_recursively_expands_generic_aliases") {
    (bundle, diagnostics) :: check("\nmodule outer<T>(count: Int) {\n    module plain {\n        module inner<U> { pub fn total(value: U) -> Int { return count } }\n        module closed :: inner<T>\n        pub fn result(value: T) -> Int { return closed.total(value) }\n    }\n    pub fn result(value: T) -> Int { return plain.result(value) }\n}\nmodule selected :: outer<Int>(6)\nfn run() { print(selected.result(1)) }\n")
    assert(error_codes(diagnostics).is_empty(), "{diagnostics:#?}")
    items :: bundle.modules[0].items
    plain :: items.find_map(fn(item) { if item == { .CodeModule(m) -> if m.name == "selected_plain" -> Val(m) else -> None; else -> None } }).expect("ordinary nested module remains a real checked module")
    assert(!plain.body.unwrap().any(fn(item) { item is Item.GenericModule || item is Item.ModuleAlias }))
    closed :: items.find_map(fn(item) { if item == { .CodeModule(m) -> if m.name == "selected_plain_closed" -> Val(m) else -> None; else -> None } }).expect("contained generic alias expands to a real module")
    assert(closed.instance_identity != None)
}
