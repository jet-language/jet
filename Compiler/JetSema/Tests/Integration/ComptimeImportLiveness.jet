// Rust: crates/jet-sema/tests/comptime_import_liveness.rs:1
use jet_sema.AST.[CFfi, LoadedModule, ProgramBundle, DevtoolsRegistry, NameLedger]
use jet_sema.Diagnostics.[Diagnostic]
use jet_sema.Sema.[check_bundle_with_effect_facts_for_build, CompileMode]
use jet_sema.[Lexer, Parser]
use jet_sema.Syntax as Syntax
use jet_codegen.Codegen.MIREval.[install_mir_bridge]
use std.sync.[Once]
use std.collections.[HashSet]

// Rust: crates/jet-sema/tests/comptime_import_liveness.rs:9
fn ensure_mir_bridge() Never! {
    // GATE #4494: canonical once-only initialization; this installs the Jet evaluator.
    static INSTALL: Once = Once.new()
    INSTALL.call_once(fn() Never! { install_mir_bridge() })
}

// Rust: crates/jet-sema/tests/comptime_import_liveness.rs:16
pub fn check(source: String) -> [Diagnostic] Never! {
    ensure_mir_bridge()
    (tokens, lex) :: Lexer.lex(source)
    assert(lex.is_empty(), "lexer diagnostics: {lex:?}")
    program := Parser.parse(tokens).expect("source parses")
    bundle := ProgramBundle{
        entry: 0, project_root: OSPath.from("."),
        modules: [LoadedModule]{LoadedModule{
            path: OSPath.from("comptime_import_liveness.jet"), display: "comptime_import_liveness.jet", alias: "main",
            imports: ^program.imports, items: ^program.items, script_body: ^program.script_body,
            source: source.to_string(), block_spans: ^program.block_spans,
            web_target_ceiling: program.web_target_ceiling, pub_file: program.pub_file,
            no_prelude: program.no_prelude, default_target: program.default_target, html_path: ^program.html_path,
            policy_declarations: program.policy_declarations.clone(), user_policy_declarations: program.user_policy_declarations.clone(),
            rule_facts: ^program.rule_facts}},
        devtools_registry: DevtoolsRegistry.default(), parse_teaching: [], used_core: HashSet[String].new(),
        ffi_callback_fns: HashSet[String].new(), cffi: CFfi.default(), comptime_inputs: [], name_ledger: NameLedger.default(),
        layer_ceiling: None, inferred_layer: Syntax.RuntimeLayer.Core, web_partitions: [:], web_partition_enforced: false,
        web_partition_report: None, dep_roots: [:], package_guarantees: .default(), program_allocator: .default(),
        active_os: Syntax.OSTarget.host(), build_facts: .default(), edition: "2028"}
    check_bundle_with_effect_facts_for_build(&bundle, CompileMode.Run).0
}

// Rust: crates/jet-sema/tests/comptime_import_liveness.rs:64
pub fn lint_names(diagnostics: [Diagnostic]) -> [String] Never! {
    names := [String]{}
    loop diagnostic in diagnostics {
        if diagnostic.code != "L0103" -> continue
        if diagnostic.what.split('`').nth(1) == .Val(name) { names.push(name.to_string()) }
    }
    names
}
