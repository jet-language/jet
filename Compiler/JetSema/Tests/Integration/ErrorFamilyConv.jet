// Rust: crates/jet-sema/tests/error_family_conv.rs:1
// D-FAIL-CONV2=A: core error family converts into default Err on demand.
use jet_sema.Diagnostics.[Diagnostic, Severity]
use jet_sema.[Lexer, Parser]
use jet_sema.Sema.[check_bundle, CompileMode]
use jet_sema.Syntax as Syntax
use jet_sema.AST.[CFfi, LoadedModule, ProgramBundle, DevtoolsRegistry, NameLedger]
use jet_codegen.Codegen.MIREval.[install_mir_bridge]
use std.sync.[Once]
use std.collections.[HashSet]

// Rust: crates/jet-sema/tests/error_family_conv.rs:12
fn ensure_mir_bridge() Never! {
    // GATE #4494: canonical once-only initialization; installs the Jet evaluator.
    static INSTALL: Once = Once.new()
    INSTALL.call_once(fn() Never! { install_mir_bridge() })
}

// Rust: crates/jet-sema/tests/error_family_conv.rs:19
pub fn diags(src: String) -> [Diagnostic] Never! {
    ensure_mir_bridge()
    (toks, lex_diags) :: Lexer.lex(src)
    if !lex_diags.is_empty() -> return lex_diags
    prog := if Parser.parse(toks) == {
        .Ok(p) -> ^p
        .Err(ds) -> return ds
    }
    bundle := ProgramBundle{
        entry: 0, project_root: OSPath.from("."),
        modules: [LoadedModule]{LoadedModule{
            path: OSPath.from("test.jet"), display: "test.jet", alias: "main",
            imports: ^prog.imports, items: ^prog.items, script_body: ^prog.script_body,
            block_spans: ^prog.block_spans, source: src.to_string(), web_target_ceiling: prog.web_target_ceiling,
            pub_file: prog.pub_file, no_prelude: prog.no_prelude, default_target: prog.default_target,
            html_path: prog.html_path.clone(), policy_declarations: prog.policy_declarations.clone(),
            user_policy_declarations: prog.user_policy_declarations.clone(), rule_facts: ^prog.rule_facts}},
        devtools_registry: DevtoolsRegistry.default(), parse_teaching: [], used_core: HashSet[String].new(),
        ffi_callback_fns: HashSet[String].new(), cffi: CFfi.default(), comptime_inputs: [], name_ledger: NameLedger.default(),
        layer_ceiling: None, inferred_layer: Syntax.RuntimeLayer.Core, web_partitions: [:], web_partition_enforced: false,
        web_partition_report: None, dep_roots: [:], package_guarantees: .default(), program_allocator: .default(),
        active_os: Syntax.OSTarget.host(), build_facts: .default(), edition: "2027"}
    errors := [Diagnostic]{}
    loop d in check_bundle(&bundle, CompileMode.Run) { if d.severity == Severity.Error { errors.push(^d) } }
    errors
}
