// MustUse diagnostics exercise the real lexer/parser/sema pipeline.
use jet_sema.Diagnostics.[Diagnostic, Severity]
use jet_sema.[Lexer, Parser]
use jet_sema.Sema.[check_bundle, CompileMode]
use jet_sema.Syntax as Syntax
use jet_sema.AST.[CFfi, LoadedModule, ProgramBundle, DevtoolsRegistry, NameLedger]
use std.collections.[HashSet]
// Rust: crates/jet-sema/tests/must_use.rs:12
fn err_codes(src: String) -> [String] {
    (toks, lex_diags) :: Lexer.lex(src)
    if !lex_diags.is_empty() -> return lex_diags.map(fn(d) { d.code }).to_array()
    prog := if Parser.parse(toks) == {
        .Ok(p) -> p
        .Err(ds) -> return ds.map(fn(d) { d.code }).to_array()
    }
    bundle := ProgramBundle{entry: 0, project_root: OSPath.from("."),
        modules: [LoadedModule{path: OSPath.from("test.jet"), display: "test.jet", alias: "main",
            imports: ^prog.imports, items: ^prog.items, script_body: ^prog.script_body, block_spans: ^prog.block_spans, source: src,
            web_target_ceiling: prog.web_target_ceiling, pub_file: prog.pub_file, no_prelude: prog.no_prelude,
            default_target: prog.default_target, html_path: ^prog.html_path, policy_declarations: ^prog.policy_declarations,
            user_policy_declarations: ^prog.user_policy_declarations, rule_facts: ^prog.rule_facts}],
        devtools_registry: DevtoolsRegistry.default(), parse_teaching: [], used_core: HashSet[String].new(), ffi_callback_fns: HashSet[String].new(),
        cffi: CFfi.default(), comptime_inputs: [], name_ledger: NameLedger.default(), layer_ceiling: None, inferred_layer: Syntax.RuntimeLayer.Core,
        web_partitions: [:], web_partition_enforced: false, web_partition_report: None, dep_roots: [:], package_guarantees: .default(),
        program_allocator: .default(), active_os: Syntax.OSTarget.host(), build_facts: .default(), edition: "2027"}
    check_bundle(&bundle, CompileMode.Eval).filter(fn(d: Diagnostic) { d.severity == Severity.Error }).map(fn(d) { d.code }).to_array()
}
// Rust: crates/jet-sema/tests/must_use.rs:69
#Test("top_level_impl_method_keeps_owned_generic_scope") {
    codes :: err_codes("\nstruct Counter { value: Int }\n\nimpl Counter {\n    fn identity<T>(value: ^T) -> T {\n        return value\n    }\n}\n\nfn run() {}\n")
    assert(codes.is_empty(), "unexpected errors: {codes:?}")
}
// Rust: crates/jet-sema/tests/must_use.rs:87
#Test("must_use_fn_ignored_is_e0419") {
    src :: "\n#MustUse fn ticket() -> Int {\n    return 1\n}\nfn run() {\n    ticket()\n}\n"
    codes :: err_codes(src)
    assert(codes.any(fn(c) { c == "E0419" }), "expected E0419, got {codes:?}")
}
// Rust: crates/jet-sema/tests/must_use.rs:105
#Test("must_use_type_ignored_is_e0419") {
    src :: "\n#MustUse struct Receipt {\n    id: Int\n}\nfn issue() -> Receipt {\n    return Receipt.{ id: 1 }\n}\nfn run() {\n    issue()\n}\n"
    codes :: err_codes(src)
    assert(codes.any(fn(c) { c == "E0419" }), "expected E0419, got {codes:?}")
}
// Rust: crates/jet-sema/tests/must_use.rs:126
#Test("must_use_drop_suppresses_e0419") {
    src :: "\n#MustUse fn ping() -> Int {\n    return 1\n}\nfn run() {\n    ping().drop(\"telemetry only\")\n}\n"
    codes :: err_codes(src)
    assert(!codes.any(fn(c) { c == "E0419" }), "drop should silence E0419, got {codes:?}")
}
// Rust: crates/jet-sema/tests/must_use.rs:144
#Test("must_use_enum_ignored_is_e0419") {
    src :: "\n#MustUse enum Ticket {\n    Open\n    Closed\n}\nfn issue() -> Ticket {\n    return Ticket.Open\n}\nfn run() {\n    issue()\n}\n"
    codes :: err_codes(src)
    assert(codes.any(fn(c) { c == "E0419" }), "expected E0419, got {codes:?}")
}
// Rust: crates/jet-sema/tests/must_use.rs:166
#Test("must_use_bound_value_ok") {
    src :: "\n#MustUse struct Token { id: Int }\n#MustUse fn mint(id: Int) -> Token {\n    return Token.{ id: id }\n}\nfn run() {\n    t := mint(1)\n    print(t.id)\n}\n"
    codes :: err_codes(src)
    assert(codes.is_empty(), "expected clean compile, got {codes:?}")
}
