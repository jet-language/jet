use jet_foundation.[AccessConvention, EffectRowEntry, Expr, Func, Item, Measure, NamedSpan, Param, ParamZone, Program, Span, Type, TypeParam, UnitDimensionDecl, UnitFamilyDef, UnitFamilyMember, UnitRatio, UnitScaleProvenance, ViewProvenance, ViewProvenanceEntry, ViewProvenanceMap, ViewSource, ViewSourcePath, ViewSourceProjection, ast_func, dimension_base, dimension_divide, foundation_embedded_core, foundation_member_name, jet_target_machine_hosted]
use jet_parser.[parse_source]
use jet_sema.[API_SNAPSHOT_VERSION, APIFreezeError, APIProjection, APISnapshot, APIUnitDimensions, FrozenFn, SemaBuildFacts, SemaRegistrationHostHooks, SemaRegistrationModuleInput, SemaSourceOrigin, api_snapshot_capability_digest, api_snapshot_parse, api_snapshot_write, canonical_api_type_name, canonical_type_params, collect_api_unit_dimensions, fn_signature, fn_signature_with_effects, legacy_api_name, legacy_api_signature, normalized_public_effect_row, sema_collect_comptime_declarations, sema_finalize_registration_graph, sema_public_api_from_checked, sema_registration_prepare_graph, signature_without_effect_row, snapshot_from_items, snapshot_from_items_with_effects]
use core.files.host.retained_descriptor as api_test_native
use core.files.runtime.kernel_path_components as api_test_path

// Original Rust ApiFreeze.rs tests use canonical AST carriers, not text mocks.
fn api_test_zero() -> Span Never! { Span{start: 0, end: 0} }
fn api_test_param(name: String, convention: AccessConvention, ty: Type) -> Param Never! {
    Param{convention: convention, root: false, name: name, name_span: api_test_zero(), public_label: None, zone: ParamZone.Either, ty: ty, ty_span: api_test_zero(), default: None, variadic: false, variadic_bound_list: None, declared_view_from_names: None}
}
fn api_test_function(name: String, public: Bool, params: [Param], ret: Type?) -> Func Never! {
    function := ast_func(name, api_test_zero(), api_test_zero())
    function.is_pub = public
    function.params = params
    function.return_type = ret
    function
}
fn api_test_parse(raw: String) -> APISnapshot Never! {
    if api_snapshot_parse(raw) == {
        .Ok(snapshot) -> return snapshot
        .Err(error) -> panic(error.message)
    }
}
fn api_test_source(source: String) -> Program Never! {
    parsed :: parse_source(source.bytes())
    assert(parsed.diagnostics.len() == 0, "API fixture must parse")
    parsed.program
}
fn api_test_view(index: Int) -> ViewSourcePath Never! { ViewSourcePath{source: ViewSource.Parameter{index: index}, projections: [ViewSourceProjection]{ViewSourceProjection.Range}} }
fn api_test_view_function(name: String, entries: [ViewProvenanceEntry]) -> Func Never! {
    function := api_test_function(name, true, [Param]{api_test_param("left", AccessConvention.Read, Type.List{element: Type.Int}), api_test_param("right", AccessConvention.Read, Type.List{element: Type.Int})}, Val(Type.Apply{name: "View", args: [Type]{Type.Int}}))
    function.return_view_provenance = Val(ViewProvenanceMap{entries: entries})
    function
}
fn api_test_view_entry(slot: [String], sources: [ViewSourcePath]) -> ViewProvenanceEntry Never! { ViewProvenanceEntry{slot: slot, value: ViewProvenance{sources: sources, mutable: false}} }
fn api_test_view_snapshot(index: Int) -> APISnapshot Never! {
    function :: api_test_view_function("pick", [ViewProvenanceEntry]{api_test_view_entry([String]{}, [ViewSourcePath]{api_test_view(index)})})
    snapshot_from_items([Item]{Item.Func{value: function}}, "views", "1.0.0")
}

#Test("sig_carries_resolved_sigil") {
    function :: api_test_function("scale", true, [Param]{api_test_param("v", AccessConvention.Write, Type.Named{name: "Vec3"}), api_test_param("factor", AccessConvention.Read, Type.Float)}, None)
    assert(fn_signature(function) == "fn scale(v: &Vec3, factor: Float)")
}
#Test("sig_carries_normalized_inferred_effects") {
    function :: api_test_function("load", true, [Param]{}, Val(Type.String))
    assert(fn_signature_with_effects(function, Val([String]{"IO", "FS.Read", "IO"})) == "fn load() String -[FS.Read, IO]>")
    assert(fn_signature_with_effects(function, Val([String]{})) == "fn load() String -[]>")
}
#Test("canonical_api_types_use_prefix_roles_in_alias_and_function_type_shapes") {
    // The frozen test's old prefix expectations are superseded by the actual
    // frozen source's D-TYPE-SUFFIX1=A implementation (ApiFreeze.rs179-200).
    dimensions :: APIUnitDimensions{identities: [String:String]{}}
    fallible :: Type.Result{ok: Type.Option{inner: Type.Int}, err: Type.Union{members: [Type]{Type.Named{name: "DbError"}, Type.Named{name: "TimeoutError"}}}}
    assert(canonical_api_type_name(fallible, dimensions) == "Int? (DbError | TimeoutError)!")
    callback :: Type.Fn{params: [Type]{fallible}, ret: Val(Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "IOError"}}), effect_bound: Val([EffectRowEntry]{}), param_contract: None, call_metadata: None, return_view_provenance: None}
    assert(canonical_api_type_name(callback, dimensions) == "fn(Int? (DbError | TimeoutError)!) IOError! -[]>")
}
#Test("inline_module_snapshot_uses_mangled_effect_identity") {
    program :: api_test_source("module files {{ pub fn load() -> String {{ \"loaded\" }} }}")
    key :: "main::{foundation_member_name("files", "load")}"
    solved := [String:[String]]{}
    solved[key] = [String]{"FS.Read"}
    snapshot :: snapshot_from_items_with_effects(program.items, "files", "1.0.0", Val(solved), Val("main"))
    assert(snapshot.api_version == API_SNAPSHOT_VERSION)
    assert(snapshot.funcs[0].name == "files.load")
    assert(snapshot.funcs[0].signature == "fn files.load() String -[FS.Read]>")
    assert(api_test_parse(api_snapshot_write(snapshot)).funcs[0].name == "files.load")
}
#Test("pre_v3_comparison_normalizes_added_metadata_and_type_glosses") {
    assert(signature_without_effect_row("fn load() String -[FS.Read, IO]>") == "fn load() String")
    assert(signature_without_effect_row("fn load(path: String) =[FS.Read, IO]=> String") == "fn load(path: String) -> String")
    assert(signature_without_effect_row("fn flush() =[]=>") == "fn flush()")
    assert(signature_without_effect_row("fn legacy() -> Int") == "fn legacy() -> Int")
    assert(legacy_api_name("files.load") == "load")
    assert(legacy_api_signature("fn files.load() =[FS.Read]=> String") == "fn load() -> String")
    assert(legacy_api_signature("fn report(x: Int (a whole number))") == "fn report(x: Int)")
    assert(signature_without_effect_row("fn malformed() -[FS.Read") == "fn malformed() -[FS.Read")
    assert(signature_without_effect_row("fn f() -[]> ; view_source = static:m::x") == "fn f() ; view_source = static:m::x")
}
#Test("sig_carries_normalized_physical_dimension_identity") {
    dimension :: dimension_divide(dimension_base("api::Length"), dimension_base("api::Time")) ?? panic("speed dimension must combine")
    quantity :: Type.Quantity{base: Type.Float, dimension: dimension}
    function :: api_test_function("pace", true, [Param]{api_test_param("value", AccessConvention.Read, quantity)}, Val(quantity))
    expected :: "fn pace(value: Quantity<Length * Time^-1, Float; api%3A%3ALength:1;api%3A%3ATime:-1>) Quantity<Length * Time^-1, Float; api%3A%3ALength:1;api%3A%3ATime:-1>"
    assert(fn_signature(function) == expected)
}
#Test("checked_source_unit_signature_carries_dimension_identity") {
    family :: UnitFamilyDef{is_pub: true, is_package_pub: false, family: "Length", family_span: api_test_zero(), dimension: Val(UnitDimensionDecl.Base{span: api_test_zero()}), resolved_dimension: Val(dimension_base("api::Length")), resolved_owner: Val("api"), base: None, members: [UnitFamilyMember]{UnitFamilyMember{name: "meter", name_span: api_test_zero(), scale: UnitRatio{numerator: 1, denominator: 1}, scale_provenance: UnitScaleProvenance.Rational, offset: UnitRatio{numerator: 0, denominator: 1}}}, span: api_test_zero()}
    snapshot :: snapshot_from_items([Item]{Item.UnitFamily{value: family}, Item.Func{value: api_test_function("distance", true, [Param]{}, Val(Type.Named{name: "Meter"}))}}, "physics", "1.0.0")
    expected :: "fn distance() Meter{{family=Length; base=Float; dimension=api%3A%3ALength:1}}"
    assert(snapshot.funcs[0].signature == expected)
    assert(snapshot.api_version == U32{2})
}
#Test("sig_carries_parameter_view_provenance") {
    function :: api_test_view_function("first", [ViewProvenanceEntry]{api_test_view_entry([String]{}, [ViewSourcePath]{api_test_view(0)})})
    assert(fn_signature(function).contains("view_source = parameter:0;access:read;path:range"))
}
#Test("returned_view_source_round_trips_and_changes_contract") {
    left :: api_test_view_snapshot(0)
    right :: api_test_view_snapshot(1)
    assert(api_test_parse(api_snapshot_write(left)) == left)
    assert(api_test_parse(api_snapshot_write(right)) == right)
    assert(api_snapshot_capability_digest(left) != api_snapshot_capability_digest(right))
    assert(left.funcs[0].signature.contains("view_source = parameter:0"))
    assert(right.funcs[0].signature.contains("view_source = parameter:1"))
}
#Test("aggregate_view_sources_round_trip_and_change_contract") {
    distinct_function :: api_test_view_function("pair", [ViewProvenanceEntry]{api_test_view_entry([String]{"right"}, [ViewSourcePath]{api_test_view(1)}), api_test_view_entry([String]{"left"}, [ViewSourcePath]{api_test_view(0)})})
    changed_function :: api_test_view_function("pair", [ViewProvenanceEntry]{api_test_view_entry([String]{"right"}, [ViewSourcePath]{api_test_view(0)}), api_test_view_entry([String]{"left"}, [ViewSourcePath]{api_test_view(0)})})
    distinct :: snapshot_from_items([Item]{Item.Func{value: distinct_function}}, "views", "1.0.0")
    changed :: snapshot_from_items([Item]{Item.Func{value: changed_function}}, "views", "1.0.0")
    assert(api_test_parse(api_snapshot_write(distinct)) == distinct)
    assert(api_snapshot_capability_digest(distinct) != api_snapshot_capability_digest(changed))
    assert(distinct.funcs[0].signature.contains("view_sources = left=parameter:0;access:read;path:range|right=parameter:1;access:read;path:range"))
}
#Test("source_union_is_public_and_identity_bearing") {
    single :: api_test_view_snapshot(0)
    canonical :: api_test_view_function("pick", [ViewProvenanceEntry]{api_test_view_entry([String]{}, [ViewSourcePath]{api_test_view(1), api_test_view(0)})})
    union :: snapshot_from_items([Item]{Item.Func{value: canonical}}, "views", "1.0.0")
    assert(api_snapshot_capability_digest(single) != api_snapshot_capability_digest(union))
    assert(union.funcs[0].signature.contains("view_source = one_of(parameter:0;path:range,parameter:1;path:range);access:read"))
}
#Test("round_trip") {
    program :: api_test_source("pub fn scale(v: &Int) {{}}\npub fn length(v: Int) -> Float {{ 0.0 }}\nfn helper() {{}}\npub fn _unstable() {{}}")
    snapshot :: snapshot_from_items(program.items, "mathkit", "1.0.0")
    assert(snapshot.funcs.len() == 2)
    parsed :: api_test_parse(api_snapshot_write(snapshot))
    assert(parsed == snapshot)
    assert(parsed.funcs[0].name == "length")
    assert(parsed.funcs[1].name == "scale")
}
#Test("digest_ignores_version") {
    items :: [Item]{Item.Func{value: api_test_function("scale", true, [Param]{api_test_param("v", AccessConvention.Write, Type.Named{name: "Vec3"})}, None)}}
    assert(api_snapshot_capability_digest(snapshot_from_items(items, "mathkit", "1.0.0")) == api_snapshot_capability_digest(snapshot_from_items(items, "mathkit", "2.5.9")))
}
#Test("digest_shifts_on_capability_change") {
    read :: snapshot_from_items([Item]{Item.Func{value: api_test_function("scale", true, [Param]{api_test_param("v", AccessConvention.Read, Type.Named{name: "Vec3"})}, None)}}, "mathkit", "1.0.0")
    write :: snapshot_from_items([Item]{Item.Func{value: api_test_function("scale", true, [Param]{api_test_param("v", AccessConvention.Write, Type.Named{name: "Vec3"})}, None)}}, "mathkit", "1.0.0")
    assert(api_snapshot_capability_digest(read) != api_snapshot_capability_digest(write))
}
#Test("parse_known_text") {
    snapshot :: api_test_parse("api_version = 1\npackage = mk\npublished_version = 0.1.0\nfn f(x: &Int)\n")
    assert(snapshot.package == "mk")
    assert(snapshot.funcs.len() == 1)
    assert(snapshot.funcs[0].name == "f")
    assert(snapshot.funcs[0].signature == "fn f(x: &Int)")
}
#Test("snapshot parser exact errors and non-sorting") {
    cases :: [String:String]{"": "missing api_version", "api_version = 3": "missing package", "api_version = 3\npackage = p": "missing published_version", "api_version = -1": "invalid api_version: -1", "api_version = 4294967296": "invalid api_version: 4294967296", "api_version = 3\nstruct X {{}}": "unknown line in api snapshot: struct X {{}}", "fn ()": "malformed fn line: fn ()"}
    loop (source, expected) in cases {
        if api_snapshot_parse(source) == {
            .Err(error) -> assert(error.message == expected)
            .Ok(_) -> assert(false, "malformed snapshot accepted")
        }
    }
    cr :: String.from_bytes([U8]{13}) ?? panic("ASCII carriage return must decode")
    snapshot :: api_test_parse("api_version = +3{cr}\npackage = first\npackage = final\npublished_version = 1\nfn z()\nfn a()\n")
    assert(snapshot.package == "final")
    assert(snapshot.funcs[0].name == "z")
    assert(api_snapshot_capability_digest(snapshot) == "fn a()\nfn z()")
}
#Test("symbolic effects generic bounds and Never metadata") {
    function := api_test_function("invoke", true, [Param]{}, Val(Type.Result{ok: Type.Named{name: "Never"}, err: Type.Named{name: "Stop"}}))
    function.type_params = [TypeParam]{TypeParam{name: "T", name_span: api_test_zero(), bounds: [String]{"Show", "Copy"}}, TypeParam{name: "U", name_span: api_test_zero(), bounds: [String]{}}}
    function.declared_effects = Val([EffectRowEntry]{EffectRowEntry{name: "..E", span: api_test_zero()}, EffectRowEntry{name: "!Net", span: api_test_zero()}, EffectRowEntry{name: "FS", span: api_test_zero()}})
    function.effect_via = Val(NamedSpan{name: "callback", span: api_test_zero()})
    assert(normalized_public_effect_row(function, [String]{"IO"}) == [String]{"!Net", "..E", "IO", "via callback"})
    assert(fn_signature_with_effects(function, Val([String]{})).ends_with(" ; never_declared = true ; never_inferred = false"))
    function.diverges = true
    assert(fn_signature(function).ends_with(" ; never_declared = true ; never_inferred = true"))
    assert(canonical_type_params(function.type_params) == "<T: [Show, Copy], U>")
}

fn api_test_family(family: String, member: String) -> UnitFamilyDef Never! {
    UnitFamilyDef{is_pub: true, is_package_pub: false, family: family, family_span: api_test_zero(), dimension: Val(UnitDimensionDecl.Base{span: api_test_zero()}), resolved_dimension: None, resolved_owner: None, base: None, members: [UnitFamilyMember]{UnitFamilyMember{name: member, name_span: api_test_zero(), scale: UnitRatio{numerator: 1, denominator: 1}, scale_provenance: UnitScaleProvenance.Rational, offset: UnitRatio{numerator: 0, denominator: 1}}}, span: api_test_zero()}
}
#Test("scaled affine units preserve package scale offset and provenance") {
    family := api_test_family("Temperature", "celsius")
    family.base = Val(NamedSpan{name: "kelvin", span: api_test_zero()})
    family.resolved_owner = Val("not-the-publish-package")
    family.members[0].scale = UnitRatio{numerator: 5, denominator: 9}
    family.members[0].offset = UnitRatio{numerator: 27315, denominator: 100}
    family.members[0].scale_provenance = UnitScaleProvenance.Conventional{value: "5/9", source: "standard"}
    dimensions := APIUnitDimensions{identities: [String:String]{}}
    collect_api_unit_dimensions([Item]{Item.UnitFamily{value: family}}, "physics", &dimensions)
    point :: dimensions.identities.get("CelsiusPoint") ?? panic("point identity missing")
    delta :: dimensions.identities.get("CelsiusDelta") ?? panic("delta identity missing")
    assert(point.contains("package=physics; family=Temperature; base=Kelvin"))
    assert(point.contains("dimension=physics%3A%3ATemperature:1; scale=5/9; provenance=Conventional(5/9;standard); offset=27315/100"))
    assert(delta.ends_with("offset=0}}"))
    family.resolved_owner = Val("core.units")
    family.members[0].scale_provenance = UnitScaleProvenance.Measured{central_value: "1.2", standard_uncertainty: "0.1", source: "lab"}
    collect_api_unit_dimensions([Item]{Item.UnitFamily{value: family}}, "physics", &dimensions)
    identity :: dimensions.identities.get("CelsiusPoint") ?? panic("point identity missing")
    assert(identity.contains("package=core.units;"))
    assert(identity.contains("provenance=Measured(1.2;0.1;lab)"))
}
#Test("forward derived dimensions and symbolic scale provenance") {
    speed := api_test_family("Speed", "meters_per_second")
    speed.dimension = Val(UnitDimensionDecl.Derived{expr: Expr.Binary{op: .Div, left: Expr.Ident{name: "Length", span: api_test_zero()}, right: Expr.Ident{name: "Time", span: api_test_zero()}, span: api_test_zero()}})
    length :: api_test_family("Length", "meter")
    time :: api_test_family("Time", "second")
    angle := api_test_family("Angle", "degree")
    angle.dimension = None
    angle.base = Val(NamedSpan{name: "radian", span: api_test_zero()})
    angle.members[0].scale_provenance = UnitScaleProvenance.SymbolicPi{numerator: UnitRatio{numerator: 1, denominator: 1}, denominator: UnitRatio{numerator: 180, denominator: 1}}
    dimensions := APIUnitDimensions{identities: [String:String]{}}
    collect_api_unit_dimensions([Item]{Item.UnitFamily{value: speed}, Item.UnitFamily{value: length}, Item.UnitFamily{value: time}, Item.UnitFamily{value: angle}}, "physics", &dimensions)
    identity :: dimensions.identities.get("MetersPerSecond") ?? panic("derived identity missing")
    expected :: "{{family=Speed; base=Float; dimension=physics%3A%3ALength:1;physics%3A%3ATime:-1}}"
    assert(identity == expected)
    angular :: dimensions.identities.get("Degree") ?? panic("scaled identity missing")
    assert(angular.contains("base=Radian; scale=1; provenance=SymbolicPi(1/180); offset=0"))
}

#Test("canonical type recursion and all access sigils") {
    dimensions := APIUnitDimensions{identities: [String:String]{}}
    dimensions.identities["Meter"] = "{{identity}}"
    // Typed data carrier, not a unit parser or alternate identity generator.
    nominal :: Type.Named{name: "Meter"}
    assert(canonical_api_type_name(Type.List{element: nominal}, dimensions) == "[Meter{{identity}}]")
    assert(canonical_api_type_name(Type.Shared{inner: nominal}, dimensions) == "Shared<Meter{{identity}}>")
    assert(canonical_api_type_name(Type.Apply{name: "Ptr", args: [Type]{nominal}}, dimensions) == "*Meter{{identity}}")
    assert(canonical_api_type_name(Type.FixedList{elem: nominal, len: Measure.Literal{kind: "length", value: 4}}, dimensions) == "[Meter{{identity}}#4]")
    function :: api_test_function("roles", true, [Param]{api_test_param("read", AccessConvention.Read, Type.Int), api_test_param("write", AccessConvention.Write, Type.Int), api_test_param("move", AccessConvention.Move, Type.Int), api_test_param("raw", AccessConvention.Read, Type.Apply{name: "Ptr", args: [Type]{Type.Int}})}, None)
    assert(fn_signature(function) == "fn roles(read: Int, write: &Int, move: ^Int, raw: *Int)")
}

// Main-ratified fn_name_of tandem fix; retain every signature byte.
#Test("generic FrozenFn names roundtrip without generic signature suffix") {
    function := api_test_function("choose", true, [Param]{}, None)
    function.type_params = [TypeParam]{TypeParam{name: "T", name_span: api_test_zero(), bounds: [String]{"Show"}}}
    snapshot :: snapshot_from_items([Item]{Item.Func{value: function}}, "generic", "1.0.0")
    parsed :: api_test_parse(api_snapshot_write(snapshot))
    assert(parsed.funcs[0].name == "choose")
    assert(parsed.funcs[0].signature == "fn choose<T: Show>()")
    assert(parsed == snapshot)
}

// Real-source integrated witness: genuine registration + body/effect finalization,
// actual embedded Prelude effect declarations, and retained authored entry items.
// No fake checker, graph, name ledger, or effect inference implementation.
fn api_test_module(program: ^Program, identity: String, path: String, package: String) -> SemaRegistrationModuleInput Never! {
    SemaRegistrationModuleInput{package_identity: package, module_identity: identity, module_name: identity, module_path: path, source_file: path, source_segments: [], source_origin: SemaSourceOrigin.Snapshot, program: program, foreign_handles: []}
}
fn api_test_checked(source: String) -[Env, FS]> APIProjection Never! {
    original :: api_test_source(source)
    effects :: api_test_source(foundation_embedded_core().effect_source())
    inputs :: [SemaRegistrationModuleInput]{api_test_module(^original, "main", "api.jet", "api"), api_test_module(^effects, "effects", "Prelude/Effects.jet", "jet:canonical-prelude")}
    build :: SemaBuildFacts{package_name: "api", package_version: "1.0.0", os: "linux", profile: "test", stamp_git: None, stamp_dirty: false, stamp_toolchain: "api-test", stamp_at: "", artifact_build: false}
    hooks :: shared SemaRegistrationHostHooks{numeric_unit_conversion_exact: None, typed_boundary_literal_validate: None}
    registration :: sema_registration_prepare_graph(inputs, [], "api", "main", "effects", [], jet_target_machine_hosted("x86_64-unknown-linux-gnu", "1.0.0"), build, hooks)
    stage :: sema_collect_comptime_declarations(registration, [], None)
    project_root :: api_test_native.canonicalize(api_test_path.from_text(".", api_test_path.PathPlatform.Unix)) ?? panic("API fixture requires its actual working directory")
    checked :: sema_finalize_registration_graph(registration, stage, [], [], None, None, project_root)
    assert(checked.diagnostics.len() == 0, "real API fixture must check")
    assert(checked.complete, "real API fixture requires complete checked facts")
    // Borrow retained actual input nesting beside the lowered checked graph.
    sema_public_api_from_checked(inputs[0].program.items, registration, checked, "api", "1.0.0")
}
#Test("all public item kinds ordering visibility and inline modules") {
    projection :: api_test_checked("pub struct Zed {{ value: Int, _hidden: String }}\npub enum Kind {{ A, B, _Hidden }}\npub trait Reader {{ fn read(value: Int) -[]> Int }}\nanswer :: 42\nmodule nested {{ pub fn alpha(value: Int) -> Int {{ value }} pub struct Data {{ count: Int }} }}\nfn private() {{}}\npub fn _soft() {{}}\npub fn zeta() {{}}")
    names :: loop item in projection.items -> "{item.kind}:{item.name}"
    assert(names == [String]{"enum:Kind", "fn:Reader.read", "fn:nested.alpha", "fn:zeta", "struct:Zed", "struct:nested.Data", "trait:Reader"})
    assert(projection.items[0].signature == "enum Kind {{ A, B }}")
    assert(projection.items[4].signature == "struct Zed {{ value: Int }}")
    assert(projection.items[5].signature == "struct Data {{ count: Int }}")
    assert(projection.items[6].signature == "trait Reader {{ fn Reader.read(value: Int) Int -[]> }}")
    assert(projection.snapshot.funcs[0].name == "Reader.read")
    assert(projection.snapshot.funcs[1].name == "nested.alpha")
    assert(projection.snapshot.funcs[1].signature == "fn nested.alpha(value: Int) Int -[]>")
    assert(projection.snapshot.funcs[2].name == "zeta")
    assert(projection.snapshot.api_version == API_SNAPSHOT_VERSION)
}
#Test("CLI public field positional flag and typed-default shape") {
    projection :: api_test_checked("#CLI\npub struct Args {{ input: String, count: Int, port: Int{{3000}}, optional: String?, verbose: Bool, #Flag output: String, _hidden: Int }}")
    expected :: "struct Args {{ input: String [positional 0]; count: Int [positional 1]; port: Int; optional: String?; verbose: Bool; output: String [flag] }}"
    assert(projection.items.len() == 1)
    assert(projection.items[0].signature == expected)
}

// #4445: the canonical Sema BodyCheck fixed point must stamp Func.diverges.
// Keep this real-source acceptance witness; never infer the bit from ret type.
#Test("checked inferred Never remains independent of declared Never") {
    projection :: api_test_checked("pub fn forever() {{ loop {{}} }}")
    assert(projection.snapshot.funcs[0].signature.ends_with(" ; never_declared = false ; never_inferred = true"))
}
