// The generated `#CLI` entry names its core.args functions by role. While
// the compiler builds, each role CLIEntry.jet calls is matched to the function
// whose `#Builtin.Role(.X)` marker names it, and a role nothing fills stops
// the build with a refusal that names the role.
use jet_sema.[SEMA_CLI_ROLES, sema_cli_role_fillers, sema_cli_roles_called, sema_cli_roles_missing, sema_cli_roles_refusal]

#Test("a role marker names the core.args function that fills it") {
    ^roles: sema_cli_roles_called("sema_cli_call(\"CLIValue\") sema_cli_call(\"CLIArgv\")")
    sema_cli_role_fillers("use {{\n    builtin: jet_builtins\n}}\n\n#Builtin.Role(.CLIValue) priv __cli_value: fn(parsed: CLIParsed, name: String) -> String? Never! {{\n    None\n}}\n\n#Builtin.Role(.CLIArgv) __cli_argv: fn() -[Exec.Args]> [String] Never! {{ rt.argv() }}\n\n#Builtin.Role(.CLIExit) __cli_exit: fn() -> Int {{ 1 }}\n\ncli_unmarked: fn() -> Int {{ 1 }}\n", roles)
    assert_eq(roles.len(), 2)
    assert_eq(roles[0].filler, "__cli_value")
    assert_eq(roles[1].filler, "__cli_argv")
}

#Test("the roles a source calls are read once each, in first-call order") {
    called: sema_cli_roles_called("a: \"x\" b: sema_cli_call(\"CLIValue\") c: sema_cli_call(\"CLIArgv\") d: sema_cli_call(\"CLIValue\")")
    assert_eq(called.len(), 2)
    assert_eq(called[0].role, "CLIValue")
    assert_eq(called[1].role, "CLIArgv")
    assert_eq(called[0].filler, "")
}

// SEMA_CLI_ROLES is read while the compiler builds, from CLIEntry.jet and
// Core/Args/Args.jet (a test reads no file of its own at run time).
#Test("every CLI role the generated entry calls has a core.args function") {
    assert_eq(SEMA_CLI_ROLES.len(), 35)
    assert_eq(sema_cli_roles_missing(SEMA_CLI_ROLES), "")
}

#Test("a called role that no core.args function fills stops the build, naming the role") {
    ^roles: sema_cli_roles_called("sema_cli_call(\"CLIValue\") sema_cli_call(\"CLIArgv\")")
    sema_cli_role_fillers("#Builtin.Role(.CLIValue) priv __cli_value: fn() -> Int {{ 1 }}\n", roles)
    missing: sema_cli_roles_missing(roles)
    assert_eq(missing, "CLIArgv")
    refusal: sema_cli_roles_refusal(missing)
    assert(refusal.starts_with("Core/Args/Args.jet has no function for the CLI roles the generated `#CLI` entry calls: CLIArgv."))
    assert(refusal.contains("`#Builtin.Role(.X)`"))
}
