// The plans of a Core module's grammars, as the Core library's check records
// them in its bodies file (CoreBodies.jet sema_core_grammar_capture,
// sema_core_module_bodies), read back as the plans the batch computes: a
// compile bound to that Core registers the module's grammars from the
// record (sema_core_grammar_plans) as it registers them from computed plans.
use {
    jet_sema.[
        SEMA_CORE_GRAMMAR_KEY,
        SemaBuildFacts,
        SemaCoreBodies,
        SemaCoreBody,
        SemaDeriveCapture,
        SemaForeignProviderInput,
        SemaRegistrationForeignHandleFacts,
        SemaRegistrationGraph,
        SemaRegistrationHostHooks,
        SemaRegistrationImportEdge,
        SemaRegistrationModuleInput,
        SemaSourceOrigin,
        SemaSourceSegment,
        sema_core_bodies_bytes,
        sema_core_bodies_problem,
        sema_core_bodies_read,
        sema_core_grammar_capture,
        sema_core_grammar_plans,
        sema_core_module_bodies,
        sema_has_error_since,
        sema_host_hook_access,
        sema_marker_module_canonical_registry,
        sema_marker_rules_validate_repeatability,
        sema_registration_prepare_graph,
    ]
    jet_parser.[parse_source]
    jet_driver.[jet_driver_canonical_effect_module]
    jet_foundation.[
        CtEnumArg,
        CtValue,
        Diagnostic,
        ModuleTable,
        NamedCtValue,
        Span,
        compiler_threads_single,
        effect_vocabulary_module,
        jet_target_machine_hosted,
        module_intern,
        module_table,
    ]
}

// The module the fixture records, as a Core module.
GRAMMAR_RECORD_MODULE: "<corelib>/grammar-record"

// A module declaring the grammar `Pair`, whose plan grammar_record_plans
// gives.
GRAMMAR_RECORD_SOURCE: "Pair: Grammar{{\"\"\"\n    pair : key=WORD '=' value=WORD ;\n    WORD : [a-z]+ ;\n    \"\"\"}}\n"

// A text field of a generated type, as core.grammar describes one.
priv grammar_record_field: fn(name: String) -> CtValue {
    CtValue.Struct{type_name: "GrammarField", fields: [NamedCtValue]{
        NamedCtValue{name: "name", value: CtValue.Str{value: name}},
        NamedCtValue{name: "kind", value: CtValue.Enum{type_name: "GrammarFieldKind", variant: "Text", args: [CtEnumArg]{}}},
        NamedCtValue{name: "rule", value: CtValue.Int{value: -1}},
        NamedCtValue{name: "optional", value: CtValue.Bool{value: false}},
        NamedCtValue{name: "list", value: CtValue.Bool{value: false}},
    }}
}

// A token kind of the plan, no hole.
priv grammar_record_token: fn() -> CtValue {
    CtValue.Struct{type_name: "GrammarToken", fields: [NamedCtValue]{NamedCtValue{name: "hole", value: CtValue.Str{value: ""}}}}
}

// The plans of GRAMMAR_RECORD_SOURCE's grammar, by binding name: the rule
// `pair` as the struct `Pair` and three token kinds.
priv grammar_record_plans: fn() -> [NamedCtValue] {
    shape: CtValue.Struct{type_name: "GrammarShape", fields: [NamedCtValue]{
        NamedCtValue{name: "rule", value: CtValue.Int{value: 0}},
        NamedCtValue{name: "name", value: CtValue.Str{value: "Pair"}},
        NamedCtValue{name: "is_enum", value: CtValue.Bool{value: false}},
        NamedCtValue{name: "fields", value: CtValue.List{values: [CtValue]{grammar_record_field("key"), grammar_record_field("value")}}},
        NamedCtValue{name: "cases", value: CtValue.List{values: [CtValue]{}}},
    }}
    kinds: [CtValue]{CtValue.Str{value: "Eof"}, CtValue.Str{value: "Word"}, CtValue.Str{value: "Equals"}}
    tokens: [CtValue]{grammar_record_token(), grammar_record_token(), grammar_record_token()}
    plan: CtValue.Struct{type_name: "GrammarPlan", fields: [NamedCtValue]{
        NamedCtValue{name: "shapes", value: CtValue.List{values: [CtValue]{shape}}},
        NamedCtValue{name: "kind_names", value: CtValue.List{values: kinds}},
        NamedCtValue{name: "tokens", value: CtValue.List{values: tokens}},
    }}
    [NamedCtValue]{NamedCtValue{name: "Pair", value: plan}}
}

// The bodies file of `bodies`, read back whole.
priv grammar_record_file: fn(bodies: ^^[SemaCoreBody]) -> SemaCoreBodies {
    bytes: sema_core_bodies_bytes(bodies.move(), "grammar-record")
    if sema_core_bodies_problem(bytes) == .Val(problem) {
        panic("GrammarRecord: the bodies file does not read back: {problem}")
    }
    sema_core_bodies_read(bytes) ?? panic("GrammarRecord: the bodies file has no header")
}

// The host hooks lending a bodies file of `bodies`.
priv grammar_record_hooks: fn(bodies: ^^[SemaCoreBody]) -> Shared<SemaRegistrationHostHooks> {
    Shared{SemaRegistrationHostHooks{numeric_unit_conversion_exact: None, core_bodies: Val(grammar_record_file(bodies.move()))}}
}

// The one record of `plans`, keyed for GRAMMAR_RECORD_MODULE.
priv grammar_record_body: fn(plans: [NamedCtValue]) -> SemaCoreBody {
    ^captures: [SemaDeriveCapture]{}
    sema_core_grammar_capture(plans, captures)
    if captures.len() != 1 -> panic("GrammarRecord: the plans made {captures.len()} records")
    capture: captures.pop() ?? panic("GrammarRecord: the plans made no record")
    SemaCoreBody{key: "{SEMA_CORE_GRAMMAR_KEY}{GRAMMAR_RECORD_MODULE}", bytes: capture.bytes.move(), symbols: [String]{}, decls: [String]{}, modules: [String]{}, strings: capture.strings.move()}
}

#Test("a grammar record read back from a bodies file gives the plans it was made from") {
    plans: grammar_record_plans()
    hooks: grammar_record_hooks([SemaCoreBody]{grammar_record_body(plans)})
    ^table: module_table()
    recorded: module_intern(table, GRAMMAR_RECORD_MODULE)
    read: sema_core_grammar_plans(sema_host_hook_access(hooks), table, recorded) ?? panic("GrammarRecord: the module has no plans")
    assert_eq("{read:Debug}", "{plans:Debug}")
    assert(hooks.guard_read().value.core_bodies_read > 0)
    assert_eq(hooks.guard_read().value.core_bodies_unread.len(), 0)
}

#Test("a module without plans makes no grammar record") {
    ^captures: [SemaDeriveCapture]{}
    sema_core_grammar_capture([NamedCtValue]{}, captures)
    assert_eq(captures.len(), 0)
}

#Test("a module with no grammar record reads no plans") {
    hooks: grammar_record_hooks([SemaCoreBody]{grammar_record_body(grammar_record_plans())})
    ^table: module_table()
    other: module_intern(table, "<corelib>/grammar-other")
    assert(sema_core_grammar_plans(sema_host_hook_access(hooks), table, other) == None)
    assert(sema_core_grammar_plans(None, table, other) == None)
    assert_eq(hooks.guard_read().value.core_bodies_unread.len(), 0)
}

// A grammar record that does not read is jet's own defect: the module reads
// no plans, so the batch computes them, and the record is a census row
// (CoreBodies.jet sema_core_bodies_unread).
#Test("a grammar record that does not read gives no plans and is counted") {
    key: "{SEMA_CORE_GRAMMAR_KEY}{GRAMMAR_RECORD_MODULE}"
    hooks: grammar_record_hooks([SemaCoreBody]{SemaCoreBody{key: key, bytes: [U8]{1, 2, 3}, symbols: [String]{}, decls: [String]{}, modules: [String]{}, strings: [String]{}}})
    ^table: module_table()
    recorded: module_intern(table, GRAMMAR_RECORD_MODULE)
    assert(sema_core_grammar_plans(sema_host_hook_access(hooks), table, recorded) == None)
    assert_eq(hooks.guard_read().value.core_bodies_unread.len(), 1)
}

// The registration graph of GRAMMAR_RECORD_SOURCE as Core module
// GRAMMAR_RECORD_MODULE, beside the canonical effect module, handed `plans`:
// recording each module's grammar plans with `capture`.
priv grammar_record_graph: fn(plans: ^^[NamedCtValue], capture: Bool) -> SemaRegistrationGraph {
    parsed: parse_source(GRAMMAR_RECORD_SOURCE.bytes())
    if sema_has_error_since(parsed.diagnostics, 0) {
        panic("GrammarRecord: the source does not parse: {parsed.diagnostics:Debug}")
    }
    ^table: module_table()
    main_id: module_intern(table, GRAMMAR_RECORD_MODULE)
    canonical: jet_driver_canonical_effect_module(effect_vocabulary_module("IO: struct {{\n    impl Effect {{}}\n}}\n"), table) ?? panic("GrammarRecord: the canonical effect module declares no effects")
    canonical_id: canonical.module_identity
    facts: SemaBuildFacts{package_name: "grammar-record", package_version: "0.1.0", os: "linux", profile: "dev", stamp_git: None, stamp_dirty: false, stamp_toolchain: "fixture", stamp_at: ""}
    segment: SemaSourceSegment{generated: Span{start: 0, end: GRAMMAR_RECORD_SOURCE.len()}, source_file: "main.jet", source_start: 0, line_starts: [Int]{0}, origin: SemaSourceOrigin.Snapshot}
    input: SemaRegistrationModuleInput{package_identity: "core", module_identity: main_id, module_name: "main", core_source_alias: "", module_path: "main.jet", source_file: "main.jet", source_segments: [SemaSourceSegment]{segment}, source_origin: SemaSourceOrigin.Snapshot, program: parsed.program, foreign_handles: [SemaRegistrationForeignHandleFacts]{}, source: GRAMMAR_RECORD_SOURCE, grammar_plans: plans.move()}
    sema_registration_prepare_graph([SemaRegistrationModuleInput]{input, canonical}, [SemaRegistrationImportEdge]{}, "core", main_id, canonical_id, table.move(), [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), facts, false, compiler_threads_single(), capture_derives: capture)
}

#Test("a Core module registered with its recorded grammar plans registers as one handed them") {
    plans: grammar_record_plans()
    ^captured: grammar_record_graph(grammar_record_plans(), true)
    ^bodies: [SemaCoreBody]{}
    sema_core_module_bodies(captured, bodies)
    ^grammar_records: 0
    loop body in bodies {
        if body.key.starts_with(SEMA_CORE_GRAMMAR_KEY) -> grammar_records += 1
    }
    assert_eq(grammar_records, 1)
    hooks: grammar_record_hooks(bodies.move())
    ^table: module_table()
    recorded: module_intern(table, GRAMMAR_RECORD_MODULE)
    read: sema_core_grammar_plans(sema_host_hook_access(hooks), table, recorded) ?? panic("GrammarRecord: the module's record reads no plans")
    assert_eq("{read:Debug}", "{plans:Debug}")
    loaded: grammar_record_graph(read.move(), false)
    handed: grammar_record_graph(plans.move(), false)
    assert_eq(loaded.modules.len(), handed.modules.len())
    ^failures: [String]{}
    loop (position, row) in handed.modules {
        taken: loaded.modules[position]
        if "{taken.program.items:Debug}" != "{row.program.items:Debug}" {
            failures.push("{row.module_name}: the items differ")
        }
        if "{taken.symbols:Debug}" != "{row.symbols:Debug}" {
            failures.push("{row.module_name}: the symbols differ")
        }
        if row.module_name == "main" && !"{row.program.items:Debug}".contains("PairRule") {
            failures.push("main: the grammar made no `PairRule`")
        }
    }
    if "{loaded.diagnostics:Debug}" != "{handed.diagnostics:Debug}" {
        failures.push("the diagnostics differ")
    }
    assert_eq(failures, [String]{})
}

#Test("generated Rule and Token #Layout enums sharing a span pass repeatability while one enum with two #Layout markers still fails E0999") {
    handed: grammar_record_graph(grammar_record_plans(), false)
    registry: sema_marker_module_canonical_registry() ?? panic("no canonical marker registry")
    ^grammar_diags: [Diagnostic]{}
    loop row in handed.modules {
        if row.module_name == "main" {
            sema_marker_rules_validate_repeatability(registry, row.program, grammar_diags)
        }
    }
    assert_eq(grammar_diags.len(), 0)
    repeated: parse_source("#Layout(U8)\n#Layout(U16)\nColor: enum {{ Red, Green }}\n".bytes())
    ^repeated_diags: [Diagnostic]{}
    sema_marker_rules_validate_repeatability(registry, repeated.program, repeated_diags)
    assert_eq(repeated_diags.len(), 1)
    assert_eq(repeated_diags[0].code, "E0999")
}
