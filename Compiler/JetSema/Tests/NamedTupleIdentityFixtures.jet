// Core registry tuples meet parsed signatures in canonical field order.
fn line_from_raw() -[IO, Time.Wait]> (cause: String?, eof: Bool, line: String) Never! {
    core.term.__terminal8_line()
}
// The tuple must normalize even when nested under an optional container.
fn size_from_raw() -[IO, Time.Wait]> (h: Int, w: Int)? Never! {
    core.term.__terminal8_stty()
}
fn line_from_source() -> (cause: String?, eof: Bool, line: String) {
    (eof: false, line: "", cause: None)
}
fn run() {}
