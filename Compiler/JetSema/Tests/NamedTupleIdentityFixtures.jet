// Inspect the real registry metadata without invoking Core-private leaves.
use jet_foundation.[core_platform_fixed_signature, type_identity_equal, Type, TypeTupleField]

named_tuple_identity_registry_return: fn(module_name: String, member: String) -> Type Never! {
    signature: core_platform_fixed_signature(module_name, member) ?? panic("missing tuple signature")
    signature.return_type ?? panic("tuple signature has no return type")
}

named_tuple_identity_line_from_source: fn() -> (cause: String?, eof: Bool, line: String) {
    (eof: false, line: "", cause: None)
}

named_tuple_identity_fixture: fn() {
    sample_type: Type.Tuple{fields: [TypeTupleField]{
        {name: "before_epoch", ty: Type.Bool},
        {name: "nanoseconds", ty: Type.Int},
        {name: "seconds", ty: Type.Int},
    }}
    rules_type: Type.Tuple{fields: [TypeTupleField]{
        {name: "cause", ty: Type.Option{inner: Type.String}},
        {name: "code", ty: Type.Option{inner: Type.Int}},
        {name: "kind", ty: Type.Int},
    }}
    assert(type_identity_equal(named_tuple_identity_registry_return("core.net.tls", "__host_wall_sample"), sample_type))
    assert(type_identity_equal(named_tuple_identity_registry_return("core.files", "__walk_rules"), rules_type))
    line: named_tuple_identity_line_from_source()
    assert(!line.eof && line.line == "" && line.cause == None)
}
