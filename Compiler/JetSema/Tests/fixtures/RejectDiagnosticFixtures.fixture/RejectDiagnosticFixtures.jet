// #4696: checked rejection keeps its registered diagnostic.
RejectedType: struct {
    impl Diagnostic {
        code: "E0927"
        what: fn(self) -> String { "the rule rejected this type" }
        why: fn(self) -> String { "the test rule is deliberately strict" }
        fix: fn(self) -> String { "remove the marker" }
    }
}

Rejects: struct {
    impl Marker {
        sites: [.Type]

        expand: fn(self, target: Target) {
            reject(RejectedType{})
        }
    }
}

#Rejects
Person: struct { id: Int }

#Test("reject_diagnostic_fixtures") {}
