// #4696: checked rejection keeps its registered diagnostic.
struct RejectedType {
    impl Diagnostic {
        code :: "E0927"
        fn what(self) -> String { "the rule rejected this type" }
        fn why(self) -> String { "the test rule is deliberately strict" }
        fn fix(self) -> String { "remove the marker" }
    }
}

struct Rejects {
    impl Marker {
        sites :: [.Type]

        fn expand(self, target: Target) {
            reject(RejectedType{})
        }
    }
}

#Rejects
struct Person { id: Int }

#Test("reject_diagnostic_fixtures") {}
