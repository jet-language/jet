// #4696: checked rejection keeps its registered diagnostic.
struct Rejects {
    impl Marker {
        sites :: [.Type]

        fn expand(self, target: Target) {
            reject(
                code: "E0927",
                what: "the rule rejected this type",
                why: "the test rule is deliberately strict",
                fix: "remove the marker"
            )
        }
    }
}

#Rejects
struct Person { id: Int }

#Test("reject_diagnostic_fixtures") {}
