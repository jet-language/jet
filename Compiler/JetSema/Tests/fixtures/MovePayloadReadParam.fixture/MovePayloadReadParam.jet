// `p.move()` of a payload of a read parameter has no storage to give up: E0201,
// never a silent copy.
Slot: enum {
    Full(items: [Int])
    Empty
}

keep: fn(items: &&[Int]) -> Int { items.len() }

forward: fn(slot: Slot) -> Int {
    if slot == .Full(items) -> return keep(items.move())
    0
}

run: fn() { print(forward(Slot.Full{items: [Int]{1}})) }
