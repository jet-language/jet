// `^p` of an owned subject's payload moves it; the subject's other fields
// stay usable.
enum Slot {
    Full(items: [Int], label: String)
    Empty
}

struct Holder {
    slot: Slot
    name: String
}

fn keep(items: ^[Int]) -> Int { items.len() }

fn take_items(holder: ^Holder) -> Int {
    total := 0
    if holder.slot == .Full(items, label) {
        total = keep(^items) + label.len()
    }
    total + holder.name.len()
}

fn run() { print(take_items(Holder{slot: Slot.Full{items: [Int]{1}, label: "a"}, name: "h"})) }
