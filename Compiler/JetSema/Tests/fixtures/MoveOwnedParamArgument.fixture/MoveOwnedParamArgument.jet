// An owned parameter, a local or a field of one (`.move()`) passed to a take
// parameter moves: no diagnostic.
Bag: struct {
    items: [String]
}

keep: fn(bag: &&Bag) -> Int { bag.items.len() }

count: fn(items: &&[String]) -> Int { items.len() }

forward: fn(bag: &&Bag) -> Int {
    keep(bag)
}

fields: fn(bag: &&Bag) -> Int {
    count(bag.items.move())
}

collect: fn(item: &&[Int]) -> Int {
    rows := [[Int]]{}
    rows.push(item)
    rows.len()
}

run: fn() {
    local: Bag{items: [String]{"one"}}
    print(forward(local))
    print(fields(Bag{items: [String]{"two"}}))
    print(collect([Int]{1}))
}
