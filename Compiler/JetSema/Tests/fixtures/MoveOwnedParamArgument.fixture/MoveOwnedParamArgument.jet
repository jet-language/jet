// `^` on an owned parameter, a local and a field of one moves: no diagnostic.
Bag: struct {
    items: [String]
}

keep: fn(bag: ^Bag) -> Int { bag.items.len() }

count: fn(items: ^[String]) -> Int { items.len() }

forward: fn(bag: ^Bag) -> Int {
    keep(^bag)
}

fields: fn(bag: ^Bag) -> Int {
    count(^bag.items)
}

collect: fn(item: ^[Int]) -> Int {
    rows := [[Int]]{}
    &rows.push(^item)
    rows.len()
}

run: fn() {
    local: Bag{items: [String]{"one"}}
    print(forward(^local))
    print(fields(Bag{items: [String]{"two"}}))
    print(collect([Int]{1}))
}
