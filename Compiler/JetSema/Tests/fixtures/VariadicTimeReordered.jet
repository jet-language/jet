// #4894 fixed-slot cutover must not reject bound time-method labels.
fn checked_round(value: LocalTime) {
    _ := value.round(rounding_mode: "trunc", increment: 2, unit: "hour")
    _ := value.round(unit: "minute")
}
fn count(parts: ...String) -> Int { parts.len() }
fn run() { _ := count("one", "two") }
