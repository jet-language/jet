// `p.move()` of an owned subject's payload moves it; the subject's other fields
// stay usable.
Slot: enum {
    Full(items: [Int], label: String)
    Empty
}

Holder: struct {
    slot: Slot
    name: String
}

keep: fn(items: &&[Int]) -> Int { items.len() }

take_items: fn(holder: &&Holder) -> Int {
    total := 0
    if holder.slot == .Full(items, label) {
        total = keep(items.move()) + label.len()
    }
    total + holder.name.len()
}

run: fn() { print(take_items(Holder{slot: Slot.Full{items: [Int]{1}, label: "a"}, name: "h"})) }
