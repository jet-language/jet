// #4894: checked element carriers, not native label/type guessing.
unions: fn(parts: ...(Int | String)) -> Int { parts.len() }
rows: fn(parts: ...([Int])) -> Int {
    total := 0
    loop row in parts -> total += row.len()
    total
}
StaticCounter: struct {
    count: fn(parts: ...String) -> Int { parts.len() }
}
Counter: trait {
    count: fn(self, parts: ...String) -> Int
}
CounterImpl: struct {
    impl Counter {
        count: fn(self, parts: ...String) -> Int { parts.len() }
    }
}
dynamic_count: fn(counter: Counter) -> Int { counter.count("one", "two") }
trait_rows: fn(parts: ...([Counter])) -> Int { parts.len() }
run: fn() {
    union_tail: [Int | String]{2, "three"}
    print(unions(1, ...union_tail, "four"))
    fixed: [Int#2]{1, 2}
    print(rows(fixed, [Int]{3}))
    print(fixed.len())
    lists: [[Int]]{[Int]{4}, [Int]{5, 6}}
    print(rows([Int]{0}, ...lists))
    print(StaticCounter.count("one", "two"))
    print(dynamic_count(CounterImpl{}))
    print(trait_rows([Counter]{CounterImpl{}}, [Counter]{CounterImpl{}}))
}
