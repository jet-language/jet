// `p.move()` takes the payload out of its subject: the subject is partially moved,
// so reading it whole afterwards is E0121.
Slot: enum {
    Full(items: [Int])
    Empty
}

keep: fn(items: &&[Int]) -> Int { items.len() }

reuse: fn(slot: &&Slot) -> Int {
    total := 0
    if slot == .Full(items) -> total = keep(items.move())
    if slot == .Full(again) -> total += again.len()
    total
}

run: fn() { print(reuse(Slot.Full{items: [Int]{1}})) }
