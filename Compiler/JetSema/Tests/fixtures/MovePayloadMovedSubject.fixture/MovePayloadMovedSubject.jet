// `p.move()` of a payload bound from a moved subject (`subject.move() == .V(p)`): the
// subject moved into the match, so `p` owns its payload and `p.move()` is an
// ordinary move of a local, never a take out of a subject that stays live.
Def: struct {
    name: String
    marked: Bool
}

Item: enum {
    Struct(value: Def)
    Other
}

drain: fn(source: &&[Item]) -> Int {
    items := source.move()
    marked := 0
    out := [Item]{}
    loop items.len() > 0 {
        item := items.pop() ?? panic("drain lost a row")
        if item.move() == .Struct(source_definition) {
            definition := source_definition.move()
            if definition.name == "Err" {
                definition.marked = true
                marked += 1
            }
            out.push(Item.Struct{value: definition.move()})
        }
    }
    marked + out.len()
}

run: fn() { print(drain([Item]{Item.Struct{value: Def{name: "Err", marked: false}}, Item.Other})) }
