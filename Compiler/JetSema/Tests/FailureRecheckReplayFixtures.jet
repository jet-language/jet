// Assembled with the production bootstrap inventory by run-gate-fixtures.mjs.
// D1 (SPEED-500K §8.2): the failure-union recheck checks again only the
// bodies a projected contract can change and replays every other retained
// body of the module. The fixture module projects three unannotated
// functions (`parse_age` and `find_person` mint their own error types,
// `age_of` joins them), has one caller that depends on the join
// (`describe`), and pads the module with bodies that name none of them, a
// method, and a view-returning summary function. The checked products must
// be the same for any thread count, keep every body exactly once, and carry
// the inferred-union diagnostic the full module recheck reported.
fn recheck_replay_require(ok: Bool, message: String) Never! {
    if !ok -> panic("FailureRecheckReplayFixtures: {message}")
}

fn recheck_replay_source(missing_case: Bool) -> String Never! {
    unrelated := [String]{}
    loop index in 0..<8 {
        padding := [U8]{}
        loop _ in 0..<(6144 + index * 1024) -> &padding.push(U8{120})
        comment :: String.from_bytes(padding) ?? panic("ASCII padding is not UTF-8")
        &unrelated.push("fn unrelated_{index}(value: Int) -> Int Never! {{\n//{comment}\nvalue + {index}\n}}\n")
    }
    arms :: if missing_case -> ".Err(.NotFound(_)) -> \"no such person\"" else -> ".Err(.NotFound(_)) -> \"no such person\"\n.Err(.ParseAgeError(_)) -> \"bad age\""
    "fn parse_age(raw: String) -> Int {{\nif raw == \"\" -> return Err(.BadNumber(raw.copy()))\n42\n}}\nfn find_person(book: [String:String], name: String) -> String {{\nif book.has_key(name) -> return book[name]\nErr(.NotFound(name.copy()))\n}}\nfn age_of(book: [String:String], name: String) -> Int {{\nraw :: find_person(book, name)\nparse_age(raw)\n}}\nfn describe(book: [String:String], name: String) -> String {{\nif age_of(book, name) == {{\n.Ok(n) -> \"age {{n}}\"\n{arms}\n}}\n}}\n{unrelated.join("")}struct Counter {{ value: Int\nfn bump(&self) -> Int Never! {{ self.value + 1 }}\nfn window(&self, values: [Int]) -> View<Int> {{ first(values) }}\n}}\nfn first(values: [Int]) -> View<Int> {{ values[0..<1] }}\nfn run() {{\nprint(describe([\"ada\": \"36\"], \"zed\"))\n}}\n"
}

fn recheck_replay_registration(source: String) -> SemaRegistrationGraph {
    parsed := parse_source(source.bytes())
    recheck_replay_require(parsed.diagnostics.len() == 0, "real fixture source parses")
    canonical := jet_driver_canonical_effect_module("effect IO\n") ?? panic("fixture effect declaration does not parse")
    line_starts := [Int]{0}
    bytes :: source.bytes()
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{10}) -> &line_starts.push(index + 1)
    }
    segment :: SemaSourceSegment{generated: Span{start: 0, end: bytes.len()}, source_file: "recheck-replay.jet", source_start: 0, line_starts: line_starts, origin: SemaSourceOrigin.Snapshot}
    input :: SemaRegistrationModuleInput{package_identity: "recheck-replay", module_identity: "recheck-replay::main", module_name: "main", core_source_alias: "", module_path: "main.jet", source_file: "recheck-replay.jet", source_segments: [SemaSourceSegment]{segment}, source_origin: SemaSourceOrigin.Snapshot, program: parsed.program, foreign_handles: [SemaRegistrationForeignHandleFacts]{}, source: source}
    canonical_identity :: canonical.module_identity
    facts :: SemaBuildFacts{package_name: "recheck-replay", package_version: "0.1.0", os: "linux", profile: "dev", stamp_git: None, stamp_dirty: false, stamp_toolchain: "fixture", stamp_at: ""}
    graph := sema_registration_prepare_graph([SemaRegistrationModuleInput]{input, canonical}, [SemaRegistrationImportEdge]{}, "recheck-replay", "recheck-replay::main", canonical_identity, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), facts, false)
    recheck_replay_require(graph.complete && graph.internal_problem == None, "registration is complete")
    graph
}

fn recheck_replay_checked(graph: SemaRegistrationGraph, threads: CompilerThreads) -> SemaGraphResult {
    hooks :: shared SemaRegistrationHostHooks{numeric_unit_conversion_exact: None, typed_boundary_literal_validate: None}
    stage := sema_collect_comptime_declarations(graph, [SemaRegistrationPackagePolicy]{}, hooks, threads, None)
    sema_finalize_registration_graph(graph, None, ^stage, [SemaComptimeItemValue]{}, [SemaComptimeFunctionResult]{}, hooks, threads, None, None)
}

// The module's checked functions by name, each exactly once: a replayed body
// is appended at its turn like a checked one, never twice and never dropped.
fn recheck_replay_function_names(checked: SemaGraphResult) -> [String:Int] Never! {
    names := [String:Int]{}
    loop module_result in checked.modules {
        if module_result.module_identity != "recheck-replay::main" -> next
        loop function in module_result.functions -> names[function.name] = (names.get(function.name) ?? 0) + 1
        loop record in module_result.bodies -> recheck_replay_require(record.after.functions >= record.before.functions && record.after.diagnostics >= record.before.diagnostics, "every body record marks the rows it appended")
    }
    names
}

fn recheck_replay_case(missing_case: Bool) {
    source :: recheck_replay_source(missing_case)
    graph :: recheck_replay_registration(source)
    serial :: recheck_replay_checked(graph, compiler_threads_single())
    parallel :: recheck_replay_checked(graph, CompilerThreads{cap: Val(2), cores: 2, memory_available: Val(268435456)})
    recheck_replay_require("{serial:Debug}" == "{parallel:Debug}", "the replayed recheck has byte-identical products for any thread count")
    recheck_replay_require(serial.complete == !missing_case, "the recheck's verdict is the inferred-union verdict")
    missing := 0
    loop diagnostic in serial.diagnostics {
        if diagnostic.code == "E0307" && diagnostic.what.contains("Err(.ParseAgeError(_))") -> missing += 1
    }
    recheck_replay_require(missing == (if missing_case -> 1 else -> 0), "the dependent caller is checked again against the projected union")
    names :: recheck_replay_function_names(serial)
    expected :: [String]{"parse_age", "find_person", "age_of", "describe", "unrelated_0", "unrelated_1", "unrelated_2", "unrelated_3", "unrelated_4", "unrelated_5", "unrelated_6", "unrelated_7", "bump", "window", "first", "run"}
    loop name in expected {
        // A body whose check reported the missing arm may not record a function.
        if missing_case && name == "describe" -> next
        recheck_replay_require((names.get(name) ?? 0) == 1, "checked function `{name}` is present exactly once")
    }
    projected := 0
    loop module_result in serial.modules {
        loop function in module_result.functions {
            if function.name != "age_of" -> next
            if function.ret == .Val(.Result(_, err)) {
                shown :: type_name(err)
                recheck_replay_require(shown.contains("FindPersonError") && shown.contains("ParseAgeError"), "the projected function's body is checked again against its joined contract")
                projected += 1
            }
        }
    }
    recheck_replay_require(projected == 1, "the joined contract is projected onto the checked function")
}

fn run() {
    recheck_replay_case(true)
    recheck_replay_case(false)
    print("failure recheck replay: dependent bodies checked again, other bodies replayed, products identical")
}
