// Production parser + registration graph + checker coverage for E0221 at the
// write that can close a strong `Shared` cycle: each fixture lists the written
// places it rejects. The cycle check reads the registration graph, so fixtures
// go through graph preparation and finalization, not the single-module checker.
use {
    jet_parser.[parse_source]
    jet_sema.[
        SemaBuildFacts, SemaComptimeFunctionResult, SemaComptimeItemValue, SemaForeignProviderInput,
        SemaRegistrationForeignHandleFacts, SemaRegistrationHostHooks, SemaRegistrationImportEdge,
        SemaRegistrationModuleInput, SemaRegistrationPackagePolicy, SemaSourceOrigin, SemaSourceSegment,
        sema_collect_comptime_declarations, sema_finalize_registration_graph, sema_registration_prepare_graph,
    ]
    jet_driver.[jet_driver_canonical_effect_module]
    jet_foundation.[DIAGNOSTIC_ERROR, Diagnostic, Span, compiler_threads_single, jet_target_machine_hosted]
}

shared_cycle_diagnostics: fn(failures: &[String], source: String) -> [Diagnostic]? {
    parsed := parse_source(source.bytes())
    if parsed.diagnostics.len() != 0 {
        failures.push("fixture does not parse: {source}")
        return None
    }
    effects: jet_driver_canonical_effect_module("IO: struct {{\n    impl Effect {{}}\n}}\nPanic: struct {{\n    impl Effect {{}}\n}}\n") ?? {
        failures.push("canonical effect source did not parse")
        return None
    }
    facts: SemaBuildFacts{package_name: "shared-cycle", package_version: "0.1.0", os: "linux", profile: "dev", stamp_git: None, stamp_dirty: false, stamp_toolchain: "fixture", stamp_at: ""}
    segment: SemaSourceSegment{generated: Span{start: 0, end: source.len()}, source_file: "main.jet", source_start: 0, line_starts: [Int]{0}, origin: SemaSourceOrigin.Snapshot}
    input: SemaRegistrationModuleInput{package_identity: "shared-cycle", module_identity: "shared-cycle::main", module_name: "main", core_source_alias: "", module_path: "main.jet", source_file: "main.jet", source_segments: [SemaSourceSegment]{segment}, source_origin: SemaSourceOrigin.Snapshot, program: parsed.program.move(), foreign_handles: [SemaRegistrationForeignHandleFacts]{}, source: source.copy()}
    graph := sema_registration_prepare_graph([SemaRegistrationModuleInput]{input, effects}, [SemaRegistrationImportEdge]{}, "shared-cycle", "shared-cycle::main", effects.module_identity, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), facts, false, compiler_threads_single()) ?? {
        failures.push("registration failed {err}: {source}")
        return None
    }
    hooks: shared SemaRegistrationHostHooks{numeric_unit_conversion_exact: None}
    // Declaration checking loans the graph to its stage, which returns it.
    stage := sema_collect_comptime_declarations(graph, [SemaRegistrationPackagePolicy]{}, compiler_threads_single(), None) ?? {
        failures.push("declaration checking failed {err}: {source}")
        return None
    }
    declared := stage.graph.move()
    stage.graph = None
    registration := declared.move() ?? {
        failures.push("the declaration pass lost its registration graph: {source}")
        return None
    }
    checked := sema_finalize_registration_graph(registration, None, stage, [SemaComptimeItemValue]{}, [SemaComptimeFunctionResult]{}, hooks, compiler_threads_single(), None, None) ?? {
        failures.push("finalization failed {err}: {source}")
        return None
    }
    Val(checked.diagnostics.move())
}

shared_cycle_expect: fn(failures: &[String], source: String, places: [String]) {
    diagnostics: shared_cycle_diagnostics(failures, source) ?? return
    found := [String]{}
    loop diagnostic in diagnostics {
        if diagnostic.severity != DIAGNOSTIC_ERROR -> next
        if diagnostic.code != "E0221" {
            failures.push("unexpected checker diagnostic {diagnostic.code}: {diagnostic.what} in {source}")
            next
        }
        span: diagnostic.span ?? {
            failures.push("E0221 has no place span in {source}")
            next
        }
        found.push(source.slice(span.start, span.end))
    }
    found.sort()
    wanted := places.copy()
    wanted.sort()
    if found != wanted -> failures.push("writes differ: found [{found.join(", ")}], wanted [{wanted.join(", ")}] in {source}")
}

SHARED_CYCLE_NODE: "Node: struct {{\nvalue: Int\nnext: Shared<Node>?\n}}\n"
SHARED_CYCLE_PERSON: "Person: struct {{\nname: String\nparent: Shared.Weak<Person>?\nkids: [Shared<Person>]\n}}\n"

#Test("shared_cycle_parity") {
    failures := [String]{}
    // Declaring strong self edges is fine; building by construction is too.
    shared_cycle_expect(failures, SHARED_CYCLE_NODE, [String]{})
    shared_cycle_expect(failures, "{SHARED_CYCLE_NODE}run: fn() {{\nhead := Shared<Node>?{{None}}\nloop value in 1..<5 {{\nhead = Val(shared Node{{value: value, next: head}})\n}}\n}}", [String]{})
    shared_cycle_expect(failures, "{SHARED_CYCLE_NODE}run: fn() {{\na: shared Node{{value: 1, next: None}}\na.next = Val(shared Node{{value: 2, next: None}})\n}}", [String]{})
    shared_cycle_expect(failures, "{SHARED_CYCLE_PERSON}run: fn() {{\nmum: shared Person{{name: \"Ada\", parent: None, kids: []}}\nkid: shared Person{{name: \"Byron\", parent: Val(mum.downgrade()), kids: []}}\nmum.kids.push(kid)\nmum.kids.push(shared Person{{name: \"Cy\", parent: Val(mum.downgrade()), kids: []}})\n}}", [String]{})
    // Storing a cell that already exists can close the loop.
    shared_cycle_expect(failures, "{SHARED_CYCLE_NODE}run: fn() {{\na: shared Node{{value: 1, next: None}}\nb: shared Node{{value: 2, next: None}}\na.next = Val(b)\nb.next = Val(a)\n}}", [String]{"b.next"})
    shared_cycle_expect(failures, "{SHARED_CYCLE_NODE}run: fn() {{\na: shared Node{{value: 1, next: None}}\na.next = Val(a)\n}}", [String]{"a.next"})
    shared_cycle_expect(failures, "{SHARED_CYCLE_NODE}run: fn() {{\na: shared Node{{value: 1, next: None}}\na.next = Val(shared Node{{value: 2, next: Val(a)}})\n}}", [String]{"a.next"})
    shared_cycle_expect(failures, "{SHARED_CYCLE_NODE}link: fn(a: Shared<Node>, b: Shared<Node>) {{\na.next = Val(b)\n}}", [String]{"a.next"})
    shared_cycle_expect(failures, "{SHARED_CYCLE_NODE}link: fn(a: Shared<Node>, b: Shared<Node>) {{\nguard: a.guard_edit()\nguard.value.next = Val(b)\n}}", [String]{"guard.value.next"})
    shared_cycle_expect(failures, "{SHARED_CYCLE_PERSON}run: fn() {{\nmum: shared Person{{name: \"Ada\", parent: None, kids: []}}\nkid: shared Person{{name: \"Byron\", parent: None, kids: []}}\nmum.kids.push(kid.copy())\nkid.kids.push(mum)\n}}", [String]{"kid.kids"})
    // A strong path through another type closes the loop too. The active-cycle
    // cut through Looping must not be memoized as negative: the later branch
    // from Branch reaches Owner.
    shared_cycle_expect(failures, "First: struct {{\nsecond: Shared<Second>?\n}}\nSecond: struct {{\nfirst: Shared<First>?\n}}\nrun: fn() {{\nf: shared First{{second: None}}\ns: shared Second{{first: Val(f)}}\nf.second = Val(s)\n}}", [String]{"f.second"})
    shared_cycle_expect(failures, "Owner: struct {{\nbranch: Shared<Branch>?\n}}\nBranch: struct {{\nlooping: Shared<Looping>?\nowner: Shared<Owner>?\n}}\nLooping: struct {{\nbranch: Shared<Branch>?\n}}\nrun: fn() {{\no: shared Owner{{branch: None}}\nb: shared Branch{{looping: None, owner: Val(o)}}\no.branch = Val(b)\n}}", [String]{"o.branch"})
    // A weak back-edge and an acyclic leaf never close a cycle.
    shared_cycle_expect(failures, "Leaf: struct {{\nvalue: Int\n}}\nHolder: struct {{\nleaf: Shared<Leaf>?\n}}\nfill: fn(h: Shared<Holder>, l: Shared<Leaf>) {{\nh.leaf = Val(l)\n}}", [String]{})
    shared_cycle_expect(failures, "Back: struct {{\nnext: Shared.Weak<Back>?\n}}\nlink: fn(a: Shared<Back>, b: Shared<Back>) {{\na.next = Val(b.downgrade())\n}}", [String]{})
    if failures.len() > 0 -> panic("SharedCycleParity collected {failures.len()} failures:\n{failures.join("\n")}")
}
