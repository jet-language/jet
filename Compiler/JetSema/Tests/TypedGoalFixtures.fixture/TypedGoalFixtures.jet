// Exercise the canonical checked goal type, not a CLI-owned inference.
fn typed_goal_expect(expected: Type?, wanted: Type, card: String) {
    span :: Span{start: 3, end: 7}
    rows := [TTypedGoal]{}
    goal :: sema_expression_todo(expected, span, &rows) ?? panic("goal was not checked")
    if goal.ty != wanted || goal.span != span -> panic("typed goal lost its type or source")
    if goal.kind != (TExprKind.Never{reason: "todo"}) -> panic("typed goal must diverge")
    if rows.len() != 1 || rows[0].span != span || rows[0].expected != card -> panic("typed goal lost its expected-type card")
}

fn run() {
    typed_goal_expect(None, Type.Int, "(unknown)")
    typed_goal_expect(Val(Type.String), Type.String, "String")
    typed_goal_expect(Val(Type.Int), Type.Int, "Int")
    print("typed goals: passed")
}
