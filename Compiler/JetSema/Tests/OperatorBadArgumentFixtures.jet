// An operator hook called with an unknown argument is refused with exactly
// one E0107 for the unknown name.
use {
    jet_driver.[JetDriverCompileMode, jet_driver_present_diagnostics]
    jet_cli.[jet_cli_compile_file]
    jet_foundation.[DIAGNOSTIC_ERROR]
}

#Test("operator_bad_argument_fixtures") {
    file: "Compiler/JetSema/Tests/fixtures/OperatorBadArgument.fixture/OperatorBadArgument.jet"
    checked: jet_cli_compile_file(file, false, None, JetDriverCompileMode.Program)
    if checked == {
        .Refused(refusal) -> panic("{file}: refused before checking: {refusal.stderr}")
        .Compiled(result, snapshot) -> {
            if result.internal_problem != None -> panic("{file}: internal compiler failure")
            codes := [String]{}
            loop diagnostic in jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files) {
                if diagnostic.severity == DIAGNOSTIC_ERROR -> codes.push(diagnostic.code.copy())
            }
            assert_eq(codes, [String]{"E0107"})
        }
    }
}
