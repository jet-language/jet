// The checked-body codecs (JetFoundation Facts/BodyCodec.jet and
// BodyCodecRows.jet, JetSema BodyPacketCodec.jet): every checked body of a
// program, and every packet built from its checked modules, reads back from
// the bytes its put wrote as it was, and writes the same bytes again; a read
// cut short fails and still ends.
use {
    jet_sema.[
        JET_CANONICAL_EFFECT_PACKAGE_IDENTITY, SemaBodyJob, SemaBuildFacts, SemaCallSiteFact, SemaComptimeBodySource, SemaComptimeFunctionResult, SemaComptimeItemValue,
        SemaComptimeRequest, SemaCopyEvent, SemaForeignProviderInput, SemaFunctionResult, SemaGraphModuleResult, SemaMethodInput,
        SemaNameReferenceFact, SemaParallelBody, SemaRegistrationForeignHandleFacts, SemaRegistrationHostHooks,
        SemaRegistrationImportEdge, SemaRegistrationModuleInput, SemaRegistrationPackagePolicy, SemaSourceOrigin,
        SemaGraphResult, SemaSourceSegment, body_codec_get_semaparallelbody, body_codec_put_semaparallelbody, sema_core_body_was_loaded, sema_core_bodies_read, sema_hardware_empty_use,
        sema_collect_comptime_declarations, sema_finalize_registration_graph, sema_has_error_since, sema_registration_prepare_graph,
    ]
    jet_parser.[parse_source]
    jet_driver.[jet_driver_canonical_effect_module]
    jet_foundation.[
        BodyCodecIn, DeclID, DeclRow, Diagnostic, FnBody, ModuleID, Span, SymbolID, SymbolKind, TFuncKind, TGenericParam, Type, body_codec_get_fnbody, body_codec_out, body_codec_put_fnbody,
        compiler_threads_single, effect_vocabulary_module, jet_target_machine_hosted, module_intern, module_table,
    ]
}

// A program whose bodies hold enums with payloads, matches, loops, options,
// generics, maps, string parts and a lambda that captures.
body_codec_source: fn() -> String {
    lines: [String]{
        "Shape: enum {{",
        "    Circle(radius: Float)",
        "    Rect(width: Int, height: Int)",
        "    Empty",
        "}}",
        "",
        "Point: struct {{",
        "    x: Int",
        "    y: Int",
        "}}",
        "",
        "area: fn(shape: Shape) -> Float {{",
        "    if shape == {{",
        "        .Circle(radius) -> radius * radius * 3.5",
        "        .Rect(width, height) -> 1.5 * 2.0",
        "        .Empty -> 0.0",
        "    }}",
        "}}",
        "",
        "first_even: fn(values: [Int]) -> Int? {{",
        "    loop value in values {{",
        "        if value % 2 == 0 -> return Val(value)",
        "    }}",
        "    None",
        "}}",
        "",
        "pair: fn<T>(left: T, right: T) -> [T] {{",
        "    [T]{{left, right}}",
        "}}",
        "",
        "totals: fn(points: [Point]) -> [String:Int] {{",
        "    sums := [String:Int]{{}}",
        "    loop point in points {{",
        "        key: if point.x > point.y -> \"x\" else -> \"y\"",
        "        sums[key] = (sums.get(key) ?? 0) + point.x + point.y",
        "    }}",
        "    sums",
        "}}",
        "",
        "apply: fn(values: [Int], f: fn(Int) -> Int) -> Int {{",
        "    total := 0",
        "    loop value in values -> total += f(value)",
        "    total",
        "}}",
        "",
        "run: fn() {{",
        "    points: [Point]{{Point{{x: 1, y: 2}}, Point{{x: 4, y: 3}}}}",
        "    shapes: [Shape]{{Shape.Circle{{radius: 1.5}}, Shape.Rect{{width: 2, height: 3}}, Shape.Empty}}",
        "    sum := 0.0",
        "    loop shape in shapes -> sum += area(shape)",
        "    even: first_even([Int]{{1, 3, 4}}) ?? 0",
        "    words: pair(\"a\", \"b\")",
        "    offset: 7",
        "    print(\"{{sum}} {{even}} {{words.len()}} {{totals(points).len()}} {{apply([Int]{{1, 2}}, fn(value: Int) {{ value + offset }})}}\")",
        "}}",
    }
    lines.join("\n")
}

// The check of body_codec_source() as module `main` of package `package`,
// with the canonical effect module, under the host hooks `hooks`. Under the
// canonical effect module's package `main` is a Prelude module. With no
// bodies file in `hooks` it is checked as the Core library's check checks
// it (SemaRegistrationGraph.core_seal), so its function checks are captured
// (CoreBodies.jet); with one, as a compile bound to the built-in Core is,
// which loads them.
body_codec_check: fn(failures: &[String], package: String, hooks: Shared<SemaRegistrationHostHooks>) -> SemaGraphResult? Err! {
    source: body_codec_source()
    threads: compiler_threads_single()
    parsed := parse_source(source.bytes())
    if sema_has_error_since(parsed.diagnostics, 0) {
        failures.push("source parsing failed: {parsed.diagnostics:Debug}")
        return None
    }
    table := module_table()
    main_id: module_intern(table, "body-codec::main")
    canonical: jet_driver_canonical_effect_module(effect_vocabulary_module("IO: struct {{\n    impl Effect {{}}\n}}\n"), table) ?? {
        failures.push("canonical effect module declares no effects")
        return None
    }
    canonical_id: canonical.module_identity
    facts: SemaBuildFacts{package_name: "body-codec", package_version: "0.1.0", os: "linux", profile: "dev", stamp_git: None, stamp_dirty: false, stamp_toolchain: "fixture", stamp_at: ""}
    segment: SemaSourceSegment{generated: Span{start: 0, end: source.len()}, source_file: "main.jet", source_start: 0, line_starts: [Int]{0}, origin: SemaSourceOrigin.Snapshot}
    input: SemaRegistrationModuleInput{package_identity: package, module_identity: main_id, module_name: "main", core_source_alias: "", module_path: "main.jet", source_file: "main.jet", source_segments: [SemaSourceSegment]{segment}, source_origin: SemaSourceOrigin.Snapshot, program: parsed.program, foreign_handles: [SemaRegistrationForeignHandleFacts]{}, source: source}
    graph := sema_registration_prepare_graph([SemaRegistrationModuleInput]{input, canonical}, [SemaRegistrationImportEdge]{}, package, main_id, canonical_id, table, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), facts, false, threads) ?? {
        failures.push("registration failed: {err}")
        return None
    }
    loading: hooks.guard_read().value.core_bodies != None
    graph.core_seal = package == JET_CANONICAL_EFFECT_PACKAGE_IDENTITY && !loading
    // Declaration checking loans the graph to its stage, which returns it.
    stage := sema_collect_comptime_declarations(graph, [SemaRegistrationPackagePolicy]{}, threads, None)
    declared := stage.graph.move()
    stage.graph = None
    graph = declared.move() ?? {
        failures.push("the declaration pass lost its registration graph")
        return None
    }
    checked := sema_finalize_registration_graph(graph, None, stage, [SemaComptimeItemValue]{}, [SemaComptimeFunctionResult]{}, hooks, threads, None)
    if !checked.complete {
        failures.push("checking failed {checked.diagnostics:Debug}")
        return None
    }
    Val(checked.move())
}

// The checked modules of body_codec_source(), with the canonical effect
// module's.
body_codec_modules: fn(failures: &[String]) -> [SemaGraphModuleResult] {
    checked := body_codec_check(failures, "body-codec", body_codec_hooks()) ?? return [SemaGraphModuleResult]{}
    checked.modules.move()
}

// Host hooks with no callbacks and no bodies file.
body_codec_hooks: fn() -> Shared<SemaRegistrationHostHooks> {
    Shared{SemaRegistrationHostHooks{numeric_unit_conversion_exact: None}}
}

// The checked functions of body_codec_source(), every module's.
body_codec_functions: fn(failures: &[String]) -> [FnBody] {
    functions := [FnBody]{}
    loop module_row in body_codec_modules(failures) {
        loop function in module_row.functions.move() -> functions.push(function.move())
    }
    functions
}

// A method input with a value in every field.
body_codec_method_input: fn() -> SemaMethodInput {
    SemaMethodInput{job: SemaBodyJob.NominalMethod{ordinal: 1, nominal_index: 0, method_index: 2}, memory_position: Val(3), diagnostics: [Diagnostic]{}, generic_params: [TGenericParam]{}, normalized_owner_type: Type.Int, function_kind: TFuncKind.TopLevel, memory_found: true, memory_complete: true, owner_generic_complete: true}
}

// One packet per checked function of body_codec_source(), with its compute
// and failure facts; the first also carries a method input.
body_codec_packets: fn(failures: &[String]) -> [SemaParallelBody] {
    packets := [SemaParallelBody]{}
    loop module_row in body_codec_modules(failures) {
        row := module_row.move()
        // The module's facts go with its last function; each move is refilled
        // empty, so the rest of its packets hold empty lists.
        loop row.functions.len() > 0 {
            function: row.functions.pop() ?? break
            compute: row.compute_facts.pop() ?? break
            result: SemaFunctionResult{value: Val(function.move()), complete: row.complete, exact_int_reachable: row.exact_int_reachable, copy_events: row.copy_events.move(), hardware_use: row.hardware_use.move(), comptime_body_sources: row.comptime_body_sources.move(), compute_facts: compute.move(), failure: row.failure_facts.pop(), incomplete_reasons: row.incomplete_reasons.move()}
            packets.push(SemaParallelBody{job_index: packets.len(), checked: Val(result.move()), diagnostics: row.diagnostics.move(), call_facts: row.call_facts.move(), comptime_requests: row.comptime_requests.move(), name_references: row.name_references.move(), method_input: if packets.len() == 0 -> Val(body_codec_method_input()) else -> None, wanted_hooks: false, memory_position: Val(packets.len()), memory_known: true})
            row.copy_events = [SemaCopyEvent]{}
            row.hardware_use = sema_hardware_empty_use()
            row.comptime_body_sources = [SemaComptimeBodySource]{}
            row.incomplete_reasons = [String]{}
            row.diagnostics = [Diagnostic]{}
            row.call_facts = [SemaCallSiteFact]{}
            row.comptime_requests = [SemaComptimeRequest]{}
            row.name_references = [SemaNameReferenceFact]{}
        }
    }
    packets
}

#Test("a checked body reads back from its bytes as it was") {
    failures := [String]{}
    functions: body_codec_functions(failures)
    if functions.len() < 8 -> failures.push("only {functions.len()} functions were checked")
    loop function in functions {
        out := body_codec_out()
        body_codec_put_fnbody(out, function)
        input := BodyCodecIn{at: 0, end: out.bytes.len(), failed: false, symbols: out.symbols.move(), decls: out.decls.move(), modules: out.modules.move()}
        read: body_codec_get_fnbody(out.bytes, input)
        if input.failed || input.at != input.end {
            failures.push("{function.key}: the read failed at byte {input.at} of {input.end}")
            next
        }
        if "{read:Debug}" != "{function:Debug}" -> failures.push("{function.key}: the body read back differs")
        again := body_codec_out()
        body_codec_put_fnbody(again, read)
        if again.bytes != out.bytes -> failures.push("{function.key}: the body read back writes other bytes")
    }
    if failures.len() > 0 -> panic("BodyCodec collected {failures.len()} failures:\n{failures.join("\n")}")
}

#Test("a checked body read cut short fails and ends") {
    failures := [String]{}
    functions: body_codec_functions(failures)
    loop function in functions {
        whole := body_codec_out()
        body_codec_put_fnbody(whole, function)
        size: whole.bytes.len()
        cuts: [Int]{0, 1, size /% 2, size - 1}
        loop cut in cuts {
            out := body_codec_out()
            body_codec_put_fnbody(out, function)
            input := BodyCodecIn{at: 0, end: cut, failed: false, symbols: out.symbols.move(), decls: out.decls.move(), modules: out.modules.move()}
            body_codec_get_fnbody(out.bytes, input)
            if !input.failed -> failures.push("{function.key}: a read of {cut} of {size} bytes did not fail")
        }
    }
    if failures.len() > 0 -> panic("BodyCodec collected {failures.len()} failures:\n{failures.join("\n")}")
}

#Test("a checked body packet reads back from its bytes as it was") {
    failures := [String]{}
    packets: body_codec_packets(failures)
    if packets.len() < 8 -> failures.push("only {packets.len()} packets were built")
    loop packet in packets {
        out := body_codec_out()
        body_codec_put_semaparallelbody(out, packet)
        input := BodyCodecIn{at: 0, end: out.bytes.len(), failed: false, symbols: out.symbols.move(), decls: out.decls.move(), modules: out.modules.move()}
        read: body_codec_get_semaparallelbody(out.bytes, input)
        if input.failed || input.at != input.end {
            failures.push("packet {packet.job_index}: the read failed at byte {input.at} of {input.end}")
            next
        }
        if "{read:Debug}" != "{packet:Debug}" -> failures.push("packet {packet.job_index}: the packet read back differs")
        again := body_codec_out()
        body_codec_put_semaparallelbody(again, read)
        if again.bytes != out.bytes -> failures.push("packet {packet.job_index}: the packet read back writes other bytes")
    }
    if failures.len() > 0 -> panic("BodyCodec collected {failures.len()} failures:\n{failures.join("\n")}")
}

#Test("a checked body packet read cut short fails and ends") {
    failures := [String]{}
    packets: body_codec_packets(failures)
    loop packet in packets {
        whole := body_codec_out()
        body_codec_put_semaparallelbody(whole, packet)
        size: whole.bytes.len()
        cuts: [Int]{0, 1, size /% 2, size - 1}
        loop cut in cuts {
            out := body_codec_out()
            body_codec_put_semaparallelbody(out, packet)
            input := BodyCodecIn{at: 0, end: cut, failed: false, symbols: out.symbols.move(), decls: out.decls.move(), modules: out.modules.move()}
            body_codec_get_semaparallelbody(out.bytes, input)
            if !input.failed -> failures.push("packet {packet.job_index}: a read of {cut} of {size} bytes did not fail")
        }
    }
    if failures.len() > 0 -> panic("BodyCodec collected {failures.len()} failures:\n{failures.join("\n")}")
}

#Test("the Core library's check writes each Prelude function check as a packet that reads back") {
    failures := [String]{}
    checked := body_codec_check(failures, JET_CANONICAL_EFFECT_PACKAGE_IDENTITY, body_codec_hooks()) ?? panic("BodyCodec could not check the Prelude module:\n{failures.join("\n")}")
    keys := [String:Bool]{}
    loop module_row in checked.modules {
        if module_row.package_identity != JET_CANONICAL_EFFECT_PACKAGE_IDENTITY -> next
        loop function in module_row.functions -> keys["{function.key}"] = true
    }
    bodies: sema_core_bodies_read(checked.core_bodies.move()) ?? panic("BodyCodec: the bodies file does not read back")
    if bodies.rows.len() < 6 -> failures.push("only {bodies.rows.len()} function checks were captured")
    if bodies.rows.len() != keys.len() -> failures.push("{keys.len()} Prelude functions were checked and {bodies.rows.len()} captured")
    // The packets' ids read as stand-ins: this test has no tables to
    // resolve the keys into.
    stand_rows := Rows<DeclRow>{}
    stand: DeclID{row: stand_rows.add(DeclRow{symbol: SymbolID{id: U32{0}}, kind: SymbolKind.Function})}
    loop row in bodies.rows {
        if keys.get(row.key) == None -> failures.push("{row.key}: captured, but no checked Prelude function has its key")
        input := BodyCodecIn{at: row.at, end: row.end, failed: false, symbols: (loop _ in row.symbols -> SymbolID{id: U32{1}}), decls: (loop _ in row.decls -> DeclID{row: stand.row}), modules: (loop _ in row.modules -> ModuleID{id: U32{1}})}
        packet: body_codec_get_semaparallelbody(bodies.bytes, input)
        if input.failed || input.at != row.end {
            failures.push("{row.key}: the packet read failed at byte {input.at} of {row.end}")
            next
        }
        if packet.checked == .Val(result) {
            if result.value == .Val(function) {
                if function.key != row.key -> failures.push("{row.key}: the packet holds the check of {function.key}")
            } else {
                failures.push("{row.key}: the packet's check has no function")
            }
        } else {
            failures.push("{row.key}: the packet has no check")
        }
    }
    cut: bodies.bytes.len() - 1
    if sema_core_bodies_read(bodies.bytes[0..<cut]) != None -> failures.push("a bodies file cut short reads back")
    if failures.len() > 0 -> panic("BodyCodec collected {failures.len()} failures:\n{failures.join("\n")}")
}

#Test("a Prelude function check loaded from the Core library's check is the check from text") {
    failures := [String]{}
    captured := body_codec_check(failures, JET_CANONICAL_EFFECT_PACKAGE_IDENTITY, body_codec_hooks()) ?? panic("BodyCodec could not check the Prelude module:\n{failures.join("\n")}")
    bodies: sema_core_bodies_read(captured.core_bodies.move()) ?? panic("BodyCodec: the bodies file does not read back")
    count: bodies.rows.len()
    hooks: Shared{SemaRegistrationHostHooks{numeric_unit_conversion_exact: None, core_bodies: Val(bodies)}}
    loaded := body_codec_check(failures, JET_CANONICAL_EFFECT_PACKAGE_IDENTITY, hooks) ?? panic("BodyCodec could not load the Prelude module:\n{failures.join("\n")}")
    permit: hooks.guard_read()
    loaded_count := 0
    loop marked in permit.value.core_bodies_loaded {
        if marked -> loaded_count += 1
    }
    if count < 6 || loaded_count != count -> failures.push("{count} function checks were captured and {loaded_count} loaded")
    if loaded.core_bodies.len() > 0 -> failures.push("a compile that loads function checks captured them too")
    if loaded.modules.len() != captured.modules.len() -> failures.push("{captured.modules.len()} modules were checked from text and {loaded.modules.len()} with loaded checks")
    loop (position, text) in captured.modules {
        if position >= loaded.modules.len() -> break
        row: loaded.modules[position]
        name: text.module_name
        loop function in text.functions {
            if !sema_core_body_was_loaded(permit.value.core_bodies, permit.value.core_bodies_loaded, function.key) -> failures.push("{function.key}: checked from text, not loaded")
        }
        if "{row.functions:Debug}" != "{text.functions:Debug}" -> failures.push("{name}: the loaded functions differ from the checked ones")
        if "{row.diagnostics:Debug}" != "{text.diagnostics:Debug}" -> failures.push("{name}: the loaded diagnostics differ from the checked ones")
        if "{row.call_facts:Debug}" != "{text.call_facts:Debug}" -> failures.push("{name}: the loaded call facts differ from the checked ones")
        if "{row.comptime_requests:Debug}" != "{text.comptime_requests:Debug}" -> failures.push("{name}: the loaded comptime requests differ from the checked ones")
        if "{row.name_references:Debug}" != "{text.name_references:Debug}" -> failures.push("{name}: the loaded name references differ from the checked ones")
        if "{row.compute_facts:Debug}" != "{text.compute_facts:Debug}" -> failures.push("{name}: the loaded compute facts differ from the checked ones")
        if "{row.failure_facts:Debug}" != "{text.failure_facts:Debug}" -> failures.push("{name}: the loaded failure facts differ from the checked ones")
    }
    if "{loaded.diagnostics:Debug}" != "{captured.diagnostics:Debug}" -> failures.push("the compile's diagnostics differ")
    if failures.len() > 0 -> panic("BodyCodec collected {failures.len()} failures:\n{failures.join("\n")}")
}
