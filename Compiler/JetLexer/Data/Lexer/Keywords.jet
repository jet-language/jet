// Canonical Jet lexer keyword mapping; spellings live in the Syntax registry.
// Ported from the current Jet lexer, not the frozen Rust keyword function.
struct LexerKeyword {
    constant: String
    kind: String
    tag: String
}

LEXER_KEYWORDS :: [LexerKeyword]{
    LexerKeyword{constant: "LIT_TRUE", kind: "KwTrue", tag: "K_TRUE"},
    LexerKeyword{constant: "LIT_FALSE", kind: "KwFalse", tag: "K_FALSE"},
    LexerKeyword{constant: "LIT_NULL", kind: "KwNull", tag: "K_NULL"},
    LexerKeyword{constant: "KW_SELF", kind: "KwSelf", tag: "K_SELF"},
    LexerKeyword{constant: "KW_BREAK", kind: "KwBreak", tag: "K_BREAK"},
    LexerKeyword{constant: "KW_RETURN", kind: "KwReturn", tag: "K_RETURN"},
    LexerKeyword{constant: "KW_FN", kind: "KwFn", tag: "K_FN"},
    LexerKeyword{constant: "KW_PUB", kind: "KwPub", tag: "K_PUB"},
    LexerKeyword{constant: "KW_PRIV", kind: "KwPriv", tag: "K_PRIV"},
    LexerKeyword{constant: "KW_IF", kind: "KwIf", tag: "K_IF"},
    LexerKeyword{constant: "KW_ELSE", kind: "KwElse", tag: "K_ELSE"},
    LexerKeyword{constant: "KW_IN", kind: "KwIn", tag: "K_IN"},
    LexerKeyword{constant: "KW_MUTATE", kind: "KwMutate", tag: "K_MUTATE"},
    LexerKeyword{constant: "KW_MOVE", kind: "KwMove", tag: "K_MOVE"},
    LexerKeyword{constant: "KW_COPY", kind: "KwCopy", tag: "K_COPY"},
    LexerKeyword{constant: "KW_STRUCT", kind: "KwStruct", tag: "K_STRUCT"},
    LexerKeyword{constant: "KW_ENUM", kind: "KwEnum", tag: "K_ENUM"},
    LexerKeyword{constant: "KW_IMPL", kind: "KwImpl", tag: "K_IMPL"},
    LexerKeyword{constant: "KW_TRAIT", kind: "KwTrait", tag: "K_TRAIT"},
    LexerKeyword{constant: "KW_TAG", kind: "KwTag", tag: "K_TAG"},
    LexerKeyword{constant: "KW_EFFECT_DECL", kind: "KwEffect", tag: "K_EFFECT"},
    LexerKeyword{constant: "KW_DERIVE", kind: "KwDerive", tag: "K_DERIVE"},
    LexerKeyword{constant: "KW_IT", kind: "KwIt", tag: "K_IT"},
