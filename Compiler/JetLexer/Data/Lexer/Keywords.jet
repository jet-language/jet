    LexerKeyword{constant: "KW_YIELD", kind: "KwYield", tag: "K_YIELD"},
    LexerKeyword{constant: "KW_USE", kind: "KwUse", tag: "K_USE"},
    LexerKeyword{constant: "KW_EXTERN", kind: "KwExtern", tag: "K_EXTERN"},
    LexerKeyword{constant: "KW_MODULE", kind: "KwModule", tag: "K_MODULE"},
}
