// Canonical Jet lexer keyword mapping; spellings live in the Syntax registry.
// A retired word stays reserved in the lexer, but no grammar rule accepts it.
// Every other row is an active keyword, and Toolchain/LexerKeywordRows.jet
// refuses a table whose active rows and JET_KEYWORD_LIST disagree.
LexerKeyword: struct {
    constant: String,
    kind: String,
    tag: String,
    retired: Bool,
}

LEXER_KEYWORDS: [LexerKeyword]{
    {constant: "LIT_TRUE", kind: "KwTrue", tag: "TOKEN_TRUE", retired: false},
    {constant: "LIT_FALSE", kind: "KwFalse", tag: "TOKEN_FALSE", retired: false},
    {constant: "LIT_NULL", kind: "KwNull", tag: "TOKEN_NULL", retired: false},
    {constant: "KW_SELF", kind: "KwSelf", tag: "TOKEN_SELF", retired: false},
    {constant: "KW_BREAK", kind: "KwBreak", tag: "TOKEN_BREAK", retired: false},
    {constant: "KW_RETURN", kind: "KwReturn", tag: "TOKEN_RETURN", retired: false},
    {constant: "KW_FN", kind: "KwFn", tag: "TOKEN_KW_FN", retired: false},
    {constant: "KW_PRIV", kind: "KwPriv", tag: "TOKEN_KW_PRIV", retired: false},
    {constant: "KW_IF", kind: "KwIf", tag: "TOKEN_KW_IF", retired: false},
    {constant: "KW_ELSE", kind: "KwElse", tag: "TOKEN_KW_ELSE", retired: false},
    {constant: "KW_IN", kind: "KwIn", tag: "TOKEN_KW_IN", retired: false},
    {constant: "KW_MUTATE", kind: "KwMutate", tag: "TOKEN_KW_MUTATE", retired: true},
    {constant: "KW_MOVE", kind: "KwMove", tag: "TOKEN_KW_MOVE", retired: true},
    {constant: "KW_COPY", kind: "KwCopy", tag: "TOKEN_KW_COPY", retired: true},
    {constant: "KW_STRUCT", kind: "KwStruct", tag: "TOKEN_KW_STRUCT", retired: false},
    {constant: "KW_ENUM", kind: "KwEnum", tag: "TOKEN_KW_ENUM", retired: false},
    {constant: "KW_IMPL", kind: "KwImpl", tag: "TOKEN_KW_IMPL", retired: false},
    {constant: "KW_TRAIT", kind: "KwTrait", tag: "TOKEN_KW_TRAIT", retired: false},
    {constant: "KW_IT", kind: "KwIt", tag: "TOKEN_KW_IT", retired: false},
    {constant: "KW_CONST", kind: "KwConst", tag: "TOKEN_KW_CONST", retired: true},
    {constant: "KW_LOOP", kind: "KwLoop", tag: "TOKEN_KW_LOOP", retired: false},
    {constant: "KW_YIELD", kind: "KwYield", tag: "TOKEN_KW_YIELD", retired: false},
    {constant: "KW_USE", kind: "KwUse", tag: "TOKEN_KW_USE", retired: false},
    {constant: "KW_EXTERN", kind: "KwExtern", tag: "TOKEN_KW_EXTERN", retired: false},
    {constant: "KW_MODULE", kind: "KwModule", tag: "TOKEN_KW_MODULE", retired: false},
}
