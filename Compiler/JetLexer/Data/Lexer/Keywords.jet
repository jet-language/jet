// Canonical Jet lexer keyword mapping; spellings live in the Syntax registry.
// Ported from the current Jet lexer, not the frozen Rust keyword function.
// A retired word stays reserved in the lexer, but no grammar rule accepts it.
// Every other row is an active keyword, and Toolchain/LexerKeywordRows.jet
// refuses a table whose active rows and JET_KEYWORD_LIST disagree.
LexerKeyword: struct {
    constant: String
    kind: String
    tag: String
    retired: Bool
}

LEXER_KEYWORDS: [LexerKeyword]{
    {constant: "LIT_TRUE", kind: "KwTrue", tag: "K_TRUE", retired: false},
    {constant: "LIT_FALSE", kind: "KwFalse", tag: "K_FALSE", retired: false},
    {constant: "LIT_NULL", kind: "KwNull", tag: "K_NULL", retired: false},
    {constant: "KW_SELF", kind: "KwSelf", tag: "K_SELF", retired: false},
    {constant: "KW_BREAK", kind: "KwBreak", tag: "K_BREAK", retired: false},
    {constant: "KW_RETURN", kind: "KwReturn", tag: "K_RETURN", retired: false},
    {constant: "KW_FN", kind: "KwFn", tag: "K_FN", retired: false},
    {constant: "KW_PUB", kind: "KwPub", tag: "K_PUB", retired: false},
    {constant: "KW_PRIV", kind: "KwPriv", tag: "K_PRIV", retired: false},
    {constant: "KW_IF", kind: "KwIf", tag: "K_IF", retired: false},
    {constant: "KW_ELSE", kind: "KwElse", tag: "K_ELSE", retired: false},
    {constant: "KW_IN", kind: "KwIn", tag: "K_IN", retired: false},
    {constant: "KW_MUTATE", kind: "KwMutate", tag: "K_MUTATE", retired: true},
    {constant: "KW_MOVE", kind: "KwMove", tag: "K_MOVE", retired: true},
    {constant: "KW_COPY", kind: "KwCopy", tag: "K_COPY", retired: true},
    {constant: "KW_STRUCT", kind: "KwStruct", tag: "K_STRUCT", retired: false},
    {constant: "KW_ENUM", kind: "KwEnum", tag: "K_ENUM", retired: false},
    {constant: "KW_IMPL", kind: "KwImpl", tag: "K_IMPL", retired: false},
    {constant: "KW_TRAIT", kind: "KwTrait", tag: "K_TRAIT", retired: false},
    {constant: "KW_TAG", kind: "KwTag", tag: "K_TAG", retired: false},
    {constant: "KW_EFFECT_DECL", kind: "KwEffect", tag: "K_EFFECT", retired: false},
    {constant: "KW_DERIVE", kind: "KwDerive", tag: "K_DERIVE", retired: false},
    {constant: "KW_IT", kind: "KwIt", tag: "K_IT", retired: false},
    {constant: "KW_CONST", kind: "KwConst", tag: "K_CONST", retired: true},
    {constant: "KW_COMPTIME", kind: "KwComptime", tag: "K_COMPTIME", retired: false},
    {constant: "KW_LOOP", kind: "KwLoop", tag: "K_LOOP", retired: false},
    {constant: "KW_YIELD", kind: "KwYield", tag: "K_YIELD", retired: false},
    {constant: "KW_USE", kind: "KwUse", tag: "K_USE", retired: false},
    {constant: "KW_EXTERN", kind: "KwExtern", tag: "K_EXTERN", retired: false},
    {constant: "KW_MODULE", kind: "KwModule", tag: "K_MODULE", retired: false},
}
