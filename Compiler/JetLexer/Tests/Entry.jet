// U2-T1: tests run with the canonical JetFoundation/JetLexer unit sources.
// Reused origin/port/compiler@371361c3e Entry.jet and Payload01.jet controls;
// inputs and assertions are preserved from the Rust source tags below.
// Rust-only scoped-driver/unwind, mutation injection and cross-tier orchestration
// in tests/selfhost_terminators.rs:197-386 stay outside this source-lexer suite.

fn lexer_test_raw(source: String) -> Lexed { lex_payload(source.bytes(), false) }

// Rust inputs contain byte 13; Jet deliberately has no \r string escape.
fn lexer_test_cr() -> String Never! { String.from_bytes([U8]{13}) ?? panic("ASCII carriage return") }

fn lexer_test_strings(tokens: [Token]) -> [[StringPart]] Never! {
    strings := [[StringPart]]{}
    loop token in tokens {
        if token.kind == TOKEN_STRING -> &strings.push(token.payload.string_parts.copy())
    }
    strings
}

fn lexer_test_text(parts: [StringPart], expected: String) -> Bool Never! {
    parts.len() == 1 && parts[0].kind == STRING_PART_TEXT && parts[0].text == expected
}

fn lexer_test_hole(parts: [StringPart]) -> Bool Never! {
    loop part in parts {
        if part.kind == STRING_PART_INTERPOLATION -> return true
    }
    false
}

fn lexer_test_first_string(source: String) -> String Never! {
    lexed :: lex(source.bytes())
    assert(lexed.diagnostics.is_empty())
    strings :: lexer_test_strings(lexed.tokens)
    assert(strings.len() > 0)
    parts :: strings[0]
    assert(parts.len() == 1 && parts[0].kind == STRING_PART_TEXT)
    parts[0].text.copy()
}

// Rust: crates/jet-lexer/src/lib.rs:15
#Test("spaceship_is_one_longest_match_before_le") {
    lexed :: lex("a <=> b <= c".bytes())
    assert(lexed.diagnostics.is_empty())
    tokens :: lexed.tokens
    assert(tokens[1].kind == TOKEN_COMPARE)
    assert_eq(tokens[1].span.end - tokens[1].span.start, 3)
    assert(tokens[3].kind == TOKEN_LE)
    assert_eq(tokens[3].span.end - tokens[3].span.start, 2)
}

// Rust: crates/jet-lexer/src/lib.rs:45
#Test("typed_head_keeps_backslash_literal") {
    assert_eq(lexer_test_first_string(`Regex.{"\d+"}`), `\d+`)
    assert_eq(lexer_test_first_string(`Regex.{"a\nb"}`), `a\nb`)
    assert_eq(lexer_test_first_string(`"a\nb"`), "a\nb")
}

// Rust: crates/jet-lexer/src/lib.rs:52
#Test("typed_head_quote_stays_in_body_when_slashed") {
    assert_eq(lexer_test_first_string(`Regex.{"a\"b"}`), `a\"b`)
}

// Rust: crates/jet-lexer/src/lib.rs:57
#Test("typed_head_doubled_braces_stay_literal") {
    assert_eq(lexer_test_first_string(`Regex.{"\d{{2}}"}`), `\d{2}`)
}

// Rust: crates/jet-lexer/src/lib.rs:62
#Test("typed_head_holes_still_split_interpolation") {
    lexed :: lex(`URL.{"https://x/{name}"}`.bytes())
    assert(lexed.diagnostics.is_empty())
    strings :: lexer_test_strings(lexed.tokens)
    assert_eq(strings.len(), 1)
    parts :: strings[0]
    assert(parts.len() == 2 && parts[0].kind == STRING_PART_TEXT && parts[1].kind == STRING_PART_INTERPOLATION && parts[0].text == "https://x/")
}

// Rust: crates/jet-lexer/src/lib.rs:83
#Test("plain_string_still_rejects_unknown_escapes") {
    lexed :: lexer_test_raw(`"C:\path"`)
    found := false
    loop diagnostic in lexed.diagnostics {
        if diagnostic.what.contains("isn't an escape") -> found = true
    }
    assert(found)
}

// Reuses origin/port/compiler Payload01.jet and Strings.jet Scan controls.
struct LexerTestDelimiterCase { source: String, runs: [Span] }

fn lexer_test_delimiter_cases() -> [LexerTestDelimiterCase] Never! {
    [LexerTestDelimiterCase]{
        LexerTestDelimiterCase{source: "\"\"\"Hello\n    kept\n    \"\"\"", runs: [Span]{Span{start: 3, end: 8}}},
        LexerTestDelimiterCase{source: "\"\"\"\n    kept\n    end\"\"\"", runs: [Span]{Span{start: 17, end: 20}}},
        LexerTestDelimiterCase{source: "\"\"\"Hello\n    kept\n    end\"\"\"", runs: [Span]{Span{start: 3, end: 8}, Span{start: 22, end: 25}}},
        LexerTestDelimiterCase{source: "\"\"\"abc\"\"\"", runs: [Span]{Span{start: 3, end: 6}, Span{start: 3, end: 6}}},
        LexerTestDelimiterCase{source: "\"\"\"{{name}}\nkept\n\"\"\"", runs: [Span]{Span{start: 3, end: 9}}},
        LexerTestDelimiterCase{source: "\"\"\" \té😀 rest\nkept\n\"\"\"", runs: [Span]{Span{start: 5, end: 11}}},
        LexerTestDelimiterCase{source: "SQL{{\"\"\"query\nkept\n\"\"\"}}", runs: [Span]{Span{start: 7, end: 12}}},
        LexerTestDelimiterCase{source: "\"\"\"{lexer_test_cr()}stray\nkept\n\"\"\"", runs: [Span]{Span{start: 3, end: 9}}},
    }
}

// Rust: crates/jet-lexer/src/Lexer/Scan.rs:1062
#Test("triple_delimiter_text_has_exact_run_spans_and_keeps_recovery_text") {
    loop row in lexer_test_delimiter_cases() {
        lexed :: lexer_test_raw(row.source)
        assert_eq(lexed.diagnostics.len(), row.runs.len())
        loop (index, diagnostic) in lexed.diagnostics {
            assert_eq(diagnostic.code, "E0084")
            assert_eq(diagnostic.span, Val(row.runs[index]))
            assert(diagnostic.fix.contains("ordinary string"))
            assert(diagnostic.fix.contains("backtick raw string"))
        }
        assert(lexer_test_strings(lexed.tokens).len() > 0)
    }
}

// Rust: crates/jet-lexer/src/Lexer/Scan.rs:1086
#Test("triple_delimiter_whitespace_crlf_and_foreign_bodies_are_legal") {
    sources :: [String]{
        "\"\"\"   \nhello\n   \"\"\" }}",
        "\"\"\"\t\t\nhello\n\t\t\"\"\"",
        "\"\"\" \t{lexer_test_cr()}\nhello{lexer_test_cr()}\n \t\"\"\"",
        "SQL{{\"\"\"\nhello\n\"\"\"}}",
    }
    loop source in sources {
        lexed :: lexer_test_raw(source)
        assert(lexed.diagnostics.is_empty())
        expected :: if source.contains(lexer_test_cr()) -> "hello{lexer_test_cr()}" else -> "hello"
        assert(lexer_test_text(lexer_test_strings(lexed.tokens)[0], expected))
    }
    languages :: [String]{"c", "cpp", "asm"}
    loop lang in languages {
        lexed :: lexer_test_raw("#FFI({lang}) fn foreign() {{ \"\"\"text {{value}} \\raw\"\"\" }}")
        assert(lexed.diagnostics.is_empty())
        assert(lexer_test_text(lexer_test_strings(lexed.tokens)[0], `text {value} \raw`))
    }
}

// Rust: crates/jet-lexer/src/Lexer/Scan.rs:1116
#Test("raw_foreign_body_marker_does_not_capture_a_later_function") {
    source :: `#FFI(c) fn foreign() -> Int {
    """int64_t foreign(void) { return 1; }"""
}

fn ordinary(value: Int) {
    text :: """
value={value}
"""
}`
    lexed :: lexer_test_raw(source)
    assert(lexed.diagnostics.is_empty())
    strings :: lexer_test_strings(lexed.tokens)
    assert_eq(strings.len(), 2)
    assert(strings[0].len() == 1 && strings[0][0].kind == STRING_PART_TEXT)
    assert(lexer_test_hole(strings[1]))
}

// Rust: crates/jet-lexer/src/Lexer/Scan.rs:1146
#Test("grouped_ffi_marker_keeps_foreign_body_raw") {
    source :: `#[Unsafe("scalar registers"), FFI(asm)]
fn add(a: Int, b: Int) -> Int {
    """add {a}, {b} ; -> return"""
}`
    lexed :: lexer_test_raw(source)
    assert(lexed.diagnostics.is_empty())
    found := false
    loop parts in lexer_test_strings(lexed.tokens) {
        if parts.len() == 1 && parts[0].kind == STRING_PART_TEXT && parts[0].text.contains("-> return") -> found = true
    }
    assert(found)
}

// Rust: crates/jet-lexer/src/Lexer/Scan.rs:1165
#Test("adjacent_ffi_markers_keep_foreign_body_raw_in_both_orders") {
    sources :: [String]{
        `#Unsafe("registers") #FFI(asm) fn add() { """add {a}, {b}""" }`,
        `#FFI(asm) #Unsafe("registers") fn add() { """add {a}, {b}""" }`,
    }
    loop source in sources {
        lexed :: lexer_test_raw(source)
        assert(lexed.diagnostics.is_empty())
        assert(lexer_test_text(lexer_test_strings(lexed.tokens)[1], `add {a}, {b}`))
    }
}

