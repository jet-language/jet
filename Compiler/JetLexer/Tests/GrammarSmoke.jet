// Ports of the lexer smoke tests from the deleted (#6096).
use jet_lexer.[TOKEN_DOT, TOKEN_INT, lex, lex_may_pin_inline_version]

// `p.0` lexes as a dot followed by the integer 0, not a float, so the parser
// sees a member position.
#Test("dot_zero_in_statement_lexes_as_dot_then_int") {
    lexed: lex("run: fn() {{ x: p.0 }}".bytes())
    assert(lexed.diagnostics.is_empty(), "lex diagnostics for `p.0`")
    dot := -1
    loop (index, token) in lexed.tokens {
        if token.kind == TOKEN_DOT {
            dot = index
            break
        }
    }
    assert(dot >= 0, "expected a dot token")
    zero: lexed.tokens[dot + 1]
    assert(zero.kind == TOKEN_INT, "the token after the dot is an integer")
    assert(zero.literal >= 0, "the integer carries a literal row")
    assert((lexed.tables.literals[zero.literal].integer ?? -1) == 0, "the integer after the dot is 0")
}

// Only a code `#` before a number may pin an inline dependency version.
#Test("inline_version_pins_need_a_code_hash_before_a_number") {
    assert(lex_may_pin_inline_version("use textkit#1.4\n".bytes()), "a pin")
    assert(lex_may_pin_inline_version("use textkit# /* note */ 2\n".bytes()), "a pin past a comment")
    assert(!lex_may_pin_inline_version("#!/usr/bin/env jet\n// card #6695\n/* #2 */\n#Error\nE: struct {{}}\nrun: fn() {{ print(\"#3\") }}\n".bytes()), "no code `#` before a number")
}
