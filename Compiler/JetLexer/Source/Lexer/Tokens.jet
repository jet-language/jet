// Stable parser-facing lexer data. Spans are UTF-8 byte offsets into the
// original source; payload.text preserves that exact source spelling.
use jet_foundation.[
    Diagnostic,
    Span,
]

pub struct TokenPayload {
    pub text: String
    pub decoded: String
    pub integer: Int?
    pub decimal: Float?
    pub suffix: String
    pub interpolations: Int
    pub string_parts: [StringPart]
}

pub struct Token {
    pub kind: Int
    pub span: Span
    pub payload: TokenPayload
}

pub struct StringPart {
    pub kind: Int
    pub span: Span
    pub text: String
    pub byte: Int
    pub tokens: [Token]
}

pub STRING_PART_TEXT :: 1
pub STRING_PART_INTERPOLATION :: 2
pub STRING_PART_BYTE :: 3

pub struct Lexed {
    pub tokens: [Token]
    pub diagnostics: [Diagnostic]
}

// These numeric tags are stable at the Jet parser boundary and align with the
// exhaustive raw-token transport consumed by statement termination.
pub TOKEN_IDENT :: 1
pub TOKEN_RAW_STRING :: 2
pub TOKEN_STRING :: 3
pub TOKEN_INT :: 4
pub TOKEN_FLOAT :: 5
pub TOKEN_UNIT_NUMBER :: 6
pub TOKEN_CHAR :: 7
pub TOKEN_TRUE :: 8
pub TOKEN_FALSE :: 9
pub TOKEN_SELF :: 10
pub TOKEN_NULL :: 11
pub TOKEN_BREAK :: 12
pub TOKEN_RETURN :: 13
pub TOKEN_RPAREN :: 14
pub TOKEN_RBRACKET :: 15
pub TOKEN_RBRACE :: 16
pub TOKEN_QUESTION :: 17
// Retired D-INCR1 spellings: lexed only so the parser teaches E0160.
pub TOKEN_PLUS_PLUS :: 18
pub TOKEN_MINUS_MINUS :: 19
pub TOKEN_GT :: 20
pub TOKEN_SHR :: 21
pub TOKEN_FENCE_CLOSE :: 22
pub TOKEN_DOT :: 23
