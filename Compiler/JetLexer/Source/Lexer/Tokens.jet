// Stable parser-facing lexer data. Spans are UTF-8 byte offsets into the
// original source; payload.text preserves that exact source spelling.
pub struct Span {
    pub start: Int
    pub end: Int
}

pub struct TextEdit {
    pub span: Span
    pub new_text: String
}
pub enum DiagnosticMoment { Compile Run Test Tool }

pub enum DiagnosticFixApplicability { Safe Suggested }

pub enum DiagnosticFixSafety { Formatting BehaviorPreserving ApiChanging TargetChanging NeedsReview }

pub enum DiagnosticNoFixReasonKind { Behavior Design Ambiguous }

pub struct DiagnosticNoFixReason {
    pub kind: DiagnosticNoFixReasonKind
    pub next: String
}

pub struct DiagnosticOrigin {
    pub display: String
    pub path: String
    pub source: String
    pub revision: String
}

pub struct DiagnosticCause {
    pub code: String
    pub span: ?Span{None}
    pub origin: ?DiagnosticOrigin{None}
}

pub enum DiagnosticCryptoMisuseReason {
    InvalidLength
    NonceLength
    OutputLength
    SaltLength
    MemoryCost
    IterationCount
    LaneCount
    MemoryTimeCost
    RawNonce
    RawAlgorithm
    DeterministicEntropy
}

pub struct DiagnosticErrorContextFrame {
    pub text: String
    pub file: String
    pub line: Int
}

pub struct DiagnosticErrorConversion {
    pub source: String
    pub target: String
}

pub struct DiagnosticErrorField {
    pub name: String
    pub value: String
}

pub struct DiagnosticErrorSpan {
    pub start: Int
    pub end: Int
}

pub struct DiagnosticErrorDetails {
    pub variant: String
    pub fields: [DiagnosticErrorField]
    pub source_span: ?DiagnosticErrorSpan{None}
}

pub struct DiagnosticErrorJourneyFrame {
    pub fn_name: String
    pub file: String
    pub line: Int
    pub note: String
    pub hops: Int
}

pub struct DiagnosticBuildError {
    pub code: ?String{None}
    pub message: String
    pub typed_identity: ?String{None}
    pub causes: [DiagnosticBuildError]{[DiagnosticBuildError]{}}
    pub context_frames: [DiagnosticErrorContextFrame]{[DiagnosticErrorContextFrame]{}}
    pub source_journey: [DiagnosticErrorJourneyFrame]{[DiagnosticErrorJourneyFrame]{}}
    pub conversion_history: [DiagnosticErrorConversion]{[DiagnosticErrorConversion]{}}
    pub details: ?DiagnosticErrorDetails{None}
}

pub enum DiagnosticStructured {
    SuggestedEdits(edits: [TextEdit])
    CryptoMisuse(reason: DiagnosticCryptoMisuseReason, operation: String, expected: ?String, actual: ?Int)
    BuildError(report: DiagnosticBuildError)
    RuntimeHostFault(stdout: String)
}

pub struct TokenPayload {
    pub text: String
    pub decoded: String
    pub integer: ?Int
    pub decimal: ?Float
    pub suffix: String
    pub interpolations: Int
    pub string_parts: [StringPart]
}

pub struct Token {
    pub kind: Int
    pub span: Span
    pub payload: TokenPayload
}

pub struct StringPart {
    pub kind: Int
    pub span: Span
    pub text: String
    pub byte: Int
    pub tokens: [Token]
}

STRING_PART_TEXT :: 1
STRING_PART_INTERPOLATION :: 2
STRING_PART_BYTE :: 3

pub struct Diagnostic {
    pub moment: DiagnosticMoment{DiagnosticMoment.Compile}
    pub severity: Int
    pub code: String
    pub span: ?Span{None}
    pub source_path: ?String{None}
    pub source_offset: ?Int{None}
    pub source_start: ?Int{None}
    pub origin: ?DiagnosticOrigin{None}
    pub cause: [DiagnosticCause]{[DiagnosticCause]{}}
    pub what: String
    pub why: String
    pub fix: String
    pub edit: ?TextEdit{None}
    pub applicability: ?DiagnosticFixApplicability{None}
    pub safety: ?DiagnosticFixSafety{None}
    pub no_fix_reason: ?DiagnosticNoFixReason{None}
    pub detail: ?String{None}
    pub structured: ?DiagnosticStructured{None}
    pub decision_row: ?MirDecisionRow{None}
    pub denial_kind: ?String{None}
    pub call_chain: [String]{[String]{}}
    pub scope_chain: [String]{[String]{}}
    pub nearest_granting_scope: ?String{None}
}

pub fn diagnostic_with_source_path(diagnostic: Diagnostic, source_path: String, aggregate_source_offset: Int) -> Diagnostic {
    diagnostic.source_path = Val(source_path)
    diagnostic.source_offset = Val(aggregate_source_offset)
    diagnostic.source_start = Val(0)
    diagnostic
}

pub fn diagnostic_with_source_mapping(diagnostic: Diagnostic, source_path: String, aggregate_source_offset: Int, source_start: Int) -> Diagnostic {
    diagnostic.source_path = Val(source_path)
    diagnostic.source_offset = Val(aggregate_source_offset)
    diagnostic.source_start = Val(source_start)
    diagnostic
}

pub fn diagnostic_with_edit(diagnostic: Diagnostic, edit: TextEdit) -> Diagnostic {
    diagnostic_registry_with_edit(diagnostic, edit)
}

pub fn diagnostic_with_moment(diagnostic: Diagnostic, moment: DiagnosticMoment) -> Diagnostic {
    diagnostic.moment = moment
    diagnostic
}

pub fn diagnostic_with_origin(diagnostic: Diagnostic, origin: DiagnosticOrigin) -> Diagnostic {
    diagnostic.origin = Val(origin)
    diagnostic
}

pub fn diagnostic_with_cause(diagnostic: Diagnostic, cause: DiagnosticCause) -> Diagnostic {
    diagnostic.cause.push(cause)
    diagnostic
}

pub fn diagnostic_with_causes(diagnostic: Diagnostic, causes: [DiagnosticCause]) -> Diagnostic {
    diagnostic.cause = causes
    diagnostic
}

pub fn diagnostic_with_edit_grade(diagnostic: Diagnostic, edit: TextEdit, applicability: DiagnosticFixApplicability, safety: DiagnosticFixSafety) -> Diagnostic {
    diagnostic_registry_with_edit_grade(diagnostic, edit, applicability, safety)
}

pub fn diagnostic_with_fix_grades(diagnostic: Diagnostic, applicability: DiagnosticFixApplicability, safety: DiagnosticFixSafety) -> Diagnostic {
    edit :: diagnostic.edit ?? return panic("diagnostic `{diagnostic.code}` needs an edit before applying explicit fix grades")
    diagnostic_registry_with_edit_grade(diagnostic, edit, applicability, safety)
}

pub fn diagnostic_with_structured_edit(diagnostic: Diagnostic, edit: TextEdit) -> Diagnostic {
    diagnostic_registry_with_structured_edit(diagnostic, edit)
}

pub fn diagnostic_with_source_derived_suggestion(diagnostic: Diagnostic, span: Span, new_text: String) -> Diagnostic {
    diagnostic_registry_with_source_derived_suggestion(diagnostic, span, new_text)
}

pub fn diagnostic_with_alternative_edit(diagnostic: Diagnostic, edit: TextEdit) -> Diagnostic {
    diagnostic_registry_with_alternative_edit(diagnostic, edit)
}

pub fn diagnostic_with_no_fix_reason(diagnostic: Diagnostic, reason: DiagnosticNoFixReason) -> Diagnostic {
    diagnostic.no_fix_reason = Val(reason)
    diagnostic
}

pub fn diagnostic_with_detail(diagnostic: Diagnostic, detail: String) -> Diagnostic {
    diagnostic.detail = Val(detail)
    diagnostic
}

pub fn diagnostic_with_structured(diagnostic: Diagnostic, structured: DiagnosticStructured) -> Diagnostic {
    diagnostic.structured = Val(structured)
    diagnostic
}

pub fn diagnostic_with_decision_row(diagnostic: Diagnostic, decision_row: MirDecisionRow) -> Diagnostic {
    diagnostic.decision_row = Val(decision_row)
    diagnostic
}

pub fn diagnostic_with_rights(diagnostic: Diagnostic, denial_kind: String, call_chain: [String], scope_chain: [String], nearest_granting_scope: ?String) -> Diagnostic {
    diagnostic.denial_kind = Val(denial_kind)
    diagnostic.call_chain = call_chain
    diagnostic.scope_chain = scope_chain
    diagnostic.nearest_granting_scope = nearest_granting_scope
    diagnostic
}

DIAGNOSTIC_ERROR :: 1
DIAGNOSTIC_LINT :: 2

pub struct Lexed {
    pub tokens: [Token]
    pub diagnostics: [Diagnostic]
}

