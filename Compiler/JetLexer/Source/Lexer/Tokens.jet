// Stable parser-facing lexer data. Spans are UTF-8 byte offsets into the
// original source. A token names its exact source spelling (`text`) and its
// decoded value (`decoded`) in the lexed source's `NameTable`; literal facts
// live in `TokenTables.literals`, so a token holds no heap data.
use jet_foundation.[
    Diagnostic,
    Name,
    NameTable,
    Span,
    name_empty,
    name_table,
    name_text,
]

struct Token {
    kind: Int
    span: Span
    text: Name
    decoded: Name
    // Row in `TokenTables.literals`, or -1 when the token has no literal facts.
    literal: Int
}

// Number and string facts of one literal token.
struct TokenLiteral {
    integer: Int?
    decimal: Float?
    suffix: Name
    interpolations: Int
    string_parts: [StringPart]
}

struct StringPart {
    kind: Int
    span: Span
    text: Name
    byte: Int
    tokens: [Token]
}

STRING_PART_TEXT :: 1
STRING_PART_INTERPOLATION :: 2
STRING_PART_BYTE :: 3

// The spellings and literal facts a lexed source's tokens refer to,
// interpolated tokens included.
struct TokenTables {
    names: NameTable
    literals: [TokenLiteral]
    // Per token kind, the name id of its one spelling once a keyword or
    // punctuation token of that kind interned it (-1 before), so the next
    // such token skips the hash probe (`intern_token_source`).
    spellings: [Int]
}

struct Lexed {
    tokens: [Token]
    tables: TokenTables
    diagnostics: [Diagnostic]
}

// One `TokenTables.spellings` slot per token kind.
TOKEN_KIND_SLOTS :: 108

fn token_tables() -> TokenTables Never! {
    spellings := [Int]{}
    loop _ in 0..<TOKEN_KIND_SLOTS -> &spellings.push(-1)
    TokenTables{names: name_table(), literals: [TokenLiteral]{}, spellings: ^spellings}
}

// A token with no spelling and no literal facts.
fn token_synthetic(kind: Int, span: Span) -> Token Never! {
    Token{kind: kind, span: span, text: name_empty(), decoded: name_empty(), literal: -1}
}

fn token_text(tables: TokenTables, token: Token) -> String Never! {
    name_text(tables.names, token.text)
}

fn token_decoded(tables: TokenTables, token: Token) -> String Never! {
    name_text(tables.names, token.decoded)
}

fn token_integer(tables: TokenTables, token: Token) -> Int? Never! {
    if token.literal < 0 -> return None
    tables.literals[token.literal].integer
}

fn token_decimal(tables: TokenTables, token: Token) -> Float? Never! {
    if token.literal < 0 -> return None
    tables.literals[token.literal].decimal
}

fn token_suffix(tables: TokenTables, token: Token) -> String Never! {
    if token.literal < 0 -> return ""
    name_text(tables.names, tables.literals[token.literal].suffix)
}

fn token_interpolations(tables: TokenTables, token: Token) -> Int Never! {
    if token.literal < 0 -> return 0
    tables.literals[token.literal].interpolations
}

fn token_string_part_count(tables: TokenTables, token: Token) -> Int Never! {
    if token.literal < 0 -> return 0
    tables.literals[token.literal].string_parts.len()
}

fn token_string_parts(tables: TokenTables, token: Token) -> [StringPart] Never! {
    if token.literal < 0 -> return [StringPart]{}
    tables.literals[token.literal].string_parts
}

fn shifted_token_span(span: Span, offset: Int) -> Span Never! {
    Span{start: span.start + offset, end: span.end + offset}
}

// Moves a token, its literal's string parts and their tokens by `offset`.
fn token_shift_spans(token: &Token, offset: Int, literals: &[TokenLiteral]) Never! {
    token.span = shifted_token_span(token.span, offset)
    if token.literal < 0 -> return
    row :: token.literal
    loop part_index in 0..<literals[row].string_parts.len() {
        literals[row].string_parts[part_index].span = shifted_token_span(literals[row].string_parts[part_index].span, offset)
        loop nested_index in 0..<literals[row].string_parts[part_index].tokens.len() {
            nested := literals[row].string_parts[part_index].tokens[nested_index]
            token_shift_spans(&nested, offset, &literals)
            literals[row].string_parts[part_index].tokens[nested_index] = nested
        }
    }
}

// These numeric tags are stable at the Jet parser boundary and align with the
// exhaustive raw-token transport consumed by statement termination.
TOKEN_IDENT :: 1
TOKEN_RAW_STRING :: 2
TOKEN_STRING :: 3
TOKEN_INT :: 4
TOKEN_FLOAT :: 5
TOKEN_UNIT_NUMBER :: 6
TOKEN_CHAR :: 7
TOKEN_TRUE :: 8
TOKEN_FALSE :: 9
TOKEN_SELF :: 10
TOKEN_NULL :: 11
TOKEN_BREAK :: 12
TOKEN_RETURN :: 13
TOKEN_RPAREN :: 14
TOKEN_RBRACKET :: 15
TOKEN_RBRACE :: 16
TOKEN_QUESTION :: 17
// `++` and `--` are single tokens that no grammar rule accepts, so `x++`, `--x`
// and `a--b` are syntax errors rather than a silent double sign.
TOKEN_PLUS_PLUS :: 18
TOKEN_MINUS_MINUS :: 19
TOKEN_GT :: 20
TOKEN_SHR :: 21
TOKEN_FENCE_CLOSE :: 22
TOKEN_DOT :: 23
TOKEN_QUESTION_DOT :: 24
TOKEN_AND_AND :: 25
TOKEN_OR_OR :: 26
TOKEN_PLUS :: 27
TOKEN_MINUS :: 28
TOKEN_STAR :: 29
TOKEN_SLASH :: 30
TOKEN_SLASH_PERCENT :: 31
TOKEN_PERCENT :: 32
TOKEN_PERCENT_PERCENT :: 33
TOKEN_EQ_EQ :: 34
TOKEN_NOT_EQ :: 35
TOKEN_LT :: 36
TOKEN_LE :: 37
TOKEN_GE :: 38
TOKEN_COMPARE :: 39
TOKEN_AMP :: 40
TOKEN_PIPE :: 41
TOKEN_CARET :: 42
TOKEN_TILDE_PIPE :: 43
TOKEN_SHL :: 44
TOKEN_QUESTION_QUESTION :: 45
TOKEN_LBRACE :: 46
TOKEN_LPAREN :: 47
TOKEN_LBRACKET :: 48
TOKEN_EOF :: 49
TOKEN_BANG :: 50
TOKEN_UNIFIED_ARROW :: 51
TOKEN_EQ :: 54
TOKEN_LINE_COMMENT :: 55
TOKEN_BLOCK_COMMENT :: 56
TOKEN_KW_FN :: 57
TOKEN_KW_PUB :: 58
TOKEN_KW_PRIV :: 59
TOKEN_KW_IF :: 60
TOKEN_KW_ELSE :: 61
TOKEN_KW_IN :: 62
TOKEN_KW_MUTATE :: 63
TOKEN_KW_MOVE :: 64
TOKEN_KW_COPY :: 65
TOKEN_KW_STRUCT :: 66
TOKEN_KW_ENUM :: 67
TOKEN_KW_IMPL :: 68
TOKEN_KW_TRAIT :: 69
TOKEN_KW_TAG :: 70
TOKEN_KW_EFFECT :: 71
TOKEN_KW_DERIVE :: 72
TOKEN_KW_IT :: 73
TOKEN_KW_CONST :: 74
TOKEN_KW_COMPTIME :: 75
TOKEN_KW_LOOP :: 76
TOKEN_KW_YIELD :: 77
TOKEN_KW_USE :: 78
TOKEN_KW_EXTERN :: 79
TOKEN_KW_MODULE :: 80
TOKEN_FENCE_OPEN :: 81
TOKEN_COLON :: 82
TOKEN_COLON_COLON :: 83
TOKEN_COLON_EQ :: 84
TOKEN_COMMA :: 85
TOKEN_SEMI :: 86
TOKEN_DOT_DOT :: 87
TOKEN_DOT_DOT_LT :: 88
TOKEN_DOT_DOT_DOT :: 89
TOKEN_AT :: 90
TOKEN_TILDE :: 91
TOKEN_TILDE_PIPE_EQ :: 92
TOKEN_TILDE_TILDE :: 93
TOKEN_PLUS_EQ :: 94
TOKEN_MINUS_EQ :: 95
TOKEN_STAR_EQ :: 96
TOKEN_SLASH_EQ :: 97
TOKEN_SLASH_PERCENT_EQ :: 98
TOKEN_PERCENT_EQ :: 99
TOKEN_PERCENT_PERCENT_EQ :: 100
TOKEN_AMP_EQ :: 101
TOKEN_PIPE_EQ :: 102
TOKEN_CARET_EQ :: 103
TOKEN_SHL_EQ :: 104
TOKEN_SHR_EQ :: 105
TOKEN_HASH :: 106
TOKEN_DOLLAR :: 107

// Tokens.rs `without_comments`: the code tokens of `tokens`, comment trivia
// dropped, in source order.
fn lexer_without_comments(tokens: [Token]) -> [Token] Never! {
    kept := [Token]{}
    loop token in tokens {
        if token.kind != TOKEN_LINE_COMMENT && token.kind != TOKEN_BLOCK_COMMENT -> &kept.push(token)
    }
    kept
}
