// Stable parser-facing lexer data. Spans are UTF-8 byte offsets into the
// original source; payload.text preserves that exact source spelling.

pub struct TokenPayload {
    pub text: String
    pub decoded: String
    pub integer: Int?
    pub decimal: Float?
    pub suffix: String
    pub interpolations: Int
    pub string_parts: [StringPart]
}

pub struct Token {
    pub kind: Int
    pub span: Span
    pub payload: TokenPayload
}

pub struct StringPart {
    pub kind: Int
    pub span: Span
    pub text: String
    pub byte: Int
    pub tokens: [Token]
}

STRING_PART_TEXT :: 1
STRING_PART_INTERPOLATION :: 2
STRING_PART_BYTE :: 3

pub struct Lexed {
    pub tokens: [Token]
    pub diagnostics: [Diagnostic]
}

// These numeric tags are stable at the Jet parser boundary and align with the
// exhaustive raw-token transport consumed by statement termination.
TOKEN_IDENT :: 1
TOKEN_RAW_STRING :: 2
TOKEN_STRING :: 3
TOKEN_INT :: 4
TOKEN_FLOAT :: 5
TOKEN_UNIT_NUMBER :: 6
TOKEN_CHAR :: 7
TOKEN_TRUE :: 8
TOKEN_FALSE :: 9
TOKEN_SELF :: 10
