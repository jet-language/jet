// Source-backed payload construction and lexical diagnostics. `Scan.jet` owns
// token boundaries; this layer interns each token's exact spelling and decoded
// value and turns literal bytes into parser-ready literal facts without
// consulting the Rust lexer.
use {
    jet_foundation.[
        Diagnostic,
        DiagnosticLabel,
        Name,
        Span,
        diagnostic_from_registry,
        diagnostic_registry_row,
        name_empty,
        name_index,
        name_intern,
        name_intern_bytes,
        name_start,
    ]
    unicode: core.text
}

MAX_INTERPOLATION_DEPTH: 256

// The tokens and diagnostics of one lexed range; their names and literal
// facts went into the caller's `TokenTables`.
LexedTokens: struct {
    tokens: [Token]
    diagnostics: [Diagnostic]
}

// The interned spelling of `source[start..<end]`, clamped to the source as
// `slice_text` reads it.
intern_source: fn(tables: &TokenTables, source: [U8], start: Int, end: Int) -> Name Never! {
    bounded_end: if end > source.len() -> source.len() else -> end
    if start >= bounded_end -> return name_empty()
    name_intern_bytes(tables.names, source, start, bounded_end)
}

// A keyword or punctuation kind: the scanner gives every token of the kind
// the same bytes (literals, names, comments, fences and EOF excluded).
fixed_spelling_kind: fn(kind: Int) -> Bool Never! {
    (kind >= K_TRUE && kind <= K_SHR) || (kind >= K_DOT && kind <= K_LBRACKET) || kind == K_BANG || kind == K_UNIFIED_ARROW || kind == K_EQ || (kind >= K_FN && kind <= K_MODULE) || (kind >= K_COLON && kind <= K_DOLLAR)
}

// `intern_source` of a token of `kind`: a fixed-spelling kind reuses the id
// its first token interned (the same id the probe returns), checked against
// the spelling's length.
intern_token_source: fn(tables: &TokenTables, kind: Int, source: [U8], start: Int, end: Int) -> Name Never! {
    if !fixed_spelling_kind(kind) -> return intern_source(tables, source, start, end)
    cached: tables.spellings[kind]
    if cached > 0 && tables.names.ends[cached] - name_start(tables.names, cached) == end - start && end <= source.len() -> return Name{id: U32{cached}}
    text: intern_source(tables, source, start, end)
    tables.spellings[kind] = name_index(text)
    text
}

literal_row: fn(tables: &TokenTables, literal: TokenLiteral) -> Int Never! {
    tables.literals.push(literal)
    tables.literals.len() - 1
}

number_literal: fn(integer: Int?, decimal: Float?, suffix: Name) -> TokenLiteral Never! {
    TokenLiteral{integer: integer, decimal: decimal, suffix: suffix, interpolations: 0, string_parts: [StringPart]{}}
}

text_literal: fn(interpolations: Int, parts: [StringPart]) -> TokenLiteral Never! {
    TokenLiteral{integer: None, decimal: None, suffix: name_empty(), interpolations: interpolations, string_parts: parts}
}

add_diagnostic: fn(diagnostics: &[Diagnostic], code: String, start: Int, end: Int, what: String, why: String, fix: String) {
    diagnostics.push(diagnostic_from_registry(code, Val(Span{start: start, end: end}), what, why, fix))
}

bytes_text: fn(raw: [U8], start: Int, end: Int) -> String Never! {
    out := [U8]{}
    i := start
    loop i < end && i < raw.len() {
        out.push(raw[i])
        i += 1
    }
    String.from_bytes(out) ?? ""
}

bytes_slice: fn(raw: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    i := start
    loop i < end && i < raw.len() {
        out.push(raw[i])
        i += 1
    }
    out
}

strip_underscores: fn(text: String) -> String Never! {
    out := [U8]{}
    loop byte in text.bytes() {
        if Int.from_u8(byte) != 95 -> out.push(byte)
    }
    String.from_bytes(out) ?? ""
}

// Rust `lex_digits`: a decimal or unit-number spelling drops its `_`
// separators and writes its exponent marker as `e`.
decimal_number_spelling: fn(text: String) -> String Never! {
    out := [U8]{}
    loop byte in text.bytes() {
        code: Int.from_u8(byte)
        if code == 95 -> next
        out.push(if code == 69 -> U8{101} else -> byte)
    }
    String.from_bytes(out) ?? ""
}

digit_value: fn(value: Int) -> Int Never! {
    if value >= 48 && value <= 57 -> return value - 48
    if value >= 65 && value <= 90 -> return value - 55
    if value >= 97 && value <= 122 -> return value - 87
    return -1
}

parse_integer_literal: fn(text: String) -> Int? {
    clean: strip_underscores(text)
    raw := clean.bytes()
    if raw.len() == 0 -> return None
    // value * radix + digit <= I64 max (2^63 - 1) exactly when value < limit,
    // or value == limit and digit <= rest, with limit = max /% radix and rest
    // its remainder. Spelled out per radix: max itself is past the runtime's
    // inline Int range, so computing them per literal costs a big Int
    // division; every limit below is inline.
    radix := 10
    limit := 922337203685477580
    rest := 7
    i := 0
    if raw.len() > 1 && Int.from_u8(raw[0]) == 48 {
        marker: Int.from_u8(raw[1])
        if marker == {
            120 | 88 -> {
                radix = 16
                limit = 576460752303423487
                rest = 15
                i = 2
            }
            111 | 79 -> {
                radix = 8
                limit = 1152921504606846975
                rest = 7
                i = 2
            }
            98 | 66 -> {
                radix = 2
                limit = 4611686018427387903
                rest = 1
                i = 2
            }
            else -> {}
        }
    }
    if i >= raw.len() -> return None
    value := 0
    loop i < raw.len() {
        digit: digit_value(Int.from_u8(raw[i]))
        if digit < 0 || digit >= radix -> return None
        if value > limit || (value == limit && digit > rest) -> return None
        value = value * radix + digit
        i += 1
    }
    Val(value)
}

parse_float_literal: fn(text: String) -> Float? {
    clean: strip_underscores(text)
    value: Float.parse(clean) ?? return None
    Val(value)
}

escape_value: fn(value: Int) -> Int Never! {
    if value == {
        110 -> 10
        114 -> 13
        116 -> 9
        34 -> 34
        92 -> 92
        else -> -1
    }
}

hex_value: fn(value: Int) -> Int Never! {
    digit: digit_value(value)
    if digit >= 0 && digit < 16 -> digit else -> -1
}

previous_code_index: fn(facts: [Int], index: Int) -> Int Never! {
    cursor := index - 1
    loop cursor >= 0 {
        kind: kind_at(facts, cursor)
        if kind != K_LINE_COMMENT && kind != K_BLOCK_COMMENT -> return cursor
        cursor -= 1
    }
    -1
}

fact_text: fn(source: [U8], facts: [Int], index: Int) -> String Never! {
    if index < 0 || index >= facts.len() /% 4 -> return ""
    slice_text(source, facts[index * 4 + 1], facts[index * 4 + 2])
}

string_head_modes: fn(source: [U8], facts: [Int], index: Int) -> (raw_head: Bool, byte_head: Bool) Never! {
    open: previous_code_index(facts, index)
    if open < 0 || kind_at(facts, open) != K_LBRACE -> return (byte_head: false, raw_head: false)
    before_open: previous_code_index(facts, open)
    raw := before_open >= 0 && kind_at(facts, before_open) == K_DOT
    // A typed head is a name whose first character is an
    // ASCII capital, as Rust's lexer reads it; non-ASCII capitals do not count.
    // A function's return type before its body (`-> String {`, `-> a.B {`)
    // is none.
    if before_open >= 0 && kind_at(facts, before_open) == K_IDENT && !returned_type_at(facts, qualified_start(facts, before_open)) {
        first: byte_at(source, facts[before_open * 4 + 1])
        if first >= 65 && first <= 90 -> raw = true
    }
    byte := false
    if before_open >= 0 && kind_at(facts, before_open) == K_RBRACKET {
        before_close: previous_code_index(facts, before_open)
        if {
            before_close >= 0 && kind_at(facts, before_close) == K_IDENT && fact_text(source, facts, before_close) == "U8" -> {
                before_type: previous_code_index(facts, before_close)
                byte = before_type >= 0 && kind_at(facts, before_type) == K_LBRACKET && !returned_type_at(facts, before_type)
            }
            else -> {
                if before_close >= 0 {
                    hash: previous_code_index(facts, before_close)
                    if hash >= 0 && kind_at(facts, hash) == K_HASH {
                        u8: previous_code_index(facts, hash)
                        if u8 >= 0 && kind_at(facts, u8) == K_IDENT && fact_text(source, facts, u8) == "U8" {
                            bracket: previous_code_index(facts, u8)
                            byte = bracket >= 0 && kind_at(facts, bracket) == K_LBRACKET && !returned_type_at(facts, bracket)
                        }
                    }
                }
            }
        }
    }
    (byte_head: byte, raw_head: raw)
}

// Whether the type whose first token is at `first` is a function's return
// type: `name: fn(...) -> ` (or `name: fn<...>(...) -> `, `Owner.name: fn(...) -> `,
// `fn(...) -> `) before it.
returned_type_at: fn(facts: [Int], first: Int) -> Bool Never! {
    arrow: previous_code_index(facts, first)
    if arrow < 0 || kind_at(facts, arrow) != K_UNIFIED_ARROW -> return false
    close: previous_code_index(facts, arrow)
    if close < 0 || kind_at(facts, close) != K_RPAREN -> return false
    paren: matching_open(facts, close, K_LPAREN, K_RPAREN)
    if paren < 0 -> return false
    cursor := previous_code_index(facts, paren)
    if cursor >= 0 && kind_at(facts, cursor) == K_GT {
        angle: matching_open(facts, cursor, K_LT, K_GT)
        cursor = if angle < 0 -> -1 else -> previous_code_index(facts, angle)
    }
    if cursor >= 0 && kind_at(facts, cursor) == K_IDENT -> cursor = previous_code_index(facts, qualified_start(facts, cursor))
    cursor >= 0 && kind_at(facts, cursor) == K_FN
}

// The first name of the dotted path `a.b.c` ending at the name at `last`.
qualified_start: fn(facts: [Int], last: Int) -> Int Never! {
    start := last
    loop {
        dot: previous_code_index(facts, start)
        name: if dot >= 0 && kind_at(facts, dot) == K_DOT -> previous_code_index(facts, dot) else -> -1
        if name < 0 || kind_at(facts, name) != K_IDENT -> break
        start = name
    }
    start
}

group_has_ffi_marker: fn(source: [U8], facts: [Int], hash_index: Int, limit: Int) -> Bool Never! {
    open: previous_code_index(facts, hash_index + 2)
    if open < 0 || kind_at(facts, open) != K_LBRACKET -> return false
    cursor := open + 1
    depth := 0
    segment_head := true
    loop cursor < limit {
        kind: kind_at(facts, cursor)
        // Rust's prelude scan drops comments before reading marker names.
        if kind == K_LINE_COMMENT || kind == K_BLOCK_COMMENT {
            cursor += 1
            next
        }
        if depth == 0 && segment_head && kind == K_IDENT && fact_text(source, facts, cursor) == "FFI" -> return true
        is_open_delimiter: if kind == {
            K_LPAREN -> true
            K_LBRACKET -> true
            K_LBRACE -> true
            else -> false
        }
        if is_open_delimiter -> depth += 1 else {
            is_close_delimiter: if kind == {
                K_RPAREN -> true
                K_RBRACKET -> true
                K_RBRACE -> true
                else -> false
            }
            if {
                is_close_delimiter -> {
                    if depth == 0 -> return false
                    depth -= 1
                }
                kind == K_COMMA && depth == 0 -> {
                    segment_head = true
                }
                depth == 0 -> {
                    segment_head = false
                }
                else -> {}
            }
        }
        cursor += 1
    }
    false
}

matching_open: fn(facts: [Int], index: Int, open_kind: Int, close_kind: Int) -> Int Never! {
    cursor := index
    depth := 0
    loop cursor >= 0 {
        kind: kind_at(facts, cursor)
        if kind == close_kind -> depth += 1
        if kind == open_kind {
            depth -= 1
            if depth == 0 -> return cursor
        }
        cursor -= 1
    }
    -1
}

has_ffi_marker: fn(source: [U8], facts: [Int], function_index: Int) -> Bool Never! {
    cursor := previous_code_index(facts, function_index)
    // `add: fn(…)`: the name path and its `:` sit between the markers and `fn`.
    if kind_at(facts, cursor) == K_COLON {
        cursor = previous_code_index(facts, cursor)
        loop cursor >= 0 && kind_at(facts, cursor) == K_IDENT {
            before: previous_code_index(facts, cursor)
            if before < 0 || kind_at(facts, before) != K_DOT {
                cursor = before
                break
            }
            cursor = previous_code_index(facts, before)
        }
    }
    loop cursor >= 0 {
        kind: kind_at(facts, cursor)
        // Comments, `pub` and `;` between markers and `fn` are skipped, as in
        // Rust's prelude filter.
        is_skipped: if kind == {
            K_PUB -> true
            K_SEMI -> true
            K_LINE_COMMENT -> true
            K_BLOCK_COMMENT -> true
            else -> false
        }
        if is_skipped {
            cursor -= 1
            next
        }
        if kind == K_IDENT {
            marker: previous_code_index(facts, cursor)
            if marker >= 0 && kind_at(facts, marker) == K_HASH {
                if fact_text(source, facts, cursor) == "FFI" -> return true
                cursor = marker - 1
                next
            }
        }
        if kind == K_RPAREN {
            open: matching_open(facts, cursor, K_LPAREN, K_RPAREN)
            marker := if open >= 0 -> previous_code_index(facts, open) else -> -1
            hash := if marker >= 0 -> previous_code_index(facts, marker) else -> -1
            if marker >= 0 && hash >= 0 && kind_at(facts, marker) == K_IDENT && kind_at(facts, hash) == K_HASH {
                if fact_text(source, facts, marker) == "FFI" -> return true
                cursor = hash - 1
                next
            }
        }
        if kind == K_RBRACKET {
            open: matching_open(facts, cursor, K_LBRACKET, K_RBRACKET)
            hash := if open >= 0 -> previous_code_index(facts, open) else -> -1
            if hash >= 0 && kind_at(facts, hash) == K_HASH {
                if group_has_ffi_marker(source, facts, hash, function_index) -> return true
                cursor = hash - 1
                next
            }
        }
        break
    }
    false
}

raw_foreign_body_at: fn(source: [U8], facts: [Int], index: Int) -> Bool Never! {
    open: previous_code_index(facts, index)
    if open < 0 || kind_at(facts, open) != K_LBRACE -> return false
    cursor := open - 1
    loop cursor >= 0 {
        if kind_at(facts, cursor) == K_FN -> return has_ffi_marker(source, facts, cursor)
        cursor -= 1
    }
    false
}

shifted_span: fn(span: Span, offset: Int) -> Span Never! {
    Span{start: span.start + offset, end: span.end + offset}
}

shifted_diagnostic: fn(diagnostic: &Diagnostic, offset: Int) Never! {
    diagnostic.span = if diagnostic.span == {
        .Val(span) -> Val(shifted_span(span, offset))
        .None -> None
    }
    if &diagnostic.edit == .Val(edit) -> edit.span = shifted_span(edit.span, offset)
    shifted_labels := [DiagnosticLabel]{}
    loop label in diagnostic.labels -> shifted_labels.push(DiagnosticLabel{span: shifted_span(label.span, offset), message: label.message})
    diagnostic.labels = shifted_labels
}

// The tokens of `facts`, which cover `source[from..<to]`: the gaps between
// facts are checked from `from` to `to` (the whole source for a one-range
// lex; a range of a chunked lex ends between tokens). The terminator
// `events` of the same facts apply in the same walk: each event's `;`
// lands before its fact's token, and its diagnostics go to
// `terminator_diagnostics`.
lex_payload_from_facts: fn(source: [U8], facts: [Int], events: [Int], config_surface: Bool, allow_reserved_identifiers: Bool, depth: Int, from: Int, to: Int, tables: &TokenTables, terminator_diagnostics: &[Diagnostic]) -> LexedTokens {
    tokens := [Token]{}
    diagnostics := [Diagnostic]{}
    cursor := from
    index := 0
    event_index := 0
    fact_count: facts.len() /% 4
    loop index < fact_count {
        event_index = terminator_events_apply(facts, events, event_index, index, tokens, terminator_diagnostics)
        kind: kind_at(facts, index)
        start: facts[index * 4 + 1]
        end: facts[index * 4 + 2]
        gap_diagnostic(source, facts, cursor, start, config_surface, allow_reserved_identifiers, depth, tables, diagnostics)
        text: intern_token_source(tables, kind, source, start, end)
        built: payload_for(kind, source, facts, index, text, config_surface, allow_reserved_identifiers, depth, tables, diagnostics)
        if built.keep -> tokens.push(Token{kind: kind, span: Span{start: start, end: end}, text: text, decoded: built.decoded, literal: built.literal})
        cursor = end
        index += 1
    }
    gap_diagnostic(source, facts, cursor, to, config_surface, allow_reserved_identifiers, depth, tables, diagnostics)
    // An interpolation's nested source is a copy of bytes the depth-0 range
    // already covers.
    if depth == 0 -> lexer_report_bidi_controls(source, from, to, diagnostics)
    LexedTokens{tokens: tokens.move(), diagnostics: diagnostics.move()}
}

// A literal bidirectional control (U+202A-U+202E, U+2066-U+2069) starts at
// `at`. It reorders how the text around it displays, so the code a reviewer
// reads could differ from the code Jet compiles.
lexer_bidi_control_at: fn(source: [U8], at: Int) -> Bool Never! {
    if byte_at(source, at) != 226 -> return false
    second: byte_at(source, at + 1)
    third: byte_at(source, at + 2)
    (second == 128 && third >= 170 && third <= 174) || (second == 129 && third >= 166 && third <= 169)
}

// E0088: every literal bidirectional control in `source[from..<to]`, in
// code, comments and quoted text alike.
lexer_report_bidi_controls: fn(source: [U8], from: Int, to: Int, diagnostics: &[Diagnostic]) {
    at := from
    loop at < to {
        if byte_at(source, at) == 226 && lexer_bidi_control_at(source, at) {
            row: diagnostic_registry_row("E0088") ?? panic("E0088 has no registry row")
            add_diagnostic(diagnostics, row.code, at, at + 3, row.what.replace("{{character}}", codepoint_hex(scalar_codepoint(source, at, 3))), row.why, row.fix)
            at += 3
            next
        }
        at += 1
    }
}

// An interpolation's nested source: payload only, no terminator pass.
lex_payload_at_depth: fn(source: [U8], config_surface: Bool, allow_reserved_identifiers: Bool, depth: Int, tables: &TokenTables) -> LexedTokens {
    facts: raw_token_facts(source, config_surface)
    unused := [Diagnostic]{}
    lex_payload_from_facts(source, facts, [Int]{}, config_surface, allow_reserved_identifiers, depth, 0, source.len(), tables, unused)
}

lex_expression: fn(source: [U8], start: Int, end: Int, config_surface: Bool, allow_reserved_identifiers: Bool, depth: Int, span: Span, tables: &TokenTables, diagnostics: &[Diagnostic]) -> [Token] {
    if depth >= MAX_INTERPOLATION_DEPTH {
        add_diagnostic(diagnostics, "E1403", span.start, span.end, "source nesting exceeds the supported limit", "interpolated expressions are lexed as nested Jet source", "pull inner parts out into named bindings or helper functions")
        return [Token]{}
    }
    nested_source := bytes_slice(source, start, end)
    nested := lex_payload_at_depth(nested_source, false, allow_reserved_identifiers, depth + 1, tables)
    nested_diagnostics := nested.diagnostics.move()
    loop source_diagnostic in nested_diagnostics.move() {
        diagnostic := source_diagnostic.move()
        shifted_diagnostic(diagnostic, start)
        diagnostics.push(diagnostic)
    }
    index := 0
    loop index < nested.tokens.len() {
        token_shift_spans(nested.tokens[index], start, tables.literals)
        index += 1
    }
    nested.tokens
}

only_whitespace: fn(source: [U8], start: Int, end: Int) -> Bool {
    cursor := start
    loop cursor < end {
        if !is_whitespace_at(source, cursor) -> return false
        cursor += utf8_width(source, cursor)
    }
    true
}

interpolation_end: fn(source: [U8], start: Int, limit: Int) -> Int Never! {
    cursor := start + 1
    depth := 1
    loop cursor < limit {
        value: byte_at(source, cursor)
        if value == 47 && byte_at(source, cursor + 1) == 47 {
            cursor += 2
            loop cursor < limit && byte_at(source, cursor) != 10 -> cursor += utf8_width(source, cursor)
            next
        }
        if value == 47 && byte_at(source, cursor + 1) == 42 {
            cursor += 2
            comment_depth := 1
            loop cursor < limit && comment_depth > 0 {
                if {
                    byte_at(source, cursor) == 47 && byte_at(source, cursor + 1) == 42 -> {
                        comment_depth += 1
                        cursor += 2
                    }
                    byte_at(source, cursor) == 42 && byte_at(source, cursor + 1) == 47 -> {
                        comment_depth -= 1
                        cursor += 2
                    }
                    else -> {
                        cursor += utf8_width(source, cursor)
                    }
                }
            }
            if comment_depth > 0 -> return -1
            next
        }
        if value == 34 {
            triple := byte_at(source, cursor + 1) == 34 && byte_at(source, cursor + 2) == 34
            nested: if triple -> scan_triple_string_end(source, cursor, false) else -> scan_plain_string_end(source, cursor, false)
            if nested < 0 || nested > limit -> return -1
            cursor = nested
            next
        }
        if value == 39 {
            nested: scan_char_end(source, cursor)
            if nested < 0 || nested > limit -> return -1
            cursor = nested
            next
        }
        if value == 96 {
            fence := 0
            loop cursor + fence < limit && byte_at(source, cursor + fence) == 96 -> fence += 1
            fence_end := cursor + fence
            closed := false
            loop fence_end < limit {
                if byte_at(source, fence_end) != 96 {
                    fence_end += 1
                    next
                }
                run_start := fence_end
                loop fence_end < limit && byte_at(source, fence_end) == 96 -> fence_end += 1
                if fence_end - run_start == fence {
                    closed = true
                    break
                }
            }
            if !closed -> return -1
            cursor = fence_end
            next
        }
        if value == 123 -> depth += 1
        if value == 125 {
            depth -= 1
            if depth == 0 -> return cursor
        }
        cursor += utf8_width(source, cursor)
    }
    -1
}

// Literal text grows in byte buffers: rebuilding a String per scalar made a
// long literal cost quadratic time. Only ASCII escape bytes are pushed one by
// one (a lone byte >= 128 is no UTF-8 text); scalars are copied whole.
push_ascii_byte: fn(out: &[U8], value: Int) Never! {
    if value >= 0 && value < 128 -> out.push(U8{value})
}

push_text: fn(out: &[U8], text: String) Never! {
    loop byte in text.bytes() -> out.push(byte)
}

text_from_bytes: fn(bytes: [U8]) -> String Never! {
    String.from_bytes(bytes) ?? ""
}

append_text_part: fn(parts: &[StringPart], start: Int, end: Int, text: Name) Never! {
    parts.push(StringPart{
        kind: STRING_PART_TEXT,
        span: Span{start: start, end: end},
        text: text,
        byte: 0,
        tokens: [Token]{},
    })
}

decode_string_content: fn(source: [U8], start: Int, end: Int, triple: Bool, indent: Int, raw_head: Bool, byte_head: Bool, config_surface: Bool, allow_reserved_identifiers: Bool, depth: Int, tables: &TokenTables, diagnostics: &[Diagnostic]) -> (decoded: String, interpolations: Int, parts: [StringPart], valid: Bool) {
    decoded := [U8]{}
    literal := [U8]{}
    parts := [StringPart]{}
    interpolations := 0
    valid := true
    cursor := start
    literal_start := start
    at_line_start := triple
    loop cursor < end {
        if at_line_start {
            stripped := 0
            loop stripped < indent && cursor < end && (byte_at(source, cursor) == 32 || byte_at(source, cursor) == 9) {
                cursor += 1
                stripped += 1
            }
            at_line_start = false
            if literal_start == start && literal.len() == 0 -> literal_start = cursor
        }
        value: byte_at(source, cursor)
        // Plain ASCII text bytes copy through inline.
        if value >= 0 && value < 128 && value != 10 && value != 92 && value != 123 && value != 125 {
            literal.push(U8{value})
            decoded.push(U8{value})
            cursor += 1
            next
        }
        if value == 10 {
            literal.push(U8{10})
            decoded.push(U8{10})
            cursor += 1
            if triple -> at_line_start = true
            next
        }
        if value == 92 {
            if raw_head {
                literal.push(U8{92})
                decoded.push(U8{92})
                if {
                    byte_at(source, cursor + 1) == 34 -> {
                        literal.push(U8{34})
                        decoded.push(U8{34})
                        cursor += 2
                    }
                    else -> {
                        cursor += 1
                    }
                }
                next
            }
            next_value: byte_at(source, cursor + 1)
            if byte_head && next_value == 120 {
                high: hex_value(byte_at(source, cursor + 2))
                low: hex_value(byte_at(source, cursor + 3))
                if high >= 0 && low >= 0 && cursor + 3 < end {
                    if literal.len() > 0 {
                        append_text_part(parts, literal_start, cursor, name_intern_bytes(tables.names, literal, 0, literal.len()))
                        literal = [U8]{}
                    }
                    parts.push(StringPart{
                        kind: STRING_PART_BYTE,
                        span: Span{start: cursor, end: cursor + 4},
                        text: name_empty(),
                        byte: high * 16 + low,
                        tokens: [Token]{},
                    })
                    cursor += 4
                    literal_start = cursor
                    next
                }
                add_diagnostic(diagnostics, "E0001", cursor, cursor + 4, "`\\x` needs two hexadecimal digits", "a byte escape writes one byte as `\\xNN`, where both digits are hexadecimal", "write two hexadecimal digits after `\\x`, for example `\\x00`")
                cursor += 2
                next
            }
            escaped: escape_value(next_value)
            escape_width: utf8_width(source, cursor + 1)
            escape_end := cursor + 1 + escape_width
            if {
                escaped < 0 -> {
                    escape_text: bytes_text(source, cursor + 1, escape_end)
                    what := "`\\{escape_text}` isn't an escape Jet knows"
                    why: "inside quoted text, `\\` starts an escape: `\\n` (new line), `\\r` (carriage return), `\\t` (tab), `\\\"` (quote), `\\\\` (backslash)"
                    add_diagnostic(diagnostics, "E0001", cursor, escape_end, what, why, "write `\\\\` for a real backslash")
                }
                else -> {
                    push_ascii_byte(literal, escaped)
                    push_ascii_byte(decoded, escaped)
                }
            }
            cursor = escape_end
            next
        }
        if value == 123 && byte_at(source, cursor + 1) == 123 {
            literal.push(U8{123})
            decoded.push(U8{123})
            cursor += 2
            next
        }
        if value == 125 && byte_at(source, cursor + 1) == 125 {
            literal.push(U8{125})
            decoded.push(U8{125})
            cursor += 2
            next
        }
        // A `\$` template payload (`\${…}`) is downstream text, copied byte
        // for byte as Rust's lexer keeps it.
        if value == 123 && literal.len() >= 2 && Int.from_u8(literal[literal.len() - 2]) == 92 && Int.from_u8(literal[literal.len() - 1]) == 36 {
            literal.push(U8{123})
            decoded.push(U8{123})
            cursor += 1
            nesting := 1
            loop cursor < end && nesting > 0 {
                next_byte: byte_at(source, cursor)
                literal.push(U8{(next_byte).bit_and(255)})
                decoded.push(U8{(next_byte).bit_and(255)})
                if next_byte == 123 -> nesting += 1
                if next_byte == 125 -> nesting -= 1
                cursor += 1
            }
            next
        }
        if value == 125 {
            add_diagnostic(diagnostics, "E0001", cursor, cursor + 1, "a lone `}}` inside quoted text", "inside quoted text, `{{` and `}}` mark an interpolated value, so a literal brace is doubled", "write `}}}}` to print a `}}`")
            cursor += 1
            next
        }
        if value == 123 {
            close: interpolation_end(source, cursor, end)
            if close < 0 {
                add_diagnostic(diagnostics, "E0002", cursor, end, "this `{{` never gets a matching `}}`", "`{{` inside quoted text starts an interpolated value and needs a closing `}}` before the text ends; escaped braces use `{{{{`/`}}}}`, while raw backtick strings keep braces literal", "add a `}}` after the value, write `{{{{` for an escaped brace, or write the text as ``…`` for raw text")
                valid = false
                cursor = end
                break
            }
            if only_whitespace(source, cursor + 1, close) {
                add_diagnostic(diagnostics, "E0003", cursor, close + 1, "there's nothing inside this `{{ }}` to show", "interpolation puts a value into the text, so the braces need a value", "put a value inside, like `{{name}}`, or write `{{{{}}}}` for literal braces")
                cursor = close + 1
                literal_start = cursor
                next
            }
            if literal.len() > 0 {
                append_text_part(parts, literal_start, cursor, name_intern_bytes(tables.names, literal, 0, literal.len()))
                literal = [U8]{}
            }
            expr_start := cursor + 1
            part_span := Span{start: cursor, end: close + 1}
            children: lex_expression(source, expr_start, close, config_surface, allow_reserved_identifiers, depth, part_span, tables, diagnostics)
            parts.push(StringPart{
                kind: STRING_PART_INTERPOLATION,
                span: part_span,
                text: intern_source(tables, source, expr_start, close),
                byte: 0,
                tokens: children,
            })
            interpolations += 1
            cursor = close + 1
            literal_start = cursor
            next
        }
        if value >= 0 && value < 128 {
            literal.push(U8{value})
            decoded.push(U8{value})
            cursor += 1
            next
        }
        width: utf8_width(source, cursor)
        scalar: bytes_text(source, cursor, cursor + width)
        push_text(literal, scalar)
        push_text(decoded, scalar)
        cursor += width
    }
    if literal.len() > 0 || parts.len() == 0 -> append_text_part(parts, literal_start, end, name_intern_bytes(tables.names, literal, 0, literal.len()))
    (decoded: text_from_bytes(decoded), interpolations: interpolations, parts: parts, valid: valid)
}

decode_raw_string: fn(text: String, source_start: Int, tables: &TokenTables) -> (decoded: String, parts: [StringPart]) Never! {
    raw: text.bytes()
    if raw.len() == 0 -> return (decoded: "", parts: [StringPart]{})
    fence := 0
    loop fence < raw.len() && Int.from_u8(raw[fence]) == 96 -> fence += 1
    if fence == 0 || raw.len() < fence * 2 -> return (decoded: "", parts: [StringPart]{})
    begin := fence
    finish := raw.len() - fence
    padded := false
    if finish > begin + 1 && Int.from_u8(raw[begin]) == 32 && Int.from_u8(raw[finish - 1]) == 32 {
        cursor := begin
        loop cursor < finish {
            if Int.from_u8(raw[cursor]) != 32 {
                padded = true
                break
            }
            cursor += 1
        }
    }
    if padded {
        begin += 1
        finish -= 1
    }
    decoded: bytes_text(raw, begin, finish)
    parts := [StringPart]{}
    append_text_part(parts, source_start + begin, source_start + finish, name_intern(tables.names, decoded))
    (decoded: decoded, parts: parts)
}

// Use the same first offending run and byte span as Native.
check_triple_delimiter_text: fn(source: [U8], begin: Int, end: Int, position: String, diagnostics: &[Diagnostic]) {
    finish := end
    if byte_at(source, end) == 10 && finish > begin && byte_at(source, finish - 1) == 13 -> finish -= 1
    first := begin
    loop first < finish && (byte_at(source, first) == 32 || byte_at(source, first) == 9) -> first += 1
    if first == finish -> return
    last := first
    loop last < finish && byte_at(source, last) != 32 && byte_at(source, last) != 9 -> last += utf8_width(source, last)
    row: diagnostic_registry_row("E0084") ?? panic("E0084 has no registry row")
    add_diagnostic(diagnostics, row.code, first, last, row.what.replace("{{position}}", position), row.why, row.fix)
}

decode_string: fn(source: [U8], facts: [Int], index: Int, start: Int, end: Int, config_surface: Bool, allow_reserved_identifiers: Bool, depth: Int, tables: &TokenTables, diagnostics: &[Diagnostic]) -> (decoded: String, interpolations: Int, parts: [StringPart], valid: Bool) {
    triple := byte_at(source, start) == 34 && byte_at(source, start + 1) == 34 && byte_at(source, start + 2) == 34
    if triple && raw_foreign_body_at(source, facts, index) {
        body_start := start + 3
        body_end := end - 3
        body: slice_text(source, body_start, body_end)
        parts := [StringPart]{}
        append_text_part(parts, body_start, body_end, name_intern(tables.names, body))
        return (decoded: body, interpolations: 0, parts: parts, valid: true)
    }
    modes: string_head_modes(source, facts, index)
    content_start := start + 1
    content_end := end - 1
    indent := 0
    if triple {
        open_end := start + 3
        close := end - 3
        close_line_start := close
        loop close_line_start > open_end && byte_at(source, close_line_start - 1) != 10 -> close_line_start -= 1
        only_indent := true
        loop cursor in close_line_start..<close {
            if byte_at(source, cursor) != 32 && byte_at(source, cursor) != 9 -> only_indent = false
        }
        if only_indent -> indent = close - close_line_start
        content_start = open_end
        cursor := open_end
        loop cursor < close && byte_at(source, cursor) != 10 -> cursor += utf8_width(source, cursor)
        check_triple_delimiter_text(source, open_end, cursor, "after the opening", diagnostics)
        check_triple_delimiter_text(source, close_line_start, close, "before the closing", diagnostics)
        if cursor < close && byte_at(source, cursor) == 10 -> content_start = cursor + 1
        content_end = close_line_start
        if content_end > content_start && byte_at(source, content_end - 1) == 10 -> content_end -= 1
        if content_end < content_start -> content_end = content_start
    }
    decode_string_content(source, content_start, content_end, triple, indent, modes.raw_head, modes.byte_head, config_surface, allow_reserved_identifiers, depth, tables, diagnostics)
}

decode_char: fn(text: String, source_start: Int, diagnostics: &[Diagnostic]) -> String {
    raw: text.bytes()
    if raw.len() < 2 -> return ""
    if Int.from_u8(raw[1]) != 92 {
        width: utf8_width(raw, 1)
        if byte_at(raw, 1 + width) != 39 {
            span_end := source_start + 1 + width
            if span_end > source_start + raw.len() -> span_end = source_start + raw.len()
            add_diagnostic(diagnostics, "E0002", source_start, span_end, "a character literal must be exactly one character", "write `'x'` with a single character between the quotes", "use a String for longer text")
        }
        return bytes_text(raw, 1, 1 + width)
    }
    escape_width := 0
    if raw.len() > 2 -> escape_width = utf8_width(raw, 2)
    escape_end := 2 + escape_width
    escaped := -1
    if escape_width > 0 {
        escaped = if Int.from_u8(raw[2]) == 39 -> 39 else -> escape_value(Int.from_u8(raw[2]))
    }
    if escaped < 0 {
        escape_text: bytes_text(raw, 2, escape_end)
        what := "`\\{escape_text}` isn't an escape Jet knows"
        why: "inside a character literal, `\\` starts an escape: `\\n`, `\\r`, `\\t`, `\\'`, `\\\\`"
        add_diagnostic(diagnostics, "E0001", source_start + 1, source_start + escape_end, what, why, "use a supported escape or a plain character")
    }
    if byte_at(raw, escape_end) != 39 {
        span_end := source_start + escape_end
        if span_end > source_start + raw.len() -> span_end = source_start + raw.len()
        add_diagnostic(diagnostics, "E0002", source_start, span_end, "a character literal must be exactly one character", "write `'x'` with a single character between the quotes", "use a String for longer text")
    }
    if escaped < 0 -> return "?"
    String.from_bytes([U8]{U8{escaped}}) ?? ""
}

numeric_payload: fn(kind: Int, source: [U8], start: Int, end: Int, tables: &TokenTables, diagnostics: &[Diagnostic]) -> (decoded: Name, literal: Int) {
    numeric_end: scan_numeric_end(source, start)
    bounded_end := numeric_end
    if bounded_end < start || bounded_end > end -> bounded_end = end
    number_text: slice_text(source, start, bounded_end)
    suffix := name_empty()
    if kind == K_UNIT_NUMBER -> suffix = intern_source(tables, source, bounded_end, end)
    marker: byte_at(source, start + 1)
    radix := if marker == {
        120 | 88 -> 16
        111 | 79 -> 8
        98 | 66 -> 2
        else -> 0
    }
    base_prefix := byte_at(source, start) == 48 && radix > 0
    has_base_digit := false
    if base_prefix {
        cursor := start + 2
        loop cursor < bounded_end {
            if base_digit(byte_at(source, cursor), radix) -> has_base_digit = true
            cursor += 1
        }
    }
    if base_prefix && !has_base_digit {
        add_diagnostic(diagnostics, "E0001", start, end, "this number prefix has no digits after it", "`0x`, `0o`, and `0b` must be followed by digits, e.g. `0xFF`, `0o17`, `0b1010`", "add digits after the base prefix")
        decoded: intern_source(tables, source, start, bounded_end)
        return (decoded: decoded, literal: literal_row(tables, number_literal(Val(0), None, name_empty())))
    }
    is_float := if kind == {
        K_FLOAT -> true
        K_UNIT_NUMBER -> numeric_is_float(source, start)
        else -> false
    }
    if is_float {
        decoded: name_intern(tables.names, decimal_number_spelling(number_text))
        return (decoded: decoded, literal: literal_row(tables, number_literal(None, Val(parse_float_literal(number_text) ?? Float{0}), suffix)))
    }
    decoded: if kind == K_UNIT_NUMBER -> name_intern(tables.names, decimal_number_spelling(number_text)) else -> intern_source(tables, source, start, bounded_end)
    (decoded: decoded, literal: literal_row(tables, number_literal(Val(parse_integer_literal(number_text) ?? 0), None, suffix)))
}

// Identifier check: reserved double-underscore names. No identifier is
// respelled. The `c.<lib>.__bindgen__` module path segment has its own
// reports (spec.md "C ABI"): the parser's E3206 for an authored path and the
// driver's E3207 for a hand-written `#Bindgen`, so it skips E0067 here.
identifier_respelling: fn(source: [U8], start: Int, end: Int, allow_reserved_identifiers: Bool, diagnostics: &[Diagnostic]) -> String? {
    width: end - start
    if !allow_reserved_identifiers && width >= 2 && byte_at(source, start) == 95 && byte_at(source, start + 1) == 95 {
        text: slice_text(source, start, end)
        if text == "__bindgen__" && start > 0 && byte_at(source, start - 1) == 46 -> return None
        add_diagnostic(diagnostics, "E0067", start, end, "`{text}` is reserved for Jet", "double-underscore names belong to the compiler, generated binders, debugger, serializer, and tools", "rename it without the second leading underscore")
    }
    None
}

source_has_text: fn(source: [U8], at: Int, expected: String) -> Bool Never! {
    wanted: expected.bytes()
    loop offset in 0..<wanted.len() {
        if byte_at(source, at + offset) != Int.from_u8(wanted[offset]) -> return false
    }
    true
}

text_in: fn(name: String, values: [String]) -> Bool Never! {
    loop value in values {
        if value == name -> return true
    }
    false
}

scalar_codepoint: fn(source: [U8], start: Int, width: Int) -> Int Never! {
    first: byte_at(source, start)
    if width == 2 -> return (first - 192) * 64 + (byte_at(source, start + 1) - 128)
    if width == 3 -> return (first - 224) * 4096 + (byte_at(source, start + 1) - 128) * 64 + (byte_at(source, start + 2) - 128)
    if width == 4 -> return (first - 240) * 262144 + (byte_at(source, start + 1) - 128) * 4096 + (byte_at(source, start + 2) - 128) * 64 + (byte_at(source, start + 3) - 128)
    first
}

codepoint_hex: fn(value: Int) -> String Never! {
    digits := [Int]{}
    remaining := value
    loop remaining > 0 {
        digit: remaining - remaining /% 16 * 16
        digits.push(digit)
        remaining = remaining /% 16
    }
    loop digits.len() < 4 -> digits.push(0)
    out := [U8]{}
    cursor := digits.len() - 1
    loop cursor >= 0 {
        digit: digits[cursor]
        byte := 48 + digit
        if digit >= 10 -> byte = 55 + digit
        out.push(U8{byte})
        cursor -= 1
    }
    hex: String.from_bytes(out) ?? "0000"
    "U+{hex}"
}

printable_character: fn(source: [U8], start: Int, width: Int) -> String {
    value: byte_at(source, start)
    if value == 0 -> return "\\0"
    if value == 9 -> return "\\t"
    scalar: bytes_text(source, start, start + width)
    if unicode.display_width(scalar) == 0 -> return codepoint_hex(scalar_codepoint(source, start, width))
    scalar
}

fact_index_at: fn(facts: [Int], start: Int) -> Int Never! {
    index := 0
    loop index < facts.len() /% 4 && facts[index * 4 + 1] < start -> index += 1
    index
}

gap_diagnostic: fn(source: [U8], facts: [Int], start: Int, end: Int, config_surface: Bool, allow_reserved_identifiers: Bool, depth: Int, tables: &TokenTables, diagnostics: &[Diagnostic]) {
    cursor := start
    loop cursor < end {
        // ASCII whitespace (every ordinary gap byte) advances inline.
        gap_byte: byte_at(source, cursor)
        if gap_byte == 32 || (gap_byte >= 9 && gap_byte <= 13) {
            cursor += 1
            next
        }
        if cursor == 0 && byte_at(source, 0) == 35 && byte_at(source, 1) == 33 && byte_at(source, 2) == 47 {
            loop cursor < end && byte_at(source, cursor) != 10 -> cursor += 1
            if cursor < end -> cursor += 1
            next
        }
        if is_whitespace_at(source, cursor) {
            cursor += utf8_width(source, cursor)
            next
        }
        value: byte_at(source, cursor)
        if value == 35 && byte_at(source, cursor + 1) == 33 && byte_at(source, cursor + 2) == 47 {
            add_diagnostic(diagnostics, "E0042", cursor, cursor + 2, "a shebang line is only recognized at the very start of the file", "the operating system reads launch metadata only from byte 0; Jet does not treat another `#!` as a launch line", "move `#!...` to line 1, or delete it")
            loop cursor < end && byte_at(source, cursor) != 10 -> cursor += 1
            if cursor < end -> cursor += 1
            next
        }
        if value == 34 {
            index: fact_index_at(facts, cursor)
            triple := byte_at(source, cursor + 1) == 34 && byte_at(source, cursor + 2) == 34
            if triple {
                if {
                    raw_foreign_body_at(source, facts, index) -> {
                        add_diagnostic(diagnostics, "E0002", cursor, source.len(), "this raw foreign body never gets a closing `\"\"\"`", "a `#FFI` body preserves everything between its opening and closing `\"\"\"`", "add a closing `\"\"\"` after the foreign source")
                    }
                    else -> {
                        add_diagnostic(diagnostics, "E0002", cursor, source.len(), "this multi-line text never gets a closing `\"\"\"`", "a multi-line string starts and ends with `\"\"\"`", "add a closing `\"\"\"` on its own line")
                    }
                }
                return
            }
            // As in Rust's lexer, an unclosed string still reports what its
            // body teaches (escapes, lone braces, holes) up to the line end;
            // an unclosed `{` hole is then its one error, else the quote is.
            modes: string_head_modes(source, facts, index)
            scanned: scan_plain_string_end(source, cursor, modes.raw_head)
            stop: if scanned < 0 -> -scanned - 1 else -> scanned
            body: decode_string_content(source, cursor + 1, stop, false, 0, modes.raw_head, modes.byte_head, config_surface, allow_reserved_identifiers, depth, tables, diagnostics)
            if body.valid -> add_diagnostic(diagnostics, "E0002", cursor, stop, "this text never gets a closing quote", "a piece of text must start and end with a `\"` on the same line", "add a closing `\"` before the end of the line")
            cursor = stop
            next
        }
        if value == 96 {
            fence := 0
            loop byte_at(source, cursor + fence) == 96 -> fence += 1
            plural := if fence == 1 -> "" else -> "s"
            add_diagnostic(diagnostics, "E0002", cursor, source.len(), "this raw text never gets a closing backtick fence", "a raw string closes with a backtick run that has the same length as its opening run", "add a closing fence of {fence} backtick{plural}")
            return
        }
        if value == 39 {
            if cursor + 1 >= source.len() -> return
            add_diagnostic(diagnostics, "E0002", cursor, source.len(), "a character literal must be exactly one character", "write `'x'` with a single character between the quotes", "use a String for longer text")
            return
        }
        width: utf8_width(source, cursor)
        // A bidirectional control has its own report (E0088).
        if !lexer_bidi_control_at(source, cursor) {
            character: printable_character(source, cursor, width)
            add_diagnostic(diagnostics, "E0001", cursor, cursor + width, "the character `{character}` doesn't mean anything here (yet)", "unprintable characters are shown as `\\0`, `\\t`, or `U+XXXX` so you can identify them", "remove it, or use supported syntax")
        }
        cursor += width
    }
}

// The token's decoded spelling and literal row; `keep` is false for a string
// whose body cannot be decoded.
payload_for: fn(kind: Int, source: [U8], facts: [Int], index: Int, text: Name, config_surface: Bool, allow_reserved_identifiers: Bool, depth: Int, tables: &TokenTables, diagnostics: &[Diagnostic]) -> (decoded: Name, literal: Int, keep: Bool) {
    start: facts[index * 4 + 1]
    end: facts[index * 4 + 2]
    if kind == K_IDENT {
        decoded: if identifier_respelling(source, start, end, allow_reserved_identifiers, diagnostics) == {
            .Val(respelled) -> name_intern(tables.names, respelled)
            .None -> text
        }
        return (decoded: decoded, keep: true, literal: -1)
    }
    is_numeric_kind: if kind == {
        K_INT -> true
        K_FLOAT -> true
        K_UNIT_NUMBER -> true
        else -> false
    }
    if is_numeric_kind {
        number: numeric_payload(kind, source, start, end, tables, diagnostics)
        return (decoded: number.decoded, keep: true, literal: number.literal)
    }
    if kind == K_STR {
        decoded: decode_string(source, facts, index, start, end, config_surface, allow_reserved_identifiers, depth, tables, diagnostics)
        if !decoded.valid -> return (decoded: name_empty(), keep: false, literal: -1)
        return (decoded: name_intern(tables.names, decoded.decoded), keep: true, literal: literal_row(tables, text_literal(decoded.interpolations, decoded.parts)))
    }
    if kind == K_RAW_STR {
        raw: decode_raw_string(slice_text(source, start, end), start, tables)
        return (decoded: name_intern(tables.names, raw.decoded), keep: true, literal: literal_row(tables, text_literal(0, raw.parts)))
    }
    if kind == K_CHAR -> return (decoded: name_intern(tables.names, decode_char(slice_text(source, start, end), start, diagnostics)), keep: true, literal: -1)
    if kind == K_BLOCK_COMMENT && scan_block_comment_end(source, start) < 0 {
        add_diagnostic(diagnostics, "E0002", start, end, "this `/*` comment never gets a closing `*/`", "a block comment starts with `/*` and runs until a matching `*/`", "add a `*/` to close the comment")
    }
    (decoded: text, keep: true, literal: -1)
}

lexed_from: fn(source: [U8], config_surface: Bool, allow_reserved_identifiers: Bool) -> Lexed {
    tables := token_tables()
    raw: lex_payload_at_depth(source, config_surface, allow_reserved_identifiers, 0, tables)
    Lexed{tokens: raw.tokens, tables: tables, diagnostics: raw.diagnostics}
}

lex_payload: fn(source: [U8], config_surface: Bool) -> Lexed {
    lexed_from(source, config_surface, false)
}

lex_generated_payload: fn(source: [U8]) -> Lexed {
    lexed_from(source, false, true)
}
