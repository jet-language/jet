// Shared token relocation for generated-source slices in a compiler unit.
// Moved from Driver's foreign-provider parser; interpolation tokens retain the
// same aggregate coordinate system as their containing string token.
use jet_foundation.Span

pub fn lex_shift_token(token: &Token, offset: Int) Never! {
    token.span = Span{start: token.span.start + offset, end: token.span.end + offset}
    loop part_index in 0..<token.payload.string_parts.len() {
        part := token.payload.string_parts[part_index]
        part.span = Span{start: part.span.start + offset, end: part.span.end + offset}
        loop nested_index in 0..<part.tokens.len() {
            lex_shift_token(&part.tokens[nested_index], offset)
        }
        token.payload.string_parts[part_index] = part
    }
}
