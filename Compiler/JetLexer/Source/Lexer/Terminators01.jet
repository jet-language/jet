//RS /// Lex the whole file. Always returns a token stream (ending in Eof) plus
//RS /// every problem found along the way — M1 error recovery.
//RS ///
//RS /// S6-R: after raw lexing, a post-pass inserts a synthetic statement
//RS /// terminator (`Semi`) at each line end that follows a statement-ending token.
//RS /// The grammar stays terminator-based; users never type `;`.
//RS pub fn lex(src: &str) -> (Vec<Token>, Vec<Diagnostic>) {
//RS     let (mut toks, mut diags) = lex_raw(src);
//RS     insert_terminators(src, &mut toks, &mut diags);
//RS     (toks, diags)
//RS }
//RS 
//RS /// Lex a Jetpack config file. The only lexical difference from ordinary Jet
//RS /// source is that `://` inside an unquoted config template is URL punctuation,
//RS /// not the start of a line comment.
//RS pub fn lex_config(src: &str) -> (Vec<Token>, Vec<Diagnostic>) {
//RS     let (mut toks, mut diags) = lex_raw_config(src);
//RS     insert_terminators(src, &mut toks, &mut diags);
//RS     (toks, diags)
//RS }
//RS 
//RS /// Compiler/tool-generated Jet fragments may use the reserved `__name`
//RS /// namespace. User source must always go through [`lex`].
//RS pub fn lex_generated(src: &str) -> (Vec<Token>, Vec<Diagnostic>) {
//RS     let (mut toks, mut diags) = lex_raw_generated(src);
//RS     insert_terminators(src, &mut toks, &mut diags);
//RS     (toks, diags)
//RS }
