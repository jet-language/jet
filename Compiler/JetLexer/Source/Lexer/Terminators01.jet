//RS /// True when a token of this kind ends a statement, so a following line break
//RS /// should get a synthetic `Semi` (S6-R, Go's rule).
//RS fn ends_statement(kind: &TokKind) -> bool {
//RS     matches!(
//RS         kind,
//RS         TokKind::Ident(_)
//RS             | TokKind::RawStr(_)
//RS             | TokKind::Str(_)
//RS             | TokKind::Int(..)
//RS             | TokKind::Float(..)
//RS             | TokKind::UnitNumber { .. } // D-UNITLIT1: `500ms` ends a line like any literal
//RS             | TokKind::Char(_)
//RS             | TokKind::KwTrue
//RS             | TokKind::KwFalse
//RS             | TokKind::KwSelf
//RS             | TokKind::KwNull
//RS             | TokKind::KwBreak
//RS             | TokKind::KwReturn
//RS             | TokKind::RParen
//RS             | TokKind::RBracket
//RS             | TokKind::RBrace
//RS             | TokKind::Question      // S7: `expr?` trailing propagation
//RS             | TokKind::Bang          // D-TYPE-SUFFIX1: contract `SaveError!` at line end
//RS             | TokKind::PlusPlus      // retired D-INCR1: `x++` ends a statement so E0160
//RS             | TokKind::MinusMinus    // can offer its Safe `x += 1` / `x -= 1` edit
//RS             | TokKind::Gt            // generic type close `[Int]` at line end
//RS             | TokKind::Shr // nested generic close `Map<K, List<V>>`
//RS             | TokKind::FenceClose // D-FENCE2: `total += <: 10, 20 :>` at line end
//RS     )
//RS }
