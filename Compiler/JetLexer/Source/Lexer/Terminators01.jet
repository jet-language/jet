// Private continuation of JetLexer.Lexer.Terminators; existing raw tags and
// statement decisions stay in Terminators.jet.
use jet_foundation.[Diagnostic, Span, diagnostic_from_registry]
use core.concurrent.[ThreadLocal, Shared]

// Rust: crates/jet-lexer/src/Lexer/Terminators.rs:14
pub struct RawTokenFact { pub kind: U16; pub span: Span; pub uppercase: Bool }
// Rust: crates/jet-lexer/src/Lexer/Terminators.rs:22
pub enum TerminatorEvent { InsertSemi{before: Int, at: Int} SplitHeader{before: Int, at: Int} }
// Rust: crates/jet-lexer/src/Lexer/Terminators.rs:28
pub type TerminatorDriver = Shared<([U8], [RawTokenFact]) -> [TerminatorEvent] Err!>
// Rust: crates/jet-lexer/src/Lexer/Terminators.rs:31
// GATE #4494: actual thread-local storage and shared callback ownership.
DRIVER :: ThreadLocal<TerminatorDriver?>.new(fn() { None })
// Rust: crates/jet-lexer/src/Lexer/Terminators.rs:35
struct DriverGuard { previous: TerminatorDriver? }
impl DriverGuard {
    // Rust: crates/jet-lexer/src/Lexer/Terminators.rs:38
    fn drop(self: &DriverGuard) -> Unit Never! { DRIVER.with(fn(slot) { slot.replace(&self.previous.take()) }) }
}
// Rust: crates/jet-lexer/src/Lexer/Terminators.rs:44
pub fn terminator_driver() -> TerminatorDriver? Never! { DRIVER.with(fn(slot) { ~slot.get() }) }
// Rust: crates/jet-lexer/src/Lexer/Terminators.rs:49
pub fn with_terminator_driver<R>(driver: ^TerminatorDriver?, work: ^() -> R Never!) -> R Never! {
    restore :: DriverGuard{previous: DRIVER.with(fn(slot) { slot.replace(^driver) })}
    // Scope destruction restores the previous driver on normal or unwinding exit.
    work()
}
