// GATE #4494: compile-time source embedding, not a Rust callback or runtime reader.
pub TERMINATOR_PASS_SOURCE :: prep {
    include_str("Compiler/JetFoundation/Source/Diagnostics/Diagnostic.jet") + "\n" +
    include_str("Compiler/JetLexer/Source/Lexer/Scan.jet") + "\n" +
    include_str("Compiler/JetLexer/Source/Lexer/Terminators.jet") + "\n" +
    include_str("Compiler/JetLexer/Source/Lexer/Tokens.jet") + "\n" +
    include_str("Compiler/JetLexer/Source/Lexer/Payload.jet")
}
// Rust: crates/jet-lexer/src/Lexer/Terminators.rs:70
pub fn raw_token_fact(token: Token) -> RawTokenFact Never! {
    // Tokens.jet:43-149 is the exhaustive same-tag mapping of every Rust variant;
    // tag 52 is deliberately absent. Payload contents do not affect this tag.
    kind :: token.kind
    if kind < 1 || kind > 107 || kind == 52 -> panic("unknown raw token kind")
    uppercase :: kind == K_IDENT && token.payload.text.chars().first().is_some_and(fn(ch) { ch.is_uppercase() })
    RawTokenFact{kind: U16(kind), span: token.span, uppercase: uppercase}
}
// Rust: crates/jet-lexer/src/Lexer/Terminators.rs:187
// split_header_spelling maps to Terminators.jet:478 split_spelling; the empty
// sentinel is projected to optional here only for diagnostic/event validation.
// Rust: crates/jet-lexer/src/Lexer/Terminators.rs:197
fn split_header_diagnostic(token: Token) -> Diagnostic? Never! {
    spelling :: split_spelling(token.kind)
    if spelling.is_empty() -> return None
    Val(diagnostic_from_registry("E0986", Val(token.span), "`{spelling}` must stay on the same line as the closing `)`", "an arrow, effect row, or opening block continues the header on its line", "move `{spelling}` up to the `)` line"))
}
// Rust: crates/jet-lexer/src/Lexer/Terminators.rs:208
fn apply_events(src: String, toks: &[Token], diags: &[Diagnostic], events: ^[TerminatorEvent]) -> Unit Err! {
    previous := Int?{None}
    insertions := 0
    loop event in events {
        (before, at) :: if event == { .InsertSemi{before: b, at: a} | .SplitHeader{before: b, at: a} -> (b, a) }
        token :: toks.get(before) ?? return Err("terminator event has an invalid raw-token index")
        if previous.is_some_and(fn(value) { before <= value }) || at > token.span.start || !src.is_char_boundary(at) -> return Err("terminator event order or byte position is invalid")
        if event == .SplitHeader{before: _, at: _} {
            if at != token.span.start || split_spelling(token.kind).is_empty() -> return Err("split-header event does not identify a diagnostic-bearing token")
        } else -> insertions += 1
        previous = Val(before)
    }
    if insertions == 0 {
        loop event in events {
            if event == .SplitHeader{before: before, at: _} -> &diags.push(split_header_diagnostic(toks[before]).expect("validated diagnostic"))
        }
        return Ok(())
    }
    output := [Token].with_capacity(toks.len() + insertions)
    event_index := 0
    index := 0
    loop token in &toks.take() {
        if event_index < events.len() {
            event :: events[event_index]
            before :: if event == { .InsertSemi{before: b, at: _} | .SplitHeader{before: b, at: _} -> b }
            if before == index {
                if event == {
                    .InsertSemi{before: _, at: at} -> &output.push(Token{kind: K_SEMI, span: Span{start: at, end: at}, payload: empty_payload("")})
                    .SplitHeader{before: _, at: _} -> &diags.push(split_header_diagnostic(token).expect("validated diagnostic"))
                }
                event_index += 1
            }
        }
        &output.push(^token)
        index += 1
    }
    toks = ^output
    Ok(())
}
// Rust: crates/jet-lexer/src/Lexer/Terminators.rs:270
fn insert_terminators(src: String, toks: &[Token], diags: &[Diagnostic]) -> Unit Never! {
    driver :: terminator_driver() ?? {
        // The canonical Jet pass replaces the Rust reference pass completely.
        facts := [Int].with_capacity(toks.len() * 4)
        loop token in toks {
            fact :: raw_token_fact(token)
            &facts.push(Int(fact.kind)); &facts.push(fact.span.start); &facts.push(fact.span.end); &facts.push(if fact.uppercase { 1 } else { 0 })
        }
        raw_events :: terminator_events(src.bytes(), facts)
        events := [TerminatorEvent].with_capacity(raw_events.len() /% 3)
        loop index in 0..<raw_events.len() /% 3 {
            offset :: index * 3
            if raw_events[offset] == 1 -> &events.push(TerminatorEvent.InsertSemi{before: raw_events[offset + 1], at: raw_events[offset + 2]})
            else -> &events.push(TerminatorEvent.SplitHeader{before: raw_events[offset + 1], at: raw_events[offset + 2]})
        }
        apply_events(src, &toks, &diags, ^events).unwrap_or_else(fn(error) { panic("Jet terminator event ABI failed: {error}") })
        return
    }
    facts :: toks.map(raw_token_fact)
    events :: driver(src.bytes(), facts).unwrap_or_else(fn(error) { panic("Jet terminator pass failed: {error}") })
    apply_events(src, &toks, &diags, ^events).unwrap_or_else(fn(error) { panic("Jet terminator event ABI failed: {error}") })
}
