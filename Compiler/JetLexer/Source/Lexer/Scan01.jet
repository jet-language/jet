// Private continuation of JetLexer.Lexer. Canonical scanner state is source bytes
// plus raw four-field facts in Scan.jet; no second char-indexed Lexer carrier.
use JetFoundation.Syntax

// Rust: crates/jet-lexer/src/Lexer/mod.rs:1
// Module bodies: Scan -> Scan.jet, Strings -> Payload.jet/Payload02.jet,
// Terminators -> Terminators.jet/Terminators01.jet, Tokens -> Tokens.jet.
// Rust: crates/jet-lexer/src/Lexer/mod.rs:15
// lex/lex_config/lex_generated are canonical Terminators.jet:556/560/564.
// Rust: crates/jet-lexer/src/Lexer/mod.rs:17
// raw_token_fact/driver/events are private Terminators01.jet declarations.
// Rust: crates/jet-lexer/src/Lexer/mod.rs:21
// Token and StrTokPart map to Tokens.jet:18 Token and :24 StringPart;
// TokKind maps to the exhaustive TOKEN_* tags (Tokens.jet:43-149).
// Rust: crates/jet-lexer/src/Lexer/mod.rs:25
// lex_raw maps to Payload.jet:1109 lex_payload(source, false).
// Rust: crates/jet-lexer/src/Lexer/mod.rs:27
// Lexer fields are carried by Scan.raw_token_facts(source, config_surface) and
// Payload.lex_payload_at_depth(source, config_surface, allow_reserved_identifiers, depth).
// Rust: crates/jet-lexer/src/Lexer/mod.rs:44
pub fn keyword_spelling(kind: Int) -> String? Never! {
    loop word in Syntax.JET_KEYWORD_LIST {
        if word_kind(word.bytes(), 0, word.bytes().len(), 0) == kind -> return Val(word)
    }
    None
}
