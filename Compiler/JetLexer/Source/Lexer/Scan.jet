// Raw source scanning for the Jet lexer.
//
// The scanner emits private four-field raw-token facts consumed by both
// payload construction and the terminator pass:
// [kind, byte_start, byte_end, first_char_is_uppercase].
use core.text as unicode


fn byte_at(source: [U8], index: Int) -> Int Never! {
    if index < 0 || index >= source.len() -> return -1
    Int.from_u8(source[index])
}

fn is_continuation(value: Int) -> Bool Never! {
    value >= 128 && value <= 191
}

fn utf8_width(source: [U8], index: Int) -> Int Never! {
    first :: byte_at(source, index)
    if first < 0 -> return 0
    if first < 128 -> return 1
    if first >= 194 && first <= 223 && is_continuation(byte_at(source, index + 1)) -> return 2
    if first >= 224 && first <= 239 && is_continuation(byte_at(source, index + 1)) && is_continuation(byte_at(source, index + 2)) -> return 3
    if first >= 240 && first <= 244 && is_continuation(byte_at(source, index + 1)) && is_continuation(byte_at(source, index + 2)) && is_continuation(byte_at(source, index + 3)) -> return 4
    1
}

fn scalar_at(source: [U8], index: Int) -> String Never! {
    width :: utf8_width(source, index)
    if width <= 0 -> return ""
    out := [U8]{}
    loop offset in 0..<width {
        if index + offset >= source.len() -> break
        &out.push(source[index + offset])
    }
    String.from_bytes(out) ?? ""
}

fn ascii_alpha(value: Int) -> Bool Never! {
    (value >= 65 && value <= 90) || (value >= 97 && value <= 122)
}

fn ascii_digit(value: Int) -> Bool Never! {
    value >= 48 && value <= 57
}

// ASCII bytes take the byte tests alone: on an ASCII scalar the Unicode
// predicates agree with them (alphabetic = A-Z a-z, numeric = 0-9, uppercase
// = A-Z), and the String building in `scalar_at` is skipped. A position past
// the end (byte -1) keeps the general path.
fn is_identifier_start(source: [U8], index: Int) -> Bool Never! {
    value :: byte_at(source, index)
    if value >= 0 && value < 128 -> return value == 95 || ascii_alpha(value)
    value == 95 || ascii_alpha(value) || unicode.is_alphabetic(scalar_at(source, index))
}

fn is_identifier_continue(source: [U8], index: Int) -> Bool Never! {
    value :: byte_at(source, index)
    if value >= 0 && value < 128 -> return value == 95 || ascii_alpha(value) || ascii_digit(value)
    value == 95 || ascii_alpha(value) || ascii_digit(value) || unicode.is_alphabetic(scalar_at(source, index)) || unicode.is_numeric(scalar_at(source, index))
}

fn first_char_is_upper(source: [U8], start: Int) -> Bool Never! {
    value :: byte_at(source, start)
    if value >= 0 && value < 128 -> return value >= 65 && value <= 90
    scalar := scalar_at(source, start)
    unicode.is_alphabetic(scalar) && unicode.upper(scalar) == scalar && unicode.lower(scalar) != scalar
}

fn is_whitespace_at(source: [U8], index: Int) -> Bool Never! {
    value :: byte_at(source, index)
    if value < 0 -> return false
    if value < 128 {
        return value == 9 || value == 10 || value == 11 || value == 12 || value == 13 || value == 32
    }
    unicode.is_whitespace(scalar_at(source, index))
}

fn slice_text(source: [U8], start: Int, end: Int) -> String Never! {
    stop :: if end < source.len() -> end else -> source.len()
    if start >= stop -> return ""
    if start >= 0 -> return String.from_bytes(source.slice(start, stop)) ?? ""
    out := [U8]{}
    i := start
    loop i < end && i < source.len() {
        &out.push(source[i])
        i += 1
    }
    String.from_bytes(out) ?? ""
}

fn emit(facts: &[Int], kind: Int, start: Int, end: Int, uppercase: Bool) Never! {
    flag := 0
    if uppercase -> flag = 1
    &facts.push(kind)
    &facts.push(start)
    &facts.push(end)
    &facts.push(flag)
}

fn push_code(facts: &[Int], kind: Int, start: Int, end: Int, uppercase: Bool) -> Int Never! {
    emit(&facts, kind, start, end, uppercase)
    kind
}

fn previous_scalar_start(source: [U8], index: Int) -> Int Never! {
    if index <= 0 -> return -1
    cursor := index - 1
    loop cursor > 0 && is_continuation(byte_at(source, cursor)) -> cursor -= 1
    cursor
}

fn previous_is_identifier(source: [U8], index: Int) -> Bool {
    previous :: previous_scalar_start(source, index)
    previous >= 0 && is_identifier_continue(source, previous)
}

// ASCII identifier bytes are tested inline; only a non-ASCII byte takes the
// scalar path (`is_identifier_continue`, `utf8_width`).
fn scan_identifier_end(source: [U8], start: Int) -> Int {
    if start < 0 -> return start
    i := start
    count :: source.len()
    loop i < count {
        value :: Int.from_u8(source[i])
        if value < 128 {
            if value == 95 || (value >= 97 && value <= 122) || (value >= 65 && value <= 90) || (value >= 48 && value <= 57) {
                i += 1
                next
            }
            return i
        }
        if !is_identifier_continue(source, i) -> return i
        i += utf8_width(source, i)
    }
    i
}

fn scan_unit_suffix_end(source: [U8], start: Int) -> Int {
    scan_identifier_end(source, start)
}

// BEGIN GENERATED LEXER KEYWORD SPANS
// Derived from Jet Lexer/Keywords and Syntax literals; do not hand edit.
// No spelling ownership here: Payload still builds the exact token text.
fn word_kind(source: [U8], start: Int, end: Int, previous_kind: Int) -> Int Never! {
    kind :: if end - start == {
        2 -> {
            if byte_at(source, start + 0) == {
                102 -> {
                    if byte_at(source, start + 1) == 110 -> K_FN else -> K_IDENT // Syntax::KW_FN
                }
                105 -> {
                    if byte_at(source, start + 1) == {
                        102 -> {
                            K_IF // Syntax::KW_IF
                        }
                        110 -> {
                            K_IN // Syntax::KW_IN
                        }
                        116 -> {
                            K_IT // Syntax::KW_IT
                        }
                        else -> K_IDENT
                    }
                }
                else -> K_IDENT
            }
        }
        3 -> {
            if byte_at(source, start + 0) == {
                109 -> {
                    if byte_at(source, start + 1) == 117 && byte_at(source, start + 2) == 116 -> K_MUTATE else -> K_IDENT // Syntax::KW_MUTATE
                }
                112 -> {
                    if byte_at(source, start + 1) == 117 && byte_at(source, start + 2) == 98 -> K_PUB else -> K_IDENT // Syntax::KW_PUB
                }
                116 -> {
                    if byte_at(source, start + 1) == 97 && byte_at(source, start + 2) == 103 -> K_TAG else -> K_IDENT // Syntax::KW_TAG
                }
                117 -> {
                    if byte_at(source, start + 1) == 115 && byte_at(source, start + 2) == 101 -> K_USE else -> K_IDENT // Syntax::KW_USE
                }
                else -> K_IDENT
            }
        }
        4 -> {
            if byte_at(source, start + 0) == {
                78 -> {
                    if byte_at(source, start + 1) == 111 && byte_at(source, start + 2) == 110 && byte_at(source, start + 3) == 101 -> K_NULL else -> K_IDENT // Syntax::LIT_NULL
                }
                99 -> {
                    if byte_at(source, start + 1) == 111 && byte_at(source, start + 2) == 112 && byte_at(source, start + 3) == 121 -> K_COPY else -> K_IDENT // Syntax::KW_COPY
                }
                101 -> {
                    if byte_at(source, start + 1) == {
                        108 -> {
                            if byte_at(source, start + 2) == 115 && byte_at(source, start + 3) == 101 -> K_ELSE else -> K_IDENT // Syntax::KW_ELSE
                        }
                        110 -> {
                            if byte_at(source, start + 2) == 117 && byte_at(source, start + 3) == 109 -> K_ENUM else -> K_IDENT // Syntax::KW_ENUM
                        }
                        else -> K_IDENT
                    }
                }
                105 -> {
                    if byte_at(source, start + 1) == 109 && byte_at(source, start + 2) == 112 && byte_at(source, start + 3) == 108 -> K_IMPL else -> K_IDENT // Syntax::KW_IMPL
                }
                108 -> {
                    if byte_at(source, start + 1) == 111 && byte_at(source, start + 2) == 111 && byte_at(source, start + 3) == 112 -> K_LOOP else -> K_IDENT // Syntax::KW_LOOP
                }
                112 -> {
                    if byte_at(source, start + 1) == 114 && byte_at(source, start + 2) == 105 && byte_at(source, start + 3) == 118 -> K_PRIV else -> K_IDENT // Syntax::KW_PRIV
                }
                115 -> {
                    if byte_at(source, start + 1) == 101 && byte_at(source, start + 2) == 108 && byte_at(source, start + 3) == 102 -> K_SELF else -> K_IDENT // Syntax::KW_SELF
                }
                116 -> {
                    if byte_at(source, start + 1) == {
                        97 -> {
                            if byte_at(source, start + 2) == 107 && byte_at(source, start + 3) == 101 -> K_MOVE else -> K_IDENT // Syntax::KW_MOVE
                        }
                        114 -> {
                            if byte_at(source, start + 2) == 117 && byte_at(source, start + 3) == 101 -> K_TRUE else -> K_IDENT // Syntax::LIT_TRUE
                        }
                        else -> K_IDENT
                    }
                }
                else -> K_IDENT
            }
        }
        5 -> {
            if byte_at(source, start + 0) == {
                98 -> {
                    if byte_at(source, start + 1) == 114 && byte_at(source, start + 2) == 101 && byte_at(source, start + 3) == 97 && byte_at(source, start + 4) == 107 -> K_BREAK else -> K_IDENT // Syntax::KW_BREAK
                }
                99 -> {
                    if byte_at(source, start + 1) == 111 && byte_at(source, start + 2) == 110 && byte_at(source, start + 3) == 115 && byte_at(source, start + 4) == 116 -> K_CONST else -> K_IDENT // Syntax::KW_CONST
                }
                102 -> {
                    if byte_at(source, start + 1) == 97 && byte_at(source, start + 2) == 108 && byte_at(source, start + 3) == 115 && byte_at(source, start + 4) == 101 -> K_FALSE else -> K_IDENT // Syntax::LIT_FALSE
                }
                116 -> {
                    if byte_at(source, start + 1) == 114 && byte_at(source, start + 2) == 97 && byte_at(source, start + 3) == 105 && byte_at(source, start + 4) == 116 -> K_TRAIT else -> K_IDENT // Syntax::KW_TRAIT
                }
                121 -> {
                    if byte_at(source, start + 1) == 105 && byte_at(source, start + 2) == 101 && byte_at(source, start + 3) == 108 && byte_at(source, start + 4) == 100 -> K_YIELD else -> K_IDENT // Syntax::KW_YIELD
                }
                else -> K_IDENT
            }
        }
        6 -> {
            if byte_at(source, start + 0) == {
                100 -> {
                    if byte_at(source, start + 1) == 101 && byte_at(source, start + 2) == 114 && byte_at(source, start + 3) == 105 && byte_at(source, start + 4) == 118 && byte_at(source, start + 5) == 101 -> K_DERIVE else -> K_IDENT // Syntax::KW_DERIVE
                }
                101 -> {
                    if byte_at(source, start + 1) == {
                        102 -> {
                            if byte_at(source, start + 2) == 102 && byte_at(source, start + 3) == 101 && byte_at(source, start + 4) == 99 && byte_at(source, start + 5) == 116 -> K_EFFECT else -> K_IDENT // Syntax::KW_EFFECT_DECL
                        }
                        120 -> {
                            if byte_at(source, start + 2) == 116 && byte_at(source, start + 3) == 101 && byte_at(source, start + 4) == 114 && byte_at(source, start + 5) == 110 -> K_EXTERN else -> K_IDENT // Syntax::KW_EXTERN
                        }
                        else -> K_IDENT
                    }
                }
                109 -> {
                    if byte_at(source, start + 1) == 111 && byte_at(source, start + 2) == 100 && byte_at(source, start + 3) == 117 && byte_at(source, start + 4) == 108 && byte_at(source, start + 5) == 101 -> K_MODULE else -> K_IDENT // Syntax::KW_MODULE
                }
                114 -> {
                    if byte_at(source, start + 1) == 101 && byte_at(source, start + 2) == 116 && byte_at(source, start + 3) == 117 && byte_at(source, start + 4) == 114 && byte_at(source, start + 5) == 110 -> K_RETURN else -> K_IDENT // Syntax::KW_RETURN
                }
                115 -> {
                    if byte_at(source, start + 1) == 116 && byte_at(source, start + 2) == 114 && byte_at(source, start + 3) == 117 && byte_at(source, start + 4) == 99 && byte_at(source, start + 5) == 116 -> K_STRUCT else -> K_IDENT // Syntax::KW_STRUCT
                }
                else -> K_IDENT
            }
        }
        8 -> {
            if byte_at(source, start + 0) == 99 && byte_at(source, start + 1) == 111 && byte_at(source, start + 2) == 109 && byte_at(source, start + 3) == 112 && byte_at(source, start + 4) == 116 && byte_at(source, start + 5) == 105 && byte_at(source, start + 6) == 109 && byte_at(source, start + 7) == 101 -> K_COMPTIME else -> K_IDENT // Syntax::KW_COMPTIME
        }
        else -> K_IDENT
    }
    // Only exact in becomes a member after a postfix dot.
    if kind == K_IN && (previous_kind == K_DOT || previous_kind == K_QUESTION_DOT) -> return K_IDENT
    kind
}
// END GENERATED LEXER KEYWORD SPANS

fn scan_digits(source: [U8], start: Int) -> Int Never! {
    i := start
    loop i < source.len() {
        value :: byte_at(source, i)
        if {
            ascii_digit(value) || value == 95 -> {
                i += 1
            }
            else -> {
                return i
            }
        }
    }
    i
}

fn base_digit(value: Int, radix: Int) -> Bool Never! {
    if value >= 48 && value <= 57 -> return value - 48 < radix
    if value >= 65 && value <= 70 -> return value - 55 < radix
    if value >= 97 && value <= 102 -> return value - 87 < radix
    false
}

fn base_number_end(source: [U8], start: Int) -> Int Never! {
    marker :: byte_at(source, start + 1)
    radix := if marker == {
        120 | 88 -> 16
        111 | 79 -> 8
        98 | 66 -> 2
        else -> 0
    }
    if radix == 0 -> return -1
    i := start + 2
    loop i < source.len() {
        value :: byte_at(source, i)
        if {
            value == 95 || base_digit(value, radix) -> {
                i += 1
            }
            else -> {
                return i
            }
        }
    }
    i
}

fn scan_numeric_end(source: [U8], start: Int) -> Int Never! {
    if byte_at(source, start) == 48 {
        prefixed :: base_number_end(source, start)
        if prefixed >= 0 -> return prefixed
    }
    i := scan_digits(source, start)
    if byte_at(source, i) == 46 && ascii_digit(byte_at(source, i + 1)) {
        i += 1
        i = scan_digits(source, i)
    }
    exponent :: byte_at(source, i)
    if exponent == 101 || exponent == 69 {
        after :: byte_at(source, i + 1)
        valid := ascii_digit(after)
        if (after == 43 || after == 45) && ascii_digit(byte_at(source, i + 2)) -> valid = true
        if valid {
            i += 1
            sign :: byte_at(source, i)
            if sign == 43 || sign == 45 -> i += 1
            i = scan_digits(source, i)
        }
    }
    i
}

fn scan_number_end(source: [U8], start: Int) -> Int {
    numeric_end :: scan_numeric_end(source, start)
    if numeric_end < 0 -> return start + 1
    if base_number_end(source, start) >= 0 -> return numeric_end
    value :: byte_at(source, numeric_end)
    if !ascii_alpha(value) && value != 95 -> return numeric_end
    scan_unit_suffix_end(source, numeric_end)
}

fn numeric_is_float(source: [U8], start: Int) -> Bool Never! {
    if base_number_end(source, start) >= 0 -> return false
    i := scan_digits(source, start)
    if byte_at(source, i) == 46 && ascii_digit(byte_at(source, i + 1)) -> return true
    exponent :: byte_at(source, i)
    if !(exponent == 101 || exponent == 69) -> return false
    after :: byte_at(source, i + 1)
    ascii_digit(after) || ((after == 43 || after == 45) && ascii_digit(byte_at(source, i + 2)))
}

// Whether the decimal digits in `start..end` (separators skipped) fit the
// i64 token fast path.
fn decimal_digits_fit_int(source: [U8], start: Int, end: Int) -> Bool Never! {
    value := 0
    i := start
    loop i < end {
        code :: byte_at(source, i)
        i += 1
        if code == 95 -> next
        if !ascii_digit(code) -> return false
        digit :: code - 48
        if value > (9223372036854775807 - digit) /% 10 -> return false
        value = value * 10 + digit
    }
    true
}

fn scan_plain_string_end(source: [U8], start: Int, raw_head: Bool) -> Int Never! {
    i := start + 1
    count :: source.len()
    loop i < count {
        value :: Int.from_u8(source[i])
        // Plain ASCII text bytes advance inline.
        if value < 128 && value != 10 && value != 34 && value != 123 && value != 125 && value != 92 {
            i += 1
            next
        }
        if value == 10 -> return -(i + 1)
        if value == 34 -> return i + 1
        if (value == 123 || value == 125) && byte_at(source, i + 1) == value {
            i += 2
            next
        }
        if value == 123 {
            i = scan_plain_interpolation_end(source, i)
            next
        }
        if {
            value == 92 -> {
                if {
                    !raw_head || byte_at(source, i + 1) == 34 -> {
                        if i + 1 < source.len() -> i += 2 else -> i += 1
                    }
                    else -> {
                        i += 1
                    }
                }
            }
            else -> {
                i += utf8_width(source, i)
            }
        }
    }
    -(source.len() + 1)
}

// The index after one `{…}` inside a plain string, as Rust's string lexer
// reads it: an interpolation skips nested quoted text, raw backtick fences and
// nested braces; a `\$` `{…}` template payload only balances braces. An
// interpolation left open at the line end returns that line end, so the
// string scan reports it unclosed there.
fn scan_plain_interpolation_end(source: [U8], open: Int) -> Int Never! {
    j := open + 1
    depth := 1
    template :: byte_at(source, open - 1) == 36 && byte_at(source, open - 2) == 92
    in_quote := false
    loop j < source.len() {
        value :: byte_at(source, j)
        if {
            template -> {
                if value == 123 -> depth += 1
                if value == 125 -> depth -= 1
                if depth == 0 -> return j + 1
            }
            in_quote -> {
                if value == 92 -> j += 1
                if value == 34 -> in_quote = false
            }
            value == 34 -> in_quote = true
            value == 96 -> {
                fence_end :: scan_raw_fence_end(source, j)
                if fence_end < 0 -> return source.len()
                j = fence_end
                next
            }
            value == 123 -> depth += 1
            value == 125 -> {
                depth -= 1
                if depth == 0 -> return j + 1
            }
            value == 10 -> return j
            else -> {}
        }
        j += 1
    }
    source.len()
}

fn scan_raw_fence_end(source: [U8], start: Int) -> Int Never! {
    fence_len := 0
    loop byte_at(source, start + fence_len) == 96 -> fence_len += 1
    cursor := start + fence_len
    loop cursor < source.len() {
        if byte_at(source, cursor) != 96 {
            cursor += 1
            next
        }
        run_start := cursor
        loop byte_at(source, cursor) == 96 -> cursor += 1
        if cursor - run_start == fence_len -> return cursor
    }
    -(source.len() + 1)
}

fn scan_triple_string_end(source: [U8], start: Int, raw_head: Bool) -> Int Never! {
    i := start + 3
    depth := 0
    loop i < source.len() {
        value :: byte_at(source, i)
        if depth == 0 {
            if value == 92 {
                if {
                    !raw_head || byte_at(source, i + 1) == 34 -> {
                        if i + 1 < source.len() -> i += 2 else -> i += 1
                    }
                    else -> {
                        i += 1
                    }
                }
                next
            }
            if value == 123 && byte_at(source, i + 1) == 123 {
                i += 2
                next
            }
            if value == 123 {
                depth = 1
                i += 1
                next
            }
            if value == 34 && byte_at(source, i + 1) == 34 && byte_at(source, i + 2) == 34 -> return i + 3
            i += utf8_width(source, i)
            next
        }
        if value == 47 && byte_at(source, i + 1) == 47 {
            i += 2
            loop i < source.len() && byte_at(source, i) != 10 -> i += utf8_width(source, i)
            next
        }
        if value == 47 && byte_at(source, i + 1) == 42 {
            i += 2
            comment_depth := 1
            loop i < source.len() && comment_depth > 0 {
                if {
                    byte_at(source, i) == 47 && byte_at(source, i + 1) == 42 -> {
                        comment_depth += 1
                        i += 2
                    }
                    byte_at(source, i) == 42 && byte_at(source, i + 1) == 47 -> {
                        comment_depth -= 1
                        i += 2
                    }
                    else -> {
                        i += utf8_width(source, i)
                    }
                }
            }
            next
        }
        if value == 34 {
            triple := byte_at(source, i + 1) == 34 && byte_at(source, i + 2) == 34
            nested :: if triple -> scan_triple_string_end(source, i, false) else -> scan_plain_string_end(source, i, false)
            if {
                nested >= 0 -> {
                    i = nested
                }
                else -> {
                    i = -nested - 1
                }
            }
            next
        }
        if value == 39 {
            nested :: scan_char_end(source, i)
            if {
                nested >= 0 -> {
                    i = nested
                }
                else -> {
                    i = source.len()
                }
            }
            next
        }
        if value == 96 {
            nested :: scan_raw_fence_end(source, i)
            if {
                nested >= 0 -> {
                    i = nested
                }
                else -> {
                    i = source.len()
                }
            }
            next
        }
        if value == 123 {
            depth += 1
            i += 1
            next
        }
        if value == 125 {
            depth -= 1
            i += 1
            next
        }
        i += utf8_width(source, i)
    }
    -(source.len() + 1)
}

fn scan_raw_foreign_string_end(source: [U8], start: Int) -> Int Never! {
    i := start + 3
    loop i + 2 < source.len() {
        if byte_at(source, i) == 34 && byte_at(source, i + 1) == 34 && byte_at(source, i + 2) == 34 -> return i + 3
        i += 1
    }
    -(source.len() + 1)
}

fn scan_char_end(source: [U8], start: Int) -> Int Never! {
    i := start + 1
    if i >= source.len() -> return -1
    if {
        byte_at(source, i) == 92 -> {
            i += 2
            if i > source.len() -> i = source.len()
        }
        else -> {
            i += utf8_width(source, i)
        }
    }
    if byte_at(source, i) == 39 -> return i + 1
    loop i < source.len() && byte_at(source, i) != 39 -> i += utf8_width(source, i)
    if byte_at(source, i) == 39 -> i + 1 else -> source.len()
}

// The index after the nested `/* … */` comment opened at `start`. A comment
// whose openers are not all closed runs to the source end and returns
// `-(end + 1)`, so the payload pass can report it unclosed.
fn scan_block_comment_end(source: [U8], start: Int) -> Int Never! {
    i := start + 2
    depth := 1
    loop i < source.len() && depth > 0 {
        if {
            byte_at(source, i) == 47 && byte_at(source, i + 1) == 42 -> {
                depth += 1
                i += 2
            }
            byte_at(source, i) == 42 && byte_at(source, i + 1) == 47 -> {
                depth -= 1
                i += 2
            }
            else -> {
                i += utf8_width(source, i)
            }
        }
    }
    if depth > 0 -> return -(i + 1)
    i
}

fn raw_token_facts(source: [U8], config_surface: Bool) -> [Int] {
    facts := [Int]{}
    _ := raw_token_facts_range(source, config_surface, 0, source.len(), -1, &facts)
    facts
}

// Where a range scan stopped: `stop` is the first byte the scan did not
// read (`to` when the range ends between tokens, past it when a token
// straddles the range end); `bodies_local` is false when a `"""` head was
// scanned with no `fn` fact in the range before it, so `raw_foreign_body_at`
// would have read facts before the range.
struct RawScanStop {
    stop: Int
    bodies_local: Bool
}

// Scans `source[from..<to]` appending its facts to `facts`. A token that
// starts before `to` is scanned whole, so the scan can end past `to`. The
// range starts between tokens: `previous_code` is the kind of the code token
// before `from` (-1 at the start of the source); the `#!` launch line is
// read at byte 0 only, and the EOF fact is emitted when the range reaches
// the end of the source.
fn raw_token_facts_range(source: [U8], config_surface: Bool, from: Int, to: Int, previous_code: Int, facts: &[Int]) -> RawScanStop {
    last_code := previous_code
    fn_in_range := false
    bodies_local := true
    i := from
    if i == 0 && byte_at(source, 0) == 35 && byte_at(source, 1) == 33 && byte_at(source, 2) == 47 {
        loop i < source.len() && byte_at(source, i) != 10 -> i += 1
        if i < source.len() -> i += 1
    }
    count :: source.len()
    loop i < to {
        // ASCII whitespace and identifier starts (most bytes and tokens) are
        // tested inline before the punctuation chain; a non-ASCII byte keeps
        // the scalar whitespace and identifier tests below.
        value :: Int.from_u8(source[i])
        if value == 32 || (value >= 9 && value <= 13) {
            i += 1
            next
        }
        if value == 95 || (value >= 97 && value <= 122) || (value >= 65 && value <= 90) {
            end :: scan_identifier_end(source, i)
            kind :: word_kind(source, i, end, last_code)
            if kind == K_FN -> fn_in_range = true
            last_code = push_code(&facts, kind, i, end, kind == K_IDENT && value <= 90 && value >= 65)
            i = end
            next
        }
        if value >= 128 && is_whitespace_at(source, i) {
            i += utf8_width(source, i)
            next
        }
        start := i
        next1 :: byte_at(source, i + 1)
        next2 :: byte_at(source, i + 2)
        if value == 35 && next1 == 33 && next2 == 47 {
            loop i < source.len() && byte_at(source, i) != 10 -> i += 1
            if i < source.len() -> i += 1
            next
        }
        if value == 47 && next1 == 47 {
            if config_surface && byte_at(source, i - 1) == 58 {
                last_code = push_code(&facts, K_SLASH, i, i + 1, false)
                last_code = push_code(&facts, K_SLASH, i + 1, i + 2, false)
                i += 2
                next
            }
            loop i < count && source[i] != 10 -> i += 1
            emit(&facts, K_LINE_COMMENT, start, i, false)
            next
        }
        if value == 47 && next1 == 42 {
            end :: scan_block_comment_end(source, start)
            i = if end < 0 -> -end - 1 else -> end
            emit(&facts, K_BLOCK_COMMENT, start, i, false)
            next
        }
        if value == 40 {
            last_code = push_code(&facts, K_LPAREN, start, start + 1, false)
            i += 1
            next
        }
        if value == 41 {
            last_code = push_code(&facts, K_RPAREN, start, start + 1, false)
            i += 1
            next
        }
        if value == 123 {
            last_code = push_code(&facts, K_LBRACE, start, start + 1, false)
            i += 1
            next
        }
        if value == 125 {
            last_code = push_code(&facts, K_RBRACE, start, start + 1, false)
            i += 1
            next
        }
        if value == 91 {
            last_code = push_code(&facts, K_LBRACKET, start, start + 1, false)
            i += 1
            next
        }
        if value == 93 {
            last_code = push_code(&facts, K_RBRACKET, start, start + 1, false)
            i += 1
            next
        }
        // `:>` closes a fence (longest match before `::`/`:=`).
        if value == 58 {
            if {
                next1 == 62 -> {
                    last_code = push_code(&facts, K_FENCE_CLOSE, start, start + 2, false)
                    i += 2
                }
                next1 == 58 -> {
                    last_code = push_code(&facts, K_COLON_COLON, start, start + 2, false)
                    i += 2
                }
                next1 == 61 -> {
                    last_code = push_code(&facts, K_COLON_EQ, start, start + 2, false)
                    i += 2
                }
                else -> {
                    last_code = push_code(&facts, K_COLON, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 44 {
            last_code = push_code(&facts, K_COMMA, start, start + 1, false)
            i += 1
            next
        }
        if value == 59 {
            last_code = push_code(&facts, K_SEMI, start, start + 1, false)
            i += 1
            next
        }
        if value == 64 {
            if {
                is_identifier_start(source, i + 1) && !previous_is_identifier(source, i) -> {
                    end :: scan_identifier_end(source, i + 1)
                    marker_kind :: word_kind(source, i + 1, end, 0)
                    if {
                        marker_kind == K_IDENT -> {
                            last_code = push_code(&facts, K_IDENT, start, end, false)
                            i = end
                        }
                        else -> {
                            last_code = push_code(&facts, K_AT, start, start + 1, false)
                            i += 1
                        }
                    }
                }
                else -> {
                    last_code = push_code(&facts, K_AT, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 35 {
            last_code = push_code(&facts, K_HASH, start, start + 1, false)
            i += 1
            next
        }
        if value == 36 {
            // Prefix `$name` is one compiler-fact word
            // (`$build`, `T.$layout`, `$sites:`); config surfaces read the same
            // word as a `$NAME` environment read. A lone `$` keeps its token.
            if {
                is_identifier_start(source, i + 1) && !previous_is_identifier(source, i) -> {
                    end :: scan_identifier_end(source, i + 1)
                    last_code = push_code(&facts, K_IDENT, start, end, false)
                    i = end
                }
                else -> {
                    last_code = push_code(&facts, K_DOLLAR, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 63 {
            if {
                next1 == 63 -> {
                    last_code = push_code(&facts, K_QUESTION_QUESTION, start, start + 2, false)
                    i += 2
                }
                next1 == 46 -> {
                    last_code = push_code(&facts, K_QUESTION_DOT, start, start + 2, false)
                    i += 2
                }
                else -> {
                    last_code = push_code(&facts, K_QUESTION, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 46 {
            if {
                next1 == 46 && next2 == 46 -> {
                    last_code = push_code(&facts, K_DOT_DOT_DOT, start, start + 3, false)
                    i += 3
                }
                next1 == 46 && next2 == 60 -> {
                    last_code = push_code(&facts, K_DOT_DOT_LT, start, start + 3, false)
                    i += 3
                }
                next1 == 46 -> {
                    last_code = push_code(&facts, K_DOT_DOT, start, start + 2, false)
                    i += 2
                }
                else -> {
                    last_code = push_code(&facts, K_DOT, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 61 {
            if {
                next1 == 61 -> {
                    last_code = push_code(&facts, K_EQ_EQ, start, start + 2, false)
                    i += 2
                }
                else -> {
                    last_code = push_code(&facts, K_EQ, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 33 {
            if {
                next1 == 61 -> {
                    last_code = push_code(&facts, K_NOT_EQ, start, start + 2, false)
                    i += 2
                }
                else -> {
                    last_code = push_code(&facts, K_BANG, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 43 {
            if {
                next1 == 43 -> {
                    last_code = push_code(&facts, K_PLUS_PLUS, start, start + 2, false)
                    i += 2
                }
                next1 == 61 -> {
                    last_code = push_code(&facts, K_PLUS_EQ, start, start + 2, false)
                    i += 2
                }
                else -> {
                    last_code = push_code(&facts, K_PLUS, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 45 {
            if {
                next1 == 62 -> {
                    last_code = push_code(&facts, K_UNIFIED_ARROW, start, start + 2, false)
                    i += 2
                }
                next1 == 45 -> {
                    last_code = push_code(&facts, K_MINUS_MINUS, start, start + 2, false)
                    i += 2
                }
                next1 == 61 -> {
                    last_code = push_code(&facts, K_MINUS_EQ, start, start + 2, false)
                    i += 2
                }
                else -> {
                    last_code = push_code(&facts, K_MINUS, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 42 {
            if {
                next1 == 61 -> {
                    last_code = push_code(&facts, K_STAR_EQ, start, start + 2, false)
                    i += 2
                }
                else -> {
                    last_code = push_code(&facts, K_STAR, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 47 {
            if {
                next1 == 37 && next2 == 61 -> {
                    last_code = push_code(&facts, K_SLASH_PERCENT_EQ, start, start + 3, false)
                    i += 3
                }
                next1 == 37 -> {
                    last_code = push_code(&facts, K_SLASH_PERCENT, start, start + 2, false)
                    i += 2
                }
                next1 == 61 -> {
                    last_code = push_code(&facts, K_SLASH_EQ, start, start + 2, false)
                    i += 2
                }
                else -> {
                    last_code = push_code(&facts, K_SLASH, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 37 {
            if {
                next1 == 37 && next2 == 61 -> {
                    last_code = push_code(&facts, K_PERCENT_PERCENT_EQ, start, start + 3, false)
                    i += 3
                }
                next1 == 37 -> {
                    last_code = push_code(&facts, K_PERCENT_PERCENT, start, start + 2, false)
                    i += 2
                }
                next1 == 61 -> {
                    last_code = push_code(&facts, K_PERCENT_EQ, start, start + 2, false)
                    i += 2
                }
                else -> {
                    last_code = push_code(&facts, K_PERCENT, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 38 {
            if {
                next1 == 38 -> {
                    last_code = push_code(&facts, K_AND_AND, start, start + 2, false)
                    i += 2
                }
                next1 == 61 -> {
                    last_code = push_code(&facts, K_AMP_EQ, start, start + 2, false)
                    i += 2
                }
                else -> {
                    last_code = push_code(&facts, K_AMP, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 124 {
            if {
                next1 == 124 -> {
                    last_code = push_code(&facts, K_OR_OR, start, start + 2, false)
                    i += 2
                }
                next1 == 61 -> {
                    last_code = push_code(&facts, K_PIPE_EQ, start, start + 2, false)
                    i += 2
                }
                else -> {
                    last_code = push_code(&facts, K_PIPE, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 94 {
            if {
                next1 == 61 -> {
                    last_code = push_code(&facts, K_CARET_EQ, start, start + 2, false)
                    i += 2
                }
                else -> {
                    last_code = push_code(&facts, K_CARET, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 126 {
            if {
                next1 == 126 -> {
                    last_code = push_code(&facts, K_TILDE_TILDE, start, start + 2, false)
                    i += 2
                }
                next1 == 124 && next2 == 61 -> {
                    last_code = push_code(&facts, K_TILDE_PIPE_EQ, start, start + 3, false)
                    i += 3
                }
                next1 == 124 -> {
                    last_code = push_code(&facts, K_TILDE_PIPE, start, start + 2, false)
                    i += 2
                }
                else -> {
                    last_code = push_code(&facts, K_TILDE, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 60 {
            if {
                next1 == 60 && next2 == 61 -> {
                    last_code = push_code(&facts, K_SHL_EQ, start, start + 3, false)
                    i += 3
                }
                next1 == 60 -> {
                    last_code = push_code(&facts, K_SHL, start, start + 2, false)
                    i += 2
                }
                next1 == 61 && next2 == 62 -> {
                    last_code = push_code(&facts, K_COMPARE, start, start + 3, false)
                    i += 3
                }
                next1 == 61 -> {
                    last_code = push_code(&facts, K_LE, start, start + 2, false)
                    i += 2
                }
                // `<:` opens a statement-expansion fence.
                next1 == 58 -> {
                    last_code = push_code(&facts, K_FENCE_OPEN, start, start + 2, false)
                    i += 2
                }
                else -> {
                    last_code = push_code(&facts, K_LT, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 62 {
            if {
                next1 == 62 && next2 == 61 -> {
                    last_code = push_code(&facts, K_SHR_EQ, start, start + 3, false)
                    i += 3
                }
                next1 == 62 -> {
                    last_code = push_code(&facts, K_SHR, start, start + 2, false)
                    i += 2
                }
                next1 == 61 -> {
                    last_code = push_code(&facts, K_GE, start, start + 2, false)
                    i += 2
                }
                else -> {
                    last_code = push_code(&facts, K_GT, start, start + 1, false)
                    i += 1
                }
            }
            next
        }
        if value == 34 {
            if {
                next1 == 34 && next2 == 34 -> {
                    if !fn_in_range -> bodies_local = false
                    end := if {
                        raw_foreign_body_at(source, facts, facts.len() /% 4) -> scan_raw_foreign_string_end(source, start)
                        else -> {
                            modes :: string_head_modes(source, facts, facts.len() /% 4)
                            scan_triple_string_end(source, start, modes.raw_head)
                        }
                    }
                    if {
                        end < 0 -> {
                            i = -end - 1
                        }
                        else -> {
                            last_code = push_code(&facts, K_STR, start, end, false)
                            i = end
                        }
                    }
                }
                else -> {
                    modes :: string_head_modes(source, facts, facts.len() /% 4)
                    end :: scan_plain_string_end(source, start, modes.raw_head)
                    if {
                        end < 0 -> {
                            i = -end - 1
                        }
                        else -> {
                            last_code = push_code(&facts, K_STR, start, end, false)
                            i = end
                        }
                    }
                }
            }
            next
        }
        if value == 96 {
            end :: scan_raw_fence_end(source, start)
            if {
                end < 0 -> {
                    i = -end - 1
                }
                else -> {
                    last_code = push_code(&facts, K_RAW_STR, start, end, false)
                    i = end
                }
            }
            next
        }
        if value == 39 {
            end :: scan_char_end(source, start)
            if {
                end < 0 -> {
                    i = source.len()
                }
                else -> {
                    last_code = push_code(&facts, K_CHAR, start, end, false)
                    i = end
                }
            }
            next
        }
        if ascii_digit(value) {
            numeric_end :: scan_numeric_end(source, start)
            end :: scan_number_end(source, start)
            kind :: if {
                end != numeric_end && (numeric_is_float(source, start) || decimal_digits_fit_int(source, start, numeric_end)) -> K_UNIT_NUMBER
                // Rust `number`: a unit candidate whose digits overflow the
                // i64 fast path falls back to an Int token over the whole
                // spelling, suffix included.
                end != numeric_end -> K_INT
                numeric_is_float(source, start) -> K_FLOAT
                else -> K_INT
            }
            last_code = push_code(&facts, kind, start, end, false)
            i = end
            next
        }
        if is_identifier_start(source, i) {
            end :: scan_identifier_end(source, i)
            kind :: word_kind(source, i, end, last_code)
            if kind == K_FN -> fn_in_range = true
            upper := false
            if kind == K_IDENT -> upper = first_char_is_upper(source, i)
            last_code = push_code(&facts, kind, i, end, upper)
            i = end
            next
        }
        i += utf8_width(source, i)
    }
    if to >= source.len() -> emit(&facts, K_EOF, source.len(), source.len(), false)
    RawScanStop{stop: i, bodies_local: bodies_local}
}

fn terminator_events_scanned(source: [U8], config_surface: Bool) -> [Int] {
    facts :: raw_token_facts(source, config_surface)
    terminator_events(source, facts)
}
