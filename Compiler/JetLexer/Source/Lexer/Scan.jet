// Raw source scanning for the Jet lexer.
//
// The scanner emits private four-field raw-token facts consumed by both
// payload construction and the terminator pass:
// [kind, byte_start, byte_end, case_name_start]: the last is 1 for an
// identifier that can name a case (case_name_start).
use {
    jet_foundation.[BLOCK_COMMENT_CLOSE, BLOCK_COMMENT_OPEN, COMMENT_PREFIX]
    unicode: core.text
}

// The comment spellings of the syntax registry, as the two bytes each one is,
// fixed when the lexer is built.
LINE_COMMENT_FIRST: #run { Int{COMMENT_PREFIX.bytes()[0]} }

LINE_COMMENT_SECOND: #run { Int{COMMENT_PREFIX.bytes()[1]} }

BLOCK_OPEN_FIRST: #run { Int{BLOCK_COMMENT_OPEN.bytes()[0]} }

BLOCK_OPEN_SECOND: #run { Int{BLOCK_COMMENT_OPEN.bytes()[1]} }

BLOCK_CLOSE_FIRST: #run { Int{BLOCK_COMMENT_CLOSE.bytes()[0]} }

BLOCK_CLOSE_SECOND: #run { Int{BLOCK_COMMENT_CLOSE.bytes()[1]} }

byte_at: fn(source: [U8], index: Int) -> Int Never! {
    if index < 0 || index >= source.len() -> return -1
    Int{source[index]}
}

is_continuation: fn(value: Int) -> Bool Never! { value >= 128 && value <= 191 }

utf8_width: fn(source: [U8], index: Int) -> Int Never! {
    first: byte_at(source, index)
    if first < 0 -> return 0
    if first < 128 -> return 1
    if first >= 194 && first <= 223 && is_continuation(byte_at(source, index + 1)) -> return 2
    if first >= 224 && first <= 239 && is_continuation(byte_at(source, index + 1)) && is_continuation(byte_at(source, index + 2)) {
        return 3
    }
    if first >= 240 && first <= 244 && is_continuation(byte_at(source, index + 1)) && is_continuation(byte_at(source, index + 2)) && is_continuation(byte_at(source, index + 3)) {
        return 4
    }
    1
}

scalar_at: fn(source: [U8], index: Int) -> String Never! {
    width: utf8_width(source, index)
    if width <= 0 -> return ""
    out := [U8]{}
    loop offset in 0..<width {
        if index + offset >= source.len() -> break
        out.push(source[index + offset])
    }
    String.from_bytes(out) ?? ""
}

ascii_alpha: fn(value: Int) -> Bool Never! {
    (value >= 65 && value <= 90) || (value >= 97 && value <= 122)
}

ascii_digit: fn(value: Int) -> Bool Never! { value >= 48 && value <= 57 }

// ASCII bytes take the byte tests alone: on an ASCII scalar the Unicode
// predicates agree with them (alphabetic = A-Z a-z, numeric = 0-9, uppercase
// = A-Z), and the String building in `scalar_at` is skipped. A position past
// the end (byte -1) keeps the general path.
is_identifier_start: fn(source: [U8], index: Int) -> Bool Never! {
    value: byte_at(source, index)
    if value >= 0 && value < 128 -> return value == 95 || ascii_alpha(value)
    value == 95 || ascii_alpha(value) || unicode.is_alphabetic(scalar_at(source, index))
}

is_identifier_continue: fn(source: [U8], index: Int) -> Bool Never! {
    value: byte_at(source, index)
    if value >= 0 && value < 128 -> return value == 95 || ascii_alpha(value) || ascii_digit(value)
    value == 95 || ascii_alpha(value) || ascii_digit(value) || unicode.is_alphabetic(scalar_at(source, index)) || unicode.is_numeric(scalar_at(source, index))
}

first_char_is_upper: fn(source: [U8], start: Int) -> Bool Never! {
    value: byte_at(source, start)
    if value >= 0 && value < 128 -> return value >= 65 && value <= 90
    scalar := scalar_at(source, start)
    unicode.is_alphabetic(scalar) && unicode.upper(scalar) == scalar && unicode.lower(scalar) != scalar
}

// An identifier at `start` (ending at `end`) that can name a case: an
// uppercase first character, or one `_` before one (a case kept on purpose
// that nothing builds, L0107).
case_name_start: fn(source: [U8], start: Int, end: Int) -> Bool Never! {
    if first_char_is_upper(source, start) -> return true
    end > start + 1 && byte_at(source, start) == 95 && first_char_is_upper(source, start + 1)
}

is_whitespace_at: fn(source: [U8], index: Int) -> Bool Never! {
    value: byte_at(source, index)
    if value < 0 -> return false
    if value < 128 {
        return value == 9 || value == 10 || value == 11 || value == 12 || value == 13 || value == 32
    }
    unicode.is_whitespace(scalar_at(source, index))
}

emit: fn(facts: ^[Int], kind: Int, start: Int, end: Int, uppercase: Bool) Never! {
    flag := 0
    if uppercase -> flag = 1
    facts.push(kind)
    facts.push(start)
    facts.push(end)
    facts.push(flag)
}

push_code: fn(facts: ^[Int], kind: Int, start: Int, end: Int, uppercase: Bool) -> Int Never! {
    emit(facts, kind, start, end, uppercase)
    kind
}

previous_scalar_start: fn(source: [U8], index: Int) -> Int Never! {
    if index <= 0 -> return -1
    cursor := index - 1
    loop cursor > 0 && is_continuation(byte_at(source, cursor)) -> cursor -= 1
    cursor
}

previous_is_identifier: fn(source: [U8], index: Int) -> Bool {
    previous: previous_scalar_start(source, index)
    previous >= 0 && is_identifier_continue(source, previous)
}

scan_ident_cont_table: fn() -> [U8] Never! {
    table := [U8]{}
    loop i in 0..<256 {
        ok: i == 95 || (i >= 97 && i <= 122) || (i >= 65 && i <= 90) || (i >= 48 && i <= 57)
        table.push(if ok -> U8{1} else -> U8{0})
    }
    table
}

SCAN_IDENT_CONT: #run scan_ident_cont_table()

// ASCII identifier bytes are tested via one table load; only a non-ASCII byte
// takes the scalar path (`is_identifier_continue`, `utf8_width`).
scan_identifier_end: fn(source: [U8], start: Int) -> Int {
    if start < 0 -> return start
    i := start
    count: source.len()
    loop i < count {
        value: Int{source[i]}
        if value < 128 {
            if SCAN_IDENT_CONT[value] != (U8{0}) {
                i += 1
                next
            }
            return i
        }
        if !is_identifier_continue(source, i) -> return i
        i += utf8_width(source, i)
    }
    i
}

// A paste `#{name}` written against letters (`get_#{field}`,
// `#{field}_value`) is read with them as one word, which the parser refuses:
// a paste is never glued to letters. `end` is where the word or paste just
// scanned stops; the result is where the glued word stops.
scan_glued_paste_end: fn(source: [U8], end: Int) -> Int {
    i := end
    loop i < source.len() {
        if byte_at(source, i) == 35 && byte_at(source, i + 1) == 123 && is_identifier_start(source, i + 2) {
            paste_end: scan_identifier_end(source, i + 2)
            if byte_at(source, paste_end) != 125 -> return i
            i = paste_end + 1
            next
        }
        if !is_identifier_continue(source, i) -> return i
        i = scan_identifier_end(source, i)
    }
    i
}

scan_unit_suffix_end: fn(source: [U8], start: Int) -> Int { scan_identifier_end(source, start) }

scan_digits: fn(source: [U8], start: Int) -> Int Never! {
    i := start
    loop i < source.len() {
        value: byte_at(source, i)
        if {
            ascii_digit(value) || value == 95 -> { i += 1 }
            else -> { return i }
        }
    }
    i
}

base_digit: fn(value: Int, radix: Int) -> Bool Never! {
    if value >= 48 && value <= 57 -> return value - 48 < radix
    if value >= 65 && value <= 70 -> return value - 55 < radix
    if value >= 97 && value <= 102 -> return value - 87 < radix
    false
}

base_number_end: fn(source: [U8], start: Int) -> Int Never! {
    marker: byte_at(source, start + 1)
    radix := if marker == {
        120 | 88 -> 16
        111 | 79 -> 8
        98 | 66 -> 2
        else -> 0
    }
    if radix == 0 -> return -1
    i := start + 2
    loop i < source.len() {
        value: byte_at(source, i)
        if {
            value == 95 || base_digit(value, radix) -> { i += 1 }
            else -> { return i }
        }
    }
    i
}

scan_numeric_end: fn(source: [U8], start: Int) -> Int Never! {
    if byte_at(source, start) == 48 {
        prefixed: base_number_end(source, start)
        if prefixed >= 0 -> return prefixed
    }
    i := scan_digits(source, start)
    if byte_at(source, i) == 46 && ascii_digit(byte_at(source, i + 1)) {
        i += 1
        i = scan_digits(source, i)
    }
    exponent: byte_at(source, i)
    if exponent == 101 || exponent == 69 {
        after: byte_at(source, i + 1)
        valid := ascii_digit(after)
        if (after == 43 || after == 45) && ascii_digit(byte_at(source, i + 2)) -> valid = true
        if valid {
            i += 1
            sign: byte_at(source, i)
            if sign == 43 || sign == 45 -> i += 1
            i = scan_digits(source, i)
        }
    }
    i
}

scan_number_end: fn(source: [U8], start: Int) -> Int {
    numeric_end: scan_numeric_end(source, start)
    if numeric_end < 0 -> return start + 1
    if base_number_end(source, start) >= 0 -> return numeric_end
    value: byte_at(source, numeric_end)
    if !ascii_alpha(value) && value != 95 -> return numeric_end
    scan_unit_suffix_end(source, numeric_end)
}

numeric_is_float: fn(source: [U8], start: Int) -> Bool Never! {
    if base_number_end(source, start) >= 0 -> return false
    i := scan_digits(source, start)
    if byte_at(source, i) == 46 && ascii_digit(byte_at(source, i + 1)) -> return true
    exponent: byte_at(source, i)
    if !(exponent == 101 || exponent == 69) -> return false
    after: byte_at(source, i + 1)
    ascii_digit(after) || ((after == 43 || after == 45) && ascii_digit(byte_at(source, i + 2)))
}

// Whether the decimal digits in `start..end` (separators skipped) fit the
// i64 token fast path.
decimal_digits_fit_int: fn(source: [U8], start: Int, end: Int) -> Bool Never! {
    value := 0
    i := start
    loop i < end {
        code: byte_at(source, i)
        i += 1
        if code == 95 -> next
        if !ascii_digit(code) -> return false
        digit: code - 48
        // value * 10 + digit <= I64 max exactly when value is below max /% 10,
        // or equal and digit <= the remainder 7 (parse_integer_literal).
        if value > 922337203685477580 || (value == 922337203685477580 && digit > 7) -> return false
        value = value * 10 + digit
    }
    true
}

scan_plain_string_end: fn(source: [U8], start: Int, raw_head: Bool) -> Int Never! {
    i := start + 1
    count: source.len()
    loop i < count {
        value: Int{source[i]}
        // Plain ASCII text bytes advance inline.
        if value < 128 && value != 10 && value != 34 && value != 123 && value != 125 && value != 92 {
            i += 1
            next
        }
        if value == 10 -> return -(i + 1)
        if value == 34 -> return i + 1
        if (value == 123 || value == 125) && byte_at(source, i + 1) == value {
            i += 2
            next
        }
        if value == 123 {
            i = scan_plain_interpolation_end(source, i)
            next
        }
        // Text a typed head may take scans as that head's body: a backslash
        // pairs only with `"` or `\`, so `\{` still opens a hole. Plain text
        // ends at the same quote unless it writes `\{` or `\}`, which are no
        // escapes.
        if {
            value == 92 -> {
                if {
                    !raw_head && byte_at(source, i + 1) == 117 -> {
                        i = scan_scalar_escape_end(source, i)
                    }
                    !raw_head || byte_at(source, i + 1) == 34 || byte_at(source, i + 1) == 92 -> {
                        if i + 1 < source.len() -> i += 2 else -> i += 1
                    }
                    else -> { i += 1 }
                }
            }
            else -> { i += utf8_width(source, i) }
        }
    }
    -(source.len() + 1)
}

// The index after one `{…}` inside a plain string, as Rust's string lexer
// reads it: an interpolation skips nested quoted text, raw backtick fences and
// nested braces; a `\$` `{…}` template payload only balances braces. An
// interpolation left open at the line end returns that line end, so the
// string scan reports it unclosed there.
scan_plain_interpolation_end: fn(source: [U8], open: Int) -> Int Never! {
    j := open + 1
    depth := 1
    template: byte_at(source, open - 1) == 36 && byte_at(source, open - 2) == 92
    in_quote := false
    loop j < source.len() {
        value: byte_at(source, j)
        if {
            template -> {
                if value == 123 -> depth += 1
                if value == 125 -> depth -= 1
                if depth == 0 -> return j + 1
            }
            in_quote -> {
                if value == 92 -> j += 1
                if value == 34 -> in_quote = false
                if value == 10 -> return j
            }
            value == 34 -> in_quote = true
            value == 96 -> {
                fence_end: scan_raw_fence_end(source, j)
                if fence_end < 0 -> return source.len()
                j = fence_end
                next
            }
            value == 123 -> depth += 1
            value == 125 -> {
                depth -= 1
                if depth == 0 -> return j + 1
            }
            value == 10 -> return j
            else -> {}
        }
        j += 1
    }
    source.len()
}

scan_raw_fence_end: fn(source: [U8], start: Int) -> Int Never! {
    fence_len := 0
    loop byte_at(source, start + fence_len) == 96 -> fence_len += 1
    cursor := start + fence_len
    loop cursor < source.len() {
        if byte_at(source, cursor) != 96 {
            cursor += 1
            next
        }
        run_start := cursor
        loop byte_at(source, cursor) == 96 -> cursor += 1
        if cursor - run_start == fence_len -> return cursor
    }
    -(source.len() + 1)
}

scan_triple_string_end: fn(source: [U8], start: Int, raw_head: Bool) -> Int Never! {
    i := start + 3
    depth := 0
    loop i < source.len() {
        value: byte_at(source, i)
        if depth == 0 {
            if value == 92 {
                if {
                    !raw_head && byte_at(source, i + 1) == 117 -> {
                        i = scan_scalar_escape_end(source, i)
                    }
                    !raw_head || byte_at(source, i + 1) == 34 || byte_at(source, i + 1) == 92 -> {
                        if i + 1 < source.len() -> i += 2 else -> i += 1
                    }
                    else -> { i += 1 }
                }
                next
            }
            if value == 123 && byte_at(source, i + 1) == 123 {
                i += 2
                next
            }
            if value == 123 {
                depth = 1
                i += 1
                next
            }
            if value == 34 && byte_at(source, i + 1) == 34 && byte_at(source, i + 2) == 34 {
                return i + 3
            }
            i += utf8_width(source, i)
            next
        }
        if value == LINE_COMMENT_FIRST && byte_at(source, i + 1) == LINE_COMMENT_SECOND {
            i += 2
            loop i < source.len() && byte_at(source, i) != 10 -> i += utf8_width(source, i)
            next
        }
        if value == BLOCK_OPEN_FIRST && byte_at(source, i + 1) == BLOCK_OPEN_SECOND {
            i += 2
            comment_depth := 1
            loop i < source.len() && comment_depth > 0 {
                if {
                    byte_at(source, i) == BLOCK_OPEN_FIRST && byte_at(source, i + 1) == BLOCK_OPEN_SECOND -> {
                        comment_depth += 1
                        i += 2
                    }
                    byte_at(source, i) == BLOCK_CLOSE_FIRST && byte_at(source, i + 1) == BLOCK_CLOSE_SECOND -> {
                        comment_depth -= 1
                        i += 2
                    }
                    else -> { i += utf8_width(source, i) }
                }
            }
            next
        }
        if value == 34 {
            triple := byte_at(source, i + 1) == 34 && byte_at(source, i + 2) == 34
            nested: if triple -> scan_triple_string_end(source, i, false) else -> scan_plain_string_end(source, i, false)
            if {
                nested >= 0 -> { i = nested }
                else -> { i = -nested - 1 }
            }
            next
        }
        if value == 39 {
            nested: scan_char_end(source, i)
            if {
                nested >= 0 -> { i = nested }
                else -> { i = source.len() }
            }
            next
        }
        if value == 96 {
            nested: scan_raw_fence_end(source, i)
            if {
                nested >= 0 -> { i = nested }
                else -> { i = source.len() }
            }
            next
        }
        if value == 123 {
            depth += 1
            i += 1
            next
        }
        if value == 125 {
            depth -= 1
            i += 1
            next
        }
        i += utf8_width(source, i)
    }
    -(source.len() + 1)
}

scan_raw_foreign_string_end: fn(source: [U8], start: Int) -> Int Never! {
    i := start + 3
    loop i + 2 < source.len() {
        if byte_at(source, i) == 34 && byte_at(source, i + 1) == 34 && byte_at(source, i + 2) == 34 {
            return i + 3
        }
        i += 1
    }
    -(source.len() + 1)
}

// The index after a `\u{H}` escape whose backslash is at `at`: its digits
// and closing brace, so that brace opens no hole. Malformed escapes end where
// they stop, and the payload pass reports them.
scan_scalar_escape_end: fn(source: [U8], at: Int) -> Int Never! {
    i := at + 2
    if byte_at(source, i) != 123 -> return i
    i += 1
    loop hex_value(byte_at(source, i)) >= 0 -> i += 1
    if byte_at(source, i) == 125 -> i += 1
    i
}

scan_char_end: fn(source: [U8], start: Int) -> Int Never! {
    i := start + 1
    if i >= source.len() -> return -1
    if {
        byte_at(source, i) == 92 -> {
            i += 2
            if i > source.len() -> i = source.len()
        }
        else -> { i += utf8_width(source, i) }
    }
    if byte_at(source, i) == 39 -> return i + 1
    loop i < source.len() && byte_at(source, i) != 39 -> i += utf8_width(source, i)
    if byte_at(source, i) == 39 -> i + 1 else -> source.len()
}

// The index after the nested `/* … */` comment opened at `start`. A comment
// whose openers are not all closed runs to the source end and returns
// `-(end + 1)`, so the payload pass can report it unclosed.
scan_block_comment_end: fn(source: [U8], start: Int) -> Int Never! {
    i := start + 2
    depth := 1
    loop i < source.len() && depth > 0 {
        if {
            byte_at(source, i) == BLOCK_OPEN_FIRST && byte_at(source, i + 1) == BLOCK_OPEN_SECOND -> {
                depth += 1
                i += 2
            }
            byte_at(source, i) == BLOCK_CLOSE_FIRST && byte_at(source, i + 1) == BLOCK_CLOSE_SECOND -> {
                depth -= 1
                i += 2
            }
            else -> { i += utf8_width(source, i) }
        }
    }
    if depth > 0 -> return -(i + 1)
    i
}

raw_token_facts: fn(source: [U8], config_surface: Bool) -> [Int] {
    facts := [Int]{}
    if source.len() > 16 -> facts.try_reserve(source.len() * 3 /% 4 + 8) ?? panic("reserve failed")
    _ := raw_token_facts_range(source, config_surface, 0, source.len(), -1, facts)
    facts
}

// Where a range scan stopped: `stop` is the first byte the scan did not
// read (`to` when the range ends between tokens, past it when a token
// straddles the range end); `bodies_local` is false when a `"""` head was
// scanned with no `fn` fact in the range before it, so `raw_foreign_body_at`
// would have read facts before the range.
RawScanStop: struct {
    stop: Int,
    bodies_local: Bool,
    has_paste: Bool{false},
    unclosed_block_comment: Bool{false},
}

// Scans `source[from..<to]` appending its facts to `facts`. A token that
// starts before `to` is scanned whole, so the scan can end past `to`. The
// range starts between tokens: `previous_code` is the kind of the code token
// before `from` (-1 at the start of the source); the `#!` launch line is
// read at byte 0 only, and the EOF fact is emitted when the range reaches
// the end of the source.
raw_token_facts_range: fn(source: [U8], config_surface: Bool, from: Int, to: Int, previous_code: Int, facts: ^[Int]) -> RawScanStop {
    if facts.len() <= 4 && to - from > 16 -> facts.try_reserve((to - from) * 3 /% 4 + 8) ?? panic("reserve failed")
    last_code := previous_code
    fn_in_range := false
    bodies_local := true
    has_paste := false
    unclosed_block_comment := false
    i := from
    count: source.len()
    if i == 0 && count >= 3 && source[0] == (U8{35}) && source[1] == (U8{33}) && source[2] == (U8{47}) {
        loop i < count && source[i] != (U8{10}) -> i += 1
        if i < count -> i += 1
    }
    loop i < to {
        // Fast-skip ASCII whitespace runs (including 4-space indentation blocks).
        b0 := source[i]
        if b0 == (U8{32}) || (b0 >= (U8{9}) && b0 <= (U8{13})) {
            i += 1
            loop i + 4 <= to && source[i] == (U8{32}) && source[i + 1] == (U8{32}) && source[i + 2] == (U8{32}) && source[i + 3] == (U8{32}) {
                i += 4
            }
            loop i < to {
                bw: source[i]
                if bw == (U8{32}) || (bw >= (U8{9}) && bw <= (U8{13})) {
                    i += 1
                    next
                }
                break
            }
            if i >= to -> break
            b0 = source[i]
        }
        value: Int{b0}
        if value == 95 || (value >= 97 && value <= 122) || (value >= 65 && value <= 90) {
            word_end: scan_identifier_end(source, i)
            end: if word_end < count && source[word_end] == (U8{35}) -> scan_glued_paste_end(source, word_end) else -> word_end
            if end != word_end -> has_paste = true
            kind: word_kind(source, i, end, last_code)
            if kind == TOKEN_KW_FN -> fn_in_range = true
            case_name: kind == TOKEN_IDENT && ((value <= 90 && value >= 65) || (value == 95 && case_name_start(source, i, end)))
            last_code = push_code(facts, kind, i, end, case_name)
            i = end
            next
        }
        if value >= 48 && value <= 57 {
            start: i
            numeric_end: scan_numeric_end(source, start)
            is_base: value == 48 && base_number_end(source, start) >= 0
            after: byte_at(source, numeric_end)
            end: if !is_base && (ascii_alpha(after) || after == 95) -> scan_unit_suffix_end(source, numeric_end) else -> numeric_end
            kind: if {
                end != numeric_end -> if numeric_is_float(source, start) || decimal_digits_fit_int(source, start, numeric_end) -> TOKEN_UNIT_NUMBER else -> TOKEN_INT
                !is_base && numeric_is_float(source, start) -> TOKEN_FLOAT
                else -> TOKEN_INT
            }
            last_code = push_code(facts, kind, start, end, false)
            i = end
            next
        }
        if value >= 128 {
            if is_whitespace_at(source, i) {
                i += utf8_width(source, i)
                next
            }
            if is_identifier_start(source, i) {
                word_end: scan_identifier_end(source, i)
                end: if word_end < count && source[word_end] == (U8{35}) -> scan_glued_paste_end(source, word_end) else -> word_end
                if end != word_end -> has_paste = true
                kind: word_kind(source, i, end, last_code)
                if kind == TOKEN_KW_FN -> fn_in_range = true
                case_name := false
                if kind == TOKEN_IDENT -> case_name = case_name_start(source, i, end)
                last_code = push_code(facts, kind, i, end, case_name)
                i = end
                next
            }
            i += utf8_width(source, i)
            next
        }
        start: i
        if value == {
            40 -> {
                last_code = push_code(facts, TOKEN_LPAREN, start, start + 1, false)
                i += 1
            }
            41 -> {
                last_code = push_code(facts, TOKEN_RPAREN, start, start + 1, false)
                i += 1
            }
            123 -> {
                last_code = push_code(facts, TOKEN_LBRACE, start, start + 1, false)
                i += 1
            }
            125 -> {
                last_code = push_code(facts, TOKEN_RBRACE, start, start + 1, false)
                i += 1
            }
            91 -> {
                last_code = push_code(facts, TOKEN_LBRACKET, start, start + 1, false)
                i += 1
            }
            93 -> {
                last_code = push_code(facts, TOKEN_RBRACKET, start, start + 1, false)
                i += 1
            }
            44 -> {
                last_code = push_code(facts, TOKEN_COMMA, start, start + 1, false)
                i += 1
            }
            59 -> {
                last_code = push_code(facts, TOKEN_SEMI, start, start + 1, false)
                i += 1
            }
            58 -> {
                next1: byte_at(source, i + 1)
                if {
                    next1 == 62 -> {
                        last_code = push_code(facts, TOKEN_FENCE_CLOSE, start, start + 2, false)
                        i += 2
                    }
                    next1 == 58 -> {
                        last_code = push_code(facts, TOKEN_COLON_COLON, start, start + 2, false)
                        i += 2
                    }
                    next1 == 61 -> {
                        last_code = push_code(facts, TOKEN_COLON_EQ, start, start + 2, false)
                        i += 2
                    }
                    else -> {
                        last_code = push_code(facts, TOKEN_COLON, start, start + 1, false)
                        i += 1
                    }
                }
            }
            46 -> {
                next1: byte_at(source, i + 1)
                if next1 == 46 {
                    next2: byte_at(source, i + 2)
                    if {
                        next2 == 46 -> {
                            last_code = push_code(facts, TOKEN_DOT_DOT_DOT, start, start + 3, false)
                            i += 3
                        }
                        next2 == 60 -> {
                            last_code = push_code(facts, TOKEN_DOT_DOT_LT, start, start + 3, false)
                            i += 3
                        }
                        else -> {
                            last_code = push_code(facts, TOKEN_DOT_DOT, start, start + 2, false)
                            i += 2
                        }
                    }
                } else {
                    last_code = push_code(facts, TOKEN_DOT, start, start + 1, false)
                    i += 1
                }
            }
            34 -> {
                next1: byte_at(source, i + 1)
                next2: byte_at(source, i + 2)
                if {
                    next1 == 34 && next2 == 34 -> {
                        if !fn_in_range -> bodies_local = false
                        end := if {
                            raw_foreign_body_at(source, facts, facts.len() /% 4) -> scan_raw_foreign_string_end(source, start)
                            else -> {
                                modes: string_head_modes(source, facts, facts.len() /% 4)
                                scan_triple_string_end(source, start, modes.raw_head)
                            }
                        }
                        if {
                            end < 0 -> { i = -end - 1 }
                            else -> {
                                last_code = push_code(facts, TOKEN_STRING, start, end, false)
                                i = end
                            }
                        }
                    }
                    else -> {
                        modes: string_head_modes(source, facts, facts.len() /% 4)
                        end: scan_plain_string_end(source, start, modes.raw_head)
                        if {
                            end < 0 -> { i = -end - 1 }
                            else -> {
                                last_code = push_code(facts, TOKEN_STRING, start, end, false)
                                i = end
                            }
                        }
                    }
                }
            }
            47 -> {
                next1: byte_at(source, i + 1)
                if {
                    value == LINE_COMMENT_FIRST && next1 == LINE_COMMENT_SECOND -> {
                        if config_surface && byte_at(source, i - 1) == 58 {
                            last_code = push_code(facts, TOKEN_SLASH, i, i + 1, false)
                            last_code = push_code(facts, TOKEN_SLASH, i + 1, i + 2, false)
                            i += 2
                        } else {
                            i += 2
                            loop i < count && source[i] != (U8{10}) -> i += 1
                            emit(facts, TOKEN_LINE_COMMENT, start, i, false)
                        }
                    }
                    value == BLOCK_OPEN_FIRST && next1 == BLOCK_OPEN_SECOND -> {
                        end: scan_block_comment_end(source, start)
                        if end < 0 -> unclosed_block_comment = true
                        i = if end < 0 -> -end - 1 else -> end
                        emit(facts, TOKEN_BLOCK_COMMENT, start, i, false)
                    }
                    next1 == 37 && byte_at(source, i + 2) == 61 -> {
                        last_code = push_code(facts, TOKEN_SLASH_PERCENT_EQ, start, start + 3, false)
                        i += 3
                    }
                    next1 == 37 -> {
                        last_code = push_code(facts, TOKEN_SLASH_PERCENT, start, start + 2, false)
                        i += 2
                    }
                    next1 == 61 -> {
                        last_code = push_code(facts, TOKEN_SLASH_EQ, start, start + 2, false)
                        i += 2
                    }
                    else -> {
                        last_code = push_code(facts, TOKEN_SLASH, start, start + 1, false)
                        i += 1
                    }
                }
            }
            61 -> {
                if byte_at(source, i + 1) == 61 {
                    last_code = push_code(facts, TOKEN_EQ_EQ, start, start + 2, false)
                    i += 2
                } else {
                    last_code = push_code(facts, TOKEN_EQ, start, start + 1, false)
                    i += 1
                }
            }
            45 -> {
                next1: byte_at(source, i + 1)
                if {
                    next1 == 62 -> {
                        last_code = push_code(facts, TOKEN_UNIFIED_ARROW, start, start + 2, false)
                        i += 2
                    }
                    next1 == 45 -> {
                        last_code = push_code(facts, TOKEN_MINUS_MINUS, start, start + 2, false)
                        i += 2
                    }
                    next1 == 61 -> {
                        last_code = push_code(facts, TOKEN_MINUS_EQ, start, start + 2, false)
                        i += 2
                    }
                    else -> {
                        last_code = push_code(facts, TOKEN_MINUS, start, start + 1, false)
                        i += 1
                    }
                }
            }
            43 -> {
                next1: byte_at(source, i + 1)
                if {
                    next1 == 43 -> {
                        last_code = push_code(facts, TOKEN_PLUS_PLUS, start, start + 2, false)
                        i += 2
                    }
                    next1 == 61 -> {
                        last_code = push_code(facts, TOKEN_PLUS_EQ, start, start + 2, false)
                        i += 2
                    }
                    else -> {
                        last_code = push_code(facts, TOKEN_PLUS, start, start + 1, false)
                        i += 1
                    }
                }
            }
            33 -> {
                if byte_at(source, i + 1) == 61 {
                    last_code = push_code(facts, TOKEN_NOT_EQ, start, start + 2, false)
                    i += 2
                } else {
                    last_code = push_code(facts, TOKEN_BANG, start, start + 1, false)
                    i += 1
                }
            }
            63 -> {
                next1: byte_at(source, i + 1)
                if {
                    next1 == 63 -> {
                        last_code = push_code(facts, TOKEN_QUESTION_QUESTION, start, start + 2, false)
                        i += 2
                    }
                    next1 == 46 -> {
                        last_code = push_code(facts, TOKEN_QUESTION_DOT, start, start + 2, false)
                        i += 2
                    }
                    else -> {
                        last_code = push_code(facts, TOKEN_QUESTION, start, start + 1, false)
                        i += 1
                    }
                }
            }
            38 -> {
                next1: byte_at(source, i + 1)
                if {
                    next1 == 38 -> {
                        last_code = push_code(facts, TOKEN_AND_AND, start, start + 2, false)
                        i += 2
                    }
                    next1 == 61 -> {
                        last_code = push_code(facts, TOKEN_AMP_EQ, start, start + 2, false)
                        i += 2
                    }
                    next1 == 126 && byte_at(source, i + 2) == 61 -> {
                        last_code = push_code(facts, TOKEN_AMP_TILDE_EQ, start, start + 3, false)
                        i += 3
                    }
                    next1 == 126 -> {
                        last_code = push_code(facts, TOKEN_AMP_TILDE, start, start + 2, false)
                        i += 2
                    }
                    else -> {
                        last_code = push_code(facts, TOKEN_AMP, start, start + 1, false)
                        i += 1
                    }
                }
            }
            124 -> {
                next1: byte_at(source, i + 1)
                if {
                    next1 == 124 -> {
                        last_code = push_code(facts, TOKEN_OR_OR, start, start + 2, false)
                        i += 2
                    }
                    next1 == 62 -> {
                        last_code = push_code(facts, TOKEN_PIPE_GT, start, start + 2, false)
                        i += 2
                    }
                    next1 == 61 -> {
                        last_code = push_code(facts, TOKEN_PIPE_EQ, start, start + 2, false)
                        i += 2
                    }
                    else -> {
                        last_code = push_code(facts, TOKEN_PIPE, start, start + 1, false)
                        i += 1
                    }
                }
            }
            60 -> {
                next1: byte_at(source, i + 1)
                if {
                    next1 == 60 && byte_at(source, i + 2) == 61 -> {
                        last_code = push_code(facts, TOKEN_SHL_EQ, start, start + 3, false)
                        i += 3
                    }
                    next1 == 60 -> {
                        last_code = push_code(facts, TOKEN_SHL, start, start + 2, false)
                        i += 2
                    }
                    next1 == 61 && byte_at(source, i + 2) == 62 -> {
                        last_code = push_code(facts, TOKEN_COMPARE, start, start + 3, false)
                        i += 3
                    }
                    next1 == 61 -> {
                        last_code = push_code(facts, TOKEN_LE, start, start + 2, false)
                        i += 2
                    }
                    next1 == 62 -> {
                        last_code = push_code(facts, TOKEN_LT_GT, start, start + 2, false)
                        i += 2
                    }
                    next1 == 58 -> {
                        last_code = push_code(facts, TOKEN_FENCE_OPEN, start, start + 2, false)
                        i += 2
                    }
                    else -> {
                        last_code = push_code(facts, TOKEN_LT, start, start + 1, false)
                        i += 1
                    }
                }
            }
            62 -> {
                next1: byte_at(source, i + 1)
                if {
                    next1 == 62 && byte_at(source, i + 2) == 61 -> {
                        last_code = push_code(facts, TOKEN_SHR_EQ, start, start + 3, false)
                        i += 3
                    }
                    next1 == 62 -> {
                        last_code = push_code(facts, TOKEN_SHR, start, start + 2, false)
                        i += 2
                    }
                    next1 == 61 -> {
                        last_code = push_code(facts, TOKEN_GE, start, start + 2, false)
                        i += 2
                    }
                    else -> {
                        last_code = push_code(facts, TOKEN_GT, start, start + 1, false)
                        i += 1
                    }
                }
            }
            42 -> {
                if byte_at(source, i + 1) == 61 {
                    last_code = push_code(facts, TOKEN_STAR_EQ, start, start + 2, false)
                    i += 2
                } else {
                    last_code = push_code(facts, TOKEN_STAR, start, start + 1, false)
                    i += 1
                }
            }
            37 -> {
                next1: byte_at(source, i + 1)
                if {
                    next1 == 37 && byte_at(source, i + 2) == 61 -> {
                        last_code = push_code(facts, TOKEN_PERCENT_PERCENT_EQ, start, start + 3, false)
                        i += 3
                    }
                    next1 == 37 -> {
                        last_code = push_code(facts, TOKEN_PERCENT_PERCENT, start, start + 2, false)
                        i += 2
                    }
                    next1 == 61 -> {
                        last_code = push_code(facts, TOKEN_PERCENT_EQ, start, start + 2, false)
                        i += 2
                    }
                    else -> {
                        last_code = push_code(facts, TOKEN_PERCENT, start, start + 1, false)
                        i += 1
                    }
                }
            }
            35 -> {
                next1: byte_at(source, i + 1)
                next2: byte_at(source, i + 2)
                if next1 == 33 && next2 == 47 {
                    loop i < count && source[i] != (U8{10}) -> i += 1
                    if i < count -> i += 1
                } else if next1 == 123 && is_identifier_start(source, i + 2) {
                    paste_end := scan_identifier_end(source, i + 2)
                    if byte_at(source, paste_end) == 46 && byte_at(source, paste_end + 1) == 98 && byte_at(source, paste_end + 2) == 111 && byte_at(source, paste_end + 3) == 100 && byte_at(source, paste_end + 4) == 121 && byte_at(source, paste_end + 5) == 125 {
                        paste_end += 5
                    }
                    if byte_at(source, paste_end) == 125 {
                        glued: scan_glued_paste_end(source, paste_end + 1)
                        has_paste = true
                        last_code = push_code(facts, TOKEN_IDENT, start, glued, false)
                        i = glued
                    } else {
                        last_code = push_code(facts, TOKEN_HASH, start, start + 1, false)
                        i += 1
                    }
                } else if is_identifier_start(source, i + 1) && !previous_is_identifier(source, i) {
                    word_end: scan_identifier_end(source, i + 1)
                    if word_end - i == 4 && next1 == 114 && next2 == 117 && byte_at(source, i + 3) == 110 {
                        last_code = push_code(facts, TOKEN_PREP, start, word_end, false)
                        i = word_end
                    } else {
                        word: word_kind(source, i + 1, word_end, 0)
                        if word == TOKEN_KW_IF || word == TOKEN_KW_LOOP {
                            last_code = push_code(facts, TOKEN_PREP, start, start + 1, false)
                            i += 1
                        } else {
                            last_code = push_code(facts, TOKEN_HASH, start, start + 1, false)
                            i += 1
                        }
                    }
                } else {
                    last_code = push_code(facts, TOKEN_HASH, start, start + 1, false)
                    i += 1
                }
            }
            64 -> {
                if {
                    is_identifier_start(source, i + 1) && !previous_is_identifier(source, i) -> {
                        end: scan_identifier_end(source, i + 1)
                        marker_kind: word_kind(source, i + 1, end, 0)
                        if {
                            marker_kind == TOKEN_IDENT -> {
                                last_code = push_code(facts, TOKEN_IDENT, start, end, false)
                                i = end
                            }
                            else -> {
                                last_code = push_code(facts, TOKEN_AT, start, start + 1, false)
                                i += 1
                            }
                        }
                    }
                    else -> {
                        last_code = push_code(facts, TOKEN_AT, start, start + 1, false)
                        i += 1
                    }
                }
            }
            36 -> {
                if {
                    is_identifier_start(source, i + 1) && !previous_is_identifier(source, i) -> {
                        end: scan_identifier_end(source, i + 1)
                        last_code = push_code(facts, TOKEN_IDENT, start, end, false)
                        i = end
                    }
                    else -> {
                        last_code = push_code(facts, TOKEN_DOLLAR, start, start + 1, false)
                        i += 1
                    }
                }
            }
            94 -> {
                if {
                    byte_at(source, i + 1) == 94 -> {
                        last_code = push_code(facts, TOKEN_CARET_CARET, start, start + 2, false)
                        i += 2
                    }
                    byte_at(source, i + 1) == 61 -> {
                        last_code = push_code(facts, TOKEN_CARET_EQ, start, start + 2, false)
                        i += 2
                    }
                    else -> {
                        last_code = push_code(facts, TOKEN_CARET, start, start + 1, false)
                        i += 1
                    }
                }
            }
            126 -> {
                next1: byte_at(source, i + 1)
                if {
                    next1 == 126 -> {
                        last_code = push_code(facts, TOKEN_TILDE_TILDE, start, start + 2, false)
                        i += 2
                    }
                    next1 == 124 && byte_at(source, i + 2) == 61 -> {
                        last_code = push_code(facts, TOKEN_TILDE_PIPE_EQ, start, start + 3, false)
                        i += 3
                    }
                    next1 == 124 -> {
                        last_code = push_code(facts, TOKEN_TILDE_PIPE, start, start + 2, false)
                        i += 2
                    }
                    next1 == 61 -> {
                        last_code = push_code(facts, TOKEN_TILDE_EQ, start, start + 2, false)
                        i += 2
                    }
                    else -> {
                        last_code = push_code(facts, TOKEN_TILDE, start, start + 1, false)
                        i += 1
                    }
                }
            }
            96 -> {
                end: scan_raw_fence_end(source, start)
                if {
                    end < 0 -> { i = -end - 1 }
                    else -> {
                        last_code = push_code(facts, TOKEN_RAW_STRING, start, end, false)
                        i = end
                    }
                }
            }
            39 -> {
                end: scan_char_end(source, start)
                if {
                    end < 0 -> { i = count }
                    else -> {
                        last_code = push_code(facts, TOKEN_CHAR, start, end, false)
                        i = end
                    }
                }
            }
            else -> {
                i += 1
            }
        }
    }
    if to >= count -> emit(facts, TOKEN_EOF, count, count, false)
    RawScanStop{stop: i, bodies_local: bodies_local, has_paste: has_paste, unclosed_block_comment: unclosed_block_comment}
}

terminator_events_scanned: fn(source: [U8], config_surface: Bool) -> [Int] {
    facts: raw_token_facts(source, config_surface)
    terminator_events(source, facts)
}
