// Statement-termination scanner over the single canonical TOKEN_* kinds in Tokens.jet.
// Each input row is [kind, byte_start, byte_end, case_name_start].
// Each output row is [event, raw_token_index, byte_position].
use jet_foundation.[
    Diagnostic,
    Span,
    diagnostic_from_registry,
]

// Facts hold four ints per token, so `index * 4 < facts.len()` is the bound
// check without a division on every call.
kind_at: fn(facts: [Int], index: Int) -> Int Never! {
    if index < 0 || index * 4 >= facts.len() -> return 0
    return facts[index * 4]
}

ends_statement: fn(kind: Int) -> Bool Never! {
    if kind == {
        TOKEN_IDENT -> true
        TOKEN_RAW_STRING -> true
        TOKEN_STRING -> true
        TOKEN_INT -> true
        TOKEN_FLOAT -> true
        TOKEN_UNIT_NUMBER -> true
        TOKEN_CHAR -> true
        TOKEN_TRUE -> true
        TOKEN_FALSE -> true
        TOKEN_SELF -> true
        TOKEN_NULL -> true
        TOKEN_BREAK -> true
        TOKEN_RETURN -> true
        TOKEN_RPAREN -> true
        TOKEN_RBRACKET -> true
        TOKEN_RBRACE -> true
        TOKEN_QUESTION -> true
        TOKEN_BANG -> true
        TOKEN_GT -> true
        TOKEN_SHR -> true
        TOKEN_LT_GT -> true
        TOKEN_FENCE_CLOSE -> true
        // A bodiless declaration ends its line on its kind word
        // (`pricing: module`).
        TOKEN_KW_MODULE -> true
        else -> false
    }
}

suppresses_terminator: fn(kind: Int) -> Bool Never! {
    if kind == {
        TOKEN_FENCE_CLOSE -> true
        TOKEN_DOT -> true
        TOKEN_QUESTION_DOT -> true
        TOKEN_AND_AND -> true
        TOKEN_OR_OR -> true
        TOKEN_PLUS -> true
        TOKEN_MINUS -> true
        TOKEN_STAR -> true
        TOKEN_SLASH -> true
        TOKEN_SLASH_PERCENT -> true
        TOKEN_PERCENT -> true
        TOKEN_PERCENT_PERCENT -> true
        TOKEN_EQ_EQ -> true
        TOKEN_NOT_EQ -> true
        TOKEN_LT -> true
        TOKEN_GT -> true
        TOKEN_LE -> true
        TOKEN_GE -> true
        TOKEN_COMPARE -> true
        TOKEN_AMP -> true
        TOKEN_PIPE -> true
        TOKEN_CARET -> true
        TOKEN_TILDE -> true
        TOKEN_AMP_TILDE -> true
        TOKEN_TILDE_PIPE -> true
        TOKEN_SHL -> true
        TOKEN_SHR -> true
        TOKEN_PIPE_GT -> true
        TOKEN_QUESTION_QUESTION -> true
        else -> false
    }
}

arrow: fn(kind: Int) -> Bool Never! {
    if kind == {
        TOKEN_UNIFIED_ARROW -> true
        else -> false
    }
}

newline_between: fn(source: [U8], start: Int, end: Int) -> Bool Never! {
    if start < 0 || start >= end || end > source.len() -> return false
    if end - start == 1 -> return source[start] == (U8{10})
    cursor := start
    loop cursor + 4 <= end {
        if source[cursor] == (U8{10}) || source[cursor + 1] == (U8{10}) || source[cursor + 2] == (U8{10}) || source[cursor + 3] == (U8{10}) -> return true
        cursor += 4
    }
    loop cursor < end {
        if source[cursor] == (U8{10}) -> return true
        cursor += 1
    }
    false
}

scope_member_starts_at: fn(facts: [Int], index: Int) -> Bool Never! {
    if kind_at(facts, index) != TOKEN_DOT || kind_at(facts, index + 1) != TOKEN_IDENT -> return false
    cursor := index + 2
    if kind_at(facts, cursor) == TOKEN_LBRACE -> return true
    if kind_at(facts, cursor) != TOKEN_LPAREN -> return false
    depth := 0
    loop cursor * 4 < facts.len() {
        kind: kind_at(facts, cursor)
        if kind == TOKEN_LPAREN -> depth += 1
        if kind == TOKEN_RPAREN {
            depth -= 1
            if depth == 0 {
                cursor += 1
                break
            }
        }
        if kind == TOKEN_EOF -> return false
        cursor += 1
    }
    return kind_at(facts, cursor) == TOKEN_LBRACE
}

leading_dot_variant: fn(facts: [Int], index: Int) -> Bool Never! {
    kind: kind_at(facts, index)
    if kind == TOKEN_NULL -> return true
    return kind == TOKEN_IDENT && facts[index * 4 + 3] == 1
}

skip_comment_tokens: fn(facts: [Int], index: Int) -> Int Never! {
    cursor := index
    loop {
        kind: kind_at(facts, cursor)
        if kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT -> cursor += 1 else -> break
    }
    return cursor
}

// Whether `source` may pin an inline dependency version, `use name#1.4`:
// some `#` code token is followed, past comments, by a number. A source with
// none pins nothing, so finding its pins needs no parse (JetCLI ScriptDeps).
// A `#` in a comment or a string, an attribute (`#Error`) and the `#!`
// launch line are not code `#` tokens followed by a number.
lex_may_pin_inline_version: fn(source: [U8]) -> Bool Never! {
    facts: raw_token_facts(source, false)
    index := 0
    loop index * 4 < facts.len() {
        if kind_at(facts, index) == TOKEN_HASH {
            after: kind_at(facts, skip_comment_tokens(facts, index + 1))
            if after == TOKEN_INT || after == TOKEN_FLOAT || after == TOKEN_UNIT_NUMBER -> return true
        }
        index += 1
    }
    false
}

dispatch_arm_starts_at: fn(source: [U8], facts: [Int], index: Int) -> Bool Never! {
    if kind_at(facts, index) != TOKEN_DOT -> return false
    cursor := skip_comment_tokens(facts, index + 1)
    if kind_at(facts, cursor) == TOKEN_LBRACE {
        depth := 0
        loop cursor * 4 < facts.len() {
            kind: kind_at(facts, cursor)
            if kind == TOKEN_LBRACE -> depth += 1
            if kind == TOKEN_RBRACE {
                depth -= 1
                if depth == 0 {
                    cursor += 1
                    break
                }
            }
            if kind == TOKEN_EOF -> return false
            cursor += 1
        }
        cursor = skip_comment_tokens(facts, cursor)
        return arrow(kind_at(facts, cursor))
    }
    cursor = arm_name_end(facts, cursor)
    if cursor < 0 -> return false
    // Each structural or-pattern alternative has the same
    // leading-dot variant/path/payload shape. Keep consuming alternatives
    // before looking for a guard or arrow; otherwise a following arm's
    // leading `.` is mistaken for a fluent chain continuation.
    loop {
        cursor = skip_comment_tokens(facts, cursor)
        loop {
            if kind_at(facts, cursor) != TOKEN_DOT -> break
            variant := skip_comment_tokens(facts, cursor + 1)
            if !leading_dot_variant(facts, variant) -> break
            cursor = variant + 1
            cursor = skip_comment_tokens(facts, cursor)
        }
        cursor = skip_comment_tokens(facts, cursor)
        if kind_at(facts, cursor) == TOKEN_LPAREN {
            depth := 0
            loop cursor * 4 < facts.len() {
                kind: kind_at(facts, cursor)
                if kind == TOKEN_LPAREN -> depth += 1
                if kind == TOKEN_RPAREN {
                    depth -= 1
                    if depth == 0 {
                        cursor += 1
                        break
                    }
                }
                if kind == TOKEN_EOF -> return false
                cursor += 1
            }
        }
        cursor = skip_comment_tokens(facts, cursor)
        if kind_at(facts, cursor) != TOKEN_PIPE -> break
        cursor += 1
        cursor = skip_comment_tokens(facts, cursor)
        if kind_at(facts, cursor) != TOKEN_DOT -> return false
        cursor = arm_name_end(facts, skip_comment_tokens(facts, cursor + 1))
        if cursor < 0 -> return false
    }
    cursor = skip_comment_tokens(facts, cursor)
    // A braceless arm may add a Boolean guard after its complete
    // structural head (`.Key(key) | .Other(key) && key == "b" -> ...`).
    // Scan that guard only on its source line; an unrelated arrow on a later
    // line must not turn a fluent chain into a new arm.
    connector: kind_at(facts, cursor)
    is_boolean_connector: if connector == {
        TOKEN_AND_AND -> true
        TOKEN_OR_OR -> true
        else -> false
    }
    if is_boolean_connector {
        guard_start: facts[cursor * 4 + 1]
        depth := 0
        loop cursor * 4 < facts.len() {
            kind: kind_at(facts, cursor)
            is_open_delimiter: if kind == {
                TOKEN_LPAREN -> true
                TOKEN_LBRACKET -> true
                TOKEN_LBRACE -> true
                else -> false
            }
            if is_open_delimiter -> depth += 1 else {
                is_close_delimiter: if kind == {
                    TOKEN_RPAREN -> true
                    TOKEN_RBRACKET -> true
                    TOKEN_RBRACE -> true
                    else -> false
                }
                if {
                    is_close_delimiter -> {
                        if depth > 0 -> depth -= 1
                    }
                    arrow(kind) && depth == 0 -> {
                        return !newline_between(source, guard_start, facts[cursor * 4 + 1])
                    }
                    else -> {}
                }
            }
            cursor += 1
        }
        return false
    }
    return arrow(kind_at(facts, cursor))
}

// The end of an arm's name after its leading `.`: the modules that lead to a
// type (`geo.`), the variant or type name, and the type arguments that name
// one instance (`Box<Int, String>`); -1 when no arm name starts at `index`.
arm_name_end: fn(facts: [Int], index: Int) -> Int Never! {
    cursor := index
    loop kind_at(facts, cursor) == TOKEN_IDENT && facts[cursor * 4 + 3] != 1 && kind_at(facts, cursor + 1) == TOKEN_DOT {
        cursor += 2
    }
    if !leading_dot_variant(facts, cursor) -> return -1
    cursor += 1
    if kind_at(facts, cursor) != TOKEN_LT -> return cursor
    depth := 0
    loop cursor * 4 < facts.len() {
        kind: kind_at(facts, cursor)
        if kind == TOKEN_EOF || kind == TOKEN_LBRACE || kind == TOKEN_RBRACE || arrow(kind) -> return -1
        if kind == TOKEN_LT -> depth += 1
        if kind == TOKEN_GT -> depth -= 1
        if kind == TOKEN_SHR -> depth -= 2
        if depth <= 0 -> return cursor + 1
        cursor += 1
    }
    -1
}

// `&name` / `&&name` / `name.move()` written together at line start marks
// the place a call writes or takes, so it begins a statement, and so does a
// complement `~name` written together. A continued bitwise-and, exclusive-or,
// logical-and or power line keeps a space after its operator.
place_mark_starts_at: fn(facts: [Int], index: Int) -> Bool Never! {
    mark: kind_at(facts, index)
    if mark != TOKEN_AMP && mark != TOKEN_AND_AND && mark != TOKEN_CARET && mark != TOKEN_TILDE -> return false
    name: kind_at(facts, index + 1)
    if name != TOKEN_IDENT && name != TOKEN_SELF -> return false
    return facts[index * 4 + 2] == facts[(index + 1) * 4 + 1]
}

// `{ member: local, … }: tuple` at line start renames tuple members, so
// it begins a statement rather than continuing the line above.
tuple_rename_starts_at: fn(facts: [Int], index: Int) -> Bool Never! {
    if kind_at(facts, index + 1) != TOKEN_IDENT -> return false
    depth := 0
    at := index
    loop at * 4 < facts.len() {
        kind: kind_at(facts, at)
        if kind == TOKEN_EOF -> return false
        if kind == TOKEN_LBRACE -> depth += 1
        if kind == TOKEN_RBRACE {
            depth -= 1
            if depth == 0 {
                after: kind_at(facts, at + 1)
                return after == TOKEN_COLON || after == TOKEN_COLON_COLON || after == TOKEN_COLON_EQ
            }
        }
        at += 1
    }
    false
}

// `{x: 1, y: 2}` or `{min, max}` at line start is a record value, so it
// begins a statement, such as a body's final value, rather than continuing
// the line above: a `,` at its own level separates its members and its
// first member is `name:` or a bare name.
record_value_starts_at: fn(facts: [Int], index: Int) -> Bool Never! {
    if kind_at(facts, index + 1) != TOKEN_IDENT -> return false
    first: kind_at(facts, index + 2)
    if first != TOKEN_COLON && first != TOKEN_COMMA -> return false
    depth := 0
    at := index
    loop at * 4 < facts.len() {
        kind: kind_at(facts, at)
        if kind == TOKEN_EOF -> return false
        if kind == TOKEN_LBRACE || kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET -> depth += 1
        if kind == TOKEN_RBRACE || kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET {
            depth -= 1
            if depth == 0 -> return false
        }
        if kind == TOKEN_COMMA && depth == 1 -> return true
        at += 1
    }
    false
}

// The token at `index` ends a statement at a line break. A postfix deref
// `p.*` ends its line like the name it dereferences; any other trailing `*`
// is a multiplication continued on the next line.
ends_statement_at: fn(facts: [Int], index: Int) -> Bool Never! {
    kind: kind_at(facts, index)
    if kind == TOKEN_STAR -> return index > 0 && kind_at(facts, index - 1) == TOKEN_DOT
    ends_statement(kind)
}

terminator_events: fn(source: [U8], facts: [Int]) -> [Int] Never! {
    facts_len: facts.len()
    events := [Int]{}
    if facts_len > 64 -> events.try_reserve(facts_len /% 8) ?? panic("reserve failed")
    last_code := -1
    index := 0
    loop index * 4 < facts_len {
        kind: facts[index * 4]
        if kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT {
            index += 1
            next
        }
        if kind == TOKEN_EOF {
            if last_code >= 0 {
                previous: facts[last_code * 4]
                if previous != TOKEN_RBRACE && ends_statement_at(facts, last_code) {
                    events.push(1)
                    events.push(index)
                    events.push(facts[last_code * 4 + 2])
                }
            }
            index += 1
            next
        }
        if last_code >= 0 {
            end: facts[last_code * 4 + 2]
            start: facts[index * 4 + 1]
            if start > end && ends_statement_at(facts, last_code) && newline_between(source, end, start) {
                previous: facts[last_code * 4]
                split: kind == TOKEN_UNIFIED_ARROW || kind == TOKEN_LBRACE
                if {
                    kind == TOKEN_LBRACE && (tuple_rename_starts_at(facts, index) || (previous != TOKEN_RBRACE && record_value_starts_at(facts, index))) -> {
                        events.push(1)
                        events.push(index)
                        events.push(end)
                    }
                    split && previous == TOKEN_RPAREN -> {
                        events.push(2)
                        events.push(index)
                        events.push(start)
                    }
                    else -> {
                        if (!suppresses_terminator(kind) || scope_member_starts_at(facts, index) || dispatch_arm_starts_at(source, facts, index) || place_mark_starts_at(facts, index)) && kind != TOKEN_RPAREN && kind != TOKEN_RBRACKET {
                            events.push(1)
                            events.push(index)
                            events.push(end)
                        }
                    }
                }
            }
        }
        last_code = index
        index += 1
    }
    events
}

split_spelling: fn(kind: Int) -> String Never! {
    if kind == {
        TOKEN_UNIFIED_ARROW -> "->"
        TOKEN_LBRACE -> "{{"
        else -> ""
    }
}

// Applies the events of `events[event_index..]` at fact `raw_index` before
// that fact's token lands: a `;` token, or the E0986 diagnostic of a split
// header. Returns the index of the first later event.
terminator_events_apply: fn(facts: [Int], events: [Int], event_index: Int, raw_index: Int, tokens: &[Token], diagnostics: &[Diagnostic]) -> Int {
    at_event := event_index
    event_count: events.len() /% 3
    loop at_event < event_count && events[at_event * 3 + 1] == raw_index {
        event: events[at_event * 3]
        at: events[at_event * 3 + 2]
        if {
            event == 1 -> { tokens.push(token_synthetic(TOKEN_SEMI, Span{start: at, end: at})) }
            else -> {
                kind: kind_at(facts, raw_index)
                start: facts[raw_index * 4 + 1]
                end: facts[raw_index * 4 + 2]
                spelling: split_spelling(kind)
                diagnostics.push(
                    diagnostic_from_registry(
                        "E0986",
                        Val(Span{start: start, end: end}),
                        "`{spelling}` must stay on the same line as the closing `)`",
                        "an arrow, effect row, or opening block continues the header on its line",
                        "move `{spelling}` up to the `)` line",
                    ),
                )
            }
        }
        at_event += 1
    }
    at_event
}

lex_with_terminators: fn(source: [U8], config_surface: Bool, allow_reserved_identifiers: Bool) -> Lexed {
    tables := token_tables()
    facts := [Int]{}
    if source.len() > 16 -> facts.try_reserve(source.len()) ?? panic("reserve failed")
    scanned: raw_token_facts_range(source, config_surface, 0, source.len(), -1, facts)
    tables.has_paste = scanned.has_paste
    events: terminator_events(source, facts)
    terminator_diagnostics := [Diagnostic]{}
    lexed := lex_payload_from_facts(source, facts, events, config_surface, allow_reserved_identifiers, 0, 0, source.len(), tables, terminator_diagnostics)
    diagnostics := lexed.diagnostics.move()
    diagnostics.extend(terminator_diagnostics)
    Lexed{tokens: lexed.tokens.move(), tables: tables.move(), diagnostics: diagnostics.move()}
}

lex: fn(source: [U8]) -> Lexed { lex_with_terminators(source, false, false) }

lex_config: fn(source: [U8]) -> Lexed { lex_with_terminators(source, true, false) }

lex_generated: fn(source: [U8]) -> Lexed { lex_with_terminators(source, false, true) }
