// Canonical encoding-format rows drive the shared EncodingFormat carrier.
format_row JSON core.encoding.json JSON
format_row JSONL core.encoding.jsonl JSONL
format_row CSV core.encoding.csv CSV
format_row TOML core.encoding.toml TOML
format_row YAML core.encoding.yaml YAML
format_row XML core.encoding.xml XML
format_row CBOR core.encoding.cbor CBOR

// Dispatcher constructor rows and ambient routes are declaration facts.
// The expression after `|` is the one tier adapter; the generated Rust
