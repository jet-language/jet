        fn what(self) -> String { "A package file operation failed" }
        fn why(self) -> String { "Jet could not read or write a file that package resolution needs." }
        fn fix(self) -> String { "Check the permissions and free space of the named path, then run the command again." }
    }
}

struct RetiredJetpackToml {
    impl Diagnostic {
        code :: "E1225"
        stage :: [.Jet]
        status :: .Retired
        meaning :: "`jetpack.toml` is retired"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "`jetpack.toml` is retired." }
        fn why(self) -> String { "Package identity and named sources now live in `package.jet` and `env.jet`, so dependency resolution uses one Jet grammar." }
        fn fix(self) -> String { "Move `[repo]` `name`/`version` to `package.jet`, move `[sources]` entries to `env.jet` `sources: {{ … }}`, then delete `jetpack.toml`." }
    }
}

struct RetiredManifestName {
    name: String

    impl Diagnostic {
        code :: "E1226"
        stage :: [.Jet]
        status :: .Retired
        meaning :: "A retired manifest filename (`pkg.jet`/`pack.jet`/`payload.jet`/`jet.toml`) found where `package.jet` belongs"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "`{self.name}` is not the package manifest name — Jet reads `package.jet`." }
        fn why(self) -> String { "The manifest filename is frozen to one spelling so tooling, docs, and every worked example never have to guess which file to read. `pkg.jet`, `pack.jet`, `payload.jet`, and `jet.toml` are retired names from earlier manifest reshapes." }
        fn fix(self) -> String { "Rename `{self.name}` to `package.jet`." }
    }
}

struct EngineProtocolMismatch {
    jet_version: String
    engine: String
    engine_version: String

    impl Diagnostic {
        code :: "E1227"
        stage :: [.Jet]
        meaning :: "`jet` and the `jetpack`/`jetos` engine binary disagree on protocol version"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Use matching `jet` and engine versions from one installed toolchain."
        fn what(self) -> String { "`jet` {self.jet_version} and `{self.engine}` {self.engine_version} disagree." }
        fn why(self) -> String { "`jet` and its engine binaries (`jetpack`, `jetos`) ship as one toolchain and must match exactly — a version-skewed engine may not understand what `jet` sends it. `jet` checks this with an `--engine-protocol` handshake before running any engine verb. A `jet os` or `jet image` dispatch reports this engine error." }
        fn fix(self) -> String { "Use matching `jet`/`{self.engine}` versions — reinstall the toolchain so both binaries come from the same release." }
    }
}

struct MissingEngine {
    verb: String
    engine: String

    impl Diagnostic {
        code :: "E1228"
        stage :: [.Jet]
        meaning :: "An engine verb needs an engine binary (`jetpack`/`jetos`) that isn't installed"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Install the matching Jet toolchain so its engine binary ships with `jet`."
        fn what(self) -> String { "`{self.verb}` needs the `{self.engine}` engine, which isn't installed." }
        fn why(self) -> String { "`{self.verb}` is an engine verb — `jet` execs `{self.engine}` for it rather than linking package-manager/OS logic into the compiler binary. A `jet os` or `jet image` dispatch reports this engine error." }
        fn fix(self) -> String { "Install the matching Jet toolchain; the `{self.engine}` binary ships alongside `jet`." }
    }
}

struct RetiredRoleContribution {
    ns: String
    name: String
    role: String
    type: String

    impl Diagnostic {
        code :: "E1229"
        stage :: [.Jet]
        status :: .Retired
        meaning :: "A role-module contribution uses the retired `module name {{ ns.path: Type{{ }} }}` form"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "Role namespace `{self.ns}` belongs in the module declaration name." }
        fn why(self) -> String { "`module {self.name} {{ {self.ns}.{self.role}: {self.type}{{ … }} }}` splits the role across two places; the canonical form puts it once, in the declaration name, so discovery-by-declaration (`module env.dev`) reads the role straight off the name." }
        fn fix(self) -> String { "Write `module {self.ns}.{self.role} {{ … }}` and move the contribution's fields up to the module body." }
    }
}

struct AmbiguousWorkspaceMember {
    query: String

    impl Diagnostic {
        code :: "E1230"
        stage :: [.Jet]
        meaning :: "A bare/path-form ref matched more than one workspace member"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`{self.query}` matches more than one workspace member." }
        fn why(self) -> String { "A bare (`logging`) or path-form (`packages/logging`) ref with no `@source` suffix resolves against the workspace member index; this one is not unique." }
        fn fix(self) -> String { "Address one member by its relative path (e.g. `infra/logging`), or use `package@source`." }
    }
}

struct UnknownWorkspaceMember {
    query: String

    impl Diagnostic {
        code :: "E1231"
        stage :: [.Jet]
        meaning :: "A bare/path-form ref matched no workspace member"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`{self.query}` is not a workspace member." }
        fn why(self) -> String { "A bare/path-form ref must name a member listed in `workspace.jet` `members:`; nothing in the index matched." }
        fn fix(self) -> String { "Use one of the listed members (a did-you-mean is offered), fix the name, or add the package to `members:`." }
    }
}

struct MonorepoFetchFailed {
    impl Diagnostic {
        code :: "E1232"
        stage :: [.Jet]
        meaning :: "A monorepo source could not be fetched — sparse subtree checkout and full-clone fallback both failed"
        detail :: true
        no_fix :: .Ambiguous
        fix_next :: "Check the source URL/rev and network access; if the provider lacks partial-clone support the full clone should still work, so this usually means the rev or repo is unreachable."
        fn what(self) -> String { "A monorepo source could not be fetched." }
        fn why(self) -> String { "Resolving a monorepo package fetches the source's workspace index and materializes only the addressed subtree; both the sparse subtree checkout and the full-clone fallback failed." }
        fn fix(self) -> String { "Correct the source URL and revision in `package.jet`, then run `jet fetch` again." }
    }
}

struct DependencyOutsideWorkspace {
    name: String

    impl Diagnostic {
        code :: "E1233"
        stage :: [.Jet]
        meaning :: "An in-repo dependency names a package outside the source's workspace index"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "In-repo dependency `{self.name}` is outside the workspace." }
        fn why(self) -> String { "A member's `package.jet` depends on another in-repo package, but that package is not in the source repo's `workspace.jet` member index, so the sparse checkout can't include it." }
        fn fix(self) -> String { "Add the dependency to the source repo's `workspace.jet` `members:`, or depend on it as an external `package@source` ref." }
    }
}

struct VersionAlreadyPublished {
    name: String
    version: String

    impl Diagnostic {
        code :: "E1234"
        stage :: [.Jet]
        meaning :: "`jet registry publish` refused: the version already exists in the registry index and is not yanked — versions are immutable"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Bump the package version or yank the existing version before publishing again."
        fn what(self) -> String { "`{self.name}` {self.version} already exists in the registry index and is not yanked." }
        fn why(self) -> String { "Published versions are immutable — a version can never be overwritten, only yanked, so anyone who already locked it keeps building the exact same bytes." }
        fn fix(self) -> String { "Bump the version in `package.jet` and publish again, or `jet registry yank {self.version}` the existing one first if it was a mistake (yanking hides it from new resolution; it does not free the version number for reuse)." }
    }
}

struct RegistryUnreachable {
    url: String

    impl Diagnostic {
        code :: "E1235"
        stage :: [.Jet]
        meaning :: "`jet registry publish`/`jet registry yank` couldn't reach the registry index, or the endpoint contains embedded credentials or URL parameters"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Couldn't reach the registry index at `{self.url}`." }
        fn why(self) -> String { "The Git registry transport rejects URL userinfo and query/fragment parameters before any network operation. Otherwise the Git operation failed because of network, authentication, or stale local-clone state; authentication comes from the host Git credential provider with path-scoped helper requests, and rendered endpoint details are redacted." }
        fn fix(self) -> String { "Remove credentials and URL parameters, configure the host Git credential provider for the registry path, then check network access or set `JET_REGISTRY_URL` to a reachable mirror." }
    }
}

struct UnlockedBuildFetch {
    impl Diagnostic {
        code :: "E1236"
        stage :: [.Jet]
        meaning :: "A build fetch is unlocked or carries credentials in its URL"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "A build fetch is not an allowed locked, credential-free input." }
        fn why(self) -> String { "Build hooks admit only content-hash-pinned fetches without URL userinfo or credential query/fragment fields; credentials in URLs could enter action identity, cache metadata, or logs." }
        fn fix(self) -> String { "Add the source hash, remove URL credentials, or vendor the source with `jet registry vendor`." }
    }
}

struct BuildWriteEscapes {
    impl Diagnostic {
        code :: "E1237"
        stage :: [.Jet]
        meaning :: "A build step wrote outside the package output root"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "A build step tried to write outside the output root." }
        fn why(self) -> String { "A build may only install files under its own package output root; writing elsewhere would let a build mutate the machine or other packages." }
        fn fix(self) -> String { "Install into a path under the output root (no `..`, no absolute paths)." }
    }
}

struct InvalidBuildRecipe {
    impl Diagnostic {
        code :: "E1238"
        stage :: [.Jet]
        meaning :: "A build recipe or staged plan fragment violated its realized-tool, sandbox, authority, or finite-graph contract"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Build recipe or staged plan action is not a valid declared action graph." }
        fn why(self) -> String { "Build tools must be realized adapter `deps:` packages, and staged plan fragments must use only declared inputs, tools, effects, platform facts, non-overlapping outputs, and acyclic dependencies; a build never falls through to host state or recursive resolution." }
        fn fix(self) -> String { "Realize every named tool, declare every input and authority fact, fix the output/dependency graph, and retry the stage." }
    }
}

struct DuplicateWorkspaceModule {
    list: String

    impl Diagnostic {
        code :: "E1239"
        stage :: [.Jet]
        meaning :: "`module workspace` declared in more than one file (discovery-by-declaration)"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`module workspace` is declared in more than one file: `{self.list}`." }
        fn why(self) -> String { "The workspace index is discovered by declaration, so exactly one file may declare `module workspace {{ … }}`." }
        fn fix(self) -> String { "Keep one declaration (conventionally in `workspace.jet`) and delete the others." }
    }
}

struct MissingRustToolchain {
    impl Diagnostic {
        code :: "E1240"
        stage :: [.Jet]
        meaning :: "No realized Rust toolchain and no Nix to build an `extern rust` bridge dep"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "No Rust build toolchain is available to build this package." }
        fn why(self) -> String { "Building an `extern rust` bridge dependency needs a pinned Rust toolchain realized into the hangar, or Nix; neither is present. A `jet build` run reports this toolchain error." }
        fn fix(self) -> String { "Run `jet update jet` to realize the pinned toolchain, or install Nix so the bridge builds through the compatibility provider." }
    }
}

struct MissingCoreArtifact {
    ring: String

    impl Diagnostic {
        code :: "E1241"
        stage :: [.Jet]
        meaning :: "A staged `core.<ring>` artifact is missing for the active platform"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Use the embedded core artifact, or realize a toolchain object built for this platform."
        fn what(self) -> String { "The staged `core.{self.ring}` artifact is missing for this platform." }
        fn why(self) -> String { "The active toolchain object carries prebuilt ring artifacts, but none for `core.{self.ring}` on this platform. A `jet build` run reports this toolchain error." }
        fn fix(self) -> String { "The build falls back to the compiler-embedded `core.{self.ring}`; to ship the staged artifact, realize a toolchain object built for this platform (`jet update jet`)." }
    }
}

struct UnknownFleetSystem {
    fleet: String
    host: String
    system: String

    impl Diagnostic {
        code :: "E1242"
        stage :: [.Jet]
        meaning :: "A captured `fleet.<name>` host references an unknown captured `system.<name>`"
        detail :: true
        no_fix :: .Ambiguous
        fix_next :: "Define the captured system or point the host at an existing captured system."
        fn what(self) -> String { "The fleet `{self.fleet}` host `{self.host}` names an unknown captured system `{self.system}`." }
        fn why(self) -> String { "Fleets are frozen jetos research capture; captured hosts must still point at a captured system so the plan is coherent." }
        fn fix(self) -> String { "Define captured `system.{self.system}: {{ … }}`, or point the host at an existing captured system." }
    }
}

struct FleetPushNotSupported {
    fleet: String

    impl Diagnostic {
        code :: "E1243"
        stage :: [.Jet]
        meaning :: "`jet push <fleet>` on a valid fleet — deployment gated on single-host jetos realization (U15, Phase D)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Fleet `{self.fleet}` is validated, but `jet push` is not available yet." }
        fn why(self) -> String { "The fleet's hosts parse and cross-check clean, but rolling a fleet out over ssh needs single-host jetos realization, which is gated (U15; Phase D, owner greenlight required). `jet push` never fakes a deploy." }
        fn fix(self) -> String { "Until the jetos realization tier lands, `jet push` captures and validates fleets without deploying them." }
    }
}

struct UnknownFleetField {
    field: String

    impl Diagnostic {
        code :: "E1244"
        stage :: [.Jet]
        meaning :: "An unknown field on a captured `Fleet` record"
        detail :: true
        no_fix :: .Ambiguous
        fix_next :: "Remove the unknown field; captured fleets use the `hosts` field."
        fn what(self) -> String { "`{self.field}` isn't a captured `Fleet` field." }
        fn why(self) -> String { "Fleet deployment remains frozen jetos research; only `hosts` is captured for planning." }
        fn fix(self) -> String { "Remove `{self.field}`; captured fleets use `hosts: {{ … }}`." }
    }
}

struct MissingFleetHosts {
    impl Diagnostic {
        code :: "E1245"
        stage :: [.Jet]
        meaning :: "A captured `Fleet` with no `hosts:` map"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "This captured `Fleet` has no `hosts`." }
        fn why(self) -> String { "Fleet deployment is frozen jetos research, but captured fleets still name hosts for later planning." }
        fn fix(self) -> String { "Add `hosts: {{ web1: system.<name> }}` if this is research capture." }
    }
}

struct InvalidPackageSignature {
    name: String
    version: String

    impl Diagnostic {
        code :: "E1246"
        stage :: [.Jet]
        meaning :: "A package signature doesn't verify against its pinned public key"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Signature verification failed for `{self.name}` {self.version}: the signature doesn't match the recorded public key." }
        fn why(self) -> String { "This means the package was tampered with after signing, or the index entry is corrupt — the author's Ed25519 signature over the content hash no longer checks out." }
        fn fix(self) -> String { "Do not use this version. Re-run `jet fetch` after clearing the store entry; if the problem persists, report it — this should never happen for an untampered registry." }
    }
}

struct UnsignedPackage {
    registry: String
    name: String
    version: String

    impl Diagnostic {
        code :: "E1247"
        stage :: [.Jet]
        meaning :: "A registry with `require_signed: true` served an unsigned package"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Registry `{self.registry}` requires signed packages (`require_signed: true`) but `{self.name}` {self.version} has no signature." }
        fn why(self) -> String { "The registry is configured to accept only author-signed releases; an unsigned entry can't be trusted under that policy." }
        fn fix(self) -> String { "Use a different registry, or ask the package author to publish a signed release (`jet registry publish` auto-signs by default — they likely used `--no-sign`)." }
    }
}

struct SigningKeyExists {
    path: String

    impl Diagnostic {
        code :: "E1248"
        stage :: [.Jet]
        meaning :: "`jet registry keygen` refused: a signing key already exists (use `--force`)"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`jet registry keygen` refused: a signing key already exists at `{self.path}`." }
        fn why(self) -> String { "Overwriting it would orphan every package you've published under the old key — consumers who pinned it (TOFU) would require a reviewed, re-signed takeover release." }
        fn fix(self) -> String { "Use `jet registry keygen --force` if you're sure (e.g. the old key was compromised), or back it up first with `jet registry key backup`." }
    }
}

struct InvalidToolchainPin {
    value: String

    impl Diagnostic {
        code :: "E1249"
        stage :: [.Jet]
        meaning :: "A `jet:` toolchain pin in `package.jet` isn't a valid version/channel ref"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`{self.value}` is not a valid toolchain pin." }
        fn why(self) -> String { "The `jet:` field pins which Jet toolchain builds this project; its value is a channel ref, not a version range. `>=1.0.0`-style constraints don't name one reproducible toolchain. A `jet build` run reports this toolchain error." }
        fn fix(self) -> String { "Write a channel: `jet: 0.4` (track the 0.4 series), `jet: 0.4.2` (exact), or a named channel like `jet: main`." }
    }
}

struct UnlockedToolchainChannel {
    channel: String

    impl Diagnostic {
        code :: "E1250"
        stage :: [.Jet]
        meaning :: "A `jet:` channel pin is unlocked under `--offline`/CI — no `[[toolchain]]` lock entry"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Resolve the channel to an exact version with `jet update jet`, then commit `.jet/lock`."
        fn what(self) -> String { "Toolchain channel `{self.channel}` is pinned but not locked." }
        fn why(self) -> String { "An `--offline`/CI build won't resolve a channel — it needs the exact toolchain version recorded in `.jet/lock`, and none is present. Resolving a channel reaches the network, which offline/CI forbids. A `jet build` run reports this toolchain error." }
        fn fix(self) -> String { "Run `jet update jet` to resolve `{self.channel}` to an exact version, then commit `.jet/lock`." }
    }
}

struct ToolchainNotOnPlatform {
    channel: String
    version: String
    platform: String

    impl Diagnostic {
        code :: "E1251"
        stage :: [.Jet]
        meaning :: "The pinned Jet toolchain has no prebuilt object for this platform — never source-built"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Toolchain {self.channel} ({self.version}) isn't available for {self.platform}." }
        fn why(self) -> String { "This project pins a Jet toolchain, but no prebuilt object for it was found for this platform. Jet realizes the pinned compiler as a prebuilt — it never builds the compiler from source and never silently falls back to a different `jet`. A `jet build` run reports this toolchain error." }
        fn fix(self) -> String { "Move the pin with `jet update jet <channel>` to a toolchain your platform has, or install the pinned toolchain from the release page." }
    }
}

struct PackageAlreadyExists {
    impl Diagnostic {
        code :: "E1252"
        stage :: [.Jet]
        meaning :: "`jet init` refused: a `package.jet` already exists here"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`jet init` refused: a `package.jet` already exists here." }
        fn why(self) -> String { "`jet init` writes a fresh package manifest pinning the running toolchain; overwriting one would discard its dependencies, pins, and identity." }
        fn fix(self) -> String { "Edit the existing manifest, or run `jet init` in an empty directory." }
    }
}

struct UnresolvedInlineDependency {
    name: String
    selector: String

    impl Diagnostic {
        code :: "E1253"
        stage :: [.Jet]
        meaning :: "An inline script dependency (`use pkg#version;`) didn't resolve"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Commit a local inline dependency copy, or initialize a package and declare the dependency there."
        fn what(self) -> String { "Inline dependency `{self.name}#{self.selector}` didn't resolve." }
        fn why(self) -> String { "A manifest-less script's `use {self.name}#{self.selector};` has no source to resolve from — the Jet package registry has no fetch path yet, so an inline dependency only resolves from a committed local copy." }
        fn fix(self) -> String { "Commit a copy at `.jet/inline-deps/{self.name}/<version>/`, or run `jet init` and depend on `{self.name}` through `package.jet` once you have a real source for it." }
    }
}

struct MissingDevEntry {
    impl Diagnostic {
        code :: "E1254"
        stage :: [.Jet]
        meaning :: "Project-level `jet dev` has neither `fn dev()` nor `fn run()` in its entry file (U19)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "This project has no `jet dev` entry." }
        fn why(self) -> String { "Project-level `jet dev` (no file argument) runs the entry file's top-level `fn dev()` if it defines one, else `fn run()` (U19). The entry file defines neither." }
        fn fix(self) -> String { "Add `fn dev() {{ … }}` (a custom dev command) or `fn run() {{ … }}` (the default) to the entry file." }
    }
}

struct UntrustedEnvironment {
    impl Diagnostic {
        code :: "E1255"
        stage :: [.Jet]
        meaning :: "An untrusted project environment or build hook hit a non-interactive path with no `--trust`/exact grant (U19)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "This project's environment isn't trusted yet." }
        fn why(self) -> String { "Entering a project's declared env (`jet env`/`jet dev`) is a supply-chain decision — first entry to a repo that declares packages needs a trust decision (U19). stdin isn't a terminal, so an interactive prompt would hang instead of asking." }
        fn fix(self) -> String { "Pass `--trust` for this one run, or pre-authorize with `jet config trust add <pattern>`." }
    }
}

struct EnvironmentNotProjectable {
    cmd: String

    impl Diagnostic {
        code :: "E1256"
        stage :: [.Jet]
        meaning :: "Bounded native projection cannot translate a foreign flake/devShell surface into Jet facts (U16)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`{self.cmd}` cannot project the foreign environment." }
        fn why(self) -> String { "The bounded native evaluator could not translate the foreign `flake.nix`/`devenv.nix` surface into Jet facts (U16). Jet does not shell out to an installed Nix binary for this path." }
        fn fix(self) -> String { "Use the supported literal devShell fields, run `jet os bridge flake` for the loss report, or declare the environment in `env.*`." }
    }
}

struct SandboxInterfaceChanged {
    impl Diagnostic {
        code :: "E1257"
        stage :: [.Jet]
        meaning :: "A `target: sandbox` package's exported interface changed incompatibly since the last frozen build"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "This sandbox's exported interface changed incompatibly." }
        fn why(self) -> String { "A `target: sandbox` package's frozen exported interface is the load-time contract — a prior build's `.jet/cache/api` snapshot shows an export was removed or its signature changed. Adding a new export is always compatible." }
        fn fix(self) -> String { "Restore the removed/changed export, or accept this as an intentional breaking change (delete the stale snapshot to re-freeze)." }
    }
}

struct RetiredSandboxEffect {
    impl Diagnostic {
        code :: "E1258"
        stage :: [.Jet]
        status :: .Retired
        no_fix :: None
        fn what(self) -> String { "*Retired* (was: a sandbox package's own code uses an effect)" }
        fn why(self) -> String { "`jet build` no longer builds sandbox Components" }
        fn fix(self) -> String { "Do not use E1258" }
    }
}

struct RetiredSandboxBuild {
    impl Diagnostic {
        code :: "E1259"
        stage :: [.Jet]
        status :: .Retired
        no_fix :: None
        fn what(self) -> String { "*Retired* (was: the sandbox WASM Component build failed)" }
        fn why(self) -> String { "`jet build` no longer builds sandbox Components" }
        fn fix(self) -> String { "Do not use E1259" }
    }
}

struct UnsupportedExportSignature {
    impl Diagnostic {
        code :: "E1260"
        stage :: [.Jet]
        meaning :: "An exported function has a parameter or result its export boundary can't carry: a sandbox's Component boundary or a native Library's C boundary (U3)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "An exported function has an unsupported signature." }
        fn why(self) -> String { "A sandbox `pub fn` crosses the Component boundary: each parameter and the result must be `Int`, `Float`, `Bool`, `Text`, or a recursively closed `#Codable` record/list/Option/Result shape, mixed freely across positions. A native Library `#Export(c)` function crosses the C boundary: each parameter and the result must be one C primitive (`Int`, `Float`, `Bool`, `Text`, or a fixed width such as `U8` or `F32`), independently per position." }
        fn fix(self) -> String { "Change each unsupported parameter or result to a shape its boundary carries, or drop `pub` (sandbox) or `#Export(c)` (Library) if the function isn't meant to cross the boundary." }
    }
}

struct ServiceNeverHealthy {
    name: String

    impl Diagnostic {
        code :: "E1261"
        stage :: [.Jet]
        meaning :: "A dev-supervised service never became healthy within the readiness timeout (U12)"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Inspect the service logs and correct its `run` or `ready` declaration before retrying."
        fn what(self) -> String { "Service `{self.name}` never became healthy." }
        fn why(self) -> String { "`jet dev`/`jetpack services up` supervises a `services:` process, then polls its readiness contract (`ready:`, else a TCP probe on its first `ports:` entry, else a bare process-alive check) until it passes or a timeout elapses (U12); it never passed in time." }
        fn fix(self) -> String { "Check `jetpack services logs {self.name}` for what the process printed, confirm its `run`/`ready` declarations are correct, or raise the timeout isn't configurable yet — fix the service itself." }
    }
}

struct UnknownServiceField {
    name: String
    field: String

    impl Diagnostic {
        code :: "E1262"
        stage :: [.Jet]
        meaning :: "A dev-supervised `Service` field jetpack doesn't recognize at supervision time (U12)"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Rename the field to a recognized service key or remove it."
        fn what(self) -> String { "Service `{self.name}` has a field jetpack doesn't recognize: `{self.field}`." }
        fn why(self) -> String { "A dev-supervised `Service` stays the one ratified open record (U12) at parse time, but jetpack's dev-runtime tier is the only consumer of a dev service's fields — unlike the jetos `system.*.services` capture, nothing downstream forwards unread metadata, so an unrecognized key here is almost always a typo. A `jetpack services` run reports this service declaration error." }
        fn fix(self) -> String { "Rename `{self.field}` to one of the recognized keys (`enable`, `ports`, `run`, `shutdown`, `data_dir`, `ready`, `after`, `before_start`, `sockets`, `restart`, `watch`), or remove it." }
    }
}

struct LibraryIdentityMismatch {
    artifact_version: String
    host_version: String

    impl Diagnostic {
        code :: "E1338"
        stage :: [.Jet]
        meaning :: "A loadable `.jetlib` artifact's compiler-identity stamp doesn't match the running compiler — refused before mapping"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "This loadable library was built by Jet `{self.artifact_version}`, but the loading program uses Jet `{self.host_version}`." }
        fn why(self) -> String { "A `.jetlib` artifact pins the exact compiler identity that built it — Jet makes no cross-version binary layout promise, so a mismatched artifact is refused before it is mapped, never linked with stale layout assumptions. A `jet run` run reports this library toolchain error." }
        fn fix(self) -> String { "Rebuild the library with the loading program's Jet version, or install a matching Jet toolchain." }
    }
}

struct LibraryEffectNotGranted {
    name: String
    effect_name: String

    impl Diagnostic {
        code :: "E1339"
        stage :: [.Jet]
        meaning :: "A loaded library declares an effect the load site's grant doesn't cover — refused before mapping"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Widen the load-site grant to include the library effect, or remove that effect."
        fn what(self) -> String { "Library `{self.name}` declares the `{self.effect_name}` effect, which this load site doesn't grant." }
        fn why(self) -> String { "A loadable Jet library declares its effects like any package; the host states what it grants at the load site, and a library asking for more is refused before it is mapped. Compiler identity is verified first, so this check only runs against an artifact already proven to come from this compiler." }
        fn fix(self) -> String { "Widen the grant at the load site to include `{self.effect_name}`, or remove the effect from the library." }
    }
}

struct InvalidLibraryOutput {
    impl Diagnostic {
        code :: "E1341"
        stage :: [.Jet]
        meaning :: "A selected `Library` output or loadable artifact requests an invalid target, binding, ABI, or export shape"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "This `Library` output or loadable artifact requests an invalid target, binding, ABI, or export shape." }
        fn why(self) -> String { "Libraries and embeds use closed, checked native projections: a Library emits only the checked static/shared, C-header, and named binding surfaces, and a loadable artifact must carry the exact native target, ABI, and top-level `fn` export table. Unknown combinations cannot be guessed safely. A `jet build` run reports this library artifact error." }
        fn fix(self) -> String { "Select the Library output directly, use `c`, `python`, or `swift`, and give native bindings `native: true`; for a loadable artifact, rebuild it with the matching compiler and export surface." }
    }
}

struct JetpackCommandFailed {
    problem: String

    impl Diagnostic {
        code :: "E1340"
        stage :: [.Jetpack]
        meaning :: "A Jetpack command failed and no more specific registered code owns the failure"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "{self.problem}" }
        fn why(self) -> String { "Jetpack could not complete the command because the named input, project fact, tool, or operating-system operation did not satisfy it. A `jetpack env` run reports this Jetpack operation error." }
        fn fix(self) -> String { "Correct the named problem, then run the command again." }
    }
}

struct NixExecutionUnavailable {
    reason: String

    impl Diagnostic {
        code :: "E1351"
        stage :: [.Jetpack]
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Nix closure execution is unavailable on this host." }
        fn why(self) -> String { "Jetpack could not create the isolated /nix/store projection: {self.reason}. A `jetpack env` run reports this environment-provider error." }
        fn fix(self) -> String { "Use a Linux host with unprivileged user and mount namespaces, or choose a native provider for this package." }
    }
}

struct PinnedSourceUpdate {
    name: String

    impl Diagnostic {
        code :: "E1352"
        stage :: [.Jetpack]
        meaning :: "An explicitly updated source is pinned and cannot move"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Declare the source with `#latest` or `#auto` according to the desired update policy."
        fn what(self) -> String { "Source `{self.name}` is pinned and cannot be updated." }
        fn why(self) -> String { "Jet keeps a declaration with no channel marker pinned forever; an update command must not move its lock or rewrite its manifest." }
        fn fix(self) -> String { "Declare `{self.name}` with `#latest` for manual movement or `#auto` for automatic movement." }
    }
}

struct UnknownPrepareFlag {
