        no_fix :: .Behavior
        fn what(self) -> String { "A member Package declares `members` (the diagnostic names its `package.jet` source)" }
        fn why(self) -> String { "Membership has one level: the workspace root owns discovery, and source provenance makes the offending Package reviewable." }
        fn fix(self) -> String { "Remove the nested `members:` field from the named member manifest and declare those paths at the workspace root." }
    }
}

