        detail :: true
        fn what(self) -> String { "`{self.module_name}` is not available for target `{self.target}`." }
        fn why(self) -> String { "The browser Web backend has no host-import boundary for `core.plugin`; plugin authority and component imports must stay on a native or server host. A `jet build` or `jet run` run reports this target-support diagnostic." }
        fn fix(self) -> String { "Build for a native target or `wasm32-wasip2`, or move plugin work behind a native/server boundary." }
    }
}

struct RuntimeLayerNotOnTarget {
    api: String
    required: String
    target: String
    available: String

    impl Diagnostic {
        code :: "E3310"
        meaning :: "Reachable Prelude part needs a runtime layer not supplied by the selected target"
        detail :: true
        fix_next :: "Select a typed target with the required API support, or remove that API from the closure."
        fn what(self) -> String { "Prelude part `{self.api}` needs the `{self.required}` runtime layer, but target `{self.target}` provides `{self.available}`." }
        fn why(self) -> String { "The complete semantic Prelude closure includes `{self.api}`; a target cannot emit a higher layer or substitute a second Prelude." }
        fn fix(self) -> String { "Select a typed target with `{self.required}` support, or remove `{self.api}` from the reachable closure." }
    }
}

struct MissingTargetCapability {
