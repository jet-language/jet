        stage :: [.Parse]
        status :: .Retired
        no_fix :: None
        fn what(self) -> String { "*Retired* (was: `marker`/`effect` declaration word teaching)" }
        fn why(self) -> String { "The registered parse rule applies here" }
        fn fix(self) -> String { "Follow the guidance for E0381" }
    }
}

struct RetiredAtCompileTime {
    old: String
    new: String

    impl Diagnostic {
        code :: "E0388"
        stage :: [.Parse]
        status :: .Retired
        meaning :: "Teaching: compile-time `@ {{ … }}`, `@if`, `@loop` and `@fn` are spelled `comptime {{ … }}`, `comptime if`, `comptime loop` and `comptime fn`, a constant `@NAME :: value` is `NAME :: comptime {{ value }}`, read as `NAME`, and a template name splice `fn @method`, `self.@field` or `.@left` is `fn $method`, `self.$field` or `.$left`"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .Formatting
        fn what(self) -> String { "`{self.old}` is retired; write `{self.new}`." }
        fn why(self) -> String { "Build-time blocks, branches, loops, functions and values carry the word `comptime`, so forced compile time is always explicit: a constant that must be evaluated while building is `NAME :: comptime {{ value }}` (a plain `NAME :: value` folds while building only when it can), and the case of a name never implies it. A template splices a binding's name with the fact sigil `$`. Prefix `@` now marks a live link. The meaning and the checks are unchanged." }
        fn fix(self) -> String { "Replace `{self.old}` with `{self.new}`." }
    }
}

struct RetiredAtNumberParameter {
    old: String
    name: String

    impl Diagnostic {
        code :: "E0389"
        stage :: [.Parse]
        status :: .Retired
        meaning :: "Teaching: a compile-time number parameter is declared `<comptime N: Int>`"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .Formatting
        fn what(self) -> String { "`{self.old}` marks a number parameter with the retired `@` mark." }
        fn why(self) -> String { "Only the declaration carries `comptime`; every use writes the plain name `{self.name}`." }
        fn fix(self) -> String { "Write `comptime {self.name}` in the parameter list." }
    }
}

struct CompileTimeNumberParameter {
    name: String

    impl Diagnostic {
        code :: "E0390"
        meaning :: "Compile-time number parameters are not implemented yet"
        detail :: true
        fn what(self) -> String { "`{self.name}` is a compile-time number parameter, which this compiler does not support yet." }
        fn why(self) -> String { "`<comptime N: Int>` is the ratified declaration grammar, but number-parameter substitution, instance identity and layout are not implemented." }
        fn fix(self) -> String { "Use a type parameter, or pass the number as an ordinary argument or field until number parameters ship." }
    }
}

struct UnsupportedCompileTimeValue {
