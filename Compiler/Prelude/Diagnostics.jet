        stage :: [.Parse]
        fn what(self) -> String { "Parameter-zone separator out of place: `/` before any parameter, `/` after `*`, a repeated `/` or `*`, or `*` with nothing after it" }
        fn why(self) -> String { "The registered parser rule applies here" }
        fn fix(self) -> String { "Use `/` and `*` once in the declared parameter zones and in the required order." }
    }
}

struct UnknownArgumentLabel {
    impl Diagnostic {
        code :: "E0764"
        fn what(self) -> String { "Call argument labels a parameter the callee does not have" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Pass only labels declared by the callee." }
    }
}

struct DuplicateArgumentLabel {
