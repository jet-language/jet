        detail :: true
        fn what(self) -> String { "Compound assignment can't target a nested operator field." }
        fn why(self) -> String { "Hooked compound assignment must read and write one stable place exactly once; nested field places are not yet represented by the operator assignment spine." }
        fn fix(self) -> String { "Bind the inner value, update it, then assign the whole inner value back." }
    }
}

struct InvalidUnionMember {
