        meaning :: "Selected target does not provide the runtime boundary for a reachable Core socket surface"
        detail :: true
        fix_next :: "Build for `wasm32-wasip2` or a supported native target, or remove the native-only module."
        fn what(self) -> String { "`{self.module_name}` is not available for target `{self.target}`." }
        fn why(self) -> String { "`{self.module_name}` needs native sockets or WASI Preview 2 sockets, and this target provides neither runtime boundary. A `jet build` or `jet run` run reports this target-support diagnostic." }
        fn fix(self) -> String { "Build for `wasm32-wasip2` or a supported native target, or remove the `{self.module_name}` import." }
    }
}

struct SocketOperationNotOnTarget {
