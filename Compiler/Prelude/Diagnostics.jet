// Every compiler diagnostic is a type here: a struct whose fields are the
// holes its texts read, and an impl of the Core `Diagnostic` trait. The
// constants carry the registry columns; `what`, `why` and `fix` are each one
// string literal reading only `self` fields. Retired and reserved codes stay
// so old logs remain explainable. `Tools/agent/DiagnosticRows.jet --write`
// renders these impls into the Foundation registry.

StrayCharacter: struct {
    impl Diagnostic {
        code: "E0001"
        safety_class: .Soundness
        safety_reason: "The character has no meaning in Jet, so the file is no program and nothing could run."
        expert_path: "none: no opt-in gives a meaningless character a meaning"
        stage: [.Jet]
        meaning: "A character or escape that belongs to no token"
        no_fix: .Behavior

        what: fn(self) -> String { "Character/escape/lone brace means nothing here" }

        why: fn(self) -> String {
            "Outside quoted text, every character must belong to a name, number, operator or punctuation mark, and inside it a backslash must start a known escape"
        }

        fix: fn(self) -> String { "Remove the stray character or complete the escape or brace." }
    }
}

UnterminatedText: struct {
    impl Diagnostic {
        code: "E0002"
        safety_class: .Soundness
        safety_reason: "Where the text ends is unknown, so the rest of the file has no meaning to run."
        expert_path: "none: no opt-in decides where unterminated text ends"
        stage: [.Jet]
        meaning: "Text, an interpolation or a block comment left open at the end of the file"
        no_fix: .Behavior

        what: fn(self) -> String { "Unterminated text literal, interpolation, or block comment" }

        why: fn(self) -> String {
            "Quoted text, an interpolated value and a block comment each need their closing mark before the file ends"
        }

        fix: fn(self) -> String {
            "Close the unterminated text literal, interpolation, or block comment; use {{{{ or }}}} for escaped braces, or a raw backtick string for literal text."
        }
    }
}

InvalidStatement: struct {
    impl Diagnostic {
        code: "E0003"
        safety_class: .Soundness
        safety_reason: "The form is not a statement of the grammar, so there is no program to run."
        expert_path: "none: no opt-in gives an incomplete statement a meaning"
        stage: [.Parse]
        meaning: "Statement parse error; expected a current statement form"
        detail: true
        structured_fix: .SourceEdit
        no_fix: None
        fix_safety: .NeedsReview

        what: fn(self) -> String {
            "Expected a current statement form, found an unsupported or incomplete form"
        }

        why: fn(self) -> String {
            "This position accepts only a complete statement from Jet's current grammar"
        }

        fix: fn(self) -> String { "Write the complete statement form named by the diagnostic" }
    }
}

RetiredStagedParameters: struct {
    impl Diagnostic {
        code: "E0004"
        status: .Retired
        no_fix: None

        what: fn(self) -> String { "*Retired* (was: parameters staged)" }

        why: fn(self) -> String {
            "Jet no longer reports this code; its row stays so an older reference to it still explains"
        }

        fix: fn(self) -> String { "Follow the guidance for E0004" }
    }
}

