        no_fix :: None
        fix_safety :: .BehaviorPreserving
        fn what(self) -> String { "Import `{self.name}` is never used." }
        fn why(self) -> String { "An unused import adds a name and dependency to the file without contributing to checked code." }
        fn fix(self) -> String { "Remove the import, or rename `{self.name}` to `_{self.name}` when the import is intentionally kept." }
    }
}

struct UnusedPrivateFn {
    name: String

    impl Diagnostic {
        code :: "L0104"
        severity :: .Lint
        lint_name :: "unused_private_fn"
        meaning :: "An unused private function is dead code (warning)"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .BehaviorPreserving
        fn what(self) -> String { "Private function `{self.name}` is never called or used as a value." }
        fn why(self) -> String { "A private function with no reachable reference is dead code; public functions stay exempt because other modules may use them." }
        fn fix(self) -> String { "Remove the function, or rename `{self.name}` to `_{self.name}` when it is intentional." }
    }
}

struct UnreachableExport {
    name: String

    impl Diagnostic {
        code :: "L0105"
        severity :: .Lint
        lint_name :: "unreachable_export"
        meaning :: "A package-scoped export has no reachable consumer"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .BehaviorPreserving
        fn what(self) -> String { "Package export `{self.name}` is unreachable." }
        fn why(self) -> String { "The package's explicit import graph and application roots contain no consumer for this package-scoped export; a library's public items remain open to external consumers." }
        fn fix(self) -> String { "Remove the export, or rename `{self.name}` to `_{self.name}` when it is intentional." }
    }
}

struct DivergentStatePaths {
    value: String
    one: String
    other: String

    impl Diagnostic {
        code :: "L0152"
        severity :: .Lint
        lint_name :: "divergent_state_paths"
        meaning :: "Typestate: two paths meet and leave one value in different states, so it is untracked from there (warning)"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`{self.value}` ends in state `{self.one}` on one path and `{self.other}` on another." }
        fn why(self) -> String { "Typestate: after two paths meet, a state holds only when both paths agree — here they do not, so the value is untracked from this point and later state checks on it stay silent." }
        fn fix(self) -> String { "Bring both paths to the same state before they meet, or do the work that needs the state inside the path that reaches it." }
    }
}

struct UnreachableState {
    type: String
    state: String

    impl Diagnostic {
