}

struct ReactiveArgumentNotLambda {
    kind: String
    type: String

    impl Diagnostic {
        code :: "E2910"
        meaning :: "`reactive.derived`/`effect` argument isn't a lambda"
        detail :: true
        fn what(self) -> String { "`reactive.{self.kind}` needs a lambda, not {self.type}." }
        fn why(self) -> String { "`reactive.derived`/`reactive.effect` build a reactive value from a `() -> …` body so it can re-run when a signal changes. A non-lambda argument has nothing to re-run." }
        fn fix(self) -> String { "Write `reactive.derived(() -> … )` or `reactive.effect(() -> {{ … }})`." }
    }
}

struct ReactiveLambdaParameters {
    kind: String
    n: String

    impl Diagnostic {
        code :: "E2911"
        meaning :: "`reactive.derived`/`effect` lambda takes parameters"
        detail :: true
        fix_next :: "Drop the lambda parameters and read signals from the zero-parameter body."
        fn what(self) -> String { "`reactive.{self.kind}` needs a zero-parameter lambda, got {self.n} parameter(s)." }
        fn why(self) -> String { "The body of a derived/effect takes no arguments — it reads the signals it depends on via `.get()`." }
        fn fix(self) -> String { "Drop the parameters: `reactive.{self.kind}(() -> {{ … }})`." }
    }
}

struct DerivedReturnsNothing {
    impl Diagnostic {
        code :: "E2912"
        meaning :: "`reactive.derived` lambda returns nothing"
        detail :: true
        fn what(self) -> String { "`reactive.derived` must compute and return a value." }
        fn why(self) -> String { "A derived value is recomputed from its signals, so its lambda has to return the new value. A body that returns nothing is a side effect, not a value." }
        fn fix(self) -> String { "Return a value from the body, or use `reactive.effect(() -> {{ … }})` for a side effect." }
    }
}

struct ReactiveFunctionValue {
    kind: String
    type: String

    impl Diagnostic {
        code :: "E2913"
        meaning :: "A reactive `Signal`/`Derived` can't hold a function value"
        detail :: true
        fn what(self) -> String { "A reactive {self.kind} can't hold a {self.type}." }
        fn why(self) -> String { "Signals and derived values hold ordinary data so it can be copied to dependents. A function value isn't reactive data — wrap behaviour in an effect instead." }
        fn fix(self) -> String { "Use a data value (number, text, list, struct, …); put behaviour in `reactive.effect`." }
    }
}

struct ReactiveFunctionReturns {
    impl Diagnostic {
        code :: "E2914"
        fn what(self) -> String { "`#Reactive fn` must not return a value" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Remove the value return from the `#Reactive fn`." }
    }
}

struct MissingAccessibleLabel {
