        meaning :: "A deprecated item still compiles but should be migrated; suggests `jet fix` (E2-M2)"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .BehaviorPreserving
        fn what(self) -> String { "An item is deprecated in this edition." }
        fn why(self) -> String { "It still works during its migration window but will be removed in a later edition." }
        fn fix(self) -> String { "Use the named replacement, or run `jet fix` to migrate automatically." }
    }
}

struct DoctorAdvisory {
    impl Diagnostic {
        code :: "L2101"
        severity :: .Lint
        lint_name :: "doctor_advisory"
        stage :: [.Jet]
        meaning :: "`jet self doctor` advisory: a toolchain / cache / PATH problem with a fix (E2-M3)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`jet self doctor` found an environment problem with a known fix." }
        fn why(self) -> String { "Jet depends on a native linker, a build cache/store, and a C-FFI bridge; doctor surfaces a broken one before it derails a build." }
        fn fix(self) -> String { "Apply the fix printed on the advisory line; for a missing cache or store directory, run `jet self doctor --fix`." }
    }
}

struct MalformedRingInput {
    parser: String
    n: String
    detail: String

    impl Diagnostic {
        code :: "E2701"
        stage :: [.Runtime]
        meaning :: "Malformed input to a ring library parse function — row/line number and detail (E2-M9)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`{self.parser}` found malformed input at row/line {self.n} — {self.detail}." }
        fn why(self) -> String { "The ring library parse function encountered text it can't interpret: a missing delimiter, an unclosed quote, or an unexpected character. The row or line number points at the first offending record." }
        fn fix(self) -> String { "Fix the input at the location named, or validate it before parsing." }
    }
}

struct CryptoMisuse {
    why_text: String
    fix_text: String

    impl Diagnostic {
        code :: "E2702"
        meaning :: "Compiler-known crypto API misuse at the boundary (E2-M9)"
        detail :: true
        edit :: .CryptoMisuse
        no_fix :: .Behavior
        fix_next :: "Use the documented cryptographic bound or supply a runtime value when the value is not compiler-known"
        fn what(self) -> String { "Crypto API misuse" }
        fn why(self) -> String { "{self.why_text}" }
        fn fix(self) -> String { "Replace the offending cryptographic argument with the concrete value or bound named in the diagnostic: {self.fix_text}" }
    }
}

struct InvalidTimeFormat {
    detail: String

    impl Diagnostic {
        code :: "E2703"
        stage :: [.Runtime]
        meaning :: "A checked time-format pattern contains an unclosed literal, incomplete percent escape, unsupported token, or zone-only token without a zone"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`E2703: {self.detail}`" }
        fn why(self) -> String { "The checked formatter accepts one closed token grammar so a typo cannot silently become literal output, and zone fields cannot claim context that the value does not carry." }
        fn fix(self) -> String { "Close the quoted literal, complete or correct the `%` escape, choose a supported token, or format a `ZonedDateTime` when the token needs a zone." }
    }
}

struct EpochOutOfRange {
    unit: String

    impl Diagnostic {
        code :: "E2704"
        stage :: [.Runtime]
        meaning :: "A DateTime epoch conversion exceeds the signed Int carrier at the requested precision"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`E2704: Unix epoch {self.unit} do not fit in Int`" }
        fn why(self) -> String { "The DateTime is representable in seconds, but scaling it to the requested subsecond unit would overflow the current Int carrier; clamping would silently change the instant." }
        fn fix(self) -> String { "Use seconds or a coarser precision, or handle the failed conversion explicitly." }
    }
}

