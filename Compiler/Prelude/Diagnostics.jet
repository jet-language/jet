        fix_next :: "Move the program that calls the library into its own package."
        fn what(self) -> String { "A library package can't declare `fn run`" }
        fn why(self) -> String { "A package is one namespace: an executable package has one `fn run`, or one in each entry file its `outputs` name, and a library package, which other code imports, has none." }
        fn fix(self) -> String { "Move the program into its own package or a loose file that uses this library, or make this package an executable." }
    }
}

