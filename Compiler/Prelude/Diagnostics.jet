}

struct TlsHandshakeFailed {
    host: String

    impl Diagnostic {
        code :: "E4201"
        meaning :: "HTTPS client TLS handshake failed before any response was received"
        detail :: true
        fn what(self) -> String { "TLS handshake with `{self.host}` failed." }
        fn why(self) -> String { "The URL reached a server, but the connection did not complete a secure HTTPS handshake. The usual cause is pointing an `https://` URL at a plain HTTP server or a server with a broken TLS setup." }
        fn fix(self) -> String { "Verify the URL points at an HTTPS server, not plain HTTP. For local tests, start the TLS fixture server." }
    }
}

struct UntrustedCertificate {
    host: String

    impl Diagnostic {
        code :: "E4202"
        meaning :: "HTTPS client certificate could not be trusted"
        detail :: true
        fn what(self) -> String { "TLS certificate for `{self.host}` could not be trusted." }
        fn why(self) -> String { "The server presented a certificate Jet could not verify for that host. It may be expired, for another name, self-signed, or missing an intermediate." }
        fn fix(self) -> String { "Use a certificate whose subject matches the host and chains to a trusted root. For tests, trust the local fixture CA explicitly." }
    }
}

struct MissingCertificateRoots {
    impl Diagnostic {
        code :: "E4203"
        meaning :: "HTTPS client could not find usable system certificate roots"
        detail :: true
        fn what(self) -> String { "HTTPS could not find system certificate roots." }
        fn why(self) -> String { "Jet uses rustls with the system trust store for default HTTPS. Minimal images can omit that bundle, so there is no root set to verify public certificates against." }
        fn fix(self) -> String { "Install the system certificate bundle (for example `ca-certificates`) or run in an image that includes it." }
    }
}

struct ImpureCallInPureContext {
    pure_fn: String
    call: String

    impl Diagnostic {
        code :: "E3401"
        meaning :: "Impure call inside a `fn … -[]>` / pure-eval context, or reached from comptime evaluation — call-trace path"
        detail :: true
        fix_next :: "Remove the call, drop the empty effect bound, or compute the value at runtime."
        fn what(self) -> String { "`{self.pure_fn}` calls the impure function `{self.call}`." }
        fn why(self) -> String { "A `fn … -[]>` may only call functions whose effect row is empty, declared or inferred, and pure builtins. Impure calls make the result non-deterministic. In `jet eval --pure` the whole call graph from `run` is checked transitively; the why-line shows the full chain (`run → a → b calls \\`print\\``) so the user can find the leak. Compile-time work (`comptime` blocks and values) shares this same call-graph walk: the message reads `{self.call}` is not allowed in comptime code instead, since there is no enclosing `-[]>` function name to report." }
        fn fix(self) -> String { "Remove the call from `{self.pure_fn}`, or drop the `-[]>` bound from `{self.pure_fn}` so its effects are inferred; at compile time, compute the value at runtime instead." }
    }
}

struct AmbientIoInPackageBuild {
    call: String

    impl Diagnostic {
        code :: "E3402"
        meaning :: "Package build attempted ambient I/O or network (names the call)"
        detail :: true
        fn what(self) -> String { "`{self.call}` is not allowed during a sandboxed package build." }
        fn why(self) -> String { "Package builds run with ambient I/O and network access disabled." }
        fn fix(self) -> String { "Compute this value at compile time or pass it in as a parameter." }
    }
}

struct NondeterminismInPureEval {
