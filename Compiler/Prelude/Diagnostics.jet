    impl Diagnostic {
        code :: "E2392"
        stage :: [.Compile]
        meaning :: "Project check could not prove tier lowering"
        detail :: true
        fn what(self) -> String { "Project check could not prove tier lowering: {self.detail}" }
        fn why(self) -> String { "Every applicable execution tier needs a side-effect-free lowering proof; a coverage miss cannot be reported clean. A `jet check` run reports this tier-lowering proof failure." }
        fn fix(self) -> String { "Repair the source or compiler route named by the proof, then run jet check again." }
    }
}

struct ImportWithoutProject {
