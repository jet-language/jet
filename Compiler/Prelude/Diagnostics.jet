        stage :: [.Compile]
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Add `Never` to the return type when the public function always diverges."
        fn what(self) -> String { "Public function `{self.function}` always diverges but does not declare `Never`." }
        fn why(self) -> String { "Inferred divergence is useful to callers but is not part of the written API contract." }
        fn fix(self) -> String { "Add `Never` to the return type, for example `fn {self.function}() Never`." }
    }
}

struct PositionalBoolParameter {
    fn_name: String
    param: String

    impl Diagnostic {
        code :: "L2401"
        severity :: .Lint
        lint_name :: "positional_bool_parameter"
        stage :: [.Compile]
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Label the boolean argument at call sites or give it a default value."
        fn what(self) -> String { "Public function `{self.fn_name}` has a positional `Bool` parameter `{self.param}`." }
        fn why(self) -> String { "Positional booleans are easy to transpose: `connect(host, true, false)` is a guessing game. Labels (S61) make the intent clear at the call site." }
        fn fix(self) -> String { "Callers can use `{self.param}: true` to document intent; or give the parameter a default value so it can be omitted. No action required — this is advisory." }
    }
}

struct FileHandleDirectionMismatch {
    method: String
    direction: String

    impl Diagnostic {
        code :: "E2501"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "`{self.method}` is not available on a {self.direction} file handle." }
        fn why(self) -> String { "`files.open` returns a read-only handle; `files.create`/`files.append` return a write-only handle. Calling a write method on a reader (or a read method on a writer) is a type error." }
        fn fix(self) -> String { "Use the correct handle type for the operation: `files.open` to read, `files.create`/`files.append` to write." }
    }
}

struct LineStreamOutsideLoop {
    impl Diagnostic {
        code :: "E2502"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "A line stream can only be used directly in a loop." }
        fn why(self) -> String { "`.lines()` hands back a lazy line reader meant to be iterated in place; storing it in a name would let it leave the loop, where it has no use. (The boundary is enforced in sema so codegen never has to lower a stray line stream — c109/I3.)" }
        fn fix(self) -> String { "Iterate it directly: `loop line in handle.lines() {{ … }}`." }
    }
}

struct WholeFileRead {
    impl Diagnostic {
        code :: "L2501"
        severity :: .Lint
        lint_name :: "whole_file_read"
        stage :: [.Compile]
        status :: .Reserved
        detail :: true
        no_fix :: None
        fn what(self) -> String { "(reserved) `fs.read` loads the whole file into memory at once." }
        fn why(self) -> String { "For large files this can exhaust memory; streaming reads use bounded space." }
        fn fix(self) -> String { "Use `files.open(path)?` and `loop line in handle.lines() {{ … }}` to stream line-by-line. Not emitted yet." }
    }
}

struct HiddenCostInLoop {
    operation: String
    fix_text: String

    impl Diagnostic {
        code :: "L2510"
        severity :: .Lint
        lint_name :: "hidden_cost_in_loop"
        meaning :: "Hidden dynamic cost inside a loop"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .NeedsReview
        fn what(self) -> String { "{self.operation} repeats inside a loop." }
        fn why(self) -> String { "A repeated copy or representation fallback can make a growing value's cost super-linear." }
        fn fix(self) -> String { "Call `{self.fix_text}` on the highlighted expression to make the copy explicit." }
    }
}

struct ReduceMarkerOutsideReduce {
    impl Diagnostic {
        code :: "E2510"
        stage :: [.Compile]
        meaning :: "A reduce-op marker outside a lane `.reduce(…)`"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "A reduce-op marker is only valid inside a lane `.reduce(…)`." }
        fn why(self) -> String { "SIMD reduction takes one typed `ReduceOp` value: `.Add`, `.Mul`, `.Min`, `.Max`, or `.Avg`." }
        fn fix(self) -> String { "Pass a listed dot value, or use `v.sum()` / `v.product()` / `v.min()` / `v.max()`." }
    }
}

struct UndefinedOperator {
    op: String
    lhs: String
    rhs: String

    impl Diagnostic {
        code :: "E2511"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "Operator `{self.op}` isn't defined between `{self.lhs}` and `{self.rhs}`." }
        fn why(self) -> String { "Built-in lane and linalg operators keep fixed shapes: one lane/vector type on both sides, or a matrix and its matching vector; any other pair needs an operator hook." }
        fn fix(self) -> String { "Match the operand types (`T.splat(x)` lifts a scalar into every lane), call a named method like `.dot()`/`.matmul()`, or implement the operator's hook trait on your own type for this pair." }
    }
}

struct MatrixShapeMismatch {
    left_inner: String
    right_inner: String
    left_rows: String
    right_cols: String

    impl Diagnostic {
        code :: "E2512"
        stage :: [.Compile]
        detail :: true
        fix_next :: "Use matrix operands whose inner dimensions are equal."
        fn what(self) -> String { "Matrix multiplication needs equal inner sides, but these are {self.left_inner} and {self.right_inner}" }
        fn why(self) -> String { "The left column measure must match the right row measure" }
        fn fix(self) -> String { "Use `Matrix<{self.left_rows}, {self.left_inner}> * Matrix<{self.left_inner}, {self.right_cols}>`" }
    }
}

struct BreakingRelease {
    version: String
    item: String
    bump_kind: String
    major: String
    next_major: String

    impl Diagnostic {
        code :: "E2601"
        stage :: [.Compile]
        detail :: true
        fix_next :: "Bump to the next major version or restore the removed public item."
        fn what(self) -> String { "This release is tagged `{self.version}` but removes (or changes incompatibly) the public API item `{self.item}`." }
        fn why(self) -> String { "`{self.version}` is a {self.bump_kind} bump, which promises no breaking changes under SemVer. Callers pinned to `^{self.major}.0` would stop compiling." }
        fn fix(self) -> String { "Bump to `{self.next_major}.0.0`, or restore `{self.item}` (a deprecated forwarding shim counts). Use `--force` to publish anyway with an explicit warning banner." }
    }
}

struct DependencyVersionConflict {
    package: String
    req_a: String
    from_a: String
    req_b: String
    from_b: String

    impl Diagnostic {
        code :: "E2602"
        stage :: [.Compile]
        detail :: true
        no_fix :: .Ambiguous
        fix_next :: "Align the conflicting dependency constraints or ask for a compatible release."
        fn what(self) -> String { "Dependency resolver conflict: `{self.package}` requires `{self.req_a}` from `{self.from_a}` but `{self.req_b}` from `{self.from_b}`, and no version satisfies both." }
        fn why(self) -> String { "Jet uses a PubGrub-style resolver that requires a single version per package. Two incompatible constraints cannot both be met." }
        fn fix(self) -> String { "Upgrade or downgrade one of the conflicting dependents so their `{self.package}` constraints overlap, or ask the authors to release a version that satisfies both." }
    }
}

struct SecurityAdvisoryMatch {
    severity: String
    advisory_id: String
    package: String
    version: String
    title: String
    fixed_version: String

    impl Diagnostic {
        code :: "E2603"
        stage :: [.Compile]
        detail :: true
        fix_next :: "Upgrade to the fixed version named by the advisory and inspect its details."
        fn what(self) -> String { "`[{self.severity}]` advisory `{self.advisory_id}` matches `{self.package}` `{self.version}`: {self.title}." }
        fn why(self) -> String { "The advisory database flags this version as having a known vulnerability, exposed interface, or supply-chain risk. `jet inspect audit` exits nonzero only on a `critical` match; lower severities inform and exit 0." }
        fn fix(self) -> String { "Upgrade to `>= {self.fixed_version}` (or the version listed in the advisory). Run `jet inspect audit --explain {self.advisory_id}` for details." }
    }
}

struct IntegrityCheckFailed {
    package: String
    version: String
    expected: String
    actual: String

    impl Diagnostic {
        code :: "E2604"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "Integrity check failed for `{self.package}` `{self.version}` — expected `{self.expected}`, got `{self.actual}`." }
        fn why(self) -> String { "A fetched artifact's content hash differs from what the lockfile recorded. This means the artifact changed after it was locked — accidental or deliberate tampering. A `jet fetch` run reports this integrity failure." }
        fn fix(self) -> String { "Re-run `jet fetch` after cleaning stale Jetpack hangar entries (`jet clean`). If the problem persists, the upstream source may have been altered; audit the change before proceeding." }
    }
}

struct DirtyTreePublish {
    name: String
    version: String

    impl Diagnostic {
        code :: "E2605"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "`{self.name}` v{self.version} cannot be published from a dirty working tree." }
        fn why(self) -> String { "The registry records the exact source revision that was published. A dirty tree means uncommitted changes would be silently excluded, making the published package unreproducible." }
        fn fix(self) -> String { "Commit or stash all uncommitted changes (`git status` to list them), then run `jet registry publish` again. Use `--force` to bypass with an explicit warning banner." }
    }
}

struct MissingYankVersion {
    impl Diagnostic {
        code :: "E2606"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "`jet registry yank` requires a version argument." }
        fn why(self) -> String { "A yank marks one specific published version as deprecated; without a version the command doesn't know which one to yank." }
        fn fix(self) -> String { "Run `jet registry yank <version>`, e.g. `jet registry yank 1.2.3`." }
    }
}

struct MalformedSource {
    source: String
    detail: String

    impl Diagnostic {
        code :: "E2607"
        stage :: [.Compile]
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`{self.source}` is malformed: `{self.detail}`." }
        fn why(self) -> String { "Supply-chain metadata is security-sensitive, so Jet rejects ambiguous or partial records instead of silently skipping them." }
        fn fix(self) -> String { "Fix the malformed record and retry; use the parser contract in `spec.md` and UTF-8 text." }
    }
}

struct BlockedPackageName {
    name: String
    reason: String
    reference: String

    impl Diagnostic {
        code :: "E2608"
        stage :: [.Jet]
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Choose a distinct package name and remove any reserved suffix before publishing."
        fn what(self) -> String { "Registry package name `{self.name}` is blocked: {self.reason}" }
        fn why(self) -> String { "Package names are trust labels. Jet compares each new name with existing names, folds common homoglyphs, and reserves misleading suffixes so a lookalike cannot borrow an established package's identity." }
        fn fix(self) -> String { "Choose a different package name than `{self.reference}`, remove the reserved suffix if present, then publish again." }
    }
}

struct ImmaturePackage {
    package: String
    version: String
    source_class: String

    impl Diagnostic {
        code :: "E2609"
        stage :: [.Compile]
        detail :: true
        fix_next :: "Wait for the maturity window or add a reviewed exact-version exception."
        fn what(self) -> String { "`{self.package}#{self.version}` is not mature under the advisory policy." }
        fn why(self) -> String { "A trusted signed feed records the first immutable inclusion of this `{self.source_class}` release; the configured maturity window has not elapsed." }
        fn fix(self) -> String { "Wait for the maturity window, or add a reviewed exact `{self.package}#{self.version}` exception with a reason, reviewer, and expiry." }
    }
}

struct RejectedSource {
    source: String
    detail: String

    impl Diagnostic {
