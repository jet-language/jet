}

struct RetiredCounterLoop {
    impl Diagnostic {
        code :: "E0376"
        stage :: [.Parse]
        status :: .Retired
        meaning :: "Teaching: C-style counter loop `init, cond, step` retired"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "C-style counter loop headers are retired." }
        fn why(self) -> String { "A three-slot loop header is binding, source, and step rule — not init, condition, and assignment." }
        fn fix(self) -> String { "Write `loop i in 0..<n {{ … }}` or `loop i in 0..n, 2 {{ … }}`; keep `loop name := value, condition {{ … }}` for mutable state." }
    }
}

struct RetiredKnownMarker {
    impl Diagnostic {
        code :: "E0377"
