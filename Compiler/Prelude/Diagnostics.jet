        fn why(self) -> String { "`f(...xs)` only applies when the callee's final parameter is variadic (`name: ...T`)." }
        fn fix(self) -> String { "Pass arguments individually, or call a function whose last parameter is variadic." }
    }
}

struct VariadicBoundNotImplemented {
    arg: String
    trait_name: String
    param: String

    impl Diagnostic {
        code :: "E1313"
        meaning :: "Trait-bounded variadic call-site argument doesn't implement the bound trait"
        detail :: true
        no_fix :: .Ambiguous
        fix_next :: "Implement the required trait for the argument type, or drop the value from this call."
        fn what(self) -> String { "`` `{self.arg}` doesn't implement `{self.trait_name}` `` — a trait-bounded variadic call-site argument fails one of the bound trait(s)." }
        fn why(self) -> String { "`{self.param}: ...{self.trait_name}` (or `...[A, B]`) checks every argument against the bound trait(s) — that's how a function like this accepts a mix of types safely, with each argument monomorphized to its own concrete type (zero boxing)." }
        fn fix(self) -> String { "Implement `{self.trait_name}` for the argument's type, or drop the value from this call." }
    }
}

struct VariadicOutsideLoop {
    name: String

    impl Diagnostic {
        code :: "E1314"
        meaning :: "Trait-bounded variadic parameter used outside a `loop x in name {{ … }}` loop"
        detail :: true
        no_fix :: .Ambiguous
        fix_next :: "Iterate the lazy value directly in the supported loop form."
        fn what(self) -> String { "`` `{self.name}` can only be used in a direct source loop here `` — a trait-bounded variadic parameter referenced outside its one supported shape." }
        fn why(self) -> String { "A trait-bounded variadic's elements can have different concrete types, so there's no single type to give the whole parameter (`.len()`, indexing, passing it on, a second loop, …) outside a loop that visits each argument once." }
        fn fix(self) -> String { "Iterate it with `loop x in {self.name} {{ … }}` — that's the only supported use in v1." }
    }
}

struct InvalidModuleContribution {
