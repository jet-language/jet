        fn what(self) -> String { "No package record or build attempt exists for `{self.pkg}`." }
        fn why(self) -> String { "`jet explain` reads the Hangar Store and persisted Jetpack realization attempts. If neither record exists on this machine, there is no local package explanation." }
        fn fix(self) -> String { "Run `jet build <ref>` first; for diagnostic-code help, keep using `jet explain E1234`." }
    }
}

struct SandboxUnavailable {
    impl Diagnostic {
        code :: "E1275"
        stage :: [.Jetpack]
