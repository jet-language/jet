        no_fix :: None
        fix_safety :: .NeedsReview
        fn what(self) -> String { "`{self.old}` is spelled `{self.canonical}`." }
        fn why(self) -> String { "Jet keeps acronyms fully capitalized inside PascalCase names." }
        fn fix(self) -> String { "Write the capitalized spelling shown by the diagnostic; `jet fix` applies this edit." }
    }
}

struct DimensionMismatch {
