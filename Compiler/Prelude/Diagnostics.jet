        detail :: true
        fn what(self) -> String { "A method's stated receiver footprint (`&self.log`, `&self.[log, hits]`) names no field of its record, or its body reads or changes a field outside it." }
        fn why(self) -> String { "Callers and the published API see the stated footprint, so it must name stored fields and the body must stay inside it." }
        fn fix(self) -> String { "Add the field to the receiver's footprint, or change the method to stay inside it." }
    }
}

