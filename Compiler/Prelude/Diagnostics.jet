        detail :: true
        no_fix :: .Ambiguous
        fix_next :: "Write the exact resolved dependency version, or run `jet fetch --lock` to pin it."
        fn what(self) -> String { "`use {self.name}#{self.selector};` isn't pinned to an exact version." }
        fn why(self) -> String { "An inline script dependency has no lockfile until `jet fetch --lock` runs; a loose selector (`1.4` rather than `1.4.2`) can resolve to a different version on a fresh clone." }
        fn fix(self) -> String { "Write the exact version Jet resolved (`use {self.name}#<major.minor.patch>;`), or run `jet fetch --lock` to pin it in `<script>.lock`." }
    }
}

