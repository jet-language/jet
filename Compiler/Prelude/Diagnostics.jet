        fn why(self) -> String { "State facts and ordinary members share the owning type's namespace" }
        fn fix(self) -> String { "Rename the state or the member so `Type.State.{self.state}` is unique" }
    }
}

struct DuplicateStateSection {
    type: String

    impl Diagnostic {
        code :: "E0168"
        stage :: [.Parse]
