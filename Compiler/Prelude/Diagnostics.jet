        detail :: true
        no_fix :: None
        fn what(self) -> String { "`layout` is retired" }
        fn why(self) -> String { "Constraint layouts use typed-literal construction." }
        fn fix(self) -> String { "Write `` `{self.name} :: Layout{{{{ … }}}}` ``." }
    }
}

struct RetiredLayoutHandle {
    impl Diagnostic {
        code :: "E2936"
        status :: .Retired
        meaning :: "Teaching: retired `LayoutHandle` → `Layout`"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "The constraint-layout type is named `Layout`, not `LayoutHandle`" }
        fn why(self) -> String { "One name for the solver/container value (I8)." }
        fn fix(self) -> String { "Write `Layout` instead of `LayoutHandle`." }
    }
}

struct UiServiceWithoutCapability {
    service: String
    capability: String

    impl Diagnostic {
        code :: "E2937"
        meaning :: "A UI host service is used without its declared package capability"
        detail :: true
        fix_next :: "Add the required package capability to `authority.needs`, then rebuild."
        fn what(self) -> String { "UI host service `{self.service}` needs `{self.capability}`." }
        fn why(self) -> String { "The typed host row crosses an operating-system service boundary, so every tier must receive the same explicit package capability instead of discovering permission at runtime. During `jet check`, Jet reports this diagnostic." }
        fn fix(self) -> String { "Add `{self.capability}` to `authority.needs` in the package manifest, then rebuild." }
    }
}

struct InvalidShortcut {
    shortcut: String
    reason: String

    impl Diagnostic {
        code :: "E2938"
        meaning :: "A `.cmd` shortcut must be a non-empty plain key literal"
        detail :: true
        fn what(self) -> String { "Invalid UI shortcut literal `{self.shortcut}`: {self.reason}" }
        fn why(self) -> String { "`.cmd` is the checked command-key constructor, so its key is fixed before code generation and every tier receives the same shortcut metadata. During `jet check`, Jet reports this diagnostic." }
        fn fix(self) -> String { "Write a non-empty plain string literal, for example `.cmd(\"s\")`; use `core.ui.host.shortcut` for a dynamic key." }
    }
}

struct UnknownEnvironmentModule {
    impl Diagnostic {
        code :: "E1337"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "The requested environment module is not declared" }
        fn why(self) -> String { "One environment plan activates one `env.<name>` module; silently merging siblings would mix unrelated packages and variables." }
        fn fix(self) -> String { "Select one of the declared module names, or omit `--env` to use `dev`, then `default`, then lexical order." }
    }
}

struct UnknownEnvProfileFlag {
    impl Diagnostic {
        code :: "E1342"
        stage :: [.Jetpack]
        meaning :: "jetpack has no `--env-profile` flag"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "Jetpack has no `--env-profile` flag" }
        fn why(self) -> String { "`--env` selects one `env.<name>` module; `--preset` selects a named composition." }
        fn fix(self) -> String { "Select the module with `--env <name>`." }
    }
}

struct RetiredAuditedEffectFlag {
    impl Diagnostic {
        code :: "E1343"
        stage :: [.Jet]
        status :: .Retired
        meaning :: "The retired audited-effect boolean changed gate policy semantics"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "The retired audited-effect boolean is not accepted." }
        fn why(self) -> String { "Audited escapes share one policy ladder, so a boolean cannot express which gate is being authorized or which organization policy may refuse it." }
        fn fix(self) -> String { "Use `--gate impure=allow`." }
    }
}

struct InvalidDelegationTarget {
    field: String
    trait_name: String

    impl Diagnostic {
        code :: "E2401"
        stage :: [.Compile]
        detail :: true
        no_fix :: .Ambiguous
        fix_next :: "Implement the trait on the delegation target or choose a field that already implements it."
        fn what(self) -> String { "The delegation target `{self.field}` doesn't implement `{self.trait_name}`, or the type has no field named `{self.field}`." }
        fn why(self) -> String { "`impl Type.Trait using field` forwards every `Trait` method to the `field` field; if that field's type hasn't implemented `Trait`, there's nothing to forward to." }
        fn fix(self) -> String { "Implement `impl FieldType.Trait` on the field's type, or choose a different field that does implement `Trait`. If the field doesn't exist, add `{self.field}: FieldType` to the struct." }
    }
}

struct MissingErrorConversion {
    err: String

    impl Diagnostic {
        code :: "E2402"
        stage :: [.Compile]
        meaning :: "Fallible call cannot convert `{{err}}` into `Err` — no declared conversion exists"
        detail :: true
        fix_next :: "Declare an error conversion into `Err`, or change the enclosing fallible return type."
        fn what(self) -> String { "A fallible call cannot convert `{self.err}` into `Err` — no declared conversion exists" }
        fn why(self) -> String { "A fallible call uses the declared conversion rail; `{self.err}` can reach `Err` only through `impl {self.err} -> Err`." }
        fn fix(self) -> String { "Add `impl {self.err} -> Err {{ … }}` before this function, or change the enclosing return type to `T !{self.err}`." }
    }
}

struct UnknownFieldPun {
    name: String
    type: String

    impl Diagnostic {
        code :: "E2403"
        stage :: [.Compile]
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Field-pun name `{self.name}` is not in scope (or is not a field of `{self.type}`)." }
        fn why(self) -> String { "`Type {{ name }}` is shorthand for `Type {{ name: name }}` — it reads the local variable `name` and assigns it to the field of the same name. If no such local exists, or if `Type` has no field by that name, the shorthand is ambiguous." }
        fn fix(self) -> String { "Introduce a local `name :: …;` before the struct literal, or write the long form `Type {{ field_name: value }}`." }
    }
}

struct ErrorNotPropagatable {
    callee: String
    source: String
    target: String
    definition: String
    contract: String
    caller: String

    impl Diagnostic {
        code :: "E2404"
        stage :: [.Compile]
        detail :: true
        edit :: .SuggestedSourceEdit
        no_fix :: None
        fix_safety :: .NeedsReview
        fn what(self) -> String { "`{self.callee}` fails with `{self.source}`, which can't propagate into `{self.target}` here" }
        fn why(self) -> String { "`{self.callee}` is defined at `{self.definition}` with effective failure contract `{self.contract}`; the caller's `{self.caller}` contract has no route from `{self.source}` to `{self.target}`" }
        fn fix(self) -> String { "Declare the caller with `{self.source}` as its failure domain, or add `impl {self.source} -> {self.target} {{ … }}`; otherwise handle `{self.callee}` locally with `??`" }
    }
}

struct DuplicateErrorConversion {
    source: String
    target: String

    impl Diagnostic {
        code :: "E2405"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "`impl {self.source} -> {self.target}` is already declared." }
        fn why(self) -> String { "There can be at most one declared way to convert a `Source` error into a `Target`; the second block is rejected." }
        fn fix(self) -> String { "Remove one of the two `impl … -> …` blocks." }
    }
}

struct OrphanErrorConversion {
    source: String
    target: String

    impl Diagnostic {
        code :: "E2406"
        stage :: [.Compile]
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Can't declare `impl {self.source} -> {self.target}` — neither type is defined in this program." }
        fn why(self) -> String { "Typed-target error conversions obey the same orphan rule as trait impls (S28); only the default `Err` target may name a foreign source." }
        fn fix(self) -> String { "Define one of these types locally, or convert the foreign source into `Err`." }
    }
}

struct FailureDomainNotErrorType {
    domain: String

    impl Diagnostic {
        code :: "E2417"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "Explicit failure domain `{self.domain}` is not an Error type" }
        fn why(self) -> String { "A `!` contract may name `Err`, a Core error, a type marked `#Error`, an all-error union, or `Never`; arbitrary value types do not describe failures." }
        fn fix(self) -> String { "Use a Core error, add `#Error` to a local error type, or remove the explicit error contract." }
    }
}

struct ErrorConversionCycle {
    source: String
    target: String

    impl Diagnostic {
        code :: "E2418"
        stage :: [.Compile]
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Error conversion cycle: `impl {self.source} -> {self.target}` would make conversion loop" }
        fn why(self) -> String { "Error conversions must form an acyclic route so a failure has one finite meaning." }
        fn fix(self) -> String { "Remove this edge or choose a target that is not already reachable back to the source." }
    }
}

struct AmbiguousErrorConversion {
    source: String
    target: String

    impl Diagnostic {
        code :: "E2419"
        stage :: [.Compile]
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Error conversion is ambiguous: `{self.source}` already reaches `{self.target}`" }
        fn why(self) -> String { "A source and target may have one unique declared conversion route." }
        fn fix(self) -> String { "Remove the direct edge or remove one of the intermediate conversion edges." }
    }
}

struct InvalidRename {
    impl Diagnostic {
        code :: "E2407"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "`#Rename(...)` needs a string literal." }
        fn why(self) -> String { "The wire key a `#Codable` field maps to is a constant string; a number or expression has no place on the wire." }
        fn fix(self) -> String { "Pass one quoted string — `#Rename(\"wire_name\")`." }
    }
}

struct FlattenNonStruct {
    field: String

    impl Diagnostic {
        code :: "E2408"
        stage :: [.Compile]
        detail :: true
        fix_next :: "Give the field a `#Codable` struct type, or remove `#Flatten`."
        fn what(self) -> String { "`#Flatten` on `{self.field}` needs a struct-typed field." }
        fn why(self) -> String { "Flatten splices another struct's keys into this object, so the field must itself be a `#Codable` struct — not a primitive, list, or map." }
        fn fix(self) -> String { "Give `{self.field}` a `#Codable` struct type, or drop `#Flatten`." }
    }
}

struct UnknownCasingStyle {
    style: String

    impl Diagnostic {
        code :: "E2409"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "`#RenameAll({self.style})` isn't a known casing style." }
        fn why(self) -> String { "The wire-casing menu is the closed typed set `camel`/`snake`/`pascal`/`kebab`/`screaming`; anything else is rejected so a typo fails at compile time, not on the wire." }
        fn fix(self) -> String { "Pick one of `camel` / `snake` / `pascal` / `kebab` / `screaming`." }
    }
}

struct MissingRequiredField {
    field: String

    impl Diagnostic {
        code :: "E2410"
        stage :: [.Compile]
        detail :: true
        fix_next :: "Mark the field optional, give it a compile-time default, or provide the missing input key."
        fn what(self) -> String { "`E2410: missing required field `{self.field}`` (runtime `FieldError`)." }
        fn why(self) -> String { "Decoding into a `#Codable`/`#Decode` type found no wire value for a required field and the field has no declaration default (`T{{{{expr}}}}`) and isn't optional." }
        fn fix(self) -> String { "Mark the field optional (`T?`), give it a declaration default (`field: T{{{{expr}}}}`), or fix the input so the key is present. Compose with `??` to supply a fallback." }
    }
}

struct NotSerializable {
    type: String

    impl Diagnostic {
        code :: "E2411"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "`{self.type}` can't be serialized / decoded, or a union member has no compiler-known wire shape." }
        fn why(self) -> String { "Only a structurally qualifying type gets a compiler-generated codec (by default or through `#Codable`/`#Encode`/`#Decode`), unless it supplies a hand-written codec. Anonymous-union decoding also needs each member's outer wire shape; a custom or imported decoder does not declare one." }
        fn fix(self) -> String { "Add a compiler-derived codec, use a configured tagged enum or `#CodableAsBase` distinct type for a union member, or remove the unsupported type from the encoded value (for example, with `#Skip`)." }
    }
}

struct UnknownDecodedField {
    field: String

    impl Diagnostic {
        code :: "E2412"
        stage :: [.Compile]
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`E2412: unknown field `{self.field}`` (runtime `FieldError`)." }
        fn why(self) -> String { "The struct is marked `#DenyUnknownFields` and the input carried a key the struct doesn't declare, so decoding fails instead of silently dropping it." }
        fn fix(self) -> String { "Remove `#DenyUnknownFields` to ignore extra keys (the lenient default), add the field, or fix the producer." }
    }
}

struct RetiredCodableBounds {
    impl Diagnostic {
        code :: "E2413"
        stage :: [.Compile]
        status :: .Retired
        detail :: true
        no_fix :: None
        fn what(self) -> String { "Retired — generic `#Codable` is first-class; the derive auto-injects `Encode`/`Decode` bounds on the wire-reaching type params. A non-codable type argument fails at the use site (E0905), not the definition." }
        fn why(self) -> String { "—" }
        fn fix(self) -> String { "—" }
    }
}

struct DefaultNotConstant {
    impl Diagnostic {
        code :: "E2414"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "A field's `{{…}}` default must be a compile-time constant." }
        fn why(self) -> String { "A decode/CLI/construction default fills a missing field, so it is baked into the program and its value has to be known at compile time. An expression that can only be computed at runtime has no fixed value to bake, and every tier must agree (I9). During `jet check`, Jet reports this diagnostic." }
        fn fix(self) -> String { "Use a literal or a `comptime`-evaluable expression, e.g. `port: Int{{8080}}`, `env: String{{\"prod\"}}`, or `ports: [Int]{{[80, 443]}}`." }
    }
}

struct AmbiguousUnionShape {
    union: String
    a: String
    b: String
    shape: String

    impl Diagnostic {
        code :: "E2415"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "Union `{self.union}` can't be decoded — `{self.a}` and `{self.b}` share wire shape `{self.shape}`." }
        fn why(self) -> String { "Anonymous-union decode picks a member by primary wire shape; two members with the same shape would force an arbitrary declaration order." }
        fn fix(self) -> String { "Use a named enum with an explicit tag, or change the members so each has a distinct wire shape." }
    }
}

struct EnvDecodeFailed {
    impl Diagnostic {
        code :: "E2416"
        stage :: [.Runtime]
        moment :: .Run
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`env.decode` could not build the typed config; the error names the source environment variable and field path." }
        fn why(self) -> String { "Runtime config decoding uses the shared `__jet_Decode` codec, so a bad value, missing field, or unknown field is reported at its typed path while secret values stay redacted." }
        fn fix(self) -> String { "Fix the named environment variable or field path, or adjust `prefix:`, `file:`, and `allow:` so the intended source reaches the typed record." }
    }
}

struct UnknownAnalyticsColumn {
