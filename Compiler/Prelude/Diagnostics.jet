struct YieldOutsideStream {
    impl Diagnostic {
        code :: "E0805"
        fn what(self) -> String { "`yield` used outside a function declared `Stream<T>`" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Declare the function as `Stream<T>` before using `yield`." }
    }
}

