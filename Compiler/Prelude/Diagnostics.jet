struct MisplacedShebang {
    impl Diagnostic {
        code :: "E0042"
        stage :: [.Lex]
        meaning :: "Shebang line is only recognized at the start of a Jet file"
        detail :: true
        fn what(self) -> String { "A shebang line is only recognized at the very start of the file" }
        fn why(self) -> String { "The operating system reads launch metadata only from byte 0; Jet does not treat another `#!` as a launch line" }
        fn fix(self) -> String { "Move `#!...` to line 1, or delete it" }
    }
}

