    impl Diagnostic {
        code :: "E1344"
        meaning :: "CLI command name collides with another command or root flag"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "CLI command `{self.command}` collides with another command or root flag" }
        fn why(self) -> String { "A program struct has one command namespace and one root flag namespace; a word cannot name both." }
        fn fix(self) -> String { "Rename the command or root field so every command word is unique" }
    }
}

struct CliMemberNotCallable {
