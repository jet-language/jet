        detail :: true
        no_fix :: .Ambiguous
        fix_next :: "Add an entry or transition path to the declared state, or remove it from the declaration."
        fn what(self) -> String { "`{self.type}.State.{self.state}` is unreachable from every entry transition." }
        fn why(self) -> String { "When a state graph has entry transitions, no entry path reaches this state. It may be an unused branch or a state name that is not connected to the protocol." }
        fn fix(self) -> String { "Add an entry or transition path to `{self.state}`, or remove it from the declaration." }
    }
}

