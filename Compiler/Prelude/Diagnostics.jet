        }

        why: fn(self) -> String {
            "Published versions are immutable — a version can never be overwritten, only yanked, so anyone who already locked it keeps building the exact same bytes."
        }

        fix: fn(self) -> String {
            "Bump the version in `package.jet` and publish again, or `jet registry yank {self.version}` the existing one first if it was a mistake (yanking hides it from new resolution; it does not free the version number for reuse)."
        }
    }
}

