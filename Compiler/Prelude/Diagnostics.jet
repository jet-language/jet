        fn what(self) -> String { "Loop stride must be a positive Int" }
        fn why(self) -> String { "The registered sema/runtime rule applies here" }
        fn fix(self) -> String { "Use a positive `Int` literal or expression for the loop stride." }
    }
}

struct BranchTypeMismatch {
