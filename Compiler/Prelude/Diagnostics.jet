        code :: "E0359"
        meaning :: "Physical quantity dimensions are incompatible for the requested operator"
        detail :: true
        fn what(self) -> String { "`+` can't combine Length with Time" }
        fn why(self) -> String { "Physical quantities must have compatible dimensions before they can be added, subtracted, or compared" }
        fn fix(self) -> String { "Use matching dimensions, or use `*` or `/` to derive a new dimension" }
    }
}

struct MissingOperatorHook {
    symbol: String
    type: String

    impl Diagnostic {
        code :: "E0360"
        meaning :: "A nominal type uses arithmetic without the required operator hook"
        detail :: true
        fn what(self) -> String { "No `{self.symbol}` operator is defined for `{self.type}`." }
        fn why(self) -> String { "User arithmetic dispatches only through the matching fixed operator trait hook; the compiler does not guess a method or fall back to a built-in operator. During `jet check`, Jet reports this diagnostic." }
        fn fix(self) -> String { "Implement the named `Type.Trait` hook, or call a named method instead." }
    }
}

struct RecursiveOperatorHook {
    hook: String
    symbol: String

    impl Diagnostic {
        code :: "E0361"
        meaning :: "An operator hook directly dispatches back to itself through its symbol"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`{self.hook}` calls itself through `{self.symbol}`." }
        fn why(self) -> String { "The symbol inside its own hook dispatches directly back to that hook, so evaluation would recurse forever." }
        fn fix(self) -> String { "Combine the value's fields directly, or call a different named helper inside the hook." }
    }
}

struct NestedHookedAssignment {
    impl Diagnostic {
