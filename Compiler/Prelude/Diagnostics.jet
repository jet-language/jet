DuplicateAccessMarker: struct {
    impl Diagnostic {
        code: "E0029"
        safety_class: .Soundness
        safety_reason: "Two markers give one parameter two access modes, so callers and body could disagree about who may write it."
        expert_path: "none: one parameter has one access mode; write the one meant"
        stage: [.Parse]
        meaning: "A parameter that carries two access markers"

        what: fn(self) -> String { "Two access markers on one parameter" }

        why: fn(self) -> String {
            "A parameter has one access mode, so a second access marker can only repeat or contradict the first"
        }

        fix: fn(self) -> String { "Keep exactly one access marker on the parameter." }
    }
}

