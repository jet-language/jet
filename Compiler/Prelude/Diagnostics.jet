struct FlagArgumentCount {
    impl Diagnostic {
        code :: "E1301"
        meaning :: "`ArgsSpec.flag` or `ParsedArgs.flag` called with wrong arity"
        detail :: true
        fn what(self) -> String { "`flag` expects 2 arguments (name, help), got N" }
        fn why(self) -> String { "`ArgsSpec.flag(name, help)` registers a boolean flag like `--verbose`; both the flag name and a one-line help string are required." }
        fn fix(self) -> String { "Pass exactly two strings: the flag name and a help description, e.g. `.flag(\"verbose\", \"enable verbose output\")`." }
    }
}

struct OptionArgumentCount {
    impl Diagnostic {
        code :: "E1302"
        meaning :: "`ArgsSpec.option` or `ParsedArgs.option` called with wrong arity"
        detail :: true
        fn what(self) -> String { "`option` expects 3 arguments (name, help, metavar), got N" }
        fn why(self) -> String { "`ArgsSpec.option(name, help, metavar)` registers a value option like `--output FILE`; all three strings are required." }
        fn fix(self) -> String { "Pass three strings: the option name, a help description, and a placeholder like `FILE`, e.g. `.option(\"output\", \"write to FILE\", \"FILE\")`." }
    }
}

struct PositionalArgumentCount {
    impl Diagnostic {
        code :: "E1303"
        meaning :: "`ArgsSpec.positional` or `ParsedArgs.positional` called with wrong arity"
        detail :: true
        fn what(self) -> String { "`positional` expects 2 arguments (name, help), got N" }
        fn why(self) -> String { "`ArgsSpec.positional(name, help)` registers a required positional argument; both name and help are required." }
        fn fix(self) -> String { "Pass exactly two strings: the positional name and a help description, e.g. `.positional(\"input\", \"file to process\")`." }
    }
}

struct ParseArgumentCount {
    impl Diagnostic {
        code :: "E1304"
        meaning :: "`ArgsSpec.parse` called with wrong arity"
        detail :: true
        fn what(self) -> String { "`parse` expects 1 argument (the argument list), got N" }
        fn why(self) -> String { "`ArgsSpec.parse(args)` parses the program's words (`process.args()`) against the spec; pass exactly that list." }
        fn fix(self) -> String { "Pass exactly one argument: the argument list, e.g. `spec.parse(process.args())`." }
    }
}

struct UnmappedCliFieldType {
    impl Diagnostic {
        code :: "E1305"
        meaning :: "`#CLI` struct field has a type with no CLI flag mapping"
        detail :: true
        fn what(self) -> String { "Field `name` has no CLI flag mapping (Type)" }
        fn why(self) -> String { "Only `Int` (including inline ranges), `Float`, `Bool`, `String`, `Path`, and `T?` of those map to a flag; a nested `#CLI` struct, a `Map`, a closure, or a plain `[T]` don't." }
        fn fix(self) -> String { "Change the field to a supported type, or drop it from the `#CLI` struct." }
    }
}

struct DuplicateCliFlag {
    impl Diagnostic {
        code :: "E1306"
        meaning :: "Two `#CLI` fields derive the same flag, or a field uses reserved `--help`, `--allow`, or `--deny`"
        detail :: true
        fn what(self) -> String { "Two `#CLI` fields derive the same flag, or a field uses a reserved flag" }
        fn why(self) -> String { "Every field needs a distinct `--flag`; generated commands reserve `--help`, `--allow`, and `--deny`." }
        fn fix(self) -> String { "Rename the colliding field or choose a non-reserved flag name." }
    }
}

struct RunParameterNotCli {
    impl Diagnostic {
        code :: "E1308"
        meaning :: "`fn run`'s entry parameter isn't a `#CLI` program struct"
        detail :: true
        fn what(self) -> String { "`run`'s parameter isn't a CLI-derived type" }
        fn why(self) -> String { "A typed `fn run(args: T)` entry only works when `T` is a `#CLI`-derived program struct." }
        fn fix(self) -> String { "Mark the program struct `#CLI`." }
    }
}

struct RedundantFlagMarker {
    expr: String

    impl Diagnostic {
        code :: "E1309"
        meaning :: "`#Flag` on a `#CLI` field that is already flag-only"
        detail :: true
        fix_next :: "Remove `#Flag`, or make the field a required scalar without a default."
        fn what(self) -> String { "`#Flag` on `name` has nothing to opt out of" }
        fn why(self) -> String { "`#Flag` keeps a required value field flag-only. Bool fields, `T?` fields, and fields with a `{self.expr}` default are already flag-only." }
        fn fix(self) -> String { "Remove `#Flag`, or make the field a required scalar without a `{self.expr}` default." }
    }
}

struct InvalidShortName {
    impl Diagnostic {
        code :: "E1318"
        meaning :: "A `#Short` value is not one ASCII letter, or two `#CLI` fields use the same short name"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`#Short(\"name\")` is not a one-letter option `` or `` `#Short(\"n\")` is used by both `first` and `second`" }
        fn why(self) -> String { "The shared command parser treats a short option as one ASCII letter, and each spelling must select only one `#CLI` field." }
        fn fix(self) -> String { "Use one letter and give colliding fields different values." }
    }
}

struct UnmappedCliMarker {
    impl Diagnostic {
        code :: "E1319"
        meaning :: "`#Short` or `#Env` has no typed-CLI builder mapping at its field"
        detail :: true
        fn what(self) -> String { "`#Short` has no CLI mapping for field `name`" }
        fn why(self) -> String { "`#Short` and `#Env` describe generated command inputs. They do not apply outside a `#CLI` struct; `#Env` also cannot map a presence-only `Bool` flag to the builder's value-option fallback." }
        fn fix(self) -> String { "Remove the marker, mark the command-input struct `#CLI`, or move `#Env` to a value field." }
    }
}

struct CliCommandConflict {
