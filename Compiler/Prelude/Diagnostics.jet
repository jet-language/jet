        meaning :: "Dyn method name used as a field"
        detail :: true
        fn what(self) -> String { "`{self.name}` is a `Dyn` method, not a field" }
        fn why(self) -> String { "Dyn member names are reserved for methods" }
        fn fix(self) -> String { "Use indexing, for example `d[\"{self.name}\"]`" }
