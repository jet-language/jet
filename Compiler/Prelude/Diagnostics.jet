        fn what(self) -> String { "A module contribution's value isn't a struct literal of its namespace's type." }
        fn why(self) -> String { "`env.dev: Env {{ … }}` ties a namespace to its matching type so the merge engine knows what it's combining." }
        fn fix(self) -> String { "Wrap the value in the matching type, e.g. `Env {{ … }}`." }
    }
}

struct ModuleSourceConflict {
