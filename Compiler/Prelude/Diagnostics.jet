        fn what(self) -> String { "Replay capture refused sensitive data" }
        fn why(self) -> String { "Safe capture refuses reachable Rand/IO/Net; sensitive capture needs TTY consent." }
        fn fix(self) -> String { "Use `--capture` for Time-only, or run `--capture-sensitive` interactively." }
    }
}

struct ReplayTooLarge {
