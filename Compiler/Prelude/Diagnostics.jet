        fn what(self) -> String { "The name already holds a value" }
        fn why(self) -> String { "Each name refers to one thing; text and byte pattern holes introduce new names, not comparisons or Optional refinements" }
        fn fix(self) -> String { "Rename the binding or hole; to compare interpolated text with an existing value, wrap the right-hand text in parentheses." }
    }
}

struct UnknownType {
    impl Diagnostic {
        code :: "E0119"
        meaning :: "Unknown type name"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`Bogus` isn't a known effect" }
        fn why(self) -> String { "An effect list names compiler-known effects like `Net`, `FS`, `IO`, `DB`, or `Time`" }
        fn fix(self) -> String { "Use one of the known effect names, or remove it from the list" }
    }
}

struct ReadOnlyValueNotOwned {
    impl Diagnostic {
        code :: "E0120"
        meaning :: "A read-only value cannot fill an owning destination because it is non-cloneable or `copies: .Explicit` is active"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .NeedsReview
        fn what(self) -> String { "`name` was not moved here, so it cannot fill this owning destination" }
        fn why(self) -> String { "Read access does not transfer ownership; cloneable values copy automatically at ordinary owning destinations, but this value needs an explicit ownership decision" }
        fn fix(self) -> String { "Write `name.copy()` for an owning copy, add `^` to the parameter when it should take ownership, or return borrowed data as `-> View<T> from name` with a view derived from `name`" }
    }
}

struct UseAfterMove {
    name: String
    consumer: String

    impl Diagnostic {
        code :: "E0121"
        meaning :: "Value used after it was given away"
        detail :: true
        fix_next :: "Move the value only to its consuming use, or create a copy before reusing it."
        fn what(self) -> String { "`{self.name}` was consumed by {self.consumer}, so it can't be used here" }
        fn why(self) -> String { "After a value moves somewhere else, its old name no longer gives access to it" }
        fn fix(self) -> String { "Stop using `{self.name}` after the move, or give {self.consumer} a copy with `{self.name}.copy()` where it moved." }
    }
}

struct ExplicitCopiesUnparsable {
    file: String

    impl Diagnostic {
        code :: "E0122"
        stage :: [.Tooling]
        meaning :: "`jet fmt --explicit-copies` wrote copy calls that do not parse; this is a compiler defect and the file is left unchanged (#3738)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "The copy calls for `{self.file}` do not parse, so `{self.file}` was left unchanged" }
        fn why(self) -> String { "`jet fmt --explicit-copies` writes `.copy()` at the copy sites the checker reports; a site that yields unparseable source is a defect in the copy-site data, not in your code, which checks clean." }
        fn fix(self) -> String { "Report the file to the Jet maintainers; format without `--explicit-copies` until the fix lands." }
    }
}

struct InvalidLoopStride {
