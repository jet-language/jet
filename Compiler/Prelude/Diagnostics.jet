        stage :: [.Jet]
        meaning :: "Target triple unknown or toolchain component missing"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Target `{self.triple}` is not available." }
        fn why(self) -> String { "Jet has no backend for this target, or the target triple is not recognised. `wasm32-wasip2` is the supported WASI Preview 2 server Component target. A `jet build` or `jet run` run reports this target-support diagnostic." }
        fn fix(self) -> String { "Run `jet self doctor --target=<triple>` to see what's missing; use `wasm32-wasip2` for a WASI Preview 2 server." }
    }
}

struct MissingAllocatorFact {
