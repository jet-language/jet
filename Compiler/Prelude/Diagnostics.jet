    impl Diagnostic {
        code :: "E2391"
        stage :: [.Compile]
        meaning :: "Project check could not prove the Core closure"
        detail :: true
        fn what(self) -> String { "Project check could not prove the Core closure: {self.detail}" }
        fn why(self) -> String { "The selected Core calls and synthesized Prelude closure must be known before a project can be reported clean." }
        fn fix(self) -> String { "Repair the Core route or compiler defect named by the proof, then run jet check again." }
    }
}

struct UnprovenTierLowering {
