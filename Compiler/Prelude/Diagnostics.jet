    chain: String

    impl Diagnostic {
        code :: "E-SUBJECT-CALL"
        meaning :: "Bare member shorthand used where an ordinary value is expected"
        detail :: true
        fix_next :: "Write an ordinary value of the expected type, or use a full subject lambda."
        fn what(self) -> String { "A bare member chain cannot be used as a value of type {self.expected} here" }
        fn why(self) -> String { "Lower-case `.member` is shorthand only for a one-parameter callable; this argument expects an ordinary value" }
        fn fix(self) -> String { "Write a value of type {self.expected}, or use `(subject: {self.expected}) -> subject{self.chain}`" }
    }
}

struct CasingMismatch {
    impl Diagnostic {
        code :: "E0357"
        meaning :: "An identifier violates Jet's machine-enforced casing category"
        detail :: true
        fn what(self) -> String { "An identifier is not written in the casing required for its grammatical category." }
        fn why(self) -> String { "Jet enforces PascalCase for type-like names, snake_case for value-like names, and ALL_CAPS (SCREAMING_SNAKE_CASE) for module-global constants. During `jet check`, Jet reports this diagnostic." }
        fn fix(self) -> String { "Rename the identifier to the exact spelling shown by the diagnostic. Foreign names inside FFI binding modules are exempt." }
    }
}

struct AcronymCasing {
