        detail :: true
        no_fix :: .Behavior
        fix_next :: "Declare an executable package in `package.jet`, or point the image at one."
        fn what(self) -> String { "The image `{self.image}` is built from a non-executable package `{self.package}`." }
        fn why(self) -> String { "An `.Oci` image's `from: packages.<name>` must name a package this project's `package.jet` declares `executable` — a `library`-kind package has no binary to containerize, and an undeclared name can't be confirmed either way." }
        fn fix(self) -> String { "Declare `{self.package}: executable` in `package.jet`, or point `from:` at an existing executable package." }
    }
}

struct RemoteOciNotSupported {
    impl Diagnostic {
        code :: "E1268"
        stage :: [.Jetpack]
        meaning :: "Remote OCI base or push needs a verified registry transport; local `file://` layouts are supported (U14)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`jet image <name>` cannot use remote OCI reference `<ref>`." }
        fn why(self) -> String { "Local OCI layouts are copied only after digest validation; remote registry transport is a separate trust boundary and is never faked." }
        fn fix(self) -> String { "Use `--push file:///path/to/layout`, or configure a verified registry transport." }
    }
}

struct InvalidOciField {
    impl Diagnostic {
        code :: "E1269"
        stage :: [.Jet]
        meaning :: "An `.Oci` image field (`kind`/`expose`/`env_vars`/`files`/`base`) isn't shaped the way an `.Oci` image spells it"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`<field>` isn't shaped like <expected>." }
        fn why(self) -> String { "An `.Oci` image's `kind`/`expose`/`env_vars`/`files`/`base` fields each have one fixed shape (a bare leading-dot value, a list of ports, a string-keyed map, a list of paths, `oci(\"<ref>\")`) — `Image` is a closed record, so a misshapen recognized field is rejected rather than silently ignored." }
        fn fix(self) -> String { "Rewrite the field to match its documented shape." }
    }
}

struct InvalidAdapter {
    impl Diagnostic {
        code :: "E1270"
        stage :: [.Jetpack]
        meaning :: "An ad-hoc adapter declaration/source/recipe is not shaped or realizable (U20)"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Check the `Pkg.adapt(...)` source and recipe."
        fn what(self) -> String { "Adapter package could not be realized." }
        fn why(self) -> String { "`Pkg.adapt(...)` turns source bytes into a normal package, so its string-valued `source:` must be a ref such as `\"./vendor/tool\"` and its recipe must be one of the supported U20 recipes: `Recipe.copy()`, `Recipe.prebuilt(bin:, as:)`, or finite `Recipe.build(steps: […])` actions (`.fetch`, `.exec`, `.install`, `.install_tree`). A `jetpack env` run reports this adapter-realization error." }
        fn fix(self) -> String { "Change `Pkg.adapt(...)` to use source `\"./vendor/tool\"` and a supported recipe such as `Recipe.copy()`, then rerun `jetpack env`." }
    }
}

struct UnlockedSourceChannel {
    name: String

    impl Diagnostic {
        code :: "E1271"
        stage :: [.Jetpack]
        meaning :: "A channel source ref (`#latest`/`#main`/`#vN.x`) is not locked, or cannot be resolved during `jetpack update` (U21)"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Run `jetpack update` with network or fixture metadata, then commit `.jet/lock`."
        fn what(self) -> String { "Source channel `{self.name}` is not locked / could not be resolved." }
        fn why(self) -> String { "Jet keeps tracking intent (`#latest`, `#main`, `#vN.x`) beside an exact lock entry. Build/run/env never re-resolve channels, and CI/offline may not invent a fresh exact source. A `jetpack update` run reports this package update error." }
        fn fix(self) -> String { "Run `jetpack update {self.name}` with network or fixture metadata, then commit `.jet/lock`." }
    }
}

