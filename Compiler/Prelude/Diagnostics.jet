        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "`{self.source}` was rejected: `{self.detail}`." }
        fn why(self) -> String { "Advisory policy is security-sensitive; Jet will not use unsigned, stale, rolled-back, forked, or downgraded evidence." }
        fn fix(self) -> String { "Refresh the signed offline feed and trust root, or repair the lock provenance before retrying." }
    }
}

struct MissingAuditInput {
