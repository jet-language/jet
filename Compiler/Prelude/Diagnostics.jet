        fix_safety :: .Formatting
        fn what(self) -> String { "`?T` and `!E` are retired prefix type marks." }
        fn why(self) -> String { "A type mark follows the type it marks: `Entry?` may be absent, and `SaveError!` in a function contract names how the call fails." }
        fn fix(self) -> String { "Write `Entry?` for `?Entry`, `SaveError!` for `!SaveError`, and `(A | B)!` for `!(A | B)`." }
    }
}

