        detail :: true
        no_fix :: .Behavior
        fix_next :: "Grant the required effect or change the source to stay within the declared authority."
        fn what(self) -> String { "`{self.dep}` uses the `{self.effect_name}` effect, which this package's budget doesn't allow." }
        fn why(self) -> String { "An `authority` budget fails the build when any dependency reaches an effect you didn't list; a denied `Panic` row names the stop site." }
        fn fix(self) -> String { "For an ordinary effect, add `{self.effect_name}` to `authority.allow` or grant it to `{self.dep}` in `authority.grants`; for deny-only `Panic`, return a fallible result or add facts/`#Pre`/refinement proof." }
    }
}

