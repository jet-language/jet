        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "`{self.kind}` `{self.name}` is not a statically known handler." }
        fn why(self) -> String { "Jet records every route and action on the typed application graph; a runtime-built handler outside `.mount` is an unanalyzed edge." }
