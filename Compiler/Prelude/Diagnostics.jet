        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`{self.type}` may declare only one `state {{ … }}` section" }
        fn why(self) -> String { "The state set is one erased fact row owned by the struct" }
        fn fix(self) -> String { "Merge the state names into one `state {{ … }}` section" }
    }
}

struct EmptyStateSection {
    type: String

    impl Diagnostic {
        code :: "E0169"
        meaning :: "Empty typestate state section"
        detail :: true
        fn what(self) -> String { "`{self.type}` has an empty `state {{ … }}` section" }
        fn why(self) -> String { "An empty state set cannot validate markers or provide a useful reflected fact" }
        fn fix(self) -> String { "Add at least one state name, or remove the section" }
