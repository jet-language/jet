ImpureCallInPureContext: struct {
    pure_fn: String
    call: String

    impl Diagnostic {
        code: "E3401"
        safety_class: .Soundness
        safety_reason: "A pure function's effect row is part of its type, so an impure call would break it."
        expert_path: "none: the function's row declares the effect"
        meaning: "Impure call inside a `fn … -[]>` / pure-eval context, or reached from comptime evaluation — call-trace path"
        detail: true
        fix_next: "Remove the call, drop the empty effect bound, or compute the value at runtime."

        what: fn(self) -> String { "`{self.pure_fn}` calls the impure function `{self.call}`." }

        why: fn(self) -> String {
            "A `fn … -[]>` may only call functions whose effect row is empty, declared or inferred, and pure builtins. Impure calls make the result non-deterministic. In `jet eval --pure` the whole call graph from `run` is checked transitively; the why-line shows the full chain (`run → a → b calls \\`print\\``) so the user can find the leak. Compile-time work (`#run` blocks and values) shares this same call-graph walk: the message reads `{self.call}` is not allowed in comptime code instead, since there is no enclosing `-[]>` function name to report."
        }

        fix: fn(self) -> String {
            "Remove the call from `{self.pure_fn}`, or drop the `-[]>` bound from `{self.pure_fn}` so its effects are inferred; at compile time, compute the value at runtime instead."
        }
    }
}

