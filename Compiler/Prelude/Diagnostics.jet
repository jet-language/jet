        fn what(self) -> String { "The workspace member path escapes the workspace root" }
        fn why(self) -> String { "Membership is rooted in the workspace, including the physical target behind a symlink." }
        fn fix(self) -> String { "Use a relative path below the workspace root and remove escaping symlinks." }
    }
}

struct NestedPackageMembers {
