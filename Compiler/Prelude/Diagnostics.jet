        no_fix :: .Behavior
        fix_next :: "Fix the dependency package's errors shown above."
        fn what(self) -> String { "Dependency package `{self.package}` has errors" }
        fn why(self) -> String { "A dependency package is checked as its own package; its errors, shown above, fail every package that imports it." }
        fn fix(self) -> String { "Fix the errors shown above; `jet check {self.root}` checks that package on its own." }
    }
}

struct CompileTimeReadsStartupValue {
    name: String

    impl Diagnostic {
        code :: "E0627"
        stage :: [.Comptime]
        meaning :: "Compile-time code reads a constant that is only computed at startup"
        fix_next :: "Read the startup constant at runtime, or make its value foldable."
        fn what(self) -> String { "This compile-time code reads `{self.name}`, which is only known at startup" }
        fn why(self) -> String { "`{self.name}` could not be folded while building (its value reads the outside world, or computing it failed), so the program computes it at startup, before `fn run`. Compile-time code runs while building, before that value exists." }
        fn fix(self) -> String { "Compute the value at runtime instead, or make `{self.name}` foldable: a pure expression that evaluates without failing." }
    }
}

struct ModuleFileItemMember {
    name: String
    member: String

    impl Diagnostic {
        code :: "E0628"
        meaning :: "`name.member` where `name` is the item a module takes from its file `name`"
        fix_next :: "Bring the file's other item in with its own `use` line."
        fn what(self) -> String { "`{self.name}` is the item this module takes from the file `{self.name}`, so `{self.name}.{self.member}` reaches nothing" }
        fn why(self) -> String { "`use {self.name}.{self.name}` gives the name `{self.name}` to the file's item; the file `{self.name}` is still reached at the start of a `use` path" }
        fn fix(self) -> String { "Bring the item in with `use {self.name}.{self.member}` and call `{self.member}` directly, or publish it too with `pub use {self.name}.{self.member}`." }
    }
}

struct ModuleAsValue {
    name: String

    impl Diagnostic {
        code :: "E0629"
        meaning :: "A module is used where a value is expected"
        fix_next :: "Use an item of the module instead of the module itself."
        fn what(self) -> String { "`{self.name}` is a module, not a value" }
        fn why(self) -> String { "A module groups declarations; it has no value to bind, pass, return, store or print." }
        fn fix(self) -> String { "Use one of its items instead, such as `{self.name}.item` or a call `{self.name}.function(…)`." }
    }
}

struct RetiredImportAlias {
    impl Diagnostic {
        code :: "E0630"
        stage :: [.Parse]
        status :: .Retired
        no_fix :: None
        fn what(self) -> String { "*Retired* (was: import `as` alias and `.{{…}}` member list teaching)" }
        fn why(self) -> String { "The registered parse rule applies here" }
        fn fix(self) -> String { "Follow the guidance for E0630" }
    }
}

struct ArenaViewEscapes {
    view: String
    escape: String
    arena: String

    impl Diagnostic {
        code :: "E0631"
        meaning :: "An arena `view` escapes its region — returned, stored, given away, or captured"
        detail :: true
        fn what(self) -> String { "`{self.view}` cannot be shared — it does not live long enough to {self.escape}." }
        fn why(self) -> String { "`{self.view}` is a view into `{self.arena}`; sharing it outside the region would let it outlive `{self.arena}` and point into freed memory." }
        fn fix(self) -> String { "Keep the view inside the arena's region, or copy what you need out with `.copy()` before it leaves." }
    }
}

struct ArenaViewAfterReset {
    arena: String
    view: String

    impl Diagnostic {
        code :: "E0632"
        meaning :: "An arena `view` is read after its arena was reset"
        detail :: true
        fn what(self) -> String { "`{self.arena}` was reset here, so the value `{self.view}` points into is gone." }
        fn why(self) -> String { "`reset` invalidates every value allocated in the arena; reading the view afterward would read reused memory." }
        fn fix(self) -> String { "Use the view before `reset`, or re-`alloc` after to get a fresh value." }
    }
}

struct IrreversibleNotAFact {
    family: String

    impl Diagnostic {
        code :: "E0633"
        stage :: [.Parse]
        meaning :: "An `impl Effect` block's `fn irreversible` body is not an effect fact"
        fn what(self) -> String { "This `fn irreversible` body is not an effect fact" }
        fn why(self) -> String { "The compiler reads `irreversible` without running it, so its body is `true`, `false`, `self == .Case` or an `||` of those, naming cases of `{self.family}`" }
        fn fix(self) -> String { "Write `{{ true }}`, `{{ false }}` or `{{ self == .Write }}`" }
    }
}

struct EffectCaseWithPayload {
    family: String
    member: String

    impl Diagnostic {
        code :: "E0634"
        stage :: [.Parse]
        meaning :: "An effect family case carries a payload"
        fn what(self) -> String { "The effect family case `{self.family}.{self.member}` carries a payload" }
        fn why(self) -> String { "An effect family's cases are effect names, which a row writes as `-[{self.family}.{self.member}]>`; a name carries no value" }
        fn fix(self) -> String { "Remove the payload from `{self.member}`" }
    }
}

struct MissingCrateVersion {
    impl Diagnostic {
        code :: "E0701"
        fn what(self) -> String { "Non-`std` `extern rust` crate missing `@version` pin" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Add an `@version` pin to the non-`std` `extern rust` crate." }
    }
}

struct FfiBoundaryTypeNotAllowed {
    subject: String
    reason: String
    fix_text: String

    impl Diagnostic {
        code :: "E0702"
        meaning :: "An FFI boundary rejects a type or capability outside its checked value/audited #Unsafe tiers"
        detail :: true
        fix_next :: "Use an FFI-safe scalar or capability type, or put the boundary in an audited #Unsafe region."
        fn what(self) -> String { "An FFI boundary rejects {self.subject}" }
        fn why(self) -> String { "{self.reason}" }
        fn fix(self) -> String { "{self.fix_text}" }
    }
}

struct MissingCargo {
    impl Diagnostic {
        code :: "E0703"
        stage :: [.Jet]
        no_fix :: .Behavior
        fn what(self) -> String { "`cargo` not installed (needed for `extern rust` crates)" }
        fn why(self) -> String { "The registered jet rule applies here. A `jet build` run reports this foreign-crate failure." }
        fn fix(self) -> String { "Install `cargo` or provide it on `PATH`." }
    }
}

struct ForeignCrateBuildFailed {
    impl Diagnostic {
        code :: "E0704"
        stage :: [.Jet]
        no_fix :: .Behavior
        fn what(self) -> String { "Foreign crate fetch/build failed (cargo detail indented)" }
        fn why(self) -> String { "The registered jet rule applies here. A `jet build` run reports this foreign-crate failure." }
        fn fix(self) -> String { "Inspect the cargo error, then fix the foreign crate and rerun the build." }
    }
}

struct ForeignSignatureMismatch {
    impl Diagnostic {
        code :: "E0705"
        stage :: [.Jet]
        no_fix :: .Behavior
        fn what(self) -> String { "`= \"rust::path\"` doesn't match the Jet signature" }
        fn why(self) -> String { "The registered jet rule applies here" }
        fn fix(self) -> String { "Make the Rust path and Jet signature agree." }
    }
}

struct EffectBoundExceeded {
    fn_name: String
    effect_name: String

    impl Diagnostic {
        code :: "E0740"
        meaning :: "A function's inferred effects exceed its declared `-[…]>` bound"
        detail :: true
        fn what(self) -> String { "`{self.fn_name}` uses the effect `{self.effect_name}`, which its signature doesn't allow." }
        fn why(self) -> String { "A `-[…]>` list is an upper bound on what the body may do; the inferred effects must be a subset. An effect the body reaches that the bound omits breaks that contract." }
        fn fix(self) -> String { "Add the named effect to the `-[…]>` list, or stop using it (drop the Core call that introduces it, or move it out of this function)." }
    }
}

struct RetiredFxSubsetCheck {
    impl Diagnostic {
        code :: "E0741"
        status :: .Retired
        meaning :: "Retired duplicate of the unified `#FX` check"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "*Retired* — the `#FX` subset check now reports E0712 for bare and named regions." }
        fn why(self) -> String { "Bare and named `#FX` regions use one authority check; E0741 is retained only as tombstone history." }
        fn fix(self) -> String { "Fix the E0712 diagnostic, then add the effect to the `#FX(…)` list or move the work outside the region." }
    }
}

struct ImplEffectBoundExceeded {
    method: String
    effect_name: String

    impl Diagnostic {
        code :: "E0742"
        meaning :: "A trait-method impl uses effects beyond the trait method's declared bound"
        detail :: true
        fn what(self) -> String { "This `{self.method}` impl uses the effect `{self.effect_name}`, which the trait doesn't allow." }
        fn why(self) -> String { "A trait method may declare an effect upper bound (`fn hash(self) -[]>`, `fn render(self) -[GPU]>`); every implementation's inferred effects must fit inside it, so the bound holds for all impls." }
        fn fix(self) -> String { "Remove the offending work from the impl, or widen the bound on the trait method." }
    }
}

struct MissingDynamicEffectBound {
    trait_name: String
    method: String

    impl Diagnostic {
        code :: "E0743"
        meaning :: "Dynamic trait dispatch has no declared effect bound under an enclosing effect ceiling"
        detail :: true
        fn what(self) -> String { "Dynamic call `{self.trait_name}::{self.method}` has no effect bound." }
        fn why(self) -> String { "A trait value can select any implementation at runtime, so an enclosing effect ceiling needs the trait method's declared upper bound." }
        fn fix(self) -> String { "Declare an effect row on the trait method, such as `-[]>` for pure dispatch, or move the dynamic call outside the bounded function." }
    }
}

struct AuthorityHandleEscapes {
    handle: String

    impl Diagnostic {
        code :: "E0711"
        meaning :: "The `Authority` handle bound by a named `#FX(…)` region escapes its scope — returned, stored, or captured"
        detail :: true
        fn what(self) -> String { "The `Authority` handle `{self.handle}` can't escape its `#FX` block." }
        fn why(self) -> String { "`#FX(…)` revokes the `Authority` at scope end (RAII); returning, storing, or capturing the handle would let revoked rights outlive the scope." }
        fn fix(self) -> String { "Use the handle only inside the `#FX` block, or perform the work that needs it there." }
    }
}

struct EffectWithoutAuthority {
    effect_name: String

    impl Diagnostic {
        code :: "E0712"
        meaning :: "An effect used inside a `#FX(…)` region has no authority — it isn't in the authority list"
        detail :: true
        fn what(self) -> String { "This `#FX` region uses the effect `{self.effect_name}`, which has no authority backing." }
        fn why(self) -> String { "`#FX(…)` allows exactly the listed effects; an effect reached inside — even transitively through a call — that the list omits has no authority backing it." }
        fn fix(self) -> String { "Add the named effect to the `#FX(…)` list, or move that work outside the region." }
    }
}

struct TaggedValueDenied {
    tag: String
    api: String

    impl Diagnostic {
        code :: "E0721"
        meaning :: "A tagged value reaches a destination denied by that tag declaration"
        detail :: true
        fix_next :: "Remove the destination use, correct its policy, or pass the value through an appropriate `#Scrub(Tag)`."
        fn what(self) -> String { "A `{self.tag}` value is denied at `{self.api}`." }
        fn why(self) -> String { "The declaration for `{self.tag}` lists a destination that covers `{self.api}`. The tag spreads with derived data until an exact-tag scrubber removes it." }
        fn fix(self) -> String { "Remove the destination use, change the declaration if its policy is wrong, or pass the value through `#Scrub({self.tag})`." }
    }
}

struct CredentialValueDenied {
    sink: String

    impl Diagnostic {
        code :: "E0722"
        meaning :: "A `#Credential` value reaches a log, display, or serialization destination"
        detail :: true
        fn what(self) -> String { "A `Credential` value is denied at `{self.sink}`." }
        fn why(self) -> String { "The Prelude `Credential` tag denies logging, display, and serialization destinations because they would leak a secret." }
        fn fix(self) -> String { "Log a non-secret field, or pass the value through a matching `#Scrub(Credential)` function." }
    }
}

struct ReplayableReachesAmbientEffect {
    fn_name: String
    effect_name: String

    impl Diagnostic {
        code :: "E0725"
        meaning :: "A `#Replayable` function reaches ambient `Time`/`Rand`/`Net`/`IO`"
        detail :: true
        fn what(self) -> String { "`{self.fn_name}` is `#Replayable` but reaches `{self.effect_name}`." }
        fn why(self) -> String { "`#Replayable` code must replay from explicit inputs; ambient time, randomness, network, or console IO would make the same replay diverge." }
        fn fix(self) -> String { "Inject a deterministic clock/RNG or mockable input, pass recorded data in, or move the ambient effect outside the replayable function." }
    }
}

struct TagUsedAsTrait {
    tag: String
    context: String

    impl Diagnostic {
        code :: "E0731"
        meaning :: "A `tag` is used where dispatch/methods are expected — `derive`d, or implemented/used as a trait"
        detail :: true
        fix_next :: "Declare the tag as a trait with the methods it should provide."
        fn what(self) -> String { "`{self.tag}` is a tag, but {self.context} needs a trait." }
        fn why(self) -> String { "A `tag` is a marker that erases at runtime and carries no methods; dispatch and method attachment need a `trait`." }
        fn fix(self) -> String { "Declare `{self.tag}` as a `trait` with the method(s) it should provide." }
    }
}

struct MethodInTag {
    tag: String
    method: String

    impl Diagnostic {
        code :: "E0732"
        meaning :: "A method is declared in a `tag` body, but tags have no methods"
        detail :: true
        fix_next :: "Make the tag a trait for method dispatch, or remove the method and keep it as a marker tag."
        fn what(self) -> String { "The tag `{self.tag}` declares a method `{self.method}`, but tags have no methods." }
        fn why(self) -> String { "A `tag` is a marker that erases at runtime; only a `trait` carries methods and dispatches." }
        fn fix(self) -> String { "Make `{self.tag}` a `trait` if `{self.method}` should dispatch, or remove the method to keep `{self.tag}` a marker tag." }
    }
}

struct UnknownTag {
    tag: String

    impl Diagnostic {
        code :: "E0733"
        meaning :: "A value tag does not name a declared `tag`, with a suggestion from declared tags"
        detail :: true
        edit :: .SuggestedSourceEdit
        no_fix :: None
        fix_safety :: .NeedsReview
        fn what(self) -> String { "There's no tag called `{self.tag}`." }
        fn why(self) -> String { "A value tag must name a declared `tag`; Prelude declares `Input`, `PII`, `Secret`, and `Credential`." }
        fn fix(self) -> String { "Declare it with `tag {self.tag} {{ deny: [Effect] }}`, check the spelling, or use the suggested tag." }
    }
}

struct InvalidTagPolicy {
    tag: String

    impl Diagnostic {
        code :: "E0734"
        stage :: [.Parse]
        meaning :: "A tag declaration has no policy body, lacks non-empty `deny`, repeats a field, or names an unknown body field"
        detail :: true
        no_fix :: .Ambiguous
        fix_next :: "Declare the tag with its deny list and optional source path."
        fn what(self) -> String { "Tag `{self.tag}` has an incomplete policy body." }
        fn why(self) -> String { "Every tag declares an enforceable policy with a required non-empty `deny` list and optional `from` list." }
        fn fix(self) -> String { "Write `tag {self.tag} {{ deny: [Effect], from: [source.path] }}`; omit `from` when it is not needed." }
    }
}

struct UnknownTagEndpoint {
    path: String

    impl Diagnostic {
        code :: "E0735"
        meaning :: "A tag `deny` or `from` entry does not name a known effect, sink, or source path"
        detail :: true
        edit :: .SuggestedSourceEdit
        no_fix :: None
        fix_safety :: .NeedsReview
        fn what(self) -> String { "`{self.path}` is not a known tag source or destination." }
        fn why(self) -> String { "`deny` entries name effects or registered sinks; `from` entries name effects or function paths." }
        fn fix(self) -> String { "Correct the path using the suggested effect, sink, or declared function." }
    }
}

struct ScrubSignatureMismatch {
    tag: String

    impl Diagnostic {
        code :: "E0736"
        meaning :: "`#Scrub(Tag)` does not consume that tagged type and return an untagged result"
        detail :: true
        fix_next :: "Accept a tagged parameter and return the untagged result."
        fn what(self) -> String { "`#Scrub({self.tag})` does not match this function signature." }
        fn why(self) -> String { "A scrubber removes exactly one tag, so it must consume a value carrying that tag and return a value without it." }
        fn fix(self) -> String { "Accept a `#{self.tag} T` parameter and return the untagged result." }
    }
}

struct RetiredPureWithEffects {
    impl Diagnostic {
        code :: "E0745"
        status :: .Retired
        meaning :: "*Retired* (was: `#Pure fn` combined with a non-empty `#(…)` effect list)"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "*Retired*" }
        fn why(self) -> String { "This code diagnosed the former contradiction between `#Pure fn` and a non-empty `#(…)` effect list. Both spellings are now rejected earlier by E0066." }
        fn fix(self) -> String { "Use one canonical effect arrow: `-[]>` for an empty row or `-[Effects]>` for a bounded row." }
    }
}

struct IrreversibleEffectInTransaction {
    api: String
    effect_name: String

    impl Diagnostic {
        code :: "E0746"
        meaning :: "An irreversible effect (Net/FS/Exec/FFI) used directly inside a `#Transact {{ … }}` block — can't be rolled back"
        detail :: true
        fn what(self) -> String { "`{self.api}` has the `{self.effect_name}` effect, which can't be rolled back inside a `#Transact` block." }
        fn why(self) -> String { "A `#Transact` block undoes its work on a `?`-failure; network, file, subprocess, and foreign effects leave external state a rollback can't take back unless the foreign binding declares a compensating undo." }
        fn fix(self) -> String { "Move the call after the block, register it with `<handle>.on_commit(() -> {{ … }})`, or declare `#Undo(inverse)` on the foreign binding." }
    }
}

struct AtomicInsideTransaction {
    impl Diagnostic {
        code :: "E0752"
        meaning :: "An `Atomic<T>` operation used inside a `#Transact {{ … }}` block, which has no commit for it"
        detail :: true
        fn what(self) -> String { "`Atomic` cannot be used inside `#Transact`" }
        fn why(self) -> String { "`Shared<T>` is the lock-guarded family for multi-value transactions; `Atomic<T>` is one lock-free scalar and has no transaction commit semantics" }
        fn fix(self) -> String { "Move the atomic operation outside `#Transact`, or use `Shared<T>` when several values must commit together" }
    }
}

struct CallbackEffectBoundExceeded {
    effect_name: String

    impl Diagnostic {
        code :: "E0747"
        meaning :: "A callback argument exceeds its parameter's effect bound (`fn(…) -[]>` / `fn(…) -[E]>`)"
        detail :: true
        fn what(self) -> String { "This callback uses the effect `{self.effect_name}`, which the parameter doesn't allow." }
        fn why(self) -> String { "A `fn(…) -[]>` parameter demands a pure callback, and a `fn(…) -[E]>` parameter bounds the callback to the listed effects; the actual callback's inferred effects must be a subset. The bound is checked at the call site, so an impure callback is rejected before it runs." }
        fn fix(self) -> String { "Pass a callback within the bound (a `fn … -[]>` for a pure parameter), or widen the parameter's effect bound." }
    }
}

struct InvalidViaParameter {
    param: String
    fn_name: String

    impl Diagnostic {
        code :: "E0748"
        meaning :: "`-[via f]>` names a non-existent parameter, or one that isn't a function type"
        detail :: true
        fn what(self) -> String { "`-[via {self.param}]>` on `{self.fn_name}` names no such parameter or a parameter that isn't a callback." }
        fn why(self) -> String { "`-[via f]>` publishes a function's effects as a tight pass-through of its callback parameter `f`; `f` must be a parameter of the function whose type is a `fn(…)`." }
        fn fix(self) -> String { "Point `via` at a function-typed parameter, or drop the `-[via …]>` annotation." }
    }
}

struct ProhibitedEffectReached {
    impl Diagnostic {
        code :: "E0749"
        fn what(self) -> String { "A function reaches an effect it prohibits with `-[!E]>` in its own call graph, including a denied `Panic` stop" }
        fn why(self) -> String { "The registered sema rule names the effect or panic site and keeps the three legal exits" }
        fn fix(self) -> String { "Remove the offending effect, return a fallible result, add facts or a `#Pre`/refinement proof, or drop the prohibition" }
    }
}

struct UnknownEffectLeaf {
    effect_name: String

    impl Diagnostic {
        code :: "E0750"
        meaning :: "An effect declaration lacks a leaf, or a dotted effect under a checked root is not a declared package-view leaf"
        detail :: true
        edit :: .SuggestedSourceEdit
        no_fix :: None
        fix_safety :: .NeedsReview
        fn what(self) -> String { "`{self.effect_name}` is not a declared effect leaf." }
        fn why(self) -> String { "This package view has declared leaves under the same root, so dotted effect names must match one of those declarations exactly." }
        fn fix(self) -> String { "Use the suggested declared leaf, add an `effect {self.effect_name}` declaration, or use the bare root." }
    }
}

struct WebBoundaryTypeNotAllowed {
    impl Diagnostic {
        code :: "E-WEB-ABI-TYPE"
        meaning :: "A JS/WASM boundary type is not ABI-safe"
        detail :: true
        fn what(self) -> String { "`Point` cannot cross the JS/WASM boundary on a `#WasmExport` parameter" }
        fn why(self) -> String { "Web exports and imports only admit ABI-safe types (scalars, `String`, `List`/`Map` of ABI-safe values, and `#Codable` structs/enums). A `jet build --target=web` run reports this web-target diagnostic." }
        fn fix(self) -> String { "Use a scalar, `String`, a `List`/`Map` of ABI-safe values, or a `#Codable` struct/enum whose fields are ABI-safe" }
    }
}

struct WebPartitionCrossed {
    impl Diagnostic {
        code :: "E-WEB-CROSS-PARTITION"
        meaning :: "A function in one web bucket calls a function in another"
        detail :: true
        fn what(self) -> String { "`wasm_caller` is compiled to Wasm but calls `js_helper`, which lives in JS" }
        fn why(self) -> String { "The web backend keeps DOM/view code in JS and compute in WASM; a direct call across that boundary is not allowed yet. A `jet build --target=web` run reports this web-target diagnostic." }
        fn fix(self) -> String { "Move the call behind a generated bridge, colocate both functions in the same bucket, or adjust their `#Target(Wasm|JS)` markers" }
    }
}

struct WasmFunctionUsesBrowser {
    impl Diagnostic {
        code :: "E-WEB-TARGET-BROWSER"
        meaning :: "A Wasm-pinned function also carries the `Browser` effect"
        detail :: true
        fn what(self) -> String { "`bad` is pinned to Wasm but uses the `Browser` effect" }
        fn why(self) -> String { "The web backend keeps DOM/view code in JS and compute in WASM; a Wasm-pinned function cannot call browser APIs directly. A `jet build --target=web` run reports this web-target diagnostic." }
        fn fix(self) -> String { "Remove the `#Target(Wasm)` pin, move browser work into a `#Target(JS)` function, or drop the browser API calls" }
    }
}

struct WebConstructNotSupported {
    fn_name: String

    impl Diagnostic {
        code :: "E-WEB-UNSUPPORTED"
        stage :: [.Driver]
        meaning :: "A web-targeted executable body uses a construct the web output cannot lower"
        detail :: true
        fn what(self) -> String { "Web output cannot compile `{self.fn_name}` yet." }
        fn why(self) -> String { "Web builds use the same checked executable body path as native builds; this function uses a construct the web output cannot lower today. A `jet build --target=web` run reports this web-target diagnostic." }
        fn fix(self) -> String { "Move the unsupported work behind a Wasm export that uses covered Jet constructs, or simplify this function for the web target." }
    }
}

struct WebProgramRunNotSupported {
    impl Diagnostic {
        code :: "E-WEB-RUN"
        stage :: [.Driver]
        moment :: .Run
        meaning :: "Native `jet run` cannot execute a web-targeted program"
        detail :: true
        fn what(self) -> String { "`jet run` cannot execute a web-targeted program natively" }
        fn why(self) -> String { "The web target produces browser artifacts, not a native console executable" }
        fn fix(self) -> String { "Use `jet dev <file.jet>` for the live browser loop, or `jet build --target=web <file.jet>` for web artifacts" }
    }
}

struct OsAndWebTargetConflict {
    os: String
    web: String
    item: String

    impl Diagnostic {
        code :: "E-OSTARGET-MIXED-AXIS"
        meaning :: "A `#Target(OS.*)`-gated impl's file/module also carries a web-bucket ceiling"
        detail :: true
        no_fix :: .Ambiguous
        fix_next :: "Choose one target axis and remove the conflicting target marker."
        fn what(self) -> String { "`#Target(OS.{self.os})` can't combine with `#Target({self.web})` on `{self.item}`." }
        fn why(self) -> String { "The OS axis (`OS.Linux`/`OS.MacOS`/`OS.Windows`, native platform gating) and the web axis (`Wasm`/`JS`/`Web`, the browser partition) are mutually exclusive — one item can't compile for both a specific native OS and a web bucket. During `jet check`, Jet reports this diagnostic." }
        fn fix(self) -> String { "Pick one axis: remove the `#Target(OS.{self.os})` marker or the web-axis marker." }
    }
}

struct OsGatedTypeUngatedUse {
    caller: String
    gated_type: String
    os: String

    impl Diagnostic {
        code :: "E-OSTARGET-UNMATCHED-CALL"
        meaning :: "A function/method not gated to match takes or returns a value of a `#Target(OS.*)`-gated type"
        detail :: true
        fix_next :: "Use the gated type only inside its matching OS target, or move the caller body there."
        fn what(self) -> String { "`{self.caller}` uses `{self.gated_type}`, whose `impl` is gated to `#Target(OS.{self.os})`, without itself being gated to match." }
        fn why(self) -> String { "An OS-gated impl only exists in the build for that OS; code reachable on other platforms would hit a missing method, so this is caught at compile time, not left to fail as a link error. During `jet check`, Jet reports this diagnostic." }
        fn fix(self) -> String { "Only use `{self.gated_type}` from inside an `impl` already gated to `#Target(OS.{self.os})`, or move `{self.caller}`'s body into one." }
    }
}

struct OsDispatchSubjectMismatch {
    impl Diagnostic {
        code :: "E-OSTARGET-BUILD-CONTEXT"
        meaning :: "A `comptime if … == {{ }}` OS dispatch's subject is not `$build.os`"
        detail :: true
        fn what(self) -> String { "A `comptime if … == {{ … }}` dispatch branches on `$build.os`." }
        fn why(self) -> String { "`$build.os` is the one compiler-known comptime value this dispatch folds on — it selects the arm matching the build's target OS at compile time." }
        fn fix(self) -> String { "Write `comptime if $build.os == {{ .Linux -> … .MacOS -> … .Windows -> … }}`, or use a plain runtime `if` for a value that isn't known at compile time." }
    }
}

struct InvalidOsDispatchArm {
    found: String

    impl Diagnostic {
        code :: "E-OSTARGET-DISPATCH-ARM"
        meaning :: "A `comptime if $build.os == {{ }}` arm head is not a bare `.Linux`/`.MacOS`/`.Windows` variant, or repeats one"
        detail :: true
        fn what(self) -> String { "`{self.found}` is not an OS arm — an `$build.os` dispatch matches `.Linux`, `.MacOS`, or `.Windows`." }
        fn why(self) -> String { "Each arm gates code for exactly one native OS, so its head is a bare, payload-free OS variant — the same set `#Target(OS.*)` uses — and each OS appears at most once." }
        fn fix(self) -> String { "Write `.Linux -> …`, `.MacOS -> …`, or `.Windows -> …` (add an `else -> …` for a shared fallback)." }
    }
}

struct NonExhaustiveOsDispatch {
    list: String

    impl Diagnostic {
        code :: "E-OSTARGET-DISPATCH-EXHAUSTIVE"
        meaning :: "A `comptime if $build.os == {{ }}` dispatch leaves some target OS uncovered with no `else`"
        detail :: true
        fix_next :: "Add one dispatch arm for each missing OS or add an `else` catch-all."
        fn what(self) -> String { "This `$build.os` dispatch doesn't cover every target OS — missing: {self.list}." }
        fn why(self) -> String { "A build can target any native OS, so the dispatch must handle each one — otherwise a build for a missing OS would have no arm to run." }
        fn fix(self) -> String { "Add an arm for each missing OS ({self.list}), or an `else -> …` catch-all." }
    }
}

struct ContextFieldWithEquals {
    impl Diagnostic {
        code :: "E0760"
        stage :: [.Parse]
        fn what(self) -> String { "`#Context` field uses `=` instead of `:`" }
        fn why(self) -> String { "The registered parser rule applies here" }
        fn fix(self) -> String { "Use `:` rather than `=` for a `#Context` field." }
    }
}

struct UnknownContextField {
    impl Diagnostic {
        code :: "E0761"
        stage :: [.Parse]
        no_fix :: .Ambiguous
        fn what(self) -> String { "Unknown `#Context` field name (v1 allows only `allocator`, `logger`, `deadline`)" }
        fn why(self) -> String { "The registered parser rule applies here" }
        fn fix(self) -> String { "Use only the supported `#Context` fields: `allocator`, `logger`, and `deadline`." }
    }
}

struct ContextFieldTypeMismatch {
