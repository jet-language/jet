        fn what(self) -> String { "The jetos CachyOS source recipe is missing." }
        fn why(self) -> String { "The first-party `cachyos-kernel` package must carry source-built recipe, builder, config, patch, and initrd-input provenance beside the boot artifacts." }
        fn fix(self) -> String { "Add `source/recipe.jet`, `source/build.sh`, `source/config`, `source/patches.manifest`, and `source/initrd-inputs.manifest` to the package output." }
    }
}

struct VmProofNotRun {
    impl Diagnostic {
        code :: "E1285"
        stage :: [.Jetpack]
        meaning :: "The VM install/reboot harness exists but no guest proof has run"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "The jetos VM guest proof has not run." }
        fn why(self) -> String { "JetOS requires `jet os vm prove` to record an actual installer boot, disk install, reboot, serial guest verification, and graphical desktop verification before claiming proof. A written harness is not proof, and a guest proof must match the host, generation, disk, media proof, tool hashes, and terminal/desktop/graphical guest assertions." }
        fn fix(self) -> String { "Inspect the VM run logs, fix the boot/install path, then rerun `jet os vm prove` to capture a guest proof marker." }
    }
}

struct KernelBuildFailed {
    impl Diagnostic {
        code :: "E1286"
        stage :: [.Jetpack]
        meaning :: "The first-party CachyOS kernel source recipe failed to build boot artifacts"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "The jetos CachyOS source build failed." }
        fn why(self) -> String { "Jet requires the first-party `cachyos-kernel` package to build boot artifacts from its recorded source recipe before VM/install proof can claim the selected `.CachyOS` kernel." }
        fn fix(self) -> String { "Check the first-party `cachyos-kernel` source recipe and rerun `jet os build`." }
    }
}

struct MissingInstalledDisk {
    impl Diagnostic {
        code :: "E1287"
        stage :: [.Jetpack]
        meaning :: "`jet os vm run` needs a proved installed disk"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Jetos VM run needs a proved installed disk." }
        fn why(self) -> String { "Jet keeps `jet os vm run` on the same proof-before-use path as `jet os vm prove`: an interactive VM may open only the latest generation's disk after a matching guest-passed proof binds host, generation, disk, media proof, tool hashes, and assertions." }
        fn fix(self) -> String { "Run `jet os vm prove <host> --disk <disk>` first, then rerun `jet os vm run`." }
    }
}

struct MissingDesktopPackage {
    impl Diagnostic {
        code :: "E1288"
        stage :: [.Jetpack]
        meaning :: "The GNOME desktop package is missing"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "The jetos GNOME desktop package is missing." }
        fn why(self) -> String { "Jet makes the default desktop profile GNOME-on-Wayland with terminal fallback, so the generation must include first-party `gdm`, `gnome-session`, and `gnome-shell` commands." }
        fn fix(self) -> String { "Declare first-party packages for `gdm`, `gnome-session`, and `gnome-shell`, or select a ratified non-GNOME desktop profile." }
    }
}

struct NixosImportFailed {
    impl Diagnostic {
        code :: "E1289"
        stage :: [.Jetpack]
        meaning :: "A NixOS import failed or would overwrite output"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Jetos could not import a NixOS configuration." }
        fn why(self) -> String { "JetOS imports semantic NixOS, flake-parts, and Home Manager facts into JetOS source and records unsupported facts in an audit report instead of pretending conversion was complete." }
        fn fix(self) -> String { "Pass a flake/root with `jetos-import-facts.json`, rerun with `--facts-only` for an audited scan draft, or choose a fresh `--out` path when writing." }
    }
}

struct UnknownJob {
    name: String

    impl Diagnostic {
        code :: "E1294"
        stage :: [.Jet]
        meaning :: "`jet run <entry> -- <name>` names no `#Job fn` in the entry"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "No job named `{self.name}`." }
        fn why(self) -> String { "`jet run <entry> -- <name>` only invokes `#Job fn`s." }
        fn fix(self) -> String { "Mark a function `#Job`, or check the spelling; the diagnostic lists declared jobs." }
    }
}

struct FakeVmTools {
    impl Diagnostic {
        code :: "E1290"
        stage :: [.Jetpack]
        meaning :: "Real JetOS replacement proof was requested with fake/script VM tools"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Jetos real VM proof needs real tools." }
        fn why(self) -> String { "Jet requires actual installed-guest behavior before JetOS can claim NixOS replacement readiness. Script fixtures and fake QEMU tools may test harness plumbing, but they cannot close replacement acceptance." }
        fn fix(self) -> String { "Rerun without `--real` for plumbing tests, or put real QEMU/image/media tools on PATH before claiming replacement proof." }
    }
}

struct UnmappedNixosOption {
    impl Diagnostic {
        code :: "E1291"
        stage :: [.Jetpack]
        meaning :: "A jetos real-tier system option/service/package has no NixOS mapping"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Jetos real tier could not map every system declaration to NixOS." }
        fn why(self) -> String { "JetOS generates a hidden NixOS backend from the checked `SystemPlan` and refuses to silently drop an option, service, or package it cannot translate — every unmapped declaration is listed together, before `nix` ever runs. A `jet os` run reports this JetOS mapping error." }
        fn fix(self) -> String { "Rename or drop the unmapped keys/packages/services, or map them to the nearest supported real-tier option (see the option/service/package mapping table for `--real`)." }
    }
}

struct MissingRandomness {
    impl Diagnostic {
        code :: "E1292"
        stage :: [.Jet]
        meaning :: "Signing key generation needs cryptographic randomness"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Jet could not create the package-signing key." }
        fn why(self) -> String { "The operating system could not provide cryptographic randomness." }
        fn fix(self) -> String { "Retry as a new operation on a supported host; no key files were created." }
    }
}

struct DeniedLint {
    name: String
    code: String
    what_text: String
    why_text: String
    fix_text: String

    impl Diagnostic {
        code :: "E1293"
        stage :: [.Jet]
        meaning :: "A lint denied by `package.jet` `policy.lints.deny` fired — build failure instead of a warning (the override law)"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Apply the underlying lint fix, or remove the lint from `policy.lints.deny`."
        fn what(self) -> String { "Lint `{self.name}` (`{self.code}`) is denied by policy: {self.what_text}" }
        fn why(self) -> String { "{self.why_text}. This team's `policy.lints.deny` in `package.jet` turns this warning into a build failure; it stays a warning everywhere `package.jet` doesn't opt in. The listed lint name matches." }
        fn fix(self) -> String { "Use the underlying lint fix ({self.fix_text}), or remove `{self.name}` from `policy.lints.deny` if this team no longer wants the wall." }
    }
}

struct UnknownGitRef {
    ref: String

    impl Diagnostic {
        code :: "E1295"
        stage :: [.Jetpack]
        meaning :: "`--affected-since <ref>` names a git ref that does not resolve"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Git ref `{self.ref}` not found." }
        fn why(self) -> String { "`--affected-since` diffs workspace member input hashes against a git baseline; that ref must resolve to a commit." }
        fn fix(self) -> String { "Pass a real branch, tag, or commit (a did-you-mean is offered when a close match exists)." }
    }
}

struct ForeignFilterSelector {
    flag: String

    impl Diagnostic {
        code :: "E1296"
        stage :: [.Jetpack]
        meaning :: "Pnpm-style `--filter` pattern DSL rejected — use `-p` / `--affected`"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`{self.flag}` is not a Jet workspace selector." }
        fn why(self) -> String { "Jet rejects pnpm-style `--filter` pattern DSLs; Jet scopes workspace commands with exact `-p <member>` and computed `--affected` / `--affected-since <ref>` only." }
        fn fix(self) -> String { "Use `-p <member>` (repeatable) or `--affected` / `--affected-since <ref>`." }
    }
}

struct ToolJobConflict {
    bin: String
    path: String

    impl Diagnostic {
        code :: "E1297"
        stage :: [.Jetpack]
        meaning :: "`jetpack tool install` bin name collides with a project `#Job fn` (JPK-TOOL-COLLIDE)"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`{self.bin}` is already a job in {self.path}" }
        fn why(self) -> String { "JPK-TOOL-COLLIDE: `jetpack tool install` would project `{self.bin}` onto `~/.jet/bin`, but this project already declares `#Job fn {self.bin}` — the project job wins here, so the global tool would be shadowed." }
        fn fix(self) -> String { "Install under a different bin name with `jetpack tool install <ref> --as <other>`, or use `jetpack use <ref> -- <command>`." }
    }
}

struct ToolProviderUnavailable {
    source: String

    impl Diagnostic {
        code :: "E1298"
        stage :: [.Jetpack]
        meaning :: "`jetpack tool` ref names an external provider with no hangar realization path yet (JPK-TOOL-PROVIDER)"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Use a built-in provider or a local path until the requested provider is supported."
        fn what(self) -> String { "Tool provider `{self.source}` isn't available yet" }
        fn why(self) -> String { "JPK-TOOL-PROVIDER: `jetpack tool` accepts external providers (`npm`, `pypi`, `cargo`, …) so the surface is discoverable, but that provider has no hangar realization path yet — Jet never silently skips. Built-ins that work today include `nixpkgs` and `github`; local paths are bare." }
        fn fix(self) -> String { "Use a built-in ref (`name@nixpkgs`, `owner/repo@github`) or a bare local path, or wait for the `{self.source}` provider to land." }
    }
}

struct ReservedStorePathComponent {
    path: String

    impl Diagnostic {
        code :: "E1299"
        stage :: [.Jetpack]
        meaning :: "Hangar Store v2 path law rejected a store path component (case-fold collision, reserved Windows name, trailing `.`/` `, absolute/dot components) (E4-JP1)"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Store path rejected: `{self.path}`" }
        fn why(self) -> String { "Hangar Store v2 path law (E4-JP1) records POSIX byte names and rejects Windows reserved names, trailing `.`/` ` aliases, `.`/`..`, and ASCII case-fold collisions among siblings. Unicode normalization is never applied implicitly." }
        fn fix(self) -> String { "Rename the entry to a portable store path with no reserved names, no trailing `.`/` `, and no case-fold collision with a sibling." }
    }
}

struct UnknownProfileFlag {
    impl Diagnostic {
        code :: "E1300"
        stage :: [.Jetpack]
        meaning :: "jetpack has no `--profile` flag"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "Jetpack has no `--profile` flag" }
        fn why(self) -> String { "Profile answers how hard to optimize a build; a named environment composition is a preset." }
        fn fix(self) -> String { "Select the composition with `--preset <name>`, declared under `presets:`." }
    }
}

struct HangarIngestFailed {
    impl Diagnostic {
        code :: "E1315"
        stage :: [.Jetpack]
        meaning :: "Hangar Store v2 ingest, reproducibility certification, or executable lease handoff aborted (source mutated during race-safe copy, unsupported special object/xattr, invalid lease service state, digest mismatch on verify, or divergent producer result) (E4-JP1, E4-JP18)"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Hangar ingest, executable lease handoff, or digest verification failed" }
        fn why(self) -> String { "Race-safe no-follow ingest re-stats open handles and aborts if the source mutates; the authenticated executable lease protocol rejects invalid keys, frames, owner locks, snapshots, and receipts before a child starts; verify re-hashes and compares the envelope digest; independent producer disagreement remains in `private/unreproducible/<action-key>.json` and cannot satisfy trusted cache policy." }
        fn fix(self) -> String { "Re-run realization or ingest against a stable tree; if the error names executable lease state, repair the lease service state and retry without deleting the last good Hangar object; inspect the structured reproducibility report and fix the nondeterminism." }
    }
}

struct AmbiguousPackageVariant {
    need: String
    candidates: String
    axis: String

    impl Diagnostic {
        code :: "E1316"
        stage :: [.Jetpack]
        meaning :: "Ambiguous or unmatched typed package variant selection (E4-JP15)"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Ambiguous package variants for need `{self.need}`: {self.candidates} (first distinguishing axis: {self.axis})" }
        fn why(self) -> String { "Matching is exact-then-compatible under one total order; an ambiguous tie is never a silent pick. Provider facts affect selection only through explicit `variant_map` entries." }
        fn fix(self) -> String { "Add a `variant_map`, pin one candidate, or make the need more specific on the named axis." }
    }
}

struct RetiredRefSpelling {
    impl Diagnostic {
        code :: "E1317"
        stage :: [.Jetpack]
        meaning :: "A direct CLI ref puts the provider first, uses a `path@` prefix, or names `@nixpkgs` as its source"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "A Jetpack CLI ref puts the provider first, uses a path-provider prefix, or names `@nixpkgs` as its source." }
        fn why(self) -> String { "Jet puts the package or upstream target before `@` and the source after it; Jetpack is public while retaining nixpkgs as lock and receipt provenance. A `jetpack env` run reports this provider-reference error." }
        fn fix(self) -> String { "Write `target@provider`, a bare local path, or rewrite `package@nixpkgs` exactly as `package@jetpack`." }
    }
}

struct EditionTooNew {
    impl Diagnostic {
        code :: "E2001"
        stage :: [.Jet]
        meaning :: "`package.jet` requests an edition this toolchain can't provide (E2-M2)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "This package needs a newer Jet." }
        fn why(self) -> String { "Editions opt a project into a specific era of Jet syntax. A newer edition can use syntax this compiler does not understand." }
        fn fix(self) -> String { "Upgrade with `jet self upgrade`, or set `edition: \"2026\"` in `package.jet`." }
    }
}

struct DeprecatedPastWindow {
    impl Diagnostic {
        code :: "E2002"
        stage :: [.Jet]
        meaning :: "A deprecated item is used past its migration window (E2-M2)"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .BehaviorPreserving
        fn what(self) -> String { "A deprecated item was used past its migration window." }
        fn why(self) -> String { "The item was deprecated in an earlier edition and no longer exists in this one; it has reached the end of its migration window." }
        fn fix(self) -> String { "Use the named replacement, or run `jet fix` to migrate automatically." }
    }
}

struct UnknownCommand {
    cmd: String
    group: String
    action: String
    args: String

    impl Diagnostic {
        code :: "E2101"
        stage :: [.Jet]
        meaning :: "Unknown or moved command spelling, with the canonical grouped spelling"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "Unknown CLI route. Moved bare form: `` `{self.cmd}` moved under `jet {self.group}` ``. Invalid nested form: `` `{self.action}` isn't a jet {self.group} command ``." }
        fn why(self) -> String { "Moved bare form: `infrequent commands live in a named area so daily Jet commands stay easy to scan`. Invalid nested form: `jet {self.group} accepts only commands in its named area`." }
        fn fix(self) -> String { "Moved bare form: ``run `jet {self.group} {self.cmd} {self.args}` ``. Invalid nested form: ``run `jet {self.group} help` ``. Human output renders these as Error/Why/Fix lines; JSON uses these exact message, why, and fix strings with control characters, quotes, and backslashes escaped." }
    }
}

struct UnknownFlag {
    flag: String
    closest: String

    impl Diagnostic {
        code :: "E2102"
        stage :: [.Jet]
        meaning :: "Unknown or ambiguous flag on the command line, with a suggestion (E2-M3)"
        detail :: true
        no_fix :: .Ambiguous
        fix_next :: "Use the suggested flag spelling or run `jet help` to select a supported flag."
        fn what(self) -> String { "`{self.flag}` isn't a flag jet understands." }
        fn why(self) -> String { "Jet ignores no flags silently, so a typo can't quietly change a build." }
        fn fix(self) -> String { "Did you mean `{self.closest}`? Run `jet help` to see the flags." }
    }
}

struct UnreadableCommandSchema {
    program: String

    impl Diagnostic {
        code :: "E2103"
        stage :: [.Jet]
        meaning :: "External completion could not read a verified JetCommandSchema record"
        detail :: true
        no_fix :: .Ambiguous
        fix_next :: "Rebuild the program with this Jet toolchain, then try again. Exits 1 (user error), not 2."
        fn what(self) -> String { "Couldn't read command metadata from `{self.program}`." }
        fn why(self) -> String { "The path has no safe command basename, contains a control character, could not be opened once as a regular file, exceeded the 512 MiB bounded read, is not ELF/PE/Mach-O/Wasm, or its JetCommandSchema record is missing, malformed, duplicated, unsupported, nested inside another universal Mach-O container, or inconsistent across universal Mach-O slices. Completion discovery never executes the program and never accepts unverified metadata. A `jet self completions` run reports this completion-metadata error." }
        fn fix(self) -> String { "Run `jet self completions` again after rebuilding `{self.program}` with this Jet toolchain." }
    }
}

struct InvalidCommandInput {
    problem: String

    impl Diagnostic {
        code :: "E2104"
        stage :: [.Jet]
        meaning :: "A command has missing, malformed, or conflicting input"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`{self.problem}`" }
        fn why(self) -> String { "Jet needs valid command input before it can run this command." }
        fn fix(self) -> String { "Correct the named argument or input, then run the command again." }
    }
}

struct DriverOperationFailed {
    problem: String

    impl Diagnostic {
        code :: "E2105"
        stage :: [.Jet]
        meaning :: "A driver file, tool, or operating-system operation failed"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`{self.problem}`" }
        fn why(self) -> String { "Jet could not complete the named file, tool, or operating-system operation." }
        fn fix(self) -> String { "Correct the named problem, then run the command again." }
    }
}

struct UnknownSyntaxToken {
    token: String
    closest: String

    impl Diagnostic {
        code :: "E2106"
        stage :: [.Jet]
        moment :: .Tool
        meaning :: "Unknown syntax token with a nearest registered spelling"
        detail :: true
        no_fix :: .Ambiguous
        fix_next :: "Use the suggested syntax spelling or run `jet explain` for the registered form."
        fn what(self) -> String { "`{self.token}` is not registered Jet syntax." }
        fn why(self) -> String { "syntax.rs is the one registry for user-typeable keywords, markers, operators, and sigils." }
        fn fix(self) -> String { "Did you mean `{self.closest}`? Run `jet explain {self.closest}`." }
    }
}

struct GcFailed {
    impl Diagnostic {
        code :: "E2110"
        stage :: [.Jet]
        meaning :: "Automatic GC or its trace failed safely (cards #658/#659)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Automatic memory management failed, or its trace cannot be reported." }
        fn why(self) -> String { "The private collector rejected an unsafe or impossible operation, or the trace is missing, unsafe to read, larger than 4 MiB, malformed, incompatible, stale, or incomplete. Reports never estimate promotions omitted by a bounded trace." }
        fn fix(self) -> String { "Check the trace path and retry with a smaller workload; for reports, run `jet run --gc-trace <file.jet>` before `jet gc report`. Exits 1 (user error)." }
    }
}

struct CollectedGraphEscapes {
    impl Diagnostic {
        code :: "E2111"
        meaning :: "Collector-owned graph escapes into an ownership-only function"
        detail :: true
        fn what(self) -> String { "A collector-owned graph cannot leave its scoped GC policy here." }
        fn why(self) -> String { "The callee returns hidden traced storage, but the receiving function is governed by ordinary ownership." }
        fn fix(self) -> String { "Add `#Policy(gc)` to the receiving function or convert the graph to ordinary ownership before the boundary." }
    }
}

struct InvalidMemoryLedger {
    detail: String

    impl Diagnostic {
        code :: "E2112"
        stage :: [.Jet]
        meaning :: "The cross-run memory witness ledger is missing, unsafe, oversized, malformed, or incompatible (card #1895)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Memory ledger cannot be used: {self.detail}." }
        fn why(self) -> String { "`jet audit memory` and `jet fix memory` read one bounded, append-only ledger of exercised GC and unsafe-sentry witnesses; they reject missing or unsafe evidence instead of guessing." }
        fn fix(self) -> String { "Run the relevant workload once to create the ledger, or repair the configured `.jet/memory/ledger-v1.jsonl` path, then retry." }
    }
}

struct PinnedBuildOption {
    option: String
    value: String

    impl Diagnostic {
        code :: "E2113"
        stage :: [.Jet]
        meaning :: "A build-option flag tries to change a value `fn build` pinned (#5005, D-SETTING-ORDER1)"
        detail :: true
        fn what(self) -> String { "`{self.option}` is pinned to `{self.value}`, so the flag can't change it." }
        fn why(self) -> String { "`b.pin(.option, .Value)` in `fn build` fixes a build option for every build; a flag may only change values that aren't pinned." }
        fn fix(self) -> String { "Remove the flag, or remove the pin in `fn build`." }
    }
}

struct CrashReportWithoutBuild {
    impl Diagnostic {
        code :: "E2114"
        stage :: [.Jet]
        meaning :: "`jet crash` read a report with no `Build <id>` line to find its debug info by (#6035, D-RT-DEFECT-REPORT1)"
        detail :: true
        fn what(self) -> String { "This crash report has no `Build <id> (names and lines: jet crash)` line." }
        fn why(self) -> String { "`jet crash` names a release program's frames from the debug info its build saved under the build id the report gives; without that line it can't tell which build crashed." }
        fn fix(self) -> String { "Pipe in the whole stderr of the crashed release program: `jet crash < report.txt`." }
    }
}

struct CrashSymbolsMissing {
    build: String

    impl Diagnostic {
        code :: "E2115"
        stage :: [.Jet]
        meaning :: "`jet crash` found no debug info for the report's build id under `.jet/symbols` (#6035, D-RT-DEFECT-REPORT1)"
        detail :: true
        fn what(self) -> String { "No debug info for build `{self.build}` is in `.jet/symbols` here or in a directory above." }
        fn why(self) -> String { "A release build saves its function names and lines under `.jet/symbols/.build-id/` in the project that built it; any other build, even of the same source, has another id." }
        fn fix(self) -> String { "Run `jet crash` in the project that built the crashed program, and keep its `.jet/symbols` with each release you ship." }
    }
}

struct RetiredDevPrescan {
    impl Diagnostic {
        code :: "E2201"
        stage :: [.Interp]
        status :: .Retired
        meaning :: "*Retired* (was: `jet dev` pre-scanned AST features and refused programs before the canonical evaluator ran)"
        no_fix :: None
        fn what(self) -> String { "*Retired* (was: `jet dev` can't interpret this program yet — it uses a feature outside the old source boundary)" }
        fn why(self) -> String { "The canonical evaluator owns the run and dev execution boundary; a source pre-scan could reject syntax the shared evaluator can execute." }
        fn fix(self) -> String { "Follow the guidance for E2201" }
    }
}

struct DevStepBudgetExhausted {
    impl Diagnostic {
        code :: "E2202"
        stage :: [.Interp]
        meaning :: "`jet dev` interpreter step budget exhausted — likely an unbounded loop (E2-M4)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "A program ran too long for `jet dev` to keep interpreting (the step budget was exhausted)." }
        fn why(self) -> String { "`jet dev` interprets your program; a run that never finishes is almost always a loop whose condition never becomes false." }
        fn fix(self) -> String { "Check the loop near the pointed-at line for a condition that never ends; `jet run` executes the real build with no step limit." }
    }
}

struct DebuggerUnavailable {
    detail: String

    impl Diagnostic {
        code :: "E2203"
        stage :: [.Tooling]
        meaning :: "The native `jet debug` backend could not debug or record this program: LLDB is missing or the native debug session failed"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`jet debug` could not run the native debugger: {self.detail}." }
        fn why(self) -> String { "`jet debug` steps, records, and replays the real compiled program through LLDB; without a working LLDB session there is nothing to step or record." }
        fn fix(self) -> String { "Install LLDB (the Jet dev shell provides it) and rerun `jet debug <file>`, or use `jet run <file>` to run the program without the debugger." }
    }
}

struct DebugSessionQuit {
    impl Diagnostic {
        code :: "E2204"
        stage :: [.Tooling]
        meaning :: "`jet debug` session ended early — the user typed `quit` at the `(jet)` prompt before the program finished"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "The `jet debug` session ended before the program finished — you typed `quit` at the `(jet)` prompt." }
        fn why(self) -> String { "Quitting the debugger stops the debugged program; it did not run to completion." }
        fn fix(self) -> String { "Run `jet debug <file>` again and use `continue` (or `c`) to run to the end, or `jet run <file>` to run it without the debugger." }
    }
}

struct DevTypeSurfaceChanged {
    impl Diagnostic {
        code :: "E2210"
        stage :: [.Interp]
        meaning :: "A `jet dev` edit changed a type surface, so the dev loop restarts instead of swapping (c77)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "This edit changed a type, so `jet dev` is restarting instead of swapping (the message names what changed — a struct field, an enum variant, or a function signature)." }
        fn why(self) -> String { "A hot swap re-applies code while the program's types stay the same; changing the shape of your data means the running code is rebuilt cleanly from the new types." }
        fn fix(self) -> String { "Nothing to fix — `jet dev` restarted with the new types; this note just explains why the swap became a restart. Type-stable edits (function bodies, statements) swap without a restart." }
    }
}

struct RetiredJitGap {
    impl Diagnostic {
        code :: "E2211"
        stage :: [.Interp]
        status :: .Retired
        meaning :: "*Retired* (was: resident Cranelift gap hard-stopped `jet run`)"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "*Retired* — was: Jet JIT has a compiler gap for this checked program." }
        fn why(self) -> String { "The JIT no longer exists; `jet run` builds the program through the normal build path and executes it." }
        fn fix(self) -> String { "Nothing to fix — `jet run` no longer has a JIT tier." }
    }
}

struct DeprecatedItem {
