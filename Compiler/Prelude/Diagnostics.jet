        fix_safety :: .BehaviorPreserving
        fn what(self) -> String { "This explicit semicolon is not part of canonical Jet syntax." }
        fn why(self) -> String { "Jet uses line boundaries for statements; the parser preserves this boundary so the same program can be repaired without changing behavior." }
        fn fix(self) -> String { "Replace the semicolon with a line break when code follows it, or remove it at the end of a line; `jet fmt` applies this fix." }
    }
}

struct RetiredComptimeKeyword {
