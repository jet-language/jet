        fn what(self) -> String { "`use core.*` import or emitted helper exceeds package `runtime:` ceiling" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Replace the `use core.*` import or helper with one below the package `runtime:` ceiling." }
    }
}

struct InvalidBitWidth {
