        detail :: true
        no_fix :: None
        fn what(self) -> String { "Package build failed at a logged step." }
        fn why(self) -> String { "Jetpack preserves the failed build scratch under the hangar and records each recipe step's command/output. The primary error names the failed step instead of dumping provider noise." }
        fn fix(self) -> String { "Run `jet logs <pkg>` for the full per-step log, or rerun the build with `--shell-on-fail` to debug inside the preserved scratch." }
    }
}

