// Every compiler diagnostic is a type here: a struct whose fields are the
// holes its texts read, and an impl of the Core `Diagnostic` trait. The
// constants carry the registry columns; `what`, `why` and `fix` are each one
// string literal reading only `self` fields. Retired and reserved codes stay
// so old logs remain explainable. `Tools/agent/DiagnosticRows.jet --write`
// renders these impls into the Foundation registry.

struct StrayCharacter {
    impl Diagnostic {
        code :: "E0001"
        stage :: [.Jet]
        no_fix :: .Behavior
        fn what(self) -> String { "Character/escape/lone brace means nothing here" }
        fn why(self) -> String { "The registered jet rule applies here" }
        fn fix(self) -> String { "Remove the stray character or complete the escape or brace." }
    }
}

struct UnterminatedText {
    impl Diagnostic {
        code :: "E0002"
        stage :: [.Jet]
        no_fix :: .Behavior
        fn what(self) -> String { "Unterminated text literal, interpolation, or block comment" }
        fn why(self) -> String { "The registered jet rule applies here" }
        fn fix(self) -> String { "Close the unterminated text literal, interpolation, or block comment; use {{{{ or }}}} for escaped braces, or a raw backtick string for literal text." }
    }
}

struct InvalidStatement {
    impl Diagnostic {
        code :: "E0003"
        stage :: [.Parse]
        meaning :: "Statement parse error; expected a current statement form"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .NeedsReview
        fn what(self) -> String { "Expected a current statement form, found an unsupported or incomplete form" }
        fn why(self) -> String { "This position accepts only a complete statement from Jet's current grammar" }
        fn fix(self) -> String { "Write the complete statement form named by the diagnostic" }
    }
}

struct RetiredStagedParameters {
    impl Diagnostic {
        code :: "E0004"
        stage :: [.Parse]
        status :: .Retired
        no_fix :: None
        fn what(self) -> String { "*Retired* (was: parameters staged)" }
        fn why(self) -> String { "The registered parse rule applies here" }
        fn fix(self) -> String { "Follow the guidance for E0004" }
    }
}

