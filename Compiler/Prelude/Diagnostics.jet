        fn what(self) -> String { "Unknown item in core module" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Use a declared item from the core module." }
    }
}

struct InvalidOverflowOptIn {
    impl Diagnostic {
        code :: "E1005"
        fn what(self) -> String { "Overflow opt-in not wrapping a single integer op or narrowing conversion" }
        fn why(self) -> String { "An overflow opt-in decides what one integer operation, or one conversion to a narrower fixed width, gives when the result doesn't fit; around anything else it would change nothing." }
        fn fix(self) -> String { "Apply the overflow opt-in to exactly one integer operation or narrowing conversion." }
    }
}

struct RuntimeCeilingExceeded {
