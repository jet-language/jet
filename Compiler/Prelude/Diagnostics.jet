        fn what(self) -> String { "A parameter with no default received no argument" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Provide an argument or a default for every required parameter." }
    }
}

struct LabelOnPositionalParameter {
    impl Diagnostic {
        code :: "E0767"
        fn what(self) -> String { "A label was written for a positional-only parameter, declared before `/`" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Pass positional-only parameters without labels." }
    }
}

struct PositionalAfterLabel {
    impl Diagnostic {
        code :: "E0768"
        fn what(self) -> String { "A bare argument follows a labelled one, so it names no parameter" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Place positional arguments before the first labelled argument." }
    }
}

struct LabelOnlyPassedByPosition {
    impl Diagnostic {
        code :: "E0769"
        fn what(self) -> String { "A label-only parameter, declared after `*`, was passed by position" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Pass the label-only parameter by name." }
    }
}

struct DuplicateParameterLabel {
    impl Diagnostic {
        code :: "E0770"
        stage :: [.Parse]
        fn what(self) -> String { "Two parameters publish the same call label, so the second could never be called" }
        fn why(self) -> String { "The registered parser rule applies here" }
        fn fix(self) -> String { "Give each parameter a unique public call label." }
    }
}

struct FunctionValueLabelMismatch {
    impl Diagnostic {
        code :: "E0771"
        fn what(self) -> String { "A function value's public call labels or parameter zones do not satisfy the expected function type" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Match the function value's call labels and parameter zones to the expected function type." }
    }
}

struct AmbiguousCall {
    callee: String
    rewrite: String

    impl Diagnostic {
        code :: "E0772"
        meaning :: "A call matches more than one callable body, so positional binding cannot choose safely"
        no_fix :: .Ambiguous
        fix_next :: "Name the arguments so the intended candidate is selected."
        fn what(self) -> String { "This call to {self.callee} matches more than one callable body" }
        fn why(self) -> String { "The call's bare arguments and labels bind to multiple candidate signatures, so named arguments are required to deconflict them" }
        fn fix(self) -> String { "Name the arguments to choose one candidate: {self.rewrite}" }
    }
}

struct LiveQueryFootprintConflict {
    key: String
    registered: String
    requested: String

    impl Diagnostic {
        code :: "E2473"
        stage :: [.Runtime]
        meaning :: "A live query key is already registered with a different dependency footprint"
        no_fix :: .Ambiguous
        fix_next :: "Use one dependency footprint per query key, or choose a new key."
        fn what(self) -> String { "Query key `{self.key}` already uses footprint `{self.registered}`; requested `{self.requested}`" }
        fn why(self) -> String { "An explicit key is the sole cache identity. Registering it with a second footprint would make invalidation ambiguous and split one logical query into multiple cache entries." }
        fn fix(self) -> String { "Use the existing footprint for `{self.key}`, or choose a new key for the new dependency declaration." }
    }
}

struct FormActionInputMismatch {
    action: String
    form: String

    impl Diagnostic {
        code :: "E2474"
        meaning :: "A form action does not accept the form's derived input type"
        fix_next :: "Change the action's first parameter to `{{form}}`."
        fn what(self) -> String { "Form action `{self.action}` does not accept `{self.form}`" }
        fn why(self) -> String { "The form derives its fields from `{self.form}` and the one server-function action boundary must receive that exact input type." }
        fn fix(self) -> String { "Change `{self.action}` to accept `{self.form}` as its first parameter." }
    }
}

struct UnknownTableColumn {
    column: String
    row: String

    impl Diagnostic {
        code :: "E2475"
        meaning :: "A typed table column names a row field that does not exist"
        fix_next :: "Rename the literal column name to an existing row field, or declare that field on the row struct."
        fn what(self) -> String { "Table column `{self.column}` is not a field on `{self.row}`" }
        fn why(self) -> String { "A typed table uses one row schema for sorting, filtering, and every renderer." }
        fn fix(self) -> String { "Rename the literal column name to an existing field on `{self.row}`, or declare `{self.column}` on the row struct." }
    }
}

struct LiveQueryNotTrackable {
    query: String

    impl Diagnostic {
        code :: "E2476"
        stage :: [.Runtime]
        meaning :: "A live query cannot be maintained for an untracked or ineligible query"
        fix_next :: "Use a tracked source and a replay-safe query plan."
        fn what(self) -> String { "Live query watch refused for `{self.query}`" }
        fn why(self) -> String { "The live-query contract requires a `data.track` source and rejects callbacks or plans whose effects or numeric laws cannot be replayed safely." }
        fn fix(self) -> String { "Use `data.track(rows, row -> key)` before `query(...).watch()`, and avoid effectful callbacks or unsafe Float reassociation." }
    }
}

struct Panic {
    msg: String

    impl Diagnostic {
        code :: "E3001"
        stage :: [.Runtime]
        meaning :: "Program-side runtime breach with Jet source location, function name, source-line context box, and (in debug builds) safe local values"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`panic: {self.msg}`" }
        fn why(self) -> String { "The program hit a `panic`, `assert`, or `assert_eq` call that failed, a bounds/key check triggered at runtime, or another program-side stop. The shared report boundary owns the program-side stop; an unhandled entry error is a returned report, not E3001. Jet file and line are shown in Jet terms (I2)." }
        fn fix(self) -> String { "Fix the logic that led to the failure. Program-side stops exit 70 through the shared boundary; unhandled entry errors print their report and exit 1; exit 101 is reserved for Jet defects." }
    }
}

struct FailureTrail {
    fn_name: String
    file: String
    line: String

    impl Diagnostic {
        code :: "E3002"
        stage :: [.Runtime]
        meaning :: "The trail of `?` hops a failed value took, printed under the root failure with consecutive repeats collapsed (E2-M12)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`Trail [E3002] (N hops via ?, origin first):` followed by one numbered `{self.fn_name} ({self.file}:{self.line})` line per hop, each with its note after an em dash and `×N` when the same hop repeats, and under it the hop's trimmed source line." }
        fn why(self) -> String { "Each failed `?` joins the failure's trail, so the report can show where the failure started and which callers forwarded it." }
        fn fix(self) -> String { "Read the root failure above the trail first — it says what went wrong. Then read the trail from hop 1, the origin, down to the last hop at the entry." }
    }
}

struct DeadlineExceeded {
    wait_kind: String

    impl Diagnostic {
        code :: "E3003"
        stage :: [.Runtime]
        meaning :: "Deadline exceeded at a wait/IO point while a `#Context(deadline: …)` budget is active"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`deadline exceeded while waiting in {self.wait_kind}`." }
        fn why(self) -> String { "A wait/IO point observed an active `#Context(deadline: …)` budget and the remaining time reached zero before the operation completed." }
        fn fix(self) -> String { "Raise the deadline budget, shorten the work before the wait point, or remove/adjust the ambient deadline for this scope." }
    }
}

struct ContractFailed {
    msg: String

    impl Diagnostic {
        code :: "E3005"
        stage :: [.Runtime]
        meaning :: "A `#Pre`/`#Post` contract clause failed — checked in every build, not a debug/release split"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`#{{Pre|Post}} contract failed: {self.msg}`" }
        fn why(self) -> String { "A `#Pre` (argument claim, checked at entry) or `#Post` (`result` claim, checked before return) condition evaluated false at runtime. `{self.msg}` is the clause's own message string. Checked in every build (not a debug/release split) — with file:line." }
        fn fix(self) -> String { "Fix the caller (a failed `#Pre` means an argument violated the function's stated contract) or the function body (a failed `#Post` means it broke its own promise about the result)." }
    }
}

struct ArithmeticOrBoundsFailure {
    msg: String

    impl Diagnostic {
        code :: "E3010"
        stage :: [.Runtime]
        meaning :: "An arithmetic or bounds operation has no valid result"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`{self.msg}`" }
        fn why(self) -> String { "The operands or position do not produce a valid result, so the safe runtime stops instead of returning corrupted data — with Jet file and line." }
        fn fix(self) -> String { "Check the operands or bounds before the operation, or use a checked operation that returns an outcome." }
    }
}

struct TodoReached {
    file: String
    line: String
    type: String

    impl Diagnostic {
        code :: "E3011"
        stage :: [.Runtime]
        meaning :: "A `#Todo` goal was reached at runtime"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`#Todo at {self.file}:{self.line} — expected {self.type}`" }
        fn why(self) -> String { "This code is deliberately incomplete and reached a running program." }
        fn fix(self) -> String { "Implement the missing code before running the program." }
    }
}

struct StackOverflow {
    fn_name: String

    impl Diagnostic {
        code :: "E3012"
        stage :: [.Runtime]
        meaning :: "Call depth exceeded Jet's safe runtime limit"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Stack overflow in `{self.fn_name}`" }
        fn why(self) -> String { "The call stack kept growing without reaching a safe return — with Jet file, line, and source context" }
        fn fix(self) -> String { "End the recursion or make progress toward a base case." }
    }
}

struct ParkedTasksAtExit {
    msg: String

    impl Diagnostic {
        code :: "E3013"
        stage :: [.Runtime]
        meaning :: "A task remained parked at the process exit boundary"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Parked tasks remain at process exit: {self.msg}" }
        fn why(self) -> String { "The scheduler reached process exit while one or more tasks were blocked on a wait target." }
        fn fix(self) -> String { "Join each task or make its wait reachable before process exit." }
    }
}

struct ForeignFunctionFailed {
    msg: String

    impl Diagnostic {
        code :: "E3014"
        stage :: [.Runtime]
        moment :: .Run
        meaning :: "A foreign function failed across a runtime boundary with Jet source location, function name, and source-line context"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`foreign function failed: {self.msg}`" }
        fn why(self) -> String { "The foreign implementation or its ABI boundary rejected the call, so Jet stopped instead of fabricating a result." }
        fn fix(self) -> String { "Fix the foreign function or handle its documented failure before calling it again." }
    }
}

struct UnhandledEntryFailure {
    msg: String

    impl Diagnostic {
        code :: "E3015"
        stage :: [.Runtime]
        moment :: .Run
        meaning :: "The entry returned a failed outcome that has no enclosing caller to handle it"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Entry returned an unhandled error: {self.msg}" }
        fn why(self) -> String { "The entry returned a failed outcome without a caller to handle it." }
        fn fix(self) -> String { "Handle the failed outcome before it reaches the entry, or fix the operation that returned the error." }
    }
}

struct MemoryOperationOutsideUnsafe {
