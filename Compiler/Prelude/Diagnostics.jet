struct DynAsCondition {
    impl Diagnostic {
        code :: "E0170"
        meaning :: "A range's written ends and step count in opposite directions"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .NeedsReview
        fn what(self) -> String { "This range counts the wrong way for its written ends" }
        fn why(self) -> String { "A range without a step counts up, and a step that moves away from the end runs the loop zero times" }
        fn fix(self) -> String { "Add the minus step (`10..1, -1`), flip the step's sign, or write the smaller end first" }
    }
}

