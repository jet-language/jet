        fn why(self) -> String { "A generated implementation has a clear local owner only when its derive provider or target type lives in the entry module. Two imported sides leave the entry package owning neither contract." }
        fn fix(self) -> String { "Define `derive T.{self.trait_name}` or `{self.type}` in the entry module." }
    }
}

