        detail :: true
        fn what(self) -> String { "This no-OS program allocates memory but has no allocator fact." }
        fn why(self) -> String { "No-OS targets do not provide an implicit system heap." }
        fn fix(self) -> String { "Select a typed allocator provider, or use heap-free Core operations." }
    }
}

struct SocketModuleNotOnTarget {
