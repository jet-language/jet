        detail :: true
        edit :: .Replace
        edit_from :: "="
        edit_to :: "::"
        no_fix :: None
        fix_safety :: .Formatting
        fn what(self) -> String { "This alias declaration uses the retired `=` binding." }
        fn why(self) -> String { "`::` defines a name; `=` fills a slot inside an existing declaration." }
        fn fix(self) -> String { "Replace `=` with `::`." }
    }
}

struct GuardAfterComma {
    impl Diagnostic {
