        code :: "E2393"
        stage :: [.Compile]
        meaning :: "Project import needs an owning project context"
        detail :: true
        fn what(self) -> String { "{self.import} needs an owning project context." }
        fn why(self) -> String { "Project-local imports are resolved from the nearest package or workspace graph; an isolated file has no declared project root to resolve them from." }
        fn fix(self) -> String { "Run jet check from the package or workspace, or replace the import with the canonical file-relative form when the dependency is local to this file." }
    }
}

struct PrivateFailureMemberExposed {
    function: String
    member: String

    impl Diagnostic {
        code :: "E2421"
        detail :: true
        edit :: .SuggestedSourceEdit
        no_fix :: None
        fix_safety :: .APIChanging
        fn what(self) -> String { "Public fallible function `{self.function}` exposes non-public failure carrier member `{self.member}`." }
        fn why(self) -> String { "The public failure contract makes `{self.member}` part of the callable's visible carrier, but its declaration is not public." }
        fn fix(self) -> String { "Remove `priv` from `{self.member}` or move it out of its `priv module`, or move `{self.function}` into a `priv module`." }
    }
}

struct NeverAsValue {
    impl Diagnostic {
        code :: "E2422"
        detail :: true
        fn what(self) -> String { "`Never` cannot be used in a value position." }
        fn why(self) -> String { "`Never` has no values; only a function return slot or function-type return slot may promise it." }
        fn fix(self) -> String { "Move `Never` to a function return type, or use `()`/another value type." }
    }
}

struct NeverFunctionReachesEnd {
    function: String

    impl Diagnostic {
        code :: "E2423"
        detail :: true
        fn what(self) -> String { "Function `{self.function}` promises `Never` but can reach the end." }
        fn why(self) -> String { "A declared `Never` return means every path must stop; this path falls through instead." }
        fn fix(self) -> String { "End every path with `panic`, a `Never` call, or another diverging operation, or remove `Never`." }
    }
}

struct NeverFunctionBareReturn {
    function: String

    impl Diagnostic {
        code :: "E2424"
        detail :: true
        fn what(self) -> String { "Function `{self.function}` promises `Never` but uses a bare `return`." }
        fn why(self) -> String { "A declared `Never` return cannot complete with an empty return; every path must diverge." }
        fn fix(self) -> String { "Remove the bare `return`, or make this function return a value type." }
    }
}

struct NeverFunctionReturnsValue {
    function: String

    impl Diagnostic {
        code :: "E2425"
        detail :: true
        fn what(self) -> String { "Function `{self.function}` promises `Never` but returns a value." }
        fn why(self) -> String { "A declared `Never` return has no success value." }
        fn fix(self) -> String { "Remove the value and diverge, or change the return type." }
    }
}

struct FunctionValueNotNever {
    impl Diagnostic {
        code :: "E2426"
        detail :: true
        fn what(self) -> String { "Function value does not satisfy `fn() Never`." }
        fn why(self) -> String { "`fn() Never` promises the callable never completes, so a returning function has the wrong contract." }
        fn fix(self) -> String { "Pass a function declared `Never`, or change the expected function type." }
    }
}

struct InferredNeverReturn {
