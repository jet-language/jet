struct InvalidEnumDiscriminant {
    impl Diagnostic {
        code :: "E0035"
        meaning :: "enum discriminant is not a computable integer"
        detail :: true
        fn what(self) -> String { "An enum discriminant must be known at compile time and fit the signed integer representation used by the enum layout." }
        fn why(self) -> String { "Use a literal, a same-file `@` binding, or another comptime expression that produces an in-range integer." }
        fn fix(self) -> String { "Use a literal, a same-file `@` binding, or another comptime expression that produces an in-range integer." }
    }
}

