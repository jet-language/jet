        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "The declared project environment could not be prepared for `{self.command}`: {self.reason}." }
        fn why(self) -> String { "Jet delegates project environment resolution and realization to the matching Jetpack engine before `{self.command}` runs; this delegation failed before the program started. A `jet run` run reports this environment-delegation error." }
        fn fix(self) -> String { "Resolve the Jetpack installation or environment problem, then retry `{self.command}`." }
    }
}

