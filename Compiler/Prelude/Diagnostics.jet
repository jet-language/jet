        fn what(self) -> String { "HTTP route method `{self.method}` belongs to a struct that is never mounted." }
        fn why(self) -> String { "Route markers record facts; only an explicit mux.mount(value) exposes that struct's routes." }
        fn fix(self) -> String { "Pass a value of `{self.type}` to mux.mount, or remove the route marker." }
    }
}

struct AppFeatureNotOnTarget {
