struct CoordinateSpaceMismatch {
    operation: String
    expected: String
    actual: String

    impl Diagnostic {
        code :: "E2520"
        meaning :: "A point or displacement is used with a value from another coordinate space"
        detail :: true
        fn what(self) -> String { "`{self.operation}` needs `{self.expected}` space, got `{self.actual}`." }
        fn why(self) -> String { "Coordinate-space tags are ordinary type facts; combining different spaces would make a numerically valid result mean the wrong thing." }
        fn fix(self) -> String { "Use a `{self.expected}` point or displacement, or convert it with a checked transform." }
    }
}

struct TransformCompositionMismatch {
    first: String
    second: String
    middle_a: String
    middle_b: String

    impl Diagnostic {
        code :: "E2521"
        meaning :: "Transform composition has incompatible middle spaces"
        detail :: true
        fn what(self) -> String { "Cannot compose `{self.first}` with `{self.second}`: `{self.middle_a}` does not match `{self.middle_b}`." }
        fn why(self) -> String { "A transform chain is valid only when the destination of the first transform is the source of the next one." }
        fn fix(self) -> String { "Reverse or replace one transform so both middle spaces are the same." }
    }
}

struct UnknownSecret {
    name: String

    impl Diagnostic {
        code :: "E1263"
        stage :: [.Jetpack]
        meaning :: "`jetpack secrets get <name>` names an entry that isn't in the encrypted store"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Set the secret entry first with `jetpack secrets set`, or check its name."
        fn what(self) -> String { "No secret named `{self.name}`." }
        fn why(self) -> String { "`jetpack secrets get {self.name}` decrypted the store (`.jet/secrets.age`) fine, but it has no entry called `{self.name}`." }
        fn fix(self) -> String { "Set it first with `jetpack secrets set {self.name} <value>`, or check the spelling." }
    }
}

struct SecretWithoutEffect {
    fn_name: String

    impl Diagnostic {
        code :: "E1264"
        meaning :: "A function reaches `core.crypto.vault.get` without declaring the `Secret` effect"
        detail :: true
        fix_next :: "Add `Secret` to the function effect ceiling before reading the vault."
        fn what(self) -> String { "`{self.fn_name}` reads a secret but doesn't declare the `Secret` effect." }
        fn why(self) -> String { "Reading a secret (`core.crypto.vault.get`) always requires an explicit grant — unlike every other effect, there is no silently inferred default. A bare `fn` with no `-[…]>` list, or one that omits `Secret`, is rejected even though the same function may infer other effects." }
        fn fix(self) -> String { "Add `-[Secret]>` to `{self.fn_name}`'s signature, or add `Secret` to its existing effect ceiling." }
    }
}

struct SecretAtBuildTime {
    impl Diagnostic {
        code :: "E1265"
        stage :: [.Comptime]
        meaning :: "`core.crypto.vault.get` reached from a build-time (comptime) context — secrets are never readable at build time"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`core.crypto.vault.get` can't be reached from a build-time context." }
        fn why(self) -> String { "Module-field and comptime evaluation run before secrets are decrypted. A repository opens its encrypted store only at ordinary runtime, such as inside a `-[Secret]>` function. There is no audited gate escape because a build artifact must never contain a decrypted secret." }
        fn fix(self) -> String { "Move the secret read out of comptime or module-field evaluation and into ordinary runtime code." }
    }
}

struct InvalidImageKind {
    impl Diagnostic {
        code :: "E1266"
