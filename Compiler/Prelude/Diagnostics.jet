        fn what(self) -> String { "Unknown analytics column `{self.column}`" }
        fn why(self) -> String { "`{self.column}` is not a field on the typed query row; DuckDB would fail at runtime, but Jet checks the schema at compile time" }
        fn fix(self) -> String { "Write one of the fields named by the row type" }
    }
}

struct UnprovenEntryResolution {
