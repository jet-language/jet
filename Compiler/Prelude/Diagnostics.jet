        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "This {self.role} has no accessible label" }
        fn why(self) -> String { "Screen readers announce a control by its accessible label; an empty label is invisible to assistive tech." }
        fn fix(self) -> String { "Pass a real label, e.g. `ui.node_role(\"Submit\", w, h, ui.aria_role_button())`." }
    }
}

struct DuplicateAccessibleLabel {
    label: String

