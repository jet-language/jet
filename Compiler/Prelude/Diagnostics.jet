        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Build sandboxing is required but unavailable." }
        fn why(self) -> String { "Jetpack permits non-executing reuse and trusted substitution, but a local executable action needs the native child boundary. Jetpack refuses to launch it when the platform cannot enforce that boundary. A `jet build` run reports this sandbox error." }
        fn fix(self) -> String { "Provide a trusted substitute or approved remote builder, or enable the native sandbox, then retry." }
    }
