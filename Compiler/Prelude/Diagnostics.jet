        fn what(self) -> String { "`#FFI(<lang>) fn` body is not one triple-quoted raw foreign-source string" }
        fn why(self) -> String { "The registered parse rule applies here" }
        fn fix(self) -> String { "Give the foreign function one triple-quoted raw foreign-source string body." }
    }
}

struct RetiredBodyMarker {
    impl Diagnostic {
        code :: "E0065"
        stage :: [.Parse]
        status :: .Retired
        meaning :: "Retired function body marker `::` or legacy `=`; named bodies use braces"
        detail :: true
        edit :: .Replace
        edit_from :: "::"
        edit_to :: "->"
        no_fix :: None
        fix_safety :: .Formatting
        fn what(self) -> String { "This function uses the retired `::` or legacy `=` body marker." }
        fn why(self) -> String { "Named function bodies use braces. `::` binds a name, and `=` fills a slot inside a definition." }
        fn fix(self) -> String { "Replace the marker with `{{ … }}`; `jet fmt` applies this fix." }
    }
}

struct RetiredEffectArrow {
    impl Diagnostic {
        code :: "E0066"
        stage :: [.Parse]
        status :: .Retired
        meaning :: "Retired function effect syntax; use `-[Effects]>` or `-[]>`"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "This function uses the retired effect-arrow spelling." }
        fn why(self) -> String { "Callable results use `->`, and an explicit effect ceiling uses the same unified arrow." }
        fn fix(self) -> String { "Replace it with `-[Effects]>`, or write `-[]>` for an empty effect ceiling." }
    }
}

struct ReservedDunderName {
    impl Diagnostic {
        code :: "E0067"
        stage :: [.Lex]
        status :: .Reserved
        no_fix :: None
        fn what(self) -> String { "Source-written `__name` is reserved for Jet and generated tooling; visible machine names use `__jet_`" }
        fn why(self) -> String { "The registered lex rule applies here" }
        fn fix(self) -> String { "Follow the guidance for E0067" }
    }
}

struct RetiredResultShape {
    impl Diagnostic {
        code :: "E0068"
        stage :: [.Parse]
        status :: .Retired
        meaning :: "Retired callable result shape; put the return type after the one arrow"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "This callable puts the return type before the arrow." }
        fn why(self) -> String { "A return type follows the one arrow: `fn name(...) -> Type {{ … }}`. An effect ceiling splits that arrow: `fn name(...) -[Effects]> Type {{ … }}`." }
        fn fix(self) -> String { "Write `fn name(...) -> Type {{ … }}`, or `fn name(...) -[Effects]> Type {{ … }}`." }
    }
}

struct RetiredArrow {
    impl Diagnostic {
        code :: "E0070"
        stage :: [.Parse]
        status :: .Retired
        meaning :: "A callable, arm, or lambda uses a retired arrow, or a stray `:>` has no opening fence; use `->`"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .Formatting
        fn what(self) -> String { "This callable, arm, or lambda uses a retired `=>` arrow, or a `:>` that closes no `<:` fence." }
        fn why(self) -> String { "All arrow positions use `->`; `:>` only closes a `<: … :>` fence." }
        fn fix(self) -> String { "Replace the retired arrow with `->`, or add the missing `<:`. For an effect ceiling, write `-[Effects]>`." }
    }
}

struct RetiredEffectResultArrow {
    impl Diagnostic {
        code :: "E0071"
        stage :: [.Parse, .Sema]
        status :: .Retired
        meaning :: "Retired effect-only result-arrow teaching (D-ONELINE-BODY1=B; was D-ARROW-CONTROL1)"
        no_fix :: None
        fn what(self) -> String { "This retired effect-only result-arrow diagnostic is no longer emitted." }
        fn why(self) -> String { "Effect-only one-line bodies use `->` for one statement; braces hold multiple statements or a scope." }
        fn fix(self) -> String { "Follow the current one-line body rule" }
    }
}

struct CollectingLoopNotFinite {
    impl Diagnostic {
        code :: "E0072"
        meaning :: "A non-finite collecting loop uses a collection arrow"
        detail :: true
        fn what(self) -> String { "This collecting loop cannot return a List because it has no finite exhaustion edge." }
        fn why(self) -> String { "A collecting loop must finish after a statically finite source or C-style condition. Bare infinite and condition-only loops do not provide that boundary." }
        fn fix(self) -> String { "Remove `->`, or iterate a finite source. Return one final value from an ordinary loop with `break value`." }
    }
}

struct CollectingLoopMissingItem {
    impl Diagnostic {
        code :: "E0073"
        meaning :: "A collecting loop path produces no item or `()`"
        detail :: true
        fn what(self) -> String { "This collecting loop path produces no item." }
        fn why(self) -> String { "Every accepted iteration must contribute one non-unit value unless `next` explicitly omits it." }
        fn fix(self) -> String { "Return a value on this path, or use `next` to omit the item. Remove `->` if the loop only performs effects." }
    }
}

struct CollectingLoopItemMismatch {
    impl Diagnostic {
        code :: "E0074"
        meaning :: "Collecting loop item types do not agree"
        detail :: true
        fn what(self) -> String { "This collecting loop produces incompatible item types." }
        fn why(self) -> String { "One collecting loop builds one `[T]`, so every contributed item must have the same type." }
        fn fix(self) -> String { "Convert the items to one type, or split the operations into separate loops." }
    }
}

struct CollectingLoopBreakPayload {
    impl Diagnostic {
        code :: "E0075"
        meaning :: "A collecting loop uses a break payload instead of its List result"
        detail :: true
        fn what(self) -> String { "This collecting loop cannot use a break payload." }
        fn why(self) -> String { "Its result is already the accumulated `[T]`. A second payload would give the same exit two result channels." }
        fn fix(self) -> String { "Write `break` to return the accumulated list, or return one final value from an ordinary loop." }
    }
}

struct LoopResultMismatch {
    impl Diagnostic {
        code :: "E0076"
        meaning :: "Ordinary-loop exits omit a result or use incompatible payload types"
        detail :: true
        fn what(self) -> String { "This result loop has a missing or incompatible break payload." }
        fn why(self) -> String { "An ordinary loop used as a value has one final result type. Every exit that targets it must provide that type." }
        fn fix(self) -> String { "Add the missing payload and make every payload the same type, or target an inner effect-only loop." }
    }
}

struct RetiredGrantMarker {
