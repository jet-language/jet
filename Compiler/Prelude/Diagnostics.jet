    impl Diagnostic {
        code :: "E2806"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "Convention file `{self.path}` has no `fn page`." }
        fn why(self) -> String { "Files under a `.routes(from:)` root must declare `fn page` or start with `_` to opt out. A file without a page would register an endpoint the compiler cannot analyze." }
        fn fix(self) -> String { "Add `fn page()`, rename the file with a leading `_`, or remove it from the routes directory." }
    }
}

struct DuplicateRoute {
