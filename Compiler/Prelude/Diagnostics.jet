        fix_next :: "Correct the header path or install the development headers, then inspect the binding if needed."
        fn what(self) -> String { "Could not generate bindings from `{self.header}`." }
        fn why(self) -> String { "{self.reason}" }
        fn fix(self) -> String { "Fix the header path, install dev headers, run `jet inspect bind` manually for details, or hand-write `#Import module c.{self.lib}`." }
    }
}

struct ComWithoutWindows {
    impl Diagnostic {
        code :: "E3260"
        stage :: [.Load]
        meaning :: "`com.*` or COM binding requested away from a Windows host"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`com.*` needs a Windows host." }
        fn why(self) -> String { "COM type libraries, apartments, the registry, and IDispatch are Windows facilities." }
        fn fix(self) -> String { "Generate, build, and run the COM module on a Windows host; use a non-COM boundary for other targets." }
    }
}

struct InvalidCImportBody {
    impl Diagnostic {
        code :: "E3261"
        stage :: [.Parse]
        meaning :: "`#Import(c)` function uses a non-canonical body marker"
        detail :: true
        fn what(self) -> String { "`#Import(c)` functions must name their C symbol with `= \"symbol\"`." }
        fn why(self) -> String { "`#Import(c)` binds a compile-time C symbol; `->` is a Jet function-body marker and cannot declare a foreign symbol." }
        fn fix(self) -> String { "Write `#Import(c) fn name(args) -> Return = \"symbol\"`." }
    }
}

struct CLibraryNotLinked {
    lib: String

    impl Diagnostic {
        code :: "E3209"
        stage :: [.Jet]
        meaning :: "Linker couldn't find a declared C library at link time"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Declare the library in `deps:` with a supported system or nixpkgs provider, or install it."
        fn what(self) -> String { "The linker couldn't find C library `{self.lib}`." }
        fn why(self) -> String { "Your program links against `{self.lib}`, but the linker reported `cannot find -l{self.lib}` — the library isn't on the link search path. A `jet build` run reports this C boundary or linker diagnostic." }
        fn fix(self) -> String { "Declare it in `deps:` so Jet provisions it: `{self.lib}: c@system` (host pkg-config, else fetched from nixpkgs), or `{self.lib}: c@nixpkgs:<attr>` to pick the nixpkgs attribute, or install the system package." }
    }
}

struct CLibraryProvisionFailed {
    lib: String
    attr: String
    reason: String

    impl Diagnostic {
        code :: "E3210"
        stage :: [.Jet]
        meaning :: "C library auto-provision from nixpkgs failed"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Choose an existing nixpkgs attribute or a local C library path, then declare the provider."
        fn what(self) -> String { "Couldn't fetch C library `{self.lib}` from nixpkgs." }
        fn why(self) -> String { "`{self.lib}: c@system` asked Jet to provision `nixpkgs#{self.attr}`, but `nix build` failed: `{self.reason}`." }
        fn fix(self) -> String { "Check the attr exists (`nix build nixpkgs#{self.attr}`), or point at a local build with `{self.lib}: c@\"<path>\"`, or install it and use `system`." }
    }
}

struct InteriorNulByte {
    impl Diagnostic {
        code :: "E3211"
        meaning :: "String literal with a known interior NUL byte passed to a C-boundary function"
        detail :: true
        fn what(self) -> String { "This string literal has an embedded NUL byte, so it can't cross into a C function." }
        fn why(self) -> String { "C strings are NUL-terminated, not length-prefixed — an embedded `\\0` would truncate the string on the C side, silently losing everything after it." }
        fn fix(self) -> String { "Remove the embedded NUL, or split the call so the C function only sees the part before it." }
    }
}

struct UnknownCallingConvention {
    abi: String

    impl Diagnostic {
        code :: "E3212"
        stage :: [.Parse, .Sema]
        meaning :: "`#ABI` on `extern rust` (Rust FFI has no C calling convention to pick), or `#ABI(name)` names an unknown C calling convention"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`{self.abi}` is not a known C calling convention." }
        fn why(self) -> String { "`#ABI` accepts only the ratified native ABI names — `#ABI` also never applies to `extern rust` (Rust FFI keeps its own declared ABI)." }
        fn fix(self) -> String { "Use `system`, `cdecl`, `stdcall`, `fastcall`, `win64`, or `sysv64`, or remove `#ABI` from the `extern rust` function." }
    }
}

struct CallingConventionNotOnTarget {
    abi: String

    impl Diagnostic {
        code :: "E3213"
        meaning :: "Named C calling convention exists but isn't available on this target's OS/architecture"
        detail :: true
        fn what(self) -> String { "`{self.abi}` is not available on this target." }
        fn why(self) -> String { "Native calling conventions are restricted by operating system and architecture (e.g. `stdcall`/`cdecl`/`fastcall` are Windows x86 only; `win64` is Windows x86-64; `sysv64` is non-Windows x86-64)." }
        fn fix(self) -> String { "Use the default C ABI or `system` for portable declarations." }
    }
}

struct VariadicCallingConvention {
    name: String
    abi: String

    impl Diagnostic {
        code :: "E3214"
        meaning :: "Variadic C function used with a calling convention other than the default C ABI (or `cdecl` on Windows x86)"
        detail :: true
        fn what(self) -> String { "Variadic C function `{self.name}` cannot use `{self.abi}`." }
        fn why(self) -> String { "Variadics allow only the default C ABI, or `cdecl` on Windows x86 — other calling conventions don't define how a variadic argument list is passed." }
        fn fix(self) -> String { "Remove `#ABI`, or use `#ABI(cdecl)` on Windows x86." }
    }
}

struct InlineForeignOutsideUnsafe {
    impl Diagnostic {
        code :: "E3215"
        fn what(self) -> String { "`#FFI(<lang>)` inline foreign fn in an unsafe language (`c`/`cpp`/`asm`) lacks the enclosing `#Unsafe(\"reason\")` gate" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Wrap inline foreign code in an enclosing `#Unsafe(\"reason\")` gate." }
    }
}

struct InvalidForeignBoundaryEvidence {
    subject: String
    reason: String
    fix_text: String

    impl Diagnostic {
        code :: "E3216"
        meaning :: "Foreign boundary or callback evidence is incomplete or inconsistent"
        fix_next :: "Regenerate the binding or correct the generated declaration."
        fn what(self) -> String { "Foreign boundary evidence is invalid for {self.subject}." }
        fn why(self) -> String { "{self.reason}." }
        fn fix(self) -> String { "{self.fix_text}." }
    }
}

struct UnsupportedForeignLanguage {
    impl Diagnostic {
        code :: "E3220"
        fn what(self) -> String { "`#FFI(<lang>)` names a language with no inline foreign binder yet (systems floor ships `c`/`cpp`/`asm`, card #501)" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Use an inline foreign binder for `c`, `cpp`, or `asm`, or remove the unsupported language." }
    }
}

struct InlineForeignBuildFailed {
    impl Diagnostic {
        code :: "E3222"
        stage :: [.Sema, .Build]
        meaning :: "Inline foreign bridge compilation or linking failed, or inline asm uses an unsupported scalar signature; stable foreign-tool detail is retained without guessing a declaration"
        detail :: true
        fn what(self) -> String { "Inline foreign bridge compilation or linking failed, or inline asm uses an unsupported scalar signature." }
        fn why(self) -> String { "The foreign diagnostic may not identify a Jet declaration; rejection of a generated adapter is a compiler defect, not proof of a user signature mismatch." }
        fn fix(self) -> String { "Inspect the foreign diagnostic and correct the inline body or bridge; use a supported scalar signature." }
    }
}

struct AsmOperandMismatch {
    impl Diagnostic {
        code :: "E3223"
        no_fix :: .Ambiguous
        fn what(self) -> String { "Inline asm operands do not match the Jet signature: missing/unknown named input, duplicate or missing `; -> return`, or unaudited clobber/target register" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Make the asm operands, return marker, clobbers, and target registers match the Jet signature." }
    }
}

struct OsApiOnNoOsTarget {
    api: String

    impl Diagnostic {
        code :: "E3301"
        meaning :: "OS-dependent API called on a selected no-OS target"
        detail :: true
        fn what(self) -> String { "`{self.api}` is not available on a no-OS target." }
        fn why(self) -> String { "No-OS targets have no OS; only `core`-level APIs are available." }
        fn fix(self) -> String { "Embed the data at compile time with `@embed(\"file\")`, or select a hosted target." }
    }
}

struct UnknownTarget {
