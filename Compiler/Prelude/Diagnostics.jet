        fn what(self) -> String { "`impl Point.Hash` names no trait" }
        fn why(self) -> String { "An `impl Type.Trait` block implements a trait the program declares or imports, or one the compiler owns; no trait named `Hash` is in scope here." }
        fn fix(self) -> String { "Declare or import `trait Hash`, correct the trait name, or write `impl Point {{` for methods of `Point` alone." }
    }
}

