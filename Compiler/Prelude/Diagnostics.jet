struct TypestateWrongState {
    op: String
    type: String
    required: String
    value: String
    current: String

    impl Diagnostic {
        code :: "E0150"
        meaning :: "Typestate: an operation is called on a value in the wrong state"
        detail :: true
        fix_next :: "Transition the value into the required state before using it."
        fn what(self) -> String { "`{self.op}` needs `{self.type}` in state `{self.required}`, but `{self.value}` is in state `{self.current}`." }
        fn why(self) -> String { "Typestate: an operation is valid only in a given state; calling it out of order is the bug typestate prevents." }
        fn fix(self) -> String { "Transition the value into `{self.required}` first — call the transition that reaches it (e.g. `pay` to reach `Confirmed`)." }
    }
}

struct TypestateUnknownState {
    state: String
    type: String

    impl Diagnostic {
        code :: "E0151"
        meaning :: "Typestate: `#State(X)` or `#Transition(A, B)` references a state not in the owning `state {{ … }}` section"
        detail :: true
        edit :: .SuggestedSourceEdit
        no_fix :: None
        fix_safety :: .NeedsReview
        fn what(self) -> String { "`{self.state}` is not a declared state of `{self.type}`." }
        fn why(self) -> String { "Typestate: `struct {self.type} {{ state {{ … }} }}` defines the valid state labels; a name not in that set is likely a typo — a phantom state no transition can reach." }
        fn fix(self) -> String { "Correct the spelling, or add `{self.state}` inside `struct {self.type} {{ state {{ … }} }}`." }
    }
}

struct InvalidRegexLiteral {
    impl Diagnostic {
        code :: "E0152"
        fn what(self) -> String { "A bare `String`, interpolated pattern, or invalid pattern is used as a typed `Regex` literal" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Use a valid typed `Regex` literal without interpolation." }
    }
}

struct ProtocolExpansionFailed {
    name: String

    impl Diagnostic {
        code :: "E0153"
        meaning :: "protocol expansion failed to parse a generated handle fragment"
        detail :: true
        fix_next :: "Check the protocol declaration for typos; if this persists, file a bug."
        fn what(self) -> String { "Protocol `{self.name}` failed to expand into handle types." }
        fn why(self) -> String { "protocol/session types: the compiler generates `#SingleUse` `.Client`/`.Server` stubs from the `protocol` block — a generated fragment did not parse." }
        fn fix(self) -> String { "Correct the `protocol {self.name}` declaration, then run `jet check`; report the generated handle fragment if it still fails." }
    }
}

struct RetiredIncrement {
    impl Diagnostic {
        code :: "E0160"
        stage :: [.Parse]
        status :: .Retired
        meaning :: "Retired `++`/`--`; write `x += 1` / `x -= 1`"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .BehaviorPreserving
        fn what(self) -> String { "`++` and `--` are not Jet operators." }
        fn why(self) -> String { "Jet updates a number with compound assignment only; an update hidden inside an expression reads one value and stores another." }
        fn fix(self) -> String { "Write `x += 1` or `x -= 1` as its own statement; inside an expression, move the update into its own statement before or after the use." }
    }
}

struct RetiredIncrementImmutable {
    impl Diagnostic {
        code :: "E0161"
        status :: .Retired
        no_fix :: None
        fn what(self) -> String { "*Retired* (was: `++`/`--` on an immutable binding)" }
        fn why(self) -> String { "`++` and `--` are retired; E0160 teaches `+= 1` / `-= 1`" }
        fn fix(self) -> String { "Do not use E0161" }
    }
}

struct RetiredIncrementNonInteger {
    impl Diagnostic {
        code :: "E0162"
        status :: .Retired
        no_fix :: None
        fn what(self) -> String { "*Retired* (was: `++`/`--` on a non-integer type)" }
        fn why(self) -> String { "`++` and `--` are retired; E0160 teaches `+= 1` / `-= 1`" }
        fn fix(self) -> String { "Do not use E0162" }
    }
}

struct RetiredIncrementIndexed {
    impl Diagnostic {
        code :: "E0163"
        status :: .Retired
        no_fix :: None
        fn what(self) -> String { "*Retired* (was: `++`/`--` on an indexed slot)" }
        fn why(self) -> String { "`++` and `--` are retired; E0160 teaches `+= 1` / `-= 1`" }
        fn fix(self) -> String { "Do not use E0163" }
    }
}

struct CompoundAssignToIndex {
    op: String

    impl Diagnostic {
        code :: "E0164"
        meaning :: "Compound assignment can't target an indexed slot (S17)"
        detail :: true
        fix_next :: "Use a supported integer update, such as `map[key] = (map.get(key) ?? 0) + 1`."
        fn what(self) -> String { "Compound assignment can't target an indexed slot." }
        fn why(self) -> String { "A compound update reads an indexed slot before it writes; that read can panic when a map key is missing." }
        fn fix(self) -> String { "Write a total update, such as `map[key] = (map.get(key) ?? 0) {self.op} 1`" }
    }
}

struct CompoundAssignNotPlace {
    op: String

    impl Diagnostic {
        code :: "E0165"
        stage :: [.Parse]
        meaning :: "Compound assignment target is not an assignable place (S17)"
        detail :: true
        fix_next :: "Bind the value with `:=`, then use a supported update operator."
        fn what(self) -> String { "Compound assignment needs a mutable place." }
        fn why(self) -> String { "S17 permits updates only on a mutable name or an `&` parameter; a computed value has no place to update." }
        fn fix(self) -> String { "Bind the value with `:=`, then write `name {self.op} value`" }
    }
}

struct ProtocolLineMissingSender {
    impl Diagnostic {
        code :: "E0154"
        stage :: [.Parse]
        meaning :: "protocol line does not use sender form `client:` or `server:`"
        detail :: true
        fn what(self) -> String { "A protocol line does not name `client:` or `server:` as its sender." }
        fn why(self) -> String { "A two-endpoint protocol needs only the sender. The other endpoint is the receiver, so a transport arrow repeats information." }
        fn fix(self) -> String { "Write `client: Message(…)` when the client sends, or `server: Message(…)` when the server sends." }
    }
}

struct InvalidTypedLiteral {
    impl Diagnostic {
        code :: "E0155"
        meaning :: "Typed URL, Path, or DateTime literal is invalid or contains unsupported interpolation"
        detail :: true
        fn what(self) -> String { "A typed URL, Path, or DateTime literal is invalid or contains unsupported interpolation" }
        fn why(self) -> String { "Typed literal types are checked before the program runs; URL and Path holes must stay inside components, and DateTime literals must be complete." }
        fn fix(self) -> String { "Write a valid typed literal with holes only in URL or Path components; write `DateTime{{\"…\"}}` without holes, or parse a runtime String explicitly" }
    }
}

struct PlaneLoosenedWithoutGate {
    plane: String
    gate: String

    impl Diagnostic {
        code :: "E0156"
        meaning :: "A knowledge plane would be loosened without its written gate"
        detail :: true
        fix_next :: "Write the required gate around the value at this boundary."
        fn what(self) -> String { "This operation would loosen {self.plane}" }
        fn why(self) -> String { "Knowledge only tightens silently; loosening {self.plane} must be named with a written gate" }
        fn fix(self) -> String { "Write `{self.gate}(value)` at this boundary" }
    }
}

struct TopLevelStateSection {
    type: String
    states: String

    impl Diagnostic {
        code :: "E0157"
        stage :: [.Parse]
        meaning :: "Top-level typestate companion declaration"
        detail :: true
        fix_next :: "Move the typestate states into the owning struct declaration."
        fn what(self) -> String { "`state {self.type} {{ … }}` is not a type declaration" }
        fn why(self) -> String { "Typestate facts belong to the struct that owns them; a sibling declaration repeats the type name and creates a false namespace boundary" }
        fn fix(self) -> String { "Move the states into the owner: write `struct {self.type}` with `state {self.states}` inside its body" }
    }
}

struct StateSectionNotAllowed {
    owner: String

    impl Diagnostic {
        code :: "E0158"
        stage :: [.Parse]
        meaning :: "Typestate state section attached to an ineligible declaration"
        detail :: true
        fn what(self) -> String { "`state {{ … }}` is not valid inside a {self.owner}" }
        fn why(self) -> String { "State sections attach only to named struct bodies; enums, traits, aliases, impls, modules, and anonymous shapes have no state-set owner" }
        fn fix(self) -> String { "Move `state {{ … }}` into the named struct body" }
    }
}

struct TypestateMarkerWithoutStates {
    type: String

    impl Diagnostic {
        code :: "E0159"
        meaning :: "Typestate marker on an owner without a state section"
        detail :: true
        fix_next :: "Add a `state {{ ... }}` section inside the owning struct, or remove the typestate marker."
        fn what(self) -> String { "`{self.type}` has a `#State` or `#Transition` marker but no `state {{ … }}` section" }
        fn why(self) -> String { "Markers describe facts owned by the struct; without its declared set the marker cannot be checked or reflected" }
        fn fix(self) -> String { "Add one `state {{ Name, … }}` section inside `struct {self.type}`, or remove the typestate marker" }
    }
}

struct DuplicateTypestate {
    state: String
    type: String

    impl Diagnostic {
        code :: "E0166"
        meaning :: "Duplicate typestate name"
        detail :: true
        no_fix :: .Ambiguous
        fix_next :: "Keep each state declaration unique inside the struct state section."
        fn what(self) -> String { "State `{self.state}` is declared more than once for `{self.type}`" }
        fn why(self) -> String { "The owning struct has one bounded state set, so a repeated name would make `Type.State.{self.state}` ambiguous" }
        fn fix(self) -> String { "Keep one declaration of `{self.state}` in the struct's `state {{ … }}` section" }
    }
}

struct TypestateMemberConflict {
