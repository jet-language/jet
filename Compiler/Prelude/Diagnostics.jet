        fn what(self) -> String { "`` `<word>` isn't an active image kind `` (or `` `kind: .<word>` doesn't match this image's `from:` ``)." }
        fn why(self) -> String { "Active Jetpack images use `.Oci`; `.Iso` disk images are frozen jetos research capture. A `jet image` run reports this image declaration error." }
        fn fix(self) -> String { "Write `kind: .Oci` for active Jetpack images, or keep `.Iso` only as research capture." }
    }
}

struct ImageFromNonExecutable {
    image: String
    package: String

    impl Diagnostic {
        code :: "E1267"
