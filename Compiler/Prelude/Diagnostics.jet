        detail :: true
        fn what(self) -> String { "Organization or package policy forbids unsafe code." }
        fn why(self) -> String { "A lexical gate cannot widen the effective safety floor." }
        fn fix(self) -> String { "Remove the operation or have the policy owner change the outer policy." }
    }
}

struct InvalidUnsafeObligationMode {
    impl Diagnostic {
        code :: "E3106"
