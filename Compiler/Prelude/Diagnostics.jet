        meaning :: "A discovered module has its own `imports:` (liftability law, U4)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "A module discovered by `find(…)` has its own `imports:`." }
        fn why(self) -> String { "The liftability law (U4): modules contribute to the merged whole, they never import each other — nesting `find` would make composition explode and break \"drop a file in.\"" }
        fn fix(self) -> String { "Remove the `imports:` from the discovered module; declare all `find(…)` directives in the top-level env.jet." }
    }
}

