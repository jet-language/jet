OptionalChainOnNonOptional: struct {
    impl Diagnostic {
        code: "E0047"
        safety_class: .Opinion
        safety_reason: "On a value that is never None, `?.` could act like `.` and run safely, so the refusal only flags a misleading spelling."
        meaning: "Optional chaining (`?.`) on a value that can't be missing"

        what: fn(self) -> String { "`?.` is used on a value that isn't optional" }

        why: fn(self) -> String {
            "Optional chaining stops at a missing link, so its left side must be a `T?` that can be missing"
        }

        fix: fn(self) -> String { "Make the left operand optional (`T?`) before using `?.`." }
    }
}

