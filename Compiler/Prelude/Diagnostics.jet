struct ViewOutlivesOwner {
    impl Diagnostic {
        code :: "E2305"
        meaning :: "A declared `View<T>` would outlive its owner, or the compiler cannot infer, prove, and stabilize its public owner provenance"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "A declared `View<T>` would outlive an owner, or sema cannot stabilize a public owner set for each declared view slot. Read-only views entering non-view owning slots materialize by default; `copies: .Explicit` restores the refusal." }
        fn why(self) -> String { "Each declared view slot keeps a bounded set of possible receiver, parameter, or static sources through every return path, call, generic instantiation, aggregate projection, function value, lambda, and trait implementation. Every possible owner must stay live; a consumed (`^`) parameter or receiver is freed when the function returns, so it never owns a returned view." }
        fn fix(self) -> String { "Keep every possible owner alive (take a returned view's source as a read or `&` parameter, not `^`), preserve the declared view boundary, or remove `copies: .Explicit` / write `view.copy()` when an owning destination is intended." }
    }
}

struct RetiredRefLabel {
    impl Diagnostic {
        code :: "E2306"
        status :: .Retired
        no_fix :: None
        fn what(self) -> String { "*Retired* (was: `#Ref(label)` on a raw-reference `&T` field names no in-scope value of the referent type; stored-ref fields no longer exist)" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Follow the guidance for E2306" }
    }
}

struct StringViewOutlivesOwner {
    impl Diagnostic {
        code :: "E2307"
        meaning :: "A declared string view would outlive its owning `String`, or the compiler cannot infer, prove, and stabilize its public owner provenance"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .NeedsReview
        fn what(self) -> String { "A declared string view would outlive a possible owning `String`, has no stable public owner set, or `copies: .Explicit` forbids the owning materialization needed at a non-view destination." }
        fn why(self) -> String { "`View<str>` follows the same inferred owner-set rule as `View<T>` through calls, aggregates, callbacks, and trait contracts. Local and temporary owners still die too soon; an owned `String` still cannot fill a declared `View<str>` slot." }
        fn fix(self) -> String { "Keep every possible owner alive, use a proven `View<str>` boundary, write `view.copy()` at the highlighted owning expression (the checker grades that edit), or remove `copies: .Explicit` for the default owning copy." }
    }
}

