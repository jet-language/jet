        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Two interactive nodes both have the label \"{self.label}\"" }
        fn why(self) -> String { "Assistive tech announces controls by their label — identical labels make them indistinguishable (WCAG 2.5.3)." }
        fn fix(self) -> String { "Give each interactive node a distinct, descriptive label." }
    }
}

struct LayoutAxisMismatch {
    lt: String
    rt: String

    impl Diagnostic {
        code :: "E2932"
        meaning :: "A `Layout{{ … }}` constraint mixes a horizontal and vertical value"
        detail :: true
        fn what(self) -> String { "Layout constraint mixes a horizontal and vertical value (`{self.lt}` and `{self.rt}`)" }
        fn why(self) -> String { "`left`/`right`/`width` are horizontal (`HVar`); `top`/`bottom`/`height` are vertical (`VVar`) — combining or comparing across axes is caught at compile time instead of producing a nonsensical layout." }
        fn fix(self) -> String { "Compare or combine values from the same axis (a `LengthVar`, or a plain number, fits either axis)." }
    }
}

struct InvalidLayoutElement {
    name: String
    ty: String

    impl Diagnostic {
        code :: "E2933"
        meaning :: "An element inside `Layout{{ … }}` doesn't produce a `Constraint`"
        detail :: true
        fn what(self) -> String { "This element inside `{self.name} :: Layout{{{{ … }}}}` doesn't produce a constraint (found `{self.ty}`)" }
        fn why(self) -> String { "Every element directly inside a `Layout{{ … }}` body must be a `>=`/`<=`/`==` comparison of layout values (a `Constraint`), comma-separated like other typed-literal element bodies." }
        fn fix(self) -> String { "Write a comparison, e.g. `label.width >= 80.0`." }
    }
}

struct DuplicateLayoutConstraint {
    impl Diagnostic {
        code :: "E2934"
        severity :: .Lint
        lint_name :: "duplicate_layout_constraint"
