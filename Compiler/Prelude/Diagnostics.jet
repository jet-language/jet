        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "This constraint repeats one already written in this `Layout{{{{ … }}}}` body" }
        fn why(self) -> String { "An exact duplicate constraint doesn't tighten the layout — it's almost always a copy-paste leftover." }
        fn fix(self) -> String { "Remove the duplicate line, or change it if a different constraint was meant." }
    }
}

struct RetiredLayoutDeclaration {
    name: String

