struct RetiredViewCrossing {
    impl Diagnostic {
        code :: "E2303"
        status :: .Retired
        meaning :: "*Retired: reported as E1102* (a `View<T>` crossing a task/channel boundary is the unsendable-value rule, so one situation gives one error)"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "A `View<T>` (or a string view) crosses a `tasks.spawn` or `Sender.send` boundary." }
        fn why(self) -> String { "A view points into something another scope owns; a task or channel moves owned data between threads, so a view can't cross without ownership. Reported as **E1102** (the unsendable-value rule), not separately, so one situation gives one error." }
        fn fix(self) -> String { "Send plain owned data, or rebuild the value as an owned copy (`x.copy()`) before crossing." }
    }
}

