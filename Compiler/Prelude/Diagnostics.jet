}

struct MissingExhaustionRoute {
    impl Diagnostic {
        code :: "E0078"
        meaning :: "A finite value loop is missing its exhaustion route, or uses bare immediate `?? next`/`?? break`"
        detail :: true
        fn what(self) -> String { "This finite value loop needs a written exhaustion route, or cannot use an immediate `?? next`/`?? break` route." }
        fn why(self) -> String { "A finite source can end without a matching `break`; `next` and `break` after the closing brace would control the loop that just closed instead of naming a target." }
        fn fix(self) -> String { "Add `?? fallback` after the closing `}}`, or write a labeled search such as `found :: loop {{ ... break(found, value) }}`." }
    }
}

struct EffectLoopResultExit {
