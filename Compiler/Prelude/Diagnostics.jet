    score: String
    budget: String

    impl Diagnostic {
        code :: "L2902"
        severity :: .Lint
        lint_name :: "cognitive_complexity"
        stage :: [.Compile]
        meaning :: "Function exceeds the selected cognitive-complexity budget"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Function `{self.fn_name}` has cognitive complexity `{self.score}` above budget `{self.budget}`" }
        fn why(self) -> String { "Cognitive complexity counts nested branches, loops, dispatches, mixed boolean sequences, and recursion so a refactor can be checked mechanically." }
        fn fix(self) -> String { "Split the function, reduce nesting, or replace mixed control flow with a focused helper." }
    }
}

struct MissingWorkspaceModule {
    impl Diagnostic {
        code :: "E0995"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "`workspace.jet` has no `module workspace {{ … }}` declaration." }
        fn why(self) -> String { "`workspace.jet` is the monorepo index; it must contain exactly one `module workspace {{ members: … }}` body." }
        fn fix(self) -> String { "Write `module workspace {{ members: find(\"./packages\") }}` (or an explicit list) in `workspace.jet`." }
    }
}

struct InvalidMembersList {
    impl Diagnostic {
        code :: "E0996"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "`members:` evaluated to something other than a list of strings." }
        fn why(self) -> String { "The `members:` value must evaluate to `[String]` — a list of relative package directory paths." }
        fn fix(self) -> String { "Use `find(\"./packages\")` or a list literal like `[\"./packages/hello\", \"./packages/ranker\"]`." }
    }
}

struct MembersDirectoryNotFound {
    impl Diagnostic {
        code :: "E0997"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "`find(\"…\")` in `members:` names a directory that doesn't exist." }
        fn why(self) -> String { "`find` scans that directory for subdirectories containing `package.jet`; the directory must exist relative to `workspace.jet`." }
        fn fix(self) -> String { "Create the directory or correct the path in `members: find(\"…\")`." }
    }
}

struct EmptyTaskCombinator {
    method: String

    impl Diagnostic {
        code :: "E1112"
        meaning :: "A task combinator has no task branch"
        detail :: true
        fix_next :: "Write the task combinator with one or more branches."
        fn what(self) -> String { "{self.method} needs at least one task branch" }
        fn why(self) -> String { "A task combinator must have a child to join or select" }
        fn fix(self) -> String { "Write {self.method} {{{{ work() }}}} with one or more branches" }
    }
}

struct FrozenValueWrite {
    name: String
    action: String
    freeze_site: String

    impl Diagnostic {
        code :: "E1113"
        meaning :: "Write through a frozen value"
        detail :: true
        fn what(self) -> String { "`{self.name}` cannot {self.action}; it was frozen at {self.freeze_site}" }
        fn why(self) -> String { "`freeze(...)` creates a deeply immutable owned snapshot so a task can read it without a race. A write through any field or index would change that snapshot." }
        fn fix(self) -> String { "Create a new value, freeze a new snapshot, or use `Shared`/`Cell` when shared mutation is intentional" }
    }
}

struct FreezeNotSnapshotable {
    ty: String
    reason: String

    impl Diagnostic {
        code :: "E1114"
        meaning :: "freeze source is not deeply snapshot-able"
        detail :: true
        fn what(self) -> String { "`freeze` cannot snapshot `{self.ty}`: {self.reason}" }
        fn why(self) -> String { "A frozen value must be an owned cloneable value with no shared handle, resource, function, trait value, or mutable view inside it." }
        fn fix(self) -> String { "Use `^` to give the owned value to the task, use `Shared`/`Cell` for deliberate shared state, or rebuild a plain owned value" }
    }
}

struct RetiredSharedNew {
    impl Diagnostic {
        code :: "E1115"
        stage :: [.Parse]
        status :: .Retired
        meaning :: "Teaching: retired `Shared.new(x)` constructor → prefix `shared x`"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "`Shared.new(…)` is the retired shared-cell constructor." }
        fn why(self) -> String { "D-CONC-SHARE1=A gives shared state one construction word, so every shared cell reads the same on the page." }
        fn fix(self) -> String { "Write `shared <value>` instead of `Shared.new(<value>)`." }
    }
}

struct UnknownSharedMethod {
    method: String

    impl Diagnostic {
        code :: "E1116"
        meaning :: "A method that a shared value does not have"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "A shared value has no `.{self.method}(…)` method" }
        fn why(self) -> String { "A shared value reads and writes like a value: a field read is one locked read, a field write is one locked write, and each statement is one atomic step." }
        fn fix(self) -> String { "Read the field directly (`config.name`) and write it directly (`config.hits += 1`); group several steps under `#Transact {{{{ … }}}}`, or take an expert guard with `.guard_edit()`." }
    }
}

struct MixedTaskBranches {
    impl Diagnostic {
        code :: "E1117"
        stage :: [.Parse]
        meaning :: "`task.all` mixes named and positional branches"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`task.all` branches must all be named or all positional." }
        fn why(self) -> String { "Jet gives named results stable record fields and keeps positional results as ordered lists; mixing the two shapes would make the result type ambiguous." }
        fn fix(self) -> String { "Use `task.all {{ first: work(), second: other() }}`, or remove every branch label." }
    }
}

struct TaskCancelled {
    impl Diagnostic {
        code :: "E3004"
        status :: .Retired
        no_fix :: None
        fn what(self) -> String { "*Retired* (was: a task was cancelled at a cooperative wait point)" }
        fn why(self) -> String { "Cancellation is a value, not a stop: a cancelled task's join gives `TaskFailure.Cancelled`, a cancelled root drains its scope and exits, and an unhandled `Cancelled` reports through the ordinary failure report; the code is registered again if cancellation ever becomes a coded stop" }
        fn fix(self) -> String { "Do not use E3004" }
    }
}

struct InvalidMemoField {
    field: String

    impl Diagnostic {
        code :: "E0382"
        meaning :: "`#Memo` requires a bare computed field"
        detail :: true
        fix_next :: "Write `#Memo` before a bare computed field without arguments."
        fn what(self) -> String { "`#Memo` cannot mark `{self.field}`." }
        fn why(self) -> String { "A stored computed result needs a formula and its dependency set; field `#Memo` does not take cache arguments." }
        fn fix(self) -> String { "Write `#Memo` before `{self.field}: T -> expr` without arguments." }
    }
}

struct RetiredDeclarationDefault {
    impl Diagnostic {
        code :: "E0385"
        stage :: [.Parse]
        status :: .Retired
        meaning :: "Teaching: retired declaration default `name: Type = value`; write `name: Type{{{{value}}}}`"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "This declaration uses the retired `name: Type = value` default spelling." }
        fn why(self) -> String { "Declaration defaults ride the type as `name: Type{{{{value}}}}`; `=` remains for reassignment and extern slot fill." }
        fn fix(self) -> String { "Write `name: Type{{{{value}}}}` for a declaration default, or keep `=` for reassignment and extern slot fill." }
    }
}

struct RetiredLoopComma {
    impl Diagnostic {
        code :: "E0383"
        stage :: [.Parse]
        status :: .Retired
        meaning :: "Teaching: source loops join a binding and source with `in`, not a comma"
        detail :: true
        edit :: .Replace
        edit_from :: ","
        edit_to :: "in"
        no_fix :: None
        fix_safety :: .Formatting
        fn what(self) -> String { "This source loop uses a retired comma between its binding and source." }
        fn why(self) -> String { "A source loop uses `in` to mark the binding/source boundary; commas remain for later clauses such as a stride." }
        fn fix(self) -> String { "Replace the comma after the binding with `in`, for example `loop item in items {{ … }}`." }
    }
}

struct RetiredInOperator {
    impl Diagnostic {
        code :: "E0384"
        stage :: [.Parse]
        status :: .Retired
        meaning :: "Teaching: expression-position membership uses `.contains(x)`, not `in`"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "Jet has no membership operator here; `in` only joins a source-loop binding to its source." }
        fn why(self) -> String { "Expression `x in xs` has no operator meaning in Jet. Collection membership is a method call." }
        fn fix(self) -> String { "Write `xs.contains(x)` (the `.contains(x)` method) instead of `x in xs`." }
    }
}

struct RetiredForeignPowerOperator {
    impl Diagnostic {
        code :: "E0396"
        stage :: [.Parse]
        status :: .Retired
        no_fix :: None
        fn what(self) -> String { "*Retired* (was: `**` power operator teaching)" }
        fn why(self) -> String { "The registered parse rule applies here" }
        fn fix(self) -> String { "Follow the guidance for E0396" }
    }
}

struct LogicalNotOnNonBool {
    impl Diagnostic {
        code :: "E0398"
        stage :: [.Parse]
        meaning :: "`!` applied to a non-Bool value"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .BehaviorPreserving
        fn what(self) -> String { "`!` needs a Bool operand." }
        fn why(self) -> String { "`!` negates a Bool; integer bits use named methods." }
        fn fix(self) -> String { "Write `value.bit_not()` to flip integer bits." }
    }
}

struct InvalidChannelCapacity {
    capacity: String

    impl Diagnostic {
        code :: "E0395"
        meaning :: "A bounded channel capacity is below 1"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Write a capacity of at least 1, or use an unbounded channel."
        fn what(self) -> String { "A channel capacity must be at least 1, not `{self.capacity}`." }
        fn why(self) -> String { "A bounded channel holds at least one value; Jet has no zero-capacity rendezvous channel, and a capacity below 1 is never clamped. A runtime capacity below 1 stops the program (E3001)." }
        fn fix(self) -> String { "Write `channel<T>(capacity: 1)` or larger, or `channel<T>()` for an unbounded channel." }
    }
}

struct AtomGroupWithoutParentheses {
    impl Diagnostic {
        code :: "E0386"
        stage :: [.Parse]
        meaning :: "A bare distributed atom group is a direct operand of `&&` or `||`"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .Formatting
        fn what(self) -> String { "Distributed atom groups need parentheses before `&&` or `||`." }
        fn why(self) -> String { "A `|` arm head is one distributed group, so its boundary must stay visible before a Boolean operator applies." }
        fn fix(self) -> String { "Write `(atom | atom) && guard` or `(atom | atom) || guard`." }
    }
}

struct RawAccessOutsideProvenance {
    operation: String
    gate: String
    obligation: String

    impl Diagnostic {
        code :: "R0801"
        stage :: [.Runtime]
        moment :: .Run
        meaning :: "Raw `{{operation}}` outside `{{gate}}`'s allocation provenance"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Bound the raw access before it reaches storage and satisfy the named unsafe obligation."
        fn what(self) -> String { "Runtime fault [R0801]: raw `{self.operation}` outside `{self.gate}`'s storage" }
        fn why(self) -> String { "The pointer is outside the allocation provenance tracked for the active `#Unsafe` gate; runtime evidence never replaces a required static obligation." }
        fn fix(self) -> String { "Bound the raw access before it reaches storage — obligation `{self.obligation}` was not met on this run." }
    }
}

struct UseAfterLifetime {
    gate: String
    operation: String
    obligation: String

    impl Diagnostic {
        code :: "R0802"
        stage :: [.Runtime]
        moment :: .Run
        meaning :: "Use of storage after its lifetime ended"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Do not use the pointer after release or frame exit; satisfy the named lifetime obligation."
        fn what(self) -> String { "Runtime fault [R0802]: use of storage after its lifetime ended in `{self.gate}`" }
        fn why(self) -> String { "The storage was released or its owning Jet frame expired before this raw `{self.operation}`; the gate's lifetime obligation was not met." }
        fn fix(self) -> String { "Do not use the pointer after release or frame exit — obligation `{self.obligation}` was not met on this run." }
    }
}

struct MisalignedRawAccess {
    operation: String
    gate: String
    detail: String
    obligation: String

    impl Diagnostic {
        code :: "R0803"
        stage :: [.Runtime]
        moment :: .Run
        meaning :: "Misaligned raw `{{operation}}`"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Derive an aligned pointer from the live allocation and satisfy the named alignment obligation."
        fn what(self) -> String { "Runtime fault [R0803]: misaligned raw `{self.operation}` in `{self.gate}`" }
        fn why(self) -> String { "This raw `{self.operation}` needs an aligned pointer, but {self.detail}." }
        fn fix(self) -> String { "Derive an aligned pointer from the live allocation, or use the typed memory operation instead of raw address arithmetic — obligation `{self.obligation}` was not met on this run." }
    }
}

struct MemberShorthandArity {
    arity: String
    chain: String

    impl Diagnostic {
        code :: "E-SUBJECT-CALL-ARITY"
        meaning :: "Bare member shorthand used with a non-unary callable"
        detail :: true
        fix_next :: "Write a full lambda with every parameter named."
        fn what(self) -> String { "A bare member chain cannot supply a {self.arity}-parameter callable here" }
        fn why(self) -> String { "Lower-case `.member` shorthand supplies exactly one subject; a callable with {self.arity} parameters needs all parameters named" }
        fn fix(self) -> String { "Write the full lambda, for example `(first, second) -> first{self.chain}`" }
    }
}

struct PanicGranted {
    impl Diagnostic {
        code :: "E0751"
        meaning :: "Panic is a deny-only effect row"
        detail :: true
        fn what(self) -> String { "`Panic` can't be granted, only denied" }
        fn why(self) -> String { "`Panic` is a deny-only effect row; no positive effect bound or authority can grant it" }
        fn fix(self) -> String { "Drop `Panic` from the list, or write `-[!Panic]>`" }
    }
}

struct SourceImportTodo {
    construct: String
    source: String
    reason: String
    fix_text: String
    target: String

    impl Diagnostic {
        code :: "JT0101"
        severity :: .Lint
        lint_name :: "source_import_todo"
        stage :: [.Jet]
        moment :: .Tool
        meaning :: "Source importer omitted a construct"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Implement the omitted construct in Jet or review the generated target before rerunning import."
        fn what(self) -> String { "Source import omitted {self.construct} at {self.source}" }
        fn why(self) -> String { "The importer cannot prove an equivalent Jet construct: {self.reason}" }
        fn fix(self) -> String { "{self.fix_text}; then review the generated target `{self.target}` before rerunning the import." }
    }
}

struct SourceImportFailed {
    operation: String
    reason: String

    impl Diagnostic {
        code :: "JT0198"
        stage :: [.Jet]
        moment :: .Tool
        meaning :: "Source import operation failed"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Source import could not {self.operation}" }
        fn why(self) -> String { "{self.reason}" }
        fn fix(self) -> String { "Check the source path and write permissions, then rerun" }
    }
}

struct SourceImportConflict {
    paths: String

    impl Diagnostic {
        code :: "JT0199"
        stage :: [.Jet]
        moment :: .Tool
        meaning :: "Source import merge conflict"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Source import conflict in {self.paths}" }
        fn why(self) -> String { "Generated source and editable Jet both changed since the stored baseline" }
        fn fix(self) -> String { "Reconcile the files, then rerun with `--update`" }
    }
}

struct UntrustedNixpkgsIndex {
    impl Diagnostic {
        code :: "E1348"
        stage :: [.Jetpack]
        meaning :: "Signed nixpkgs index proof was rejected"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "The signed nixpkgs index could not be trusted." }
        fn why(self) -> String { "The manifest, target, signature, or canonical record failed verification, so Jetpack refused to select or substitute the package. A `jetpack env` run reports this environment-provider error." }
        fn fix(self) -> String { "Refresh the signed index or use a covered locked nixpkgs input." }
    }
}

struct NixpkgsAttrNotIndexed {
    impl Diagnostic {
        code :: "E1349"
        stage :: [.Jetpack]
        meaning :: "Requested nixpkgs attr is outside signed index coverage"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "The requested nixpkgs attr is not covered by the signed index." }
        fn why(self) -> String { "The signed index records only the published nixpkgs channel, revision, system, and attrs it can prove; this attr is in its explicit not-indexed coverage. A `jetpack env` run reports this environment-provider error." }
        fn fix(self) -> String { "Use a covered attr or a supported native provider, or resolve the input through an explicit compatibility path." }
    }
}

struct NixCacheAdmissionFailed {
    kind: String

    impl Diagnostic {
        code :: "E1350"
        stage :: [.Jetpack]
        meaning :: "Native Nix cache admission failed during {{kind}}"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Native Nix cache admission failed during {self.kind}." }
        fn why(self) -> String { "The signed Nix cache closure was not admitted because its {self.kind} check failed." }
        fn fix(self) -> String { "Repair the cache metadata or network response, then retry the admission." }
    }
}

struct UndocumentedPublicApi {
    name: String

    impl Diagnostic {
        code :: "L2201"
        severity :: .Lint
        lint_name :: "undocumented_public_api"
        stage :: [.Jet]
        meaning :: "Public API item has no documentation"
        detail :: true
        no_fix :: .Behavior
        fix_next :: "Add a `///` summary before the public item, or move it into a `priv module` if it is not public."
        fn what(self) -> String { "Public API item `{self.name}` has no documentation" }
        fn why(self) -> String { "Generated reference documentation needs a summary for every public API item so users can find and understand the supported surface." }
        fn fix(self) -> String { "Add a `///` summary before `{self.name}`, or move it into a `priv module` when it is not part of the public API." }
    }
}

struct InlinePackageNotFirst {
    impl Diagnostic {
        code :: "E1360"
        stage :: [.Jet]
        meaning :: "An inline `package {{ … }}` declaration is not first"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "An inline `package {{ … }}` declaration must be the first top-level declaration." }
        fn why(self) -> String { "The contextual package carrier owns the file's Package facts and must be established before ordinary Jet items." }
        fn fix(self) -> String { "Move the `package {{ … }}` block before every other top-level declaration." }
    }
}

struct DuplicateInlinePackage {
    impl Diagnostic {
        code :: "E1361"
        stage :: [.Jet]
        meaning :: "An inline `package {{ … }}` declaration appears more than once"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "An inline `package {{ … }}` declaration appears more than once." }
        fn why(self) -> String { "One source file has one Package identity; accepting a second block would make facts, outputs, and authority ambiguous." }
        fn fix(self) -> String { "Keep one leading `package {{ … }}` block and remove the duplicate." }
    }
}

struct MalformedInlinePackage {
    impl Diagnostic {
        code :: "E1362"
        stage :: [.Jet]
        meaning :: "An inline `package {{ … }}` declaration is malformed or unbalanced"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "The inline `package {{ … }}` declaration is malformed or missing its closing brace." }
        fn why(self) -> String { "The contextual carrier must have one balanced block before its body can be passed to the canonical Package parser." }
        fn fix(self) -> String { "Close the block and fix its structure, then let the Package field diagnostic identify any invalid field." }
    }
}

struct InlinePackageConflict {
    impl Diagnostic {
        code :: "E1363"
        stage :: [.Jet]
        meaning :: "An inline Package conflicts with `package.jet`"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "This source declares inline Package facts while `package.jet` also exists." }
        fn why(self) -> String { "Jet allows one Package context per project; choosing between two identities would make builds, dependencies, outputs, and authority nondeterministic." }
        fn fix(self) -> String { "Remove the inline block or remove `package.jet`, then keep the remaining Package declaration canonical." }
    }
}

struct InvalidMarkerGroupMember {
    impl Diagnostic {
        code :: "E0400"
        meaning :: "Forbidden named marker-group member"
        fn what(self) -> String { "This member cannot be stored in a named marker group." }
        fn why(self) -> String { "A group contains only active, fixed marker applications; gates, refusals and other groups must not be hidden in it." }
        fn fix(self) -> String { "Remove this member from the group and write gates or refusals explicitly at each use site." }
    }
}

struct UnqualifiedLibraryMarker {
    impl Diagnostic {
        code :: "E0085"
        meaning :: "Imported library marker written bare"
        fn what(self) -> String { "A marker from another module must be qualified." }
        fn why(self) -> String { "Imported markers name their declaring library through its local import name; same-module markers may stay bare." }
        fn fix(self) -> String { "Write the marker through the local name of its declaring module's import." }
    }
}

struct AmbiguousMarker {
    impl Diagnostic {
        code :: "E0086"
        meaning :: "Ambiguous qualified marker"
        no_fix :: .Ambiguous
        fn what(self) -> String { "This qualified marker has more than one declaring module." }
        fn why(self) -> String { "A marker's import path must resolve to one module and one exported row." }
        fn fix(self) -> String { "Give the modules distinct import aliases and qualify the marker with one of them." }
    }
}

struct MarkerLibraryCasing {
    impl Diagnostic {
        code :: "E0087"
        meaning :: "Marker library part not PascalCase"
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .NeedsReview
        fn what(self) -> String { "The library part of a qualified marker must be PascalCase." }
        fn why(self) -> String { "Markers are PascalCase after `#`, including the library part, which spells the import's local name in PascalCase." }
        fn fix(self) -> String { "Write the library part in PascalCase, such as `#Server.Get` through `use server :: core.http.server`; `jet fix` applies this edit." }
    }
}
