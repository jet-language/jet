        detail :: true
        fn what(self) -> String { "An index interval is out of range for a `[T#N]` at compile time." }
        fn why(self) -> String { "Literal indexes and interval facts must fit 0 through N−1; anything outside that range would panic at runtime." }
        fn fix(self) -> String { "Use an index in the valid range, widen to `[T]` for runtime checking, or tighten the range." }
    }
}

struct MisplacedVariadicParameter {
    impl Diagnostic {
        code :: "E1310"
        stage :: [.Parse, .Sema]
        meaning :: "Variadic parameter not last, or variadic param has a default"
        detail :: true
        fn what(self) -> String { "A `...` rest parameter is not last, or a variadic parameter has a default value." }
        fn why(self) -> String { "A variadic parameter collects every trailing argument, so nothing may follow it; a default would contradict that job." }
        fn fix(self) -> String { "Move `name: ...T` to the end of the parameter list and remove any `{{…}}` default." }
    }
}

struct SpreadNotList {
