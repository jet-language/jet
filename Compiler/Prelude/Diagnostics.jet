    provider: String
    capability: String
    target: String
    sha256: String

    impl Diagnostic {
        code :: "E3312"
        meaning :: "Target provider contract has invalid provenance"
        detail :: true
        fix_next :: "Declare a provider identity and `sha256:` digest for the required capability."
        fn what(self) -> String { "Provider `{self.provider}` for `{self.capability}` on target `{self.target}` has invalid digest `{self.sha256}`." }
        fn why(self) -> String { "Every selected provider needs a stable identity and sha256 provenance so artifacts cannot reuse changed target behavior." }
        fn fix(self) -> String { "Declare a nonempty provider identity and a `sha256:` digest for `{self.capability}`." }
    }
}

struct MmioFactViolation {
    target: String
    detail: String

    impl Diagnostic {
        code :: "E3313"
        meaning :: "Target MMIO access is outside its declared safety facts"
        detail :: true
        fn what(self) -> String { "Target `{self.target}` has an MMIO fact failure: {self.detail}." }
        fn why(self) -> String { "MMIO addresses must lie inside a declared MMIO region and every access must carry a nonempty `#Unsafe` reason." }
        fn fix(self) -> String { "Declare a matching MMIO provider and region, then place the access inside `#Unsafe(\"reason\")`." }
    }
}

struct InvalidTargetFact {
    target: String
    fact: String
    detail: String

    impl Diagnostic {
        code :: "E3314"
        meaning :: "Target machine fact is invalid"
        detail :: true
        fix_next :: "Select a complete typed target profile and correct the fact declaration."
        fn what(self) -> String { "Target `{self.target}` has an invalid `{self.fact}` fact: {self.detail}." }
        fn why(self) -> String { "Target memory, linker, allocator, panic, startup, and execution facts are explicit inputs to sema and cannot be recovered safely from a triple." }
        fn fix(self) -> String { "Select a complete typed target profile and correct the `{self.fact}` declaration." }
    }
}

struct ComptimeEffectWithoutImpure {
    module_name: String
    call: String

    impl Diagnostic {
        code :: "E3410"
        meaning :: "Tier-2 comptime effect (`core.files`/`core.sys`/`core.term`/`core.process`) called outside a `#Impure` gate"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`{self.module_name}.{self.call}` is a Tier-2 ambient comptime effect and can't run at compile time without a `#Impure` gate." }
        fn why(self) -> String { "`core.files`, `core.sys`, `core.term`, and `core.process` touch the host system at compile time. Without the gate any build tooling (caches, hermetic sandboxes) may get different results. A `jet build` or `jet run` run reports this comptime-tier diagnostic." }
        fn fix(self) -> String { "Wrap the call in `#Impure(\"reading config\") {{ … }}`." }
    }
}

struct ImpureGateNotAllowed {
    impl Diagnostic {
        code :: "E3411"
        meaning :: "Tier-2 comptime effect inside `#Impure` gate but `--gate impure=allow` not passed"
        detail :: true
        fn what(self) -> String { "`#Impure` gate present but `--gate impure=allow` was not passed." }
        fn why(self) -> String { "The `#Impure` block opts in to ambient I/O, but the invocation gate is also required so CI can audit builds that touch the host." }
        fn fix(self) -> String { "Add `--gate impure=allow` to your `jet build` / `jet run` invocation." }
    }
}

struct GateDeniedByPolicy {
    gate: String
    site: String
    policy: String

    impl Diagnostic {
        code :: "E3415"
        meaning :: "Any audited gate denied by organization or package policy"
        detail :: true
        fix_next :: "Remove this gate or change the owning policy."
        fn what(self) -> String { "The `{self.gate}` gate at `{self.site}` is forbidden by `{self.policy}`." }
        fn why(self) -> String { "The shared policy ladder keeps an organization or package `.Forbid` authoritative; a package `.GateOnly` or invocation allowance cannot widen it." }
        fn fix(self) -> String { "Remove this gate or change the owning policy in `{self.policy}`." }
    }
}

struct ComptimeNetUnavailable {
    method: String

    impl Diagnostic {
        code :: "E3412"
        meaning :: "`core.net.{{method}}()` is not available at comptime (only `fetch` is Tier-1)"
        detail :: true
        fn what(self) -> String { "`core.net.{self.method}()` is not available at comptime." }
        fn why(self) -> String { "Only `core.net.fetch(url, sha256:)` is supported at compile time as a Tier-1 hermetic effect. Other `core.net` methods are not planned for comptime access. A `jet build` or `jet run` run reports this comptime-tier diagnostic." }
        fn fix(self) -> String { "Use `core.net.fetch(url, sha256: \"…\")` for content-hash-pinned downloads." }
    }
}

struct FetchHashMismatch {
    url: String

    impl Diagnostic {
        code :: "E3413"
        meaning :: "Comptime `fetch` sha256 mismatch — content hash doesn't match the `sha256:` pin"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Fetch: sha256 mismatch for `{self.url}`." }
        fn why(self) -> String { "The downloaded content does not hash to the expected `sha256:` value. The pin ensures every machine gets byte-identical content; a mismatch means the URL content changed or the pin is wrong." }
        fn fix(self) -> String { "Update the `sha256:` argument to match the actual content hash shown in the Why line, or verify the URL points to the correct file." }
    }
}

struct FetchFailed {
    impl Diagnostic {
        code :: "E3414"
        meaning :: "Comptime `fetch` failed — bad URL, unsupported scheme, network error, or non-UTF-8 content"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Fetch failed / bad argument / non-UTF-8 content (message varies)." }
        fn why(self) -> String { "Common causes: unsupported URL scheme (only `file://`, `http://`, `https://`), unreachable host, missing `sha256:` argument, or binary content (use `embed_bytes` for that). HTTPS TLS failures use E4201–E4203." }
        fn fix(self) -> String { "Check the URL and arguments; use `file://` for local test paths." }
    }
}

struct InvalidBuildSignature {
    impl Diagnostic {
        code :: "E3501"
        stage :: [.Build]
        meaning :: "Selected root `fn build` has the wrong signature"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "`fn build` takes one `Build` and returns nothing." }
        fn why(self) -> String { "Build authority and graph handoff are one typed contract. A different signature cannot be selected by `jet build` or modeled by the LSP." }
        fn fix(self) -> String { "Write `fn build(b: Build) {{ … }}`." }
    }
}

struct BuildPlanFailed {
    impl Diagnostic {
        code :: "E3502"
        stage :: [.Build]
        meaning :: "Programmable build evaluation, graph validation, or generated-source materialization failed"
        detail :: true
        fn what(self) -> String { "Build plan is invalid, build evaluation returned an error, or generated source could not materialize." }
        fn why(self) -> String { "One selected root entry owns one deterministic graph. Handles cannot cross build sessions, outputs need one owner, and generated Jet must become a real file before checking." }
        fn fix(self) -> String { "Fix the named graph node or generated module; inspect it with `jet inspect graph` and `jet inspect explain-build`." }
    }
}

struct BuildAuthorityDenied {
    impl Diagnostic {
        code :: "E3503"
        stage :: [.Build]
        meaning :: "Root build authority is undeclared, ungated, or denied by effective policy"
        detail :: true
        fn what(self) -> String { "This root build asks for authority missing from its declaration, `#Impure` gate, or effective policy." }
        fn why(self) -> String { "Build authority must pass all three independent checks before any probe or action executes." }
        fn fix(self) -> String { "Declare the effect, gate the ambient operation with `#Impure(\"reason\")`, and grant it through `--allow=Exec` for Exec (or the named effect) or package/workspace policy." }
    }
}

struct BuildActionAuthorityDenied {
    action: String
    right: String

    impl Diagnostic {
        code :: "E3504"
        stage :: [.Build]
        meaning :: "Build action requested authority not granted by CLI/package/workspace policy"
        detail :: true
        fix_next :: "Pass the named `--allow=Effect` flag for a one-file build, or grant the effect in package/workspace policy."
        fn what(self) -> String { "Build action `{self.action}` asks for ungranted `{self.right}` authority." }
        fn why(self) -> String { "Source declaration makes authority auditable but does not grant it. Invocation, package, and workspace policy cap ambient effects independently." }
        fn fix(self) -> String { "Pass `--allow={self.right}` for a one-file build, or grant the effect in package/workspace policy." }
    }
}

struct BuildProbeFailed {
    impl Diagnostic {
        code :: "E3505"
        stage :: [.Build]
        meaning :: "Typed probe or sandboxed action execution failed"
        detail :: true
        fn what(self) -> String { "Typed build probe or sandboxed action execution failed." }
        fn why(self) -> String { "Actions run only after graph validation, in a bubblewrap sandbox with declared inputs, outputs, tools, environment, authority, and probes. Jet does not fall back to ambient execution. A `jet build` run reports this typed build-action failure." }
        fn fix(self) -> String { "Fix the named command, probe, toolchain, input/output declaration, or enable a supported sandbox." }
    }
}

struct DuplicateBuildEntry {
    impl Diagnostic {
        code :: "E3520"
        stage :: [.Build]
        meaning :: "One package declares multiple `fn build` entries"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Two build entries for one package: both source sites are shown." }
        fn why(self) -> String { "One package has one build authority, so policy and provenance have one auditable home." }
        fn fix(self) -> String { "Keep one `fn build` and remove every other entry." }
    }
}

struct BuildFactConflict {
