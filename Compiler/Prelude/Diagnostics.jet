InvalidEnumDiscriminant: struct {
    impl Diagnostic {
        code: "E0035"
        safety_class: .Soundness
        safety_reason: "The discriminant sets the enum's layout, and a value that is unknown or does not fit would corrupt it."
        expert_path: "none: the layout needs a known number that fits the representation"
        meaning: "enum discriminant is not a computable integer"
        detail: true

        what: fn(self) -> String {
            "An enum discriminant must be known at compile time and fit the signed integer representation used by the enum layout."
        }

        why: fn(self) -> String {
            "The enum number is part of the type layout, so it must be known before code generation."
        }

        fix: fn(self) -> String {
            "Use an integer literal, a `NAME: #run value` constant, or another compile-time expression that produces an in-range integer."
        }
    }
}

