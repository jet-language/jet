struct UnusedLocalBinding {
    name: String

    impl Diagnostic {
        code :: "L0101"
        severity :: .Lint
        lint_name :: "unused_local_binding"
        meaning :: "An unused local binding is dead code and may hide a missed use (warning)"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .BehaviorPreserving
        fn what(self) -> String { "Local binding `{self.name}` is never read." }
        fn why(self) -> String { "A binding that no later expression reads adds dead code and may hide a computed result that should have been used." }
        fn fix(self) -> String { "Remove the binding when its initializer is side-effect free, or rename `{self.name}` to `_{self.name}` when the value must be computed." }
    }
}

struct UnusedParameter {
    name: String

    impl Diagnostic {
        code :: "L0102"
        severity :: .Lint
        lint_name :: "unused_parameter"
        meaning :: "An unused parameter is dead interface surface (warning)"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .BehaviorPreserving
        fn what(self) -> String { "Parameter `{self.name}` is never used." }
        fn why(self) -> String { "An unused parameter often means the function contract or implementation is incomplete; Jet keeps this warning-only so prototypes stay unblocked." }
        fn fix(self) -> String { "Use `{self.name}`, rename it to `_{self.name}` when it is intentionally unused, or remove it from the function contract." }
    }
}

struct UnusedImport {
    name: String

