        detail :: true
        fn what(self) -> String { "`comptime {{ … }}` is used as a value in a form this compiler does not support yet." }
        fn why(self) -> String { "Jet makes the block's final expression its value. Today only a binding `name :: comptime {{ value }}` whose block holds a single final expression is evaluated while building." }
        fn fix(self) -> String { "Write `name :: comptime {{ value }}` with one final expression, or bind the result inside a `comptime {{ … }}` statement block." }
    }
}

