        fn what(self) -> String { "One {self.command} command has multiple overrides: {self.locations}." }
        fn why(self) -> String { "A command scope can select one override or the stock default, but multiple overrides are ambiguous." }
        fn fix(self) -> String { "Keep one fn {self.command} in the package scope, or remove the other command override." }
    }
}

