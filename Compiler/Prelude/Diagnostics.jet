        detail :: true
        fn what(self) -> String { "`{self.operation}` is not available for target `{self.target}`." }
        fn why(self) -> String { "The selected target has no Prelude adapter for `{self.operation}`; WASI Preview 2 provides TCP/UDP sockets but not this operation. A `jet build` or `jet run` run reports this target-support diagnostic." }
        fn fix(self) -> String { "Use a supported TCP/UDP operation, or build for a native target." }
    }
}

struct PluginImportNotOnTarget {
    module_name: String
    target: String

    impl Diagnostic {
        code :: "E3306"
