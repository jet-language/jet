        detail :: true
        no_fix :: .Behavior
        fix_next :: "Close the open value before the call, or open it in a smaller block that ends before the call"
        fn what(self) -> String { "This tail call can't reuse the frame because `{self.name}` closes after it returns" }
        fn why(self) -> String { "`{self.name}` is still open at the call, and its Close cleanup runs when its scope ends, after the call returns; the call keeps its frame, so a chain of such calls grows the stack" }
        fn fix(self) -> String { "Close `{self.name}` before the call with `close(^{self.name})`, or open it in a smaller block that ends before the call" }
    }
}

