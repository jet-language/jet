    impl Diagnostic {
        code :: "E1345"
        meaning :: "CLI command member has no callable shape"
        detail :: true
        fn what(self) -> String { "CLI command member `{self.name}` has no callable shape" }
        fn why(self) -> String { "A CLI callable member needs a same-module target when bound, at most one first read-only program-struct parameter, and scalar remaining parameters." }
        fn fix(self) -> String { "Bind a visible scalar-parameter function, or use a method on the program struct" }
    }
}

struct CliMembersOnCodable {
    impl Diagnostic {
