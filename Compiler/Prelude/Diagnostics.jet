        fn what(self) -> String { "A `jet os` host names a system the config doesn't define." }
        fn why(self) -> String { "The host selects one `system.<host>` contribution in `config.jet`." }
        fn fix(self) -> String { "Define `system.<host>: {{ … }}`, or select one of the systems the config already defines." }
    }
}

struct OsConfigNotFound {
    impl Diagnostic {
        code :: "E0981"
        stage :: [.Jetpack]
        meaning :: "A `jet os` config file doesn't exist"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "The `jet os` config file doesn't exist." }
        fn why(self) -> String { "A bare host loads `./config.jet`; `host@root` loads `root/config.jet` when `root` is a directory, or the file named by `root`." }
        fn fix(self) -> String { "Create it with `jet os init <host>`, or pass an external root as `host@root`." }
    }
}

struct UseExecutablePackage {
    impl Diagnostic {
        code :: "E0982"
        stage :: [.Jetpack]
        meaning :: "`use <pkg>` names an `executable` package — executables go on PATH, not `use` (U17)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`use <pkg>` named a package that is realized as an `executable`." }
        fn why(self) -> String { "U17: one import concept (`use`) covers files, modules, and `library` packages; an `executable` package installs a binary on your PATH — you run it, you don't import its code." }
        fn fix(self) -> String { "Remove the `use`, and run the executable's binary instead; or, if you meant to import its code, change the package to `library` in `package.jet`." }
    }
}

struct UnrealizedLibrary {
    impl Diagnostic {
        code :: "E0983"
        status :: .Retired
        no_fix :: None
        fn what(self) -> String { "*Retired* (was: `use <pkg>` named a declared library that hasn't been realized)" }
        fn why(self) -> String { "The driver has no realized-library search root in the hangar yet, so it cannot tell an unrealized library from a missing one (E0603 reports both); the code is registered again with its emitter when that root lands" }
        fn fix(self) -> String { "Do not use E0983" }
    }
}

struct UnknownCoreModule {
