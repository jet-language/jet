        fn why(self) -> String { "An implicit subject is one collection item; a scalar source or nested loop needs a distinct named binding." }
        fn fix(self) -> String { "Write `loop item in source -> ...`; give nested loops named bindings." }
    }
}

struct RetiredDeclarationWord {
