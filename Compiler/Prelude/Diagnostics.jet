        meaning :: "Fixed-size list length is not a computable integer"
        detail :: true
        fn what(self) -> String { "A fixed-size list length must be known at compile time, must be an integer, and must fit the target's array-size representation." }
        fn why(self) -> String { "Use a literal, a same-file `@` binding, or another comptime expression that produces an in-range integer; a destructuring pattern must then name exactly that many elements." }
        fn fix(self) -> String { "Use a literal, a same-file `@` binding, or another comptime expression that produces an in-range integer; a destructuring pattern must then name exactly that many elements." }
    }
}

struct FixedListLengthChange {
    impl Diagnostic {
        code :: "E0964"
        meaning :: "Length-changing op (`push`/`pop`/`insert`) on a fixed-size `[T#N]` (S76)"
        detail :: true
        fn what(self) -> String { "A length-changing method (`push`, `pop`, `insert`, `remove`, `clear`) was called on a fixed-size `[T#N]`." }
        fn why(self) -> String { "The length of `[T#N]` is fixed at compile time and cannot change at runtime." }
        fn fix(self) -> String { "If you need a growable list, bind it with `:=` (e.g. `r := [...]`) so its length can change." }
    }
}

struct FixedListIndexOutOfRange {
