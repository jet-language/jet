        fn what(self) -> String { "A distinct type is used where another type is expected" }
        fn why(self) -> String { "A distinct type is never accepted in place of its base type or another distinct type, even when both are built on the same base." }
        fn fix(self) -> String { "Convert explicitly with the distinct type's constructor, or compare the underlying values with `.raw()`." }
    }
}

