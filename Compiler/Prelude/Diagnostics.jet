        fn why(self) -> String { "The registered jet rule applies here. Only Core sources import `core.<area>.runtime` units." }
        fn fix(self) -> String { "Select a declared public core module." }
    }
}

struct ReservedRootShadowed {
    impl Diagnostic {
        code :: "E1002"
        stage :: [.Jet]
        status :: .Reserved
        no_fix :: None
        fn what(self) -> String { "Local module shadows reserved first-party or foreign root/name" }
        fn why(self) -> String { "The registered jet rule applies here" }
        fn fix(self) -> String { "Follow the guidance for E1002" }
    }
}

struct IntegerOutOfRange {
