        detail :: true
        no_fix :: None
        fn what(self) -> String { "`#Known` is retired." }
        fn why(self) -> String { "Compile-time work carries the word `comptime`, and a compile-time constant is `NAME :: comptime {{ value }}`." }
        fn fix(self) -> String { "Write `NAME :: comptime {{ … }}` for a constant, `comptime if <condition> {{ … }}` for a compile-time branch, and `comptime {{ … }}` for a compile-time block." }
    }
}

struct RetiredAliasEquals {
