        fn why(self) -> String { "Imported files provide declarations; executable code belongs in an explicit `fn run`, so an import never gains a hidden side effect." }
        fn fix(self) -> String { "Move the statements into the entry file's `fn run`, or import a declaration-only file." }
    }
}

struct TopLevelStatementsWithoutRun {
    impl Diagnostic {
        code :: "E0621"
        detail :: true
        fn what(self) -> String { "Top-level executable statements require an explicit `fn run`" }
        fn why(self) -> String { "Jet does not invent a runtime function for ordinary files; only an explicit `fn run` executes code." }
        fn fix(self) -> String { "Move the statements into `fn run`." }
    }
}

struct ModuleGlobalNotLiteral {
    impl Diagnostic {
        code :: "E0622"
        meaning :: "A mutable or `#Persist` module global's value is not a literal"
        fix_next :: "Initialize the global from a literal, or keep a computed value in an immutable `::` constant."
        fn what(self) -> String { "A module binding's value must be a literal" }
        fn why(self) -> String { "A mutable or `#Persist` module global is runtime storage, which every execution tier initializes from a scalar literal before `fn run`. An immutable `::` constant may compute its value: the build folds it when it can and computes it at startup otherwise." }
        fn fix(self) -> String { "Use an integer, float, or bool literal, or keep a computed value in an immutable `::` constant." }
    }
}

struct RelativeImportInPackage {
    path: String

    impl Diagnostic {
        code :: "E0623"
        stage :: [.Jet]
        meaning :: "A package file imports another file by relative path"
        fix_next :: "Remove the file import; package files share one namespace."
        fn what(self) -> String { "`use \"{self.path}\"` imports a file, but this file belongs to a package" }
        fn why(self) -> String { "The files of one package share one namespace, so they reach each other's names without imports; only loose files import files by path." }
        fn fix(self) -> String { "Remove the import and use the names directly, or import another package with `use <package>.[names]`." }
    }
}

