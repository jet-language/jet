        fn what(self) -> String { "Replay capture exceeded its artifact limit" }
        fn why(self) -> String { "The replay contained no usable authority or exceeded the bounded frame/payload/record budget." }
        fn fix(self) -> String { "Reduce the captured target or recapture a bounded artifact." }
    }
}

struct ReplayFinalizeFailed {
