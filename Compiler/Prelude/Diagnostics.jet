        fn fix(self) -> String { "Use the typed metadata shape and project-relative paths without `..`." }
    }
}

struct EnvironmentImportEscapes {
    impl Diagnostic {
        code :: "E1331"
        meaning :: "An environment module import escapes its project root"
        detail :: true
        fn what(self) -> String { "An environment import escapes its root" }
        fn why(self) -> String { "One environment graph cannot import files outside its project boundary." }
        fn fix(self) -> String { "Use a relative import directory without `..` or an escaping symlink." }
    }
}

struct EnvironmentDefinitionConflict {
    impl Diagnostic {
        code :: "E1332"
        meaning :: "One environment preset or package generation is composed with conflicting definitions"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Preset or generation definitions conflict" }
        fn why(self) -> String { "Composition cannot silently choose one definition's packages, variables, parents, or collision choices over another's." }
        fn fix(self) -> String { "Merge equal facts or give them different names." }
    }
}

struct InvalidEnvironmentFact {
    impl Diagnostic {
        code :: "E1333"
        stage :: [.Sema, .Jetpack]
        meaning :: "A typed environment fact, language-pack selection, dotenv declaration, or Git hook path is invalid or conflicting"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "A typed environment fact is invalid or unusable" }
        fn why(self) -> String { "Language packs use one catalog with explicit host, platform, license, and required-tool facts. Dotenv paths stay inside the project, expert allowlists make secret handling explicit, and Git hook paths stay inside the project and name an existing directory." }
        fn fix(self) -> String { "Fix the language selection/catalog fact, use a project-relative file and `Dotenv{{ file, allow, secrets }}` with valid variable names, or create an in-project directory for `git_hooks_path`." }
    }
}

struct InvalidWorkspaceMember {
