        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`{self.count}` package refs lack a supported Nix compatibility output." }
        fn why(self) -> String { "The listed refs need pinned compatibility outputs. Jetpack does not invoke an installed Nix executable for package realization, so native core and adapted packages can proceed while unsupported Nix refs are reported as holes. A `jetpack add` run reports this package-adapter error." }
        fn fix(self) -> String { "Provide a pinned fixture or verified Hangar output, or replace the listed refs with native sources/adapters; `jetpack add <ref> --adapt` drafts an adapter snippet." }
    }
}

struct ReservedRecipeBuildFailed {
