        fn why(self) -> String { "The inferred constructor uses the surrounding expected type; Jet does not search a global constructor registry" }
        fn fix(self) -> String { "Write the full `Type.new(...)` form, or use `.new(...)` where its type is already expected" }
    }
}

struct MemberShorthandAsValue {
