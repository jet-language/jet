        fn why(self) -> String { "The scheduler derives dependencies, transfers, lifetimes, and reuse only from checked access and completion facts; an unresolved alias or completion would make execution unsafe." }
        fn fix(self) -> String { "Move the call out of the frame callback, or give the operation a complete checked access contract and its real completion event." }
    }
}

