    capability: String

    impl Diagnostic {
        code :: "E3311"
        meaning :: "Selected target does not provide a required capability"
        detail :: true
        fix_next :: "Select a typed target profile with the required capability provider, or remove the operation."
        fn what(self) -> String { "Target `{self.target}` lacks the required `{self.capability}` capability." }
        fn why(self) -> String { "The selected target profile must state each machine service separately; a target triple cannot imply a UART, clock, entropy source, scheduler, allocator, startup provider, or MMIO device." }
        fn fix(self) -> String { "Select a typed target profile with a `{self.capability}` provider, or remove the reachable operation." }
    }
}

