        meaning :: "Non-deterministic construct in pure evaluation (e.g. time/random)"
        detail :: true
        fn what(self) -> String { "`{self.what_text}` is non-deterministic and cannot appear in a pure evaluation." }
        fn why(self) -> String { "Pure evaluation must produce the same result on every machine." }
        fn fix(self) -> String { "Remove this call, or remove the enclosing function's explicit empty effect bound." }
    }
}

struct NondeterministicWorldEffect {
    call: String

    impl Diagnostic {
        code :: "E3404"
        meaning :: "Uncontrolled effect inside a deterministic world"
        detail :: true
        fn what(self) -> String { "`{self.call}` has no deterministic world provider." }
        fn why(self) -> String { "`testing.world` controls virtual time, scheduling, and seeded pseudo-randomness; external effects cannot be replayed." }
        fn fix(self) -> String { "Move the call outside `testing.world`, or use a world-supported provider." }
    }
}

struct DebugTraceInRelease {
