struct PointerAcrossCBoundary {
    ty: String

    impl Diagnostic {
        code :: "E3202"
        meaning :: "pointer/gated type crosses C boundary outside `#Unsafe` / `core.mem`"
        detail :: true
        fn what(self) -> String { "Type `{self.ty}` cannot cross the C boundary here." }
        fn why(self) -> String { "C FFI allows by-value scalars and `String` in ordinary code; pointers and other gated types need `use core.mem` and an `#Unsafe {{ … }}` region." }
        fn fix(self) -> String { "Move the call inside `#Unsafe`, or change the type to a C-safe value type." }
    }
}

struct NonCAbiType {
    ty: String

    impl Diagnostic {
        code :: "E3203"
        meaning :: "Non-C-ABI type in `#Import` / `#Bindgen` fn signature"
        detail :: true
        fn what(self) -> String { "`{self.ty}` is not a C-compatible type for a foreign function parameter or return." }
        fn why(self) -> String { "`#Import` / `#Bindgen` functions must use types with a stable C ABI at the edge. A `jet build` run reports this C boundary or linker diagnostic." }
        fn fix(self) -> String { "Use scalars, `String`, or a struct with C layout; pointers only through the gated tier." }
    }
}

struct DuplicateCLibraryUse {
    lib: String
    header: String

    impl Diagnostic {
        code :: "E3204"
        meaning :: "Two C `use` forms for the same lib in one file"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Two different `use` forms refer to the same C library `{self.lib}`." }
        fn why(self) -> String { "S59 allows one bring-in per C lib per file — either `use alias :: \"{self.header}\"` or `use alias :: c.{self.lib}`, not both." }
        fn fix(self) -> String { "Remove one line; keep the form that matches your workflow." }
    }
}

struct OverlayBindingConflict {
    name: String
    lib: String

    impl Diagnostic {
        code :: "E3205"
        meaning :: "Overlay symbol clashes with bindgen (incompatible signature)"
        detail :: true
        fn what(self) -> String { "Overlay `{self.name}` disagrees with the generated binding." }
        fn why(self) -> String { "User `#Import module c.{self.lib}` may override bindgen symbols, but the Jet signature must stay compatible when replacing." }
        fn fix(self) -> String { "Match the generated signature, or rename your overlay function." }
    }
}

struct ReservedBindgenSegment {
    path: String
    lib: String

    impl Diagnostic {
        code :: "E3206"
        stage :: [.Parse]
        status :: .Reserved
        meaning :: "User declared reserved `__bindgen__` segment"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "Module path `{self.path}` uses the reserved segment `__bindgen__`." }
        fn why(self) -> String { "Autogen lives in `c.{self.lib}.__bindgen__`; users declare overlays as `#Import module c.{self.lib}` only." }
        fn fix(self) -> String { "Drop `__bindgen__` from your module path, or use `#Import module c.{self.lib} {{ … }}`." }
    }
}

struct BindgenOutsideGenerated {
    lib: String

    impl Diagnostic {
        code :: "E3207"
        stage :: [.Parse]
        meaning :: "`#Bindgen` outside generated `.jet/bindings/c/` file"
        detail :: true
        fn what(self) -> String { "`#Bindgen` is only allowed in generated cache files." }
        fn why(self) -> String { "`.jet/bindings/c/{self.lib}.jet` is written by `jet inspect bind`; hand-written sources use `#Import module`." }
        fn fix(self) -> String { "Edit your overlay file with `#Import module`, or regenerate the cache with `jet inspect bind`." }
    }
}

struct BindingGenerationFailed {
