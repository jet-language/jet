struct MoveWithoutMarker {
    impl Diagnostic {
        code :: "E0209"
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .BehaviorPreserving
        fn what(self) -> String { "A named binding passed without `^` to a take parameter where the call is not its last use — it is read again later, on a later loop pass, or in another argument of the same call — or that keeps a required `^` (a value with cleanup, a type parameter, a capture), or a std constructor consuming a borrowed value" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Pass a copy with `.copy()`, reorder so the call is the name's last use, or write `^` where the value must be handed over." }
    }
}

struct RetiredPointerAlias {
