        no_fix :: None
        fix_safety :: .Formatting
        fn what(self) -> String { "`A | B!` marks only `B` as the error contract." }
        fn why(self) -> String { "The `!` mark follows one type, so a union of error types is grouped for the mark to cover every member." }
