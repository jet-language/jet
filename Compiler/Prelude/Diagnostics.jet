        meaning :: "An App feature is not available for the resolved target"
        detail :: true
        fix_next :: "Choose a target that supports the feature, or remove the feature."
        fn what(self) -> String { "App feature `.{self.feature}` needs target `{self.required}`, but the resolved target is `{self.target}`." }
        fn why(self) -> String { "App is one type across targets, but each feature must be supported by the target selected by `#Target` or the package manifest; rejecting it in sema keeps AOT, JIT, interpreter, and web codegen on one meaning (I9). During `jet check`, Jet reports this diagnostic." }
        fn fix(self) -> String { "Choose a build target that supports `.{self.feature}` (for example `#Target(JS)` for browser features or a native target for server features), or remove that feature." }
    }
}

