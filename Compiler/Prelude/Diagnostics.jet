    impl Diagnostic {
        code :: "E3521"
        stage :: [.Build]
        meaning :: "A build fact has conflicting values from the same contribution layer"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Two writers at the same contribution layer gave different values for `{self.fact}`; both source locations are shown." }
        fn why(self) -> String { "Cross-layer overrides are legal, but same-layer disagreement is ambiguous and cannot be selected by source order." }
        fn fix(self) -> String { "Make the named writers agree, or move one value to a more explicit contribution layer." }
    }
}

struct DuplicateCommandOverride {
