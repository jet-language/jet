    impl Diagnostic {
        code :: "E1355"
        stage :: [.Jet]
        meaning :: "A Jet command needing a declared project environment was run outside it"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "This project declares {self.environment}; `{self.command}` is not running inside its verified environment." }
        fn why(self) -> String { "Jetpack preparation is disabled for this command. `jet run` delegates the declared environment unless `--no-prepare` is supplied; other verbs must be invoked through the existing Jetpack environment boundary." }
        fn fix(self) -> String { "For `jet run`, remove `--no-prepare` and retry `{self.command}`; for another verb, run `jetpack env -- {self.command}`." }
    }
}

struct EnvironmentPreparationFailed {
