        fn what(self) -> String { "C library `{self.lib}` was not found." }
        fn why(self) -> String { "Jet looked for a `{self.lib}: c@…` dep in `package.jet`, then tried `pkg-config {self.lib}` on the system; neither provided include/link paths." }
        fn fix(self) -> String { "Install the system package (e.g. `pacman -S {self.lib}`), or declare it as `{self.lib}: c@system` in `deps:`." }
