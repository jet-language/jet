        fix_next :: "Choose one intent before changing the loop: separate result, fixed original set, or explicit work queue; no automatic rewrite can preserve an unknown traversal contract."
        fn what(self) -> String { "While the loop is reading `{self.name}`, nothing may change it" }
        fn why(self) -> String { "The loop reads `{self.name}` across its body, so {self.operation} can change the visited domain, element order, or termination." }
        fn fix(self) -> String { "Choose the collection intent explicitly: use a separate result when the original traversal should stay unchanged; snapshot `{self.name}` and iterate the fixed original set when only the original values belong in the traversal; or use an explicit work queue when newly added values should be visited. Do not use index traversal unless its fixed domain and result meaning are intended." }
    }
}

