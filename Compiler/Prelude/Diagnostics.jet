        fn fix(self) -> String { "Review the generated shim and add `{self.field}`'s effect by hand if you need it — the shim is a starting point, not a full translation." }
    }
}

struct UnsandboxedBuildFallback {
    impl Diagnostic {
        code :: "L0205"
        severity :: .Lint
        lint_name :: "unsandboxed_build_fallback"
        stage :: [.Jetpack]
        meaning :: "Build sandboxing is unavailable and trusted substitution is allowed by policy (U28)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Build sandboxing is unavailable; local executable actions will be refused after substitution/remote resolution." }
        fn why(self) -> String { "Jet requires a strong sandbox for fetched or transitive executable actions. Jetpack may use a trusted substitute or approved remote builder, but never an unsandboxed local action. A `jetpack env` run reports this sandbox warning." }
        fn fix(self) -> String { "Provide a trusted substitute or approved remote builder, or enable the native sandbox." }
    }
}

struct SharedGuardLongScope {
    method: String

    impl Diagnostic {
        code :: "L0206"
        severity :: .Lint
        lint_name :: "shared_guard_long_scope"
        meaning :: "A `SharedGuard` lock spans a long lexical scope"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "`` `Shared.{self.method}()` keeps its lock through a long lexical scope ``." }
        fn why(self) -> String { "A `SharedGuard` releases at scope exit, so later statements and nested guard acquisitions run while this lock is held." }
        fn fix(self) -> String { "Move the guarded work into a smaller block. When nesting guards is necessary, acquire them in one stable order." }
    }
}

struct SharedBusyWait {
    impl Diagnostic {
        code :: "L0207"
        severity :: .Lint
        lint_name :: "shared_busy_wait"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .BehaviorPreserving
        fn what(self) -> String { "This unbounded loop polls `Shared` state without waiting" }
        fn why(self) -> String { "An empty or non-blocking body reads a lock-backed value repeatedly and can consume a core while another task makes progress" }
        fn fix(self) -> String { "Wait on a `Condition` through an edit guard, or receive from a channel; an empty plain-field predicate can use that wait directly" }
    }
}

struct CompilerExtension {
    impl Diagnostic {
        code :: "L1401"
        severity :: .Lint
        status :: .Retired
        no_fix :: None
        fn what(self) -> String { "*Retired* (was: a configured compiler-extension component reported a finding)" }
        fn why(self) -> String { "No compiler-extension host runs a configured component after type checking yet, so no finding can reach this report; the code is registered again with its emitter when that host lands" }
        fn fix(self) -> String { "Do not use L1401" }
    }
}

struct CompilerExtensionFailed {
    message: String

    impl Diagnostic {
        code :: "E1402"
        stage :: [.Jet]
        meaning :: "Compiler-extension host failure (load/analyze/validate fail-closed)"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "Compiler-extension failed: {self.message}" }
        fn why(self) -> String { "The configured compiler-extension component could not complete `analyze`, or returned an invalid response. Guests are sandboxed; failures stay Jet-owned (I2)." }
        fn fix(self) -> String { "Fix the component, or unset `JET_COMPILER_EXTENSION` to skip the extension." }
    }
}

struct NestingTooDeep {
    depth: String

    impl Diagnostic {
        code :: "E1403"
        stage :: [.Compile]
        meaning :: "Source nesting exceeds the shared parser and sema limit of 256"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "This code nests {self.depth} levels deep; the limit is 256" }
        fn why(self) -> String { "Each nested source form needs one compiler checking frame, and unbounded depth could overflow the compiler stack. The parser and sema enforce the same published limit. During `jet check`, Jet reports this diagnostic." }
        fn fix(self) -> String { "Pull inner parts out into named bindings or helper functions." }
    }
}

