        detail :: true
        edit :: .Remove
        edit_from :: ","
        no_fix :: None
        fix_safety :: .Formatting
        fn what(self) -> String { "A guard follows its source with no comma." }
        fn why(self) -> String { "The guard self-announces with `if`, so the loop head only uses commas between positional clauses." }
        fn fix(self) -> String { "Remove the comma before `if`." }
    }
}

struct LoopMissingBinding {
