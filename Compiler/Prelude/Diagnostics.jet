        fn why(self) -> String { "An inclusive range that ends at a list's length runs one step too far when the body indexes that list." }
        fn fix(self) -> String { "Write `loop (i, item) in xs` — or `loop i in xs.indexes()` — or `0..<xs.len()`." }
