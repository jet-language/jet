        fn what(self) -> String { "{self.what_text}" }
        fn why(self) -> String { "Store commands are grouped under `hangar`; project commands stay at the top level." }
        fn fix(self) -> String { "{self.fix_text}" }
    }
}

struct OutsideProjectEnvironment {
