    impl Diagnostic {
        code :: "E3405"
        meaning :: "A `debug(…)` trace is left in a shipped or release-profile build"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .BehaviorPreserving
        fn what(self) -> String { "A `debug` trace is left at `{self.site}`." }
        fn why(self) -> String { "`debug(value)` is a development trace: it prints while you run, test, or interpret a program and adds no effect, so a shipped artifact (`jet build`) or a release-profile build must not contain it." }
        fn fix(self) -> String { "Remove the `debug(…)` wrapper and keep the expression; `jet fix` applies this edit." }
    }
}

struct ReplFuelExhausted {
    impl Diagnostic {
        code :: "E1801"
        status :: .Retired
        no_fix :: None
        fn what(self) -> String { "*Retired* (was: a REPL snippet ran more than its interpreter step cap)" }
        fn why(self) -> String { "The REPL does not interpret: each turn is built and run by a child `jet`, as `jet run` runs a program, so there is no step cap to exhaust; a turn that never ends is stopped with Ctrl-C" }
        fn fix(self) -> String { "Do not use E1801" }
    }
}

struct ReplFeatureNotSupported {
    feature: String

    impl Diagnostic {
        code :: "E1802"
        stage :: [.Repl]
        meaning :: "Hard-rejected feature in the REPL (FFI, tasks, `#Unsafe`, OS-level APIs)"
        detail :: true
        fn what(self) -> String { "The REPL interpreter can't run `{self.feature}`." }
        fn why(self) -> String { "The REPL is an interpreter for learning Jet; some features — FFI, tasks/channels, `#Unsafe`, and OS-level APIs — require the real compiler. A `jet repl` run reports this interpreter limitation." }
        fn fix(self) -> String { "Run `jet run <file.jet>` or `jet build <file.jet>` to use the full compiler." }
    }
}

struct ApplicationAuthorityDenied {
    impl Diagnostic {
        code :: "E1803"
        stage :: [.Repl]
        meaning :: "Application authority is undecided or denies a required effect"
        detail :: true
        edit :: .SuggestedSourceEdit
        no_fix :: None
        fix_safety :: .NeedsReview
        fn what(self) -> String { "Application authority is undecided or denies a required effect; the Why line says in one sentence what the program tried to do and which policy has not allowed it." }
        fn why(self) -> String { "Execution stops before host state changes. Every program already allows printing, reading input, allocating memory, and reading the program's own arguments; a written `allow` row adds any other effect, and only `deny` takes a right away. `--json` carries the raw `required_effects`, `granted_effects`, `denied_effects`, and `authority` facts." }
        fn fix(self) -> String { "Add the effects the report names under `authority` in `package.jet`, for example `allow: [FS]`; the row adds to what every program already holds. A program with no `package.jet` declares that row in a leading `package {{ … }}` block of its entry file; `jet fix --all` inserts that block. For one run, `--allow=<RIGHTS>` grants the named effects and `-A` (`--allow-all`) grants every effect; a file whose first line is `#!/usr/bin/env jet` is a script and always runs that way. Otherwise deny effects deliberately, or approve the exact operation once or for the project in an interactive terminal." }
    }
}

