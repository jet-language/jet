MisplacedShebang: struct {
    impl Diagnostic {
        code: "E0042"
        safety_class: .Opinion
        safety_reason: "A later `#!` line could be ignored safely, and Jet refuses it so a pasted launch line is not silently dead."
        stage: [.Lex]
        meaning: "Shebang line is only recognized at the start of a Jet file"
        detail: true

        what: fn(self) -> String {
            "A shebang line is only recognized at the very start of the file"
        }

        why: fn(self) -> String {
            "The operating system reads launch metadata only from byte 0; Jet does not treat another `#!` as a launch line"
        }

        fix: fn(self) -> String { "Move `#!...` to line 1, or delete it" }
    }
}

