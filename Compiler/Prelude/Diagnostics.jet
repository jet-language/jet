    }
}

struct NetworkOperationFailed {
    operation: String
    address: String
    detail: String

    impl Diagnostic {
        code :: "E2801"
        stage :: [.Compile]
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "{self.operation} on `{self.address}` failed: {self.detail}." }
        fn why(self) -> String { "A socket bind, listen, connect, or accept call returned an OS error. The address and operation are named so you can act on the specific failure." }
        fn fix(self) -> String { "Check that the address is reachable and the port is not already in use. For `bind`, try a different port. For `connect`, verify the server is running." }
    }
}

struct ServerTlsHandshakeFailed {
    host: String
    detail: String

    impl Diagnostic {
        code :: "E2802"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "TLS handshake with `{self.host}` failed: {self.detail}." }
        fn why(self) -> String { "The TLS layer could not complete a secure handshake — the certificate may be invalid, expired, or untrusted by the system trust store." }
        fn fix(self) -> String { "Verify the server's certificate, ensure the system trust store is up-to-date, or use `core.net.tls.insecure_skip_verify()` in a test environment only." }
    }
}

struct RequestBodyTooLarge {
    limit: String

    impl Diagnostic {
        code :: "E2803"
        stage :: [.Compile]
        detail :: true
        fn what(self) -> String { "Request body exceeds the {self.limit}-byte limit." }
        fn why(self) -> String { "The server's configured `max_body` cap was reached. Allowing unbounded bodies risks memory exhaustion." }
        fn fix(self) -> String { "Raise the `max_body` option passed to `http.serve`, or reject the request in your handler before reading the body." }
    }
}

struct AmbiguousRoute {
    method: String
    pattern: String

    impl Diagnostic {
        code :: "E2804"
        stage :: [.Compile]
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "Two routes both match `{self.method} {self.pattern}`." }
        fn why(self) -> String { "A duplicate route makes dispatch ambiguous — one handler would never be reached. Registered at start-up so the bug surfaces immediately." }
        fn fix(self) -> String { "Remove one of the duplicate registrations, or make the patterns distinct (e.g. add a static prefix to one)." }
    }
}

struct InvalidRoute {
    pattern: String
    reason: String

    impl Diagnostic {
        code :: "E2805"
        stage :: [.Compile]
        detail :: true
        fix_next :: "Fix the path or handler signature before registration."
        fn what(self) -> String { "Invalid HTTP route `{self.pattern}`: {self.reason}." }
        fn why(self) -> String { "Route patterns and typed inputs define one checked endpoint contract. Paths bind by handler name, and their types must support Decode." }
        fn fix(self) -> String { "Use `:name` or final `*name` with a matching decodable handler parameter; fix the path or handler signature before registration." }
    }
}

struct MissingPageFunction {
