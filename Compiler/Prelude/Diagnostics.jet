        meaning :: "An explicit workspace member is missing or is not a Package directory"
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "An explicit workspace member is not a Package directory" }
        fn why(self) -> String { "Workspace membership names existing Package roots; a missing or manifest-free directory cannot become a stable graph node." }
        fn fix(self) -> String { "Create `package.jet`, correct the path, or use `find(\"./packages\")`." }
    }
}

struct EnvironmentIntegrationConflict {
    impl Diagnostic {
        code :: "E1335"
        stage :: [.Sema, .Jetpack]
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "An environment integration, package-generation provider fact, or executable lease handoff is conflicting, lossy, or invalid" }
        fn why(self) -> String { "Integrations and package generations lower into shared typed facts; an executable child may use only a verified leased output, so a path that escapes the lease or a failed handoff cannot run. A `jetpack env` run reports this package-generation error." }
        fn fix(self) -> String { "Merge the declarations, use a supported package ref, or re-realize the package so Jetpack can hand only its verified lease to the child." }
    }
}

struct ImageProjectionFailed {
    impl Diagnostic {
        code :: "E1336"
        stage :: [.Jetpack]
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "An environment image cannot project a service, verified package output, or extra file" }
        fn why(self) -> String { "Jet keeps image layers tied to verified Hangar output and explicit safe project files. A service needs the typed supervisor; an absent, empty, conflicting, or wrong-platform package output, or a missing, unsafe, or secret extra file cannot be copied into an image. A `jet image` run reports this environment-image error." }
        fn fix(self) -> String { "Run the declared service through `jetpack services`, realize the environment package for the image target, or choose a regular project-relative non-secret extra file and run `jet image` again." }
    }
}

struct ConcurrentCaptureNotOwned {
    value: String
    boundary: String
    reason: String

    impl Diagnostic {
        code :: "E1101"
        meaning :: "Concurrent capture needs ownership"
        detail :: true
        fn what(self) -> String { "`{self.value}` cannot cross the `{self.boundary}` boundary: the value writes shared state" }
        fn why(self) -> String { "The `{self.boundary}` boundary can run concurrently with its owner; {self.reason}" }
        fn fix(self) -> String { "Give it with `^`, freeze it with `freeze`, or share it with `shared`" }
    }
}

struct ValueNotSendable {
    impl Diagnostic {
        code :: "E1102"
        meaning :: "Value crossing a concurrent boundary is not sendable"
        detail :: true
        fn what(self) -> String { "A value crossing a task, channel, parallel-worker, or safe-kernel boundary is not sendable." }
        fn why(self) -> String { "Concurrent boundaries move owned data between workers. A view, trait value, mutable capture, borrowed closure, or thread-confined cell cannot cross." }
        fn fix(self) -> String { "Send plain owned data, make an ordinary owned copy when permitted, or use `Shared<T>` for deliberate shared state." }
    }
}

struct DetachUnsendableTask {
    impl Diagnostic {
        code :: "E1103"
        meaning :: "`.detach()` called on a task that had a sendability error at spawn"
        detail :: true
        fn what(self) -> String { "`.detach()` called on a task that had a sendability error (E1102) at spawn." }
        fn why(self) -> String { "A detached task runs unsupervised and may outlive the caller; a task that already has sendability problems is doubly unsafe to detach." }
        fn fix(self) -> String { "Fix the E1102 error at the spawn site first; once the task only holds owned data, `.detach()` is safe." }
    }
}

struct GrowableFieldInCLayout {
    impl Diagnostic {
        code :: "E1104"
        meaning :: "`#Layout(c)` struct contains a growable field"
        detail :: true
        fn what(self) -> String { "`#Layout(c)` struct contains a field whose type is growable (`[T]`, `Map`, or `String`)." }
        fn why(self) -> String { "Growable heap types don't have a stable C layout — the raw data pointer and length live at unpredictable offsets." }
        fn fix(self) -> String { "Use a fixed-size array `[T#N]` instead, or remove `#Layout(c)` if C interop is not required." }
    }
}

struct ReservedPackedLayout {
    impl Diagnostic {
        code :: "E1105"
        status :: .Reserved
        meaning :: "`#Layout(packed)` / first-argument `#Layout(align(N))` not yet supported (reserved)"
        detail :: true
        fn what(self) -> String { "`#Layout(packed)`, `#Layout(c, packed)` or `#Layout(align(N))` written on a struct." }
        fn why(self) -> String { "The supported variants are `c`, `columnar`, and the second argument `align(N)` or `align(target, N)` on `#Layout(c)`; `packed` and first-argument `align` remain reserved." }
        fn fix(self) -> String { "Use `#Layout(c)`, `#Layout(c, align(64))`, `#Layout(c, align(target, 2097152))`, or `#Layout(columnar)`." }
    }
}

struct DetachWithView {
    impl Diagnostic {
        code :: "E1106"
        meaning :: "`.detach()` called on a task that captured a `view` borrow — the view may outlive the caller"
        detail :: true
        fn what(self) -> String { "`.detach()` called on a task that captured a `view` borrow." }
        fn why(self) -> String { "A detached task runs unsupervised and may outlive the borrow's source; the captured `view` would dangle." }
        fn fix(self) -> String { "Pass an owned `copy`, or a `Shared<T>` handle, to the task instead of a `view`." }
    }
}

struct ReservedColumnarPrefix {
    impl Diagnostic {
        code :: "E1107"
        status :: .Reserved
        meaning :: "`columnar [T]` per-container layout prefix is reserved"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "The per-container layout prefix `columnar [T]` was written in a type." }
        fn why(self) -> String { "A per-use columnar override isn't built yet — only the whole-struct form `#Layout(columnar) struct …` ships in v1 (this spelling is reserved)." }
        fn fix(self) -> String { "Put `#Layout(columnar)` on the `struct` declaration instead." }
    }
}

struct ColumnarMethodNotSupported {
    impl Diagnostic {
        code :: "E1108"
        meaning :: "List method not yet supported on a `#Layout(columnar)` list"
        detail :: true
        fn what(self) -> String { "A list method (e.g. `.map`, `.filter`, `.sort`, `.pop`, `.remove`, `.get`) was called on a `#Layout(columnar)` list." }
        fn why(self) -> String { "v1 columnar lists support the core surface — indexing, field access, `len`, `is_empty`, `push`, and iteration; the rest is deferred rather than silently miscompiled." }
        fn fix(self) -> String { "Drop `#Layout(columnar)` from the struct to use the full list API, or rewrite the operation with indexing and a loop." }
    }
}

struct PartialColumnarLayout {
    impl Diagnostic {
        code :: "E1109"
        meaning :: "Partial `#Layout(columnar: …)` is deferred — whole-struct only in v1"
        detail :: true
        fn what(self) -> String { "A partial columnar annotation `#Layout(columnar: f, g)` was written." }
        fn why(self) -> String { "v1 supports whole-struct columnar only — every field becomes a column; per-field columnar needs new ownership/aliasing surface (deferred)." }
        fn fix(self) -> String { "Write `#Layout(columnar)` to convert the whole struct." }
    }
}

struct TaskOutsideGroup {
    impl Diagnostic {
        code :: "E1110"
        meaning :: "`task` has no active lexical or parameter task group, targets a group other than the innermost active one, or lets `Group` escape"
        detail :: true
        fn what(self) -> String { "The bare `task` keyword needs a lexical `task.group` or a `Group` parameter, always targets the innermost active one, or `Group` is stored or captured by an escaping lambda." }
        fn why(self) -> String { "Structured spawning uses the innermost active lexical `task.group` or a direct `Group` parameter. A group may flow down the call stack, but it cannot become stored state or escape its scope." }
        fn fix(self) -> String { "Write `task work()` inside the active group, or pass that handle directly to `fn helper(group: Group)`; do not store or capture it." }
    }
}

