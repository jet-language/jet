    impl Diagnostic {
        code :: "E3102"
        meaning :: "Low-level memory vocabulary used without `use core.mem`"
        detail :: true
        fn what(self) -> String { "`{self.item}` is part of the low-level tier." }
        fn why(self) -> String { "Naming `Ptr`, `volatile_read`, or an allocator needs the discovery gate. During `jet check`, Jet reports this diagnostic." }
        fn fix(self) -> String { "Add `use core.mem;` at the top of the file." }
    }
}

struct UnsafeCallOutsideUnsafe {
