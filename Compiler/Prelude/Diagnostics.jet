        fn why(self) -> String { "The registered jetpack rule applies here. A `jetpack hangar` run reports this external-root mutation conflict." }
        fn fix(self) -> String { "Re-read the hangar root and retry the mutation against its current etag." }
    }
}

struct InvalidOutput {
    impl Diagnostic {
        code :: "E1321"
        meaning :: "A typed `Output` kind, payload, callable reference, callable contract, visibility, or singular selection is invalid"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "The Output kind, payload, entry reference, callable contract, or singular selection is invalid" }
        fn why(self) -> String { "`Output` has nine closed kinds; runnable entries are checked function references. Executables take zero or one CLI-derived parameter, Services and Checks take none, and all return `()` or `!`. A singular run without `fn run` also needs one unambiguous Executable." }
        fn fix(self) -> String { "Use a ratified kind and fields, point `entry:` at one visible safe function with the role's exact signature, or select one of the listed Executables explicitly." }
    }
}

