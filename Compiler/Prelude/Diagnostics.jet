        detail :: true
        fn what(self) -> String { "Replay artifact could not be finalized" }
        fn why(self) -> String { "Destination path, rename, or durability checks refused the write." }
        fn fix(self) -> String { "Fix the path and retry; differing existing bytes are never overwritten." }
    }
}

struct EmptyTest {
    impl Diagnostic {
        code :: "L2901"
        severity :: .Lint
        lint_name :: "empty_test"
        stage :: [.Compile]
        detail :: true
        no_fix :: .Behavior
        fn what(self) -> String { "This `#Test` block has no assertions." }
        fn why(self) -> String { "A test with no `assert`, `assert_eq`, or `expect(…).snapshot()` call cannot find bugs — it always passes." }
        fn fix(self) -> String { "Add at least one assertion, or remove the test if it only exercises compilation." }
    }
}

struct CognitiveComplexity {
