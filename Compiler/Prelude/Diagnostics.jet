struct RetiredTakeCapture {
    impl Diagnostic {
        code :: "E0057"
        stage :: [.Parse]
        status :: .Retired
        meaning :: "Retired `take(...)` closure capture prefix; captures are implicit"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "This closure uses the retired `take(...)` capture prefix." }
        fn why(self) -> String { "Escaping closures infer ownership. Copyable values copy at closure creation, and other owned values move. A capture prefix cannot create a second owner." }
        fn fix(self) -> String { "Remove `take(...)` and use the captured names directly." }
    }
}

