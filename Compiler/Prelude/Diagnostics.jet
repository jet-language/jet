        fn why(self) -> String { "Realize-class verbs must run from the current lock and local hangar when offline. Network-class verbs (`add`, `update`, `outdated`, publish/cache sync) cannot refresh metadata under `--offline`, and a missing local object cannot be fetched." }
        fn fix(self) -> String { "Drop `--offline` for this command, or realize/fetch the needed object before going offline." }
    }
}

