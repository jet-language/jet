        fix_next :: "Choose a distinct package name before publishing."
        fn what(self) -> String { "Registry package name `{self.name}` is suspicious: {self.reason}" }
        fn why(self) -> String { "A name in the warning band is close enough to an existing registry name to confuse package selection, but this publish remains non-blocking while the owner policy allows it." }
        fn fix(self) -> String { "Choose a distinct package name instead of `{self.reference}` before publishing; the closer block band and reserved suffix rules reject stronger matches." }
    }
}

