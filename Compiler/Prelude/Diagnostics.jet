        no_fix :: None
        fn what(self) -> String { "*Retired* (was: pointer alias teaching)" }
        fn why(self) -> String { "The registered parse rule applies here" }
        fn fix(self) -> String { "Follow the guidance for E0210" }
    }
}

struct CopyNotSupported {
    impl Diagnostic {
        code :: "E0211"
        no_fix :: .Ambiguous
        fn what(self) -> String { "`x.copy()` on a value that can't be copied — a function, a trait value, or a type Jet doesn't know how to duplicate" }
        fn why(self) -> String { "The registered sema rule applies here" }
        fn fix(self) -> String { "Call `.copy()` only on a copyable value, or move the value with `^` instead." }
    }
}

struct OwnerMovedWhileViewed {
    impl Diagnostic {
        code :: "E0212"
        meaning :: "An owner is moved, replaced, or resized while a live view still points into its storage"
        detail :: true
        fn what(self) -> String { "An owner is moved, replaced, or resized while a live view still points into it." }
        fn why(self) -> String { "The operation could move or destroy the storage that the view reads or edits; Jet rejects before lowering instead of relying on a backend borrow error." }
        fn fix(self) -> String { "Finish using the view before changing the owner, narrow the view's scope, or make an owned copy." }
    }
}

struct WriteMarkerNotOnPlace {
    impl Diagnostic {
        code :: "E0213"
        meaning :: "The write-access marker `&` is not on a place — a name plus maximal field/index/range projections"
        detail :: true
        fn what(self) -> String { "A read or write window starts from something that is not a place." }
        fn why(self) -> String { "Only a name followed by fields, indexes, or one range has stable storage that can be accessed without copying." }
        fn fix(self) -> String { "Bind the call or temporary to a name first, then take the window from that name." }
    }
}

struct RetiredViewMethod {
    impl Diagnostic {
        code :: "E0214"
        status :: .Retired
        meaning :: "Teaching: retired `.view(a..b)` → bare range place `[a..b]`"
        detail :: true
        no_fix :: None
        fn what(self) -> String { "`.view(a..b)` uses the retired list-window spelling." }
        fn why(self) -> String { "Place access follows the sigil reading rule above." }
        fn fix(self) -> String { "Replace `value.view(a..b)` with `value[a..b]`." }
    }
}

struct InvalidGuardMap {
    impl Diagnostic {
        code :: "E0215"
        meaning :: "`SharedGuard.map` projection is not a stable stored field place"
        detail :: true
        fn what(self) -> String { "`` `SharedGuard.map` needs a stored field projection ``." }
        fn why(self) -> String { "A mapped guard must keep a stable stored place inside the value protected by the original lock. A computed field is a value, not a place." }
        fn fix(self) -> String { "Use a direct stored-field projection such as `guard.map(value -> value.field)`." }
    }
}

struct InvalidGuardSplit {
    impl Diagnostic {
        code :: "E0216"
        meaning :: "`SharedGuard.split` projections overlap or are not stable stored field places"
        detail :: true
        fn what(self) -> String { "`` `SharedGuard.split` needs two disjoint field projections ``." }
        fn why(self) -> String { "Two child guards must preserve non-overlapping provenance under one original lock. Equal, enclosing, nested, or computed projections cannot prove that law." }
        fn fix(self) -> String { "Project two stored sibling fields, such as `value.left` and `value.right`." }
    }
}

struct CellGuardEscapes {
    impl Diagnostic {
        code :: "E0217"
        meaning :: "A Cell guard is stored in an unsupported aggregate or captured by a lambda"
        detail :: true
        fn what(self) -> String { "A Cell guard is stored inside an unsupported value or captured by a lambda." }
        fn why(self) -> String { "A Cell guard is a temporary loan handle. Storing it inside another value could keep the loan after its local scope ends." }
        fn fix(self) -> String { "Keep the guard in a local name or a tuple, and use `.map(...)` or `.split(...)` for projections." }
    }
}

struct PinWithoutWriteWindow {
    impl Diagnostic {
        code :: "E0218"
        meaning :: "`mem.pin` was given a value instead of a write window made with the write-access marker `&`"
        detail :: true
        fn what(self) -> String { "`mem.pin` needs a write window made with the write-access marker `&` into the place being pinned." }
        fn why(self) -> String { "A pin promises one storage location will not move, so it has to name that location with the write-access marker; see the sigil reading rule above." }
        fn fix(self) -> String { "Write `mem.pin(&place)` with the write-access marker `&`." }
    }
}

struct PinnedPlaceMoved {
    impl Diagnostic {
        code :: "E0219"
        meaning :: "A pinned place is moved, replaced, or resized while a pin is still live"
        detail :: true
        fn what(self) -> String { "A pinned place is moved, replaced, or resized while a pin is still live." }
        fn why(self) -> String { "The pin promises that storage keeps its address; moving or replacing it would leave every stored address pointing at the old place." }
        fn fix(self) -> String { "Finish using the pin before changing the place, or narrow the pin's scope." }
    }
}

struct ReadDuringWriteWindow {
    impl Diagnostic {
        code :: "E0220"
        meaning :: "A place is read through its owner while an exclusive write window / pin into it is still live (card #1361, I2)"
        detail :: true
        fn what(self) -> String { "A place is read through its owner while an exclusive write window into it is still live." }
        fn why(self) -> String { "An exclusive window (a pin or a mutable view) already gives write access to that storage; reading the owner beside it would be rejected after lowering." }
        fn fix(self) -> String { "Read or edit through the live window name instead of the owner." }
    }
}

struct SharedReferenceCycle {
    impl Diagnostic {
        code :: "E0221"
        meaning :: "A write into a shared value can close a strong `Shared` reference cycle"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "A write into a shared value can close a strong `Shared` reference cycle." }
        fn why(self) -> String { "Strong `Shared` handles keep each other alive; a cycle through them never frees." }
        fn fix(self) -> String { "Store a `Shared.Weak<T>` back-edge or an id, or build the stored value from new cells." }
    }
}

struct PersistentPartMoved {
    name: String

    impl Diagnostic {
        code :: "E0222"
        meaning :: "A part of persistent, static, or own-Close state cannot be moved independently"
        detail :: true
        fn what(self) -> String { "A part of `{self.name}` cannot be moved independently" }
        fn why(self) -> String { "Persistent and static storage must stay complete, and a value with its own Close implementation needs all its fields when it closes." }
        fn fix(self) -> String { "Move the complete owner, copy a copyable field, call a method the owner's type provides, or update persistent state atomically." }
    }
}

struct PersistentMutableBorrow {
    name: String

    impl Diagnostic {
        code :: "E0223"
        meaning :: "Persistent or static state cannot be mutably borrowed"
        detail :: true
        fix_next :: "Compute an owned replacement and assign the persistent or static binding as a whole."
        fn what(self) -> String { "A mutable borrow of `{self.name}` cannot escape its persistent or static storage cell" }
        fn why(self) -> String { "Persistent and static state must be changed by computing a replacement and assigning the whole binding. A mutable borrow or mutating receiver would let access escape the cell." }
        fn fix(self) -> String { "Compute an owned replacement, then assign the persistent or static binding as a whole instead of passing `{self.name}` with `&` or using a mutating receiver." }
    }
}

struct MissingReceiverMark {
    impl Diagnostic {
        code :: "E0224"
        meaning :: "A method call writes or takes a named place without its receiver mark"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .BehaviorPreserving
        fn what(self) -> String { "This call writes or takes the named place it is called on, but the place has no mark." }
        fn why(self) -> String { "A method declared with `&self` writes its receiver and one declared with `^self` takes it; the mark shows that permission on the named place, the same way `edit(&buf)` and `consume(^text)` mark arguments." }
        fn fix(self) -> String { "Write `&` before the place for a writing call (`&buf.append(x)`) or `^` for a taking call (`^buf.seal()`)." }
    }
}

struct UnusedPlaceMark {
    impl Diagnostic {
        code :: "E0225"
        stage :: [.Parse, .Sema]
        meaning :: "A place mark sits where nothing writes or takes a named place"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .BehaviorPreserving
        fn what(self) -> String { "This `&` or `^` mark does not match a call or move that writes or takes the marked place." }
        fn why(self) -> String { "A mark belongs only on a named place that a call writes or takes, or that `^` moves as a value. Read calls and fresh values such as literals and call results take no mark, and a collection element stays in its collection." }
        fn fix(self) -> String { "Remove the mark." }
    }
}

struct ReceiverMarkMismatch {
    impl Diagnostic {
        code :: "E0226"
        meaning :: "A receiver mark names the wrong permission for its call"
        detail :: true
        edit :: .SourceEdit
        no_fix :: None
        fix_safety :: .BehaviorPreserving
        fn what(self) -> String { "This receiver mark does not match the permission the call uses." }
        fn why(self) -> String { "A call that writes its receiver needs `&`, and a call that takes its receiver needs `^`; the mark states the permission the resolved method declares." }
        fn fix(self) -> String { "Replace the mark with the one the call declares." }
    }
}

struct MarkedFunctionValue {
    impl Diagnostic {
        code :: "E0227"
        meaning :: "A named function with a `&` or `^` parameter is used as a function value"
        detail :: true
        no_fix :: .Ambiguous
        fn what(self) -> String { "A function whose parameter is marked `&` or `^` is used as a value instead of being called." }
        fn why(self) -> String { "A function type gives each parameter plain read access. A value of this function would drop the `&` or `^` mark its callers must write, so the function can only be called directly." }
        fn fix(self) -> String { "Call the function directly with the mark, or pass a lambda that makes that call." }
    }
}

struct InvalidReceiverFootprint {
    impl Diagnostic {
        code :: "E0231"
