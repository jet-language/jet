        fix_next :: "Rename one declaration so each package name is declared once."
        fn what(self) -> String { "`{self.name}` is declared in two files of package `{self.package}`" }
        fn why(self) -> String { "The files of one package share one namespace, so each top-level name belongs to exactly one file; the other declaration is in `{self.other}`." }
        fn fix(self) -> String { "Rename one of the declarations, or keep only one of them." }
    }
}

struct RunInLibrary {
    impl Diagnostic {
