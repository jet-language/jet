        fn why(self) -> String { "Terminal release now uses ordinary consuming `close(^allocator)` through the move marker `^`." }
        fn fix(self) -> String { "Follow E0121 and acquire a new allocator after close." }
    }
}

struct UnsafeForbiddenByPolicy {
