    impl Diagnostic {
        code :: "E3101"
        meaning :: "Low-level memory operation used outside an `#Unsafe(\"…\")` block"
        detail :: true
        fn what(self) -> String { "`{self.op}` can only run inside an `#Unsafe` block." }
        fn why(self) -> String { "This operation can violate memory safety, so it must sit in an audited region." }
        fn fix(self) -> String { "Wrap it: `#Unsafe(\"why this is safe\") {{ … }}`." }
    }
}

struct MemoryTierWithoutUse {
