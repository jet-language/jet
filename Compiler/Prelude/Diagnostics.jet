        stage :: [.Parse]
        fn what(self) -> String { "A `{{name:...}}` rest capture isn't the last part of a binary pattern" }
        fn why(self) -> String { "The registered parse rule applies here" }
        fn fix(self) -> String { "Move the binary rest capture to the final pattern position." }
    }
}

struct BinaryPatternSubjectMismatch {
