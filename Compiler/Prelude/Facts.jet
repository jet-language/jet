    impl Fact {
        name: "Build.Host.OS",
        holds: .Build,
        safe: .Gain,
        gates: [],
    }
}

BuildHostArch: struct {
    impl Fact {
        name: "Build.Host.Arch",
        holds: .Build,
        safe: .Gain,
        gates: [],
    }
}

