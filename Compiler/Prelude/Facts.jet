// The program's structure is a build-time fact plane. The
// three rows share the one law and name the one written word that can loosen
// each direction; their observed entries are compiler-only and erase before
// runtime.
StructureLiveness: struct {
    impl Fact {
        name: "Structure.Liveness",
        holds: .Build,
        safe: .Gain,
        gates: [.UnderscoreName],
    }
}

StructureLifecycle: struct {
    impl Fact {
        name: "Structure.Lifecycle",
        holds: .Build,
        safe: .Shrink,
        gates: [.PolicyAllow],
    }
}

StructureImportEdge: struct {
    impl Fact {
        name: "Structure.ImportEdge",
        holds: .Build,
        safe: .Shrink,
        gates: [.ManifestRuleEdit],
    }
}

// Target availability is a closed Build fact plane: one row per target
// capability, named and ordered as `TARGET_CAPABILITY_ALL` names them.
// A present row names a provider and digest; `absent` remains explicit. The
// semantic effect and Authority planes stay separate from machine provision.
TargetAllocator: struct {
    impl Fact {
        name: "Target.Allocator",
        holds: .Build,
        safe: .Gain,
        gates: [.Provider, .Digest],
    }
}

TargetMemory: struct {
    impl Fact {
        name: "Target.Memory",
        holds: .Build,
        safe: .Gain,
        gates: [.Provider, .Digest],
    }
}

