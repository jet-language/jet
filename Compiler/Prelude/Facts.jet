}

TypeClassification: struct {
    impl Fact {
        name: "Type.Classification"
        holds: .Value
        safe: .Gain
        gates: []
        identity: false
    }
}

TypeExactness: struct {
    impl Fact {
        name: "Type.Exactness"
        holds: .Value
        safe: .Gain
        gates: []
        identity: true
    }
}

TypeObligation: struct {
    impl Fact {
        name: "Type.Obligation"
        holds: .Value
        safe: .Gain
        gates: []
        identity: false
    }
}

Exactness: struct {
    impl Fact {
        holds: .Value
        safe: .Gain
        gates: [approx, rounded, raw, wrapping, saturating, checked]
    }
}

Flow: struct {
    impl Fact {
        holds: .Value
        safe: .Gain
        gates: []
    }
}

Taint: struct {
    impl Fact {
        holds: .Value
        safe: .Gain
        gates: [Scrub]
    }
}

Duty: struct {
    impl Fact {
        holds: .Value
        safe: .Discharge
        gates: [detach, drop]
    }
}

Rights: struct {
    impl Fact {
        holds: .Scope
        safe: .Shrink
        gates: [Unsafe, Impure, Grant]
    }
}

PackagePolicy: struct {
    impl Fact {
        holds: .Scope
        safe: .Shrink
        gates: [Unsafe, Grant]
    }
}

