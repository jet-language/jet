// Compiler fact planes are written here. A plane is a field-less struct that
// implements `Fact` (Core/Prelude/Prelude.jet): the compiler tracks it, and
// no value of it exists. Value, scope and build planes share this one form.
//
// Each plane's `impl Fact` block gives the trait's constants: what the fact
// attaches to (`holds`), its safe direction (`safe`), and every escape that
// can move it the other way (`gates`, `Gate` values). Prover planes name
// their publisher (`proved_by`) and still carry the same law constants. The
// registry rows (JetFoundation RegistrationFacts.jet) are read from this text.

// Compiler type planes are ordinary readable Prelude planes. `name` gives the
// plane its dotted compiler namespace; `identity` states whether the plane
// contributes to carrier identity.
TypeNominal: struct {
    impl Fact {
        name: "Type.Nominal",
        holds: .Value,
        safe: .Gain,
        gates: [],
        identity: true,
    }
}

TypeInterval: struct {
    impl Fact {
        name: "Type.Interval",
        holds: .Value,
        safe: .Gain,
        gates: [],
        identity: true,
    }
}

TypeLayout: struct {
    impl Fact {
        name: "Type.Layout",
        holds: .Value,
        safe: .Gain,
        gates: [],
        identity: true,
    }
}

TypeMeasure: struct {
    impl Fact {
        name: "Type.Measure",
        holds: .Value,
        safe: .Gain,
        gates: [],
        identity: true,
    }
}

TypeDimension: struct {
    impl Fact {
        name: "Type.Dimension",
        holds: .Value,
        safe: .Gain,
        gates: [],
        identity: true,
    }
}

TypeClassification: struct {
    impl Fact {
        name: "Type.Classification",
        holds: .Value,
        safe: .Gain,
        gates: [],
        identity: false,
    }
}

TypeExactness: struct {
    impl Fact {
        name: "Type.Exactness",
        holds: .Value,
        safe: .Gain,
        gates: [],
        identity: true,
    }
}

TypeObligation: struct {
    impl Fact {
        name: "Type.Obligation",
        holds: .Value,
        safe: .Gain,
        gates: [],
        identity: false,
    }
}

Exactness: struct {
    impl Fact {
        holds: .Value,
        safe: .Gain,
        gates: [.Approx, .Rounded, .Raw, .Wrapping, .Saturating, .Checked],
    }
}

Flow: struct {
    impl Fact {
        holds: .Value,
        safe: .Gain,
        gates: [],
    }
}

Taint: struct {
    impl Fact {
        holds: .Value,
        safe: .Gain,
        gates: [.Marker(Scrub)],
    }
}

Duty: struct {
    impl Fact {
        holds: .Value,
        safe: .Discharge,
        gates: [.Detach, .Drop],
    }
}

Rights: struct {
    impl Fact {
        holds: .Scope,
        safe: .Shrink,
        gates: [.Marker(Unsafe), .Marker(Impure), .Grant],
    }
}

PackagePolicy: struct {
    impl Fact {
        holds: .Scope,
        safe: .Shrink,
        gates: [.Marker(Unsafe), .Grant],
    }
}

