// Compiler fact planes are written here. A plane is a field-less struct that
// implements `Fact`: the compiler tracks it, and no value of it exists.
//
// Each plane's `impl Fact` block names what it holds, its safe direction,
// and every word that can move the fact away from safety (`gates`). Prover
// planes name their publisher (`proved_by`) and still carry the same law
// columns.

// Compiler type planes are ordinary readable Prelude planes. `name` gives the
// plane its dotted compiler namespace; `identity` states whether the plane
// contributes to carrier identity.
TypeNominal: struct {
    impl Fact {
        name: "Type.Nominal"
        holds: .Value
        safe: .Gain
        gates: []
        identity: true
    }
}

TypeInterval: struct {
    impl Fact {
        name: "Type.Interval"
        holds: .Value
        safe: .Gain
        gates: []
        identity: true
    }
}

TypeLayout: struct {
    impl Fact {
        name: "Type.Layout"
        holds: .Value
        safe: .Gain
        gates: []
        identity: true
    }
}

TypeMeasure: struct {
    impl Fact {
        name: "Type.Measure"
        holds: .Value
        safe: .Gain
        gates: []
        identity: true
    }
}

TypeDimension: struct {
    impl Fact {
        name: "Type.Dimension"
        holds: .Value
        safe: .Gain
