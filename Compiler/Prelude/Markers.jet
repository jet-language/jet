Meta: struct {
    category: String{""}
    tunable: Bool{false}
    maturity: Maturity{.Tested}

    impl Marker {
        sites: [.Function, .Method, .Declaration, .Constant]
    }
}
// Exported devtools panels are discovered from one typed
// function marker; no startup registration call or second metadata surface.
DevPanel: struct {
    impl Marker {
        sites: [.Function]
    }
}

