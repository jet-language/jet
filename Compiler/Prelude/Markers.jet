    impl Marker {
        sites: [.Function]
    }
}

MustUse: struct {
    impl Marker {
        sites: [.Function, .Method, .Type]
    }
}

Error: struct {
    impl Marker {
        sites: [.Type]
    }
}

// The one retiring lifecycle rung. `removed_in` is
// optional until package editions own removal; before then it remains warn-only.
Deprecated: struct {
    since: String
    use: String
    removed_in: String{none}

    impl Marker {
        sites: [.Function, .Method, .Type]
    }
}

Codable: struct {
    impl Marker {
        sites: [.Type]
    }
}

// Named typed receipt section declaration.
Receipt: struct {
    name: String

    impl Marker {
        sites: [.Type]
    }
