// Test-only effect substitution is configured by one typed
// marker argument; the harness owns fail-nth scheduling.
// `.expect_fail([E30xx,] message: "text")` checks a
// region's raw stop message. Whole-test expected_fail remains the known-bug mark.
Test: struct {
    name: String{"function name"}
    faults: [Effect]{[]}
    expected_fail: Bool{false}

    impl Marker {
        sites: [.Test]
    }
}

Target: struct {
    target: Target

    impl Marker {
        sites: [.File, .Module, .Function]
    }
}
// #2793: target interrupt vector plus bounded effect row.
Interrupt: struct {
    vector: Ident
    effects: [Effect]

    impl Marker {
        sites: [.Function]
    }
}

Root: struct {
    impl Marker {
        sites: [.Parameter]
    }
}

HTML: struct {
    page: Path

    impl Marker {
        sites: [.File, .Block]
    }
}

NoPrelude: struct {
    impl Marker {
        sites: [.File]
    }
}

SQL: struct {
    row: Type{none}

    impl Marker {
        sites: [.Block]
    }
}

Bindgen: struct {
    impl Marker {
        sites: [.Module]
    }
}

Allow: struct {
    lint: Ident
    reason: String{none}

    impl Marker {
        sites: [.Declaration, .Field, .Statement]
        repeatable: true
    }
}

// Stable-address storage is not a code-generation hint.
Static: struct {
    impl Marker {
        sites: [.Constant]
    }
}

