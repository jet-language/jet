// Structs use the second argument for `align(N)`; enums retain
// the legacy bare tag-width argument in this same registry slot.
// The layout parser teaches the menu: `c`, `columnar`, and an enum's
// backing width `U8` … `I64`, with E1105 otherwise.
Layout: struct {
    kind: Layout
    tag: Value{none}

    impl Marker {
        sites: [.Type]
        owns_menu: true
    }
}

RenameAll: struct {
    case: NamingCase

    impl Marker {
        sites: [.Type]
        owns_menu: true
    }
}

DenyUnknownFields: struct {
    impl Marker {
        sites: [.Type]
    }
}

Discriminant: struct {
    field: String

    impl Marker {
        sites: [.Type]
    }
}

Untagged: struct {
    impl Marker {
        sites: [.Type]
    }
}

Redact: struct {
    impl Marker {
        sites: [.Field]
    }
}

Rename: struct {
    name: String
    json: String{none}
    cbor: String{none}
    csv: String{none}
    toml: String{none}
    yaml: String{none}
    xml: String{none}
    args: String{none}
    env: String{none}
    db: String{none}
    layout: String{none}

    impl Marker {
        sites: [.Field, .Variant]
    }
}

