// This is the one readable Core declaration twin.
//
// Generated views (dispatcher guards, ambient-route checks, and the surface
// ledger) must be derived from this file. Do not hand-edit generated Rust
// tables.
//
// An enum leaf's case list (`Name:plain(A|B)` among a `module` line's types)
// is written by Tools/Agent/CoreEnumCases.jet from the enum a source of that
// module declares; regenerate it with `--write` instead of editing it. A list
// whose enum no Core source declares is compiler-owned and written here.

bootstrap Syntax depends_on []
bootstrap Effects depends_on [Syntax]
bootstrap Core depends_on [Effects]
bootstrap Derives depends_on [Core]

root_types { Date, LocalDate, LocalTime, Decimal, Fraction, Duration, Instant, Authority, __Decoding, __DecodeTree, __DecodeSource }
namespace_only { core.context, core.mem.scope, core.net.mime, core.net.url, core.time.expiring }
// error_types names every type a Core module exports whose source declares it
// `#Error`, in module order; the compiler reads it for a bare error domain
// whose module a program has not loaded, and the source check holds it to
// the sources.
error_types { AppError, BlobError, CallError, Notice, ArchiveError, GzipFileError, ZstdFileError, AuthError, MetadataError, ColorError, ComputeError, CryptoError, FileCryptoError, KeyWrapError, UUIDError, VaultError, DataError, JetDataPlotError, DBError, EncodingCause, EncodingError, FormatError, HexError, Base32Error, Base64Error, BinaryError, CBORError, INIError, XMLError, EventConfigError, GitError, FormDecodeError, HTTPError, ImageError, TransformError, MatrixError, AllocError, ModError, NetError, MIMEError, URLError, WsError, PerfError, PluginError, SendError, TaskFailure, ParseError, RegexError, ServiceError, EnvError, TimeError, UIError, UIPreviewError, UIHostError, FontError, OpenAPIError, BrowserError, WebFormActionError, WebFormError, WebQueryError, WebRouterError, WebStoreError, WebTableError }

