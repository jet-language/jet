// Canonical encoding-format rows drive the shared EncodingFormat carrier.
format_row JSON core.encoding.json JSON
format_row JSONL core.encoding.jsonl JSONL
format_row CSV core.encoding.csv CSV
format_row TOML core.encoding.toml TOML
format_row YAML core.encoding.yaml YAML
format_row XML core.encoding.xml XML
format_row CBOR core.encoding.cbor CBOR
format_row ETF core.encoding.eetf ETF

// Dispatcher constructor rows are declaration facts.
// The expression after `|` is the one tier adapter; the generated
// registry contains no hand-maintained row list.
dispatcher_row plain core.term take | CoreCallRecord.source_owned("core.term", "take", &[false]).with_source_role("TermTake")
dispatcher_row plain core.net.tls client | CoreCallRecord.source_owned("core.net.tls", "client", &[false, true]).with_max_arity(4)

