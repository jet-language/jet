// The readable logical `Core/prelude.jet` module.
//
// These declarations name the ambient surface. Their meaning stays in the
// embedded Prelude/CoreLib implementations; sema opens this module once per
// file and resolves each alias through the ordinary Core call path. Every
// line here is ordinary Jet: `jet check` and `jet fmt --check` accept the file
// as a user module.
//
// The compiler itself provides these ambient functions; none has a Jet
// declaration yet, so they are listed rather than declared:
//   print: fn(value: Any)
//   input: Iter<String>
//     every line of the program's input, lazily: the files its arguments
//     name, in order, else standard input (core.term __InputLines).
//     `core.term.readline(prompt)` reads one line.
//   panic: fn(message: String)
//   assert: fn(cond: Bool)
//   assert_eq: fn(a: Any, b: Any)
//   debug: fn<T>(value: T) -> T
//     `debug(value)` returns `value` unchanged and, in development builds,
//     writes `[debug] file.jet:LINE expr = <Debug form>` to stderr. It adds no
//     effect; a shipped artifact or release-profile build rejects it (E3405).
//   channel: fn<T>(capacity: Int{0})
//   embed_file, embed_bytes, find, fetch: the build-time file and network
//     reads, ordinary effectful calls in comptime code.
use {
    core.files.path
    core.time
}

// Measurement claims use the one always-available identity
// sink, core.prelude's Jet body.
keep: core.prelude.keep
// Ordered extrema over one Comparable type, with no import: they order by
// `compare` (a Float by IEEE 754 totalOrder), and `clamp` accepts reversed bounds.
min: core.prelude.min
max: core.prelude.max
clamp: core.prelude.clamp
eprint: core.term.eprint
read_file: core.files.read
write_file: core.files.write
file_exists: core.files.exists

// The ambient types are aliases of their Core declarations.
Clock: time.Clock

Instant: time.Instant

Duration: time.Duration

DurationUnit: time.DurationUnit

Date: time.LocalDate

Path: path.Path

// Checked text is an ordinary nominal type with one ordinary CheckedText
// implementation. `check` receives the literal's parts (the text between its
// holes, never joined) and returns `Checked{shape, slots}`: `shape` is what
// it learned, computed once while building, and `slots[i]` the kind of
// position hole `i` sits in. `encode_hole` encodes one hole for its slot.
// The compiler-owned contract reads an unbound `Slot` as `TextSlot`, an
// unbound `Shape` as `[String]` and an unbound `Hole` as `String`.
//
// A String-backed `distinct` type needs nothing more: it returns
// `Checked{shape: parts.copy(), slots: [TextSlot]{}}` for the joined text, and its
// literal is that text. A type whose holes stay values also binds `Hole: T`
// and declares `build: fn(shape: Shape, holes: [Hole]) -[]> Self`; its
// literal is `Self.build(shape, holes)` with the shape `check` returned for
// the literal's parts. `accepts`, when declared, refuses a hole's type for
// its slot with a reason; undeclared, every type is accepted.
// A user trait can declare the same shape (Examples/Types/Traits/UserCheckedTextShape.jet).
CheckedText: trait {
    Error: type,
    Hole: type,
    Slot: type,
    Shape: type,
    check: fn(parts: [String]) -[]> Checked<Shape, Slot> Error!,
    accepts: fn(slot: Slot, hole: TypeId) -[]> String?,
    encode_hole: fn<T: Printable>(value: T, slot: Slot) -[]> Hole,
    build: fn(shape: Shape, holes: [Hole]) -[]> Self,
}
