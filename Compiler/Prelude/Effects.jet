// The machine effects are written here, not in Rust.
//
// This is ordinary Jet source. Each type implements `Effect`: a struct is an
// effect root with no members, and an enum is a closed family whose cases are
// its leaves (`FS.Read`). These are what the machine does; Core declares the
// services built on them (DB, Log, Secret) in Core/Effects/Effects.jet, each
// with a `#FX(…)` line naming the machine effects it may use, and the Prelude
// exports both. Effect parsing, marker arguments (`#FX(Net, FS)`), fact
// registration, manifest and `--allow`/`--deny` validation, diagnostics, and
// reflection all read the two lists (Foundation's
// Registry/EffectVocabulary.jet reads them while the compiler builds), so an effect
// exists exactly when it is written in one of them. The order here, then
// Core's, is the canonical order of a written effect row.
// `irreversible: fn(self) -> Bool` says which effects a `#Transact` rollback
// can't take back; a family is irreversible when any of its cases is.
// `Panic`, `Mem`, `Time.Wait` and `Unsafe` are deny-only: a policy may refuse
// them but never has to grant them. `Context` is never granted either (every
// program holds it), but a function's row still names it.

Net: struct {
    impl Effect {
        irreversible: fn(self) -> Bool { true }
    }
}

FS: enum {
    Read
    Write

    impl Effect {
        irreversible: fn(self) -> Bool { self == .Write }
    }
}

IO: struct {
    impl Effect {}
}

Time: enum {
    Wait

    impl Effect {}
}

Rand: enum {
    Draw

    impl Effect {}
}

Env: struct {
    impl Effect {}
}

Exec: enum {
    Exit
    Args

    impl Effect {
        irreversible: fn(self) -> Bool { true }
    }
}

GPU: struct {
    impl Effect {}
}

// The foreign languages: a call into one has that language's leaf. This is
// the one foreign-language list; Tools/agent/CoreSourceRows.jet writes the
// `#FFI(<lang>)` language menu (Core/Compiler/Lang.jet) and the binder
// languages (Jetpack's ForeignLanguage) from these cases.
FFI: enum {
    Go
    Java
    DotNet
    Fortran
    Cobol
    Tcl
    Lua
    Ada
    Pascal
    Dart
    PowerShell
    Perl
    Ruby
    Php
    R
    Com
    C
    Cpp
    Asm
    Py
    Octave
    Rust
    JS
    Swift

    impl Effect {
        irreversible: fn(self) -> Bool { true }
    }
}

Browser: struct {
    impl Effect {}
}

Panic: struct {
    impl Effect {}
}

// `Mem.Stack` is only ever denied with a byte ceiling,
// `!Mem.Stack(above: N)`.
Mem: enum {
    Alloc
    Rc
    Stack

    impl Effect {}
}

// Reading the implicit task context (`context.deadline`, `context.thread`).
// A read adds it to the function's effect row, so a pure function or a row
// that leaves it out cannot read the context; every program holds it, so no
// policy grants it and a policy may deny it (Policy/Authority.jet
// authority_needs_no_grant).
Context: struct {
    impl Effect {}
}

// Reaching `#Unsafe` code: a function that opens an `#Unsafe` gate (a block,
// an `#Unsafe` function or a foreign function's gate) outside Core, and every
// function that can call it. Core's gates are vetted and sealed, so calling
// Core reaches none. `-[!Unsafe]>`, a cap's `!Unsafe` or a policy's
// `deny: [Unsafe]` refuses every such path.
Unsafe: struct {
    impl Effect {}
}
