// The effect vocabulary is written here, not in Rust.
//
// This is ordinary Jet source. Each type implements `Effect`: a struct is an
// effect root with no members, and an enum is a closed family whose cases are
// its leaves (`FS.Read`). Effect parsing, marker arguments (`#FX(Net, FS)`),
// fact registration, manifest and `--allow`/`--deny` validation, diagnostics,
// and reflection all read this list (Foundation's generated
// Registry/EffectVocabulary.jet carries it to the compiler), so an effect
// exists exactly when it is written here. The types' order is the canonical
// order of a written effect row.
// `irreversible: fn(self) -> Bool` says which effects a `#Transact` rollback
// can't take back; a family is irreversible when any of its cases is.
// `Panic`, `Mem` and `Time.Wait` are deny-only: a policy may refuse them but
// never has to grant them.

Net: struct {
    impl Effect {
        irreversible: fn(self) -> Bool { true }
    }
}

FS: enum {
    Read
    Write

    impl Effect {
        irreversible: fn(self) -> Bool { self == .Write }
    }
}

IO: struct {
    impl Effect {}
}

DB: enum {
    Read
    Write

    impl Effect {}
}

Time: enum {
    Wait

    impl Effect {}
}

Rand: enum {
    Draw

    impl Effect {}
}

Env: struct {
    impl Effect {}
}

Exec: enum {
    Exit
    Args

    impl Effect {
        irreversible: fn(self) -> Bool { true }
    }
}

Log: struct {
    impl Effect {}
}

GPU: struct {
    impl Effect {}
}

FFI: enum {
    Go
    Java
    DotNet
    Fortran
    Cobol
    Tcl
    Lua
    Ada
    Pascal
    Dart
    PowerShell
    Perl
    Ruby
    Php
    R
    Com
    C
    Cpp
    Asm
    Py
    Octave

    impl Effect {
        irreversible: fn(self) -> Bool { true }
    }
}

Browser: struct {
    impl Effect {}
}

Secret: struct {
    impl Effect {}
}

Panic: struct {
    impl Effect {}
}

Mem: enum {
    Alloc
    Rc

    impl Effect {}
}
