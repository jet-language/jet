// D-META-ONE1=A: the effect vocabulary is written here, not in Rust.
//
// This is ordinary Jet source. Each line declares one effect root or leaf.
// Effect parsing, marker arguments (`#FX(Net, FS)`), fact registration,
// manifest and `--allow`/`--deny` validation, diagnostics, and reflection all
// read this list (Foundation's generated Registry/EffectVocabulary.jet carries
// it to the compiler), so an effect exists exactly when it is written here.
// A root with leaves is closed: a dotted name under it must be one of them.
// The roots' order is the canonical order of a written effect row.
// `Panic`, `Mem` and `Time.Wait` are deny-only: a policy may refuse them but
// never has to grant them.

effect Net $irreversible
effect FS
effect FS.Read
effect FS.Write $irreversible
effect IO
effect DB
effect DB.Read
effect DB.Write
effect Time
effect Time.Wait
effect Rand
effect Rand.Draw
effect Env
effect Exec $irreversible
effect Exec.Exit
effect Exec.Args
effect Log
effect GPU
effect FFI $irreversible
effect FFI.Go
effect FFI.Java
effect FFI.DotNet
effect FFI.Fortran
effect FFI.Cobol
effect FFI.Tcl
effect FFI.Lua
effect FFI.Ada
effect FFI.Pascal
effect FFI.Dart
effect FFI.PowerShell
effect FFI.Perl
effect FFI.Ruby
effect FFI.Php
effect FFI.R
effect FFI.Com
effect FFI.C
effect FFI.Cpp
effect FFI.Asm
effect FFI.Py
effect FFI.Octave
effect Browser
effect Secret
effect Panic
effect Mem
effect Mem.Alloc
effect Mem.Rc
