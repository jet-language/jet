// Target-neutral MIR CFG, def-use, and conservative simplification passes.
//
// This module is deliberately a consumer of the canonical MIR schema.  It does
// not introduce a second graph or infer source-level policy.  Every transform
// below either preserves the existing operation/effect ordering or leaves the
// operation untouched.  The runner reports the production passes which are not
// in this batch instead of claiming a complete optimizer.

pub enum MirPassErrorKind {
    InvalidSchema
    InvalidCfg
    InvalidDefUse
    InvalidFact
}

pub struct MirPassError {
    pub pass: MirOptimizationPassId
    pub kind: MirPassErrorKind
    pub function: ?MirFunctionId
    pub span: Span
    pub message: String
}

pub struct MirPassCoverage {
    pub production_order: [MirOptimizationPassId]
    pub completed: [MirOptimizationPassId]
    pub remaining_work: [String]
}

pub struct MirPassReport {
    pub coverage: MirPassCoverage
    pub reachable_blocks_removed: Int
    pub folded_values: Int
    pub dead_values_removed: Int
    pub bounds_facts: Int
}

// `complete` means that this dependency-closed batch ran without an error.  A
// caller which needs the entire historical production pipeline must also
// inspect `coverage.remaining_work`; the loop/vector proof pass is intentionally
// not represented by a guessed approximation.
pub struct MirPassResult {
    pub program: ?MirProgram
    pub report: MirPassReport
    pub error: ?MirPassError
    pub complete: Bool
}

pub struct MirPassCfgRow {
    pub block: MirBlockId
    pub predecessors: [MirBlockId]
    pub successors: [MirBlockId]
    pub reachable: Bool
}

pub struct MirPassDefUseRow {
    pub value: MirValueId
    pub definition_block: ?MirBlockId
    pub definition_index: ?Int
    pub use_count: Int
}

pub struct MirPassFunctionAnalysis {
    pub cfg: [MirPassCfgRow]
    pub def_use: [MirPassDefUseRow]
}

struct MirPassDefinition {
    pub value: MirValueId
    pub block: MirBlockId
    pub index: Int
}

struct MirPassConstantFact {
    pub value: MirValueId
    pub constant: MirConstant
}

struct MirPassDominatorRow {
    pub block: MirBlockId
    pub dominators: [MirBlockId]
}

pub fn mir_pass_production_order() -> [MirOptimizationPassId] {
    [MirOptimizationPassId]{
        .LegalityVerification,
        .UnreachableBlockElimination,
        .CfgSimplification,
        .ExactConstantFolding,
        .BoundsCheckElimination,
        .DeadPureValueElimination,
        .CanonicalLoopFacts,
    }
}

pub fn mir_pass_remaining_work() -> [String] {
    [String]{
        "inline-always MIR body expansion",
        "canonical loop and vector proof facts",
        "fixed-reduction CFG normalization",
        "acceleration proof facts and decision-ledger projection",
    }
}

fn mir_pass_empty_report() -> MirPassReport {
    MirPassReport{
        coverage: MirPassCoverage{
            production_order: mir_pass_production_order(),
            completed: [MirOptimizationPassId]{},
            remaining_work: mir_pass_remaining_work(),
        },
        reachable_blocks_removed: 0,
        folded_values: 0,
        dead_values_removed: 0,
        bounds_facts: 0,
    }
}

fn mir_pass_error(
    pass: MirOptimizationPassId,
    kind: MirPassErrorKind,
    function: ?MirFunctionId,
    span: Span,
    message: String,
) -> MirPassError {
    MirPassError{pass: pass, kind: kind, function: function, span: span, message: message}
}

fn mir_pass_failed(error: MirPassError, report: MirPassReport) -> MirPassResult {
    MirPassResult{program: None, report: report, error: Val(error), complete: false}
}

fn mir_pass_succeeded(program: MirProgram, report: MirPassReport) -> MirPassResult {
    MirPassResult{program: Val(program), report: report, error: None, complete: true}
}

// Explicit package-level seam used by Driver after all module lowering and
// before any target adapter.  No pass silently drops an unsupported operation.
pub fn run_mir_passes(program: MirProgram) -> MirPassResult {
    report := mir_pass_empty_report()
    validation :: mir_pass_validate_program(program, .LegalityVerification)
    if validation != None -> return mir_pass_failed(validation ?? mir_pass_error(.LegalityVerification, .InvalidSchema, None, Span{start: 0, end: 0}, "MIR legality validation failed"), report)

    optimized := program
    mir_pass_clear_batch_facts(&optimized)

    before_blocks := mir_pass_block_count(optimized)
    mir_pass_eliminate_unreachable(&optimized)
    report.reachable_blocks_removed += before_blocks - mir_pass_block_count(optimized)
    mir_pass_mark(&optimized, .UnreachableBlockElimination)
    report.coverage.completed.push(.UnreachableBlockElimination)
    validation = mir_pass_validate_program(optimized, .UnreachableBlockElimination)
    if validation != None -> return mir_pass_failed(validation ?? mir_pass_error(.UnreachableBlockElimination, .InvalidCfg, None, Span{start: 0, end: 0}, "unreachable-block elimination produced invalid MIR"), report)

    before_blocks = mir_pass_block_count(optimized)
    mir_pass_simplify_cfg(&optimized)
    report.reachable_blocks_removed += before_blocks - mir_pass_block_count(optimized)
    mir_pass_mark(&optimized, .CfgSimplification)
    report.coverage.completed.push(.CfgSimplification)
    validation = mir_pass_validate_program(optimized, .CfgSimplification)
    if validation != None -> return mir_pass_failed(validation ?? mir_pass_error(.CfgSimplification, .InvalidCfg, None, Span{start: 0, end: 0}, "CFG simplification produced invalid MIR"), report)

    report.folded_values = mir_pass_fold_exact_constants(&optimized)
    mir_pass_mark(&optimized, .ExactConstantFolding)
    report.coverage.completed.push(.ExactConstantFolding)
    validation = mir_pass_validate_program(optimized, .ExactConstantFolding)
    if validation != None -> return mir_pass_failed(validation ?? mir_pass_error(.ExactConstantFolding, .InvalidDefUse, None, Span{start: 0, end: 0}, "constant folding produced invalid MIR"), report)

    report.bounds_facts = mir_pass_derive_bounds(&optimized)
    mir_pass_mark(&optimized, .BoundsCheckElimination)
    report.coverage.completed.push(.BoundsCheckElimination)
    validation = mir_pass_validate_program(optimized, .BoundsCheckElimination)
    if validation != None -> return mir_pass_failed(validation ?? mir_pass_error(.BoundsCheckElimination, .InvalidFact, None, Span{start: 0, end: 0}, "bounds facts are invalid"), report)

    report.dead_values_removed = mir_pass_eliminate_dead_pure(&optimized)
    mir_pass_mark(&optimized, .DeadPureValueElimination)
    report.coverage.completed.push(.DeadPureValueElimination)
    validation = mir_pass_validate_program(optimized, .DeadPureValueElimination)
    if validation != None -> return mir_pass_failed(validation ?? mir_pass_error(.DeadPureValueElimination, .InvalidDefUse, None, Span{start: 0, end: 0}, "dead-value elimination produced invalid MIR"), report)

    mir_pass_mark(&optimized, .LegalityVerification)
    // Legality is the first production fact even though its check runs before
    // transforms.  Keep the public fingerprint in production order.
    loop function in &optimized.functions {
        ordered := [MirOptimizationPassId]{.LegalityVerification}
        loop pass in function.optimization.pass_ids {
            if pass != .LegalityVerification -> ordered.push(pass)
        }
        function.optimization.pass_ids = ordered
    }
    mir_pass_canonicalize_program_order(&optimized)
    validation = mir_pass_validate_program(optimized, .LegalityVerification)
    if validation != None -> return mir_pass_failed(validation ?? mir_pass_error(.LegalityVerification, .InvalidSchema, None, Span{start: 0, end: 0}, "canonical ordering produced invalid MIR"), report)
    digest := mir_program_digest(optimized)
    loop function in &optimized.functions -> function.optimization.derived_from_digest = Val(digest)
    completed := [MirOptimizationPassId]{.LegalityVerification}
    loop pass in report.coverage.completed -> completed.push(pass)
    report.coverage.completed = completed
    mir_pass_succeeded(optimized, report)
}

// The public analyses are intentionally read-only and use the same edge and
// operand walkers as the legality pass and transforms.
pub fn mir_pass_analyze_function(function: MirFunction) -> MirPassFunctionAnalysis {
    cfg := mir_pass_cfg_rows(function)
    defs := mir_pass_definitions(function)
    rows := [MirPassDefUseRow]{}
    loop value in function.values {
        definition := mir_pass_find_definition(defs, value.id)
        rows.push(MirPassDefUseRow{
            value: value.id,
            definition_block: definition.map(row -> row.block),
            definition_index: definition.map(row -> row.index),
            use_count: mir_pass_value_use_count(function, value.id),
        })
    }
    MirPassFunctionAnalysis{cfg: cfg, def_use: rows}
}

fn mir_pass_clear_batch_facts(program: &MirProgram) {
    loop function in &program.functions {
        function.optimization.pass_ids = [MirOptimizationPassId]{}
        function.optimization.derived_from_digest = None
        function.optimization.bounds_facts = [MirBoundsFact]{}
        function.optimization.loop_facts = [MirLoopFact]{}
        function.optimization.vector_facts = [MirVectorFact]{}
        function.optimization.fusion_facts = [MirFusionFact]{}
        function.optimization.acceleration_facts = [MirAccelerationFact]{}
        function.optimization.auto_vectorizable = false
        function.optimization.no_aliasing = false
        function.optimization.no_early_exit = false
        function.optimization.no_cross_iteration_dependencies = false
    }
}

fn mir_pass_mark(program: &MirProgram, pass: MirOptimizationPassId) {
    loop function in &program.functions {
        function.optimization.pass_ids.push(pass)
    }
}


fn mir_pass_block_count(program: MirProgram) -> Int {
    total := 0
    loop function in program.functions -> total += function.blocks.len()
    total
}

fn mir_pass_validate_program(program: MirProgram, pass: MirOptimizationPassId) -> ?MirPassError {
    if program.schema_version != @MIR_SCHEMA_VERSION -> return Val(mir_pass_error(pass, .InvalidSchema, None, Span{start: 0, end: 0}, "MIR schema version does not match the canonical schema"))
    seen_functions := [MirFunctionId]{}
    loop function in program.functions {
        if function.id.value == 0 -> return Val(mir_pass_error(pass, .InvalidSchema, Val(function.id), function.span, "MIR function has a zero stable identity"))
        if mir_pass_function_id_seen(seen_functions, function.id) -> return Val(mir_pass_error(pass, .InvalidSchema, Val(function.id), function.span, "MIR function identity is duplicated"))
        seen_functions.push(function.id)
        failure :: mir_pass_validate_function(function, pass, program)
        if failure != None -> return failure
    }
    None
}

fn mir_pass_validate_function(function: MirFunction, pass: MirOptimizationPassId, program: MirProgram) -> ?MirPassError {
    if function.span.start > function.span.end -> return Val(mir_pass_error(pass, .InvalidSchema, Val(function.id), function.span, "MIR function span is inverted"))
    if function.blocks.len() == 0 -> return Val(mir_pass_error(pass, .InvalidCfg, Val(function.id), function.span, "MIR function has no basic blocks"))
    if !mir_pass_block_exists(function.blocks, function.entry) -> return Val(mir_pass_error(pass, .InvalidCfg, Val(function.id), function.span, "MIR entry block is missing"))

    seen_blocks := [MirBlockId]{}
    seen_operations := [MirOpId]{}
    seen_values := [MirValueId]{}
    definitions := [MirPassDefinition]{}
    loop block in &function.blocks {
        if block.id.value == 0 -> return Val(mir_pass_error(pass, .InvalidCfg, Val(function.id), block.span, "MIR block has a zero stable identity"))
        if mir_pass_block_id_seen(seen_blocks, block.id) -> return Val(mir_pass_error(pass, .InvalidCfg, Val(function.id), block.span, "MIR block identity is duplicated"))
        seen_blocks.push(block.id)
        if block.span.start > block.span.end -> return Val(mir_pass_error(pass, .InvalidCfg, Val(function.id), block.span, "MIR block span is inverted"))
        index := 0
        loop instruction in &block.instructions {
            if instruction.id.value == 0 || mir_pass_operation_id_seen(seen_operations, instruction.id) -> return Val(mir_pass_error(pass, .InvalidSchema, Val(function.id), instruction.span, "MIR instruction identity is missing or duplicated"))
            seen_operations.push(instruction.id)
            if instruction.span.start > instruction.span.end -> return Val(mir_pass_error(pass, .InvalidSchema, Val(function.id), instruction.span, "MIR instruction span is inverted"))
            if {
                instruction.result != None -> {
                    result :: instruction.result ?? MirValueId{value: 0}
                    if result.value == 0 || mir_pass_value_id_seen(seen_values, result) -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), instruction.span, "MIR SSA result identity is missing or duplicated"))
                    seen_values.push(result)
                    if instruction.ty == None -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), instruction.span, "MIR SSA result has no type metadata"))
                    definitions.push(MirPassDefinition{value: result, block: block.id, index: index})
                }
                instruction.ty != None -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), instruction.span, "MIR instruction has a type without an SSA result"))
                else -> {}
            }

            index += 1
        }
    }

    loop value in &function.values {
        if value.id.value == 0 -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), value.span, "MIR value metadata has a zero stable identity"))
        if !mir_pass_value_id_seen(seen_values, value.id) -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), value.span, "MIR value metadata has no defining instruction"))
    }
    metadata_seen := [MirValueId]{}
    loop value in &function.values {
        if mir_pass_value_id_seen(metadata_seen, value.id) -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), value.span, "MIR value metadata is duplicated"))
        metadata_seen.push(value.id)
        definition :: mir_pass_find_definition(definitions, value.id)
        if definition == None -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), value.span, "MIR SSA definition is missing"))
        expected_ty :: mir_pass_instruction_type(function, value.id) ?? value.ty
        if !mir_type_same_checked_type(value.ty, expected_ty) -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), value.span, "MIR value type metadata disagrees with its definition"))
    }

    loop block in &function.blocks {
        loop target in mir_terminator_targets(block.terminator) {
            if !mir_pass_block_exists(function.blocks, target) -> return Val(mir_pass_error(pass, .InvalidCfg, Val(function.id), block.span, "MIR terminator targets a missing block"))
        }
        loop instruction in &block.instructions {
            loop place in mir_pass_operation_place_refs(instruction.operation) {
                if !mir_pass_place_exists(function.places, place) -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), instruction.span, "MIR operation references a missing place"))
            }
            loop value in mir_operation_value_uses(instruction.operation) {
                if !mir_pass_definition_exists(definitions, value) -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), instruction.span, "MIR operation reads an undefined SSA value"))
            }
            loop place in mir_pass_operation_place_refs(instruction.operation) {
                loop value in mir_pass_place_value_uses(function.places, place) {
                    if !mir_pass_definition_exists(definitions, value) -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), instruction.span, "MIR place projection reads an undefined SSA value"))
                }
            }
            if instruction.operation == {
                .Phi(incoming) -> {
                    loop row in incoming {
                        if !mir_pass_block_exists(function.blocks, row.block) || !mir_pass_predecessor(function, row.block, block.id) -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), instruction.span, "MIR phi incoming edge is not a predecessor"))
                        if !mir_pass_definition_exists(definitions, row.value) -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), instruction.span, "MIR phi reads an undefined SSA value"))
                    }
                }
                else -> {}
            }
        }
        loop value in mir_terminator_value_uses(block.terminator) {
            if !mir_pass_definition_exists(definitions, value) -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), block.span, "MIR terminator reads an undefined SSA value"))
        }
    }
    loop place in &function.places {
        loop value in mir_pass_place_value_uses(function.places, place.id) {
            if !mir_pass_definition_exists(definitions, value) -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), place.span, "MIR place base or projection reads an undefined SSA value"))
        }
    }
    loop scope in &function.scopes {
        if scope.deadline != None {
            value :: scope.deadline ?? MirValueId{value: 0}
            if !mir_pass_definition_exists(definitions, value) -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), scope.span, "MIR scope deadline reads an undefined SSA value"))
        }
    }

    loop fact in &function.optimization.bounds_facts {
        if !mir_pass_operation_id_seen(seen_operations, fact.operation) || fact.elided && !fact.proven || !fact.failure_preserved || fact.span.start > fact.span.end {
            return Val(mir_pass_error(pass, .InvalidFact, Val(function.id), fact.span, "MIR bounds fact does not describe a checked operation"))
        }
        if fact.place != None {
            place :: fact.place ?? MirPlaceId{value: 0}
            if !mir_pass_place_exists(function.places, place) -> return Val(mir_pass_error(pass, .InvalidFact, Val(function.id), fact.span, "MIR bounds fact references a missing place"))
        }
        if fact.index != None {
            value :: fact.index ?? MirValueId{value: 0}
            if !mir_pass_definition_exists(definitions, value) -> return Val(mir_pass_error(pass, .InvalidFact, Val(function.id), fact.span, "MIR bounds fact references an undefined index"))
        }
    }

    dominance :: mir_pass_dominators(function)
    loop block in &function.blocks {
        index := 0
        loop instruction in &block.instructions {
            if instruction.operation == {
                .Phi(incoming) -> {
                    loop row in incoming {
                        definition :: mir_pass_find_definition(definitions, row.value) ?? MirPassDefinition{value: row.value, block: block.id, index: index}
                        if !mir_pass_dominates(dominance, definition.block, row.block) -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), instruction.span, "MIR phi input is not defined on every incoming edge"))
                    }
                }
                else -> {
                    loop value in mir_operation_value_uses(instruction.operation) {
                        definition :: mir_pass_find_definition(definitions, value) ?? MirPassDefinition{value: value, block: block.id, index: index}
                        if !mir_pass_definition_dominates(definition, block.id, index, dominance) -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), instruction.span, "MIR SSA use is not dominated by its definition"))
                    }
                    loop place in mir_pass_operation_place_refs(instruction.operation) {
                        loop value in mir_pass_place_value_uses(function.places, place) {
                            definition :: mir_pass_find_definition(definitions, value) ?? MirPassDefinition{value: value, block: block.id, index: index}
                            if !mir_pass_definition_dominates(definition, block.id, index, dominance) -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), instruction.span, "MIR place use is not dominated by its definition"))
                        }
                    }
                }
            }
            index += 1
        }
        loop value in mir_terminator_value_uses(block.terminator) {
            definition :: mir_pass_find_definition(definitions, value) ?? MirPassDefinition{value: value, block: block.id, index: 0}
            if !mir_pass_dominates(dominance, definition.block, block.id) -> return Val(mir_pass_error(pass, .InvalidDefUse, Val(function.id), block.span, "MIR terminator use is not dominated by its definition"))
        }
    }
    semantic_failure := mir_pass_validate_function_legality(function, program, definitions)
    if semantic_failure != None {
        message :: semantic_failure ?? "MIR semantic legality validation failed"
        return Val(mir_pass_error(pass, .InvalidSchema, Val(function.id), function.span, message))
    }
    None
}

fn mir_pass_instruction_type(function: MirFunction, value: MirValueId) -> ?MirType {
    loop block in &function.blocks {
        loop instruction in &block.instructions {
            if instruction.result == Val(value) -> return instruction.ty
        }
    }
    None
}

fn mir_pass_definitions(function: MirFunction) -> [MirPassDefinition] {
    definitions := [MirPassDefinition]{}
    loop block in &function.blocks {
        index := 0
        loop instruction in &block.instructions {
            if instruction.result != None {
                definitions.push(MirPassDefinition{value: instruction.result ?? MirValueId{value: 0}, block: block.id, index: index})
            }
            index += 1
        }
    }
    definitions
}

fn mir_pass_find_definition(definitions: [MirPassDefinition], value: MirValueId) -> ?MirPassDefinition {
    loop definition in definitions {
        if definition.value == value -> return Val(definition)
    }
    None
}

fn mir_pass_definition_exists(definitions: [MirPassDefinition], value: MirValueId) -> Bool {
    mir_pass_find_definition(definitions, value) != None
}

fn mir_pass_cfg_rows(function: MirFunction) -> [MirPassCfgRow] {
    reachable := mir_pass_reachable(function)
    rows := [MirPassCfgRow]{}
    loop block in &function.blocks {
        successors := mir_terminator_targets(block.terminator)
        rows.push(MirPassCfgRow{block: block.id, predecessors: mir_pass_predecessors(function, block.id), successors: successors, reachable: mir_pass_block_id_seen(reachable, block.id)})
    }
    rows
}

fn mir_pass_reachable(function: MirFunction) -> [MirBlockId] {
    pending := [MirBlockId]{function.entry}
    reachable := [MirBlockId]{}
    index := 0
    loop index < pending.len() {
        block_id := pending[index]
        index += 1
        if !mir_pass_block_id_seen(reachable, block_id) {
            reachable.push(block_id)
            block_option := mir_pass_find_block(function.blocks, block_id)
            if block_option != None {
                block :: block_option ?? MirBasicBlock{id: block_id, span: Span{start: 0, end: 0}, instructions: [MirInstruction]{}, terminator: MirTerminator.Unreachable("missing")}
                loop target in mir_terminator_targets(block.terminator) {
                    if !mir_pass_block_id_seen(reachable, target) -> pending.push(target)
                }
            }
        }
    }
    reachable
}

fn mir_pass_predecessors(function: MirFunction, target: MirBlockId) -> [MirBlockId] {
    predecessors := [MirBlockId]{}
    loop block in &function.blocks {
        loop candidate in mir_terminator_targets(block.terminator) {
            if candidate == target && !mir_pass_block_id_seen(predecessors, block.id) -> predecessors.push(block.id)
        }
    }
    predecessors
}

fn mir_pass_predecessor(function: MirFunction, source: MirBlockId, target: MirBlockId) -> Bool {
    predecessors := mir_pass_predecessors(function, target)
    mir_pass_block_id_seen(predecessors, source)
}

fn mir_pass_dominators(function: MirFunction) -> [MirPassDominatorRow] {
    all := [MirBlockId]{}
    loop block in &function.blocks -> all.push(block.id)

    rows := [MirPassDominatorRow]{}
    loop block in &function.blocks {
        if block.id == function.entry -> rows.push(MirPassDominatorRow{block: block.id, dominators: [MirBlockId]{block.id}})
        else -> rows.push(MirPassDominatorRow{block: block.id, dominators: all})
    }
    changed := true
    rounds := 0
    loop changed && rounds <= function.blocks.len() + 1 {
        changed = false
        rounds += 1
        loop block in &function.blocks {
            if block.id != function.entry {
                predecessors := mir_pass_predecessors(function, block.id)
                candidate := [MirBlockId]{}
                if {
                    predecessors.len() == 0 -> candidate.push(block.id)
                    else -> {
                        loop item in all {
                            present := true
                            loop predecessor in predecessors {
                                row :: mir_pass_dominator_row(rows, predecessor)
                                if row == None || !mir_pass_block_id_seen((row ?? MirPassDominatorRow{block: predecessor, dominators: [MirBlockId]{}}).dominators, item) {
                                    present = false
                                    break
                                }
                            }
                            if present -> candidate.push(item)
                        }
                        if !mir_pass_block_id_seen(candidate, block.id) -> candidate.push(block.id)
                    }
                }
                row_index := 0
                loop row_index < rows.len() {
                    row := rows[row_index]
                    if row.block == block.id {
                        if !mir_pass_block_ids_equal(row.dominators, candidate) {
                            rows[row_index].dominators = candidate
                            changed = true
                        }
                        break
                    }
                    row_index += 1
                }
            }
        }
    }
    rows
}

fn mir_pass_dominator_row(rows: [MirPassDominatorRow], block: MirBlockId) -> ?MirPassDominatorRow {
    loop row in rows {
        if row.block == block -> return Val(row)
    }
    None
}

fn mir_pass_dominates(rows: [MirPassDominatorRow], definition: MirBlockId, use_block: MirBlockId) -> Bool {
    row :: mir_pass_dominator_row(rows, use_block) ?? return false
    mir_pass_block_id_seen(row.dominators, definition)
}

fn mir_pass_definition_dominates(definition: MirPassDefinition, use_block: MirBlockId, use_index: Int, rows: [MirPassDominatorRow]) -> Bool {
    if definition.block == use_block -> return definition.index < use_index
    mir_pass_dominates(rows, definition.block, use_block)
}
fn mir_pass_place_value_uses(places: [MirPlace], id: MirPlaceId) -> [MirValueId] {
    loop place in &places {
        if place.id == id {
            values := [MirValueId]{}
            if place.base == {
                .Parameter(value) | .Capture(value) | .Temporary(value) -> values.push(value)
                else -> {}
            }
            loop projection in &place.projections {
                if projection == {
                    .Index(_, index, _, _, _, _, _) -> values.push(index)
                    else -> {}
                }
            }
            return values
        }
    }
    [MirValueId]{}
}

fn mir_pass_value_use_count(function: MirFunction, value: MirValueId) -> Int {
    count := 0
    loop place in &function.places {
        loop used in mir_pass_place_value_uses(function.places, place.id) { if used == value -> count += 1 }
    }
    loop scope in &function.scopes {
        if scope.deadline == Val(value) -> count += 1
    }
    loop block in &function.blocks {
        loop instruction in &block.instructions {
            loop used in mir_operation_value_uses(instruction.operation) { if used == value -> count += 1 }
            loop place in mir_pass_operation_place_refs(instruction.operation) {
                loop used in mir_pass_place_value_uses(function.places, place) { if used == value -> count += 1 }
            }
        }
        loop used in mir_terminator_value_uses(block.terminator) { if used == value -> count += 1 }
    }
    count
}

fn mir_pass_eliminate_unreachable(program: &MirProgram) {
    loop function in &program.functions {
        reachable := mir_pass_reachable(function)
        kept_blocks := [MirBasicBlock]{}
        loop block in &function.blocks {
            if mir_pass_block_id_seen(reachable, block.id) -> kept_blocks.push(block)
        }
        function.blocks = kept_blocks
        live_values := [MirValueId]{}
        loop block in &function.blocks {
            loop instruction in &block.instructions {
                if instruction.result != None -> live_values.push(instruction.result ?? MirValueId{value: 0})
            }
        }
        loop place in &function.places {
            loop value in mir_pass_place_value_uses(function.places, place.id) {
                if !mir_pass_value_id_seen(live_values, value) -> live_values.push(value)
            }
        }
        loop scope in &function.scopes {
            if scope.deadline != None {
                value :: scope.deadline ?? MirValueId{value: 0}
                if !mir_pass_value_id_seen(live_values, value) -> live_values.push(value)
            }
        }
        kept_values := [MirValueFact]{}
        loop value in &function.values {
            if mir_pass_value_id_seen(live_values, value.id) -> kept_values.push(value)
        }
        function.values = kept_values
        block_index := 0
        loop block_index < function.blocks.len() {
            block_id := function.blocks[block_index].id
            expected := mir_pass_predecessors(function, block_id)
            instructions := function.blocks[block_index].instructions
            instruction_index := 0
            loop instruction_index < instructions.len() {
                instruction := instructions[instruction_index]
                if instruction.operation == {
                    .Phi(incoming) -> {
                        filtered := [MirPhiIncoming]{}
                        loop row in incoming {
                            if mir_pass_block_id_seen(expected, row.block) -> filtered.push(row)
                        }
                        instructions[instruction_index].operation = MirOperation.Phi(filtered)
                    }
                    else -> {}
                }
                instruction_index += 1
            }
            function.blocks[block_index].instructions = instructions
            block_index += 1
        }
    }
}

fn mir_pass_simplify_cfg(program: &MirProgram) {
    loop function in &program.functions {
        constants := mir_pass_collect_scalar_constants(function)
        loop block in &function.blocks {
            terminator := block.terminator
            if terminator == {
                .Branch(condition, then_target, else_target) -> {
                    if then_target == else_target {
                        block.terminator = MirTerminator.Jump(then_target)
                    } else {
                        constant :: mir_pass_constant_for(constants, condition)
                        if constant != None {
                            constant_value :: constant ?? MirConstant.Bool(false)
                            if constant_value == {
                                .Bool(flag) -> {
                                    if flag -> block.terminator = MirTerminator.Jump(then_target)
                                    else -> block.terminator = MirTerminator.Jump(else_target)
                                }
                                else -> {}
                            }
                        }
                    }
                }
                else -> {}
            }
        }
    }
    mir_pass_eliminate_unreachable(&program)
}

fn mir_pass_fold_exact_constants(program: &MirProgram) -> Int {
    folded := 0
    loop function in &program.functions {
        limit := 1
        loop block in &function.blocks -> limit += block.instructions.len()
        iteration := 0
        loop iteration < limit {
            constants := mir_pass_collect_scalar_constants(function)
            changed := false
            loop block in &function.blocks {
                instruction_index := 0
                loop instruction_index < block.instructions.len() {
                    instruction := block.instructions[instruction_index]
                    replacement := mir_pass_fold_operation(instruction.operation, constants, instruction.ty)
                    if replacement != None {
                        constant :: replacement ?? MirConstant.Unit
                        block.instructions[instruction_index].operation = MirOperation.Constant(constant)
                        changed = true
                        folded += 1
                    } else if instruction.result != None {
                        if instruction.operation == {
                            .Constant(constant) -> {
                                if mir_pass_scalar_constant(constant) != None -> mir_pass_constant_put(&constants, instruction.result ?? MirValueId{value: 0}, mir_pass_scalar_constant(constant) ?? constant)
                            }
                            else -> {}
                        }
                    }
                    instruction_index += 1
                }
            }
            if !changed -> break
            iteration += 1
        }
    }
    mir_pass_simplify_cfg(&program)
    folded
}

fn mir_pass_fold_operation(operation: MirOperation, constants: [MirPassConstantFact], ty: ?MirType) -> ?MirConstant {
    if operation == {
        .Phi(incoming) -> return mir_pass_fold_phi(incoming, constants)
        .Unary(op, value) -> {
            value_constant :: mir_pass_constant_for(constants, value) ?? return None
            target :: ty ?? return None
            return mir_pass_fold_unary(op, value_constant, target)
        }
        .Binary(op, dispatch, _, left, right) -> {
            if dispatch != .Primitive -> return None
            left_constant :: mir_pass_constant_for(constants, left) ?? return None
            right_constant :: mir_pass_constant_for(constants, right) ?? return None
            target :: ty ?? return None
            return mir_pass_fold_binary(op, left_constant, right_constant, target)
        }
        else -> return None
    }
}

fn mir_pass_collect_scalar_constants(function: MirFunction) -> [MirPassConstantFact] {
    constants := [MirPassConstantFact]{}
    loop block in &function.blocks {
        loop instruction in &block.instructions {
            if instruction.result != None {
                result := instruction.result ?? MirValueId{value: 0}
                if instruction.operation == {
                    .Constant(constant) -> {
                        scalar :: mir_pass_scalar_constant(constant)
                        if scalar != None -> mir_pass_constant_put(&constants, result, scalar ?? constant)
                    }
                    .Phi(incoming) -> {
                        folded :: mir_pass_fold_phi(incoming, constants)
                        if folded != None -> mir_pass_constant_put(&constants, result, folded ?? MirConstant.Unit)
                    }
                    else -> {}
                }
            }
        }
    }
    constants
}

fn mir_pass_constant_for(constants: [MirPassConstantFact], value: MirValueId) -> ?MirConstant {
    loop fact in constants {
        if fact.value == value -> return Val(fact.constant)
    }
    None
}

fn mir_pass_constant_put(constants: &[MirPassConstantFact], value: MirValueId, constant: MirConstant) {
    index := 0
    loop index < constants.len() {
        if constants[index].value == value {
            constants[index].constant = constant
            return
        }
        index += 1
    }
    constants.push(MirPassConstantFact{value: value, constant: constant})
}

fn mir_pass_scalar_constant(constant: MirConstant) -> ?MirConstant {
    if constant == {
        .Int(value, width, _) -> return Val(MirConstant.Int(value, width, None))
        .Bool(value) -> return Val(MirConstant.Bool(value))
        .Char(value) -> return Val(MirConstant.Char(value))
        else -> return None
    }
}

fn mir_pass_same_scalar(left: MirConstant, right: MirConstant) -> Bool {
    if left == {
        .Int(left_value, left_width, _) -> {
            if right == {
                .Int(right_value, right_width, _) -> return left_value == right_value && left_width == right_width
            }
            return false
        }
        .Bool(left_value) -> {
            if right == {
                .Bool(right_value) -> return left_value == right_value
            }
            return false
        }
        .Char(left_value) -> {
            if right == {
                .Char(right_value) -> return left_value == right_value
            }
            return false
        }
        else -> return false
    }
}

fn mir_pass_fold_phi(incoming: [MirPhiIncoming], constants: [MirPassConstantFact]) -> ?MirConstant {
    if incoming.len() == 0 -> return None
    first :: mir_pass_constant_for(constants, incoming[0].value) ?? return None
    index := 1
    loop index < incoming.len() {
        candidate :: mir_pass_constant_for(constants, incoming[index].value) ?? return None
        if !mir_pass_same_scalar(first, candidate) -> return None
        index += 1
    }
    Val(first)
}

fn mir_pass_fold_unary(op: MirUnaryOp, value: MirConstant, ty: MirType) -> ?MirConstant {
    if op == .Not {
        if value == {
            .Bool(flag) -> return Val(MirConstant.Bool(!flag))
        }
        return None
    }
    if op == .Neg {
        if value == {
            .Int(number, width, _) -> {
            result :: mir_pass_checked_sub(0, number) ?? return None
            output_width := mir_pass_integer_width(ty, width)
            if !mir_pass_fits_integer(result, output_width) -> return None
            return Val(MirConstant.Int(result, output_width, None))
            }
        }
    }
    None
}

fn mir_pass_fold_binary(op: MirBinaryOp, left: MirConstant, right: MirConstant, ty: MirType) -> ?MirConstant {
    if left == {
        .Bool(left_value) -> {
            if right == {
                .Bool(right_value) -> {
                    if op == .And -> return Val(MirConstant.Bool(left_value && right_value))
                    if op == .Or -> return Val(MirConstant.Bool(left_value || right_value))
                    if op == .Eq -> return Val(MirConstant.Bool(left_value == right_value))
                    if op == .Ne -> return Val(MirConstant.Bool(left_value != right_value))
                }
            }
            return None
        }
        .Char(left_value) -> {
            if right == {
                .Char(right_value) -> {
                    if op == .Eq -> return Val(MirConstant.Bool(left_value == right_value))
                    if op == .Ne -> return Val(MirConstant.Bool(left_value != right_value))
                    if op == .Lt -> return Val(MirConstant.Bool(left_value < right_value))
                    if op == .Gt -> return Val(MirConstant.Bool(left_value > right_value))
                    if op == .Le -> return Val(MirConstant.Bool(left_value <= right_value))
                    if op == .Ge -> return Val(MirConstant.Bool(left_value >= right_value))
                }
            }
            return None
        }
        .Int(left_value, left_width, _) -> {
            if right == {
                .Int(right_value, _, _) -> {
                    if op == .Eq -> return Val(MirConstant.Bool(left_value == right_value))
                    if op == .Ne -> return Val(MirConstant.Bool(left_value != right_value))
                    if op == .Lt -> return Val(MirConstant.Bool(left_value < right_value))
                    if op == .Gt -> return Val(MirConstant.Bool(left_value > right_value))
                    if op == .Le -> return Val(MirConstant.Bool(left_value <= right_value))
                    if op == .Ge -> return Val(MirConstant.Bool(left_value >= right_value))
                    result := mir_pass_integer_result(op, left_value, right_value) ?? return None
                    width := mir_pass_integer_width(ty, left_width)
                    if !mir_pass_fits_integer(result, width) -> return None
                    return Val(MirConstant.Int(result, width, None))
                }
            }
            return None
        }
        else -> return None
    }
}

fn mir_pass_integer_result(op: MirBinaryOp, left: Int, right: Int) -> ?Int {
    if op == .Add -> return mir_pass_checked_add(left, right)
    if op == .Sub -> return mir_pass_checked_sub(left, right)
    if op == .Mul -> return mir_pass_checked_mul(left, right)
    if op == .Div {
        if right == 0 || (left == mir_pass_int_min() && right == -1) -> return None
        return Val(left / right)
    }
    if op == .FloorDiv -> return mir_pass_floor_div(left, right)
    if op == .Mod -> return mir_pass_floor_mod(left, right)
    if op == .Rem {
        if right == 0 -> return None
        return Val(left % right)
    }
    if op == .BitAnd -> return Val(left & right)
    if op == .BitOr -> return Val(left | right)
    if op == .BitXor -> return Val(left ^ right)
    if op == .Shl {
        if right < 0 || right >= 63 -> return None
        return mir_pass_checked_mul(left, 1 << right)
    }
    if op == .Shr {
        if right < 0 || right >= 63 -> return None
        return Val(left / (1 << right))
    }
    if op == .Pow {
        if right < 0 || right > 63 -> return None
        result := 1
        exponent := right
        base := left
        loop exponent > 0 {
            if exponent % 2 == 1 -> result :: mir_pass_checked_mul(result, base) ?? return None
            exponent = exponent / 2
            if exponent > 0 -> base :: mir_pass_checked_mul(base, base) ?? return None
        }
        return Val(result)
    }
    None
}


fn mir_pass_int_min() -> Int { 0 - 9223372036854775807 - 1 }

fn mir_pass_checked_add(left: Int, right: Int) -> ?Int {
    if right > 0 && left > 9223372036854775807 - right -> return None
    if right < 0 && left < mir_pass_int_min() - right -> return None
    Val(left + right)
}

fn mir_pass_checked_sub(left: Int, right: Int) -> ?Int {
    if right > 0 && left < mir_pass_int_min() + right -> return None
    if right < 0 && left > 9223372036854775807 + right -> return None
    Val(left - right)
}

fn mir_pass_checked_mul(left: Int, right: Int) -> ?Int {
    if left == 0 || right == 0 -> return Val(0)
    if left == -1 && right == mir_pass_int_min() -> return None
    if right == -1 && left == mir_pass_int_min() -> return None
    if left > 0 {
        if right > 0 && left > 9223372036854775807 / right -> return None
        if right < 0 && right < mir_pass_int_min() / left -> return None
    } else {
        if right > 0 && left < mir_pass_int_min() / right -> return None
        if right < 0 && left < 9223372036854775807 / right -> return None
    }
    Val(left * right)
}

fn mir_pass_floor_div(left: Int, right: Int) -> ?Int {
    if right == 0 || (left == mir_pass_int_min() && right == -1) -> return None
    quotient := left / right
    remainder := left % right
    if remainder != 0 && (remainder < 0) != (right < 0) -> return mir_pass_checked_sub(quotient, 1)
    Val(quotient)
}

fn mir_pass_floor_mod(left: Int, right: Int) -> ?Int {
    if right == 0 || (left == mir_pass_int_min() && right == -1) -> return None
    remainder := left % right
    if remainder != 0 && (remainder < 0) != (right < 0) -> return mir_pass_checked_add(remainder, right)
    Val(remainder)
}

fn mir_pass_integer_width(ty: MirType, fallback: ?MirIntegerWidth) -> ?MirIntegerWidth {
    if ty.kind == {
        .IntN(signed, bits) -> {
            if bits > 0 && bits <= 64 -> return Val(MirIntegerWidth{signed: signed, bits: bits})
            return None
        }
        .InlineRange(base, _, _) -> return mir_pass_integer_width(base, fallback)
        .Tagged(_, inner) -> return mir_pass_integer_width(inner, fallback)
        .Quantity(base, _) -> return mir_pass_integer_width(base, fallback)
        else -> return fallback
    }
}

fn mir_pass_fits_integer(value: Int, width: ?MirIntegerWidth) -> Bool {
    row :: width ?? return true
    bits := row.bits
    if bits <= 0 || bits > 64 -> return false
    if bits == 64 -> return row.signed || value >= 0
    limit := 1 << (bits - 1)
    if row.signed -> return value >= 0 - limit && value <= limit - 1
    unsigned_limit := 1 << bits
    value >= 0 && value <= unsigned_limit - 1
}

fn mir_pass_derive_bounds(program: &MirProgram) -> Int {
    total := 0
    loop function in &program.functions {
        facts := [MirBoundsFact]{}
        blocks := function.blocks
        places := function.places
        loop block in blocks {
            loop instruction in block.instructions {
                if instruction.operation == {
                    .Index(_, _, index, kind, _, _, _) -> {
                        fact := MirBoundsFact{operation: instruction.id, place: None, index: Val(index), kind: kind, proven: kind == .FixedListProof, elided: kind == .FixedListProof, failure_preserved: true, span: instruction.span}
                        mir_pass_bounds_insert(&facts, fact)
                        total += 1
                    }
                    else -> {}
                }
                loop place_id in mir_operation_place_uses(instruction.operation) {
                    loop place in places {
                        if place.id == place_id {
                            loop projection in place.projections {
                                if projection == {
                                    .Index(kind, index, _, _, _, _, span) -> {
                                        fact := MirBoundsFact{operation: instruction.id, place: Val(place_id), index: Val(index), kind: kind, proven: kind == .FixedListProof, elided: kind == .FixedListProof, failure_preserved: true, span: span}
                                        mir_pass_bounds_insert(&facts, fact)
                                        total += 1
                                    }
                                    else -> {}
                                }
                            }
                        }
                    }
                }
            }
        }
        function.optimization.bounds_facts = facts
    }
    total
}

fn mir_pass_bounds_insert(rows: &[MirBoundsFact], fact: MirBoundsFact) {
    rows.push(fact)
    index := rows.len() - 1
    loop index > 0 && mir_pass_bounds_before(rows[index], rows[index - 1]) {
        previous := rows[index - 1]
        rows[index - 1] = rows[index]
        rows[index] = previous
        index -= 1
    }
}

fn mir_pass_bounds_before(left: MirBoundsFact, right: MirBoundsFact) -> Bool {
    if left.operation.value != right.operation.value -> return left.operation.value < right.operation.value
    left_place := left.place.map(value -> value.value) ?? -1
    right_place := right.place.map(value -> value.value) ?? -1
    if left_place != right_place -> return left_place < right_place
    left_index := left.index.map(value -> value.value) ?? -1
    right_index := right.index.map(value -> value.value) ?? -1
    left_index < right_index
}

fn mir_pass_eliminate_dead_pure(program: &MirProgram) -> Int {
    removed_total := 0
    loop function in &program.functions {
        changed := true
        loop changed {
            changed = false
            uses := [MirPassDefUseRow]{}
            analysis := mir_pass_analyze_function(function)
            uses = analysis.def_use
            kept_blocks := [MirBasicBlock]{}
            loop block in &function.blocks {
                kept_instructions := [MirInstruction]{}
                loop instruction in &block.instructions {
                    removable := false
                    if instruction.result != None {
                        result := instruction.result ?? MirValueId{value: 0}
                        use_count := mir_pass_use_count_from_rows(uses, result)
                        if use_count == 0 {
                            metadata :: mir_pass_find_value(function.values, result)
                            if metadata != None {
                                removable = mir_pass_removable_dead(instruction.operation, instruction.ty, (metadata ?? MirValueFact{id: result, ty: mir_type_from_kind(.Int), span: instruction.span, ownership: mir_copy_ownership()}).ownership, program.prelude_calls)
                            }
                        }
                    }
                    if removable {
                        changed = true
                        removed_total += 1
                    } else {
                        kept_instructions.push(instruction)
                    }
                }
                block.instructions = kept_instructions
                kept_blocks.push(block)
            }
            function.blocks = kept_blocks
            if changed {
                kept_values := [MirValueFact]{}
                loop value in &function.values {
                    if mir_pass_value_defined(function, value.id) -> kept_values.push(value)
                }
                function.values = kept_values
            }
        }
    }
    removed_total
}

fn mir_pass_use_count_from_rows(rows: [MirPassDefUseRow], value: MirValueId) -> Int {
    loop row in rows { if row.value == value -> return row.use_count }
    0
}

fn mir_pass_find_value(values: [MirValueFact], value: MirValueId) -> ?MirValueFact {
    loop row in &values { if row.id == value -> return Val(row) }
    None
}

fn mir_pass_value_defined(function: MirFunction, value: MirValueId) -> Bool {
    loop block in &function.blocks {
        loop instruction in &block.instructions {
            if instruction.result == Val(value) -> return true
        }
    }
    false
}

fn mir_pass_removable_dead(operation: MirOperation, ty: ?MirType, ownership: MirOwnership, prelude_calls: [MirPreludeCall]) -> Bool {
    if ownership.mode != .Copy || ownership.drop != .NoDrop -> return false
    if operation == {
        .Constant(constant) -> {
            if constant == {
                .Int(_, _, _) | .Float(_, _, _) | .Bool(_) | .Char(_) -> return true
            }
            return false
        }
        .Unary(op, _) -> return op == .Not && ty.map(value -> value.kind == .Bool) ?? false
        .Binary(op, dispatch, _, _, _) -> {
            pure_dispatch := if dispatch == .Primitive -> true else -> {
                dispatch_pure := if dispatch == {
                    .Prelude(call, _) -> mir_pass_prelude_is_pure(prelude_calls, call)
                    else -> false
                }
                dispatch_pure
            }
            return pure_dispatch && (op == .Eq || op == .Ne || op == .Lt || op == .Gt || op == .Le || op == .Ge || op == .BitAnd || op == .BitOr || op == .BitXor || op == .And || op == .Or)
        }
        .Phi(_) -> return true
        .Convert(_, _, _, conversion) -> return mir_pass_conversion_is_pure(conversion, prelude_calls)
        else -> return false
    }
}

fn mir_pass_prelude_is_pure(rows: [MirPreludeCall], id: MirPreludeCallId) -> Bool {
    loop row in &rows {
        if row.id == id -> return row.effect_name == None && row.fallibility == .Infallible
    }
    false
}

fn mir_pass_conversion_is_pure(conversion: MirConversion, rows: [MirPreludeCall]) -> Bool {
    if conversion == {
        .Transparent | .NumericCast | .SendFn -> return true
    }
    if conversion == {
        .Prelude(call, _, fallibility) -> return fallibility == .Infallible && mir_pass_prelude_is_pure(rows, call)
    }
    false
}

fn mir_pass_block_id_seen(rows: [MirBlockId], id: MirBlockId) -> Bool {
    loop row in rows { if row == id -> return true }
    false
}

fn mir_pass_function_id_seen(rows: [MirFunctionId], id: MirFunctionId) -> Bool {
    loop row in rows { if row == id -> return true }
    false
}

fn mir_pass_operation_id_seen(rows: [MirOpId], id: MirOpId) -> Bool {
    loop row in rows { if row == id -> return true }
    false
}

fn mir_pass_value_id_seen(rows: [MirValueId], id: MirValueId) -> Bool {
    loop row in rows { if row == id -> return true }
    false
}

fn mir_pass_block_exists(blocks: [MirBasicBlock], id: MirBlockId) -> Bool {
    loop block in &blocks { if block.id == id -> return true }
    false
}

fn mir_pass_find_block(blocks: [MirBasicBlock], id: MirBlockId) -> ?MirBasicBlock {
    loop block in &blocks { if block.id == id -> return Val(block) }
    None
}

fn mir_pass_place_exists(places: [MirPlace], id: MirPlaceId) -> Bool {
    loop place in &places { if place.id == id -> return true }
    false
}

fn mir_pass_block_ids_equal(left: [MirBlockId], right: [MirBlockId]) -> Bool {
    if left.len() != right.len() -> return false
    loop id in left { if !mir_pass_block_id_seen(right, id) -> return false }
    true
}
// The following legality layer mirrors the Rust verifier's semantic boundary.
// The generic operand walkers remain the source of truth for SSA uses; these
// helpers add the checked metadata which cannot be inferred from an operand
// list (ownership, routes, places, failure carriers, and semantic payloads).
fn mir_pass_validate_function_legality(
    function: MirFunction,
    program: MirProgram,
    definitions: [MirPassDefinition],
) -> ?String {
    if !mir_pass_type_valid(function.return_type) -> return Val("function return type has invalid MIR layout")
    if function.declared_return != None {
        declared :: function.declared_return ?? return Val("function declared return type is missing")
        if !mir_pass_type_valid(declared) -> return Val("function declared return type has invalid MIR layout")
    }
    failure := mir_pass_validate_failure_carrier(function.failure)
    if failure != None -> return failure

    parameter_index := 0
    loop parameter in &function.params {
        if parameter.index != parameter_index || parameter.name == "" -> return Val("parameter index or name is not canonical")
        if !mir_pass_type_valid(parameter.ty) -> return Val("parameter type has invalid MIR layout")
        if !mir_pass_ownership_valid(parameter.ownership) -> return Val("parameter ownership/drop metadata is inconsistent")
        parameter_index += 1
    }
    capture_slot := 0
    loop capture in &function.capture_params {
        if capture.slot != capture_slot || capture.name == "" -> return Val("capture slot or name is not canonical")
        if !mir_pass_type_valid(capture.ty) -> return Val("capture type has invalid MIR layout")
        if !mir_pass_ownership_valid(capture.ownership) -> return Val("capture ownership/drop metadata is inconsistent")
        capture_slot += 1
    }
    loop value in &function.values {
        if !mir_pass_type_valid(value.ty) -> return Val("SSA value type has invalid MIR layout")
        if !mir_pass_ownership_valid(value.ownership) -> return Val("SSA value ownership/drop metadata is inconsistent")
    }
    loop local in &function.locals {
        if !mir_pass_type_valid(local.ty) -> return Val("local type has invalid MIR layout")
        if !mir_pass_ownership_valid(local.ownership) -> return Val("local ownership/drop metadata is inconsistent")
        if !mir_pass_place_exists(function.places, local.place) -> return Val("local references a missing place")
    }
    loop place in &function.places {
        place_failure := mir_pass_validate_place(place, function, program, definitions)
        if place_failure != None -> return place_failure
    }
    prelude_failure := mir_pass_validate_prelude_rows(program.prelude_calls)
    if prelude_failure != None -> return prelude_failure

    loop block in &function.blocks {
        loop instruction in &block.instructions {
            operation_failure := mir_pass_validate_operation_legality(
                instruction.operation,
                instruction.span,
                function,
                program,
                definitions,
            )
            if operation_failure != None -> return operation_failure
            if function.is_pure && mir_pass_operation_has_effect(instruction.operation, function, program.prelude_calls) {
                return Val("pure function contains an effectful MIR operation")
            }
        }
    }
    drop_failure := mir_pass_validate_drops(function, definitions)
    if drop_failure != None -> return drop_failure
    move_failure := mir_pass_validate_moves(function, program, definitions)
    if move_failure != None -> return move_failure
    host_failure := mir_pass_validate_host_callbacks(function, program.prelude_calls)
    if host_failure != None -> return host_failure
    None
}

fn mir_pass_type_valid(ty: MirType) -> Bool {
    if !mir_type_has_valid_layout(ty) -> return false
    if ty.kind == {
        .IntN(_, bits) -> return bits > 0 && bits <= 64
        .InlineRange(base, lo, hi) -> return lo <= hi && mir_pass_type_valid(base)
        .List(inner)
        | .Shared(inner)
        | .Option(inner)
        | .FixedList(inner, _)
        | .Tagged(_, inner)
        | .Quantity(inner, _) -> return mir_pass_type_valid(inner)
        .Map(key, value) -> return mir_pass_type_valid(key) && mir_pass_type_valid(value)
        .Result(ok, err) -> return mir_pass_type_valid(ok) && mir_pass_type_valid(err)
        .Fn(signature) -> {
            loop parameter in signature.params {
                if !mir_pass_type_valid(parameter) -> return false
            }
            if signature.ret != None {
                result :: signature.ret ?? return false
                if !mir_pass_type_valid(result) -> return false
            }
            return true
        }
        .SendFn(params, ret, _) -> {
            loop parameter in params {
                if !mir_pass_type_valid(parameter) -> return false
            }
            if ret != None {
                result :: ret ?? return false
                if !mir_pass_type_valid(result) -> return false
            }
            return true
        }
        .Apply(_, args) | .Union(args) -> {
            loop argument in args {
                if !mir_pass_type_valid(argument) -> return false
            }
            return true
        }
        .Tuple(fields) -> {
            loop field in fields {
                if !mir_pass_type_valid(field.ty) -> return false
            }
            return true
        }
        else -> return true
    }
}

fn mir_pass_validate_failure_carrier(carrier: MirFailureCarrier) -> ?String {
    if carrier == {
        .Infallible -> return None
        .Result(success, error) -> {
            if !mir_pass_type_valid(success) || !mir_pass_type_valid(error) -> return Val("Result failure carrier contains an invalid type")
        }
        .Optional(value) | .Diverges(value) -> {
            if !mir_pass_type_valid(value) -> return Val("optional failure carrier contains an invalid type")
        }
    }
    None
}

fn mir_pass_ownership_valid(ownership: MirOwnership) -> Bool {
    if ownership.mode == {
        .Copy -> return ownership.drop == .NoDrop && !ownership.moved
        .Owned -> return ownership.drop == .Value || ownership.drop == .ForeignHandle
        .Shared -> return ownership.drop == .Shared
        .ReadBorrow -> return ownership.drop == .NoDrop || ownership.drop == .View
        .WriteBorrow -> return ownership.drop == .View
        .Move -> return ownership.drop == .Value || ownership.drop == .ForeignHandle
    }
}

fn mir_pass_type_id_exists(rows: [MirTypeDef], id: MirTypeId) -> Bool {
    loop row in &rows { if row.id == id -> return true }
    false
}

fn mir_pass_field_id_exists(rows: [MirFieldRow], id: MirFieldId) -> Bool {
    loop row in &rows { if row.id == id -> return true }
    false
}

fn mir_pass_source_file_id_exists(rows: [MirSourceFile], id: MirSourceFileId) -> Bool {
    loop row in &rows { if row.id == id -> return true }
    false
}

fn mir_pass_prelude_id_exists(rows: [MirPreludeCall], id: MirPreludeCallId) -> Bool {
    loop row in &rows { if row.id == id -> return true }
    false
}

fn mir_pass_function_id_exists(rows: [MirFunction], id: MirFunctionId) -> Bool {
    loop row in &rows { if row.id == id -> return true }
    false
}

fn mir_pass_foreign_id_exists(rows: [MirForeign], id: MirForeignId) -> Bool {
    loop row in &rows { if row.id == id -> return true }
    false
}

fn mir_pass_core_id_exists(rows: [MirCoreCall], id: MirCoreCallId) -> Bool {
    loop row in &rows { if row.id == id -> return true }
    false
}

fn mir_pass_callback_id_exists(rows: [MirCallbackAdapter], id: MirCallbackId) -> Bool {
    loop row in &rows { if row.id == id -> return true }
    false
}

fn mir_pass_trait_id_exists(rows: [MirTraitDef], id: MirTraitId) -> Bool {
    loop row in &rows { if row.id == id -> return true }
    false
}

fn mir_pass_trait_method_exists(rows: [MirTraitDef], id: MirTraitMethodId) -> Bool {
    loop trait_row in &rows {
        loop method in &trait_row.methods {
            if method.id == id -> return true
        }
    }
    false
}

fn mir_pass_block_target_exists(rows: [MirBasicBlock], id: MirBlockId) -> Bool {
    loop row in &rows { if row.id == id -> return true }
    false
}

fn mir_pass_index_route_arity(kind: MirIndexKind) -> Int {
    if kind == .List || kind == .FixedListProof || kind == .Lane -> return 4
    if kind == .Map -> return 8
    6
}

fn mir_pass_setter_route_arity(kind: MirIndexKind) -> Int {
    if kind == .List || kind == .FixedListProof || kind == .Lane -> return 5
    if kind == .Map -> return 3
    7
}

fn mir_pass_validate_panic_context(context: MirPanicContext, function: MirFunction) -> ?String {
    if context.function == "" -> return Val("panic context has no function")
    seen := [MirLocalId]{}
    loop local in &context.locals {
        if local.name == "" -> return Val("panic context has an unnamed local")
        if mir_pass_local_id_seen(seen, local.local) -> return Val("panic context local is duplicated")
        seen.push(local.local)
        found := false
        loop candidate in &function.locals {
            if candidate.id == local.local -> found = true
        }
        if !found -> return Val("panic context references a missing local")
    }
    None
}

fn mir_pass_validate_prelude_rows(rows: [MirPreludeCall]) -> ?String {
    seen := [MirPreludeCallId]{}
    loop row in &rows {
        if row.id.value == 0 || mir_pass_prelude_id_seen(seen, row.id) -> return Val("Prelude route identity is missing or duplicated")
        seen.push(row.id)
        if row.module_name == "" || row.member == "" || mir_symbol_name(row.symbol) == "" -> return Val("Prelude route has an empty identity")
        if row.signature.arity < 0 || row.signature.max_arity < row.signature.arity || row.signature.borrow_mask.len() != row.signature.arity -> return Val("Prelude route signature arity is inconsistent")
        failure := mir_pass_validate_call_fallibility(row.fallibility)
        if failure != None -> return failure
        if row.effect_name != None {
            effect_name :: row.effect_name ?? return Val("Prelude route effect metadata is missing")
            if effect_name == "" -> return Val("Prelude route effect name is empty")
        }
    }
    None
}

fn mir_pass_validate_call_fallibility(fallibility: MirCallFallibility) -> ?String {
    if fallibility == {
        .Infallible -> return None
        .Failure(carrier) -> return mir_pass_validate_failure_carrier(carrier)
    }
}
fn mir_pass_validate_place(
    place: MirPlace,
    function: MirFunction,
    program: MirProgram,
    definitions: [MirPassDefinition],
) -> ?String {
    if !mir_pass_type_valid(place.ty) -> return Val("place type has invalid MIR layout")
    if place.span.start > place.span.end -> return Val("place span is inverted")
    if place.base == {
        .Local(local) -> {
            found := false
            loop candidate in &function.locals { if candidate.id == local -> found = true }
            if !found -> return Val("place references a missing local")
        }
        .Parameter(value) | .Capture(value) | .Temporary(value) -> {
            if !mir_pass_definition_exists(definitions, value) -> return Val("place base references an undefined value")
        }
        .Static(name) -> {
            if name == "" -> return Val("static place has an empty name")
        }
    }
    loop projection in &place.projections {
        if projection == {
            .Field(field, span) -> {
                if !mir_pass_field_id_exists(program.fields, field) -> return Val("place field projection references an unknown field")
                if span.start > span.end -> return Val("place field projection span is inverted")
            }
            .Index(kind, index, call, write_call, location, context, span) -> {
                if !mir_pass_definition_exists(definitions, index) -> return Val("place index is undefined")
                if !mir_pass_prelude_id_exists(program.prelude_calls, call) -> return Val("place index route is missing")
                route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("place index route is missing")
                arity := mir_pass_index_route_arity(kind)
                if route.signature.arity != arity || route.signature.max_arity != arity || route.abi != .Value -> return Val("place index route has invalid ABI or arity")
                if (place.access == .Write) != (write_call != None) -> return Val("place index write route disagrees with place access")
                if write_call != None {
                    setter :: write_call ?? return Val("place index setter route is missing")
                    if !mir_pass_prelude_id_exists(program.prelude_calls, setter) -> return Val("place index setter route is missing")
                    setter_route :: mir_pass_prelude(program.prelude_calls, setter) ?? return Val("place index setter route is missing")
                    setter_arity := mir_pass_setter_route_arity(kind)
                    if setter_route.signature.arity != setter_arity || setter_route.signature.max_arity != setter_arity || setter_route.abi != .Value -> return Val("place index setter route has invalid ABI or arity")
                }
                if (kind == .Map || kind == .Pool) != (context != None) -> return Val("place index panic context disagrees with index kind")
                if context != None {
                    context_failure := mir_pass_validate_panic_context(context ?? MirPanicContext{function: "", source_line: "", caret: 0, locals: [MirPanicLocal]{}}, function)
                    if context_failure != None -> return context_failure
                }
                if !mir_pass_source_file_id_exists(program.source_files, location.file) -> return Val("place index panic location references an unknown source file")
                if span.start > span.end -> return Val("place index projection span is inverted")
            }
            .Deref(span) -> {
                if span.start > span.end -> return Val("place dereference span is inverted")
            }
        }
    }
    None
}

fn mir_pass_prelude(rows: [MirPreludeCall], id: MirPreludeCallId) -> ?MirPreludeCall {
    loop row in &rows { if row.id == id -> return Val(row) }
    None
}
fn mir_pass_append_optional_place(places: &[MirPlaceId], optional: ?MirPlaceId) {
    if optional != None {
        place :: optional ?? MirPlaceId{value: 0}
        if !mir_pass_place_id_seen(places, place) -> places.push(place)
    }
}


fn mir_pass_operation_place_refs(operation: MirOperation) -> [MirPlaceId] {
    places := mir_operation_place_uses(operation)
    if operation == {
        .Call(_, args, _)
        | .IndirectCall(_, args, _)
        | .CoreCall(_, _, args, _, _, _) -> {
            loop arg in args {
                mir_pass_append_optional_place(&places, arg.place)
            }
        }
        .Semantic(semantic) -> {
            if semantic == {
                .StaticPreludeCall(_, args, _, _)
                | .HardwareCall(_, _, _, args)
                | .ClosureMethod(_, args, _)
                | .HostCall(_, args)
                | .AllocNew(_, _, _, args) -> {
                    loop arg in args {
                        mir_pass_append_optional_place(&places, arg.place)
                    }
                }
                else -> {}
            }
        }
        else -> {}
    }
    places
}

fn mir_pass_semantic_field_uses(operation: MirSemanticOp) -> [MirFieldId] {
    fields := [MirFieldId]{}
    if operation == {
        .StructLiteral(_, values, _, _, boxed) -> {
            loop value in values -> fields.push(value.field)
            loop field in boxed -> fields.push(field)
        }
        .CellGuardProject(_, _, _, paths, _, _) -> {
            loop path in paths {
                loop field in path -> fields.push(field)
            }
        }
        .SharedGuardMap(_, _, path, _) -> loop field in path -> fields.push(field)
        .SharedGuardSplit(_, _, _, first, second, _) -> {
            loop field in first -> fields.push(field)
            loop field in second -> fields.push(field)
        }
        .ColumnarRead(_, _, column, _, _) -> fields.push(column)
        .BuiltinMethod(_, _, _, _, aggregate_fields) -> {
            if aggregate_fields != None {
                values :: aggregate_fields ?? return fields
                loop field in values -> fields.push(field)
            }
        }
        .CarrierFact(_, _, field, _) -> fields.push(field)
        else -> {}
    }
    fields
}

fn mir_pass_value_type(function: MirFunction, value: MirValueId) -> ?MirType {
    loop row in &function.values {
        if row.id == value -> return Val(row.ty)
    }
    None
}

fn mir_pass_value_ownership(function: MirFunction, value: MirValueId) -> ?MirOwnership {
    loop row in &function.values {
        if row.id == value -> return Val(row.ownership)
    }
    None
}

fn mir_pass_validate_call_args(
    args: [MirCallArg],
    function: MirFunction,
    program: MirProgram,
    definitions: [MirPassDefinition],
) -> ?String {
    loop arg in args {
        if arg.span.start > arg.span.end -> return Val("call argument span is inverted")
        if !mir_pass_definition_exists(definitions, arg.value) -> return Val("call argument references an undefined value")
        if arg.access == .Write && arg.place == None -> return Val("write call argument has no checked place")
        if arg.place != None {
            place :: arg.place ?? return Val("call argument place is missing")
            if !mir_pass_place_exists(function.places, place) -> return Val("call argument references a missing place")
        }
        if arg.label != None {
            label :: arg.label ?? return Val("call argument label is missing")
            if label == "" -> return Val("call argument label is empty")
        }
        if arg.fn_coercion != None {
            coercion :: arg.fn_coercion ?? return Val("function coercion metadata is missing")
            if !mir_pass_type_valid(coercion.ty) -> return Val("function coercion type is invalid")
        }
        if arg.widen_to_union != None {
            coercion :: arg.widen_to_union ?? return Val("union coercion metadata is missing")
            if !mir_pass_type_id_exists(program.types, coercion.union) || coercion.variant == "" -> return Val("union coercion metadata is invalid")
        }
        if arg.box_as_trait != None {
            trait_type :: arg.box_as_trait ?? return Val("trait boxing type is missing")
            if !mir_pass_type_id_exists(program.types, trait_type) -> return Val("trait boxing type is unknown")
        }
        consumes_coercion := arg.fn_coercion != None || arg.widen_to_union != None || arg.box_as_trait != None
        ownership :: mir_pass_value_ownership(function, arg.value) ?? return Val("call argument ownership metadata is missing")
        if consumes_coercion && ownership.mode != .Copy && arg.access != .Move && !arg.implicit_clone && !arg.shared_auto_clone && !arg.owned_last_use {
            return Val("coercion consumes a non-Copy call argument")
        }
    }
    None
}
fn mir_pass_route_matches(
    route: MirPreludeCall,
    family: MirPreludeFamily,
    module_name: String,
    member: String,
    symbol: String,
    arity: Int,
    borrow_mask: [Bool],
    abi: MirPreludeAbi,
) -> Bool {
    route.family == family
        && route.module_name == module_name
        && route.member == member
        && mir_symbol_name(route.symbol) == symbol
        && route.signature.arity == arity
        && route.signature.max_arity == arity
        && route.signature.borrow_mask == borrow_mask
        && route.abi == abi
}

fn mir_pass_core_symbol_matches(core_symbol: CoreCallSymbol, route_symbol: MirSymbol) -> Bool {
    if core_symbol == {
        .Prelude(name) -> {
            if route_symbol == {
                .Prelude(route_name) -> return name == route_name
                else -> return false
            }
        }
        .Rust(name) -> {
            if route_symbol == {
                .Runtime(route_name) -> return name == route_name
                else -> return false
            }
        }
    }
    false
}


fn mir_pass_guard_route(
    rows: [MirPreludeCall],
    id: MirPreludeCallId,
    member: String,
    arity: Int,
    borrow_mask: [Bool],
    symbol: String,
) -> Bool {
    route :: mir_pass_prelude(rows, id) ?? return false
    mir_pass_route_matches(route, .StaticPrelude, "core.cell_guard", member, symbol, arity, borrow_mask, .Value)
}

fn mir_pass_guard_paths_distinct(first: [MirFieldId], second: [MirFieldId]) -> Bool {
    if first == second -> return false
    if mir_pass_field_path_prefix(first, second) || mir_pass_field_path_prefix(second, first) -> return false
    true
}

fn mir_pass_field_path_prefix(prefix: [MirFieldId], path: [MirFieldId]) -> Bool {
    if prefix.len() > path.len() -> return false
    index := 0
    loop index < prefix.len() {
        if prefix[index] != path[index] -> return false
        index += 1
    }
    true
}

fn mir_pass_text_pattern_parts_valid(parts: [MirTextPatternPart], program: MirProgram) -> Bool {
    loop part in parts {
        if part == {
            .Hole(_, type_id, span) -> {
                if !mir_pass_type_id_exists(program.types, type_id) || span.start > span.end -> return false
            }
            .Literal(_) -> {}
        }
    }
    true
}

fn mir_pass_binary_pattern_parts_valid(parts: [MirBinaryPatternPart], program: MirProgram) -> Bool {
    loop part in parts {
        if part == {
            .Bits(_, type_id, _, span) | .Rest(type_id, span) -> {
                if !mir_pass_type_id_exists(program.types, type_id) || span.start > span.end -> return false
            }
            .Literal(_) -> {}
        }
    }
    true
}

fn mir_pass_validate_semantic_operation(
    operation: MirSemanticOp,
    span: Span,
    function: MirFunction,
    program: MirProgram,
    definitions: [MirPassDefinition],
) -> ?String {
    loop value in mir_semantic_op_value_uses(operation) {
        if !mir_pass_definition_exists(definitions, value) -> return Val("semantic operation references an undefined value")
    }
    loop type_id in mir_semantic_op_type_uses(operation) {
        if !mir_pass_type_id_exists(program.types, type_id) -> return Val("semantic operation references an unknown type")
    }
    loop field in mir_pass_semantic_field_uses(operation) {
        if !mir_pass_field_id_exists(program.fields, field) -> return Val("semantic operation references an unknown field")
    }
    loop call in mir_semantic_op_prelude_calls(operation) {
        if !mir_pass_prelude_id_exists(program.prelude_calls, call) -> return Val("semantic operation references a missing Prelude route")
    }
    loop place in mir_semantic_op_place_uses(operation) {
        if !mir_pass_place_exists(function.places, place) -> return Val("semantic operation references a missing place")
    }

    if operation == {
        .ReflectOf(type_name, path, _, fields) -> {
            if type_name == "" || path == "" -> return Val("reflection operation has an empty identity path")
            loop field in fields {
                if field.name == "" || field.type_name == "" || field.path == "" -> return Val("reflection field metadata is incomplete")
            }
        }
        .OverflowOption(_, _, _, location) -> {
            if location != None {
                loc :: location ?? return Val("overflow location is missing")
                if !mir_pass_source_file_id_exists(program.source_files, loc.file) -> return Val("overflow location references an unknown source file")
            }
        }
        .DataEntriesToMap(_, local) -> {
            found := false
            loop candidate in &function.locals { if candidate.id == local -> found = true }
            if !found -> return Val("data-entry map operation references a missing local")
        }
        .MathBuiltin(_, call, _) -> {
            route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("numeric builtin route is missing")
            if route.family != .MathBuiltin -> return Val("math builtin route family is inconsistent")
        }
        .PreciseBuiltin(_, call, _) -> {
            route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("numeric builtin route is missing")
            if route.family != .PreciseBuiltin -> return Val("precise builtin route family is inconsistent")
        }
        .RequireStop(call, kind, condition, location, context, _, _) -> {
            if !mir_pass_source_file_id_exists(program.source_files, location.file) -> return Val("require-stop location references an unknown source file")
            requires_condition := kind == .Require || kind == .RequireEq
            if (condition != None) != requires_condition -> return Val("require-stop condition presence is inconsistent")
            if condition != None {
                value :: condition ?? return Val("require-stop condition is missing")
                type :: mir_pass_value_type(function, value) ?? return Val("require-stop condition type is missing")
                if type.kind != .Bool -> return Val("require-stop condition is not Bool")
            }
            context_failure := mir_pass_validate_panic_context(context, function)
            if context_failure != None -> return context_failure
        }
        .ColumnarRead(_, _, _, column_index, accessor) -> {
            route :: mir_pass_prelude(program.prelude_calls, accessor) ?? return Val("columnar accessor route is missing")
            if column_index < 0 || !mir_pass_route_matches(route, .ColumnarAccess, "core.columnar", route.member, 3, [Bool]{true, false, false}, .Value) || !route.member.ends_with("#{column_index}") || mir_symbol_name(route.symbol) != "jet_columns_gather_cell" -> return Val("columnar accessor route metadata is inconsistent")
        }
        .CellGuardProject(map_call, split_call, _, paths, editable, disjoint) -> {
            map_member := if editable -> "map_edit" else -> "map_read"
            if !mir_pass_guard_route(program.prelude_calls, map_call, map_member, 2, [Bool]{true, false}, "jet_cell_guard_map") -> return Val("cell guard map route metadata is inconsistent")
            if paths.len() < 1 || paths.len() > 2 -> return Val("cell guard projection must carry one or two paths")
            loop path in paths { if path.len() == 0 -> return Val("cell guard projection has an empty path") }
            split := paths.len() == 2
            if (split_call != None) != split -> return Val("cell guard split route disagrees with path count")
            if split_call != None {
                split_id :: split_call ?? return Val("cell guard split route is missing")
                if split_id == map_call -> return Val("cell guard projection reuses its map route")
                split_member := if editable -> "split_edit" else -> "split_read"
                split_route :: mir_pass_prelude(program.prelude_calls, split_id) ?? return Val("cell guard split route is missing")
                if !mir_pass_route_matches(split_route, .StaticPrelude, "core.cell_guard", split_member, "jet_cell_guard_split", 3, [Bool]{true, false, false}, .Value) -> return Val("cell guard split route metadata is inconsistent")
                if !mir_pass_guard_paths_distinct(paths[0], paths[1]) -> return Val("cell guard split paths overlap")
            }
            if disjoint && (!editable || !split) -> return Val("cell guard disjointness proof has no editable split")
            if editable && split && !disjoint -> return Val("editable cell guard split is missing disjointness proof")
        }
        .SharedGuardMap(call, _, path, editable) -> {
            if path.len() == 0 -> return Val("shared guard map has an empty path")
            member := if editable -> "map_edit" else -> "map_read"
            route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("shared guard map route is missing")
            if !mir_pass_route_matches(route, .StaticPrelude, "core.shared_guard", member, "jet_shared_guard_map", 3, [Bool]{true, false, false}, .Control) -> return Val("shared guard map route metadata is inconsistent")
        }
        .SharedGuardSplit(call, map_call, _, first, second, editable) -> {
            if first.len() == 0 || second.len() == 0 || !mir_pass_guard_paths_distinct(first, second) -> return Val("shared guard split paths overlap")
            if call == map_call -> return Val("shared guard split reuses its map route")
            member := if editable -> "split_edit" else -> "split_read"
            split_route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("shared guard split route is missing")
            map_route :: mir_pass_prelude(program.prelude_calls, map_call) ?? return Val("shared guard map route is missing")
            if !mir_pass_route_matches(split_route, .StaticPrelude, "core.shared_guard", member, "jet_shared_guard_split", 4, [Bool]{true, false, false, false}, .Control) -> return Val("shared guard split route metadata is inconsistent")
            map_member := if editable -> "map_edit" else -> "map_read"
            if !mir_pass_route_matches(map_route, .StaticPrelude, "core.shared_guard", map_member, "jet_shared_guard_map", 3, [Bool]{true, false, false}, .Control) -> return Val("shared guard map route metadata is inconsistent")
        }
        .TextPatternMatch(call, _, parts) -> {
            route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("text pattern route is missing")
            if !mir_pass_route_matches(route, .StaticPrelude, "core.pattern", "text_match", "jet_text_pattern_match", 2, [Bool]{true, false}, .Value) || !mir_pass_text_pattern_parts_valid(parts, program) -> return Val("text pattern route or parts are invalid")
        }
        .BinaryPatternMatch(call, _, parts) -> {
            route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("binary pattern route is missing")
            if !mir_pass_route_matches(route, .StaticPrelude, "core.pattern", "binary_match", "jet_binary_pattern_match", 2, [Bool]{true, false}, .Value) || !mir_pass_binary_pattern_parts_valid(parts, program) -> return Val("binary pattern route or parts are invalid")
        }
        .CursorTakePattern(_, place, parts) -> {
            receiver :: mir_pass_find_place(function.places, place) ?? return Val("cursor pattern receiver place is missing")
            if receiver.access != .Write || !mir_pass_text_pattern_parts_valid(parts, program) -> return Val("cursor pattern receiver or parts are invalid")
        }
        .ReaderTakePattern(_, place, parts) -> {
            receiver :: mir_pass_find_place(function.places, place) ?? return Val("reader pattern receiver place is missing")
            if receiver.access != .Write || !mir_pass_binary_pattern_parts_valid(parts, program) -> return Val("reader pattern receiver or parts are invalid")
        }
        .CarrierFact(_, receiver, _, _) -> {
            type :: mir_pass_value_type(function, receiver) ?? return Val("carrier fact receiver type is missing")
            if !mir_pass_type_is_result(type) -> return Val("carrier fact receiver is not a Result")
        }
        .GcEdit(call, root, edges, edit, index, kind, site) -> {
            if site.value == 0 || !mir_pass_definition_exists(definitions, root) || !mir_pass_definition_exists(definitions, edit) -> return Val("GC edit carries an invalid root, edit, or site")
            loop edge in edges { if !mir_pass_definition_exists(definitions, edge) -> return Val("GC edit carries an undefined edge") }
            if index != None {
                value :: index ?? return Val("GC edit index is missing")
                if !mir_pass_definition_exists(definitions, value) -> return Val("GC edit index is undefined")
            }
            gc_failure := mir_pass_validate_gc_edit_route(program.prelude_calls, call, kind, edges, index)
            if gc_failure != None -> return gc_failure
        }
        .TypedTextInterp(call, kind, literals, holes, trusted) -> {
            route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("typed text route is missing")
            route_shape := mir_pass_typed_text_route_shape(kind)
            if !mir_pass_route_matches(route, .StaticPrelude, "core.typed_text", route_shape.member, route_shape.symbol, route_shape.arity, route_shape.borrow_mask, .Value) -> return Val("typed text route metadata is inconsistent")
            if literals.len() != holes.len() + 1 || trusted.len() != holes.len() -> return Val("typed text interpolation metadata has the wrong arity")
            if kind != .HTML {
                loop flag in trusted { if flag -> return Val("non-HTML text interpolation carries HTML trust metadata") }
            }
        }
        .CCallback(call, callback, lambda) -> {
            if !mir_pass_callback_id_exists(program.callbacks, callback) -> return Val("C callback references an unknown callback")
            route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("C callback route is missing")
            if !mir_pass_route_matches(route, .StaticPrelude, "core.ffi", "callback_boundary", "jet_ffi_callback_boundary", 1, [Bool]{false}, .Value) -> return Val("C callback route metadata is inconsistent")
            type :: mir_pass_value_type(function, lambda) ?? return Val("C callback lambda type is missing")
            if !mir_pass_type_is_callable(type) -> return Val("C callback lambda is not callable")
        }
        .HttpRouterRegister(call, receiver, _, handler, _, names, _, location) -> {
            if !mir_pass_source_file_id_exists(program.source_files, location.file) -> return Val("HTTP registration location references an unknown source file")
            receiver_type :: mir_pass_value_type(function, receiver) ?? return Val("HTTP registration receiver type is missing")
            route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("HTTP registration route is missing")
            route_shape := mir_pass_http_route_shape(receiver_type, names)
            if route_shape.arity == 0 || !mir_pass_route_matches(route, .StaticPrelude, "core.http", route_shape.member, route_shape.symbol, route_shape.arity, route_shape.borrow_mask, .Control) -> return Val("HTTP registration route metadata is inconsistent")
            if !mir_pass_definition_exists(definitions, handler) -> return Val("HTTP registration handler is undefined")
        }
        .PluginInvoke(call, handle, _, _, args) -> {
            if !mir_pass_definition_exists(definitions, handle) -> return Val("plugin handle is undefined")
            loop arg in args { if !mir_pass_definition_exists(definitions, arg) -> return Val("plugin argument is undefined") }
            route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("plugin route is missing")
            if !mir_pass_route_matches(route, .HandleMethod, "core.handle", "plugin.invoke", "jet_plugin_call", 3, [Bool]{true, true, true}, .Value) -> return Val("plugin route metadata is inconsistent")
        }
        .StaticPreludeCall(_, args, owner_type_args, type_args) -> {
            args_failure := mir_pass_validate_call_args(args, function, program, definitions)
            if args_failure != None -> return args_failure
            loop owner in owner_type_args {
                if owner == {
                    .Type(type) -> {
                        if !mir_pass_type_valid(type) -> return Val("Prelude owner type argument is invalid")
                    }
                    .HostUsize -> {}
                }
            }
            loop type in type_args { if !mir_pass_type_valid(type) -> return Val("Prelude type argument is invalid") }
        }
        .HardwareCall(call, op, receiver, args) -> {
            args_failure := mir_pass_validate_call_args(args, function, program, definitions)
            if args_failure != None -> return args_failure
            hardware_failure := mir_pass_validate_hardware_call(program, call, op, receiver, args, function, definitions)
            if hardware_failure != None -> return hardware_failure
        }
        .ClosureMethod(_, args, _) | .HostCall(_, args) -> {
            args_failure := mir_pass_validate_call_args(args, function, program, definitions)
            if args_failure != None -> return args_failure
        }
        .AllocNew(_, _, inline_size, args) -> {
            if inline_size != None {
                size :: inline_size ?? return Val("allocator inline size is missing")
                if size < 0 -> return Val("allocator inline size is negative")
            }
            args_failure := mir_pass_validate_call_args(args, function, program, definitions)
            if args_failure != None -> return args_failure
        }
        .HostBorrowCallback(_, params) -> {
            loop type in params { if !mir_pass_type_valid(type) -> return Val("host callback parameter type is invalid") }
        }
        .CoreClosureCall(_, _, _, _, site, _) -> {
            if site.value == 0 -> return Val("core closure call has a zero site identity")
        }
        // Every remaining semantic form is covered by the canonical value,
        // type, field, place, and Prelude walkers above.  There is no
        // target-local fallback or ignored semantic variant.
        else -> {}
    }
    None
}
struct MirPassRouteShape {
    pub member: String
    pub symbol: String
    pub arity: Int
    pub borrow_mask: [Bool]
}

fn mir_pass_type_is_result(ty: MirType) -> Bool {
    if ty.kind == {
        .Result(_, _) -> return true
    }
    false
}

fn mir_pass_type_is_callable(ty: MirType) -> Bool {
    if ty.kind == {
        .Fn(_) | .SendFn(_, _, _) -> return true
        else -> return false
    }
}

fn mir_pass_typed_text_route_shape(kind: MirTypedHeadKind) -> MirPassRouteShape {
    if kind == .SQL -> return MirPassRouteShape{member: "sql_interpolate", symbol: "jet_typed_sql_interpolate", arity: 2, borrow_mask: [Bool]{true, false}}
    if kind == .HTML -> return MirPassRouteShape{member: "html_interpolate", symbol: "jet_typed_html_interpolate", arity: 3, borrow_mask: [Bool]{true, false, true}}
    if kind == .Sh -> return MirPassRouteShape{member: "sh_interpolate", symbol: "jet_typed_sh_interpolate", arity: 2, borrow_mask: [Bool]{true, false}}
    if kind == .URL -> return MirPassRouteShape{member: "url_literal", symbol: "jet_std::jet_typed_url_literal", arity: 2, borrow_mask: [Bool]{true, false}}
    if kind == .Path -> return MirPassRouteShape{member: "path_literal", symbol: "jet_typed_path_literal", arity: 2, borrow_mask: [Bool]{true, false}}
    MirPassRouteShape{member: "datetime_literal", symbol: "jet_typed_datetime_literal", arity: 2, borrow_mask: [Bool]{true, false}}
}

fn mir_pass_gc_route_shape(kind: MirGcEditKind) -> MirPassRouteShape {
    if kind == .Clear -> return MirPassRouteShape{member: "edit_clear", symbol: "jet_gc_edit_clear", arity: 2, borrow_mask: [Bool]{true, false}}
    if kind == .Pop -> return MirPassRouteShape{member: "edit_pop", symbol: "jet_gc_edit_pop", arity: 2, borrow_mask: [Bool]{true, false}}
    if kind == .RemoveIndex -> return MirPassRouteShape{member: "edit_remove_index", symbol: "jet_gc_edit_remove_index", arity: 3, borrow_mask: [Bool]{true, false, false}}
    if kind == .InsertIndex -> return MirPassRouteShape{member: "edit_insert_index", symbol: "jet_gc_edit_insert_index", arity: 4, borrow_mask: [Bool]{true, false, true, false}}
    if kind == .Prepend -> return MirPassRouteShape{member: "edit_prepend", symbol: "jet_gc_edit_prepend", arity: 3, borrow_mask: [Bool]{true, true, false}}
    if kind == .Additive -> return MirPassRouteShape{member: "edit_additive", symbol: "jet_gc_edit_additive", arity: 3, borrow_mask: [Bool]{true, true, false}}
    if kind == .Plain -> return MirPassRouteShape{member: "edit_plain", symbol: "jet_gc_edit_plain", arity: 2, borrow_mask: [Bool]{true, false}}
    MirPassRouteShape{member: "edit_edge_slot", symbol: "jet_gc_edit_edge_slot", arity: 4, borrow_mask: [Bool]{true, true, false, false}}
}

fn mir_pass_validate_gc_edit_route(
    rows: [MirPreludeCall],
    call: MirPreludeCallId,
    kind: MirGcEditKind,
    edges: [MirValueId],
    index: ?MirValueId,
) -> ?String {
    route :: mir_pass_prelude(rows, call) ?? return Val("GC edit route is missing")
    shape := mir_pass_gc_route_shape(kind)
    if !mir_pass_route_matches(route, .StaticPrelude, "core.gc", shape.member, shape.symbol, shape.arity, shape.borrow_mask, .Value) -> return Val("GC edit route metadata is inconsistent")
    if kind == .Clear || kind == .Pop || kind == .Plain {
        if index != None || edges.len() != 0 -> return Val("GC edit carries unused operands")
    }
    if kind == .RemoveIndex {
        if index == None || edges.len() != 0 -> return Val("GC remove edit carries the wrong operands")
    }
    if kind == .InsertIndex && index == None -> return Val("GC insert edit has no index")
    if (kind == .Prepend || kind == .Additive) && index != None -> return Val("GC edge edit carries an index")
    if kind == .EdgeSlot && (index != None || edges.len() == 0) -> return Val("GC edge-slot edit carries the wrong operands")
    None
}

fn mir_pass_http_route_shape(receiver: MirType, handler_names: [String]) -> MirPassRouteShape {
    if receiver.kind == {
        .Apply(name, _) -> {
            if name.name == "HTTPMux" && handler_names.len() == 0 -> return MirPassRouteShape{member: "mux_add_zero", symbol: "jet_http_mux_add_zero_handler", arity: 4, borrow_mask: [Bool]{true, false, false, false}}
            if name.name == "HTTPMux" -> return MirPassRouteShape{member: "mux_add", symbol: "jet_http_mux_add_handler", arity: 4, borrow_mask: [Bool]{true, false, false, false}}
            if name.name == "HTTPRouter" -> return MirPassRouteShape{member: "router_register", symbol: "jet_http_router_register", arity: 7, borrow_mask: [Bool]{true, false, false, false, true, false, false}}
        }
        else -> {}
    }
    MirPassRouteShape{member: "", symbol: "", arity: 0, borrow_mask: [Bool]{}}
}

fn mir_pass_validate_hardware_call(
    program: MirProgram,
    call: MirPreludeCallId,
    operation: MirHardwareOp,
    receiver: ?MirValueId,
    args: [MirCallArg],
    function: MirFunction,
    definitions: [MirPassDefinition],
) -> ?String {
    route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("hardware route is missing")
    if route.signature.arity != args.len() || route.signature.max_arity != args.len() || route.abi != .Value -> return Val("hardware route has invalid argument metadata")
    loop borrowed in route.signature.borrow_mask { if borrowed -> return Val("hardware route has a borrow mask for a value argument") }
    expected_receiver := if operation == {
        .DmaWait(_, _, _) -> true
        else -> false
    }
    if (receiver != None) != expected_receiver -> return Val("hardware receiver presence is inconsistent")
    if receiver != None {
        value :: receiver ?? return Val("hardware receiver is missing")
        if !mir_pass_definition_exists(definitions, value) -> return Val("hardware receiver is undefined")
    }
    expected_access := if operation == {
        .RegisterWrite(_, _, _, _) -> Val(MirAccess.Read)
        .DmaStart(_, _, _) -> Val(MirAccess.Move)
        else -> None
    }
    if expected_access != None {
        access :: expected_access ?? return Val("hardware argument access is missing")
        if args.len() != 1 || args[0].access != access || args[0].place != None -> return Val("hardware value argument metadata is inconsistent")
    } else if args.len() != 0 -> return Val("hardware operation has unexpected arguments")
    if operation == {
        .RegisterRead(profile, block, register, _) | .RegisterWrite(profile, block, register, _) -> {
            if profile == "" || block == "" || register == "" -> return Val("hardware register identity is empty")
        }
        .DmaStart(profile, channel, buffer_type) -> {
            if profile == "" || channel == "" || !mir_pass_type_valid(buffer_type) -> return Val("DMA start metadata is invalid")
            if args.len() == 0 -> return Val("DMA start has no buffer argument")
            argument_type :: mir_pass_value_type(function, args[0].value) ?? return Val("DMA buffer argument type is missing")
            if !mir_type_same_checked_type(argument_type, buffer_type) -> return Val("DMA buffer type disagrees with its argument")
        }
        .DmaWait(profile, channel, buffer_type) -> {
            if profile == "" || channel == "" || !mir_pass_type_valid(buffer_type) -> return Val("DMA wait metadata is invalid")
            receiver_value :: receiver ?? return Val("DMA wait has no receiver")
            receiver_type :: mir_pass_value_type(function, receiver_value) ?? return Val("DMA receiver type is missing")
            valid := false
            if receiver_type.kind == {
                .Apply(name, arguments) -> {
                    valid = name.name == "__JetDmaTransfer" && arguments.len() == 1 && mir_type_same_checked_type(arguments[0], buffer_type)
                }
                else -> {}
            }
            if !valid -> return Val("DMA receiver is not the checked transfer type")
        }
    }
    None
}
fn mir_pass_operation_field_uses(operation: MirOperation) -> [MirFieldId] {
    fields := [MirFieldId]{}
    if operation == {
        .ProjectMembers(_, members) -> loop field in members -> fields.push(field)
        .Field(_, field) -> fields.push(field)
        .Struct(_, values) | .Tuple(_, values) -> loop value in values -> fields.push(value.field)
        .Enum(_, _, args) -> {
            loop arg in args {
                if arg.field != None {
                    field :: arg.field ?? MirFieldId{value: 0}
                    fields.push(field)
                }
            }
        }
        else -> {}
    }
    fields
}

fn mir_pass_validate_operation_legality(
    operation: MirOperation,
    span: Span,
    function: MirFunction,
    program: MirProgram,
    definitions: [MirPassDefinition],
) -> ?String {
    loop type_id in mir_operation_type_uses(operation) {
        if !mir_pass_type_id_exists(program.types, type_id) -> return Val("operation references an unknown type")
    }
    loop field in mir_pass_operation_field_uses(operation) {
        if !mir_pass_field_id_exists(program.fields, field) -> return Val("operation references an unknown field")
    }
    loop call in mir_operation_prelude_calls(operation) {
        if !mir_pass_prelude_id_exists(program.prelude_calls, call) -> return Val("operation references a missing Prelude route")
    }
    loop place in mir_pass_operation_place_refs(operation) {
        if !mir_pass_place_exists(function.places, place) -> return Val("operation references a missing place")
    }
    if operation == {
        .Semantic(semantic) -> return mir_pass_validate_semantic_operation(semantic, span, function, program, definitions)
        .Binary(_, dispatch, _, _, _) -> {
            if dispatch == {
                .Prelude(call, location) -> {
                    if !mir_pass_prelude_id_exists(program.prelude_calls, call) -> return Val("binary Prelude route is missing")
                    if location != None {
                        loc :: location ?? return Val("binary panic location is missing")
                        if !mir_pass_source_file_id_exists(program.source_files, loc.file) -> return Val("binary panic location references an unknown source file")
                    }
                }
                .Primitive -> {}
            }
        }
        .Parameter(index, name) -> {
            if index < 0 || index >= function.params.len() -> return Val("parameter operation index is out of range")
            if name == "" || function.params[index].name != name -> return Val("parameter operation name disagrees with its parameter")
        }
        .Capture(slot) -> {
            if slot < 0 || slot >= function.capture_params.len() -> return Val("capture operation slot is out of range")
        }
        .Call(callee, args, type_args) -> {
            callee_failure := mir_pass_validate_callee(callee, args, function, program, definitions, span)
            if callee_failure != None -> return callee_failure
            loop type in type_args { if !mir_pass_type_valid(type) -> return Val("call type argument is invalid") }
        }
        .IndirectCall(_, args, type_args) -> {
            args_failure := mir_pass_validate_call_args(args, function, program, definitions)
            if args_failure != None -> return args_failure
            loop type in type_args { if !mir_pass_type_valid(type) -> return Val("indirect call type argument is invalid") }
        }
        .CoreCall(call, route, args, type_args, fallibility, data_plan) -> {
            if !mir_pass_core_id_exists(program.core_calls, call) || !mir_pass_prelude_id_exists(program.prelude_calls, route) -> return Val("core call or route is missing")
            core :: mir_pass_core(program.core_calls, call) ?? return Val("core call is missing")
            route_row :: mir_pass_prelude(program.prelude_calls, route) ?? return Val("core route is missing")
            if args.len() < core.arity || args.len() > core.max_arity || args.len() < route_row.signature.arity || args.len() > route_row.signature.max_arity -> return Val("core call argument arity is invalid")
            if core.arity != route_row.signature.arity || core.max_arity != route_row.signature.max_arity || core.borrow_mask != route_row.signature.borrow_mask || !mir_pass_core_symbol_matches(core.symbol, route_row.symbol) -> return Val("core call signature disagrees with its route")
            if !mir_pass_fallibility_same(route_row.fallibility, fallibility) -> return Val("core call fallibility disagrees with its route")
            args_failure := mir_pass_validate_call_args(args, function, program, definitions)
            if args_failure != None -> return args_failure
            fallibility_failure := mir_pass_validate_call_fallibility(fallibility)
            if fallibility_failure != None -> return fallibility_failure
            loop type in type_args { if !mir_pass_type_valid(type) -> return Val("core call type argument is invalid") }
            if data_plan != None {
                plan :: data_plan ?? return Val("core data plan is missing")
                plan_failure := mir_pass_validate_data_plan(plan)
                if plan_failure != None -> return plan_failure
            }
        }
        .MovePlace(place) -> {
            row :: mir_pass_find_place(function.places, place) ?? return Val("move place is missing")
            if row.access != .Move -> return Val("MovePlace does not use a move-access place")
            if row.base == {
                .Static(_) -> {
                    if row.projections.len() != 0 -> return Val("static MovePlace must target the whole static root")
                }
                else -> {}
            }
        }
        .InitializeUninit(place) -> {
            row :: mir_pass_find_place(function.places, place) ?? return Val("uninitialized place is missing")
            if row.projections.len() != 0 -> return Val("uninitialized place has projections")
            if row.base == {
                .Local(local) -> {
                    local_row :: mir_pass_find_local(function.locals, local) ?? return Val("uninitialized place local is missing")
                    if local_row.place != place || !local_row.uninit -> return Val("uninitialized place is not an uninitialized local root")
                }
                else -> return Val("uninitialized place is not a local root")
            }
        }
        .Enum(_, variant, _) -> {
            if variant == "" -> return Val("enum operation has an empty variant")
        }
        .EnumIs(_, _, variant) | .EnumPayload(_, _, variant, _) -> {
            if variant == "" -> return Val("enum projection has an empty variant")
        }
        .Index(call, _, _, kind, _, location, context) -> {
            route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("index route is missing")
            arity := mir_pass_index_route_arity(kind)
            if route.signature.arity != arity || route.signature.max_arity != arity || route.abi != .Value -> return Val("index route has invalid ABI or arity")
            if !mir_pass_source_file_id_exists(program.source_files, location.file) -> return Val("index location references an unknown source file")
            if (kind == .Map || kind == .Pool) != (context != None) -> return Val("index context disagrees with index kind")
            if context != None {
                context_failure := mir_pass_validate_panic_context(context ?? MirPanicContext{function: "", source_line: "", caret: 0, locals: [MirPanicLocal]{}}, function)
                if context_failure != None -> return context_failure
            }
        }
        .Slice(call, _, _, _, range, location) -> {
            route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("slice route is missing")
            arity := if range != None -> 4 else -> 5
            if route.signature.arity != arity || route.signature.max_arity != arity || route.abi != .Value -> return Val("slice route has invalid ABI or arity")
            if !mir_pass_source_file_id_exists(program.source_files, location.file) -> return Val("slice location references an unknown source file")
        }
        .LoopRangeInit(call, _, _, _, _) -> {
            route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("loop range route is missing")
            no_borrow_mask := [Bool]{false, false, false, false, false}
            if route.signature.arity != 5 || route.signature.max_arity != 5 || route.signature.borrow_mask != no_borrow_mask || route.abi != .Value -> return Val("loop range route has invalid metadata")
        }
        .LoopIterInit(call, _, _, _, source_kind) -> {
            route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("loop iterator route is missing")
            no_borrow_mask := [Bool]{false, false, false, false, false}
            if route.signature.arity != 5 || route.signature.max_arity != 5 || route.signature.borrow_mask != no_borrow_mask || route.abi != .Value -> return Val("loop iterator route has invalid metadata")
            if source_kind == {
                .EncodingReader(reader_type) -> {
                    if reader_type == "" -> return Val("loop iterator encoding reader type is empty")
                }
                .Iterable(coll_type, iter_type, iter_symbol, next_symbol) -> {
                    if coll_type == "" || iter_type == "" || iter_symbol == "" || next_symbol == "" -> return Val("loop iterator Iterable metadata is incomplete")
                }
                else -> {}
            }
        }
        .LoopRangeHasNext(call, _)
        | .LoopRangeValue(call, _)
        | .LoopRangeAdvance(call, _)
        | .LoopIterHasNext(call, _)
        | .LoopIterValue(call, _)
        | .LoopIterAdvance(call, _) -> {
            if !mir_pass_prelude_id_exists(program.prelude_calls, call) -> return Val("loop route is missing")
        }
        .Todo(call, location, expected_type) -> {
            if !mir_pass_source_file_id_exists(program.source_files, location.file) -> return Val("Todo location references an unknown source file")
            if expected_type != None {
                type :: expected_type ?? return Val("Todo expected type is missing")
                if !mir_pass_type_valid(type) -> return Val("Todo expected type is invalid")
            }
        }
        .Closure(target, captures, _) -> {
            if !mir_pass_function_id_exists(program.functions, target) -> return Val("closure target function is missing")
            loop capture in captures {
                if capture == {
                    .Value(value) -> {
                        if !mir_pass_definition_exists(definitions, value) -> return Val("closure capture value is undefined")
                    }
                    .Place(place) -> {
                        if !mir_pass_place_exists(function.places, place) -> return Val("closure capture place is missing")
                    }
                }
            }
        }
        .Convert(value, parameters, target, conversion) -> {
            if !mir_pass_type_valid(target) -> return Val("conversion target type is invalid")
            if conversion == {
                .NumericCast -> {
                    source :: mir_pass_value_type(function, value) ?? return Val("numeric cast source type is missing")
                    if parameters.len() != 0 || !mir_type_is_numeric(source) || !mir_type_is_numeric(target) -> return Val("numeric cast requires scalar numeric operands")
                }
                .SendFn -> {
                    source :: mir_pass_value_type(function, value) ?? return Val("SendFn source type is missing")
                    if parameters.len() != 0 || !mir_pass_type_is_callable(source) || !mir_pass_type_is_callable(target) -> return Val("SendFn conversion requires callable signatures")
                }
                .Prelude(call, location, fallibility) -> {
                    route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("conversion Prelude route is missing")
                    if !mir_pass_fallibility_same(route.fallibility, fallibility) -> return Val("conversion fallibility disagrees with its route")
                    if !mir_pass_source_file_id_exists(program.source_files, location.file) -> return Val("conversion location references an unknown source file")
                    failure := mir_pass_validate_call_fallibility(fallibility)
                    if failure != None -> return failure
                }
                .Transparent -> {}
            }
        }
        .PtrFromAddr(_, element) -> {
            if !mir_pass_type_valid(element) -> return Val("pointer element type is invalid")
        }
        .Drop(value, kind) -> {
            if kind != .NoDrop {
                type :: mir_pass_value_type(function, value) ?? return Val("drop value type is missing")
                if mir_pass_drop_forbidden_type(type) -> return Val("scalar value cannot be dropped")
            }
        }
        else -> {}
    }
    None
}
fn mir_pass_validate_callee(
    callee: MirCallee,
    args: [MirCallArg],
    function: MirFunction,
    program: MirProgram,
    definitions: [MirPassDefinition],
    span: Span,
) -> ?String {
    if callee == {
        .User(target) -> {
            if !mir_pass_function_id_exists(program.functions, target) -> return Val("user callee is missing")
        }
        .Associated(target, owner) | .Method(target, owner) -> {
            if !mir_pass_function_id_exists(program.functions, target) || !mir_pass_type_valid(owner) -> return Val("associated callee is invalid")
            owner_id :: owner.identity ?? return Val("associated callee owner has no identity")
            if !mir_pass_type_id_exists(program.types, owner_id) -> return Val("associated callee owner type is missing")
        }
        .TraitMethod(method, trait_ref, receiver) -> {
            if !mir_pass_trait_id_exists(program.traits, trait_ref.id) || !mir_pass_trait_method_exists(program.traits, method) || trait_ref.name == "" -> return Val("trait method callee is invalid")
            receiver_id :: receiver.identity ?? return Val("trait method receiver has no identity")
            if !mir_pass_type_id_exists(program.types, receiver_id) || !mir_pass_type_valid(receiver) -> return Val("trait method receiver type is invalid")
        }
        .Core(call) -> {
            if !mir_pass_core_id_exists(program.core_calls, call) -> return Val("core callee is missing")
        }
        .Prelude(call) -> {
            route :: mir_pass_prelude(program.prelude_calls, call) ?? return Val("Prelude callee is missing")
            if args.len() < route.signature.arity || args.len() > route.signature.max_arity -> return Val("Prelude callee argument arity is invalid")
        }
        .Foreign(id) -> {
            if !mir_pass_foreign_id_exists(program.foreign, id) -> return Val("foreign callee is missing")
        }
        .Indirect(value) -> {
            if !mir_pass_definition_exists(definitions, value) -> return Val("indirect callee value is undefined")
        }
    }
    args_failure := mir_pass_validate_call_args(args, function, program, definitions)
    if args_failure != None -> return args_failure
    if span.start > span.end -> return Val("call span is inverted")
    None
}

fn mir_pass_fallibility_same(left: MirCallFallibility, right: MirCallFallibility) -> Bool {
    if left == {
        .Infallible -> return right == .Infallible
        .Failure(left_carrier) -> {
            if right == {
                .Failure(right_carrier) -> return mir_pass_failure_same(left_carrier, right_carrier)
                else -> return false
            }
            return false
        }
    }
}

fn mir_pass_failure_same(left: MirFailureCarrier, right: MirFailureCarrier) -> Bool {
    if left == {
        .Infallible -> return right == .Infallible
        .Result(left_ok, left_err) -> {
            if right == {
                .Result(right_ok, right_err) -> return mir_type_same_checked_type(left_ok, right_ok) && mir_type_same_checked_type(left_err, right_err)
                else -> return false
            }
            return false
        }
        .Optional(left_value) -> {
            if right == {
                .Optional(right_value) -> return mir_type_same_checked_type(left_value, right_value)
                else -> return false
            }
            return false
        }
        .Diverges(left_value) -> {
            if right == {
                .Diverges(right_value) -> return mir_type_same_checked_type(left_value, right_value)
                else -> return false
            }
            return false
        }
    }
}

fn mir_pass_validate_data_plan(plan: MirDataPlan) -> ?String {
    if plan.schema_version != MIR_DATA_PLAN_SCHEMA_VERSION -> return Val("data plan schema version is unsupported")
    if plan.logical.len() == 0 -> return Val("data plan has no logical nodes")
    if plan.output.value >= plan.logical.len() -> return Val("data plan output references a missing logical node")
    index := 0
    loop index < plan.logical.len() {
        node := plan.logical[index]
        if node.id.value != index -> return Val("data plan node identities are not canonical")
        if !mir_pass_type_valid(node.row_type) || node.span.start > node.span.end -> return Val("data plan row type or span is invalid")
        loop column in &node.columns {
            if !mir_pass_type_valid(column.ty) || column.name == "" -> return Val("data plan column is invalid")
        }
        if node.callable != None {
            callable :: node.callable ?? return Val("data plan callable is missing")
            if !mir_pass_type_valid(callable.parameter) || !mir_pass_type_valid(callable.result) || callable.label == "" -> return Val("data plan callable is invalid")
        }
        loop input in node.inputs {
            if input.value >= node.id.value -> return Val("data plan input does not precede its consuming node")
        }
        index += 1
    }
    loop physical in &plan.physical {
        if physical.logical.value >= plan.logical.len() || physical.reason.trim() == "" -> return Val("physical data plan node is invalid")
    }
    None
}

fn mir_pass_find_local(rows: [MirLocal], id: MirLocalId) -> ?MirLocal {
    loop row in &rows { if row.id == id -> return Val(row) }
    None
}

fn mir_pass_find_place(rows: [MirPlace], id: MirPlaceId) -> ?MirPlace {
    loop row in &rows { if row.id == id -> return Val(row) }
    None
}

fn mir_pass_core(rows: [MirCoreCall], id: MirCoreCallId) -> ?MirCoreCall {
    loop row in &rows { if row.id == id -> return Val(row) }
    None
}

fn mir_pass_scope_exists(rows: [MirScope], id: MirScopeId) -> Bool {
    loop row in &rows { if row.id == id -> return true }
    false
}

fn mir_pass_drop_forbidden_type(ty: MirType) -> Bool {
    mir_type_is_integer(ty) || mir_type_is_float(ty) || ty.kind == .Bool || ty.kind == .Char
}
fn mir_pass_validate_drops(function: MirFunction, definitions: [MirPassDefinition]) -> ?String {
    loop drop in &function.drops {
        if !mir_pass_place_exists(function.places, drop.place) -> return Val("drop action references a missing place")
        if drop.span.start > drop.span.end -> return Val("drop action span is inverted")
        place :: mir_pass_find_place(function.places, drop.place) ?? return Val("drop action place is missing")
        if mir_pass_drop_forbidden_type(place.ty) -> return Val("drop action targets a scalar place")
        if drop.edge == {
            .Failure(target) | .Unwind(target) -> {
                if !mir_pass_block_target_exists(function.blocks, target) -> return Val("drop failure edge targets a missing block")
            }
            .Normal | .Return -> {}
        }
    }
    None
}

struct MirPassMoveEvent {
    pub value: MirValueId
    pub block: MirBlockId
    pub index: Int
    pub span: Span
}

fn mir_pass_call_arg_consumes(arg: MirCallArg) -> Bool {
    if arg.implicit_clone || arg.shared_auto_clone -> return false
    arg.access == .Move || arg.owned_last_use
}

fn mir_pass_consumed_values(operation: MirOperation) -> [MirValueId] {
    values := [MirValueId]{}
    if operation == {
        .Move(value) -> values.push(value)
        .Drop(value, kind) -> {
            if kind != .NoDrop -> values.push(value)
        }
        .Closure(_, captures, _) -> {
            loop capture in captures {
                if capture == {
                    .Value(value) -> values.push(value)
                    else -> {}
                }
            }
        }
        .Call(_, args, _)
        | .IndirectCall(_, args, _)
        | .CoreCall(_, _, args, _, _, _) -> {
            loop arg in args { if mir_pass_call_arg_consumes(arg) -> values.push(arg.value) }
        }
        .Semantic(semantic) -> {
            if semantic == {
                .StaticPreludeCall(_, args, _, _)
                | .HardwareCall(_, _, _, args)
                | .ClosureMethod(_, args, _)
                | .HostCall(_, args) -> {
                    loop arg in args { if mir_pass_call_arg_consumes(arg) -> values.push(arg.value) }
                }
                else -> {}
            }
        }
        else -> {}
    }
    values
}

fn mir_pass_event_dominates(event: MirPassMoveEvent, block: MirBlockId, index: Int, dominators: [MirPassDominatorRow]) -> Bool {
    if event.block == block -> return event.index < index
    mir_pass_dominates(dominators, event.block, block)
}

fn mir_pass_validate_moves(
    function: MirFunction,
    program: MirProgram,
    definitions: [MirPassDefinition],
) -> ?String {
    reachable := mir_pass_reachable(function)
    dominators := mir_pass_dominators(function)
    consumed := [MirPassMoveEvent]{}
    moved_places := [MirPlaceId]{}
    loop block in &function.blocks {
        if mir_pass_block_id_seen(reachable, block.id) {
            index := 0
            loop instruction in &block.instructions {
                loop value in mir_operation_value_uses(instruction.operation) {
                    loop event in &consumed {
                        if event.value == value && mir_pass_event_dominates(event, block.id, index, dominators) -> return Val("MIR value is used after it was moved or dropped")
                    }
                }
                loop place_id in mir_pass_operation_place_refs(instruction.operation) {
                    place_option := mir_pass_find_place(function.places, place_id)
                    if place_option != None {
                        place :: place_option ?? MirPlace{id: place_id, span: Span{start: 0, end: 0}, ty: MirType{kind: .Int, identity: None, layout: mir_type_layout(.Int)}, base: .Static(""), projections: [MirProjection]{}, access: .Read, persist_key: None}
                        if place.base == {
                            .Static(_) -> {
                                if mir_pass_operation_mutably_borrows_place(instruction.operation, place_id) -> return Val("mutable borrow of static place cannot escape its storage")
                                if instruction.operation == {
                                    .WritePlace(_, _) | .ReplacePlace(_, _) -> {
                                        if place.projections.len() != 0 -> return Val("static write place must target the whole static root")
                                    }
                                    else -> {}
                                }
                            }
                            else -> {}
                        }
                        if instruction.operation == {
                            .AddressOf(_, access) -> {
                                if access == .Write && place.access == .Read -> return Val("mutable borrow uses a read-only place")
                            }
                            else -> {}
                        }
                        if instruction.operation == {
                            .MovePlace(_) -> {
                                if place.access != .Move -> return Val("MovePlace uses a non-move place")
                                if mir_pass_place_id_seen(moved_places, place_id) -> return Val("place is moved more than once")
                                moved_places.push(place_id)
                                if place.base == {
                                    .Static(_) -> {
                                        if place.projections.len() != 0 -> return Val("static move place has a projection")
                                    }
                                    else -> {}
                                }
                            }
                            else -> {}
                        }
                    }
                }
                if instruction.operation == {
                    .Call(_, args, _)
                    | .IndirectCall(_, args, _)
                    | .CoreCall(_, _, args, _, _, _) -> {
                        loop arg in args {
                            if arg.place != None {
                                place_id :: arg.place ?? MirPlaceId{value: 0}
                                place_option := mir_pass_find_place(function.places, place_id)
                                if place_option != None {
                                    place :: place_option ?? MirPlace{id: place_id, span: Span{start: 0, end: 0}, ty: MirType{kind: .Int, identity: None, layout: mir_type_layout(.Int)}, base: .Static(""), projections: [MirProjection]{}, access: .Read, persist_key: None}
                                    if arg.access == .Write && place.access == .Read -> return Val("mutable call borrow uses a read-only place")
                                }
                            }
                        }
                    }
                    .Semantic(semantic) -> {
                        if semantic == {
                            .StaticPreludeCall(_, args, _, _)
                            | .HardwareCall(_, _, _, args)
                            | .ClosureMethod(_, args, _)
                            | .HostCall(_, args) -> {
                                loop arg in args {
                                    if arg.place != None {
                                        place_id :: arg.place ?? MirPlaceId{value: 0}
                                        place_option := mir_pass_find_place(function.places, place_id)
                                        if place_option != None {
                                            place :: place_option ?? MirPlace{id: place_id, span: Span{start: 0, end: 0}, ty: MirType{kind: .Int, identity: None, layout: mir_type_layout(.Int)}, base: .Static(""), projections: [MirProjection]{}, access: .Read, persist_key: None}
                                            if arg.access == .Write && place.access == .Read -> return Val("mutable semantic call borrow uses a read-only place")
                                        }
                                    }
                                }
                            }
                            else -> {}
                        }
                    }
                    else -> {}
                }
                loop value in mir_pass_consumed_values(instruction.operation) {
                    ownership :: mir_pass_value_ownership(function, value) ?? return Val("consumed value has no ownership metadata")
                    if ownership.mode == .Copy || ownership.mode == .ReadBorrow || ownership.mode == .WriteBorrow -> return Val("copy or borrowed value is consumed")
                    loop event in &consumed { if event.value == value -> return Val("value is consumed more than once") }
                    consumed.push(MirPassMoveEvent{value: value, block: block.id, index: index, span: instruction.span})
                }
                index += 1
            }
        }
    }
    None
}

fn mir_pass_validate_host_callbacks(function: MirFunction, rows: [MirPreludeCall]) -> ?String {
    loop block in &function.blocks {
        index := 0
        loop instruction in &block.instructions {
            if mir_pass_is_host_borrow_callback(instruction.operation) {
                result :: instruction.result ?? return Val("HostBorrowCallback has no representation result")
                type :: instruction.ty ?? return Val("HostBorrowCallback has no representation type")
                if !mir_pass_type_is_callable(type) -> return Val("HostBorrowCallback result is not callable")
                next_index := index + 1
                if next_index >= block.instructions.len() -> return Val("HostBorrowCallback result has no direct consumer")
                next := block.instructions[next_index]
                count := 0
                loop value in mir_operation_value_uses(next.operation) { if value == result -> count += 1 }
                if count != 1 -> return Val("HostBorrowCallback result is not consumed exactly once")
                if !mir_pass_host_callback_consumer(next.operation, rows) -> return Val("HostBorrowCallback result escaped its direct call consumer")
                loop later_block in &function.blocks {
                    loop later_instruction in &later_block.instructions {
                        if !(later_block.id == block.id && later_instruction.id == next.id) {
                        loop value in mir_operation_value_uses(later_instruction.operation) {
                            if value == result -> return Val("HostBorrowCallback result escaped its direct call consumer")
                        }
                        }
                    }
                    loop value in mir_terminator_value_uses(later_block.terminator) {
                        if value == result -> return Val("HostBorrowCallback result escaped through a terminator")
                    }
                }
            }
            index += 1
        }
    }
    None
}

fn mir_pass_is_host_borrow_callback(operation: MirOperation) -> Bool {
    if operation == {
        .Semantic(semantic) -> {
            if semantic == {
                .HostBorrowCallback(_, _) -> return true
                else -> return false
            }
        }
        else -> return false
    }
}

fn mir_pass_host_callback_consumer(operation: MirOperation, rows: [MirPreludeCall]) -> Bool {
    call := if operation == {
        .Call(callee, _, _) -> {
            if callee == {
                .Prelude(id) -> Val(id)
                else -> None
            }
        }
        .CoreCall(_, route, _, _, _, _) -> Val(route)
        .Semantic(semantic) -> {
            if semantic == {
                .StaticPreludeCall(call, _, _, _)
                | .ClosureMethod(_, _, call)
                | .HostCall(call, _) -> Val(call)
                else -> None
            }
        }
        else -> None
    }
    if call == None -> return false
    id :: call ?? return false
    route :: mir_pass_prelude(rows, id) ?? return false
    route.family == .StaticPrelude || route.family == .ClosureMethod || route.family == .Host
}
fn mir_pass_operation_has_effect(operation: MirOperation, function: MirFunction, rows: [MirPreludeCall]) -> Bool {
    if operation == {
        .Semantic(semantic) -> {
            calls := mir_semantic_op_prelude_calls(semantic)
            if calls.len() == 0 -> return true
            loop call in calls { if !mir_pass_prelude_is_pure(rows, call) -> return true }
            return false
        }
        .Call(callee, _, _) -> {
            if callee == {
                .Prelude(call) -> return !mir_pass_prelude_is_pure(rows, call)
                else -> return true
            }
        }
        .CoreCall(_, route, _, _, fallibility, _) -> return !mir_pass_prelude_is_pure(rows, route) || fallibility != .Infallible
        .Binary(_, dispatch, _, _, _) -> {
            if dispatch == {
                .Prelude(call, _) -> return !mir_pass_prelude_is_pure(rows, call)
                else -> return false
            }
        }
        .Convert(_, _, _, conversion) -> {
            if conversion == {
                .Prelude(call, _, fallibility) -> return !mir_pass_prelude_is_pure(rows, call) || fallibility != .Infallible
                else -> return false
            }
        }
        .Index(call, _, _, _, _, _, _)
        | .Slice(call, _, _, _, _, _)
        | .Todo(call, _, _)
        | .LoopRangeInit(call, _, _, _, _)
        | .LoopRangeHasNext(call, _)
        | .LoopRangeValue(call, _)
        | .LoopRangeAdvance(call, _)
        | .LoopIterInit(call, _, _, _, _)
        | .LoopIterHasNext(call, _)
        | .LoopIterValue(call, _)
        | .LoopIterAdvance(call, _) -> return !mir_pass_prelude_is_pure(rows, call)
        .MovePlace(_) | .WritePlace(_, _) | .ReplacePlace(_, _) | .InitializeUninit(_) | .Drop(_, _) -> return true
        .AddressOf(_, access) -> return access == .Write
        .RawAddressOf(_) -> return true
        .IndirectCall(_, _, _) -> return true
        .Closure(_, _, _) -> return true
        .ReadPlace(place) -> {
            row :: mir_pass_find_place(function.places, place) ?? return true
            loop projection in row.projections {
                if projection == {
                    .Index(_, call, _, write_call, _, _, _) -> {
                        if !mir_pass_prelude_is_pure(rows, call) -> return true
                        if write_call != None {
                            setter :: write_call ?? return true
                            if !mir_pass_prelude_is_pure(rows, setter) -> return true
                        }
                    }
                    else -> {}
                }
            }
            return false
        }
        .WritePlace(place, _)
        | .ReplacePlace(place, _) -> {
            row :: mir_pass_find_place(function.places, place) ?? return true
            if row.base == {
                .Static(_) | .Parameter(_) | .Capture(_) -> return true
                else -> {}
            }
            return true
        }
        else -> return false
    }
}
fn mir_pass_canonicalize_program_order(program: &MirProgram) {
    modules_window :: &program.modules
    mir_pass_sort_modules(&modules_window)
    imports_window :: &program.imports
    mir_pass_sort_imports(&imports_window)
    functions_window :: &program.functions
    mir_pass_sort_functions(&functions_window)
    types_window :: &program.types
    mir_pass_sort_type_defs(&types_window)
    traits_window :: &program.traits
    mir_pass_sort_traits(&traits_window)
    impls_window :: &program.impls
    mir_pass_sort_impls(&impls_window)
    constants_window :: &program.constants
    mir_pass_sort_constants(&constants_window)
    type_instances_window :: &program.type_instances
    mir_pass_sort_type_instances(&type_instances_window)
    fields_window :: &program.fields
    mir_pass_sort_fields(&fields_window)
    source_files_window :: &program.source_files
    mir_pass_sort_source_files(&source_files_window)
    core_calls_window :: &program.core_calls
    mir_pass_sort_core_calls(&core_calls_window)
    prelude_calls_window :: &program.prelude_calls
    mir_pass_sort_prelude_calls(&prelude_calls_window)
    foreign_window :: &program.foreign
    mir_pass_sort_foreign(&foreign_window)
    links_window :: &program.links
    mir_pass_sort_links(&links_window)
    callbacks_window :: &program.callbacks
    mir_pass_sort_callbacks(&callbacks_window)
    handles_window :: &program.handles
    mir_pass_sort_handles(&handles_window)
    jobs_window :: &program.jobs
    mir_pass_sort_jobs(&jobs_window)
    tests_window :: &program.tests
    mir_pass_sort_tests(&tests_window)
    harnesses_window :: &program.harnesses
    mir_pass_sort_harnesses(&harnesses_window)
    artifacts_window :: &program.artifacts
    mir_pass_sort_artifacts(&artifacts_window)
    unreachable_window :: &program.unreachable
    mir_pass_sort_unreachable(&unreachable_window)
    loop import in &imports_window {
        if import.kind == {
            .Unqualified(_, items) -> {
                items_window :: &items
                mir_pass_sort_import_items(&items_window)
            }
            else -> {}
        }
    }
    loop trait_row in &traits_window {
        methods_window :: &trait_row.methods
        mir_pass_sort_trait_methods(&methods_window)
    }
    loop impl_row in &impls_window {
        associated_types_window :: &impl_row.associated_types
        mir_pass_sort_associated_types(&associated_types_window)
        methods_window :: &impl_row.methods
        mir_pass_sort_function_ids(&methods_window)
    }
    loop link in &links_window {
        link_closure_window :: &link.link_closure
        mir_pass_sort_link_ids(&link_closure_window)
    }
    loop function in &functions_window {
        blocks_window :: &function.blocks
        mir_pass_sort_blocks(&blocks_window)
        captures_window :: &function.capture_params
        mir_pass_sort_captures(&captures_window)
        values_window :: &function.values
        mir_pass_sort_values(&values_window)
        locals_window :: &function.locals
        mir_pass_sort_locals(&locals_window)
        places_window :: &function.places
        mir_pass_sort_places(&places_window)
        scopes_window :: &function.scopes
        mir_pass_sort_scopes(&scopes_window)
        drops_window :: &function.drops
        mir_pass_sort_drops(&drops_window)
    }
}

fn mir_pass_sort_modules(rows: &[MirModule]) {
    index := 1
    loop index < rows.len() {
        current := rows[index]
        cursor := index
        loop cursor > 0 && mir_pass_module_before(current, rows[cursor - 1]) {
            rows[cursor] = rows[cursor - 1]
            cursor -= 1
        }
        rows[cursor] = current
        index += 1
    }
}

fn mir_pass_module_before(left: MirModule, right: MirModule) -> Bool {
    if left.id.value != right.id.value -> return left.id.value < right.id.value
    left.key < right.key
}

fn mir_pass_sort_imports(rows: &[MirImport]) {
    index := 1
    loop index < rows.len() {
        current := rows[index]
        cursor := index
        loop cursor > 0 && mir_pass_import_before(current, rows[cursor - 1]) {
            rows[cursor] = rows[cursor - 1]
            cursor -= 1
        }
        rows[cursor] = current
        index += 1
    }
}

fn mir_pass_import_before(left: MirImport, right: MirImport) -> Bool {
