// The machine running the build enters each package's check key: a request
// names the host's OS and architecture (`#build.host.*`), so a value prepared
// on one host is never reused on another.
use {
    jet_driver.[
        jet_driver_build_source_catalog,
        jet_driver_package_target_facts,
        JetDriverAuthorizedSourceFile,
        JetDriverAuthorizedSourceRoot,
        JetDriverAuthorizedSourceSnapshot,
        JetDriverCoreSource,
    ]
    jet_cli.[
        jet_cli_driver_request,
        jet_cli_identity_key,
    ]
    cli_files: core.files
    cli_sys: core.sys
}

#Test("host_facts_enter_the_package_key") {
    scratch: cli_files.temp_dir("jet-host-facts") ?? panic("host facts scratch")
    path: scratch.path
    stat: cli_files.stat(path) ?? panic("host facts root identity")
    // Two keys of one directory, one for the root and one for the entry.
    entry: JetDriverAuthorizedSourceFile{path: "{path}/main.jet", relative_path: "main.jet", identity: "entry", source: "run: fn() {{ print(#build.host.os) }}\n"}
    root: JetDriverAuthorizedSourceRoot{canonical_path: path, identity: jet_cli_identity_key("directory", stat), allow_hardlinks: false, files: [JetDriverAuthorizedSourceFile]{entry}, foreign_cache_files: [JetDriverAuthorizedSourceFile]{}}
    snapshot: JetDriverAuthorizedSourceSnapshot{roots: [JetDriverAuthorizedSourceRoot]{root}, entry_root_identity: jet_cli_identity_key("directory", stat), entry_path: "{path}/main.jet"}
    ^request: jet_cli_driver_request(snapshot, [JetDriverCoreSource]{}, None, .Program)
    assert(request.host_facts.host_arch == Val(cli_sys.arch()), "the request names the host's architecture")
    assert(request.host_facts.active_os == Val(cli_sys.name()), "the request names the host's OS")
    catalog: jet_driver_build_source_catalog(request)
    facts: jet_driver_package_target_facts(request, catalog.packages[0])
    request.host_facts.host_arch = Val("other-arch")
    assert(jet_driver_package_target_facts(request, catalog.packages[0]) != facts, "another host architecture is another package key")
    request.host_facts.host_arch = Val(cli_sys.arch())
    request.host_facts.active_os = Val("other-os")
    assert(jet_driver_package_target_facts(request, catalog.packages[0]) != facts, "another host OS is another package key")
}
