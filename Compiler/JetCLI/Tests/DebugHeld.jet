// A session's held check of the program answers only while the sources it
// read are the ones the program's image records it was built from
// (`.debug_jetsource`, DebugCompile.jet jet_cli_debug_eval_image_same), by
// each file's digest; a session whose image records none opens no held
// check of the program, so its evaluations compile. Those compiles refuse
// an expression that reaches an item of a source that reads otherwise than
// the record (jet_cli_debug_eval_stale). The held check of the package's
// cut calls none of the image's functions, and opens at every session.
use {
    jet_cli.[JetCLIDebugEvalHeldCutOpen, JetCLIDebugEvalHeldOpen, JetCLIDebugEvalHeldShared, JetCLIDebugEvalHeldStamp, jet_cli_debug_eval_digests, jet_cli_debug_eval_held_claim, jet_cli_debug_eval_held_cut_claim, jet_cli_debug_eval_held_cut_done, jet_cli_debug_eval_held_done, jet_cli_debug_eval_held_slot, jet_cli_debug_eval_image_same, jet_cli_debug_eval_stale]
    jet_debug.[NativeEvalBinder]
    jet_driver.[JetDriverAuthorizedSourceFile, JetDriverAuthorizedSourceRoot, JetDriverAuthorizedSourceSnapshot]
}

// The digests the held check `held` last read.
held_test_read: fn(held: JetCLIDebugEvalHeldShared) -> [String:[U8]] Never! {
    permit: held.slot.guard_edit()
    permit.value.read
}

// A snapshot of the package at `/p` whose entry is `prog.jet`, beside
// `util.jet` with the text `util`.
held_test_snapshot: fn(util: String) -> JetDriverAuthorizedSourceSnapshot Never! {
    prog: "run: fn() {{\n}}\n\nscaled: fn(x: Int) -> Int {{\n    helper(x)\n}}\n"
    files: [JetDriverAuthorizedSourceFile]{
        JetDriverAuthorizedSourceFile{path: "/p/prog.jet", relative_path: "prog.jet", identity: "", source: prog},
        JetDriverAuthorizedSourceFile{path: "/p/util.jet", relative_path: "util.jet", identity: "", source: util},
    }
    root: JetDriverAuthorizedSourceRoot{canonical_path: "/p", identity: "p", allow_hardlinks: false, files: files, foreign_cache_files: [JetDriverAuthorizedSourceFile]{}}
    JetDriverAuthorizedSourceSnapshot{roots: [JetDriverAuthorizedSourceRoot]{root}, entry_root_identity: "p", entry_path: "/p/prog.jet"}
}

#Test("a session whose image records no sources opens no held check of the program") {
    held: jet_cli_debug_eval_held_slot()
    assert(!jet_cli_debug_eval_held_claim(held))
}

#Test("every session opens the held check of the package's cut, once at a time") {
    held: jet_cli_debug_eval_held_slot()
    assert(jet_cli_debug_eval_held_cut_claim(held))
    assert(!jet_cli_debug_eval_held_cut_claim(held))
    unopened: JetCLIDebugEvalHeldCutOpen{open: JetCLIDebugEvalHeldOpen{held: None, missed: None}, names: [String:Int]{}}
    jet_cli_debug_eval_held_cut_done(held, unopened)
    assert(jet_cli_debug_eval_held_cut_claim(held))
}

#Test("the held check answers from the image's recorded sources only, file by file") {
    running: ["prog.jet": [U8]{1, 2}]
    assert(jet_cli_debug_eval_image_same(running, ["prog.jet": [U8]{1, 2}]))
    assert(!jet_cli_debug_eval_image_same(running, ["prog.jet": [U8]{1, 3}]))
    assert(!jet_cli_debug_eval_image_same(running, ["prog.jet": [U8]{1, 2}, "more.jet": [U8]{4}]))
    assert(!jet_cli_debug_eval_image_same([String:[U8]]{}, [String:[U8]]{}))
}

#Test("an image that records its sources opens the held check of the program, which keeps what it read") {
    held: jet_cli_debug_eval_held_slot()
    assert(jet_cli_debug_eval_held_claim(held, program: true))
    assert(!jet_cli_debug_eval_held_claim(held))
    snapshot: held_test_snapshot("helper: fn(x: Int) -> Int {{\n    x * 2\n}}\n")
    read: jet_cli_debug_eval_digests(snapshot)
    assert(read.has_key("prog.jet") && read.has_key("util.jet"))
    opened: JetCLIDebugEvalHeldOpen{held: None, missed: Val(JetCLIDebugEvalHeldStamp{sources: ["/p/prog.jet": ""], keys: [String:String]{}}), read: read}
    jet_cli_debug_eval_held_done(held, opened)
    assert(jet_cli_debug_eval_image_same(jet_cli_debug_eval_digests(snapshot), held_test_read(held)))
}

#Test("a held check whose open read nothing opens no other until a start says the image records its sources") {
    held: jet_cli_debug_eval_held_slot()
    assert(jet_cli_debug_eval_held_claim(held, program: true))
    unopened: JetCLIDebugEvalHeldOpen{held: None, missed: None}
    jet_cli_debug_eval_held_done(held, unopened)
    assert(!jet_cli_debug_eval_held_claim(held))
    assert(jet_cli_debug_eval_held_claim(held, program: true))
}

#Test("a compile refuses an expression that reaches an item of a source edited since the build") {
    built: held_test_snapshot("helper: fn(x: Int) -> Int {{\n    x * 2\n}}\n\nother: fn() -> Int {{\n    1\n}}\n")
    running: jet_cli_debug_eval_digests(built)
    k: [NativeEvalBinder]?{Val([NativeEvalBinder]{NativeEvalBinder{name: "k", type_name: "Int", live: true}})}
    assert(jet_cli_debug_eval_stale(built, running, "scaled(k)", k) == None)
    edited: held_test_snapshot("helper: fn(x: Int) -> Int {{\n    x * 3\n}}\n\nother: fn() -> Int {{\n    1\n}}\n")
    refused: jet_cli_debug_eval_stale(edited, running, "scaled(k)", k) ?? panic("an edited callee must be refused")
    assert(refused.message == "`helper`'s source `util.jet` changed since the program was built; rebuild the program, or `fix` it first")
    // `other` is in the edited source too: the proof is by source.
    assert(jet_cli_debug_eval_stale(edited, running, "other()", k) != None)
    assert(jet_cli_debug_eval_stale(edited, running, "k + 1", k) == None)
    unrecorded: jet_cli_debug_eval_stale(built, [String:[U8]]{}, "scaled(k)", k) ?? panic("an image with no record proves nothing")
    assert(unrecorded.message == "`scaled` can't be checked against the code the program runs: its image records no sources; rebuild the program")
    assert(jet_cli_debug_eval_stale(built, [String:[U8]]{}, "k + 1", k) == None)
}
