// Pure provider witnesses. Transport permission/pid/race checks need the composed
// CLI + Core native FS provider; these tests make no hosted parity claim.
use {
    jet_backend.[X64DebugEncoding, X64ImageFunction, X64Jetline, X64JetlineFunction]
    jet_cli.[
        JET_CLI_PERF_OBJECT_SOCKET,
        JetCLIPerfAttachCPU,
        JetCLIPerfExperiment,
        JetCLIPerfHeap,
        JetCLIPerfHeapBlock,
        JetCLIPerfHeapFrame,
        JetCLIPerfHeapObject,
        JetCLIPerfHeapPlace,
        JetCLIPerfHeapRef,
        JetCLIPerfHeapRetention,
        JetCLIPerfHeapRoot,
        JetCLIPerfHeapSite,
        JetCLIPerfHeapSnapshot,
        JetCLIPerfIO,
        JetCLIPerfInlines,
        JetCLIPerfLineHelper,
        JetCLIPerfLineTotal,
        JetCLIPerfLineTotals,
        JetCLIPerfObservation,
        JetCLIPerfPlotTotal,
        JetCLIPerfRetained,
        JetCLIPerfSpawn,
        JetCLIPerfTimed,
        JetCLIPerfWait,
        JetCLIPerfWake,
        JetCLIPerfZoneSampled,
        JetCLIPerfZoneTotal,
        jet_cli_perf_attach_closed,
        jet_cli_perf_attach_keep_window,
        jet_cli_perf_browser_decode,
        jet_cli_perf_causal_section,
        jet_cli_perf_capture_bytes,
        jet_cli_perf_capture_source,
        jet_cli_perf_file_pid,
        jet_cli_perf_heap_retain,
        jet_cli_perf_heap_retention_lines,
        jet_cli_perf_heap_types,
        jet_cli_perf_helper_name,
        jet_cli_perf_helpers_section,
        jet_cli_perf_live_from,
        jet_cli_perf_line_costs_none,
        jet_cli_perf_line_table,
        jet_cli_perf_log_spans_read,
        jet_cli_perf_observed,
        jet_cli_perf_pc_json,
        jet_cli_perf_pc_words,
        jet_cli_perf_profile_fold,
        jet_cli_perf_profile_summary,
        jet_cli_perf_records_section,
        jet_cli_perf_sampler_reason,
        jet_cli_perf_samples_count,
        jet_cli_perf_samples_profile,
        jet_cli_perf_source,
        jet_cli_perf_source_position,
        jet_cli_perf_source_profile,
        jet_cli_perf_tasks_section,
        jet_cli_perf_timed_first,
        jet_cli_perf_waits_read,
        jet_cli_perf_zones_section,
    ]
    jet_debug.[
        NATIVE_TAG_POINTER,
        NATIVE_TAG_STRUCT,
        NATIVE_TAG_TYPEDEF,
        NativeAbstract,
        NativeEnumerator,
        NativeFunction,
        NativeImage,
        NativeInlined,
        NativeMember,
        NativeType,
        NativeVariable,
        NativeVariableRole,
        NativeVariants,
    ]
    jet_foundation.[
        JetLiveChannel,
        JetLiveEvent,
        JetLiveGameRecord,
        JetLiveRuntime,
        JetLiveSnapshot,
        JetLiveTask,
        JetLiveValue,
        JetSymbolRef,
        TraceHardware,
        TraceProfileRow,
        TraceProfileSource,
        TraceStackFrame,
        TraceToolchain,
        canonical_json_bytes,
        sha256_hex,
        verify_jettrace,
    ]
    perf_hex: core.encoding.hex
    perf_test_files: core.files
    perf_test_process: core.process
    perf_test_sys: core.sys
}

// A decoded, process-bound live snapshot (jet_foundation's LiveSnapshot.jet
// codec is witnessed by Tests/LiveInspect.jet).
jet_cli_perf_test_snapshot: fn(task_id: Int) -> JetLiveSnapshot Never! {
    resources := [String:Int]{}
    resources["workers"] = 1
    resources["running"] = 0
    resources["queued"] = 0
    resources["canceled"] = 0
    resources["arenas"] = 1
    resources["arena_allocations"] = 2
    resources["arena_bytes"] = 64
    JetLiveSnapshot{
        protocol: "jet.live.v2",
        session_id: "session",
        source_id: "source",
        build_id: "build",
        revision: "revision",
        world_id: "world",
        pid: 12,
        start_id: "123",
        captured_ms: 100,
        values: [JetLiveValue]{JetLiveValue{value_id: "static:app.secret", type_identity: "Int", disposition: "kept", reason: "", rendered_value: Val("7")}},
        tasks: [JetLiveTask]{JetLiveTask{id: task_id, parent: 0, label: "run", spawn_site: 0, state: "blocked", wait: "tcp receive", deadline_ms: None, canceled: false, open_spans: 0, arena_allocations: 0}},
        channels: [JetLiveChannel]{JetLiveChannel{id: 2, depth: 0, capacity: Val(1), send_waiters: 0, recv_waiters: 1, closed: false}},
        effects: [String:Int]{},
        resources: resources,
        runtime: JetLiveRuntime{elapsed_ns: 50, cpu_ns: Val(25), exit: false},
        event_records: [JetLiveEvent]{},
        game_records: [JetLiveGameRecord]{},
        events: Val(""),
        boot_ns: U64{0},
        start_ticks: U64{0},
        clock_hz: 100,
    }
}

#Test("perf live view retains observations, not live value payloads") {
    live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(1))
    assert_eq(live.pid, 12)
    assert_eq(live.start_id, "123")
    assert_eq(live.tasks.len(), 1)
    assert_eq(live.tasks[0].wait, "tcp receive")
    assert_eq(live.channels[0].capacity, Val(U64{1}))
    assert_eq(live.arena_bytes, U64{64})
    assert_eq(live.runtime.elapsed_ns, U64{50})
    assert_eq(live.runtime.cpu_ns, Val(U64{25}))
}

#Test("perf source spans use one-based Unicode scalar columns") {
    at: jet_cli_perf_source_position("é\nλx", 5) ?? panic(err.message)
    assert_eq(at.line, U64{2})
    assert_eq(at.column, U64{2})
    if jet_cli_perf_source_position("é", 1) == {
        .Err(_) -> {}
        .Ok(_) -> panic("accepted mid-scalar source span")
    }
}

#Test("perf profile counts snapshots, never guessed invocations") {
    source: jet_cli_perf_source("app.jet", "run: fn() -> Int {{ 1 }}")
    profile: jet_cli_perf_source_profile(source, U64{2}, U64{1}, false) ?? panic(err.message)
    assert_eq(profile.status, "captured")
    assert_eq(profile.coverage, "partial")
    assert_eq(profile.rows.len(), 2)
    assert_eq(profile.rows[0].execution_count, None)
    assert_eq(profile.rows[0].sample_count, U64{2})
    assert_eq(profile.overhead_ns, None)
    bounded: jet_cli_perf_source_profile(source, U64{5000}, U64{4500}, false) ?? panic(err.message)
    assert_eq(bounded.status, "truncated")
    assert_eq(bounded.rows[0].sample_count, U64{4096})
    assert_eq(bounded.rows[0].sample_weight, U64{4096})
    assert_eq(bounded.rows[1].sample_count, U64{4096})
    assert_eq(bounded.rows[1].sample_weight, U64{4096})
}

#Test("perf capture keeps observed spans, locks and allocations causal, and no I/O from a wait") {
    live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(17))
    observations: [JetCLIPerfObservation]{JetCLIPerfObservation{at_ns: U64{10}, live: live}, JetCLIPerfObservation{at_ns: U64{20}, live: live}}
    capture: jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", Val(U64{30})) ?? panic(err.message)
    // A task blocked on `tcp receive` is a wait, not a transfer: the I/O rows
    // are the runtime's records of the bytes a read or write moved, and these
    // observations come with none.
    assert_eq(capture.io.len(), 0)
    assert_eq(capture.tasks[0].wait, "tcp receive")
    assert_eq(capture.locks.len(), 1)
    assert_eq(capture.allocations[0].bytes, U64{64})
    assert_eq(capture.tasks[0].id, U64{1})
    assert_eq(capture.spans[0].start_ns, Val(U64{10}))
    assert_eq(capture.spans[0].end_ns, Val(U64{20}))
    // A run's wall is the session's, on the observations' clock, so every span
    // and native observation ends inside it; the runtime's own elapsed time is
    // the run window.
    assert_eq(capture.samples[0].domain, "wall")
    assert_eq(capture.samples[0].duration_ns, U64{30})
    assert_eq(capture.native[0].observed_at_ns, U64{20})
    assert_eq(capture.profile.window_wall_ns, Val(U64{50}))
    attached: jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    assert_eq(attached.samples[0].duration_ns, U64{50})
    toolchain: TraceToolchain{jet_version: "test", compiler_build_id: "test", stdlib_id: "test", runner_id: "test"}
    hardware: TraceHardware{cpu_arch: "x86_64", logical_cpus: U64{1}, os: "linux", target: "x86_64-unknown-linux-gnu"}
    bytes: jet_cli_perf_capture_bytes(capture, "run", [String]{"app.jet"}, toolchain, hardware) ?? panic(err.message)
    _: verify_jettrace(bytes) ?? panic(err.message)
}

#Test("an attach's window counts each thread's CPU in it, names the threads that exited, and its header names a tick resolution") {
    opened := [Int:U64]{}
    opened[1] = U64{1000}
    opened[2] = U64{500}
    opened[3] = U64{700}
    // Thread 1 ran 600 ns more, thread 2 slept, thread 3 exited and thread 4
    // started in the window.
    shut := [Int:U64]{}
    shut[1] = U64{1600}
    shut[2] = U64{500}
    shut[4] = U64{300}
    first: JetCLIPerfAttachCPU{ns: U64{2200}, resolution_ns: U64{1}, threads: opened}
    last: JetCLIPerfAttachCPU{ns: U64{2400}, resolution_ns: U64{1}, threads: shut}
    precise: jet_cli_perf_attach_closed(U64{5000}, Val(first), Val(last))
    assert_eq(precise.window.elapsed_ns, U64{5000})
    assert_eq(precise.window.cpu_ns, Val(U64{900}))
    assert_eq(precise.resolution_ns, Val(U64{1}))
    assert_eq(precise.exited, 1)
    early: JetCLIPerfAttachCPU{ns: U64{20000000}, resolution_ns: U64{10000000}, threads: [Int:U64]{}}
    late: JetCLIPerfAttachCPU{ns: U64{50000000}, resolution_ns: U64{10000000}, threads: [Int:U64]{}}
    ticked: jet_cli_perf_attach_closed(U64{5000}, Val(early), Val(late))
    assert_eq(ticked.window.cpu_ns, Val(U64{30000000}))
    assert_eq(ticked.resolution_ns, Val(U64{10000000}))
    // Ends counted differently, or an end with no CPU, give the window none.
    assert_eq(jet_cli_perf_attach_closed(U64{5000}, Val(first), Val(late)).window.cpu_ns, None)
    assert_eq(jet_cli_perf_attach_closed(U64{5000}, None, Val(late)).window.cpu_ns, None)
    live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(17))
    observations: [JetCLIPerfObservation]{JetCLIPerfObservation{at_ns: U64{0}, live: live}}
    toolchain: TraceToolchain{jet_version: "test", compiler_build_id: "test", stdlib_id: "test", runner_id: "test"}
    hardware: TraceHardware{cpu_arch: "x86_64", logical_cpus: U64{1}, os: "linux", target: "x86_64-unknown-linux-gnu"}
    exact := jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    jet_cli_perf_attach_keep_window(exact, 7, precise, [String]{"its live snapshot", "its flight ring"})
    assert(exact.profile.window_reason.contains("from its first read of the program to its last (its live snapshot, its flight ring)"))
    assert(exact.profile.window_reason.contains("less that of the threads that exited in it (1)"))
    exact_trace: verify_jettrace(jet_cli_perf_capture_bytes(exact, "attach", [String]{"attach", "7"}, toolchain, hardware) ?? panic(err.message)) ?? panic(err.message)
    assert((jet_cli_perf_profile_summary(exact_trace) ?? "").ends_with(" window=live run_wall=5000ns run_cpu=900ns"))
    coarse := jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    jet_cli_perf_attach_keep_window(coarse, 7, ticked, [String]{"its live snapshot"})
    coarse_trace: verify_jettrace(jet_cli_perf_capture_bytes(coarse, "attach", [String]{"attach", "7"}, toolchain, hardware) ?? panic(err.message)) ?? panic(err.message)
    assert((jet_cli_perf_profile_summary(coarse_trace) ?? "").ends_with(" window=live run_wall=5000ns run_cpu=30000000ns run_cpu_resolution=10ms"))
}

#Test("perf observations of a run sit on its own clock, from its start") {
    early: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(17))
    late := jet_cli_perf_live_from(jet_cli_perf_test_snapshot(17))
    late.runtime.elapsed_ns = U64{900}
    observations: [JetCLIPerfObservation]{jet_cli_perf_observed(early), jet_cli_perf_observed(late)}
    capture: jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", Val(U64{5000})) ?? panic(err.message)
    assert_eq(capture.spans[0].kind, "task_observed")
    assert_eq(capture.spans[0].start_ns, Val(U64{50}))
    assert_eq(capture.spans[0].end_ns, Val(U64{900}))
    assert_eq(capture.native[0].observed_at_ns, U64{900})
}

#Test("perf capture without observations keeps the source and records no samples") {
    capture: jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", [JetCLIPerfObservation]{}, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    assert_eq(capture.source_maps.len(), 1)
    assert_eq(capture.profile.status, "no_samples")
    assert_eq(capture.profile.window_status, "unavailable")
    assert_eq(capture.tasks.len(), 0)
}

#Test("perf observations refuse mixed process revisions") {
    live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(1))
    other := live
    other.revision = "different"
    observations: [JetCLIPerfObservation]{JetCLIPerfObservation{at_ns: U64{10}, live: live}, JetCLIPerfObservation{at_ns: U64{20}, live: other}}
    if jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "test", None) == {
        .Err(_) -> {}
        .Ok(_) -> panic("accepted mixed observation revisions")
    }
}

#Test("perf browser decode uses compiler source carrier and refuses unknown symbols") {
    digest: sha256_hex("run: fn() -> Int {{ 1 }}")
    table: "source\t{perf_hex.encode("app.jet".bytes())}\t{digest}\nsymbol\t{perf_hex.encode("app.jet".bytes())}\t{perf_hex.encode("run".bytes())}\tfn\n"
    header: "{{\"schema\":\"jet.status/v1\",\"action\":\"browser.relay\",\"ok\":true,\"reports\":[],\"nonce\":\"n\",\"pid\":12,\"started\":\"123\",\"sources\":\"{perf_hex.encode(table.bytes())}\"}}"
    row: "{{\"schema\":\"jet.status/v1\",\"action\":\"browser.relay.row\",\"ok\":true,\"reports\":[],\"class\":\"wasm\",\"duration_ns\":4,\"start_ns\":5,\"symbol\":\"run\"}}"
    capture: jet_cli_perf_browser_decode("{header}\n{row}\n", 12, "123") ?? panic(err.message)
    assert_eq(capture.rows[0].symbol.path, "app.jet")
    assert_eq(capture.rows[0].duration_ns, U64{4})
    invalid: "{header}\n{row.replace("\"symbol\":\"run\"", "\"symbol\":\"missing\"")}\n"
    if jet_cli_perf_browser_decode(invalid, 12, "123") == {
        .Err(_) -> {}
        .Ok(_) -> panic("accepted un-attributed browser observation")
    }
}

// Little-endian 8-byte words, as the runtime's sample records are.
jet_cli_perf_test_words: fn(values: [Int]) -> [U8] Never! {
    bytes := [U8]{}
    loop value in values {
        loop shift in 0..<8 -> bytes.push(U8{(value >> (8 * shift)) & 255})
    }
    bytes
}

#Test("perf samples charge compiler helpers to the calling line and read what sampling cost") {
    // fib's code at 0x1000, its one row at its declaration's line 5; the
    // stop poll and a runtime function beside it in the symbol table.
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}, X64ImageFunction{start: 8192, size: 512, name: "jet_ir_stop_turn"}, X64ImageFunction{start: 12288, size: 16, name: "jet_rt_alloc"}}
    one: 1 << 48
    two: 2 << 48
    four: 4 << 48
    words: jet_cli_perf_test_words(
        [Int]{
            // In the stop poll fib called from 0x1040: fib's line.
            8208 | two,
            4160,
            // In the runtime: outside, by its symbol.
            12292 | one,
            // In fib with no stack.
            4112 | one,
            // The clock record: 4 ms of CPU sampled, 6 microseconds in the
            // handlers, 1 microsecond for each signal's delivery.
            (13 << 59) | four,
            4000000,
            6000,
            1000,
        },
    )
    sampled: jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.total, U64{3})
    assert_eq(sampled.outside, U64{1})
    assert_eq(sampled.helpers, U64{1})
    assert_eq(sampled.stackless, U64{1})
    assert_eq(sampled.signals, U64{3})
    assert_eq(sampled.lines[0].line, 5)
    assert_eq(sampled.lines[0].count, U64{2})
    assert_eq(sampled.lines[0].inclusive, U64{2})
    assert_eq(sampled.natives.len(), 1)
    assert_eq(sampled.functions[sampled.natives[0].function].name, "jet_rt_alloc")
    // The helper's sample is split out at fib's line, named in Jet's terms.
    assert_eq(sampled.lines[0].helpers.len(), 1)
    assert_eq(sampled.functions[sampled.lines[0].helpers[0].function].name, "jet_ir_stop_turn")
    assert_eq(sampled.lines[0].helpers[0].count, U64{1})
    helpers: jet_cli_perf_helpers_section("fib.jet", sampled.lines, sampled.functions, sampled.sources, sampled.source_at) ?? panic("fib's line holds a helper sample")
    assert_eq(helpers.type_name, "JetPerfHelpers")
    assert_eq(String.from_bytes(canonical_json_bytes(helpers.value)) ?? "", "{{\"helpers\":[{{\"function\":\"fib\",\"helper\":\"stop poll\",\"line\":5,\"path\":\"fib.jet\",\"samples\":1}}]}}\n")
    assert_eq(jet_cli_perf_helper_name("jet_ir_stop_poll"), "stop poll")
    assert_eq(jet_cli_perf_helper_name("jet_ir_stack_mark"), "stack mark")
    text: "\n\n\n\nfib: fn(n: Int) -> Int {{ n }}\n"
    profile: jet_cli_perf_samples_profile(jet_cli_perf_source("fib.jet", text), sampled) ?? panic("fib's line holds samples")
    assert(profile.reason.contains("; 1 of 3 samples are outside fib.jet; outside Jet functions: jet_rt_alloc 1; 1 samples in compiler-emitted helpers, such as stop polls, count at the line that called them"))
    assert(profile.reason.contains("; 1 samples in Jet code kept no stack"))
    assert(profile.reason.contains("; it kept 3 of the 32 samples that 4 ms of CPU time under sampling gives"))
    assert(!profile.reason.contains("jet_ir_"))
    assert_eq(profile.overhead_status, "measured")
    assert_eq(profile.overhead_ns, Val(U64{9000}))
    assert_eq(profile.overhead_reason, "the sampler took 9 microseconds, 0.22% of the 4000 microseconds of CPU time sampled: 6 in its handlers and 3 signals at the 1000 nanoseconds the kernel took to deliver and return from one as sampling started")
}

// Each record the runtime could not write is counted. A flight ring keeps
// tally records, clock records with 1 for their address: the losses so far,
// then whether the run ended, each counting every loss before it. A `jet
// perf run` exit's clock record carries the count as its seventh word. The
// trace's `records` section keeps the count; a run that lost none has none.
#Test("perf samples count the records the program could not write, and the trace keeps the count") {
    clock: 13 << 59
    tally: clock | (3 << 48) | 1
    ring: jet_cli_perf_test_words([Int]{tally, 4, 0, tally, 9, 0, tally, 9, 1})
    flight: jet_cli_perf_samples_count(X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, [X64ImageFunction]{}, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, ring, 0)
    assert_eq(flight.records_lost, U64{9})
    assert_eq(flight.total, U64{0})
    assert(flight.cost == None)
    file: jet_cli_perf_test_words([Int]{clock | (7 << 48), 4000000, 6000, 1000, 0, 0, 3})
    run: jet_cli_perf_samples_count(X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, [X64ImageFunction]{}, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, file, 0)
    assert_eq(run.records_lost, U64{3})
    assert(run.cost != None)
    section: jet_cli_perf_records_section(U64{3}, "the samples file refused their writes") ?? panic("3 records were lost")
    assert_eq(section.name, "records")
    assert_eq(section.type_name, "JetPerfRecords")
    assert_eq(String.from_bytes(canonical_json_bytes(section.value)) ?? "", "{{\"lost\":3,\"reason\":\"the samples file refused their writes\"}}\n")
    assert(jet_cli_perf_records_section(U64{0}, "the samples file refused their writes") == None)
}

#Test("the per-line table splits a line's samples in a stop poll out of its own") {
    names: [String]{"", "fib.jet", "fib"}
    rows: [JetCLIPerfLineTotal]{JetCLIPerfLineTotal{path: 1, line: 7, function: 2, samples: 71}, JetCLIPerfLineTotal{path: 1, line: 5, function: 2, samples: 29}}
    helpers: [JetCLIPerfLineHelper]{JetCLIPerfLineHelper{path: "fib.jet", line: 7, function: "fib", helper: "stop poll", samples: 34}}
    table: jet_cli_perf_line_table(JetCLIPerfLineTotals{names: names, rows: rows, helpers: helpers}, jet_cli_perf_line_costs_none())
    assert_eq(table, [String]{"  fib.jet:7 fib samples=71 share=71% · stop poll samples=34 share=34%", "  fib.jet:5 fib samples=29 share=29%"})
}

#Test("perf names the sampler that took the CPU-time samples and why the timer took them") {
    // The task clock at perf_event_paranoid 2, once per 125 microseconds of
    // CPU time.
    clock: jet_cli_perf_test_words([Int]{3, 0, 0, 0, 2, 125000, 0})
    json: String.from_bytes(canonical_json_bytes(jet_cli_perf_pc_json(jet_cli_perf_pc_words(clock)))) ?? panic("the pc is UTF-8")
    assert_eq(json, "{{\"paranoid\":2,\"period\":125000,\"period_unit\":\"ns\",\"precise\":false,\"refused\":[],\"skid\":\"task_clock_interrupt\",\"source\":\"task_clock\"}}\n")
    took: jet_cli_perf_pc_words(clock) ?? panic("seven words hold a sampler")
    assert(jet_cli_perf_sampler_reason(took, U64{50}, Val(U64{50000000})).contains("the task clock took them"))
    // The timer above perf_event_paranoid 2 states its cap and why.
    above: jet_cli_perf_pc_words(jet_cli_perf_test_words([Int]{0, 0, 0, 0, 3, 125000, 0})) ?? panic("seven words hold a sampler")
    assert_eq(jet_cli_perf_sampler_reason(above, U64{14}, Val(U64{54000000})), "; the CPU-time timer took them, which the kernel checks once a tick, so each thread takes at most one sample a tick: perf_event_paranoid is 3, and a thread's own perf events need it at most 2")
    // The timer where the kernel refused the task clock names its errno.
    refused: jet_cli_perf_test_words([Int]{0, 0, 0, 13, 2, 125000, 0})
    named: String.from_bytes(canonical_json_bytes(jet_cli_perf_pc_json(jet_cli_perf_pc_words(refused)))) ?? panic("the pc is UTF-8")
    assert(named.contains("\"refused\":[{{\"errno\":13,\"source\":\"task_clock\"}}],\"skid\":\"timer_signal\",\"source\":\"timer\""))
    timer: jet_cli_perf_pc_words(refused) ?? panic("seven words hold a sampler")
    assert(jet_cli_perf_sampler_reason(timer, U64{14}, None).ends_with(": the kernel refused the task clock with errno 13"))
    kept: jet_cli_perf_pc_words(jet_cli_perf_test_words([Int]{0, 0, 0, 0, 2, 125000, 1})) ?? panic("seven words hold a sampler")
    assert(jet_cli_perf_sampler_reason(kept, U64{14}, None).ends_with(": the causal lens keeps it, since its experiments' periods are CPU time's"))
    // IBS op sampling at perf_event_paranoid -1, its period in cycles, and
    // the rate it reached.
    ibs: jet_cli_perf_test_words([Int]{1, 0, 0, 0, -1, 600016, 0})
    precise: String.from_bytes(canonical_json_bytes(jet_cli_perf_pc_json(jet_cli_perf_pc_words(ibs)))) ?? panic("the pc is UTF-8")
    assert_eq(precise, "{{\"paranoid\":-1,\"period\":600016,\"period_unit\":\"cycles\",\"precise\":true,\"refused\":[],\"skid\":null,\"source\":\"ibs_op\"}}\n")
    op: jet_cli_perf_pc_words(ibs) ?? panic("seven words hold a sampler")
    assert_eq(jet_cli_perf_sampler_reason(op, U64{392}, Val(U64{50000000})), "; IBS op sampling took them once per 600016 cycles, the cycles a core ran in 125 microseconds as sampling started, so its rate follows the clock speed: it reached 7.84 samples per millisecond of CPU time")
    // Six words are no sampler.
    assert(jet_cli_perf_pc_words(jet_cli_perf_test_words([Int]{0, 0, 0, 0, 2, 125000})) == None)
}

#Test("a CPU-time sample's record ends in its time and task, and a zone of that task holds the samples inside it") {
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}, X64ImageFunction{start: 12288, size: 16, name: "jet_rt_alloc"}}
    two: 2 << 48
    three: 3 << 48
    four: 4 << 48
    words: jet_cli_perf_test_words(
        [Int]{
            // In fib called from fib, at 2000 ns, of task 7.
            4112 | four,
            4160,
            2000,
            7,
            // In fib with no stack, at 1000 ns, of task 7.
            4112 | three,
            1000,
            7,
            // In the runtime at 1500 ns: no line of the source.
            12292 | three,
            1500,
            7,
            // In fib at 5000 ns, of task 9.
            4112 | three,
            5000,
            9,
            // Two words and no more: a program counter and a caller, untimed.
            4112 | two,
            4160,
        },
    )
    sampled: jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.total, U64{5})
    assert_eq(sampled.stackless, U64{2})
    assert_eq(sampled.outside, U64{1})
    assert_eq(sampled.timed.len(), 4)
    assert_eq(sampled.timed[0].at_ns, 1000)
    assert_eq(sampled.timed[0].line, 5)
    assert_eq(sampled.timed[1].at_ns, 1500)
    assert_eq(sampled.timed[1].line, 0)
    assert_eq(sampled.timed[2].at_ns, 2000)
    assert_eq(sampled.timed[2].task, 7)
    assert_eq(sampled.timed[3].task, 9)
    assert_eq(jet_cli_perf_timed_first(sampled.timed, 0), 0)
    assert_eq(jet_cli_perf_timed_first(sampled.timed, 1500), 1)
    assert_eq(jet_cli_perf_timed_first(sampled.timed, 1501), 2)
    assert_eq(jet_cli_perf_timed_first(sampled.timed, 9000), 4)
    zone: JetCLIPerfZoneTotal{name: "solve", count: 1, total: 3000, longest: 3000, samples: 3, lines: [Int:Int]{5: 2}}
    section: jet_cli_perf_zones_section([JetCLIPerfZoneTotal]{zone}, [Int]{}, [JetCLIPerfPlotTotal]{}, [JetCLIPerfZoneSampled]{JetCLIPerfZoneSampled{name: "solve", start_ns: U64{0}, end_ns: U64{3000}, samples: 3, line: 5}}, "fib.jet", "", "")
    json: String.from_bytes(canonical_json_bytes(section.value)) ?? panic("the section is UTF-8")
    assert(json.contains(`"sampled":[{"end_ns":3000,"line":5,"name":"solve","samples":3,"start_ns":0}]`))
    assert(json.contains(`"source":"fib.jet"`))
    assert(json.contains(`{"count":1,"lines":[{"line":5,"samples":2}],"longest_ns":3000,"name":"solve","samples":3,"total_ns":3000}`))
}

// The runtime times zones, waits and log spans from the process epoch, its
// first monotonic read (time_host_monotonic_i64), which the first zone's
// open may be: a run's first zone opens 1293 ns after it. Each CPU-time
// sample is stamped on that clock too, -1 before the epoch is set.
#Test("a zone holds the CPU-time samples its task took inside it, both timed from the process epoch") {
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}}
    three: 3 << 48
    words: jet_cli_perf_test_words(
        [Int]{
            // Before the epoch was set: in no zone.
            4112 | three,
            -1,
            7,
            // Inside solve, of solve's task 7.
            4112 | three,
            1500,
            7,
            4112 | three,
            4000,
            7,
            // Inside solve's time, of task 9.
            4112 | three,
            2000,
            9,
            // At solve's end, so past it.
            4112 | three,
            4293,
            7,
        },
    )
    sampled: jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.timed.len(), 5)
    // solve's row of the spans file, as perf_zone_row writes it.
    row := jet_cli_perf_test_words([Int]{1293, 4293, 7, 5 | (1 << 32)})
    row.extend("solve".bytes())
    path: "{perf_test_sys.temp_dir()}/jet-perf-zone-clock-{perf_test_process.current_pid()}.spans"
    perf_test_files.write_bytes(path, row) ?? panic("the spans file: {err}")
    capture := jet_cli_perf_capture_source("fib.jet", "fib: fn() -> Int {{ 1 }}", [JetCLIPerfObservation]{}, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    jet_cli_perf_log_spans_read(capture, path, "fib.jet", 0, sampled.timed)
    assert(!perf_test_files.exists(path))
    assert_eq(capture.spans[capture.spans.len() - 1].start_ns, Val(U64{1293}))
    json: String.from_bytes(canonical_json_bytes(capture.receipts[capture.receipts.len() - 1].value)) ?? panic("the section is UTF-8")
    assert(json.contains(`"sampled":[{"end_ns":4293,"line":5,"name":"solve","samples":2,"start_ns":1293}]`))
    assert(json.contains(`{"count":1,"lines":[{"line":5,"samples":2}],"longest_ns":3000,"name":"solve","samples":2,"total_ns":3000}`))
}

// A spans file that reached its bound ends in a row saying so (the
// runtime's perf_spans_write): the rows before it stay trace rows, and the
// zones section names the cut, which is no row of its own.
#Test("a spans file cut at its bound keeps its earlier rows and names the cut in the zones section") {
    row := jet_cli_perf_test_words([Int]{100, 400, 7, 5 | (1 << 32)})
    row.extend("solve".bytes())
    reason: "the spans file reached its 16 MiB bound, so the rows after this were dropped"
    row.extend(jet_cli_perf_test_words([Int]{0, 0, 0, reason.len() | (5 << 32)}))
    row.extend(reason.bytes())
    path: "{perf_test_sys.temp_dir()}/jet-perf-zone-cut-{perf_test_process.current_pid()}.spans"
    perf_test_files.write_bytes(path, row) ?? panic("the spans file: {err}")
    capture := jet_cli_perf_capture_source("fib.jet", "fib: fn() -> Int {{ 1 }}", [JetCLIPerfObservation]{}, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    spans: capture.spans.len()
    jet_cli_perf_log_spans_read(capture, path, "fib.jet", 0, [JetCLIPerfTimed]{})
    assert(!perf_test_files.exists(path))
    assert_eq(capture.spans.len(), spans + 1)
    json: String.from_bytes(canonical_json_bytes(capture.receipts[capture.receipts.len() - 1].value)) ?? panic("the section is UTF-8")
    assert(json.starts_with(`{"cut":"the spans file reached its 16 MiB bound, so the rows after this were dropped","frames":`))
    assert(json.contains(`"name":"solve"`))
}

// A killed profiled program's files are swept by the process their name
// holds: a flight ring's program, a session's or an attach's own pid.
#Test("a profiling file names its process, and no other file does") {
    assert_eq(jet_cli_perf_file_pid("jet-flight-4123.samples"), Val(4123))
    assert_eq(jet_cli_perf_file_pid("jet-flight-4123.samples.spans"), Val(4123))
    assert_eq(jet_cli_perf_file_pid("jet-perf-77-1700000000.samples.image"), Val(77))
    assert_eq(jet_cli_perf_file_pid("jet-perf-attach-90-4123-1700000000.spans"), Val(90))
    assert_eq(jet_cli_perf_file_pid("jet-perf-zone-clock-12.spans"), None)
    assert_eq(jet_cli_perf_file_pid("jet-flight-4123"), None)
    assert_eq(jet_cli_perf_file_pid("jet-flight-0.samples"), None)
    assert_eq(jet_cli_perf_file_pid("jet-observe-4123.json"), None)
}

// A short task can start and end between two observations, so none sees
// it: its spawn record, which names its spawner, gives it a done task's row
// under the spawner's, and the join on it names it, the line that spawned
// it and its wake.
#Test("a task no observation saw gets a row under its spawner's, which the join on it names") {
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}}
    words: jet_cli_perf_test_words(
        [Int]{
            // Task 1 spawns task 5 at a call site of fib.
            5 | (3 << 48) | (15 << 59),
            1,
            4112,
            // Task 1 joins task 5 on slot 64, from 100 to 200 ns, with no
            // name, addresses or stack.
            1 | (6 << 48) | (14 << 59),
            64,
            100,
            200,
            5 | (1 << 48),
            0,
            // Task 5 wakes slot 64 at 150 ns as it ends.
            5 | (3 << 48) | (12 << 59),
            64,
            150,
        },
    )
    sampled := jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.spawns.len(), 1)
    observations: [JetCLIPerfObservation]{JetCLIPerfObservation{at_ns: U64{10}, live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(1))}}
    capture := jet_cli_perf_capture_source("fib.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    jet_cli_perf_waits_read(capture, sampled.waits.move(), sampled.wakes.move(), sampled.spawns.move(), [U64:U64]{}, sampled.transfers.move(), "fib.jet", 0)
    assert_eq(capture.tasks.len(), 2)
    assert_eq(capture.tasks[1].id, U64{2})
    assert_eq(capture.tasks[1].parent, U64{1})
    assert_eq(capture.tasks[1].state, "done")
    join: capture.spans[capture.spans.len() - 1]
    assert_eq(join.kind, "task_wait")
    assert_eq(join.task_id, Val(U64{1}))
    assert_eq(join.awaited_task_id, Val(U64{2}))
    assert_eq(join.spawn_line, Val(U64{5}))
    assert_eq(join.waker, "task")
    assert_eq(join.waker_task_id, Val(U64{2}))
    toolchain: TraceToolchain{jet_version: "test", compiler_build_id: "test", stdlib_id: "test", runner_id: "test"}
    hardware: TraceHardware{cpu_arch: "x86_64", logical_cpus: U64{1}, os: "linux", target: "x86_64-unknown-linux-gnu"}
    _: jet_cli_perf_capture_bytes(capture, "run", [String]{"fib.jet"}, toolchain, hardware) ?? panic(err.message)
}

// A socket's wait the runtime woke ends by its peer's act, outside the
// program: the span names its peer and neither a task nor a line, even when
// the runtime's wake carried a line on its stack.
#Test("a socket's wait the runtime woke names its peer and no line") {
    observations: [JetCLIPerfObservation]{JetCLIPerfObservation{at_ns: U64{10}, live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(1))}}
    capture := jet_cli_perf_capture_source("fib.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    waits := [JetCLIPerfWait]{JetCLIPerfWait{task: U64{1}, slot: 64, start_ns: 100, end_ns: 200, class: JET_CLI_PERF_OBJECT_SOCKET, id: U64{3}, local: "127.0.0.1:4000", peer: "127.0.0.1:5000", name: "tcp read", frames: [TraceStackFrame]{}}}
    wakes: [JetCLIPerfWake]{JetCLIPerfWake{task: U64{0}, slot: 64, at_ns: 150, line: Val(7)}}
    jet_cli_perf_waits_read(capture, waits, wakes, [JetCLIPerfSpawn]{}, [U64:U64]{}, [JetCLIPerfIO]{}, "fib.jet", 0)
    wait: capture.spans[capture.spans.len() - 1]
    assert_eq(wait.kind, "task_wait")
    assert_eq(wait.waker, "peer")
    assert_eq(wait.waker_task_id, None)
    assert_eq(wait.waker_line, None)
    toolchain: TraceToolchain{jet_version: "test", compiler_build_id: "test", stdlib_id: "test", runner_id: "test"}
    hardware: TraceHardware{cpu_arch: "x86_64", logical_cpus: U64{1}, os: "linux", target: "x86_64-unknown-linux-gnu"}
    _: jet_cli_perf_capture_bytes(capture, "run", [String]{"fib.jet"}, toolchain, hardware) ?? panic(err.message)
}

// Past the task row limit, the tasks with the fewest CPU-time samples have
// no row; the `tasks` section still counts each, with its samples, in its
// phase.
#Test("tasks past the row limit fold into their phases with their samples, the fewest samples first") {
    observations: [JetCLIPerfObservation]{JetCLIPerfObservation{at_ns: U64{10}, live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(1))}}
    capture := jet_cli_perf_capture_source("fib.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    // Task 1 spawns tasks 2 to 4100: 4099 tasks beside it, 4 past the 4096
    // rows. Tasks 2 to 5 took one sample each, the rest two, and task 1
    // three; tasks 2 to 2049 opened `parse`, the rest `lower`.
    spawns := [JetCLIPerfSpawn]{}
    samples := [U64:U64]{}
    samples[U64{1}] = U64{3}
    loop task in 2..<4101 {
        spawns.push(JetCLIPerfSpawn{task: U64{task}, parent: U64{1}, line: None})
        samples[U64{task}] = if task <= 5 -> U64{1} else -> U64{2}
        capture.task_phases[U64{task}] = if task <= 2049 -> "parse" else -> "lower"
    }
    jet_cli_perf_waits_read(capture, [JetCLIPerfWait]{}, [JetCLIPerfWake]{}, spawns, samples, [JetCLIPerfIO]{}, "fib.jet", 0)
    assert_eq(capture.tasks.len(), 4096)
    assert(capture.policy.task_rows_truncated)
    assert(!capture.task_ids.has_key(U64{2}))
    assert(!capture.task_ids.has_key(U64{5}))
    assert(capture.task_ids.has_key(U64{6}))
    assert(capture.task_ids.has_key(U64{4100}))
    section: jet_cli_perf_tasks_section(capture.task_ids, capture.task_phases, spawns, samples) ?? panic("the run has tasks")
    assert_eq(section.type_name, "JetPerfTasks")
    expected: `{"count":4100,"coverage":"complete","phases":[{"folded":0,"folded_samples":0,"name":"lower","samples":4102,"tasks":2051},{"folded":4,"folded_samples":4,"name":"parse","samples":4092,"tasks":2048},{"folded":0,"folded_samples":0,"name":null,"samples":3,"tasks":1}],"rows":4096,"unattributed_samples":0}`
    assert_eq(String.from_bytes(canonical_json_bytes(section.value)) ?? "", "{expected}\n")
    capture.receipts.push(section)
    toolchain: TraceToolchain{jet_version: "test", compiler_build_id: "test", stdlib_id: "test", runner_id: "test"}
    hardware: TraceHardware{cpu_arch: "x86_64", logical_cpus: U64{1}, os: "linux", target: "x86_64-unknown-linux-gnu"}
    _: jet_cli_perf_capture_bytes(capture, "run", [String]{"fib.jet"}, toolchain, hardware) ?? panic(err.message)
}

// A task that opened no zone or log span takes its spawner's phase; the
// samples of a task the run recorded no spawn of count in none.
#Test("a task's phase is its spawner's when it opened none, and an unrecorded task's samples leave the coverage partial") {
    rowed := [U64:U64]{}
    rowed[U64{1}] = U64{1}
    rowed[U64{2}] = U64{2}
    named := [U64:String]{}
    named[U64{2}] = "parse"
    spawns: [JetCLIPerfSpawn]{JetCLIPerfSpawn{task: U64{2}, parent: U64{1}, line: None}, JetCLIPerfSpawn{task: U64{3}, parent: U64{2}, line: None}, JetCLIPerfSpawn{task: U64{4}, parent: U64{1}, line: None}}
    samples := [U64:U64]{}
    samples[U64{1}] = U64{1}
    samples[U64{3}] = U64{2}
    samples[U64{4}] = U64{4}
    samples[U64{7}] = U64{5}
    section: jet_cli_perf_tasks_section(rowed, named, spawns, samples) ?? panic("the run has tasks")
    expected: `{"count":4,"coverage":"partial","phases":[{"folded":1,"folded_samples":4,"name":null,"samples":5,"tasks":2},{"folded":1,"folded_samples":2,"name":"parse","samples":2,"tasks":2}],"rows":2,"unattributed_samples":5}`
    assert_eq(String.from_bytes(canonical_json_bytes(section.value)) ?? "", "{expected}\n")
}

// The profile row of line `at + 1` of a.jet in function `name`, hotter for
// a lower `at`.
jet_cli_perf_test_line_row: fn(digest: String, at: Int, name: String) -> TraceProfileRow Never! {
    source: TraceProfileSource{path: "a.jet", sha256: digest, start_line: U64{at + 1}, start_column: U64{1}, end_line: U64{at + 1}, end_column: U64{9}}
    TraceProfileRow{clock: "cpu", allocation_count: Val(U64{1}), dtlb_miss_count: None, execution_count: None, inclusive_count: Val(U64{6000}), l1d_miss_count: None, llc_miss_count: None, page_fault_count: None, sample_count: U64{5000 - at}, sample_weight: U64{5000 - at}, source: source, symbol: JetSymbolRef{path: "a.jet", name: name}}
}

// One profile row per line, hottest first: past the row limit the coldest
// lines fold by function, or by source when the functions alone pass it.
#Test("profile rows past the row limit fold by function, else by source, keeping every sample") {
    digest: sha256_hex("run")
    by_function := [TraceProfileRow]{}
    by_source := [TraceProfileRow]{}
    loop at in 0..<4100 {
        by_function.push(jet_cli_perf_test_line_row(digest, at, if at < 4090 -> "hot" else -> "cold"))
        by_source.push(jet_cli_perf_test_line_row(digest, at, "f{at}"))
    }
    // Rows 4095 to 4099, all of `cold`, fold into one.
    fold: jet_cli_perf_profile_fold(by_function)
    assert_eq(fold.rows.len(), 4096)
    assert_eq(fold.dropped, U64{0})
    last: fold.rows[4095]
    assert_eq(last.symbol.name, "cold")
    assert_eq(last.sample_count, U64{905 + 904 + 903 + 902 + 901})
    assert_eq(last.allocation_count, Val(U64{5}))
    assert_eq(last.inclusive_count, None)
    assert_eq(last.source.start_line, U64{4096})
    assert_eq(last.source.end_line, U64{4100})
    assert_eq(fold.note, "; past the 4096-row limit its 5 coldest lines fold into 1 rows, one per function, each from its first folded line to its last")
    // Each line its own function: they fold by source, named by how many.
    folded: jet_cli_perf_profile_fold(by_source)
    assert_eq(folded.rows.len(), 4096)
    assert_eq(folded.rows[4095].symbol.name, "5 functions")
    assert_eq(folded.rows[4095].sample_count, U64{4515})
    assert(folded.note.contains("one per source, named by how many functions it holds"))
}

#Test("a heap snapshot's blocks count by their line and by the type their innermost typed allocating call names") {
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    words: jet_cli_perf_test_words(
        [Int]{
            // Snapshot 1, `exit`: 3 blocks, 112 bytes, its 4-byte name.
            1 | (5 << 48) | (10 << 59),
            3,
            112,
            4,
            0x74697865,
            // 2 blocks of 96 bytes the runtime allocated for fib's typed call
            // returning to 12300, which fib's line 5 made.
            1 | (5 << 48) | (9 << 59),
            2,
            96,
            12300,
            4160,
            // 1 block of 16 bytes an untyped call at the same line allocated.
            1 | (4 << 48) | (9 << 59),
            1,
            16,
            4170,
        },
    )
    allocs: [Int:Int]{12300: 77}
    names: [Int:String]{77: "[I64]"}
    sampled: jet_cli_perf_samples_count(table, [X64ImageFunction]{}, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, allocs, names, words, 0)
    assert_eq(sampled.heaps.len(), 1)
    heap: sampled.heaps[0]
    assert_eq(heap.name, "exit")
    assert_eq(heap.sites.len(), 2)
    assert_eq(heap.sites[0].type_name, "[I64]")
    assert_eq(heap.sites[0].line, U64{5})
    assert_eq(heap.sites[0].bytes, U64{96})
    assert_eq(heap.sites[1].type_name, "")
    assert_eq(heap.sites[1].line, U64{5})
    assert_eq(heap.sites[1].blocks, U64{1})
}

#Test("a heap snapshot's typed blocks are retained along the shortest path from a root, named by its variable and its types' fields") {
    word: NativeType{name: "Int", size: 8, tag: 0x24, encoding: X64DebugEncoding.Signed, target: -1, group: -1}
    types: [Int:NativeType]{
        100: word,
        // struct Room {id: Int, history: [Message]}, and the lists.
        10: NativeType{name: "Room", size: 32, tag: NATIVE_TAG_STRUCT, encoding: X64DebugEncoding.Unsigned, target: -1, group: 0},
        20: NativeType{name: "[Message]", size: 24, tag: NATIVE_TAG_STRUCT, encoding: X64DebugEncoding.Unsigned, target: -1, group: -1},
        40: NativeType{name: "[Room]", size: 24, tag: NATIVE_TAG_STRUCT, encoding: X64DebugEncoding.Unsigned, target: -1, group: -1},
        80: NativeType{name: "Message", size: 16, tag: NATIVE_TAG_STRUCT, encoding: X64DebugEncoding.Unsigned, target: -1, group: 1},
        // What the typed allocating calls allocate for: a list's buffer of
        // rooms, one of messages.
        50: NativeType{name: "[Room]", size: 0, tag: NATIVE_TAG_TYPEDEF, encoding: X64DebugEncoding.Unsigned, target: 51, group: -1},
        51: NativeType{name: "", size: 8, tag: NATIVE_TAG_POINTER, encoding: X64DebugEncoding.Unsigned, target: 10, group: -1},
        70: NativeType{name: "[Message]", size: 0, tag: NATIVE_TAG_TYPEDEF, encoding: X64DebugEncoding.Unsigned, target: 71, group: -1},
        71: NativeType{name: "", size: 8, tag: NATIVE_TAG_POINTER, encoding: X64DebugEncoding.Unsigned, target: 80, group: -1},
    }
    members: [[NativeMember]]{
        [NativeMember]{NativeMember{name: "id", offset: 0, ty: 100, die: 0}, NativeMember{name: "history", offset: 8, ty: 20, die: 0}},
        [NativeMember]{NativeMember{name: "id", offset: 0, ty: 100, die: 0}, NativeMember{name: "body", offset: 8, ty: 100, die: 0}},
    }
    // `rooms` lives at rbp-16 over [4096, 4352): DW_LLE_offset_pair 0, 256,
    // then DW_OP_fbreg -16.
    rooms: NativeVariable{name: "rooms", line: 3, ty: 40, list: 0, base: 4096, role: NativeVariableRole.Local, site: -1}
    facts: NativeImage{lines: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, functions: [NativeFunction]{NativeFunction{low: 4096, high: 4352, name: "serve", file: -1, variables: [NativeVariable]{rooms}, inlined: [NativeInlined]{}}}, types: types, members: members, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: [U8]{0x04, 0x00, 0x80, 0x02, 0x02, 0x91, 0x70, 0x00}, abstracts: [Int:NativeAbstract]{}, allocs: [Int:Int]{}}
    heap := JetCLIPerfHeap{
        number: U64{1},
        name: "exit",
        blocks: U64{3},
        bytes: U64{192},
        sites: [JetCLIPerfHeapSite]{},
        groups: [Int]{50, 70},
        live: [JetCLIPerfHeapBlock]{
            // The rooms' buffer: room 1's history's buffer pointer, at
            // 32 + 8 + 16.
            JetCLIPerfHeapBlock{address: 0x10000, size: 96, group: 1, refs: [JetCLIPerfHeapRef]{JetCLIPerfHeapRef{offset: 56, target: 0x20000}}},
            JetCLIPerfHeapBlock{address: 0x20000, size: 48, group: 2, refs: [JetCLIPerfHeapRef]{}},
            // Messages no root reaches.
            JetCLIPerfHeapBlock{address: 0x30000, size: 48, group: 2, refs: [JetCLIPerfHeapRef]{}},
        },
        frames: [JetCLIPerfHeapFrame]{JetCLIPerfHeapFrame{pc: 4100, base: 0x7000, low: 0x6f00}},
        roots: [JetCLIPerfHeapRoot]{JetCLIPerfHeapRoot{address: 0x6ff0, target: 0x10000, data: false}},
        retained: [JetCLIPerfRetained]{},
    }
    jet_cli_perf_heap_retain(facts, [JetCLIPerfHeapObject]{}, [Int:String]{50: "[Room]", 70: "[Message]"}, heap)
    assert_eq(heap.live.len(), 0)
    assert_eq(heap.retained.len(), 3)
    assert_eq(heap.retained[0].type_name, "[Message]")
    assert_eq(heap.retained[0].path, "rooms[1].history")
    assert_eq(heap.retained[0].bytes, U64{48})
    assert_eq(heap.retained[1].type_name, "[Message]")
    assert_eq(heap.retained[1].path, "")
    assert_eq(heap.retained[2].type_name, "[Room]")
    assert_eq(heap.retained[2].path, "rooms")
    assert_eq(heap.retained[2].blocks, U64{1})
}

#Test("`--retained-by` names a type by its whole name or its last part, and lists the paths that retain it") {
    retained: [JetCLIPerfHeapRetention]{
        JetCLIPerfHeapRetention{type_name: "chat.Message", path: "rooms[1].history", blocks: 2, bytes: 64},
        JetCLIPerfHeapRetention{type_name: "chat.Message", path: "", blocks: 1, bytes: 32},
        JetCLIPerfHeapRetention{type_name: "Room", path: "rooms", blocks: 1, bytes: 96},
    }
    snapshots: [JetCLIPerfHeapSnapshot]{JetCLIPerfHeapSnapshot{name: "exit", blocks: 4, bytes: 192, places: [JetCLIPerfHeapPlace]{}, retained: retained}}
    assert_eq(jet_cli_perf_heap_retention_lines(snapshots, "Message"), [String]{"retained chat.Message at exit  3 blocks  96 bytes", "  rooms[1].history  2 blocks  64 bytes", "  no root reached (another thread's stack or a register holds them)  1 blocks  32 bytes"})
    assert_eq(jet_cli_perf_heap_retention_lines(snapshots, "chat.Message").len(), 3)
    assert_eq(jet_cli_perf_heap_retention_lines(snapshots, "Ring").len(), 0)
    assert_eq(jet_cli_perf_heap_types(snapshots), "; they keep Room, chat.Message")
}

#Test("perf samples in inlined code count at the inlined line and inclusive at the call") {
    // run's code at 0x1000: its rows give line 6 at 0x1000 (sum_squares's
    // body, inlined), 14 at 0x1040, 3 at 0x1080 (max's body, inlined from
    // file 2) and 15 at 0x1090.
    rows: [U8]{0, 5, 0x80, 1, 8, 0x80, 1, 117, 32, 12}
    table: X64Jetline{table: rows, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "run", file: "prog.jet", dir: "", decl: 10, rows: 0, rows_end: 10}}}
    runs: [NativeInlined]{
        NativeInlined{die: 10, origin: 1, low: 4096, high: 4160, call_line: 14, parent: -1, file: 1, call_file: 1},
        NativeInlined{die: 20, origin: 2, low: 4224, high: 4240, call_line: 15, parent: -1, file: 2, call_file: 1},
    }
    inlines: JetCLIPerfInlines{functions: [Int:NativeFunction]{4096: NativeFunction{low: 4096, high: 4352, name: "run", file: 1, variables: [NativeVariable]{}, inlined: runs}}, abstracts: [Int:NativeAbstract]{1: NativeAbstract{name: "sum_squares", file: 1}, 2: NativeAbstract{name: "max", file: 2}}}
    one: 1 << 48
    two: 2 << 48
    words: jet_cli_perf_test_words(
        [Int]{
            // In sum_squares's inlined body.
            4112 | one,
            // In max's, from another file.
            4228 | one,
            // At run's line 14, called from the call that returns to
            // 0x1010, inside sum_squares's run.
            4176 | two,
            4112,
        },
    )
    sampled: jet_cli_perf_samples_count(table, [X64ImageFunction]{}, inlines, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.total, U64{3})
    text := ""
    loop _ in 0..<16 -> text = "{text}line\n"
    profile: jet_cli_perf_samples_profile(jet_cli_perf_source("prog.jet", text), sampled) ?? panic("run's lines hold samples")
    found := 0
    loop row in profile.rows {
        line: row.source.start_line
        if line == (U64{6}) {
            assert_eq(row.symbol.name, "sum_squares")
            assert_eq(row.sample_count, U64{1})
            assert_eq(row.inclusive_count, Val(U64{2}))
            found += 1
        }
        if line == (U64{14}) {
            assert_eq(row.symbol.name, "run")
            assert_eq(row.sample_count, U64{1})
            assert_eq(row.inclusive_count, Val(U64{2}))
            found += 1
        }
        if line == (U64{15}) {
            assert_eq(row.symbol.name, "run")
            assert_eq(row.sample_count, U64{0})
            assert_eq(row.inclusive_count, Val(U64{1}))
            found += 1
        }
        // max's line 3 is in its own file, not prog.jet.
        assert(line != (U64{3}))
    }
    assert_eq(found, 3)
    assert(profile.reason.contains("; 1 of 3 samples are outside prog.jet"))
}

#Test("a causal rate counts each experiment's passes after its first over the time from its first pass to its last, less the delay inserted meanwhile") {
    experiments := [JetCLIPerfExperiment]{}
    // Baselines: 4 passes after the first in 20 ms, a pass each 5 ms. The
    // line's experiments: 4 in 22 ms with 6 ms of it inserted delay, a pass
    // each 4 ms, 20% sooner. Each thread has a CPU: they never wait for one,
    // and their CPUs stay within 2% of one clock.
    loop _ in 0..<6 {
        experiments.push(JetCLIPerfExperiment{line: U64{0}, name: "", speedup: 0, run_ns: 25000000, wait_ns: 0, khz_high: 4900000, khz_low: 4800000, after: [Int]{4}, span_ns: [Int]{20000000}, span_delay_ns: [Int]{0}})
        experiments.push(JetCLIPerfExperiment{line: U64{30}, name: "narrow", speedup: 300, run_ns: 25000000, wait_ns: 0, khz_high: 4900000, khz_low: 4800000, after: [Int]{4}, span_ns: [Int]{22000000}, span_delay_ns: [Int]{6000000}})
    }
    section: jet_cli_perf_causal_section("main.jet", experiments, [Int:String]{0: "round"}, [Int]{})
    json: String.from_bytes(canonical_json_bytes(section.value)) ?? panic("the section is UTF-8")
    assert(json.contains(`{"experiments":6,"function":"narrow","gain_tenths":200,"high_tenths":200,"line":30,"low_tenths":200}`))
    assert(json.contains(`"cpu_run_ms":300,"cpu_wait_ms":0,`))
    assert(json.contains(`"clock_fit":{"cells":[],"r2_thousandths":0,"refused":"the run wrote no idle table","slope_thousandths":0},"clock_flag":null,"clock_high_mhz":4900,"clock_low_mhz":4800,`))
    assert(json.contains(`"refused":null`))
}

#Test("a causal run whose CPUs clocked down between experiments, with no fit of how that slows its tasks, keeps its gains, flagged with the drop") {
    experiments := [JetCLIPerfExperiment]{}
    // The same rates, but each experiment ended with one of the CPUs that
    // ran the program's threads at 3,908 MHz beside one at 4,993: a CPU
    // that idled clocked down. An experiment whose clocks could not be read
    // counts in neither mean.
    loop _ in 0..<6 {
        experiments.push(JetCLIPerfExperiment{line: U64{0}, name: "", speedup: 0, run_ns: 25000000, wait_ns: 0, khz_high: 4993000, khz_low: 3908000, after: [Int]{4}, span_ns: [Int]{20000000}, span_delay_ns: [Int]{0}})
        experiments.push(JetCLIPerfExperiment{line: U64{30}, name: "narrow", speedup: 300, run_ns: 25000000, wait_ns: 0, khz_high: 4993000, khz_low: 3908000, after: [Int]{4}, span_ns: [Int]{22000000}, span_delay_ns: [Int]{6000000}})
    }
    experiments.push(JetCLIPerfExperiment{line: U64{0}, name: "", speedup: 0, run_ns: 25000000, wait_ns: 0, khz_high: 0, khz_low: 0, after: [Int]{4}, span_ns: [Int]{20000000}, span_delay_ns: [Int]{0}})
    section: jet_cli_perf_causal_section("main.jet", experiments, [Int:String]{0: "round"}, [Int]{})
    json: String.from_bytes(canonical_json_bytes(section.value)) ?? panic("the section is UTF-8")
    assert(json.contains(`"clock_flag":"gains may under-read: idle CPUs clocked down 21.7% (4993 MHz to 3908 MHz) between experiments, above the 10.0% the lens trusts, and it could not fit how much slower a task runs after its CPU idled (the run wrote no idle table): `))
    assert(json.contains(`"clock_high_mhz":4993,"clock_low_mhz":3908,`))
    // The gains stay, and the run is not refused.
    assert(json.contains(`{"experiments":6,"function":"narrow","gain_tenths":200,"high_tenths":200,"line":30,"low_tenths":200}`))
    assert(json.contains(`"refused":null`))
}

#Test("a causal run's gains are warmed by the fit of how much slower a task runs the longer its CPU idled, which unflags a clock drop") {
    experiments := [JetCLIPerfExperiment]{}
    // The clocked-down run's rates: virtually, the line makes a round 20%
    // sooner.
    loop _ in 0..<6 {
        experiments.push(JetCLIPerfExperiment{line: U64{0}, name: "", speedup: 0, run_ns: 25000000, wait_ns: 0, khz_high: 4993000, khz_low: 3908000, after: [Int]{4}, span_ns: [Int]{20000000}, span_delay_ns: [Int]{0}})
        experiments.push(JetCLIPerfExperiment{line: U64{30}, name: "narrow", speedup: 300, run_ns: 25000000, wait_ns: 0, khz_high: 4993000, khz_low: 3908000, after: [Int]{4}, span_ns: [Int]{22000000}, span_delay_ns: [Int]{6000000}})
    }
    // One task body's row: 100 tasks after 8 µs idle ran 1.0 ms each, 100
    // after 32 µs 1.1 ms and 100 after 128 µs 1.2 ms. Against the body's
    // mean of 1.1 ms that is 909, 1000 and 1090 thousandths, 45 more per
    // octave of idle.
    runs: [Int:Int]{3: 100000000, 5: 110000000, 7: 120000000}
    gaps: [Int:Int]{3: 800000, 5: 3200000, 7: 12800000}
    idle := [Int]{16384}
    loop octave in 0..<16 {
        idle.push(if runs.get(octave) == None -> 0 else -> 100)
        idle.push(runs.get(octave) ?? 0)
        idle.push(gaps.get(octave) ?? 0)
    }
    section: jet_cli_perf_causal_section("main.jet", experiments, [Int:String]{0: "round"}, idle)
    json: String.from_bytes(canonical_json_bytes(section.value)) ?? panic("the section is UTF-8")
    assert(json.contains(`"clock_fit":{"cells":[{"fitted":true,"gap_us":8,"residual_thousandths":0,"slowness_thousandths":909,"tasks":100},{"fitted":true,"gap_us":32,"residual_thousandths":1,"slowness_thousandths":1000,"tasks":100},{"fitted":true,"gap_us":128,"residual_thousandths":1,"slowness_thousandths":1090,"tasks":100}],"r2_thousandths":1000,"refused":null,"slope_thousandths":45}`))
    // A round 20% sooner leaves each carrier idle a fifth of a round less,
    // under a microsecond, so its tasks run as fast as after the 8 µs gap:
    // 909 thousandths of their time, which leaves rounds 27.3% sooner.
    assert(json.contains(`{"experiments":6,"function":"narrow","gain_tenths":273,"high_tenths":273,"line":30,"low_tenths":273}`))
    // The fit holds, so the 21.7% drop is no flag.
    assert(json.contains(`"clock_flag":null,"clock_high_mhz":4993,"clock_low_mhz":3908,`))
}

#Test("a causal run's idle table with too few octaves of tasks fits nothing and leaves the gains as they are") {
    experiments := [JetCLIPerfExperiment]{}
    loop _ in 0..<6 {
        experiments.push(JetCLIPerfExperiment{line: U64{0}, name: "", speedup: 0, run_ns: 25000000, wait_ns: 0, khz_high: 4900000, khz_low: 4800000, after: [Int]{4}, span_ns: [Int]{20000000}, span_delay_ns: [Int]{0}})
        experiments.push(JetCLIPerfExperiment{line: U64{30}, name: "narrow", speedup: 300, run_ns: 25000000, wait_ns: 0, khz_high: 4900000, khz_low: 4800000, after: [Int]{4}, span_ns: [Int]{22000000}, span_delay_ns: [Int]{6000000}})
    }
    // 100 tasks after 8 µs and 20 after 128 µs: one octave of 30 or more.
    tasks: [Int:Int]{3: 100, 7: 20}
    gaps: [Int:Int]{3: 800000, 7: 2560000}
    idle := [Int]{16384}
    loop octave in 0..<16 {
        idle.push(tasks.get(octave) ?? 0)
        idle.push((tasks.get(octave) ?? 0) * 1000000)
        idle.push(gaps.get(octave) ?? 0)
    }
    section: jet_cli_perf_causal_section("main.jet", experiments, [Int:String]{0: "round"}, idle)
    json: String.from_bytes(canonical_json_bytes(section.value)) ?? panic("the section is UTF-8")
    assert(json.contains(`"refused":"only 1 of the octaves of idle gap held 30 tasks or more, and the fit needs 3"`))
    assert(json.contains(`{"fitted":false,"gap_us":128,"residual_thousandths":0,"slowness_thousandths":1000,"tasks":20}`))
    assert(json.contains(`{"experiments":6,"function":"narrow","gain_tenths":200,"high_tenths":200,"line":30,"low_tenths":200}`))
}

#Test("a causal run whose threads waited for a CPU most of their run time is refused with the wait, its gains withheld") {
    experiments := [JetCLIPerfExperiment]{}
    // The same rates as a run with a CPU per thread would rank, but the
    // threads waited 16 ms of every 20 they ran, as four threads do on
    // 2.15 CPUs.
    loop _ in 0..<6 {
        experiments.push(JetCLIPerfExperiment{line: U64{0}, name: "", speedup: 0, run_ns: 20000000, wait_ns: 16000000, khz_high: 0, khz_low: 0, after: [Int]{4}, span_ns: [Int]{20000000}, span_delay_ns: [Int]{0}})
        experiments.push(JetCLIPerfExperiment{line: U64{30}, name: "narrow", speedup: 300, run_ns: 20000000, wait_ns: 16000000, khz_high: 0, khz_low: 0, after: [Int]{4}, span_ns: [Int]{22000000}, span_delay_ns: [Int]{6000000}})
    }
    section: jet_cli_perf_causal_section("main.jet", experiments, [Int:String]{0: "round"}, [Int]{})
    json: String.from_bytes(canonical_json_bytes(section.value)) ?? panic("the section is UTF-8")
    assert(json.contains(`"refused":"the program's threads waited 192 ms for a CPU while they ran 240 ms, 80.0% of their run time, above the 20.0% the lens ranks under: `))
    assert(json.contains(`"cpu_run_ms":240,"cpu_wait_ms":192,`))
    // No clock was read: no flag.
    assert(json.contains(`"clock_flag":null,"clock_high_mhz":0,"clock_low_mhz":0,`))
    // The point keeps its name; no gain is given.
    assert(json.contains(`{"lines":[],"name":"round","unranked":[]}`))
    assert(!json.contains(`"gain_tenths"`))
}
