// Pure provider witnesses. Transport permission/pid/race checks need the composed
// CLI + Core native FS provider; these tests make no hosted parity claim.
use {
    jet_backend.[X64DebugEncoding, X64ImageFunction, X64Jetline, X64JetlineFunction]
    jet_cli.[
        JetCLIPerfExperiment,
        JetCLIPerfHeap,
        JetCLIPerfHeapBlock,
        JetCLIPerfHeapFrame,
        JetCLIPerfHeapObject,
        JetCLIPerfHeapPlace,
        JetCLIPerfHeapRef,
        JetCLIPerfHeapRetention,
        JetCLIPerfHeapRoot,
        JetCLIPerfHeapSite,
        JetCLIPerfHeapSnapshot,
        JetCLIPerfInlines,
        JetCLIPerfObservation,
        JetCLIPerfPlotTotal,
        JetCLIPerfRetained,
        JetCLIPerfZoneSampled,
        JetCLIPerfZoneTotal,
        jet_cli_perf_browser_decode,
        jet_cli_perf_causal_section,
        jet_cli_perf_capture_bytes,
        jet_cli_perf_capture_source,
        jet_cli_perf_heap_retain,
        jet_cli_perf_heap_retention_lines,
        jet_cli_perf_heap_types,
        jet_cli_perf_live_from,
        jet_cli_perf_log_spans_read,
        jet_cli_perf_observed,
        jet_cli_perf_samples_count,
        jet_cli_perf_samples_profile,
        jet_cli_perf_source,
        jet_cli_perf_source_position,
        jet_cli_perf_source_profile,
        jet_cli_perf_timed_first,
        jet_cli_perf_zones_section,
    ]
    jet_debug.[
        NATIVE_TAG_POINTER,
        NATIVE_TAG_STRUCT,
        NATIVE_TAG_TYPEDEF,
        NativeAbstract,
        NativeEnumerator,
        NativeFunction,
        NativeImage,
        NativeInlined,
        NativeMember,
        NativeType,
        NativeVariable,
        NativeVariableRole,
        NativeVariants,
    ]
    jet_foundation.[
        JetLiveChannel,
        JetLiveEvent,
        JetLiveGameRecord,
        JetLiveRuntime,
        JetLiveSnapshot,
        JetLiveTask,
        JetLiveValue,
        TraceHardware,
        TraceToolchain,
        canonical_json_bytes,
        sha256_hex,
        verify_jettrace,
    ]
    perf_hex: core.encoding.hex
    perf_test_files: core.files
    perf_test_process: core.process
    perf_test_sys: core.sys
}

// A decoded, process-bound live snapshot (jet_foundation's LiveSnapshot.jet
// codec is witnessed by Tests/LiveInspect.jet).
jet_cli_perf_test_snapshot: fn(task_id: Int) -> JetLiveSnapshot Never! {
    resources := [String:Int]{}
    resources["workers"] = 1
    resources["running"] = 0
    resources["queued"] = 0
    resources["canceled"] = 0
    resources["arenas"] = 1
    resources["arena_allocations"] = 2
    resources["arena_bytes"] = 64
    JetLiveSnapshot{
        protocol: "jet.live.v2",
        session_id: "session",
        source_id: "source",
        build_id: "build",
        revision: "revision",
        world_id: "world",
        pid: 12,
        start_id: "123",
        captured_ms: 100,
        values: [JetLiveValue]{JetLiveValue{value_id: "static:app.secret", type_identity: "Int", disposition: "kept", reason: "", rendered_value: Val("7")}},
        tasks: [JetLiveTask]{JetLiveTask{id: task_id, parent: 0, label: "run", spawn_site: 0, state: "blocked", wait: "tcp receive", deadline_ms: None, canceled: false, open_spans: 0, arena_allocations: 0}},
        channels: [JetLiveChannel]{JetLiveChannel{id: 2, depth: 0, capacity: Val(1), send_waiters: 0, recv_waiters: 1, closed: false}},
        effects: [String:Int]{},
        resources: resources,
        runtime: JetLiveRuntime{elapsed_ns: 50, cpu_ns: Val(25), exit: false},
        event_records: [JetLiveEvent]{},
        game_records: [JetLiveGameRecord]{},
        events: Val(""),
        boot_ns: U64{0},
        start_ticks: U64{0},
        clock_hz: 100,
    }
}

#Test("perf live view retains observations, not live value payloads") {
    live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(1))
    assert_eq(live.pid, 12)
    assert_eq(live.start_id, "123")
    assert_eq(live.tasks.len(), 1)
    assert_eq(live.tasks[0].wait, "tcp receive")
    assert_eq(live.channels[0].capacity, Val(U64{1}))
    assert_eq(live.arena_bytes, U64{64})
    assert_eq(live.runtime.elapsed_ns, U64{50})
    assert_eq(live.runtime.cpu_ns, Val(U64{25}))
}

#Test("perf source spans use one-based Unicode scalar columns") {
    at: jet_cli_perf_source_position("é\nλx", 5) ?? panic(err.message)
    assert_eq(at.line, U64{2})
    assert_eq(at.column, U64{2})
    if jet_cli_perf_source_position("é", 1) == {
        .Err(_) -> {}
        .Ok(_) -> panic("accepted mid-scalar source span")
    }
}

#Test("perf profile counts snapshots, never guessed invocations") {
    source: jet_cli_perf_source("app.jet", "run: fn() -> Int {{ 1 }}")
    profile: jet_cli_perf_source_profile(source, U64{2}, U64{1}, false) ?? panic(err.message)
    assert_eq(profile.status, "captured")
    assert_eq(profile.coverage, "partial")
    assert_eq(profile.rows.len(), 2)
    assert_eq(profile.rows[0].execution_count, None)
    assert_eq(profile.rows[0].sample_count, U64{2})
    assert_eq(profile.overhead_ns, None)
    bounded: jet_cli_perf_source_profile(source, U64{5000}, U64{4500}, false) ?? panic(err.message)
    assert_eq(bounded.status, "truncated")
    assert_eq(bounded.rows[0].sample_count, U64{4096})
    assert_eq(bounded.rows[0].sample_weight, U64{4096})
    assert_eq(bounded.rows[1].sample_count, U64{4096})
    assert_eq(bounded.rows[1].sample_weight, U64{4096})
}

#Test("perf capture keeps observed spans, locks and allocations causal, and no I/O from a wait") {
    live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(17))
    observations: [JetCLIPerfObservation]{JetCLIPerfObservation{at_ns: U64{10}, live: live}, JetCLIPerfObservation{at_ns: U64{20}, live: live}}
    capture: jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", Val(U64{30})) ?? panic(err.message)
    // A task blocked on `tcp receive` is a wait, not a transfer: the I/O rows
    // are the runtime's records of the bytes a read or write moved, and these
    // observations come with none.
    assert_eq(capture.io.len(), 0)
    assert_eq(capture.tasks[0].wait, "tcp receive")
    assert_eq(capture.locks.len(), 1)
    assert_eq(capture.allocations[0].bytes, U64{64})
    assert_eq(capture.tasks[0].id, U64{1})
    assert_eq(capture.spans[0].start_ns, Val(U64{10}))
    assert_eq(capture.spans[0].end_ns, Val(U64{20}))
    // A run's wall is the session's, on the observations' clock, so every span
    // and native observation ends inside it; the runtime's own elapsed time is
    // the run window.
    assert_eq(capture.samples[0].domain, "wall")
    assert_eq(capture.samples[0].duration_ns, U64{30})
    assert_eq(capture.native[0].observed_at_ns, U64{20})
    assert_eq(capture.profile.window_wall_ns, Val(U64{50}))
    attached: jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    assert_eq(attached.samples[0].duration_ns, U64{50})
    toolchain: TraceToolchain{jet_version: "test", compiler_build_id: "test", stdlib_id: "test", runner_id: "test"}
    hardware: TraceHardware{cpu_arch: "x86_64", logical_cpus: U64{1}, os: "linux", target: "x86_64-unknown-linux-gnu"}
    bytes: jet_cli_perf_capture_bytes(capture, "run", [String]{"app.jet"}, toolchain, hardware) ?? panic(err.message)
    _: verify_jettrace(bytes) ?? panic(err.message)
}

#Test("perf observations of a run sit on its own clock, from its start") {
    early: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(17))
    late := jet_cli_perf_live_from(jet_cli_perf_test_snapshot(17))
    late.runtime.elapsed_ns = U64{900}
    observations: [JetCLIPerfObservation]{jet_cli_perf_observed(early), jet_cli_perf_observed(late)}
    capture: jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", Val(U64{5000})) ?? panic(err.message)
    assert_eq(capture.spans[0].kind, "task_observed")
    assert_eq(capture.spans[0].start_ns, Val(U64{50}))
    assert_eq(capture.spans[0].end_ns, Val(U64{900}))
    assert_eq(capture.native[0].observed_at_ns, U64{900})
}

#Test("perf capture without observations keeps the source and records no samples") {
    capture: jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", [JetCLIPerfObservation]{}, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    assert_eq(capture.source_maps.len(), 1)
    assert_eq(capture.profile.status, "no_samples")
    assert_eq(capture.profile.window_status, "unavailable")
    assert_eq(capture.tasks.len(), 0)
}

#Test("perf observations refuse mixed process revisions") {
    live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(1))
    other := live
    other.revision = "different"
    observations: [JetCLIPerfObservation]{JetCLIPerfObservation{at_ns: U64{10}, live: live}, JetCLIPerfObservation{at_ns: U64{20}, live: other}}
    if jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "test", None) == {
        .Err(_) -> {}
        .Ok(_) -> panic("accepted mixed observation revisions")
    }
}

#Test("perf browser decode uses compiler source carrier and refuses unknown symbols") {
    digest: sha256_hex("run: fn() -> Int {{ 1 }}")
    table: "source\t{perf_hex.encode("app.jet".bytes())}\t{digest}\nsymbol\t{perf_hex.encode("app.jet".bytes())}\t{perf_hex.encode("run".bytes())}\tfn\n"
    header: "{{\"schema\":\"jet.status/v1\",\"action\":\"browser.relay\",\"ok\":true,\"reports\":[],\"nonce\":\"n\",\"pid\":12,\"started\":\"123\",\"sources\":\"{perf_hex.encode(table.bytes())}\"}}"
    row: "{{\"schema\":\"jet.status/v1\",\"action\":\"browser.relay.row\",\"ok\":true,\"reports\":[],\"class\":\"wasm\",\"duration_ns\":4,\"start_ns\":5,\"symbol\":\"run\"}}"
    capture: jet_cli_perf_browser_decode("{header}\n{row}\n", 12, "123") ?? panic(err.message)
    assert_eq(capture.rows[0].symbol.path, "app.jet")
    assert_eq(capture.rows[0].duration_ns, U64{4})
    invalid: "{header}\n{row.replace("\"symbol\":\"run\"", "\"symbol\":\"missing\"")}\n"
    if jet_cli_perf_browser_decode(invalid, 12, "123") == {
        .Err(_) -> {}
        .Ok(_) -> panic("accepted un-attributed browser observation")
    }
}

// Little-endian 8-byte words, as the runtime's sample records are.
jet_cli_perf_test_words: fn(values: [Int]) -> [U8] Never! {
    bytes := [U8]{}
    loop value in values {
        loop shift in 0..<8 -> bytes.push(U8{(value >> (8 * shift)) & 255})
    }
    bytes
}

#Test("perf samples charge compiler helpers to the calling line and read what sampling cost") {
    // fib's code at 0x1000, its one row at its declaration's line 5; the
    // stop poll and a runtime function beside it in the symbol table.
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}, X64ImageFunction{start: 8192, size: 512, name: "jet_ir_stop_turn"}, X64ImageFunction{start: 12288, size: 16, name: "jet_rt_alloc"}}
    one: 1 << 48
    two: 2 << 48
    four: 4 << 48
    words: jet_cli_perf_test_words(
        [Int]{
            // In the stop poll fib called from 0x1040: fib's line.
            8208 | two,
            4160,
            // In the runtime: outside, by its symbol.
            12292 | one,
            // In fib with no stack.
            4112 | one,
            // The clock record: 4 ms of CPU sampled, 6 microseconds in the
            // handlers, 1 microsecond for each signal's delivery.
            (13 << 59) | four,
            4000000,
            6000,
            1000,
        },
    )
    sampled: jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.total, U64{3})
    assert_eq(sampled.outside, U64{1})
    assert_eq(sampled.helpers, U64{1})
    assert_eq(sampled.stackless, U64{1})
    assert_eq(sampled.signals, U64{3})
    assert_eq(sampled.lines[0].line, 5)
    assert_eq(sampled.lines[0].count, U64{2})
    assert_eq(sampled.lines[0].inclusive, U64{2})
    assert_eq(sampled.natives.len(), 1)
    assert_eq(sampled.functions[sampled.natives[0].function].name, "jet_rt_alloc")
    text: "\n\n\n\nfib: fn(n: Int) -> Int {{ n }}\n"
    profile: jet_cli_perf_samples_profile(jet_cli_perf_source("fib.jet", text), sampled) ?? panic("fib's line holds samples")
    assert(profile.reason.contains("; 1 of 3 samples are outside fib.jet; outside Jet functions: jet_rt_alloc 1; 1 samples in compiler-emitted helpers, such as stop polls, count at the line that called them"))
    assert(profile.reason.contains("; 1 samples in Jet code kept no stack"))
    assert(profile.reason.contains("; 3 of the 4 samples 4 ms of CPU time under sampling gives"))
    assert(!profile.reason.contains("jet_ir_"))
    assert_eq(profile.overhead_status, "measured")
    assert_eq(profile.overhead_ns, Val(U64{9000}))
    assert_eq(profile.overhead_reason, "the sampler took 9 microseconds, 0.22% of the 4000 microseconds of CPU time sampled: 6 in its handlers and 3 signals at the 1000 nanoseconds the kernel took to deliver and return from one as sampling started")
}

#Test("a CPU-time sample's record ends in its time and task, and a zone of that task holds the samples inside it") {
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}, X64ImageFunction{start: 12288, size: 16, name: "jet_rt_alloc"}}
    two: 2 << 48
    three: 3 << 48
    four: 4 << 48
    words: jet_cli_perf_test_words(
        [Int]{
            // In fib called from fib, at 2000 ns, of task 7.
            4112 | four,
            4160,
            2000,
            7,
            // In fib with no stack, at 1000 ns, of task 7.
            4112 | three,
            1000,
            7,
            // In the runtime at 1500 ns: no line of the source.
            12292 | three,
            1500,
            7,
            // In fib at 5000 ns, of task 9.
            4112 | three,
            5000,
            9,
            // Two words and no more: a program counter and a caller, untimed.
            4112 | two,
            4160,
        },
    )
    sampled: jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.total, U64{5})
    assert_eq(sampled.stackless, U64{2})
    assert_eq(sampled.outside, U64{1})
    assert_eq(sampled.timed.len(), 4)
    assert_eq(sampled.timed[0].at_ns, 1000)
    assert_eq(sampled.timed[0].line, 5)
    assert_eq(sampled.timed[1].at_ns, 1500)
    assert_eq(sampled.timed[1].line, 0)
    assert_eq(sampled.timed[2].at_ns, 2000)
    assert_eq(sampled.timed[2].task, 7)
    assert_eq(sampled.timed[3].task, 9)
    assert_eq(jet_cli_perf_timed_first(sampled.timed, 0), 0)
    assert_eq(jet_cli_perf_timed_first(sampled.timed, 1500), 1)
    assert_eq(jet_cli_perf_timed_first(sampled.timed, 1501), 2)
    assert_eq(jet_cli_perf_timed_first(sampled.timed, 9000), 4)
    zone: JetCLIPerfZoneTotal{name: "solve", count: 1, total: 3000, longest: 3000, samples: 3, lines: [Int:Int]{5: 2}}
    section: jet_cli_perf_zones_section([JetCLIPerfZoneTotal]{zone}, [Int]{}, [JetCLIPerfPlotTotal]{}, [JetCLIPerfZoneSampled]{JetCLIPerfZoneSampled{name: "solve", start_ns: U64{0}, end_ns: U64{3000}, samples: 3, line: 5}}, "fib.jet", "")
    json: String.from_bytes(canonical_json_bytes(section.value)) ?? panic("the section is UTF-8")
    assert(json.contains(`"sampled":[{"end_ns":3000,"line":5,"name":"solve","samples":3,"start_ns":0}]`))
    assert(json.contains(`"source":"fib.jet"`))
    assert(json.contains(`{"count":1,"lines":[{"line":5,"samples":2}],"longest_ns":3000,"name":"solve","samples":3,"total_ns":3000}`))
}

// The runtime times zones, waits and log spans from the process epoch, its
// first monotonic read (time_host_monotonic_i64), which the first zone's
// open may be: a run's first zone opens 1293 ns after it. Each CPU-time
// sample is stamped on that clock too, -1 before the epoch is set.
#Test("a zone holds the CPU-time samples its task took inside it, both timed from the process epoch") {
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}}
    three: 3 << 48
    words: jet_cli_perf_test_words(
        [Int]{
            // Before the epoch was set: in no zone.
            4112 | three,
            -1,
            7,
            // Inside solve, of solve's task 7.
            4112 | three,
            1500,
            7,
            4112 | three,
            4000,
            7,
            // Inside solve's time, of task 9.
            4112 | three,
            2000,
            9,
            // At solve's end, so past it.
            4112 | three,
            4293,
            7,
        },
    )
    sampled: jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.timed.len(), 5)
    // solve's row of the spans file, as perf_zone_row writes it.
    row := jet_cli_perf_test_words([Int]{1293, 4293, 7, 5 | (1 << 32)})
    row.extend("solve".bytes())
    path: "{perf_test_sys.temp_dir()}/jet-perf-zone-clock-{perf_test_process.current_pid()}.spans"
    perf_test_files.write_bytes(path, row) ?? panic("the spans file: {err}")
    capture := jet_cli_perf_capture_source("fib.jet", "fib: fn() -> Int {{ 1 }}", [JetCLIPerfObservation]{}, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    jet_cli_perf_log_spans_read(capture, path, "fib.jet", 0, sampled.timed)
    assert(!perf_test_files.exists(path))
    assert_eq(capture.spans[capture.spans.len() - 1].start_ns, Val(U64{1293}))
    json: String.from_bytes(canonical_json_bytes(capture.receipts[capture.receipts.len() - 1].value)) ?? panic("the section is UTF-8")
    assert(json.contains(`"sampled":[{"end_ns":4293,"line":5,"name":"solve","samples":2,"start_ns":1293}]`))
    assert(json.contains(`{"count":1,"lines":[{"line":5,"samples":2}],"longest_ns":3000,"name":"solve","samples":2,"total_ns":3000}`))
}

#Test("a heap snapshot's blocks count by their line and by the type their innermost typed allocating call names") {
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    words: jet_cli_perf_test_words(
        [Int]{
            // Snapshot 1, `exit`: 3 blocks, 112 bytes, its 4-byte name.
            1 | (5 << 48) | (10 << 59),
            3,
            112,
            4,
            0x74697865,
            // 2 blocks of 96 bytes the runtime allocated for fib's typed call
            // returning to 12300, which fib's line 5 made.
            1 | (5 << 48) | (9 << 59),
            2,
            96,
            12300,
            4160,
            // 1 block of 16 bytes an untyped call at the same line allocated.
            1 | (4 << 48) | (9 << 59),
            1,
            16,
            4170,
        },
    )
    allocs: [Int:Int]{12300: 77}
    names: [Int:String]{77: "[I64]"}
    sampled: jet_cli_perf_samples_count(table, [X64ImageFunction]{}, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, allocs, names, words, 0)
    assert_eq(sampled.heaps.len(), 1)
    heap: sampled.heaps[0]
    assert_eq(heap.name, "exit")
    assert_eq(heap.sites.len(), 2)
    assert_eq(heap.sites[0].type_name, "[I64]")
    assert_eq(heap.sites[0].line, U64{5})
    assert_eq(heap.sites[0].bytes, U64{96})
    assert_eq(heap.sites[1].type_name, "")
    assert_eq(heap.sites[1].line, U64{5})
    assert_eq(heap.sites[1].blocks, U64{1})
}

#Test("a heap snapshot's typed blocks are retained along the shortest path from a root, named by its variable and its types' fields") {
    word: NativeType{name: "Int", size: 8, tag: 0x24, encoding: X64DebugEncoding.Signed, target: -1, group: -1}
    types: [Int:NativeType]{
        100: word,
        // struct Room {id: Int, history: [Message]}, and the lists.
        10: NativeType{name: "Room", size: 32, tag: NATIVE_TAG_STRUCT, encoding: X64DebugEncoding.Unsigned, target: -1, group: 0},
        20: NativeType{name: "[Message]", size: 24, tag: NATIVE_TAG_STRUCT, encoding: X64DebugEncoding.Unsigned, target: -1, group: -1},
        40: NativeType{name: "[Room]", size: 24, tag: NATIVE_TAG_STRUCT, encoding: X64DebugEncoding.Unsigned, target: -1, group: -1},
        80: NativeType{name: "Message", size: 16, tag: NATIVE_TAG_STRUCT, encoding: X64DebugEncoding.Unsigned, target: -1, group: 1},
        // What the typed allocating calls allocate for: a list's buffer of
        // rooms, one of messages.
        50: NativeType{name: "[Room]", size: 0, tag: NATIVE_TAG_TYPEDEF, encoding: X64DebugEncoding.Unsigned, target: 51, group: -1},
        51: NativeType{name: "", size: 8, tag: NATIVE_TAG_POINTER, encoding: X64DebugEncoding.Unsigned, target: 10, group: -1},
        70: NativeType{name: "[Message]", size: 0, tag: NATIVE_TAG_TYPEDEF, encoding: X64DebugEncoding.Unsigned, target: 71, group: -1},
        71: NativeType{name: "", size: 8, tag: NATIVE_TAG_POINTER, encoding: X64DebugEncoding.Unsigned, target: 80, group: -1},
    }
    members: [[NativeMember]]{
        [NativeMember]{NativeMember{name: "id", offset: 0, ty: 100, die: 0}, NativeMember{name: "history", offset: 8, ty: 20, die: 0}},
        [NativeMember]{NativeMember{name: "id", offset: 0, ty: 100, die: 0}, NativeMember{name: "body", offset: 8, ty: 100, die: 0}},
    }
    // `rooms` lives at rbp-16 over [4096, 4352): DW_LLE_offset_pair 0, 256,
    // then DW_OP_fbreg -16.
    rooms: NativeVariable{name: "rooms", line: 3, ty: 40, list: 0, base: 4096, role: NativeVariableRole.Local, site: -1}
    facts: NativeImage{lines: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, functions: [NativeFunction]{NativeFunction{low: 4096, high: 4352, name: "serve", file: -1, variables: [NativeVariable]{rooms}, inlined: [NativeInlined]{}}}, types: types, members: members, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: [U8]{0x04, 0x00, 0x80, 0x02, 0x02, 0x91, 0x70, 0x00}, abstracts: [Int:NativeAbstract]{}, allocs: [Int:Int]{}}
    heap := JetCLIPerfHeap{
        number: U64{1},
        name: "exit",
        blocks: U64{3},
        bytes: U64{192},
        sites: [JetCLIPerfHeapSite]{},
        groups: [Int]{50, 70},
        live: [JetCLIPerfHeapBlock]{
            // The rooms' buffer: room 1's history's buffer pointer, at
            // 32 + 8 + 16.
            JetCLIPerfHeapBlock{address: 0x10000, size: 96, group: 1, refs: [JetCLIPerfHeapRef]{JetCLIPerfHeapRef{offset: 56, target: 0x20000}}},
            JetCLIPerfHeapBlock{address: 0x20000, size: 48, group: 2, refs: [JetCLIPerfHeapRef]{}},
            // Messages no root reaches.
            JetCLIPerfHeapBlock{address: 0x30000, size: 48, group: 2, refs: [JetCLIPerfHeapRef]{}},
        },
        frames: [JetCLIPerfHeapFrame]{JetCLIPerfHeapFrame{pc: 4100, base: 0x7000, low: 0x6f00}},
        roots: [JetCLIPerfHeapRoot]{JetCLIPerfHeapRoot{address: 0x6ff0, target: 0x10000, data: false}},
        retained: [JetCLIPerfRetained]{},
    }
    jet_cli_perf_heap_retain(facts, [JetCLIPerfHeapObject]{}, [Int:String]{50: "[Room]", 70: "[Message]"}, heap)
    assert_eq(heap.live.len(), 0)
    assert_eq(heap.retained.len(), 3)
    assert_eq(heap.retained[0].type_name, "[Message]")
    assert_eq(heap.retained[0].path, "rooms[1].history")
    assert_eq(heap.retained[0].bytes, U64{48})
    assert_eq(heap.retained[1].type_name, "[Message]")
    assert_eq(heap.retained[1].path, "")
    assert_eq(heap.retained[2].type_name, "[Room]")
    assert_eq(heap.retained[2].path, "rooms")
    assert_eq(heap.retained[2].blocks, U64{1})
}

#Test("`--retained-by` names a type by its whole name or its last part, and lists the paths that retain it") {
    retained: [JetCLIPerfHeapRetention]{
        JetCLIPerfHeapRetention{type_name: "chat.Message", path: "rooms[1].history", blocks: 2, bytes: 64},
        JetCLIPerfHeapRetention{type_name: "chat.Message", path: "", blocks: 1, bytes: 32},
        JetCLIPerfHeapRetention{type_name: "Room", path: "rooms", blocks: 1, bytes: 96},
    }
    snapshots: [JetCLIPerfHeapSnapshot]{JetCLIPerfHeapSnapshot{name: "exit", blocks: 4, bytes: 192, places: [JetCLIPerfHeapPlace]{}, retained: retained}}
    assert_eq(jet_cli_perf_heap_retention_lines(snapshots, "Message"), [String]{"retained chat.Message at exit  3 blocks  96 bytes", "  rooms[1].history  2 blocks  64 bytes", "  no root reached (another thread's stack or a register holds them)  1 blocks  32 bytes"})
    assert_eq(jet_cli_perf_heap_retention_lines(snapshots, "chat.Message").len(), 3)
    assert_eq(jet_cli_perf_heap_retention_lines(snapshots, "Ring").len(), 0)
    assert_eq(jet_cli_perf_heap_types(snapshots), "; they keep Room, chat.Message")
}

#Test("perf samples in inlined code count at the inlined line and inclusive at the call") {
    // run's code at 0x1000: its rows give line 6 at 0x1000 (sum_squares's
    // body, inlined), 14 at 0x1040, 3 at 0x1080 (max's body, inlined from
    // file 2) and 15 at 0x1090.
    rows: [U8]{0, 5, 64, 8, 64, 117, 16, 12}
    table: X64Jetline{table: rows, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "run", file: "prog.jet", dir: "", decl: 10, rows: 0, rows_end: 8}}}
    runs: [NativeInlined]{
        NativeInlined{die: 10, origin: 1, low: 4096, high: 4160, call_line: 14, parent: -1, file: 1, call_file: 1},
        NativeInlined{die: 20, origin: 2, low: 4224, high: 4240, call_line: 15, parent: -1, file: 2, call_file: 1},
    }
    inlines: JetCLIPerfInlines{functions: [Int:NativeFunction]{4096: NativeFunction{low: 4096, high: 4352, name: "run", file: 1, variables: [NativeVariable]{}, inlined: runs}}, abstracts: [Int:NativeAbstract]{1: NativeAbstract{name: "sum_squares", file: 1}, 2: NativeAbstract{name: "max", file: 2}}}
    one: 1 << 48
    two: 2 << 48
    words: jet_cli_perf_test_words(
        [Int]{
            // In sum_squares's inlined body.
            4112 | one,
            // In max's, from another file.
            4228 | one,
            // At run's line 14, called from the call that returns to
            // 0x1010, inside sum_squares's run.
            4176 | two,
            4112,
        },
    )
    sampled: jet_cli_perf_samples_count(table, [X64ImageFunction]{}, inlines, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.total, U64{3})
    text := ""
    loop _ in 0..<16 -> text = "{text}line\n"
    profile: jet_cli_perf_samples_profile(jet_cli_perf_source("prog.jet", text), sampled) ?? panic("run's lines hold samples")
    found := 0
    loop row in profile.rows {
        line: row.source.start_line
        if line == (U64{6}) {
            assert_eq(row.symbol.name, "sum_squares")
            assert_eq(row.sample_count, U64{1})
            assert_eq(row.inclusive_count, Val(U64{2}))
            found += 1
        }
        if line == (U64{14}) {
            assert_eq(row.symbol.name, "run")
            assert_eq(row.sample_count, U64{1})
            assert_eq(row.inclusive_count, Val(U64{2}))
            found += 1
        }
        if line == (U64{15}) {
            assert_eq(row.symbol.name, "run")
            assert_eq(row.sample_count, U64{0})
            assert_eq(row.inclusive_count, Val(U64{1}))
            found += 1
        }
        // max's line 3 is in its own file, not prog.jet.
        assert(line != (U64{3}))
    }
    assert_eq(found, 3)
    assert(profile.reason.contains("; 1 of 3 samples are outside prog.jet"))
}

#Test("a causal rate counts each experiment's passes after its first over the time from its first pass to its last, less the delay inserted meanwhile") {
    experiments := [JetCLIPerfExperiment]{}
    // Baselines: 4 passes after the first in 20 ms, a pass each 5 ms. The
    // line's experiments: 4 in 22 ms with 6 ms of it inserted delay, a pass
    // each 4 ms, 20% sooner.
    loop _ in 0..<6 {
        experiments.push(JetCLIPerfExperiment{line: U64{0}, name: "", speedup: 0, after: [Int]{4}, span_ns: [Int]{20000000}, span_delay_ns: [Int]{0}})
        experiments.push(JetCLIPerfExperiment{line: U64{30}, name: "narrow", speedup: 300, after: [Int]{4}, span_ns: [Int]{22000000}, span_delay_ns: [Int]{6000000}})
    }
    section: jet_cli_perf_causal_section("main.jet", experiments, [Int:String]{0: "round"})
    json: String.from_bytes(canonical_json_bytes(section.value)) ?? panic("the section is UTF-8")
    assert(json.contains(`{"experiments":6,"function":"narrow","gain_tenths":200,"high_tenths":200,"line":30,"low_tenths":200}`))
    assert(json.contains(`"refused":null`))
}
