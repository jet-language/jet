// A decoded, process-bound live snapshot (jet_foundation's LiveSnapshot.jet
// codec is witnessed by Tests/LiveInspect.jet).
jet_cli_perf_test_snapshot: fn(task_id: Int) -> JetLiveSnapshot Never! {
    resources := [String:Int]{}
    resources["workers"] = 1
    resources["running"] = 0
    resources["queued"] = 0
    resources["canceled"] = 0
    resources["arenas"] = 1
    resources["arena_allocations"] = 2
    resources["arena_bytes"] = 64
    JetLiveSnapshot{
        protocol: "jet.live.v2",
        session_id: "session",
        source_id: "source",
        build_id: "build",
        revision: "revision",
        world_id: "world",
        pid: 12,
        start_id: "123",
        captured_ms: 100,
        values: [JetLiveValue]{JetLiveValue{value_id: "static:app.secret", type_identity: "Int", disposition: "kept", reason: "", rendered_value: Val("7")}},
        tasks: [JetLiveTask]{JetLiveTask{id: task_id, parent: 0, label: "run", spawn_site: 0, state: "blocked", wait: "tcp receive", deadline_ms: None, canceled: false, open_spans: 0, arena_allocations: 0}},
        channels: [JetLiveChannel]{JetLiveChannel{id: 2, depth: 0, capacity: Val(1), send_waiters: 0, recv_waiters: 1, closed: false}},
        effects: [String:Int]{},
        resources: resources,
        runtime: JetLiveRuntime{elapsed_ns: 50, cpu_ns: Val(25), exit: false},
        event_records: [JetLiveEvent]{},
        game_records: [JetLiveGameRecord]{},
        events: Val(""),
        boot_ns: U64{0},
        start_ticks: U64{0},
        clock_hz: 100,
    }
}

#Test("perf live view retains observations, not live value payloads") {
    live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(1))
    assert_eq(live.pid, 12)
    assert_eq(live.start_id, "123")
    assert_eq(live.tasks.len(), 1)
    assert_eq(live.tasks[0].wait, "tcp receive")
    assert_eq(live.channels[0].capacity, Val(U64{1}))
    assert_eq(live.arena_bytes, U64{64})
    assert_eq(live.runtime.elapsed_ns, U64{50})
    assert_eq(live.runtime.cpu_ns, Val(U64{25}))
}

#Test("perf source spans use one-based Unicode scalar columns") {
    at: jet_cli_perf_source_position("é\nλx", 5) ?? panic(err.message)
    assert_eq(at.line, U64{2})
    assert_eq(at.column, U64{2})
    if jet_cli_perf_source_position("é", 1) == {
        .Err(_) -> {}
        .Ok(_) -> panic("accepted mid-scalar source span")
    }
}

#Test("perf profile counts snapshots, never guessed invocations") {
    source: jet_cli_perf_source("app.jet", "run: fn() -> Int {{ 1 }}")
    profile: jet_cli_perf_source_profile(source, U64{2}, U64{1}, false) ?? panic(err.message)
    assert_eq(profile.status, "captured")
    assert_eq(profile.coverage, "partial")
    // The CPU row, then the wall row, as a sampled profile ends in it.
    assert_eq(profile.rows.len(), 2)
    assert_eq(profile.rows[0].clock, "cpu")
    assert_eq(profile.rows[0].execution_count, None)
    assert_eq(profile.rows[0].sample_count, U64{1})
    assert_eq(profile.rows[1].clock, "wall")
    assert_eq(profile.rows[1].sample_count, U64{2})
    assert_eq(profile.overhead_ns, None)
    bounded: jet_cli_perf_source_profile(source, U64{5000}, U64{4500}, false) ?? panic(err.message)
    assert_eq(bounded.status, "truncated")
    assert_eq(bounded.rows[0].sample_count, U64{4096})
    assert_eq(bounded.rows[0].sample_weight, U64{4096})
    assert_eq(bounded.rows[1].sample_count, U64{4096})
    assert_eq(bounded.rows[1].sample_weight, U64{4096})
}

#Test("perf capture keeps observed spans, locks and allocations causal, and no I/O from a wait") {
    live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(17))
    observations: [JetCLIPerfObservation]{JetCLIPerfObservation{at_ns: U64{10}, live: live}, JetCLIPerfObservation{at_ns: U64{20}, live: live}}
    capture: jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", Val(U64{30})) ?? panic(err.message)
    // A task blocked on `tcp receive` is a wait, not a transfer: the I/O rows
    // are the runtime's records of the bytes a read or write moved, and these
    // observations come with none.
    assert_eq(capture.io.len(), 0)
    assert_eq(capture.tasks[0].wait, "tcp receive")
    assert_eq(capture.locks.len(), 1)
    assert_eq(capture.allocations[0].bytes, U64{64})
    assert_eq(capture.tasks[0].id, U64{1})
    assert_eq(capture.spans[0].start_ns, Val(U64{10}))
    assert_eq(capture.spans[0].end_ns, Val(U64{20}))
    // A run's wall is the session's, on the observations' clock, so every span
    // and native observation ends inside it; the runtime's own elapsed time is
    // the run window.
    assert_eq(capture.samples[0].domain, "wall")
    assert_eq(capture.samples[0].duration_ns, U64{30})
    assert_eq(capture.native[0].observed_at_ns, U64{20})
    assert_eq(capture.profile.window_wall_ns, Val(U64{50}))
    attached: jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    assert_eq(attached.samples[0].duration_ns, U64{50})
    toolchain: TraceToolchain{jet_version: "test", compiler_build_id: "test", stdlib_id: "test", runner_id: "test"}
    hardware: TraceHardware{cpu_arch: "x86_64", logical_cpus: U64{1}, os: "linux", target: "x86_64-unknown-linux-gnu"}
    bytes: jet_cli_perf_capture_bytes(capture, "run", [String]{"app.jet"}, toolchain, hardware) ?? panic(err.message)
    _: verify_jettrace(bytes) ?? panic(err.message)
}

#Test("an attach's window counts each thread's CPU in it, names the threads that exited, and its header names a tick resolution") {
    opened := [Int:U64]{}
    opened[1] = U64{1000}
    opened[2] = U64{500}
    opened[3] = U64{700}
    // Thread 1 ran 600 ns more, thread 2 slept, thread 3 exited and thread 4
    // started in the window.
    shut := [Int:U64]{}
    shut[1] = U64{1600}
    shut[2] = U64{500}
    shut[4] = U64{300}
    first: JetCLIPerfAttachCPU{ns: U64{2200}, resolution_ns: U64{1}, threads: opened}
    last: JetCLIPerfAttachCPU{ns: U64{2400}, resolution_ns: U64{1}, threads: shut}
    precise: jet_cli_perf_attach_closed(U64{5000}, Val(first), Val(last))
    assert_eq(precise.window.elapsed_ns, U64{5000})
    assert_eq(precise.window.cpu_ns, Val(U64{900}))
    assert_eq(precise.resolution_ns, Val(U64{1}))
    assert_eq(precise.exited, 1)
    early: JetCLIPerfAttachCPU{ns: U64{20000000}, resolution_ns: U64{10000000}, threads: [Int:U64]{}}
    late: JetCLIPerfAttachCPU{ns: U64{50000000}, resolution_ns: U64{10000000}, threads: [Int:U64]{}}
    ticked: jet_cli_perf_attach_closed(U64{5000}, Val(early), Val(late))
    assert_eq(ticked.window.cpu_ns, Val(U64{30000000}))
    assert_eq(ticked.resolution_ns, Val(U64{10000000}))
    // Ends counted differently, or an end with no CPU, give the window none.
    assert_eq(jet_cli_perf_attach_closed(U64{5000}, Val(first), Val(late)).window.cpu_ns, None)
    assert_eq(jet_cli_perf_attach_closed(U64{5000}, None, Val(late)).window.cpu_ns, None)
    live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(17))
    observations: [JetCLIPerfObservation]{JetCLIPerfObservation{at_ns: U64{0}, live: live}}
    toolchain: TraceToolchain{jet_version: "test", compiler_build_id: "test", stdlib_id: "test", runner_id: "test"}
    hardware: TraceHardware{cpu_arch: "x86_64", logical_cpus: U64{1}, os: "linux", target: "x86_64-unknown-linux-gnu"}
    exact := jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    jet_cli_perf_attach_keep_window(exact, 7, precise, [String]{"its live snapshot", "its flight ring"})
    assert(exact.profile.window_reason.contains("from its first read of the program to its last (its live snapshot, its flight ring)"))
    assert(exact.profile.window_reason.contains("less that of the threads that exited in it (1)"))
    exact_trace: verify_jettrace(jet_cli_perf_capture_bytes(exact, "attach", [String]{"attach", "7"}, toolchain, hardware) ?? panic(err.message)) ?? panic(err.message)
    assert((jet_cli_perf_profile_summary(exact_trace) ?? "").ends_with(" window=live run_wall=5000ns run_cpu=900ns"))
    coarse := jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    jet_cli_perf_attach_keep_window(coarse, 7, ticked, [String]{"its live snapshot"})
    coarse_trace: verify_jettrace(jet_cli_perf_capture_bytes(coarse, "attach", [String]{"attach", "7"}, toolchain, hardware) ?? panic(err.message)) ?? panic(err.message)
    assert((jet_cli_perf_profile_summary(coarse_trace) ?? "").ends_with(" window=live run_wall=5000ns run_cpu=30000000ns run_cpu_resolution=10ms"))
}

#Test("a zones attach's run window is the program's zones window, its wall and its process's CPU in it") {
    zoned: jet_cli_perf_attach_zoned(512000000, U64{300000000})
    assert_eq(zoned.window.elapsed_ns, U64{512000000})
    assert_eq(zoned.window.cpu_ns, Val(U64{300000000}))
    assert_eq(zoned.resolution_ns, Val(U64{1}))
    live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(17))
    observations: [JetCLIPerfObservation]{JetCLIPerfObservation{at_ns: U64{0}, live: live}}
    toolchain: TraceToolchain{jet_version: "test", compiler_build_id: "test", stdlib_id: "test", runner_id: "test"}
    hardware: TraceHardware{cpu_arch: "x86_64", logical_cpus: U64{1}, os: "linux", target: "x86_64-unknown-linux-gnu"}
    capture := jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    jet_cli_perf_attach_keep_window(capture, 7, zoned, [String]{"its live snapshot", "its zones for 500 ms", "its records in the zones window"})
    assert(capture.profile.window_reason.starts_with("the zones window process 7 sampled in, from its opening to its close"), capture.profile.window_reason)
    assert(capture.profile.window_reason.contains("its process's CPU-time clock in it, to the nanosecond"), capture.profile.window_reason)
    trace: verify_jettrace(jet_cli_perf_capture_bytes(capture, "attach", [String]{"attach", "7"}, toolchain, hardware) ?? panic(err.message)) ?? panic(err.message)
    assert((jet_cli_perf_profile_summary(trace) ?? "").ends_with(" window=live run_wall=512000000ns run_cpu=300000000ns"))
}

#Test("perf observations of a run sit on its own clock, from its start") {
    early: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(17))
    late := jet_cli_perf_live_from(jet_cli_perf_test_snapshot(17))
    late.runtime.elapsed_ns = U64{900}
    observations: [JetCLIPerfObservation]{jet_cli_perf_observed(early), jet_cli_perf_observed(late)}
    capture: jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", Val(U64{5000})) ?? panic(err.message)
    assert_eq(capture.spans[0].kind, "task_observed")
    assert_eq(capture.spans[0].start_ns, Val(U64{50}))
    assert_eq(capture.spans[0].end_ns, Val(U64{900}))
    assert_eq(capture.native[0].observed_at_ns, U64{900})
}

#Test("perf capture without observations keeps the source and records no samples") {
    capture: jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", [JetCLIPerfObservation]{}, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    assert_eq(capture.source_maps.len(), 1)
    assert_eq(capture.profile.status, "no_samples")
    assert_eq(capture.profile.window_status, "unavailable")
    assert_eq(capture.tasks.len(), 0)
}

#Test("perf observations refuse mixed process revisions") {
    live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(1))
    other := live
    other.revision = "different"
    observations: [JetCLIPerfObservation]{JetCLIPerfObservation{at_ns: U64{10}, live: live}, JetCLIPerfObservation{at_ns: U64{20}, live: other}}
    if jet_cli_perf_capture_source("app.jet", "run: fn() -> Int {{ 1 }}", observations, None, "test", None) == {
        .Err(_) -> {}
        .Ok(_) -> panic("accepted mixed observation revisions")
    }
}

#Test("perf browser decode uses compiler source carrier and refuses unknown symbols") {
    digest: sha256_hex("run: fn() -> Int {{ 1 }}")
    table: "source\t{perf_hex.encode("app.jet".bytes())}\t{digest}\nsymbol\t{perf_hex.encode("app.jet".bytes())}\t{perf_hex.encode("run".bytes())}\tfn\n"
    header: "{{\"schema\":\"jet.status/v1\",\"action\":\"browser.relay\",\"ok\":true,\"reports\":[],\"nonce\":\"n\",\"pid\":12,\"started\":\"123\",\"sources\":\"{perf_hex.encode(table.bytes())}\"}}"
    row: "{{\"schema\":\"jet.status/v1\",\"action\":\"browser.relay.row\",\"ok\":true,\"reports\":[],\"class\":\"wasm\",\"duration_ns\":4,\"start_ns\":5,\"symbol\":\"run\"}}"
    capture: jet_cli_perf_browser_decode("{header}\n{row}\n", 12, "123") ?? panic(err.message)
    assert_eq(capture.rows[0].symbol.path, "app.jet")
    assert_eq(capture.rows[0].duration_ns, U64{4})
    invalid: "{header}\n{row.replace("\"symbol\":\"run\"", "\"symbol\":\"missing\"")}\n"
    if jet_cli_perf_browser_decode(invalid, 12, "123") == {
        .Err(_) -> {}
        .Ok(_) -> panic("accepted un-attributed browser observation")
    }
}

// Little-endian 8-byte words, as the runtime's sample records are.
jet_cli_perf_test_words: fn(values: [Int]) -> [U8] Never! {
    bytes := [U8]{}
    loop value in values {
        loop shift in 0..<8 -> bytes.push(U8{(value >> (8 * shift)) & 255})
    }
    bytes
}

#Test("perf samples charge compiler helpers to the calling line and read what sampling cost") {
    // fib's code at 0x1000, its one row at its declaration's line 5; the
    // stop poll and a runtime function beside it in the symbol table.
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}, X64ImageFunction{start: 8192, size: 512, name: "jet_ir_stop_turn"}, X64ImageFunction{start: 12288, size: 16, name: "jet_rt_alloc"}}
    one: 1 << 48
    two: 2 << 48
    words: jet_cli_perf_test_words(
        [Int]{
            // In the stop poll fib called from 0x1040: fib's line.
            8208 | two,
            4160,
            // In the runtime: outside, by its symbol.
            12292 | one,
            // In fib with no stack.
            4112 | one,
            // The clock record: 4 ms of CPU sampled, 6 microseconds in the
            // handlers, 1 microsecond for each signal's delivery, and no
            // allocations, lost records or rings.
            (13 << 59) | (11 << 48),
            4000000,
            6000,
            1000,
            0,
            0,
            0,
            0,
            0,
            0,
            0,
        },
    )
    sampled: jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.total, U64{3})
    assert_eq(sampled.outside, U64{1})
    assert_eq(sampled.helpers, U64{1})
    assert_eq(sampled.stackless, U64{1})
    assert_eq(sampled.signals, U64{3})
    assert_eq(sampled.lines[0].line, 5)
    assert_eq(sampled.lines[0].count, U64{2})
    assert_eq(sampled.lines[0].inclusive, U64{2})
    assert_eq(sampled.natives.len(), 1)
    assert_eq(sampled.functions[sampled.natives[0].function].name, "jet_rt_alloc")
    // The helper's sample is split out at fib's line, named in Jet's terms.
    assert_eq(sampled.lines[0].helpers.len(), 1)
    assert_eq(sampled.functions[sampled.lines[0].helpers[0].function].name, "jet_ir_stop_turn")
    assert_eq(sampled.lines[0].helpers[0].count, U64{1})
    helpers: jet_cli_perf_helpers_section("fib.jet", sampled.lines, sampled.functions, sampled.sources, sampled.source_at) ?? panic("fib's line holds a helper sample")
    assert_eq(helpers.type_name, "JetPerfHelpers")
    assert_eq(String.from_bytes(canonical_json_bytes(helpers.value)) ?? "", "{{\"helpers\":[{{\"function\":\"fib\",\"helper\":\"stop poll\",\"line\":5,\"path\":\"fib.jet\",\"samples\":1}}]}}\n")
    assert_eq(jet_cli_perf_helper_name("jet_ir_stop_poll"), "stop poll")
    assert_eq(jet_cli_perf_helper_name("jet_ir_stack_mark"), "stack mark")
    text: "\n\n\n\nfib: fn(n: Int) -> Int {{ n }}\n"
    profile: jet_cli_perf_samples_profile(jet_cli_perf_source("fib.jet", text), sampled) ?? panic("fib's line holds samples")
    assert(profile.reason.contains("; 1 of 3 samples are outside fib.jet; outside Jet functions: jet_rt_alloc 1; 1 samples in compiler-emitted helpers, such as stop polls, count at the line that called them"))
    assert(profile.reason.contains("; 1 samples in Jet code kept no stack"))
    assert(profile.reason.contains("; it kept 3 of the 32 samples that 4 ms of CPU time under sampling gives"))
    assert(!profile.reason.contains("jet_ir_"))
    assert_eq(profile.overhead_status, "measured")
    assert_eq(profile.overhead_ns, Val(U64{9000}))
    // Under the timer every part is the runtime's: its handlers and the
    // signals it asked for. The kernel writes no ring.
    assert_eq(profile.overhead_runtime_ns, Val(U64{9000}))
    assert_eq(profile.overhead_kernel_ns, Val(U64{0}))
    assert_eq(profile.overhead_reason, "the sampler took 9 microseconds, 0.22% of the 4000 microseconds of CPU time sampled: 6 in its handlers and 3 signals at the 1000 nanoseconds the kernel took to deliver and return from one as sampling started")
}

#Test("perf charges a ring's samples the kernel's write and no signal, and says where the kernel cut a stack") {
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}}
    four: 4 << 48
    eleven: 11 << 48
    ended: (13 << 59) | (3 << 48) | 2
    first: 1 << 48
    words: jet_cli_perf_test_words(
        [Int]{
            // Sampler 1's three samples, each its time, task and count
            // word: its serial over its task clock's count, at the 1st, 3rd
            // and 4th of its 125 microsecond periods' ends.
            4112 | four,
            1000,
            0,
            first | 125300,
            4116 | four,
            3000,
            0,
            first | 375100,
            4120 | four,
            4000,
            0,
            first | 500050,
            // Its thread's end, then the exit's later count of it, which
            // wins; and sampler 2's end, two periods with no sample.
            ended,
            1,
            900000,
            ended,
            2,
            250000,
            ended,
            1,
            1000020,
            // The clock record: 4 ms of CPU sampled, 6 microseconds in the
            // handlers and drains, 1 microsecond for each signal's
            // delivery, no allocations or lost records, then the three
            // samples the drains took from the rings, the kernel's 1.5
            // microseconds to write them, one stack the kernel cut and no
            // sample it dropped.
            (13 << 59) | eleven,
            4000000,
            6000,
            1000,
            0,
            0,
            0,
            3,
            1500,
            1,
            0,
        },
    )
    sampled := jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    // The task clock, its .pc file's eighth word the kernel's callchain
    // depth.
    sampled.sampler = jet_cli_perf_pc_words(jet_cli_perf_test_words([Int]{3, 0, 0, 0, 2, 125000, 0, 127}))
    assert_eq(sampled.total, U64{3})
    text: "\n\n\n\nfib: fn(n: Int) -> Int {{ n }}\n"
    profile: jet_cli_perf_samples_profile(jet_cli_perf_source("fib.jet", text), sampled) ?? panic("fib's line holds samples")
    assert(profile.reason.contains("; the task clock took them, a perf event on each thread's CPU time in user mode, so time in the kernel takes none, and the kernel walked each sample's stack into its thread's ring, at most 127 callchain entries"))
    assert(profile.reason.contains("; 1 samples' stacks were cut at the 127 callchain entries the kernel writes (perf_event_max_stack), so their outermost callers are missing"))
    assert_eq(profile.overhead_ns, Val(U64{7500}))
    // The handlers and drains are the runtime's; the rings' writes are the
    // kernel's.
    assert_eq(profile.overhead_runtime_ns, Val(U64{6000}))
    assert_eq(profile.overhead_kernel_ns, Val(U64{1500}))
    assert_eq(profile.overhead_reason, "the sampler took 7 microseconds, 0.18% of the 4000 microseconds of CPU time sampled: 6 in its handlers and drains, each drain timer's signal delivered within them, 0 signals at the 1000 nanoseconds the kernel took to deliver and return from one as sampling started, and 1 microseconds the kernel took to write the 3 samples to the threads' rings, as timed when sampling started")
    // The task clocks' counts at the samplers' ends give the samples they
    // should have kept: sampler 1's 8 periods and sampler 2's 2. Of their
    // 10 ends, sampler 1's 2nd, its 5th to 8th after its last sample and
    // both of sampler 2's fell in kernel mode.
    assert(profile.reason.contains("; it kept 3 of the 10 samples that 1 ms of CPU time on the threads' task clocks while sampled gives; 7 of their periods ended in kernel mode, where the task clock takes no sample; of their samples, 0 were lost in the rings, drained but not kept, and 0 dropped by the kernel, which found no room in a ring"), profile.reason)
}

// Under load a sampler's timer drifts off the multiples of its period, as
// each switch back in restarts it with what was left of its period, so two
// of its samples can round to one multiple, and one timer can run ahead of
// its count. The ends come from the gaps between consecutive samples, so
// the samples kept and the ends in kernel mode still make up every end.
#Test("perf counts a task clock's period ends from the gaps between its samples, so a drifted timer's add up") {
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}}
    four: 4 << 48
    eleven: 11 << 48
    ended: (13 << 59) | (3 << 48) | 2
    first: 1 << 48
    second: 2 << 48
    words: jet_cli_perf_test_words(
        [Int]{
            // Sampler 1's samples, a period apart but 115 microseconds
            // between its 3rd and 4th, which both round to the 3rd period
            // end, then three periods to its 5th: two ends with no sample.
            4112 | four,
            1000,
            0,
            first | 69000,
            4112 | four,
            2000,
            0,
            first | 189000,
            4112 | four,
            3000,
            0,
            first | 314000,
            4112 | four,
            4000,
            0,
            first | 429000,
            4112 | four,
            5000,
            0,
            first | 804000,
            // Sampler 2's, whose timer ran ahead of its count: three ends
            // where its count at its end gives two.
            4116 | four,
            1500,
            0,
            second | 120000,
            4116 | four,
            2500,
            0,
            second | 236000,
            4116 | four,
            3500,
            0,
            second | 352000,
            // Sampler 1 ends at its 8th period end, with one more in
            // kernel mode after its last sample; sampler 2 just short of
            // its 3rd.
            ended,
            1,
            1000000,
            ended,
            2,
            370000,
            (13 << 59) | eleven,
            1370000,
            6000,
            1000,
            0,
            0,
            0,
            8,
            1500,
            0,
            0,
        },
    )
    sampled := jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    sampled.sampler = jet_cli_perf_pc_words(jet_cli_perf_test_words([Int]{3, 0, 0, 0, 2, 125000, 0, 127}))
    assert_eq(sampled.total, U64{8})
    text: "\n\n\n\nfib: fn(n: Int) -> Int {{ n }}\n"
    profile: jet_cli_perf_samples_profile(jet_cli_perf_source("fib.jet", text), sampled) ?? panic("fib's line holds samples")
    // Sampler 1 reached 8 ends: its 5 samples and 3 in kernel mode, 2
    // before its last sample and 1 after. Sampler 2 reached 3, each with a
    // sample.
    assert(profile.reason.contains("; it kept 8 of the 11 samples that 1 ms of CPU time on the threads' task clocks while sampled gives; 3 of their periods ended in kernel mode, where the task clock takes no sample; of their samples, 0 were lost"), profile.reason)
}

// A period end whose sample the file lacks took none, as one in kernel mode
// did, so the clock record's tallies tell them apart: the samples the
// drains took from the rings less those kept were lost in the rings, and
// those the kernel found no room for it dropped.
#Test("perf counts the samples lost in the rings and those the kernel dropped apart from the period ends in kernel mode") {
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}}
    four: 4 << 48
    first: 1 << 48
    values := [Int]{}
    // Samples at the 1st, 2nd, 4th, 5th, 7th and 8th of sampler 1's period
    // ends: the 3rd's was drained and lost, the 6th's the kernel dropped.
    counts: [Int]{125000, 250000, 500000, 625000, 875000, 1000000}
    loop index in 0..<counts.len() {
        values.push(4112 | four)
        values.push(1000 * (index + 1))
        values.push(0)
        values.push(first | counts[index])
    }
    // Its end at its 10th, the 9th and 10th in kernel mode; then the clock
    // record, its rings' 7 samples and the 1 the kernel dropped.
    values.push((13 << 59) | (3 << 48) | 2)
    values.push(1)
    values.push(1250000)
    values.push((13 << 59) | (11 << 48))
    values.push(1250000)
    values.push(6000)
    values.push(1000)
    values.push(0)
    values.push(0)
    values.push(1)
    values.push(7)
    values.push(1500)
    values.push(0)
    values.push(1)
    sampled := jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, jet_cli_perf_test_words(values), 0)
    sampled.sampler = jet_cli_perf_pc_words(jet_cli_perf_test_words([Int]{3, 0, 0, 0, 2, 125000, 0, 127}))
    assert_eq(sampled.total, U64{6})
    text: "\n\n\n\nfib: fn(n: Int) -> Int {{ n }}\n"
    profile: jet_cli_perf_samples_profile(jet_cli_perf_source("fib.jet", text), sampled) ?? panic("fib's line holds samples")
    // 10 ends: 6 samples kept, 2 in kernel mode, 1 lost and 1 dropped.
    assert(profile.reason.contains("; it kept 6 of the 10 samples that 1 ms of CPU time on the threads' task clocks while sampled gives; 2 of their periods ended in kernel mode, where the task clock takes no sample; of their samples, 1 were lost in the rings, drained but not kept, and 1 dropped by the kernel, which found no room in a ring"), profile.reason)
}

// A sample in a generated entry's own code counts outside the source, by
// its symbol, and the entry is no frame of a sample under it. The run's
// observations of `run` follow the CPU rows as its wall row.
#Test("perf samples count a generated entry outside the source and end in the run's wall row") {
    // run's code at 0x1000 and the entry that calls it at 0x2000, both
    // declared at line 2 of app.jet.
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "run", file: "app.jet", dir: "", decl: 2, rows: 0, rows_end: 0}, X64JetlineFunction{low: 8192, high: 8448, name: "entry", file: "app.jet", dir: "", decl: 2, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "app.run"}, X64ImageFunction{start: 8192, size: 256, name: "app.entry"}}
    one: 1 << 48
    two: 2 << 48
    words: jet_cli_perf_test_words(
        [Int]{
            // In the entry's own code.
            8200 | one,
            // In run, called from the entry.
            4112 | two,
            8260,
            // In run with no stack.
            4112 | one,
        },
    )
    sampled: jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true, true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.total, U64{3})
    assert_eq(sampled.outside, U64{1})
    assert_eq(sampled.functions[sampled.natives[0].function].name, "app.entry")
    assert_eq(sampled.lines.len(), 1)
    assert_eq(sampled.lines[0].name, "run")
    assert_eq(sampled.lines[0].count, U64{2})
    assert_eq(sampled.lines[0].inclusive, U64{2})
    source: jet_cli_perf_source("app.jet", "\nrun: fn() -> Int {{ 1 }}\n")
    place: jet_cli_perf_run_place(source) ?? panic("app.jet has a run")
    profile: jet_cli_perf_samples_profile(source, sampled, wall: Val(place), wall_samples: U64{5}) ?? panic("run's line holds samples")
    assert_eq(profile.rows.len(), 2)
    assert_eq(profile.rows[0].clock, "cpu")
    assert_eq(profile.rows[0].symbol.name, "run")
    assert_eq(profile.rows[1].clock, "wall")
    assert_eq(profile.rows[1].sample_count, U64{5})
    assert_eq(profile.rows[1].source.start_line, U64{2})
    assert(profile.reason.contains("; 1 of 3 samples are outside app.jet; outside Jet functions: app.entry 1"))
    assert(profile.reason.contains("; the wall row is the run's 5 observations of `run`"))
}

// Each record the runtime could not write is counted. A flight ring keeps
// tally records, clock records with 1 for their address: the losses so far,
// then whether the run ended, each counting every loss before it. A `jet
// perf run` exit's clock record carries the count as its seventh word. The
// trace's `records` section keeps the count; a run that lost none has none.
#Test("perf samples count the records the program could not write, and the trace keeps the count") {
    clock: 13 << 59
    tally: clock | (3 << 48) | 1
    ring: jet_cli_perf_test_words([Int]{tally, 4, 0, tally, 9, 0, tally, 9, 1})
    flight: jet_cli_perf_samples_count(X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, [X64ImageFunction]{}, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, ring, 0)
    assert_eq(flight.records_lost, U64{9})
    assert_eq(flight.total, U64{0})
    assert(flight.cost == None)
    file: jet_cli_perf_test_words([Int]{clock | (11 << 48), 4000000, 6000, 1000, 0, 0, 3, 0, 0, 0, 0})
    run: jet_cli_perf_samples_count(X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, [X64ImageFunction]{}, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, file, 0)
    assert_eq(run.records_lost, U64{3})
    assert(run.cost != None)
    section: jet_cli_perf_records_section(U64{3}, "the samples file refused their writes") ?? panic("3 records were lost")
    assert_eq(section.name, "records")
    assert_eq(section.type_name, "JetPerfRecords")
    assert_eq(String.from_bytes(canonical_json_bytes(section.value)) ?? "", "{{\"lost\":3,\"reason\":\"the samples file refused their writes\"}}\n")
    assert(jet_cli_perf_records_section(U64{0}, "the samples file refused their writes") == None)
}

// The runtime's code is in the prelinked runtime image's `.symtab` but in
// no line table, so a thread it runs and a site in it are named by the
// symbol, at line 0 with no file, and the spawn's and the counting's own
// frames, by the name the runtime's source writes, are left out. A site
// with no line reads as its symbol alone.
#Test("perf names the runtime's threads and host call sites by their symbols") {
    functions: [X64ImageFunction]{
        X64ImageFunction{start: 4096, size: 256, name: "unit.thread_spawn"},
        X64ImageFunction{start: 4352, size: 256, name: "unit.process_execution_collect_start"},
        X64ImageFunction{start: 4608, size: 256, name: "jet_rt_process_execution_worker"},
        X64ImageFunction{start: 4864, size: 256, name: "unit.host_syscall"},
        X64ImageFunction{start: 5120, size: 256, name: "unit.spawn_pipe"},
    }
    sampled := jet_cli_perf_samples_count(X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, [U8]{}, 0)
    // Rows of 10 words: the main thread, the collector spawned through
    // thread_spawn by the collector's start, and a thread at an address
    // no symbol holds.
    threads: jet_cli_perf_test_words(
        [Int]{
            10,
            3,
            7,
            0,
            16777216,
            0,
            0,
            5,
            0,
            0,
            0,
            0,
            8,
            4608,
            65536,
            100,
            400,
            50,
            1,
            2,
            4112,
            4384,
            9,
            9000,
            65536,
            0,
            0,
            0,
            1,
            0,
            0,
            0,
        },
    )
    // Rows of 6 words: pipe2 twice from the spawn's pipe helper.
    calls: jet_cli_perf_test_words([Int]{6, 1, 0, 293, 2, 900, 4872, 5160, 0})
    jet_cli_perf_system_read(sampled, [Bool]{true}, threads, calls)
    claimed: sampled.threads_claimed
    threads_section: jet_cli_perf_threads_section(sampled.threads.move(), claimed) ?? panic("three threads ran")
    assert_eq(String.from_bytes(canonical_json_bytes(threads_section.value)) ?? "", "{{\"claimed\":3,\"threads\":[{{\"cpu_ns\":5,\"name\":\"main\",\"off_cpu_ns\":0,\"spawned_at\":[],\"stack_bytes\":16777216,\"state\":\"running\",\"tid\":7}},{{\"cpu_ns\":50,\"name\":\"jet_rt_process_execution_worker\",\"off_cpu_ns\":250,\"spawned_at\":[{{\"file\":null,\"function\":\"unit.process_execution_collect_start\",\"line\":0,\"own\":false}}],\"stack_bytes\":65536,\"state\":\"ended\",\"tid\":8}},{{\"cpu_ns\":0,\"name\":\"code at 9000\",\"off_cpu_ns\":0,\"spawned_at\":[],\"stack_bytes\":65536,\"state\":\"ended\",\"tid\":9}}]}}\n")
    lost: sampled.syscalls_lost
    calls_section: jet_cli_perf_syscalls_section(sampled.syscalls.move(), lost) ?? panic("pipe2 ran")
    assert_eq(String.from_bytes(canonical_json_bytes(calls_section.value)) ?? "", "{{\"lost\":0,\"syscalls\":[{{\"count\":2,\"name\":\"pipe2\",\"number\":293,\"stack\":[{{\"file\":null,\"function\":\"unit.spawn_pipe\",\"line\":0,\"own\":false}}],\"time_ns\":900}}]}}\n")
    row: CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "stack", value: CanonicalJSON.Array([CanonicalJSON]{CanonicalJSON.Object([CanonicalJSONField]{{key: "file", value: CanonicalJSON.Null}, {key: "function", value: CanonicalJSON.String("unit.spawn_pipe")}, {key: "line", value: CanonicalJSON.Integer("0")}, {key: "own", value: CanonicalJSON.Bool(false)}}), CanonicalJSON.Object([CanonicalJSONField]{{key: "file", value: CanonicalJSON.String("/work/main.jet")}, {key: "function", value: CanonicalJSON.String("run")}, {key: "line", value: CanonicalJSON.Integer("7")}, {key: "own", value: CanonicalJSON.Bool(true)}})})},
        },
    )
    assert_eq(jet_cli_perf_sites_text(row, "stack"), Val("unit.spawn_pipe from main.jet:7 run"))
}

#Test("the per-line table splits a line's samples in a stop poll out of its own") {
    names: [String]{"", "fib.jet", "fib"}
    rows: [JetCLIPerfLineTotal]{JetCLIPerfLineTotal{path: 1, line: 7, function: 2, samples: 71}, JetCLIPerfLineTotal{path: 1, line: 5, function: 2, samples: 29}}
    helpers: [JetCLIPerfLineHelper]{JetCLIPerfLineHelper{path: "fib.jet", line: 7, function: "fib", helper: "stop poll", samples: 34}}
    table: jet_cli_perf_line_table(JetCLIPerfLineTotals{names: names, rows: rows, helpers: helpers}, jet_cli_perf_line_costs_none())
    assert_eq(table, [String]{"  fib.jet:7 fib samples=71 share=71% · stop poll samples=34 share=34%", "  fib.jet:5 fib samples=29 share=29%"})
}

#Test("perf names the sampler that took the CPU-time samples and why the timer took them") {
    // The task clock at perf_event_paranoid 2, once per 125 microseconds of
    // CPU time.
    clock: jet_cli_perf_test_words([Int]{3, 0, 0, 0, 2, 125000, 0})
    json: String.from_bytes(canonical_json_bytes(jet_cli_perf_pc_json(jet_cli_perf_pc_words(clock)))) ?? panic("the pc is UTF-8")
    assert_eq(json, "{{\"paranoid\":2,\"period\":125000,\"period_unit\":\"ns\",\"precise\":false,\"refused\":[],\"skid\":\"task_clock_interrupt\",\"source\":\"task_clock\"}}\n")
    took: jet_cli_perf_pc_words(clock) ?? panic("seven words hold a sampler")
    assert(jet_cli_perf_sampler_reason(took, U64{50}, Val(U64{50000000})).contains("the task clock took them"))
    // The timer above perf_event_paranoid 2 states its cap and why.
    above: jet_cli_perf_pc_words(jet_cli_perf_test_words([Int]{0, 0, 0, 0, 3, 125000, 0})) ?? panic("seven words hold a sampler")
    assert_eq(jet_cli_perf_sampler_reason(above, U64{14}, Val(U64{54000000})), "; the CPU-time timer took them, which the kernel checks once a tick, so each thread takes at most one sample a tick: perf_event_paranoid is 3, and a thread's own perf events need it at most 2")
    // The timer where the kernel refused the task clock names its errno.
    refused: jet_cli_perf_test_words([Int]{0, 0, 0, 13, 2, 125000, 0})
    named: String.from_bytes(canonical_json_bytes(jet_cli_perf_pc_json(jet_cli_perf_pc_words(refused)))) ?? panic("the pc is UTF-8")
    assert(named.contains("\"refused\":[{{\"errno\":13,\"source\":\"task_clock\"}}],\"skid\":\"timer_signal\",\"source\":\"timer\""))
    timer: jet_cli_perf_pc_words(refused) ?? panic("seven words hold a sampler")
    assert(jet_cli_perf_sampler_reason(timer, U64{14}, None).ends_with(": the kernel refused the task clock with errno 13"))
    kept: jet_cli_perf_pc_words(jet_cli_perf_test_words([Int]{0, 0, 0, 0, 2, 125000, 1})) ?? panic("seven words hold a sampler")
    assert(jet_cli_perf_sampler_reason(kept, U64{14}, None).ends_with(": the causal lens keeps it, since its experiments' periods are CPU time's"))
    // IBS op sampling at perf_event_paranoid -1, its period in cycles, and
    // the rate it reached.
    ibs: jet_cli_perf_test_words([Int]{1, 0, 0, 0, -1, 600016, 0})
    precise: String.from_bytes(canonical_json_bytes(jet_cli_perf_pc_json(jet_cli_perf_pc_words(ibs)))) ?? panic("the pc is UTF-8")
    assert_eq(precise, "{{\"paranoid\":-1,\"period\":600016,\"period_unit\":\"cycles\",\"precise\":true,\"refused\":[],\"skid\":null,\"source\":\"ibs_op\"}}\n")
    op: jet_cli_perf_pc_words(ibs) ?? panic("seven words hold a sampler")
    assert_eq(jet_cli_perf_sampler_reason(op, U64{392}, Val(U64{50000000})), "; IBS op sampling took them once per 600016 cycles, the cycles a core ran in 125 microseconds as sampling started, so its rate follows the clock speed: it reached 7.84 samples per millisecond of CPU time")
    // Six words are no sampler.
    assert(jet_cli_perf_pc_words(jet_cli_perf_test_words([Int]{0, 0, 0, 0, 2, 125000})) == None)
}

#Test("a CPU-time sample's record ends in its time, task and count word, and a zone of that task holds the samples inside it") {
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}, X64ImageFunction{start: 12288, size: 16, name: "jet_rt_alloc"}}
    two: 2 << 48
    four: 4 << 48
    five: 5 << 48
    words: jet_cli_perf_test_words(
        [Int]{
            // In fib called from fib, at 2000 ns, of task 7, by the timer:
            // its count word 0.
            4112 | five,
            4160,
            2000,
            7,
            0,
            // In fib with no stack, at 1000 ns, of task 7, by sampler 3 at
            // its count 125000.
            4112 | four,
            1000,
            7,
            (3 << 48) | 125000,
            // In the runtime at 1500 ns: no line of the source.
            12292 | four,
            1500,
            7,
            (3 << 48) | 250000,
            // In fib at 5000 ns, of task 9.
            4112 | four,
            5000,
            9,
            0,
            // Two words and no more: a program counter and a caller, untimed.
            4112 | two,
            4160,
        },
    )
    sampled: jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.counts, [Int]{(3 << 48) | 125000, (3 << 48) | 250000})
    assert_eq(sampled.total, U64{5})
    assert_eq(sampled.stackless, U64{2})
    assert_eq(sampled.outside, U64{1})
    assert_eq(sampled.timed.len(), 4)
    assert_eq(sampled.timed[0].at_ns, 1000)
    assert_eq(sampled.timed[0].line, 5)
    assert_eq(sampled.timed[1].at_ns, 1500)
    assert_eq(sampled.timed[1].line, 0)
    assert_eq(sampled.timed[2].at_ns, 2000)
    assert_eq(sampled.timed[2].task, 7)
    assert_eq(sampled.timed[3].task, 9)
    assert_eq(jet_cli_perf_timed_first(sampled.timed, 0), 0)
    assert_eq(jet_cli_perf_timed_first(sampled.timed, 1500), 1)
    assert_eq(jet_cli_perf_timed_first(sampled.timed, 1501), 2)
    assert_eq(jet_cli_perf_timed_first(sampled.timed, 9000), 4)
    zone: JetCLIPerfZoneTotal{name: "solve", count: 1, total: 3000, longest: 3000, samples: 3, lines: [Int:Int]{5: 2}}
    section: jet_cli_perf_zones_section([JetCLIPerfZoneTotal]{zone}, [Int]{}, [JetCLIPerfPlotTotal]{}, [JetCLIPerfZoneSampled]{JetCLIPerfZoneSampled{name: "solve", start_ns: U64{0}, end_ns: U64{3000}, samples: 3, line: 5}}, "fib.jet", "", "", [Int]{})
    json: String.from_bytes(canonical_json_bytes(section.value)) ?? panic("the section is UTF-8")
    assert(json.contains(`"sampled":[{"end_ns":3000,"line":5,"name":"solve","samples":3,"start_ns":0}]`))
    assert(json.contains(`"source":"fib.jet"`))
    assert(json.contains(`{"count":1,"lines":[{"line":5,"samples":2}],"longest_ns":3000,"name":"solve","samples":3,"total_ns":3000}`))
}

// A CPU-time sample: its program counter, its call sites, innermost first,
// and its time and task; its count word is sampler 1's at its time.
JetCLIPerfTestSample: struct {
    pc: Int,
    sites: [Int],
    at_ns: Int,
    task: Int,
}

// The samples' records as the runtime's writer lays them out
// (PerfSamples.jet perf_samples_cite): each whole when `cited` is false;
// else each whose outermost call sites repeat 2 or more of the sample
// before's as a cite of it, its own inner call sites kept. Each sample
// after one of `counted` sample indices is preceded by an LLC-miss
// counter's record, which a cite reaches past.
jet_cli_perf_test_records: fn(samples: [JetCLIPerfTestSample], cited: Bool, counted: [Int]{[Int]{}}) -> [U8] Never! {
    values := [Int]{}
    before := 0
    loop k in 0..<samples.len() {
        sample: samples[k]
        if counted.contains(k) {
            values.push((2 << 59) | (2 << 48) | sample.pc)
            values.push(8200)
        }
        own: sample.sites.len()
        shared := 0
        if cited && k > 0 {
            last: samples[k - 1].sites
            loop shared < own && shared < last.len() && sample.sites[own - 1 - shared] == last[last.len() - 1 - shared] {
                shared += 1
            }
        }
        start: values.len()
        if shared >= 2 {
            values.push(sample.pc | ((own - shared + 5) << 48))
            loop index in 0..<(own - shared) -> values.push(sample.sites[index])
            values.push((-9223372036854775807 - 1) | (shared << 32) | (start - before))
        } else {
            values.push(sample.pc | ((own + 4) << 48))
            loop site in sample.sites -> values.push(site)
        }
        before = start
        values.push(sample.at_ns)
        values.push(sample.task)
        values.push((1 << 48) | sample.at_ns)
    }
    jet_cli_perf_test_words(values)
}

// Each CPU-time sample's call sites, innermost first, as the reader
// expands them from `words` (jet_cli_perf_sites), each from the one before.
jet_cli_perf_test_stacks: fn(words: [U8]) -> [[Int]] Never! {
    stacks := [[Int]]{}
    at := 0
    loop at + 8 <= words.len() {
        head: jet_cli_perf_head(words, at)
        if head.kind == 0 && head.size > 3 {
            sites: if stacks.len() == 0 -> jet_cli_perf_sites(words, at, head.size - 3, [Int]{}) else -> jet_cli_perf_sites(words, at, head.size - 3, stacks[stacks.len() - 1])
            stacks.push(sites)
        }
        at += head.record * 8
    }
    stacks
}

// Whether `words` decodes to exactly the call sites of `samples`.
jet_cli_perf_test_same_stacks: fn(words: [U8], samples: [JetCLIPerfTestSample]) -> Bool Never! {
    stacks: jet_cli_perf_test_stacks(words)
    if stacks.len() != samples.len() -> return false
    loop k in 0..<samples.len() {
        if stacks[k] != samples[k].sites -> return false
    }
    true
}

// What a decode of CPU-time samples says: its tallies, each line's samples,
// each sample's time, task and line, each program counter's samples and
// each sample's count word.
jet_cli_perf_test_decoded: fn(sampled: JetCLIPerfSamples) -> [String] Never! {
    rows := [String]{"total {sampled.total} outside {sampled.outside} stackless {sampled.stackless} helpers {sampled.helpers}"}
    loop line in sampled.lines {
        rows.push("line {line.line} count {line.count} inclusive {line.inclusive}")
    }
    loop timed in sampled.timed {
        rows.push("timed {timed.at_ns} task {timed.task} line {timed.line}")
    }
    loop pc in sampled.pcs -> rows.push("pc {pc.pc} samples {pc.samples}")
    loop word in sampled.counts -> rows.push("count {word}")
    rows
}

// A decode of `words` over fib, solve and step, each a line of fib.jet.
jet_cli_perf_test_cited: fn(words: [U8]) -> [String] Never! {
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}, X64JetlineFunction{low: 8192, high: 8448, name: "solve", file: "fib.jet", dir: "", decl: 9, rows: 0, rows_end: 0}, X64JetlineFunction{low: 16384, high: 16640, name: "step", file: "fib.jet", dir: "", decl: 13, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}, X64ImageFunction{start: 8192, size: 256, name: "fib.solve"}, X64ImageFunction{start: 16384, size: 256, name: "fib.step"}}
    jet_cli_perf_test_decoded(jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0))
}

// Decodes the samples written whole and as the writer cites them, which
// must say the same, each sample's call sites exactly as written, in fewer
// bytes when any cites: the samples as written.
jet_cli_perf_test_cites: fn(samples: [JetCLIPerfTestSample], counted: [Int]{[Int]{}}) -> [String] Never! {
    whole: jet_cli_perf_test_records(samples, false, counted: counted)
    cited: jet_cli_perf_test_records(samples, true, counted: counted)
    assert(jet_cli_perf_cites_corrupt(cited) == None)
    assert(jet_cli_perf_test_same_stacks(cited, samples))
    assert(jet_cli_perf_test_same_stacks(whole, samples))
    written: jet_cli_perf_test_cited(whole)
    assert_eq(jet_cli_perf_test_cited(cited), written)
    written
}

// The writer's cites (PerfSamples.jet perf_samples_cite) as the CLI reads
// them: each cite decodes to its own inner call sites and the outermost
// ones it shares of the sample before, a cite or not, with its own program
// counter, time and task. The runtime fragment PerfCitesTests.jet drives
// the writer itself through the same cases.
#Test("a sample that cites the sample before decodes to the samples written whole") {
    a: [Int]{8200, 16400}
    b: [Int]{8200, 4160}
    sample: fn(pc: Int, sites: [Int], at: Int) -> JetCLIPerfTestSample { JetCLIPerfTestSample{pc: pc, sites: sites, at_ns: at, task: at % 3 + 1} }
    // Repeated: one stack, each sample its own program counter, time and
    // task, cites the one before.
    repeated: [JetCLIPerfTestSample]{sample(4112, a, 100), sample(4116, a, 200), sample(4120, a, 300)}
    decoded := jet_cli_perf_test_cites(repeated)
    assert(jet_cli_perf_test_records(repeated, true).len() < jet_cli_perf_test_records(repeated, false).len())
    assert_eq(decoded[0], "total 3 outside 0 stackless 0 helpers 0")
    assert(decoded.contains("line 9 count 0 inclusive 3"))
    assert(decoded.contains("line 13 count 0 inclusive 3"))
    assert(decoded.contains("timed 200 task 3 line 5"))
    assert(decoded.contains("pc 4120 samples 1"))
    // Distinct: a last call site apart, a call site deeper, another stack;
    // a counter's sample between two samples, which a cite reaches past.
    distinct: [JetCLIPerfTestSample]{sample(4112, a, 100), sample(4112, b, 200), sample(4112, [Int]{4160, 8200, 16400}, 300), sample(16400, [Int]{4160, 8200}, 400)}
    decoded = jet_cli_perf_test_cites(distinct, counted: [Int]{2})
    assert(decoded.contains("line 13 count 1 inclusive 3"))
    // A suffix: deeper recursion under one stack, each cite sharing the
    // outermost call sites and keeping the inner ones, then a chain of
    // cites back up.
    deep: [JetCLIPerfTestSample]{sample(4112, [Int]{4100, 8200, 16400}, 100), sample(4112, [Int]{4100, 4100, 8200, 16400}, 200), sample(4112, [Int]{4100, 4100, 4100, 8200, 16400}, 300), sample(4112, [Int]{4100, 8200, 16400}, 400), sample(4112, a, 500), sample(4112, [Int]{16400}, 600)}
    decoded = jet_cli_perf_test_cites(deep)
    assert_eq(decoded[0], "total 6 outside 0 stackless 0 helpers 0")
    assert(decoded.contains("line 13 count 0 inclusive 6"))
}

// The next of a random sequence of stacks, from the one `before`: deeper by
// a call or by a jump of 20, shallower by a call or down to the outermost
// two, or another innermost call site under the same callers.
jet_cli_perf_test_step: fn(before: [Int], choice: Int, k: Int, state: Int) -> [Int] Never! {
    stack := [Int]{}
    if choice <= 2 && before.len() < 60 {
        stack.push(4100 + (state >> 12) % 3)
        stack.extend(before[0..<before.len()])
    } else if choice <= 4 && before.len() > 2 { stack.extend(before[1..<before.len()]) } else if choice == 6 && before.len() > 20 {
        stack.extend(before[(before.len() - 2)..<before.len()])
    } else if choice == 6 {
        loop _ in 0..<20 -> stack.push(4100)
        stack.extend(before[0..<before.len()])
    } else {
        stack.push(if k % 2 == 0 -> 8300 else -> 8400)
        stack.extend(before[1..<before.len()])
    }
    stack
}

// Random stack sequences, written whole and cited, round-trip exactly:
// recursion in and out of up to 60 frames, alternating branches under one
// caller, jumps of depth, and counters' samples between.
#Test("random stack sequences decode exactly as cited as written whole") {
    state := 20261118
    samples := [JetCLIPerfTestSample]{}
    counted := [Int]{}
    loop k in 0..<600 {
        state = (state * 1103515245 + 12345) % 2147483648
        choice: (state >> 8) % 8
        sites: if samples.len() == 0 -> jet_cli_perf_test_step([Int]{8200, 16400}, choice, k, state) else -> jet_cli_perf_test_step(samples[samples.len() - 1].sites, choice, k, state)
        if (state >> 16) % 50 == 0 -> counted.push(k)
        samples.push(JetCLIPerfTestSample{pc: 4096 + (state >> 4) % 200, sites: sites, at_ns: 1000 + k, task: k % 4})
    }
    decoded: jet_cli_perf_test_cites(samples, counted: counted)
    assert_eq(decoded[0], "total 600 outside 0 stackless 0 helpers 0")
    assert(jet_cli_perf_test_records(samples, true, counted: counted).len() < jet_cli_perf_test_records(samples, false, counted: counted).len())
}

// A sample written whole with call sites 4100, 4100, 8200 and 16400, then
// one with call site 4101 of its own and a cite of `shared` call sites
// `back` words back, then one with no call site of its own citing
// `chained` of the second's.
jet_cli_perf_test_corrupt: fn(shared: Int, back: Int, chained: Int) -> [U8] Never! {
    cite: -9223372036854775807 - 1
    jet_cli_perf_test_words([Int]{4112 | (8 << 48), 4100, 4100, 8200, 16400, 100, 1, 0, 4116 | (6 << 48), 4101, cite | (shared << 32) | back, 200, 2, 0, 4120 | (5 << 48), cite | (chained << 32) | 6, 300, 3, 0})
}

// A cite that reaches past one write, or to no CPU-time sample just
// before it, or shares fewer call sites than a cite does or more than the
// sample before holds, is a corrupt record, named by its byte, and the
// file holding it is refused, never read short.
#Test("a cite outside its write or past the sample before's depth is a corrupt record") {
    assert(jet_cli_perf_cites_corrupt(jet_cli_perf_test_corrupt(3, 8, 4)) == None)
    assert_eq(jet_cli_perf_test_stacks(jet_cli_perf_test_corrupt(3, 8, 4)), [[Int]]{[Int]{4100, 4100, 8200, 16400}, [Int]{4101, 4100, 8200, 16400}, [Int]{4101, 4100, 8200, 16400}})
    corrupt: fn(words: [U8]) -> String { jet_cli_perf_cites_corrupt(words) ?? "sound" }
    assert_eq(corrupt(jet_cli_perf_test_corrupt(3, 2000, 4)), "at byte 64 past its header: its cite reaches 2000 words back, past the 1024 words of one write")
    assert_eq(corrupt(jet_cli_perf_test_corrupt(3, 7, 4)), "at byte 64 past its header: its cite reaches 7 words back, not to the CPU-time sample just before it")
    assert_eq(corrupt(jet_cli_perf_test_corrupt(5, 8, 4)), "at byte 64 past its header: its cite shares 5 call sites of the 4 the sample before it holds")
    assert_eq(corrupt(jet_cli_perf_test_corrupt(1, 8, 4)), "at byte 64 past its header: its cite shares 1 call sites of the 4 the sample before it holds")
    assert_eq(corrupt(jet_cli_perf_test_corrupt(3, 8, 5)), "at byte 112 past its header: its cite shares 5 call sites of the 4 the sample before it holds")
    assert_eq(corrupt(jet_cli_perf_test_corrupt(3, 8, 4).slice(64, 152)), "at byte 0 past its header: its cite reaches 8 words back, not to the CPU-time sample just before it")
    path: "{perf_test_sys.temp_dir()}/jet-perf-samples-cite-{perf_test_process.current_pid()}.samples"
    headed := jet_cli_perf_test_words([Int]{5498980087985620298, 2})
    headed.extend(jet_cli_perf_test_corrupt(5, 8, 4))
    perf_test_files.write_bytes(path, headed) ?? panic("the samples file: {err}")
    if jet_cli_perf_samples_records(path) == {
        .Ok(_) -> { panic("a samples file with a corrupt cite is read") }
        .Err(failure) -> {
            assert(failure.message.contains("holds a corrupt record at byte 64 past its header: its cite shares 5 call sites of the 4 the sample before it holds"))
        }
    }
    perf_test_files.remove(path) ?? panic("the samples file: {err}")
}

// Only a samples file of the version this jet reads is read: one before
// the header, or of another version, is refused, naming the version.
#Test("a samples file is read past its header, and an older one is refused by its version") {
    path: "{perf_test_sys.temp_dir()}/jet-perf-samples-version-{perf_test_process.current_pid()}.samples"
    records: fn() -> [U8] { jet_cli_perf_test_words([Int]{4112 | (4 << 48), 100, 7, 0}) }
    headed := jet_cli_perf_test_words([Int]{5498980087985620298, 2})
    headed.extend(records())
    perf_test_files.write_bytes(path, headed) ?? panic("the samples file: {err}")
    assert_eq(jet_cli_perf_samples_records(path) ?? panic(err.message), records())
    perf_test_files.write_bytes(path, records()) ?? panic("the samples file: {err}")
    if jet_cli_perf_samples_records(path) == {
        .Ok(_) -> { panic("a headerless samples file is read") }
        .Err(failure) -> {
            assert(failure.message.contains("has no version header, as an older jet's runtime writes it; this jet reads version 2"))
        }
    }
    other := jet_cli_perf_test_words([Int]{5498980087985620298, 3})
    other.extend(records())
    perf_test_files.write_bytes(path, other) ?? panic("the samples file: {err}")
    if jet_cli_perf_samples_records(path) == {
        .Ok(_) -> { panic("a samples file of version 3 is read") }
        .Err(failure) -> assert(failure.message.contains("is version 3; this jet reads version 2"))
    }
    perf_test_files.remove(path) ?? panic("the samples file: {err}")
    assert_eq(jet_cli_perf_samples_records(path) ?? panic(err.message), [U8]{})
}

// The runtime times zones, waits and log spans from the process epoch, its
// first monotonic read (time_host_monotonic_i64), which the first zone's
// open may be: a run's first zone opens 1293 ns after it. Each CPU-time
// sample is stamped on that clock too, -1 before the epoch is set.
#Test("a zone holds the CPU-time samples its task took inside it, both timed from the process epoch") {
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}}
    four: 4 << 48
    words: jet_cli_perf_test_words(
        [Int]{
            // Before the epoch was set: in no zone.
            4112 | four,
            -1,
            7,
            0,
            // Inside solve, of solve's task 7.
            4112 | four,
            1500,
            7,
            0,
            4112 | four,
            4000,
            7,
            0,
            // Inside solve's time, of task 9.
            4112 | four,
            2000,
            9,
            0,
            // At solve's end, so past it.
            4112 | four,
            4293,
            7,
            0,
        },
    )
    sampled: jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.timed.len(), 5)
    // solve's row of the spans file, as perf_zone_row writes it.
    row := jet_cli_perf_test_words([Int]{1293, 4293, 7, 5 | (1 << 32)})
    row.extend("solve".bytes())
    path: "{perf_test_sys.temp_dir()}/jet-perf-zone-clock-{perf_test_process.current_pid()}.spans"
    perf_test_files.write_bytes(path, row) ?? panic("the spans file: {err}")
    capture := jet_cli_perf_capture_source("fib.jet", "fib: fn() -> Int {{ 1 }}", [JetCLIPerfObservation]{}, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    jet_cli_perf_log_spans_read(capture, path, "fib.jet", 0, sampled.timed)
    assert(!perf_test_files.exists(path))
    assert_eq(capture.spans[capture.spans.len() - 1].start_ns, Val(U64{1293}))
    json: String.from_bytes(canonical_json_bytes(capture.receipts[capture.receipts.len() - 1].value)) ?? panic("the section is UTF-8")
    assert(json.contains(`"sampled":[{"end_ns":4293,"line":5,"name":"solve","samples":2,"start_ns":1293}]`))
    assert(json.contains(`{"count":1,"lines":[{"line":5,"samples":2}],"longest_ns":3000,"name":"solve","samples":2,"total_ns":3000}`))
}

// A spans file that reached its bound ends in a row saying so (the
// runtime's perf_spans_write): the rows before it stay trace rows, and the
// zones section names the cut, which is no row of its own.
#Test("a spans file cut at its bound keeps its earlier rows and names the cut in the zones section") {
    row := jet_cli_perf_test_words([Int]{100, 400, 7, 5 | (1 << 32)})
    row.extend("solve".bytes())
    reason: "the spans file reached its 16 MiB bound, so the rows after this were dropped"
    row.extend(jet_cli_perf_test_words([Int]{0, 0, 0, reason.len() | (5 << 32)}))
    row.extend(reason.bytes())
    path: "{perf_test_sys.temp_dir()}/jet-perf-zone-cut-{perf_test_process.current_pid()}.spans"
    perf_test_files.write_bytes(path, row) ?? panic("the spans file: {err}")
    capture := jet_cli_perf_capture_source("fib.jet", "fib: fn() -> Int {{ 1 }}", [JetCLIPerfObservation]{}, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    spans: capture.spans.len()
    jet_cli_perf_log_spans_read(capture, path, "fib.jet", 0, [JetCLIPerfTimed]{})
    assert(!perf_test_files.exists(path))
    assert_eq(capture.spans.len(), spans + 1)
    json: String.from_bytes(canonical_json_bytes(capture.receipts[capture.receipts.len() - 1].value)) ?? panic("the section is UTF-8")
    assert(json.starts_with(`{"cut":"the spans file reached its 16 MiB bound, so the rows after this were dropped","frames":`))
    assert(json.contains(`"name":"solve"`))
    assert_eq(jet_cli_perf_dropped_label(capture.receipts[capture.receipts.len() - 1].value), "")
}

// Past its bound the spans file counts the rows it drops, by kind, and at
// exit gives the counts in a row of four words (the runtime's
// perf_spans_flush): log spans, zones, frame marks, plotted values. The
// last such row counts; the zones section keeps its counts, and `jet perf
// view` puts each kind that lost any after the cut's reason. The words
// are no text, and the rows after them are still read.
#Test("a spans file cut at its bound counts the rows it dropped, by kind, in the zones section") {
    reason: "the spans file reached its 16 MiB bound, so the rows after this were dropped"
    row := jet_cli_perf_test_words([Int]{100, 400, 7, 5 | (1 << 32)})
    row.extend("solve".bytes())
    row.extend(jet_cli_perf_test_words([Int]{0, 0, 0, reason.len() | (5 << 32)}))
    row.extend(reason.bytes())
    row.extend(jet_cli_perf_test_words([Int]{500, 500, 0, 32 | (7 << 32), 1, 9, 0, 0}))
    row.extend(jet_cli_perf_test_words([Int]{900, 900, 0, 32 | (7 << 32), 2, 1534080, 0, 3}))
    row.extend(jet_cli_perf_test_words([Int]{950, 990, 7, 5 | (1 << 32)}))
    row.extend("solve".bytes())
    path: "{perf_test_sys.temp_dir()}/jet-perf-zone-dropped-{perf_test_process.current_pid()}.spans"
    perf_test_files.write_bytes(path, row) ?? panic("the spans file: {err}")
    capture := jet_cli_perf_capture_source("fib.jet", "fib: fn() -> Int {{ 1 }}", [JetCLIPerfObservation]{}, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    spans: capture.spans.len()
    jet_cli_perf_log_spans_read(capture, path, "fib.jet", 0, [JetCLIPerfTimed]{})
    assert_eq(capture.spans.len(), spans + 2)
    section: capture.receipts[capture.receipts.len() - 1].value
    json: String.from_bytes(canonical_json_bytes(section)) ?? panic("the section is UTF-8")
    assert(json.contains(`"dropped":{"frames":0,"log_spans":2,"plots":3,"zones":1534080}`))
    assert(json.contains(`"count":2,`))
    assert_eq(jet_cli_perf_dropped_label(section), ": 1534080 zones, 2 log spans, 3 plotted values")
}

// An attach's zones window ends in its row (the runtime's
// perf_flight_window_close): its opening and end, then five words, the
// interval its samples stand for, its CPU time, its handlers' time, one
// signal's delivery and its lost records. It is no trace row, and the rows
// after it still are.
#Test("a zones window's row is read for its interval and cost, and the rows beside it stay trace rows") {
    row := jet_cli_perf_test_words([Int]{1000, 4000, 0, 40 | (6 << 32), 125, 375000, 3000, 1000, 2})
    row.extend(jet_cli_perf_test_words([Int]{1293, 3293, 7, 5 | (1 << 32)}))
    row.extend("solve".bytes())
    window: jet_cli_perf_spans_window(row) ?? panic("the row names a window")
    assert_eq(window.start_ns, 1000)
    assert_eq(window.end_ns, 4000)
    assert_eq(window.interval_us, 125)
    assert_eq(window.cpu_ns, U64{375000})
    assert_eq(window.handler_ns, U64{3000})
    assert_eq(window.delivery_ns, U64{1000})
    assert_eq(window.lost, U64{2})
    assert(jet_cli_perf_spans_window(jet_cli_perf_test_words([Int]{1293, 3293, 7, 0 | (1 << 32)})) == None, "a file of zones alone names no window")
    path: "{perf_test_sys.temp_dir()}/jet-perf-zone-window-{perf_test_process.current_pid()}.spans"
    perf_test_files.write_bytes(path, row) ?? panic("the spans file: {err}")
    capture := jet_cli_perf_capture_source("fib.jet", "fib: fn() -> Int {{ 1 }}", [JetCLIPerfObservation]{}, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    spans: capture.spans.len()
    jet_cli_perf_log_spans_read(capture, path, "fib.jet", 0, [JetCLIPerfTimed]{})
    assert_eq(capture.spans.len(), spans + 1)
    assert_eq(capture.spans[spans].kind, "zone")
    assert_eq(capture.spans[spans].start_ns, Val(U64{1293}))
}

// An attach's zones window file holds the records its program made while
// it was open, sampled every 125 microseconds of CPU time, and those a
// late handler wrote at the flight recorder's interval around it: only the
// samples stamped inside the window count, each for the window's interval,
// and its row gives the sampler's cost.
#Test("a zones window's file counts only the samples stamped inside the window, at its interval and cost") {
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}}
    four: 4 << 48
    sampler: 1 << 48
    words: jet_cli_perf_test_words(
        [Int]{
            // Before the window opened.
            4112 | four,
            900,
            7,
            sampler | 125000,
            // Inside it.
            4112 | four,
            1500,
            7,
            sampler | 250000,
            4112 | four,
            2500,
            7,
            sampler | 375000,
            4112 | four,
            4000,
            9,
            sampler | 500000,
            // After it closed.
            4112 | four,
            4001,
            7,
            sampler | 625000,
            // Before zones ever turned on.
            4112 | four,
            -1,
            7,
            sampler | 750000,
            // The sampler's end.
            (13 << 59) | (3 << 48) | 2,
            1,
            800000,
        },
    )
    window: JetCLIPerfZonesWindow{start_ns: 1000, end_ns: 4000, interval_us: 125, cpu_ns: U64{375000}, handler_ns: U64{3000}, delivery_ns: U64{1000}, lost: U64{2}}
    sampled: jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0, window: Val(window))
    assert_eq(sampled.total, U64{3})
    assert_eq(sampled.signals, U64{3})
    assert_eq(sampled.unwindowed, U64{3})
    assert_eq(sampled.timed.len(), 3)
    assert_eq(sampled.interval_us, 125)
    assert_eq(sampled.records_lost, U64{2})
    // A window's samples are no sampler's whole run: no counts, no ends.
    assert_eq(sampled.counts.len(), 0)
    assert_eq(sampled.ends.len(), 0)
    text: "\n\n\n\nfib: fn(n: Int) -> Int {{ n }}\n"
    profile: jet_cli_perf_samples_profile(jet_cli_perf_source("fib.jet", text), sampled) ?? panic("fib's line holds samples")
    assert(profile.reason.starts_with("one CPU-time sample per 125 microseconds of each thread's CPU time"), profile.reason)
    assert(profile.reason.contains("; it kept 3 of the 3 samples that 0 ms of CPU time under sampling gives"), profile.reason)
    assert(profile.reason.contains("; 3 samples the zones window's file held from outside the window count nowhere"), profile.reason)
    assert_eq(profile.overhead_status, "measured")
    assert_eq(profile.overhead_ns, Val(U64{6000}))
    assert_eq(profile.overhead_runtime_ns, Val(U64{6000}))
    assert_eq(profile.overhead_kernel_ns, Val(U64{0}))
    // Without a window, the same file's samples all count, at a run's interval.
    again: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    all: jet_cli_perf_samples_count(again, [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}}, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(all.total, U64{6})
    assert_eq(all.interval_us, JET_CLI_PERF_SAMPLE_US)
    assert_eq(all.counts.len(), 6)
    assert_eq(all.ends[1], 800000)
}

// A trace's CPU-time samples stand for the interval its `perf` receipt
// names: an attach's flight ring 10000 microseconds each, not a run's 125.
// The view and the pprof export charge them at it; a trace that names none
// is charged no CPU time.
#Test("CPU-time samples are charged at the interval the trace's perf receipt names, and at none without one") {
    perf: `{"name":"perf","value":{"capture":{"sampling":{"interval_us":10000}}}}`
    trace: canonical_json_parse("{{\"content\":{{\"receipt_sections\":[{perf}]}}}}\n".bytes()) ?? panic(err.message)
    assert(jet_cli_perf_sample_us(trace) == Val(10000))
    lines: jet_cli_perf_flame_profile([JetCLIPerfProfileRow]{JetCLIPerfProfileRow{symbol: "live.jet#tick", clock: "cpu", weight: 3, line: Val(13), inclusive: None, allocations: None, events: ""}}, jet_cli_perf_sample_us(trace))
    assert_eq(lines[0], "live.jet#tick profile:cpu samples=3 cpu_us=30000 share=100%")
    assert_eq(lines[1], "  line 13 samples=3 cpu_us=30000")
    exported: jet_cli_perf_pprof_read(jet_cli_perf_pprof_profile(trace)) ?? panic(err.message)
    assert(exported.interval_us == Val(10000))
    bare: canonical_json_parse("{{\"content\":{{\"receipt_sections\":[]}}}}\n".bytes()) ?? panic(err.message)
    assert(jet_cli_perf_sample_us(bare) == None)
    uncharged: jet_cli_perf_flame_profile([JetCLIPerfProfileRow]{JetCLIPerfProfileRow{symbol: "live.jet#tick", clock: "cpu", weight: 3, line: Val(13), inclusive: None, allocations: None, events: ""}}, jet_cli_perf_sample_us(bare))
    assert_eq(uncharged[0], "live.jet#tick profile:cpu samples=3 share=100%")
    assert((jet_cli_perf_pprof_read(jet_cli_perf_pprof_profile(bare)) ?? panic(err.message)).interval_us == None)
}

// A killed profiled program's files are swept by the process their name
// holds: a flight ring's program, a session's or an attach's own pid.
#Test("a profiling file names its process, and no other file does") {
    assert_eq(jet_cli_perf_file_pid("jet-flight-4123.samples"), Val(4123))
    assert_eq(jet_cli_perf_file_pid("jet-flight-4123.samples.spans"), Val(4123))
    assert_eq(jet_cli_perf_file_pid("jet-perf-77-1700000000.samples.image"), Val(77))
    assert_eq(jet_cli_perf_file_pid("jet-perf-attach-90-4123-1700000000.spans"), Val(90))
    assert_eq(jet_cli_perf_file_pid("jet-perf-zone-clock-12.spans"), None)
    assert_eq(jet_cli_perf_file_pid("jet-flight-4123"), None)
    assert_eq(jet_cli_perf_file_pid("jet-flight-0.samples"), None)
    assert_eq(jet_cli_perf_file_pid("jet-observe-4123.json"), None)
}

// A short task can start and end between two observations, so none sees
// it: its spawn record, which names its spawner, gives it a done task's row
// under the spawner's, and the join on it names it, the line that spawned
// it and its wake.
#Test("a task no observation saw gets a row under its spawner's, which the join on it names") {
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}}
    words: jet_cli_perf_test_words(
        [Int]{
            // Task 1 spawns task 5 at a call site of fib.
            5 | (3 << 48) | (15 << 59),
            1,
            4112,
            // Task 1 joins task 5 on slot 64, from 100 to 200 ns, with no
            // name, addresses or stack.
            1 | (6 << 48) | (14 << 59),
            64,
            100,
            200,
            5 | (1 << 48),
            0,
            // Task 5 wakes slot 64 at 150 ns as it ends.
            5 | (3 << 48) | (12 << 59),
            64,
            150,
        },
    )
    sampled := jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.spawns.len(), 1)
    observations: [JetCLIPerfObservation]{JetCLIPerfObservation{at_ns: U64{10}, live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(1))}}
    capture := jet_cli_perf_capture_source("fib.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    jet_cli_perf_waits_read(capture, sampled.waits.move(), sampled.wakes.move(), sampled.spawns.move(), [U64:U64]{}, sampled.transfers.move(), "fib.jet", 0)
    assert_eq(capture.tasks.len(), 2)
    assert_eq(capture.tasks[1].id, U64{2})
    assert_eq(capture.tasks[1].parent, U64{1})
    assert_eq(capture.tasks[1].state, "done")
    join: capture.spans[capture.spans.len() - 1]
    assert_eq(join.kind, "task_wait")
    assert_eq(join.task_id, Val(U64{1}))
    assert_eq(join.awaited_task_id, Val(U64{2}))
    assert_eq(join.spawn_line, Val(U64{5}))
    assert_eq(join.waker, "task")
    assert_eq(join.waker_task_id, Val(U64{2}))
    toolchain: TraceToolchain{jet_version: "test", compiler_build_id: "test", stdlib_id: "test", runner_id: "test"}
    hardware: TraceHardware{cpu_arch: "x86_64", logical_cpus: U64{1}, os: "linux", target: "x86_64-unknown-linux-gnu"}
    _: jet_cli_perf_capture_bytes(capture, "run", [String]{"fib.jet"}, toolchain, hardware) ?? panic(err.message)
}

// A socket's wait the runtime woke ends by its peer's act, outside the
// program: the span names its peer and neither a task nor a line, even when
// the runtime's wake carried a line on its stack.
#Test("a socket's wait the runtime woke names its peer and no line") {
    observations: [JetCLIPerfObservation]{JetCLIPerfObservation{at_ns: U64{10}, live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(1))}}
    capture := jet_cli_perf_capture_source("fib.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    waits := [JetCLIPerfWait]{JetCLIPerfWait{task: U64{1}, slot: 64, start_ns: 100, end_ns: 200, class: JET_CLI_PERF_OBJECT_SOCKET, id: U64{3}, local: "127.0.0.1:4000", peer: "127.0.0.1:5000", name: "tcp read", frames: [TraceStackFrame]{}}}
    wakes: [JetCLIPerfWake]{JetCLIPerfWake{task: U64{0}, slot: 64, at_ns: 150, line: Val(7)}}
    jet_cli_perf_waits_read(capture, waits, wakes, [JetCLIPerfSpawn]{}, [U64:U64]{}, [JetCLIPerfIO]{}, "fib.jet", 0)
    wait: capture.spans[capture.spans.len() - 1]
    assert_eq(wait.kind, "task_wait")
    assert_eq(wait.waker, "peer")
    assert_eq(wait.waker_task_id, None)
    assert_eq(wait.waker_line, None)
    toolchain: TraceToolchain{jet_version: "test", compiler_build_id: "test", stdlib_id: "test", runner_id: "test"}
    hardware: TraceHardware{cpu_arch: "x86_64", logical_cpus: U64{1}, os: "linux", target: "x86_64-unknown-linux-gnu"}
    _: jet_cli_perf_capture_bytes(capture, "run", [String]{"fib.jet"}, toolchain, hardware) ?? panic(err.message)
}

// A connect is an I/O record (operation 2) that moved nothing: it is no I/O
// row and no wait, and it is what names the task a listener's accept was
// waiting for, whether or not the connect itself ever had to wait.
#Test("a connect's record names the task that ended an accept, and is no I/O row and no wait") {
    // 127.0.0.1:4000, then 127.0.0.1:5000, as sockaddr_in words: family 2,
    // the big-endian port, the host and 8 bytes of padding.
    listener: 0x0100007FA00F0002
    client: 0x0100007F88130002
    socket: 3 << 8
    words: jet_cli_perf_test_words(
        [Int]{
            // Task 2 connects to the listener from 150 to 160 ns, the peer's
            // 16 bytes then its own, with no stack.
            2 | (10 << 48) | (11 << 59),
            2 | socket | (16 << 16),
            150,
            160,
            0,
            32,
            listener,
            0,
            client,
            0,
            // Then writes 4 bytes to it from 400 to 410 ns.
            2 | (10 << 48) | (11 << 59),
            1 | socket | (16 << 16),
            400,
            410,
            4,
            32,
            listener,
            0,
            client,
            0,
        },
    )
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}}
    sampled := jet_cli_perf_samples_count(table, functions, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.transfers.len(), 2)
    assert_eq(sampled.transfers[0].operation, 2)
    assert_eq(sampled.transfers[0].target, "127.0.0.1:4000")
    assert_eq(sampled.transfers[0].local, "127.0.0.1:5000")
    observations: [JetCLIPerfObservation]{JetCLIPerfObservation{at_ns: U64{10}, live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(1))}}
    capture := jet_cli_perf_capture_source("fib.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    // Task 1's accept on the listener from 100 to 300 ns, which the
    // runtime's poller woke at 290 ns.
    waits := [JetCLIPerfWait]{JetCLIPerfWait{task: U64{1}, slot: 64, start_ns: 100, end_ns: 300, class: JET_CLI_PERF_OBJECT_SOCKET, id: U64{3}, local: "127.0.0.1:4000", peer: "", name: "tcp accept", frames: [TraceStackFrame]{}}}
    wakes: [JetCLIPerfWake]{JetCLIPerfWake{task: U64{0}, slot: 64, at_ns: 290, line: None}}
    spawns: [JetCLIPerfSpawn]{JetCLIPerfSpawn{task: U64{2}, parent: U64{1}, line: None}}
    spans: capture.spans.len()
    jet_cli_perf_waits_read(capture, waits, wakes, spawns, [U64:U64]{}, sampled.transfers, "fib.jet", 0)
    assert_eq(capture.spans.len(), spans + 1)
    accept: capture.spans[capture.spans.len() - 1]
    assert_eq(accept.symbol.name, "tcp accept")
    assert_eq(accept.waker, "task")
    assert_eq(accept.waker_task_id, Val(U64{2}))
    jet_cli_perf_io_read(capture, sampled.transfers.move(), "fib.jet", 0)
    assert_eq(capture.io.len(), 1)
    assert_eq(capture.io[0].operation, "write")
    assert_eq(capture.io[0].bytes, U64{4})
    assert_eq(capture.io[0].task_id, Val(U64{2}))
}

// An outside attach's `functions` section, as `jet perf view` prints it:
// each function with its declaration, how far its stacks unwound, its
// samples by package as a run's profile prints them, and the flame graph of
// its folded stacks.
#Test("an outside attach's view names each function's declaration, its stacks' quality, its packages as a run's profile does, and a flame graph") {
    section: `{"broken":4,"cut":0,"exited_ms":null,"functions":[{"file":"Compiler/JetSema/Source/Statements.jet","line":212,"name":"Statements.sema_stmt_check","self":60,"total":90},{"name":"main","self":0,"total":100}],"lost":0,"packages":[{"package":"Compiler/JetSema","samples":70},{"package":"","samples":20},{"package":"Compiler/JetIR","samples":10}],"period_ns":1000000,"processes":2,"samples":100,"stacks":[{"samples":30,"stack":"main"},{"samples":70,"stack":"main;Statements.sema_stmt_check"}],"threads":3,"unnamed":5,"unwound":96,"window_ms":1000}`
    value: canonical_json_parse("{section}\n".bytes()) ?? panic(err.message)
    assert_eq(
        jet_cli_perf_outside_lines(value),
        [String]{
            "functions samples=100 processes=2 threads=3 window_ms=1000 lost=0 unnamed=5",
            "stacks unwound=96 cut=0 broken=4",
            "  60.0% self  90.0% total · Statements.sema_stmt_check at Compiler/JetSema/Source/Statements.jet:212",
            "  0.0% self  100.0% total · main",
            "cpu by package",
            "  Compiler/JetSema samples=70 cpu_us=70000 share=70%",
            "  (none) samples=20 cpu_us=20000 share=20%",
            "  Compiler/JetIR samples=10 cpu_us=10000 share=10%",
        },
    )
    assert_eq(jet_cli_perf_outside_flame(value), [String]{"0 main 100.0% {"#".repeat(40)}", "1 Statements.sema_stmt_check 70.0% {"#".repeat(28)}"})
}

// A `--for=` window the process exited in says so after its `functions`
// line, with the window it asked for.
#Test("an outside attach's view says when the process exited in its window") {
    section: `{"broken":0,"cut":0,"exited_ms":420,"functions":[{"name":"main","self":10,"total":10}],"lost":0,"packages":[],"period_ns":1000000,"processes":1,"samples":10,"stacks":[{"samples":10,"stack":"main"}],"threads":1,"unnamed":0,"unwound":10,"window_ms":3000}`
    value: canonical_json_parse("{section}\n".bytes()) ?? panic(err.message)
    assert_eq(
        jet_cli_perf_outside_lines(value),
        [String]{
            "functions samples=10 processes=1 threads=1 window_ms=3000 lost=0 unnamed=0",
            "exited 420 ms into the 3000 ms window",
            "stacks unwound=10 cut=0 broken=0",
            "  100.0% self  100.0% total · main",
        },
    )
}

// A function's object in the `functions` section is A-canonical, with its
// declaration or without, so the trace that holds it verifies.
#Test("an outside attach's function rows are A-canonical, with a declaration or without") {
    declared: jet_cli_perf_outside_function(JetCLIPerfOutsideRow{name: "Statements.sema_stmt_check", own: 60, total: 90, seen: -1, file: "Compiler/JetSema/Source/Statements.jet", line: 212, package: "Compiler/JetSema", root: false})
    bare: jet_cli_perf_outside_function(JetCLIPerfOutsideRow{name: "main", own: 0, total: 100, seen: -1, file: "", line: 0, package: "", root: true})
    assert_eq(String.from_bytes(canonical_json_bytes(declared)) ?? "", "{{\"file\":\"Compiler/JetSema/Source/Statements.jet\",\"line\":212,\"name\":\"Statements.sema_stmt_check\",\"self\":60,\"total\":90}}\n")
    assert_eq(String.from_bytes(canonical_json_bytes(bare)) ?? "", "{{\"name\":\"main\",\"self\":0,\"total\":100}}\n")
    _: canonical_json_parse(canonical_json_bytes(declared)) ?? panic(err.message)
    _: canonical_json_parse(canonical_json_bytes(bare)) ?? panic(err.message)
}

// A folded stack holds at least one sample in 100; a rarer one's samples
// count in the stack it was called from.
#Test("an outside attach folds each sample's stack, a rare one into its caller's") {
    names: [String]{"main", "work", "rare"}
    rows: loop name in names -> JetCLIPerfOutsideRow{name: name, own: 0, total: 0, seen: -1, file: "", line: 0, package: "", root: false}
    tree := JetCLIPerfOutsideTree{rows: [Int]{}, parents: [Int]{}, totals: [Int]{}, children: [Int:Int]{}}
    loop _ in 0..<150 -> jet_cli_perf_outside_tree_add(tree, [Int]{1, 0})
    loop _ in 0..<49 -> jet_cli_perf_outside_tree_add(tree, [Int]{0})
    jet_cli_perf_outside_tree_add(tree, [Int]{2, 1, 0})
    stacks: jet_cli_perf_outside_folded(tree, rows, 200)
    assert_eq(stacks.len(), 2)
    assert_eq(stacks[0].stack, "main")
    assert_eq(stacks[0].samples, 49)
    assert_eq(stacks[1].stack, "main;work")
    assert_eq(stacks[1].samples, 151)
}

// Past the task row limit, the tasks with the fewest CPU-time samples have
// no row; the `tasks` section still counts each, with its samples, in its
// phase.
#Test("tasks past the row limit fold into their phases with their samples, the fewest samples first") {
    observations: [JetCLIPerfObservation]{JetCLIPerfObservation{at_ns: U64{10}, live: jet_cli_perf_live_from(jet_cli_perf_test_snapshot(1))}}
    capture := jet_cli_perf_capture_source("fib.jet", "run: fn() -> Int {{ 1 }}", observations, None, "x86_64-unknown-linux-gnu", None) ?? panic(err.message)
    // Task 1 spawns tasks 2 to 4100: 4099 tasks beside it, 4 past the 4096
    // rows. Tasks 2 to 5 took one sample each, the rest two, and task 1
    // three; tasks 2 to 2049 opened `parse`, the rest `lower`.
    spawns := [JetCLIPerfSpawn]{}
    samples := [U64:U64]{}
    samples[U64{1}] = U64{3}
    loop task in 2..<4101 {
        spawns.push(JetCLIPerfSpawn{task: U64{task}, parent: U64{1}, line: None})
        samples[U64{task}] = if task <= 5 -> U64{1} else -> U64{2}
        capture.task_phases[U64{task}] = if task <= 2049 -> "parse" else -> "lower"
    }
    jet_cli_perf_waits_read(capture, [JetCLIPerfWait]{}, [JetCLIPerfWake]{}, spawns, samples, [JetCLIPerfIO]{}, "fib.jet", 0)
    assert_eq(capture.tasks.len(), 4096)
    assert(capture.policy.task_rows_truncated)
    assert(!capture.task_ids.has_key(U64{2}))
    assert(!capture.task_ids.has_key(U64{5}))
    assert(capture.task_ids.has_key(U64{6}))
    assert(capture.task_ids.has_key(U64{4100}))
    section: jet_cli_perf_tasks_section(capture.task_ids, capture.task_phases, spawns, samples) ?? panic("the run has tasks")
    assert_eq(section.type_name, "JetPerfTasks")
    expected: `{"count":4100,"coverage":"complete","phases":[{"folded":0,"folded_samples":0,"name":"lower","samples":4102,"tasks":2051},{"folded":4,"folded_samples":4,"name":"parse","samples":4092,"tasks":2048},{"folded":0,"folded_samples":0,"name":null,"samples":3,"tasks":1}],"rows":4096,"unattributed_samples":0}`
    assert_eq(String.from_bytes(canonical_json_bytes(section.value)) ?? "", "{expected}\n")
    capture.receipts.push(section)
    toolchain: TraceToolchain{jet_version: "test", compiler_build_id: "test", stdlib_id: "test", runner_id: "test"}
    hardware: TraceHardware{cpu_arch: "x86_64", logical_cpus: U64{1}, os: "linux", target: "x86_64-unknown-linux-gnu"}
    _: jet_cli_perf_capture_bytes(capture, "run", [String]{"fib.jet"}, toolchain, hardware) ?? panic(err.message)
}

// A task that opened no zone or log span takes its spawner's phase; the
// samples of a task the run recorded no spawn of count in none.
#Test("a task's phase is its spawner's when it opened none, and an unrecorded task's samples leave the coverage partial") {
    rowed := [U64:U64]{}
    rowed[U64{1}] = U64{1}
    rowed[U64{2}] = U64{2}
    named := [U64:String]{}
    named[U64{2}] = "parse"
    spawns: [JetCLIPerfSpawn]{JetCLIPerfSpawn{task: U64{2}, parent: U64{1}, line: None}, JetCLIPerfSpawn{task: U64{3}, parent: U64{2}, line: None}, JetCLIPerfSpawn{task: U64{4}, parent: U64{1}, line: None}}
    samples := [U64:U64]{}
    samples[U64{1}] = U64{1}
    samples[U64{3}] = U64{2}
    samples[U64{4}] = U64{4}
    samples[U64{7}] = U64{5}
    section: jet_cli_perf_tasks_section(rowed, named, spawns, samples) ?? panic("the run has tasks")
    expected: `{"count":4,"coverage":"partial","phases":[{"folded":1,"folded_samples":4,"name":null,"samples":5,"tasks":2},{"folded":1,"folded_samples":2,"name":"parse","samples":2,"tasks":2}],"rows":2,"unattributed_samples":5}`
    assert_eq(String.from_bytes(canonical_json_bytes(section.value)) ?? "", "{expected}\n")
}

// The profile row of line `at + 1` of a.jet in function `name`, hotter for
// a lower `at`.
jet_cli_perf_test_line_row: fn(digest: String, at: Int, name: String) -> TraceProfileRow Never! {
    source: TraceProfileSource{path: "a.jet", sha256: digest, start_line: U64{at + 1}, start_column: U64{1}, end_line: U64{at + 1}, end_column: U64{9}}
    TraceProfileRow{clock: "cpu", allocation_count: Val(U64{1}), dtlb_miss_count: None, execution_count: None, inclusive_count: Val(U64{6000}), l1d_miss_count: None, llc_miss_count: None, page_fault_count: None, sample_count: U64{5000 - at}, sample_weight: U64{5000 - at}, source: source, symbol: JetSymbolRef{path: "a.jet", name: name}}
}

// One profile row per line, hottest first: past the row limit the coldest
// lines fold by function, or by source when the functions alone pass it.
#Test("profile rows past the row limit fold by function, else by source, keeping every sample") {
    digest: sha256_hex("run")
    by_function := [TraceProfileRow]{}
    by_source := [TraceProfileRow]{}
    loop at in 0..<4100 {
        by_function.push(jet_cli_perf_test_line_row(digest, at, if at < 4090 -> "hot" else -> "cold"))
        by_source.push(jet_cli_perf_test_line_row(digest, at, "f{at}"))
    }
    // Rows 4095 to 4099, all of `cold`, fold into one.
    fold: jet_cli_perf_profile_fold(by_function)
    assert_eq(fold.rows.len(), 4096)
    assert_eq(fold.dropped, U64{0})
    last: fold.rows[4095]
    assert_eq(last.symbol.name, "cold")
    assert_eq(last.sample_count, U64{905 + 904 + 903 + 902 + 901})
    assert_eq(last.allocation_count, Val(U64{5}))
    assert_eq(last.inclusive_count, None)
    assert_eq(last.source.start_line, U64{4096})
    assert_eq(last.source.end_line, U64{4100})
    assert_eq(fold.note, "; past the 4096-row limit its 5 coldest lines fold into 1 rows, one per function, each from its first folded line to its last")
    // Each line its own function: they fold by source, named by how many.
    folded: jet_cli_perf_profile_fold(by_source)
    assert_eq(folded.rows.len(), 4096)
    assert_eq(folded.rows[4095].symbol.name, "5 functions")
    assert_eq(folded.rows[4095].sample_count, U64{4515})
    assert(folded.note.contains("one per source, named by how many functions it holds"))
}

#Test("a heap snapshot's blocks count by their line and by the type their innermost typed allocating call names") {
    table: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: 0}}}
    words: jet_cli_perf_test_words(
        [Int]{
            // Snapshot 1, `exit`: 3 blocks, 112 bytes, its 4-byte name.
            1 | (5 << 48) | (10 << 59),
            3,
            112,
            4,
            0x74697865,
            // 2 blocks of 96 bytes the runtime allocated for fib's typed call
            // returning to 12300, which fib's line 5 made.
            1 | (5 << 48) | (9 << 59),
            2,
            96,
            12300,
            4160,
            // 1 block of 16 bytes an untyped call at the same line allocated.
            1 | (4 << 48) | (9 << 59),
            1,
            16,
            4170,
        },
    )
    allocs: [Int:Int]{12300: 77}
    names: [Int:String]{77: "[I64]"}
    sampled: jet_cli_perf_samples_count(table, [X64ImageFunction]{}, JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: [Int:NativeAbstract]{}}, [Bool]{true}, [U64]{}, allocs, names, words, 0)
    assert_eq(sampled.heaps.len(), 1)
    heap: sampled.heaps[0]
    assert_eq(heap.name, "exit")
    assert_eq(heap.sites.len(), 2)
    assert_eq(heap.sites[0].type_name, "[I64]")
    assert_eq(heap.sites[0].line, U64{5})
    assert_eq(heap.sites[0].bytes, U64{96})
    assert_eq(heap.sites[1].type_name, "")
    assert_eq(heap.sites[1].line, U64{5})
    assert_eq(heap.sites[1].blocks, U64{1})
}

#Test("a heap snapshot's typed blocks are retained along the shortest path from a root, named by its variable and its types' fields") {
    word: NativeType{name: "Int", size: 8, tag: 0x24, encoding: X64DebugEncoding.Signed, target: -1, group: -1}
    types: [Int:NativeType]{
        100: word,
        // struct Room {id: Int, history: [Message]}, and the lists.
        10: NativeType{name: "Room", size: 32, tag: NATIVE_TAG_STRUCT, encoding: X64DebugEncoding.Unsigned, target: -1, group: 0},
        20: NativeType{name: "[Message]", size: 24, tag: NATIVE_TAG_STRUCT, encoding: X64DebugEncoding.Unsigned, target: -1, group: -1},
        40: NativeType{name: "[Room]", size: 24, tag: NATIVE_TAG_STRUCT, encoding: X64DebugEncoding.Unsigned, target: -1, group: -1},
        80: NativeType{name: "Message", size: 16, tag: NATIVE_TAG_STRUCT, encoding: X64DebugEncoding.Unsigned, target: -1, group: 1},
        // What the typed allocating calls allocate for: a list's buffer of
        // rooms, one of messages.
        50: NativeType{name: "[Room]", size: 0, tag: NATIVE_TAG_TYPEDEF, encoding: X64DebugEncoding.Unsigned, target: 51, group: -1},
        51: NativeType{name: "", size: 8, tag: NATIVE_TAG_POINTER, encoding: X64DebugEncoding.Unsigned, target: 10, group: -1},
        70: NativeType{name: "[Message]", size: 0, tag: NATIVE_TAG_TYPEDEF, encoding: X64DebugEncoding.Unsigned, target: 71, group: -1},
        71: NativeType{name: "", size: 8, tag: NATIVE_TAG_POINTER, encoding: X64DebugEncoding.Unsigned, target: 80, group: -1},
    }
    members: [[NativeMember]]{
        [NativeMember]{NativeMember{name: "id", offset: 0, ty: 100, die: 0}, NativeMember{name: "history", offset: 8, ty: 20, die: 0}},
        [NativeMember]{NativeMember{name: "id", offset: 0, ty: 100, die: 0}, NativeMember{name: "body", offset: 8, ty: 100, die: 0}},
    }
    // `rooms` lives at rbp-16 over [4096, 4352): DW_LLE_offset_pair 0, 256,
    // then DW_OP_fbreg -16.
    rooms: NativeVariable{name: "rooms", line: 3, ty: 40, list: 0, base: 4096, role: NativeVariableRole.Local, site: -1}
    facts: NativeImage{lines: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, functions: [NativeFunction]{NativeFunction{low: 4096, high: 4352, name: "serve", file: -1, variables: [NativeVariable]{rooms}, inlined: [NativeInlined]{}}}, types: types, members: members, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: [U8]{0x04, 0x00, 0x80, 0x02, 0x02, 0x91, 0x70, 0x00}, abstracts: [Int:NativeAbstract]{}, allocs: [Int:Int]{}}
    heap := JetCLIPerfHeap{
        number: U64{1},
        name: "exit",
        blocks: U64{3},
        bytes: U64{192},
        sites: [JetCLIPerfHeapSite]{},
        groups: [Int]{50, 70},
        live: [JetCLIPerfHeapBlock]{
            // The rooms' buffer: room 1's history's buffer pointer, at
            // 32 + 8 + 16.
            JetCLIPerfHeapBlock{address: 0x10000, size: 96, group: 1, refs: [JetCLIPerfHeapRef]{JetCLIPerfHeapRef{offset: 56, target: 0x20000}}},
            JetCLIPerfHeapBlock{address: 0x20000, size: 48, group: 2, refs: [JetCLIPerfHeapRef]{}},
            // Messages no root reaches.
            JetCLIPerfHeapBlock{address: 0x30000, size: 48, group: 2, refs: [JetCLIPerfHeapRef]{}},
        },
        frames: [JetCLIPerfHeapFrame]{JetCLIPerfHeapFrame{pc: 4100, base: 0x7000, low: 0x6f00}},
        roots: [JetCLIPerfHeapRoot]{JetCLIPerfHeapRoot{address: 0x6ff0, target: 0x10000, data: false}},
        retained: [JetCLIPerfRetained]{},
    }
    jet_cli_perf_heap_retain(facts, [JetCLIPerfHeapObject]{}, [Int:String]{50: "[Room]", 70: "[Message]"}, heap)
    assert_eq(heap.live.len(), 0)
    assert_eq(heap.retained.len(), 3)
    assert_eq(heap.retained[0].type_name, "[Message]")
    assert_eq(heap.retained[0].path, "rooms[1].history")
    assert_eq(heap.retained[0].bytes, U64{48})
    assert_eq(heap.retained[1].type_name, "[Message]")
    assert_eq(heap.retained[1].path, "")
    assert_eq(heap.retained[2].type_name, "[Room]")
    assert_eq(heap.retained[2].path, "rooms")
    assert_eq(heap.retained[2].blocks, U64{1})
}

#Test("`--retained-by` names a type by its whole name or its last part, and lists the paths that retain it") {
    retained: [JetCLIPerfHeapRetention]{
        JetCLIPerfHeapRetention{type_name: "chat.Message", path: "rooms[1].history", blocks: 2, bytes: 64},
        JetCLIPerfHeapRetention{type_name: "chat.Message", path: "", blocks: 1, bytes: 32},
        JetCLIPerfHeapRetention{type_name: "Room", path: "rooms", blocks: 1, bytes: 96},
    }
    snapshots: [JetCLIPerfHeapSnapshot]{JetCLIPerfHeapSnapshot{name: "exit", blocks: 4, bytes: 192, places: [JetCLIPerfHeapPlace]{}, retained: retained}}
    assert_eq(jet_cli_perf_heap_retention_lines(snapshots, "Message"), [String]{"retained chat.Message at exit  3 blocks  96 bytes", "  rooms[1].history  2 blocks  64 bytes", "  no root reached (another thread's stack or a register holds them)  1 blocks  32 bytes"})
    assert_eq(jet_cli_perf_heap_retention_lines(snapshots, "chat.Message").len(), 3)
    assert_eq(jet_cli_perf_heap_retention_lines(snapshots, "Ring").len(), 0)
    assert_eq(jet_cli_perf_heap_types(snapshots), "; they keep Room, chat.Message")
}

#Test("perf samples in inlined code count at the inlined line and inclusive at the call") {
    // run's code at 0x1000: its rows give line 6 at 0x1000 (sum_squares's
    // body, inlined), 14 at 0x1040, 3 at 0x1080 (max's body, inlined from
    // file 2) and 15 at 0x1090.
    rows: [U8]{0, 5, 0x80, 1, 8, 0x80, 1, 117, 32, 12}
    table: X64Jetline{table: rows, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "run", file: "prog.jet", dir: "", decl: 10, rows: 0, rows_end: 10}}}
    runs: [NativeInlined]{
        NativeInlined{die: 10, origin: 1, low: 4096, high: 4160, call_line: 14, parent: -1, file: 1, call_file: 1},
        NativeInlined{die: 20, origin: 2, low: 4224, high: 4240, call_line: 15, parent: -1, file: 2, call_file: 1},
    }
    inlines: JetCLIPerfInlines{functions: [Int:NativeFunction]{4096: NativeFunction{low: 4096, high: 4352, name: "run", file: 1, variables: [NativeVariable]{}, inlined: runs}}, abstracts: [Int:NativeAbstract]{1: NativeAbstract{name: "sum_squares", file: 1}, 2: NativeAbstract{name: "max", file: 2}}}
    one: 1 << 48
    two: 2 << 48
    words: jet_cli_perf_test_words(
        [Int]{
            // In sum_squares's inlined body.
            4112 | one,
            // In max's, from another file.
            4228 | one,
            // At run's line 14, called from the call that returns to
            // 0x1010, inside sum_squares's run.
            4176 | two,
            4112,
        },
    )
    sampled: jet_cli_perf_samples_count(table, [X64ImageFunction]{}, inlines, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.total, U64{3})
    text := ""
    loop _ in 0..<16 -> text = "{text}line\n"
    profile: jet_cli_perf_samples_profile(jet_cli_perf_source("prog.jet", text), sampled) ?? panic("run's lines hold samples")
    found := 0
    loop row in profile.rows {
        line: row.source.start_line
        if line == (U64{6}) {
            assert_eq(row.symbol.name, "sum_squares")
            assert_eq(row.sample_count, U64{1})
            assert_eq(row.inclusive_count, Val(U64{2}))
            found += 1
        }
        if line == (U64{14}) {
            assert_eq(row.symbol.name, "run")
            assert_eq(row.sample_count, U64{1})
            assert_eq(row.inclusive_count, Val(U64{2}))
            found += 1
        }
        if line == (U64{15}) {
            assert_eq(row.symbol.name, "run")
            assert_eq(row.sample_count, U64{0})
            assert_eq(row.inclusive_count, Val(U64{1}))
            found += 1
        }
        // max's line 3 is in its own file, not prog.jet.
        assert(line != (U64{3}))
    }
    assert_eq(found, 3)
    assert(profile.reason.contains("; 1 of 3 samples are outside prog.jet"))
}

#Test("a causal rate counts each experiment's passes after its first over the time from its first pass to its last, less the delay inserted meanwhile") {
    experiments := [JetCLIPerfExperiment]{}
    // Baselines: 4 passes after the first in 20 ms, a pass each 5 ms. The
    // line's experiments: 4 in 22 ms with 6 ms of it inserted delay, a pass
    // each 4 ms, 20% sooner. Each thread has a CPU: they never wait for one,
    // and their CPUs stay within 2% of one clock.
    loop _ in 0..<6 {
        experiments.push(JetCLIPerfExperiment{line: U64{0}, name: "", speedup: 0, run_ns: 25000000, wait_ns: 0, khz_high: 4900000, khz_low: 4800000, after: [Int]{4}, span_ns: [Int]{20000000}, span_delay_ns: [Int]{0}})
        experiments.push(JetCLIPerfExperiment{line: U64{30}, name: "narrow", speedup: 300, run_ns: 25000000, wait_ns: 0, khz_high: 4900000, khz_low: 4800000, after: [Int]{4}, span_ns: [Int]{22000000}, span_delay_ns: [Int]{6000000}})
    }
    section: jet_cli_perf_causal_section("main.jet", experiments, [Int:String]{0: "round"}, [Int]{})
    json: String.from_bytes(canonical_json_bytes(section.value)) ?? panic("the section is UTF-8")
    assert(json.contains(`{"experiments":6,"function":"narrow","gain_tenths":200,"high_tenths":200,"line":30,"low_tenths":200}`))
    assert(json.contains(`"cpu_run_ms":300,"cpu_wait_ms":0,`))
    assert(json.contains(`"clock_fit":{"cells":[],"r2_thousandths":0,"refused":"the run wrote no idle table","slope_thousandths":0},"clock_flag":null,"clock_high_mhz":4900,"clock_low_mhz":4800,`))
    assert(json.contains(`"refused":null`))
}

#Test("a causal run whose CPUs clocked down between experiments, with no fit of how that slows its tasks, keeps its gains, flagged with the drop") {
    experiments := [JetCLIPerfExperiment]{}
    // The same rates, but each experiment ended with one of the CPUs that
    // ran the program's threads at 3,908 MHz beside one at 4,993: a CPU
    // that idled clocked down. An experiment whose clocks could not be read
    // counts in neither mean.
    loop _ in 0..<6 {
        experiments.push(JetCLIPerfExperiment{line: U64{0}, name: "", speedup: 0, run_ns: 25000000, wait_ns: 0, khz_high: 4993000, khz_low: 3908000, after: [Int]{4}, span_ns: [Int]{20000000}, span_delay_ns: [Int]{0}})
        experiments.push(JetCLIPerfExperiment{line: U64{30}, name: "narrow", speedup: 300, run_ns: 25000000, wait_ns: 0, khz_high: 4993000, khz_low: 3908000, after: [Int]{4}, span_ns: [Int]{22000000}, span_delay_ns: [Int]{6000000}})
    }
    experiments.push(JetCLIPerfExperiment{line: U64{0}, name: "", speedup: 0, run_ns: 25000000, wait_ns: 0, khz_high: 0, khz_low: 0, after: [Int]{4}, span_ns: [Int]{20000000}, span_delay_ns: [Int]{0}})
    section: jet_cli_perf_causal_section("main.jet", experiments, [Int:String]{0: "round"}, [Int]{})
    json: String.from_bytes(canonical_json_bytes(section.value)) ?? panic("the section is UTF-8")
    assert(json.contains(`"clock_flag":"gains may under-read: idle CPUs clocked down 21.7% (4993 MHz to 3908 MHz) between experiments, above the 10.0% the lens trusts, and it could not fit how much slower a task runs after its CPU idled (the run wrote no idle table): `))
    assert(json.contains(`"clock_high_mhz":4993,"clock_low_mhz":3908,`))
    // The gains stay, and the run is not refused.
    assert(json.contains(`{"experiments":6,"function":"narrow","gain_tenths":200,"high_tenths":200,"line":30,"low_tenths":200}`))
    assert(json.contains(`"refused":null`))
}

#Test("a causal run's gains are warmed by the fit of how much slower a task runs the longer its CPU idled, which unflags a clock drop") {
    experiments := [JetCLIPerfExperiment]{}
    // The clocked-down run's rates: virtually, the line makes a round 20%
    // sooner.
    loop _ in 0..<6 {
        experiments.push(JetCLIPerfExperiment{line: U64{0}, name: "", speedup: 0, run_ns: 25000000, wait_ns: 0, khz_high: 4993000, khz_low: 3908000, after: [Int]{4}, span_ns: [Int]{20000000}, span_delay_ns: [Int]{0}})
        experiments.push(JetCLIPerfExperiment{line: U64{30}, name: "narrow", speedup: 300, run_ns: 25000000, wait_ns: 0, khz_high: 4993000, khz_low: 3908000, after: [Int]{4}, span_ns: [Int]{22000000}, span_delay_ns: [Int]{6000000}})
    }
    // One task body's row: 100 tasks after 8 µs idle ran 1.0 ms each, 100
    // after 32 µs 1.1 ms and 100 after 128 µs 1.2 ms. Against the body's
    // mean of 1.1 ms that is 909, 1000 and 1090 thousandths, 45 more per
    // octave of idle.
    runs: [Int:Int]{3: 100000000, 5: 110000000, 7: 120000000}
    gaps: [Int:Int]{3: 800000, 5: 3200000, 7: 12800000}
    idle := [Int]{16384}
    loop octave in 0..<16 {
        idle.push(if runs.get(octave) == None -> 0 else -> 100)
        idle.push(runs.get(octave) ?? 0)
        idle.push(gaps.get(octave) ?? 0)
    }
    section: jet_cli_perf_causal_section("main.jet", experiments, [Int:String]{0: "round"}, idle)
    json: String.from_bytes(canonical_json_bytes(section.value)) ?? panic("the section is UTF-8")
    assert(json.contains(`"clock_fit":{"cells":[{"fitted":true,"gap_us":8,"residual_thousandths":0,"slowness_thousandths":909,"tasks":100},{"fitted":true,"gap_us":32,"residual_thousandths":1,"slowness_thousandths":1000,"tasks":100},{"fitted":true,"gap_us":128,"residual_thousandths":1,"slowness_thousandths":1090,"tasks":100}],"r2_thousandths":1000,"refused":null,"slope_thousandths":45}`))
    // A round 20% sooner leaves each carrier idle a fifth of a round less,
    // under a microsecond, so its tasks run as fast as after the 8 µs gap:
    // 909 thousandths of their time, which leaves rounds 27.3% sooner.
    assert(json.contains(`{"experiments":6,"function":"narrow","gain_tenths":273,"high_tenths":273,"line":30,"low_tenths":273}`))
    // The fit holds, so the 21.7% drop is no flag.
    assert(json.contains(`"clock_flag":null,"clock_high_mhz":4993,"clock_low_mhz":3908,`))
}

#Test("a causal run's idle table with too few octaves of tasks fits nothing and leaves the gains as they are") {
    experiments := [JetCLIPerfExperiment]{}
    loop _ in 0..<6 {
        experiments.push(JetCLIPerfExperiment{line: U64{0}, name: "", speedup: 0, run_ns: 25000000, wait_ns: 0, khz_high: 4900000, khz_low: 4800000, after: [Int]{4}, span_ns: [Int]{20000000}, span_delay_ns: [Int]{0}})
        experiments.push(JetCLIPerfExperiment{line: U64{30}, name: "narrow", speedup: 300, run_ns: 25000000, wait_ns: 0, khz_high: 4900000, khz_low: 4800000, after: [Int]{4}, span_ns: [Int]{22000000}, span_delay_ns: [Int]{6000000}})
    }
    // 100 tasks after 8 µs and 20 after 128 µs: one octave of 30 or more.
    tasks: [Int:Int]{3: 100, 7: 20}
    gaps: [Int:Int]{3: 800000, 7: 2560000}
    idle := [Int]{16384}
    loop octave in 0..<16 {
        idle.push(tasks.get(octave) ?? 0)
        idle.push((tasks.get(octave) ?? 0) * 1000000)
        idle.push(gaps.get(octave) ?? 0)
    }
    section: jet_cli_perf_causal_section("main.jet", experiments, [Int:String]{0: "round"}, idle)
    json: String.from_bytes(canonical_json_bytes(section.value)) ?? panic("the section is UTF-8")
    assert(json.contains(`"refused":"only 1 of the octaves of idle gap held 30 tasks or more, and the fit needs 3"`))
    assert(json.contains(`{"fitted":false,"gap_us":128,"residual_thousandths":0,"slowness_thousandths":1000,"tasks":20}`))
    assert(json.contains(`{"experiments":6,"function":"narrow","gain_tenths":200,"high_tenths":200,"line":30,"low_tenths":200}`))
}

#Test("a causal run whose threads waited for a CPU most of their run time is refused with the wait, its gains withheld") {
    experiments := [JetCLIPerfExperiment]{}
    // The same rates as a run with a CPU per thread would rank, but the
    // threads waited 16 ms of every 20 they ran, as four threads do on
    // 2.15 CPUs.
    loop _ in 0..<6 {
        experiments.push(JetCLIPerfExperiment{line: U64{0}, name: "", speedup: 0, run_ns: 20000000, wait_ns: 16000000, khz_high: 0, khz_low: 0, after: [Int]{4}, span_ns: [Int]{20000000}, span_delay_ns: [Int]{0}})
        experiments.push(JetCLIPerfExperiment{line: U64{30}, name: "narrow", speedup: 300, run_ns: 20000000, wait_ns: 16000000, khz_high: 0, khz_low: 0, after: [Int]{4}, span_ns: [Int]{22000000}, span_delay_ns: [Int]{6000000}})
    }
    section: jet_cli_perf_causal_section("main.jet", experiments, [Int:String]{0: "round"}, [Int]{})
    json: String.from_bytes(canonical_json_bytes(section.value)) ?? panic("the section is UTF-8")
    assert(json.contains(`"refused":"the program's threads waited 192 ms for a CPU while they ran 240 ms, 80.0% of their run time, above the 20.0% the lens ranks under: `))
    assert(json.contains(`"cpu_run_ms":240,"cpu_wait_ms":192,`))
    // No clock was read: no flag.
    assert(json.contains(`"clock_flag":null,"clock_high_mhz":0,"clock_low_mhz":0,`))
    // The point keeps its name; no gain is given.
    assert(json.contains(`{"lines":[],"name":"round","unranked":[]}`))
    assert(!json.contains(`"gain_tenths"`))
}

#Test("the causal lens's tasks' timings keep each task's row, its start from the first task's and its wall time, beside the experiments by line") {
    experiments := [JetCLIPerfExperiment]{}
    experiments.push(JetCLIPerfExperiment{line: U64{0}, name: "", speedup: 0, run_ns: 25000000, wait_ns: 0, khz_high: 0, khz_low: 0, after: [Int]{4}, span_ns: [Int]{20000000}, span_delay_ns: [Int]{0}})
    experiments.push(JetCLIPerfExperiment{line: U64{30}, name: "narrow", speedup: 300, run_ns: 25000000, wait_ns: 0, khz_high: 0, khz_low: 0, after: [Int]{4}, span_ns: [Int]{22000000}, span_delay_ns: [Int]{6000000}})
    // Two tasks of one body, written in the order they ended: the second
    // began first, in the next experiment, after a 2 µs idle gap, and paused
    // 50 ns of it.
    tasks: JetCLIPerfCausalTasks{
        seen: 3,
        kept_most: 65536,
        rows: [Int]{0, 1000500, 1002000, 0, 0, 1400, 0, 0, 11, 0, 0, 3, -1, 0, 1000000, 1001000, 1, 1, 900, 50, 40, 7, 100, 150, 5, 2000},
        bodies: [Int:Int]{4096: 0},
        places: [JetCLIPerfCausalPlace]{{line: U64{61}, name: "narrow_run"}},
    }
    // A run that wrote no timings has no section.
    none: JetCLIPerfCausalTasks{seen: -1, kept_most: 0, rows: [Int]{}, bodies: [Int:Int]{}, places: [JetCLIPerfCausalPlace]{}}
    if jet_cli_perf_causal_tasks_section("main.jet", [JetCLIPerfExperiment]{}, none) == .Val(unwanted) {
        panic("a run with no timings has a section {unwanted.name}")
    }
    section: jet_cli_perf_causal_tasks_section("main.jet", experiments, tasks) ?? panic("the run wrote timings")
    assert_eq(section.name, "causal_tasks")
    json: String.from_bytes(canonical_json_bytes(section.value)) ?? panic("the section is UTF-8")
    assert(json.contains(`{"bodies":[{"function":"narrow_run","line":61}],"columns":["body","start_ns","wall_ns",`))
    assert(json.contains(`"experiments":[null,{"function":"narrow","line":30}],"kept_most":65536,"path":"main.jet",`))
    assert(json.contains(`"rows":[[0,500,1500,0,0,1400,0,0,11,0,0,3,-1],[0,0,1000,1,1,900,50,40,7,100,150,5,2000]],"seen":3}`))
}

// A run keeps each function its samples landed in, hottest first, with
// a row per sampled instruction and the runs of code inlined into it. With
// no image to read its code from, each is kept cut: the lines of its
// sampled instructions alone, and the view lists those instructions
// without their code.
#Test("a run keeps the code its samples landed in, and the view lists it by function and line") {
    // fib's code at 0x1000, its rows line 5 at +0 and line 7 at +16, and
    // step inlined into it at +32 for the call on line 6; a runtime
    // function beside it in the symbol table.
    rows := [U8]{}
    x64_jetline_rows(rows, [X64LineRow]{X64LineRow{at: 0, line: 5}, X64LineRow{at: 16, line: 7}})
    end: rows.len()
    table: X64Jetline{table: rows, functions: [X64JetlineFunction]{X64JetlineFunction{low: 4096, high: 4352, name: "fib", file: "fib.jet", dir: "", decl: 5, rows: 0, rows_end: end}}, ascending: true}
    functions: [X64ImageFunction]{X64ImageFunction{start: 4096, size: 256, name: "fib.fib"}, X64ImageFunction{start: 12288, size: 16, name: "jet_rt_alloc"}}
    one: 1 << 48
    words: jet_cli_perf_test_words([Int]{4112 | one, 4100 | one, 4112 | one, 12292 | one})
    run: NativeInlined{die: 10, origin: 1, low: 4128, high: 4144, call_line: 6, parent: -1, file: 1, call_file: 1}
    inlines: JetCLIPerfInlines{functions: [Int:NativeFunction]{4096: NativeFunction{low: 4096, high: 4352, name: "fib", file: 1, variables: [NativeVariable]{}, inlined: [NativeInlined]{run}}}, abstracts: [Int:NativeAbstract]{1: NativeAbstract{name: "step", file: 1}}}
    sampled: jet_cli_perf_samples_count(table, functions, inlines, [Bool]{true}, [U64]{}, [Int:Int]{}, [Int:String]{}, words, 0)
    assert_eq(sampled.pcs.len(), 3)
    section: jet_cli_perf_instructions_section([U8]{}, 2, sampled) ?? panic("fib holds samples")
    assert_eq(section.type_name, "JetPerfInstructions")
    json: String.from_bytes(canonical_json_bytes(section.value)) ?? panic("the section is UTF-8")
    fib: `{"address":4096,"code":"","cut":true,"events":[],"file":"fib.jet","inlined":[{"call_line":6,"name":"step","offset":32,"size":16}],"instructions":[{"events":[],"offset":4,"samples":1},{"events":[],"offset":16,"samples":2}],"level":2,"lines":[{"line":5,"offset":4},{"line":7,"offset":16}],"names":[],"samples":3,"size":256,"symbol":"fib"}`
    alloc: `{"address":12288,"code":"","cut":true,"events":[],"file":"","inlined":[],"instructions":[{"events":[],"offset":4,"samples":1}],"level":null,"lines":[],"names":[],"samples":1,"size":16,"symbol":"jet_rt_alloc"}`
    open: `{"bytes":0,"cap_bytes":1048576,"counters":[],"cut":2,"functions":[`
    close: `],"kept":0,"samples":4}`
    expected: "{open}{fib},{alloc}{close}"
    assert_eq(json, "{expected}\n")
    jettrace_validate_instructions(section.value, "instructions") ?? panic(err.message)
    wrapped: `{"content":{"browser":[],"receipt_sections":[{"name":"instructions","value":`
    trace: canonical_json_parse("{wrapped}{expected}}}]}}}}\n".bytes()) ?? panic(err.message)
    assert_eq(jet_cli_perf_instructions_summary(trace), Val("instructions functions=2 kept=0 cut=2 code_bytes=0: `--instructions` lists them"))
    // Bare, the hottest function; no `perf` receipt names its sampler.
    hottest: jet_cli_perf_instructions_view(trace, "run.jettrace", "", "text", false)
    assert_eq(hottest.exit_code, 0)
    cut: "; its code is cut: the trace keeps at most 1048576 bytes of code"
    sampler: "sampler: not recorded: a share can sit on an instruction after the one that spent the time"
    line_five: "  fib.jet:5 fib samples=1 share=33%\n  33.3%   +4    (code not kept)\n"
    line_seven: "  fib.jet:7 fib samples=2 share=67%\n  66.7%   +16   (code not kept)\n"
    assert_eq(hottest.stdout, "fib profile:cpu samples=3 share=75% level=O2; shares below are of fib's samples{cut}\n{sampler}\n{line_five}{line_seven}")
    // A line by FILE:LINE, that line alone.
    by_line: jet_cli_perf_instructions_view(trace, "run.jettrace", "fib.jet:7", "text", false)
    assert_eq(by_line.stdout, "fib profile:cpu samples=3 share=75% level=O2; shares below are of fib's samples{cut}\n{sampler}\n{line_seven}")
    // A function outside Jet code by its name: no level and no lines.
    by_name: jet_cli_perf_instructions_view(trace, "run.jettrace", "jet_rt_alloc", "text", false)
    assert_eq(by_name.stdout, "jet_rt_alloc profile:cpu samples=1 share=25%; shares below are of jet_rt_alloc's samples{cut}\n{sampler}\n 100.0%   +4    (code not kept)\n")
    listed: jet_cli_perf_instructions_view(trace, "run.jettrace", "", "json", false)
    assert(listed.stdout.contains(`"kind":"jet.trace.instructions"`))
    assert(listed.stdout.contains(`"bytes":null`))
    // A name the section doesn't hold is refused, naming those it does.
    missed: jet_cli_perf_instructions_view(trace, "run.jettrace", "nope", "text", false)
    assert_eq(missed.exit_code, 2)
    assert(missed.stderr.contains("Jet.PerfNoInstructions: `run.jettrace` keeps no instruction samples of `nope`"))
    assert(missed.stderr.contains("`fib`, `jet_rt_alloc`"))
    // Canvas's profile request answers the same rows, and refuses the same
    // miss as `instructions`.
    canvas: jet_cli_canvas_profile_instructions(trace, "run.jettrace", "fib.jet:7") ?? panic(err.message)
    assert(canvas.contains(`"kind":"jet.trace.instructions"`) && canvas.contains(`"line":7`), "the member is the view's JSON: {canvas}")
    assert(!canvas.ends_with("\n"), "the member is embedded without the document's newline")
    if jet_cli_canvas_profile_instructions(trace, "run.jettrace", "nope") == .Err(refused) {
        assert_eq(refused.kind, "instructions")
        assert(refused.message.starts_with("Jet.PerfNoInstructions: `run.jettrace` keeps no instruction samples of `nope`; "), refused.message)
    } else { assert(false, "a name the section doesn't hold must be refused") }
}

// A kept function lists all its code through the one listing builder,
// each sampled instruction with its share of the function's samples, then
// of its events per captured counter; the sampler line says a share can
// skid under the task clock.
#Test("the instruction view lists kept code with its shares of samples and events") {
    fib: `{"address":4096,"code":"554889e5c3","cut":false,"events":[30],"file":"src/fib.jet","inlined":[],"instructions":[{"events":[10],"offset":0,"samples":3},{"events":[20],"offset":4,"samples":1}],"level":2,"lines":[{"line":7,"offset":0},{"line":8,"offset":4}],"names":[],"samples":4,"size":5,"symbol":"fib"}`
    kept: `{"name":"instructions","value":{"bytes":5,"cap_bytes":1048576,"counters":["l1d_misses"],"cut":0,"functions":[`
    perf: `{"name":"perf","value":{"capture":{"sampling":{"pc":{"precise":false,"source":"task_clock"}}}}}`
    wrapped: `{"content":{"browser":[],"receipt_sections":[`
    trace: canonical_json_parse("{wrapped}{kept}{fib}],\"kept\":1,\"samples\":10}}}},{perf}]}}}}\n".bytes()) ?? panic(err.message)
    head: "fib profile:cpu samples=4 share=40% level=O2; shares below are of fib's samples and events\nsampler: task_clock, skid: a share can sit on an instruction after the one that spent the time; precise samples need perf_event_paranoid at most 1\ncolumns: cpu, l1d_misses\n"
    line_seven: "  fib.jet:7 fib samples=3 share=75%\n  75.0%  33.3%   +0    push   rbp\n                 +1    mov    rbp,rsp\n"
    line_eight: "  fib.jet:8 fib samples=1 share=25%\n  25.0%  66.7%   +4    ret\n"
    all: jet_cli_perf_instructions_view(trace, "run.jettrace", "fib", "text", false)
    assert_eq(all.stdout, "{head}{line_seven}{line_eight}")
    by_line: jet_cli_perf_instructions_view(trace, "run.jettrace", "fib.jet:8", "text", false)
    assert_eq(by_line.stdout, "{head}{line_eight}")
    page: jet_cli_perf_instructions_view(trace, "run.jettrace", "", "html", false)
    assert(page.stdout.contains("<pre>fib profile:cpu samples=4 share=40%"))
    assert(page.stdout.contains("push   rbp"))
}

// At -O2 a hot callee is code inlined into its caller: the view names it
// as its own function. Bare, it lists the run with the most samples of its
// own, with the function and line it is inlined into; by name, the run;
// the caller's listing names whose code each line's instructions are.
#Test("the instruction view lists a function inlined into its caller as its own") {
    // fib's push at +0 on line 7, step's mov at +1 on its line 3, inlined
    // for the call on line 7, and fib's ret at +4 on line 8.
    fib: `{"address":4096,"code":"554889e5c3","cut":false,"events":[],"file":"src/fib.jet","inlined":[{"call_line":7,"name":"step","offset":1,"size":3}],"instructions":[{"events":[],"offset":0,"samples":1},{"events":[],"offset":1,"samples":3}],"level":2,"lines":[{"line":7,"offset":0},{"line":3,"offset":1},{"line":8,"offset":4}],"names":[],"samples":4,"size":5,"symbol":"fib"}`
    kept: `{"name":"instructions","value":{"bytes":5,"cap_bytes":1048576,"counters":[],"cut":0,"functions":[`
    wrapped: `{"content":{"browser":[],"receipt_sections":[`
    trace: canonical_json_parse("{wrapped}{kept}{fib}],\"kept\":1,\"samples\":10}}}}]}}}}\n".bytes()) ?? panic(err.message)
    sampler: "sampler: not recorded: a share can sit on an instruction after the one that spent the time\n"
    step: "step profile:cpu samples=3 share=30% level=O2, inlined into fib on line 7; shares below are of step's samples\n{sampler}  fib.jet:3 step samples=3 share=100%\n 100.0%   +1    mov    rbp,rsp\n"
    hottest: jet_cli_perf_instructions_view(trace, "run.jettrace", "", "text", false)
    assert_eq(hottest.stdout, step)
    by_name: jet_cli_perf_instructions_view(trace, "run.jettrace", "step", "text", false)
    assert_eq(by_name.stdout, step)
    whole: jet_cli_perf_instructions_view(trace, "run.jettrace", "fib", "text", false)
    lines: "  fib.jet:7 fib samples=1 share=25%\n  25.0%   +0    push   rbp\n  fib.jet:3 step samples=3 share=75%\n  75.0%   +1    mov    rbp,rsp\n  fib.jet:8 fib samples=0 share=0%\n          +4    ret\n"
    assert_eq(whole.stdout, "fib profile:cpu samples=4 share=40% level=O2; shares below are of fib's samples\n{sampler}{lines}")
    listed: jet_cli_perf_instructions_view(trace, "run.jettrace", "step", "json", false)
    assert(listed.stdout.contains(`"call_line":7`) && listed.stdout.contains(`"holder":"fib"`) && listed.stdout.contains(`"symbol":"step"`), listed.stdout)
    assert(listed.stdout.contains(`"function":"step","line":3`) && listed.stdout.contains(`"samples":3,"size":3`), listed.stdout)
    assert(listed.stdout.contains(`"within":"fib"`), listed.stdout)
    named: jet_cli_perf_instructions_view(trace, "run.jettrace", "fib", "json", false)
    assert(named.stdout.contains(`"call_line":null`) && named.stdout.contains(`"holder":null`) && named.stdout.contains(`"function":"step"`), named.stdout)
    assert(named.stdout.contains(`"within":null`), named.stdout)
}

// At -O2 a caller can itself be inlined into the image's entry: a run
// nested in another run is inlined into that run, and its header names
// the function whose code holds both. A run with the same code as one
// before it is nested in that one.
#Test("the instruction view names the run a nested inlined run is inlined into") {
    entry: `{"address":4096,"code":"554889e5c3","cut":false,"events":[],"file":"src/fib.jet","inlined":[{"call_line":12,"name":"run","offset":1,"size":3},{"call_line":7,"name":"step","offset":1,"size":3}],"instructions":[{"events":[],"offset":0,"samples":1},{"events":[],"offset":1,"samples":3}],"level":2,"lines":[{"line":12,"offset":0},{"line":3,"offset":1},{"line":8,"offset":4}],"names":[],"samples":4,"size":5,"symbol":"entry"}`
    kept: `{"name":"instructions","value":{"bytes":5,"cap_bytes":1048576,"counters":[],"cut":0,"functions":[`
    wrapped: `{"content":{"browser":[],"receipt_sections":[`
    trace: canonical_json_parse("{wrapped}{kept}{entry}],\"kept\":1,\"samples\":4}}}}]}}}}\n".bytes()) ?? panic(err.message)
    sampler: "sampler: not recorded: a share can sit on an instruction after the one that spent the time\n"
    step: "step profile:cpu samples=3 share=75% level=O2, inlined into run on line 7 in entry; shares below are of step's samples\n{sampler}  fib.jet:3 step samples=3 share=100%\n 100.0%   +1    mov    rbp,rsp\n"
    hottest: jet_cli_perf_instructions_view(trace, "run.jettrace", "", "text", false)
    assert_eq(hottest.stdout, step)
    by_name: jet_cli_perf_instructions_view(trace, "run.jettrace", "run", "text", false)
    assert(by_name.stdout.starts_with("run profile:cpu samples=3 share=75% level=O2, inlined into entry on line 12; "), by_name.stdout)
    listed: jet_cli_perf_instructions_view(trace, "run.jettrace", "step", "json", false)
    assert(listed.stdout.contains(`"holder":"run"`) && listed.stdout.contains(`"within":"entry"`), listed.stdout)
}
