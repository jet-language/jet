// The semantic index's effect witnesses over recursive call graphs: the
// one-pass search finds, for every function and effect, the same path and
// spans as the per-path search it replaced, which tries each callee in edge
// order and may not revisit a function on its current path.
use {
    jet_driver.[JetDriverDocModule]
    jet_foundation.[Span, authority_covers]
    jet_semindex.[SemBoundaryCall, SemSummary, SemWitness, semindex_effects, semindex_summary, semindex_witness, semindex_witnesses]
}

// The per-path search: `path` holds the functions the search is inside.
semindex_test_search: fn(function: String, effect_name: String, summaries: [SemSummary], path: ^[String]) -> SemWitness? Never! {
    if path.contains(function) -> return None
    summary: semindex_summary(summaries, function) ?? return None
    if summary.direct.contains(effect_name) {
        spans := [Span]{}
        loop (position, name) in summary.direct {
            if name == effect_name -> spans.push(summary.direct_spans[position])
        }
        return Val(SemWitness{path: [String]{function}, spans: spans})
    }
    if summary.maximal {
        spans := [Span]{}
        if summary.maximal_span == .Val(span) -> spans.push(span)
        return Val(SemWitness{path: [String]{function}, spans: spans})
    }
    if effect_name == "Panic" && summary.edges.contains("__jet_panic__") {
        return Val(SemWitness{path: [String]{function}, spans: [Span]{}})
    }
    path.push("{function}")
    loop callee in summary.edges {
        callee_summary: semindex_summary(summaries, callee) ?? next
        if !callee_summary.solved.contains(effect_name) -> next
        found: semindex_test_search(callee, effect_name, summaries, path) ?? next
        _ := path.pop()
        walk := [String]{function}
        loop part in found.path -> walk.push(part)
        return Val(SemWitness{path: walk, spans: found.spans})
    }
    _ := path.pop()
    loop call in summary.boundary_calls {
        loop bound in call.row {
            if authority_covers(bound, effect_name) -> return Val(SemWitness{path: [String]{function, "{call.callee}"}, spans: [Span]{call.span}})
        }
    }
    None
}

semindex_test_text: fn(witness: SemWitness?) -> String Never! {
    found: witness ?? return "none"
    spans: loop span in found.spans -> "{span.start}-{span.end}"
    "{found.path.join(" > ")} [{spans.join(",")}]"
}

semindex_test_summary: fn(name: String, direct: [String], edges: [String], solved: [String]) -> SemSummary Never! {
    direct_spans: loop entry in direct -> Span{start: name.len(), end: name.len() + entry.len()}
    SemSummary{key: "m.{name}", local: name, raw_key: "function:m.{name}", direct: direct, direct_spans: direct_spans, edges: edges, raw_edges: [String]{}, edge_locals: [String]{}, solved: solved, maximal: false, maximal_span: None, boundary_calls: [SemBoundaryCall]{}}
}

SemTestRandom: struct {
    state: Int,
}

semindex_test_next: fn(random: ^SemTestRandom, bound: Int) -> Int Never! {
    random.state = (random.state * 1103515245 + 12345) % 2147483648
    (random.state /% 65536) % bound
}

// The effect a code names.
semindex_test_effect: fn(code: Int) -> String Never! {
    if code == 0 -> return "IO"
    if code == 1 -> return "Net"
    "Panic"
}

// A call graph of `count` functions with cycles, direct effects, panics,
// maximal functions and boundary calls. Each solved row is what its function
// reaches, less its last effect at some functions, so a path must also pass
// over callees whose row does not name the effect. Effects are codes for
// semindex_test_effect until the summaries are built.
semindex_test_graph: fn(seed: Int, count: Int) -> [SemSummary] Never! {
    random := SemTestRandom{state: seed}
    callees := [[Int]]{}
    owns := [Int]{}
    panics := [Bool]{}
    bounds := [Int]{}
    wholes := [Bool]{}
    drops := [Bool]{}
    solved := [[Int]]{}
    loop _ in 0..<count {
        rows := [Int]{}
        loop _ in 0..<semindex_test_next(random, 4) {
            callee: semindex_test_next(random, count)
            if !rows.contains(callee) -> rows.push(callee)
        }
        reached := [Int]{}
        own := -1
        if semindex_test_next(random, 4) == 0 {
            own = semindex_test_next(random, 2)
            reached.push(own)
        }
        panic_edge: semindex_test_next(random, 6) == 0
        if panic_edge && !reached.contains(2) -> reached.push(2)
        bound := -1
        if semindex_test_next(random, 5) == 0 {
            bound = semindex_test_next(random, 2)
            if !reached.contains(bound) -> reached.push(bound)
        }
        whole: semindex_test_next(random, 12) == 0
        if whole {
            loop code in 0..<3 {
                if !reached.contains(code) -> reached.push(code)
            }
        }
        callees.push(rows)
        owns.push(own)
        panics.push(panic_edge)
        bounds.push(bound)
        wholes.push(whole)
        drops.push(semindex_test_next(random, 6) == 0)
        solved.push(reached)
    }
    changed := true
    loop changed {
        changed = false
        loop node in 0..<count {
            loop callee in callees[node] {
                loop code in 0..<3 {
                    if !solved[callee].contains(code) || solved[node].contains(code) -> next
                    solved[node].push(code)
                    changed = true
                }
            }
        }
    }
    summaries := [SemSummary]{}
    loop node in 0..<count {
        edges := [String]{}
        loop callee in callees[node] -> edges.push("m.f{callee}")
        if panics[node] -> edges.push("__jet_panic__")
        direct := [String]{}
        if owns[node] >= 0 -> direct.push(semindex_test_effect(owns[node]))
        row := [String]{}
        loop (position, code) in solved[node] {
            if drops[node] && position == solved[node].len() - 1 -> next
            row.push(semindex_test_effect(code))
        }
        summary := semindex_test_summary("f{node}", direct, edges, row)
        summary.maximal = wholes[node]
        if wholes[node] -> summary.maximal_span = Val(Span{start: node * 10 + 5, end: node * 10 + 6})
        if bounds[node] >= 0 {
            summary.boundary_calls.push(SemBoundaryCall{callee: "core.io.call{node}", row: [String]{semindex_test_effect(bounds[node])}, span: Span{start: node * 10 + 7, end: node * 10 + 8}})
        }
        summaries.push(summary)
    }
    summaries
}

// Every function's witness for each effect, and the absent effect FS, from
// the one-pass search and from the per-path search.
semindex_test_same: fn(summaries: [SemSummary], label: String) Never! {
    effect_names: [String]{"IO", "Net", "Panic", "FS"}
    witnesses: semindex_witnesses(summaries, [JetDriverDocModule]{})
    loop summary in summaries {
        loop effect_name in effect_names {
            path := [String]{}
            expected: semindex_test_text(semindex_test_search(summary.key, effect_name, summaries, path))
            actual: semindex_test_text(semindex_witness(witnesses, summaries, summary.key, effect_name))
            assert(actual == expected, "{label}: {summary.key} {effect_name}: {actual}, the per-path search finds {expected}")
        }
    }
}

#Test("semindex witnesses match the per-path search on recursive call graphs") {
    // f0 calls f1 first, but f1 reaches IO only back through f0, which is on
    // the path: f0 goes through f2. From f1 the path runs through f0.
    cycle: [SemSummary]{
        semindex_test_summary("f0", [String]{}, [String]{"m.f1", "m.f2"}, [String]{"IO"}),
        semindex_test_summary("f1", [String]{}, [String]{"m.f0"}, [String]{"IO"}),
        semindex_test_summary("f2", [String]{"IO"}, [String]{}, [String]{"IO"}),
    }
    witnesses: semindex_witnesses(cycle, [JetDriverDocModule]{})
    assert(semindex_test_text(semindex_witness(witnesses, cycle, "m.f0", "IO")) == "m.f0 > m.f2 [2-4]", "f0 skips the callee that only leads back to it")
    assert(semindex_test_text(semindex_witness(witnesses, cycle, "m.f1", "IO")) == "m.f1 > m.f0 > m.f2 [2-4]", "f1 reaches IO through f0")
    semindex_test_same(cycle, "cycle")
    loop seed in 1..<200 {
        semindex_test_same(semindex_test_graph(seed, 9), "seed {seed}")
    }
}

#Test("semindex effects carry the one-pass witnesses") {
    summaries: semindex_test_graph(7, 12)
    effects: semindex_effects(summaries, [JetDriverDocModule]{})
    loop effect in effects {
        summary: semindex_summary(summaries, effect.function) ?? panic("{effect.function} has no summary")
        loop entry in effect.provenance {
            path := [String]{}
            expected: semindex_test_search(summary.key, entry.effect_name, summaries, path) ?? panic("{summary.key} {entry.effect_name} has no witness")
            assert(entry.call_path == expected.path, "{summary.key} {entry.effect_name}: {entry.call_path.join(" > ")}, the per-path search finds {expected.path.join(" > ")}")
        }
    }
}
