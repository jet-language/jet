// The debugger's refusals: a frame, scope or variable reference of an
// earlier stop is E2238, whose report renders as the CLI snapshot
// Tests/CLI/debug_stale_reference_e2238.txt records it; the error the
// adapter sends carries its first line's text as its `format`. A request
// the session can't answer faithfully is E2237, which the console prints
// as Tests/CLI/debug_request_refused_e2237.txt records it. A `disassemble`
// request's `memoryReference` is an address as a frame's
// `instructionPointerReference` gives it, or in decimal.
use {
    dap_files: core.files
    core.encoding.[Dyn]
    jet_cli.[JET_CLI_DAP_STALE, jet_cli_dap_address, jet_cli_dap_offset]
    jet_debug.[native_debug_refused, native_debug_report]
    jet_foundation.[Diagnostic, diagnostic_render_all]
}

#Test("an expired reference is refused as its CLI snapshot records") {
    expected: dap_files.read("Tests/CLI/debug_stale_reference_e2238.txt") ?? panic("read Tests/CLI/debug_stale_reference_e2238.txt: {err}")
    report: native_debug_report(JET_CLI_DAP_STALE, "reference 5 expired when execution resumed")
    assert_eq(diagnostic_render_all("", "", [Diagnostic]{report}, false), expected)
}

#Test("going back outside a replay is refused as its CLI snapshot records") {
    expected: dap_files.read("Tests/CLI/debug_request_refused_e2237.txt") ?? panic("read Tests/CLI/debug_request_refused_e2237.txt: {err}")
    assert_eq(native_debug_refused("going back needs a replay: start the session with `jet debug --replay=NAME`"), expected)
}

#Test("a memory reference is a hex or decimal address, and nothing else") {
    assert_eq(jet_cli_dap_address("0x401000"), Val(0x401000))
    assert_eq(jet_cli_dap_address("0X7fFf"), Val(0x7fff))
    assert_eq(jet_cli_dap_address("4198400"), Val(4198400))
    assert_eq(jet_cli_dap_address("0x"), None)
    assert_eq(jet_cli_dap_address("0x40g000"), None)
    assert_eq(jet_cli_dap_address("0x1000000000000000"), None)
    assert_eq(jet_cli_dap_address("nope"), None)
}

#Test("an absent offset is 0") {
    members: [{key: String, value: Dyn}]{{key: "instructionOffset", value: Dyn.Int(-2)}}
    assert_eq(jet_cli_dap_offset(members, "instructionOffset"), -2)
    assert_eq(jet_cli_dap_offset(members, "offset"), 0)
}
