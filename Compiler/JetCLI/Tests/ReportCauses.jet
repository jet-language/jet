// 30d14e6b6: jet.report/v4 renders located causes; assemble with Compiler and run.
use {
    jet_foundation.[DIAGNOSTIC_ERROR, Diagnostic, DiagnosticCause]
    jet_cli.[jet_cli_report_json]
}

report_causes_require: fn(ok: Bool, name: String) Never! {
    if !ok -> panic("report causes contract: {name}")
}

#Test("report_causes") {
    ^one: Diagnostic{
        severity: DIAGNOSTIC_ERROR,
        code: "E0108",
        what: "first cause",
        why: "a located cause",
        fix: "fix it",
        cause: [DiagnosticCause]{DiagnosticCause{code: "E0109", span: None, origin: None}},
    }
    json: jet_cli_report_json(one, None, "", "", 1)
    report_causes_require(json.starts_with("{{\"schema\":\"jet.report/v4\""), "report schema is v4")
    report_causes_require(json.contains("\"cause\":[{{\"code\":\"E0109\",\"span\":null,\"origin\":null,\"line\":null,\"col\":null}}],\"clears\":1"), "single unlocated cause renders null fields")

    ^two: Diagnostic{
        severity: DIAGNOSTIC_ERROR,
        code: "E0108",
        what: "first cause",
        why: "two located causes",
        fix: "fix it",
        cause: [DiagnosticCause]{
            {code: "E0108", span: None, origin: None},
            {code: "E0109", span: None, origin: None},
        },
    }
    json2: jet_cli_report_json(two, None, "", "", 0)
    report_causes_require(json2.contains("\"cause\":[{{\"code\":\"E0108\",\"span\":null,\"origin\":null,\"line\":null,\"col\":null}},{{\"code\":\"E0109\",\"span\":null,\"origin\":null,\"line\":null,\"col\":null}}],\"clears\":0"), "two causes keep order")
    print("report causes: passed")
}
