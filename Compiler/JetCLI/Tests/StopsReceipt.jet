// The runtime's stops receipt as a program build reads it (Host.jet
// jet_cli_runtime_quiet_routes): the runtime routes no stop poll follows.
use jet_cli.[JetCLIRuntimeExports, jet_cli_runtime_quiet_routes]

stops_test_runtime: fn(stops: String?) -> JetCLIRuntimeExports Never! {
    receipt := [U8]?{None}
    if stops == .Val(text) -> receipt = Val(text.bytes())
    JetCLIRuntimeExports{key: "test", exports: "jet_rt_pure\njet_rt_sleep\nmemcpy".bytes(), threads: None, failure: None, stops: receipt}
}

#Test("the routes no poll follows are the exports the stops receipt leaves out") {
    quiet: jet_cli_runtime_quiet_routes(stops_test_runtime(Val("jet_rt_sleep")))
    assert(quiet.get("jet_rt_pure") != None)
    assert(quiet.get("memcpy") != None)
    assert(quiet.get("jet_rt_sleep") == None)
    // A Core function or any symbol the runtime does not export polls.
    assert(quiet.get("jet_core_time_sleep_until") == None)
    assert_eq(quiet.len(), 2)
}

#Test("without a stops receipt every route polls") {
    assert_eq(jet_cli_runtime_quiet_routes(stops_test_runtime(None)).len(), 0)
}
