// Runs a tool stage's calls for a document (JetDriver ToolStages.jet). Their
// program is checked in `JetDriverCompileMode.Comptime` as a new source file
// beside the document, with `overlays` in place of their files: the hooks'
// packages resolve as the document's own imports do, and each call's `#run`
// value runs in the sealed comptime child, as a config value does
// (ConfigEval.jet). A program that does not check answers nothing, and
// `stop` is its first error. `jet build`'s link and post-link steps call
// their hooks the same way (LinkStep.jet), and so does `jet build` the
// package's moment hooks (jet_cli_moment_hooks_run).
use {
    cli_files: core.files
    jet_driver.[
        JetDriverSourceDocument,
        JetDriverCompileMode,
        JetDriverMomentHook,
        JetDriverToolStageItem,
        jet_driver_compile,
        jet_driver_moment_plan,
        jet_driver_tool_stage_answers,
        jet_driver_tool_stage_blocks,
        jet_driver_tool_stage_hooked,
        jet_driver_tool_stage_plan,
        jet_driver_tool_stage_snapshot_markers,
    ]
    jet_foundation.[CompilerEventRecord, DIAGNOSTIC_ERROR, Diagnostic, Span, TOOL_STAGE_FMT_BLOCK, diagnostic_from_registry, foundation_byte_text]
    jet_parser.[jet_format_source, parse_source]
}

// The program's file name beside the document; the walk reaches it, so its
// imports resolve in the document's package.
JET_CLI_TOOL_STAGE_FILE: "jet_tool_stage.jet"

JetCLIToolStageRun: struct {
    answers: [[JetDriverToolStageItem]],
    stop: Diagnostic?,
}

jet_cli_tool_stage_run: fn(document: String, overlays: ^^[JetDriverSourceDocument], stage: String, bodies: [Span], program: ^^String) -> JetCLIToolStageRun Never! {
    if bodies.len() == 0 {
        return JetCLIToolStageRun{answers: [[JetDriverToolStageItem]]{}, stop: None}
    }
    ran: jet_cli_tool_stage_values(document, overlays.move(), program.move())
    if ran.stop.move() == .Val(stop) {
        return JetCLIToolStageRun{answers: [[JetDriverToolStageItem]]{}, stop: Val(stop)}
    }
    JetCLIToolStageRun{answers: jet_driver_tool_stage_answers(stage, bodies, ran.values.move()), stop: None}
}

// The compile-time values of `program` checked beside `document`, else the
// first report that stopped it. Hooks run as compile-time values, so a hook
// that reaches past what compile-time code may do stops here with the
// refusal's own code (E3410, E3411); a stop that is no diagnostic of the
// program is E2105.
JetCLIToolStageValues: struct {
    values: [SemaComptimeItemValue],
    stop: Diagnostic?,
}

jet_cli_tool_stage_values: fn(document: String, overlays: ^^[JetDriverSourceDocument], program: ^^String) -> JetCLIToolStageValues Never! {
    ^given: overlays.move()
    given.push(JetDriverSourceDocument{path: jet_cli_tool_stage_file(document), source: program.move()})
    if jet_cli_prepare_overlays(document, jet_cli_tool_stage_file(document), given, false, None, JetDriverCompileMode.Comptime) == {
        .Refused(output) -> jet_cli_tool_stage_stopped(output.stderr.trim())
        .Prepared(request, _) -> {
            result: jet_driver_compile(request) ?? return jet_cli_tool_stage_stopped("internal compiler error: {err}")
            loop diagnostic in result.diagnostics.move() {
                if diagnostic.severity == DIAGNOSTIC_ERROR {
                    return JetCLIToolStageValues{values: [SemaComptimeItemValue]{}, stop: Val(diagnostic)}
                }
            }
            if result.internal_problem == .Val(problem) {
                return jet_cli_tool_stage_stopped("internal compiler error: {problem}")
            }
            JetCLIToolStageValues{values: result.comptime_values.move(), stop: None}
        }
    }
}

// The E2105 stop of a hooks' program that `what` kept from running.
jet_cli_tool_stage_stopped: fn(what: String) -> JetCLIToolStageValues Never! {
    JetCLIToolStageValues{values: [SemaComptimeItemValue]{}, stop: Val(diagnostic_from_registry("E2105", None, what, jet_cli_why("E2105"), "fix the hook's package, then run the tool again"))}
}

jet_cli_tool_stage_file: fn(document: String) -> String Never! {
    jet_cli_entry_join(jet_cli_parent(jet_cli_overlay_path(document)) ?? ".", JET_CLI_TOOL_STAGE_FILE)
}

// Run each of `hooks`, the moment hooks of the package `file` builds
// (jet_driver_moment_hooks), on each of `records` its moment names, in one
// program beside `file` (jet_driver_moment_plan). The hooks run as
// compile-time values, so a hook that reaches past what compile-time code
// may do (E3410 for a file read) or fails (E3010 for a panic) stops the build
// with that report's own code, naming the moment and the hook. None when
// every call ran, or no hook hooks a moment of `records`.
jet_cli_moment_hooks_run: fn(file: String, hooks: [JetDriverMomentHook], records: [CompilerEventRecord], color: Bool) -> JetDriverVerbOutput? Never! {
    plan: jet_driver_moment_plan(hooks, records)
    if plan.calls.len() == 0 -> return None
    ran: jet_cli_tool_stage_values(file, [JetDriverSourceDocument]{}, plan.program.move())
    if ran.stop == .Val(stop) {
        ^named: "a moment hook of `{file}`"
        if stop.span == .Val(span) && (stop.source_path ?? JET_CLI_TOOL_STAGE_FILE).ends_with(JET_CLI_TOOL_STAGE_FILE) {
            ^at: -1
            loop (index, start) in plan.starts {
                if start <= span.start -> at = index
            }
            if at >= 0 {
                named = "the `{hooks[plan.calls[at]].moment}` hook `{hooks[plan.calls[at]].hook}`"
            }
        }
        return Val(jet_cli_build_refusal(stop.code, "{named} did not run: {stop.what}", stop.why, None, stop.fix, color))
    }
    None
}

// The hook markers of a tool stage that each package's sources declare
// (jet_driver_tool_stage_snapshot_markers), keyed by stage and package
// root, for one run of a tool over many files.
JetCLIToolStageMemo: struct {
    markers: [String:[String]],
}

jet_cli_tool_stage_memo: fn() -> JetCLIToolStageMemo Never! {
    JetCLIToolStageMemo{markers: [String:[String]]{}}
}

// The markers of the `stage` hooks in the snapshot a compile of `document`
// with `overlays` sees; the members of one package share it, so `memo`
// keeps it for the rest of the run. A script or a loose file takes its own.
jet_cli_tool_stage_markers: fn(document: String, overlays: [JetDriverSourceDocument], stage: String, memo: ^JetCLIToolStageMemo) -[FS, Env]> [String] Never! {
    root: jet_cli_tool_stage_package_root(document, overlays)
    key: "{stage}\n{root}"
    if root != "" && memo.markers.get(key) == .Val(known) -> return known
    markers: if jet_cli_prepare_snapshot(document, document, overlays, false) == {
        .Held(snapshot) -> jet_driver_tool_stage_snapshot_markers(snapshot, stage)
        // A compile of the document would stop at the same refusal, so no
        // hook would run.
        .Refused(_) -> [String]{}
    }
    if root != "" -> memo.markers[key] = markers
    markers
}

// The package root whose sources form the snapshot of every member file
// (jet_cli_prepare_snapshot), or "" for a script or a file with no package.
jet_cli_tool_stage_package_root: fn(document: String, overlays: [JetDriverSourceDocument]) -[FS, Env]> String Never! {
    path: cli_files.realpath(document) ?? return ""
    if jet_cli_entry_is_script(jet_cli_overlay_path(document), overlays) -> return ""
    root: jet_cli_source_root(path)
    if !cli_files.is_file(jet_cli_authority_path(root, "package.jet")) -> return ""
    root
}

// `text`, a file `jet fmt` has formatted, with each marked block's body that
// a package's `#On(fmt.block, Marker)` hook formats replaced by the hook's
// answer; a hook answering None keeps its body, and the first hook to answer
// for a block wins. Only a file on disk holding a marked block, importing a
// package, and in a snapshot whose sources declare a hook for one of its
// markers (`memo` keeps those per package) runs hooks: a Doc check of `text`
// finds them among the modules it imports. Hooks that do not run, or an
// answer that leaves the file unreadable, stop the file as written.
jet_cli_fmt_block_hooks: fn(text: ^^String, origin: String, color: Bool, memo: ^JetCLIToolStageMemo) -> JetCLIFmtSource {
    blocks: jet_driver_tool_stage_blocks(text)
    if blocks.len() == 0 || !jet_cli_tool_stage_imports_package(text) || !cli_files.is_file(origin) {
        return jet_cli_fmt_formatted(text.move())
    }
    ^overlays: [JetDriverSourceDocument]{JetDriverSourceDocument{path: jet_cli_overlay_path(origin), source: text.move()}}
    if !jet_driver_tool_stage_hooked(blocks, jet_cli_tool_stage_markers(origin, overlays, TOOL_STAGE_FMT_BLOCK, memo)) {
        unhooked: overlays.pop() ?? return jet_cli_fmt_formatted("")
        return jet_cli_fmt_formatted(unhooked.source)
    }
    ^bodies: [Span]{}
    ^program: ""
    if jet_cli_prepare_overlays(origin, origin, overlays, false, None, JetDriverCompileMode.Doc) == {
        .Refused(_) -> {}
        .Prepared(request, _) -> {
            modules: jet_driver_compile(request).doc_modules
            loop (index, module_ref) in modules {
                if module_ref.physical_path != overlays[0].path -> next
                plan: jet_driver_tool_stage_plan(modules, index, TOOL_STAGE_FMT_BLOCK)
                bodies = plan.bodies.move()
                program = plan.program.move()
            }
        }
    }
    formatted: overlays.pop() ?? return jet_cli_fmt_formatted("")
    if bodies.len() == 0 -> return jet_cli_fmt_formatted(formatted.source)
    // The hooks' program needs no overlay: the file on disk parses as its
    // formatted text does.
    run: jet_cli_tool_stage_run(origin, [JetDriverSourceDocument]{}, TOOL_STAGE_FMT_BLOCK, bodies, program)
    if run.stop == .Val(stop) {
        return JetCLIFmtSource{text: "", diagnostics: [Diagnostic]{}, report: Val(jet_cli_report(stop.code, "a `fmt.block` hook for `{origin}` did not run: {stop.what}", stop.why, stop.fix, color))}
    }
    // The first answer of each body, latest body first; a body inside one
    // already replaced keeps the outer answer.
    ^answered: [JetDriverToolStageItem]{}
    loop rows in run.answers.move() {
        loop row in rows.move() {
            ^taken: false
            loop body in answered {
                if body.at == row.at -> taken = true
            }
            if !taken -> answered.push(row)
        }
    }
    answered.sort_by(fn(left: JetDriverToolStageItem, right: JetDriverToolStageItem) { right.at <=> left.at })
    bytes: formatted.source.bytes()
    ^spliced: ""
    ^cursor: bytes.len()
    loop body in answered {
        if body.at + body.length > cursor -> next
        spliced = "{body.label}{foundation_byte_text(bytes, body.at + body.length, cursor)}{spliced}"
        cursor = body.at
    }
    spliced = "{foundation_byte_text(bytes, 0, cursor)}{spliced}"
    checked: jet_format_source(spliced, false)
    if !checked.ok -> return jet_cli_fmt_rejected(checked.diagnostics)
    jet_cli_fmt_formatted(spliced)
}

// Whether `text` imports a module outside Core: only such a module holds a
// hook, so a file without one compiles nothing for hooks.
jet_cli_tool_stage_imports_package: fn(text: String) -> Bool Never! {
    parsed: parse_source(text.bytes())
    loop declaration in parsed.program.imports {
        imported: if declaration.kind == {
            .Module(name, _) -> name
            .Unqualified(module_alias, _, _, _, _) -> module_alias
            .File(_, _) -> "core"
        }
        if imported.partition(".").head != "core" -> return true
    }
    false
}
