// `jet debug <dump.jetdump>`: a typed crash dump an observed run's stop
// wrote (`.jet/dumps/`, JetRuntime PerfSamples.jet perf_flight_dump), read
// behind the `(Jet)` console as Compiler/JetDebug NativeDump.jet opens it.
// It names the dump's parts (the image the run ran, the bytes of its
// records beside it, and the memory it holds against its budget), then
// shows the innermost Jet frame of the stop with its source line and its
// locals; `bt`, `frame N`, `locals` and `print` read the stop as a live
// session reads one, `tasks` lists every task the dump caught, running or
// parked, with where it is, and `task N` selects task N for them; `events
// [--last N]` lists the flight ring's records, oldest first. Nothing runs: a
// run-control command says so. A #Secret value shows as redacted, a value
// the dump cut off past its budget as cut off. The end of stdin or `quit`
// ends it.
use {
    cli_files: core.files
    cli_term: core.term
    jet_debug.[NATIVE_DEBUG_PROMPT, NATIVE_DUMP_HELP, NativeDebugError, NativeDumpTask, NativeFrame, NativeLocal, NativeSession, native_debug_backtrace, native_debug_jet_frame, native_debug_locals_line, native_debug_locals_typed, native_dump_events, native_dump_jet_frame, native_dump_open, native_dump_redact, native_dump_task_state]
    jet_driver.[JET_DRIVER_EXIT_OK]
}

// The ring records `events` lists without `--last`.
JET_CLI_DEBUG_DUMP_EVENTS: 20

jet_cli_debug_dump: fn(path: String, color: Bool) -[FS, IO, Time.Wait, FFI.Asm]> JetCLIPlan Never! {
    opened := native_dump_open(path) ?? return jet_cli_debug_unavailable(err, color)
    frames: opened.session.backtrace() ?? return jet_cli_debug_unavailable(err, color)
    stop: native_dump_jet_frame(frames, 0) ?? 0
    _ := opened.session.select_frame(stop) ?? return jet_cli_debug_unavailable(err, color)
    source: opened.session.run_source()
    lines: (cli_files.read(source) ?? "").split("\n").to_list()
    events: native_dump_events(opened.session.image, opened.ring)
    file: cli_files.basename(source)
    shown: jet_cli_debug_dump_frame(opened.session, frames, stop, file, lines) ?? return jet_cli_debug_unavailable(err, color)
    jet_cli_debug_write("Dump of process {opened.pid}, {events.len()} flight events\nImage: {opened.image} bytes, with {opened.records} bytes of records\nMemory: {opened.memory} bytes held, within the {opened.budget}-byte budget; {opened.cut_off} bytes cut off past it\n{shown}")
    input := cli_term.stdin()
    echo: !input.is_tty()
    loop {
        jet_cli_debug_write(NATIVE_DEBUG_PROMPT)
        read := String?{None}
        if input.read_line() == {
            .Ok(line) -> { read = line }
            .Err(_) -> {}
        }
        line: read ?? break
        command: line.trim()
        if echo -> jet_cli_debug_write("{command}\n")
        if command == "q" || command == "quit" -> break
        text: jet_cli_debug_dump_command(opened.session, line, events, file, lines) ?? return jet_cli_debug_unavailable(err, color)
        jet_cli_debug_write(text)
    }
    jet_cli_debug_write("\n")
    jet_cli_done("", "", JET_DRIVER_EXIT_OK)
}

// One console command's readout of the dump: `line`, as read.
jet_cli_debug_dump_command: fn(session: &NativeSession, line: String, events: [String], file: String, lines: [String]) -> String NativeDebugError! {
    command: line.trim()
    word: command.before(" ")
    operand: if command.contains(" ") -> command.after(" ").trim() else -> ""
    if word == {
        "bt" | "backtrace" -> {
            frames: session.backtrace() ?? return Err(err)
            Ok(native_debug_backtrace(frames))
        }
        "locals" -> {
            locals := jet_cli_debug_dump_locals(session) ?? return Err(err)
            locals.sort_by(fn(left: NativeLocal, right: NativeLocal) { left.name <=> right.name })
            Ok(native_debug_locals_typed(locals))
        }
        // A dump runs no code, so nothing is evaluated: `print` shows a
        // local of the selected frame by its name, as `locals` reads it.
        "p" | "print" -> {
            if operand == "" -> return Ok("Print needs a local's name, as `print total`\n")
            locals: jet_cli_debug_dump_locals(session) ?? return Err(err)
            loop local in locals {
                if local.name == operand -> return Ok("{local.name} = {local.value}\n")
            }
            Ok("Can't evaluate `{operand}`: a dump runs no code, so `print` shows a local by its name; `locals` lists them\n")
        }
        "frame" -> {
            frames: session.backtrace() ?? return Err(err)
            wanted: Int.parse(operand) ?? -1
            index: native_dump_jet_frame(frames, wanted) ?? return Ok("No frame {operand}; `bt` lists them\n")
            selected: session.select_frame(index) ?? return Err(err)
            if !selected -> return Ok("No frame {operand}; `bt` lists them\n")
            jet_cli_debug_dump_frame(session, frames, index, file, lines)
        }
        "tasks" -> Ok(jet_cli_debug_dump_tasks(session, file))
        "task" -> {
            wanted: Int.parse(operand) ?? -1
            index: jet_cli_debug_dump_task(session, wanted) ?? return Ok("No task {operand}; `tasks` lists them\n")
            session.task = index
            frames: session.backtrace() ?? return Err(err)
            stop: native_dump_jet_frame(frames, 0) ?? 0
            _ := session.select_frame(stop) ?? return Err(err)
            jet_cli_debug_dump_frame(session, frames, stop, file, lines)
        }
        "events" -> {
            last: if operand.starts_with("--last") -> Int.parse(operand.after("--last").trim()) ?? JET_CLI_DEBUG_DUMP_EVENTS else -> JET_CLI_DEBUG_DUMP_EVENTS
            from: if last >= 0 && events.len() > last -> events.len() - last else -> 0
            text := if events.len() == 0 -> "No events in the flight ring\n" else -> ""
            loop index in from..<events.len() -> text = "{text}{events[index]}\n"
            Ok(text)
        }
        "s" | "step" | "n" | "next" | "c" | "continue" | "f" | "finish" | "b" | "break" -> Ok("A dump doesn't run: it is the program as it stopped. {NATIVE_DUMP_HELP}\n")
        "h" | "help" -> Ok("{NATIVE_DUMP_HELP}\n")
        "" -> Ok("")
        else -> Ok("Unknown command `{word}`. {NATIVE_DUMP_HELP}\n")
    }
}

// The selected frame's locals, each #Secret one redacted.
jet_cli_debug_dump_locals: fn(session: &NativeSession) -> [NativeLocal] NativeDebugError! {
    locals := session.locals() ?? return Err(err)
    native_dump_redact(locals)
    Ok(locals)
}

// Each task of the dump, one line each, the selected one marked `*`: its
// id (a thread outside every task by its tid), whether it was stopped,
// running or parked, its innermost Jet frame, and, when that is not in the
// program's `file`, the innermost frame that is.
jet_cli_debug_dump_tasks: fn(session: &NativeSession, file: String) -> String Never! {
    tasks: if session.dump == .Val(dumped) -> dumped.tasks else -> [NativeDumpTask]{}
    chosen: session.task
    text := ""
    loop (index, task) in tasks {
        session.task = index
        frames: session.backtrace() ?? [NativeFrame]{}
        mark: if index == chosen -> "*" else -> " "
        name: if task.id == 0 -> "thread {task.tid}" else -> "task {task.id}"
        text = "{text}{mark} {name}  {native_dump_task_state(task)}{jet_cli_debug_dump_where(frames, file)}\n"
    }
    session.task = chosen
    text
}

// The index among the dump's tasks of task `id`.
jet_cli_debug_dump_task: fn(session: NativeSession, id: Int) -> Int? Never! {
    if session.dump == .Val(dumped) {
        loop (index, task) in dumped.tasks {
            if task.id == id -> return Val(index)
        }
    }
    None
}

// `  in <function>() at <file>:<line>` for the innermost Jet frame of
// `frames`, then `, from …` the innermost in the program's `file` when that
// is another; "" when none is Jet code.
jet_cli_debug_dump_where: fn(frames: [NativeFrame], file: String) -> String Never! {
    innermost: native_dump_jet_frame(frames, 0) ?? return ""
    frame: frames[innermost]
    shown: "  in {frame.function}() at {frame.file}:{frame.line}"
    if frame.file == file -> return shown
    loop index in innermost..<frames.len() {
        caller: frames[index]
        if native_debug_jet_frame(caller) && caller.file == file {
            return "{shown}, from {caller.function}() at {caller.file}:{caller.line}"
        }
    }
    shown
}

// Frame `index` of `frames`: where it is, its Jet source line when `file`
// (with the text `lines`) holds it, and its locals.
jet_cli_debug_dump_frame: fn(session: &NativeSession, frames: [NativeFrame], index: Int, file: String, lines: [String]) -> String NativeDebugError! {
    if index >= frames.len() -> return Ok("No Jet frame in the dump\n")
    frame: frames[index]
    source: if frame.file == file && frame.line >= 1 && frame.line <= lines.len() -> lines[frame.line - 1] else -> ""
    locals: jet_cli_debug_dump_locals(session) ?? return Err(err)
    Ok("Stopped  {frame.file}:{frame.line}  in {frame.function}()\n{frame.line} | {source}        <- here\n{native_debug_locals_line(locals)}\n")
}
