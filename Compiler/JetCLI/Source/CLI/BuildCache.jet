// `jet build`'s executables in the machine-wide ArtifactStore (JET_STORE_DIR,
// the store `jet cache` manages): an unchanged build restores its binary, with
// the runtime it links, instead of building it again. A stored binary whose
// bytes no longer match its digest is removed by the restore, reported in one
// note line, and rebuilt. The store is off: a build reads and writes it only
// while saved work is reused (BUILD_REUSE_SAVED_WORK), so every build compiles.
use {
    cache_crypto: core.crypto
    cli_files: core.files
    cli_sys: core.sys
    jet_backend.[X64DebugSource, X64Executable]
    jet_driver.[JetDriverAuthorizedSourceSnapshot, JetDriverCompileResult, JetDriverComptimeInputRecord, JetDriverLoweringInputs, JetDriverVerbOutput, jet_driver_display_path, jet_driver_entry_root_path]
    jet_foundation.[BUILD_REUSE_SAVED_WORK, BuildOptions, build_options_key, build_options_value, sha256_hex, sha256_hex_bytes]
    jet_pkg_model.[JET_VERSION]
    jetpack_artifact_store.[ArtifactRestore, ArtifactStore]
}

// A built `jet build` executable: its path, the lines its build reports
// on stderr before the effect summary, and whether the store gave it back
// instead of the backend writing it.
JetCLIStoredBuild: enum {
    Written(path: String, log: String, reused: Bool),
    Failed(output: JetDriverVerbOutput),
}

// `jet build`'s executable `name`, restored from the store when a build of
// the same key stored it (jet_cli_build_cache_key), else built through
// jet_cli_build_binary and stored. `verbose` reports the runtime pack and the
// cache decision as `[build]` lines. A store that can't be opened or written,
// or saved work that isn't reused, leaves the build uncached, as does a link
// or post-link step, which runs on every build. `invocation` grants those
// steps' effects.
jet_cli_build_stored: fn(file: String, name: String, color: Bool, options: BuildOptions, result: JetDriverCompileResult, inputs: ^^JetDriverLoweringInputs?, snapshot: JetDriverAuthorizedSourceSnapshot, verbose: Bool, invocation: JetCLIInvocationAuthority?) -[Env, FS, Exec, IO, Net, Time, Rand, FFI.Asm]> JetCLIStoredBuild Never! {
    log := ""
    if verbose {
        log = "[build] runtime   -> packaged {jet_cli_runtime_key(jet_cli_runtime_dir()) ?? "missing"}\n"
    }
    store := ArtifactStore?{None}
    key := ""
    // Each source hashed once, for the key and the image's source record.
    digests := [X64DebugSource]{}
    if result.internal_problem == .None && result.complete {
        if jet_cli_build_option_gate_refusal(file, snapshot.roots[0].canonical_path, result, options, color) == .Val(refused) {
            return JetCLIStoredBuild.Failed{output: refused}
        }
        keyed: BUILD_REUSE_SAVED_WORK && !jet_cli_link_steps(options)
        if keyed || build_options_value(options, "debug_info") != "false" {
            digests = jet_cli_source_digests(snapshot)
        }
        if keyed {
            key = jet_cli_build_cache_key(file, name, options, snapshot, digests, result.comptime_inputs) ?? ""
        }
        if {
            !BUILD_REUSE_SAVED_WORK -> {
                if verbose -> log = "{log}[build] cache off -> every build compiles live\n"
            }
            jet_cli_link_steps(options) -> {
                if verbose {
                    log = "{log}[build] cache off -> a link or post-link step runs on every build\n"
                }
            }
            key == "" -> {
                if verbose {
                    log = "{log}[build] cache off -> this compiler, its runtime or its Core sources can't be identified\n"
                }
            }
            else -> {
                // A cold store makes its layout here (trace span "store.open").
                trace_sink: result.trace_sink
                if trace_sink == .Val(sink) -> sink.begin("store.open", "", -1, -1)
                if ArtifactStore.from_env() == {
                    .Ok(opened) -> { store = Val(opened) }
                    .Err(error) -> {
                        if verbose -> log = "{log}[build] cache off -> {error.message()}\n"
                    }
                }
                if trace_sink == .Val(sink) -> sink.end("store.open", 1)
            }
        }
    }
    build_dir: jet_cli_output_dir_path(snapshot, options)
    binary: "{build_dir}/{name}"
    if store == .Val(opened) {
        if jet_cli_build_dir(build_dir, color) == .Val(refused) {
            return JetCLIStoredBuild.Failed{output: refused}
        }
        if jet_cli_build_restore(opened, key, binary, snapshot.roots[0].canonical_path) == {
            .Ok(restored) -> {
                if restored == {
                    .Hit(_, _) -> {
                        if verbose -> log = "{log}[build] cache hit -> reused cached binary\n"
                        return JetCLIStoredBuild.Written{path: binary, log: log, reused: true}
                    }
                    .Corrupt -> {
                        log = "{log}Note: removed a corrupt cached binary of `{name}` from the store; rebuilding it\n"
                    }
                    .Missing -> {}
                }
            }
            .Err(reason) -> {
                if verbose -> log = "{log}[build] cache off -> {reason}\n"
            }
        }
        if verbose -> log = "{log}[build] cache miss -> compiling\n"
    }
    built := jet_cli_build_binary(file, name, "build", color, options, result, inputs, snapshot, invocation, digests)
    if built.move() == {
        .Failed(failure) -> JetCLIStoredBuild.Failed{output: failure}
        .Image(executable, path) -> JetCLIStoredBuild.Written{path: path, log: "{log}{jet_cli_build_store(store, key, path, executable, verbose)}", reused: false}
    }
}

// The side keys of a stored build: its split debug file and the id its
// symbol-store copy is named by (jet_cli_symbols_file).
jet_cli_build_side_key: fn(key: String, side: String) -> String Never! {
    sha256_hex("{key}:{side}")
}

// Restore the executable of `key` to `binary`, with its side debug file: in
// the symbol store of the package at `root` with its name beside `binary` a
// hard link to it, as jet_cli_symbols_file files it, or beside `binary` alone for
// an image without a build id. A side entry the store no longer holds makes
// the whole build a miss; the error is why the store couldn't be read or the
// restored files written.
jet_cli_build_restore: fn(store: ArtifactStore, key: String, binary: String, root: String) -[FS, Env, Exec, Time, Rand]> ArtifactRestore Err! {
    id := ""
    debug := [U8]{}
    sides: [String]{"build-id", "debug"}
    loop side in sides {
        found: store.lookup_artifact(jet_cli_build_side_key(key, side)) ?? return Err(err.message())
        if found == {
            .Hit(artifact) -> {
                bytes: cli_files.read_bytes(artifact.path) ?? return Ok(ArtifactRestore.Missing)
                if side == "debug" -> debug = bytes else {
                    id = String.from_bytes(bytes) ?? return Ok(ArtifactRestore.Corrupt)
                }
            }
            .Corrupt -> return Ok(ArtifactRestore.Corrupt)
            .Missing -> return Ok(ArtifactRestore.Missing)
        }
    }
    restored: store.restore_file(key, binary) ?? return Err(err.message())
    if restored == {
        .Hit(_, _) -> {}
        .Missing | .Corrupt -> return Ok(restored)
    }
    beside: "{binary}.debug"
    if {
        id != "" -> {
            dir: "{jet_cli_symbols_store(root)}/{id.slice(0, 2)}"
            cli_files.create_dir_all(dir) ?? return Err("couldn't create the symbol store {dir}: {err}")
            file: "{dir}/{id.slice(2, id.len())}.debug"
            cli_files.write_bytes(file, debug) ?? return Err("couldn't write the symbol store {dir}: {err}")
            cli_files.remove(beside).drop("a missing side file is the first build's")
            if cli_files.hard_link(file, beside) == .Err(_) {
                cli_files.write_bytes(beside, debug) ?? return Err("couldn't write {beside}: {err}")
            }
        }
        debug.len() > 0 -> {
            cli_files.remove(beside).drop("a missing side file is the first build's")
            cli_files.write_bytes(beside, debug) ?? return Err("couldn't write {beside}: {err}")
        }
        else -> {}
    }
    Ok(restored)
}

// Store the built executable at `path` under `key`, its side entries first,
// so a stored executable always has them; the `--verbose` line it reports.
// The entries are published without disk syncs: a restore verifies their
// digests, so an entry a crash lost or tore is a miss that builds again.
jet_cli_build_store: fn(store: ArtifactStore?, key: String, path: String, executable: X64Executable, verbose: Bool) -[FS, Env, Exec, Time, Rand]> String Never! {
    opened: store ?? return ""
    id: if executable.build_id.len() > 0 -> sha256_hex_bytes(executable.build_id) else -> ""
    if opened.publish_bytes(jet_cli_build_side_key(key, "build-id"), id.bytes(), executable: false, durable: false) == .Err(error) {
        return jet_cli_build_store_off(verbose, error.message())
    }
    if opened.publish_bytes(jet_cli_build_side_key(key, "debug"), executable.debug_file, executable: false, durable: false) == .Err(error) {
        return jet_cli_build_store_off(verbose, error.message())
    }
    if opened.publish_file(key, path, durable: false) == .Err(error) {
        return jet_cli_build_store_off(verbose, error.message())
    }
    if verbose -> "[build] cache store -> saved binary\n" else -> ""
}

jet_cli_build_store_off: fn(verbose: Bool, reason: String) -> String Never! {
    if verbose -> "[build] cache off -> {reason}\n" else -> ""
}

// The store key of `name`'s executable: this compiler (its identity, else its
// file's), the runtime pack it links, the Core sources it compiles (the named
// tree's files, else the Core built into the compiler, which the compiler's
// part names), the build options and host, every source of the authorized
// snapshot (`digests`, jet_cli_source_digests, and each foreign cache file),
// every comptime input the compile read (`comptime_inputs`: an
// edited `embed_file` asset is a new key) and the functions the package lays
// out first (jet_cli_hot_text: an edited hot-text.list is a new image), each
// part length-framed and hashed together. None when the compiler, its runtime
// or a named tree's Core sources can't be identified.
jet_cli_build_cache_key: fn(file: String, name: String, options: BuildOptions, snapshot: JetDriverAuthorizedSourceSnapshot, digests: [X64DebugSource], comptime_inputs: [JetDriverComptimeInputRecord]) -[FS, Env]> String? Never! {
    parts := [String]{"jet-build-binary-v1", JET_VERSION, name, build_options_key(options), "{cli_sys.arch()}-{cli_sys.name()}"}
    compiler: if jet_cli_compiler_identity() == {
        .Val(identity) -> identity
        None -> jet_cli_identity_key("file", cli_files.stat(cli_sys.executable()) ?? return None)
    }
    parts.push(compiler)
    parts.push(jet_cli_runtime_key(jet_cli_runtime_dir()) ?? return None)
    if jet_cli_named_toolchain(file) == .Val(toolchain) {
        core_rows: jet_cli_toolchain_core_rows(toolchain) ?? return None
        loop row in core_rows {
            path: jet_cli_authority_path(toolchain, row.path)
            parts.push(row.path)
            parts.push(jet_cli_identity_key("file", cli_files.stat(path) ?? return None))
        }
    } else { parts.push("core built in") }
    // The sources by their paths from the entry root, which itself names
    // where they are.
    parts.push(jet_driver_entry_root_path(snapshot))
    loop source in digests {
        parts.push("{source.path}")
        parts.push(sha256_hex_bytes(source.digest))
    }
    loop root in snapshot.roots {
        loop source in root.foreign_cache_files {
            parts.push(source.path)
            parts.push(sha256_hex(source.source))
        }
    }
    loop dependency in snapshot.script_dependencies {
        parts.push("{dependency.name}={dependency.content_hash}")
    }
    loop input in comptime_inputs {
        parts.push("comptime-input:{input.file}")
        parts.push(input.sha256)
    }
    if snapshot.roots.len() > 0 {
        parts.push("hot-text:{jet_cli_hot_text(snapshot.roots[0].canonical_path).join("\n")}")
    }
    framed: loop part in parts -> "{part.len()}:{part}"
    Val(sha256_hex(framed.join("\n")))
}

// Each source of `snapshot`'s roots (their `.jet` files and package
// manifests; not their foreign caches), hashed once: its path from the
// entry root (jet_driver_display_path), as the compile names it, and the
// sha256 of its text. A build's store key (jet_cli_build_cache_key) and its
// image's source record (`.debug_jetsource`, jet_cli_native_object) take
// them, and `jet debug` proves a source unchanged since the build with them
// (DebugCompile.jet). 33 bytes of the record a source, besides its path.
jet_cli_source_digests: fn(snapshot: JetDriverAuthorizedSourceSnapshot) -> [X64DebugSource] Never! {
    entry_root: jet_driver_entry_root_path(snapshot)
    digests := [X64DebugSource]{}
    loop root in snapshot.roots {
        loop source in root.files {
            digests.push(X64DebugSource{path: jet_driver_display_path(entry_root, source.path), digest: cache_crypto.sha256(source.source).as_bytes()})
        }
    }
    digests
}

// The source record an image built under `options` carries: none without
// `debug_info`, whose image has no debug sections.
jet_cli_build_digests: fn(snapshot: JetDriverAuthorizedSourceSnapshot, options: BuildOptions) -> [X64DebugSource] Never! {
    if build_options_value(options, "debug_info") == "false" -> return [X64DebugSource]{}
    jet_cli_source_digests(snapshot)
}
