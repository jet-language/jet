// Adapted from origin/port/compiler Compiler/JetDriver/Source/ProjectParts.jet
// run_project_parts. Discovery uses the CLI's canonical authority source walk;
// parsing uses the driver's inline-package-aware parser. A part is named by
// its canonical path, as the name ledger, hover and reflection spell it: the
// file's module path (jet_driver_module_display, the path registration gives
// the module), then the declared module's name (`shapes.jet`'s `geo` is
// `shapes.geo`).
use {
    jet_foundation.[Diagnostic, diagnostic_from_registry, diagnostic_render_all]
    jet_driver.[JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USER_ERROR, JetDriverAuthorizedSourceFile, jet_driver_module_display]
    cli_files: core.files
}

JetCLIProjectPart: struct {
    name: String,
    module_path: String,
    path: String,
    automatic: Bool,
}

jet_cli_project_part_value: fn(name: String, path: String, state: String) -> JetCLIStatusValue Never! {
    jet_cli_status_object(
        [JetCLIStatusField]{
            jet_cli_status_field("name", jet_cli_status_text(name)),
            jet_cli_status_field("path", jet_cli_status_text(path)),
            jet_cli_status_field("state", jet_cli_status_text(state)),
        },
    )
}

jet_cli_project_parts: fn(args: [String], color: Bool, json: Bool) -[FS, Env]> JetCLIPlan Never! {
    skipped_only: args.contains("--skipped")
    root: cli_files.cwd() ?? "."
    files := [JetDriverAuthorizedSourceFile]{}
    if jet_cli_discover_sources(root, files) == .Val(problem) {
        return jet_cli_fail("E1334", "couldn't discover source files authority `{root}`", problem, "restore access to the authority metadata and try again", color, JET_DRIVER_EXIT_USER_ERROR)
    }
    explicit := [String]{}
    declarations := [JetCLIProjectPart]{}
    sources := [String]{}
    names := [String]{}
    loop file in files {
        filename: jet_cli_file_name(file.relative_path)
        if filename == "package.jet" || filename == "pkg.jet" || (jet_cli_relative_parent(file.relative_path) == "" && JET_CLI_COMMAND_ROLE_FILES.contains(filename)) {
            next
        }
        program: jet_cli_parsed_program(file.source) ?? next
        sources.push(file.relative_path)
        // An exact `use project._name` opts a skipped part in (spec.md,
        // module discovery). Two segments parse as a member import of
        // `project`; a longer path parses as a module import.
        loop imported in program.imports {
            if imported.kind == {
                .Module(name, _) -> {
                    if name.starts_with("project.") {
                        leaf: name.slice(8..<name.len())
                        if !explicit.contains(leaf) -> explicit.push(leaf)
                    }
                }
                .Unqualified(module_alias, _, items, _, _) -> {
                    if module_alias == "project" {
                        loop item in items {
                            if !explicit.contains(item.original) {
                                explicit.push(item.original.copy())
                            }
                        }
                    }
                }
                .File(_, _) -> {}
            }
        }
        module_path: jet_driver_module_display(file.relative_path)
        loop item in program.items {
            if item == {
                .Module(declared) -> {
                    declarations.push(JetCLIProjectPart{name: declared.name, module_path: "{module_path}.{declared.name}", path: file.relative_path, automatic: declared.auto_discovered})
                    if !names.contains(declared.name) -> names.push(declared.name)
                }
                .CodeModule(declared) -> {
                    declarations.push(JetCLIProjectPart{name: declared.name, module_path: "{module_path}.{declared.name}", path: file.relative_path, automatic: !declared.name.starts_with("_")})
                    if !names.contains(declared.name) -> names.push(declared.name)
                }
                .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
            }
        }
    }
    names.sort()
    part_values := [JetCLIStatusValue]{}
    conflict_values := [JetCLIStatusValue]{}
    output := ""
    diagnostics := [Diagnostic]{}
    declared_paths := [String]{}
    loop declaration in declarations {
        if !declared_paths.contains(declaration.path) -> declared_paths.push(declaration.path)
    }
    loop name in names {
        paths := [String]{}
        module_paths := [String]{}
        loop declaration in declarations {
            if declaration.name != name -> next
            paths.push(declaration.path)
            module_paths.push(declaration.module_path)
            state: if {
                declaration.automatic -> "automatic"
                explicit.contains(name) -> "explicit"
                else -> "skipped"
            }
            if skipped_only && state != "skipped" -> next
            part_values.push(jet_cli_project_part_value(declaration.module_path, declaration.path, state))
            output = "{output}{jet_cli_pad(state, 9)} {jet_cli_pad(declaration.module_path, 24)} {declaration.path}\n"
        }
        // Two files declaring one module name share the leaf, so the
        // conflict names each declaration by its path.
        if paths.len() > 1 {
            conflict_values.push(
                jet_cli_status_object(
                    [JetCLIStatusField]{
                        jet_cli_status_field("name", jet_cli_status_text(name)),
                        jet_cli_status_field("modules", jet_cli_status_texts(module_paths)),
                        jet_cli_status_field("paths", jet_cli_status_texts(paths)),
                    },
                ),
            )
            diagnostics.push(diagnostic_from_registry("E0606", None, "project module `{name}` is declared more than once", "a project module name must resolve to one declaration", "keep one `{name}: module` declaration; found {module_paths.join(", ")}"))
        }
    }
    if !skipped_only {
        loop path in sources {
            if declared_paths.contains(path) -> next
            name: jet_driver_module_display(path)
            part_values.push(jet_cli_project_part_value(name, path, "automatic"))
            output = "{output}{jet_cli_pad("automatic", 9)} {jet_cli_pad(name, 24)} {path}\n"
        }
    }
    status: if diagnostics.len() == 0 -> JET_DRIVER_EXIT_OK else -> JET_DRIVER_EXIT_USER_ERROR
    if json {
        fields: [JetCLIStatusField]{
            jet_cli_status_field("parts", jet_cli_status_array(part_values)),
            jet_cli_status_field("conflicts", jet_cli_status_array(conflict_values)),
        }
        return jet_cli_done("{jet_cli_status_render("inspect.parts", true, fields)}\n", "", status)
    }
    jet_cli_done(output, diagnostic_render_all("", "", diagnostics, false), status)
}
