// `jet perf attach --lens=syscalls -- <command>`: jet starts the command
// traced as a whole (x64_trace_command), so each system call of the command
// and of every thread and process it starts stops it as it enters and as it
// returns. Each call is kept with its process and thread, its arguments
// decoded (opened paths, open and clone flags, socket families, the stat a
// call filled) and its result, as the trace's `syscalls` receipt section.
// The command shares jet's terminal, and its exit code is the attach's.
// With `--lens=counts,syscalls` the trace also counts it (x64_counters_open).
// When the kernel refuses the trace, the command runs untraced and the
// section says why.
use {
    perf_files: core.files
    perf_process: core.process
    perf_time: core.time
    jet_backend.[
        X64Counted,
        X64Trace,
        X64_TRACE_EVENT_EXEC,
        X64_TRACE_ORIG_RAX,
        X64_TRACE_R10,
        X64_TRACE_R8,
        X64_TRACE_R9,
        X64_TRACE_RAX,
        X64_TRACE_RDI,
        X64_TRACE_RDX,
        X64_TRACE_REGISTERS,
        X64_TRACE_RSI,
        X64_TRACE_SYSCALL_STOP,
        x64_counted_run,
        x64_counters_close,
        x64_counters_open,
        x64_trace_close,
        x64_trace_command,
        x64_trace_detach,
        x64_trace_event_message,
        x64_trace_of,
        x64_trace_read,
        x64_trace_stop,
        x64_trace_syscall_step,
    ]
    jet_driver.[JetDriverVerbOutput]
    jet_foundation.[
        CanonicalJSON,
        CanonicalJSONField,
        TraceReceiptSection,
        canonical_json_sha256,
        jettrace_array,
        jettrace_object_view,
    ]
}

// The signal that stops a thread, which a thread or process the command
// starts first stops with, and which jet sends a process it lets go.
JET_CLI_PERF_SIGSTOP: 19

// The longest path a call's argument shows, as the kernel's PATH_MAX.
JET_CLI_PERF_PATH_MAX: 4096

// The most bytes of a call's data buffer an argument shows.
JET_CLI_PERF_BYTES_SHOWN: 32

// A thread of a traced command: its id, its process's, whether its first
// stop came (a thread or process the command starts begins stopped by a
// SIGSTOP the trace swallows), whether jet asked it to stop so it can let
// it go, and whether it has ended.
JetCLIPerfTracee: struct {
    tid: Int,
    pid: Int,
    started: Bool,
    leaving: Bool,
    gone: Bool,
}

// The system call a traced thread is inside: its number, its six arguments
// and those decoded at its entry, one text per argument kind.
JetCLIPerfCallEntry: struct {
    number: Int,
    args: [Int],
    shown: [String],
}

// One system call a traced command made: its process, its thread, its
// number and name, its decoded arguments as one text, its result (`?` for a
// call that never returned, as exit_group) and whether it failed.
JetCLIPerfTracedCall: struct {
    pid: Int,
    tid: Int,
    number: Int,
    name: String,
    args: String,
    result: String,
    failed: Bool,
}

// What the trace of a command saw: the command's run (its wait status, the
// CPU time and peak memory of its reap, and its counts under
// `--lens=counts`), its calls in the order they returned, the processes it
// had, those still running when it ended (each let go untraced), and the
// error the kernel refused the trace with (0 when it traced).
JetCLIPerfTracedRun: struct {
    counted: X64Counted,
    calls: [JetCLIPerfTracedCall],
    processes: Int,
    left: Int,
    refused: Int,
}

// The calls of one name in one process (jet_cli_perf_traced_section).
JetCLIPerfTracedSum: struct {
    pid: Int,
    number: Int,
    name: String,
    count: Int,
    errors: Int,
}

// A system call's name and how each of its arguments reads, as space-separated
// kinds (jet_cli_perf_call_arg).
JetCLIPerfSyscallShape: struct {
    name: String,
    args: String,
}

// Trace `command` (its program's name or path, then its arguments), and
// count it too when `counts`, and write the trace to `out`, or where any
// attach writes it.
jet_cli_perf_attach_syscalls: fn(command: &&[String], counts: Bool, out: String?, allowlist: [String], quiet: Bool, color: Bool) -[FS, Env, Exec, Time, FFI.Asm]> JetDriverVerbOutput Never! {
    name: command[0]
    path: perf_process.which(name) ?? return jet_cli_perf_failed("Jet can't run `{name}`: no such program file{if name.contains("/") -> "" else -> " on PATH"}", color)
    started: perf_time.instant()
    run := JetCLIPerfTracedRun{
        counted: X64Counted{status: -1, failure: "", instructions: None, cycles: None, errno: 0, scaled: false, cpu_ns: 0, peak_rss_bytes: 0},
        calls: [JetCLIPerfTracedCall]{},
        processes: 0,
        left: 0,
        refused: 0,
    }
    trace := x64_trace_command(path, command, None)
    if trace.refused != 0 {
        // The program exited before its execve, so the command never ran:
        // it runs now, untraced.
        run.refused = trace.refused
        x64_trace_close(trace)
        run.counted = x64_counted_run(path, command, None)
    } else if trace.failure != "" {
        failure: "{trace.failure}"
        x64_trace_close(trace)
        return jet_cli_perf_failed("Jet can't run `{name}`: {failure}", color)
    } else if counts {
        counters: x64_counters_open(trace.pid)
        jet_cli_perf_syscalls_follow(trace, run)
        x64_counters_close(counters, run.counted)
        x64_trace_close(trace)
    } else {
        jet_cli_perf_syscalls_follow(trace, run)
        x64_trace_close(trace)
    }
    wall: started.elapsed().ns
    if run.counted.failure != "" {
        return jet_cli_perf_failed("Jet can't run `{name}`: {run.counted.failure}", color)
    }
    capture := jet_cli_perf_command_capture("a traced command keeps its system calls, not samples: its `syscalls` receipt section", run.counted.cpu_ns, wall)
    capture.policy.allowlist = allowlist
    scope: jet_cli_perf_ptrace_scope()
    traced: jet_cli_perf_traced_section(run.calls, run.processes, run.left, run.refused, scope)
    said := jet_cli_perf_traced_header(traced.value)
    capture.receipts.push(traced)
    if counts {
        section: jet_cli_perf_counts_section(run.counted, wall, jet_cli_perf_counts_paranoid())
        said = "{said}\n{jet_cli_perf_counts_text(section.value)}"
        capture.receipts.push(section)
    }
    argv := [String]{"attach", if counts -> "--lens=counts,syscalls" else -> "--lens=syscalls"}
    if allowlist.len() > 0 {
        argv.push("--capture")
        argv.push(allowlist.join(","))
    }
    argv.push("--")
    argv.extend(command.move())
    written: jet_cli_perf_session_write(capture, "attach", argv, out) ?? return jet_cli_perf_failed(err.message, color)
    JetDriverVerbOutput{stdout: "", stderr: if quiet -> "" else -> "{said}\nTrace: {written}\n", exit_code: jet_cli_perf_counts_exit(run.counted.status)}
}

// Follow the command `trace` started (x64_trace_command) to its end, each
// system call of each of its threads into `run`. A thread or process it
// starts is traced from its first stop, a SIGSTOP the trace swallows. A
// signal for the command is delivered as it comes. Once the command ends,
// each process it left running is stopped and let go, untraced.
jet_cli_perf_syscalls_follow: fn(trace: X64Trace, run: &JetCLIPerfTracedRun) -[FS.Read, FFI.Asm]> Never! {
    tracees := [JetCLIPerfTracee]{jet_cli_perf_tracee(trace.pid, trace.pid, true, false)}
    // Each thread's latest place in `tracees`.
    places := [Int:Int]{}
    places[trace.pid] = 0
    // The call each place's thread is inside, by its place.
    open_calls := [Int:JetCLIPerfCallEntry]{}
    pids := [Int]{trace.pid}
    left := [Int]{}
    live := 1
    ended := false
    resume := trace.pid
    signal := 0
    loop {
        step: x64_trace_syscall_step(trace, resume, signal)
        resume = 0
        signal = 0
        if step.thread <= 0 {
            if !ended -> run.counted.failure = "the trace lost the command (errno {-step.thread})"
            break
        }
        thread: step.thread
        at := places.get(thread) ?? -1
        if at >= 0 && tracees[at].gone -> at = -1
        if step.status & 0xff != 0x7f {
            // The thread ended.
            if at >= 0 {
                if open_calls.pop(at) == .Val(entry) {
                    run.calls.push(jet_cli_perf_call_finish(trace, tracees[at], entry.move(), None))
                }
                tracees[at].gone = true
                live -= 1
            }
            if thread == trace.pid {
                ended = true
                run.counted.status = step.status
                run.counted.cpu_ns = step.cpu_ns
                run.counted.peak_rss_bytes = step.peak_rss_bytes
                loop index in 0..<tracees.len() {
                    if tracees[index].gone || tracees[index].leaving -> next
                    tracees[index].leaving = true
                    _ := x64_trace_stop(x64_trace_of(trace, tracees[index].pid), tracees[index].tid)
                }
            }
            if ended && live == 0 -> break
            next
        }
        if at < 0 {
            pid: jet_cli_perf_thread_process(thread)
            if !pids.contains(pid) -> pids.push(pid)
            at = tracees.len()
            places[thread] = at
            tracees.push(jet_cli_perf_tracee(thread, pid, false, ended))
            live += 1
        }
        stop: (step.status >> 8) & 0xff
        event: step.status >> 16
        if stop == X64_TRACE_SYSCALL_STOP {
            jet_cli_perf_syscall_stop(trace, tracees, at, step.registers, open_calls, run.calls)
            resume = thread
            next
        }
        if event != 0 {
            if event == X64_TRACE_EVENT_EXEC {
                // An execve by another thread than the program's first takes
                // the first one's id: its call goes on under this one.
                former: x64_trace_event_message(x64_trace_of(trace, thread)) ?? thread
                was: if former == thread -> -1 else -> places.get(former) ?? -1
                if was >= 0 && !tracees[was].gone {
                    _ := open_calls.pop(at)
                    if open_calls.pop(was) == .Val(entry) -> open_calls[at] = entry.move()
                    tracees[was].gone = true
                    live -= 1
                }
            }
            resume = thread
            next
        }
        if stop == JET_CLI_PERF_SIGSTOP && (!tracees[at].started || tracees[at].leaving) {
            if tracees[at].leaving {
                _ := x64_trace_detach(x64_trace_of(trace, thread), 0)
                if !left.contains(tracees[at].pid) -> left.push(tracees[at].pid)
                tracees[at].gone = true
                live -= 1
                if ended && live == 0 -> break
                next
            }
            tracees[at].started = true
            resume = thread
            next
        }
        tracees[at].started = true
        resume = thread
        signal = stop
    }
    run.processes = pids.len()
    run.left = left.len()
}

// A thread first seen stopped: `started` when its first stop has come,
// `leaving` when jet lets it go at its next SIGSTOP.
jet_cli_perf_tracee: fn(tid: Int, pid: Int, started: Bool, leaving: Bool) -> JetCLIPerfTracee Never! {
    JetCLIPerfTracee{tid: tid, pid: pid, started: started, leaving: leaving, gone: false}
}

// The process thread `thread` belongs to (its `/proc` status's Tgid);
// itself when that can't be read.
jet_cli_perf_thread_process: fn(thread: Int) -[FS.Read]> Int Never! {
    text: perf_files.read("/proc/{thread}/status") ?? return thread
    loop line in text.lines() {
        if line.starts_with("Tgid:") {
            return Int.parse(line.slice(5..<line.len()).trim()) ?? thread
        }
    }
    thread
}

// Yama's ptrace_scope, None where the kernel has no Yama.
jet_cli_perf_ptrace_scope: fn() -[FS]> Int? Never! {
    text: perf_files.read("/proc/sys/kernel/yama/ptrace_scope") ?? return None
    level: Int.parse(text.trim()) ?? return None
    Val(level)
}

// A system call's stop of `tracees[at]`, whose `registers` the step read:
// at its entry the call's number and arguments open it in `open_calls`,
// those read before the kernel runs it decoded; at its exit the call, its
// result and the arguments the kernel filled join `calls`.
jet_cli_perf_syscall_stop: fn(trace: X64Trace, tracees: [JetCLIPerfTracee], at: Int, registers: [Int], open_calls: &[Int:JetCLIPerfCallEntry], calls: &[JetCLIPerfTracedCall]) -[FFI.Asm]> Never! {
    if registers.len() != X64_TRACE_REGISTERS {
        return
    }
    if open_calls.pop(at) == .Val(entry) {
        calls.push(jet_cli_perf_call_finish(trace, tracees[at], entry.move(), Val(registers[X64_TRACE_RAX])))
        return
    }
    number: registers[X64_TRACE_ORIG_RAX]
    args: [Int]{registers[X64_TRACE_RDI], registers[X64_TRACE_RSI], registers[X64_TRACE_RDX], registers[X64_TRACE_R10], registers[X64_TRACE_R8], registers[X64_TRACE_R9]}
    shown: jet_cli_perf_call_entry(x64_trace_of(trace, tracees[at].tid), number, args)
    open_calls[at] = JetCLIPerfCallEntry{number: number, args: args, shown: shown}
}

// The arguments of call `number` that read at its entry, decoded; "" for
// each the kernel fills (jet_cli_perf_call_exit_kind).
jet_cli_perf_call_entry: fn(view: X64Trace, number: Int, args: [Int]) -[FFI.Asm]> [String] Never! {
    kinds: jet_cli_perf_call_kinds(jet_cli_perf_syscall_shape(number).args)
    shown := [String]{}
    loop (index, kind) in kinds {
        if index >= args.len() || jet_cli_perf_call_exit_kind(kind) {
            shown.push("")
            next
        }
        after: if index + 1 < args.len() -> args[index + 1] else -> 0
        shown.push(jet_cli_perf_call_arg(view, kind, args[index], after))
    }
    shown
}

// The kinds of a call's arguments, from its shape's `args`.
jet_cli_perf_call_kinds: fn(args: String) -> [String] Never! {
    if args == "" -> return [String]{}
    args.split(" ").to_list()
}

// Whether an argument of kind `kind` is one the kernel fills, so it reads
// at the call's exit.
jet_cli_perf_call_exit_kind: fn(kind: String) -> Bool Never! {
    kind == "out" || kind == "stat" || kind == "statx" || kind == "pair"
}

// The call `tracee` was inside, opened as `entry` (jet_cli_perf_syscall_stop),
// returned with `result` (None for one that never returned): the arguments
// decoded at its entry move into it, those the kernel filled are decoded
// now, when it succeeded. Its entry decoded one text per argument kind.
jet_cli_perf_call_finish: fn(trace: X64Trace, tracee: JetCLIPerfTracee, entry: &&JetCLIPerfCallEntry, result: Int?) -[FFI.Asm]> JetCLIPerfTracedCall Never! {
    number: entry.number
    args: entry.args
    shape: jet_cli_perf_syscall_shape(number)
    kinds: jet_cli_perf_call_kinds(shape.args)
    view: x64_trace_of(trace, tracee.tid)
    value: result ?? 0
    failed: result != None && value < 0 && value >= -4095
    parts := [String]{}
    loop (index, shown) in entry.shown.move() {
        if index >= args.len() || index >= kinds.len() -> break
        kind: kinds[index]
        arg: args[index]
        // An open's mode counts only when it creates a file.
        if kind == "mode" && index > 0 && kinds[index - 1] == "oflags" && args[index - 1] & 0x400040 == 0 {
            next
        }
        if !jet_cli_perf_call_exit_kind(kind) {
            parts.push(shown)
            next
        }
        if result == None || failed {
            parts.push(jet_cli_perf_call_hex(arg))
            next
        }
        parts.push(jet_cli_perf_call_arg(view, kind, arg, value))
    }
    said: if result == .Val(returned) -> jet_cli_perf_call_result(number, returned) else -> "?"
    JetCLIPerfTracedCall{pid: tracee.pid, tid: tracee.tid, number: number, name: shape.name, args: parts.join(", "), result: said, failed: failed}
}

// A call's result as strace shows one: `-1 ENOENT` for an error, an address
// in hex for the calls that return one, otherwise in decimal.
jet_cli_perf_call_result: fn(number: Int, value: Int) -> String Never! {
    if value < 0 && value >= -4095 -> return "-1 {jet_cli_perf_errno_name(-value)}"
    // mmap, brk, mremap and shmat return an address.
    if number == 9 || number == 12 || number == 25 || number == 30 {
        return jet_cli_perf_call_hex(value)
    }
    "{value}"
}

// Argument `value` of kind `kind`, read from the stopped thread `view`
// where it points into it; `next` is the argument after it, or the call's
// result for the kinds the kernel fills: a buffer's length.
jet_cli_perf_call_arg: fn(view: X64Trace, kind: String, value: Int, next: Int) -[FFI.Asm]> String Never! {
    if kind == {
        "int" -> "{value}"
        "uint" -> if value < 0 -> jet_cli_perf_call_hex(value) else -> "{value}"
        "fd" -> "{jet_cli_perf_int32(value)}"
        "dirfd" -> if jet_cli_perf_int32(value) == -100 -> "AT_FDCWD" else -> "{jet_cli_perf_int32(value)}"
        "path" -> jet_cli_perf_call_string(view, value)
        "in" -> jet_cli_perf_call_bytes(view, value, next)
        "out" -> jet_cli_perf_call_bytes(view, value, next)
        "oflags" -> jet_cli_perf_open_flags(value)
        "mode" -> jet_cli_perf_call_mode(value)
        "atflags" -> jet_cli_perf_flags(value, [Int]{0x100, 0x200, 0x400, 0x800, 0x1000, 0x2000, 0x4000, 0x8000}, [String]{"AT_SYMLINK_NOFOLLOW", "AT_REMOVEDIR", "AT_SYMLINK_FOLLOW", "AT_NO_AUTOMOUNT", "AT_EMPTY_PATH", "AT_STATX_FORCE_SYNC", "AT_STATX_DONT_SYNC", "AT_RECURSIVE"}, "0")
        "clone" -> jet_cli_perf_clone_flags(value)
        "cloneargs" -> jet_cli_perf_clone_args(view, value)
        "stat" -> jet_cli_perf_call_stat(view, value)
        "statx" -> jet_cli_perf_call_statx(view, value)
        "domain" -> jet_cli_perf_socket_domain(value)
        "socktype" -> jet_cli_perf_socket_type(value)
        "pair" -> jet_cli_perf_call_pair(view, value)
        "prot" -> jet_cli_perf_flags(value, [Int]{1, 2, 4, 8, 0x1000000, 0x2000000}, [String]{"PROT_READ", "PROT_WRITE", "PROT_EXEC", "PROT_SEM", "PROT_GROWSDOWN", "PROT_GROWSUP"}, "PROT_NONE")
        "mapflags" -> jet_cli_perf_map_flags(value)
        "signal" -> jet_cli_perf_signal_name(value)
        "argv" -> jet_cli_perf_call_strings(view, value)
        else -> if value == 0 -> "NULL" else -> jet_cli_perf_call_hex(value)
    }
}

// The low 32 bits of `value`, signed: a C int argument.
jet_cli_perf_int32: fn(value: Int) -> Int Never! {
    low: value & 0xffffffff
    if low >= 0x80000000 -> low - 0x100000000 else -> low
}

// `value` in hex, its 64 bits unsigned.
jet_cli_perf_call_hex: fn(value: Int) -> String Never! {
    digits: "0123456789abcdef".bytes()
    out := [U8]{}
    loop k in 0..<16 {
        nibble: (value >> (60 - 4 * k)) & 15
        if out.len() == 0 && nibble == 0 && k < 15 -> next
        out.push(digits[nibble])
    }
    "0x{String.from_bytes(out) ?? ""}"
}

// `value` in octal.
jet_cli_perf_octal: fn(value: Int) -> String Never! {
    reversed := [U8]{}
    rest := value
    loop {
        reversed.push(U8{48 + rest % 8})
        rest /%= 8
        if rest <= 0 -> break
    }
    out := [U8]{}
    index := reversed.len() - 1
    loop index >= 0 {
        out.push(reversed[index])
        index -= 1
    }
    String.from_bytes(out) ?? ""
}

// A permission mode as strace shows one: `0700`.
jet_cli_perf_call_mode: fn(value: Int) -> String Never! {
    digits: jet_cli_perf_octal(value & 0o7777)
    padded := digits
    loop padded.len() < 3 -> padded = "0{padded}"
    "0{padded}"
}

// A file's type and mode (st_mode) as strace shows one: `S_IFDIR|0700`.
jet_cli_perf_file_mode: fn(mode: Int) -> String Never! {
    kind: if mode & 0o170000 == {
        0o140000 -> "S_IFSOCK|"
        0o120000 -> "S_IFLNK|"
        0o100000 -> "S_IFREG|"
        0o060000 -> "S_IFBLK|"
        0o040000 -> "S_IFDIR|"
        0o020000 -> "S_IFCHR|"
        0o010000 -> "S_IFIFO|"
        else -> ""
    }
    special := ""
    if mode & 0o4000 != 0 -> special = "{special}S_ISUID|"
    if mode & 0o2000 != 0 -> special = "{special}S_ISGID|"
    if mode & 0o1000 != 0 -> special = "{special}S_ISVTX|"
    "{kind}{special}{jet_cli_perf_call_mode(mode & 0o777)}"
}

// The flag names of `value`, `|`-joined: each mask in `masks` whose bits
// are all set names itself (`names`), in order, and takes its bits; bits no
// mask took follow in hex. `zero` for no bits at all.
jet_cli_perf_flags: fn(value: Int, masks: [Int], names: &&[String], zero: &&String) -> String Never! {
    rest := value & 0xffffffff
    if rest == 0 -> return zero.move()
    parts := [String]{}
    loop (index, name) in names.move() {
        mask: masks[index]
        if rest & mask == mask {
            parts.push(name)
            rest -= mask
        }
    }
    if rest != 0 -> parts.push(jet_cli_perf_call_hex(rest))
    parts.join("|")
}

// An open's flags: its access mode, then the others (O_SYNC before the
// O_DSYNC it holds, O_TMPFILE before the O_DIRECTORY it holds).
jet_cli_perf_open_flags: fn(value: Int) -> String Never! {
    access: if value & 3 == {
        0 -> "O_RDONLY"
        1 -> "O_WRONLY"
        2 -> "O_RDWR"
        else -> "O_ACCMODE"
    }
    rest: value & 0xfffffffc
    if rest == 0 -> return access
    "{access}|{jet_cli_perf_flags(rest, [Int]{0x40, 0x80, 0x100, 0x200, 0x400, 0x800, 0x101000, 0x1000, 0x2000, 0x4000, 0x8000, 0x410000, 0x10000, 0x20000, 0x40000, 0x80000, 0x200000}, [String]{"O_CREAT", "O_EXCL", "O_NOCTTY", "O_TRUNC", "O_APPEND", "O_NONBLOCK", "O_SYNC", "O_DSYNC", "O_ASYNC", "O_DIRECT", "O_LARGEFILE", "O_TMPFILE", "O_DIRECTORY", "O_NOFOLLOW", "O_NOATIME", "O_CLOEXEC", "O_PATH"}, "0")}"
}

// clone's flags, the exit signal in its low byte last.
jet_cli_perf_clone_flags: fn(value: Int) -> String Never! {
    exit_signal: value & 0xff
    flags: value & 0xffffff00
    parts := [String]{}
    if flags != 0 {
        parts.push(jet_cli_perf_flags(flags, [Int]{0x100, 0x200, 0x400, 0x800, 0x1000, 0x2000, 0x4000, 0x8000, 0x10000, 0x20000, 0x40000, 0x80000, 0x100000, 0x200000, 0x400000, 0x800000, 0x1000000, 0x2000000, 0x4000000, 0x8000000, 0x10000000, 0x20000000, 0x40000000, 0x80000000}, [String]{"CLONE_VM", "CLONE_FS", "CLONE_FILES", "CLONE_SIGHAND", "CLONE_PIDFD", "CLONE_PTRACE", "CLONE_VFORK", "CLONE_PARENT", "CLONE_THREAD", "CLONE_NEWNS", "CLONE_SYSVSEM", "CLONE_SETTLS", "CLONE_PARENT_SETTID", "CLONE_CHILD_CLEARTID", "CLONE_DETACHED", "CLONE_UNTRACED", "CLONE_CHILD_SETTID", "CLONE_NEWCGROUP", "CLONE_NEWUTS", "CLONE_NEWIPC", "CLONE_NEWUSER", "CLONE_NEWPID", "CLONE_NEWNET", "CLONE_IO"}, "0"))
    }
    if exit_signal != 0 -> parts.push(jet_cli_perf_signal_name(exit_signal))
    if parts.len() == 0 -> return "0"
    parts.join("|")
}

// clone3's argument block (struct clone_args): its flags, exit signal,
// stack and stack size.
jet_cli_perf_clone_args: fn(view: X64Trace, address: Int) -[FFI.Asm]> String Never! {
    if address == 0 -> return "NULL"
    bytes: x64_trace_read(view, address, 56) ?? return jet_cli_perf_call_hex(address)
    if bytes.len() < 56 -> return jet_cli_perf_call_hex(address)
    flags: jet_cli_perf_word(bytes, 0)
    exit_signal: jet_cli_perf_word(bytes, 32)
    stack: jet_cli_perf_word(bytes, 40)
    size: jet_cli_perf_word(bytes, 48)
    signal: if exit_signal == 0 -> "0" else -> jet_cli_perf_signal_name(exit_signal)
    "{{flags={jet_cli_perf_clone_flags(flags)}, exit_signal={signal}, stack={jet_cli_perf_call_hex(stack)}, stack_size={jet_cli_perf_call_hex(size)}}}"
}

// The little-endian word of `bytes` at `at`, its `width` bytes (8 unless
// given).
jet_cli_perf_word: fn(bytes: [U8], at: Int, width: Int{8}) -> Int Never! {
    value := 0
    loop k in 0..<width -> value = value | Int{bytes[at + k]} << (8 * k)
    value
}

// The struct stat a call filled: its mode and size.
jet_cli_perf_call_stat: fn(view: X64Trace, address: Int) -[FFI.Asm]> String Never! {
    bytes: x64_trace_read(view, address, 56) ?? return jet_cli_perf_call_hex(address)
    if bytes.len() < 56 -> return jet_cli_perf_call_hex(address)
    "{{st_mode={jet_cli_perf_file_mode(jet_cli_perf_word(bytes, 24, width: 4))}, st_size={jet_cli_perf_word(bytes, 48)}, ...}}"
}

// The struct statx a call filled: its mode and size.
jet_cli_perf_call_statx: fn(view: X64Trace, address: Int) -[FFI.Asm]> String Never! {
    bytes: x64_trace_read(view, address, 48) ?? return jet_cli_perf_call_hex(address)
    if bytes.len() < 48 -> return jet_cli_perf_call_hex(address)
    "{{stx_mode={jet_cli_perf_file_mode(jet_cli_perf_word(bytes, 28, width: 2))}, stx_size={jet_cli_perf_word(bytes, 40)}, ...}}"
}

// The two descriptors a pipe or socketpair filled: `[3, 4]`.
jet_cli_perf_call_pair: fn(view: X64Trace, address: Int) -[FFI.Asm]> String Never! {
    bytes: x64_trace_read(view, address, 8) ?? return jet_cli_perf_call_hex(address)
    if bytes.len() < 8 -> return jet_cli_perf_call_hex(address)
    "[{jet_cli_perf_int32(jet_cli_perf_word(bytes, 0, width: 4))}, {jet_cli_perf_int32(jet_cli_perf_word(bytes, 4, width: 4))}]"
}

// The NUL-ended string at `address`, quoted, up to
// JET_CLI_PERF_PATH_MAX bytes; NULL for none, its address where none of
// it can be read.
jet_cli_perf_call_string: fn(view: X64Trace, address: Int) -[FFI.Asm]> String Never! {
    if address == 0 -> return "NULL"
    held := [U8]{}
    loop held.len() < JET_CLI_PERF_PATH_MAX {
        chunk: x64_trace_read(view, address + held.len(), 256) ?? break
        loop byte in chunk {
            if byte == (U8{0}) -> return jet_cli_perf_call_quoted(held, false)
            held.push(byte)
        }
        if chunk.len() < 256 -> break
    }
    if held.len() == 0 -> return jet_cli_perf_call_hex(address)
    jet_cli_perf_call_quoted(held, true)
}

// The `length` bytes of a buffer at `address`, quoted, at most
// JET_CLI_PERF_BYTES_SHOWN of them.
jet_cli_perf_call_bytes: fn(view: X64Trace, address: Int, length: Int) -[FFI.Asm]> String Never! {
    if length <= 0 -> return "\"\""
    if address == 0 -> return "NULL"
    want: if length < JET_CLI_PERF_BYTES_SHOWN -> length else -> JET_CLI_PERF_BYTES_SHOWN
    bytes: x64_trace_read(view, address, want) ?? return jet_cli_perf_call_hex(address)
    jet_cli_perf_call_quoted(bytes, length > bytes.len())
}

// The NULL-ended list of strings at `address` (an execve's argv), at most
// 32 of them.
jet_cli_perf_call_strings: fn(view: X64Trace, address: Int) -[FFI.Asm]> String Never! {
    if address == 0 -> return "NULL"
    words: x64_trace_read(view, address, 8 * 33) ?? return jet_cli_perf_call_hex(address)
    parts := [String]{}
    more := true
    loop k in 0..<(words.len() /% 8) {
        pointer: jet_cli_perf_word(words, 8 * k)
        if pointer == 0 {
            more = false
            break
        }
        if k == 32 -> break
        parts.push(jet_cli_perf_call_string(view, pointer))
    }
    tail: if more -> ", ..." else -> ""
    "[{parts.join(", ")}{tail}]"
}

// `bytes` as a C string literal, as strace shows one: printable ASCII as
// itself, `"` and `\` escaped, the usual control escapes, and any other
// byte in octal; `more` adds `...` for bytes left out.
jet_cli_perf_call_quoted: fn(bytes: [U8], more: Bool) -> String Never! {
    out := [U8]{U8{34}}
    loop (index, byte) in bytes {
        code: Int{byte}
        escape: if code == {
            34 -> "\\\""
            92 -> "\\\\"
            9 -> "\\t"
            10 -> "\\n"
            11 -> "\\v"
            12 -> "\\f"
            13 -> "\\r"
            else -> ""
        }
        if escape != "" {
            loop piece in escape.bytes() -> out.push(piece)
            next
        }
        if code >= 32 && code < 127 {
            out.push(byte)
            next
        }
        // A digit after the escape would read as part of it: three digits.
        after: if index + 1 < bytes.len() -> Int{bytes[index + 1]} else -> 0
        digits := jet_cli_perf_octal(code)
        if after >= 48 && after <= 55 {
            loop digits.len() < 3 -> digits = "0{digits}"
        }
        out.push(U8{92})
        loop piece in digits.bytes() -> out.push(piece)
    }
    out.push(U8{34})
    text: String.from_bytes(out) ?? "\"\""
    if more -> "{text}..." else -> text
}

// A socket's address family.
jet_cli_perf_socket_domain: fn(value: Int) -> String Never! {
    if value == {
        0 -> "AF_UNSPEC"
        1 -> "AF_UNIX"
        2 -> "AF_INET"
        10 -> "AF_INET6"
        16 -> "AF_NETLINK"
        17 -> "AF_PACKET"
        38 -> "AF_ALG"
        40 -> "AF_VSOCK"
        else -> "{value}"
    }
}

// A socket's type, then its SOCK_NONBLOCK and SOCK_CLOEXEC.
jet_cli_perf_socket_type: fn(value: Int) -> String Never! {
    base: if value & 0xf == {
        1 -> "SOCK_STREAM"
        2 -> "SOCK_DGRAM"
        3 -> "SOCK_RAW"
        4 -> "SOCK_RDM"
        5 -> "SOCK_SEQPACKET"
        6 -> "SOCK_DCCP"
        10 -> "SOCK_PACKET"
        else -> "{value & 0xf}"
    }
    rest: value & 0xfffffff0
    if rest == 0 -> return base
    "{base}|{jet_cli_perf_flags(rest, [Int]{0x800, 0x80000}, [String]{"SOCK_NONBLOCK", "SOCK_CLOEXEC"}, "0")}"
}

// mmap's flags: its sharing type, then the others.
jet_cli_perf_map_flags: fn(value: Int) -> String Never! {
    base: if value & 0xf == {
        1 -> "MAP_SHARED"
        2 -> "MAP_PRIVATE"
        3 -> "MAP_SHARED_VALIDATE"
        else -> "{value & 0xf}"
    }
    rest: value & 0xfffffff0
    if rest == 0 -> return base
    "{base}|{jet_cli_perf_flags(rest, [Int]{0x10, 0x20, 0x40, 0x100, 0x800, 0x1000, 0x2000, 0x4000, 0x8000, 0x10000, 0x20000, 0x40000, 0x80000, 0x100000}, [String]{"MAP_FIXED", "MAP_ANONYMOUS", "MAP_32BIT", "MAP_GROWSDOWN", "MAP_DENYWRITE", "MAP_EXECUTABLE", "MAP_LOCKED", "MAP_NORESERVE", "MAP_POPULATE", "MAP_NONBLOCK", "MAP_STACK", "MAP_HUGETLB", "MAP_SYNC", "MAP_FIXED_NOREPLACE"}, "0")}"
}

// The x86-64 Linux name of signal `signal`.
jet_cli_perf_signal_name: fn(signal: Int) -> String Never! {
    if signal == {
        1 -> "SIGHUP"
        2 -> "SIGINT"
        3 -> "SIGQUIT"
        4 -> "SIGILL"
        5 -> "SIGTRAP"
        6 -> "SIGABRT"
        7 -> "SIGBUS"
        8 -> "SIGFPE"
        9 -> "SIGKILL"
        10 -> "SIGUSR1"
        11 -> "SIGSEGV"
        12 -> "SIGUSR2"
        13 -> "SIGPIPE"
        14 -> "SIGALRM"
        15 -> "SIGTERM"
        16 -> "SIGSTKFLT"
        17 -> "SIGCHLD"
        18 -> "SIGCONT"
        19 -> "SIGSTOP"
        20 -> "SIGTSTP"
        21 -> "SIGTTIN"
        22 -> "SIGTTOU"
        23 -> "SIGURG"
        24 -> "SIGXCPU"
        25 -> "SIGXFSZ"
        26 -> "SIGVTALRM"
        27 -> "SIGPROF"
        28 -> "SIGWINCH"
        29 -> "SIGIO"
        30 -> "SIGPWR"
        31 -> "SIGSYS"
        else -> if signal >= 34 && signal <= 64 -> "SIGRTMIN+{signal - 34}" else -> "{signal}"
    }
}

