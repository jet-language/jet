// A traced command's `syscalls` receipt section (type `JetPerfSyscalls`).
// `status` is `traced`: `calls` holds each call in the order it returned,
// each with its `pid`, `tid`, `number`, `name`, decoded `args` and `result`
// (`?` for one that never returned); `syscalls` sums them by process and
// name, each row's `count` and `errors`, the most first; `processes` counts
// the command's processes and `left` those still running when it ended,
// which were let go untraced. Or it is `unavailable`: the kernel refused
// the trace with `errno` under Yama's `ptrace_scope` (null without Yama),
// `reason` says why, and the command ran untraced.
jet_cli_perf_traced_section: fn(calls: &&[JetCLIPerfTracedCall], processes: Int, left: Int, refused: Int, scope: Int?) -> TraceReceiptSection Never! {
    sums := [JetCLIPerfTracedSum]{}
    places := [String:Int]{}
    rows := [CanonicalJSON]{}
    loop call in calls.move() {
        key: "{call.pid} {call.number}"
        at := places.get(key) ?? -1
        if at < 0 {
            at = sums.len()
            places[key] = at
            sums.push(JetCLIPerfTracedSum{pid: call.pid, number: call.number, name: jet_cli_perf_syscall_shape(call.number).name, count: 0, errors: 0})
        }
        sums[at].count += 1
        if call.failed -> sums[at].errors += 1
        rows.push(
            CanonicalJSON.Object(
                [CanonicalJSONField]{
                    {key: "args", value: CanonicalJSON.String(call.args.move())},
                    {key: "name", value: CanonicalJSON.String(call.name.move())},
                    {key: "number", value: CanonicalJSON.Integer("{call.number}")},
                    {key: "pid", value: CanonicalJSON.Integer("{call.pid}")},
                    {key: "result", value: CanonicalJSON.String(call.result.move())},
                    {key: "tid", value: CanonicalJSON.Integer("{call.tid}")},
                },
            ),
        )
    }
    sums.sort_by(fn(one: JetCLIPerfTracedSum, other: JetCLIPerfTracedSum) { (one.pid <=> other.pid).then(other.count <=> one.count).then(one.name <=> other.name) })
    totals := [CanonicalJSON]{}
    loop sum in sums.move() {
        totals.push(
            CanonicalJSON.Object(
                [CanonicalJSONField]{
                    {key: "count", value: CanonicalJSON.Integer("{sum.count}")},
                    {key: "errors", value: CanonicalJSON.Integer("{sum.errors}")},
                    {key: "name", value: CanonicalJSON.String(sum.name.move())},
                    {key: "number", value: CanonicalJSON.Integer("{sum.number}")},
                    {key: "pid", value: CanonicalJSON.Integer("{sum.pid}")},
                },
            ),
        )
    }
    traced: refused == 0
    value: CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "calls", value: CanonicalJSON.Array(rows.move())},
            {key: "errno", value: if traced -> CanonicalJSON.Null else -> CanonicalJSON.Integer("{refused}")},
            {key: "left", value: CanonicalJSON.Integer("{left}")},
            {key: "processes", value: CanonicalJSON.Integer("{processes}")},
            {key: "ptrace_scope", value: jet_cli_perf_counts_number(scope)},
            {key: "reason", value: if traced -> CanonicalJSON.Null else -> CanonicalJSON.String(jet_cli_perf_syscalls_refusal(refused, scope))},
            {key: "status", value: CanonicalJSON.String(if traced -> "traced" else -> "unavailable")},
            {key: "syscalls", value: CanonicalJSON.Array(totals.move())},
        },
    )
    TraceReceiptSection{name: "syscalls", type_name: "JetPerfSyscalls", digest: canonical_json_sha256(value), value: value}
}

// Why the kernel refused to trace a command with `errno` under Yama's
// ptrace_scope `scope`, and what to change.
jet_cli_perf_syscalls_refusal: fn(errno: Int, scope: Int?) -> String Never! {
    level: scope ?? -1
    if {
        level == 3 -> "Yama's ptrace_scope 3 lets no process trace another until the machine restarts with a lower one"
        level == 2 -> "Yama's ptrace_scope 2 lets only a process with CAP_SYS_PTRACE trace another; set the sysctl kernel.yama.ptrace_scope to 1"
        errno == 1 -> "the kernel refused to let jet trace the command, as a seccomp filter or a tracer already on jet does"
        else -> "the kernel refused to let jet trace the command"
    }
}

// The first line of a traced command's `syscalls` section `value`:
// `syscalls calls=412 processes=2`, with ` left=1` for the processes let go
// running. Untraced, it is
// `syscalls unavailable errno=1 ptrace_scope=3 · <reason>`.
jet_cli_perf_traced_header: fn(value: CanonicalJSON) -> String Never! {
    fields: jettrace_object_view(value, "receipt syscalls") ?? return "syscalls"
    if (jet_cli_perf_field_text(fields, "status") ?? "") != "traced" {
        errno: jet_cli_perf_field_integer(fields, "errno") ?? "none"
        scope: jet_cli_perf_field_integer(fields, "ptrace_scope") ?? "none"
        reason: jet_cli_perf_field_text(fields, "reason") ?? "the kernel refused the trace"
        return "syscalls unavailable errno={errno} ptrace_scope={scope} · {reason}"
    }
    at: jet_cli_perf_key(fields, "calls") ?? return "syscalls"
    calls: jettrace_array(fields[at].value, "receipt syscalls.calls") ?? return "syscalls"
    processes: jet_cli_perf_field_integer(fields, "processes") ?? "0"
    left: jet_cli_perf_field_integer(fields, "left") ?? "0"
    went: if left == "0" -> "" else -> " left={left}"
    "syscalls calls={calls.len()} processes={processes}{went}"
}

// A traced command's `syscalls` section `value` as `jet perf view` shows
// it: its first line (jet_cli_perf_traced_header), then each call in the
// order it returned, as strace shows one after its process:
// `  4251 openat(AT_FDCWD, "main.jet", O_RDONLY|O_CLOEXEC) = 3`.
jet_cli_perf_traced_lines: fn(value: CanonicalJSON) -> [String] Never! {
    lines := [String]{jet_cli_perf_traced_header(value)}
    fields: jettrace_object_view(value, "receipt syscalls") ?? return lines
    at: jet_cli_perf_key(fields, "calls") ?? return lines
    calls: jettrace_array(fields[at].value, "receipt syscalls.calls") ?? return lines
    loop call in calls {
        pid: jet_cli_perf_member_integer(call, "pid") ?? "?"
        name: jet_cli_perf_member_text(call, "name") ?? "?"
        args: jet_cli_perf_member_text(call, "args") ?? ""
        result: jet_cli_perf_member_text(call, "result") ?? "?"
        lines.push("  {pid} {name}({args}) = {result}")
    }
    lines
}
