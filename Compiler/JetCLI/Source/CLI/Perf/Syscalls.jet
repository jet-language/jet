// The x86-64 Linux name of host call `number`, as the runtime's table and a
// traced command's calls name it.
jet_cli_perf_syscall_name: fn(number: U64) -> String Never! {
    jet_cli_perf_syscall_shape(Int{number}).name
}

// A call's shape (jet_cli_perf_syscall_shape).
jet_cli_perf_shape: fn(name: String, args: String) -> JetCLIPerfSyscallShape Never! {
    JetCLIPerfSyscallShape{name: name, args: args}
}

// The name of x86-64 Linux system call `number` and the kinds of its
// arguments (jet_cli_perf_call_arg): `syscall_<number>` with six addresses
