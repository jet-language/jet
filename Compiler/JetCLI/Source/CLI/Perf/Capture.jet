// One Jet provider for perf consumers. The command layer provisions/awaits the
// producer and supplies observation ticks; no synthetic samples or durations.
use jet_foundation.[TraceSkeleton, TraceToolchain, TraceHardware, CapturePolicy, TraceSample, TraceAllocation, TraceBrowser, TraceGameFrame, TraceGameDrawEvent, TraceTask, TraceLock, TraceIO, TraceNative, TraceSpan, TraceStackFrame, TraceReceiptSection, SourceIdentity, TraceSourceMap, TraceProfile, JetSymbolRef, capture_policy_default_exclusions, trace_profile_unsupported, trace_source_map_jet_with_source, build_skeleton_bytes, verify_jettrace]

JetCLIPerfObservation: struct {
    at_ns: U64,
    live: JetCLIPerfLive,
}

// `task_ids` maps each observed task's runtime id to the id its trace row
// carries. `game_frames` and `game_draw_events` are a core.game run's
// relayed frames and callbacks (GameCapture.jet).
JetCLIPerfCapture: struct {
    samples: [TraceSample],
    profile: TraceProfile,
    allocations: [TraceAllocation],
    browser: [TraceBrowser],
    game_frames: [TraceGameFrame],
    game_draw_events: [TraceGameDrawEvent],
    tasks: [TraceTask],
    locks: [TraceLock],
    io: [TraceIO],
    native: [TraceNative],
    spans: [TraceSpan],
    source_identity: [SourceIdentity],
    source_maps: [TraceSourceMap],
    policy: CapturePolicy,
    receipts: [TraceReceiptSection],
    task_ids: [U64:U64],
}

jet_cli_perf_capture_new: fn(profile: TraceProfile, sources: [SourceIdentity]) -> JetCLIPerfCapture Never! {
    JetCLIPerfCapture{samples: [TraceSample]{}, profile: profile, allocations: [TraceAllocation]{}, browser: [TraceBrowser]{}, game_frames: [TraceGameFrame]{}, game_draw_events: [TraceGameDrawEvent]{}, tasks: [TraceTask]{}, locks: [TraceLock]{}, io: [TraceIO]{}, native: [TraceNative]{}, spans: [TraceSpan]{}, source_identity: sources, source_maps: [TraceSourceMap]{}, policy: capture_policy_default_exclusions(), receipts: [TraceReceiptSection]{}, task_ids: [U64:U64]{}}
}

// `wall_ns` is the session's wall time on the observations' clock (`jet perf
// run`: spawn to exit); None (an attach) takes the runtime's own elapsed time,
// the attached process's age. The locks and the arena's allocations are taken
// over every observation, not the last alone: by a run's exit snapshot the
// program has dropped its arenas and its waiters have gone.
jet_cli_perf_capture_observations: fn(capture: &JetCLIPerfCapture, observations: [JetCLIPerfObservation], symbol: JetSymbolRef, target: String, wall_ns: U64?) JetCLIReadError! {
    if observations.len() == 0 {
        return Err(jet_cli_read_error("perf capture requires a real runtime observation"))
    }
    if observations.len() > 4096 {
        return Err(jet_cli_read_error("perf observation collection exceeds 4096 rows"))
    }
    first: observations[0]
    latest: observations[observations.len() - 1]
    task_indexes := [U64:Int]{}
    first_seen := [U64:U64]{}
    last_seen := [U64:U64]{}
    previous := U64{0}
    lock_indexes := [U64:Int]{}
    arena_allocations := U64{0}
    arena_bytes := U64{0}
    loop observed in observations {
        live: observed.live
        if live.pid != first.live.pid || live.start_id != first.live.start_id || live.session_id != first.live.session_id || live.source_id != first.live.source_id || live.build_id != first.live.build_id || live.revision != first.live.revision || live.world_id != first.live.world_id {
            return Err(jet_cli_read_error("perf observations cross a process/session/source/build revision boundary"))
        }
        if observed.at_ns < previous {
            return Err(jet_cli_read_error("perf observation clock is not monotonic"))
        }
        previous = observed.at_ns
        // Each channel that had waiters, as last seen with them.
        loop channel in live.channels {
            if channel.send_waiters == (U64{0}) && channel.recv_waiters == (U64{0}) -> next
            lock: TraceLock{kind: "channel", id: channel.id, depth: channel.depth, capacity: channel.capacity, send_waiters: channel.send_waiters, recv_waiters: channel.recv_waiters, closed: channel.closed, symbol: symbol}
            if lock_indexes.has_key(channel.id) -> capture.locks[lock_indexes[channel.id]] = lock else {
                lock_indexes[channel.id] = capture.locks.len()
                capture.locks.push(lock)
            }
        }
        // The arena's peak.
        if live.arena_allocations > arena_allocations -> arena_allocations = live.arena_allocations
        if live.arena_bytes > arena_bytes -> arena_bytes = live.arena_bytes
        loop observed_task in live.tasks {
            if !([String]{"running", "queued", "blocked", "done"}).contains(observed_task.state) {
                next
            }
            fact: TraceTask{id: observed_task.id, parent: observed_task.parent, state: observed_task.state, wait: observed_task.wait, canceled: observed_task.canceled, symbol: symbol}
            if task_indexes.has_key(observed_task.id) {
                index: task_indexes[observed_task.id]
                if capture.tasks[index].parent != observed_task.parent {
                    return Err(jet_cli_read_error("observed task parent changed"))
                }
                capture.tasks[index] = fact
            } else {
                if capture.tasks.len() >= 4096 {
                    capture.policy.task_rows_truncated = true
                    next
                }
                task_indexes[observed_task.id] = capture.tasks.len()
                first_seen[observed_task.id] = observed.at_ns
                capture.tasks.push(fact)
            }
            last_seen[observed_task.id] = observed.at_ns
        }
    }
    loop index in 0..<capture.tasks.len() {
        // Retain only scalar identities before mutating the task owner.
        observed_id: capture.tasks[index].id
        observed_parent: capture.tasks[index].parent
        if observed_parent != (U64{0}) && !task_indexes.has_key(observed_parent) {
            return Err(jet_cli_read_error("observed task has an unobserved parent"))
        }
        stable_id: U64{index + 1}
        stable_parent: if observed_parent == (U64{0}) -> U64{0} else -> U64{task_indexes[observed_parent] + 1}
        capture.tasks[index].id = stable_id
        capture.tasks[index].parent = stable_parent
        capture.task_ids[observed_id] = stable_id
        if observations.len() > 1 {
            capture.spans.push(TraceSpan{awaited_task_id: None, channel_id: None, clock: "monotonic", start_ns: Val(first_seen[observed_id]), end_ns: Val(last_seen[observed_id]), kind: "task_observed", local_address: None, parent_task_id: if stable_parent == (U64{0}) -> None else -> Val(stable_parent), peer_address: None, reason: "", spawn_line: None, status: "captured", symbol: symbol, task_id: Val(stable_id), wait_stack: [TraceStackFrame]{}, waker: "", waker_line: None, waker_task_id: None})
        }
    }
    if capture.spans.len() == 0 {
        capture.spans.push(TraceSpan{awaited_task_id: None, channel_id: None, clock: "monotonic", start_ns: None, end_ns: None, kind: "task_observed", local_address: None, parent_task_id: None, peer_address: None, reason: "task span requires multiple live observations", spawn_line: None, status: "unavailable", symbol: symbol, task_id: None, wait_stack: [TraceStackFrame]{}, waker: "", waker_line: None, waker_task_id: None})
    }
    // A run's exit publication ends every task it observed.
    if latest.live.runtime.exit {
        loop index in 0..<capture.tasks.len() {
            capture.tasks[index].state = "done"
            capture.tasks[index].wait = ""
        }
    }
    if arena_allocations > (U64{0}) || arena_bytes > (U64{0}) {
        capture.allocations.push(TraceAllocation{count: arena_allocations, bytes: arena_bytes, symbol: symbol})
    }
    root := U64?{None}
    loop observed_task in capture.tasks {
        if observed_task.parent == (U64{0}) {
            root = Val(observed_task.id)
            break
        }
    }
    window: latest.live.runtime
    jet_cli_perf_window(capture.profile, window)
    wall: wall_ns ?? window.elapsed_ns
    // An honest wall: none when zero, never an invented minimum.
    if wall > (U64{0}) {
        capture.samples.push(TraceSample{domain: "wall", duration_ns: wall, symbol: symbol})
    }
    if window.cpu_ns == .Val(cpu) {
        capture.samples.push(TraceSample{domain: "cpu", duration_ns: cpu, symbol: symbol})
        if root != None {
            capture.native.push(TraceNative{clock: "process_cpu", duration_ns: Val(cpu), observed_at_ns: latest.at_ns, reason: "", status: "captured", symbol: symbol, target: target, task_id: root})
        } else {
            capture.native.push(TraceNative{clock: "process_cpu", duration_ns: None, observed_at_ns: latest.at_ns, reason: "root task causality was not observable", status: "unavailable", symbol: symbol, target: target, task_id: None})
        }
    } else {
        capture.native.push(TraceNative{clock: "process_cpu", duration_ns: None, observed_at_ns: latest.at_ns, reason: "the runtime did not publish process CPU timing", status: "unavailable", symbol: symbol, target: target, task_id: None})
    }
}

// A run that published no observation still records its source identity and
// map, with no samples and no run window (`capture_from_source` with no
// snapshot). `wall_ns` is jet_cli_perf_capture_observations'. The profile
// rows are the program's CPU-time `samples` (`jet perf run`) where any landed
// in the source, else the observations of its `run`. A core.game run's
// relayed frames join it (jet_cli_perf_games_capture).
jet_cli_perf_capture_source: fn(path: String, text: String, observations: [JetCLIPerfObservation], samples: JetCLIPerfSamples?, target: String, wall_ns: U64?) -> JetCLIPerfCapture JetCLIReadError! {
    if observations.len() > 4096 {
        return Err(jet_cli_read_error("source sampling exceeds its observation bound"))
    }
    source: jet_cli_perf_source(path, text)
    sampled := TraceProfile?{None}
    if samples == .Val(found) -> sampled = jet_cli_perf_samples_profile(source, found)
    cpu_samples := U64{0}
    loop observed in observations {
        if observed.live.runtime.cpu_ns != None -> cpu_samples += U64{1}
    }
    profile: sampled ?? jet_cli_perf_source_profile(source, U64{observations.len()}, cpu_samples, false)
    capture := jet_cli_perf_capture_new(profile, [SourceIdentity]{source.identity})
    // copy: the run symbol below keeps the path; the source map owns its own.
    capture.source_maps.push(trace_source_map_jet_with_source(path.copy(), text) ?? return Err(jet_cli_read_error(err.message)))
    if observations.len() == 0 -> return Ok(capture)
    jet_cli_perf_window(capture.profile, observations[observations.len() - 1].live.runtime)
    if source.run_span != None {
        jet_cli_perf_capture_observations(capture, observations, JetSymbolRef{path: path, name: "run"}, target, wall_ns)
    }
    jet_cli_perf_games_capture(capture, observations, path)
    Ok(capture)
}

jet_cli_perf_capture_browser: fn(browser: JetCLIPerfBrowser, observations: [JetCLIPerfObservation], target: String) -> JetCLIPerfCapture JetCLIReadError! {
    capture := jet_cli_perf_capture_new(trace_profile_unsupported("browser relay supplies compiler-checked symbol identities, not parser-span samples"), browser.sources)
    capture.browser = browser.rows
    capture.source_maps = browser.source_maps
    capture.policy.browser_rows_truncated = browser.truncated
    if observations.len() > 0 {
        symbol := JetSymbolRef?{None}
        loop source in capture.source_identity {
            loop named in source.symbols {
                if symbol == None || (named.name == "run" && named.kind == "fn") {
                    symbol = Val(JetSymbolRef{path: source.path, name: named.name})
                }
            }
        }
        checked: symbol ?? return Err(jet_cli_read_error("browser runtime facts require a compiler-provided symbol"))
        jet_cli_perf_capture_observations(capture, observations, checked, target, None)
    }
    Ok(capture)
}

// Only the shared JetTrace codec writes bytes, then authenticates its own wire.
jet_cli_perf_capture_bytes: fn(capture: JetCLIPerfCapture, command: String, argv: [String], toolchain: TraceToolchain, hardware: TraceHardware) -> [U8] JetCLIReadError! {
    skeleton: TraceSkeleton{command: command, argv: argv, toolchain: toolchain, hardware: hardware, capture_policy: capture.policy, samples: capture.samples, profile: capture.profile, allocations: capture.allocations, browser: capture.browser, game_frames: capture.game_frames, game_draw_events: capture.game_draw_events, tasks: capture.tasks, locks: capture.locks, io: capture.io, native: capture.native, spans: capture.spans, receipt_sections: capture.receipts, source_identity: capture.source_identity, source_maps: capture.source_maps}
    bytes: build_skeleton_bytes(skeleton) ?? return Err(jet_cli_read_error(err.message))
    _: verify_jettrace(bytes) ?? return Err(jet_cli_read_error(err.message))
    Ok(bytes)
}
