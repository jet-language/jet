// The typed cost facts of a trace's lines, which `jet perf
// view` shows beside each line's measured share. They come from
// `jet explain --cost --json`, run as a child on each source the trace names
// whose file still holds the bytes the trace recorded, so every fact
// describes the code that ran.
use {
    perf_files: core.files
    perf_json: core.encoding.json
    perf_process: core.process
    perf_sys: core.sys
    core.encoding.[Dyn, EncodingLimits]
    jet_foundation.[CanonicalJSON, foundation_json_integer, sha256_hex]
}

// One typed cost site, at `line` of `path` as the trace names the file:
// `kind` is its kind with the type a copy copies (`view materialization of
// `String``), and `detail` whether it remains and its loop depth
// (`semantic remainder (loop depth 1, repeats every loop turn)`).
JetCLIPerfLineCost: struct {
    path: String,
    line: Int,
    kind: String,
    detail: String,
}

// The cost facts of a trace's sources, and a note for each source that
// has none and why (`cost facts: none, `main.jet` changed since this
// capture`), which the text view prints before its sections.
JetCLIPerfLineCosts: struct {
    costs: [JetCLIPerfLineCost],
    notes: [String],
}

jet_cli_perf_line_costs_none: fn() -> JetCLIPerfLineCosts Never! {
    JetCLIPerfLineCosts{costs: [JetCLIPerfLineCost]{}, notes: [String]{}}
}

// The cost facts of each `.jet` source in the trace's source identity that
// is on disk with its recorded digest. The sources are one program's, the
// checked source first: one `jet explain --cost` run on it gives the sites
// of the whole program, each named by its path from the package root.
jet_cli_perf_line_costs: fn(trace: CanonicalJSON) -[FS, Env, Exec, Time]> JetCLIPerfLineCosts Never! {
    ^found: jet_cli_perf_line_costs_none()
    sources: jet_cli_perf_rows(trace, "source_identity") ?? return found
    exe: perf_sys.executable()
    if exe == "" -> return found
    // Each source on disk as the trace recorded it, by its canonical path,
    // as the trace names it.
    ^named: [String:String]{}
    loop source in sources {
        path: jet_cli_perf_member_text(source, "path") ?? next
        digest: jet_cli_perf_member_text(source, "sha256") ?? next
        if !path.ends_with(".jet") -> next
        text: perf_files.read(path) ?? {
            found.notes.push("cost facts: none, `{path}` can't be read here")
            next
        }
        if sha256_hex(text) != digest {
            found.notes.push("cost facts: none, `{path}` changed since this capture")
            next
        }
        canonical: perf_files.canonicalize(path) ?? next
        named[canonical] = path
    }
    if sources.len() == 0 -> return found
    first: jet_cli_perf_member_text(sources[0], "path") ?? return found
    entry: perf_files.canonicalize(first) ?? return found
    path: named.get(entry) ?? return found
    ran: perf_process.cmd([String]{"{exe}", "explain", "--cost", "{path}", "--json"}).stdout(.Capture).stderr(.Capture).run() ?? {
        found.notes.push("cost facts: none, `jet explain --cost {path}` didn't start: {err}")
        return found
    }
    if !ran.success {
        found.notes.push("cost facts: none, `jet explain --cost {path}` failed; run it to see why")
        return found
    }
    // A whole program's sites run past the default item bound; the report is
    // already in memory, so its own size bounds it.
    ^limits: EncodingLimits.safe()
    if ran.output.count_bytes() > limits.max_item_bytes {
        limits.max_item_bytes = ran.output.count_bytes()
    }
    report: perf_json.parse_with_limits(ran.output, limits) ?? {
        found.notes.push("cost facts: none, `jet explain --cost {path} --json` printed no JSON")
        return found
    }
    sites: jet_cli_perf_optional(report, "sites") ?? return found
    if sites == .Array(items) {
        // Each site path's source, "" for one the trace doesn't name.
        ^resolved: [String:String]{}
        loop site in items {
            place: jet_cli_perf_site_text(site, "path") ?? next
            if !resolved.has_key(place) {
                resolved[place] = jet_cli_perf_site_source(place, entry, named)
            }
            source: resolved[place]
            if source == "" -> next
            at: jet_cli_perf_optional(site, "line") ?? next
            line: foundation_json_integer(at) ?? next
            nesting: jet_cli_perf_optional(site, "loop_depth") ?? next
            depth: foundation_json_integer(nesting) ?? next
            kind: jet_cli_perf_site_text(site, "kind") ?? next
            state: jet_cli_perf_site_text(site, "state") ?? next
            view: jet_cli_perf_site_text(site, "view") ?? ""
            repeated: jet_cli_perf_optional(site, "repeats") ?? next
            ^repeats: false
            if repeated == .Bool(flag) -> repeats = flag
            copied: if view == "" -> "" else -> " of `{view}`"
            turns: if repeats -> ", repeats every loop turn" else -> ""
            found.costs.push(JetCLIPerfLineCost{path: named[source], line: line, kind: "{kind}{copied}", detail: "{state} (loop depth {depth}{turns})"})
        }
    }
    found
}

// The canonical path of the trace source (`named`) an explain site at
// `place` is in, "" for none: the entry's own sites name the path it
// resolved, the others their path from the package root, a directory that
// holds the explained `entry`, or from the working directory.
jet_cli_perf_site_source: fn(place: String, entry: String, named: [String:String]) -[FS]> String Never! {
    if place == "" -> return ""
    if !place.starts_with("/") {
        ^dir: entry
        loop {
            slash: dir.rpartition("/")
            if slash.head == "" -> break
            dir = slash.head
            if perf_files.canonicalize("{dir}/{place}") == .Ok(canonical) && named.has_key(canonical) {
                return canonical
            }
        }
    }
    if perf_files.canonicalize(place) == .Ok(canonical) && named.has_key(canonical) {
        return canonical
    }
    ""
}

// The text of member `key` of an `explain.cost` site; None when it has none.
jet_cli_perf_site_text: fn(site: Dyn, key: String) -> String? Never! {
    value: jet_cli_perf_optional(site, key) ?? return None
    if value == .Text(text) -> return Val(text)
    None
}

// Static `body_cost_fact` labels that fire on every map-mutating builtin or
// List/FixedList index regardless of whether that path actually ran. These are
// never printed on a sampled line unless measured samples show that path ran.
jet_cli_perf_cost_speculative: fn(kind: String) -> Bool Never! {
    kind == "map copy-on-write" || kind == "generic representation fallback"
}

jet_cli_perf_cost_observed: fn(kind: String, helpers: [JetCLIPerfLineHelper], path: String, line: Int, function: String) -> Bool Never! {
    if !jet_cli_perf_cost_speculative(kind) -> return true
    loop held in helpers {
        if held.samples <= 0 || held.line != line || held.path != path || held.function != function -> next
        name: held.helper.to_lower()
        if kind == "map copy-on-write" && (name.contains("copy") || name.contains("cow") || name.contains("detach") || name.contains("clone")) {
            return true
        }
        if kind == "generic representation fallback" && (name.contains("generic") || name.contains("fallback")) {
            return true
        }
    }
    false
}

// The cost facts at `line` of `path`, each distinct one once with how many
// sites share it (` · cost: exact Int spill ×2 — semantic remainder (loop
// depth 1, repeats every loop turn)`); empty when the line has none. Static
// speculative `body_cost_fact` labels are omitted unless `helpers` shows that
// path ran on the sampled line.
jet_cli_perf_line_cost_text: fn(costs: JetCLIPerfLineCosts, path: String, line: Int, helpers: [JetCLIPerfLineHelper]{[JetCLIPerfLineHelper]{}}, function: String{""}) -> String Never! {
    // Each distinct fact's first cost, and how many costs it stands for.
    ^firsts: [Int]{}
    ^counts: [Int]{}
    loop (index, cost) in costs.costs {
        if cost.line != line || cost.path != path -> next
        if !jet_cli_perf_cost_observed(cost.kind, helpers, path, line, function) -> next
        ^found: -1
        loop (place, first) in firsts {
            known: costs.costs[first]
            if known.kind == cost.kind && known.detail == cost.detail {
                found = place
                break
            }
        }
        if found >= 0 {
            counts[found] = counts[found] + 1
            next
        }
        firsts.push(index)
        counts.push(1)
    }
    ^text: ""
    loop (place, first) in firsts {
        cost: costs.costs[first]
        times: if counts[place] > 1 -> " ×{counts[place]}" else -> ""
        text = "{text} · cost: {cost.kind}{times} — {cost.detail}"
    }
    text
}
