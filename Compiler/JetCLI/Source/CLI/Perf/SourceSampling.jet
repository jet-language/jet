// The canonical parser supplies byte spans. Observation counts are not function
// invocation counts. A `jet perf run` program's CPU-time samples (the
// runtime's PerfSamples.jet) are program counters, which its image's location
// table names by function and source line, and its allocations' records the
// call sites of their stacks. Beside them the program keeps a row for each
// core.log span it closes.
use {
    perf_files: core.files
    jet_backend.[X64ImageFunction, X64Jetline, link_debug_addr, x64_image_function_find, x64_image_functions, x64_jetline_find, x64_jetline_line, x64_jetline_read]
    jet_driver.[jet_driver_inline_package, jet_driver_mask_inline_package]
    jet_foundation.[
        Span,
        TraceProfile,
        TraceProfileRow,
        TraceProfileSource,
        TraceSpan,
        TRACE_SPAN_ROW_LIMIT,
        trace_profile_unsupported,
        SourceIdentity,
        sha256_hex,
        JetSymbolRef,
    ]
}

// The runtime's sampling interval (PerfSamples.jet PERF_SAMPLES_INTERVAL_US).
JET_CLI_PERF_SAMPLE_US: 1000

// The samples of one function and source line: `function` indexes the
// table's functions, and `own` says whether its file is the checked source.
// `count` is its exclusive time, the samples whose program counter is on
// it; `inclusive` its inclusive time, the samples that hold it anywhere on
// the stack, once each however often; `allocations` the allocations whose
// stack holds it innermost of the checked source's lines.
JetCLIPerfSampledLine: struct {
    function: Int,
    line: Int,
    count: U64,
    inclusive: U64,
    allocations: U64,
    own: Bool,
}

// A program's samples by function and line, hottest first; `outside` counts
// the ones at addresses the table names no Jet function for, such as the
// runtime's own code. Of those, `natives` names the ones in a function of
// the image's symbol table (`functions`), hottest first, as `perf report`
// names them. `sited` says whether the samples held an allocations' record:
// a runtime that records no allocation sites counts no line's allocations.
JetCLIPerfSamples: struct {
    table: X64Jetline,
    lines: [JetCLIPerfSampledLine],
    total: U64,
    outside: U64,
    functions: [X64ImageFunction],
    natives: [JetCLIPerfNative],
    sited: Bool,
}

// The samples outside Jet functions that landed in function `function` of
// the image's symbol table.
JetCLIPerfNative: struct {
    function: Int,
    count: U64,
}

// The samples file `path` (PerfSamples.jet's records) and the image `jet
// run` wrote beside it (Host.jet jet_cli_perf_samples_image), named by the
// image's location table and, outside Jet functions, its symbol table; each
// line marked `own` when its function's file is `source`. Both files are
// removed once read. None when either is missing or the image has no table.
jet_cli_perf_samples_read: fn(path: String, source: String) -[FS, Env]> JetCLIPerfSamples? Never! {
    image_path: "{path}.image"
    // A file that can't be read reads as empty: no samples, or no table.
    words: perf_files.read_bytes(path) ?? [U8]{}
    image: perf_files.read_bytes(image_path) ?? [U8]{}
    perf_files.remove(path).drop("the session reads its samples once")
    perf_files.remove(image_path).drop("the session reads its samples' image once")
    if words.len() == 0 -> return None
    // An image without a symbol table names no sample outside Jet functions.
    functions: x64_image_functions(image).functions
    table: x64_jetline_read(image) ?? return None
    owned: jet_cli_perf_samples_owned(table, source)
    Val(jet_cli_perf_samples_count(table, functions, owned, words))
}

// Whether each function of `table` is in the file `source`; none is when
// `source` does not resolve.
jet_cli_perf_samples_owned: fn(table: X64Jetline, source: String) -[FS]> [Bool] Never! {
    owned := [Bool]{}
    real: perf_files.realpath(source) ?? ""
    files := [String:Bool]{}
    loop function in table.functions {
        file: perf_files.join(function.dir, function.file)
        if !files.has_key(file) {
            matched := false
            if real != "" && perf_files.realpath(file) == .Ok(resolved) {
                matched = resolved == real
            }
            files[file] = matched
        }
        owned.push(files[file])
    }
    owned
}

// A sample record's first word holds its program counter below this bit and
// its word count from it up to bit 62; bit 63 marks an allocation's record
// (PerfSamples.jet PERF_SAMPLES_ADDRESS_BITS).
JET_CLI_PERF_ADDRESS_BITS: 48

// The samples of `words`, records of 8-byte words (PerfSamples.jet): the
// program counter, then the call site of each caller, innermost first.
// Each sample counts once at the function and line of `table` its program
// counter is on, its exclusive time, and once at each line it holds, call
// sites too, its inclusive time: a line a recursive sample holds many times
// counts once. Hottest first. A program counter outside every Jet function
// counts at the function of `functions` that holds it. An allocations'
// record (Alloc.jet alloc_sites_record), a header that counts them, then
// the call sites of the stack they share, counts them at the innermost of
// those on a line of a function `owned` marks.
jet_cli_perf_samples_count: fn(table: &&X64Jetline, functions: &&[X64ImageFunction], owned: [Bool], words: [U8]) -> JetCLIPerfSamples Never! {
    sampled := JetCLIPerfSamples{table: table, lines: [JetCLIPerfSampledLine]{}, total: U64{0}, outside: U64{0}, functions: functions, natives: [JetCLIPerfNative]{}, sited: false}
    // One key per function and line; a line number stays below 2^32.
    places := [Int:Int]{}
    // Each address's entry in `lines`, -1 outside every Jet function.
    resolved := [Int:Int]{}
    // Each program counter's entry in `natives`, -1 in no image function.
    native_at := [Int:Int]{}
    // Each image function's entry in `natives`.
    natives := [Int:Int]{}
    // The sample each line's inclusive time last counted.
    counted := [Int:Int]{}
    mask: (1 << JET_CLI_PERF_ADDRESS_BITS) - 1
    sample := 0
    at := 0
    loop at + 8 <= words.len() {
        first: link_debug_addr(words, at)
        size: (first >> JET_CLI_PERF_ADDRESS_BITS) & 32767
        record: if size < 1 -> 1 else -> size
        pc: first & mask
        if first < 0 {
            sampled.sited = true
            allocations: checked(U64{pc}) ?? U64{0}
            loop k in 1..<size + 1 {
                word: at + k * 8
                if word + 8 > words.len() -> break
                held: jet_cli_perf_samples_place(sampled, places, resolved, owned, link_debug_addr(words, word))
                if held < 0 || !sampled.lines[held].own -> next
                sampled.lines[held].allocations += allocations
                break
            }
            at += (size + 1) * 8
            next
        }
        sample += 1
        sampled.total += U64{1}
        place: jet_cli_perf_samples_place(sampled, places, resolved, owned, pc)
        if place >= 0 -> sampled.lines[place].count += U64{1}
        if place < 0 {
            sampled.outside += U64{1}
            if !native_at.has_key(pc) {
                native: x64_image_function_find(sampled.functions, pc)
                entry := -1
                if native >= 0 {
                    if !natives.has_key(native) {
                        natives[native] = sampled.natives.len()
                        sampled.natives.push(JetCLIPerfNative{function: native, count: U64{0}})
                    }
                    entry = natives[native]
                }
                native_at[pc] = entry
            }
            if native_at[pc] >= 0 -> sampled.natives[native_at[pc]].count += U64{1}
        }
        loop k in 0..<record {
            word: at + k * 8
            if word + 8 > words.len() -> break
            held: if k == 0 -> place else -> jet_cli_perf_samples_place(sampled, places, resolved, owned, link_debug_addr(words, word))
            if held < 0 -> next
            if counted.has_key(held) && counted[held] == sample -> next
            counted[held] = sample
            sampled.lines[held].inclusive += U64{1}
        }
        at += record * 8
    }
    sampled.lines.sort_by(fn(left: JetCLIPerfSampledLine, right: JetCLIPerfSampledLine) { (right.count <=> left.count).then(right.inclusive <=> left.inclusive).then(right.allocations <=> left.allocations).then(left.function <=> right.function).then(left.line <=> right.line) })
    sampled.natives.sort_by(fn(left: JetCLIPerfNative, right: JetCLIPerfNative) { (right.count <=> left.count).then(left.function <=> right.function) })
    sampled
}

// The entry in `sampled.lines` of the function and line that hold link
// address `address`, added at first sight, `own` as `owned` marks its
// function; -1 outside every Jet function.
jet_cli_perf_samples_place: fn(sampled: &JetCLIPerfSamples, places: &[Int:Int], resolved: &[Int:Int], owned: [Bool], address: Int) -> Int Never! {
    if resolved.has_key(address) -> return resolved[address]
    found: if address < 0 -> -1 else -> x64_jetline_find(sampled.table, address)
    place := -1
    if found >= 0 {
        line: x64_jetline_line(sampled.table, sampled.table.functions[found], address) ?? sampled.table.functions[found].decl
        key: found * 4294967296 + line
        if !places.has_key(key) {
            places[key] = sampled.lines.len()
            own: found < owned.len() && owned[found]
            sampled.lines.push(JetCLIPerfSampledLine{function: found, line: line, count: U64{0}, inclusive: U64{0}, allocations: U64{0}, own: own})
        }
        place = places[key]
    }
    resolved[address] = place
    place
}

// The CPU-time profile `sampled` gives the checked `source`: one row per
// function and line in it, with its exclusive and inclusive samples and its
// allocations, hottest first, and in its reason the hottest image functions
// outside Jet code, by their symbols. None when no sample landed in it.
jet_cli_perf_samples_profile: fn(source: JetCLIPerfSource, sampled: JetCLIPerfSamples) -> TraceProfile? Never! {
    rows := [TraceProfileRow]{}
    elsewhere := sampled.outside
    truncated := false
    loop place in sampled.lines {
        end: if place.own -> jet_cli_perf_line_end(source.text, place.line) else -> U64?{None}
        column: end ?? {
            elsewhere += place.count
            next
        }
        if rows.len() >= 4096 {
            truncated = true
            elsewhere += place.count
            next
        }
        location: TraceProfileSource{path: source.identity.path, sha256: source.identity.sha256, start_line: U64{place.line}, start_column: U64{1}, end_line: U64{place.line}, end_column: column}
        symbol: JetSymbolRef{path: source.identity.path, name: sampled.table.functions[place.function].name}
        allocations: if sampled.sited -> Val(place.allocations) else -> U64?{None}
        rows.push(TraceProfileRow{clock: "cpu", allocation_count: allocations, execution_count: None, inclusive_count: Val(place.inclusive), sample_count: place.count, sample_weight: place.count, source: location, symbol: symbol})
    }
    // The rows are hottest first, by their own samples and then by the ones
    // they hold: a first row with neither means every sample landed
    // elsewhere. A row may hold samples with none of its own, as a line
    // whose time goes to library code does.
    if rows.len() == 0 || (rows[0].sample_count == (U64{0}) && (rows[0].inclusive_count ?? U64{0}) == (U64{0})) {
        return None
    }
    status: if truncated -> "truncated" else -> "captured"
    coverage: if elsewhere == (U64{0}) -> "complete" else -> "partial"
    named := [String]{}
    loop native in sampled.natives {
        if named.len() >= 8 -> break
        named.push("{sampled.functions[native.function].name} {native.count}")
    }
    natives: if named.len() == 0 -> "" else -> "; outside Jet functions: {named.join(", ")}"
    sites: if sampled.sited -> "; each allocation counts at the innermost line of {source.identity.path} on its stack" else -> ""
    reason: "one CPU-time sample per {JET_CLI_PERF_SAMPLE_US} microseconds of process CPU, at the function and source line its program counter is in and, inclusive, once at each line on its stack; {elsewhere} of {sampled.total} samples are outside {source.identity.path}{natives}{sites}"
    Val(TraceProfile{method: "sampling", status: status, coverage: coverage, rows: rows, row_limit: U64{4096}, rows_truncated: truncated, overhead_ns: None, overhead_status: "not_measured", overhead_reason: "a matched unprofiled run was not captured", reason: reason, window_status: "unavailable", window_wall_ns: None, window_cpu_ns: None, window_reason: "the runtime published no run window"})
}

// The first column past the last character of line `line` of `text`
// (columns count characters from 1); None past its last line.
jet_cli_perf_line_end: fn(text: String, line: Int) -> U64? Never! {
    if line < 1 -> return None
    at := 1
    column := U64{1}
    loop byte in text.bytes() {
        if at != line {
            if byte == (U8{10}) -> at += 1
            next
        }
        if byte == (U8{10}) -> return Val(column)
        if byte < (U8{128}) || byte >= (U8{192}) -> column += U64{1}
    }
    if at == line -> Val(column) else -> None
}

JetCLIPerfSource: struct {
    identity: SourceIdentity,
    run_span: Span?,
    text: String,
}

jet_cli_perf_source: fn(path: String, text: String) -> JetCLIPerfSource Never! {
    identity := SourceIdentity{path: path, sha256: sha256_hex(text), symbols: [{name: String, kind: String}]{}}
    block: jet_driver_inline_package(text)
    if block.error != None {
        return JetCLIPerfSource{identity: identity, run_span: None, text: text}
    }
    masked: jet_driver_mask_inline_package(text, block)
    program: jet_cli_parsed_program(masked) ?? return JetCLIPerfSource{identity: identity, run_span: None, text: text}
    run_span := Span?{None}
    loop item in program.items {
        if item == .Func(function) {
            identity.symbols.push({name: function.name, kind: "fn"})
            if function.name == "run" -> run_span = Val(function.span)
        }
    }
    JetCLIPerfSource{identity: identity, run_span: run_span, text: text}
}

jet_cli_perf_source_position: fn(text: String, offset: Int) -> {line: U64, column: U64} JetCLIReadError! {
    bytes: text.bytes()
    if offset < 0 || offset > bytes.len() {
        return Err(jet_cli_read_error("parser source span lies outside its source bytes"))
    }
    if offset < bytes.len() && bytes[offset] >= (U8{128}) && bytes[offset] < (U8{192}) {
        return Err(jet_cli_read_error("parser source span splits a UTF-8 scalar"))
    }
    line := U64{1}
    column := U64{1}
    loop index in 0..<offset {
        byte: bytes[index]
        if byte == (U8{10}) {
            line += U64{1}
            column = U64{1}
        } else if byte < (U8{128}) || byte >= (U8{192}) { column += U64{1} }
    }
    Ok({column: column, line: line})
}

jet_cli_perf_source_profile: fn(source: JetCLIPerfSource, wall_samples: U64, cpu_samples: U64, truncated: Bool) -> TraceProfile JetCLIReadError! {
    span: source.run_span ?? return Ok(trace_profile_unsupported("checked source attribution requires a parseable top-level `run` function"))
    if span.end <= span.start -> return Err(jet_cli_read_error("source sampling span is empty"))
    start: jet_cli_perf_source_position(source.text, span.start)
    end: jet_cli_perf_source_position(source.text, span.end)
    location: TraceProfileSource{path: source.identity.path, sha256: source.identity.sha256, start_line: start.line, start_column: start.column, end_line: end.line, end_column: end.column}
    symbol: JetSymbolRef{path: source.identity.path, name: "run"}
    rows := [TraceProfileRow]{}
    wall_count: if wall_samples < (U64{4096}) -> wall_samples else -> U64{4096}
    cpu_count: if cpu_samples < (U64{4096}) -> cpu_samples else -> U64{4096}
    if wall_samples > (U64{0}) {
        rows.push(TraceProfileRow{clock: "wall", allocation_count: None, execution_count: None, inclusive_count: None, sample_count: wall_count, sample_weight: wall_count, source: location, symbol: symbol})
    }
    if cpu_samples > (U64{0}) {
        rows.push(TraceProfileRow{clock: "cpu", allocation_count: None, execution_count: None, inclusive_count: None, sample_count: cpu_count, sample_weight: cpu_count, source: location, symbol: symbol})
    }
    limited: truncated || wall_samples > U64{4096} || cpu_samples > U64{4096}
    status: if limited -> "truncated" else if rows.len() == 0 -> "no_samples" else -> "captured"
    coverage: if rows.len() == 0 && !limited -> "none" else -> "partial"
    reason: if rows.len() == 0 -> "no supported observations were captured" else -> "only the checked top-level entrypoint is source-attributed; invocation counts are not inferred"
    Ok(TraceProfile{method: "sampling", status: status, coverage: coverage, rows: rows, row_limit: U64{4096}, rows_truncated: limited, overhead_ns: None, overhead_status: "not_measured", overhead_reason: "a matched unprofiled run was not captured", reason: reason, window_status: "unavailable", window_wall_ns: None, window_cpu_ns: None, window_reason: "the runtime published no run window"})
}

jet_cli_perf_window: fn(profile: &TraceProfile, window: JetCLIPerfRuntimeWindow) Never! {
    profile.window_status = if window.exit -> "exit" else -> "live"
    profile.window_wall_ns = Val(window.elapsed_ns)
    profile.window_cpu_ns = window.cpu_ns
    profile.window_reason = "runtime-published monotonic run window"
}

// The log spans file `path` of a `jet perf run` program (the runtime's
// RouteALog.jet log_span_row_write): per closed span its start and end on the
// monotonic clock and its name's byte length, each a little-endian word, then
// the name. Each becomes a `log_span` row of `capture`, timed from
// `origin_ns`, the session's start on that clock, and named by the span in
// `source`, within the span row limit. The file is removed once read; a row
// cut short ends the read.
jet_cli_perf_log_spans_read: fn(capture: &JetCLIPerfCapture, path: String, source: String, origin_ns: Int) -[FS]> Never! {
    bytes: perf_files.read_bytes(path) ?? [U8]{}
    perf_files.remove(path).drop("the session reads its log spans once")
    at := 0
    loop at + 24 <= bytes.len() {
        start: link_debug_addr(bytes, at)
        end: link_debug_addr(bytes, at + 8)
        length: link_debug_addr(bytes, at + 16)
        if length < 0 || at + 24 + length > bytes.len() -> break
        name: String.from_bytes(bytes.slice(at + 24, at + 24 + length)) ?? break
        at += 24 + length
        if (U64{capture.spans.len()}) >= TRACE_SPAN_ROW_LIMIT {
            capture.policy.span_rows_truncated = true
            break
        }
        symbol: JetSymbolRef{path: source, name: name}
        capture.spans.push(TraceSpan{clock: "monotonic", start_ns: Val(jet_cli_perf_since(start, origin_ns)), end_ns: Val(jet_cli_perf_since(end, origin_ns)), kind: "log_span", parent_task_id: None, reason: "", status: "captured", symbol: symbol, task_id: None})
    }
}

// `at_ns` less `origin_ns`, both on the monotonic clock; 0 for a moment
// before the origin.
jet_cli_perf_since: fn(at_ns: Int, origin_ns: Int) -> U64 Never! {
    if at_ns <= origin_ns -> return U64{0}
    checked(U64{at_ns - origin_ns}) ?? U64{0}
}
