// The canonical parser supplies byte spans. Observation counts are not function
// invocation counts. A `jet perf run` program's CPU-time samples (the
// runtime's PerfSamples.jet) are program counters, which its image's location
// table names by function and source line, and its allocations' records the
// call sites of their stacks. Under the memory lens its counters' samples
// are records like the CPU-time ones. Beside them the program keeps a row
// for each core.log span and core.perf zone it closes, each frame mark and
// each plotted value.
use {
    perf_files: core.files
    perf_math: core.math
    perf_ip: core.net.ip
    jet_backend.[X64ImageFunction, X64Jetline, link_debug_addr, link_debug_le, x64_image_function_find, x64_image_functions, x64_jetline_entry_runs, x64_jetline_find, x64_jetline_line, x64_jetline_place]
    jet_debug.[NativeAbstract, NativeFunction, native_image_read, native_inline_chain, native_jet_spelling]
    jet_driver.[jet_driver_inline_package, jet_driver_mask_inline_package]
    jet_foundation.[
        CanonicalJSON,
        CanonicalJSONField,
        Span,
        TRACE_COUNTERS,
        TraceCounter,
        trace_counter_name,
        TraceProfile,
        TraceProfileRow,
        TraceProfileSource,
        TraceSpan,
        TraceStackFrame,
        TraceIO,
        TRACE_IO_ROW_LIMIT,
        TRACE_PROFILE_ROW_LIMIT,
        TRACE_SPAN_ROW_LIMIT,
        TRACE_TASK_ROW_LIMIT,
        TraceTask,
        trace_profile_unsupported,
        SourceIdentity,
        sha256_hex,
        JetSymbolRef,
        TraceReceiptSection,
        canonical_json_sha256,
    ]
}

// The runtime's sampling interval (PerfSamples.jet PERF_SAMPLES_INTERVAL_US),
// 8 kHz of CPU time.
JET_CLI_PERF_SAMPLE_US: 125

// The flight recorder's sampling interval (PerfSamples.jet
// PERF_FLIGHT_INTERVAL_US), 100 Hz of CPU time, which the CPU-time samples
// of a flight ring stand for.
JET_CLI_PERF_FLIGHT_SAMPLE_US: 10000

// An attach's zones window, as the program's PERF_ZONE_WINDOW row in its
// spans file says (PerfSamples.jet perf_flight_window_close): its opening
// and end on the program's clock, which its samples are stamped on; the
// CPU time each of its CPU-time samples stands for, in microseconds; the
// process's CPU time in it, the nanoseconds the sampler's handlers ran in
// it and the kernel's to deliver one signal; and the records the program
// made in it and could not write.
JetCLIPerfZonesWindow: struct {
    start_ns: Int,
    end_ns: Int,
    interval_us: Int,
    cpu_ns: U64,
    handler_ns: U64,
    delivery_ns: U64,
    lost: U64,
}

// The samples of one function and source line: `name` is the function's,
// the inlined function's for code inlined there, `own` says whether the
// line is in the checked source, and `file` is the entry of the program's
// other sources (JetCLIPerfFiles.paths) it is in, -1 in the checked source
// or outside them (jet_cli_perf_samples_files).
// `count` is its exclusive time, the samples whose program counter is on
// it; `inclusive` its inclusive time, the samples that hold it anywhere on
// the stack, once each however often; `allocations` the allocations whose
// stack holds it innermost of the checked source's lines; `events`, per
// counter, the events of that counter's samples whose stack holds it so;
// `topdown`, per topdown event (CLI/Perf/Topdown.jet), the samples of
// that event whose program counter is on it, empty while it has none;
// `helpers` the samples of its `count` that landed in a compiler-emitted
// helper it called, by helper.
JetCLIPerfSampledLine: struct {
    name: String,
    line: Int,
    count: U64,
    inclusive: U64,
    allocations: U64,
    events: [U64],
    topdown: [Int],
    own: Bool,
    file: Int,
    helpers: [JetCLIPerfHelperCount]{[JetCLIPerfHelperCount]{}},
}

// The samples of a line in one compiler-emitted helper
// (JET_CLI_PERF_HELPER_PREFIX), its image function `function`
// (JetCLIPerfSamples.functions).
JetCLIPerfHelperCount: struct {
    function: Int,
    count: U64,
}

// A function and line a code address stands for, whether the line is in
// the checked source, and the entry of the program's other sources it is
// in, -1 for none (jet_cli_perf_samples_frames); `path` is its function's
// file name as the location table gives it when the line is in that file,
// empty for an inlined function's line from another.
JetCLIPerfFrame: struct {
    name: String,
    line: Int,
    own: Bool,
    file: Int,
    path: String{""},
}

// A source of the program besides the checked one that a profile row is
// in: its identity and each line's end column, the first line's first
// (jet_cli_perf_line_ends).
JetCLIPerfProgramSource: struct {
    identity: SourceIdentity,
    ends: [U64],
}

// The program's sources besides the checked one, each path once as rows
// name it (`paths`), and each function of a line table's entry of them
// (`at`, -1 in the checked source or outside them).
JetCLIPerfFiles: struct {
    at: [Int],
    paths: [String],
}

// The inlined runs of an image's Jet functions (JetDebug NativeFacts.jet):
// each function that holds one, by its start address, and the abstract
// subprograms of the functions inlined.
JetCLIPerfInlines: struct {
    functions: [Int:NativeFunction],
    abstracts: [Int:NativeAbstract],
}

// A program's samples by function and line, hottest first, code inlined
// into a function counting at the inlined function's line and inclusive at
// each call it was inlined for (`inlines`); `outside` counts
// the ones at addresses the table names no Jet function for, such as the
// runtime's own code. Of those, `natives` names the ones in a function of
// the image's symbol table (`functions`), hottest first, as `perf report`
// names them. `helpers` counts the samples in a compiler-emitted helper
// (JET_CLI_PERF_HELPER_PREFIX), which count at the Jet line that called it
// and not outside, and `stackless` the samples in Jet code that kept their
// program counter alone. `signals` counts every sample's record, a
// counter's too, each a signal the sampler took; `cost` is what sampling
// cost, when its runtime recorded it, and `sampler` what took the
// CPU-time samples (jet_cli_perf_pc_read). `sited` says whether the
// samples held an allocations' record (PerfSamples.jet
// perf_samples_alloc_write), and `allocated` holds those allocations by
// type and line, the most bytes first:
// a runtime that records no allocation sites counts no line's allocations.
// `periods` holds each counter's sampling period, 0 for one the run did
// not capture. `spawns` holds each task's spawn, `waits` each task's wait,
// `wakes` each wake of a waiter and `transfers` each file or network
// transfer, in the order the program recorded them; `heaps` each heap
// snapshot the alloc lens took, in the order it took them; `timed` each
// CPU-time sample its time and task, in time order. `experiments`,
// `points`, `idle` and `tasks` are the causal lens's experiments, progress
// points' names, idle table (PerfSamples.jet perf_causal_idle_write: its
// words after the header, empty when no exit wrote one) and tasks' timings
// (JetCLIPerfCausalTasks). `files` holds each
// function of `table`'s entry of the program's other sources
// (JetCLIPerfFiles.at), and `sources` those that lines are in, each at its
// path's entry of `source_at` (-1 for one no line is in or that couldn't be
// read). `threads` holds the threads the runtime's table kept, in the order
// they were spawned, of the `threads_claimed` that asked for a row, and
// `syscalls` its host calls by number and calling stack, the most time
// first, besides the `syscalls_lost` that found no row
// (jet_cli_perf_system_read). `records_lost` counts the records the
// program made and could not write, as its clock record or a flight ring's
// tally says (PerfSamples.jet perf_samples_send). `pcs` holds each program
// counter a CPU-time or counter sample named, at its entry of `pc_at`, and
// `instructions` the code of the functions they are in
// (jet_cli_perf_instructions_section), None when none is in a function.
// `interval_us` is the CPU time each CPU-time sample stands for, in
// microseconds: a run's JET_CLI_PERF_SAMPLE_US, a flight ring's
// JET_CLI_PERF_FLIGHT_SAMPLE_US, an attach's zones window's its own; and
// `unwindowed` counts the CPU-time samples a zones window's file held from
// outside the window, which count nowhere; `entries` holds, per function of
// `table`, the function a generated entry stands for, -1 for every other
// (x64_jetline_entry_runs).
JetCLIPerfSamples: struct {
    table: X64Jetline,
    inlines: JetCLIPerfInlines,
    lines: [JetCLIPerfSampledLine],
    total: U64,
    outside: U64,
    helpers: U64,
    stackless: U64,
    signals: U64,
    cost: JetCLIPerfCost?,
    sampler: JetCLIPerfSampler?,
    functions: [X64ImageFunction],
    natives: [JetCLIPerfNative],
    sited: Bool,
    allocated: [JetCLIPerfAllocSite],
    periods: [U64],
    spawns: [JetCLIPerfSpawn],
    waits: [JetCLIPerfWait],
    wakes: [JetCLIPerfWake],
    transfers: [JetCLIPerfIO],
    heaps: [JetCLIPerfHeap],
    experiments: [JetCLIPerfExperiment],
    points: [Int:String],
    idle: [Int],
    timed: [JetCLIPerfTimed],
    tasks: JetCLIPerfCausalTasks{JetCLIPerfCausalTasks{seen: -1, kept_most: 0, rows: [Int]{}, bodies: [Int:Int]{}, places: [JetCLIPerfCausalPlace]{}}},
    files: [Int]{[Int]{}},
    entries: [Int]{[Int]{}},
    sources: [JetCLIPerfProgramSource]{[JetCLIPerfProgramSource]{}},
    source_at: [Int]{[Int]{}},
    threads: [JetCLIPerfThread]{[JetCLIPerfThread]{}},
    threads_claimed: U64{0},
    syscalls: [JetCLIPerfSyscall]{[JetCLIPerfSyscall]{}},
    syscalls_lost: U64{0},
    records_lost: U64{0},
    pcs: [JetCLIPerfPc]{[JetCLIPerfPc]{}},
    pc_at: [Int:Int]{[Int:Int]{}},
    instructions: TraceReceiptSection?{None},
    interval_us: Int{JET_CLI_PERF_SAMPLE_US},
    unwindowed: U64{0},
}

// A program counter the samples named: its CPU-time samples and, per
// counter of JetCLIPerfSamples.periods, the events its counter samples
// weigh.
JetCLIPerfPc: struct {
    pc: Int,
    samples: U64,
    events: [U64],
}

// A call site of a runtime table's stack (PerfSamples.jet perf_system): its
// function, its file's name (empty for an inlined function's line from
// another file), its line, and whether the line is in the checked source.
JetCLIPerfSite: struct {
    name: String,
    file: String,
    line: U64,
    own: Bool,
}

// A thread of the run (PerfSamples.jet perf_threads_spawn): its kernel id,
// the function it ran (`main` for the main thread), its stack's bytes (0
// for a main thread with no stack limit), its time alive and its CPU time,
// whether it ended before the exit, and the call sites that spawned it,
// innermost first, the spawn's own plumbing left out.
JetCLIPerfThread: struct {
    tid: U64,
    name: String,
    stack_bytes: U64,
    alive_ns: U64,
    cpu_ns: U64,
    ended: Bool,
    spawn: [JetCLIPerfSite],
}

// The host calls of one number from one calling stack (PerfSamples.jet
// perf_syscall_call): the number, how many, their time, and the calling
// sites, innermost first, the counting's own frames left out.
JetCLIPerfSyscall: struct {
    number: U64,
    count: U64,
    time_ns: U64,
    stack: [JetCLIPerfSite],
}

// A CPU-time sample on the monotonic clock zones are timed on, at `at_ns`,
// of the runtime's `task` (0 outside every task), with the innermost line
// of the checked source on its stack (0 for none): the record's last
// JET_CLI_PERF_TIMED words.
JetCLIPerfTimed: struct {
    at_ns: Int,
    task: Int,
    line: Int,
}

// The clock record (PerfSamples.jet perf_samples_exit), in nanoseconds: the
// CPU time the process used while sampled, the time the sampler's handlers
// and drains ran, and the kernel's time to deliver one signal and return
// from its handler, which the runtime timed as sampling started; then the
// allocations the alloc lens counted and the time it spent on them (0 each
// without it, or from a runtime whose record stops at the third); then the
// samples the drains took from the kernel's rings, the kernel's time to
// write them there as the runtime timed it when sampling started, and those
// whose callchain the kernel cut (0 each under the timer, or from a runtime
// whose record stops at the seventh); then `events`, the count of the event
// the perf events took their samples by, summed over every thread: the task
// clock's nanoseconds of CPU time in user mode, or a precise source's
// cycles (0 under the timer, or from a runtime whose record stops at the
// tenth).
JetCLIPerfCost: struct {
    cpu_ns: U64,
    handler_ns: U64,
    delivery_ns: U64,
    alloc_count: U64,
    alloc_ns: U64,
    ring_samples: U64,
    ring_ns: U64,
    cut: U64,
    events: U64,
}

// The allocations the alloc lens counted at one line for one type
// (PerfSamples.jet perf_samples_alloc_site), and their bytes: `name` and
// `line` the innermost line of the checked source on their allocating
// stack, empty and 0 for none; `type_name` the type of their typed
// allocating call, empty for none.
JetCLIPerfAllocSite: struct {
    name: String,
    line: U64,
    type_name: String,
    allocations: U64,
    bytes: U64,
}

// A task's spawn (PerfSamples.jet perf_samples_spawn): the task and the
// task that spawned it, each by its runtime id, and the line of the checked
// source that spawned it, the innermost on its spawning stack when that
// holds one.
JetCLIPerfSpawn: struct {
    task: U64,
    parent: U64,
    line: U64?,
}

// A task's wait (PerfSamples.jet perf_samples_wait): the waiting task by its
// runtime id, the address it parked on (`slot`), the wait's start and end
// on the monotonic clock, what it waited for (`class`, a
// JET_CLI_PERF_OBJECT_* or 0, and that object's runtime `id`), a socket's
// own address and its peer's (`local`, `peer`, jet_cli_perf_io_target;
// empty for none), the wait's name as the task's observed state shows it,
// and the frames of the checked source on its waiting stack, innermost
// first, as its trace row holds them.
JetCLIPerfWait: struct {
    task: U64,
    slot: Int,
    start_ns: Int,
    end_ns: Int,
    class: Int,
    id: U64,
    local: String,
    peer: String,
    name: String,
    frames: [TraceStackFrame],
}

// A wake of whatever parked on `slot` (PerfSamples.jet perf_samples_wake),
// at `at_ns` on the monotonic clock: by the task with runtime id `task`, 0
// for the runtime outside every task, and the innermost line of the
// checked source on its waking stack.
JetCLIPerfWake: struct {
    task: U64,
    slot: Int,
    at_ns: Int,
    line: Int?,
}

// A file or network transfer, or a socket's connect (PerfSamples.jet
// perf_samples_io): by the task with runtime id `task`, 0 outside every
// task, from `start_ns` to `end_ns` on the monotonic clock, a
// JET_CLI_PERF_IO_* `operation` on `target` (jet_cli_perf_io_target, a
// connect's the peer it connected to) whose class is a
// JET_CLI_PERF_TARGET_*, a socket's own address (`local`, empty for none
// and for a file), that moved `result` bytes or failed with errno
// -`result`, and the frames of the checked source on its stack, innermost
// first.
JetCLIPerfIO: struct {
    task: U64,
    operation: Int,
    class: Int,
    start_ns: Int,
    end_ns: Int,
    result: Int,
    target: String,
    local: String,
    frames: [TraceStackFrame],
}

// The samples outside Jet functions that landed in function `function` of
// the image's symbol table.
JetCLIPerfNative: struct {
    function: Int,
    count: U64,
}

// A heap snapshot (PerfSamples.jet perf_samples_heap): its `number` in the
// run, the `name` core.perf.heap_mark gave it (`exit` for the one taken as
// the program exits), the blocks live when it was taken that the alloc lens
// tracked and their bytes, and those blocks by the line that allocated them
// (`sites`), the most bytes first. Its retention records, until
// jet_cli_perf_heap_retain reads them into `retained`: the type DIE each of
// its site records names in their order (`groups`, -1 for none), its live
// blocks and what they refer to (`live`), the frames of the thread that
// took it (`frames`) and the roots.
JetCLIPerfHeap: struct {
    number: U64,
    name: String,
    blocks: U64,
    bytes: U64,
    sites: [JetCLIPerfHeapSite],
    groups: [Int],
    live: [JetCLIPerfHeapBlock],
    frames: [JetCLIPerfHeapFrame],
    roots: [JetCLIPerfHeapRoot],
    retained: [JetCLIPerfRetained],
}

// A live block of a heap snapshot (PerfSamples.jet perf_samples_heap_refs):
// its address, its size, the ordinal of its site record (from 1; 0 for
// none) and the words of it that point into other live blocks.
JetCLIPerfHeapBlock: struct {
    address: Int,
    size: Int,
    group: Int,
    refs: [JetCLIPerfHeapRef],
}

// A word of a live block at `offset` that points into the live block at
// `target`.
JetCLIPerfHeapRef: struct {
    offset: Int,
    target: Int,
}

// A frame of the thread that took a heap snapshot: the call site in its
// function (a link-time address), its frame pointer and its lowest address.
JetCLIPerfHeapFrame: struct {
    pc: Int,
    base: Int,
    low: Int,
}

// A word outside the heap that points into the live block at `target`: in
// one of the snapshot's frames at `address`, or in the image's writable
// data at link-time `address` (`data`).
JetCLIPerfHeapRoot: struct {
    address: Int,
    target: Int,
    data: Bool,
}

// The live blocks of a heap snapshot whose allocating stack holds `line`
// of function `name` innermost of the checked source's lines, allocated for
// the type `type_name` names, and their bytes; `line` 0, `name` empty, for
// the blocks no line of it allocated, `type_name` empty for those no typed
// allocating call allocated.
JetCLIPerfHeapSite: struct {
    name: String,
    line: U64,
    type_name: String,
    blocks: U64,
    bytes: U64,
}

// The samples file `path` (PerfSamples.jet's records) and the image `jet
// run` wrote beside it (Host.jet jet_cli_perf_samples_image), named by the
// image's location table and its DWARF's inlined runs and, outside Jet
// functions, its symbol table; each line marked `own` when it is in
// `source`, and named by the program source it is in, whose text is read
// for its rows (jet_cli_perf_samples_sources). A counter sample
// weighs its counter's period in `counters`; the CPU-time samples are
// `sampler`'s. The runtime's threads and host calls come from the files
// beside it (jet_cli_perf_system_read). Every file is removed once
// read. None when the samples or the image are missing or the image has no
// table. The records of an attach's zones `window` are its window file's,
// read as jet_cli_perf_samples_count reads them.
jet_cli_perf_samples_read: fn(path: String, source: String, counters: [TraceCounter], sampler: JetCLIPerfSampler?, window: JetCLIPerfZonesWindow?{None}) -[FS, Env]> JetCLIPerfSamples? Never! {
    image_path: "{path}.image"
    threads_path: "{path}.threads"
    calls_path: "{path}.syscalls"
    // A file that can't be read reads as empty: no samples, or no table.
    words: perf_files.read_bytes(path) ?? [U8]{}
    image: perf_files.read_bytes(image_path) ?? [U8]{}
    threads: perf_files.read_bytes(threads_path) ?? [U8]{}
    calls: perf_files.read_bytes(calls_path) ?? [U8]{}
    perf_files.remove(path).drop("the session reads its samples once")
    perf_files.remove(image_path).drop("the session reads its samples' image once")
    perf_files.remove(threads_path).drop("the session reads its threads once")
    perf_files.remove(calls_path).drop("the session reads its host calls once")
    if words.len() == 0 -> return None
    // An image without a symbol table names no sample outside Jet functions.
    functions: x64_image_functions(image).functions
    facts: native_image_read(image) ?? return None
    inlines := JetCLIPerfInlines{functions: [Int:NativeFunction]{}, abstracts: facts.abstracts}
    loop function in facts.functions {
        if function.inlined.len() > 0 -> inlines.functions[function.low] = function
    }
    owned: jet_cli_perf_samples_owned(facts.lines, source)
    files: jet_cli_perf_samples_files(facts.lines, source)
    periods := [U64]{}
    loop counter in counters -> periods.push(counter.period ?? U64{0})
    // The type DIE each typed allocating call allocates for, by its call
    // site, the byte before its return address, as a heap site record's
    // stack names it (PerfSamples.jet perf_samples_heap_key); and each such
    // type spelled as Jet writes it.
    allocs := [Int:Int]{}
    names := [Int:String]{}
    loop (pc, ty) in facts.allocs {
        if facts.types.get(ty) == .Val(named) && named.name != "" {
            allocs[pc - 1] = ty
            if names.get(ty) == None -> names[ty] = native_jet_spelling(named.name)
        }
    }
    objects: jet_cli_perf_heap_objects(image)
    sampled := jet_cli_perf_samples_count(facts.lines, functions, inlines, owned, periods, allocs, names, words, jet_cli_perf_code_low(image), files: files.at, window: window)
    sampled.sampler = sampler
    jet_cli_perf_samples_sources(sampled, files.paths)
    jet_cli_perf_system_read(sampled, owned, threads, calls)
    loop index in 0..<sampled.heaps.len() {
        jet_cli_perf_heap_retain(facts, objects, names, sampled.heaps[index])
    }
    sampled.instructions = jet_cli_perf_instructions_section(image, facts.level, sampled)
    Val(sampled)
}

// The counters the `memory` lens of `jet perf run` asked for, from the file
// the runtime keeps beside the `samples` file (PerfSamples.jet
// perf_counters_start): two words per counter of TRACE_COUNTERS, in order,
// its period or 0, then the errno the kernel refused it with or 0. A
// counter the file does not hold, as for a run that kept no samples, is
// unavailable with errno 0: the program never opened it. The file is
// removed once read.
jet_cli_perf_counters_read: fn(samples: String?) -[FS]> [TraceCounter] Never! {
    words := [U8]{}
    if samples == .Val(file) {
        path: "{file}.counters"
        words = perf_files.read_bytes(path) ?? [U8]{}
        perf_files.remove(path).drop("the session reads its counters once")
    }
    counters := [TraceCounter]{}
    loop (index, name) in TRACE_COUNTERS {
        at: index * 16
        period: if at + 16 <= words.len() -> link_debug_addr(words, at) else -> 0
        errno: if at + 16 <= words.len() -> link_debug_addr(words, at + 8) else -> 0
        captured: period > 0 && errno == 0
        counters.push(TraceCounter{name: name, period: if captured -> Val(U64{period}) else -> None, errno: if captured -> None else -> Val(checked(U64{errno}) ?? U64{0})})
    }
    counters
}

// The sampler the `cpu` lens of `jet perf run` charged its samples by
// (jet_cli_perf_pc_read): its `source` (0 the CPU-time timer, 1 IBS op
// sampling, 2 PEBS, 3 the task clock); the errno the kernel refused IBS op
// sampling, PEBS and the task clock each with, or 0 for one it never tried
// or that opened; perf_event_paranoid, None where the kernel has none; the
// source's period, in cycles for a precise source, else in nanoseconds of
// CPU time; whether the causal lens kept the timer (`kept`); and the most
// callchain entries the kernel writes of a perf event's sample (`depth`), 0
// under the timer or from a runtime whose file stops at the seventh word.
JetCLIPerfSampler: struct {
    source: Int,
    ibs: Int,
    pebs: Int,
    task: Int,
    paranoid: Int?,
    period: Int,
    kept: Bool,
    depth: Int,
}

// The sampler, from the file the runtime keeps beside the `samples` file
// (jet_cli_perf_pc_words). None when the run kept no such file. The file
// is removed once read.
jet_cli_perf_pc_read: fn(samples: String?) -[FS]> JetCLIPerfSampler? Never! {
    file: samples ?? return None
    path: "{file}.pc"
    words: perf_files.read_bytes(path) ?? return None
    perf_files.remove(path).drop("the session reads its sampler once")
    jet_cli_perf_pc_words(words)
}

// The sampler the `.pc` file's `words` hold (PerfSamples.jet
// perf_precise_choose): seven words, its source, the three errnos,
// perf_event_paranoid (1000 where the kernel has none), the period and 1
// where the causal lens kept the timer, then the callchain's depth. None
// for a shorter file.
jet_cli_perf_pc_words: fn(words: [U8]) -> JetCLIPerfSampler? Never! {
    if words.len() < 56 -> return None
    paranoid: link_debug_addr(words, 32)
    depth: if words.len() >= 64 -> link_debug_addr(words, 56) else -> 0
    Val(JetCLIPerfSampler{source: link_debug_addr(words, 0), ibs: link_debug_addr(words, 8), pebs: link_debug_addr(words, 16), task: link_debug_addr(words, 24), paranoid: if paranoid == 1000 -> None else -> Val(paranoid), period: link_debug_addr(words, 40), kept: link_debug_addr(words, 48) == 1, depth: depth})
}

// The source `source` of a sampler (JetCLIPerfSampler) by its receipt name.
jet_cli_perf_pc_name: fn(source: Int) -> String Never! {
    if {
        source == 1 -> "ibs_op"
        source == 2 -> "pebs"
        source == 3 -> "task_clock"
        else -> "timer"
    }
}

// The receipt's `pc`: the sampler's source; whether it is precise, charging
// each sample by the instruction it names, or else what charged it, its
// skid: the task clock's interrupt or the timer's signal, each at the
// program counter it interrupted; each source the kernel refused, with its
// errno; perf_event_paranoid; and the period, with its unit. Null for none.
jet_cli_perf_pc_json: fn(sampler: JetCLIPerfSampler?) -> CanonicalJSON Never! {
    used: sampler ?? return CanonicalJSON.Null
    refused := [CanonicalJSON]{}
    loop (index, errno) in ([Int]{used.ibs, used.pebs, used.task}) {
        if errno != 0 {
            refused.push(CanonicalJSON.Object([CanonicalJSONField]{{key: "errno", value: CanonicalJSON.Integer("{errno}")}, {key: "source", value: CanonicalJSON.String(jet_cli_perf_pc_name(index + 1))}}))
        }
    }
    precise: used.source == 1 || used.source == 2
    skid: if {
        precise -> CanonicalJSON.Null
        used.source == 3 -> CanonicalJSON.String("task_clock_interrupt")
        else -> CanonicalJSON.String("timer_signal")
    }
    CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "paranoid", value: if used.paranoid == .Val(level) -> CanonicalJSON.Integer("{level}") else -> CanonicalJSON.Null},
            {key: "period", value: CanonicalJSON.Integer("{used.period}")},
            {key: "period_unit", value: CanonicalJSON.String(if precise -> "cycles" else -> "ns")},
            {key: "precise", value: CanonicalJSON.Bool(precise)},
            {key: "refused", value: CanonicalJSON.Array(refused)},
            {key: "skid", value: skid},
            {key: "source", value: CanonicalJSON.String(jet_cli_perf_pc_name(used.source))},
        },
    )
}

// What the sampler `used` says of a profile's `total` samples over `cpu_ns`
// of sampled CPU time: the source that took them and, for a precise one,
// the rate it reached, which follows the clock speed; for a perf event,
// that the kernel walked each sample's stack into its thread's ring; for
// the timer, its cap of one sample a tick and why the run kept it.
jet_cli_perf_sampler_reason: fn(used: JetCLIPerfSampler, total: U64, cpu_ns: U64?) -> String Never! {
    ring: if used.depth > 0 -> ", and the kernel walked each sample's stack into its thread's ring, at most {used.depth} callchain entries" else -> ""
    if used.source == 3 {
        return "; the task clock took them, a perf event on each thread's CPU time in user mode, so time in the kernel takes none{ring}"
    }
    if used.source == 1 || used.source == 2 {
        named: if used.source == 1 -> "IBS op sampling" else -> "PEBS"
        rate: if cpu_ns == .Val(ns) && ns > (U64{0}) -> ": it reached {jet_cli_perf_per_ms(total, ns)} samples per millisecond of CPU time" else -> ""
        return "; {named} took them once per {used.period} cycles, the cycles a core ran in {JET_CLI_PERF_SAMPLE_US} microseconds as sampling started, so its rate follows the clock speed{rate}{ring}"
    }
    why: if {
        used.kept -> "the causal lens keeps it, since its experiments' periods are CPU time's"
        used.paranoid == None -> "the kernel has no perf events"
        (used.paranoid ?? 0) > 2 -> "perf_event_paranoid is {used.paranoid ?? 0}, and a thread's own perf events need it at most 2"
        used.task != 0 -> "the kernel refused the task clock with errno {used.task}"
        else -> "no perf event opened"
    }
    "; the CPU-time timer took them, which the kernel checks once a tick, so each thread takes at most one sample a tick: {why}"
}

// What the session kept of the samples the sampled CPU time gives, from the
// clock record `cost`, the sampler `sampler` and the `total` it kept. Under
// the task clock, the count of each thread's task clock (cost.events):
// the nanoseconds of CPU time it ran while sampled, over its period, the
// kernel's share of which takes no sample under exclude_kernel. Else, or
// from a runtime that kept no count, the process's CPU time over
// `per_sample` nanoseconds, the time each sample stands for.
jet_cli_perf_nominal: fn(cost: JetCLIPerfCost, sampler: JetCLIPerfSampler?, total: U64, per_sample: U64) -> String Never! {
    if sampler == .Val(used) && used.source == 3 && cost.events > (U64{0}) {
        if checked(U64{used.period}) == .Val(period) && period > (U64{0}) {
            return "; it kept {total} of the {cost.events / period} samples that {cost.events / U64{1000000}} ms of CPU time on the threads' task clocks while sampled gives, of which time in the kernel takes none"
        }
    }
    "; it kept {total} of the {cost.cpu_ns / per_sample} samples that {cost.cpu_ns / U64{1000000}} ms of CPU time under sampling gives"
}

// `count` samples over `ns` nanoseconds as samples per millisecond, to two
// decimals: "0.97".
jet_cli_perf_per_ms: fn(count: U64, ns: U64) -> String Never! {
    basis: count * U64{100000000} / ns
    cents: basis % U64{100}
    pad: if cents < (U64{10}) -> "0" else -> ""
    "{basis / U64{100}}.{pad}{cents}"
}

// Whether each function of `table` is in the file `source`; none is when
// `source` does not resolve.
jet_cli_perf_samples_owned: fn(table: X64Jetline, source: String) -[FS]> [Bool] Never! {
    owned := [Bool]{}
    real: perf_files.realpath(source) ?? ""
    files := [String:Bool]{}
    loop function in table.functions {
        file: perf_files.join(function.dir, function.file)
        if !files.has_key(file) {
            matched := false
            if real != "" && perf_files.realpath(file) == .Ok(resolved) {
                matched = resolved == real
            }
            files[file] = matched
        }
        owned.push(files[file])
    }
    owned
}

// The program's sources besides the checked one, by their paths from the
// working directory (absolute outside it), and the entry of them each
// function of `table` is in: -1 for the checked source, `source` (its
// lines are `owned`), and for a function whose file does not resolve, as
// none of the toolchain's library does.
jet_cli_perf_samples_files: fn(table: X64Jetline, source: String) -[FS]> JetCLIPerfFiles Never! {
    files := JetCLIPerfFiles{at: [Int]{}, paths: [String]{}}
    real: perf_files.realpath(source) ?? ""
    here: perf_files.realpath(".") ?? ""
    named := [String:Int]{}
    loop function in table.functions {
        file: perf_files.join(function.dir, function.file)
        if !named.has_key(file) {
            at := -1
            if function.file.ends_with(".jet") && perf_files.realpath(file) == .Ok(resolved) && resolved != real {
                at = files.paths.len()
                files.paths.push(if here != "" -> resolved.removeprefix("{here}/") else -> resolved)
            }
            named[file] = at
        }
        files.at.push(named[file])
    }
    files
}

// Reads each of the program's other sources (`paths`, JetCLIPerfFiles)
// that a line of `sampled` is in, for the rows of its lines
// (JetCLIPerfProgramSource).
jet_cli_perf_samples_sources: fn(sampled: &JetCLIPerfSamples, paths: &&[String]) -[FS]> Never! {
    wanted := (loop _ in paths -> false)
    loop line in sampled.lines {
        if line.file >= 0 -> wanted[line.file] = true
    }
    sampled.source_at = (loop _ in paths -> -1)
    loop (at, path) in paths.move() {
        if !wanted[at] -> next
        text: perf_files.read(path) ?? next
        sampled.source_at[at] = sampled.sources.len()
        sampled.sources.push(JetCLIPerfProgramSource{identity: SourceIdentity{path: path, sha256: sha256_hex(text), symbols: [{name: String, kind: String}]{}}, ends: jet_cli_perf_line_ends(text)})
    }
}

// Each line's end column of `text`, the first line's first, as
// jet_cli_perf_line_end gives them.
jet_cli_perf_line_ends: fn(text: String) -> [U64] Never! {
    ends := [U64]{}
    column := U64{1}
    loop byte in text.bytes() {
        if byte == (U8{10}) {
            ends.push(column)
            column = U64{1}
            next
        }
        if byte < (U8{128}) || byte >= (U8{192}) -> column += U64{1}
    }
    ends.push(column)
    ends
}

// A sample record's first word holds its program counter below this bit,
// its word count from it up to bit 58 and its kind from bit 59 up to bit
// 62: 0 for a CPU-time sample, a counter's index plus one for that
// counter's sample, JET_CLI_PERF_TOPDOWN_KIND for a topdown event's
// sample, whose first word holds the event's index from
// JET_CLI_PERF_TOPDOWN_EVENT_BITS above its program counter's distance past
// the image's code start plus one (jet_cli_perf_code_low),
// JET_CLI_PERF_SPAWN_KIND for a task's spawn,
// JET_CLI_PERF_WAIT_KIND for a task's wait, JET_CLI_PERF_WAKE_KIND for a
// wake and JET_CLI_PERF_IO_KIND for a transfer, whose first words hold a
// task id in place of the program counter, JET_CLI_PERF_CLOCK_KIND for
// what sampling cost, JET_CLI_PERF_CAUSAL_KIND for a causal experiment's
// record, and JET_CLI_PERF_HEAP_MARK_KIND,
// JET_CLI_PERF_HEAP_SITE_KIND, JET_CLI_PERF_HEAP_BLOCK_KIND and
// JET_CLI_PERF_HEAP_ROOT_KIND for a heap snapshot's records, whose first
// words hold its number. Bit 63 marks an allocations' record, whose first
// word holds its allocations below this bit and the words after it from it
// up to bit 62 (PerfSamples.jet perf_samples_alloc_write).
JET_CLI_PERF_ADDRESS_BITS: 48

JET_CLI_PERF_KIND_BITS: 59

// The words a CPU-time sample's record of more than its program counter
// ends with: its time and its task (PerfSamples.jet PERF_SAMPLES_TIMED).
JET_CLI_PERF_TIMED: 2

// PerfSamples.jet PERF_SAMPLES_TOPDOWN and PERF_TOPDOWN_EVENT_BITS.
JET_CLI_PERF_TOPDOWN_KIND: 7

JET_CLI_PERF_TOPDOWN_EVENT_BITS: 40

// PerfSamples.jet PERF_SAMPLES_SPAWN, PERF_SAMPLES_WAIT, PERF_SAMPLES_CLOCK,
// PERF_SAMPLES_WAKE, PERF_SAMPLES_IO, PERF_SAMPLES_HEAP_MARK,
// PERF_SAMPLES_HEAP_SITE, PERF_SAMPLES_HEAP_BLOCK and PERF_SAMPLES_HEAP_ROOT.
JET_CLI_PERF_SPAWN_KIND: 15

JET_CLI_PERF_WAIT_KIND: 14

JET_CLI_PERF_CLOCK_KIND: 13

JET_CLI_PERF_WAKE_KIND: 12

JET_CLI_PERF_IO_KIND: 11

JET_CLI_PERF_HEAP_MARK_KIND: 10

JET_CLI_PERF_HEAP_SITE_KIND: 9

JET_CLI_PERF_HEAP_BLOCK_KIND: 6

JET_CLI_PERF_HEAP_ROOT_KIND: 5

// PerfSamples.jet PERF_SAMPLES_CAUSAL: a causal experiment's end, (1 in
// its low bits) a progress point's name, (2) the idle table, (4) the tasks
// that claimed a timing, or (3) one task's timing.
JET_CLI_PERF_CAUSAL_KIND: 8

// What a heap snapshot's root record holds (PerfSamples.jet
// PERF_SAMPLES_ROOT_FRAMES, PERF_SAMPLES_ROOT_STACK and
// PERF_SAMPLES_ROOT_DATA).
JET_CLI_PERF_ROOT_FRAMES: 0

JET_CLI_PERF_ROOT_DATA: 2

// What a transfer moved bytes to or from (PerfSamples.jet
// PERF_SAMPLES_TARGET_PATH and the others): a file by its path, a
// descriptor by its number, a socket by its peer's sockaddr.
JET_CLI_PERF_TARGET_PATH: 1

JET_CLI_PERF_TARGET_FD: 2

JET_CLI_PERF_TARGET_SOCKET: 3

// What an I/O record did besides a read, 0 (PerfSamples.jet
// PERF_SAMPLES_IO_WRITE and PERF_SAMPLES_IO_CONNECT): wrote, or connected a
// socket to its peer, which moved nothing and is no I/O row: it is the act
// a listener's accept was waiting for (jet_cli_perf_socket_cause).
JET_CLI_PERF_IO_WRITE: 1

JET_CLI_PERF_IO_CONNECT: 2

// What a wait waited for (PerfSamples.jet PERF_SAMPLES_OBJECT_TASK and
// the others): a task a join awaits, a channel, a Shared value's lock, or a
// socket to be ready.
JET_CLI_PERF_OBJECT_TASK: 1

JET_CLI_PERF_OBJECT_CHANNEL: 2

JET_CLI_PERF_OBJECT_LOCK: 3

JET_CLI_PERF_OBJECT_SOCKET: 4

// The symbol prefix of the helpers the compiler emits into a program's code
// (stop polls, stack marks; JetIR X64Select.jet), which belong to no Jet
// source line of their own: a sample in one counts at the line that called
// it.
JET_CLI_PERF_HELPER_PREFIX: "jet_ir_"

// The lowest address of `image`'s executable loadable segments, where the
// runtime counts a topdown sample's program counter from (PerfSamples.jet
// perf_samples_code_edge); 0 for an image without one.
jet_cli_perf_code_low: fn(image: [U8]) -> Int {
    if image.len() < 64 -> return 0
    // e_phoff; e_phentsize is bits 48..63 of the word at 48, e_phnum bits
    // 0..15 of the word at 56.
    table: link_debug_addr(image, 32)
    entry: (link_debug_addr(image, 48) >> 48) & 65535
    count: link_debug_addr(image, 56) & 65535
    low := 0
    loop index in 0..<count {
        header: table + index * entry
        if header < 0 || header + 48 > image.len() -> break
        kind: link_debug_addr(image, header)
        if kind & 4294967295 == 1 && (kind >> 32) & 1 != 0 {
            // p_vaddr of the program header.
            start: link_debug_addr(image, header + 16)
            if low == 0 || start < low -> low = start
        }
    }
    low
}

// The samples of `words`, records of 8-byte words (PerfSamples.jet): the
// program counter, then the call site of each caller, innermost first.
// Each sample counts once at the function and line of `table` its program
// counter is on, its exclusive time, and once at each line it holds, call
// sites too, its inclusive time: a line a recursive sample holds many times
// counts once. Code inlined into a function counts at the inlined
// function's line, and inclusive at each call it was inlined for
// (`inlines`, jet_cli_perf_samples_frames). Hottest first. A program
// counter outside every Jet function
// counts at the function of `functions` that holds it, unless that is a
// compiler-emitted helper, whose sample counts at the innermost Jet line of
// its stack. An allocations' record (PerfSamples.jet
// perf_samples_alloc_write), a header that counts them, their bytes, then
// the call sites of the stack they share, counts them at the innermost of
// those on a line of a function `owned` marks, and in `allocated` at that
// line for the type DIE `allocs` gives its call sites, as a heap snapshot's
// site record's blocks. A counter's sample counts
// its counter's period of `periods` in events at the innermost such line
// of its stack, its program counter's included, and no CPU time. A spawn's
// record names its task's spawn by the innermost such line of its stack; a
// wait's record is a task's wait and a wake's a wake, each at the
// innermost such line of its stack, and a transfer's record a file or
// network transfer with the checked source's frames on its stack; none
// counts time. The clock record, the last one the runtime wrote, gives what
// sampling cost, and it and a flight ring's tally records (a clock record
// with 1 for its address) the records the program could not write. A heap
// snapshot's mark record starts its snapshot and
// each of its site records counts live blocks at the innermost such line
// of their allocating stack, for the type DIE `allocs` gives the innermost
// of its return addresses it holds (an allocating call of a typed image,
// reached through the runtime's own calls when they allocate for it), which
// `names` spells. Its block and root records are its retention records
// (JetCLIPerfHeap). `files` holds each function's entry of the program's
// other sources (JetCLIPerfFiles.at). The records of an attach's zones
// `window` (its window file's) count only the CPU-time samples stamped
// within it, each standing for its interval, and its row, not a clock
// record, gives what sampling cost and the records lost.
jet_cli_perf_samples_count: fn(table: &&X64Jetline, functions: &&[X64ImageFunction], inlines: &&JetCLIPerfInlines, owned: [Bool], periods: &&[U64], allocs: [Int:Int], names: [Int:String], words: [U8], code_low: Int, files: &&[Int]{[Int]{}}, window: JetCLIPerfZonesWindow?{None}) -> JetCLIPerfSamples Never! {
    sampled := JetCLIPerfSamples{table: table, inlines: inlines, lines: [JetCLIPerfSampledLine]{}, total: U64{0}, outside: U64{0}, helpers: U64{0}, stackless: U64{0}, signals: U64{0}, cost: None, sampler: None, functions: functions, natives: [JetCLIPerfNative]{}, sited: false, allocated: [JetCLIPerfAllocSite]{}, periods: periods, spawns: [JetCLIPerfSpawn]{}, waits: [JetCLIPerfWait]{}, wakes: [JetCLIPerfWake]{}, transfers: [JetCLIPerfIO]{}, heaps: [JetCLIPerfHeap]{}, experiments: [JetCLIPerfExperiment]{}, points: [Int:String]{}, idle: [Int]{}, timed: [JetCLIPerfTimed]{}, files: files, entries: x64_jetline_entry_runs(table.functions)}
    // One key per function, line, ownership and source.
    places := [String:Int]{}
    // Each address's entries in `lines`, innermost first, by twice the
    // address, plus one for a return address; none outside every Jet
    // function.
    resolved := [Int:[Int]]{}
    // Each program counter's function in `functions`, -1 in none.
    native_at := [Int:Int]{}
    // Each image function's entry in `natives`.
    natives := [Int:Int]{}
    // The sample each line's inclusive time last counted.
    counted := [Int:Int]{}
    // Each heap snapshot's entry in `heaps`, by its number.
    heaps := [Int:Int]{}
    mask: (1 << JET_CLI_PERF_ADDRESS_BITS) - 1
    sample := 0
    at := 0
    loop at + 8 <= words.len() {
        // An allocations' record sets bit 63, which link_debug_addr reads as
        // -1, so its first word is read from its halves.
        upper: link_debug_le(words, at + 4, 4)
        tallied: upper >= 0x80000000
        first: if tallied -> link_debug_le(words, at, 4) + (upper - 0x80000000) * 0x100000000 else -> link_debug_addr(words, at)
        size: if tallied -> (first >> JET_CLI_PERF_ADDRESS_BITS) & 32767 else -> (first >> JET_CLI_PERF_ADDRESS_BITS) & 2047
        kind: if tallied -> 0 else -> first >> JET_CLI_PERF_KIND_BITS
        record: if size < 1 -> 1 else -> size
        pc: first & mask
        if tallied {
            sampled.sited = true
            allocations: checked(U64{pc}) ?? U64{0}
            loop k in 2..<size + 1 {
                word: at + k * 8
                if word + 8 > words.len() -> break
                held: jet_cli_perf_samples_own(sampled, jet_cli_perf_samples_chain(sampled, places, resolved, owned, link_debug_addr(words, word), true))
                if held < 0 -> next
                sampled.lines[held].allocations += allocations
                break
            }
            if size >= 1 && at + (size + 1) * 8 <= words.len() {
                // The innermost frame, taken out of the stack.
                innermost: loop frame in jet_cli_perf_samples_stack_frames(sampled, owned, words, at, 2, size + 1) {
                    break frame
                } ?? TraceStackFrame{line: U64{0}, name: ""}
                line: innermost.line
                name: innermost.name.move()
                held: loop k in 2..<size + 1 {
                    if allocs.get(link_debug_addr(words, at + k * 8)) == .Val(die) {
                        break die
                    }
                } ?? -1
                type_name: names.get(held) ?? ""
                found := -1
                loop (place, site) in sampled.allocated {
                    if site.line == line && site.name == name && site.type_name == type_name {
                        found = place
                        break
                    }
                }
                if found < 0 {
                    found = sampled.allocated.len()
                    sampled.allocated.push(JetCLIPerfAllocSite{name: name, line: line, type_name: type_name, allocations: U64{0}, bytes: U64{0}})
                }
                sampled.allocated[found].allocations += allocations
                sampled.allocated[found].bytes += checked(U64{link_debug_addr(words, at + 8)}) ?? U64{0}
            }
            at += (size + 1) * 8
            next
        }
        if kind == JET_CLI_PERF_SPAWN_KIND {
            // The spawned task, then its parent and the spawning stack.
            if record >= 2 && at + 16 <= words.len() {
                line: jet_cli_perf_samples_stack_line(sampled, owned, words, at, 2, record)
                sampled.spawns.push(JetCLIPerfSpawn{task: U64{pc}, parent: U64{link_debug_addr(words, at + 8)}, line: if line == .Val(found) -> Val(U64{found}) else -> U64?{None}})
            }
            at += record * 8
            next
        }
        if kind == JET_CLI_PERF_WAIT_KIND {
            // The waiting task, then the slot, the start, the end, the
            // object, the lengths of the name, of the socket's own address
            // and of its peer's, 16 bits each, the three in turn, and the
            // stack.
            lengths: if record >= 6 && at + 48 <= words.len() -> link_debug_addr(words, at + 40) else -> -1
            length: if lengths < 0 -> -1 else -> lengths & 65535
            own: if lengths < 0 -> 0 else -> (lengths >> 16) & 65535
            peer: if lengths < 0 -> 0 else -> (lengths >> 32) & 65535
            head: if length < 0 -> 0 else -> 6 + (length + own + peer + 7) /% 8
            if length >= 0 && head <= record && at + record * 8 <= words.len() {
                name: String.from_bytes(words.slice(at + 48, at + 48 + length)) ?? "wait"
                local: if own > 0 -> jet_cli_perf_io_target(JET_CLI_PERF_TARGET_SOCKET, words.slice(at + 48 + length, at + 48 + length + own)) else -> ""
                remote: if peer > 0 -> jet_cli_perf_io_target(JET_CLI_PERF_TARGET_SOCKET, words.slice(at + 48 + length + own, at + 48 + length + own + peer)) else -> ""
                object: link_debug_addr(words, at + 32)
                sampled.waits.push(JetCLIPerfWait{task: U64{pc}, slot: link_debug_addr(words, at + 8), start_ns: link_debug_addr(words, at + 16), end_ns: link_debug_addr(words, at + 24), class: (object >> JET_CLI_PERF_ADDRESS_BITS) & 255, id: U64{object & mask}, local: local, peer: remote, name: name, frames: jet_cli_perf_samples_stack_frames(sampled, owned, words, at, head, record)})
            }
            at += record * 8
            next
        }
        if kind == JET_CLI_PERF_WAKE_KIND {
            // The waking task, then the slot, the time and the stack.
            if record >= 3 && at + record * 8 <= words.len() {
                sampled.wakes.push(JetCLIPerfWake{task: U64{pc}, slot: link_debug_addr(words, at + 8), at_ns: link_debug_addr(words, at + 16), line: jet_cli_perf_samples_stack_line(sampled, owned, words, at, 3, record)})
            }
            at += record * 8
            next
        }
        if kind == JET_CLI_PERF_IO_KIND {
            // The task, then the operation (a socket's peer's address's
            // length from bit 16) and the target's class, the start, the
            // end, the result, the target's length, the target (a socket's
            // peer's address, then its own) and the stack.
            length: if record >= 6 && at + 48 <= words.len() -> link_debug_addr(words, at + 40) else -> -1
            head: if length < 0 -> 0 else -> 6 + (length + 7) /% 8
            if length >= 0 && head <= record && at + record * 8 <= words.len() {
                shape: link_debug_addr(words, at + 8)
                class: (shape >> 8) & 255
                split: if class == JET_CLI_PERF_TARGET_SOCKET && (shape >> 16) <= length -> shape >> 16 else -> length
                target: if class == JET_CLI_PERF_TARGET_FD && length == 8 -> "fd {link_debug_addr(words, at + 48)}" else -> jet_cli_perf_io_target(class, words.slice(at + 48, at + 48 + split))
                local: if split < length -> jet_cli_perf_io_target(JET_CLI_PERF_TARGET_SOCKET, words.slice(at + 48 + split, at + 48 + length)) else -> ""
                sampled.transfers.push(JetCLIPerfIO{task: U64{pc}, operation: shape & 255, class: class, start_ns: link_debug_addr(words, at + 16), end_ns: link_debug_addr(words, at + 24), result: link_debug_addr(words, at + 32), target: target, local: local, frames: jet_cli_perf_samples_stack_frames(sampled, owned, words, at, head, record)})
            }
            at += record * 8
            next
        }
        if kind == JET_CLI_PERF_CLOCK_KIND && pc == 1 {
            // A flight ring's tally (PerfSamples.jet perf_flight_tally): the
            // records the program could not write so far, then whether the
            // run ended. Each counts every loss before it, so the most wins.
            if record >= 3 && at + record * 8 <= words.len() {
                lost: checked(U64{link_debug_addr(words, at + 8)}) ?? U64{0}
                if lost > sampled.records_lost -> sampled.records_lost = lost
            }
            at += record * 8
            next
        }
        if kind == JET_CLI_PERF_CLOCK_KIND {
            if record >= 4 && at + record * 8 <= words.len() {
                // The records the program could not write, which a runtime
                // whose record stops at the sixth word doesn't count.
                lost: if record >= 7 -> checked(U64{link_debug_addr(words, at + 48)}) ?? U64{0} else -> U64{0}
                if lost > sampled.records_lost -> sampled.records_lost = lost
                if checked(U64{link_debug_addr(words, at + 8)}) == .Val(cpu) {
                    if checked(U64{link_debug_addr(words, at + 16)}) == .Val(handler) {
                        if checked(U64{link_debug_addr(words, at + 24)}) == .Val(delivery) {
                            // The alloc lens's count, which only the first
                            // exit writes.
                            count := if record >= 6 -> checked(U64{link_debug_addr(words, at + 32)}) ?? U64{0} else -> U64{0}
                            spent := if record >= 6 -> checked(U64{link_debug_addr(words, at + 40)}) ?? U64{0} else -> U64{0}
                            if count == (U64{0}) && sampled.cost == .Val(earlier) {
                                count = earlier.alloc_count
                                spent = earlier.alloc_ns
                            }
                            // The rings' tallies, which a runtime whose
                            // record stops at the seventh word doesn't keep,
                            // and the samplers' count of their event, which
                            // one whose record stops at the tenth doesn't.
                            rings: record >= 10
                            ring_samples: if rings -> checked(U64{link_debug_addr(words, at + 56)}) ?? U64{0} else -> U64{0}
                            ring_ns: if rings -> checked(U64{link_debug_addr(words, at + 64)}) ?? U64{0} else -> U64{0}
                            cut: if rings -> checked(U64{link_debug_addr(words, at + 72)}) ?? U64{0} else -> U64{0}
                            events: if record >= 11 -> checked(U64{link_debug_addr(words, at + 80)}) ?? U64{0} else -> U64{0}
                            sampled.cost = .Val(JetCLIPerfCost{cpu_ns: cpu, handler_ns: handler, delivery_ns: delivery, alloc_count: count, alloc_ns: spent, ring_samples: ring_samples, ring_ns: ring_ns, cut: cut, events: events})
                        }
                    }
                }
            }
            at += record * 8
            next
        }
        if kind == JET_CLI_PERF_CAUSAL_KIND {
            if record >= 3 && at + record * 8 <= words.len() {
                if pc == 1 {
                    // The point's slot, the name's length and the name.
                    length: link_debug_addr(words, at + 16)
                    if length >= 0 && 3 + (length + 7) /% 8 <= record {
                        sampled.points[link_debug_addr(words, at + 8)] = String.from_bytes(words.slice(at + 24, at + 24 + length)) ?? "point"
                    }
                } else if pc == 2 {
                    // The idle table: a later exit's holds an earlier one's.
                    sampled.idle = loop index in 1..<record -> link_debug_addr(words, at + index * 8)
                } else if pc == 4 {
                    // The tasks that claimed a timing and the most kept; the
                    // timings follow, and a later exit's hold an earlier one's.
                    sampled.tasks = JetCLIPerfCausalTasks{seen: link_debug_addr(words, at + 8), kept_most: link_debug_addr(words, at + 16), rows: [Int]{}, bodies: [Int:Int]{}, places: [JetCLIPerfCausalPlace]{}}
                } else if pc == 3 {
                    // A task's timing (PerfSamples.jet perf_causal_row), its
                    // body's address as its index among the bodies placed.
                    if record == JET_CLI_PERF_CAUSAL_ROW_WORDS {
                        body: link_debug_addr(words, at + 8)
                        index := sampled.tasks.places.len()
                        if sampled.tasks.bodies.get(body) == .Val(known) -> index = known else {
                            place: jet_cli_perf_causal_place(sampled, owned, body)
                            sampled.tasks.bodies[body] = index
                            sampled.tasks.places.push(place.move())
                        }
                        sampled.tasks.rows.push(index)
                        loop word in 2..<JET_CLI_PERF_CAUSAL_ROW_WORDS {
                            sampled.tasks.rows.push(link_debug_addr(words, at + word * 8))
                        }
                    }
                } else if record >= 9 {
                    // The line's sampled address (0 for a baseline), the
                    // speedup, the wall time, the delay inserted, the
                    // threads' run time and runqueue wait, the highest and
                    // lowest clock of their CPUs, and each point's span in
                    // the experiment.
                    experiment: jet_cli_perf_causal_record(sampled, owned, words, at, record)
                    sampled.experiments.push(experiment)
                }
            }
            at += record * 8
            next
        }
        if kind == JET_CLI_PERF_HEAP_MARK_KIND {
            // The blocks, their bytes, the name's length and the name.
            length: if record >= 4 && at + 32 <= words.len() -> link_debug_addr(words, at + 24) else -> -1
            if length >= 0 && 4 + (length + 7) /% 8 <= record && at + record * 8 <= words.len() {
                heaps[pc] = sampled.heaps.len()
                sampled.heaps.push(JetCLIPerfHeap{number: U64{pc}, name: String.from_bytes(words.slice(at + 32, at + 32 + length)) ?? "heap", blocks: checked(U64{link_debug_addr(words, at + 8)}) ?? U64{0}, bytes: checked(U64{link_debug_addr(words, at + 16)}) ?? U64{0}, sites: [JetCLIPerfHeapSite]{}, groups: [Int]{}, live: [JetCLIPerfHeapBlock]{}, frames: [JetCLIPerfHeapFrame]{}, roots: [JetCLIPerfHeapRoot]{}, retained: [JetCLIPerfRetained]{}})
            }
            at += record * 8
            next
        }
        if kind == JET_CLI_PERF_HEAP_SITE_KIND {
            // The blocks, their bytes and the call sites of their
            // allocating stack.
            if record >= 3 && at + record * 8 <= words.len() {
                if heaps.get(pc) == .Val(index) {
                    frames: jet_cli_perf_samples_stack_frames(sampled, owned, words, at, 3, record)
                    // The innermost frame, taken out of the stack.
                    innermost: loop frame in frames.move() {
                        break frame
                    } ?? TraceStackFrame{line: U64{0}, name: ""}
                    line: innermost.line
                    name: innermost.name.move()
                    held: loop k in 3..<record {
                        if allocs.get(link_debug_addr(words, at + k * 8)) == .Val(die) {
                            break die
                        }
                    } ?? -1
                    type_name: names.get(held) ?? ""
                    sampled.heaps[index].groups.push(held)
                    blocks: checked(U64{link_debug_addr(words, at + 8)}) ?? U64{0}
                    bytes: checked(U64{link_debug_addr(words, at + 16)}) ?? U64{0}
                    found := -1
                    loop (place, site) in sampled.heaps[index].sites {
                        if site.line == line && site.name == name && site.type_name == type_name {
                            found = place
                            break
                        }
                    }
                    if found < 0 {
                        found = sampled.heaps[index].sites.len()
                        sampled.heaps[index].sites.push(JetCLIPerfHeapSite{name: name, line: line, type_name: type_name, blocks: U64{0}, bytes: U64{0}})
                    }
                    sampled.heaps[index].sites[found].blocks += blocks
                    sampled.heaps[index].sites[found].bytes += bytes
                }
            }
            at += record * 8
            next
        }
        if kind == JET_CLI_PERF_HEAP_BLOCK_KIND {
            // A live block's address, size and site record's ordinal, then
            // the (offset, block) pairs of its words that point into other
            // live blocks; a block's further records go on with its pairs.
            if record >= 4 && at + record * 8 <= words.len() {
                if heaps.get(pc) == .Val(index) {
                    address: link_debug_addr(words, at + 8)
                    count: sampled.heaps[index].live.len()
                    if count == 0 || sampled.heaps[index].live[count - 1].address != address {
                        sampled.heaps[index].live.push(JetCLIPerfHeapBlock{address: address, size: link_debug_addr(words, at + 16), group: link_debug_addr(words, at + 24), refs: [JetCLIPerfHeapRef]{}})
                    }
                    last: sampled.heaps[index].live.len() - 1
                    pair := 4
                    loop pair + 1 < record {
                        sampled.heaps[index].live[last].refs.push(JetCLIPerfHeapRef{offset: link_debug_addr(words, at + pair * 8), target: link_debug_addr(words, at + pair * 8 + 8)})
                        pair += 2
                    }
                }
            }
            at += record * 8
            next
        }
        if kind == JET_CLI_PERF_HEAP_ROOT_KIND {
            // What the record holds, then the frames of the thread that
            // took the snapshot, (call site, frame pointer, lowest address)
            // each, or the (address, block) pairs of the words of those
            // frames or of the image's writable data that point into live
            // blocks.
            if record >= 2 && at + record * 8 <= words.len() {
                if heaps.get(pc) == .Val(index) {
                    holds: link_debug_addr(words, at + 8)
                    if holds == JET_CLI_PERF_ROOT_FRAMES {
                        word := 2
                        loop word + 2 < record {
                            sampled.heaps[index].frames.push(JetCLIPerfHeapFrame{pc: link_debug_addr(words, at + word * 8), base: link_debug_addr(words, at + word * 8 + 8), low: link_debug_addr(words, at + word * 8 + 16)})
                            word += 3
                        }
                    } else {
                        word := 2
                        loop word + 1 < record {
                            sampled.heaps[index].roots.push(JetCLIPerfHeapRoot{address: link_debug_addr(words, at + word * 8), target: link_debug_addr(words, at + word * 8 + 8), data: holds == JET_CLI_PERF_ROOT_DATA})
                            word += 2
                        }
                    }
                }
            }
            at += record * 8
            next
        }
        if kind == JET_CLI_PERF_TOPDOWN_KIND {
            // Its program counter alone, as its distance past `code_low`,
            // 0 outside the image's code; the
            // sample counts at the innermost line of the checked source
            // there, as a counter's does.
            sampled.signals += U64{1}
            event: pc >> JET_CLI_PERF_TOPDOWN_EVENT_BITS
            past: pc & ((1 << JET_CLI_PERF_TOPDOWN_EVENT_BITS) - 1)
            if past != 0 {
                held: jet_cli_perf_samples_own(sampled, jet_cli_perf_samples_chain(sampled, places, resolved, owned, code_low + past - 1, false))
                if held >= 0 {
                    loop sampled.lines[held].topdown.len() <= event {
                        sampled.lines[held].topdown.push(0)
                    }
                    sampled.lines[held].topdown[event] = sampled.lines[held].topdown[event] + 1
                }
            }
            at += record * 8
            next
        }
        if kind > 0 {
            sampled.signals += U64{1}
            // A counter the session did not ask for has no period to weigh.
            counter: kind - 1
            if counter < sampled.periods.len() {
                named: jet_cli_perf_pc_entry(sampled, pc)
                sampled.pcs[named].events[counter] = sampled.pcs[named].events[counter] + sampled.periods[counter]
            }
            loop k in 0..<record {
                word: at + k * 8
                if counter >= sampled.periods.len() || word + 8 > words.len() -> break
                // The first word keeps the record's length and kind above its program counter.
                address: if k == 0 -> pc else -> link_debug_addr(words, word)
                held: jet_cli_perf_samples_own(sampled, jet_cli_perf_samples_chain(sampled, places, resolved, owned, address, k > 0))
                if held < 0 -> next
                sampled.lines[held].events[counter] = sampled.lines[held].events[counter] + sampled.periods[counter]
                break
            }
            at += record * 8
            next
        }
        // A CPU-time sample's record ends in its time and task when it
        // holds more than its program counter (JET_CLI_PERF_TIMED).
        callers: if record > JET_CLI_PERF_TIMED -> record - JET_CLI_PERF_TIMED else -> record
        // A sample of a zones window's file stamped before the window
        // opened or after it closed, or unstamped, is the flight
        // recorder's, at its own interval.
        if window == .Val(open) {
            stamp: if callers < record && at + record * 8 <= words.len() -> link_debug_addr(words, at + callers * 8) else -> -1
            if stamp < open.start_ns || stamp > open.end_ns {
                sampled.unwindowed += U64{1}
                at += record * 8
                next
            }
        }
        sample += 1
        sampled.total += U64{1}
        sampled.signals += U64{1}
        sampled_at: jet_cli_perf_pc_entry(sampled, pc)
        sampled.pcs[sampled_at].samples += U64{1}
        chain := jet_cli_perf_samples_chain(sampled, places, resolved, owned, pc, false)
        if chain.len() == 0 {
            if !native_at.has_key(pc) {
                native_at[pc] = x64_image_function_find(sampled.functions, pc)
            }
            native: native_at[pc]
            if native >= 0 && sampled.functions[native].name.starts_with(JET_CLI_PERF_HELPER_PREFIX) {
                loop k in 1..<callers {
                    word: at + k * 8
                    if word + 8 > words.len() -> break
                    held: jet_cli_perf_samples_chain(sampled, places, resolved, owned, link_debug_addr(words, word), true)
                    if held.len() == 0 -> next
                    chain = held
                    sampled.helpers += U64{1}
                    jet_cli_perf_helper_count(sampled.lines, chain[0], native)
                    break
                }
            }
            if chain.len() == 0 {
                sampled.outside += U64{1}
                if native >= 0 {
                    if !natives.has_key(native) {
                        natives[native] = sampled.natives.len()
                        sampled.natives.push(JetCLIPerfNative{function: native, count: U64{0}})
                    }
                    sampled.natives[natives[native]].count += U64{1}
                }
            }
        }
        if chain.len() > 0 {
            sampled.lines[chain[0]].count += U64{1}
            if callers == 1 -> sampled.stackless += U64{1}
        }
        // The innermost line of the checked source on the sample's stack.
        own := -1
        loop k in 0..<callers {
            word: at + k * 8
            if word + 8 > words.len() -> break
            held: if k == 0 -> chain else -> jet_cli_perf_samples_chain(sampled, places, resolved, owned, link_debug_addr(words, word), true)
            if own < 0 -> own = jet_cli_perf_samples_own(sampled, held)
            loop place in held {
                if counted.has_key(place) && counted[place] == sample -> next
                counted[place] = sample
                sampled.lines[place].inclusive += U64{1}
            }
        }
        if callers < record && at + record * 8 <= words.len() {
            stamp: at + callers * 8
            sampled.timed.push(JetCLIPerfTimed{at_ns: link_debug_addr(words, stamp), task: link_debug_addr(words, stamp + 8), line: if own < 0 -> 0 else -> sampled.lines[own].line})
        }
        at += record * 8
    }
    if window == .Val(open) {
        sampled.interval_us = open.interval_us
        sampled.cost = Val(JetCLIPerfCost{cpu_ns: open.cpu_ns, handler_ns: open.handler_ns, delivery_ns: open.delivery_ns, alloc_count: U64{0}, alloc_ns: U64{0}, ring_samples: U64{0}, ring_ns: U64{0}, cut: U64{0}, events: U64{0}})
        sampled.records_lost = open.lost
    }
    sampled.timed.sort_by(fn(left: JetCLIPerfTimed, right: JetCLIPerfTimed) { (left.at_ns <=> right.at_ns).then(left.task <=> right.task).then(left.line <=> right.line) })
    sampled.lines.sort_by(fn(left: JetCLIPerfSampledLine, right: JetCLIPerfSampledLine) { (right.count <=> left.count).then(right.inclusive <=> left.inclusive).then(jet_cli_perf_line_counted(right, 1) <=> jet_cli_perf_line_counted(left, 1)).then(jet_cli_perf_line_counted(right, 0) <=> jet_cli_perf_line_counted(left, 0)).then(right.allocations <=> left.allocations).then(left.name <=> right.name).then(left.line <=> right.line) })
    sampled.natives.sort_by(fn(left: JetCLIPerfNative, right: JetCLIPerfNative) { (right.count <=> left.count).then(left.function <=> right.function) })
    sampled.allocated.sort_by(fn(left: JetCLIPerfAllocSite, right: JetCLIPerfAllocSite) { (right.bytes <=> left.bytes).then(right.allocations <=> left.allocations).then(left.name <=> right.name).then(left.line <=> right.line).then(left.type_name <=> right.type_name) })
    sampled.heaps.sort_by(fn(left: JetCLIPerfHeap, right: JetCLIPerfHeap) { left.number <=> right.number })
    loop index in 0..<sampled.heaps.len() {
        sampled.heaps[index].sites.sort_by(fn(left: JetCLIPerfHeapSite, right: JetCLIPerfHeapSite) { (right.bytes <=> left.bytes).then(right.blocks <=> left.blocks).then(left.name <=> right.name).then(left.line <=> right.line).then(left.type_name <=> right.type_name) })
    }
    sampled
}

// One more sample of `lines[place]` in the helper image function `helper`.
jet_cli_perf_helper_count: fn(lines: &[JetCLIPerfSampledLine], place: Int, helper: Int) Never! {
    loop index in 0..<lines[place].helpers.len() {
        if lines[place].helpers[index].function == helper {
            lines[place].helpers[index].count += U64{1}
            return
        }
    }
    lines[place].helpers.push(JetCLIPerfHelperCount{function: helper, count: U64{1}})
}

// The entry of `sampled.pcs` for program counter `pc`, added with no
// samples or events when it has none.
jet_cli_perf_pc_entry: fn(sampled: &JetCLIPerfSamples, pc: Int) -> Int Never! {
    if sampled.pc_at.get(pc) == .Val(found) -> return found
    events := [U64]{}
    loop _ in sampled.periods -> events.push(U64{0})
    sampled.pc_at[pc] = sampled.pcs.len()
    sampled.pcs.push(JetCLIPerfPc{pc: pc, samples: U64{0}, events: events})
    sampled.pcs.len() - 1
}

// A compiler-emitted helper's image function `name` in Jet's terms: each
// stop poll (JetIR Build.jet ir_stop_poll) is `stop poll`, another helper
// its name past JET_CLI_PERF_HELPER_PREFIX with spaces for `_`.
jet_cli_perf_helper_name: fn(name: String) -> String Never! {
    if name.starts_with("jet_ir_stop_") -> return "stop poll"
    rest: if name.starts_with(JET_CLI_PERF_HELPER_PREFIX) -> name.slice(JET_CLI_PERF_HELPER_PREFIX.len()..<name.len()) else -> name
    rest.replace("_", " ")
}

// The events line `line` counted of counter `counter` (an index of
// TRACE_COUNTERS: 1 is LLC misses, 0 L1D misses), 0 for a counter the run
// did not ask for.
jet_cli_perf_line_counted: fn(line: JetCLIPerfSampledLine, counter: Int) -> U64 Never! {
    if counter >= line.events.len() -> return U64{0}
    line.events[counter]
}

// The entries in `sampled.lines` of the places link address `address`
// stands for (jet_cli_perf_samples_frames), innermost first, each added at
// first sight; none outside every Jet function.
jet_cli_perf_samples_chain: fn(sampled: &JetCLIPerfSamples, places: &[String:Int], resolved: &[Int:[Int]], owned: [Bool], address: Int, caller: Bool) -> [Int] Never! {
    key: if caller -> address * 2 + 1 else -> address * 2
    if resolved.has_key(key) -> return resolved[key]
    chain := [Int]{}
    loop frame in jet_cli_perf_samples_frames(sampled, owned, address, caller) {
        name: "{frame.name}\n{frame.line}\n{frame.own}\n{frame.file}"
        if !places.has_key(name) {
            places[name] = sampled.lines.len()
            events := [U64]{}
            loop _ in sampled.periods -> events.push(U64{0})
            sampled.lines.push(JetCLIPerfSampledLine{name: frame.name, line: frame.line, count: U64{0}, inclusive: U64{0}, allocations: U64{0}, events: events, topdown: [Int]{}, own: frame.own, file: frame.file})
        }
        chain.push(places[name])
    }
    resolved[key] = chain
    chain
}

// The functions and lines link address `address` stands for, innermost
// first; none outside every Jet function. In code inlined into a Jet
// function, one per inlined run that holds it, named by the function
// inlined: the innermost at the line the table gives, each outer one at
// the call the run inside it stands for; then the function's own, at the
// outermost run's call. Elsewhere in Jet code, its function and line
// alone. A line is `own` when its function's file is the checked source
// (`owned`) and the line is in that same file, which an inlined function's
// line, or a call in one, need not be; its `file` is its function's entry
// of the program's other sources (`sampled.files`) when it is in that same
// file, else -1. A return address (`caller`) is looked up at the call
// before it, as the debugger's frames are (JetDebug Native.jet
// native_lookup), at the line of its call row when it has one.
jet_cli_perf_samples_frames: fn(sampled: JetCLIPerfSamples, owned: [Bool], address: Int, caller: Bool) -> [JetCLIPerfFrame] Never! {
    frames := [JetCLIPerfFrame]{}
    lookup: if caller -> address - 1 else -> address
    found: if lookup < 0 -> -1 else -> x64_jetline_find(sampled.table, lookup)
    if found < 0 -> return frames
    function: sampled.table.functions[found]
    own: found < owned.len() && owned[found]
    file: if found < sampled.files.len() -> sampled.files[found] else -> -1
    line := function.decl
    if {
        caller && x64_jetline_place(sampled.table, function, lookup) == .Val(row) -> line = row.line
        !caller && x64_jetline_line(sampled.table, function, lookup) == .Val(at) -> line = at
        else -> {}
    }
    // The file of `line` agrees with the function's: unknown outside
    // inlined code, where the table's line is the function's own.
    same := true
    if sampled.inlines.functions.get(function.low) == .Val(facts) {
        loop (index, site) in native_inline_chain(facts, lookup) {
            run: facts.inlined[site]
            if index == 0 -> same = run.file == facts.file
            name: if sampled.inlines.abstracts.get(run.origin) == .Val(origin) -> origin.name else -> function.name
            frames.push(JetCLIPerfFrame{name: name, line: line, own: own && same, file: if same -> file else -> -1, path: if same -> function.file else -> ""})
            line = run.call_line
            same = run.call_file == facts.file
        }
    }
    // A generated entry's own code is compiler-emitted, as a helper's is: no
    // line of it is the source's, so a sample in it counts outside the
    // source, and as a caller it adds no frame (x64_jetline_entry_runs). The
    // code inlined into it keeps its frames.
    if found < sampled.entries.len() && sampled.entries[found] >= 0 -> return frames
    frames.push(JetCLIPerfFrame{name: function.name, line: line, own: own && same, file: if same -> file else -> -1, path: if same -> function.file else -> ""})
    frames
}

// The first of `chain`'s entries on a line of the checked source, -1 for
// none.
jet_cli_perf_samples_own: fn(sampled: JetCLIPerfSamples, chain: [Int]) -> Int Never! {
    loop place in chain {
        if sampled.lines[place].own -> return place
    }
    -1
}

// The innermost line of the checked source link address `address`, a
// return address, stands for (jet_cli_perf_samples_frames); None when it
// stands for none.
jet_cli_perf_samples_own_line: fn(sampled: JetCLIPerfSamples, owned: [Bool], address: Int) -> Int? Never! {
    loop frame in jet_cli_perf_samples_frames(sampled, owned, address, true) {
        if frame.own -> return Val(frame.line)
    }
    None
}

// The innermost line of the checked source the call sites of the record at
// byte `at` of `words` stand for (jet_cli_perf_samples_own_line), those of
// its words `from` up to `record`; None when they stand for none.
jet_cli_perf_samples_stack_line: fn(sampled: JetCLIPerfSamples, owned: [Bool], words: [U8], at: Int, from: Int, record: Int) -> Int? Never! {
    loop k in from..<record {
        word: at + k * 8
        if word + 8 > words.len() -> break
        line: jet_cli_perf_samples_own_line(sampled, owned, link_debug_addr(words, word)) ?? next
        return Val(line)
    }
    None
}

// The frames of the checked source the call sites of the record at byte
// `at` of `words` stand for (jet_cli_perf_samples_frames), those of its
// words `from` up to `record`, innermost first, as a trace row's stack
// frames. Each call site's frames move out of its lookup.
jet_cli_perf_samples_stack_frames: fn(sampled: JetCLIPerfSamples, owned: [Bool], words: [U8], at: Int, from: Int, record: Int) -> [TraceStackFrame] Never! {
    frames := [TraceStackFrame]{}
    loop k in from..<record {
        word: at + k * 8
        if word + 8 > words.len() -> break
        site := jet_cli_perf_samples_frames(sampled, owned, link_debug_addr(words, word), true)
        site.reverse()
        loop site.len() > 0 {
            frame: site.pop() ?? break
            if frame.own {
                frames.push(TraceStackFrame{line: U64{frame.line}, name: frame.name.move()})
            }
        }
    }
    frames
}

// The runtime's tables of threads and host calls (PerfSamples.jet
// perf_system_exit), the bytes `threads` and `calls` of the samples' files
// `.threads` and `.syscalls`, into `sampled`'s `threads` and `syscalls`.
// Each word is a little-endian 64-bit value. `.threads` holds its row's
// words and how many threads claimed a row, then each row: the thread's
// kernel id (0 for a row whose thread never ran, left out), the link
// address of the function it ran (0 for the main thread), its stack's
// bytes, its start and end on the monotonic clock, its CPU time, whether
// it ended, and how many of the 32 call sites of its spawning stack follow.
// `.syscalls` holds its row's words, the rows taken and the calls no row
// was left for, then each row: the host call's number, how many, their
// nanoseconds and its calling stack's call sites, ending at a 0. A file
// shorter than its header gives none.
jet_cli_perf_system_read: fn(sampled: &JetCLIPerfSamples, owned: [Bool], threads: [U8], calls: [U8]) Never! {
    if threads.len() >= 16 {
        width: link_debug_addr(threads, 0)
        claimed: link_debug_addr(threads, 8)
        if claimed > 0 -> sampled.threads_claimed = U64{claimed}
        plumbing: [String]{"perf_samples_stack", "perf_threads_spawn", "thread_spawn", "thread_libc_spawn"}
        at := 16
        loop width >= 8 && at + width * 8 <= threads.len() {
            tid: link_debug_addr(threads, at)
            if tid > 0 {
                entry: link_debug_addr(threads, at + 8)
                name := "main"
                if entry > 0 {
                    named := jet_cli_perf_system_frames(sampled, owned, entry, false)
                    name = if named.pop() == .Val(outer) -> outer.name.move() else -> "code at {entry}"
                }
                stack_bytes: link_debug_addr(threads, at + 16)
                begun: link_debug_addr(threads, at + 24)
                ended_at: link_debug_addr(threads, at + 32)
                cpu: link_debug_addr(threads, at + 40)
                depth: link_debug_addr(threads, at + 56)
                sites: if depth > width - 8 -> width - 8 else -> depth
                sampled.threads.push(
                    JetCLIPerfThread{
                        tid: U64{tid},
                        name: name.move(),
                        stack_bytes: if stack_bytes > 0 -> U64{stack_bytes} else -> U64{0},
                        alive_ns: if ended_at > begun -> U64{ended_at - begun} else -> U64{0},
                        cpu_ns: if cpu > 0 -> U64{cpu} else -> U64{0},
                        ended: link_debug_addr(threads, at + 48) != 0,
                        spawn: jet_cli_perf_system_stack(sampled, owned, threads, at + 64, sites, plumbing),
                    },
                )
            }
            at += width * 8
        }
    }
    if calls.len() >= 24 {
        width: link_debug_addr(calls, 0)
        lost: link_debug_addr(calls, 16)
        if lost > 0 -> sampled.syscalls_lost = U64{lost}
        plumbing: [String]{"perf_syscall_key", "perf_syscall_row", "perf_syscall_call", "host_call"}
        at := 24
        loop width >= 4 && at + width * 8 <= calls.len() {
            count: link_debug_addr(calls, at + 8)
            if count > 0 {
                time: link_debug_addr(calls, at + 16)
                sampled.syscalls.push(
                    JetCLIPerfSyscall{
                        number: U64{link_debug_addr(calls, at)},
                        count: U64{count},
                        time_ns: if time > 0 -> U64{time} else -> U64{0},
                        stack: jet_cli_perf_system_stack(sampled, owned, calls, at + 24, width - 3, plumbing),
                    },
                )
            }
            at += width * 8
        }
        sampled.syscalls.sort_by(fn(left: JetCLIPerfSyscall, right: JetCLIPerfSyscall) { (right.time_ns <=> left.time_ns).then(left.number <=> right.number) })
    }
}

// The call sites the `count` return addresses at byte `at` of `words`
// stand for (jet_cli_perf_system_frames), up to the first 0, innermost
// first, less the leading ones in the functions `plumbing` names (by
// jet_cli_perf_bare_name): the runtime's own frames between the table's
// write and its caller.
jet_cli_perf_system_stack: fn(sampled: JetCLIPerfSamples, owned: [Bool], words: [U8], at: Int, count: Int, plumbing: [String]) -> [JetCLIPerfSite] Never! {
    stack := [JetCLIPerfSite]{}
    loop k in 0..<count {
        word: at + k * 8
        if word + 8 > words.len() -> break
        address: link_debug_addr(words, word)
        if address <= 0 -> break
        site := jet_cli_perf_system_frames(sampled, owned, address, true)
        site.reverse()
        loop site.len() > 0 {
            frame: site.pop() ?? break
            if stack.len() == 0 && plumbing.contains(jet_cli_perf_bare_name(frame.name)) -> next
            stack.push(JetCLIPerfSite{name: frame.name.move(), file: frame.path.move(), line: U64{frame.line}, own: frame.own})
        }
    }
    stack
}

// The frames link address `address` stands for
// (jet_cli_perf_samples_frames), else the image's `.symtab` function that
// holds it, by its symbol, at line 0 with no file: the runtime's own code,
// which the prelinked runtime image keeps symbols for but no line table.
// None outside both.
jet_cli_perf_system_frames: fn(sampled: JetCLIPerfSamples, owned: [Bool], address: Int, caller: Bool) -> [JetCLIPerfFrame] Never! {
    frames := jet_cli_perf_samples_frames(sampled, owned, address, caller)
    if frames.len() > 0 -> return frames
    symbol: x64_image_function_find(sampled.functions, if caller -> address - 1 else -> address)
    if symbol >= 0 {
        frames.push(JetCLIPerfFrame{name: "{sampled.functions[symbol].name}", line: 0, own: false, file: -1})
    }
    frames
}

// A function's name less its module path, as the runtime's sources write
// it: `spawn_pipe` for the symbol `unit.spawn_pipe`.
jet_cli_perf_bare_name: fn(name: String) -> String Never! {
    name.slice(name.rfind(".") + 1, name.len())
}

// The trace's `threads` receipt section (type `JetPerfThreads`): how many
// threads claimed a row of the runtime's table (`claimed`), and each it
// kept, in spawn order: its kernel id `tid`, `name` (the function it ran,
// `main` for the main thread), `stack_bytes` (null for a main thread with
// no stack limit), `cpu_ns`, `off_cpu_ns` (its time alive less its CPU
// time), `state` (`ended`, or `running` at the exit) and `spawned_at`, the
// call sites of its spawning stack, innermost first
// (jet_cli_perf_sites_json). None when the run kept no table.
jet_cli_perf_threads_section: fn(threads: &&[JetCLIPerfThread], claimed: U64) -> TraceReceiptSection? Never! {
    if threads.len() == 0 -> return None
    rows := [CanonicalJSON]{}
    loop thread in threads.move() {
        off: if thread.alive_ns > thread.cpu_ns -> thread.alive_ns - thread.cpu_ns else -> U64{0}
        rows.push(
            CanonicalJSON.Object(
                [CanonicalJSONField]{
                    {key: "cpu_ns", value: CanonicalJSON.Integer("{thread.cpu_ns}")},
                    {key: "name", value: CanonicalJSON.String(thread.name.move())},
                    {key: "off_cpu_ns", value: CanonicalJSON.Integer("{off}")},
                    {key: "spawned_at", value: jet_cli_perf_sites_json(thread.spawn.move())},
                    {key: "stack_bytes", value: if thread.stack_bytes == 0 -> CanonicalJSON.Null else -> CanonicalJSON.Integer("{thread.stack_bytes}")},
                    {key: "state", value: CanonicalJSON.String(if thread.ended -> "ended" else -> "running")},
                    {key: "tid", value: CanonicalJSON.Integer("{thread.tid}")},
                },
            ),
        )
    }
    value: CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "claimed", value: CanonicalJSON.Integer("{claimed}")},
            {key: "threads", value: CanonicalJSON.Array(rows.move())},
        },
    )
    Val(TraceReceiptSection{name: "threads", type_name: "JetPerfThreads", digest: canonical_json_sha256(value), value: value})
}

// The trace's `syscalls` receipt section (type `JetPerfSyscalls`): the
// host calls no row of the runtime's table was left for (`lost`), and each
// number and calling stack the table kept, the most time first: `number`,
// its `name` (jet_cli_perf_syscall_name), `count`, `time_ns` (a call that
// never returned, as a successful execve, counts with no time) and
// `stack`, the calling stack's sites, innermost first
// (jet_cli_perf_sites_json). None when the run kept no table.
jet_cli_perf_syscalls_section: fn(calls: &&[JetCLIPerfSyscall], lost: U64) -> TraceReceiptSection? Never! {
    if calls.len() == 0 -> return None
    rows := [CanonicalJSON]{}
    loop call in calls.move() {
        rows.push(
            CanonicalJSON.Object(
                [CanonicalJSONField]{
                    {key: "count", value: CanonicalJSON.Integer("{call.count}")},
                    {key: "name", value: CanonicalJSON.String(jet_cli_perf_syscall_name(call.number))},
                    {key: "number", value: CanonicalJSON.Integer("{call.number}")},
                    {key: "stack", value: jet_cli_perf_sites_json(call.stack.move())},
                    {key: "time_ns", value: CanonicalJSON.Integer("{call.time_ns}")},
                },
            ),
        )
    }
    value: CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "lost", value: CanonicalJSON.Integer("{lost}")},
            {key: "syscalls", value: CanonicalJSON.Array(rows.move())},
        },
    )
    Val(TraceReceiptSection{name: "syscalls", type_name: "JetPerfSyscalls", digest: canonical_json_sha256(value), value: value})
}

// The trace's `records` receipt section (type `JetPerfRecords`): how many
// records the program made and could not write (`lost`, its
// JetCLIPerfSamples.records_lost) and why (`reason`). None when it lost
// none.
jet_cli_perf_records_section: fn(lost: U64, reason: String) -> TraceReceiptSection? Never! {
    if lost == (U64{0}) -> return None
    value: CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "lost", value: CanonicalJSON.Integer("{lost}")},
            {key: "reason", value: CanonicalJSON.String(reason)},
        },
    )
    Val(TraceReceiptSection{name: "records", type_name: "JetPerfRecords", digest: canonical_json_sha256(value), value: value})
}

// The trace's `helpers` receipt section (type `JetPerfHelpers`): the
// samples that landed in a compiler-emitted helper, which count at the line
// that called it, split out by line and helper. Each row is a line's
// `path`, `line` and `function`, the `helper` in Jet's terms
// (jet_cli_perf_helper_name) and its `samples`, the most first. A line
// outside the checked `source` and the program's other `sources` (each at
// its `source_at` entry, JetCLIPerfSamples) has no row, as it has no
// profile row. None when no sample landed in a helper.
jet_cli_perf_helpers_section: fn(source: String, lines: [JetCLIPerfSampledLine], functions: [X64ImageFunction], sources: [JetCLIPerfProgramSource], source_at: [Int]) -> TraceReceiptSection? Never! {
    found := [JetCLIPerfLineHelper]{}
    loop place in lines {
        if place.helpers.len() == 0 -> next
        other: if place.own || place.file < 0 || place.file >= source_at.len() -> -1 else -> source_at[place.file]
        if !place.own && other < 0 -> next
        path: if place.own -> "{source}" else -> "{sources[other].identity.path}"
        loop held in place.helpers {
            helper: jet_cli_perf_helper_name(functions[held.function].name)
            at := -1
            loop index in 0..<found.len() {
                if found[index].line == place.line && found[index].helper == helper && found[index].function == place.name && found[index].path == path {
                    at = index
                    break
                }
            }
            if at < 0 {
                at = found.len()
                found.push(JetCLIPerfLineHelper{path: "{path}", line: place.line, function: "{place.name}", helper: helper, samples: 0})
            }
            found[at].samples += Int{held.count}
        }
    }
    if found.len() == 0 -> return None
    found.sort_by(fn(left: JetCLIPerfLineHelper, right: JetCLIPerfLineHelper) { (right.samples <=> left.samples).then(left.path <=> right.path).then(left.line <=> right.line).then(left.function <=> right.function).then(left.helper <=> right.helper) })
    rows := [CanonicalJSON]{}
    loop row in found.move() {
        rows.push(
            CanonicalJSON.Object(
                [CanonicalJSONField]{
                    {key: "function", value: CanonicalJSON.String(row.function.move())},
                    {key: "helper", value: CanonicalJSON.String(row.helper.move())},
                    {key: "line", value: CanonicalJSON.Integer("{row.line}")},
                    {key: "path", value: CanonicalJSON.String(row.path.move())},
                    {key: "samples", value: CanonicalJSON.Integer("{row.samples}")},
                },
            ),
        )
    }
    value: CanonicalJSON.Object([CanonicalJSONField]{{key: "helpers", value: CanonicalJSON.Array(rows.move())}})
    Val(TraceReceiptSection{name: "helpers", type_name: "JetPerfHelpers", digest: canonical_json_sha256(value), value: value})
}

// The samples of a line in a compiler-emitted helper, by the helper's name
// in Jet's terms (jet_cli_perf_helpers_section).
JetCLIPerfLineHelper: struct {
    path: String,
    line: Int,
    function: String,
    helper: String,
    samples: Int,
}

// Call sites as a receipt's rows: each its `function`, `file` (null for an
// inlined function's line from another file), `line` and whether the line
// is in the checked source (`own`).
jet_cli_perf_sites_json: fn(sites: &&[JetCLIPerfSite]) -> CanonicalJSON Never! {
    CanonicalJSON.Array(
        loop site in sites.move() -> CanonicalJSON.Object(
            [CanonicalJSONField]{
                {key: "file", value: if site.file == "" -> CanonicalJSON.Null else -> CanonicalJSON.String(site.file.move())},
                {key: "function", value: CanonicalJSON.String(site.name.move())},
                {key: "line", value: CanonicalJSON.Integer("{site.line}")},
                {key: "own", value: CanonicalJSON.Bool(site.own)},
            },
        ),
    )
}

// The x86-64 Linux name of host call `number`, as the runtime's host calls
// use them (HostProcess.jet host_call); `syscall <number>` for another.
jet_cli_perf_syscall_name: fn(number: U64) -> String Never! {
    if number == {
        0 -> "read"
        1 -> "write"
        2 -> "open"
        3 -> "close"
        4 -> "stat"
        5 -> "fstat"
        7 -> "poll"
        8 -> "lseek"
        9 -> "mmap"
        10 -> "mprotect"
        11 -> "munmap"
        13 -> "rt_sigaction"
        14 -> "rt_sigprocmask"
        16 -> "ioctl"
        17 -> "pread64"
        18 -> "pwrite64"
        21 -> "access"
        23 -> "select"
        24 -> "sched_yield"
        32 -> "dup"
        33 -> "dup2"
        35 -> "nanosleep"
        39 -> "getpid"
        41 -> "socket"
        42 -> "connect"
        43 -> "accept"
        44 -> "sendto"
        45 -> "recvfrom"
        49 -> "bind"
        50 -> "listen"
        56 -> "clone"
        57 -> "fork"
        58 -> "vfork"
        59 -> "execve"
        60 -> "exit"
        61 -> "wait4"
        62 -> "kill"
        72 -> "fcntl"
        74 -> "fsync"
        77 -> "ftruncate"
        78 -> "getdents"
        79 -> "getcwd"
        80 -> "chdir"
        82 -> "rename"
        83 -> "mkdir"
        84 -> "rmdir"
        87 -> "unlink"
        89 -> "readlink"
        96 -> "gettimeofday"
        97 -> "getrlimit"
        102 -> "getuid"
        110 -> "getppid"
        186 -> "gettid"
        200 -> "tkill"
        202 -> "futex"
        217 -> "getdents64"
        228 -> "clock_gettime"
        230 -> "clock_nanosleep"
        231 -> "exit_group"
        232 -> "epoll_wait"
        233 -> "epoll_ctl"
        234 -> "tgkill"
        247 -> "waitid"
        257 -> "openat"
        262 -> "newfstatat"
        281 -> "epoll_pwait"
        288 -> "accept4"
        290 -> "eventfd2"
        291 -> "epoll_create1"
        292 -> "dup3"
        293 -> "pipe2"
        302 -> "prlimit64"
        318 -> "getrandom"
        322 -> "execveat"
        332 -> "statx"
        424 -> "pidfd_send_signal"
        434 -> "pidfd_open"
        435 -> "clone3"
        436 -> "close_range"
        438 -> "pidfd_getfd"
        439 -> "faccessat2"
        else -> "syscall {number}"
    }
}

// The CPU-time profile `sampled` gives the checked `source` and the
// program's other sources: one row per function and line in them, with
// its exclusive and inclusive samples, its allocations and the events of
// each counter it captured, hottest first, the coldest folded past the
// row limit (jet_cli_perf_profile_fold), then the `wall` row of the run's
// `wall_samples` observations of `run`, at its place `wall`
// (jet_cli_perf_run_row), when the run published any,
// and in its reason the hottest image functions outside Jet code, by their
// symbols, the samples in compiler-emitted helpers, the samples in Jet
// code that kept no stack, and how many samples the CPU time sampled
// should give (jet_cli_perf_nominal); and, when the runtime recorded it,
// what sampling cost as its overhead. None when no sample landed in them.
jet_cli_perf_samples_profile: fn(source: JetCLIPerfSource, sampled: JetCLIPerfSamples, wall: JetCLIPerfRunPlace?{None}, wall_samples: U64{0}) -> TraceProfile? Never! {
    rows := [TraceProfileRow]{}
    elsewhere := sampled.outside
    loop place in sampled.lines {
        // The line's other source of the program, -1 for none.
        other: if place.own || place.file < 0 || place.file >= sampled.source_at.len() -> -1 else -> sampled.source_at[place.file]
        end := U64?{None}
        if place.own -> end = jet_cli_perf_line_end(source.text, place.line) else if other >= 0 && place.line >= 1 && place.line <= sampled.sources[other].ends.len() {
            end = Val(sampled.sources[other].ends[place.line - 1])
        }
        column: end ?? {
            elsewhere += place.count
            next
        }
        // The checked source's identity or the other source's, as the
        // location and the symbol name it.
        location: TraceProfileSource{path: if place.own -> source.identity.path else -> sampled.sources[other].identity.path, sha256: if place.own -> source.identity.sha256 else -> sampled.sources[other].identity.sha256, start_line: U64{place.line}, start_column: U64{1}, end_line: U64{place.line}, end_column: column}
        symbol: JetSymbolRef{path: if place.own -> source.identity.path else -> sampled.sources[other].identity.path, name: place.name}
        allocations: if sampled.sited -> Val(place.allocations) else -> U64?{None}
        rows.push(
            TraceProfileRow{
                clock: "cpu",
                allocation_count: allocations,
                dtlb_miss_count: jet_cli_perf_line_events(sampled, place, 2),
                execution_count: None,
                inclusive_count: Val(place.inclusive),
                l1d_miss_count: jet_cli_perf_line_events(sampled, place, 0),
                llc_miss_count: jet_cli_perf_line_events(sampled, place, 1),
                page_fault_count: jet_cli_perf_line_events(sampled, place, 3),
                sample_count: place.count,
                sample_weight: place.count,
                source: location,
                symbol: symbol,
            },
        )
    }
    // Past the row limit the coldest rows fold, so every sample keeps one,
    // into the rows the wall row leaves.
    walls: wall_samples > (U64{0}) && wall != None
    room: if walls -> TRACE_PROFILE_ROW_LIMIT - 1 else -> TRACE_PROFILE_ROW_LIMIT
    fold := jet_cli_perf_profile_fold(rows.move(), limit: room)
    rows = fold.rows.move()
    elsewhere += fold.dropped
    truncated: fold.dropped > (U64{0})
    // The rows are hottest first, by their own samples, then by the ones
    // they hold, then by their LLC and L1D misses: when no row holds a
    // sample, a counter's event or an allocation, every sample landed
    // elsewhere. A row may hold samples with none of its own, as a line
    // whose time goes to library code does; with no CPU-time samples, a row
    // holds only its counters' events under the memory lens alone and only
    // its allocations under the alloc lens alone.
    held := false
    loop row in rows {
        if row.sample_count > (U64{0}) || (row.inclusive_count ?? U64{0}) > (U64{0}) || (row.allocation_count ?? U64{0}) > (U64{0}) || (row.l1d_miss_count ?? U64{0}) > (U64{0}) || (row.llc_miss_count ?? U64{0}) > (U64{0}) || (row.dtlb_miss_count ?? U64{0}) > (U64{0}) || (row.page_fault_count ?? U64{0}) > (U64{0}) {
            held = true
            break
        }
    }
    if !held -> return None
    walled := ""
    if walls && wall == .Val(run) {
        row: jet_cli_perf_run_row(run, "wall", wall_samples)
        walled = "; the wall row is the run's {row.sample_count} observations of `run`, which do not separate the functions it calls"
        rows.push(row)
    }
    status: if truncated -> "truncated" else -> "captured"
    coverage: if elsewhere == (U64{0}) -> "complete" else -> "partial"
    named := [String]{}
    loop native in sampled.natives {
        if named.len() >= 8 -> break
        named.push("{sampled.functions[native.function].name} {native.count}")
    }
    natives: if named.len() == 0 -> "" else -> "; outside Jet functions: {named.join(", ")}"
    helpers: if sampled.helpers == (U64{0}) -> "" else -> "; {sampled.helpers} samples in compiler-emitted helpers, such as stop polls, count at the line that called them, which the `helpers` receipt splits out by line"
    stackless: if sampled.stackless == (U64{0}) -> "" else -> "; {sampled.stackless} samples in Jet code kept no stack: their frames could not be walked, or other threads' samples held every record buffer"
    // The interval a zones window's row gives is above 0 (jet_cli_perf_spans_window).
    per_sample: checked(U64{sampled.interval_us * 1000}) ?? U64{1}
    nominal: if sampled.cost == .Val(cost) -> jet_cli_perf_nominal(cost, sampled.sampler, sampled.total, per_sample) else -> ""
    windowed: if sampled.unwindowed == (U64{0}) -> "" else -> "; {sampled.unwindowed} samples the zones window's file held from outside the window count nowhere"
    cpu_ns: if sampled.cost == .Val(cost) -> Val(cost.cpu_ns) else -> U64?{None}
    taken: if sampled.sampler == .Val(used) -> jet_cli_perf_sampler_reason(used, sampled.total, cpu_ns) else -> ""
    sites: if sampled.sited -> "; each allocation counts at the innermost line of {source.identity.path} on its stack" else -> ""
    others: if sampled.sources.len() == 0 -> "" else -> " and the program's {sampled.sources.len()} other sources its rows are in"
    timed: "one CPU-time sample per {sampled.interval_us} microseconds of each thread's CPU time, at the function and source line its program counter is in and, inclusive, once at each line on its stack; {elsewhere} of {sampled.total} samples are outside {source.identity.path}{others}"
    // The memory lens or the alloc lens without the cpu lens takes no
    // CPU-time samples.
    alone: if sampled.periods.len() == 0 && sampled.sited -> "the alloc lens alone: each row holds its allocations" else -> "the memory lens alone: each row holds its counters' events"
    cut: if sampled.cost == .Val(cost) && cost.cut > (U64{0}) && sampled.sampler == .Val(used) -> "; {cost.cut} samples' stacks were cut at the {used.depth} callchain entries the kernel writes (perf_event_max_stack), so their outermost callers are missing" else -> ""
    reason: if sampled.total == (U64{0}) -> "no CPU-time samples, as under {alone}{natives}{sites}{fold.note}{windowed}{walled}" else -> "{timed}{fold.note}{taken}{natives}{helpers}{stackless}{cut}{nominal}{windowed}{sites}{walled}"
    profile := TraceProfile{method: "sampling", counters: [TraceCounter]{}, status: status, coverage: coverage, rows: rows, row_limit: U64{TRACE_PROFILE_ROW_LIMIT}, rows_truncated: truncated, overhead_ns: None, overhead_status: "not_measured", overhead_reason: "the runtime recorded no sampling cost", reason: reason, window_status: "unavailable", window_wall_ns: None, window_cpu_ns: None, window_reason: "the runtime published no run window"}
    if sampled.cost == .Val(cost) {
        // Each signal pays the kernel's delivery and return besides the
        // handler's own time. A sample the kernel wrote to a ring took no
        // signal: its drain's time is the handlers', with the delivery of
        // each signal of a ring's drain timer, and the kernel's time to
        // write it is the rings' own.
        drained: if cost.ring_samples < sampled.signals -> cost.ring_samples else -> sampled.signals
        signals: sampled.signals - drained
        took: cost.handler_ns + signals * cost.delivery_ns + cost.ring_ns
        profile.overhead_ns = Val(took)
        profile.overhead_status = "measured"
        sampler: "the sampler took {took / U64{1000}} microseconds, {jet_cli_perf_hundredths(took, cost.cpu_ns)} of the {cost.cpu_ns / U64{1000}} microseconds of CPU time sampled: "
        profile.overhead_reason = if cost.ring_samples == (U64{0}) -> "{sampler}{cost.handler_ns / U64{1000}} in its handlers and {sampled.signals} signals at the {cost.delivery_ns} nanoseconds the kernel took to deliver and return from one as sampling started" else -> "{sampler}{cost.handler_ns / U64{1000}} in its handlers and drains, each drain timer's signal delivered within them, {signals} signals at the {cost.delivery_ns} nanoseconds the kernel took to deliver and return from one as sampling started, and {cost.ring_ns / U64{1000}} microseconds the kernel took to write the {cost.ring_samples} samples to the threads' rings, as timed when sampling started"
    }
    Val(profile)
}

// The rows of a profile past the row limit, folded (jet_cli_perf_profile_fold):
// the rows, the words for the profile's reason, empty with nothing folded,
// and the samples of the rows past the limit all the same, 0 but for a run
// whose sampled sources alone pass it.
JetCLIPerfFold: struct {
    rows: [TraceProfileRow],
    note: String,
    dropped: U64,
}

// Folds the coldest of the profile rows `rows` (hottest first, one per line)
// into `limit` rows, TRACE_PROFILE_ROW_LIMIT unless a row the fold leaves
// alone takes one, so no sample is dropped: the hottest
// rows stay as they are and the rest sum into one row per function and
// source, which spans its folded lines, from the first to the last; or,
// when those alone pass the limit, one per source, named by how many
// functions it holds. A folded row holds its lines' own samples,
// allocations and counters' events, and no inclusive count, which would
// count twice a sample on two of its lines. The rows fit already, or the
// sampled sources alone pass the limit: then the coldest sources' rows past
// it are dropped, their samples counted.
jet_cli_perf_profile_fold: fn(rows: [TraceProfileRow], limit: Int{TRACE_PROFILE_ROW_LIMIT}) -> JetCLIPerfFold Never! {
    if rows.len() <= limit -> return JetCLIPerfFold{rows: rows, note: "", dropped: U64{0}}
    by_function := true
    keep := jet_cli_perf_profile_kept(rows, true, limit)
    if keep < 0 {
        by_function = false
        keep = jet_cli_perf_profile_kept(rows, false, limit)
    }
    if keep < 0 -> keep = 0
    folded := [TraceProfileRow]{}
    // Each folded row's place in `folded` by its key, and the functions of
    // each, by "path\nname", when they fold by source.
    places := [String:Int]{}
    functions := [Int]{}
    seen := [String:Bool]{}
    loop at in keep..<rows.len() {
        row: rows[at]
        key: jet_cli_perf_profile_fold_key(row, by_function)
        named: "{row.source.path}\n{row.symbol.name}"
        if !places.has_key(key) {
            seen[named] = true
            places[key] = folded.len()
            first := row
            first.inclusive_count = None
            folded.push(first)
            functions.push(1)
            next
        }
        index: places[key]
        if !seen.has_key(named) {
            seen[named] = true
            functions[index] = functions[index] + 1
        }
        into := folded[index]
        into.sample_count += row.sample_count
        into.sample_weight += row.sample_weight
        into.allocation_count = jet_cli_perf_count_sum(into.allocation_count, row.allocation_count)
        into.dtlb_miss_count = jet_cli_perf_count_sum(into.dtlb_miss_count, row.dtlb_miss_count)
        into.l1d_miss_count = jet_cli_perf_count_sum(into.l1d_miss_count, row.l1d_miss_count)
        into.llc_miss_count = jet_cli_perf_count_sum(into.llc_miss_count, row.llc_miss_count)
        into.page_fault_count = jet_cli_perf_count_sum(into.page_fault_count, row.page_fault_count)
        if row.source.start_line < into.source.start_line {
            into.source.start_line = row.source.start_line
        }
        if row.source.end_line > into.source.end_line {
            into.source.end_line = row.source.end_line
            into.source.end_column = row.source.end_column
        }
        folded[index] = into
    }
    out := [TraceProfileRow]{}
    loop at in 0..<keep -> out.push(rows[at])
    dropped := U64{0}
    loop (index, row) in folded {
        if out.len() >= limit {
            dropped += row.sample_count
            next
        }
        named := row
        if functions[index] > 1 -> named.symbol.name = "{functions[index]} functions"
        out.push(named)
    }
    by: if by_function -> "function" else -> "source, named by how many functions it holds"
    past: if dropped > (U64{0}) -> ", and the {dropped} samples of the coldest sources past the limit are outside them" else -> ""
    JetCLIPerfFold{rows: out, note: "; past the {TRACE_PROFILE_ROW_LIMIT}-row limit its {rows.len() - keep} coldest lines fold into {folded.len()} rows, one per {by}, each from its first folded line to its last{past}", dropped: dropped}
}

// How many of the profile rows `rows`, hottest first, stay as they are
// when the rest fold by function (`by_function`) or by source into `limit`
// rows; -1 when the folded rows alone pass it.
jet_cli_perf_profile_kept: fn(rows: [TraceProfileRow], by_function: Bool, limit: Int) -> Int Never! {
    groups := [String:Bool]{}
    keep := limit
    loop at in keep..<rows.len() {
        groups[jet_cli_perf_profile_fold_key(rows[at], by_function)] = true
    }
    loop keep + groups.len() > limit {
        if keep == 0 -> return -1
        keep -= 1
        groups[jet_cli_perf_profile_fold_key(rows[keep], by_function)] = true
    }
    keep
}

// The fold a profile row joins (jet_cli_perf_profile_fold): its source and
// function, or its source alone.
jet_cli_perf_profile_fold_key: fn(row: TraceProfileRow, by_function: Bool) -> String Never! {
    if by_function -> "{row.source.path}\n{row.symbol.name}" else -> "{row.source.path}"
}

// Two counts summed, None when neither was counted.
jet_cli_perf_count_sum: fn(left: U64?, right: U64?) -> U64? Never! {
    if left == .Val(counted) -> return Val(counted + (right ?? U64{0}))
    if right == .Val(counted) -> return Val(counted)
    None
}

// `part` as a percentage of `whole`, to two decimals: "1.25%".
jet_cli_perf_hundredths: fn(part: U64, whole: U64) -> String Never! {
    if whole == (U64{0}) -> return "0.00%"
    basis: part * U64{10000} / whole
    cents: basis % U64{100}
    pad: if cents < (U64{10}) -> "0" else -> ""
    "{basis / U64{100}}.{pad}{cents}%"
}

// The events of counter `counter` (an index of TRACE_COUNTERS) at line
// `place`; None when the run did not capture that counter.
jet_cli_perf_line_events: fn(sampled: JetCLIPerfSamples, place: JetCLIPerfSampledLine, counter: Int) -> U64? Never! {
    if counter >= sampled.periods.len() || sampled.periods[counter] == (U64{0}) -> return None
    Val(place.events[counter])
}

// The memory lens's `profile`: the `counters` the run asked for, and in its
// reason how each counter's samples count and why each one it lacks is
// unavailable.
jet_cli_perf_counters_profile: fn(profile: &TraceProfile, counters: &&[TraceCounter]) Never! {
    notes := [String]{}
    loop counter in counters {
        if counter.period == .Val(period) {
            notes.push("{trace_counter_name(counter.name)} one sample per {period} events, at the innermost line of the checked source on its stack")
        } else {
            errno: counter.errno ?? U64{0}
            notes.push("{trace_counter_name(counter.name)} unavailable: {jet_cli_perf_counter_refusal(errno)}")
        }
    }
    profile.reason = "{profile.reason}; {notes.join("; ")}"
    profile.counters = counters
}

// Why a counter the kernel refused with `errno` is unavailable; 0 is a
// counter the program never opened.
jet_cli_perf_counter_refusal: fn(errno: U64) -> String Never! {
    if errno == (U64{0}) -> return "the program opened no counters"
    "the kernel refused the counter (errno {errno})"
}

// The first column past the last character of line `line` of `text`
// (columns count characters from 1); None past its last line.
jet_cli_perf_line_end: fn(text: String, line: Int) -> U64? Never! {
    if line < 1 -> return None
    at := 1
    column := U64{1}
    loop byte in text.bytes() {
        if at != line {
            if byte == (U8{10}) -> at += 1
            next
        }
        if byte == (U8{10}) -> return Val(column)
        if byte < (U8{128}) || byte >= (U8{192}) -> column += U64{1}
    }
    if at == line -> Val(column) else -> None
}

JetCLIPerfSource: struct {
    identity: SourceIdentity,
    run_span: Span?,
    text: String,
}

jet_cli_perf_source: fn(path: String, text: String) -> JetCLIPerfSource Never! {
    identity := SourceIdentity{path: path, sha256: sha256_hex(text), symbols: [{name: String, kind: String}]{}}
    block: jet_driver_inline_package(text)
    if block.error != None {
        return JetCLIPerfSource{identity: identity, run_span: None, text: text}
    }
    masked: jet_driver_mask_inline_package(text, block)
    program: jet_cli_parsed_program(masked) ?? return JetCLIPerfSource{identity: identity, run_span: None, text: text}
    run_span := Span?{None}
    loop item in program.items {
        if item == .Func(function) {
            identity.symbols.push({name: function.name, kind: "fn"})
            if function.name == "run" -> run_span = Val(function.span)
        }
    }
    JetCLIPerfSource{identity: identity, run_span: run_span, text: text}
}

jet_cli_perf_source_position: fn(text: String, offset: Int) -> {line: U64, column: U64} JetCLIReadError! {
    bytes: text.bytes()
    if offset < 0 || offset > bytes.len() {
        return Err(jet_cli_read_error("parser source span lies outside its source bytes"))
    }
    if offset < bytes.len() && bytes[offset] >= (U8{128}) && bytes[offset] < (U8{192}) {
        return Err(jet_cli_read_error("parser source span splits a UTF-8 scalar"))
    }
    line := U64{1}
    column := U64{1}
    loop index in 0..<offset {
        byte: bytes[index]
        if byte == (U8{10}) {
            line += U64{1}
            column = U64{1}
        } else if byte < (U8{128}) || byte >= (U8{192}) { column += U64{1} }
    }
    Ok({column: column, line: line})
}

// The checked source's `run` as a profile row of its observations places
// it: its parsed `run: fn` declaration, `fn` through its closing brace, and
// its symbol.
JetCLIPerfRunPlace: struct {
    location: TraceProfileSource,
    symbol: JetSymbolRef,
}

// Where the checked `source`'s `run` is (JetCLIPerfRunPlace); None when it
// has no parseable top-level `run`.
jet_cli_perf_run_place: fn(source: JetCLIPerfSource) -> JetCLIPerfRunPlace? JetCLIReadError! {
    span: source.run_span ?? return Ok(None)
    if span.end <= span.start -> return Err(jet_cli_read_error("source sampling span is empty"))
    start: jet_cli_perf_source_position(source.text, span.start)
    end: jet_cli_perf_source_position(source.text, span.end)
    Ok(Val(JetCLIPerfRunPlace{location: TraceProfileSource{path: source.identity.path, sha256: source.identity.sha256, start_line: start.line, start_column: start.column, end_line: end.line, end_column: end.column}, symbol: JetSymbolRef{path: source.identity.path, name: "run"}}))
}

// The `clock` row of `count` of the run's observations of `run` at
// `place`, at most 4096: they do not separate the functions `run` calls,
// and count no inclusive time or allocation.
jet_cli_perf_run_row: fn(place: JetCLIPerfRunPlace, clock: String, count: U64) -> TraceProfileRow Never! {
    kept: if count < (U64{4096}) -> count else -> U64{4096}
    TraceProfileRow{clock: clock, allocation_count: None, dtlb_miss_count: None, execution_count: None, inclusive_count: None, l1d_miss_count: None, llc_miss_count: None, page_fault_count: None, sample_count: kept, sample_weight: kept, source: place.location, symbol: place.symbol}
}

// The profile of a run whose CPU-time samples never reached its sources:
// the `cpu` row of its `cpu_samples` observations that timed its CPU, then
// the `wall` row of all its `wall_samples` observations, as a sampled
// profile keeps it after its CPU rows (jet_cli_perf_samples_profile).
jet_cli_perf_source_profile: fn(source: JetCLIPerfSource, wall_samples: U64, cpu_samples: U64, truncated: Bool) -> TraceProfile JetCLIReadError! {
    place: jet_cli_perf_run_place(source) ?? return Ok(trace_profile_unsupported("checked source attribution requires a parseable top-level `run` function"))
    rows := [TraceProfileRow]{}
    if cpu_samples > (U64{0}) -> rows.push(jet_cli_perf_run_row(place, "cpu", cpu_samples))
    if wall_samples > (U64{0}) -> rows.push(jet_cli_perf_run_row(place, "wall", wall_samples))
    limited: truncated || wall_samples > U64{4096} || cpu_samples > U64{4096}
    status: if limited -> "truncated" else if rows.len() == 0 -> "no_samples" else -> "captured"
    coverage: if rows.len() == 0 && !limited -> "none" else -> "partial"
    reason: if rows.len() == 0 -> "no supported observations were captured" else -> "only the checked top-level entrypoint is source-attributed; invocation counts are not inferred"
    Ok(TraceProfile{method: "sampling", counters: [TraceCounter]{}, status: status, coverage: coverage, rows: rows, row_limit: U64{4096}, rows_truncated: limited, overhead_ns: None, overhead_status: "not_measured", overhead_reason: "a matched unprofiled run was not captured", reason: reason, window_status: "unavailable", window_wall_ns: None, window_cpu_ns: None, window_reason: "the runtime published no run window"})
}

jet_cli_perf_window: fn(profile: &TraceProfile, window: JetCLIPerfRuntimeWindow) Never! {
    profile.window_status = if window.exit -> "exit" else -> "live"
    profile.window_wall_ns = Val(window.elapsed_ns)
    profile.window_cpu_ns = window.cpu_ns
    profile.window_reason = "runtime-published monotonic run window"
}

// The spans file `path` of a `jet perf run` program (the runtime's
// PerfSamples.jet perf_zone_row), the one timeline of its closed log spans,
// closed zones, frame marks and plotted values: per row its start and end
// (a plot's value bits) on the monotonic clock, its task, and its name's
// byte length with its kind (JET_CLI_PERF_ZONE_LOG and the others) from bit
// 32, each a little-endian word, then the name. Each becomes a `log_span`,
// `zone`, `frame_mark` or `plot` row of `capture` (a plot's symbol names its
// value after its name: `fps = 60`), timed from `origin_ns` (a run's 0,
// its process epoch) and named by the span in `source`, within the span
// row limit. A zone holds the CPU-time samples of `timed` (in time order,
// on the same clock) its task took from its start to its end, and the lines
// of `source` they were on. Every zone, frame mark and plotted value counts
// in the `zones` receipt section, the rows past the limit too
// (jet_cli_perf_zones_section), and so does why zones could not turn on (a
// JET_CLI_PERF_ZONE_REFUSED row's name) and that the file reached its bound
// and dropped the rows after it (a JET_CLI_PERF_ZONE_CUT row's name), which
// are no timeline rows. Each task's first zone or log span, the earliest
// opened and of those the longest, names its phase (`capture.task_phases`).
// The file is removed once read; a row cut short ends the read.
jet_cli_perf_log_spans_read: fn(capture: &JetCLIPerfCapture, path: String, source: String, origin_ns: Int, timed: [JetCLIPerfTimed]) -[FS]> Never! {
    bytes: perf_files.read_bytes(path) ?? [U8]{}
    perf_files.remove(path).drop("the session reads its log spans once")
    zones := [JetCLIPerfZoneTotal]{}
    // Each zone name's entry in `zones`, and each plot's in `plots`.
    zoned := [String:Int]{}
    frames := [Int]{}
    plots := [JetCLIPerfPlotTotal]{}
    plot_at := [String:Int]{}
    // The zone rows of `capture` that hold samples.
    sampled := [JetCLIPerfZoneSampled]{}
    refused := ""
    cut := ""
    // The start and end of each task's phase, by its runtime id.
    opened := [U64:Int]{}
    closed := [U64:Int]{}
    at := 0
    loop at + 32 <= bytes.len() {
        start: link_debug_addr(bytes, at)
        end: link_debug_addr(bytes, at + 8)
        task: link_debug_addr(bytes, at + 16)
        shape: link_debug_addr(bytes, at + 24)
        length: shape & 4294967295
        kind: shape >> 32
        if shape < 0 || at + 32 + length > bytes.len() -> break
        // A zones window's row holds words, not a name
        // (jet_cli_perf_spans_window).
        if kind == JET_CLI_PERF_ZONE_WINDOW {
            at += 32 + length
            next
        }
        name: String.from_bytes(bytes.slice(at + 32, at + 32 + length)) ?? break
        at += 32 + length
        if kind == JET_CLI_PERF_ZONE_REFUSED {
            refused = name
            next
        }
        if kind == JET_CLI_PERF_ZONE_CUT {
            cut = name
            next
        }
        if kind != JET_CLI_PERF_ZONE_FRAME && kind != JET_CLI_PERF_ZONE_PLOT && task > 0 {
            owner: U64{task}
            if !opened.has_key(owner) || start < opened[owner] || (start == opened[owner] && end > closed[owner]) {
                opened[owner] = start
                closed[owner] = end
                capture.task_phases[owner] = "{name}"
            }
        }
        // The zone's samples, and the line most of them were on.
        held := 0
        hottest := 0
        if kind == JET_CLI_PERF_ZONE_ZONE {
            if !zoned.has_key(name) {
                zoned[name] = zones.len()
                zones.push(JetCLIPerfZoneTotal{name: "{name}", count: 0, total: 0, longest: 0, samples: 0, lines: [Int:Int]{}})
            }
            index: zoned[name]
            zones[index].count += 1
            zones[index].total += end - start
            if end - start > zones[index].longest -> zones[index].longest = end - start
            tally := [Int:Int]{}
            loop sample in jet_cli_perf_timed_first(timed, start)..<timed.len() {
                if timed[sample].at_ns >= end -> break
                if timed[sample].task != task -> next
                held += 1
                line: timed[sample].line
                if line == 0 -> next
                zones[index].lines[line] = (zones[index].lines.get(line) ?? 0) + 1
                tally[line] = (tally.get(line) ?? 0) + 1
                if hottest == 0 || tally[line] > tally[hottest] || (tally[line] == tally[hottest] && line < hottest) {
                    hottest = line
                }
            }
            zones[index].samples += held
        }
        if kind == JET_CLI_PERF_ZONE_FRAME -> frames.push(start)
        if kind == JET_CLI_PERF_ZONE_PLOT {
            if !plot_at.has_key(name) {
                plot_at[name] = plots.len()
                plots.push(JetCLIPerfPlotTotal{name: "{name}", count: 0, last: ""})
            }
            plot := plots[plot_at[name]]
            plot.count += 1
            plot.last = "{perf_math.from_bits(end)}"
            plots[plot_at[name]] = plot
        }
        if (U64{capture.spans.len()}) >= TRACE_SPAN_ROW_LIMIT {
            capture.policy.span_rows_truncated = true
            next
        }
        row: if kind == {
            JET_CLI_PERF_ZONE_ZONE -> "zone"
            JET_CLI_PERF_ZONE_FRAME -> "frame_mark"
            JET_CLI_PERF_ZONE_PLOT -> "plot"
            else -> "log_span"
        }
        plotted: kind == JET_CLI_PERF_ZONE_PLOT
        label: if plotted -> "{name} = {perf_math.from_bits(end)}" else -> name
        finish: if plotted -> start else -> end
        since: jet_cli_perf_since(start, origin_ns)
        until: jet_cli_perf_since(finish, origin_ns)
        if held > 0 {
            sampled.push(JetCLIPerfZoneSampled{name: "{label}", start_ns: since, end_ns: until, samples: held, line: hottest})
        }
        symbol: JetSymbolRef{path: source, name: label}
        capture.spans.push(TraceSpan{awaited_task_id: None, channel_id: None, clock: "monotonic", start_ns: Val(since), end_ns: Val(until), kind: row, local_address: None, parent_task_id: None, peer_address: None, reason: "", spawn_line: None, status: "captured", symbol: symbol, task_id: None, wait_stack: [TraceStackFrame]{}, waker: "", waker_line: None, waker_task_id: None})
    }
    if zones.len() > 0 || frames.len() > 0 || plots.len() > 0 || refused != "" || cut != "" {
        zones.sort_by(fn(left: JetCLIPerfZoneTotal, right: JetCLIPerfZoneTotal) { (right.total <=> left.total).then(left.name <=> right.name) })
        frames.sort()
        capture.receipts.push(jet_cli_perf_zones_section(zones, frames, plots, sampled, source, refused, cut))
    }
}

// The first sample of `timed`, in time order, at or after `start`;
// `timed.len()` for none.
jet_cli_perf_timed_first: fn(timed: [JetCLIPerfTimed], start: Int) -> Int Never! {
    low := 0
    high := timed.len()
    loop low < high {
        middle: low + (high - low) /% 2
        if timed[middle].at_ns < start -> low = middle + 1 else -> high = middle
    }
    low
}

// A zone row of a trace that holds CPU-time samples: its name, its start
// and end on the trace's clock, how many samples its task took inside it
// and the line of the checked source most of them were on (0 for none).
JetCLIPerfZoneSampled: struct {
    name: String,
    start_ns: U64,
    end_ns: U64,
    samples: Int,
    line: Int,
}

// The `zones` receipt section of a run's closed zones, heaviest first,
// frame marks (their starts, in order) and plotted values: each zone name
// with how many closed and their total and longest time, the CPU-time
// samples their tasks took inside them and the JET_CLI_PERF_ZONE_LINES
// lines of `source` most of those were on; the frames with how many and
// their mean and longest interval; each plot with how many values and its
// last; each zone row of the trace that holds samples (`sampled`), by its
// name, start and end, with how many and the line most were on; when
// the runtime could not turn zones on, why (`refused`, empty otherwise);
// and when the spans file reached its bound, that its later rows were
// dropped (`cut`, empty otherwise). `jet perf view` shows them
// (jet_cli_perf_zone_lines, jet_cli_perf_timeline).
jet_cli_perf_zones_section: fn(zones: [JetCLIPerfZoneTotal], frames: [Int], plots: [JetCLIPerfPlotTotal], sampled: [JetCLIPerfZoneSampled], source: String, refused: String, cut: String) -> TraceReceiptSection Never! {
    widest := 0
    loop at in 1..<frames.len() {
        if frames[at] - frames[at - 1] > widest -> widest = frames[at] - frames[at - 1]
    }
    mean: if frames.len() > 1 -> (frames[frames.len() - 1] - frames[0]).div_euclid(frames.len() - 1) else -> 0
    zone_rows := [CanonicalJSON]{}
    loop zone in zones {
        ranked := [JetCLIPerfZoneLine]{}
        loop line in zone.lines.keys() {
            ranked.push(JetCLIPerfZoneLine{line: line, samples: zone.lines[line]})
        }
        ranked.sort_by(fn(left: JetCLIPerfZoneLine, right: JetCLIPerfZoneLine) { (right.samples <=> left.samples).then(left.line <=> right.line) })
        hot := [CanonicalJSON]{}
        loop held in ranked {
            if hot.len() >= JET_CLI_PERF_ZONE_LINES -> break
            hot.push(CanonicalJSON.Object([CanonicalJSONField]{{key: "line", value: CanonicalJSON.Integer("{held.line}")}, {key: "samples", value: CanonicalJSON.Integer("{held.samples}")}}))
        }
        zone_rows.push(
            CanonicalJSON.Object(
                [CanonicalJSONField]{
                    {key: "count", value: CanonicalJSON.Integer("{zone.count}")},
                    {key: "lines", value: CanonicalJSON.Array(hot)},
                    {key: "longest_ns", value: CanonicalJSON.Integer("{zone.longest}")},
                    {key: "name", value: CanonicalJSON.String("{zone.name}")},
                    {key: "samples", value: CanonicalJSON.Integer("{zone.samples}")},
                    {key: "total_ns", value: CanonicalJSON.Integer("{zone.total}")},
                },
            ),
        )
    }
    sampled_rows := [CanonicalJSON]{}
    loop row in sampled {
        sampled_rows.push(
            CanonicalJSON.Object(
                [CanonicalJSONField]{
                    {key: "end_ns", value: CanonicalJSON.Integer("{row.end_ns}")},
                    {key: "line", value: CanonicalJSON.Integer("{row.line}")},
                    {key: "name", value: CanonicalJSON.String("{row.name}")},
                    {key: "samples", value: CanonicalJSON.Integer("{row.samples}")},
                    {key: "start_ns", value: CanonicalJSON.Integer("{row.start_ns}")},
                },
            ),
        )
    }
    plot_rows := [CanonicalJSON]{}
    loop plot in plots {
        plot_rows.push(
            CanonicalJSON.Object(
                [CanonicalJSONField]{
                    {key: "count", value: CanonicalJSON.Integer("{plot.count}")},
                    {key: "last", value: CanonicalJSON.String("{plot.last}")},
                    {key: "name", value: CanonicalJSON.String("{plot.name}")},
                },
            ),
        )
    }
    fields := [CanonicalJSONField]{}
    if cut != "" {
        fields.push(CanonicalJSONField{key: "cut", value: CanonicalJSON.String("{cut}")})
    }
    fields.push(
        CanonicalJSONField{
            key: "frames",
            value: CanonicalJSON.Object(
                [CanonicalJSONField]{
                    {key: "count", value: CanonicalJSON.Integer("{frames.len()}")},
                    {key: "longest_ns", value: CanonicalJSON.Integer("{widest}")},
                    {key: "mean_ns", value: CanonicalJSON.Integer("{mean}")},
                },
            ),
        },
    )
    fields.push(CanonicalJSONField{key: "plots", value: CanonicalJSON.Array(plot_rows)})
    if refused != "" {
        fields.push(CanonicalJSONField{key: "refused", value: CanonicalJSON.String("{refused}")})
    }
    fields.push(CanonicalJSONField{key: "sampled", value: CanonicalJSON.Array(sampled_rows)})
    fields.push(CanonicalJSONField{key: "source", value: CanonicalJSON.String("{source}")})
    fields.push(CanonicalJSONField{key: "zones", value: CanonicalJSON.Array(zone_rows)})
    value: CanonicalJSON.Object(fields)
    digest: canonical_json_sha256(value)
    TraceReceiptSection{name: "zones", type_name: "JetPerfZones", value: value, digest: digest}
}

// The most lines of a zone name `jet perf view` names its samples on.
JET_CLI_PERF_ZONE_LINES: 3

// A line of the checked source and the samples of a zone name on it.
JetCLIPerfZoneLine: struct {
    line: Int,
    samples: Int,
}

// What a row of the spans file is (PerfSamples.jet PERF_ZONE_LOG and the
// others): a closed log span, a closed zone, a frame mark, a plot, why
// zones could not turn on, the file's bound reached, or an attach's zones
// window.
JET_CLI_PERF_ZONE_ZONE: 1

JET_CLI_PERF_ZONE_FRAME: 2

JET_CLI_PERF_ZONE_PLOT: 3

JET_CLI_PERF_ZONE_REFUSED: 4

JET_CLI_PERF_ZONE_CUT: 5

JET_CLI_PERF_ZONE_WINDOW: 6

// The last zones window of the spans file's `bytes`: a JET_CLI_PERF_ZONE_WINDOW
// row, its start and end then its five little-endian words, the interval
// its samples stand for in microseconds, the process's CPU time in it, its
// handlers' time, the kernel's time to deliver one signal and the records
// lost (PerfSamples.jet perf_flight_window_close). None when it holds none,
// or only one with no interval.
jet_cli_perf_spans_window: fn(bytes: [U8]) -> JetCLIPerfZonesWindow? Never! {
    found := JetCLIPerfZonesWindow?{None}
    at := 0
    loop at + 32 <= bytes.len() {
        shape: link_debug_addr(bytes, at + 24)
        length: shape & 4294967295
        if shape < 0 || at + 32 + length > bytes.len() -> break
        if (shape >> 32) == JET_CLI_PERF_ZONE_WINDOW && length >= 40 && link_debug_addr(bytes, at + 32) > 0 {
            found = Val(JetCLIPerfZonesWindow{
                start_ns: link_debug_addr(bytes, at),
                end_ns: link_debug_addr(bytes, at + 8),
                interval_us: link_debug_addr(bytes, at + 32),
                cpu_ns: checked(U64{link_debug_addr(bytes, at + 40)}) ?? U64{0},
                handler_ns: checked(U64{link_debug_addr(bytes, at + 48)}) ?? U64{0},
                delivery_ns: checked(U64{link_debug_addr(bytes, at + 56)}) ?? U64{0},
                lost: checked(U64{link_debug_addr(bytes, at + 64)}) ?? U64{0},
            })
        }
        at += 32 + length
    }
    found
}

// Each task's wait the program recorded (`waits`) as a `task_wait`
// row of `capture`, timed from `origin_ns` as the log spans are: its task
// by the id its trace row carries (`capture.task_ids`), its name, the
// functions and lines of `source` on its waiting stack, what it waited for
// (a task, with the line of `source` that spawned it when its spawning
// stack held one, a channel, or a socket by its own address and its
// peer's) and what ended it: the last wake of its slot at or before its
// end (jet_cli_perf_wait_waker), a task's at its line of `source` or the
// runtime's outside every task (a timer's), or with no wake its own
// timeout. A wake counts from the end of the task's previous wait on the
// same slot, and from JET_CLI_PERF_WAKE_LEAD_NS before the wait's start, so
// a stale wake of a reused slot is no waker. The I/O poller wakes a
// socket's wait for what happened at the connection's other end: the task
// of the program that acted there (jet_cli_perf_socket_cause), a transfer
// of `transfers` or a connect of `waits`, at its line, else its peer
// outside the program. Each task of `spawns` no observation saw gets a
// done task's row first, under its spawner's, so a wait, a wake or a
// transfer of a short task still names it; a task whose spawner has no row
// gets none, and a wait of a task with no row keeps none either. Past the
// task row limit the tasks with the most CPU-time samples (`samples`, by
// runtime id) keep their rows (jet_cli_perf_tasks_admitted) and the rest
// count in the `tasks` receipt section (jet_cli_perf_tasks_section). Each
// wait's name, addresses and stack move into its row.
jet_cli_perf_waits_read: fn(capture: &JetCLIPerfCapture, waits: &&[JetCLIPerfWait], wakes: [JetCLIPerfWake], spawns: [JetCLIPerfSpawn], samples: [U64:U64], transfers: [JetCLIPerfIO], source: String, origin_ns: Int) Never! {
    // Each spawned task's line by its runtime id, and its row when no
    // observation gave it one; a spawner's spawn came before its own.
    admitted: jet_cli_perf_tasks_admitted(capture.task_ids, TRACE_TASK_ROW_LIMIT - U64{capture.tasks.len()}, spawns, samples)
    lines := [U64:U64]{}
    loop spawn in spawns {
        if spawn.line == .Val(line) -> lines[spawn.task] = line
        if capture.task_ids.has_key(spawn.task) || !capture.task_ids.has_key(spawn.parent) -> next
        if !admitted.has_key(spawn.task) {
            capture.policy.task_rows_truncated = true
            next
        }
        id: U64{capture.tasks.len() + 1}
        capture.tasks.push(TraceTask{id: id, parent: capture.task_ids[spawn.parent], state: "done", wait: "", canceled: false, symbol: JetSymbolRef{path: source, name: "run"}})
        capture.task_ids[spawn.task] = id
    }
    // Each slot's wakes by their place in `wakes`, earliest first.
    order := [Int]{}
    loop index in 0..<wakes.len() -> order.push(index)
    order.sort_by(fn(left: Int, right: Int) { wakes[left].at_ns <=> wakes[right].at_ns })
    slots := [Int:[Int]]{}
    loop index in order {
        slot: wakes[index].slot
        if !slots.has_key(slot) -> slots[slot] = [Int]{}
        slots[slot].push(index)
    }
    // What ended each socket wait if a task's act did, by its place in
    // `waits`.
    causes: loop wait in waits -> jet_cli_perf_socket_cause(transfers, wait)
    // The end of each task's last wait on each slot, by "slot/task".
    ends := [String:Int]{}
    pending := waits
    pending.reverse()
    place := -1
    loop pending.len() > 0 {
        wait: pending.pop() ?? break
        place += 1
        key: "{wait.slot}/{wait.task}"
        lead: wait.start_ns - JET_CLI_PERF_WAKE_LEAD_NS
        floor: if ends.has_key(key) && ends[key] > lead -> ends[key] else -> lead
        ends[key] = wait.end_ns
        if !capture.task_ids.has_key(wait.task) -> next
        if (U64{capture.spans.len()}) >= TRACE_SPAN_ROW_LIMIT {
            capture.policy.span_rows_truncated = true
            break
        }
        waker := "timeout"
        waker_task_id := U64?{None}
        waker_line := U64?{None}
        found: if slots.has_key(wait.slot) -> jet_cli_perf_wait_waker(wakes, slots[wait.slot], floor, wait.end_ns) else -> -1
        if found >= 0 {
            wake: wakes[found]
            waker = if wake.task == (U64{0}) -> "runtime" else -> "task"
            if capture.task_ids.has_key(wake.task) {
                waker_task_id = Val(capture.task_ids[wake.task])
            }
            if wake.line == .Val(line) -> waker_line = Val(U64{line})
        }
        if wait.class == JET_CLI_PERF_OBJECT_SOCKET && waker == "runtime" {
            // The peer's wake reaches the poller from outside the program:
            // the line the runtime's wake carries is no peer's.
            waker = "peer"
            waker_line = None
            if causes[place] == .Val(cause) {
                waker = "task"
                if capture.task_ids.has_key(cause.task) {
                    waker_task_id = Val(capture.task_ids[cause.task])
                }
                waker_line = cause.line
            }
        }
        awaited := U64?{None}
        spawn_line := U64?{None}
        if wait.class == JET_CLI_PERF_OBJECT_TASK && capture.task_ids.has_key(wait.id) {
            awaited = Val(capture.task_ids[wait.id])
            if lines.has_key(wait.id) -> spawn_line = Val(lines[wait.id])
        }
        channel_id: if wait.class == JET_CLI_PERF_OBJECT_CHANNEL && wait.id != (U64{0}) -> Val(wait.id) else -> U64?{None}
        local_address: if jet_cli_perf_socket_named(wait.local) -> Val(wait.local.move()) else -> String?{None}
        peer_address: if jet_cli_perf_socket_named(wait.peer) -> Val(wait.peer.move()) else -> String?{None}
        stack: wait.frames.move()
        symbol: JetSymbolRef{path: source, name: wait.name.move()}
        capture.spans.push(TraceSpan{awaited_task_id: awaited, channel_id: channel_id, clock: "monotonic", end_ns: Val(jet_cli_perf_since(wait.end_ns, origin_ns)), kind: "task_wait", local_address: local_address, parent_task_id: None, peer_address: peer_address, reason: "", spawn_line: spawn_line, start_ns: Val(jet_cli_perf_since(wait.start_ns, origin_ns)), status: "captured", symbol: symbol, task_id: Val(capture.task_ids[wait.task]), wait_stack: stack, waker: waker, waker_line: waker_line, waker_task_id: waker_task_id})
    }
}

// The CPU-time samples of `timed` each task took, by its runtime id; the
// samples outside every task count for none.
jet_cli_perf_task_samples: fn(timed: [JetCLIPerfTimed]) -> [U64:U64] Never! {
    counts := [U64:U64]{}
    loop sample in timed {
        if sample.task <= 0 -> next
        task: U64{sample.task}
        counts[task] = (counts.get(task) ?? U64{0}) + U64{1}
    }
    counts
}

// Which tasks of `spawns` with no row yet (`rowed`, by runtime id) get one
// in the `room` rows left under the task row limit: every one when they
// fit; else, from the most CPU-time samples (`samples`, by runtime id) to
// the fewest, ties in spawn order, each task with its spawners that have
// no row yet, while they fit. A task none of whose spawners has a row gets
// none.
jet_cli_perf_tasks_admitted: fn(rowed: [U64:U64], room: U64, spawns: [JetCLIPerfSpawn], samples: [U64:U64]) -> [U64:Bool] Never! {
    parents := [U64:U64]{}
    fresh := [U64]{}
    loop spawn in spawns {
        if rowed.has_key(spawn.task) || parents.has_key(spawn.task) -> next
        parents[spawn.task] = spawn.parent
        fresh.push(spawn.task)
    }
    admitted := [U64:Bool]{}
    if (U64{fresh.len()}) <= room {
        loop task in fresh -> admitted[task] = true
        return admitted
    }
    order := [Int]{}
    loop index in 0..<fresh.len() -> order.push(index)
    order.sort_by(fn(left: Int, right: Int) { ((samples.get(fresh[right]) ?? U64{0}) <=> (samples.get(fresh[left]) ?? U64{0})).then(left <=> right) })
    taken := U64{0}
    loop index in order {
        if taken == room -> break
        // The task and its spawners up to one with a row.
        chain := [U64]{}
        rooted := true
        at := fresh[index]
        loop !rowed.has_key(at) && !admitted.has_key(at) {
            if !parents.has_key(at) {
                rooted = false
                break
            }
            chain.push(at)
            at = parents[at]
        }
        if !rooted || taken + (U64{chain.len()}) > room -> next
        loop task in chain -> admitted[task] = true
        taken += U64{chain.len()}
    }
    admitted
}

// A phase's tasks (jet_cli_perf_tasks_section): its name, empty for none,
// how many tasks and CPU-time samples it holds, and of those the tasks with
// no trace row and their samples, folded into it.
JetCLIPerfTaskPhase: struct {
    name: String,
    tasks: Int,
    samples: U64,
    folded: Int,
    folded_samples: U64,
}

// The `tasks` receipt section: every task of the run, those with a trace
// row (`rowed`, by runtime id) and those past the task row limit alike, by
// its phase, the name of the first zone or log span it opened (`named`, by
// runtime id), else its spawner's (`spawns`), else none; each phase with
// its tasks and the CPU-time samples they took (`samples`, by runtime id),
// and of those the tasks with no row and theirs, the phase with the most
// samples first: `{"count":5001,"coverage":"complete","phases":[{"folded":
// 452,"folded_samples":300,"name":"lower","samples":1632,"tasks":2500},…],
// "rows":4096,"unattributed_samples":0}`, a phase of none named null. Its
// coverage is complete when every sample of a task counts in a phase: the
// samples of a task the run neither observed nor recorded the spawn of are
// unattributed. `jet perf view` shows it (jet_cli_perf_task_phase_lines).
// None when the run had no task.
jet_cli_perf_tasks_section: fn(rowed: [U64:U64], named: [U64:String], spawns: [JetCLIPerfSpawn], samples: [U64:U64]) -> TraceReceiptSection? Never! {
    // Each task's phase by its runtime id; a spawner's spawn came before
    // its own.
    phase := [U64:String]{}
    loop task in rowed.keys() -> phase[task] = named.get(task) ?? ""
    loop spawn in spawns {
        phase[spawn.task] = named.get(spawn.task) ?? phase.get(spawn.parent) ?? ""
    }
    if phase.len() == 0 -> return None
    totals := [JetCLIPerfTaskPhase]{}
    at := [String:Int]{}
    loop task in phase.keys() {
        name: phase[task]
        if !at.has_key(name) {
            at[name] = totals.len()
            totals.push(JetCLIPerfTaskPhase{name: "{name}", tasks: 0, samples: U64{0}, folded: 0, folded_samples: U64{0}})
        }
        index: at[name]
        took: samples.get(task) ?? U64{0}
        totals[index].tasks += 1
        totals[index].samples += took
        if !rowed.has_key(task) {
            totals[index].folded += 1
            totals[index].folded_samples += took
        }
    }
    unattributed := U64{0}
    loop task in samples.keys() {
        if !phase.has_key(task) -> unattributed += samples[task]
    }
    totals.sort_by(fn(left: JetCLIPerfTaskPhase, right: JetCLIPerfTaskPhase) { (right.samples <=> left.samples).then(left.name <=> right.name) })
    phases := [CanonicalJSON]{}
    loop total in totals {
        phases.push(
            CanonicalJSON.Object(
                [CanonicalJSONField]{
                    {key: "folded", value: CanonicalJSON.Integer("{total.folded}")},
                    {key: "folded_samples", value: CanonicalJSON.Integer("{total.folded_samples}")},
                    {key: "name", value: if total.name == "" -> CanonicalJSON.Null else -> CanonicalJSON.String("{total.name}")},
                    {key: "samples", value: CanonicalJSON.Integer("{total.samples}")},
                    {key: "tasks", value: CanonicalJSON.Integer("{total.tasks}")},
                },
            ),
        )
    }
    value: CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "count", value: CanonicalJSON.Integer("{phase.len()}")},
            {key: "coverage", value: CanonicalJSON.String(if unattributed == (U64{0}) -> "complete" else -> "partial")},
            {key: "phases", value: CanonicalJSON.Array(phases)},
            {key: "rows", value: CanonicalJSON.Integer("{rowed.len()}")},
            {key: "unattributed_samples", value: CanonicalJSON.Integer("{unattributed}")},
        },
    )
    Val(TraceReceiptSection{name: "tasks", type_name: "JetPerfTasks", value: value, digest: canonical_json_sha256(value)})
}

// The task of the program whose act at a connection's other end ended a
// socket's wait (jet_cli_perf_socket_cause): the task by its runtime id and
// the innermost line of the checked source on the act's stack.
JetCLIPerfCause: struct {
    task: U64,
    line: U64?,
}

// Whether a socket's address `address` (jet_cli_perf_io_target) names an
// endpoint: an unbound or unnamed Unix socket's is `socket`, and an address
// the kernel gave none of is empty.
jet_cli_perf_socket_named: fn(address: String) -> Bool Never! {
    address.len() > 0 && address != "socket"
}

// The last act, by its start, of a task of the program other than `wait`'s
// that may have ended the socket's wait `wait`, of `transfers`: for a
// connected socket's, a read or write at the connection's other end (whose
// peer is `wait.local` and own address `wait.peer`) begun by the wait's
// end; for a listener's, which has no peer, a connect whose peer reaches
// the listener's address (jet_cli_perf_socket_reaches), begun by
// JET_CLI_PERF_WAKE_LEAD_NS after the wait's end, as a wake may land just
// before a wait parks. Either ended at or after that long before the wait
// began. None for any other wait, and when an address names no endpoint.
// The runtime records each connect that succeeds, whether or not it had
// to wait, so a loopback connect the poller found ready at once still
// names its task.
jet_cli_perf_socket_cause: fn(transfers: [JetCLIPerfIO], wait: JetCLIPerfWait) -> JetCLIPerfCause? Never! {
    listener: wait.peer.len() == 0
    if wait.class != JET_CLI_PERF_OBJECT_SOCKET || !jet_cli_perf_socket_named(wait.local) || (!listener && !jet_cli_perf_socket_named(wait.peer)) {
        return None
    }
    floor: wait.start_ns - JET_CLI_PERF_WAKE_LEAD_NS
    lead: if listener -> JET_CLI_PERF_WAKE_LEAD_NS else -> 0
    found := JetCLIPerfCause?{None}
    // The monotonic clock counts from boot, so every act begins after 0.
    begun := 0
    loop transfer in transfers {
        if transfer.class != JET_CLI_PERF_TARGET_SOCKET || transfer.task == (U64{0}) || transfer.task == wait.task {
            next
        }
        if (transfer.operation == JET_CLI_PERF_IO_CONNECT) != listener -> next
        // A connect to the listener's address, or an act at the
        // connection's other end.
        reached: if listener -> jet_cli_perf_socket_named(transfer.target) && jet_cli_perf_socket_reaches(transfer.target, wait.local) else -> transfer.target == wait.local && transfer.local == wait.peer
        if !reached -> next
        if transfer.start_ns - lead > wait.end_ns || transfer.end_ns < floor || transfer.start_ns < begun {
            next
        }
        begun = transfer.start_ns
        found = Val(JetCLIPerfCause{task: transfer.task, line: if transfer.frames.len() > 0 -> Val(transfer.frames[0].line) else -> U64?{None}})
    }
    found
}

// Whether a connect to `address` reaches the listener bound to `bound`: the
// same address, or the same port when the listener's host is any
// (`0.0.0.0`, `[::]`).
jet_cli_perf_socket_reaches: fn(address: String, bound: String) -> Bool Never! {
    if address == bound -> return true
    // The listener's `:port`.
    if bound.starts_with("0.0.0.0:") -> return address.ends_with(bound.slice(7..<bound.len()))
    if bound.starts_with("[::]:") -> return address.ends_with(bound.slice(4..<bound.len()))
    false
}

// Each file or network transfer the program recorded (`transfers`, taken
// from the samples) as an I/O row of `capture`, timed from `origin_ns` as
// the waits are: its task by the id its trace row carries
// (`capture.task_ids`; none for a transfer outside every observed task),
// the bytes it moved or the errno that refused it, its target, and the
// functions and lines of `source` on its stack. Each transfer's target and
// stack move into its row.
jet_cli_perf_io_read: fn(capture: &JetCLIPerfCapture, transfers: &&[JetCLIPerfIO], source: String, origin_ns: Int) Never! {
    pending := transfers
    pending.reverse()
    loop pending.len() > 0 {
        transfer: pending.pop() ?? break
        if transfer.operation == JET_CLI_PERF_IO_CONNECT -> next
        if (U64{capture.io.len()}) >= TRACE_IO_ROW_LIMIT {
            capture.policy.io_rows_truncated = true
            break
        }
        operation: if transfer.operation == JET_CLI_PERF_IO_WRITE -> "write" else -> "read"
        task_id: if capture.task_ids.has_key(transfer.task) -> Val(capture.task_ids[transfer.task]) else -> U64?{None}
        bytes: if transfer.result > 0 -> checked(U64{transfer.result}) ?? U64{0} else -> U64{0}
        error: if transfer.result < 0 -> checked(U64{0 - transfer.result}) else -> U64?{None}
        symbol: JetSymbolRef{path: source, name: "{operation} {transfer.target}"}
        capture.io.push(TraceIO{bytes: bytes, end_ns: jet_cli_perf_since(transfer.end_ns, origin_ns), error: error, kind: if transfer.class == JET_CLI_PERF_TARGET_SOCKET -> "network" else -> "file", operation: operation, stack: transfer.frames.move(), start_ns: jet_cli_perf_since(transfer.start_ns, origin_ns), symbol: symbol, target: transfer.target.move(), task_id: task_id})
    }
}

// The text of a transfer's target from its record's `bytes`, by its
// `class` (a JET_CLI_PERF_TARGET_*): a file's path, or a socket's peer, its
// sockaddr: an IPv4 or IPv6 host and port, or a Unix socket's path, `@name`
// for an abstract one. A peer the kernel named by no address is `socket`.
jet_cli_perf_io_target: fn(class: Int, bytes: [U8]) -> String Never! {
    if class == JET_CLI_PERF_TARGET_PATH {
        path: String.from_bytes(bytes) ?? ""
        return if path.len() == 0 -> "file" else -> path
    }
    if class != JET_CLI_PERF_TARGET_SOCKET -> return "descriptor"
    if bytes.len() < 4 -> return "socket"
    family: Int{bytes[0]} | (Int{bytes[1]} << 8)
    port: (Int{bytes[2]} << 8) | Int{bytes[3]}
    if family == 2 && bytes.len() >= 8 {
        return "{Int{bytes[4]}}.{Int{bytes[5]}}.{Int{bytes[6]}}.{Int{bytes[7]}}:{port}"
    }
    if family == 10 && bytes.len() >= 24 {
        // The host's eight big-endian words, which core.net.ip spells
        // canonically (RFC 5952), an IPv4-mapped host as its last two words.
        words: loop k in 0..<8 -> (Int{bytes[8 + 2 * k]} << 8) | Int{bytes[9 + 2 * k]}
        return "[{perf_ip.ipv6_compressed(perf_ip.IPv6{words: words})}]:{port}"
    }
    if family != 1 -> return "socket"
    // A Unix socket's path runs from byte 2 to its NUL; an abstract one's
    // name follows a leading NUL.
    if bytes[2] == (U8{0}) {
        name: String.from_bytes(loop k in 3..<bytes.len() -> bytes[k]) ?? ""
        return if name.len() == 0 -> "socket" else -> "@{name}"
    }
    end := 2
    loop end < bytes.len() && bytes[end] != (U8{0}) -> end += 1
    String.from_bytes(loop k in 2..<end -> bytes[k]) ?? "socket"
}

// How long before a wait's start a wake may end it: a wake that lands
// after the waiter registered and before it parked (its park then returns
// at once).
JET_CLI_PERF_WAKE_LEAD_NS: 1000000

// The last of `wakes` that `order` lists, earliest first, at or before `end`
// and not before `floor`, by its place in `wakes`; -1 for none.
jet_cli_perf_wait_waker: fn(wakes: [JetCLIPerfWake], order: [Int], floor: Int, end: Int) -> Int Never! {
    low := 0
    high := order.len()
    loop low < high {
        middle: (low + high) /% 2
        if wakes[order[middle]].at_ns <= end -> low = middle + 1 else -> high = middle
    }
    if low == 0 || wakes[order[low - 1]].at_ns < floor -> return -1
    order[low - 1]
}

// `at_ns` less `origin_ns`, both on the monotonic clock; 0 for a moment
// before the origin.
jet_cli_perf_since: fn(at_ns: Int, origin_ns: Int) -> U64 Never! {
    if at_ns <= origin_ns -> return U64{0}
    checked(U64{at_ns - origin_ns}) ?? U64{0}
}
