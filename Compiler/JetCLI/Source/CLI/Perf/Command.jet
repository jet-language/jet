// `jet perf run|test|view|compare|export`: every reader verifies the one
// `.jettrace` artifact before it projects anything, and none of them measures
// or rewrites it. Export's projections are Export.jet; the run/test session is
// Session.jet.
use {
    cli_files: core.files
    jet_driver.[JetDriverVerbOutput, JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USAGE, JET_DRIVER_EXIT_USER_ERROR, JetDriverRunReceiptSection, jet_driver_run_receipt_section_new]
    jet_foundation.[
        CanonicalJSON,
        CanonicalJSONField,
        JET_CLI_COMMANDS,
        JetTraceError,
        TRACE_COUNTERS,
        TRACE_SCHEMA,
        TRACE_VERSION,
        artifact_extension,
        canonical_json_bytes,
        diagnostic_theme_paint,
        jettrace_array,
        jettrace_error,
        jettrace_object_view,
        trace_counter_key,
        trace_counter_name,
        trace_id,
        trace_receipt_section_from_json,
        verify_jettrace,
    ]
}

// `cli_diagnostic_copy("E2102")`'s fix line.
JET_CLI_PERF_FIX: "correct the named flag, or run `jet help` to see the flags"

// `jet perf <action> …`: `argv` starts at `perf`. The front door answers the
// group's help and refuses an unknown or unbuilt action before this runs.
jet_cli_perf: fn(argv: [String], color: Bool) -[FS, Env, Exec, Time]> JetDriverVerbOutput Never! {
    action: argv[1]
    rest := [String]{}
    help := false
    quiet := false
    passthrough := false
    // The front door already read the output flags; words after `--` are the
    // program's, never perf's.
    loop word in jet_cli_tail(argv, 2) {
        if !passthrough {
            if word == "--" -> passthrough = true
            if jet_cli_is_help_flag(word) -> help = true
            if word == "--quiet" -> quiet = true
            if word == "--quiet" || word == "--color" || word == "--no-color" || word.starts_with("--color=") {
                next
            }
        }
        rest.push(word)
    }
    if help && jet_cli_nested_command("perf", action) == .Val(found) {
        spec: JET_CLI_COMMANDS[found.group].actions[found.action]
        return JetDriverVerbOutput{stdout: "jet perf {spec.name} — {spec.summary}\nUsage: {spec.usage}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
    if action == {
        "run" | "test" -> jet_cli_perf_session(action, rest, quiet, color)
        "attach" -> jet_cli_perf_attach(rest, quiet, color)
        "view" -> jet_cli_perf_view(rest, color)
        "compare" -> jet_cli_perf_compare(rest, color)
        "export" -> jet_cli_perf_export(rest, color)
        else -> jet_cli_perf_error("unknown `jet perf` action `{action}`", "run `jet perf --help` to see its actions", color)
    }
}

// `perf_error_with_fix`: one E2102 usage report.
jet_cli_perf_error: fn(what: String, fix: String, color: Bool) -> JetDriverVerbOutput Never! {
    JetDriverVerbOutput{stdout: "", stderr: jet_cli_report("E2102", what, jet_cli_why("E2102"), fix, color), exit_code: JET_DRIVER_EXIT_USAGE}
}

// `render_perf_json`: the status envelope with the projection as its `perf`
// field. Canonical JSON escapes exactly what a status string escapes, so the
// canonical bytes are the field's JSON text.
jet_cli_perf_json: fn(action: String, value: CanonicalJSON) -> String Never! {
    bytes: canonical_json_bytes(value)
    text: String.from_bytes(bytes.slice(0, bytes.len() - 1)) ?? ""
    "{jet_cli_status_render(action, true, [JetCLIStatusField]{jet_cli_status_field("perf", JetCLIStatusValue.Float{text: text})})}\n"
}

// `read_verified`: a `.jettrace` path, read and verified.
jet_cli_perf_read: fn(path: String) -[FS]> CanonicalJSON JetTraceError! {
    extension: artifact_extension()
    if !path.ends_with(extension) {
        return Err(jettrace_error("trace path must end with {extension}"))
    }
    bytes: cli_files.read_bytes(path) ?? return Err(jettrace_error("cannot read {path}: {jet_cli_io_error_text(err)}"))
    // The report names the file: a verification failure alone does not say
    // which trace it rejected.
    trace: verify_jettrace(bytes) ?? return Err(jettrace_error("`{path}` is not a valid trace: {err.message}"))
    Ok(trace)
}

// `view`: text, `--json` or `--html`, with `--frames=jet|all`, of a
// `.jettrace`, or text or `--html` of a pprof or OTLP/JSON export of one
// (PeerExport.jet jet_cli_perf_import).
jet_cli_perf_view: fn(args: [String], color: Bool) -[FS]> JetDriverVerbOutput Never! {
    extension: artifact_extension()
    path := String?{None}
    mode := "text"
    frames := "jet"
    skip := false
    loop (index, arg) in args {
        if skip {
            skip = false
            next
        }
        if arg == "--json" {
            mode = "json"
            next
        }
        if arg == "--html" {
            mode = "html"
            next
        }
        if arg.starts_with("--frames=") {
            value: arg.slice(9..<arg.len())
            if value != "jet" && value != "all" {
                return jet_cli_perf_error("`--frames` accepts only `jet` or `all`", JET_CLI_PERF_FIX, color)
            }
            frames = value
            next
        }
        if arg == "--frames" {
            if index + 1 >= args.len() {
                return jet_cli_perf_error("`--frames` needs `jet` or `all`", JET_CLI_PERF_FIX, color)
            }
            if args[index + 1] != "jet" && args[index + 1] != "all" {
                return jet_cli_perf_error("`--frames` accepts only `jet` or `all`", JET_CLI_PERF_FIX, color)
            }
            frames = if args[index + 1] == "all" -> "all" else -> "jet"
            skip = true
            next
        }
        if arg.starts_with("-") {
            return jet_cli_perf_error("unknown `jet perf view` flag `{arg}`", "run `jet perf view <path{extension}|path.pb.gz|path.json> [--json|--html] [--frames=jet|all]`", color)
        }
        if path != None {
            return jet_cli_perf_error("`jet perf view` takes one trace path", JET_CLI_PERF_FIX, color)
        }
        // copy: the argument list keeps its word; the trace path owns its own.
        path = Val(arg.copy())
    }
    shown: path ?? return jet_cli_perf_error("`jet perf view` needs a {extension} path", JET_CLI_PERF_FIX, color)
    if !shown.ends_with(extension) {
        if mode == "json" {
            return jet_cli_perf_error("`--json` views a {extension} trace only", "view a pprof or OTLP export as text or with `--html`", color)
        }
        imported: jet_cli_perf_import(shown) ?? return jet_cli_perf_error(err.message, JET_CLI_PERF_FIX, color)
        flame: jet_cli_perf_flame_profile(jet_cli_perf_total_rows(imported.totals))
        table: jet_cli_perf_line_table(imported.totals)
        if mode == "html" {
            return JetDriverVerbOutput{stdout: jet_cli_perf_view_html(shown, frames, flame, imported.timeline, table), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
        }
        out := "{diagnostic_theme_paint(color, "1", "export")} {imported.format} {shown}\n"
        loop note in imported.notes -> out = "{out}{note}\n"
        return JetDriverVerbOutput{stdout: "{out}{jet_cli_perf_view_sections(flame, imported.timeline, table, color)}", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
    trace: jet_cli_perf_read(shown) ?? return jet_cli_perf_error(err.message, JET_CLI_PERF_FIX, color)
    flame: jet_cli_perf_flame(trace)
    timeline: jet_cli_perf_timeline(trace)
    table: jet_cli_perf_line_table(jet_cli_perf_line_totals(trace))
    if mode == "html" {
        return JetDriverVerbOutput{stdout: jet_cli_perf_view_html(trace_id(trace) ?? "unknown", frames, flame, timeline, table), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
    if mode == "text" {
        return JetDriverVerbOutput{stdout: jet_cli_perf_view_text(trace, frames, flame, timeline, table, color), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
    view: CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "flamegraph", value: jet_cli_perf_strings(flame)},
            {key: "frames", value: CanonicalJSON.String(frames)},
            {key: "kind", value: CanonicalJSON.String("jet.trace.view")},
            {key: "schema", value: CanonicalJSON.String(TRACE_SCHEMA)},
            {key: "timeline", value: jet_cli_perf_strings(timeline)},
            {key: "trace", value: trace},
            {key: "version", value: CanonicalJSON.Integer("{TRACE_VERSION}")},
        },
    )
    JetDriverVerbOutput{stdout: jet_cli_perf_json("perf.view", view), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

jet_cli_perf_strings: fn(lines: [String]) -> CanonicalJSON Never! {
    // copy: the rendered lines also feed the text and HTML views; the array owns its own.
    CanonicalJSON.Array(loop line in lines -> CanonicalJSON.String(line.copy()))
}

// `render_view_text`.
jet_cli_perf_view_text: fn(trace: CanonicalJSON, frames: String, flame: [String], timeline: [String], table: [String], color: Bool) -> String Never! {
    out := "{diagnostic_theme_paint(color, "1", "schema")} {TRACE_SCHEMA} v{TRACE_VERSION}\n"
    out = "{out}{diagnostic_theme_paint(color, "1", "trace")} {trace_id(trace) ?? "unknown"}\n"
    out = "{out}{diagnostic_theme_paint(color, "1", "command")} {jet_cli_perf_content_text(trace, "command") ?? "unknown"}\n"
    out = "{out}{diagnostic_theme_paint(color, "1", "frames")} {frames}\n"
    if jet_cli_perf_first_sample(trace) == .Val(sample) {
        out = "{out}Sample {sample.domain} {sample.ns}ns · {sample.symbol}\n"
    }
    summaries: [String?]{
        jet_cli_perf_profile_summary(trace),
        jet_cli_perf_allocation_summary(trace),
        jet_cli_perf_browser_line(trace),
        jet_cli_perf_task_summary(trace),
        jet_cli_perf_lock_summary(trace),
        jet_cli_perf_io_summary(trace),
        jet_cli_perf_native_summary(trace),
        jet_cli_perf_span_summary(trace),
        jet_cli_perf_log_span_summary(trace),
        jet_cli_perf_wait_summary(trace),
    }
    loop summary in summaries {
        if summary == .Val(line) -> out = "{out}{line}\n"
    }
    loop line in jet_cli_perf_counter_lines(trace) -> out = "{out}{line}\n"
    loop line in jet_cli_perf_memory_lines(trace) -> out = "{out}{line}\n"
    loop line in jet_cli_perf_off_cpu_lines(trace) -> out = "{out}{line}\n"
    loop line in jet_cli_perf_game_lines(trace) -> out = "{out}{line}\n"
    loop line in jet_cli_perf_receipt_lines(trace) -> out = "{out}{line}\n"
    if frames == "all" {
        out = "{out}generated-frames: none retained in .jettrace (hidden unless captured under --frames=all)\n"
    }
    "{out}{jet_cli_perf_view_sections(flame, timeline, table, color)}"
}

// The flame graph, the timeline and the per-line table, each under its
// heading when it has a line.
jet_cli_perf_view_sections: fn(flame: [String], timeline: [String], table: [String], color: Bool) -> String Never! {
    out := ""
    if flame.len() > 0 {
        out = "{out}{diagnostic_theme_paint(color, "1", "flamegraph")}\n"
        loop line in flame -> out = "{out}{line}\n"
    }
    if timeline.len() > 0 {
        out = "{out}{diagnostic_theme_paint(color, "1", "timeline")}\n"
        loop line in timeline -> out = "{out}{line}\n"
    }
    if table.len() > 0 {
        out = "{out}{diagnostic_theme_paint(color, "1", "per-line")}\n"
        loop line in table -> out = "{out}{line}\n"
    }
    out
}

// `view_html`: one self-contained page, which a browser opens with no other
// file or program.
jet_cli_perf_view_html: fn(id: String, frames: String, flame: [String], timeline: [String], table: [String]) -> String Never! {
    flame_items: loop line in flame -> "<li>{jet_cli_perf_html_escape(line)}</li>"
    timeline_items: loop line in timeline -> "<li>{jet_cli_perf_html_escape(line)}</li>"
    table_items: loop line in table -> "<li>{jet_cli_perf_html_escape(line)}</li>"
    lines: [String]{
        "<!doctype html>",
        "<html lang=\"en\"><head><meta charset=\"utf-8\"><title>jettrace {id}</title>",
        "<style>",
        "body{{font:14px/1.4 ui-monospace,monospace;margin:1.5rem;background:#111;color:#eee}}",
        "h1,h2{{font-weight:600}}",
        ".bar{{display:inline-block;height:10px;background:#6cf;margin-left:.5rem}}",
        "section{{margin:1rem 0}}",
        "</style></head><body>",
        "<h1>jettrace {id}</h1>",
        "<p>schema {TRACE_SCHEMA} v{TRACE_VERSION} · frames={frames}</p>",
        "<section><h2>flamegraph</h2><ul id=\"flame\">{flame_items.join("")}</ul></section>",
        "<section><h2>timeline</h2><ul id=\"timeline\">{timeline_items.join("")}</ul></section>",
        "<section><h2>per-line</h2><ul id=\"lines\">{table_items.join("")}</ul></section>",
        "<script>",
        "const flame=document.getElementById('flame');",
        "for (const li of flame.querySelectorAll('li')) {{",
        "  const m=li.textContent.match(/#+/);",
        "  if(!m) continue;",
        "  const bar=document.createElement('span');",
        "  bar.className='bar';",
        "  bar.style.width=(m[0].length*4)+'px';",
        "  li.appendChild(bar);",
        "}}",
        "</script>",
        "</body></html>",
    }
    "{lines.join("\n")}\n"
}

jet_cli_perf_html_escape: fn(text: String) -> String Never! {
    text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

// `compare`: two verified traces of one toolchain and machine.
jet_cli_perf_compare: fn(args: [String], color: Bool) -[FS, Env]> JetDriverVerbOutput Never! {
    extension: artifact_extension()
    usage: "run `jet perf compare base{extension} head{extension} [--baseline <name>] [--override-identity]`"
    paths := [String]{}
    override_identity := false
    baseline := String?{None}
    skip := false
    loop (index, arg) in args {
        if skip {
            skip = false
            next
        }
        if arg == "--override-identity" {
            override_identity = true
            next
        }
        if arg.starts_with("--baseline=") {
            baseline = Val(arg.slice(11..<arg.len()))
            next
        }
        if arg == "--baseline" {
            if index + 1 >= args.len() {
                return jet_cli_perf_error("`--baseline` needs a pinned baseline name", JET_CLI_PERF_FIX, color)
            }
            // copy: the argument list keeps its word; the baseline name owns its own.
            baseline = Val(args[index + 1].copy())
            skip = true
            next
        }
        if arg.starts_with("-") {
            return jet_cli_perf_error("unknown `jet perf compare` flag `{arg}`", usage, color)
        }
        // copy: the argument list keeps its word; the path list owns its own.
        paths.push(arg.copy())
    }
    if paths.len() != 2 {
        return jet_cli_perf_error("`jet perf compare` needs two {extension} paths", usage, color)
    }
    base: jet_cli_perf_read(paths[0]) ?? return jet_cli_perf_error("base trace: {err.message}", JET_CLI_PERF_FIX, color)
    head: jet_cli_perf_read(paths[1]) ?? return jet_cli_perf_error("head trace: {err.message}", JET_CLI_PERF_FIX, color)
    same_tool: jet_cli_perf_same(jet_cli_perf_identity(base, "toolchain", "digest"), jet_cli_perf_identity(head, "toolchain", "digest"))
    same_hardware: jet_cli_perf_same(jet_cli_perf_identity(base, "hardware", "fingerprint"), jet_cli_perf_identity(head, "hardware", "fingerprint"))
    mismatch: !same_tool || !same_hardware
    if mismatch && !override_identity {
        part: if !same_tool -> "toolchain" else -> "hardware"
        why: if !same_tool -> "compare requires matching toolchain digests" else -> "compare requires matching hardware fingerprints"
        return JetDriverVerbOutput{stdout: "", stderr: jet_cli_report("E2102", "{part} identity mismatch between traces", why, "recapture both traces on the same machine/toolchain, or pass `--override-identity`", color), exit_code: JET_DRIVER_EXIT_USER_ERROR}
    }
    if baseline == .Val(name) {
        if jet_cli_perf_baseline_refusal(name) == .Val(message) {
            return JetDriverVerbOutput{stdout: "", stderr: jet_cli_report("E2102", message, "`--baseline` selects a pinned baseline name", "create the baseline with `jet budget update --baseline {name}`, or omit `--baseline`", color), exit_code: JET_DRIVER_EXIT_USER_ERROR}
        }
    }
    base_wall: jet_cli_perf_sample_duration(base, "wall")
    head_wall: jet_cli_perf_sample_duration(head, "wall")
    deltas := [String]{}
    if base_wall == .Val(before) && head_wall == .Val(after) {
        deltas.push("wall {before}->{after} ns")
    }
    if jet_cli_perf_sample_duration(base, "cpu") == .Val(before) && jet_cli_perf_sample_duration(head, "cpu") == .Val(after) {
        deltas.push("cpu {before}->{after} ns")
    }
    if jet_cli_perf_allocation_bytes(base) == .Val(before) && jet_cli_perf_allocation_bytes(head) == .Val(after) {
        deltas.push("alloc {before}->{after} B")
    }
    receipt_deltas: jet_cli_perf_receipt_deltas(base, head) ?? return jet_cli_perf_error("receipt sections: {err.message}", JET_CLI_PERF_FIX, color)
    // #241 budgets: wall AbsoluteFrom/RelativeTo against the pinned base trace.
    budget := "budgets: no comparable wall samples for #241 RelativeTo evaluation"
    if base_wall == .Val(base_ns) && head_wall == .Val(head_ns) && base_ns > 0 {
        regression: if head_ns > base_ns -> head_ns - base_ns else -> 0
        named: if baseline == .Val(name) -> name else -> "trace-baseline"
        budget = "budgets: wall RelativeTo({named}) regression={regression * 10000 /% base_ns}bp · base={base_ns}ns head={head_ns}ns"
    }
    override_note: if mismatch && override_identity -> " · identity override" else -> ""
    baseline_note: if baseline == .Val(name) -> " · baseline {name}" else -> ""
    out := "Compare OK · schema {TRACE_SCHEMA} v{TRACE_VERSION} · base {trace_id(base) ?? "unknown"} · head {trace_id(head) ?? "unknown"}{override_note}{baseline_note}\n"
    if deltas.len() > 0 -> out = "{out}Deltas: {deltas.join(" · ")}\n"
    if receipt_deltas.len() > 0 -> out = "{out}Receipt deltas: {receipt_deltas.join(" · ")}\n"
    JetDriverVerbOutput{stdout: "{out}{budget}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

jet_cli_perf_same: fn(left: String?, right: String?) -> Bool Never! {
    if left == .Val(text) {
        if right == .Val(other) -> return text == other
        return false
    }
    right == None
}

// `require_pinned_baseline`: why `name` can't select a pinned baseline, if it can't.
jet_cli_perf_baseline_refusal: fn(name: String) -[FS, Env]> String? Never! {
    pinned := name != "" && !name.contains(".") && !name.contains("\\") && !name.starts_with("/")
    loop part in name.split("/") {
        if part == "" || part == "." || part == ".." -> pinned = false
    }
    loop byte in name.bytes() {
        code: Int{byte}
        if !((code >= 97 && code <= 122) || (code >= 48 && code <= 57) || code == 45 || code == 47) {
            pinned = false
        }
    }
    if !pinned -> return Val("baseline name `{name}` is not a pinned BaselineName")
    path: "{jet_cli_selected_root_or_cwd()}/.jet/perf/baselines/names/{name}.json"
    if !cli_files.is_file(path) -> return Val("pinned baseline `{name}` is missing at {path}")
    None
}

// `compare_receipt_sections`: the field changes between the traces' recorded
// receipt sections.
jet_cli_perf_receipt_deltas: fn(base: CanonicalJSON, head: CanonicalJSON) -> [String] JetCLIReadError! {
    before: jet_cli_perf_receipt_sections(base)
    after: jet_cli_perf_receipt_sections(head)
    diffs: jet_cli_receipt_diff_sections(before, after)
    Ok(loop diff in diffs -> jet_cli_receipt_field_diff_render(diff))
}

// `receipt_sections_for_compare`.
jet_cli_perf_receipt_sections: fn(trace: CanonicalJSON) -> [JetDriverRunReceiptSection] JetCLIReadError! {
    items: jet_cli_perf_rows(trace, "receipt_sections") ?? return Err(jet_cli_read_error("trace content.receipt_sections is missing or not an array"))
    sections := [JetDriverRunReceiptSection]{}
    loop index in 0..<items.len() {
        section: trace_receipt_section_from_json(items[index]) ?? return Err(jet_cli_read_error("content.receipt_sections[{index}]: {err.message}"))
        recorded: jet_driver_run_receipt_section_new(section.name, section.type_name, canonical_json_bytes(section.value)) ?? return Err(jet_cli_read_error("content.receipt_sections[{index}]: {err.message}"))
        sections.push(recorded)
    }
    Ok(sections)
}

// `receipt <name> <value>` for each receipt section the trace records, the
// value as its canonical JSON.
jet_cli_perf_receipt_lines: fn(trace: CanonicalJSON) -> [String] Never! {
    items: jet_cli_perf_rows(trace, "receipt_sections") ?? return [String]{}
    lines := [String]{}
    loop item in items {
        section: trace_receipt_section_from_json(item) ?? next
        bytes: canonical_json_bytes(section.value)
        text: String.from_bytes(bytes.slice(0, bytes.len() - 1)) ?? next
        lines.push("receipt {section.name} {text}")
    }
    lines
}

// `counter <name> captured period=<events>` or `counter <name> unavailable
// errno=<errno>` for each counter of a profile the memory lens took.
jet_cli_perf_counter_lines: fn(trace: CanonicalJSON) -> [String] Never! {
    profile: jet_cli_perf_profile(trace) ?? return [String]{}
    at: jet_cli_perf_key(profile, "counters") ?? return [String]{}
    items: jettrace_array(profile[at].value, "content.profile.counters") ?? return [String]{}
    lines := [String]{}
    loop item in items {
        name: jet_cli_perf_member_text(item, "name") ?? next
        status: jet_cli_perf_member_text(item, "status") ?? next
        detail: if jet_cli_perf_member_integer(item, "period") == .Val(period) -> "period={period}" else -> "errno={jet_cli_perf_member_integer(item, "errno") ?? "unknown"}"
        lines.push("counter {name} {status} {detail}")
    }
    lines
}

// One source line of a profile the memory lens took: its function, and its
// sampled count of each of TRACE_COUNTERS (None for a counter the profile
// did not capture).
JetCLIPerfMemoryLine: struct {
    path: String,
    line: Int,
    function: String,
    events: [Int?],
}

// The memory table of a profile the memory lens took, which lists its
// counters: each function and source line that counted events, where its
// loads missed. `l1d_misses` are loads that left the L1D cache,
// `llc_misses` the ones the last-level cache missed too, served from RAM,
// and `page_faults` the points that fell to the page cache or disk. The
// lines with the most RAM loads come first, then the most L1D misses; at
// most 16 lines.
jet_cli_perf_memory_lines: fn(trace: CanonicalJSON) -> [String] Never! {
    profile: jet_cli_perf_profile(trace) ?? return [String]{}
    counters_at: jet_cli_perf_key(profile, "counters") ?? return [String]{}
    counters: jettrace_array(profile[counters_at].value, "content.profile.counters") ?? return [String]{}
    if counters.len() == 0 -> return [String]{}
    rows: jet_cli_perf_profile_rows(trace) ?? return [String]{}
    found := [JetCLIPerfMemoryLine]{}
    loop row in rows {
        line: jet_cli_perf_row_line(row) ?? next
        fields: jettrace_object_view(row, "jettrace row") ?? next
        at: jet_cli_perf_key(fields, "symbol") ?? next
        symbol: jettrace_object_view(fields[at].value, "symbol") ?? next
        events: loop counter in TRACE_COUNTERS -> jet_cli_perf_member_number(row, trace_counter_key(counter))
        counted := false
        loop count in events {
            if (count ?? 0) > 0 -> counted = true
        }
        if !counted -> next
        found.push(JetCLIPerfMemoryLine{path: jet_cli_perf_field_text(symbol, "path") ?? next, line: line, function: jet_cli_perf_field_text(symbol, "name") ?? next, events: events})
    }
    // `events` is in TRACE_COUNTERS order: [1] is llc_misses, [0] l1d_misses.
    found.sort_by(fn(left: JetCLIPerfMemoryLine, right: JetCLIPerfMemoryLine) { ((right.events[1] ?? 0) <=> (left.events[1] ?? 0)).then((right.events[0] ?? 0) <=> (left.events[0] ?? 0)).then(left.path <=> right.path).then(left.line <=> right.line) })
    lines := [String]{"memory by line: l1d_misses left L1D, llc_misses were served from RAM, page_faults fell to the page cache or disk"}
    shown: if found.len() > 16 -> 16 else -> found.len()
    loop index in 0..<shown {
        item: found[index]
        counts := ""
        loop (at, counter) in TRACE_COUNTERS {
            count: if item.events[at] == .Val(value) -> "{value}" else -> "unavailable"
            counts = "{counts} {trace_counter_name(counter)}={count}"
        }
        lines.push("  {item.path}:{item.line} {item.function}{counts}")
    }
    lines
}

// `sample_duration`: the first `domain` sample's duration.
jet_cli_perf_sample_duration: fn(trace: CanonicalJSON, domain: String) -> Int? Never! {
    items: jet_cli_perf_rows(trace, "samples") ?? return None
    loop item in items {
        if (jet_cli_perf_member_text(item, "domain") ?? "") != domain -> next
        digits: jet_cli_perf_member_integer(item, "duration_ns") ?? next
        number: Int.parse(digits) ?? return None
        return Val(number)
    }
    None
}

// `allocation_bytes`: the first allocation row's bytes.
jet_cli_perf_allocation_bytes: fn(trace: CanonicalJSON) -> Int? Never! {
    items: jet_cli_perf_rows(trace, "allocations") ?? return None
    if items.len() == 0 -> return None
    digits: jet_cli_perf_member_integer(items[0], "bytes") ?? return None
    number: Int.parse(digits) ?? return None
    Val(number)
}

// ---------------------------------------------------------------------------
// Reading a verified trace: views into it, never copies of its rows.

// The index of `key` among an object's fields.
jet_cli_perf_key: fn(fields: View<CanonicalJSONField>, key: String) -> Int? Never! {
    loop index in 0..<fields.len() {
        if fields[index].key == key -> return Val(index)
    }
    None
}

// `content_object`.
jet_cli_perf_content: fn(trace: CanonicalJSON) -> View<CanonicalJSONField> JetTraceError! from trace {
    top: jettrace_object_view(trace, "jettrace")
    at: jet_cli_perf_key(top, "content") ?? return Err(jettrace_error("jettrace has no content"))
    jettrace_object_view(top[at].value, "content")
}

// `content_array`.
jet_cli_perf_rows: fn(trace: CanonicalJSON, key: String) -> View<CanonicalJSON> JetTraceError! from trace {
    content: jet_cli_perf_content(trace)
    at: jet_cli_perf_key(content, key) ?? return Err(jettrace_error("content has no {key}"))
    jettrace_array(content[at].value, "content.{key}")
}

// `content.profile`.
jet_cli_perf_profile: fn(trace: CanonicalJSON) -> View<CanonicalJSONField> JetTraceError! from trace {
    content: jet_cli_perf_content(trace)
    at: jet_cli_perf_key(content, "profile") ?? return Err(jettrace_error("content has no profile"))
    jettrace_object_view(content[at].value, "content.profile")
}

// `content.profile.rows`.
jet_cli_perf_profile_rows: fn(trace: CanonicalJSON) -> View<CanonicalJSON> JetTraceError! from trace {
    profile: jet_cli_perf_profile(trace)
    at: jet_cli_perf_key(profile, "rows") ?? return Err(jettrace_error("content.profile has no rows"))
    jettrace_array(profile[at].value, "content.profile.rows")
}

// The text field `key` of `fields`.
jet_cli_perf_field_text: fn(fields: View<CanonicalJSONField>, key: String) -> String? Never! {
    at: jet_cli_perf_key(fields, key) ?? return None
    // copy: the text stays in the trace; the caller's line owns its own.
    if fields[at].value == .String(text) -> return Val(text.copy())
    None
}

// The integer field `key` of `fields`, as its canonical digits.
jet_cli_perf_field_integer: fn(fields: View<CanonicalJSONField>, key: String) -> String? Never! {
    at: jet_cli_perf_key(fields, key) ?? return None
    // copy: the digits stay in the trace; the caller's line owns its own.
    if fields[at].value == .Integer(digits) -> return Val(digits.copy())
    None
}

// The text member `key` of the object `value`.
jet_cli_perf_member_text: fn(value: CanonicalJSON, key: String) -> String? Never! {
    fields: jettrace_object_view(value, "jettrace row") ?? return None
    jet_cli_perf_field_text(fields, key)
}

// The integer member `key` of the object `value`, as its canonical digits.
jet_cli_perf_member_integer: fn(value: CanonicalJSON, key: String) -> String? Never! {
    fields: jettrace_object_view(value, "jettrace row") ?? return None
    jet_cli_perf_field_integer(fields, key)
}

// The integer member `key` of the object `value`, as a number.
jet_cli_perf_member_number: fn(value: CanonicalJSON, key: String) -> Int? Never! {
    digits: jet_cli_perf_member_integer(value, key) ?? return None
    number: Int.parse(digits) ?? return None
    Val(number)
}

// `symbol_label` of the object `value`'s `symbol` member: `path#name`.
jet_cli_perf_member_symbol: fn(value: CanonicalJSON) -> String? Never! {
    fields: jettrace_object_view(value, "jettrace row") ?? return None
    at: jet_cli_perf_key(fields, "symbol") ?? return None
    jet_cli_perf_symbol(fields[at].value)
}

// `symbol_label`.
jet_cli_perf_symbol: fn(value: CanonicalJSON) -> String? Never! {
    fields: jettrace_object_view(value, "symbol") ?? return None
    path: jet_cli_perf_field_text(fields, "path") ?? return None
    name: jet_cli_perf_field_text(fields, "name") ?? return None
    Val("{path}#{name}")
}

// The text `content.<key>`.
jet_cli_perf_content_text: fn(trace: CanonicalJSON, key: String) -> String? Never! {
    content: jet_cli_perf_content(trace) ?? return None
    jet_cli_perf_field_text(content, key)
}

// `toolchain_digest` / `hardware_fingerprint`: the text `content.<object>.<key>`.
jet_cli_perf_identity: fn(trace: CanonicalJSON, object: String, key: String) -> String? Never! {
    content: jet_cli_perf_content(trace) ?? return None
    at: jet_cli_perf_key(content, object) ?? return None
    jet_cli_perf_member_text(content[at].value, key)
}

// ---------------------------------------------------------------------------
// Summaries (`first_sample` … `span_summary`).

JetCLIPerfSample: struct {
    domain: String,
    ns: String,
    symbol: String,
}

JetCLIPerfBrowserSummary: struct {
    count: Int,
    symbol: String,
}

jet_cli_perf_first_sample: fn(trace: CanonicalJSON) -> JetCLIPerfSample? Never! {
    items: jet_cli_perf_rows(trace, "samples") ?? return None
    if items.len() == 0 -> return None
    domain: jet_cli_perf_member_text(items[0], "domain") ?? return None
    ns: jet_cli_perf_member_integer(items[0], "duration_ns") ?? return None
    symbol: jet_cli_perf_member_symbol(items[0]) ?? return None
    Val(JetCLIPerfSample{domain: domain, ns: ns, symbol: symbol})
}

// `profile method=… status=… coverage=… rows=… clocks=… overhead=… window=… run_wall=… run_cpu=…`.
jet_cli_perf_profile_summary: fn(trace: CanonicalJSON) -> String? Never! {
    profile: jet_cli_perf_profile(trace) ?? return None
    status: jet_cli_perf_field_text(profile, "status") ?? return None
    coverage: jet_cli_perf_field_text(profile, "coverage") ?? return None
    method: jet_cli_perf_field_text(profile, "method") ?? return None
    overhead: jet_cli_perf_field_text(profile, "overhead_status") ?? return None
    rows: jet_cli_perf_profile_rows(trace) ?? return None
    clocks := [String]{}
    loop row in rows {
        if jet_cli_perf_member_text(row, "clock") == .Val(clock) {
            if !clocks.contains(clock) -> clocks.push(clock)
        }
    }
    clocks.sort_by(fn(left: String, right: String) { left <=> right })
    clock_list: if clocks.len() == 0 -> "none" else -> clocks.join(",")
    window: jet_cli_perf_field_text(profile, "window_status") ?? return None
    run_wall: if jet_cli_perf_field_integer(profile, "window_wall_ns") == .Val(ns) -> "{ns}ns" else -> "unavailable"
    run_cpu: if jet_cli_perf_field_integer(profile, "window_cpu_ns") == .Val(ns) -> "{ns}ns" else -> "unavailable"
    Val("profile method={method} status={status} coverage={coverage} rows={rows.len()} clocks={clock_list} overhead={overhead} window={window} run_wall={run_wall} run_cpu={run_cpu}")
}

jet_cli_perf_allocation_summary: fn(trace: CanonicalJSON) -> String? Never! {
    items: jet_cli_perf_rows(trace, "allocations") ?? return None
    if items.len() == 0 -> return None
    count: jet_cli_perf_member_integer(items[0], "count") ?? return None
    bytes: jet_cli_perf_member_integer(items[0], "bytes") ?? return None
    symbol: jet_cli_perf_member_symbol(items[0]) ?? return None
    Val("alloc count={count} bytes={bytes} · {symbol}")
}

jet_cli_perf_browser_summary: fn(trace: CanonicalJSON) -> JetCLIPerfBrowserSummary? Never! {
    items: jet_cli_perf_rows(trace, "browser") ?? return None
    if items.len() == 0 -> return None
    symbol: jet_cli_perf_member_symbol(items[0]) ?? return None
    Val(JetCLIPerfBrowserSummary{count: items.len(), symbol: symbol})
}

jet_cli_perf_browser_line: fn(trace: CanonicalJSON) -> String? Never! {
    browser: jet_cli_perf_browser_summary(trace) ?? return None
    Val("browser count={browser.count} · {browser.symbol}")
}

jet_cli_perf_task_summary: fn(trace: CanonicalJSON) -> String? Never! {
    items: jet_cli_perf_rows(trace, "tasks") ?? return None
    if items.len() == 0 -> return None
    children := 0
    symbol := String?{None}
    loop item in items {
        if jet_cli_perf_member_integer(item, "parent") == .Val(parent) {
            if parent != "0" -> children += 1
        }
        if symbol == None -> symbol = jet_cli_perf_member_symbol(item)
    }
    Val("tasks count={items.len()} children={children} · {symbol ?? "?"}")
}

jet_cli_perf_lock_summary: fn(trace: CanonicalJSON) -> String? Never! {
    items: jet_cli_perf_rows(trace, "locks") ?? return None
    if items.len() == 0 -> return None
    waiters := 0
    symbol := String?{None}
    loop item in items {
        if jet_cli_perf_member_integer(item, "send_waiters") != None {
            waiters += jet_cli_perf_member_number(item, "send_waiters") ?? 0
        }
        if jet_cli_perf_member_integer(item, "recv_waiters") != None {
            waiters += jet_cli_perf_member_number(item, "recv_waiters") ?? 0
        }
        if symbol == None -> symbol = jet_cli_perf_member_symbol(item)
    }
    Val("locks count={items.len()} waiters={waiters} · {symbol ?? "?"}")
}

// The file and network transfers (`io` rows): how many, the bytes read and
// written, how many the OS refused, and the first's symbol.
jet_cli_perf_io_summary: fn(trace: CanonicalJSON) -> String? Never! {
    items: jet_cli_perf_rows(trace, "io") ?? return None
    if items.len() == 0 -> return None
    read := 0
    written := 0
    failed := 0
    loop item in items {
        bytes: jet_cli_perf_member_number(item, "bytes") ?? 0
        if {
            (jet_cli_perf_member_text(item, "operation") ?? "") == "write" -> written += bytes
            else -> read += bytes
        }
        if jet_cli_perf_member_integer(item, "error") != None -> failed += 1
    }
    Val("io count={items.len()} read_bytes={read} write_bytes={written} errors={failed} · {jet_cli_perf_member_symbol(items[0]) ?? "?"}")
}

jet_cli_perf_native_summary: fn(trace: CanonicalJSON) -> String? Never! {
    items: jet_cli_perf_rows(trace, "native") ?? return None
    if items.len() == 0 -> return None
    first: items[0]
    status: jet_cli_perf_member_text(first, "status") ?? return None
    target: jet_cli_perf_member_text(first, "target") ?? return None
    symbol: jet_cli_perf_member_symbol(first) ?? "?"
    if status == "captured" {
        duration: jet_cli_perf_member_integer(first, "duration_ns") ?? return None
        observed: jet_cli_perf_member_integer(first, "observed_at_ns") ?? return None
        task: jet_cli_perf_member_integer(first, "task_id") ?? return None
        return Val("native process_cpu={duration}ns observed_at={observed}ns target={target} task={task} · {symbol}")
    }
    if status == "unavailable" {
        reason: jet_cli_perf_member_text(first, "reason") ?? return None
        return Val("native unavailable target={target} reason={reason} · {symbol}")
    }
    None
}

// The task spans (`task_observed` rows): their state, or how many, how many
// have a parent, and the window they cover.
jet_cli_perf_span_summary: fn(trace: CanonicalJSON) -> String? Never! {
    items: jet_cli_perf_rows(trace, "spans") ?? return None
    first := -1
    loop (index, item) in items {
        if (jet_cli_perf_member_text(item, "kind") ?? "") == "task_observed" {
            first = index
            break
        }
    }
    if first < 0 -> return None
    status: jet_cli_perf_member_text(items[first], "status") ?? return None
    symbol: jet_cli_perf_member_symbol(items[first]) ?? "?"
    if status == "unavailable" {
        reason: jet_cli_perf_member_text(items[first], "reason") ?? return None
        return Val("spans unavailable reason={reason} · {symbol}")
    }
    if status != "captured" -> return None
    count := 0
    start := 0
    end := 0
    children := 0
    loop item in items {
        if (jet_cli_perf_member_text(item, "kind") ?? "") != "task_observed" -> next
        item_start: jet_cli_perf_member_number(item, "start_ns") ?? return None
        item_end: jet_cli_perf_member_number(item, "end_ns") ?? return None
        if count == 0 || item_start < start -> start = item_start
        if item_end > end -> end = item_end
        if !jet_cli_perf_member_is_null(item, "parent_task_id") -> children += 1
        count += 1
    }
    Val("spans count={count} children={children} window={start}..{end}ns · {symbol}")
}

// The closed core.log spans (`log_span` rows): how many, the window they
// cover, and the first to close.
jet_cli_perf_log_span_summary: fn(trace: CanonicalJSON) -> String? Never! {
    items: jet_cli_perf_rows(trace, "spans") ?? return None
    count := 0
    start := 0
    end := 0
    symbol := "?"
    loop item in items {
        if (jet_cli_perf_member_text(item, "kind") ?? "") != "log_span" -> next
        item_start: jet_cli_perf_member_number(item, "start_ns") ?? return None
        item_end: jet_cli_perf_member_number(item, "end_ns") ?? return None
        if count == 0 {
            start = item_start
            symbol = jet_cli_perf_member_symbol(item) ?? "?"
        }
        if item_start < start -> start = item_start
        if item_end > end -> end = item_end
        count += 1
    }
    if count == 0 -> return None
    Val("log spans count={count} window={start}..{end}ns · {symbol}")
}

// The tasks' waits (`task_wait` rows): how many, and the longest
// (jet_cli_perf_wait_text).
jet_cli_perf_wait_summary: fn(trace: CanonicalJSON) -> String? Never! {
    items: jet_cli_perf_rows(trace, "spans") ?? return None
    count := 0
    longest := -1
    text := ""
    loop item in items {
        if (jet_cli_perf_member_text(item, "kind") ?? "") != "task_wait" -> next
        count += 1
        start: jet_cli_perf_member_number(item, "start_ns") ?? next
        end: jet_cli_perf_member_number(item, "end_ns") ?? next
        if end - start <= longest -> next
        longest = end - start
        text = jet_cli_perf_wait_text(item)
    }
    if count == 0 -> return None
    if longest < 0 -> return Val("waits count={count}")
    Val("waits count={count} · longest {longest}ns: {text}")
}

// A wait row `item` in words: its task, its name and line, what it waited
// for and what ended it: `task 1 in task join at main.jet:5 for task 2
// spawned at main.jet:4, woken by task 2 at main.jet:11`. A channel's wait
// waits for `channel 3`; a wake outside every task is `the runtime`'s, and
// a wait no wake ended ended at `its timeout`.
jet_cli_perf_wait_text: fn(item: CanonicalJSON) -> String Never! {
    path: jet_cli_perf_member_symbol_text(item, "path") ?? "?"
    text := "task {jet_cli_perf_member_integer(item, "task_id") ?? "?"} in {jet_cli_perf_member_symbol_text(item, "name") ?? "wait"}"
    stack: jet_cli_perf_row_stack(item, "wait_stack")
    if stack.len() > 0 -> text = "{text} at {path}:{stack[0].line}"
    if jet_cli_perf_member_integer(item, "awaited_task_id") == .Val(awaited) {
        text = "{text} for task {awaited}"
        if jet_cli_perf_member_integer(item, "spawn_line") == .Val(line) {
            text = "{text} spawned at {path}:{line}"
        }
    }
    if jet_cli_perf_member_integer(item, "channel_id") == .Val(channel) {
        text = "{text} for channel {channel}"
    }
    waker: jet_cli_perf_member_text(item, "waker") ?? ""
    if waker == "runtime" -> return "{text}, woken by the runtime"
    if waker != "task" -> return "{text}, woken by its timeout"
    text = "{text}, woken by task {jet_cli_perf_member_integer(item, "waker_task_id") ?? "?"}"
    if jet_cli_perf_member_integer(item, "waker_line") == .Val(line) {
        text = "{text} at {path}:{line}"
    }
    text
}

// An I/O row `item` in words: its task, what it moved to or from what, and
// its line: `task 1 wrote 5 bytes to file notes.txt at main.jet:6`, `task 2
// read 4 bytes from peer 127.0.0.1:4000 at main.jet:14`; a refused one
// `task 1 read from file gone.txt at main.jet:9 failed: errno 2`.
jet_cli_perf_io_text: fn(item: CanonicalJSON) -> String Never! {
    path: jet_cli_perf_member_symbol_text(item, "path") ?? "?"
    who: if jet_cli_perf_member_integer(item, "task_id") == .Val(task) -> "task {task} " else -> ""
    writing: (jet_cli_perf_member_text(item, "operation") ?? "") == "write"
    place: if (jet_cli_perf_member_text(item, "kind") ?? "") == "network" -> "peer" else -> "file"
    target: "{place} {jet_cli_perf_member_text(item, "target") ?? "?"}"
    stack: jet_cli_perf_row_stack(item, "stack")
    at: if stack.len() > 0 -> " at {path}:{stack[0].line}" else -> ""
    if jet_cli_perf_member_integer(item, "error") == .Val(error) {
        return if writing -> "{who}wrote to {target}{at} failed: errno {error}" else -> "{who}read from {target}{at} failed: errno {error}"
    }
    bytes: jet_cli_perf_member_integer(item, "bytes") ?? "?"
    if writing -> "{who}wrote {bytes} bytes to {target}{at}" else -> "{who}read {bytes} bytes from {target}{at}"
}

// A frame of a row's stack (`wait_stack`, an I/O row's `stack`): its
// function and line.
JetCLIPerfStackFrame: struct {
    name: String,
    line: String,
}

// The frames of row `item`'s stack `key`, innermost first.
jet_cli_perf_row_stack: fn(item: CanonicalJSON, key: String) -> [JetCLIPerfStackFrame] Never! {
    fields: jettrace_object_view(item, "jettrace row") ?? return [JetCLIPerfStackFrame]{}
    at: jet_cli_perf_key(fields, key) ?? return [JetCLIPerfStackFrame]{}
    frames: jettrace_array(fields[at].value, key) ?? return [JetCLIPerfStackFrame]{}
    loop frame in frames -> JetCLIPerfStackFrame{name: jet_cli_perf_member_text(frame, "name") ?? "?", line: jet_cli_perf_member_integer(frame, "line") ?? "?"}
}

// A wait row `item`'s stack in words, outermost frame first: `run
// main.jet:5 > nap main.jet:10`; empty for none.
jet_cli_perf_wait_stack_text: fn(item: CanonicalJSON) -> String Never! {
    path: jet_cli_perf_member_symbol_text(item, "path") ?? "?"
    frames: jet_cli_perf_row_stack(item, "wait_stack")
    parts: loop index in 0..<frames.len() -> "{frames[frames.len() - 1 - index].name} {path}:{frames[frames.len() - 1 - index].line}"
    parts.join(" > ")
}

// One stack's off-CPU time: its text, the time its waits took and how many
// there were.
JetCLIPerfOffCPU: struct {
    stack: String,
    ns: Int,
    waits: Int,
}

// Off-CPU time by stack: the tasks' waits (`task_wait` rows) summed by
// their stack, outermost frame first, and the wait it blocked in: `run
// main.jet:5 > pause main.jet:12 > nap main.jet:10 > time sleep`. The
// longest first; at most 16 stacks.
jet_cli_perf_off_cpu_lines: fn(trace: CanonicalJSON) -> [String] Never! {
    items: jet_cli_perf_rows(trace, "spans") ?? return [String]{}
    found := [JetCLIPerfOffCPU]{}
    places := [String:Int]{}
    loop item in items {
        if (jet_cli_perf_member_text(item, "kind") ?? "") != "task_wait" -> next
        start: jet_cli_perf_member_number(item, "start_ns") ?? next
        end: jet_cli_perf_member_number(item, "end_ns") ?? next
        held: jet_cli_perf_wait_stack_text(item)
        name: jet_cli_perf_member_symbol_text(item, "name") ?? "wait"
        stack: if held.len() == 0 -> name else -> "{held} > {name}"
        if !places.has_key(stack) {
            places[stack] = found.len()
            // copy: the map keys the stack; its row owns its own.
            found.push(JetCLIPerfOffCPU{stack: stack.copy(), ns: 0, waits: 0})
        }
        found[places[stack]].ns += end - start
        found[places[stack]].waits += 1
    }
    if found.len() == 0 -> return [String]{}
    found.sort_by(fn(left: JetCLIPerfOffCPU, right: JetCLIPerfOffCPU) { (right.ns <=> left.ns).then(left.stack <=> right.stack) })
    lines := [String]{"off-cpu by stack: the time tasks spent waiting, by the stack each wait blocked on, the longest first"}
    shown: if found.len() > 16 -> 16 else -> found.len()
    loop index in 0..<shown {
        row: found[index]
        lines.push("  {row.ns}ns waits={row.waits} · {row.stack}")
    }
    lines
}

// The text `key` of a row `item`'s symbol: its `path` or `name`.
jet_cli_perf_member_symbol_text: fn(item: CanonicalJSON, key: String) -> String? Never! {
    fields: jettrace_object_view(item, "jettrace row") ?? return None
    at: jet_cli_perf_key(fields, "symbol") ?? return None
    symbol: jettrace_object_view(fields[at].value, "symbol") ?? return None
    jet_cli_perf_field_text(symbol, key)
}

// Whether the object `value` has `key` set to null.
jet_cli_perf_member_is_null: fn(value: CanonicalJSON, key: String) -> Bool Never! {
    fields: jettrace_object_view(value, "jettrace row") ?? return false
    at: jet_cli_perf_key(fields, key) ?? return false
    fields[at].value == .Null
}

// Whether the trace holds any typed evidence a summary reads.
jet_cli_perf_has_evidence: fn(trace: CanonicalJSON) -> Bool Never! {
    jet_cli_perf_first_sample(trace) != None || jet_cli_perf_profile_summary(trace) != None || jet_cli_perf_allocation_summary(trace) != None || jet_cli_perf_browser_summary(trace) != None || jet_cli_perf_task_summary(trace) != None || jet_cli_perf_lock_summary(trace) != None || jet_cli_perf_io_summary(trace) != None || jet_cli_perf_native_summary(trace) != None || jet_cli_perf_span_summary(trace) != None || jet_cli_perf_log_span_summary(trace) != None || jet_cli_perf_wait_summary(trace) != None || jet_cli_perf_game_lines(trace).len() > 0
}

// A core.game run's frames and draw events: `game frames=… draw_events=…
// scene=… cpu=…ns slowest_frame=… · <function>` (the slowest frame's
// responsible function), then each callback function's draw events, the
// most time first, at most 8: `game draw <name> <file>:<line> count=…
// ns=…`.
jet_cli_perf_game_lines: fn(trace: CanonicalJSON) -> [String] Never! {
    frames: jet_cli_perf_rows(trace, "game_frames") ?? return [String]{}
    if frames.len() == 0 -> return [String]{}
    cpu := 0
    slowest := 0
    responsible := "none"
    scene := ""
    loop frame in frames {
        ns: jet_cli_perf_member_number(frame, "cpu_ns") ?? next
        cpu += ns
        if scene == "" -> scene = jet_cli_perf_member_text(frame, "scene") ?? ""
        if ns < slowest -> next
        slowest = ns
        responsible = jet_cli_perf_game_function_label(frame, "responsible_function") ?? "none"
    }
    draws: jet_cli_perf_rows(trace, "game_draw_events") ?? return [String]{}
    counts := [String:Int]{}
    totals := [String:Int]{}
    loop draw in draws {
        label: jet_cli_perf_game_function_label(draw, "function") ?? next
        ns: jet_cli_perf_member_number(draw, "duration_ns") ?? 0
        counts[label] = (counts.get(label) ?? 0) + 1
        totals[label] = (totals.get(label) ?? 0) + ns
    }
    labels := counts.keys().to_list()
    labels.sort_by(fn(left: String, right: String) { if totals[left] == totals[right] -> left <=> right else -> totals[right] <=> totals[left] })
    lines := [String]{"game frames={frames.len()} draw_events={draws.len()} scene={scene} cpu={cpu}ns slowest_frame={slowest}ns · {responsible}"}
    loop index in 0..<(if labels.len() > 8 -> 8 else -> labels.len()) {
        lines.push("game draw {labels[index]} count={counts[labels[index]]} ns={totals[labels[index]]}")
    }
    lines
}

// `<name> <file>:<line>` of the function member `key` of a game row.
jet_cli_perf_game_function_label: fn(row: CanonicalJSON, key: String) -> String? Never! {
    fields: jettrace_object_view(row, "jettrace row") ?? return None
    at: jet_cli_perf_key(fields, key) ?? return None
    function: fields[at].value
    name: jet_cli_perf_member_text(function, "name") ?? return None
    source: jettrace_object_view(function, "jettrace function") ?? return None
    span: jet_cli_perf_key(source, "source") ?? return None
    file: jet_cli_perf_member_text(source[span].value, "file") ?? return None
    line: jet_cli_perf_member_integer(source[span].value, "start_line") ?? return None
    Val("{name} {file}:{line}")
}

// A bar of `count` marks, 1 to 40 wide.
jet_cli_perf_bar: fn(count: Int) -> String Never! {
    width: if count > 40 -> 40 else if count < 1 -> 1 else -> count
    "#".repeat(width)
}

// `ascii_flame`.
jet_cli_perf_flame: fn(trace: CanonicalJSON) -> [String] Never! {
    rows := [String]{}
    if jet_cli_perf_first_sample(trace) == .Val(sample) {
        rows.push("{sample.symbol} {sample.domain} {jet_cli_perf_bar(Int.parse(sample.ns) ?? 1)}")
    }
    if jet_cli_perf_profile_rows(trace) == .Ok(items) {
        profile := [JetCLIPerfProfileRow]{}
        loop item in items {
            if jet_cli_perf_profile_row(item) == .Val(row) -> profile.push(row)
        }
        loop line in jet_cli_perf_flame_profile(profile) -> rows.push(line)
    }
    if jet_cli_perf_browser_summary(trace) == .Val(browser) {
        rows.push("{browser.symbol} browser {jet_cli_perf_bar(browser.count)}")
    }
    rows
}

// One profile row as the flame graph reads it: its function's `path#name`,
// its clock and samples, and, for a row that is one source line, the line,
// its inclusive samples, its allocations and its counters' events when it
// has them (`events`, ` l1d_misses=…` for each).
JetCLIPerfProfileRow: struct {
    symbol: String,
    clock: String,
    weight: Int,
    line: Int?,
    inclusive: Int?,
    allocations: Int?,
    events: String,
}

jet_cli_perf_profile_row: fn(item: CanonicalJSON) -> JetCLIPerfProfileRow? Never! {
    symbol: jet_cli_perf_member_symbol(item) ?? return None
    clock: jet_cli_perf_member_text(item, "clock") ?? return None
    weight: jet_cli_perf_member_number(item, "sample_weight") ?? return None
    events := ""
    loop counter in TRACE_COUNTERS {
        if jet_cli_perf_member_number(item, trace_counter_key(counter)) == .Val(count) {
            events = "{events} {trace_counter_name(counter)}={count}"
        }
    }
    Val(JetCLIPerfProfileRow{symbol: symbol, clock: clock, weight: weight, line: jet_cli_perf_row_line(item), inclusive: jet_cli_perf_member_number(item, "inclusive_count"), allocations: jet_cli_perf_member_number(item, "allocation_count"), events: events})
}

// One function's profile rows on one clock: their samples, and those of
// each row that is one source line, with its inclusive samples, its
// allocations and its counters' events when the row has them (`events`,
// ` l1d_misses=…` for each).
JetCLIPerfFlameFunction: struct {
    symbol: String,
    clock: String,
    weight: Int,
    lines: [{line: Int, weight: Int, inclusive: Int?, allocations: Int?, events: String}],
}

// The profile rows by function and clock, hottest first: each function's
// samples and its share of its clock's, then its hottest lines, each with
// its inclusive samples, its allocations and its counters' events when the
// row has them. At most 8 functions and 3 lines each.
jet_cli_perf_flame_profile: fn(rows: &&[JetCLIPerfProfileRow]) -> [String] Never! {
    functions := [JetCLIPerfFlameFunction]{}
    loop row in rows.move() {
        found := -1
        loop (index, function) in functions {
            if function.symbol == row.symbol && function.clock == row.clock {
                found = index
                break
            }
        }
        if found < 0 {
            found = functions.len()
            functions.push(JetCLIPerfFlameFunction{symbol: row.symbol, clock: row.clock, weight: 0, lines: [{line: Int, weight: Int, inclusive: Int?, allocations: Int?, events: String}]{}})
        }
        functions[found].weight += row.weight
        if row.line == .Val(line) {
            functions[found].lines.push({line: line, weight: row.weight, inclusive: row.inclusive, allocations: row.allocations, events: row.events})
        }
    }
    functions.sort_by(fn(left: JetCLIPerfFlameFunction, right: JetCLIPerfFlameFunction) { right.weight <=> left.weight })
    out := [String]{}
    limit: if functions.len() > 8 -> 8 else -> functions.len()
    loop index in 0..<limit {
        total := 0
        loop other in functions {
            if other.clock == functions[index].clock -> total += other.weight
        }
        weight: functions[index].weight
        share: if total > 0 -> weight * 100 /% total else -> 0
        out.push("{functions[index].symbol} profile:{functions[index].clock} samples={weight} share={share}%")
        functions[index].lines.sort_by(fn(left: {line: Int, weight: Int, inclusive: Int?, allocations: Int?, events: String}, right: {line: Int, weight: Int, inclusive: Int?, allocations: Int?, events: String}) { (right.weight <=> left.weight).then((right.inclusive ?? 0) <=> (left.inclusive ?? 0)).then(left.line <=> right.line) })
        shown: if functions[index].lines.len() > 3 -> 3 else -> functions[index].lines.len()
        loop at in 0..<shown {
            row: functions[index].lines[at]
            inclusive: if row.inclusive == .Val(count) -> " inclusive={count}" else -> ""
            allocations: if row.allocations == .Val(count) -> " allocations={count}" else -> ""
            out.push("  line {row.line} samples={row.weight}{inclusive}{allocations}{row.events}")
        }
    }
    out
}

// The line of a profile row whose source is one line.
jet_cli_perf_row_line: fn(row: CanonicalJSON) -> Int? Never! {
    fields: jettrace_object_view(row, "jettrace row") ?? return None
    at: jet_cli_perf_key(fields, "source") ?? return None
    start: jet_cli_perf_member_number(fields[at].value, "start_line") ?? return None
    end: jet_cli_perf_member_number(fields[at].value, "end_line") ?? return None
    if start != end -> return None
    Val(start)
}

// Per-line sample totals: each row one function's CPU-time samples at one
// source line, its file and function as places in `names`, whose first is
// "" as in pprof's string table (jet_cli_perf_pprof_string). A trace's come
// from its profile (jet_cli_perf_line_totals), an export's from the export
// (PeerExport.jet jet_cli_perf_import).
JetCLIPerfLineTotals: struct {
    names: [String],
    rows: [JetCLIPerfLineTotal],
}

JetCLIPerfLineTotal: struct {
    path: Int,
    line: Int,
    function: Int,
    samples: Int,
}

// The most lines the per-line table shows.
JET_CLI_PERF_LINE_ROWS: 24

// The trace's `cpu` profile rows as per-line totals: each row's own samples
// at its first line, in the rows' order, which the pprof and OTLP exports
// carry as they are.
jet_cli_perf_line_totals: fn(trace: CanonicalJSON) -> JetCLIPerfLineTotals Never! {
    totals := JetCLIPerfLineTotals{names: [String]{""}, rows: [JetCLIPerfLineTotal]{}}
    rows: jet_cli_perf_profile_rows(trace) ?? return totals
    loop row in rows {
        if (jet_cli_perf_member_text(row, "clock") ?? "") != "cpu" -> next
        samples: jet_cli_perf_member_number(row, "sample_count") ?? next
        fields: jettrace_object_view(row, "jettrace row") ?? next
        symbol_at: jet_cli_perf_key(fields, "symbol") ?? next
        symbol: jettrace_object_view(fields[symbol_at].value, "symbol") ?? next
        source_at: jet_cli_perf_key(fields, "source") ?? next
        line: jet_cli_perf_member_number(fields[source_at].value, "start_line") ?? next
        path: jet_cli_perf_field_text(symbol, "path") ?? next
        name: jet_cli_perf_field_text(symbol, "name") ?? next
        path_at: jet_cli_perf_pprof_string(totals.names, path)
        name_at: jet_cli_perf_pprof_string(totals.names, name)
        totals.rows.push(JetCLIPerfLineTotal{path: path_at, line: line, function: name_at, samples: samples})
    }
    totals
}

// The per-line table: each function's samples at each source line, the
// rows of one function and line summed, hottest first, then by file, line
// and function, at most JET_CLI_PERF_LINE_ROWS of them
// (`  main.jet:5 spin samples=812`). Empty when no line has a sample.
jet_cli_perf_line_table: fn(totals: JetCLIPerfLineTotals) -> [String] Never! {
    // Each distinct line's first row, and the samples of all of its rows.
    firsts := [Int]{}
    sums := [Int]{}
    loop (index, row) in totals.rows {
        found := -1
        loop (place, first) in firsts {
            known: totals.rows[first]
            if known.line == row.line && known.path == row.path && known.function == row.function {
                found = place
                break
            }
        }
        if found >= 0 {
            sums[found] = sums[found] + row.samples
            next
        }
        firsts.push(index)
        sums.push(row.samples)
    }
    // The places in `firsts` with samples, in the table's order.
    order := [Int]{}
    loop place in 0..<firsts.len() {
        if sums[place] <= 0 -> next
        spot := order.len()
        loop spot > 0 && jet_cli_perf_line_before(totals, firsts[place], sums[place], firsts[order[spot - 1]], sums[order[spot - 1]]) {
            spot -= 1
        }
        order.insert(spot, place)
    }
    lines := [String]{}
    loop (at, place) in order {
        if at == JET_CLI_PERF_LINE_ROWS {
            lines.push("  ({order.len() - at} more lines)")
            break
        }
        row: totals.rows[firsts[place]]
        lines.push("  {totals.names[row.path]}:{row.line} {totals.names[row.function]} samples={sums[place]}")
    }
    lines
}

// Whether the line of row `left`, with `left_samples`, comes before that of
// row `right` in the per-line table.
jet_cli_perf_line_before: fn(totals: JetCLIPerfLineTotals, left: Int, left_samples: Int, right: Int, right_samples: Int) -> Bool Never! {
    if left_samples != right_samples -> return left_samples > right_samples
    a: totals.rows[left]
    b: totals.rows[right]
    if totals.names[a.path] != totals.names[b.path] {
        return totals.names[a.path] < totals.names[b.path]
    }
    if a.line != b.line -> return a.line < b.line
    totals.names[a.function] < totals.names[b.function]
}

// Per-line totals as the flame graph's `cpu` rows.
jet_cli_perf_total_rows: fn(totals: JetCLIPerfLineTotals) -> [JetCLIPerfProfileRow] Never! {
    loop row in totals.rows -> JetCLIPerfProfileRow{symbol: "{totals.names[row.path]}#{totals.names[row.function]}", clock: "cpu", weight: row.samples, line: Val(row.line), inclusive: None, allocations: None, events: ""}
}

// `ascii_timeline`.
jet_cli_perf_timeline: fn(trace: CanonicalJSON) -> [String] Never! {
    rows := [String]{}
    if jet_cli_perf_rows(trace, "browser") == .Ok(items) {
        limit: if items.len() > 8 -> 8 else -> items.len()
        loop index in 0..<limit {
            start: jet_cli_perf_member_integer(items[index], "start_ns") ?? next
            duration: jet_cli_perf_member_integer(items[index], "duration_ns") ?? next
            rows.push("[{start}+{duration}] {jet_cli_perf_member_symbol(items[index]) ?? "browser"}")
        }
    }
    if jet_cli_perf_rows(trace, "spans") == .Ok(items) {
        // Up to 8 task and log spans and up to 8 tasks' waits, all on the
        // one clock of every span.
        spans := 0
        waits := 0
        loop item in items {
            if (jet_cli_perf_member_text(item, "status") ?? "") != "captured" -> next
            start: jet_cli_perf_member_integer(item, "start_ns") ?? next
            end: jet_cli_perf_member_integer(item, "end_ns") ?? next
            if (jet_cli_perf_member_text(item, "kind") ?? "") == "task_wait" {
                if waits >= 8 -> next
                waits += 1
                rows.push("[{start}..{end}] {jet_cli_perf_wait_text(item)}")
                next
            }
            if spans >= 8 -> next
            spans += 1
            rows.push("[{start}..{end}] {jet_cli_perf_member_symbol(item) ?? "span"}")
        }
    }
    if jet_cli_perf_rows(trace, "io") == .Ok(items) {
        // Up to 8 file and network transfers, on the same clock.
        limit: if items.len() > 8 -> 8 else -> items.len()
        loop index in 0..<limit {
            start: jet_cli_perf_member_integer(items[index], "start_ns") ?? next
            end: jet_cli_perf_member_integer(items[index], "end_ns") ?? next
            rows.push("[{start}..{end}] {jet_cli_perf_io_text(items[index])}")
        }
    }
    rows
}
