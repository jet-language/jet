// `jet perf run|test`: run the exact `jet run` or `jet test` intent with the
// runtime's live observation on, read the runtime-published snapshots while it
// runs and once after it exits, and write one verified `.jettrace`; a run's
// profile rows are its program's CPU-time samples under the `cpu` lens, the
// default, and its memory counters' under `memory`; under `alloc` it keeps
// the program's heap snapshots, and under `topdown` why its hot lines are
// slow on the CPU (Topdown.jet). The child keeps this process's terminal.
use {
    perf_files: core.files
    perf_process: core.process
    perf_sys: core.sys
    perf_time: core.time
    jet_backend.[link_debug_addr]
    jet_driver.[JetDriverVerbOutput, JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USAGE]
    jet_foundation.[
        CanonicalJSON,
        CanonicalJSONField,
        DEFAULT_EXCLUSIONS,
        ENV_JET_OBSERVE,
        ENV_JET_PERF_LENSES,
        ENV_JET_PERF_SAMPLES,
        SourceIdentity,
        TraceCounter,
        TraceHardware,
        TraceReceiptSection,
        TraceToolchain,
        artifact_extension,
        canonical_json_object,
        canonical_json_sha256,
        trace_id,
        trace_profile_unsupported,
        verify_jettrace,
    ]
    jet_pkg_model.[JET_VERSION, WorkspaceDeclarationCache]
}

// A `.jettrace` this session writes is at most this large when read back.
JET_CLI_PERF_TRACE_LIMIT: 268435456

// `SessionArgs`: the perf-only flags, and the base intent's argv after its
// action name with those flags removed. `lenses` are what `--lens` names,
// in the order `cpu`, `memory`, `alloc`, `topdown`; the default is `cpu`,
// CPU time alone.
JetCLIPerfSessionArgs: struct {
    out: String?,
    source: String?,
    allowlist: [String],
    lenses: [String],
    child_args: [String],
}

// `parse_session_args`. Words after `--` belong to the program.
jet_cli_perf_session_args: fn(args: [String]) -> JetCLIPerfSessionArgs JetCLIReadError! {
    parsed := JetCLIPerfSessionArgs{out: None, source: None, allowlist: [String]{}, lenses: [String]{"cpu"}, child_args: [String]{}}
    passthrough := false
    skip := false
    loop (index, arg) in args {
        if skip {
            skip = false
            next
        }
        if passthrough || arg == "--" {
            passthrough = true
            // copy: the argument list keeps its word; the child argv owns its own.
            parsed.child_args.push(arg.copy())
            next
        }
        if arg.starts_with("--out=") {
            parsed.out = Val(arg.slice(6..<arg.len()))
            next
        }
        if arg == "--out" {
            if index + 1 >= args.len() -> return Err(jet_cli_read_error("`--out` needs a path"))
            // copy: the argument list keeps its word; the output path owns its own.
            parsed.out = Val(args[index + 1].copy())
            skip = true
            next
        }
        if arg.starts_with("--capture=") {
            parsed.allowlist = jet_cli_perf_capture_allowlist(arg.slice(10..<arg.len()))
            next
        }
        if arg == "--capture" {
            if index + 1 >= args.len() {
                return Err(jet_cli_read_error("`--capture` needs a comma-separated allowlist"))
            }
            parsed.allowlist = jet_cli_perf_capture_allowlist(args[index + 1])
            skip = true
            next
        }
        if arg.starts_with("--lens=") {
            parsed.lenses = jet_cli_perf_session_lenses(arg.slice(7..<arg.len()))
            next
        }
        if arg == "--lens" {
            if index + 1 >= args.len() {
                return Err(jet_cli_read_error("`--lens` needs one or more of `cpu`, `memory`, `alloc` and `topdown`, comma-separated"))
            }
            parsed.lenses = jet_cli_perf_session_lenses(args[index + 1])
            skip = true
            next
        }
        if !arg.starts_with("-") && parsed.source == None && arg.ends_with(".jet") {
            // copy: the argument list keeps its word; the source path owns its own.
            parsed.source = Val(arg.copy())
        }
        // copy: the argument list keeps its word; the child argv owns its own.
        parsed.child_args.push(arg.copy())
    }
    Ok(parsed)
}

// `--lens` list `raw`: the lenses the run takes, comma-separated, each `cpu`
// (its CPU time), `memory` (its memory counters), `alloc` (its heap
// snapshots), `topdown` (its top-down counters) or `causal` (its virtual
// speedup experiments, which time the CPU-time samples and slow the
// program down, so it takes `cpu` alone beside it), in that order and
// without repeats.
jet_cli_perf_session_lenses: fn(raw: String) -> [String] JetCLIReadError! {
    asked := [String]{}
    loop part in raw.split(",") {
        item: part.trim()
        if item == "" -> next
        if item != "cpu" && item != "memory" && item != "alloc" && item != "topdown" && item != "causal" {
            return Err(jet_cli_read_error("`--lens` item `{item}` is not a lens; lenses: cpu, memory, alloc, topdown, causal"))
        }
        if !asked.contains(item.copy()) -> asked.push(item.copy())
    }
    if asked.contains("causal") {
        if asked.contains("memory") || asked.contains("alloc") || asked.contains("topdown") {
            return Err(jet_cli_read_error("the `causal` lens slows the program down to time its lines, which would skew the other lenses; run it alone with `--lens=causal`"))
        }
        return Ok([String]{"cpu", "causal"})
    }
    lenses := [String]{}
    if asked.contains("cpu") -> lenses.push("cpu")
    if asked.contains("memory") -> lenses.push("memory")
    if asked.contains("alloc") -> lenses.push("alloc")
    if asked.contains("topdown") -> lenses.push("topdown")
    if lenses.len() == 0 {
        return Err(jet_cli_read_error("`--lens` needs one or more of `cpu`, `memory`, `alloc` and `topdown`, comma-separated"))
    }
    Ok(lenses)
}

// `parse_capture_allowlist`: privacy fields the trace may keep, each one of
// the default exclusions, sorted and without repeats.
jet_cli_perf_capture_allowlist: fn(raw: String) -> [String] JetCLIReadError! {
    items := [String]{}
    loop part in raw.split(",") {
        item: part.trim()
        if item == "" -> next
        if !DEFAULT_EXCLUSIONS.contains(item.copy()) {
            return Err(jet_cli_read_error("`--capture` item `{item}` is not a privacy field; allowed: {DEFAULT_EXCLUSIONS.join(", ")}"))
        }
        if !items.contains(item.copy()) -> items.push(item.copy())
    }
    if items.len() == 0 {
        return Err(jet_cli_read_error("`--capture` needs at least one privacy field"))
    }
    items.sort()
    Ok(items)
}

// `run_session`. The exit code is the child's.
jet_cli_perf_session: fn(action: String, args: [String], quiet: Bool, color: Bool) -[FS, Env, Exec, Time]> JetDriverVerbOutput Never! {
    extension: artifact_extension()
    parsed := jet_cli_perf_session_args(args) ?? return jet_cli_perf_error(err.message, "run `jet perf {action} <file.jet> [--lens=cpu,memory,alloc,topdown|causal] [--out <path{extension}>]`", color)
    memory: parsed.lenses.contains("memory")
    if memory && action != "run" {
        return jet_cli_perf_error("the `memory` lens samples a program's counters, which only `jet perf run` samples", "run `jet perf run <file.jet> --lens=memory`", color)
    }
    alloc: parsed.lenses.contains("alloc")
    if alloc && action != "run" {
        return jet_cli_perf_error("the `alloc` lens snapshots a program's heap, which only `jet perf run` snapshots", "run `jet perf run <file.jet> --lens=alloc`", color)
    }
    topdown: parsed.lenses.contains("topdown")
    if topdown && action != "run" {
        return jet_cli_perf_error("the `topdown` lens samples a program's top-down events, which only `jet perf run` samples", "run `jet perf run <file.jet> --lens=cpu,topdown`", color)
    }
    causal: parsed.lenses.contains("causal")
    if causal && action != "run" {
        return jet_cli_perf_error("the `causal` lens experiments on a program's timing, which only `jet perf run` does", "run `jet perf run <file.jet> --lens=causal`", color)
    }
    exe: perf_sys.executable()
    if exe == "" {
        return jet_cli_perf_error("cannot resolve the jet executable", JET_CLI_PERF_FIX, color)
    }
    // `jet run --observe` links the program's observation start and starts
    // the program's observation, and only the program's: jet itself runs
    // unobserved, so the program runs in jet's place, under the session's
    // pid. `jet test` has no `--observe`, so the session's own environment
    // observes a test run (jet_cli_observe_env). The alloc lens builds the
    // program with the checked heap, whose blocks keep the call sites that
    // allocated them.
    argv := [String]{exe, action}
    observed_run: action == "run"
    if observed_run -> argv.push("--observe")
    if alloc -> argv.push("--checked-alloc")
    loop arg in parsed.child_args {
        // copy: the parsed argv keeps its words; the spawn owns its own.
        argv.push(arg.copy())
    }
    spec := perf_process.cmd(argv).stdin(.Inherit).stdout(.Inherit).stderr(.Inherit)
    // A run's program samples into a file of this session's (the runtime's
    // PerfSamples.jet), beside which `jet run` writes the program's image
    // (Host.jet jet_cli_perf_samples_image): its CPU time under the `cpu`
    // lens, its counters under `memory`, its top-down events under
    // `topdown`.
    samples := String?{None}
    if observed_run {
        spec = spec.env_remove(ENV_JET_OBSERVE)
        if parsed.source != None {
            path: perf_files.join(perf_sys.temp_dir(), "jet-perf-{perf_process.current_pid()}-{perf_time.unix_ns()}.samples")
            spec = spec.env(ENV_JET_PERF_SAMPLES, path)
            spec = spec.env(ENV_JET_PERF_LENSES, parsed.lenses.join(","))
            samples = Val(path)
        }
    } else {
        loop field in jet_cli_observe_env(parsed.source ?? "") {
            spec = spec.env(field.name, field.value)
        }
    }
    child := spec.spawn() ?? return jet_cli_perf_error("cannot start `jet {action}`: {err}", JET_CLI_PERF_FIX, color)
    pid: child.id()
    started: perf_time.instant()
    observed := JetCLIPerfSessionObserved{root: [JetCLIPerfObservation]{}, program: [JetCLIPerfObservation]{}, program_pid: None}
    alive := String?{None}
    loop {
        // The root's last stat while it lives binds its final publication,
        // which is read after the reap.
        if jet_cli_perf_process_stat(pid) == .Ok(stat) -> alive = Val(stat)
        exited: child.exited() ?? return jet_cli_perf_error("cannot wait for `jet {action}`: {err}", JET_CLI_PERF_FIX, color)
        if exited -> break
        if parsed.source != None -> jet_cli_perf_session_observe(observed, pid)
        perf_time.sleep(25ms)
    }
    receipt: child.wait() ?? return jet_cli_perf_error("cannot wait for `jet {action}`: {err}", JET_CLI_PERF_FIX, color)
    // The session's wall, spawn to exit, the run's wall sample: a duration on
    // the session's clock, never a moment on the program's.
    wall: checked(U64{started.elapsed().ns}) ?? U64{0}
    // The child is reaped as it exits, so its runtime's exit publication is
    // read without /proc unless a poll already kept it: every completed run
    // gets its final observation, however short it was.
    published: observed.root.len() > 0 && observed.root[observed.root.len() - 1].live.runtime.exit
    if parsed.source != None && !published && alive == .Val(stat) {
        cpu: if receipt.user_cpu_ns == .Val(user) && receipt.system_cpu_ns == .Val(system) -> Val(user + system) else -> Int?{None}
        if jet_cli_perf_live_read_reaped(pid, stat, cpu) == .Ok(live) {
            jet_cli_perf_session_keep(observed.root, jet_cli_perf_observed(live))
        }
    }
    // Under `jet run --observe` only the program publishes, so what the
    // root's pid publishes is the program, run in jet's place. A `jet test`
    // root publishes its own compile, never the tests.
    observations: if observed.program.len() > 0 -> observed.program.move() else if observed_run -> observed.root.move() else -> [JetCLIPerfObservation]{}
    counters := [TraceCounter]{}
    if memory -> counters = jet_cli_perf_counters_read(samples)
    sampler: jet_cli_perf_pc_read(samples)
    pc: jet_cli_perf_pc_json(sampler)
    sampled := JetCLIPerfSamples?{None}
    if samples == .Val(file) {
        sampled = jet_cli_perf_samples_read(file, parsed.source ?? "", counters, sampler)
    }
    reason: if parsed.source == None -> "source sampling requires a source capture" else -> "source sampling requires a readable `.jet` source"
    capture := jet_cli_perf_capture_new(trace_profile_unsupported(reason), [SourceIdentity]{})
    if parsed.source == .Val(source) {
        // A missing or unreadable source still gets a schema-valid skeleton.
        if perf_files.read(source) == .Ok(text) {
            if jet_cli_perf_capture_source(source, text, observations, sampled, jet_cli_perf_session_target(), Val(wall)) == .Ok(captured) {
                capture = captured
            }
        }
    }
    if memory -> jet_cli_perf_counters_profile(capture.profile, counters)
    // The receipt reads the allowlist before the policy takes it.
    stamped: jet_cli_perf_session_receipt(action, argv, parsed.source, parsed.allowlist, samples != None, parsed.lenses, pc) ?? return jet_cli_perf_error(err.message, JET_CLI_PERF_FIX, color)
    capture.receipts.push(stamped)
    if topdown && samples == .Val(file) {
        if parsed.source == .Val(source) {
            capture.receipts.push(jet_cli_perf_topdown_section(file, sampled, source))
        }
    }
    capture.policy.allowlist = parsed.allowlist.move()
    // The core.log spans the program closed, which its runtime keeps beside
    // the samples, with the CPU-time samples each zone holds, and the tasks'
    // waits and wakes and the file and network transfers it recorded among
    // them. Each is on the program's clock, from its process epoch, which its
    // observations' elapsed times share: origin 0.
    if samples == .Val(file) && parsed.source == .Val(source) {
        if {
            sampled == .Val(found) -> {
                jet_cli_perf_log_spans_read(capture, "{file}.spans", source, 0, found.timed)
            }
            else -> {
                jet_cli_perf_log_spans_read(capture, "{file}.spans", source, 0, [JetCLIPerfTimed]{})
            }
        }
    }
    if parsed.source.move() == .Val(source) {
        if sampled.move() == .Val(found) {
            // The task_wait rows take the waits, which the transfers may
            // have ended, then the I/O rows take the transfers.
            jet_cli_perf_waits_read(capture, found.waits.move(), found.wakes, found.spawns, found.transfers, source, 0)
            jet_cli_perf_io_read(capture, found.transfers.move(), source, 0)
            if causal {
                capture.receipts.push(jet_cli_perf_causal_section("{source}", found.experiments.move(), found.points.move(), found.idle.move()))
            }
            if jet_cli_perf_session_allocations("{source}", found.sited, found.allocated.move(), found.cost) == .Val(section) {
                capture.receipts.push(section)
            }
            if jet_cli_perf_session_heaps(source.move(), found.heaps.move()) == .Val(section) {
                capture.receipts.push(section)
            }
            if jet_cli_perf_threads_section(found.threads.move(), found.threads_claimed) == .Val(section) {
                capture.receipts.push(section)
            }
            if jet_cli_perf_syscalls_section(found.syscalls.move(), found.syscalls_lost) == .Val(section) {
                capture.receipts.push(section)
            }
        }
    }
    full := [String]{action}
    loop arg in args {
        // copy: the perf argv keeps its words; the trace's recorded argv owns its own.
        full.push(arg.copy())
    }
    path: jet_cli_perf_session_write(capture, action, full, parsed.out) ?? return jet_cli_perf_error(err.message, JET_CLI_PERF_FIX, color)
    code: if receipt.signal != None -> 1 else -> receipt.code
    JetDriverVerbOutput{stdout: "", stderr: if quiet -> "" else -> "Trace: {path}\n", exit_code: code}
}

// `attach`: one point capture of a running process. A devserver browser
// relay supplies browser rows and compiler symbol identities; otherwise the
// runtime's live observation is attributed to `--source`. A process that
// publishes neither still gets a schema-valid empty trace. With
// `--lens=alloc`, the trace also holds a heap snapshot the program takes
// while it runs (jet_cli_perf_attach_heap).
jet_cli_perf_attach: fn(args: [String], quiet: Bool, color: Bool) -[FS, Env, Time]> JetDriverVerbOutput Never! {
    pid := Int?{None}
    out := String?{None}
    source := String?{None}
    allowlist := [String]{}
    zones_ms := 0
    alloc := false
    held_ns := Int?{None}
    skip := false
    loop (index, arg) in args {
        if skip {
            skip = false
            next
        }
        if arg.starts_with("--lens=") {
            if arg != "--lens=alloc" {
                return jet_cli_perf_error("`{arg}` names a lens a running program can't start: attach takes the `alloc` lens alone", "attach with `--lens=alloc` for a heap snapshot, or with no lens for the flight ring", color)
            }
            alloc = true
            next
        }
        if skip {
            skip = false
            next
        }
        if arg.starts_with("--zones=") {
            zones_ms = jet_cli_perf_attach_window(arg.slice(8..<arg.len())) ?? return jet_cli_perf_error("`{arg}` isn't a window jet understands", "write how long to record zones, as `--zones=500ms` or `--zones=2s`", color)
            next
        }
        if arg.starts_with("--out=") {
            out = Val(arg.slice(6..<arg.len()))
            next
        }
        if arg == "--out" {
            if index + 1 >= args.len() {
                return jet_cli_perf_error("`--out` needs a path", JET_CLI_PERF_FIX, color)
            }
            // copy: the argument list keeps its word; the output path owns its own.
            out = Val(args[index + 1].copy())
            skip = true
            next
        }
        if arg.starts_with("--source=") {
            source = Val(arg.slice(9..<arg.len()))
            next
        }
        if arg == "--source" {
            if index + 1 >= args.len() {
                return jet_cli_perf_error("`--source` needs a `.jet` path", JET_CLI_PERF_FIX, color)
            }
            // copy: the argument list keeps its word; the source path owns its own.
            source = Val(args[index + 1].copy())
            skip = true
            next
        }
        if arg.starts_with("--capture=") {
            allowlist = jet_cli_perf_capture_allowlist(arg.slice(10..<arg.len())) ?? return jet_cli_perf_error(err.message, JET_CLI_PERF_FIX, color)
            next
        }
        if arg == "--capture" {
            if index + 1 >= args.len() {
                return jet_cli_perf_error("`--capture` needs a comma-separated allowlist", JET_CLI_PERF_FIX, color)
            }
            allowlist = jet_cli_perf_capture_allowlist(args[index + 1]) ?? return jet_cli_perf_error(err.message, JET_CLI_PERF_FIX, color)
            skip = true
            next
        }
        if arg.starts_with("-") {
            return jet_cli_perf_error("unknown `jet perf attach` flag `{arg}`", JET_CLI_PERF_FIX, color)
        }
        if pid != None {
            return jet_cli_perf_error("`jet perf attach` takes one process id", JET_CLI_PERF_FIX, color)
        }
        value: Int.parse(arg) ?? return jet_cli_perf_error("`{arg}` isn't a process id", JET_CLI_PERF_FIX, color)
        if value < 0 || value > 4294967295 {
            return jet_cli_perf_error("`{arg}` isn't a process id", JET_CLI_PERF_FIX, color)
        }
        pid = Val(value)
    }
    target_pid: pid ?? return jet_cli_perf_error("`jet perf attach` needs a process id", "run `jet perf attach <pid> --source <file.jet>`", color)
    if alloc && source == None {
        return jet_cli_perf_error("`--lens=alloc` names each live block by its line in `--source`, which is missing", "run `jet perf attach {target_pid} --lens=alloc --source <file.jet>`", color)
    }
    if !perf_files.is_dir("/proc/{target_pid}") {
        return jet_cli_perf_error("process {target_pid} is not running or not visible to this user", "start the program with `jet run --observe`, then attach to that pid", color)
    }
    target: jet_cli_perf_session_target()
    // Attach is a point capture: the trace session's origin is now.
    observations := [JetCLIPerfObservation]{}
    live_error := String?{None}
    if jet_cli_perf_live_read(target_pid) == {
        .Ok(live) -> { observations.push(JetCLIPerfObservation{at_ns: U64{0}, live: live}) }
        .Err(failure) -> live_error = Val(failure.message)
    }
    capture := jet_cli_perf_capture_new(trace_profile_unsupported("source sampling requires a source capture"), [SourceIdentity]{})
    browser := JetCLIPerfBrowser?{None}
    if jet_cli_perf_attach_browser(target_pid, source == None) == {
        .Ok(found) -> browser = found
        .Err(failure) -> return jet_cli_perf_error(failure.message, JET_CLI_PERF_FIX, color)
    }
    if browser == .Val(relayed) {
        if alloc {
            return jet_cli_perf_error("process {target_pid} is a devserver browser session, whose heap jet does not track", "attach to a program started with `jet run --observe --checked-alloc <file.jet>`", color)
        }
        if source == .Val(path) {
            matched := false
            loop identity in relayed.sources {
                if identity.path == path -> matched = true
            }
            if !matched {
                return jet_cli_perf_error("`--source` does not match the devserver browser session", JET_CLI_PERF_FIX, color)
            }
        }
        capture = jet_cli_perf_capture_browser(relayed, observations, target) ?? return jet_cli_perf_error(err.message, JET_CLI_PERF_FIX, color)
    } else if source == .Val(path) {
        if live_error == .Val(message) {
            return jet_cli_perf_error(message, "start the program with `jet run --observe`, then attach", color)
        }
        text: perf_files.read(path) ?? return jet_cli_perf_error("cannot read source {path}: {jet_cli_io_error_text(err)}", JET_CLI_PERF_FIX, color)
        // With `--zones=`, the program's zones, frame marks, plots and log
        // spans for that window, before its ring is read.
        spans: if zones_ms > 0 -> jet_cli_perf_attach_zones(target_pid, zones_ms) else -> None
        // The flight ring the program publishes: its recent samples, waits,
        // wakes, spawns and transfers, read as a run's are.
        flight: jet_cli_perf_attach_flight(target_pid, path)
        capture = jet_cli_perf_capture_source(path, text, observations, flight, target, None) ?? return jet_cli_perf_error(err.message, JET_CLI_PERF_FIX, color)
        if alloc {
            heap: jet_cli_perf_attach_heap(target_pid, path) ?? return jet_cli_perf_error(err.message, "start the program with `jet run --observe --checked-alloc {path}`, then attach with `--lens=alloc`", color)
            held_ns = Val(heap.held_ns)
            // copy: the attach keeps its source; the section owns its own.
            if jet_cli_perf_session_heaps(path.copy(), heap.samples.heaps.move()) == .Val(section) {
                capture.receipts.push(section)
            }
        }
        // The ring's rows are timed from its earliest wait or transfer, or
        // the window's first zone row, on the program's monotonic clock:
        // attach has no start of its own on it.
        origin := 0
        if spans == .Val(taken) -> origin = jet_cli_perf_spans_first(taken)
        // The ring's CPU-time samples, which the window's zones hold.
        timed := [JetCLIPerfTimed]{}
        if flight.move() == .Val(found) {
            loop wait in found.waits {
                if origin == 0 || wait.start_ns < origin -> origin = wait.start_ns
            }
            loop transfer in found.transfers {
                if origin == 0 || transfer.start_ns < origin -> origin = transfer.start_ns
            }
            timed = found.timed.move()
            jet_cli_perf_waits_read(capture, found.waits.move(), found.wakes, found.spawns, found.transfers, path, origin)
            jet_cli_perf_io_read(capture, found.transfers.move(), path, origin)
        }
        if spans == .Val(taken) -> jet_cli_perf_log_spans_read(capture, taken, path, origin, timed)
    } else if live_error == None {
        return JetDriverVerbOutput{stdout: "", stderr: jet_cli_report("E2102", "live observe snapshot found, but `--source` is required", "domain capture must attribute facts to a Jet symbol identity", "run `jet perf attach {target_pid} --source <file.jet>`", color), exit_code: JET_DRIVER_EXIT_USAGE}
    }
    argv := [String]{"attach", "{target_pid}"}
    // The attach request's last use of its source: the recorded argv owns it.
    if source.move() == .Val(path) {
        argv.push("--source")
        argv.push(path)
    }
    if allowlist.len() > 0 {
        argv.push("--capture")
        argv.push(allowlist.join(","))
    }
    if zones_ms > 0 -> argv.push("--zones={zones_ms}ms")
    if alloc -> argv.push("--lens=alloc")
    capture.policy.allowlist = allowlist
    path: jet_cli_perf_session_write(capture, "attach", argv, out) ?? return jet_cli_perf_error(err.message, JET_CLI_PERF_FIX, color)
    // How long the snapshot held the program: its allocations and frees
    // waited while the runtime forked the copy that wrote it.
    held: if held_ns == .Val(ns) -> "Heap snapshot: held the program's allocations and frees for {ns /% 1000} µs\n" else -> ""
    JetDriverVerbOutput{stdout: "", stderr: if quiet -> "" else -> "{held}Trace: {path}\n", exit_code: JET_DRIVER_EXIT_OK}
}

// The flight ring the observed program `pid` publishes in the temporary
// directory (JetRuntime PerfSamples.jet perf_flight_publish) and the image
// beside it, copied out of its way, then read as a run's samples are; the
// program keeps publishing its own. Lines in `source` are its own. None when
// it publishes no ring.
jet_cli_perf_attach_flight: fn(pid: Int, source: String) -[FS, Env, Time]> JetCLIPerfSamples? Never! {
    published: perf_files.join(perf_sys.temp_dir(), "jet-flight-{pid}.samples")
    taken: perf_files.join(perf_sys.temp_dir(), "jet-perf-attach-{pid}-{perf_time.unix_ns()}.samples")
    perf_files.copy(published, taken) ?? return None
    if perf_files.copy("{published}.image", "{taken}.image") == .Err(_) {
        perf_files.remove(taken).drop("the attach reads the ring it copied once")
        return None
    }
    jet_cli_perf_samples_read(taken, source, [TraceCounter]{}, None)
}

// `--lens=alloc`'s heap snapshot of the flight-recorded program `pid`, taken
// while it runs, and how long it held the program, in nanoseconds. The
// request is left beside the program's published ring; the writer thread
// that publishes the ring every 100 ms notices it there (JetRuntime
// PerfSamples.jet perf_flight_heap) and answers in `<ring>.heap`: the hold,
// -1 when the program keeps no list of its live blocks, then the snapshot's
// records, read beside a copy of the ring's image as a run's samples are.
// Lines in `source` are its own.
jet_cli_perf_attach_heap: fn(pid: Int, source: String) -[FS, Env, Time]> JetCLIPerfAttachHeap JetCLIReadError! {
    ring: perf_files.join(perf_sys.temp_dir(), "jet-flight-{pid}.samples")
    answer: "{ring}.heap"
    request: "{ring}.heap-request"
    perf_files.remove(answer).drop("an earlier attach's answer is none to this request")
    perf_files.write(request, "") ?? return Err(jet_cli_read_error("cannot ask process {pid} for a heap snapshot: {jet_cli_io_error_text(err)}"))
    answered := false
    loop _ in 0..<JET_CLI_PERF_HEAP_WAITS {
        perf_time.sleep(25ms)
        if perf_files.exists(answer) {
            answered = true
            break
        }
    }
    if !answered {
        perf_files.remove(request).drop("an unanswered request is only withdrawn")
        return Err(jet_cli_read_error("process {pid} did not answer the heap snapshot request within 5 s: it publishes no flight ring"))
    }
    bytes: perf_files.read_bytes(answer) ?? return Err(jet_cli_read_error("cannot read process {pid}'s heap snapshot: {jet_cli_io_error_text(err)}"))
    perf_files.remove(answer).drop("the attach reads the answer once")
    if bytes.len() < 8 {
        return Err(jet_cli_read_error("process {pid} answered the heap snapshot request with no hold"))
    }
    if bytes[7] == (U8{255}) {
        return Err(jet_cli_read_error("process {pid} keeps no list of its live blocks: it was not started with allocation tracking"))
    }
    taken: perf_files.join(perf_sys.temp_dir(), "jet-perf-attach-{pid}-{perf_time.unix_ns()}.heap")
    perf_files.write_bytes(taken, bytes.slice(8, bytes.len())) ?? return Err(jet_cli_read_error("cannot keep process {pid}'s heap snapshot: {jet_cli_io_error_text(err)}"))
    if perf_files.copy("{ring}.image", "{taken}.image") == .Err(failure) {
        perf_files.remove(taken).drop("the attach reads the snapshot it kept once")
        return Err(jet_cli_read_error("cannot copy process {pid}'s image: {jet_cli_io_error_text(failure)}"))
    }
    samples: jet_cli_perf_samples_read(taken, source, [TraceCounter]{}, None) ?? return Err(jet_cli_read_error("process {pid}'s heap snapshot names no line: its image has no line table"))
    Ok(JetCLIPerfAttachHeap{samples: samples, held_ns: link_debug_addr(bytes, 0)})
}

// An attach's heap snapshot (jet_cli_perf_attach_heap): its records, read,
// and how long it held the program, in nanoseconds.
JetCLIPerfAttachHeap: struct {
    samples: JetCLIPerfSamples,
    held_ns: Int,
}

// The 25 ms waits an attach gives the program to answer a heap snapshot
// request: 5 s, fifty of its publications.
JET_CLI_PERF_HEAP_WAITS: 200

// `--zones=` window: whole milliseconds or seconds (`500ms`, `2s`), above 0.
jet_cli_perf_attach_window: fn(text: String) -> Int? Never! {
    if text.ends_with("ms") {
        value: Int.parse(text.slice(0..<text.len() - 2)) ?? return None
        return if value > 0 -> Val(value) else -> None
    }
    if text.ends_with("s") {
        value: Int.parse(text.slice(0..<text.len() - 1)) ?? return None
        return if value > 0 && value <= 3600 -> Val(value * 1000) else -> None
    }
    None
}

// Turn zones on in the flight-recorded program `pid` for `window_ms`: leave
// the request beside its published ring (JetRuntime PerfSamples.jet
// perf_flight_zones), which its next publication (every 100 ms) answers by
// recording zones, frame marks, plots and log spans to `<ring>.spans`;
// remove it after the window and wait two publications, so the program has
// turned them off and written its rows. The rows, copied out of the
// program's way; None when it wrote none.
jet_cli_perf_attach_zones: fn(pid: Int, window_ms: Int) -[FS, Env, Time]> String? Never! {
    ring: perf_files.join(perf_sys.temp_dir(), "jet-flight-{pid}.samples")
    request: "{ring}.zones"
    perf_files.write(request, "") ?? return None
    loop _ in 0..<(window_ms + 24) /% 25 -> perf_time.sleep(25ms)
    perf_files.remove(request).drop("a request the program no longer sees turns zones off")
    perf_time.sleep(250ms)
    taken: perf_files.join(perf_sys.temp_dir(), "jet-perf-attach-{pid}-{perf_time.unix_ns()}.spans")
    perf_files.copy("{ring}.spans", taken) ?? return None
    Val(taken)
}

// The start of the first row of the spans file `path`, 0 when it has none.
jet_cli_perf_spans_first: fn(path: String) -[FS]> Int Never! {
    bytes: perf_files.read_bytes(path) ?? return 0
    if bytes.len() < 32 -> return 0
    start := 0
    loop at in 0..<8 -> start = start | (Int{bytes[at]} << (8 * at))
    start
}

// `read_browser_capture`: the devserver's browser relay for `pid`, or None
// where it publishes none. With `activate`, a missing relay is requested and
// awaited for two seconds; a relay that appears is given 1.6 seconds to
// collect rows before it is read.
jet_cli_perf_attach_browser: fn(pid: Int, activate: Bool) -[FS, Env, Time]> JetCLIPerfBrowser? JetCLIReadError! {
    relay: perf_files.join(perf_sys.temp_dir(), "jet-browser-trace-{pid}.relay")
    if jet_cli_perf_browser_read(pid) == {
        .Ok(capture) -> return Ok(Val(capture))
        .Err(failure) -> {
            if perf_files.exists(relay) -> return Err(failure)
            if !activate -> return Ok(None)
        }
    }
    _: jet_cli_perf_browser_request(pid)
    deadline: perf_time.instant()
    loop deadline.elapsed().ns < 2000000000 {
        if perf_files.exists(relay) {
            perf_time.sleep(1600ms)
            return Ok(Val(jet_cli_perf_browser_read(pid)))
        }
        perf_time.sleep(25ms)
    }
    jet_cli_perf_browser_cancel_request(pid).drop("an unanswered relay request is only withdrawn")
    Ok(None)
}

// The observations of the session's root process, and of the first
// descendant that publishes its own. The root is the `jet` host: under
// `jet run --observe` it publishes nothing itself, so what its pid publishes
// is the program, run in jet's place; a program that ran in a child process
// publishes under the child's pid.
JetCLIPerfSessionObserved: struct {
    root: [JetCLIPerfObservation],
    program: [JetCLIPerfObservation],
    program_pid: Int?,
}

// One poll of the process tree under `root` into the session
// (`poll_observe_snapshot`).
jet_cli_perf_session_observe: fn(observed: &JetCLIPerfSessionObserved, root: Int) -[FS.Read, Env, Time]> Never! {
    if jet_cli_perf_live_read(root) == .Ok(live) {
        jet_cli_perf_session_keep(observed.root, jet_cli_perf_observed(live))
    }
    if observed.program_pid == .Val(pid) {
        if jet_cli_perf_live_read(pid) == .Ok(live) {
            jet_cli_perf_session_keep(observed.program, jet_cli_perf_observed(live))
        }
        return
    }
    pending := jet_cli_perf_session_children(root)
    seen := [Int]{root}
    loop pending.len() > 0 {
        pid: pending.pop() ?? break
        if seen.contains(pid) -> next
        seen.push(pid)
        if jet_cli_perf_live_read(pid) == .Ok(live) {
            observed.program_pid = Val(pid)
            jet_cli_perf_session_keep(observed.program, jet_cli_perf_observed(live))
            return
        }
        loop child in jet_cli_perf_session_children(pid) -> pending.push(child)
    }
}

// An observation at its publication's own moment: the run's elapsed time on
// the program's clock, from the process epoch its zones, waits and log spans
// are timed from (ObserveLive.jet observe_live_start), so its task rows line
// up with theirs. The run's first publication precedes its entry.
jet_cli_perf_observed: fn(live: &&JetCLIPerfLive) -> JetCLIPerfObservation Never! {
    JetCLIPerfObservation{at_ns: live.runtime.elapsed_ns, live: live}
}

// Observations stay within the capture's 4096-row bound: past it, the newest
// replaces the previous newest, so the first and the final one are kept.
jet_cli_perf_session_keep: fn(rows: &[JetCLIPerfObservation], observation: &&JetCLIPerfObservation) Never! {
    if rows.len() >= 4096 {
        rows[rows.len() - 1] = observation
        return
    }
    rows.push(observation)
}

// `process_children`: the kernel's per-thread child lists; empty where
// `/proc` cannot tell.
jet_cli_perf_session_children: fn(pid: Int) -[FS.Read]> [Int] Never! {
    kids := [Int]{}
    tasks: perf_files.list_dir("/proc/{pid}/task") ?? return kids
    loop task in tasks {
        text: perf_files.read("/proc/{pid}/task/{task.name}/children") ?? next
        loop word in jet_cli_find_words(text) {
            child: Int.parse(word) ?? next
            if !kids.contains(child) -> kids.push(child)
        }
    }
    kids
}

// The host target triple (`JET_BUILD_TARGET`).
jet_cli_perf_session_target: fn() -[Env]> String Never! {
    jet_cli_host_triple(perf_sys.arch(), perf_sys.name())
}

// The session's `perf` receipt section: the build `jet run` compiled the
// program under, its profile and every build option's resolved value, as
// the run resolves its words and its source's profiles
// (jet_cli_build_options), and the capture's settings: the privacy fields
// it keeps, and, where the program `sampled`, its `lenses`, with each
// allocation's call sites and, under the `cpu` lens, its CPU-time sampling
// every JET_CLI_PERF_SAMPLE_US of CPU time and the `pc` its samples were
// charged by (jet_cli_perf_pc_json). A `jet test` resolves its build
// through its settings layers too (jet_cli_test_file), which the session
// does not, so its build is null, as is the build of words the run refused.
jet_cli_perf_session_receipt: fn(action: String, argv: [String], source: String?, allowlist: [String], sampled: Bool, lenses: [String], pc: CanonicalJSON) -[FS, Env]> TraceReceiptSection JetCLIReadError! {
    build := CanonicalJSON.Null
    if action == "run" {
        file: source ?? ""
        text: perf_files.read(file) ?? ""
        if jet_cli_build_options(argv, action, file, text, false, true) == .Selected(options, _) {
            values := [CanonicalJSONField]{}
            loop choice in options.values.move() {
                values.push(CanonicalJSONField{key: choice.name.move(), value: CanonicalJSON.String(choice.value.move())})
            }
            resolved: canonical_json_object(values) ?? return Err(jet_cli_read_error(err.message))
            profile: jet_cli_profile_name(argv)
            named: if profile == "" -> CanonicalJSON.Null else -> CanonicalJSON.String(profile)
            build = CanonicalJSON.Object([CanonicalJSONField]{{key: "options", value: resolved}, {key: "profile", value: named}})
        }
    }
    sampling := CanonicalJSON.Null
    if sampled {
        cpu: lenses.contains("cpu")
        // Each lens the run took, in jet_cli_perf_session_lenses's order:
        // `causal` rides on `cpu`'s samples, so its run names both.
        named := [CanonicalJSON]{}
        loop lens in lenses -> named.push(CanonicalJSON.String("{lens}"))
        sampling = CanonicalJSON.Object(
            [CanonicalJSONField]{
                {key: "allocations", value: CanonicalJSON.String("call-sites")},
                {key: "clock", value: if cpu -> CanonicalJSON.String("cpu") else -> CanonicalJSON.Null},
                {key: "interval_us", value: if cpu -> CanonicalJSON.Integer("{JET_CLI_PERF_SAMPLE_US}") else -> CanonicalJSON.Null},
                {key: "lenses", value: CanonicalJSON.Array(named)},
                {key: "pc", value: if cpu -> pc else -> CanonicalJSON.Null},
            },
        )
    }
    kept: if allowlist.len() == 0 -> CanonicalJSON.Null else -> CanonicalJSON.String(allowlist.join(","))
    capture: CanonicalJSON.Object([CanonicalJSONField]{{key: "allowlist", value: kept}, {key: "sampling", value: sampling}})
    value: CanonicalJSON.Object([CanonicalJSONField]{{key: "build", value: build}, {key: "capture", value: capture}})
    digest: canonical_json_sha256(value)
    Ok(TraceReceiptSection{name: "perf", type_name: "JetPerfReceipt", value: value, digest: digest})
}

// The trace's `heap` receipt section: each heap snapshot the alloc lens took
// of a run of `source`, in the order it took them (JetCLIPerfHeap), with
// its name, its number, its live blocks and their bytes, and those blocks
// by the function and line of `source` that allocated them and the type
// they were allocated for, the most bytes first: a null function and line
// for the blocks no line of it allocated, a null type for those no typed
// allocating call allocated; then what retains its typed blocks
// (`retained`, JetCLIPerfRetained), by type and path, a null path for the
// blocks no root reached. None when it took none.
jet_cli_perf_session_heaps: fn(source: &&String, heaps: &&[JetCLIPerfHeap]) -> TraceReceiptSection? Never! {
    if heaps.len() == 0 -> return None
    snapshots := [CanonicalJSON]{}
    loop heap in heaps.move() {
        sites := [CanonicalJSON]{}
        loop site in heap.sites.move() {
            placed: site.line > (U64{0})
            typed: site.type_name != ""
            sites.push(
                CanonicalJSON.Object(
                    [CanonicalJSONField]{
                        {key: "blocks", value: CanonicalJSON.Integer("{site.blocks}")},
                        {key: "bytes", value: CanonicalJSON.Integer("{site.bytes}")},
                        {key: "function", value: if placed -> CanonicalJSON.String(site.name.move()) else -> CanonicalJSON.Null},
                        {key: "line", value: if placed -> CanonicalJSON.Integer("{site.line}") else -> CanonicalJSON.Null},
                        {key: "type", value: if typed -> CanonicalJSON.String(site.type_name.move()) else -> CanonicalJSON.Null},
                    },
                ),
            )
        }
        retained := [CanonicalJSON]{}
        loop entry in heap.retained.move() {
            rooted: entry.path != ""
            retained.push(
                CanonicalJSON.Object(
                    [CanonicalJSONField]{
                        {key: "blocks", value: CanonicalJSON.Integer("{entry.blocks}")},
                        {key: "bytes", value: CanonicalJSON.Integer("{entry.bytes}")},
                        {key: "path", value: if rooted -> CanonicalJSON.String(entry.path.move()) else -> CanonicalJSON.Null},
                        {key: "type", value: CanonicalJSON.String(entry.type_name.move())},
                    },
                ),
            )
        }
        snapshots.push(
            CanonicalJSON.Object(
                [CanonicalJSONField]{
                    {key: "blocks", value: CanonicalJSON.Integer("{heap.blocks}")},
                    {key: "bytes", value: CanonicalJSON.Integer("{heap.bytes}")},
                    {key: "name", value: CanonicalJSON.String(heap.name.move())},
                    {key: "number", value: CanonicalJSON.Integer("{heap.number}")},
                    {key: "retained", value: CanonicalJSON.Array(retained.move())},
                    {key: "sites", value: CanonicalJSON.Array(sites.move())},
                },
            ),
        )
    }
    value: CanonicalJSON.Object([CanonicalJSONField]{{key: "path", value: CanonicalJSON.String(source.move())}, {key: "snapshots", value: CanonicalJSON.Array(snapshots.move())}})
    digest: canonical_json_sha256(value)
    Val(TraceReceiptSection{name: "heap", type_name: "JetPerfHeapSnapshots", value: value, digest: digest})
}

// The trace's `allocations` receipt section: the allocations the alloc
// lens counted in a run of `source` (JetCLIPerfAllocSite), all of them and
// their bytes, then by the function and line of `source` that allocated
// them and the type they were allocated for, the most bytes first, a null
// function and line for those no line of it allocated, a null type for
// those no typed allocating call allocated; and what counting them cost:
// the time the lens spent on them, as the runtime timed it on each
// allocation (PerfSamples.jet perf_samples_alloc_site). None when the run
// recorded no allocation.
jet_cli_perf_session_allocations: fn(source: &&String, sited: Bool, allocated: &&[JetCLIPerfAllocSite], charged: JetCLIPerfCost?) -> TraceReceiptSection? Never! {
    if !sited -> return None
    sites := [CanonicalJSON]{}
    allocations := U64{0}
    bytes := U64{0}
    loop site in allocated.move() {
        placed: site.line > (U64{0})
        typed: site.type_name != ""
        allocations += site.allocations
        bytes += site.bytes
        sites.push(
            CanonicalJSON.Object(
                [CanonicalJSONField]{
                    {key: "allocations", value: CanonicalJSON.Integer("{site.allocations}")},
                    {key: "bytes", value: CanonicalJSON.Integer("{site.bytes}")},
                    {key: "function", value: if placed -> CanonicalJSON.String(site.name.move()) else -> CanonicalJSON.Null},
                    {key: "line", value: if placed -> CanonicalJSON.Integer("{site.line}") else -> CanonicalJSON.Null},
                    {key: "type", value: if typed -> CanonicalJSON.String(site.type_name.move()) else -> CanonicalJSON.Null},
                },
            ),
        )
    }
    overhead := CanonicalJSON.Null
    status := "not_measured"
    why := "the runtime recorded no cost of the alloc lens"
    if charged == .Val(cost) {
        if cost.alloc_count > (U64{0}) {
            overhead = CanonicalJSON.Integer("{cost.alloc_ns}")
            status = "measured"
            why = "the alloc lens took {cost.alloc_ns / U64{1000}} microseconds over {cost.alloc_count} allocations, {cost.alloc_ns / cost.alloc_count} nanoseconds each, {jet_cli_perf_hundredths(cost.alloc_ns, cost.cpu_ns)} of the {cost.cpu_ns / U64{1000}} microseconds of CPU time: each allocation waited for the checked heap's quarantine lock, linked its block on the live list and counted at its call sites, timed from before the wait to after the count"
        }
    }
    value: CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "allocations", value: CanonicalJSON.Integer("{allocations}")},
            {key: "bytes", value: CanonicalJSON.Integer("{bytes}")},
            {key: "overhead_ns", value: overhead.move()},
            {key: "overhead_reason", value: CanonicalJSON.String(why.move())},
            {key: "overhead_status", value: CanonicalJSON.String(status.move())},
            {key: "path", value: CanonicalJSON.String(source.move())},
            {key: "sites", value: CanonicalJSON.Array(sites.move())},
        },
    )
    digest: canonical_json_sha256(value)
    Val(TraceReceiptSection{name: "allocations", type_name: "JetPerfAllocations", value: value, digest: digest})
}

// `write_session_trace`: the trace goes to `out`, else to
// `<project root>/.jet/perf/<unix seconds>-<trace id prefix>.jettrace`; it is
// published owner-only and read back verified.
jet_cli_perf_session_write: fn(capture: JetCLIPerfCapture, action: String, argv: [String], out: String?) -[FS, Env, Time]> String JetCLIReadError! {
    toolchain: TraceToolchain{jet_version: JET_VERSION, compiler_build_id: jet_cli_compiler_identity() ?? JET_VERSION, stdlib_id: "jet-stdlib", runner_id: "jet-perf"}
    hardware: TraceHardware{cpu_arch: perf_sys.arch(), logical_cpus: checked(U64{perf_sys.cpu_count()}) ?? U64{1}, os: perf_sys.name(), target: jet_cli_perf_session_target()}
    bytes: jet_cli_perf_capture_bytes(capture, action, argv, toolchain, hardware)
    cwd: perf_files.cwd() ?? return Err(jet_cli_read_error("cannot resolve the working directory: {jet_cli_io_error_text(err)}"))
    path := ""
    if out == .Val(chosen) {
        path = if chosen.starts_with("/") -> chosen else -> perf_files.join(cwd, chosen)
    } else {
        verified: verify_jettrace(bytes) ?? return Err(jet_cli_read_error(err.message))
        id: trace_id(verified) ?? return Err(jet_cli_read_error("the trace has no id"))
        cache := WorkspaceDeclarationCache.new()
        root: jet_cli_selected_project_root(cache, cwd) ?? cwd
        stamp: perf_time.unix_ns() /% 1000000000
        path = perf_files.join(perf_files.join(perf_files.join(root, ".jet"), "perf"), "{stamp}-{id.slice(0..<8)}{artifact_extension()}")
    }
    parent: perf_files.dirname(path)
    name: perf_files.basename(path)
    perf_files.create_dir_all(parent) ?? return Err(jet_cli_read_error("cannot create {parent}: {jet_cli_io_error_text(err)}"))
    real: perf_files.realpath(parent) ?? return Err(jet_cli_read_error("cannot resolve {parent}: {jet_cli_io_error_text(err)}"))
    held: JetCLIRootedDirectory.open(real, [String]{}, false) ?? return Err(err)
    held.replace(name, bytes, Val(0o600)) ?? return Err(err)
    read_back: held.read(name, JET_CLI_PERF_TRACE_LIMIT)
    written: read_back ?? return Err(jet_cli_read_error("cannot re-read {path}"))
    _: verify_jettrace(written) ?? return Err(jet_cli_read_error("wrote an unverifiable jettrace: {err.message}"))
    Ok(path)
}
