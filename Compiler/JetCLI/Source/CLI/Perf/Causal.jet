use {
    jet_backend.[link_debug_addr]
    jet_foundation.[CanonicalJSON, CanonicalJSONField, TraceReceiptSection, canonical_json_sha256]
}

// The causal lens (`jet perf run --lens=causal`). The runtime runs virtual
// speedup experiments (PerfSamples.jet perf_causal_tick): each one either
// leaves the program alone (a baseline) or slows every other thread down
// whenever the chosen line runs, so the line runs as if a share faster than
// the rest. Each progress point's passes per second between its first and
// last pass in the experiment, less the delay inserted meanwhile, against
// the baselines' passes per second, predicts how much sooner the passes
// would come if the line really were that much faster. This file turns the
// experiments into a ranked prediction per progress point, each with an
// interval and warmed by how much slower a task runs after its CPU idled
// (jet_cli_perf_causal_warm), and refuses a line or a run whose experiments
// are too few to rank, and a run whose threads waited too long for a CPU
// to be trusted.

// One experiment's end (PerfSamples.jet perf_causal_next): the line it sped
// up, by its source line and function (line 0 for a baseline), the speedup
// in thousandths, the run time and the runqueue wait the program's threads
// took meanwhile, in nanoseconds, the highest and the lowest clock of the
// CPUs those that ran last ran on, in kHz (0 when unread), and by each
// progress point's slot: its passes after its first one in the experiment,
// and the wall time from that first pass to its last and the delay inserted
// between them, in nanoseconds. The record's whole wall time and delay are
// not kept: only the time between a point's own passes measures its rate.
JetCLIPerfExperiment: struct {
    line: U64,
    name: String,
    speedup: Int,
    run_ns: Int,
    wait_ns: Int,
    khz_high: Int,
    khz_low: Int,
    after: [Int],
    span_ns: [Int],
    span_delay_ns: [Int],
}

// The experiments a line or the baseline needs before it is ranked.
JET_CLI_PERF_CAUSAL_MIN: 6

// The widest interval, in tenths of a percent, a ranked line may have.
JET_CLI_PERF_CAUSAL_WIDEST: 300

// The resamples behind each interval, and the share of them below its low
// end and above its high end, in resamples: a 90% interval.
JET_CLI_PERF_CAUSAL_RESAMPLES: 200

JET_CLI_PERF_CAUSAL_TAIL: 10

// The most runqueue wait, in thousandths of their run time, that the
// program's threads may take over the experiments before the lens
// withholds its gains. A paused thread spins on its CPU (PerfSamples.jet
// perf_causal_pause). That is right while each runnable thread has a CPU.
// When more threads are runnable than there are CPUs, a line made
// virtually faster frees no CPU for the rest, as a really faster one
// would, so each gain reads low by a share that grows with the wait.
//
// The threshold comes from a processor-sharing model of the
// CausalProfilePredictsSpeedup fixture: one narrow task and three wide
// ones on S CPUs, checked against the truth of a line with 30% less work.
// A baseline round's wait/run, and how many points low the narrow line's
// gain reads:
// - 0 (S 4, the dedicated regime): 0 points;
// - 0.134 (S 3.5): 0.5;
// - 0.216 (S 3.25): 1.1;
// - 0.312 (S 3): 2.0;
// - 0.806 (S 2.15, the contended regime): 5.0, and the wide line 5.6.
// At S 2.15 both lines fall outside their intervals.
//
// The kernel counts both the CPUs other work holds and a cgroup's
// throttling as wait. Four spinning threads capped at one CPU waited 2.64
// of their run time (the model's 3). Given four CPUs, at a machine load of
// 160, they waited 0.000.
//
// At 200, a gain reads at most about a point low, inside any interval the
// lens ranks, and the contended regime is refused four times over.
JET_CLI_PERF_CAUSAL_WAIT_MOST: 200

// The most, in thousandths of the highest clock, that the lowest clock of
// the CPUs the program's threads ran on may fall below it, averaged over the
// experiments, before the lens flags its gains. A CPU that idled clocks
// down, and a task begun on it runs slower than its siblings until it
// clocks up. Where a round waits for its slowest task, that time lands on
// whichever line the late task runs, not on the line an experiment speeds
// up, so every gain reads low by a share that grows with the drop. On a
// quiet machine (load 2.6, `-O1`), 1,333 of the fixture's 2,809 slowest
// rounds had a late task begun at 3,908 MHz beside siblings at 4,993: a
// drop of 22%, its CPU idle for 1.4 ms before against their 0.7. The lens
// warms its gains by the idle table's fit instead (jet_cli_perf_causal_fit)
// and flags them only when it cannot fit it.
JET_CLI_PERF_CAUSAL_CLOCK_MOST: 100

// The wall time of one experiment, PerfSamples.jet
// PERF_CAUSAL_EXPERIMENT_NS, in milliseconds.
JET_CLI_PERF_CAUSAL_EXPERIMENT_MS: 25

// The experiment of the record at byte `at` of `words`, `record` words long:
// the line its sampled address stands for (jet_cli_perf_causal_place); line
// 0 when the address is 0 (a baseline, with no speedup) or none stands for
// it.
jet_cli_perf_causal_record: fn(sampled: JetCLIPerfSamples, owned: [Bool], words: [U8], at: Int, record: Int) -> JetCLIPerfExperiment Never! {
    target: link_debug_addr(words, at + 8)
    place: if target != 0 -> jet_cli_perf_causal_place(sampled, owned, target) else -> JetCLIPerfCausalPlace{line: U64{0}, name: ""}
    // The record's words after its first nine: three columns of one word
    // per progress point's slot.
    points: (record - 9) /% 3
    JetCLIPerfExperiment{
        line: place.line,
        name: place.name.move(),
        speedup: link_debug_addr(words, at + 16),
        run_ns: link_debug_addr(words, at + 40),
        wait_ns: link_debug_addr(words, at + 48),
        khz_high: link_debug_addr(words, at + 56),
        khz_low: link_debug_addr(words, at + 64),
        after: jet_cli_perf_causal_column(words, at, points, 0),
        span_ns: jet_cli_perf_causal_column(words, at, points, 1),
        span_delay_ns: jet_cli_perf_causal_column(words, at, points, 2),
    }
}

// A source line, and the function it is in.
JetCLIPerfCausalPlace: struct {
    line: U64,
    name: String,
}

// The line link-time address `address` stands for: the innermost frame of
// the checked source there; line 0 and no name when none is.
jet_cli_perf_causal_place: fn(sampled: JetCLIPerfSamples, owned: [Bool], address: Int) -> JetCLIPerfCausalPlace Never! {
    frames := jet_cli_perf_samples_frames(sampled, owned, address, false)
    frames.reverse()
    loop frames.len() > 0 {
        frame: frames.pop() ?? break
        if frame.own -> return JetCLIPerfCausalPlace{line: U64{frame.line}, name: frame.name.move()}
    }
    JetCLIPerfCausalPlace{line: U64{0}, name: ""}
}

// Column `column` of the causal record at byte `at` of `words`, one word per
// slot of its `points` progress points.
jet_cli_perf_causal_column: fn(words: [U8], at: Int, points: Int, column: Int) -> [Int] Never! {
    loop slot in 0..<points -> link_debug_addr(words, at + (9 + column * points + slot) * 8)
}

// The experiments that sped up one line of one function.
JetCLIPerfCausalGroup: struct {
    line: U64,
    name: String,
    chosen: [Int],
}

// One line's prediction for one progress point: how much sooner each pass
// comes, in tenths of a percent, with its 90% interval.
JetCLIPerfCausalLine: struct {
    line: U64,
    name: String,
    experiments: Int,
    gain: Int,
    low: Int,
    high: Int,
}

// A rate of passes: the passes after each experiment's first and the wall
// time from its first pass to its last, less the delay inserted
// meanwhile, in microseconds.
JetCLIPerfCausalRate: struct {
    passes: Int,
    wall: Int,
}

// The rate of `chosen` (indexes into `experiments`) for point `slot`. Only
// the time between an experiment's own passes counts: how far its start or
// end falls from a pass depends on which line ran then, which is how its
// line was chosen.
jet_cli_perf_causal_sum: fn(experiments: [JetCLIPerfExperiment], chosen: [Int], slot: Int) -> JetCLIPerfCausalRate Never! {
    passes := 0
    wall := 0
    loop index in chosen {
        experiment: experiments[index]
        if slot < experiment.after.len() {
            passes += experiment.after[slot]
            wall += (experiment.span_ns[slot] - experiment.span_delay_ns[slot]) /% 1000
        }
    }
    JetCLIPerfCausalRate{passes: passes, wall: wall}
}

// How much sooner each pass comes, in tenths of a percent, at the line's
// rate `line` against the baselines' rate `base`: 1 - (base rate / line
// rate). None when either rate is empty.
jet_cli_perf_causal_gain: fn(base: JetCLIPerfCausalRate, line: JetCLIPerfCausalRate) -> Int? Never! {
    if base.passes <= 0 || base.wall <= 0 || line.passes <= 0 || line.wall <= 0 -> return None
    Val(1000 - (base.passes * 1000 * line.wall) /% (base.wall * line.passes))
}

// The next of the resampling's random numbers below `bound`: a fixed seed,
// so the same trace gives the same intervals. The step is a 64-bit linear
// congruential one, kept to its low 63 bits.
jet_cli_perf_causal_draw: fn(state: ^U64, bound: Int) -> Int Never! {
    state = wrapping(wrapping(state * U64{6364136223846793005}) + U64{1442695040888963407}) & U64{9223372036854775807}
    Int{state >> 17} %% bound
}

// `chosen` drawn again with replacement.
jet_cli_perf_causal_resample: fn(chosen: [Int], state: ^U64) -> [Int] Never! {
    loop _ in 0..<chosen.len() -> chosen[jet_cli_perf_causal_draw(state, chosen.len())]
}

// The prediction of the line whose experiments are `chosen` for point
// `slot` against the baselines `base`, each gain warmed by `fit`
// (jet_cli_perf_causal_warm); None when either has no pass.
jet_cli_perf_causal_line: fn(experiments: [JetCLIPerfExperiment], base: [Int], chosen: [Int], slot: Int, fit: JetCLIPerfCausalFit) -> JetCLIPerfCausalLine? Never! {
    virtual: jet_cli_perf_causal_gain(jet_cli_perf_causal_sum(experiments, base, slot), jet_cli_perf_causal_sum(experiments, chosen, slot)) ?? return None
    gain: jet_cli_perf_causal_warm(fit, virtual)
    state := U64{88172645463325252 + slot}
    gains := [Int]{}
    loop _ in 0..<JET_CLI_PERF_CAUSAL_RESAMPLES {
        drawn_base: jet_cli_perf_causal_sum(experiments, jet_cli_perf_causal_resample(base, state), slot)
        drawn: jet_cli_perf_causal_sum(experiments, jet_cli_perf_causal_resample(chosen, state), slot)
        // A resample with no pass predicts nothing faster: the line made
        // the point's passes stop.
        resampled: jet_cli_perf_causal_gain(drawn_base, drawn) ?? -1000
        gains.push(if resampled == -1000 -> resampled else -> jet_cli_perf_causal_warm(fit, resampled))
    }
    gains.sort()
    first: experiments[chosen[0]]
    Val(JetCLIPerfCausalLine{line: first.line, name: "{first.name}", experiments: chosen.len(), gain: gain, low: gains[JET_CLI_PERF_CAUSAL_TAIL], high: gains[JET_CLI_PERF_CAUSAL_RESAMPLES - 1 - JET_CLI_PERF_CAUSAL_TAIL]})
}

// The idle table's octaves of idle gap a task body's row holds
// (PerfSamples.jet PERF_CAUSAL_GAPS), each of three words.
JET_CLI_PERF_CAUSAL_GAPS: 16

// The tasks a body needs to be fitted, and an octave to be a point of the
// fit.
JET_CLI_PERF_CAUSAL_FIT_TASKS: 30

// The octaves the fit needs.
JET_CLI_PERF_CAUSAL_FIT_CELLS: 3

// The least share of the octaves' spread in run time, in thousandths, the
// fit must explain (its R²) before the lens warms its gains by it.
JET_CLI_PERF_CAUSAL_FIT_R2: 500

// One octave of idle gap over the task bodies the fit takes: the tasks
// that ran after such a gap, their run time and their mean gap, in
// nanoseconds, the gap's log2 in microseconds, in thousandths
// (jet_cli_perf_causal_octave), how slowly they ran, in thousandths of
// their bodies' mean run time, whether it is a point of the fit, and how
// far its slowness lies from the fit's, in thousandths.
JetCLIPerfCausalCell: struct {
    tasks: Int,
    run_ns: Int,
    gap_ns: Int,
    octave: Int,
    slowness: Int,
    fitted: Bool,
    residual: Int,
}

// How much slower a task runs the longer its CPU idled before it, fitted
// over the idle table (jet_cli_perf_causal_fit): the octaves, then the
// line through the fitted ones, weighted by their tasks: their mean
// octave and slowness, its slope in thousandths of slowness per octave,
// and its R², in thousandths, and the fitted octaves' range; `refused`
// says why the lens cannot warm its gains by it ("" when it can).
JetCLIPerfCausalFit: struct {
    cells: [JetCLIPerfCausalCell],
    mean_octave: Int,
    mean_slowness: Int,
    slope: Int,
    r2: Int,
    low: Int,
    high: Int,
    refused: String,
}

// `ns` nanoseconds as the log2 of its microseconds, in thousandths, linear
// within each octave; 0 below a microsecond.
jet_cli_perf_causal_octave: fn(ns: Int) -> Int Never! {
    micros: ns /% 1000
    if micros < 1 -> return 0
    whole := 0
    span := 1
    loop span * 2 <= micros {
        span *= 2
        whole += 1
    }
    whole * 1000 + (micros - span) * 1000 /% span
}

// The fit of the idle table `idle` (PerfSamples.jet perf_causal_idle_write,
// its words after the header). Each task body ran at least
// JET_CLI_PERF_CAUSAL_FIT_TASKS times counts, its tasks' run times taken in
// thousandths of its own mean, so bodies of different lengths share the
// octaves; an octave of that many tasks is a point of the fit.
jet_cli_perf_causal_fit: fn(idle: [Int]) -> JetCLIPerfCausalFit Never! {
    row: 1 + JET_CLI_PERF_CAUSAL_GAPS * 3
    tasks := [Int]{}
    runs := [Int]{}
    gaps := [Int]{}
    scaled := [Int]{}
    loop _ in 0..<JET_CLI_PERF_CAUSAL_GAPS {
        tasks.push(0)
        runs.push(0)
        gaps.push(0)
        scaled.push(0)
    }
    bodies := 0
    loop kind in 0..<idle.len() /% row {
        at: kind * row
        if idle[at] == 0 -> next
        count := 0
        run := 0
        loop cell in 0..<JET_CLI_PERF_CAUSAL_GAPS {
            count += idle[at + 1 + cell * 3]
            run += idle[at + 2 + cell * 3]
        }
        if count < JET_CLI_PERF_CAUSAL_FIT_TASKS || run /% count <= 0 -> next
        mean: run /% count
        bodies += 1
        loop cell in 0..<JET_CLI_PERF_CAUSAL_GAPS {
            tasks[cell] = tasks[cell] + idle[at + 1 + cell * 3]
            runs[cell] = runs[cell] + idle[at + 2 + cell * 3]
            gaps[cell] = gaps[cell] + idle[at + 3 + cell * 3]
            scaled[cell] = scaled[cell] + idle[at + 2 + cell * 3] * 1000 /% mean
        }
    }
    cells := [JetCLIPerfCausalCell]{}
    weight := 0
    octaves := 0
    slowness := 0
    loop cell in 0..<JET_CLI_PERF_CAUSAL_GAPS {
        if tasks[cell] == 0 -> next
        gap: gaps[cell] /% tasks[cell]
        fitted: tasks[cell] >= JET_CLI_PERF_CAUSAL_FIT_TASKS
        cells.push(JetCLIPerfCausalCell{tasks: tasks[cell], run_ns: runs[cell], gap_ns: gap, octave: jet_cli_perf_causal_octave(gap), slowness: scaled[cell] /% tasks[cell], fitted: fitted, residual: 0})
        if fitted {
            weight += tasks[cell]
            octaves += tasks[cell] * jet_cli_perf_causal_octave(gap)
            slowness += scaled[cell]
        }
    }
    fit := JetCLIPerfCausalFit{cells: cells, mean_octave: 0, mean_slowness: 0, slope: 0, r2: 0, low: 0, high: 0, refused: ""}
    if bodies == 0 {
        fit.refused = if idle.len() == 0 -> "the run wrote no idle table" else -> "no task body ran {JET_CLI_PERF_CAUSAL_FIT_TASKS} times after an idle gap"
        return fit
    }
    points := 0
    loop cell in fit.cells {
        if cell.fitted -> points += 1
    }
    if points < JET_CLI_PERF_CAUSAL_FIT_CELLS {
        fit.refused = "only {points} of the octaves of idle gap held {JET_CLI_PERF_CAUSAL_FIT_TASKS} tasks or more, and the fit needs {JET_CLI_PERF_CAUSAL_FIT_CELLS}"
        return fit
    }
    fit.mean_octave = octaves /% weight
    fit.mean_slowness = slowness /% weight
    // Weighted least squares over the fitted octaves.
    across := 0
    spread := 0
    total := 0
    fit.low = -1
    loop cell in fit.cells {
        if !cell.fitted -> next
        if fit.low < 0 -> fit.low = cell.octave
        fit.high = cell.octave
        x: cell.octave - fit.mean_octave
        y: cell.slowness - fit.mean_slowness
        across += cell.tasks * x * x
        spread += cell.tasks * x * y
        total += cell.tasks * y * y
    }
    fit.slope = if across > 0 -> spread * 1000 /% across else -> 0
    left := 0
    loop index in 0..<fit.cells.len() {
        residual: fit.cells[index].slowness - jet_cli_perf_causal_fitted(fit, fit.cells[index].octave, clamped: false)
        fit.cells[index].residual = residual
        if fit.cells[index].fitted -> left += fit.cells[index].tasks * residual * residual
    }
    // The means are whole thousandths, so the residuals can outweigh the
    // spread by a rounding; the R² stays at 0 or above.
    fit.r2 = if {
        total == 0 -> 1000
        left >= total -> 0
        else -> 1000 - left * 1000 /% total
    }
    if fit.r2 < JET_CLI_PERF_CAUSAL_FIT_R2 {
        fit.refused = "the fit of run time against idle gap explains {jet_cli_perf_causal_percent(fit.r2)} of the octaves' spread, under the {jet_cli_perf_causal_percent(JET_CLI_PERF_CAUSAL_FIT_R2)} the lens warms its gains by"
    }
    fit
}

// The fit's slowness at octave `octave`, in thousandths; `clamped` holds
// the octave within the fitted ones, so the fit is never read past them.
jet_cli_perf_causal_fitted: fn(fit: JetCLIPerfCausalFit, octave: Int, clamped: Bool) -> Int Never! {
    at := octave
    if clamped && at < fit.low -> at = fit.low
    if clamped && at > fit.high -> at = fit.high
    fit.mean_slowness + fit.slope * (at - fit.mean_octave) /% 1000
}

// The virtual `gain`, in tenths of a percent, warmed by `fit`. A line made
// virtually faster leaves the other carriers idle as long as before, but a
// line really that much faster ends each pass sooner, so they idle that
// much less before their next task: by the gain's share of the time from a
// task's start to the next one's, its mean gap and run. Their CPUs clock
// down less and the tasks run faster, as the fit says a task does after
// the shorter gap, and each pass's time shrinks by their run-weighted mean.
// A fit the lens refused, or one where a task runs no slower after a longer
// gap, leaves the gain as it is.
jet_cli_perf_causal_warm: fn(fit: JetCLIPerfCausalFit, gain: Int) -> Int Never! {
    if fit.refused != "" || fit.slope <= 0 || gain == 0 -> return gain
    weighted := 0
    total := 0
    loop cell in fit.cells {
        before: jet_cli_perf_causal_fitted(fit, cell.octave, clamped: true)
        if before <= 0 -> next
        shortened := cell.gap_ns - gain * (cell.gap_ns + cell.run_ns /% cell.tasks) /% 1000
        if shortened < 0 -> shortened = 0
        after: jet_cli_perf_causal_fitted(fit, jet_cli_perf_causal_octave(shortened), clamped: true)
        micros: cell.run_ns /% 1000
        weighted += micros * (after * 1000 /% before)
        total += micros
    }
    if total == 0 -> return gain
    1000 - (1000 - gain) * (weighted /% total) /% 1000
}

// The causal section of the trace of the run of `source`: each progress
// point's lines, ranked by how much sooner its passes come, each with its
// interval, and the lines it could not rank with why; or, when no line of
// any point could be ranked, the reason the run is refused. Each gain is
// warmed by the fit of the idle table `idle` (jet_cli_perf_causal_warm),
// which the section keeps with its residuals. A run whose threads waited
// for a CPU more than JET_CLI_PERF_CAUSAL_WAIT_MOST of their run time is
// refused with the wait, and its points keep their names but none of their
// lines: each gain would read low. A run whose CPUs clocked down more than
// JET_CLI_PERF_CAUSAL_CLOCK_MOST while the lens could not fit how that
// slows its tasks keeps its gains, flagged with the drop and why the fit
// failed: they may read low.
jet_cli_perf_causal_section: fn(source: ^^String, experiments: ^^[JetCLIPerfExperiment], points: ^^[Int:String], idle: ^^[Int]) -> TraceReceiptSection Never! {
    fit: jet_cli_perf_causal_fit(idle)
    base := [Int]{}
    groups := [JetCLIPerfCausalGroup]{}
    // The speedup the experiments took, in percent.
    percent := 30
    run_ns := 0
    wait_ns := 0
    // The experiments' highest and lowest clocks summed, in kHz, over those
    // that read both.
    khz_high := 0
    khz_low := 0
    clocked := 0
    loop (index, experiment) in experiments {
        if experiment.speedup > 0 -> percent = experiment.speedup /% 10
        run_ns += experiment.run_ns
        wait_ns += experiment.wait_ns
        if experiment.khz_high > 0 && experiment.khz_low > 0 {
            khz_high += experiment.khz_high
            khz_low += experiment.khz_low
            clocked += 1
        }
        // A baseline has no speedup. An experiment that slowed the program
        // for a line the checked source does not name is neither a baseline
        // nor any line's.
        if experiment.speedup == 0 {
            base.push(index)
            next
        }
        if experiment.line == (U64{0}) -> next
        at := groups.len()
        loop (k, group) in groups {
            if group.line == experiment.line && group.name == experiment.name {
                at = k
                break
            }
        }
        if at == groups.len() {
            groups.push(JetCLIPerfCausalGroup{line: experiment.line, name: "{experiment.name}", chosen: [Int]{}})
        }
        groups[at].chosen.push(index)
    }
    slots := [Int]{}
    loop (slot, _) in points -> slots.push(slot)
    slots.sort()
    ranked := 0
    rows := [CanonicalJSON]{}
    // The points with their lines withheld.
    withheld := [CanonicalJSON]{}
    loop slot in slots {
        found := [JetCLIPerfCausalLine]{}
        unranked := [CanonicalJSON]{}
        loop group in groups {
            chosen: group.chosen
            why := ""
            if chosen.len() < JET_CLI_PERF_CAUSAL_MIN || base.len() < JET_CLI_PERF_CAUSAL_MIN {
                why = "{chosen.len()} experiments on it and {base.len()} baselines; it needs {JET_CLI_PERF_CAUSAL_MIN} of each"
            } else if jet_cli_perf_causal_line(experiments, base, chosen, slot, fit) == .Val(predicted) {
                if predicted.high - predicted.low > JET_CLI_PERF_CAUSAL_WIDEST {
                    why = "its interval is {jet_cli_perf_causal_percent(predicted.low)} to {jet_cli_perf_causal_percent(predicted.high)}, wider than {JET_CLI_PERF_CAUSAL_WIDEST /% 10} points"
                } else {
                    found.push(predicted.move())
                    next
                }
            } else { why = "no pass of the point came in its experiments or the baselines" }
            unranked.push(
                CanonicalJSON.Object(
                    [CanonicalJSONField]{
                        {key: "experiments", value: CanonicalJSON.Integer("{chosen.len()}")},
                        {key: "function", value: CanonicalJSON.String("{group.name}")},
                        {key: "line", value: CanonicalJSON.Integer("{group.line}")},
                        {key: "reason", value: CanonicalJSON.String(why.move())},
                    },
                ),
            )
        }
        // Ranked by the gain the experiments support: the interval's low end
        // first, so a line whose wide interval reaches a high point gain (noise
        // under load) never outranks one whose gain is established; the point
        // gain breaks ties.
        found.sort_by(fn(left: JetCLIPerfCausalLine, right: JetCLIPerfCausalLine) {
            if right.low != left.low -> right.low <=> left.low else -> right.gain <=> left.gain
        })
        ranked += found.len()
        name: if points.get(slot) == .Val(named) -> "{named}" else -> "point"
        withheld.push(
            CanonicalJSON.Object(
                [CanonicalJSONField]{
                    {key: "lines", value: CanonicalJSON.Array([CanonicalJSON]{})},
                    {key: "name", value: CanonicalJSON.String("{name}")},
                    {key: "unranked", value: CanonicalJSON.Array([CanonicalJSON]{})},
                },
            ),
        )
        rows.push(
            CanonicalJSON.Object(
                [CanonicalJSONField]{
                    {key: "lines", value: CanonicalJSON.Array(loop line in found.move() -> jet_cli_perf_causal_json(line))},
                    {key: "name", value: CanonicalJSON.String(name)},
                    {key: "unranked", value: CanonicalJSON.Array(unranked.move())},
                },
            ),
        )
    }
    reason := ""
    if {
        ranked == 0 -> {
            // Each experiment is a baseline or a line at even odds, so a
            // line takes about twice its share of the experiments.
            needed: JET_CLI_PERF_CAUSAL_MIN * 4 * JET_CLI_PERF_CAUSAL_EXPERIMENT_MS
            reason = if points.len() == 0 -> "no progress point passed: close a zone, finish a task or call `perf.progress(name)` in the run" else -> "the run kept {experiments.len()} experiments of {JET_CLI_PERF_CAUSAL_EXPERIMENT_MS} ms, {base.len()} of them baselines, and no line had {JET_CLI_PERF_CAUSAL_MIN} with an interval narrower than {JET_CLI_PERF_CAUSAL_WIDEST /% 10} points; run it for longer than {needed} ms per line it spends time in"
        }
        run_ns > 0 && wait_ns * 1000 > run_ns * JET_CLI_PERF_CAUSAL_WAIT_MOST -> {
            reason = "the program's threads waited {wait_ns /% 1000000} ms for a CPU while they ran {run_ns /% 1000000} ms, {jet_cli_perf_causal_percent(wait_ns * 1000 /% run_ns)} of their run time, above the {jet_cli_perf_causal_percent(JET_CLI_PERF_CAUSAL_WAIT_MOST)} the lens ranks under: under CPU contention a line made virtually faster frees no CPU for the rest, so every gain would read low; run it where each of its threads has a CPU"
            rows = withheld.move()
        }
        else -> {}
    }
    high_mhz: if clocked > 0 -> khz_high /% clocked /% 1000 else -> 0
    low_mhz: if clocked > 0 -> khz_low /% clocked /% 1000 else -> 0
    // The drop, in thousandths of the highest clock.
    drop: if high_mhz > 0 -> (high_mhz - low_mhz) * 1000 /% high_mhz else -> 0
    flag: if drop > JET_CLI_PERF_CAUSAL_CLOCK_MOST && fit.refused != "" -> CanonicalJSON.String("gains may under-read: idle CPUs clocked down {jet_cli_perf_causal_percent(drop)} ({high_mhz} MHz to {low_mhz} MHz) between experiments, above the {jet_cli_perf_causal_percent(JET_CLI_PERF_CAUSAL_CLOCK_MOST)} the lens trusts, and it could not fit how much slower a task runs after its CPU idled ({fit.refused}): a task begun on a CPU that idled runs slower than its siblings until it clocks up, whichever line the experiment speeds up; run it longer, or with the CPUs held at one clock") else -> CanonicalJSON.Null
    value: CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "baselines", value: CanonicalJSON.Integer("{base.len()}")},
            {key: "clock_fit", value: jet_cli_perf_causal_fit_json(fit)},
            {key: "clock_flag", value: flag},
            {key: "clock_high_mhz", value: CanonicalJSON.Integer("{high_mhz}")},
            {key: "clock_low_mhz", value: CanonicalJSON.Integer("{low_mhz}")},
            {key: "cpu_run_ms", value: CanonicalJSON.Integer("{run_ns /% 1000000}")},
            {key: "cpu_wait_ms", value: CanonicalJSON.Integer("{wait_ns /% 1000000}")},
            {key: "experiments", value: CanonicalJSON.Integer("{experiments.len()}")},
            {key: "path", value: CanonicalJSON.String(source.move())},
            {key: "points", value: CanonicalJSON.Array(rows.move())},
            {key: "refused", value: if reason == "" -> CanonicalJSON.Null else -> CanonicalJSON.String(reason.move())},
            {key: "speedup_percent", value: CanonicalJSON.Integer("{percent}")},
        },
    )
    digest: canonical_json_sha256(value)
    TraceReceiptSection{name: "causal", type_name: "JetPerfCausal", value: value, digest: digest}
}

// The fit as the section keeps it: each octave's mean gap in microseconds,
// its tasks, their slowness and its residual from the fit, in thousandths,
// and whether it is a point of the fit; the slope, in thousandths of
// slowness per octave, the R², in thousandths, and why the lens refused to
// warm its gains by it (null when it did not).
jet_cli_perf_causal_fit_json: fn(fit: JetCLIPerfCausalFit) -> CanonicalJSON Never! {
    CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "cells", value: CanonicalJSON.Array(loop cell in fit.cells -> jet_cli_perf_causal_cell_json(cell))},
            {key: "r2_thousandths", value: CanonicalJSON.Integer("{fit.r2}")},
            {key: "refused", value: if fit.refused == "" -> CanonicalJSON.Null else -> CanonicalJSON.String("{fit.refused}")},
            {key: "slope_thousandths", value: CanonicalJSON.Integer("{fit.slope}")},
        },
    )
}

jet_cli_perf_causal_cell_json: fn(cell: JetCLIPerfCausalCell) -> CanonicalJSON Never! {
    CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "fitted", value: CanonicalJSON.Bool(cell.fitted)},
            {key: "gap_us", value: CanonicalJSON.Integer("{cell.gap_ns /% 1000}")},
            {key: "residual_thousandths", value: CanonicalJSON.Integer("{cell.residual}")},
            {key: "slowness_thousandths", value: CanonicalJSON.Integer("{cell.slowness}")},
            {key: "tasks", value: CanonicalJSON.Integer("{cell.tasks}")},
        },
    )
}

jet_cli_perf_causal_json: fn(line: ^^JetCLIPerfCausalLine) -> CanonicalJSON Never! {
    CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "experiments", value: CanonicalJSON.Integer("{line.experiments}")},
            {key: "function", value: CanonicalJSON.String(line.name.move())},
            {key: "gain_tenths", value: CanonicalJSON.Integer("{line.gain}")},
            {key: "high_tenths", value: CanonicalJSON.Integer("{line.high}")},
            {key: "line", value: CanonicalJSON.Integer("{line.line}")},
            {key: "low_tenths", value: CanonicalJSON.Integer("{line.low}")},
        },
    )
}

// `tenths` tenths of a percent as `12.3%`, signed when below zero.
jet_cli_perf_causal_percent: fn(tenths: Int) -> String Never! {
    sign: if tenths < 0 -> "-" else -> ""
    whole: if tenths < 0 -> -tenths else -> tenths
    "{sign}{whole /% 10}.{whole %% 10}%"
}

// The words of a task's timing (PerfSamples.jet PERF_CAUSAL_ROW_WORDS).
JET_CLI_PERF_CAUSAL_ROW_WORDS: 14

// The tasks' timings the causal lens kept (PerfSamples.jet
// perf_causal_rows_write): the tasks that claimed a row (-1 when the run
// wrote none) and the most rows it keeps; each row's words after its
// header, its body's address replaced by its index in `places`, the bodies'
// lines, which `bodies` holds by address.
JetCLIPerfCausalTasks: struct {
    seen: Int,
    kept_most: Int,
    rows: [Int],
    bodies: [Int:Int],
    places: [JetCLIPerfCausalPlace],
}

// The `causal_tasks` section: each task's timing under the causal lens, for
// telling where a round's time went in each kind of experiment. Its
// experiments, in order, by the line each sped up (null for a baseline);
// the task bodies by their line; and one row per task kept, in the order
// its timing was written: its body's index, its start from the first
// task's, its wall time, the experiments it began and ended in (an index
// into the experiments, which a task that ran into the run's last,
// unrecorded, one passes), its thread's CPU time over it, the wall time and
// CPU time its pauses took, the samples its thread took, the global delay
// at its start and its end, the CPU it began on, and the idle gap before it
// (-1 for none), each time in nanoseconds. None when the run wrote no
// timings.
jet_cli_perf_causal_tasks_section: fn(source: String, experiments: ^^[JetCLIPerfExperiment], tasks: ^^JetCLIPerfCausalTasks) -> TraceReceiptSection? Never! {
    if tasks.seen < 0 -> return None
    first := 0
    loop row in 0..<tasks.rows.len() /% (JET_CLI_PERF_CAUSAL_ROW_WORDS - 1) {
        start: tasks.rows[row * (JET_CLI_PERF_CAUSAL_ROW_WORDS - 1) + 1]
        if row == 0 || start < first -> first = start
    }
    rows := [CanonicalJSON]{}
    loop row in 0..<tasks.rows.len() /% (JET_CLI_PERF_CAUSAL_ROW_WORDS - 1) {
        at: row * (JET_CLI_PERF_CAUSAL_ROW_WORDS - 1)
        words := [CanonicalJSON]{}
        loop column in 0..<JET_CLI_PERF_CAUSAL_ROW_WORDS - 1 {
            value: if {
                column == 1 -> tasks.rows[at + 1] - first
                column == 2 -> tasks.rows[at + 2] - tasks.rows[at + 1]
                else -> tasks.rows[at + column]
            }
            words.push(CanonicalJSON.Integer("{value}"))
        }
        rows.push(CanonicalJSON.Array(words.move()))
    }
    value: CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "bodies", value: CanonicalJSON.Array(loop place in tasks.places -> jet_cli_perf_causal_place_json(place.line, "{place.name}"))},
            {key: "columns", value: CanonicalJSON.Array(loop column in ["body", "start_ns", "wall_ns", "experiment_at_start", "experiment_at_end", "cpu_ns", "paused_ns", "paused_cpu_ns", "samples", "delay_at_start_ns", "delay_at_end_ns", "cpu", "idle_gap_ns"] -> CanonicalJSON.String(column))},
            {key: "experiments", value: CanonicalJSON.Array(loop experiment in experiments -> if experiment.speedup == 0 -> CanonicalJSON.Null else -> jet_cli_perf_causal_place_json(experiment.line, "{experiment.name}"))},
            {key: "kept_most", value: CanonicalJSON.Integer("{tasks.kept_most}")},
            {key: "path", value: CanonicalJSON.String(source)},
            {key: "rows", value: CanonicalJSON.Array(rows.move())},
            {key: "seen", value: CanonicalJSON.Integer("{tasks.seen}")},
        },
    )
    digest: canonical_json_sha256(value)
    Val(TraceReceiptSection{name: "causal_tasks", type_name: "JetPerfCausalTasks", value: value, digest: digest})
}

jet_cli_perf_causal_place_json: fn(line: U64, name: String) -> CanonicalJSON Never! {
    CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "function", value: CanonicalJSON.String(name)},
            {key: "line", value: CanonicalJSON.Integer("{line}")},
        },
    )
}
