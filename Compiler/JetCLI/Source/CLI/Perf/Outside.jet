// `jet perf attach` of a process that publishes nothing about itself, as the
// jet CLI and a program started without `--observe` do: the kernel samples
// the CPU time of each thread of it and of the processes it started (a
// `jet check`'s compile-time work runs in one) from outside them
// (x64_sampler_open), and each process's own executable names its samples'
// frames, so the attach shows which functions their CPU was in, where each
// is declared, which package of the program each sample was working for,
// how its samples' stacks fold into a flame graph and how many of the
// stacks unwound whole. `jet perf attach -- <command>` samples a command
// the same way from its first instruction to its end (x64_sampled_start),
// every thread and process it starts included. Either way the trace also
// keeps when each sample was taken, its `timeline`.
use {
    perf_files: core.files
    perf_process: core.process
    perf_sys: core.sys
    perf_time: core.time
    jet_backend.[
        X64ImageFunction,
        X64Jetline,
        X64JetlineFunction,
        X64SampleMapping,
        X64SampleRing,
        X64Samples,
        x64_image_function_find,
        x64_image_functions,
        x64_jetline_find,
        x64_jetline_read,
        x64_sampled_close,
        x64_sampled_reaped,
        x64_sampled_start,
        x64_sampler_close,
        x64_sampler_drain,
        x64_sampler_open,
    ]
    jet_driver.[JetDriverVerbOutput]
    jet_foundation.[
        CanonicalJSON,
        CanonicalJSONField,
        ENV_JET_PERF_CODE,
        JetSymbolRef,
        SourceIdentity,
        TRACE_PROFILE_ROW_LIMIT,
        TraceCounter,
        TraceProfile,
        TraceProfileRow,
        TraceProfileSource,
        TraceReceiptSection,
        canonical_json_sha256,
        jet_live_stat_ticks,
        jettrace_array,
        jettrace_object_view,
        sha256_hex,
        trace_profile_unsupported,
        trace_receipt_section_from_json,
    ]
    jet_ir.[ir_runtime_intrinsic_specs]
}

// The CPU time of one thread between two of its samples: a millisecond.
JET_CLI_PERF_OUTSIDE_PERIOD_NS: 1000000

// How long an outside attach samples without `--for=`.
JET_CLI_PERF_OUTSIDE_WINDOW_MS: 1000

// The longest `--for=` window: 10 minutes.
JET_CLI_PERF_OUTSIDE_LONGEST_MS: 600000

// The functions the `functions` section keeps, the most samples first.
JET_CLI_PERF_OUTSIDE_ROWS: 32

// The samples the `timeline` section keeps, the earliest drained first: 17
// minutes of one busy thread's, or a minute of 16 threads'.
JET_CLI_PERF_OUTSIDE_TIMELINE: 1048576

// The variable a jet streams its trace to (JET_TRACE_FILE), `%p` in it the
// jet's pid: a sampled command's phases are its jet's top-level spans.
JET_CLI_PERF_OUTSIDE_TRACE_FILE: "JET_TRACE_FILE"

// The prefix of a Core source's path in a location table.
JET_CLI_PERF_OUTSIDE_CORELIB: "<corelib>/"

// The most processes an outside attach samples: the one named and those it
// started, and theirs.
JET_CLI_PERF_OUTSIDE_PROCESSES: 64

// The first four bytes of an ELF image, `\x7fELF`, as a little-endian word.
JET_CLI_PERF_OUTSIDE_ELF: 0x464c457f

// The function every process's first stack starts in: the program's `main`,
// which the image's entry calls.
JET_CLI_PERF_OUTSIDE_MAIN: "main"

// The functions every other stack of a Jet process starts in: a thread's
// first function and a task's fiber's, each a runtime function whose
// address the compiler seeds a fresh stack with (JetIR's
// ir_runtime_intrinsic_specs), which JET_CLI_PERF_OUTSIDE_ENTRIES_CHECKED
// holds it to. A sample whose outermost frame is in one of these or in
// JET_CLI_PERF_OUTSIDE_MAIN was unwound whole.
JET_CLI_PERF_OUTSIDE_ENTRIES: [String]{"jet_rt_thread_entry", "jet_rt_fiber_entry"}

JET_CLI_PERF_OUTSIDE_ENTRIES_CHECKED: #run jet_cli_perf_outside_entries_checked()

// JET_CLI_PERF_OUTSIDE_ENTRIES, once each is the symbol of one of the
// compiler's runtime function addresses; a build whose runtime renamed one
// stops here.
jet_cli_perf_outside_entries_checked: fn() -> [String] Never! {
    seeded := [String]{}
    loop spec in ir_runtime_intrinsic_specs() {
        if spec.shape == .FunctionAddress(symbol, _) -> seeded.push(symbol)
    }
    loop entry in JET_CLI_PERF_OUTSIDE_ENTRIES {
        if !seeded.contains(entry) {
            panic("Perf/Outside.jet's stack entry {entry} is no runtime function address the compiler seeds (ir_runtime_intrinsic_specs)")
        }
    }
    JET_CLI_PERF_OUTSIDE_ENTRIES
}

// The frames of a sample's call chain the kernel gives unless
// /proc/sys/kernel/perf_event_max_stack says otherwise.
JET_CLI_PERF_OUTSIDE_DEPTH: 127

// A folded stack is kept when it holds at least one sample in this many;
// a rarer one's samples fold into its caller's.
JET_CLI_PERF_OUTSIDE_STACK_SHARE: 100

// The call tree's key of a node's child: the node's index plus one times
// this, plus the child's row. More rows than this never come from one
// attach.
JET_CLI_PERF_OUTSIDE_ROW_KEY: 16777216

// A range of a sampled process's code that an image of its executable file
// holds, as it is mapped: from `start` to `end` in the process, and `delta`
// from there to the link addresses of the image, by its index among the
// images.
JetCLIPerfOutsideRange: struct {
    start: Int,
    end: Int,
    delta: Int,
    image: Int,
}

// A loadable segment of an image: `size` bytes at offset `offset` of the
// file that holds the image, linked at `address`.
JetCLIPerfOutsideSegment: struct {
    offset: Int,
    size: Int,
    address: Int,
}

// An ELF image of an executable file the sampled processes run, the file's
// own or one it holds as a part (x64_executable_add_parts), as a jet holds
// the runtime image its compile-time work runs: the file's `path`, the
// image's functions, sorted by start, its loadable segments, and its
// location table (`.debug_jetline`), with no function when it has none.
JetCLIPerfOutsideImage: struct {
    path: String,
    functions: [X64ImageFunction],
    segments: [JetCLIPerfOutsideSegment],
    lines: X64Jetline,
}

// A function the samples were in and its samples: `own`, those whose
// innermost frame is in it, and `total`, those with it anywhere on their
// stack; `seen` is the last sample counted in its total, so a function a
// stack holds twice counts once. `file` and `line` are its declaration's,
// from its image's location table ("" and 0 when that holds none),
// `package` the package of the program `file` lies in ("" for none, as
// for Core's sources), and `root` whether it is JET_CLI_PERF_OUTSIDE_MAIN
// or one of JET_CLI_PERF_OUTSIDE_ENTRIES.
JetCLIPerfOutsideRow: struct {
    name: String,
    own: Int,
    total: Int,
    seen: Int,
    file: String,
    line: Int,
    package: String,
    root: Bool,
}

// The samples' call tree: each node a function (`rows`, its row) called
// from its parent node (`parents`, -1 for a stack's outermost frame) and
// the samples whose stack runs through it (`totals`); `children` finds a
// node's child by its key (JET_CLI_PERF_OUTSIDE_ROW_KEY).
JetCLIPerfOutsideTree: struct {
    rows: [Int],
    parents: [Int],
    totals: [Int],
    children: [Int:Int],
}

// A folded stack: its functions from the outermost, `;` between them, and
// the samples whose stack it is.
JetCLIPerfOutsideStack: struct {
    stack: String,
    samples: Int,
}

// A package of the program and the samples working for it.
JetCLIPerfOutsidePackage: struct {
    package: String,
    samples: Int,
}

// A sample on the timeline: its time in microseconds from the sampling's
// origin, and its innermost node in the call tree (-1 for none).
JetCLIPerfOutsideMoment: struct {
    us: Int,
    node: Int,
}

// A phase of a sampled command's jet: a top-level span of its trace (one
// whose name is its kind), from `start_us` to `end_us` on the wall clock,
// in microseconds.
JetCLIPerfOutsidePhase: struct {
    phase: String,
    start_us: Int,
    end_us: Int,
}

// A sampled command's profile (jet_cli_perf_outside_profile) and the
// sources its rows are in.
JetCLIPerfOutsideProfile: struct {
    profile: TraceProfile,
    sources: [SourceIdentity],
}

// A function of a compile-time batch its jet listed (ENV_JET_PERF_CODE):
// its code from `start` to `end` in the child the batch loaded in, its
// declaration's `file` and `line`, and its `name`.
JetCLIPerfOutsideCode: struct {
    start: Int,
    end: Int,
    line: Int,
    file: String,
    name: String,
}

// What an outside sampling has made of the samples it read so far
// (jet_cli_perf_outside_take). `images` are the sampled processes'
// executables' images, and `unreadable` the files none could be read of.
// Each process's mapped code is a slot of `processes`, read at drain
// `read_at`; `slots` gives each pid's current slot (-1 when it must be
// read), `before` its slot before its last execve, and `execs` that
// execve's time. A sampled command's `mappings` are the code its processes
// mapped, as the kernel reported it, and `parents` each process's parent.
// `code` is the file a sampled jet lists the functions of a comptime
// child's code no file holds in, its entry program's and each batch's
// (ENV_JET_PERF_CODE, `%p` the child's pid; "" for none), each pid's
// listing a slot of `listings` by `listed`, read at drain `listed_at`
// (jet_cli_perf_outside_listed).
// Then the functions the samples were in (`rows`, by name in `named`),
// their call tree, the samples by package (`working`), how far each stack
// unwound (`depth` is the kernel's frame limit), and each sample's moment
// on the `timeline`, timed from `origin_ns` on the samples' clock, those
// past JET_CLI_PERF_OUTSIDE_TIMELINE `dropped`. `pids` and `tids` are the
// processes and threads sampled.
JetCLIPerfOutsideFold: struct {
    images: [JetCLIPerfOutsideImage],
    unreadable: [String:Bool],
    processes: [[JetCLIPerfOutsideRange]],
    read_at: [Int],
    slots: [Int:Int],
    before: [Int:Int],
    execs: [Int:Int],
    mappings: [X64SampleMapping],
    parents: [Int:Int],
    code: String,
    listings: [[JetCLIPerfOutsideCode]],
    listed: [Int:Int],
    listed_at: [Int],
    drains: Int,
    failure: String,
    rows: [JetCLIPerfOutsideRow],
    named: [String:Int],
    tree: JetCLIPerfOutsideTree,
    working: [String:Int],
    depth: Int,
    sample: Int,
    unnamed: Int,
    unwound: Int,
    cut: Int,
    broken: Int,
    origin_ns: Int,
    timeline: [JetCLIPerfOutsideMoment],
    dropped: Int,
    pids: [Int:Bool],
    tids: [Int:Bool],
}

// An outside sampling's two receipt sections
// (jet_cli_perf_outside_sections).
JetCLIPerfOutsideSections: struct {
    functions: TraceReceiptSection,
    timeline: TraceReceiptSection,
}

// What an outside attach sampled (jet_cli_perf_outside_sample): its
// `functions` and `timeline` sections, and the window its samplers were
// open, with the CPU the threads they sampled ran in it
// (jet_cli_perf_outside_cpu).
JetCLIPerfOutsideTaken: struct {
    sections: JetCLIPerfOutsideSections,
    window: JetCLIPerfAttachWindow,
}

// Sample process `pid`, and the processes it started, for `window_ms` and
// say where their CPU went, as the trace's `functions` and `timeline`
// receipt sections (jet_cli_perf_outside_sections), one sample each
// JET_CLI_PERF_OUTSIDE_PERIOD_NS of a thread's CPU time over `window_ms`,
// or until `pid` exits. With them comes the window the samplers were open:
// its wall time and the CPU the sampled threads ran in it, which the
// samples stand for, so a count low because the threads got little CPU is
// told from one low because samples were missed. Err says why the kernel
// won't sample it or its executable can't name the frames.
jet_cli_perf_outside_sample: fn(pid: Int, window_ms: Int) -[FS.Read, Time, FFI.Asm]> JetCLIPerfOutsideTaken JetCLIReadError! {
    family: jet_cli_perf_outside_family(pid)
    threads := [Int]{}
    // The process, by its index in `family`, each thread is of.
    owner := [Int:Int]{}
    loop (index, each) in family {
        tasks: perf_files.list_dir("/proc/{each}/task") ?? next
        loop task in tasks {
            thread: Int.parse(task.name) ?? next
            threads.push(thread)
            owner[thread] = index
        }
    }
    if threads.len() == 0 {
        return Err(jet_cli_read_error("its threads can't be listed under /proc/{pid}/task"))
    }
    fold := jet_cli_perf_outside_fold()
    // Where each process's code is mapped is read before the window opens,
    // so a process that exits in it still names its frames.
    loop each in family -> _: jet_cli_perf_outside_read(fold, each)
    if fold.images.len() == 0 -> return Err(jet_cli_read_error(fold.failure))
    sampler := x64_sampler_open(threads, JET_CLI_PERF_OUTSIDE_PERIOD_NS)
    sampled: sampler.rings.len()
    if sampled == 0 {
        why: if sampler.failure != "" -> "the kernel won't sample it: {sampler.failure}" else -> "it has no thread left to sample"
        x64_sampler_close(sampler)
        return Err(jet_cli_read_error(why))
    }
    fold.origin_ns = sampler.origin_ns
    taken := X64Samples{words: [Int]{}, execs: [Int]{}, maps: [X64SampleMapping]{}, forks: [Int]{}, samples: 0, lost: 0}
    // The window opens once the samplers are open and closes before they
    // are closed, so the CPU the sampled threads ran in it is the CPU the
    // samples stand for. Its last drain follows its close, so no sample
    // taken in it is left in a ring. It closes early when `pid` exits.
    before: jet_cli_perf_outside_cpu(sampler.rings, family, owner)
    started: perf_time.instant()
    exited_ms := Int?{None}
    // The rings are drained every 20 ms, well before one fills.
    loop _ in 0..<(window_ms + 19) /% 20 {
        perf_time.sleep(20ms)
        x64_sampler_drain(sampler, taken)
        jet_cli_perf_outside_take(fold, taken)
        if jet_cli_perf_outside_exited(pid) {
            exited_ms = Val(started.elapsed().ns /% 1000000)
            break
        }
    }
    after: jet_cli_perf_outside_cpu(sampler.rings, family, owner)
    window: jet_cli_perf_attach_closed(U64{started.elapsed().ns}, before, after)
    x64_sampler_drain(sampler, taken)
    x64_sampler_close(sampler)
    jet_cli_perf_outside_take(fold, taken)
    sections: jet_cli_perf_outside_sections(fold, taken, family.len(), sampled, window_ms, exited_ms, sampler.origin_unix_ns, [JetCLIPerfOutsidePhase]{})
    Ok(JetCLIPerfOutsideTaken{sections: sections, window: window})
}

// `jet perf attach -- <command>`: start `command` (its program's name or
// path, then its arguments) with the kernel sampling the CPU time of it,
// and of every thread and process it starts, from its first instruction to
// its end (x64_sampled_start), and write the trace to `out`, or where any
// attach writes it. The trace holds the `functions` and `timeline`
// sections (jet_cli_perf_outside_sections), its profile is the functions
// whose sources can be read (jet_cli_perf_outside_profile), and its run
// window is the command's whole run. A process's frames are named by the
// mappings of code the kernel reported it made
// (jet_cli_perf_outside_recorded), so one that ends before its first
// sample is read names them too, and a compile-time batch's frames by the
// listing of its functions its jet writes to a file of the attach's
// (jet_cli_perf_outside_listed). Unless the environment names a trace file
// (JET_CLI_PERF_OUTSIDE_TRACE_FILE) already, a jet the command starts
// streams its trace to a file of the attach's, whose top-level spans split
// the samples by the phase they were taken in
// (jet_cli_perf_outside_phases). The attach removes those files once the
// last samples are folded. The command shares jet's terminal, and its exit
// code is the attach's. The trace's recorded argv takes the command's
// words once the run has started.
jet_cli_perf_attach_sampled: fn(command: ^^[String], out: String?, allowlist: [String], quiet: Bool, color: Bool) -[FS, Env, Exec, Time, FFI.Asm]> JetDriverVerbOutput Never! {
    name: command[0]
    path: perf_process.which(name) ?? return jet_cli_perf_failed("Jet can't run `{name}`: no such program file{if name.contains("/") -> "" else -> " on PATH"}", color)
    cpus: jet_cli_perf_outside_cpus() ?? return jet_cli_perf_failed("Jet can't run `{name}`: {err.message}", color)
    phased: perf_sys.getenv(JET_CLI_PERF_OUTSIDE_TRACE_FILE) == None
    stem: "jet-perf-{perf_process.current_pid()}-{perf_time.unix_ns()}-"
    fields := [String]{}
    loop (key, value) in perf_sys.environment() {
        if key != ENV_JET_PERF_CODE -> fields.push("{key}={value}")
    }
    listing: perf_files.join(perf_sys.temp_dir(), "{stem}%p.code")
    fields.push("{ENV_JET_PERF_CODE}={listing}")
    if phased {
        fields.push("{JET_CLI_PERF_OUTSIDE_TRACE_FILE}={perf_files.join(perf_sys.temp_dir(), "{stem}%p.trace")}")
    }
    env: [String]?{Val(fields)}
    started: perf_time.instant()
    run := x64_sampled_start(path, command, env, cpus, JET_CLI_PERF_OUTSIDE_PERIOD_NS)
    root: run.command.child
    fold := jet_cli_perf_outside_fold()
    fold.origin_ns = run.sampler.origin_ns
    fold.code = listing
    taken := X64Samples{words: [Int]{}, execs: [Int]{}, maps: [X64SampleMapping]{}, forks: [Int]{}, samples: 0, lost: 0}
    // The rings are drained every 20 ms, well before one fills, until the
    // command is reaped; the last drain follows its reap.
    loop !x64_sampled_reaped(run) {
        perf_time.sleep(20ms)
        x64_sampler_drain(run.sampler, taken)
        jet_cli_perf_outside_take(fold, taken)
    }
    wall: started.elapsed().ns
    x64_sampler_drain(run.sampler, taken)
    x64_sampled_close(run)
    jet_cli_perf_outside_take(fold, taken)
    phases := [JetCLIPerfOutsidePhase]{}
    if phased {
        phases = jet_cli_perf_outside_phases(perf_files.join(perf_sys.temp_dir(), "{stem}{root}.trace"))
    }
    jet_cli_perf_outside_sweep(stem)
    if run.failure != "" {
        return jet_cli_perf_failed("Jet can't run `{name}`: {run.failure}", color)
    }
    sections: jet_cli_perf_outside_sections(fold, taken, fold.pids.len(), fold.tids.len(), wall /% 1000000, None, run.sampler.origin_unix_ns, phases)
    lines: jet_cli_perf_outside_lines(sections.functions.value)
    // After the sections, which sort the rows the hottest first.
    profiled: jet_cli_perf_outside_profile(fold, taken, path)
    capture := jet_cli_perf_command_profiled(profiled.profile.move(), profiled.sources.move(), run.cpu_ns, wall)
    capture.receipts.push(sections.functions)
    capture.receipts.push(sections.timeline)
    capture.policy.allowlist = allowlist
    argv := [String]{"attach"}
    if allowlist.len() > 0 {
        argv.push("--capture")
        argv.push(allowlist.join(","))
    }
    argv.push("--")
    argv.extend(command.move())
    written: jet_cli_perf_session_write(capture, "attach", argv, out) ?? return jet_cli_perf_failed(err.message, color)
    text := ""
    if !quiet {
        loop line in lines -> text = "{text}{line}\n"
        text = "{text}Trace: {written}\n"
    }
    JetDriverVerbOutput{stdout: "", stderr: text, exit_code: jet_cli_perf_counts_exit(run.status)}
}

// The top-level spans of the trace a jet streamed to `file`
// (JET_CLI_PERF_OUTSIDE_TRACE_FILE): each `B` and `E` event pair whose name
// is its kind, on one lane, each on the wall clock by the `unix_us` the
// trace's `trace.start` names (each event's `ts` counts from it), one left
// open ending at the trace's last event. None when the file can't be read
// or names no clock.
jet_cli_perf_outside_phases: fn(file: String) -[FS.Read]> [JetCLIPerfOutsidePhase] Never! {
    phases := [JetCLIPerfOutsidePhase]{}
    text: perf_files.read(file) ?? return phases
    origin := Int?{None}
    // Each open span's start by its lane and kind.
    open := [String:[Int]]{}
    last := 0
    loop line in text.lines() {
        if line.starts_with("{{\"name\":\"trace.start\",") {
            started: jet_cli_trace_field(line, "unix_us") ?? next
            origin = Val(started.value)
            next
        }
        base: origin ?? next
        ts: jet_cli_trace_field(line, "ts") ?? next
        at: base + ts.value
        if at > last -> last = at
        kind: jet_cli_perf_outside_span(line) ?? next
        lane: jet_cli_trace_field(line, "tid") ?? next
        key: "{lane.value}\n{kind.name}"
        starts := open[key, or: [Int]{}]
        if kind.begins {
            starts.push(at)
            open[key] = starts
            next
        }
        begun: starts.pop() ?? next
        open[key] = starts
        phases.push(JetCLIPerfOutsidePhase{phase: kind.name, start_us: begun, end_us: at})
    }
    loop (key, starts) in open {
        kind: key.split("\n").to_list()
        loop begun in starts {
            phases.push(JetCLIPerfOutsidePhase{phase: "{kind[kind.len() - 1]}", start_us: begun, end_us: last})
        }
    }
    phases
}

// The kind of the trace event `line` when it opens (`begins`) or closes a
// top-level span, whose name is its kind:
// `{"name":"load","cat":"load","ph":"B",…`; None for any other event.
jet_cli_perf_outside_span: fn(line: String) -> {name: String, begins: Bool}? Never! {
    lead: "{{\"name\":\""
    if !line.starts_with(lead) -> return None
    cut: line.removeprefix(lead).partition("\"")
    if cut.sep == "" || cut.head == "" -> return None
    name: cut.head
    if cut.tail.starts_with(",\"cat\":\"{name}\",\"ph\":\"B\"") {
        return Val({name: name, begins: true})
    }
    if cut.tail.starts_with(",\"cat\":\"{name}\",\"ph\":\"E\"") {
        return Val({name: name, begins: false})
    }
    None
}

// Remove the trace and listing files the attach's command's jets wrote:
// those in the temporary directory whose names start with `stem`.
jet_cli_perf_outside_sweep: fn(stem: String) -[FS, Env]> Never! {
    folder: perf_sys.temp_dir()
    entries: perf_files.list_dir(folder) ?? return
    loop entry in entries {
        if !entry.name.starts_with(stem) -> next
        perf_files.remove(perf_files.join(folder, entry.name)).drop("a trace file that is already gone needs no removing")
    }
}

// The profile of a sampled command's samples `taken` as `fold` made them,
// its rows sorted the hottest first (jet_cli_perf_outside_sections): one
// row of CPU-time samples for each function the samples were in whose
// source can be read, at its declaration's line, holding the samples
// whose innermost frame is in it and, inclusive, those with it anywhere on
// their stack; the coldest fold past the row limit
// (jet_cli_perf_profile_fold). A source is read where the location table
// of `program`, the command's executable, names it: by its own path, or
// below the nearest directory above the executable that holds it, else
// the working directory (Core's, `<corelib>/…`, below either as `Core/…`).
// Its coverage is complete when every sample is in a row and the kernel
// lost none.
jet_cli_perf_outside_profile: fn(fold: ^JetCLIPerfOutsideFold, taken: X64Samples, program: String) -[FS.Read]> JetCLIPerfOutsideProfile Never! {
    roots := [String]{}
    dir := perf_files.canonicalize(program) ?? program
    loop {
        above: perf_files.dirname(dir)
        if above == "" || above == dir -> break
        roots.push("{above}")
        dir = above
    }
    roots.push(".")
    // Each source's index in `sources` by its path, -1 for one that can't
    // be read.
    digests := [String:Int]{}
    sources := [SourceIdentity]{}
    rows := [TraceProfileRow]{}
    held := 0
    loop row in fold.rows {
        if row.file == "" || row.line <= 0 -> next
        if !digests.has_key(row.file) {
            digest: jet_cli_perf_outside_digest(row.file, roots)
            digests[row.file] = if digest == "" -> -1 else -> sources.len()
            if digest != "" {
                sources.push(SourceIdentity{path: row.file, sha256: digest, symbols: [{name: String, kind: String}]{}})
            }
        }
        source: digests[row.file]
        if source < 0 -> next
        digest: sources[source].sha256
        held += row.own
        place: TraceProfileSource{path: row.file, sha256: digest, start_line: U64{row.line}, start_column: U64{1}, end_line: U64{row.line}, end_column: U64{1}}
        rows.push(TraceProfileRow{clock: "cpu", allocation_count: None, dtlb_miss_count: None, execution_count: None, inclusive_count: Val(U64{row.total}), l1d_miss_count: None, llc_miss_count: None, page_fault_count: None, sample_count: U64{row.own}, sample_weight: U64{row.own}, source: place, symbol: JetSymbolRef{path: row.file, name: row.name}})
    }
    if rows.len() == 0 {
        why: if taken.samples == 0 -> "the kernel took no sample of the command" else -> "no function the command's {taken.samples} samples were in has a source that can be read"
        return JetCLIPerfOutsideProfile{profile: trace_profile_unsupported(why), sources: [SourceIdentity]{}}
    }
    folded: jet_cli_perf_profile_fold(rows.move())
    truncated: folded.dropped > (U64{0})
    elsewhere: U64{taken.samples - held} + folded.dropped
    lost: if taken.lost == 0 -> "" else -> "; the kernel lost {taken.lost} samples"
    reason: "one CPU-time sample per {JET_CLI_PERF_OUTSIDE_PERIOD_NS /% 1000} microseconds of each thread's CPU time of the command and every process it started, taken from outside them, at the declaration of the function its program counter is in and, inclusive, once at each function on its stack; {elsewhere} of {taken.samples} samples are in no function whose source was read{lost}{folded.note}"
    profile: TraceProfile{
        method: "sampling",
        counters: [TraceCounter]{},
        status: if truncated -> "truncated" else -> "captured",
        coverage: if elsewhere == (U64{0}) && taken.lost == 0 -> "complete" else -> "partial",
        rows: folded.rows.move(),
        row_limit: U64{TRACE_PROFILE_ROW_LIMIT},
        rows_truncated: truncated,
        overhead_ns: None,
        overhead_runtime_ns: None,
        overhead_kernel_ns: None,
        overhead_status: "not_measured",
        overhead_reason: "the kernel sampled the command from outside it, and that cost is not measured",
        reason: reason,
        window_status: "unavailable",
        window_wall_ns: None,
        window_cpu_ns: None,
        window_reason: "the runtime published no run window",
    }
    JetCLIPerfOutsideProfile{profile: profile, sources: sources}
}

// The SHA-256 of the source `file`, as a location table names it, read by
// its own path when that is absolute, else below the first of `roots` that
// holds it (Core's, `<corelib>/…`, as `Core/…`); "" when none does.
jet_cli_perf_outside_digest: fn(file: String, roots: [String]) -[FS.Read]> String Never! {
    relative: if file.starts_with(JET_CLI_PERF_OUTSIDE_CORELIB) -> file.slice(JET_CLI_PERF_OUTSIDE_CORELIB.len(), file.len()) else -> file
    if relative.starts_with("<") -> return ""
    if relative.starts_with("/") {
        text: perf_files.read(relative) ?? return ""
        return sha256_hex(text)
    }
    loop root in roots {
        text: perf_files.read(perf_files.join(root, relative)) ?? next
        return sha256_hex(text)
    }
    ""
}

// The CPUs the kernel has online, from /sys/devices/system/cpu/online:
// ranges and single CPUs between commas, as `0-15` or `0-3,6`.
jet_cli_perf_outside_cpus: fn() -[FS.Read]> [Int] JetCLIReadError! {
    text: perf_files.read("/sys/devices/system/cpu/online") ?? return Err(jet_cli_read_error("the online CPUs can't be listed: {jet_cli_io_error_text(err)}"))
    cpus := [Int]{}
    loop part in text.trim().split(",") {
        bounds: part.split("-").to_list()
        first: Int.parse(bounds[0]) ?? next
        last: if bounds.len() > 1 -> Int.parse(bounds[1]) ?? first else -> first
        loop cpu in first..<last + 1 { cpus.push(cpu) }
    }
    if cpus.len() == 0 -> return Err(jet_cli_read_error("no CPU is online to sample on"))
    Ok(cpus)
}

// A fold with no sample yet.
jet_cli_perf_outside_fold: fn() -[FS.Read]> JetCLIPerfOutsideFold Never! {
    JetCLIPerfOutsideFold{
        images: [JetCLIPerfOutsideImage]{},
        unreadable: [String:Bool]{},
        processes: [[JetCLIPerfOutsideRange]]{},
        read_at: [Int]{},
        slots: [Int:Int]{},
        before: [Int:Int]{},
        execs: [Int:Int]{},
        mappings: [X64SampleMapping]{},
        parents: [Int:Int]{},
        code: "",
        listings: [[JetCLIPerfOutsideCode]]{},
        listed: [Int:Int]{},
        listed_at: [Int]{},
        drains: 0,
        failure: "",
        rows: [JetCLIPerfOutsideRow]{},
        named: [String:Int]{},
        tree: JetCLIPerfOutsideTree{rows: [Int]{}, parents: [Int]{}, totals: [Int]{}, children: [Int:Int]{}},
        working: [String:Int]{},
        depth: jet_cli_perf_outside_depth(),
        sample: 0,
        unnamed: 0,
        unwound: 0,
        cut: 0,
        broken: 0,
        origin_ns: 0,
        timeline: [JetCLIPerfOutsideMoment]{},
        dropped: 0,
        pids: [Int:Bool]{},
        tids: [Int:Bool]{},
    }
}

// Read where process `pid`'s code is mapped into a new slot of `fold`, its
// pid's current one: the slot. Where the kernel reported a sampled
// command's mappings, those (jet_cli_perf_outside_recorded), so a process
// that has ended still names its frames; else the process's /proc files. A
// process whose executable or mappings can't be read has no code there, and
// the first such failure is the fold's.
jet_cli_perf_outside_read: fn(fold: ^JetCLIPerfOutsideFold, pid: Int) -[FS.Read]> Int Never! {
    slot: fold.processes.len()
    mapped := jet_cli_perf_outside_recorded(fold, pid)
    if mapped.len() == 0 {
        if jet_cli_perf_outside_process(pid, fold.images) == {
            .Ok(found) -> { mapped = found }
            .Err(failure) -> {
                if fold.failure == "" -> fold.failure = failure.message
            }
        }
    }
    fold.processes.push(mapped)
    fold.read_at.push(fold.drains)
    fold.slots[pid] = slot
    slot
}

// The slot of process `pid` for a sample taken at `time`: for one taken
// before the process's last execve, its slot from before it; else its
// current one, read now when it has none.
jet_cli_perf_outside_slot: fn(fold: ^JetCLIPerfOutsideFold, pid: Int, time: Int) -[FS.Read]> Int Never! {
    exec: fold.execs[pid, or: -1]
    if exec >= 0 && time < exec -> return fold.before[pid, or: -1]
    slot: fold.slots[pid, or: -1]
    if slot >= 0 -> return slot
    jet_cli_perf_outside_read(fold, pid)
}

// Read process `pid`'s mappings into its current `slot` again, at most once
// a drain, for a frame they missed: code the process mapped since they
// were read. Whether they were read again.
jet_cli_perf_outside_reread: fn(fold: ^JetCLIPerfOutsideFold, pid: Int, slot: Int) -[FS.Read]> Bool Never! {
    if fold.slots[pid, or: -1] != slot || fold.read_at[slot] >= fold.drains -> return false
    fold.read_at[slot] = fold.drains
    recorded: jet_cli_perf_outside_recorded(fold, pid)
    if recorded.len() > 0 {
        fold.processes[slot] = recorded.move()
        return true
    }
    mapped: jet_cli_perf_outside_process(pid, fold.images) ?? return false
    fold.processes[slot] = mapped
    true
}

// Where process `pid`'s code is mapped, by the mappings of code the kernel
// reported it made since its last execve, and, until it makes one, those
// its parent made, which its fork kept: a jet's comptime child runs the
// runtime image the jet mapped before the fork, beside the batch code it
// maps itself. Each mapped file's images are read into `fold.images`
// unless an earlier mapping's were; a file none can be read of (an
// anonymous mapping's, the vDSO's) names none of its code. None when the
// kernel reported no mapping that names its code.
jet_cli_perf_outside_recorded: fn(fold: ^JetCLIPerfOutsideFold, pid: Int) -[FS.Read]> [JetCLIPerfOutsideRange] Never! {
    ranges := [JetCLIPerfOutsideRange]{}
    owner := pid
    // Each step goes to a parent, so a pid reused as an ancestor's ends it.
    loop _ in 0..<fold.parents.len() + 1 {
        since: fold.execs[owner, or: -1]
        loop mapping in fold.mappings {
            if mapping.pid != owner || mapping.time < since -> next
            if !jet_cli_perf_outside_known(fold.images, fold.unreadable, mapping.path) -> next
            range: jet_cli_perf_outside_mapped(mapping.start, mapping.end, mapping.offset, mapping.path, fold.images)
            if range.image >= 0 -> ranges.push(range)
        }
        // An execve replaced all its parent's code.
        if since >= 0 -> break
        owner = fold.parents[owner, or: -1]
        if owner < 0 -> break
    }
    ranges
}

// Whether the images of file `path` are in `images`, read now when no
// earlier mapping's were, unless the file is `unreadable`, as it is once
// its own image can't be read.
jet_cli_perf_outside_known: fn(images: ^[JetCLIPerfOutsideImage], unreadable: ^[String:Bool], path: String) -[FS.Read]> Bool Never! {
    if unreadable[path, or: false] -> return false
    if jet_cli_perf_outside_load(images, path, path) != "" {
        unreadable[path] = true
        return false
    }
    true
}

// Fold the samples, execs, mappings and forks `taken` holds into `fold`,
// each sample's frames named by its process's code, or by the batch its
// jet listed when that code holds the frame (jet_cli_perf_outside_listed),
// and empty them; their totals stay. An execve's process names its later
// samples by its new executable.
jet_cli_perf_outside_take: fn(fold: ^JetCLIPerfOutsideFold, taken: ^X64Samples) -[FS.Read]> Never! {
    fold.drains += 1
    at := 0
    loop at + 1 < taken.execs.len() {
        pid: taken.execs[at]
        fold.before[pid] = fold.slots[pid, or: -1]
        fold.slots[pid] = -1
        fold.execs[pid] = taken.execs[at + 1]
        at += 2
    }
    fold.mappings.extend(taken.maps.move())
    at = 0
    loop at + 1 < taken.forks.len() {
        fold.parents[taken.forks[at]] = taken.forks[at + 1]
        at += 2
    }
    at = 0
    loop at + 3 < taken.words.len() {
        pid: taken.words[at]
        time: taken.words[at + 2]
        count: taken.words[at + 3]
        fold.pids[pid] = true
        fold.tids[taken.words[at + 1]] = true
        slot: jet_cli_perf_outside_slot(fold, pid, time)
        // The sample's named frames' rows, the innermost first.
        chain := [Int]{}
        // Whether the last frame read, the outermost, is in a root.
        rooted := false
        loop k in 0..<count {
            rooted = false
            if slot < 0 {
                if k == 0 -> fold.unnamed += 1
                break
            }
            // A caller's frame holds its return address, the byte after its call.
            pc: if k == 0 -> taken.words[at + 4] else -> taken.words[at + 4 + k] - 1
            range := jet_cli_perf_outside_range(fold.processes[slot], pc)
            if range < 0 && jet_cli_perf_outside_reread(fold, pid, slot) {
                range = jet_cli_perf_outside_range(fold.processes[slot], pc)
            }
            image: if range < 0 -> -1 else -> fold.processes[slot][range].image
            link: if range < 0 -> 0 else -> pc + fold.processes[slot][range].delta
            index: if range < 0 -> -1 else -> x64_image_function_find(fold.images[image].functions, link)
            listed: if index < 0 -> jet_cli_perf_outside_listed(fold, pid, pc) else -> -1
            if index < 0 && listed < 0 {
                if k == 0 -> fold.unnamed += 1
                next
            }
            // The pid's listing, when the listing names the frame.
            codes: fold.listed[pid, or: -1]
            name: if listed >= 0 -> "{fold.listings[codes][listed].name}" else -> "{fold.images[image].functions[index].name}"
            row: fold.named[name, or: fold.rows.len()]
            if row == fold.rows.len() {
                fold.named[name] = row
                fold.rows.push(if listed >= 0 -> jet_cli_perf_outside_placed(name, fold.listings[codes][listed].file, fold.listings[codes][listed].line) else -> jet_cli_perf_outside_row(name, fold.images[image].lines, link))
            }
            if k == 0 -> fold.rows[row].own = fold.rows[row].own + 1
            if fold.rows[row].seen != fold.sample {
                fold.rows[row].seen = fold.sample
                fold.rows[row].total = fold.rows[row].total + 1
            }
            rooted = fold.rows[row].root
            chain.push(row)
        }
        if {
            rooted -> fold.unwound += 1
            count >= fold.depth -> fold.cut += 1
            else -> fold.broken += 1
        }
        package := ""
        loop row in chain {
            if fold.rows[row].package != "" {
                package = "{fold.rows[row].package}"
                break
            }
        }
        fold.working[package] = fold.working[package, or: 0] + 1
        node: jet_cli_perf_outside_tree_add(fold.tree, chain)
        if {
            fold.timeline.len() < JET_CLI_PERF_OUTSIDE_TIMELINE -> {
                fold.timeline.push(JetCLIPerfOutsideMoment{us: (time - fold.origin_ns) /% 1000, node: node})
            }
            else -> { fold.dropped += 1 }
        }
        at += 4 + count
        fold.sample += 1
    }
    taken.words = [Int]{}
    taken.execs = [Int]{}
    taken.maps = [X64SampleMapping]{}
    taken.forks = [Int]{}
}

// The sections of what `fold` made of the samples `taken` read, of
// `threads` threads of `processes` processes over `window_ms`, or until
// the process exited, `exited_ms` into the window.
// The `functions` section (type `JetPerfFunctions`) says where their CPU
// went: the `samples`, one each `period_ns` of a thread's CPU time; those
// the kernel `lost`; those whose innermost frame no function of its
// process's executable holds (`unnamed`); the functions the samples were
// in, by name, the most samples whose innermost frame is in it (`self`)
// first, then the most with it anywhere on their stack (`total`), at most
// JET_CLI_PERF_OUTSIDE_ROWS, each with its declaration's `file` and `line`
// when its image's location table names them; the samples by the
// `packages` they worked for, the package of each one's innermost frame in
// a package of the program ("" for a sample with none: the runtime's own
// work, Core's, or code no image names), the most first; the samples by the
// `phases` of the command's jet they were taken in
// (jet_cli_perf_outside_phase_samples), the most first, none without
// `phases`; the `stacks`
// (jet_cli_perf_outside_folded); and how far each sample's stack was
// unwound: `unwound` to JET_CLI_PERF_OUTSIDE_MAIN or a function of
// JET_CLI_PERF_OUTSIDE_ENTRIES, `cut` at the kernel's frame limit
// (jet_cli_perf_outside_depth), or `broken` anywhere else, where a frame
// pointer was lost. The `timeline` section says when
// (jet_cli_perf_outside_timeline), timed from `origin_unix_ns`.
jet_cli_perf_outside_sections: fn(fold: ^JetCLIPerfOutsideFold, taken: X64Samples, processes: Int, threads: Int, window_ms: Int, exited_ms: Int?, origin_unix_ns: Int, phases: [JetCLIPerfOutsidePhase]) -> JetCLIPerfOutsideSections Never! {
    stacks: jet_cli_perf_outside_folded(fold.tree, fold.rows, taken.samples)
    // Before the rows are sorted: the timeline names them by index. It
    // sorts the samples by their time, as the phases' sweep needs.
    timeline: jet_cli_perf_outside_timeline(fold, origin_unix_ns)
    phased: jet_cli_perf_outside_phase_samples(fold.timeline, phases, origin_unix_ns)
    packages := [JetCLIPerfOutsidePackage]{}
    loop (package, samples) in fold.working {
        packages.push(JetCLIPerfOutsidePackage{package: "{package}", samples: samples})
    }
    packages.sort_by(fn(left: JetCLIPerfOutsidePackage, right: JetCLIPerfOutsidePackage) { (right.samples <=> left.samples).then(left.package <=> right.package) })
    fold.rows.sort_by(fn(left: JetCLIPerfOutsideRow, right: JetCLIPerfOutsideRow) {
        if left.own != right.own -> return right.own <=> left.own
        right.total <=> left.total
    })
    kept: if fold.rows.len() > JET_CLI_PERF_OUTSIDE_ROWS -> JET_CLI_PERF_OUTSIDE_ROWS else -> fold.rows.len()
    functions: loop k in 0..<kept -> jet_cli_perf_outside_function(fold.rows[k])
    value: CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "broken", value: CanonicalJSON.Integer("{fold.broken}")},
            {key: "cut", value: CanonicalJSON.Integer("{fold.cut}")},
            {key: "exited_ms", value: if exited_ms == .Val(ms) -> CanonicalJSON.Integer("{ms}") else -> CanonicalJSON.Null},
            {key: "functions", value: CanonicalJSON.Array(functions)},
            {key: "lost", value: CanonicalJSON.Integer("{taken.lost}")},
            {
                key: "packages",
                value: CanonicalJSON.Array(
                    loop each in packages -> CanonicalJSON.Object(
                        [CanonicalJSONField]{
                            {key: "package", value: CanonicalJSON.String(each.package)},
                            {key: "samples", value: CanonicalJSON.Integer("{each.samples}")},
                        },
                    ),
                ),
            },
            {key: "period_ns", value: CanonicalJSON.Integer("{JET_CLI_PERF_OUTSIDE_PERIOD_NS}")},
            {
                key: "phases",
                value: CanonicalJSON.Array(
                    loop each in phased -> CanonicalJSON.Object(
                        [CanonicalJSONField]{
                            {key: "phase", value: CanonicalJSON.String(each.phase)},
                            {key: "samples", value: CanonicalJSON.Integer("{each.samples}")},
                        },
                    ),
                ),
            },
            {key: "processes", value: CanonicalJSON.Integer("{processes}")},
            {key: "samples", value: CanonicalJSON.Integer("{taken.samples}")},
            {
                key: "stacks",
                value: CanonicalJSON.Array(
                    loop each in stacks -> CanonicalJSON.Object(
                        [CanonicalJSONField]{
                            {key: "samples", value: CanonicalJSON.Integer("{each.samples}")},
                            {key: "stack", value: CanonicalJSON.String(each.stack)},
                        },
                    ),
                ),
            },
            {key: "threads", value: CanonicalJSON.Integer("{threads}")},
            {key: "unnamed", value: CanonicalJSON.Integer("{fold.unnamed}")},
            {key: "unwound", value: CanonicalJSON.Integer("{fold.unwound}")},
            {key: "window_ms", value: CanonicalJSON.Integer("{window_ms}")},
        },
    )
    JetCLIPerfOutsideSections{functions: TraceReceiptSection{name: "functions", type_name: "JetPerfFunctions", digest: canonical_json_sha256(value), value: value}, timeline: timeline}
}

// The samples of `timeline`, sorted by their time from `origin_unix_ns`, by
// the phase each was taken in: the innermost of `phases` open at its time,
// the one opened last, or "" for one taken in none; the most first, and
// none without `phases`.
jet_cli_perf_outside_phase_samples: fn(timeline: [JetCLIPerfOutsideMoment], phases: [JetCLIPerfOutsidePhase], origin_unix_ns: Int) -> [{phase: String, samples: Int}] Never! {
    if phases.len() == 0 -> return [{phase: String, samples: Int}]{}
    order := phases
    order.sort_by(fn(left: JetCLIPerfOutsidePhase, right: JetCLIPerfOutsidePhase) { left.start_us <=> right.start_us })
    counts := [String:Int]{}
    // The phases open at the sample's time, by their place in `order`; the
    // next to open is `due`.
    open := [Int]{}
    due := 0
    base: origin_unix_ns /% 1000
    loop moment in timeline {
        at: base + moment.us
        loop due < order.len() && order[due].start_us <= at {
            open.push(due)
            due += 1
        }
        kept := 0
        innermost := -1
        loop index in 0..<open.len() {
            span: open[index]
            if order[span].end_us <= at -> next
            open[kept] = span
            kept += 1
            if innermost < 0 || order[span].start_us >= order[innermost].start_us {
                innermost = span
            }
        }
        loop open.len() > kept -> _: open.pop()
        phase: if innermost < 0 -> "" else -> "{order[innermost].phase}"
        counts[phase] = counts[phase, or: 0] + 1
    }
    shares := [{phase: String, samples: Int}]{}
    loop (phase, samples) in counts { shares.push({phase: "{phase}", samples: samples}) }
    shares.sort_by(fn(left: {phase: String, samples: Int}, right: {phase: String, samples: Int}) { (right.samples <=> left.samples).then(left.phase <=> right.phase) })
    shares
}

// The `timeline` section (type `JetPerfTimeline`): when each sample was
// taken and where. `functions` holds every function the samples were in,
// each as the `functions` section's rows are; `nodes`, their call tree,
// two numbers a node, its function's index and its parent node's (-1 for a
// stack's outermost frame), a parent before its children; and `samples`,
// two numbers a sample, the earliest first: its microseconds since
// `origin_unix_ns`, the wall clock's nanoseconds when the sampling began,
// and its innermost node (-1 for a stack with no named frame). `dropped`
// counts the samples past JET_CLI_PERF_OUTSIDE_TIMELINE, which the
// `functions` section still counts.
jet_cli_perf_outside_timeline: fn(fold: ^JetCLIPerfOutsideFold, origin_unix_ns: Int) -> TraceReceiptSection Never! {
    fold.timeline.sort_by(fn(left: JetCLIPerfOutsideMoment, right: JetCLIPerfOutsideMoment) { (left.us <=> right.us).then(left.node <=> right.node) })
    nodes := [CanonicalJSON]{}
    loop (node, row) in fold.tree.rows {
        nodes.push(CanonicalJSON.Integer("{row}"))
        nodes.push(CanonicalJSON.Integer("{fold.tree.parents[node]}"))
    }
    samples := [CanonicalJSON]{}
    loop moment in fold.timeline {
        samples.push(CanonicalJSON.Integer("{moment.us}"))
        samples.push(CanonicalJSON.Integer("{moment.node}"))
    }
    functions: loop row in fold.rows -> jet_cli_perf_outside_function(row)
    value: CanonicalJSON.Object(
        [CanonicalJSONField]{
            {key: "dropped", value: CanonicalJSON.Integer("{fold.dropped}")},
            {key: "functions", value: CanonicalJSON.Array(functions)},
            {key: "nodes", value: CanonicalJSON.Array(nodes)},
            {key: "origin_unix_ns", value: CanonicalJSON.Integer("{origin_unix_ns}")},
            {key: "period_ns", value: CanonicalJSON.Integer("{JET_CLI_PERF_OUTSIDE_PERIOD_NS}")},
            {key: "samples", value: CanonicalJSON.Array(samples)},
        },
    )
    TraceReceiptSection{name: "timeline", type_name: "JetPerfTimeline", digest: canonical_json_sha256(value), value: value}
}

// Whether process `pid` has exited: its /proc entry is gone, or it is a
// zombie its parent has not reaped yet (state Z or X in /proc/<pid>/stat,
// the first field after the command's closing parenthesis).
jet_cli_perf_outside_exited: fn(pid: Int) -[FS.Read]> Bool Never! {
    stat: perf_files.read("/proc/{pid}/stat") ?? return true
    cut: stat.rpartition(")")
    if cut.sep == "" || cut.tail.len() < 2 -> return true
    state: cut.tail.slice(1..<2)
    state == "Z" || state == "X"
}

// The CPU the threads `sampled` have run, each of process
// `family[owner[thread]]`: each one's schedstat run time
// (/proc/<pid>/task/<tid>/schedstat's first field), to the nanosecond, as
// jet_cli_perf_attach_cpu counts a program's. A thread that exited has no
// file left and no time. None when the kernel keeps no schedstat.
jet_cli_perf_outside_cpu: fn(sampled: [X64SampleRing], family: [Int], owner: [Int:Int]) -[FS.Read]> JetCLIPerfAttachCPU? Never! {
    threads := [Int:U64]{}
    total := U64{0}
    loop each in sampled {
        process: family[owner[each.thread, or: 0]]
        text: perf_files.read("/proc/{process}/task/{each.thread}/schedstat") ?? next
        words: jet_cli_find_words(text)
        if words.len() == 0 -> next
        ns: jet_live_stat_ticks(words[0]) ?? next
        threads[each.thread] = ns
        total += ns
    }
    if threads.len() == 0 -> return None
    Val(JetCLIPerfAttachCPU{ns: total, resolution_ns: U64{1}, threads: threads})
}

// The `functions` section's object of function `row`, its keys in the
// order A-canonical JSON sorts them: its declaration's `file` and `line`
// when its image's location table names them, then `name`, `self` and
// `total`.
jet_cli_perf_outside_function: fn(row: JetCLIPerfOutsideRow) -> CanonicalJSON Never! {
    fields := [CanonicalJSONField]{}
    if row.file != "" {
        fields.push({key: "file", value: CanonicalJSON.String(row.file)})
        fields.push({key: "line", value: CanonicalJSON.Integer("{row.line}")})
    }
    fields.push({key: "name", value: CanonicalJSON.String(row.name)})
    fields.push({key: "self", value: CanonicalJSON.Integer("{row.own}")})
    fields.push({key: "total", value: CanonicalJSON.Integer("{row.total}")})
    CanonicalJSON.Object(fields)
}

// The row of function `name`, whose code holds link address `link` of an
// image with location table `lines`: its declaration's file, line and
// package when the table names the function there.
jet_cli_perf_outside_row: fn(name: String, lines: X64Jetline, link: Int) -> JetCLIPerfOutsideRow Never! {
    found: x64_jetline_find(lines, link)
    if found < 0 -> return jet_cli_perf_outside_placed(name, "", 0)
    function: lines.functions[found]
    jet_cli_perf_outside_placed(name, jet_cli_perf_outside_path(function.dir, function.file), function.decl)
}

// The row of function `name` declared at `line` of `file` ("" and 0 for
// none), with the package of the program `file` lies in.
jet_cli_perf_outside_placed: fn(name: String, file: String, line: Int) -> JetCLIPerfOutsideRow Never! {
    row := JetCLIPerfOutsideRow{name: name, own: 0, total: 0, seen: -1, file: file, line: line, package: "", root: name == JET_CLI_PERF_OUTSIDE_MAIN}
    loop entry in JET_CLI_PERF_OUTSIDE_ENTRIES {
        if entry == row.name -> row.root = true
    }
    // Core's sources (`<corelib>/…`) are the library a package calls, so a
    // sample in them works for its caller's package.
    if row.file != "" && !row.file.starts_with("<") {
        row.package = jet_cli_perf_symbol_package(row.file)
    }
    row
}

// The function of a compile-time batch that holds address `pc` of process
// `pid`, as `fold.code` lists the batches loaded in it: its index in the
// pid's listing, `fold.listings[fold.listed[pid]]`; -1 when it lists none
// there. A listing that misses `pc` is read again, at most once a drain:
// the jet lists each batch before it runs, so one loaded since the last
// read is listed by then.
jet_cli_perf_outside_listed: fn(fold: ^JetCLIPerfOutsideFold, pid: Int, pc: Int) -[FS.Read]> Int Never! {
    if fold.code == "" -> return -1
    slot := fold.listed[pid, or: -1]
    if slot < 0 {
        slot = fold.listings.len()
        fold.listings.push([JetCLIPerfOutsideCode]{})
        fold.listed_at.push(-1)
        fold.listed[pid] = slot
    }
    found := jet_cli_perf_outside_code_at(fold.listings[slot], pc)
    if found < 0 && fold.listed_at[slot] < fold.drains {
        fold.listed_at[slot] = fold.drains
        text: perf_files.read(fold.code.replace("%p", "{pid}")) ?? ""
        fold.listings[slot] = jet_cli_perf_outside_listing(text)
        found = jet_cli_perf_outside_code_at(fold.listings[slot], pc)
    }
    found
}

// The functions a listing `text` names (ENV_JET_PERF_CODE), sorted by
// start: one a line, its start and end address, its declaration's line and
// file, and its name, tab-separated. A line that doesn't parse names none.
jet_cli_perf_outside_listing: fn(text: String) -> [JetCLIPerfOutsideCode] Never! {
    found := [JetCLIPerfOutsideCode]{}
    loop line in text.split("\n") {
        fields: line.split("\t").to_list()
        if fields.len() < 5 -> next
        start: Int.parse(fields[0]) ?? next
        end: Int.parse(fields[1]) ?? next
        declared: Int.parse(fields[2]) ?? next
        if end <= start || fields[4] == "" -> next
        found.push(JetCLIPerfOutsideCode{start: start, end: end, line: declared, file: jet_cli_perf_outside_path("", fields[3]), name: fields[4]})
    }
    found.sort_by(fn(left: JetCLIPerfOutsideCode, right: JetCLIPerfOutsideCode) { left.start <=> right.start })
    found
}

// The index of the function of `functions` (sorted by start) whose code
// holds `pc`; -1 when none does.
jet_cli_perf_outside_code_at: fn(functions: [JetCLIPerfOutsideCode], pc: Int) -> Int Never! {
    low := 0
    high := functions.len()
    loop low < high {
        middle: (low + high) /% 2
        if functions[middle].start <= pc -> low = middle + 1 else -> high = middle
    }
    if low == 0 || pc >= functions[low - 1].end -> return -1
    low - 1
}

// The source `file` a location table names, under its compilation
// directory `dir`, with its `.` and `..` steps taken:
// `Compiler/JetSema/Source/Statements.jet` for `../JetSema/Source/
// Statements.jet` under `Compiler/JetCLI`. A path already absolute, or
// Core's `<corelib>/…`, stands as it is.
jet_cli_perf_outside_path: fn(dir: String, file: String) -> String Never! {
    if file == "" -> return ""
    full: if file.starts_with("/") || file.starts_with("<") || dir == "" || dir == "." -> "{file}" else -> "{dir}/{file}"
    parts := [String]{}
    loop (index, part) in full.split("/").to_list() {
        if part == "." || (part == "" && index > 0) -> next
        if part == ".." && parts.len() > 0 && parts[parts.len() - 1] != ".." && parts[parts.len() - 1] != "" {
            _: parts.pop()
            next
        }
        parts.push("{part}")
    }
    parts.join("/")
}

// The most frames the kernel gives a sample's call chain:
// /proc/sys/kernel/perf_event_max_stack, else JET_CLI_PERF_OUTSIDE_DEPTH. A
// chain that long was cut there.
jet_cli_perf_outside_depth: fn() -[FS.Read]> Int Never! {
    text: perf_files.read("/proc/sys/kernel/perf_event_max_stack") ?? return JET_CLI_PERF_OUTSIDE_DEPTH
    Int.parse(text.trim()) ?? JET_CLI_PERF_OUTSIDE_DEPTH
}

// Add a sample's stack, its frames' rows `chain` (the innermost first), to
// `tree`: its innermost node, -1 for an empty chain.
jet_cli_perf_outside_tree_add: fn(tree: ^JetCLIPerfOutsideTree, chain: [Int]) -> Int Never! {
    node := -1
    at := chain.len()
    loop at > 0 {
        at -= 1
        key: (node + 1) * JET_CLI_PERF_OUTSIDE_ROW_KEY + chain[at]
        child := tree.children[key, or: -1]
        if child < 0 {
            child = tree.rows.len()
            tree.children[key] = child
            tree.rows.push(chain[at])
            tree.parents.push(node)
            tree.totals.push(0)
        }
        tree.totals[child] = tree.totals[child] + 1
        node = child
    }
    node
}

// The folded stacks of `tree`, whose functions are `rows`, in the
// flame-graph tools' form: each stack its functions from the outermost,
// `;` between them, and the samples whose stack it is. A stack that holds
// fewer than one of the `samples` in JET_CLI_PERF_OUTSIDE_STACK_SHARE is
// folded into the one it was called from, and is left out when it has
// none, so the attach stays small however deep its stacks run. Sorted by
// stack.
jet_cli_perf_outside_folded: fn(tree: JetCLIPerfOutsideTree, rows: [JetCLIPerfOutsideRow], samples: Int) -> [JetCLIPerfOutsideStack] Never! {
    // A node's samples less those of its kept children; a parent's index
    // is below its children's.
    own := [Int]{}
    kept := [Bool]{}
    loop (node, total) in tree.totals {
        keep: total * JET_CLI_PERF_OUTSIDE_STACK_SHARE >= samples
        kept.push(keep)
        own.push(total)
        parent: tree.parents[node]
        if keep && parent >= 0 -> own[parent] = own[parent] - total
    }
    stacks := [JetCLIPerfOutsideStack]{}
    loop (node, keep) in kept {
        if !keep || own[node] <= 0 -> next
        // The stack's functions, the innermost first.
        names := [String]{}
        at := node
        loop at >= 0 {
            names.push("{rows[tree.rows[at]].name}")
            at = tree.parents[at]
        }
        text := ""
        k := names.len()
        loop k > 0 {
            k -= 1
            text = if text == "" -> "{names[k]}" else -> "{text};{names[k]}"
        }
        stacks.push(JetCLIPerfOutsideStack{stack: text, samples: own[node]})
    }
    stacks.sort_by(fn(left: JetCLIPerfOutsideStack, right: JetCLIPerfOutsideStack) { left.stack <=> right.stack })
    stacks
}

// Process `pid` and the processes it started, and theirs, from each
// thread's /proc `children`, at most JET_CLI_PERF_OUTSIDE_PROCESSES.
jet_cli_perf_outside_family: fn(pid: Int) -[FS.Read]> [Int] Never! {
    family := [Int]{pid}
    at := 0
    loop at < family.len() {
        each: family[at]
        at += 1
        tasks: perf_files.list_dir("/proc/{each}/task") ?? next
        loop task in tasks {
            text: perf_files.read("/proc/{each}/task/{task.name}/children") ?? next
            loop word in jet_cli_find_words(text) {
                child: Int.parse(word) ?? next
                if family.len() < JET_CLI_PERF_OUTSIDE_PROCESSES -> family.push(child)
            }
        }
    }
    family
}

// Where process `pid`'s code is mapped in it, by the images of its
// executable file, read into `images` unless an earlier process runs the
// same file.
jet_cli_perf_outside_process: fn(pid: Int, images: ^[JetCLIPerfOutsideImage]) -[FS.Read]> [JetCLIPerfOutsideRange] JetCLIReadError! {
    exe: perf_files.read_link("/proc/{pid}/exe") ?? return Err(jet_cli_read_error("process {pid}'s executable can't be found: {jet_cli_io_error_text(err)}"))
    // A replaced executable's link says so; its mappings name the path alone.
    path: if exe.ends_with(" (deleted)") -> exe.slice(0..<exe.len() - 10) else -> exe
    // The link opens the file the process runs, replaced or not.
    failure: jet_cli_perf_outside_load(images, "/proc/{pid}/exe", path)
    if failure != "" {
        return Err(jet_cli_read_error("process {pid}'s executable {path} {failure}"))
    }
    maps: perf_files.read("/proc/{pid}/maps") ?? return Err(jet_cli_read_error("process {pid}'s mappings can't be read: {jet_cli_io_error_text(err)}"))
    Ok(jet_cli_perf_outside_ranges(maps, path, images))
}

// Read the images of the executable file `path`, opened as `file`, into
// `images` unless an earlier process runs the same file: its own, then
// each part it holds whose functions can be read. Why its own can't be
// read, "" when it can.
jet_cli_perf_outside_load: fn(images: ^[JetCLIPerfOutsideImage], file: String, path: String) -[FS.Read]> String Never! {
    loop image in images {
        if image.path == path -> return ""
    }
    own: jet_cli_perf_outside_image(file, path, 0) ?? return err.message
    images.push(own)
    // A part whose functions can't be read leaves its code unnamed.
    loop base in jet_cli_perf_outside_parts(file) {
        part: jet_cli_perf_outside_image(file, path, base) ?? next
        images.push(part)
    }
    ""
}

// The ELF image at offset `base` of the executable file `file`, which
// mappings name `path`: its loadable segments, its functions and its
// location table, read from its start to the end of its section headers,
// which its .symtab, .strtab and .debug_jetline lie before. Err says why it
// has no function.
jet_cli_perf_outside_image: fn(file: String, path: String, base: Int) -[FS.Read]> JetCLIPerfOutsideImage JetCLIReadError! {
    head: perf_files.read_at(file, base, 64) ?? return Err(jet_cli_read_error("can't be read: {jet_cli_io_error_text(err)}"))
    if head.len() < 64 || jet_cli_perf_outside_word(head, 0, 4) != JET_CLI_PERF_OUTSIDE_ELF {
        return Err(jet_cli_read_error("isn't an ELF image"))
    }
    count: jet_cli_perf_outside_word(head, 56, 2)
    table: perf_files.read_at(file, base + jet_cli_perf_outside_word(head, 32, 8), count * 56) ?? return Err(jet_cli_read_error("can't be read: {jet_cli_io_error_text(err)}"))
    segments := [JetCLIPerfOutsideSegment]{}
    loop k in 0..<count {
        at: k * 56
        if at + 56 > table.len() -> break
        // PT_LOAD
        if jet_cli_perf_outside_word(table, at, 4) != 1 -> next
        segments.push(JetCLIPerfOutsideSegment{offset: base + jet_cli_perf_outside_word(table, at + 8, 8), size: jet_cli_perf_outside_word(table, at + 32, 8), address: jet_cli_perf_outside_word(table, at + 16, 8)})
    }
    end: jet_cli_perf_outside_word(head, 40, 8) + jet_cli_perf_outside_word(head, 60, 2) * 64
    bytes: perf_files.read_at(file, base, end) ?? return Err(jet_cli_read_error("can't be read: {jet_cli_io_error_text(err)}"))
    read: x64_image_functions(bytes)
    if read.failure != "" -> return Err(jet_cli_read_error("names no function: {read.failure}"))
    lines: x64_jetline_read(bytes) ?? X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}
    Ok(JetCLIPerfOutsideImage{path: path, functions: read.functions.move(), segments: segments, lines: lines})
}

// The offsets in the executable file `file` of the ELF executables it holds
// as parts (x64_executable_add_parts), as a jet holds its runtime image:
// each PT_NOTE of its program headers that is a jet part's note (`Jet`,
// then the part's label, padded with at least one NUL to 8 bytes) whose
// bytes are an executable, not an object file.
jet_cli_perf_outside_parts: fn(file: String) -[FS.Read]> [Int] Never! {
    parts := [Int]{}
    head: perf_files.read_at(file, 0, 64) ?? return parts
    if head.len() < 64 -> return parts
    count: jet_cli_perf_outside_word(head, 56, 2)
    table: perf_files.read_at(file, jet_cli_perf_outside_word(head, 32, 8), count * 56) ?? return parts
    loop k in 0..<count {
        at: k * 56
        if at + 56 > table.len() -> break
        // PT_NOTE
        if jet_cli_perf_outside_word(table, at, 4) != 4 -> next
        from: jet_cli_perf_outside_word(table, at + 8, 8)
        size: jet_cli_perf_outside_word(table, at + 32, 8)
        note: perf_files.read_at(file, from, if size < 272 -> size else -> 272) ?? next
        // A 4-byte name, `Jet` and its NUL.
        if note.len() < 17 || jet_cli_perf_outside_word(note, 0, 4) != 4 || jet_cli_perf_outside_word(note, 12, 4) != 0x0074654a {
            next
        }
        label := 16
        loop label < note.len() && note[label] != 0 -> label += 1
        if label == note.len() -> next
        payload: from + 16 + (label - 16 + 8) /% 8 * 8
        magic: perf_files.read_at(file, payload, 18) ?? next
        // ET_EXEC or ET_DYN
        if magic.len() < 18 || jet_cli_perf_outside_word(magic, 0, 4) != JET_CLI_PERF_OUTSIDE_ELF {
            next
        }
        kind: jet_cli_perf_outside_word(magic, 16, 2)
        if kind == 2 || kind == 3 -> parts.push(payload)
    }
    parts
}

// The executable code of `maps` (a process's /proc/<pid>/maps) that the
// images of the executable file mappings name `path` hold
// (jet_cli_perf_outside_mapped).
jet_cli_perf_outside_ranges: fn(maps: String, path: String, images: [JetCLIPerfOutsideImage]) -> [JetCLIPerfOutsideRange] Never! {
    ranges := [JetCLIPerfOutsideRange]{}
    loop line in maps.split("\n").to_list() {
        words: jet_cli_find_words(line)
        // start-end, permissions, file offset, device, inode, path.
        if words.len() < 6 || !words[1].contains("x") || words[5] != path -> next
        bounds: words[0].split("-").to_list()
        if bounds.len() != 2 -> next
        start: jet_cli_perf_outside_hex(bounds[0]) ?? next
        end: jet_cli_perf_outside_hex(bounds[1]) ?? next
        offset: jet_cli_perf_outside_hex(words[2]) ?? next
        found: jet_cli_perf_outside_mapped(start, end, offset, path, images)
        if found.image >= 0 -> ranges.push(found)
    }
    ranges
}

// The range of a mapping from `start` to `end` of file `path` from file
// offset `offset`, by the smallest loadable segment of the file's images
// that holds the offset: image -1 when none does. A mapping starts at the
// page that holds its segment's first byte.
jet_cli_perf_outside_mapped: fn(start: Int, end: Int, offset: Int, path: String, images: [JetCLIPerfOutsideImage]) -> JetCLIPerfOutsideRange Never! {
    found := JetCLIPerfOutsideRange{start: start, end: end, delta: 0, image: -1}
    size := 0
    loop (index, image) in images {
        if image.path != path -> next
        loop segment in image.segments {
            holds: offset >= segment.offset - segment.offset % 4096 && offset < segment.offset + segment.size
            if holds && (found.image < 0 || segment.size < size) {
                found.delta = segment.address + offset - segment.offset - start
                found.image = index
                size = segment.size
            }
        }
    }
    found
}

// The little-endian `width`-byte word at `at` of `bytes`.
jet_cli_perf_outside_word: fn(bytes: [U8], at: Int, width: Int) -> Int Never! {
    value := 0
    loop k in 0..<width -> value = value | (Int{bytes[at + k]} << (8 * k))
    value
}

// The hexadecimal `text` of /proc's maps, without its `0x`.
jet_cli_perf_outside_hex: fn(text: String) -> Int? Never! {
    if text == "" -> return None
    value := 0
    loop byte in text.bytes() {
        code: Int{byte}
        digit := -1
        if code >= 48 && code <= 57 -> digit = code - 48
        if code >= 97 && code <= 102 -> digit = code - 87
        if digit < 0 -> return None
        value = value * 16 + digit
    }
    Val(value)
}

// The index of the range of `ranges` that holds process address `pc`,
// else -1.
jet_cli_perf_outside_range: fn(ranges: [JetCLIPerfOutsideRange], pc: Int) -> Int Never! {
    loop (index, range) in ranges {
        if pc >= range.start && pc < range.end -> return index
    }
    -1
}

// The `functions` section's lines (jet_cli_perf_outside_sample):
// `functions samples=1003 processes=2 threads=35 window_ms=1000 lost=0
// unnamed=241`; when the process exited in the window, `exited 420 ms
// into the 3000 ms window`; how far the stacks were unwound, `stacks unwound=990
// cut=9 broken=4`; then each function it keeps, each share of the
// samples, and where it is declared when that is known: `  41.6% self
// 68.2% total · Statements.sema_stmt_check at
// Compiler/JetSema/Source/Statements.jet:212`; then the samples by
// package, as a run's profile prints them (jet_cli_perf_package_lines),
// and by the phase of the command's jet they were taken in, the same way
// under `cpu by phase`.
jet_cli_perf_outside_lines: fn(value: CanonicalJSON) -> [String] Never! {
    lines := [String]{}
    fields: jettrace_object_view(value, "receipt functions") ?? return lines
    samples: jet_cli_perf_member_number(value, "samples") ?? 0
    processes: jet_cli_perf_field_integer(fields, "processes") ?? "0"
    threads: jet_cli_perf_field_integer(fields, "threads") ?? "0"
    window: jet_cli_perf_field_integer(fields, "window_ms") ?? "0"
    lost: jet_cli_perf_field_integer(fields, "lost") ?? "0"
    unnamed: jet_cli_perf_field_integer(fields, "unnamed") ?? "0"
    lines.push("functions samples={samples} processes={processes} threads={threads} window_ms={window} lost={lost} unnamed={unnamed}")
    if jet_cli_perf_field_integer(fields, "exited_ms") == .Val(exited) {
        lines.push("exited {exited} ms into the {window} ms window")
    }
    unwound: jet_cli_perf_field_integer(fields, "unwound") ?? "0"
    cut: jet_cli_perf_field_integer(fields, "cut") ?? "0"
    broken: jet_cli_perf_field_integer(fields, "broken") ?? "0"
    lines.push("stacks unwound={unwound} cut={cut} broken={broken}")
    if jet_cli_perf_key(fields, "functions") == .Val(at) {
        if jettrace_array(fields[at].value, "receipt functions.functions") == .Ok(rows) {
            loop row in rows {
                own: jet_cli_perf_member_number(row, "self") ?? 0
                total: jet_cli_perf_member_number(row, "total") ?? 0
                name: jet_cli_perf_member_text(row, "name") ?? "?"
                place: if jet_cli_perf_member_text(row, "file") == .Val(file) -> " at {file}:{jet_cli_perf_member_number(row, "line") ?? 0}" else -> ""
                lines.push("  {jet_cli_perf_outside_share(own, samples)} self  {jet_cli_perf_outside_share(total, samples)} total · {name}{place}")
            }
        }
    }
    period: jet_cli_perf_member_number(value, "period_ns") ?? 0
    interval: if period > 0 -> Val(period /% 1000) else -> None
    if jet_cli_perf_key(fields, "packages") == .Val(at) {
        if jettrace_array(fields[at].value, "receipt functions.packages") == .Ok(rows) {
            parts: loop row in rows -> {dir: jet_cli_perf_member_text(row, "package") ?? "", weight: jet_cli_perf_member_number(row, "samples") ?? 0}
            loop line in jet_cli_perf_package_lines(parts, samples, interval) -> lines.push(line)
        }
    }
    if jet_cli_perf_key(fields, "phases") == .Val(at) {
        if jettrace_array(fields[at].value, "receipt functions.phases") == .Ok(rows) {
            parts: loop row in rows -> {dir: jet_cli_perf_member_text(row, "phase") ?? "", weight: jet_cli_perf_member_number(row, "samples") ?? 0}
            loop line in jet_cli_perf_package_lines(parts, samples, interval, heading: "cpu by phase") {
                lines.push(line)
            }
        }
    }
    lines
}

// `part` of `whole` as a percentage to a tenth, `41.2%`.
jet_cli_perf_outside_share: fn(part: Int, whole: Int) -> String Never! {
    if whole <= 0 -> return "0.0%"
    tenths: (part * 1000 + whole /% 2) /% whole
    "{tenths /% 10}.{tenths % 10}%"
}

// The lines of the trace's `functions` receipt section, none when it has
// none (jet_cli_perf_outside_lines).
jet_cli_perf_function_lines: fn(trace: CanonicalJSON) -> [String] Never! {
    value: jet_cli_perf_outside_section(trace) ?? return [String]{}
    jet_cli_perf_outside_lines(value)
}

// The trace's `functions` receipt section's value, None when it has none.
jet_cli_perf_outside_section: fn(trace: CanonicalJSON) -> CanonicalJSON? Never! {
    items: jet_cli_perf_rows(trace, "receipt_sections") ?? return None
    loop item in items {
        section: trace_receipt_section_from_json(item) ?? next
        if section.name == "functions" -> return Val(section.value)
    }
    None
}

// The flame graph of a `functions` section's folded stacks (`value`, the
// section's value): their call tree, a line a function, depth first and the
// heaviest call first, each its depth (0 for a stack's outermost frame), its
// name, its share of the samples and a bar of it: `3
// Expressions.sema_check_expression 61.4% ########################`. None
// without its stacks.
jet_cli_perf_outside_flame: fn(value: CanonicalJSON) -> [String] Never! {
    lines := [String]{}
    samples: jet_cli_perf_member_number(value, "samples") ?? return lines
    fields: jettrace_object_view(value, "receipt functions") ?? return lines
    at: jet_cli_perf_key(fields, "stacks") ?? return lines
    rows: jettrace_array(fields[at].value, "receipt functions.stacks") ?? return lines
    // The call tree: each node's function, its parent (-1 for an outermost
    // frame) and its samples; `children` finds a node's child by
    // "<node>\n<function>".
    names := [String]{}
    parents := [Int]{}
    totals := [Int]{}
    children := [String:Int]{}
    loop row in rows {
        stack: jet_cli_perf_member_text(row, "stack") ?? next
        count: jet_cli_perf_member_number(row, "samples") ?? next
        node := -1
        loop name in stack.split(";").to_list() {
            key: "{node}\n{name}"
            child := children[key, or: -1]
            if child < 0 {
                child = names.len()
                children[key] = child
                names.push("{name}")
                parents.push(node)
                totals.push(0)
            }
            totals[child] = totals[child] + count
            node = child
        }
    }
    calls := [[Int]]{}
    loop _ in 0..<names.len() -> calls.push([Int]{})
    roots := [Int]{}
    loop (node, parent) in parents {
        if parent < 0 -> roots.push(node) else -> calls[parent].push(node)
    }
    // Depth first: the nodes still to show, the next on top, each with its
    // depth.
    pending := [Int]{}
    depths := [Int]{}
    jet_cli_perf_outside_flame_push(pending, depths, roots, totals, 0)
    loop pending.len() > 0 {
        node: pending.pop() ?? break
        depth: depths.pop() ?? break
        width: totals[node] * 40 /% (if samples > 0 -> samples else -> 1)
        lines.push("{depth} {names[node]} {jet_cli_perf_outside_share(totals[node], samples)} {jet_cli_perf_bar(width)}")
        jet_cli_perf_outside_flame_push(pending, depths, calls[node], totals, depth + 1)
    }
    lines
}

// Push `nodes` onto the depth-first `pending` at `depth`, so the one with
// the most samples is shown first.
jet_cli_perf_outside_flame_push: fn(pending: ^[Int], depths: ^[Int], nodes: [Int], totals: [Int], depth: Int) Never! {
    order := [Int]{}
    loop node in nodes -> order.push(node)
    order.sort_by(fn(left: Int, right: Int) { (totals[left] <=> totals[right]).then(right <=> left) })
    loop node in order {
        pending.push(node)
        depths.push(depth)
    }
}
