// `jet inspect shapes`: project the checked modules, including imported
// declarations and folded defaults. Shape construction follows the canonical
// Schema.jet `shape_fact_from_struct` from origin/port/compiler. Each declared
// struct and enum also reports its byte layout from its checked record
// (JetDriver LayoutSummary.jet), on the target the compile checked for.
use {
    jet_driver.[
        JetDriverVerbOutput,
        JetDriverDocModule,
        JetDriverLayoutSummary,
        JET_DRIVER_EXIT_OK,
        JET_DRIVER_EXIT_USER_ERROR,
        jet_driver_layout_dominant,
        jet_driver_layout_dominant_note,
        jet_driver_layout_line,
        jet_driver_layout_ratio,
        jet_driver_layout_record_text,
        jet_driver_layout_summary,
    ]
    jet_foundation.[
        ASTTables,
        CORE_FORMAT_NAMES,
        CtValue,
        Field,
        Marker,
        MarkerCallArg,
        RENAME_PARAMETERS,
        StructDef,
        TShapeFieldNames,
        TShapeFormatName,
        Type,
        ast_expr,
        diagnostic_from_registry,
        effect_vocabulary_view_count,
        type_name,
    ]
    jet_sema.[sema_checked_rename_case, sema_checked_wire_case, sema_registration_cli_arg_text, sema_serde_items_skips]
}

// The non-codec projections: `#Rename`'s parameters beyond its shared `name`.
jet_cli_shape_named_projections: fn() -> [String] Never! {
    named := [String]{}
    loop parameter in RENAME_PARAMETERS {
        if parameter != "name" -> named.push(parameter)
    }
    named
}

// `ShapeProjectionKind.ALL`, in order: Core's codec formats, then the
// non-codec projections.
jet_cli_shape_projections: fn() -> [String] Never! {
    projections := [String]{}
    loop format in CORE_FORMAT_NAMES -> projections.push(format)
    loop projection in jet_cli_shape_named_projections() -> projections.push(projection)
    projections
}

// `Object` names the shape identity's type in the same source.
JetCLIShapeType: enum {
    Bool,
    Int,
    Float,
    Number,
    Text,
    Bytes,
    Array(inner: JetCLIShapeType),
    Optional(inner: JetCLIShapeType),
    Object(source: String, type_name: String),
    Unknown(name: String),
}

// JetCLIShapeType picks from SerdeWireShape, the shapes a field takes on the
// wire, plus `Bytes`, `Optional` and `Unknown`, which inspection reports
// without a wire shape of their own. While the compiler builds,
// JET_CLI_SHAPE_TYPE_COUNT stops the build naming any other case
// SerdeWireShape lacks.
JET_CLI_SHAPE_TYPE_COUNT: #run effect_vocabulary_view_count("CLI/InspectShapes.jet", embed_file("InspectShapes.jet"), "JetCLIShapeType", "AST/Items.jet", embed_file("toolchain:Compiler/JetFoundation/Source/AST/Items.jet"), "SerdeWireShape", [String]{"Bytes", "Optional", "Unknown"})

// `default` is the status value of the typed `ShapeDefault`.
JetCLIShapeField: struct {
    name: String,
    ty: JetCLIShapeType,
    order: Int,
    names: TShapeFieldNames,
    encoding: String,
    default: JetCLIStatusValue?,
    skip: Bool,
    short: String?,
}

// `ShapeFact` of a declared record: rank 1, one column per field, Object
// encoding, declared provenance naming the struct.
JetCLIShapeFact: struct {
    source: String,
    type_name: String,
    fields: [JetCLIShapeField],
    layout: String,
    alignment: Int?,
}

JetCLIShapeBuild: enum {
    Fact(fact: JetCLIShapeFact),
    Invalid(error: String),
}

// `ShapeError` display text.
jet_cli_shape_type: fn(source: String, ty: Type) -> JetCLIShapeType Never! {
    if ty == {
        .Int | .IntN(_, _) -> JetCLIShapeType.Int
        .Float | .Float32 -> JetCLIShapeType.Float
        .Bool -> JetCLIShapeType.Bool
        .String | .Char -> JetCLIShapeType.Text
        .List(inner) | .FixedList(inner, _) -> JetCLIShapeType.Array{inner: jet_cli_shape_type(source, inner)}
        .Option(inner) -> JetCLIShapeType.Optional{inner: jet_cli_shape_type(source, inner)}
        .Shared(inner) | .InlineRange(inner, _, _) | .Tagged(_, inner) | .Quantity(inner, _) -> jet_cli_shape_type(source, inner)
        .Named(name) -> if name == {
            "Bool" -> JetCLIShapeType.Bool
            "Int" | "I8" | "I16" | "I32" | "I64" | "U8" | "U16" | "U32" | "U64" -> JetCLIShapeType.Int
            "Float" | "F32" | "F64" -> JetCLIShapeType.Float
            "String" | "Char" -> JetCLIShapeType.Text
            "Bytes" -> JetCLIShapeType.Bytes
            "Number" -> JetCLIShapeType.Number
            else -> JetCLIShapeType.Object{source: source, type_name: name}
        }
        .Apply(name, _) -> JetCLIShapeType.Unknown{name: name}
        .Map(_, _, _) -> JetCLIShapeType.Unknown{name: "Map"}
        .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .Union(_) | .Case(_, _) | .Measure(_) -> JetCLIShapeType.Unknown{name: type_name(ty)}
    }
}

// `shape_encoding`, as `ShapeEncoding.as_str`.
jet_cli_shape_encoding: fn(ty: JetCLIShapeType) -> String Never! {
    if ty == {
        .Bool -> "Bool"
        .Int -> "Int"
        .Float -> "Float"
        .Number -> "Number"
        .Text | .Bytes -> "Text"
        .Array(_) -> "Array"
        .Optional(inner) -> jet_cli_shape_encoding(inner)
        .Object(_, _) | .Unknown(_) -> "Object"
    }
}

jet_cli_shape_type_label: fn(ty: JetCLIShapeType) -> String Never! {
    if ty == {
        .Bool -> "Bool"
        .Int -> "Int"
        .Float -> "Float"
        .Number -> "Number"
        .Text -> "Text"
        .Bytes -> "Bytes"
        .Array(inner) -> "[{jet_cli_shape_type_label(inner)}]"
        .Optional(inner) -> "{jet_cli_shape_type_label(inner)}?"
        .Object(source, name) -> "Object({source}.{name})"
        .Unknown(name) -> "Unknown({name})"
    }
}

// Schema.jet `shape_default`: only scalar and byte defaults project; aggregate
// values intentionally have no ShapeDefault.
jet_cli_shape_default: fn(value: CtValue) -> JetCLIStatusValue? Never! {
    if value == {
        .Int(number) -> Val(jet_cli_status_int(number))
        .Float(number) -> {
            text: if number == {
                .F64(float_value) -> "{float_value}"
                .F32(float_value) -> "{float_value}"
            }
            Val(JetCLIStatusValue.Float{text: text})
        }
        .Bool(flag) -> Val(jet_cli_status_bool(flag))
        .Char(code) -> Val(jet_cli_status_text("{code}"))
        .Str(text) -> Val(jet_cli_status_text(text))
        .Bytes(bytes) -> Val(jet_cli_status_array(loop byte in bytes -> jet_cli_status_int(Int{byte})))
        .Present(inner) -> jet_cli_shape_default(inner)
        .BigInt(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Failed(_) | .Unit | .Closure(_) -> None
    }
}

jet_cli_shape_marker: fn(markers: [Marker], name: String) -> Marker? Never! {
    loop marker in markers {
        if marker.name == name -> return Val(marker)
    }
    None
}

// The first literal part of a string expression of `tables`.
jet_cli_shape_static_string: fn(tables: ASTTables, argument: MarkerCallArg) -> String? Never! {
    if argument == .Expr(expression) {
        if ast_expr(tables, expression) == .Str(parts, _, _) {
            if parts.len() > 0 {
                if parts[0] == .Lit(text) -> return Val(text)
            }
        }
    }
    None
}

// `shape_marker_string`: the first argument, or the argument labeled `label`.
jet_cli_shape_marker_string: fn(tables: ASTTables, marker: Marker, label: String?) -> String? Never! {
    wanted: label ?? {
        if marker.args.len() == 0 -> return None
        return jet_cli_shape_static_string(tables, marker.args[0])
    }
    loop index in 0..<marker.arg_labels.len() {
        if marker.arg_labels[index] == .Val(written) {
            if written.name == wanted {
                if index >= marker.args.len() -> return None
                return jet_cli_shape_static_string(tables, marker.args[index])
            }
        }
    }
    None
}

// `shape_field_names` over `ShapeFieldNames.from_source`; the markers'
// arguments are nodes of `tables`.
jet_cli_shape_field_names: fn(tables: ASTTables, structure: StructDef, field: Field) -> TShapeFieldNames Never! {
    rename: jet_cli_shape_marker(field.serde_markers, "Rename")
    shared := String?{None}
    if rename == .Val(marker) -> shared = jet_cli_shape_marker_string(tables, marker, None)
    text: shared ?? sema_checked_wire_case(sema_checked_rename_case(structure.serde_markers), field.name)
    names := TShapeFieldNames{text: text, formats: [TShapeFormatName]{}, args: text.replace("_", "-"), env: jet_cli_shape_env_name(text), db: None, layout: None}
    if rename == .Val(marker) {
        // Each label beyond `#Rename`'s parameters keys a codec format.
        loop label in marker.arg_labels {
            written: label ?? next
            if RENAME_PARAMETERS.contains(written.name) -> next
            key: jet_cli_shape_marker_string(tables, marker, Val(written.name)) ?? next
            names.formats.push(TShapeFormatName{format: written.name, name: key})
        }
        if jet_cli_shape_marker_string(tables, marker, Val("args")) == .Val(args) {
            names.args = args
        }
        if jet_cli_shape_marker_string(tables, marker, Val("env")) == .Val(env) -> names.env = env
        names.db = jet_cli_shape_marker_string(tables, marker, Val("db"))
        names.layout = jet_cli_shape_marker_string(tables, marker, Val("layout"))
    }
    if sema_registration_cli_arg_text(field.serde_markers, "env") == .Val(env) -> names.env = env
    names
}

jet_cli_shape_name_for: fn(names: TShapeFieldNames, projection: String) -> String Never! {
    if projection == {
        "args" -> names.args
        "env" -> names.env
        "db" -> names.db ?? names.text
        "layout" -> names.layout ?? names.text
        else -> names.format_key(projection) ?? names.text
    }
}

// `shape_env_name`: `-` to `_`, then ASCII uppercase.
jet_cli_shape_env_name: fn(source: String) -> String Never! {
    bytes := source.replace("-", "_").bytes()
    loop index in 0..<bytes.len() {
        code: Int{bytes[index]}
        if code >= 97 && code <= 122 -> bytes[index] = U8{code - 32}
    }
    String.from_bytes(bytes) ?? ""
}

// A name that is blank or holds a NUL byte.
jet_cli_shape_bad_name: fn(name: String) -> Bool Never! {
    if name.trim() == "" -> return true
    loop byte in name.bytes() {
        if byte == (U8{0}) -> return true
    }
    false
}

// `ShapeFieldNames.validate`: the first invalid slot, in order.
jet_cli_shape_bad_slot: fn(names: TShapeFieldNames) -> String? Never! {
    slots := [String?]{Val(names.text)}
    labels := [String]{"text"}
    loop entry in names.formats {
        slots.push(Val(entry.name))
        labels.push(entry.format)
    }
    named: [String?]{Val(names.args), Val(names.env), names.db, names.layout}
    loop slot in named -> slots.push(slot)
    loop label in jet_cli_shape_named_projections() -> labels.push(label)
    loop index in 0..<slots.len() {
        if slots[index] == .Val(name) {
            if jet_cli_shape_bad_name(name) -> return Val(labels[index])
        }
    }
    None
}

// `shape_fact_from_struct`, with the checks of `ShapeFact.new` and
// `with_layout` a declared record can fail.
jet_cli_shape_fact: fn(tables: ASTTables, source: String, structure: StructDef) -> JetCLIShapeBuild Never! {
    fields := [JetCLIShapeField]{}
    loop (order, field) in structure.fields {
        ty: jet_cli_shape_type(source, field.ty)
        default: if field.default_ct == .Val(value) -> jet_cli_shape_default(value) else -> None
        short: sema_registration_cli_arg_text(field.serde_markers, "short")
        skip: field.computed != None || sema_serde_items_skips(field)
        fields.push(JetCLIShapeField{name: field.name, ty: ty.copy(), order: order, names: jet_cli_shape_field_names(tables, structure, field), encoding: jet_cli_shape_encoding(ty), default: default, skip: skip, short: short})
    }
    seen := [String]{}
    loop field in fields {
        if jet_cli_shape_bad_name(field.name) {
            return JetCLIShapeBuild.Invalid{error: "invalid shape field name {field.name}"}
        }
        if field.ty == .Unknown(name) {
            if jet_cli_shape_bad_name(name) {
                return JetCLIShapeBuild.Invalid{error: "unknown shape type {name}"}
            }
        }
        if jet_cli_shape_bad_slot(field.names) == .Val(slot) {
            return JetCLIShapeBuild.Invalid{error: "invalid {slot} name for field {field.name}"}
        }
        if field.short == .Val(short) {
            if jet_cli_shape_bad_name(short) {
                return JetCLIShapeBuild.Invalid{error: "invalid metadata for field {field.name}"}
            }
        }
        if seen.contains(field.name) {
            return JetCLIShapeBuild.Invalid{error: "duplicate shape field {field.name}"}
        }
        seen.push(field.name)
    }
    loop projection in jet_cli_shape_projections() {
        names := [String]{}
        loop field in fields {
            if field.skip -> next
            name: jet_cli_shape_name_for(field.names, projection)
            if names.contains(name) {
                return JetCLIShapeBuild.Invalid{error: "duplicate {projection} projection name {name}"}
            }
            names.push(name)
        }
    }
    layout := "default"
    alignment := Int?{None}
    if structure.layout == .Val(declared) {
        if declared == {
            .C -> { layout = "c" }
            .CAligned(value, _) -> {
                if value <= 0 || value & (value - 1) != 0 {
                    return JetCLIShapeBuild.Invalid{error: "invalid shape layout alignment {value}"}
                }
                layout = "c"
                alignment = Val(value)
            }
            .Columnar -> layout = "columnar"
        }
    }
    JetCLIShapeBuild.Fact{fact: JetCLIShapeFact{source: source, type_name: structure.name, fields: fields, layout: layout, alignment: alignment}}
}

// The codec formats a field's names report: Core's, in order, then each other
// format its `#Rename` labels.
jet_cli_shape_format_labels: fn(names: TShapeFieldNames) -> [String] Never! {
    labels := [String]{}
    loop format in CORE_FORMAT_NAMES -> labels.push(format)
    loop entry in names.formats {
        if !labels.contains(entry.format) -> labels.push(entry.format)
    }
    labels
}

jet_cli_shape_names_value: fn(names: TShapeFieldNames) -> JetCLIStatusValue Never! {
    ignored := [String]{}
    rows := [JetCLIStatusField]{jet_cli_status_field("text", jet_cli_status_text(names.text))}
    loop format in jet_cli_shape_format_labels(names) {
        key: names.format_key(format)
        absent: key == None
        rows.push(jet_cli_status_field("{format}", jet_cli_status_optional_text(key)))
        if absent -> ignored.push(format)
    }
    if names.db == None -> ignored.push("db")
    if names.layout == None -> ignored.push("layout")
    rows.push(jet_cli_status_field("args", jet_cli_status_text(names.args)))
    rows.push(jet_cli_status_field("env", jet_cli_status_text(names.env)))
    rows.push(jet_cli_status_field("db", jet_cli_status_optional_text(names.db)))
    rows.push(jet_cli_status_field("layout", jet_cli_status_optional_text(names.layout)))
    rows.push(jet_cli_status_field("ignored", jet_cli_status_texts(ignored)))
    jet_cli_status_object(rows)
}

// The projected fields: unskipped, in order; only `args` carries `short`.
jet_cli_shape_projection_value: fn(fact: JetCLIShapeFact, projection: String) -> JetCLIStatusValue Never! {
    rows := [JetCLIStatusValue]{}
    loop field in fact.fields {
        if field.skip -> next
        short: if projection == "args" -> field.short else -> String?{None}
        rows.push(
            jet_cli_status_object(
                [JetCLIStatusField]{
                    jet_cli_status_field("source_name", jet_cli_status_text(field.name)),
                    jet_cli_status_field("name", jet_cli_status_text(jet_cli_shape_name_for(field.names, projection))),
                    jet_cli_status_field("decode_name", jet_cli_status_text(jet_cli_shape_name_for(field.names, "json"))),
                    jet_cli_status_field("type", jet_cli_status_text(jet_cli_shape_type_label(field.ty))),
                    jet_cli_status_field("order", jet_cli_status_int(field.order)),
                    jet_cli_status_field("encoding", jet_cli_status_text(field.encoding)),
                    jet_cli_status_field("default", field.default ?? JetCLIStatusValue.Null),
                    jet_cli_status_field("short", jet_cli_status_optional_text(short)),
                    jet_cli_status_field("doc", JetCLIStatusValue.Null),
                },
            ),
        )
    }
    jet_cli_status_object(
        [JetCLIStatusField]{
            jet_cli_status_field("kind", jet_cli_status_text(projection)),
            jet_cli_status_field("status", jet_cli_status_text("supported")),
            jet_cli_status_field("fields", jet_cli_status_array(rows)),
        },
    )
}

jet_cli_shape_fact_value: fn(fact: JetCLIShapeFact) -> JetCLIStatusValue Never! {
    fields: loop field in fact.fields -> jet_cli_status_object(
        [JetCLIStatusField]{
            jet_cli_status_field("source_name", jet_cli_status_text(field.name)),
            jet_cli_status_field("type", jet_cli_status_text(jet_cli_shape_type_label(field.ty))),
            jet_cli_status_field("order", jet_cli_status_int(field.order)),
            jet_cli_status_field("encoding", jet_cli_status_text(field.encoding)),
            jet_cli_status_field("skipped", jet_cli_status_bool(field.skip)),
            jet_cli_status_field("default", field.default ?? JetCLIStatusValue.Null),
            jet_cli_status_field("names", jet_cli_shape_names_value(field.names)),
            jet_cli_status_field("short", jet_cli_status_optional_text(field.short)),
            jet_cli_status_field("doc", JetCLIStatusValue.Null),
        },
    )
    projections: loop projection in jet_cli_shape_projections() -> jet_cli_shape_projection_value(fact, projection)
    alignment: if fact.alignment == .Val(value) -> jet_cli_status_int(value) else -> JetCLIStatusValue.Null
    jet_cli_status_object(
        [JetCLIStatusField]{
            jet_cli_status_field(
                "identity",
                jet_cli_status_object(
                    [JetCLIStatusField]{
                        jet_cli_status_field("source", jet_cli_status_text(fact.source)),
                        jet_cli_status_field("type", jet_cli_status_text(fact.type_name)),
                        jet_cli_status_field("key", jet_cli_status_text("{fact.source}.{fact.type_name}")),
                    },
                ),
            ),
            jet_cli_status_field(
                "dimensions",
                jet_cli_status_object(
                    [JetCLIStatusField]{
                        jet_cli_status_field("status", jet_cli_status_text("known")),
                        jet_cli_status_field("rank", jet_cli_status_int(1)),
                        jet_cli_status_field("width", jet_cli_status_int(fact.fields.len())),
                    },
                ),
            ),
            jet_cli_status_field("encoding", jet_cli_status_text("Object")),
            jet_cli_status_field(
                "layout",
                jet_cli_status_object(
                    [JetCLIStatusField]{
                        jet_cli_status_field("kind", jet_cli_status_text(fact.layout)),
                        jet_cli_status_field("alignment", alignment),
                    },
                ),
            ),
            jet_cli_status_field(
                "provenance",
                jet_cli_status_object(
                    [JetCLIStatusField]{
                        jet_cli_status_field("origin", jet_cli_status_text("declared")),
                        jet_cli_status_field("span", JetCLIStatusValue.Null),
                        jet_cli_status_field("declaration", jet_cli_status_text(fact.type_name)),
                    },
                ),
            ),
            jet_cli_status_field("fields", jet_cli_status_array(fields)),
            jet_cli_status_field("projections", jet_cli_status_array(projections)),
        },
    )
}

jet_cli_shape_name_text: fn(value: String?) -> String Never! { value ?? "ignored" }

jet_cli_shape_fact_text: fn(fact: JetCLIShapeFact) -> String Never! {
    out := "Shape {fact.source}.{fact.type_name} (encoding=Object, layout={fact.layout})\n  Dimensions: Known {{ rank: 1, width: {fact.fields.len()} }}\n"
    projected := 0
    loop field in fact.fields {
        if !field.skip -> projected += 1
        out = "{out}  Field {field.name}: {jet_cli_shape_type_label(field.ty)} (order={field.order}, encoding={field.encoding}, skipped={field.skip})\n"
        names: field.names
        formats := ""
        loop format in jet_cli_shape_format_labels(names) {
            formats = "{formats} {format}={jet_cli_shape_name_text(names.format_key(format))}"
        }
        out = "{out}    Names: text={names.text}{formats} args={names.args} env={names.env} db={jet_cli_shape_name_text(names.db)} layout={jet_cli_shape_name_text(names.layout)}\n"
    }
    loop projection in jet_cli_shape_projections() {
        out = "{out}  Projection {projection}: supported ({projected} fields)\n"
    }
    out
}

// One declared type's layout row: its record's target and kind, and its byte
// facts when every one is known.
JetCLIShapeLayout: struct {
    source: String,
    type_name: String,
    target: String,
    kind: String,
    summary: JetDriverLayoutSummary?,
}

// The layout rows of the checked modules, by source, then type name.
jet_cli_shape_layouts: fn(modules: [JetDriverDocModule]) -> [JetCLIShapeLayout] Never! {
    rows := [JetCLIShapeLayout]{}
    loop checked in modules {
        loop row in checked.layout_facts {
            target: jet_driver_layout_record_text(row.value, "target") ?? "unknown"
            kind: jet_driver_layout_record_text(row.value, "kind") ?? "unknown"
            rows.push(JetCLIShapeLayout{source: checked.path, type_name: row.name, target: target, kind: kind, summary: jet_driver_layout_summary(row.value)})
        }
    }
    rows.sort_by(fn(left: JetCLIShapeLayout, right: JetCLIShapeLayout) { (left.source <=> right.source).then(left.type_name <=> right.type_name) })
    rows
}

// A layout row as JSON. A layout is a fact of this target and this compiler,
// never a promise: `promised` is always false.
jet_cli_shape_layout_value: fn(layout: JetCLIShapeLayout, compiler: String) -> JetCLIStatusValue Never! {
    fields := [JetCLIStatusField]{
        jet_cli_status_field("source", jet_cli_status_text(layout.source)),
        jet_cli_status_field("type", jet_cli_status_text(layout.type_name)),
        jet_cli_status_field("target", jet_cli_status_text(layout.target)),
        jet_cli_status_field("compiler", jet_cli_status_text(compiler)),
        jet_cli_status_field("promised", jet_cli_status_bool(false)),
        jet_cli_status_field("kind", jet_cli_status_text(layout.kind)),
    }
    summary: layout.summary ?? {
        loop name in ([String]{"size", "alignment", "stride", "boxed", "summary", "dominant"}) {
            fields.push(jet_cli_status_field(name, JetCLIStatusValue.Null))
        }
        fields.push(jet_cli_status_field("members", jet_cli_status_array([JetCLIStatusValue]{})))
        return jet_cli_status_object(fields)
    }
    members: loop member in summary.members -> jet_cli_status_object(
        [JetCLIStatusField]{
            jet_cli_status_field("name", jet_cli_status_text(member.name)),
            jet_cli_status_field("offset", jet_cli_status_int(member.offset)),
            jet_cli_status_field("size", jet_cli_status_int(member.size)),
        },
    )
    dominant := JetCLIStatusValue.Null
    if jet_driver_layout_dominant(summary) == .Val(found) {
        dominant = jet_cli_status_object(
            [JetCLIStatusField]{
                jet_cli_status_field("case", jet_cli_status_text(found.case_name)),
                jet_cli_status_field("size", jet_cli_status_int(found.size)),
                jet_cli_status_field("next_case", jet_cli_status_text(found.next_name)),
                jet_cli_status_field("next_size", jet_cli_status_int(found.next_size)),
                jet_cli_status_field("ratio", jet_cli_status_text(jet_driver_layout_ratio(found.tenths))),
            },
        )
    }
    fields.push(jet_cli_status_field("size", jet_cli_status_int(summary.size)))
    fields.push(jet_cli_status_field("alignment", jet_cli_status_int(summary.alignment)))
    fields.push(jet_cli_status_field("stride", jet_cli_status_int(summary.stride)))
    fields.push(jet_cli_status_field("boxed", jet_cli_status_bool(summary.boxed)))
    fields.push(jet_cli_status_field("summary", jet_cli_status_text(jet_driver_layout_line(summary))))
    fields.push(jet_cli_status_field("dominant", dominant))
    fields.push(jet_cli_status_field("members", jet_cli_status_array(members)))
    jet_cli_status_object(fields)
}

// A layout row as one human line, naming the target and the compiler whose
// fact it is and that it is not promised.
jet_cli_shape_layout_text: fn(layout: JetCLIShapeLayout, compiler: String) -> String Never! {
    facts := "byte facts unknown"
    if layout.summary == .Val(summary) {
        facts = jet_driver_layout_line(summary)
        if jet_driver_layout_dominant(summary) == .Val(found) {
            facts = "{facts}; note: {jet_driver_layout_dominant_note(found)}"
        }
    }
    "Layout {layout.source}.{layout.type_name}: {facts} [target {layout.target}, compiler {compiler}, not promised]\n"
}

// `run_shapes`: module display identity, then type name.
jet_cli_inspect_shapes: fn(modules: [JetDriverDocModule], json: Bool, color: Bool) -> JetDriverVerbOutput Never! {
    facts := [JetCLIShapeFact]{}
    loop checked in modules {
        source: checked.path
        loop item in checked.items {
            if item == .Struct(structure) {
                if jet_cli_shape_fact(checked.tables, source, structure) == {
                    .Fact(fact) -> { facts.push(fact) }
                    .Invalid(error) -> {
                        what: "could not project shape `{structure.name}` from `{source}`: {error}"
                        why: "the checked declaration could not form one canonical shape fact"
                        fix: "fix the declaration's field names, types, or format markers"
                        if json {
                            report: jet_cli_report_json(diagnostic_from_registry("E2105", None, what, why, fix), None, "", "", 0)
                            return JetDriverVerbOutput{stdout: "{jet_cli_status_render_with_reports("inspect.shapes", false, [String]{report}, [JetCLIStatusField]{})}\n", stderr: "", exit_code: JET_DRIVER_EXIT_USER_ERROR}
                        }
                        return jet_cli_report_output("", "E2105", what, why, fix, color, JET_DRIVER_EXIT_USER_ERROR)
                    }
                }
            }
        }
    }
    facts.sort_by(fn(left: JetCLIShapeFact, right: JetCLIShapeFact) { (left.source <=> right.source).then(left.type_name <=> right.type_name) })
    layouts: jet_cli_shape_layouts(modules)
    compiler: jet_cli_compiler_identity() ?? "unversioned"
    if json {
        values: loop fact in facts -> jet_cli_shape_fact_value(fact)
        layout_values: loop layout in layouts -> jet_cli_shape_layout_value(layout, compiler)
        return JetDriverVerbOutput{stdout: "{jet_cli_status_render("inspect.shapes", true, [JetCLIStatusField]{jet_cli_status_field("shapes", jet_cli_status_array(values)), jet_cli_status_field("layouts", jet_cli_status_array(layout_values))})}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
    out := if facts.len() == 0 -> "No shape facts declared.\n" else -> ""
    loop fact in facts -> out = "{out}{jet_cli_shape_fact_text(fact)}"
    loop layout in layouts -> out = "{out}{jet_cli_shape_layout_text(layout, compiler)}"
    JetDriverVerbOutput{stdout: out, stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}
