// `jet self lsp`: the language server (Compiler/JetLSP) over standard input
// and output, checking through the CLI's compile path. Each check is the Doc
// compile of the document as the entry with every open document's unsaved
// text in place of its file, kept going past errors so the semantic index
// still covers a document that does not check (as `jet fix` and codemods
// read it). An unsaved loose buffer is checked by itself. A document that is
// a module its package's last `jet build` generated carries what made it.
// The check carries the automatic choices its modules record, which hovers
// show on their lines. A call through a `use core.…` alias shows the Core
// module's own declaration, read from the Core source.
use {
    cli_files: core.files
    jet_driver.[JetDriverCompileMode, JetDriverDocModule, JetDriverKeepGoing, JetDriverSourceDocument, JetDriverToolStageItem, JetDriverVerbOutput, JET_DRIVER_EXIT_USAGE, jet_driver_compile_keep_going, jet_driver_present_diagnostics]
    jet_foundation.[Diagnostic, Span, diagnostic_headline]
    jet_lsp.[LSPChecked, LSPChecker, LSPChoice, LSPDeclaredFile, LSPProducer, LSPServeHook, lsp_serve, lsp_serve_with_hook, lsp_write_log]
    jet_semindex.[SemDeclared, SemSymbol, semindex_build_symbols, semindex_declared, semindex_imports]
}

JetCLILSPChecker: struct {
    impl LSPChecker {
        check: fn(self, entry: String, overlays: [JetDriverSourceDocument]) -[FS, Env, Exec, IO, Time, Net, FFI.Asm]> LSPChecked Never! {
            producer: jet_cli_lsp_producer(entry)
            alone: jet_cli_lsp_unsaved_loose(entry)
            entry_path: jet_cli_overlay_path(entry)
            ^given: [JetDriverSourceDocument]{}
            // The entry's slot in `given`: its open text is what a report with
            // no origin of its own names.
            ^entry_slot: -1
            loop overlay in overlays {
                same: jet_cli_overlay_path(overlay.path) == entry_path
                if !alone || same {
                    if same -> entry_slot = given.len()
                    given.push(JetDriverSourceDocument{path: overlay.path.copy(), source: overlay.source.copy()})
                }
            }
            if jet_cli_prepare_overlays(entry, entry, given, false, None, JetDriverCompileMode.Doc, alone, ignore_outside_overlays: true) == {
                // A refusal (no toolchain, an unreadable manifest) has no span in
                // the document; the client's log shows it.
                .Refused(output) -> {
                    lsp_write_log(output.stderr).drop("standard error is the log; a failed log write has nowhere to go")
                    return LSPChecked{diagnostics: [Diagnostic]{}, modules: [JetDriverDocModule]{}, index: None, symbols: [SemSymbol]{}, producer: producer}
                }
                .Prepared(request, snapshot) -> {
                    ^demanded: request.move()
                    demanded.doc_core_on_demand = true
                    demanded.doc_generated_modules = true
                    // The modules the package's `build: fn` generates load
                    // beside its sources, as under `jet check`, and what the
                    // build reported follows the compile's reports. A compile
                    // that fails outright publishes nothing, as a refusal
                    // does; the client's log shows why.
                    generated: jet_cli_generated_request(demanded) ?? {
                        lsp_write_log("internal compiler error checking `{entry}`: {err.message}").drop("standard error is the log; a failed log write has nowhere to go")
                        return LSPChecked{diagnostics: [Diagnostic]{}, modules: [JetDriverDocModule]{}, index: None, symbols: [SemSymbol]{}, producer: producer}
                    }
                    ^result: jet_driver_compile_keep_going(generated.request.move(), JetDriverKeepGoing{skip: [String]{}}) ?? {
                        lsp_write_log("internal compiler error checking `{entry}`: {err}").drop("standard error is the log; a failed log write has nowhere to go")
                        return LSPChecked{diagnostics: [Diagnostic]{}, modules: [JetDriverDocModule]{}, index: None, symbols: [SemSymbol]{}, producer: producer}
                    }
                    if result.internal_problem == .Val(problem) {
                        lsp_write_log("internal compiler error checking `{entry}`: {problem}").drop("standard error is the log; a failed log write has nowhere to go")
                    }
                    loop report in generated.reports.move() -> result.diagnostics.push(report)
                    diagnostics: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
                    reports: jet_cli_lsp_reports(entry, given, entry_slot, diagnostics)
                    if result.doc_modules.len() == 0 {
                        return LSPChecked{diagnostics: diagnostics, modules: [JetDriverDocModule]{}, index: None, symbols: [SemSymbol]{}, producer: producer, reports: reports}
                    }
                    index: jet_cli_checked_semindex(result)
                    symbols: semindex_build_symbols(index, result.doc_modules)
                    ^declared: [SemDeclared]{}
                    ^declared_files: [LSPDeclaredFile]{}
                    jet_cli_lsp_declared(entry, result.doc_modules, declared, declared_files)
                    return LSPChecked{diagnostics: diagnostics, modules: result.doc_modules.copy(), index: Val(index), symbols: symbols, producer: producer, choices: jet_cli_lsp_choices(result.doc_modules), reports: reports, declared: declared, declared_files: declared_files}
                }
            }
        }

        // A stage whose program does not check answers nothing; the client's
        // log shows why.
        stage: fn(self, entry: String, overlays: ^^[JetDriverSourceDocument], stage: String, bodies: [Span], program: ^^String) -[FS, Env, Exec, IO, Time, Net, FFI.Asm]> [[JetDriverToolStageItem]] Never! {
            run: jet_cli_tool_stage_run(entry, overlays.move(), stage, bodies, program)
            if run.stop == .Val(stop) {
                lsp_write_log("the `{stage}` hooks of `{entry}` did not run: {diagnostic_headline(stop.code, stop.what)}").drop("standard error is the log; a failed log write has nowhere to go")
            }
            run.answers
        }

        // The `.git`, `.jet`, `node_modules`, and `target` trees hold no
        // workspace source; an unreadable file is left out.
        sources: fn(self, root: String) -[FS]> [JetDriverSourceDocument] Never! {
            ^saved: [JetDriverSourceDocument]{}
            loop item in cli_files.walk_files(root, skip: [String]{".git", ".jet", "node_modules", "target"}) {
                entry: item ?? return saved
                if !entry.path.ends_with(".jet") -> next
                source: cli_files.read(entry.path) ?? next
                saved.push(JetDriverSourceDocument{path: entry.path, source: source})
            }
            saved
        }
    }
}

// Each diagnostic's `jet check --json` report, its paths absolute as the
// editor's URIs are. A report with no origin of its own names the entry's
// open text, at `slot` in `given`.
jet_cli_lsp_reports: fn(entry: String, given: [JetDriverSourceDocument], slot: Int, diagnostics: [Diagnostic]) -> [String] Never! {
    if slot < 0 -> return jet_cli_reports_json(None, entry, "", diagnostics)
    jet_cli_reports_json(None, entry, given[slot].source, diagnostics)
}

// The functions of the Core modules the checked modules import by name, from
// the Core sources a compile of `entry` reads: the module's own source,
// without its private parts. Core read from a toolchain tree also gives each
// such source's file, where a definition of one of its functions goes.
jet_cli_lsp_declared: fn(entry: String, modules: [JetDriverDocModule], declared: ^[SemDeclared], files: ^[LSPDeclaredFile]) {
    if !semindex_imports(modules, "core.") {
        return
    }
    toolchain: jet_cli_named_toolchain(entry)
    if jet_cli_core_sources(entry) == .Loaded(rows) {
        loop row in rows {
            if row.owner != "" || row.runtime || !semindex_imports(modules, row.module_name) -> next
            source: row.source()
            declared.extend(semindex_declared(row.module_name, source))
            if toolchain == .Val(root) {
                files.push(LSPDeclaredFile{module_name: row.module_name, path: jet_cli_authority_path(root, row.path), source: source})
            }
        }
    }
}

// The automatic choices the checked modules record, by module and line, as
// `jet inspect choices` finds them. Inlining is the optimizer's choice, which
// a check does not make, and live reads name their filter by the run's
// declaration table, which a checked module does not carry.
jet_cli_lsp_choices: fn(modules: [JetDriverDocModule]) -> [LSPChoice] Never! {
    ^out: [LSPChoice]{}
    loop module_ref in modules {
        ^rows: jet_cli_storage_choices(module_ref.functions)
        jet_cli_collection_choices(module_ref.functions, rows)
        jet_cli_copy_choices(module_ref.functions, rows)
        jet_cli_placement_choices(module_ref.functions, rows)
        jet_cli_exposure_choices(module_ref.functions, rows)
        jet_cli_rights_choices(module_ref.functions, rows)
        jet_cli_context_choices(module_ref.functions, rows)
        loop row in rows {
            out.push(LSPChoice{module_path: module_ref.path.copy(), line: row.line, kind: row.kind.copy(), choice: row.choice.copy()})
        }
    }
    out
}

// What made `entry` when it is a module under its package's `.jet/generated/`
// that the package's last `jet build` recorded: the receipt's `generated` row
// of that path (jet_driver_build_graph_json), whose fields are the plan's
// (jet_driver_build_generated_json). None for any other file, and before a
// build has recorded one.
jet_cli_lsp_producer: fn(entry: String) -[FS]> LSPProducer? Never! {
    place: entry.partition("/.jet/generated/")
    if place.sep == "" -> return None
    relative: ".jet/generated/{place.tail}"
    text: cli_files.read(jet_cli_entry_join(place.head, ".jet/build/receipt.json")) ?? return None
    receipt: jet_cli_status_value_parse(text) ?? return None
    rows: jet_cli_status_list(jet_cli_status_get(receipt, "generated")) ?? return None
    loop row in rows {
        if jet_cli_status_string(jet_cli_status_get(row, "path")) != .Val(relative) -> next
        ^handoffs: [String]{}
        steps: jet_cli_status_list(jet_cli_status_get(row, "handoffs")) ?? [JetCLIStatusValue]{}
        loop step in steps {
            if jet_cli_status_string(Val(step)) == .Val(said) -> handoffs.push(said.copy())
        }
        return Val(LSPProducer{
            name: jet_cli_status_string(jet_cli_status_get(row, "name")) ?? "",
            identity: jet_cli_status_string(jet_cli_status_get(row, "id")) ?? "",
            made_by: jet_cli_status_string(jet_cli_status_get(row, "made_by")) ?? "",
            handoffs: handoffs.move(),
            authority: jet_cli_status_string(jet_cli_status_get(row, "authority")),
            consent: jet_cli_status_string(jet_cli_status_get(row, "consent")),
        })
    }
    None
}

// An unsaved buffer (no file holds it yet) outside every package is checked
// by itself: its folder, which may be any host directory such as /tmp, is not
// yet its program.
jet_cli_lsp_unsaved_loose: fn(entry: String) -[FS]> Bool Never! {
    if cli_files.exists(entry) -> return false
    !cli_files.is_file(jet_cli_authority_path(jet_cli_source_root(entry), "package.jet"))
}

JetCLILSPSessionHook: struct {
    owner: JetSessionOwner,

    impl LSPServeHook {
        wait_for_input: fn(^self) -[FS, Env, Exec, IO, Time, Net, Rand, FFI.C, FFI.Asm]> Bool Never! {
            jet_cli_session_owner_wait_with_fd(self.owner, 0)
        }

        poll_once: fn(^self) -[FS, Env, Exec, IO, Time, Net, Rand, FFI.C, FFI.Asm]> Never! {
            jet_cli_session_owner_drain(self.owner)
        }

        close_owner: fn(^self) -[FS, Env, Exec, IO, Time, Net, Rand, FFI.C, FFI.Asm]> Never! {
            jet_cli_session_owner_close(self.owner)
        }
    }
}

// Serves until the client's `exit` or the end of input; the exit status is the
// server's (0 after a `shutdown` request, else 1). The server writes stdout.
// With `--serve`, acquires the workspace session lock and serves build/check/test
// clients over the workspace Unix socket until shutdown, cleaning up the endpoint
// on exit; if another owner already holds the lock, attaches as a client instead.
jet_cli_lsp: fn(serve: Bool{false}) -> JetDriverVerbOutput {
    if !serve {
        return JetDriverVerbOutput{stdout: "", stderr: "", exit_code: lsp_serve(JetCLILSPChecker{})}
    }
    workspace: jet_cli_session_workspace_root(cli_files.cwd() ?? ".")
    if jet_cli_session_owner_acquire(workspace, "lsp") == {
        .Owned(owner) -> {
            session_id: "{owner.session_id}"
            lsp_write_log("serving workspace session {session_id} for {workspace}").drop("standard error is the log; a failed log write has nowhere to go")
            code: lsp_serve_with_hook(JetCLILSPChecker{}, JetCLILSPSessionHook{owner: owner})
            JetDriverVerbOutput{stdout: "", stderr: "", exit_code: code}
        }
        .AlreadyOwned(desc) -> {
            lsp_write_log("workspace session {desc.session_id} is already owned by {desc.owner} (pid {desc.pid}); attached as a client").drop("standard error is the log; a failed log write has nowhere to go")
            JetDriverVerbOutput{stdout: "", stderr: "", exit_code: lsp_serve(JetCLILSPChecker{})}
        }
        .Failed(reason) -> {
            jet_cli_report_output("", "E2104", "could not start workspace session for `jet self lsp --serve`: {reason}", jet_cli_why("E2104"), "ensure `{workspace}/.jet` and your runtime directory are private and contain no symlinks", false, JET_DRIVER_EXIT_USAGE)
        }
    }
}
