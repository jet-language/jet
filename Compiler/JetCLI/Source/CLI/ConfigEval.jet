// Config-surface values through the one comptime path. A config value (a field
// of an `env.jet`/`config.jet` module) is turned into typed Jet code by the
// requester (JetParser `jet_config_program`, the program both sides of the
// compiler service build): every global it reads becomes an ALL_CAPS module
// constant holding that value's literal, the source's own top-level functions
// are carried by their exact text, and the value itself becomes
// `JET_CONFIG_VALUE: #run { <expression> }`. Here the driver checks that
// program in `JetDriverCompileMode.Comptime`, whose comptime stage lowers the
// `#run` value to IR and runs it natively in the sealed comptime child (JetEval
// IR/Native.jet); the checked value is read back as a `CtValue`. The
// environment model reaches this evaluator through
// `jet __jetpack comptime-evaluate` (JetpackService.jet), in `jet` and in
// `jetpack` alike. Its module values arrive whole, through
// `jet __jetpack module-values`: the source's own declarations checked as one
// program (JetParser `jet_config_module_values_program`), every immutable value
// read back by name.
use {
    config_files: core.files
    jet_driver.[
        JetDriverAuthorizedSourceFile,
        JetDriverAuthorizedSourceRoot,
        JetDriverAuthorizedSourceSnapshot,
        JetDriverCompileMode,
        JetDriverCompileResult,
        JetDriverCoreSource,
        jet_driver_compile,
    ]
    jet_foundation.[
        ComptimeEvalError,
        DIAGNOSTIC_ERROR,
        JET_CONFIG_VALUE_FILE,
        JET_CONFIG_VALUE_NAME,
        JetConfigOutcome,
        JetModuleValuesOutcome,
        NamedCtValue,
        diagnostic_from_registry,
        jet_config_data_value,
        jet_config_eval_diagnostic,
        jet_module_values_refused,
        symbol_key_names,
    ]
    jet_sema.[
        SemaComptimeItemKind,
        sema_user_template_ct_value,
    ]
}

jet_config_evaluate_program: fn(program: String, base_dir: String) -> JetConfigOutcome {
    result: jet_config_checked(program, base_dir, false) ?? return JetConfigOutcome.Refused{diagnostic: err.diagnostic}
    loop value in result.comptime_values {
        if value.kind != SemaComptimeItemKind.Constant || !symbol_key_names(value.key, JET_CONFIG_VALUE_NAME) {
            next
        }
        converted: sema_user_template_ct_value(value.value) ?? return JetConfigOutcome.Refused{diagnostic: jet_config_eval_diagnostic(None, "this config value's result has a shape a config value can't hold")}
        return JetConfigOutcome.Value{value: converted}
    }
    JetConfigOutcome.Refused{diagnostic: jet_config_eval_diagnostic(None, "this config value produced no build-time value")}
}

// Every immutable value of a module-values program's own module, by name; the
// program's `JET_CONFIG_VALUE` names that module. Each value is config data
// (`jet_config_data_value`: an optional field holding no value is left out of
// its record). A value no config value can hold (a function, say) is named
// unreadable. The first error of the check keeps its span, a span of the
// requester's source.
jet_config_module_values: fn(program: String, base_dir: String) -> JetModuleValuesOutcome {
    result: jet_config_checked(program, base_dir, true) ?? return jet_module_values_refused(err.diagnostic)
    owner := ""
    loop value in result.comptime_values {
        if value.kind == SemaComptimeItemKind.Constant && symbol_key_names(value.key, JET_CONFIG_VALUE_NAME) {
            owner = value.key.slice(0..<(value.key.len() - JET_CONFIG_VALUE_NAME.len()))
        }
    }
    if owner == "" {
        return jet_module_values_refused(jet_config_eval_diagnostic(None, "the module values produced no build-time values"))
    }
    values := [NamedCtValue]{}
    unreadable := [String]{}
    loop value in result.comptime_values {
        if value.kind != SemaComptimeItemKind.Constant || !value.key.starts_with(owner) -> next
        name: value.key.slice(owner.len()..<value.key.len())
        if name == JET_CONFIG_VALUE_NAME || name.contains(".") -> next
        if sema_user_template_ct_value(value.value) == {
            .Val(converted) -> {
                values.push(NamedCtValue{name: name, value: jet_config_data_value(converted)})
            }
            .None -> unreadable.push(name)
        }
    }
    JetModuleValuesOutcome{values: values, unreadable: unreadable, refused: None}
}

// The checked `program`, or the refusal of its first error. With `spans` the
// refusal keeps its span when the error lies in the program itself.
jet_config_checked: fn(program: String, base_dir: String, spans: Bool) -> JetDriverCompileResult ComptimeEvalError! {
    core_sources: if jet_cli_core_sources(base_dir) == {
        .Loaded(sources) -> sources
        .Missing(what, fix) -> {
            return Err(ComptimeEvalError{diagnostic: diagnostic_from_registry("E2105", None, what, jet_cli_why("E2105"), fix)})
        }
    }
    result: jet_config_compile(program, core_sources, base_dir) ?? return Err(ComptimeEvalError{diagnostic: jet_config_eval_diagnostic(None, "this config value could not be evaluated: {err}")})
    loop diagnostic in result.diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR {
            in_program: (diagnostic.source_path ?? JET_CONFIG_VALUE_FILE).ends_with(JET_CONFIG_VALUE_FILE)
            span: if spans && in_program -> diagnostic.span else -> None
            return Err(ComptimeEvalError{diagnostic: diagnostic_from_registry(diagnostic.code, span, diagnostic.what, diagnostic.why, diagnostic.fix)})
        }
    }
    if result.internal_problem == .Val(problem) {
        return Err(ComptimeEvalError{diagnostic: jet_config_eval_diagnostic(None, "this config value could not be evaluated: {problem}")})
    }
    Ok(result)
}

// Check `program` as the one file of a source root at the config's own
// directory (relative `embed_file` paths resolve there) and run its comptime
// stage. The driver makes dynamic host calls with no effect bound, so this
// stays unannotated like `jet_cli_compile_file`.
jet_config_compile: fn(program: String, core_sources: [JetDriverCoreSource], base_dir: String) -> JetDriverCompileResult {
    root: config_files.realpath(base_dir) ?? base_dir
    path: if root == "/" -> "/{JET_CONFIG_VALUE_FILE}" else -> "{root}/{JET_CONFIG_VALUE_FILE}"
    identity: "config-value-root:{root}"
    snapshot: JetDriverAuthorizedSourceSnapshot{
        roots: [JetDriverAuthorizedSourceRoot]{
            JetDriverAuthorizedSourceRoot{
                canonical_path: root,
                identity: identity,
                allow_hardlinks: false,
                files: [JetDriverAuthorizedSourceFile]{JetDriverAuthorizedSourceFile{path: path, relative_path: JET_CONFIG_VALUE_FILE, identity: "config-value-file:{path}", source: program}},
                foreign_cache_files: [JetDriverAuthorizedSourceFile]{},
            },
        },
        entry_root_identity: identity,
        entry_path: path,
    }
    request: jet_cli_driver_request(snapshot, core_sources, None, JetDriverCompileMode.Comptime)
    jet_driver_compile(request)
}
