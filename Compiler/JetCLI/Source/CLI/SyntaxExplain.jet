// Offline syntax and policy branches of crates/jet-cli. The dictionary is Jet-owned data;
// source-site policy/fact queries belong to the loader.
use {
    jet_foundation.[
        CORE_MODULE_EXPORTS,
        DiagnosticExplanation,
        TAppliedRule,
        TAppliedRuleSignature,
        applied_rule_signature_render,
        diagnostic_explanation_render,
        diagnostic_registry_row,
        policy_key_parse,
        policy_key_name,
    ]
    jet_driver.[JET_DRIVER_EXIT_USER_ERROR]
    jet_pkg_model.[pkg_strictness_table]
}

// Source queries must be selected before syntax typo classification. build_fact_name:
// these names resolve against a loader-owned writer chain.
jet_cli_explain_build_fact_name: fn(query: String) -> String? Never! {
    name: jet_cli_ascii_lower(query.trim())
    fixed: if name == {
        "#package.name" | "build.package.name" -> Val("Build.Package.Name")
        "#package.version" | "build.package.version" -> Val("Build.Package.Version")
        "#build.target.os" -> Val("Build.OS")
        "#build.profile" -> Val("Build.Profile")
        "#build.stamp.git" -> Val("Build.Stamp.Git")
        "#build.stamp.dirty" -> Val("Build.Stamp.Dirty")
        "#build.stamp.toolchain" -> Val("Build.Stamp.Toolchain")
        "#build.stamp.at" -> Val("Build.Stamp.At")
        "#build.cpu.cache_line" -> Val("Build.Cpu.CacheLine")
        else -> None
    }
    if fixed != None -> return fixed
    if !name.starts_with("#build.settings.") -> return None
    // `loud`, or a dependency's setting by its package's name, `tool.loud`.
    key: name.removeprefix("#build.settings.")
    parts: key.split(".").to_list()
    if parts.len() > 2 -> return None
    loop part in parts {
        if part == "" -> return None
    }
    Val("Build.Settings.{key}")
}

// None leaves diagnostic, build-fact, and registration-row queries to their owners.
jet_cli_explain_syntax: fn(query: String, verbose: Bool, color: Bool, json: Bool) -> JetCLIPlan? Never! {
    if jet_cli_syntax_lookup(query) == .Val(index) {
        row: JET_CLI_SYNTAX_ROWS[index]
        explanation: jet_cli_syntax_explanation(query) ?? panic("a syntax row has its explanation")
        if verbose && !json {
            text: "{diagnostic_explanation_render(explanation, color)}\nRegistry name: {row.registry_name}\n"
            return Val(jet_cli_renderable(text, false))
        }
        return Val(jet_cli_explanation_output(explanation, color, json))
    }
    if jet_cli_syntax_query(query) {
        row: diagnostic_registry_row("E2106") ?? panic("syntax query diagnostic is registered")
        closest: jet_cli_syntax_nearest(query)
        what: row.what.replace("{{token}}", query)
        fix: row.fix.replace("{{closest}}", closest)
        return Val(jet_cli_inspect_b_report("E2106", what, row.why, fix, color, json, JET_DRIVER_EXIT_USER_ERROR))
    }
    None
}

// Call only for a standalone query, after syntax lookup, lookup does.
jet_cli_explain_policy: fn(query: String, color: Bool, json: Bool) -> JetCLIPlan? Never! {
    key: policy_key_parse(query.trim()) ?? return None
    name: policy_key_name(key)
    explanation: DiagnosticExplanation{code: name, stage: "policy", meaning: "compiler-owned scoped policy `{name}`", what: Val("`{name}` participates in the package → module → function → block policy ladder."), why: Val("one registry owns applicability, inheritance, conflicts, and provenance"), fix: Val("inspect the semantic index at the target site for the effective value and full declaration chain"), example: None}
    Val(jet_cli_explanation_output(explanation, color, json))
}

// `jet explain strictness`: render the single strictness table of package.jet.
jet_cli_explain_strictness: fn(color: Bool, json: Bool) -> JetCLIPlan Never! {
    rows: pkg_strictness_table()
    if json {
        items := [JetCLIStatusValue]{}
        loop row in rows {
            items.push(
                jet_cli_status_object(
                    [JetCLIStatusField]{
                        jet_cli_status_field("level", jet_cli_status_text(row.spelling)),
                        jet_cli_status_field("keys", jet_cli_status_texts(row.keys)),
                        jet_cli_status_field("summary", jet_cli_status_text(row.summary)),
                    },
                ),
            )
        }
        return jet_cli_done("{jet_cli_status_json(jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("field", jet_cli_status_text("strictness")), jet_cli_status_field("levels", JetCLIStatusValue.Array{values: items})}))}\n", "", 0)
    }
    lines := [String]{"Package Strictness Levels (`strictness:` in `package.jet`)", ""}
    loop row in rows {
        lines.push("  {row.spelling}")
        lines.push("    Summary: {row.summary}")
        lines.push("    Keys: {row.keys.join(", ")}")
    }
    lines.push("")
    lines.push("Note: Levels only tighten. Pick a lower level and add individual keys to loosen one setting.")
    _: color
    jet_cli_done("{lines.join("\n")}\n", "", 0)
}

// `marker_argument_declarations`: the `core.compiler.lang` menus the signature
// names, sorted, once each.
jet_cli_rule_argument_declarations: fn(signature: TAppliedRuleSignature) -> String Never! {
    menus := [String]{}
    loop module_row in CORE_MODULE_EXPORTS {
        if module_row.module_name == "core.compiler.lang" -> menus = module_row.members
    }
    named := [String]{}
    loop param in signature.params -> named.push(param.source_type)
    if signature.variadic_source_type == .Val(source_type) -> named.push(source_type.copy())
    declarations := [String]{}
    loop name in named {
        if menus.contains(name) -> declarations.push("`core.compiler.lang.{name}`")
    }
    declarations.sort()
    unique := [String]{}
    loop declaration in declarations {
        if unique.len() == 0 || unique[unique.len() - 1] != declaration -> unique.push(declaration)
    }
    if unique.len() == 0 -> return ""
    " Argument declarations: {unique.join(", ")}."
}

// `rule_explanation`: one registered rule row's typed signature, sites and
// status (the signature says whether parentheses may and must appear).
jet_cli_rule_explanation: fn(rule: TAppliedRule) -> DiagnosticExplanation Never! {
    signature: rule.signature
    required := 0
    loop param in signature.params {
        if param.default_source == None -> required += 1
    }
    arguments: if {
        required > 0 || (signature.params.len() == 0 && signature.variadic != None) -> "required"
        signature.params.len() > 0 || signature.variadic != None -> "optional"
        else -> "none"
    }
    fix: "move the rule to one of its registered sites"
    what: "arguments: {arguments}; repeatable: {rule.repeatable}; attachment sites: [{rule.sites.join(", ")}].{jet_cli_rule_argument_declarations(signature)}"
    DiagnosticExplanation{code: rule.name, stage: "rule applicability", meaning: "`#{rule.name}{applied_rule_signature_render(signature)}`", what: Val(what), why: Val("resolution is {rule.resolution}; site-bound authority never becomes ambient policy"), fix: Val(fix), example: None}
}

jet_cli_rule_named: fn(rules: [TAppliedRule], name: String) -> TAppliedRule? Never! {
    loop rule in rules {
        if rule.name == name -> return Val(rule)
    }
    None
}
