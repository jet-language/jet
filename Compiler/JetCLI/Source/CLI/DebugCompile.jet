// `jet debug`'s one evaluator (JetDebug NativeEval.jet): an expression asked
// at a stop is compiled with the program, as its build compiled it (its
// optimization level, the same deep checks, debug info), as a function of
// the locals it reads, built as a root with an entry that calls it (JetEval
// jet_eval_native_wrapper); the session places that code next to the
// stopped program's and calls it in the program itself. Where every local
// the expression's names may read is a value no move empties, live at the stop
// (jet_cli_debug_eval_params), the expression's function takes them as the
// image's debug types spell them. The session's held checks, which open in
// the background from the session's start (jet_cli_debug_eval_held_start),
// check that function and their held IR programs build it alone, with no
// compile of the program. The held check of the package's cut
// (jet_cli_debug_eval_held_cut) opens with only Core and the entry's
// package carrier: it takes an expression that names nothing of the package
// but its locals and the functions of the source it is checked in, which
// the cut gains as the expression reaches them, at any session. The held
// check of the program (jet_cli_debug_eval_held) takes the rest. Their code
// calls the image's functions, which compile no copy to compare with the
// image's, so each answers only while it read the sources the image records
// it was built
// from (`.debug_jetsource`, jet_cli_debug_eval_image_same). Every other
// compile first proves that no item the expression reaches is in a source
// that reads otherwise than that record (jet_cli_debug_eval_stale): such
// an item's code in the compile is not the code the program runs. Until a
// held check is open, and where neither answers, one compile builds it and
// asks the checker its type and any effect it uses
// (jet_cli_debug_eval_direct).
// When those locals are all of the primitive types and the expression names
// nothing else, it reads nothing of the program, and that compile takes the
// package's sources without the program's code (jet_cli_debug_eval_alone).
// Built at O0, its other names may call the package's functions, and that
// compile takes the package's sources with only those, each at the lines it
// holds, built as the image's `main` runs the program (`owned`,
// NativeEvaluator.compile): their code is then the image's.
// Else, or when that compile refuses it for anything but an effect, a
// first compile asks the checker how the expression checks where the frame
// stopped (JetSema EvalProbe.jet): its type, the locals it captures, and a
// refusal for an effect, which names the effect; the second compiles the
// program with the expression as a function of its captures appended to
// the stop's source. A stop's source in Core is its row in the Core the
// program compiles with (jet_cli_debug_source_text), never a file under the
// working directory, and those compiles read that row whole
// (jet_cli_debug_eval_prepare).
use {
    debug_eval_files: core.files
    debug_eval_time: core.time
    jet_debug.[NATIVE_EVAL_CAPTURES, NativeEval, NativeEvalBinder, NativeEvalPart, NativeEvalRefused, NativeEvaluator, NativeFixEdit, native_eval_name_byte, native_eval_names]
    jet_driver.[JetDriverAuthorizedSourceFile, JetDriverAuthorizedSourceSnapshot, JetDriverCompileMode, JetDriverCompileResult, JetDriverEvalAsk, JetDriverHeldEval, JetDriverIceRow, JetDriverLoweringInputs, JetDriverSourceDocument, jet_driver_check_failures, jet_driver_checked_declarations, jet_driver_declares_workspace, jet_driver_entry_root_path, jet_driver_held_eval_answer, jet_driver_held_eval_append, jet_driver_held_eval_check, jet_driver_held_eval_open, jet_driver_inline_package, jet_driver_is_project_configuration]
    jet_eval.[jet_eval_native_add, jet_eval_native_wrapper]
    jet_foundation.[COMMENT_PREFIX, MODULE_CORE_PREFIX, BuildOptions, CompilerThreads, DeclTable, DeepChecks, FnBody, Interner, Name, StmtKind, TTypeDef, Type, body_type, deep_checks_flags, foundation_named_type, name_column_get, name_count, name_text, type_failure_name, type_name, type_unqualified_nominals]
    jet_ir.[IRBuildResult, IRModule, IROptOptions, IRProgram, IRTypeKind, ir_build_held_root, ir_cell_drop, ir_eval_place_refusal, ir_held_append, ir_held_program, ir_module_new, ir_module_row_ty, ir_pointer_row, ir_program_new, ir_untag, ir_x64_compile_module_logged, ir_x64_debug_program]
    jet_parser.[parse_type_text]
    jet_sema.[SemaEvalProbeAnswer, sema_eval_held_set, sema_eval_probe_function, sema_eval_probe_parse, sema_ownership_type_is_copy]
}

// The function an evaluated expression becomes, appended to its source.
JET_CLI_DEBUG_EXPRESSION: "jet_debug_expression"

// The entry that calls it with its result's cell and its captures'
// addresses (NativeEval.entry).
JET_CLI_DEBUG_EVAL_ENTRY: "jet_debug_eval"

// The function that drops the result its cell holds (NativeEval.drop), for
// a result whose type has a drop.
JET_CLI_DEBUG_EVAL_DROP: "jet_debug_eval_drop"

// The prefix of the debugger's own refusals in the checker's answer, which
// the console's `Can't evaluate` says already; the checker's other
// refusals show as the compiler's.
JET_CLI_DEBUG_EVAL_REFUSAL: "the debugger can't evaluate this: "

// The evaluator of a session debugging the program whose entry file is
// `entry`, built with the flags `argv` (jet_cli_debug_eval_argv), and the
// session's held check of that program (jet_cli_debug_eval_held_slot),
// which the session starts opening (jet_cli_debug_eval_held_start).
JetCLIDebugEvaluator: struct {
    entry: String,
    argv: [String],
    color: Bool,
    held: JetCLIDebugEvalHeldShared,

    impl NativeEvaluator {
        compile: fn(self, path: String, line: Int, column: Int, text: String, binders: [NativeEvalBinder]?, owned: Bool, running: [String:[U8]]) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> NativeEval NativeEvalRefused! {
            jet_cli_debug_eval_compile(self.entry, self.argv, self.color, self.held, path, line, column, text, binders, owned, running)
        }

        unchanged: fn(self) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> Bool Never! {
            jet_cli_debug_eval_unchanged(self.held, self.entry)
        }

        source: fn(self, path: String) -[FS, Env]> String? Never! {
            Val(jet_cli_debug_source_text(self.entry, path) ?? return None)
        }

        // The pack beside this jet, which a program this jet built linked
        // its runtime from.
        runtime: fn(self) -[FS, Env]> [U8]? Never! {
            Val(jet_cli_runtime_bytes(jet_cli_runtime_dir(), JET_CLI_RUNTIME_PACK_FILE) ?? return None)
        }
    }
}

// The flags an evaluation's compile takes: the program's build's, its
// optimization `level` (NativeSession.level, which the image's DWARF names)
// and `deep_checks`, with `dead_code: keep`: nothing in the program calls the
// expression's function, which `remove` would drop unbuilt.
jet_cli_debug_eval_argv: fn(deep_checks: DeepChecks, level: Int) -> [String] Never! {
    ^argv: [String]{"-O{level}", "--dead-code=keep"}
    loop word in deep_checks_flags(deep_checks) -> argv.push(word)
    argv
}

// The image's build flags `argv` applied to the program of `entry` as it
// reads now.
jet_cli_debug_eval_options: fn(entry: String, argv: [String], color: Bool{false}) -[FS, Env]> BuildOptions NativeEvalRefused! {
    entry_source: debug_eval_files.read(entry) ?? return Err(jet_cli_debug_eval_refused("couldn't read `{entry}`: {err}"))
    ^chosen: BuildOptions?{None}
    if jet_cli_build_options(argv, "build", entry, entry_source, color, true) == {
        .Refused(_) -> return Err(jet_cli_debug_eval_refused("the debug build's options don't apply to `{entry}` now"))
        .Selected(options, _) -> chosen = Val(options)
    }
    options: chosen ?? return Err(jet_cli_debug_eval_refused("the debug build's options don't apply to `{entry}` now"))
    Ok(options)
}

jet_cli_debug_eval_refused: fn(message: String) -> NativeEvalRefused Never! {
    NativeEvalRefused{message: message}
}

// Whether a value of the IR type kind `kind` is a word of its own: a
// number, Bool or Char, which a placed logpoint writes whole at its hit and
// no move empties.
jet_cli_debug_eval_word: fn(kind: IRTypeKind) -> Bool Never! {
    if kind == {
        .Bool | .Int | .Word | .Float | .Float32 | .Char -> true
        .Unit | .String | .Pointer | .Aggregate -> false
    }
}

// The byte offset of character column `column` (from 1) of line `line` (from
// 1) of `source`, the start of the node a caller's frame stopped at; column
// 0 is the line's first non-blank byte. None past the source's end.
jet_cli_debug_eval_offset: fn(source: String, line: Int, column: Int) -> Int? Never! {
    bytes: source.bytes()
    ^at: 0
    ^current: 1
    loop current < line {
        if at >= bytes.len() -> return None
        if bytes[at] == 10 -> current += 1
        at += 1
    }
    if column <= 0 {
        loop at < bytes.len() && (bytes[at] == 32 || bytes[at] == 9) -> at += 1
        return Val(at)
    }
    // Each character starts at a byte that is not a UTF-8 continuation.
    loop _ in 1..<column {
        if at >= bytes.len() || bytes[at] == 10 -> return None
        at += 1
        loop at < bytes.len() && bytes[at] >= 128 && bytes[at] < 192 -> at += 1
    }
    Val(at)
}

// `text` compiled into the program of `entry`, with the flags `argv`, as a
// function of the locals it reads before the node at `line` and `column` of
// the source `path` (NativeEval.jet); `binders`, `owned` and `running` as
// NativeEvaluator.compile takes them. An expression of locals is checked
// against the session's held checks `held` and built in their held
// programs: the program's once that is open (jet_cli_debug_eval_held), and
// the package cut's when the expression reaches no more of the package
// (jet_cli_debug_eval_held_cut). One that reads a local no parameter can
// take, or in a frame whose locals the image doesn't list, is answered by
// the held check of the program at the stop (jet_cli_debug_eval_held_asked),
// whose open it waits for. Else, once the expression is proven to reach no
// source that reads otherwise than `running` (jet_cli_debug_eval_stale),
// the cut compile builds it (jet_cli_debug_eval_sliced), and one that
// doesn't waits for the held check of the program before the program's
// compile builds it. Only the checks where the frame stopped
// (jet_cli_debug_eval_answer, jet_cli_debug_eval_held_asked) read where the
// node is in `path`, so only they find that offset; the other compiles
// append the expression's function to a source.
jet_cli_debug_eval_compile: fn(entry: String, argv: [String], color: Bool, held: JetCLIDebugEvalHeldShared, path: String, line: Int, column: Int, text: String, binders: [NativeEvalBinder]?, owned: Bool, running: [String:[U8]]) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> NativeEval NativeEvalRefused! {
    if entry == "" {
        return Err(jet_cli_debug_eval_refused("the debugger has no source of the program to compile it with; debug it as `jet debug <file.jet>`"))
    }
    parsed: sema_eval_probe_parse(text, 0)
    if parsed.expression == None {
        what: if parsed.diagnostics.len() > 0 -> parsed.diagnostics[0].what else -> "it is not one expression"
        return Err(jet_cli_debug_eval_refused("`{text}` is not a Jet expression: {what}"))
    }
    ^taken: [NativeEvalBinder]?{None}
    if binders == .Val(locals) -> taken = jet_cli_debug_eval_params(text, locals)
    if taken == .Val(params) {
        if jet_cli_debug_eval_held(held, entry, argv, color, running, path, text, params) == {
            .Ok(built) -> {
                if built == .Val(code) -> return Ok(code)
            }
            .Err(refusal) -> return Err(refusal)
        }
        if jet_cli_debug_eval_held_cut(held, entry, running, path, text, params) == {
            .Ok(built) -> {
                if built == .Val(code) -> return Ok(code)
            }
            .Err(refusal) -> return Err(refusal)
        }
    }
    if taken == None {
        if jet_cli_debug_eval_held_asked(held, entry, argv, running, path, line, column, text, color: color) == {
            .Ok(built) -> {
                if built == .Val(code) -> return Ok(code)
            }
            .Err(refusal) -> return Err(refusal)
        }
    }
    source: jet_cli_debug_source_text(entry, path) ?? return Err(err)
    options: jet_cli_debug_eval_options(entry, argv, color: color) ?? return Err(err)
    reading: jet_cli_debug_eval_snapshot(entry, color) ?? return Err(jet_cli_debug_eval_refused("couldn't read the sources of `{entry}`"))
    if jet_cli_debug_eval_stale(reading, running, text, binders) == .Val(refusal) {
        return Err(refusal)
    }
    core: jet_cli_debug_eval_core(held, entry)
    if taken == .Val(params) {
        if jet_cli_debug_eval_sliced(entry, color, options, held, reading.move(), path, text, params, owned, core_bound: Val(core)) == {
            .Ok(built) -> {
                if built == .Val(code) -> return Ok(code)
            }
            .Err(refusal) -> return Err(refusal)
        }
        // The cut compile doesn't build it: the held check does once it
        // is open, else the program's compile.
        jet_cli_debug_eval_held_wait(held)
        if jet_cli_debug_eval_held(held, entry, argv, color, running, path, text, params) == {
            .Ok(built) -> {
                if built == .Val(code) -> return Ok(code)
            }
            .Err(refusal) -> return Err(refusal)
        }
        if jet_cli_debug_eval_direct(entry, color, options, path, source, text, params, owned, core_bound: Val(core)) == {
            .Ok(built) -> {
                if built == .Val(code) -> return Ok(code)
            }
            .Err(refusal) -> return Err(refusal)
        }
    }
    offset: jet_cli_debug_eval_offset(source, line, column) ?? return Err(jet_cli_debug_eval_refused("`{path}` has no line {line} now"))
    answer: jet_cli_debug_eval_answer(entry, color, options, path, offset, line, text, core_bound: Val(core)) ?? return Err(err)
    function: sema_eval_probe_function(answer, text, JET_CLI_DEBUG_EXPRESSION) ?? return Err(jet_cli_debug_eval_refused("`{text}` has no value"))
    value: answer.value_type ?? return Err(jet_cli_debug_eval_refused("`{text}` has no value"))
    prepared: jet_cli_debug_eval_prepare(entry, color, path, Val("{source}\n{function}"))
    compiled: jet_cli_compile_executable(prepared, None, options, None, None, color, core_bound: Val(core)) ?? return Err(jet_cli_debug_eval_refused("the compiler stopped before finishing it"))
    if compiled.move() == {
        .Refused(refusal) -> Err(jet_cli_debug_eval_refused("the compiler refused it: {refusal.stderr.trim()}"))
        .Checked(result, inputs, snapshot) -> {
            failures: jet_driver_check_failures(result.diagnostics)
            if failures.len() > 0 {
                return Err(jet_cli_debug_eval_refused("the compiler refused it: {failures[0].what}"))
            }
            if result.internal_problem != None || !result.complete {
                return Err(jet_cli_debug_eval_refused("the compiler stopped before finishing it"))
            }
            checked: inputs.move() ?? return Err(jet_cli_debug_eval_refused("the compiler finished without its checked functions"))
            at: jet_cli_debug_eval_function(checked, path) ?? return Err(jet_cli_debug_eval_refused("the compiled program has no function for it"))
            names: loop capture in answer.captures -> capture.source
            ^built: jet_cli_debug_eval_build(result, checked, snapshot, options, entry, at, names, value, text, owned) ?? return Err(err)
            // A lent name's result is the stopped frame's own value
            // (SemaEvalProbeAnswer.lent): the session drops nothing of it.
            if answer.lent -> built.drop = ""
            Ok(built)
        }
    }
}

// Whether the session `held`'s evaluations of the program of `entry` take
// the Core built into this jet (Request.jet jet_cli_core_binding), decided
// at its first: the image was built with the one Core it runs, which an
// edit of a toolchain tree's Core during the session doesn't change, and the
// decision reads every Core file of that tree.
jet_cli_debug_eval_core: fn(held: JetCLIDebugEvalHeldShared, entry: String) -> Bool Never! {
    ^permit: held.slot.guard_edit()
    if permit.value.core == .Val(known) -> return known
    decided: jet_cli_core_binding(entry, "")
    permit.value.core = Val(decided)
    decided
}

// The locals of `binders` that `text`'s names read, each a parameter of the
// expression's function: None when one can't be, so the check of the
// stopped function decides (jet_cli_debug_eval_held_asked). A name the
// frame holds no variable by is the program's (a function's, a type's) or
// a field's. A name must read one variable, live at the stop, of a type
// whose debug spelling is a Jet type that spells back the same and whose
// values no move empties: such a value reads the same from the frame at
// any point it is live, so no check of the stopped function is needed to
// take it. The text's own `self` reads the receiver, which the probe passes
// (sema_eval_probe_function).
jet_cli_debug_eval_params: fn(text: String, binders: [NativeEvalBinder]) -> [NativeEvalBinder]? Never! {
    ^params: [NativeEvalBinder]{}
    loop name in native_eval_names(text) {
        if name == "self" -> return None
        ^held: NativeEvalBinder?{None}
        loop binder in binders {
            if binder.name != name -> next
            if held != None || !binder.live -> return None
            held = Val(binder)
        }
        found: held ?? next
        ty: parse_type_text(found.type_name) ?? return None
        if type_name(ty) != found.type_name || !sema_ownership_type_is_copy(ty) -> return None
        params.push(found)
    }
    Val(params)
}

// The sources of the package (jet_cli_debug_eval_members), `declared`'s, entry
// first, that the expression `text` of the locals `params`
// (jet_cli_debug_eval_params) compiles with in place of the program's, each
// cut to what the expression reaches: the entry's package carrier, if it
// holds one, the sources' functions its other names reach, the `use` blocks
// those functions' names import, and the entry's empty `run`; a source
// that keeps none of those is empty. Each kept item stays at the lines it
// holds in its source, the rest of which are blank, and the empty `run`
// follows them. Each local must be of a type the primitive spellings name
// (jet_cli_debug_eval_alone_types). An expression whose every name is one
// of those locals reads nothing of the program; with `functions` (the stop
// is in one of the sources, built at O0, where a function's code is its
// source's at its lines, as the program's `main` runs it), its other names
// may call the sources' functions (jet_cli_debug_eval_items), and theirs
// may too. Then the same code checks and builds from those sources, as
// functions of the same package built with the same flags, without
// checking the rest of the package's code. A name no item of the sources
// declares is left to the compile: a function's local, a field, Core's, or
// another package's. None when a local's type is another, when the
// expression names more than its locals without `functions`, when a name
// reached is the entry's `run`, an item other than a function (a type, a
// constant), declared by two sources, or a function the sources may use as
// a value (JetCLIDebugEvalDeclared.valued), so the program's compile builds
// it, or when the entry's package carrier starts no item.
jet_cli_debug_eval_alone: fn(text: String, params: [NativeEvalBinder], declared: JetCLIDebugEvalDeclared, functions: Bool{false}) -> [String]? Never! {
    if declared.sources.len() == 0 || !jet_cli_debug_eval_alone_types(params) -> return None
    locals: loop param in params -> param.name
    ^wanted: [String]{}
    loop name in native_eval_names(text) {
        if !locals.contains(name) -> wanted.push(name)
    }
    if wanted.len() > 0 && !functions -> return None
    block: jet_driver_inline_package(declared.sources[0])
    if block.error != None -> return None
    // The entry's item that holds its package carrier, -1 for none.
    ^carrier: -1
    if block.found {
        loop (at, item) in declared.files[0] {
            if item.start <= block.start -> carrier = at
        }
        if carrier < 0 -> return None
    }
    ^kept: [Int:Bool]{}
    ^asked: 0
    loop asked < wanted.len() {
        slot: declared.index.get(wanted[asked]) ?? -2
        asked += 1
        if slot == -1 -> return None
        if slot < 0 || kept.has_key(slot) -> next
        owner: declared.owners[slot]
        item: declared.files[owner][declared.rows[slot]]
        if !item.function || item.name == "run" || declared.valued.has_key(item.name) -> return None
        kept[slot] = true
        loop name in jet_cli_debug_eval_item_names(jet_cli_debug_eval_item_code(declared.sources[owner], declared.files[owner], declared.rows[slot])) {
            if !locals.contains(name) && !wanted.contains(name) -> wanted.push(name)
        }
    }
    // The items each source keeps, by row: those the names reach, the
    // entry's carrier, and the `use` blocks that name a wanted name.
    ^picked: loop _ in declared.files -> [Int]{}
    loop (slot, _) in kept -> picked[declared.owners[slot]].push(declared.rows[slot])
    if carrier >= 0 -> picked[0].push(carrier)
    loop (file, rows) in declared.imports {
        loop at in rows {
            ^used: false
            loop name in jet_cli_debug_eval_item_names(jet_cli_debug_eval_item_code(declared.sources[file], declared.files[file], at)) {
                if name != "use" && wanted.contains(name) -> used = true
            }
            if used -> picked[file].push(at)
        }
    }
    ^cut: [String]{}
    loop (file, items) in declared.files {
        picked[file].sort()
        ^parts: [String]{}
        // The line the cut's next byte is on.
        ^line: 1
        // A row the carrier and a `use` block both keep is cut once.
        ^last: -1
        loop at in picked[file] {
            if at == last -> next
            last = at
            // An item's code runs to the next item's first line.
            parts.push("\n".repeat(items[at].line - line))
            parts.push(jet_cli_debug_eval_item_code(declared.sources[file], items, at))
            if at + 1 < items.len() -> line = items[at + 1].line
        }
        if file == 0 {
            // The empty `run` starts a line of its own.
            if parts.len() > 0 && !parts[parts.len() - 1].ends_with("\n") -> parts.push("\n")
            parts.push("run: fn() {{}}")
        }
        cut.push(parts.join(""))
    }
    Val(cut)
}

// Whether each local of `params` is of a type the primitive spellings name
// (foundation_named_type), as every local a compile of the package's cut
// sources reads must be (jet_cli_debug_eval_alone).
jet_cli_debug_eval_alone_types: fn(params: [NativeEvalBinder]) -> Bool Never! {
    loop param in params {
        if foundation_named_type(param.type_name) == .Named(_) -> return false
    }
    true
}

// The top-level items of the package sources `sources`, entry first
// (jet_cli_debug_eval_items), and where each name they declare is, by its
// slot in `index`: its source in `owners` and its item in `rows`, the slot
// -1 for a name two sources declare; `imports` holds each source's `use`
// blocks by row, and `valued` the declared names the sources may use as a
// value (jet_cli_debug_eval_valued). A session keeps the last ones a cut
// compile read (JetCLIDebugEvalHeldSlot.declared), which the next takes
// while the sources read the same.
JetCLIDebugEvalDeclared: struct {
    sources: [String],
    files: [[JetCLIDebugEvalItem]],
    index: [String:Int],
    owners: [Int],
    rows: [Int],
    imports: [[Int]],
    valued: [String:Bool],
}

jet_cli_debug_eval_declared: fn(sources: ^^[String]) -> JetCLIDebugEvalDeclared Never! {
    files: loop source in sources -> jet_cli_debug_eval_items(source)
    ^index: [String:Int]{}
    ^owners: [Int]{}
    ^rows: [Int]{}
    ^imports: [[Int]]{}
    loop (file, items) in files {
        imports.push([Int]{})
        loop (at, item) in items {
            if item.imports -> imports[file].push(at)
            if item.name == "" -> next
            if index.get(item.name) == .Val(slot) {
                if slot < 0 || owners[slot] != file -> index[item.name] = -1
                if slot >= 0 && owners[slot] == file -> rows[slot] = at
                next
            }
            index[item.name] = owners.len()
            owners.push(file)
            rows.push(at)
        }
    }
    valued: jet_cli_debug_eval_valued(sources, index)
    JetCLIDebugEvalDeclared{sources: sources.move(), files: files.move(), index: index.move(), owners: owners.move(), rows: rows.move(), imports: imports.move(), valued: valued.move()}
}

// The names of `declared` that `sources` spell other than as a call or a
// declaration, each bound to true: a name (native_eval_names) not after a
// `.` whose next byte past spaces on its line is no `(` or `:`, comment
// lines and a string's text (not its interpolations) left out. A function
// used as a value keeps the failure carrier the failure solve would
// otherwise take from it (JetSema sema_failure_solve), so a cut compile
// that leaves the use out would build it, and bind its calls, otherwise
// than the image does. A local of the name counts too, which only leaves
// more to the program's compile.
jet_cli_debug_eval_valued: fn(sources: [String], declared: [String:Int]) -> [String:Bool] Never! {
    ^valued: [String:Bool]{}
    loop source in sources {
        loop line in source.split("\n") {
            if line.trim().starts_with(COMMENT_PREFIX) -> next
            bytes: line.bytes()
            ^quoted: false
            ^nested: 0
            ^at: 0
            loop at < bytes.len() {
                byte: bytes[at]
                if quoted && nested == 0 {
                    doubled: byte == 123 && at + 1 < bytes.len() && bytes[at + 1] == 123
                    if byte == 34 -> quoted = false
                    if byte == 123 && !doubled -> nested = 1
                    at += if byte == 92 || doubled -> 2 else -> 1
                    next
                }
                if byte == 34 -> quoted = true
                if quoted && byte == 123 -> nested += 1
                if quoted && byte == 125 -> nested -= 1
                start: at
                loop at < bytes.len() && native_eval_name_byte(bytes[at]) -> at += 1
                if at == start {
                    at += 1
                    next
                }
                if bytes[start] >= 48 && bytes[start] <= 57 -> next
                if start > 0 && bytes[start - 1] == 46 -> next
                ^after: at
                loop after < bytes.len() && bytes[after] == 32 -> after += 1
                if after < bytes.len() && (bytes[after] == 40 || bytes[after] == 58) -> next
                name: String.from_bytes(bytes[start..<at]) ?? next
                if declared.has_key(name) -> valued[name] = true
            }
        }
    }
    valued
}

// `text`, an expression of the locals `params` (jet_cli_debug_eval_params)
// at a stop in the source `path`, compiled from the package's sources in
// `snapshot` cut to what it reaches (jet_cli_debug_eval_alone), the
// expression appended to the source of the stop (or to the entry, when the
// stop is in none of them): its other names may call the sources' functions
// when the stop is in one of them and the image is built at O0. The
// sources' items are the session's `session` when it read the same sources
// last. `core_bound` as jet_cli_debug_eval_direct takes it. As
// jet_cli_debug_eval_direct answers; None, so the held check or the
// program's compile answers, when the sources can't be cut.
jet_cli_debug_eval_sliced: fn(entry: String, color: Bool, options: BuildOptions, session: JetCLIDebugEvalHeldShared, snapshot: ^^JetDriverAuthorizedSourceSnapshot, path: String, text: String, params: [NativeEvalBinder], owned: Bool, core_bound: Bool?{None}) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> NativeEval? NativeEvalRefused! {
    if !jet_cli_debug_eval_alone_types(params) -> return Ok(None)
    members: jet_cli_debug_eval_members_of(snapshot.move()) ?? return Ok(None)
    sources: members.sources.move()
    ^paths: members.paths.move()
    host: jet_cli_debug_eval_host(paths, path) ?? return Ok(None)
    ^permit: session.slot.guard_edit()
    same: if permit.value.declared == .Val(known) -> known.sources == sources else -> false
    if !same -> permit.value.declared = Val(jet_cli_debug_eval_declared(sources.move()))
    ^found: [String]?{None}
    if permit.value.declared == .Val(known) {
        found = jet_cli_debug_eval_alone(text, params, known, functions: host >= 0 && jet_cli_native_level(options) == 0)
    }
    ^cut: found ?? return Ok(None)
    at: if host >= 0 -> host else -> 0
    ^source: ""
    ^asked: entry
    ^others: [JetDriverSourceDocument]{}
    loop cut.len() > 0 {
        piece: cut.pop() ?? break
        place: paths.pop() ?? break
        if cut.len() != at {
            others.push(JetDriverSourceDocument{path: place, source: piece})
            next
        }
        source = piece
        if at > 0 -> asked = place
    }
    jet_cli_debug_eval_direct(entry, color, options, asked, source, text, params, owned, others: others.move(), core_bound: core_bound)
}

// The package's sources a cut compile takes (jet_cli_debug_eval_members),
// entry first, as the snapshot of `entry` reads them now, and their paths.
JetCLIDebugEvalMembers: struct {
    sources: [String],
    paths: [String],
}

// The snapshot of the sources of `entry` as they read now; None when it is
// refused.
jet_cli_debug_eval_snapshot: fn(entry: String, color: Bool) -> JetDriverAuthorizedSourceSnapshot? {
    if jet_cli_prepare_snapshot(entry, entry, [JetDriverSourceDocument]{}, color, appended: true) == {
        .Refused(_) -> return None
        .Held(snapshot) -> return Val(snapshot)
    }
    None
}

// Why the expression `text` can't be compiled from the sources of
// `snapshot`, as they read now, and run as the program's code: an item it
// reaches is in a source that reads otherwise than the program's image
// records it was built from, `running` (`.debug_jetsource`, a sha256 by
// path, jet_cli_debug_eval_digests), so the compile's copy of that item is
// not the code the program runs. A source the record lacks reads
// otherwise; with no record, every source does. The text's names reach the
// top-level items of every source that declare them
// (jet_cli_debug_eval_items), and those items reach the ones the names of
// their code declare, in turn. A name of `binders`, the stop's variables,
// reaches the items its type names instead; with no binders, every name is
// taken as the program's. A source is as small as the proof gets: an item
// of an edited source is refused though its own text is the same. None
// when no item reached is in such a source, as for an expression of locals
// of the primitive types.
jet_cli_debug_eval_stale: fn(snapshot: JetDriverAuthorizedSourceSnapshot, running: [String:[U8]], text: String, binders: [NativeEvalBinder]?) -> NativeEvalRefused? Never! {
    digests: jet_cli_source_digests(snapshot)
    // The sources, as `digests` lists them, and whether each reads otherwise.
    ^sources: [String]{}
    ^edited: [Bool]{}
    ^any: false
    loop root in snapshot.roots {
        loop file in root.files {
            at: sources.len()
            was: running.get(digests[at].path) ?? [U8]{}
            differs: was != digests[at].digest
            sources.push(file.source)
            edited.push(differs)
            if differs -> any = true
        }
    }
    if !any -> return None
    // Each source's items, each item's source and row by its number, and
    // the items that declare each name, by the name's slot.
    files: loop source in sources -> jet_cli_debug_eval_items(source)
    ^owners: [Int]{}
    ^rows: [Int]{}
    ^slots: [String:Int]{}
    ^declaring: [[Int]]{}
    loop (file, items) in files {
        loop (at, item) in items {
            if item.name == "" -> next
            ^slot: slots.get(item.name) ?? -1
            if slot < 0 {
                slot = declaring.len()
                slots[item.name] = slot
                declaring.push([Int]{})
            }
            declaring[slot].push(owners.len())
            owners.push(file)
            rows.push(at)
        }
    }
    ^wanted: [String]{}
    ^asked: [String:Bool]{}
    loop name in native_eval_names(text) {
        ^typed: [String]?{None}
        if binders == .Val(locals) {
            loop binder in locals {
                if binder.name == name -> typed = Val(native_eval_names(binder.type_name))
            }
        }
        reached: typed ?? [String]{name}
        loop more in reached {
            if asked.has_key(more) -> next
            asked[more] = true
            wanted.push(more)
        }
    }
    ^seen: [Int:Bool]{}
    ^taken: 0
    loop taken < wanted.len() {
        name: wanted[taken]
        taken += 1
        slot: slots.get(name) ?? next
        loop item in declaring[slot] {
            if seen.has_key(item) -> next
            seen[item] = true
            file: owners[item]
            if edited[file] {
                return Val(jet_cli_debug_eval_stale_refusal(name, digests[file].path, running))
            }
            loop more in jet_cli_debug_eval_item_names(jet_cli_debug_eval_item_code(sources[file], files[file], rows[item])) {
                if asked.has_key(more) -> next
                asked[more] = true
                wanted.push(more)
            }
        }
    }
    None
}

// The refusal of an item `name` of the source `file` that reads otherwise
// than the image's record `running` (jet_cli_debug_eval_stale).
jet_cli_debug_eval_stale_refusal: fn(name: String, file: String, running: [String:[U8]]) -> NativeEvalRefused Never! {
    if running.len() == 0 {
        return jet_cli_debug_eval_refused("`{name}` can't be checked against the code the program runs: its image records no sources; rebuild the program")
    }
    jet_cli_debug_eval_refused("`{name}`'s source `{file}` changed since the program was built; rebuild the program, or `fix` it first")
}

// The package's sources in the snapshot `snapshot` (jet_cli_debug_eval_sliced).
jet_cli_debug_eval_members_of: fn(snapshot: ^^JetDriverAuthorizedSourceSnapshot) -> JetCLIDebugEvalMembers? {
    ^roots: snapshot.roots.move()
    ^files: [JetDriverAuthorizedSourceFile]{}
    loop roots.len() > 0 {
        root: roots.pop() ?? break
        if root.identity == snapshot.entry_root_identity {
            files = root.files.move()
            break
        }
    }
    picked: jet_cli_debug_eval_members(files, snapshot.entry_path)
    if picked.len() == 0 -> return None
    // Each picked row's place in `sources` and `paths`, which take the
    // files' texts as they come off `files`.
    ^order: [Int:Int]{}
    ^sources: [String]{}
    ^paths: [String]{}
    loop (at, row) in picked {
        order[row] = at
        sources.push("")
        paths.push("")
    }
    loop files.len() > 0 {
        file: files.pop() ?? break
        at: order.get(files.len()) ?? next
        sources[at] = file.source.move()
        paths[at] = file.path.move()
    }
    Val(JetCLIDebugEvalMembers{sources: sources.move(), paths: paths.move()})
}

// The row of `paths`, the package's sources (JetCLIDebugEvalMembers), that
// is the stop's source `path`: -1 for none, None when two are.
jet_cli_debug_eval_host: fn(paths: [String], path: String) -> Int? Never! {
    ^host: -1
    loop (at, file) in paths {
        if !debug_eval_path_same(file, path) -> next
        if host >= 0 -> return None
        host = at
    }
    Val(host)
}

// The rows of `files`, an entry root's, that a cut compile
// (jet_cli_debug_eval_sliced) takes, the entry `entry_path`'s first: and,
// when the root is a package whose manifest names no `configs` and the
// entry neither carries a package nor declares a workspace of its own, the
// root's other sources in the entry's folder, which share its namespace,
// but for project configurations, `pkg.jet` and sources that declare a
// workspace. Empty when the root holds no entry.
jet_cli_debug_eval_members: fn(files: [JetDriverAuthorizedSourceFile], entry_path: String) -> [Int] Never! {
    ^entry: -1
    ^manifest: false
    loop (row, file) in files {
        if file.path == entry_path -> entry = row
        if file.relative_path == "package.jet" && !file.source.contains("configs") {
            manifest = true
        }
    }
    if entry < 0 -> return [Int]{}
    ^rows: [Int]{entry}
    alone: jet_driver_inline_package(files[entry].source).found || jet_driver_declares_workspace(files[entry].source)
    if !manifest || alone -> return rows
    folder: jet_cli_relative_parent(files[entry].relative_path)
    loop (row, file) in files {
        if row == entry || !file.relative_path.ends_with(".jet") -> next
        name: jet_cli_file_name(file.relative_path)
        if jet_cli_relative_parent(file.relative_path) != folder || name == "pkg.jet" -> next
        configures: jet_driver_is_project_configuration(file.relative_path)
        if configures || jet_driver_declares_workspace(file.source) -> next
        rows.push(row)
    }
    rows
}

// A top-level item of an entry's source (jet_cli_debug_eval_items), from
// its byte `start`, on its `line` (from 1), to the next item's: the name it
// declares ("" for a test, an `impl` or a `use` block), whether it is a
// `use` block, and whether a function (`name: fn(` or `name: fn<`, `priv`
// or not).
JetCLIDebugEvalItem: struct {
    name: String,
    start: Int,
    line: Int,
    imports: Bool,
    function: Bool,
}

// The top-level items of `source`, in order. One starts at each line whose
// first byte is its own, other than a blank line's, a closing bracket's, a
// comment's or an attribute's, and takes the comment and attribute lines
// just above it. A test's attribute opens its block, so its line starts one.
jet_cli_debug_eval_items: fn(source: String) -> [JetCLIDebugEvalItem] Never! {
    bytes: source.bytes()
    ^items: [JetCLIDebugEvalItem]{}
    ^above: -1
    // The line `above` is on, and the line the scan is on.
    ^above_line: 0
    ^number: 0
    ^at: 0
    loop at < bytes.len() {
        line: at
        number += 1
        ^opens: false
        loop at < bytes.len() && bytes[at] != 10 {
            if bytes[at] == 123 -> opens = true
            at += 1
        }
        end: at
        at += 1
        if end == line -> next
        first: bytes[line]
        // Whitespace, then `}`, `)` and `]`.
        if first == 32 || first == 9 || first == 13 -> next
        if first == 125 || first == 41 || first == 93 {
            above = -1
            next
        }
        // A `//` comment, or an attribute that opens no block.
        if first == 47 || (first == 35 && !opens) {
            if above < 0 {
                above = line
                above_line = number
            }
            next
        }
        start: if above >= 0 -> above else -> line
        start_line: if above >= 0 -> above_line else -> number
        above = -1
        items.push(jet_cli_debug_eval_item(source.slice(line..<end), start, start_line))
    }
    items
}

// The item whose first line, line `line` at its byte `start`, is `header`.
jet_cli_debug_eval_item: fn(header: String, start: Int, line: Int) -> JetCLIDebugEvalItem Never! {
    head: if header.starts_with("priv ") -> header.slice(5..<header.len()) else -> header
    if head == "use" || head.starts_with("use ") || head.starts_with("use{{") {
        return JetCLIDebugEvalItem{name: "", start: start, line: line, imports: true, function: false}
    }
    // The name the line starts with (native_eval_names), then `:`.
    bytes: head.bytes()
    ^named: 0
    loop named < bytes.len() && native_eval_name_byte(bytes[named]) -> named += 1
    if named == 0 || named == bytes.len() || bytes[named] != 58 || (bytes[0] >= 48 && bytes[0] <= 57) {
        return JetCLIDebugEvalItem{name: "", start: start, line: line, imports: false, function: false}
    }
    declares: head.slice(named..<head.len())
    function: declares.starts_with(": fn(") || declares.starts_with(": fn<")
    JetCLIDebugEvalItem{name: head.slice(0..<named), start: start, line: line, imports: false, function: function}
}

// The source of item `at` of `items`, the items of `source`.
jet_cli_debug_eval_item_code: fn(source: String, items: [JetCLIDebugEvalItem], at: Int) -> String Never! {
    end: if at + 1 < items.len() -> items[at + 1].start else -> source.len()
    source.slice(items[at].start..<end)
}

// The names an item's code spells (native_eval_names), its comment lines
// left out.
jet_cli_debug_eval_item_names: fn(code: String) -> [String] Never! {
    ^names: [String]{}
    loop line in code.split("\n") {
        if line.trim().starts_with(COMMENT_PREFIX) -> next
        loop name in native_eval_names(line) {
            if !names.contains(name) -> names.push(name)
        }
    }
    names
}

// `text` compiled as the function of `params` appended to `source`, in one
// compile that also asks the checker how `text` checks as that function's
// statement (JetSema EvalProbe.jet): its type, and a refusal of an effect
// it uses, which names the effect as the stop's check would. `others` stand
// in for the package's other sources (jet_cli_debug_eval_sliced);
// `core_bound` is the session's Core binding (jet_cli_debug_eval_core). The
// function discards the value (`^_: text`); once checked, that statement
// returns it and the function's result is its type. The compiled
// expression, or the debugger's refusal of an effect it uses; None, so the
// check where the frame stopped answers, for any other refusal, a value
// that can fail, or a build that doesn't finish.
jet_cli_debug_eval_direct: fn(entry: String, color: Bool, options: BuildOptions, path: String, source: String, text: String, params: [NativeEvalBinder], owned: Bool, others: ^^[JetDriverSourceDocument]{[JetDriverSourceDocument]{}}, core_bound: Bool?{None}) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> NativeEval? NativeEvalRefused! {
    typed: loop param in params -> "{param.name}: {param.type_name}"
    lead: "{JET_CLI_DEBUG_EXPRESSION}: fn({typed.join(", ")}) {{\n    "
    // The ask's offset is the statement's first byte in the appended source.
    offset: source.len() + 1 + lead.len()
    asked: if jet_cli_debug_eval_prepare(entry, color, path, Val("{source}\n{lead}^_: {text}\n}}\n"), others: others.move()) == {
        .Refused(output) -> JetCLIPrepared.Refused{output: output}
        .Prepared(request, snapshot) -> {
            ^held: request
            held.eval_ask = Val(JetDriverEvalAsk{path: path, offset: offset, text: text})
            JetCLIPrepared.Prepared{request: held, snapshot: snapshot}
        }
    }
    compiled: jet_cli_compile_executable(asked, None, options, None, None, color, core_bound: core_bound) ?? return Ok(None)
    if compiled.move() == {
        .Refused(_) -> Ok(None)
        .Checked(result, inputs, snapshot) -> {
            ^chosen: SemaEvalProbeAnswer?{None}
            loop answer in result.eval_answers {
                if chosen == None || answer.exact -> chosen = Val(answer)
            }
            answer: chosen ?? return Ok(None)
            if answer.refusals.len() > 0 {
                what: answer.refusals[0].what
                if what.starts_with(JET_CLI_DEBUG_EVAL_REFUSAL) {
                    return Err(jet_cli_debug_eval_refused(what.slice(JET_CLI_DEBUG_EVAL_REFUSAL.len()..<what.len())))
                }
                return Ok(None)
            }
            if jet_driver_check_failures(result.diagnostics).len() > 0 || result.internal_problem != None || !result.complete {
                return Ok(None)
            }
            value: answer.value_type ?? return Ok(None)
            if value == .Result(_, _) -> return Ok(None)
            ^checked: inputs.move() ?? return Ok(None)
            at: jet_cli_debug_eval_function(checked, path) ?? return Ok(None)
            if !jet_cli_debug_eval_returns(checked.functions[at], value) -> return Ok(None)
            names: loop param in params -> param.name
            built: jet_cli_debug_eval_build(result, checked.move(), snapshot, options, entry, at, names, value, text, owned) ?? return Ok(None)
            Ok(Val(built))
        }
    }
}

// The expression's function `function`, which discards its statement's
// value, made to return it as a `value`: false when it can fail, whose
// carrier the probe's function declares instead, or its last statement is
// not the discard it was written as.
jet_cli_debug_eval_returns: fn(function: ^FnBody, value: Type) -> Bool Never! {
    if function.failure_carrier == {
        .Infallible -> {}
        .Result(_, _) | .Optional(_) | .Diverges(_) -> return false
    }
    if function.body.len() == 0 -> return false
    row: function.body[function.body.len() - 1] - function.tree.stmt_base
    ^returned: StmtKind?{None}
    if {
        function.tree.stmts[row] == .Let(_, _, init, _, _, span) -> {
            returned = Val(StmtKind.Return{value: Val(init), span: span})
        }
        function.tree.stmts[row] == .ExprStmt(discarded, span) -> {
            returned = Val(StmtKind.Return{value: Val(discarded), span: span})
        }
    }
    function.tree.stmts[row] = returned ?? return false
    function.ret = Val(value)
    true
}

// The index in `checked` of the expression's function appended to `path`.
jet_cli_debug_eval_function: fn(checked: JetDriverLoweringInputs, path: String) -> Int? Never! {
    ^found: Int?{None}
    loop (at, body) in checked.functions {
        if body.name == JET_CLI_DEBUG_EXPRESSION && debug_eval_path_same(body.source_file, path) {
            found = Val(at)
        }
    }
    found
}

// The expression's function, `checked.functions[at]`, built as a root of
// the program `result` checked, with the entry that calls it, its
// parameters read as the locals `names` and its result a `value`, lowered
// to the code the session places; its program owns its `main` only when
// the image's does (`owned`, NativeEvaluator.compile).
jet_cli_debug_eval_build: fn(result: JetDriverCompileResult, checked: ^^JetDriverLoweringInputs, snapshot: JetDriverAuthorizedSourceSnapshot, options: BuildOptions, entry: String, at: Int, names: [String], value: Type, text: String, owned: Bool) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> NativeEval NativeEvalRefused! {
    key: "{checked.functions[at].key}"
    runtime: jet_cli_runtime_exports(jet_cli_runtime_dir())
    if runtime.failure != None {
        return Err(jet_cli_debug_eval_refused("couldn't read the Jet runtime's exports"))
    }
    ^census: [JetDriverIceRow]{}
    ^built: jet_cli_native_program(result, checked.move(), None, options, runtime, census, entry, jet_driver_entry_root_path(snapshot), roots: [String]{key}, own: owned)
    if built.failure != None || census.len() > 0 {
        return Err(jet_cli_debug_eval_refused("the compiler couldn't build it"))
    }
    program: built.program.move()
    built.program = ir_module_new()
    threads: CompilerThreads{cap: result.compiler_threads.cap, cores: result.compiler_threads.cores, memory_available: jet_cli_memory_available()}
    jet_cli_debug_eval_native(program.move(), key, names, value, text, threads)
}

// A debugger's evaluations over one held check of the program (JetDriver
// jet_driver_held_eval_open): its checked functions declared and bound once
// for the IR builder (JetIR ir_held_program), so an evaluation builds only
// its expression's function and the functions that reaches which the image
// doesn't hold (jet_cli_debug_eval_held_run). The program's build is the
// image's: its optimization `level` and its optimizer's options `opt`
// (jet_cli_opt_options), read once at the open rather than at each
// evaluation, at whose O0 a call of a function the image holds calls the
// image's code.
JetCLIDebugEvalHeldIR: struct {
    program: IRProgram,
    level: Int,
    opt: IROptOptions,
    threads: CompilerThreads,
}

// The held IR program of the checked program `checked`, which `result`
// checked with the image's build `options`, its Core calls bound to the
// runtime of `runtime`, as the image's build binds them
// (jet_cli_native_checks). The declarations are the held probe's
// registration's, `decls`, and the checked types `types` (JetDriver
// JetDriverHeldOpened), which the probe borrows back for each check.
jet_cli_debug_eval_held_ir: fn(result: JetDriverCompileResult, checked: ^^JetDriverLoweringInputs, decls: DeclTable, types: ^^[TTypeDef], options: BuildOptions, runtime: JetCLIRuntimeExports) -> JetCLIDebugEvalHeldIR Never! {
    ^inputs: checked.move()
    level: jet_cli_native_level(options)
    checks: jet_cli_native_checks(result, inputs, options, runtime)
    declarations: jet_driver_checked_declarations(inputs)
    built: ir_program_new(inputs.functions.move(), decls, inputs.symbols.move(), inputs.interner.move(), types.move(), declarations.impls.move(), inputs.sources.move(), declarations.constants.move())
    program: ir_held_program(built.move(), decls, declarations.foreign.move(), checks, bind: level <= 0)
    JetCLIDebugEvalHeldIR{program: program.move(), level: level, opt: jet_cli_opt_options(level, options), threads: result.compiler_threads}
}

// The held build `built` (JetIR ir_build_held_root) of the expression's
// function of key `key`, its parameters read as the locals `names` and its
// result a `value` of the expression `text`, lowered with `held`'s build to
// the code the session places.
jet_cli_debug_eval_held_lower: fn(held: JetCLIDebugEvalHeldIR, built: ^^IRBuildResult, key: String, names: [String], value: Type, text: String, threads: CompilerThreads) -[FS, Env, Time, Exec.Args]> NativeEval NativeEvalRefused! {
    if built.failures.len() > 0 {
        return Err(jet_cli_debug_eval_refused("the compiler couldn't build it: {built.failures[0].message}"))
    }
    ^program: built.program.move()
    ^census: [JetDriverIceRow]{}
    jet_cli_native_optimize(program, held.opt, threads, census, None)
    if census.len() > 0 -> return Err(jet_cli_debug_eval_refused("the compiler couldn't build it"))
    program.debug_level = held.level
    ^code: jet_cli_debug_eval_native(program.move(), key, names, value, text, threads) ?? return Err(err)
    code.held = true
    Ok(code)
}

// A session's held check of its program (JetDriver jet_driver_held_eval_open)
// and its held IR program, which owns the checked functions, the symbol
// table and the checked types the check borrows, opened from the sources
// `stamp`: a source file that reads other than it did (as a session's `fix`
// writes one) opens a new one. A held check of the package's cut keeps the
// `items` of the sources it read, which it gains functions of
// (jet_cli_debug_eval_held_append).
JetCLIDebugEvalHeld: struct {
    eval: JetDriverHeldEval,
    ir: JetCLIDebugEvalHeldIR,
    stamp: JetCLIDebugEvalHeldStamp,
    items: JetCLIDebugEvalHeldItems?{None},
}

// The package's sources a held check of its cut read
// (jet_cli_debug_eval_held_cut_open): their items (`declared`), their
// paths, entry first, and their sha256 by the path an image built from them
// records each at (jet_cli_debug_eval_digests), and the names of the
// functions of them appended to the check so far, which run the image's
// code only while `read` is the image's record.
JetCLIDebugEvalHeldItems: struct {
    declared: JetCLIDebugEvalDeclared,
    paths: [String],
    read: [String:[U8]],
    appended: [String:Bool]{[String:Bool]{}},
}

// The sources a held check read: the text of each source file of the
// program, by its path, and the identity (jet_cli_identity_key) each file
// had then, by which a file whose identity is the same reads the same, so
// nothing reads it again (jet_cli_debug_eval_held_change). A file written
// within JET_CLI_DEBUG_EVAL_RACY_NS of the read can be written again with
// the same identity: it has none, and is read each time.
JetCLIDebugEvalHeldStamp: struct {
    sources: [String:String],
    keys: [String:String],
}

// How close to a read a file's last write makes its identity no proof of
// its text (JetCLIDebugEvalHeldStamp): a write's time is the clock's tick,
// which a second outlasts.
JET_CLI_DEBUG_EVAL_RACY_NS: 1000000000

// The session's held check, None until its open
// (jet_cli_debug_eval_held_start) is done and while it opens again,
// whether it is opening, the sources of the last one that didn't open,
// which no open tries again until they change, the items of the sources its
// last cut compile read (jet_cli_debug_eval_sliced) and its Core binding,
// None until its first evaluation decides it (jet_cli_debug_eval_core).
// `program`: whether the session's image records the sources it was built
// from, so the held check of the program can be proven to be its program;
// `read`: the sha256 of each source the last open read, by the path the
// image records it at (jet_cli_debug_eval_digests). Its calls of the
// image's functions run the code its source says only while `read` is the
// session's record (jet_cli_debug_eval_held_in). `kept`: the sources as
// they read when the session last asked whether its kept code is current
// (jet_cli_debug_eval_unchanged). `seed`: the sources as the first open
// that read them found them, which the session's first ask takes as
// `kept` while they read the same; `asked`: whether the session has
// asked. `cut`, `cut_opening`, `cut_missed`: the session's held check of
// the package's cut, as `held`, `opening` and `missed` are the program's
// (jet_cli_debug_eval_held_cut).
JetCLIDebugEvalHeldSlot: struct {
    held: JetCLIDebugEvalHeld?{None},
    opening: Bool{false},
    missed: JetCLIDebugEvalHeldStamp?{None},
    declared: JetCLIDebugEvalDeclared?{None},
    core: Bool?{None},
    program: Bool{false},
    read: [String:[U8]]{[String:[U8]]{}},
    kept: JetCLIDebugEvalHeldStamp?{None},
    seed: JetCLIDebugEvalHeldStamp?{None},
    asked: Bool{false},
    cut: JetCLIDebugEvalHeld?{None},
    cut_opening: Bool{false},
    cut_missed: JetCLIDebugEvalHeldStamp?{None},
}

// A session's held check `slot` and the Condition its open wakes `opened`
// when it is done (jet_cli_debug_eval_held_done), which an evaluation
// waiting for it parks on (jet_cli_debug_eval_held_wait).
JetCLIDebugEvalHeldShared: struct {
    slot: Shared<JetCLIDebugEvalHeldSlot>,
    opened: Condition,
}

// A session's empty held checks, for JetCLIDebugEvaluator.held.
jet_cli_debug_eval_held_slot: fn() -> JetCLIDebugEvalHeldShared {
    JetCLIDebugEvalHeldShared{slot: Shared{JetCLIDebugEvalHeldSlot{}}, opened: Condition.new()}
}

// Starts opening the session's held checks `held` of the program of `entry`
// with the image's build flags `argv` (jet_cli_debug_eval_held_prepare and
// jet_cli_debug_eval_held_cut_prepare), each on a task of its own, unless
// it is opening, open on the sources the program has now, or its last
// open, which didn't, read those. The open of the program checks it as
// `jet check` does, which an image build and the run to the first stop
// take as long as, so a session starts it first and a print at that stop
// finds it open; the cut's checks only Core and the package's carrier.
// Until they are, the compiles answer (jet_cli_debug_eval_compile). The
// held check of the program opens once a start says `program`: the
// session's image records the sources it was built from (NativeImage
// sources), or the session is building it with debug info, which records
// them. An image that records none can't be proven the held check's
// program, so the cut alone opens for it. The flags are read into build
// options here, which each task then owns. The tasks run at the session's
// priority: the runtime sets a priority for a process, not for a task.
jet_cli_debug_eval_held_start: fn(held: JetCLIDebugEvalHeldShared, entry: String, argv: [String], color: Bool{false}, program: Bool{false}) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> Never! {
    if entry == "" {
        return
    }
    if jet_cli_debug_eval_held_cut_claim(held, program: program) {
        cutting: task jet_cli_debug_eval_held_cut_prepare_argv(held, "{entry}", argv, color: color)
        cutting.detach()
        return
    }
    if !jet_cli_debug_eval_held_claim(held, program: program) {
        return
    }
    opening: task jet_cli_debug_eval_held_prepare_argv(held, "{entry}", argv, color: color)
    opening.detach()
}

// Whether the held check of the package's cut `held` is to be opened now
// (jet_cli_debug_eval_held_start), when it is marked opening and a stale
// one is dropped. Records `program` when true so the full-program held check
// opens right after the cut finishes without competing with the first stop.
jet_cli_debug_eval_held_cut_claim: fn(held: JetCLIDebugEvalHeldShared, program: Bool{false}) -[FS]> Bool Never! {
    ^permit: held.slot.guard_edit()
    if program -> permit.value.program = true
    if permit.value.cut_opening || !jet_cli_debug_eval_held_stale(permit.value.cut) || jet_cli_debug_eval_held_missed(permit.value.cut_missed) {
        return false
    }
    permit.value.cut = None
    permit.value.cut_opening = true
    true
}

// Resolves build options on the background task so session startup does no
// synchronous source read before launching the target, opens the cut, wakes
// any first-stop waiter, and then opens the full-program held check if needed.
priv jet_cli_debug_eval_held_cut_prepare_argv: fn(held: JetCLIDebugEvalHeldShared, entry: String, argv: [String], color: Bool{false}) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> Never! {
    options: jet_cli_debug_eval_options(entry, argv, color: color) ?? {
        uncut: JetCLIDebugEvalHeldOpen{held: None, missed: None}
        if jet_cli_debug_eval_held_cut_finish(held, uncut) {
            unopened: JetCLIDebugEvalHeldOpen{held: None, missed: None}
            jet_cli_debug_eval_held_done(held, unopened)
        }
        return
    }
    opening: task jet_cli_debug_eval_held_cut_open(entry, color, options)
    opened: opening.join() ?? JetCLIDebugEvalHeldOpen{held: None, missed: None}
    if jet_cli_debug_eval_held_cut_finish(held, opened) {
        jet_cli_debug_eval_held_prepare(held, entry, options, color: color)
    }
}

// The held check of the package's cut of `entry` opened with the image's
// build `options` (jet_cli_debug_eval_held_cut_open) into its slot `held`,
// on a task of its own, as jet_cli_debug_eval_held_prepare opens the
// program's.
jet_cli_debug_eval_held_cut_prepare: fn(held: JetCLIDebugEvalHeldShared, entry: String, options: BuildOptions, color: Bool{false}) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> Never! {
    opening: task jet_cli_debug_eval_held_cut_open(entry, color, options)
    opened: opening.join() ?? JetCLIDebugEvalHeldOpen{held: None, missed: None}
    jet_cli_debug_eval_held_cut_done(held, opened)
}

// Ends the opening of the held check of the package's cut `held` with the
// open `opened`.
jet_cli_debug_eval_held_cut_done: fn(held: JetCLIDebugEvalHeldShared, opened: ^^JetCLIDebugEvalHeldOpen) Never! {
    ^permit: held.slot.guard_edit()
    permit.value.cut = opened.held.move()
    permit.value.cut_missed = opened.missed.move()
    if !permit.value.asked && permit.value.seed == None -> permit.value.seed = opened.seed.move()
    permit.value.cut_opening = false
    held.opened.notify_all()
}

// Ends the cut open and atomically claims the full-program held open when
// `program` is enabled and stale, before waking waiters, so no waiter can
// observe both `cut_opening` and `opening` false while the full open is due.
priv jet_cli_debug_eval_held_cut_finish: fn(held: JetCLIDebugEvalHeldShared, opened: ^^JetCLIDebugEvalHeldOpen) -[FS]> Bool Never! {
    ^permit: held.slot.guard_edit()
    permit.value.cut = opened.held.move()
    permit.value.cut_missed = opened.missed.move()
    if !permit.value.asked && permit.value.seed == None -> permit.value.seed = opened.seed.move()
    permit.value.cut_opening = false
    ^start_full: false
    if permit.value.program && !permit.value.opening && jet_cli_debug_eval_held_stale(permit.value.held) && !jet_cli_debug_eval_held_missed(permit.value.missed) {
        permit.value.held = None
        permit.value.read = [String:[U8]]{}
        permit.value.opening = true
        start_full = true
    }
    held.opened.notify_all()
    start_full
}

// The held check of the package of `entry` cut to Core and its carrier, as
// jet_cli_debug_eval_alone cuts it for an expression that names nothing of
// it (each of its sources keeps no item, the entry its `package` block and
// an empty `run`), with the items of the sources it read
// (JetCLIDebugEvalHeldItems), and its held IR program built with the
// image's build `options`, as jet_cli_debug_eval_held_open opens the
// program's. Its stamp is the package's sources, not their cut, which seed
// the session's first ask (JetCLIDebugEvalHeldOpen.seed). Reuses the already
// held snapshot in place instead of re-reading and re-parsing disk sources.
jet_cli_debug_eval_held_cut_open: fn(entry: String, color: Bool, options: BuildOptions) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> JetCLIDebugEvalHeldOpen {
    since: debug_eval_time.unix_ns()
    ^snapshot: jet_cli_debug_eval_snapshot(entry, color) ?? return JetCLIDebugEvalHeldOpen{held: None, missed: None}
    ^stamps: jet_cli_debug_eval_stamp_pair(snapshot, since)
    stamp: stamps.stamp.move()
    seed: stamps.seed.move()
    read: jet_cli_debug_eval_digests(snapshot)
    ^entry_root: -1
    loop (idx, root) in snapshot.roots {
        if root.identity == snapshot.entry_root_identity {
            entry_root = idx
            break
        }
    }
    if entry_root < 0 -> return JetCLIDebugEvalHeldOpen{held: None, missed: Val(stamp.move())}
    picked: jet_cli_debug_eval_members(snapshot.roots[entry_root].files, snapshot.entry_path)
    if picked.len() == 0 -> return JetCLIDebugEvalHeldOpen{held: None, missed: Val(stamp.move())}
    ^paths: [String]{}
    ^sources: [String]{}
    loop row in picked {
        paths.push("{snapshot.roots[entry_root].files[row].path}")
        sources.push(snapshot.roots[entry_root].files[row].source.move())
        snapshot.roots[entry_root].files[row].source = ""
    }
    declared: jet_cli_debug_eval_declared(sources.move())
    ^cut: jet_cli_debug_eval_alone("", [NativeEvalBinder]{}, declared) ?? return JetCLIDebugEvalHeldOpen{held: None, missed: Val(stamp.move())}
    if cut.len() != picked.len() -> return JetCLIDebugEvalHeldOpen{held: None, missed: Val(stamp.move())}
    loop cut.len() > 0 {
        piece: cut.pop() ?? break
        snapshot.roots[entry_root].files[picked[cut.len()]].source = piece
    }
    prepared: jet_cli_prepare_request(snapshot.move(), color, None, JetDriverCompileMode.Check)
    compiled: jet_cli_compile_prepared(prepared, None, None, hold_check_state: true) ?? return JetCLIDebugEvalHeldOpen{held: None, missed: Val(stamp.move())}
    if compiled.move() == {
        .Refused(_) -> return JetCLIDebugEvalHeldOpen{held: None, missed: Val(stamp.move())}
        .Compiled(compile, _) -> {
            ^opened: jet_cli_debug_eval_held_of(compile.move(), stamp.move(), options)
            if opened.held.in_place() == .Val(cut_held) {
                cut_held.items = Val(JetCLIDebugEvalHeldItems{declared: declared.move(), paths: paths.move(), read: read.move()})
            }
            opened.seed = Val(seed.move())
            return opened
        }
    }
    JetCLIDebugEvalHeldOpen{held: None, missed: Val(stamp.move())}
}

// Whether the held check `held` is to be opened now
// (jet_cli_debug_eval_held_start), when it is marked opening and a stale
// one is dropped. None opens before a start says `program`, that the
// session's image records its sources, or while the cut is still opening.
jet_cli_debug_eval_held_claim: fn(held: JetCLIDebugEvalHeldShared, program: Bool{false}) -[FS]> Bool Never! {
    ^permit: held.slot.guard_edit()
    if program -> permit.value.program = true
    if !permit.value.program || permit.value.cut_opening || permit.value.opening || !jet_cli_debug_eval_held_stale(permit.value.held) || jet_cli_debug_eval_held_missed(permit.value.missed) {
        return false
    }
    permit.value.held = None
    permit.value.read = [String:[U8]]{}
    permit.value.opening = true
    true
}

priv jet_cli_debug_eval_held_prepare_argv: fn(held: JetCLIDebugEvalHeldShared, entry: String, argv: [String], color: Bool{false}) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> Never! {
    options: jet_cli_debug_eval_options(entry, argv, color: color) ?? {
        unopened: JetCLIDebugEvalHeldOpen{held: None, missed: None}
        jet_cli_debug_eval_held_done(held, unopened)
        return
    }
    jet_cli_debug_eval_held_prepare(held, entry, options, color: color)
}

// The held check of the program of `entry` opened with the image's build
// `options` (jet_cli_debug_eval_held_open) into its slot `held`. The open
// runs on a task of its own, so one that stops still ends the opening, as
// one that didn't open.
jet_cli_debug_eval_held_prepare: fn(held: JetCLIDebugEvalHeldShared, entry: String, options: BuildOptions, color: Bool{false}) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> Never! {
    opening: task jet_cli_debug_eval_held_open(entry, color, options)
    opened: opening.join() ?? JetCLIDebugEvalHeldOpen{held: None, missed: None}
    jet_cli_debug_eval_held_done(held, opened)
}

// Ends the opening of the held check `held` with the open `opened` and
// wakes the evaluations waiting for it (jet_cli_debug_eval_held_wait). An
// open that read no sources (its flags or snapshot refused) would read
// none again: no other opens until a start says `program` again.
jet_cli_debug_eval_held_done: fn(held: JetCLIDebugEvalHeldShared, opened: ^^JetCLIDebugEvalHeldOpen) Never! {
    ^permit: held.slot.guard_edit()
    if opened.held == None && opened.missed == None -> permit.value.program = false
    permit.value.held = opened.held.move()
    permit.value.missed = opened.missed.move()
    permit.value.read = opened.read.move()
    if !permit.value.asked && permit.value.seed == None -> permit.value.seed = opened.seed.move()
    permit.value.opening = false
    held.opened.notify_all()
}

// The sha256 of each source of the snapshot `snapshot` by the path an image
// built from it records the source at (BuildCache.jet
// jet_cli_source_digests).
jet_cli_debug_eval_digests: fn(snapshot: JetDriverAuthorizedSourceSnapshot) -> [String:[U8]] Never! {
    ^digests: [String:[U8]]{}
    loop source in jet_cli_source_digests(snapshot) -> digests[source.path] = source.digest
    digests
}

// Whether the digests `read`, by path, are the image's record `running`:
// the same files, each reading as it did. No record is never the same.
jet_cli_debug_eval_image_same: fn(running: [String:[U8]], read: [String:[U8]]) -> Bool Never! {
    if running.len() == 0 || running.len() != read.len() -> return false
    loop (file, digest) in read {
        was: running.get(file) ?? return false
        if was != digest -> return false
    }
    true
}

// Waits while the held check `held` opens (jet_cli_debug_eval_held_start).
jet_cli_debug_eval_held_wait: fn(held: JetCLIDebugEvalHeldShared) Never! {
    permit: held.slot.guard_edit()
    permit.wait(held.opened, fn(slot) { !slot.opening }) ?? return
}

// A held evaluation's answer (jet_cli_debug_eval_held_run) and the held
// check it leaves for the next.
JetCLIDebugEvalHeldRun: struct {
    held: JetCLIDebugEvalHeld?,
    built: NativeEval?,
    refusal: NativeEvalRefused?,
}

// An open's held check (jet_cli_debug_eval_held_open), or the sources of
// one that didn't open, the digests of the sources it read
// (jet_cli_debug_eval_digests), empty when it read none, and those sources
// as it read them, for the session's first ask (JetCLIDebugEvalHeldSlot
// seed), None when it read none.
JetCLIDebugEvalHeldOpen: struct {
    held: JetCLIDebugEvalHeld?,
    missed: JetCLIDebugEvalHeldStamp?,
    read: [String:[U8]]{[String:[U8]]{}},
    seed: JetCLIDebugEvalHeldStamp?{None},
}

// `text` as the function of the locals `params` (jet_cli_debug_eval_params)
// at the stop's source `path`, checked against the session's held check
// `shared` of the program of `entry`, built with the flags `argv`, and
// built in its held IR program: no compile of the program. A held check
// whose sources changed opens again (jet_cli_debug_eval_held_start). The
// built expression, or the debugger's refusal of an effect it uses; None,
// so the compiles answer, while the held check isn't open or didn't read
// the sources the image records it was built from, `running`
// (jet_cli_debug_eval_image_same), when no checked module is `path`'s, for
// any other refusal, a value that can fail, or a build that doesn't
// finish.
jet_cli_debug_eval_held: fn(shared: JetCLIDebugEvalHeldShared, entry: String, argv: [String], color: Bool, running: [String:[U8]], path: String, text: String, params: [NativeEvalBinder]) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> NativeEval? NativeEvalRefused! {
    jet_cli_debug_eval_held_start(shared, entry, argv, color: color)
    ^permit: shared.slot.guard_edit()
    jet_cli_debug_eval_held_in(permit.value, running, path, text, Val(params), 0, 0)
}

// The held check's answer for `text` at the stop's source `path`: of the
// locals `params` (jet_cli_debug_eval_held_run), else of the node at `line`
// and `column` (jet_cli_debug_eval_held_asked_run).
jet_cli_debug_eval_held_in: fn(slot: ^JetCLIDebugEvalHeldSlot, running: [String:[U8]], path: String, text: String, params: [NativeEvalBinder]?, line: Int, column: Int) -[FS, Env, Time, Exec.Args]> NativeEval? NativeEvalRefused! {
    if slot.opening || slot.held == None || !jet_cli_debug_eval_image_same(running, slot.read) {
        return Ok(None)
    }
    taken: jet_cli_debug_eval_held_take(slot.held.move())
    slot.held = None
    run: if params == .Val(locals) -> jet_cli_debug_eval_held_run(taken.move(), path, text, locals) else -> jet_cli_debug_eval_held_asked_run(taken.move(), path, line, column, text)
    slot.held = run.held.move()
    if run.refusal.move() == .Val(refusal) -> return Err(refusal)
    Ok(run.built.move())
}

// `text` at the node at `line` and `column` of the stop's source `path`,
// answered by the session's held check of the program (JetDriver
// jet_driver_held_eval_answer): the stopped function is checked again with
// the expression asked where the frame stopped, so it reads the frame's
// locals of any type, and what the frame moved, as the check where the
// frame stopped reads them (jet_cli_debug_eval_answer), in any frame,
// inlined or not, and no compile checks the program. Its function is then
// checked and built as jet_cli_debug_eval_held builds one. An open still
// running is waited for: it checks the program once, which takes less than
// the compiles that otherwise answer. None, so the compiles answer, as
// jet_cli_debug_eval_held, and when the stop's check refuses the
// expression, which the compiles report with its reason.
jet_cli_debug_eval_held_asked: fn(shared: JetCLIDebugEvalHeldShared, entry: String, argv: [String], running: [String:[U8]], path: String, line: Int, column: Int, text: String, color: Bool{false}) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> NativeEval? NativeEvalRefused! {
    jet_cli_debug_eval_held_start(shared, entry, argv, color: color)
    ^permit: shared.slot.guard_edit()
    permit.wait(shared.opened, fn(slot) { !slot.opening }) ?? return Ok(None)
    jet_cli_debug_eval_held_in(permit.value, running, path, text, None, line, column)
}

// `text` as the function of the locals `params` at the stop's source `path`,
// as jet_cli_debug_eval_held builds it, checked against the session's held
// check of the package's cut of `entry` (jet_cli_debug_eval_held_cut_open)
// in the module of `path`, or the entry's when the stop is in none of the
// package's sources. Its locals must be of the primitive types. Its names
// that the package's items declare must be functions of the source it is
// checked in, which the cut gains first with the functions they reach
// (jet_cli_debug_eval_held_append) while the image is the cut's sources
// built at O0 (`running`, as jet_cli_debug_eval_held takes it); its other
// names are Core's, a field, or a local of a function it makes. None, so
// the held check of the program or the compiles answer, as
// jet_cli_debug_eval_held, and when the cut can't gain what it names. A
// cut still opening is waited for: it checks only Core and the package's
// carrier, which takes less than a compile of the expression would.
jet_cli_debug_eval_held_cut: fn(shared: JetCLIDebugEvalHeldShared, entry: String, running: [String:[U8]], path: String, text: String, params: [NativeEvalBinder]) -[FS, Env, Time, Exec.Args]> NativeEval? NativeEvalRefused! {
    if !jet_cli_debug_eval_alone_types(params) -> return Ok(None)
    ^permit: shared.slot.guard_edit()
    permit.wait(shared.opened, fn(slot) { !slot.cut_opening }) ?? return Ok(None)
    jet_cli_debug_eval_held_cut_in(permit.value, entry, running, path, text, params)
}

// Waits while the held check of the package's cut `held` opens
// (jet_cli_debug_eval_held_start).
jet_cli_debug_eval_held_cut_wait: fn(held: JetCLIDebugEvalHeldShared) Never! {
    permit: held.slot.guard_edit()
    permit.wait(held.opened, fn(slot) { !slot.cut_opening }) ?? return
}

jet_cli_debug_eval_held_cut_in: fn(slot: ^JetCLIDebugEvalHeldSlot, entry: String, running: [String:[U8]], path: String, text: String, params: [NativeEvalBinder]) -[FS, Env, Time, Exec.Args]> NativeEval? NativeEvalRefused! {
    if slot.cut_opening || slot.cut == None -> return Ok(None)
    ^taken: jet_cli_debug_eval_held_take(slot.cut.move())
    slot.cut = None
    ^gained: false
    if taken.in_place() == .Val(current) {
        gained = jet_cli_debug_eval_held_append(current, running, path, text, params)
    }
    if !gained {
        slot.cut = taken.move()
        return Ok(None)
    }
    run: jet_cli_debug_eval_held_run(taken.move(), path, text, params, otherwise: entry)
    slot.cut = run.held.move()
    if run.refusal.move() == .Val(refusal) -> return Err(refusal)
    Ok(run.built.move())
}

// Gains the held check of the package's cut `held` the functions of the
// source `text` is checked in (the stop's `path`, else the entry) that
// `text`, an expression of the locals `params`, names, with the functions
// they reach (jet_cli_debug_eval_held_reach), each after those it calls
// and once a session: each is appended to its check (JetDriver
// jet_driver_held_eval_append) and its held IR program (JetIR
// ir_held_append), whose build calls the image's code of it. Whether the
// check takes `text`: it names nothing of the package but its locals, or
// the functions reached are gained, which takes the cut's sources being
// the image's record `running` (jet_cli_debug_eval_image_same) and an
// image built at O0, which binds its functions.
jet_cli_debug_eval_held_append: fn(held: ^JetCLIDebugEvalHeld, running: [String:[U8]], path: String, text: String, params: [NativeEvalBinder]) -> Bool {
    locals: loop param in params -> param.name
    ^wanted: [String]{}
    loop name in native_eval_names(text) {
        if !locals.contains(name) -> wanted.push(name)
    }
    // The source the expression checks in, the functions it reaches there
    // that the cut lacks, and each one's code.
    ^file: 0
    ^source: ""
    ^names: [String]{}
    ^codes: [String]{}
    if {
        held.items == .Val(items) -> {
            host: jet_cli_debug_eval_host(items.paths, path) ?? return false
            if host > 0 -> file = host
            source = "{items.paths[file]}"
            order: jet_cli_debug_eval_held_reach(items.declared, file, wanted) ?? return false
            if order.len() > 0 && (held.ir.level > 0 || !jet_cli_debug_eval_image_same(running, items.read)) {
                return false
            }
            loop slot in order {
                item: items.declared.files[file][items.declared.rows[slot]]
                if items.appended.has_key(item.name) -> next
                names.push(item.name)
                codes.push(jet_cli_debug_eval_item_code(items.declared.sources[file], items.declared.files[file], items.declared.rows[slot]))
            }
        }
        else -> { return wanted.len() == 0 }
    }
    if names.len() == 0 -> return true
    display: jet_cli_debug_eval_held_module(held.eval, source)
    if display == "" -> return false
    loop (at, code) in codes {
        done: jet_driver_held_eval_append(held.eval, display, held.ir.program.functions, held.ir.program.symbols.move(), held.ir.program.interner.move(), held.ir.program.types.move(), code)
        held.ir.program.symbols = done.symbols.move()
        held.ir.program.interner = done.interner.move()
        held.ir.program.types = done.types.move()
        appended: done.appended.move() ?? return false
        key: "{appended.function.key}"
        row: ir_held_append(held.ir.program, appended.function.move(), appended.decl, code)
        sema_eval_held_set(held.eval.rows, key, row)
        if held.items.in_place() == .Val(items) -> items.appended[names[at]] = true
    }
    true
}

// The functions of source `file` of `declared` that the names `wanted`
// reach, by their slots (JetCLIDebugEvalDeclared.index), each after those
// it reaches: the functions the names declare and, in turn, those the
// names of each one's code declare. A name no item declares (a local, a
// field, Core's) reaches nothing. None when a name reached is declared by
// two sources, by an item other than a function of `file`, by its entry's
// `run`, or by a `use` block of `file`, when the sources may use a function
// reached as a value (JetCLIDebugEvalDeclared.valued), or when a function
// reaches itself through another: the cut gains none of those.
jet_cli_debug_eval_held_reach: fn(declared: JetCLIDebugEvalDeclared, file: Int, wanted: [String]) -> [Int]? Never! {
    ^imported: [String]{}
    loop at in declared.imports[file] {
        loop name in jet_cli_debug_eval_item_names(jet_cli_debug_eval_item_code(declared.sources[file], declared.files[file], at)) {
            if name != "use" -> imported.push(name)
        }
    }
    // Each slot visited: false while those it reaches are, true once placed.
    ^placed: [Int:Bool]{}
    ^order: [Int]{}
    loop name in wanted {
        if !jet_cli_debug_eval_held_visit(declared, file, imported, name, placed, order) {
            return None
        }
    }
    Val(order.move())
}

// Places the function `name` declares and those it reaches in `order`
// (jet_cli_debug_eval_held_reach), `placed` the slots visited. Whether it
// can be.
jet_cli_debug_eval_held_visit: fn(declared: JetCLIDebugEvalDeclared, file: Int, imported: [String], name: String, placed: ^[Int:Bool], order: ^[Int]) -> Bool Never! {
    if imported.contains(name) -> return false
    slot: declared.index.get(name) ?? return true
    if slot < 0 -> return false
    if placed.get(slot) == .Val(done) -> return done
    if declared.owners[slot] != file -> return false
    row: declared.rows[slot]
    item: declared.files[file][row]
    if !item.function || item.name == "run" || declared.valued.has_key(name) -> return false
    placed[slot] = false
    // Its own name, its header's, is no call: a call of itself doesn't check
    // (JetSema sema_script_probe_append).
    loop more in jet_cli_debug_eval_item_names(jet_cli_debug_eval_item_code(declared.sources[file], declared.files[file], row)) {
        if more != name && !jet_cli_debug_eval_held_visit(declared, file, imported, more, placed, order) {
            return false
        }
    }
    placed[slot] = true
    order.push(slot)
    true
}

// The held check `held`, moved out of its slot: an argument moved from
// borrowed storage stays shared with it until the slot is written, so the
// slot is emptied before the evaluation writes, which would copy every
// function of the held program.
jet_cli_debug_eval_held_take: fn(held: ^^JetCLIDebugEvalHeld?) -> JetCLIDebugEvalHeld? Never! {
    held
}

// The held check `held`'s answer for `text` at the stop's source `path`,
// checked in the module of `path`, else of `otherwise` ("": none).
jet_cli_debug_eval_held_run: fn(held: ^^JetCLIDebugEvalHeld?, path: String, text: String, params: [NativeEvalBinder], otherwise: String{""}) -[FS, Env, Time, Exec.Args]> JetCLIDebugEvalHeldRun {
    current: held.move() ?? return JetCLIDebugEvalHeldRun{held: None, built: None, refusal: None}
    ^display: jet_cli_debug_eval_held_module(current.eval, path)
    if display == "" && otherwise != "" {
        display = jet_cli_debug_eval_held_module(current.eval, otherwise)
    }
    if display == "" {
        return JetCLIDebugEvalHeldRun{held: Val(current.move()), built: None, refusal: None}
    }
    typed: loop param in params -> "{param.name}: {param.type_name}"
    source: "{JET_CLI_DEBUG_EXPRESSION}: fn({typed.join(", ")}) {{\n    ^_: {text}\n}}\n"
    names: loop param in params -> param.name
    jet_cli_debug_eval_held_build(current.move(), display, source, names, None, text)
}

// The held check `held`'s answer for `text` at the node at `line` and
// `column` of the stop's source `path` (jet_cli_debug_eval_held_asked): the
// expression's function the stop's check makes of it
// (sema_eval_probe_function), whose parameters are the locals it reads.
// None, so the compiles answer, when `path` is no checked module's or none
// of the sources the check read, or the stop's check refuses the
// expression, which the check where the frame stopped reports with its
// reason (jet_cli_debug_eval_answer), or it has no value or one that can
// fail.
jet_cli_debug_eval_held_asked_run: fn(held: ^^JetCLIDebugEvalHeld?, path: String, line: Int, column: Int, text: String) -[FS, Env, Time, Exec.Args]> JetCLIDebugEvalHeldRun {
    ^current: held.move() ?? return JetCLIDebugEvalHeldRun{held: None, built: None, refusal: None}
    display: jet_cli_debug_eval_held_module(current.eval, path)
    source: jet_cli_debug_eval_held_source(current.stamp, path)
    offset: jet_cli_debug_eval_offset(source, line, column) ?? -1
    if display == "" || source == "" || offset < 0 {
        return JetCLIDebugEvalHeldRun{held: Val(current.move()), built: None, refusal: None}
    }
    asked: jet_driver_held_eval_answer(current.eval, display, offset, text, current.ir.program.symbols.move(), current.ir.program.interner.move(), current.ir.program.types.move())
    current.ir.program.symbols = asked.symbols.move()
    current.ir.program.interner = asked.interner.move()
    current.ir.program.types = asked.types.move()
    answer: asked.answer.move() ?? return JetCLIDebugEvalHeldRun{held: Val(current.move()), built: None, refusal: None}
    value: answer.value_type ?? return JetCLIDebugEvalHeldRun{held: Val(current.move()), built: None, refusal: None}
    if !answer.complete || answer.refusals.len() > 0 || value == .Result(_, _) {
        return JetCLIDebugEvalHeldRun{held: Val(current.move()), built: None, refusal: None}
    }
    function: sema_eval_probe_function(answer, text, JET_CLI_DEBUG_EXPRESSION) ?? return JetCLIDebugEvalHeldRun{held: Val(current.move()), built: None, refusal: None}
    names: loop capture in answer.captures -> capture.source
    ^run: jet_cli_debug_eval_held_build(current.move(), display, function, names, Val(value), text)
    // A lent name's result is the stopped frame's own value
    // (SemaEvalProbeAnswer.lent): the session drops nothing of it.
    if answer.lent {
        if run.built.in_place() == .Val(code) -> code.drop = ""
    }
    run
}

// `source`, the expression `text`'s function, checked by the held check
// `held` in its module of the display path `display` and built in its held
// IR program, its parameters read as the locals `names`. Its result is a
// `value`, which it returns; with none, the value it discards
// (jet_cli_debug_eval_held_value), which it is made to return. None for the
// built expression when the check or the build doesn't finish or the value
// can fail; the debugger's refusal of an effect it uses.
jet_cli_debug_eval_held_build: fn(held: ^^JetCLIDebugEvalHeld, display: String, source: String, names: [String], value: Type?, text: String) -[FS, Env, Time, Exec.Args]> JetCLIDebugEvalHeldRun {
    ^current: held.move()
    done: jet_driver_held_eval_check(current.eval, display, current.ir.program.functions, current.ir.program.symbols.move(), current.ir.program.interner.move(), current.ir.program.types.move(), source)
    current.ir.program.symbols = done.symbols.move()
    current.ir.program.interner = done.interner.move()
    current.ir.program.types = done.types.move()
    loop report in done.checked.diagnostics {
        if report.what.starts_with(JET_CLI_DEBUG_EVAL_REFUSAL) {
            return JetCLIDebugEvalHeldRun{held: Val(current.move()), built: None, refusal: Val(jet_cli_debug_eval_refused(report.what.slice(JET_CLI_DEBUG_EVAL_REFUSAL.len()..<report.what.len())))}
        }
    }
    if !done.checked.complete || jet_driver_check_failures(done.checked.diagnostics).len() > 0 {
        return JetCLIDebugEvalHeldRun{held: Val(current.move()), built: None, refusal: None}
    }
    ^function: done.checked.function.move() ?? return JetCLIDebugEvalHeldRun{held: Val(current.move()), built: None, refusal: None}
    returned: jet_cli_debug_eval_held_returned(current.ir.program.interner, function, value) ?? return JetCLIDebugEvalHeldRun{held: Val(current.move()), built: None, refusal: None}
    key: "{function.key}"
    // The open's memory term stands: the held program is already in memory
    // and an evaluation adds one function and what it reaches, so it reads
    // the host's memory only once a session, not at each evaluation.
    threads: CompilerThreads{cap: current.ir.threads.cap, cores: current.ir.threads.cores, memory_available: current.ir.threads.memory_available}
    rooted: ir_build_held_root(current.ir.program.move(), function.move(), source, threads)
    current.ir.program = rooted.program.move()
    built: jet_cli_debug_eval_held_lower(current.ir, rooted.result.move(), key, names, returned, text, threads) ?? return JetCLIDebugEvalHeldRun{held: Val(current.move()), built: None, refusal: None}
    JetCLIDebugEvalHeldRun{held: Val(current.move()), built: Val(built), refusal: None}
}

// The value the held check's expression function `function` returns: a
// `value` it returns, when it can't fail; with none, the value it discards,
// made its result (jet_cli_debug_eval_returns). None when it can't return
// either.
jet_cli_debug_eval_held_returned: fn(interner: Interner, function: ^FnBody, value: Type?) -> Type? Never! {
    if value == .Val(given) {
        if function.failure_carrier == {
            .Infallible -> return Val(given)
            .Result(_, _) | .Optional(_) | .Diverges(_) -> return None
        }
    }
    discarded: jet_cli_debug_eval_held_value(interner, function) ?? return None
    if discarded == .Result(_, _) || !jet_cli_debug_eval_returns(function, discarded) -> return None
    Val(discarded)
}

// The text of the source `path` as the held check `stamp` read it, the
// longest of its paths that names it (jet_cli_debug_eval_held_module); ""
// for none.
jet_cli_debug_eval_held_source: fn(stamp: JetCLIDebugEvalHeldStamp, path: String) -> String Never! {
    ^named: ""
    ^found: ""
    loop (file, source) in stamp.sources {
        if file.len() > named.len() && debug_eval_path_same(file, path) {
            named = "{file}"
            found = "{source}"
        }
    }
    found
}

// The held check `eval`'s checked module of the source `path`, the longest
// that names it (`util.jet` names `a/util.jet` too); "" for none.
jet_cli_debug_eval_held_module: fn(eval: JetDriverHeldEval, path: String) -> String Never! {
    ^display: ""
    loop id in 1..<name_count(eval.module_files) {
        file: name_text(eval.module_files, Name{id: U32{id}})
        if file.len() > display.len() && debug_eval_path_same(file, path) -> display = file
    }
    display
}

// The type of the value the held check's expression function discards
// (`^_: text`), its last statement; None when that is not the discard.
jet_cli_debug_eval_held_value: fn(interner: Interner, function: FnBody) -> Type? Never! {
    if function.body.len() == 0 -> return None
    row: function.body[function.body.len() - 1] - function.tree.stmt_base
    if function.tree.stmts[row] == .Let(_, _, init, _, _, _) {
        return Val(body_type(interner, function.tree, init))
    }
    if function.tree.stmts[row] == .ExprStmt(discarded, _) {
        return Val(body_type(interner, function.tree, discarded))
    }
    None
}

// The held check of the program of `entry` (a check that holds its compile
// state) and its held IR program built with the image's build `options`; or
// the sources it read, when the check doesn't finish clean or the
// runtime's exports can't be read. Either way, with their digests.
jet_cli_debug_eval_held_open: fn(entry: String, color: Bool, options: BuildOptions) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> JetCLIDebugEvalHeldOpen {
    since: debug_eval_time.unix_ns()
    compiled: jet_cli_compile_entry(entry, color, None, JetDriverCompileMode.Check, None, None, hold_check_state: true) ?? return JetCLIDebugEvalHeldOpen{held: None, missed: None}
    if compiled.move() == {
        .Refused(_) -> return JetCLIDebugEvalHeldOpen{held: None, missed: None}
        .Compiled(compile, snapshot) -> {
            ^stamps: jet_cli_debug_eval_stamp_pair(snapshot, since)
            ^opened: jet_cli_debug_eval_held_of(compile.move(), stamps.stamp.move(), options)
            opened.read = jet_cli_debug_eval_digests(snapshot)
            opened.seed = Val(stamps.seed.move())
            return opened
        }
    }
    JetCLIDebugEvalHeldOpen{held: None, missed: None}
}

// The held check the check `compile`, which held its compile state, leaves,
// and its held IR program built with the image's build `options`, opened
// from the sources `stamp`; or those sources, when the check didn't finish
// clean or the runtime's exports can't be read.
jet_cli_debug_eval_held_of: fn(compile: ^^JetDriverCompileResult, stamp: ^^JetCLIDebugEvalHeldStamp, options: BuildOptions) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> JetCLIDebugEvalHeldOpen {
    ^result: compile.move()
    if jet_driver_check_failures(result.diagnostics).len() > 0 || result.internal_problem != None || !result.complete {
        return JetCLIDebugEvalHeldOpen{held: None, missed: Val(stamp.move())}
    }
    state: result.held.move() ?? return JetCLIDebugEvalHeldOpen{held: None, missed: Val(stamp.move())}
    result.held = None
    runtime: jet_cli_runtime_exports(jet_cli_runtime_dir())
    if runtime.failure != None {
        return JetCLIDebugEvalHeldOpen{held: None, missed: Val(stamp.move())}
    }
    opened: jet_driver_held_eval_open(state.move(), result.compiler_threads) ?? return JetCLIDebugEvalHeldOpen{held: None, missed: Val(stamp.move())}
    graph: opened.eval.probe.program.registration_graph
    ir: jet_cli_debug_eval_held_ir(result, opened.inputs.move(), graph.decls, opened.types.move(), options, runtime)
    JetCLIDebugEvalHeldOpen{held: Val(JetCLIDebugEvalHeld{eval: opened.eval.move(), ir: ir.move(), stamp: stamp.move()}), missed: None}
}

// Whether the held check `held` is to be opened again: there is none, or
// its sources changed (jet_cli_debug_eval_held_change).
jet_cli_debug_eval_held_stale: fn(held: JetCLIDebugEvalHeld?) -[FS]> Bool {
    open: held ?? return true
    jet_cli_debug_eval_held_change(open.stamp) != None
}

// Whether the held check that last didn't open, from the sources `missed`,
// would read the same sources now.
jet_cli_debug_eval_held_missed: fn(missed: JetCLIDebugEvalHeldStamp?) -[FS]> Bool {
    stamp: missed ?? return false
    jet_cli_debug_eval_held_change(stamp) == None
}

// The path of a source file of `stamp` that reads other than it did or no
// longer reads; None when each reads the same. A file whose identity is
// still its stamped one isn't read.
jet_cli_debug_eval_held_change: fn(stamp: JetCLIDebugEvalHeldStamp) -[FS]> String? {
    loop (file, source) in stamp.sources {
        if stamp.keys.get(file) == .Val(key) {
            if debug_eval_files.stat(file) == .Ok(found) {
                if jet_cli_identity_key("file", found) == key -> next
            }
        }
        now: debug_eval_files.read(file) ?? return Val(file)
        if now != source -> return Val(file)
    }
    None
}

priv JetCLIDebugEvalStampPair: struct {
    stamp: JetCLIDebugEvalHeldStamp,
    seed: JetCLIDebugEvalHeldStamp,
}

// Two identical stamps of `snapshot` built with one stat per file.
priv jet_cli_debug_eval_stamp_pair: fn(snapshot: JetDriverAuthorizedSourceSnapshot, since: Int) -[FS]> JetCLIDebugEvalStampPair Never! {
    ^sources_a: [String:String]{}
    ^sources_b: [String:String]{}
    ^keys_a: [String:String]{}
    ^keys_b: [String:String]{}
    loop root in snapshot.roots {
        loop file in root.files {
            sources_a["{file.path}"] = file.source
            sources_b["{file.path}"] = file.source
            found: debug_eval_files.stat(file.path) ?? next
            written: found.modified.to_unix_ns() ?? next
            if written < since - JET_CLI_DEBUG_EVAL_RACY_NS && jet_cli_identity_key("file", found) == file.identity {
                keys_a["{file.path}"] = file.identity
                keys_b["{file.path}"] = file.identity
            }
        }
    }
    JetCLIDebugEvalStampPair{
        stamp: JetCLIDebugEvalHeldStamp{sources: sources_a.move(), keys: keys_a.move()},
        seed: JetCLIDebugEvalHeldStamp{sources: sources_b.move(), keys: keys_b.move()},
    }
}

// The sources of the snapshot `snapshot`, read no earlier than the time
// `since` (unix_ns): each file's text by its path, and the identity of each
// that still has the one it was read with and wasn't written within
// JET_CLI_DEBUG_EVAL_RACY_NS of `since`.
jet_cli_debug_eval_stamp: fn(snapshot: JetDriverAuthorizedSourceSnapshot, since: Int) -[FS]> JetCLIDebugEvalHeldStamp Never! {
    ^sources: [String:String]{}
    ^keys: [String:String]{}
    loop root in snapshot.roots {
        loop file in root.files {
            sources["{file.path}"] = file.source
            found: debug_eval_files.stat(file.path) ?? next
            written: found.modified.to_unix_ns() ?? next
            if written < since - JET_CLI_DEBUG_EVAL_RACY_NS && jet_cli_identity_key("file", found) == file.identity {
                keys["{file.path}"] = file.identity
            }
        }
    }
    JetCLIDebugEvalHeldStamp{sources: sources.move(), keys: keys.move()}
}

// Whether the program of `entry` reads as it did when the session `held`
// last asked (NativeEvaluator.unchanged): its sources then, `kept`, each
// read the same now. The first ask takes the sources as an open of the
// session's held checks read them (`seed`) while each reads the same, so
// it reads no snapshot of its own: no code is kept before it. Otherwise
// the first ask, and one that finds them changed, keeps the sources as
// they read now; none are kept while they can't be read, and every ask is
// then a change.
jet_cli_debug_eval_unchanged: fn(held: JetCLIDebugEvalHeldShared, entry: String) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> Bool Never! {
    ^permit: held.slot.guard_edit()
    jet_cli_debug_eval_unchanged_in(permit.value, entry)
}

jet_cli_debug_eval_unchanged_in: fn(slot: ^JetCLIDebugEvalHeldSlot, entry: String) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> Bool Never! {
    if slot.kept == .Val(kept) {
        if jet_cli_debug_eval_held_change(kept) == None -> return true
    }
    slot.kept = None
    if !slot.asked {
        slot.asked = true
        if slot.seed == .Val(read) {
            if jet_cli_debug_eval_held_change(read) == None {
                slot.kept = jet_cli_debug_eval_stamp_take(slot.seed.move())
                slot.seed = None
                return true
            }
        }
        slot.seed = None
    }
    since: debug_eval_time.unix_ns()
    snapshot: jet_cli_debug_eval_snapshot(entry, false) ?? return false
    slot.kept = Val(jet_cli_debug_eval_stamp(snapshot, since))
    false
}

// The stamp `stamp`, moved out of its slot, as jet_cli_debug_eval_held_take
// moves a held check: the slot is emptied next, which would otherwise copy
// the source texts it holds.
jet_cli_debug_eval_stamp_take: fn(stamp: ^^JetCLIDebugEvalHeldStamp?) -> JetCLIDebugEvalHeldStamp? Never! {
    stamp
}

// The built module `built`'s function `key`, the expression's, with the
// entry that calls it, its parameters read as the locals `names` and its
// result a `value`, lowered to the code the session places.
jet_cli_debug_eval_native: fn(built: ^^IRModule, key: String, names: [String], value: Type, text: String, threads: CompilerThreads) -[FS, Time]> NativeEval NativeEvalRefused! {
    ^program: built.move()
    row: name_column_get(program.function_rows_keys, program.function_rows, key) ?? return Err(jet_cli_debug_eval_refused("the built program has no function for it"))
    refusal: ir_eval_place_refusal(program, row)
    ^params: [Int]{}
    ^captures: [NativeEvalPart]{}
    loop slot in 0..<program.functions[row].param_count {
        ty: program.functions[row].slot_type[slot]
        params.push(ty)
        name: if slot < names.len() -> names[slot] else -> ""
        slot_kind: program.types[ty].kind
        captures.push(NativeEvalPart{name: name, size: program.types[ty].size, inline: slot_kind == IRTypeKind.Aggregate, word: jet_cli_debug_eval_word(slot_kind)})
    }
    result_row: program.functions[row].result
    if result_row < 0 || program.types[result_row].kind == IRTypeKind.Unit {
        return Err(jet_cli_debug_eval_refused("`{text}` has no value"))
    }
    // A function the failure solve found can fail returns its carrier,
    // which names the result with its error spelled, `Int ParseError!` or
    // `Int Err!`: as `Int` it would read the carrier's box as the Int.
    carried: ir_untag(ir_module_row_ty(program, result_row))
    shown: if carried == .Result(_, _) -> carried else -> value
    kind: program.types[result_row].kind
    part: NativeEvalPart{name: type_failure_name(type_unqualified_nominals(shown)), size: program.types[result_row].size, inline: kind == IRTypeKind.Aggregate, ty: result_row, word: jet_cli_debug_eval_word(kind)}
    pointer: ir_pointer_row(program)
    wrapper: jet_eval_native_wrapper(program, JET_CLI_DEBUG_EVAL_ENTRY, row, params, result_row, pointer, loads: true, table: params.len() > NATIVE_EVAL_CAPTURES)
    added: jet_eval_native_add(program, wrapper)
    program.kept.push(added)
    // A result that holds references gives them back once the session has
    // read it.
    drop: if program.types[result_row].drop != "" -> JET_CLI_DEBUG_EVAL_DROP else -> ""
    if drop != "" -> program.kept.push(ir_cell_drop(program, drop, result_row))
    selected: ir_x64_compile_module_logged(program, threads, [String]{})
    if selected.errors.len() > 0 {
        return Err(jet_cli_debug_eval_refused("the compiler couldn't build it: {selected.errors[0]}"))
    }
    lowered: ir_x64_debug_program(selected)
    if lowered.errors.len() > 0 {
        return Err(jet_cli_debug_eval_refused("the compiler couldn't build it: {lowered.errors[0]}"))
    }
    edit: NativeFixEdit{object: lowered.program.move(), functions: lowered.functions.move(), debug: lowered.debug.move()}
    Ok(NativeEval{text: text, edit: edit, entry: JET_CLI_DEBUG_EVAL_ENTRY, captures: captures, result: part, refusal: refusal, drop: drop})
}

// How the checker checks `text` at byte `offset` of `path` in the program of
// `entry`, compiled with the session's Core binding `core_bound`: the answer
// of the function there, or why it can't be evaluated (the first refusal,
// which names an effect it uses).
jet_cli_debug_eval_answer: fn(entry: String, color: Bool, options: BuildOptions, path: String, offset: Int, line: Int, text: String, core_bound: Bool?{None}) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> SemaEvalProbeAnswer NativeEvalRefused! {
    ^answers: [SemaEvalProbeAnswer]{}
    asked: if jet_cli_debug_eval_prepare(entry, color, path, None) == {
        .Refused(output) -> JetCLIPrepared.Refused{output: output}
        .Prepared(request, snapshot) -> {
            ^held: request
            held.eval_ask = Val(JetDriverEvalAsk{path: path, offset: offset, text: text})
            JetCLIPrepared.Prepared{request: held, snapshot: snapshot}
        }
    }
    compiled: jet_cli_compile_executable(asked, None, options, None, None, color, core_bound: core_bound) ?? return Err(jet_cli_debug_eval_refused("the compiler stopped before finishing the program"))
    if compiled.move() == {
        .Refused(refusal) -> return Err(jet_cli_debug_eval_refused("the program doesn't compile now: {refusal.stderr.trim()}"))
        .Checked(result, _, _) -> {
            failures: jet_driver_check_failures(result.diagnostics)
            if failures.len() > 0 {
                return Err(jet_cli_debug_eval_refused("the program doesn't compile now: {failures[0].what}"))
            }
            answers = result.eval_answers.move()
        }
    }
    ^chosen: SemaEvalProbeAnswer?{None}
    loop answer in answers.move() {
        if chosen == None || answer.exact -> chosen = Val(answer)
    }
    answer: chosen ?? return Err(jet_cli_debug_eval_refused("no Jet function holds {path}:{line}"))
    if answer.refusals.len() > 0 {
        what: answer.refusals[0].what
        shown: if what.starts_with(JET_CLI_DEBUG_EVAL_REFUSAL) -> what.slice(JET_CLI_DEBUG_EVAL_REFUSAL.len()..<what.len()) else -> "the compiler refused it: {what}"
        return Err(jet_cli_debug_eval_refused(shown))
    }
    if answer.value_type == None -> return Err(jet_cli_debug_eval_refused("`{text}` has no value"))
    Ok(answer)
}

// The request that compiles the program of `entry` with the stop's source
// `path` reading `source` (None: as it reads), and the sources `others` in
// place of their files, as overlays a debugger's expression appends to
// (jet_cli_prepare_snapshot `appended`). The source the expression is
// appended to lowers whole (JetDriverCompileRequest.rooted_source): no body
// calls the expression, and a path dependency's bodies lower only when
// reached. A Core source (jet_cli_debug_core_row) is no file of the
// program: its Core row reads `source` as the Core source under test
// (JetDriverCompileRequest core_tests), which the compile reads whole, its
// functions' bodies checked and kept for the build, as a `jet test` of it
// does.
jet_cli_debug_eval_prepare: fn(entry: String, color: Bool, path: String, source: String?, others: ^^[JetDriverSourceDocument]{[JetDriverSourceDocument]{}}) -> JetCLIPrepared {
    row: jet_cli_debug_core_row(path)
    if row == "" {
        ^overlays: [JetDriverSourceDocument]{}
        if source == .Val(text) -> overlays.push(JetDriverSourceDocument{path: path, source: text})
        overlays.extend(others)
        ^prepared: jet_cli_prepare_overlays(entry, entry, overlays, color, None, JetDriverCompileMode.Program, appended: true)
        if source != None && prepared.in_place() == .Prepared(request, _) {
            request.rooted_source = jet_cli_overlay_path(path)
        }
        return prepared
    }
    if jet_cli_prepare_snapshot(entry, entry, others, color, appended: true) == {
        .Refused(output) -> JetCLIPrepared.Refused{output: output}
        .Held(snapshot) -> jet_cli_prepare_request(snapshot, color, None, JetDriverCompileMode.Program, core_tests: row, core_tested_source: source)
    }
}

// The text of the stop's source `path` (JetDebug native_line_source) in the
// program of `entry`: a Core source's is its row's in the Core that program
// compiles with, its toolchain tree's or the one built into jet
// (jet_cli_core_sources), never a file under the working directory; any
// other source's is its file's.
jet_cli_debug_source_text: fn(entry: String, path: String) -[FS, Env]> String NativeEvalRefused! {
    row: jet_cli_debug_core_row(path)
    if row == "" {
        return Ok(debug_eval_files.read(path) ?? return Err(jet_cli_debug_eval_refused("couldn't read `{path}`: {err}")))
    }
    sources: if jet_cli_core_sources(entry) == {
        .Loaded(loaded) -> loaded
        .Missing(what, _) -> {
            return Err(jet_cli_debug_eval_refused(what))
        }
    }
    loop unit in sources {
        if unit.path == row -> return Ok(unit.source())
    }
    Err(jet_cli_debug_eval_refused("the Core this program compiles with has no `{row}`"))
}

// The Core row (`Core/Net/URL.jet`) of the stop's source `path` when it is
// a Core source, under the Core root (`<corelib>/Core/Net/URL.jet`); "" for
// any other.
jet_cli_debug_core_row: fn(path: String) -> String Never! {
    if !path.starts_with(MODULE_CORE_PREFIX) -> return ""
    path.slice(MODULE_CORE_PREFIX.len()..<path.len())
}

// Whether the checked source file `source` is `path`, the line table's: the
// same path, or one is the other's trailing components, either without its
// leading `./` and `../` components (an image built where it is debugged
// records its entry under the compilation directory `.`, a snapshot's
// sources are absolute, and its checked sources are relative to the entry's
// root, so a path dependency's lie under `../`).
debug_eval_path_same: fn(source: String, path: String) -> Bool Never! {
    plain_source: debug_eval_path_plain(source)
    plain_path: debug_eval_path_plain(path)
    plain_source == plain_path || plain_source.ends_with("/{plain_path}") || plain_path.ends_with("/{plain_source}")
}

// `path` without its leading `./` and `../` components.
debug_eval_path_plain: fn(path: String) -> String Never! {
    ^at: 0
    loop {
        rest: path.slice(at..<path.len())
        if {
            rest.starts_with("./") -> at += 2
            rest.starts_with("../") -> at += 3
            else -> break
        }
    }
    path.slice(at..<path.len())
}

#Test("a line table's path under the compilation directory `.` is the snapshot's absolute source") {
    assert(debug_eval_path_same("/work/prog.jet", "./prog.jet"))
    assert(debug_eval_path_same("/work/lib/step.jet", "././lib/step.jet"))
    assert(debug_eval_path_same("prog.jet", "/work/prog.jet"))
    assert(!debug_eval_path_same("/work/prog.jet", "./other.jet"))
    assert(!debug_eval_path_same("/work/myprog.jet", "./prog.jet"))
}

#Test("a path dependency's checked source beside the entry's root is the stop's absolute source") {
    assert(debug_eval_path_same("../lib/lib.jet", "/work/pkgs/lib/lib.jet"))
    assert(debug_eval_path_same("../../tools/lib/lib.jet", "/work/tools/lib/lib.jet"))
    assert(!debug_eval_path_same("../lib/lib.jet", "/work/pkgs/mylib/lib.jet"))
    assert(!debug_eval_path_same("../lib/lib.jet", "/work/pkgs/app/lib.jet"))
}

#Test("a stop's Core source is its Core row, never a file under the working directory") {
    assert_eq(jet_cli_debug_core_row("<corelib>/Core/Net/URL.jet"), "Core/Net/URL.jet")
    assert_eq(jet_cli_debug_core_row("./prog.jet"), "")
    assert_eq(jet_cli_debug_core_row("./<corelib>/Core/Net/URL.jet"), "")
}

#Test("an evaluated expression starts at its line's first byte, or at the call's column") {
    assert_eq(jet_cli_debug_eval_offset("a\n    b: 1\n", 2, 0), Val(6))
    assert_eq(jet_cli_debug_eval_offset("a\n\tb\n", 2, 0), Val(3))
    assert_eq(jet_cli_debug_eval_offset("a\n", 1, 0), Val(0))
    assert_eq(jet_cli_debug_eval_offset("a", 3, 0), None)
    assert_eq(jet_cli_debug_eval_offset("a\n    loop v in xs.map(f)\n", 2, 15), Val(16))
    assert_eq(jet_cli_debug_eval_offset("é = f(x)\n", 1, 5), Val(5))
    assert_eq(jet_cli_debug_eval_offset("ab\n", 1, 4), None)
}

#Test("an expression of primitive locals only compiles with its entry's package carrier and an empty run") {
    total: NativeEvalBinder{name: "total", type_name: "Int", live: true}
    seen: NativeEvalBinder{name: "seen", type_name: "Bool", live: true}
    point: NativeEvalBinder{name: "point", type_name: "Point", live: true}
    loose: jet_cli_debug_eval_declared([String]{"use helpers\n\nf_1: fn(n: Int) -> Int {{\n    n + 1\n}}\n"})
    assert_eq(jet_cli_debug_eval_alone("total + 2", [NativeEvalBinder]{total}, loose), Val([String]{"run: fn() {{}}"}))
    assert_eq(jet_cli_debug_eval_alone("seen && total > 3", [NativeEvalBinder]{seen, total}, loose), Val([String]{"run: fn() {{}}"}))
    assert_eq(jet_cli_debug_eval_alone("f_1(total)", [NativeEvalBinder]{total}, loose), None)
    assert_eq(jet_cli_debug_eval_alone("point", [NativeEvalBinder]{point}, loose), None)
    carried: jet_cli_debug_eval_declared([String]{"package: {{\n    name: \"demo\"\n}}\n\nrun: fn() {{\n    f_1(1)\n}}\n", "use helpers\n\nf_1: fn(n: Int) -> Int {{\n    n + 1\n}}\n"})
    assert_eq(jet_cli_debug_eval_alone("total + 2", [NativeEvalBinder]{total}, carried), Val([String]{"package: {{\n    name: \"demo\"\n}}\n\nrun: fn() {{}}", ""}))
}

#Test("an expression that calls the entry's functions compiles with the functions it reaches and the use blocks they name, at their lines") {
    total: NativeEvalBinder{name: "total", type_name: "Int", live: true}
    loose: jet_cli_debug_eval_declared([String]{"use helpers\n\nf_1: fn(n: Int) -> Int {{\n    n + 1\n}}\n"})
    assert_eq(jet_cli_debug_eval_alone("f_1(total)", [NativeEvalBinder]{total}, loose, functions: true), Val([String]{"\n\nf_1: fn(n: Int) -> Int {{\n    n + 1\n}}\nrun: fn() {{}}"}))
    entry: jet_cli_debug_eval_declared([String]{"use {{\n    files: core.files\n}}\n\n// Doubles `n`.\n#Inline(Never)\ntwice: fn(n: Int) -> Int {{\n    // Not `LIMIT`.\n    add(n, n)\n}}\n\npriv add: fn(a: Int, b: Int) -> Int {{ a + b }}\n\nLIMIT: 10\n\nover: fn(n: Int) -> Bool {{ n > LIMIT }}\n\nsized: fn(n: Int) -> Int {{ files.temp_dir().len() + n }}\n\n#Test(\"twice\") {{\n    assert_eq(twice(2), 4)\n}}\n\nrun: fn() {{\n    print(twice(3))\n}}\n"})
    assert_eq(jet_cli_debug_eval_alone("twice(total) + 1", [NativeEvalBinder]{total}, entry, functions: true), Val([String]{"\n\n\n\n// Doubles `n`.\n#Inline(Never)\ntwice: fn(n: Int) -> Int {{\n    // Not `LIMIT`.\n    add(n, n)\n}}\n\npriv add: fn(a: Int, b: Int) -> Int {{ a + b }}\n\nrun: fn() {{}}"}))
    assert_eq(jet_cli_debug_eval_alone("sized(total)", [NativeEvalBinder]{total}, entry, functions: true), Val([String]{"use {{\n    files: core.files\n}}\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nsized: fn(n: Int) -> Int {{ files.temp_dir().len() + n }}\n\nrun: fn() {{}}"}))
    assert_eq(jet_cli_debug_eval_alone("over(total)", [NativeEvalBinder]{total}, entry, functions: true), None)
    assert_eq(jet_cli_debug_eval_alone("run()", [NativeEvalBinder]{total}, entry, functions: true), None)
    assert_eq(jet_cli_debug_eval_alone("max(total, 1)", [NativeEvalBinder]{total}, entry, functions: true), Val([String]{"run: fn() {{}}"}))
}

#Test("an expression that calls another source's functions compiles with each source cut to what it reaches, at its lines") {
    total: NativeEvalBinder{name: "total", type_name: "Int", live: true}
    entry: "run: fn() {{\n    print(step())\n}}\n"
    lib: "f_1: fn(n: Int) -> Int {{\n    n + 1\n}}\n\nf_2: fn(n: Int) -> Int {{\n    n + 2\n}}\n\nstep: fn() -> Int {{\n    f_2(1)\n}}\n"
    both: jet_cli_debug_eval_declared([String]{entry, lib})
    assert_eq(jet_cli_debug_eval_alone("f_1(total)", [NativeEvalBinder]{total}, both, functions: true), Val([String]{"run: fn() {{}}", "f_1: fn(n: Int) -> Int {{\n    n + 1\n}}\n\n"}))
    assert_eq(jet_cli_debug_eval_alone("step() + total", [NativeEvalBinder]{total}, both, functions: true), Val([String]{"run: fn() {{}}", "\n\n\n\nf_2: fn(n: Int) -> Int {{\n    n + 2\n}}\n\nstep: fn() -> Int {{\n    f_2(1)\n}}\n"}))
    assert_eq(jet_cli_debug_eval_alone("total + 1", [NativeEvalBinder]{total}, both), Val([String]{"run: fn() {{}}", ""}))
    twin: jet_cli_debug_eval_declared([String]{entry, lib, "priv f_1: fn(n: Int) -> Int {{\n    n\n}}\n"})
    assert_eq(twin.index.get("f_1"), Val(-1))
    assert_eq(jet_cli_debug_eval_alone("f_1(total)", [NativeEvalBinder]{total}, twin, functions: true), None)
}

#Test("an expression that reaches a function the sources use as a value leaves it to the program's compile") {
    total: NativeEvalBinder{name: "total", type_name: "Int", live: true}
    entry: "run: fn() {{\n    print(apply(grow, 1) + grow(2))\n    print(\"near {{label(1)}} \\\"near\\\"\")\n}}\n\n// Not near, nor label\napply: fn(f: fn(Int) -> Int, n: Int) -> Int {{\n    f(n)\n}}\n\ngrow: fn(n: Int) -> Int {{\n    n + 1\n}}\n\nnear: fn(n: Int) -> Int {{\n    grow(n)\n}}\n\nlabel: fn(n: Int) -> Int {{\n    n.label(near: 2)\n}}\n\n#Test(\"label\") {{\n    assert_eq(label(1), 1)\n}}\n"
    declared: jet_cli_debug_eval_declared([String]{entry})
    assert_eq(declared.valued.len(), 1)
    assert(declared.valued.has_key("grow"))
    assert_eq(jet_cli_debug_eval_alone("grow(total)", [NativeEvalBinder]{total}, declared, functions: true), None)
    assert_eq(jet_cli_debug_eval_alone("near(total)", [NativeEvalBinder]{total}, declared, functions: true), None)
    assert_eq(jet_cli_debug_eval_held_reach(declared, 0, [String]{"near"}), None)
}
