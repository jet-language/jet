// `jet debug`'s one evaluator (JetDebug NativeEval.jet): an expression asked
// at a stop is compiled with the program, as the debug build compiled it (O0,
// the same deep checks, debug info). The first compile asks the checker how
// the expression checks where the frame stopped (JetSema EvalProbe.jet): its
// type, the locals it captures, and a refusal for an effect, which names the
// effect. The second compiles the program with the expression as a function
// of its captures appended to the stop's source, built as a root with an
// entry that calls it (JetEval jet_eval_native_wrapper); the session places
// that code in a fork of the stopped program and calls it there.
use {
    debug_eval_files: core.files
    jet_debug.[NATIVE_EVAL_CAPTURES, NativeEval, NativeEvalPart, NativeEvalRefused, NativeEvaluator, NativeFixEdit]
    jet_driver.[JetDriverCompileMode, JetDriverEvalAsk, JetDriverIceRow, jet_driver_check_failures, jet_driver_entry_root_path]
    jet_eval.[jet_eval_native_add, jet_eval_native_wrapper]
    jet_foundation.[BuildOptions, CompilerThreads, DeepChecks, deep_checks_flags, name_rows_get_text, type_name, type_unqualified_nominals]
    jet_ir.[IRTypeKind, ir_module_new, ir_pointer_row, ir_x64_compile_module_logged, ir_x64_debug_program]
    jet_sema.[SemaEvalProbeAnswer, sema_eval_probe_function, sema_eval_probe_parse]
}

// The function an evaluated expression becomes, appended to its source.
JET_CLI_DEBUG_EXPRESSION: "jet_debug_expression"

// The entry that calls it with its result's cell and its captures'
// addresses (NativeEval.entry).
JET_CLI_DEBUG_EVAL_ENTRY: "jet_debug_eval"

// The prefix of the checker's refusals, which the console's own
// `Can't evaluate` says already.
JET_CLI_DEBUG_EVAL_REFUSAL: "the debugger can't evaluate this: "

// The evaluator of a session debugging the program whose entry file is
// `entry`, built with the flags `argv` (jet_cli_debug_eval_argv).
JetCLIDebugEvaluator: struct {
    entry: String,
    argv: [String],
    color: Bool,

    impl NativeEvaluator {
        compile: fn(self, path: String, line: Int, text: String) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> NativeEval NativeEvalRefused! {
            jet_cli_debug_eval_compile(self.entry, self.argv, self.color, path, line, text)
        }
    }
}

// The flags an evaluation's compile takes: the debug build's, -O0 and its
// `deep_checks`.
jet_cli_debug_eval_argv: fn(deep_checks: DeepChecks) -> [String] Never! {
    argv := [String]{"-O0"}
    loop word in deep_checks_flags(deep_checks) -> argv.push(word)
    argv
}

jet_cli_debug_eval_refused: fn(message: String) -> NativeEvalRefused Never! {
    NativeEvalRefused{message: message}
}

// The byte offset of the first non-blank byte of line `line` (from 1) of
// `source`; None past its end.
jet_cli_debug_eval_offset: fn(source: String, line: Int) -> Int? Never! {
    bytes: source.bytes()
    at := 0
    current := 1
    loop current < line {
        if at >= bytes.len() -> return None
        if bytes[at] == 10 -> current += 1
        at += 1
    }
    loop at < bytes.len() && (bytes[at] == 32 || bytes[at] == 9) -> at += 1
    Val(at)
}

// `text` compiled into the program of `entry`, with the flags `argv`, as a
// function of the locals it reads before line `line` of the source `path`
// (NativeEval.jet).
jet_cli_debug_eval_compile: fn(entry: String, argv: [String], color: Bool, path: String, line: Int, text: String) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> NativeEval NativeEvalRefused! {
    if entry == "" {
        return Err(jet_cli_debug_eval_refused("the debugger has no source of the program to compile it with; debug it as `jet debug <file.jet>`"))
    }
    source: debug_eval_files.read(path) ?? return Err(jet_cli_debug_eval_refused("couldn't read `{path}`: {err}"))
    offset: jet_cli_debug_eval_offset(source, line) ?? return Err(jet_cli_debug_eval_refused("`{path}` has no line {line} now"))
    parsed: sema_eval_probe_parse(text, offset)
    if parsed.expression == None {
        what: if parsed.diagnostics.len() > 0 -> parsed.diagnostics[0].what else -> "it is not one expression"
        return Err(jet_cli_debug_eval_refused("`{text}` is not a Jet expression: {what}"))
    }
    entry_source: debug_eval_files.read(entry) ?? return Err(jet_cli_debug_eval_refused("couldn't read `{entry}`: {err}"))
    chosen := BuildOptions?{None}
    if jet_cli_build_options(argv, "build", entry, entry_source, color, true) == {
        .Refused(_) -> return Err(jet_cli_debug_eval_refused("the debug build's options don't apply to `{entry}` now"))
        .Selected(options, _) -> chosen = Val(options)
    }
    options: chosen ?? return Err(jet_cli_debug_eval_refused("the debug build's options don't apply to `{entry}` now"))
    answer: jet_cli_debug_eval_answer(entry, color, options, path, offset, line, text) ?? return Err(err)
    function: sema_eval_probe_function(answer, text, JET_CLI_DEBUG_EXPRESSION) ?? return Err(jet_cli_debug_eval_refused("`{text}` has no value"))
    value: answer.value_type ?? return Err(jet_cli_debug_eval_refused("`{text}` has no value"))
    if answer.captures.len() > NATIVE_EVAL_CAPTURES {
        return Err(jet_cli_debug_eval_refused("`{text}` reads {answer.captures.len()} locals, and the debugger passes at most {NATIVE_EVAL_CAPTURES}"))
    }
    overlay: JetCLIOverlay{path: path, source: "{source}\n{function}"}
    prepared: jet_cli_prepare_overlays(entry, entry, [JetCLIOverlay]{overlay}, color, None, JetDriverCompileMode.Program, appended: true)
    compiled: jet_cli_compile_executable(prepared, None, options, None, None, color) ?? return Err(jet_cli_debug_eval_refused("the compiler stopped before finishing it"))
    if compiled.move() == {
        .Refused(refusal) -> Err(jet_cli_debug_eval_refused("the compiler refused it: {refusal.stderr.trim()}"))
        .Checked(result, inputs, snapshot) -> {
            failures: jet_driver_check_failures(result.diagnostics)
            if failures.len() > 0 {
                return Err(jet_cli_debug_eval_refused("the compiler refused it: {failures[0].what}"))
            }
            if result.internal_problem != None || !result.complete {
                return Err(jet_cli_debug_eval_refused("the compiler stopped before finishing it"))
            }
            checked: inputs.move() ?? return Err(jet_cli_debug_eval_refused("the compiler finished without its checked functions"))
            key := ""
            loop body in checked.functions {
                if body.name == JET_CLI_DEBUG_EXPRESSION && debug_eval_path_same(body.source_file, path) {
                    key = "{body.key}"
                }
            }
            if key == "" {
                return Err(jet_cli_debug_eval_refused("the compiled program has no function for it"))
            }
            runtime: jet_cli_runtime_exports(jet_cli_runtime_dir())
            if runtime.failure != None {
                return Err(jet_cli_debug_eval_refused("couldn't read the Jet runtime's exports"))
            }
            census := [JetDriverIceRow]{}
            built := jet_cli_native_program(result, checked, None, options, runtime, census, entry, jet_driver_entry_root_path(snapshot), roots: [String]{key})
            if built.failure != None || census.len() > 0 {
                return Err(jet_cli_debug_eval_refused("the compiler couldn't build it"))
            }
            program := built.program.move()
            built.program = ir_module_new()
            row: name_rows_get_text(program.function_rows, key) ?? return Err(jet_cli_debug_eval_refused("the built program has no function for it"))
            params := [Int]{}
            captures := [NativeEvalPart]{}
            loop slot in 0..<program.functions[row].param_count {
                ty: program.functions[row].slot_type[slot]
                params.push(ty)
                name: if slot < answer.captures.len() -> answer.captures[slot].source else -> ""
                captures.push(NativeEvalPart{name: name, size: program.types[ty].size, inline: program.types[ty].kind == IRTypeKind.Aggregate})
            }
            result_row: program.functions[row].result
            if result_row < 0 || program.types[result_row].kind == IRTypeKind.Unit {
                return Err(jet_cli_debug_eval_refused("`{text}` has no value"))
            }
            part: NativeEvalPart{name: type_name(type_unqualified_nominals(value)), size: program.types[result_row].size, inline: program.types[result_row].kind == IRTypeKind.Aggregate}
            pointer: ir_pointer_row(program)
            wrapper: jet_eval_native_wrapper(program, JET_CLI_DEBUG_EVAL_ENTRY, row, params, result_row, pointer, loads: true)
            at: jet_eval_native_add(program, wrapper)
            program.kept.push(at)
            threads: CompilerThreads{cap: result.compiler_threads.cap, cores: result.compiler_threads.cores, memory_available: jet_cli_memory_available()}
            selected: ir_x64_compile_module_logged(program, threads, [String]{})
            if selected.errors.len() > 0 {
                return Err(jet_cli_debug_eval_refused("the compiler couldn't build it"))
            }
            lowered: ir_x64_debug_program(selected)
            if lowered.errors.len() > 0 {
                return Err(jet_cli_debug_eval_refused("the compiler couldn't build it"))
            }
            edit: NativeFixEdit{object: lowered.program.move(), functions: lowered.functions.move(), debug: lowered.debug.move()}
            Ok(NativeEval{text: text, edit: edit, entry: JET_CLI_DEBUG_EVAL_ENTRY, captures: captures, result: part})
        }
    }
}

// How the checker checks `text` at byte `offset` of `path` in the program of
// `entry`: the answer of the function there, or why it can't be evaluated
// (the first refusal, which names an effect it uses).
jet_cli_debug_eval_answer: fn(entry: String, color: Bool, options: BuildOptions, path: String, offset: Int, line: Int, text: String) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> SemaEvalProbeAnswer NativeEvalRefused! {
    answers := [SemaEvalProbeAnswer]{}
    asked: if jet_cli_prepare_overlays(entry, entry, [JetCLIOverlay]{}, color, None, JetDriverCompileMode.Program) == {
        .Refused(output) -> JetCLIPrepared.Refused{output: output}
        .Prepared(request, snapshot) -> {
            held := request
            held.eval_ask = Val(JetDriverEvalAsk{path: path, offset: offset, text: text})
            JetCLIPrepared.Prepared{request: held, snapshot: snapshot}
        }
    }
    compiled: jet_cli_compile_executable(asked, None, options, None, None, color) ?? return Err(jet_cli_debug_eval_refused("the compiler stopped before finishing the program"))
    if compiled.move() == {
        .Refused(refusal) -> return Err(jet_cli_debug_eval_refused("the program doesn't compile now: {refusal.stderr.trim()}"))
        .Checked(result, _, _) -> {
            failures: jet_driver_check_failures(result.diagnostics)
            if failures.len() > 0 {
                return Err(jet_cli_debug_eval_refused("the program doesn't compile now: {failures[0].what}"))
            }
            answers = result.eval_answers.move()
        }
    }
    chosen := SemaEvalProbeAnswer?{None}
    loop answer in answers.move() {
        if chosen == None || answer.exact -> chosen = Val(answer)
    }
    answer: chosen ?? return Err(jet_cli_debug_eval_refused("no Jet function holds {path}:{line}"))
    if answer.refusals.len() > 0 {
        what: answer.refusals[0].what
        shown: if what.starts_with(JET_CLI_DEBUG_EVAL_REFUSAL) -> what.slice(JET_CLI_DEBUG_EVAL_REFUSAL.len()..<what.len()) else -> what
        return Err(jet_cli_debug_eval_refused(shown))
    }
    if answer.value_type == None -> return Err(jet_cli_debug_eval_refused("`{text}` has no value"))
    Ok(answer)
}

// Whether the checked source file `source` is `path`, the line table's: the
// same path, or one is the other's trailing components.
debug_eval_path_same: fn(source: String, path: String) -> Bool Never! {
    source == path || source.ends_with("/{path}") || path.ends_with("/{source}")
}

#Test("an evaluated expression starts at its line's first byte") {
    assert_eq(jet_cli_debug_eval_offset("a\n    b: 1\n", 2), Val(6))
    assert_eq(jet_cli_debug_eval_offset("a\n\tb\n", 2), Val(3))
    assert_eq(jet_cli_debug_eval_offset("a\n", 1), Val(0))
    assert_eq(jet_cli_debug_eval_offset("a", 3), None)
}
