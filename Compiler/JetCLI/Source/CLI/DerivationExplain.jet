// `jet explain <subject> [file]` for a fact of the checked program: a
// declaration path (`main.Shape.area`) or a frame callback
// (`main.on_frame@412`, or `main.on_frame` when the module has one). The
// subject's records print with their premises, a premise that names another
// record nested under it (derivation_store_chain). A miss lists the module's
// closest subjects. Build facts are records of the build-fact producer
// (BuildFactExplain.jet).
use {
    cli_files: core.files
    jet_driver.[JET_DRIVER_EXIT_USER_ERROR, JetDriverCompileResult, JetDriverVerbOutput]
    jet_foundation.[DerivationRecord, DerivationStore, DiagnosticExplanation, derivation_record_line, derivation_store_chain, derivation_store_subject]
}

// How many of the module's subjects a miss lists.
JET_CLI_DERIVATION_CLOSEST: 5

// The entry whose checked program answers `query`, None when `query` is no
// record subject: dotted names, the last maybe `@<offset>`, whose first name
// is a module of the entry's project (the entry itself, or a source file or
// directory beside it). The entry is `file`, else the current directory's
// project entry.
jet_cli_derivation_entry: fn(query: String, file: String?) -[FS, Env]> String? Never! {
    parts: query.split(".").to_list()
    if parts.len() < 2 -> return None
    loop (index, part) in parts {
        pieces: part.split("@").to_list()
        if pieces.len() > 2 || (pieces.len() == 2 && index != parts.len() - 1) -> return None
        if !jet_cli_derivation_name(pieces[0]) -> return None
        if pieces.len() == 2 && !jet_cli_derivation_offset(pieces[1]) -> return None
    }
    entry := ""
    if file == .Val(named) {
        entry = jet_cli_inspect_absolute(named)
    } else {
        notices := [String]{}
        cwd: cli_files.cwd() ?? return None
        if jet_cli_find_project_entry(cwd, "explain", false, notices) == .Entry(found) {
            entry = found.path
        } else {
            return None
        }
    }
    if !cli_files.is_file(entry) -> return None
    module_name: parts[0]
    source_name: "{module_name}.jet"
    dir: cli_files.dirname(entry)
    if cli_files.basename(entry) == source_name || cli_files.is_file(cli_files.join(dir, source_name)) || cli_files.is_dir(cli_files.join(dir, module_name)) {
        return Val(entry)
    }
    None
}

// A Jet name: a letter or `_`, then letters, digits and `_`.
jet_cli_derivation_name: fn(text: String) -> Bool Never! {
    bytes: text.bytes()
    if bytes.len() == 0 -> return false
    loop (index, byte) in bytes {
        letter: (byte >= (U8{97}) && byte <= (U8{122})) || (byte >= (U8{65}) && byte <= (U8{90})) || byte == (U8{95})
        digit: byte >= (U8{48}) && byte <= (U8{57})
        if !letter && !(digit && index > 0) -> return false
    }
    true
}

jet_cli_derivation_offset: fn(text: String) -> Bool Never! {
    bytes: text.bytes()
    if bytes.len() == 0 -> return false
    loop byte in bytes {
        if byte < (U8{48}) || byte > (U8{57}) -> return false
    }
    true
}

// The subject `query` names in `store`: a frame callback's own subject, the
// module's one callback for a bare `<module>.on_frame`, or the record of the
// definition whose claim names the declaration path (`method:main.Shape.area`).
jet_cli_derivation_subject: fn(store: DerivationStore, query: String) -> String? Never! {
    if derivation_store_subject(store, query).len() > 0 -> return Val(query)
    callbacks := [Int]{}
    definitions := [Int]{}
    loop (row, record) in store.records {
        if record.subject.starts_with("{query}@") -> callbacks.push(row)
        if record.rule == "checked-definition" && record.claim.after(":") == query -> definitions.push(row)
    }
    rows: if definitions.len() > 0 -> definitions else -> callbacks
    if rows.len() == 0 -> return None
    subject: store.records[rows[0]].subject
    loop row in rows {
        if store.records[row].subject != subject -> return None
    }
    Val(subject)
}

// The name a reader explains `record` by: a definition's declaration path,
// any other record's subject.
jet_cli_derivation_name_of: fn(record: DerivationRecord) -> String Never! {
    if record.rule == "checked-definition" -> return record.claim.after(":")
    "{record.subject}"
}

// The subjects of module `module_name` closest to `query`, nearest first.
jet_cli_derivation_closest: fn(store: DerivationStore, module_name: String, query: String) -> [String] Never! {
    names := [String]{}
    loop record in store.records {
        name: jet_cli_derivation_name_of(record)
        if name.starts_with("{module_name}.") && !names.contains(name) -> names.push(name)
    }
    names.sort_by(fn(left: String, right: String) { (jet_cli_edit_distance(query, left) <=> jet_cli_edit_distance(query, right)).then(left <=> right) })
    closest := [String]{}
    loop name in names.move() {
        if closest.len() == JET_CLI_DERIVATION_CLOSEST -> break
        closest.push(name)
    }
    closest
}

// `jet explain <subject> <file>` over the checked program: the chain of the
// record subject `query` names, else the module's closest subjects.
jet_cli_explain_derivation_report: fn(result: JetDriverCompileResult, query: String, color: Bool, json: Bool) -> JetDriverVerbOutput {
    index: jet_cli_checked_semindex(result)
    store: index.derivations
    module_name: query.split(".").to_list()[0]
    if jet_cli_derivation_subject(store, query) == .Val(subject) {
        return jet_cli_explain_derivation_chain(store, subject, query, color, json)
    }
    closest: jet_cli_derivation_closest(store, module_name, query)
    fix: if closest.len() == 0 -> "module `{module_name}` records no facts; name a declaration or an `on_frame` callback it checks" else -> "explain one of: {closest.join(", ")}"
    jet_cli_report_output("", "E2104", "`{query}` names no recorded fact of module `{module_name}`", jet_cli_why("E2104"), fix, color, JET_DRIVER_EXIT_USER_ERROR)
}

// `subject`'s chain, each record as its claim, how it is known, its subject
// and its premises, a record a premise names nested four columns under it.
jet_cli_explain_derivation_chain: fn(store: DerivationStore, subject: String, query: String, color: Bool, json: Bool) -> JetDriverVerbOutput Never! {
    steps: derivation_store_chain(store, subject)
    what := ""
    loop step in steps {
        indent: " ".repeat(step.depth * 4)
        if what != "" -> what = "{what}\n"
        what = "{what}{indent}{step.record.claim}\n{indent}  Known by {derivation_record_line(step.record)}\n{indent}  Subject: {step.record.subject}"
        if step.record.premises.len() > 0 -> what = "{what}\n{indent}  Premises: {step.record.premises.join(", ")}"
    }
    meaning: steps[0].record.claim
    explanation: DiagnosticExplanation{code: query, stage: "derivation relation", meaning: meaning, what: Val(what), why: None, fix: None, example: None}
    root: steps[0].record
    jet_cli_derived_explanation_verb(explanation, Val(root), color, json)
}
