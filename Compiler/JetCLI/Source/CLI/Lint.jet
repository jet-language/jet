// Lint's reports (the advice), --complexity, the JSON-aware --a11y host and
// the typed cost views: `lint --cost` and `explain --cost`.
use {
    jet_foundation.[JET_BUILD_DEFAULT_PROFILE]
    cli_time: core.time
    jet_driver.[
        JetDriverVerbOutput,
        JetDriverCompileMode,
        jet_driver_cost_kind_label,
        jet_driver_display_path,
        jet_driver_cost_state_label,
        jet_driver_parse_user_source,
        jet_driver_present_diagnostics,
        jet_driver_problem_report,
        jet_driver_plural,
        jet_driver_report_problems,
        jet_driver_is_a11y_lint,
        JET_DRIVER_EXIT_OK,
        JET_DRIVER_EXIT_USAGE,
        JET_DRIVER_EXIT_USER_ERROR,
    ]
    jet_foundation.[Diagnostic, DIAGNOSTIC_LINT, TCostState, diagnostic_from_registry, diagnostic_headline, diagnostic_line_at, diagnostic_render_all]
}

jet_cli_lint_errors: fn(file: String, source: String, diagnostics: [Diagnostic], color: Bool, json: Bool) -> JetDriverVerbOutput {
    rendered: if json -> jet_cli_reports_status_json("diagnostics", false, jet_cli_report_base(file), file, source, diagnostics) else -> jet_driver_report_problems(file, source, diagnostics, color, true)
    JetDriverVerbOutput{stdout: if json -> rendered else -> "", stderr: if json -> "" else -> rendered, exit_code: JET_DRIVER_EXIT_USER_ERROR}
}

jet_cli_lint_a11y: fn(file: String, source: String, color: Bool, json: Bool) -> JetDriverVerbOutput {
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    compiled: jet_cli_compile_file(file, color, None, JetDriverCompileMode.Program)
    if compiled == {
        .Refused(refusal) -> { output = refusal.move() }
        .Compiled(result, snapshot) -> {
            diagnostics: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            errors: jet_cli_errors(diagnostics)
            if errors.len() > 0 {
                jet_cli_finish(jet_cli_lint_errors(file, source, errors, color, json))
            }
            if result.internal_problem == .Val(problem) -> jet_cli_finish(jet_cli_ice(problem))
            lints := [Diagnostic]{}
            loop diagnostic in diagnostics {
                if jet_driver_is_a11y_lint(diagnostic.code) -> lints.push(diagnostic)
            }
            if lints.len() == 0 {
                jet_cli_finish(JetDriverVerbOutput{stdout: if json -> "" else -> "OK: `{file}` has no accessibility problems\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK})
            }
            count: lints.len()
            stderr: if json -> jet_cli_render_all_json(jet_cli_report_base(file), file, source, lints) else -> "{diagnostic_render_all(file, source, lints, color)}\n{count} accessibility warning{if count == 1 -> "" else -> "s"} found\n"
            jet_cli_finish(JetDriverVerbOutput{stdout: "", stderr: stderr, exit_code: JET_DRIVER_EXIT_USER_ERROR})
        }
    }
    output
}

// `jet lint <file>`: the advice of the file's checked program, the lints on
// the report tier (JetDriverCompileResult.advice) that no other command
// prints. Advice fails nothing: the list exits 0 whether or not it holds
// any, and only an error in the program exits 1. `jet lint --cost` lists
// L2510, which needs the typed cost report. The list ends like a check's
// problems: the count, then the pointer to the first code's explanation.
jet_cli_lint_reports: fn(file: String, source: String, color: Bool, json: Bool) -> JetDriverVerbOutput {
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    compiled: jet_cli_compile_entry(file, color, None, JetDriverCompileMode.Check, None, None)
    if compiled == {
        .Refused(refusal) -> { output = refusal.move() }
        .Compiled(result, snapshot) -> {
            errors: jet_cli_errors(jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files))
            if errors.len() > 0 {
                jet_cli_finish(jet_cli_lint_errors(file, source, errors, color, json))
            }
            if result.internal_problem == .Val(problem) -> jet_cli_finish(jet_cli_ice(problem))
            reports: jet_driver_present_diagnostics(result.advice, snapshot, result.generated_source_files)
            if json {
                jet_cli_finish(JetDriverVerbOutput{stdout: jet_cli_render_all_json(jet_cli_report_base(file), file, source, reports), stderr: "", exit_code: JET_DRIVER_EXIT_OK})
            }
            if reports.len() == 0 {
                jet_cli_finish(JetDriverVerbOutput{stdout: "OK: `{file}` has no reports\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK})
            }
            count: reports.len()
            jet_cli_finish(JetDriverVerbOutput{stdout: "", stderr: jet_driver_problem_report(file, source, reports, "{count} report{jet_driver_plural(count)} found", color), exit_code: JET_DRIVER_EXIT_OK})
        }
    }
    output
}

// `jet lint --cost <file>`: the L2510 lints of the file's checked program,
// the hidden dynamic costs its loops repeat; exits 1 when there is one.
jet_cli_lint_cost: fn(file: String, source: String, color: Bool, json: Bool) -> JetDriverVerbOutput {
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    compiled: jet_cli_compile_entry(file, color, None, JetDriverCompileMode.Check, None, None, capture_cost_report: true)
    if compiled == {
        .Refused(refusal) -> { output = refusal.move() }
        .Compiled(result, snapshot) -> {
            diagnostics: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            errors: jet_cli_errors(diagnostics)
            if errors.len() > 0 {
                jet_cli_finish(jet_cli_lint_errors(file, source, errors, color, json))
            }
            if result.internal_problem == .Val(problem) -> jet_cli_finish(jet_cli_ice(problem))
            lints := [Diagnostic]{}
            loop diagnostic in jet_driver_present_diagnostics(result.advice, snapshot, result.generated_source_files) {
                if diagnostic.code == "L2510" -> lints.push(diagnostic)
            }
            if lints.len() == 0 {
                jet_cli_finish(JetDriverVerbOutput{stdout: if json -> jet_cli_render_all_json(jet_cli_report_base(file), file, source, lints) else -> "OK: `{file}` has no hidden dynamic costs in loops\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK})
            }
            count: lints.len()
            stderr: if json -> jet_cli_render_all_json(jet_cli_report_base(file), file, source, lints) else -> "{diagnostic_render_all(file, source, lints, color)}\n{count} hidden dynamic cost warning{if count == 1 -> "" else -> "s"} found\n"
            jet_cli_finish(JetDriverVerbOutput{stdout: "", stderr: stderr, exit_code: JET_DRIVER_EXIT_USER_ERROR})
        }
    }
    output
}

// `jet explain --cost <file>`: every typed cost site of the file's checked
// program, one line each (or the `explain.cost` envelope under `--json`): its
// line, function, kind (with the type a copy copies), whether it remains, and
// its loop depth, a remaining cost a loop runs marked as repeating every loop
// turn. A site in another file of the program names that file. Each function
// the projection covered without a site gets its own line, a generic
// function's under the name of each specialization the program reaches (the
// envelope's `functions` names every covered one). An envelope site also
// names its file as the line does (`path`), the type a copy copies (`view`,
// empty for none) and whether it repeats every loop turn (`repeats`), which
// `jet perf view` reads (Perf/LineCosts.jet).
jet_cli_explain_cost: fn(file: String, source: String, color: Bool, json: Bool, threads: Int?) -> JetDriverVerbOutput {
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    compiled: jet_cli_compile_entry(file, color, threads, JetDriverCompileMode.Check, None, None, capture_cost_report: true)
    if compiled == {
        .Refused(refusal) -> { output = refusal.move() }
        .Compiled(result, snapshot) -> {
            diagnostics: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            errors: jet_cli_errors(diagnostics)
            if errors.len() > 0 {
                jet_cli_finish(jet_cli_lint_errors(file, source, errors, color, json))
            }
            if result.internal_problem == .Val(problem) -> jet_cli_finish(jet_cli_ice(problem))
            report: result.cost_report ?? jet_cli_finish(jet_cli_ice("a checked program kept no typed cost report"))
            // A site's path is relative to the entry's source root; the
            // entry's own sites name it as it was typed.
            entry: jet_driver_display_path(if snapshot.roots.len() > 0 -> snapshot.roots[0].canonical_path else -> "", snapshot.entry_path)
            rows := [JetCLIStatusValue]{}
            sited := [String:Bool]{}
            stdout := ""
            loop site in report.sites {
                kind: jet_driver_cost_kind_label(site.kind)
                state: jet_driver_cost_state_label(site.state)
                place: if site.path == entry -> file else -> site.path
                repeats: site.loop_depth > 0 && site.state == TCostState.SemanticRemainder
                if json {
                    rows.push(jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("function", jet_cli_status_text(site.function)), jet_cli_status_field("line", jet_cli_status_int(site.line)), jet_cli_status_field("kind", jet_cli_status_text(kind)), jet_cli_status_field("state", jet_cli_status_text(state)), jet_cli_status_field("loop_depth", jet_cli_status_int(site.loop_depth)), jet_cli_status_field("tier", jet_cli_status_text(JET_CLI_COST_TIER)), jet_cli_status_field("path", jet_cli_status_text(place)), jet_cli_status_field("view", jet_cli_status_text(site.view)), jet_cli_status_field("repeats", jet_cli_status_bool(repeats))}))
                } else {
                    copied: if site.view == "" -> "" else -> " of `{site.view}`"
                    turns: if repeats -> ", repeats every loop turn" else -> ""
                    stdout = "{stdout}{place}:{site.line} fn {site.function} — {kind}{copied} — {state} (loop depth {site.loop_depth}{turns}; tier={JET_CLI_COST_TIER})\n"
                }
                sited[site.function] = true
            }
            if json {
                names: loop name in report.functions -> jet_cli_status_text(name)
                stdout = "{jet_cli_status_render("explain.cost", true, [JetCLIStatusField]{jet_cli_status_field("file", jet_cli_status_text(file)), jet_cli_status_field("functions", jet_cli_status_array(names)), jet_cli_status_field("sites", jet_cli_status_array(rows))})}\n"
            } else {
                loop name in report.functions {
                    if sited.get(name) == None {
                        stdout = "{stdout}No typed cost sites in fn {name} (tier={JET_CLI_COST_TIER})\n"
                    }
                }
                if stdout == "" -> stdout = "No typed cost sites in `{file}`\n"
            }
            jet_cli_finish(JetDriverVerbOutput{stdout: stdout, stderr: "", exit_code: JET_DRIVER_EXIT_OK})
        }
    }
    output
}

// The tier a typed cost site is read at: the shared typed tree every
// backend lowers.
JET_CLI_COST_TIER: "shared-tir"

jet_cli_lint_max: fn(raw: [String], color: Bool) -> JetCLIIntOption Never! {
    loop argument in raw {
        if !argument.starts_with("--max=") -> next
        text: argument.removeprefix("--max=")
        digits: text.bytes()
        index := if digits.len() > 0 && digits[0] == (U8{43}) -> 1 else -> 0
        if index >= digits.len() {
            return JetCLIIntOption.Refused{output: jet_cli_lint_max_error(text, color)}
        }
        value := 0
        loop index < digits.len() {
            digit: Int{digits[index]} - 48
            if digit < 0 || digit > 9 || value > 429496729 || (value == 429496729 && digit > 5) {
                return JetCLIIntOption.Refused{output: jet_cli_lint_max_error(text, color)}
            }
            value = value * 10 + digit
            index += 1
        }
        return JetCLIIntOption.Value{value: Val(value)}
    }
    JetCLIIntOption.Value{value: None}
}

// An option error is returned before compiling.
JetCLIIntOption: enum {
    Value(value: Int?),
    Refused(output: JetDriverVerbOutput),
}

jet_cli_lint_max_error: fn(text: String, color: Bool) -> JetDriverVerbOutput Never! {
    jet_cli_report_output("", "E2104", "`--max={text}` isn't a non-negative integer", jet_cli_why("E2104"), "use `--max=<n>` with a non-negative integer", color, JET_DRIVER_EXIT_USAGE)
}

jet_cli_lint_architecture: fn(file: String, color: Bool) -> JetCLIArchitectureInspection {
    watch: cli_time.start()
    compiled: jet_cli_compile_file(file, color, None, JetDriverCompileMode.Doc)
    if compiled == {
        .Refused(refusal) -> return JetCLIArchitectureInspection{rows: [], check: None, reason: Val("the checked semantic projection was unavailable; no architecture claim was emitted ({refusal.stderr.trim()})")}
        .Compiled(result, snapshot) -> {
            diagnostics: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            errors: jet_cli_errors(diagnostics)
            if errors.len() > 0 {
                reasons: loop diagnostic in errors -> diagnostic_headline(diagnostic.code, diagnostic.what)
                return JetCLIArchitectureInspection{rows: [], check: None, reason: Val("the checked semantic projection was unavailable; no architecture claim was emitted ({reasons.join("; ")})")}
            }
            if result.internal_problem == .Val(problem) {
                return JetCLIArchitectureInspection{rows: [], check: None, reason: Val("the checked semantic projection was unavailable; no architecture claim was emitted ({problem})")}
            }
            return JetCLIArchitectureInspection{rows: jet_cli_architecture_rows(jet_cli_checked_semindex(result)), reason: None, check: Val(jet_cli_inspect_check_value(file, watch.elapsed_millis(), diagnostics.len(), JET_BUILD_DEFAULT_PROFILE))}
        }
    }
}

jet_cli_lint_complexity: fn(file: String, source: String, raw: [String], color: Bool, json: Bool) -> JetDriverVerbOutput {
    budget := Int?{None}
    budget_option: jet_cli_lint_max(raw, color)
    if budget_option == {
        .Value(value) -> budget = value
        .Refused(output) -> return output.move()
    }
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    compiled: jet_cli_compile_file(file, color, None, JetDriverCompileMode.Program)
    if compiled == {
        .Refused(refusal) -> { output = refusal.move() }
        .Compiled(result, snapshot) -> {
            diagnostics: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            errors: jet_cli_errors(diagnostics)
            if errors.len() > 0 {
                jet_cli_finish(jet_cli_lint_errors(file, source, errors, color, json))
            }
            if result.internal_problem == .Val(problem) -> jet_cli_finish(jet_cli_ice(problem))
            jet_cli_finish(jet_cli_lint_complexity_report(file, source, budget, color, json))
        }
    }
    output
}

// The complexity report of a file that checked: each function's score, then
// the architecture advice when no budget is set.
jet_cli_lint_complexity_report: fn(file: String, source: String, budget: Int?, color: Bool, json: Bool) -> JetDriverVerbOutput {
    parsed: jet_driver_parse_user_source(source)
    if parsed.diagnostics.len() > 0 {
        return jet_cli_lint_errors(file, source, parsed.diagnostics, color, json)
    }
    reports: jet_cli_complexity_reports(parsed.program)
    rows := [JetCLIStatusValue]{}
    exceeded := [Diagnostic]{}
    stdout := ""
    loop report in reports {
        line: diagnostic_line_at(source, report.span.start)
        over: if budget == .Val(value) -> report.score > value else -> false
        if json {
            rows.push(jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("file", jet_cli_status_text(file)), jet_cli_status_field("fn", jet_cli_status_text(report.name)), jet_cli_status_field("line", jet_cli_status_int(line)), jet_cli_status_field("score", jet_cli_status_int(report.score)), jet_cli_status_field("budget", if budget == .Val(value) -> jet_cli_status_int(value) else -> JetCLIStatusValue.Null), jet_cli_status_field("over", jet_cli_status_bool(over))}))
        } else {
            suffix: if budget == .Val(value) -> " (budget {value})" else -> ""
            stdout = "{stdout}{file}:{line} fn {report.name} — score {report.score}{suffix}\n"
        }
        if over {
            diagnostic := diagnostic_from_registry("L2902", Val(report.span), "function `{report.name}` has cognitive complexity {report.score} above budget {budget ?? 0}", "the function's control flow is harder to read and maintain than the selected budget allows", "split the function, reduce nesting, or replace mixed control flow with a focused helper")
            diagnostic.severity = DIAGNOSTIC_LINT
            exceeded.push(diagnostic)
        }
    }
    if budget == None {
        inspection: jet_cli_lint_architecture(file, color)
        if json {
            fields := [JetCLIStatusField]{
                jet_cli_status_field("contract", jet_cli_status_text("jet.architecture-advice/v1")),
                jet_cli_status_field("file", jet_cli_status_text(file)),
                jet_cli_status_field("local_complexity", jet_cli_status_array(rows)),
                jet_cli_status_field("architecture_advice", jet_cli_architecture_value(inspection)),
                jet_cli_status_field("measurement", jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("benchmark", jet_cli_status_text("not_run")), jet_cli_status_field("change_task", jet_cli_status_text("not_measured")), jet_cli_status_field("claim", jet_cli_status_text("none"))})),
            }
            if inspection.check == .Val(check) -> fields.push(jet_cli_status_field("check", check))
            stdout = "{jet_cli_status_render("lint.complexity", true, fields)}\n"
        } else { stdout = "{stdout}{jet_cli_architecture_text(inspection)}" }
    } else {
        if json -> stdout = "{jet_cli_status_json(jet_cli_status_array(rows))}\n"
    }
    JetDriverVerbOutput{stdout: stdout, stderr: if !json && exceeded.len() > 0 -> diagnostic_render_all(file, source, exceeded, color) else -> "", exit_code: if exceeded.len() == 0 -> JET_DRIVER_EXIT_OK else -> JET_DRIVER_EXIT_USER_ERROR}
}
