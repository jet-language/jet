// Read-only project truth. Missing evidence creates no claim; stale evidence
// remains visible, and status never runs a producer.
use {
    jet_foundation.[canonical_json_bytes]
    jet_driver.[JET_DRIVER_EXIT_OK, JetDriverRunReceipt, jet_driver_run_receipt_query_sections]
    cli_files: core.files
}

JetCLIProjectClaim: struct {
    name: String,
    action: String,
    state: String,
    receipt: String?,
    sections: JetCLIStatusValue,
    reason: String,
}

// `target_arg` up to its default: the one explicit target, or None when the
// caller must select the stock project entry.
jet_cli_project_status_target: fn(args: [String]) -> String? JetCLIUsageError! {
    target := String?{None}
    skip := false
    loop arg in args {
        if skip {
            skip = false
            next
        }
        if arg == "--json" || arg == "--quiet" || arg == "--no-color" || arg.starts_with("--color=") {
            next
        }
        if arg == "--color" {
            skip = true
            next
        }
        if arg.starts_with("-") {
            return Err(jet_cli_usage_error("E2102", "unknown `jet status` flag `{arg}`"))
        }
        if target != None {
            return Err(jet_cli_usage_error("E2104", "`jet status` accepts at most one target"))
        }
        target = Val(arg)
    }
    Ok(target)
}

jet_cli_project_status_matches: fn(receipt: JetDriverRunReceipt, target: String, directory: Bool) -[FS]> Bool Never! {
    loop input in receipt.claim.inputs {
        path: cli_files.realpath(input.path) ?? input.path
        if path == target || (directory && (target == "/" || path.starts_with("{target}/"))) {
            return true
        }
    }
    false
}

jet_cli_project_status_sections: fn(receipt: JetDriverRunReceipt) -> JetCLIStatusValue Never! {
    value: jet_driver_run_receipt_query_sections(receipt.sections, None) ?? return jet_cli_status_object([JetCLIStatusField]{})
    text: String.from_bytes(canonical_json_bytes(value)) ?? return jet_cli_status_object([JetCLIStatusField]{})
    jet_cli_status_value_parse(text) ?? jet_cli_status_object([JetCLIStatusField]{})
}

jet_cli_project_status_summarize: fn(root: String, receipts: [JetDriverRunReceipt], name: String, target: String) -[FS, Time.Wait]> JetCLIProjectClaim Never! {
    success := JetDriverRunReceipt?{None}
    failure := JetDriverRunReceipt?{None}
    stale := JetDriverRunReceipt?{None}
    loop receipt in receipts {
        if jet_cli_receipt_lookup(root, receipt.claim) == {
            .Val(_) -> {
                if receipt.status == 0 -> success = Val(receipt) else -> failure = Val(receipt)
            }
            .None -> { stale = Val(receipt) }
            .Err(_) -> failure = Val(receipt)
        }
    }
    selected := JetDriverRunReceipt?{None}
    state := "unproven"
    reason := "no receipt proves this claim"
    if failure != None {
        selected = failure
        reason = "current receipt records failure"
    } else if success != None {
        selected = success
        state = "proven"
        reason = "current receipt records success"
    } else if stale != None {
        selected = stale
        state = "stale"
        reason = "receipt input closure changed"
    }
    receipt_id := String?{None}
    sections := jet_cli_status_object([JetCLIStatusField]{})
    if selected == .Val(receipt) {
        receipt_id = Val(receipt.claim.key.slice(0, if receipt.claim.key.len() < 12 -> receipt.claim.key.len() else -> 12))
        sections = jet_cli_project_status_sections(receipt)
    }
    JetCLIProjectClaim{name: name, action: "jet {name} {target}", state: state, receipt: receipt_id, sections: sections, reason: reason}
}

jet_cli_project_status_pad: fn(text: String, width: Int) -> String Never! {
    padded := text
    loop _ in text.len()..<width -> padded = "{padded} "
    padded
}

jet_cli_project_status_render: fn(target: String, rows: [JetCLIProjectClaim], error: String, json: Bool) -> JetCLIPlan Never! {
    if json {
        claims := [JetCLIStatusValue]{}
        loop row in rows {
            claims.push(
                jet_cli_status_object(
                    [JetCLIStatusField]{
                        jet_cli_status_field("action", jet_cli_status_text(row.action)),
                        jet_cli_status_field("claim", jet_cli_status_text(row.name)),
                        jet_cli_status_field("reason", jet_cli_status_text(row.reason)),
                        jet_cli_status_field("receipt", jet_cli_status_optional_text(row.receipt)),
                        jet_cli_status_field("sections", row.sections),
                        jet_cli_status_field("state", jet_cli_status_text(row.state)),
                    },
                ),
            )
        }
        fields: [JetCLIStatusField]{jet_cli_status_field("claims", jet_cli_status_array(claims)), jet_cli_status_field("error", if error == "" -> JetCLIStatusValue.Null else -> jet_cli_status_text(error)), jet_cli_status_field("target", jet_cli_status_text(target))}
        return jet_cli_done("{jet_cli_status_render("status", true, fields)}\n", "", JET_DRIVER_EXIT_OK)
    }
    out := "Target  {target}\n"
    loop row in rows {
        out = "{out}{jet_cli_project_status_pad(row.name, 8)} {jet_cli_project_status_pad(row.state, 9)} receipt {row.receipt ?? "none"}"
        if row.state != "proven" -> out = "{out} · act: {row.action} · {row.reason}"
        out = "{out}\n"
    }
    jet_cli_done(out, "", JET_DRIVER_EXIT_OK)
}

// The host supplies the normal default project entry and ReceiptStore's
// selected root for the parsed target.
jet_cli_project_status_at: fn(root: String, cwd: String, target: String, json: Bool) -[FS, Time.Wait]> JetCLIPlan Never! {
    receipts: jet_cli_receipt_list(root) ?? return jet_cli_project_status_render(target, [JetCLIProjectClaim]{}, "receipt store is unreadable: {err.message}", json)
    absolute: if target.starts_with("/") -> target else -> jet_cli_entry_join(cwd, target)
    canonical: cli_files.realpath(absolute) ?? absolute
    directory: if cli_files.stat(canonical) == {
        .Ok(info) -> info.is_dir
        .Err(_) -> false
    }
    by_verb := [String:[JetDriverRunReceipt]]{}
    verbs := [String]{}
    loop receipt in receipts {
        if !jet_cli_project_status_matches(receipt, canonical, directory) -> next
        name: receipt.claim.verb
        if by_verb.get(name) == None {
            verbs.push(name.copy())
            by_verb[name] = [JetDriverRunReceipt]{}
        }
        by_verb[name].push(receipt)
    }
    verbs.sort()
    rows := [JetCLIProjectClaim]{}
    loop name in verbs {
        rows.push(jet_cli_project_status_summarize(root, by_verb.get(name) ?? [JetDriverRunReceipt]{}, name, target))
    }
    jet_cli_project_status_render(target, rows, "", json)
}

// `jet status` at a workspace root (the index `index_path` of `root`): no
// one target is the root's, so it lists the members in index order, each
// with its directory and the entry a command there starts, or none.
jet_cli_project_status_workspace: fn(root: String, index_path: String, color: Bool, json: Bool, notices: ^[String]) -[FS, Env]> JetCLIPlan Never! {
    members := [JetCLIWorkspaceMember]{}
    if jet_cli_workspace_members(root, index_path, "status", color) == {
        .Refused(plan) -> return plan
        .Members(found) -> members = found
    }
    entries := [String]{}
    loop member in members {
        member_root: jet_cli_entry_join(root, member.path)
        entry := ""
        if jet_cli_find_project_entry_at(member_root, "status", color, notices, true) == {
            .Entry(found) -> {
                if cli_files.is_file(found.path) {
                    entry = jet_cli_project_status_relative(root, cli_files.realpath(found.path) ?? found.path)
                }
            }
            .Refused(plan) -> return plan
            .Absent -> {}
        }
        entries.push(entry)
    }
    if json {
        rows := [JetCLIStatusValue]{}
        loop (index, member) in members {
            rows.push(
                jet_cli_status_object(
                    [JetCLIStatusField]{
                        jet_cli_status_field("entry", if entries[index] == "" -> JetCLIStatusValue.Null else -> jet_cli_status_text(entries[index])),
                        jet_cli_status_field("name", jet_cli_status_text(member.name)),
                        jet_cli_status_field("path", jet_cli_status_text(member.path)),
                    },
                ),
            )
        }
        fields: [JetCLIStatusField]{jet_cli_status_field("members", jet_cli_status_array(rows)), jet_cli_status_field("workspace", jet_cli_status_text(jet_cli_project_status_relative(root, index_path)))}
        return jet_cli_done("{jet_cli_status_render("status", true, fields)}\n", "", JET_DRIVER_EXIT_OK)
    }
    name_width := 0
    path_width := 0
    loop member in members {
        if member.name.len() > name_width -> name_width = member.name.len()
        if member.path.len() > path_width -> path_width = member.path.len()
    }
    out := "Workspace  {jet_cli_project_status_relative(root, index_path)} · {members.len()} members\n"
    loop (index, member) in members {
        out = "{out}{jet_cli_project_status_pad(member.name, name_width)}  {jet_cli_project_status_pad(member.path, path_width)}  entry {if entries[index] == "" -> "none" else -> entries[index]}\n"
    }
    jet_cli_done(out, "", JET_DRIVER_EXIT_OK)
}

// `path` relative to the directory `root` when it lies under it.
jet_cli_project_status_relative: fn(root: String, path: String) -> String Never! {
    prefix: if root.ends_with("/") -> root else -> "{root}/"
    if path.starts_with(prefix) -> path.slice(prefix.len()..<path.len()) else -> path
}
