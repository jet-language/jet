// The Core sources and assets this jet is built with, for a compile with no
// toolchain tree (jet_cli_core_sources): the text of every
// CORE_SOURCE_OWNED_ROWS row and the bytes of every file a Core source embeds
// beside it, read from the toolchain tree when jet is built. The guard
// Tests/Guards/CoreDeclarations checks the sources against Core.rows's
// declarations on every commit.
use {
    cli_files: core.files
    jet_backend.[x64_self_read]
    jet_foundation.[CORE_SOURCE_OWNED_ROWS, CoreDeclarationFile, EFFECT_CANONICAL_MODULE, core_declarations_assets]
    jet_sema.[SemaCoreBodiesRecords, SemaCoreSeal, SemaCoreSealSource]
}

// The canonical effect module: the text of Compiler/Prelude/Effects.jet, then
// Core/Effects/Effects.jet, then Core/Compiler/Meta.jet, read from the
// toolchain tree while the compiler builds, and the effect declarations it
// holds (JetFoundation EFFECT_CANONICAL_MODULE), so a compile parses none of
// it.
JET_CLI_EFFECT_MODULE: #run EFFECT_CANONICAL_MODULE

// One embedded Core asset, by repository path.
JetCLICoreAsset: struct {
    path: String,
    bytes: [U8],
}

JET_CLI_CORE_SOURCES: #run { loop row in CORE_SOURCE_OWNED_ROWS -> CoreDeclarationFile{path: row.path.copy(), text: embed_file("toolchain:{row.path}")} }

// The files the Core sources embed (core_declarations_assets), read from the
// toolchain tree.
JET_CLI_CORE_ASSETS: #run { loop path in core_declarations_assets(JET_CLI_CORE_SOURCES) -> JetCLICoreAsset{bytes: embed_bytes("toolchain:{path}"), path: path} }

// The built-in text of the Core source row at repository path `path`
// (`Core/App/App.jet`), or None when no row has that path.
jet_cli_core_source_text: fn(path: String) -> String? Never! {
    loop file in JET_CLI_CORE_SOURCES {
        if file.path == path -> return Val(file.text.copy())
    }
    None
}

// The built-in bytes of the Core asset at repository path `path`
// (`Core/UI/XkbTables/keysym_values.bin`), or None when no Core source embeds
// that path.
jet_cli_core_asset_bytes: fn(path: String) -> [U8]? Never! {
    loop asset in JET_CLI_CORE_ASSETS {
        if asset.path == path -> return Val(asset.bytes.copy())
    }
    None
}

// Whether a compile of `entry` whose Core sources under test are
// `core_tests` ("" for none) takes the Core built into this jet, so it loads
// the Core library's function checks (Request.jet jet_cli_core_bodies_lend)
// and a native run may bind its Core calls to the Core library's code the
// jet carries (Host.jet jet_cli_native_executable): the jet carries its
// runtime (jet_cli_runtime_embedded), no Core source is under test, and the
// compile names no toolchain tree (jet_cli_named_toolchain) or one whose
// Core is the built-in one (jet_cli_core_tree_matches). A tree whose Core
// differs, as while Core is being edited, checks and compiles every Core
// function a program calls.
jet_cli_core_binding: fn(entry: String, core_tests: String) -> Bool Never! {
    if core_tests != "" || !jet_cli_runtime_embedded() -> return false
    toolchain: jet_cli_named_toolchain(entry) ?? return true
    jet_cli_core_tree_matches(toolchain)
}

// A `jet run`'s read of this jet's Core seal (JetSema CoreSeal.jet
// SemaCoreSealSource), which its Core demand makes when it first names a
// deferred Core body, for a run whose Core is the built-in one
// (jet_cli_core_binding). The seal is the image's part, lent from its
// mapped image (jet_cli_runtime_part), which the demand searches by key: no
// whole read or parse.
JetCLICoreSealRead: struct {
    impl SemaCoreSealSource {
        read: fn(self) -[FS, Env]> SemaCoreSeal? {
            Val(SemaCoreSeal{bytes: jet_cli_runtime_part(JET_CLI_CORE_SEAL_FILE)})
        }
    }
}

// A compile's read of the records of this jet's Core bodies part (JetSema
// CoreBodies.jet SemaCoreBodiesRecords): positioned reads of this jet's own
// file, whose part starts at file offset `at`, through the one descriptor
// the process holds of it (JetBackend Image/Loader.jet x64_self_read). The
// records a compile loads lie all through the part, and a mapped page stays
// mapped once touched (2 MiB at a time where the kernel maps file pages
// huge), so a record is read into memory of its own and none of the part's
// record pages is mapped. The header, table and keys a lookup reads stay
// lent from the mapped image (jet_cli_runtime_part).
JetCLICoreBodiesRecords: struct {
    at: Int,

    impl SemaCoreBodiesRecords {
        read: fn(self, at: Int, size: Int) -[FS, FFI.Asm]> [U8]? {
            x64_self_read(self.at + at, size)
        }
    }
}

// Whether the Core of the toolchain tree `toolchain` is the Core built into
// this jet (JET_CLI_CORE_SOURCES, JET_CLI_CORE_ASSETS): its Core rows
// (jet_cli_toolchain_core_rows), then each row's file and each embedded
// asset, byte for byte, up to the first difference. A tree that matches
// costs one read of its Core files, about 20 MB, and no hash.
jet_cli_core_tree_matches: fn(toolchain: String) -> Bool Never! {
    rows: jet_cli_toolchain_core_rows(toolchain) ?? return false
    if rows.len() != CORE_SOURCE_OWNED_ROWS.len() -> return false
    built_in := [String:Int]{}
    loop (index, file) in JET_CLI_CORE_SOURCES -> built_in[file.path] = index
    loop (index, row) in rows {
        known: CORE_SOURCE_OWNED_ROWS[index]
        if row.path != known.path || row.module_name != known.module_name || row.alias != known.alias || row.owner != known.owner || row.owned_members != known.owned_members || row.impl_types != known.impl_types || row.runtime != known.runtime {
            return false
        }
        at: built_in.get(row.path) ?? return false
        text: cli_files.read(jet_cli_authority_path(toolchain, row.path)) ?? return false
        if text != JET_CLI_CORE_SOURCES[at].text -> return false
    }
    loop asset in JET_CLI_CORE_ASSETS {
        bytes: cli_files.read_bytes(jet_cli_authority_path(toolchain, asset.path)) ?? return false
        if bytes != asset.bytes -> return false
    }
    true
}

#Test("the built-in Core sources hold every Core source row and the assets they embed") {
    loop row in CORE_SOURCE_OWNED_ROWS {
        assert(jet_cli_core_source_text(row.path) != None, "{row.path} is built in")
    }
    assert(jet_cli_core_source_text("Core/NoSuch/NoSuch.jet") == None)
    assert((jet_cli_core_asset_bytes("Core/UI/XkbTables/keysym_values.bin") ?? [U8]{}).len() > 0)
    assert(jet_cli_core_asset_bytes("Core/App/App.jet") == None)
}
