// What the Canvas debug session (JetCanvas CanvasDebugSession.jet) of `jet
// dev <file> --canvas` takes from this `jet`: the expression compiler
// `print` and `why` evaluate with (DebugCompile.jet), and the replay of a
// `jet run --record` recording, as `jet debug --replay` runs it (Debug.jet).
use {
    jet_canvas.[CanvasDebugError, CanvasDebugHost, canvas_debug_error]
    jet_debug.[NativeSession]
    jet_foundation.[DeepChecks]
}

// The host of one debug request: `held` is the held check of the program a
// session the request opens debugs (jet_cli_debug_eval_held_slot).
JetCLICanvasDebugHost: struct {
    held: JetCLIDebugEvalHeldShared,

    impl CanvasDebugHost {
        // The held check opens while the image builds, at its level, O0
        // (jet_cli_debug_eval_held_start), from the sources the build reads and
        // its debug info records.
        building: fn(self, entry: String) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> Never! {
            jet_cli_debug_eval_held_start(self.held, entry, jet_cli_debug_eval_argv(DeepChecks{}, 0), program: true)
        }

        evaluate: fn(self, live: &NativeSession, entry: String) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> Never! {
            argv: jet_cli_debug_eval_argv(DeepChecks{}, live.level())
            jet_cli_debug_eval_held_start(self.held, entry, argv)
            live.evaluate_with(JetCLIDebugEvaluator{entry: entry, argv: argv, color: false, held: self.held})
        }

        replay: fn(self, live: &NativeSession, image: String, recording: String, entry: String, scratch: String, args: &[String]) -[FS, Env, Time.Wait]> CanvasDebugError! {
            refusal := JetCLIProveRefusal?{None}
            if jet_cli_debug_replay_env(recording, entry, scratch, args) == {
                .Ok(env) -> { live.env = Val(env) }
                .Err(refused) -> { refusal = Val(refused) }
            }
            if refusal == None && !live.replay_start {
                refusal = Val(jet_cli_debug_unstarted(image, "replay its recording"))
            }
            refused: refusal ?? return Ok()
            Err(canvas_debug_error("diagnostic", jet_cli_prove_refused(refused, false, false).stderr))
        }
    }
}

// A host for one debug request, with a held check of its own.
jet_cli_canvas_debug_host: fn() -> JetCLICanvasDebugHost {
    JetCLICanvasDebugHost{held: jet_cli_debug_eval_held_slot()}
}
