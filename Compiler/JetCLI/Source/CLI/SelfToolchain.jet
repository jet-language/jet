// run_toolchain/require_manifest_root and maybe_dispatch_pinned_toolchain. Root
// selection is the checked package authority, not receipt/repository selection
// or a text scan.
use {
    cli_files: core.files
    cli_process: core.process
    jet_foundation.[diagnostic_render_all, effect_vocabulary_enum_names, effect_vocabulary_list_view_count, effect_vocabulary_lowered]
    jet_pkg_model.[JET_VERSION, WorkspaceDeclarationCache]
    jet_driver.[JetDriverVerbOutput, JET_DRIVER_EXIT_USER_ERROR]
    jetpack_foundation.[TOOLCHAIN_EXEC_MARKER_ENV]
    jetpack_trust.[trust_pin_decide, trust_pin_handoff_line, trust_pin_report]
}

// The manifest-driven verbs a version-pinned project hands to its pinned `jet`.
JET_CLI_PINNED_VERBS: [String]{"run", "build", "test", "check", "fill", "jobs"}

// Each pinned verb runs a JetCLIPlan of its name; JET_CLI_PINNED_VERB_COUNT
// stops the build naming any verb that is not one.
JET_CLI_PINNED_VERB_COUNT: #run effect_vocabulary_list_view_count("CLI/SelfToolchain.jet", JET_CLI_PINNED_VERBS, "JET_CLI_PINNED_VERBS", effect_vocabulary_lowered(effect_vocabulary_enum_names("CLI/Front.jet", embed_file("Front.jet"), "JetCLIPlan")), "`JetCLIPlan` in CLI/Front.jet", [String]{})

jet_cli_self_toolchain: fn(json: Bool) -[FS, Env]> JetCLIPlan Never! {
    cwd: cli_files.cwd() ?? "."
    cache := WorkspaceDeclarationCache.new()
    root := String?{None}
    if jet_cli_find_package_root_checked(cache, cwd) == {
        .Ok(found) -> root = found
        .Err(error) -> return jet_cli_done("", diagnostic_render_all(JET_CLI_PACKAGE_FILE, "", [error.diagnostic], false), JET_DRIVER_EXIT_USER_ERROR)
    }
    if root == .Val(path) -> return jet_cli_renderable(trust_pin_report(path), json)
    jet_cli_done("", "Error: `jet self toolchain` needs a project — no `package.jet` found here or above\n", JET_DRIVER_EXIT_USER_ERROR)
}

// A pinned project runs the verb on its pinned toolchain: None when this `jet`
// satisfies the pin (or there is no pin or project), otherwise the pin's
// refusal or the pinned toolchain's own run. The project is the one the verb
// builds: the package owning `target` (a source file or directory argument)
// when the verb names one, the working directory's otherwise, so the pin means
// the same thing whatever directory the verb runs from. `cache` is the
// command's discovery cache, which its run receipt walks again.
jet_cli_pinned_toolchain: fn(cache: ^WorkspaceDeclarationCache, raw: [String], target: String?, color: Bool, quiet: Bool) -> JetCLIPlan? {
    start: if target == {
        .Val(path) -> if cli_files.is_dir(path) -> path else -> jet_cli_parent(path) ?? "."
        .None -> cli_files.cwd() ?? "."
    }
    found := String?{None}
    if jet_cli_find_package_root_checked(cache, start) == {
        .Ok(value) -> found = value
        .Err(_) -> return None
    }
    root: found ?? return None
    offline: raw.contains("--offline") || raw.contains("--locked")
    if trust_pin_decide(root, JET_VERSION, offline) == {
        .RunNative -> None
        .Report(diagnostic) -> Val(JetCLIPlan.Refused{report: diagnostic, color: color, exit_code: JET_DRIVER_EXIT_USER_ERROR, notice: ""})
        .ReExec(binary, channel, version) -> Val(JetCLIPlan.Done{output: jet_cli_pinned_exec(binary, channel, version, raw, quiet)})
    }
}

// The pinned binary runs the same argv on inherited stdio, marked so it runs
// natively; its exit status is this run's (a signal-ended child exits 1).
jet_cli_pinned_exec: fn(binary: String, channel: String, version: String, raw: [String], quiet: Bool) -> JetDriverVerbOutput {
    if !quiet -> jet_cli_write_notice("{trust_pin_handoff_line(channel, version, JET_VERSION)}\n")
    command := [String]{binary}
    loop argument in raw -> command.push(argument.copy())
    receipt: cli_process.cmd(command).env(TOOLCHAIN_EXEC_MARKER_ENV, version).stdin(.Inherit).stdout(.Inherit).stderr(.Inherit).run() ?? return jet_cli_report_output("", "E2105", "couldn't exec the pinned toolchain `{binary}`: {jet_cli_io_error_text(err)}", jet_cli_why("E2105"), "correct the named problem, then run the command again", false, JET_DRIVER_EXIT_USER_ERROR)
    exit_code := receipt.code
    if receipt.signal != None -> exit_code = JET_DRIVER_EXIT_USER_ERROR
    JetDriverVerbOutput{stdout: "", stderr: "", exit_code: exit_code}
}
