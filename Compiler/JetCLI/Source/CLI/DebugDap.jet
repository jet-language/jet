// `jet debug --dap <file.jet>`: the Debug Adapter Protocol over stdio, as an
// editor's launch configuration starts it (VS Code's `debugAdapter`
// executable). Each request is one `Content-Length` framed JSON object on
// stdin; each response and event is one on stdout. The adapter drives the
// NativeSession the `(Jet)` console drives, loaded before the first request,
// so `setBreakpoints` is verified against the image's line table at once.
// `launch` takes `stopOnEntry` and `args`; the program runs from
// `configurationDone`. Run control is synchronous: `continue`, `next`,
// `stepIn` and `stepOut` answer, run to the next stop and report it (`output`
// with the program's new output, then `stopped`, or `exited` and
// `terminated`). One thread, frames are the Jet frames, and a frame's one
// scope holds its locals as the console shows them, each with its Jet type.
// A breakpoint may carry a `condition` and a `logMessage`, and `evaluate`
// answers an expression in a paused frame (DebugEval.jet). A hit whose
// condition is false, or a logpoint's hit (which logs its message), does not
// stop: a continue runs on, and a step goes on to where it would have
// stopped.
// The end of stdin or `disconnect` ends the program and the adapter.
use {
    dap_files: core.files
    dap_json: core.encoding.json
    dap_term: core.term
    jet_debug.[DebugExpression, NativeDebugError, NativeLocal, NativeSession, NativeStop, NativeStopKind, debug_parse_expression, debug_parse_message, native_debug_hit_breakpoint, native_debug_jet_frame]
    jet_foundation.[ast_expr, foundation_json_integer, foundation_json_quote]
}

// One `setBreakpoints` entry: its line, and its condition and log message
// ("" for none).
JetCLIDapBreakpoint: struct {
    line: Int
    condition: String
    log: String
}

// A placed breakpoint's condition and log message, parsed.
JetCLIDapRule: struct {
    condition: DebugExpression?
    log: DebugExpression?
}

// Where a run stopped, and the breakpoint the stop reports (None for the end
// of a step, a pause or the program).
JetCLIDapStop: struct {
    stop: NativeStop
    hit: Int?
}

// One request: its sequence number, its command and its arguments' members.
JetCLIDapRequest: struct {
    seq: Int
    command: String
    arguments: [(key: String, value: Dyn)]
}

// The adapter's state across requests.
JetCLIDap: struct {
    // The last message's sequence number.
    seq: Int
    stop_on_entry: Bool
    args: [String]
    // The breakpoints each source file's `setBreakpoints` placed.
    placed: [String:[Int]]
    // The conditions and log messages of the placed breakpoints, by number.
    rules: [Int:JetCLIDapRule]
    launched: Bool

    handle: fn(&self, session: &NativeSession, input: &&JetCLIDapRequest, entry: String) -[FS, Env, Exec, IO, Time.Wait, FFI.Asm]> Never! {
        request := input.move()
        if request.command == {
            "initialize" -> {
                self.respond(request, "{{\"supportsConfigurationDoneRequest\":true,\"supportsConditionalBreakpoints\":true,\"supportsLogPoints\":true,\"supportsEvaluateForHovers\":true}}")
            }
            "launch" -> {
                self.stop_on_entry = jet_cli_dap_bool(request.arguments, "stopOnEntry")
                self.args = jet_cli_dap_texts_of(request.arguments.move(), "args")
                request.arguments = [(key: String, value: Dyn)]{}
                self.respond(request, "{{}}")
                self.event("initialized", "{{}}")
            }
            "setBreakpoints" -> {
                if self.set_breakpoints(session, request) == {
                    .Ok(body) -> { self.respond(request, body) }
                    .Err(failure) -> self.fail(request, failure.detail)
                }
            }
            "configurationDone" -> {
                self.respond(request, "{{}}")
                if self.launched {
                    return
                }
                self.launched = true
                if self.start(session) == {
                    // Only `stopOnEntry` stops for the entry; otherwise the
                    // first stop is a breakpoint's, or a pause.
                    .Ok(stop) -> {
                        self.report(session, stop, if self.stop_on_entry -> "entry" else -> "pause")
                    }
                    .Err(failure) -> self.stopped_by(failure)
                }
            }
            "threads" -> self.respond(request, "{{\"threads\":[{{\"id\":1,\"name\":\"run\"}}]}}")
            "stackTrace" -> {
                if !self.launched || !session.alive() {
                    return self.fail(request, "the program is not paused")
                }
                if jet_cli_dap_stack(session, entry) == {
                    .Ok(body) -> { self.respond(request, body) }
                    .Err(failure) -> self.fail(request, failure.detail)
                }
            }
            "scopes" -> {
                frame: jet_cli_dap_int(request.arguments, "frameId")
                self.respond(request, "{{\"scopes\":[{{\"name\":\"Locals\",\"presentationHint\":\"locals\",\"variablesReference\":{frame + 1},\"expensive\":false}}]}}")
            }
            "variables" -> {
                if !self.launched || !session.alive() {
                    return self.fail(request, "the program is not paused")
                }
                if jet_cli_dap_variables(session, jet_cli_dap_int(request.arguments, "variablesReference") - 1) == {
                    .Ok(body) -> { self.respond(request, body) }
                    .Err(failure) -> self.fail(request, failure.detail)
                }
            }
            "evaluate" -> {
                if !self.launched || !session.alive() {
                    return self.fail(request, "the program is not paused")
                }
                if jet_cli_dap_evaluate(session, jet_cli_dap_string(request.arguments, "expression"), jet_cli_dap_int(request.arguments, "frameId")) == {
                    .Ok(body) -> { self.respond(request, body) }
                    .Err(failure) -> self.fail(request, failure.message)
                }
            }
            "continue" | "next" | "stepIn" | "stepOut" -> {
                if !self.launched || !session.alive() {
                    return self.fail(request, "the program is not paused")
                }
                self.respond(request, if request.command == "continue" -> "{{\"allThreadsContinued\":true}}" else -> "{{}}")
                word: if request.command == {
                    "continue" -> "c"
                    "next" -> "n"
                    "stepIn" -> "s"
                    else -> "f"
                }
                if self.run(session, word) == {
                    .Ok(stop) -> {
                        self.report(session, stop, if word == "c" -> "pause" else -> "step")
                    }
                    .Err(failure) -> self.stopped_by(failure)
                }
            }
            else -> self.fail(request, "`jet debug --dap` does not answer `{request.command}`")
        }
    }

    // `setBreakpoints`: the source's breakpoints become the requested lines,
    // each with its condition and log message. One whose condition or
    // message is not a Jet expression is not placed.
    set_breakpoints: fn(&self, session: &NativeSession, request: JetCLIDapRequest) -> String NativeDebugError! {
        file := ""
        specs := [JetCLIDapBreakpoint]{}
        loop member in request.arguments {
            if member.key == "source" && member.value == .Object(source) {
                loop part in source {
                    if part.key == "path" && part.value == .Text(path) {
                        file = dap_files.basename(path)
                    }
                }
            }
            if member.key == "breakpoints" && member.value == .Array(items) {
                loop item in items {
                    if item == .Object(spec) {
                        specs.push(JetCLIDapBreakpoint{line: jet_cli_dap_int(spec, "line"), condition: jet_cli_dap_string(spec, "condition"), log: jet_cli_dap_string(spec, "logMessage")})
                    }
                }
            }
        }
        old: self.placed.get(file) ?? [Int]{}
        loop number in old {
            session.delete_breakpoint(number) ?? return Err(err)
            self.rules.remove(number).drop("a breakpoint with no condition and no log message has no rule")
        }
        numbers := [Int]{}
        rows := [String]{}
        loop spec in specs {
            line: spec.line
            rule := JetCLIDapRule?{None}
            if jet_cli_dap_rule(spec) == {
                .Ok(parsed) -> { rule = parsed }
                .Err(failure) -> {
                    rows.push("{{\"verified\":false,\"line\":{line},\"message\":{foundation_json_quote(failure.message)}}}")
                    next
                }
            }
            placed := -1
            if file != "" && line >= 1 {
                if session.break_at(file, line) == {
                    .Ok(found) -> placed = found ?? -1
                    .Err(failure) -> return Err(failure)
                }
            }
            if placed >= 0 {
                numbers.push(placed)
                if rule == .Val(found) -> self.rules[placed] = found
            }
            rows.push(if placed >= 0 -> "{{\"id\":{placed},\"verified\":true,\"line\":{line}}}" else -> "{{\"verified\":false,\"line\":{line},\"message\":{foundation_json_quote("No code on {file}:{line}")}}}")
        }
        self.placed[file.move()] = numbers.move()
        Ok("{{\"breakpoints\":[{rows.join(",")}]}}")
    }

    // `configurationDone`: run the program from its start, to the start of
    // `run` under `stopOnEntry`.
    start: fn(&self, session: &NativeSession) -[FS, Exec, IO, Time.Wait, FFI.Asm]> JetCLIDapStop NativeDebugError! {
        if !self.stop_on_entry {
            first: session.launch(self.args) ?? return Err(err)
            return self.settle(session, first, "c", 0)
        }
        entry := -1
        if session.break_in("run") == {
            .Ok(found) -> entry = found ?? -1
            .Err(failure) -> return Err(failure)
        }
        stop: session.launch(self.args) ?? return Err(err)
        if entry >= 0 -> session.delete_breakpoint(entry) ?? return Err(err)
        Ok(JetCLIDapStop{stop: stop, hit: None})
    }

    // Run `word` (`c`, `n`, `s` or `f`, as NativeSession.advance takes it)
    // and settle where it stops.
    run: fn(&self, session: &NativeSession, word: String) -[FS, Exec, IO, Time.Wait, FFI.Asm]> JetCLIDapStop NativeDebugError! {
        depth: if word == "c" -> 0 else -> jet_cli_dap_depth(session) ?? return Err(err)
        first: session.advance(word) ?? return Err(err)
        self.settle(session, first, word, depth)
    }

    // The stop to report after `word` (begun `depth` Jet frames deep) first
    // stopped at `first`. A breakpoint hit that does not stop (`holds`) runs
    // on: a continue continues, and a step goes on to where it would have
    // stopped. A step whose skipped hit was in a call it steps over returns
    // from the call and steps again; a step out returns until it is out.
    settle: fn(&self, session: &NativeSession, first: NativeStop, word: String, depth: Int) -[FS, Exec, IO, Time.Wait, FFI.Asm]> JetCLIDapStop NativeDebugError! {
        stop := first
        returning := false
        loop stop.kind == NativeStopKind.Paused {
            hit: native_debug_hit_breakpoint(stop)
            skipped := false
            if hit == .Val(number) {
                rule: self.rules.get(number) ?? return Ok(JetCLIDapStop{stop: stop, hit: hit})
                stops: self.holds(session, rule) ?? return Err(err)
                if stops -> return Ok(JetCLIDapStop{stop: stop, hit: hit})
                skipped = true
            }
            if !skipped && !returning -> return Ok(JetCLIDapStop{stop: stop, hit: None})
            next_word := "c"
            if word != "c" {
                here: jet_cli_dap_depth(session) ?? return Err(err)
                if word == "s" || (word == "n" && here <= depth && !returning) || (word == "f" && here < depth) {
                    return Ok(JetCLIDapStop{stop: stop, hit: None})
                }
                returning = !(word == "n" && here <= depth)
                next_word = if returning -> "f" else -> "n"
            }
            stop = session.advance(next_word) ?? return Err(err)
        }
        Ok(JetCLIDapStop{stop: stop, hit: None})
    }

    // Whether a hit of the breakpoint with `rule` stops: its condition holds
    // (or it has none) and it is not a logpoint. A logpoint whose condition
    // holds logs its message instead. A condition that can't be evaluated,
    // or is not a Bool, stops, and says why.
    holds: fn(&self, session: &NativeSession, rule: JetCLIDapRule) -[FS, Exec, IO, Time.Wait, FFI.Asm]> Bool NativeDebugError! {
        locals: session.locals() ?? return Err(err)
        if rule.condition == .Val(condition) {
            if jet_cli_dap_condition(condition, locals) == {
                .Ok(flag) -> {
                    if !flag -> return Ok(false)
                }
                .Err(failure) -> {
                    self.say(session, "stderr", "The breakpoint's condition failed: {failure.message}\n")
                    return Ok(true)
                }
            }
        }
        if rule.log == .Val(message) {
            text: if jet_cli_dap_eval(message.tables, message.root, locals) == {
                .Ok(value) -> jet_cli_dap_text(value)
                .Err(failure) -> "<{failure.message}>"
            }
            self.say(session, "console", "{text}\n")
            return Ok(false)
        }
        Ok(true)
    }

    // An `output` event of `category`, after the program's output so far.
    say: fn(&self, session: &NativeSession, category: String, text: String) -[FS, IO, Time.Wait]> Never! {
        output: session.take_output()
        if output != "" {
            self.event("output", "{{\"category\":\"stdout\",\"output\":{foundation_json_quote(output)}}}")
        }
        self.event("output", "{{\"category\":\"{category}\",\"output\":{foundation_json_quote(text)}}}")
    }

    // Where `settled` left the program: its new output, then `stopped` (for
    // `reason` unless a breakpoint stopped it), or its end.
    report: fn(&self, session: &NativeSession, settled: JetCLIDapStop, reason: String) -[FS, IO, Time.Wait]> Never! {
        output: session.take_output()
        if output != "" {
            self.event("output", "{{\"category\":\"stdout\",\"output\":{foundation_json_quote(output)}}}")
        }
        stop: settled.stop
        if stop.kind == {
            .Paused -> {
                hit: settled.hit
                why: if hit != None -> "breakpoint" else -> reason
                ids: if hit == .Val(number) -> ",\"hitBreakpointIds\":[{number}]" else -> ""
                self.event("stopped", "{{\"reason\":\"{why}\",\"threadId\":1,\"allThreadsStopped\":true{ids}}}")
            }
            .Exited -> {
                self.event("exited", "{{\"exitCode\":{stop.code}}}")
                self.event("terminated", "{{}}")
            }
            .Signaled -> {
                self.event("output", "{{\"category\":\"stderr\",\"output\":{foundation_json_quote("Program stopped by {stop.reason}\n")}}}")
                self.event("terminated", "{{}}")
            }
        }
    }

    // A run the native debugger could not finish ends the session.
    stopped_by: fn(&self, failure: NativeDebugError) -[IO, Time.Wait]> Never! {
        self.event("output", "{{\"category\":\"stderr\",\"output\":{foundation_json_quote("{failure.detail}\n")}}}")
        self.event("terminated", "{{}}")
    }

    respond: fn(&self, request: JetCLIDapRequest, body: String) -[IO, Time.Wait]> Never! {
        self.seq += 1
        jet_cli_dap_send("{{\"seq\":{self.seq},\"type\":\"response\",\"request_seq\":{request.seq},\"success\":true,\"command\":{foundation_json_quote(request.command)},\"body\":{body}}}")
    }

    fail: fn(&self, request: JetCLIDapRequest, message: String) -[IO, Time.Wait]> Never! {
        self.seq += 1
        jet_cli_dap_send("{{\"seq\":{self.seq},\"type\":\"response\",\"request_seq\":{request.seq},\"success\":false,\"command\":{foundation_json_quote(request.command)},\"message\":{foundation_json_quote(message)}}}")
    }

    event: fn(&self, name: String, body: String) -[IO, Time.Wait]> Never! {
        self.seq += 1
        jet_cli_dap_send("{{\"seq\":{self.seq},\"type\":\"event\",\"event\":\"{name}\",\"body\":{body}}}")
    }
}

// Answer requests until stdin ends or the editor disconnects.
jet_cli_debug_dap: fn(session: &NativeSession, entry: String) -[FS, Env, Exec, IO, Time.Wait, FFI.Asm]> Never! {
    dap := JetCLIDap{seq: 0, stop_on_entry: false, args: [String]{}, placed: [String:[Int]]{}, rules: [Int:JetCLIDapRule]{}, launched: false}
    loop true {
        text: jet_cli_dap_read() ?? break
        request: jet_cli_dap_request(text)
        if request.command == "disconnect" {
            dap.respond(request, "{{}}")
            break
        }
        dap.handle(session, request.move(), entry)
    }
}

// The next message's JSON text: a header block naming its `Content-Length`,
// then that many bytes. None at the end of stdin. Standard input is read a
// byte at a time up to the body, so no read waits on bytes the editor has not
// sent.
jet_cli_dap_read: fn() -[IO, Time.Wait]> String? Never! {
    input := dap_term.stdin()
    length := -1
    header := [U8]{}
    loop true {
        byte: input.read_bytes(1) ?? return None
        if byte.len() == 0 -> return None
        if byte[0] != 10 {
            header.push(byte[0])
            next
        }
        line: (String.from_bytes(header) ?? "").trim()
        header = [U8]{}
        if line == "" && length >= 0 -> break
        if line.to_lower().starts_with("content-length:") {
            length = Int.parse(line.after(":").trim()) ?? -1
        }
    }
    body := [U8]{}
    loop body.len() < length {
        chunk: input.read_bytes(length - body.len()) ?? return None
        if chunk.len() == 0 -> return None
        body.extend(chunk)
    }
    Val(String.from_bytes(body) ?? return None)
}

jet_cli_dap_send: fn(json: String) -[IO, Time.Wait]> Never! {
    jet_cli_debug_write("Content-Length: {json.bytes().len()}\r\n\r\n{json}")
}

// The request `text` holds; a request that is not a JSON object has no
// command, and is answered as an unknown one.
jet_cli_dap_request: fn(text: String) -> JetCLIDapRequest Never! {
    request := JetCLIDapRequest{seq: 0, command: "", arguments: [(key: String, value: Dyn)]{}}
    parsed: dap_json.parse(text) ?? return request
    fields := jet_cli_dap_members(parsed.move())
    loop fields.len() > 0 {
        field := fields.pop() ?? break
        if field.key == {
            "seq" -> request.seq = jet_cli_dap_number(field.value)
            "command" -> {
                if field.value.move() == .Text(name) -> request.command = name
                field.value = Dyn.Null
            }
            "arguments" -> {
                request.arguments = jet_cli_dap_members(field.value.move())
                field.value = Dyn.Null
            }
            else -> {}
        }
    }
    request
}

// The members of a JSON object, taken out of it; none for another value.
jet_cli_dap_members: fn(value: &&Dyn) -> [(key: String, value: Dyn)] Never! {
    if value.move() == {
        .Object(fields) -> fields
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) -> [(key: String, value: Dyn)]{}
    }
}

// The strings of the array member `name`, in order, taken out of `members`.
jet_cli_dap_texts_of: fn(members: &&[(key: String, value: Dyn)], name: String) -> [String] Never! {
    fields := members.move()
    loop fields.len() > 0 {
        field := fields.pop() ?? break
        if field.key != name -> next
        items := if field.value.move() == {
            .Array(list) -> list
            .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> [Dyn]{}
        }
        field.value = Dyn.Null
        items.reverse()
        texts := [String]{}
        loop items.len() > 0 {
            item: items.pop() ?? break
            if item.move() == .Text(text) -> texts.push(text)
        }
        return texts
    }
    [String]{}
}

// The integer `value` holds, or -1. A parsed JSON number is a `.Number`
// lexeme, which foundation_json_integer reads.
jet_cli_dap_number: fn(value: Dyn) -> Int Never! { foundation_json_integer(value) ?? -1 }

// The integer member `name`, or -1.
jet_cli_dap_int: fn(members: [(key: String, value: Dyn)], name: String) -> Int Never! {
    loop member in members {
        if member.key == name -> return jet_cli_dap_number(member.value)
    }
    -1
}

// The boolean member `name`, or false.
jet_cli_dap_bool: fn(members: [(key: String, value: Dyn)], name: String) -> Bool Never! {
    loop member in members {
        if member.key == name && member.value == .Bool(flag) -> return flag
    }
    false
}

// The string member `name`, or "".
jet_cli_dap_string: fn(members: [(key: String, value: Dyn)], name: String) -> String Never! {
    loop member in members {
        if member.key == name && member.value == .Text(text) -> return text
    }
    ""
}

// A breakpoint's condition and log message, parsed; None when it has
// neither.
jet_cli_dap_rule: fn(spec: JetCLIDapBreakpoint) -> JetCLIDapRule? JetCLIDapEvalError! {
    if spec.condition.trim() == "" && spec.log == "" -> return Ok(None)
    condition: if spec.condition.trim() == "" -> DebugExpression?{None} else -> Val(debug_parse_expression(spec.condition) ?? return Err(jet_cli_dap_eval_error(err.message)))
    log: if spec.log == "" -> DebugExpression?{None} else -> Val(debug_parse_message(spec.log) ?? return Err(jet_cli_dap_eval_error(err.message)))
    Ok(Val(JetCLIDapRule{condition: condition, log: log}))
}

// The Jet frames on the stack.
jet_cli_dap_depth: fn(session: &NativeSession) -> Int NativeDebugError! {
    frames: session.backtrace() ?? return Err(err)
    count := 0
    loop frame in frames {
        if native_debug_jet_frame(frame) -> count += 1
    }
    Ok(count)
}

// `stackTrace`: the Jet frames, innermost first, each by its index in the
// session's backtrace, which `scopes` and `variables` name it by.
jet_cli_dap_stack: fn(session: &NativeSession, entry: String) -> String NativeDebugError! {
    frames: session.backtrace() ?? return Err(err)
    base: if entry.starts_with("/") -> dap_files.dirname(entry) else -> dap_files.join(dap_files.cwd() ?? ".", dap_files.dirname(entry))
    rows := [String]{}
    loop (index, frame) in frames {
        if !native_debug_jet_frame(frame) -> next
        source: "{{\"name\":{foundation_json_quote(dap_files.basename(frame.file))},\"path\":{foundation_json_quote(dap_files.join(base, frame.file))}}}"
        rows.push("{{\"id\":{index},\"name\":{foundation_json_quote(frame.function)},\"source\":{source},\"line\":{frame.line},\"column\":1}}")
    }
    Ok("{{\"stackFrames\":[{rows.join(",")}],\"totalFrames\":{rows.len()}}}")
}

// The locals of frame `frame` (an index in the session's backtrace). The
// innermost frame stays selected, as stepping needs.
jet_cli_dap_frame_locals: fn(session: &NativeSession, frame: Int) -> [NativeLocal] NativeDebugError! {
    if frame > 0 -> _: session.select_frame(frame) ?? return Err(err)
    locals: session.locals() ?? return Err(err)
    if frame > 0 -> _: session.select_frame(0) ?? return Err(err)
    Ok(locals)
}

// `variables` of frame `frame`'s scope: its locals by name, with their Jet
// types.
jet_cli_dap_variables: fn(session: &NativeSession, frame: Int) -> String NativeDebugError! {
    if frame < 0 -> return Ok("{{\"variables\":[]}}")
    locals := jet_cli_dap_frame_locals(session, frame) ?? return Err(err)
    locals.sort_by(fn(left: NativeLocal, right: NativeLocal) { left.name <=> right.name })
    rows := [String]{}
    loop local in locals {
        rows.push("{{\"name\":{foundation_json_quote(local.name)},\"value\":{foundation_json_quote(local.value)},\"type\":{foundation_json_quote(local.type_name)},\"variablesReference\":0}}")
    }
    Ok("{{\"variables\":[{rows.join(",")}]}}")
}

// `evaluate`: `text` in frame `frame` (the innermost when the request names
// none). A local's name answers as `variables` shows it; another expression
// answers with its value.
jet_cli_dap_evaluate: fn(session: &NativeSession, text: String, frame: Int) -> String JetCLIDapEvalError! {
    expr: debug_parse_expression(text) ?? return Err(jet_cli_dap_eval_error(err.message))
    locals: jet_cli_dap_frame_locals(session, if frame > 0 -> frame else -> 0) ?? return Err(jet_cli_dap_eval_error(err.detail))
    shown := (text: "", type_name: "")
    if ast_expr(expr.tables, expr.root) == .Ident(name, _, _) {
        loop local in locals {
            if local.name == name -> shown = (text: local.value, type_name: local.type_name)
        }
    }
    if shown.type_name == "" {
        value: jet_cli_dap_eval(expr.tables, expr.root, locals) ?? return Err(err)
        shown = jet_cli_dap_shown(value)
    }
    Ok("{{\"result\":{foundation_json_quote(shown.text)},\"type\":{foundation_json_quote(shown.type_name)},\"variablesReference\":0}}")
}
