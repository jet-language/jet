// `jet build` runs the graph its `build: fn` declared (spec "Programmable
// builds") as one graph of steps and targets. The session's steps lower onto
// the one hermetic executor (Jetpack/Store/Source/Build), which runs the ready
// ones together in the native sandbox against the local action cache
// (`JET_STORE_DIR`); every grant is checked and every probe run before
// anything runs. Each run records the graph it built and how long each part
// took under `.jet/build`.
use {
    cli_files: core.files
    build_crypto: core.crypto
    cli_sys: core.sys
    cli_time: core.time
    core.build.[BuildGraph, BuildGraphAction]
    jet_driver.[BUILD_SESSION_HOST_DIR, BUILD_SESSION_IMAGE_DIR, BuildPlanExecution, BuildPlanSelection, BuildSessionAction, BuildSessionFile, BuildSessionGeneratedModule, BuildSessionTarget, BuildSessionToolchain]
    jet_driver.[JetDriverAuthorityPolicy, JetDriverAuthorizedSourceFile, JetDriverBuildKept, JetDriverBuildPackageSettings, JetDriverBuildTime, JetDriverFailure, JetDriverGeneratedModule, JetDriverSourceDocument, JetDriverVerbOutput, JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USER_ERROR, jet_driver_build_graph_json, jet_driver_build_times_json]
    jet_foundation.[AuthorityVerdict, BUILD_REUSE_SAVED_WORK, BuildOptions, Diagnostic, build_option_duration_ms, build_options_value, compiler_threads_failure_text, compiler_threads_join, compiler_threads_leave, diagnostic_from_registry, diagnostic_registry_row, diagnostic_render_all, jet_target_triple_os, target_os_key]
    jet_pkg_model.[OverlayPolicy, WorkspaceDeclarationCache, pkg_build_entry_source, pkg_parse_workspace_policy, pkg_resolve_workspace_source]
    jetpack_build.[
        ActionOutcome,
        ActionSpec,
        BuildArtifactStoreHandle,
        BuildExecutionError,
        BuildProbeFact,
        BuildProvenance,
        ContentDigest,
        HermeticActionHandle,
        HermeticBuildContext,
        HermeticBuildError,
        HermeticBuildPlan,
        LinkerIdentity,
        ProbeHandle,
        ProbeSpec,
        SDKIdentity,
        SigningIdentityHandle,
        SigningIdentitySpec,
        SysrootIdentity,
        TargetRef,
        TargetSpec,
        ToolchainHandle,
        ToolchainSpec,
        build_action_failure_stderr,
        build_execute_actions,
        build_execute_probes,
        build_execution_batches,
        build_probes_run_sandboxed,
    ]
    jetpack_foundation.[BuildEffect, NATIVE_SANDBOX_FIX, foundation_native_sandbox_prepare]
}

// Whether `source` declares the build entry `build: fn(b: Build)`, as the
// Driver's build query selects it (jet_driver_query_build_plan); any other
// top-level `build: fn` is ordinary code.
jet_cli_declares_build_entry: fn(source: String) -> Bool Never! {
    jet_cli_build_entry_lines(source).len() > 0
}

// Whether the package enclosing `file` declares its build entry in another of
// its source files or in `package.jet` (spec "Programmable builds": the entry
// may live in any package source file or in `package.jet`; the build query
// selects it). A package root or source tree that does not resolve is left to
// the compile, which reports why.
jet_cli_package_declares_build_entry: fn(file: String) -[FS, Env]> Bool Never! {
    ^cache: WorkspaceDeclarationCache.new()
    ^found: String?{None}
    if jet_cli_find_package_root_checked(cache, jet_cli_parent(file) ?? ".") == {
        .Ok(value) -> found = value
        .Err(_) -> return false
    }
    root: found ?? return false
    ^files: [JetDriverAuthorizedSourceFile]{}
    if jet_cli_package_sources(root, files) != None -> return false
    loop source_file in files {
        if jet_cli_declares_build_entry(source_file.source) -> return true
    }
    manifest: jet_cli_checked_file(root, JET_CLI_PACKAGE_FILE) ?? return false
    source: cli_files.read(manifest) ?? return false
    pkg_build_entry_source(source) != None
}

// One node of the graph a package build runs: a step (`id` its action), an
// executable compiled to its image (`id` its target; selected, or one whose
// image a step reads), a selected library checked (`id` its index in the
// selection's list), or a target only steps run, built for the machine
// running the build (`id` its target). `name` is the step's or target's own;
// `needs` are the nodes that finish before it starts.
JetCLIBuildNode: struct {
    kind: JetCLIBuildNodeKind,
    id: Int,
    name: String,
    needs: [Int],
}

JetCLIBuildNodeKind: enum {
    Step,
    Image,
    Library,
    Host,
}

// The steps a build runs, the targets it builds for the machine running it
// (`b.host`), and the targets whose image a step reads (`b.image`); the
// steps use each such target whether or not it is selected.
JetCLIBuildNeeds: struct {
    steps: [Int],
    host: [Int],
    images: [Int],
}

// Run the graph `build: fn` declared under the project root `root`, as one
// graph of steps and targets: the selected targets, the steps they need and
// their prerequisites, and every target a step runs as its `b.host` tool or
// reads as its `b.image`.
// Every step's effects are granted (by the package `policy`, the enclosing
// workspace's build policy and this invocation) and every probe ran before
// anything else does. Then whatever has its inputs ready runs: the ready
// steps together in the native sandbox, up to `threads` at once, and each
// ready target compiles (an executable, into its image and, when a step runs
// it, its host copy, or reads its image, a copy at `.jet/build/image/`) or is
// checked (a library). A failure stops only what
// waits on it, and every failure is reported. `member` names the workspace
// member a workspace build runs this graph for; its invocation grant is
// None. A step without its own time limit gets the `action_timeout` option.
// `receipt` is the graph's core.build projection, which the run records with
// `made`, every module `build: fn` generated, and `settings`, each package's
// resolved settings. An
// output kept in git (`kept: true`) may replace a file no build made; the
// last build's receipt tells a hand edit of one from the bytes it wrote.
jet_cli_build_run_graph: fn(graph: BuildPlanExecution, receipt: BuildGraph, made: [BuildSessionGeneratedModule], settings: [JetDriverBuildPackageSettings], selected: BuildPlanSelection, root: String, policy: JetDriverAuthorityPolicy?, invocation: JetCLIInvocationAuthority?, member: String?, options: BuildOptions, threads: Int?, generated: [JetDriverGeneratedModule], trace_sink: JetCLITraceSink?, color: Bool) -> JetDriverVerbOutput {
    action_timeout_ms: build_option_duration_ms(build_options_value(options, "action_timeout")) ?? panic("the resolved `action_timeout` is a checked duration")
    if graph.actions.len() == 0 && graph.probes.len() == 0 {
        ^nodes: [JetCLIBuildNode]{}
        loop index in 0..<selected.executables.len() {
            nodes.push(JetCLIBuildNode{kind: .Image, id: selected.executables[index].target, name: selected.executables[index].name.copy(), needs: [Int]{}})
        }
        loop index in 0..<selected.libraries.len() {
            nodes.push(JetCLIBuildNode{kind: .Library, id: index, name: selected.libraries[index].name.copy(), needs: [Int]{}})
        }
        return jet_cli_build_run_nodes(nodes, None, None, [BuildEffect]{}, [BuildProbeFact]{}, graph, receipt, made, settings, selected, JetCLIBuildNeeds{steps: [Int]{}, host: [Int]{}, images: [Int]{}}, root, member, options, threads, invocation, generated, [String:String]{}, trace_sink, color)
    }
    ^workspace: OverlayPolicy.empty()
    // copy: `refused` is a payload view of the policy read's result.
    if jet_cli_build_workspace_policy(workspace, root) == .Val(refused) {
        return jet_cli_build_policy_refused(refused.copy(), color)
    }
    last: jet_cli_build_last(root)
    plan: jet_cli_build_hermetic_plan(graph, action_timeout_ms, last.kept) ?? return jet_cli_ice("the checked build plan does not lower to the executor's graph: {err.debug_text()}")
    prereqs: plan.action_prereqs() ?? return jet_cli_ice("the checked build plan is not a valid executor graph: {err.debug_text()}")
    needs: jet_cli_build_needs(graph, plan, selected, prereqs) ?? return jet_cli_ice("the checked build plan is not a valid executor graph: {err.debug_text()}")
    nodes: jet_cli_build_nodes(graph, selected, needs, prereqs)
    cycle: jet_cli_build_cycle(nodes)
    if cycle.len() > 0 {
        return jet_cli_build_execution_failed("E3502", "these steps and targets each wait on another of them, so none can start: {cycle.join(", ")}", None, "a step can't run a tool built from its own output; build the tool from sources no step it feeds makes", color)
    }
    if needs.host.len() > 0 && !(cli_sys.is_linux() && cli_sys.arch() == "x86_64") {
        tool: graph.targets[needs.host[0]].name
        return jet_cli_build_execution_failed("E3502", "step tool `b.host({tool})` must build `{tool}` for this machine ({cli_sys.name()} {cli_sys.arch()}), and the native backend writes Linux x86-64 images only", None, "run this build on Linux x86-64", color)
    }
    // A `build: fn` builds Linux x86-64 images (a web build of one is refused
    // before its plan), which a step's sandbox runs only on such a machine.
    if !(cli_sys.is_linux() && cli_sys.arch() == "x86_64") {
        loop step in needs.steps {
            tool: graph.files[graph.actions[step].tool]
            if tool.kind != "image" -> next
            name: graph.targets[tool.target ?? panic("an image names its target")].name
            return jet_cli_build_execution_failed("E3502", "step `{graph.actions[step].name}` runs `b.image({name})`, a Linux x86-64 image, which a step's sandbox on this machine ({cli_sys.name()} {cli_sys.arch()}) can't run", None, "run this build on Linux x86-64", color)
        }
    }
    // copy: `overwritten` is a payload view of the check's result.
    if jet_cli_build_overwrite(root, graph, needs.steps, last.made) == .Val(overwritten) {
        return jet_cli_build_execution_failed("E3502", overwritten.copy(), None, "move the file, declare the step's output at another path, or keep the file in git with `.output(path, kept: true)`", color)
    }
    granted: jet_cli_build_steps_granted(plan, graph, needs.steps, needs.host, root, workspace, policy, invocation, member, color)
    if granted.move() == {
        .Refused(output) -> output
        .Granted(grants, probes) -> {
            // Steps reuse saved work only while it is reused
            // (BUILD_REUSE_SAVED_WORK, off): a default build opens no store,
            // and every step runs.
            ^store: BuildArtifactStoreHandle?{None}
            if BUILD_REUSE_SAVED_WORK && needs.steps.len() > 0 {
                store = Val(BuildArtifactStoreHandle.open() ?? return jet_cli_build_execution_failed("E3505", "couldn't open the build store: {err.message()}", None, "point `JET_STORE_DIR` at a writable store directory", color))
            }
            jet_cli_build_run_nodes(nodes, Val(plan), store, grants, probes, graph, receipt, made, settings, selected, needs, root, member, options, threads, invocation, generated, last.kept, trace_sink, color)
        }
    }
}

// What the steps of a run start with, the effects granted to them and the
// facts of the probes they read, else the report of what refused them.
JetCLIBuildGranted: enum {
    Granted(grants: [BuildEffect], probes: [BuildProbeFact]),
    Refused(output: JetDriverVerbOutput),
}

// Make ready to run `steps` of `plan` (`graph` lowered) and build the `host`
// targets, under the project root `root`: every step's effects are granted
// (by the package `policy`, the enclosing `workspace`'s build policy and this
// invocation), every probe they and the targets read runs, the native
// sandbox is made usable, and each listed package's file a step reads is
// copied where its sandbox reads it.
jet_cli_build_steps_granted: fn(plan: HermeticBuildPlan, graph: BuildPlanExecution, steps: [Int], host: [Int], root: String, workspace: OverlayPolicy, policy: JetDriverAuthorityPolicy?, invocation: JetCLIInvocationAuthority?, member: String?, color: Bool) -[FS, Env, Exec, IO, Net, Time, Rand]> JetCLIBuildGranted Never! {
    grants: jet_cli_build_grants(policy, workspace, invocation)
    loop step in steps {
        action: plan.actions[step]
        loop cap in action.caps {
            if !grants.contains(cap) {
                return JetCLIBuildGranted.Refused{output: jet_cli_build_execution_error(BuildExecutionError.MissingGrant{action: action.name, capability: cap}, member, color)}
            }
        }
    }
    ^probe_ids: plan.selected_probe_ids() ?? return JetCLIBuildGranted.Refused{output: jet_cli_ice("the checked build plan is not a valid executor graph: {err.debug_text()}")}
    loop step in steps {
        loop probe in plan.actions[step].probes {
            if !probe_ids.contains(probe.id) -> probe_ids.push(probe.id)
        }
    }
    loop target in host {
        loop probe in graph.targets[target].probes {
            if !probe_ids.contains(probe) -> probe_ids.push(probe)
        }
    }
    probe_ids.sort()
    if probe_ids.len() > 0 && !grants.contains(BuildEffect.Exec) {
        return JetCLIBuildGranted.Refused{output: jet_cli_build_execution_error(BuildExecutionError.MissingGrant{action: "probe {plan.probes[probe_ids[0]].name}", capability: BuildEffect.Exec}, member, color)}
    }
    // Steps and the probes that run a program run only in the native sandbox:
    // make it usable before the first of them, fetching Jet's pinned
    // Bubblewrap on first need. A probe that only reads the host (finding a
    // program or a folder) reports its own failure first.
    sandboxed_probes: build_probes_run_sandboxed(plan, probe_ids)
    if sandboxed_probes {
        if foundation_native_sandbox_prepare() == .Err(error) {
            return JetCLIBuildGranted.Refused{output: jet_cli_build_execution_error(BuildExecutionError.SandboxUnavailable{reason: error.message()}, member, color)}
        }
    }
    probes: build_execute_probes(plan, probe_ids) ?? return JetCLIBuildGranted.Refused{output: jet_cli_build_execution_error(err, member, color)}
    if steps.len() > 0 && !sandboxed_probes {
        if foundation_native_sandbox_prepare() == .Err(error) {
            return JetCLIBuildGranted.Refused{output: jet_cli_build_execution_error(BuildExecutionError.SandboxUnavailable{reason: error.message()}, member, color)}
        }
    }
    // A file of a listed package (`b.dependency(name).file(path)`) is copied
    // to its `.jet/deps/<name>/` path, where a step's sandbox reads it; a
    // folder of one is bound there in the sandbox instead.
    loop file in graph.files {
        if file.kind == "folder" -> next
        from: file.from ?? next
        to: jet_cli_entry_join(root, file.path)
        folder: jet_cli_parent(to) ?? root
        cli_files.create_dir_all(folder) ?? return JetCLIBuildGranted.Refused{output: jet_cli_build_failed("couldn't create `{folder}` for the package files steps read: {err}", jet_cli_why("E2105"), "make `{folder}` writable", color)}
        cli_files.copy2(from, to) ?? return JetCLIBuildGranted.Refused{output: jet_cli_build_failed("couldn't copy the package file `{from}` a step reads: {err}", jet_cli_why("E2105"), "correct the path given to `.file(path)` on `b.dependency(name)`", color)}
    }
    JetCLIBuildGranted.Granted{grants: grants, probes: probes}
}

// Run `nodes` to the end: whatever has its inputs ready starts as soon as
// they are, until nothing more can. The ready steps run together on a task
// of their own, one set at a time; each ready target compiles on a task of
// its own, at most JET_CLI_BUILD_TARGETS_AT_ONCE at once, the compiles
// sharing the build's threads (compiler_threads_join). A target compiles
// while steps run only when it reads nothing they write
// (jet_cli_build_target_apart); otherwise it starts once they finish, and
// steps that would write what a compiling target reads start once it
// finishes. A node waiting on a failed one never starts. Every failure is
// reported, in node order whatever order the nodes finished in. Then the
// run records `receipt`, `made` and `settings`, with each step's reuse,
// the digest of each kept output (`last_kept` the last build's), and the
// time of every node that ran, in node order (jet_cli_build_record).
// Without `store` no step is reused and nothing is stored. A file trace also
// takes the trace of every jet process a step starts
// (jet_cli_build_splice_traces). The steps run with the build's thread cap,
// `threads` or the one this jet was handed (jet_cli_build_threads), which
// each jet they start keeps to.
jet_cli_build_run_nodes: fn(nodes: [JetCLIBuildNode], plan: HermeticBuildPlan?, store: BuildArtifactStoreHandle?, grants: [BuildEffect], probes: [BuildProbeFact], graph: BuildPlanExecution, receipt: BuildGraph, made: [BuildSessionGeneratedModule], settings: [JetDriverBuildPackageSettings], selected: BuildPlanSelection, needs: JetCLIBuildNeeds, root: String, member: String?, options: BuildOptions, threads: Int?, invocation: JetCLIInvocationAuthority?, generated: [JetDriverGeneratedModule], last_kept: [String:String], trace_sink: JetCLITraceSink?, color: Bool) -> JetDriverVerbOutput {
    ^step_threads: threads
    if step_threads == None -> step_threads = jet_cli_build_threads()
    jobs: step_threads ?? cli_sys.cpu_count()
    traces: jet_cli_build_step_traces(root, trace_sink)
    // Per node: JET_CLI_BUILD_WAITING, _RUNNING, _DONE, _FAILED or
    // _NEVER_STARTED; its failure and its time once it finished.
    ^states: [Int]{}
    ^failed: [JetDriverVerbOutput?]{}
    ^timed: [JetDriverBuildTime?]{}
    loop _ in nodes {
        states.push(JET_CLI_BUILD_WAITING)
        failed.push(None)
        timed.push(None)
    }
    // Per step that ran: whether the store gave back its outputs.
    ^reused: [Int:Bool]{}
    ^stepping: false
    ^compiling: 0
    { sender: done, receiver: finished }: channel<JetCLIBuildDone>()
    task.group build_nodes {
        loop {
            ^ready_steps: [Int]{}
            ^ready_targets: [Int]{}
            loop index in 0..<nodes.len() {
                if states[index] != JET_CLI_BUILD_WAITING -> next
                ^blocked: false
                ^waiting: false
                loop need in nodes[index].needs {
                    if states[need] == JET_CLI_BUILD_FAILED || states[need] == JET_CLI_BUILD_NEVER_STARTED {
                        blocked = true
                    }
                    if states[need] == JET_CLI_BUILD_WAITING || states[need] == JET_CLI_BUILD_RUNNING {
                        waiting = true
                    }
                }
                if blocked {
                    states[index] = JET_CLI_BUILD_NEVER_STARTED
                    next
                }
                if waiting -> next
                if nodes[index].kind == .Step -> ready_steps.push(nodes[index].id) else {
                    ready_targets.push(index)
                }
            }
            if ready_steps.len() > 0 && !stepping && jet_cli_build_steps_apart(nodes, states, graph, selected, root, ready_steps) {
                loop step in ready_steps {
                    states[jet_cli_build_step_node(nodes, step)] = JET_CLI_BUILD_RUNNING
                }
                stepping = true
                task jet_cli_build_steps_task(plan, ready_steps.move(), store, grants, probes, jobs, traces, step_threads, graph, root, trace_sink, done)
            }
            running_steps: jet_cli_build_running_steps(nodes, states)
            loop index in ready_targets {
                if compiling >= JET_CLI_BUILD_TARGETS_AT_ONCE -> break
                if running_steps.len() > 0 && !jet_cli_build_target_apart(nodes[index], graph, selected, root, running_steps) {
                    next
                }
                states[index] = JET_CLI_BUILD_RUNNING
                compiling += 1
                task jet_cli_build_target_task(index, nodes[index], graph, selected, needs, root, options, threads, invocation, generated, trace_sink, color, done)
            }
            if !stepping && compiling == 0 -> break
            message: finished.receive() ?? break
            if message.move() == {
                .Steps(ran) -> {
                    stepping = false
                    loop at in 0..<ran.batches.len() {
                        batch: ran.batches[at]
                        results: ran.results[at]
                        loop index in 0..<batch.len() {
                            node: jet_cli_build_step_node(nodes, batch[index])
                            ^restored: false
                            if results[index] == {
                                .Ok(outcome) -> {
                                    states[node] = JET_CLI_BUILD_DONE
                                    restored = outcome == .RestoredFromCache
                                    reused[batch[index]] = restored
                                }
                                .Err(error) -> {
                                    states[node] = JET_CLI_BUILD_FAILED
                                    failed[node] = Val(jet_cli_build_execution_error(error, member, color))
                                }
                            }
                            timed[node] = Val(JetDriverBuildTime{name: nodes[node].name.copy(), kind: "step", wall_ms: ran.walls[at], reused: restored})
                        }
                    }
                }
                .Target(index, output, wall_ms) -> {
                    compiling -= 1
                    timed[index] = Val(JetDriverBuildTime{name: nodes[index].name.copy(), kind: jet_cli_build_node_kind(nodes[index].kind), wall_ms: wall_ms, reused: output.reused})
                    if output.exit_code == JET_DRIVER_EXIT_OK -> states[index] = JET_CLI_BUILD_DONE else {
                        states[index] = JET_CLI_BUILD_FAILED
                        failed[index] = Val(output)
                    }
                }
                .Stopped(reason) -> panic(reason)
            }
        }
    }
    ^failures: jet_cli_build_in_node_order(failed.move())
    times: jet_cli_build_in_node_order(timed.move())
    kept: jet_cli_build_kept(root, graph, reused, last_kept)
    if jet_cli_build_record(root, receipt, made, settings, reused, kept, times, color) == .Val(unrecorded) {
        failures.push(unrecorded)
    }
    jet_cli_build_failures(failures)
}

// A node's state in jet_cli_build_run_nodes.
JET_CLI_BUILD_WAITING: 0

JET_CLI_BUILD_RUNNING: 1

JET_CLI_BUILD_DONE: 2

JET_CLI_BUILD_FAILED: 3

JET_CLI_BUILD_NEVER_STARTED: 4

// The most targets a build compiles at once. Each compile holds its whole
// program in memory and admits its share of the build's threads, so a third
// would add memory more than speed; two let a long compile overlap the
// targets and steps the rest of the graph runs.
JET_CLI_BUILD_TARGETS_AT_ONCE: 2

// What a task jet_cli_build_run_nodes starts hands back as it ends: the
// steps it ran, a target node's output and wall time, or the panic text of
// a task that stopped, which stops the build as a panic on its own thread
// would.
JetCLIBuildDone: enum {
    Steps(ran: JetCLIBuildStepsRan),
    Target(node: Int, output: JetDriverVerbOutput, wall_ms: Int),
    Stopped(reason: String),
}

// Hands the run loop what a task did; an error means the loop is gone.
jet_cli_build_done_send: fn(done: Sender<JetCLIBuildDone>, value: ^^JetCLIBuildDone) Err! {
    done.send(value)
}

// The rows `slots` holds, in slot (node) order: what finished in any order
// reads the same.
jet_cli_build_in_node_order: fn<T>(slots: ^^[T?]) -> [T] Never! {
    ^rows: [T]{}
    loop slot in slots.move() {
        if slot.move() == .Val(row) -> rows.push(row)
    }
    rows
}

#Test("a build's rows read in node order whatever order the nodes finished in") {
    // Node 2 then node 0 finish; node 1 never does.
    ^early: [String?]{None, None, None}
    early[2] = Val("c")
    early[0] = Val("a")
    ^late: [String?]{None, None, None}
    late[0] = Val("a")
    late[2] = Val("c")
    first: jet_cli_build_in_node_order(early.move())
    second: jet_cli_build_in_node_order(late.move())
    assert_eq(first.join(","), "a,c")
    assert_eq(second.join(","), first.join(","))
}

// The step ids of the nodes running in `states`.
jet_cli_build_running_steps: fn(nodes: [JetCLIBuildNode], states: [Int]) -> [Int] Never! {
    ^steps: [Int]{}
    loop index in 0..<nodes.len() {
        if nodes[index].kind == .Step && states[index] == JET_CLI_BUILD_RUNNING {
            steps.push(nodes[index].id)
        }
    }
    steps
}

// Whether the steps `steps` write nothing a target compiling in `states`
// reads (jet_cli_build_target_apart), so they can run while it compiles.
jet_cli_build_steps_apart: fn(nodes: [JetCLIBuildNode], states: [Int], graph: BuildPlanExecution, selected: BuildPlanSelection, root: String, steps: [Int]) -[FS, Env]> Bool Never! {
    loop index in 0..<nodes.len() {
        if nodes[index].kind == .Step || states[index] != JET_CLI_BUILD_RUNNING -> next
        if !jet_cli_build_target_apart(nodes[index], graph, selected, root, steps) -> return false
    }
    true
}

// The ready steps a build runs, as the executor ran them, batch by batch
// (build_execution_batches): each batch's step ids, results and wall time.
JetCLIBuildStepsRan: struct {
    batches: [[Int]],
    results: [[ActionOutcome BuildExecutionError!]],
    walls: [Int],
}

// Run the ready steps `ready`, batch by batch, each batch one `build.step`
// span named by its steps, in the lane of the task that runs them, with the
// build's thread cap `threads` (Jetpack Executor.jet build_execute_actions).
jet_cli_build_run_steps: fn(executor: HermeticBuildPlan, ready: [Int], store: BuildArtifactStoreHandle?, grants: [BuildEffect], probes: [BuildProbeFact], jobs: Int, traces: String?, threads: Int?, graph: BuildPlanExecution, root: String, trace_sink: JetCLITraceSink?) -> JetCLIBuildStepsRan {
    ^ran: JetCLIBuildStepsRan{batches: build_execution_batches(executor, ready), results: [[ActionOutcome BuildExecutionError!]]{}, walls: [Int]{}}
    loop batch in ran.batches {
        names: loop id in batch -> graph.actions[id].name.copy()
        if trace_sink == .Val(sink) -> sink.begin("build.step", names.join(" "), -1, -1)
        watch: cli_time.start()
        ran.results.push(build_execute_actions(executor, batch, root, store, grants, probes, jobs, traces, threads))
        ran.walls.push(watch.elapsed_millis())
        if trace_sink == .Val(sink) {
            sink.end("build.step", batch.len())
            if traces == .Val(folder) -> jet_cli_build_splice_traces(sink, folder, graph)
        }
    }
    ran
}

// One task of jet_cli_build_run_nodes: run the ready steps `ready`
// (jet_cli_build_run_steps) on a task of its own and hand what they did, or
// why that task stopped, to `done`.
jet_cli_build_steps_task: fn(plan: HermeticBuildPlan?, ready: ^^[Int], store: BuildArtifactStoreHandle?, grants: [BuildEffect], probes: [BuildProbeFact], jobs: Int, traces: String?, threads: Int?, graph: BuildPlanExecution, root: String, trace_sink: JetCLITraceSink?, done: Sender<JetCLIBuildDone>) {
    executor: plan ?? panic("a build with steps lowered them to the executor")
    steps: ready.move()
    ^joined: [JetCLIBuildDone]{}
    task.group build_steps {
        running: task jet_cli_build_steps_done(executor, steps, store, grants, probes, jobs, traces, threads, graph, root, trace_sink)
        joined.push(running.join() ?? JetCLIBuildDone.Stopped{reason: compiler_threads_failure_text(err)})
    }
    sent: joined.pop() ?? panic("the build's steps lost their report")
    jet_cli_build_done_send(done, sent).drop("the run loop collects every task it starts")
}

jet_cli_build_steps_done: fn(executor: HermeticBuildPlan, ready: [Int], store: BuildArtifactStoreHandle?, grants: [BuildEffect], probes: [BuildProbeFact], jobs: Int, traces: String?, threads: Int?, graph: BuildPlanExecution, root: String, trace_sink: JetCLITraceSink?) -> JetCLIBuildDone {
    JetCLIBuildDone.Steps{ran: jet_cli_build_run_steps(executor, ready, store, grants, probes, jobs, traces, threads, graph, root, trace_sink)}
}

// One task of jet_cli_build_run_nodes: compile target node `node`, the
// `index`th (jet_cli_build_target_node), on a task of its own, as one of the
// compiles sharing this process's threads (compiler_threads_join), and hand
// its output and wall time, or why that task stopped, to `done`.
jet_cli_build_target_task: fn(index: Int, node: JetCLIBuildNode, graph: BuildPlanExecution, selected: BuildPlanSelection, needs: JetCLIBuildNeeds, root: String, options: BuildOptions, threads: Int?, invocation: JetCLIInvocationAuthority?, generated: [JetDriverGeneratedModule], trace_sink: JetCLITraceSink?, color: Bool, done: Sender<JetCLIBuildDone>) {
    ^joined: [JetCLIBuildDone]{}
    compiler_threads_join()
    task.group build_target {
        compiling: task jet_cli_build_target_done(index, node, graph, selected, needs, root, options, threads, invocation, generated, trace_sink, color)
        joined.push(compiling.join() ?? JetCLIBuildDone.Stopped{reason: compiler_threads_failure_text(err)})
    }
    compiler_threads_leave()
    sent: joined.pop() ?? panic("the compile of `{node.name}` lost its report")
    jet_cli_build_done_send(done, sent).drop("the run loop collects every task it starts")
}

jet_cli_build_target_done: fn(index: Int, node: JetCLIBuildNode, graph: BuildPlanExecution, selected: BuildPlanSelection, needs: JetCLIBuildNeeds, root: String, options: BuildOptions, threads: Int?, invocation: JetCLIInvocationAuthority?, generated: [JetDriverGeneratedModule], trace_sink: JetCLITraceSink?, color: Bool) -> JetCLIBuildDone {
    watch: cli_time.start()
    output: jet_cli_build_target_node(node, graph, selected, needs, root, options, threads, invocation, generated, trace_sink, color)
    JetCLIBuildDone.Target{node: index, output: output, wall_ms: watch.elapsed_millis()}
}

// Whether target node `node` reads no file the steps `steps` write, so it
// can compile while they run. Its compile reads only its snapshot
// (jet_cli_prepare_snapshot): a script alone, else every file under its
// entry's source root.
jet_cli_build_target_apart: fn(node: JetCLIBuildNode, graph: BuildPlanExecution, selected: BuildPlanSelection, root: String, steps: [Int]) -[FS, Env]> Bool Never! {
    entry: if node.kind == .Library -> selected.libraries[node.id].source else -> graph.targets[node.id].sources[0]
    project: cli_files.realpath(root) ?? root
    path: jet_cli_entry_join(project, entry)
    script: jet_cli_entry_is_script(path, [JetDriverSourceDocument]{})
    tree: jet_cli_source_root(cli_files.realpath(path) ?? path)
    loop step in steps {
        loop output in graph.actions[step].outputs {
            written: jet_cli_entry_join(project, output)
            if script && written == path -> return false
            if !script && (written == tree || written.starts_with("{tree}/")) -> return false
        }
    }
    true
}

// Where a build traced to a file (`--trace=FILE`) gathers the traces of its
// steps' processes: every step runs with `JET_TRACE_FILE` in its sandbox, so
// each jet it starts (`jet run` of a script, the `jet doc` that script runs,
// a made jet's `embed`) writes its own trace (Jetpack Executor.jet
// build_execute_actions), and the files come here as the step ends. None for
// no trace, the readable stream, or a folder that can't be made (said on
// stderr; the build goes on untraced there).
JET_CLI_BUILD_STEP_TRACES: ".jet/build/step-traces"

jet_cli_build_step_traces: fn(root: String, trace_sink: JetCLITraceSink?) -[FS]> String? Never! {
    sink: trace_sink ?? return None
    if sink.human -> return None
    folder: jet_cli_entry_join(root, JET_CLI_BUILD_STEP_TRACES)
    // An earlier build's leftovers are no part of this one.
    cli_files.remove_all(folder).drop("a folder that isn't there has nothing to clear; one that can't be cleared fails the create below")
    if cli_files.create_dir_all(folder) == .Err(error) {
        _: jet_cli_trace_append(JET_CLI_TRACE_STDERR, "jet: the build's trace can't take its steps' processes: couldn't create `{folder}`: {error}\n")
        return None
    }
    Val(folder)
}

// Splices each trace a step of the batch that just ran left in `folder`
// (`<action id>-<file>`) into the build's trace as its own process, named by
// its step (Request.jet jet_cli_trace_splice), and removes the file.
jet_cli_build_splice_traces: fn(sink: JetCLITraceSink, folder: String, graph: BuildPlanExecution) -[FS]> Never! {
    ^entries: cli_files.list_dir(folder) ?? return
    entries.sort_by(fn(left, right) { left.name <=> right.name })
    loop entry in entries {
        path: jet_cli_entry_join(folder, entry.name)
        if entry.name.split_once("-") == .Val(pair) {
            id: Int.parse(pair.before) ?? -1
            if id >= 0 && id < graph.actions.len() {
                if cli_files.read(path) == .Ok(text) {
                    jet_cli_trace_splice(sink, graph.actions[id].name, text)
                }
            }
        }
        cli_files.remove(path).drop("a spliced trace left behind is cleared by the next traced build")
    }
}

// The `kind` a node's BuildTime row names.
jet_cli_build_node_kind: fn(kind: JetCLIBuildNodeKind) -> String Never! {
    if kind == {
        .Step -> "step"
        .Image -> "image"
        .Library -> "library"
        .Host -> "host"
    }
}

// Write the run's records under `<root>/.jet/build`: `receipt.json`, the
// core.build graph it built, each step that ran marked a cache hit when
// `reused` says the store gave back its outputs and a miss when it ran, then
// `kept`, then `generated`, each module `build: fn` made (`made`) with its
// identity and the producer chain that made it, which the editor shows on
// the module (`jet self lsp`), then `settings`, each package's resolved
// settings and their writers; and `times.json`, its BuildTimes. A record
// that can't be written is the failure returned.
jet_cli_build_record: fn(root: String, receipt: BuildGraph, made: [BuildSessionGeneratedModule], settings: [JetDriverBuildPackageSettings], reused: [Int:Bool], kept: [JetDriverBuildKept], times: [JetDriverBuildTime], color: Bool) -[FS]> JetDriverVerbOutput? Never! {
    ^graph: receipt.copy()
    ^hits: [BuildGraphAction]{}
    loop index in 0..<graph.actions.len() {
        hit: reused.get(graph.actions[index].id) ?? next
        ^action: graph.actions[index].copy()
        action.cache_hit = Val(hit)
        if hit -> hits.push(action.copy())
        graph.actions[index] = action
    }
    graph.cache_hits = hits
    directory: jet_cli_entry_join(root, ".jet/build")
    fix: "make `{directory}` writable"
    cli_files.create_dir_all(directory) ?? return Val(jet_cli_build_failed("couldn't create `{directory}` for the build's records: {err}", jet_cli_why("E2105"), fix, color))
    receipt_path: cli_files.join(directory, "receipt.json")
    cli_files.write(receipt_path, jet_driver_build_graph_json(graph, kept, made, settings)) ?? return Val(jet_cli_build_failed("couldn't write the build receipt `{receipt_path}`: {err}", jet_cli_why("E2105"), fix, color))
    times_path: cli_files.join(directory, "times.json")
    cli_files.write(times_path, jet_driver_build_times_json(times)) ?? return Val(jet_cli_build_failed("couldn't write the build times `{times_path}`: {err}", jet_cli_why("E2105"), fix, color))
    None
}

// The digest of each output the graph keeps in git, for the receipt: the
// bytes on disk for a step that finished this run (`reused` names those), the
// last build's (`last_kept`) for one that didn't run.
jet_cli_build_kept: fn(root: String, graph: BuildPlanExecution, reused: [Int:Bool], last_kept: [String:String]) -[FS]> [JetDriverBuildKept] Never! {
    ^kept: [JetDriverBuildKept]{}
    loop (id, action) in graph.actions {
        loop path in action.kept {
            ^digest: last_kept.get(path)
            if reused.get(id) != None && cli_files.read_bytes(jet_cli_entry_join(root, path)) == .Ok(bytes) {
                digest = Val(ContentDigest.from_bytes(bytes).as_str())
            }
            if digest == .Val(held) {
                kept.push(JetDriverBuildKept{path: path.copy(), digest: held.copy()})
            }
        }
    }
    kept
}

// What the last build's receipt says: every step output it made, and the
// digest of each kept output's bytes as it left them. Both are empty before
// any build has recorded one.
JetCLIBuildLast: struct {
    made: [String],
    kept: [String:String],
}

jet_cli_build_last: fn(root: String) -[FS]> JetCLIBuildLast Never! {
    ^last: JetCLIBuildLast{made: [String]{}, kept: [String:String]{}}
    receipt_text: cli_files.read(jet_cli_entry_join(root, ".jet/build/receipt.json")) ?? ""
    if jet_cli_status_value_parse(receipt_text) == .Ok(receipt) {
        actions: jet_cli_status_list(jet_cli_status_get(receipt, "actions")) ?? [JetCLIStatusValue]{}
        loop action in actions {
            outputs: jet_cli_status_list(jet_cli_status_get(action, "outputs")) ?? [JetCLIStatusValue]{}
            loop output in outputs {
                if jet_cli_status_string(Val(output)) == .Val(path) -> last.made.push(path.copy())
            }
        }
        rows: jet_cli_status_list(jet_cli_status_get(receipt, "kept")) ?? [JetCLIStatusValue]{}
        loop row in rows {
            path: jet_cli_status_string(jet_cli_status_get(row, "path")) ?? next
            digest: jet_cli_status_string(jet_cli_status_get(row, "digest")) ?? next
            last.kept[path] = digest
        }
    }
    last
}

// What refuses the run when a step in `steps` would overwrite a file the
// build didn't make, such as a committed one, as generated sources are
// refused (jet_cli_generated_shadow): an output may replace only a file the
// last build's receipt lists as a step's output (`made`), one the step
// keeps in git, or one in a package's build tree (jet_cli_build_tree_output).
// None when no step would.
jet_cli_build_overwrite: fn(root: String, graph: BuildPlanExecution, steps: [Int], made: [String]) -[FS]> String? Never! {
    loop step in steps {
        loop output in graph.actions[step].outputs {
            path: jet_cli_entry_join(root, output)
            if made.contains(output) || graph.actions[step].kept.contains(output) || !(cli_files.exists(path) || cli_files.is_symlink(path)) {
                next
            }
            if jet_cli_build_tree_output(root, output) -> next
            return Val("step `{graph.actions[step].name}` would overwrite `{output}`, a file no build made")
        }
    }
    None
}

// Whether `output` lies in a package's build tree: `.jet/build/` of the root
// or of a folder in it with its own `package.jet`. Only builds write there,
// so a file at such an output is an older build's, which the receipt doesn't
// list when that build made it some other way (a target's image before a
// step made the path). A `.jet/build/` in a folder that is no package is not
// a build tree.
jet_cli_build_tree_output: fn(root: String, output: String) -[FS]> Bool Never! {
    ^parts: [String]{}
    loop part in output.split("/") {
        if part != "" && part != "." -> parts.push(part.copy())
    }
    ^package: ""
    loop at in 0..<parts.len() {
        if at + 2 < parts.len() && parts[at] == ".jet" && parts[at + 1] == "build" {
            return package == "" || cli_files.exists(jet_cli_entry_join(root, "{package}/package.jet"))
        }
        package = if package == "" -> parts[at].copy() else -> "{package}/{parts[at]}"
    }
    false
}

jet_cli_build_step_node: fn(nodes: [JetCLIBuildNode], action: Int) -> Int Never! {
    loop index in 0..<nodes.len() {
        if nodes[index].kind == .Step && nodes[index].id == action -> return index
    }
    panic("a step that ran has no node")
}

// Compile or check one target node. An executable a step runs also gets its
// host copy, built for this machine: the cross options (`os`, `min_os`) are
// the host's and every other option follows the build. When the build
// selects the host's own platform, the image and host copy are the same
// file, built once. An executable whose image a step reads (`b.image`) gets a
// copy of it at `.jet/build/image/<name>`; a host-only node builds no image.
jet_cli_build_target_node: fn(node: JetCLIBuildNode, graph: BuildPlanExecution, selected: BuildPlanSelection, needs: JetCLIBuildNeeds, root: String, options: BuildOptions, threads: Int?, invocation: JetCLIInvocationAuthority?, generated: [JetDriverGeneratedModule], trace_sink: JetCLITraceSink?, color: Bool) -> JetDriverVerbOutput {
    if node.kind == .Library {
        library: selected.libraries[node.id]
        source_path: jet_cli_entry_join(root, library.source)
        source: cli_files.read(source_path) ?? return jet_cli_build_failed("couldn't read the target source `{source_path}`: {err}", jet_cli_why("E2105"), "correct the source path given to `b.add_library`", color)
        return jet_cli_check_library(source_path, source, library.sources, generated, color, threads, trace_sink)
    }
    target: node.id
    row: graph.targets[target]
    source_path: jet_cli_entry_join(root, row.sources[0])
    source: cli_files.read(source_path) ?? return jet_cli_build_failed("couldn't read the target source `{source_path}`: {err}", jet_cli_why("E2105"), "correct the source path given to `b.add_executable`", color)
    host_dir: jet_cli_entry_join(root, BUILD_SESSION_HOST_DIR)
    ^host_options: jet_cli_build_options_set(options, "output_dir", host_dir)
    host_options = jet_cli_build_options_set(host_options, "os", "linux")
    host_options = jet_cli_build_options_set(host_options, "min_os", "")
    // The host copy is the same output, so it keeps the output's settings.
    host_options.output = row.name
    host_options.output_settings = row.settings
    if node.kind == .Host {
        return jet_cli_compile_target(source_path, row.name, source, row.sources, generated, color, host_options, threads, invocation, trace_sink)
    }
    target_options: jet_cli_build_toolchain_options(graph, row, options)
    built: jet_cli_compile_target(source_path, row.name, source, row.sources, generated, color, target_options.copy(), threads, invocation, trace_sink)
    if built.exit_code != JET_DRIVER_EXIT_OK -> return built
    wants_host: needs.host.contains(target)
    cross: build_options_value(target_options, "os") != "linux" || build_options_value(target_options, "min_os") != ""
    if !needs.images.contains(target) && (!wants_host || cross) {
        if !wants_host -> return built
        return jet_cli_compile_target(source_path, row.name, source, row.sources, generated, color, host_options, threads, invocation, trace_sink)
    }
    if trace_sink == .Val(sink) -> sink.begin("build.image", row.name, -1, -1)
    image: jet_cli_build_target_image(source_path, row.name, target_options, root)
    copies_dir: jet_cli_entry_join(root, BUILD_SESSION_IMAGE_DIR)
    refused: if needs.images.contains(target) -> jet_cli_build_step_image(image, row.name, copies_dir) else -> None
    if trace_sink == .Val(sink) -> sink.end("build.image", -1)
    if refused == .Val(problem) {
        return jet_cli_build_failed(problem, jet_cli_why("E2105"), "make `{copies_dir}` writable", color)
    }
    if !wants_host -> return built
    if cross {
        return jet_cli_compile_target(source_path, row.name, source, row.sources, generated, color, host_options, threads, invocation, trace_sink)
    }
    tool: cli_files.join(host_dir, row.name)
    cli_files.create_dir_all(host_dir) ?? return jet_cli_build_failed("couldn't create `{host_dir}` for the host copy of `{row.name}`: {err}", jet_cli_why("E2105"), "make `{host_dir}` writable", color)
    if trace_sink == .Val(sink) -> sink.begin("build.host", row.name, -1, -1)
    if cli_files.copy2(image, tool) == .Err(err) {
        if trace_sink == .Val(sink) -> sink.end("build.host", -1)
        return jet_cli_build_failed("couldn't copy `{row.name}`'s image to its host copy `{tool}`: {err}", jet_cli_why("E2105"), "make `{host_dir}` writable", color)
    }
    if trace_sink == .Val(sink) -> sink.end("build.host", -1)
    cli_files.set_mode(tool, 493) ?? return jet_cli_build_failed("couldn't make the host copy `{tool}` executable: {err}", jet_cli_why("E2105"), "make `{host_dir}` writable", color)
    built
}

// Where target `name`'s image from `source_path` was written under
// `options`: under the source's root (its package, else its folder) unless
// `output_dir` is absolute.
jet_cli_build_target_image: fn(source_path: String, name: String, options: BuildOptions, root: String) -> String {
    source_dir: jet_cli_parent(cli_files.realpath(source_path) ?? source_path) ?? root
    ^cache: WorkspaceDeclarationCache.new()
    ^source_root: source_dir.copy()
    if jet_cli_find_package_root_checked(cache, source_dir) == .Ok(found) && found == .Val(package_root) {
        source_root = package_root.copy()
    }
    written: build_options_value(options, "output_dir")
    image_dir: if {
        written == "" -> "{source_root}/.jet/build"
        written.starts_with("/") -> written.copy()
        else -> "{source_root}/{written}"
    }
    cli_files.join(image_dir, name)
}

// Copy target `name`'s `image` into `copies_dir` (.jet/build/image), where a
// step reads it; what went wrong when it can't.
jet_cli_build_step_image: fn(image: String, name: String, copies_dir: String) -> String? {
    copied: cli_files.join(copies_dir, name)
    cli_files.create_dir_all(copies_dir) ?? return Val("couldn't create `{copies_dir}` for the images steps read: {err}")
    cli_files.copy2(image, copied) ?? return Val("couldn't copy `{name}`'s image `{image}` to `{copied}`, where a step reads it: {err}")
    cli_files.set_mode(copied, 493) ?? return Val("couldn't make `{copied}` executable: {err}")
    None
}

// The options output `row` builds with: its own `options: {settings: ...}`
// values over the build's, and, on its own toolchain (`b.toolchain(name,
// triple)`), that toolchain's triple, whose machine its target facts read,
// and the OS the triple names, so its artifact is checked against that
// machine's row. An output on the host toolchain, or on a triple that names
// no OS, keeps the build's OS.
jet_cli_build_toolchain_options: fn(graph: BuildPlanExecution, row: BuildSessionTarget, options: BuildOptions) -> BuildOptions Never! {
    ^built: options
    built.output = row.name
    built.output_settings = row.settings
    if row.toolchain < 0 || row.toolchain >= graph.toolchains.len() -> return built
    toolchain: graph.toolchains[row.toolchain]
    if toolchain.role != "target" -> return built
    built.output_triple = toolchain.target_triple
    os: jet_target_triple_os(toolchain.target_triple) ?? return built
    jet_cli_build_options_set(built, "os", target_os_key(os))
}

// `options` with the resolved value of row `name` replaced by `value`.
jet_cli_build_options_set: fn(options: BuildOptions, name: String, value: String) -> BuildOptions Never! {
    ^changed: options.copy()
    loop index in 0..<changed.values.len() {
        if changed.values[index].name == name {
            ^choice: changed.values[index].copy()
            choice.value = value.copy()
            changed.values[index] = choice
        }
    }
    changed
}

// One output reporting every failure of a build, or success.
jet_cli_build_failures: fn(failures: [JetDriverVerbOutput]) -> JetDriverVerbOutput Never! {
    if failures.len() == 1 -> return failures[0].copy()
    ^out: JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    ^reports: [Diagnostic]{}
    loop failure in failures {
        out.stdout = "{out.stdout}{failure.stdout}"
        out.stderr = "{out.stderr}{failure.stderr}"
        if failure.exit_code > out.exit_code -> out.exit_code = failure.exit_code
        if failure.failure == .Val(failed) {
            loop report in failed.reports -> reports.push(report.copy())
        }
    }
    if failures.len() > 0 -> out.failure = Val(JetDriverFailure{reports: reports, notice: ""})
    out
}

// The steps a build runs: the selected ones, the ones each selected target
// needs, and their prerequisites; for each `b.host` tool a step runs and each
// `b.image` it reads, its target and the steps it needs. Steps ascending,
// targets in first use.
jet_cli_build_needs: fn(graph: BuildPlanExecution, plan: HermeticBuildPlan, selected: BuildPlanSelection, prereqs: [Int:[Int]]) -> JetCLIBuildNeeds HermeticBuildError! {
    ^steps: plan.selected_action_ids() ?? return Err(err)
    loop executable in selected.executables {
        loop step in jet_cli_build_target_steps(graph, executable.target) {
            if !steps.contains(step) -> steps.push(step)
        }
    }
    loop library in selected.libraries {
        loop step in jet_cli_build_target_steps(graph, library.target) {
            if !steps.contains(step) -> steps.push(step)
        }
    }
    ^host: [Int]{}
    ^images: [Int]{}
    ^pending: steps.copy()
    loop pending.len() > 0 {
        step: pending.pop() ?? break
        ^more: prereqs.get(step) ?? [Int]{}
        loop target in jet_cli_build_step_targets(graph, graph.actions[step], "host") {
            if host.contains(target) -> next
            host.push(target)
            loop need in jet_cli_build_target_steps(graph, target) -> more.push(need)
        }
        loop target in jet_cli_build_step_targets(graph, graph.actions[step], "image") {
            if images.contains(target) -> next
            images.push(target)
            loop need in jet_cli_build_target_steps(graph, target) -> more.push(need)
        }
        loop need in more {
            if !steps.contains(need) {
                steps.push(need)
                pending.push(need)
            }
        }
    }
    steps.sort()
    Ok(JetCLIBuildNeeds{steps: steps, host: host, images: images})
}

// The targets whose `kind` build `action` reads: `host` for its `b.host`
// tools, `image` for the `b.image` files it reads.
jet_cli_build_step_targets: fn(graph: BuildPlanExecution, action: BuildSessionAction, kind: String) -> [Int] Never! {
    ^out: [Int]{}
    loop file in graph.files {
        if file.kind != kind || !action.inputs.contains(file.path) -> next
        target: file.target ?? next
        if !out.contains(target) -> out.push(target)
    }
    out
}

// The steps target `target` needs before it compiles: its own and its
// dependencies' actions, and the steps that make a source of any of them.
jet_cli_build_target_steps: fn(graph: BuildPlanExecution, target: Int) -> [Int] Never! {
    ^visited: [Int]{}
    ^pending: [Int]{target}
    loop pending.len() > 0 {
        current: pending.pop() ?? break
        if visited.contains(current) -> next
        visited.push(current)
        loop dep in graph.targets[current].deps -> pending.push(dep)
    }
    ^steps: [Int]{}
    loop current in visited {
        row: graph.targets[current]
        loop action in row.actions {
            if !steps.contains(action) -> steps.push(action)
        }
        loop index in 0..<graph.actions.len() {
            if steps.contains(index) -> next
            makes_source: loop output in graph.actions[index].outputs {
                if row.sources.contains(output) {
                    break true
                }
            } ?? false
            if makes_source -> steps.push(index)
        }
    }
    steps
}

// The nodes of the build: the steps, the selected executables and
// libraries, then the unselected targets whose image a step reads, then the
// host-only targets, each with what it waits on.
jet_cli_build_nodes: fn(graph: BuildPlanExecution, selected: BuildPlanSelection, needs: JetCLIBuildNeeds, prereqs: [Int:[Int]]) -> [JetCLIBuildNode] Never! {
    ^nodes: [JetCLIBuildNode]{}
    ^step_nodes: [Int:Int]{}
    loop step in needs.steps {
        step_nodes[step] = nodes.len()
        nodes.push(JetCLIBuildNode{kind: .Step, id: step, name: graph.actions[step].name.copy(), needs: [Int]{}})
    }
    // The node that builds each executable target a step uses.
    ^target_nodes: [Int:Int]{}
    loop executable in selected.executables {
        target_nodes[executable.target] = nodes.len()
        nodes.push(JetCLIBuildNode{kind: .Image, id: executable.target, name: executable.name.copy(), needs: jet_cli_build_step_nodes(step_nodes, jet_cli_build_target_steps(graph, executable.target))})
    }
    loop index in 0..<selected.libraries.len() {
        library: selected.libraries[index]
        nodes.push(JetCLIBuildNode{kind: .Library, id: index, name: library.name.copy(), needs: jet_cli_build_step_nodes(step_nodes, jet_cli_build_target_steps(graph, library.target))})
    }
    loop target in needs.images {
        if target_nodes.get(target) != None -> next
        target_nodes[target] = nodes.len()
        nodes.push(JetCLIBuildNode{kind: .Image, id: target, name: graph.targets[target].name.copy(), needs: jet_cli_build_step_nodes(step_nodes, jet_cli_build_target_steps(graph, target))})
    }
    loop target in needs.host {
        if target_nodes.get(target) != None -> next
        target_nodes[target] = nodes.len()
        nodes.push(JetCLIBuildNode{kind: .Host, id: target, name: graph.targets[target].name.copy(), needs: jet_cli_build_step_nodes(step_nodes, jet_cli_build_target_steps(graph, target))})
    }
    loop step in needs.steps {
        index: step_nodes.get(step) ?? panic("a needed step has a node")
        ^waits: jet_cli_build_step_nodes(step_nodes, prereqs.get(step) ?? [Int]{})
        ^uses: jet_cli_build_step_targets(graph, graph.actions[step], "host")
        loop target in jet_cli_build_step_targets(graph, graph.actions[step], "image") {
            uses.push(target)
        }
        loop target in uses {
            made: target_nodes.get(target) ?? panic("a target a step uses has a node")
            if !waits.contains(made) -> waits.push(made)
        }
        ^node: nodes[index].copy()
        node.needs = waits
        nodes[index] = node
    }
    nodes
}

jet_cli_build_step_nodes: fn(step_nodes: [Int:Int], steps: [Int]) -> [Int] Never! {
    ^out: [Int]{}
    loop step in steps {
        node: step_nodes.get(step) ?? next
        if !out.contains(node) -> out.push(node)
    }
    out
}

// The names of the nodes that wait on each other in a cycle, and so on
// nothing that can finish; empty when every node can start.
jet_cli_build_cycle: fn(nodes: [JetCLIBuildNode]) -> [String] Never! {
    ^done: [Bool]{}
    loop _ in nodes -> done.push(false)
    ^progressed: true
    loop progressed {
        progressed = false
        loop index in 0..<nodes.len() {
            if done[index] -> next
            ready: loop need in nodes[index].needs {
                if !done[need] {
                    break false
                }
            } ?? true
            if ready {
                done[index] = true
                progressed = true
            }
        }
    }
    ^names: [String]{}
    loop index in 0..<nodes.len() {
        if !done[index] {
            noun: if nodes[index].kind == .Step -> "step" else -> "target"
            names.push("{noun} `{nodes[index].name}`")
        }
    }
    names
}

// The build policy of the nearest workspace enclosing `root` into `policy`;
// none leaves it empty. The why of the refusal when that workspace's
// authority or its policy does not read: a build never runs under a policy it
// could not read.
jet_cli_build_workspace_policy: fn(policy: ^OverlayPolicy, root: String) -[FS, Env]> String? Never! {
    ^cache: WorkspaceDeclarationCache.new()
    found: if jet_cli_find_workspace_root_checked(cache, root) == {
        .Ok(nearest) -> nearest
        .Err(error) -> {
            return Val("Workspace build policy above `{root}` is present but unavailable: {error.diagnostic.what}")
        }
    }
    workspace: found ?? return None
    resolved: if pkg_resolve_workspace_source(cache, workspace) == {
        .Ok(read) -> read
        .Err(error) -> {
            return Val("Workspace build policy in `{workspace}` is present but unavailable: {error.diagnostic.what}")
        }
    }
    source: resolved ?? return None
    parsed: pkg_parse_workspace_policy(source.source) ?? return Val("Workspace build policy in `{source.path}`: {err.message()}")
    policy.build_deny = parsed.build_deny
    policy.build_grants = parsed.build_grants
    None
}

// The build effects granted: the ambient basics and the package's
// `authority.allow`, the workspace's grant to this package, then `-A` and
// `--allow`. The package's and the invocation's `deny` and the workspace's
// `policy.deny` win over every grant.
jet_cli_build_grants: fn(policy: JetDriverAuthorityPolicy?, workspace: OverlayPolicy, invocation: JetCLIInvocationAuthority?) -> [BuildEffect] Never! {
    ^authority: jet_cli_policy_authority([String]{}, policy)
    subject: if policy == .Val(package) -> package.subject.copy() else -> ""
    ^granted: authority.granted.copy()
    loop grant in workspace.build_grants {
        if subject != "" && grant.subject == subject {
            loop right in jet_cli_policy_effects(grant.effects) -> granted.push(right)
        }
    }
    authority.granted = jet_cli_sorted_set(granted)
    jet_cli_with_invocation(authority, invocation)
    ^denied: authority.denied.copy()
    loop right in jet_cli_policy_effects(workspace.build_deny) -> denied.push(right)
    authority.denied = jet_cli_sorted_set(denied)
    ^allowed: [BuildEffect]{}
    effects: [BuildEffect]{BuildEffect.Net, BuildEffect.FS, BuildEffect.IO, BuildEffect.DB, BuildEffect.Time, BuildEffect.Rand, BuildEffect.Env, BuildEffect.Exec, BuildEffect.Log, BuildEffect.GPU}
    loop right in effects {
        if jet_cli_answer(authority, right.name()) == AuthorityVerdict.Allowed {
            allowed.push(right)
        }
    }
    allowed
}

// A workspace member's ungranted action is E3504: the command line grants the
// root build only, so the member's own authority and the workspace's grant to
// it are all it holds. The root build's is E3503.
jet_cli_build_execution_error: fn(error: BuildExecutionError, member: String?, color: Bool) -> JetDriverVerbOutput Never! {
    if error == {
        .MissingGrant(action, capability) -> {
            subject: if action.starts_with("probe ") -> "build probe `{action.slice(6..<action.len())}`" else -> "build action `{action}`"
            if member == .Val(name) {
                return jet_cli_build_execution_failed("E3504", "{subject} of workspace member `{name}` asks for ungranted `{capability.name()}` authority", None, "grant `{capability.name()}` in `{name}`'s package authority or in the workspace's `policy: {{ grants: {{ \"{name}\": #({capability.name()}) }} }}`; `--allow` grants the root build only", color)
            }
            jet_cli_build_execution_failed("E3503", "{subject} needs `{capability.name()}`, which this build does not grant", None, "grant it with `--allow={capability.name()}` or in package or workspace policy; `build: fn` declares the effect and makes the call inside `#Impure(\"reason\")`", color)
        }
        .SandboxUnavailable(reason) -> jet_cli_build_refusal("E3505", "build actions run only in the native sandbox, and none is available here: {reason}", JET_CLI_BUILD_SANDBOX_WHY, None, "{NATIVE_SANDBOX_FIX}; Jet never runs a build action outside the sandbox", color)
        .IO(action, detail) -> jet_cli_build_execution_failed("E3505", "build action `{action}` failed: {detail}", None, "fix the action's command, toolchain, or input and output declarations", color)
        .TimedOut(action, limit_ms) -> jet_cli_build_execution_failed("E3505", "build action `{action}` ran past its wall-clock limit of {limit_ms}ms and was stopped", None, "look for a hang in the step's command, or raise the limit with `.timeout(10min)` on the step or the `action_timeout` build option for every step", color)
        .OverCPU(action, limit_ms, cores, used_ms) -> jet_cli_build_execution_failed("E3505", "build action `{action}` used {used_ms}ms of CPU time, past its limit of {limit_ms}ms on each of the host's {cores} cores, and was stopped", None, "raise the limit with `.timeout(10min)` on the step, or the `action_timeout` build option for every step", color)
        .ProbeFailed(probe, detail) -> jet_cli_build_execution_failed("E3505", "build probe `{probe}` failed: {detail}", None, "install what the probe looks for, or declare it on the probe's toolchain", color)
        .FolderNotFound(probe, file, searched) -> {
            // Jet links static musl, so find_folder takes only musl's `libc.a`.
            musl: file == "libc.a"
            wanted: if musl -> "musl's static `libc.a`, with `crt1.o` beside it" else -> "`{file}`"
            fix: if musl -> "put the `lib` folder of a static musl on LIBRARY_PATH" else -> "put the folder holding `{file}` on LIBRARY_PATH"
            looked: loop folder in searched -> "  {folder}"
            jet_cli_build_execution_failed("E3505", "build probe `{probe}` found no folder holding {wanted}", Val("It looked in:\n{looked.join("\n")}"), fix, color)
        }
        .Reported(report) -> {
            // The action's stderr follows the report as it wrote it; an
            // action that wrote none says so rather than promising it.
            stderr: build_action_failure_stderr(report) ?? ""
            if stderr.trim() == "" {
                return jet_cli_build_execution_failed("E3505", report.message, None, "fix the command the action runs; it wrote nothing to stderr, so look at its exit status and the files it reads", color)
            }
            jet_cli_build_execution_failed("E3505", report.message, Val(stderr), "fix the command the action runs; its stderr follows", color)
        }
        .InvalidGraph(graph) -> jet_cli_ice("the checked build plan is not a valid executor graph: {graph.debug_text()}")
        .HandEdited(action, path) -> jet_cli_build_execution_failed("E3502", "step `{action}` would overwrite `{path}`, which it keeps in git and which holds bytes no build wrote", None, "undo the edit (`git checkout -- {path}`) and change the step's inputs instead; the build rewrites `{path}` from them", color)
    }
}

// The Why of a missing sandbox: the one order every sandboxed action takes
// its Bubblewrap in (foundation_linux_bwrap).
JET_CLI_BUILD_SANDBOX_WHY: "Every build action and probe runs in a bubblewrap sandbox, never outside one. Jet uses the `bwrap` on PATH first, because a host that lets only profiled programs create user namespaces (Ubuntu's AppArmor profile for /usr/bin/bwrap) allows only its own copy; if that is missing or fails its probe, Jet uses its own hash-pinned bubblewrap, fetched into the Hangar on first need. Neither is usable here."

// One build-execution report: `code`'s row Why, the given What and Fix, and
// `detail` (an action's stderr) printed as written.
jet_cli_build_execution_failed: fn(code: String, what: String, detail: String?, fix: String, color: Bool) -> JetDriverVerbOutput Never! {
    why: (diagnostic_registry_row(code) ?? panic("build execution code `{code}` has no registry row")).why
    jet_cli_build_refusal(code, what, why, detail, fix, color)
}

// The E3503 of a workspace build policy that does not read, `why` naming it.
jet_cli_build_policy_refused: fn(why: String, color: Bool) -> JetDriverVerbOutput Never! {
    what: (diagnostic_registry_row("E3503") ?? panic("E3503 has no registry row")).what
    jet_cli_build_refusal("E3503", what, why, None, "Fix the workspace build policy: `policy: {{ deny: #(…) }}` caps every package's build, and `policy: {{ grants: {{ \"package\": #(…) }} }}` grants one package", color)
}

jet_cli_build_refusal: fn(code: String, what: String, why: String, detail: String?, fix: String, color: Bool) -> JetDriverVerbOutput Never! {
    ^report: diagnostic_from_registry(code, None, what, why, fix)
    report.detail = detail
    reports: [Diagnostic]{report}
    JetDriverVerbOutput{stdout: "", stderr: diagnostic_render_all("", "", reports, color), exit_code: JET_DRIVER_EXIT_USER_ERROR, failure: Val(JetDriverFailure{reports: reports, notice: ""})}
}

// Where a step run or passed `b.jet()` finds the running compiler's folder,
// and the toolchains it runs on, named so no `b.toolchain` name can collide.
JET_CLI_BUILD_JET_MOUNT: "/jet/compiler"

JET_CLI_BUILD_JET_TOOLCHAIN: "(jet)"

JET_CLI_BUILD_JET_FILE_TOOLCHAIN: "(jet-file)"

// The executor's graph of the session plan: every declared toolchain, signing
// identity, probe, action and target in declaration order, so each session
// handle id is the executor handle id; the session's toolchain 0 is the
// executor's inferred host. A step whose tool is `b.jet()` runs on one more
// toolchain: the running compiler's folder (with its runtime pack and
// IDENTITY) mounted read-only, its one tool `jet`. That jet is this compiler,
// so the step gets this compiler's identity in `JET_COMPILER_IDENTITY`: an
// unpublished compiler has no IDENTITY file beside it. A step that runs
// another tool and is passed `b.jet()` (`.file`) runs on the host toolchain
// with that folder mounted the same way, and its argument names the
// compiler at its mount. `last_kept` is the digest each kept output had when
// the last build left it.
jet_cli_build_hermetic_plan: fn(graph: BuildPlanExecution, action_timeout_ms: Int, last_kept: [String:String]) -> HermeticBuildPlan HermeticBuildError! {
    ^build: HermeticBuildContext.new()
    provenance: BuildProvenance.user_declared("fn build", None)
    ^toolchains: [ToolchainHandle]{build.default_host_toolchain()}
    loop index in 1..<graph.toolchains.len() {
        declared: graph.toolchains[index]
        toolchains.push(build.toolchain(declared.name, jet_cli_build_toolchain_spec(declared, provenance)))
    }
    runs_jet: loop action in graph.actions {
        if graph.files[action.tool].kind == "jet" {
            break true
        }
    } ?? false
    passes_jet: loop action in graph.actions {
        if action.jets.len() > 0 {
            break true
        }
    } ?? false
    ^jet_identity: ""
    ^jet_path: ""
    ^jet_toolchain: build.default_host_toolchain()
    ^jet_file_toolchain: build.default_host_toolchain()
    if runs_jet || passes_jet {
        compiler: cli_sys.executable()
        // A compiler without a named identity is known by its bytes; one it
        // can't read can't run the step either.
        jet_identity = jet_cli_compiler_identity() ?? build_crypto.sha256(cli_files.read_bytes(compiler) ?? [U8]{}).hex()
        jet_path = "{JET_CLI_BUILD_JET_MOUNT}/{cli_files.basename(compiler)}"
        mounted: ToolchainSpec.host("host", provenance).with_read_only_mount_identity(jet_cli_executable_dir(), JET_CLI_BUILD_JET_MOUNT, jet_identity)
        if runs_jet {
            jet_toolchain = build.toolchain(JET_CLI_BUILD_JET_TOOLCHAIN, mounted.with_tool("jet", jet_path).declared_only())
        }
        if passes_jet {
            jet_file_toolchain = build.toolchain(JET_CLI_BUILD_JET_FILE_TOOLCHAIN, mounted)
        }
    }
    signing: loop identity in graph.signing -> build.signing_identity(identity.name, SigningIdentitySpec.new(identity.label, provenance))
    ^probes: [ProbeHandle]{}
    loop probe in graph.probes {
        spec: if probe.kind == {
            "find_program" -> ProbeSpec.find_program(probe.value)
            "find_folder" -> ProbeSpec.find_folder(probe.value)
            "pkg_config" -> ProbeSpec.pkg_config(probe.value)
            "header" -> ProbeSpec.header_check(probe.value)
            else -> ProbeSpec.compile_check(probe.value, [String]{}, probe.code)
        }
        probes.push(build.probe(probe.name, spec.with_toolchain(toolchains[probe.toolchain])))
    }
    ^actions: [HermeticActionHandle]{}
    loop action in graph.actions {
        runs_this_jet: graph.files[action.tool].kind == "jet"
        toolchain: if {
            runs_this_jet -> jet_toolchain
            action.jets.len() > 0 -> jet_file_toolchain
            else -> toolchains[action.toolchain]
        }
        // A step passed `b.jet()` gets the path of the compiler running the build.
        ^spec: if action.jets.len() > 0 -> jet_cli_build_action_spec(action, jet_cli_build_jet_argv(action, jet_path), graph.files, toolchain, probes, signing, action_timeout_ms, last_kept) else -> jet_cli_build_action_spec(action, action.argv, graph.files, toolchain, probes, signing, action_timeout_ms, last_kept)
        if runs_this_jet -> spec = spec.with_env(JET_CLI_COMPILER_IDENTITY_ENV, jet_identity)
        actions.push(build.action(action.name, spec))
    }
    ^targets: [TargetRef]{}
    loop target in graph.targets {
        ^spec: TargetSpec.new().with_toolchain(toolchains[target.toolchain])
        loop source in target.sources -> spec = spec.with_source(source)
        loop input in target.inputs -> spec = spec.with_input(input)
        loop output in target.outputs -> spec = spec.with_output(output)
        loop dep in target.deps -> spec = spec.with_dep(targets[dep])
        loop action in target.actions -> spec = spec.with_action(actions[action])
        loop probe in target.probes -> spec = spec.with_probe(probes[probe])
        if target.signing == .Val(identity) -> spec = spec.with_signing_identity(signing[identity])
        loop key in target.metadata.keys() -> spec = spec.with_metadata(key, target.metadata[key])
        added: jet_cli_build_add_target(build, target, spec)
        targets.push(added)
    }
    if graph.default >= 0 -> return build.plan_with_default(targets[graph.default])
    build.plan()
}

jet_cli_build_toolchain_spec: fn(declared: BuildSessionToolchain, provenance: BuildProvenance) -> ToolchainSpec Never! {
    ^spec: ToolchainSpec.target(declared.target_triple, provenance).with_host_triple(declared.host_triple)
    if declared.sdk == .Val(sdk) {
        spec = spec.with_sdk(SDKIdentity.new(sdk, "declared", provenance))
    }
    if declared.linker == .Val(linker) {
        spec = spec.with_linker(LinkerIdentity.new(linker, provenance))
    }
    if declared.sysroot == .Val(sysroot) {
        spec = spec.with_sysroot(SysrootIdentity.new(sysroot, "declared", provenance))
    }
    spec
}

// `action`'s argv with the path of the compiler running the build at each
// argument `b.jet()` passes.
jet_cli_build_jet_argv: fn(action: BuildSessionAction, jet_path: String) -> [String] Never! {
    // copy: the graph's action keeps its argv for the plan's other reads.
    ^argv: action.argv.copy()
    loop passed in action.jets -> argv[passed.at] = "{passed.flag}{jet_path}"
    argv
}

// `action`'s spec, its command line `argv`.
jet_cli_build_action_spec: fn(action: BuildSessionAction, argv: [String], files: [BuildSessionFile], toolchain: ToolchainHandle, probes: [ProbeHandle], signing: [SigningIdentityHandle], action_timeout_ms: Int, last_kept: [String:String]) -> ActionSpec Never! {
    ^spec: ActionSpec.new(argv).with_inputs(action.inputs).with_outputs(action.outputs).with_toolchain(toolchain).with_timeout_ms(action.timeout_ms ?? action_timeout_ms)
    loop path in action.kept -> spec = spec.with_kept(path, last_kept.get(path))
    loop id in action.folders {
        file: files[id]
        if file.probe == .Val(probe) -> spec = spec.with_found_folder(file.path, probes[probe]) else {
            spec = spec.with_folder(file.path, file.from)
        }
    }
    loop program in action.programs {
        spec = spec.with_found_program(program.at, program.flag, probes[program.probe])
    }
    loop cap in action.caps {
        if BuildEffect.parse(cap) == .Val(parsed) -> spec = spec.with_cap(parsed)
    }
    loop probe in action.probes -> spec = spec.with_probe(probes[probe])
    if action.signing == .Val(identity) -> spec = spec.with_signing_identity(signing[identity])
    spec
}

jet_cli_build_add_target: fn(build: ^HermeticBuildContext, target: BuildSessionTarget, spec: TargetSpec) -> TargetRef HermeticBuildError! {
    if target.kind == {
        "executable" -> build.add_executable(target.name, spec)
        "library" -> build.add_library(target.name, spec)
        "test" -> build.add_test(target.name, spec)
        "asset-bundle" -> build.add_asset_bundle(target.name, spec)
        "doc" -> build.add_doc(target.name, spec)
        "install" -> build.add_install(target.name, spec)
        "package" -> build.add_package(target.name, spec)
        else -> build.add_publish(target.name, spec)
    }
}

#Test("the build entry is the colon declaration `build: fn(b: Build)`") {
    assert(jet_cli_declares_build_entry("build: fn(b: Build) {{}}\n"))
    assert(!jet_cli_declares_build_entry("build: fn(n: Int) {{}}\n"))
    assert(jet_cli_declares_build_entry("build: fn(_: Build) {{}}\n"))
    // A method is no entry, also after a raw string that holds a brace.
    assert(!jet_cli_declares_build_entry("NOTE: ```}}```\nimpl Shape {{ build: fn(b: Build) {{}} }}\n"))
}
