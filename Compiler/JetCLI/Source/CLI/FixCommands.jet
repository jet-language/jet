// run_fix: the shared diagnostic edit engine, not a second formatter.
// Publication uses the canonical held codemod transaction.
use {
    cli_files: core.files
    jet_driver.[JetDriverBuildQueryScope, JetDriverCompileMode, JetDriverSourceDocument, JetDriverStage, JetDriverVerbOutput, jet_driver_entry_package_has_build, jet_driver_present_diagnostics, jet_driver_query_build_plan, jet_driver_report_problems, JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USER_ERROR]
    jet_foundation.[Diagnostic, DiagnosticFixApplicability, DiagnosticFixSafety, SourceFile, Span, TextEdit, DIAGNOSTIC_ERROR, diagnostic_headline, foundation_byte_text]
    jet_lexer.[lex, Token, TOKEN_BLOCK_COMMENT, TOKEN_COLON, TOKEN_EQ, TOKEN_IDENT, TOKEN_LBRACE, TOKEN_LINE_COMMENT, TOKEN_RBRACE, TOKEN_SEMI]
    jet_parser.[jet_format_unified_diff, parser_marker_placement_edits]
    jet_semindex.[SemDefinitionFact]
}

// Rendered parse failure captured when a `jet fix` check stops at Parse, so
// an unparseable target reports its parse error instead of `no changes made`.
JetCLIFixParseError: struct {
    report: String,
    reports: [String],
}

// `errors`: the file's errors, each `CODE: what` (jet_cli_fix_checked
// compares an edited file's against them). `repairs`: the fixes of those
// errors, a subset of `fixes` (jet_cli_fix_round). `definitions`: the
// compile's definition facts when the query asked for them
// (jet_cli_fix_result_facts), which the fix receipt's renames start from.
JetCLIFixQuery: enum {
    Fixes(fixes: [JetCLIFix], errors: [String], repairs: [JetCLIFix], definitions: [SemDefinitionFact]?, parse_error: JetCLIFixParseError?),
    Refused(output: JetDriverVerbOutput),
}

// The fixes one `jet fix` round applies: the error repairs alone while the
// file has any, so the other fixes are read again from the repaired file (an
// unused-binding fix read beside an unknown name may rename the binding the
// name's repair points at). `held` when fixes wait for the next round.
JetCLIFixRound: struct {
    fixes: [JetCLIFix],
    held: Bool,
}

jet_cli_fix_round: fn(fixes: [JetCLIFix], repairs: [JetCLIFix], all: Bool) -> JetCLIFixRound Never! {
    usable: if all -> fixes else -> jet_cli_safe_fixes(fixes)
    usable_repairs: if all -> repairs else -> jet_cli_safe_fixes(repairs)
    if usable_repairs.len() == 0 || usable_repairs.len() == usable.len() {
        return JetCLIFixRound{fixes: usable, held: false}
    }
    JetCLIFixRound{fixes: usable_repairs, held: true}
}

// The Doc compile of `file` with its bytes replaced by `source`, and each
// file of `files`, the file table, by its text in `texts` (by row) or else
// with the fixes so far, that a `jet fix` query reads: the entry's
// diagnostics and definition facts alone, so Core bodies wait for demand
// (JetDriverCompileRequest.doc_core_on_demand). A file the fixes leave
// unchanged is read from disk. It is checked as a shipped artifact is, so
// each `debug` trace a build would refuse (E3405) brings its unwrap edit.
jet_cli_fix_compile: fn(file: String, source: String, files: [JetCLIFixFile], texts: [String?]) -> JetCLICompiled {
    ^overlays: [JetDriverSourceDocument]{JetDriverSourceDocument{path: file, source: source}}
    loop (row, other) in files {
        if {
            row < texts.len() && texts[row] != None -> {
                if texts[row] == .Val(text) -> overlays.push(jet_cli_fix_overlay(other.path, text))
            }
            other.source == .Val(text) -> { overlays.push(jet_cli_fix_overlay(other.path, text)) }
        }
    }
    if jet_cli_prepare_overlays(file, file, overlays, false, None, JetDriverCompileMode.Doc) == {
        .Refused(output) -> JetCLICompiled.Refused{output: output.move()}
        .Prepared(request, snapshot) -> {
            ^demanded: request.move()
            demanded.doc_core_on_demand = true
            demanded.artifact_build = true
            jet_cli_compile_prepared(JetCLIPrepared.Prepared{request: demanded.move(), snapshot: snapshot.move()}, None, None)
        }
    }
}

// copy: a compile's overlay owns its file's path and text, while the file
// table keeps both for the rounds after it.
jet_cli_fix_overlay: fn(path: String, text: String) -> JetDriverSourceDocument Never! {
    JetDriverSourceDocument{path: path.copy(), source: text.copy()}
}

// The fixes of `file` with `source` as its text and the file table `files`
// with `texts` (jet_cli_fix_compile): the compiler's own, and the
// `syntax.rewrite` edits of the findings the entry package's build raises
// in it (jet_cli_fix_build_findings). `errors` count every error the compile
// reports in any loaded file, so a fix that breaks the fixed file or a
// sibling file is rolled back. `scope`, the folder of a package `jet fix`
// sweeps ("" when it fixes one file), adds the fixes and errors of each
// source file under it (jet_cli_fix_swept). With `facts` the query keeps the
// compile's definition facts too. `repairs` repair only the errors
// `fresh_against`, the errors before the fixes, does not hold
// (jet_cli_fix_new_errors); every error's when it is empty.
jet_cli_fix_collect: fn(file: String, source: String, files: [JetCLIFixFile], texts: [String?], all: Bool, scope: String, facts: Bool{false}, fresh_against: [String]{[String]{}}, color: Bool{false}, parse_json: Bool{false}) -> JetCLIFixQuery {
    ^diagnostics: [Diagnostic]{}
    ^swept: [Diagnostic]{}
    ^errors: [String]{}
    ^definitions: [SemDefinitionFact]?{None}
    ^parse_failed: false
    ^parse_other: [Diagnostic]{}
    canonical: jet_cli_overlay_path(file)
    if jet_cli_fix_compile(file, source, files, texts) == {
        .Refused(output) -> return JetCLIFixQuery.Refused{output: output}
        .Compiled(result, snapshot) -> {
            if result.internal_problem == .Val(problem) {
                return JetCLIFixQuery.Refused{output: jet_cli_ice(problem)}
            }
            parse_failed = result.failed_stage == Val(JetDriverStage.Parse)
            if facts -> definitions = jet_cli_fix_result_facts(result)
            // The advice (JetDriverCompileResult.advice) carries fixes too.
            ^found: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            loop diagnostic in jet_driver_present_diagnostics(result.advice, snapshot, result.generated_source_files) {
                found.push(diagnostic)
            }
            if !parse_failed {
                loop diagnostic in found {
                    if diagnostic.severity == DIAGNOSTIC_ERROR && (diagnostic.code == "E0001" || diagnostic.code == "E0002" || diagnostic.code == "E0003") {
                        parse_failed = true
                        break
                    }
                }
            }
            loop diagnostic in found.move() {
                if jet_cli_fix_elsewhere(diagnostic, canonical, source) {
                    in_scope: jet_cli_fix_swept(scope, diagnostic, result.generated_source_files)
                    if !in_scope && diagnostic.severity == DIAGNOSTIC_ERROR {
                        errors.push(jet_cli_fix_error(diagnostic, canonical))
                        if parse_failed -> parse_other.push(diagnostic)
                    } else if in_scope {
                        swept.push(diagnostic)
                    }
                    next
                }
                diagnostics.push(diagnostic)
            }
        }
    }
    loop finding in jet_cli_fix_build_findings(file, source) {
        if finding.origin == None -> next
        if finding.origin == .Val(origin) {
            if origin.path != canonical || origin.source != source -> next
        }
        diagnostics.push(finding)
    }
    migrations: jet_cli_fix_migration_sites(diagnostics, source)
    diagnostics.extend(swept.move())
    ^failed: [Diagnostic]{}
    loop diagnostic in diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR {
            errors.push(jet_cli_fix_error(diagnostic, canonical))
            failed.push(diagnostic)
        }
    }
    ^parse_error: JetCLIFixParseError?{None}
    if parse_failed {
        if failed.len() > 0 {
            parse_error = Val(JetCLIFixParseError{report: jet_driver_report_problems(file, source, failed, color, false), reports: if parse_json -> jet_cli_reports_json(jet_cli_report_base(file), file, source, failed) else -> [String]{}})
        } else if parse_other.len() > 0 {
            parse_error = Val(JetCLIFixParseError{report: jet_driver_report_problems(file, source, parse_other, color, false), reports: if parse_json -> jet_cli_reports_json(jet_cli_report_base(file), file, source, parse_other) else -> [String]{}})
        }
    }
    offset: errors.len() - failed.len()
    ^repairs: if parse_failed -> [JetCLIFix]{} else -> jet_cli_fixes_from_diagnostics(jet_cli_fix_fresh(failed.move(), jet_cli_fix_new_errors(errors, fresh_against), offset))
    ^fixes: if parse_failed -> [JetCLIFix]{} else -> jet_cli_fixes_from_diagnostics(diagnostics.move())
    // A migration repairs the error at the retired word, so it is both.
    loop site in migrations {
        fixes.push(jet_cli_fix_retired_run(site))
        repairs.push(jet_cli_fix_retired_run(site))
    }
    JetCLIFixQuery.Fixes{fixes: if all -> fixes else -> jet_cli_safe_fixes(fixes), errors: errors.move(), repairs: if all -> repairs else -> jet_cli_safe_fixes(repairs), definitions: definitions.move(), parse_error: parse_error.move()}
}

// The diagnostics of `failed` whose errors are new: by `fresh`, which marks
// each error of the query's list, the errors of `failed` starting at `offset`.
jet_cli_fix_fresh: fn(failed: ^^[Diagnostic], fresh: [Bool], offset: Int) -> [Diagnostic] Never! {
    ^kept: [Diagnostic]{}
    ^at: offset
    loop diagnostic in failed.move() {
        if fresh[at] -> kept.push(diagnostic.move())
        at += 1
    }
    kept
}

// The rewrites `jet fix` registers for retired spellings: a block after the
// retired build-time word, `comptime { … }`, is written `#run { … }`. They
// are offered only when the compile reported an error at one of those words,
// so a program whose own `comptime` names something keeps it; then every such
// word in the file is rewritten at once, so a second `jet fix` changes
// nothing. The error itself stays the generic one and never names `#run`.
// Returns the words to rewrite (jet_cli_fix_retired_run).
jet_cli_fix_migration_sites: fn(diagnostics: [Diagnostic], source: String) -> [Span] {
    sites: jet_cli_fix_retired_run_words(source)
    ^reported: false
    loop diagnostic in diagnostics {
        if diagnostic.severity != DIAGNOSTIC_ERROR -> next
        if diagnostic.span == .Val(span) {
            loop site in sites {
                if site.start == span.start -> reported = true
            }
        }
    }
    if reported -> sites else -> [Span]{}
}

// The rewrite of one retired build-time word to `#run`.
jet_cli_fix_retired_run: fn(site: Span) -> JetCLIFix {
    JetCLIFix{title: "write the retired `comptime` block as `#run`", edit: TextEdit{span: site, new_text: "#run"}, applicability: DiagnosticFixApplicability.Safe, safety: DiagnosticFixSafety.BehaviorPreserving}
}

// Each `comptime` word right before a `{` where a value or a statement
// starts: after `:`, `=`, `{`, `}` or `;`, or first on its line. A
// word in a condition (`if comptime {`) or an operand stays.
jet_cli_fix_retired_run_words: fn(source: String) -> [Span] {
    bytes: source.bytes()
    lexed: lex(bytes)
    ^sites: [Span]{}
    ^previous: -1
    loop index in 0..<lexed.tokens.len() {
        token: lexed.tokens[index]
        if !jet_cli_fix_meaningful(token) -> next
        if token.kind == TOKEN_IDENT && token.span.end - token.span.start == 8 && foundation_byte_text(bytes, token.span.start, token.span.end) == "comptime" {
            if jet_cli_fix_next_opens_block(lexed.tokens, index + 1) && jet_cli_fix_starts_value(bytes, lexed.tokens, previous, token.span.start) {
                sites.push(token.span)
            }
        }
        previous = index
    }
    sites
}

jet_cli_fix_meaningful: fn(token: Token) -> Bool {
    token.span.start != token.span.end && token.kind != TOKEN_LINE_COMMENT && token.kind != TOKEN_BLOCK_COMMENT
}

jet_cli_fix_next_opens_block: fn(tokens: [Token], from: Int) -> Bool {
    loop index in from..<tokens.len() {
        if jet_cli_fix_meaningful(tokens[index]) -> return tokens[index].kind == TOKEN_LBRACE
    }
    false
}

jet_cli_fix_starts_value: fn(bytes: [U8], tokens: [Token], previous: Int, start: Int) -> Bool {
    if previous < 0 -> return true
    before: tokens[previous]
    if before.kind == TOKEN_COLON || before.kind == TOKEN_EQ || before.kind == TOKEN_LBRACE || before.kind == TOKEN_RBRACE || before.kind == TOKEN_SEMI {
        return true
    }
    loop at in before.span.end..<start {
        if (Int{bytes[at]}) == 10 -> return true
    }
    false
}

// Whether `diagnostic` reports in a file other than `canonical`, the fixed
// file, or in an older text of it than `source`.
jet_cli_fix_elsewhere: fn(diagnostic: Diagnostic, canonical: String, source: String) -> Bool Never! {
    if diagnostic.origin == .Val(origin) {
        return origin.path != canonical || origin.source != source
    }
    false
}

// Whether a directory's `jet fix` sweeps the file `diagnostic` reports in: a
// source file under `scope`, the package's folder ("" for none), and not
// one a build step generated (`generated`).
jet_cli_fix_swept: fn(scope: String, diagnostic: Diagnostic, generated: [SourceFile]) -> Bool Never! {
    if scope == "" -> return false
    if diagnostic.origin == .Val(origin) {
        if !origin.path.starts_with("{scope}/") -> return false
        loop file in generated {
            if file.path == origin.path -> return false
        }
        return true
    }
    false
}

// An error as jet_cli_fix_checked compares them, `CODE: what`, after the
// path of its file when that is not `canonical`, the fixed file.
jet_cli_fix_error: fn(diagnostic: Diagnostic, canonical: String) -> String Never! {
    headline: diagnostic_headline(diagnostic.code, diagnostic.what)
    if diagnostic.origin == .Val(origin) {
        if origin.path != canonical -> return "{origin.path}: {headline}"
    }
    headline
}

// The `.Tidy` findings a package lint raises (`meta.report`) when the entry
// package's `build: fn` runs with `file` reading `source`, presented in
// their files; none when the package has no build or it fails. A finding's
// `syntax.rewrite` fix is its edit.
jet_cli_fix_build_findings: fn(file: String, source: String) -> [Diagnostic] {
    if jet_cli_prepare_overlays(file, file, [JetDriverSourceDocument]{JetDriverSourceDocument{path: file, source: source}}, false, None, JetDriverCompileMode.Doc) == {
        .Refused(_) -> [Diagnostic]{}
        .Prepared(request, _) -> {
            owned: request.move()
            if !jet_driver_entry_package_has_build(owned) -> return [Diagnostic]{}
            ^scope: JetDriverBuildQueryScope{next_session_id: 1}
            response: jet_driver_query_build_plan(owned, scope)
            query: response.query.move()
            if !query.complete || query.internal_problem != None -> return [Diagnostic]{}
            jet_driver_present_diagnostics(query.tidy, response.request.authorized_sources, query.generated_source_files)
        }
    }
}

// The errors of `file` with `source` as its text and the file table `files`
// with `texts`, and of the package folder `scope` sweeps
// (jet_cli_fix_collect); a file the compiler refuses is one error.
jet_cli_fix_errors: fn(file: String, source: String, files: [JetCLIFixFile], texts: [String?], scope: String) -> [String] {
    if jet_cli_fix_collect(file, source, files, texts, false, scope) == {
        .Fixes(_, errors, _, _, _) -> errors
        .Refused(_) -> [String]{"the compiler refused the edited file"}
    }
}

// Whether `applied` changes the fixed file from `source` or a file of the
// table `files` from its text with the fixes so far.
jet_cli_fix_changes: fn(applied: JetCLIFixApply, source: String, files: [JetCLIFixFile]) -> Bool Never! {
    if applied.source != source -> return true
    loop (row, text) in applied.texts {
        if text == .Val(edited) {
            if {
                files[row].source == .Val(current) -> {
                    if edited != current -> return true
                }
                files[row].before == .Val(original) -> {
                    if edited != original -> return true
                }
            }
        }
    }
    false
}

// Whether `a` and `b`, two applications of fixes to the same files, leave
// any file different.
jet_cli_fix_differs: fn(a: JetCLIFixApply, b: JetCLIFixApply) -> Bool Never! {
    if a.source != b.source -> return true
    count: if a.texts.len() > b.texts.len() -> a.texts.len() else -> b.texts.len()
    loop row in 0..<count {
        if {
            row >= a.texts.len() -> {
                if b.texts[row] != None -> return true
            }
            row >= b.texts.len() -> {
                if a.texts[row] != None -> return true
            }
            a.texts[row] != b.texts[row] -> { return true }
        }
    }
    false
}

// Whether the fixes so far change any file of the table `files` from its
// text before `jet fix`.
jet_cli_fix_touched: fn(files: [JetCLIFixFile]) -> Bool Never! {
    loop file in files {
        if file.source == .Val(edited) {
            if file.before == .Val(original) {
                if edited != original -> return true
            }
        }
    }
    false
}

// Takes each file `fixes` change into the file table `files`, read from
// disk the first time (a file that can't be read keeps no text, and the
// fixes that edit it are refused, jet_cli_fix_apply_non_overlapping), and
// gives each edit its row: the file its TextEdit.path names, else the fix's
// home (JetCLIFix.home); `canonical`, the fixed file, is row -1.
jet_cli_fix_resolve: fn(files: ^[JetCLIFixFile], canonical: String, fixes: ^^[JetCLIFix]) -> [JetCLIFix] {
    ^resolved: [JetCLIFix]{}
    loop fix in fixes.move() {
        ^home: -1
        if fix.home.move() == .Val(path) -> home = jet_cli_fix_row(files, canonical, path.move())
        first: jet_cli_fix_place(files, canonical, home, fix.edit.move())
        ^edits: [TextEdit]{}
        ^rows: [Int]{}
        loop other in fix.edits.move() {
            placed: jet_cli_fix_place(files, canonical, home, other.move())
            rows.push(placed.row)
            edits.push(placed.edit.move())
        }
        resolved.push(JetCLIFix{title: fix.title.move(), edit: first.edit.move(), applicability: fix.applicability, safety: fix.safety, edits: edits.move(), file: first.row, files: rows.move()})
    }
    resolved
}

// An edit without its path, and the row of the file it changes.
JetCLIFixPlaced: struct {
    edit: TextEdit,
    row: Int,
}

// `edit` without its path, at the row of the file the path names, else at
// `home`.
jet_cli_fix_place: fn(files: ^[JetCLIFixFile], canonical: String, home: Int, edit: ^^TextEdit) -> JetCLIFixPlaced {
    stripped: TextEdit{span: edit.span, new_text: edit.new_text.move()}
    named: edit.path.move() ?? return JetCLIFixPlaced{edit: stripped.move(), row: home}
    JetCLIFixPlaced{edit: stripped.move(), row: jet_cli_fix_row(files, canonical, named.move())}
}

// The row of the file at `path` in the file table `files`, read the first
// time; -1 for `canonical`, the fixed file.
jet_cli_fix_row: fn(files: ^[JetCLIFixFile], canonical: String, path: ^^String) -> Int {
    if path == canonical -> return -1
    loop (row, other) in files {
        if other.path == path -> return row
    }
    text: jet_cli_fix_read(path)
    files.push(JetCLIFixFile{path: path.move(), before: text, source: None})
    files.len() - 1
}

jet_cli_fix_read: fn(path: String) -> String? {
    text: cli_files.read(path) ?? return None
    Val(text.move())
}

// Sets each file of the table `files` that `texts` (by row) gives a text to
// that text.
jet_cli_fix_settle: fn(files: ^[JetCLIFixFile], texts: ^^[String?]) Never! {
    ^row: 0
    loop text in texts.move() {
        if text != None -> files[row].source = text
        row += 1
    }
}

// Applies `fixes` to `source` and the file table `files`
// (jet_cli_fix_apply_non_overlapping) and checks the result: an edit is
// kept only while the files, and the package folder `scope` sweeps, report
// no error that `baseline`, their errors before `jet fix`, does not
// (jet_cli_fix_added): fewer errors in all do not pay for a new one. When the
// whole set adds errors, each file's fixes are tried together on top of the
// ones kept so far (the whole set is one file's when its fixes change one
// file), and a file's set that adds errors is tried by halves
// (jet_cli_fix_bisect): the checks grow with the fixes rolled back, not with
// every fix. A fix that adds an error alone is tried again with the repairs
// of the errors it adds (jet_cli_fix_chain); rolled back, it goes into
// `rejected` with the first error it adds. Once a chain is kept the files
// differ from the ones the other fixes were read from, so each fix rolled
// back after it waits for the next round (`deferred`). A fix none of whose
// edits can apply goes to `refused`.
jet_cli_fix_checked: fn(file: String, source: String, files: [JetCLIFixFile], fixes: [JetCLIFix], baseline: [String], rejected: ^[JetCLIFixSkip], refused: ^[JetCLIFixSkip], scope: String) -> JetCLIFixApply {
    whole: jet_cli_fix_apply_non_overlapping(source, files, fixes, jet_cli_fix_all(fixes))
    loop refusal in whole.refused -> jet_cli_fix_skip(refused, fixes[refusal.fix], refusal.reason)
    if !jet_cli_fix_changes(whole, source, files) || jet_cli_fix_added(jet_cli_fix_errors(file, whole.source, files, whole.texts, scope), baseline) == None {
        return whole
    }
    ^trial: JetCLIFixTrial{file: file, source: source, scope: scope, kept: [Int]{}, result: JetCLIFixApply{source: source, applied: 0, deferred: whole.deferred}}
    groups: jet_cli_fix_groups(fixes)
    loop group in groups {
        // The whole set is the one group's, and it adds errors.
        if groups.len() == 1 -> jet_cli_fix_halves(trial, files, fixes, baseline, group) else {
            jet_cli_fix_bisect(trial, files, fixes, baseline, group)
        }
    }
    ^chained: false
    failures: trial.failed.move()
    trial.failed = [JetCLIFixRefusal]{}
    loop failure in failures {
        if chained {
            trial.result.deferred += 1
            next
        }
        if jet_cli_fix_chain(trial, files, fixes, baseline, failure.fix) {
            chained = true
            next
        }
        jet_cli_fix_skip(rejected, fixes[failure.fix], failure.reason)
    }
    trial.result.move()
}

// The rounds of repairs jet_cli_fix_chain applies after a fix at most.
JET_CLI_FIX_CHAIN_ROUNDS: 4

// Tries fix `index`, which adds errors on top of the fixes `trial` kept,
// again with the repairs of the errors it adds: the safe fixes those new
// errors carry are applied with it, and the files are checked again, for
// JET_CLI_FIX_CHAIN_ROUNDS rounds at most. The KeyBy rewrite of a Map key's
// written equality, say, brings the E0908 whose own edit deletes the written
// order beside it. A repair applies only when it edits the fixed file alone
// and leaves the text the fix wrote as written (jet_cli_fix_rewrites): an
// error in that text means the fix itself is wrong. Kept into `trial` when
// the files then report no error `baseline` does not (jet_cli_fix_added)
// and differ from the ones `trial` kept; else the whole chain is rolled back.
jet_cli_fix_chain: fn(trial: ^JetCLIFixTrial, files: [JetCLIFixFile], fixes: [JetCLIFix], baseline: [String], index: Int) -> Bool {
    ^chosen: [Int]{}
    loop earlier in trial.kept -> chosen.push(earlier)
    chosen.push(index)
    first: jet_cli_fix_apply_non_overlapping(trial.source, files, fixes, chosen)
    if !first.fixes.contains(index) -> return false
    canonical: jet_cli_overlay_path(trial.file)
    ^source: first.source.move()
    ^applied: first.applied
    ^written: jet_cli_fix_written(fixes, first.fixes, index)
    ^round: 0
    loop round <= JET_CLI_FIX_CHAIN_ROUNDS {
        if jet_cli_fix_collect(trial.file, source, files, first.texts, false, trial.scope, fresh_against: baseline) == {
            .Refused(_) -> return false
            .Fixes(_, errors, repairs, _, _) -> {
                if jet_cli_fix_added(errors, baseline) == None {
                    chain: JetCLIFixApply{source: source.move(), applied: applied, deferred: trial.result.deferred, texts: first.texts.move(), fixes: first.fixes.move()}
                    if !jet_cli_fix_differs(chain, trial.result) -> return false
                    trial.kept.push(index)
                    trial.result = chain.move()
                    return true
                }
                if round == JET_CLI_FIX_CHAIN_ROUNDS -> return false
                ^usable: [Int]{}
                loop (at, repair) in repairs {
                    if jet_cli_fix_in_file(repair, canonical) && !jet_cli_fix_rewrites(repairs, at, written) {
                        usable.push(at)
                    }
                }
                step: jet_cli_fix_apply_non_overlapping(source, files, repairs, usable)
                if step.applied == 0 || step.source == source -> return false
                source = step.source.move()
                applied += step.applied
                written = jet_cli_fix_moved(repairs, step.fixes, written)
            }
        }
        round += 1
    }
    false
}

// Whether every edit of `fix` changes the fixed file, `canonical`: its
// diagnostic's file and each edit's path, where they name one, are it.
jet_cli_fix_in_file: fn(fix: JetCLIFix, canonical: String) -> Bool Never! {
    if fix.home == .Val(home) {
        if home != canonical -> return false
    }
    if fix.edit.path == .Val(path) {
        if path != canonical -> return false
    }
    loop edit in fix.edits {
        if edit.path == .Val(path) {
            if path != canonical -> return false
        }
    }
    true
}

// The spans of the fixed file that the edits of fix `index` wrote, in its
// text with the fixes at `applied`, which hold `index`, applied.
jet_cli_fix_written: fn(fixes: [JetCLIFix], applied: [Int], index: Int) -> [Span] Never! {
    ^written: [Span]{}
    loop part in -1..<fixes[index].edits.len() {
        edit: JetCLIFixEditRef{fix: index, at: part}
        if jet_cli_fix_edit_row(fixes, edit) != -1 -> next
        span: jet_cli_fix_edit_span(fixes, edit)
        start: span.start + jet_cli_fix_shift(fixes, applied, span.start)
        written.push(Span{start: start, end: start + jet_cli_fix_edit_length(fixes, edit)})
    }
    written
}

// The spans `written` after the fixes at `applied`, none of which edits
// inside them, apply to the fixed file.
jet_cli_fix_moved: fn(fixes: [JetCLIFix], applied: [Int], written: [Span]) -> [Span] Never! {
    ^moved: [Span]{}
    loop span in written {
        shift: jet_cli_fix_shift(fixes, applied, span.start)
        moved.push(Span{start: span.start + shift, end: span.end + shift})
    }
    moved
}

// How far the edits of the fixes at `applied` that change the fixed file
// and end before `at` (an insertion at `at` aside) move the text at `at`.
jet_cli_fix_shift: fn(fixes: [JetCLIFix], applied: [Int], at: Int) -> Int Never! {
    ^shift: 0
    loop index in applied {
        loop part in -1..<fixes[index].edits.len() {
            edit: JetCLIFixEditRef{fix: index, at: part}
            span: jet_cli_fix_edit_span(fixes, edit)
            if jet_cli_fix_edit_row(fixes, edit) != -1 || span.start >= at || span.end > at -> next
            shift += jet_cli_fix_edit_length(fixes, edit) - (span.end - span.start)
        }
    }
    shift
}

// The length of the text `edit` writes.
jet_cli_fix_edit_length: fn(fixes: [JetCLIFix], edit: JetCLIFixEditRef) -> Int Never! {
    if edit.at < 0 -> return fixes[edit.fix].edit.new_text.len()
    fixes[edit.fix].edits[edit.at].new_text.len()
}

// Whether an edit of fix `index` changes text of the spans `written`.
jet_cli_fix_rewrites: fn(fixes: [JetCLIFix], index: Int, written: [Span]) -> Bool Never! {
    loop part in -1..<fixes[index].edits.len() {
        span: jet_cli_fix_edit_span(fixes, JetCLIFixEditRef{fix: index, at: part})
        loop text in written {
            if span.start < text.end && text.start < span.end -> return true
        }
    }
    false
}

// What jet_cli_fix_checked tries its fixes on: the fixed `file` with
// `source` as its text, the package folder `scope` sweeps, the indices of
// the fixes kept so far (`kept`) and the files with them applied
// (`result`, its `deferred` the whole set's), and each fix that adds an
// error alone with the first error it adds (`failed`).
JetCLIFixTrial: struct {
    file: String,
    source: String,
    scope: String,
    kept: [Int],
    result: JetCLIFixApply,
    failed: [JetCLIFixRefusal]{[JetCLIFixRefusal]{}},
}

// Tries the fixes at `part` together on top of the ones `trial` kept: kept
// when the files report no error `baseline` does not (jet_cli_fix_added);
// else, when `part` is one fix, recorded in `trial.failed` with the first
// error it adds, or tried again by halves (jet_cli_fix_halves). A set that
// changes nothing more is left out.
jet_cli_fix_bisect: fn(trial: ^JetCLIFixTrial, files: [JetCLIFixFile], fixes: [JetCLIFix], baseline: [String], part: [Int]) {
    ^chosen: [Int]{}
    loop earlier in trial.kept -> chosen.push(earlier)
    loop index in part -> chosen.push(index)
    applied: jet_cli_fix_apply_non_overlapping(trial.source, files, fixes, chosen)
    if !jet_cli_fix_differs(applied, trial.result) {
        return
    }
    errors: jet_cli_fix_errors(trial.file, applied.source, files, applied.texts, trial.scope)
    added: jet_cli_fix_added(errors, baseline) ?? {
        loop index in part -> trial.kept.push(index)
        trial.result = JetCLIFixApply{source: applied.source, applied: applied.applied, deferred: trial.result.deferred, texts: applied.texts, fixes: applied.fixes}
        return
    }
    if part.len() > 1 {
        jet_cli_fix_halves(trial, files, fixes, baseline, part)
        return
    }
    trial.failed.push(JetCLIFixRefusal{fix: part[0], reason: "the edited file no longer checks: {errors[added]}"})
}

// The index in `errors` of the first error `baseline` does not hold, each
// baseline error matching one error at most: errors are compared as
// `[path: ]CODE: what` (jet_cli_fix_error), which names what each refers
// to; spans are left out because the fixes move them. None when every error
// was there before.
jet_cli_fix_added: fn(errors: [String], baseline: [String]) -> Int? Never! {
    loop (index, fresh) in jet_cli_fix_new_errors(errors, baseline) {
        if fresh -> return Val(index)
    }
    None
}

// Whether each of `errors` is one `baseline` does not hold, each baseline
// error matching one error at most, in order (jet_cli_fix_added).
jet_cli_fix_new_errors: fn(errors: [String], baseline: [String]) -> [Bool] Never! {
    ^used: [Bool]{}
    loop _ in 0..<baseline.len() -> used.push(false)
    ^fresh: [Bool]{}
    loop error in errors {
        ^matched: false
        loop (row, known) in baseline {
            if used[row] || known != error -> next
            used[row] = true
            matched = true
            break
        }
        fresh.push(!matched)
    }
    fresh
}

// The fixes at `part`, which add errors together on top of the ones `trial`
// kept, tried as two halves in order (jet_cli_fix_bisect); one fix is tried
// again alone, for the error it adds.
jet_cli_fix_halves: fn(trial: ^JetCLIFixTrial, files: [JetCLIFixFile], fixes: [JetCLIFix], baseline: [String], part: [Int]) {
    if part.len() == 1 {
        jet_cli_fix_bisect(trial, files, fixes, baseline, part)
        return
    }
    half: part.len() /% 2
    jet_cli_fix_bisect(trial, files, fixes, baseline, part.slice(0, half))
    jet_cli_fix_bisect(trial, files, fixes, baseline, part.slice(half, part.len()))
}

// The indices of `fixes` by the file their first edit changes (its row),
// each file's in order, the files in the order of their first fix.
jet_cli_fix_groups: fn(fixes: [JetCLIFix]) -> [[Int]] Never! {
    ^groups: [[Int]]{}
    ^slots: [Int:Int]{}
    loop (index, fix) in fixes {
        if slots.get(fix.file) == .Val(slot) {
            groups[slot].push(index)
            next
        }
        slots[fix.file] = groups.len()
        groups.push([Int]{index})
    }
    groups
}

// Records `fix` as skipped, once per edit.
jet_cli_fix_skip: fn(skips: ^[JetCLIFixSkip], fix: JetCLIFix, reason: String) Never! {
    loop skip in skips {
        if skip.file == fix.file && skip.edit.span.start == fix.edit.span.start && skip.edit.span.end == fix.edit.span.end && skip.edit.new_text == fix.edit.new_text {
            return
        }
    }
    skips.push(JetCLIFixSkip{title: fix.title, edit: fix.edit, reason: reason, file: fix.file})
}

// `jet fix --markers inside|above`: write every declaration's whole marker
// set in one place. Nested declarations overlap their parent's edit, so the
// moves apply in rounds.
jet_cli_fix_markers: fn(before: String, inside: Bool) -> JetCLIFixApply {
    ^source: before
    ^count: 0
    ^round: 0
    loop round < 16 {
        fixes: loop edit in parser_marker_placement_edits(source.bytes(), inside) -> JetCLIFix{title: "move the markers", edit: edit, applicability: DiagnosticFixApplicability.Safe, safety: DiagnosticFixSafety.BehaviorPreserving}
        if fixes.len() == 0 -> break
        applied: jet_cli_fix_apply_non_overlapping(source, [JetCLIFixFile]{}, fixes, jet_cli_fix_all(fixes))
        if applied.source == source -> break
        source = applied.source
        count += applied.applied
        round += 1
    }
    JetCLIFixApply{source: source, applied: count, deferred: 0}
}

// What `jet fix` writes besides `--markers`: the checker's suggestions, the
// `--style` moves, or each inferred failure contract (`--pin-failures`).
JetCLIFixMode: enum {
    Suggestions,
    Style,
    PinFailures,
}

// `jet fix <target>`: a file, or a package's folder. A folder fixes its
// package entry and sweeps each source file under it from the same check
// (jet_cli_fix_collect `scope`), and names each file it fixes.
jet_cli_fix_run: fn(target: String, dry_run: Bool, all: Bool, markers: String, mode: JetCLIFixMode, color: Bool, quiet: Bool, json: Bool) -> JetDriverVerbOutput {
    file: jet_cli_fix_entry(target) ?? return jet_cli_report_output("", "E2105", "can't find the package entry of `{target}`", jet_cli_why("E2105"), "correct the named problem, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
    scope: if cli_files.is_dir(target) -> jet_cli_overlay_path(target) else -> ""
    before: cli_files.read(file) ?? return jet_cli_report_output("", "E2105", "can't find the file `{file}`", jet_cli_why("E2105"), "correct the named problem, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
    ^all_fixes: [JetCLIFix]{}
    ^all_repairs: [JetCLIFix]{}
    ^baseline: [String]{}
    // The definition facts the write's rename receipt starts from.
    ^before_facts: [SemDefinitionFact]?{None}
    ^parse_error: JetCLIFixParseError?{None}
    if jet_cli_fix_collect(file, before, [JetCLIFixFile]{}, [String?]{}, true, scope, facts: !dry_run, color: color, parse_json: json) == {
        .Fixes(found, errors, repairs, definitions, parsed) -> {
            all_fixes = found
            baseline = errors
            all_repairs = repairs
            before_facts = definitions
            parse_error = parsed
        }
        .Refused(output) -> { return output }
    }
    // `--markers`, `--style` and `--pin-failures` apply their own edits, not
    // the suggestions; a style move left for a hand edit is counted as skipped.
    suggestions: markers == "" && mode == JetCLIFixMode.Suggestions
    ^skipped: if suggestions -> all_fixes.len() - jet_cli_safe_fixes(all_fixes).len() else -> 0
    ^skips: [JetCLIFixSkip]{}
    if !all && suggestions {
        loop fix in all_fixes {
            if jet_cli_safe_fixes([JetCLIFix]{fix.copy()}).len() == 0 {
                jet_cli_fix_skip(skips, fix, "needs review: `jet fix --all` applies it")
            }
        }
    }
    ^rejected: [JetCLIFixSkip]{}
    ^refused: [JetCLIFixSkip]{}
    ^applied: JetCLIFixApply{source: before, applied: 0, deferred: 0}
    ^count: 0
    ^files: [JetCLIFixFile]{}
    canonical: jet_cli_overlay_path(file)
    // The fixes applied in each file, by row of `files` + 1 (0: `file`).
    ^tally: [Int]{}
    if {
        markers != "" -> {
            // The moved file must check no worse than the input.
            applied = jet_cli_fix_markers(before, markers == "inside")
            count = applied.applied
            if applied.source != before && jet_cli_fix_added(jet_cli_fix_errors(file, applied.source, files, [String?]{}, scope), baseline) != None {
                return jet_cli_report_output("", "E2105", "moving the markers {markers} would make `{file}` fail to check", jet_cli_why("E2105"), "fix the file's errors first, then run `jet fix --markers {markers}` again", color, JET_DRIVER_EXIT_USER_ERROR)
            }
        }
        mode == JetCLIFixMode.Style -> {
            // The moved file must check no worse than the input.
            applied = jet_cli_fix_style(before)
            count = applied.applied
            skipped = applied.deferred
            if applied.source != before && jet_cli_fix_added(jet_cli_fix_errors(file, applied.source, files, [String?]{}, scope), baseline) != None {
                return jet_cli_report_output("", "E2105", "moving the impls into their types would make `{file}` fail to check", jet_cli_why("E2105"), "fix the file's errors first, then run `jet fix --style` again", color, JET_DRIVER_EXIT_USER_ERROR)
            }
        }
        mode == JetCLIFixMode.PinFailures -> {
            // The pinned file must check no worse than the input.
            if jet_cli_fix_pin_failures(file, before, color) == {
                .Refused(output) -> return output
                .Pinned(pinned) -> {
                    if pinned == .Val(value) -> applied = value
                }
            }
            count = applied.applied
            if applied.source != before && jet_cli_fix_added(jet_cli_fix_errors(file, applied.source, files, [String?]{}, scope), baseline) != None {
                return jet_cli_report_output("", "E2105", "pinning the failure contracts would make `{file}` fail to check", jet_cli_why("E2105"), "write the contracts that fail by hand, then run `jet fix --pin-failures` again", color, JET_DRIVER_EXIT_USER_ERROR)
            }
        }
        else -> {
            first: jet_cli_fix_round(all_fixes, all_repairs, all)
            ^held: first.held
            fixes: jet_cli_fix_resolve(files, canonical, first.fixes.move())
            applied = jet_cli_fix_checked(file, before, files, fixes, baseline, rejected, refused, scope)
            count = applied.applied
            jet_cli_fix_tally(tally, fixes, applied.fixes)
            // Repairs that change nothing release the held fixes next round.
            ^stalled: held && !jet_cli_fix_changes(applied, before, files)
            jet_cli_fix_settle(files, applied.texts.move())
            ^round: 1
            loop round < 16 && (applied.deferred > 0 || held) {
                next: if jet_cli_fix_collect(file, applied.source, files, [String?]{}, all, scope) == {
                    .Fixes(found, _, repairs, _, _) -> jet_cli_fix_round(found, if stalled -> [JetCLIFix]{} else -> repairs, true)
                    .Refused(output) -> {
                        return output
                    }
                }
                held = next.held
                more: jet_cli_fix_resolve(files, canonical, next.fixes.move())
                next_applied: jet_cli_fix_checked(file, applied.source, files, more, baseline, rejected, refused, scope)
                if {
                    !jet_cli_fix_changes(next_applied, applied.source, files) -> {
                        if !held -> break
                        stalled = true
                    }
                    else -> {
                        count += next_applied.applied
                        jet_cli_fix_tally(tally, more, next_applied.fixes)
                        jet_cli_fix_settle(files, next_applied.texts.move())
                        applied.source = next_applied.source.move()
                        applied.deferred = next_applied.deferred
                    }
                }
                round += 1
            }
        }
    }
    loop skip in rejected -> skips.push(skip)
    loop skip in refused -> skips.push(skip)
    // Each rolled-back fix, with the error its edit adds, and each fix
    // refused whole, with why, each named by the file it edits.
    ^rolled: ""
    loop skip in rejected {
        rolled = "{rolled}{jet_cli_fix_named(target, scope, file, canonical, files, skip.file)}: rolled back the fix at {skip.edit.span.start}..{skip.edit.span.end} -> `{skip.edit.new_text}`: {skip.reason}\n"
    }
    loop skip in refused {
        rolled = "{rolled}{jet_cli_fix_named(target, scope, file, canonical, files, skip.file)}: refused the fix at {skip.edit.span.start}..{skip.edit.span.end} -> `{skip.edit.new_text}`: {skip.reason}\n"
    }
    ^status: ""
    if applied.source == before && !jet_cli_fix_touched(files) {
        if parse_error == .Val(parsed) {
            if json {
                return JetDriverVerbOutput{stdout: jet_cli_fix_status_failed(target, dry_run, 0, skips, parsed.reports), stderr: "", exit_code: JET_DRIVER_EXIT_USER_ERROR}
            }
            return JetDriverVerbOutput{stdout: "", stderr: "{rolled}{parsed.report}", exit_code: JET_DRIVER_EXIT_USER_ERROR}
        }
        if json {
            return JetDriverVerbOutput{stdout: jet_cli_fix_status(target, dry_run, 0, skips, None), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
        }
        detail: if skipped == 0 -> "" else -> " ({skipped} suggestion{if skipped == 1 -> "" else -> "s"} need review)"
        status = "{rolled}{target}: no changes made{detail}\n"
        return JetDriverVerbOutput{stdout: "", stderr: if quiet -> "" else -> status, exit_code: JET_DRIVER_EXIT_OK}
    }
    verb: if dry_run -> "would apply" else -> "applied"
    // A folder's line per file it fixes, then its total.
    ^total: "{target}: {verb} {count} fix{if count == 1 -> "" else -> "es"}"
    if scope != "" {
        ^fixed: 0
        loop (slot, applied_here) in tally {
            if applied_here == 0 -> next
            fixed += 1
            rolled = "{rolled}{jet_cli_fix_named(target, scope, file, canonical, files, slot - 1)}: {verb} {applied_here} fix{if applied_here == 1 -> "" else -> "es"}\n"
        }
        total = "{total} in {fixed} file{if fixed == 1 -> "" else -> "s"}"
    }
    ^diff: ""
    if {
        dry_run -> {
            if json {
                return JetDriverVerbOutput{stdout: jet_cli_fix_status(target, dry_run, count, skips, None), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
            }
            diff = jet_format_unified_diff(jet_cli_fix_named(target, scope, file, canonical, files, -1), before, applied.source)
            loop (row, changed) in files {
                if changed.source == .Val(edited) {
                    if changed.before == .Val(original) {
                        if edited != original {
                            diff = "{diff}{jet_format_unified_diff(jet_cli_fix_named(target, scope, file, canonical, files, row), original, edited)}"
                        }
                    }
                }
            }
            status = "{rolled}{total} (dry run; nothing written)\n"
            if skipped > 0 {
                status = "{status}{target}: skipped {skipped} suggestion{if skipped == 1 -> "" else -> "s"} for review (dry run)\n"
            }
        }
        else -> {
            // The receipt's renames: the first check's definition facts against
            // one check of the fixed files.
            ^renames: [JetCLISemOp]{}
            if before_facts == .Val(old_facts) {
                if jet_cli_fix_compile(file, applied.source, files, [String?]{}) == .Compiled(result, _) {
                    if jet_cli_fix_result_facts(result) == .Val(new_facts) {
                        renames = jet_cli_semantic_rename_ops(old_facts, new_facts)
                    }
                }
            }
            ^others: [JetCLISourceChange]{}
            loop changed in files.move() {
                if changed.source == .Val(edited) {
                    if changed.before == .Val(original) {
                        if edited != original {
                            others.push(JetCLISourceChange{path: changed.path.move(), before: original.bytes(), after: edited.bytes()})
                        }
                    }
                }
            }
            log: jet_cli_commit_fix(file, before.bytes(), applied.source.bytes(), renames.move(), skips, others.move()) ?? return jet_cli_report_output("", "E2105", err.message, jet_cli_why("E2105"), "correct the named problem, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
            if json {
                return JetDriverVerbOutput{stdout: jet_cli_fix_status(target, dry_run, count, skips, Val(log)), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
            }
            status = "{rolled}{total}\n"
            if skipped > 0 {
                status = "{status}{target}: skipped {skipped} suggestion{if skipped == 1 -> "" else -> "s"} for review\n"
            }
            status = "{status}  Log: {log}\n"
        }
    }
    JetDriverVerbOutput{stdout: diff, stderr: if quiet -> "" else -> status, exit_code: JET_DRIVER_EXIT_OK}
}

// The file `jet fix <target>` fixes: `target`, or a folder's package entry
// (None when it has none; the front end reported that already).
jet_cli_fix_entry: fn(target: String) -> String? {
    if !cli_files.is_dir(target) -> return Val("{target}")
    if jet_cli_resolve_source_path("fix", target, false, [String]{}) == {
        .File(path, _, _) -> Val(path)
        .Refused(_) -> None
    }
}

// Counts each fix of `fixes` at `applied` in `tally` by the file its first
// edit changes: at its row + 1, 0 for the fixed file.
jet_cli_fix_tally: fn(tally: ^[Int], fixes: [JetCLIFix], applied: [Int]) Never! {
    loop index in applied {
        slot: fixes[index].file + 1
        loop tally.len() <= slot -> tally.push(0)
        tally[slot] = tally[slot] + 1
    }
}

// The file at `row` of the file table `files` (-1: `canonical`, the fixed
// `file`) as `jet fix <target>` names it. For one file, `target` itself, and
// another file beside `file` when it sits in `file`'s folder or under it,
// else whole; for a folder, whose canonical path is `scope`, each file as
// under `target`.
jet_cli_fix_named: fn(target: String, scope: String, file: String, canonical: String, files: [JetCLIFixFile], row: Int) -[FS, Env]> String Never! {
    if row < 0 && scope == "" -> return "{target}"
    path: if row < 0 -> canonical else -> files[row].path
    folder: if scope == "" -> (jet_cli_parent(canonical) ?? "") else -> "{scope}"
    if folder == "" || !path.starts_with("{folder}/") -> return "{path}"
    rest: path.slice(folder.len() + 1, path.len())
    written: if scope == "" -> (jet_cli_parent(file) ?? "") else -> jet_cli_fix_trimmed(target)
    if written == "" || written == "." -> return rest
    "{written}/{rest}"
}

// `folder` without a trailing `/`.
jet_cli_fix_trimmed: fn(folder: String) -> String Never! {
    if folder.len() > 1 && folder.ends_with("/") -> return folder.slice(0, folder.len() - 1)
    "{folder}"
}

// `jet fix --json`: one jet.status/v1 line naming the edits applied (or, on
// a dry run, that would be) and each edit left out with its reason. A
// needs-review suggestion such as a script's authority grant stays out until
// `jet fix --all` or a hand edit decides it; a rolled-back fix names the
// error it adds. `log` is the replay log of a written file.
jet_cli_fix_status: fn(file: String, dry_run: Bool, count: Int, skips: [JetCLIFixSkip], log: String?) -> String Never! {
    skipped: loop skip in skips -> jet_cli_status_object(
        [JetCLIStatusField]{
            jet_cli_status_field("title", jet_cli_status_text(skip.title)),
            jet_cli_status_field("reason", jet_cli_status_text(skip.reason)),
            jet_cli_status_field("span", jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("start", jet_cli_status_int(skip.edit.span.start)), jet_cli_status_field("end", jet_cli_status_int(skip.edit.span.end))})),
            jet_cli_status_field("new_text", jet_cli_status_text(skip.edit.new_text)),
        },
    )
    fix: jet_cli_status_object(
        [JetCLIStatusField]{
            jet_cli_status_field("file", jet_cli_status_text(file)),
            jet_cli_status_field("dry_run", jet_cli_status_bool(dry_run)),
            jet_cli_status_field("applied", jet_cli_status_int(count)),
            jet_cli_status_field("skipped", jet_cli_status_array(skipped)),
            jet_cli_status_field("log", jet_cli_status_optional_text(log)),
        },
    )
    "{jet_cli_status_render("fix", true, [JetCLIStatusField]{jet_cli_status_field("fix", fix)})}\n"
}

jet_cli_fix_status_failed: fn(file: String, dry_run: Bool, count: Int, skips: [JetCLIFixSkip], reports: [String]) -> String Never! {
    skipped: loop skip in skips -> jet_cli_status_object(
        [JetCLIStatusField]{
            jet_cli_status_field("title", jet_cli_status_text(skip.title)),
            jet_cli_status_field("reason", jet_cli_status_text(skip.reason)),
            jet_cli_status_field("span", jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("start", jet_cli_status_int(skip.edit.span.start)), jet_cli_status_field("end", jet_cli_status_int(skip.edit.span.end))})),
            jet_cli_status_field("new_text", jet_cli_status_text(skip.edit.new_text)),
        },
    )
    fix: jet_cli_status_object(
        [JetCLIStatusField]{
            jet_cli_status_field("file", jet_cli_status_text(file)),
            jet_cli_status_field("dry_run", jet_cli_status_bool(dry_run)),
            jet_cli_status_field("applied", jet_cli_status_int(count)),
            jet_cli_status_field("skipped", jet_cli_status_array(skipped)),
            jet_cli_status_field("log", jet_cli_status_optional_text(None)),
        },
    )
    "{jet_cli_status_render_with_reports("fix", false, reports, [JetCLIStatusField]{jet_cli_status_field("fix", fix)})}\n"
}
