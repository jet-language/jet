// `jet emit --ast <file>`: the parsed syntax tree of the entry file as
// EmitTree nodes. Each node names one item, statement, expression or pattern
// with its written names, operators and types; children are its operands and
// bodies in source order. Spans are not printed, so the output depends only
// on the program's structure.
use {
    jet_foundation.[
        ASTTables,
        BindName,
        BindPattern,
        Binding,
        CallArg,
        ExprField,
        ExprNode,
        ExprPair,
        ExternFn,
        Func,
        ImportDecl,
        ImportedItem,
        Item,
        LValue,
        LambdaBody,
        LambdaParam,
        ListPatRest,
        MapPatEntry,
        MigrationOp,
        NamedSpan,
        OrFallback,
        Param,
        PatSlot,
        PatternNode,
        PlaceAccess,
        Program,
        StmtNode,
        StrFormat,
        StrPart,
        StructPatField,
        SwitchArm,
        TupleField,
        Type,
        TypeParam,
        UnOp,
        access_sigil,
        ast_expr,
        ast_pattern,
        ast_stmt,
        pipe_value_is_name,
        type_name,
    ]
    jet_parser.[jfmt_bin_op_spell, jfmt_compound_spell]
}

// The top-level nodes of `program`: its imports, then its items. With
// `function`, only the functions of that name (top-level or methods).
jet_cli_emit_ast_program: fn(program: Program, function: String?) -> [JetCLIEmitNode] Never! {
    tables: program.tables
    nodes := [JetCLIEmitNode]{}
    if function == .Val(name) {
        loop item in program.items -> jet_cli_emit_ast_find_functions(tables, item, name, nodes)
        return nodes
    }
    loop import in program.imports {
        nodes.push(jet_cli_emit_leaf("import", jet_cli_emit_ast_import(import)))
    }
    loop item in program.items -> nodes.push(jet_cli_emit_ast_item(tables, item))
    if program.script_body.len() > 0 {
        nodes.push(jet_cli_emit_ast_body(tables, "script", "script", program.script_body))
    }
    nodes
}

jet_cli_emit_ast_find_functions: fn(tables: ASTTables, item: Item, name: String, found: &[JetCLIEmitNode]) Never! {
    if item == {
        .Func(value) -> {
            if value.name == name -> found.push(jet_cli_emit_ast_func(tables, value))
        }
        .Struct(value) -> { jet_cli_emit_ast_find_methods(tables, value.methods, name, found) }
        .Enum(value) -> { jet_cli_emit_ast_find_methods(tables, value.methods, name, found) }
        .Impl(value) -> { jet_cli_emit_ast_find_methods(tables, value.methods, name, found) }
        .CodeModule(value) -> {
            body: value.body ?? [Item]{}
            loop inner in body -> jet_cli_emit_ast_find_functions(tables, inner, name, found)
        }
        .GenericModule(value) -> {
            loop inner in value.body -> jet_cli_emit_ast_find_functions(tables, inner, name, found)
        }
        .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
}

jet_cli_emit_ast_find_methods: fn(tables: ASTTables, methods: [Func], name: String, found: &[JetCLIEmitNode]) Never! {
    loop method in methods {
        if method.name == name -> found.push(jet_cli_emit_ast_func(tables, method))
    }
}

// One `use` line in current syntax (#6542): a module or file alias prints as
// `alias: path`.
jet_cli_emit_ast_import: fn(import: ImportDecl) -> String Never! {
    target: if import.kind == {
        .File(path, _) -> jet_cli_debug_quote(path)
        .Module(name, _) -> name
        .Unqualified(module_alias, _, items, _, _) -> {
            names: loop item in items -> jet_cli_emit_ast_imported(item)
            "{module_alias}.[{names.join(", ")}]"
        }
    }
    if import.kind == .Unqualified(_, _, _, _, _) -> return "use {target}"
    if import.alias == "" || import.alias == target -> return "use {target}"
    "use {import.alias}: {target}"
}

jet_cli_emit_ast_imported: fn(item: ImportedItem) -> String Never! {
    alias: item.alias ?? return item.original
    "{item.original} as {alias}"
}

jet_cli_emit_ast_body: fn(tables: ASTTables, kind: String, text: String, body: [StmtNode]) -> JetCLIEmitNode Never! {
    children: loop statement in body -> jet_cli_emit_ast_stmt(tables, statement)
    jet_cli_emit_node(kind, text, children)
}

jet_cli_emit_ast_type_params: fn(params: [TypeParam]) -> String Never! {
    if params.len() == 0 -> return ""
    names: loop param in params -> jet_cli_emit_ast_type_param(param)
    "<{names.join(", ")}>"
}

jet_cli_emit_ast_type_param: fn(param: TypeParam) -> String Never! {
    if param.bounds.len() == 0 -> return param.name
    "{param.name}: {param.bounds.join(" + ")}"
}

jet_cli_emit_ast_type_args: fn(args: [Type]) -> String Never! {
    if args.len() == 0 -> return ""
    names: loop arg in args -> type_name(arg)
    "<{names.join(", ")}>"
}

jet_cli_emit_ast_params: fn(params: [Param]) -> String Never! {
    names: loop param in params -> "{access_sigil(param.convention)}{param.name}: {type_name(param.ty)}"
    names.join(", ")
}

jet_cli_emit_ast_return: fn(ty: Type?) -> String Never! {
    returned: ty ?? return ""
    " -> {type_name(returned)}"
}

jet_cli_emit_ast_func: fn(tables: ASTTables, value: Func) -> JetCLIEmitNode Never! {
    children := [JetCLIEmitNode]{}
    loop param in value.params {
        if param.default == .Val(default) {
            children.push(jet_cli_emit_node("default", "default {param.name}", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, default)}))
        }
    }
    loop statement in value.body -> children.push(jet_cli_emit_ast_stmt(tables, statement))
    jet_cli_emit_node("function", "{value.name}{jet_cli_emit_ast_type_params(value.type_params)}: fn({jet_cli_emit_ast_params(value.params)}){jet_cli_emit_ast_return(value.return_type)}", children)
}

jet_cli_emit_ast_methods: fn(tables: ASTTables, methods: [Func], children: &[JetCLIEmitNode]) Never! {
    loop method in methods -> children.push(jet_cli_emit_ast_func(tables, method))
}

jet_cli_emit_ast_items: fn(tables: ASTTables, kind: String, text: String, items: [Item]) -> JetCLIEmitNode Never! {
    children: loop item in items -> jet_cli_emit_ast_item(tables, item)
    jet_cli_emit_node(kind, text, children)
}

jet_cli_emit_ast_extern_fns: fn(kind: String, text: String, functions: [ExternFn]) -> JetCLIEmitNode Never! {
    children: loop function in functions -> jet_cli_emit_leaf("extern-function", "{function.name}: fn({jet_cli_emit_ast_params(function.params)}){jet_cli_emit_ast_return(function.return_type)}")
    jet_cli_emit_node(kind, text, children)
}

jet_cli_emit_ast_item: fn(tables: ASTTables, item: Item) -> JetCLIEmitNode Never! {
    if item == {
        .Func(value) -> jet_cli_emit_ast_func(tables, value)
        .Struct(value) -> {
            children := [JetCLIEmitNode]{}
            loop field in value.fields {
                inner := [JetCLIEmitNode]{}
                if field.computed == .Val(computed) {
                    inner.push(jet_cli_emit_node("computed", "computed", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, computed)}))
                }
                if field.default == .Val(default) {
                    inner.push(jet_cli_emit_node("default", "default", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, default)}))
                }
                children.push(jet_cli_emit_node("field", "field {field.name}: {type_name(field.ty)}", inner))
            }
            jet_cli_emit_ast_methods(tables, value.methods, children)
            jet_cli_emit_node("struct", "{value.name}{jet_cli_emit_ast_type_params(value.type_params)}: struct", children)
        }
        .Enum(value) -> {
            children := [JetCLIEmitNode]{}
            loop variant in value.variants {
                payload: if variant.payload == {
                    .Unit -> ""
                    .Single(ty, _) -> "({type_name(ty)})"
                    .Named(fields) -> {
                        names: loop field in fields -> "{field.name}: {type_name(field.ty)}"
                        "({names.join(", ")})"
                    }
                }
                children.push(jet_cli_emit_leaf("variant", "variant {variant.name}{payload}"))
            }
            jet_cli_emit_ast_methods(tables, value.methods, children)
            jet_cli_emit_node("enum", "{value.name}{jet_cli_emit_ast_type_params(value.type_params)}: enum", children)
        }
        .Distinct(value) -> jet_cli_emit_leaf("distinct", "distinct {value.name}: {type_name(value.base)}")
        .TypeAlias(value) -> jet_cli_emit_leaf("type-alias", "type {value.name}{jet_cli_emit_ast_type_params(value.type_params)} = {type_name(value.target)}")
        .UnitFamily(value) -> {
            children: loop member in value.members -> jet_cli_emit_leaf("unit", "unit {member.name}")
            jet_cli_emit_node("unit-family", "units {value.family}", children)
        }
        .Trait(value) -> {
            children := [JetCLIEmitNode]{}
            loop method in value.methods {
                text: "{method.name}: fn({jet_cli_emit_ast_params(method.params)}){jet_cli_emit_ast_return(method.return_type)}"
                if method.default_body == .Val(body) {
                    children.push(jet_cli_emit_ast_body(tables, "trait-method", text, body))
                } else { children.push(jet_cli_emit_leaf("trait-method", text)) }
            }
            supertraits: if value.supertraits.len() == 0 -> "" else -> ": {value.supertraits.join(" + ")}"
            jet_cli_emit_node("trait", "{value.name}: trait{supertraits}", children)
        }
        .Tag(value) -> {
            denials: loop entry in value.deny -> "!{entry.name}"
            jet_cli_emit_leaf("tag", "#FX({denials.join(", ")}) {value.name}: struct")
        }
        // An effect name a struct or enum declares in its `impl Effect` block.
        .EffectDecl(value) -> jet_cli_emit_leaf("effect", value.name)
        .Impl(value) -> {
            children := [JetCLIEmitNode]{}
            jet_cli_emit_ast_methods(tables, value.methods, children)
            head: if value.trait_name == .Val(trait_name) -> "impl {trait_name} for {value.type_name}" else -> "impl {value.type_name}"
            jet_cli_emit_node("impl", head, children)
        }
        .Const(value) -> {
            typed: if value.ty == .Val(ty) -> ": {type_name(ty)}" else -> ""
            jet_cli_emit_node("const", "const {value.name}{typed}", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, value.value)})
        }
        .Test(value) -> {
            name: value.name ?? ""
            jet_cli_emit_ast_body(tables, "test", "test {jet_cli_debug_quote(name)}", value.body)
        }
        .ExternRust(value) -> jet_cli_emit_ast_extern_fns("extern-rust", "extern rust {jet_cli_debug_quote(value.crate_spec)}", value.functions)
        .Module(value) -> {
            children: loop source in value.sources -> jet_cli_emit_leaf("source", "source {source.name}")
            jet_cli_emit_node("module", "{value.name}: module", children)
        }
        .CModule(value) -> jet_cli_emit_ast_extern_fns("c-module", "c module {jet_cli_debug_quote(value.lib)}", value.functions)
        .CodeModule(value) -> jet_cli_emit_ast_items(tables, "code-module", "{value.name}: module", value.body ?? [Item]{})
        .ErrorConv(value) -> jet_cli_emit_ast_body(tables, "error-conversion", "error conversion {value.from_ty} -> {value.to_ty}", value.body)
        .Migration(value) -> {
            children: loop op in value.ops -> jet_cli_emit_ast_migration_op(tables, op)
            jet_cli_emit_node("migration", "migration {value.type_name}", children)
        }
        .ProtocolDecl(value) -> {
            children: loop message in value.messages -> jet_cli_emit_leaf("message", "message {message.name}")
            jet_cli_emit_node("protocol", "protocol {value.name}", children)
        }
        .TemplateLoop(value) -> jet_cli_emit_node("template-loop", "#loop {value.var}", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, value.source)})
        .GenericModule(value) -> jet_cli_emit_ast_items(tables, "generic-module", "generic module {value.name}", value.body)
        .ModuleAlias(value) -> jet_cli_emit_leaf("module-alias", "{value.name}: module = {value.target}")
        .MarkerDecl(value) -> jet_cli_emit_leaf("marker", value.name)
        .FactDecl(value) -> jet_cli_emit_leaf("fact", value.name)
    }
}

jet_cli_emit_ast_migration_op: fn(tables: ASTTables, op: MigrationOp) -> JetCLIEmitNode Never! {
    if op == {
        .Rename(from, _, to, _) -> jet_cli_emit_leaf("rename", "rename {from} -> {to}")
        .Add(field, _, ty, _, default, _, _) -> jet_cli_emit_node("add", "add {field}: {type_name(ty)}", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, default)})
        .Remove(field, _) -> jet_cli_emit_leaf("remove", "remove {field}")
        .Change(field, _, from_ty, _, to_ty, _, _, _, _) -> jet_cli_emit_leaf("change", "change {field}: {type_name(from_ty)} -> {type_name(to_ty)}")
    }
}

jet_cli_emit_ast_label: fn(label: NamedSpan?) -> String Never! {
    named: label ?? return ""
    " {named.name}:"
}

jet_cli_emit_ast_binding: fn(tables: ASTTables, binding: Binding) -> JetCLIEmitNode Never! {
    mutable: if binding.mutable -> "mut " else -> ""
    typed: if binding.ty == .Val(ty) -> ": {type_name(ty)}" else -> ""
    children := [JetCLIEmitNode]{}
    if binding.pattern == .Val(pattern) {
        children.push(jet_cli_emit_ast_bind_pattern(tables, pattern))
    }
    children.push(jet_cli_emit_ast_expr(tables, binding.init))
    jet_cli_emit_node("binding", "bind {mutable}{binding.name}{typed}", children)
}

jet_cli_emit_ast_bind_names: fn(names: [BindName]) -> String Never! {
    texts: loop name in names -> jet_cli_emit_ast_bind_name(name)
    texts.join(", ")
}

jet_cli_emit_ast_bind_name: fn(name: BindName) -> String Never! {
    rename: name.rename ?? return name.name
    "{name.name}: {rename.name}"
}

jet_cli_emit_ast_bind_pattern: fn(tables: ASTTables, pattern: BindPattern) -> JetCLIEmitNode Never! {
    if pattern == {
        .Struct(owner, _, fields, _, _) -> jet_cli_emit_leaf("bind-pattern", "destructure {owner}({jet_cli_emit_ast_bind_names(fields)})")
        .List(elems, _) -> jet_cli_emit_leaf("bind-pattern", "destructure [{jet_cli_emit_ast_bind_names(elems)}]")
        .Tuple(elems, _) -> jet_cli_emit_leaf("bind-pattern", "destructure ({jet_cli_emit_ast_bind_names(elems)})")
        .Refutable(inner, fallback, _, _) -> jet_cli_emit_node("bind-pattern", "destructure", [JetCLIEmitNode]{jet_cli_emit_ast_pattern(tables, inner), jet_cli_emit_ast_fallback(tables, fallback)})
    }
}

jet_cli_emit_ast_lvalue: fn(tables: ASTTables, target: LValue) -> JetCLIEmitNode Never! {
    if target == {
        .Local(name, _) -> jet_cli_emit_leaf("Ident", "ident {name}")
        .Index(base, index, _, _) -> jet_cli_emit_node("Index", "index", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, base), jet_cli_emit_ast_expr(tables, index)})
        .Field(base, field, _) -> jet_cli_emit_node("Field", "field .{field}", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, base)})
    }
}

jet_cli_emit_ast_arms: fn(tables: ASTTables, arms: [SwitchArm], else_body: [StmtNode]?, children: &[JetCLIEmitNode]) Never! {
    loop arm in arms {
        arm_children := [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, arm.cond)}
        arm_children.push(jet_cli_emit_ast_body(tables, "body", "then", arm.body))
        children.push(jet_cli_emit_node("arm", "arm", arm_children))
    }
    if else_body == .Val(body) -> children.push(jet_cli_emit_ast_body(tables, "else", "else", body))
}

jet_cli_emit_ast_optional: fn(tables: ASTTables, kind: String, text: String, value: ExprNode?) -> JetCLIEmitNode Never! {
    inner: value ?? return jet_cli_emit_leaf(kind, text)
    jet_cli_emit_node(kind, text, [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, inner)})
}

jet_cli_emit_ast_stmt: fn(tables: ASTTables, statement: StmtNode) -> JetCLIEmitNode Never! {
    if ast_stmt(tables, statement) == {
        .Expr(value) -> jet_cli_emit_ast_expr(tables, value)
        .Val(binding) -> jet_cli_emit_ast_binding(tables, binding)
        .Assign(target, op, _, value) -> {
            operator: if op == .Val(binary) -> jfmt_compound_spell(binary) else -> "="
            jet_cli_emit_node("assign", "assign {operator}", [JetCLIEmitNode]{jet_cli_emit_ast_lvalue(tables, target), jet_cli_emit_ast_expr(tables, value)})
        }
        .Return(value, _) -> jet_cli_emit_ast_optional(tables, "return", "return", value)
        .While(cond, body, _, _, label) -> jet_cli_emit_node("while", "while{jet_cli_emit_ast_label(label)}", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, cond), jet_cli_emit_ast_body(tables, "body", "do", body)})
        .For(var, _, var2, kind, body, _, _, label, _) -> {
            names: if var2 == .Val(second) -> "{var}, {second.name}" else -> var
            children := [JetCLIEmitNode]{}
            if kind == {
                .Range(start, end, step, exclusive) -> {
                    range_children := [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, start), jet_cli_emit_ast_expr(tables, end)}
                    if step == .Val(value) {
                        range_children.push(jet_cli_emit_node("step", "step", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, value)}))
                    }
                    children.push(jet_cli_emit_node("range", if exclusive -> "range ..<" else -> "range ..", range_children))
                }
                .In(collection, step) -> {
                    children.push(jet_cli_emit_ast_expr(tables, collection))
                    if step == .Val(value) {
                        children.push(jet_cli_emit_node("step", "step", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, value)}))
                    }
                }
            }
            children.push(jet_cli_emit_ast_body(tables, "body", "do", body))
            jet_cli_emit_node("for", "for{jet_cli_emit_ast_label(label)} {names} in", children)
        }
        .Switch(subject, arms, else_body, _) -> {
            children := [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, subject)}
            jet_cli_emit_ast_arms(tables, arms, else_body, children)
            jet_cli_emit_node("switch", "switch", children)
        }
        .Break(_) -> jet_cli_emit_leaf("break", "break")
        .BreakValue(value, _) -> jet_cli_emit_node("break", "break", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, value)})
        .Continue(_) -> jet_cli_emit_leaf("continue", "next")
        .BreakLabel(name, _) -> jet_cli_emit_leaf("break", "break {name}")
        .BreakLabelValue(name, _, value, _) -> jet_cli_emit_node("break", "break {name}", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, value)})
        .ContinueLabel(name, _) -> jet_cli_emit_leaf("continue", "next {name}")
        .Loop(body, _, _, label) -> jet_cli_emit_ast_body(tables, "loop", "loop{jet_cli_emit_ast_label(label)}", body)
        .CountedLoop(init, cond, step, body, _, _, label) -> {
            children := [JetCLIEmitNode]{jet_cli_emit_ast_binding(tables, init), jet_cli_emit_ast_expr(tables, cond)}
            if step == .Val(value) {
                children.push(jet_cli_emit_node("step", "step", [JetCLIEmitNode]{jet_cli_emit_ast_stmt(tables, value)}))
            }
            children.push(jet_cli_emit_ast_body(tables, "body", "do", body))
            jet_cli_emit_node("loop", "loop{jet_cli_emit_ast_label(label)} counted", children)
        }
        .Unsafe(audit, _, body, _) -> jet_cli_emit_ast_body(tables, "unsafe", "unsafe {jet_cli_debug_quote(audit ?? "")}", body)
        .Impure(reason, _, body, _) -> jet_cli_emit_ast_body(tables, "impure", "impure {jet_cli_debug_quote(reason ?? "")}", body)
        .Reactive(body, _) -> jet_cli_emit_ast_body(tables, "reactive", "reactive", body)
        .Shield(body, _) -> jet_cli_emit_ast_body(tables, "shield", "shield", body)
        .Switched(marker, body, _) -> jet_cli_emit_ast_body(tables, "switched", "switched #{marker.name}", body)
        .Region(name, _, body, _) -> jet_cli_emit_ast_body(tables, "region", "region {name}", body)
        .Policy(declarations, body, _) -> jet_cli_emit_ast_body(tables, "policy", "policy ({declarations.len()} declarations)", body)
        .TaskGroup(name, _, args, body, _) -> {
            children := [JetCLIEmitNode]{}
            if args.limit == .Val(value) {
                children.push(jet_cli_emit_node("limit", "limit", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, value)}))
            }
            if args.stack == .Val(value) {
                children.push(jet_cli_emit_node("stack", "stack", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, value)}))
            }
            loop inner in body -> children.push(jet_cli_emit_ast_stmt(tables, inner))
            jet_cli_emit_node("task-group", "task group {name}", children)
        }
        .Layout(name, _, body, _) -> jet_cli_emit_ast_body(tables, "layout", "layout {name}", body)
        .AuthorityScope(caps, _, binding, body, _) -> {
            names: loop cap in caps -> cap.name
            bound: if binding == .Val(named) -> " as {named.name}" else -> ""
            jet_cli_emit_ast_body(tables, "authority", "authority [{names.join(", ")}]{bound}", body)
        }
        .ComptimeIf(cond, _, then_body, else_body, _, _) -> {
            children := [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, cond), jet_cli_emit_ast_body(tables, "body", "then", then_body)}
            if else_body == .Val(body) {
                children.push(jet_cli_emit_ast_body(tables, "else", "else", body))
            }
            jet_cli_emit_node("comptime-if", "#if", children)
        }
        .ComptimeSwitch(subject, arms, else_body, _) -> {
            children := [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, subject)}
            jet_cli_emit_ast_arms(tables, arms, else_body, children)
            jet_cli_emit_node("comptime-switch", "#if match", children)
        }
        .ComptimeBlock(body, _, _) -> jet_cli_emit_ast_body(tables, "comptime-block", "#run", body)
        .ContextBlock(fields, body, _) -> {
            children := [JetCLIEmitNode]{}
            loop field in fields {
                children.push(jet_cli_emit_node("context-field", "{field.name}:", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, field.value)}))
            }
            loop inner in body -> children.push(jet_cli_emit_ast_stmt(tables, inner))
            jet_cli_emit_node("context", "context", children)
        }
        .Live(body, _) -> jet_cli_emit_ast_body(tables, "live", "live", body)
        .AssumeDet(reason, _, body, _) -> jet_cli_emit_ast_body(tables, "assume-deterministic", "assume deterministic {jet_cli_debug_quote(reason)}", body)
        .Transact(name, _, body, _, _) -> jet_cli_emit_ast_body(tables, "transact", "transact{jet_cli_emit_ast_suffix(" ", name)}", body)
        .Yield(value, _) -> jet_cli_emit_node("yield", "yield", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, value)})
        .ScopeMember(name, _, args, _, body, _, _, _) -> {
            children: loop arg in args -> jet_cli_emit_ast_expr(tables, arg)
            node := jet_cli_emit_node("scope-member", ".{name}", children)
            loop inner in body -> node.children.push(jet_cli_emit_ast_stmt(tables, inner))
            node
        }
        .DeferClose(close, _) -> jet_cli_emit_node("defer-close", "defer close", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, close)})
        .Defer(body, _) -> jet_cli_emit_ast_body(tables, "defer", "defer", body)
    }
}

jet_cli_emit_ast_format: fn(format: StrFormat) -> String Never! {
    if format == {
        .Display -> ""
        .Debug -> ":Debug"
        .Pretty -> ":Pretty"
        .Fixed(digits) -> ":Fixed({digits})"
        .Grouped(digits) -> ":Grouped({digits})"
        .Hex(digits) -> ":Hex({digits})"
        .Pad(width, fill) -> ":Pad({width}, {jet_cli_debug_quote(fill)})"
        .PadLeft(width, fill) -> ":PadLeft({width}, {jet_cli_debug_quote(fill)})"
        .Sci(digits) -> ":Sci({digits})"
        .Percent(digits) -> ":Percent({digits})"
        .Bin -> ":Bin"
        .Oct -> ":Oct"
        .Unit(_) -> ":Unit"
        .Count -> ":Count"
    }
}

jet_cli_emit_ast_args: fn(tables: ASTTables, args: [CallArg], children: &[JetCLIEmitNode]) Never! {
    loop arg in args {
        value: jet_cli_emit_ast_expr(tables, arg.expr)
        label: if arg.label == .Val(written) -> "{written.name}: " else -> ""
        sigil: access_sigil(arg.convention)
        spread: if arg.spread -> ".." else -> ""
        if label == "" && sigil == "" && spread == "" -> children.push(value) else {
            children.push(jet_cli_emit_node("arg", "arg {label}{spread}{sigil}", [JetCLIEmitNode]{value}))
        }
    }
}

jet_cli_emit_ast_fields: fn(tables: ASTTables, fields: [ExprField], children: &[JetCLIEmitNode]) Never! {
    loop field in fields {
        children.push(jet_cli_emit_node("field", "{field.name}:", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, field.value)}))
    }
}

jet_cli_emit_ast_pairs: fn(tables: ASTTables, entries: [ExprPair], children: &[JetCLIEmitNode]) Never! {
    loop entry in entries {
        children.push(jet_cli_emit_node("entry", "entry", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, entry.key), jet_cli_emit_ast_expr(tables, entry.value)}))
    }
}

jet_cli_emit_ast_exprs: fn(tables: ASTTables, kind: String, text: String, values: [ExprNode]) -> JetCLIEmitNode Never! {
    children: loop value in values -> jet_cli_emit_ast_expr(tables, value)
    jet_cli_emit_node(kind, text, children)
}

jet_cli_emit_ast_unary: fn(tables: ASTTables, kind: String, text: String, value: ExprNode) -> JetCLIEmitNode Never! {
    jet_cli_emit_node(kind, text, [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, value)})
}

jet_cli_emit_ast_expr: fn(tables: ASTTables, expression: ExprNode) -> JetCLIEmitNode Never! {
    if ast_expr(tables, expression) == {
        .Str(parts, _, _) -> {
            children: loop part in parts -> jet_cli_emit_ast_str_part(tables, part)
            jet_cli_emit_node("Str", "string", children)
        }
        .StrMatchLit(parts, _, _) -> jet_cli_emit_leaf("StrMatchLit", "string pattern ({parts.len()} parts)")
        .BinMatchLit(parts, _, _) -> jet_cli_emit_leaf("BinMatchLit", "bytes pattern ({parts.len()} parts)")
        .Int(value, _, _, raw, _) -> jet_cli_emit_leaf("Int", "int {jet_cli_emit_ast_spelling(raw, "{value}")}")
        .Float(value, _, _, raw, _) -> jet_cli_emit_leaf("Float", "float {jet_cli_emit_ast_spelling(raw, "{value}")}")
        .Bool(value, _, _) -> jet_cli_emit_leaf("Bool", if value -> "bool true" else -> "bool false")
        .Unit(_, _) -> jet_cli_emit_leaf("Unit", "unit")
        .Char(value, _, _) -> jet_cli_emit_leaf("Char", "char {jet_cli_debug_quote(value)}")
        .ListLit(elements, _, _) -> jet_cli_emit_ast_exprs(tables, "ListLit", "list", elements)
        .MemberSpread(base, members, _, _) -> {
            names: loop member in members -> member.name
            jet_cli_emit_ast_unary(tables, "MemberSpread", "members .[{names.join(", ")}]", base)
        }
        .Spread(value, _, _) -> jet_cli_emit_ast_unary(tables, "Spread", "spread", value)
        .MapLit(entries, _, _) -> {
            children := [JetCLIEmitNode]{}
            jet_cli_emit_ast_pairs(tables, entries, children)
            jet_cli_emit_node("MapLit", "map", children)
        }
        .Index(base, index, _, _, _) -> jet_cli_emit_node("Index", "index", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, base), jet_cli_emit_ast_expr(tables, index)})
        .Slice(base, start, end, range, _, _) -> {
            children := [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, base), jet_cli_emit_ast_expr(tables, start), jet_cli_emit_ast_expr(tables, end)}
            if range == .Val(value) -> children.push(jet_cli_emit_ast_expr(tables, value))
            jet_cli_emit_node("Slice", "slice", children)
        }
        .Range(start, end, exclusive, _, _) -> jet_cli_emit_node("Range", if exclusive -> "range ..<" else -> "range ..", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, start), jet_cli_emit_ast_expr(tables, end)})
        .Ident(name, _, _) -> if pipe_value_is_name(name) -> jet_cli_emit_leaf("PipeValue", "pipe value <>") else -> jet_cli_emit_leaf("Ident", "ident {name}")
        .Call(call, _) -> {
            children := [JetCLIEmitNode]{}
            jet_cli_emit_ast_args(tables, call.args, children)
            jet_cli_emit_node("Call", "call {call.name}{jet_cli_emit_ast_type_args(call.type_args)}", children)
        }
        .Unary(op, operand, _, _) -> jet_cli_emit_ast_unary(tables, "Unary", jet_cli_emit_ast_unary_op(op), operand)
        .Binary(op, left, right, _, _) -> jet_cli_emit_node("Binary", "binary {jfmt_bin_op_spell(op)}", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, left), jet_cli_emit_ast_expr(tables, right)})
        .CompareChain(operands, ops, _, _, _) -> {
            spelled: loop op in ops -> jfmt_bin_op_spell(op)
            jet_cli_emit_ast_exprs(tables, "CompareChain", "compare {spelled.join(" ")}", operands)
        }
        .UnitLit(raw, _, _, suffix, _, _, _) -> jet_cli_emit_leaf("UnitLit", "unit literal {raw} {suffix}")
        .Deref(value, _, _) -> jet_cli_emit_ast_unary(tables, "Deref", "deref", value)
        .RawOf(value, _, _) -> jet_cli_emit_ast_unary(tables, "RawOf", "raw", value)
        .Copy(value, _, _) -> jet_cli_emit_ast_unary(tables, "Copy", "copy", value)
        .Place(value, access, _, _) -> jet_cli_emit_ast_unary(tables, "Place", jet_cli_emit_ast_place_access(access), value)
        .Field(base, member, _, _) -> jet_cli_emit_ast_unary(tables, "Field", "field .{member}", base)
        .OptField(base, member, _, _, _, _) -> jet_cli_emit_ast_unary(tables, "OptField", "field ?.{member}", base)
        .MethodCall(receiver, method, _, _, type_args, args, _) -> {
            children := [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, receiver)}
            jet_cli_emit_ast_args(tables, args, children)
            jet_cli_emit_node("MethodCall", "method .{method}{jet_cli_emit_ast_type_args(type_args)}", children)
        }
        .OptMethodCall(receiver, method, _, type_args, args, _, _) -> {
            children := [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, receiver)}
            jet_cli_emit_ast_args(tables, args, children)
            jet_cli_emit_node("OptMethodCall", "method ?.{method}{jet_cli_emit_ast_type_args(type_args)}", children)
        }
        .StructLit(owner, type_args, _, _, fields, _, _, _) -> {
            children := [JetCLIEmitNode]{}
            jet_cli_emit_ast_fields(tables, fields, children)
            jet_cli_emit_node("StructLit", "struct {owner}{jet_cli_emit_ast_type_args(type_args)}", children)
        }
        .TypedLit(head, body, _, _) -> {
            written: if head == .Val(ty) -> " {type_name(ty)}" else -> ""
            children := [JetCLIEmitNode]{}
            if body == {
                .Fields(fields) -> { jet_cli_emit_ast_fields(tables, fields, children) }
                .Elements(elements) -> {
                    loop element in elements {
                        children.push(jet_cli_emit_ast_expr(tables, element))
                    }
                }
                .Entries(entries) -> { jet_cli_emit_ast_pairs(tables, entries, children) }
                .Value(value) -> { children.push(jet_cli_emit_ast_expr(tables, value)) }
                .ByteText(parts) -> {
                    children.push(jet_cli_emit_leaf("bytes", "bytes ({parts.len()} parts)"))
                }
                .Empty -> {}
            }
            jet_cli_emit_node("TypedLit", "literal{written}", children)
        }
        .EnumLit(owner, variant, _, args, _, _, _) -> {
            children := [JetCLIEmitNode]{}
            loop arg in args {
                if arg == {
                    .Positional(value) -> { children.push(jet_cli_emit_ast_expr(tables, value)) }
                    .Named(label, value) -> {
                        children.push(jet_cli_emit_node("arg", "arg {label}:", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, value)}))
                    }
                }
            }
            jet_cli_emit_node("EnumLit", "variant {owner}.{variant}", children)
        }
        .Tainted(value, marked, _, _) -> jet_cli_emit_ast_unary(tables, "Tainted", "tainted{jet_cli_emit_ast_suffix(" #", marked)}", value)
        .Present(value, _, _) -> jet_cli_emit_ast_unary(tables, "Present", "present", value)
        .Absent(_, _) -> jet_cli_emit_leaf("Absent", "absent")
        .Todo(_, _, _) -> jet_cli_emit_leaf("Todo", "todo")
        .NoElse(_, _) -> jet_cli_emit_leaf("NoElse", "no else")
        .PatternTest(subject, pattern, _, _) -> jet_cli_emit_node("PatternTest", "matches", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, subject), jet_cli_emit_ast_pattern(tables, pattern)})
        .Ok(value, _, _) -> jet_cli_emit_ast_unary(tables, "Ok", "ok", value)
        .Err(value, _, _) -> jet_cli_emit_ast_unary(tables, "Err", "err", value)
        .Try(value, _, _, context, _) -> {
            children := [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, value)}
            if context == .Val(note) {
                children.push(jet_cli_emit_node("context", "context", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, note)}))
            }
            jet_cli_emit_node("Try", "try", children)
        }
        .OrFallback(value, fallback, _, _, _) -> jet_cli_emit_node("OrFallback", "or else", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, value), jet_cli_emit_ast_fallback(tables, fallback)})
        .If(cond, then_body, then_value, else_body, else_value, _, _) -> {
            then_node := jet_cli_emit_ast_body(tables, "then", "then", then_body)
            then_node.children.push(jet_cli_emit_ast_expr(tables, then_value))
            else_node := jet_cli_emit_ast_body(tables, "else", "else", else_body)
            else_node.children.push(jet_cli_emit_ast_expr(tables, else_value))
            jet_cli_emit_node("If", "if", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, cond), then_node, else_node})
        }
        .TupleLit(fields, _, _, _) -> {
            children: loop field in fields -> jet_cli_emit_ast_tuple_field(tables, field)
            jet_cli_emit_node("TupleLit", "tuple", children)
        }
        .Lambda(lambda, _) -> {
            params: loop param in lambda.params -> jet_cli_emit_ast_lambda_param(param)
            jet_cli_emit_node("Lambda", "lambda ({params.join(", ")})", jet_cli_emit_ast_lambda_body(tables, lambda.body))
        }
        .CallValue(callee, args, _, _) -> {
            children := [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, callee)}
            jet_cli_emit_ast_args(tables, args, children)
            jet_cli_emit_node("CallValue", "call value", children)
        }
        .PtrFromAddr(alias, _, elem, address, _, _) -> jet_cli_emit_ast_unary(tables, "PtrFromAddr", "pointer {alias}: {type_name(elem)}", address)
        .ComptimeName(name, _, _, _) -> jet_cli_emit_leaf("ComptimeName", "comptime name {name}")
        .TypeValue(ty, _, _) -> jet_cli_emit_leaf("TypeValue", "type {type_name(ty)}")
        .Paren(value, _, _) -> jet_cli_emit_ast_unary(tables, "Paren", "paren", value)
        .Pipe(head, steps, _, _) -> {
            children := [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, head)}
            loop step in steps {
                children.push(jet_cli_emit_node("step", "step", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, step.value)}))
            }
            jet_cli_emit_node("Pipe", "pipe", children)
        }
    }
}

jet_cli_emit_ast_str_part: fn(tables: ASTTables, part: StrPart) -> JetCLIEmitNode Never! {
    if part == {
        .Lit(text) -> jet_cli_emit_leaf("text", "text {jet_cli_debug_quote(text)}")
        .Interp(value, format) -> jet_cli_emit_node("interpolation", "interpolation{jet_cli_emit_ast_format(format)}", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, value)})
        .Byte(value) -> jet_cli_emit_leaf("byte", "byte {Int{value}}")
    }
}

// A literal as written when the parser kept its spelling.
jet_cli_emit_ast_spelling: fn(raw: String?, value: String) -> String Never! { raw ?? value }

// `{separator}{value}` for a written optional name, "" without one.
jet_cli_emit_ast_suffix: fn(separator: String, value: String?) -> String Never! {
    written: value ?? return ""
    "{separator}{written}"
}

jet_cli_emit_ast_unary_op: fn(op: UnOp) -> String Never! {
    if op == {
        .Neg -> "unary -"
        .Not -> "unary !"
    }
}

jet_cli_emit_ast_place_access: fn(access: PlaceAccess) -> String Never! {
    if access == {
        .Read -> "place read"
        .Write -> "place &"
        .Take -> "place ^"
    }
}

jet_cli_emit_ast_tuple_field: fn(tables: ASTTables, field: TupleField) -> JetCLIEmitNode Never! {
    if field.name == "" -> return jet_cli_emit_ast_expr(tables, field.value)
    jet_cli_emit_node("field", "{field.name}:", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, field.value)})
}

jet_cli_emit_ast_lambda_param: fn(param: LambdaParam) -> String Never! {
    ty: param.ty ?? return param.name
    "{param.name}: {type_name(ty)}"
}

jet_cli_emit_ast_lambda_body: fn(tables: ASTTables, body: LambdaBody) -> [JetCLIEmitNode] Never! {
    if body == .Expr(value) -> return [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, value)}
    statements: if body == .Block(written) -> written else -> [StmtNode]{}
    loop statement in statements -> jet_cli_emit_ast_stmt(tables, statement)
}

jet_cli_emit_ast_fallback: fn(tables: ASTTables, fallback: OrFallback) -> JetCLIEmitNode Never! {
    if fallback == {
        .Value(value) -> jet_cli_emit_ast_unary(tables, "fallback", "fallback", value)
        .Block(body, value, _) -> {
            node := jet_cli_emit_ast_body(tables, "fallback", "fallback block", body)
            if value == .Val(tail) -> node.children.push(jet_cli_emit_ast_expr(tables, tail))
            node
        }
        .Return(value, _) -> jet_cli_emit_ast_optional(tables, "fallback", "fallback return", value)
        .Panic(_, args) -> {
            children := [JetCLIEmitNode]{}
            jet_cli_emit_ast_args(tables, args, children)
            jet_cli_emit_node("fallback", "fallback panic", children)
        }
        .Break(_) -> jet_cli_emit_leaf("fallback", "fallback break")
        .Continue(_) -> jet_cli_emit_leaf("fallback", "fallback next")
        .BreakLabel(name, _) -> jet_cli_emit_leaf("fallback", "fallback break {name}")
        .ContinueLabel(name, _) -> jet_cli_emit_leaf("fallback", "fallback next {name}")
    }
}

jet_cli_emit_ast_binder: fn(tables: ASTTables, inner: PatternNode?) -> [JetCLIEmitNode] Never! {
    nested: inner ?? return [JetCLIEmitNode]{}
    [JetCLIEmitNode]{jet_cli_emit_ast_pattern(tables, nested)}
}

jet_cli_emit_ast_pattern: fn(tables: ASTTables, pattern: PatternNode) -> JetCLIEmitNode Never! {
    if ast_pattern(tables, pattern) == {
        .Variant(variant, bindings, _, _) -> {
            children: loop slot in bindings -> jet_cli_emit_ast_slot(tables, slot)
            jet_cli_emit_node("pattern", "pattern .{variant}", children)
        }
        .Present(binding, _, inner, _) -> jet_cli_emit_node("pattern", "pattern .Val({binding})", jet_cli_emit_ast_binder(tables, inner))
        .Absent(_) -> jet_cli_emit_leaf("pattern", "pattern None")
        .Ok(binding, _, inner, _) -> jet_cli_emit_node("pattern", "pattern .Ok({binding})", jet_cli_emit_ast_binder(tables, inner))
        .Err(binding, _, inner, _) -> jet_cli_emit_node("pattern", "pattern .Err({binding})", jet_cli_emit_ast_binder(tables, inner))
        .Range(lo, hi, _) -> jet_cli_emit_leaf("pattern", "pattern {lo}..{hi}")
        .Or(alternatives, _) -> {
            children: loop alternative in alternatives -> jet_cli_emit_ast_pattern(tables, alternative)
            jet_cli_emit_node("pattern", "pattern or", children)
        }
        .Struct(fields, rest, _, owner) -> {
            children: loop field in fields -> jet_cli_emit_ast_struct_pattern_field(tables, field)
            head: if owner == .Val(written) -> " {written.name}" else -> ""
            tail: if rest != None -> " .." else -> ""
            jet_cli_emit_node("pattern", "pattern struct{head}{tail}", children)
        }
        .List(items, rest, _) -> {
            children: loop slot in items -> jet_cli_emit_ast_slot(tables, slot)
            jet_cli_emit_node("pattern", "pattern list{jet_cli_emit_ast_list_rest(rest)}", children)
        }
        .Map(entries, rest, _) -> {
            children: loop entry in entries -> jet_cli_emit_ast_map_pattern_entry(tables, entry)
            tail: if rest != None -> " .." else -> ""
            jet_cli_emit_node("pattern", "pattern map{tail}", children)
        }
        .StrMatch(parts, _) -> jet_cli_emit_leaf("pattern", "pattern string ({parts.len()} parts)")
        .BinMatch(parts, _) -> jet_cli_emit_leaf("pattern", "pattern bytes ({parts.len()} parts)")
    }
}

jet_cli_emit_ast_struct_pattern_field: fn(tables: ASTTables, field: StructPatField) -> JetCLIEmitNode Never! {
    if field == {
        .Bind(name, _, local, _) -> jet_cli_emit_leaf("field", "{name}: bind {local}")
        .Value(name, _, value) -> jet_cli_emit_node("field", "{name}:", [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, value)})
        .Nested(name, _, inner) -> jet_cli_emit_node("field", "{name}:", [JetCLIEmitNode]{jet_cli_emit_ast_pattern(tables, inner)})
    }
}

jet_cli_emit_ast_list_rest: fn(rest: ListPatRest?) -> String Never! {
    written: rest ?? return ""
    bound: written.name ?? return " .."
    " ..{bound.name}"
}

jet_cli_emit_ast_map_pattern_entry: fn(tables: ASTTables, entry: MapPatEntry) -> JetCLIEmitNode Never! {
    text: if entry.optional -> "entry?" else -> "entry"
    jet_cli_emit_node("entry", text, [JetCLIEmitNode]{jet_cli_emit_ast_expr(tables, entry.key), jet_cli_emit_ast_slot(tables, entry.slot)})
}

jet_cli_emit_ast_slot: fn(tables: ASTTables, slot: PatSlot) -> JetCLIEmitNode Never! {
    if slot == {
        .Wildcard -> jet_cli_emit_leaf("slot", "_")
        .Bind(name, _) -> jet_cli_emit_leaf("slot", "bind {name}")
        .Range(lo, hi) -> jet_cli_emit_leaf("slot", "{lo}..{hi}")
        .Nested(pattern) -> jet_cli_emit_ast_pattern(tables, pattern)
        .Named(field, _, inner) -> jet_cli_emit_node("slot", "{field}:", [JetCLIEmitNode]{jet_cli_emit_ast_slot(tables, inner)})
        .Rest(_) -> jet_cli_emit_leaf("slot", "..")
        .Value(value) -> jet_cli_emit_ast_expr(tables, value)
    }
}
