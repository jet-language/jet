// run_inspect_live and LiveInspect.render. Every output comes from the
// validated retained snapshot, never source guesses.
use jet_foundation.[JetLiveChannel, JetLiveSnapshot, JetLiveTask]

jet_cli_live_text: fn(snapshot: JetLiveSnapshot) -> String Never! {
    ^event_lines: snapshot.events
    if event_lines == None {
        event_lines = Val(jet_cli_live_event_render(snapshot.event_records) ?? return "jet inspect live · invalid snapshot: {err.message}\n")
    }
    ^out: "jet inspect live · pid {snapshot.pid}\nprotocol={snapshot.protocol} session={snapshot.session_id} source={snapshot.source_id} build={snapshot.build_id} revision={snapshot.revision} world={snapshot.world_id}\n\nTask Tree\n"
    if snapshot.tasks.len() == 0 -> out = "{out}  (no live tasks)\n"
    loop live_task in snapshot.tasks {
        deadline: if live_task.deadline_ms == .Val(value) -> "{value}" else -> "-"
        wait: if live_task.wait == "" -> "-" else -> live_task.wait
        out = "{out}  Task {jet_cli_inspect_pad("{live_task.id}", 5)} parent {jet_cli_inspect_pad("{live_task.parent}", 5)} {jet_cli_inspect_pad(live_task.state, 8)} wait={wait} deadline={deadline} canceled={live_task.canceled} label={live_task.label} open_spans={live_task.open_spans} arena_allocations={live_task.arena_allocations}\n"
    }
    out = "{out}\nChannels\n"
    if snapshot.channels.len() == 0 -> out = "{out}  (no live channels)\n"
    loop channel in snapshot.channels {
        capacity: if channel.capacity == .Val(value) -> "{value}" else -> "∞"
        out = "{out}  Channel {jet_cli_inspect_pad("{channel.id}", 5)} depth {channel.depth}/{capacity} blocked send={channel.send_waiters} recv={channel.recv_waiters} closed={channel.closed}\n"
    }
    effects: snapshot.effects
    resources: snapshot.resources
    out = "{out}\nEffects: compute={effects.get("compute") ?? 0} waiting={effects.get("waiting") ?? 0} channel={effects.get("channel") ?? 0} time={effects.get("time") ?? 0} io={effects.get("io") ?? 0}\nResources: workers={resources.get("workers") ?? 0} running={resources.get("running") ?? 0} queued={resources.get("queued") ?? 0} canceled={resources.get("canceled") ?? 0} arenas={resources.get("arenas") ?? 0} arena_allocations={resources.get("arena_allocations") ?? 0} arena_bytes={resources.get("arena_bytes") ?? 0}\n\nValues\n"
    if snapshot.values.len() == 0 -> out = "{out}  (no live value decisions)\n"
    loop value in snapshot.values {
        reason: if value.reason == "" -> "" else -> " reason={value.reason}"
        rendered: if value.rendered_value == .Val(shown) -> " value={shown}" else -> ""
        out = "{out}  {value.value_id} type={value.type_identity} {value.disposition}{reason}{rendered}\n"
    }
    if event_lines == .Val(events) {
        out = "{out}\nEvents\n"
        if events == "" -> out = "{out}  (no runtime event observations)\n" else {
            loop line in events.split("\n") -> out = "{out}  {line}\n"
        }
    }
    out
}

jet_cli_live_identity_fields: fn(snapshot: JetLiveSnapshot) -> [JetCLIStatusField] Never! {
    [JetCLIStatusField]{
        jet_cli_status_field("scope", jet_cli_status_text("live")),
        jet_cli_status_field("pid", jet_cli_status_int(snapshot.pid)),
        jet_cli_status_field("protocol", jet_cli_status_text(snapshot.protocol)),
        jet_cli_status_field("session_id", jet_cli_status_text(snapshot.session_id)),
        jet_cli_status_field("source_id", jet_cli_status_text(snapshot.source_id)),
        jet_cli_status_field("build_id", jet_cli_status_text(snapshot.build_id)),
        jet_cli_status_field("revision", jet_cli_status_text(snapshot.revision)),
        jet_cli_status_field("world_id", jet_cli_status_text(snapshot.world_id)),
    }
}

jet_cli_live_json_report: fn(snapshot: JetLiveSnapshot, plane: String) -> String Never! {
    ^values: [JetCLIStatusValue]{}
    ^grouped: [String:[String]]{}
    ^names: [String]{}
    loop value in snapshot.values {
        values.push(
            jet_cli_status_object(
                [
                    jet_cli_status_field("value_id", jet_cli_status_text(value.value_id)),
                    jet_cli_status_field("type_identity", jet_cli_status_text(value.type_identity)),
                    jet_cli_status_field("disposition", jet_cli_status_text(value.disposition)),
                    jet_cli_status_field("reason", jet_cli_status_text(value.reason)),
                    jet_cli_status_field("rendered_value", if value.rendered_value == .Val(shown) -> jet_cli_status_text(shown) else -> JetCLIStatusValue.Null),
                ],
            ),
        )
        if !grouped.has_key(value.type_identity) -> names.push(value.type_identity)
        ^ids: grouped.get(value.type_identity) ?? [String]{}
        ids.push(value.value_id)
        grouped[value.type_identity] = ids
    }
    names.sort()
    ^shapes: [JetCLIStatusValue]{}
    loop name in names {
        ids: grouped.get(name) ?? [String]{}
        shapes.push(jet_cli_status_object([jet_cli_status_field("type_identity", jet_cli_status_text(name)), jet_cli_status_field("value_ids", jet_cli_status_array(ids.map(fn(id) { jet_cli_status_text(id) })))]))
    }
    ^fields: [JetCLIStatusField]{jet_cli_status_field("plane", jet_cli_status_text(plane))}
    fields.extend(jet_cli_live_identity_fields(snapshot))
    fields.push(jet_cli_status_field("tasks", jet_cli_status_array(snapshot.tasks.map(fn(live_task) { jet_cli_live_task_json(live_task) }))))
    fields.push(jet_cli_status_field("channels", jet_cli_status_array(snapshot.channels.map(fn(channel) { jet_cli_live_channel_json(channel) }))))
    fields.push(jet_cli_status_field("effects", jet_cli_live_counts_json(snapshot.effects, [String]{"compute", "waiting", "channel", "time", "io"})))
    fields.push(jet_cli_status_field("resources", jet_cli_live_counts_json(snapshot.resources, [String]{"workers", "running", "queued", "canceled", "arenas", "arena_allocations", "arena_bytes"})))
    fields.push(jet_cli_status_field("values", jet_cli_status_array(values)))
    fields.push(jet_cli_status_field("shapes", jet_cli_status_array(shapes)))
    "{jet_cli_status_render("inspect.{plane}", true, fields)}\n"
}

// One task of the tree: its place, its name and spawn site, and what it is
// doing; never its locals or the values it holds.
jet_cli_live_task_json: fn(live_task: JetLiveTask) -> JetCLIStatusValue Never! {
    jet_cli_status_object(
        [
            jet_cli_status_field("id", jet_cli_status_int(live_task.id)),
            jet_cli_status_field("parent", jet_cli_status_int(live_task.parent)),
            jet_cli_status_field("label", jet_cli_status_text(live_task.label)),
            jet_cli_status_field("spawn_site", jet_cli_status_int(live_task.spawn_site)),
            jet_cli_status_field("state", jet_cli_status_text(live_task.state)),
            jet_cli_status_field("wait", jet_cli_status_text(live_task.wait)),
            jet_cli_status_field("deadline_ms", if live_task.deadline_ms == .Val(deadline) -> jet_cli_status_int(deadline) else -> JetCLIStatusValue.Null),
            jet_cli_status_field("canceled", jet_cli_status_bool(live_task.canceled)),
            jet_cli_status_field("open_spans", jet_cli_status_int(live_task.open_spans)),
            jet_cli_status_field("arena_allocations", jet_cli_status_int(live_task.arena_allocations)),
        ],
    )
}

// One channel: how full it is and who waits on it; an unbounded channel's
// capacity is null.
jet_cli_live_channel_json: fn(channel: JetLiveChannel) -> JetCLIStatusValue Never! {
    jet_cli_status_object(
        [
            jet_cli_status_field("id", jet_cli_status_int(channel.id)),
            jet_cli_status_field("depth", jet_cli_status_int(channel.depth)),
            jet_cli_status_field("capacity", if channel.capacity == .Val(capacity) -> jet_cli_status_int(capacity) else -> JetCLIStatusValue.Null),
            jet_cli_status_field("send_waiters", jet_cli_status_int(channel.send_waiters)),
            jet_cli_status_field("recv_waiters", jet_cli_status_int(channel.recv_waiters)),
            jet_cli_status_field("closed", jet_cli_status_bool(channel.closed)),
        ],
    )
}

// The named counters, in the text view's order, each 0 when unrecorded.
jet_cli_live_counts_json: fn(counts: [String:Int], names: [String]) -> JetCLIStatusValue Never! {
    jet_cli_status_object(names.map(fn(name) { jet_cli_status_field(name, jet_cli_status_int(counts.get(name) ?? 0)) }))
}
