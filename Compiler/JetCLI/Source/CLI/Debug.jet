// `jet debug <file.jet|image> [-- args…]`: the program's native O0 image,
// built by this `jet`, run with the words after `--` as its arguments under
// Jet's own native debugger behind the `(Jet)` console of
// Compiler/JetDebug Native.jet. It stops at the start of the program's
// entry (the Jet function its image's `main` runs: NativeSession
// program_entry), or with `--break <file.jet>:<line>` (repeatable) at the
// first of those lines the
// program reaches, then reads one command a line; the end of stdin runs the
// program to its end, and `quit` ends it early (E2204). `--stdin=FILE` is
// the program's standard input, opened again at each start: a file, a
// named pipe or a shell's `<(producer)`. Without it, a stdin that is a
// terminal is the program's too, read by it while it runs; otherwise the
// program's stdin is empty. `--dap` serves the same session to an editor
// over the Debug Adapter Protocol instead (DebugDap.jet), whose launch
// request carries the arguments and the program's `stdin`. The image
// keeps the deep checks `--deep-checks` selects, as a `jet build` with the
// same flags does. A path that isn't a `.jet` file
// is an image already built: it is debugged as it is, against the source its
// line table names. An image the debugger can't read or run stops the
// session with E2203. A `.jetdump` path is a typed crash dump, read behind
// the same console without running anything (DebugDump.jet). `jet debug
// --attach PID` takes no file: it seizes the running program PID, an O0
// image of this user's, where it is, behind the same console, listing the
// source its line table names; the end of stdin or `quit` lets it go on
// (detach). A process it can't take is E2236 (no such process) or E2231
// (the system refused the trace, or the image has no Jet debug
// information).
//
// `--do COMMAND` (repeatable) runs console commands in order instead of
// reading them, with no prompt, then ends the session: the end of the
// commands ends the program, or lets an attached one go on. The image's
// own file answers `symbols`, `segments`, `sections`, `disassemble` and
// `help` before anything starts (NativeImageList.jet), even for an image
// that keeps no Jet debug information; the first command that needs the
// program running starts it as the console does, its first stop shown,
// and the rest run
// there. A crash dump runs them against the dump, with no banner. It exits
// 1 when the console refused a command, or the program ended with a
// failing status or a signal; `--dap` takes no `--do`.
//
// `--replay=NAME` runs the program under the recording `jet run
// --record=NAME` made (`.jet/replays/NAME.jetproof-replay`, or a
// project-relative `.jetproof-replay` path): its runtime answers every
// recorded input with the recorded value and holds each task at a sync event
// until the recorded order gives it its turn (JetRuntime RecordReplay.jet),
// so the run synchronizes and prints as the recorded one did. An image
// `jet build -O1` or `-O2` made replays as the O0 build does. The first sync
// event where the run does otherwise stops it with `replay diverged at sync
// event N`, the recorded event and the one the run got. A source file that
// is not the one recorded is refused (E3621); under `--dap` the adapter
// answers each request with the refusal.
//
// `--record=NAME` debugs a source file while its runtime records the run as
// `jet run --record=NAME` does: the same `.jet/replays/NAME.jetproof-replay`,
// published once the program has ended, which `--replay=NAME` then replays
// (jet_cli_debug_record_begin).
//
// `--build` debugs the build `jet build` runs with the same words instead
// of a program: breakpoints in prep blocks, prep fn recipes, marker bodies
// and `build: fn` package builds, behind the same console or `--dap`
// (DebugBuild.jet).
use {
    cli_files: core.files
    cli_process: core.process
    cli_sys: core.sys
    cli_term: core.term
    jet_debug.[NATIVE_ATTACH_FAILED, NATIVE_DEBUG_PROMPT, NativeAttachRefused, NativeBreak, NativeDebugError, NativeDebugStep, NativeSession, NativeStopKind, native_attach_program, native_debug_build_argv, native_debug_image, native_image_command, native_image_session]
    jet_driver.[JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USAGE, JET_DRIVER_EXIT_USER_ERROR]
    jet_foundation.[BuildSettingOverride, DeepChecks, ENV_JET_RECORD, ENV_JET_REPLAY, deep_checks_malformed, deep_checks_read, diagnostic_registry_row, foundation_byte_text]
    jet_pkg_model.[WorkspaceDeclarationCache]
}

// The end of the console's answer to a command it doesn't know when its
// stdin is not a terminal: the program reads none of the console's input,
// whose lines are commands, so a line meant for the program reads as one.
JET_CLI_DEBUG_STDIN_NOTE: "The program doesn't read the console's input: `--stdin=FILE` gives it FILE as its standard input.\n"

jet_cli_debug: fn(jet_argv: [String], args: [String], passthrough: [String]?, color: Bool) -[FS, Env, Exec, IO, Net, Time, Rand, FFI.C, FFI.Asm]> JetCLIPlan Never! {
    dap := false
    build := false
    breaks := [NativeBreak]{}
    attach := -1
    replay_at := -1
    stdin_at := -1
    dos := [String]{}
    loop (index, flag) in jet_argv {
        if flag == "--do" || flag.starts_with("--do=") {
            command: if flag == "--do" && index + 1 < jet_argv.len() -> jet_argv[index + 1] else -> flag.after("--do=")
            if command.trim() == "" {
                return jet_cli_fail("E2104", "`--do` needs a COMMAND", jet_cli_why("E2104"), "write `--do COMMAND` with a console command, as `--do symbols` or `--do 'disas main'`", color, JET_DRIVER_EXIT_USAGE)
            }
            dos.push("{command.trim()}")
            next
        }
        if flag == "--attach" || flag.starts_with("--attach=") {
            value: if flag == "--attach" && index + 1 < jet_argv.len() -> jet_argv[index + 1] else -> flag.after("--attach=")
            attach = Int.parse(value) ?? return jet_cli_fail("E2104", "`--attach {value}` isn't a process id", jet_cli_why("E2104"), "name the running program's process id, as `jet debug --attach 4242`", color, JET_DRIVER_EXIT_USAGE)
            next
        }
        if flag == "--raw-frames" -> return jet_cli_not_ported("debug --raw-frames", color)
        if flag == "--replay" || flag.starts_with("--replay=") -> replay_at = index
        if flag == "--stdin" || flag.starts_with("--stdin=") -> stdin_at = index
        if flag == "--dap" -> dap = true
        if flag == "--build" -> build = true
        if flag != "--break" && !flag.starts_with("--break=") -> next
        spec: if flag == "--break" && index + 1 < jet_argv.len() -> jet_argv[index + 1] else -> flag.after("--break=")
        wanted: jet_cli_debug_break(spec) ?? return jet_cli_fail("E2104", "`--break {spec}` isn't a breakpoint jet understands", jet_cli_why("E2104"), "write the file and the line, as `--break main.jet:12`", color, JET_DRIVER_EXIT_USAGE)
        breaks.push(wanted)
    }
    replay: if {
        replay_at < 0 -> ""
        jet_argv[replay_at] == "--replay" && replay_at + 1 < jet_argv.len() -> jet_argv[replay_at + 1]
        else -> jet_argv[replay_at].after("--replay=")
    }
    if replay_at >= 0 && replay == "" {
        return jet_cli_fail("E2104", "`--replay` needs a NAME", jet_cli_why("E2104"), "write `--replay=NAME`, the NAME of a `jet run --record=NAME` recording", color, JET_DRIVER_EXIT_USAGE)
    }
    input: if {
        stdin_at < 0 -> ""
        jet_argv[stdin_at] == "--stdin" && stdin_at + 1 < jet_argv.len() -> jet_argv[stdin_at + 1]
        else -> jet_argv[stdin_at].after("--stdin=")
    }
    if stdin_at >= 0 && input == "" {
        return jet_cli_fail("E2104", "`--stdin` needs a FILE", jet_cli_why("E2104"), "write `--stdin=FILE`, the file the program reads as its standard input", color, JET_DRIVER_EXIT_USAGE)
    }
    if input != "" && dap {
        return jet_cli_fail("E2104", "`--stdin` gives the console's program its input, but `--dap` takes it from the editor", jet_cli_why("E2104"), "drop `--stdin`, and set `stdin` in the editor's launch configuration", color, JET_DRIVER_EXIT_USAGE)
    }
    if dos.len() > 0 && dap {
        return jet_cli_fail("E2104", "`--do` runs the console's commands, but `--dap` serves the session to an editor, which sends its own", jet_cli_why("E2104"), "drop `--dap` to run the commands, or `--do` to serve the editor", color, JET_DRIVER_EXIT_USAGE)
    }
    if input != "" && replay != "" {
        return jet_cli_fail("E2104", "`--replay` answers the program's input from its recording, so it takes no `--stdin`", jet_cli_why("E2104"), "drop `--stdin`: the replay reads what the recorded run read", color, JET_DRIVER_EXIT_USAGE)
    }
    record: jet_cli_record_flag(jet_argv) ?? return jet_cli_fail("E2104", "`--record` needs a NAME", jet_cli_why("E2104"), "write `--record=NAME` with letters, digits, `-`, or `_`", color, JET_DRIVER_EXIT_USAGE)
    if record != "" && replay != "" {
        return jet_cli_fail("E2104", "`--record` makes a new recording, but `--replay` reruns one already made", jet_cli_why("E2104"), "record first with `jet debug --record={record} <file.jet>`, then replay it with `jet debug --replay={record} <file.jet>`", color, JET_DRIVER_EXIT_USAGE)
    }
    if dap && breaks.len() > 0 {
        return jet_cli_fail("E2104", "`--break` sets the console's breakpoints, but `--dap` takes them from the editor", jet_cli_why("E2104"), "drop `--break`, and set the breakpoints in the editor", color, JET_DRIVER_EXIT_USAGE)
    }
    program_args: passthrough ?? [String]{}
    if dap && program_args.len() > 0 {
        return jet_cli_fail("E2104", "the words after `--` are the console's program arguments, but `--dap` takes them from the editor", jet_cli_why("E2104"), "drop the words after `--`, and set `args` in the editor's launch configuration", color, JET_DRIVER_EXIT_USAGE)
    }
    if build {
        if attach >= 0 || replay != "" || record != "" || input != "" {
            return jet_cli_fail("E2104", "`--build` debugs the build `jet build` runs, so it takes no `--attach`, `--replay`, `--record` or `--stdin`", jet_cli_why("E2104"), "drop those flags to debug the build, or drop `--build` to debug the program", color, JET_DRIVER_EXIT_USAGE)
        }
        return jet_cli_debug_the_build(jet_argv, passthrough, breaks, dos, dap)
    }
    if attach >= 0 {
        if dap || breaks.len() > 0 || program_args.len() > 0 {
            return jet_cli_fail("E2104", "`--attach` debugs a program already running, so it takes no `--dap`, `--break` or program arguments", jet_cli_why("E2104"), "run `jet debug --attach PID` alone, and set breakpoints at the `(Jet)` prompt; an editor attaches with the adapter's `attach` request", color, JET_DRIVER_EXIT_USAGE)
        }
        if replay != "" {
            return jet_cli_fail("E2104", "`--attach` debugs a program already running, so it has no recording to replay", jet_cli_why("E2104"), "drop `--replay`, or replay the program: `jet debug --replay={replay} <file.jet|image>`", color, JET_DRIVER_EXIT_USAGE)
        }
        if record != "" {
            return jet_cli_fail("E2104", "`--attach` takes a program already running, so its run can't be recorded from its start", jet_cli_why("E2104"), "drop `--record`, or record a new run: `jet debug --record={record} <file.jet>`", color, JET_DRIVER_EXIT_USAGE)
        }
        if input != "" {
            return jet_cli_fail("E2104", "`--attach` takes a program already running, which reads its own standard input", jet_cli_why("E2104"), "drop `--stdin`, or debug a new run of the program: `jet debug <file.jet> --stdin={input}`", color, JET_DRIVER_EXIT_USAGE)
        }
        if args.len() > 1 {
            return jet_cli_fail("E2104", "`jet debug --attach` takes the process id alone, but got `{args[1]}` too", jet_cli_why("E2104"), "Run `jet debug --attach PID`; the image's own line table names its source.", color, JET_DRIVER_EXIT_USAGE)
        }
    }
    if attach < 0 && args.len() < 2 -> return jet_cli_missing_target("debug", false)
    if args.len() > 2 {
        return jet_cli_fail("E2104", "`jet debug` takes one source file or built image, but got `{args[2]}` too", jet_cli_why("E2104"), "Run `jet debug <file.jet>`, or `jet debug <image>` for a built one.", color, JET_DRIVER_EXIT_USAGE)
    }
    deep_checks := DeepChecks{}
    if deep_checks_read(jet_argv) == {
        .Refused(argument) -> return JetCLIPlan.Refused{report: deep_checks_malformed(argument), color: color, exit_code: JET_DRIVER_EXIT_USAGE, notice: ""}
        .Read(request) -> deep_checks = request.copy()
    }
    if attach < 0 && args[1].ends_with(".jetdump") {
        if replay != "" {
            return jet_cli_fail("E2104", "a crash dump runs nothing to replay", jet_cli_why("E2104"), "drop `--replay`, or replay the program: `jet debug --replay={replay} <file.jet|image>`", color, JET_DRIVER_EXIT_USAGE)
        }
        if record != "" {
            return jet_cli_fail("E2104", "a crash dump runs nothing to record", jet_cli_why("E2104"), "drop `--record`, or record the program: `jet debug --record={record} <file.jet>`", color, JET_DRIVER_EXIT_USAGE)
        }
        if input != "" {
            return jet_cli_fail("E2104", "a crash dump runs nothing to read `--stdin`", jet_cli_why("E2104"), "drop `--stdin`, or debug the program: `jet debug <file.jet> --stdin={input}`", color, JET_DRIVER_EXIT_USAGE)
        }
        return jet_cli_debug_dump(args[1], dos, color)
    }
    if input != "" && !cli_files.can_read(input) {
        return jet_cli_fail("E2105", "couldn't open `{input}`, the program's standard input", jet_cli_why("E2105"), "check that the file exists and is readable, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
    }
    if input != "" && !cli_term.stdin().is_tty() && (cli_files.samefile(input, "/dev/stdin") ?? false) {
        return jet_cli_fail("E2104", "`--stdin={input}` names the console's own stdin, which carries its commands", jet_cli_why("E2104"), "give the program another file, or the console its commands through another pipe", color, JET_DRIVER_EXIT_USAGE)
    }
    scratch: cli_files.temp_dir("jet-debug") ?? return jet_cli_fail("E2105", "couldn't create the debug build directory: {err}", jet_cli_why("E2105"), "check that the temporary directory is writable, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
    plan: if attach >= 0 -> jet_cli_debug_attach(attach, scratch.path, deep_checks, dos, color) else -> jet_cli_debug_target(args[1], scratch.path, deep_checks, breaks, program_args, input, dap, replay, record, dos, color)
    if cli_files.remove_all(scratch.path) == {
        .Err(_) -> {}
        .Ok(_) -> {}
    }
    plan
}

// Debug `entry`, a source file built into `scratch` or an image, reading
// the file `input` as its standard input when it isn't "", under the
// recording `replay` names when it isn't "", or making the one `record`
// names when it isn't, running the console commands `dos` (`--do`) when
// there are any. A replay runs with the program arguments its recording
// was made with, since it reproduces that run; other arguments after `--`
// are refused.
jet_cli_debug_target: fn(entry: String, scratch: String, deep_checks: DeepChecks, breaks: [NativeBreak], program_args: [String], input: String, dap: Bool, replay: String, record: String, dos: [String], color: Bool) -[FS, Env, Exec, IO, Net, Time, Rand, FFI.Asm]> JetCLIPlan Never! {
    if record != "" {
        made: jet_cli_debug_record_begin(record, entry, scratch) ?? return jet_cli_debug_unbegun(err, dap: dap, color: color)
        env: jet_cli_launch_env([JetCLIEnvVar]{JetCLIEnvVar{name: ENV_JET_RECORD, value: made.log}, JetCLIEnvVar{name: ENV_JET_REPLAY, value: ""}}) ?? [String]{}
        return jet_cli_debug_launch(entry, scratch, deep_checks, breaks, program_args, input, dap, Val(env), Val(made), dos, color)
    }
    if replay == "" {
        return jet_cli_debug_launch(entry, scratch, deep_checks, breaks, program_args, input, dap, None, None, dos, color)
    }
    recorded := [String]{}
    env: jet_cli_debug_replay_env(replay, entry, scratch, recorded) ?? return jet_cli_debug_unbegun(err, dap: dap, color: color)
    if program_args.len() > 0 && !jet_cli_debug_same_args(program_args, recorded) {
        shown: if recorded.len() == 0 -> "no arguments" else -> "`{recorded.join(" ")}`"
        return jet_cli_debug_unbegun(JetCLIProveRefusal{code: "E2104", what: "`--replay={replay}` reruns a run that had other program arguments", why: "the recording ran with {shown}, and a replay reproduces that run, so it takes its arguments from the recording", fix: "drop the words after `--`", exit_code: JET_DRIVER_EXIT_USAGE}, dap: dap, color: color)
    }
    jet_cli_debug_launch(entry, scratch, deep_checks, breaks, recorded, input, dap, Val(env), None, dos, color)
}

// A `jet debug --record` recording: bound before the program builds
// (jet_cli_replay_record_begin), and the scratch file JET_RECORD names, where
// the program's runtime writes its sync-order log at its exit (JetRuntime
// RecordReplay.jet).
JetCLIDebugRecord: struct {
    record: JetCLIReplayRecord,
    log: String,
}

// `--record=NAME`: the recording of a debug session of the source file
// `entry`, made as `jet run --record=NAME` makes one (Host.jet
// jet_cli_run_recorded). It binds `entry` before the build, so a bad or
// taken NAME refuses with nothing run; the program then starts with
// JET_RECORD naming `log`, a file in `scratch` (and no JET_REPLAY), and the
// session publishes the recording once the program has ended
// (jet_cli_debug_recorded). A built image has no source for the recording
// to bind, so it is refused.
jet_cli_debug_record_begin: fn(name: String, entry: String, scratch: String) -> JetCLIDebugRecord JetCLIProveRefusal! {
    if !entry.ends_with(".jet") {
        return Err(JetCLIProveRefusal{code: "E2104", what: "`jet debug --record` records a run of a `.jet` source file, but `{entry}` is a built image", why: "a recording binds the source its run was built from, and an image names none", fix: "record the source with `jet debug --record={name} <file.jet>`, then replay this image with `jet debug --replay={name} {entry}`", exit_code: JET_DRIVER_EXIT_USAGE})
    }
    begun: jet_cli_replay_record_begin(entry, [String]{entry}, name, "", [BuildSettingOverride]{}) ?? return Err(err)
    Ok(JetCLIDebugRecord{record: begun, log: cli_files.join(scratch, "sync.log")})
}

// Whether `given` are the `recorded` program arguments, word for word.
jet_cli_debug_same_args: fn(given: [String], recorded: [String]) -> Bool Never! {
    if given.len() != recorded.len() -> return false
    loop (index, word) in given {
        if word != recorded[index] -> return false
    }
    true
}

jet_cli_debug_replay_refused: fn(refusal: JetCLIProveRefusal, color: Bool) -> JetCLIPlan Never! {
    out: jet_cli_prove_refused(refusal, color, false)
    jet_cli_done(out.stdout, out.stderr, out.exit_code)
}

// A recording or replay refused before the session began, on stderr. Under
// `--dap` the editor is answered with it too: each request the adapter gets
// is refused with it (jet_cli_dap_refused).
jet_cli_debug_unbegun: fn(refusal: JetCLIProveRefusal, dap: Bool{false}, color: Bool{false}) -[IO, Time.Wait]> JetCLIPlan Never! {
    if dap -> jet_cli_dap_refused(jet_cli_prove_refusal_report(refusal))
    jet_cli_debug_replay_refused(refusal, color)
}

// Debug `entry` with `program_args` and the standard input `input` ("":
// the console's terminal, or none), in the environment `env` when it is
// set, making the recording `record` when it is set, running the console
// commands `dos` when there are any.
jet_cli_debug_launch: fn(entry: String, scratch: String, deep_checks: DeepChecks, breaks: [NativeBreak], program_args: [String], input: String, dap: Bool, env: [String]?, record: JetCLIDebugRecord?, dos: [String], color: Bool) -[FS, Env, Exec, IO, Net, Time, Rand, FFI.Asm]> JetCLIPlan Never! {
    if entry.ends_with(".jet") {
        return jet_cli_debug_build(entry, scratch, deep_checks, breaks, program_args, input, dap, env, record, dos, color)
    }
    jet_cli_debug_session(entry, "", [String]{}, scratch, breaks, program_args, input, deep_checks, dap, env, record, dos, color, jet_cli_debug_eval_held_slot())
}

// The environment of a `--replay=NAME` run of `entry`: jet's own, with
// JET_REPLAY naming the recording's sync-order log, written into `scratch`,
// and no JET_RECORD. The program arguments the run was recorded with go to
// `args`. NAME is a recording of the project a source `entry` is
// in, or of the working directory's for an image, or a project-relative
// `.jetproof-replay` path there. A source `entry` must be the source the
// recording was made from: a recording binds its source's digest
// (jet_cli_replay_source_identity), and one of other source is E3621. An
// image binds no source, so it is replayed unchecked.
jet_cli_debug_replay_env: fn(name: String, entry: String, scratch: String, args: ^[String]) -[FS, Env, Time.Wait]> [String] JetCLIProveRefusal! {
    path_given: name.ends_with(".jetproof-replay")
    problem: if path_given -> jet_cli_replay_input_problem(name) else -> jet_cli_replay_name_problem(name)
    if problem == .Val(why) {
        return Err(JetCLIProveRefusal{code: "E2104", what: "`--replay={name}` names no recording", why: why, fix: "write `--replay=NAME`, the NAME of a `jet run --record=NAME` recording", exit_code: JET_DRIVER_EXIT_USAGE})
    }
    relative: if path_given -> name else -> jet_cli_replay_record_path(name)
    cache := WorkspaceDeclarationCache.new()
    start: if entry.ends_with(".jet") -> jet_cli_parent(cli_files.realpath(entry) ?? entry) ?? "." else -> "."
    root: jet_cli_receipt_project_root(cache, start)
    if !cli_files.lexists(jet_cli_entry_join(root, relative)) {
        return Err(jet_cli_replay_refusal("E3622", "no recording `{relative}`", "`jet debug --replay={name}` reads it in the project at `{root}`, where it isn't", "record the run first with `jet run --record={name} <file.jet>`"))
    }
    artifact: jet_cli_replay_verify_file(root, relative, relative) ?? return Err(jet_cli_replay_fault_refusal(err))
    if artifact.sync.len() == 0 {
        return Err(JetCLIProveRefusal{code: "E2104", what: "`{relative}` holds no run to replay", why: "it is a recording `jet test --record` made, which has no sync-order log", fix: "replay a recording `jet run --record=NAME` made", exit_code: JET_DRIVER_EXIT_USAGE})
    }
    if entry.ends_with(".jet") {
        now: jet_cli_replay_source_identity(entry, [String]{entry}) ?? return Err(err)
        if jet_cli_replay_field_value(artifact.identity, "source_digest") != now.identity.source_digest {
            return Err(jet_cli_replay_refusal("E3621", "replay semantic identity does not match", "`{entry}` is not the source `{relative}` recorded: the recorded `source_digest` differs from this source's", "replay the source as it was recorded, or record this one with `jet run --record={name} {entry}`"))
        }
    }
    loop arg in artifact.args -> args.push("{arg}")
    log: cli_files.join(scratch, "replay.log")
    cli_files.write_bytes(log, artifact.sync) ?? return Err(JetCLIProveRefusal{code: "E2105", what: "couldn't write the replay's sync-order log", why: "{err}", fix: "check that the temporary directory is writable, then run the command again", exit_code: JET_DRIVER_EXIT_USER_ERROR})
    Ok(jet_cli_launch_env([JetCLIEnvVar]{JetCLIEnvVar{name: ENV_JET_RECORD, value: ""}, JetCLIEnvVar{name: ENV_JET_REPLAY, value: log}}) ?? [String]{})
}

// The refusal of `image`, whose runtime links no observation start, where a
// recording and its replay begin, under `--replay` (`act`: "replay its
// recording") or `--record` ("be recorded").
jet_cli_debug_unstarted: fn(image: String, act: String) -> JetCLIProveRefusal Never! {
    JetCLIProveRefusal{code: "E2104", what: "`{image}` can't {act}", why: "the program starts no task and makes no channel, live value or event, so its runtime has no observation start, where a recording and its replay begin", fix: "record and replay a program that synchronizes; a program with none runs the same with `jet run`", exit_code: JET_DRIVER_EXIT_USAGE}
}

// A `--break` value, `<file.jet>:<line>`: the file by its base name, or by a
// path that picks one of the image's same-named files, as
// `Sema/CheckProgram.jet:1517` does (NativeSession.break_at).
jet_cli_debug_break: fn(spec: String) -> NativeBreak? Never! {
    colon: spec.rfind(":")
    if colon <= 0 -> return None
    // `rfind` counts bytes, so the file and line are cut from the bytes.
    bytes: spec.bytes()
    line: Int.parse(foundation_byte_text(bytes, colon + 1, bytes.len())) ?? return None
    if line < 1 -> return None
    Val(NativeBreak{file: foundation_byte_text(bytes, 0, colon), line: line})
}

// Build `entry` at O0 into `scratch`, then debug the image with the program
// arguments `program_args`, the standard input `input` and the environment
// `env` (None: jet's own), making the recording `record` when it is set,
// running the console commands `dos` when there are any. Under `--dap`
// the build's report goes to stderr: stdout is the protocol's. The
// session's held check of the program starts opening first, with the
// flags of the image's level, O0, so it opens while the image builds,
// whose debug info records the sources it was built from.
jet_cli_debug_build: fn(entry: String, scratch: String, deep_checks: DeepChecks, breaks: [NativeBreak], program_args: [String], input: String, dap: Bool, env: [String]?, record: JetCLIDebugRecord?, dos: [String], color: Bool) -[FS, Env, Exec, IO, Net, Time, Rand, FFI.Asm]> JetCLIPlan Never! {
    source: cli_files.read(entry) ?? return jet_cli_fail("E2105", "couldn't read `{entry}`: {err}", jet_cli_why("E2105"), "check the path, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
    held: jet_cli_debug_eval_held_slot()
    jet_cli_debug_eval_held_start(held, entry, jet_cli_debug_eval_argv(deep_checks, 0), color: color, program: true)
    out_dir: cli_files.join(scratch, "out")
    built: cli_process.cmd(native_debug_build_argv(cli_sys.executable(), entry, out_dir, deep_checks)).stdout(.Capture).stderr(.Capture).run() ?? return jet_cli_fail("E2105", "couldn't run the debug build: {err}", jet_cli_why("E2105"), "check that this `jet` can run, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
    code: if built.code == 0 -> JET_DRIVER_EXIT_USER_ERROR else -> built.code
    if !built.success && dap -> return jet_cli_done("", "{built.output}{built.errors}", code)
    if !built.success -> return jet_cli_done(built.output, built.errors, code)
    jet_cli_debug_session(native_debug_image(entry, out_dir), entry, source.split("\n").to_list(), scratch, breaks, program_args, input, deep_checks, dap, env, record, dos, color, held)
}

// Debug the built `image`, whose `run` is in the source file `entry` with
// the text `lines`, run with `program_args`, the file `input` as its
// standard input ("": the console's terminal, or none) and the environment
// `env` (None: jet's own), with the session's held checks `held`, which
// start opening here unless they already are; the program's only when the
// image records the sources it was built from
// (jet_cli_debug_eval_held_start). An `entry` of "" is the source the
// image's line table names, read if it is there. A replay (`env` names
// JET_REPLAY) and a recording (`record`) need an image that links the
// runtime's observation start, where both begin; a recording is published
// when the session ends. With console commands `dos` (`--do`), the
// leading ones the image's file answers (jet_cli_debug_file_answers) run
// before anything starts, even for an image the debugger can't run; the
// rest run behind the console once the program has started.
jet_cli_debug_session: fn(image: String, entry: String, lines: [String], scratch: String, breaks: [NativeBreak], program_args: [String], input: String, deep_checks: DeepChecks, dap: Bool, env: [String]?, record: JetCLIDebugRecord?, dos: [String], color: Bool, held: JetCLIDebugEvalHeldShared) -[FS, Env, Exec, IO, Net, Time, Rand, FFI.Asm]> JetCLIPlan Never! {
    answered: if dos.len() > 0 -> jet_cli_debug_file_answers(image, entry, lines, dos) ?? return jet_cli_debug_unavailable(err, color) else -> JetCLIDebugAnswered{count: 0, refused: false}
    if dos.len() > 0 && answered.count == dos.len() {
        if jet_cli_debug_recorded(-1, [String]{}, record) == .Val(refusal) {
            return jet_cli_debug_replay_refused(refusal, color)
        }
        return jet_cli_done("", "", if answered.refused -> JET_DRIVER_EXIT_USER_ERROR else -> JET_DRIVER_EXIT_OK)
    }
    script := [String]{}
    loop (index, command) in dos {
        if index >= answered.count -> script.push("{command}")
    }
    session := NativeSession.start(image, cli_files.join(scratch, "output.txt")) ?? return jet_cli_debug_unavailable(err, color)
    if env != None && !session.replay_start {
        session.close()
        refused: jet_cli_debug_unstarted(image, if record == None -> "replay its recording" else -> "be recorded")
        if dap -> jet_cli_dap_refused(jet_cli_prove_refusal_report(refused))
        return jet_cli_fail(refused.code, refused.what, refused.why, refused.fix, color, refused.exit_code)
    }
    session.env = env
    // `--stdin=FILE` is the program's standard input, opened again at each
    // start. Without it, a console on a terminal shares it with the
    // program, as a shell's job does: the program reads it while it runs
    // and the console while it is stopped. Otherwise the console's stdin
    // carries its commands, and the adapter's its protocol: the program's
    // reads end at once unless `--stdin` (or the adapter's launch `stdin`,
    // DebugDap.jet) names its input, and the console's answer to a command
    // it doesn't know says how to give it one. Under `--do` the console
    // reads no commands from it.
    piped: !dap && !cli_term.stdin().is_tty()
    if input != "" -> session.input_path = input
    if input == "" && !dap && !piped -> session.input_path = "/dev/stdin"
    if piped && dos.len() == 0 -> session.unknown_note = JET_CLI_DEBUG_STDIN_NOTE
    source_file: if entry == "" -> session.entry_file() else -> entry
    // `print`, `watch`, conditions, logpoints and the adapter's `evaluate`
    // compile their expressions with this program (DebugCompile.jet).
    level: session.level()
    argv: jet_cli_debug_eval_argv(deep_checks, level)
    jet_cli_debug_eval_held_start(held, source_file, argv, color: color, program: session.image.sources.len() > 0)
    session.evaluate_with(JetCLIDebugEvaluator{entry: source_file, argv: argv, color: color, held: held})
    source_lines: if entry == "" -> session.entry_lines() else -> lines
    if dap -> jet_cli_debug_dap(session, source_file, deep_checks, fixable: entry != "")
    plan: if dap -> jet_cli_done("", "", JET_DRIVER_EXIT_OK) else -> jet_cli_debug_console(session, cli_files.basename(source_file), source_lines, breaks, program_args, entry, scratch, deep_checks, script, color, held, refused: answered.refused)
    session.close()
    // A console that refused (`quit` is E2204) has said why nothing was
    // recorded.
    unpublished: if plan == .Done(_) -> jet_cli_debug_recorded(session.status, session.argv.move(), record) else -> None
    if unpublished == .Val(refusal) -> return jet_cli_debug_replay_refused(refusal, color)
    plan
}

// The end of a `--record` session whose program ended with the wait status
// `status`, run with `argv` (its path first): the recording `record` binds
// is published from the sync-order log the program's runtime wrote at its
// exit, with the program arguments it ran with, as `jet run --record`
// publishes its own (jet_cli_replay_record_run), and jet names it on stderr.
// A session that ended the program first (an editor's disconnect; the
// console's `quit` refuses on its own) leaves no log, which is refused.
jet_cli_debug_recorded: fn(status: Int, argv: ^^[String], record: JetCLIDebugRecord?) -> JetCLIProveRefusal? {
    made: record ?? return None
    if status < 0 {
        return Val(jet_cli_replay_unfinalized("the session ended the program before it did, so its runtime wrote no sync-order log"))
    }
    sync: if cli_files.exists(made.log) -> cli_files.read_bytes(made.log) ?? [U8]{} else -> [U8]{}
    args := [String]{}
    loop (index, arg) in argv.move() {
        if index > 0 -> args.push(arg)
    }
    path: jet_cli_replay_record_run(made.record, status, sync, args) ?? return Val(err)
    cli_term.eprint("jet debug: recorded replay `{path}`")
    None
}

// Attach to the running program `pid` behind the `(Jet)` console, listing
// the source its image's line table names, running the console commands
// `dos` when there are any; the end of stdin or of `dos`, and `quit`, let
// it go on.
jet_cli_debug_attach: fn(pid: Int, scratch: String, deep_checks: DeepChecks, dos: [String], color: Bool) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> JetCLIPlan Never! {
    binary: native_attach_program(pid, "") ?? return jet_cli_debug_refused(err, color)
    session := NativeSession.start(binary, cli_files.join(scratch, "output.txt")) ?? return jet_cli_debug_refused(NativeAttachRefused{code: NATIVE_ATTACH_FAILED, detail: err.detail}, color)
    source_file: session.entry_file()
    level: session.level()
    argv: jet_cli_debug_eval_argv(deep_checks, level)
    // The process's image was built before the session: evaluations have a
    // held check of the program only when the image records the sources it
    // was built from (jet_cli_debug_eval_held_start).
    held: jet_cli_debug_eval_held_slot()
    jet_cli_debug_eval_held_start(held, source_file, argv, color: color, program: session.image.sources.len() > 0)
    session.evaluate_with(JetCLIDebugEvaluator{entry: source_file, argv: argv, color: color, held: held})
    lines: session.entry_lines()
    file: cli_files.basename(source_file)
    stop: session.attach(pid, "") ?? return jet_cli_debug_refused(err, color)
    plan := jet_cli_done("", "", JET_DRIVER_EXIT_OK)
    if session.attach_report(stop, pid, file, lines) == {
        .Ok(first) -> {
            plan = jet_cli_debug_commands(session, first, file, lines, pid, source_file, scratch, deep_checks, dos, color)
        }
        .Err(failure) -> { plan = jet_cli_debug_unavailable(failure, color) }
    }
    session.close()
    plan
}

jet_cli_debug_refused: fn(refused: NativeAttachRefused, color: Bool) -> JetCLIPlan Never! {
    report: refused.diagnostic()
    jet_cli_fail(report.code, report.what, report.why, report.fix, color, JET_DRIVER_EXIT_USER_ERROR)
}

jet_cli_debug_unavailable: fn(error: NativeDebugError, color: Bool) -> JetCLIPlan Never! {
    report: error.diagnostic()
    jet_cli_fail(report.code, report.what, report.why, report.fix, color, JET_DRIVER_EXIT_USER_ERROR)
}

// Run the program with `program_args` to its first stop (with `breaks`, the
// first of them the program reaches), then read commands until it ends, or
// run `script` (`--do`) when it has any; `refused` says the image's file
// refused one of the commands before them. The first stop shows once the
// session's held check of the package's cut (`held`,
// jet_cli_debug_eval_held_cut_open) is open too. It opened while the
// program launched and ran to that stop, and the stop's first `print` is
// then checked against it rather than waiting for it or compiling the
// package's cut alone.
jet_cli_debug_console: fn(session: ^NativeSession, file: String, lines: [String], breaks: [NativeBreak], program_args: [String], entry: String, scratch: String, deep_checks: DeepChecks, script: [String], color: Bool, held: JetCLIDebugEvalHeldShared, refused: Bool{false}) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> JetCLIPlan Never! {
    opened := NativeDebugStep?{None}
    if breaks.len() > 0 {
        opened = Val(session.run_to(breaks, file, lines, program_args) ?? return jet_cli_debug_unavailable(err, color))
    }
    if breaks.len() == 0 {
        if session.open(file, lines, program_args) == {
            .Ok(step) -> opened = step
            .Err(failure) -> return jet_cli_debug_unavailable(failure, color)
        }
    }
    if opened.move() == .Val(stopped) {
        jet_cli_debug_eval_held_cut_wait(held)
        first := stopped
        if refused -> first.refused = true
        return jet_cli_debug_commands(session, first, file, lines, -1, entry, scratch, deep_checks, script, color)
    }
    row: diagnostic_registry_row("E0101") ?? panic("E0101 is not registered")
    jet_cli_fail("E0101", row.what, row.why, row.fix, color, JET_DRIVER_EXIT_USER_ERROR)
}

// What the built image's file answered of `--do`'s commands: how many of
// the leading ones, and whether it refused one of them.
JetCLIDebugAnswered: struct {
    count: Int,
    refused: Bool,
}

// The leading commands of `dos` (`--do`) the built `image` answers from
// its file before its program starts (native_image_command): each one's
// answer is written, and the count of them returned, every one when one
// of them is `quit`, with whether one was refused. `entry`, with the text
// `lines`, is the program's source; "" is the source the image's line
// table names, read if it is there.
jet_cli_debug_file_answers: fn(image: String, entry: String, lines: [String], dos: [String]) -[Env, FFI.Asm, FS, IO, Time.Wait]> JetCLIDebugAnswered NativeDebugError! {
    file := native_image_session(image) ?? return Err(err)
    file.scripted = true
    source: if entry == "" -> file.entry_file() else -> entry
    text: if entry == "" -> file.entry_lines() else -> lines
    refused := false
    loop (index, command) in dos {
        if command == "q" || command == "quit" {
            return Ok(JetCLIDebugAnswered{count: dos.len(), refused: refused})
        }
        if native_image_command(file, command, cli_files.basename(source), text) == {
            .Ok(answered) -> {
                answer: answered ?? return Ok(JetCLIDebugAnswered{count: index, refused: refused})
                jet_cli_debug_write(answer.text)
                refused = refused || answer.refused
            }
            .Err(failure) -> return Err(failure)
        }
    }
    Ok(JetCLIDebugAnswered{count: dos.len(), refused: refused})
}

// Show `first`, then read commands until the program ends. A piped stdin's
// commands are echoed after the prompt, so the transcript reads as the
// session went. The end of stdin runs the program to its end, and `quit`
// ends it early (E2204); a program attached to as process `attached` (-1:
// none) is let go on instead. `fix` compiles `entry` again, built with
// `deep_checks`, and swaps the functions it changed into the program
// (DebugFix.jet); the listing then shows the edited text. `why` may build
// the -O0 image of a built image's source into `scratch`
// (jet_cli_debug_why).
//
// With a `script` (`--do`), its commands run in order instead, with no
// prompt, and its end or a `quit` ends the session: the program is ended,
// or let go on when attached to. A command left once the program has ended
// is refused with a line of its own. It exits 1 when the console refused a
// command (NativeDebugStep.refused) or the program ended with a failing
// status or a signal, else 0.
jet_cli_debug_commands: fn(session: ^NativeSession, first: NativeDebugStep, file: String, lines: [String], attached: Int, entry: String, scratch: String, deep_checks: DeepChecks, script: [String], color: Bool) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> JetCLIPlan Never! {
    scripted: script.len() > 0
    session.scripted = scripted
    echo: !scripted && !cli_term.stdin().is_tty()
    jet_cli_debug_write(first.text)
    stop := first.stop
    input := cli_term.stdin()
    // The source's text once `fix` has read it again.
    edited := [String]{}
    // The -O0 image `why` built of the source, once it has.
    recovery := ""
    // The next of `script`'s commands, and whether one was refused.
    done := 0
    refused := first.refused
    loop stop.kind == NativeStopKind.Paused {
        command := ""
        ended := true
        if scripted && done < script.len() {
            command = "{script[done]}"
            done += 1
            ended = false
        }
        if !scripted {
            jet_cli_debug_write(NATIVE_DEBUG_PROMPT)
            if input.read_line() == {
                .Ok(read) -> {
                    if read == .Val(line) {
                        command = line.trim().copy()
                        ended = false
                    }
                }
                .Err(_) -> {}
            }
        }
        if echo && !ended -> jet_cli_debug_write("{command}\n")
        quit: command == "q" || command == "quit"
        if attached > 0 && (ended || quit) {
            session.detach()
            jet_cli_debug_write("{if ended && !scripted -> "\n" else -> ""}Detached from process {attached}\n")
            return jet_cli_done("", "", if refused -> JET_DRIVER_EXIT_USER_ERROR else -> JET_DRIVER_EXIT_OK)
        }
        if scripted && (ended || quit) {
            return jet_cli_done("", "", if refused -> JET_DRIVER_EXIT_USER_ERROR else -> JET_DRIVER_EXIT_OK)
        }
        if ended {
            command = "continue"
            if echo -> jet_cli_debug_write("{command}\n")
        }
        if quit {
            row: diagnostic_registry_row("E2204") ?? panic("E2204 is not registered")
            return jet_cli_fail("E2204", row.what, row.why, row.fix, color, JET_DRIVER_EXIT_USER_ERROR)
        }
        if command == "fix" {
            jet_cli_debug_write(jet_cli_debug_fix(session, entry, deep_checks, color))
            edited = (cli_files.read(entry) ?? "").split("\n").to_list()
            next
        }
        if command == "why" || command.starts_with("why ") {
            answer: jet_cli_debug_why(session, command.after("why").trim(), entry, scratch, deep_checks, recovery) ?? return jet_cli_debug_unavailable(err, color)
            jet_cli_debug_write(answer)
            next
        }
        step: session.command(command, stop, file, if edited.len() > 0 -> edited else -> lines) ?? return jet_cli_debug_unavailable(err, color)
        jet_cli_debug_write(step.text)
        refused = refused || step.refused
        stop = step.stop
    }
    if !scripted -> return jet_cli_done("", "", JET_DRIVER_EXIT_OK)
    loop index in done..<script.len() {
        jet_cli_debug_write("`{script[index]}` not run: the program has ended\n")
        refused = true
    }
    failed: stop.kind == NativeStopKind.Signaled || (stop.kind == NativeStopKind.Exited && stop.code != 0)
    jet_cli_done("", "", if refused || failed -> JET_DRIVER_EXIT_USER_ERROR else -> JET_DRIVER_EXIT_OK)
}

// `why PLACE` (NativeSession.why). In a built image (`entry` ""), a place
// the image keeps no bytes for, as an -O2 build optimizes a local away, is
// answered from the -O0 build of the image's source under the same
// recording (NativeSession.recovered): built into `scratch` with
// `deep_checks` the first time, its image then in `recovery`.
jet_cli_debug_why: fn(session: ^NativeSession, operand: String, entry: String, scratch: String, deep_checks: DeepChecks, recovery: ^String) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> String NativeDebugError! {
    asked: session.why(operand) ?? return Err(err)
    if !asked.recover || entry != "" -> return Ok(asked.text)
    source: session.entry_source()
    if source == "" || !cli_files.exists(source) -> return Ok(asked.text)
    if recovery == "" {
        out_dir: cli_files.join(scratch, "why")
        built: cli_process.cmd(native_debug_build_argv(cli_sys.executable(), source, out_dir, deep_checks)).stdout(.Capture).stderr(.Capture).run() ?? return Ok("{asked.text}The -O0 build of `{source}` couldn't run: {err}\n")
        if !built.success {
            return Ok("{asked.text}The -O0 build of `{source}` failed:\n{built.output}{built.errors}")
        }
        recovery = native_debug_image(source, out_dir)
    }
    session.recovered(operand, recovery, cli_files.join(scratch, "why-output.txt"))
}

jet_cli_debug_write: fn(text: String) -[IO, Time.Wait]> Never! {
    if text.len() == 0 {
        return
    }
    out := cli_term.stdout()
    out.write(text).drop("jet debug stdout")
    out.flush().drop("jet debug stdout")
}
