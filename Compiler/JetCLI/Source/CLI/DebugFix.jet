// `fix` at the `(Jet)` prompt of `jet debug <file.jet>`: the entry file is
// compiled again as the program's build compiled it (its optimization level,
// the same deep checks, debug info) and the result goes to the running program
// (JetDebug NativeFix.jet), which swaps in each function the edit changed and
// takes the sources the edit was compiled from as the program's
// (jet_cli_debug_eval_digests). The fix is a transaction: it installs only a
// checked candidate (a compile with no problems, finished, built and lowered
// whole) whose inputs are unchanged (each source file it compiled from reads
// the same just before the install), at a checkpoint the running program
// accepts (Native.fix: its image, the edit's types and layouts, the frames on
// its stacks). The compile's problems, or why the swap is refused, are what
// the prompt shows instead; the program then runs on as it was.
use {
    fix_files: core.files
    fix_time: core.time
    jet_debug.[NativeFixEdit, NativeSession]
    jet_driver.[JetDriverAuthorizedSourceSnapshot, JetDriverCompileResult, JetDriverIceRow, JetDriverLoweringInputs, jet_driver_check_failures, jet_driver_entry_root_path, jet_driver_present_diagnostics, jet_driver_report_problems]
    jet_foundation.[BuildOptions, CompilerThreads, DeepChecks, deep_checks_flags]
    jet_ir.[ir_module_new, ir_x64_compile_module_logged, ir_x64_debug_program]
}

// The prompt's text after `fix` of the program `session` runs, built from
// `entry` with `deep_checks`.
jet_cli_debug_fix: fn(session: ^NativeSession, entry: String, deep_checks: DeepChecks, color: Bool) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> String Never! {
    if entry == "" -> return "Fix needs the program's source: debug it as `jet debug <file.jet>`\n"
    since: fix_time.unix_ns()
    source: fix_files.read(entry) ?? return "Fix refused: couldn't read `{entry}`: {err}\n"
    argv := [String]{"-O{session.level()}"}
    loop word in deep_checks_flags(deep_checks) -> argv.push(word)
    chosen := BuildOptions?{None}
    if jet_cli_build_options(argv, "build", entry, source, color, true) == {
        .Refused(_) -> return "Fix refused: the debug build's options don't apply to `{entry}` now\n"
        .Selected(options, _) -> chosen = Val(options)
    }
    options: chosen ?? return ""
    compiled: jet_cli_compile_executable_file(entry, None, color, None, options, None) ?? return "Fix refused: the compiler stopped before finishing `{entry}`\n"
    if compiled.move() == {
        .Refused(refusal) -> "{refusal.stdout}{refusal.stderr}Fix refused: the edit doesn't compile; the program runs on as it was\n"
        .Checked(result, inputs, snapshot) -> jet_cli_debug_fix_checked(session, entry, source, color, options, result, inputs, snapshot, since)
    }
}

// The fix of the checked compile `result` of `entry`, whose sources
// `snapshot` holds, read no earlier than `since` (unix_ns).
jet_cli_debug_fix_checked: fn(session: ^NativeSession, entry: String, source: String, color: Bool, options: BuildOptions, result: JetDriverCompileResult, inputs: ^^JetDriverLoweringInputs?, snapshot: JetDriverAuthorizedSourceSnapshot, since: Int) -[FS, Env, Exec, IO, Net, Time, FFI.Asm]> String Never! {
    errors: jet_driver_present_diagnostics(jet_driver_check_failures(result.diagnostics), snapshot, result.generated_source_files)
    if errors.len() > 0 {
        return "{jet_driver_report_problems(entry, source, errors, color, true)}Fix refused: the edit doesn't compile; the program runs on as it was\n"
    }
    if result.internal_problem != None || !result.complete {
        return "Fix refused: the compiler stopped before finishing `{entry}`\n"
    }
    checked: inputs.move() ?? return "Fix refused: the compiler finished `{entry}` without its checked functions\n"
    runtime: jet_cli_runtime_exports(jet_cli_runtime_dir())
    if runtime.failure != None -> return "Fix refused: couldn't read the Jet runtime's exports\n"
    census := [JetDriverIceRow]{}
    built := jet_cli_native_program(result, checked, None, options, runtime, census, entry, jet_driver_entry_root_path(snapshot))
    if built.failure != None || census.len() > 0 {
        return "Fix refused: the compiler couldn't build the edit\n"
    }
    program: built.program.move()
    built.program = ir_module_new()
    threads: CompilerThreads{cap: result.compiler_threads.cap, cores: result.compiler_threads.cores, memory_available: jet_cli_memory_available()}
    selected: ir_x64_compile_module_logged(program, threads, [String]{})
    if selected.errors.len() > 0 -> return "Fix refused: the compiler couldn't build the edit\n"
    lowered: ir_x64_debug_program(selected)
    if lowered.errors.len() > 0 -> return "Fix refused: the compiler couldn't build the edit\n"
    edit: NativeFixEdit{object: lowered.program.move(), functions: lowered.functions.move(), debug: lowered.debug.move()}
    // A source saved while the edit compiled is not the code about to run.
    if jet_cli_debug_eval_held_change(jet_cli_debug_eval_stamp(snapshot, since)) == .Val(changed) {
        return "Fix refused: `{changed}` changed while the edit compiled; fix again\n"
    }
    session.fix(edit, jet_cli_debug_eval_digests(snapshot)) ?? return "Fix failed: {err.detail}\n"
}
