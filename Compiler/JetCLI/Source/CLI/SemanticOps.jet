// Persisted, checkpoint-bound semantic intent. Hand edits never manufacture a
// rename receipt.
use {
    cli_files: core.files
    cli_sem_json: core.encoding.json
    core.encoding.[Dyn]
    jet_driver.[JetDriverCompileResult]
    jet_semindex.[SemDefinitionFact]
}

JetCLISemOpTarget: struct {
    stable_id: String,
    before: String,
    after: String,
    kind: String,
    module_path: String,
}

JetCLISemOpFile: struct {
    path: String,
    before_hash: String,
    after_hash: String,
}

JetCLISemOp: struct {
    kind: String,
    rule_id: String?,
    from: String?,
    to: String?,
    node: String?,
    match_template: String?,
    replace_template: String?,
    targets: [JetCLISemOpTarget],
    files: [JetCLISemOpFile],
}

jet_cli_sem_json_field: fn(value: Dyn, name: String) -> Dyn? Never! {
    if value == .Object(fields) {
        loop field in fields {
            if field.key == name -> return Val(field.value)
        }
    }
    None
}

jet_cli_sem_json_text: fn(value: Dyn, name: String) -> String? Never! {
    field: jet_cli_sem_json_field(value, name) ?? return None
    if field == .Text(text) -> return Val(text)
    None
}

jet_cli_sem_json_array: fn(value: Dyn, name: String) -> [Dyn]? Never! {
    field: jet_cli_sem_json_field(value, name) ?? return None
    if field == .Array(items) -> return Val(items)
    None
}

jet_cli_sem_same_hash: fn(recorded: String, current: String) -> Bool Never! {
    prefixed_current: "sha256-{current}"
    prefixed_recorded: "sha256-{recorded}"
    recorded == current || recorded == prefixed_current || current == prefixed_recorded
}

jet_cli_sem_normalize: fn(path: String) -> String {
    cli_files.realpath(path) ?? if path.starts_with("/") -> path else -> "{cli_files.cwd() ?? "."}/{path}"
}

jet_cli_sem_parse_op: fn(value: Dyn, files: [JetCLISemOpFile]) -> JetCLISemOp? Never! {
    kind: jet_cli_sem_json_text(value, "kind") ?? return None
    targets := [JetCLISemOpTarget]{}
    loop row in (jet_cli_sem_json_array(value, "targets") ?? [Dyn]{}) {
        stable: jet_cli_sem_json_text(row, "stable_id") ?? next
        before: jet_cli_sem_json_text(row, "before") ?? next
        after: jet_cli_sem_json_text(row, "after") ?? next
        target_kind: jet_cli_sem_json_text(row, "kind") ?? next
        path: jet_cli_sem_json_text(row, "module_path") ?? next
        targets.push(JetCLISemOpTarget{stable_id: stable, before: before, after: after, kind: target_kind, module_path: path})
    }
    Val(JetCLISemOp{kind: kind, rule_id: jet_cli_sem_json_text(value, "rule_id"), from: jet_cli_sem_json_text(value, "from"), to: jet_cli_sem_json_text(value, "to"), node: jet_cli_sem_json_text(value, "node"), match_template: jet_cli_sem_json_text(value, "match"), replace_template: jet_cli_sem_json_text(value, "replace"), targets: targets, files: files})
}

jet_cli_sem_ops_for_file: fn(raw: String, source_hash: String) -> [JetCLISemOp] {
    path: jet_cli_sem_normalize(raw)
    directory := jet_cli_parent(path)
    output := [JetCLISemOp]{}
    loop {
        root: directory ?? break
        receipts: "{root}/.jet/codemods"
        names := [String]{}
        loop entry in (cli_files.list_dir(receipts) ?? [cli_files.DirEntry]{}) {
            names.push(entry.name)
        }
        names.sort()
        loop name in names {
            receipt: "{receipts}/{name}"
            if !name.ends_with(".log.json") || !cli_files.is_file(receipt) -> next
            text: cli_files.read(receipt) ?? next
            value: cli_sem_json.parse(text) ?? next
            rows: jet_cli_sem_json_array(value, "files") ?? next
            files := [JetCLISemOpFile]{}
            matches := false
            loop row in rows {
                file_path: jet_cli_sem_json_text(row, "path") ?? next
                before: jet_cli_sem_json_text(row, "before_hash") ?? next
                after: jet_cli_sem_json_text(row, "after_hash") ?? next
                normalized: jet_cli_sem_normalize(if file_path.starts_with("/") -> file_path else -> "{root}/{file_path}")
                files.push(JetCLISemOpFile{path: normalized, before_hash: before, after_hash: after})
                if normalized == path && (jet_cli_sem_same_hash(before, source_hash) || jet_cli_sem_same_hash(after, source_hash)) {
                    matches = true
                }
            }
            if !matches -> next
            loop row in (jet_cli_sem_json_array(value, "semantic_ops") ?? [Dyn]{}) {
                if jet_cli_sem_parse_op(row, files) == .Val(operation) -> output.push(operation)
            }
        }
        directory = jet_cli_parent(root)
    }
    output
}

jet_cli_sem_op_transition: fn(operation: JetCLISemOp, paths: [String], before: String, after: String) -> Bool {
    loop file in operation.files {
        if !jet_cli_sem_same_hash(file.before_hash, before) || !jet_cli_sem_same_hash(file.after_hash, after) {
            next
        }
        loop path in paths {
            if jet_cli_sem_normalize(file.path) == jet_cli_sem_normalize(path) -> return true
        }
    }
    false
}

jet_cli_sem_op_value: fn(operation: JetCLISemOp) -> JetCLIStatusValue Never! {
    jet_cli_status_object(
        [JetCLIStatusField]{
            jet_cli_status_field("kind", jet_cli_status_text(operation.kind)),
            jet_cli_status_field("rule_id", jet_cli_status_optional_text(operation.rule_id)),
            jet_cli_status_field("from", jet_cli_status_optional_text(operation.from)),
            jet_cli_status_field("to", jet_cli_status_optional_text(operation.to)),
            jet_cli_status_field("node", jet_cli_status_optional_text(operation.node)),
            jet_cli_status_field("match", jet_cli_status_optional_text(operation.match_template)),
            jet_cli_status_field("replace", jet_cli_status_optional_text(operation.replace_template)),
        },
    )
}

// One rename jet_cli_semantic_rename_ops finds: the fact at `before` in the
// facts before the edit is the fact at `after` in the facts after it.
JetCLIRenamePair: struct {
    before: Int,
    after: Int,
}

// The order jet_cli_semantic_rename_ops groups definition facts by: what a
// rename keeps, the fact's kind, module and signature.
jet_cli_rename_order: fn(left: SemDefinitionFact, right: SemDefinitionFact) -> Ordering Never! {
    (left.kind <=> right.kind).then(left.module_path <=> right.module_path).then(left.signature_id <=> right.signature_id)
}

// semantic_rename_ops: only the tool's checked before/after snapshots can
// record rename intent; ordinary review never infers a receipt. A fact before
// is renamed when exactly one fact after that no earlier rename claimed shares
// its kind, module and signature under another name, and no other fact before
// shares them under a name other than that one's. Both sides are sorted by
// those three (jet_cli_rename_order), so a fact is compared only with its own
// group, never with every fact of the program; the renames come out in the
// order of the facts before.
jet_cli_semantic_rename_ops: fn(before: [SemDefinitionFact], after: [SemDefinitionFact]) -> [JetCLISemOp] Never! {
    olds := loop index in 0..<before.len() -> index
    olds.sort_by(fn(left: Int, right: Int) { jet_cli_rename_order(before[left], before[right]).then(left <=> right) })
    news := loop index in 0..<after.len() -> index
    news.sort_by(fn(left: Int, right: Int) { jet_cli_rename_order(after[left], after[right]).then(left <=> right) })
    used := loop _ in 0..<after.len() -> false
    pairs := [JetCLIRenamePair]{}
    start := 0
    group := 0
    loop group < olds.len() {
        key: before[olds[group]]
        end := group + 1
        loop end < olds.len() && jet_cli_rename_order(before[olds[end]], key) == Ordering.Equal -> end += 1
        loop start < news.len() && jet_cli_rename_order(after[news[start]], key) == Ordering.Less -> start += 1
        stop := start
        loop stop < news.len() && jet_cli_rename_order(after[news[stop]], key) == Ordering.Equal -> stop += 1
        loop slot in group..<end {
            old: before[olds[slot]]
            found := -1
            count := 0
            loop at in start..<stop {
                index: news[at]
                if !used[index] && after[index].name != old.name {
                    found = index
                    count += 1
                }
            }
            if count != 1 -> next
            reverse := 0
            loop other in group..<end {
                if other == slot || before[olds[other]].name != after[found].name -> reverse += 1
            }
            if reverse != 1 -> next
            used[found] = true
            pairs.push(JetCLIRenamePair{before: olds[slot], after: found})
        }
        group = end
    }
    pairs.sort_by(fn(left: JetCLIRenamePair, right: JetCLIRenamePair) { left.before <=> right.before })
    loop pair in pairs -> {
        old: before[pair.before]
        renamed: after[pair.after]
        target: JetCLISemOpTarget{stable_id: old.stable_id, before: old.human_identity, after: renamed.human_identity, kind: renamed.kind, module_path: renamed.module_path}
        JetCLISemOp{kind: "rename", rule_id: Val("jet-fix"), from: Val(old.name), to: Val(renamed.name), node: None, match_template: None, replace_template: None, targets: [JetCLISemOpTarget]{target}, files: [JetCLISemOpFile]{}}
    }
}

// The definition facts of `result`, a `jet fix` compile
// (jet_cli_fix_compile), that rename receipts compare; the index is built
// without its effect rows, which they never read. A refused or invalid check
// has no rename authority, so it has none: the fix receipt then records the
// exact changed byte region instead.
jet_cli_fix_result_facts: fn(result: JetDriverCompileResult) -> [SemDefinitionFact]? {
    if !result.complete || result.internal_problem != None || jet_cli_errors(result.diagnostics).len() > 0 {
        return None
    }
    index: jet_cli_checked_semindex(result, effects: false) ?? return None
    Val(index.definition_facts)
}
