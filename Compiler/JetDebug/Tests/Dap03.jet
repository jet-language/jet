// Rust: crates/jet-debug/src/Dap.rs:5657
#Test("dap_unmapped_stop_terminates_with_a_jet_diagnostic") {
    server := test_server(.Running)
    output := [U8]{}
    &server.emit_resume(&output, .Stopped("stop reason = breakpoint\n"), .Continue)
    text :: String.from_utf8(^output).expect("DAP output is UTF-8")
    assert_eq(server.state, .Terminated)
    assert(text.contains("E2235"))
