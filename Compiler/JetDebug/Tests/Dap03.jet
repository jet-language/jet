// Rust: crates/jet-debug/src/Dap.rs:5045
#Test("attach_arguments_require_local_program_map_and_explicit_raw_frame_shape") {
    // GATE #4494: real native files and process/thread identities.
    root :: env.temp_dir().join("jet-dap-attach-{process.id()}-{thread.current().name() ?? "test"}")
    fs.create_dir_all(root).unwrap()
    program :: root.join("program")
    map :: root.join("program.jetmap")
    fs.write(program, "program".as_bytes()).unwrap()
    fs.write(map, "map".as_bytes()).unwrap()
    request :: parse_json("{{\"processId\":1,\"program\":\"{json_escape(program.to_string_lossy())}\",\"map\":\"{json_escape(map.to_string_lossy())}\",\"showRawFrames\":false}}").unwrap()
    parsed :: parse_attach_arguments(.Val(request)).unwrap()
    assert_eq(parsed.pid, 1)
    assert_eq(parsed.program, fs.canonicalize(program).unwrap())
    assert_eq(parsed.map, fs.canonicalize(map).unwrap())
    assert(!parsed.show_raw_frames)
    raw_request :: parse_json("{{\"processId\":1,\"program\":\"{json_escape(program.to_string_lossy())}\",\"map\":\"{json_escape(map.to_string_lossy())}\",\"showRawFrames\":true}}").unwrap()
    assert(parse_attach_arguments(.Val(raw_request)).unwrap().show_raw_frames)
    loop raw in ["{{\"processId\":0}}", "{{\"processId\":1,\"program\":\"missing\",\"map\":\"missing\"}}"] {
        args :: parse_json(raw).unwrap()
        assert(parse_attach_arguments(.Val(args)).is_err(), "accepted {raw}")
    }
    _ :: fs.remove_dir_all(root)
}
