    output := [U8]{}
    &server.emit_resume(&output, .Stopped("frame #0: 0x0000 `runtime_helper at generated.rs:99:1\n"), .Pause)
    text :: String.from_utf8(^output).expect("DAP output is UTF-8")
    assert_eq(server.state, .Terminated)
    assert(!text.contains("\"event\":\"stopped\""))
    assert(text.contains("E2235") || text.contains("E2234"), text)
}
// Rust: crates/jet-debug/src/Dap.rs:5690
#Test("exited_target_releases_server_target_state") {
    server := test_server(.Running)
    server.target = .Val(.Launched)
    output := [U8]{}
    &server.emit_resume(&output, .Exited { status: .Val(0), signal: None }, .Continue)
    assert_eq(server.state, .Terminated)
    assert(server.inf == None)
    assert(server.target == None)
    text :: String.from_utf8(^output).expect("DAP output is UTF-8")
    assert(text.contains("\"event\":\"exited\""), text)
    assert(text.contains("\"event\":\"terminated\""), text)
}
