// Rust: crates/jet-debug/src/Dap.rs:5314
fn dap_call(server: &DapServer, body: String) -> String {
    request :: parse_dap_request(body).expect("valid DAP request")
    output := [U8]{}
    assert(&server.handle(request, &output) != None)
    String.from_utf8(^output).expect("DAP output is UTF-8")
}
// Rust: crates/jet-debug/src/Dap.rs:5321
fn dap_message(output: String) -> DataTree {
    reader := io.Cursor.new(output.as_bytes())
    body :: read_message(&reader).expect("DAP response frame").expect("DAP response body")
    parse_json(body).expect("DAP response JSON")
}
// Rust: crates/jet-debug/src/Dap.rs:5329
fn dap_body_id(output: String, collection: String, field: String) -> U32 {
    message :: dap_message(output)
    body :: json_get(message, "body").expect("DAP response body object")
    values :: if json_get(body, collection).expect("DAP response collection") == {
        .Array(values) -> values, else -> panic("DAP response collection is not an array")
    }
    json_get(values.first().expect("DAP response collection item"), field).and_then(json_u32).expect("DAP response id")
}
// Rust: crates/jet-debug/src/Dap.rs:5342
#Test("dap_restart_rebuilds_target_preserves_breakpoints_and_expires_references") {
    if Inferior.available() {
        // GATE #4494: real compiled native fixture, not a substitute backend.
        root :: env.temp_dir().join("jet-dap-restart-{process.id()}-{time.SystemTime.now().duration_since(time.UNIX_EPOCH).expect("clock after epoch").as_nanos()}")
        fs.create_dir_all(root).expect("create debugger test directory")
        jet_file :: root.join("program.jet")
        rust_file :: root.join("program.rs")
        binary :: root.join("program")
        jet_src :: "fn run() {{\n    value := 7\n    print(value)\n}}\n"
        rust_src :: "fn main() {{\n    // jet:line 2\n    let __jet_value: i32 = 7;\n    // jet:line 3\n    println!(\"{{}}\", __jet_value);\n}}\n"
        fs.write(jet_file, jet_src).expect("write Jet fixture")
        fs.write(rust_file, rust_src).expect("write Rust fixture")
        rustc :: process.Command.new("rustc").args(["--edition", "2021", "-C", "debuginfo=2"]).arg(rust_file).arg("-o").arg(binary).output().expect("run rustc")
        assert(rustc.status.success(), "rustc rejected DAP fixture: {String.from_utf8_lossy(rustc.stderr)}")
        map_path :: binary.with_extension("jetmap")
        LineMap.write_artifact(map_path, jet_file.to_string_lossy(), jet_src, rust_file.to_string_lossy(), rust_src, binary).expect("write debugger map")
        server := test_server(.New)
        server.map = LineMap.load_verified(map_path, jet_file.to_string_lossy(), jet_src, rust_file.to_string_lossy(), rust_src, binary).expect("load debugger map")
        server.rust_file = rust_file.to_string_lossy()
        server.rust_src = rust_src
        server.jet_file = jet_file.to_string_lossy()
        server.jet_src = jet_src
        server.binary = binary
        assert(dap_call(&server, "{{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{{\"adapterID\":\"jet\"}}}}").contains("\"success\":true"))
        breakpoint :: dap_call(&server, "{{\"seq\":2,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{{\"source\":{{\"path\":\"{json_escape(jet_file.to_string_lossy())}\"}},\"breakpoints\":[{{\"line\":3}}]}}}}")
        assert(breakpoint.contains("\"verified\":true"), breakpoint)
        launch :: dap_call(&server, "{{\"seq\":3,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{{\"program\":\"{json_escape(jet_file.to_string_lossy())}\",\"stopOnEntry\":true}}}}")
        assert(launch.contains("\"event\":\"initialized\""), launch)
        configured :: dap_call(&server, "{{\"seq\":4,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{{}}}}")
        assert(configured.contains("\"event\":\"stopped\""), configured)
        assert_eq(server.state, .Stopped)
        stack :: dap_call(&server, "{{\"seq\":5,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{{\"threadId\":1}}}}")
        old_frame :: dap_body_id(stack, "stackFrames", "id")
        scopes :: dap_call(&server, "{{\"seq\":6,\"type\":\"request\",\"command\":\"scopes\",\"arguments\":{{\"frameId\":{old_frame}}}}}")
        old_scope :: dap_body_id(scopes, "scopes", "variablesReference")
        variables :: dap_call(&server, "{{\"seq\":7,\"type\":\"request\",\"command\":\"variables\",\"arguments\":{{\"variablesReference\":{old_scope}}}}}")
        assert(variables.contains("\"success\":true"), variables)
        restarted :: dap_call(&server, "{{\"seq\":8,\"type\":\"request\",\"command\":\"restart\",\"arguments\":{{}}}}")
        assert(restarted.contains("\"command\":\"restart\""), restarted)
        assert(restarted.contains("\"success\":true"), restarted)
        assert(restarted.contains("\"event\":\"stopped\""), restarted)
        assert_eq(server.state, .Stopped)
        stale_scope :: dap_call(&server, "{{\"seq\":9,\"type\":\"request\",\"command\":\"variables\",\"arguments\":{{\"variablesReference\":{old_scope}}}}}")
        assert(stale_scope.contains("\"id\":22036"), stale_scope)
        assert(stale_scope.contains("\"code\":\"E2238\""), stale_scope)
        continued :: dap_call(&server, "{{\"seq\":10,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{{\"threadId\":1}}}}")
        assert(continued.contains("\"event\":\"stopped\""), continued)
        assert_eq(server.state, .Stopped)
        breakpoint_stack :: dap_call(&server, "{{\"seq\":101,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{{\"threadId\":1}}}}")
        assert(breakpoint_stack.contains("\"line\":3"), breakpoint_stack)
        assert(breakpoint_stack.contains(json_escape(jet_file.to_string_lossy())), breakpoint_stack)
        // Rename over the busy executable inode rather than overwrite it.
        replacement :: root.join("replacement-debug-binary")
        fs.write(replacement, "replaced binary".as_bytes()).expect("write replacement binary")
        fs.rename(replacement, binary).expect("replace debugger binary")
        stale_binary :: dap_call(&server, "{{\"seq\":11,\"type\":\"request\",\"command\":\"restart\",\"arguments\":{{}}}}")
        assert(stale_binary.contains("\"success\":false"), stale_binary)
        assert(stale_binary.contains("\"id\":22037"), stale_binary)
        assert(stale_binary.contains("\"code\":\"E2231\""), stale_binary)
        assert_eq(server.state, .Ready)
        assert(server.inf == None)
        assert_eq(&server.finish(ExitCodes.OK), ExitCodes.OK)
        _ :: fs.remove_dir_all(root)
    }
}
// Rust: crates/jet-debug/src/Dap.rs:5509
#Test("dap_rejects_stale_scope_after_resume_generation_is_invalidated") {
    server := test_server(.Stopped)
    frame_id :: &server.references.issue_frame(1, 0)
    scopes :: parse_dap_request("{{\"seq\":1,\"type\":\"request\",\"command\":\"scopes\",\"arguments\":{{\"frameId\":{frame_id}}}}}").unwrap()
    out := [U8]{}
    _ :: &server.handle(scopes, &out)
    text :: String.from_utf8(^out).unwrap()
    assert(text.contains("\"success\":true"))
    assert(text.contains("\"variablesReference\":2"))
    continue_request :: parse_dap_request("{{\"seq\":2,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{{\"threadId\":1}}}}").unwrap()
    out := [U8]{}
    _ :: &server.handle(continue_request, &out)
    text :: String.from_utf8(^out).unwrap()
    assert(text.contains("\"success\":false"))
    server.state = .Stopped
    variables :: parse_dap_request("{{\"seq\":3,\"type\":\"request\",\"command\":\"variables\",\"arguments\":{{\"variablesReference\":2}}}}").unwrap()
    out := [U8]{}
    _ :: &server.handle(variables, &out)
    text :: String.from_utf8(^out).unwrap()
    assert(text.contains("\"success\":false"))
    assert(text.contains("\"message\":\"jet.staleReference\""))
    assert(text.contains("\"id\":22036"))
    assert(text.contains("\"schema\":\"jet.diagnostic/v1\""))
    assert(text.contains("\"code\":\"E2238\""))
    server.target = .Val(.Attached)
    restart :: parse_dap_request("{{\"seq\":4,\"type\":\"request\",\"command\":\"restart\",\"arguments\":{{}}}}").unwrap()
    out := [U8]{}
    _ :: &server.handle(restart, &out)
    text :: String.from_utf8(^out).unwrap()
    assert(text.contains("\"success\":false"))
    assert(text.contains("\"message\":\"jet.unsupported\""))
    assert(text.contains("\"id\":22033"))
}
// Rust: crates/jet-debug/src/Dap.rs:5558
#Test("dap_exception_filters_and_loaded_sources_obey_lifecycle") {
    server := test_server(.New)
    before_initialize :: dap_call(&server, "{{\"seq\":1,\"type\":\"request\",\"command\":\"setExceptionBreakpoints\",\"arguments\":{{\"filters\":[\"panic\"]}}}}")
    assert(before_initialize.contains("\"id\":22031"))
    initialized :: dap_call(&server, "{{\"seq\":2,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{{\"adapterID\":\"jet\"}}}}")
    assert(initialized.contains("\"success\":true"))
    selected :: dap_call(&server, "{{\"seq\":3,\"type\":\"request\",\"command\":\"setExceptionBreakpoints\",\"arguments\":{{\"filters\":[\"panic\",\"signal\"]}}}}")
    assert(selected.contains("\"success\":true"))
    assert(server.exception_filters.contains("panic"))
    assert(server.exception_filters.contains("signal"))
    assert(!server.exception_filters.contains("all"))
    invalid :: dap_call(&server, "{{\"seq\":4,\"type\":\"request\",\"command\":\"setExceptionBreakpoints\",\"arguments\":{{\"filters\":[\"generated-rust\"]}}}}")
    assert(invalid.contains("\"id\":22032"))
    server.state = .Terminated
    after_termination :: dap_call(&server, "{{\"seq\":5,\"type\":\"request\",\"command\":\"loadedSources\",\"arguments\":{{}}}}")
    assert(after_termination.contains("\"id\":22031"))
}
// Rust: crates/jet-debug/src/Dap.rs:5595
#Test("dap_exception_info_keeps_jet_panic_error_and_signal_meaning") {
    server := test_server(.Stopped)
    server.last_exception = .Val("panic")
    panic_response :: dap_call(&server, "{{\"seq\":1,\"type\":\"request\",\"command\":\"exceptionInfo\",\"arguments\":{{}}}}")
    assert(panic_response.contains("\"exceptionId\":\"JetPanic\""), panic_response)
    assert(panic_response.contains("\"description\":\"Jet panic\""), panic_response)
    server.last_exception = .Val("error")
    error :: dap_call(&server, "{{\"seq\":2,\"type\":\"request\",\"command\":\"exceptionInfo\",\"arguments\":{{}}}}")
    assert(error.contains("\"exceptionId\":\"JetError\""), error)
    assert(error.contains("\"description\":\"Jet error\""), error)
    server.last_signal = .Val("SIGABRT")
    server.last_exception = .Val("SIGABRT")
    signal :: dap_call(&server, "{{\"seq\":3,\"type\":\"request\",\"command\":\"exceptionInfo\",\"arguments\":{{}}}}")
    assert(signal.contains("\"exceptionId\":\"SIGABRT\""), signal)
    assert(signal.contains("Jet target stopped on SIGABRT"), signal)
}
