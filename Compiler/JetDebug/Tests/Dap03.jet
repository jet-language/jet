// Rust: crates/jet-debug/src/Dap.rs:5222
struct BrokenPipe {}
impl io.Write for BrokenPipe {
    // Rust: crates/jet-debug/src/Dap.rs:5226
    fn write(&self, _buf: [U8]) -> io.Result[USize] { .Err(io.Error.new(.BrokenPipe, "client closed")) }
    // Rust: crates/jet-debug/src/Dap.rs:5230
    fn flush(&self) -> io.Result[()] { .Err(io.Error.new(.BrokenPipe, "client closed")) }
}
#Test("broken_dap_output_cannot_finish_as_a_clean_session") {
    input :: frame("{{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{{\"adapterID\":\"jet\"}}}}")
    server := test_server(.New)
    output := BrokenPipe {}
    code :: run_io(&server, io.Cursor.new(input), &output)
    assert_eq(code, ExitCodes.USER_ERROR)
    assert(server.terminal_failure)
}
// Rust: crates/jet-debug/src/Dap.rs:5246
#Test("object_references_expire_on_generation_change") {
    refs := ObjectReferences.default()
    frame :: &refs.issue(.Frame)
    scope :: &refs.issue(.Scope)
    assert(refs.is_live(frame, .Frame))
    assert(refs.is_live(scope, .Scope))
    &refs.invalidate()
    assert(!refs.is_live(frame, .Frame))
    assert(!refs.is_live(scope, .Scope))
    replacement :: &refs.issue(.Frame)
    assert_ne(replacement, frame)
    assert(refs.is_live(replacement, .Frame))
    stable :: &refs.issue_frame(1, 0)
    assert_eq(stable, &refs.issue_frame(1, 0))
    assert_ne(stable, &refs.issue_frame(2, 0))
}
// Rust: crates/jet-debug/src/Dap.rs:5267
#Test("repeated_stopped_snapshot_requests_reuse_object_references") {
    refs := ObjectReferences.default()
    raw_frame :: &refs.issue_raw_frame(1, 2)
    frame :: &refs.issue_frame(1, 2)
    raw_scope :: &refs.issue_scope(raw_frame, .RawScope)
