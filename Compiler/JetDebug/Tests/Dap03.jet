// Rust: crates/jet-debug/src/Dap.rs:4766
#Test("dap_request_envelope_rejects_wrong_shapes_and_numbers") {
    assert(parse_dap_request("{{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{{\"adapterID\":\"jet\"}}}}").is_ok())
    loop raw in [
        "{{\"seq\":1,\"type\":\"event\",\"command\":\"initialize\"}}",
        "{{\"seq\":1.5,\"type\":\"request\",\"command\":\"initialize\"}}",
        "{{\"seq\":-1,\"type\":\"request\",\"command\":\"initialize\"}}",
        "{{\"seq\":0,\"type\":\"request\",\"command\":\"initialize\"}}",
        "{{\"seq\":1,\"type\":\"request\",\"command\":\"\"}}",
        "{{\"seq\":1,\"type\":\"request\",\"command\":2}}",
        "{{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":[]}}",
        "[\"not\",\"a\",\"request\"]"
    ] { assert(parse_dap_request(raw).is_err(), "accepted hostile DAP: {raw}") }
}
// Rust: crates/jet-debug/src/Dap.rs:4789
#Test("initialize_requires_jet_and_negotiates_origins") {
    server := test_server(.New)
    rejected :: dap_call(&server, "{{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{{\"adapterID\":\"other\"}}}}")
    assert(rejected.contains("\"success\":false"), rejected)
    assert(rejected.contains("\"id\":22032"), rejected)
    assert_eq(server.state, .New)
    accepted :: dap_call(&server, "{{\"seq\":2,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{{\"adapterID\":\"jet\",\"pathFormat\":\"path\",\"linesStartAt1\":false,\"columnsStartAt1\":false,\"supportsANSIStyling\":true}}}}")
    assert(accepted.contains("\"success\":true"), accepted)
    assert(accepted.contains("supportsPauseRequest"), accepted)
    assert(accepted.contains("supportsVariablePaging"), accepted)
    assert(!server.lines_start_at_1)
    assert(!server.columns_start_at_1)
    assert(server.supports_ansi_styling)
}
// Rust: crates/jet-debug/src/Dap.rs:4812
#Test("dap_framing_accepts_case_insensitive_length_and_rejects_duplicates") {
    body :: "{{\"seq\":1,\"type\":\"request\",\"command\":\"threads\"}}"
    wire :: "X-Editor: test\r\ncontent-length: {body.len()}\r\n\r\n{body}"
    reader := io.Cursor.new(wire)
    assert_eq(read_message(&reader).unwrap(), .Val(body))
    duplicate := io.Cursor.new("Content-Length: 1\r\ncontent-length: 1\r\n\r\na")
    assert(read_message(&duplicate).is_err())
    invalid := io.Cursor.new("Content-Length: +1\r\n\r\na")
    assert(read_message(&invalid).is_err())
}
// Rust: crates/jet-debug/src/Dap.rs:4831
#Test("queued_snapshot_requests_wait_for_resume_to_settle") {
    requests := VecDeque.from([
        parse_dap_request("{{\"seq\":1,\"type\":\"request\",\"command\":\"threads\",\"arguments\":{{}}}}").unwrap(),
        parse_dap_request("{{\"seq\":2,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{{}}}}").unwrap(),
        parse_dap_request("{{\"seq\":3,\"type\":\"request\",\"command\":\"pause\",\"arguments\":{{}}}}").unwrap(),
        parse_dap_request("{{\"seq\":4,\"type\":\"request\",\"command\":\"restart\",\"arguments\":{{}}}}").unwrap(),
        parse_dap_request("{{\"seq\":5,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{{}}}}").unwrap()
    ])
    control :: take_next_request(&requests, true).expect("running control request")
    assert_eq(json_get(control, "command").and_then(json_str), .Val("pause"))
    restart :: take_next_request(&requests, true).expect("restart request")
    assert_eq(json_get(restart, "command").and_then(json_str), .Val("restart"))
    breakpoints :: take_next_request(&requests, true).expect("breakpoint replacement request")
    assert_eq(json_get(breakpoints, "command").and_then(json_str), .Val("setBreakpoints"))
    assert(take_next_request(&requests, true) == None)
    assert_eq(requests.len(), 2)
    first :: take_next_request(&requests, false).expect("queued request")
    assert_eq(json_get(first, "command").and_then(json_str), .Val("threads"))
}
// Rust: crates/jet-debug/src/Dap.rs:4876
#Test("breakpoint_ids_are_stable_and_client_lines_follow_negotiation") {
    server := test_server(.New)
    initialized :: dap_call(&server, "{{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{{\"adapterID\":\"jet\"}}}}")
    assert(initialized.contains("\"success\":true"), initialized)
    first :: dap_call(&server, "{{\"seq\":2,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{{\"source\":{{\"path\":\"main.jet\"}},\"breakpoints\":[{{\"line\":2}}]}}}}")
    first_id :: dap_body_id(first, "breakpoints", "id")
    second :: dap_call(&server, "{{\"seq\":3,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{{\"source\":{{\"path\":\"main.jet\"}},\"breakpoints\":[{{\"line\":2}}]}}}}")
    assert_eq(dap_body_id(second, "breakpoints", "id"), first_id)
    zero_based := test_server(.New)
    initialized :: dap_call(&zero_based, "{{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{{\"adapterID\":\"jet\",\"linesStartAt1\":false}}}}")
    assert(initialized.contains("\"success\":true"), initialized)
    response :: dap_call(&zero_based, "{{\"seq\":2,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{{\"source\":{{\"path\":\"main.jet\"}},\"breakpoints\":[{{\"line\":0}}]}}}}")
    assert(response.contains("\"line\":0"), response)
    assert_eq(zero_based.pending_breakpoints, [1])
}
