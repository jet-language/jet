// Rust: crates/jet-debug/src/Dap.rs:4311
fn breakpoint_lines(args: DataTree?) -> [USize] Err! { breakpoint_lines_for_origin(args, true) }
// Rust: crates/jet-debug/src/Dap.rs:4316
fn breakpoint_lines_for_origin(args: DataTree?, lines_start_at_1: Bool) -> [USize] Err! {
    value :: args.and_then((a) -> json_get(a, "breakpoints")) ?? return []
    items :: if value == { .Array(items) -> items, else -> return .Err("breakpoints must be an array") }
    lines := [USize]{}
    loop item in items {
        line := json_get(item, "line").and_then(json_u32) ?? return .Err("breakpoint line must be a nonnegative integer")
        if lines_start_at_1 && line == 0 -> return .Err("breakpoint line must be a positive integer")
        if !lines_start_at_1 -> line = line.checked_add(1) ?? return .Err("breakpoint line is too large")
        &lines.push(USize.try_from(line) ?? return .Err("breakpoint line is too large"))
    }
    return lines
}
// Rust: crates/jet-debug/src/Dap.rs:4625
fn test_server(state: State) -> DapServer {
    DapServer {
        map: LineMap.build(""), rust_file: "main.rs", rust_src: "", jet_file: "main.jet", jet_src: "",
        binary: OSPath("missing-debug-binary"), inf: None,
        pending_breakpoints: [], pending_specs: [], hit_counts: [], source_breakpoint_ids: [], client_breakpoint_ids: [],
        next_client_breakpoint_id: 1, entry_breakpoint_id: None, stop_on_entry: true, target: None,
        launch_args: [], launch_cwd: None, launch_env: [], current_thread: 1, last_signal: None, last_exception: None,
        exception_filters: default_exception_filters(), show_raw_frames: false, lines_start_at_1: true,
        columns_start_at_1: true, supports_ansi_styling: false, unmapped_steps: 0,
        references: ObjectReferences.default(), state: state, terminal_failure: false, client_sequences: [U32:Bool]{},
        seq: 1, resume_task: None, resume_stop_requested: false,
        history: DebugHistory {
            events: [], checkpoint: .Val(DebugCheckpoint {
                source_identity: jet_foundation.SHA256.sha256_hex("main.jet:".as_bytes()),
                shape: "native-dap-debug-artifact", sequence: 0
            }), cursor: None, capped: false, decision_ledger: None
        }, history_cursor: None, data_watches: [String:Bool]{}, candidate_artifacts: [], replay_only_after_fix: false
    }
}
// Rust: crates/jet-debug/src/Dap.rs:4682
fn frame(body: String) -> String { "Content-Length: {body.len()}\r\n\r\n{body}" }
// Rust: crates/jet-debug/src/Dap.rs:4687
#Test("stack_projection_pages_over_unmapped_native_frames") {
    map :: LineMap.build("// jet:line 2\nlet x = 1;\n// jet:line 3\nlet y = 2;\n")
    frames :: [RawFrame {
        func: "runtime_helper", rust_file: "main.rs", rust_line: 1
    }, RawFrame {
        func: "__jet_run", rust_file: "main.rs", rust_line: 2
    }, RawFrame {
        func: "__jet_run", rust_file: "main.rs", rust_line: 4
    }]
    jet_frames :: project_frames(frames, map, "main.rs", false)
    assert_eq(jet_frames.len(), 2)
    assert_eq(jet_frames[0].position, 1)
    assert_eq(jet_frames[0].jet_line, .Val(2))
    assert_eq(jet_frames[1].position, 2)
    assert_eq(jet_frames[1].jet_line, .Val(3))
    second_page :: jet_frames.iter().skip(1).take(1).collect()
    assert_eq(second_page[0].frame.rust_line, 4)
    assert_eq(second_page[0].jet_line, .Val(3))
    raw_frames :: project_frames(frames, map, "main.rs", true)
    assert_eq(raw_frames.len(), 5)
    assert(!raw_frames[0].raw)
    assert(!raw_frames[1].raw)
    assert(raw_frames[2].raw)
    assert_eq(raw_frames[0].position, 1)
    assert_eq(raw_frames[1].position, 2)
    assert_eq(raw_frames[2].position, 0)
}
