    text :: String.from_utf8(^output).unwrap()
    assert(text.contains("\"event\":\"breakpoint\""), "missing DAP breakpoint change events: {text}")
    assert(text.contains("\"id\":7,\"verified\":false"), "unresolved native breakpoint must be reported as pending: {text}")
    assert(text.contains("\"id\":8,\"verified\":true"), "resolved native breakpoint must be reported as verified: {text}")
