// Rust: crates/jet-debug/src/Dap.rs:4999
#Test("raw_scopes_append_to_jet_scopes_and_raw_frame_handles_stay_raw") {
    server := test_server(.Stopped)
    jet_frame :: &server.references.issue_frame(1, 0)
    scopes :: dap_call(&server, "{{\"seq\":1,\"type\":\"request\",\"command\":\"scopes\",\"arguments\":{{\"frameId\":{jet_frame},\"showRawFrames\":true}}}}")
    assert(scopes.contains("\"name\":\"Locals\""), scopes)
    assert(scopes.contains("\"name\":\"[raw] Locals\""), scopes)
    assert(server.references.is_live(2, .Scope))
    assert(server.references.is_live(3, .RawScope))
    raw_frame :: &server.references.issue_raw_frame(1, 1)
    raw_scopes :: dap_call(&server, "{{\"seq\":2,\"type\":\"request\",\"command\":\"scopes\",\"arguments\":{{\"frameId\":{raw_frame},\"showRawFrames\":false}}}}")
    assert(raw_scopes.contains("\"name\":\"[raw] Locals\""), raw_scopes)
    assert(!raw_scopes.contains("\"name\":\"Locals\""), raw_scopes)
}
