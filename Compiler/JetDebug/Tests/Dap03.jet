// Rust: crates/jet-debug/src/Dap.rs:5114
#Test("dap_attach_rejects_a_real_process_running_another_binary") {
    // GATE #4494
    root :: env.temp_dir().join("jet-debug-attach-denied-{process.id()}-{thread.current().name() ?? "test"}")
    fs.create_dir_all(root).unwrap()
    program :: env.current_exe().unwrap()
    map :: root.join("program.jetmap")
    LineMap.write_artifact(map, "main.jet", "", "main.rs", "", program).unwrap()
    target := process.Command.new("sleep").arg("30").spawn().expect("spawn real attach target")
    input :: frame("{{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{{\"adapterID\":\"jet\"}}}}") + frame("{{\"seq\":2,\"type\":\"request\",\"command\":\"attach\",\"arguments\":{{\"processId\":{target.id()},\"program\":\"{json_escape(program.to_string_lossy())}\",\"map\":\"{json_escape(map.to_string_lossy())}\"}}}}")
    server := test_server(.New)
    output := [U8]{}
    code :: run_io(&server, io.Cursor.new(input), &output)
    text :: String.from_utf8(^output).unwrap()
    _ :: &target.kill()
    _ :: &target.wait()
    _ :: fs.remove_dir_all(root)
    assert_eq(code, ExitCodes.OK)
    assert(text.contains("\"command\":\"attach\""), text)
    assert(text.contains("\"success\":false"), text)
    assert(text.contains("\"id\":22037"), text)
    assert(text.contains("\"code\":\"E2231\""), text)
    assert(server.inf == None)
}
// Rust: crates/jet-debug/src/Dap.rs:5155
#Test("dap_attaches_and_disconnects_without_terminating_a_real_target") {
    if selected_os() == .Linux && Inferior.available() {
        // GATE #4494
        root :: env.temp_dir().join("jet-dap-attach-disconnect-{process.id()}-{time.SystemTime.now().duration_since(time.UNIX_EPOCH).expect("clock after epoch").as_nanos()}")
        fs.create_dir_all(root).expect("create debugger test directory")
        target := process.Command.new("sleep").arg("30").spawn().expect("spawn real attach target")
        pid :: target.id()
        program :: fs.canonicalize(OSPath("/proc/{pid}/exe")).expect("resolve real attach target binary")
        map :: root.join("target.jetmap")
        LineMap.write_artifact(map, "main.jet", "", "main.rs", "", program).expect("write matching attach map")
        input :: frame("{{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{{\"adapterID\":\"jet\"}}}}") + frame("{{\"seq\":2,\"type\":\"request\",\"command\":\"attach\",\"arguments\":{{\"processId\":{pid},\"program\":\"{json_escape(program.to_string_lossy())}\",\"map\":\"{json_escape(map.to_string_lossy())}\"}}}}") + frame("{{\"seq\":3,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{{}}}}")
        server := test_server(.New)
        output := [U8]{}
        code :: run_io(&server, io.Cursor.new(input), &output)
        text :: String.from_utf8(^output).expect("DAP output is UTF-8")
        target_alive :: &target.try_wait().expect("check detached target") == None
        _ :: &target.kill()
        _ :: &target.wait()
        _ :: fs.remove_dir_all(root)
        assert_eq(code, ExitCodes.OK, text)
        assert(text.contains("\"command\":\"attach\""), text)
        assert(text.contains("\"command\":\"disconnect\""), text)
        assert(!text.contains("\"success\":false"), text)
        assert(target_alive, "disconnect must leave an attached target alive")
        assert_eq(server.state, .Terminated)
        assert(server.inf == None)
    }
}
