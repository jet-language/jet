    assert_eq(raw_frame, &refs.issue_raw_frame(1, 2))
    assert_eq(raw_scope, &refs.issue_scope(raw_frame, .RawScope))
    assert_eq(scope, &refs.issue_scope(frame, .Scope))
    value :: &refs.issue_value_at(location, "answer", false)
    assert_eq(value, &refs.issue_value_at(location, "answer", false))
}
// Rust: crates/jet-debug/src/Dap.rs:5293
#Test("continue_only_stops_at_requested_source_breakpoints") {
    server := test_server(.Stopped)
    assert_eq(&server.breakpoint_action(3), .Continue)
    server.pending_specs = [BreakpointSpec { line: 7, ..BreakpointSpec.default() }]
    server.client_breakpoint_ids = [42]
