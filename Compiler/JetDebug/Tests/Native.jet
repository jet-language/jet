    assert(first.text.contains("No code on prog.jet:40\n"))
    assert(first.text.contains("Breakpoint set  prog.jet:9\n"))
    assert(first.text.contains("Breakpoint hit  prog.jet:9  in run()"))
    assert(native_debug_hit_breakpoint(first.stop) != None)
    shown: session.command("locals", first.stop, "prog.jet", lines) ?? panic("locals: {err.detail}")
    assert(shown.text.contains("count: Int = 0\n"))
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

#Test("step_enters_a_call_finish_leaves_it_and_next_runs_over_it") {
    scratch: native_test_files.temp_dir("jet-debug-steps") ?? panic("scratch: {err}")
    root: scratch.path
    session := native_test_session(root, NATIVE_TEST_PROGRAM, [String]{"-O0"})
    lines: NATIVE_TEST_PROGRAM.split("\n").to_list()
    first: session.run_to([NativeBreak]{{file: "prog.jet", line: 9}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
    session.clear_breakpoints() ?? panic("clear: {err.detail}")
    entered: session.command("s", first.stop, "prog.jet", lines) ?? panic("step: {err.detail}")
    assert(entered.text.contains("2 |     y: x * 2        <- here\n"), entered.text)
    assert(entered.text.contains("Locals:  x = 0"), entered.text)
    inner: session.command("bt", entered.stop, "prog.jet", lines) ?? panic("bt: {err.detail}")
    assert_eq(inner.text, "#0  double()  at prog.jet:2\n#1  run()  at prog.jet:9\n")
    left: session.command("f", entered.stop, "prog.jet", lines) ?? panic("finish: {err.detail}")
    assert(left.text.contains("9 |         count += double(i)        <- here\n"), left.text)
    over: session.command("n", left.stop, "prog.jet", lines) ?? panic("next: {err.detail}")
    assert(over.stop.kind == NativeStopKind.Paused)
    line: (over.stop.frame ?? panic("next frame")).line
    assert(line == 8 || line == 9, "next stops at the loop or the call, not in double: {line}")
    rest: session.command("c", over.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(rest.text.contains("count 2\nProgram finished\n"), rest.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// A next over a call stops at a breakpoint in it; a next off a function's
// last line returns to its caller's line.
#Test("next_stops_at_a_breakpoint_in_its_call_and_returns_off_the_last_line") {
    scratch: native_test_files.temp_dir("jet-debug-next-return") ?? panic("scratch: {err}")
    root: scratch.path
    session := native_test_session(root, NATIVE_TEST_PROGRAM, [String]{"-O0"})
    lines: NATIVE_TEST_PROGRAM.split("\n").to_list()
    first: session.run_to([NativeBreak]{{file: "prog.jet", line: 9}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
    session.clear_breakpoints() ?? panic("clear: {err.detail}")
    if session.break_at("prog.jet", 3) == {
        .Ok(number) -> { assert_eq(number ?? -1, 2) }
        .Err(failure) -> panic("break: {failure.detail}")
    }
    hit: session.command("n", first.stop, "prog.jet", lines) ?? panic("next: {err.detail}")
    assert(hit.text.contains("3 |     y        <- here\n"), hit.text)
    assert(hit.text.contains("Breakpoint"), hit.text)
    session.clear_breakpoints() ?? panic("clear: {err.detail}")
    back: session.command("n", hit.stop, "prog.jet", lines) ?? panic("next: {err.detail}")
    assert(back.text.contains("9 |         count += double(i)        <- here\n"), back.text)
    rest: session.command("c", back.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(rest.text.contains("count 2\nProgram finished\n"), rest.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

#Test("next_runs_a_one_line_loop_whole_and_steps_over_recursion_in_its_frame") {
    scratch: native_test_files.temp_dir("jet-debug-next-loop") ?? panic("scratch: {err}")
    root: scratch.path
    session := native_test_session(root, NATIVE_TEST_LOOP, [String]{"-O0"})
    lines: NATIVE_TEST_LOOP.split("\n").to_list()
    first: session.run_to([NativeBreak]{{file: "prog.jet", line: 10}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
    assert(first.text.contains("Breakpoint hit  prog.jet:10  in run()"), first.text)
    session.clear_breakpoints() ?? panic("clear: {err.detail}")
    looped: session.command("n", first.stop, "prog.jet", lines) ?? panic("next: {err.detail}")
    assert(looped.text.contains("11 |     answer: fib(15 + total % 2)        <- here\n"), looped.text)
    assert(looped.text.contains("total = 4499998500000"), looped.text)
    if session.break_at("prog.jet", 3) == {
        .Ok(number) -> { assert_eq(number ?? -1, 2) }
        .Err(failure) -> panic("break: {failure.detail}")
    }
    called: session.command("c", looped.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(called.text.contains("3 |     left: fib(n - 1)        <- here\n"), called.text)
    session.clear_breakpoints() ?? panic("clear: {err.detail}")
    over: session.command("n", called.stop, "prog.jet", lines) ?? panic("next: {err.detail}")
    assert(over.text.contains("4 |     right: fib(n - 2)        <- here\n"), over.text)
    assert(over.text.contains("left = 377"), over.text)
    assert(over.text.contains("n = 15"), over.text)
    rest: session.command("c", over.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(rest.text.contains("4499998500000 610\nProgram finished\n"), rest.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// Two instances of one generic module: at O1 and O2 each instance's `bump`
// is inlined into `run`, two copies of one line.
NATIVE_TEST_GENERIC_MODULE: "use core.process\n\ncounter: module<T>(start: Int) {{\n    HITS: start\n\n    bump: fn(by: Int) -> Int {{\n        total := HITS + by\n        return total\n    }}\n}}\n\nsmall: counter<Int>(8)\n\nlarge: counter<Int>(64)\n\nrun: fn() {{\n    by: process.args().len() + 1\n    print(\"{{small.bump(by)}}\")\n    print(\"{{large.bump(by)}}\")\n}}\n"

#Test("a_generic_module_member_line_stops_in_each_inlined_instance") {
    levels: [String]{"-O1", "-O2"}
    loop level in levels {
        scratch: native_test_files.temp_dir("jet-debug-generic-module") ?? panic("scratch: {err}")
        root: scratch.path
        session := native_test_session(root, NATIVE_TEST_GENERIC_MODULE, [String]{level})
        lines: NATIVE_TEST_GENERIC_MODULE.split("\n").to_list()
        first: session.run_to([NativeBreak]{{file: "prog.jet", line: 7}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
        assert(first.text.contains("Breakpoint hit  prog.jet:7"), "{level}: {first.text}")
        shown: session.command("bt", first.stop, "prog.jet", lines) ?? panic("bt: {err.detail}")
        assert(shown.text.contains("run()  at prog.jet:18"), "{level}: {shown.text}")
        second: session.command("c", first.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
        assert(second.text.contains("Breakpoint hit  prog.jet:7"), "{level}: {second.text}")
        again: session.command("bt", second.stop, "prog.jet", lines) ?? panic("bt: {err.detail}")
        assert(again.text.contains("run()  at prog.jet:19"), "{level}: {again.text}")
        session.close()
        native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
    }
}
