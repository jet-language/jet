// The native debug session: LLDB's stop, frame and local reports read as Jet
// positions and values, and a real session over a program's O0 native image.
use {
    native_test_process :: core.process
    native_test_files :: core.files
    jet_debug.[NativeDebugError, NativeSession, NativeStopKind, native_debug_parse_frame, native_debug_parse_locals, native_debug_parse_stop]
}

#Test("frames_name_the_jet_function_file_and_line") {
    paused :: native_debug_parse_frame("    frame #0: 0x00000000004030e7 prog`double(x=1) at prog.jet:2") ?? panic("frame")
    assert_eq(paused.function, "double")
    assert_eq(paused.file, "prog.jet")
    assert_eq(paused.line, 2)
    selected :: native_debug_parse_frame("  * frame #1: 0x0000000000403120 prog`run at prog.jet:10:5") ?? panic("selected frame")
    assert_eq(selected.function, "run")
    assert_eq(selected.line, 10)
    start :: native_debug_parse_frame("    frame #3: 0x0000000000403200 prog`__jet_start + 70") ?? panic("start frame")
    assert_eq(start.function, "__jet_start")
    assert_eq(start.file, "")
    assert_eq(start.line, 0)
    assert(native_debug_parse_frame("(lldb) thread backtrace") == None)
}

#Test("stops_read_pauses_exits_and_signals") {
    paused :: native_debug_parse_stop("Process 7 stopped\n* thread #1, name = 'prog', stop reason = breakpoint 1.1\n    frame #0: 0x00000000004030e7 prog`run at prog.jet:10") ?? panic("pause")
    assert(paused.kind == NativeStopKind.Paused)
    assert_eq(paused.reason, "breakpoint 1.1")
    frame :: paused.frame ?? panic("pause frame")
    assert_eq(frame.line, 10)
    exited :: native_debug_parse_stop("Process 7 exited with status = 3 (0x00000003)") ?? panic("exit")
    assert(exited.kind == NativeStopKind.Exited)
    assert_eq(exited.code, 3)
    signaled :: native_debug_parse_stop("* thread #1, name = 'prog', stop reason = signal SIGSEGV: address not mapped") ?? panic("signal")
    assert(signaled.kind == NativeStopKind.Signaled)
    assert_eq(signaled.reason, "SIGSEGV")
    assert(native_debug_parse_stop("error: invalid process") == None)
}

#Test("locals_keep_only_values_the_image_describes") {
    locals :: native_debug_parse_locals("(long) count = 3\n(bool) ok = true\n(String) name = <extracting data from value failed>\n\n(void *) f = 0x00007ffff7f216d8")
    assert_eq(locals.len(), 4)
    assert_eq(locals[0].name, "count")
    assert_eq(locals[0].type_name, "Int")
    assert_eq(locals[0].value, "3")
    assert_eq(locals[1].type_name, "Bool")
    assert_eq(locals[1].value, "true")
    assert_eq(locals[2].type_name, "String")
    assert_eq(locals[2].value, "<unavailable>")
    assert_eq(locals[3].value, "<unavailable>")
}

#Test("an_unavailable_debugger_is_e2203") {
    diagnostic :: NativeDebugError{detail: "LLDB is not on PATH"}.diagnostic()
    assert_eq(diagnostic.code, "E2203")
    assert(diagnostic.what.contains("LLDB is not on PATH"))
}

// The checkout these tests run in: the program is built outside it, so the
// build names the toolchain sources explicitly.
fn native_test_toolchain_root() -> String Never! {
    dir := native_test_files.cwd() ?? panic("cwd: {err}")
    loop {
        if native_test_files.exists(native_test_files.join(dir, "Compiler/Prelude")) && native_test_files.exists(native_test_files.join(dir, "Core")) -> return dir
        parent :: native_test_files.dirname(dir)
        if parent == dir -> panic("the tests run outside a Jet checkout")
        dir = parent
    }
}

#Test("a_session_pauses_steps_and_reads_the_native_image") {
    jet :: native_test_process.which("jet") ?? panic("the Jet dev shell puts `jet` on PATH")
    scratch :: native_test_files.temp_dir("jet-debug-native") ?? panic("scratch: {err}")
    root :: scratch.path
    source :: native_test_files.join(root, "prog.jet")
    native_test_files.write(source, "fn double(x: Int) -> Int {{\n    y :: x * 2\n    y\n}}\n\nfn run() {{\n    count := 0\n    loop i in 0..<2 {{\n        count += double(i)\n    }}\n    print(\"count {{count}}\")\n}}\n") ?? panic("source: {err}")
    out :: native_test_files.join(root, "out")
    built :: native_test_process.cmd([String]{jet, "build", "--optimize=none", "--output-dir={out}", source}).env("JET_TOOLCHAIN_ROOT", native_test_toolchain_root()).stdout(.Capture).stderr(.Capture).run() ?? panic("jet build: {err}")
    if !built.success -> panic("jet build failed: {built.output}{built.errors}")
    session := NativeSession.start(native_test_files.join(out, "prog"), native_test_files.join(root, "output.txt")) ?? panic("start: {err.detail}")
    resolved :: &session.break_at("prog.jet", 2) ?? panic("break: {err.detail}")
    assert(resolved)
    paused :: &session.launch([String]{}) ?? panic("launch: {err.detail}")
    assert(paused.kind == NativeStopKind.Paused)
    frame :: paused.frame ?? panic("pause frame")
    assert_eq(frame.function, "double")
    assert_eq(frame.line, 2)
    locals :: &session.locals() ?? panic("locals: {err.detail}")
    assert_eq(locals[0].name, "x")
    assert_eq(locals[0].type_name, "Int")
    assert_eq(locals[0].value, "0")
    frames :: &session.backtrace() ?? panic("backtrace: {err.detail}")
    assert_eq(frames[1].function, "run")
    &session.clear_breakpoints() ?? panic("clear: {err.detail}")
    finished :: &session.continue_run() ?? panic("continue: {err.detail}")
    assert(finished.kind == NativeStopKind.Exited)
    assert_eq(finished.code, 0)
    assert_eq(&session.take_output(), "count 2\n")
    &session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}
