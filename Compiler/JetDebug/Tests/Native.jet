// An -O2 `run` that starts a task inlines into the entry wrapper.
NATIVE_TEST_INLINED_RUN: "work: fn(n: Int) -> Int {{\n    n * 2\n}}\n\nrun: fn() {{\n    t: task work(21)\n    print(\"got {{t.join() ?? 0}}\")\n}}\n"

#Test("an_o2_image_whose_run_is_inlined_opens_at_its_entry") {
    scratch: native_test_files.temp_dir("jet-debug-run-source") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_INLINED_RUN, [String]{"-O2"})
    named: loop found in session.image.lines.functions {
        if found.name == "run" {
            break true
        }
    } ?? false
    assert(!named, "run is inlined into the entry at -O2")
    assert_eq(native_test_files.basename(session.entry_source()), "prog.jet")
    // The image's `main` hands the run to the entry wrapper, which keeps run's
    // code inlined: the wrapper is the program's entry.
    assert(session.program_entry >= 0, "the image's main names its entry")
    assert_eq(session.image.lines.functions[session.program_entry].name, "entry")
    lines: NATIVE_TEST_INLINED_RUN.split("\n").to_list()
    first: session.open("prog.jet", lines, [String]{}) ?? panic("the entry wrapper opens the session")
    rest: session.command("c", first.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(rest.text.contains("got 42\nProgram finished\n"), rest.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// A `run` that can fail is run by a generated entry function (JetIR
// ir_entry_function), which the image's `main` hands the run to.
NATIVE_TEST_FALLIBLE_RUN: "run: fn() Err! {{\n    n: 21\n    print(\"got {{n * 2}}\")\n}}\n"

// The program's entry is the function its image's `main` runs, whatever
// it is named: through a generated entry function to the `run` it runs, so
// the session opens at run's first line, not in the wrapper.
#Test("a_session_opens_at_the_entry_its_image_runs") {
    scratch: native_test_files.temp_dir("jet-debug-entry") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_FALLIBLE_RUN, [String]{"-O0"})
    wrapped: loop found in session.image.lines.functions {
        if found.name == "entry" {
            break true
        }
    } ?? false
    assert(wrapped, "a fallible run is run by a generated entry function")
    assert(session.program_entry >= 0, "the image's main names its entry")
    assert_eq(session.image.lines.functions[session.program_entry].name, "run")
    assert_eq(native_test_files.basename(session.entry_source()), "prog.jet")
    lines: NATIVE_TEST_FALLIBLE_RUN.split("\n").to_list()
    first: session.open("prog.jet", lines, [String]{}) ?? panic("the session opens at the entry")
    assert(first.text.contains("in run()"), first.text)
    assert(first.text.contains("2 |     n: 21"), first.text)
    rest: session.command("c", first.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(rest.text.contains("got 42\nProgram finished\n"), rest.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

NATIVE_TEST_REVERSE: "double: fn(x: Int) -> Int {{\n    y: x * 2\n    y\n}}\n\nrun: fn() {{\n    ^total: 0\n    loop k in 0..<3 {{\n        d: double(k)\n        total += d\n    }}\n    print(\"total {{total}}\")\n}}\n"

// A reverse step made after a seek (`rn`) and a step (`n`) runs the seek
// and the step again with its probes in: the step's run passes the probes
// in the call as any run does, so the program comes back to the stop and
// the step goes back into the call's last line. A session with an
// environment reverses as a replay does; the program's main task runs the
// same each time.
#Test("a_reverse_step_after_a_seek_and_a_step_goes_into_the_call") {
    scratch: native_test_files.temp_dir("jet-debug-reverse") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_REVERSE, [String]{"-O0"})
    session.env = Val([String]{"NO_COLOR=1"})
    lines: NATIVE_TEST_REVERSE.split("\n").to_list()
    first: session.open("prog.jet", lines, [String]{}) ?? panic("the session opens at run")
    ^stop: first.stop
    ^shown: ""
    words: [String]{"break 10", "c", "rn", "n", "rs"}
    loop word in words {
        step: session.command(word, stop, "prog.jet", lines) ?? panic("{word}: {err.detail}")
        shown = step.text
        stop = step.stop
    }
    assert(shown.starts_with("3 |     y        <- here\n"), shown)
    rest: session.command("c", stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(rest.text.contains("Breakpoint hit  prog.jet:10"), rest.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// An -O0 frame holds its locals in registers: `why` follows `total`'s
// register through run's own code from the frame's start, so the third
// pass of line 10 names the write on the loop's second pass (the first
// added 0, which changed nothing), and the session comes back to its stop.
#Test("why_follows_a_local_held_in_a_register") {
    scratch: native_test_files.temp_dir("jet-debug-why-register") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_REVERSE, [String]{"-O0"})
    session.env = Val([String]{"NO_COLOR=1"})
    lines: NATIVE_TEST_REVERSE.split("\n").to_list()
    first: session.open("prog.jet", lines, [String]{}) ?? panic("the session opens at run")
    ^stop: first.stop
    words: [String]{"break 10", "c", "c", "c"}
    loop word in words {
        step: session.command(word, stop, "prog.jet", lines) ?? panic("{word}: {err.detail}")
        stop = step.stop
    }
    asked: session.command("why total", stop, "prog.jet", lines) ?? panic("why: {err.detail}")
    assert(asked.text.starts_with("total = 2, set at prog.jet:10 in run() (task 1)\n  before: 0\n  #0  run()  at prog.jet:10\n"), asked.text)
    bound: session.command("why k", stop, "prog.jet", lines) ?? panic("why: {err.detail}")
    assert(bound.text.starts_with("k = 2, set at prog.jet:8 in run() (task 1)\n"), bound.text)
    // Each pass binds `d` again, from outside its register's range.
    again: session.command("why d", stop, "prog.jet", lines) ?? panic("why: {err.detail}")
    assert(again.text.starts_with("d = 4, set at prog.jet:9 in run() (task 1)\n  before: none: this line binds it\n"), again.text)
    rest: session.command("c", stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(rest.text.contains("total 6\nProgram finished\n"), rest.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// A task keeps the -O2 loop from folding away. `double` is inlined into
// `run`, and `d` lives in the register that holds the inlined `y` from line
// 15 to its last read on line 16; on line 17 it has no value.
NATIVE_TEST_RECOVER: "bump: fn(rounds: Int) -> Int {{\n    rounds * 2\n}}\n\ndouble: fn(x: Int) -> Int {{\n    y: x * 2\n    y\n}}\n\nrun: fn() {{\n    helper: task bump(3)\n    ^total: 0\n    ^passes: 0\n    loop k in 0..<3 {{\n        d: double(k)\n        total += d\n        passes += k\n    }}\n    print(\"total {{total}} {{passes}} {{helper.join() ?? 0}}\")\n}}\n"

// An -O2 image keeps no place for `d` on line 17, past its last read: `why`
// asks for a recovery, and the -O0 image of the same source, run to the
// same pass of the line, answers there, labeled; the -O2 session stays at
// its stop.
#Test("why_recovers_an_optimized_away_local_from_the_o0_image") {
    scratch: native_test_files.temp_dir("jet-debug-why-recover") ?? panic("scratch: {err}")
    root: scratch.path
    other: native_test_files.temp_dir("jet-debug-why-recover-o0") ?? panic("scratch: {err}")
    unoptimized: other.path
    ^built: native_test_session(unoptimized, NATIVE_TEST_RECOVER, [String]{"-O0", "--dead-code=keep"})
    built.close()
    ^session: native_test_session(root, NATIVE_TEST_RECOVER, [String]{"-O2"})
    session.env = Val([String]{"NO_COLOR=1"})
    lines: NATIVE_TEST_RECOVER.split("\n").to_list()
    first: session.run_to([NativeBreak]{{file: "prog.jet", line: 17}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
    second: session.command("c", first.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    asked: session.why("d") ?? panic("why: {err.detail}")
    assert(asked.recover, asked.text)
    image: native_test_files.join(native_test_files.join(unoptimized, "out"), "prog")
    recovered: session.recovered("d", image, native_test_files.join(root, "recovered.txt")) ?? panic("recovered: {err.detail}")
    assert(recovered.starts_with("d = 2 (recovered from the -O0 replay), set at prog.jet:15 in run() (task 1)\n"), recovered)
    rest: session.command("c", second.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(rest.text.contains("Breakpoint hit  prog.jet:17"), rest.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
    native_test_files.remove_all(unoptimized) ?? panic("scratch cleanup: {err}")
}

// On line 16 the -O2 image holds `d` in the register the inlined `double`
// wrote on line 6. `why` names the write where -O0 does: line 15 of `run`,
// the frame it was asked in, which binds `d`; the inlined callee's frame is
// not the local's.
#Test("why_names_the_line_that_binds_a_local_an_inlined_call_wrote") {
    scratch: native_test_files.temp_dir("jet-debug-why-inlined") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_RECOVER, [String]{"-O2"})
    session.env = Val([String]{"NO_COLOR=1"})
    lines: NATIVE_TEST_RECOVER.split("\n").to_list()
    first: session.run_to([NativeBreak]{{file: "prog.jet", line: 16}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
    second: session.command("c", first.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    asked: session.why("d") ?? panic("why: {err.detail}")
    assert(!asked.recover, asked.text)
    assert(asked.text.starts_with("d = 2, set at prog.jet:15 in run() (task 1)\n  before: none: this line binds it\n  #0  run()  at prog.jet:15"), asked.text)
    assert(!asked.text.contains("double()"), asked.text)
    rest: session.command("c", second.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(rest.text.contains("Breakpoint hit  prog.jet:16"), rest.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

#Test("a_split_debug_image_is_read_through_its_debug_link") {
    scratch: native_test_files.temp_dir("jet-debug-split") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_SPLIT, [String]{"-O2", "--debug-info=split"})
    ^resolved: -1
    if session.break_at("prog.jet", 3) == {
        .Ok(number) -> { resolved = number ?? -1 }
        .Err(failure) -> panic("break: {failure.detail}")
    }
    assert_eq(resolved, 1)
    session.close()
    // The name beside the image is the symbol store's file by a second
    // name, no symbolic link: the store's file the image's build id names,
    // in its directory or one above it, is the same file (or, where the file
    // system has no hard links, its same bytes). The build id finds it
    // without that name; with neither, the report names the file the link
    // asks for.
    linked: native_test_files.join(root, "out/prog.debug")
    beside: native_test_files.stat(linked) ?? panic("the side file beside the image: {err}")
    assert(beside.is_file && !beside.is_symlink, "{linked} is a file, no symbolic link")
    image: native_test_files.read_bytes(native_test_files.join(root, "out/prog")) ?? panic("read the image: {err}")
    id: native_build_id(image)
    assert(id.len() > 1, "the image has a build id")
    named: ".jet/symbols/.build-id/{native_test_hex.encode(id[0..<1])}/{native_test_hex.encode(id[1..<id.len()])}.debug"
    ^stored: ""
    ^directory: native_test_files.join(root, "out")
    loop {
        place: native_test_files.join(directory, named)
        if native_test_files.exists(place) {
            stored = place
            break
        }
        above: native_test_files.dirname(directory)
        if above == directory -> break
        directory = above
    }
    assert(stored != "", "the store holds the side file under the image's build id")
    kept: native_test_files.stat(stored) ?? panic("the stored side file: {err}")
    if kept.id != beside.id {
        assert_eq(native_test_files.read_bytes(linked) ?? panic("read: {err}"), native_test_files.read_bytes(stored) ?? panic("read: {err}"))
    }
    native_test_files.remove(linked) ?? panic("unlink: {err}")
    ^by_id: NativeSession.start(native_test_files.join(root, "out/prog"), native_test_files.join(root, "output.txt")) ?? panic("start from the store: {err.detail}")
    by_id.close()
    native_test_files.remove(stored) ?? panic("unlink the stored file: {err}")
    if NativeSession.start(native_test_files.join(root, "out/prog"), native_test_files.join(root, "output.txt")) == {
        .Ok(_) -> { panic("an image with no debug information started") }
        .Err(failure) -> {
            assert(failure.detail.contains("keeps its DWARF in `prog.debug`, which is not beside it"), failure.detail)
        }
    }
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// An image whose DWARF moved to a side file after its link, as the
// compiler's own does (JetBackend x64_executable_debug_apart): it keeps its
// line table and reads its locals from the side file beside it, or from the
// build-id store above it; a side file that is another build's, or none,
// is refused by name.
#Test("an_image_with_its_dwarf_apart_shows_locals_from_the_side_file") {
    scratch: native_test_files.temp_dir("jet-debug-apart") ?? panic("scratch: {err}")
    root: scratch.path
    ^built: native_test_session(root, NATIVE_TEST_PROGRAM, [String]{"-O0"})
    built.close()
    whole: native_test_files.read_bytes(native_test_files.join(root, "out/prog")) ?? panic("read: {err}")
    apart: x64_executable_debug_apart(whole, "apart.debug", compiler_threads_single()) ?? panic("apart: {err:Debug}")
    binary: native_test_files.join(root, "out/apart")
    side: native_test_files.join(root, "out/apart.debug")
    native_test_files.write_bytes(binary, apart.bytes) ?? panic("write: {err}")
    native_test_files.set_mode(binary, 493) ?? panic("mode: {err}")
    native_test_files.write_bytes(side, apart.debug_file) ?? panic("write side: {err}")
    output: native_test_files.join(root, "output.txt")
    ^session: NativeSession.start(binary, output) ?? panic("start: {err.detail}")
    ^resolved: -1
    if session.break_at("prog.jet", 2) == {
        .Ok(number) -> { resolved = number ?? -1 }
        .Err(failure) -> panic("break: {failure.detail}")
    }
    assert_eq(resolved, 1)
    paused: session.launch([String]{}) ?? panic("launch: {err.detail}")
    frame: paused.frame ?? panic("pause frame")
    assert_eq(frame.function, "double")
    locals: session.locals() ?? panic("locals: {err.detail}")
    assert_eq(locals[0].name, "x")
    assert_eq(locals[0].type_name, "Int")
    assert_eq(locals[0].value, "0")
    frames: session.backtrace() ?? panic("backtrace: {err.detail}")
    assert_eq(frames[1].function, "run")
    assert_eq(frames[1].line, 9)
    session.close()
    // Another build's side file under the name is refused by its CRC-32.
    ^other: native_test_files.read_bytes(side) ?? panic("read side: {err}")
    other[other.len() - 1] = U8{Int{other[other.len() - 1]} ~ 1}
    native_test_files.write_bytes(side, other) ?? panic("write other: {err}")
    if NativeSession.start(binary, output) == {
        .Ok(_) -> { panic("an image started with another build's side file") }
        .Err(failure) -> {
            assert(failure.detail.contains("apart.debug` is not the debug file of"), failure.detail)
            assert(failure.detail.contains("its CRC-32 is"), failure.detail)
        }
    }
    native_test_files.remove(side) ?? panic("unlink: {err}")
    if NativeSession.start(binary, output) == {
        .Ok(_) -> { panic("an image started without its side file") }
        .Err(failure) -> {
            assert(failure.detail.contains("keeps its DWARF in `apart.debug`, which is not beside it"), failure.detail)
        }
    }
    // The build-id store above the image holds it too.
    id: apart.build_id
    store: native_test_files.join(root, ".jet/symbols/.build-id/{native_test_hex.encode(id[0..<1])}")
    native_test_files.create_dir_all(store) ?? panic("store: {err}")
    native_test_files.write_bytes(native_test_files.join(store, "{native_test_hex.encode(id[1..<id.len()])}.debug"), apart.debug_file) ?? panic("write stored: {err}")
    ^stored: NativeSession.start(binary, output) ?? panic("start from the store: {err.detail}")
    stored.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

#Test("run_to_stops_first_at_the_first_breakpoint_reached") {
    scratch: native_test_files.temp_dir("jet-debug-run-to") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_PROGRAM, [String]{"-O0"})
    lines: NATIVE_TEST_PROGRAM.split("\n").to_list()
    first: session.run_to([NativeBreak]{{file: "prog.jet", line: 40}, {file: "prog.jet", line: 9}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
    assert(first.text.contains("No code on prog.jet:40\n"))
    assert(first.text.contains("Breakpoint set  prog.jet:9\n"))
    assert(first.text.contains("Breakpoint hit  prog.jet:9  in run()"))
    assert(native_debug_hit_breakpoint(first.stop) != None)
    shown: session.command("locals", first.stop, "prog.jet", lines) ?? panic("locals: {err.detail}")
    assert(shown.text.contains("count: Int = 0\n"))
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// `disas` at a breakpoint lists the stopped function under its source
// lines, the pc and the breakpoint marked on the program's own bytes (no
// trap byte), its call named; a name, a line and --bytes pick and widen the
// listing, and what names no code is answered as `break` answers it.
#Test("disassemble_lists_the_stopped_function_with_its_stop_and_breakpoint") {
    scratch: native_test_files.temp_dir("jet-debug-disas") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_PROGRAM, [String]{"-O0"})
    lines: NATIVE_TEST_PROGRAM.split("\n").to_list()
    first: session.run_to([NativeBreak]{{file: "prog.jet", line: 9}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
    listed: session.command("disas", first.stop, "prog.jet", lines) ?? panic("disas: {err.detail}")
    assert(listed.text.starts_with("run  prog.jet:"), listed.text)
    assert(listed.text.contains("  -O0  0x"), listed.text)
    assert(listed.text.contains("prog.jet:9   count += double(i)\n   b1  0x"), listed.text)
    assert(listed.text.contains("        <- here\n"), listed.text)
    assert(listed.text.contains(" <double>\n"), listed.text)
    assert(!listed.text.contains("int3"), listed.text)
    named: session.command("disassemble double", first.stop, "prog.jet", lines) ?? panic("disassemble: {err.detail}")
    assert(named.text.starts_with("double  prog.jet:"), named.text)
    assert(named.text.contains("prog.jet:2   y: x * 2\n"), named.text)
    assert(!named.text.contains("<- here"), named.text)
    line: session.command("disas --bytes prog.jet:9", first.stop, "prog.jet", lines) ?? panic("disas line: {err.detail}")
    assert(line.text.contains("prog.jet:9   count += double(i)\n"), line.text)
    assert(!line.text.contains("prog.jet:7 "), line.text)
    assert(line.text.contains(" e8 "), line.text)
    routine: session.command("disas jet_int_add", first.stop, "prog.jet", lines) ?? panic("disas routine: {err.detail}")
    assert(routine.text.starts_with("jet_int_add  0x"), routine.text)
    assert(routine.text.contains("\n       0x"), routine.text)
    nothing: session.command("disas nope", first.stop, "prog.jet", lines) ?? panic("disas nope: {err.detail}")
    assert_eq(nothing.text, "No function `nope`\n")
    far: session.command("disas prog.jet:40", first.stop, "prog.jet", lines) ?? panic("disas far: {err.detail}")
    assert_eq(far.text, "No code on prog.jet:40\n")
    session.clear_breakpoints() ?? panic("clear: {err.detail}")
    rest: session.command("c", first.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(rest.text.contains("count 2\nProgram finished\n"), rest.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

#Test("step_enters_a_call_finish_leaves_it_and_next_runs_over_it") {
    scratch: native_test_files.temp_dir("jet-debug-steps") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_PROGRAM, [String]{"-O0"})
    lines: NATIVE_TEST_PROGRAM.split("\n").to_list()
    first: session.run_to([NativeBreak]{{file: "prog.jet", line: 9}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
    session.clear_breakpoints() ?? panic("clear: {err.detail}")
    entered: session.command("s", first.stop, "prog.jet", lines) ?? panic("step: {err.detail}")
    assert(entered.text.contains("2 |     y: x * 2        <- here\n"), entered.text)
    assert(entered.text.contains("Locals:  x = 0"), entered.text)
    inner: session.command("bt", entered.stop, "prog.jet", lines) ?? panic("bt: {err.detail}")
    assert_eq(inner.text, "#0  double()  at prog.jet:2\n#1  run()  at prog.jet:9\n")
    left: session.command("f", entered.stop, "prog.jet", lines) ?? panic("finish: {err.detail}")
    assert(left.text.contains("9 |         count += double(i)        <- here\n"), left.text)
    over: session.command("n", left.stop, "prog.jet", lines) ?? panic("next: {err.detail}")
    assert(over.stop.kind == NativeStopKind.Paused)
    line: (over.stop.frame ?? panic("next frame")).line
    assert(line == 8 || line == 9, "next stops at the loop or the call, not in double: {line}")
    rest: session.command("c", over.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(rest.text.contains("count 2\nProgram finished\n"), rest.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// A next over a call stops at a breakpoint in it; a next off a function's
// last line returns to its caller's line.
#Test("next_stops_at_a_breakpoint_in_its_call_and_returns_off_the_last_line") {
    scratch: native_test_files.temp_dir("jet-debug-next-return") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_PROGRAM, [String]{"-O0"})
    lines: NATIVE_TEST_PROGRAM.split("\n").to_list()
    first: session.run_to([NativeBreak]{{file: "prog.jet", line: 9}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
    session.clear_breakpoints() ?? panic("clear: {err.detail}")
    if session.break_at("prog.jet", 3) == {
        .Ok(number) -> { assert_eq(number ?? -1, 2) }
        .Err(failure) -> panic("break: {failure.detail}")
    }
    hit: session.command("n", first.stop, "prog.jet", lines) ?? panic("next: {err.detail}")
    assert(hit.text.contains("3 |     y        <- here\n"), hit.text)
    assert(hit.text.contains("Breakpoint"), hit.text)
    session.clear_breakpoints() ?? panic("clear: {err.detail}")
    back: session.command("n", hit.stop, "prog.jet", lines) ?? panic("next: {err.detail}")
    assert(back.text.contains("9 |         count += double(i)        <- here\n"), back.text)
    rest: session.command("c", back.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(rest.text.contains("count 2\nProgram finished\n"), rest.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

#Test("next_runs_a_one_line_loop_whole_and_steps_over_recursion_in_its_frame") {
    scratch: native_test_files.temp_dir("jet-debug-next-loop") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_LOOP, [String]{"-O0"})
    lines: NATIVE_TEST_LOOP.split("\n").to_list()
    first: session.run_to([NativeBreak]{{file: "prog.jet", line: 10}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
    assert(first.text.contains("Breakpoint hit  prog.jet:10  in run()"), first.text)
    session.clear_breakpoints() ?? panic("clear: {err.detail}")
    looped: session.command("n", first.stop, "prog.jet", lines) ?? panic("next: {err.detail}")
    assert(looped.text.contains("11 |     answer: fib(15 + total % 2)        <- here\n"), looped.text)
    assert(looped.text.contains("total = 4499998500000"), looped.text)
    if session.break_at("prog.jet", 3) == {
        .Ok(number) -> { assert_eq(number ?? -1, 2) }
        .Err(failure) -> panic("break: {failure.detail}")
    }
    called: session.command("c", looped.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(called.text.contains("3 |     left: fib(n - 1)        <- here\n"), called.text)
    session.clear_breakpoints() ?? panic("clear: {err.detail}")
    over: session.command("n", called.stop, "prog.jet", lines) ?? panic("next: {err.detail}")
    assert(over.text.contains("4 |     right: fib(n - 2)        <- here\n"), over.text)
    assert(over.text.contains("left = 377"), over.text)
    assert(over.text.contains("n = 15"), over.text)
    rest: session.command("c", over.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(rest.text.contains("4499998500000 610\nProgram finished\n"), rest.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// Two instances of one generic module: at O1 and O2 each instance's `bump`
// is inlined into `run`, two copies of one line.
NATIVE_TEST_GENERIC_MODULE: "use core.process\n\ncounter: module<T>(start: Int) {{\n    HITS: start\n\n    bump: fn(by: Int) -> Int {{\n        ^total: HITS + by\n        return total\n    }}\n}}\n\nsmall: counter<Int>(8)\n\nlarge: counter<Int>(64)\n\nrun: fn() {{\n    by: process.args().len() + 1\n    print(\"{{small.bump(by)}}\")\n    print(\"{{large.bump(by)}}\")\n}}\n"

#Test("a_generic_module_member_line_stops_in_each_inlined_instance") {
    levels: [String]{"-O1", "-O2"}
    loop level in levels {
        scratch: native_test_files.temp_dir("jet-debug-generic-module") ?? panic("scratch: {err}")
        root: scratch.path
        ^session: native_test_session(root, NATIVE_TEST_GENERIC_MODULE, [String]{level})
        lines: NATIVE_TEST_GENERIC_MODULE.split("\n").to_list()
        first: session.run_to([NativeBreak]{{file: "prog.jet", line: 7}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
        assert(first.text.contains("Breakpoint hit  prog.jet:7"), "{level}: {first.text}")
        shown: session.command("bt", first.stop, "prog.jet", lines) ?? panic("bt: {err.detail}")
        assert(shown.text.contains("run()  at prog.jet:18"), "{level}: {shown.text}")
        second: session.command("c", first.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
        assert(second.text.contains("Breakpoint hit  prog.jet:7"), "{level}: {second.text}")
        again: session.command("bt", second.stop, "prog.jet", lines) ?? panic("bt: {err.detail}")
        assert(again.text.contains("run()  at prog.jet:19"), "{level}: {again.text}")
        session.close()
        native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
    }
}

// The compiler's shape: a worker thread of a task group, with tasks busy on
// other threads, ends the program with a stop's status, 70, while the main
// thread waits for it, so the exit kills the main thread before the
// worker's own exit stop.
NATIVE_TEST_WORKER_EXIT: "use process: core.process\n\nhalf: fn(n: Int) -> Int {{\n    n /% 2\n}}\n\nspin: fn(n: Int) -> Int {{\n    ^total: 0\n    loop i in 0..<n -> total += i\n    total\n}}\n\nwork: fn(n: Int) -> Int {{\n    loop k in 0..<3 {{\n        spinning: task spin(1000000000 + k)\n        spinning.detach()\n    }}\n    ^total: 0\n    loop i in 0..<n -> total += half(i)\n    print(\"total {{total}}\")\n    process.exit(70)\n    total\n}}\n\nrun: fn() {{\n    ^results: [Int]{{}}\n    task.group big(stack: 201326592) {{\n        worker: task work(7)\n        results.push(worker.join() ?? panic(\"the worker failed\"))\n    }}\n    print(\"{{results[0]}}\")\n}}\n"

#Test("a_worker_s_stopping_exit_pauses_and_ends_after_its_breakpoint_is_deleted") {
    scratch: native_test_files.temp_dir("jet-debug-worker-exit") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_WORKER_EXIT, [String]{"-O0"})
    lines: NATIVE_TEST_WORKER_EXIT.split("\n").to_list()
    first: session.run_to([NativeBreak]{{file: "prog.jet", line: 4}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
    assert(first.text.contains("Breakpoint hit  prog.jet:4  in half()"), first.text)
    deleted: session.command("delete 1", first.stop, "prog.jet", lines) ?? panic("delete: {err.detail}")
    exiting: session.command("c", deleted.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(exiting.text.contains("Program exiting with status 70"), exiting.text)
    shown: session.command("bt", exiting.stop, "prog.jet", lines) ?? panic("bt: {err.detail}")
    assert(shown.text.contains("work()  at prog.jet:21"), shown.text)
    ended: session.command("c", exiting.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(ended.text.contains("Program finished with exit status 70"), ended.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// Recursion without end: the call that runs past the stack's guard page
// faults (SIGSEGV), which the runtime's fault handler reports as the
// stack overflow stop E3012, ending the program with status 70.
NATIVE_TEST_OVERFLOW: "depth: fn(n: Int) -> Int {{\n    if n == 0 -> return 0\n    1 + depth(n - 1)\n}}\n\nrun: fn() {{\n    print(\"{{depth(1000000000)}}\")\n}}\n"

#Test("a_fault_stops_like_a_breakpoint_and_continuing_delivers_it") {
    scratch: native_test_files.temp_dir("jet-debug-fault") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_OVERFLOW, [String]{"-O0"})
    lines: NATIVE_TEST_OVERFLOW.split("\n").to_list()
    first: session.run_to([NativeBreak]{{file: "prog.jet", line: 7}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
    assert(first.text.contains("Breakpoint hit  prog.jet:7  in run()"), first.text)
    // The fault stops the program before its signal reaches it, in the
    // function that faulted, with the stack whole.
    faulted: session.command("c", first.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(faulted.text.contains("Program received SIGSEGV  prog.jet:1  in depth()\n  fault address 0x"), faulted.text)
    assert(faulted.text.contains(" <depth+"), faulted.text)
    assert(!faulted.text.contains("Program stopped by"), faulted.text)
    shown: session.command("bt", faulted.stop, "prog.jet", lines) ?? panic("bt: {err.detail}")
    assert(shown.text.starts_with("#0  depth()  at prog.jet:1\n#1  depth()  at prog.jet:3\n"), shown.text)
    tasks: session.command("tasks", faulted.stop, "prog.jet", lines) ?? panic("tasks: {err.detail}")
    assert(tasks.text.contains("#0  depth()  at prog.jet:1"), tasks.text)
    locals: session.command("locals", faulted.stop, "prog.jet", lines) ?? panic("locals: {err.detail}")
    assert(locals.text.starts_with("n: Int = "), locals.text)
    listed: session.command("disas", faulted.stop, "prog.jet", lines) ?? panic("disas: {err.detail}")
    assert(listed.text.starts_with("depth  prog.jet:1-"), listed.text)
    // Continuing delivers the signal: the runtime's report of the stack
    // overflow ends the program with the stop's status, 70.
    ended: session.command("c", faulted.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(ended.text.contains("Stop: Jet.StackOverflow: Stack overflow in `depth`"), ended.text)
    assert(ended.text.contains("Program finished with exit status 70"), ended.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// A SIGSEGV the program sends itself stops as a fault does; continuing
// runs the runtime's fault report, whose re-raise of the signal ends the
// program unstopped.
NATIVE_TEST_SIGNALED: "use sys: core.sys\n\ncrash: fn(n: Int) -> Int {{\n    #Unsafe(\"the program sends itself SIGSEGV, as a fault would\") {{\n        sys.kill(sys.pid(), 11) ?? panic(\"the kill failed\")\n    }}\n    n\n}}\n\nrun: fn() {{\n    print(\"{{crash(4)}}\")\n}}\n"

#Test("a_fault_s_report_after_its_stop_ends_the_program_by_its_signal") {
    scratch: native_test_files.temp_dir("jet-debug-fault-report") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_SIGNALED, [String]{"-O0"})
    lines: NATIVE_TEST_SIGNALED.split("\n").to_list()
    first: session.run_to([NativeBreak]{{file: "prog.jet", line: 11}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
    assert(first.text.contains("Breakpoint hit  prog.jet:11  in run()"), first.text)
    faulted: session.command("c", first.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(faulted.text.contains("Program received SIGSEGV  "), faulted.text)
    // A signal a process sent names no address: the stop names the pc.
    assert(faulted.text.contains("\n  pc 0x") && !faulted.text.contains("fault address"), faulted.text)
    shown: session.command("bt", faulted.stop, "prog.jet", lines) ?? panic("bt: {err.detail}")
    assert(shown.text.contains("crash()  at prog.jet:5\n"), shown.text)
    assert(shown.text.contains("run()  at prog.jet:11\n"), shown.text)
    ended: session.command("c", faulted.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(ended.text.contains("Fault [SIGSEGV]"), ended.text)
    assert(ended.text.contains("Program stopped by SIGSEGV"), ended.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// A copy the runtime makes from an address the program never mapped
// (mem.list_append from 0x40; a release build, so no checked access stops
// it first) faults inside the runtime's copy routine.
NATIVE_TEST_RUNTIME_FAULT: "use mem: core.mem\n\nspill: fn(address: Int, count: Int) -> Int {{\n    ^held: [U8]{{}}\n    #Unsafe(\"the program copies from an address it never mapped, to fault\") {{\n        ^_: mem.list_append(held, mem.from_addr<U8>(address), count)\n    }}\n    held.len()\n}}\n\nrun: fn() {{\n    print(\"before the fault\")\n    print(spill(64, 100000))\n}}\n"

#Test("a_fault_inside_a_runtime_routine_shows_the_routines_the_instruction_and_the_address") {
    scratch: native_test_files.temp_dir("jet-debug-runtime-fault") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_RUNTIME_FAULT, [String]{"--release", "--debug-info=true"})
    lines: NATIVE_TEST_RUNTIME_FAULT.split("\n").to_list()
    first: session.run_to([NativeBreak]{{file: "prog.jet", line: 12}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
    assert(first.text.contains("Breakpoint hit  prog.jet:12  in run()"), first.text)
    // The stop stays on the user's line, names the routine it is in and
    // the faulting pc, instruction and address.
    faulted: session.command("c", first.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(faulted.text.contains("Program received SIGSEGV  prog.jet:6  in spill()\n  through jet_rt_mem_move\n  fault address 0x40  pc 0x"), faulted.text)
    assert(faulted.text.contains(" <jet_rt_mem_move+"), faulted.text)
    assert(faulted.text.contains("6 |         ^_: mem.list_append(held, mem.from_addr<U8>(address), count)        <- here\n"), faulted.text)
    // `bt` lists the routine's frame above the user's frames, numbered
    // with them.
    shown: session.command("bt", faulted.stop, "prog.jet", lines) ?? panic("bt: {err.detail}")
    assert(shown.text.starts_with("#0  jet_rt_mem_move  at 0x"), shown.text)
    assert(shown.text.contains("\n#1  spill()  at prog.jet:6"), shown.text)
    assert(shown.text.contains("  run()  at prog.jet:13"), shown.text)
    // It is a frame `frame`, `up` and `down` select: below the stop's
    // frame is the routine, at the instruction that faulted.
    routine: session.command("down", faulted.stop, "prog.jet", lines) ?? panic("down: {err.detail}")
    assert(routine.text.starts_with("#0  jet_rt_mem_move  at 0x"), routine.text)
    assert(routine.text.contains(" <jet_rt_mem_move+"), routine.text)
    back: session.command("frame 1", faulted.stop, "prog.jet", lines) ?? panic("frame 1: {err.detail}")
    assert(back.text.starts_with("#1  spill()  at prog.jet:6\n"), back.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// A run nested in another names that run's function as its caller, and the
// function holding its code after it; a call in another file than that
// function's names its file.
#Test("an_inlined_run_names_its_own_caller_and_its_call_s_file") {
    runs: [NativeInlined]{
        NativeInlined{die: 10, origin: 1, low: 0x100, high: 0x180, call_line: 16, parent: -1, file: 1, call_file: 1, call_path: "prog.jet"},
        NativeInlined{die: 20, origin: 2, low: 0x120, high: 0x140, call_line: 8, parent: 0, file: 1, call_file: 1, call_path: "prog.jet"},
        NativeInlined{die: 30, origin: 3, low: 0x190, high: 0x1a0, call_line: 15, parent: -1, file: 2, call_file: 1, call_path: "prog.jet"},
        NativeInlined{die: 40, origin: 4, low: 0x194, high: 0x19c, call_line: 172, parent: 2, file: 2, call_file: 2, call_path: "<corelib>/Core/Process/Process.jet"},
    }
    function: NativeFunction{low: 0x80, high: 0x200, name: "run", file: 1, variables: [NativeVariable]{}, inlined: runs}
    ^abstracts: [Int:NativeAbstract]{}
    abstracts[1] = NativeAbstract{name: "sum_squares", file: 1}
    abstracts[2] = NativeAbstract{name: "square", file: 1}
    abstracts[3] = NativeAbstract{name: "args", file: 2}
    abstracts[4] = NativeAbstract{name: "args_from_argv", file: 2}
    image: NativeImage{lines: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, functions: [NativeFunction]{}, types: [Int:NativeType]{}, members: [[NativeMember]]{}, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: [U8]{}, abstracts: abstracts, allocs: [Int:Int]{}}
    assert_eq(native_listing_caller(image, function, 0), "run on line 16")
    assert_eq(native_listing_caller(image, function, 1), "sum_squares on line 8 in run")
    assert_eq(native_listing_caller(image, function, 3), "args on line 172 of Process.jet in run")
    assert_eq(native_listing_call_line(function, 2), "line 15")
    assert_eq(native_listing_call_line(function, 3), "line 172 of Process.jet")
}

// `square` (line 3) inlined into `sum_squares`, called on line 8, which is
// inlined into `run`, called on line 16; at -O2 Core's `args_from_argv`
// is inlined into `args`, which calls it in Process.jet.
NATIVE_TEST_NESTED: "use process: core.process\n\nsquare: fn(i: Int) -> Int {{ i * i }}\n\nsum_squares: fn(n: Int) -> Int {{\n    ^total: 0\n    loop i in 0..<n {{\n        sq: square(i)\n        total += sq\n    }}\n    total\n}}\n\nrun: fn() {{\n    n: Int.parse(process.args().get(0) ?? \"1000\") ?? 1000\n    print(\"{{sum_squares(n)}}\")\n}}\n"

#Test("disas_names_a_nested_inlined_run_s_caller_and_a_call_s_file") {
    lines: NATIVE_TEST_NESTED.split("\n").to_list()
    loop level in ([String]{"-O1", "-O2"}) {
        scratch: native_test_files.temp_dir("jet-debug-nested") ?? panic("scratch: {err}")
        root: scratch.path
        ^session: native_test_session(root, NATIVE_TEST_NESTED, [String]{level})
        stop: session.run_to([NativeBreak]{{file: "prog.jet", line: 3}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
        assert(stop.text.contains("Breakpoint hit  prog.jet:3  in square()"), "{level}: {stop.text}")
        listed: session.command("disas", stop.stop, "prog.jet", lines) ?? panic("disas: {err.detail}")
        assert(listed.text.contains("  inlined sum_squares, called on line 16\n"), "{level}: {listed.text}")
        assert(listed.text.contains("  inlined square, called on line 8\n"), "{level}: {listed.text}")
        if level == "-O2" {
            assert(listed.text.contains("  inlined args_from_argv, called on line ") && listed.text.contains(" of Process.jet\n"), listed.text)
        }
        named: session.command("disas square", stop.stop, "prog.jet", lines) ?? panic("disas square: {err.detail}")
        assert(named.text.starts_with("square, inlined into sum_squares on line 8 in run  prog.jet:3  {level}  0x"), "{level}: {named.text}")
        session.close()
        native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
    }
}
