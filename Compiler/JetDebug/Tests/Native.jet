// The native debug session: values read from a stopped program's memory as
// Jet values, and a real session over a program's O0 native image, run and
// stopped by Jet's own debugger.
use {
    native_test_process: core.process
    native_test_files: core.files
    native_test_hex: core.encoding.hex
    jet_debug.[NATIVE_CFI_RETURN, NATIVE_CFI_SAME, NATIVE_CFI_SAVED, NATIVE_DEBUG_CUT_OFF, NATIVE_DEBUG_NOT_KEPT, NATIVE_DEBUG_UNAVAILABLE, NativeAbstract, NativeBlock, NativeBreak, NativeCallArgument, NativeCode, NativeCut, NativeDebugError, NativeEnumerator, NativeFde, NativeFrame, NativeFrames, NativeFunction, NativeImage, NativeInlined, NativeLocal, NativeMember, NativeMemory, NativeSession, NativeStop, NativeStopKind, NativeType, NativeUnwound, NativeVariable, NativeVariableRole, NativeVariants, native_build_id, native_cfi_row, native_debug_backtrace, native_debug_backtrace_count, native_debug_build_argv, native_debug_decimal_text, native_debug_hit_breakpoint, native_debug_int, native_debug_locals_typed, native_debug_precise, native_debug_string, native_debug_unbound, native_frame_locals, native_frames_index, native_function_at, native_inline_chain, native_jet_spelling, native_line_addresses, native_listing_call_line, native_listing_caller]
    jet_backend.[X64DebugEncoding, X64Jetline, X64JetlineFunction, X64TraceResume, X64_TRACE_RIP, X64_TRACE_RSP, x64_executable_debug_apart, x64_jetline_find, x64_jetline_sleb]
    jet_foundation.[DeepChecks, compiler_threads_single]
}

#Test("the_debug_build_keeps_the_selected_deep_checks") {
    off: native_debug_build_argv("jet", "prog.jet", "out", DeepChecks{})
    assert_eq(off, [String]{"jet", "build", "-O0", "--dead-code=keep", "--output-dir=out", "prog.jet"})
    kept: native_debug_build_argv("jet", "prog.jet", "out", DeepChecks{all: true, scopes: [String]{"tree", "tree.run"}})
    assert_eq(kept, [String]{"jet", "build", "-O0", "--dead-code=keep", "--deep-checks", "--deep-checks=tree", "--deep-checks=tree.run", "--output-dir=out", "prog.jet"})
}

#Test("a_breakpoint_stop_names_its_breakpoint") {
    frame: NativeFrame{function: "run", file: "prog.jet", line: 10, inlined: false}
    hit: NativeStop{kind: NativeStopKind.Paused, reason: "breakpoint 12.1", code: 0, frame: Val(frame)}
    assert_eq(native_debug_hit_breakpoint(hit), Int?{Val(12)})
    stepped: NativeStop{kind: NativeStopKind.Paused, reason: "step over", code: 0, frame: Val(frame)}
    assert_eq(native_debug_hit_breakpoint(stepped), Int?{None})
}

#Test("typed_locals_list_one_a_line_with_the_jet_type") {
    locals: [NativeLocal]{NativeLocal{name: "count", type_name: "Int", value: "3"}, NativeLocal{name: "ok", type_name: "Bool", value: "true"}}
    assert_eq(native_debug_locals_typed(locals), "count: Int = 3\nok: Bool = true\n")
    assert_eq(native_debug_locals_typed([NativeLocal]{}), "No locals here\n")
}

// Runs nest as their sites do, each after the run it is nested in: the chain
// at an address is its innermost run, then the runs around it.
#Test("an_address_in_nested_inlined_runs_has_one_frame_per_run") {
    runs: [NativeInlined]{
        NativeInlined{die: 10, origin: 1, low: 0x100, high: 0x180, call_line: 14, parent: -1, file: 1, call_file: 1},
        NativeInlined{die: 20, origin: 2, low: 0x120, high: 0x140, call_line: 6, parent: 0, file: 1, call_file: 1},
        NativeInlined{die: 30, origin: 2, low: 0x150, high: 0x160, call_line: 7, parent: 0, file: 1, call_file: 1},
    }
    function: NativeFunction{low: 0x80, high: 0x200, name: "run", file: 1, variables: [NativeVariable]{}, inlined: runs}
    assert_eq(native_inline_chain(function, 0x130), [Int]{1, 0})
    assert_eq(native_inline_chain(function, 0x150), [Int]{2, 0})
    assert_eq(native_inline_chain(function, 0x110), [Int]{0})
    assert_eq(native_inline_chain(function, 0x90), [Int]{})
    frames: [NativeFrame]{NativeFrame{function: "sum_squares", file: "prog.jet", line: 6, inlined: true}, NativeFrame{function: "run", file: "prog.jet", line: 14, inlined: false}}
    assert_eq(native_debug_backtrace(frames), "#0  sum_squares()  at prog.jet:6  [inlined]\n#1  run()  at prog.jet:14\n")
}

// `bt N` shows the first N frames, then how many more there are; a count
// at or past the frames shows them all with no more-line.
#Test("a_backtrace_count_shows_the_first_frames_and_how_many_more") {
    frames: [NativeFrame]{
        NativeFrame{function: "inner", file: "calls.jet", line: 2, inlined: false},
        NativeFrame{function: "middle", file: "calls.jet", line: 7, inlined: false},
        NativeFrame{function: "outer", file: "calls.jet", line: 12, inlined: false},
        NativeFrame{function: "run", file: "calls.jet", line: 17, inlined: false},
    }
    assert_eq(native_debug_backtrace(frames, count: Val(2)), "#0  inner()  at calls.jet:2\n#1  middle()  at calls.jet:7\n(2 more frames; `bt` shows them all)\n")
    assert_eq(native_debug_backtrace(frames, count: Val(3)), "#0  inner()  at calls.jet:2\n#1  middle()  at calls.jet:7\n#2  outer()  at calls.jet:12\n(1 more frame; `bt` shows them all)\n")
    assert_eq(native_debug_backtrace(frames, count: Val(4)), native_debug_backtrace(frames))
    assert_eq(native_debug_backtrace_count(""), Int?{None})
    assert_eq(native_debug_backtrace_count("2"), Val(2))
    assert_eq(native_debug_backtrace_count("two"), Val(0))
}

// The little-endian bytes of `words`, `size` bytes each.
native_test_bytes: fn(words: [Int], size: Int) -> [U8] {
    ^bytes: [U8]{}
    loop word in words {
        loop k in 0..<size -> bytes.push(U8{(word >> (8 * k)) & 255})
    }
    bytes
}

#Test("a_big_int_reads_its_carrier_and_limbs") {
    memory: NativeMemory{trace: None, blocks: [NativeBlock]{NativeBlock{address: 4318744, bytes: native_test_bytes([Int]{1, 0, 0, 4096, 4}, 8)}, NativeBlock{address: 4096, bytes: native_test_bytes([Int]{234567890, 345678901, 456789012, 123}, 4)}}}
    assert_eq(native_debug_int(7, memory), Int?{Val(7)})
    assert_eq(native_debug_int(-7, memory), Int?{Val(-7)})
    assert_eq(native_debug_int(4611686018431706648, memory), Int?{Val(123456789012345678901234567890)})
    // A carrier the memory does not hold is unavailable.
    assert_eq(native_debug_int(4611686018427391000, memory), Int?{None})
}

#Test("strings_and_decimals_read_their_handles") {
    text: "hello world"
    memory: NativeMemory{trace: None, blocks: [NativeBlock]{NativeBlock{address: 16, bytes: native_test_bytes([Int]{32, 11, 11}, 8)}, NativeBlock{address: 32, bytes: text.bytes()}, NativeBlock{address: 80, bytes: native_test_bytes([Int]{1250, 2}, 8)}}}
    assert_eq(native_debug_string(16, memory), String?{Val("\"hello world\"")})
    assert_eq(native_debug_precise("Decimal", 80, memory), String?{Val("12.50")})
    assert_eq(native_debug_precise("Fraction", 80, memory), String?{Val("1250/2")})
    assert_eq(native_debug_string(200, memory), String?{None})
    assert_eq(native_debug_decimal_text(-5, 3), "-0.005")
}

// A dump that reached a String's header or bytes but cut them off past its
// budget shows the String as cut off; bytes it never reached stay
// unavailable.
#Test("a_string_a_dump_cut_off_shows_as_cut_off") {
    memory: NativeMemory{trace: None, blocks: [NativeBlock]{NativeBlock{address: 16, bytes: native_test_bytes([Int]{4096, 11, 11, 20000, 11, 11}, 8)}}, cut: [NativeCut]{NativeCut{address: 4096, size: 8192}}}
    assert_eq(native_debug_string(16, memory), String?{Val(NATIVE_DEBUG_CUT_OFF)})
    assert_eq(native_debug_string(5000, memory), String?{Val(NATIVE_DEBUG_CUT_OFF)})
    assert_eq(native_debug_string(40, memory), String?{None})
    assert_eq(native_debug_string(64, memory), String?{None})
}

// An `.eh_frame` at 0x2000 whose one FDE covers [0x1000, 0x1010): a
// "zR" CIE (pc-relative sdata4 pointers, code alignment 1, data alignment
// -8, the return address in column 16) whose initial rule is CFA = rsp + 8,
// then `push rbp` at 0x1000 and `mov rbp, rsp` at 0x1001: each row is the
// one its address holds.
#Test("call_frame_rows_follow_the_fde_up_to_the_address") {
    // The CIE's 24 bytes, the FDE's 28, then the terminator.
    section: [Int]{20, 0, 0, 0, 0, 0, 0, 0, 1, 0x7a, 0x52, 0, 1, 0x78, 0x10, 1, 0x1b, 0x0c, 7, 8, 0x90, 1, 0, 0, 24, 0, 0, 0, 28, 0, 0, 0, 0xe0, 0xef, 0xff, 0xff, 0x10, 0, 0, 0, 0, 0x41, 0x0e, 0x10, 0x86, 0x02, 0x43, 0x0d, 0x06, 0, 0, 0, 0, 0, 0, 0}
    bytes: loop value in section -> U8{value}
    code: NativeCode{address: 0x2000, bytes: bytes}
    ^fdes: [NativeFde]{}
    native_frames_index(fdes, code, 0)
    assert_eq(fdes.len(), 1)
    assert_eq(fdes[0].start, 0x1000)
    assert_eq(fdes[0].end, 0x1010)
    frames: NativeFrames{sections: [NativeCode]{code}, fdes: fdes}
    entry: native_cfi_row(frames, 0x1000) ?? return assert(false, "no row at the entry")
    assert_eq(entry.register, 7)
    assert_eq(entry.offset, 8)
    assert_eq(entry.rules[NATIVE_CFI_RETURN], NATIVE_CFI_SAVED)
    assert_eq(entry.offsets[NATIVE_CFI_RETURN], -8)
    assert_eq(entry.rules[6], NATIVE_CFI_SAME)
    pushed: native_cfi_row(frames, 0x1003) ?? return assert(false, "no row after the push")
    assert_eq(pushed.register, 7)
    assert_eq(pushed.offset, 16)
    assert_eq(pushed.rules[6], NATIVE_CFI_SAVED)
    assert_eq(pushed.offsets[6], -16)
    framed: native_cfi_row(frames, 0x100f) ?? return assert(false, "no row in the body")
    assert_eq(framed.register, 6)
    assert_eq(framed.offset, 16)
    assert_eq(native_cfi_row(frames, 0x1010) == None, true)
    assert_eq(native_cfi_row(frames, 0xfff) == None, true)
}

// A frame stopped at `pc` that knows none of its registers.
native_test_unwound: fn(pc: Int) -> NativeUnwound {
    registers: loop _ in 0..<27 -> 0
    known: loop _ in 0..<27 -> false
    NativeUnwound{pc: pc, cfa: 0, registers: registers, known: known}
}

// `count` is in rbx over [0x1010, 0x1020), then its entry value (rdi's when
// `check` was called); `other` is only in rsi over [0x1010, 0x1020). At
// 0x1050 `count` is the 3 the call returning to 0x2005 passed in rdi (its
// call site parameter), and `other` is not kept; a caller whose call
// recorded no value leaves `count` not kept either, never a stale register.
#Test("a_parameter_past_its_range_reads_the_value_its_caller_passed") {
    loclists: [U8]{0x04, 0x10, 0x20, 0x01, 0x53, 0x04, 0x20, 0x80, 0x02, 0x04, 0xa3, 0x01, 0x55, 0x9f, 0x00, 0x04, 0x10, 0x20, 0x01, 0x54, 0x00}
    count: NativeVariable{name: "count", line: 1, ty: 40, list: 0, base: 0x1000, role: NativeVariableRole.Parameter, site: -1}
    other: NativeVariable{name: "other", line: 1, ty: 40, list: 15, base: 0x1000, role: NativeVariableRole.Parameter, site: -1}
    function: NativeFunction{low: 0x1000, high: 0x1100, name: "check", file: -1, variables: [NativeVariable]{count, other}, inlined: [NativeInlined]{}}
    ^types: [Int:NativeType]{}
    types[40] = NativeType{name: "I64", size: 8, tag: 0x24, encoding: X64DebugEncoding.Signed, target: -1, group: -1}
    arguments: [NativeCallArgument]{NativeCallArgument{at: 0x2005, register: 5, value: [U8]{0x11, 0x03}}}
    image: NativeImage{lines: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, functions: [NativeFunction]{function}, types: types, members: [[NativeMember]]{}, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: loclists, abstracts: [Int:NativeAbstract]{}, allocs: [Int:Int]{}, arguments: arguments}
    memory: NativeMemory{trace: None, blocks: [NativeBlock]{}}
    shown: native_frame_locals(image, memory, native_test_unwound(0x1050), 0x1050, -1, NativeUnwound?{Val(native_test_unwound(0x2005))})
    assert_eq(shown.len(), 2)
    assert_eq(shown[0].name, "count")
    assert_eq(shown[0].value, "3")
    assert_eq(shown[1].name, "other")
    assert_eq(shown[1].value, NATIVE_DEBUG_NOT_KEPT)
    unrecorded: native_frame_locals(image, memory, native_test_unwound(0x1050), 0x1050, -1, NativeUnwound?{Val(native_test_unwound(0x3000))})
    assert_eq(unrecorded[0].value, NATIVE_DEBUG_NOT_KEPT)
    alone: native_frame_locals(image, memory, native_test_unwound(0x1050), 0x1050, -1, NativeUnwound?{None})
    assert_eq(alone[0].value, NATIVE_DEBUG_NOT_KEPT)
}

// `pair`, an aggregate parameter, is its entry value with no
// DW_OP_stack_value after it over [0x1000, 0x1100): the call returning to
// 0x2005 passed in rdi the address 0x800 of its bytes, so at 0x1050 `pair`
// shows the Pair there.
#Test("an_aggregate_parameter_reads_the_bytes_at_the_address_its_caller_passed") {
    loclists: [U8]{0x04, 0x00, 0x80, 0x02, 0x03, 0xa3, 0x01, 0x55, 0x00}
    pair: NativeVariable{name: "pair", line: 1, ty: 50, list: 0, base: 0x1000, role: NativeVariableRole.Parameter, site: -1}
    function: NativeFunction{low: 0x1000, high: 0x1100, name: "check", file: -1, variables: [NativeVariable]{pair}, inlined: [NativeInlined]{}}
    ^types: [Int:NativeType]{}
    types[40] = NativeType{name: "I64", size: 8, tag: 0x24, encoding: X64DebugEncoding.Signed, target: -1, group: -1}
    types[50] = NativeType{name: "Pair", size: 16, tag: 0x13, encoding: X64DebugEncoding.Signed, target: -1, group: 0}
    members: [[NativeMember]]{[NativeMember]{NativeMember{name: "first", offset: 0, ty: 40, die: -1}, NativeMember{name: "second", offset: 8, ty: 40, die: -1}}}
    arguments: [NativeCallArgument]{NativeCallArgument{at: 0x2005, register: 5, value: [U8]{0x11, 0x80, 0x10}}}
    image: NativeImage{lines: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, functions: [NativeFunction]{function}, types: types, members: members, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: loclists, abstracts: [Int:NativeAbstract]{}, allocs: [Int:Int]{}, arguments: arguments}
    memory: NativeMemory{trace: None, blocks: [NativeBlock]{NativeBlock{address: 0x800, bytes: native_test_bytes([Int]{7, 9}, 8)}}}
    shown: native_frame_locals(image, memory, native_test_unwound(0x1050), 0x1050, -1, NativeUnwound?{Val(native_test_unwound(0x2005))})
    assert_eq(shown.len(), 1)
    assert_eq(shown[0].value, "Pair{{first: 7, second: 9}}")
    alone: native_frame_locals(image, memory, native_test_unwound(0x1050), 0x1050, -1, NativeUnwound?{None})
    assert_eq(alone[0].value, NATIVE_DEBUG_NOT_KEPT)
}

// `done`, a local bound on line 25 whose value the optimizer kept nowhere,
// is unbound while its frame stands at line 18, 25 or a line the image
// doesn't know (0), and unavailable from line 26 on; a parameter with no
// location is bound from its function's entry. A stop at an address no line
// row covers lists the parameter alone.
#Test("a_local_with_no_location_is_listed_only_from_its_binding_on") {
    done: NativeVariable{name: "done", line: 25, ty: 40, list: -1, base: 0x1000, role: NativeVariableRole.Local, site: -1}
    count: NativeVariable{name: "count", line: 18, ty: 40, list: -1, base: 0x1000, role: NativeVariableRole.Parameter, site: -1}
    assert_eq(native_debug_unbound(done, 18), true)
    assert_eq(native_debug_unbound(done, 25), true)
    assert_eq(native_debug_unbound(done, 0), true)
    assert_eq(native_debug_unbound(done, 26), false)
    assert_eq(native_debug_unbound(count, 18), false)
    function: NativeFunction{low: 0x1000, high: 0x1100, name: "run", file: -1, variables: [NativeVariable]{count, done}, inlined: [NativeInlined]{}}
    ^types: [Int:NativeType]{}
    types[40] = NativeType{name: "I64", size: 8, tag: 0x24, encoding: X64DebugEncoding.Signed, target: -1, group: -1}
    image: NativeImage{lines: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, functions: [NativeFunction]{function}, types: types, members: [[NativeMember]]{}, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: [U8]{}, abstracts: [Int:NativeAbstract]{}, allocs: [Int:Int]{}, arguments: [NativeCallArgument]{}}
    memory: NativeMemory{trace: None, blocks: [NativeBlock]{}}
    shown: native_frame_locals(image, memory, native_test_unwound(0x1050), 0x1050, -1, NativeUnwound?{None})
    assert_eq(shown.len(), 1)
    assert_eq(shown[0].name, "count")
    assert_eq(shown[0].value, NATIVE_DEBUG_UNAVAILABLE)
}

// `i`, a parameter of the run of `square` inlined at [0x1040, 0x1060), is
// in rbx over [0x1040, 0x1050) alone, where the caller's variable it is
// bound to still holds the value passed; `j`, another, has no location. In
// the run at 0x1048 `i` shows rbx's 7; at 0x1058 it is not kept. `j` is
// unavailable even on its own declaration line, never left out as a local
// still to be bound is. The function's own frame lists neither.
#Test("an_inlined_parameter_shows_its_value_where_located_and_why_not_elsewhere") {
    loclists: [U8]{0x04, 0x40, 0x50, 0x01, 0x53, 0x00}
    i: NativeVariable{name: "i", line: 3, ty: 40, list: 0, base: 0x1000, role: NativeVariableRole.Parameter, site: 0}
    j: NativeVariable{name: "j", line: 3, ty: 40, list: -1, base: 0x1000, role: NativeVariableRole.Parameter, site: 0}
    run: NativeInlined{die: 10, origin: 1, low: 0x1040, high: 0x1060, call_line: 8, parent: -1, file: -1, call_file: -1}
    function: NativeFunction{low: 0x1000, high: 0x1100, name: "sum_squares", file: -1, variables: [NativeVariable]{i, j}, inlined: [NativeInlined]{run}}
    ^types: [Int:NativeType]{}
    types[40] = NativeType{name: "I64", size: 8, tag: 0x24, encoding: X64DebugEncoding.Signed, target: -1, group: -1}
    ^abstracts: [Int:NativeAbstract]{}
    abstracts[1] = NativeAbstract{name: "square", file: -1}
    image: NativeImage{lines: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, functions: [NativeFunction]{function}, types: types, members: [[NativeMember]]{}, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: loclists, abstracts: abstracts, allocs: [Int:Int]{}, arguments: [NativeCallArgument]{}}
    memory: NativeMemory{trace: None, blocks: [NativeBlock]{}}
    // rbx, DWARF register 3, is the sixth of the registers ptrace reads.
    ^frame: native_test_unwound(0x1048)
    frame.registers[5] = 7
    frame.known[5] = true
    inside: native_frame_locals(image, memory, frame, 0x1048, 0, NativeUnwound?{None})
    assert_eq(inside.len(), 2)
    assert_eq(inside[0].name, "i")
    assert_eq(inside[0].value, "7")
    assert_eq(inside[1].name, "j")
    assert_eq(inside[1].value, NATIVE_DEBUG_UNAVAILABLE)
    past: native_frame_locals(image, memory, frame, 0x1058, 0, NativeUnwound?{None})
    assert_eq(past.len(), 2)
    assert_eq(past[0].value, NATIVE_DEBUG_NOT_KEPT)
    assert_eq(native_frame_locals(image, memory, frame, 0x1048, -1, NativeUnwound?{None}).len(), 0)
}

// Functions in address order with a gap between them: an address finds the
// one holding it, and one in the gap, before the first or at the last's end
// finds none.
#Test("an_address_finds_the_function_holding_it") {
    first: NativeFunction{low: 0x1000, high: 0x1010, name: "first", file: -1, variables: [NativeVariable]{}, inlined: [NativeInlined]{}}
    second: NativeFunction{low: 0x1020, high: 0x1030, name: "second", file: -1, variables: [NativeVariable]{}, inlined: [NativeInlined]{}}
    image: NativeImage{lines: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, functions: [NativeFunction]{first, second}, types: [Int:NativeType]{}, members: [[NativeMember]]{}, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: [U8]{}, abstracts: [Int:NativeAbstract]{}, allocs: [Int:Int]{}}
    assert_eq((native_function_at(image, 0x1000) ?? return assert(false, "no function at 0x1000")).name, "first")
    assert_eq((native_function_at(image, 0x100f) ?? return assert(false, "no function at 0x100f")).name, "first")
    assert_eq((native_function_at(image, 0x1025) ?? return assert(false, "no function at 0x1025")).name, "second")
    assert_eq(native_function_at(image, 0x1010) == None, true)
    assert_eq(native_function_at(image, 0xfff) == None, true)
    assert_eq(native_function_at(image, 0x1030) == None, true)
}

// Three functions of a line table, the middle one empty and starting where
// the last one does.
native_test_line_functions: fn() -> [X64JetlineFunction] {
    [X64JetlineFunction]{
        X64JetlineFunction{low: 0x1000, high: 0x1010, name: "first", file: "a.jet", dir: "", decl: 1, rows: 0, rows_end: 0},
        X64JetlineFunction{low: 0x1020, high: 0x1020, name: "empty", file: "a.jet", dir: "", decl: 2, rows: 0, rows_end: 0},
        X64JetlineFunction{low: 0x1020, high: 0x1030, name: "second", file: "a.jet", dir: "", decl: 3, rows: 0, rows_end: 0},
    }
}

// An ascending line table is halved to the function holding an address and
// finds what a search in order finds; a gap, the end and an empty function
// hold none.
#Test("a_line_table_lookup_halves_an_ascending_table") {
    halved: X64Jetline{table: [U8]{}, functions: native_test_line_functions(), ascending: true}
    in_order: X64Jetline{table: [U8]{}, functions: native_test_line_functions()}
    pcs: [Int]{0xfff, 0x1000, 0x100f, 0x1010, 0x1020, 0x102f, 0x1030}
    loop pc in pcs { assert_eq(x64_jetline_find(halved, pc), x64_jetline_find(in_order, pc)) }
    assert_eq(x64_jetline_find(halved, 0x1000), 0)
    assert_eq(x64_jetline_find(halved, 0x1020), 2)
    assert_eq(x64_jetline_find(halved, 0x1010), -1)
    assert_eq(x64_jetline_find(halved, 0x1030), -1)
}

// Two packages' files of one base name: a path picks one, by its last
// components or whole under the compilation directory; the base name names
// both, and a path neither file's ends with names none, since it could be
// either.
#Test("a_breakpoint_path_picks_one_of_two_same_named_files") {
    // One row each: line 5 at the function's start.
    rows: [U8]{U8{0}, U8{4}}
    sema: X64JetlineFunction{low: 0x1000, high: 0x1010, name: "sema_check", file: "Compiler/JetSema/Source/Check.jet", dir: "/src", decl: 5, rows: 0, rows_end: 2}
    eval: X64JetlineFunction{low: 0x1020, high: 0x1030, name: "eval_check", file: "Compiler/JetEval/Source/Check.jet", dir: "/src", decl: 5, rows: 0, rows_end: 2}
    image: NativeImage{lines: X64Jetline{table: rows, functions: [X64JetlineFunction]{sema, eval}}, functions: [NativeFunction]{}, types: [Int:NativeType]{}, members: [[NativeMember]]{}, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: [U8]{}, abstracts: [Int:NativeAbstract]{}, allocs: [Int:Int]{}}
    assert_eq(native_line_addresses(image, "Check.jet", 5), [Int]{0x1000, 0x1020})
    assert_eq(native_line_addresses(image, "JetSema/Source/Check.jet", 5), [Int]{0x1000})
    assert_eq(native_line_addresses(image, "/src/Compiler/JetEval/Source/Check.jet", 5), [Int]{0x1020})
    assert_eq(native_line_addresses(image, "Other/Check.jet", 5), [Int]{})
}

#Test("an_unavailable_debugger_is_e2203") {
    diagnostic: NativeDebugError{detail: "the program has no Jet debug information"}.diagnostic()
    assert_eq(diagnostic.code, "E2203")
    assert(diagnostic.what.contains("the program has no Jet debug information"))
}

// The same FDE but for its instructions: `push rbp` at 0x1000, then
// DW_CFA_remember_state, CFA = rsp + 32 and rbp back to the CIE's rule
// over [0x1003, 0x1004), and DW_CFA_restore_state at 0x1004.
#Test("call_frame_rows_restore_a_register_and_a_remembered_state") {
    section: [Int]{20, 0, 0, 0, 0, 0, 0, 0, 1, 0x7a, 0x52, 0, 1, 0x78, 0x10, 1, 0x1b, 0x0c, 7, 8, 0x90, 1, 0, 0, 28, 0, 0, 0, 28, 0, 0, 0, 0xe0, 0xef, 0xff, 0xff, 0x10, 0, 0, 0, 0, 0x41, 0x0e, 0x10, 0x86, 0x02, 0x0a, 0x42, 0x0e, 0x20, 0xc6, 0x41, 0x0b, 0, 0, 0, 0, 0, 0, 0}
    bytes: loop value in section -> U8{value}
    code: NativeCode{address: 0x2000, bytes: bytes}
    ^fdes: [NativeFde]{}
    native_frames_index(fdes, code, 0)
    frames: NativeFrames{sections: [NativeCode]{code}, fdes: fdes}
    pushed: native_cfi_row(frames, 0x1001) ?? return assert(false, "no row after the push")
    assert_eq(pushed.offset, 16)
    assert_eq(pushed.rules[6], NATIVE_CFI_SAVED)
    restored: native_cfi_row(frames, 0x1003) ?? return assert(false, "no row after the restore")
    assert_eq(restored.register, 7)
    assert_eq(restored.offset, 32)
    assert_eq(restored.rules[6], NATIVE_CFI_SAME)
    assert_eq(restored.offsets[6], 0)
    assert_eq(restored.rules[NATIVE_CFI_RETURN], NATIVE_CFI_SAVED)
    remembered: native_cfi_row(frames, 0x1004) ?? return assert(false, "no row after the restored state")
    assert_eq(remembered.register, 7)
    assert_eq(remembered.offset, 16)
    assert_eq(remembered.rules[6], NATIVE_CFI_SAVED)
    assert_eq(remembered.offsets[6], -16)
}

// The names a debug image gives types are symbol keys
// (`{kind}:{module}.{owner}.{name}`), with a `.` before each name.
#Test("a_debug_type_name_is_spelled_as_jet_writes_it") {
    assert_eq(native_jet_spelling("module:29:package:12:case_fixture:0.1.0:main.jet.Point"), "Point")
    assert_eq(native_jet_spelling("[module:14:source-root:0::prog.jet.Point]"), "[Point]")
    assert_eq(native_jet_spelling("module:16:package:4:ring:1:ring.jet.Ring"), "Ring")
    assert_eq(native_jet_spelling("[main.Point]"), "[Point]")
    assert_eq(native_jet_spelling("<corelib>/core.math.Decimal"), "Decimal")
}

#Test("a_sleb_keeps_every_bit_of_a_64_bit_value") {
    loop value in ([Int]{0, 63, -64, 4611686018427387904, -4611686018427387904, 4611686018427387903}) {
        ^bytes: [U8]{}
        ^rest: value
        loop {
            low: rest & 127
            rest = rest >> 7
            if (rest == 0 && (low & 64) == 0) || (rest == -1 && (low & 64) != 0) {
                bytes.push(U8{low})
                break
            }
            bytes.push(U8{low | 128})
        }
        ^at: 0
        assert_eq(x64_jetline_sleb(bytes, at), value)
        assert_eq(at, bytes.len())
    }
}

// The checkout these tests run in: the program is built outside it, so the
// build names the toolchain sources explicitly.
native_test_toolchain_root: fn() -> String Never! {
    ^dir: native_test_files.cwd() ?? panic("cwd: {err}")
    loop {
        if native_test_files.exists(native_test_files.join(dir, "Compiler/Prelude")) && native_test_files.exists(native_test_files.join(dir, "Core")) {
            return dir
        }
        parent: native_test_files.dirname(dir)
        if parent == dir -> panic("the tests run outside a Jet checkout")
        dir = parent
    }
}

// A session over `program`, written to prog.jet and built in `root` with the
// build flags `flags`.
native_test_session: fn(root: String, program: String, flags: ^^[String]) -> NativeSession {
    jet: native_test_process.which("jet") ?? panic("the Jet dev shell puts `jet` on PATH")
    source: native_test_files.join(root, "prog.jet")
    native_test_files.write(source, program) ?? panic("source: {err}")
    out: native_test_files.join(root, "out")
    ^argv: [String]{jet, "build"}
    argv.extend(flags.move())
    argv.push("--output-dir={out}")
    argv.push(source)
    built: native_test_process.cmd(argv).env("JET_TOOLCHAIN_ROOT", native_test_toolchain_root()).stdout(.Capture).stderr(.Capture).run() ?? panic("jet build: {err}")
    if !built.success -> panic("jet build failed: {built.output}{built.errors}")
    NativeSession.start(native_test_files.join(out, "prog"), native_test_files.join(root, "output.txt")) ?? panic("start: {err.detail}")
}

NATIVE_TEST_PROGRAM: "double: fn(x: Int) -> Int {{\n    y: x * 2\n    y\n}}\n\nrun: fn() {{\n    ^count: 0\n    loop i in 0..<2 {{\n        count += double(i)\n    }}\n    print(\"count {{count}}\")\n}}\n"

// At O2 `sum_squares` is inlined into `run`; the count comes from the
// program's arguments, so the loop is not folded away.
NATIVE_TEST_INLINED: "use process: core.process\n\nsum_squares: fn(n: Int) -> Int {{\n    ^total: 0\n    loop i in 0..<n {{\n        total += i * i\n        if total < 0 -> break\n    }}\n    total\n}}\n\nrun: fn() {{\n    n: Int.parse(process.args().get(0) ?? \"1000\") ?? 1000\n    print(\"{{sum_squares(n)}}\")\n}}\n"

// At O2 `early` (line 4) is inlined into `host` (lines 13-17), whose own
// code lies after line 9; `middle` is recursive, so line 9 keeps its own
// code there. A break on line 9 belongs to `middle` only.
NATIVE_TEST_LATER_LINE: "use process: core.process\n\nearly: fn(n: Int) -> Int {{\n    n * 3 + 1\n}}\n\nmiddle: fn(n: Int) -> Int {{\n    if n <= 0 -> return 1\n    ^total: middle(n - 1) + n\n    total * 2\n}}\n\nhost: fn(n: Int) -> Int {{\n    ^a: early(n)\n    loop k in 0..<n -> a += early(k)\n    a\n}}\n\nrun: fn() {{\n    n: Int.parse(process.args().get(0) ?? \"5\") ?? 5\n    first: host(n)\n    print(\"{{first}} {{middle(first % 7)}}\")\n}}\n"

NATIVE_TEST_SPLIT: "sum_squares: fn(n: Int) -> Int {{\n    ^total: 0\n    loop i in 0..<n -> total += i * i\n    return total\n}}\n\nrun: fn() {{ print(\"{{sum_squares(1000)}}\") }}\n"

// A one-line loop, then a recursive call: `next` must run the loop whole
// and, in fib's outer frame, run past the traps its deeper calls reach.
// fib's argument depends on the loop, so the call is not folded away.
NATIVE_TEST_LOOP: "fib: fn(n: Int) -> Int {{\n    if n < 2 -> return n\n    left: fib(n - 1)\n    right: fib(n - 2)\n    left + right\n}}\n\nrun: fn() {{\n    ^total: 0\n    loop i in 0..<3000000 -> total += i\n    answer: fib(15 + total % 2)\n    print(\"{{total}} {{answer}}\")\n}}\n"

// A ring buffer whose DebugView lists its items in order, in the Prelude's
// DebugItem rows. A view is a DebugView implementation: a build keeps the
// drop of the [DebugItem] list it returns only for those (JetIR
// ir_build_program), and without that drop the debugger calls no view. The
// program calls the view itself, so the image has it whether or not the
// build keeps views.
NATIVE_TEST_RING: "Ring: struct {{\n    items: [Int],\n    start: Int,\n    count: Int,\n\n    impl DebugView {{\n        debug_view: fn(self) -> [DebugItem] Never! {{\n            loop k in 0..<self.count -> DebugItem{{label: \"{{k}}\", value: \"{{self.items[(self.start + k) % self.items.len()]}}\"}}\n        }}\n    }}\n}}\n\nrun: fn() {{\n    ring: Ring{{items: [Int]{{5, 0, 3, 4}}, start: 2, count: 3}}\n    print(\"items {{ring.debug_view().len()}}\")\n}}\n"

#Test("a_struct_with_a_debug_view_shows_its_items") {
    scratch: native_test_files.temp_dir("jet-debug-view") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_RING, [String]{"-O0"})
    paused: session.run_to([NativeBreak]{{file: "prog.jet", line: 15}}, "prog.jet", NATIVE_TEST_RING.split("\n").to_list(), [String]{}) ?? panic("run_to: {err.detail}")
    assert(native_debug_hit_breakpoint(paused.stop) != None, paused.text)
    locals: session.locals() ?? panic("locals: {err.detail}")
    ^shown: ""
    loop local in locals {
        if local.name == "ring" -> shown = local.value
    }
    assert_eq(shown, "Ring{{0: 3, 1: 4, 2: 5}}")
    // The view ran in the program; it goes on where it stopped.
    session.clear_breakpoints() ?? panic("clear: {err.detail}")
    finished: session.continue_run() ?? panic("continue: {err.detail}")
    assert(finished.kind == NativeStopKind.Exited)
    assert_eq(finished.code, 0)
    assert_eq(session.take_output(), "items 3\n")
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// A view that prints, then opens a file. The program never calls it, so its
// print in the output would be the debugger's doing; run in the program,
// the view's write is kept from the kernel and the open is a refused system
// call.
NATIVE_TEST_LOUD: "use {{\n    process: core.process\n    files: core.files\n}}\n\nLoud: struct {{\n    count: Int,\n\n    impl DebugView {{\n        debug_view: fn(self) -> [DebugItem] Never! {{\n            print(\"viewed\")\n            name: files.read(\"/proc/self/comm\") ?? \"\"\n            [DebugItem]{{DebugItem{{label: \"seen\", value: \"{{self.count}} {{name.len()}}\"}}}}\n        }}\n    }}\n}}\n\nrun: fn() {{\n    loud: Loud{{count: 7}}\n    if process.args().len() > 5 -> print(\"{{loud.debug_view().len()}}\")\n    print(\"count {{loud.count}}\")\n}}\n"

#Test("a_debug_view_that_makes_a_system_call_is_refused_and_the_program_never_runs_it") {
    scratch: native_test_files.temp_dir("jet-debug-loud") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_LOUD, [String]{"-O0"})
    paused: session.run_to([NativeBreak]{{file: "prog.jet", line: 21}}, "prog.jet", NATIVE_TEST_LOUD.split("\n").to_list(), [String]{}) ?? panic("run_to: {err.detail}")
    assert(native_debug_hit_breakpoint(paused.stop) != None, paused.text)
    // Twice: each view runs, and is refused, afresh.
    loop _ in 0..<2 {
        locals: session.locals() ?? panic("locals: {err.detail}")
        ^shown: ""
        loop local in locals {
            if local.name == "loud" -> shown = local.value
        }
        // The open is refused, so the value shows by its fields.
        assert(shown.contains("7"), shown)
        assert(!shown.contains("seen"), shown)
    }
    session.clear_breakpoints() ?? panic("clear: {err.detail}")
    finished: session.continue_run() ?? panic("continue: {err.detail}")
    assert(finished.kind == NativeStopKind.Exited)
    assert_eq(finished.code, 0)
    assert_eq(session.take_output(), "count 7\n")
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// A view that runs far past the evaluation budget.
NATIVE_TEST_SPIN: "use process: core.process\n\nSpin: struct {{\n    count: Int,\n\n    impl DebugView {{\n        debug_view: fn(self) -> [DebugItem] Never! {{\n            ^total: 0\n            loop i in 0..<self.count -> total += i % 7\n            [DebugItem]{{DebugItem{{label: \"total\", value: \"{{total}}\"}}}}\n        }}\n    }}\n}}\n\nrun: fn() {{\n    spin: Spin{{count: 1000000000000000}}\n    if process.args().len() > 5 -> print(\"{{spin.debug_view().len()}}\")\n    print(\"spun {{spin.count > 0}}\")\n}}\n"

#Test("a_debug_view_past_its_budget_is_stopped_and_the_program_runs_on") {
    scratch: native_test_files.temp_dir("jet-debug-spin") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_SPIN, [String]{"-O0"})
    paused: session.run_to([NativeBreak]{{file: "prog.jet", line: 18}}, "prog.jet", NATIVE_TEST_SPIN.split("\n").to_list(), [String]{}) ?? panic("run_to: {err.detail}")
    assert(native_debug_hit_breakpoint(paused.stop) != None, paused.text)
    locals: session.locals() ?? panic("locals: {err.detail}")
    ^shown: ""
    loop local in locals {
        if local.name == "spin" -> shown = local.value
    }
    // The view is stopped at the budget and its state put back: the value
    // shows by its fields.
    assert(shown.contains("1000000000000000"), shown)
    assert(!shown.contains("total"), shown)
    session.clear_breakpoints() ?? panic("clear: {err.detail}")
    finished: session.continue_run() ?? panic("continue: {err.detail}")
    assert(finished.kind == NativeStopKind.Exited)
    assert_eq(session.take_output(), "spun true\n")
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

#Test("a_session_pauses_steps_and_reads_the_native_image") {
    scratch: native_test_files.temp_dir("jet-debug-native") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_PROGRAM, [String]{"-O0"})
    ^resolved: -1
    if session.break_at("prog.jet", 2) == {
        .Ok(number) -> { resolved = number ?? -1 }
        .Err(failure) -> panic("break: {failure.detail}")
    }
    assert_eq(resolved, 1)
    paused: session.launch([String]{}) ?? panic("launch: {err.detail}")
    assert(paused.kind == NativeStopKind.Paused)
    frame: paused.frame ?? panic("pause frame")
    assert_eq(frame.function, "double")
    assert_eq(frame.line, 2)
    locals: session.locals() ?? panic("locals: {err.detail}")
    assert_eq(locals[0].name, "x")
    assert_eq(locals[0].type_name, "Int")
    assert_eq(locals[0].value, "0")
    frames: session.backtrace() ?? panic("backtrace: {err.detail}")
    assert_eq(frames[1].function, "run")
    assert_eq(frames[1].line, 9)
    session.clear_breakpoints() ?? panic("clear: {err.detail}")
    finished: session.continue_run() ?? panic("continue: {err.detail}")
    assert(finished.kind == NativeStopKind.Exited)
    assert_eq(finished.code, 0)
    assert_eq(session.take_output(), "count 2\n")
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// Tail calls under a plain recursion: `down` and `hop` end in tail jumps,
// `walk` in a call and a `ret`. The count comes from the program's
// arguments, so nothing folds away.
NATIVE_TEST_TAIL: "use process: core.process\n\ndown: fn(n: Int) -> Int {{\n    if n <= 0 -> return 7\n    hop(n - 1)\n}}\n\nhop: fn(n: Int) -> Int {{\n    if n == 5 -> return 9\n    down(n)\n}}\n\nwalk: fn(n: Int) -> Int {{\n    if n <= 0 -> return down(3)\n    walk(n - 1) + 1\n}}\n\nrun: fn() {{\n    n: Int.parse(process.args().get(0) ?? \"2\") ?? 2\n    print(\"{{walk(n)}}\")\n}}\n"

// The most instructions the tail test single-steps.
NATIVE_TEST_MOST_STEPS: 1000000

// What ends the frame at `pc`: "ret" at a return, "tail" at a jump to a
// function's start, "" elsewhere.
native_test_frame_end: fn(session: NativeSession, pc: Int) -> String {
    bytes: session.code(pc, 5)
    if bytes.len() < 2 -> return ""
    if bytes[0] == (U8{0xc3}) -> return "ret"
    ^offset: 0
    ^size: 0
    if bytes[0] == (U8{0xe9}) && bytes.len() == 5 {
        loop k in 0..<4 -> offset = offset | (Int{bytes[1 + k]} << (8 * k))
        if offset >= 1 << 31 -> offset -= 1 << 32
        size = 5
    }
    if bytes[0] == (U8{0xeb}) {
        offset = Int{bytes[1]}
        if offset >= 128 -> offset -= 256
        size = 2
    }
    if size == 0 -> return ""
    target: pc + size + offset
    callee: x64_jetline_find(session.image.lines, target)
    if callee >= 0 && session.image.lines.functions[callee].low == target -> "tail" else -> ""
}

// A frame paused at its `ret`, or at the tail jump that ends it, has
// already given back its frame pointer: its call frame rules unwind it to
// the same callers as one instruction before, the whole stack down to run.
#Test("a_pause_at_a_ret_or_a_tail_jump_unwinds_the_whole_stack") {
    lines: NATIVE_TEST_TAIL.split("\n").to_list()
    loop level in ([String]{"-O0", "-O1", "-O2"}) {
        scratch: native_test_files.temp_dir("jet-debug-tail") ?? panic("scratch: {err}")
        root: scratch.path
        ^session: native_test_session(root, NATIVE_TEST_TAIL, [String]{level})
        first: session.run_to([NativeBreak]{{file: "prog.jet", line: 14}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
        assert(native_debug_hit_breakpoint(first.stop) != None, "{level}: {first.text}")
        session.clear_breakpoints() ?? panic("clear: {err.detail}")
        // The frame the steps run until it returns.
        out: (session.unwind() ?? panic("unwind: {err.detail}"))[0].cfa
        ^before: session.registers() ?? panic("registers: {err.detail}")
        ^rets: 0
        ^tails: 0
        loop _ in 0..<NATIVE_TEST_MOST_STEPS {
            event: session.go(X64TraceResume.Step) ?? panic("step: {err.detail}")
            if event.ends_run() -> break
            registers: session.registers() ?? panic("registers: {err.detail}")
            if registers[X64_TRACE_RSP] >= out -> break
            pc: registers[X64_TRACE_RIP]
            function: x64_jetline_find(session.image.lines, pc)
            end: native_test_frame_end(session, pc)
            if function >= 0 && end != "" && function == x64_jetline_find(session.image.lines, before[X64_TRACE_RIP]) {
                at: session.backtrace() ?? panic("backtrace: {err.detail}")
                was: session.backtrace_from(before) ?? panic("backtrace: {err.detail}")
                shown: native_debug_backtrace(at)
                assert(at.len() > 1 && at[0].function == was[0].function, "{level}: {end}:\n{shown}")
                assert_eq(native_debug_backtrace(at[1..<at.len()]), native_debug_backtrace(was[1..<was.len()]))
                assert(shown.contains("  run()  "), "{level}: {end} in {at[0].function}:\n{shown}")
                if end == "ret" -> rets += 1 else -> tails += 1
            }
            before = registers
        }
        assert(rets > 0, "{level}: a pause at a ret")
        assert(tails > 0, "{level}: a pause at a tail jump")
        session.close()
        native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
    }
}

#Test("an_o2_session_shows_inlined_frames_and_their_locals") {
    scratch: native_test_files.temp_dir("jet-debug-inlined") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_INLINED, [String]{"-O2"})
    lines: NATIVE_TEST_INLINED.split("\n").to_list()
    first: session.run_to([NativeBreak]{{file: "prog.jet", line: 6}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
    assert(first.text.contains("Breakpoint hit  prog.jet:6  in sum_squares()"), first.text)
    shown: session.command("bt", first.stop, "prog.jet", lines) ?? panic("bt: {err.detail}")
    assert(shown.text.starts_with("#0  sum_squares()  at prog.jet:6  [inlined]\n#1  run()  at prog.jet:14\n"), shown.text)
    inner: session.command("locals", first.stop, "prog.jet", lines) ?? panic("locals: {err.detail}")
    assert(inner.text.contains("i: Int = 0\n"), inner.text)
    assert(inner.text.contains("total: Int = 0\n"), inner.text)
    // `disas` in the inlined frame lists the function it is inlined into,
    // its run marked, and where the frame's locals live at the pc.
    listed: session.command("disas", first.stop, "prog.jet", lines) ?? panic("disas: {err.detail}")
    assert(listed.text.starts_with("run  prog.jet:"), listed.text)
    assert(listed.text.contains("  -O2  0x"), listed.text)
    assert(listed.text.contains("  inlined sum_squares, called on line 14\n"), listed.text)
    assert(listed.text.contains("\n   b1  0x"), listed.text)
    assert(listed.text.contains("        <- here\n"), listed.text)
    // run's own frame holds run's locals, not the inlined function's.
    assert(session.select_frame(1) ?? panic("select: {err.detail}"), "run's frame")
    outer: session.command("locals", first.stop, "prog.jet", lines) ?? panic("locals: {err.detail}")
    assert(!outer.text.contains("total:"), outer.text)
    assert(!outer.text.contains("i:"), outer.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// A list scalar replacement splits into field slots: early(5)'s list,
// passed to later, which O1 and O2 inline into run. The list's frame
// storage stays for its loans but holds the fields only around them, so
// `items` is either the true list or unavailable at a stop in later, never
// the stale bytes there (an empty list).
NATIVE_TEST_SCATTERED: "early: fn(n: Int) -> [Int] {{\n    ^items: [Int]{{}}\n    loop k in 0..<n -> items.push(k * 3)\n    items\n}}\n\nlater: fn(items: [Int]) -> Int {{\n    ^total: 0\n    loop v in items -> total += v\n    total\n}}\n\nrun: fn() {{\n    xs: early(5)\n    print(later(xs))\n}}\n"

#Test("an_optimized_stop_never_shows_a_scattered_list_as_empty") {
    lines: NATIVE_TEST_SCATTERED.split("\n").to_list()
    levels: [String]{"-O1", "-O2"}
    loop level in levels {
        scratch: native_test_files.temp_dir("jet-debug-scattered") ?? panic("scratch: {err}")
        root: scratch.path
        ^session: native_test_session(root, NATIVE_TEST_SCATTERED, [String]{level})
        stop: session.run_to([NativeBreak]{{file: "prog.jet", line: 8}}, "prog.jet", lines, [String]{}) ?? panic("run_to: {err.detail}")
        assert(stop.text.contains("Breakpoint hit  prog.jet:8  in later()"), "{level}: {stop.text}")
        shown: session.command("print items", stop.stop, "prog.jet", lines) ?? panic("print: {err.detail}")
        assert(!shown.text.contains("items = []"), "{level}: {shown.text}")
        assert(shown.text.contains("items = [0, 3, 6, 9, 12]") || shown.text.contains("<Unavailable>") || shown.text.contains("no readable value"), "{level}: {shown.text}")
        session.close()
        native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
    }
}

// `break` and `disas` by name reach a function the optimizer inlined: -O2
// inlines sum_squares into run, which calls it on line 14.
#Test("an_o2_session_breaks_in_and_lists_an_inlined_function_by_name") {
    scratch: native_test_files.temp_dir("jet-debug-inlined-name") ?? panic("scratch: {err}")
    root: scratch.path
    ^session: native_test_session(root, NATIVE_TEST_INLINED, [String]{"-O2"})
    lines: NATIVE_TEST_INLINED.split("\n").to_list()
    first: session.open("prog.jet", lines, [String]{}) ?? panic("the session opens at run")
    listed: session.command("disas sum_squares", first.stop, "prog.jet", lines) ?? panic("disas: {err.detail}")
    assert(listed.text.contains("sum_squares, inlined into run on line 14"), listed.text)
    placed: session.command("break sum_squares", first.stop, "prog.jet", lines) ?? panic("break: {err.detail}")
    hit: session.command("c", placed.stop, "prog.jet", lines) ?? panic("continue: {err.detail}")
    assert(hit.text.contains("Breakpoint hit  prog.jet:"), hit.text)
    assert(hit.text.contains("in sum_squares()"), hit.text)
    session.close()
    native_test_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// A file:line break stops in the function whose code is on that line, not
