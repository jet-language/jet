// The debug facts `jet debug` reads from the program's own O0 image: the
// Jet location table (`.debug_jetline`, JetBackend Image/Jetline.jet) for
// functions, files and lines, and the DWARF the backend writes
// (JetBackend Image/Dwarf.jet) for each function's parameters and locals,
// their location lists and their types. The reader knows exactly the
// abbreviations and forms that writer emits; a unit using any other form
// ends the read of that unit.
use jet_backend.[X64DebugEncoding, X64DebugEnumerator, X64DebugMember, X64DebugType, X64DebugTypeKind, X64DebugVariant, X64Jetline, X64JetlineFunction, X64ModuleDebug, link_debug_abbrevs, link_debug_addr, link_debug_form_end, link_debug_le, link_debug_uleb, x64_jetline_parse, x64_jetline_sleb, x64_jetline_text]

// The DW_TAG codes of the DIEs the reader keeps; it skips every other.
NATIVE_TAG_ENUM: 0x04

NATIVE_TAG_PARAMETER: 0x05

NATIVE_TAG_MEMBER: 0x0d

NATIVE_TAG_POINTER: 0x0f

NATIVE_TAG_COMPILE_UNIT: 0x11

NATIVE_TAG_STRUCT: 0x13

NATIVE_TAG_TYPEDEF: 0x16

NATIVE_TAG_UNION: 0x17

NATIVE_TAG_VARIANT: 0x19

NATIVE_TAG_VARIANT_PART: 0x33

NATIVE_TAG_BASE: 0x24

NATIVE_TAG_ENUMERATOR: 0x28

NATIVE_TAG_SUBPROGRAM: 0x2e

NATIVE_TAG_INLINED: 0x1d

NATIVE_TAG_VARIABLE: 0x34

NATIVE_TAG_CALL_SITE: 0x48

NATIVE_TAG_CALL_SITE_PARAMETER: 0x49

// One member of a struct or union type: its name, offset and type (a
// NativeImage.types key), and the offset of its DIE.
NativeMember: struct {
    name: String,
    offset: Int,
    ty: Int,
    die: Int,
}

// One enumerator of an enumeration type.
NativeEnumerator: struct {
    name: String,
    value: Int,
}

// One variant of a variant part: the member a value holds while its
// discriminant is `value` (None: any value no other variant names).
NativeVariant: struct {
    value: Int?,
    member: NativeMember,
}

// The variant part of a struct: the member whose value selects, and the
// variants it selects among.
NativeVariants: struct {
    discriminant: NativeMember,
    arms: [NativeVariant],
}

// A type DIE: its name ("" for an unnamed pointer), byte size and DW_TAG
// `tag`, one of NATIVE_TAG_BASE, POINTER, STRUCT, UNION, ENUM and TYPEDEF.
// A base type has its `encoding`; a pointer or typedef its `target` type
// (-1 for none). A struct's or union's members, or an enumeration's
// enumerators, are `group`, an index in NativeImage.members or
// NativeImage.enumerators; a struct without members (an opaque one) has
// group -1. A struct with a variant part has it at `variants`, an index in
// NativeImage.variants (-1: none).
NativeType: struct {
    name: String,
    size: Int,
    tag: Int,
    encoding: X64DebugEncoding,
    target: Int,
    group: Int,
    variants: Int{-1},
}

// Whether a DWARF variable is a parameter or a local.
NativeVariableRole: enum {
    Parameter,
    Local,
}

// One parameter or local: its name, declaration line, type (a
// NativeImage.types key) and the offset of its location list in
// `.debug_loclists`, -1 when it has none. `base` is its unit's base address
// for offset-pair entries. `site` is the inlined run (a NativeFunction.inlined
// index) whose frame it belongs to, -1 for the function's own frame.
NativeVariable: struct {
    name: String,
    line: Int,
    ty: Int,
    list: Int,
    base: Int,
    role: NativeVariableRole,
    site: Int,
}

// One run of code inlined into a function: its code [low, high), the offset
// of its abstract subprogram's DIE (a NativeImage.abstracts key), the line of
// the call it stands for, and the run it is inlined into (an index in the
// same list, -1 for the function itself). `die` is its own DIE's offset.
// `file` is the declaration file of the function inlined, `call_file` the
// file of the call, each an index in its unit's file table, -1 when the
// DWARF gives none.
NativeInlined: struct {
    die: Int,
    origin: Int,
    low: Int,
    high: Int,
    call_line: Int,
    parent: Int,
    file: Int,
    call_file: Int,
}

// One subprogram: its code [low, high), name, declaration file (an index
// in its unit's file table, -1 when the DWARF gives none), variables and
// inlined runs in DIE order (an inlined run follows the run it is nested
// in).
NativeFunction: struct {
    low: Int,
    high: Int,
    name: String,
    file: Int,
    variables: [NativeVariable],
    inlined: [NativeInlined],
}

// The abstract subprogram of a function inlined somewhere: its name and
// declaration file (an index in its unit's file table, -1 when the DWARF
// gives none).
NativeAbstract: struct {
    name: String,
    file: Int,
}

// The facts of one image. `functions` are in address order
// (native_function_at). `types` is keyed by the type DIE's offset in
// `.debug_info`; `members`, `enumerators` and `variants` hold each struct's,
// union's and enumeration's in DIE order, as its group names them;
// `abstracts` holds each abstract subprogram of inlined code by its offset;
// `allocs` the type each allocating call of a `--checked-alloc` image
// allocates for (a `types` key), by the call's return address; `calls` the
// call-site row of each call that has one (the source node that made it),
// by the call's return address; `arguments` the values each such call
// passes in its argument registers (DW_TAG_call_site_parameter); `level`
// the optimization level the program was built at, as its unit's producer
// names it (native_producer_level); `frames` its call frame information.
NativeImage: struct {
    lines: X64Jetline,
    functions: [NativeFunction],
    types: [Int:NativeType],
    members: [[NativeMember]],
    enumerators: [[NativeEnumerator]],
    variants: [NativeVariants],
    loclists: [U8],
    abstracts: [Int:NativeAbstract],
    allocs: [Int:Int],
    calls: [Int:NativeCallSite]{[Int:NativeCallSite]{}},
    arguments: [NativeCallArgument]{[NativeCallArgument]{}},
    level: Int{0},
    frames: NativeFrames{NativeFrames{sections: [NativeCode]{}, fdes: [NativeFde]{}}},
}

// The source node a call's lowering came from: its line and character
// column (JetBackend Image/Dwarf.jet DW_TAG_call_site).
NativeCallSite: struct {
    line: Int,
    column: Int,
}

// A value a call passes in argument register `register` (a DWARF register
// number), as its caller computes it: the DWARF expression `value`
// (DW_AT_call_value), evaluated in the caller's frame at the call's return
// address `at`.
NativeCallArgument: struct {
    at: Int,
    register: Int,
    value: [U8],
}

// One range of a variable's location list: [start, end), and the DWARF
// expression that locates it there, the bytes [from, to) of
// NativeImage.loclists.
NativeRange: struct {
    start: Int,
    end: Int,
    from: Int,
    to: Int,
}

// The facts of the ELF image `elf`; None without a `.debug_jetline`.
native_image_read: fn(elf: [U8]) -> NativeImage? Never! {
    table: native_elf_section(elf, ".debug_jetline") ?? return None
    image := NativeImage{lines: x64_jetline_parse(table), functions: [NativeFunction]{}, types: [Int:NativeType]{}, members: [[NativeMember]]{}, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: native_elf_section(elf, ".debug_loclists") ?? [U8]{}, abstracts: [Int:NativeAbstract]{}, allocs: [Int:Int]{}, frames: native_frames_read(elf)}
    info: native_elf_section(elf, ".debug_info") ?? return Val(image)
    abbrev: native_elf_section(elf, ".debug_abbrev") ?? return Val(image)
    at := 0
    loop at + 12 <= info.len() {
        length: link_debug_le(info, at, 4)
        end: at + 4 + length
        if length < 8 || end > info.len() -> break
        native_image_unit(image, info, abbrev, at, end)
        at = end
    }
    // Units need not come in address order; native_function_at searches.
    image.functions.sort_by(fn(left: NativeFunction, right: NativeFunction) { left.low <=> right.low })
    Val(image)
}

// The types the compiler described for a module it compiled
// (X64ModuleDebug.types) as an image's facts, each keyed by its row, as
// native_image_read reads the DWARF the backend writes from them: what shows
// a value of a type the program's own image has no DWARF for, such as an
// evaluated expression's Result (NativeEval.jet).
native_image_of_types: fn(debug: X64ModuleDebug) -> NativeImage Never! {
    image := NativeImage{lines: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, functions: [NativeFunction]{}, types: [Int:NativeType]{}, members: [[NativeMember]]{}, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: [U8]{}, abstracts: [Int:NativeAbstract]{}, allocs: [Int:Int]{}}
    loop (row, ty) in debug.types {
        made := NativeType{name: ty.name, size: ty.size, tag: NATIVE_TAG_STRUCT, encoding: X64DebugEncoding.Unsigned, target: -1, group: -1}
        if ty.kind == {
            .Base(encoding) -> {
                made.tag = NATIVE_TAG_BASE
                made.encoding = encoding
            }
            .Pointer(target) -> {
                made = NativeType{name: "", size: 8, tag: NATIVE_TAG_POINTER, encoding: X64DebugEncoding.Unsigned, target: target, group: -1}
            }
            .Typedef(target) -> {
                // A typedef of no type is written as an opaque struct.
                if target >= 0 {
                    made.tag = NATIVE_TAG_TYPEDEF
                    made.size = 0
                    made.target = target
                }
            }
            .Struct(members) -> { made.group = native_image_members(image, members) }
            .Union(members) -> {
                made.tag = NATIVE_TAG_UNION
                made.group = native_image_members(image, members)
            }
            .Enum(enumerators) -> {
                made.tag = NATIVE_TAG_ENUM
                made.encoding = X64DebugEncoding.Signed
                made.group = image.enumerators.len()
                image.enumerators.push(loop enumerator in enumerators -> NativeEnumerator{name: enumerator.name, value: enumerator.value})
            }
            .Variants(discriminant, variants) -> {
                made.group = native_image_members(image, [X64DebugMember]{discriminant})
                made.variants = image.variants.len()
                arms: loop variant in variants -> NativeVariant{value: variant.value, member: NativeMember{name: variant.member.name, offset: variant.member.offset, ty: variant.member.ty, die: -1}}
                image.variants.push(NativeVariants{discriminant: image.members[made.group][0], arms: arms})
            }
            .Opaque -> {}
        }
        image.types[row] = made
    }
    image
}

// `members` as a new group of image.members; its index.
native_image_members: fn(image: &NativeImage, members: [X64DebugMember]) -> Int Never! {
    image.members.push(loop member in members -> NativeMember{name: member.name, offset: member.offset, ty: member.ty, die: -1})
    image.members.len() - 1
}

// The bytes of the section named `name`; None when the image has none.
native_elf_section: fn(elf: [U8], name: String) -> [U8]? Never! {
    found: native_elf_header(elf, name) ?? return None
    offset: link_debug_addr(elf, found + 24)
    length: link_debug_addr(elf, found + 32)
    if offset < 0 || length < 0 || offset + length > elf.len() -> return None
    Val(elf[offset..<offset + length])
}

// The offset of the header of the section named `name`; None when the image
// has none.
native_elf_header: fn(elf: [U8], name: String) -> Int? Never! {
    found: native_elf_headers(elf, name)
    if found.len() == 0 -> return None
    Val(found[0])
}

// The offsets of the headers of every section named `name`, in order: a
// bound image has two `.text` and two `.eh_frame`, the runtime's and the
// program's.
native_elf_headers: fn(elf: [U8], name: String) -> [Int] Never! {
    found := [Int]{}
    headers: link_debug_addr(elf, 40)
    size: link_debug_le(elf, 58, 2)
    count: link_debug_le(elf, 60, 2)
    names_index: link_debug_le(elf, 62, 2)
    if headers < 0 || size < 64 || names_index < 0 || names_index >= count -> return found
    names: link_debug_addr(elf, headers + names_index * size + 24)
    if names < 0 -> return found
    loop k in 0..<count {
        header: headers + k * size
        at: link_debug_le(elf, header, 4)
        if at >= 0 && x64_jetline_text(elf, names + at) == name -> found.push(header)
    }
    found
}

// The image's code: the bytes of its `.text` and the address they load at
// (none when the image has no `.text`).
NativeCode: struct {
    address: Int,
    bytes: [U8],
}

native_elf_code: fn(elf: [U8]) -> NativeCode Never! {
    none: NativeCode{address: 0, bytes: [U8]{}}
    found: native_elf_header(elf, ".text") ?? return none
    bytes: native_elf_section(elf, ".text") ?? return none
    NativeCode{address: link_debug_addr(elf, found + 16), bytes: bytes}
}

// The bytes and load address of each section of the image named `name`
// (`.text`, `.eh_frame`).
native_elf_codes: fn(elf: [U8], name: String) -> [NativeCode] Never! {
    codes := [NativeCode]{}
    loop header in native_elf_headers(elf, name) {
        offset: link_debug_addr(elf, header + 24)
        length: link_debug_addr(elf, header + 32)
        if offset < 0 || length < 0 || offset + length > elf.len() -> next
        codes.push(NativeCode{address: link_debug_addr(elf, header + 16), bytes: elf[offset..<offset + length]})
    }
    codes
}

// An image's call frame information: its `.eh_frame` sections and each
// FDE in them, sorted by start. It unwinds the frames of code without Jet
// line information, the runtime's (NativeSession.unwind_from).
NativeFrames: struct {
    sections: [NativeCode],
    fdes: [NativeFde],
}

// One FDE: the code [start, end) it describes, its section and its
// record's offset there.
NativeFde: struct {
    start: Int,
    end: Int,
    section: Int,
    at: Int,
}

// What an FDE's reading takes from its CIE: the alignments of its code and
// data, the pointer encoding of its FDEs (DW_EH_PE) and whether they carry
// augmentation data, and its initial instructions [from, to).
NativeCie: struct {
    code_align: Int,
    data_align: Int,
    encoding: Int,
    augmented: Bool,
    from: Int,
    to: Int,
}

// The row of a function's call frame table at one address: the CFA is
// DWARF register `register` plus `offset`; per DWARF register (rax to r15,
// then the return address) its rule and, saved, the offset from the CFA it
// is saved at.
NativeCfiRow: struct {
    register: Int,
    offset: Int,
    rules: [Int],
    offsets: [Int],
}

// The DWARF registers a row has rules for; the last, the return address's
// column.
NATIVE_CFI_REGISTERS: 17

NATIVE_CFI_RETURN: 16

// A register's rule: its caller's value (a callee-saved register's unless
// a rule says otherwise), saved at the CFA plus its offset, or one the
// frame doesn't keep.
NATIVE_CFI_SAME: 0

NATIVE_CFI_SAVED: 1

NATIVE_CFI_LOST: 2

// The call frame information of the image `elf`.
native_frames_read: fn(elf: [U8]) -> NativeFrames Never! {
    sections: native_elf_codes(elf, ".eh_frame")
    fdes := [NativeFde]{}
    loop (section, code) in sections -> native_frames_index(fdes, code, section)
    fdes.sort_by(fn(left: NativeFde, right: NativeFde) { left.start <=> right.start })
    NativeFrames{sections: sections, fdes: fdes}
}

// Each FDE of the `.eh_frame` section `code`, the `section`-th, whose CIE
// the reader takes.
native_frames_index: fn(fdes: &[NativeFde], code: NativeCode, section: Int) Never! {
    at := 0
    loop at + 8 <= code.bytes.len() {
        length: link_debug_le(code.bytes, at, 4)
        // The terminator, or a 64-bit record, which no writer of Jet's makes.
        if length <= 0 || length == 0xffffffff -> break
        end: at + 4 + length
        if end > code.bytes.len() -> break
        pointer: link_debug_le(code.bytes, at + 4, 4)
        if pointer != 0 {
            if native_cie_read(code.bytes, at + 4 - pointer) == .Val(cie) {
                size: native_eh_size(cie.encoding)
                if size > 0 && at + 8 + 2 * size <= end {
                    start: native_eh_pointer(code, at + 8, cie.encoding)
                    range: native_eh_pointer(code, at + 8 + size, cie.encoding & 0x0f)
                    if range > 0 {
                        fdes.push(NativeFde{start: start, end: start + range, section: section, at: at})
                    }
                }
            }
        }
        at = end
    }
}

// The bytes of a pointer of DW_EH_PE encoding `encoding`: absolute or
// relative to its own address, of a fixed size; 0 for any other form.
native_eh_size: fn(encoding: Int) -> Int Never! {
    if encoding & 0x70 != 0 && encoding & 0x70 != 0x10 -> return 0
    format: encoding & 0x0f
    if {
        format == 0x00 || format == 0x04 || format == 0x0c -> 8
        format == 0x03 || format == 0x0b -> 4
        format == 0x02 || format == 0x0a -> 2
        else -> 0
    }
}

// The pointer of DW_EH_PE encoding `encoding` at `at` in `code`.
native_eh_pointer: fn(code: NativeCode, at: Int, encoding: Int) -> Int Never! {
    size: native_eh_size(encoding)
    value := link_debug_le(code.bytes, at, size)
    if encoding & 0x08 != 0 && value >= 1 << (8 * size - 1) -> value -= 1 << (8 * size)
    if encoding & 0x70 == 0x10 -> value += code.address + at
    value
}

// The CIE at `at` in `bytes`; None for a record that is no CIE or whose
// augmentation the reader doesn't know.
native_cie_read: fn(bytes: [U8], at: Int) -> NativeCie? Never! {
    if at < 0 -> return None
    length: link_debug_le(bytes, at, 4)
    if length <= 0 || length == 0xffffffff || at + 4 + length > bytes.len() || link_debug_le(bytes, at + 4, 4) != 0 {
        return None
    }
    end: at + 4 + length
    version: link_debug_le(bytes, at + 8, 1)
    cursor := at + 9
    letters := [Int]{}
    loop cursor < end && bytes[cursor] != (U8{0}) {
        letters.push(Int{bytes[cursor]})
        cursor += 1
    }
    cursor += 1
    code_align: link_debug_uleb(bytes, cursor)
    data_align: x64_jetline_sleb(bytes, cursor)
    if {
        version == 1 -> cursor += 1
        else -> _ := link_debug_uleb(bytes, cursor)
    }
    cie := NativeCie{code_align: code_align, data_align: data_align, encoding: 0, augmented: false, from: 0, to: end}
    if letters.len() > 0 {
        // "z", then per letter its data: R the FDEs' pointer encoding, P a
        // personality routine's encoding and pointer, L the LSDA's
        // encoding, S none.
        if letters[0] != 0x7a -> return None
        cie.augmented = true
        size: link_debug_uleb(bytes, cursor)
        data := cursor
        loop letter in letters[1..<letters.len()] {
            if letter == {
                0x52 -> {
                    cie.encoding = link_debug_le(bytes, data, 1)
                    data += 1
                }
                0x50 -> {
                    width: native_eh_size(link_debug_le(bytes, data, 1))
                    if width == 0 -> return None
                    data += 1 + width
                }
                0x4c -> data += 1
                0x53 -> {}
                else -> return None
            }
        }
        cursor += size
    }
    cie.from = cursor
    Val(cie)
}

// The row of `frames`' call frame tables at `pc`; None outside every FDE
// or past an instruction the reader doesn't take (an expression's).
native_cfi_row: fn(frames: NativeFrames, pc: Int) -> NativeCfiRow? Never! {
    low := 0
    high := frames.fdes.len()
    loop low < high {
        middle: (low + high) /% 2
        if frames.fdes[middle].start <= pc -> low = middle + 1 else -> high = middle
    }
    if low == 0 || pc >= frames.fdes[low - 1].end -> return None
    fde: frames.fdes[low - 1]
    bytes: frames.sections[fde.section].bytes
    cie: native_cie_read(bytes, fde.at + 4 - link_debug_le(bytes, fde.at + 4, 4)) ?? return None
    instructions := fde.at + 8 + 2 * native_eh_size(cie.encoding)
    if cie.augmented {
        skip: link_debug_uleb(bytes, instructions)
        instructions += skip
    }
    end: fde.at + 4 + link_debug_le(bytes, fde.at, 4)
    row := NativeCfiRow{register: 7, offset: 8, rules: loop _ in 0..<NATIVE_CFI_REGISTERS -> NATIVE_CFI_SAME, offsets: loop _ in 0..<NATIVE_CFI_REGISTERS -> 0}
    // What each change to the row replaced (native_cfi_rule), so that
    // DW_CFA_restore_state can undo back to its DW_CFA_remember_state and
    // DW_CFA_restore can find a register's rule as the CIE left it.
    log := [Int]{}
    // The log's length where the CIE's instructions end; -1 within them.
    cie_end := -1
    location := fde.start
    loop segment in 0..<2 {
        at := if segment == 0 -> cie.from else -> instructions
        to: if segment == 0 -> cie.to else -> end
        loop at < to {
            op: Int{bytes[at]}
            at += 1
            advance := 0
            if {
                op >> 6 == 1 -> advance = (op & 0x3f) * cie.code_align
                op >> 6 == 2 -> native_cfi_rule(row, log, op & 0x3f, NATIVE_CFI_SAVED, link_debug_uleb(bytes, at) * cie.data_align)
                op >> 6 == 3 -> native_cfi_restore(row, log, cie_end, op & 0x3f)
                op == 0x00 -> {}
                op == 0x02 || op == 0x03 || op == 0x04 -> {
                    width: if op == {
                        0x02 -> 1
                        0x03 -> 2
                        else -> 4
                    }
                    advance = link_debug_le(bytes, at, width) * cie.code_align
                    at += width
                }
                op == 0x05 -> {
                    register: link_debug_uleb(bytes, at)
                    native_cfi_rule(row, log, register, NATIVE_CFI_SAVED, link_debug_uleb(bytes, at) * cie.data_align)
                }
                op == 0x06 -> native_cfi_restore(row, log, cie_end, link_debug_uleb(bytes, at))
                op == 0x07 -> native_cfi_rule(row, log, link_debug_uleb(bytes, at), NATIVE_CFI_LOST, 0)
                op == 0x08 -> native_cfi_rule(row, log, link_debug_uleb(bytes, at), NATIVE_CFI_SAME, 0)
                op == 0x0a -> native_cfi_log(log, NATIVE_CFI_LOG_MARK, 0, 0)
                op == 0x0b -> {
                    if !native_cfi_undo(row, log, if cie_end < 0 -> 0 else -> cie_end) {
                        return None
                    }
                }
                op == 0x0c -> {
                    register: link_debug_uleb(bytes, at)
                    native_cfi_rule(row, log, NATIVE_CFI_LOG_FRAME, register, link_debug_uleb(bytes, at))
                }
                op == 0x0d -> {
                    offset: row.offset
                    native_cfi_rule(row, log, NATIVE_CFI_LOG_FRAME, link_debug_uleb(bytes, at), offset)
                }
                op == 0x0e -> {
                    register: row.register
                    native_cfi_rule(row, log, NATIVE_CFI_LOG_FRAME, register, link_debug_uleb(bytes, at))
                }
                op == 0x11 -> {
                    register: link_debug_uleb(bytes, at)
                    native_cfi_rule(row, log, register, NATIVE_CFI_SAVED, x64_jetline_sleb(bytes, at) * cie.data_align)
                }
                op == 0x12 -> {
                    register: link_debug_uleb(bytes, at)
                    native_cfi_rule(row, log, NATIVE_CFI_LOG_FRAME, register, x64_jetline_sleb(bytes, at) * cie.data_align)
                }
                op == 0x13 -> {
                    register: row.register
                    native_cfi_rule(row, log, NATIVE_CFI_LOG_FRAME, register, x64_jetline_sleb(bytes, at) * cie.data_align)
                }
                // DW_CFA_GNU_args_size.
                op == 0x2e -> _ := link_debug_uleb(bytes, at)
                else -> return None
            }
            location += advance
            if location > pc -> return Val(row)
        }
        if segment == 0 -> cie_end = log.len()
    }
    Val(row)
}

// A log entry of native_cfi_row's that changed the canonical frame
// address rule (its register and offset), not a register's.
NATIVE_CFI_LOG_FRAME: -1

// A log entry of native_cfi_row's that marks a DW_CFA_remember_state.
NATIVE_CFI_LOG_MARK: -2

// Give DWARF register `register` of `row` the rule `rule` at `offset`, or
// with NATIVE_CFI_LOG_FRAME give the canonical frame address register
// `rule` and offset `offset`; `log` gains what it replaced. A register past
// the return address's column has no rule.
native_cfi_rule: fn(row: &NativeCfiRow, log: &[Int], register: Int, rule: Int, offset: Int) Never! {
    if register == NATIVE_CFI_LOG_FRAME {
        native_cfi_log(log, NATIVE_CFI_LOG_FRAME, row.register, row.offset)
        row.register = rule
        row.offset = offset
        return
    }
    if register < 0 || register >= NATIVE_CFI_REGISTERS {
        return
    }
    native_cfi_log(log, register, row.rules[register], row.offsets[register])
    row.rules[register] = rule
    row.offsets[register] = offset
}

// Add the entry `kind`, `value`, `offset` to native_cfi_row's `log`.
native_cfi_log: fn(log: &[Int], kind: Int, value: Int, offset: Int) Never! {
    log.push(kind)
    log.push(value)
    log.push(offset)
}

// Return DWARF register `register` of `row` to its rule where the CIE's
// instructions end, at `cie_end` in `log`: what the first change after
// that replaced, else the rule it still has. Within the CIE's
// instructions (`cie_end` -1) that is the rule every register starts with.
native_cfi_restore: fn(row: &NativeCfiRow, log: &[Int], cie_end: Int, register: Int) Never! {
    if register < 0 || register >= NATIVE_CFI_REGISTERS {
        return
    }
    if cie_end < 0 {
        native_cfi_rule(row, log, register, NATIVE_CFI_SAME, 0)
        return
    }
    at := cie_end
    loop at + 2 < log.len() {
        if log[at] == register {
            rule: log[at + 1]
            offset: log[at + 2]
            native_cfi_rule(row, log, register, rule, offset)
            return
        }
        at += 3
    }
}

// Undo `row`'s changes in `log` back to its last DW_CFA_remember_state
// mark at or past `floor`; false when there is none.
native_cfi_undo: fn(row: &NativeCfiRow, log: &[Int], floor: Int) -> Bool Never! {
    loop log.len() >= floor + 3 {
        offset: log.pop() ?? 0
        value: log.pop() ?? 0
        kind: log.pop() ?? 0
        if {
            kind == NATIVE_CFI_LOG_MARK -> return true
            kind == NATIVE_CFI_LOG_FRAME -> {
                row.register = value
                row.offset = offset
            }
            else -> {
                row.rules[kind] = value
                row.offsets[kind] = offset
            }
        }
    }
    false
}

// The value of the symbol named `name` in the image's symbol table; None
// when the table has none of that name.
native_elf_symbol: fn(elf: [U8], name: String) -> Int? Never! {
    symbols: native_elf_section(elf, ".symtab") ?? return None
    names: native_elf_section(elf, ".strtab") ?? return None
    at := 0
    loop at + NATIVE_ELF_SYMBOL_BYTES <= symbols.len() {
        named: link_debug_le(symbols, at, 4)
        if named > 0 && x64_jetline_text(names, named) == name {
            return Val(link_debug_addr(symbols, at + 8))
        }
        at += NATIVE_ELF_SYMBOL_BYTES
    }
    None
}

// The bytes of one ELF64 symbol: its name's offset (4), info, other, section
// (2), value (8) and size (8).
NATIVE_ELF_SYMBOL_BYTES: 24

// The encoding of DW_ATE `code`: the inverse of the writer's
// (JetBackend Image/Dwarf.jet).
native_encoding: fn(code: Int) -> X64DebugEncoding Never! {
    if code == {
        0x05 -> X64DebugEncoding.Signed
        0x04 -> X64DebugEncoding.Float
        0x02 -> X64DebugEncoding.Bool
        0x10 -> X64DebugEncoding.Char
        else -> X64DebugEncoding.Unsigned
    }
}

// The attribute values of one DIE the reader uses; a missing number is -1.
// `discriminant` is the DIE a variant part's discriminant member is,
// `selects` the discriminant value a variant is selected by, `origin` the
// abstract subprogram an inlined run is of and `call_line` and `call_file`
// its call's line and file (and a call site's line and `call_column`);
// `file` is a declaration's file, `return_pc` a call site's return
// address and `producer` a unit's producer; `expression` is an exprloc
// DW_AT_location (a call site parameter's register) and `call_value` a
// call site parameter's DW_AT_call_value.
NativeDie: struct {
    tag: Int,
    offset: Int,
    children: Bool,
    name: String,
    ty: Int,
    low: Int,
    length: Int,
    location: Int,
    size: Int,
    member_offset: Int,
    encoding: Int,
    value: Int,
    line: Int,
    discriminant: Int,
    selects: Int?,
    origin: Int,
    call_line: Int,
    file: Int,
    call_file: Int,
    return_pc: Int,
    call_column: Int{0},
    producer: String{""},
    expression: [U8]{[U8]{}},
    call_value: [U8]{[U8]{}},
}

// The DIEs of the unit at [start, end) of `info`, into `image`.
native_image_unit: fn(image: &NativeImage, info: [U8], abbrev: [U8], start: Int, end: Int) Never! {
    version: link_debug_le(info, start + 4, 2)
    if version != 5 || link_debug_le(info, start + 6, 1) != 1 || link_debug_le(info, start + 7, 1) != 8 {
        return
    }
    table: link_debug_abbrevs(abbrev, link_debug_le(info, start + 8, 4)) ?? return
    at := start + 12
    base := 0
    // The open DIEs with children, innermost last.
    open := [NativeDie]{}
    loop at < end {
        offset: at
        code: link_debug_uleb(info, at)
        if code < 0 {
            return
        }
        if code == 0 {
            if open.pop() == None {
                return
            }
            next
        }
        entry: table.entries.get(code) ?? return
        die := NativeDie{tag: table.tags[entry], offset: offset, children: table.children[entry], name: "", ty: -1, low: -1, length: -1, location: -1, size: -1, member_offset: -1, encoding: -1, value: 0, line: 0, discriminant: -1, selects: None, origin: -1, call_line: 0, file: -1, call_file: -1, return_pc: -1}
        loop k in table.starts[entry]..<table.starts[entry + 1] {
            form: table.forms[k]
            value_at: at
            at = link_debug_form_end(info, at, form)
            if at < 0 || at > end {
                return
            }
            native_die_attribute(die, table.attributes[k], form, info, value_at, start)
        }
        if die.tag == NATIVE_TAG_COMPILE_UNIT {
            if die.low >= 0 -> base = die.low
            image.level = native_producer_level(die.producer)
        }
        native_image_die(image, die, open, base)
        if die.children -> open.push(die)
    }
}

// Record attribute `attribute` of `die`, a `form` value at `at`.
native_die_attribute: fn(die: &NativeDie, attribute: Int, form: Int, info: [U8], at: Int, unit: Int) Never! {
    if form == 0x18 && (attribute == 0x02 || attribute == 0x7e) {
        cursor := at
        length: link_debug_uleb(info, cursor)
        if length < 0 || cursor + length > info.len() {
            return
        }
        expression: info[cursor..<cursor + length]
        if attribute == 0x02 -> die.expression = expression else -> die.call_value = expression
        return
    }
    value: if form == {
        0x08 -> 0
        0x01 | 0x07 -> link_debug_addr(info, at)
        0x0b -> link_debug_le(info, at, 1)
        0x05 -> link_debug_le(info, at, 2)
        0x06 | 0x17 -> link_debug_le(info, at, 4)
        0x13 -> unit + link_debug_le(info, at, 4)
        0x0d -> {
            cursor := at
            x64_jetline_sleb(info, cursor)
        }
        0x0f -> {
            cursor := at
            link_debug_uleb(info, cursor)
        }
        else -> 1
    }
    if attribute == {
        0x03 -> die.name = x64_jetline_text(info, at)
        0x49 -> die.ty = value
        0x11 -> die.low = value
        0x12 -> die.length = value
        0x02 -> die.location = value
        0x0b -> die.size = value
        0x38 -> die.member_offset = value
        0x3e -> die.encoding = value
        0x1c -> die.value = value
        0x3b -> die.line = value
        0x15 -> die.discriminant = value
        0x16 -> die.selects = Val(value)
        0x31 -> die.origin = value
        0x59 -> die.call_line = value
        0x3a -> die.file = value
        0x58 -> die.call_file = value
        0x7d -> die.return_pc = value
        0x57 -> die.call_column = value
        0x25 -> die.producer = x64_jetline_text(info, at)
        else -> {}
    }
}

// The optimization level a unit's producer names, `Jet native backend (O2)`
// (JetBackend Image/Dwarf.jet); 0 for any other producer.
native_producer_level: fn(producer: String) -> Int Never! {
    if !producer.starts_with("Jet native backend (O") || !producer.ends_with(")") -> return 0
    level: Int.parse(producer.after("(O").before(")")) ?? return 0
    if level < 0 -> return 0
    level
}

// What `die` adds to `image`, nested in the `open` DIEs.
native_image_die: fn(image: &NativeImage, die: NativeDie, open: [NativeDie], base: Int) Never! {
    size: if die.size < 0 -> 0 else -> die.size
    code: die.tag
    if {
        code == NATIVE_TAG_BASE -> {
            image.types[die.offset] = NativeType{name: die.name, size: size, tag: code, encoding: native_encoding(die.encoding), target: -1, group: -1}
        }
        code == NATIVE_TAG_POINTER -> {
            image.types[die.offset] = NativeType{name: die.name, size: 8, tag: code, encoding: X64DebugEncoding.Unsigned, target: die.ty, group: -1}
        }
        code == NATIVE_TAG_TYPEDEF -> {
            image.types[die.offset] = NativeType{name: die.name, size: size, tag: code, encoding: X64DebugEncoding.Unsigned, target: die.ty, group: -1}
        }
        code == NATIVE_TAG_STRUCT || code == NATIVE_TAG_UNION -> {
            group: if die.children -> image.members.len() else -> -1
            if die.children -> image.members.push([NativeMember]{})
            image.types[die.offset] = NativeType{name: die.name, size: size, tag: code, encoding: X64DebugEncoding.Unsigned, target: -1, group: group}
        }
        code == NATIVE_TAG_ENUM -> {
            image.types[die.offset] = NativeType{name: die.name, size: size, tag: code, encoding: X64DebugEncoding.Signed, target: -1, group: image.enumerators.len()}
            image.enumerators.push([NativeEnumerator]{})
        }
        code == NATIVE_TAG_MEMBER -> {
            if open.len() == 0 {
                return
            }
            member: NativeMember{name: die.name, offset: if die.member_offset < 0 -> 0 else -> die.member_offset, ty: die.ty, die: die.offset}
            // A variant's member: what its struct holds while it is selected.
            if open[open.len() - 1].tag == NATIVE_TAG_VARIANT {
                if open.len() < 3 {
                    return
                }
                part: (image.types.get(open[open.len() - 3].offset) ?? return).variants
                if part < 0 || image.variants[part].arms.len() == 0 {
                    return
                }
                image.variants[part].arms[image.variants[part].arms.len() - 1].member = member
                return
            }
            ty: image.types.get(open[open.len() - 1].offset) ?? return
            group: if ty.tag == NATIVE_TAG_STRUCT || ty.tag == NATIVE_TAG_UNION -> ty.group else -> -1
            if group < 0 {
                return
            }
            image.members[group].push(member)
        }
        code == NATIVE_TAG_VARIANT_PART -> {
            if open.len() == 0 {
                return
            }
            holder: open[open.len() - 1].offset
            ty := image.types.get(holder) ?? return
            if ty.tag != NATIVE_TAG_STRUCT || ty.group < 0 {
                return
            }
            discriminant: loop member in image.members[ty.group] {
                if member.die == die.discriminant {
                    break member
                }
            } ?? return
            ty.variants = image.variants.len()
            image.variants.push(NativeVariants{discriminant: discriminant, arms: [NativeVariant]{}})
            image.types[holder] = ty
        }
        code == NATIVE_TAG_VARIANT -> {
            if open.len() < 2 {
                return
            }
            part: (image.types.get(open[open.len() - 2].offset) ?? return).variants
            if part < 0 {
                return
            }
            image.variants[part].arms.push(NativeVariant{value: die.selects, member: NativeMember{name: "", offset: 0, ty: -1, die: -1}})
        }
        code == NATIVE_TAG_ENUMERATOR -> {
            if open.len() == 0 {
                return
            }
            ty: image.types.get(open[open.len() - 1].offset) ?? return
            group: if ty.tag == NATIVE_TAG_ENUM -> ty.group else -> -1
            if group < 0 {
                return
            }
            image.enumerators[group].push(NativeEnumerator{name: die.name, value: die.value})
        }
        code == NATIVE_TAG_SUBPROGRAM -> {
            if die.low < 0 {
                if die.name != "" {
                    image.abstracts[die.offset] = NativeAbstract{name: die.name, file: die.file}
                }
                return
            }
            if die.length < 0 {
                return
            }
            image.functions.push(NativeFunction{low: die.low, high: die.low + die.length, name: die.name, file: die.file, variables: [NativeVariable]{}, inlined: [NativeInlined]{}})
        }
        code == NATIVE_TAG_INLINED -> {
            if image.functions.len() == 0 || !native_open_in_function(open) || die.low < 0 || die.length < 0 {
                return
            }
            last: image.functions.len() - 1
            parent: native_open_site(image.functions[last], open)
            file: if image.abstracts.get(die.origin) == .Val(origin) -> origin.file else -> -1
            image.functions[last].inlined.push(NativeInlined{die: die.offset, origin: die.origin, low: die.low, high: die.low + die.length, call_line: die.call_line, parent: parent, file: file, call_file: die.call_file})
        }
        code == NATIVE_TAG_CALL_SITE -> {
            if die.return_pc < 0 {
                return
            }
            if die.ty >= 0 -> image.allocs[die.return_pc] = die.ty
            if die.call_line > 0 {
                image.calls[die.return_pc] = NativeCallSite{line: die.call_line, column: die.call_column}
            }
        }
        code == NATIVE_TAG_CALL_SITE_PARAMETER -> {
            if open.len() == 0 {
                return
            }
            site: open[open.len() - 1]
            if site.tag != NATIVE_TAG_CALL_SITE || site.return_pc < 0 {
                return
            }
            register: native_location_register(die.expression, 0, die.expression.len())
            if register < 0 || die.call_value.len() == 0 {
                return
            }
            image.arguments.push(NativeCallArgument{at: site.return_pc, register: register, value: die.call_value})
        }
        code == NATIVE_TAG_PARAMETER || code == NATIVE_TAG_VARIABLE -> {
            if image.functions.len() == 0 || !native_open_in_function(open) {
                return
            }
            last: image.functions.len() - 1
            role: if code == NATIVE_TAG_PARAMETER -> NativeVariableRole.Parameter else -> NativeVariableRole.Local
            site: native_open_site(image.functions[last], open)
            image.functions[last].variables.push(NativeVariable{name: die.name, line: die.line, ty: die.ty, list: die.location, base: base, role: role, site: site})
        }
        else -> {}
    }
}

// Whether the open DIEs lie in a subprogram with code.
native_open_in_function: fn(open: [NativeDie]) -> Bool Never! {
    loop die in open {
        if die.tag == NATIVE_TAG_SUBPROGRAM && die.low >= 0 -> return true
    }
    false
}

// The inlined run of `function` the innermost open inlined DIE is, -1 when
// no inlined DIE is open.
native_open_site: fn(function: NativeFunction, open: [NativeDie]) -[]> Int {
    at := open.len() - 1
    loop at >= 0 {
        if open[at].tag == NATIVE_TAG_INLINED {
            loop (index, run) in function.inlined {
                if run.die == open[at].offset -> return index
            }
            return -1
        }
        at -= 1
    }
    -1
}

// The ranges of the location list at `list` (DW_LLE_offset_pair from
// `base`, DW_LLE_start_length, DW_LLE_base_address, DW_LLE_start_end).
native_ranges: fn(image: NativeImage, list: Int, base: Int) -> [NativeRange] Never! {
    ranges := [NativeRange]{}
    bytes: image.loclists
    if list < 0 || list >= bytes.len() -> return ranges
    at := list
    unit_base := base
    loop at < bytes.len() {
        kind: Int{bytes[at]}
        at += 1
        start := 0
        end := 0
        if kind == {
            0x00 -> return ranges
            0x04 -> {
                start = unit_base + link_debug_uleb(bytes, at)
                end = unit_base + link_debug_uleb(bytes, at)
            }
            0x06 -> {
                unit_base = link_debug_addr(bytes, at)
                at += 8
                next
            }
            0x07 -> {
                start = link_debug_addr(bytes, at)
                end = link_debug_addr(bytes, at + 8)
                at += 16
            }
            0x08 -> {
                start = link_debug_addr(bytes, at)
                at += 8
                end = start + link_debug_uleb(bytes, at)
            }
            else -> return ranges
        }
        length: link_debug_uleb(bytes, at)
        if length < 0 || at + length > bytes.len() -> return ranges
        ranges.push(NativeRange{start: start, end: end, from: at, to: at + length})
        at += length
    }
    ranges
}

// The function holding `pc`, else None: the last one starting at or before
// it, as functions don't overlap.
native_function_at: fn(image: NativeImage, pc: Int) -> NativeFunction? Never! {
    // The first function starting past `pc`.
    low := 0
    high := image.functions.len()
    loop low < high {
        middle: (low + high) >> 1
        if {
            (image.functions[middle].low <= pc) -> low = middle + 1
            else -> high = middle
        }
    }
    if low == 0 || pc >= image.functions[low - 1].high -> return None
    Val(image.functions[low - 1])
}

// A fallible call's carrier as the compiler describes it (JetIR X64Module.jet
// ir_x64_debug_variants): a typedef of a pointer to a box whose tag selects
// `Ok` (1) or `Err` (0), each payload at 8.
#Test("a_result_the_compile_describes_shows_ok_or_err") {
    int: X64DebugMember{name: "", offset: 8, ty: 1}
    error: X64DebugMember{name: "", offset: 8, ty: 3}
    tag: X64DebugMember{name: "tag", offset: 0, ty: 0}
    arms: [X64DebugVariant]{X64DebugVariant{value: Val(1), member: X64DebugMember{name: "Ok", offset: 0, ty: 2}}, X64DebugVariant{value: Val(0), member: X64DebugMember{name: "Err", offset: 0, ty: 4}}}
    types: [X64DebugType]{
        X64DebugType{name: "I64", size: 8, kind: X64DebugTypeKind.Base{encoding: X64DebugEncoding.Signed}},
        X64DebugType{name: "Int", size: 8, kind: X64DebugTypeKind.Typedef{target: 0}},
        X64DebugType{name: "Ok", size: 16, kind: X64DebugTypeKind.Struct{members: [X64DebugMember]{int}}},
        X64DebugType{name: "ParseError", size: 8, kind: X64DebugTypeKind.Enum{enumerators: [X64DebugEnumerator]{X64DebugEnumerator{name: "Empty", value: 0}, X64DebugEnumerator{name: "Bad", value: 1}}}},
        X64DebugType{name: "Err", size: 16, kind: X64DebugTypeKind.Struct{members: [X64DebugMember]{error}}},
        X64DebugType{name: "Int ParseError!", size: 16, kind: X64DebugTypeKind.Variants{discriminant: tag, variants: arms}},
        X64DebugType{name: "", size: 8, kind: X64DebugTypeKind.Pointer{target: 5}},
        X64DebugType{name: "Int ParseError!", size: 8, kind: X64DebugTypeKind.Typedef{target: 6}},
    }
    image: native_image_of_types(X64ModuleDebug{directory: "", files: [String]{}, types: types})
    ok := native_low_bytes(1, 8)
    ok.extend(native_low_bytes(3, 8))
    failed := native_low_bytes(0, 8)
    failed.extend(native_low_bytes(1, 8))
    memory: NativeMemory{trace: None, blocks: [NativeBlock]{NativeBlock{address: 4096, bytes: ok}, NativeBlock{address: 8192, bytes: failed}}}
    assert_eq(native_render(image, memory, 7, native_low_bytes(4096, 8), 0, 0), String?{Val("Ok(3)")})
    assert_eq(native_render(image, memory, 7, native_low_bytes(8192, 8), 0, 0), String?{Val("Err(ParseError.Bad)")})
}

#Test("a unit's producer names the level its program was built at") {
    assert_eq(native_producer_level("Jet native backend (O2)"), 2)
    assert_eq(native_producer_level("Jet native backend (O1)"), 1)
    assert_eq(native_producer_level("Jet native backend (O0)"), 0)
    assert_eq(native_producer_level("GNU C17 13.2.0 -O2"), 0)
}

// A List's inline header [len, cap, data] (JetIR BuildRoutes.jet); an
// aggregate local's DWARF type points at it.
#Test("an item watch reaches the List's data word through its pointer") {
    count: X64DebugMember{name: "len", offset: 0, ty: 1}
    room: X64DebugMember{name: "cap", offset: 8, ty: 1}
    data: X64DebugMember{name: "data", offset: 16, ty: 2}
    types: [X64DebugType]{
        X64DebugType{name: "I64", size: 8, kind: X64DebugTypeKind.Base{encoding: X64DebugEncoding.Signed}},
        X64DebugType{name: "Int", size: 8, kind: X64DebugTypeKind.Typedef{target: 0}},
        X64DebugType{name: "", size: 8, kind: X64DebugTypeKind.Pointer{target: 1}},
        X64DebugType{name: "[Int]", size: 24, kind: X64DebugTypeKind.Struct{members: [X64DebugMember]{count, room, data}}},
        X64DebugType{name: "", size: 8, kind: X64DebugTypeKind.Pointer{target: 3}},
    }
    image: native_image_of_types(X64ModuleDebug{directory: "", files: [String]{}, types: types})
    memory: NativeMemory{trace: None, blocks: [NativeBlock]{NativeBlock{address: 4096, bytes: native_low_bytes(8192, 8)}}}
    passed: native_watch_through(image, memory, 4, 4096, None) ?? panic("the pointer is readable")
    assert_eq(passed.ty, 3)
    assert_eq(passed.address, 8192)
    assert_eq(passed.held, Int?{None})
    held: native_watch_through(image, memory, 4, 0, Val(8192)) ?? panic("a held pointer needs no read")
    assert_eq(held.address, 8192)
    list: native_watch_list(image, 3)
    assert_eq(list.length, 0)
    assert_eq(list.data, 16)
    assert_eq(list.size, 24)
    assert_eq(list.element, 1)
    assert_eq(native_watch_list(image, 1).element, -1)
}
