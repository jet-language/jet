// The native debug session: Jet drives the program's own native image,
// built at `optimize: O0` with `debug_info: true`, itself. The program runs
// traced (JetBackend Image/Loader.jet); breakpoints are trap bytes written
// into its code, steps are single instructions, and every stop is read
// through the image's own debug facts (NativeFacts.jet): the Jet location
// table names the function, file and line, the DWARF names the locals,
// where each lives and its type. No outside debugger takes part.
use {
    native_files: core.files
    native_math: core.math
    jet_backend.[X64DebugEncoding, X64Trace, X64TraceResume, X64_TRACE_RBP, X64_TRACE_RDI, X64_TRACE_RIP, X64_TRACE_RSI, X64_TRACE_RSP, link_debug_uleb, x64_jetline_find, x64_jetline_line, x64_jetline_sleb, x64_trace_close, x64_trace_peek, x64_trace_poke, x64_trace_read, x64_trace_registers, x64_trace_resume, x64_trace_set_registers, x64_trace_spawn, x64_trace_wait]
    jet_foundation.[DeepChecks, Diagnostic, deep_checks_flags, diagnostic_display_identities, diagnostic_from_registry, diagnostic_registry_row, foundation_named_type]
}

#Error
NativeDebugError: struct {
    detail: String,

    // E2203, the registered failure of the native debugger.
    diagnostic: fn(self) -> Diagnostic Never! { native_debug_unavailable(self.detail) }
}

// E2203 with `detail` as the reason the native debugger could not run.
native_debug_unavailable: fn(detail: String) -> Diagnostic Never! {
    row: diagnostic_registry_row("E2203") ?? panic("E2203 is not registered")
    diagnostic_from_registry("E2203", None, row.what.replace("{{detail}}", detail), row.why, row.fix)
}

// One frame of a stop: the Jet function and its source position, or a frame
// without line information (the runtime's start code) with line 0.
NativeFrame: struct {
    function: String,
    file: String,
    line: Int,
}

// One local of the selected frame, in Jet terms. A value the image's debug
// information cannot show is NATIVE_DEBUG_UNAVAILABLE.
NativeLocal: struct {
    name: String,
    type_name: String,
    value: String,
}

NativeStopKind: enum {
    Paused,
    Exited,
    Signaled,
}

// Where a run-control command left the program: paused at `frame` for
// `reason`, exited with `code`, or ended by the signal named in `reason`.
NativeStop: struct {
    kind: NativeStopKind,
    reason: String,
    code: Int,
    frame: NativeFrame?,
}

// A breakpoint `jet debug --break` asks for: a Jet source file's base name,
// as the line table names it, and a line of it.
NativeBreak: struct {
    file: String,
    line: Int,
}

// A breakpoint: its number and the code addresses it traps.
NativeBreakpoint: struct {
    number: Int,
    addresses: [Int],
}

// A trap byte written into the program's code: its address and the byte it
// replaced.
NativeSite: struct {
    address: Int,
    byte: Int,
}

// What resuming the program ended in: a SIGTRAP stop (Paused: a trap byte or
// a finished single step), its exit with `code`, or its death by the signal
// `code`.
NativeEvent: struct {
    kind: NativeStopKind,
    code: Int,
}

// What running to a return address ended in: the return, or another stop.
NativeReturn: enum {
    Returned,
    Stopped(stop: NativeStop),
}

// Which calls a line step enters: none, or those with Jet line information.
NativeStepCalls: enum {
    Over,
    Into,
}

// One frame of the stopped program, as the unwinder found it: its code
// address, its canonical frame address (the caller's stack pointer) and its
// registers in the kernel's order, `known[i]` saying whether register i holds
// this frame's value.
NativeUnwound: struct {
    pc: Int,
    cfa: Int,
    registers: [Int],
    known: [Bool],
}

NativeSession: struct {
    binary: String,
    image: NativeImage,
    trace: X64Trace,
    output_path: String,
    output_read: Int,
    // Whether the program has been launched; while it runs, its trace has a
    // pid.
    started: Bool,
    breakpoints: [NativeBreakpoint],
    numbered: Int,
    sites: [NativeSite],
    selected: Int,

    // Load the debug facts of `binary` (a native image with debug info). The
    // program's output is written to `output_path`; nothing runs until
    // `launch`.
    start: fn(binary: String, output_path: String) -> NativeSession NativeDebugError! {
        elf: native_files.read_bytes(binary) ?? return Err(NativeDebugError{detail: "couldn't read the program `{binary}`: {err}"})
        image: native_image_read(elf) ?? return Err(NativeDebugError{detail: "`{binary}` has no Jet debug information; build it with `jet build -O0`"})
        native_files.write(output_path, "") ?? return Err(NativeDebugError{detail: "couldn't create the program output file: {err}"})
        Ok(NativeSession{binary: binary, image: image, trace: X64Trace{pid: -1, scratch: 0, failure: ""}, output_path: output_path, output_read: 0, started: false, breakpoints: [NativeBreakpoint]{}, numbered: 0, sites: [NativeSite]{}, selected: 0})
    }

    // A breakpoint on `line` of the Jet source `file` (its base name, as the
    // line table names it): its number, or None when no code is on that line.
    break_at: fn(&self, file: String, line: Int) -> Int? NativeDebugError! {
        self.place(native_line_addresses(self.image, file, line))
    }

    // A breakpoint at the start of the Jet function `function`, past its
    // prologue.
    break_in: fn(&self, function: String) -> Int? NativeDebugError! {
        addresses := [Int]{}
        loop (index, found) in self.image.lines.functions {
            if found.name == function -> addresses.push(native_body_start(self.image, index))
        }
        self.place(addresses)
    }

    // A new breakpoint on `addresses`, trapped at once in a running program;
    // None when there are none.
    place: fn(&self, addresses: [Int]) -> Int? NativeDebugError! {
        if addresses.len() == 0 -> return Ok(None)
        self.numbered += 1
        self.breakpoints.push(NativeBreakpoint{number: self.numbered, addresses: addresses})
        if self.alive() {
            loop address in addresses {
                if !self.plant(address) {
                    return Err(NativeDebugError{detail: "couldn't write a breakpoint at {native_debug_hex(address)}"})
                }
            }
        }
        Ok(Val(self.numbered))
    }

    delete_breakpoint: fn(&self, number: Int) NativeDebugError! {
        kept := [NativeBreakpoint]{}
        loop breakpoint in self.breakpoints {
            if breakpoint.number != number -> kept.push(breakpoint.copy())
        }
        self.breakpoints = kept
        self.lift_unwanted()
        Ok()
    }

    // Remove every breakpoint.
    clear_breakpoints: fn(&self) NativeDebugError! {
        self.breakpoints = [NativeBreakpoint]{}
        self.lift_unwanted()
        Ok()
    }

    // Run the program from its start, with `args`.
    launch: fn(&self, args: [String]) -> NativeStop NativeDebugError! {
        if self.trace.pid > 0 || self.trace.scratch != 0 -> x64_trace_close(self.trace)
        argv := [String]{self.binary.copy()}
        loop arg in args -> argv.push(arg.copy())
        self.started = true
        self.sites = [NativeSite]{}
        self.trace = x64_trace_spawn(self.binary, argv, self.output_path)
        if self.trace.pid < 0 {
            failure: self.trace.failure.copy()
            x64_trace_close(self.trace)
            return Err(NativeDebugError{detail: "couldn't start the program: {failure}"})
        }
        loop breakpoint in self.breakpoints {
            loop address in breakpoint.addresses {
                if !self.plant(address) {
                    return Err(NativeDebugError{detail: "couldn't write a breakpoint at {native_debug_hex(address)}"})
                }
            }
        }
        self.continue_run()
    }

    continue_run: fn(&self) -> NativeStop NativeDebugError! {
        self.ready() ?? return Err(err)
        event: self.go(X64TraceResume.Run) ?? return Err(err)
        self.stopped(event)
    }

    // The next line, entering calls into Jet code.
    step_in: fn(&self) -> NativeStop NativeDebugError! { self.line_step(NativeStepCalls.Into) }

    // The next line of this function, running calls to their end.
    step_over: fn(&self) -> NativeStop NativeDebugError! { self.line_step(NativeStepCalls.Over) }

    // Run to the end of this function, stopping in its caller.
    step_out: fn(&self) -> NativeStop NativeDebugError! {
        self.ready() ?? return Err(err)
        frames: self.unwind() ?? return Err(err)
        if frames.len() < 2 -> return self.continue_run()
        returned: self.run_to_return(frames[1].pc, frames[0].cfa) ?? return Err(err)
        if returned == {
            .Returned -> self.paused("step out")
            .Stopped(stop) -> Ok(stop)
        }
    }

    // The selected thread's frames, innermost first.
    backtrace: fn(&self) -> [NativeFrame] NativeDebugError! {
        frames: self.unwind() ?? return Err(err)
        shown := [NativeFrame]{}
        loop (index, frame) in frames {
            shown.push(native_frame_at(self.image, if index == 0 -> frame.pc else -> frame.pc - 1))
        }
        Ok(shown)
    }

    // The selected frame's parameters and locals, rendered as Jet values; a
    // struct whose type implements DebugView shows as its view (view).
    locals: fn(&self) -> [NativeLocal] NativeDebugError! {
        frames: self.unwind() ?? return Err(err)
        if frames.len() == 0 -> return Ok([NativeLocal]{})
        index: if self.selected < frames.len() -> self.selected else -> 0
        memory: NativeMemory{trace: Val(self.trace), blocks: [NativeBlock]{}}
        lookup: if index == 0 -> frames[index].pc else -> frames[index].pc - 1
        shown := native_frame_locals(self.image, memory, frames[index], lookup)
        function: native_function_at(self.image, lookup) ?? return Ok(shown)
        // The variables native_frame_locals shows, in its order.
        at := 0
        loop variable in function.variables {
            located := NativeRange?{None}
            if variable.list >= 0 {
                located = native_variable_covering(self.image, variable, lookup)
                if located == None -> next
            }
            local: at
            at += 1
            range: located ?? next
            view: native_debug_view_at(self.image, variable.ty) ?? next
            bytes: native_place_bytes(memory, frames[index], self.image.loclists, range.from, range.to, native_type_size(self.image, variable.ty)) ?? next
            if self.view(view, variable.ty, bytes) == {
                .Ok(viewed) -> {
                    if viewed == .Val(text) -> shown[local].value = text
                }
                .Err(failure) -> return Err(failure)
            }
            if !self.alive() -> break
        }
        Ok(shown)
    }

    // The value whose bytes are `value`, of struct type `ty`, as its
    // DebugView shows it: the stopped program runs the view at address
    // `view` on a copy of the value, below the stack it holds, then its
    // registers are put back. None when the view does not return (a trap,
    // a breakpoint or the program's end stops it first) or its items can't
    // be read.
    view: fn(&self, view: Int, ty: Int, value: [U8]) -> String? NativeDebugError! {
        saved: self.registers() ?? return Err(err)
        back: saved[X64_TRACE_RIP]
        // Past the red zone: the [DebugItem] header the view returns through
        // its hidden result pointer, the value it borrows as `self`, then the
        // return address, the stack 16-byte aligned at the call.
        below: saved[X64_TRACE_RSP] - NATIVE_DEBUG_RED_ZONE - 32
        result: below - below % 16
        copied: result - value.len() - (result - value.len()) % 16
        entry: copied - 16 - 8
        if !self.poke_bytes(copied, value) || !self.poke_bytes(entry, native_word_bytes(back)) {
            return Ok(None)
        }
        temporary: !self.has_site(back)
        if temporary && !self.plant(back) -> return Ok(None)
        registers := self.registers() ?? return Err(err)
        registers[X64_TRACE_RIP] = view
        registers[X64_TRACE_RSP] = entry
        registers[X64_TRACE_RDI] = result
        registers[X64_TRACE_RSI] = copied
        if !x64_trace_set_registers(self.trace, registers) {
            return Err(NativeDebugError{detail: "couldn't set the program's registers"})
        }
        event: self.resume(X64TraceResume.Run) ?? return Err(err)
        if event.kind != NativeStopKind.Paused -> return Ok(None)
        after: self.registers() ?? return Err(err)
        shown := String?{None}
        if after[X64_TRACE_RIP] - 1 == back && after[X64_TRACE_RSP] == entry + 8 {
            shown = native_debug_view_shown(self.image, NativeMemory{trace: Val(self.trace), blocks: [NativeBlock]{}}, ty, result)
        }
        if !x64_trace_set_registers(self.trace, saved) {
            return Err(NativeDebugError{detail: "couldn't set the program's registers"})
        }
        if temporary -> self.lift(back)
        Ok(shown)
    }

    // Write `bytes` at `address` of the stopped program a word at a time,
    // the last word padded with zeros; false when it can't be written.
    poke_bytes: fn(self, address: Int, bytes: [U8]) -> Bool Never! {
        loop word in 0..<((bytes.len() + 7) >> 3) {
            if !x64_trace_poke(self.trace, address + 8 * word, I64{native_number(bytes, 8 * word, 8, X64DebugEncoding.Signed)}) {
                return false
            }
        }
        true
    }

    // Select frame `index` of the current thread (0 is innermost).
    select_frame: fn(&self, index: Int) -> Bool NativeDebugError! {
        frames: self.unwind() ?? return Err(err)
        if index < 0 || index >= frames.len() -> return Ok(false)
        self.selected = index
        Ok(true)
    }

    // The program's output written since the last call.
    take_output: fn(&self) -> String Never! {
        text: native_files.read(self.output_path) ?? return ""
        bytes: text.bytes()
        if bytes.len() <= self.output_read -> return ""
        fresh: String.from_bytes(bytes[self.output_read..<bytes.len()]) ?? return ""
        self.output_read = bytes.len()
        fresh
    }

    // End the program, if it still runs.
    close: fn(&self) Never! {
        x64_trace_close(self.trace)
        self.sites = [NativeSite]{}
    }

    // The source file of the program's `run`, as the image's line table
    // records it; "" when the image holds no `run`.
    run_source: fn(&self) -> String Never! {
        loop found in self.image.lines.functions {
            if found.name != "run" -> next
            if found.dir == "" || found.file.starts_with("/") -> return "{found.file}"
            return native_files.join(found.dir, found.file)
        }
        ""
    }

    // Run the program to the start of its `run`, in the Jet source `file`
    // whose text is `lines`. None when the program has no `run`.
    open: fn(&self, file: String, lines: [String]) -> NativeDebugStep? NativeDebugError! {
        start := -1
        if self.break_in("run") == {
            .Ok(placed) -> start = placed ?? -1
            .Err(failure) -> return Err(failure)
        }
        if start < 0 -> return Ok(None)
        first: self.launch([String]{}) ?? return Err(err)
        self.delete_breakpoint(start) ?? return Err(err)
        text: self.report(first, file, lines) ?? return Err(err)
        Ok(Val(NativeDebugStep{text: text, stop: first}))
    }

    // Place a breakpoint on each of `breaks`, then run the program to the
    // first it reaches, or to its end: the first stop of
    // `jet debug --break`. A break on a line with no code is named and left
    // out.
    run_to: fn(&self, breaks: [NativeBreak], file: String, lines: [String]) -> NativeDebugStep NativeDebugError! {
        text := ""
        loop wanted in breaks {
            placed := -1
            if self.break_at(wanted.file, wanted.line) == {
                .Ok(found) -> placed = found ?? -1
                .Err(failure) -> return Err(failure)
            }
            text = if placed < 0 -> "{text}No code on {wanted.file}:{wanted.line}\n" else -> "{text}Breakpoint set  {wanted.file}:{wanted.line}\n"
        }
        first: self.launch([String]{}) ?? return Err(err)
        shown: self.report(first, file, lines) ?? return Err(err)
        Ok(NativeDebugStep{text: "{text}{shown}", stop: first})
    }

    // One console command at `stop`. `quit` is the caller's: only it knows
    // how its session ends.
    command: fn(&self, command: String, stop: NativeStop, file: String, lines: [String]) -> NativeDebugStep NativeDebugError! {
        trimmed: command.trim()
        word: trimmed.before(" ")
        operand: if trimmed.contains(" ") -> trimmed.after(" ").trim().copy() else -> ""
        text := ""
        if word == {
            "s" | "step" | "n" | "next" | "c" | "continue" | "f" | "finish" -> {
                moved: self.advance(word) ?? return Err(err)
                text = self.report(moved, file, lines) ?? return Err(err)
                return Ok(NativeDebugStep{text: text, stop: moved})
            }
            "b" | "break" -> {
                at: Int.parse(operand) ?? -1
                placed := -1
                if at >= 1 {
                    if self.break_at(file, at) == {
                        .Ok(found) -> placed = found ?? -1
                        .Err(failure) -> return Err(failure)
                    }
                }
                text = if {
                    at < 1 -> "Break needs a line number of {file}, as `break 12`\n"
                    placed < 0 -> "No code on {file}:{at}\n"
                    else -> "Breakpoint set  {file}:{at}\n"
                }
            }
            "locals" -> {
                locals := self.locals() ?? return Err(err)
                locals.sort_by(fn(left: NativeLocal, right: NativeLocal) { left.name <=> right.name })
                text = native_debug_locals_typed(locals)
            }
            "p" | "print" -> {
                locals: self.locals() ?? return Err(err)
                text = "{native_debug_print(locals, operand)}\n"
            }
            "bt" | "backtrace" -> {
                frames: self.backtrace() ?? return Err(err)
                text = native_debug_backtrace(frames)
            }
            "h" | "help" -> text = "{NATIVE_DEBUG_HELP}\n"
            "" -> {}
            else -> text = "Unknown command `{word}`. {NATIVE_DEBUG_HELP}\n"
        }
        Ok(NativeDebugStep{text: text, stop: stop})
    }

    // Run one run-control command. A step that lands in code without Jet line
    // information finishes out of it back to the Jet caller, or continues when
    // no Jet frame is left to return to.
    advance: fn(&self, word: String) -> NativeStop NativeDebugError! {
        stop := if word == {
            "s" | "step" -> self.step_in() ?? return Err(err)
            "n" | "next" -> self.step_over() ?? return Err(err)
            "f" | "finish" -> self.step_out() ?? return Err(err)
            else -> self.continue_run() ?? return Err(err)
        }
        depth := 0
        loop stop.kind == NativeStopKind.Paused && !native_debug_stop_in_jet(stop.frame) {
            frames: self.backtrace() ?? return Err(err)
            caller := false
            loop (k, frame) in frames {
                if k > 0 && native_debug_jet_frame(frame) -> caller = true
            }
            depth += 1
            stop = if caller && depth <= NATIVE_DEBUG_RUNTIME_DEPTH -> self.step_out() ?? return Err(err) else -> self.continue_run() ?? return Err(err)
        }
        Ok(stop)
    }

    // The program's new output, then where `stop` left it.
    report: fn(&self, stop: NativeStop, file: String, lines: [String]) -> String NativeDebugError! {
        text := self.take_output()
        if stop.kind == {
            .Exited -> {
                text = "{text}{if stop.code == 0 -> "Program finished" else -> "Program finished with exit status {stop.code}"}\n"
            }
            .Signaled -> { text = "{text}Program stopped by {stop.reason}\n" }
            .Paused -> {
                frame: stop.frame ?? NativeFrame{function: "?", file: "", line: 0}
                if stop.reason.starts_with("breakpoint") {
                    text = "{text}{NATIVE_DEBUG_BREAKPOINT_HIT}  {frame.file}:{frame.line}  in {frame.function}()\n"
                }
                source: if frame.file == file && frame.line >= 1 && frame.line <= lines.len() -> lines[frame.line - 1] else -> ""
                locals: self.locals() ?? return Err(err)
                text = "{text}{frame.line} | {source}        <- here\n{native_debug_locals_line(locals)}\n"
            }
        }
        Ok(text)
    }

    // The paused facts at the current stop: the innermost Jet frame, its
    // locals, and the Jet call stack outermost first. None when no Jet frame
    // is on the stack.
    snapshot: fn(&self) -> DebugSnapshot? NativeDebugError! {
        frames: self.backtrace() ?? return Err(err)
        stack := [FrameSnapshot]{}
        loop frame in frames {
            if native_debug_jet_frame(frame) {
                stack.insert(0, FrameSnapshot{function: frame.function, line: frame.line})
            }
        }
        if stack.len() == 0 -> return Ok(None)
        top: stack[stack.len() - 1]
        values := [ValueSnapshot]{}
        locals: self.locals() ?? return Err(err)
        loop local in locals {
            values.push(ValueSnapshot{name: local.name, type_name: local.type_name, value: local.value})
        }
        Ok(Val(DebugSnapshot{function: top.function, line: top.line, locals: values, call_stack: stack}))
    }

    // Whether the program runs, stopped for its tracer: launched and not
    // yet over.
    alive: fn(self) -> Bool Never! { self.trace.pid > 0 }

    // Fails unless the program is stopped.
    ready: fn(self) NativeDebugError! {
        if {
            self.alive() -> Ok()
            self.started -> Err(NativeDebugError{detail: "the program has already finished"})
            else -> Err(NativeDebugError{detail: "the program has not started"})
        }
    }

    // The stopped program's registers.
    registers: fn(self) -> [Int] NativeDebugError! {
        registers: x64_trace_registers(self.trace) ?? return Err(NativeDebugError{detail: "couldn't read the program's registers"})
        Ok(registers)
    }

    // Write a trap byte at `address`, unless one is there; false when the
    // code can't be written.
    plant: fn(&self, address: Int) -> Bool Never! {
        loop site in self.sites {
            if site.address == address -> return true
        }
        word: x64_trace_peek(self.trace, address) ?? return false
        if !x64_trace_poke(self.trace, address, word & I64{-256} | I64{NATIVE_DEBUG_TRAP}) {
            return false
        }
        self.sites.push(NativeSite{address: address, byte: Int{word & I64{255}}})
        true
    }

    // Put back the byte the trap at `address` replaced.
    lift: fn(&self, address: Int) Never! {
        kept := [NativeSite]{}
        loop site in self.sites {
            if site.address != address {
                kept.push(site.copy())
                next
            }
            if x64_trace_peek(self.trace, address) == .Val(word) {
                _ := x64_trace_poke(self.trace, address, word & I64{-256} | I64{site.byte})
            }
        }
        self.sites = kept
    }

    // Lift every trap no breakpoint wants.
    lift_unwanted: fn(&self) Never! {
        stale := [Int]{}
        loop site in self.sites {
            if self.breakpoint_at(site.address) == None -> stale.push(site.address)
        }
        if !self.alive() {
            self.sites = [NativeSite]{}
            return
        }
        loop address in stale -> self.lift(address)
    }

    has_site: fn(self, address: Int) -> Bool Never! {
        loop site in self.sites {
            if site.address == address -> return true
        }
        false
    }

    // The number of the breakpoint trapping `address`.
    breakpoint_at: fn(self, address: Int) -> Int? Never! {
        loop breakpoint in self.breakpoints {
            loop at in breakpoint.addresses {
                if at == address -> return Val(breakpoint.number)
            }
        }
        None
    }

    // `count` bytes of the program's code from `address`, as the image has
    // them: the bytes under trap bytes put back.
    code: fn(self, address: Int, count: Int) -> [U8] Never! {
        bytes := x64_trace_read(self.trace, address, count) ?? [U8]{}
        loop site in self.sites {
            at: site.address - address
            if at >= 0 && at < bytes.len() -> bytes[at] = U8{site.byte}
        }
        bytes
    }

    // Let the program go on as `how` says, off a trap byte at its pc first:
    // the byte is put back for one instruction, then trapped again.
    go: fn(&self, how: X64TraceResume) -> NativeEvent NativeDebugError! {
        self.selected = 0
        registers: self.registers() ?? return Err(err)
        pc: registers[X64_TRACE_RIP]
        if self.has_site(pc) {
            byte := 0
            loop site in self.sites {
                if site.address == pc -> byte = site.byte
            }
            if x64_trace_peek(self.trace, pc) == .Val(word) {
                _ := x64_trace_poke(self.trace, pc, word & I64{-256} | I64{byte})
            }
            stepped: self.resume(X64TraceResume.Step) ?? return Err(err)
            if stepped.kind != NativeStopKind.Paused -> return Ok(stepped)
            if x64_trace_peek(self.trace, pc) == .Val(word) {
                _ := x64_trace_poke(self.trace, pc, word & I64{-256} | I64{NATIVE_DEBUG_TRAP})
            }
            if how == X64TraceResume.Step -> return Ok(stepped)
        }
        self.resume(how)
    }

    // Resume the program as `how` says until it traps or ends; any other
    // signal goes on to the program, as it would untraced.
    resume: fn(&self, how: X64TraceResume) -> NativeEvent NativeDebugError! {
        signal := 0
        loop {
            if !x64_trace_resume(self.trace, how, signal) {
                return Err(NativeDebugError{detail: "the program can't be resumed"})
            }
            status: x64_trace_wait(self.trace)
            if status < 0 {
                return Err(NativeDebugError{detail: "waiting for the program failed (errno {-status})"})
            }
            if status & 0x7f == 0 {
                self.ended()
                return Ok(NativeEvent{kind: NativeStopKind.Exited, code: (status >> 8) & 0xff})
            }
            if status & 0xff != 0x7f {
                self.ended()
                return Ok(NativeEvent{kind: NativeStopKind.Signaled, code: status & 0x7f})
            }
            stopped: (status >> 8) & 0xff
            if stopped == NATIVE_DEBUG_SIGTRAP {
                return Ok(NativeEvent{kind: NativeStopKind.Paused, code: 0})
            }
            // A stop signal stops the program for its tracer alone.
            signal = if stopped == NATIVE_DEBUG_SIGSTOP -> 0 else -> stopped
        }
    }

    // The program is gone: its pid is reaped.
    ended: fn(&self) Never! {
        self.trace.pid = -1
        x64_trace_close(self.trace)
        self.sites = [NativeSite]{}
    }

    // The stop `event` is: a trap byte's breakpoint, rewinding the pc onto
    // it, a trap the program made itself, or its end.
    stopped: fn(&self, event: NativeEvent) -> NativeStop NativeDebugError! {
        if event.kind == {
            .Exited -> Ok(NativeStop{kind: NativeStopKind.Exited, reason: "exited", code: event.code, frame: None})
            .Signaled -> Ok(NativeStop{kind: NativeStopKind.Signaled, reason: native_debug_signal_name(event.code), code: -1, frame: None})
            .Paused -> {
                registers := self.registers() ?? return Err(err)
                at: registers[X64_TRACE_RIP] - 1
                if !self.has_site(at) -> return self.paused("signal SIGTRAP")
                registers[X64_TRACE_RIP] = at
                if !x64_trace_set_registers(self.trace, registers) {
                    return Err(NativeDebugError{detail: "couldn't set the program's registers"})
                }
                if self.breakpoint_at(at) == .Val(number) {
                    return self.paused("breakpoint {number}.1")
                }
                self.paused("signal SIGTRAP")
            }
        }
    }

    // A pause for `reason` where the program is.
    paused: fn(self, reason: String) -> NativeStop NativeDebugError! {
        registers: self.registers() ?? return Err(err)
        Ok(NativeStop{kind: NativeStopKind.Paused, reason: reason, code: 0, frame: Val(native_frame_at(self.image, registers[X64_TRACE_RIP]))})
    }

    // Run the program until the frame whose canonical frame address is `cfa`
    // returns to `address`, or a breakpoint or its end stops it first.
    run_to_return: fn(&self, address: Int, cfa: Int) -> NativeReturn NativeDebugError! {
        temporary: !self.has_site(address)
        if temporary && !self.plant(address) {
            return Err(NativeDebugError{detail: "couldn't write a breakpoint at {native_debug_hex(address)}"})
        }
        loop {
            event: self.go(X64TraceResume.Run) ?? return Err(err)
            if event.kind != NativeStopKind.Paused {
                return Ok(NativeReturn.Stopped{stop: self.stopped(event) ?? return Err(err)})
            }
            registers := self.registers() ?? return Err(err)
            at: registers[X64_TRACE_RIP] - 1
            if !self.has_site(at) {
                if temporary -> self.lift(address)
                return Ok(NativeReturn.Stopped{stop: self.paused("signal SIGTRAP") ?? return Err(err)})
            }
            registers[X64_TRACE_RIP] = at
            if !x64_trace_set_registers(self.trace, registers) {
                return Err(NativeDebugError{detail: "couldn't set the program's registers"})
            }
            if at == address && registers[X64_TRACE_RSP] == cfa {
                if temporary -> self.lift(address)
                return Ok(NativeReturn.Returned)
            }
            if self.breakpoint_at(at) == .Val(number) {
                if temporary -> self.lift(address)
                return Ok(NativeReturn.Stopped{stop: self.paused("breakpoint {number}.1") ?? return Err(err)})
            }
            // The return address trapped for a deeper call of the same
            // function: run on.
        }
    }

    // Step to the next line of this frame, or into the next Jet call's first
    // line when `calls` is Into. A call it does not enter runs to its
    // return; a return out of this frame stops in the caller.
    line_step: fn(&self, calls: NativeStepCalls) -> NativeStop NativeDebugError! {
        self.ready() ?? return Err(err)
        reason: if calls == {
            .Over -> "step over"
            .Into -> "step in"
        }
        registers := self.registers() ?? return Err(err)
        start: registers[X64_TRACE_RIP]
        function: x64_jetline_find(self.image.lines, start)
        if function < 0 -> return self.step_out()
        line: x64_jetline_line(self.image.lines, self.image.lines.functions[function], start) ?? 0
        low_start: self.image.lines.functions[function].low
        base: native_frame_base(self.code(low_start, NATIVE_DEBUG_PROLOGUE), low_start, registers, start, self.code(start, 1))
        loop _ in 0..<NATIVE_DEBUG_MOST_STEPS {
            before: registers
            event: self.go(X64TraceResume.Step) ?? return Err(err)
            if event.kind != NativeStopKind.Paused -> return self.stopped(event)
            registers = self.registers() ?? return Err(err)
            pc := registers[X64_TRACE_RIP]
            if registers[X64_TRACE_RSP] == before[X64_TRACE_RSP] - 8 {
                pushed: native_debug_word(self.trace, registers[X64_TRACE_RSP]) ?? 0
                from: before[X64_TRACE_RIP]
                if pushed > from && pushed <= from + NATIVE_DEBUG_LONGEST_CALL && pc != pushed {
                    callee: x64_jetline_find(self.image.lines, pc)
                    if calls == NativeStepCalls.Over || callee < 0 {
                        returned: self.run_to_return(pushed, registers[X64_TRACE_RSP] + 8) ?? return Err(err)
                        if returned == .Stopped(stop) -> return Ok(stop)
                        registers = self.registers() ?? return Err(err)
                        pc = registers[X64_TRACE_RIP]
                    }
                }
            }
            here: x64_jetline_find(self.image.lines, pc)
            if here < 0 {
                if registers[X64_TRACE_RSP] >= base -> return self.paused(reason)
                next
            }
            low: self.image.lines.functions[here].low
            frame: native_frame_base(self.code(low, NATIVE_DEBUG_PROLOGUE), low, registers, pc, self.code(pc, 1))
            if frame > base -> return self.paused(reason)
            if pc == low || !native_row_start(self.image, here, pc) -> next
            if frame < base -> return self.paused(reason)
            if (x64_jetline_line(self.image.lines, self.image.lines.functions[here], pc) ?? 0) != line || pc <= start {
                return self.paused(reason)
            }
        }
        self.paused(reason)
    }

    // The stack's frames, innermost first, unwound through the prologue each
    // Jet function opens with (`push rbp; mov rbp, rsp`, then a push of each
    // callee-saved register it uses) and the frame-pointer chain elsewhere.
    unwind: fn(self) -> [NativeUnwound] NativeDebugError! {
        registers := self.registers() ?? return Err(err)
        known := loop _ in 0..<registers.len() -> true
        frames := [NativeUnwound]{}
        loop frames.len() < NATIVE_DEBUG_MOST_FRAMES {
            pc: registers[X64_TRACE_RIP]
            lookup: if frames.len() == 0 -> pc else -> pc - 1
            function: x64_jetline_find(self.image.lines, lookup)
            low: if function >= 0 -> self.image.lines.functions[function].low else -> -1
            prologue: if low >= 0 -> self.code(low, NATIVE_DEBUG_PROLOGUE) else -> [U8]{}
            cfa: native_frame_base(prologue, low, registers, pc, self.code(pc, 1))
            frames.push(NativeUnwound{pc: pc, cfa: cfa, registers: registers.copy(), known: known.copy()})
            if cfa <= registers[X64_TRACE_RSP] -> break
            returned: native_debug_word(self.trace, cfa - 8) ?? break
            if returned <= 0 -> break
            caller_rbp: native_caller_rbp(prologue, low, registers, self.trace, pc, self.code(pc, 1)) ?? break
            next_known := loop _ in 0..<registers.len() -> false
            loop index in NATIVE_DEBUG_CALLEE_SAVED -> next_known[index] = known[index]
            loop save in native_prologue_saves(prologue, low) {
                if pc >= save.after && registers[X64_TRACE_RBP] > 0 && low >= 0 && pc != low && pc != low + 1 {
                    if native_debug_word(self.trace, registers[X64_TRACE_RBP] - 8 * (save.slot + 1)) == .Val(saved) {
                        registers[save.register] = saved
                        next_known[save.register] = true
                    }
                }
            }
            registers[X64_TRACE_RIP] = returned
            registers[X64_TRACE_RSP] = cfa
            registers[X64_TRACE_RBP] = caller_rbp
            next_known[X64_TRACE_RIP] = true
            next_known[X64_TRACE_RSP] = true
            next_known[X64_TRACE_RBP] = true
            known = next_known
            if function < 0 && caller_rbp == 0 {
                frames.push(NativeUnwound{pc: returned, cfa: 0, registers: registers.copy(), known: known.copy()})
                break
            }
        }
        Ok(frames)
    }
}

// The trap byte (int3).
NATIVE_DEBUG_TRAP: 0xcc

NATIVE_DEBUG_SIGTRAP: 5

NATIVE_DEBUG_SIGSTOP: 19

// The bytes of a function's start read for its prologue: a stack check, the
// frame's opening and its saves.
NATIVE_DEBUG_PROLOGUE: 48

// The longest x86-64 call instruction.
NATIVE_DEBUG_LONGEST_CALL: 15

// The most instructions one line step single-steps.
NATIVE_DEBUG_MOST_STEPS: 10000000

// The most frames a backtrace unwinds.
NATIVE_DEBUG_MOST_FRAMES: 256

// The registers (as the kernel orders them) a call preserves: r15, r14,
// r13, r12, rbp and rbx.
NATIVE_DEBUG_CALLEE_SAVED: [Int]{0, 1, 2, 3, 4, 5}

// The kernel's register index of each x86-64 register number (rax, rcx,
// rdx, rbx, rsp, rbp, rsi, rdi, r8 to r15).
NATIVE_DEBUG_MACHINE_REGISTERS: [Int]{10, 11, 12, 5, 19, 4, 13, 14, 9, 8, 7, 6, 3, 2, 1, 0}

// The kernel's register index of each DWARF x86-64 register number (rax,
// rdx, rcx, rbx, rsi, rdi, rbp, rsp, r8 to r15, the return address).
NATIVE_DEBUG_DWARF_REGISTERS: [Int]{10, 12, 11, 5, 13, 14, 4, 19, 9, 8, 7, 6, 3, 2, 1, 0, 16}

// One callee-saved register a prologue pushes: its kernel register index,
// the address after the push and its slot below the frame pointer.
NativeSave: struct {
    register: Int,
    after: Int,
    slot: Int,
}

// Where `prologue` (a function's first bytes) opens a frame with `push rbp;
// mov rbp, rsp`: at its start, or past the stack check a body that may grow
// its stack starts with (JetIR X64Select.jet ir_x64_stack_check: an
// optional `lea r11, [rsp - frame]`, `cmp rsp|r11, gs:[limit]` and `jb`);
// -1 when it opens none there.
native_frame_open: fn(prologue: [U8]) -> Int Never! {
    at := 0
    if native_bytes_at(prologue, at, [U8]{0x4c, 0x8d, 0x9c, 0x24}) -> at = 8
    compared: native_bytes_at(prologue, at, [U8]{0x65, 0x48, 0x3b, 0x24, 0x25}) || native_bytes_at(prologue, at, [U8]{0x65, 0x4c, 0x3b, 0x1c, 0x25})
    if !compared && at > 0 -> return -1
    if compared {
        // the jb past the compare: rel32 or, relaxed, rel8
        branch: if {
            native_bytes_at(prologue, at + 9, [U8]{0x0f, 0x82}) -> 6
            native_bytes_at(prologue, at + 9, [U8]{0x72}) -> 2
            else -> 0
        }
        if branch == 0 -> return -1
        at += 9 + branch
    }
    if native_bytes_at(prologue, at, [U8]{0x55, 0x48, 0x89, 0xe5}) -> at else -> -1
}

// Whether `bytes` holds `want` at `at`.
native_bytes_at: fn(bytes: [U8], at: Int, want: [U8]) -> Bool Never! {
    if at + want.len() > bytes.len() -> return false
    loop (k, byte) in want {
        if bytes[at + k] != byte -> return false
    }
    true
}

// The callee-saved registers the prologue pushes after it opens the frame.
native_prologue_saves: fn(prologue: [U8], low: Int) -> [NativeSave] Never! {
    saves := [NativeSave]{}
    open: native_frame_open(prologue)
    if open < 0 -> return saves
    at := open + 4
    loop at < prologue.len() {
        byte: Int{prologue[at]}
        if byte >= 0x50 && byte <= 0x57 {
            saves.push(NativeSave{register: NATIVE_DEBUG_MACHINE_REGISTERS[byte - 0x50], after: low + at + 1, slot: saves.len()})
            at += 1
            next
        }
        if byte == 0x41 && at + 1 < prologue.len() {
            second: Int{prologue[at + 1]}
            if second >= 0x50 && second <= 0x57 {
                saves.push(NativeSave{register: NATIVE_DEBUG_MACHINE_REGISTERS[8 + second - 0x50], after: low + at + 2, slot: saves.len()})
                at += 2
                next
            }
        }
        break
    }
    saves
}

// The canonical frame address of the frame at `pc` whose function starts at
// `low` with `prologue` (low -1: code without Jet line information, where
// the frame pointer chain is trusted); `here` is the code byte at `pc`.
native_frame_base: fn(prologue: [U8], low: Int, registers: [Int], pc: Int, here: [U8]) -> Int Never! {
    rsp: registers[X64_TRACE_RSP]
    rbp: registers[X64_TRACE_RBP]
    open: if low >= 0 -> native_frame_open(prologue) else -> -1
    if open >= 0 {
        if pc >= low && pc <= low + open -> return rsp + 8
        if pc == low + open + 1 -> return rsp + 16
        if here.len() == 1 && here[0] == (U8{0xc3}) -> return rsp + 8
    }
    rbp + 16
}

// The caller's frame pointer, for the frame native_frame_base measured;
// `here` is the code byte at `pc`.
native_caller_rbp: fn(prologue: [U8], low: Int, registers: [Int], trace: X64Trace, pc: Int, here: [U8]) -> Int? Never! {
    rsp: registers[X64_TRACE_RSP]
    rbp: registers[X64_TRACE_RBP]
    open: if low >= 0 -> native_frame_open(prologue) else -> -1
    if open >= 0 {
        if pc >= low && pc <= low + open -> return Val(rbp)
        if pc == low + open + 1 -> return native_debug_word(trace, rsp)
        if here.len() == 1 && here[0] == (U8{0xc3}) -> return Val(rbp)
    }
    if rbp <= 0 -> return None
    native_debug_word(trace, rbp)
}

// The word of the stopped program at `address`.
native_debug_word: fn(trace: X64Trace, address: Int) -> Int? Never! {
    word: x64_trace_peek(trace, address) ?? return None
    Val(Int{word})
}

// The addresses of `line` in the Jet source `file` (by base name): in each
// function with code on it, the first row of the line, else of the nearest
// later line the function has code on; a row at the function's start moves
// past its prologue.
native_line_addresses: fn(image: NativeImage, file: String, line: Int) -> [Int] Never! {
    wanted: native_files.basename(file)
    addresses := [Int]{}
    loop (index, function) in image.lines.functions {
        if native_files.basename(function.file) != wanted -> next
        exact := -1
        nearest := -1
        nearest_line := 0
        covers := false
        at := function.rows
        address := function.low
        current := 1
        loop at < function.rows_end {
            address += link_debug_uleb(image.lines.table, at)
            current += x64_jetline_sleb(image.lines.table, at)
            if current <= line -> covers = true
            if current == line && exact < 0 -> exact = address
            if current > line && (nearest < 0 || current < nearest_line) {
                nearest = address
                nearest_line = current
            }
        }
        found: if {
            exact >= 0 -> exact
            covers -> nearest
            else -> -1
        }
        if found < 0 -> next
        addresses.push(if found == function.low -> native_body_start(image, index) else -> found)
    }
    addresses
}

// The first address past function `index`'s prologue: its second row, or
// its start when it has one row.
native_body_start: fn(image: NativeImage, index: Int) -> Int Never! {
    function: image.lines.functions[index]
    at := function.rows
    address := function.low
    loop at < function.rows_end {
        address += link_debug_uleb(image.lines.table, at)
        _ := x64_jetline_sleb(image.lines.table, at)
        if address > function.low -> return address
    }
    function.low
}

// Whether `pc` starts a row of function `index`.
native_row_start: fn(image: NativeImage, index: Int, pc: Int) -> Bool Never! {
    function: image.lines.functions[index]
    at := function.rows
    address := function.low
    loop at < function.rows_end {
        address += link_debug_uleb(image.lines.table, at)
        _ := x64_jetline_sleb(image.lines.table, at)
        if address == pc -> return true
        if address > pc -> return false
    }
    false
}

// The frame `lookup` lies in: its Jet function, file and line, or, outside
// Jet code, the DWARF function's name (`?` without one) and line 0.
native_frame_at: fn(image: NativeImage, lookup: Int) -> NativeFrame Never! {
    index: x64_jetline_find(image.lines, lookup)
    if index >= 0 {
        function: image.lines.functions[index]
        return NativeFrame{function: function.name, file: native_files.basename(function.file), line: x64_jetline_line(image.lines, function, lookup) ?? 0}
    }
    named: native_function_at(image, lookup) ?? return NativeFrame{function: "?", file: "", line: 0}
    NativeFrame{function: named.name, file: "", line: 0}
}

// The name of signal `signal`.
native_debug_signal_name: fn(signal: Int) -> String Never! {
    if signal == {
        1 -> "SIGHUP"
        2 -> "SIGINT"
        3 -> "SIGQUIT"
        4 -> "SIGILL"
        5 -> "SIGTRAP"
        6 -> "SIGABRT"
        7 -> "SIGBUS"
        8 -> "SIGFPE"
        9 -> "SIGKILL"
        11 -> "SIGSEGV"
        13 -> "SIGPIPE"
        14 -> "SIGALRM"
        15 -> "SIGTERM"
        else -> "signal {signal}"
    }
}

native_debug_hex: fn(value: Int) -> String Never! {
    digits := [U8]{}
    rest := value
    loop {
        digit: rest & 15
        digits.insert(0, U8{if digit < 10 -> 48 + digit else -> 87 + digit})
        rest = rest >> 4
        if rest <= 0 -> break
    }
    "0x{String.from_bytes(digits) ?? ""}"
}

// The command that builds `entry` as the debuggable native image: this `jet`
// (`jet`), unoptimized, with its DWARF and the deep checks `deep_checks`
// selects, into `out_dir`.
native_debug_build_argv: fn(jet: String, entry: String, out_dir: String, deep_checks: DeepChecks) -> [String] Never! {
    argv := [String]{jet, "build", "-O0"}
    loop word in deep_checks_flags(deep_checks) -> argv.push(word)
    argv.push("--output-dir={out_dir}")
    argv.push(entry.copy())  // copy: the command owns its words.
    argv
}

// The image `native_debug_build_argv` writes: the entry's stem in `out_dir`.
native_debug_image: fn(entry: String, out_dir: String) -> String Never! {
    native_files.join(out_dir, native_files.basename(entry).before(".jet"))
}

// The `(Jet)` console over a session: `jet debug` and the Canvas native tier
// both speak it. Every stop prints the Jet source line with its `<- here`
// caret and the frame's locals; frames without Jet line information (the
// runtime) are never shown. Each readout starts with a capital.
NATIVE_DEBUG_HELP: "Commands: step (s), next (n), continue (c), finish (f), break N (b N), locals, print NAME (p NAME), backtrace (bt), help (h), quit (q)"

// The console's prompt.
NATIVE_DEBUG_PROMPT: "(Jet) "

// The label of the line that lists the frame's locals; the Canvas native tier
// reads the locals back from it.
NATIVE_DEBUG_LOCALS_LABEL: "Locals:"

// The start of the line a breakpoint stop prints; the Canvas native tier reads
// the stop's line back from it.
NATIVE_DEBUG_BREAKPOINT_HIT: "Breakpoint hit"

// The value shown for a local the image's debug information cannot show.
NATIVE_DEBUG_UNAVAILABLE: "<Unavailable>"

// The deepest run of runtime frames a step finishes out of before it lets the
// program continue.
NATIVE_DEBUG_RUNTIME_DEPTH: 16

// The most list elements and String bytes a readout shows.
NATIVE_DEBUG_SHOWN_ITEMS: 16

NATIVE_DEBUG_SHOWN_BYTES: 256

// The method a DebugView implements, and the type of the items it returns.
NATIVE_DEBUG_VIEW: "debug_view"

NATIVE_DEBUG_VIEW_ITEM: "DebugItem"

// The bytes below the stack pointer a function may use without moving it
// (the System V red zone): an inferior call leaves them alone.
NATIVE_DEBUG_RED_ZONE: 128

// How deep a readout follows a value's members and elements.
NATIVE_DEBUG_SHOWN_DEPTH: 4

// What one console command printed, and where it left the program.
NativeDebugStep: struct {
    text: String,
    stop: NativeStop,
}

native_debug_stop_in_jet: fn(frame: NativeFrame?) -> Bool Never! {
    if frame == .Val(found) -> return native_debug_jet_frame(found)
    false
}

native_debug_jet_frame: fn(frame: NativeFrame) -> Bool Never! {
    frame.file.ends_with(".jet") && frame.line > 0
}

// NATIVE_DEBUG_LOCALS_LABEL and the frame's locals by name.
native_debug_locals_line: fn(locals: [NativeLocal]) -> String Never! {
    if locals.len() == 0 -> return "{NATIVE_DEBUG_LOCALS_LABEL}  (none)"
    sorted := locals.copy()
    sorted.sort_by(fn(left: NativeLocal, right: NativeLocal) { left.name <=> right.name })
    shown := [String]{}
    loop local in sorted -> shown.push("{local.name} = {local.value}")
    "{NATIVE_DEBUG_LOCALS_LABEL}  {shown.join("   ")}"
}

// The frame's locals, one a line with its Jet type (`total: Int = 6`).
native_debug_locals_typed: fn(locals: [NativeLocal]) -> String Never! {
    if locals.len() == 0 -> return "No locals here\n"
    text := ""
    loop local in locals -> text = "{text}{local.name}: {local.type_name} = {local.value}\n"
    text
}

native_debug_print: fn(locals: [NativeLocal], name: String) -> String Never! {
    if name == "" -> return "Print needs a local's name, as `print total`"
    loop local in locals {
        if local.name == name -> return "{local.name} = {local.value}"
    }
    "`{name}` is not a local here"
}

// The Jet frames, innermost first.
native_debug_backtrace: fn(frames: [NativeFrame]) -> String Never! {
    text := ""
    index := 0
    loop frame in frames {
        if !native_debug_jet_frame(frame) -> next
        text = "{text}#{index}  {frame.function}()  at {frame.file}:{frame.line}\n"
        index += 1
    }
    text
}

// The breakpoint a `breakpoint N.M` stop reason names.
native_debug_hit_breakpoint: fn(stop: NativeStop) -> Int? Never! {
    if !stop.reason.starts_with("breakpoint ") -> return None
    number: Int.parse(stop.reason.after("breakpoint ").before(".")) ?? return None
    Val(number)
}

// Bytes a readout may read: the stopped program's memory, when there is a
// program, and `blocks` (each its bytes from its address) before it.
NativeMemory: struct {
    trace: X64Trace?,
    blocks: [NativeBlock],
}

// Known bytes from `address`.
NativeBlock: struct {
    address: Int,
    bytes: [U8],
}

// The parameters and locals live at `lookup` in `frame`, rendered as Jet
// values; a variable the image gives no location shows as unavailable.
native_frame_locals: fn(image: NativeImage, memory: NativeMemory, frame: NativeUnwound, lookup: Int) -> [NativeLocal] Never! {
    locals := [NativeLocal]{}
    function: native_function_at(image, lookup) ?? return locals
    loop variable in function.variables {
        type_name: native_type_name(image, variable.ty)
        if variable.list < 0 {
            locals.push(NativeLocal{name: variable.name, type_name: type_name, value: NATIVE_DEBUG_UNAVAILABLE})
            next
        }
        located: native_variable_covering(image, variable, lookup) ?? next
        value: native_variable_value(image, memory, frame, located, variable.ty) ?? NATIVE_DEBUG_UNAVAILABLE
        locals.push(NativeLocal{name: variable.name, type_name: type_name, value: value})
    }
    locals
}

// The first range of `variable`'s location list that covers `lookup`.
native_variable_covering: fn(image: NativeImage, variable: NativeVariable, lookup: Int) -> NativeRange? Never! {
    loop range in native_ranges(image, variable.list, variable.base) {
        if lookup >= range.start && lookup < range.end -> return Val(range)
    }
    None
}

// The value of type `ty` the location expression of `range` names in
// `frame`; None when it is out of reach.
native_variable_value: fn(image: NativeImage, memory: NativeMemory, frame: NativeUnwound, range: NativeRange, ty: Int) -> String? Never! {
    size: native_type_size(image, ty)
    if size <= 0 -> return None
    bytes: native_place_bytes(memory, frame, image.loclists, range.from, range.to, size) ?? return None
    native_render(image, memory, ty, bytes, 0, 0)
}

// The `size` bytes the DWARF expression `bytes[from..<to]` locates in
// `frame`: a register's (DW_OP_reg*, DW_OP_regx), or those at an address
// from a register or the frame base, rbp (DW_OP_breg*, DW_OP_bregx,
// DW_OP_fbreg), then DW_OP_deref, or that address itself
// (DW_OP_stack_value).
native_place_bytes: fn(memory: NativeMemory, frame: NativeUnwound, bytes: [U8], from: Int, to: Int, size: Int) -> [U8]? Never! {
    if from >= to || to > bytes.len() -> return None
    op: Int{bytes[from]}
    at := from + 1
    address := 0
    if {
        op >= 0x50 && op <= 0x6f -> return native_register_bytes(frame, op - 0x50)
        op == 0x90 -> return native_register_bytes(frame, link_debug_uleb(bytes, at))
        op >= 0x70 && op <= 0x8f -> {
            base: native_register_value(frame, op - 0x70) ?? return None
            address = base + x64_jetline_sleb(bytes, at)
        }
        op == 0x92 -> {
            register: link_debug_uleb(bytes, at)
            base: native_register_value(frame, register) ?? return None
            address = base + x64_jetline_sleb(bytes, at)
        }
        op == 0x91 -> {
            if !frame.known[X64_TRACE_RBP] -> return None
            address = frame.registers[X64_TRACE_RBP] + x64_jetline_sleb(bytes, at)
        }
        else -> return None
    }
    if at >= to -> return native_debug_bytes(memory, address, size)
    then: Int{bytes[at]}
    if then == {
        0x06 -> {
            words: native_debug_bytes(memory, address, 8) ?? return None
            native_debug_bytes(memory, native_number(words, 0, 8, X64DebugEncoding.Signed), size)
        }
        0x9f -> Val(native_word_bytes(address))
        else -> None
    }
}

// The 8 bytes of DWARF register `register` in `frame`, when known.
native_register_bytes: fn(frame: NativeUnwound, register: Int) -> [U8]? Never! {
    word: native_register_value(frame, register) ?? return None
    Val(native_word_bytes(word))
}

native_register_value: fn(frame: NativeUnwound, register: Int) -> Int? Never! {
    if register < 0 || register >= NATIVE_DEBUG_DWARF_REGISTERS.len() -> return None
    index: NATIVE_DEBUG_DWARF_REGISTERS[register]
    if !frame.known[index] -> return None
    Val(frame.registers[index])
}

// The 8 little-endian bytes of `word`.
native_word_bytes: fn(word: Int) -> [U8] Never! {
    loop k in 0..<8 -> U8{(word >> (8 * k)) & 255}
}

// The number of `size` little-endian bytes of `bytes` from `at`, signed as
// `encoding` says.
native_number: fn(bytes: [U8], at: Int, size: Int, encoding: X64DebugEncoding) -> Int Never! {
    value := 0
    loop k in 0..<size {
        index: at + size - 1 - k
        if index < bytes.len() -> value = value * 256 + Int{bytes[index]}
    }
    if encoding == X64DebugEncoding.Signed && size > 0 && size <= 8 {
        top: 1 << (8 * size)
        if value >= top >> 1 -> value -= top
    }
    value
}

// `count` bytes from `address`; None when any is unreadable.
native_debug_bytes: fn(memory: NativeMemory, address: Int, count: Int) -> [U8]? Never! {
    if address <= 0 || count < 0 -> return None
    held: loop index in 0..<memory.blocks.len() {
        block: memory.blocks[index]
        if address >= block.address && address + count <= block.address + block.bytes.len() {
            break index
        }
    } ?? -1
    if held >= 0 {
        from: address - memory.blocks[held].address
        return Val(memory.blocks[held].bytes[from..<from + count])
    }
    trace: memory.trace ?? return None
    if trace.pid <= 0 -> return None
    bytes: x64_trace_read(trace, address, count) ?? return None
    if bytes.len() != count -> return None
    Val(bytes)
}

// `count` units of `size` bytes from `address` (8: signed, else unsigned).
native_debug_read: fn(memory: NativeMemory, address: Int, size: Int, count: Int) -> [Int]? Never! {
    bytes: native_debug_bytes(memory, address, size * count) ?? return None
    encoding: if size == 8 -> X64DebugEncoding.Signed else -> X64DebugEncoding.Unsigned
    Val(loop k in 0..<count -> native_number(bytes, k * size, size, encoding))
}

// The Jet name of type `ty`: its name without module paths, `Pointer` for
// an unnamed pointer.
native_type_name: fn(image: NativeImage, ty: Int) -> String Never! {
    found: image.types.get(ty) ?? return "?"
    if found.name == "" -> return "Pointer"
    native_jet_spelling(found.name)
}

// `name` without the module path before each `::` in it: `[main::Point]`
// is `[Point]`, `<corelib>/core.math::Decimal` is `Decimal`, and a source
// type's key `module:<len>:<package>:<path>::Point` is `Point`
// (diagnostic_display_identities, as a diagnostic prints it).
native_jet_spelling: fn(name: String) -> String Never! {
    shown: diagnostic_display_identities(name, [String]{})
    bytes: shown.bytes()
    corelib: "<corelib>".bytes()
    colon: U8{58}
    kept := [U8]{}
    // Where in `kept` the run of path bytes before the next `::` starts.
    run := 0
    k := 0
    loop k < bytes.len() {
        if k + 1 < bytes.len() && bytes[k] == colon && bytes[k + 1] == colon {
            loop kept.len() > run -> _: kept.pop()
            if native_bytes_end_with(kept, corelib) {
                loop _ in 0..<corelib.len() -> _: kept.pop()
            }
            run = kept.len()
            k += 2
            next
        }
        kept.push(bytes[k])
        if !native_path_byte(bytes[k]) -> run = kept.len()
        k += 1
    }
    String.from_bytes(kept) ?? shown
}

// Whether `bytes` ends with `suffix`.
native_bytes_end_with: fn(bytes: [U8], suffix: [U8]) -> Bool Never! {
    if bytes.len() < suffix.len() -> return false
    from: bytes.len() - suffix.len()
    loop k in 0..<suffix.len() {
        if bytes[from + k] != suffix[k] -> return false
    }
    true
}

// Whether `byte` may be part of a module path: a letter, digit, `_`, `.`
// or `/`.
native_path_byte: fn(byte: U8) -> Bool Never! {
    code: Int{byte}
    (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95 || code == 46 || code == 47
}

// The byte size of type `ty`, through typedefs.
native_type_size: fn(image: NativeImage, ty: Int) -> Int Never! {
    found: image.types.get(ty) ?? return 0
    if found.size > 0 -> return found.size
    if found.tag == NATIVE_TAG_TYPEDEF -> return native_type_size(image, found.target)
    found.size
}

// The value of type `ty` whose bytes start at `at` in `bytes`, as Jet shows
// it; None when the image's types or the memory it points to can't show it.
native_render: fn(image: NativeImage, memory: NativeMemory, ty: Int, bytes: [U8], at: Int, depth: Int) -> String? Never! {
    found: image.types.get(ty) ?? return None
    if depth > NATIVE_DEBUG_SHOWN_DEPTH -> return Val("…")
    word: native_number(bytes, at, if bytes.len() - at < 8 -> bytes.len() - at else -> 8, X64DebugEncoding.Signed)
    if {
        // A typedef names a language type (foundation_named_type, the one
        // source of the scalar spellings) or a precise number's handle.
        found.tag == NATIVE_TAG_TYPEDEF -> if foundation_named_type(found.name) == {
            .Int -> {
                value: native_debug_int(word, memory) ?? return None
                Val("{value}")
            }
            .String -> native_debug_string(word, memory)
            .Named(_) -> if found.name == "Decimal" || found.name == "Fraction" -> native_debug_precise(found.name, word, memory) else -> native_render(image, memory, found.target, bytes, at, depth)
            .Float | .Bool | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> native_render(image, memory, found.target, bytes, at, depth)
        }
        found.tag == NATIVE_TAG_BASE -> if found.encoding == {
            .Bool -> Val(if word & 255 != 0 -> "true" else -> "false")
            .Signed | .Unsigned -> Val("{native_number(bytes, at, found.size, found.encoding)}")
            .Float -> {
                if found.size == 4 {
                    return Val("{native_math.f32_from_bits(U32{native_number(bytes, at, 4, X64DebugEncoding.Unsigned)})}")
                }
                Val("{native_math.from_bits(word)}")
            }
            .Char -> native_debug_char(native_number(bytes, at, 4, X64DebugEncoding.Unsigned))
        }
        found.tag == NATIVE_TAG_POINTER -> {
            // A typed pointer shows what it points to; an untyped or null
            // one its address.
            size: native_type_size(image, found.target)
            if found.target < 0 || word == 0 || size <= 0 -> return Val(native_debug_hex(word))
            pointed: native_debug_bytes(memory, word, size) ?? return Val(native_debug_hex(word))
            native_render(image, memory, found.target, pointed, 0, depth + 1)
        }
        found.tag == NATIVE_TAG_STRUCT && found.variants >= 0 -> native_debug_variant(image, memory, image.variants[found.variants], bytes, at, depth)
        found.tag == NATIVE_TAG_STRUCT && found.group >= 0 -> {
            group: found.group
            if found.name.starts_with("[") && found.name.ends_with("]") {
                return native_debug_list(image, memory, image.members[group], bytes, at, depth)
            }
            fields: native_debug_fields(image, memory, image.members[group], bytes, at, depth) ?? return None
            // A record or tuple type is spelled by its fields, `{n: Int}` or
            // `(n: Int)` as its carrier identity, so its value is too.
            if found.name.starts_with("{{") || found.name.starts_with("(") {
                return Val("{{{fields.join(", ")}}}")
            }
            Val("{native_type_name(image, ty)}{{{fields.join(", ")}}}")
        }
        found.tag == NATIVE_TAG_ENUM -> {
            value: native_number(bytes, at, found.size, X64DebugEncoding.Signed)
            loop enumerator in image.enumerators[found.group] {
                if enumerator.value == value {
                    return Val("{native_type_name(image, ty)}.{enumerator.name}")
                }
            }
            None
        }
        // A union or an opaque struct has no Jet value to show.
        else -> None
    }
}

// Each of `members` of the value at `at` in `bytes`, as `name: value`, or
// the value alone for an unnamed member.
native_debug_fields: fn(image: NativeImage, memory: NativeMemory, members: [NativeMember], bytes: [U8], at: Int, depth: Int) -> [String]? Never! {
    fields := [String]{}
    loop member in members {
        size: native_type_size(image, member.ty)
        if at + member.offset + size > bytes.len() -> return None
        shown: native_render(image, memory, member.ty, bytes, at + member.offset, depth + 1) ?? NATIVE_DEBUG_UNAVAILABLE
        fields.push(if member.name == "" -> shown else -> "{member.name}: {shown}")
    }
    Val(fields)
}

// The value at `at` in `bytes` of a type with a variant part, as Jet
// spells the variant its discriminant selects: the payload alone for an
// unnamed variant (a present Option's value, a union's member), the
// variant's name for one without a payload, `Name(a, b)` for positional
// payloads and `Name{f: a}` for named ones.
native_debug_variant: fn(image: NativeImage, memory: NativeMemory, part: NativeVariants, bytes: [U8], at: Int, depth: Int) -> String? Never! {
    selector: part.discriminant
    width: native_type_size(image, selector.ty)
    if width <= 0 || at + selector.offset + width > bytes.len() -> return None
    selected: native_number(bytes, at + selector.offset, width, X64DebugEncoding.Signed)
    chosen: loop variant in part.arms {
        if variant.value == .Val(value) && value == selected {
            break variant.member
        }
    } ?? loop variant in part.arms {
        if variant.value == None {
            break variant.member
        }
    } ?? return None
    if chosen.ty < 0 -> return None
    if chosen.name == "" {
        if at + chosen.offset + native_type_size(image, chosen.ty) > bytes.len() -> return None
        return native_render(image, memory, chosen.ty, bytes, at + chosen.offset, depth)
    }
    payload: image.types.get(chosen.ty) ?? return None
    shown: native_jet_spelling(chosen.name)
    if payload.group < 0 || image.members[payload.group].len() == 0 -> return Val(shown)
    fields: native_debug_fields(image, memory, image.members[payload.group], bytes, at + chosen.offset, depth + 1) ?? return None
    positional: loop member in image.members[payload.group] {
        if member.name != "" {
            break false
        }
    } ?? true
    if positional -> return Val("{shown}({fields.join(", ")})")
    Val("{shown}{{{fields.join(", ")}}}")
}

// A List whose inline header [len, cap, data] starts at `at` in `bytes`: its
// first NATIVE_DEBUG_SHOWN_ITEMS elements, each as its element type shows it.
native_debug_list: fn(image: NativeImage, memory: NativeMemory, members: [NativeMember], bytes: [U8], at: Int, depth: Int) -> String? Never! {
    length := -1
    data := 0
    element := -1
    loop member in members {
        if at + member.offset + 8 > bytes.len() -> return None
        if member.name == "len" {
            length = native_number(bytes, at + member.offset, 8, X64DebugEncoding.Signed)
        }
        if member.name == "data" {
            data = native_number(bytes, at + member.offset, 8, X64DebugEncoding.Signed)
            found: image.types.get(member.ty) ?? return None
            if found.tag == NATIVE_TAG_POINTER -> element = found.target
        }
    }
    if length < 0 -> return None
    if length == 0 -> return Val("[]")
    size: native_type_size(image, element)
    if data == 0 || size <= 0 -> return None
    shown: if length > NATIVE_DEBUG_SHOWN_ITEMS -> NATIVE_DEBUG_SHOWN_ITEMS else -> length
    stored: native_debug_bytes(memory, data, size * shown) ?? return None
    items := [String]{}
    loop k in 0..<shown {
        items.push(native_render(image, memory, element, stored, k * size, depth + 1) ?? NATIVE_DEBUG_UNAVAILABLE)
    }
    if length > shown -> items.push("… {length - shown} more")
    Val("[{items.join(", ")}]")
}

// The Char with code point `code`, quoted.
native_debug_char: fn(code: Int) -> String? Never! {
    if code < 0 || code > 0x10ffff -> return None
    bytes: if {
        code < 0x80 -> [U8]{U8{code}}
        code < 0x800 -> [U8]{U8{0xc0 + (code >> 6)}, U8{0x80 + (code & 63)}}
        code < 0x10000 -> [U8]{U8{0xe0 + (code >> 12)}, U8{0x80 + ((code >> 6) & 63)}, U8{0x80 + (code & 63)}}
        else -> [U8]{U8{0xf0 + (code >> 18)}, U8{0x80 + ((code >> 12) & 63)}, U8{0x80 + ((code >> 6) & 63)}, U8{0x80 + (code & 63)}}
    }
    text: String.from_bytes(bytes) ?? return None
    Val("'{text}'")
}

// The exact Int whose word is `word`: the word itself when inline (its bits
// 63 and 62 agree), else the carrier at `word` without bit 62: sign at 16,
// limbs at 24 and their count at 32, u32 limbs base 1e9 least significant
// first (JetRuntime Int.jet).
native_debug_int: fn(word: Int, memory: NativeMemory) -> Int? Never! {
    bit62: 4611686018427387904
    if word >= -bit62 && word < bit62 -> return Val(word)
    if word < 0 -> return None
    carrier: native_debug_read(memory, word - bit62, 8, 5) ?? return None
    count: carrier[4]
    if count < 1 || count > 1000000 -> return None
    limbs: native_debug_read(memory, carrier[3], 4, count) ?? return None
    value := 0
    at := count - 1
    loop at >= 0 {
        value = value * 1000000000 + limbs[at]
        at -= 1
    }
    Val(if carrier[2] != 0 -> -value else -> value)
}

// The String whose header [data, byte length, cap] is at `address`, quoted,
// its first NATIVE_DEBUG_SHOWN_BYTES bytes shown.
native_debug_string: fn(address: Int, memory: NativeMemory) -> String? Never! {
    native_debug_text(address, memory, true)
}

// The String whose header is at `address`, as a Jet string literal when
// `quoted`, else as its own text: its first NATIVE_DEBUG_SHOWN_BYTES bytes,
// then its length when it has more.
native_debug_text: fn(address: Int, memory: NativeMemory, quoted: Bool) -> String? Never! {
    header: native_debug_read(memory, address, 8, 2) ?? return None
    length: header[1]
    if length < 0 -> return None
    shown: if length > NATIVE_DEBUG_SHOWN_BYTES -> NATIVE_DEBUG_SHOWN_BYTES else -> length
    bytes: if shown == 0 -> [U8]{} else -> native_debug_bytes(memory, header[0], shown) ?? return None
    lossy: String.from_bytes_lossy(bytes)
    text: if quoted -> native_debug_text_literal(lossy) else -> lossy
    if length > shown -> return Val("{text}… ({length} bytes)")
    Val(text)
}

// The code address of the `debug_view` the image keeps for the struct type
// `ty`: the subprogram of that name whose one parameter, `self`, is of that
// type. A struct goes to a call as its address, so the debugger can call
// the view on a copy of a value (NativeSession.view).
native_debug_view_at: fn(image: NativeImage, ty: Int) -> Int? Never! {
    found: image.types.get(ty) ?? return None
    if found.tag != NATIVE_TAG_STRUCT || found.name.starts_with("[") -> return None
    loop function in image.functions {
        if function.name != NATIVE_DEBUG_VIEW -> next
        parameters := 0
        matched := false
        loop variable in function.variables {
            if variable.role != NativeVariableRole.Parameter -> next
            parameters += 1
            typed: image.types.get(variable.ty) ?? next
            if variable.name == "self" && typed.name == found.name -> matched = true
        }
        if parameters == 1 && matched -> return Val(function.low)
    }
    None
}

// A value of type `ty` as its view shows it, from the [DebugItem] list
// header its `debug_view` wrote at `address`: `Name{label: value, …}`, the
// first NATIVE_DEBUG_SHOWN_ITEMS items, each label and value as its text.
native_debug_view_shown: fn(image: NativeImage, memory: NativeMemory, ty: Int, address: Int) -> String? Never! {
    list: native_debug_view_list(image) ?? return None
    header: native_debug_bytes(memory, address, native_type_size(image, list)) ?? return None
    length := -1
    data := 0
    item := -1
    loop member in image.members[(image.types.get(list) ?? return None).group] {
        if member.name == "len" {
            length = native_number(header, member.offset, 8, X64DebugEncoding.Signed)
        }
        if member.name == "data" {
            data = native_number(header, member.offset, 8, X64DebugEncoding.Signed)
            item = (image.types.get(member.ty) ?? return None).target
        }
    }
    found: image.types.get(item) ?? return None
    size: native_type_size(image, item)
    if length < 0 || size <= 0 || found.group < 0 -> return None
    shown: if length > NATIVE_DEBUG_SHOWN_ITEMS -> NATIVE_DEBUG_SHOWN_ITEMS else -> length
    stored: if shown == 0 -> [U8]{} else -> native_debug_bytes(memory, data, size * shown) ?? return None
    items := [String]{}
    loop k in 0..<shown {
        label := NATIVE_DEBUG_UNAVAILABLE
        value := NATIVE_DEBUG_UNAVAILABLE
        loop member in image.members[found.group] {
            text: native_debug_text(native_number(stored, k * size + member.offset, 8, X64DebugEncoding.Signed), memory, false) ?? NATIVE_DEBUG_UNAVAILABLE
            if member.name == "label" -> label = text
            if member.name == "value" -> value = text
        }
        items.push("{label}: {value}")
    }
    if length > shown -> items.push("… {length - shown} more")
    Val("{native_type_name(image, ty)}{{{items.join(", ")}}}")
}

// The image's [DebugItem] list type, the one every `debug_view` returns.
native_debug_view_list: fn(image: NativeImage) -> Int? Never! {
    loop (offset, found) in image.types {
        if found.tag != NATIVE_TAG_STRUCT || found.group < 0 || !found.name.starts_with("[") -> next
        loop member in image.members[found.group] {
            if member.name != "data" -> next
            pointer: image.types.get(member.ty) ?? next
            if pointer.tag == NATIVE_TAG_POINTER && native_type_name(image, pointer.target) == NATIVE_DEBUG_VIEW_ITEM {
                return Val(offset)
            }
        }
    }
    None
}

// `text` as a Jet string literal.
native_debug_text_literal: fn(text: String) -> String Never! {
    "\"{text.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")}\""
}

// A Decimal or Fraction whose runtime handle (two exact Ints: coefficient
// and scale, or numerator and denominator) is at `address`.
native_debug_precise: fn(type_name: String, address: Int, memory: NativeMemory) -> String? Never! {
    words: native_debug_read(memory, address, 8, 2) ?? return None
    first: native_debug_int(words[0], memory) ?? return None
    if type_name == "Fraction" {
        second: native_debug_int(words[1], memory) ?? return None
        return Val("{first}/{second}")
    }
    Val(native_debug_decimal_text(first, words[1]))
}

// A Decimal's text: `coefficient` with `scale` digits after the point.
native_debug_decimal_text: fn(coefficient: Int, scale: Int) -> String Never! {
    sign: if coefficient < 0 -> "-" else -> ""
    digits := "{if coefficient < 0 -> -coefficient else -> coefficient}"
    if scale <= 0 -> return "{sign}{digits}"
    loop digits.len() <= scale -> digits = "0{digits}"
    split: digits.len() - scale
    bytes: digits.bytes()
    whole: String.from_bytes(bytes[0..<split]) ?? ""
    fraction: String.from_bytes(bytes[split..<bytes.len()]) ?? ""
    "{sign}{whole}.{fraction}"
}
