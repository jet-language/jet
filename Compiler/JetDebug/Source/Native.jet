// The native debug session: Jet drives the program's own native image,
// built at `optimize: O0` with `debug_info: true`, itself. The program runs
// traced (JetBackend Image/Loader.jet); breakpoints are trap bytes written
// into its code, steps are single instructions, and every stop is read
// through the image's own debug facts (NativeFacts.jet): the Jet location
// table names the function, file and line, the DWARF names the locals,
// where each lives and its type. No outside debugger takes part.
use {
    native_files: core.files
    native_math: core.math
    jet_backend.[X64DebugEncoding, X64Trace, X64TraceResume, X64_OBSERVE_ROOT_SYMBOL, X64_TRACE_EVENT_CLONE, X64_TRACE_EVENT_STOP, X64_TRACE_GS_BASE, X64_TRACE_ORIG_RAX, X64_TRACE_RBP, X64_TRACE_RDI, X64_TRACE_RIP, X64_TRACE_RSI, X64_TRACE_RSP, link_debug_uleb, x64_jetline_find, x64_jetline_line, x64_jetline_sleb, x64_jetline_text, x64_trace_attach, x64_trace_close, x64_trace_debug_register, x64_trace_detach, x64_trace_peek, x64_trace_poke, x64_trace_read, x64_trace_registers, x64_trace_resume, x64_trace_seize, x64_trace_set_debug_register, x64_trace_set_registers, x64_trace_spawn, x64_trace_stop, x64_trace_wait, x64_trace_wait_for, x64_trace_write]
    jet_foundation.[DeepChecks, Diagnostic, deep_checks_flags, diagnostic_display_identities, diagnostic_from_registry, diagnostic_registry_row, foundation_named_type]
}

#Error
NativeDebugError: struct {
    detail: String,

    // E2203, the registered failure of the native debugger.
    diagnostic: fn(self) -> Diagnostic Never! { native_debug_unavailable(self.detail) }
}

// E2203 with `detail` as the reason the native debugger could not run.
native_debug_unavailable: fn(detail: String) -> Diagnostic Never! {
    native_debug_report("E2203", detail)
}

// The registered diagnostic `code` with `detail` in its `{detail}` hole.
native_debug_report: fn(code: String, detail: String) -> Diagnostic Never! {
    row: diagnostic_registry_row(code) ?? panic("{code} is not registered")
    diagnostic_from_registry(code, None, row.what.replace("{{detail}}", detail), row.why, row.fix)
}

// Why `jet debug` did not attach to a process: its target is not one it
// can take as given (NATIVE_ATTACH_INVALID: no such process, or not the
// program named), or attaching failed (NATIVE_ATTACH_FAILED: the system
// refused the trace, or the process runs no Jet debug image). The process
// is left as it was.
#Error
NativeAttachRefused: struct {
    code: String,
    detail: String,

    diagnostic: fn(self) -> Diagnostic Never! { native_debug_report(self.code, self.detail) }
}

NATIVE_ATTACH_INVALID: "E2236"

NATIVE_ATTACH_FAILED: "E2231"

// One frame of a stop: the Jet function and its source position, or a frame
// without line information (the runtime's start code) with line 0. An
// `inlined` frame is code the optimizer inlined into the frame below it,
// which shows the call at its line. A caller's frame whose call has a
// call-site row (NativeImage.calls) shows the line and character `column`
// of the call's source node; `column` is 0 when the frame names a line only.
NativeFrame: struct {
    function: String,
    file: String,
    line: Int,
    inlined: Bool,
    column: Int{0},
}

// One frame a backtrace shows, against the frames the unwinder found: the
// unwound frame `frame`, and in it the inlined run `site` (a
// NativeFunction.inlined index), -1 for the function's own frame.
NativeLevel: struct {
    frame: Int,
    site: Int,
}

// One local of the selected frame, in Jet terms. A value the image's debug
// information cannot show is NATIVE_DEBUG_UNAVAILABLE.
NativeLocal: struct {
    name: String,
    type_name: String,
    value: String,
}

NativeStopKind: enum {
    Paused,
    Exited,
    Signaled,
}

// Where a run-control command left the program: paused at `frame` for
// `reason`, exited with `code`, or ended by the signal named in `reason`.
NativeStop: struct {
    kind: NativeStopKind,
    reason: String,
    code: Int,
    frame: NativeFrame?,
}

// A breakpoint `jet debug --break` asks for: a Jet source file's base name,
// as the line table names it, and a line of it.
NativeBreak: struct {
    file: String,
    line: Int,
}

// A breakpoint: its number and the code addresses it traps.
NativeBreakpoint: struct {
    number: Int,
    addresses: [Int],
}

// What a breakpoint does when it is hit: stop when its condition holds (or
// it has none), or log its message and run on; and how the console's
// `breaks` lists it (`break cart.jet:88 if total < 0`). The condition and
// the message are compiled expressions (NativeEval.jet), the message one
// String with its `{…}` parts.
NativeRule: struct {
    condition: Shared<NativeEval>?,
    log: Shared<NativeEval>?,
    shown: String,
}

// What a run said before it settled: the program's output (`stdout`), a
// logpoint's message (`console`), or why a condition stopped it (`stderr`).
NativeSaid: struct {
    category: String,
    text: String,
}

// Where a run settled: its stop, the breakpoint the stop reports (None for
// the end of a step, a pause or the program), and what it said on the way.
NativeSettled: struct {
    stop: NativeStop,
    hit: Int?,
    said: [NativeSaid],
}

// A watch (`watch total`): its number, the place as the console named it,
// the address and type of the place's bytes, the debug-register spans that
// trap a write to them, the thread and canonical frame address of the frame
// whose local it is, and its bytes when it last changed. A local held in a
// register has no address or spans: `register` is its index among the
// trace's registers (else -1), and `ranges` the code where it is there.
NativeWatch: struct {
    number: Int,
    shown: String,
    address: Int,
    ty: Int,
    spans: [NativeWatchSpan],
    thread: Int,
    cfa: Int,
    bytes: [U8],
    register: Int,
    ranges: [NativeRange],
}

// One debug register a watch holds: DR0 to DR3 (`slot`), trapping a write
// to the `size` bytes (1, 2, 4 or 8, aligned to their size) at `address`.
NativeWatchSpan: struct {
    slot: Int,
    address: Int,
    size: Int,
}

// A thread of the traced program: its id, whether it runs, whether a
// SIGSTOP the debugger sent it (halt) is still to arrive, and the signal it
// stopped with, which goes to it when it next runs (0: none).
NativeThread: struct {
    id: Int,
    running: Bool,
    halting: Bool,
    signal: Int,
}

// What resuming the program ended in: a SIGTRAP stop (Paused: a trap byte,
// a finished single step, or with `code` the number of the watch whose
// bytes a write changed), its exit with `code`, or its death by the signal
// `code`.
NativeEvent: struct {
    kind: NativeStopKind,
    code: Int,

    // Whether the event ends a run: anything but a plain SIGTRAP stop.
    ends_run: fn(self) -> Bool Never! { self.kind != NativeStopKind.Paused || self.code > 0 }
}

// What running to a return address ended in: the return, or another stop.
NativeReturn: enum {
    Returned,
    Stopped(stop: NativeStop),
}

// What patch_owned does to a step's trap addresses: write the trap byte, or
// put back the byte it replaced.
NativePatch: enum {
    Trap,
    Restore,
}

// Which calls a line step enters: none, or those with Jet line information.
NativeStepCalls: enum {
    Over,
    Into,
}

// One frame of the stopped program, as the unwinder found it: its code
// address, its canonical frame address (the caller's stack pointer) and its
// registers in the kernel's order, `known[i]` saying whether register i holds
// this frame's value.
NativeUnwound: struct {
    pc: Int,
    cfa: Int,
    registers: [Int],
    known: [Bool],
}

// The debug facts of the image `binary`, whose bytes are `elf`: its own, or,
// when it keeps none (`debug_info: split`), those of the side file its
// `.gnu_debuglink` names beside it. The link names a file, not a directory,
// and the build makes that name a link to the symbol store's side file.
native_image_load: fn(binary: String, elf: [U8]) -[FS.Read]> NativeImage? {
    own: native_image_read(elf)
    if own != None -> return own
    link: native_elf_section(elf, ".gnu_debuglink") ?? return None
    name: x64_jetline_text(link, 0)
    if name.len() == 0 -> return None
    side: native_files.read_bytes(native_files.join(native_files.dirname(binary), name)) ?? return None
    native_image_read(side)
}

NativeSession: struct {
    binary: String,
    image: NativeImage,
    trace: X64Trace,
    output_path: String,
    output_read: Int,
    // Whether the program has been launched or attached to; while it runs,
    // its trace has a pid, and the trace's thread is the one the last stop
    // is in. An `attached` program ran before the session and goes on
    // after it (detach).
    started: Bool,
    attached: Bool{false},
    // Every thread of the running program; all are stopped between runs.
    threads: [NativeThread],
    // The address of the runtime's task registry root (0: the program has
    // none, as it starts no task).
    observe_root: Int,
    breakpoints: [NativeBreakpoint],
    // What each breakpoint with a condition, a log message or a console
    // listing does when hit, by number; one without stops.
    rules: [Int:NativeRule],
    numbered: Int,
    // The trap bytes written into the program's code: each one's address
    // and the byte it replaced.
    sites: [Int:Int],
    selected: Int,
    // The watches, which number with the breakpoints; the change the last
    // watch stop saw (`total: 0 -> 2`); and what the next report says first
    // (a watch dropped when its frame returned).
    watches: [NativeWatch],
    watched: String,
    notes: String,
    // Where each function of the image's line table opens its frame, read
    // from the image's code (native_openings).
    openings: [NativeOpening],
    // The functions `fix` placed, latest last, and the address the next fix
    // maps its code at (0: none mapped yet).
    fixed: [NativeFixed]{[NativeFixed]{}},
    fix_next: Int{0},
    // A typed dump's tasks and memory (NativeDump.jet), in place of a
    // traced program's; None for a live session.
    dump: NativeDump?,
    // The index among the dump's tasks of the one `bt`, `frame`, `locals`
    // and `print` read: 0, the stop's, until `task N` selects another.
    task: Int,
    // What compiles the expressions `print`, `watch`, conditions and
    // logpoints evaluate (NativeEval.jet); None evaluates nothing. Each
    // compiled expression is kept by its source line and text, and the
    // image's code facts placing them are read once.
    evaluator: NativeEvaluator?{None},
    evals: [String:Shared<NativeEval>]{[String:Shared<NativeEval>]{}},
    eval_image: Shared<NativeEvalImage>?{None},

    // Load the debug facts of `binary` (a native image with debug info, its
    // own or in the side file its `.gnu_debuglink` names). The program's
    // output is written to `output_path`; nothing runs until `launch`.
    start: fn(binary: String, output_path: String) -> NativeSession NativeDebugError! {
        elf: native_files.read_bytes(binary) ?? return Err(NativeDebugError{detail: "couldn't read the program `{binary}`: {err}"})
        image: native_image_load(binary, elf) ?? return Err(NativeDebugError{detail: "`{binary}` has no Jet debug information; build it with `jet build -O0`"})
        native_files.write(output_path, "") ?? return Err(NativeDebugError{detail: "couldn't create the program output file: {err}"})
        observe_root: native_elf_symbol(elf, X64_OBSERVE_ROOT_SYMBOL) ?? 0
        openings: native_openings(image, native_elf_code(elf))
        Ok(NativeSession{binary: binary, image: image, trace: X64Trace{pid: -1, scratch: 0, failure: ""}, output_path: output_path, output_read: 0, started: false, threads: [NativeThread]{}, observe_root: observe_root, breakpoints: [NativeBreakpoint]{}, rules: [Int:NativeRule]{}, numbered: 0, sites: [Int:Int]{}, selected: 0, watches: [NativeWatch]{}, watched: "", notes: "", openings: openings, dump: None, task: 0})
    }

    // A breakpoint on `line` of the Jet source `file` (its base name, as the
    // line table names it): its number, or None when no code is on that line.
    // A function's start moves past its prologue (entry).
    break_at: fn(&self, file: String, line: Int) -> Int? NativeDebugError! {
        addresses := native_line_addresses(self.image, file, line)
        loop k in 0..<addresses.len() {
            index: x64_jetline_find(self.image.lines, addresses[k])
            if index >= 0 && addresses[k] == self.image.lines.functions[index].low {
                addresses[k] = self.entry(index)
            }
        }
        self.place(addresses)
    }

    // A breakpoint at the start of the Jet function `function`, past its
    // prologue.
    break_in: fn(&self, function: String) -> Int? NativeDebugError! {
        addresses := [Int]{}
        loop (index, found) in self.image.lines.functions {
            if found.name == function -> addresses.push(self.entry(index))
        }
        self.place(addresses)
    }

    // Where a breakpoint on the start of function `index` traps: past the
    // prologue that opens its frame there (native_body_start), or the start
    // itself when its code runs before any frame: a frame-free prefix
    // returns without reaching the frame.
    entry: fn(self, index: Int) -> Int Never! {
        low: self.image.lines.functions[index].low
        if self.openings[index].at == low && native_frame_open(self.openings[index].prologue) >= 0 {
            return native_body_start(self.image, index)
        }
        low
    }

    // A new breakpoint on `addresses`, trapped at once in a running program;
    // None when there are none.
    place: fn(&self, addresses: [Int]) -> Int? NativeDebugError! {
        if addresses.len() == 0 -> return Ok(None)
        self.numbered += 1
        self.breakpoints.push(NativeBreakpoint{number: self.numbered, addresses: addresses})
        if self.alive() {
            loop address in addresses {
                if !self.plant(address) {
                    return Err(NativeDebugError{detail: "couldn't write a breakpoint at {native_debug_hex(address)}"})
                }
            }
        }
        Ok(Val(self.numbered))
    }

    // Remove breakpoint or watch `number`.
    delete_breakpoint: fn(&self, number: Int) NativeDebugError! {
        kept := [NativeBreakpoint]{}
        loop breakpoint in self.breakpoints {
            if breakpoint.number != number -> kept.push(breakpoint.copy())
        }
        self.breakpoints = kept
        self.rules.remove(number).drop("a breakpoint placed without a rule has none")
        self.lift_unwanted()
        self.unwatch(number) ?? return Err(err)
        Ok()
    }

    // Drop watch `number`, if there is one, and free its debug registers.
    unwatch: fn(&self, number: Int) NativeDebugError! {
        found: loop (index, watch) in self.watches {
            if watch.number == number {
                break index
            }
        } ?? return Ok()
        _ := self.watches.remove(found, .Slot)
        if self.alive() && !self.set_debug_register(7, native_watch_control(self.watches)) {
            return Err(NativeDebugError{detail: "couldn't clear a debug register of the program"})
        }
        Ok()
    }

    // Remove every breakpoint.
    clear_breakpoints: fn(&self) NativeDebugError! {
        self.breakpoints = [NativeBreakpoint]{}
        self.rules = [Int:NativeRule]{}
        self.lift_unwanted()
        Ok()
    }

    // Give breakpoint `number` its condition, log message and listing.
    set_rule: fn(&self, number: Int, rule: NativeRule) Never! { self.rules[number] = rule }

    // Compile the expressions of the session with `evaluator`.
    evaluate_with: fn(&self, evaluator: &&NativeEvaluator) Never! {
        self.evaluator = Val(evaluator.move())
    }

    // The rule of breakpoint `number`, listed by `breaks` as `shown`:
    // `condition` ("" for none) and the logpoint message `log` ("" for
    // none), compiled where the breakpoint traps. A condition must be a
    // Bool.
    make_rule: fn(&self, number: Int, condition: String, log: String, shown: String) -> NativeRule NativeEvalRefused! {
        address := -1
        loop breakpoint in self.breakpoints {
            if breakpoint.number == number && breakpoint.addresses.len() > 0 {
                address = breakpoint.addresses[0]
            }
        }
        at: self.source_at(address, -1) ?? return Err(native_eval_refused("breakpoint {number} is not on a line of Jet code"))
        rule := NativeRule{condition: None, log: None, shown: shown}
        if condition.trim() != "" {
            compiled: self.compiled(at.path, at.line, at.column, condition.trim()) ?? return Err(err)
            type_name: compiled.guard_read().value.result.name
            if type_name != "Bool" {
                return Err(native_eval_refused("`{condition.trim()}` is a {type_name}, not a Bool"))
            }
            rule.condition = Val(compiled)
        }
        if log != "" {
            rule.log = Val(self.compiled(at.path, at.line, at.column, native_eval_message(log)) ?? return Err(err))
        }
        Ok(rule)
    }

    // The source file (its path, as the image's line table records it),
    // line and character column (0: the line's first node) of the Jet code
    // at `lookup`. A caller's frame passes the return address `call` of
    // its call (-1 for none): a call-site row there names the call's own
    // node, not the first node of its line.
    source_at: fn(self, lookup: Int, call: Int) -> {path: String, line: Int, column: Int}? Never! {
        index: x64_jetline_find(self.image.lines, lookup)
        if index < 0 -> return None
        function: self.image.lines.functions[index]
        line := x64_jetline_line(self.image.lines, function, lookup) ?? return None
        column := 0
        if self.image.calls.get(call) == .Val(site) {
            line = site.line
            column = site.column
        }
        path: if function.dir == "" || function.file.starts_with("/") -> "{function.file}" else -> native_files.join(function.dir, function.file)
        Val({path: path, line: line, column: column})
    }

    // `text` compiled before the node at `line` and `column` of the source
    // `path`: the kept one, or the evaluator's.
    compiled: fn(&self, path: String, line: Int, column: Int, text: String) -> Shared<NativeEval> NativeEvalRefused! {
        key: "{path}:{line}:{column}:{text}"
        if self.evals.get(key) == .Val(found) -> return Ok(found)
        made := NativeEval?{None}
        if self.evaluator == .Val(evaluator) {
            made = Val(evaluator.compile(path, line, column, text) ?? return Err(err))
        }
        code: made ?? return Err(native_eval_refused("this session has no compiler to evaluate expressions with"))
        cell: Shared{code.move()}
        self.evals[key] = cell
        Ok(cell)
    }

    // The value of `text` in the selected frame.
    evaluate: fn(&self, text: String) -> NativeEvalValue NativeEvalRefused! {
        if self.dump != None {
            return Err(native_eval_refused("a dump runs no code; `locals` shows the values it holds"))
        }
        self.ready() ?? return Err(native_eval_refused(err.detail))
        frames: self.unwind() ?? return Err(native_eval_refused(err.detail))
        if frames.len() == 0 -> return Err(native_eval_refused("there is no frame to evaluate in"))
        levels: native_levels(self.image, frames)
        level: if self.selected < levels.len() -> levels[self.selected] else -> levels[0]
        call: if level.frame > 0 && level.site < 0 -> frames[level.frame].pc else -> -1
        at: self.source_at(native_lookup(level.frame, frames[level.frame].pc), call) ?? return Err(native_eval_refused("the selected frame is not Jet code"))
        compiled: self.compiled(at.path, at.line, at.column, text) ?? return Err(err)
        self.run_eval(compiled)
    }

    // Run `compiled` in a fork of the stopped program with the captures it
    // reads from the selected frame (NativeEval.jet).
    run_eval: fn(&self, compiled: Shared<NativeEval>) -> NativeEvalValue NativeEvalRefused! {
        self.ready() ?? return Err(native_eval_refused(err.detail))
        frames: self.unwind() ?? return Err(native_eval_refused(err.detail))
        if frames.len() == 0 -> return Err(native_eval_refused("there is no frame to evaluate in"))
        levels: native_levels(self.image, frames)
        level: if self.selected < levels.len() -> levels[self.selected] else -> levels[0]
        if level.site >= 0 {
            return Err(native_eval_refused("the selected frame is code inlined into the frame below it; select that frame with `down` to evaluate there"))
        }
        frame: frames[level.frame]
        lookup: native_lookup(level.frame, frame.pc)
        function: native_function_at(self.image, lookup) ?? return Err(native_eval_refused("the selected frame is not Jet code"))
        memory: NativeMemory{trace: Val(self.trace), blocks: [NativeBlock]{}}
        facts_cell: self.eval_facts() ?? return Err(err)
        facts: facts_cell.guard_read()
        permit := compiled.guard_edit()
        captures := [[U8]]{}
        // The debug type of each capture, which shows a result of the same
        // Jet type as `locals` shows that local.
        typed := [Int]{}
        loop capture in permit.value.captures {
            bytes := [U8]?{None}
            loop variable in function.variables {
                if variable.site != -1 || variable.name != capture.name -> next
                range: native_variable_covering(self.image, variable, lookup) ?? next
                size: if capture.inline -> capture.size else -> native_type_size(self.image, variable.ty)
                if size <= 0 || (!capture.inline && size > 8) -> next
                bytes = native_place_bytes(memory, frame, self.image.loclists, range.from, range.to, size)
                if bytes != None -> typed.push(variable.ty)
            }
            read := bytes ?? return Err(native_eval_refused("`{capture.name}` has no value here"))
            loop read.len() % 8 != 0 -> read.push(U8{0})
            captures.push(read.move())
        }
        if permit.value.plan == None || permit.value.planned != self.fixed.len() {
            plan: native_fix_plan(self.image, permit.value.edit, facts.value.symbols, facts.value.code.bytes, facts.value.code.address, self.fixed) ?? return Err(native_eval_refused(err.detail))
            refusal: native_eval_refusal(permit.value, plan, facts.value, self.fixed)
            if refusal != "" -> return Err(native_eval_refused(refusal))
            permit.value.plan = Val(plan)
            permit.value.planned = self.fixed.len()
        }
        syscall: native_fork_syscall_at(self.trace, facts.value.code.address, facts.value.code.address + facts.value.code.bytes.len()) ?? return Err(native_eval_refused("the program's code holds no system call to copy it with"))
        if permit.value.plan == .Val(plan) {
            return native_eval_run(self.image, self.trace, self.sites, permit.value, plan, facts.value, syscall, captures, typed)
        }
        Err(native_eval_refused("the expression has no plan"))
    }

    // The image's code facts evaluations place code against, read at the
    // first.
    eval_facts: fn(&self) -> Shared<NativeEvalImage> NativeEvalRefused! {
        if self.eval_image == .Val(found) -> return Ok(found)
        elf: native_files.read_bytes(self.binary) ?? return Err(native_eval_refused("couldn't read the program `{self.binary}`: {err}"))
        cell: Shared{NativeEvalImage{symbols: native_fix_symbols(elf), code: native_elf_code(elf)}}
        self.eval_image = Val(cell)
        Ok(cell)
    }

    // Whether a hit of a breakpoint with `condition` and `log` stops: its
    // condition holds (or it has none) and it is not a logpoint; and what
    // the hit says (`category` "" for nothing). A logpoint whose condition
    // holds logs its message instead. A condition that can't be evaluated
    // stops, and says why.
    holds: fn(&self, condition: Shared<NativeEval>?, log: Shared<NativeEval>?) -> {stops: Bool, category: String, text: String} Never! {
        if condition == .Val(compiled) {
            if self.run_eval(compiled) == {
                .Ok(value) -> {
                    if !value.truth -> return {stops: false, category: "", text: ""}
                }
                .Err(failure) -> return {stops: true, category: "stderr", text: "The breakpoint's condition failed: {failure.message}\n"}
            }
        }
        if log == .Val(message) {
            text: if self.run_eval(message) == {
                .Ok(value) -> value.text
                .Err(failure) -> "<{failure.message}>"
            }
            return {stops: false, category: "console", text: "{text}\n"}
        }
        {stops: true, category: "", text: ""}
    }

    // `print <expr>`: the expression's value in the selected frame.
    print_command: fn(&self, operand: String) -> String Never! {
        if operand == "" -> return "Print needs an expression, as `print total`\n"
        value: self.evaluate(operand) ?? return "Can't evaluate `{operand}`: {err.message}\n"
        "{operand} = {value.shown}\n"
    }

    // Whether breakpoint or watch `number` is placed.
    has_breakpoint: fn(self, number: Int) -> Bool Never! {
        loop breakpoint in self.breakpoints {
            if breakpoint.number == number -> return true
        }
        loop watch in self.watches {
            if watch.number == number -> return true
        }
        false
    }

    // The console's `breaks`: each breakpoint and watch by number, a
    // breakpoint as its rule lists it, else by where it traps.
    breaks_text: fn(self) -> String Never! {
        if self.breakpoints.len() == 0 && self.watches.len() == 0 -> return "No breakpoints\n"
        rows := [{number: Int, text: String}]{}
        loop breakpoint in self.breakpoints {
            frame: native_frame_at(self.image, breakpoint.addresses[0])
            shown: if self.rules.get(breakpoint.number) == .Val(rule) -> "{rule.shown}" else -> "break {frame.file}:{frame.line}"
            rows.push({number: breakpoint.number, text: shown})
        }
        loop watch in self.watches -> rows.push({number: watch.number, text: "watch {watch.shown}"})
        rows.sort_by(fn(left: {number: Int, text: String}, right: {number: Int, text: String}) { left.number <=> right.number })
        text := ""
        loop row in rows -> text = "{text}  {row.number} {row.text}\n"
        text
    }

    // Run the program from its start, with `args`.
    launch: fn(&self, args: [String]) -> NativeStop NativeDebugError! {
        if self.attached -> self.detach()
        if self.trace.pid > 0 || self.trace.scratch != 0 -> x64_trace_close(self.trace)
        argv := [String]{self.binary.copy()}
        loop arg in args -> argv.push(arg.copy())
        self.started = true
        self.sites = [Int:Int]{}
        // A watch names a frame of the run that ended.
        self.watches = [NativeWatch]{}
        self.trace = x64_trace_spawn(self.binary, argv, self.output_path)
        if self.trace.pid < 0 {
            failure: self.trace.failure.copy()
            x64_trace_close(self.trace)
            return Err(NativeDebugError{detail: "couldn't start the program: {failure}"})
        }
        self.threads = [NativeThread]{NativeThread{id: self.trace.pid, running: false, halting: false, signal: 0}}
        self.plant_breakpoints() ?? return Err(err)
        self.continue_run()
    }

    // Trap every breakpoint's addresses in the program.
    plant_breakpoints: fn(&self) NativeDebugError! {
        loop breakpoint in self.breakpoints {
            loop address in breakpoint.addresses {
                if !self.plant(address) {
                    return Err(NativeDebugError{detail: "couldn't write a breakpoint at {native_debug_hex(address)}"})
                }
            }
        }
        Ok()
    }

    // Attach to the running program `pid` in place of a launch: the image
    // its process runs (native_attach_program, which `program`, when not "",
    // must name) is loaded unless it is this session's, then each of its
    // threads is seized and stopped where it is, and the breakpoints trap.
    // The stop is in the first thread's innermost Jet frame, which is
    // selected; it has no frame when no Jet code is on that thread's stack.
    attach: fn(&self, pid: Int, program: String) -> NativeStop NativeAttachRefused! {
        binary: native_attach_program(pid, program) ?? return Err(err)
        if binary != self.binary {
            self.load(binary) ?? return Err(NativeAttachRefused{code: NATIVE_ATTACH_FAILED, detail: err.detail})
        }
        if self.attached -> self.detach()
        if self.trace.pid > 0 || self.trace.scratch != 0 -> x64_trace_close(self.trace)
        self.trace = x64_trace_attach(pid)
        if self.trace.pid < 0 {
            failure: "{self.trace.failure}"
            x64_trace_close(self.trace)
            return Err(NativeAttachRefused{code: NATIVE_ATTACH_FAILED, detail: "couldn't start the tracer: {failure}"})
        }
        self.started = true
        self.attached = true
        self.sites = [Int:Int]{}
        self.watches = [NativeWatch]{}
        self.threads = [NativeThread]{}
        // A thread may start while the others are taken: the threads are
        // listed again until no new one shows.
        fresh := true
        loop fresh {
            fresh = false
            tasks: native_files.list_dir("/proc/{pid}/task") ?? break
            loop task in tasks {
                id: Int.parse(task.name) ?? next
                if self.thread_row(id) >= 0 -> next
                status := x64_trace_seize(self.trace, id)
                // A thread a seized thread started is traced already, and
                // stops by itself.
                if status == -NATIVE_DEBUG_EPERM && self.threads.len() > 0 {
                    status = x64_trace_wait_for(self.trace, id)
                }
                if status == -NATIVE_DEBUG_ESRCH -> next
                if status < 0 {
                    self.detach()
                    return Err(NativeAttachRefused{code: NATIVE_ATTACH_FAILED, detail: native_attach_denied(pid, -status)})
                }
                fresh = true
                if status & 0xff == 0x7f {
                    self.threads.push(NativeThread{id: id, running: false, halting: false, signal: native_trace_signal(status)})
                }
            }
        }
        if self.thread_row(pid) < 0 {
            self.detach()
            return Err(NativeAttachRefused{code: NATIVE_ATTACH_FAILED, detail: "process {pid} exited before the debugger attached"})
        }
        if self.plant_breakpoints() == .Err(failure) {
            self.detach()
            return Err(NativeAttachRefused{code: NATIVE_ATTACH_FAILED, detail: failure.detail})
        }
        frames: self.backtrace() ?? return Ok(NativeStop{kind: NativeStopKind.Paused, reason: "attach", code: 0, frame: None})
        loop (index, frame) in frames.move() {
            if native_debug_jet_frame(frame) {
                self.selected = index
                return Ok(NativeStop{kind: NativeStopKind.Paused, reason: "attach", code: 0, frame: Val(frame)})
            }
        }
        Ok(NativeStop{kind: NativeStopKind.Paused, reason: "attach", code: 0, frame: None})
    }

    // The console's report of attaching to process `pid`, stopped at `stop`
    // (attach's) in the Jet source `file` whose text is `lines`.
    attach_report: fn(&self, stop: NativeStop, pid: Int, file: String, lines: [String]) -> NativeDebugStep NativeDebugError! {
        frame: stop.frame ?? return Ok(NativeDebugStep{text: "Attached to process {pid}\n", stop: stop})
        shown: self.report(stop, file, lines) ?? return Err(err)
        Ok(NativeDebugStep{text: "Attached to process {pid}  {frame.file}:{frame.line}  in {frame.function}()\n{shown}", stop: stop})
    }

    // Load the debug facts of `binary` in place of the image's: the
    // breakpoints, watches and compiled expressions of the old image go.
    load: fn(&self, binary: String) NativeDebugError! {
        elf: native_files.read_bytes(binary) ?? return Err(NativeDebugError{detail: "couldn't read the program `{binary}`: {err}"})
        image: native_image_load(binary, elf) ?? return Err(NativeDebugError{detail: "`{binary}` has no Jet debug information; build it with `jet build -O0`"})
        self.observe_root = native_elf_symbol(elf, X64_OBSERVE_ROOT_SYMBOL) ?? 0
        self.openings = native_openings(image, native_elf_code(elf))
        self.image = image
        self.binary = binary
        self.breakpoints = [NativeBreakpoint]{}
        self.rules = [Int:NativeRule]{}
        self.watches = [NativeWatch]{}
        self.evals = [String:Shared<NativeEval>]{}
        self.eval_image = None
        Ok()
    }

    // Let the attached program go on untraced, as it ran before `attach`:
    // its trap bytes are put back, its watches' debug registers cleared, and
    // each thread goes with the signal it stopped with.
    detach: fn(&self) Never! {
        trapped := [Int]{}
        loop address in self.sites.keys() -> trapped.push(address)
        loop address in trapped -> self.lift(address)
        if self.watches.len() > 0 -> _ := self.set_debug_register(7, 0)
        loop thread in self.threads {
            self.trace.thread = thread.id
            _ := x64_trace_detach(self.trace, thread.signal)
        }
        self.attached = false
        // `ended` drops the pid before it closes the trace, so the helper
        // ends without killing the program.
        self.ended()
    }

    continue_run: fn(&self) -> NativeStop NativeDebugError! {
        self.ready() ?? return Err(err)
        event: self.go(X64TraceResume.Run) ?? return Err(err)
        self.stopped(event)
    }

    // The next line, entering calls into Jet code.
    step_in: fn(&self) -> NativeStop NativeDebugError! { self.line_step(NativeStepCalls.Into) }

    // The next line of this function, running calls to their end.
    step_over: fn(&self) -> NativeStop NativeDebugError! { self.line_step(NativeStepCalls.Over) }

    // Run to the end of this function, stopping in its caller.
    step_out: fn(&self) -> NativeStop NativeDebugError! {
        self.ready() ?? return Err(err)
        frames: self.unwind() ?? return Err(err)
        if frames.len() < 2 -> return self.continue_run()
        returned: self.run_to_return(frames[1].pc, frames[0].cfa) ?? return Err(err)
        if returned == {
            .Returned -> self.paused("step out")
            .Stopped(stop) -> Ok(stop)
        }
    }

    // The selected thread's frames, innermost first, each inlined run its
    // own frame above the frame it is inlined into.
    backtrace: fn(&self) -> [NativeFrame] NativeDebugError! {
        registers: self.registers() ?? return Err(err)
        self.backtrace_from(registers)
    }

    // The frames of a stack whose innermost registers are `registers`, as
    // backtrace shows them: a caller's own frame at its call's call-site
    // row (NativeImage.calls) when the call has one.
    backtrace_from: fn(self, registers: [Int]) -> [NativeFrame] NativeDebugError! {
        frames: self.unwind_from(registers) ?? return Err(err)
        shown := [NativeFrame]{}
        loop (index, frame) in frames {
            found := native_frames_at(self.image, native_lookup(index, frame.pc))
            if index > 0 && self.image.calls.get(frame.pc) == .Val(site) {
                own: found.len() - 1
                found[own].line = site.line
                found[own].column = site.column
            }
            loop row in found.move() -> shown.push(row)
        }
        Ok(shown)
    }

    // `tasks`: every task of the program by id, with its state, what it
    // waits on and its Jet frames; `*` marks the task this stop is in. The
    // facts are the runtime's task registry (JetRuntime Observe.jet), the
    // one `jet inspect live` publishes, read from the stopped program. A
    // task on a thread shows that thread's stack, a parked task the stack
    // its fiber saved when it parked (native_task_registers). Task 1 is the
    // program's main thread.
    tasks_text: fn(&self) -> String NativeDebugError! {
        self.ready() ?? return Err(err)
        memory: NativeMemory{trace: Val(self.trace), blocks: [NativeBlock]{}}
        current: self.trace.thread
        threads := [NativeTaskThread]{}
        loop thread in self.threads {
            self.trace.thread = thread.id
            found: x64_trace_registers(self.trace)
            self.trace.thread = current
            registers: found ?? next
            // GS:0 holds the thread's TCB (0: not attached).
            base: registers[X64_TRACE_GS_BASE]
            tcb: if base == 0 -> 0 else -> native_debug_word(self.trace, base) ?? 0
            fiber: if tcb == 0 -> 0 else -> native_debug_word(self.trace, tcb + NATIVE_DEBUG_TCB_FIBER) ?? 0
            control: if tcb == 0 -> 0 else -> native_debug_word(self.trace, tcb + NATIVE_DEBUG_TCB_CONTROL) ?? 0
            task: if control == 0 -> 0 else -> native_debug_word(self.trace, control + NATIVE_DEBUG_CONTROL_TASK) ?? 0
            // The main thread's own control names no task: it runs task 1.
            threads.push(NativeTaskThread{id: thread.id, registers: registers, fiber: fiber, task: if task == 0 && thread.id == self.trace.pid -> 1 else -> task})
        }
        tasks := native_tasks(memory, self.observe_root)
        rooted := false
        loop task in tasks {
            if task.id == 1 -> rooted = true
        }
        if !rooted {
            tasks.push(NativeTask{id: 1, label: "root", state: -1, wait: "", canceled: false, fiber: 0})
        }
        tasks.sort_by(fn(left: NativeTask, right: NativeTask) { left.id <=> right.id })
        text := ""
        loop task in tasks {
            on: native_task_thread(threads, task)
            registers := [Int]?{None}
            if {
                on >= 0 -> registers = Val(threads[on].registers)
                task.fiber != 0 && threads.len() > 0 -> {
                    saved: native_debug_word(self.trace, task.fiber + NATIVE_DEBUG_FIBER_SAVED) ?? 0
                    if saved != 0 {
                        registers = native_task_registers(threads[0].registers, memory, saved)
                    }
                }
            }
            state: if {
                task.state >= 0 -> native_task_state(task.state)
                on >= 0 && threads[on].registers[X64_TRACE_ORIG_RAX] >= 0 -> "blocked"
                else -> "running"
            }
            mark: if on >= 0 && threads[on].id == current -> "*" else -> " "
            wait: if task.wait != "" && task.state != NATIVE_DEBUG_TASK_RUNNING -> "  {task.wait}" else -> ""
            canceled: if task.canceled -> "  canceled" else -> ""
            text = "{text}{mark} {task.id}  {task.label}  {state}{wait}{canceled}\n"
            if registers == .Val(found) {
                frames: self.backtrace_from(found) ?? return Err(err)
                loop line in native_debug_backtrace(frames).split("\n").to_list() {
                    if line != "" -> text = "{text}    {line}\n"
                }
            }
        }
        Ok(text)
    }

    // The selected frame's parameters and locals, rendered as Jet values; a
    // struct whose type implements DebugView shows as its view (view).
    locals: fn(&self) -> [NativeLocal] NativeDebugError! {
        frames: self.unwind() ?? return Err(err)
        if frames.len() == 0 -> return Ok([NativeLocal]{})
        levels: native_levels(self.image, frames)
        level: if self.selected < levels.len() -> levels[self.selected] else -> levels[0]
        index: level.frame
        memory: NativeMemory{trace: Val(self.trace), blocks: [NativeBlock]{}}
        lookup: native_lookup(index, frames[index].pc)
        // A dump runs no view: nothing runs it.
        if self.dump == .Val(dumped) {
            return Ok(native_frame_locals(self.image, dumped.memory, frames[index], lookup, level.site))
        }
        shown := native_frame_locals(self.image, memory, frames[index], lookup, level.site)
        function: native_function_at(self.image, lookup) ?? return Ok(shown)
        // The variables native_frame_locals shows, in its order.
        at := 0
        loop variable in function.variables {
            if variable.site != level.site -> next
            located := NativeRange?{None}
            if variable.list >= 0 {
                located = native_variable_covering(self.image, variable, lookup)
                if located == None -> next
            }
            local: at
            at += 1
            range: located ?? next
            view: native_debug_view_at(self.image, variable.ty) ?? next
            bytes: native_place_bytes(memory, frames[index], self.image.loclists, range.from, range.to, native_type_size(self.image, variable.ty)) ?? next
            if self.view(view, variable.ty, bytes) == {
                .Ok(viewed) -> {
                    if viewed == .Val(text) -> shown[local].value = text
                }
                .Err(failure) -> return Err(failure)
            }
            if !self.alive() -> break
        }
        Ok(shown)
    }

    // The value whose bytes are `value`, of struct type `ty`, as its
    // DebugView shows it: the view at address `view` runs on a copy of the
    // value in a fork of the stopped program (NativeFork.jet), never in the
    // program, which neither runs nor changes. None when the fork can't be
    // made or the view doesn't return there (a refused system call, a
    // fault, a trap or the budget's end), or its items can't be read: the
    // value then shows by its fields.
    view: fn(&self, view: Int, ty: Int, value: [U8]) -> String? NativeDebugError! {
        // The image's code holds the runtime's `syscall` instructions.
        elf: native_files.read_bytes(self.binary) ?? return Ok(None)
        code: native_elf_code(elf)
        syscall: native_fork_syscall_at(self.trace, code.address, code.address + code.bytes.len()) ?? return Ok(None)
        fork: native_fork_make(self.trace, syscall) ?? return Ok(None)
        viewed: native_fork_view(fork, self.image, self.trace.pid, self.sites, view, ty, value) ?? {
            native_fork_end(fork)
            return Ok(None)
        }
        native_fork_end(fork)
        Ok(Val(viewed))
    }

    // Select frame `index` of the current thread's backtrace (0 is innermost).
    select_frame: fn(&self, index: Int) -> Bool NativeDebugError! {
        frames: self.unwind() ?? return Err(err)
        if index < 0 || index >= native_levels(self.image, frames).len() -> return Ok(false)
        self.selected = index
        Ok(true)
    }

    // The program's output written since the last call.
    take_output: fn(&self) -> String Never! {
        text: native_files.read(self.output_path) ?? return ""
        bytes: text.bytes()
        if bytes.len() <= self.output_read -> return ""
        fresh: String.from_bytes(bytes[self.output_read..<bytes.len()]) ?? return ""
        self.output_read = bytes.len()
        fresh
    }

    // End the program, if it still runs; an attached one is let go instead
    // (detach).
    close: fn(&self) Never! {
        if self.attached {
            self.detach()
            return
        }
        x64_trace_close(self.trace)
        self.sites = [Int:Int]{}
    }

    // The source file of the program's `run`, as the image's line table
    // records it; "" when the image holds no `run`.
    run_source: fn(&self) -> String Never! {
        loop found in self.image.lines.functions {
            if found.name != "run" -> next
            if found.dir == "" || found.file.starts_with("/") -> return "{found.file}"
            return native_files.join(found.dir, found.file)
        }
        ""
    }

    // Run the program with `args` to the start of its `run`, in the Jet
    // source `file` whose text is `lines`. None when the program has no `run`.
    open: fn(&self, file: String, lines: [String], args: [String]) -> NativeDebugStep? NativeDebugError! {
        start := -1
        if self.break_in("run") == {
            .Ok(placed) -> start = placed ?? -1
            .Err(failure) -> return Err(failure)
        }
        if start < 0 -> return Ok(None)
        first: self.launch(args) ?? return Err(err)
        self.delete_breakpoint(start) ?? return Err(err)
        text: self.report(first, file, lines) ?? return Err(err)
        Ok(Val(NativeDebugStep{text: text, stop: first}))
    }

    // Place a breakpoint on each of `breaks`, then run the program with
    // `args` to the first it reaches, or to its end: the first stop of
    // `jet debug --break`. A break on a line with no code is named and left
    // out.
    run_to: fn(&self, breaks: [NativeBreak], file: String, lines: [String], args: [String]) -> NativeDebugStep NativeDebugError! {
        text := ""
        loop wanted in breaks {
            placed := -1
            if self.break_at(wanted.file, wanted.line) == {
                .Ok(found) -> placed = found ?? -1
                .Err(failure) -> return Err(failure)
            }
            text = if placed < 0 -> "{text}No code on {wanted.file}:{wanted.line}\n" else -> "{text}Breakpoint set  {wanted.file}:{wanted.line}\n"
        }
        first: self.launch(args) ?? return Err(err)
        shown: self.report(first, file, lines) ?? return Err(err)
        Ok(NativeDebugStep{text: "{text}{shown}", stop: first})
    }

    // One console command at `stop`. `quit` is the caller's: only it knows
    // how its session ends.
    command: fn(&self, command: String, stop: NativeStop, file: String, lines: [String]) -> NativeDebugStep NativeDebugError! {
        trimmed: command.trim()
        word: trimmed.before(" ")
        operand: if trimmed.contains(" ") -> trimmed.after(" ").trim().copy() else -> ""
        text := ""
        if word == {
            "s" | "step" | "n" | "next" | "c" | "continue" | "f" | "finish" -> {
                short: if word == {
                    "s" | "step" -> "s"
                    "n" | "next" -> "n"
                    "f" | "finish" -> "f"
                    else -> "c"
                }
                settled: self.run(short) ?? return Err(err)
                loop said in settled.said -> text = "{text}{said.text}"
                shown: self.report(settled.stop, file, lines) ?? return Err(err)
                return Ok(NativeDebugStep{text: "{text}{shown}", stop: settled.stop})
            }
            "b" | "break" -> text = self.break_command(operand, file) ?? return Err(err)
            "log" -> text = self.log_command(operand, file) ?? return Err(err)
            "breaks" -> text = self.breaks_text()
            "delete" -> {
                number: Int.parse(operand) ?? -1
                if !self.has_breakpoint(number) {
                    return Ok(NativeDebugStep{text: "No breakpoint `{operand}`; `breaks` lists them\n", stop: stop})
                }
                watch: loop watch in self.watches {
                    if watch.number == number {
                        break true
                    }
                } ?? false
                self.delete_breakpoint(number) ?? return Err(err)
                text = if watch -> "Deleted watch {number}\n" else -> "Deleted breakpoint {number}\n"
            }
            "watch" -> text = self.watch_command(operand) ?? return Err(err)
            "frame" | "up" | "down" -> {
                text = self.frame_command(word, operand, file, lines) ?? return Err(err)
            }
            "locals" -> {
                locals := self.locals() ?? return Err(err)
                locals.sort_by(fn(left: NativeLocal, right: NativeLocal) { left.name <=> right.name })
                text = native_debug_locals_typed(locals)
            }
            "p" | "print" -> text = self.print_command(operand)
            "bt" | "backtrace" -> {
                frames: self.backtrace() ?? return Err(err)
                text = native_debug_backtrace(frames)
            }
            "tasks" -> text = self.tasks_text() ?? return Err(err)
            "h" | "help" -> text = "{NATIVE_DEBUG_HELP}\n"
            "" -> {}
            else -> text = "Unknown command `{word}`. {NATIVE_DEBUG_HELP}\n"
        }
        Ok(NativeDebugStep{text: text, stop: stop})
    }

    // Write `bytes` at `address` of the stopped program, a word at a time,
    // the last word padded with zeros; false when it can't be written.
    poke_bytes: fn(self, address: Int, bytes: [U8]) -> Bool Never! {
        loop word in 0..<((bytes.len() + 7) >> 3) {
            if !x64_trace_poke(self.trace, address + 8 * word, I64{native_number(bytes, 8 * word, 8, X64DebugEncoding.Signed)}) {
                return false
            }
        }
        true
    }

    // Swap `edit`, the program compiled again, into the stopped program
    // (NativeFix.jet): what the console shows of it. Nothing changes when
    // the fix is refused.
    fix: fn(&self, edit: NativeFixEdit) -> String NativeDebugError! {
        self.ready() ?? return Err(err)
        elf: native_files.read_bytes(self.binary) ?? return Err(NativeDebugError{detail: "couldn't read the program `{self.binary}`: {err}"})
        symbols: native_fix_symbols(elf)
        code: native_elf_code(elf)
        plan: native_fix_plan(self.image, edit, symbols, code.bytes, code.address, self.fixed) ?? return Ok("Fix refused: {err.detail}; restart the program to run the edit\n")
        if plan.changed.len() == 0 {
            return Ok("Nothing to fix: the program already runs this code\n")
        }
        pc: (self.registers() ?? return Err(err))[X64_TRACE_RIP]
        // Each changed function's running entry, -1 for a new function.
        entries := [Int]{}
        sizes := [Int]{}
        loop row in plan.changed {
            running: native_fix_running(edit.functions[row].name, symbols, code.bytes, code.address, self.fixed)
            at: if running == .Val(found) -> found.address else -> -1
            if at >= 0 && pc > at && pc < at + 5 {
                return Ok("Fix refused: the program is stopped in the first instruction of `{native_fix_shown(edit, row)}`; step once, then fix again\n")
            }
            entries.push(at)
            sizes.push(if running == .Val(found) -> found.code.len() else -> 0)
        }
        syscall := -1
        loop k in 0..<code.bytes.len() - 1 {
            if native_fix_is_syscall(code.bytes, k) && !self.has_site(code.address + k) {
                syscall = code.address + k
                break
            }
        }
        if syscall < 0 {
            return Ok("Fix refused: the program's code holds no system call to map the edit with; restart the program to run the edit\n")
        }
        base: self.map_code(plan.size, code.address + code.bytes.len(), syscall) ?? return Err(err)
        region: native_fix_region(plan, edit, symbols, base)
        if !self.poke_bytes(base, region) {
            return Err(NativeDebugError{detail: "couldn't write the fixed code at {native_debug_hex(base)}"})
        }
        // Breakpoints in the old code move to the same lines of the new.
        moved := [NativeBreakpoint]{}
        loop breakpoint in self.breakpoints {
            addresses := [Int]{}
            loop address in breakpoint.addresses {
                target := address
                loop (k, row) in plan.changed {
                    at: entries[k]
                    if at < 0 || address < at || address >= at + sizes[k] -> next
                    target = -1
                    index: x64_jetline_find(self.image.lines, address)
                    line: if index >= 0 -> x64_jetline_line(self.image.lines, self.image.lines.functions[index], address) ?? 0 else -> 0
                    loop piece in plan.pieces {
                        if piece.function != row -> next
                        if native_fix_line_address(edit.debug[row], base + piece.offset, line) == .Val(found) {
                            target = found
                        }
                    }
                }
                if target >= 0 -> addresses.push(target)
            }
            moved.push(NativeBreakpoint{number: breakpoint.number, addresses: addresses})
        }
        loop (k, at) in entries {
            if at < 0 -> next
            inside := [Int]{}
            loop address in self.sites.keys() {
                if address >= at && address < at + sizes[k] -> inside.push(address)
            }
            loop address in inside -> self.lift(address)
        }
        shown := [String]{}
        loop piece in plan.pieces {
            if piece.function < 0 -> next
            row: piece.function
            function: edit.functions[row]
            low: base + piece.offset
            at: entries[plan.changed.index_of(row) ?? 0]
            if at >= 0 {
                word: x64_trace_read(self.trace, at, 8) ?? return Err(NativeDebugError{detail: "couldn't read the code of `{function.name}`"})
                patched := word
                loop (k, byte) in native_fix_jump(at, low) -> patched[k] = byte
                if !self.poke_bytes(at, patched) {
                    return Err(NativeDebugError{detail: "couldn't redirect `{function.name}` to its fixed code"})
                }
            }
            id: function.id.value
            source: if id >= 0 && id < edit.object.functions.len() -> Val(edit.object.functions[id]) else -> None
            like: if at >= 0 -> x64_jetline_find(self.image.lines, at) else -> -1
            name := native_fix_shown(edit, row)
            file := ""
            dir := edit.object.debug.directory
            decl := 0
            if source == .Val(facts) {
                if facts.file >= 0 && facts.file < edit.object.debug.files.len() {
                    file = edit.object.debug.files[facts.file]
                }
                decl = facts.line
            }
            if like >= 0 {
                was: self.image.lines.functions[like]
                name = was.name
                file = was.file
                dir = was.dir
            }
            if file != "" {
                native_fix_lines(self.image.lines, low, function.code.len(), edit.debug[row], name, file, dir, decl)
                self.openings.push(native_opening(self.image, self.image.lines.functions.len() - 1, NativeCode{address: base, bytes: region}))
            }
            self.fixed.push(NativeFixed{name: function.name, address: low, code: region[piece.offset..<piece.offset + function.code.len()]})
            shown.push("`{name}`")
        }
        self.breakpoints = moved
        loop breakpoint in self.breakpoints {
            loop address in breakpoint.addresses {
                if !self.plant(address) {
                    return Err(NativeDebugError{detail: "couldn't write a breakpoint at {native_debug_hex(address)}"})
                }
            }
        }
        // An expression compiled before the fix was checked against the
        // source the fix replaced.
        self.evals = [String:Shared<NativeEval>]{}
        Ok("Fixed {shown.join(", ")}: the edit runs from the next call\n")
    }

    // Map `size` bytes of code for a fix in the stopped program, within
    // reach of a rel32 from the image's code, which ends at `after`: the
    // program runs one `mmap` at the system call `syscall` of its code, then
    // its registers are put back.
    map_code: fn(&self, size: Int, after: Int, syscall: Int) -> Int NativeDebugError! {
        hint := if self.fix_next > 0 -> self.fix_next else -> (after + NATIVE_FIX_GAP).div_euclid(NATIVE_FIX_PAGE) * NATIVE_FIX_PAGE
        loop _ in 0..<NATIVE_FIX_TRIES {
            saved: self.registers() ?? return Err(err)
            registers := self.registers() ?? return Err(err)
            registers[NATIVE_FIX_RAX] = NATIVE_FIX_MMAP
            registers[X64_TRACE_RDI] = hint
            registers[X64_TRACE_RSI] = size
            registers[NATIVE_FIX_RDX] = NATIVE_FIX_PROTECTION
            registers[NATIVE_FIX_R10] = NATIVE_FIX_FLAGS
            registers[NATIVE_FIX_R8] = -1
            registers[NATIVE_FIX_R9] = 0
            registers[NATIVE_FIX_ORIG_RAX] = -1
            registers[X64_TRACE_RIP] = syscall
            if !x64_trace_set_registers(self.trace, registers) {
                return Err(NativeDebugError{detail: "couldn't set the program's registers"})
            }
            event: self.resume(X64TraceResume.Step) ?? return Err(err)
            if event.kind != NativeStopKind.Paused {
                return Err(NativeDebugError{detail: "the program ended while `fix` mapped its code"})
            }
            mapped: (self.registers() ?? return Err(err))[NATIVE_FIX_RAX]
            if !x64_trace_set_registers(self.trace, saved) {
                return Err(NativeDebugError{detail: "couldn't set the program's registers"})
            }
            if mapped == hint {
                self.fix_next = hint + size
                return Ok(hint)
            }
            hint += NATIVE_FIX_GAP
        }
        Err(NativeDebugError{detail: "couldn't map the fixed code into the program"})
    }

    // Run one run-control command. A step that lands in code without Jet line
    // information finishes out of it back to the Jet caller, or continues when
    // no Jet frame is left to return to.
    advance: fn(&self, word: String) -> NativeStop NativeDebugError! {
        stop := if word == {
            "s" | "step" -> self.step_in() ?? return Err(err)
            "n" | "next" -> self.step_over() ?? return Err(err)
            "f" | "finish" -> self.step_out() ?? return Err(err)
            else -> self.continue_run() ?? return Err(err)
        }
        // A write a watch saw in code without Jet lines (the runtime) stops
        // in the Jet caller, still reported as the watch's stop.
        watch: if stop.reason.starts_with("watchpoint") -> "{stop.reason}" else -> ""
        depth := 0
        loop stop.kind == NativeStopKind.Paused && !native_debug_stop_in_jet(stop.frame) {
            frames: self.backtrace() ?? return Err(err)
            caller := false
            loop (k, frame) in frames {
                if k > 0 && native_debug_jet_frame(frame) -> caller = true
            }
            depth += 1
            stop = if caller && depth <= NATIVE_DEBUG_RUNTIME_DEPTH -> self.step_out() ?? return Err(err) else -> self.continue_run() ?? return Err(err)
        }
        if watch != "" && stop.kind == NativeStopKind.Paused && stop.reason == "step out" {
            stop.reason = watch
        }
        Ok(stop)
    }

    // Run `word` (`c`, `n`, `s` or `f`) and settle where it stops.
    run: fn(&self, word: String) -> NativeSettled NativeDebugError! {
        depth: if word == "c" -> 0 else -> self.jet_depth() ?? return Err(err)
        first: self.advance(word) ?? return Err(err)
        self.settle(first, word, depth)
    }

    // The stop to report after `word` (begun `depth` Jet frames deep) first
    // stopped at `first`. A breakpoint hit that does not stop
    // (holds) runs on: a continue continues, and a step goes on
    // to where it would have stopped. A step whose skipped hit was in a call
    // it steps over returns from the call and steps again; a step out
    // returns until it is out.
    settle: fn(&self, first: NativeStop, word: String, depth: Int) -> NativeSettled NativeDebugError! {
        said := [NativeSaid]{}
        stop := first
        returning := false
        loop stop.kind == NativeStopKind.Paused {
            hit: native_debug_hit_breakpoint(stop)
            skipped := false
            if hit == .Val(number) {
                condition := Shared<NativeEval>?{None}
                log := Shared<NativeEval>?{None}
                if self.rules.get(number) == .Val(rule) {
                    condition = rule.condition
                    log = rule.log
                }
                stops := true
                if condition != None || log != None {
                    verdict: self.holds(condition, log)
                    if verdict.category != "" {
                        output: self.take_output()
                        if output != "" -> said.push(NativeSaid{category: "stdout", text: output})
                        said.push(NativeSaid{category: verdict.category, text: verdict.text})
                    }
                    stops = verdict.stops
                }
                if stops -> return Ok(NativeSettled{stop: stop, hit: hit, said: said})
                skipped = true
            }
            if !skipped && !returning -> return Ok(NativeSettled{stop: stop, hit: None, said: said})
            next_word := "c"
            if word != "c" {
                here: self.jet_depth() ?? return Err(err)
                if word == "s" || (word == "n" && here <= depth && !returning) || (word == "f" && here < depth) {
                    // The step ends here, not the breakpoint that ran on.
                    stop.reason = "step"
                    return Ok(NativeSettled{stop: stop, hit: None, said: said})
                }
                returning = !(word == "n" && here <= depth)
                next_word = if returning -> "f" else -> "n"
            }
            stop = self.advance(next_word) ?? return Err(err)
        }
        Ok(NativeSettled{stop: stop, hit: None, said: said})
    }

    // The Jet frames on the stack.
    jet_depth: fn(&self) -> Int NativeDebugError! {
        frames: self.backtrace() ?? return Err(err)
        count := 0
        loop frame in frames {
            if native_debug_jet_frame(frame) -> count += 1
        }
        Ok(count)
    }

    // A breakpoint on `spec`: `12` (a line of `file`), `cart.jet:88`, or a
    // function's name. Its number and where it is, or -1 and why it can't
    // be placed.
    place_spec: fn(&self, spec: String, file: String) -> {number: Int, shown: String} NativeDebugError! {
        line := Int.parse(spec) ?? -1
        in_file := "{file}"
        if line == -1 && spec.contains(":") {
            in_file = "{spec.before(":")}"
            line = Int.parse(spec.after(":")) ?? 0
        }
        if line == -1 {
            entry := -1
            if self.break_in(spec) == {
                .Ok(found) -> entry = found ?? -1
                .Err(failure) -> return Err(failure)
            }
            if entry == -1 -> return Ok({number: -1, shown: "No function `{spec}`\n"})
            return Ok({number: entry, shown: "{spec}"})
        }
        if line < 1 {
            return Ok({number: -1, shown: "`{spec}` is not a line, a file:line or a function\n"})
        }
        placed := -1
        if self.break_at(in_file, line) == {
            .Ok(found) -> placed = found ?? -1
            .Err(failure) -> return Err(failure)
        }
        if placed == -1 -> return Ok({number: -1, shown: "No code on {in_file}:{line}\n"})
        Ok({number: placed, shown: "{in_file}:{line}"})
    }

    // `break <line|file:line|function> [if <expr>]`: a breakpoint that stops
    // when its condition holds. A condition that doesn't compile where the
    // breakpoint traps takes the breakpoint back.
    break_command: fn(&self, operand: String, file: String) -> String NativeDebugError! {
        spec: operand.before(" if ").trim()
        condition: if operand.contains(" if ") -> operand.after(" if ").trim() else -> ""
        if spec == "" -> return Ok("Break needs a line, a file:line or a function, as `break 12`\n")
        placed: self.place_spec(spec, file) ?? return Err(err)
        if placed.number < 0 -> return Ok(placed.shown)
        suffix: if condition == "" -> "" else -> " if {condition}"
        if self.make_rule(placed.number, condition, "", "break {placed.shown}{suffix}") == {
            .Ok(rule) -> { self.set_rule(placed.number, rule) }
            .Err(refused) -> {
                self.take_back(placed.number) ?? return Err(err)
                return Ok("Can't use the condition: {refused.message}\n")
            }
        }
        Ok("Breakpoint set  {placed.shown}{suffix}\n{native_debug_condition_place(condition)}")
    }

    // `log <file:line> "<text with {expr}>"`: a logpoint, which prints its
    // message, its `{expr}` parts filled in, and runs on.
    log_command: fn(&self, operand: String, file: String) -> String NativeDebugError! {
        quoted: if operand.contains(" ") -> operand.after(" ").trim() else -> ""
        bytes: quoted.bytes()
        if bytes.len() < 2 || !quoted.starts_with("\"") || !quoted.ends_with("\"") {
            return Ok("Log needs a line and a quoted message, as `log cart.jet:90 \"total={{total}}\"`\n")
        }
        message: String.from_bytes(bytes[1..<bytes.len() - 1]) ?? ""
        placed: self.place_spec(operand.before(" "), file) ?? return Err(err)
        if placed.number < 0 -> return Ok(placed.shown)
        if self.make_rule(placed.number, "", message, "log {placed.shown} {quoted}") == {
            .Ok(rule) -> { self.set_rule(placed.number, rule) }
            .Err(refused) -> {
                self.take_back(placed.number) ?? return Err(err)
                return Ok("Can't use the message: {refused.message}\n")
            }
        }
        Ok("Logpoint set  {placed.shown} {quoted}\n")
    }

    // Delete breakpoint `number`, just placed, and give its number back.
    take_back: fn(&self, number: Int) NativeDebugError! {
        self.delete_breakpoint(number) ?? return Err(err)
        if self.numbered == number -> self.numbered -= 1
        Ok()
    }

    // `watch <place>`: stop at each write that changes `place`, a local of
    // the selected frame or a field path under it (`order.total`), and show
    // its old and new values. The CPU's debug registers trap the write, so
    // the program runs at full speed until then, and a write that leaves
    // the value as it was runs on. A local held in a register is followed
    // by stepping its frame's own code instead (watch_steps).
    watch_command: fn(&self, operand: String) -> String NativeDebugError! {
        if operand == "" -> return Ok("Watch needs a local or a field path, as `watch total`\n")
        // The value shown is the compiler's evaluation of `operand`; the
        // trap watches the bytes its place names.
        value: self.evaluate(operand) ?? return Ok("Can't watch `{operand}`: {err.message}\n")
        self.ready() ?? return Err(err)
        frames: self.unwind() ?? return Err(err)
        if frames.len() == 0 -> return Ok("No frame to watch in\n")
        levels: native_levels(self.image, frames)
        level: if self.selected < levels.len() -> levels[self.selected] else -> levels[0]
        frame: frames[level.frame]
        memory: NativeMemory{trace: Val(self.trace), blocks: [NativeBlock]{}}
        place: native_watch_place(self.image, memory, frame, native_lookup(level.frame, frame.pc), level.site, operand)
        if place.refusal != "" -> return Ok("{place.refusal}\n")
        size: native_type_size(self.image, place.ty)
        if size <= 0 -> return Ok("`{operand}` has no bytes to watch\n")
        if place.register >= 0 {
            loop watch in self.watches {
                if watch.register >= 0 {
                    return Ok("`{operand}` is held in a register, which a watch follows by stepping its frame, and watch {watch.number} already does; `delete` it first\n")
                }
            }
            held: native_low_bytes(frame.registers[place.register], if size < 8 -> size else -> 8)
            self.numbered += 1
            self.watches.push(NativeWatch{number: self.numbered, shown: "{operand}", address: 0, ty: place.ty, spans: [NativeWatchSpan]{}, thread: self.trace.thread, cfa: frame.cfa, bytes: held, register: place.register, ranges: place.ranges})
            return Ok("Watchpoint {self.numbered}  {operand} = {value.shown}\n")
        }
        bytes: native_debug_bytes(memory, place.address, size) ?? return Ok("`{operand}` can't be read here\n")
        spans := native_watch_spans(place.address, size)
        free := [Int]{}
        loop slot in 0..<NATIVE_DEBUG_WATCH_SLOTS {
            held := false
            loop watch in self.watches {
                loop span in watch.spans {
                    if span.slot == slot -> held = true
                }
            }
            if !held -> free.push(slot)
        }
        if spans.len() > free.len() {
            return Ok("`{operand}` needs {spans.len()} of the CPU's {NATIVE_DEBUG_WATCH_SLOTS} debug registers and {free.len()} are free; `delete` a watch first\n")
        }
        loop k in 0..<spans.len() {
            spans[k].slot = free[k]
            if !self.set_debug_register(free[k], spans[k].address) {
                return Err(NativeDebugError{detail: "couldn't set a debug register of the program"})
            }
        }
        self.numbered += 1
        self.watches.push(NativeWatch{number: self.numbered, shown: "{operand}", address: place.address, ty: place.ty, spans: spans, thread: self.trace.thread, cfa: frame.cfa, bytes: bytes, register: -1, ranges: [NativeRange]{}})
        if !self.set_debug_register(7, native_watch_control(self.watches)) {
            return Err(NativeDebugError{detail: "couldn't set the program's debug control register"})
        }
        Ok("Watchpoint {self.numbered}  {operand} = {value.shown}\n")
    }

    // After a SIGTRAP: whether a watch's debug register trapped a write, and
    // the number of the watch whose bytes the write changed (0: none did).
    // The status register is cleared for the next trap. A watch whose frame
    // has returned is dropped, with a note for the next report.
    watch_fired: fn(&self) -> {fired: Bool, number: Int} NativeDebugError! {
        status: x64_trace_debug_register(self.trace, 6) ?? return Err(NativeDebugError{detail: "couldn't read the program's debug status register"})
        if status & NATIVE_DEBUG_WATCH_HITS == 0 -> return Ok({fired: false, number: 0})
        if !x64_trace_set_debug_register(self.trace, 6, 0) {
            return Err(NativeDebugError{detail: "couldn't clear the program's debug status register"})
        }
        memory: NativeMemory{trace: Val(self.trace), blocks: [NativeBlock]{}}
        loop index in 0..<self.watches.len() {
            hit := false
            loop span in self.watches[index].spans {
                if status & (1 << span.slot) != 0 -> hit = true
            }
            if !hit -> next
            bytes: native_debug_bytes(memory, self.watches[index].address, self.watches[index].bytes.len()) ?? next
            if bytes == self.watches[index].bytes -> next
            live: self.frame_live(self.watches[index].thread, self.watches[index].cfa) ?? return Err(err)
            if !live {
                self.end_watch(index) ?? return Err(err)
                return Ok({fired: true, number: 0})
            }
            return Ok({fired: true, number: self.watch_changed(index, bytes)})
        }
        Ok({fired: true, number: 0})
    }

    // Watch `index` now holds `bytes`: the change for the report, and the
    // watch's number.
    watch_changed: fn(&self, index: Int, bytes: [U8]) -> Int Never! {
        memory: NativeMemory{trace: Val(self.trace), blocks: [NativeBlock]{}}
        old: native_render(self.image, memory, self.watches[index].ty, self.watches[index].bytes, 0, 0) ?? NATIVE_DEBUG_UNAVAILABLE
        new: native_render(self.image, memory, self.watches[index].ty, bytes, 0, 0) ?? NATIVE_DEBUG_UNAVAILABLE
        self.watched = "{self.watches[index].shown}: {old} -> {new}"
        self.watches[index].bytes = bytes
        self.watches[index].number
    }

    // Drop watch `index`, whose frame has returned, with a note for the
    // next report.
    end_watch: fn(&self, index: Int) NativeDebugError! {
        number: self.watches[index].number
        self.notes = "{self.notes}Watch {number} on `{self.watches[index].shown}` ended: its frame returned\n"
        self.unwatch(number)
    }

    // Run on as resume does with watch `index` on a local held in a
    // register: its frame's own code runs one instruction at a time, its
    // register compared after each where the local is in it; a call runs
    // at full speed back to its return, since the callee restores the
    // callee-saved register the local is held in. Ends as resume ends: an
    // executed trap byte (its pc past it), a watch's change (`code`), or
    // the program's end; when the frame returns, the watch ends and the
    // program runs on as resume runs it.
    watch_steps: fn(&self, index: Int) -> NativeEvent NativeDebugError! {
        cfa: self.watches[index].cfa
        frames: self.unwind() ?? return Err(err)
        at: loop (level, frame) in frames {
            if frame.cfa == cfa {
                break level
            }
        } ?? -1
        if at < 0 {
            self.end_watch(index) ?? return Err(err)
            return self.go_free(X64TraceResume.Run)
        }
        if at > 0 {
            back := NativeEvent?{None}
            if self.run_free_to(frames[at].pc, frames[at - 1].cfa) == {
                .Ok(found) -> back = found
                .Err(failure) -> return Err(failure)
            }
            if back == .Val(event) -> return Ok(event)
        }
        registers := self.registers() ?? return Err(err)
        loop {
            before: registers
            event: self.go_free(X64TraceResume.Step) ?? return Err(err)
            if event.ends_run() -> return Ok(event)
            registers = self.registers() ?? return Err(err)
            pc := registers[X64_TRACE_RIP]
            if registers[X64_TRACE_RSP] == before[X64_TRACE_RSP] - 8 {
                pushed: native_debug_word(self.trace, registers[X64_TRACE_RSP]) ?? 0
                from: before[X64_TRACE_RIP]
                if pushed > from && pushed <= from + NATIVE_DEBUG_LONGEST_CALL && pc != pushed {
                    back := NativeEvent?{None}
                    if self.run_free_to(pushed, registers[X64_TRACE_RSP] + 8) == {
                        .Ok(found) -> back = found
                        .Err(failure) -> return Err(failure)
                    }
                    if back == .Val(called) -> return Ok(called)
                    registers = self.registers() ?? return Err(err)
                    pc = registers[X64_TRACE_RIP]
                }
            }
            if registers[X64_TRACE_RSP] >= cfa {
                self.end_watch(index) ?? return Err(err)
                if self.has_site(pc) -> return self.resume(X64TraceResume.Step)
                return self.go_free(X64TraceResume.Run)
            }
            covered := false
            loop range in self.watches[index].ranges {
                if pc >= range.start && pc < range.end -> covered = true
            }
            if covered {
                held: native_low_bytes(registers[self.watches[index].register], self.watches[index].bytes.len())
                if held != self.watches[index].bytes {
                    return Ok(NativeEvent{kind: NativeStopKind.Paused, code: self.watch_changed(index, held)})
                }
            }
            // A trap byte the step reached runs, so the stop is a trap's.
            if self.has_site(pc) -> return self.resume(X64TraceResume.Step)
        }
    }

    // Run at full speed until the frame whose canonical frame address is
    // `cfa` returns to `address`, through a temporary trap there: None when
    // it has, the pc back on `address`; else the event that ended the run
    // first, as resume gives it.
    run_free_to: fn(&self, address: Int, cfa: Int) -> NativeEvent? NativeDebugError! {
        temporary: !self.has_site(address)
        if temporary && !self.plant(address) {
            return Err(NativeDebugError{detail: "couldn't write a breakpoint at {native_debug_hex(address)}"})
        }
        loop {
            event: self.go_free(X64TraceResume.Run) ?? return Err(err)
            if event.ends_run() {
                if temporary && self.alive() -> self.lift(address)
                return Ok(Val(event))
            }
            registers := self.registers() ?? return Err(err)
            at: registers[X64_TRACE_RIP] - 1
            if at != address || !temporary {
                if temporary -> self.lift(address)
                return Ok(Val(event))
            }
            // The temporary trap: rewound, it is the return, or a deeper
            // call of the same code passing it.
            registers[X64_TRACE_RIP] = at
            if !x64_trace_set_registers(self.trace, registers) {
                return Err(NativeDebugError{detail: "couldn't set the program's registers"})
            }
            if registers[X64_TRACE_RSP] == cfa {
                self.lift(address)
                return Ok(None)
            }
        }
    }

    // Whether the frame of thread `thread` whose canonical frame address is
    // `cfa` is still on its stack.
    frame_live: fn(&self, thread: Int, cfa: Int) -> Bool NativeDebugError! {
        if self.thread_row(thread) < 0 -> return Ok(false)
        current: self.trace.thread
        self.trace.thread = thread
        found: x64_trace_registers(self.trace)
        self.trace.thread = current
        registers: found ?? return Err(NativeDebugError{detail: "couldn't read the program's registers"})
        frames: self.unwind_from(registers) ?? return Err(err)
        loop frame in frames {
            if frame.cfa == cfa -> return Ok(true)
        }
        Ok(false)
    }

    // `frame <n>`, `up` and `down`: select a Jet frame as `bt` numbers them
    // (#0 innermost, `up` toward the callers), and show it; `locals` and
    // `print` read the selected frame until the program moves.
    frame_command: fn(&self, word: String, operand: String, file: String, lines: [String]) -> String NativeDebugError! {
        frames: self.backtrace() ?? return Err(err)
        current := 0
        loop (level, frame) in frames {
            if level >= self.selected -> break
            if native_debug_jet_frame(frame) -> current += 1
        }
        wanted: if word == {
            "up" -> current + 1
            "down" -> current - 1
            else -> Int.parse(operand) ?? -1
        }
        seen := 0
        loop (level, frame) in frames {
            if !native_debug_jet_frame(frame) -> next
            if seen == wanted {
                _: self.select_frame(level) ?? return Err(err)
                source: if frame.file == file && frame.line >= 1 && frame.line <= lines.len() -> lines[frame.line - 1] else -> ""
                locals: self.locals() ?? return Err(err)
                return Ok("#{wanted}  {frame.function}()  at {frame.file}:{frame.line}\n{frame.line} | {source}\n{native_debug_locals_line(locals)}\n")
            }
            seen += 1
        }
        if word == "frame" {
            return Ok("Frame needs a frame number `bt` shows, 0 to {seen - 1}, as `frame 1`\n")
        }
        Ok("No frame {if word == "up" -> "above" else -> "below"} #{current}\n")
    }

    // The program's new output, then where `stop` left it.
    report: fn(&self, stop: NativeStop, file: String, lines: [String]) -> String NativeDebugError! {
        text := "{self.take_output()}{self.notes}"
        self.notes = ""
        if stop.kind == {
            .Exited -> {
                text = "{text}{if stop.code == 0 -> "Program finished" else -> "Program finished with exit status {stop.code}"}\n"
            }
            .Signaled -> { text = "{text}Program stopped by {stop.reason}\n" }
            .Paused -> {
                frame: stop.frame ?? NativeFrame{function: "?", file: "", line: 0, inlined: false}
                if stop.reason.starts_with("breakpoint") {
                    text = "{text}{NATIVE_DEBUG_BREAKPOINT_HIT}  {frame.file}:{frame.line}  in {frame.function}()\n"
                }
                if stop.reason.starts_with("watchpoint ") {
                    text = "{text}Watchpoint {stop.reason.after("watchpoint ")} hit  {frame.file}:{frame.line}  in {frame.function}()\n{self.watched}\n"
                }
                source: if frame.file == file && frame.line >= 1 && frame.line <= lines.len() -> lines[frame.line - 1] else -> ""
                locals: self.locals() ?? return Err(err)
                text = "{text}{frame.line} | {source}        <- here\n{native_debug_locals_line(locals)}\n"
            }
        }
        Ok(text)
    }

    // The paused facts at the current stop: the innermost Jet frame, its
    // locals, and the Jet call stack outermost first. None when no Jet frame
    // is on the stack.
    snapshot: fn(&self) -> DebugSnapshot? NativeDebugError! {
        frames: self.backtrace() ?? return Err(err)
        stack := [FrameSnapshot]{}
        loop frame in frames {
            if native_debug_jet_frame(frame) {
                stack.insert(0, FrameSnapshot{function: frame.function, line: frame.line})
            }
        }
        if stack.len() == 0 -> return Ok(None)
        top: stack[stack.len() - 1]
        values := [ValueSnapshot]{}
        locals: self.locals() ?? return Err(err)
        loop local in locals {
            values.push(ValueSnapshot{name: local.name, type_name: local.type_name, value: local.value})
        }
        Ok(Val(DebugSnapshot{function: top.function, line: top.line, locals: values, call_stack: stack}))
    }

    // Whether the program runs, stopped for its tracer: launched and not
    // yet over.
    alive: fn(self) -> Bool Never! { self.trace.pid > 0 }

    // Fails unless the program is stopped.
    ready: fn(self) NativeDebugError! {
        if {
            self.alive() -> Ok()
            self.started -> Err(NativeDebugError{detail: "the program has already finished"})
            else -> Err(NativeDebugError{detail: "the program has not started"})
        }
    }

    // The stopped program's registers, or the dump's selected task's.
    registers: fn(self) -> [Int] NativeDebugError! {
        if self.dump == .Val(dumped) -> return Ok(native_dump_registers(dumped, self.task))
        registers: x64_trace_registers(self.trace) ?? return Err(NativeDebugError{detail: "couldn't read the program's registers"})
        Ok(registers)
    }

    // The word of the stopped program, or of the dump, at `address`.
    word: fn(self, address: Int) -> Int? Never! {
        if self.dump == .Val(dumped) {
            read: native_debug_read(dumped.memory, address, 8, 1) ?? return None
            return Val(read[0])
        }
        native_debug_word(self.trace, address)
    }

    // Write a trap byte at `address`, unless one is there; false when the
    // code can't be written.
    plant: fn(&self, address: Int) -> Bool Never! {
        if self.sites.has_key(address) -> return true
        word: x64_trace_peek(self.trace, address) ?? return false
        if !x64_trace_poke(self.trace, address, word & I64{-256} | I64{NATIVE_DEBUG_TRAP}) {
            return false
        }
        self.sites[address] = Int{word & I64{255}}
        true
    }

    // Put back the byte the trap at `address` replaced.
    lift: fn(&self, address: Int) Never! {
        byte: self.sites.remove(address) ?? return
        if x64_trace_peek(self.trace, address) == .Val(word) {
            _ := x64_trace_poke(self.trace, address, word & I64{-256} | I64{byte})
        }
    }

    // Lift every trap no breakpoint wants.
    lift_unwanted: fn(&self) Never! {
        stale := [Int]{}
        loop address in self.sites.keys() {
            if self.breakpoint_at(address) == None -> stale.push(address)
        }
        if !self.alive() {
            self.sites = [Int:Int]{}
            return
        }
        loop address in stale -> self.lift(address)
    }

    has_site: fn(self, address: Int) -> Bool Never! { self.sites.has_key(address) }

    // The number of the breakpoint trapping `address`.
    breakpoint_at: fn(self, address: Int) -> Int? Never! {
        loop breakpoint in self.breakpoints {
            loop at in breakpoint.addresses {
                if at == address -> return Val(breakpoint.number)
            }
        }
        None
    }

    // `count` bytes of the program's code from `address`, as the image has
    // them: the bytes under trap bytes put back. A dump's are its image's.
    code: fn(self, address: Int, count: Int) -> [U8] Never! {
        if self.dump == .Val(dumped) {
            return native_debug_bytes(dumped.memory, address, count) ?? [U8]{}
        }
        bytes := x64_trace_read(self.trace, address, count) ?? [U8]{}
        loop at in 0..<bytes.len() {
            if self.sites.get(address + at) == .Val(byte) -> bytes[at] = U8{byte}
        }
        bytes
    }

    // Let the program go on as `how` says; a run with a watch on a local
    // held in a register follows it (watch_steps), on the local's thread:
    // this thread is stepped off a trap byte at its pc first.
    go: fn(&self, how: X64TraceResume) -> NativeEvent NativeDebugError! {
        if how == X64TraceResume.Run {
            loop (index, watch) in self.watches {
                if watch.register < 0 -> next
                if watch.thread != self.trace.thread {
                    if self.thread_row(watch.thread) < 0 {
                        self.end_watch(index) ?? return Err(err)
                        break
                    }
                    registers: self.registers() ?? return Err(err)
                    if self.has_site(registers[X64_TRACE_RIP]) {
                        stepped: self.go_free(X64TraceResume.Step) ?? return Err(err)
                        if stepped.ends_run() -> return Ok(stepped)
                    }
                    self.trace.thread = watch.thread
                }
                return self.watch_steps(index)
            }
        }
        self.go_free(how)
    }

    // Let the program go on as `how` says, off a trap byte at its pc first:
    // the byte is put back for one instruction, then trapped again.
    go_free: fn(&self, how: X64TraceResume) -> NativeEvent NativeDebugError! {
        self.selected = 0
        registers: self.registers() ?? return Err(err)
        pc: registers[X64_TRACE_RIP]
        if self.has_site(pc) {
            byte: self.sites.get(pc) ?? 0
            if x64_trace_peek(self.trace, pc) == .Val(word) {
                _ := x64_trace_poke(self.trace, pc, word & I64{-256} | I64{byte})
            }
            stepped: self.resume(X64TraceResume.Step) ?? return Err(err)
            if stepped.kind != NativeStopKind.Paused -> return Ok(stepped)
            if x64_trace_peek(self.trace, pc) == .Val(word) {
                _ := x64_trace_poke(self.trace, pc, word & I64{-256} | I64{NATIVE_DEBUG_TRAP})
            }
            if how == X64TraceResume.Step || stepped.code > 0 -> return Ok(stepped)
        }
        self.resume(how)
    }

    // Resume the program as `how` says: the stopped thread, and on a run
    // every other thread too; a step moves the stopped thread alone.
    resume: fn(&self, how: X64TraceResume) -> NativeEvent NativeDebugError! {
        self.resume_threads(how, every: how == X64TraceResume.Run)
    }

    // Resume the current thread as `how` says, and with `every` the
    // program's other threads too, until a thread traps or the program
    // ends. The trapping thread becomes the current one and every other
    // stops again (halt): all-stop, so a stop sees the whole program still.
    // Any other signal goes on to its thread, as it would untraced; a
    // thread the program starts runs when `every` does. A watch's trap on a
    // write that left its bytes as they were runs on.
    resume_threads: fn(&self, how: X64TraceResume, every: Bool{true}) -> NativeEvent NativeDebugError! {
        going := every
        row: self.thread_row(self.trace.thread)
        if row < 0 || !self.let_go(row, how) {
            return Err(NativeDebugError{detail: "the program can't be resumed"})
        }
        if going -> self.let_all_go()
        loop {
            stop: x64_trace_wait(self.trace)
            if stop.thread < 0 {
                return Err(NativeDebugError{detail: "waiting for the program failed (errno {-stop.thread})"})
            }
            status: stop.status
            at: self.thread_row(stop.thread)
            if status & 0xff != 0x7f {
                if stop.thread == self.trace.pid -> return Ok(self.finished(status))
                if at >= 0 -> _ := self.threads.remove(at, .Slot)
                // A stepped thread that ended leaves the others to run.
                if stop.thread == self.trace.thread {
                    self.trace.thread = self.trace.pid
                    if !going {
                        going = true
                        self.let_all_go()
                    }
                }
                next
            }
            signal: (status >> 8) & 0xff
            if at < 0 {
                // A thread the program started, stopped before its first
                // instruction.
                self.threads.push(NativeThread{id: stop.thread, running: false, halting: false, signal: native_trace_signal(status)})
                self.arm(self.threads.len() - 1) ?? return Err(err)
                if going -> _ := self.let_go(self.threads.len() - 1, X64TraceResume.Run)
                next
            }
            self.threads[at].running = false
            mine: stop.thread == self.trace.thread
            mode: if mine -> how else -> X64TraceResume.Run
            // A clone event (the thread it started reports itself), the
            // SIGSTOP of an earlier halt arriving, or a stop without a signal
            // (an attached program's).
            cloned: (status >> 16) == X64_TRACE_EVENT_CLONE || (status >> 16) == X64_TRACE_EVENT_STOP
            halted: signal == NATIVE_DEBUG_SIGSTOP && self.threads[at].halting
            if cloned || halted {
                if halted -> self.threads[at].halting = false
                if mine || going -> _ := self.let_go(at, mode)
                next
            }
            if signal == NATIVE_DEBUG_SIGTRAP {
                stepping: self.trace.thread
                self.trace.thread = stop.thread
                code := 0
                if self.watches.len() > 0 {
                    fired: self.watch_fired() ?? return Err(err)
                    if fired.number == 0 && fired.fired && !(mine && how == X64TraceResume.Step) {
                        self.trace.thread = stepping
                        _ := self.let_go(at, mode)
                        next
                    }
                    code = fired.number
                }
                if self.halt() == {
                    .Ok(ended) -> {
                        if ended == .Val(event) -> return Ok(event)
                    }
                    .Err(failure) -> return Err(failure)
                }
                return Ok(NativeEvent{kind: NativeStopKind.Paused, code: code})
            }
            // A stop signal stops the program for its tracer alone.
            self.threads[at].signal = if signal == NATIVE_DEBUG_SIGSTOP -> 0 else -> signal
            if mine || going -> _ := self.let_go(at, mode)
        }
    }

    // The row of thread `id` in `threads`; -1 when it is not traced.
    thread_row: fn(self, id: Int) -> Int Never! {
        loop (row, thread) in self.threads {
            if thread.id == id -> return row
        }
        -1
    }

    // Let thread `row` go on as `how` says, with the signal it holds; false
    // when the kernel refused (it has ended, as its next wait says).
    let_go: fn(&self, row: Int, how: X64TraceResume) -> Bool Never! {
        current: self.trace.thread
        self.trace.thread = self.threads[row].id
        going: x64_trace_resume(self.trace, how, self.threads[row].signal)
        self.trace.thread = current
        self.threads[row].signal = 0
        self.threads[row].running = going
        going
    }

    // Let every stopped thread run.
    let_all_go: fn(&self) Never! {
        loop row in 0..<self.threads.len() {
            if !self.threads[row].running -> _ := self.let_go(row, X64TraceResume.Run)
        }
    }

    // Stop every running thread for the current thread's stop: each gets a
    // SIGSTOP and is waited for. A thread that trapped meanwhile on a trap
    // byte is rewound onto it, to trap again when it next runs; any other
    // signal waits for its next run. The program's end when it ended
    // meanwhile.
    halt: fn(&self) -> NativeEvent? NativeDebugError! {
        loop row in 0..<self.threads.len() {
            if self.threads[row].running && !self.threads[row].halting {
                self.threads[row].halting = x64_trace_stop(self.trace, self.threads[row].id)
            }
        }
        loop {
            waiting := false
            loop thread in self.threads {
                if thread.running -> waiting = true
            }
            if !waiting -> return Ok(None)
            stop: x64_trace_wait(self.trace)
            if stop.thread < 0 {
                return Err(NativeDebugError{detail: "waiting for the program failed (errno {-stop.thread})"})
            }
            status: stop.status
            at: self.thread_row(stop.thread)
            if status & 0xff != 0x7f {
                if stop.thread == self.trace.pid -> return Ok(Val(self.finished(status)))
                if at >= 0 -> _ := self.threads.remove(at, .Slot)
                next
            }
            signal: (status >> 8) & 0xff
            if at < 0 {
                self.threads.push(NativeThread{id: stop.thread, running: false, halting: false, signal: native_trace_signal(status)})
                self.arm(self.threads.len() - 1) ?? return Err(err)
                next
            }
            self.threads[at].running = false
            // A clone event leaves the SIGSTOP still to come; so does a stop
            // without a signal.
            if (status >> 16) == X64_TRACE_EVENT_CLONE || (status >> 16) == X64_TRACE_EVENT_STOP {
                next
            }
            if signal == NATIVE_DEBUG_SIGSTOP {
                self.threads[at].halting = false
                next
            }
            if signal == NATIVE_DEBUG_SIGTRAP {
                self.rewind(stop.thread) ?? return Err(err)
                next
            }
            self.threads[at].signal = signal
        }
    }

    // Thread `id`, stopped by a trap byte it ran, back on that byte.
    rewind: fn(&self, id: Int) NativeDebugError! {
        current: self.trace.thread
        self.trace.thread = id
        registers := x64_trace_registers(self.trace) ?? [Int]{}
        pc: if registers.len() > 0 -> registers[X64_TRACE_RIP] - 1 else -> 0
        if registers.len() > 0 && self.has_site(pc) {
            registers[X64_TRACE_RIP] = pc
            if !x64_trace_set_registers(self.trace, registers) {
                self.trace.thread = current
                return Err(NativeDebugError{detail: "couldn't set the program's registers"})
            }
        }
        self.trace.thread = current
        Ok()
    }

    // Give thread `row`, new to the program, the watches' debug registers,
    // as every thread has them.
    arm: fn(&self, row: Int) NativeDebugError! {
        if self.watches.len() == 0 -> return Ok()
        current: self.trace.thread
        self.trace.thread = self.threads[row].id
        armed := true
        loop watch in self.watches {
            loop span in watch.spans {
                if !x64_trace_set_debug_register(self.trace, span.slot, span.address) {
                    armed = false
                }
            }
        }
        if !x64_trace_set_debug_register(self.trace, 7, native_watch_control(self.watches)) {
            armed = false
        }
        self.trace.thread = current
        if !armed {
            return Err(NativeDebugError{detail: "couldn't set a debug register of a new thread"})
        }
        Ok()
    }

    // Set debug register `index` of every thread to `value`; false when the
    // kernel refused one.
    set_debug_register: fn(&self, index: Int, value: Int) -> Bool Never! {
        current: self.trace.thread
        set := true
        loop thread in self.threads {
            self.trace.thread = thread.id
            if !x64_trace_set_debug_register(self.trace, index, value) -> set = false
        }
        self.trace.thread = current
        set
    }

    // The program's end, reaped (its wait status `status`): its exit
    // status, or the signal that killed it.
    finished: fn(&self, status: Int) -> NativeEvent Never! {
        self.ended()
        if status & 0x7f == 0 {
            return NativeEvent{kind: NativeStopKind.Exited, code: (status >> 8) & 0xff}
        }
        NativeEvent{kind: NativeStopKind.Signaled, code: status & 0x7f}
    }

    // The program is gone: its pid is reaped, and its threads, traps and
    // watches go with it.
    ended: fn(&self) Never! {
        self.trace.pid = -1
        x64_trace_close(self.trace)
        self.threads = [NativeThread]{}
        self.sites = [Int:Int]{}
        self.watches = [NativeWatch]{}
    }

    // The stop `event` is: a write a watch saw, a trap byte's breakpoint,
    // rewinding the pc onto it, a trap the program made itself, or its end.
    stopped: fn(&self, event: NativeEvent) -> NativeStop NativeDebugError! {
        if event.kind == {
            .Exited -> Ok(NativeStop{kind: NativeStopKind.Exited, reason: "exited", code: event.code, frame: None})
            .Signaled -> Ok(NativeStop{kind: NativeStopKind.Signaled, reason: native_debug_signal_name(event.code), code: -1, frame: None})
            .Paused -> {
                registers := self.registers() ?? return Err(err)
                // The trap comes after the write: its line holds pc - 1.
                if event.code > 0 {
                    return Ok(NativeStop{kind: NativeStopKind.Paused, reason: "watchpoint {event.code}", code: 0, frame: Val(native_frames_at(self.image, registers[X64_TRACE_RIP] - 1)[0])})
                }
                at: registers[X64_TRACE_RIP] - 1
                if !self.has_site(at) -> return self.paused("signal SIGTRAP")
                registers[X64_TRACE_RIP] = at
                if !x64_trace_set_registers(self.trace, registers) {
                    return Err(NativeDebugError{detail: "couldn't set the program's registers"})
                }
                if self.breakpoint_at(at) == .Val(number) {
                    return self.paused("breakpoint {number}.1")
                }
                self.paused("signal SIGTRAP")
            }
        }
    }

    // A pause for `reason` where the program is, in the innermost frame there.
    paused: fn(self, reason: String) -> NativeStop NativeDebugError! {
        registers: self.registers() ?? return Err(err)
        Ok(NativeStop{kind: NativeStopKind.Paused, reason: reason, code: 0, frame: Val(native_frames_at(self.image, registers[X64_TRACE_RIP])[0])})
    }

    // Run the program until the frame whose canonical frame address is `cfa`
    // returns to `address`, or a breakpoint or its end stops it first.
    run_to_return: fn(&self, address: Int, cfa: Int) -> NativeReturn NativeDebugError! {
        temporary: !self.has_site(address)
        if temporary && !self.plant(address) {
            return Err(NativeDebugError{detail: "couldn't write a breakpoint at {native_debug_hex(address)}"})
        }
        loop {
            event: self.go(X64TraceResume.Run) ?? return Err(err)
            if event.ends_run() {
                if temporary && self.alive() -> self.lift(address)
                return Ok(NativeReturn.Stopped{stop: self.stopped(event) ?? return Err(err)})
            }
            registers := self.registers() ?? return Err(err)
            at: registers[X64_TRACE_RIP] - 1
            if !self.has_site(at) {
                if temporary -> self.lift(address)
                return Ok(NativeReturn.Stopped{stop: self.paused("signal SIGTRAP") ?? return Err(err)})
            }
            registers[X64_TRACE_RIP] = at
            if !x64_trace_set_registers(self.trace, registers) {
                return Err(NativeDebugError{detail: "couldn't set the program's registers"})
            }
            if at == address && registers[X64_TRACE_RSP] == cfa {
                if temporary -> self.lift(address)
                return Ok(NativeReturn.Returned)
            }
            if self.breakpoint_at(at) == .Val(number) {
                if temporary -> self.lift(address)
                return Ok(NativeReturn.Stopped{stop: self.paused("breakpoint {number}.1") ?? return Err(err)})
            }
            // The return address trapped for a deeper call of the same
            // function: run on.
        }
    }

    // Step to the next line of this frame, or into the next Jet call's first
    // line when `calls` is Into. The step ends on a row of another line: a
    // loop that turns back onto this line runs on, so a one-line loop is
    // stepped over whole. Over runs to that row (line_over); Into
    // single-steps, and a call into code without Jet lines runs to its
    // return. A return out of this frame stops in the caller.
    line_step: fn(&self, calls: NativeStepCalls) -> NativeStop NativeDebugError! {
        self.ready() ?? return Err(err)
        reason: if calls == {
            .Over -> "step over"
            .Into -> "step in"
        }
        registers := self.registers() ?? return Err(err)
        start: registers[X64_TRACE_RIP]
        function: x64_jetline_find(self.image.lines, start)
        if function < 0 -> return self.step_out()
        line: x64_jetline_line(self.image.lines, self.image.lines.functions[function], start) ?? 0
        base: native_frame_base(self.openings, function, registers, start, self.code(start, 1))
        if calls == NativeStepCalls.Over -> return self.line_over(function, line, base, reason)
        loop _ in 0..<NATIVE_DEBUG_MOST_STEPS {
            before: registers
            event: self.go(X64TraceResume.Step) ?? return Err(err)
            if event.ends_run() -> return self.stopped(event)
            registers = self.registers() ?? return Err(err)
            pc := registers[X64_TRACE_RIP]
            if registers[X64_TRACE_RSP] == before[X64_TRACE_RSP] - 8 {
                pushed: native_debug_word(self.trace, registers[X64_TRACE_RSP]) ?? 0
                from: before[X64_TRACE_RIP]
                if pushed > from && pushed <= from + NATIVE_DEBUG_LONGEST_CALL && pc != pushed {
                    callee: x64_jetline_find(self.image.lines, pc)
                    if callee < 0 {
                        returned: self.run_to_return(pushed, registers[X64_TRACE_RSP] + 8) ?? return Err(err)
                        if returned == .Stopped(stop) -> return Ok(stop)
                        registers = self.registers() ?? return Err(err)
                        pc = registers[X64_TRACE_RIP]
                    }
                }
            }
            here: x64_jetline_find(self.image.lines, pc)
            if here < 0 {
                if registers[X64_TRACE_RSP] >= base -> return self.paused(reason)
                next
            }
            frame: native_frame_base(self.openings, here, registers, pc, self.code(pc, 1))
            if frame > base -> return self.paused(reason)
            if pc == self.openings[here].at || !native_row_start(self.image, here, pc) -> next
            if frame < base -> return self.paused(reason)
            if (x64_jetline_line(self.image.lines, self.image.lines.functions[here], pc) ?? 0) != line {
                return self.paused(reason)
            }
        }
        self.paused(reason)
    }

    // `next` on `line` of function `index`, whose frame's canonical frame
    // address is `base`: a temporary trap on each row of the function on
    // another line and on the frame's return address, then one run, so a
    // line that loops a million times costs one stop, not one per
    // instruction. The traps are lifted again however the run stops.
    line_over: fn(&self, index: Int, line: Int, base: Int, reason: String) -> NativeStop NativeDebugError! {
        returned: native_debug_word(self.trace, base - 8) ?? 0
        targets := native_step_targets(self.image, index, line)
        if returned > 0 -> targets.push(returned)
        owned := [Int]{}
        loop address in targets {
            if !self.has_site(address) -> owned.push(address)
        }
        if self.line_over_run(index, line, base, returned, owned, reason) == {
            .Ok(stop) -> {
                self.lift_owned(owned)
                return Ok(stop)
            }
            .Err(failure) -> {
                self.lift_owned(owned)
                return Err(failure)
            }
        }
    }

    // Trap each of line_over's own addresses `owned`.
    plant_owned: fn(&self, owned: [Int]) NativeDebugError! {
        if !self.patch_owned(owned, NativePatch.Trap) {
            return Err(NativeDebugError{detail: "couldn't write the step's breakpoints"})
        }
        Ok()
    }

    // Trap or put back (`how`) line_over's addresses `owned`. The code is
    // read and written back once for each run of them that lie within
    // NATIVE_DEBUG_PATCH_GAP bytes of each other, so a step costs a few
    // system calls however many rows its function has, not two helper round
    // trips per row. False when the code can't be read or written.
    patch_owned: fn(&self, owned: [Int], how: NativePatch) -> Bool Never! {
        sorted := owned.copy()
        sorted.sort()
        start := 0
        loop start < sorted.len() {
            end := start + 1
            loop end < sorted.len() && sorted[end] - sorted[end - 1] <= NATIVE_DEBUG_PATCH_GAP {
                end += 1
            }
            low: sorted[start]
            count: sorted[end - 1] + 1 - low
            bytes := x64_trace_read(self.trace, low, count) ?? return false
            if bytes.len() != count -> return false
            loop k in start..<end {
                address: sorted[k]
                if how == {
                    .Trap -> {
                        if self.sites.has_key(address) -> next
                        self.sites[address] = Int{bytes[address - low]}
                        bytes[address - low] = U8{NATIVE_DEBUG_TRAP}
                    }
                    .Restore -> {
                        byte: self.sites.remove(address) ?? next
                        bytes[address - low] = U8{byte}
                    }
                }
            }
            if !x64_trace_write(self.trace, low, bytes) -> return false
            start = end
        }
        true
    }

    // Lift line_over's traps `owned`, unless the program has ended and taken
    // them with it.
    lift_owned: fn(&self, owned: [Int]) Never! {
        if !self.alive() {
            return
        }
        _ := self.patch_owned(owned, NativePatch.Restore)
    }

    // Run under line_over's traps until one stops the step: the frame's
    // return reached with the frame gone, or a row of this frame on another
    // line. A trap in a deeper call of the same function (recursion) lifts
    // the traps and runs that call out to this frame, so a recursive call
    // costs two stops, not one per row it runs; another thread's trap on
    // them runs on. A breakpoint, a trap the program made itself or its end
    // stops the run first.
    line_over_run: fn(&self, index: Int, line: Int, base: Int, returned: Int, owned: [Int], reason: String) -> NativeStop NativeDebugError! {
        low: self.image.lines.functions[index].low
        high: self.image.lines.functions[index].high
        stepping: self.trace.thread
        self.plant_owned(owned) ?? return Err(err)
        loop {
            event: self.go(X64TraceResume.Run) ?? return Err(err)
            if event.ends_run() -> return self.stopped(event)
            registers := self.registers() ?? return Err(err)
            at: registers[X64_TRACE_RIP] - 1
            if !self.has_site(at) -> return self.paused("signal SIGTRAP")
            registers[X64_TRACE_RIP] = at
            if !x64_trace_set_registers(self.trace, registers) {
                return Err(NativeDebugError{detail: "couldn't set the program's registers"})
            }
            if self.breakpoint_at(at) == .Val(number) -> return self.paused("breakpoint {number}.1")
            if self.trace.thread != stepping -> next
            if at == returned && registers[X64_TRACE_RSP] >= base -> return self.paused(reason)
            if at < low || at >= high -> next
            frame: native_frame_base(self.openings, index, registers, at, self.code(at, 1))
            if frame > base -> return self.paused(reason)
            if frame < base {
                self.lift_owned(owned)
                back: self.run_out_to(base) ?? return Err(err)
                if back == .Stopped(stop) -> return Ok(stop)
                pc: (self.registers() ?? return Err(err))[X64_TRACE_RIP]
                if pc >= low && pc < high && pc != low && native_row_start(self.image, index, pc) && (x64_jetline_line(self.image.lines, self.image.lines.functions[index], pc) ?? 0) != line {
                    return self.paused(reason)
                }
                self.plant_owned(owned) ?? return Err(err)
                next
            }
            if (x64_jetline_line(self.image.lines, self.image.lines.functions[index], at) ?? 0) != line {
                return self.paused(reason)
            }
        }
    }

    // Run the call the frame at canonical frame address `base` made out to
    // its return there, or to the stop that comes first. A stack too deep
    // to find that call in leaves the program where it is, as Returned.
    run_out_to: fn(&self, base: Int) -> NativeReturn NativeDebugError! {
        frames: self.unwind() ?? return Err(err)
        loop k in 0..<frames.len() {
            if k + 1 < frames.len() && frames[k + 1].cfa == base {
                return self.run_to_return(frames[k + 1].pc, frames[k].cfa)
            }
        }
        Ok(NativeReturn.Returned)
    }

    // The current thread's frames, innermost first (unwind_from).
    unwind: fn(self) -> [NativeUnwound] NativeDebugError! {
        registers: self.registers() ?? return Err(err)
        self.unwind_from(registers)
    }

    // The frames of a stack whose innermost registers are `start`,
    // innermost first, unwound through the prologue each Jet function opens
    // with (`push rbp; mov rbp, rsp`, then a push of each callee-saved
    // register it uses) and the frame-pointer chain elsewhere.
    unwind_from: fn(self, start: [Int]) -> [NativeUnwound] NativeDebugError! {
        registers := loop value in start -> value
        known := loop _ in 0..<registers.len() -> true
        frames := [NativeUnwound]{}
        loop frames.len() < NATIVE_DEBUG_MOST_FRAMES {
            pc: registers[X64_TRACE_RIP]
            lookup: if frames.len() == 0 -> pc else -> pc - 1
            function: x64_jetline_find(self.image.lines, lookup)
            here: self.code(pc, 1)
            cfa: native_frame_base(self.openings, function, registers, pc, here)
            frames.push(NativeUnwound{pc: pc, cfa: cfa, registers: registers.copy(), known: known.copy()})
            if cfa <= registers[X64_TRACE_RSP] -> break
            returned: self.word(cfa - 8) ?? break
            if returned <= 0 -> break
            rsp_word: self.word(registers[X64_TRACE_RSP])
            rbp_word: if registers[X64_TRACE_RBP] > 0 -> self.word(registers[X64_TRACE_RBP]) else -> Int?{None}
            caller_rbp: native_caller_rbp(self.openings, function, registers, pc, here, rsp_word, rbp_word) ?? break
            next_known := loop _ in 0..<registers.len() -> false
            loop index in NATIVE_DEBUG_CALLEE_SAVED -> next_known[index] = known[index]
            loop save in native_prologue_saves(self.openings, function) {
                if pc >= save.after && registers[X64_TRACE_RBP] > 0 {
                    if self.word(registers[X64_TRACE_RBP] - 8 * (save.slot + 1)) == .Val(saved) {
                        registers[save.register] = saved
                        next_known[save.register] = true
                    }
                }
            }
            registers[X64_TRACE_RIP] = returned
            registers[X64_TRACE_RSP] = cfa
            registers[X64_TRACE_RBP] = caller_rbp
            next_known[X64_TRACE_RIP] = true
            next_known[X64_TRACE_RSP] = true
            next_known[X64_TRACE_RBP] = true
            known = next_known
            if function < 0 && caller_rbp == 0 {
                frames.push(NativeUnwound{pc: returned, cfa: 0, registers: registers.copy(), known: known.copy()})
                break
            }
        }
        Ok(frames)
    }
}

// The trap byte (int3).
NATIVE_DEBUG_TRAP: 0xcc

// The widest gap between two of a step's trap addresses that patch_owned
// reads and writes through in one piece rather than two.
NATIVE_DEBUG_PATCH_GAP: 4096

NATIVE_DEBUG_SIGTRAP: 5

// The CPU's debug address registers (DR0 to DR3) a watch's spans take.
NATIVE_DEBUG_WATCH_SLOTS: 4

// The bits of the debug status register (DR6) that say which of DR0 to DR3
// trapped.
NATIVE_DEBUG_WATCH_HITS: 15

NATIVE_DEBUG_SIGSTOP: 19

// The errors x64_trace_seize reports: the system refused the trace, and the
// thread has ended.
NATIVE_DEBUG_EPERM: 1

NATIVE_DEBUG_ESRCH: 3

// The bytes of a function's start read for its prologue: a stack check, the
// frame's opening and its saves.
NATIVE_DEBUG_PROLOGUE: 48

// The longest x86-64 call instruction.
NATIVE_DEBUG_LONGEST_CALL: 15

// The most instructions one line step single-steps.
NATIVE_DEBUG_MOST_STEPS: 10000000

// The most frames a backtrace unwinds.
NATIVE_DEBUG_MOST_FRAMES: 256

// The registers (as the kernel orders them) a call preserves: r15, r14,
// r13, r12, rbp and rbx.
NATIVE_DEBUG_CALLEE_SAVED: [Int]{0, 1, 2, 3, 4, 5}

// The kernel's register index of each x86-64 register number (rax, rcx,
// rdx, rbx, rsp, rbp, rsi, rdi, r8 to r15).
NATIVE_DEBUG_MACHINE_REGISTERS: [Int]{10, 11, 12, 5, 19, 4, 13, 14, 9, 8, 7, 6, 3, 2, 1, 0}

// The kernel's register index of each DWARF x86-64 register number (rax,
// rdx, rcx, rbx, rsi, rdi, rbp, rsp, r8 to r15, the return address).
NATIVE_DEBUG_DWARF_REGISTERS: [Int]{10, 12, 11, 5, 13, 14, 4, 19, 9, 8, 7, 6, 3, 2, 1, 0, 16}

// One callee-saved register a prologue pushes: its kernel register index,
// the address after the push and its slot below the frame pointer.
NativeSave: struct {
    register: Int,
    after: Int,
    slot: Int,
}

// Where `prologue` (a function's first bytes) opens a frame with `push rbp;
// mov rbp, rsp`: at its start, or past the stack check a body that may grow
// its stack starts with (JetIR X64Select.jet ir_x64_stack_check: an
// optional `lea r11, [rsp - frame]`, `cmp rsp|r11, gs:[limit]` and `jb`);
// -1 when it opens none there.
native_frame_open: fn(prologue: [U8]) -> Int Never! {
    at := 0
    if native_bytes_at(prologue, at, [U8]{0x4c, 0x8d, 0x9c, 0x24}) -> at = 8
    compared: native_bytes_at(prologue, at, [U8]{0x65, 0x48, 0x3b, 0x24, 0x25}) || native_bytes_at(prologue, at, [U8]{0x65, 0x4c, 0x3b, 0x1c, 0x25})
    if !compared && at > 0 -> return -1
    if compared {
        // the jb past the compare: rel32 or, relaxed, rel8
        branch: if {
            native_bytes_at(prologue, at + 9, [U8]{0x0f, 0x82}) -> 6
            native_bytes_at(prologue, at + 9, [U8]{0x72}) -> 2
            else -> 0
        }
        if branch == 0 -> return -1
        at += 9 + branch
    }
    if native_bytes_at(prologue, at, [U8]{0x55, 0x48, 0x89, 0xe5}) -> at else -> -1
}

// Whether `bytes` holds `want` at `at`.
native_bytes_at: fn(bytes: [U8], at: Int, want: [U8]) -> Bool Never! {
    if at + want.len() > bytes.len() -> return false
    loop (k, byte) in want {
        if bytes[at + k] != byte -> return false
    }
    true
}

// The callee-saved registers the prologue of function `function` pushes
// after it opens the frame (none for code without Jet line information,
// `function` -1).
native_prologue_saves: fn(openings: [NativeOpening], function: Int) -> [NativeSave] Never! {
    saves := [NativeSave]{}
    if function < 0 -> return saves
    prologue: openings[function].prologue
    low: openings[function].at
    open: native_frame_open(prologue)
    if open < 0 -> return saves
    at := open + 4
    loop at < prologue.len() {
        byte: Int{prologue[at]}
        if byte >= 0x50 && byte <= 0x57 {
            saves.push(NativeSave{register: NATIVE_DEBUG_MACHINE_REGISTERS[byte - 0x50], after: low + at + 1, slot: saves.len()})
            at += 1
            next
        }
        if byte == 0x41 && at + 1 < prologue.len() {
            second: Int{prologue[at + 1]}
            if second >= 0x50 && second <= 0x57 {
                saves.push(NativeSave{register: NATIVE_DEBUG_MACHINE_REGISTERS[8 + second - 0x50], after: low + at + 2, slot: saves.len()})
                at += 2
                next
            }
        }
        break
    }
    saves
}

// The canonical frame address of the frame at `pc` in Jet function
// `function` (-1: code without Jet line information, where the frame
// pointer chain is trusted); `here` is the code byte at `pc`. Up to where
// the function opens its frame, a frame-free prefix included, the return
// address is on top of the stack.
native_frame_base: fn(openings: [NativeOpening], function: Int, registers: [Int], pc: Int, here: [U8]) -> Int Never! {
    rsp: registers[X64_TRACE_RSP]
    rbp: registers[X64_TRACE_RBP]
    if function < 0 -> return rbp + 16
    low: openings[function].at
    open: native_frame_open(openings[function].prologue)
    if open >= 0 {
        if pc <= low + open -> return rsp + 8
        if pc == low + open + 1 -> return rsp + 16
        if here.len() == 1 && here[0] == (U8{0xc3}) -> return rsp + 8
    }
    rbp + 16
}

// The caller's frame pointer, for the frame native_frame_base measured;
// `here` is the code byte at `pc`, `rsp_word` and `rbp_word` the words the
// stack and frame pointers point at.
native_caller_rbp: fn(openings: [NativeOpening], function: Int, registers: [Int], pc: Int, here: [U8], rsp_word: Int?, rbp_word: Int?) -> Int? Never! {
    rbp: registers[X64_TRACE_RBP]
    open: if function >= 0 -> native_frame_open(openings[function].prologue) else -> -1
    if open >= 0 {
        low: openings[function].at
        if pc <= low + open -> return Val(rbp)
        if pc == low + open + 1 -> return Val(rsp_word ?? return None)
        if here.len() == 1 && here[0] == (U8{0xc3}) -> return Val(rbp)
    }
    if rbp <= 0 -> return None
    Val(rbp_word ?? return None)
}

// Where a Jet function opens its frame: at `at`, whose code bytes are
// `prologue`. That is the function's start, or, for a body that starts
// with a frame-free prefix (JetIR X64Select.jet ir_x64_wrap), the row past
// the prefix whose code opens the frame; before `at` the function has no
// frame of its own. A start that opens none and has no such row keeps `at`
// at the start.
NativeOpening: struct {
    at: Int,
    prologue: [U8],
}

// The opening of each function of `image`'s line table, read from `code`.
native_openings: fn(image: NativeImage, code: NativeCode) -> [NativeOpening] Never! {
    openings := [NativeOpening]{}
    loop index in 0..<image.lines.functions.len() {
        openings.push(native_opening(image, index, code))
    }
    openings
}

native_opening: fn(image: NativeImage, index: Int, code: NativeCode) -> NativeOpening Never! {
    function: image.lines.functions[index]
    start: native_code_at(code, function.low)
    if native_frame_open(start) >= 0 -> return NativeOpening{at: function.low, prologue: start}
    at := function.rows
    address := function.low
    loop at < function.rows_end {
        address += link_debug_uleb(image.lines.table, at)
        _ := x64_jetline_sleb(image.lines.table, at)
        if address == function.low -> next
        bytes: native_code_at(code, address)
        if native_bytes_at(bytes, 0, [U8]{0x55, 0x48, 0x89, 0xe5}) {
            return NativeOpening{at: address, prologue: bytes}
        }
    }
    NativeOpening{at: function.low, prologue: start}
}

// The NATIVE_DEBUG_PROLOGUE bytes of `code` from `address` (fewer at its
// end, none outside it).
native_code_at: fn(code: NativeCode, address: Int) -> [U8] Never! {
    at: address - code.address
    if at < 0 || at >= code.bytes.len() -> return [U8]{}
    end: if at + NATIVE_DEBUG_PROLOGUE < code.bytes.len() -> at + NATIVE_DEBUG_PROLOGUE else -> code.bytes.len()
    code.bytes[at..<end]
}

// The word of the stopped program at `address`.
native_debug_word: fn(trace: X64Trace, address: Int) -> Int? Never! {
    word: x64_trace_peek(trace, address) ?? return None
    Val(Int{word})
}

// The addresses of `line` in the Jet source `file` (by base name): in each
// function, the first row of the line in its own code and in each inlined
// copy it holds (two instances of a generic module's member inlined into one
// caller are two copies). A function with no row of the line, but rows on or
// before it, gives its first row of the nearest later line instead.
native_line_addresses: fn(image: NativeImage, file: String, line: Int) -> [Int] Never! {
    wanted: native_files.basename(file)
    addresses := [Int]{}
    loop function in image.lines.functions {
        if native_files.basename(function.file) != wanted -> next
        described: native_function_at(image, function.low)
        sites := [NativeLineSite]{}
        covers := false
        nearest := -1
        nearest_line := 0
        at := function.rows
        address := function.low
        current := 1
        loop at < function.rows_end {
            address += link_debug_uleb(image.lines.table, at)
            current += x64_jetline_sleb(image.lines.table, at)
            if current <= line -> covers = true
            if current > line && (nearest < 0 || current < nearest_line) {
                nearest = address
                nearest_line = current
            }
            if current != line -> next
            site: native_line_site(described, address)
            seen := false
            loop found in sites {
                if found.site == site -> seen = true
            }
            if !seen -> sites.push(NativeLineSite{site: site, address: address})
        }
        loop found in sites -> addresses.push(found.address)
        if sites.len() == 0 && covers && nearest >= 0 -> addresses.push(nearest)
    }
    addresses
}

// The first row of the searched line in one run of code: the function's own
// code (`site` -1) or one inlined copy (the run's index).
NativeLineSite: struct {
    site: Int,
    address: Int,
}

// The innermost inlined run of `function` holding `address`; -1 for the
// function's own code, or without its DWARF facts.
native_line_site: fn(function: NativeFunction?, address: Int) -> Int Never! {
    described: function ?? return -1
    chain: native_inline_chain(described, address)
    if chain.len() == 0 -> -1 else -> chain[0]
}

// The first address past function `index`'s prologue: its second row, or
// its start when it has one row.
native_body_start: fn(image: NativeImage, index: Int) -> Int Never! {
    function: image.lines.functions[index]
    at := function.rows
    address := function.low
    loop at < function.rows_end {
        address += link_debug_uleb(image.lines.table, at)
        _ := x64_jetline_sleb(image.lines.table, at)
        if address > function.low -> return address
    }
    function.low
}

// The rows of function `index` a `next` on `line` may stop at: each on
// another line. The function's first address, which only a deeper call
// reaches, is left out.
native_step_targets: fn(image: NativeImage, index: Int, line: Int) -> [Int] Never! {
    function: image.lines.functions[index]
    targets := [Int]{}
    at := function.rows
    address := function.low
    current := 1
    loop at < function.rows_end {
        address += link_debug_uleb(image.lines.table, at)
        current += x64_jetline_sleb(image.lines.table, at)
        if address == function.low -> next
        if current != line -> targets.push(address)
    }
    targets
}

// Whether `pc` starts a row of function `index`.
native_row_start: fn(image: NativeImage, index: Int, pc: Int) -> Bool Never! {
    function: image.lines.functions[index]
    at := function.rows
    address := function.low
    loop at < function.rows_end {
        address += link_debug_uleb(image.lines.table, at)
        _ := x64_jetline_sleb(image.lines.table, at)
        if address == pc -> return true
        if address > pc -> return false
    }
    false
}

// The frame `lookup` lies in: its Jet function, file and line, or, outside
// Jet code, the DWARF function's name (`?` without one) and line 0.
native_frame_at: fn(image: NativeImage, lookup: Int) -> NativeFrame Never! {
    index: x64_jetline_find(image.lines, lookup)
    if index >= 0 {
        function: image.lines.functions[index]
        return NativeFrame{function: function.name, file: native_files.basename(function.file), line: x64_jetline_line(image.lines, function, lookup) ?? 0, inlined: false}
    }
    named: native_function_at(image, lookup) ?? return NativeFrame{function: "?", file: "", line: 0, inlined: false}
    NativeFrame{function: named.name, file: "", line: 0, inlined: false}
}

// The address a frame's code is looked up at: the stop itself for the
// innermost frame (`index` 0), else the call before its return address `pc`.
native_lookup: fn(index: Int, pc: Int) -[]> Int { if index == 0 -> pc else -> pc - 1 }

// The frames `lookup` stands for, innermost first: one per inlined run that
// holds it, named by its abstract subprogram, then the function's own frame.
// The innermost shows the line at `lookup`; each frame below shows the line
// of the call the frame above it was inlined for.
native_frames_at: fn(image: NativeImage, lookup: Int) -[]> [NativeFrame] {
    frame: native_frame_at(image, lookup)
    function: native_function_at(image, lookup) ?? return [NativeFrame]{frame}
    shown := [NativeFrame]{}
    line := frame.line
    loop site in native_inline_chain(function, lookup) {
        run: function.inlined[site]
        name: if image.abstracts.get(run.origin) == .Val(origin) -> origin.name else -> "?"
        shown.push(NativeFrame{function: name, file: frame.file, line: line, inlined: true})
        line = run.call_line
    }
    shown.push(NativeFrame{function: frame.function, file: frame.file, line: line, inlined: false})
    shown
}

// The inlined runs of `function` that hold `lookup`, innermost first. Runs
// nest as their sites do and each follows the run it is nested in, so the
// last run holding `lookup` is the innermost.
native_inline_chain: fn(function: NativeFunction, lookup: Int) -[]> [Int] {
    innermost := -1
    loop (index, run) in function.inlined {
        if lookup >= run.low && lookup < run.high -> innermost = index
    }
    chain := [Int]{}
    loop innermost >= 0 {
        chain.push(innermost)
        innermost = function.inlined[innermost].parent
    }
    chain
}

// The frames a backtrace of the unwound `frames` shows, in its order.
native_levels: fn(image: NativeImage, frames: [NativeUnwound]) -[]> [NativeLevel] {
    levels := [NativeLevel]{}
    loop (index, frame) in frames {
        lookup: native_lookup(index, frame.pc)
        if native_function_at(image, lookup) == .Val(function) {
            loop site in native_inline_chain(function, lookup) {
                levels.push(NativeLevel{frame: index, site: site})
            }
        }
        levels.push(NativeLevel{frame: index, site: -1})
    }
    levels
}

// The name of signal `signal`.
native_debug_signal_name: fn(signal: Int) -> String Never! {
    if signal == {
        1 -> "SIGHUP"
        2 -> "SIGINT"
        3 -> "SIGQUIT"
        4 -> "SIGILL"
        5 -> "SIGTRAP"
        6 -> "SIGABRT"
        7 -> "SIGBUS"
        8 -> "SIGFPE"
        9 -> "SIGKILL"
        11 -> "SIGSEGV"
        13 -> "SIGPIPE"
        14 -> "SIGALRM"
        15 -> "SIGTERM"
        else -> "signal {signal}"
    }
}

native_debug_hex: fn(value: Int) -> String Never! {
    digits := [U8]{}
    rest := value
    loop {
        digit: rest & 15
        digits.insert(0, U8{if digit < 10 -> 48 + digit else -> 87 + digit})
        rest = rest >> 4
        if rest <= 0 -> break
    }
    "0x{String.from_bytes(digits) ?? ""}"
}

// The command that builds `entry` as the debuggable native image: this `jet`
// (`jet`), unoptimized, with its DWARF and the deep checks `deep_checks`
// selects, into `out_dir`.
native_debug_build_argv: fn(jet: String, entry: String, out_dir: String, deep_checks: DeepChecks) -> [String] Never! {
    argv := [String]{jet, "build", "-O0"}
    loop word in deep_checks_flags(deep_checks) -> argv.push(word)
    argv.push("--output-dir={out_dir}")
    argv.push(entry.copy())  // copy: the command owns its words.
    argv
}

// The image `native_debug_build_argv` writes: the entry's stem in `out_dir`.
native_debug_image: fn(entry: String, out_dir: String) -> String Never! {
    native_files.join(out_dir, native_files.basename(entry).before(".jet"))
}

// The `(Jet)` console over a session: `jet debug` and the Canvas native tier
// both speak it. Every stop prints the Jet source line with its `<- here`
// caret and the frame's locals; frames without Jet line information (the
// runtime) are never shown. Each readout starts with a capital.
NATIVE_DEBUG_HELP: "Commands: step (s), next (n), continue (c), finish (f), break LINE|FILE:LINE|FUNCTION [if EXPR] (b), log FILE:LINE \"TEXT {{EXPR}}\", watch PLACE, breaks, delete N, frame N, up, down, locals, print NAME (p NAME), backtrace (bt), tasks, fix, help (h), quit (q)"

// The console's prompt.
NATIVE_DEBUG_PROMPT: "(Jet) "

// The label of the line that lists the frame's locals; the Canvas native tier
// reads the locals back from it.
NATIVE_DEBUG_LOCALS_LABEL: "Locals:"

// The start of the line a breakpoint stop prints; the Canvas native tier reads
// the stop's line back from it.
NATIVE_DEBUG_BREAKPOINT_HIT: "Breakpoint hit"

// The value shown for a local the image's debug information cannot show.
NATIVE_DEBUG_UNAVAILABLE: "<Unavailable>"

// The deepest run of runtime frames a step finishes out of before it lets the
// program continue.
NATIVE_DEBUG_RUNTIME_DEPTH: 16

// The most list elements and String bytes a readout shows.
NATIVE_DEBUG_SHOWN_ITEMS: 16

NATIVE_DEBUG_SHOWN_BYTES: 256

// The method a DebugView implements, and the type of the items it returns.
NATIVE_DEBUG_VIEW: "debug_view"

NATIVE_DEBUG_VIEW_ITEM: "DebugItem"

// The bytes below the stack pointer a function may use without moving it
// (the System V red zone): an inferior call leaves them alone.
NATIVE_DEBUG_RED_ZONE: 128

// How deep a readout follows a value's members and elements.
NATIVE_DEBUG_SHOWN_DEPTH: 4

// What one console command printed, and where it left the program.
NativeDebugStep: struct {
    text: String,
    stop: NativeStop,
}

native_debug_stop_in_jet: fn(frame: NativeFrame?) -> Bool Never! {
    if frame == .Val(found) -> return native_debug_jet_frame(found)
    false
}

native_debug_jet_frame: fn(frame: NativeFrame) -> Bool Never! {
    frame.file.ends_with(".jet") && frame.line > 0
}

// The signal a thread that stopped with wait status `status` takes when it
// next runs: none for a stop the debugger made (a SIGSTOP, or the stop
// without a signal of a thread an attached program started).
native_trace_signal: fn(status: Int) -> Int Never! {
    signal: (status >> 8) & 0xff
    if signal == NATIVE_DEBUG_SIGSTOP || (status >> 16) == X64_TRACE_EVENT_STOP -> return 0
    signal
}

// The image the process `pid` runs, for `jet debug` to attach to it:
// refused (NATIVE_ATTACH_INVALID) unless `pid` is a running process that is
// `program`'s, when that is not "", and refused (NATIVE_ATTACH_FAILED) when
// it is another user's or another debugger's.
native_attach_program: fn(pid: Int, program: String) -> String NativeAttachRefused! {
    if pid <= 0 {
        return Err(NativeAttachRefused{code: NATIVE_ATTACH_INVALID, detail: "process id {pid} names no process"})
    }
    status: native_files.read("/proc/{pid}/status") ?? return Err(NativeAttachRefused{code: NATIVE_ATTACH_INVALID, detail: "no process {pid} is running"})
    if native_status_field(status, "State").starts_with("Z") {
        return Err(NativeAttachRefused{code: NATIVE_ATTACH_INVALID, detail: "process {pid} has exited"})
    }
    own: native_files.read("/proc/self/status") ?? ""
    if native_status_uid(status) != native_status_uid(own) {
        return Err(NativeAttachRefused{code: NATIVE_ATTACH_FAILED, detail: "process {pid} belongs to another user"})
    }
    tracer: native_status_field(status, "TracerPid")
    if tracer != "0" {
        return Err(NativeAttachRefused{code: NATIVE_ATTACH_FAILED, detail: "process {pid} is already traced by process {tracer}"})
    }
    binary: native_files.read_link("/proc/{pid}/exe") ?? return Err(NativeAttachRefused{code: NATIVE_ATTACH_FAILED, detail: "couldn't read which program process {pid} runs: {err}"})
    if program == "" -> return Ok(binary)
    wanted: native_files.canonicalize(program) ?? return Err(NativeAttachRefused{code: NATIVE_ATTACH_INVALID, detail: "the program `{program}` can't be found: {err}"})
    if wanted != binary {
        return Err(NativeAttachRefused{code: NATIVE_ATTACH_INVALID, detail: "process {pid} runs `{binary}`, not the program `{wanted}`"})
    }
    Ok(binary)
}

// Why the system did not let `jet debug` trace process `pid` (errno
// `code`).
native_attach_denied: fn(pid: Int, code: Int) -> String Never! {
    if code != NATIVE_DEBUG_EPERM -> return "tracing process {pid} failed (errno {code})"
    scope: (native_files.read("/proc/sys/kernel/yama/ptrace_scope") ?? "").trim()
    if scope == "1" {
        return "the system lets a process trace only the processes it started (kernel.yama.ptrace_scope is 1), and process {pid} has not allowed others with prctl(PR_SET_PTRACER)"
    }
    if scope != "" && scope != "0" {
        return "the system lets only an administrator trace a process (kernel.yama.ptrace_scope is {scope})"
    }
    "the system refused to let `jet debug` trace process {pid}"
}

// Field `name` of a /proc status file's `text`; "" when it has none.
native_status_field: fn(text: String, name: String) -> String Never! {
    loop line in text.split("\n") {
        if line.starts_with("{name}:") -> return "{line.after(":").trim()}"
    }
    ""
}

// The effective user id of a /proc status file's `text`.
native_status_uid: fn(text: String) -> String Never! {
    ids: native_status_field(text, "Uid").split("\t").to_list()
    if ids.len() > 1 -> "{ids[1]}" else -> ""
}

// NATIVE_DEBUG_LOCALS_LABEL and the frame's locals by name.
native_debug_locals_line: fn(locals: [NativeLocal]) -> String Never! {
    if locals.len() == 0 -> return "{NATIVE_DEBUG_LOCALS_LABEL}  (none)"
    sorted := locals.copy()
    sorted.sort_by(fn(left: NativeLocal, right: NativeLocal) { left.name <=> right.name })
    shown := [String]{}
    loop local in sorted -> shown.push("{local.name} = {local.value}")
    "{NATIVE_DEBUG_LOCALS_LABEL}  {shown.join("   ")}"
}

// The frame's locals, one a line with its Jet type (`total: Int = 6`).
native_debug_locals_typed: fn(locals: [NativeLocal]) -> String Never! {
    if locals.len() == 0 -> return "No locals here\n"
    text := ""
    loop local in locals -> text = "{text}{local.name}: {local.type_name} = {local.value}\n"
    text
}

// The Jet frames, innermost first; an inlined frame says so.
native_debug_backtrace: fn(frames: [NativeFrame]) -> String Never! {
    text := ""
    index := 0
    loop frame in frames {
        if !native_debug_jet_frame(frame) -> next
        inlined: if frame.inlined -> "  [inlined]" else -> ""
        text = "{text}#{index}  {frame.function}()  at {frame.file}:{frame.line}{inlined}\n"
        index += 1
    }
    text
}

// A task the runtime's registry lists (JetRuntime Observe.jet): its id, its
// label, its state (NATIVE_DEBUG_TASK_RUNNING and the rest; -1 for the main
// thread's task when the registry has none), what it waits on, whether it
// is canceled, and the fiber it runs on (0: none).
NativeTask: struct {
    id: Int,
    label: String,
    state: Int,
    wait: String,
    canceled: Bool,
    fiber: Int,
}

// A thread of the stopped program as `tasks` matches it to a task: its id,
// its registers, the fiber it runs (0: none) and the task its current
// control names (1 for the main thread's control, which names none).
NativeTaskThread: struct {
    id: Int,
    registers: [Int],
    fiber: Int,
    task: Int,
}

// The tasks the runtime's registry lists, newest first, from the address of
// its root's storage (`root`; 0: the program has none). At most
// NATIVE_DEBUG_MOST_TASKS, so a list a stopped thread was changing ends.
native_tasks: fn(memory: NativeMemory, root: Int) -> [NativeTask] Never! {
    tasks := [NativeTask]{}
    if root == 0 -> return tasks
    registry: native_debug_read(memory, root, 8, 1) ?? return tasks
    if registry[0] == 0 -> return tasks
    head: native_debug_read(memory, registry[0] + NATIVE_DEBUG_REGISTRY_TASKS, 8, 1) ?? return tasks
    node := head[0]
    loop node != 0 && tasks.len() < NATIVE_DEBUG_MOST_TASKS {
        words: native_debug_read(memory, node, 8, NATIVE_DEBUG_TASK_WORDS) ?? break
        label: if words[4] == 0 -> "" else -> native_debug_text(words[4], memory, false) ?? ""
        wait: if words[6] == 0 -> "" else -> native_debug_text(words[6], memory, false) ?? ""
        tasks.push(NativeTask{id: words[1], label: label, state: words[5], wait: wait, canceled: words[9] != 0, fiber: words[14]})
        node = words[0]
    }
    tasks
}

// The row in `threads` of the thread task `task` is on: the one running
// its fiber, or for a task on no fiber the one whose current control names
// it; -1 for none (a parked or queued task).
native_task_thread: fn(threads: [NativeTaskThread], task: NativeTask) -> Int Never! {
    loop (row, thread) in threads {
        if task.fiber != 0 && thread.fiber == task.fiber -> return row
        if task.fiber == 0 && thread.fiber == 0 && thread.task == task.id -> return row
    }
    -1
}

// The registers a parked fiber resumes with, from the stack its switch
// saved at `saved` (JetBackend X64/InlineAsm.jet X64_FIBER_SWITCH): the
// resume address, then r15, r14, r13, r12, rbx and rbp. The pc is past the
// switch's pops and the stack above them; `template` gives the rest.
native_task_registers: fn(template: [Int], memory: NativeMemory, saved: Int) -> [Int]? Never! {
    words: native_debug_read(memory, saved, 8, NATIVE_DEBUG_FIBER_SAVES.len() + 1) ?? return None
    registers := loop value in template -> value
    loop (k, register) in NATIVE_DEBUG_FIBER_SAVES -> registers[register] = words[k + 1]
    registers[X64_TRACE_RIP] = words[0] + NATIVE_DEBUG_FIBER_POPS
    registers[X64_TRACE_RSP] = saved + 8 * words.len()
    Val(registers)
}

// A task's state as the registry keeps it (JetFoundation LiveSnapshot.jet).
native_task_state: fn(state: Int) -> String Never! {
    if state == {
        0 -> "queued"
        1 -> "running"
        2 -> "blocked"
        3 -> "paused"
        else -> "state {state}"
    }
}

NATIVE_DEBUG_TASK_RUNNING: 1

// The registry's task list head (JetRuntime Observe.jet Root168 tasks24),
// the words of a task node (Task120) and the most tasks `tasks` reads (the
// registry's own cap, OBSERVE_TASK_CAP).
NATIVE_DEBUG_REGISTRY_TASKS: 24

NATIVE_DEBUG_TASK_WORDS: 15

NATIVE_DEBUG_MOST_TASKS: 4096

// A thread's TCB (JetRuntime Thread.jet): its current control at 16, its
// fiber at 56; a control's task id (Scheduler.jet Control160 observe56).
NATIVE_DEBUG_TCB_CONTROL: 16

NATIVE_DEBUG_TCB_FIBER: 56

NATIVE_DEBUG_CONTROL_TASK: 56

// A fiber's saved stack pointer (JetRuntime Fiber.jet savedStack8); the
// registers its switch pushes above the resume address, nearest first, as
// indices among the trace's registers (r15, r14, r13, r12, rbx, rbp); and
// the bytes of the switch's pops.
NATIVE_DEBUG_FIBER_SAVED: 8

NATIVE_DEBUG_FIBER_SAVES: [Int]{0, 1, 2, 3, 5, 4}

NATIVE_DEBUG_FIBER_POPS: 10

// The breakpoint a `breakpoint N.M` stop reason names.
native_debug_hit_breakpoint: fn(stop: NativeStop) -> Int? Never! {
    if !stop.reason.starts_with("breakpoint ") -> return None
    number: Int.parse(stop.reason.after("breakpoint ").before(".")) ?? return None
    Val(number)
}

// What setting a breakpoint with `condition` says about where the condition
// runs ("" for none): the debugger checks it at each hit, so a hit whose
// condition is false still stops the program for that check.
native_debug_condition_place: fn(condition: String) -> String Never! {
    if condition.trim() == "" -> return ""
    "The condition can't run in the program: the debugger checks it at each hit, which stops the program each time\n"
}

// Bytes a readout may read: the stopped program's memory, when there is a
// program, and `blocks` (each its bytes from its address) before it.
// `backing` holds the bytes of the blocks that name a span of it (a dump's
// sections), so they share one buffer.
NativeMemory: struct {
    trace: X64Trace?,
    blocks: [NativeBlock],
    backing: [U8]{[U8]{}},
}

// Known bytes from `address`: `bytes`, or with `from` 0 or more the `size`
// bytes of the memory's backing from `from`.
NativeBlock: struct {
    address: Int,
    bytes: [U8],
    from: Int{-1},
    size: Int{0},
}

// The parameters and locals live at `lookup` in `frame` that belong to the
// inlined run `site` (-1: the function's own frame), rendered as Jet values;
// a variable the image gives no location shows as unavailable.
native_frame_locals: fn(image: NativeImage, memory: NativeMemory, frame: NativeUnwound, lookup: Int, site: Int) -> [NativeLocal] Never! {
    locals := [NativeLocal]{}
    function: native_function_at(image, lookup) ?? return locals
    loop variable in function.variables {
        if variable.site != site -> next
        type_name: native_type_name(image, variable.ty)
        if variable.list < 0 {
            locals.push(NativeLocal{name: variable.name, type_name: type_name, value: NATIVE_DEBUG_UNAVAILABLE})
            next
        }
        located: native_variable_covering(image, variable, lookup) ?? next
        value: native_variable_value(image, memory, frame, located, variable.ty) ?? NATIVE_DEBUG_UNAVAILABLE
        locals.push(NativeLocal{name: variable.name, type_name: type_name, value: value})
    }
    locals
}

// The first range of `variable`'s location list that covers `lookup`.
native_variable_covering: fn(image: NativeImage, variable: NativeVariable, lookup: Int) -> NativeRange? Never! {
    loop range in native_ranges(image, variable.list, variable.base) {
        if lookup >= range.start && lookup < range.end -> return Val(range)
    }
    None
}

// The value of type `ty` the location expression of `range` names in
// `frame`; None when it is out of reach.
native_variable_value: fn(image: NativeImage, memory: NativeMemory, frame: NativeUnwound, range: NativeRange, ty: Int) -> String? Never! {
    size: native_type_size(image, ty)
    if size <= 0 -> return None
    bytes: native_place_bytes(memory, frame, image.loclists, range.from, range.to, size) ?? return None
    native_render(image, memory, ty, bytes, 0, 0)
}

// The `size` bytes the DWARF expression `bytes[from..<to]` locates in
// `frame`: a register's (DW_OP_reg*, DW_OP_regx), those at the address
// native_place_base and native_place_through find, or that address itself
// (DW_OP_stack_value).
native_place_bytes: fn(memory: NativeMemory, frame: NativeUnwound, bytes: [U8], from: Int, to: Int, size: Int) -> [U8]? Never! {
    if from >= to || to > bytes.len() -> return None
    register: native_location_register(bytes, from, to)
    if register >= 0 -> return native_register_bytes(frame, register)
    base: native_place_base(frame, bytes, from) ?? return None
    if base.next < to {
        then: Int{bytes[base.next]}
        if then == 0x9f -> return Val(native_word_bytes(base.address))
    }
    address: native_place_through(memory, bytes, base, to) ?? return None
    native_debug_bytes(memory, address, size)
}

// The memory address the DWARF expression `bytes[from..<to]` locates in
// `frame`; None for a value held in a register or computed, or out of reach.
native_place_address: fn(memory: NativeMemory, frame: NativeUnwound, bytes: [U8], from: Int, to: Int) -> Int? Never! {
    if from >= to || to > bytes.len() -> return None
    base: native_place_base(frame, bytes, from) ?? return None
    native_place_through(memory, bytes, base, to)
}

// An address a location expression computes, and where its next operation
// starts.
NativePlaceBase: struct {
    address: Int,
    next: Int,
}

// The address the operation at `bytes[from]` computes in `frame`: a
// register's or the frame base's (rbp) plus an offset (DW_OP_breg*,
// DW_OP_bregx, DW_OP_fbreg). None for any other operation.
native_place_base: fn(frame: NativeUnwound, bytes: [U8], from: Int) -> NativePlaceBase? Never! {
    op: Int{bytes[from]}
    at := from + 1
    address := 0
    if {
        op >= 0x70 && op <= 0x8f -> {
            base: native_register_value(frame, op - 0x70) ?? return None
            address = base + x64_jetline_sleb(bytes, at)
        }
        op == 0x92 -> {
            register: link_debug_uleb(bytes, at)
            base: native_register_value(frame, register) ?? return None
            address = base + x64_jetline_sleb(bytes, at)
        }
        op == 0x91 -> {
            if !frame.known[X64_TRACE_RBP] -> return None
            address = frame.registers[X64_TRACE_RBP] + x64_jetline_sleb(bytes, at)
        }
        else -> return None
    }
    Val(NativePlaceBase{address: address, next: at})
}

// The address `base` computes, or the one stored there when DW_OP_deref
// follows it; None when another operation follows.
native_place_through: fn(memory: NativeMemory, bytes: [U8], base: NativePlaceBase, to: Int) -> Int? Never! {
    if base.next >= to -> return Val(base.address)
    then: Int{bytes[base.next]}
    if then != 0x06 -> return None
    words: native_debug_bytes(memory, base.address, 8) ?? return None
    Val(native_number(words, 0, 8, X64DebugEncoding.Signed))
}

// Where a watched place's bytes are: their address and type, or, for a
// local held in a register, that register's index among the trace's
// registers (else -1) and the code ranges where the local is in it; or why
// the place can't be watched (`refusal`, empty when it can).
NativeWatchPlace: struct {
    address: Int,
    ty: Int,
    register: Int,
    ranges: [NativeRange],
    refusal: String,
}

// Where the place `path` (`total`, `order.total`) lives in `frame` at
// `lookup`, among the variables of the inlined run `site`. A field path goes
// through typedefs and pointers to the struct whose field it names.
native_watch_place: fn(image: NativeImage, memory: NativeMemory, frame: NativeUnwound, lookup: Int, site: Int, path: String) -> NativeWatchPlace Never! {
    names: path.split(".").to_list()
    function: native_function_at(image, lookup) ?? return native_watch_refusal("No Jet function is running here")
    found: loop (index, variable) in function.variables {
        if variable.site == site && variable.name == names[0] {
            break index
        }
    } ?? return native_watch_refusal("`{names[0]}` is not a local of this frame; a watch takes a local or a field path under one")
    variable: function.variables[found]
    unplaced: "`{names[0]}` has no value here"
    if variable.list < 0 -> return native_watch_refusal(unplaced)
    located: native_variable_covering(image, variable, lookup) ?? return native_watch_refusal(unplaced)
    dwarf: native_location_register(image.loclists, located.from, located.to)
    // A register's value, standing for the pointer bytes at `address`.
    held := Int?{None}
    address := 0
    if {
        dwarf >= NATIVE_DEBUG_DWARF_REGISTERS.len() -> return native_watch_refusal("`{names[0]}` is held in a vector register, which a watch can't follow")
        dwarf >= 0 -> {
            value: native_register_value(frame, dwarf) ?? return native_watch_refusal("`{names[0]}`'s register is not known in this frame")
            if names.len() == 1 {
                ranges := [NativeRange]{}
                loop range in native_ranges(image, variable.list, variable.base) {
                    if native_location_register(image.loclists, range.from, range.to) == dwarf {
                        ranges.push(NativeRange{start: range.start, end: range.end, from: range.from, to: range.to})
                    }
                }
                return NativeWatchPlace{address: 0, ty: variable.ty, register: NATIVE_DEBUG_DWARF_REGISTERS[dwarf], ranges: ranges, refusal: ""}
            }
            held = Val(value)
        }
        else -> address = native_place_address(memory, frame, image.loclists, located.from, located.to) ?? return native_watch_refusal("`{names[0]}` is computed here, with no place to watch")
    }
    ty := variable.ty
    // The path up to the field the loop turn looks up.
    owner := "{names[0]}"
    loop k in 1..<names.len() {
        loop {
            through: image.types.get(ty) ?? break
            if through.tag == NATIVE_TAG_TYPEDEF {
                ty = through.target
                next
            }
            if through.tag != NATIVE_TAG_POINTER -> break
            if held == .Val(value) -> address = value else {
                words: native_debug_bytes(memory, address, 8) ?? return native_watch_refusal("`{owner}` can't be read here")
                address = native_number(words, 0, 8, X64DebugEncoding.Signed)
            }
            held = None
            ty = through.target
        }
        group := -1
        if image.types.get(ty) == .Val(kind) {
            if kind.tag == NATIVE_TAG_STRUCT && kind.variants < 0 && !kind.name.starts_with("[") {
                group = kind.group
            }
        }
        if group < 0 || held != None {
            return native_watch_refusal("`{owner}` has no fields to watch")
        }
        field: loop (index, member) in image.members[group] {
            if member.name == names[k] {
                break index
            }
        } ?? return native_watch_refusal("`{owner}` has no field `{names[k]}`")
        address += image.members[group][field].offset
        ty = image.members[group][field].ty
        owner = "{owner}.{names[k]}"
    }
    NativeWatchPlace{address: address, ty: ty, register: -1, ranges: [NativeRange]{}, refusal: ""}
}

// A place that can't be watched, and why.
native_watch_refusal: fn(refusal: String) -> NativeWatchPlace Never! {
    NativeWatchPlace{address: 0, ty: -1, register: -1, ranges: [NativeRange]{}, refusal: refusal}
}

// The DWARF register the location expression `bytes[from..<to]` names
// (DW_OP_reg*, DW_OP_regx), else -1.
native_location_register: fn(bytes: [U8], from: Int, to: Int) -> Int Never! {
    if from >= to || to > bytes.len() -> return -1
    op: Int{bytes[from]}
    if op >= 0x50 && op <= 0x6f -> return op - 0x50
    if op != 0x90 -> return -1
    at := from + 1
    link_debug_uleb(bytes, at)
}

// The debug-register spans that cover the `size` bytes at `address`: each
// 8, 4, 2 or 1 bytes aligned to its size, as x86-64 debug registers trap.
// Their slots are set when the watch takes registers.
native_watch_spans: fn(address: Int, size: Int) -> [NativeWatchSpan] Never! {
    spans := [NativeWatchSpan]{}
    at := address
    end: address + size
    loop at < end {
        width := 8
        loop width > 1 && (at %% width != 0 || at + width > end) -> width = width /% 2
        spans.push(NativeWatchSpan{slot: -1, address: at, size: width})
        at += width
    }
    spans
}

// The debug control register (DR7) value that arms every span of
// `watches`: for slot i, its local enable bit (2i), a trap on writes (RW
// 01 at bit 16 + 4i) and its length (LEN at bit 18 + 4i: 1 byte 00, 2
// bytes 01, 8 bytes 10, 4 bytes 11).
native_watch_control: fn(watches: [NativeWatch]) -> Int Never! {
    control := 0
    loop watch in watches {
        loop span in watch.spans {
            length: if span.size == {
                1 -> 0
                2 -> 1
                8 -> 2
                else -> 3
            }
            control = control | (1 << (2 * span.slot)) | (1 << (16 + 4 * span.slot)) | (length << (18 + 4 * span.slot))
        }
    }
    control
}

#Test("a watch takes aligned debug-register spans and arms them for writes") {
    spans := native_watch_spans(0x1006, 12)
    assert_eq(spans.len(), 3)
    assert_eq(spans[0].address, 0x1006)
    assert_eq(spans[0].size, 2)
    assert_eq(spans[1].address, 0x1008)
    assert_eq(spans[1].size, 8)
    assert_eq(spans[2].address, 0x1010)
    assert_eq(spans[2].size, 2)
    assert_eq(native_watch_spans(0x2000, 8).len(), 1)
    loop k in 0..<spans.len() -> spans[k].slot = k
    watches: [NativeWatch]{NativeWatch{number: 2, shown: "total", address: 0x1006, ty: -1, spans: spans, thread: 1, cfa: 0, bytes: [U8]{}, register: -1, ranges: [NativeRange]{}}}
    // Slot 0: 2 bytes; slot 1: 8 bytes; slot 2: 2 bytes; each on writes.
    assert_eq(native_watch_control(watches), 0x15 | (1 << 16) | (1 << 18) | (1 << 20) | (2 << 22) | (1 << 24) | (1 << 26))
}

// The 8 bytes of DWARF register `register` in `frame`, when known.
native_register_bytes: fn(frame: NativeUnwound, register: Int) -> [U8]? Never! {
    word: native_register_value(frame, register) ?? return None
    Val(native_word_bytes(word))
}

native_register_value: fn(frame: NativeUnwound, register: Int) -> Int? Never! {
    if register < 0 || register >= NATIVE_DEBUG_DWARF_REGISTERS.len() -> return None
    index: NATIVE_DEBUG_DWARF_REGISTERS[register]
    if !frame.known[index] -> return None
    Val(frame.registers[index])
}

// The 8 little-endian bytes of `word`.
native_word_bytes: fn(word: Int) -> [U8] Never! { native_low_bytes(word, 8) }

// The low `count` little-endian bytes of `word`.
native_low_bytes: fn(word: Int, count: Int) -> [U8] Never! {
    loop k in 0..<count -> U8{(word >> (8 * k)) & 255}
}

// The number of `size` little-endian bytes of `bytes` from `at`, signed as
// `encoding` says.
native_number: fn(bytes: [U8], at: Int, size: Int, encoding: X64DebugEncoding) -> Int Never! {
    value := 0
    loop k in 0..<size {
        index: at + size - 1 - k
        if index < bytes.len() -> value = value * 256 + Int{bytes[index]}
    }
    if encoding == X64DebugEncoding.Signed && size > 0 && size <= 8 {
        top: 1 << (8 * size)
        if value >= top >> 1 -> value -= top
    }
    value
}

// `count` bytes from `address`; None when any is unreadable.
native_debug_bytes: fn(memory: NativeMemory, address: Int, count: Int) -> [U8]? Never! {
    if address <= 0 || count < 0 -> return None
    held: loop index in 0..<memory.blocks.len() {
        block: memory.blocks[index]
        length: if block.from >= 0 -> block.size else -> block.bytes.len()
        if address >= block.address && address + count <= block.address + length {
            break index
        }
    } ?? -1
    if held >= 0 {
        block: memory.blocks[held]
        from: address - block.address
        if block.from >= 0 {
            return Val(memory.backing[block.from + from..<block.from + from + count])
        }
        return Val(block.bytes[from..<from + count])
    }
    trace: memory.trace ?? return None
    if trace.pid <= 0 -> return None
    bytes: x64_trace_read(trace, address, count) ?? return None
    if bytes.len() != count -> return None
    Val(bytes)
}

// `count` units of `size` bytes from `address` (8: signed, else unsigned).
native_debug_read: fn(memory: NativeMemory, address: Int, size: Int, count: Int) -> [Int]? Never! {
    bytes: native_debug_bytes(memory, address, size * count) ?? return None
    encoding: if size == 8 -> X64DebugEncoding.Signed else -> X64DebugEncoding.Unsigned
    Val(loop k in 0..<count -> native_number(bytes, k * size, size, encoding))
}

// The Jet name of type `ty`: its name without module paths, `Pointer` for
// an unnamed pointer.
native_type_name: fn(image: NativeImage, ty: Int) -> String Never! {
    found: image.types.get(ty) ?? return "?"
    if found.name == "" -> return "Pointer"
    native_jet_spelling(found.name)
}

// `name` without the module path before each `.` in it: `[main.Point]`
// is `[Point]`, `<corelib>/core.math.Decimal` is `Decimal`, and a source
// type's key `module:<len>:<package>:<path>.Point` is `Point`
// (diagnostic_display_identities, as a diagnostic prints it).
native_jet_spelling: fn(name: String) -> String Never! {
    shown: diagnostic_display_identities(name, [String]{})
    corelib: "<corelib>".bytes()
    kept := [U8]{}
    // Where in `kept` the run of path bytes before the next `.` starts.
    run := 0
    loop byte in shown.bytes() {
        if byte == (U8{46}) {
            loop kept.len() > run -> _: kept.pop()
            if native_bytes_end_with(kept, corelib) {
                loop _ in 0..<corelib.len() -> _: kept.pop()
            }
            run = kept.len()
            next
        }
        kept.push(byte)
        if !native_path_byte(byte) -> run = kept.len()
    }
    String.from_bytes(kept) ?? shown
}

#Test("a native type name drops the module path before each `.`") {
    assert_eq(native_jet_spelling("[main.Point]"), "[Point]")
    assert_eq(native_jet_spelling("<corelib>/core.math.Decimal"), "Decimal")
    assert_eq(native_jet_spelling("module:3:app:src/prog.jet.Ring"), "Ring")
    assert_eq(native_jet_spelling("[String:main.Point]"), "[String:Point]")
}

// Whether `bytes` ends with `suffix`.
native_bytes_end_with: fn(bytes: [U8], suffix: [U8]) -> Bool Never! {
    if bytes.len() < suffix.len() -> return false
    from: bytes.len() - suffix.len()
    loop k in 0..<suffix.len() {
        if bytes[from + k] != suffix[k] -> return false
    }
    true
}

// Whether `byte` may be part of a module path segment: a letter, digit, `_`
// or `/` (a `.` ends the segment, native_jet_spelling).
native_path_byte: fn(byte: U8) -> Bool Never! {
    code: Int{byte}
    (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95 || code == 47
}

// The byte size of type `ty`, through typedefs.
native_type_size: fn(image: NativeImage, ty: Int) -> Int Never! {
    found: image.types.get(ty) ?? return 0
    if found.size > 0 -> return found.size
    if found.tag == NATIVE_TAG_TYPEDEF -> return native_type_size(image, found.target)
    found.size
}

// The value of type `ty` whose bytes start at `at` in `bytes`, as Jet shows
// it; None when the image's types or the memory it points to can't show it.
native_render: fn(image: NativeImage, memory: NativeMemory, ty: Int, bytes: [U8], at: Int, depth: Int) -> String? Never! {
    found: image.types.get(ty) ?? return None
    if depth > NATIVE_DEBUG_SHOWN_DEPTH -> return Val("…")
    word: native_number(bytes, at, if bytes.len() - at < 8 -> bytes.len() - at else -> 8, X64DebugEncoding.Signed)
    if {
        // A typedef names a language type (foundation_named_type, the one
        // source of the scalar spellings) or a precise number's handle.
        found.tag == NATIVE_TAG_TYPEDEF -> if foundation_named_type(found.name) == {
            .Int -> {
                value: native_debug_int(word, memory) ?? return None
                Val("{value}")
            }
            .String -> native_debug_string(word, memory)
            .Named(_) -> if found.name == "Decimal" || found.name == "Fraction" -> native_debug_precise(found.name, word, memory) else -> native_render(image, memory, found.target, bytes, at, depth)
            .Float | .Bool | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> native_render(image, memory, found.target, bytes, at, depth)
        }
        found.tag == NATIVE_TAG_BASE -> if found.encoding == {
            .Bool -> Val(if word & 255 != 0 -> "true" else -> "false")
            .Signed | .Unsigned -> Val("{native_number(bytes, at, found.size, found.encoding)}")
            .Float -> {
                if found.size == 4 {
                    return Val("{native_math.f32_from_bits(U32{native_number(bytes, at, 4, X64DebugEncoding.Unsigned)})}")
                }
                Val("{native_math.from_bits(word)}")
            }
            .Char -> native_debug_char(native_number(bytes, at, 4, X64DebugEncoding.Unsigned))
        }
        found.tag == NATIVE_TAG_POINTER -> {
            // A typed pointer shows what it points to; an untyped or null
            // one its address.
            size: native_type_size(image, found.target)
            if found.target < 0 || word == 0 || size <= 0 -> return Val(native_debug_hex(word))
            pointed: native_debug_bytes(memory, word, size) ?? return Val(native_debug_hex(word))
            native_render(image, memory, found.target, pointed, 0, depth + 1)
        }
        found.tag == NATIVE_TAG_STRUCT && found.variants >= 0 -> native_debug_variant(image, memory, image.variants[found.variants], bytes, at, depth)
        found.tag == NATIVE_TAG_STRUCT && found.group >= 0 -> {
            group: found.group
            if found.name.starts_with("[") && found.name.ends_with("]") {
                return native_debug_list(image, memory, image.members[group], bytes, at, depth)
            }
            fields: native_debug_fields(image, memory, image.members[group], bytes, at, depth) ?? return None
            // A record or tuple type is spelled by its fields, `{n: Int}` or
            // `(n: Int)` as its carrier identity, so its value is too.
            if found.name.starts_with("{{") || found.name.starts_with("(") {
                return Val("{{{fields.join(", ")}}}")
            }
            Val("{native_type_name(image, ty)}{{{fields.join(", ")}}}")
        }
        found.tag == NATIVE_TAG_ENUM -> {
            value: native_number(bytes, at, found.size, X64DebugEncoding.Signed)
            loop enumerator in image.enumerators[found.group] {
                if enumerator.value == value {
                    return Val("{native_type_name(image, ty)}.{enumerator.name}")
                }
            }
            None
        }
        // A union or an opaque struct has no Jet value to show.
        else -> None
    }
}

// Each of `members` of the value at `at` in `bytes`, as `name: value`, or
// the value alone for an unnamed member.
native_debug_fields: fn(image: NativeImage, memory: NativeMemory, members: [NativeMember], bytes: [U8], at: Int, depth: Int) -> [String]? Never! {
    fields := [String]{}
    loop member in members {
        size: native_type_size(image, member.ty)
        if at + member.offset + size > bytes.len() -> return None
        shown: native_render(image, memory, member.ty, bytes, at + member.offset, depth + 1) ?? NATIVE_DEBUG_UNAVAILABLE
        fields.push(if member.name == "" -> shown else -> "{member.name}: {shown}")
    }
    Val(fields)
}

// The value at `at` in `bytes` of a type with a variant part, as Jet
// spells the variant its discriminant selects: the payload alone for an
// unnamed variant (a present Option's value, a union's member), the
// variant's name for one without a payload, `Name(a, b)` for positional
// payloads and `Name{f: a}` for named ones.
native_debug_variant: fn(image: NativeImage, memory: NativeMemory, part: NativeVariants, bytes: [U8], at: Int, depth: Int) -> String? Never! {
    selector: part.discriminant
    width: native_type_size(image, selector.ty)
    if width <= 0 || at + selector.offset + width > bytes.len() -> return None
    selected: native_number(bytes, at + selector.offset, width, X64DebugEncoding.Signed)
    chosen: loop variant in part.arms {
        if variant.value == .Val(value) && value == selected {
            break variant.member
        }
    } ?? loop variant in part.arms {
        if variant.value == None {
            break variant.member
        }
    } ?? return None
    if chosen.ty < 0 -> return None
    if chosen.name == "" {
        if at + chosen.offset + native_type_size(image, chosen.ty) > bytes.len() -> return None
        return native_render(image, memory, chosen.ty, bytes, at + chosen.offset, depth)
    }
    payload: image.types.get(chosen.ty) ?? return None
    shown: native_variant_spelling(chosen.name)
    if payload.group < 0 || image.members[payload.group].len() == 0 -> return Val(shown)
    fields: native_debug_fields(image, memory, image.members[payload.group], bytes, at + chosen.offset, depth + 1) ?? return None
    positional: loop member in image.members[payload.group] {
        if member.name != "" {
            break false
        }
    } ?? true
    if positional -> return Val("{shown}({fields.join(", ")})")
    Val("{shown}{{{fields.join(", ")}}}")
}

// Variant `name` as Jet spells it: its type's name without module paths
// (native_jet_spelling), `.` and the variant's own name (`Shape.Rect`); a
// name with no type, such as `Ok` or `None`, alone.
native_variant_spelling: fn(name: String) -> String Never! {
    cut: name.rpartition(".")
    if cut.sep == "" -> return native_jet_spelling(name)
    "{native_jet_spelling(cut.head)}.{cut.tail}"
}

#Test("a variant keeps its type's name and drops the module path") {
    assert_eq(native_variant_spelling("Shape.Rect"), "Shape.Rect")
    assert_eq(native_variant_spelling("module:3:app:src/prog.jet.Shape.Rect"), "Shape.Rect")
    assert_eq(native_variant_spelling("Ok"), "Ok")
}

// A List whose inline header [len, cap, data] starts at `at` in `bytes`: its
// first NATIVE_DEBUG_SHOWN_ITEMS elements, each as its element type shows it.
native_debug_list: fn(image: NativeImage, memory: NativeMemory, members: [NativeMember], bytes: [U8], at: Int, depth: Int) -> String? Never! {
    length := -1
    data := 0
    element := -1
    loop member in members {
        if at + member.offset + 8 > bytes.len() -> return None
        if member.name == "len" {
            length = native_number(bytes, at + member.offset, 8, X64DebugEncoding.Signed)
        }
        if member.name == "data" {
            data = native_number(bytes, at + member.offset, 8, X64DebugEncoding.Signed)
            found: image.types.get(member.ty) ?? return None
            if found.tag == NATIVE_TAG_POINTER -> element = found.target
        }
    }
    if length < 0 -> return None
    if length == 0 -> return Val("[]")
    size: native_type_size(image, element)
    if data == 0 || size <= 0 -> return None
    shown: if length > NATIVE_DEBUG_SHOWN_ITEMS -> NATIVE_DEBUG_SHOWN_ITEMS else -> length
    stored: native_debug_bytes(memory, data, size * shown) ?? return None
    items := [String]{}
    loop k in 0..<shown {
        items.push(native_render(image, memory, element, stored, k * size, depth + 1) ?? NATIVE_DEBUG_UNAVAILABLE)
    }
    if length > shown -> items.push("… {length - shown} more")
    Val("[{items.join(", ")}]")
}

// The Char with code point `code`, quoted.
native_debug_char: fn(code: Int) -> String? Never! {
    if code < 0 || code > 0x10ffff -> return None
    bytes: if {
        code < 0x80 -> [U8]{U8{code}}
        code < 0x800 -> [U8]{U8{0xc0 + (code >> 6)}, U8{0x80 + (code & 63)}}
        code < 0x10000 -> [U8]{U8{0xe0 + (code >> 12)}, U8{0x80 + ((code >> 6) & 63)}, U8{0x80 + (code & 63)}}
        else -> [U8]{U8{0xf0 + (code >> 18)}, U8{0x80 + ((code >> 12) & 63)}, U8{0x80 + ((code >> 6) & 63)}, U8{0x80 + (code & 63)}}
    }
    text: String.from_bytes(bytes) ?? return None
    Val("'{text}'")
}

// The exact Int whose word is `word`: the word itself when inline (its bits
// 63 and 62 agree), else the carrier at `word` without bit 62: sign at 16,
// limbs at 24 and their count at 32, u32 limbs base 1e9 least significant
// first (JetRuntime Int.jet).
native_debug_int: fn(word: Int, memory: NativeMemory) -> Int? Never! {
    bit62: 4611686018427387904
    if word >= -bit62 && word < bit62 -> return Val(word)
    if word < 0 -> return None
    carrier: native_debug_read(memory, word - bit62, 8, 5) ?? return None
    count: carrier[4]
    if count < 1 || count > 1000000 -> return None
    limbs: native_debug_read(memory, carrier[3], 4, count) ?? return None
    value := 0
    at := count - 1
    loop at >= 0 {
        value = value * 1000000000 + limbs[at]
        at -= 1
    }
    Val(if carrier[2] != 0 -> -value else -> value)
}

// The String whose header [data, byte length, cap] is at `address`, quoted,
// its first NATIVE_DEBUG_SHOWN_BYTES bytes shown.
native_debug_string: fn(address: Int, memory: NativeMemory) -> String? Never! {
    native_debug_text(address, memory, true)
}

// The String whose header is at `address`, as a Jet string literal when
// `quoted`, else as its own text: its first NATIVE_DEBUG_SHOWN_BYTES bytes,
// then its length when it has more.
native_debug_text: fn(address: Int, memory: NativeMemory, quoted: Bool) -> String? Never! {
    header: native_debug_read(memory, address, 8, 2) ?? return None
    length: header[1]
    if length < 0 -> return None
    shown: if length > NATIVE_DEBUG_SHOWN_BYTES -> NATIVE_DEBUG_SHOWN_BYTES else -> length
    bytes: if shown == 0 -> [U8]{} else -> native_debug_bytes(memory, header[0], shown) ?? return None
    lossy: String.from_bytes_lossy(bytes)
    text: if quoted -> native_debug_text_literal(lossy) else -> lossy
    if length > shown -> return Val("{text}… ({length} bytes)")
    Val(text)
}

// The code address of the `debug_view` the image keeps for the struct type
// `ty`: the subprogram of that name whose one parameter, `self`, is of that
// type. A struct goes to a call as its address, so the debugger can call
// the view on a copy of a value (NativeSession.view).
native_debug_view_at: fn(image: NativeImage, ty: Int) -> Int? Never! {
    found: image.types.get(ty) ?? return None
    if found.tag != NATIVE_TAG_STRUCT || found.name.starts_with("[") -> return None
    loop function in image.functions {
        if function.name != NATIVE_DEBUG_VIEW -> next
        parameters := 0
        matched := false
        loop variable in function.variables {
            if variable.role != NativeVariableRole.Parameter || variable.site >= 0 -> next
            parameters += 1
            typed: image.types.get(variable.ty) ?? next
            if variable.name == "self" && typed.name == found.name -> matched = true
        }
        if parameters == 1 && matched -> return Val(function.low)
    }
    None
}

// A value of type `ty` as its view shows it, from the [DebugItem] list
// header its `debug_view` wrote at `address`: `Name{label: value, …}`, the
// first NATIVE_DEBUG_SHOWN_ITEMS items, each label and value as its text.
native_debug_view_shown: fn(image: NativeImage, memory: NativeMemory, ty: Int, address: Int) -> String? Never! {
    list: native_debug_view_list(image) ?? return None
    header: native_debug_bytes(memory, address, native_type_size(image, list)) ?? return None
    length := -1
    data := 0
    item := -1
    loop member in image.members[(image.types.get(list) ?? return None).group] {
        if member.name == "len" {
            length = native_number(header, member.offset, 8, X64DebugEncoding.Signed)
        }
        if member.name == "data" {
            data = native_number(header, member.offset, 8, X64DebugEncoding.Signed)
            item = (image.types.get(member.ty) ?? return None).target
        }
    }
    found: image.types.get(item) ?? return None
    size: native_type_size(image, item)
    if length < 0 || size <= 0 || found.group < 0 -> return None
    shown: if length > NATIVE_DEBUG_SHOWN_ITEMS -> NATIVE_DEBUG_SHOWN_ITEMS else -> length
    stored: if shown == 0 -> [U8]{} else -> native_debug_bytes(memory, data, size * shown) ?? return None
    items := [String]{}
    loop k in 0..<shown {
        label := NATIVE_DEBUG_UNAVAILABLE.copy()
        value := NATIVE_DEBUG_UNAVAILABLE.copy()
        loop member in image.members[found.group] {
            text: native_debug_text(native_number(stored, k * size + member.offset, 8, X64DebugEncoding.Signed), memory, false) ?? NATIVE_DEBUG_UNAVAILABLE
            if member.name == "label" -> label = text.copy()
            if member.name == "value" -> value = text
        }
        items.push("{label}: {value}")
    }
    if length > shown -> items.push("… {length - shown} more")
    Val("{native_type_name(image, ty)}{{{items.join(", ")}}}")
}

// The image's [DebugItem] list type, the one every `debug_view` returns.
native_debug_view_list: fn(image: NativeImage) -> Int? Never! {
    loop (offset, found) in image.types {
        if found.tag != NATIVE_TAG_STRUCT || found.group < 0 || !found.name.starts_with("[") -> next
        loop member in image.members[found.group] {
            if member.name != "data" -> next
            pointer: image.types.get(member.ty) ?? next
            if pointer.tag == NATIVE_TAG_POINTER && native_type_name(image, pointer.target) == NATIVE_DEBUG_VIEW_ITEM {
                return Val(offset)
            }
        }
    }
    None
}

// `text` as a Jet string literal.
native_debug_text_literal: fn(text: String) -> String Never! {
    "\"{text.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")}\""
}

// A Decimal or Fraction whose runtime handle (two exact Ints: coefficient
// and scale, or numerator and denominator) is at `address`.
native_debug_precise: fn(type_name: String, address: Int, memory: NativeMemory) -> String? Never! {
    words: native_debug_read(memory, address, 8, 2) ?? return None
    first: native_debug_int(words[0], memory) ?? return None
    if type_name == "Fraction" {
        second: native_debug_int(words[1], memory) ?? return None
        return Val("{first}/{second}")
    }
    Val(native_debug_decimal_text(first, words[1]))
}

// A Decimal's text: `coefficient` with `scale` digits after the point.
native_debug_decimal_text: fn(coefficient: Int, scale: Int) -> String Never! {
    sign: if coefficient < 0 -> "-" else -> ""
    digits := "{if coefficient < 0 -> -coefficient else -> coefficient}"
    if scale <= 0 -> return "{sign}{digits}"
    loop digits.len() <= scale -> digits = "0{digits}"
    split: digits.len() - scale
    bytes: digits.bytes()
    whole: String.from_bytes(bytes[0..<split]) ?? ""
    fraction: String.from_bytes(bytes[split..<bytes.len()]) ?? ""
    "{sign}{whole}.{fraction}"
}
