// Build-time debugging: the session `jet debug --build` (JetCLI
// DebugBuild.jet) drives while the build `jet build` runs goes on in the
// console's own process. The build tells it where its compile-time code
// runs (JetFoundation BuildDebug.jet): each batch the compile-time child
// loads arrives with its debug facts, an ELF file holding its line table,
// its locals' places and its frames, the code itself staying in the child.
// A breakpoint waits on its file and line until a batch with code there
// loads; then the child's threads are traced by one helper (JetBackend
// Loader.jet x64_trace_attach) and a trap byte goes where the line's code
// starts, past a function's prologue (NativeSession.line_starts). A stop
// reads the child's registers, stack and step word, and nothing else: the
// session never runs code in the child, so a pause spends no step, and a
// signal the child takes that is not one of its traps (SIGSYS, the
// sandbox's refusal of a system call) goes back to it unchanged. A marker
// body expands inside the compiler, under no step limit: its stop is the
// build's own Template event, whose locals the build sends.
use {
    build_files: core.files
    jet_backend.[X64Trace, X64TraceResume, X64_TRACE_RBP, X64_TRACE_RIP, X64_TRACE_RSP, link_debug_addr, link_debug_le, x64_jetline_find, x64_jetline_text, x64_trace_attach, x64_trace_close, x64_trace_of, x64_trace_read, x64_trace_registers, x64_trace_resume, x64_trace_seize, x64_trace_set_registers, x64_trace_wait_for, x64_trace_wait_now, x64_trace_write]
    jet_foundation.[BuildDebugEvent, BuildDebugKind, BuildDebugLine, build_debug_names]
}

// The step limit the build sends for a call that has none.
NATIVE_BUILD_NO_LIMIT: 9223372036854775807

// One batch of compile-time code loaded into the child `pid`: its debug
// facts, where each of its functions opens its frame (native_openings), and
// the address of the child's step word, which counts the steps left.
NativeBuildBatch: struct {
    pid: Int,
    image: NativeImage,
    openings: [NativeOpening],
    steps: Int,
    low: Int,
    high: Int,
}

// A breakpoint on `line` of `file`, as the user wrote it; `placed` once a
// batch with code on the line has loaded, or a marker body stopped there.
NativeBuildBreakpoint: struct {
    number: Int,
    file: String,
    line: Int,
    placed: Bool{false},
}

// A trap byte breakpoint `number` wrote at `address` of the child `pid`,
// over the code's `byte`.
NativeBuildSite: struct {
    pid: Int,
    address: Int,
    byte: U8,
    number: Int,
}

// One Jet frame of a stop, with its locals.
NativeBuildFrame: struct {
    function: String,
    file: String,
    line: Int,
    locals: [NativeLocal],
    // The source's path as the line table names it ("" for none).
    path: String{""},
}

// Where the build stopped: at breakpoint `number`'s trap at `site`, in
// thread `thread` of the child `pid`, or in a marker body (`ask` holds the
// build's Template event, answered when the stop is continued). `frames`
// are its Jet frames, innermost first; `used` the steps the running call
// spent of its `limit` (-1: unknown), and `what` the code's kind: "prep",
// "build" or "marker".
NativeBuildStop: struct {
    number: Int,
    pid: Int{0},
    thread: Int{0},
    site: Int{0},
    frames: [NativeBuildFrame],
    used: Int{-1},
    limit: Int{-1},
    what: String,
    ask: BuildDebugEvent?{None},
}

// A section of a batch's facts whose bytes are in the child's memory.
NativeBuildSection: struct {
    address: Int,
    size: Int,
}

NativeBuild: struct {
    trace: X64Trace{X64Trace{pid: -1, scratch: 0, failure: ""}},
    // Each traced thread's process.
    owners: [Int:Int]{[Int:Int]{}},
    batches: [NativeBuildBatch]{[NativeBuildBatch]{}},
    sites: [NativeBuildSite]{[NativeBuildSite]{}},
    breakpoints: [NativeBuildBreakpoint]{[NativeBuildBreakpoint]{}},
    numbered: Int{0},
    // Each child's step limit and kind of code of its latest call.
    limits: [Int:Int]{[Int:Int]{}},
    whats: [Int:String]{[Int:String]{}},
    // What went wrong placing breakpoints, for the console to say once.
    notes: String{""},

    // The lines the breakpoints wait on, for the build (build_debug_set_lines).
    lines: fn(self) -> [BuildDebugLine] Never! {
        ^lines: [BuildDebugLine]{}
        loop breakpoint in self.breakpoints {
            lines.push(BuildDebugLine{file: breakpoint.file, line: breakpoint.line})
        }
        lines
    }

    // A new breakpoint on `line` of `file`, placed at once in each batch
    // loaded with code there: whether it was.
    add: fn(^self, file: String, line: Int) -> Bool Never! {
        self.numbered += 1
        ^placed: false
        loop at in 0..<self.batches.len() {
            if self.place(at, file, line, self.numbered) -> placed = true
        }
        self.breakpoints.push(NativeBuildBreakpoint{number: self.numbered, file: file, line: line, placed: placed})
        placed
    }

    // Trap the code of `line` of `file` in batch `at` for breakpoint
    // `number`: whether the batch has code there and it was trapped.
    place: fn(^self, at: Int, file: String, line: Int, number: Int) -> Bool Never! {
        addresses: native_build_starts(self.batches[at], file, line)
        if addresses.len() == 0 -> return false
        pid: self.batches[at].pid
        if !self.hold(pid) -> return false
        ^placed: false
        loop address in addresses {
            if self.trap(pid, address, number) -> placed = true
        }
        placed
    }

    // Trace every thread of the child `pid` unless it is traced: each is
    // seized, stopped and let go on.
    hold: fn(^self, pid: Int) -> Bool Never! {
        if self.owners.has_key(pid) -> return true
        tasks: build_files.list_dir("/proc/{pid}/task") ?? {
            self.notes = "{self.notes}couldn't list the threads of the compile-time child {pid}: {err}\n"
            return false
        }
        loop task in tasks {
            id: Int.parse(task.name) ?? next
            status: x64_trace_seize(self.trace, id)
            if status < 0 {
                if id == pid -> self.notes = "{self.notes}{native_attach_denied(pid, -status)}\n"
                next
            }
            self.owners[id] = pid
            ^_: x64_trace_resume(x64_trace_of(self.trace, id), X64TraceResume.Run, native_trace_signal(status))
        }
        self.owners.has_key(pid)
    }

    // Write a trap byte at `address` of the child `pid`, unless one is
    // there; false when its code can't be read or written.
    trap: fn(^self, pid: Int, address: Int, number: Int) -> Bool Never! {
        if self.site_at(pid, address) >= 0 -> return true
        code: x64_trace_of(self.trace, pid)
        byte: x64_trace_read(code, address, 1) ?? return false
        if byte.len() != 1 -> return false
        if !x64_trace_write(code, address, [U8]{U8{NATIVE_DEBUG_TRAP}}) -> return false
        self.sites.push(NativeBuildSite{pid: pid, address: address, byte: byte[0], number: number})
        true
    }

    // The index of the trap at `address` of the child `pid`, else -1.
    site_at: fn(self, pid: Int, address: Int) -> Int Never! {
        loop (index, site) in self.sites {
            if site.pid == pid && site.address == address -> return index
        }
        -1
    }

    // Take one of the build's events: a batch loaded (its breakpoints are
    // placed, then the build goes on), a call starting, or a marker body
    // reaching a line a breakpoint waits on, which is a stop.
    receive: fn(^self, event: ^^BuildDebugEvent) -> NativeBuildStop? Never! {
        taken: event.move()
        if taken.kind == BuildDebugKind.Calling {
            self.limits[taken.pid] = taken.limit
            self.whats[taken.pid] = "{taken.what}"
            return None
        }
        if taken.kind == BuildDebugKind.Loaded {
            self.load(taken)
            native_build_answer(taken)
            return None
        }
        ^number: 0
        loop (index, breakpoint) in self.breakpoints {
            if breakpoint.line != taken.line || !build_debug_names(breakpoint.file, taken.file) {
                next
            }
            if number == 0 -> number = breakpoint.number
            self.breakpoints[index].placed = true
        }
        if number == 0 {
            native_build_answer(taken)
            return None
        }
        ^locals: [NativeLocal]{}
        loop local in taken.locals {
            locals.push(NativeLocal{name: "{local.name}", type_name: "", value: "{local.text}"})
        }
        frame: NativeBuildFrame{function: "{taken.rule}", file: build_files.basename(taken.file), line: taken.line, locals: locals, path: "{taken.file}"}
        Val(NativeBuildStop{number: number, frames: [NativeBuildFrame]{frame}, what: "marker", ask: Val(taken.move())})
    }

    // Read the batch `event` names, loaded into its child, and place each
    // breakpoint with code in it. Batches the child kept at the same
    // addresses before are gone, and so are their traps.
    load: fn(^self, event: BuildDebugEvent) Never! {
        ^image: native_image_read(event.facts) ?? return
        if self.trace.scratch == 0 {
            self.trace = x64_trace_attach(event.pid)
            if self.trace.helper < 0 || self.trace.channel < 0 {
                self.notes = "{self.notes}couldn't start the tracer: {self.trace.failure}\n"
                self.trace.pid = -1
                return
            }
        }
        child: x64_trace_of(self.trace, event.pid)
        ^codes: native_elf_codes(event.facts, ".text")
        loop place in native_build_sections(event.facts, ".text") {
            bytes: x64_trace_read(child, place.address, place.size) ?? next
            codes.push(NativeCode{address: place.address, bytes: bytes})
        }
        loop place in native_build_sections(event.facts, ".eh_frame") {
            bytes: x64_trace_read(child, place.address, place.size) ?? next
            code: NativeCode{address: place.address, bytes: bytes}
            native_frames_index(image.frames.fdes, code, image.frames.sections.len())
            image.frames.sections.push(code)
        }
        image.frames.fdes.sort_by(fn(left: NativeFde, right: NativeFde) { left.start <=> right.start })
        ^low: 0
        ^high: 0
        loop (index, code) in codes {
            if index == 0 || code.address < low -> low = code.address
            if code.address + code.bytes.len() > high -> high = code.address + code.bytes.len()
        }
        self.forget(event.pid, low, high)
        openings: native_openings(image, codes)
        self.batches.push(NativeBuildBatch{pid: event.pid, image: image, openings: openings, steps: event.steps, low: low, high: high})
        at: self.batches.len() - 1
        loop index in 0..<self.breakpoints.len() {
            file: "{self.breakpoints[index].file}"
            line: self.breakpoints[index].line
            if self.place(at, file, line, self.breakpoints[index].number) {
                self.breakpoints[index].placed = true
            }
        }
    }

    // Drop the batches of the child `pid` whose code lay in [low, high),
    // and their traps; every one of its batches when `high` is 0 (the
    // child has ended).
    forget: fn(^self, pid: Int, low: Int, high: Int) Never! {
        ^k: self.batches.len()
        loop k > 0 {
            k -= 1
            gone: self.batches[k].pid == pid && (high == 0 || (self.batches[k].low < high && low < self.batches[k].high))
            if gone -> ^_: self.batches.remove(k, .Slot)
        }
        k = self.sites.len()
        loop k > 0 {
            k -= 1
            gone: self.sites[k].pid == pid && (high == 0 || (self.sites[k].address >= low && self.sites[k].address < high))
            if gone -> ^_: self.sites.remove(k, .Slot)
        }
    }

    // The next stop at a trap, after letting every other stop of the
    // traced threads go on with its signal; None when no thread waits.
    poll: fn(^self) -> NativeBuildStop? Never! {
        if self.trace.channel < 0 || self.owners.len() == 0 -> return None
        loop {
            stop: x64_trace_wait_now(self.trace) ?? return None
            if stop.thread <= 0 -> return None
            thread: stop.thread
            status: stop.status
            pid: self.owners.get(thread) ?? native_build_owner(thread)
            if status & 0xff != 0x7f {
                ^_: self.owners.remove(thread)
                if thread == pid {
                    self.forget(pid, 0, 0)
                    ^_: self.limits.remove(pid)
                    ^_: self.whats.remove(pid)
                }
                next
            }
            self.owners[thread] = pid
            if (status >> 8) & 0xff == NATIVE_DEBUG_SIGTRAP && (status >> 16) == 0 {
                if self.hit(pid, thread) == .Val(found) -> return Val(found)
            }
            ^_: x64_trace_resume(x64_trace_of(self.trace, thread), X64TraceResume.Run, native_trace_signal(status))
        }
    }

    // The stop of `thread` of the child `pid` at one of its traps: its
    // code reads as compiled again and it is rewound to the trap's address.
    // None when the SIGTRAP is not at a trap of the session's.
    hit: fn(^self, pid: Int, thread: Int) -> NativeBuildStop? Never! {
        stopped: x64_trace_of(self.trace, thread)
        ^registers: x64_trace_registers(stopped) ?? return None
        address: registers[X64_TRACE_RIP] - 1
        index: self.site_at(pid, address)
        if index < 0 -> return None
        ^_: x64_trace_write(stopped, address, [U8]{self.sites[index].byte})
        registers[X64_TRACE_RIP] = address
        ^_: x64_trace_set_registers(stopped, registers)
        frames: native_build_frames(self.batches, pid, stopped, registers)
        Val(NativeBuildStop{number: self.sites[index].number, pid: pid, thread: thread, site: address, frames: frames, what: "prep"})
    }

    // The kind of code a trap's `stop` is in and the steps its call spent,
    // as the child's step word counts them: the build's call into the
    // child set it to the call's limit (the latest Calling event, which the
    // console takes before it measures), and each step takes one.
    measure: fn(self, stop: ^NativeBuildStop) Never! {
        if stop.what == "marker" {
            return
        }
        stop.what = self.whats.get(stop.pid) ?? "prep"
        at: native_build_batch_at(self.batches, stop.pid, stop.site)
        if at < 0 || self.batches[at].steps <= 0 {
            return
        }
        limit: self.limits.get(stop.pid) ?? return
        left: native_debug_word(x64_trace_of(self.trace, stop.pid), self.batches[at].steps) ?? return
        stop.used = limit - left
        stop.limit = limit
    }

    // Take breakpoint `number` out, and its traps; the traps another
    // breakpoint shared go back in.
    remove: fn(^self, number: Int) -> Bool Never! {
        ^k: self.sites.len()
        loop k > 0 {
            k -= 1
            if self.sites[k].number != number -> next
            ^_: x64_trace_write(x64_trace_of(self.trace, self.sites[k].pid), self.sites[k].address, [U8]{self.sites[k].byte})
            ^_: self.sites.remove(k, .Slot)
        }
        ^found: false
        k = self.breakpoints.len()
        loop k > 0 {
            k -= 1
            if self.breakpoints[k].number != number -> next
            ^_: self.breakpoints.remove(k, .Slot)
            found = true
        }
        loop index in 0..<self.breakpoints.len() {
            file: "{self.breakpoints[index].file}"
            line: self.breakpoints[index].line
            loop at in 0..<self.batches.len() {
                ^_: self.place(at, file, line, self.breakpoints[index].number)
            }
        }
        found
    }

    // Let the build go on from `stop`: a marker body's is answered; a
    // trap's thread runs its one instruction as compiled, the trap is
    // written back, and the thread goes on.
    resume: fn(^self, stop: ^^NativeBuildStop) Never! {
        held: stop.move()
        if held.ask != None {
            asked: held.ask ?? return
            native_build_answer(asked)
            return
        }
        thread: x64_trace_of(self.trace, held.thread)
        ^signal: 0
        if self.site_at(held.pid, held.site) >= 0 {
            ^_: x64_trace_resume(thread, X64TraceResume.Step, 0)
            status: x64_trace_wait_for(self.trace, held.thread)
            if status < 0 || status & 0xff != 0x7f {
                ^_: self.owners.remove(held.thread)
                return
            }
            if (status >> 8) & 0xff != NATIVE_DEBUG_SIGTRAP -> signal = native_trace_signal(status)
            ^_: x64_trace_write(x64_trace_of(self.trace, held.pid), held.site, [U8]{U8{NATIVE_DEBUG_TRAP}})
        }
        ^_: x64_trace_resume(thread, X64TraceResume.Run, signal)
    }

    // End the session: each trap still in a running child is taken out,
    // and the helper ends, which lets every traced thread go on.
    close: fn(^self) Never! {
        loop site in self.sites {
            ^_: x64_trace_write(x64_trace_of(self.trace, site.pid), site.address, [U8]{site.byte})
        }
        self.sites = [NativeBuildSite]{}
        self.trace.pid = -1
        if self.trace.scratch != 0 -> x64_trace_close(self.trace)
    }

    // The breakpoints no batch had code for and no marker body reached.
    unplaced: fn(self) -> String Never! {
        ^text: ""
        loop breakpoint in self.breakpoints {
            if !breakpoint.placed {
                text = "{text}Breakpoint {breakpoint.number} at {breakpoint.file}:{breakpoint.line} was never placed: no build-time code ran on that line\n"
            }
        }
        text
    }
}

// Answer the build's `event`, which waits for it (build_debug_ask).
native_build_answer: fn(event: BuildDebugEvent) Never! {
    if event.reply == .Val(answer) -> answer.send(true) ?? return
}

// The process the thread `thread` belongs to (its /proc status's Tgid).
native_build_owner: fn(thread: Int) -> Int Never! {
    status: build_files.read("/proc/{thread}/status") ?? return thread
    Int.parse(native_status_field(status, "Tgid")) ?? thread
}

// Where a breakpoint on `line` of `file` traps in `batch`
// (native_line_addresses), a function's start moved past its prologue
// (NativeSession.entry).
native_build_starts: fn(batch: NativeBuildBatch, file: String, line: Int) -> [Int] Never! {
    ^addresses: native_line_addresses(batch.image, file, line)
    loop k in 0..<addresses.len() {
        index: x64_jetline_find(batch.image.lines, addresses[k])
        if index < 0 || index >= batch.openings.len() || addresses[k] != batch.image.lines.functions[index].low {
            next
        }
        if batch.openings[index].at == addresses[k] && native_frame_open(batch.openings[index].prologue) >= 0 {
            addresses[k] = native_body_start(batch.image, index)
        }
    }
    addresses
}

// The newest batch of the child `pid` with code at `address`, else -1.
native_build_batch_at: fn(batches: [NativeBuildBatch], pid: Int, address: Int) -> Int Never! {
    ^found: -1
    loop (index, batch) in batches {
        if batch.pid == pid && x64_jetline_find(batch.image.lines, address) >= 0 -> found = index
    }
    found
}

// The sections named `name` of the ELF `elf` that hold no bytes there
// (SHT_NOBITS): a batch's code and frames, which are in the child.
native_build_sections: fn(elf: [U8], name: String) -> [NativeBuildSection] Never! {
    ^found: [NativeBuildSection]{}
    headers: link_debug_addr(elf, 40)
    size: link_debug_le(elf, 58, 2)
    count: link_debug_le(elf, 60, 2)
    names_index: link_debug_le(elf, 62, 2)
    if headers < 0 || size < 64 || names_index < 0 || names_index >= count -> return found
    names: link_debug_addr(elf, headers + names_index * size + 24)
    if names < 0 -> return found
    loop k in 0..<count {
        header: headers + k * size
        at: link_debug_le(elf, header, 4)
        if at >= 0 && link_debug_le(elf, header + 4, 4) == 8 && x64_jetline_text(elf, names + at) == name {
            found.push(NativeBuildSection{address: link_debug_addr(elf, header + 16), size: link_debug_addr(elf, header + 32)})
        }
    }
    found
}

// The Jet frames of the stopped thread `thread` of the child `pid`, whose
// registers are `start`, innermost first, each with its locals. Each frame
// unwinds by the call frame rules of the batch holding its code, or, in
// the child's runtime, by its frame-pointer chain (native_debug_frame_row).
native_build_frames: fn(batches: [NativeBuildBatch], pid: Int, thread: X64Trace, start: [Int]) -> [NativeBuildFrame] Never! {
    unwound: native_build_unwind(batches, pid, thread, start)
    ^shown: [NativeBuildFrame]{}
    loop (index, frame) in unwound {
        lookup: native_lookup(index, frame.pc)
        at: native_build_batch_at(batches, pid, lookup)
        if at < 0 -> next
        ^sites: [Int]{}
        if native_function_at(batches[at].image, lookup) == .Val(function) {
            sites = native_inline_chain(function, lookup)
        }
        sites.push(-1)
        caller: if index + 1 < unwound.len() -> NativeUnwound?{Val(unwound[index + 1])} else -> None
        memory: NativeMemory{trace: Val(thread), blocks: [NativeBlock]{}}
        loop (k, named) in native_frames_at(batches[at].image, lookup) {
            site: if k < sites.len() -> sites[k] else -> -1
            locals: native_frame_locals(batches[at].image, memory, frame, lookup, site, if site < 0 -> caller else -> None)
            shown.push(NativeBuildFrame{function: named.function, file: named.file, line: named.line, locals: locals, path: named.path})
        }
    }
    shown
}

// The frames of the stack whose innermost registers are `start`, as
// NativeSession.unwind_from finds them, each row from the batch holding
// its code. Each frame owns its registers; the caller's are built from the
// frame just pushed.
native_build_unwind: fn(batches: [NativeBuildBatch], pid: Int, thread: X64Trace, start: [Int]) -> [NativeUnwound] Never! {
    ^registers: loop value in start -> value
    ^known: loop _ in 0..<registers.len() -> true
    none: NativeFrames{sections: [NativeCode]{}, fdes: [NativeFde]{}}
    ^frames: [NativeUnwound]{}
    loop frames.len() < NATIVE_DEBUG_MOST_FRAMES {
        pc: registers[X64_TRACE_RIP]
        lookup: if frames.len() == 0 -> pc else -> pc - 1
        at: native_build_batch_at(batches, pid, lookup)
        row: if at >= 0 -> native_debug_frame_row(batches[at].image.frames, lookup) else -> native_debug_frame_row(none, lookup)
        base: native_debug_frame_register(row)
        framed: base >= 0 && known[base] && row.rules[NATIVE_CFI_RETURN] == NATIVE_CFI_SAVED
        cfa: if base >= 0 -> registers[base] + row.offset else -> 0
        frames.push(NativeUnwound{pc: pc, cfa: cfa, registers: registers.move(), known: known.move()})
        frame: frames[frames.len() - 1]
        if !framed || cfa <= frame.registers[X64_TRACE_RSP] -> break
        returned: native_debug_word(thread, cfa + row.offsets[NATIVE_CFI_RETURN]) ?? break
        if returned <= 0 -> break
        registers = loop value in frame.registers -> value
        known = loop _ in 0..<registers.len() -> false
        loop index in NATIVE_DEBUG_CALLEE_SAVED -> known[index] = frame.known[index]
        loop register in 0..<NATIVE_CFI_RETURN {
            index: NATIVE_DEBUG_DWARF_REGISTERS[register]
            if row.rules[register] == NATIVE_CFI_LOST -> known[index] = false
            if row.rules[register] == NATIVE_CFI_SAVED {
                saved: native_debug_word(thread, cfa + row.offsets[register])
                known[index] = saved != None
                registers[index] = saved ?? 0
            }
        }
        outermost: known[X64_TRACE_RBP] && registers[X64_TRACE_RBP] == 0
        registers[X64_TRACE_RIP] = returned
        registers[X64_TRACE_RSP] = cfa
        known[X64_TRACE_RIP] = true
        known[X64_TRACE_RSP] = true
        if outermost -> break
    }
    frames
}

// The console's report of `stop`: where, the innermost frame's locals, the
// frames and the steps.
native_build_stop_text: fn(stop: NativeBuildStop) -> String Never! {
    if stop.frames.len() == 0 {
        return "Stopped at breakpoint {stop.number} (build time), outside Jet code\n{native_build_steps(stop)}"
    }
    top: stop.frames[0]
    ^text: "Stopped at {top.file}:{top.line} in {top.function} (build time)\n"
    loop local in top.locals -> text = "{text}  {local.name} = {local.value}\n"
    "{text}{native_build_backtrace(stop)}{native_build_steps(stop)}"
}

// `stop`'s Jet frames, innermost first; the outermost says what kind of
// build-time code it runs.
native_build_backtrace: fn(stop: NativeBuildStop) -> String Never! {
    ^text: ""
    loop (index, frame) in stop.frames {
        tag: if index + 1 == stop.frames.len() -> " ({stop.what})" else -> ""
        text = "{text}  #{index} {frame.function} {frame.file}:{frame.line}{tag}\n"
    }
    text
}

// The innermost frame's locals of `stop`, one a line.
native_build_locals: fn(stop: NativeBuildStop) -> String Never! {
    if stop.frames.len() == 0 || stop.frames[0].locals.len() == 0 -> return "  (no locals)\n"
    ^text: ""
    loop local in stop.frames[0].locals -> text = "{text}  {local.name} = {local.value}\n"
    text
}

// The steps the stopped call spent, of its limit.
native_build_steps: fn(stop: NativeBuildStop) -> String Never! {
    if stop.what == "marker" -> return "  steps: none (a marker body has no step limit)\n"
    if stop.limit < 0 -> return "  steps: unknown\n"
    if stop.limit == NATIVE_BUILD_NO_LIMIT {
        return "  steps: {native_build_count(stop.used)} (no step limit)\n"
    }
    "  steps: {native_build_count(stop.used)} of {native_build_count(stop.limit)}\n"
}

// `count` with its thousands apart: 10,000,000.
native_build_count: fn(count: Int) -> String Never! {
    if count < 0 -> return "-{native_build_count(-count)}"
    digits: "{count}"
    ^text: ""
    loop index in 0..<digits.len() {
        if index > 0 && (digits.len() - index) % 3 == 0 -> text = "{text},"
        text = "{text}{digits.slice(index, index + 1)}"
    }
    text
}
