// The reader of the places a debugger names: a paused snapshot's place
// (Snapshot.jet), a Canvas watch's local, and the place of `watch` and
// `why` (Native.jet watch_path). The compiler's parser reads each as one
// Jet expression; nothing here has a grammar of its own. Evaluating an
// expression is the compiler's work (NativeEval.jet).
use {
    jet_foundation.[ASTTables, DIAGNOSTIC_ERROR, ExprNode, ast_expr, ast_stmt]
    jet_parser.[parse_source]
}

// The most UTF-8 bytes one debugger expression may have.
DEBUG_EXPRESSION_MAX_BYTES: 16384

// One debugger expression the parser read: the AST tables of its parse and
// its root node.
DebugExpression: struct {
    tables: ASTTables,
    root: ExprNode,
}

// `text` read by the compiler's parser as one Jet expression.
debug_parse_expression: fn(text: String) -> DebugExpression DebugEvaluationError! {
    if text.trim() == "" -> return Err(debug_evaluation_error("the expression is empty"))
    if text.bytes().len() > DEBUG_EXPRESSION_MAX_BYTES {
        return Err(debug_evaluation_error("the expression is longer than {DEBUG_EXPRESSION_MAX_BYTES} bytes"))
    }
    parsed: parse_source("debug_expression: fn() {{\n{text}\n}}\n".bytes())
    loop diagnostic in parsed.diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR {
            return Err(debug_evaluation_error("`{text}` is not a Jet expression: {diagnostic.what}"))
        }
    }
    if parsed.program.items.len() == 1 && parsed.program.items[0] == .Func(function) && function.body.len() == 1 && ast_stmt(parsed.program.tables, function.body[0]) == .Expr(expr) {
        return Ok(DebugExpression{tables: parsed.program.tables, root: expr})
    }
    Err(debug_evaluation_error("`{text}` is not one Jet expression"))
}

// Whether `expr` names a place: a local, a named field of a place, or a
// place indexed by an integer literal.
debug_is_place: fn(tables: ASTTables, expr: ExprNode) -> Bool Never! {
    if ast_expr(tables, expr) == .Ident(_, _, _) -> return true
    if ast_expr(tables, expr) == .Field(base, member, _, _) {
        first: member.bytes()
        return first.len() > 0 && (Int{first[0]} < 48 || Int{first[0]} > 57) && debug_is_place(tables, base)
    }
    if ast_expr(tables, expr) == .Index(base, index, _, _, _) && ast_expr(tables, index) == .Int(position, _, _, _, _) {
        return position >= 0 && debug_is_place(tables, base)
    }
    false
}

// Whether the debugger expression `text`, read by the compiler's parser,
// names a local by its name alone.
debug_is_local_name: fn(text: String) -> Bool Never! {
    expr: debug_parse_expression(text) ?? return false
    ast_expr(expr.tables, expr.root) == .Ident(_, _, _)
}

// A place a debugger names, as the parser reads it: the local it starts at
// (`root`), the fields under it (`fields`, outermost first) and the text of
// the index at its end (`index`, "" when it has none), with the index's
// value when it is an integer literal (`literal`, else -1).
DebugPlace: struct {
    root: String,
    fields: [String],
    index: String,
    literal: Int,
}

// The place `text` names: a local or a field path under one, and an index
// at its end or none. Refused when the parser refuses `text` or it names
// no place.
debug_place: fn(text: String) -> DebugPlace DebugEvaluationError! {
    parsed: debug_parse_expression(text) ?? return Err(err)
    ^node: parsed.root
    ^index: ""
    ^literal: -1
    if ast_expr(parsed.tables, parsed.root) == .Index(base, item, _, _, _) {
        node = base
        // The place before the index is a local or a field path, which has
        // no brackets, so the index runs from the first `[` to the last `]`.
        index = "{text.rpartition("]").head.after("[").trim()}"
        literal = if ast_expr(parsed.tables, item) == .Int(position, _, _, _, _) -> position else -> -1
    }
    ^fields: [String]{}
    root: debug_place_fields(parsed.tables, node, fields) ?? return Err(debug_evaluation_error("`{text.trim()}` names no place; a place is a local or a field path under one, with an index at its end or none, as `order.lines[i + 1]`"))
    Ok(DebugPlace{root: root, fields: fields, index: index, literal: literal})
}

// The fields `node` goes through, outermost first, into `fields`, and the
// local it starts at; None when it is not a local or a field path under one.
debug_place_fields: fn(tables: ASTTables, node: ExprNode, fields: ^[String]) -> String? Never! {
    if ast_expr(tables, node) == .Ident(name, _, _) -> return Val(name)
    if ast_expr(tables, node) == .Field(base, member, _, _) {
        root: debug_place_fields(tables, base, fields) ?? return None
        fields.push(member)
        return Val(root)
    }
    None
}

debug_expression_test_place: fn(text: String) -> Bool Never! {
    expr: debug_parse_expression(text) ?? return false
    debug_is_place(expr.tables, expr.root)
}

#Test("A debugger place is read by the compiler's parser") {
    places: [String]{"account.items[12].name", " a ", "a._b[0][7]", "_a"}
    loop text in places -> assert(debug_expression_test_place(text))
    refused: [String]{"", "a[]", "a.", "a.1", "a[1", "a[x]", "a()", "a + 1", "a b", "1"}
    loop text in refused -> assert(!debug_expression_test_place(text))
    assert(debug_is_local_name(" a "))
    assert(!debug_is_local_name("a.b"))
    assert(!debug_is_local_name("a b"))
}

debug_expression_test_refusal: fn(text: String) -> String Never! {
    if debug_parse_expression(text) == {
        .Ok(_) -> {
            panic("expected `{text}` to be refused")
        }
        .Err(error) -> error.message
    }
}

#Test("A debugger expression the parser refuses says why") {
    assert(debug_expression_test_refusal("i ==").starts_with("`i ==` is not a Jet expression: "))
    assert_eq(debug_expression_test_refusal("   "), "the expression is empty")
    assert_eq(debug_expression_test_refusal("i\n}}\nother: fn() {{\ni"), "`i\n}}\nother: fn() {{\ni` is not one Jet expression")
}

debug_place_test_refusal: fn(text: String) -> String Never! {
    if debug_place(text) == {
        .Ok(_) -> {
            panic("expected `{text}` to name no place")
        }
        .Err(error) -> error.message
    }
}

#Test("A watched place, its index any expression, is read by the compiler's parser") {
    item: debug_place(" order.lines[i + 1] ") ?? panic(err.message)
    assert_eq(item.root, "order")
    assert_eq(item.fields.len(), 1)
    assert_eq(item.fields[0], "lines")
    assert_eq(item.index, "i + 1")
    assert_eq(item.literal, -1)
    third: debug_place("xs[3]") ?? panic(err.message)
    assert_eq(third.root, "xs")
    assert_eq(third.index, "3")
    assert_eq(third.literal, 3)
    field: debug_place("order.total") ?? panic(err.message)
    assert_eq(field.fields[0], "total")
    assert_eq(field.index, "")
    assert(debug_place_test_refusal("order.total + 1").starts_with("`order.total + 1` names no place; "))
    assert(debug_place_test_refusal("xs[0].total").starts_with("`xs[0].total` names no place; "))
    assert(debug_place_test_refusal("order.lines[").starts_with("`order.lines[` is not a Jet expression: "))
}
