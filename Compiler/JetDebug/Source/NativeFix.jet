// `fix` under `jet debug`: the edited program, compiled again at O0, is
// swapped into the running native process. The new compile's functions are
// matched by symbol name to the code the process runs (the image's own, or a
// function an earlier fix placed). One name can belong to many functions (a
// generic's instances, two types' derived methods): the one whose code is
// the compile's runs it, else the one at the same place among them. A
// function whose code differs in any byte outside its relocation fields, or
// whose relocations reach other targets, has changed. The changed
// functions, and any data object they reach that
// the running code doesn't, are laid out in a region the debugger maps into
// the process, their relocations resolved against the running image. Each
// changed function's old entry then jumps to its new code, so every call
// from then on, the next one included, runs the edit, while a frame already
// inside the old code finishes there. Where each target lives in the
// running image is read from the unchanged functions' own relocation fields,
// so the image's anonymous data objects are found where the running code
// reaches them. An edit is refused, with nothing changed, when it was
// compiled at another optimization level than the image's, when a struct's
// layout changes (its values in memory would be read through the new
// layout; the refusal names the field), when a function the program runs
// changes its parameters while a caller's frame on a stack, which finishes
// in its old code, would pass it the old ones, when it changes the entry
// the program has already run, or when it reaches a runtime routine the
// image does not hold.
use jet_backend.[X64CompiledFunction, X64Data, X64DebugEncoding, X64DebugMember, X64DebugType, X64DebugTypeKind, X64DebugVariable, X64FunctionDebug, X64FunctionID, X64FunctionSource, X64Jetline, X64JetlineFunction, X64ModuleDebug, X64ObjectModule, X64Reloc, X64RelocTarget, link_debug_addr, link_debug_le, x64_jetline_find, x64_jetline_text]

// What `fix` compiled: the program's module (its data objects, debug types
// and functions' source facts), its compiled functions with their
// relocations, `main` first, and each function's debug rows.
NativeFixEdit: struct {
    object: X64ObjectModule,
    functions: [X64CompiledFunction],
    debug: [X64FunctionDebug],
}

// A function a fix placed: its symbol name, where its code is, the code as
// placed, relocations resolved, the address of the code it replaced (-1 for
// a function the program didn't run), and its parameters as
// native_fix_parameters spells them.
NativeFixed: struct {
    name: String,
    address: Int,
    code: [U8],
    was: Int,
    parameters: String,
}

// A sized symbol of the image's `.symtab`.
NativeFixSymbol: struct {
    address: Int,
    size: Int,
}

// The image's sized symbols: the slot of each name in `named`, which holds
// its symbols in the table's order.
NativeFixSymbols: struct {
    slots: [String:Int],
    named: [[NativeFixSymbol]],
}

// The running version of one function: its address and code.
NativeFixRunning: struct {
    address: Int,
    code: [U8],
}

// Where each kind of relocation target lives in the running process, as the
// unchanged code reaches it; a target two unchanged functions reach at
// different addresses is `clashed` and known nowhere.
NativeFixTargets: struct {
    functions: [Int:Int],
    data: [Int:Int],
    runtime: [String:Int],
    clashed: [String:Bool],
}

// One placed piece of the region: a changed function (its row in
// NativeFixEdit.functions) or a data object (its id), at `offset`.
NativeFixPiece: struct {
    function: Int,
    data: Int,
    offset: Int,
}

// A fix the debugger can apply: the changed functions' rows, the pieces of
// the region and its size, and where the targets the pieces reach live.
NativeFixPlan: struct {
    changed: [Int],
    pieces: [NativeFixPiece],
    size: Int,
    targets: NativeFixTargets,
    // Each placed function's row by its id, and each copied data object's
    // piece by its id.
    placed: [Int:Int],
    copied: [Int:Int],
    // By the edit's row, where the program runs that function and its
    // code's length: -1 and 0 for one it doesn't run.
    running: [Int]{[Int]{}},
    lengths: [Int]{[Int]{}},
    // Each runtime function the placed code calls that the image doesn't
    // hold, by its place in the order the calls came: its trap is that many
    // traps past `traps`, the offset of the first in the region
    // (native_fix_place_all).
    absent: [String:Int]{[String:Int]{}},
    traps: Int{0},
}

// The bytes of a trap, `ud2`.
NATIVE_FIX_TRAP: 2

// The region's pages and the code alignment inside it.
NATIVE_FIX_PAGE: 4096

NATIVE_FIX_ALIGN: 16

// How far past the image's code the first region is asked for, and how far
// on the next try goes when that address is taken: inside the 2 GiB a rel32
// reaches, clear of the heap the program grows after its data.
NATIVE_FIX_GAP: 0x10000000

NATIVE_FIX_TRIES: 6

// The kernel's register index of rax, rdx, r10, r8, r9 and orig_rax.
NATIVE_FIX_RAX: 10

NATIVE_FIX_RDX: 12

NATIVE_FIX_R10: 7

NATIVE_FIX_R8: 9

NATIVE_FIX_R9: 8

NATIVE_FIX_ORIG_RAX: 15

// The bytes of the `jmp rel32` a fixed function's old entry gets.
NATIVE_FIX_JUMP: 5

// How many unnamed pointers and typedefs a parameter's type is followed
// through to the type it is spelled by (native_fix_parameters).
NATIVE_FIX_TYPE_DEPTH: 8

// mmap, PROT_READ | PROT_WRITE | PROT_EXEC, and MAP_PRIVATE |
// MAP_ANONYMOUS | MAP_FIXED_NOREPLACE.
NATIVE_FIX_MMAP: 9

NATIVE_FIX_PROTECTION: 7

NATIVE_FIX_FLAGS: 0x100022

// The sized symbols of the ELF file `elf`'s `.symtab`.
native_fix_symbols: fn(elf: [U8]) -> NativeFixSymbols Never! {
    symbols := NativeFixSymbols{slots: [String:Int]{}, named: [[NativeFixSymbol]]{}}
    headers: link_debug_addr(elf, 40)
    size: link_debug_le(elf, 58, 2)
    count: link_debug_le(elf, 60, 2)
    if headers < 0 || size < 64 -> return symbols
    loop k in 0..<count {
        header: headers + k * size
        // SHT_SYMTAB; its sh_link names the string table.
        if link_debug_le(elf, header + 4, 4) != 2 -> next
        table: link_debug_addr(elf, header + 24)
        length: link_debug_addr(elf, header + 32)
        link: link_debug_le(elf, header + 40, 4)
        if table < 0 || length < 0 || table + length > elf.len() || link < 0 || link >= count {
            return symbols
        }
        names: link_debug_addr(elf, headers + link * size + 24)
        loop s in 0..<length.div_euclid(24) {
            at: table + s * 24
            address: link_debug_addr(elf, at + 8)
            if address <= 0 -> next
            name: x64_jetline_text(elf, names + link_debug_le(elf, at, 4))
            if name == "" -> next
            native_fix_symbol_add(symbols, name, NativeFixSymbol{address: address, size: link_debug_addr(elf, at + 16)})
        }
    }
    symbols
}

// Add `symbol`, named `name`, after the symbols of that name `symbols` has.
native_fix_symbol_add: fn(symbols: &NativeFixSymbols, name: String, symbol: &&NativeFixSymbol) Never! {
    if symbols.slots.get(name) == {
        .Val(slot) -> { symbols.named[slot].push(symbol) }
        .None -> {
            symbols.slots[name] = symbols.named.len()
            symbols.named.push([NativeFixSymbol]{symbol})
        }
    }
}

// Where the image has the runtime's `symbol`: the first symbol of that
// name, 0 when it has none.
native_fix_runtime_address: fn(symbols: NativeFixSymbols, symbol: String) -> Int Never! {
    slot: symbols.slots.get(symbol) ?? return 0
    if symbols.named[slot].len() == 0 -> return 0
    symbols.named[slot][0].address
}

// The fix in `fixed` that last replaced the code at `address`, following
// each later fix of the code it placed: its index, -1 when none did.
native_fix_latest: fn(address: Int, fixed: [NativeFixed]) -> Int Never! {
    latest := -1
    current := address
    loop (k, placed) in fixed {
        if placed.was == current {
            latest = k
            current = placed.address
        }
    }
    latest
}

// The running versions of the functions named `name`: for each sized
// symbol of that name in the table's order, the latest code a fix placed
// over it, else the image's own from `text` (the `.text` bytes loaded at
// `text_address`); then the latest of each function a fix placed that the
// program didn't run before.
native_fix_runnings: fn(name: String, symbols: NativeFixSymbols, text: [U8], text_address: Int, fixed: [NativeFixed]) -> [NativeFixRunning] Never! {
    runnings := [NativeFixRunning]{}
    if name == "" -> return runnings
    if symbols.slots.get(name) == .Val(slot) {
        loop symbol in symbols.named[slot] {
            start: symbol.address - text_address
            if symbol.size <= 0 || start < 0 || start + symbol.size > text.len() -> next
            last: native_fix_latest(symbol.address, fixed)
            if {
                last >= 0 -> {
                    runnings.push(NativeFixRunning{address: fixed[last].address, code: fixed[last].code[0..<fixed[last].code.len()]})
                }
                else -> {
                    runnings.push(NativeFixRunning{address: symbol.address, code: text[start..<start + symbol.size]})
                }
            }
        }
    }
    loop (k, placed) in fixed {
        if placed.name != name || placed.was >= 0 -> next
        last: native_fix_latest(placed.address, fixed)
        at: if last >= 0 -> last else -> k
        runnings.push(NativeFixRunning{address: fixed[at].address, code: fixed[at].code[0..<fixed[at].code.len()]})
    }
    runnings
}

// Which of `runnings` (native_fix_runnings of its name) runs `function`,
// the `ordinal`th of the compile's functions of that name: the one at the
// same place when its code is the function's, else the first whose code
// is, else the one at the same place (or the first), whose code the
// function's changes. -1 when the program runs none of that name.
native_fix_pick: fn(function: X64CompiledFunction, ordinal: Int, runnings: [NativeFixRunning]) -> Int Never! {
    if runnings.len() == 0 -> return -1
    if ordinal < runnings.len() && native_fix_same_bytes(function, runnings[ordinal]) {
        return ordinal
    }
    loop (k, running) in runnings {
        if native_fix_same_bytes(function, running) -> return k
    }
    if ordinal < runnings.len() -> return ordinal
    0
}

// The key a relocation target is known by in NativeFixTargets.clashed.
native_fix_key: fn(target: X64RelocTarget) -> String Never! {
    if target == {
        .Function(id) -> "f{id.value}"
        .Data(id) -> "d{id.value}"
        .Runtime(symbol) -> "r{symbol}"
        .RuntimeData(symbol) -> "r{symbol}"
    }
}

// Whether `code` is `running`'s code but for the rel32 fields `function`'s
// relocations hold.
native_fix_same_bytes: fn(function: X64CompiledFunction, running: NativeFixRunning) -> Bool Never! {
    if function.code.len() != running.code.len() -> return false
    masked := loop _ in 0..<function.code.len() -> false
    loop reloc in function.relocs {
        loop k in reloc.at..<reloc.at + 4 {
            if k < masked.len() -> masked[k] = true
        }
    }
    loop k in 0..<function.code.len() {
        if !masked[k] && function.code[k] != running.code[k] -> return false
    }
    true
}

// The address the rel32 field at `at` of `running` reaches.
native_fix_reached: fn(running: NativeFixRunning, at: Int) -> Int Never! {
    running.address + at + 4 + native_number(running.code, at, 4, X64DebugEncoding.Signed)
}

// Record that `target` lives at `address`.
native_fix_learn: fn(targets: &NativeFixTargets, target: X64RelocTarget, address: Int) Never! {
    key: native_fix_key(target)
    if targets.clashed.get(key) != None {
        return
    }
    known: native_fix_known(targets, target)
    if known == .Val(found) {
        if found != address -> targets.clashed[key] = true
        return
    }
    if target == {
        .Function(id) -> { targets.functions[id.value] = address }
        .Data(id) -> { targets.data[id.value] = address }
        .Runtime(symbol) -> { targets.runtime[symbol] = address }
        .RuntimeData(symbol) -> targets.runtime[symbol] = address
    }
}

// Where the running code reaches `target`; None when no unchanged code
// reaches it or two places do.
native_fix_known: fn(targets: NativeFixTargets, target: X64RelocTarget) -> Int? Never! {
    if targets.clashed.get(native_fix_key(target)) != None -> return None
    if target == {
        .Function(id) -> targets.functions.get(id.value)
        .Data(id) -> targets.data.get(id.value)
        .Runtime(symbol) -> targets.runtime.get(symbol)
        .RuntimeData(symbol) -> targets.runtime.get(symbol)
    }
}

// How the struct `name` of the edit differs from the running image: None
// when the image has no struct of that name or one of them has the same
// layout. One name can belong to many structs (each instance of a generic
// type, such as a Result's `Ok`, and same-named types of other modules), so
// the edit's struct changed only when none of them matches it; the change
// shown is the one against the first.
native_fix_layout_change: fn(image: NativeImage, name: String, size: Int, members: [X64DebugMember]) -> String? Never! {
    first := ""
    loop (_, old) in image.types {
        if old.name != name || old.tag != NATIVE_TAG_STRUCT || old.group < 0 -> next
        change: native_fix_layout_against(image.members[old.group], old.size, size, members) ?? return None
        if first == "" -> first = change
    }
    if first == "" -> return None
    Val(first)
}

native_fix_layout_against: fn(before: [NativeMember], old_size: Int, size: Int, members: [X64DebugMember]) -> String? Never! {
    loop member in members {
        found := false
        loop was in before {
            if was.name != member.name -> next
            found = true
            if was.offset != member.offset -> return Val("field `{member.name}` moved")
        }
        if !found -> return Val("field `{member.name}` added")
    }
    loop was in before {
        kept := false
        loop member in members {
            if member.name == was.name -> kept = true
        }
        if !kept -> return Val("field `{was.name}` removed")
    }
    if old_size != size -> return Val("its size changed from {old_size} to {size} bytes")
    None
}

// Why the edit's types can't be swapped in: the first struct whose layout
// changed, by its Jet spelling, with its field. None when every struct the
// image knows keeps its layout.
native_fix_layouts: fn(image: NativeImage, object: X64ObjectModule) -> String? Never! {
    loop ty in object.debug.types {
        if ty.name == "" -> next
        if ty.kind == .Struct(members) {
            if native_fix_layout_change(image, ty.name, ty.size, members) == .Val(change) {
                return Val("`{native_jet_spelling(ty.name)}` changed its layout ({change})")
            }
        }
    }
    None
}

// The name a refusal or report shows for the compiled function at `row`:
// its source name when it has one.
native_fix_shown: fn(edit: NativeFixEdit, row: Int) -> String Never! {
    id: edit.functions[row].id.value
    if id >= 0 && id < edit.object.functions.len() && edit.object.functions[id].name != "" {
        return edit.object.functions[id].name
    }
    edit.functions[row].name
}

// How `edit` differs from the running program: its image's symbols, the
// image's `.text` (loaded at `text_address`) and the functions earlier fixes
// placed. The plan places nothing: it holds the changed functions, where
// the unchanged code reaches each target, and where the program runs each
// function. The error's detail says why the edit's values can't be read
// by the running code (a struct's layout changed).
native_fix_diff: fn(image: NativeImage, edit: NativeFixEdit, symbols: NativeFixSymbols, text: [U8], text_address: Int, fixed: [NativeFixed]) -> NativeFixPlan NativeDebugError! {
    if native_fix_layouts(image, edit.object) == .Val(reason) {
        return Err(NativeDebugError{detail: reason})
    }
    targets := NativeFixTargets{functions: [Int:Int]{}, data: [Int:Int]{}, runtime: [String:Int]{}, clashed: [String:Bool]{}}
    row_of := [Int:Int]{}
    running := [NativeFixRunning?]{}
    same := [Bool]{}
    // How many of the compile's functions so far have each name.
    ordinals := [String:Int]{}
    loop (row, function) in edit.functions {
        row_of[function.id.value] = row
        ordinal: ordinals.get(function.name) ?? 0
        ordinals[function.name] = ordinal + 1
        runnings: native_fix_runnings(function.name, symbols, text, text_address, fixed)
        pick: native_fix_pick(function, ordinal, runnings)
        found := NativeFixRunning?{None}
        k := 0
        loop candidate in runnings.move() {
            if k == pick -> found = Val(candidate)
            k += 1
        }
        alike: if found == .Val(was) -> native_fix_same_bytes(function, was) else -> false
        if alike && found == .Val(was) {
            loop reloc in function.relocs {
                native_fix_learn(targets, reloc.target, native_fix_reached(was, reloc.at))
            }
        }
        running.push(found)
        same.push(alike)
    }
    // A function whose own address is found by its name is known there.
    loop (row, function) in edit.functions {
        if running[row] == .Val(was) && targets.functions.get(function.id.value) == None {
            targets.functions[function.id.value] = was.address
        }
    }
    changed := [Int]{}
    loop (row, function) in edit.functions {
        moved := !same[row]
        if !moved {
            was: running[row] ?? panic("an unchanged function has running code")
            loop reloc in function.relocs {
                reached: native_fix_reached(was, reloc.at)
                if native_fix_known(targets, reloc.target) != .Val(reached) -> moved = true
                if reloc.target == .Function(id) {
                    callee: row_of.get(id.value) ?? -1
                    if callee < 0 || running[callee] == None -> moved = true
                    if running[callee] == .Val(called) && called.address != reached -> moved = true
                }
            }
        }
        if moved -> changed.push(row)
    }
    addresses: loop found in running -> if found == .Val(was) -> was.address else -> -1
    lengths: loop found in running -> if found == .Val(was) -> was.code.len() else -> 0
    Ok(NativeFixPlan{changed: changed, pieces: [NativeFixPiece]{}, size: 0, targets: targets, placed: [Int:Int]{}, copied: [Int:Int]{}, running: addresses, lengths: lengths})
}

// The fix of `edit` against the running program (native_fix_diff's
// inputs): its changed functions laid out. A plan that changes no function
// means the program already runs the edit; the error's detail says why the
// edit can't be swapped in.
native_fix_plan: fn(image: NativeImage, edit: NativeFixEdit, symbols: NativeFixSymbols, text: [U8], text_address: Int, fixed: [NativeFixed]) -> NativeFixPlan NativeDebugError! {
    if edit.object.debug.level != image.level {
        return Err(NativeDebugError{detail: "the edit was compiled at O{edit.object.debug.level}, and the program runs O{image.level} code"})
    }
    diff: native_fix_diff(image, edit, symbols, text, text_address, fixed) ?? return Err(err)
    if diff.changed.len() == 0 -> return Ok(diff)
    row_of := [Int:Int]{}
    loop (row, function) in edit.functions -> row_of[function.id.value] = row
    // `main` (row 0) runs the entry once; an edit of either can't take
    // effect in a program already past them.
    entry := -1
    loop reloc in edit.functions[0].relocs {
        if reloc.target == .Function(id) -> entry = row_of.get(id.value) ?? -1
    }
    loop row in diff.changed {
        if row == 0 || row == entry {
            return Err(NativeDebugError{detail: "the edit changes `{native_fix_shown(edit, row)}`, the program's start, which has already run"})
        }
    }
    laid := native_fix_lay_out(edit, symbols, diff.targets, diff.changed, row_of, loop at in diff.running -> at >= 0) ?? return Err(err)
    laid.running = diff.running.move()
    laid.lengths = diff.lengths.move()
    Ok(laid)
}

// The parameters of the edit's function at `row`, its own and not those of
// a function inlined into it, each `name: Type`, joined by ", ".
native_fix_parameters: fn(edit: NativeFixEdit, row: Int) -> String Never! {
    id: edit.functions[row].id.value
    if id < 0 || id >= edit.object.functions.len() -> return ""
    shown := [String]{}
    loop variable in edit.object.functions[id].variables {
        if variable.parameter && variable.site == 0 {
            shown.push("{variable.name}: {native_fix_type_shown(edit.object.debug, variable.ty, 0)}")
        }
    }
    shown.join(", ")
}

// The Jet spelling of the edit's debug type `ty`: an unnamed pointer or
// typedef is spelled by the type it reaches.
native_fix_type_shown: fn(debug: X64ModuleDebug, ty: Int, depth: Int) -> String Never! {
    if ty < 0 || ty >= debug.types.len() -> return "?"
    found: debug.types[ty]
    if found.name != "" -> return native_jet_spelling(found.name)
    if depth >= NATIVE_FIX_TYPE_DEPTH -> return "?"
    if found.kind == {
        .Pointer(target) -> native_fix_type_shown(debug, target, depth + 1)
        .Typedef(target) -> native_fix_type_shown(debug, target, depth + 1)
        .Base(_) | .Struct(_) | .Union(_) | .Enum(_) | .Variants(_, _) | .Opaque -> "?"
    }
}

// The image's type `ty`, spelled as native_fix_type_shown spells the
// edit's.
native_fix_image_type: fn(image: NativeImage, ty: Int, depth: Int) -> String Never! {
    found: image.types.get(ty) ?? return "?"
    if found.name != "" -> return native_jet_spelling(found.name)
    if depth < NATIVE_FIX_TYPE_DEPTH && (found.tag == NATIVE_TAG_POINTER || found.tag == NATIVE_TAG_TYPEDEF) {
        return native_fix_image_type(image, found.target, depth + 1)
    }
    "?"
}

// The parameters of the function the program runs at `address`, spelled
// as native_fix_parameters spells the edit's: those of the function an
// earlier fix placed there, else the image's; None when neither knows a
// function there.
native_fix_running_parameters: fn(image: NativeImage, fixed: [NativeFixed], address: Int) -> String? Never! {
    loop placed in fixed {
        if placed.address == address -> return Val(placed.parameters)
    }
    loop function in image.functions {
        if function.low != address -> next
        shown := [String]{}
        loop variable in function.variables {
            if variable.role == .Parameter && variable.site < 0 {
                shown.push("{variable.name}: {native_fix_image_type(image, variable.ty, 0)}")
            }
        }
        return Val(shown.join(", "))
    }
    None
}

// Why the planned fix `plan` of `edit` can't be swapped in while the
// program's frames are where they are (`live`, each frame's code address):
// a changed function the program runs whose parameters changed, called by
// a function with a frame on a stack. That frame finishes in its old code
// (native_fix_on_stack), and its next call of the function, now the edit's,
// would pass the old parameters. None when no frame would.
native_fix_types: fn(image: NativeImage, edit: NativeFixEdit, plan: NativeFixPlan, fixed: [NativeFixed], live: [Int]) -> String? Never! {
    loop row in plan.changed {
        at: plan.running[row]
        if at < 0 -> next
        before: native_fix_running_parameters(image, fixed, at) ?? next
        after: native_fix_parameters(edit, row)
        if before == after -> next
        id: edit.functions[row].id.value
        loop (caller, function) in edit.functions {
            low: plan.running[caller]
            if low < 0 || !native_fix_calls(function, id) -> next
            if native_fix_on_stack(image, low, low + plan.lengths[caller], live) {
                return Val("`{native_fix_shown(edit, row)}` changed its parameters from ({before}) to ({after}), and `{native_fix_shown(edit, caller)}`, on the stack, still passes the old ones")
            }
        }
    }
    None
}

// Whether `function` calls the edit's function `id`.
native_fix_calls: fn(function: X64CompiledFunction, id: Int) -> Bool Never! {
    loop reloc in function.relocs {
        if reloc.target == .Function(callee) && callee.value == id -> return true
    }
    false
}

// Whether a frame of `live` runs the code [low, high) or another version of
// that function: code the image's line table names as it names that code
// (an earlier fix's, or the image's own before a fix).
native_fix_on_stack: fn(image: NativeImage, low: Int, high: Int, live: [Int]) -> Bool Never! {
    found: x64_jetline_find(image.lines, low)
    name: if found >= 0 -> image.lines.functions[found].name else -> ""
    loop pc in live {
        if pc >= low && pc < high -> return true
        at: x64_jetline_find(image.lines, pc)
        if name != "" && at >= 0 && image.lines.functions[at].name == name -> return true
    }
    false
}

// The plan that places, afresh, the function of `edit` named `entry` (and
// the one named `also`, when it isn't "") and every function they reach by
// a call, even those the program runs unchanged, at the targets `plan` (the
// edit's native_fix_diff) found: an evaluated expression (and the drop of
// its result) or a breakpoint's condition (NativeEval.jet, NativePlace.jet).
// Code that only the rest of the program runs stays out, so a compile whose
// whole-program choices (its main, its register use) differ from the
// image's still places the same expression. A call of a runtime function
// the image doesn't hold, because the program never needed it (an Int's
// path for values past a word, say), goes to a trap in the region
// (NativeFixPlan.absent), a `ud2` that stops the code with SIGILL: the code
// runs in the stopped program with its faults kept from it (NativeEval.jet
// native_eval_here), or a placed condition's fault goes to one
// (Native.divert), so only a run that takes the call fails, naming the
// function (native_fix_absent_at).
native_fix_place_all: fn(edit: NativeFixEdit, symbols: NativeFixSymbols, plan: NativeFixPlan, entry: String, also: String{""}) -> NativeFixPlan NativeDebugError! {
    row_of := [Int:Int]{}
    start := -1
    pending := [Int]{}
    loop (row, function) in edit.functions {
        row_of[function.id.value] = row
        if function.name == entry -> start = row
        if also != "" && function.name == also -> pending.push(row)
    }
    if start < 0 -> return Err(NativeDebugError{detail: "the compiled condition has no `{entry}`"})
    pending.push(start)
    rows := [Int]{}
    reached := [Int:Bool]{}
    loop pending.len() > 0 {
        row: pending.pop() ?? -1
        if row < 0 || reached.has_key(row) -> next
        reached[row] = true
        rows.push(row)
        loop reloc in edit.functions[row].relocs {
            if reloc.target == .Function(id) -> pending.push(row_of.get(id.value) ?? -1)
        }
    }
    native_fix_lay_out(edit, symbols, plan.targets, rows, row_of, loop _ in edit.functions -> false, trapped: true)
}

// The region that places the functions of `rows`, then each data object
// they reach that no unchanged code does, with the objects those reach in
// turn, then, when `trapped`, a trap for each runtime function they call
// that the image doesn't hold (native_fix_place_all); without one, such a
// call refuses the plan. `running` says which functions' code the program
// holds, for a call of one `rows` doesn't place.
native_fix_lay_out: fn(edit: NativeFixEdit, symbols: NativeFixSymbols, targets: NativeFixTargets, rows: [Int], row_of: [Int:Int], running: [Bool], trapped: Bool{false}) -> NativeFixPlan NativeDebugError! {
    pieces := [NativeFixPiece]{}
    placed := [Int:Int]{}
    copied := [Int:Int]{}
    offset := 0
    loop row in rows {
        offset = (offset + NATIVE_FIX_ALIGN - 1).div_euclid(NATIVE_FIX_ALIGN) * NATIVE_FIX_ALIGN
        pieces.push(NativeFixPiece{function: row, data: -1, offset: offset})
        placed[edit.functions[row].id.value] = row
        offset += edit.functions[row].code.len()
    }
    wanted := [Int]{}
    // The runtime functions the image doesn't hold, each by its place in the
    // order the calls come.
    absent := [String:Int]{}
    loop row in rows {
        loop reloc in edit.functions[row].relocs {
            if reloc.target == {
                .Data(id) -> {
                    if native_fix_known(targets, reloc.target) == None -> wanted.push(id.value)
                }
                .Runtime(symbol) -> {
                    if native_fix_known(targets, reloc.target) == None && symbols.slots.get(symbol) == None {
                        if !trapped {
                            return Err(NativeDebugError{detail: "`{native_fix_shown(edit, row)}` now calls the runtime's `{symbol}`, which the running image does not hold"})
                        }
                        if !absent.has_key(symbol) -> absent[symbol] = absent.len()
                    }
                }
                .RuntimeData(symbol) -> {
                    if native_fix_known(targets, reloc.target) == None && symbols.slots.get(symbol) == None {
                        return Err(NativeDebugError{detail: "`{native_fix_shown(edit, row)}` now reads the runtime's `{symbol}`, which the running image does not hold"})
                    }
                }
                .Function(id) -> {
                    callee: row_of.get(id.value) ?? -1
                    if callee < 0 || (!running[callee] && placed.get(id.value) == None) {
                        return Err(NativeDebugError{detail: "`{native_fix_shown(edit, row)}` calls a function the edit does not compile"})
                    }
                }
            }
        }
    }
    loop wanted.len() > 0 {
        id: wanted.pop() ?? -1
        if id < 0 || id >= edit.object.data.len() || copied.get(id) != None -> next
        object: edit.object.data[id]
        align: if object.align > 0 -> object.align else -> 1
        offset = (offset + align - 1).div_euclid(align) * align
        copied[id] = pieces.len()
        pieces.push(NativeFixPiece{function: -1, data: id, offset: offset})
        offset += object.bytes.len()
        loop reloc in object.relocs {
            if targets.data.get(reloc.target.value) == None || targets.clashed.get("d{reloc.target.value}") != None {
                wanted.push(reloc.target.value)
            }
        }
    }
    // Each trap, `ud2` (0f 0b), in the order the calls came.
    traps: offset
    offset += NATIVE_FIX_TRAP * absent.len()
    // Room for the last word the debugger writes whole.
    size: (offset + 8 + NATIVE_FIX_PAGE - 1).div_euclid(NATIVE_FIX_PAGE) * NATIVE_FIX_PAGE
    Ok(NativeFixPlan{changed: rows, pieces: pieces, size: size, targets: targets, placed: placed, copied: copied, absent: absent.move(), traps: traps})
}

// Why a run stopped at `pc`, the plan's region mapped at `base`, when that is
// the trap of a runtime function (NativeFixPlan.absent): it needs that
// function, which the running image does not hold. None when no trap is
// there.
native_fix_absent_at: fn(plan: NativeFixPlan, base: Int, pc: Int) -> String? Never! {
    loop (symbol, place) in plan.absent {
        if base + plan.traps + NATIVE_FIX_TRAP * place == pc {
            return Val("it needs the runtime's `{symbol}`, which the running image does not hold: the program never needed it")
        }
    }
    None
}

// Where the plan's region, mapped at `base`, has `target`.
native_fix_address: fn(plan: NativeFixPlan, symbols: NativeFixSymbols, base: Int, target: X64RelocTarget) -> Int Never! {
    if target == {
        .Function(id) -> {
            if plan.placed.get(id.value) == .Val(row) {
                loop piece in plan.pieces {
                    if piece.function == row -> return base + piece.offset
                }
            }
        }
        .Data(id) -> {
            if plan.copied.get(id.value) == .Val(piece) -> return base + plan.pieces[piece].offset
        }
        .Runtime(symbol) -> {
            if plan.absent.get(symbol) == .Val(place) {
                return base + plan.traps + NATIVE_FIX_TRAP * place
            }
        }
        .RuntimeData(_) -> {}
    }
    if native_fix_known(plan.targets, target) == .Val(found) -> return found
    if target == {
        .Runtime(symbol) -> native_fix_runtime_address(symbols, symbol)
        .RuntimeData(symbol) -> native_fix_runtime_address(symbols, symbol)
        .Function(_) -> 0
        .Data(_) -> 0
    }
}

// Write the little-endian `value` over `size` bytes of `bytes` at `at`.
native_fix_put: fn(bytes: &[U8], at: Int, value: Int, size: Int) Never! {
    loop k in 0..<size -> bytes[at + k] = U8{(value >> (8 * k)) & 255}
}

// The bytes of the plan's region mapped at `base`, every relocation
// resolved.
native_fix_region: fn(plan: NativeFixPlan, edit: NativeFixEdit, symbols: NativeFixSymbols, base: Int) -> [U8] Never! {
    region := loop _ in 0..<plan.size -> U8{0}
    loop (_, place) in plan.absent {
        at: plan.traps + NATIVE_FIX_TRAP * place
        region[at] = U8{0x0f}
        region[at + 1] = U8{0x0b}
    }
    loop piece in plan.pieces {
        if piece.function >= 0 {
            function: edit.functions[piece.function]
            loop (k, byte) in function.code -> region[piece.offset + k] = byte
            loop reloc in function.relocs {
                at: piece.offset + reloc.at
                reached: native_fix_address(plan, symbols, base, reloc.target)
                native_fix_put(region, at, reached - (base + at + 4), 4)
            }
            next
        }
        object: edit.object.data[piece.data]
        loop (k, byte) in object.bytes -> region[piece.offset + k] = byte
        loop reloc in object.relocs {
            reached: native_fix_address(plan, symbols, base, X64RelocTarget.Data{id: reloc.target})
            native_fix_put(region, piece.offset + reloc.offset, reached + reloc.addend, 8)
        }
    }
    region
}

// Whether the code at `at` of `bytes` is a `syscall` (0f 05).
native_fix_is_syscall: fn(bytes: [U8], at: Int) -> Bool Never! {
    first: U8{0x0f}
    second: U8{0x05}
    at + 1 < bytes.len() && bytes[at] == first && bytes[at + 1] == second
}

// The `jmp rel32` at `from` to `to`, NATIVE_FIX_JUMP bytes.
native_fix_jump: fn(from: Int, to: Int) -> [U8] Never! {
    jump := [U8]{0xe9, 0, 0, 0, 0}
    native_fix_put(jump, 1, to - (from + NATIVE_FIX_JUMP), 4)
    jump
}

// The unsigned and signed LEB128 of `value`, onto `out`.
native_fix_uleb: fn(out: &[U8], value: Int) Never! {
    rest := value
    loop {
        byte: rest & 127
        rest = rest >> 7
        if rest == 0 {
            out.push(U8{byte})
            return
        }
        out.push(U8{byte | 128})
    }
}

native_fix_sleb: fn(out: &[U8], value: Int) Never! {
    rest := value
    loop {
        byte: rest & 127
        rest = rest >> 7
        done: (rest == 0 && byte & 64 == 0) || (rest == -1 && byte & 64 != 0)
        if done {
            out.push(U8{byte})
            return
        }
        out.push(U8{byte | 128})
    }
}

// Add the placed function `function` at `low` to the line table `lines`,
// named, filed and declared as `like` says, its rows from `debug`.
native_fix_lines: fn(lines: &X64Jetline, low: Int, size: Int, debug: X64FunctionDebug, name: String, file: String, dir: String, decl: Int) Never! {
    rows: lines.table.len()
    address := 0
    line := 1
    loop row in debug.lines {
        if row.line <= 0 -> next
        native_fix_uleb(lines.table, row.at - address)
        native_fix_sleb(lines.table, row.line - line)
        address = row.at
        line = row.line
    }
    lines.functions.push(X64JetlineFunction{low: low, high: low + size, name: name, file: file, dir: dir, decl: decl, rows: rows, rows_end: lines.table.len()})
}

// The address of the first row of `line` in `debug`, placed at `low`; None
// when no code is on it.
native_fix_line_address: fn(debug: X64FunctionDebug, low: Int, line: Int) -> Int? Never! {
    loop row in debug.lines {
        if row.line == line -> return Val(low + row.at)
    }
    None
}

#Test("a fix plan reads where unchanged code reaches its targets and finds what changed") {
    // main at 0x1000 calls p.run at 0x1020, which calls p.g at 0x1010:
    // `mov eax, 1`, `ret`.
    text := [U8]{0xe8, 0x1b, 0, 0, 0, 0xc3}
    loop text.len() < 16 -> text.push(U8{0x90})
    text.extend([U8]{0xb8, 1, 0, 0, 0, 0xc3})
    loop text.len() < 32 -> text.push(U8{0x90})
    text.extend([U8]{0xe8, 0xeb, 0xff, 0xff, 0xff, 0xc3})
    symbols := NativeFixSymbols{slots: [String:Int]{}, named: [[NativeFixSymbol]]{}}
    native_fix_symbol_add(symbols, "main", NativeFixSymbol{address: 0x1000, size: 6})
    native_fix_symbol_add(symbols, "p.g", NativeFixSymbol{address: 0x1010, size: 6})
    native_fix_symbol_add(symbols, "p.run", NativeFixSymbol{address: 0x1020, size: 6})
    image: NativeImage{lines: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, functions: [NativeFunction]{}, types: [Int:NativeType]{}, members: [[NativeMember]]{}, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: [U8]{}, abstracts: [Int:NativeAbstract]{}, allocs: [Int:Int]{}}
    call: [U8]{0xe8, 0, 0, 0, 0, 0xc3}
    main: X64CompiledFunction{id: X64FunctionID{value: -1}, name: "main", code: call, relocs: [X64Reloc]{X64Reloc{at: 1, target: X64RelocTarget.Function{id: X64FunctionID{value: 1}}}}, align: 16}
    run: X64CompiledFunction{id: X64FunctionID{value: 1}, name: "p.run", code: call, relocs: [X64Reloc]{X64Reloc{at: 1, target: X64RelocTarget.Function{id: X64FunctionID{value: 0}}}}, align: 16}
    same: X64CompiledFunction{id: X64FunctionID{value: 0}, name: "p.g", code: [U8]{0xb8, 1, 0, 0, 0, 0xc3}, relocs: [X64Reloc]{}, align: 16}
    edited: X64CompiledFunction{id: X64FunctionID{value: 0}, name: "p.g", code: [U8]{0xb8, 2, 0, 0, 0, 0xc3}, relocs: [X64Reloc]{}, align: 16}
    object: X64ObjectModule{data: [X64Data]{}, debug: X64ModuleDebug{directory: "", files: [String]{}, types: [X64DebugType]{}}, functions: [X64FunctionSource]{X64FunctionSource{name: "g", file: -1, line: 3, variables: [X64DebugVariable]{}}, X64FunctionSource{name: "run", file: -1, line: 6, variables: [X64DebugVariable]{}}}}
    rows: [X64FunctionDebug]{}
    unchanged: native_fix_plan(image, NativeFixEdit{object: object, functions: [X64CompiledFunction]{main, run, same}, debug: rows}, symbols, text, 0x1000, [NativeFixed]{}) ?? panic("refused: {err.detail}")
    assert_eq(unchanged.changed.len(), 0)
    plan: native_fix_plan(image, NativeFixEdit{object: object, functions: [X64CompiledFunction]{main, run, edited}, debug: rows}, symbols, text, 0x1000, [NativeFixed]{}) ?? panic("refused: {err.detail}")
    assert_eq(plan.changed, [Int]{2})
    assert_eq(native_fix_known(plan.targets, X64RelocTarget.Function{id: X64FunctionID{value: 0}}), Val(0x1010))
    region: native_fix_region(plan, NativeFixEdit{object: object, functions: [X64CompiledFunction]{main, run, edited}, debug: rows}, symbols, 0x40000000)
    assert_eq(region[1], U8{2})
    assert_eq(native_fix_jump(0x1010, 0x40000000), [U8]{0xe9, 0xeb, 0xef, 0xff, 0x3f})
}

#Test("same-named functions each match the code that runs them") {
    // main at 0x1020 (`ret`) and two functions named p.eq: `mov eax, 1`,
    // `ret` at 0x1000 and `mov eax, 2`, `ret` at 0x1010.
    text := [U8]{0xb8, 1, 0, 0, 0, 0xc3}
    loop text.len() < 16 -> text.push(U8{0x90})
    text.extend([U8]{0xb8, 2, 0, 0, 0, 0xc3})
    loop text.len() < 32 -> text.push(U8{0x90})
    text.push(U8{0xc3})
    symbols := NativeFixSymbols{slots: [String:Int]{}, named: [[NativeFixSymbol]]{}}
    native_fix_symbol_add(symbols, "p.eq", NativeFixSymbol{address: 0x1000, size: 6})
    native_fix_symbol_add(symbols, "p.eq", NativeFixSymbol{address: 0x1010, size: 6})
    native_fix_symbol_add(symbols, "main", NativeFixSymbol{address: 0x1020, size: 1})
    image: NativeImage{lines: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, functions: [NativeFunction]{}, types: [Int:NativeType]{}, members: [[NativeMember]]{}, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: [U8]{}, abstracts: [Int:NativeAbstract]{}, allocs: [Int:Int]{}}
    main: X64CompiledFunction{id: X64FunctionID{value: -1}, name: "main", code: [U8]{0xc3}, relocs: [X64Reloc]{}, align: 16}
    one: X64CompiledFunction{id: X64FunctionID{value: 0}, name: "p.eq", code: [U8]{0xb8, 1, 0, 0, 0, 0xc3}, relocs: [X64Reloc]{}, align: 16}
    two: X64CompiledFunction{id: X64FunctionID{value: 1}, name: "p.eq", code: [U8]{0xb8, 2, 0, 0, 0, 0xc3}, relocs: [X64Reloc]{}, align: 16}
    three: X64CompiledFunction{id: X64FunctionID{value: 1}, name: "p.eq", code: [U8]{0xb8, 3, 0, 0, 0, 0xc3}, relocs: [X64Reloc]{}, align: 16}
    object: X64ObjectModule{data: [X64Data]{}, debug: X64ModuleDebug{directory: "", files: [String]{}, types: [X64DebugType]{}}, functions: [X64FunctionSource]{X64FunctionSource{name: "eq", file: -1, line: 1, variables: [X64DebugVariable]{}}, X64FunctionSource{name: "eq", file: -1, line: 2, variables: [X64DebugVariable]{}}}}
    rows: [X64FunctionDebug]{}
    // In either order, each runs where its own code is.
    kept: native_fix_plan(image, NativeFixEdit{object: object, functions: [X64CompiledFunction]{main, one, two}, debug: rows}, symbols, text, 0x1000, [NativeFixed]{}) ?? panic("refused: {err.detail}")
    assert_eq(kept.changed.len(), 0)
    assert_eq(kept.running, [Int]{0x1020, 0x1000, 0x1010})
    swapped: native_fix_plan(image, NativeFixEdit{object: object, functions: [X64CompiledFunction]{main, two, one}, debug: rows}, symbols, text, 0x1000, [NativeFixed]{}) ?? panic("refused: {err.detail}")
    assert_eq(swapped.changed.len(), 0)
    assert_eq(swapped.running, [Int]{0x1020, 0x1010, 0x1000})
    // An edit of the second changes the one at its place.
    edited: native_fix_plan(image, NativeFixEdit{object: object, functions: [X64CompiledFunction]{main, one, three}, debug: rows}, symbols, text, 0x1000, [NativeFixed]{}) ?? panic("refused: {err.detail}")
    assert_eq(edited.changed, [Int]{2})
    assert_eq(edited.running[2], 0x1010)
    // Once a fix placed it, the program runs the edit there.
    fixed: [NativeFixed]{NativeFixed{name: "p.eq", address: 0x40000000, code: [U8]{0xb8, 3, 0, 0, 0, 0xc3}, was: 0x1010, parameters: ""}}
    again: native_fix_plan(image, NativeFixEdit{object: object, functions: [X64CompiledFunction]{main, one, three}, debug: rows}, symbols, text, 0x1000, fixed) ?? panic("refused: {err.detail}")
    assert_eq(again.changed.len(), 0)
    assert_eq(again.running, [Int]{0x1020, 0x1000, 0x40000000})
}

#Test("a fix that changes a function's parameters is refused while a caller's frame would pass the old ones") {
    // p.rounds at 0x1000 (and, as an earlier fix placed it, at 0x40000000)
    // calls p.score at 0x1010, which takes `round: Int`; the edit's p.score
    // also takes `bonus: Int`.
    types := [Int:NativeType]{}
    types[0x30] = NativeType{name: "I64", size: 8, tag: NATIVE_TAG_BASE, encoding: X64DebugEncoding.Signed, target: -1, group: -1}
    types[0x40] = NativeType{name: "", size: 8, tag: NATIVE_TAG_TYPEDEF, encoding: X64DebugEncoding.Signed, target: 0x50, group: -1}
    types[0x50] = NativeType{name: "Int", size: 8, tag: NATIVE_TAG_TYPEDEF, encoding: X64DebugEncoding.Signed, target: 0x30, group: -1}
    rounds_lines: X64JetlineFunction{low: 0x1000, high: 0x1006, name: "rounds", file: "prog.jet", dir: "", decl: 5, rows: 0, rows_end: 0}
    score_lines: X64JetlineFunction{low: 0x1010, high: 0x1016, name: "score", file: "prog.jet", dir: "", decl: 1, rows: 0, rows_end: 0}
    placed_lines: X64JetlineFunction{low: 0x40000000, high: 0x40000006, name: "rounds", file: "prog.jet", dir: "", decl: 5, rows: 0, rows_end: 0}
    round: NativeVariable{name: "round", line: 1, ty: 0x40, list: -1, base: 0, role: NativeVariableRole.Parameter, site: -1}
    score: NativeFunction{low: 0x1010, high: 0x1016, name: "score", file: 0, variables: [NativeVariable]{round}, inlined: [NativeInlined]{}}
    image: NativeImage{lines: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{rounds_lines, score_lines, placed_lines}}, functions: [NativeFunction]{score}, types: types, members: [[NativeMember]]{}, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: [U8]{}, abstracts: [Int:NativeAbstract]{}, allocs: [Int:Int]{}}
    call: [U8]{0xe8, 0, 0, 0, 0, 0xc3}
    main: X64CompiledFunction{id: X64FunctionID{value: -1}, name: "main", code: [U8]{0xc3}, relocs: [X64Reloc]{}, align: 16}
    rounds: X64CompiledFunction{id: X64FunctionID{value: 1}, name: "p.rounds", code: call, relocs: [X64Reloc]{X64Reloc{at: 1, target: X64RelocTarget.Function{id: X64FunctionID{value: 0}}}}, align: 16}
    scored: X64CompiledFunction{id: X64FunctionID{value: 0}, name: "p.score", code: [U8]{0xb8, 2, 0, 0, 0, 0xc3}, relocs: [X64Reloc]{}, align: 16}
    debug_types: [X64DebugType]{X64DebugType{name: "I64", size: 8, kind: X64DebugTypeKind.Base{encoding: X64DebugEncoding.Signed}}, X64DebugType{name: "Int", size: 8, kind: X64DebugTypeKind.Typedef{target: 0}}}
    widened: [X64DebugVariable]{X64DebugVariable{name: "round", ty: 1, line: 1, parameter: true, indirect: false}, X64DebugVariable{name: "bonus", ty: 1, line: 1, parameter: true, indirect: false}}
    kept: [X64DebugVariable]{X64DebugVariable{name: "round", ty: 1, line: 1, parameter: true, indirect: false}, X64DebugVariable{name: "made", ty: 1, line: 2, parameter: false, indirect: false}}
    rounds_source: X64FunctionSource{name: "rounds", file: -1, line: 5, variables: [X64DebugVariable]{}}
    edit: NativeFixEdit{object: X64ObjectModule{data: [X64Data]{}, debug: X64ModuleDebug{directory: "", files: [String]{}, types: debug_types}, functions: [X64FunctionSource]{X64FunctionSource{name: "score", file: -1, line: 1, variables: widened}, rounds_source}}, functions: [X64CompiledFunction]{main, rounds, scored}, debug: [X64FunctionDebug]{}}
    same: NativeFixEdit{object: X64ObjectModule{data: [X64Data]{}, debug: X64ModuleDebug{directory: "", files: [String]{}, types: debug_types}, functions: [X64FunctionSource]{X64FunctionSource{name: "score", file: -1, line: 1, variables: kept}, rounds_source}}, functions: [X64CompiledFunction]{main, rounds, scored}, debug: [X64FunctionDebug]{}}
    targets: NativeFixTargets{functions: [Int:Int]{}, data: [Int:Int]{}, runtime: [String:Int]{}, clashed: [String:Bool]{}}
    plan: NativeFixPlan{changed: [Int]{1, 2}, pieces: [NativeFixPiece]{}, size: 0, targets: targets, placed: [Int:Int]{}, copied: [Int:Int]{}, running: [Int]{0x1020, 0x1000, 0x1010}, lengths: [Int]{1, 6, 6}}
    assert_eq(native_fix_parameters(edit, 2), "round: Int, bonus: Int")
    assert_eq(native_fix_running_parameters(image, [NativeFixed]{}, 0x1010), Val("round: Int"))
    refused: Val("`score` changed its parameters from (round: Int) to (round: Int, bonus: Int), and `rounds`, on the stack, still passes the old ones")
    // A frame in `rounds`, or in its code an earlier fix replaced.
    assert_eq(native_fix_types(image, edit, plan, [NativeFixed]{}, [Int]{0x1012, 0x1004}), refused)
    assert_eq(native_fix_types(image, edit, plan, [NativeFixed]{}, [Int]{0x40000004}), refused)
    // No frame of `rounds`, or the same parameters: nothing passes old ones.
    assert_eq(native_fix_types(image, edit, plan, [NativeFixed]{}, [Int]{0x1012, 0x1020}), None)
    assert_eq(native_fix_types(image, same, plan, [NativeFixed]{}, [Int]{0x1012, 0x1004}), None)
}

#Test("an evaluation's call of a runtime function the image doesn't hold goes to a trap; a fix's is refused") {
    symbols: NativeFixSymbols{slots: [String:Int]{}, named: [[NativeFixSymbol]]{}}
    // `call rel32` to the runtime's jet_int_mul, `ret`.
    expression: X64CompiledFunction{id: X64FunctionID{value: 0}, name: "p.eval", code: [U8]{0xe8, 0, 0, 0, 0, 0xc3}, relocs: [X64Reloc]{X64Reloc{at: 1, target: X64RelocTarget.Runtime{symbol: "jet_int_mul"}}}, align: 16}
    object: X64ObjectModule{data: [X64Data]{}, debug: X64ModuleDebug{directory: "", files: [String]{}, types: [X64DebugType]{}}, functions: [X64FunctionSource]{X64FunctionSource{name: "eval", file: -1, line: 1, variables: [X64DebugVariable]{}}}}
    edit: NativeFixEdit{object: object, functions: [X64CompiledFunction]{expression}, debug: [X64FunctionDebug]{}}
    targets: NativeFixTargets{functions: [Int:Int]{}, data: [Int:Int]{}, runtime: [String:Int]{}, clashed: [String:Bool]{}}
    found: NativeFixPlan{changed: [Int]{}, pieces: [NativeFixPiece]{}, size: 0, targets: targets, placed: [Int:Int]{}, copied: [Int:Int]{}}
    plan: native_fix_place_all(edit, symbols, found, "p.eval") ?? panic("refused: {err.detail}")
    assert_eq(plan.absent.get("jet_int_mul"), Val(0))
    assert_eq(plan.traps, 6)
    region: native_fix_region(plan, edit, symbols, 0x40000000)
    // The call's rel32 reaches the trap, `ud2`, just past the `ret`.
    assert_eq(region[1], U8{1})
    assert_eq(region[6], U8{0x0f})
    assert_eq(region[7], U8{0x0b})
    assert_eq(native_fix_absent_at(plan, 0x40000000, 0x40000006), Val("it needs the runtime's `jet_int_mul`, which the running image does not hold: the program never needed it"))
    assert_eq(native_fix_absent_at(plan, 0x40000000, 0x40000005), None)
    row_of := [Int:Int]{}
    row_of[0] = 0
    refusal := ""
    if native_fix_lay_out(edit, symbols, targets, [Int]{0}, row_of, [Bool]{false}) == .Err(failed) {
        refusal = failed.detail
    }
    assert_eq(refusal, "`eval` now calls the runtime's `jet_int_mul`, which the running image does not hold")
}
