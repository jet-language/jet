use {
    jet_backend.[X64DebugEncoding, link_debug_uleb, x64_decode, x64_jetline_sleb]
    jet_foundation.[RUNTIME_C_EXPORTS]
}

// A breakpoint whose condition runs in the program itself: a hit where the
// condition is false goes on with no stop, so a breakpoint whose condition
// is false a million times costs a call each time, not a stop each time.
//
// The debugger replaces the first instructions at the breakpoint with a jump
// to a trampoline in a region it maps next to the program's code
// (NativeFix.jet places the condition's function and each function it calls
// there). The trampoline saves every register and the flags on the thread's
// own stack, below the red zone, then makes a frame the profiler's walk
// reads as called from the breakpoint, passes the condition its result cell
// and the address of each capture, and calls it. On false it puts every
// register back and runs the instructions the jump replaced, moved, then
// jumps back after them. On true it puts every register back and traps; the
// debugger reports the breakpoint with the thread at the breakpoint's
// address. The condition's allocations go to a scratch arena mapped in its
// region, which each hit empties as it starts; a hit that finds another
// thread using the arena, or fills it, calls out. The runtime's routines
// that build, render, compare and drop text (NATIVE_PLACE_PACKED) run from
// the runtime pack, placed afresh with the routines they reach
// (NativeFixPack.jet native_fix_pack_fresh), their allocations and frees
// sent to the arena too. Its other runtime calls (stop polls, stack
// growth, a slow path of exact Int arithmetic, a stop) all go to one stub
// that finds the trampoline's frame through the frame chain and traps a
// second way, after which the debugger checks that hit as an evaluation
// (NativeEval.jet), as it does a condition whose code can't be placed in
// the program's. JetIR EvalPlace.jet says which conditions may: the code
// placed writes nothing but its own stack, the blocks it allocates and the
// text it makes.
//
// A logpoint whose `{…}` parts each pass that scan runs in the program the
// same way, with no stop at each hit: its trampoline claims the next slot
// of a ring mapped in its region, takes a sequence number from a word the
// session's logpoints share, calls each part's code with its word of the
// slot as the result's place, then marks the slot written. A part that
// names a String local is read rather than called: the trampoline copies
// the String's length into the part's word and its text, up to
// NATIVE_PLACE_TEXT bytes, into the slot, at the hit. The hit that writes
// the last slot traps; the debugger then reads the ring, shows each hit's
// message in sequence order, and empties it. It reads every ring at each
// stop and at the program's exit too, so a message shows before the stop
// or the end that follows it.

// The trampoline's frame from its rbp C: C+0 the program's rbp, C+8 the
// breakpoint's address (a frame the walk reads as called from there), the
// result cell, xmm0-15, then each register by its DWARF number (7, rsp, as
// the program had it), the flags and the red zone.
NATIVE_PLACE_CELL: 16

NATIVE_PLACE_XMM: 32

NATIVE_PLACE_GPR: 288

NATIVE_PLACE_STACK: 552

// The bytes a jump at the breakpoint takes.
NATIVE_PLACE_JUMP: 5

// The x86 register of each DWARF register number 0-15.
NATIVE_PLACE_REGS: [Int]{0, 2, 1, 3, 6, 7, 5, 4, 8, 9, 10, 11, 12, 13, 14, 15}

// The registers the condition takes its captures in, after its cell in rdi:
// rsi, rdx, rcx, r8 and r9 (x86 numbers). A condition with more captures
// takes their addresses in a table, the table's address in rsi.
NATIVE_PLACE_ARGS: [Int]{6, 2, 1, 8, 9}

// What the debugger moves of one x86-64 instruction: its length, the offset
// of its rip-relative displacement (-1: none), its relative branch (the
// offset and size of the branch's field, -1 and 0 for none; `kind` is the
// branch's flow, Plain for an instruction without one, and a jcc's
// condition), and whether it is an indirect jump, whose target the debugger
// can't know.
NativeInsn: struct {
    length: Int,
    rip: Int,
    field: Int,
    width: Int,
    kind: X64Flow,
    cond: Int,
    indirect: Bool,
}

// Where a capture is at the breakpoint: in DWARF register `register`, or
// (`memory`) at that register's value plus `offset`, read once more when
// `deref` (DW_OP_deref).
NativePlaceArg: struct {
    register: Int,
    memory: Bool,
    offset: Int,
    deref: Bool,
}

// One call a trampoline makes: the entry of a condition, or of one `{…}`
// part of a logpoint's message, and where each of its captures is. A
// `text` part calls nothing: its one capture is a String local, whose
// length and text the trampoline copies into the hit's slot.
NativePlaceCall: struct {
    entry: Int,
    arguments: [NativePlaceArg],
    text: Bool{false},
}

// Where a placed logpoint's hits go: its ring at `address` (the slots the
// hits claimed, then the generation a slot's hit is written in), `slots`
// slots after that, and the session's sequence word `clock` that orders
// the hits of every logpoint. A slot holds each part's word, the
// generation once the hit's words are in, the hit's sequence number, then
// the text of each `text` part, in order (native_place_text_at).
NativePlaceRing: struct {
    address: Int,
    slots: Int,
    clock: Int,
}

// The ring's header: the claimed count, then the generation.
NATIVE_PLACE_RING_HEADER: 16

// The hits a logpoint's ring holds before the debugger drains it.
NATIVE_PLACE_RING_SLOTS: 65536

// The bytes of a String part's text a slot keeps; a longer one is cut
// there.
NATIVE_PLACE_TEXT: 120

// The bytes of a slot of a ring of logpoint parts `parts`, `texts` of them
// String parts read as text.
native_place_slot: fn(parts: Int, texts: Int) -> Int Never! {
    8 * (parts + 2) + NATIVE_PLACE_TEXT * texts
}

// Where in a slot of `parts` parts the text of its `index`th text part
// starts.
native_place_text_at: fn(parts: Int, index: Int) -> Int Never! { native_place_slot(parts, index) }

// A condition's scratch arena, after the logpoint's ring in its region: the
// take's words (NativeEval.jet NATIVE_EVAL_CURSOR, NATIVE_EVAL_END and
// NATIVE_EVAL_BASE), the word a hit claims it by, then its blocks, to
// NATIVE_PLACE_ARENA bytes in all.
NATIVE_PLACE_ARENA: 65536

NATIVE_PLACE_ARENA_BUSY: 32

NATIVE_PLACE_ARENA_WORDS: 64

// Which of the arena's entries a placed call's runtime call of `symbol`
// goes to (NativePlaceCode), by the name the runtime pack gives it: 0 the
// take, of jet_rt_alloc and jet_rt_alloc_value; 1 take_8, of their align-8
// entries and of a text's buffer; 2 the give, of jet_rt_free, jet_rt_free_8
// and a text's buffer; 3 a text buffer's growth, which leaves the old
// buffer to the give; 4 the answer 0, of the allocator a `#Context` block
// serves values from (none: the heap's entries, which are the arena's) and
// of a pending stop (none: an arena with no room calls out); -1 for any
// other, which calls out.
native_place_arena_route: fn(symbol: String) -> Int Never! {
    if {
        symbol == "jet_rt_alloc" || symbol == "jet_rt_alloc_value" -> 0
        symbol == "jet_rt_alloc_8" || symbol == "jet_rt_alloc_value_8" || symbol == "unit.alloc_bytes" -> 1
        symbol == "jet_rt_free" || symbol == "jet_rt_free_8" || symbol == "unit.free_bytes" -> 2
        symbol == "unit.alloc_grow_bytes" -> 3
        symbol == "unit.alloc_user_current" || symbol == "unit.scheduler_delivered_status" -> 4
        else -> -1
    }
}

// The runtime routines a placed call runs from the runtime pack, placed
// afresh (NativeFixPack.jet native_fix_pack_fresh): those that build,
// render, compare and drop text. Each writes only text it makes or is
// given to drop, which JetIR EvalPlace.jet keeps to text the code made.
// Each is one of the runtime's C exports (RUNTIME_C_EXPORTS), which
// NATIVE_PLACE_PACKED_CHECKED holds it to.
NATIVE_PLACE_PACKED: [String]{"jet_rt_string_builder_new", "jet_rt_string_builder_value", "jet_rt_string_builder_push", "jet_rt_string_builder_push_static", "jet_rt_string_builder_push_int", "jet_rt_string_builder_push_i64", "jet_rt_string_builder_push_u64", "jet_rt_string_builder_push_bool", "jet_rt_string_builder_push_char", "jet_rt_string_builder_finish", "jet_rt_string_serve", "jet_rt_string_from_static", "jet_rt_string_byte_len", "jet_rt_int_to_string", "jet_rt_i64_to_string", "jet_rt_u64_to_string", "jet_rt_bool_to_string", "jet_rt_char_to_string", "jet_rt_string_eq", "jet_rt_string_compare", "jet_rt_string_clone", "jet_rt_string_drop", "jet_string_contains", "jet_string_starts_with", "jet_string_ends_with"}

NATIVE_PLACE_PACKED_CHECKED: #run native_eval_exports_checked("NATIVE_PLACE_PACKED", NATIVE_PLACE_PACKED, RUNTIME_C_EXPORTS)

// The routines those reach that leave the placed code, so a call of one
// calls out: the runtime's stops, and the allocator's paths for a request
// the arena doesn't serve.
NATIVE_PLACE_OUT: [String]{"jet_rt_numeric_stop", "jet_rt_fixed_shift_stop", "jet_rt_unreachable", "unit.rt_seq_capacity_overflow_stop", "unit.alloc_grow_large", "unit.alloc_user_need"}

// Whether a routine the runtime pack names `symbol`, reached by the code of
// a routine of NATIVE_PLACE_PACKED, is the trampoline's rather than placed
// with it: one of the arena's (native_place_arena_route), one that leaves
// the placed code (NATIVE_PLACE_OUT) or an `#FFI(asm)` routine (a system
// call), which calls out.
native_place_routed: fn(symbol: String) -> Bool Never! {
    native_place_arena_route(symbol) >= 0 || NATIVE_PLACE_OUT.contains(symbol) || symbol.ends_with("__asm")
}

// Where in the trampoline `built` a runtime call of `symbol` goes: the
// arena's entry for it (native_place_arena_route), when it has an arena,
// else the stub, which calls out.
native_place_routine: fn(built: NativePlaceCode, symbol: String) -> Int Never! {
    route: native_place_arena_route(symbol)
    if {
        route == 0 && built.alloc >= 0 -> built.alloc
        route == 1 && built.alloc_8 >= 0 -> built.alloc_8
        route == 2 && built.free >= 0 -> built.free
        route == 3 && built.grow >= 0 -> built.grow
        route == 4 && built.zero >= 0 -> built.zero
        else -> built.out
    }
}

// A trampoline's code and the offsets in it of its two traps (the
// condition holds, or a logpoint's ring is full; it called out), the moved
// instructions and the stub its runtime calls go to. With an arena, the
// entries its allocations go to (`alloc`, of jet_rt_alloc(size, align) and
// jet_rt_alloc_value; `alloc_8`, of their align-8 entries, which take the
// size alone; `grow`, of a text buffer's growth, which takes the old
// buffer, then the size), its frees (`free`) and the answer 0 (`zero`); -1
// without one.
NativePlaceCode: struct {
    bytes: [U8],
    truth: Int,
    unknown: Int,
    moved: Int,
    moved_end: Int,
    out: Int,
    alloc: Int{-1},
    alloc_8: Int{-1},
    free: Int{-1},
    grow: Int{-1},
    zero: Int{-1},
}

// One placed condition or logpoint of the session: the breakpoint
// (`number`) and its address, the bytes the jump replaced, the addresses
// of the trampoline's two traps, of its moved instructions, of its runtime
// stub, and the region it and the code it calls take. A logpoint's ring
// (NativePlaceRing) is at `ring` (0 for a condition), of `slots` slots of
// `parts` words and `texts` texts. `live` is false once the jump is gone;
// the region stays, since a thread may still be in it. `traps` counts the
// hits that left the program for the debugger at one of its traps: the
// code keeps no state per thread or fiber, so that is a hit where the
// condition held, called out or filled the ring, never one on a thread or
// fiber new to it.
NativePlaced: struct {
    number: Int,
    address: Int,
    bytes: [U8],
    truth: Int,
    unknown: Int,
    moved: Int,
    moved_end: Int,
    out: Int,
    low: Int,
    high: Int,
    live: Bool,
    ring: Int{0},
    slots: Int{0},
    parts: Int{0},
    texts: Int{0},
    traps: Int{0},
}

// The instruction at `from` of `bytes`, or None when the debugger can't
// move it: past the end, bytes that start no instruction (x64_decode's
// "(bad)"), a 16-bit branch, loop and jrcxz (whose short branch has no long
// form).
native_decode: fn(bytes: [U8], from: Int) -> NativeInsn? Never! {
    insn: x64_decode(bytes, from, 0) ?? return None
    if insn.invalid || insn.flow == .Loop -> return None
    kind: if insn.width == 0 -> X64Flow.Plain else -> insn.flow
    Val(NativeInsn{length: insn.length, rip: insn.rip, field: insn.field, width: insn.width, kind: kind, cond: insn.cond, indirect: insn.indirect && insn.flow == .Jump})
}

// Where a relative branch at `at` of `bytes`, which runs at `address`, goes.
native_branch_target: fn(bytes: [U8], at: Int, address: Int, insn: NativeInsn) -> Int Never! {
    address + insn.length + native_number(bytes, at + insn.field, insn.width, X64DebugEncoding.Signed)
}

// The instructions from `at` of `bytes` the jump at a breakpoint replaces:
// whole instructions covering NATIVE_PLACE_JUMP bytes. None when one can't
// be read or moved: an indirect jump, or a call before the last.
native_displaced: fn(bytes: [U8], at: Int) -> [NativeInsn]? Never! {
    insns := [NativeInsn]{}
    covered := 0
    loop covered < NATIVE_PLACE_JUMP {
        insn: native_decode(bytes, at + covered) ?? return None
        if insn.indirect -> return None
        if insns.len() > 0 && insns[insns.len() - 1].kind == .Call -> return None
        covered += insn.length
        insns.push(insn)
    }
    Val(insns)
}

// Why the jump can't replace `length` bytes at offset `at` of a function
// whose code is `bytes` at `address`, "" when it can: its code must read as
// whole instructions with one starting at `at`, none an indirect jump, and
// no branch may land inside the bytes replaced.
native_place_refusal: fn(bytes: [U8], address: Int, at: Int, length: Int) -> String Never! {
    offset := 0
    boundary := false
    loop offset < bytes.len() {
        if offset == at -> boundary = true
        insn: native_decode(bytes, offset) ?? return "the debugger can't read its function's code"
        if insn.indirect -> return "its function jumps through a register"
        if insn.kind != .Plain {
            target: native_branch_target(bytes, offset, address + offset, insn)
            if target > address + at && target < address + at + length {
                return "its function jumps into the instructions a jump to the condition would replace"
            }
        }
        offset += insn.length
    }
    if boundary -> "" else -> "the debugger can't read its function's code"
}

// Whether `value` fits a signed 32-bit field.
native_place_near: fn(value: Int) -> Bool Never! { value >= -2147483648 && value <= 2147483647 }

native_place_emit: fn(out: &[U8], bytes: [Int]) Never! {
    loop byte in bytes -> out.push(U8{byte & 255})
}

native_place_word: fn(out: &[U8], value: Int, size: Int) Never! {
    loop k in 0..<size -> out.push(U8{(value >> (8 * k)) & 255})
}

// A rel32 field at `field` of `out` (which runs at `base`) to `target`;
// false when it can't reach.
native_place_rel: fn(out: &[U8], field: Int, base: Int, target: Int) -> Bool Never! {
    rel: target - (base + field + 4)
    if !native_place_near(rel) -> return false
    native_fix_put(out, field, rel, 4)
    true
}

// `insns` from `at` of `bytes`, which ran at `address`, rewritten to run at
// `base` + `out.len()` and appended to `out`, then a jump back to the
// instruction after them: a rip-relative operand keeps its target, a branch
// takes its rel32 form and a call pushes the return address it would have
// pushed and jumps. False when a target can't be reached from there.
native_moved: fn(out: &[U8], base: Int, bytes: [U8], at: Int, address: Int, insns: [NativeInsn]) -> Bool Never! {
    offset := at
    loop insn in insns {
        here: address + (offset - at)
        start: out.len()
        if insn.kind == {
            // native_decode gives no relative loop, return or stop.
            .Plain | .Loop | .Return | .Stop -> {
                loop index in offset..<offset + insn.length -> out.push(bytes[index])
                if insn.rip >= 0 {
                    target: here + insn.length + native_number(bytes, offset + insn.rip, 4, X64DebugEncoding.Signed)
                    moved: target - (base + start + insn.length)
                    if !native_place_near(moved) -> return false
                    native_fix_put(out, start + insn.rip, moved, 4)
                }
            }
            .Jump | .Cond | .Call -> {
                target: native_branch_target(bytes, offset, here, insn)
                if insn.kind == .Call {
                    back: here + insn.length
                    // lea rsp,[rsp-8]; mov dword [rsp],lo; mov dword [rsp+4],hi
                    native_place_emit(out, [Int]{0x48, 0x8d, 0x64, 0x24, 0xf8, 0xc7, 0x04, 0x24})
                    native_place_word(out, back, 4)
                    native_place_emit(out, [Int]{0xc7, 0x44, 0x24, 0x04})
                    native_place_word(out, back >> 32, 4)
                }
                if insn.kind == .Cond -> native_place_emit(out, [Int]{0x0f, 0x80 + insn.cond}) else {
                    out.push(0xe9)
                }
                field: out.len()
                native_place_word(out, 0, 4)
                if !native_place_rel(out, field, base, target) -> return false
            }
        }
        offset += insn.length
    }
    out.push(0xe9)
    field: out.len()
    native_place_word(out, 0, 4)
    native_place_rel(out, field, base, address + (offset - at))
}

// Puts every register and the flags back from the trampoline's frame (rbp),
// leaving rsp as the program had it.
native_place_restore: fn(out: &[U8]) Never! {
    loop k in 0..<16 {
        // movups xmmk,[rbp+NATIVE_PLACE_XMM+16k]
        if k >= 8 -> out.push(0x44)
        native_place_emit(out, [Int]{0x0f, 0x10, 0x85 | ((k & 7) << 3)})
        native_place_word(out, NATIVE_PLACE_XMM + 16 * k, 4)
    }
    // lea rsp,[rbp+NATIVE_PLACE_GPR]
    native_place_emit(out, [Int]{0x48, 0x8d, 0xa5})
    native_place_word(out, NATIVE_PLACE_GPR, 4)
    loop d in 0..<16 {
        reg: NATIVE_PLACE_REGS[d]
        if {
            d == 7 -> native_place_emit(out, [Int]{0x48, 0x8d, 0x64, 0x24, 0x08})
            reg >= 8 -> native_place_emit(out, [Int]{0x41, 0x58 + reg - 8})
            else -> out.push(U8{0x58 + reg})
        }
    }
    // popfq; lea rsp,[rsp+128]
    native_place_emit(out, [Int]{0x9d, 0x48, 0x8d, 0xa4, 0x24, 0x80, 0, 0, 0})
}

// The trampoline at breakpoint `address`, to run at `base`, of a condition
// (`ring` None: its one call's cell, on false running `insns`, from `at`
// of `bytes`, the code at `address`, moved) or of a logpoint: each hit
// claims a slot of `ring`, takes the next sequence number, has each call
// write its part's word in the slot, marks the slot written and runs the
// moved `insns`; the hit that fills the ring traps, and one finding it
// full goes to the debugger as a call out does. With an `arena` (its
// address, 0 for none: NATIVE_PLACE_ARENA), each hit first claims it and
// empties it, and gives it up once its calls return; a hit that finds it
// claimed goes to the debugger too. None when an entry or a moved
// instruction's target can't be reached, or a text part has no ring or
// not one capture.
native_place_code: fn(base: Int, address: Int, calls: [NativePlaceCall], ring: NativePlaceRing?, arena: Int, bytes: [U8], at: Int, insns: [NativeInsn]) -> NativePlaceCode? Never! {
    out := [U8]{}
    // lea rsp,[rsp-128]; pushfq; push each register, DWARF 15 down to 0
    native_place_emit(out, [Int]{0x48, 0x8d, 0x64, 0x24, 0x80, 0x9c})
    loop k in 0..<16 {
        reg: NATIVE_PLACE_REGS[15 - k]
        if reg >= 8 -> native_place_emit(out, [Int]{0x41, 0x50 + reg - 8}) else {
            out.push(U8{0x50 + reg})
        }
    }
    // sub rsp,NATIVE_PLACE_GPR; mov rbp,rsp
    native_place_emit(out, [Int]{0x48, 0x81, 0xec})
    native_place_word(out, NATIVE_PLACE_GPR, 4)
    native_place_emit(out, [Int]{0x48, 0x89, 0xe5})
    // [rbp] = the program's rbp; [rbp+8] = the breakpoint; rsp's slot = the
    // program's rsp; the cell = 0
    native_place_emit(out, [Int]{0x48, 0x8b, 0x85})
    native_place_word(out, NATIVE_PLACE_GPR + 8 * 6, 4)
    native_place_emit(out, [Int]{0x48, 0x89, 0x45, 0x00, 0x48, 0xb8})
    native_place_word(out, address, 8)
    native_place_emit(out, [Int]{0x48, 0x89, 0x45, 0x08, 0x48, 0x8d, 0x85})
    native_place_word(out, NATIVE_PLACE_STACK, 4)
    native_place_emit(out, [Int]{0x48, 0x89, 0x85})
    native_place_word(out, NATIVE_PLACE_GPR + 8 * 7, 4)
    native_place_emit(out, [Int]{0x48, 0xc7, 0x45, NATIVE_PLACE_CELL, 0, 0, 0, 0, 0x48, 0xc7, 0x45, NATIVE_PLACE_CELL + 8, 0, 0, 0, 0})
    loop k in 0..<16 {
        // movups [rbp+NATIVE_PLACE_XMM+16k],xmmk
        if k >= 8 -> out.push(0x44)
        native_place_emit(out, [Int]{0x0f, 0x11, 0x85 | ((k & 7) << 3)})
        native_place_word(out, NATIVE_PLACE_XMM + 16 * k, 4)
    }
    if ring == None && calls.len() != 1 -> return None
    parts: calls.len()
    texts := 0
    loop call in calls {
        if call.text -> texts += 1
    }
    slot: native_place_slot(parts, texts)
    // The arena's claim: movabs r11,arena; xor eax,eax; mov ecx,1;
    // lock cmpxchg [r11+busy],rcx; jne contended (patched once known);
    // then it empties: mov rax,[r11+base]; mov [r11+cursor],rax
    contended := -1
    if arena != 0 {
        native_eval_r11(out, arena)
        native_place_emit(out, [Int]{0x31, 0xc0, 0xb9, 1, 0, 0, 0, 0xf0, 0x49, 0x0f, 0xb1, 0x4b, NATIVE_PLACE_ARENA_BUSY, 0x0f, 0x85})
        contended = out.len()
        native_place_word(out, 0, 4)
        native_place_emit(out, [Int]{0x49, 0x8b, 0x43, NATIVE_EVAL_BASE, 0x49, 0x89, 0x43, NATIVE_EVAL_CURSOR})
    }
    full := -1
    if ring == .Val(log) {
        // The claim: movabs rax,ring; mov rcx,1; lock xadd [rax],rcx;
        // cmp rcx,slots; jae out (patched once `abort` is known)
        native_place_emit(out, [Int]{0x48, 0xb8})
        native_place_word(out, log.address, 8)
        native_place_emit(out, [Int]{0x48, 0xc7, 0xc1, 1, 0, 0, 0, 0xf0, 0x48, 0x0f, 0xc1, 0x08, 0x48, 0x81, 0xf9})
        native_place_word(out, log.slots, 4)
        native_place_emit(out, [Int]{0x0f, 0x83})
        full = out.len()
        native_place_word(out, 0, 4)
        // The cell holds the slot's index, then its address:
        // mov [rbp+cell],rcx; imul rcx,rcx,slot; lea rcx,[rax+rcx+header];
        // mov [rbp+cell+8],rcx
        native_place_emit(out, [Int]{0x48, 0x89, 0x4d, NATIVE_PLACE_CELL, 0x48, 0x69, 0xc9})
        native_place_word(out, slot, 4)
        native_place_emit(out, [Int]{0x48, 0x8d, 0x4c, 0x08, NATIVE_PLACE_RING_HEADER, 0x48, 0x89, 0x4d, NATIVE_PLACE_CELL + 8})
        // The sequence number: movabs rax,clock; mov rdx,1;
        // lock xadd [rax],rdx; mov [rcx+8*parts+8],rdx
        native_place_emit(out, [Int]{0x48, 0xb8})
        native_place_word(out, log.clock, 8)
        native_place_emit(out, [Int]{0x48, 0xc7, 0xc2, 1, 0, 0, 0, 0xf0, 0x48, 0x0f, 0xc1, 0x10, 0x48, 0x89, 0x91})
        native_place_word(out, 8 * parts + 8, 4)
    }
    back := 0
    read := 0
    loop (index, call) in calls {
        if call.text {
            if ring == None || call.arguments.len() != 1 -> return None
            // The String's header (rax: its word's address, then the word);
            // its length into the part's word, then up to
            // NATIVE_PLACE_TEXT bytes of its text into the slot:
            // mov rax,[rax]; mov rsi,[rax]; mov rdx,[rax+8];
            // mov rdi,[rbp+cell+8]; mov [rdi+8*index],rdx;
            // mov ecx,NATIVE_PLACE_TEXT; cmp rdx,rcx; cmovb rcx,rdx;
            // add rdi,text; cld; rep movsb
            native_place_capture(out, call.arguments[0], 0)
            native_place_emit(out, [Int]{0x48, 0x8b, 0x00, 0x48, 0x8b, 0x30, 0x48, 0x8b, 0x50, 0x08, 0x48, 0x8b, 0x7d, NATIVE_PLACE_CELL + 8, 0x48, 0x89, 0x97})
            native_place_word(out, 8 * index, 4)
            out.push(0xb9)
            native_place_word(out, NATIVE_PLACE_TEXT, 4)
            native_place_emit(out, [Int]{0x48, 0x39, 0xca, 0x48, 0x0f, 0x42, 0xca, 0x48, 0x81, 0xc7})
            native_place_word(out, native_place_text_at(parts, read), 4)
            native_place_emit(out, [Int]{0xfc, 0xf3, 0xa4})
            read += 1
            next
        }
        // The result's place: the cell, or the part's word of the slot
        // (mov rdi,[rbp+cell+8]; add rdi,8*index); then each capture's
        // address
        if ring == None -> native_place_emit(out, [Int]{0x48, 0x8d, 0x7d, NATIVE_PLACE_CELL}) else {
            native_place_emit(out, [Int]{0x48, 0x8b, 0x7d, NATIVE_PLACE_CELL + 8, 0x48, 0x81, 0xc7})
            native_place_word(out, 8 * index, 4)
        }
        // More captures than registers go by a table of their addresses on
        // the stack, its address in rsi, as the condition was compiled to
        // take them (NativeEval.jet NATIVE_EVAL_CAPTURES): and rsp,-16;
        // sub rsp,table
        table: call.arguments.len() > NATIVE_EVAL_CAPTURES
        if table {
            native_place_emit(out, [Int]{0x48, 0x83, 0xe4, 0xf0, 0x48, 0x81, 0xec})
            native_place_word(out, ((8 * call.arguments.len() + 15) >> 4) << 4, 4)
        }
        loop (k, argument) in call.arguments {
            native_place_capture(out, argument, if table -> 0 else -> NATIVE_PLACE_ARGS[k])
            // a table's row: mov [rsp+8k],rax
            if table {
                native_place_emit(out, [Int]{0x48, 0x89, 0x84, 0x24})
                native_place_word(out, 8 * k, 4)
            }
        }
        // mov rsi,rsp
        if table -> native_place_emit(out, [Int]{0x48, 0x89, 0xe6})
        // and rsp,-16; call entry; mov rsp,rbp
        native_place_emit(out, [Int]{0x48, 0x83, 0xe4, 0xf0, 0xe8})
        field: out.len()
        native_place_word(out, 0, 4)
        if !native_place_rel(out, field, base, call.entry) -> return None
        if back == 0 -> back = out.len()
        native_place_emit(out, [Int]{0x48, 0x89, 0xec})
    }
    if arena != 0 -> native_place_free_arena(out, arena)
    if ring == .Val(log) {
        // Written: movabs rax,ring; mov rdx,[rax+8]; mov rcx,[rbp+cell+8];
        // mov [rcx+8*parts],rdx; then the last slot traps:
        // cmp qword [rbp+cell],slots-1; je trap
        native_place_emit(out, [Int]{0x48, 0xb8})
        native_place_word(out, log.address, 8)
        native_place_emit(out, [Int]{0x48, 0x8b, 0x50, 0x08, 0x48, 0x8b, 0x4d, NATIVE_PLACE_CELL + 8, 0x48, 0x89, 0x91})
        native_place_word(out, 8 * parts, 4)
        native_place_emit(out, [Int]{0x48, 0x81, 0x7d, NATIVE_PLACE_CELL})
        native_place_word(out, log.slots - 1, 4)
        native_place_emit(out, [Int]{0x0f, 0x84})
    }
    // cmp byte [rbp+cell],0; jne trap
    if ring == None -> native_place_emit(out, [Int]{0x80, 0x7d, NATIVE_PLACE_CELL, 0, 0x0f, 0x85})
    holds: out.len()
    native_place_word(out, 0, 4)
    native_place_restore(out)
    out.push(0xe9)
    run_on: out.len()
    native_place_word(out, 0, 4)
    native_fix_put(out, holds, out.len() - (holds + 4), 4)
    native_place_restore(out)
    // Each trap is followed by a jump to the moved instructions, which runs
    // once the debugger lets the program go untraced (detach puts a nop in
    // the trap's place).
    truth: out.len()
    native_place_emit(out, [Int]{0xcc, 0xe9})
    held_on: out.len()
    native_place_word(out, 0, 4)
    // Called out, or a logpoint's ring full: mov rsp,rbp, the arena given
    // up, then as the condition had held. A hit that found the arena
    // claimed has rsp at rbp already and gives up none.
    abort: out.len()
    if full >= 0 -> native_fix_put(out, full, abort - (full + 4), 4)
    native_place_emit(out, [Int]{0x48, 0x89, 0xec})
    if arena != 0 -> native_place_free_arena(out, arena)
    if contended >= 0 -> native_fix_put(out, contended, out.len() - (contended + 4), 4)
    native_place_restore(out)
    unknown: out.len()
    native_place_emit(out, [Int]{0xcc, 0xe9})
    unknown_on: out.len()
    native_place_word(out, 0, 4)
    moved: out.len()
    loop field in ([Int]{run_on, held_on, unknown_on}) {
        native_fix_put(out, field, moved - (field + 4), 4)
    }
    if !native_moved(out, base, bytes, at, address, insns) -> return None
    moved_end: out.len()
    // The runtime stub: walk the frame chain from rbp to the condition's
    // entry frame (its return address is `back`) or the trampoline's own
    // frame (the breakpoint's address), set rbp to the trampoline's frame
    // and go to `abort`.
    stub: out.len()
    native_place_emit(out, [Int]{0x48, 0x89, 0xe8, 0x49, 0xbb})
    native_place_word(out, base + back, 8)
    native_place_emit(out, [Int]{0x49, 0xba})
    native_place_word(out, address, 8)
    // cmp [rax+8],r11; je entry; cmp [rax+8],r10; je own; mov rax,[rax]; jmp
    native_place_emit(out, [Int]{0x4c, 0x39, 0x58, 0x08, 0x74, 0x0b, 0x4c, 0x39, 0x50, 0x08, 0x74, 0x0d, 0x48, 0x8b, 0x00, 0xeb, 0xef})
    // entry: mov rbp,[rax]; jmp abort
    native_place_emit(out, [Int]{0x48, 0x8b, 0x28, 0xe9})
    first: out.len()
    native_place_word(out, abort - (first + 4), 4)
    // own: mov rbp,rax; jmp abort
    native_place_emit(out, [Int]{0x48, 0x89, 0xc5, 0xe9})
    second: out.len()
    native_place_word(out, abort - (second + 4), 4)
    if arena == 0 {
        return Val(NativePlaceCode{bytes: out, truth: truth, unknown: unknown, moved: moved, moved_end: moved_end, out: stub})
    }
    // The arena's entries. grow: mov rdi,rsi (the size, past the old
    // buffer); then alloc_8: mov esi,8; then alloc: call the take
    // (NativeEval.jet native_eval_take_code, past the 10 bytes that
    // follow the call); test rax,rax; je stub; ret. An arena with no room
    // left calls out.
    grow: out.len()
    native_place_emit(out, [Int]{0x48, 0x89, 0xf7})
    alloc_8: out.len()
    native_place_emit(out, [Int]{0xbe, 8, 0, 0, 0})
    alloc: out.len()
    out.push(0xe8)
    native_place_word(out, 10, 4)
    native_place_emit(out, [Int]{0x48, 0x85, 0xc0, 0x0f, 0x84})
    no_room: out.len()
    native_place_word(out, stub - (no_room + 4), 4)
    out.push(0xc3)
    out.extend(native_eval_take_code(arena))
    // free: a block of the arena is left be (the next hit empties it); a
    // free of any other is the program's memory, so the hit calls out:
    // movabs r11,arena; cmp rdi,[r11+base]; jb stub; cmp rdi,[r11+end];
    // jae stub; then zero: xor eax,eax; ret
    free: out.len()
    native_eval_r11(out, arena)
    native_place_emit(out, [Int]{0x49, 0x3b, 0x7b, NATIVE_EVAL_BASE, 0x0f, 0x82})
    below: out.len()
    native_place_word(out, stub - (below + 4), 4)
    native_place_emit(out, [Int]{0x49, 0x3b, 0x7b, NATIVE_EVAL_END, 0x0f, 0x83})
    past: out.len()
    native_place_word(out, stub - (past + 4), 4)
    zero: out.len()
    native_place_emit(out, [Int]{0x31, 0xc0, 0xc3})
    Val(NativePlaceCode{bytes: out, truth: truth, unknown: unknown, moved: moved, moved_end: moved_end, out: stub, alloc: alloc, alloc_8: alloc_8, free: free, grow: grow, zero: zero})
}

// Gives up the arena at `arena` (native_place_code): movabs r11,arena;
// mov qword [r11+busy],0.
native_place_free_arena: fn(out: &[U8], arena: Int) Never! {
    native_eval_r11(out, arena)
    native_place_emit(out, [Int]{0x49, 0xc7, 0x43, NATIVE_PLACE_ARENA_BUSY, 0, 0, 0, 0})
}

// The address of a capture's bytes into x86 register `reg`: a register's
// saved slot (lea R,[rbp+saved]), or memory at one (mov R,[rbp+saved];
// lea R,[R+offset]), read once more (mov R,[R]) when it says so.
native_place_capture: fn(out: &[U8], argument: NativePlaceArg, reg: Int) Never! {
    high: if reg >= 8 -> 4 else -> 0
    low: reg & 7
    saved: NATIVE_PLACE_GPR + 8 * argument.register
    native_place_emit(out, [Int]{0x48 | high, if argument.memory -> 0x8b else -> 0x8d, 0x85 | (low << 3)})
    native_place_word(out, saved, 4)
    if argument.memory {
        native_place_emit(out, [Int]{0x48 | high | (high >> 2), 0x8d, 0x80 | (low << 3) | low})
        native_place_word(out, argument.offset, 4)
    }
    if argument.deref {
        native_place_emit(out, [Int]{0x48 | high | (high >> 2), 0x8b, (low << 3) | low})
    }
}

// The jump at a breakpoint `address` to a trampoline at `target`, padded
// with int3 to `length` bytes; empty when it can't reach.
native_place_jump: fn(address: Int, target: Int, length: Int) -> [U8] Never! {
    out := [U8]{0xe9}
    native_place_word(out, 0, 4)
    if !native_place_rel(out, 1, address, target) -> return [U8]{}
    loop out.len() < length -> out.push(0xcc)
    out
}

// Where a capture is at the breakpoint, from its DWARF location expression
// `expression`: a register, or a register (DW_OP_breg, DW_OP_bregx,
// DW_OP_fbreg through rbp) plus an offset, maybe read once more
// (DW_OP_deref). None for any other.
native_place_arg: fn(expression: [U8]) -> NativePlaceArg? Never! {
    if expression.len() == 0 -> return None
    op: Int{expression[0]}
    if op >= 0x50 && op <= 0x5f && expression.len() == 1 {
        return Val(NativePlaceArg{register: op - 0x50, memory: false, offset: 0, deref: false})
    }
    register := -1
    at := 1
    if {
        op >= 0x70 && op <= 0x7f -> register = op - 0x70
        op == 0x91 -> register = 6
        op == 0x92 -> register = link_debug_uleb(expression, at)
        else -> return None
    }
    if register < 0 || register > 15 || at >= expression.len() -> return None
    offset: x64_jetline_sleb(expression, at)
    deref: at < expression.len() && expression[at] == 0x06
    if deref -> at += 1
    if at != expression.len() -> return None
    Val(NativePlaceArg{register: register, memory: true, offset: offset, deref: deref})
}

#Test("the decoder reads each instruction's length, rip-relative field and branch") {
    // mov rax,[rbp-8]; mov rax,[rip+0x10]; jne +5; call rel32; jmp rel8
    code: [U8]{0x48, 0x8b, 0x45, 0xf8, 0x48, 0x8b, 0x05, 0x10, 0, 0, 0, 0x75, 0x05, 0xe8, 1, 0, 0, 0, 0xeb, 0xfe}
    first: native_decode(code, 0) ?? panic("first")
    assert_eq(first.length, 4)
    assert_eq(first.rip, -1)
    second: native_decode(code, 4) ?? panic("second")
    assert_eq(second.length, 7)
    assert_eq(second.rip, 3)
    third: native_decode(code, 11) ?? panic("third")
    assert_eq(third.length, 2)
    assert(third.kind == X64Flow.Cond)
    assert_eq(third.cond, 5)
    assert_eq(native_branch_target(code, 11, 0x1000 + 11, third), 0x1000 + 18)
    call: native_decode(code, 13) ?? panic("call")
    assert(call.kind == X64Flow.Call)
    assert_eq(call.length, 5)
    // movabs rax,imm64; sub rsp,imm32; movups xmm8,[rbp+0x20]; vmovdqu ymm0,[rsi]
    more: [U8]{0x48, 0xb8, 1, 2, 3, 4, 5, 6, 7, 8, 0x48, 0x81, 0xec, 0x20, 1, 0, 0, 0x44, 0x0f, 0x10, 0x45, 0x20, 0xc5, 0xfe, 0x6f, 0x06}
    assert_eq((native_decode(more, 0) ?? panic("movabs")).length, 10)
    assert_eq((native_decode(more, 10) ?? panic("sub")).length, 7)
    assert_eq((native_decode(more, 17) ?? panic("movups")).length, 5)
    assert_eq((native_decode(more, 22) ?? panic("vex")).length, 4)
    // test byte [rax],1 (F6 /0 ib); jmp [rax] (FF /4); loop
    assert_eq((native_decode([U8]{0xf6, 0x00, 0x01}, 0) ?? panic("test")).length, 3)
    assert((native_decode([U8]{0xff, 0x20}, 0) ?? panic("jmp")).indirect)
    assert(native_decode([U8]{0xe2, 0xfe}, 0) == None)
}

#Test("the jump replaces whole instructions, and no branch may land inside them") {
    // push rbp; mov rbp,rsp; sub rsp,16; jmp back to the mov
    code: [U8]{0x55, 0x48, 0x89, 0xe5, 0x48, 0x83, 0xec, 0x10, 0xeb, 0xf7}
    insns: native_displaced(code, 0) ?? panic("displaced")
    assert_eq(insns.len(), 3)
    assert_eq(insns[0].length + insns[1].length + insns[2].length, 1 + 3 + 4)
    assert_eq(native_place_refusal(code, 0x1000, 4, 4), "")
    assert_eq(native_place_refusal(code, 0x1000, 0, 5), "its function jumps into the instructions a jump to the condition would replace")
    assert_eq(native_place_refusal(code, 0x1000, 2, 5), "the debugger can't read its function's code")
}

#Test("moved instructions keep their targets") {
    // mov rax,[rip+0x100]; jne -2 at 0x1000, both moved to 0x2000
    code: [U8]{0x48, 0x8b, 0x05, 0x00, 0x01, 0, 0, 0x75, 0xfe}
    insns: [NativeInsn]{native_decode(code, 0) ?? panic("load"), native_decode(code, 7) ?? panic("jne")}
    out := [U8]{}
    assert(native_moved(out, 0x2000, code, 0, 0x1000, insns))
    // The load reads 0x1107 from 0x2007: rip+0x-F00.
    assert_eq(native_number(out, 3, 4, X64DebugEncoding.Signed), 0x1107 - 0x2007)
    // jne rel32 to 0x1007, then jmp back to 0x1009.
    assert_eq(Int{out[7]}, 0x0f)
    assert_eq(Int{out[8]}, 0x85)
    assert_eq(native_number(out, 9, 4, X64DebugEncoding.Signed), 0x1007 - 0x200d)
    assert_eq(Int{out[13]}, 0xe9)
    assert_eq(native_number(out, 14, 4, X64DebugEncoding.Signed), 0x1009 - 0x2012)
}

#Test("a capture's place is a register or a register plus an offset") {
    assert((native_place_arg([U8]{0x53}) ?? panic("reg")).register == 3)
    frame: native_place_arg([U8]{0x91, 0x70}) ?? panic("fbreg")
    assert_eq(frame.register, 6)
    assert_eq(frame.offset, -16)
    assert(frame.memory && !frame.deref)
    held: native_place_arg([U8]{0x76, 0x08, 0x06}) ?? panic("breg")
    assert(held.deref)
    assert(native_place_arg([U8]{0x76, 0x08, 0x9f}) == None)
}

#Test("the trampoline calls the condition and its traps and stub are where it says") {
    code: [U8]{0x55, 0x48, 0x89, 0xe5, 0x90}
    insns: native_displaced(code, 0) ?? panic("displaced")
    arguments: [NativePlaceArg]{NativePlaceArg{register: 6, memory: true, offset: -8, deref: false}}
    placed: native_place_code(0x200000, 0x1000, [NativePlaceCall]{NativePlaceCall{entry: 0x201000, arguments: arguments}}, None, 0, code, 0, insns) ?? panic("code")
    assert_eq(Int{placed.bytes[placed.truth]}, 0xcc)
    assert_eq(Int{placed.bytes[placed.unknown]}, 0xcc)
    assert_eq(Int{placed.bytes[placed.moved]}, 0x55)
    assert_eq(Int{placed.bytes[placed.moved_end - 5]}, 0xe9)
    assert_eq(Int{placed.bytes[placed.out]}, 0x48)
    // Past each trap, a jump to the moved instructions.
    assert_eq(native_number(placed.bytes, placed.truth + 2, 4, X64DebugEncoding.Signed), placed.moved - (placed.truth + 6))
    assert_eq(native_number(placed.bytes, placed.unknown + 2, 4, X64DebugEncoding.Signed), placed.moved - (placed.unknown + 6))
    // The stub's walk: its loop's last jump goes back to its first compare.
    walk: placed.out + 3 + 10 + 10
    assert_eq(Int{placed.bytes[walk + 15]}, 0xeb)
    assert_eq(Int{placed.bytes[walk + 11]} + walk + 12, walk + 25)
    jump: native_place_jump(0x1000, 0x200000, 5)
    assert_eq(jump.len(), 5)
    assert_eq(native_number(jump, 1, 4, X64DebugEncoding.Signed), 0x200000 - 0x1005)
}

#Test("a condition with more captures than registers takes a table of their addresses") {
    code: [U8]{0x55, 0x48, 0x89, 0xe5, 0x90}
    insns: native_displaced(code, 0) ?? panic("displaced")
    arguments: loop k in 0..<6 -> NativePlaceArg{register: 6, memory: true, offset: -8 * (k + 1), deref: false}
    placed: native_place_code(0x200000, 0x1000, [NativePlaceCall]{NativePlaceCall{entry: 0x201000, arguments: arguments}}, None, 0, code, 0, insns) ?? panic("code")
    bytes: placed.bytes
    // and rsp,-16; sub rsp,48: the table's six rows, aligned
    table: native_place_find(bytes, [Int]{0x48, 0x83, 0xe4, 0xf0, 0x48, 0x81, 0xec, 48, 0, 0, 0})
    assert(table > 0)
    // The sixth capture's address, mov rax,[rbp+rbp's slot]; lea rax,[rax-48],
    // is the table's last row: mov [rsp+40],rax
    sixth: native_place_find(bytes, [Int]{0x48, 0x8d, 0x80, 0xd0, 0xff, 0xff, 0xff, 0x48, 0x89, 0x84, 0x24, 40, 0, 0, 0})
    assert(sixth > table)
    // Then rsi holds the table and the call follows: mov rsi,rsp; and rsp,-16; call
    assert_eq(native_place_find(bytes, [Int]{0x48, 0x89, 0xe6, 0x48, 0x83, 0xe4, 0xf0, 0xe8}), sixth + 15)
    // No capture goes to an argument register.
    assert_eq(native_place_find(bytes, [Int]{0x48, 0x8b, 0xb5}), -1)
}

// Where `wanted` first starts in `bytes`; -1 when nowhere.
native_place_find: fn(bytes: [U8], wanted: [Int]) -> Int Never! {
    loop k in 0..<bytes.len() - wanted.len() + 1 {
        same := true
        loop (j, byte) in wanted {
            got: Int{bytes[k + j]}
            if got != byte {
                same = false
                break
            }
        }
        if same -> return k
    }
    -1
}

#Test("a logpoint's trampoline claims a slot, has each part write its word there, and traps on the last") {
    code: [U8]{0x55, 0x48, 0x89, 0xe5, 0x90}
    insns: native_displaced(code, 0) ?? panic("displaced")
    calls: [NativePlaceCall]{NativePlaceCall{entry: 0x201000, arguments: [NativePlaceArg]{}}, NativePlaceCall{entry: 0x201100, arguments: [NativePlaceArg]{}}}
    ring: NativePlaceRing{address: 0x300000, slots: 4, clock: 0x300100}
    placed: native_place_code(0x200000, 0x1000, calls, Val(ring), 0, code, 0, insns) ?? panic("code")
    bytes: placed.bytes
    // The claim's lock xadd, then its jae to the path that calls out once
    // the ring is full: mov rsp,rbp and every register put back, then the
    // trap that leaves the hit to the debugger.
    claim: native_place_find(bytes, [Int]{0xf0, 0x48, 0x0f, 0xc1, 0x08})
    assert(claim > 0)
    full: claim + 5 + 7 + 2
    abort: full + 4 + native_number(bytes, full, 4, X64DebugEncoding.Signed)
    assert_eq(native_place_find(bytes[abort..<abort + 3], [Int]{0x48, 0x89, 0xec}), 0)
    restore := [U8]{}
    native_place_restore(restore)
    assert_eq(abort + 3 + restore.len(), placed.unknown)
    // The second part writes the slot's second word.
    assert(native_place_find(bytes, [Int]{0x48, 0x8b, 0x7d, NATIVE_PLACE_CELL + 8, 0x48, 0x81, 0xc7, 8, 0, 0, 0}) > claim)
    // The hit in the last slot traps once it is written.
    last: native_place_find(bytes, [Int]{0x48, 0x81, 0x7d, NATIVE_PLACE_CELL, 3, 0, 0, 0, 0x0f, 0x84}) + 10
    assert_eq(last + 4 + native_number(bytes, last, 4, X64DebugEncoding.Signed) + restore.len(), placed.truth)
    assert_eq(native_place_slot(2, 0), 32)
}

#Test("a condition that allocates claims its arena, empties it and gives it up; its allocations take from it") {
    code: [U8]{0x55, 0x48, 0x89, 0xe5, 0x90}
    insns: native_displaced(code, 0) ?? panic("displaced")
    calls: [NativePlaceCall]{NativePlaceCall{entry: 0x201000, arguments: [NativePlaceArg]{}}}
    placed: native_place_code(0x200000, 0x1000, calls, None, 0x400000, code, 0, insns) ?? panic("code")
    bytes: placed.bytes
    restore := [U8]{}
    native_place_restore(restore)
    // The claim's lock cmpxchg, then its jne past the arena's release on
    // the path that calls out: a hit that finds it claimed gives up none.
    claim: native_place_find(bytes, [Int]{0xf0, 0x49, 0x0f, 0xb1, 0x4b, NATIVE_PLACE_ARENA_BUSY, 0x0f, 0x85})
    assert(claim > 0)
    contended: claim + 8
    assert_eq(contended + 4 + native_number(bytes, contended, 4, X64DebugEncoding.Signed) + restore.len(), placed.unknown)
    // Then it empties: the cursor goes back to the base.
    assert_eq(native_place_find(bytes, [Int]{0x49, 0x8b, 0x43, NATIVE_EVAL_BASE, 0x49, 0x89, 0x43, NATIVE_EVAL_CURSOR}), contended + 4)
    // The release follows the call, and again on the path that calls out.
    release: [Int]{0x49, 0xc7, 0x43, NATIVE_PLACE_ARENA_BUSY, 0, 0, 0, 0}
    first: native_place_find(bytes, release)
    assert(first > claim)
    assert(native_place_find(bytes[first + 8..<bytes.len()], release) >= 0)
    // grow moves the size into place, alloc_8 sets the align, then alloc
    // calls the take past its own tail.
    assert_eq(placed.alloc_8, placed.grow + 3)
    assert_eq(Int{bytes[placed.grow + 2]}, 0xf7)
    assert_eq(Int{bytes[placed.alloc_8]}, 0xbe)
    assert_eq(placed.alloc, placed.alloc_8 + 5)
    assert_eq(Int{bytes[placed.alloc]}, 0xe8)
    taken: native_eval_take_code(0x400000)
    core: placed.alloc + 5 + native_number(bytes, placed.alloc + 1, 4, X64DebugEncoding.Signed)
    assert_eq(native_place_find(bytes[core..<core + taken.len()], [Int]{0x49, 0xbb}), 0)
    // No room calls out: je stub.
    assert_eq(placed.alloc + 10 + 4 + native_number(bytes, placed.alloc + 10, 4, X64DebugEncoding.Signed), placed.out)
    // A free of a block past the arena calls out too; one inside it
    // answers 0, as zero does.
    assert(placed.free > core)
    assert_eq(placed.free + 16 + 4 + native_number(bytes, placed.free + 16, 4, X64DebugEncoding.Signed), placed.out)
    assert_eq(placed.zero, placed.free + 30)
    assert_eq(bytes[placed.zero..<placed.zero + 3], [U8]{0x31, 0xc0, 0xc3})
}

#Test("a logpoint's String part copies the local's length and text into the hit's slot") {
    code: [U8]{0x55, 0x48, 0x89, 0xe5, 0x90}
    insns: native_displaced(code, 0) ?? panic("displaced")
    word: [NativePlaceArg]{NativePlaceArg{register: 3, memory: false, offset: 0, deref: false}}
    calls: [NativePlaceCall]{NativePlaceCall{entry: 0x201000, arguments: [NativePlaceArg]{}}, NativePlaceCall{entry: 0, arguments: word, text: true}}
    ring: NativePlaceRing{address: 0x300000, slots: 4, clock: 0x300100}
    placed: native_place_code(0x200000, 0x1000, calls, Val(ring), 0, code, 0, insns) ?? panic("code")
    bytes: placed.bytes
    slot: native_place_slot(2, 1)
    assert_eq(slot, 32 + NATIVE_PLACE_TEXT)
    // The claim finds the slot by its size.
    assert(native_place_find(bytes, [Int]{0x48, 0x69, 0xc9, slot, 0, 0, 0}) > 0)
    // rbx's saved word's address (lea rax,[rbp+GPR+24]); the header, its
    // data and length; the length into the part's second word.
    read: native_place_find(bytes, [Int]{0x48, 0x8d, 0x85, 0x38, 0x01, 0, 0, 0x48, 0x8b, 0x00, 0x48, 0x8b, 0x30, 0x48, 0x8b, 0x50, 0x08, 0x48, 0x8b, 0x7d, NATIVE_PLACE_CELL + 8, 0x48, 0x89, 0x97, 8, 0, 0, 0})
    assert(read > 0)
    // At most NATIVE_PLACE_TEXT bytes, copied past the slot's words.
    copied: native_place_find(bytes, [Int]{0xb9, NATIVE_PLACE_TEXT, 0, 0, 0, 0x48, 0x39, 0xca, 0x48, 0x0f, 0x42, 0xca, 0x48, 0x81, 0xc7, native_place_text_at(2, 0), 0, 0, 0, 0xfc, 0xf3, 0xa4})
    assert_eq(copied, read + 28)
    // The part calls nothing: one call, the first part's.
    assert_eq(native_place_find(bytes[copied..<bytes.len()], [Int]{0x48, 0x83, 0xe4, 0xf0, 0xe8}), -1)
    assert(native_place_code(0x200000, 0x1000, [NativePlaceCall]{NativePlaceCall{entry: 0, arguments: word, text: true}}, None, 0, code, 0, insns) == None)
}

#Test("a placed call's allocations and frees go to its arena's entries, its other runtime calls out") {
    code: [U8]{0x55, 0x48, 0x89, 0xe5, 0x90}
    insns: native_displaced(code, 0) ?? panic("displaced")
    calls: [NativePlaceCall]{NativePlaceCall{entry: 0x201000, arguments: [NativePlaceArg]{}}}
    placed: native_place_code(0x200000, 0x1000, calls, None, 0x400000, code, 0, insns) ?? panic("code")
    assert_eq(native_place_routine(placed, "jet_rt_alloc"), placed.alloc)
    assert_eq(native_place_routine(placed, "jet_rt_alloc_value"), placed.alloc)
    assert_eq(native_place_routine(placed, "jet_rt_alloc_8"), placed.alloc_8)
    assert_eq(native_place_routine(placed, "jet_rt_alloc_value_8"), placed.alloc_8)
    assert_eq(native_place_routine(placed, "jet_rt_free"), placed.free)
    assert_eq(native_place_routine(placed, "jet_rt_free_8"), placed.free)
    assert_eq(native_place_routine(placed, "jet_rt_session_poll"), placed.out)
    assert_eq(native_place_arena_route("jet_rt_session_poll"), -1)
    // The text routines placed from the pack reach the allocator's own
    // entries by their pack names.
    assert_eq(native_place_routine(placed, "unit.alloc_bytes"), placed.alloc_8)
    assert_eq(native_place_routine(placed, "unit.free_bytes"), placed.free)
    assert_eq(native_place_routine(placed, "unit.alloc_grow_bytes"), placed.grow)
    assert_eq(native_place_routine(placed, "unit.alloc_user_current"), placed.zero)
    assert_eq(native_place_routine(placed, "unit.scheduler_delivered_status"), placed.zero)
    // A stop, and a system call, leave the placed code.
    assert(native_place_routed("jet_rt_numeric_stop"))
    assert_eq(native_place_routine(placed, "jet_rt_numeric_stop"), placed.out)
    assert(native_place_routed("unit_os_syscall_i64__asm"))
    assert(!native_place_routed("unit.rt_text_append"))
    // Without an arena, an allocation calls out too.
    bare: native_place_code(0x200000, 0x1000, calls, None, 0, code, 0, insns) ?? panic("code")
    assert_eq(native_place_routine(bare, "jet_rt_alloc"), bare.out)
    assert_eq(native_place_routine(bare, "unit.alloc_user_current"), bare.out)
}
