// A typed dump: what an observed run's flight recorder writes when a stop
// ends the process (JetRuntime PerfSamples.jet perf_flight_dump), opened as
// a session that never runs. Its words: NATIVE_DUMP_MAGIC, the version, the
// pid, the Unix time, the load bias, the stopped thread's rip, rsp and rbp
// where it captured itself (or as its caller resumes), its tid, the image's
// byte count, the task registry's root (JetRuntime Observe.jet
// observe_root; 0: none) and the image's build hash; then sections of
// [kind, address, bytes] each padded to a word: the flight ring's
// records, every task's registers, a range of the memory the stop reaches
// (every thread's and task's stack, the globals, and what their words point
// to, within the dump's budget), the ranges reached but cut off past that
// budget, and the end. The image is beside the dump, written once per
// build as `<program>-<build>.image` (PerfSamples.jet perf_flight_image),
// its build the hash in NATIVE_DUMP_BUILD_DIGITS hexadecimal digits, which
// the file's bytes must hash to (native_dump_digest), so no other build's
// image is read as the dump's. Its loaded segments stand for the code and
// read-only data the dump does not copy, so `bt`, `locals` and `print` read
// the stop, or the task `task N` selects, as they read a live one, a value
// cut off showing as NATIVE_DEBUG_CUT_OFF; `tasks` lists every task, each a
// deadlock held with its wait, `events` lists the ring, `disassemble`
// lists the image's code (NativeListing.jet), and `symbols` and `segments`
// its symbol table and program headers (NativeImageList.jet).
use {
    native_dump_crypto: core.crypto
    native_dump_files: core.files
    native_dump_hex: core.encoding.hex
    jet_backend.[X64DebugEncoding, X64ImageFunction, X64Jetline, X64JetlineFunction, X64Trace, X64_TRACE_RBP, X64_TRACE_RIP, X64_TRACE_RSP, x64_image_function_find, x64_image_functions]
}

// "JETDUMP1", the dump's first word.
NATIVE_DUMP_MAGIC: 3553425134609253706

NATIVE_DUMP_VERSION: 5

// The words before the sections.
NATIVE_DUMP_HEADER: 12

// The hexadecimal digits of the build hash in its image's name, and the
// hash's FNV-1a offset and prime (native_dump_digest).
NATIVE_DUMP_BUILD_DIGITS: 16

NATIVE_DUMP_BUILD_OFFSET: -3750763034362895579

NATIVE_DUMP_BUILD_PRIME: 1099511628211

// The kernel's register count, as x64_trace_registers reads it.
NATIVE_DUMP_REGISTERS: 27

NATIVE_DUMP_SECTION_END: 0

NATIVE_DUMP_SECTION_MEMORY: 1

NATIVE_DUMP_SECTION_RING: 2

NATIVE_DUMP_SECTION_TASKS: 3

// The cut section: the budget, the bytes the dump holds and the bytes it
// cut off, its row count, then each cut range's [address, bytes].
NATIVE_DUMP_SECTION_CUT: 4

// A task row's words: its task's id, how its registers were had, its rip,
// rsp and rbp, its thread's tid (0 for a parked task's), which of its
// general registers are known (bit k for the k-th), then
// NATIVE_DUMP_GENERAL general registers as the kernel orders them (r15
// first, rdi the last), 0 for one not known.
NATIVE_DUMP_TASK_WORDS: 22

NATIVE_DUMP_GENERAL: 15

// The known mask of a stop that could not capture itself: rbp alone.
NATIVE_DUMP_KNOWN_RBP: 16

// How a task's registers were had: the stopping thread's own, a running
// thread's the stop interrupted, or a parked or queued task's that its
// last switch saved.
NATIVE_DUMP_TASK_STOPPED: 0

NATIVE_DUMP_TASK_RUNNING: 1

NATIVE_DUMP_TASK_PARKED: 2

// The flight ring's record kinds (PerfSamples.jet).
NATIVE_DUMP_SAMPLE: 0

// The words a CPU-time sample's record ends with: its time, its task and
// its sampler's count word (PerfSamples.jet PERF_SAMPLES_TIMED).
NATIVE_DUMP_SAMPLE_TIMED: 3

NATIVE_DUMP_IO: 11

NATIVE_DUMP_WAKE: 12

NATIVE_DUMP_CLOCK: 13

NATIVE_DUMP_WAIT: 14

NATIVE_DUMP_SPAWN: 15

// What a #Secret value shows as.
NATIVE_DUMP_REDACTED: "<redacted>"

// The ring records `events` lists without `--last`.
NATIVE_DUMP_EVENTS: 20

NATIVE_DUMP_HELP: "Commands: backtrace [N] (bt), frame N, locals, print NAME (p NAME), disassemble [FUNCTION|LINE|FILE:LINE|FILE:A-B] [--bytes] (disas), registers [--all], memory WHERE [COUNT] [as TYPE], symbols, segments, sections [NAME...] [--bytes], tasks, task N, events [--last N], help (h), quit (q)"

// A dump's tasks, the stopped one first, its memory, with the image's, the
// address of its task registry's root (0: none), and the file that holds
// its image, which `symbols` and `segments` read.
NativeDump: struct {
    tasks: [NativeDumpTask],
    memory: NativeMemory,
    registry: Int,
    image: String{""},
}

// One readout of a dump's console, and whether it refused the command (a
// run-control command, or one it doesn't know), after which `jet debug
// --do` exits 1.
NativeAnswer: struct {
    text: String,
    refused: Bool{false},
}

// One task of a dump: its id (0: a thread outside every task, the stop's
// own alone), how its registers were had (NATIVE_DUMP_TASK_STOPPED and
// on), its rip, rsp and rbp, its thread's tid, 0 for a parked task, its
// general registers as the kernel orders them and which of them are known
// (bit k for the k-th).
NativeDumpTask: struct {
    id: Int,
    how: Int,
    pc: Int,
    stack: Int,
    frame: Int,
    tid: Int,
    general: [Int],
    known: Int,
}

// An opened dump: its session, the flight ring's records, the pid and Unix
// time of its stop, its image's build and the file beside it that holds
// the image, the image's bytes, and the dump's parts as its bytes hold
// them: the reached memory's (the memory sections'), and the records'
// (every other byte: its words, the ring, the tasks, the cut ranges and the
// sections' own words); then its memory budget and the bytes it cut off
// past it, as the cut section states them; and the image's sized functions
// (x64_image_functions), which name the runtime routine a sample with no
// Jet frame is in, as `jet perf view` names it.
NativeDumpOpened: struct {
    session: NativeSession,
    ring: [U8],
    pid: Int,
    seconds: Int,
    build: String,
    image_file: String,
    image: Int,
    memory: Int,
    records: Int,
    budget: Int,
    cut_off: Int,
    routines: [X64ImageFunction],
}

// Open the dump at `path`, with its image beside it.
native_dump_open: fn(path: String) -[FS.Read]> NativeDumpOpened NativeDebugError! {
    bytes: native_dump_files.read_bytes(path) ?? return Err(NativeDebugError{detail: "couldn't read the dump `{path}`: {err}"})
    header: 8 * NATIVE_DUMP_HEADER
    if bytes.len() < header || native_dump_word(bytes, 0) != NATIVE_DUMP_MAGIC {
        return Err(NativeDebugError{detail: "`{path}` is not a Jet dump"})
    }
    version: native_dump_word(bytes, 8)
    if version != NATIVE_DUMP_VERSION {
        return Err(NativeDebugError{detail: "`{path}` is a version {version} dump; this jet reads version {NATIVE_DUMP_VERSION}"})
    }
    bias: native_dump_word(bytes, 32)
    length: native_dump_word(bytes, 72)
    if length <= 0 -> return Err(NativeDebugError{detail: "`{path}` names no program image"})
    build: native_dump_build(native_dump_word(bytes, 88))
    image_file: native_dump_image_file(path, build) ?? return Err(err)
    elf: native_dump_files.read_bytes(image_file) ?? return Err(NativeDebugError{detail: "couldn't read `{image_file}`, the image of `{path}`: {err}"})
    held: native_dump_build(native_dump_digest(elf))
    if held != build {
        return Err(NativeDebugError{detail: "`{image_file}` holds build {held}, but `{path}` names build {build}: it is another build's image, or a changed one"})
    }
    image: native_image_read(elf) ?? return Err(NativeDebugError{detail: "the program of `{path}` has no Jet debug information"})
    // A dump's frames open as the image's code opens them.
    codes: native_elf_codes(elf, ".text")
    openings: native_openings(image, codes)
    program_entry: native_image_entry(image, codes)
    registry: native_dump_word(bytes, 80)
    // Each memory section is a span of the dump's bytes, which back them.
    ^blocks: [NativeBlock]{}
    ^cut: [NativeCut]{}
    ^ring_at: 0
    ^ring_size: 0
    ^budget: 0
    ^memory: 0
    ^cut_off: 0
    ^tasks: [NativeDumpTask]{}
    ^at: header
    loop at + 24 <= bytes.len() {
        kind: native_dump_word(bytes, at)
        address: native_dump_word(bytes, at + 8)
        size: native_dump_word(bytes, at + 16)
        at += 24
        if kind == NATIVE_DUMP_SECTION_END || size < 0 || at + size > bytes.len() -> break
        if kind == NATIVE_DUMP_SECTION_MEMORY {
            blocks.push(NativeBlock{address: address, bytes: [U8]{}, from: at, size: size})
            memory += size
        }
        if kind == NATIVE_DUMP_SECTION_RING {
            ring_at = at
            ring_size = size
        }
        if kind == NATIVE_DUMP_SECTION_TASKS -> native_dump_tasks(tasks, bytes, at, size)
        if kind == NATIVE_DUMP_SECTION_CUT && size >= 32 {
            budget = native_dump_word(bytes, at)
            cut_off = native_dump_word(bytes, at + 16)
            ^row: at + 32
            loop row + 16 <= at + size {
                cut.push(NativeCut{address: native_dump_word(bytes, row), size: native_dump_word(bytes, row + 8)})
                row += 16
            }
        }
        at += native_dump_pad(size)
    }
    // The image's bytes follow the dump's in the memory's backing, and the
    // dump's own segments come first, so a writable one's bytes are the
    // stop's, not the image's.
    native_dump_loaded(blocks, elf, bytes.len(), bias)
    // A dump whose tasks were not captured still has its stop.
    if tasks.len() == 0 {
        frame: native_dump_word(bytes, 56)
        ^general: loop _ in 0..<NATIVE_DUMP_GENERAL -> 0
        general[X64_TRACE_RBP] = frame
        tasks.push(NativeDumpTask{id: 0, how: NATIVE_DUMP_TASK_STOPPED, pc: native_dump_word(bytes, 40), stack: native_dump_word(bytes, 48), frame: frame, tid: native_dump_word(bytes, 64), general: general, known: NATIVE_DUMP_KNOWN_RBP})
    }
    tasks.sort_by(fn(left: NativeDumpTask, right: NativeDumpTask) { ((if left.how == NATIVE_DUMP_TASK_STOPPED -> 0 else -> 1) <=> (if right.how == NATIVE_DUMP_TASK_STOPPED -> 0 else -> 1)).then(left.id <=> right.id) })
    ring: loop k in ring_at..<ring_at + ring_size -> bytes[k]
    pid: native_dump_word(bytes, 16)
    seconds: native_dump_word(bytes, 24)
    records: bytes.len() - memory
    // The image's code facts, which name the symbols `disassemble` lists by:
    // a dump session's `binary` is the dump, not the image. A dump evaluates
    // nothing, so it reads no runtime pack.
    facts: native_eval_image_of(elf, [U8]{})
    routines: x64_image_functions(elf).functions
    ^backing: bytes.move()
    backing.extend(elf.move())
    dump: NativeDump{tasks: tasks, memory: NativeMemory{trace: None, blocks: blocks, backing: backing.move(), cut: cut}, registry: registry, image: "{image_file}"}
    session: NativeSession{binary: path, image: image, trace: X64Trace{pid: -1, scratch: 0, failure: ""}, output_path: "", output_read: 0, started: true, threads: [NativeThread]{}, observe_root: 0, breakpoints: [NativeBreakpoint]{}, rules: [Int:NativeRule]{}, numbered: 0, sites: [Int:Int]{}, selected: 0, watches: [NativeWatch]{}, watched: "", notes: "", openings: openings, dump: Val(dump), task: 0, program_entry: program_entry, eval_image: Val(facts)}
    Ok(NativeDumpOpened{session: session, ring: ring, pid: pid, seconds: seconds, build: build, image_file: image_file, image: length, memory: memory, records: records, budget: budget, cut_off: cut_off, routines: routines})
}

// `build` as the writer names its image beside the dump (PerfSamples.jet
// perf_flight_hex_digits): NATIVE_DUMP_BUILD_DIGITS lowercase hexadecimal
// digits, the most significant first.
native_dump_build: fn(build: Int) -> String Never! {
    digits: "0123456789abcdef"
    ^text: ""
    loop index in 0..<NATIVE_DUMP_BUILD_DIGITS {
        digit: (build >> (4 * (NATIVE_DUMP_BUILD_DIGITS - 1 - index))) & 15
        text = "{text}{digits.slice(digit, digit + 1)}"
    }
    text
}

// The build hash of `bytes`, as the writer takes it of the image's copy
// (PerfSamples.jet perf_flight_fold): FNV-1a over each byte, in I64 as the
// writer folds it. A wrapping product of exact Ints costs far more per byte,
// so an image of tens of megabytes would take minutes to hash.
native_dump_digest: fn(bytes: [U8]) -> Int Never! {
    ^hash: I64{NATIVE_DUMP_BUILD_OFFSET}
    prime: I64{NATIVE_DUMP_BUILD_PRIME}
    loop byte in bytes -> hash = wrapping((hash ~ I64{byte}) * prime)
    Int{hash}
}

// The file beside the dump at `path` that holds its image of build
// `build`: one named `<program>-<build>.image` in the dump's directory.
native_dump_image_file: fn(path: String, build: String) -[FS.Read]> String NativeDebugError! {
    parent: native_dump_files.dirname(path)
    folder: if parent == "" -> "." else -> parent
    named: "*-{build}.image"
    found: native_dump_files.list_dir(folder, matching: Val(named)) ?? return Err(NativeDebugError{detail: "couldn't list `{folder}` for the image of `{path}`: {err}"})
    if found.len() == 0 {
        return Err(NativeDebugError{detail: "the image of `{path}`, build {build}, is not beside it: `jet run --observe` writes it to the dump's directory as `<program>-{build}.image`, and `jet debug` reads the dump with it"})
    }
    Ok(native_dump_files.join(folder, found[0].name))
}

// A Control's delivered deadlock record (JetRuntime WaitCycle.jet
// waitCycle184), and the record's words: its task count at 8, then from
// 24 each task's [control, line, site].
NATIVE_DUMP_WAIT_CYCLE: 184

NATIVE_DUMP_CYCLE_COUNT: 8

NATIVE_DUMP_CYCLE_ENTRIES: 24

NATIVE_DUMP_CYCLE_ENTRY: 24

// The wait each task a deadlock stop held was in, by task id, as the stop's
// diagnostic says it (`waits to receive from a channel only task 1 sends
// on`): the line of the cycle record delivered to its control, past the
// task's name. The tasks are those the registry whose root is `registry`
// lists; a stop that was no deadlock has none.
native_dump_waits: fn(memory: NativeMemory, registry: Int) -> [Int:String] Never! {
    ^waits: [Int:String]{}
    loop task in native_registry_tasks(memory, registry) {
        if task.control == 0 -> next
        delivered: native_debug_read(memory, task.control + NATIVE_DUMP_WAIT_CYCLE, 8, 1) ?? next
        record: delivered[0]
        if record == 0 -> next
        count: native_debug_read(memory, record + NATIVE_DUMP_CYCLE_COUNT, 8, 1) ?? next
        entries: if count[0] < NATIVE_DEBUG_MOST_TASKS -> count[0] else -> NATIVE_DEBUG_MOST_TASKS
        loop at in 0..<entries {
            entry: native_debug_read(memory, record + NATIVE_DUMP_CYCLE_ENTRIES + at * NATIVE_DUMP_CYCLE_ENTRY, 8, 2) ?? break
            if entry[0] != task.control -> next
            line: native_debug_text(entry[1], memory) ?? break
            if line.contains("  ") -> waits[task.id] = line.after("  ")
            break
        }
    }
    waits
}

// The little-endian word at `at`.
native_dump_word: fn(bytes: [U8], at: Int) -> Int Never! {
    native_number(bytes, at, 8, X64DebugEncoding.Signed)
}

// `size` rounded up to a word.
native_dump_pad: fn(size: Int) -> Int Never! { (size + 7) & -8 }

// The task rows of the section of `size` bytes at `at`: the stop's, and
// each task's; a thread outside every task, or a row its thread never
// wrote, has id 0.
native_dump_tasks: fn(tasks: ^[NativeDumpTask], bytes: [U8], at: Int, size: Int) Never! {
    ^row: at
    loop row + 8 * NATIVE_DUMP_TASK_WORDS <= at + size {
        id: native_dump_word(bytes, row)
        how: native_dump_word(bytes, row + 8)
        if how == NATIVE_DUMP_TASK_STOPPED || id != 0 {
            general: loop k in 0..<NATIVE_DUMP_GENERAL -> native_dump_word(bytes, row + 56 + 8 * k)
            tasks.push(NativeDumpTask{id: id, how: how, pc: native_dump_word(bytes, row + 16), stack: native_dump_word(bytes, row + 24), frame: native_dump_word(bytes, row + 32), tid: native_dump_word(bytes, row + 40), general: general, known: native_dump_word(bytes, row + 48)})
        }
        row += 8 * NATIVE_DUMP_TASK_WORDS
    }
}

// The registers of the dump's task `index`, as x64_trace_registers reads a
// stopped thread's: its general registers, rip and rsp, the rest zero.
native_dump_registers: fn(dump: NativeDump, index: Int) -> [Int] Never! {
    ^registers: loop _ in 0..<NATIVE_DUMP_REGISTERS -> 0
    if index < 0 || index >= dump.tasks.len() -> return registers
    loop (k, value) in dump.tasks[index].general -> registers[k] = value
    registers[X64_TRACE_RIP] = dump.tasks[index].pc
    registers[X64_TRACE_RSP] = dump.tasks[index].stack
    registers[X64_TRACE_RBP] = dump.tasks[index].frame
    registers
}

// Which of native_dump_registers' registers the dump knows: rip, rsp and
// the general registers its row marks.
native_dump_known: fn(dump: NativeDump, index: Int) -> [Bool] Never! {
    ^known: loop _ in 0..<NATIVE_DUMP_REGISTERS -> false
    if index < 0 || index >= dump.tasks.len() -> return known
    mask: dump.tasks[index].known
    loop k in 0..<NATIVE_DUMP_GENERAL -> known[k] = (mask >> k) & 1 == 1
    known[X64_TRACE_RIP] = true
    known[X64_TRACE_RSP] = true
    known
}

// How a task's registers were had, as `tasks` shows it, or for a task a
// deadlock held, its wait among `waits` (native_dump_waits).
native_dump_task_state: fn(task: NativeDumpTask, waits: [Int:String]) -> String Never! {
    if task.how != NATIVE_DUMP_TASK_STOPPED && waits.get(task.id) == .Val(wait) -> return wait
    if task.how == {
        NATIVE_DUMP_TASK_STOPPED -> "stopped"
        NATIVE_DUMP_TASK_RUNNING -> "running"
        else -> "parked"
    }
}

// Each loaded segment (PT_LOAD) of the ELF image `elf`, as a span at its
// address plus `bias` of the backing that holds `elf` from `from` on.
native_dump_loaded: fn(blocks: ^[NativeBlock], elf: [U8], from: Int, bias: Int) Never! {
    length: elf.len()
    if length < 64 {
        return
    }
    table: native_dump_word(elf, 32)
    entry: native_number(elf, 54, 2, X64DebugEncoding.Unsigned)
    count: native_number(elf, 56, 2, X64DebugEncoding.Unsigned)
    loop index in 0..<count {
        at: table + index * entry
        if table < 0 || at + 56 > length -> break
        if native_number(elf, at, 4, X64DebugEncoding.Unsigned) != 1 -> next
        offset: native_dump_word(elf, at + 8)
        address: native_dump_word(elf, at + 16)
        size: native_dump_word(elf, at + 32)
        if offset < 0 || size <= 0 || offset + size > length -> next
        blocks.push(NativeBlock{address: address + bias, bytes: [U8]{}, from: from + offset, size: size})
    }
}

// The index among `frames` of Jet frame `jet`, as a dump's `bt` numbers
// them (0 is the innermost Jet frame); None past the last.
native_dump_jet_frame: fn(frames: [NativeFrame], jet: Int) -> Int? Never! {
    ^seen: 0
    loop (index, frame) in frames {
        if !native_debug_jet_frame(frame) -> next
        if seen == jet -> return Val(index)
        seen += 1
    }
    None
}

// `locals` with each #Secret value shown as NATIVE_DUMP_REDACTED. The dump
// was written with every live Secret's bytes zeroed (JetRuntime
// PerfSamples.jet perf_flight_redacted); the readout says what they were.
native_dump_redact: fn(locals: ^[NativeLocal]) Never! {
    loop index in 0..<locals.len() {
        if native_dump_secret(locals[index].type_name) -> locals[index].value = NATIVE_DUMP_REDACTED
    }
}

// Whether the type named `name` is #Secret's, whose bytes a dump redacts.
native_dump_secret: fn(name: String) -[]> Bool { name == "Secret" || name.ends_with(".Secret") }

// The flight ring's records, one line each, oldest first; `routines` (the
// image's sized functions) name where a sample with no Jet frame is.
native_dump_events: fn(image: NativeImage, ring: [U8], routines: [X64ImageFunction]) -> [String] Never! {
    ^shown: [String]{}
    ^at: 0
    loop at + 8 <= ring.len() {
        head: native_dump_word(ring, at)
        words: (head >> 48) & 2047
        if words == 0 || at + 8 * words > ring.len() -> break
        shown.push(native_dump_event(image, ring, at, words, routines))
        at += 8 * words
    }
    shown
}

// One record of `words` words at `at` of the ring, as a line: its kind, its
// task, what it holds, and the innermost Jet frame of its stack; a sample
// with none, the routine of `routines` its address is in.
native_dump_event: fn(image: NativeImage, ring: [U8], at: Int, words: Int, routines: [X64ImageFunction]) -> String Never! {
    head: native_dump_word(ring, at)
    kind: (head >> 59) & 15
    id: head & 281474976710655
    if kind == NATIVE_DUMP_SAMPLE {
        // A record ends with its time, its task and its sampler's count
        // word (PerfSamples.jet PERF_SAMPLES_TIMED), its task 0 outside
        // every task.
        timed: words >= 1 + NATIVE_DUMP_SAMPLE_TIMED
        sites: if timed -> words - NATIVE_DUMP_SAMPLE_TIMED else -> words
        // A cite of the sample before (PerfSamples.jet perf_samples_cite,
        // bit 63 of the word after its own call sites) is made only as a
        // samples file's records are written, never in the flight ring, so
        // one here is a corrupt record.
        if sites >= 2 && native_dump_word(ring, at + 8 * (sites - 1)) < 0 {
            return "corrupt sample record: its last call site word cites the sample before, which a flight ring never holds"
        }
        task: if timed -> native_dump_word(ring, at + 8 * (sites + 1)) else -> -1
        who: if {
            task > 0 -> "task {task}"
            task == 0 -> "outside every task"
            else -> "a thread"
        }
        found: native_dump_where(image, ring, at, id, 1, sites)
        if found != "" -> return "sample  {who}{found}"
        routine: x64_image_function_find(routines, id)
        if routine < 0 -> return "sample  {who}  in the runtime"
        return "sample  {who}  in the runtime at {routines[routine].name}"
    }
    if kind == NATIVE_DUMP_SPAWN {
        return "spawn   task {id}{native_dump_where(image, ring, at, 0, 1, words)}"
    }
    if kind == NATIVE_DUMP_WAKE {
        return "wake    task {id}{native_dump_where(image, ring, at, 0, 3, words)}"
    }
    // A tally (1 in the address bits): the records the program made and
    // could not write, as its record socket was full.
    if kind == NATIVE_DUMP_CLOCK && id == 1 {
        return "lost    {native_dump_word(ring, at + 8)} records: the record socket was full"
    }
    // A sampler's end (2 in the address bits, PerfSamples.jet
    // perf_precise_ended): its serial, its event's count, then the time it
    // ended.
    if kind == NATIVE_DUMP_CLOCK && id == 2 {
        return "ended   sampler {native_dump_word(ring, at + 8)} at count {native_dump_word(ring, at + 16)}"
    }
    // A sampler's throttle (3 in the address bits, PerfSamples.jet
    // perf_samples_ring_throttle): its serial, the time from the epoch, and 1
    // as the kernel stopped its samples, 0 as it restarted them.
    if kind == NATIVE_DUMP_CLOCK && id == 3 {
        how: if native_dump_word(ring, at + 24) == 1 -> "stopped" else -> "restarted"
        return "throttle sampler {native_dump_word(ring, at + 8)} {how} at {native_dump_word(ring, at + 16) / 1000}us"
    }
    if kind == NATIVE_DUMP_CLOCK {
        return "clock   {native_dump_word(ring, at + 8) / 1000000}ms of CPU time"
    }
    from: at + 48
    if kind == NATIVE_DUMP_WAIT {
        lens: native_dump_word(ring, at + 40)
        name: lens & 65535
        text: (name + ((lens >> 16) & 65535) + ((lens >> 32) & 65535) + 7) >> 3
        label: if name > 0 && from + name <= ring.len() -> String.from_bytes_lossy(ring[from..<from + name]) else -> "wait"
        took: native_dump_word(ring, at + 24) - native_dump_word(ring, at + 16)
        return "wait    task {id} {label} {took / 1000}us{native_dump_where(image, ring, at, 0, 6 + text, words)}"
    }
    if kind == NATIVE_DUMP_IO {
        how: native_dump_word(ring, at + 8)
        operation: if (how & 255) == 1 -> "write" else -> "read"
        kept: native_dump_word(ring, at + 40)
        // A path's bytes; a descriptor or a socket address shows none.
        target: if ((how >> 8) & 255) == 1 && kept > 0 && from + kept <= ring.len() -> " {String.from_bytes_lossy(ring[from..<from + kept])}" else -> ""
        return "io      task {id} {operation}{target} {native_dump_word(ring, at + 32)}{native_dump_where(image, ring, at, 0, 6 + ((kept + 7) >> 3), words)}"
    }
    "counter {kind}{native_dump_where(image, ring, at, id, 1, words)}"
}

// `  at <function> <file>:<line>` for the innermost Jet frame of `pc` (a
// sample's own address, 0 for none) then the call sites in words `first`
// up to `words` of the record at `at`, each at its call row's line
// (native_call_row) when it has one; "" when none is Jet code.
native_dump_where: fn(image: NativeImage, ring: [U8], at: Int, pc: Int, first: Int, words: Int) -> String Never! {
    if pc > 0 {
        frame: native_frame_at(image, pc)
        if native_debug_jet_frame(frame) -> return "  at {frame.function} {frame.file}:{frame.line}"
    }
    loop index in first..<words {
        site: native_dump_word(ring, at + 8 * index)
        if site <= 0 -> next
        ^frame: native_frame_at(image, site - 1)
        if native_call_row(image, site - 1) == .Val(call) -> frame.line = call.line
        if native_debug_jet_frame(frame) -> return "  at {frame.function} {frame.file}:{frame.line}"
    }
    ""
}

// The source file of the run the dump at `path` caught, `source` as its
// image's line table names it (NativeSession.entry_source). A relative one is
// relative to the directory the run ran in (JetCLI Host.jet
// jet_cli_debug_directory), which holds the `.jet/dumps` the dump is in
// (JetRuntime PerfSamples.jet perf_flight_dump_open). A dump kept elsewhere
// leaves it relative to the working directory.
native_dump_source: fn(path: String, source: ^^String) -> String Never! {
    if source == "" || native_dump_files.is_absolute(source) -> return source
    dumps: native_dump_files.dirname(path)
    kept: native_dump_files.dirname(dumps)
    if native_dump_files.basename(dumps) != "dumps" || native_dump_files.basename(kept) != ".jet" {
        return source
    }
    ran: native_dump_files.dirname(kept)
    if ran == "" -> return source
    native_dump_files.join(ran, source)
}

// The sources the dump's build was compiled from, as its image records them
// (NativeImage.sources, by path from the entry root), sorted by path: a
// header line each, its path and sha256. A source whose file
// (native_dump_source) no longer reads as the build read it says so, with
// its sha256 now, or that it is gone; `changed` lists those sources, whose
// lines are never shown as the run's, by the path the line table names
// each by (native_line_source, as NativeSession.entry_source and a frame's
// path name it), or by its own where no function of the table is in it.
NativeDumpSources: struct {
    text: String,
    changed: [String],
}

native_dump_sources: fn(path: String, image: NativeImage) -[FS.Read]> NativeDumpSources Never! {
    ^names: [String]{}
    loop name in image.sources.keys() -> names.push("{name}")
    names.sort()
    ^text: ""
    ^changed: [String]{}
    loop name in names {
        built: image.sources.get(name) ?? next
        line: "Source: {name}, sha256 {native_dump_hex.encode(built)}"
        if native_dump_files.read_bytes(native_dump_source(path, "{name}")) == {
            .Ok(bytes) -> {
                now: native_dump_crypto.sha256(bytes)
                if now.as_bytes() == built -> text = "{text}{line}\n" else {
                    text = "{text}{line}; it has changed since this build (sha256 {now.hex()} now), so its lines are not shown\n"
                    changed.push(native_dump_line_source(image, name))
                }
            }
            .Err(_) -> {
                text = "{text}{line}; it is gone, so its lines are not shown\n"
                changed.push(native_dump_line_source(image, name))
            }
        }
    }
    NativeDumpSources{text: text, changed: changed}
}

// The path the line table names the source `name` (a key of
// NativeImage.sources, the path from the entry root a function records as
// its `file`) by: its first function's native_line_source; `name` when no
// function is in it.
native_dump_line_source: fn(image: NativeImage, name: String) -> String Never! {
    loop function in image.lines.functions {
        if function.file == name -> return native_line_source(function.dir, function.file)
    }
    "{name}"
}

// One console command's readout of the dump: `line`, as read, and whether
// it was refused: a run-control command, or one the dump's console doesn't
// know. `events` are the flight ring's records (native_dump_events), and
// `file` (with the text `lines`) the program's source.
native_dump_command: fn(session: ^NativeSession, line: String, events: [String], file: String, lines: [String]) -> NativeAnswer NativeDebugError! {
    command: line.trim()
    word: command.before(" ")
    operand: if command.contains(" ") -> command.after(" ").trim() else -> ""
    text: if word == {
        // A dump numbers its Jet frames alone: the stopping thread's
        // registers are those of the routine that wrote the dump
        // (JetRuntime PerfSamples.jet perf_flight_dump), whose frames are
        // the capture's, not the program's.
        "bt" | "backtrace" -> {
            count: native_debug_backtrace_count(operand)
            if count == .Val(most) && most < 1 {
                return Ok(NativeAnswer{text: NATIVE_DEBUG_BACKTRACE_COUNT})
            }
            frames: session.backtrace() ?? return Err(err)
            native_debug_backtrace(frames, routines: false, count: count)
        }
        "locals" -> {
            ^locals: native_dump_locals(session) ?? return Err(err)
            locals.sort_by(fn(left: NativeLocal, right: NativeLocal) { left.name <=> right.name })
            native_debug_locals_typed(locals)
        }
        // A dump runs no code, so nothing is evaluated: `print` shows a
        // local of the selected frame by its name, as `locals` reads it.
        "p" | "print" -> {
            if operand == "" {
                return Ok(NativeAnswer{text: "Print needs a local's name, as `print total`\n"})
            }
            locals: native_dump_locals(session) ?? return Err(err)
            loop local in locals {
                if local.name == operand {
                    return Ok(NativeAnswer{text: "{local.name} = {local.value}\n"})
                }
            }
            "Can't evaluate `{operand}`: a dump runs no code, so `print` shows a local by its name; `locals` lists them\n"
        }
        "frame" -> {
            frames: session.backtrace() ?? return Err(err)
            wanted: Int.parse(operand) ?? -1
            index: native_dump_jet_frame(frames, wanted) ?? return Ok(NativeAnswer{text: "No frame {operand}; `bt` lists them\n"})
            selected: session.select_frame(index) ?? return Err(err)
            if !selected -> return Ok(NativeAnswer{text: "No frame {operand}; `bt` lists them\n"})
            native_dump_frame(session, frames, index, file, lines) ?? return Err(err)
        }
        "tasks" -> native_dump_task_list(session, file)
        "disassemble" | "disas" -> native_disassemble(session, operand, file, lines) ?? return Err(err)
        "symbols" | "segments" -> native_image_listing(native_image_of(session), word) ?? return Err(err)
        "sections" -> {
            answer: native_image_sections_answer(native_image_of(session), operand, whole: session.scripted) ?? return Err(err)
            return Ok(answer)
        }
        "registers" -> {
            return native_registers_answer(session, operand)
        }
        "memory" -> {
            ask: native_memory_ask(operand)
            path: native_memory_dump_path(ask)
            return native_memory_answer(session, ask, path)
        }
        "task" -> {
            wanted: Int.parse(operand) ?? -1
            index: native_dump_task_index(session, wanted) ?? return Ok(NativeAnswer{text: "No task {operand}; `tasks` lists them\n"})
            session.task = index
            frames: session.backtrace() ?? return Err(err)
            stop: native_dump_jet_frame(frames, 0) ?? 0
            ^_: session.select_frame(stop) ?? return Err(err)
            native_dump_frame(session, frames, stop, file, lines) ?? return Err(err)
        }
        "events" -> {
            last: if operand.starts_with("--last") -> Int.parse(operand.after("--last").trim()) ?? NATIVE_DUMP_EVENTS else -> NATIVE_DUMP_EVENTS
            from: if last >= 0 && events.len() > last -> events.len() - last else -> 0
            ^listed: if events.len() == 0 -> "No events in the flight ring\n" else -> ""
            loop index in from..<events.len() -> listed = "{listed}{events[index]}\n"
            listed
        }
        "s" | "step" | "n" | "next" | "c" | "continue" | "f" | "finish" | "b" | "break" -> {
            return Ok(NativeAnswer{text: "A dump doesn't run: it is the program as it stopped. {NATIVE_DUMP_HELP}\n", refused: true})
        }
        "h" | "help" -> "{NATIVE_DUMP_HELP}\n"
        "" -> ""
        else -> {
            if native_gdb_answer(command) == .Val(answer) {
                return Ok(NativeAnswer{text: answer, refused: true})
            }
            return Ok(NativeAnswer{text: "Unknown command `{word}`. {NATIVE_DUMP_HELP}\n", refused: true})
        }
    }
    Ok(NativeAnswer{text: text})
}

// The selected frame's locals, each #Secret one redacted.
native_dump_locals: fn(session: ^NativeSession) -> [NativeLocal] NativeDebugError! {
    ^locals: session.locals() ?? return Err(err)
    native_dump_redact(locals)
    Ok(locals)
}

// The place `name` names in a dump, as NativeSession.watch_path reads a
// live program's; a dump runs no code, so an index is a number.
native_dump_watch_path: fn(name: String) -> NativeWatchPath Never! {
    if name == "" -> return native_watch_path_refusal("")
    place: debug_place(name) ?? return native_watch_path_refusal(err.message)
    if place.index != "" && place.literal < 0 {
        return native_watch_path_refusal("a dump runs no code, so an index is a number, as `memory xs[2]`")
    }
    NativeWatchPath{root: place.root, fields: place.fields, index: place.literal, refusal: ""}
}

// Each task of the dump, one line each, the selected one marked `*`: its
// id (a thread outside every task by its tid), whether it was stopped,
// running or parked, or the wait a deadlock held it in, its innermost Jet
// frame, and, when that is not in the program's `file`, the innermost frame
// that is.
native_dump_task_list: fn(session: ^NativeSession, file: String) -> String Never! {
    tasks: if session.dump == .Val(dumped) -> dumped.tasks else -> [NativeDumpTask]{}
    waits: if session.dump == .Val(dumped) -> native_dump_waits(dumped.memory, dumped.registry) else -> [Int:String]{}
    chosen: session.task
    ^text: ""
    loop (index, task) in tasks {
        session.task = index
        frames: session.backtrace() ?? [NativeFrame]{}
        mark: if index == chosen -> "*" else -> " "
        name: if task.id == 0 -> "thread {task.tid}" else -> "task {task.id}"
        text = "{text}{mark} {name}  {native_dump_task_state(task, waits)}{native_dump_located(frames, file)}\n"
    }
    session.task = chosen
    text
}

// The index among the dump's tasks of task `id`.
native_dump_task_index: fn(session: NativeSession, id: Int) -> Int? Never! {
    if session.dump == .Val(dumped) {
        loop (index, task) in dumped.tasks {
            if task.id == id -> return Val(index)
        }
    }
    None
}

// `  in <function>() at <file>:<line>` for the innermost Jet frame of
// `frames`, then `, from …` the innermost in the program's `file` when that
// is another; "" when none is Jet code.
native_dump_located: fn(frames: [NativeFrame], file: String) -> String Never! {
    innermost: native_dump_jet_frame(frames, 0) ?? return ""
    frame: frames[innermost]
    shown: "  in {frame.function}() at {frame.file}:{frame.line}"
    if frame.file == file -> return shown
    loop index in innermost..<frames.len() {
        caller: frames[index]
        if native_debug_jet_frame(caller) && caller.file == file {
            return "{shown}, from {caller.function}() at {caller.file}:{caller.line}"
        }
    }
    shown
}

// Frame `index` of `frames`: where it is, its Jet source line
// (NativeSession.frame_source), and its locals.
native_dump_frame: fn(session: ^NativeSession, frames: [NativeFrame], index: Int, file: String, lines: [String]) -> String NativeDebugError! {
    if index >= frames.len() -> return Ok("No Jet frame in the dump\n")
    frame: frames[index]
    source: session.frame_source(frame, file, lines)
    locals: native_dump_locals(session) ?? return Err(err)
    Ok("Stopped  {frame.file}:{frame.line}  in {frame.function}()\n{frame.line} | {source}        <- here\n{native_debug_locals_line(locals)}\n")
}

#Test("a dump's relative source is in the directory whose .jet/dumps holds the dump") {
    assert_eq(native_dump_source("/w/run/.jet/dumps/crash-1.jetdump", "crash.jet"), "/w/run/crash.jet")
    assert_eq(native_dump_source("/w/run/.jet/dumps/crash-1.jetdump", "/src/crash.jet"), "/src/crash.jet")
    assert_eq(native_dump_source("/w/kept/crash-1.jetdump", "crash.jet"), "crash.jet")
    assert_eq(native_dump_source("/w/run/.jet/dumps/crash-1.jetdump", ""), "")
}

#Test("a dump names each source of its build by sha256, and one changed or gone since that build") {
    scratch: native_dump_files.temp_dir("jet-dump-sources") ?? panic("scratch: {err}")
    root: scratch.path
    dump: native_dump_files.join(root, ".jet/dumps/crash-1.jetdump")
    native_dump_files.write_bytes(native_dump_files.join(root, "crash.jet"), "crash\n".bytes()) ?? panic("source: {err}")
    native_dump_files.write_bytes(native_dump_files.join(root, "other.jet"), "changed\n".bytes()) ?? panic("source: {err}")
    ^image: NativeImage{lines: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, functions: [NativeFunction]{}, types: [Int:NativeType]{}, members: [[NativeMember]]{}, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: [U8]{}, abstracts: [Int:NativeAbstract]{}, allocs: [Int:Int]{}}
    image.sources["crash.jet"] = native_dump_crypto.sha256("crash\n".bytes()).as_bytes()
    image.sources["other.jet"] = native_dump_crypto.sha256("built\n".bytes()).as_bytes()
    image.sources["gone.jet"] = native_dump_crypto.sha256("gone\n".bytes()).as_bytes()
    sources: native_dump_sources(dump, image)
    assert_eq(sources.text, "Source: crash.jet, sha256 990a9a4e4265a1354baaeca97c46175c3d7b5466ab7cad54bc6984b70fc2243b\nSource: gone.jet, sha256 4b9f2c32577beb1ebc8ab2a1e226faaa9176a81cd4eedbaa22f8a0db919972b5; it is gone, so its lines are not shown\nSource: other.jet, sha256 56f6e6304d02d413bb7d5d463ac5cdc58551266dc7269b467fc385815f39b913; it has changed since this build (sha256 7f8b1dfc466b6249f06cbe55c9174df2578e7754da793fded244ef5cba2a38f1 now), so its lines are not shown\n")
    assert_eq(sources.changed, [String]{"gone.jet", "other.jet"})
}

#Test("a dump lists a changed source by the path its line table names it, as the stop's entry is named") {
    scratch: native_dump_files.temp_dir("jet-dump-changed") ?? panic("scratch: {err}")
    root: scratch.path
    dump: native_dump_files.join(root, ".jet/dumps/crash-1.jetdump")
    native_dump_files.write_bytes(native_dump_files.join(root, "crash.jet"), "edited\n".bytes()) ?? panic("source: {err}")
    native_dump_files.write_bytes(native_dump_files.join(root, "lib.jet"), "edited\n".bytes()) ?? panic("source: {err}")
    ^image: NativeImage{lines: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, functions: [NativeFunction]{}, types: [Int:NativeType]{}, members: [[NativeMember]]{}, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: [U8]{}, abstracts: [Int:NativeAbstract]{}, allocs: [Int:Int]{}}
    image.lines.functions.push(X64JetlineFunction{low: 0x2000, high: 0x2040, name: "check", file: "crash.jet", dir: ".", decl: 1, rows: 0, rows_end: 0})
    image.lines.functions.push(X64JetlineFunction{low: 0x2040, high: 0x2080, name: "helper", file: "lib.jet", dir: "/w/run", decl: 1, rows: 0, rows_end: 0})
    image.sources["crash.jet"] = native_dump_crypto.sha256("built\n".bytes()).as_bytes()
    image.sources["lib.jet"] = native_dump_crypto.sha256("built\n".bytes()).as_bytes()
    image.sources["gone.jet"] = native_dump_crypto.sha256("gone\n".bytes()).as_bytes()
    sources: native_dump_sources(dump, image)
    assert_eq(sources.changed, [String]{"./crash.jet", "gone.jet", "/w/run/lib.jet"})
    assert(sources.text.contains("Source: crash.jet, sha256 "), sources.text)
    native_dump_files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

// A CPU-time sample shows its task and where it was: the first Jet frame of
// its stack, or when none is, the runtime and the routine its address is
// in; its trailing time, task and count word are no call sites. A cite of
// the sample before, which no flight ring holds, is a corrupt record. A
// sampler's end shows its serial and count, and its throttle when the kernel
// stopped or restarted its samples.
#Test("a sample event names its task and its place, the runtime's routine when no Jet frame holds it") {
    image: NativeImage{lines: X64Jetline{table: [U8]{}, functions: [X64JetlineFunction]{}}, functions: [NativeFunction]{}, types: [Int:NativeType]{}, members: [[NativeMember]]{}, enumerators: [[NativeEnumerator]]{}, variants: [NativeVariants]{}, loclists: [U8]{}, abstracts: [Int:NativeAbstract]{}, allocs: [Int:Int]{}}
    // Address 0x1000, one call site, the time, task 3 and sampler 1's count
    // word; the same outside every task under the timer; an address alone,
    // made with no record buffer free; one call site of its own and a cite
    // of 2 call sites of the record 5 words back; sampler 1's end at count
    // 250000; sampler 1 stopped 1500 us past the epoch, and restarted.
    records: [[Int]]{[Int]{0x1000 | (5 << 48), 0x2000, 500, 3, (1 << 48) | 125000}, [Int]{0x1000 | (5 << 48), 0x2000, -1, 0, 0}, [Int]{0x1000 | (1 << 48)}, [Int]{0x1000 | (6 << 48), 0x2000, (-9223372036854775807 - 1) | (2 << 32) | 5, 600, 3, 0}, [Int]{(13 << 59) | (4 << 48) | 2, 1, 250000, 2000000}, [Int]{(13 << 59) | (4 << 48) | 3, 1, 1500000, 1}, [Int]{(13 << 59) | (4 << 48) | 3, 1, 1700000, 0}}
    ^ring: [U8]{}
    loop record in records {
        loop word in record -> ring.extend(native_low_bytes(word, 8))
    }
    routines: [X64ImageFunction]{{start: 0x0f00, size: 0x0200, name: "unit_os_syscall_i64__asm"}}
    assert_eq(native_dump_events(image, ring, routines), [String]{"sample  task 3  in the runtime at unit_os_syscall_i64__asm", "sample  outside every task  in the runtime at unit_os_syscall_i64__asm", "sample  a thread  in the runtime at unit_os_syscall_i64__asm", "corrupt sample record: its last call site word cites the sample before, which a flight ring never holds", "ended   sampler 1 at count 250000", "throttle sampler 1 stopped at 1500us", "throttle sampler 1 restarted at 1700us"})
    // An address no sized function holds names the runtime alone.
    assert_eq(native_dump_events(image, ring, [X64ImageFunction]{{start: 0x3000, size: 16, name: "elsewhere"}})[1], "sample  outside every task  in the runtime")
}

// A dump's header words: the magic, the version, then the pid, time, bias,
// rip, rsp, rbp and tid (all 0 here), the image's byte count, the
// registry's root and the build; then the end section.
native_dump_test_bytes: fn(version: Int, length: Int, build: Int) -> [U8] Never! {
    words: [Int]{NATIVE_DUMP_MAGIC, version, 0, 0, 0, 0, 0, 0, 0, length, 0, build, NATIVE_DUMP_SECTION_END, 0, 0}
    ^bytes: [U8]{}
    loop word in words -> bytes.extend(native_word_bytes(word))
    bytes
}

#Test("a dump names its image's build in sixteen hexadecimal digits") {
    assert_eq(native_dump_build(0x0123456789abcdef), "0123456789abcdef")
    assert_eq(native_dump_build(-7046029254386353131), "9e3779b97f4a7c15")
    assert_eq(native_dump_build(-1), "ffffffffffffffff")
    assert_eq(native_dump_build(0), "0000000000000000")
}

// FNV-1a's published 64-bit vectors.
#Test("an image's build is the FNV-1a hash of its bytes") {
    assert_eq(native_dump_build(native_dump_digest([U8]{})), "cbf29ce484222325")
    assert_eq(native_dump_build(native_dump_digest("a".bytes())), "af63dc4c8601ec8c")
    assert_eq(native_dump_build(native_dump_digest("foobar".bytes())), "85944171f73967e8")
}

#Test("a dump opens with the image of its build beside it, and says which build is missing or wrong") {
    scratch: native_dump_files.temp_dir("jet-dump-image") ?? panic("scratch: {err}")
    root: scratch.path
    dump: native_dump_files.join(root, "crash-20261119T120000Z.jetdump")
    // The build of the one-byte image "a".
    native_dump_files.write_bytes(dump, native_dump_test_bytes(NATIVE_DUMP_VERSION, 1, -5808556873153909620)) ?? panic("dump: {err}")
    if native_dump_open(dump) == {
        .Ok(_) -> { panic("a dump opened with no image beside it") }
        .Err(missing) -> {
            assert_eq(missing.detail, "the image of `{dump}`, build af63dc4c8601ec8c, is not beside it: `jet run --observe` writes it to the dump's directory as `<program>-af63dc4c8601ec8c.image`, and `jet debug` reads the dump with it")
        }
    }
    // Another build's image is not this dump's.
    native_dump_files.write_bytes(native_dump_files.join(root, "crash-fedcba9876543210.image"), [U8]{1, 2, 3}) ?? panic("image: {err}")
    image: native_dump_files.join(root, "crash-af63dc4c8601ec8c.image")
    native_dump_files.write_bytes(image, "a".bytes()) ?? panic("image: {err}")
    assert_eq(native_dump_image_file(dump, "af63dc4c8601ec8c") ?? panic("image file: {err.detail}"), image)
    // The image of its build passes the build check; it is no ELF image.
    if native_dump_open(dump) == {
        .Ok(_) -> { panic("a dump opened with an image that is no program") }
        .Err(read) -> assert_eq(read.detail, "the program of `{dump}` has no Jet debug information")
    }
    // A same-size image of another build in its place is refused.
    native_dump_files.write_bytes(image, "b".bytes()) ?? panic("image: {err}")
    if native_dump_open(dump) == {
        .Ok(_) -> { panic("a dump opened with another build's image") }
        .Err(wrong) -> {
            assert_eq(wrong.detail, "`{image}` holds build af63df4c8601f1a5, but `{dump}` names build af63dc4c8601ec8c: it is another build's image, or a changed one")
        }
    }
    native_dump_files.write_bytes(dump, native_dump_test_bytes(4, 1, 0)) ?? panic("dump: {err}")
    if native_dump_open(dump) == {
        .Ok(_) -> { panic("a version 4 dump opened") }
        .Err(old) -> assert_eq(old.detail, "`{dump}` is a version 4 dump; this jet reads version 5")
    }
}
