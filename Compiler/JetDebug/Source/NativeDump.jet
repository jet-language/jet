// A typed dump: what an observed run's flight recorder writes when a stop
// ends the process (JetRuntime PerfSamples.jet perf_flight_dump), opened as
// a session that never runs. Its words: NATIVE_DUMP_MAGIC, the version, the
// pid, the Unix time, the load bias, the stopped thread's rip, rsp and rbp
// where it captured itself (or as its caller resumes), its tid, the image's
// byte count and the task registry's root (JetRuntime Observe.jet
// observe_root; 0: none); the image itself, padded to a word; then sections
// of [kind, address, bytes] each padded to a word: the flight ring's
// records, every task's registers, a range of the memory the stop reaches
// (every thread's and task's stack, the globals, and what their words point
// to, within the dump's budget), the ranges reached but cut off past that
// budget, and the end. The image's loaded segments stand for the code and
// read-only data the dump does not copy, so `bt`, `locals` and `print` read
// the stop, or the task `task N` selects, as they read a live one, a value
// cut off showing as NATIVE_DEBUG_CUT_OFF; `tasks` lists every task, each a
// deadlock held with its wait, and `events` lists the ring.
use {
    native_dump_files: core.files
    jet_backend.[X64DebugEncoding, X64Trace, X64_TRACE_RBP, X64_TRACE_RIP, X64_TRACE_RSP]
}

// "JETDUMP1", the dump's first word.
NATIVE_DUMP_MAGIC: 3553425134609253706

NATIVE_DUMP_VERSION: 4

// The words before the image.
NATIVE_DUMP_HEADER: 11

// The kernel's register count, as x64_trace_registers reads it.
NATIVE_DUMP_REGISTERS: 27

NATIVE_DUMP_SECTION_END: 0

NATIVE_DUMP_SECTION_MEMORY: 1

NATIVE_DUMP_SECTION_RING: 2

NATIVE_DUMP_SECTION_TASKS: 3

// The cut section: the budget, the bytes the dump holds and the bytes it
// cut off, its row count, then each cut range's [address, bytes].
NATIVE_DUMP_SECTION_CUT: 4

// A task row's words: its task's id, how its registers were had, its rip,
// rsp and rbp, its thread's tid (0 for a parked task's), which of its
// general registers are known (bit k for the k-th), then
// NATIVE_DUMP_GENERAL general registers as the kernel orders them (r15
// first, rdi the last), 0 for one not known.
NATIVE_DUMP_TASK_WORDS: 22

NATIVE_DUMP_GENERAL: 15

// The known mask of a stop that could not capture itself: rbp alone.
NATIVE_DUMP_KNOWN_RBP: 16

// How a task's registers were had: the stopping thread's own, a running
// thread's the stop interrupted, or a parked or queued task's that its
// last switch saved.
NATIVE_DUMP_TASK_STOPPED: 0

NATIVE_DUMP_TASK_RUNNING: 1

NATIVE_DUMP_TASK_PARKED: 2

// The flight ring's record kinds (PerfSamples.jet).
NATIVE_DUMP_SAMPLE: 0

NATIVE_DUMP_IO: 11

NATIVE_DUMP_WAKE: 12

NATIVE_DUMP_CLOCK: 13

NATIVE_DUMP_WAIT: 14

NATIVE_DUMP_SPAWN: 15

// What a #Secret value shows as.
NATIVE_DUMP_REDACTED: "<redacted>"

// The ring records `events` lists without `--last`.
NATIVE_DUMP_EVENTS: 20

NATIVE_DUMP_HELP: "Commands: backtrace (bt), frame N, locals, print NAME (p NAME), tasks, task N, events [--last N], help (h), quit (q)"

// A dump's tasks, the stopped one first, its memory, with the image's, and
// the address of its task registry's root (0: none).
NativeDump: struct {
    tasks: [NativeDumpTask],
    memory: NativeMemory,
    registry: Int,
}

// One task of a dump: its id (0: a thread outside every task, the stop's
// own alone), how its registers were had (NATIVE_DUMP_TASK_STOPPED and
// on), its rip, rsp and rbp, its thread's tid, 0 for a parked task, its
// general registers as the kernel orders them and which of them are known
// (bit k for the k-th).
NativeDumpTask: struct {
    id: Int,
    how: Int,
    pc: Int,
    stack: Int,
    frame: Int,
    tid: Int,
    general: [Int],
    known: Int,
}

// An opened dump: its session, the flight ring's records, the pid and Unix
// time of its stop, and its parts as its bytes hold them: the image's bytes,
// the reached memory's (the memory sections'), and the records' (every
// other byte: its words, the ring, the tasks, the cut ranges and the
// sections' own words); then its memory budget and the bytes it cut off
// past it, as the cut section states them.
NativeDumpOpened: struct {
    session: NativeSession,
    ring: [U8],
    pid: Int,
    seconds: Int,
    image: Int,
    memory: Int,
    records: Int,
    budget: Int,
    cut_off: Int,
}

// Open the dump at `path`.
native_dump_open: fn(path: String) -[FS.Read]> NativeDumpOpened NativeDebugError! {
    bytes: native_dump_files.read_bytes(path) ?? return Err(NativeDebugError{detail: "couldn't read the dump `{path}`: {err}"})
    header: 8 * NATIVE_DUMP_HEADER
    if bytes.len() < header || native_dump_word(bytes, 0) != NATIVE_DUMP_MAGIC {
        return Err(NativeDebugError{detail: "`{path}` is not a Jet dump"})
    }
    version: native_dump_word(bytes, 8)
    if version != NATIVE_DUMP_VERSION {
        return Err(NativeDebugError{detail: "`{path}` is a version {version} dump; this jet reads version {NATIVE_DUMP_VERSION}"})
    }
    bias: native_dump_word(bytes, 32)
    length: native_dump_word(bytes, 72)
    if length <= 0 || header + length > bytes.len() {
        return Err(NativeDebugError{detail: "`{path}` holds no program image"})
    }
    elf: bytes[header..<header + length]
    image: native_image_read(elf) ?? return Err(NativeDebugError{detail: "the program of `{path}` has no Jet debug information"})
    // A dump's frames open as the image's code opens them.
    openings: native_openings(image, native_elf_codes(elf, ".text"))
    registry: native_dump_word(bytes, 80)
    // Each memory section is a span of the dump's bytes, which back them.
    blocks := [NativeBlock]{}
    cut := [NativeCut]{}
    ring_at := 0
    ring_size := 0
    budget := 0
    memory := 0
    cut_off := 0
    tasks := [NativeDumpTask]{}
    at := header + native_dump_pad(length)
    loop at + 24 <= bytes.len() {
        kind: native_dump_word(bytes, at)
        address: native_dump_word(bytes, at + 8)
        size: native_dump_word(bytes, at + 16)
        at += 24
        if kind == NATIVE_DUMP_SECTION_END || size < 0 || at + size > bytes.len() -> break
        if kind == NATIVE_DUMP_SECTION_MEMORY {
            blocks.push(NativeBlock{address: address, bytes: [U8]{}, from: at, size: size})
            memory += size
        }
        if kind == NATIVE_DUMP_SECTION_RING {
            ring_at = at
            ring_size = size
        }
        if kind == NATIVE_DUMP_SECTION_TASKS -> native_dump_tasks(tasks, bytes, at, size)
        if kind == NATIVE_DUMP_SECTION_CUT && size >= 32 {
            budget = native_dump_word(bytes, at)
            cut_off = native_dump_word(bytes, at + 16)
            row := at + 32
            loop row + 16 <= at + size {
                cut.push(NativeCut{address: native_dump_word(bytes, row), size: native_dump_word(bytes, row + 8)})
                row += 16
            }
        }
        at += native_dump_pad(size)
    }
    // The dump's own segments come first, so a writable one's bytes are
    // the stop's, not the image's.
    native_dump_loaded(blocks, bytes, header, length, bias)
    // A dump whose tasks were not captured still has its stop.
    if tasks.len() == 0 {
        frame: native_dump_word(bytes, 56)
        general := loop _ in 0..<NATIVE_DUMP_GENERAL -> 0
        general[X64_TRACE_RBP] = frame
        tasks.push(NativeDumpTask{id: 0, how: NATIVE_DUMP_TASK_STOPPED, pc: native_dump_word(bytes, 40), stack: native_dump_word(bytes, 48), frame: frame, tid: native_dump_word(bytes, 64), general: general, known: NATIVE_DUMP_KNOWN_RBP})
    }
    tasks.sort_by(fn(left: NativeDumpTask, right: NativeDumpTask) { ((if left.how == NATIVE_DUMP_TASK_STOPPED -> 0 else -> 1) <=> (if right.how == NATIVE_DUMP_TASK_STOPPED -> 0 else -> 1)).then(left.id <=> right.id) })
    ring: loop k in ring_at..<ring_at + ring_size -> bytes[k]
    pid: native_dump_word(bytes, 16)
    seconds: native_dump_word(bytes, 24)
    records: bytes.len() - native_dump_pad(length) - memory
    dump: NativeDump{tasks: tasks, memory: NativeMemory{trace: None, blocks: blocks, backing: bytes.move(), cut: cut}, registry: registry}
    session: NativeSession{binary: path, image: image, trace: X64Trace{pid: -1, scratch: 0, failure: ""}, output_path: "", output_read: 0, started: true, threads: [NativeThread]{}, observe_root: 0, breakpoints: [NativeBreakpoint]{}, rules: [Int:NativeRule]{}, numbered: 0, sites: [Int:Int]{}, selected: 0, watches: [NativeWatch]{}, watched: "", notes: "", openings: openings, dump: Val(dump), task: 0}
    Ok(NativeDumpOpened{session: session, ring: ring, pid: pid, seconds: seconds, image: length, memory: memory, records: records, budget: budget, cut_off: cut_off})
}

// A Control's delivered deadlock record (JetRuntime WaitCycle.jet
// waitCycle184), and the record's words: its task count at 8, then from
// 24 each task's [control, line, site].
NATIVE_DUMP_WAIT_CYCLE: 184

NATIVE_DUMP_CYCLE_COUNT: 8

NATIVE_DUMP_CYCLE_ENTRIES: 24

NATIVE_DUMP_CYCLE_ENTRY: 24

// The wait each task a deadlock stop held was in, by task id, as the stop's
// diagnostic says it (`waits to receive from a channel only task 1 sends
// on`): the line of the cycle record delivered to its control, past the
// task's name. The tasks are those the registry whose root is `registry`
// lists; a stop that was no deadlock has none.
native_dump_waits: fn(memory: NativeMemory, registry: Int) -> [Int:String] Never! {
    waits := [Int:String]{}
    loop task in native_registry_tasks(memory, registry) {
        if task.control == 0 -> next
        delivered: native_debug_read(memory, task.control + NATIVE_DUMP_WAIT_CYCLE, 8, 1) ?? next
        record: delivered[0]
        if record == 0 -> next
        count: native_debug_read(memory, record + NATIVE_DUMP_CYCLE_COUNT, 8, 1) ?? next
        entries: if count[0] < NATIVE_DEBUG_MOST_TASKS -> count[0] else -> NATIVE_DEBUG_MOST_TASKS
        loop at in 0..<entries {
            entry: native_debug_read(memory, record + NATIVE_DUMP_CYCLE_ENTRIES + at * NATIVE_DUMP_CYCLE_ENTRY, 8, 2) ?? break
            if entry[0] != task.control -> next
            line: native_debug_text(entry[1], memory) ?? break
            if line.contains("  ") -> waits[task.id] = line.after("  ")
            break
        }
    }
    waits
}

// The little-endian word at `at`.
native_dump_word: fn(bytes: [U8], at: Int) -> Int Never! {
    native_number(bytes, at, 8, X64DebugEncoding.Signed)
}

// `size` rounded up to a word.
native_dump_pad: fn(size: Int) -> Int Never! { (size + 7) & -8 }

// The task rows of the section of `size` bytes at `at`: the stop's, and
// each task's; a thread outside every task, or a row its thread never
// wrote, has id 0.
native_dump_tasks: fn(tasks: &[NativeDumpTask], bytes: [U8], at: Int, size: Int) Never! {
    row := at
    loop row + 8 * NATIVE_DUMP_TASK_WORDS <= at + size {
        id: native_dump_word(bytes, row)
        how: native_dump_word(bytes, row + 8)
        if how == NATIVE_DUMP_TASK_STOPPED || id != 0 {
            general: loop k in 0..<NATIVE_DUMP_GENERAL -> native_dump_word(bytes, row + 56 + 8 * k)
            tasks.push(NativeDumpTask{id: id, how: how, pc: native_dump_word(bytes, row + 16), stack: native_dump_word(bytes, row + 24), frame: native_dump_word(bytes, row + 32), tid: native_dump_word(bytes, row + 40), general: general, known: native_dump_word(bytes, row + 48)})
        }
        row += 8 * NATIVE_DUMP_TASK_WORDS
    }
}

// The registers of the dump's task `index`, as x64_trace_registers reads a
// stopped thread's: its general registers, rip and rsp, the rest zero.
native_dump_registers: fn(dump: NativeDump, index: Int) -> [Int] Never! {
    registers := loop _ in 0..<NATIVE_DUMP_REGISTERS -> 0
    if index < 0 || index >= dump.tasks.len() -> return registers
    loop (k, value) in dump.tasks[index].general -> registers[k] = value
    registers[X64_TRACE_RIP] = dump.tasks[index].pc
    registers[X64_TRACE_RSP] = dump.tasks[index].stack
    registers[X64_TRACE_RBP] = dump.tasks[index].frame
    registers
}

// Which of native_dump_registers' registers the dump knows: rip, rsp and
// the general registers its row marks.
native_dump_known: fn(dump: NativeDump, index: Int) -> [Bool] Never! {
    known := loop _ in 0..<NATIVE_DUMP_REGISTERS -> false
    if index < 0 || index >= dump.tasks.len() -> return known
    mask: dump.tasks[index].known
    loop k in 0..<NATIVE_DUMP_GENERAL -> known[k] = (mask >> k) & 1 == 1
    known[X64_TRACE_RIP] = true
    known[X64_TRACE_RSP] = true
    known
}

// How a task's registers were had, as `tasks` shows it, or for a task a
// deadlock held, its wait among `waits` (native_dump_waits).
native_dump_task_state: fn(task: NativeDumpTask, waits: [Int:String]) -> String Never! {
    if task.how != NATIVE_DUMP_TASK_STOPPED && waits.get(task.id) == .Val(wait) -> return wait
    if task.how == {
        NATIVE_DUMP_TASK_STOPPED -> "stopped"
        NATIVE_DUMP_TASK_RUNNING -> "running"
        else -> "parked"
    }
}

// Each loaded segment (PT_LOAD) of the ELF image of `length` bytes at
// `image` in `bytes`, as a span of `bytes` at its address plus `bias`.
native_dump_loaded: fn(blocks: &[NativeBlock], bytes: [U8], image: Int, length: Int, bias: Int) Never! {
    if length < 64 {
        return
    }
    table: native_dump_word(bytes, image + 32)
    entry: native_number(bytes, image + 54, 2, X64DebugEncoding.Unsigned)
    count: native_number(bytes, image + 56, 2, X64DebugEncoding.Unsigned)
    loop index in 0..<count {
        at: image + table + index * entry
        if table < 0 || at + 56 > image + length -> break
        if native_number(bytes, at, 4, X64DebugEncoding.Unsigned) != 1 -> next
        offset: native_dump_word(bytes, at + 8)
        address: native_dump_word(bytes, at + 16)
        size: native_dump_word(bytes, at + 32)
        if offset < 0 || size <= 0 || offset + size > length -> next
        blocks.push(NativeBlock{address: address + bias, bytes: [U8]{}, from: image + offset, size: size})
    }
}

// The index among `frames` of Jet frame `jet`, as native_debug_backtrace
// numbers them (0 is the innermost Jet frame); None past the last.
native_dump_jet_frame: fn(frames: [NativeFrame], jet: Int) -> Int? Never! {
    seen := 0
    loop (index, frame) in frames {
        if !native_debug_jet_frame(frame) -> next
        if seen == jet -> return Val(index)
        seen += 1
    }
    None
}

// `locals` with each #Secret value shown as NATIVE_DUMP_REDACTED. The dump
// was written with every live Secret's bytes zeroed (JetRuntime
// PerfSamples.jet perf_flight_redacted); the readout says what they were.
native_dump_redact: fn(locals: &[NativeLocal]) Never! {
    loop index in 0..<locals.len() {
        if locals[index].type_name == "Secret" || locals[index].type_name.ends_with(".Secret") {
            locals[index].value = NATIVE_DUMP_REDACTED
        }
    }
}

// The flight ring's records, one line each, oldest first.
native_dump_events: fn(image: NativeImage, ring: [U8]) -> [String] Never! {
    shown := [String]{}
    at := 0
    loop at + 8 <= ring.len() {
        head: native_dump_word(ring, at)
        words: (head >> 48) & 2047
        if words == 0 || at + 8 * words > ring.len() -> break
        shown.push(native_dump_event(image, ring, at, words))
        at += 8 * words
    }
    shown
}

// One record of `words` words at `at` of the ring, as a line: its kind, its
// task, what it holds, and the innermost Jet frame of its stack.
native_dump_event: fn(image: NativeImage, ring: [U8], at: Int, words: Int) -> String Never! {
    head: native_dump_word(ring, at)
    kind: (head >> 59) & 15
    id: head & 281474976710655
    if kind == NATIVE_DUMP_SAMPLE {
        return "sample  {native_dump_where(image, ring, at, id, 1, words)}"
    }
    if kind == NATIVE_DUMP_SPAWN {
        return "spawn   task {id}{native_dump_where(image, ring, at, 0, 1, words)}"
    }
    if kind == NATIVE_DUMP_WAKE {
        return "wake    task {id}{native_dump_where(image, ring, at, 0, 3, words)}"
    }
    if kind == NATIVE_DUMP_CLOCK {
        return "clock   {native_dump_word(ring, at + 8) / 1000000}ms of CPU time"
    }
    from: at + 48
    if kind == NATIVE_DUMP_WAIT {
        lens: native_dump_word(ring, at + 40)
        name: lens & 65535
        text: (name + ((lens >> 16) & 65535) + ((lens >> 32) & 65535) + 7) >> 3
        label: if name > 0 && from + name <= ring.len() -> String.from_bytes_lossy(ring[from..<from + name]) else -> "wait"
        took: native_dump_word(ring, at + 24) - native_dump_word(ring, at + 16)
        return "wait    task {id} {label} {took / 1000}us{native_dump_where(image, ring, at, 0, 6 + text, words)}"
    }
    if kind == NATIVE_DUMP_IO {
        how: native_dump_word(ring, at + 8)
        operation: if (how & 255) == 1 -> "write" else -> "read"
        kept: native_dump_word(ring, at + 40)
        // A path's bytes; a descriptor or a socket address shows none.
        target: if ((how >> 8) & 255) == 1 && kept > 0 && from + kept <= ring.len() -> " {String.from_bytes_lossy(ring[from..<from + kept])}" else -> ""
        return "io      task {id} {operation}{target} {native_dump_word(ring, at + 32)}{native_dump_where(image, ring, at, 0, 6 + ((kept + 7) >> 3), words)}"
    }
    "counter {kind}{native_dump_where(image, ring, at, id, 1, words)}"
}

// `  at <function> <file>:<line>` for the innermost Jet frame of `pc` (a
// sample's own address, 0 for none) then the call sites in words `first`
// up to `words` of the record at `at`; "" when none is Jet code.
native_dump_where: fn(image: NativeImage, ring: [U8], at: Int, pc: Int, first: Int, words: Int) -> String Never! {
    if pc > 0 {
        frame: native_frame_at(image, pc)
        if native_debug_jet_frame(frame) -> return "  at {frame.function} {frame.file}:{frame.line}"
    }
    loop index in first..<words {
        site: native_dump_word(ring, at + 8 * index)
        if site <= 0 -> next
        frame: native_frame_at(image, site - 1)
        if native_debug_jet_frame(frame) -> return "  at {frame.function} {frame.file}:{frame.line}"
    }
    ""
}

// The source file of the run the dump at `path` caught, `source` as its
// image's line table names it (NativeSession.run_source). A relative one is
// relative to the directory the run ran in (JetCLI Host.jet
// jet_cli_debug_directory), which holds the `.jet/dumps` the dump is in
// (JetRuntime PerfSamples.jet perf_flight_dump_open). A dump kept elsewhere
// leaves it relative to the working directory.
native_dump_source: fn(path: String, source: &&String) -> String Never! {
    if source == "" || native_dump_files.is_absolute(source) -> return source
    dumps: native_dump_files.dirname(path)
    kept: native_dump_files.dirname(dumps)
    if native_dump_files.basename(dumps) != "dumps" || native_dump_files.basename(kept) != ".jet" {
        return source
    }
    ran: native_dump_files.dirname(kept)
    if ran == "" -> return source
    native_dump_files.join(ran, source)
}

// One console command's readout of the dump: `line`, as read. `events` are
// the flight ring's records (native_dump_events), and `file` (with the text
// `lines`) the program's source.
native_dump_command: fn(session: &NativeSession, line: String, events: [String], file: String, lines: [String]) -> String NativeDebugError! {
    command: line.trim()
    word: command.before(" ")
    operand: if command.contains(" ") -> command.after(" ").trim() else -> ""
    if word == {
        "bt" | "backtrace" -> {
            frames: session.backtrace() ?? return Err(err)
            Ok(native_debug_backtrace(frames))
        }
        "locals" -> {
            locals := native_dump_locals(session) ?? return Err(err)
            locals.sort_by(fn(left: NativeLocal, right: NativeLocal) { left.name <=> right.name })
            Ok(native_debug_locals_typed(locals))
        }
        // A dump runs no code, so nothing is evaluated: `print` shows a
        // local of the selected frame by its name, as `locals` reads it.
        "p" | "print" -> {
            if operand == "" -> return Ok("Print needs a local's name, as `print total`\n")
            locals: native_dump_locals(session) ?? return Err(err)
            loop local in locals {
                if local.name == operand -> return Ok("{local.name} = {local.value}\n")
            }
            Ok("Can't evaluate `{operand}`: a dump runs no code, so `print` shows a local by its name; `locals` lists them\n")
        }
        "frame" -> {
            frames: session.backtrace() ?? return Err(err)
            wanted: Int.parse(operand) ?? -1
            index: native_dump_jet_frame(frames, wanted) ?? return Ok("No frame {operand}; `bt` lists them\n")
            selected: session.select_frame(index) ?? return Err(err)
            if !selected -> return Ok("No frame {operand}; `bt` lists them\n")
            native_dump_frame(session, frames, index, file, lines)
        }
        "tasks" -> Ok(native_dump_task_list(session, file))
        "task" -> {
            wanted: Int.parse(operand) ?? -1
            index: native_dump_task_index(session, wanted) ?? return Ok("No task {operand}; `tasks` lists them\n")
            session.task = index
            frames: session.backtrace() ?? return Err(err)
            stop: native_dump_jet_frame(frames, 0) ?? 0
            _ := session.select_frame(stop) ?? return Err(err)
            native_dump_frame(session, frames, stop, file, lines)
        }
        "events" -> {
            last: if operand.starts_with("--last") -> Int.parse(operand.after("--last").trim()) ?? NATIVE_DUMP_EVENTS else -> NATIVE_DUMP_EVENTS
            from: if last >= 0 && events.len() > last -> events.len() - last else -> 0
            text := if events.len() == 0 -> "No events in the flight ring\n" else -> ""
            loop index in from..<events.len() -> text = "{text}{events[index]}\n"
            Ok(text)
        }
        "s" | "step" | "n" | "next" | "c" | "continue" | "f" | "finish" | "b" | "break" -> Ok("A dump doesn't run: it is the program as it stopped. {NATIVE_DUMP_HELP}\n")
        "h" | "help" -> Ok("{NATIVE_DUMP_HELP}\n")
        "" -> Ok("")
        else -> Ok("Unknown command `{word}`. {NATIVE_DUMP_HELP}\n")
    }
}

// The selected frame's locals, each #Secret one redacted.
native_dump_locals: fn(session: &NativeSession) -> [NativeLocal] NativeDebugError! {
    locals := session.locals() ?? return Err(err)
    native_dump_redact(locals)
    Ok(locals)
}

// Each task of the dump, one line each, the selected one marked `*`: its
// id (a thread outside every task by its tid), whether it was stopped,
// running or parked, or the wait a deadlock held it in, its innermost Jet
// frame, and, when that is not in the program's `file`, the innermost frame
// that is.
native_dump_task_list: fn(session: &NativeSession, file: String) -> String Never! {
    tasks: if session.dump == .Val(dumped) -> dumped.tasks else -> [NativeDumpTask]{}
    waits: if session.dump == .Val(dumped) -> native_dump_waits(dumped.memory, dumped.registry) else -> [Int:String]{}
    chosen: session.task
    text := ""
    loop (index, task) in tasks {
        session.task = index
        frames: session.backtrace() ?? [NativeFrame]{}
        mark: if index == chosen -> "*" else -> " "
        name: if task.id == 0 -> "thread {task.tid}" else -> "task {task.id}"
        text = "{text}{mark} {name}  {native_dump_task_state(task, waits)}{native_dump_located(frames, file)}\n"
    }
    session.task = chosen
    text
}

// The index among the dump's tasks of task `id`.
native_dump_task_index: fn(session: NativeSession, id: Int) -> Int? Never! {
    if session.dump == .Val(dumped) {
        loop (index, task) in dumped.tasks {
            if task.id == id -> return Val(index)
        }
    }
    None
}

// `  in <function>() at <file>:<line>` for the innermost Jet frame of
// `frames`, then `, from …` the innermost in the program's `file` when that
// is another; "" when none is Jet code.
native_dump_located: fn(frames: [NativeFrame], file: String) -> String Never! {
    innermost: native_dump_jet_frame(frames, 0) ?? return ""
    frame: frames[innermost]
    shown: "  in {frame.function}() at {frame.file}:{frame.line}"
    if frame.file == file -> return shown
    loop index in innermost..<frames.len() {
        caller: frames[index]
        if native_debug_jet_frame(caller) && caller.file == file {
            return "{shown}, from {caller.function}() at {caller.file}:{caller.line}"
        }
    }
    shown
}

// Frame `index` of `frames`: where it is, its Jet source line
// (NativeSession.frame_source), and its locals.
native_dump_frame: fn(session: &NativeSession, frames: [NativeFrame], index: Int, file: String, lines: [String]) -> String NativeDebugError! {
    if index >= frames.len() -> return Ok("No Jet frame in the dump\n")
    frame: frames[index]
    source: session.frame_source(frame, file, lines)
    locals: native_dump_locals(session) ?? return Err(err)
    Ok("Stopped  {frame.file}:{frame.line}  in {frame.function}()\n{frame.line} | {source}        <- here\n{native_debug_locals_line(locals)}\n")
}

#Test("a dump's relative source is in the directory whose .jet/dumps holds the dump") {
    assert_eq(native_dump_source("/w/run/.jet/dumps/crash-1.jetdump", "crash.jet"), "/w/run/crash.jet")
    assert_eq(native_dump_source("/w/run/.jet/dumps/crash-1.jetdump", "/src/crash.jet"), "/src/crash.jet")
    assert_eq(native_dump_source("/w/kept/crash-1.jetdump", "crash.jet"), "crash.jet")
    assert_eq(native_dump_source("/w/run/.jet/dumps/crash-1.jetdump", ""), "")
}
