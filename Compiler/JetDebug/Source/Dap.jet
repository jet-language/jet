            &self.respond_jet_error(out, request_seq, command, 22031, "source repair requires a stopped target")
            return
        }
        current :: self.current_history_index() ?? {
            &self.respond_jet_error(out, request_seq, command, 22034, "fix unavailable: this session has no recorded source history")
            return
