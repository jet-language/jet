    fn replay_forward_history(self: &DapServer, out: &io.Write, request_seq: I64, command: String, response_command: String?) {
        response_command :: response_command ?? command
        current :: self.current_history_index() ?? {
            &self.respond_jet_error(out, request_seq, command, 22034, "forward replay unavailable: this session has no recorded source history")
            return
        }
