    fn record_history_event(self: &DapServer, backtrace: String, jet_line: USize) {
        frames := [FrameSnapshot]{}
        loop frame in Inferior.parse_frames(backtrace) {
            line :: self.map.jet_line_for_file(frame.rust_file, self.rust_file, frame.rust_line) ?? next
            &frames.push(FrameSnapshot { function: Inferior.rust_func_to_jet(frame.func), line: line })
        }
        function :: if frames.first() == .Val(frame) -> frame.function.copy() else -> "<native>"
        locals := [ValueSnapshot]{}
        if self.inf == .Val(inf) {
            if &inf.locals() == .Ok(raw) {
                loop (type_name, rust_name, raw_value) in Inferior.parse_typed_locals(raw) {
                    name :: Inferior.rust_local_to_jet(rust_name) ?? next
                    value :: Inferior.safe_value(type_name, raw_value)
                    &locals.push(ValueSnapshot { name: ^name, type_name: ^type_name, value: ^value })
                }
            }
        }
        writes := [DebugWrite]{}
        if self.history.events.last() == .Val(previous) {
            loop current in locals {
                loop old in previous.locals {
                    if old.name != current.name -> next
                    if old.value != current.value -> &writes.push(DebugWrite { line: jet_line, place: current.name.copy(), old_value: old.value.copy(), new_value: current.value.copy() })
                    break
                }
            }
        }
        sequence :: if self.history.events.last() == .Val(event) -> event.sequence.saturating_add(1) else -> 0
        &self.history.push(DebugEvent {
            sequence: sequence, function: ^function, line: jet_line, depth: 0,
            stack: ^frames, locals: ^locals, writes: ^writes
        })
