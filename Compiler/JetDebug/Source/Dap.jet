    fn emit_history_stop(self: &DapServer, out: &io.Write, reason: String) {
        &self.invalidate_references()
        self.state = .Stopped
        thread_id :: self.current_thread.max(1)
        description := "recorded Jet source event"
        if self.history_event() == .Val(event) {
            description = "recorded event {event.sequence} at {self.source_path()}:{self.dap_line(event.line)}"
            if event.writes.first() == .Val(write) -> description += " (write {write.place}: {write.old_value} -> {write.new_value})"
        }
        &self.event(out, "stopped", "{{\"reason\":\"{foundation_json_escape(reason)}\",\"description\":\"{foundation_json_escape(description)}\",\"threadId\":{thread_id},\"allThreadsStopped\":true}}")
