        read :: std.fs.read_to_string(OSPath.from(self.jet_file))
        if read == .Err(_) {
            &self.respond_jet_error(out, request_seq, command, 22039, "fix rejected: the selected Jet source could not be read")
            return
        }
        source_on_disk :: read ?? panic("failed source read branch returned")
        if source_on_disk == self.jet_src {
            &self.respond_jet_error(out, request_seq, command, 22034, "fix unavailable: source is unchanged; edit the selected file and retry")
            return
        }
        checked :: jet_debug.checked_bundle_for_fix(self.jet_file)
        if checked == .Err(reason) {
            &self.respond_jet_error(out, request_seq, command, 22034, "fix rejected: {reason}")
            return
        }
        (_, candidate_source, candidate_shape) :: checked ?? panic("failed check branch returned")
        if self.history.checkpoint == .Val(checkpoint) {
            shape :: checkpoint.shape
            if shape != "native-dap-debug-artifact" && shape != "native-debug-artifact" && shape != candidate_shape {
                &self.respond_jet_error(out, request_seq, command, 22034, "fix rejected: checkpoint incompatible (source type, layout, or authority changed); restart required")
                return
            }
        }
        built :: build_native_candidate(self.jet_file, self.rust_file, candidate_source)
        if built == .Err(reason) {
            &self.respond_jet_error(out, request_seq, command, 22034, "fix rejected: native candidate was not built: {reason}")
            return
        }
        candidate :: built ?? panic("failed candidate branch returned")
        if self.inf == None {
            &self.respond_jet_error(out, request_seq, command, 22031, "fix rejected: the native target is no longer available")
            return
        }
        inferior :: self.inf ?? panic("missing target branch returned")
        activated :: &inferior.rebind_native_candidate(candidate.binary, self.rust_src, candidate.rust_source)
        if activated == .Err(error) {
            &self.respond_jet_error(out, request_seq, command, 22034, "fix rejected: native candidate was not activated: {error}")
            return
        }
        receipt :: activated ?? panic("failed activation branch returned")
        if self.history.checkpoint == .Val(checkpoint) {
            checkpoint.source_identity = jet_foundation.SHA256.sha256_hex("{self.jet_file}:{candidate_source}".as_bytes())
            checkpoint.shape = ^candidate_shape
        }
        self.rust_src = candidate.rust_source.copy()
        self.map = LineMap.build(self.rust_src)
        self.jet_src = ^candidate_source
        self.history.cursor = .Val(current)
        self.history_cursor = .Val(current)
        self.replay_only_after_fix = false
        changed := [String]{}
        loop name in receipt.changed -> &changed.push("\"{foundation_json_escape(name)}\"")
        sequence :: if self.history.events.get(current) == .Val(event) -> event.sequence else -> 0
        body :: "{{\"checkpoint\":\"compatible\",\"native\":\"committed\",\"buildId\":\"{foundation_json_escape(candidate.build_id)}\",\"changed\":[{changed.join(",")}],\"source\":\"{foundation_json_escape(self.source_path())}\",\"historySequence\":{sequence}}}"
        &self.candidate_artifacts.push(^candidate)
        &self.respond(out, request_seq, command, true, body)
    }
