    // Rust: crates/jet-debug/src/Dap.rs:1030
    fn replay_native_history(self: DapServer, command: String, start: USize, include_controls: Bool) -> DebugHistory Err! {
        if self.history.events.is_empty() -> return .Err("reverse unavailable: this session has no recorded source history")
        if start >= self.history.events.len() -> return .Err("reverse unavailable: the requested native stop is no longer retained")
        expected_identity :: jet_foundation.SHA256.sha256_hex("{self.jet_file}:{self.jet_src}".as_bytes())
        if self.history.checkpoint == .Val(checkpoint) {
            if checkpoint.source_identity != expected_identity -> return .Err("native history no longer matches the selected Jet source")
        }
        history := self.history.copy()
        history.cursor = .Val(start)
        inputs := [String]{}
        if include_controls {
            loop line in self.pending_breakpoints -> &inputs.push("break {line}")
            loop (watch, _) in self.data_watches -> &inputs.push("watch {watch}")
        }
        &inputs.push(command.copy())
        result :: jet_debug.run_native_session_replay(self.jet_file, self.jet_src, history, inputs, true)
        if result.status != .Running -> return .Err("native source history could not be replayed")
        if result.history.cursor == None -> return .Err("native replay returned no retained stop")
        return .Ok(^result.history)
    }
    // Rust: crates/jet-debug/src/Dap.rs:1081
    fn history_write_matches(self, event: DebugEvent) -> Bool {
        loop write in event.writes {
            loop (watch, _) in self.data_watches {
                if watch == write.place || write.place.starts_with("{watch}.") || watch.starts_with("{write.place}.") -> return true
            }
        }
        return false
    }
