            .InvalidArguments -> (_0: 22032, _1: "debug attach arguments are invalid")
            .MapMismatch -> (_0: 22037, _1: "debugger map does not match the attach target")
            .Denied -> (_0: 22037, _1: "debug attach target is not authorized")
            .Unavailable -> (_0: 22034, _1: "the local attach target is unavailable")
        }
