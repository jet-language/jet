// Rust: crates/jet-debug/src/Dap.rs:472
fn project_frames(frames: [RawFrame], map: LineMap, rust_file: String, show_raw_frames: Bool) -> [ProjectedFrame] {
    projected := [ProjectedFrame]{}
    loop (position, frame) in frames {
        line :: map.jet_line_for_file(frame.rust_file, rust_file, frame.rust_line) ?? next
        &projected.push(ProjectedFrame { position: position, frame: frame, jet_line: .Val(line), raw: false })
    }
    if show_raw_frames {
        loop (position, frame) in frames -> &projected.push(ProjectedFrame {
            position: position, frame: frame,
            jet_line: map.jet_line_for_file(frame.rust_file, rust_file, frame.rust_line), raw: true
        })
    }
    return projected
}
// Rust: crates/jet-debug/src/Dap.rs:511
fn has_jet_frame(frames: [RawFrame], map: LineMap, rust_file: String) -> Bool {
    loop frame in frames {
        if map.jet_line_for_file(frame.rust_file, rust_file, frame.rust_line) != None -> return true
    }
    return false
}
// Rust: crates/jet-debug/src/Dap.rs:523
fn jet_thread_name(thread_id: U32, backtrace: String, map: LineMap, rust_file: String) -> String {
    if thread_id == 1 -> return "main"
    loop frame in Inferior.parse_frames(backtrace) {
        if map.jet_line_for_file(frame.rust_file, rust_file, frame.rust_line) == None -> next
        function :: Inferior.safe_jet_func(frame.func)
        if function != "<native frame>" -> return "task {function} (stopped)"
        break
    }
    return "task (stopped)"
}
