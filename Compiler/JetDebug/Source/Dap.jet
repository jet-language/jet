// Rust: crates/jet-debug/src/Dap.rs:66
fn run(binary: OSPath, rust_file: String, rust_src: String, jet_file: String, jet_src: String) -> I32 {
    map_path :: binary.with_extension("jetmap")
    written :: LineMap.write_artifact(map_path, jet_file, jet_src, rust_file, rust_src, binary)
    if written == .Err(error) {
        io.eprintln("error: cannot write native debugger map: {error}") // GATE #4494
        return ExitCodes.USER_ERROR
    }
    loaded :: LineMap.load_verified(map_path, jet_file, jet_src, rust_file, rust_src, binary)
    if loaded == .Err(error) {
        io.eprintln("error: native debugger map is not usable: {error}") // GATE #4494
        return ExitCodes.USER_ERROR
    }
    map :: loaded ?? panic("failed map branch returned")
    server := DapServer {
        map: ^map, rust_file: rust_file.copy(), rust_src: rust_src.copy(), jet_file: jet_file.copy(),
        jet_src: jet_src.copy(), binary: binary.copy(), inf: None, pending_breakpoints: [],
        pending_specs: [], hit_counts: [], source_breakpoint_ids: [], client_breakpoint_ids: [],
        next_client_breakpoint_id: 1, entry_breakpoint_id: None, stop_on_entry: true,
        target: None, launch_args: [], launch_cwd: None, launch_env: [],
        current_thread: 1, last_signal: None, last_exception: None,
        exception_filters: default_exception_filters(), show_raw_frames: false,
        lines_start_at_1: true, columns_start_at_1: true, supports_ansi_styling: false,
        unmapped_steps: 0, references: ObjectReferences.default(), state: .New,
        terminal_failure: false, client_sequences: [U32:Bool]{}, seq: 1,
        resume_task: None, resume_stop_requested: false,
        history: DebugHistory {
            events: [], checkpoint: .Val(DebugCheckpoint {
                source_identity: jet_foundation.SHA256.sha256_hex("{jet_file}:{jet_src}".as_bytes()),
                shape: native_checkpoint_shape(jet_file, jet_src), sequence: 0
            }), cursor: None, capped: false, decision_ledger: None
        },
        history_cursor: None, data_watches: [String:Bool]{},
        candidate_artifacts: [], replay_only_after_fix: false
    }
    // GATE #4494: retained real stdin/stdout, not synthetic protocol streams.
    reader :: io.BufReader.new(io.stdin())
    stdout := io.stdout()
    return run_io(&server, ^reader, &stdout)
}

// Rust: crates/jet-debug/src/Dap.rs:142
fn run_io(server: DapServer, reader: io.BufRead, out: io.Write) -> I32 {
    // GATE #4494: real channel/thread ownership and IO error fidelity #4409.
    (input_tx, input_rx) :: mpsc.channel[io.Result[String?]]()
    _ :: std.thread.spawn(() -> {
        reader := ^reader
        loop {
            message :: read_message(&reader)
            done :: message != .Val(_)
            if input_tx.send(^message).is_err() || done -> break
        }
    })
    requests := VecDeque[Dyn].new()
    input_closed := false
    loop {
        &server.poll_resume(out)
        if server.state == .Terminated || server.terminal_failure -> break
        if take_next_request(&requests, server.has_pending_resume()) == .Val(msg) {
            if &server.handle(msg, out) == None || server.state == .Terminated || server.terminal_failure -> break
            next
        }
        if input_closed && (!server.has_pending_resume() || requests.is_empty()) -> break
        received :: input_rx.recv_timeout(Duration.from_millis(10))
        if received == {
            .Ok(.Val(body)) -> {
                parsed :: parse_dap_request(body)
                if parsed == {
                    .Ok(msg) -> &requests.push_back(^msg)
                    .Err(error) -> {
                        io.eprintln("error: invalid DAP request: {error}")
                        return &server.finish(ExitCodes.USER_ERROR)
                    }
                }
            }
            .Ok(.None) -> input_closed = true
            .Ok(.Err(error)) -> {
                // Uncorrelated framing/UTF-8 failures produce no fabricated reply.
                io.eprintln("error: invalid DAP frame: {error}")
                return &server.finish(ExitCodes.USER_ERROR)
            }
            .Err(.Timeout) -> {}
            .Err(.Disconnected) -> input_closed = true
        }
    }
    return &server.finish(ExitCodes.OK)
}

// Rust: crates/jet-debug/src/Dap.rs:201
fn is_running_control_request(msg: Dyn) -> Bool {
    command :: json_str(json_get(msg, "command") ?? return false) ?? return false
    return command == "cancel" || command == "disconnect" || command == "pause" ||
        command == "restart" || command == "setBreakpoints" ||
        command == "setDataBreakpoints" || command == "terminate"
}
// Rust: crates/jet-debug/src/Dap.rs:216
fn take_next_request(requests: VecDeque<Dyn>, resume_pending: Bool) -> Dyn? {
    if resume_pending {
        loop (position, request) in requests {
            if is_running_control_request(request) -> return &requests.remove(position)
        }
        return None
    }
    return &requests.pop_front()
}

// Rust: crates/jet-debug/src/Dap.rs:230
struct DapServer {
    map: LineMap
    rust_file: String
