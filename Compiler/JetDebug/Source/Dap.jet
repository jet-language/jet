    entry_breakpoint_id: USize?
    stop_on_entry: Bool
    target: TargetKind?
    launch_args: [String]
    launch_cwd: String?
    launch_env: [(String, String)]
    current_thread: U32
    last_signal: String?
    last_exception: String?
    exception_filters: [String:Bool]
    show_raw_frames: Bool
    lines_start_at_1: Bool
    columns_start_at_1: Bool
    supports_ansi_styling: Bool
    unmapped_steps: USize
    references: ObjectReferences
    state: State
    // Failed close/terminal diagnostics survive consumption of the inferior.
    terminal_failure: Bool
    client_sequences: [U32:Bool]
    seq: I64
    resume_task: ResumeTask?
    resume_stop_requested: Bool
    history: DebugHistory
    history_cursor: USize?
    data_watches: [String:Bool]
    // Keep typed candidate code rooted as long as LLDB may call it.
    candidate_artifacts: [NativeCandidateArtifact]
    replay_only_after_fix: Bool
}
