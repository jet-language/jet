    fn history_stack_body(self: DapServer, thread_id: U32, start_frame: USize, levels: USize?) -> String? {
        event :: self.history_event() ?? return None
        stack :: if event.stack.is_empty() -> [FrameSnapshot { function: ^event.function, line: event.line }] else -> ^event.stack
        total_frames :: stack.len()
        entries := [String]{}
        limit :: levels ?? USize.MAX
        loop (position, frame) in stack {
            if position < start_frame -> next
            if entries.len() == limit -> break
            id :: &self.references.issue_frame(thread_id, position)
            &entries.push("{{\"id\":{id},\"name\":\"{foundation_json_escape(frame.function)}\",\"source\":{{\"path\":\"{foundation_json_escape(self.source_path())}\"}},\"line\":{self.dap_line(frame.line)},\"column\":{self.dap_column(1)}}}")
        }
        return "{{\"stackFrames\":[{entries.join(",")}],\"totalFrames\":{total_frames}}}"
    }
