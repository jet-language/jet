// Rust: crates/jet-debug/src/Dap.rs:319
impl ResumeTask {
    // Rust: crates/jet-debug/src/Dap.rs:320
    fn spawn(inferior: Inferior, command: String, mode: ResumeMode) -> ResumeTask {
        // GATE #4494: real channels, shared atomic lifetime, threads and joins.
        (control, control_rx) :: mpsc.channel[ResumeControl]()
        (events, event_rx) :: mpsc.channel[ResumeEvent]()
        stop :: control.clone()
        pid :: inferior.debugger_pid()
        interrupted :: Arc.new(AtomicBool.new(false))
        worker_interrupted :: interrupted.clone()
        join :: std.thread.spawn(() -> {
            signaler :: std.thread.spawn(() -> {
                loop {
                    received :: control_rx.recv()
                    if received == .Err(_) -> break
                    if received == .Ok(control) {
                        if control == {
                            .Interrupt -> {
                                worker_interrupted.store(true, Ordering.Release)
                                _ :: signal_debugger(pid)
                            }
                            .Stop -> { break }
                        }
                    }
                }
            })
            inferior := ^inferior
            result :: &inferior.resume_and_locate(command)
            _ :: stop.send(.Stop)
            _ :: signaler.join()
            _ :: events.send(ResumeEvent {
                inferior: ^inferior, result: ^result,
                mode: if interrupted.load(Ordering.Acquire) -> .Pause else -> mode
            })
        })
        return ResumeTask { control: ^control, events: ^event_rx, join: .Val(^join) }
    }
    // Rust: crates/jet-debug/src/Dap.rs:360
    fn interrupt(self) { _ :: self.control.send(.Interrupt) }
    // Rust: crates/jet-debug/src/Dap.rs:364
    fn take_event(self: ResumeTask) -> ResumeEvent? !() {
        if self.events.try_recv() == {
            .Ok(event) -> {
                if &self.join.take() == .Val(join) -> _ :: join.join()
                return .Val(^event)
            }
            .Err(.Empty) -> { return .None }
            .Err(.Disconnected) -> { return .Err(_) }
        }
    }
    // Rust: crates/jet-debug/src/Dap.rs:377
    fn wait(self: ResumeTask) -> ResumeEvent IOError! {
        self := ^self
        self.interrupt()
        received :: self.events.recv()
        if received == .Err(_) -> return .Err(io.Error.new(.UnexpectedEof, "native debugger resume worker closed before settling"))
        event :: received ?? panic("error branch returned")
        if &self.join.take() == .Val(join) -> _ :: join.join()
        return .Ok(^event)
    }
}

// Rust: crates/jet-debug/src/Dap.rs:393,408
fn signal_debugger(pid: U32) IOError! {
    // GATE #4483: dispatch on selected target, never host cfg.
    if selected_family() == .Unix {
        // GATE #4494: native process spawn/wait. #4409 retains error kinds.
        status :: std.process.Command.new("kill").args(["-INT", pid.to_string()]).status()
        if status.success() -> return .Ok(_)
        return .Err(io.Error.new(.Other, "native debugger rejected the interrupt signal"))
    }
    return .Err(io.Error.new(.Unsupported, "native debugger interruption is unsupported on this platform"))
}
