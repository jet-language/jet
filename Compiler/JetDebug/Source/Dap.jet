    fn data_breakpoint_info(self: &DapServer, out: &io.Write, request_seq: I64, command: String, args: Dyn?) {
        if self.state == .Terminated {
            &self.respond_jet_error(out, request_seq, command, 22031, "data breakpoint information is unavailable after target termination")
            return
        }
        name := String?{None}
        if args == .Val(args) {
            if json_get(args, "name") == .Val(value) {
                if json_str(value) == .Val(text) {
                    trimmed := text.trim() // #4303
                    if jet_expression(trimmed) != None -> name = trimmed
                }
            }
        }
        selected :: name ?? {
            &self.respond_jet_error(out, request_seq, command, 22032, "dataBreakpointInfo requires a bounded Jet local path in `name`")
            return
        }
        &self.respond(out, request_seq, command, true, "{{\"dataId\":\"{foundation_json_escape(selected)}\",\"description\":\"Jet write watch: {foundation_json_escape(selected)}\",\"accessTypes\":[\"write\"],\"canPersist\":false}}")
    }
    // Rust: crates/jet-debug/src/Dap.rs:1134
    fn set_data_breakpoints(self: &DapServer, out: &io.Write, request_seq: I64, command: String, args: Dyn?) {
        if self.state != .Ready && self.state != .Configuring && self.state != .Running && self.state != .Stopped {
