    // Rust: crates/jet-debug/src/Inferior.rs:387
    fn drain_file(path: &OSPath, pos: &U64) -> String {
        f := match File.open(path) { .Ok(f) -> ^f; .Err(_) -> return "" }
        if f.seek(.Start(pos)).is_err() -> return ""
        buf := ""
        if f.read_to_string(&buf).is_ok() -> pos += buf.len() as U64
        return ^buf
    }
    // Rust: crates/jet-debug/src/Inferior.rs:405
    fn write_lines(self: &Self, lines: &[String]) -> io.Result[String] {
        // GATE #4494: timed receive and monotonic clock, real control pipe.
        for line in lines -> self.stdin.write_all("{line}\n".as_bytes())?
        self.stdin.write_all("{SENTINEL}\n".as_bytes())?
        self.stdin.flush()?
        buf := [U8]{}
        deadline :: Instant.now() + READ_TIMEOUT
        loop {
            remaining :: deadline.saturating_duration_since(Instant.now())
            if remaining.is_zero() -> return .Err(io.Error.new(.TimedOut, "lldb did not finish the debugger command before timeout"))
            byte :: match self.rx.recv_timeout(remaining) {
                .Ok(b) -> b
                .Err(.Timeout) -> return .Err(io.Error.new(.TimedOut, "lldb did not finish the debugger command before timeout"))
                .Err(.Disconnected) -> return .Err(io.Error.new(.UnexpectedEof, "lldb closed the debugger control channel"))
            }
            buf.push(byte)
            if sentinel_echo_at_end(buf) -> break
        }
        text :: String.from_utf8_lossy(buf).into_owned()
        cut :: text.rfind("(lldb) {SENTINEL}").unwrap_or(text.len())
        return .Ok(text[..cut].to_string())
    }
