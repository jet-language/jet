    // Rust: crates/jet-debug/src/Inferior.rs:471
    pub fn rebind_native_candidate(self: &Self, candidate_binary: &OSPath, host_source: String, candidate_source: String) -> io.Result[NativeRebindReceipt] {
        host :: native_callable_metadata(host_source).map_err((error) -> io.Error.new(.InvalidData, "host native artifact has invalid rebind metadata: {error}"))?
        candidate :: native_callable_metadata(candidate_source).map_err((error) -> io.Error.new(.InvalidData, "candidate native artifact has invalid rebind metadata: {error}"))?
        if host.is_empty() -> return .Err(io.Error.new(.Unsupported, "host native artifact does not publish typed rebind metadata"))
        if candidate.is_empty() -> return .Err(io.Error.new(.Unsupported, "candidate native artifact does not publish typed rebind metadata"))
        changed := [String]{}
        pairs := []
        for candidate_row in candidate {
            host_row :: host.iter().find((row) -> row.name == candidate_row.name).ok_or_else(() -> io.Error.new(.InvalidData, "candidate callable {candidate_row.name} has no compatible host slot"))?
            if host_row.schema != 1 || candidate_row.schema != 1 -> return .Err(io.Error.new(.InvalidData, "native callable metadata schema is unsupported"))
            if host_row.jet != candidate_row.jet || host_row.signature != candidate_row.signature || host_row.state != "none" || candidate_row.state != "none" -> return .Err(io.Error.new(.InvalidData, "native callable {candidate_row.name} changed its ABI, Jet identity, or state contract"))
            if host_row.install.is_empty() || host_row.entry.is_empty() || candidate_row.entry.is_empty() -> return .Err(io.Error.new(.InvalidData, "native callable {candidate_row.name} has incomplete rebind symbols"))
            if host_row.body != candidate_row.body {
                changed.push(~candidate_row.jet)
                pairs.push((~host_row, ~candidate_row))
            }
        }
        if changed.is_empty() -> return .Err(io.Error.new(.InvalidInput, "candidate native artifact contains no changed typed callable"))
        backtrace :: self.backtrace()?
        for frame in Self.parse_frames(backtrace) {
            frame_jet :: Self.safe_jet_func(frame.func)
            if changed.iter().any((name) -> name == frame_jet) -> return .Err(io.Error.new(.WouldBlock, "cannot rebind native callable {frame_jet} while its frame is active"))
        }
        for (host_row, _candidate_row) in pairs {
            self.require_symbol(host_row.install, "host installer")?
            self.require_symbol(host_row.entry, "host entry")?
        }
        candidate_path :: checked_lldb_quote(candidate_binary.to_string_lossy())?
        load_output :: self.cmd("process load {candidate_path}")?
        if lldb_command_failed(load_output) -> return .Err(io.Error.new(.InvalidData, "lldb rejected the native candidate module: {compact_output(load_output)}"))
        for (_host_row, candidate_row) in pairs {
            if self.require_symbol(candidate_row.entry, "candidate entry") == .Err(error) {
                _ :: self.cmd("process unload {candidate_path}")
                return .Err(^error)
            }
        }
        for (index, (host_row, candidate_row)) in pairs.iter().enumerate() {
            if self.install_native_slot(host_row.install, candidate_row.entry) == .Err(error) {
                for (rollback_host, _) in pairs[..index + 1].iter().rev() -> _ :: self.install_native_slot(rollback_host.install, rollback_host.entry)
                _ :: self.cmd("process unload {candidate_path}")
                return .Err(^error)
            }
        }
        return .Ok(NativeRebindReceipt { changed: ^changed })
    }
