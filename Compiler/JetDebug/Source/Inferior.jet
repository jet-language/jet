            for arg in args -> rendered.push(checked_lldb_quote(arg)?)
            self.cmd("settings set target.run-args {rendered.join(" ")}")?
        }
        if cwd == .Val(cwd) -> self.cmd("settings set target.process.cwd {checked_lldb_quote(cwd)?}")?
        assignments := [String].with_capacity(env.len())
        for (key, value) in env {
            if key.is_empty() || !key.chars().all((c) -> c.is_ascii_alphanumeric() || c == '_') -> return .Err(io.Error.new(.InvalidInput, "invalid launch environment key `{key}`"))
            assignments.push(checked_lldb_quote("{key}={value}")?)
        }
        if !assignments.is_empty() -> self.cmd("settings set target.env-vars {assignments.join(" ")}")?
        return .Ok(())
    }
