    fn read_until_resume_settled(self: &Self, text: String) -> io.Result[String] {
        text := ^text
        if resume_settled(text) -> return .Ok(^text)
        deadline :: Instant.now() + READ_TIMEOUT
        loop {
            remaining :: deadline.saturating_duration_since(Instant.now())
            if remaining.is_zero() -> return .Err(io.Error.new(.TimedOut, "lldb did not report a stopped or exited target before timeout"))
            byte :: match self.rx.recv_timeout(remaining) {
                .Ok(byte) -> byte
                .Err(.Timeout) -> return .Err(io.Error.new(.TimedOut, "lldb did not report a stopped or exited target before timeout"))
                .Err(.Disconnected) -> return .Err(io.Error.new(.UnexpectedEof, "lldb closed the debugger control channel before the target settled"))
            }
            text.push(byte as Char)
            if resume_settled(text) -> return .Ok(^text)
        }
    }
