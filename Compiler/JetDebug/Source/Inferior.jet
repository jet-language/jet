            }
            return .Err(io.Error.new(.UnexpectedEof, "lldb closed before detach was proven"))
        }
        if self.attached.as_ref() == .Val(identity) {
            if identity.verify() == .Err(error) {
                if error.kind() == .NotFound { self.attached = None; self.detached = true; return .Ok(()) }
                return .Err(^error)
            }
        }
        output :: self.cmd("process detach")?
        if lldb_reported_error(output) && !output.contains("no process") -> return .Err(io.Error.new(.Other, "lldb could not detach from the debuggee"))
        if self.attached.as_ref() == .Val(identity) {
            if identity.verify_running() == .Err(error) {
                if error.kind() != .NotFound -> return .Err(^error)
            }
        }
        self.attached = None
        self.detached = true
        return .Ok(())
    }
