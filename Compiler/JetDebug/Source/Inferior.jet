//RS                 // rides into Rust as `__jet_ct_<name>`, so give the mark back.
//RS                 match rest.strip_prefix("ct_") {
//RS                     Some(marked) => format!("{}{marked}", Syntax::COMPTIME_MARK),
//RS                     None => rest.to_string(),
//RS                 }
//RS             })
//RS     }
