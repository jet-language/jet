// PORT-PENDING 0750 crates-jet-debug-src-inferior: crates/jet-debug/src/Inferior.rs:1-2129
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! D-DBG3 step 2 (dap-debugger): drives a real `lldb` process over piped
//RS //! stdin/stdout (I6 — no debugger library, no MI/JSON crate; std `process` pipes
//RS //! only). This is the ONLY module that shells out to `lldb`; every caller (the
//RS //! native `(jet)` prompt and the DAP adapter) goes through [`Inferior`] and never
//RS //! spawns lldb itself.
//RS //!
//RS //! lldb is a runtime TOOL dependency on the user's machine, not an I6 compiler
//RS //! crate (same posture as nixpkgs for native/system deps) — [`Inferior::available`]
//RS //! gates every call site so a missing lldb degrades to a clear message pointing at
//RS //! the step-1 interpreter debugger, never a panic.
//RS //!
//RS //! Two lldb quirks this module works around, both confirmed against a live
//RS //! lldb (not just documentation — see the sidequest doc for the trace):
//RS //! 1. Driven over a plain pipe (no TTY), lldb never re-prints a bare `(lldb) `
//RS //!    "ready" prompt between commands — it only echoes `(lldb) <the command
//RS //!    just read>` as a transcript marker. Waiting for a bare prompt to
//RS //!    reappear hangs forever. Every command is instead followed by a bogus
//RS //!    sentinel command (its rejection is deterministic and unique); reads run
//RS //!    until the sentinel's own echo appears.
//RS //! 2. A resuming command's (`run`/`continue`/step) own stop banner is printed
//RS //!    by an asynchronous event listener. While the target is running, bytes
//RS //!    written after the resume command go to the target's stdin, not LLDB's
//RS //!    command parser. [`Self::resume_and_locate`] therefore writes only the
//RS //!    resume command, waits for the stopped/exited event, then asks for `bt`
//RS //!    through the normal sentinel-framed command path.
//RS //! 3. By default the debuggee INHERITS lldb's own stdout/stderr, so a Jet
//RS //!    `print()` can land byte-interleaved into the middle of lldb's own
//RS //!    sentinel echo (confirmed live: a `total is 6` program print tore the
//RS //!    sentinel in half, `__` + `total is 6\n` + the rest, hanging the sentinel
//RS //!    search). `Self::spawn` redirects the debuggee's stdout/stderr to their
//RS //!    own temp files via `settings set target.output-path`/`error-path`
//RS //!    BEFORE the first `run`, so lldb's control channel and the debuggee's
//RS //!    program output never share a byte stream; [`Self::drain_program_output`]
//RS //!    reads what's new since the last check.
//RS //!
//RS //! Phase 1 targets lldb on Linux/macOS (the plan's stated scope); gdb and Windows
//RS //! are follow-ups, not silently pretended here.
//RS 
//RS use jet_foundation::Names::mangle;
//RS use jet_foundation::{Syntax, SHA256};
//RS use std::fs::OpenOptions;
//RS use std::io::{self, Read, Seek, SeekFrom, Write};
//RS #[cfg(target_os = "linux")]
//RS use std::os::fd::AsRawFd;
//RS #[cfg(unix)]
//RS use std::os::unix::fs::OpenOptionsExt;
//RS use std::path::{Path, PathBuf};
//RS use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
//RS use std::sync::mpsc::Receiver;
//RS use std::time::{Duration, Instant};
//RS /// Bogus command sent after every real one. lldb echoes then rejects it
//RS /// (`error: '<sentinel>' is not a valid command.`, to stderr, which we null —
//RS /// see the module doc point 1); its echo appearing on stdout is the ONLY
//RS /// reliable "the real command's output is fully flushed" signal over a pipe.
//RS const SENTINEL: &str = "__jet_dbg_sentinel_9f3c__";
//RS 
//RS /// How long to wait for the sentinel to come back before giving up (a dead
//RS /// lldb, or a resume command that never stops) — generous, since a debuggee
//RS /// can legitimately run for a while before hitting a breakpoint or exiting.
//RS const READ_TIMEOUT: Duration = Duration::from_secs(30);
//RS 
//RS /// One resolved stop location: the function lldb reports plus its raw Rust
//RS /// file:line. Callers translate `rust_line` through [`super::LineMap::LineMap`]
//RS /// to get the Jet line (I2) — this struct never claims to be Jet-terms itself.
//RS pub(crate) struct RawFrame {
//RS     pub func: String,
//RS     pub rust_file: String,
//RS     pub rust_line: usize,
//RS }
//RS 
//RS pub(crate) struct Breakpoint {
//RS     pub id: usize,
//RS     pub resolved: bool,
//RS }
//RS 
//RS #[derive(Clone, Debug, Eq, PartialEq)]
//RS pub(crate) struct ThreadInfo {
//RS     pub id: u32,
//RS     pub name: String,
//RS }
//RS 
//RS /// What a resuming command (`run`/`continue`/a step) settled into — see the
//RS /// module doc point 2 for why this is derived from a follow-up `bt`, never
//RS /// from the resume command's own text.
//RS pub(crate) enum ResumeResult {
//RS     /// Stopped at a frame; the raw `bt` reply (parse with
//RS     /// [`Inferior::parse_top_frame`]/[`Inferior::parse_frames`]).
//RS     Stopped(String),
//RS     /// The debuggee ran to completion.
//RS     Exited {
//RS         status: Option<i32>,
//RS         signal: Option<String>,
//RS     },
//RS }
//RS 
//RS /// Identity held across the attach handshake. A PID alone is not an
//RS /// authority: it can be reused, point at a replaced executable, or belong to
//RS /// another session. Linux's open `/proc/<pid>` directory keeps the post-attach
//RS /// checks anchored to the process that passed preflight.
//RS #[cfg(target_os = "linux")]
//RS struct TargetIdentity {
//RS     pid: u32,
//RS     proc_dir: std::fs::File,
//RS     executable: PathBuf,
//RS     executable_hash: String,
//RS     uid: u32,
//RS     session: u64,
//RS     start_time: u64,
//RS }
//RS 
//RS #[cfg(not(target_os = "linux"))]
//RS struct TargetIdentity;
