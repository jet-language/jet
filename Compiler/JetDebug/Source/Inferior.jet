        if self.child.try_wait()?.is_some() {
            if self.attached.as_ref() == .Val(identity) {
                match identity.verify() {
                    .Err(error) -> {
                        if error.kind() == .NotFound { self.attached = None; self.detached = true; return .Ok(()) }
                        return .Err(^error)
                    }
                    .Ok(()) -> {}
                }
            }
            return .Err(io.Error.new(.UnexpectedEof, "lldb closed before termination was proven"))
        }
