// Rust: crates/jet-debug/src/Dap.rs:3989
fn backend_error_id(error: io.Error) -> I64 {
    if error.kind() == {
        .TimedOut -> 22035,
        .BrokenPipe | .UnexpectedEof | .ConnectionAborted | .ConnectionReset -> 22038,
        else -> 22034
    }
}
// Rust: crates/jet-debug/src/Dap.rs:4000
fn cleanup_error_details(error: io.Error) -> (I64, String) {
    if error.kind() == {
        .PermissionDenied -> (22037, "debugger could not verify attach target identity"),
        .BrokenPipe | .UnexpectedEof | .ConnectionAborted | .ConnectionReset -> (22038, "debug session connection closed before cleanup was proven"),
        else -> (22034, "the debugger could not cleanly close the target")
    }
}
// Rust: crates/jet-debug/src/Dap.rs:4016
fn default_exception_filters() -> [String:Bool] { [String:Bool]{"panic":true} }
// Rust: crates/jet-debug/src/Dap.rs:4020
fn diagnostic_details(id: I64, format: String) -> (String, String, String) {
    if id == {
        22031 -> ("E2232", "the DAP lifecycle or stop generation does not permit the request", "wait for the stated lifecycle event, then retry"),
        22032 -> ("E2236", "a request field violates the debugger's bounded local contract", "correct the field named in the diagnostic, then retry"),
        22033 -> ("E2234", "the supported local backend is missing or returned an unsupported result", "install or repair the supported backend, then retry"),
        22034 -> {
            if format.contains("attach") || format.contains("identity") -> return ("E2231", "the process identity, executable, source hashes, or `.jetmap` did not remain verified", "stop the target or choose the matching local Jet build, then attach again")
            ("E2234", "the supported local backend is missing, lost, or returned an unsupported result", "install or repair the supported backend, then retry")
        },
        22035 -> ("E2233", "the backend did not answer before the bounded read deadline", "check the target process and start a new session"),
        22036 -> ("E2238", "a frame, scope, or variable reference expired when execution resumed", "refresh the editor's stack and variables after the next stop"),
        22037 -> ("E2231", "the process identity, executable, source hashes, or `.jetmap` did not remain verified", "stop the target or choose the matching local Jet build, then attach again"),
        22038 -> ("E2237", "the editor, adapter, or debugger control channel closed before cleanup was proven", "check the target process, then start a new debug session"),
        22039 -> ("E2235", "the requested thread has no verified Jet source location", "select a stopped Jet task or move the breakpoint to a mapped Jet statement"),
        else -> ("E2239", "Jet could not preserve a debugger invariant", "start a new session and report the diagnostic if it repeats")
    }
}
// Rust: crates/jet-debug/src/Dap.rs:4080
fn parse_dap_request(body: String) -> DataTree Err! {
    message :: parse_json_with_limit(body, MAX_DAP_MESSAGE_BYTES) ?? return .Err("invalid JSON")
    if message != .Object(_) -> return .Err("request must be an object")
    if json_get(message, "type").and_then(json_str) != .Val("request") -> return .Err("type must be request")
    seq :: json_get(message, "seq").and_then(json_u32) ?? return .Err("seq must be a nonnegative integer")
    if seq == 0 -> return .Err("seq must be positive")
    command :: json_get(message, "command").and_then(json_str) ?? return .Err("command must be a string")
    if command.is_empty() -> return .Err("command must not be empty")
    if json_get(message, "arguments") == { None | .Val(.Object(_)) -> {}, else -> return .Err("arguments must be an object") }
    return message
}
// Rust: crates/jet-debug/src/Dap.rs:4110
fn jet_expression(value: String) -> (String, String)? {
    value := value.trim() // #4303
    if value.is_empty() || value.len() > 256 || value.chars().any((c) -> c.is_control()) -> return None
    root_len :: value.char_indices().find((pair) -> !pair.1.is_ascii_alphanumeric() && pair.1 != '_').map((pair) -> pair.0) ?? value.len()
    root := value[..root_len] // #4303
    if root.is_empty() || root.starts_with('_') || !root.chars().next().is_some_and((c) -> c.is_ascii_alphabetic()) -> return None
    suffix := value[root_len..] // #4303
    if !suffix.chars().all((c) -> c == '.' || c == '[' || c == ']' || c.is_ascii_digit()) -> return None
    return .Val((root.to_string(), suffix.to_string()))
}
// Rust: crates/jet-debug/src/Dap.rs:4137
struct InitializeArguments { lines_start_at_1: Bool; columns_start_at_1: Bool; supports_ansi_styling: Bool }
// Rust: crates/jet-debug/src/Dap.rs:4143
fn parse_initialize_arguments(args: DataTree?) -> InitializeArguments Err! {
    args :: args ?? return .Err("initialize arguments are required")
    if json_get(args, "adapterID").and_then(json_str) != .Val("jet") -> return .Err("initialize adapterID must be `jet`")
    if json_get(args, "pathFormat") == .Val(value) && json_str(value) != .Val("path") -> return .Err("initialize pathFormat must be `path`")
    lines_start_at_1 := true
    if json_get(args, "linesStartAt1") == .Val(value) -> lines_start_at_1 = json_bool(value) ?? return .Err("initialize linesStartAt1 must be a boolean")
    columns_start_at_1 := true
    if json_get(args, "columnsStartAt1") == .Val(value) -> columns_start_at_1 = json_bool(value) ?? return .Err("initialize columnsStartAt1 must be a boolean")
    supports_ansi_styling := false
    if json_get(args, "supportsANSIStyling") == .Val(value) -> supports_ansi_styling = json_bool(value) ?? return .Err("initialize supportsANSIStyling must be a boolean")
    return InitializeArguments { lines_start_at_1: lines_start_at_1, columns_start_at_1: columns_start_at_1, supports_ansi_styling: supports_ansi_styling }
}
// Rust: crates/jet-debug/src/Dap.rs:4176
struct LaunchArguments { args: [String]; cwd: String?; env: [(String, String)]; show_raw_frames: Bool }
// Rust: crates/jet-debug/src/Dap.rs:4183
fn parse_launch_arguments(args: DataTree?, jet_file: String) -> LaunchArguments Err! {
    if args.and_then((a) -> json_get(a, "program")).and_then(json_str) == .Val(program) && !same_path(program, jet_file) -> return .Err("launch program must be the selected Jet source file")
    values := [String]{}
    if args.and_then((a) -> json_get(a, "args")) == .Val(value) {
        if value == {
            .Array(items) -> loop item in items { &values.push((json_str(item) ?? return .Err("launch args must be strings")).to_string()) },
            else -> return .Err("launch args must be an array")
        }
    }
    // GATE #4494: local native filesystem metadata and canonical paths.
    cwd := fs.canonicalize(OSPath(jet_file)).ok().and_then((path) -> path.parent()).map((path) -> path.to_string_lossy())
    if args.and_then((a) -> json_get(a, "cwd")) == .Val(value) {
        raw :: json_str(value) ?? return .Err("launch cwd must be a string")
        path :: fs.canonicalize(OSPath(raw)) ?? return .Err("launch cwd must be a local directory")
        if !path.is_dir() -> return .Err("launch cwd must be a local directory")
        if fs.canonicalize(OSPath(jet_file)).ok() == .Val(source) && !source.starts_with(path) -> return .Err("launch cwd must contain the selected Jet source")
        cwd = .Val(path.to_string_lossy())
    }
    env := [(String, String)]{}
    if args.and_then((a) -> json_get(a, "env")) == .Val(value) {
        if value == {
            .Object(items) -> loop (key, item) in items {
                if !valid_launch_env_key(key) -> return .Err("launch environment keys must be ASCII letters, digits, or `_`")
                text :: json_str(item) ?? return .Err("launch environment values must be strings")
                &env.push((~key, text.to_string()))
            },
            else -> return .Err("launch env must be an object of strings")
        }
    }
    show_raw_frames := false
    if args.and_then((a) -> json_get(a, "showRawFrames")) == .Val(value) -> show_raw_frames = json_bool(value) ?? return .Err("showRawFrames must be a boolean")
    return LaunchArguments { args: ^values, cwd: ^cwd, env: ^env, show_raw_frames: show_raw_frames }
}
// Rust: crates/jet-debug/src/Dap.rs:4256
fn valid_launch_env_key(key: String) -> Bool { !key.is_empty() && key.chars().all((c) -> c.is_ascii_alphanumeric() || c == '_') }
// Rust: crates/jet-debug/src/Dap.rs:4260
fn same_path(left: String, right: String) -> Bool {
    left_path :: OSPath(left)
    right_path :: OSPath(right)
    if left_path == right_path -> return true
    // GATE #4494
    if fs.canonicalize(left_path).ok() == .Val(a) && fs.canonicalize(right_path).ok() == .Val(b) -> return a == b
    return false
}
// Rust: crates/jet-debug/src/Dap.rs:4275
fn data_breakpoint_places(args: DataTree?) -> [String] Err! {
    value :: args.and_then((a) -> json_get(a, "breakpoints")) ?? return .Err("setDataBreakpoints requires a breakpoints array")
    items :: if value == { .Array(items) -> items, else -> return .Err("setDataBreakpoints breakpoints must be an array") }
    if items.len() > 32 -> return .Err("setDataBreakpoints supports at most 32 session watchpoints")
    places := [String]{}
    seen := [String:Bool]{}
    loop item in items {
        place :: json_get(item, "dataId").and_then(json_str) ?? return .Err("data breakpoint dataId must be a Jet local path")
        if jet_expression(place) == None -> return .Err("data breakpoint dataId must be a bounded Jet local path")
        if json_get(item, "accessType").and_then(json_str) == .Val(access) && access != "write" -> return .Err("Jet data breakpoints support write access only")
        if !seen.contains(place) { &seen.insert(place, true); &places.push(place.to_string()) }
    }
    return places
}
// Rust: crates/jet-debug/src/Dap.rs:4345
fn breakpoint_source(args: DataTree?, jet_file: String) -> () Err! {
    source :: args.and_then((a) -> json_get(a, "source")) ?? return .Err("setBreakpoints requires a source object")
    path :: json_get(source, "path").and_then(json_str).filter((path) -> !path.is_empty() && !path.chars().any((c) -> c.is_control())) ?? return .Err("setBreakpoints source.path must be a non-empty string")
    if !same_path(path, jet_file) -> return .Err("setBreakpoints source.path is not the selected Jet file")
}
// Rust: crates/jet-debug/src/Dap.rs:4359
fn breakpoint_specs_for_origin(args: DataTree?, lines_start_at_1: Bool) -> [BreakpointSpec] Err! {
    value :: args.and_then((a) -> json_get(a, "breakpoints")) ?? return []
    items :: if value == { .Array(items) -> items, else -> return .Err("breakpoints must be an array") }
    specs := [BreakpointSpec]{}
    seen := [BreakpointSpec:Bool]{}
    loop item in items {
        line := json_get(item, "line").and_then(json_u32) ?? return .Err("breakpoint line must be a nonnegative integer")
        if lines_start_at_1 && line == 0 -> return .Err("breakpoint line must be a positive integer")
        if !lines_start_at_1 -> line = line.checked_add(1) ?? return .Err("breakpoint line is too large")
        converted :: USize.try_from(line) ?? return .Err("breakpoint line is too large")
        condition :: breakpoint_text(item, "condition") ?? return .Err(err)
        hit_condition :: breakpoint_text(item, "hitCondition") ?? return .Err(err)
        log_message :: breakpoint_text(item, "logMessage") ?? return .Err(err)
        spec :: BreakpointSpec { line: converted, condition: ^condition, hit_condition: ^hit_condition, log_message: ^log_message }
        if !seen.contains(spec) { &seen.insert(spec, true); &specs.push(^spec) }
    }
    return specs
}
// Rust: crates/jet-debug/src/Dap.rs:4403
fn breakpoint_text(item: DataTree, key: String) -> String? Err! {
    value :: json_get(item, key) ?? return None
    text :: json_str(value) ?? return .Err("breakpoint conditions and log messages must be strings")
    if text.len() > 512 || text.chars().any((c) -> c.is_control()) -> return .Err("breakpoint condition or log message is too long or contains control text")
    return .Val(text.to_string())
}
// Rust: crates/jet-debug/src/Dap.rs:4414
fn hit_condition_matches(condition: String, count: U32) -> Bool {
    condition := condition.trim() // #4303
    if condition.strip_prefix(">=") == .Val(raw) {
        value := raw.trim() // #4303
        return value.parse[U32]().ok().filter((n) -> n > 0).is_some_and((n) -> count >= n)
    }
    return condition.parse[U32]().ok().filter((n) -> n > 0).is_some_and((n) -> count == n)
}
// Rust: crates/jet-debug/src/Dap.rs:4432
fn valid_hit_condition(condition: String) -> Bool {
    condition := condition.trim() // #4303
    value := (condition.strip_prefix(">=") ?? condition).trim() // #4303
    !value.is_empty() && value.bytes().all((b) -> b.is_ascii_digit()) && value.parse[U32]().ok().is_some_and((n) -> n > 0)
}
// Rust: crates/jet-debug/src/Dap.rs:4440
fn valid_condition(condition: String) -> Bool {
    condition := condition.trim() // #4303
    if jet_expression(condition) != None -> return true
    loop operator in ["==", "!=", ">=", "<=", ">", "<"] {
        if condition.split_once(operator) == .Val((left, right)) {
            left := left.trim() // #4303
            return jet_expression(left) != None && !right.trim().is_empty() && !right.chars().any((c) -> c.is_control())
        }
    }
    return false
}
// Rust: crates/jet-debug/src/Dap.rs:4455
fn validate_breakpoint_specs(specs: [BreakpointSpec]) -> () Err! {
    if specs.iter().any((spec) -> spec.condition.is_some_and((condition) -> !valid_condition(condition))) -> return .Err("breakpoint condition must be a bounded read-only Jet local expression")
    if specs.iter().any((spec) -> spec.hit_condition.is_some_and((condition) -> !valid_hit_condition(condition))) -> return .Err("breakpoint hitCondition must be a positive integer or `>=` integer")
}
// Rust: crates/jet-debug/src/Dap.rs:4473
fn parse_attach_arguments(args: DataTree?) -> AttachArguments Err! {
    args :: args ?? return .Err("attach arguments are required")
    pid :: json_get(args, "processId").and_then(json_u32).filter((pid) -> pid > 0) ?? return .Err("attach processId must be a positive integer")
    program :: attach_path(args, "program") ?? return .Err(err)
    map :: attach_path(args, "map") ?? return .Err(err)
    show_raw_frames := false
    if json_get(args, "showRawFrames") == .Val(value) -> show_raw_frames = json_bool(value) ?? return .Err("showRawFrames must be a boolean")
    return AttachArguments { pid: pid, program: ^program, map: ^map, show_raw_frames: show_raw_frames }
}
// Rust: crates/jet-debug/src/Dap.rs:4493
fn attach_path(args: DataTree, key: String) -> OSPath Err! {
