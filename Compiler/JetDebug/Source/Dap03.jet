    }
    // Rust: crates/jet-debug/src/Dap.rs:3717
    fn breakpoint_action(&self, line: USize) -> BreakpointAction {
        if self.pending_specs.is_empty() -> return .Continue
        log := None
        matched := false
        stop_ids := [U32]{}
        should_stop := false
        loop index in 0..<self.pending_specs.len() {
            spec :: self.pending_specs[index]
            if spec.line != line -> next
            matched = true
            count := U32{1}
            if index < self.hit_counts.len() {
                self.hit_counts[index] = self.hit_counts[index].saturating_add(1)
                count = self.hit_counts[index]
            }
            if spec.condition == .Val(condition) && !&self.condition_matches(condition) -> next
            if spec.hit_condition == .Val(condition) && !hit_condition_matches(condition, count) -> next
            if spec.log_message == .Val(message) {
                log = .Val(&self.expand_log_message(message))
            } else {
                should_stop = true
                if self.client_breakpoint_ids.get(index) == .Val(id) -> &stop_ids.push(id)
            }
        }
        if should_stop -> return .Stop(^stop_ids)
        if log == .Val(message) -> return .Log(^message)
        // Matched conditional failures and ordinary mapped statements stay hidden.
        _ :: matched
        return .Continue
    }
    // Rust: crates/jet-debug/src/Dap.rs:3774
    fn condition_matches(&self, condition: String) -> Bool {
        loop operator in ["==", "!=", ">=", "<=", ">", "<"] {
            if condition.split_once(operator) == .Val((left, right)) {
                left := left.trim() // #4303
                value :: &self.read_jet_value(left) ?? return false
                right := right.trim() // #4303
                if value.parse[F64]().ok() == .Val(a) && right.parse[F64]().ok() == .Val(b) {
                    return if operator == {
                        "==" -> a == b, "!=" -> a != b, ">=" -> a >= b,
                        "<=" -> a <= b, ">" -> a > b, "<" -> a < b, else -> false
                    }
                }
                return if operator == { "==" -> value == right, "!=" -> value != right, else -> false }
            }
        }
        return &self.read_jet_value(condition) == .Val("true")
    }
    // Rust: crates/jet-debug/src/Dap.rs:3807
    fn read_jet_value(&self, expression: String) -> String? {
        (root, suffix) :: jet_expression(expression) ?? return None
        rust_expression :: Inferior.jet_path_to_rust(root, suffix) ?? return None
        inf :: self.inf ?? return None
        output :: &inf.frame_variable(rust_expression).ok() ?? return None // GATE #4494
        locals :: Inferior.parse_typed_locals(output)
        if locals.first() == .Val((ty, _, value)) -> return .Val(Inferior.safe_value(ty, value))
        return None
    }
    // Rust: crates/jet-debug/src/Dap.rs:3817
    fn expand_log_message(&self, message: String) -> String {
        rendered := ""
        rest := message
        loop {
            open :: rest.find('{') ?? break
            &rendered.push_str(rest[..open])
            after_open := rest[open + 1..] // #4303
            close :: after_open.find('}') ?? {
                &rendered.push_str(rest[open..])
                return rendered
            }
            expression := after_open[..close] // #4303
            &rendered.push_str(&self.read_jet_value(expression) ?? "<unavailable>")
            rest = after_open[close + 1..]
        }
        &rendered.push_str(rest)
        return rendered
    }
