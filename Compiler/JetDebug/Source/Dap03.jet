        body :: "{{\"error\":{{\"id\":{id},\"format\":\"{json_escape(format)}\",\"showUser\":true,\"variables\":{{\"retryable\":\"false\"}}}},\"jetDiagnostic\":{{\"schema\":\"jet.diagnostic/v1\",\"code\":\"{diagnostic}\",\"what\":\"{json_escape(format)}\",\"why\":\"{json_escape(why)}\",\"fix\":\"{json_escape(fix)}\"}}}}"
        seq :: &self.next_seq()
        json :: "{{\"seq\":{seq},\"type\":\"response\",\"request_seq\":{request_seq},\"success\":false,\"command\":\"{json_escape(command)}\",\"message\":\"{json_escape(message)}\",\"body\":{body}}}"
        if write_message(out, json).is_err() -> self.terminal_failure = true
    }
