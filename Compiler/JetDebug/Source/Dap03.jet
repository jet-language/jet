    fn exception_kind(self, backtrace: String) -> String? {
        // Only the stop banner carries the reason; unwind frames do not.
        reason := backtrace.lines().find((line) -> line.contains("stop reason =")) ?? ""
        reason = reason.to_ascii_lowercase()
        if self.last_signal != None || reason.contains("stop reason = signal ") -> return .Val("signal")
        if reason.contains("panic") -> return .Val("panic")
        if reason.contains("exception") || reason.contains("fatal error") || reason.contains("exc_") -> return .Val("error")
        return None
    }
