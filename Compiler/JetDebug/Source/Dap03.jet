fn read_message(reader: &io.BufRead) -> io.Result[String?] {
    // GATE #4494: bounded retained-descriptor reads, exact IO errors #4409.
    content_length := None
    total := USize{0}
    fields := USize{0}
    saw_header := false
    len := USize{0}
    loop {
        remaining :: MAX_PROTOCOL_HEADER_BYTES.saturating_sub(total)
        line := ""
        read :: io.Read.take(reader, U64(remaining + 1)).read_line(&line) ?? return .Err(err)
        if read == 0 {
            if saw_header -> return .Err(io.Error.new(.UnexpectedEof, "protocol headers ended before the frame body"))
            return .Ok(None)
        }
        saw_header = true
        if read > remaining -> return .Err(io.Error.new(.InvalidData, "protocol headers exceed the 8192-byte limit"))
        total += read
        if line == "\r\n" || line == "\n" {
            len = content_length ?? return .Err(io.Error.new(.InvalidData, "protocol frame has no Content-Length"))
            break
        }
        fields += 1
        if fields > MAX_PROTOCOL_HEADER_COUNT -> return .Err(io.Error.new(.InvalidData, "protocol headers exceed the 64-field limit"))
        header := line.strip_suffix("\r\n") ?? line.strip_suffix('\n') ?? line // #4303
        (name, value) :: header.split_once(':') ?? return .Err(io.Error.new(.InvalidData, "protocol header is malformed"))
        if !name.is_ascii() -> return .Err(io.Error.new(.InvalidData, "protocol header name is not ASCII"))
        if name.trim().eq_ignore_ascii_case("Content-Length") {
            if content_length != None -> return .Err(io.Error.new(.InvalidData, "protocol frame has duplicate Content-Length headers"))
            value := value.trim() // #4303
            if value.is_empty() || !value.bytes().all((byte) -> byte.is_ascii_digit()) -> return .Err(io.Error.new(.InvalidData, "protocol Content-Length is invalid"))
            content_length = .Val(value.parse[USize]() ?? return .Err(io.Error.new(.InvalidData, "protocol Content-Length is invalid")))
        }
    }
    if len > MAX_DAP_MESSAGE_BYTES -> return .Err(io.Error.new(.InvalidData, "protocol message exceeds the 16777216-byte limit"))
    body := [U8].repeat(0, len)
    _ :: &reader.read_exact(&body) ?? return .Err(err)
    text :: String.from_utf8(^body) ?? return .Err(io.Error.new(.InvalidData, "protocol message is not UTF-8"))
    return .Ok(.Val(^text))
}
