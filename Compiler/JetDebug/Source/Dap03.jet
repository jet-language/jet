    fn terminate_with_diagnostic(&self, out: &io.Write, diagnostic: String, message: String) -> {
        self.terminal_failure = true
        self.state = .Terminated
        &self.invalidate_references()
        cleanup_proven :: &self.cleanup_after_terminal_state(out)
        body :: "{{\"category\":\"stderr\",\"output\":\"[{json_escape(diagnostic)}] {json_escape(message)}\\n\"}}"
