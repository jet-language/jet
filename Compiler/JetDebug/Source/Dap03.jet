    // Rust: crates/jet-debug/src/Dap.rs:3903
    fn respond_jet_error(&self, out: &io.Write, request_seq: I64, command: String, id: I64, format: String) -> {
        message :: if id == {
            22031 -> "jet.invalidState", 22032 -> "jet.invalidArguments", 22033 -> "jet.unsupported",
            22034 -> "jet.unavailable", 22035 -> "jet.timeout", 22036 -> "jet.staleReference",
            22037 -> "jet.mapMismatch", 22038 -> "jet.cancelled", 22039 -> "jet.noSourceLocation",
            else -> "jet.unavailable"
        }
