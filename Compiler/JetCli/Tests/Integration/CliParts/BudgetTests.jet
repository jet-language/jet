// Rust: tests/cli_parts/budget.rs:1530
#Test("colliding_imported_cli_type_resolution_stays_in_codegen_sync") {
    dir :: isolated_cwd("shape_cli_ambiguous_imported_type")
    fs.write(dir.join("cli.jet"), "#CLI\npub struct RunArgs { pub name: String }\n").unwrap()
    fs.write(dir.join("plain.jet"), "pub struct RunArgs { pub name: String }\n").unwrap()
    fs.write(dir.join("run.jet"), "use \"plain\"\nuse \"cli\"\nfn run(args: RunArgs) -> {}\n").unwrap()
    build :: Command.new(jet()).args(["build", "run.jet"]).current_dir(dir).output().unwrap()
    stderr :: String.from_utf8_lossy(build.stderr)
    assert_ne(build.status.code(), Val(101), "type ambiguity reached rustc: {stderr}")
    if !build.status.success() {
        assert(stderr.contains("E1308"), "wrong frontend diagnostic: {stderr}")
    }
    assert(!stderr.contains("internal compiler error"), "type ambiguity reached rustc: {stderr}")
}

