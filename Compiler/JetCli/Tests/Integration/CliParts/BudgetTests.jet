// Rust: tests/cli_parts/budget.rs:478
#Test("budget_path_tools_cannot_forge_provenance") {
    if core.sys.target.selected_family() != "unix" -> return
    dir :: budget_project("budget_hostile_path", 10)
    fake :: dir.join("fake-bin")
    fs.create_dir(fake).unwrap()
    for (name, body) in [
        ("rustc", "#!/bin/sh\necho 'host: fake-forged-triple'\n"),
        ("sha256sum", "#!/bin/sh\necho 'ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff  fake'\n"),
        ("shasum", "#!/bin/sh\necho 'ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff  fake'\n"),
    ] {
        path :: fake.join(name)
        fs.write(path, body).unwrap()
        fs.set_permissions(path, fs.Permissions.from_mode(0o755)).unwrap()
    }
    out :: Command.new(jet()).args(["budget", "check", "--json"]).env("PATH", fake).current_dir(dir).output().unwrap()
    assert_eq(out.status.code(), Val(0), "{String.from_utf8_lossy(out.stderr)}")
    json :: String.from_utf8(out.stdout).unwrap()
    assert(!json.contains("fake-forged-triple"), "PATH rustc forged target identity")
    assert(!json.contains("ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"), "PATH digest tool forged compiler identity")
}

// Rust: tests/cli_parts/budget.rs:517
#Test("budget_unreadable_compiler_identity_rejects_before_artifact") {
    if core.sys.target.selected_family() != "unix" -> return
    dir :: artifact_budget_project("budget_missing_compiler_identity", 100_000_000)
    copied :: dir.join("jet-unreadable")
    fs.copy(jet(), copied).unwrap()
    fs.set_permissions(copied, fs.Permissions.from_mode(0o111)).unwrap()
    out :: output_with_retry(Command.new(copied).args(["budget", "check"]).current_dir(dir))
    assert_eq(out.status.code(), Val(1))
    stderr :: String.from_utf8(out.stderr).unwrap()
    assert(stderr.contains("cannot hash running compiler executable"), "{stderr}")
    assert(!dir.join(".jet").exists(), "missing compiler identity emitted an artifact")
    assert(!dir.join(".jet/build/run").exists(), "missing compiler identity started the selected artifact build")
}

// Rust: tests/cli_parts/budget.rs:546
#Test("budget_parallel_child_builds_survive_running_compiler_unlink") {
    if core.sys.target.selected_os() != "linux" -> return
    dirs :: [artifact_budget_project("budget_unlinked_compiler_identity_a", 100_000_000), artifact_budget_project("budget_unlinked_compiler_identity_b", 100_000_000)]
    bin_dir :: isolated_cwd("budget_unlinked_compiler_binary")
    copied :: bin_dir.join("jet-running-unlinked")
    cache :: bin_dir.join("cache")
    fs.copy(jet(), copied).unwrap()
    primed :: output_with_retry(Command.new(copied).arg("build").arg(dirs[0].join("src/run.jet")).current_dir(dirs[0]).env("JET_STORE_DIR", cache))
    assert_eq(primed.status.code(), Val(0), "stdout: {String.from_utf8_lossy(primed.stdout)}\nstderr: {String.from_utf8_lossy(primed.stderr)}")
    seed_artifact :: dirs[0].join(".jet/build/run")
    expected_artifact :: (CanonicalJson.String(sha256_file_hex(seed_artifact).unwrap()), CanonicalJson.Integer(fs.metadata(seed_artifact).unwrap().len().to_string()))
    expected_compiler :: JET_COMPILER_BUILD_ID
    expected_stdlib :: JET_STDLIB_BUILD_ID
    expected_runner :: JET_RUNNER_BUILD_ID
    children :: dirs.iter().map((dir) -> spawn_with_retry(Command.new(copied).args(["budget", "check", "--json"]).current_dir(dir).env("JET_STORE_DIR", cache).stdout(Stdio.piped()).stderr(Stdio.piped()))).collect()
    running_inode :: fs.metadata(copied).unwrap().ino()
    fs.remove_file(copied).unwrap()
    fs.write(copied, "replacement compiler inode\n").unwrap()
    assert_ne(running_inode, fs.metadata(copied).unwrap().ino())
    for (child, dir) in children.into_iter().zip(dirs) {
        out :: child.wait_with_output().unwrap()
        assert_eq(out.status.code(), Val(0), "stdout: {String.from_utf8_lossy(out.stdout)}\nstderr: {String.from_utf8_lossy(out.stderr)}")
        assert(out.stderr.is_empty())
        command :: if CanonicalJson.parse_canonical(out.stdout).unwrap() == { .Object(value) -> value; _ -> panic("command object") }
        report :: if canonical_field(command["budget"], "report") == { .Object(value) -> value; _ -> panic("report object") }
        verify_budget_report(CanonicalJson.Object(report).bytes()).unwrap()
        content :: if report["content"] == { .Object(value) -> value; _ -> panic("content object") }
        toolchain :: if content["toolchain"] == { .Object(value) -> value; _ -> panic("toolchain object") }
        assert_eq(toolchain["compiler_build_id"], CanonicalJson.String(expected_compiler))
        assert_eq(toolchain["runner_id"], CanonicalJson.String(expected_runner))
        assert_eq(toolchain["stdlib_id"], CanonicalJson.String(expected_stdlib))
        subject :: if content["subject"] == { .Object(value) -> value; _ -> panic("subject object") }
        artifact :: if subject["artifact"] == { .Object(value) -> value; _ -> panic("artifact object") }
        artifact_path :: dir.join(".jet/build/run")
        assert_eq(artifact["sha256"], CanonicalJson.String(sha256_file_hex(artifact_path).unwrap()))
        assert_eq(artifact["bytes"], CanonicalJson.Integer(fs.metadata(artifact_path).unwrap().len().to_string()))
        assert_eq((artifact["sha256"], artifact["bytes"]), expected_artifact, "parallel builds produced different artifact identities")
    }
}

// Rust: tests/cli_parts/budget.rs:661
#Test("budget_failure_has_human_github_projection_and_exit_one") {
    dir :: budget_project("budget_failure", 0)
    out :: Command.new(jet()).args(["budget", "check", "--annotations", "github"]).current_dir(dir).output().unwrap()
    assert_eq(out.status.code(), Val(1))
    assert(out.stdout.is_empty())
    stderr :: String.from_utf8(out.stderr).unwrap()
    assert(stderr.contains("Error [E2907]: performance budget public-api regressed"), "{stderr}")
    assert(stderr.contains("::error file=src/run.jet"), "{stderr}")
    assert(stderr.contains("performance budget public-api regressed%0AWhy: measured estimator"), "{stderr}")
    assert(stderr.contains("%0AFix: improve the measured behavior, inspect `jet budget check --verbose`, or record an explicit exception"), "{stderr}")
    assert(stderr.contains("budgets failed: 1 budget failed · report "), "{stderr}")
}

// Rust: tests/cli_parts/budget.rs:688
