    assert(stdout.contains("\"code\":\"E2110\""), "{stdout}")
    assert(stdout.contains("\"severity\":\"error\""), "{stdout}")
    assert(!stdout.contains("\u{1b}"), "{stdout}")
    _ :: fs.remove_dir_all(root)
}

