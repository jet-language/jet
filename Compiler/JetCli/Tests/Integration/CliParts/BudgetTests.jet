// Rust: tests/cli_parts/budget.rs:1073
#Test("budget_tty_confirmation_cancel_and_yes_control_mutation") {
    if core.sys.target.selected_family() != "unix" -> return
    cancelled :: budget_project("budget_tty_no", 10)
    (cancelled_code, cancelled_transcript) :: run_budget_update_pty(cancelled, "n\n".as_bytes())
    assert_eq(cancelled_code, 0, "{cancelled_transcript}")
    assert(cancelled_transcript.contains("Apply? [y/N]"), "{cancelled_transcript}")
    assert(cancelled_transcript.contains("plan cancelled; no baseline changed"), "{cancelled_transcript}")
    assert(!cancelled.join(".jet").exists(), "TTY cancel mutated workspace")
    applied :: budget_project("budget_tty_yes", 10)
    (code, transcript) :: run_budget_update_pty(applied, "yes\n".as_bytes())
    assert_eq(code, 0, "{transcript}")
    assert(transcript.contains("Apply? [y/N]"), "{transcript}")
    assert_eq(transcript.matches("+ report ").count(), 1, "plan/apply duplicated report row: {transcript}")
    assert_eq(transcript.matches("~ baseline ").count(), 1, "plan/apply duplicated baseline row: {transcript}")
    assert(applied.join(".jet/perf/baselines/names/ci/linux.json").is_file(), "TTY yes did not apply")
    assert(applied.join(".jet/perf/reports").read_dir().unwrap().next().is_some(), "TTY yes omitted report artifact")
}

