use tests.cli_parts.support.*
use std.fs
use std.env
use std.process.[Command, Stdio]
use core.files.[OSPath]
use jet_foundation.PerformanceBudget.[CanonicalJson, verify_budget_report]
use jet_foundation.MachineOutput.[read_machine_output, MachineRecord]
use jet.SHA256.[sha256_file_hex]
