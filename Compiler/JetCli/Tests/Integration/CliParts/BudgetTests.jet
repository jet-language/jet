// GATE #4494: all process, filesystem, PTY, permission and inode operations
// below use real native primitives; no simulated workload or Rust bridge.

// Rust: tests/cli_parts/budget.rs:4
#Test("compiler_probe_rejects_missing_edit_input_and_closed_metric_typos") {
    dir :: compile_latency_budget_project("compile_probe_hostile_inputs")
    fs.remove_file(dir.join("edits/rename-route.patch")).unwrap()
    missing :: Command.new(jet()).args(["budget", "check", "--json"]).current_dir(dir).output().unwrap()
    assert_eq(missing.status.code(), Val(1))
    missing_text :: String.from_utf8_lossy(missing.stdout)
    assert(missing_text.contains("E2908") || String.from_utf8_lossy(missing.stderr).contains("E2908"))
    assert(!dir.join(".jet/perf/reports").exists(), "missing edit input must not produce a report")
    typo_dir :: compile_latency_budget_project("compile_probe_closed_metric")
    source :: fs.read_to_string(typo_dir.join("src/run.jet")).unwrap().replace(".CompileTime(.P95)", ".CompileLatency(.P95)")
    fs.write(typo_dir.join("src/run.jet"), source).unwrap()
    typo :: Command.new(jet()).args(["budget", "check", "--json"]).current_dir(typo_dir).output().unwrap()
    assert_eq(typo.status.code(), Val(1))
    assert(String.from_utf8_lossy(typo.stdout).contains("E2903") || String.from_utf8_lossy(typo.stderr).contains("E2903"))
}

