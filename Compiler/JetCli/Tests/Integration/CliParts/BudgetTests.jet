    report :: fs.read_to_string(report_path).unwrap()
    assert(report.contains("\"source\":\"src/perf_defs.jet:2\""), "{report}")
}

// Rust: tests/cli_parts/budget.rs:722
#Test("budget_update_is_plan_first_and_yes_applies_once") {
    dir :: budget_project("budget_update", 10)
    args :: ["budget", "update", "--baseline", "ci/linux", "--bootstrap", "--reason", "initial evidence", "--json"]
    plan_output :: Command.new(jet()).args(args).current_dir(dir).output().unwrap()
    assert_eq(plan_output.status.code(), Val(0), "{String.from_utf8_lossy(plan_output.stderr)}")
    command :: if CanonicalJson.parse_canonical(plan_output.stdout).unwrap() == { .Object(value) -> value; _ -> panic("command") }
    assert_eq(canonical_field(command["budget"], "applied"), CanonicalJson.Bool(false))
    plan :: if canonical_field(command["budget"], "plan") == { .Object(value) -> value; _ -> panic("plan") }
    assert_eq(plan["requires_confirmation"], CanonicalJson.Bool(false))
    rows :: if plan["rows"] == { .Array(value) -> value; _ -> panic("rows") }
    assert_eq(rows.len(), 2)
    report :: if rows[0] == { .Object(value) -> value; _ -> panic("report row") }
    baseline :: if rows[1] == { .Object(value) -> value; _ -> panic("baseline row") }
    assert_eq(report["operation"], CanonicalJson.String("create"))
    assert_eq(report["artifact"], CanonicalJson.String("report"))
    assert_eq(baseline["operation"], CanonicalJson.String("advance"))
    assert_eq(baseline["artifact"], CanonicalJson.String("baseline"))
    assert(!dir.join(".jet").exists(), "JSON plan-only mutated workspace")
    applied_output :: Command.new(jet()).args(args).arg("--yes").current_dir(dir).output().unwrap()
    assert_eq(applied_output.status.code(), Val(0), "{String.from_utf8_lossy(applied_output.stderr)}")
    applied :: String.from_utf8(applied_output.stdout).unwrap()
    assert(applied.contains("\"applied\":true"))
    assert(dir.join(".jet/perf/baselines/names/ci/linux.json").is_file())
}

// Rust: tests/cli_parts/budget.rs:805
#Test("build_artifact_receipt_collects_footprint_samples") {
    if core.sys.target.selected_os() != "linux" -> return
    source :: OSPath.from_text(env.var("CARGO_MANIFEST_DIR").unwrap()).join("Examples/performance/receipts/hello")
    dir :: isolated_cwd("build_artifact_receipt")
    copy_dir_all(source, dir)
    _ :: fs.remove_dir_all(dir.join(".jet")).ok()
    output :: Command.new(jet()).args(["budget", "check", "--json"]).current_dir(dir).output().unwrap()
    assert_eq(output.status.code(), Val(1), "missing statistical baseline must be unavailable")
    assert(output.stderr.is_empty(), "JSON mode must keep diagnostics in stdout")
    command :: if CanonicalJson.parse_canonical(output.stdout).unwrap() == { .Object(value) -> value; _ -> panic("command") }
    report :: if canonical_field(command["budget"], "report") == { .Object(value) -> value; _ -> panic("report") }
    content :: if report["content"] == { .Object(value) -> value; _ -> panic("content") }
    measurements :: if content["measurements"] == { .Array(value) -> value; _ -> panic("measurements") }
    assert_eq(measurements.len(), 3)
    for item in measurements {
        measurement :: if item == { .Object(value) -> value; _ -> panic("measurement") }
        provider :: if measurement["provider"] == { .Object(value) -> value; _ -> panic("provider") }
        assert_eq(provider["kind"], CanonicalJson.String("BuildArtifact"))
        assert_eq(provider["version"], CanonicalJson.String("jet-artifact-footprint-v1-first-line-vmhwm-trials-20"))
        assert_eq(provider["isolation"], CanonicalJson.String("fresh-child-process-per-trial"))
        metric :: if measurement["metric"] == { .Object(value) -> value; _ -> panic("metric") }
        samples :: if measurement["samples"] == { .Array(value) -> value; _ -> panic("samples") }
        if metric["name"] == {
            .String(name) -> {
                if name == "BinarySize" -> assert_eq(samples.len(), 1)
                else if name == "StartupTime" || name == "MemoryHighWater" -> assert_eq(samples.len(), 20)
                else -> panic("unexpected metric: {name:?}")
            }
            other -> panic("unexpected metric: {other:?}")
        }
        for item in samples {
            sample :: if item == { .Object(value) -> value; _ -> panic("sample") }
            nonzero :: if sample["num"] == { .Integer(value) -> value != "0"; _ -> false }
            assert(nonzero)
            assert_eq(sample["den"], CanonicalJson.Integer("1"))
        }
    }
    assert(CanonicalJson.Object(content).bytes().windows("Throughput".as_bytes().len()).all((window) -> window != "Throughput".as_bytes()))
    verify_budget_report(CanonicalJson.Object(report).bytes()).unwrap()
}

// Rust: tests/cli_parts/budget.rs:893
#Test("budget_json_projection_is_exact_and_tool_failure_uses_null_report_fields") {
    dir :: budget_project("budget_json_exact", 10)
    out :: Command.new(jet()).args(["budget", "check", "--json"]).current_dir(dir).output().unwrap()
    assert_eq(out.status.code(), Val(0))
    assert(out.stderr.is_empty())
    assert_eq(read_machine_output(String.from_utf8(out.stdout).unwrap()).unwrap(), [MachineRecord.Status])
    command :: if CanonicalJson.parse_canonical(out.stdout).unwrap() == { .Object(value) -> value; _ -> panic("command object") }
    command_keys := command.keys().collect()
    command_keys.sort()
    assert_eq(command_keys, ["action", "budget", "moment", "ok", "schema", "status"])
    budget :: if command["budget"] == { .Object(value) -> value; _ -> panic("budget") }
    budget_keys := budget.keys().collect()
    budget_keys.sort()
    assert_eq(budget_keys, ["applied", "diagnostics", "exit_code", "failure_kind", "plan", "report", "report_path", "results"])
    results :: if budget["results"] == { .Array(value) -> value; _ -> panic("results") }
    result :: if results[0] == { .Object(value) -> value; _ -> panic("result") }
    result_keys := result.keys().collect()
    result_keys.sort()
    assert_eq(result_keys, ["baseline_report_ids", "budget_id", "comparison", "diagnostic_code", "direction", "enforcement", "evidence", "lower95", "metric", "point", "reason", "source", "stale", "status", "trend", "unit", "upper95"])
    source :: if result["source"] == { .Object(value) -> value; _ -> panic("source") }
    source_keys := source.keys().collect()
    source_keys.sort()
    assert_eq(source_keys, ["column", "line", "path"])
    comparison :: if result["comparison"] == { .Object(value) -> value; _ -> panic("comparison") }
    comparison_keys := comparison.keys().collect()
    comparison_keys.sort()
    assert_eq(comparison_keys, ["direction", "kind", "limit"])
    fs.write(dir.join("src/run.jet"), "fn run( {\n").unwrap()
    invalid_output :: Command.new(jet()).args(["budget", "check", "--json"]).current_dir(dir).output().unwrap()
    assert_eq(invalid_output.status.code(), Val(1))
    assert(invalid_output.stderr.is_empty())
    invalid :: if CanonicalJson.parse_canonical(invalid_output.stdout).unwrap() == { .Object(value) -> value; _ -> panic("compiler failure object") }
    assert_eq(canonical_field(invalid["budget"], "failure_kind"), CanonicalJson.String("compiler"))
    diagnostics :: if canonical_field(invalid["budget"], "diagnostics") == { .Array(value) -> value; _ -> panic("diagnostics") }
    diagnostic :: if diagnostics[0] == { .Object(value) -> value; _ -> panic("diagnostic") }
    diagnostic_source :: if diagnostic["source"] == { .Object(value) -> value; _ -> panic("diagnostic source") }
    diagnostic_keys := diagnostic_source.keys().collect()
    diagnostic_keys.sort()
    assert_eq(diagnostic_keys, ["column", "end_column", "end_line", "line", "path"])
    assert_eq(diagnostic_source["path"], CanonicalJson.String("src/run.jet"))
    assert(if diagnostic_source["end_line"] == { .Integer(_) -> true; _ -> false })
    assert(if diagnostic_source["end_column"] == { .Integer(_) -> true; _ -> false })
    empty :: isolated_cwd("budget_json_tool_failure")
    failed :: Command.new(jet()).args(["budget", "check", "--json"]).current_dir(empty).output().unwrap()
    assert_eq(failed.status.code(), Val(1))
    assert(failed.stderr.is_empty())
    failure :: if CanonicalJson.parse_canonical(failed.stdout).unwrap() == { .Object(value) -> value; _ -> panic("failure object") }
    assert_eq(failure["status"], CanonicalJson.String("fail"))
    assert_eq(canonical_field(failure["budget"], "failure_kind"), CanonicalJson.String("tool"))
    assert_eq(canonical_field(failure["budget"], "report"), CanonicalJson.Null)
    assert_eq(canonical_field(failure["budget"], "report_path"), CanonicalJson.Null)
    assert_eq(canonical_field(failure["budget"], "plan"), CanonicalJson.Null)
}

// Rust: tests/cli_parts/budget.rs:1043
