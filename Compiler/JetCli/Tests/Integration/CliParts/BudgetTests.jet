// Rust: tests/cli_parts/budget.rs:1651
#Test("external_completion_rejects_hostile_files_and_names") {
    dir :: isolated_cwd("shape_cli_hostile_artifacts")
    oversized :: dir.join("oversized")
    fs.File.create(oversized).unwrap().set_len(512 * 1024 * 1024 + 1).unwrap()
    oversized_out :: Command.new(jet()).args(["self", "completions", "bash", "--for", "oversized"]).current_dir(dir).output().unwrap()
    assert_eq(oversized_out.status.code(), Val(1))
    assert(String.from_utf8_lossy(oversized_out.stderr).contains("larger than the 512 MiB"))
    if core.sys.target.selected_family() == "unix" {
        device :: Command.new(jet()).args(["self", "completions", "bash", "--for", "/dev/null"]).output().unwrap()
        assert_eq(device.status.code(), Val(1))
        assert(String.from_utf8_lossy(device.stderr).contains("not a regular file"))
        fifo :: dir.join("program-fifo")
        made :: Command.new("mkfifo").arg(fifo).status().unwrap()
        assert(made.success())
        fifo_out :: Command.new(jet()).args(["self", "completions", "bash", "--for", "program-fifo"]).current_dir(dir).output().unwrap()
        assert_eq(fifo_out.status.code(), Val(1))
        assert(String.from_utf8_lossy(fifo_out.stderr).contains("not a regular file"))
    }
    hostile :: "safe\nINJECT_COMMAND\nnext"
    fs.write(dir.join(hostile), "not an executable".as_bytes()).unwrap()
    for shell in ["bash", "zsh", "fish", "powershell"] {
        out :: Command.new(jet()).args(["self", "completions", shell, "--for", hostile]).current_dir(dir).output().unwrap()
        assert_eq(out.status.code(), Val(1))
        assert(out.stdout.is_empty(), "{shell} emitted attacker-controlled script bytes")
        stderr :: String.from_utf8(out.stderr).unwrap()
        assert(stderr.contains("contains a control character"))
        assert(!stderr.contains("\nINJECT_COMMAND\n"), "{shell} exposed an executable line: {stderr:?}")
        assert(stderr.contains("safe\\nINJECT_COMMAND\\nnext"))
    }
}
