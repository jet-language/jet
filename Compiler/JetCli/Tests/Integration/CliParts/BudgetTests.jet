// Rust: tests/cli_parts/budget.rs:66
#Test("compiler_facts_rejects_compile_time_instead_of_measuring") {
    dir :: budget_project("compile_time_not_compiler_facts", 10)
    source :: fs.read_to_string(dir.join("src/run.jet")).unwrap()
        .replace("metric: .PublicApiItems", "metric: .CompileTime(.P95)")
        .replace("comparison: .Absolute", "provider: .CompilerFacts,\n        comparison: .RelativeTo(\"ci/linux-x64\")")
        .replace("limit: .AtMost(10)", "limit: .RegressionAtMost(5pct)")
    fs.write(dir.join("src/run.jet"), source).unwrap()
    output :: Command.new(jet()).args(["budget", "check", "--json"]).current_dir(dir).output().unwrap()
    assert_eq(output.status.code(), Val(1))
    text :: "{String.from_utf8_lossy(output.stdout)}{String.from_utf8_lossy(output.stderr)}"
    assert(text.contains("E2903") || text.contains("CompilerProbe") || text.contains("CompileTime"), "{text}")
    assert(!dir.join(".jet/perf/reports").exists(), "closed grammar rejection must not produce a report")
}

// Rust: tests/cli_parts/budget.rs:99
#Test("allocation_probe_uses_real_bench_boundaries_and_rejects_forged_cache") {
    dir :: allocation_budget_project("allocation_probe_runtime")
    run :: () -> Command.new(jet()).args(["budget", "check", "--json"]).current_dir(dir).output().unwrap()
    first :: run()
    assert_eq(first.status.code(), Val(0), "stdout: {String.from_utf8_lossy(first.stdout)}\nstderr: {String.from_utf8_lossy(first.stderr)}")
    reports :: dir.join(".jet/perf/reports")
    paths :: () -> fs.read_dir(reports).unwrap().map((entry) -> entry.unwrap().path()).collect()
    initial :: paths()
    assert_eq(initial.len(), 1)
    bytes :: fs.read(initial[0]).unwrap()
    verify_budget_report(bytes).unwrap()
    report :: if CanonicalJson.parse_canonical(bytes).unwrap() == { .Object(value) -> value; _ -> panic("report") }
    content :: if report["content"] == { .Object(value) -> value; _ -> panic("content") }
    measurements :: if content["measurements"] == { .Array(value) -> value; _ -> panic("measurements") }
    assert_eq(measurements.len(), 2)
    for item in measurements {
        measurement :: if item == { .Object(value) -> value; _ -> panic("measurement") }
        provider :: if measurement["provider"] == { .Object(value) -> value; _ -> panic("provider") }
        assert_eq(provider["kind"], CanonicalJson.String("AllocationProbe"))
        assert_eq(provider["identity"], CanonicalJson.String("arena"))
        assert_eq(provider["isolation"], CanonicalJson.String("benchmark-process-counter-reset-per-trial"))
        assert_eq(provider["version"], CanonicalJson.String("jet-arena-events-v1-warmup-auto-trials-20"))
        samples :: if measurement["samples"] == { .Array(value) -> value; _ -> panic("samples") }
        assert_eq(samples.len(), 20)
        assert(samples.windows(2).all((pair) -> pair[0] == pair[1]), "reset boundary leaked calibration or a prior trial")
        metric :: if measurement["metric"] == { .Object(value) -> value; _ -> panic("metric") }
        expected :: if metric["name"] == {
            .String(name) -> if name == "AllocationCount" -> "1" else if name == "AllocationBytes" -> "8" else -> panic("unexpected metric: {name:?}")
            other -> panic("unexpected metric: {other:?}")
        }
        for item in samples {
            sample :: if item == { .Object(value) -> value; _ -> panic("sample") }
            assert_eq(sample["den"], CanonicalJson.Integer("1"))
            assert_eq(sample["num"], CanonicalJson.Integer(expected))
        }
    }
    second :: run()
    assert_eq(second.status.code(), Val(0))
    assert(!String.from_utf8_lossy(second.stdout).contains("ns/iter"), "compatible report reran allocation workload")
    assert_eq(paths(), initial)
    fs.OpenOptions.new().append(true).open(initial[0]).unwrap().write_all("forged".as_bytes()).unwrap()
    third :: run()
    assert_eq(third.status.code(), Val(0), "{String.from_utf8_lossy(third.stderr)}")
    assert_eq(paths().len(), 2, "forged report must not satisfy compatible cache identity")
}

// Rust: tests/cli_parts/budget.rs:213
#Test("budget_stale_history_is_persisted_rendered_and_bootstrap_appends") {
    dir :: benchmark_budget_project("budget_stale_history")
    source :: fs.read_to_string(dir.join("src/run.jet")).unwrap().replace("enforcement: .Warn", "enforcement: .Fail")
    fs.write(dir.join("src/run.jet"), source).unwrap()
    first :: Command.new(jet()).args(["budget", "update", "--baseline", "ci/linux", "--bootstrap", "--reason", "initial benchmark", "--yes", "--json"]).current_dir(dir).output().unwrap()
    assert_eq(first.status.code(), Val(0), "stdout: {String.from_utf8_lossy(first.stdout)}\nstderr: {String.from_utf8_lossy(first.stderr)}")
    (first_id, stale_state_id) :: age_budget_baseline(dir, "ci/linux")
    check_output :: Command.new(jet()).args(["budget", "check", "--json"]).current_dir(dir).output().unwrap()
    assert_eq(check_output.status.code(), Val(1), "stdout: {String.from_utf8_lossy(check_output.stdout)}\nstderr: {String.from_utf8_lossy(check_output.stderr)}")
    check :: if CanonicalJson.parse_canonical(check_output.stdout).unwrap() == { .Object(value) -> value; _ -> panic("command") }
    assert_eq(check["status"], CanonicalJson.String("stale"))
    assert_eq(canonical_field(check["budget"], "failure_kind"), CanonicalJson.String("evidence"))
    results :: if canonical_field(check["budget"], "results") == { .Array(value) -> value; _ -> panic("results") }
    result :: if results[0] == { .Object(value) -> value; _ -> panic("result") }
    assert_eq(result["stale"], CanonicalJson.Bool(true))
    assert_eq(result["status"], CanonicalJson.String("stale"))
    assert_eq(result["evidence"], CanonicalJson.String("unavailable"))
    assert_eq(result["baseline_report_ids"], CanonicalJson.Array([CanonicalJson.String(first_id)]))
    reason :: if result["reason"] == { .String(value) -> value; _ -> panic("reason") }
    assert(reason.contains("compatible history is stale"), "{reason}")
    assert(reason.contains("policy limit is 2592000 seconds"), "{reason}")
    report :: if canonical_field(check["budget"], "report") == { .Object(value) -> value; _ -> panic("report") }
    verify_budget_report(CanonicalJson.Object(report).bytes()).unwrap()
    content :: if report["content"] == { .Object(value) -> value; _ -> panic("content") }
    measurements :: if content["measurements"] == { .Array(value) -> value; _ -> panic("measurements") }
    measurement :: if measurements[0] == { .Object(value) -> value; _ -> panic("measurement") }
    history :: if measurement["history"] == { .Object(value) -> value; _ -> panic("history") }
    assert_eq(history["state_id"], CanonicalJson.String(stale_state_id))
    assert_eq(history["report_ids"], CanonicalJson.Array([CanonicalJson.String(first_id)]))
    assert_eq(measurement["baseline"], CanonicalJson.Null, "stale samples must not be pooled")
    decision :: if measurement["decision"] == { .Object(value) -> value; _ -> panic("decision") }
    trend :: if decision["trend"] == { .Object(value) -> value; _ -> panic("trend") }
    assert_eq(trend["report_ids"], CanonicalJson.Array([CanonicalJson.String(first_id)]))
    human_output :: Command.new(jet()).args(["budget", "check", "--annotations", "none"]).current_dir(dir).output().unwrap()
    assert_eq(human_output.status.code(), Val(1))
    human :: String.from_utf8(human_output.stderr).unwrap()
    assert(human.contains("Error [E2906]: performance budget parse has no usable evidence"), "{human}")
    assert(human.contains("compatible history is stale"), "{human}")
    assert(human.contains("budgets stale: 1 baseline stale · report "), "{human}")
    bootstrap_output :: Command.new(jet()).args(["budget", "update", "--baseline", "ci/linux", "--bootstrap", "--reason", "refresh stale benchmark", "--yes", "--json"]).current_dir(dir).output().unwrap()
    assert_eq(bootstrap_output.status.code(), Val(0), "stdout: {String.from_utf8_lossy(bootstrap_output.stdout)}\nstderr: {String.from_utf8_lossy(bootstrap_output.stderr)}")
    bootstrap :: if CanonicalJson.parse_canonical(bootstrap_output.stdout).unwrap() == { .Object(value) -> value; _ -> panic("bootstrap") }
    assert_eq(canonical_field(bootstrap["budget"], "applied"), CanonicalJson.Bool(true))
    assert_eq(bootstrap["status"], CanonicalJson.String("stale"))
    second_report :: if canonical_field(bootstrap["budget"], "report") == { .Object(value) -> value; _ -> panic("report") }
    second_id :: if second_report["report_id"] == { .String(value) -> value; _ -> panic("report id") }
    manifest :: CanonicalJson.parse_canonical(fs.read(dir.join(".jet/perf/baselines/names/ci/linux.json")).unwrap()).unwrap()
    wrapper :: if manifest == { .Object(value) -> value; _ -> panic("manifest") }
    manifest_content :: if wrapper["content"] == { .Object(value) -> value; _ -> panic("content") }
    generations :: if manifest_content["generations"] == { .Array(value) -> value; _ -> panic("generations") }
    assert_eq(generations.len(), 2)
    second :: if generations[1] == { .Object(value) -> value; _ -> panic("generation") }
    audit :: if second["audit"] == { .Object(value) -> value; _ -> panic("audit") }
    assert_eq(audit["kind"], CanonicalJson.String("bootstrap"))
    assert_eq(audit["prior_state_id"], CanonicalJson.String(stale_state_id))
    assert_eq(audit["prior_head_report_id"], CanonicalJson.String(first_id))
    assert_eq(second["report_id"], CanonicalJson.String(second_id))
}

// Rust: tests/cli_parts/budget.rs:423
#Test("budget_effect_count_uses_solved_effects_not_import_count") {
    dir :: budget_project("budget_effect_truth", 10)
    fs.write(dir.join("src/run.jet"), """
use core.files as files
module perf.package {
    budgets: [Budget{ name: "effects", scope: .Package, metric: .EffectCount, comparison: .Absolute, limit: .AtMost(0) }],
}
fn run() -> {}
""").unwrap()
    out :: Command.new(jet()).args(["budget", "check", "--json"]).current_dir(dir).output().unwrap()
    assert_eq(out.status.code(), Val(0), "{String.from_utf8_lossy(out.stderr)}")
