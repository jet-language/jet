use std.[fs, env, process]
use std.process.Command

// Rust: tests/prove.rs:8
// GATE #4494: runner-provided built native Jet executable, never a Rust callback.
pub fn jet() -> OSPath { OSPath.from(env.test_binary("jet")) }
// Rust: tests/prove.rs:12
pub fn workspace(name: String) -> OSPath {
    // GATE #4494: real process identity and temporary filesystem.
    path :: env.temp_dir().join("jet_prove_{name}_{process.id()}")
    _ :: fs.remove_dir_all(path)
    fs.create_dir_all(path).unwrap()
    fs.write(path.join("package.jet"), "name: \"test-fixture\"\nversion: \"0.1.0\"\n").unwrap()
    path
}
// Rust: tests/prove.rs:24
pub fn budget_workspace(name: String) -> OSPath {
    root :: workspace(name)
    fs.create_dir_all(root.join("src")).unwrap()
    // Bare budget check selects the canonical run.jet, not main.jet.
    fs.write(root.join("src/run.jet"), `
package {
    name: "app"
}

module perf.package {
    budgets: [Budget{
        name: "public-api",
        scope: .Package,
        metric: .PublicApiItems,
        comparison: .Absolute,
        limit: .AtMost(10),
    }],
}
pub fn api() {}
fn run() {}
`).unwrap()
    root
}
