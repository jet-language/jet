use Compiler.JetCli.Tests.Integration.TargetMachines.*
use Compiler.JetCli.Tests.Integration.Common as common
use jet.Driver.[build_target_machine_firmware, qemu_target_machine_smoke, TargetMachineCompileError]
use jet.Syntax.RuntimeLayer
use jet.TargetMachine.[AllocatorPolicy, ByteSize, ByteSinkPolicy, ClockPolicy, ExecutionTier, LinkerInput, MemoryAccess, MemoryKind, MemoryRegion, MmioAccess, PanicPolicy, ProviderContract, TargetCapability, TargetMachine, TargetMachineError, TargetMachineUse, UnsafeGate]
use std.[fs, env, process]
// GATE #4494: native filesystem, process identity and firmware/QEMU subprocesses.

// Rust: tests/target_machines.rs:93
#Test("hosted_jet_sees_no_target_ceremony") {
    machine :: TargetMachine.hosted("x86_64-unknown-linux-gnu")
    usage :: TargetMachineUse { core_apis: ["core.files", "core.http.client"], heap_required: true, ..TargetMachineUse.default() }
    assert(!machine.no_os)
    assert(matches(machine.linker, LinkerInput.HostedDefault))
    assert(matches(machine.allocator, AllocatorPolicy.HostedDefault))
    assert(matches(machine.panic, PanicPolicy.HostedDefault))
    assert(machine.memory.is_empty())
    assert_eq(machine.max_runtime_layer(), RuntimeLayer.Std)
    assert(machine.validate(usage).is_empty())
    assert(machine.supports_execution_tier(ExecutionTier.Dev).is_ok())
    assert(machine.supports_execution_tier(ExecutionTier.Jit).is_ok())
    audit :: machine.audit_json(usage)
    assert(audit.contains("\"environment\":\"hosted\""))
    assert(audit.contains("\"execution\":{\"aot\":true,\"dev\":true,\"jit\":true}"))
}

// Rust: tests/target_machines.rs:115
#Test("typed_target_machine_accepts_complete_board_facts") {
    usage :: TargetMachineUse {
        stack_bytes: ByteSize.kib(4).bytes, static_ram_bytes: ByteSize.kib(12).bytes,
        heap_required: true, core_apis: ["core.encoding.json"],
        mmio: [MmioAccess { address: 0x4000_0100, size: ByteSize.bytes(4),
            unsafe_gate: UnsafeGate { reason: "timer status register" } }],
        required_capabilities: [],
    }
    assert_eq(sensor_machine().validate(usage), [])
    review :: sensor_machine().safety_review(usage)
    assert(review.passes(), "{review:?}")
}

// Rust: tests/target_machines.rs:136
#Test("no_os_allocator_and_core_limits_are_data_errors") {
    machine := sensor_machine()
    machine.allocator = AllocatorPolicy.None
    usage :: TargetMachineUse { heap_required: true, core_apis: ["core.files", "core.mem"], ..TargetMachineUse.default() }
    errors :: machine.validate(usage)
    assert(errors.contains(TargetMachineError.HeapRequiresAllocator))
    assert(errors.contains(TargetMachineError.CoreApiUnavailable { api: "core.files", required: RuntimeLayer.Std, available: RuntimeLayer.Core }))
    assert(errors.contains(TargetMachineError.CoreApiUnavailable { api: "core.mem", required: RuntimeLayer.Alloc, available: RuntimeLayer.Core }))
    machine.allocator = AllocatorPolicy.Counting { cap: ByteSize.mib(8) }
    errors_counting :: machine.validate(TargetMachineUse.default())
    assert(errors_counting.contains(TargetMachineError.HostedAllocatorRequiresOs))
}

