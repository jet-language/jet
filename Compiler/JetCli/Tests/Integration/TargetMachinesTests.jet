// Rust: tests/target_machines.rs:200
#Test("allocator_size_must_fit_named_ram_region") {
    machine := sensor_machine()
    machine.memory.push(MemoryRegion.new("scratch", 0x2001_0000, ByteSize.kib(4), MemoryKind.Ram, MemoryAccess.Rw))
    machine.allocator = AllocatorPolicy.Fixed { region: "scratch", size: ByteSize.kib(8) }
    errors :: machine.validate(TargetMachineUse.default())
    assert(errors.contains(TargetMachineError.AllocatorRegionTooSmall { region: "scratch",
        requested_bytes: ByteSize.kib(8).bytes, available_bytes: ByteSize.kib(4).bytes }))
}

// Rust: tests/target_machines.rs:224
#Test("selected_target_machine_rejects_unavailable_core_api_before_codegen") {
    dir :: env.temp_dir().join("jet_target_machine_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("main.jet")
    fs.write(file, """
use core.files as fs

fn run() {
    print(fs.read("missing.txt") ?? "missing")
}
""").unwrap()
    err :: jet.Driver.compile_bundle_path_with_target_machine(file.to_string_lossy(), jet.Sema.CompileMode.Run, sensor_machine())
        .expect_err("no-os target machine should reject core.files before codegen")
    match err {
        TargetMachineCompileError.Diagnostics(diags) -> assert(diags.iter().any(fn(diagnostic) -> diagnostic.code == "E3310"))
        TargetMachineCompileError.Machine(errors) -> panic("expected registered diagnostics, got machine errors: {errors:?}")
    }
    _ :: fs.remove_dir_all(dir)
}

// Rust: tests/target_machines.rs:258
#Test("selected_target_machine_validates_direct_mmio_accesses") {
    dir :: env.temp_dir().join("jet_target_machine_mmio_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("main.jet")
    fs.write(file, """
use core.mem as mem

fn run() {
    #Unsafe("timer register is mapped by board.sensor_v1") {
        p :: mem.Ptr<Int>.from_addr(0x40000100)
        mem.volatile_write(p, 7)
        _seen :: mem.volatile_read(p)
    }
}
""").unwrap()
    jet.Driver.compile_bundle_path_with_target_machine(file.to_string_lossy(), jet.Sema.CompileMode.Run, sensor_machine())
        .expect("machine should accept direct volatile access inside MMIO range")
    _ :: fs.remove_dir_all(dir)
}

// Rust: tests/target_machines.rs:288
#Test("selected_target_machine_rejects_direct_mmio_outside_region") {
    dir :: env.temp_dir().join("jet_target_machine_bad_mmio_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("main.jet")
    fs.write(file, """
use core.mem as mem

fn run() {
    #Unsafe("this address is intentionally outside the board MMIO region") {
        p :: mem.Ptr<Int>.from_addr(0x50000000)
        mem.volatile_write(p, 7)
    }
}
""").unwrap()
    err :: jet.Driver.compile_bundle_path_with_target_machine(file.to_string_lossy(), jet.Sema.CompileMode.Run, sensor_machine())
        .expect_err("target machine should reject direct volatile access outside MMIO range")
    match err {
        TargetMachineCompileError.Diagnostics(diags) -> assert(diags.iter().any(fn(diagnostic) -> diagnostic.code == "E3313"))
        TargetMachineCompileError.Machine(errors) -> panic("expected registered diagnostics, got machine errors: {errors:?}")
    }
    _ :: fs.remove_dir_all(dir)
}

