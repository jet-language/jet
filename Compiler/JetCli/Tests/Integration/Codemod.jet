// D-CODEMOD1 integration helpers for replayable semantic rename codemods.
use std.fs
use std.env
use std.process.[Command, id]
use core.files.OSPath

// Rust: tests/codemod.rs:9
pub fn jet() -> OSPath {
    // GATE #4494: native environment and process executable path.
    env.var_os("JET_CODEMOD_TEST_BIN").map(value -> OSPath.from(value))
        .unwrap_or_else(() -> OSPath.from_text(env.var("CARGO_BIN_EXE_jet").unwrap()))
}

// Rust: tests/codemod.rs:15
pub fn temp_dir(tag: String) -> OSPath {
    // GATE #4494: actual filesystem operations, never a simulated provider.
    dir :: env.temp_dir().join("jet_codemod_{tag}_{id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    dir
}

// Rust: tests/codemod.rs:22
pub fn check_stderr(path: OSPath) -> [U8] {
    output :: Command.new(jet()).args(["check", path.to_str().unwrap()]).output().expect("jet check fixture")
    assert(!output.status.success(), "fixture must fail")
    rendered := String.from_utf8(output.stderr).unwrap()
    if rendered.find("\n1 problem found\n") == Val(at) {
        &rendered.truncate(at)
        loop rendered.ends_with("\n\n") { _ :: &rendered.pop() }
        if !rendered.ends_with("\n") { &rendered.push('\n') }
    }
    rendered.into_bytes()
}

// Rust: tests/codemod.rs:281
pub fn simple_batch(project: OSPath, matches: USize) -> OSPath {
    example :: project.join("Examples/a.jet")
    fs.create_dir_all(example.parent().unwrap()).unwrap()
    fs.write(example, "fn report() {{ print(\"ok\") }}\nfn run() {{ report() }}\n").unwrap()
    object :: project.join("rename.codemod.json")
    fs.write(object, "{{\"version\":2,\"name\":\"BatchRename\",\"project\":\".\",\"roots\":[{{\"path\":\"Examples/a.jet\",\"validate\":\"clean\"}}],\"rules\":[{{\"id\":\"rename\",\"kind\":\"symbol_rename\",\"from\":{{\"name\":\"report\",\"symbol_kind\":\"function\"}},\"to\":\"summarize\",\"matches\":{matches}}}]}}\n").unwrap()
    object
}
