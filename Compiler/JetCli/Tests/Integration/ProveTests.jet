// Rust: tests/prove.rs:209
#Test("prove_capture_replay_round_trip_and_corruption_fail_closed") {
    root :: workspace("replay_round_trip")
    store :: root.join("store")
    fs.write(root.join("main.jet"), "use core.time as time\n#Test(\"recorded time\") {{ observed :: time.now() }}\n").unwrap()
    artifact :: root.join("capture.jetproof-replay")
    artifact_arg :: artifact.file_name().unwrap().to_string_lossy().to_string()
    captured :: Command.new(jet()).current_dir(root).args(["prove", "main.jet", "--capture={artifact_arg}", "--json"]).env("JET_STORE_DIR", store).output().unwrap()
    assert_eq(captured.status.code(), Val(0), "stderr={String.from_utf8_lossy(captured.stderr)} stdout={String.from_utf8_lossy(captured.stdout)} artifact={artifact.display()}")
    assert(artifact.is_file())
    assert(captured.stderr.is_empty(), "JSON capture leaked stderr: {String.from_utf8_lossy(captured.stderr)}")
    captured_report :: String.from_utf8_lossy(captured.stdout)
    assert(captured_report.contains("\"inputSha256\":\""), "capture report lost target input hash: {captured_report}")
    assert(captured_report.contains("\"targetTriple\":\""), "capture report lost target triple: {captured_report}")
    artifact_bytes :: fs.read(artifact).unwrap()
    assert(artifact_bytes.starts_with("JREPLAY{TEXT_NUL}".as_bytes()))
    artifact_text :: String.from_utf8_lossy(artifact_bytes)
    assert(artifact_text.contains("\"roots\":[\"Time\"]"))
    assert(artifact_text.contains("\"time_site_id\":"))
    build_digest :: artifact_text.split("\"build_digest\":\"").nth(1).and_then(tail -> tail.split('"').next()).expect("replay identity build digest")
    assert(build_digest.len() == 64 && build_digest.bytes().all(byte -> byte.is_ascii_hexdigit()), "replay identity build digest is not a SHA-256 hash: {build_digest}")
    assert(artifact_text.contains("\"source_digest\":\""))
    assert(artifact_text.contains("\"semantic_mir_hash\":\""))
    assert(artifact_text.contains("\"optimized_mir_hash\":\""))
    assert(artifact_text.contains("\"mir_schema\":\"mir-v1\""))
    replayed :: Command.new(jet()).current_dir(root).args(["prove", "main.jet", "--replay", artifact_arg, "--json"]).env("JET_STORE_DIR", store).output().unwrap()
    assert_eq(replayed.status.code(), Val(0), "{String.from_utf8_lossy(replayed.stderr)}")
    assert(replayed.stderr.is_empty(), "JSON replay leaked stderr: {String.from_utf8_lossy(replayed.stderr)}")
    report :: String.from_utf8(replayed.stdout).unwrap()
    assert(report.contains("\"facet\":\"replay\""), report)
    assert(report.contains("\"reason\":\"parity_not_available\""), report)
    corrupt := fs.read(artifact).unwrap()
    middle :: corrupt.len() / 2
    corrupt[middle] ^= 1
    fs.write(artifact, corrupt).unwrap()
    rejected :: Command.new(jet()).current_dir(root).args(["prove", "main.jet", "--replay", artifact_arg]).env("JET_STORE_DIR", store).output().unwrap()
    assert_eq(rejected.status.code(), Val(1))
    assert(String.from_utf8_lossy(rejected.stderr).contains("Error [E3622]"))
}
// Rust: tests/prove.rs:311
#Test("run_recorded_alias_time_receipt_replays_without_execution") {
    root :: workspace("recorded_debug_queries")
    fs.write(root.join("package.jet"), "name: \"recorded-time\"\nversion: \"0.1.0\"\nauthority: {{ holds: {{ allow: [IO, Mem.Alloc, Time, Exec] }} }}\n").unwrap()
    fs.write(root.join("main.jet"), "use core.time as time\nuse core.process as process\nfn run() {{\n    observed :: time.now()\n    argument :: process.args()[0]\n    marker :: \"recorded-{{observed}}\"\n    print(marker)\n    print(argument)\n}}\n").unwrap()
    recorded :: Command.new(jet()).current_dir(root).args(["run", "main.jet", "--record=causal", "--", "recorded-arg"]).output().unwrap()
    assert_eq(recorded.status.code(), Val(0), "{String.from_utf8_lossy(recorded.stderr)}")
    recorded_stdout :: String.from_utf8_lossy(recorded.stdout)
    recorded_value :: recorded_stdout.lines().find_map(line -> line.strip_prefix("recorded-")).expect("recorded run must print the captured time").to_string()
    assert(recorded_value.parse<Int64>().is_ok(), "captured time is not an integer: {recorded_value}")
    assert(recorded_stdout.lines().any(line -> line == "recorded-arg"))
    artifact :: root.join(".jet/replays/causal.jetproof-replay")
    assert(artifact.is_file())
    debug := Command.new(jet()).current_dir(root).args(["debug", "main.jet", "--replay=causal"]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().unwrap()
    debug.stdin.take().unwrap().write_all("why observed == {recorded_value}\nwhen observed\nc\n".as_bytes()).unwrap()
    output :: debug.wait_with_output().unwrap()
    assert_eq(output.status.code(), Val(0), "{String.from_utf8_lossy(output.stderr)}")
    stdout :: String.from_utf8_lossy(output.stdout)
    assert(stdout.contains("observed = {recorded_value} because act"), stdout)
    assert(stdout.contains("last change:"), stdout)
    assert(!stdout.contains("recorded-{recorded_value}"), "receipt replay re-executed program output: {stdout}")
}
