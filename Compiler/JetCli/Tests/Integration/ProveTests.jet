// Rust: tests/prove.rs:1054
#Test("prove_solver_lens_emits_checked_certificate_evidence") {
    root :: workspace("solver_lens")
    fs.write(root.join("checked.jet"), "#[Pre(value > 0, \"positive\"), Post(result == value, \"unchanged\")] fn checked(value: Int) -[]> Int {{ return value }}\n").unwrap()
    out :: Command.new(jet()).current_dir(root).args(["prove", "checked.jet", "--lens", "solver", "--json"]).output().unwrap()
    assert_eq(out.status.code(), Val(0), "stderr={String.from_utf8_lossy(out.stderr)} stdout={String.from_utf8_lossy(out.stdout)}")
    report :: String.from_utf8_lossy(out.stdout)
    assert(report.contains("\"facet\":\"solver\""), report)
    assert(report.contains("\"status\":\"proved\""), report)
    assert(report.contains("\"certificateSha256\":"), report)
    assert(report.contains("\"backend\":\"native-presburger\""), report)
    assert(report.contains("\"solver\":{{\"disproved\":0,\"proved\":1"), report)
    repeated :: Command.new(jet()).current_dir(root).args(["prove", "checked.jet", "--lens", "solver", "--json"]).output().unwrap()
    assert_eq(repeated.status.code(), Val(0))
    assert_eq(out.stdout, repeated.stdout, "solver certificate output is not deterministic")
}
