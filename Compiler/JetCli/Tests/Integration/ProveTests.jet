// Rust: tests/prove.rs:1177
#Test("prove_replay_rejects_schema_and_identity_changes_as_typed_failures") {
    root :: workspace("replay_identity_schema")
    fs.write(root.join("main.jet"), "fn run() {{}}\n").unwrap()
    artifact :: "capture.jetproof-replay"
    captured :: Command.new(jet()).current_dir(root).args(["prove", "main.jet", "--capture={artifact}", "--json"]).output().unwrap()
    assert_eq(captured.status.code(), Val(0))
    artifact_path :: root.join(artifact)
    original :: fs.read(artifact_path).unwrap()
    incompatible := ~original
    incompatible[10] = 1
    fs.write(artifact_path, incompatible).unwrap()
    schema :: Command.new(jet()).current_dir(root).args(["prove", "main.jet", "--replay", artifact, "--json"]).output().unwrap()
    assert_eq(schema.status.code(), Val(1))
    assert(schema.stderr.is_empty())
    assert(String.from_utf8_lossy(schema.stdout).contains("\"code\":\"E3620\""))
    fs.write(artifact_path, original).unwrap()
    fs.write(root.join("main.jet"), "fn run() {{ assert(false) }}\n").unwrap()
    identity :: Command.new(jet()).current_dir(root).args(["prove", "main.jet", "--replay", artifact, "--json"]).output().unwrap()
    assert_eq(identity.status.code(), Val(1))
    assert(identity.stderr.is_empty())
    assert(String.from_utf8_lossy(identity.stdout).contains("\"code\":\"E3621\""))
}
