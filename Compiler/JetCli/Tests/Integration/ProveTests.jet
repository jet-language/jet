use std.[fs, process]
use std.process.[Command, Stdio]
use core.sys.target
use jet_foundation.TEXT_NUL
use jet_cli.Tests.Integration.Prove.[jet, workspace, budget_workspace]
// GATE #4494: all commands, pipes, artifact bytes and filesystem operations are native.

// Rust: tests/prove.rs:53
#Test("prove_projects_compatible_canonical_budget_identity_without_measuring") {
    root :: budget_workspace("budget_projection")
    checked :: Command.new(jet()).current_dir(root).args(["budget", "check", "--json"]).output().unwrap()
    assert_eq(checked.status.code(), Val(0), "{String.from_utf8_lossy(checked.stderr)}")
    command :: String.from_utf8(checked.stdout).unwrap()
    report_id :: command.split("\"report_id\":\"").nth(1).unwrap().split('"').next().unwrap().to_string()
    before :: fs.read_dir(root.join(".jet/perf/reports")).unwrap().count()
    out :: Command.new(jet()).current_dir(root).args(["prove", "src/run.jet", "--json"]).output().unwrap()
    assert_eq(out.status.code(), Val(0), "{String.from_utf8_lossy(out.stderr)}")
    proof :: String.from_utf8(out.stdout).unwrap()
    assert(proof.contains("\"producer\":\"jet-budget\""), proof)
    assert(proof.contains("\"budgetId\":\"package:public-api\""), proof)
    assert(proof.contains("\"reportId\":\"{report_id}\""), proof)
    assert(proof.contains("\"deterministicBudget\":{{\"failed\":0,\"met\":1,\"selected\":1"), proof)
    assert_eq(fs.read_dir(root.join(".jet/perf/reports")).unwrap().count(), before, "prove measured or wrote a report")
}
// Rust: tests/prove.rs:113
#Test("prove_json_is_derived_from_real_front_end_and_sorted_target") {
    root :: workspace("report")
    fs.write(root.join("b.jet"), "fn b() -[]> Int {{ return 2 }}\n").unwrap()
    fs.write(root.join("a.jet"), "fn a() -[]> Int {{ return 1 }}\n").unwrap()
    out :: Command.new(jet()).current_dir(root).args(["prove", ".", "--json"]).output().unwrap()
    assert_eq(out.status.code(), Val(0), "{String.from_utf8_lossy(out.stderr)}")
    report :: String.from_utf8(out.stdout).unwrap()
    assert(report.contains("\"kind\":\"workspace\""), report)
    assert(report.find("a.jet").unwrap() < report.find("b.jet").unwrap(), report)
    assert(report.contains("\"producer\":\"jet-sema\""), report)
    assert(report.contains("\"frontEnd\":{{\"failed\":0,\"proved\":2,\"selected\":2"), report)
}
