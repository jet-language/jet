use tests.tir_support.[assert_tiers_agree]
use jetpack.RuntimePolicy.[detect_sandbox, SandboxLevel]

// Rust: tests/authority_receipts.rs:10
fn native_backend_available() -> Bool {
    detect_sandbox().level == SandboxLevel.Strong
}

// Rust: tests/authority_receipts.rs:16
#Test("authority_process_receipt_redacts_success_argv_and_output_on_all_hosted_tiers") {
    if !["linux", "macos"].contains(core.sys.target.selected_os()) -> return
    source :: """
use core.process as process

fn run() -> {
    policy :: process.workspace()
    spec :: process.cmd(["/bin/sh", "-c", "printf '%s' \"$SECRET_TOKEN\"; printf '%s' authority-success-secret >&2"])
        .env_clear()
        .env("SECRET_TOKEN", "authority-success-secret")
        .stdout(.Capture)
        .stderr(.Capture)
        .cwd("/tmp")
        .under(policy)
    if spec.plan() == {
        .Ok(plan) -> {
            receipt :: spec.run() ?? panic("authority-bound receipt failed")
            print(plan.policy_digest == receipt.policy_digest)
            print(plan.argv[2].contains("authority-success-secret") == false)
            print(receipt.argv[2].contains("authority-success-secret") == false)
            print(receipt.output)
            print(receipt.errors)
            print(receipt.success)
            print(receipt.redacted)
        }
        .Err(_) -> print("unsupported")
    }
}
"""
    expected :: if native_backend_available() -> "true\ntrue\ntrue\n<redacted>\n<redacted>\ntrue\ntrue\n" else -> "unsupported\n"
    assert_tiers_agree("authority_process_receipt_success_redaction", source, expected)
}

// Rust: tests/authority_receipts.rs:58
#Test("authority_process_receipt_redacts_failed_output_on_all_hosted_tiers") {
    if !["linux", "macos"].contains(core.sys.target.selected_os()) -> return
    source :: """
use core.process as process

fn run() -> {
    policy :: process.workspace()
    spec :: process.cmd(["/bin/sh", "-c", "printf '%s' \"$SECRET_TOKEN\" >&2; exit 17"])
        .env_clear()
        .env("SECRET_TOKEN", "authority-failure-secret")
        .stdout(.Capture)
        .stderr(.Capture)
        .cwd("/tmp")
        .under(policy)
    if spec.plan() == {
        .Ok(_) -> {
            receipt :: spec.run() ?? panic("authority-bound failed receipt missing")
            print(receipt.success)
            print(receipt.code == 17)
            print(receipt.errors)
            print(receipt.redacted)
        }
        .Err(_) -> print("unsupported")
    }
}
"""
    expected :: if native_backend_available() -> "false\ntrue\n<redacted>\ntrue\n" else -> "unsupported\n"
    assert_tiers_agree("authority_process_receipt_failure_redaction", source, expected)
}

// Rust: tests/authority_receipts.rs:97
#Test("authority_process_refuses_live_output_before_spawn_on_all_hosted_tiers") {
    if core.sys.target.selected_family() != "unix" -> return
    source :: """
use core.process as process

fn run() -> {
    policy :: process.workspace()
    spec :: process.cmd(["/bin/sh", "-c", "printf '%s' \"$SECRET_TOKEN\""])
        .env_clear()
        .env("SECRET_TOKEN", "stream-secret")
        .stdout(.Stream)
        .stderr(.Capture)
        .cwd("/tmp")
        .under(policy)
    if spec.run() == {
        .Ok(_) -> print("accepted")
        .Err(_) -> print("refused")
    }
}
"""
    assert_tiers_agree("authority_process_receipt_stream_redaction", source, "refused\n")
}

// Rust: tests/authority_receipts.rs:125
#Test("authority_process_refuses_terminal_audit_bypass_on_all_hosted_tiers") {
    if core.sys.target.selected_family() != "unix" -> return
    source :: """
use core.process as process

fn run() -> {
    policy :: process.workspace()
    spec :: process.cmd(["/bin/sh", "-c", "printf terminal-secret"])
        .terminal()
        .cwd("/tmp")
        .under(policy)
    if spec.plan() == {
        .Ok(_) -> print("accepted")
        .Err(_) -> print("refused")
    }
}
"""
    assert_tiers_agree("authority_process_terminal_audit_boundary", source, "refused\n")
}
