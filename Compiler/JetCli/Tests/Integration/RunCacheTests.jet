// Rust: tests/run_cache.rs:149
use Compiler.JetCli.Tests.Integration.RunCache.*
use Compiler.JetCli.Tests.Integration.Common as common
use jet.RunCache
use std.[env, fs, Command, Instant]
use core.sys.target.selected_family
// GATE #4494: native in-process run-cache capture/replay and phase/trace hooks,
// real filesystem, process, PTY, environment and clock providers.
// Rust's retiring JIT representation checks map to native O0 cache behavior;
// run_native_once and take_last_trace belong to the canonical native run-cache owner.

// Rust: tests/run_cache.rs:149
#Test("warm_hit_skips_front_end_and_matches_stdout") {
    _guard :: lock_run_cache_tests()
    root :: common.test_scratch_root("run_cache").join("jet_run_cache_{unique()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root).expect("create root")
    file :: root.join("hi.jet")
    fs.write(file, "fn run() -> {\n    print(\"warm-ok\")\n}\n").expect("write entry")
    cache :: root.join("cache")
    (c1, out1, err1) :: run_jet(cache, file, None, [("JET_RUN_TRACE", "1")])
    assert_eq(c1, 0, "cold failed: {err1}")
    assert_eq(out1, "warm-ok\n")
    assert(err1.contains("[run-cache] store"), "expected store: {err1}")
    (c2, out2, err2) :: run_jet(cache, file, None, [("JET_RUN_TRACE", "1")])
    assert_eq(c2, 0, "warm failed: {err2}")
    assert_eq(out2, "warm-ok\n")
    assert(err2.contains("[run-cache] hit"), "expected hit: {err2}")
    fs.write(file, "fn run() -> {\n    print(\"changed\")\n}\n").expect("edit entry")
    (c3, out3, err3) :: run_jet(cache, file, None, [("JET_RUN_TRACE", "1")])
    assert_eq(c3, 0, "re-cold failed: {err3}")
    assert_eq(out3, "changed\n")
    assert(err3.contains("[run-cache] store"), "expected re-store after edit: {err3}")
}

// Rust: tests/run_cache.rs:179
#Test("named_job_warm_hit_preserves_selection_and_arguments") {
    _guard :: lock_run_cache_tests()
    repo :: OSPath.from(env.manifest_dir())
    source_project :: repo.join("Examples/features/devloop")
    assert(!source_project.join(".jet").exists(), "checked-in job example already has generated `.jet` state")
    staged :: common.ProjectScratch.for_project(source_project, "run-cache-job")
    file :: staged.path.join("job_runner.jet")
    expected :: fs.read(repo.join("Examples/features/expected/devloop/job_runner.greet.out")).expect("expected job output")
    cache :: common.test_scratch_root("run_cache").join("jet_run_job_cache_{unique()}")
    _ :: fs.remove_dir_all(cache)
    run :: () -> { Command.new(jet_bin()).args(["run", file.to_str().expect("file text"), "--", "greet"]).current_dir(staged.path).env("JET_RUN_CACHE_DIR", cache).env("JET_RUN_TRACE", "1").env("NO_COLOR", "1").output().expect("run named job") }
    cold :: run()
    assert(cold.status.success(), "{String.from_utf8_lossy(cold.stderr)}")
    assert_eq(cold.stdout, expected)
    assert(String.from_utf8_lossy(cold.stderr).contains("[run-cache] store"), "{String.from_utf8_lossy(cold.stderr)}")
    warm :: run()
    assert(warm.status.success(), "{String.from_utf8_lossy(warm.stderr)}")
    assert_eq(warm.stdout, expected)
    assert(String.from_utf8_lossy(warm.stderr).contains("[run-cache] hit"), "{String.from_utf8_lossy(warm.stderr)}")
    assert(!source_project.join(".jet").exists(), "named-job execution created `.jet` in the checked-in example project")
}

