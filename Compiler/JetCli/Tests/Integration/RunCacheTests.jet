#Test("warm_runtime_stop_preserves_source_location") {
    _guard :: lock_run_cache_tests()
    root :: common.test_scratch_root("run_cache").join("jet_run_stop_location_{unique()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root).expect("create root")
    file :: root.join("bounds.jet")
    fs.write(file, "fn run() -> {\n    n := 1\n    xs := [n]\n    print(xs[9])\n}\n").expect("write bounds")
    cache :: root.join("cache")
    (cold_code, _, cold_err) :: run_jet(cache, file, None, [])
    (warm_code, _, warm_err) :: run_jet(cache, file, None, [])
    arrow :: "  --> {file.display()}:4"
    assert_eq(cold_code, 70, "cold stderr: {cold_err}")
    assert_eq(warm_code, 70, "warm stderr: {warm_err}")
    assert(cold_err.contains(arrow), "cold stderr: {cold_err}")
    assert(warm_err.contains(arrow), "warm stderr: {warm_err}")
}

// Rust: tests/run_cache.rs:263
#Test("dependency_and_argv_invalidate_cache_key") {
    _guard :: lock_run_cache_tests()
    root :: common.test_scratch_root("run_cache").join("jet_run_dep_{unique()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root).expect("create root")
    dep :: root.join("dep.jet")
    main :: root.join("main.jet")
    fs.write(dep, "pub fn greet() -> {\n    print(\"v1\")\n}\n").expect("write dependency")
    fs.write(main, "use dep\nfn run() -> {\n    dep.greet()\n}\n").expect("write main")
    k1 :: RunCache.run_cache_key(main, [])
    fs.write(dep, "pub fn greet() -> {\n    print(\"v2\")\n}\n").expect("edit dependency")
    k2 :: RunCache.run_cache_key(main, [])
    assert_ne(k1, k2, "dependency content must invalidate run-cache key")
    k3 :: RunCache.run_cache_key(main, ["--x"])
    assert_ne(k2, k3, "argv must participate in run-cache key")
}

