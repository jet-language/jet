use std.[fs, env, process]
use std.process.[Command, Output]
// GATE #4494: real native CLI, filesystem and process identity.

// Rust: tests/review.rs:5
pub fn scratch(name: &String) -> OSPath {
    env.temp_dir().join("jet_review_{name}_{process.id()}")
}

// Rust: tests/review.rs:9
pub fn write(path: &OSPath, text: &String) -> {
    if parent :: path.parent() { fs.create_dir_all(parent).expect("create fixture parent") }
    fs.write(path, text).expect("write review fixture")
}

// Rust: tests/review.rs:15
pub const REVIEW_SOURCE: String = "fn run() {{}}\n"

// Rust: tests/review.rs:17
pub fn project(root: &OSPath, side: &String, allow: &String, source: &String) -> OSPath {
    dir :: root.join(side)
    manifest :: if allow.is_empty() -> "name: \"review_fixture\"\nversion: \"0.1.0\"\nedition: \"2026\"\n" else -> "name: \"review_fixture\"\nversion: \"0.1.0\"\nedition: \"2026\"\nauthority: {{ holds: {{ allow: [{allow}] }} }}\n"
    write(&dir.join("package.jet"), &manifest)
    write(&dir.join("run.jet"), source)
    dir
}

// Rust: tests/review.rs:31
pub fn review_command(base: &OSPath, head: &OSPath, base_receipt: OSPath?, head_receipt: OSPath?) -> Output {
    args := ["review", base.join("run.jet").to_str().expect("UTF-8 base").to_string(), head.join("run.jet").to_str().expect("UTF-8 head").to_string(), "--json"]
    if path :: base_receipt { args.extend(["--base-receipt", path.to_str().expect("UTF-8 receipt").to_string()]) }
    if path :: head_receipt { args.extend(["--receipt", path.to_str().expect("UTF-8 receipt").to_string()]) }
    Command.new(env.var_os("CARGO_BIN_EXE_jet").expect("native Jet test executable")).args(args).env("NO_COLOR", "1").output().expect("run review")
}

// Rust: tests/review.rs:56
pub fn diagnostic_review_command(base: &OSPath, head: &OSPath) -> Output {
    Command.new(env.var_os("CARGO_BIN_EXE_jet").expect("native Jet test executable"))
        .args(["review", base.join("run.jet").to_str().expect("UTF-8 base"), head.join("run.jet").to_str().expect("UTF-8 head"), "--diagnostics", "--json"])
        .env("NO_COLOR", "1").output().expect("run diagnostic review")
}

// Rust: tests/review.rs:70
pub fn checked_derivation(id: &String, build: &String, run: &String, target: &String, event: &String) -> String {
    "{{\"id\":\"{id}\",\"subject\":\"value\",\"claim\":\"value:contract\",\"producer\":\"test\",\"method\":\"formal_proof\",\"rule\":\"same-inputs\",\"premises\":[\"schedule:v1\"],\"identity\":{{\"source\":\"review-source\",\"build\":\"{build}\",\"run\":\"{run}\",\"target\":\"{target}\"}}, \"assumptions\":[\"finite-input\"],\"disposition\":\"current\",\"observation\":{{\"event\":\"{event}\",\"counterexample\":null}}}}"
}

// Rust: tests/review.rs:82
pub fn proof_evidence(claim_id: &String, derivation_id: &String, outcome: &String, state: &String, target: &String, argument: I64, schedule: &String) -> String {
    "{{\"id\":\"{claim_id}\",\"claimId\":\"{claim_id}\",\"kind\":\"contract\",\"facet\":\"contracts\",\"producer\":\"test\",\"outcome\":\"{outcome}\",\"state\":\"{state}\",\"contract\":{{\"marker\":\"review\",\"observation\":\"reached\"}},\"inputs\":{{\"arg\":{argument}}},\"environment\":{{\"target\":\"{target}\"}}, \"premises\":[\"{schedule}\"],\"derivation\":{{\"id\":\"{derivation_id}\"}}}}"
}

// Rust: tests/review.rs:96
pub fn proof_receipt(derivations: &[String], evidence: &[String]) -> String {
    "{{\"proofReport\":{{\"derivations\":[{derivations.join(",")}],\"evidence\":[{evidence.join(",")}]}}}}"
}

// Rust: tests/review.rs:104
pub fn run_receipt_case(name: &String, base_receipt: String?, head_receipt: String?, base_allow: &String, head_allow: &String, expected: &[String]) -> {
    root :: scratch(name)
    _ :: fs.remove_dir_all(root)
    base :: project(&root, "base", base_allow, &REVIEW_SOURCE)
    head :: project(&root, "head", head_allow, &REVIEW_SOURCE)
    base_receipt_path :: base_receipt.map((_) -> root.join("base.jetproof"))
    head_receipt_path :: head_receipt.map((_) -> root.join("head.jetproof"))
    if (Some(path), Some(contents)) :: (base_receipt_path, base_receipt) { write(&path, &contents) }
    if (Some(path), Some(contents)) :: (head_receipt_path, head_receipt) { write(&path, &contents) }
    output :: review_command(&base, &head, base_receipt_path, head_receipt_path)
    diagnostic :: "{String.from_utf8_lossy(output.stdout)}\n{String.from_utf8_lossy(output.stderr)}"
    assert(output.status.success(), "review fixture `{name}` failed: {diagnostic}")
    stdout :: String.from_utf8(output.stdout).expect("UTF-8 review output")
    for needle in expected { assert(stdout.contains(needle), "review fixture `{name}` omitted `{needle}`:\n{stdout}") }
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/review.rs:149
pub fn assert_receipt_refused(name: &String, receipt: &String, reason: &String) -> {
    root :: scratch(name)
    _ :: fs.remove_dir_all(root)
    base :: project(&root, "base", "", &REVIEW_SOURCE)
    head :: project(&root, "head", "", &REVIEW_SOURCE)
    receipt_path :: root.join("invalid.jetproof")
    write(&receipt_path, receipt)
    output :: review_command(&base, &head, Some(receipt_path), None)
    assert(!output.status.success(), "receipt fixture `{name}` unexpectedly succeeded: {String.from_utf8_lossy(output.stdout)}")
    diagnostic :: "{String.from_utf8_lossy(output.stdout)}\n{String.from_utf8_lossy(output.stderr)}"
    assert(diagnostic.contains("E2105"), "receipt fixture `{name}` omitted E2105:\n{diagnostic}")
    assert(diagnostic.contains(reason), "receipt fixture `{name}` omitted `{reason}`:\n{diagnostic}")
    _ :: fs.remove_dir_all(root)
}
