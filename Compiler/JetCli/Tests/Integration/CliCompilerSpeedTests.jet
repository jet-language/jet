// Rust: tests/cli_compiler_speed.rs:302
#Test("compiler_speed_checker_accepts_generated_baseline") {
    if selected_family() != "unix" -> return // GATE #4483
    baseline :: synthetic_v4_baseline()
    report :: checker_report_from_baseline(baseline)
    output :: run_checker_fixture("compiler-speed-checker-accept", baseline, report)
    assert(output.status.code() == Val(0), "generated baseline was rejected:\n{output_text(output)}")
