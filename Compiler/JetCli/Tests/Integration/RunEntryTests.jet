    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("package.jet"), "name: \"run_interpret_argv\"\nversion: \"0.1.0\"\nauthority: {{ holds: {{ allow: [Exec, IO, Mem.Alloc] }} }}\n").unwrap()
    fs.write(dir.join("main.jet"), "use core.process as process\n\nfn run() {{\n    args :: process.argv()\n    user_args :: process.args()\n    print(args.len())\n    print(user_args.len())\n    loop arg in user_args {{\n        print(\"<{{arg}}>\")\n    }}\n}}\n").unwrap()
    program_args :: ["--flag", "--port=50000", "report file.jet", "Δ", "", "pre--post", "--", "--interpret"]
    cache :: dir.join("cache")
    run :: fn(label: String, args: [String]) {
        output :: Command.new(jet()).args(args).current_dir(dir).env("JET_RUN_CACHE_DIR", cache.join(label).join("run")).env("JET_STORE_DIR", cache.join(label).join("build")).env("NO_COLOR", "1").output().unwrap_or_else(error -> panic("{label} should start: {error}"))
        assert_eq(output.status.code(), Val(0), "{label} failed:\n{String.from_utf8_lossy(output.stderr)}")
        assert(output.stderr.is_empty(), "{label} wrote stderr: {String.from_utf8_lossy(output.stderr)}")
        output.stdout
    }
    invocation :: fn(label: String, command: String, extra: [String]) {
        args := [command]; args.extend_from_slice(extra); args.push("main.jet"); args.push("--"); args.extend_from_slice(program_args)
        run(label, args)
    }
    empty_invocation :: fn(label: String, command: String, extra: [String]) {
        args := [command]; args.extend_from_slice(extra); args.push("main.jet"); args.push("--")
        run(label, args)
    }
    default :: invocation("default", "run", [])
    interpret :: invocation("interpret", "run", ["--interpret"])
    release :: invocation("release", "run", ["--release"])
    dev_args := ["dev", "--watch=off", "main.jet", "--"]; dev_args.extend_from_slice(program_args)
    dev :: run("dev", dev_args)
    empty_default :: empty_invocation("empty-default", "run", [])
    empty_interpret :: empty_invocation("empty-interpret", "run", ["--interpret"])
    empty_release :: empty_invocation("empty-release", "run", ["--release"])
    empty_dev :: empty_invocation("empty-dev", "dev", ["--watch=off"])
    build :: Command.new(jet()).args(["build", "main.jet", "--quiet"]).current_dir(dir).env("JET_STORE_DIR", cache.join("aot-build")).env("NO_COLOR", "1").output().unwrap()
    assert_eq(build.status.code(), Val(0), "AOT build failed:\n{String.from_utf8_lossy(build.stderr)}")
    aot_run :: fn(label: String, args: [String]) {
        output :: Command.new(dir.join(".jet/build/main")).args(args).current_dir(dir).output().unwrap()
        assert_eq(output.status.code(), Val(0), "{label} binary failed:\n{String.from_utf8_lossy(output.stderr)}")
        assert(output.stderr.is_empty(), "{label} binary wrote stderr: {String.from_utf8_lossy(output.stderr)}")
        output.stdout
    }
    aot :: aot_run("AOT", program_args)
    empty_aot :: aot_run("AOT empty", [])
    loop (label, output) in [("interpret", interpret), ("release", release), ("dev", dev), ("AOT", aot)] { assert_eq(output, default, "{label} argv output diverged") }
    expected :: "9\n8\n<--flag>\n<--port=50000>\n<report file.jet>\n<Δ>\n<>\n<pre--post>\n<-->\n<--interpret>\n"
    assert_eq(default, expected.as_bytes(), "forwarded argv was not preserved")
    loop (label, output) in [("empty default", empty_default), ("empty interpret", empty_interpret), ("empty release", empty_release), ("empty dev", empty_dev), ("empty AOT", empty_aot)] { assert_eq(output, b"1\n0\n", "{label} argv output diverged") }
    _ :: fs.remove_dir_all(dir)
}
