// Rust: tests/run_interpret.rs:13
#Test("run_interpret_forces_tier_zero_without_watch") {
    dir :: env.temp_dir().join("jet_run_interpret_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("package.jet"), "name: \"run_interpret_tier\"\nversion: \"0.1.0\"\nauthority: {{ holds: {{ allow: [IO] }} }}\n").unwrap()
    marker :: "run-interpreter-{process.id()}"
    fs.write(dir.join("main.jet"), "fn run() {{\n    print(\"{marker}\")\n}}\n").unwrap()
    default :: Command.new(jet()).args(["run", "--trace-tiers", "main.jet"]).current_dir(dir).env("JET_RUN_CACHE_DIR", dir.join("run-cache")).env("NO_COLOR", "1").output().unwrap()
    assert_eq(default.status.code(), Val(0), "{String.from_utf8_lossy(default.stderr)}")
    assert(!default.stdout.is_empty(), "default tier returned success with empty stdout: {String.from_utf8_lossy(default.stderr)}")
    assert_eq(default.stdout, "{marker}\n".as_bytes())
    assert(String.from_utf8_lossy(default.stderr).contains("O1"))
    forced :: Command.new(jet()).args(["run", "--trace-tiers", "--interpret", "main.jet"]).current_dir(dir).env("JET_RUN_CACHE_DIR", dir.join("run-cache")).env("NO_COLOR", "1").output().unwrap()
    assert_eq(forced.status.code(), Val(0), "{String.from_utf8_lossy(forced.stderr)}")
    assert(!forced.stdout.is_empty())
    assert(!String.from_utf8_lossy(forced.stderr).contains("O1"))
    assert_eq(forced.stdout, default.stdout)
    _ :: fs.remove_dir_all(dir)
}
