// Rust: tests/run_entry.rs:661
#Test("unit_fallible_signatures_lower_with_value_fallible_returns") {
    src :: `
struct Config { value: Int }
fn save(path: String) IOError! {
    return .Err(IOError.InvalidInput(IOContext{
        operation: .Read,
        resource: None,
        os_code: None,
        cause: Val("not implemented"),
    }))
}
fn sync() { return Err("not implemented") }
fn load() -> Config IOError! { return Ok(Config{ value: 1 }) }
fn run() {}
`
    out :: compile(src).expect("unit and value fallible signatures should compile")
    // This is a source-only reference codegen comparator, not native execution.
    loop function in ["__jet_save", "__jet_sync", "__jet_load"] {
        assert(out.rust.contains("pub fn {function}"), "lowered output omitted {function}:\n{out.rust}")
    }
    assert(out.rust.contains("pub fn __jet_load") && out.rust.contains("JetOutcome<__jet_Config"), "value-returning fallible signature lost its value type:\n{out.rust}")
}
