    _ :: fs.remove_dir_all(cache)
    run :: fn(mode: String) {
        command := Command.new(jet()); command.arg("run")
        if mode == { "release" -> command.arg("--release"); "interpret" -> command.arg("--interpret"); _ -> {} }
        command.arg("run.jet").current_dir(project).env("JET_RUN_CACHE_DIR", cache.join(mode).join("run")).env("JET_STORE_DIR", cache.join(mode).join("build")).env("NO_COLOR", "1").env("JETPACK_ENV", "1").output().unwrap()
    }
    release :: run("release"); default :: run("default"); interpret :: run("interpret")
    loop (mode, output) in [("release", release), ("default", default), ("interpret", interpret)] {
        assert_eq(output.status.code(), Val(0), "{mode} C extern run failed:\n{String.from_utf8_lossy(output.stderr)}")
        assert_eq(output.stdout, b"10\n7\n", "{mode} C extern output")
        assert(output.stderr.is_empty(), "{mode} C extern stderr: {output.stderr:?}")
    }
    _ :: fs.remove_dir_all(cache)
}
// Rust: tests/run_interpret.rs:395
#Test("sieve_scales_linearly") {
    MEASURED_SAMPLES :: 3
    RUN_TIMEOUT :: time.Duration.from_secs(30)
    root :: OSPath.from(env.manifest_dir())
    fixture :: root.join("Tools/gauntlet/entries/sieve/jet")
    scratch :: common.Scratch.new("sieve-scales-linearly")
    loop file in ["package.jet", "run.jet"] {
        fs.copy(fixture.join(file), scratch.path.join(file)).unwrap_or_else(error -> panic("copy sieve fixture `{file}`: {error}"))
    }
    cases :: [(10000, b"count 1229\nlargest 9973\n"), (100000, b"count 9592\nlargest 99991\n")]
    run :: fn(n: U32) {
        n_arg :: n.to_string()
        started :: time.Instant.now()
        child := Command.new(jet()).args(["run", "--interpret", "run.jet", "--", n_arg]).current_dir(scratch.path).env("JET_RUN_CACHE_DIR", scratch.path.join("run-cache")).env("JET_STORE_DIR", scratch.path.join("store")).env("NO_COLOR", "1").stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().unwrap_or_else(error -> panic("start sieve n={n}: {error}"))
        loop {
            if child.try_wait().unwrap_or_else(error -> panic("poll sieve n={n}: {error}")).is_some() -> break
            if started.elapsed() >= RUN_TIMEOUT {
                _ :: child.kill(); _ :: child.wait()
                panic("sieve n={n} exceeded {RUN_TIMEOUT:?}")
            }
            thread.sleep(time.Duration.from_millis(10))
        }
        output :: child.wait_with_output().unwrap_or_else(error -> panic("collect sieve n={n}: {error}"))
        assert_eq(output.status.code(), Val(0), "sieve n={n} failed:\n{String.from_utf8_lossy(output.stderr)}")
        assert(output.stderr.is_empty(), "sieve n={n} wrote stderr: {String.from_utf8_lossy(output.stderr)}")
        (started.elapsed().as_nanos(), output.stdout)
    }
    (_, stdout) :: run(10000)
    assert_eq(stdout, b"count 1229\nlargest 9973\n", "sieve n=10000 output changed")
    timings := [(U32, U128)]{}
    loop (n, expected) in cases {
        samples := [U128]{}
        loop _ in 0..<MEASURED_SAMPLES {
            (elapsed, stdout) :: run(n)
            assert_eq(stdout, expected, "sieve n={n} output changed")
            samples.push(elapsed)
        }
        timings.push((n, median_nanos(&samples)))
    }
    small :: timings[0].1; large :: timings[1].1
    assert(small > 0 && large > 0, "sieve timings must be positive")
    eprintln("native O0 sieve scaling: n={timings[0].0} median_ns={small} n={timings[1].0} median_ns={large} samples={MEASURED_SAMPLES}")
    assert(large < small.saturating_mul(10), "native O0 sieve exceeded linear scaling: n={timings[0].0} median_ns={small} n={timings[1].0} median_ns={large} ratio={Float64(large) / Float64(small):.2}x")
}
