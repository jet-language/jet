// Rust: tests/run_entry.rs:21
#Test("loose_top_level_statements_require_explicit_run") {
    diagnostics :: compile("limit :: 2\nprint(limit)\n").expect_err("ordinary files must not invent an implicit run")
    diagnostic :: diagnostics.iter().find(diagnostic -> diagnostic.code == "E0621").expect("explicit-run diagnostic")
    assert(diagnostic.edit.is_none(), "the diagnostic must not offer an implicit-run rewrite: {diagnostic:?}")
}
// Rust: tests/run_entry.rs:36
#Test("module_globals_and_explicit_run_keep_statement_order") {
    source :: `
LIMIT :: 2
LABEL :: "start"
my_var := 3

fn run() {
    print(LABEL)
    print(LIMIT)
    my_var += LIMIT
    print(my_var)
    print(even(LIMIT + 2))
    print("end")
}
fn even(n: Int) -> Bool { return if n == 0 -> true else -> odd(n - 1) }
fn odd(n: Int) -> Bool { return if n == 0 -> false else -> even(n - 1) }
`
    expected :: "start\n2\n5\ntrue\nend\n"
    dir :: common.unique_tmp("jet_module_globals")
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("main.jet"), source).unwrap()
    // Retired execution adapters cut over to real native O1/O0 and dev routes.
    loop (tier, args) in [("O1", ["run", "main.jet"]), ("O0", ["run", "--interpret", "main.jet"]), ("dev-O1", ["dev", "--watch=off", "main.jet"]), ("dev-O0", ["dev", "--watch=off", "--interpret", "main.jet"])] {
        outcome :: Command.new(jet()).args(args).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
        assert_eq(String.from_utf8_lossy(outcome.stdout), expected, "{tier} stdout")
        assert(outcome.stderr.is_empty(), "{tier} stderr: {String.from_utf8_lossy(outcome.stderr)}")
        assert_eq(outcome.status.code(), Val(0), "{tier} exit code")
    }
    cli :: Command.new(jet()).args(["run", "main.jet"]).current_dir(dir).env("NO_COLOR", "1").output().expect("jet run should execute the explicit run entry")
    assert(cli.status.success(), "jet run rejected module globals:\n{String.from_utf8_lossy(cli.stderr)}")
    assert_eq(String.from_utf8_lossy(cli.stdout), expected, "jet run must preserve explicit-run statement order")
    assert(cli.stderr.is_empty(), "jet run emitted unexpected stderr: {String.from_utf8_lossy(cli.stderr)}")
    _ :: fs.remove_dir_all(dir)
    (code, stdout, stderr) :: common.build_and_run("jet_module_globals_aot", "main", source)
    assert_eq(code, 0, "AOT exit code: {stderr}")
    assert_eq(stdout, expected, "AOT stdout")
    assert(stderr.is_empty(), "AOT stderr: {stderr}")
}
