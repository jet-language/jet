// Rust: tests/run_entry.rs:144
#Test("unannotated_run_is_fallible_by_default_and_reports_at_the_edge") {
    source :: `
fn step() -> Int { return Err("boom") }
fn run() { value :: step(); print(value) }
`
    compile(source).expect("an unannotated run may propagate a fallible call")
    dir :: common.unique_tmp("jet_unannotated_entry_error")
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("main.jet"), source).unwrap()
    output :: Command.new(jet()).args(["run", "main.jet"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    _ :: fs.remove_dir_all(dir)
    assert_eq(output.status.code(), Val(1))
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(stderr.contains("boom"), "entry report should contain the source error: {stderr}")
    assert(stderr.contains("Error"), "entry report should contain its error frame: {stderr}")
    (code, _, aot_stderr) :: common.build_and_run("jet_unannotated_entry_error_aot", "main", source)
    assert_eq(code, 1)
    assert(aot_stderr.contains("boom") && aot_stderr.contains("Error"), "default native fallible entry did not report the error: {aot_stderr}")
}
