}
// Rust: tests/run_entry.rs:559
#Test("internal_crypto_error_uses_the_reported_entry_exit") {
    src :: `
use core.crypto as crypto
fn run() CryptoError! { _ :: crypto.hkdf_sha256(crypto.Secret.from_bytes([1]), [], [], 0) }
`
    out :: compile(src).expect("CryptoError entrypoint should compile")
    // Source-only peer comparator of the reference wrapper, not a Jet runtime bridge.
    ffi :: out.ffi.expect("core.crypto must emit its bridge")
    main :: out.rust.rfind("\nfn main()").expect("generated main")
    start :: out.rust[main..].find("jet_runtime_boundary(|| {{").map(offset -> main + offset).expect("generated crypto error boundary")
    rest :: out.rust[start..]
    end :: rest.find("\n    }});").expect("generated boundary close") + "\n    }});".len()
    invocation :: rest[..end]
    ffi_name :: ffi.crate_name
    rust :: """
mod {ffi_name} {{
    #[derive(Debug)]
    pub enum JetCryptoError {{ Internal {{ incident_id: &'static str }} }}
    impl std::fmt::Display for JetCryptoError {{
        fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {{
            match self {{ Self::Internal {{ incident_id }} => write!(f, "internal {{incident_id}}") }}
        }}
    }}
}}
fn jet_runtime_boundary<T>(f: impl FnOnce() -> T) -> T {{ f() }}
fn jet_entry_error_text<E: std::fmt::Display>(error: &E) -> String {{ error.to_string() }}
fn jet_entry_report(error: String) -> String {{ format!("{{}}\n", error) }}
fn jet_runtime_explicit_exit(code: i64) -> ! {{ std::process::exit(code as i32) }}
fn jet_entry_error_exit(error: String) -> ! {{ eprint!("{{}}", jet_entry_report(error)); jet_runtime_explicit_exit(1) }}
fn __jet_run() -> Result<(), {ffi_name}::JetCryptoError> {{
    Err({ffi_name}::JetCryptoError::Internal {{ incident_id: "test-17" }})
}}
fn main() {{
    {invocation}
}}
"""
    dir :: env.temp_dir().join("jet_crypto_internal_entry_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    source :: dir.join("main.rs")
    binary :: dir.join("main")
    fs.write(source, rust).unwrap()
    built :: Command.new("rustc").args(["--edition", "2021"]).arg(source).arg("-o").arg(binary).output().unwrap()
    assert(built.status.success(), "rustc stderr: {String.from_utf8_lossy(built.stderr)}")
    output :: Command.new(binary).output().unwrap()
    _ :: fs.remove_dir_all(dir)
    assert_eq(output.status.code(), Val(1))
    assert_eq(String.from_utf8_lossy(output.stderr), "internal test-17\n")
}
