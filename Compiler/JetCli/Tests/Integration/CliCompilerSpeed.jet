// Rust: tests/cli_compiler_speed.rs:15
fn jet() -> OSPath { OSPath.from(std.env.var_os("JET_TEST_BINARY").expect("Jet CLI test binary")) }
// Rust: tests/cli_compiler_speed.rs:19
fn path_program(name: String) -> OSPath {
    path :: std.env.var_os("PATH").unwrap_or_default()
    loop directory in std.env.split_paths(path) {
        candidate :: directory.join(name)
        if candidate.is_file() -> return candidate
    }
    panic("{name} is required for the production-path check")
}
// Rust: tests/cli_compiler_speed.rs:27
fn write_executable(path: OSPath, body: String) -> {
    std.fs.write(path, body).unwrap()
    std.fs.set_permissions(path, std.fs.Permissions.from_mode(0o755)).unwrap() // GATE #4494
}
// Rust: tests/cli_compiler_speed.rs:32
fn repository_file(path: String) -> OSPath {
    OSPath.from(std.env.var_os("JET_TEST_REPOSITORY").expect("Jet repository root")).join(path)
}
// Rust: tests/cli_compiler_speed.rs:36
fn json_field(value: DataTree, key: String) -> DataTree {
    json_get(value, key) ?? panic("missing JSON field {key}")
}
// Rust: tests/cli_compiler_speed.rs:40
fn json_text(value: DataTree, key: String) -> String {
    json_str(json_field(value, key)) ?? panic("JSON field {key} is not text")
}
// Rust: tests/cli_compiler_speed.rs:44
fn json_number(value: DataTree, key: String) -> I64 {
    json_int(json_field(value, key)) ?? panic("JSON field {key} is not numeric")
}

