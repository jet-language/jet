// Retired rustc metadata is now verified at the native action-key boundary.
fn metadata_value(scratch: Scratch) -> String {
    cache_key(std.fs.read_to_string(scratch.join("native-cache.log")).unwrap())
}
// Rust: tests/cli_compiler_speed.rs:604
fn assert_content_metadata_and_remap(left: Scratch, right: Scratch) -> {
    left_key :: metadata_value(left)
    right_key :: metadata_value(right)
    assert(left_key.len() == 64 && lowercase_digest(left_key))
    assert(right_key.len() == 64 && lowercase_digest(right_key))
    assert(left_key == right_key)
    assert(std.fs.read(left.join(".jet/build/main")).unwrap() == std.fs.read(right.join(".jet/build/main")).unwrap())
}
fn lowercase_digest(value: String) -> Bool {
    value.bytes().iter().all(byte -> byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase())
}
// Rust: tests/cli_compiler_speed.rs:621
fn has_digest_field(line: String, field: String) -> Bool {
    loop part in line.split_whitespace() {
        if part.strip_prefix(field) == .Val(value) {
            if value.len() == 64 && lowercase_digest(value) -> return true
        }
    }
    false
}
// Rust: tests/cli_compiler_speed.rs:632
fn cache_key(log: String) -> String {
    loop line in log.lines() {
        loop part in line.split_whitespace() {
            if part.strip_prefix("key=") == .Val(value) {
                if value.len() == 64 && lowercase_digest(value) -> return value.to_string()
            }
        }
    }
    panic("native cache log has a build key")
}
