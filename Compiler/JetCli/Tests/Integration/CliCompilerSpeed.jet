// Rust: tests/cli_compiler_speed.rs:569
fn invocations(log: String) -> [[String]] {
    all := [[String]]{}
    current := [String]?{None}
    loop line in log.lines() {
        if line == "BEGIN" { current = Val([String]{}) }
        else if line == "END" {
            if current == .Val(args) -> &all.push(^args)
            current = None
        } else if current == .Val(&args) -> &args.push(line.to_string())
    }
    all
}
