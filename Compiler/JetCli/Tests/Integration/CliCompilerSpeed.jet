//RS     /// #3661: an enum's auto-derived `Equatable`/`Comparable` expand the
//RS     /// Prelude provider templates, which pair every variant with every other
//RS     /// one. Each pairing condition must read the reflected variants in place:
//RS     /// copying the whole reflected enum per condition made an enum with V
//RS     /// variants cost V^3 (the self-hosted compiler's AST enums took minutes).
//RS     #[cfg(target_os = "linux")]
//RS     fn wide_enum_program(variants: usize) -> String {
//RS         let mut source = String::from("enum Wide {\n");
//RS         for variant in 0..variants {
//RS             source.push_str(&format!("    Case{variant}(first: Int, second: String)\n"));
//RS         }
//RS         source.push_str(
//RS             "}\n\nfn run() {\n    same :: Wide.Case0{first: 1, second: \"a\"} == Wide.Case1{first: 2, second: \"b\"}\n    print(same)\n}\n",
//RS         );
//RS         source
//RS     }
//RS 
//RS     /// Wall time and peak memory of one `jet check` of `program`, capped at
//RS     /// `limit`; `label` names the program's size in failure messages.
//RS     #[cfg(target_os = "linux")]
//RS     fn timed_check(
//RS         name: &str,
//RS         label: &str,
//RS         program: String,
//RS         limit: std::time::Duration,
//RS     ) -> (std::time::Duration, u64) {
//RS         let scratch = Scratch::new(name);
//RS         fs::write(scratch.join("main.jet"), program).unwrap();
