//RS     /// #3661: a three-way recursive enum sits under a chain of layered
//RS     /// structs, each holding two copies of the layer below, and every layer
//RS     /// has one use site that binds it and matches its enum. Ownership type
//RS     /// walks (sendability, clone, view, heap) that only guard their current
//RS     /// path re-walk each layer once per path: 2^layers per binding (16 layers
//RS     /// took 50 s on the debug build; the compiler's own AST is such a graph).
//RS     /// Walking each named type once per query keeps 4N use sites within 5x
//RS     /// of N, and the check's memory stays under a fixed ceiling.
//RS     #[cfg(target_os = "linux")]
//RS     fn recursive_enum_program(uses: usize) -> String {
//RS         let mut source = String::from(
//RS             "enum Tree {\n    Leaf(Int)\n    Branch(left: Tree, right: Forest)\n    Tagged(label: String, body: Node)\n}\n\n\
//RS              enum Forest {\n    Empty\n    Trees([Tree])\n    Linked(head: Tree, rest: Forest)\n}\n\n\
//RS              enum Node {\n    Plain(Int)\n    Holds(Tree?)\n    Grows(Forest)\n}\n\n\
//RS              struct Layer0 {\n    tree: Tree\n    node: Node\n}\n\n\
//RS              fn use_0(layer: Layer0) -> Int {\n    if layer.tree == {\n        .Leaf(value) -> value\n        .Branch(_, _) -> 1\n        .Tagged(_, _) -> 2\n    }\n}\n\n",
//RS         );
//RS         for layer in 1..=uses {
//RS             let below = layer - 1;
//RS             source.push_str(&format!(
//RS                 "struct Layer{layer} {{\n    left: Layer{below}\n    right: Layer{below}\n    tree: Tree\n}}\n\n\
//RS                  fn use_{layer}(layer: Layer{layer}) -> Int {{\n    inner :: layer.left\n    if layer.tree == {{\n        \
//RS                  .Leaf(value) -> value + use_{below}(inner)\n        .Branch(_, _) -> {layer}\n        \
//RS                  .Tagged(_, body) -> if body == {{\n            .Plain(value) -> value\n            .Holds(_) -> 0\n            \
//RS                  .Grows(_) -> {layer}\n        }}\n    }}\n}}\n\n"
//RS             ));
//RS         }
//RS         source.push_str(
//RS             "fn run() {\n    print(use_0(Layer0{tree: Tree.Leaf(1), node: Node.Plain(2)}))\n}\n",
//RS         );
//RS         source
//RS     }
