// Rust: tests/cli_compiler_speed.rs:1514
fn recursive_enum_program(uses: Int) -> String {
    source := "enum Tree {\n    Leaf(Int)\n    Branch(left: Tree, right: Forest)\n    Tagged(label: String, body: Node)\n}\n\nenum Forest {\n    Empty\n    Trees([Tree])\n    Linked(head: Tree, rest: Forest)\n}\n\nenum Node {\n    Plain(Int)\n    Holds(Tree?)\n    Grows(Forest)\n}\n\nstruct Layer0 {\n    tree: Tree\n    node: Node\n}\n\nfn use_0(layer: Layer0) -> Int {\n    if layer.tree == {\n        .Leaf(value) -> value\n        .Branch(_, _) -> 1\n        .Tagged(_, _) -> 2\n    }\n}\n\n"
    loop layer in 1..=uses {
        below :: layer - 1
        &source.push_str("struct Layer{layer} {{\n    left: Layer{below}\n    right: Layer{below}\n    tree: Tree\n}}\n\nfn use_{layer}(layer: Layer{layer}) -> Int {{\n    inner :: layer.left\n    if layer.tree == {{\n        .Leaf(value) -> value + use_{below}(inner)\n        .Branch(_, _) -> {layer}\n        .Tagged(_, body) -> if body == {{\n            .Plain(value) -> value\n            .Holds(_) -> 0\n            .Grows(_) -> {layer}\n        }}\n    }}\n}}\n\n")
    }
    &source.push_str("fn run() {\n    print(use_0(Layer0{tree: Tree.Leaf(1), node: Node.Plain(2)}))\n}\n")
    source
}
// Rust: tests/cli_compiler_speed.rs:1540
fn tree_peak_rss_kib(pid: U32) -> U64 {
    peak := U64{0}
    pending := [U32]{pid}
    loop !pending.is_empty() {
        current :: pending.pop().unwrap()
        if std.fs.read_to_string("/proc/{current}/status") == .Ok(status) {
            loop line in status.lines() {
                if line.strip_prefix("VmHWM:") == .Val(value) {
                    text := value.trim().trim_end_matches("kB").trim() // #4303
                    if text.parse[U64]() == .Ok(kib) -> peak = peak.max(kib)
                    break
                }
            }
        }
        tasks :: std.fs.read_dir("/proc/{current}/task") ?? next
        loop task in tasks {
            entry :: task ?? next
            if std.fs.read_to_string(entry.path().join("children")) == .Ok(children) {
                loop child in children.split_whitespace() {
                    if child.parse[U32]() == .Ok(id) -> &pending.push(id)
                }
            }
        }
    }
    peak
}
// Rust: tests/cli_compiler_speed.rs:1571
fn wide_enum_program(variants: Int) -> String {
    source := "enum Wide {\n"
    loop variant in 0..<variants -> &source.push_str("    Case{variant}(first: Int, second: String)\n")
    &source.push_str("}\n\nfn run() {\n    same :: Wide.Case0{first: 1, second: \"a\"} == Wide.Case1{first: 2, second: \"b\"}\n    print(same)\n}\n")
    source
}
// Rust: tests/cli_compiler_speed.rs:1585
fn timed_check(name: String, label: String, program: String, limit: Duration) -> (Duration, U64) {
    scratch :: Scratch.new(name)
    std.fs.write(scratch.join("main.jet"), program).unwrap()
    stderr_path :: scratch.join("check.stderr")
    started :: Instant.now()
    child := Command.new(jet()).args([String]{"check", "main.jet"}).current_dir(scratch.path).env("JET_RECEIPT_BYPASS", "1").env("JET_STORE_DIR", scratch.join("store")).env("NO_COLOR", "1").stdout(Stdio.null()).stderr(std.fs.File.create(stderr_path).unwrap()).spawn().unwrap()
    peak := U64{0}
    status :: loop {
        peak = peak.max(tree_peak_rss_kib(child.id()))
        if child.try_wait().unwrap() == .Val(status) -> break status
        if started.elapsed() > limit {
            _ :: child.kill()
            _ :: child.wait()
            panic("`jet check` with {label} ran past {limit:?}: checking is super-linear again")
        }
        std.thread.sleep(Duration.from_millis(10)) // GATE #4494
    }
    elapsed :: started.elapsed()
    stderr :: std.fs.read_to_string(stderr_path).unwrap_or_default()
    assert(status.success(), "`jet check` rejected the program with {label}:\n{stderr}")
    (elapsed, peak)
}
// Rust: tests/cli_compiler_speed.rs:1682
fn check_output(dir: OSPath, target: String, threads: String, store: OSPath) -> ([U8], [U8]) {
    output :: Command.new(jet()).args([String]{"check", target}).current_dir(dir).env("JET_CHECK_THREADS", threads).env("JET_RECEIPT_BYPASS", "1").env("JET_STORE_DIR", store).env("NO_COLOR", "1").output().unwrap()
    (output.stdout, output.stderr)
}
