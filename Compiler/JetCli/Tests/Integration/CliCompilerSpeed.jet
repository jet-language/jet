    libc_hash :: "1111111111111111111111111111111111111111111111111111111111111111"
    allocator_hash :: "2222222222222222222222222222222222222222222222222222222222222222"
    allocator_environment_hash :: "3333333333333333333333333333333333333333333333333333333333333333"
    hardware_hash :: "4444444444444444444444444444444444444444444444444444444444444444"
    topology_hash :: "5555555555555555555555555555555555555555555555555555555555555555"
    toolchain_hash :: "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
    rustc_hash :: "6666666666666666666666666666666666666666666666666666666666666666"
    output_hash :: "7777777777777777777777777777777777777777777777777777777777777777"
    error_hash :: "8888888888888888888888888888888888888888888888888888888888888888888"
    linker_hash :: "9999999999999999999999999999999999999999999999999999999999999999"
    compiler_hash :: "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    rustc_vv_hash :: "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
    jet_env_hash :: "abababababababababababababababababababababababababababababababab"
    peer_contract :: "6f9085bde94607c64f688587c06e6fc2f3e02fba10104c960c7488dba341c183"
    runs := String.new()
    peers := String.new()
    loop state in states {
        fast :: state.starts_with("jit-")
        stage :: if fast -> "jit-fast" else -> "aot-release"
        profile :: if fast -> "fast" else -> "release"
        backend :: if fast -> "cranelift" else -> "rustc-llvm"
        linker :: if fast -> "none" else -> "ld"
        linker_identity :: if fast -> "none" else -> linker_hash
        cache_state :: if state.ends_with("no-change") -> "NoChange" else -> if state.ends_with("representative-edit") -> "Edit" else -> "Clean"
        cache_policy :: if state.ends_with("no-change") -> "shared-cache-after-warmup" else -> if state.ends_with("representative-edit") -> "base-cache-snapshot-before-edit" else -> "fresh-cache-per-sample"
        phase :: "parse_us=1;sema_us=1;source=fixture.jet;source_sha256={source_hash};source_bytes=1;expected_sha256={expected_hash};expected_bytes=1;manifest_sha256={manifest_hash};workload_sha256={workload_hash};role=base;profile={profile};backend={backend};linker={linker};linker_path={linker};linker_sha256={linker_identity};linker_backend={linker};linker_backend_path={linker};linker_backend_sha256={linker_identity};cache_state={cache_state};cache_policy={cache_policy};cache_hits=1;cache_misses=0;libc_sha256={libc_hash};allocator_sha256={allocator_hash};allocator_environment_sha256={allocator_environment_hash};hardware_sha256={hardware_hash};topology_sha256={topology_hash};toolchain_sha256={toolchain_hash};rustc_sha256={rustc_hash};top_cause=none;artifact_bytes=0;parity=verified;semantic_parity=verified;diagnostic_parity=verified;effect_parity=verified;tier_parity=verified;dev_profile=dev;aot_profile=release"
        if !runs.is_empty() -> &runs.push(',')
        &runs.push_str("{{\"program\":\"fixture.jet\",\"state\":\"{state}\",\"stage\":\"{stage}\",\"latency_ns\":100,\"memory_bytes\":100,\"variance_pct\":0,\"stdout_sha256\":\"{output_hash}\",\"stderr_sha256\":\"{error_hash}\",\"phase_totals\":\"{phase}\"}}")
        loop (peer, language, value) in [(String, String, Int)]{("rustc", "rust", 100), ("cxx", "cxx", 101)} {
            loop metric in [String]{"latency_ns", "memory_bytes"} {
                if !peers.is_empty() -> &peers.push(',')
                &peers.push_str("{{\"peer\":\"{peer}\",\"language\":\"{language}\",\"program\":\"fixture.jet\",\"state\":\"{state}\",\"metric\":\"{metric}\",\"value\":{value},\"workload_sha256\":\"{workload_hash}\",\"source_sha256\":\"{source_hash}\",\"expected_sha256\":\"{expected_hash}\",\"manifest_sha256\":\"{manifest_hash}\",\"toolchain_sha256\":\"{toolchain_hash}\"}}")
            }
        }
    }
    corpus_hash :: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    "{{\"schema\":\"jet.compiler-speed\",\"version\":4,\"corpus_sha256\":\"{corpus_hash}\",\"manifest_sha256\":\"{manifest_hash}\",\"stage\":\"matrix\",\"peer_version\":1,\"peer_contract_sha256\":\"{peer_contract}\",\"peer_run_id\":\"fixture-run\",\"peer_keys\":\"rustc:rust,cxx:cxx\",\"peer_metrics\":\"latency_ns,memory_bytes\",\"peer_count\":2,\"peer_rows\":24,\"parity\":{{\"status\":\"verified\",\"cases\":1,\"semantic\":\"verified\",\"diagnostics\":\"verified\",\"effects\":\"verified\",\"tiers\":\"verified\"}},\"machine\":{{\"allocator_source_sha256\":\"{allocator_hash}\",\"allocator_environment_sha256\":\"{allocator_environment_hash}\",\"arch\":\"x86_64\",\"compiler_sha256\":\"{compiler_hash}\",\"cpus\":2,\"governor\":\"governor\",\"hardware_sha256\":\"{hardware_hash}\",\"hostname\":\"fixture\",\"kernel\":\"kernel\",\"libc_sha256\":\"{libc_hash}\",\"load1_start_milli\":100,\"load1_peak_milli\":200,\"load1_end_milli\":150,\"memory_bytes\":1024,\"os\":\"Linux\",\"rustc\":\"rustc\",\"rustc_vv_sha256\":\"{rustc_vv_hash}\",\"target\":\"target\",\"toolchain_sha256\":\"{toolchain_hash}\",\"topology_sha256\":\"{topology_hash}\",\"jet_env_sha256\":\"{jet_env_hash}\",\"llvm\":\"llvm\",\"rustc_sha256\":\"{rustc_hash}\"}},\"budgets\":{{\"latency_regression_pct\":15,\"memory_regression_pct\":15,\"samples\":20,\"variance_pct\":100,\"warmups\":1}},\"outliers_discarded\":0,\"runs\":[{runs}],\"peers\":[{peers}]}}\n"
}

// Rust: tests/cli_compiler_speed.rs:153
fn checker_report_from_baseline(baseline: String) -> String {
    root :: parse(baseline).expect("generated compiler-speed baseline JSON")
    machine :: json_field(root, "machine")
    budgets :: json_field(root, "budgets")
    parity :: json_field(root, "parity")
    runs :: json_field(root, "runs").as_array().expect("compiler-speed baseline runs array")
    assert(runs.len() % 6 == 0)
    machine_id :: "{json_text(machine, "os")}/{json_text(machine, "arch")}/cpus={json_number(machine, "cpus")}/host={json_text(machine, "hostname") }"
    peer_contract :: json_text(root, "peer_contract_sha256")
    peer_run_id :: json_text(root, "peer_run_id")
    peer_keys :: json_text(root, "peer_keys")
    peer_metrics :: json_text(root, "peer_metrics")
    peer_count :: json_number(root, "peer_count")
    peer_rows :: json_number(root, "peer_rows")
    report := "compiler-speed version={json_number(root, "version")} corpus={runs.len() / 6} corpus_sha256={json_text(root, "corpus_sha256")} manifest_sha256={json_text(root, "manifest_sha256")} stage=matrix machine={machine_id} target={json_text(machine, "target")} rustc={json_text(machine, "rustc")} llvm={json_text(machine, "llvm")} rustc_vv_sha256={json_text(machine, "rustc_vv_sha256")} rustc_sha256={json_text(machine, "rustc_sha256")} compiler_sha256={json_text(machine, "compiler_sha256")} jet_env_sha256={json_text(machine, "jet_env_sha256")} libc_sha256={json_text(machine, "libc_sha256")} allocator_sha256={json_text(machine, "allocator_source_sha256")} allocator_environment_sha256={json_text(machine, "allocator_environment_sha256")} hardware_sha256={json_text(machine, "hardware_sha256")} topology_sha256={json_text(machine, "topology_sha256")} toolchain_sha256={json_text(machine, "toolchain_sha256")} kernel={json_text(machine, "kernel")} governor={json_text(machine, "governor")} load1_start_milli={json_number(machine, "load1_start_milli")} load1_peak_milli={json_number(machine, "load1_peak_milli")} load1_end_milli={json_number(machine, "load1_end_milli")} memory_bytes={json_number(machine, "memory_bytes")} profiles=jit-fast,aot-release backends=cranelift,rustc-llvm warmups={json_number(budgets, "warmups")} samples={json_number(budgets, "samples")} outliers_discarded={json_number(root, "outliers_discarded")} parity={json_text(parity, "status")} parity_cases={json_number(parity, "cases")} peer_contract_sha256={peer_contract} peer_run_id={peer_run_id} peer_machine={machine_id} peer_target={json_text(machine, "target")} peer_keys={peer_keys} peer_metrics={peer_metrics} peer_count={peer_count} peer_rows={peer_rows}\n"
    &report.push_str("program\tstate\tstage\tlatency_ns\tmemory_bytes\tvariance_pct\toutput_sha256:stderr_sha256\tphases\n")
    loop run in runs {
        &report.push_str("{json_text(run, "program")}\t{json_text(run, "state")}\t{json_text(run, "stage")}\t{json_number(run, "latency_ns")}\t{json_number(run, "memory_bytes")}\t{json_number(run, "variance_pct")}\t{json_text(run, "stdout_sha256")}:{json_text(run, "stderr_sha256")}\tphases={json_text(run, "phase_totals")}\n")
    }
    &report.push_str("compiler-speed-peer version=1 run_id={peer_run_id} corpus_sha256={json_text(root, "corpus_sha256")} manifest_sha256={json_text(root, "manifest_sha256")} target={json_text(machine, "target")} machine={machine_id} peers={peer_keys} metrics={peer_metrics} contract_sha256={peer_contract} peer_count={peer_count} rows={peer_rows}\n")
    &report.push_str("peer\tlanguage\tprogram\tstate\tmetric\tvalue\tworkload_sha256\tsource_sha256\texpected_sha256\tmanifest_sha256\ttoolchain_sha256\n")
    loop run in runs {
        loop (peer, language, value) in [(String, String, Int)]{("rustc", "rust", 100), ("cxx", "cxx", 101)} {
            loop metric in [String]{"latency_ns", "memory_bytes"} {
                &report.push_str("{peer}\t{language}\t{json_text(run, "program")}\t{json_text(run, "state")}\t{metric}\t{value}\tffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tdddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\n")
            }
        }
    }
    report
}

// Rust: tests/cli_compiler_speed.rs:262
fn run_checker_fixture(name: String, baseline: String, report: String) -> Output {
    scratch :: Scratch.new(name)
    fixture_perf :: scratch.join("Tools/perf")
    std.fs.create_dir_all(fixture_perf).unwrap()
    checker :: fixture_perf.join("ci-perf-check.sh")
    std.fs.copy(repository_file("Tools/perf/ci-perf-check.sh"), checker).unwrap()
    std.fs.set_permissions(checker, std.fs.Permissions.from_mode(0o755)).unwrap()
    std.fs.write(fixture_perf.join("baseline.json"), baseline).unwrap()
    report_path :: scratch.join("current.report")
    std.fs.write(report_path, report).unwrap()
    write_executable(fixture_perf.join("dashboard.sh"), "#!/bin/sh\ncat \"$JET_TEST_CURRENT_REPORT\"\n")
    scratch_root := std.env.var_os("JET_PERF_SCRATCH_ROOT").map(path -> OSPath.from(path))
    if scratch_root == None -> scratch_root = std.env.var_os("HOME").map(home -> OSPath.from(home).join(".cache/jet-perf"))
    root :: scratch_root.expect("disk-backed compiler-speed scratch root").join("rust-checker-fixtures")
    Command.new(checker).current_dir(scratch.path).env("JET_CI_CANDIDATE_COMMIT", "0123456789abcdef0123456789abcdef01234567").env("JET_TEST_CURRENT_REPORT", report_path).env("JET_PERF_SCRATCH_ROOT", root).output().unwrap()
}
