// Rust: tests/jet_perf_trace_views.rs:18
fn jet() -> OSPath { OSPath.from(env.test_binary("jet")) }
// Rust: tests/jet_perf_trace_views.rs:22
fn run_jet(cwd: OSPath, args: [String]) -> process.Output {
    process.Command.new(jet()).current_dir(cwd).args(args).output().unwrap_or_else(|e| -> panic("jet {args:?} failed to launch: {e}"))
}
// Rust: tests/jet_perf_trace_views.rs:30
fn temp_workspace() -> OSPath {
    root :: unique_tmp("jet-perf")
    fs.create_dir_all(root) ?? panic("create workspace")
    root
}
