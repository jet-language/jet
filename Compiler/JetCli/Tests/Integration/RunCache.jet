//RS         let (warm_code, warm_out, warm_err) = run_jet(&row_cache, &file, Some(project), &[]);
//RS 
//RS         assert_eq!(
//RS             cold_code, warm_code,
//RS             "{stem}: exit code changed on the second run\ncold stderr: {cold_err}\nwarm stderr: {warm_err}"
