//RS     let entry = repo.join("Examples/features/streams/generators.jet");
//RS     // Precondition, not inheritance. Ask the product where its entry-scoped
//RS     // cache root is and prove the explicit redirect is in force.
//RS     std::env::set_var("JET_RUN_CACHE_DIR", &cache);
//RS     assert_eq!(
//RS         jet::RunCache::cache_root_for_entry(&entry),
//RS         Some(cache.clone()),
//RS         "JET_RUN_CACHE_DIR must redirect the run-cache root away from the machine's"
//RS     );
//RS     std::env::remove_var("JET_RUN_CACHE_DIR");
