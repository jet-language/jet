// Rust: tests/run_cache.rs:12
pub fn lock_run_cache_tests() -> MutexGuard[Unit] {
    static LOCK :: Mutex[Unit].new(())
    LOCK.lock().unwrap_or_else(e -> e.into_inner())
}

// Rust: tests/run_cache.rs:17
pub fn jet_bin() -> String {
    env.var("CARGO_BIN_EXE_jet").unwrap_or_else(_ -> {
        p := env.current_exe().expect("exe")
        _ :: p.pop()
        p.push("jet")
        p.display().to_string()
    })
}

// Rust: tests/run_cache.rs:29
pub fn budget_jet_bin() -> String? {
    if p :: env.var("JET_BUDGET_BIN").ok() {
        if OSPath.from(p).is_file() { return Some(p) }
    }
    release :: OSPath.from(env.manifest_dir()).join("target/release/jet")
    if release.is_file() { return Some(release.display().to_string()) }
    None
}

// Rust: tests/run_cache.rs:42
pub fn fixture_dir() -> OSPath { OSPath.from(env.manifest_dir()).join("tests/fixtures/script_speed") }

// Rust: tests/run_cache.rs:46
pub fn run_jet(cache: OSPath, file: OSPath, cwd: OSPath?, extra_env: [(String, String)]) -> (Int, String, String) {
    run_jet_with_args(cache, file, cwd, extra_env, [])
}

// Rust: tests/run_cache.rs:55
pub fn run_jet_with_args(cache: OSPath, file: OSPath, cwd: OSPath?, extra_env: [(String, String)], args: [String]) -> (Int, String, String) {
    cmd := Command.new(jet_bin())
    cmd.arg("run").arg(file).args(args).env("JET_RUN_CACHE_DIR", cache)
    if dir :: cwd { cmd.current_dir(dir) }
    for (k, v) in extra_env { cmd.env(k, v) }
    out :: cmd.output().expect("jet run")
    (out.status.code() ?? 1, String.from_utf8_lossy(out.stdout).to_string(), String.from_utf8_lossy(out.stderr).to_string())
}

// Rust: tests/run_cache.rs:79
pub fn run_jet_status_bin(bin: String, cache: OSPath, file: OSPath, cwd: OSPath?) -> Bool {
    cmd := Command.new(bin)
    cmd.arg("run").arg(file).env("JET_RUN_CACHE_DIR", cache).stdout(Stdio.null()).stderr(Stdio.null())
    if dir :: cwd { cmd.current_dir(dir) }
    cmd.status().map(s -> s.success()).unwrap_or(false)
}

// Rust: tests/run_cache.rs:92
pub fn median_u(samples: &[U128]) -> U128 {
    samples.sort()
    samples[samples.len() / 2]
}

// Rust: tests/run_cache.rs:97
pub fn p90_u(samples: &[U128]) -> U128 {
    samples.sort()
    i :: Int.from((Float.from(samples.len()) * 0.9).ceil())
    samples[i.saturating_sub(1).min(samples.len() - 1)]
}

// Rust: tests/run_cache.rs:103
pub fn us_as_ms(us: U128) -> Float { Float.from(us) / 1000.0 }

// Rust: tests/run_cache.rs:107
pub fn unique() -> U64 {
    static N :: AtomicU64.new(0)
    U64.from(process.id()) * 1000 + N.fetch_add(1, Ordering.Relaxed)
}

// Rust: tests/run_cache.rs:113
pub fn peer_us(argv: [String], cwd: OSPath?) -> U128? {
    samples := []
    for i in 0..8 {
        t0 :: Instant.now()
        cmd := Command.new(argv[0])
        cmd.args(argv[1..]).stdout(Stdio.null()).stderr(Stdio.null())
        if dir :: cwd { cmd.current_dir(dir) }
        ok :: cmd.status().map(s -> s.success()).unwrap_or(false)
        if !ok { return None }
        if i > 0 { samples.push(t0.elapsed().as_micros()) }
    }
    Some(median_u(&samples))
}

// Rust: tests/run_cache.rs:136
pub fn machine_meta() -> String {
    cpus :: thread.available_parallelism().ok().map(n -> n.get())
    host :: env.var("HOSTNAME").or_else(_ -> env.var("HOST")).unwrap_or_else(_ -> "unknown")
    "os={selected_os()} arch={selected_arch()} cpus={cpus:?} host={host}"
}

// Rust: tests/run_cache.rs:553
pub struct RestoreCacheEnv { value: OsString? }
// Rust: tests/run_cache.rs:555
impl Drop for RestoreCacheEnv {
    fn drop(&self) -> {
        if value :: self.value { env.set_var("JET_RUN_CACHE_DIR", value) }
        else { env.remove_var("JET_RUN_CACHE_DIR") }
    }
}

