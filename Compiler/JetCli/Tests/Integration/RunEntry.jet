// Rust: tests/run_entry.rs:1
// All original run_entry tests live in the paired RunEntryTests.jet.
use tests.common
use std.[fs, env, process, time]
use std.process.Command

// Rust: tests/run_interpret.rs:8
// GATE #4494: test runner resolves the built native Jet binary.
pub fn jet() -> OSPath { OSPath.from(env.test_binary("jet")) }
// Rust: tests/run_interpret.rs:385
pub fn median_nanos(samples: &[U128]) -> U128 {
    samples.sort_unstable()
    samples[samples.len() / 2]
}
// Rust: tests/run_interpret.rs:492
pub fn assert_example_tier_parity(tag: String, example: String, golden: String) -> {
    // GATE #4494: native commands, physical fixture reads and independent caches.
    root :: OSPath.from(env.manifest_dir())
    expected :: fs.read_to_string(root.join(golden)).expect("example golden output")
    cache :: env.temp_dir().join("jet_tier_parity_{tag}_{process.id()}")
    _ :: fs.remove_dir_all(cache)
    run :: fn(mode: String, trace: Bool) {
        command := Command.new(jet())
        command.arg("run")
        if trace -> command.arg("--trace-tiers")
        if mode == { "release" -> command.arg("--release"); "interpret" -> command.arg("--interpret"); _ -> {} }
        command.arg(example).current_dir(root).env("JET_RUN_CACHE_DIR", cache.join(mode).join("run")).env("JET_STORE_DIR", cache.join(mode).join("build")).env("NO_COLOR", "1").output().expect("jet run")
    }
    loop mode in ["release", "default", "interpret"] {
        output :: run(mode, false)
        stdout :: String.from_utf8_lossy(output.stdout).to_string()
        stderr :: String.from_utf8_lossy(output.stderr).to_string()
        assert_eq(output.status.code(), Val(0), "{tag}: `{mode}` exited nonzero:\n{stderr}")
        assert_eq(stderr, "", "{tag}: `{mode}` wrote to stderr")
        assert_eq(stdout, expected, "{tag}: `{mode}` stdout diverged from the golden")
    }
    forced :: run("interpret", true)
    forced_trace :: String.from_utf8_lossy(forced.stderr).to_string()
    assert(forced_trace.lines().any(line -> line.starts_with("run") && line.contains("O0")), "{tag}: forced `--interpret` did not run `run` on native O0:\n{forced_trace}")
    assert(!forced_trace.contains("O1"), "{tag}: forced `--interpret` reached optimized native O1:\n{forced_trace}")
    default :: run("default", true)
    default_trace :: String.from_utf8_lossy(default.stderr).to_string()
    assert(default_trace.lines().any(line -> line.starts_with("run") && (line.contains("O1") || line.contains("O0"))), "{tag}: default `jet run` reported no native tier for `run`:\n{default_trace}")
    _ :: fs.remove_dir_all(cache)
}
