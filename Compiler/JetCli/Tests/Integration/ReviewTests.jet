    root :: scratch("diagnostics-moved")
    _ :: fs.remove_dir_all(root)
    base :: project(&root, "base", "", "fn run() {{ missing() }}\n")
    head :: project(&root, "head", "", "fn run() {{\n    print(\"x\")\n    missing()\n}}\n")
    output :: diagnostic_review_command(&base, &head)
    assert(output.status.success(), "moved diagnostic review failed")
    stdout :: String.from_utf8(output.stdout).expect("UTF-8 review output")
    assert(stdout.contains("\"status\":\"unknown\""))
    assert(stdout.contains("different location"))
    assert(!stdout.contains("\"status\":\"resolved\""))
    assert(!stdout.contains("\"status\":\"new\""))
    _ :: fs.remove_dir_all(root)
}

