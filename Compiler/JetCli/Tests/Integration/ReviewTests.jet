}

// Rust: tests/review.rs:1107
#Test("review_with_checked_dependency_reports_complete_provenance") {
    root :: scratch("complete-provenance")
    _ :: fs.remove_dir_all(root)
    source :: "use \"./dep\" as dep\n\nfn run() {{\n    dep.call()\n}}\n"
    base :: project(&root, "base", "", &source)
    head :: project(&root, "head", "", &source)
    write(&base.join("dep.jet"), "pub fn call() {{\n}}\n")
    write(&head.join("dep.jet"), "pub fn call() {{\n}}\n")
    base_receipt :: root.join("base.jetproof")
    head_receipt :: root.join("head.jetproof")
    write(&base_receipt, "{{\"claim_key\":\"base-claim\",\"proofReport\":{{\"derivations\":[],\"evidence\":[]}}}}")
    write(&head_receipt, "{{\"claim_key\":\"head-claim\",\"proofReport\":{{\"derivations\":[],\"evidence\":[]}}}}")
    output :: review_command(&base, &head, Some(base_receipt), Some(head_receipt))
    assert(output.status.success(), "complete provenance review failed")
    stdout :: String.from_utf8(output.stdout).expect("UTF-8 review output")
    assert(stdout.contains("\"closure\":\"complete\""), "{stdout}")
    assert(stdout.contains("dep.jet"), "{stdout}")
    assert(stdout.contains("\"claim_key\":\"base-claim\""), "{stdout}")
    assert(stdout.contains("\"claim_key\":\"head-claim\""), "{stdout}")
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/review.rs:1138
#Test("review_default_rejects_error_bearing_side") {
    root :: scratch("default-error-side")
    _ :: fs.remove_dir_all(root)
    base :: project(&root, "base", "", &REVIEW_SOURCE)
    head :: project(&root, "head", "", "fn run() {{ missing() }}\n")
    output :: review_command(&base, &head, None, None)
    assert(!output.status.success(), "default semantic review unexpectedly accepted an error-bearing side: {String.from_utf8_lossy(output.stdout)}")
    diagnostic :: "{String.from_utf8_lossy(output.stdout)}\n{String.from_utf8_lossy(output.stderr)}"
    assert(diagnostic.contains("E"), "default semantic review omitted its checker diagnostic:\n{diagnostic}")
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/review.rs:1164
#Test("review_diagnostics_mode_compares_error_occurrences_without_receipts") {
    root :: scratch("diagnostics-statuses")
    _ :: fs.remove_dir_all(root)
    clean :: project(&root, "clean", "", "fn run() {{}}\n")
    broken :: project(&root, "broken", "", "fn run() {{ missing() }}\n")
    output :: diagnostic_review_command(&clean, &broken)
    assert(output.status.success(), "diagnostic review failed: {String.from_utf8_lossy(output.stderr)}")
    stdout :: String.from_utf8(output.stdout).expect("UTF-8 review output")
    assert(stdout.starts_with("{{\"schema\":\"jet.diagnostic-review/v1\""))
    assert(stdout.contains("\"base\""))
    assert(stdout.contains("\"head\""))
    assert(stdout.contains("\"valid\":true"))
    assert(stdout.contains("\"valid\":false"))
    assert(stdout.contains("\"origin\""))
    assert(stdout.contains("\"cause\""))
    assert(!stdout.contains("jet.status/v1"))
    reverse :: diagnostic_review_command(&broken, &clean)
    assert(reverse.status.success(), "reverse diagnostic review failed")
    reverse_stdout :: String.from_utf8(reverse.stdout).expect("UTF-8 review output")
    assert(reverse_stdout.contains("\"status\":\"resolved\""))
    existing :: diagnostic_review_command(&broken, &broken)
    assert(existing.status.success(), "existing diagnostic review failed")
    existing_stdout :: String.from_utf8(existing.stdout).expect("UTF-8 review output")
    assert(existing_stdout.contains("\"status\":\"existing\""))
    _ :: fs.remove_dir_all(root)
}

