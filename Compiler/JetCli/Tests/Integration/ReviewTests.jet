use Compiler.JetCli.Tests.Integration.Review.*
use std.[fs, env]
use std.process.Command
use jet.SHA256.sha256_hex
use jet_foundation.MachineOutput.[read_machine_output, MachineRecord]
// GATE #4494: all journeys execute the real native Jet CLI and filesystem.

// Rust: tests/review.rs:179
#Test("review_joins_meaning_authority_and_receipt_changes") {
    root :: scratch("joins")
    _ :: fs.remove_dir_all(root)
    base :: root.join("base")
    head :: root.join("head")
    manifest :: (allow: String) -> "name: \"review_fixture\"\nversion: \"0.1.0\"\nedition: \"2026\"\nauthority: {{ holds: {{ allow: [{allow}] }} }}\n"
    write(&base.join("package.jet"), &manifest("FS, IO"))
    write(&head.join("package.jet"), &manifest("FS, IO, Net"))
    write(&base.join("run.jet"), "fn run() {{ print(\"base\") }}\n")
    write(&head.join("run.jet"), "fn run() {{ print(\"head\") }}\n")
    base_receipt :: root.join("base.jetproof")
    head_receipt :: root.join("head.jetproof")
    base_receipt_value :: proof_receipt([
        checked_derivation("d-retained", "build-1", "run-1", "target-1", "event-retained"),
        checked_derivation("d-lost", "build-1", "run-1", "target-1", "event-lost")
    ], [
        proof_evidence("claim-retained", "d-retained", "passed", "checked", "target-1", 1, "schedule:v1"),
        proof_evidence("claim-lost", "d-lost", "passed", "checked", "target-1", 1, "schedule:v1")
    ])
    head_receipt_value :: proof_receipt([
        checked_derivation("d-retained", "build-1", "run-1", "target-1", "event-retained"),
        checked_derivation("d-gained", "build-1", "run-1", "target-1", "event-gained")
    ], [
        proof_evidence("claim-retained", "d-retained", "passed", "checked", "target-1", 1, "schedule:v1"),
        proof_evidence("claim-gained", "d-gained", "passed", "checked", "target-1", 1, "schedule:v1")
    ])
    write(&base_receipt, &base_receipt_value)
    write(&head_receipt, &head_receipt_value)
    output :: Command.new(env.var_os("CARGO_BIN_EXE_jet").expect("native Jet test executable"))
        .args(["review", base.join("run.jet").to_str().expect("UTF-8 base"), head.join("run.jet").to_str().expect("UTF-8 head"), "--base-receipt", base_receipt.to_str().expect("UTF-8 receipt"), "--receipt", head_receipt.to_str().expect("UTF-8 receipt"), "--json"])
        .env("NO_COLOR", "1").output().expect("run review")
    assert(output.status.success(), "review failed: {String.from_utf8_lossy(output.stderr)}")
    stdout :: String.from_utf8(output.stdout).expect("UTF-8 review output")
    assert_eq(read_machine_output(&stdout).expect("machine output"), [MachineRecord.Status])
    assert(stdout.starts_with("{{\"schema\":\"jet.status/v1\""))
    assert(stdout.contains("\"kind\":\"review\""))
    assert(stdout.contains("body_changed"))
    assert(stdout.contains("\"status\":\"widened\""))
    assert(stdout.contains("\"status\":\"lost\""))
    assert(stdout.contains("\"status\":\"gained\""))
    assert(!stdout.contains("text_diff"))
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/review.rs:293
#Test("comment_only_change_has_no_semantic_operation") {
    root :: scratch("comments")
    _ :: fs.remove_dir_all(root)
    before :: root.join("before.jet")
    after :: root.join("after.jet")
    write(&before, "fn run() {{ print(\"same\") }}\n")
    write(&after, "// review comment\nfn run() {{ print(\"same\") }}\n")
    output :: Command.new(env.var_os("CARGO_BIN_EXE_jet").expect("native Jet test executable")).args(["review", before.to_str().expect("UTF-8 before"), after.to_str().expect("UTF-8 after"), "--json"]).env("NO_COLOR", "1").output().expect("run review")
    assert(output.status.success(), "review failed: {String.from_utf8_lossy(output.stderr)}")
    stdout :: String.from_utf8(output.stdout).expect("UTF-8 review output")
    assert(stdout.contains("\"semantic_ops\":[]"))
    assert(stdout.contains("\"changes\":[]"))
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/review.rs:324
#Test("review_uses_a_recorded_rename_and_ignores_hand_spelling") {
    root :: scratch("recorded_rename")
    _ :: fs.remove_dir_all(root)
    base :: root.join("base")
    head :: root.join("head")
    package :: "name: \"review_rename\"\nversion: \"0.1.0\"\nedition: \"2026\"\n"
    write(&base.join("package.jet"), &package)
    write(&head.join("package.jet"), &package)
    before :: "fn report() -> Int {{\n    return 1\n}}\n"
    after :: "fn summarize() -> Int {{\n    return 1\n}}\n"
    write(&base.join("run.jet"), &before)
    write(&head.join("run.jet"), &after)
    before_hash :: sha256_hex(before.as_bytes())
    after_hash :: sha256_hex(after.as_bytes())
    receipt_dir :: head.join(".jet/codemods")
    fs.create_dir_all(receipt_dir).expect("create codemod receipts")
    write(&receipt_dir.join("rename.log.json"), "{{\"schema\":2,\"semantic_ops\":[{{\"kind\":\"rename\",\"from\":\"report\",\"to\":\"summarize\"}}],\"files\":[{{\"path\":\"{head.join("run.jet").display()}\",\"before_hash\":\"{before_hash}\",\"after_hash\":\"{after_hash}\"}}]}}")
    output :: review_command(&base, &head, None, None)
    assert(output.status.success(), "review failed: {output:?}")
    stdout :: String.from_utf8(output.stdout).expect("UTF-8 review output")
    assert(stdout.contains("\"kind\":\"renamed\""), "{stdout}")
    hand :: root.join("hand")
    write(&hand.join("package.jet"), &package)
    write(&hand.join("run.jet"), &after)
    hand_output :: review_command(&base, &hand, None, None)
    assert(hand_output.status.success(), "review failed: {hand_output:?}")
    hand_stdout :: String.from_utf8(hand_output.stdout).expect("UTF-8 review output")
    assert(!hand_stdout.contains("\"kind\":\"renamed\""), "{hand_stdout}")
    assert(hand_stdout.contains("\"kind\":\"removed\""), "{hand_stdout}")
    assert(hand_stdout.contains("\"kind\":\"added\""), "{hand_stdout}")
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/review.rs:392
#Test("review_uses_a_recorded_move_across_module_paths") {
    root :: scratch("recorded_move")
    _ :: fs.remove_dir_all(root)
    base :: root.join("base")
    head :: root.join("head")
    package :: "name: \"review_move\"\nversion: \"0.1.0\"\nedition: \"2026\"\n"
    write(&base.join("package.jet"), &package)
    write(&head.join("package.jet"), &package)
    source :: "fn report() -> Int {{\n    return 1\n}}\n"
    write(&base.join("old.jet"), &source)
    write(&head.join("new.jet"), &source)
    source_hash :: sha256_hex(source.as_bytes())
    receipt_dir :: head.join(".jet/codemods")
    fs.create_dir_all(receipt_dir).expect("create codemod receipts")
    write(&receipt_dir.join("move.log.json"), "{{\"schema\":2,\"semantic_ops\":[{{\"kind\":\"move\",\"from\":\"report\",\"to\":\"report\",\"targets\":[{{\"stable_id\":\"\",\"before\":\"fn:module:old::report\",\"after\":\"fn:module:new::report\",\"kind\":\"function\",\"module_path\":\"\"}}]}}],\"files\":[{{\"path\":\"{head.join("new.jet").display()}\",\"before_hash\":\"{source_hash}\",\"after_hash\":\"{source_hash}\"}}]}}")
    output :: Command.new(env.var_os("CARGO_BIN_EXE_jet").expect("native Jet test executable")).args(["review", base.join("old.jet").to_str().expect("UTF-8 base"), head.join("new.jet").to_str().expect("UTF-8 head"), "--json"]).env("NO_COLOR", "1").output().expect("run review")
    assert(output.status.success(), "review failed: {output:?}")
    stdout :: String.from_utf8(output.stdout).expect("UTF-8 review output")
    assert(stdout.contains("\"kind\":\"moved\""), "{stdout}")
    assert(stdout.contains("\"alignment\":\"recorded\""), "{stdout}")
    assert(stdout.contains("\"before\":\"old.jet\""), "{stdout}")
    assert(stdout.contains("\"after\":\"new.jet\""), "{stdout}")
    assert(stdout.contains("\"before_identity\":\"fn:module:old::report\""), "{stdout}")
    assert(stdout.contains("\"after_identity\":\"fn:module:new::report\""), "{stdout}")
    assert(stdout.contains("\"source_operation\":\"move\""), "{stdout}")
    assert(!stdout.contains("\"kind\":\"renamed\""), "{stdout}")
    assert(!stdout.contains("\"kind\":\"added\""), "{stdout}")
    assert(!stdout.contains("\"kind\":\"removed\""), "{stdout}")
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/review.rs:445
#Test("review_receipt_fixture_matrix_distinguishes_matching_stale_missing_mismatched_and_changed") {
    base_derivation :: checked_derivation("d-shared", "build-1", "run-1", "target-1", "event-1")
    matching_evidence :: proof_evidence("claim-shared", "d-shared", "passed", "checked", "target-1", 1, "schedule:v1")
    matching :: proof_receipt([base_derivation], [matching_evidence])
    run_receipt_case("matrix-matching", Some(matching), Some(matching), "", "", ["\"base_recorded\":true", "\"head_recorded\":true", "\"retained\":1", "\"preserved_checked\"", "\"verdict\":\"reviewable\""])
    stale_derivation :: checked_derivation("d-shared", "build-2", "run-1", "target-1", "event-1")
    stale :: proof_receipt([stale_derivation], [matching_evidence])
    run_receipt_case("matrix-stale", Some(matching), Some(stale), "", "", ["\"unknown\"", "build identity differs", "\"verdict\":\"reviewable\""])
    run_receipt_case("matrix-missing", None, None, "", "", ["\"base_recorded\":false", "\"head_recorded\":false", "\"gained\":0", "\"lost\":0", "\"verdict\":\"reviewable\""])
    mismatched_evidence :: proof_evidence("claim-shared", "d-shared", "passed", "checked", "target-1", 2, "schedule:v1")
    mismatched :: proof_receipt([base_derivation], [mismatched_evidence])
    run_receipt_case("matrix-mismatched", Some(matching), Some(mismatched), "", "", ["\"unknown\"", "declared inputs differ", "\"verdict\":\"reviewable\""])
    changed_evidence :: proof_evidence("claim-shared", "d-shared", "failed", "checked", "target-1", 1, "schedule:v1")
    changed :: proof_receipt([base_derivation], [changed_evidence])
    run_receipt_case("matrix-changed", Some(matching), Some(changed), "", "", ["\"changed\":1", "\"first_difference\"", "first differing comparable event or result", "\"verdict\":\"reviewable\""])
}

// Rust: tests/review.rs:543
#Test("review_receipt_fixture_matrix_tracks_gained_lost_changed_retained_and_authority_widening") {
    retained_derivation :: checked_derivation("d-retained", "build-1", "run-1", "target-1", "event-retained")
    changed_derivation :: checked_derivation("d-changed", "build-1", "run-1", "target-1", "event-changed")
    lost_derivation :: checked_derivation("d-lost", "build-1", "run-1", "target-1", "event-lost")
    gained_derivation :: checked_derivation("d-gained", "build-1", "run-1", "target-1", "event-gained")
    base :: proof_receipt([retained_derivation, changed_derivation, lost_derivation], [
        proof_evidence("claim-retained", "d-retained", "passed", "checked", "target-1", 1, "schedule:v1"),
        proof_evidence("claim-changed", "d-changed", "passed", "checked", "target-1", 1, "schedule:v1"),
        proof_evidence("claim-lost", "d-lost", "passed", "checked", "target-1", 1, "schedule:v1")
    ])
    head :: proof_receipt([retained_derivation, changed_derivation, gained_derivation], [
        proof_evidence("claim-retained", "d-retained", "passed", "checked", "target-1", 1, "schedule:v1"),
        proof_evidence("claim-changed", "d-changed", "failed", "checked", "target-1", 1, "schedule:v1"),
        proof_evidence("claim-gained", "d-gained", "passed", "checked", "target-1", 1, "schedule:v1")
    ])
    run_receipt_case("matrix-gained-lost", Some(base), Some(head), "", "", ["\"gained\":1", "\"lost\":1", "\"changed\":1", "\"retained\":1", "\"verdict\":\"proof lost\""])
    retained :: proof_receipt([checked_derivation("d-authority", "build-1", "run-1", "target-1", "event-authority")], [proof_evidence("claim-authority", "d-authority", "passed", "checked", "target-1", 1, "schedule:v1")])
    run_receipt_case("matrix-authority-retained", Some(retained), Some(retained), "FS", "FS, Net", ["\"status\":\"widened\"", "\"lost\":0", "\"verdict\":\"authority widened\""])
    lost :: proof_receipt([], [])
    run_receipt_case("matrix-authority-lost", Some(retained), Some(lost), "FS", "FS, Net", ["\"status\":\"widened\"", "\"lost\":1", "\"verdict\":\"authority widened and proof lost\""])
}

// Rust: tests/review.rs:686
#Test("review_classifies_authority_by_effect_set_relation_not_checkout_path") {
    // Separate manifest paths never decide the allow-set classification.
    for (name, base_allow, head_allow, expected_status, expected_verdict) in [
        ("authority-identical", "IO, Mem", "IO, Mem", None, "reviewable"),
        ("authority-narrowed", "FS, IO, Mem", "IO, Mem", Some("narrowed"), "reviewable"),
        ("authority-widened", "IO, Mem", "FS, IO, Mem", Some("widened"), "authority widened"),
        ("authority-incomparable", "FS, IO", "IO, Net", Some("changed"), "authority widened")
    ] {
        root :: scratch(name)
        _ :: fs.remove_dir_all(root)
        base :: project(&root, "base", base_allow, &REVIEW_SOURCE)
        head :: project(&root, "head", head_allow, &REVIEW_SOURCE)
        output :: review_command(&base, &head, None, None)
        stdout :: String.from_utf8_lossy(output.stdout).into_owned()
        assert(output.status.success(), "review `{name}` failed:\n{stdout}\n{String.from_utf8_lossy(output.stderr)}")
        start :: stdout.find("\"authority\":{{\"changes\":[").unwrap_or_else(() -> panic("review `{name}` omitted authority changes:\n{stdout}"))
        changes_tail := stdout[start..] // #4303
        changes := changes_tail[..changes_tail.find("]}}").expect("authority changes end")] // #4303
        match expected_status {
            None -> assert_eq(changes.matches("\"status\":").count(), 0, "`{name}`: identical authority in another directory is not a change:\n{changes}")
            Some(status) -> {
                assert_eq(changes.matches("\"status\":").count(), 1, "`{name}` must report exactly the allow-set change:\n{changes}")
                assert(changes.contains("\"status\":\"{status}\",\"key\":\"build_flag:security:package:authority.holds.allow\""), "`{name}` must classify the allow set as {status}:\n{changes}")
            }
        }
        assert(stdout.contains("\"verdict\":\"{expected_verdict}\""), "`{name}` must have verdict {expected_verdict}:\n{stdout}")
        _ :: fs.remove_dir_all(root)
    }
}

// Rust: tests/review.rs:740
#Test("review_receipt_fixture_matrix_refuses_duplicate_claim_and_derivation_ids") {
    first_derivation :: checked_derivation("d-first", "build-1", "run-1", "target-1", "event-first")
    second_derivation :: checked_derivation("d-second", "build-1", "run-1", "target-1", "event-second")
    duplicate_claim :: proof_receipt([first_derivation, second_derivation], [
        proof_evidence("claim-duplicate", "d-first", "passed", "checked", "target-1", 1, "schedule:v1"),
        proof_evidence("claim-duplicate", "d-first", "passed", "checked", "target-1", 1, "schedule:v1")
    ])
    assert_receipt_refused("matrix-duplicate-claim", &duplicate_claim, "duplicate evidence claim")
    duplicate_derivation :: proof_receipt([first_derivation, first_derivation], [proof_evidence("claim-duplicate-derivation", "d-first", "passed", "checked", "target-1", 1, "schedule:v1")])
    assert_receipt_refused("matrix-duplicate-derivation", &duplicate_derivation, "duplicate derivation ids")
}

// Rust: tests/review.rs:794
