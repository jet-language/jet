// #1629: every execution tier shares the AOT diagnostic voice and recovery data.
use std.[fs, env]
use core.files.OSPath
use jet.Diagnostics.[Diagnostic, ReportPath, FixApplicability]
use jet.Interpreter.[run_jit_once, dev_iteration]
use jet_foundation.JitBackend.RunOutcome
// GATE #4494: native filesystem/environment and retained execution-tier ingress.

// Rust: tests/run_tier_diagnostics.rs:14
pub fn skip_if_cranelift_host_unsupported() -> Bool {
    if jet_jit.cranelift_host_supported() { false }
    else if env.var("JET_REQUIRE_CRANELIFT_HOST") == Ok("1") {
        panic("cranelift-jit host path unsupported on this architecture (JET_REQUIRE_CRANELIFT_HOST=1)")
    } else {
        eprintln("note: cranelift-jit host path unsupported; skipping run-tier diag assertion")
        true
    }
}

// Rust: tests/run_tier_diagnostics.rs:39
pub fn e1112_row_text_matches_aot_run_and_interpreter_inner() -> {
    file :: OSPath.from(env.build_var("CARGO_MANIFEST_DIR")).join("tests/ui/empty_task_combinator.jet")
    path :: file.to_string_lossy().into_owned()
    src :: fs.read_to_string(file).unwrap()
    snapshot :: fs.read_to_string(file.with_extension("stderr")).unwrap()
    aot :: jet.compile_with_path(src, path).expect_err("AOT front end must reject an empty task combinator")
    run :: match run_jit_once(path) {
        RunOutcome.Problems(diags) -> diags
        other -> panic("default jet run must reject E1112: {other:?}")
    }
    interpreter :: match dev_iteration(path, false, true) {
        RunOutcome.Problems(diags) -> diags
        other -> panic("interpreter gate must reject E1112: {other:?}")
    }
    shape :: fn(diags: [Diagnostic]) -> diags.iter().map(fn(diag) ->
        (diag.code.clone(), diag.what.clone(), diag.why.clone(), diag.fix.clone(), diag.span)).collect()
    expected :: shape(aot)
    expected_report :: jet.render_all_json(ReportPath.from_path(file), src, aot)
    assert_eq(expected.len(), 3)
    assert(expected.iter().all(fn((code, ..)) -> code == "E1112"))
    loop (tier, diags) in [("default jet run", run), ("interpreter", interpreter)] {
        assert_eq(shape(diags), expected, "{tier} diagnostic drifted from AOT")
        assert_eq(jet.render_all_json(ReportPath.from_path(file), src, diags), expected_report, "{tier} structured report drifted from AOT")
        assert_eq(jet.render_diagnostics("tests/ui/empty_task_combinator.jet", src, diags), snapshot, "{tier} text drifted from the UI snapshot")
    }
    assert_eq(jet.render_diagnostics("tests/ui/empty_task_combinator.jet", src, aot), snapshot, "AOT text drifted from the UI snapshot")
}

// Rust: tests/run_tier_diagnostics.rs:118
pub fn e0956_row_text_matches_aot_run_and_interpreter_inner() -> {
    if skip_if_cranelift_host_unsupported() { return }
    file :: OSPath.from(env.build_var("CARGO_MANIFEST_DIR")).join("tests/ui/comptime_panic.jet")
    path :: file.to_string_lossy().into_owned()
    src :: fs.read_to_string(file).unwrap()
    snapshot :: fs.read_to_string(file.with_extension("stderr")).unwrap()
    aot :: jet.compile_with_path(src, path).expect_err("AOT front end must reject the unsupported comptime construct")
    run :: match run_jit_once(path) {
        RunOutcome.Problems(diags) -> diags
        other -> panic("default jet run must reject E0956: {other:?}")
    }
    interpreter :: match dev_iteration(path, false, true) {
        RunOutcome.Problems(diags) -> diags
        other -> panic("interpreter gate must reject E0956: {other:?}")
    }
    shape :: fn(diags: [Diagnostic]) -> diags.iter().map(fn(diag) ->
        (diag.code.clone(), diag.what.clone(), diag.why.clone(), diag.fix.clone(), diag.span)).collect()
    expected :: shape(aot)
    expected_report :: jet.render_all_json(ReportPath.from_path(file), src, aot)
    assert(expected.iter().any(fn((code, ..)) -> code == "E0956"))
    loop (tier, diags) in [("default jet run", run), ("interpreter", interpreter)] {
        assert_eq(shape(diags), expected, "{tier} diagnostic drifted from AOT")
        assert_eq(jet.render_all_json(ReportPath.from_path(file), src, diags), expected_report, "{tier} structured report drifted from AOT")
        assert_eq(jet.render_diagnostics("tests/ui/comptime_panic.jet", src, diags), snapshot, "{tier} text drifted from the UI snapshot")
    }
    assert_eq(jet.render_diagnostics("tests/ui/comptime_panic.jet", src, aot), snapshot, "AOT text drifted from the UI snapshot")
}

// Rust: tests/run_tier_diagnostics.rs:199
pub fn e0999_row_fix_matches_aot_run_and_interpreter_inner() -> {
    file :: OSPath.from(env.build_var("CARGO_MANIFEST_DIR")).join("tests/ui/single_bracket_marker.jet")
    path :: file.to_string_lossy().into_owned()
    src :: fs.read_to_string(file).unwrap()
    snapshot :: fs.read_to_string(file.with_extension("stderr")).unwrap()
    aot :: jet.compile_with_path(src, path).expect_err("AOT front end must reject a bare marker with brackets")
    run :: match run_jit_once(path) {
        RunOutcome.Problems(diags) -> diags
        other -> panic("default jet run must reject E0999: {other:?}")
    }
    interpreter :: match dev_iteration(path, false, true) {
        RunOutcome.Problems(diags) -> diags
        other -> panic("interpreter gate must reject E0999: {other:?}")
    }
    shape :: fn(diags: [Diagnostic]) -> diags.iter().map(fn(diag) ->
        (diag.code.clone(), diag.what.clone(), diag.why.clone(), diag.fix.clone(), diag.span, diag.edit.clone())).collect()
    expected :: shape(aot)
    expected_report :: jet.render_all_json(ReportPath.from_path(file), src, aot)
    assert_eq(expected.len(), 1)
    assert_eq(expected[0].0, "E0999")
    assert_eq(expected[0].5.map(fn(edit) -> edit.new_text), Some("#Codable"))
    loop (tier, diags) in [("default jet run", run), ("interpreter", interpreter)] {
        assert_eq(shape(diags), expected, "{tier} diagnostic or recovery data drifted from AOT")
        assert_eq(jet.render_all_json(ReportPath.from_path(file), src, diags), expected_report, "{tier} structured report drifted from AOT")
        assert_eq(jet.render_diagnostics("tests/ui/single_bracket_marker.jet", src, diags), snapshot, "{tier} text drifted from the UI snapshot")
    }
    assert_eq(jet.render_diagnostics("tests/ui/single_bracket_marker.jet", src, aot), snapshot, "AOT text drifted from the UI snapshot")
}

// Rust: tests/run_tier_diagnostics.rs:284
pub fn e0311_suggested_fix_matches_aot_run_and_interpreter_inner() -> {
    file :: OSPath.from(env.build_var("CARGO_MANIFEST_DIR")).join("tests/ui/map_method_typo.jet")
    path :: file.to_string_lossy().into_owned()
    src :: fs.read_to_string(file).unwrap()
    snapshot :: fs.read_to_string(file.with_extension("stderr")).unwrap()
    aot :: jet.compile_with_path(src, path).expect_err("AOT front end must reject missing methods")
    run :: match run_jit_once(path) {
        RunOutcome.Problems(diags) -> diags
        other -> panic("default jet run must reject E0311: {other:?}")
    }
    interpreter :: match dev_iteration(path, false, true) {
        RunOutcome.Problems(diags) -> diags
        other -> panic("interpreter gate must reject E0311: {other:?}")
    }
    shape :: fn(diags: [Diagnostic]) -> diags.iter().map(fn(diag) ->
        (diag.code.clone(), diag.what.clone(), diag.why.clone(), diag.fix.clone(), diag.span, diag.edit.clone(), diag.applicability)).collect()
    expected :: shape(aot)
    expected_report :: jet.render_all_json(ReportPath.from_path(file), src, aot)
    assert_eq(expected.len(), 4)
    assert(expected.iter().all(fn((code, ..)) -> code == "E0311"))
    assert(expected.iter().all(fn((_, _, _, _, _, edit, applicability)) ->
        edit.is_some() && applicability == Some(FixApplicability.Suggested)))
    loop (tier, diags) in [("default jet run", run), ("interpreter", interpreter)] {
        assert_eq(shape(diags), expected, "{tier} diagnostic or recovery data drifted from AOT")
        assert_eq(jet.render_all_json(ReportPath.from_path(file), src, diags), expected_report, "{tier} structured report drifted from AOT")
        assert_eq(jet.render_diagnostics("tests/ui/map_method_typo.jet", src, diags), snapshot, "{tier} text drifted from the UI snapshot")
    }
    assert_eq(jet.render_diagnostics("tests/ui/map_method_typo.jet", src, aot), snapshot, "AOT text drifted from the UI snapshot")
}
