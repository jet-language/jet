// Rust: tests/target_machines.rs:672
fn provider_fact_cases() -> [ProviderFactCase] {
    [
        ProviderFactCase { name: "MMIO", capability: TargetCapability.Mmio, set: set_mmio_provider, clear: clear_mmio_provider },
        ProviderFactCase { name: "Time.Wall", capability: TargetCapability.TimeWall, set: set_wall_provider, clear: clear_wall_provider },
        ProviderFactCase { name: "Time.Monotonic", capability: TargetCapability.TimeMonotonic, set: set_monotonic_provider, clear: clear_monotonic_provider },
        ProviderFactCase { name: "Time.ZoneData", capability: TargetCapability.TimeZoneData, set: set_zone_data_provider, clear: clear_zone_data_provider },
        ProviderFactCase { name: "Time.Sleep", capability: TargetCapability.TimeSleep, set: set_sleep_provider, clear: clear_sleep_provider },
        ProviderFactCase { name: "Rand.Entropy", capability: TargetCapability.Entropy, set: set_entropy_provider, clear: clear_entropy_provider },
        ProviderFactCase { name: "Target.Scheduler", capability: TargetCapability.Scheduler, set: set_scheduler_provider, clear: clear_scheduler_provider },
        ProviderFactCase { name: "IO.Read", capability: TargetCapability.IoRead, set: set_io_read_provider, clear: clear_io_read_provider },
        ProviderFactCase { name: "IO.Write", capability: TargetCapability.IoWrite, set: set_io_write_provider, clear: clear_io_write_provider },
        ProviderFactCase { name: "Panic.Report", capability: TargetCapability.PanicReport, set: set_panic_report_provider, clear: clear_panic_report_provider },
        ProviderFactCase { name: "Target.Allocator", capability: TargetCapability.Allocator, set: set_allocator_provider, clear: clear_allocator_provider },
        ProviderFactCase { name: "Target.Startup", capability: TargetCapability.Startup, set: set_startup_provider, clear: clear_startup_provider },
    ]
}
// Rust: tests/target_machines.rs:749
fn required_capability_use(capability: TargetCapability) -> TargetMachineUse {
    usage := TargetMachineUse { required_capabilities: [capability], ..TargetMachineUse.default() }
    if capability == TargetCapability.Allocator { usage.heap_required = true }
    usage
}
// Rust: tests/target_machines.rs:760
fn has_missing_capability(errors: &[TargetMachineError], capability: TargetCapability) -> Bool {
    errors.iter().any(fn(error) -> match error {
        TargetMachineError.MissingTargetCapability { capability: found } -> found == capability.as_str()
        TargetMachineError.HeapRequiresAllocator -> capability == TargetCapability.Allocator
        _ -> false
    })
}
// Rust: tests/target_machines.rs:773
fn has_invalid_provider(errors: &[TargetMachineError], capability: TargetCapability) -> Bool {
    errors.iter().any(fn(error) -> match error {
        TargetMachineError.InvalidProviderContract { capability: found, .. } -> found == capability.as_str()
        _ -> false
    })
}

// Rust: tests/target_machines.rs:958
fn write_target_fixture(tag: String, source: String) -> (OSPath, OSPath) {
    dir :: env.temp_dir().join("jet_target_machine_witness_{tag}_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).expect("create target witness directory")
    file :: dir.join("{tag}.jet")
    fs.write(file, source).expect("write target witness")
    (dir, file)
}
// Rust: tests/target_machines.rs:973
fn compile_target_fixture(tag: String, source: String, machine: &TargetMachine) -> jet.CompileOutput TargetMachineCompileError! {
    (dir, file) :: write_target_fixture(tag, source)
    shown :: file.to_string_lossy()
    result :: jet.Driver.compile_bundle_path_with_target_machine(shown, jet.Sema.CompileMode.Run, machine)
    _ :: fs.remove_dir_all(dir)
    result
}
