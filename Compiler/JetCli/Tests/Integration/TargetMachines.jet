// Rust: tests/target_machines.rs:16
fn checked_program_object(machine: &TargetMachine, dir: &OSPath) -> OSPath {
    fs.create_dir_all(dir).expect("create program fixture directory")
    source :: dir.join("program.c")
    object :: dir.join("program.o")
    fs.write(source, "typedef __SIZE_TYPE__ size_t;\n" +
        "extern int __jet_target_write(const unsigned char *, size_t, size_t *);\n" +
        "void __jet_program_entry(void) {\n" +
        "    const unsigned char text[] = \"program-linked\\n\";\n" +
        "    size_t used = 0;\n" +
        "    __jet_target_write(text, sizeof(text) - 1, &used);\n" +
        "}\n").expect("write program fixture")
    clang :: env.var_os("CC").unwrap_or_else(fn() -> OSPath("clang"))
    output :: Command.new(clang).arg("--target={machine.triple}")
        .arg("-nostdlib").arg("-ffreestanding").arg("-fno-builtin")
        .arg("-c").arg(source).arg("-o").arg(object).output()
        .expect("spawn clang for checked program fixture")
    assert(output.status.success(), "clang fixture failed: {String.from_utf8_lossy(output.stderr)}")
    object
}

// Rust: tests/target_machines.rs:54
fn sensor_machine() -> TargetMachine {
    machine := TargetMachine.board_sensor_v1()
    // Keep MMIO range used by compile-path volatile tests.
    machine.memory = [
        MemoryRegion.new("flash", 0x0800_0000, ByteSize.kib(512), MemoryKind.Flash, MemoryAccess.Rx),
        MemoryRegion.new("ram", 0x2000_0000, ByteSize.kib(64), MemoryKind.Ram, MemoryAccess.Rw),
        MemoryRegion.new("peripherals", 0x4000_0000, ByteSize.mib(1), MemoryKind.Mmio, MemoryAccess.Rw),
    ]
    machine.linker = LinkerInput.File { path: "vendor/memory.x", sha256: "sha256:abc123" }
    machine.allocator = AllocatorPolicy.Fixed { region: "ram", size: ByteSize.kib(8) }
    machine.panic = PanicPolicy.Abort
    machine
}

