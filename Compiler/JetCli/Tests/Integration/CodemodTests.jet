}

// Rust: tests/codemod.rs:851
#Test("recovery_rejects_hostile_journal_paths_without_touching_outside_file") {
    project :: temp_dir("batch_hostile_journal")
    object :: simple_batch(project, 2)
    outside :: project.parent().unwrap().join("{project.file_name().unwrap().to_string_lossy()}-outside.jet")
    fs.write(outside, "outside bytes\n".bytes()).unwrap()
    dir :: project.join(".jet/codemods")
    fs.create_dir_all(dir).unwrap()
    hex :: (bytes: [U8]) -> {
        result := String.new()
        loop byte in bytes { &result.push_str("{byte:02x}") }
        result
    }
    log :: dir.join("Hostile.log.json")
    before_hex :: hex("outside bytes\n".bytes())
    after_hex :: hex("owned\n".bytes())
    journal :: "{{\"schema\":2,\"tx\":\"hostile\",\"completed\":0,\"log_path\":\"{log.display()}\",\"log\":\"\",\"files\":[{{\"path\":\"{outside.display()}\",\"temp\":\"{outside.with_extension("tmp").display()}\",\"destination_id\":[1,1],\"temp_id\":[2,2],\"before\":\"{before_hex}\",\"after\":\"{after_hex}\"}}]}}\n"
    journal_path :: dir.join("transaction.journal")
    fs.write(journal_path, journal).unwrap()
    output :: Command.new(jet()).args(["inspect", "codemod"]).arg(object.to_str().unwrap()).arg("--dry-run").output().unwrap()
    assert(!output.status.success())
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(stderr.contains("escapes retained project"), "{stderr}")
    assert_eq(fs.read(outside).unwrap(), "outside bytes\n".bytes())
    assert(journal_path.exists(), "hostile journal must remain for inspection")
}

// Rust: tests/codemod.rs:891
#Test("dry_run_diff_preserves_eof_newline_truth") {
    project :: temp_dir("batch_eof_diff")
    source :: project.join("Examples/a.jet")
    fs.create_dir_all(source.parent().unwrap()).unwrap()
    fs.write(source, "fn report() {{}}\nfn run() {{ report() }}".bytes()).unwrap()
    object :: project.join("rename.codemod.json")
    fs.write(object, "{{\"version\":2,\"name\":\"Eof\",\"project\":\".\",\"roots\":[{{\"path\":\"Examples/a.jet\",\"validate\":\"clean\"}}],\"rules\":[{{\"id\":\"rename\",\"kind\":\"symbol_rename\",\"from\":{{\"name\":\"report\",\"symbol_kind\":\"function\"}},\"to\":\"summarize\",\"matches\":2}}]}}\n").unwrap()
    output :: Command.new(jet()).args(["inspect", "codemod"]).arg(object.to_str().unwrap()).arg("--dry-run").output().unwrap()
    assert(output.status.success(), "{String.from_utf8_lossy(output.stderr)}")
    stdout :: String.from_utf8_lossy(output.stdout)
    assert_eq(stdout.matches("\\ No newline at end of file").count(), 2, "{stdout}")
    assert_eq(fs.read(source).unwrap(), "fn report() {{}}\nfn run() {{ report() }}".bytes())
}
