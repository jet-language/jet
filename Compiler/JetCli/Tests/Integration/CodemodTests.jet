    fs.write(source, before).unwrap()
    object :: project.join("variadic.codemod.json")
    fs.write(object, "{{\"version\":2,\"name\":\"ScalarVariadic\",\"project\":\".\",\"roots\":[{{\"path\":\"Examples/a.jet\",\"validate\":\"clean\"}}],\"rules\":[{{\"id\":\"scalar\",\"kind\":\"ast_rewrite\",\"node\":\"expr\",\"match\":\"$values... + 2\",\"replace\":\"$values... + 3\",\"matches\":1}}]}}\n").unwrap()
    output :: Command.new(jet()).args(["inspect", "codemod"]).arg(object.to_str().unwrap()).arg("--dry-run").output().unwrap()
    assert(!output.status.success())
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(stderr.contains("not a valid Jet expr template") || stderr.contains("matched 0, expected 1"), "{stderr}")
    assert_eq(fs.read_to_string(source).unwrap(), before)
}

// Rust: tests/codemod.rs:688
#Test("transaction_rejects_swapped_temp_inode_before_destination_rename") {
    if target.selected_family() == "unix" {
        project :: temp_dir("batch_temp_swap")
        object :: simple_batch(project, 2)
        source :: project.join("Examples/a.jet")
        before :: fs.read(source).unwrap()
        crashed :: Command.new(jet()).env("JET_CODEMOD_CRASH_AFTER_JOURNAL", "1").args(["inspect", "codemod", "apply", object.to_str().unwrap(), "--yes"]).output().unwrap()
        assert_eq(crashed.status.code(), Val(87))
        temp :: fs.read_dir(source.parent().unwrap()).unwrap().map(entry -> entry.unwrap().path()).find(path -> path.file_name().unwrap().to_string_lossy().starts_with(".jet-codemod-")).expect("staged temp must remain after simulated crash")
        fs.remove_file(temp).unwrap()
        fs.write(temp, "hostile replacement\n".bytes()).unwrap()
        recovered :: Command.new(jet()).args(["inspect", "codemod"]).arg(object.to_str().unwrap()).arg("--dry-run").output().unwrap()
        assert(!recovered.status.success())
        assert(String.from_utf8_lossy(recovered.stderr).contains("identity changed"))
        assert_eq(fs.read(source).unwrap(), before)
        assert(project.join(".jet/codemods/transaction.journal").exists())
    }
}

// Rust: tests/codemod.rs:732
#Test("transaction_rejects_destination_parent_directory_swap") {
    if target.selected_family() == "unix" {
        project :: temp_dir("batch_directory_swap")
        object :: simple_batch(project, 2)
        source :: project.join("Examples/a.jet")
        before :: fs.read(source).unwrap()
        crashed :: Command.new(jet()).env("JET_CODEMOD_CRASH_AFTER_JOURNAL", "1").args(["inspect", "codemod", "apply", object.to_str().unwrap(), "--yes"]).output().unwrap()
        assert_eq(crashed.status.code(), Val(87))
        held :: project.join("examples-held")
        fs.rename(project.join("Examples"), held).unwrap()
        fs.create_dir(project.join("Examples")).unwrap()
        hostile :: project.join("Examples/a.jet")
        fs.write(hostile, "fn hostile() {{}}\n".bytes()).unwrap()
        recovered :: Command.new(jet()).args(["inspect", "codemod"]).arg(object.to_str().unwrap()).arg("--dry-run").output().unwrap()
        assert(!recovered.status.success())
        assert(String.from_utf8_lossy(recovered.stderr).contains("identity changed"))
        assert_eq(fs.read(held.join("a.jet")).unwrap(), before)
        assert_eq(fs.read(hostile).unwrap(), "fn hostile() {{}}\n".bytes())
    }
}

// Rust: tests/codemod.rs:769
#Test("directory_lock_ignores_hostile_hardlinked_lock_filename") {
    if target.selected_family() == "unix" {
        project :: temp_dir("batch_lock_hardlink")
        object :: simple_batch(project, 2)
        codemods :: project.join(".jet/codemods")
        fs.create_dir_all(codemods).unwrap()
        sentinel :: project.join("sentinel")
        fs.write(sentinel, "must remain unchanged\n".bytes()).unwrap()
        fs.hard_link(sentinel, codemods.join("codemod.lock")).unwrap()
        output :: Command.new(jet()).args(["inspect", "codemod", "apply", object.to_str().unwrap(), "--yes"]).output().unwrap()
        assert(output.status.success(), "{String.from_utf8_lossy(output.stderr)}")
        assert_eq(fs.read(sentinel).unwrap(), "must remain unchanged\n".bytes())
    }
}

// Rust: tests/codemod.rs:799
#Test("undo_rejects_log_symlinks_and_destination_hardlink_aliases_before_reading") {
    if target.selected_family() == "unix" {
        project :: temp_dir("undo_aliases")
        a :: project.join("Examples/a.jet")
        b :: project.join("Examples/b.jet")
        logs :: project.join(".jet/codemods")
        fs.create_dir_all(a.parent().unwrap()).unwrap()
        fs.create_dir_all(logs).unwrap()
        fs.write(a, "fn run() {{}}\n").unwrap()
        fs.hard_link(a, b).unwrap()
        bytes :: fs.read(a).unwrap()
        hex := String.new()
        loop byte in bytes { &hex.push_str("{byte:02x}") }
        hash :: "sha256-{sha256_hex(bytes)}"
        real :: logs.join("Alias.log.json")
        fs.write(real, "{{\"schema\":2,\"name\":\"Alias\",\"project\":\"{project.display()}\",\"files\":[{{\"path\":\"{a.display()}\",\"before_hash\":\"{hash}\",\"after_hash\":\"{hash}\",\"before_bytes\":\"{hex}\",\"after_bytes\":\"{hex}\"}},{{\"path\":\"{b.display()}\",\"before_hash\":\"{hash}\",\"after_hash\":\"{hash}\",\"before_bytes\":\"{hex}\",\"after_bytes\":\"{hex}\"}}]}}\n").unwrap()
        alias :: logs.join("AliasLink.log.json")
        fs.symlink(real, alias).unwrap()
        linked :: Command.new(jet()).args(["inspect", "codemod", "undo", alias.to_str().unwrap()]).output().unwrap()
        assert(!linked.status.success())
        assert(String.from_utf8_lossy(linked.stderr).contains("regular non-link"))
        duplicated :: Command.new(jet()).args(["inspect", "codemod", "undo", real.to_str().unwrap()]).output().unwrap()
        assert(!duplicated.status.success())
        stderr :: String.from_utf8_lossy(duplicated.stderr)
        assert(stderr.contains("alias the same file") || stderr.contains("regular file with one link") || stderr.contains("multiple hard links"), "{stderr}")
    }
}

// Rust: tests/codemod.rs:841
#Test("windows_transaction_source_binds_temp_and_flushes_opened_directories") {
    // This is the original source-level Rust comparator, not a runtime Rust bridge.
    source :: fs.read_to_string(OSPath.from_text(env.var("CARGO_MANIFEST_DIR").unwrap()).join("Source/CmdCodemod/Transaction.rs")).unwrap()
    assert(source.contains("let temp_final = final_path(temp.as_raw_handle())?"))
    assert(source.contains("opened temp does not belong to opened project parent directory"))
    assert(source.contains("FlushFileBuffers(parent.as_raw_handle())"))
