    assert(!project.join(".jet/codemods/transaction.journal").exists())
}

// Rust: tests/codemod.rs:421
#Test("batch_rejects_symlink_and_parent_escape_roots") {
    if target.selected_family() == "unix" {
        project :: temp_dir("batch_paths")
        fs.create_dir_all(project.join("Examples")).unwrap()
        outside :: project.parent().unwrap().join("codemod-outside.jet")
        fs.write(outside, "fn run() {{}}\n").unwrap()
        fs.symlink(outside, project.join("Examples/link.jet")).unwrap()
        object :: project.join("bad.codemod.json")
        loop root in ["Examples/link.jet", "Examples/../tests/ui/x.jet"] {
            fs.write(object, "{{\"version\":2,\"name\":\"Bad\",\"project\":\".\",\"roots\":[{{\"path\":\"{root}\",\"validate\":\"clean\"}}],\"rules\":[{{\"id\":\"x\",\"kind\":\"symbol_rename\",\"from\":{{\"name\":\"run\",\"symbol_kind\":\"function\"}},\"to\":\"start\",\"matches\":1}}]}}\n").unwrap()
            output :: Command.new(jet()).args(["inspect", "codemod"]).arg(object.to_str().unwrap()).arg("--dry-run").output().unwrap()
            assert(!output.status.success(), "root {root} must fail")
        }
    }
}

// Rust: tests/codemod.rs:442
#Test("schema_one_inverse_edit_log_remains_readable") {
    dir :: temp_dir("schema_one_log")
    source :: dir.join("Examples/main.jet")
    fs.create_dir_all(source.parent().unwrap()).unwrap()
    before :: "fn report() {{}}\nfn run() {{ report() }}\n"
    after :: "fn summarize() {{}}\nfn run() {{ summarize() }}\n"
    fs.write(source, after).unwrap()
    hash :: (s: String) -> "sha256-{sha256_hex(s.bytes())}"
    log :: dir.join(".jet/codemods/old.log.json")
    fs.create_dir_all(log.parent().unwrap()).unwrap()
    fs.write(log, "{{\"name\":\"Old\",\"files\":[{{\"path\":\"{source.display()}\",\"before_hash\":\"{hash(before)}\",\"after_hash\":\"{hash(after)}\",\"inverse_edits\":[{{\"start\":3,\"end\":12,\"new_text\":\"report\"}},{{\"start\":29,\"end\":38,\"new_text\":\"report\"}}]}}]}}\n").unwrap()
    undo :: Command.new(jet()).args(["inspect", "codemod", "undo", log.to_str().unwrap()]).output().unwrap()
    assert(undo.status.success(), "{String.from_utf8_lossy(undo.stderr)}")
    assert_eq(fs.read_to_string(source).unwrap(), before)
}

// Rust: tests/codemod.rs:466
#Test("batch_refuses_collision_invalid_binding_and_overlapping_ast_nodes") {
    project :: temp_dir("batch_semantic_refusals")
    source :: project.join("Examples/a.jet")
    fs.create_dir_all(source.parent().unwrap()).unwrap()
    body :: "fn report(value: Int) {{ print(value) }}\nfn summarize(value: Int) {{ print(value) }}\nfn run() {{ report(report(1)) }}\n"
    fs.write(source, body).unwrap()
    object :: project.join("bad.codemod.json")
    fs.write(object, "{{\"version\":2,\"name\":\"Collision\",\"project\":\".\",\"roots\":[{{\"path\":\"Examples/a.jet\",\"validate\":\"clean\"}}],\"rules\":[{{\"id\":\"rename\",\"kind\":\"symbol_rename\",\"from\":{{\"name\":\"report\",\"symbol_kind\":\"function\"}},\"to\":\"summarize\",\"matches\":3}}]}}\n").unwrap()
    collision :: Command.new(jet()).args(["inspect", "codemod"]).arg(object.to_str().unwrap()).arg("--dry-run").output().unwrap()
    assert(!collision.status.success())
    assert(String.from_utf8_lossy(collision.stderr).contains("destination `summarize`"))
    fs.write(object, "{{\"version\":2,\"name\":\"Binding\",\"project\":\".\",\"roots\":[{{\"path\":\"Examples/a.jet\",\"validate\":\"clean\"}}],\"rules\":[{{\"id\":\"binding\",\"kind\":\"ast_rewrite\",\"node\":\"expr\",\"match\":\"report($value)\",\"replace\":\"missing($value)\",\"matches\":2}}]}}\n").unwrap()
    binding :: Command.new(jet()).args(["inspect", "codemod"]).arg(object.to_str().unwrap()).arg("--dry-run").output().unwrap()
    assert(!binding.status.success())
    assert(String.from_utf8_lossy(binding.stderr).contains("does not resolve"))
    fs.write(object, "{{\"version\":2,\"name\":\"Overlap\",\"project\":\".\",\"roots\":[{{\"path\":\"Examples/a.jet\",\"validate\":\"clean\"}}],\"rules\":[{{\"id\":\"overlap\",\"kind\":\"ast_rewrite\",\"node\":\"expr\",\"match\":\"report($value)\",\"replace\":\"summarize($value)\",\"matches\":2}}]}}\n").unwrap()
    overlap :: Command.new(jet()).args(["inspect", "codemod"]).arg(object.to_str().unwrap()).arg("--dry-run").output().unwrap()
    assert(!overlap.status.success())
    assert(String.from_utf8_lossy(overlap.stderr).contains("overlapping edits"), "{String.from_utf8_lossy(overlap.stderr)}")
    assert_eq(fs.read_to_string(source).unwrap(), body)
}

