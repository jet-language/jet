#!/usr/bin/env jet
// Native O0/O2 C FFI parity. Invoked by the integrator under the cheap proof lane.
// Usage: jet run Compiler/JetCli/Tests/RunCFfi.jet -- <jet> <scratch>
// Run from the repository root: the Core, Examples and expected-output trees are read from the working directory.
use core.files as files
use core.process as process
use core.term as term

fn fail(message: String) -> Never {
    term.eprint(message)
    process.exit(1)
}

// Recursive copy of `from` into `to`; entries named `.jet` are skipped at every depth.
fn copy_tree(from: String, to: String) {
    files.create_dir_all(to.copy()) ?? fail("cannot create {to}: {err}")
    entries :: files.list_dir(from.copy()) ?? fail("cannot list {from}: {err}")
    loop entry in entries {
        if entry.name == ".jet" -> next
        source :: "{from}/{entry.name}"
        target :: "{to}/{entry.name}"
        if entry.is_dir {
            copy_tree(source, target)
        } else {
            files.copy(source.copy(), target.copy()) ?? fail("cannot copy {source}: {err}")
        }
    }
}

// stdout of one `jet run` of `directory/run.jet` in `scratch`, at O2 when `release`; a failed run is fatal.
fn run_tier(jet: String, scratch: String, directory: String, release: Bool) -> String {
    tier :: if release -> "native O2" else -> "native O0"
    args := [String]{jet.copy(), "run"}
    if release -> &args.push("--release")
    &args.push("{scratch}/{directory}/run.jet")
    receipt :: process.cmd(args).cwd(scratch.copy()).env("NO_COLOR", "1").run() ?? fail("{directory} {tier} failed: {err}")
    if !receipt.success -> fail("{directory} {tier} failed: code={receipt.code}\n{receipt.output}{receipt.errors}")
    receipt.output
}

fn check_fixture(jet: String, scratch: String, directory: String, expected: String) {
    native := run_tier(jet.copy(), scratch.copy(), directory.copy(), false)
    if native != expected -> fail("{directory} native O0 output differs: {native}; expected {expected}")
    release := run_tier(jet.copy(), scratch.copy(), directory.copy(), true)
    if release != expected -> fail("{directory} native O2 output differs: {release}; expected {expected}")
    if release != native -> fail("{directory} tier meaning differs")
    term.print("{directory}: native O0/O2 identical")
}

fn run() {
    args :: process.args()
    if args.len() != 2 -> fail("usage: node Compiler/JetCli/Tests/run-c-ffi.mjs <jet> <scratch>")
    jet :: files.canonicalize(args[0].copy()) ?? fail("cannot resolve {args[0]}: {err}")
    scratch :: files.absolute(args[1].copy()) ?? fail("cannot resolve {args[1]}: {err}")
    repo :: files.canonicalize(".") ?? fail("cannot resolve the repository root: {err}")
    files.create_dir_all(scratch.copy()) ?? fail("cannot create {scratch}: {err}")
    copy_tree("{repo}/Examples/features/lowlevel/native_c", "{scratch}/native_c")
    copy_tree("{repo}/Core/Vendor/Sqlite3", "{scratch}/sqlite3")
    native_expected :: files.read("{repo}/Examples/features/expected/lowlevel/native_c/run.out") ?? fail("cannot read run.out: {err}")
    check_fixture(jet.copy(), scratch.copy(), "native_c".copy(), native_expected)
    check_fixture(jet.copy(), scratch.copy(), "sqlite3/fixture", "sqlite-memory=42\n")
}
