// FRONT PROOF BEGIN: real Front/Host closure required, not a scratch dispatcher.
// Full-closure integration proof pending; excluded only from the focused unit.
#Test("budget Front preserves raw flags and shared Host dispatch with generic help first") {
    facts :: JetCLIProcessFacts{stdout_terminal: false, stderr_terminal: false, shell_prefill: false, term: None, no_color: true, force_color: false, columns: None, locale: Val("C.UTF-8")}
    raw :: [String]{"budget", "check", "--json", "--quiet"}
    plan :: jet_cli_front(raw, facts)
    if plan == {
        .Budget(arguments) -> assert_eq(arguments, raw)
        else -> panic("budget flags must route unmodified")
    }
    direct_host := budget_test_host(false)
    direct :: jet_cli_budget_run<BudgetTestHost>(&direct_host, raw)
    routed_host := budget_test_host(false)
    routed :: jet_cli_dispatch_with_budget<BudgetTestHost>(raw, facts, &routed_host)
    assert(budget_test_output(routed, direct.stdout, direct.stderr, direct.exit_code))
    assert_eq(routed_host.calls, direct_host.calls)
    help_host := budget_test_host(false)
    help :: jet_cli_dispatch_with_budget<BudgetTestHost>([String]{"budget", "check", "--help"}, facts, &help_host)
    assert(budget_test_output(help, jet_cli_command_help("budget"), "", 0))
    assert_eq(help_host.calls, [String]{})
}
