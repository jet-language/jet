#Test("budget Rust byte exact human plan tool refusal and stored build gate") {
    host := budget_test_host(false)
    id :: jet_cli_budget_manifest_report_id(perf_verify_budget_report(host.report) ?? panic("verified fixture")) ?? panic("fixture id")
    old :: "2".repeat(64)
    assert(budget_test_output(jet_cli_budget_run(&host, [String]{"budget", "update", "--baseline", "main"}), "", "+ report {id}\n~ baseline main {old} -> {id}\nplan only; pass -y or --yes to apply in a non-interactive shell\n", 0))
    options :: jet_cli_budget_options("check")
    assert(budget_test_output(jet_cli_budget_failure(options, JetCLIBudgetError.Tool("refused"), None), "", "Error [E2908]: Performance budget operation failed\n Why: refused\n Fix: Correct the named failure and retry\nMore: jet-lang.dev/e/E2908\nbudget command failed before a valid report was produced\n", 1))
    assert(budget_test_output(jet_cli_budget_failure(options, JetCLIBudgetError.Tool("refused"), Val("0123456789abcdef")), "", "Error [E2908]: Performance budget operation failed\n Why: refused\n Fix: Correct the named failure and retry\nMore: jet-lang.dev/e/E2908\nbudget command failed · report 0123456789abcdef was not accepted\n", 1))
    // Rust StoredBuildFact: report measurement order (not result rank), the
    // measurement's `path:line` source, budget_spec.name else the id suffix.
    stored :: (id: String, spec: CanonicalJSON, source: String) -> jet_cli_budget_object([CanonicalJSONField]{budget_test_f("budget_id", budget_test_s(id)), budget_test_f("budget_spec", spec), budget_test_f("source", budget_test_s(source))})
    named :: jet_cli_budget_object([CanonicalJSONField]{budget_test_f("name", budget_test_s("latency"))})
    measurements :: CanonicalJSON.Array([CanonicalJSON]{stored("budget:b", named, "src/日本.jet:3"), stored("budget:speed", CanonicalJSON.Null, "src/b.jet:7")})
    value :: jet_cli_budget_object([CanonicalJSONField]{budget_test_f("content", jet_cli_budget_object([CanonicalJSONField]{budget_test_f("measurements", measurements)}))})
    built :: JetCLIBudgetBuilt{value: value, bytes: [U8]{}, results: [JetCLIBudgetResult]{
        JetCLIBudgetResult{measurement: 1, spec: 0, outcome: "fail", evidence: "regression", reason: "over limit", stale: false},
        JetCLIBudgetResult{measurement: 0, spec: 0, outcome: "fail", evidence: "unavailable", reason: "provider unavailable", stale: false}}, fail: 2, id: "0123456789abcdef"}
    unavailable :: "Error [E2906]: Performance budget latency has no usable evidence\n --> src/日本.jet:3\n Why: provider unavailable\n Fix: Correct the provider evidence or bootstrap only when absent or stale evidence is eligible\nMore: jet-lang.dev/e/E2906\n"
    regressed :: "Error [E2907]: Performance budget speed regressed\n --> src/b.jet:7\n Why: over limit\n Fix: Improve the measured behavior, inspect `jet budget check --verbose`, or record an explicit exception\nMore: jet-lang.dev/e/E2907\n"
    assert(budget_test_output(jet_cli_budget_emit_stored_gates(built), "", "{unavailable}{regressed}budgets failed: 2 budgets failed · report 0123456789ab\n", 1))
}

