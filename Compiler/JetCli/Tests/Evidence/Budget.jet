    assert(budget_test_output(jet_cli_budget_emit_check(options, built, budget_test_checked(), false, false), "", "pass b: point 9/1 · bounds [none, none] · baseline [none] · BenchTime · within limit\n~ report 0123456789abcdef .jet/perf/reports/0123456789abcdef.json (verified reuse)\nbudgets: 1 budget passed · report 0123456789ab\n", 0))
    options.quiet = true
    assert(budget_test_output(jet_cli_budget_emit_check(options, built, budget_test_checked(), true, false), "", "pass b: point 9/1 · bounds [none, none] · baseline [none] · BenchTime · within limit\n+ report 0123456789abcdef .jet/perf/reports/0123456789abcdef.json\n", 0))
}
#Test("budget Rust byte exact percentile labels preserve suffix case and Unicode") {
    checked :: budget_test_checked()
    built :: budget_test_output_built("pass", "pass", "within limit", false, budget_test_s("meanX"))
    assert_eq(jet_cli_budget_verbose(built, built.results[0], checked.specs[0]).bytes(), "pass b: point 9/1 · bounds [none, none] · baseline [none] · BenchTime(MeanX) · within limit\n".bytes())
    metric := jet_cli_budget_object([CanonicalJSONField]{budget_test_f("name", budget_test_s("BenchTime")), budget_test_f("percentile", budget_test_s("p95"))})
    assert_eq(jet_cli_budget_metric_label(metric), "BenchTime(P95)")
    metric = budget_test_set(metric, "percentile", budget_test_s("élanX"))
    assert_eq(jet_cli_budget_metric_label(metric), "BenchTime(élanX)")
    metric = budget_test_set(metric, "percentile", budget_test_s(""))
    nul :: String.from_bytes([U8]{0}) ?? panic("NUL")
    assert_eq(jet_cli_budget_metric_label(metric).bytes(), "BenchTime({nul})".bytes())
}
#Test("budget Rust byte exact diagnostic GitHub properties messages and quiet") {
    cr :: String.from_bytes([U8]{13}) ?? panic("CR")
    built :: budget_test_output_built("fail", "unavailable", "missing 50%:{cr}\nnext", false, CanonicalJSON.Null)
    checked := budget_test_checked()
    checked.specs[0].source = "src/日本%:,x{cr}\n.jet"
    options := jet_cli_budget_options("check")
    options.quiet = true
    options.annotations = JetCLIBudgetAnnotations.Github
    diagnostic :: "Error [E2906]: performance budget latency has no usable evidence\n --> src/日本%:,x{cr}\n.jet:3:5\n Why: missing 50%:{cr}\nnext\n Fix: correct the provider evidence or bootstrap only when absent or stale evidence is eligible\nMore: jet-lang.dev/e/E2906\n"
    annotation :: "::error file=src/日本%25%3A%2Cx%0D%0A.jet,line=3,col=5,title=Jet E2906::performance budget latency has no usable evidence%0AWhy: missing 50%25:%0D%0Anext%0AFix: correct the provider evidence or bootstrap only when absent or stale evidence is eligible\n"
    assert(budget_test_output(jet_cli_budget_emit_check(options, built, checked, true, false), "", "{diagnostic}{annotation}", 1))
    options.annotations = JetCLIBudgetAnnotations.Auto
    assert(budget_test_output(jet_cli_budget_emit_check(options, built, checked, true, true), "", "{diagnostic}{annotation}", 1))
    assert(budget_test_output(jet_cli_budget_emit_check(options, built, checked, true, false), "", diagnostic, 1))
    options.quiet = false
    assert(budget_test_output(jet_cli_budget_emit_check(options, built, checked, true, false), "", "{diagnostic}budgets unavailable: 1 result unavailable · report 0123456789ab\n", 1))
}
#Test("budget Rust byte exact regression inconclusive stale warnings and recap precedence") {
    built := budget_test_output_built("fail", "regression", "over limit", false, CanonicalJSON.Null)
    options := jet_cli_budget_options("check")
    options.annotations = JetCLIBudgetAnnotations.Disabled
    regression :: "Error [E2907]: performance budget latency regressed\n --> src/日本.jet:3:5\n Why: over limit\n Fix: improve the measured behavior, inspect `jet budget check --verbose`, or record an explicit exception\nMore: jet-lang.dev/e/E2907\n"
    assert(budget_test_output(jet_cli_budget_emit_check(options, built, budget_test_checked(), true, false), "", "{regression}budgets failed: 1 budget failed · report 0123456789ab\n", 1))
    built.results[0].evidence = "inconclusive"
    inconclusive :: "Error [E2907]: performance budget latency is inconclusive\n --> src/日本.jet:3:5\n Why: over limit\n Fix: improve the measured behavior, inspect `jet budget check --verbose`, or record an explicit exception\nMore: jet-lang.dev/e/E2907\n"
    assert(budget_test_output(jet_cli_budget_emit_check(options, built, budget_test_checked(), true, false), "", "{inconclusive}budgets failed: 1 budget failed · report 0123456789ab\n", 1))
    built = budget_test_output_built("fail", "unavailable", "named baseline compatible history is stale", true, CanonicalJSON.Null)
    stale :: "Error [E2906]: performance budget latency has no usable evidence\n --> src/日本.jet:3:5\n Why: named baseline compatible history is stale\n Fix: correct the provider evidence or bootstrap only when absent or stale evidence is eligible\nMore: jet-lang.dev/e/E2906\n"
    assert(budget_test_output(jet_cli_budget_emit_check(options, built, budget_test_checked(), true, false), "", "{stale}budgets stale: 1 baseline stale · report 0123456789ab\n", 1))
    built = budget_test_output_built("warn", "regression", "over limit", false, CanonicalJSON.Null)
    warning :: "Warning [E2907]: performance budget latency regressed\n --> src/日本.jet:3:5\n Why: over limit\n Fix: improve the measured behavior, inspect `jet budget check --verbose`, or record an explicit exception\nMore: jet-lang.dev/e/E2907\n"
    assert(budget_test_output(jet_cli_budget_emit_check(options, built, budget_test_checked(), true, false), "", "{warning}budgets: 1 warning · report 0123456789ab\n", 0))
    &built.results.push(JetCLIBudgetResult{measurement: 0, spec: 0, outcome: "pass", evidence: "pass", reason: "", stale: false})
    assert(budget_test_output(jet_cli_budget_emit_check(options, built, budget_test_checked(), true, false), "", "{warning}budgets: 1 budget passed · 1 warning · report 0123456789ab\n", 0))
    &built.results.push(JetCLIBudgetResult{measurement: 0, spec: 0, outcome: "fail", evidence: "regression", reason: "over limit", stale: false})
    built.fail = 1
    assert(budget_test_output(jet_cli_budget_emit_check(options, built, budget_test_checked(), true, false), "", "{warning}{regression}budgets failed: 1 budget failed · 1 warning · report 0123456789ab\n", 1))
    &built.results.push(~built.results[2])
    built.fail = 2
    assert(budget_test_output(jet_cli_budget_emit_check(options, built, budget_test_checked(), true, false), "", "{warning}{regression}{regression}budgets failed: 2 budgets failed · 1 warning · report 0123456789ab\n", 1))
}
