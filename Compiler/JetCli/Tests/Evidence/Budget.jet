#Test("budget Rust byte exact JSON update plan create reuse old head and applied") {
    options := jet_cli_budget_options("update")
    options.json = true
    built :: JetCLIBudgetBuilt{value: CanonicalJSON.Null, bytes: [U8]{}, results: [JetCLIBudgetResult]{}, fail: 0, id: "0123456789abcdef"}
    created :: "{{\"schema\":\"jet.status/v1\",\"action\":\"update\",\"ok\":true,\"reports\":[],\"budget\":{{\"applied\":false,\"diagnostics\":[],\"exit_code\":0,\"failure_kind\":null,\"plan\":{{\"baseline\":\"main\",\"requires_confirmation\":false,\"rows\":[{{\"artifact\":\"report\",\"from_id\":null,\"id\":\"0123456789abcdef\",\"operation\":\"create\",\"path\":\".jet/perf/reports/0123456789abcdef.json\",\"to_id\":\"0123456789abcdef\"}},{{\"artifact\":\"baseline\",\"from_id\":null,\"id\":\"0123456789abcdef\",\"operation\":\"advance\",\"path\":\".jet/perf/baselines/names/main.json\",\"to_id\":\"0123456789abcdef\"}}]}},\"report\":null,\"report_path\":\".jet/perf/reports/0123456789abcdef.json\",\"results\":[]}}}}"
    assert(budget_test_output(jet_cli_budget_emit_json(options, built, budget_test_checked(), Val(JetCLIBudgetOutputPlan{baseline: "main", old: None, created: true}), false, 0), created, "", 0))
    reused :: "{{\"schema\":\"jet.status/v1\",\"action\":\"update\",\"ok\":true,\"reports\":[],\"budget\":{{\"applied\":true,\"diagnostics\":[],\"exit_code\":0,\"failure_kind\":null,\"plan\":{{\"baseline\":\"main\",\"requires_confirmation\":false,\"rows\":[{{\"artifact\":\"report\",\"from_id\":null,\"id\":\"0123456789abcdef\",\"operation\":\"reuse\",\"path\":\".jet/perf/reports/0123456789abcdef.json\",\"to_id\":\"0123456789abcdef\"}},{{\"artifact\":\"baseline\",\"from_id\":\"prior\",\"id\":\"0123456789abcdef\",\"operation\":\"advance\",\"path\":\".jet/perf/baselines/names/main.json\",\"to_id\":\"0123456789abcdef\"}}]}},\"report\":null,\"report_path\":\".jet/perf/reports/0123456789abcdef.json\",\"results\":[]}}}}"
    assert(budget_test_output(jet_cli_budget_emit_json(options, built, budget_test_checked(), Val(JetCLIBudgetOutputPlan{baseline: "main", old: Val("prior"), created: false}), true, 0), reused, "", 0))
}
