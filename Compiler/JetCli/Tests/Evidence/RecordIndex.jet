    assert_eq(loaded.budget, jet_cli_record_budget_default())
}

// Independent canonical pure closure; these do not replace the original
// load/publication/retention-transport tests above when #4381 is held.
#Test("record index pure codec round trip preserves saved and authenticated history") {
    root :: record_index_test_root()
    index := jet_cli_record_index_new(root)
    saved :: record_index_test_entry(.Replay, "saved", ".jet/replays/saved", 100, 1, true)
    sensitive := record_index_test_receipt("secret", 9, 2)
    jet_cli_record_entry_with_capture(&sensitive, .Sensitive)
    trust := record_index_test_entry(.Trust, "trust", ".jet/trust/audit", 32, 3, false)
    jet_cli_record_entry_with_links(&trust, [JetCLIRecordLink]{}, [JetCLIRecordLink]{record_index_test_link(.Receipt, "secret")}) ?? panic(err.message)
    rows :: [JetCLIRecordIndexEntry]{saved, sensitive, trust}
    loop row in rows -> jet_cli_record_index_update(&index, row) ?? panic(err.message)
    // Query order is NOT capture order: persistence uses capture order.
    capture_bytes :: jet_cli_record_index_encode(rows) ?? panic(err.message)
    decoded :: jet_cli_record_index_decode(root, capture_bytes, index.budget) ?? panic(err.message)
    assert_eq(jet_cli_record_index_query(decoded, true), jet_cli_record_index_query(index, true))
    assert_eq(jet_cli_record_index_find(decoded, .Receipt, "secret", false), None)
    visible :: jet_cli_record_index_find(decoded, .Trust, "trust", false) ?? panic("trust")
    assert_eq(visible.produced.len(), 0)
    assert_eq(jet_cli_record_index_query(decoded, false).len(), 2)
    assert_eq(jet_cli_record_index_query_kind(decoded, .Replay, false).len(), 1)
    assert_eq(jet_cli_record_index_saved_replays(decoded, record_index_test_identity()), [JetCLIRecordIndexEntry]{saved})
    assert_eq(jet_cli_record_index_next_recorded_sequence(decoded) ?? panic("sequence"), 4)
}
#Test("record index pure update eviction and rejected replacement are transactional") {
    index := jet_cli_record_index_new(record_index_test_root())
    jet_cli_record_index_set_budget(&index, record_index_test_budget(1)) ?? panic(err.message)
    old :: record_index_test_receipt("old", 1, 1)
    jet_cli_record_index_update(&index, old) ?? panic(err.message)
    jet_cli_record_index_update(&index, old) ?? panic("equal duplicate")
    changed := ~old
    changed.size = 2
    record_index_test_error(jet_cli_record_index_update(&index, changed), "record `receipt/old` conflicts with an existing identity")
    record_index_test_error(jet_cli_record_index_replace(&index, changed), "disposable record `receipt/old` exceeds the byte budget and was not retained")
    assert_eq(jet_cli_record_index_query(index, true), [JetCLIRecordIndexEntry]{old})
    new :: record_index_test_receipt("new", 1, 2)
    jet_cli_record_index_update(&index, new) ?? panic(err.message)
    assert_eq(jet_cli_record_index_find(index, .Receipt, "old", true), None)
    assert_eq(jet_cli_record_index_query(index, true), [JetCLIRecordIndexEntry]{new})
    too_large :: record_index_test_receipt("too-large", 2, 3)
    record_index_test_error(jet_cli_record_index_update(&index, too_large), "disposable record `receipt/too-large` exceeds the byte budget and was not retained")
    assert_eq(jet_cli_record_index_query(index, true), [JetCLIRecordIndexEntry]{new})
    maximum := jet_cli_record_index_new(record_index_test_root())
    jet_cli_record_index_update(&maximum, record_index_test_receipt("max", 0, 18446744073709551615)) ?? panic(err.message)
    if jet_cli_record_index_next_recorded_sequence(maximum) == {
        .Ok(_) -> panic("u64 sequence wrapped")
        .Err(error) -> assert_eq(jet_cli_record_index_error_message(error), "recorded_sequence exhausted")
    }
}
#Test("record index pure replay transitions preserve identity sequence and link integrity") {
    index := jet_cli_record_index_new(record_index_test_root())
    replay :: record_index_test_entry(.Replay, "replay", ".jet/replays/replay", 1, 1, false)
    jet_cli_record_index_update(&index, replay) ?? panic(err.message)
