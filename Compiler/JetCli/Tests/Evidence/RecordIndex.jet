    assert_eq(jet_cli_record_index_saved_replays(index, record_index_test_identity()), [JetCLIRecordIndexEntry]{saved})
    unlinked := jet_cli_record_index_new(record_index_test_root())
    jet_cli_record_index_update(&unlinked, replay) ?? panic(err.message)
    removed :: jet_cli_record_index_remove_replay(&unlinked, "replay") ?? panic(err.message)
    assert_eq(removed, replay)
    assert_eq(jet_cli_record_index_query(unlinked, true).len(), 0)
}
#Test("record index optional elapsed age uses the exact strict stale boundary") {
    // Native unavailable/future/error mtime observations each produce None.
    assert(!jet_cli_record_index_lock_stale(None))
    assert(!jet_cli_record_index_lock_stale(Val(0)))
    assert(!jet_cli_record_index_lock_stale(Val(59999999999)))
    assert(!jet_cli_record_index_lock_stale(Val(60000000000)))
    assert(jet_cli_record_index_lock_stale(Val(60000000001)))
    assert(jet_cli_record_index_lock_stale(Val(61000000000)))
}
