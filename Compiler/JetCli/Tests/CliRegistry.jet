// The canonical CLI table's routing laws (crates/jet-cli tests
// no_command_declared_in_both_tables, moved_command_registry_agrees_with_dispatch,
// typo_suggestions_never_advertise_moved_bare_actions,
// self_update_keyless_override_is_registered_for_help_and_completions) and the retired-marker
// explanation (marker_explain_reports_typed_signature_and_retirement), run on the Jet-built CLI.
use {
    jet_cli.[
        JET_CLI_SYNTAX_ROWS, JetCLISyntaxKind, jet_cli_closest_command, jet_cli_command_index,
        jet_cli_completions_bash, jet_cli_completions_fish, jet_cli_completions_powershell,
        jet_cli_completions_zsh, jet_cli_group_usage, jet_cli_handler_index,
        jet_cli_flag_commands, jet_cli_flag_spec, jet_cli_flag_takes, jet_cli_flags_for_command,
        jet_cli_is_canonical_top_level, jet_cli_is_known_flag, jet_cli_man_page, jet_cli_moved_command,
        jet_cli_nested_command, jet_cli_rule_explanation, jet_cli_rule_named, jet_cli_syntax_lookup,
    ]
    jet_foundation.[JET_CLI_COMMANDS, JET_CLI_FLAGS, JET_CLI_HANDLERS, marker_source_read]
}

cli_registry_require: fn(ok: Bool, what: String) Never! {
    if !ok -> panic(what)
}

cli_registry_is_command: fn(name: String) -> Bool Never! { jet_cli_command_index(name) != None }

cli_registry_tables: fn() Never! {
    loop group in JET_CLI_COMMANDS {
        loop action in group.actions {
            handler_index: jet_cli_handler_index(action.handler) ?? panic("action {group.name} {action.name} names an unregistered handler")
            handler: JET_CLI_HANDLERS[handler_index]
            // #1659: a moved-only dispatch word has no second top-level row.
            if !handler.keeps_group && !action.also_canonical_top_level {
                cli_registry_require(!cli_registry_is_command(handler.dispatch_word), "`{handler.dispatch_word}` is declared both as a `{group.name}` nested action and again as a top-level command")
            }
        }
    }
    // `jet inspect bind` and `jet bind` are both canonical.
    bind: jet_cli_nested_command("inspect", "bind") ?? panic("inspect bind is registered")
    cli_registry_require(JET_CLI_COMMANDS[bind.group].actions[bind.action].also_canonical_top_level, "inspect bind is also canonical at the top level")
    cli_registry_require(jet_cli_is_canonical_top_level("bind") && jet_cli_moved_command("bind") == .None, "bare bind is canonical")
}

cli_registry_moved_commands: fn() Never! {
    loop group in JET_CLI_COMMANDS {
        loop action in group.actions {
            if action.also_canonical_top_level || cli_registry_is_command(action.name) {
                cli_registry_require(jet_cli_is_canonical_top_level(action.name), "{action.name} is canonical")
                cli_registry_require(jet_cli_moved_command(action.name) == .None, "{action.name} is not moved")
                next
            }
            cli_registry_require(!jet_cli_is_canonical_top_level(action.name), "moved bare command leaked: {action.name}")
            moved: jet_cli_moved_command(action.name) ?? panic("missing moved owner for {action.name}")
            owner: JET_CLI_COMMANDS[moved.group]
            cli_registry_require(owner.actions[moved.action].name == action.name, "{action.name} moved to the wrong action of {owner.name}")
        }
    }
    // `gc report` is nested only. Retired roots and their teaching are gone
    // (greenfield), so bare `report` is the moved word of that nested action.
    report: jet_cli_nested_command("gc", "report") ?? panic("gc report is registered")
    cli_registry_require(!JET_CLI_COMMANDS[report.group].actions[report.action].also_canonical_top_level, "gc report is not canonical at the top level")
    moved_report: jet_cli_moved_command("report") ?? panic("bare report names its nested owner")
    cli_registry_require(moved_report.group == report.group && moved_report.action == report.action && !jet_cli_is_canonical_top_level("report"), "bare report teaches gc report, not a top-level root")
}

cli_registry_typo_suggestions: fn() Never! {
    loop group in JET_CLI_COMMANDS {
        loop action in group.actions {
            // A canonical top-level row may be suggested by its own name
            // (`env` is canonical even though `inspect env` is nested).
            canonical_top_level: cli_registry_is_command(action.name) && jet_cli_is_canonical_top_level(action.name)
            if action.also_canonical_top_level || canonical_top_level -> next
            cli_registry_require(jet_cli_closest_command(action.name) != .Val(action.name), "typo suggestion advertises moved bare action {action.name}")
        }
    }
    cli_registry_require((jet_cli_closest_command("env") ?? "") == "env", "env is a canonical group")
}

cli_registry_completions: fn() Never! {
    count := 0
    loop flag in JET_CLI_FLAGS {
        if flag.long == "--allow-unofficial" -> count += 1
    }
    cli_registry_require(count == 1, "--allow-unofficial is registered once")
    cli_registry_require(jet_cli_is_known_flag("--allow-unofficial"), "--allow-unofficial is a known flag")
    cli_registry_require(jet_cli_group_usage("self").contains("--allow-unofficial"), "self usage names --allow-unofficial")
    cli_registry_require(jet_cli_man_page().contains("--allow-unofficial"), "the man page names --allow-unofficial")
    // fish declares a long option as `-l <name>`, the other shells as `--<name>`.
    cli_registry_require(jet_cli_completions_bash().contains("--allow-unofficial"), "bash completion lacks --allow-unofficial")
    cli_registry_require(jet_cli_completions_zsh().contains("--allow-unofficial"), "zsh completion lacks --allow-unofficial")
    cli_registry_require(jet_cli_completions_fish().contains("-l allow-unofficial"), "fish completion lacks -l allow-unofficial")
    cli_registry_require(jet_cli_completions_powershell().contains("--allow-unofficial"), "powershell completion lacks --allow-unofficial")
    scripts: [String]{jet_cli_completions_bash(), jet_cli_completions_zsh(), jet_cli_completions_fish(), jet_cli_completions_powershell()}
    loop script in scripts {
        loop command in JET_CLI_COMMANDS {
            if jet_cli_is_canonical_top_level(command.name) {
                cli_registry_require(script.contains(command.name), "completion missing command {command.name}")
            }
            loop action in command.actions {
                cli_registry_require(script.contains(action.name), "completion missing {command.name} {action.name}")
            }
        }
    }
}

// Palette law: flag help is user-facing copy, never planning vocabulary.
cli_registry_flag_copy: fn() Never! {
    words: [String]{"milestone", "requirement", "epoch", "ratified"}
    loop flag in JET_CLI_FLAGS {
        lower: flag.help.to_lower()
        loop word in words -> cli_registry_require(!lower.contains(word), "help for {flag.long} exposes planning term {word}")
    }
}

// #6603: a flag's registry row is the one place that says which commands take
// it; the front's flag check and `jet help <command>` both read it.
cli_registry_flag_scopes: fn() Never! {
    loop flag in JET_CLI_FLAGS {
        commands: jet_cli_flag_commands(flag.help) ?? next
        cli_registry_require(commands.len() > 0, "the scope of {flag.long} names no jet command: {flag.help}")
    }
    check: jet_cli_flag_spec("--check=x") ?? panic("--check is registered")
    cli_registry_require((jet_cli_flag_commands(check.help) ?? [String]{}) == [String]{"fmt", "doc", "split", "fold"}, "--check belongs to fmt, doc, split and fold")
    cli_registry_require(jet_cli_flag_takes(check, "fmt") && !jet_cli_flag_takes(check, "init"), "init does not take --check")
    json: jet_cli_flag_spec("--json") ?? panic("--json is registered")
    cli_registry_require(jet_cli_flag_commands(json.help) == None && jet_cli_flag_takes(json, "init"), "--json goes with every command")
    verbose: jet_cli_flag_spec("--verbose") ?? panic("--verbose is registered")
    cli_registry_require(jet_cli_flag_takes(verbose, "check") && jet_cli_flag_takes(verbose, "explain"), "every `with` clause of --verbose scopes it")
    topic: jet_cli_flag_spec("--topic") ?? panic("--topic is registered")
    cli_registry_require(jet_cli_flag_takes(topic, "inspect") && !jet_cli_flag_takes(topic, "build"), "`inspect digest` scopes --topic to inspect")
    cli_registry_require(jet_cli_flags_for_command("doc").any(row -> row.long == "--check"), "jet help doc lists --check")
}

// Prelude/Markers.jet marker types through the one rule explanation. A
// comment, a variadic last field and a group exercise the reader's shape.
cli_registry_explain_markers: fn() Never! {
    rules: marker_source_read("Pure: struct {{\n    impl Marker {{\n        sites: [.Function, .Method]\n    }}\n}}\n\n// Hidden: struct {{ impl Marker {{ sites: [.Block] }} }}\nInline: struct {{\n    mode: InlineMode{{.Hint}}\n\n    impl Marker {{\n        sites: [.Function, .Method, .Constant]\n    }}\n}}\n\nScope: struct {{\n    effects: [Effect]\n\n    impl Marker {{\n        sites: [.Block]\n        repeatable: true\n    }}\n}}\n\nFast: struct {{\n    impl Marker {{\n        group: #[Inline(.Always)]\n    }}\n}}\n")
    cli_registry_require(rules.len() == 3, "the reader keeps the three rule types and skips the comment and the group")
    pure: jet_cli_rule_named(rules, "Pure") ?? panic("Pure rule row")
    inline: jet_cli_rule_named(rules, "Inline") ?? panic("Inline rule row")
    scope: jet_cli_rule_named(rules, "Scope") ?? panic("Scope rule row")
    inline_explanation: jet_cli_rule_explanation(inline)
    cli_registry_require(inline_explanation.meaning == "`#Inline(mode: InlineMode{{.Hint}})`", "Inline typed signature")
    cli_registry_require(inline_explanation.stage == "rule applicability", "Inline is a rule")
    cli_registry_require((inline_explanation.what ?? "") == "arguments: optional; repeatable: false; attachment sites: [Function, Method, Constant]. Argument declarations: `core.compiler.lang.InlineMode`.", "Inline rule facts")
    pure_explanation: jet_cli_rule_explanation(pure)
    cli_registry_require((pure_explanation.what ?? "") == "arguments: none; repeatable: false; attachment sites: [Function, Method].", "Pure rule facts")
    cli_registry_require((pure_explanation.why ?? "") == "resolution is SiteBound; site-bound authority never becomes ambient policy", "site-bound resolution")
    scope_explanation: jet_cli_rule_explanation(scope)
    cli_registry_require(scope_explanation.meaning == "`#Scope(Effect...)`", "Scope variadic signature")
    cli_registry_require((scope_explanation.what ?? "").starts_with("arguments: required; repeatable: true; attachment sites: [Block]."), "Scope rule facts")
    // The dictionary rows route to the rule row, never to the placeholder.
    names: [String]{"Pure", "#Pure", "Inline"}
    loop name in names {
        index: jet_cli_syntax_lookup(name) ?? panic("{name} is a syntax row")
        cli_registry_require(JET_CLI_SYNTAX_ROWS[index].kind == JetCLISyntaxKind.Marker, "{name} is a marker row")
    }
}

#Test("cli_registry") {
    cli_registry_tables()
    cli_registry_moved_commands()
    cli_registry_typo_suggestions()
    cli_registry_completions()
    cli_registry_flag_copy()
    cli_registry_flag_scopes()
    cli_registry_explain_markers()
}
