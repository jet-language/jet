// Actual Rust reference envelopes, plus the full non-writer fact/truth lookup.
use {
    jet_cli.[
        jet_cli_explain_registration, jet_cli_registration_fact_explanation,
        jet_cli_registration_truth_explanation,
    ]
    jet_foundation.[REGISTRATION_FACT_ROWS, REGISTRATION_TRUTH_ROWS]
}

#Test("registration_explain") {
    expected: "{{\"schema\":\"jet.status/v1\",\"action\":\"explain\",\"ok\":true,\"reports\":[],\"code\":\"Flow\",\"stage\":\"registration table\",\"what\":\"attaches to a value.\",\"why\":\"facts tighten silently in the `gain` direction; loosening one is always written\",\"fix\":\"nothing loosens this row; read it and act on what it says\",\"example\":null}}\n"
    flow: jet_cli_explain_registration("Flow", false, true) ?? panic("registered Flow")
    if flow == {
        .Done(output) -> { if output.stdout != expected || output.stderr != "" || output.exit_code != 0 -> panic("Rust Flow envelope") }
        .Refused(_, _, _, _) | .Diagnostics(_, _, _, _, _) | .Check(_, _, _, _, _, _, _, _, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) | .AuditWrites(_, _, _, _, _) -> panic("Flow is an offline result")
    }
    if jet_cli_explain_registration("flow", false, true) != None -> panic("registration names are case sensitive")
    if jet_cli_explain_registration("not_registered", false, false) != None -> panic("unknown names keep existing dispatch")
    loop index in 0..<REGISTRATION_FACT_ROWS.len() {
        explanation: jet_cli_registration_fact_explanation(index)
        if explanation.code != REGISTRATION_FACT_ROWS[index].name || explanation.stage != "registration table" || explanation.what == None || explanation.why == None || explanation.fix == None -> panic("every fact declaration explains itself")
    }
    loop index in 0..<REGISTRATION_TRUTH_ROWS.len() {
        explanation: jet_cli_registration_truth_explanation(index)
        row: REGISTRATION_TRUTH_ROWS[index]
        if explanation.code != row.name || explanation.what == None || explanation.why == None || explanation.fix == None -> panic("every corpus truth names its home and guard")
    }
}
