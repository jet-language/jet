// Real filesystem transport, assembled with the full canonical compiler unit.
fn run() {
    root :: "{cli_sys.temp_dir()}/jet-build-input-{cli_process.current_pid()}"
    cli_files.create_dir_all("{root}/nested") ?? panic("test root")
    defer cli_files.remove_all(root).drop("test root cleanup")
    cli_files.write("{root}/nested/data.txt", "héllo") ?? panic("test bytes")
    content :: jet_cli_build_read_rooted(root, "nested/data.txt", 6) ?? panic("bounded rooted read")
    assert(content == "héllo".bytes())
    normalized :: jet_cli_build_read_rooted("{root}/.", "./nested//data.txt", 6) ?? panic("normal OS components")
    assert(normalized == content)
    oversized :: jet_cli_build_read_rooted(root, "nested/data.txt", 5)
    assert(oversized == .Err("file exceeds its read bound"))
    empty :: jet_cli_build_read_rooted(root, "./", 6)
    assert(empty == .Err("file authority path is empty"))
    escaped :: jet_cli_build_read_rooted(root, "../data.txt", 6)
    assert(escaped == .Err("file authority path must be relative and normalized"))
    absolute :: jet_cli_build_read_rooted(root, "{root}/nested/data.txt", 6)
    assert(absolute == .Err("file authority path must be relative and normalized"))
    nonregular :: jet_cli_build_read_rooted(root, "nested", 6)
    assert(nonregular == .Err(_))
    missing :: jet_cli_build_read_rooted(root, "absent", 6)
    assert(missing == .Err(_))
    cli_files.symlink("{root}/nested/data.txt", "{root}/linked.txt") ?? panic("test final link")
    final_link :: jet_cli_build_read_rooted(root, "linked.txt", 6)
    assert(final_link == .Err(_))
    cli_files.symlink("{root}/nested", "{root}/alias") ?? panic("test parent link")
    parent_link :: jet_cli_build_read_rooted(root, "alias/data.txt", 6)
    assert(parent_link == .Err(_))
    root_link :: jet_cli_build_read_rooted("{root}/alias", "data.txt", 6)
    assert(root_link == .Err(_))
    cli_files.hard_link("{root}/nested/data.txt", "{root}/duplicate.txt") ?? panic("test hard link")
    hard_link :: jet_cli_build_read_rooted(root, "nested/data.txt", 6)
    assert(hard_link == .Err("file authority input has multiple hard links"))
    // Unrooted file-URL reads share a held no-follow reader but intentionally
    // retain their reference policy permitting regular multi-link files.
    file_url :: JetCLIBuildInputs{}.read("{root}/nested/data.txt", 6) ?? panic("file URL read")
    assert(file_url == content)
    file_url_link :: JetCLIBuildInputs{}.read("{root}/linked.txt", 6)
    assert(file_url_link == .Err("file is not a regular file"))
    file_url_oversized :: JetCLIBuildInputs{}.read("{root}/nested/data.txt", 5)
    assert(file_url_oversized == .Err("file exceeds its read bound"))
}
