// File-leaf parity: tests/source_import.rs fixtures/goldens. Foreign code is never run.
fn import_files_test_enterprise(language: String, raw: String) -> JetCLIImportTranslation Never! {
    jet_cli_import_translate_enterprise_file(language, raw, "input.src", "output.jet")
}
fn import_files_test_todo(todo: JetCLIImportTodo, what: String, why: String, fix: String, source: String) Never! {
    assert_eq(todo.what, what)
    assert_eq(todo.why, why)
    assert_eq(todo.fix, fix)
    assert_eq(todo.source, source)
    assert_eq(todo.target, "output.jet")
    assert_eq(todo.status, "omitted-reported")
}
fn import_files_test_prefix(language: String) -> String Never! {
    "// Generated by jet import {language} (D-MIGRATE-SRC1). Editable Jet source.\n// Source: input.src\n// Provenance: law=D-MIGRATE-SRC1; generated spans remain tied to the source file.\n"
}
fn import_files_test_suffix(language: String) -> String Never! {
    "\n// The {language} source remains the canonical source of truth until every TODO is resolved.\n"
}

// tests/source_import.rs::python_source_import_matches_python_oracle_fixed_corpus;
// fixtures/source_import/corpus.py and corpus.jet, verbatim bytes.
#Test("Python fixed corpus translates byte exactly without foreign execution") {
    raw :: "def add(x: int, y: int) -> int:\n    return x + y\n\ndef decorate(value: str) -> str:\n    return value\n\ndef run() -> None:\n    total = add(2, 5)\n    print(total * 2)\n    print(decorate(\"jet\"))\n"
    expected :: "// Generated by jet import py (D-MIGRATE-SRC1). Editable Jet source.\nfn add(x: Int, y: Int) -> Int {{\n    return x + y\n}}\n\nfn decorate(value: String) -> String {{\n    return ~value\n}}\n\nfn run() {{\n    total := add(2, 5)\n    print(total * 2)\n    print(decorate(\"jet\"))\n}}\n"
    translated :: jet_cli_import_translate_file(raw, "corpus.py", "output.jet")
    assert_eq(translated.source, expected)
    assert_eq(translated.functions, 3)
    assert_eq(translated.tests, 0)
    assert(translated.todos.is_empty())
}
// tests/source_import.rs::python_source_import_translates_real_subset_and_reports_every_gap.
#Test("Python vertical fixture keeps order counts and exact omissions") {
    raw :: "import decimal\n\ndef add(x: int, y: int) -> int:\n    total = x + y\n    return total\n\ndef test_add() -> None:\n    assert add(2, 3) == 5\n\ndef risky(x: int) -> int:\n    if x > 0:\n        return x\n    raise RuntimeError(\"negative\")\n"
    translated :: jet_cli_import_translate_file(raw, "math.py", "output.jet")
    assert_eq(translated.source, "// Generated by jet import py (D-MIGRATE-SRC1). Editable Jet source.\nfn add(x: Int, y: Int) -> Int {{\n    total := x + y\n    return total\n}}\n\n#Test fn test_add() {{\n    assert_eq(add(2, 3), 5)\n}}\n")
    assert_eq(translated.functions, 2)
    assert_eq(translated.tests, 1)
    assert_eq(translated.todos.len(), 2)
    _ :: import_files_test_todo(translated.todos[0], "unsupported Python top-level construct 'import decimal'", "first Python importer translates annotated functions only", "port construct into ordinary Jet; no source was silently emitted", "math.py:1")
    _ :: import_files_test_todo(translated.todos[1], "Python body 'risky' was not translated", "nested control flow has no proven equivalent in this importer", "port body into ordinary Jet; source remains in omissions report", "math.py:11")
}
#Test("Python rejected signature consumes its body and resumes at next top level") {
    translated :: jet_cli_import_translate_file("def bad(x):\n    return x\n\ndef answer() -> int:\n    return 42\n", "input.py", "output.jet")
    assert_eq(translated.functions, 1)
    assert_eq(translated.todos.len(), 1)
    _ :: import_files_test_todo(translated.todos[0], "Python function signature at line 1 is not type-safe", "function needs a return annotation", "add supported parameter and return annotations, then rerun import", "input.py:1")
    assert(translated.source.contains("fn answer() -> Int {{\n    return 42\n}}\n"))
}
#Test("Python empty body attributes line one even for a later header") {
    translated :: jet_cli_import_translate_file("# comment\n\ndef empty() -> None:\n\n# done\n", "input.py", "output.jet")
    assert_eq(translated.functions, 0)
    assert_eq(translated.todos.len(), 1)
    _ :: import_files_test_todo(translated.todos[0], "Python body 'empty' was not translated", "function body is empty", "port body into ordinary Jet; source remains in omissions report", "input.py:1")
    assert_eq(translated.source, "// Generated by jet import py (D-MIGRATE-SRC1). Editable Jet source.\n// No construct was safe to translate. See import-report.json.\n")
}
#Test("Python only parameterless test prefix carries tests and duplicates remain Python behavior") {
    translated :: jet_cli_import_translate_file("def test_one() -> None:\n    pass\ndef test_one(x: int) -> int:\n    return x\n", "input.py", "output.jet")
    assert_eq(translated.functions, 2)
    assert_eq(translated.tests, 1)
    assert(translated.todos.is_empty())
    assert(translated.source.contains("#Test fn test_one() {{\n}}\n\nfn test_one(x: Int) -> Int"))
}
#Test("Python top-level indentation and Unicode shortening are scalar exact") {
    long :: "é".repeat(49)
    translated :: jet_cli_import_translate_file("  def nested() -> None:\n{long}\n", "é.py", "output.jet")
    assert_eq(translated.todos.len(), 2)
    assert_eq(translated.todos[0].source, "é.py:1")
    assert_eq(translated.todos[1].what, "unsupported Python top-level construct '{"é".repeat(48)}...'")
}

// tests/source_import.rs Pascal/Ada fixtures; their old 'Generated' assertion is
// stale against Rust binder_header (1964): current bytes intentionally say Prepared.
#Test("Pascal fixture is binder-only and omission metadata is byte exact") {
    raw :: "library inventory;\nfunction add_scalar(A, B: Int64): Int64; cdecl;\nbegin Result := A + B; end;\nexports add_scalar;\nbegin end.\n"
    translated :: jet_cli_import_translate_pascal_file(raw, "inventory.pas", "output.jet")
    assert_eq(translated.source, "// Prepared by jet import pascal (D-MIGRATE-SRC1). Binder-only/manual migration; semantic source conversion is unavailable.\n// Source: inventory.pas\nuse pascal.inventory as inventory\n\n// Binder stub: use pascal.inventory as inventory\n// TODO JT0101: Pascal library `inventory` remains an FFI source.\n// The Pascal source remains the canonical source of truth.\n")
    assert_eq(translated.functions, 0)
    assert_eq(translated.tests, 0)
    assert_eq(translated.todos.len(), 1)
    _ :: import_files_test_todo(translated.todos[0], "Pascal library `inventory` was not translated", "Object Pascal bodies, classes, and runtime ownership have no proven source-to-Jet mapping; the original source remains authoritative", "run `jet inspect bind pascal inventory.pas --pkg inventory` for call-in-place bindings, then port unsupported bodies explicitly", "inventory.pas:1")
}
#Test("Ada fixture is binder-only and omission metadata is byte exact") {
    raw :: "with Interfaces.C;\npackage Geodesy is\n   subtype Latitude is Interfaces.C.double range -90.0 .. 90.0;\n   function Double_Lat (Lat : Latitude) return Interfaces.C.double\n     with Export, Convention => C, External_Name => \"geo_double\";\nend Geodesy;\n"
    translated :: jet_cli_import_translate_ada_file(raw, "geodesy.ads", "output.jet")
    assert_eq(translated.source, "// Prepared by jet import ada (D-MIGRATE-SRC1). Binder-only/manual migration; semantic source conversion is unavailable.\n// Source: geodesy.ads\nuse ada.geodesy as geodesy\n\n// Binder stub: use ada.geodesy as geodesy\n// TODO JT0101: Ada package `geodesy` remains an FFI source.\n// The Ada source remains the canonical source of truth.\n")
    assert_eq(translated.functions, 0)
    assert_eq(translated.tests, 0)
    assert_eq(translated.todos.len(), 1)
    _ :: import_files_test_todo(translated.todos[0], "Ada package `geodesy` was not translated", "Ada bodies, range checks, exceptions, tasking, and representation clauses have no proven source-to-Jet mapping; the original package spec and body remain authoritative", "run `jet inspect bind ada geodesy.ads --pkg geodesy` for call-in-place bindings, then port unsupported bodies explicitly", "geodesy.ads:1")
}
#Test("Binder missing declarations never guess executable bodies") {
    pascal :: jet_cli_import_translate_pascal_file("unit inventory;", "source.pas", "output.jet")
    ada :: jet_cli_import_translate_ada_file("package body Geodesy is begin null; end Geodesy;\n", "source.adb", "output.jet")
    assert_eq(pascal.source, "// Prepared by jet import pascal (D-MIGRATE-SRC1). Binder-only/manual migration; semantic source conversion is unavailable.\n// Source: source.pas\n// TODO JT0101: Pascal source has no recognizable library declaration.\n// The Pascal source remains the canonical source of truth.\n")
    assert_eq(ada.source, "// Prepared by jet import ada (D-MIGRATE-SRC1). Binder-only/manual migration; semantic source conversion is unavailable.\n// Source: source.adb\n// TODO JT0101: Ada source has no recognizable package declaration.\n// The Ada source remains the canonical source of truth.\n")
    _ :: import_files_test_todo(pascal.todos[0], "Pascal source has no recognizable library declaration", "the importer cannot establish a library boundary or ABI contract", "add a Pascal `library` declaration or use a hand-written Jet FFI overlay; no source was silently emitted", "source.pas:1")
    _ :: import_files_test_todo(ada.todos[0], "Ada source has no recognizable package declaration", "the importer cannot establish a library boundary or ABI contract", "add a top-level Ada `package` declaration or use a hand-written Jet FFI overlay; no source was silently emitted", "source.adb:1")
}

// tests/source_import.rs::enterprise_importers_match_scalar_behavior_fixtures...
// fixtures/source_import/enterprise/{java,csharp,ts,js,go}, verbatim source.
#Test("Java scalar fixture emits complete byte exact projection") {
    raw :: "package demo;\n\npublic final class Math {{\n    public static long add(long left, long right) {{\n        long total = left + right;\n        return total;\n    }}\n\n    public static void run() {{\n        System.out.println(add(2, 3));\n    }}\n\n    public static long unsupported(long[] values) {{\n        return values.length;\n    }}\n}}\n"
    translated :: import_files_test_enterprise("java", raw)
    assert_eq(translated.source, "{import_files_test_prefix("java")}\n// Source span: input.src:4-7\nfn add(left: Int, right: Int) -> Int {{\n    total := left + right\n    return total\n}}\n// Source span: input.src:9-11\nfn run() {{\n    print(add(2, 3))\n}}\n{import_files_test_suffix("java")}")
    assert_eq(translated.functions, 2)
    assert_eq(translated.tests, 0)
    assert_eq(translated.todos.len(), 1)
    _ :: import_files_test_todo(translated.todos[0], "unsupported java function declaration", "foreign type `long[]` is outside the scalar importer subset", "use the supported scalar function subset or port the declaration explicitly", "input.src:13")
}
#Test("Csharp scalar fixture canonicalizes names and ignores System only") {
    raw :: "using System;\n\nnamespace Demo {{\n    public static class Math {{\n        public static long Add(long left, long right) {{\n            long total = left + right;\n            return total;\n        }}\n\n        public static void run() {{\n            Console.WriteLine(Add(2, 3));\n        }}\n\n        public static long Unsupported(long[] values) {{\n            return values.Length;\n        }}\n    }}\n}}\n"
    translated :: import_files_test_enterprise("csharp", raw)
    assert_eq(translated.source, "{import_files_test_prefix("csharp")}\n// Source span: input.src:5-8\nfn add(left: Int, right: Int) -> Int {{\n    total := left + right\n    return total\n}}\n// Source span: input.src:10-12\nfn run() {{\n    print(add(2, 3))\n}}\n{import_files_test_suffix("csharp")}")
    assert_eq(translated.functions, 2)
    assert_eq(translated.todos.len(), 1)
    assert_eq(translated.todos[0].source, "input.src:14")
    assert_eq(translated.todos[0].why, "foreign type `long[]` is outside the scalar importer subset")
}
#Test("TypeScript scalar fixture forces float literals including unit run") {
    raw :: "export function add(left: number, right: number): number {{\n    const total = left + right;\n    return total;\n}}\n\nexport function run(): void {{\n    console.log(add(2, 3));\n}}\n\nexport function unsupported(values: number[]): number {{\n    return values.length;\n}}\n"
    translated :: import_files_test_enterprise("ts", raw)
    assert_eq(translated.source, "{import_files_test_prefix("ts")}\n// Source span: input.src:1-4\nfn add(left: Float, right: Float) -> Float {{\n    total := left + right\n    return total\n}}\n// Source span: input.src:6-8\nfn run() {{\n    print(add(2.0, 3.0))\n}}\n{import_files_test_suffix("ts")}")
    assert_eq(translated.functions, 2)
    assert_eq(translated.todos.len(), 1)
    assert_eq(translated.todos[0].source, "input.src:10")
    assert_eq(translated.todos[0].why, "foreign type `number[]` is outside the scalar importer subset")
}
#Test("JavaScript scalar fixture JSDoc inference precedes body and duplicate analysis") {
    raw :: "/**\n * @param {{number}} left\n * @param {{number}} right\n * @returns {{number}}\n */\nfunction add(left, right) {{\n    return left + right;\n}}\n\n/** @returns {{void}} */\nfunction run() {{\n    console.log(add(2, 3));\n}}\n\n/**\n * @param {{object}} values\n * @returns {{number}}\n */\nfunction unsupported(values) {{\n    return values.length;\n}}\n"
    translated :: import_files_test_enterprise("js", raw)
    assert_eq(translated.source, "{import_files_test_prefix("js")}\n// Source span: input.src:6-8\nfn add(left: Float, right: Float) -> Float {{\n    return left + right\n}}\n// Source span: input.src:11-13\nfn run() {{\n    print(add(2, 3))\n}}\n{import_files_test_suffix("js")}")
    assert_eq(translated.functions, 2)
    assert_eq(translated.todos.len(), 1)
    _ :: import_files_test_todo(translated.todos[0], "JavaScript function `unsupported` was not translated", "JavaScript JSDoc type `object` has no proven Jet mapping", "add a supported scalar JSDoc type or port the function explicitly", "input.src:19")
}
#Test("Go scalar fixture honors supported fmt import and source span ordering") {
    raw :: "package demo\n\nimport \"fmt\"\n\nfunc Add(left int, right int) int {{\n    total := left + right\n    return total\n}}\n\nfunc run() {{\n    fmt.Println(Add(2, 3))\n}}\n\nfunc Unsupported(values []int) int {{\n    return len(values)\n}}\n"
    translated :: import_files_test_enterprise("go", raw)
    assert_eq(translated.source, "{import_files_test_prefix("go")}\n// Source span: input.src:5-8\nfn add(left: Int, right: Int) -> Int {{\n    total := left + right\n    return total\n}}\n// Source span: input.src:10-12\nfn run() {{\n    print(add(2, 3))\n}}\n{import_files_test_suffix("go")}")
    assert_eq(translated.functions, 2)
    assert_eq(translated.todos.len(), 1)
    assert_eq(translated.todos[0].source, "input.src:14")
    assert_eq(translated.todos[0].why, "foreign type `[]int` is outside the scalar importer subset")
}
// fixtures/source_import/enterprise/failures/ambiguous.java.
#Test("Java ambiguity malformed body division and dependencies are ordered omissions") {
    raw :: "package demo;\nimport other.Library;\n\npublic final class Ambiguous {{\n    public static long keep(long value) {{\n        return value;\n    }}\n\n    public static long add(long value) {{\n        return value;\n    }}\n\n    public static long add(long left, long right) {{\n        return left + right;\n    }}\n\n    public static long quotient(long left, long right) {{\n        return left / right;\n    }}\n\n    public static long broken(long value) {{\n        return value;\n"
    translated :: import_files_test_enterprise("java", raw)
    assert_eq(translated.functions, 1)
    assert_eq(translated.todos.len(), 5)
    assert_eq(translated.source, "{import_files_test_prefix("java")}\n// Source span: input.src:5-7\nfn keep(value: Int) -> Int {{\n    return value\n}}\n{import_files_test_suffix("java")}")
    assert_eq(translated.todos[0].what, "unsupported java dependency declaration")
    assert_eq(translated.todos[0].source, "input.src:2")
    assert_eq(translated.todos[1].what, "ambiguous overloaded java function `add`")
    assert_eq(translated.todos[1].source, "input.src:13")
    assert_eq(translated.todos[2].what, "java body `quotient` was not translated")
    assert_eq(translated.todos[2].source, "input.src:18")
    assert_eq(translated.todos[2].why, "foreign division or remainder semantics need an explicit migration adapter")
    assert_eq(translated.todos[3].what, "malformed java function at line 21")
    assert_eq(translated.todos[3].why, "function body has unmatched braces")
    assert_eq(translated.todos[4].what, "unsupported java top-level construct `return value;`")
    assert_eq(translated.todos[4].source, "input.src:22")
}
// fixtures/source_import/enterprise/failures/partial.ts.
#Test("TypeScript partial failure removes earlier duplicate without disturbing kept order") {
    raw :: "import {{ readFile }} from \"node:fs\";\n\nexport function keep(value: number): number {{\n    const increment = value + 1;\n    return increment;\n}}\n\nexport function unsupported(values: number[]): number {{\n    return values.length;\n}}\n\nexport function broken(value: number): number {{\n    return value + ;\n}}\n\nexport function duplicate(value: number): number {{\n    return value;\n}}\n\nexport function duplicate(other: number): number {{\n    return other;\n}}\n"
    translated :: import_files_test_enterprise("ts", raw)
    assert_eq(translated.functions, 1)
    assert_eq(translated.tests, 0)
    assert_eq(translated.todos.len(), 4)
    assert_eq(translated.source, "{import_files_test_prefix("ts")}\n// Source span: input.src:3-6\nfn keep(value: Float) -> Float {{\n    increment := value + 1.0\n    return increment\n}}\n{import_files_test_suffix("ts")}")
    assert_eq(translated.todos[0].source, "input.src:1")
    assert_eq(translated.todos[1].source, "input.src:8")
    assert_eq(translated.todos[2].source, "input.src:13")
    assert_eq(translated.todos[2].why, "incomplete expression")
    assert_eq(translated.todos[3].source, "input.src:20")
    assert_eq(translated.todos[3].what, "ambiguous overloaded ts function `duplicate`")
}
#Test("JS string label fixture does not rewrite source names inside strings") {
    translated :: import_files_test_enterprise("js", "/** @returns {{string}} */\nfunction label() {{\n    return \"console.log(\";\n}}\n")
    assert_eq(translated.source, "{import_files_test_prefix("js")}\n// Source span: input.src:2-4\nfn label() -> String {{\n    return \"console.log(\"\n}}\n{import_files_test_suffix("js")}")
    assert_eq(translated.functions, 1)
    assert(translated.todos.is_empty())
}
#Test("Canonical duplicates revoke test count and never resurrect on third declaration") {
    translated :: import_files_test_enterprise("go", "package demo\nfunc test_One() {{}}\nfunc test_one() {{}}\nfunc test_one() {{}}\n")
    assert_eq(translated.functions, 0)
    assert_eq(translated.tests, 0)
    assert_eq(translated.todos.len(), 2)
    assert_eq(translated.source, "{import_files_test_prefix("go")}use go.demo as demo\n\n// Binder fallback: use go.demo as demo\n// No construct was safe to translate. See import-report.json.\n{import_files_test_suffix("go")}")
    assert_eq(translated.todos[0].source, "input.src:3")
    assert_eq(translated.todos[1].source, "input.src:4")
}
#Test("Failed bodies reserve canonical names but bad signatures and JS inference do not") {
    failed :: import_files_test_enterprise("go", "func Bad() int {{ return 1 / 2 }}\nfunc bad() int {{ return 3 }}\n")
    assert_eq(failed.functions, 0)
    assert_eq(failed.todos.len(), 2)
    assert_eq(failed.todos[1].what, "ambiguous overloaded go function `bad`")
    invalid :: import_files_test_enterprise("go", "func Bad(x []int) int {{ return 1 }}\nfunc bad() int {{ return 3 }}\n")
    assert_eq(invalid.functions, 1)
    assert_eq(invalid.todos.len(), 1)
    inferred :: import_files_test_enterprise("js", "function bad(x) {{ return x }}\nfunction bad() {{ return 3 }}\n")
    assert_eq(inferred.functions, 1)
    assert_eq(inferred.todos.len(), 1)
    assert_eq(inferred.todos[0].why, "JavaScript value type is ambiguous")
}
#Test("Next-line brace join includes opening span and expression arrows stay on header") {
    translated :: import_files_test_enterprise("ts", "function add(x: number): number\n{{\n return x + 1;\n}}\nconst next = (x: number): number => x + 2;\nconst block = (x: number): number =>\n{{\n return x + 3;\n}}\n")
    assert_eq(translated.functions, 3)
    assert(translated.todos.is_empty())
    assert_eq(translated.source, "{import_files_test_prefix("ts")}\n// Source span: input.src:1-4\nfn add(x: Float) -> Float {{\n    return x + 1.0\n}}\n// Source span: input.src:5-5\nfn next(x: Float) -> Float {{\n    x + 2.0\n}}\n// Source span: input.src:6-9\nfn block(x: Float) -> Float {{\n    return x + 3.0\n}}\n{import_files_test_suffix("ts")}")
}
#Test("Expression header is not joined to following standalone brace") {
    translated :: import_files_test_enterprise("ts", "const value = (): number => 7;\n{{\n}}\n")
    assert_eq(translated.functions, 1)
    assert(translated.todos.is_empty())
    assert(translated.source.contains("// Source span: input.src:1-1\nfn value() -> Float {{\n    7.0\n}}\n"))
}
#Test("Bad header consumes closed body and preserves next function") {
    translated :: import_files_test_enterprise("java", "public long nope() {{\n forbidden();\n}}\npublic static int keep() {{ return 1; }}\n")
    assert_eq(translated.functions, 1)
    assert_eq(translated.todos.len(), 1)
    _ :: import_files_test_todo(translated.todos[0], "unsupported java function declaration", "only static Java/C# methods have a proven source-to-Jet mapping", "use the supported scalar function subset or port the declaration explicitly", "input.src:1")
    assert(translated.source.contains("// Source span: input.src:4-4"))
}
#Test("Enterprise hostile constructs never run and all omissions have exact source attribution") {
    translated :: import_files_test_enterprise("go", "package demo\nimport \"os\"\nstate := runMalicious()\nfunc evil() {{\n go eraseDisk();\n}}\n")
    assert_eq(translated.functions, 0)
    assert_eq(translated.todos.len(), 3)
    _ :: import_files_test_todo(translated.todos[0], "unsupported go dependency declaration", "the importer does not execute or infer foreign dependency behavior", "bind the dependency with `jet inspect bind go` or port it explicitly before rerunning import", "input.src:2")
    _ :: import_files_test_todo(translated.todos[1], "unsupported go top-level construct `state := runMalicious()`", "the importer only emits proven scalar functions and does not model foreign runtime state", "port the construct into ordinary Jet or keep it behind the language binder", "input.src:3")
    _ :: import_files_test_todo(translated.todos[2], "go body `evil` was not translated", "control flow, exceptions, and foreign runtime operations have no proven mapping in this importer", "port the body into ordinary Jet; the original source remains authoritative", "input.src:5")
    assert(!translated.source.contains("erase"))
}
#Test("Binder-only enterprise fallback roots and absent unit bytes") {
    cases :: [(language: String, raw: String, root: String, unit: String)]{
        (language: "java", raw: "package one.demo;\n", root: "java", unit: "demo"),
        (language: "csharp", raw: "namespace One.Demo {{\n}}\n", root: "cs", unit: "Demo"),
        (language: "ts", raw: "", root: "js", unit: "input"),
        (language: "js", raw: "", root: "js", unit: "input"),
        (language: "go", raw: "package demo\n", root: "go", unit: "demo")
    }
    loop row in cases {
        translated :: import_files_test_enterprise(row.language, row.raw)
        assert_eq(translated.functions, 0)
        assert_eq(translated.tests, 0)
        assert(translated.todos.is_empty())
        assert_eq(translated.source, "{import_files_test_prefix(row.language)}use {row.root}.{row.unit} as {row.unit}\n\n// Binder fallback: use {row.root}.{row.unit} as {row.unit}\n// No construct was safe to translate. See import-report.json.\n{import_files_test_suffix(row.language)}")
    }
    no_unit :: import_files_test_enterprise("java", "// no package\n")
    assert_eq(no_unit.source, "{import_files_test_prefix("java")}// No construct was safe to translate. See import-report.json.\n{import_files_test_suffix("java")}")
}
#Test("LF CRLF and terminal bare CR produce identical trimmed file translation") {
    lf :: jet_cli_import_translate_file("def one() -> int:\n    return 1\n", "input.py", "output.jet")
    cr :: String.from_bytes([U8]{13}) ?? panic("CR")
    crlf :: jet_cli_import_translate_file("def one() -> int:{cr}\n    return 1{cr}\n", "input.py", "output.jet")
    bare :: jet_cli_import_translate_file("def one() -> int:\n    return 1{cr}", "input.py", "output.jet")
    assert_eq(lf.source, crlf.source)
    assert_eq(lf.source, bare.source)
    assert_eq(crlf.functions, 1)
    assert_eq(bare.functions, 1)
}
