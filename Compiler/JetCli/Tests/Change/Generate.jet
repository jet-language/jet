    if jet_cli_generate_plan_outputs(fact, paths, [String: [U8]]{}, "toolchain") == {
        .Ok(_) -> panic("missing output accepted")
        .Err(error) -> assert_eq(error.message, "generator did not produce declared output `missing.jet`")
    }
}
#Test("generate native output planning preserves ownership and detects external edits") {
    directory :: generate_fixture_files.temp_dir("jet-generate-output") ?? panic("fixture")
    fact :: generate_test_fact()
    path :: generate_test_native_path("{directory.path}/out.jet")
    tree :: [String: [U8]]{"out.jet": "fn run() {}\n".bytes()}
    first :: jet_cli_generate_plan_outputs(fact, [JetCLIGenerateOutputPath]{JetCLIGenerateOutputPath{path: "out.jet", absolute: path}}, tree, "toolchain") ?? panic("plan absent")
    assert_eq(first[0].before, None)
    generate_fixture_files.write_bytes("{directory.path}/out.jet", first[0].after) ?? panic("publish fixture")
    second :: jet_cli_generate_plan_outputs(fact, [JetCLIGenerateOutputPath]{JetCLIGenerateOutputPath{path: "out.jet", absolute: path}}, tree, "toolchain") ?? panic("plan owned")
    assert(!jet_cli_generate_output_is_changed(second[0]))
    generate_fixture_files.write("{directory.path}/out.jet", "user source") ?? panic("external edit")
    if jet_cli_generate_plan_outputs(fact, [JetCLIGenerateOutputPath]{JetCLIGenerateOutputPath{path: "out.jet", absolute: path}}, tree, "toolchain") == {
        .Ok(_) -> panic("unattributed collision accepted")
        .Err(error) -> assert_eq(error.message, "refusing collision with existing source output `out.jet`; the file is not attributed to this generator")
    }
}
#Test("generate generated input current validates header output and body") {
    directory :: generate_fixture_files.temp_dir("jet-generate-input") ?? panic("fixture")
    path :: generate_test_native_path("{directory.path}/out.jet")
    bytes :: jet_cli_generate_generated_source(generate_test_fact(), "out.jet", "body".bytes(), "toolchain")
    generate_fixture_files.write_bytes("{directory.path}/out.jet", bytes) ?? panic("generated input")
    _ :: jet_cli_generate_ensure_generated_input_current(path, "out.jet") ?? panic("current")
    if jet_cli_generate_ensure_generated_input_current(path, "other.jet") == {
        .Ok(_) -> panic("mismatched input accepted")
        .Err(error) -> assert_eq(error.message, "generated input `other.jet` has a mismatched provenance output")
    }
    edited := bytes
    &edited.push(U8{32})
    generate_fixture_files.write_bytes("{directory.path}/out.jet", edited) ?? panic("edited")
    if jet_cli_generate_ensure_generated_input_current(path, "out.jet") == {
        .Ok(_) -> panic("edited input accepted")
        .Err(error) -> assert_eq(error.message, "stale generated input `out.jet` was edited outside its generator; regenerate it first")
    }
    generate_fixture_files.write("{directory.path}/out.jet", "{GENERATE_HEADER}\n// generator=make_sources\n") ?? panic("incomplete")
    if jet_cli_generate_ensure_generated_input_current(path, "out.jet") == {
        .Ok(_) -> panic("incomplete input accepted")
        .Err(error) -> assert_eq(error.message, "generated input `out.jet` has an incomplete provenance header")
    }
    generate_fixture_files.write("{directory.path}/out.jet", "authored input") ?? panic("authored")
    _ :: jet_cli_generate_ensure_generated_input_current(path, "out.jet") ?? panic("authored input allowed")
}
