// Rust envelope and byte-offset facts captured in SolCLI9/policy-capture.
use {
    jet_foundation.[PolicyDeclaration, PolicyKey, PolicyValue, PolicyScope, PolicySourceText, Span, diagnostic_source_text]
    jet_cli.[
        jet_cli_explain_marker_offset, jet_cli_explain_marker_site, jet_cli_explain_policy_lookup,
        jet_cli_explanation_output,
    ]
}
#Test("policy_explain") {
 site: jet_cli_explain_marker_site("C:/project/source.jet:+0005") ?? panic("usize grammar")
 if site.file != "C:/project/source.jet" || site.line != (U64{5}) -> panic("split the last colon without narrowing usize")
 max: jet_cli_explain_marker_site("source.jet:18446744073709551615") ?? panic("maximum usize")
 if max.line != U64.MAX -> panic("retain maximum line")
 loop text in ([String]{"source.jet", "source.jet:", "source.jet:0", "source.jet:-1", "source.jet:1_0", "source.jet:18446744073709551616"}) {
 if jet_cli_explain_marker_site(text) == .Ok(_) -> panic("invalid marker-site grammar")
 }
 source: "é\nsecond\nthird"
 if jet_cli_explain_marker_offset(source, U64{1}) != 0 || jet_cli_explain_marker_offset(source, U64{2}) != 3 || jet_cli_explain_marker_offset(source, U64{3}) != 10 || jet_cli_explain_marker_offset(source, U64.MAX) != source.bytes().len() -> panic("offsets are UTF-8 bytes; beyond last line is EOF")
 declaration: PolicyDeclaration{key: PolicyKey.Copies, value: PolicyValue.Explicit, scope: PolicyScope.Module, span: Span{start: 7, end: 33}, target: None, source: "policy.jet"}
 sources: [PolicySourceText]{PolicySourceText{path: "policy.jet", text: diagnostic_source_text("// top\n#Policy(copies: .Explicit)\n")}}
 explanation: jet_cli_explain_policy_lookup(PolicyKey.Copies, [PolicyDeclaration]{declaration}, sources) ?? panic("effective copies")
 expected: "{{\"schema\":\"jet.status/v1\",\"action\":\"explain\",\"ok\":true,\"reports\":[],\"code\":\"copies\",\"stage\":\"policy\",\"what\":\"copies = .Explicit\\n  [effective] module .Explicit at policy.jet:2:1\",\"why\":\"the nearest applicable declaration wins subject to the registry's tightening and conflict rules\",\"fix\":\"change the nearest declaration, or remove it to inherit the next outer value\",\"example\":null}}\n"
 if jet_cli_explanation_output(explanation, false, true) == {
 .Done(output) -> { if output.stdout != expected || output.stderr != "" || output.exit_code != 0 -> panic("exact Rust policy envelope") }
 .Refused(_, _, _, _) | .Diagnostics(_, _, _, _, _) | .Check(_, _, _, _, _, _, _, _, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) | .AuditWrites(_, _, _, _, _) -> panic("policy projection is a renderable")
 }
 if jet_cli_explain_policy_lookup(PolicyKey.Unsafe, [PolicyDeclaration]{declaration}, sources) != None -> panic("no effective writer")
 if jet_cli_explain_policy_lookup(PolicyKey.Copies, [PolicyDeclaration]{declaration, declaration}, sources) != None -> panic("resolver conflicts remain no-effective-declaration")
}
