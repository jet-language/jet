// Assemble separately with the production CLI leaves; do not scan the checkout.
use jet_cli.[jet_cli_case_fixture, jet_cli_new_ui_source]

maintenance_require: fn(ok: Bool, label: String) Never! {
    if !ok -> panic("self maintenance contract: {label}")
}

#Test("self_maintenance") {
    maintenance_require((jet_cli_case_fixture("fixture: run_case.fixture") ?? "") == "run_case.fixture", "bare fixture word")
    maintenance_require((jet_cli_case_fixture("fixture: \"fixtures/quoted\" # why it moved") ?? "") == "fixtures/quoted", "quoted word and reason")
    maintenance_require((jet_cli_case_fixture("  fixture: 'single'") ?? "") == "single", "indented single-quoted word")
    maintenance_require(jet_cli_case_fixture("fixture: {{work}}/dir") == None, "templated word")
    maintenance_require(jet_cli_case_fixture("fixture:") == None, "empty word")
    maintenance_require(jet_cli_case_fixture("fixture: two words") == None, "two words")
    maintenance_require(jet_cli_case_fixture("# fixture: commented") == None, "comment line")
    maintenance_require(jet_cli_case_fixture("step: jet run fixture: x") == None, "other directive")
    maintenance_require(jet_cli_new_ui_source() == "// TODO: describe what this diagnostic demonstrates.\nrun: fn() {{\n    print(definitely_undefined_scaffold_symbol)\n}}\n", "exact diagnostic fixture source")
}
