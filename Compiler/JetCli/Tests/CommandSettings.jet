// Remembered flags (#6606): setting keys come from the flag registry, a
// setting writes its flag's words, a later layer and a typed flag win, and
// every problem of every layer is reported at once. A layer's source is a
// plain name here; CommandLayers.jet's tests read the settings files.
use {
    setting_files: core.files
    core.encoding.[Dyn]
    jet_cli.[
        JetCLICommandSetting, JetCLICommandSettingLayer,
        jet_cli_command_settings_output, jet_cli_command_settings_words, jet_cli_flag_spec,
        jet_cli_setting_command_path, jet_cli_setting_commands, jet_cli_setting_flag_name,
        jet_cli_setting_keys, jet_cli_setting_typed,
    ]
    jet_foundation.[Diagnostic, JET_CLI_FLAGS, JetCLIFlagValue, jet_cli_flag_typed_reason]
}

command_setting_on: fn(key: String, on: Bool, line: Int) -> JetCLICommandSetting Never! {
    JetCLICommandSetting{key: key, value: Dyn.Bool(on), line: line}
}

command_setting_text: fn(key: String, text: String, line: Int) -> JetCLICommandSetting Never! {
    JetCLICommandSetting{key: key, value: Dyn.Text(text.copy()), line: line} // copy: the caller keeps its text.
}

command_setting_items: fn(key: String, items: [String], line: Int) -> JetCLICommandSetting Never! {
    values := [Dyn]{}
    loop item in items -> values.push(Dyn.Text(item.copy())) // copy: the caller keeps its items.
    JetCLICommandSetting{key: key, value: Dyn.Array(values), line: line}
}

command_setting_layer: fn(source: String, settings: [JetCLICommandSetting]) -> JetCLICommandSettingLayer Never! {
    JetCLICommandSettingLayer{source: source, settings: settings}
}

// The words the layers add to `word`'s command line; a refusal fails the test.
command_setting_words: fn(word: String, written: [String], layers: [JetCLICommandSettingLayer]) -> [String] Never! {
    if jet_cli_command_settings_words(word, written, layers) == {
        .Words(words) -> words
        .Refused(reports) -> panic("the layers were refused with {reports.len()} reports: {reports[0].what}")
    }
}

// The reports the layers are refused with; words fail the test.
command_setting_refused: fn(word: String, layers: [JetCLICommandSettingLayer]) -> [Diagnostic] Never! {
    if jet_cli_command_settings_words(word, [String]{}, layers) == {
        .Words(words) -> panic("the layers were not refused: {words.join(" ")}")
        .Refused(reports) -> reports
    }
}

#Test("a setting key is the command's dispatch form and the flag without its dashes") {
    assert_eq(jet_cli_setting_flag_name("--no-sign"), "no_sign")
    assert_eq(jet_cli_setting_flag_name("-p"), "p")
    assert_eq(jet_cli_setting_command_path("publish"), "registry.publish")
    assert_eq(jet_cli_setting_command_path("fmt"), "fmt")
    keys: jet_cli_setting_keys(jet_cli_setting_commands())
    assert(keys.contains("fmt.check"))
    assert(keys.contains("registry.publish.no_sign"))
    assert(keys.contains("test.serial"))
    assert(keys.contains("run.p"))
    // A flag every command takes has a key under each command.
    assert(keys.contains("run.color") && keys.contains("fmt.color"))
    // A short form shares its long flag's key, and an unbuilt form has none.
    assert(!keys.contains("test.u") && keys.contains("test.update_snapshots"))
    assert(!keys.contains("run.watch"))
}

#Test("a setting writes its flag the way the flag is typed") {
    on: [String]{}
    layer: command_setting_layer("settings", [JetCLICommandSetting]{
        command_setting_text("run.p", "server", 1),
        command_setting_items("run.deny", [String]{"Net", "FS"}, 2),
        command_setting_text("run.color", "never", 3),
    })
    assert_eq(command_setting_words("run", on, [JetCLICommandSettingLayer]{layer}), [String]{"-p", "server", "--deny=Net", "--deny=FS", "--color=never"})
    assert_eq(command_setting_words("fmt", on, [JetCLICommandSettingLayer]{command_setting_layer("settings", [JetCLICommandSetting]{command_setting_on("fmt.check", true, 1)})}), [String]{"--check"})
    assert_eq(command_setting_words("fmt", on, [JetCLICommandSettingLayer]{command_setting_layer("settings", [JetCLICommandSetting]{command_setting_on("fmt.check", false, 1)})}), [String]{})
    assert_eq(command_setting_words("test", on, [JetCLICommandSettingLayer]{command_setting_layer("settings", [JetCLICommandSetting]{command_setting_on("test.serial", false, 1)})}), [String]{"--serial=false"})
    assert_eq(command_setting_words("publish", on, [JetCLICommandSettingLayer]{command_setting_layer("settings", [JetCLICommandSetting]{command_setting_on("registry.publish.no_sign", true, 1)})}), [String]{"--no-sign"})
    // Another command's settings add nothing to this one.
    assert_eq(command_setting_words("fmt", on, [JetCLICommandSettingLayer]{layer}), [String]{})
}

#Test("a later layer and a typed flag win, and a list is replaced, never merged") {
    user: command_setting_layer("user", [JetCLICommandSetting]{
        command_setting_text("run.color", "never", 1),
        command_setting_items("run.deny", [String]{"Net"}, 2),
    })
    package: command_setting_layer("package", [JetCLICommandSetting]{
        command_setting_text("run.color", "always", 7),
        command_setting_items("run.deny", [String]{"FS"}, 8),
    })
    assert_eq(command_setting_words("run", [String]{}, [JetCLICommandSettingLayer]{user, package}), [String]{"--color=always", "--deny=FS"})
    assert_eq(command_setting_words("run", [String]{"--color=auto", "--deny=Exec"}, [JetCLICommandSettingLayer]{user, package}), [String]{})
    // A word after `--` is the program's, not a flag.
    assert_eq(command_setting_words("run", [String]{"x.jet", "--", "--color=auto"}, [JetCLICommandSettingLayer]{package}), [String]{"--color=always", "--deny=FS"})
    allow_all: jet_cli_flag_spec("--allow-all") ?? panic("--allow-all is registered")
    assert(jet_cli_setting_typed(allow_all, [String]{"-A"}))
    assert(!jet_cli_setting_typed(allow_all, [String]{"--", "-A"}))
}

#Test("every problem of every layer is reported at once, and a refused layer adds nothing") {
    user: command_setting_layer("user", [JetCLICommandSetting]{
        command_setting_on("fmt.chek", true, 1),
        command_setting_items("run.allow", [String]{"Net"}, 2),
        JetCLICommandSetting{key: "run.color", value: Dyn.Int(3), line: 3},
        JetCLICommandSetting{key: "run.deny", value: Dyn.Array([Dyn]{Dyn.Text("Net"), Dyn.Bool(true)}), line: 4},
    })
    package: command_setting_layer("package", [JetCLICommandSetting]{
        command_setting_text("fmt.check", "yes", 3),
        command_setting_on("test.update_snapshots", true, 4),
        command_setting_text("run.e", "print(1)", 5),
        command_setting_text("run.color", "always", 6),
    })
    reports: command_setting_refused("run", [JetCLICommandSettingLayer]{user, package})
    assert_eq(reports[0].fix, "Write `fmt.check`, or remove `fmt.chek`.")
    assert_eq(reports[1].why, "A settings file applies a flag to every run, but `--allow` is typed each time: permissions are given on the command line each run.")
    assert_eq(reports[2].what, "`run.color` in `user` line 3 is not true or false, a string or a list, but `--color` takes one value, as a string.")
    assert_eq(reports[3].what, "`run.deny` in `user` line 4 is a list with an item that isn't a string, but `--deny` takes a list of strings, one per flag.")
    assert_eq(reports[4].what, "`fmt.check` in `package` line 3 is a string, but `--check` takes true or false.")
    assert_eq(reports[6].why, "A settings file applies a flag to every run, but `-e` is typed each time: it names what one run works on.")
    codes := [String]{}
    loop report in reports -> codes.push(report.code.copy()) // copy: the report keeps its code.
    assert_eq(codes, [String]{"E2104", "E2117", "E2104", "E2104", "E2104", "E2117", "E2117"})
}

// Does `key` name one of the flags `names` (key names, `allow_all`)?
command_setting_names_flag: fn(key: String, names: [String]) -> Bool Never! {
    loop name in names {
        if key.ends_with(".{name}") -> return true
    }
    false
}

// A flag that gives permissions is never saved, in any layer: each key of an
// `authority` flag, under each command that takes it, is refused (E2117).
#Test("no flag that gives permissions is a setting") {
    permissions: [String]{"--allow", "--allow-all", "--gate", "--token", "--allow-unofficial"}
    loop long in permissions {
        spec: jet_cli_flag_spec(long) ?? panic("{long} is registered")
        assert_eq(spec.typed, "authority")
    }
    names := [String]{}
    loop spec in JET_CLI_FLAGS {
        if spec.typed == "authority" -> names.push(jet_cli_setting_flag_name(spec.long))
    }
    refused := 0
    loop key in jet_cli_setting_keys(jet_cli_setting_commands()) {
        if !command_setting_names_flag(key, names) -> next
        layer: command_setting_layer("user", [JetCLICommandSetting]{command_setting_on(key, true, 1)})
        reports: command_setting_refused("run", [JetCLICommandSettingLayer]{layer})
        assert_eq(reports.len(), 1)
        assert_eq(reports[0].code, "E2117")
        assert(reports[0].why.ends_with("permissions are given on the command line each run."))
        refused += 1
    }
    assert(refused > 0)
}

// The refusal renders as the CLI snapshot tests/cli/command_setting_e2117.txt records it.
#Test("a remembered destructive flag is refused as its CLI snapshot records") {
    expected: setting_files.read("tests/cli/command_setting_e2117.txt") ?? panic("read tests/cli/command_setting_e2117.txt: {err}")
    layer: command_setting_layer("package", [JetCLICommandSetting]{command_setting_on("test.update_snapshots", true, 4)})
    output: jet_cli_command_settings_output(command_setting_refused("test", [JetCLICommandSettingLayer]{layer}), false)
    assert_eq(output.stderr, expected)
}

// A flag whose help spells it with a value (`--sha256=HEX`) takes one, a
// short form keeps the defaults (it has no key of its own), and a flag typed
// each time names a reason row.
#Test("every flag row says how its setting is written") {
    loop spec in JET_CLI_FLAGS {
        if spec.help.starts_with("Short form of ") {
            assert(spec.value == JetCLIFlagValue.Switch && spec.typed == "")
            next
        }
        if spec.help.contains("{spec.long}=") -> assert(spec.value != JetCLIFlagValue.Switch)
        if spec.typed != "" && jet_cli_flag_typed_reason(spec.typed) == None -> panic("`{spec.long}` names no typed reason `{spec.typed}`")
    }
}
