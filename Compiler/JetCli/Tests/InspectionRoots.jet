// Inspection actions and planes consume the same Package discovery as
// compilation, including inline roots and the command-specific error channel.
use {
    jet_cli.[JetCLIPlan, jet_cli_inspect_require_root, jet_cli_require_inspect_root]
    jet_driver.[JET_DRIVER_EXIT_USER_ERROR, JetDriverVerbOutput]
    cli_sys: core.sys
    cli_files: core.files
    cli_process: core.process
}

inspection_root_fixture_require_root: fn(start: String, expected: String) {
    if jet_cli_require_inspect_root(start, "missing package", true) == {
        .Root(root) -> assert(root == expected)
        .Refused(_) -> panic("checked inspection Package root")
    }
    if jet_cli_inspect_require_root(start, "missing package", true) == {
        .File(root, notice) -> {
            assert(root == expected)
            assert(notice == "")
        }
        .Refused(_) -> panic("plane Package root")
    }
}

inspection_root_fixture_missing: fn(start: String) {
    action := JetCLIPlan.Done{output: JetDriverVerbOutput{stdout: "", stderr: "", exit_code: 0}}
    if jet_cli_require_inspect_root(start, "missing package", true) == {
        .Root(_) -> panic("missing root was invented")
        .Refused(plan) -> action = plan
    }
    plane := JetCLIPlan.Done{output: JetDriverVerbOutput{stdout: "", stderr: "", exit_code: 0}}
    if jet_cli_inspect_require_root(start, "missing package", true) == {
        .File(_, _) -> panic("missing plane root was invented")
        .Refused(plan) -> plane = plan
    }
    if action == {
        .Done(output) -> {
            assert(output.stdout == "" && output.exit_code == JET_DRIVER_EXIT_USER_ERROR)
            assert(output.stderr == "missing package\n")
            if plane == {
                .Done(other) -> assert(other.stdout == output.stdout && other.stderr == output.stderr && other.exit_code == output.exit_code)
                .Refused(_, _, _, _) | .Diagnostics(_, _, _, _, _) | .Check(_, _, _, _, _, _, _, _, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) -> panic("plane and action root error channel differ")
            }
        }
        .Refused(_, _, _, _) | .Diagnostics(_, _, _, _, _) | .Check(_, _, _, _, _, _, _, _, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) -> panic("manifest-required missing root reports directly, not through JSON selection")
    }
}

#Test("inspection_roots") {
    root: "{cli_sys.temp_dir()}/jet-inspection-roots-{cli_process.current_pid()}"
    cli_files.create_dir_all("{root}/manifest/sub") ?? panic("manifest fixture")
    cli_files.create_dir_all("{root}/inline/sub") ?? panic("inline fixture")
    cli_files.create_dir_all("{root}/missing/sub") ?? panic("missing fixture")
    // package.jet holds bare manifest fields; `package: {…}` is the inline form in a .jet file.
    cli_files.write("{root}/manifest/package.jet", "name: \"manifest\"\nversion: \"0.0.0\"\nedition: \"2026\"\n") ?? panic("manifest")
    inspection_root_fixture_require_root("{root}/manifest/sub", "{root}/manifest")
    cli_files.write("{root}/inline/run.jet", "package: {{ name: \"inline\" version: \"0.0.0\" edition: \"2026\" outputs: {{ app: .Executable{{entry: run}} }} }}\nrun: fn() {{}}\n") ?? panic("inline Package")
    inspection_root_fixture_require_root("{root}/inline/sub", "{root}/inline")
    // A loose main.jet is not an inline Package or an excuse to refuse a mode.
    cli_files.write("{root}/missing/main.jet", "run: fn() {{}}\n") ?? panic("loose source")
    inspection_root_fixture_missing("{root}/missing/sub")
    cli_files.remove_all(root) ?? panic("inspection roots cleanup")
}
