// Checked declarations, not hand-authored BuildGraph rows, drive the reports.
use jet_foundation.[MIRBlockID, MIRVectorFact, Span]
use core.build.[BuildGraphNode, BuildGraphInputDigest]
use jet_driver.[jet_driver_query_build_nodes, jet_driver_compile_mir, jet_driver_source_query]
fn inspect_build_require(ok: Bool, message: String) Never! {
    if !ok -> panic("InspectBuild: {message}")
}
fn inspect_build_node(node: BuildGraphNode, kind: String, subject: String, key: String, inputs: [String]) Never! {
    inspect_build_require(node.kind == kind && node.subject == subject && node.key == key && node.inputs == inputs, "exact {kind} node {subject}")
}
fn inspect_build_request() -> JetDriverCompileRequest {
    snapshot :: JetDriverAuthorizedSourceSnapshot{
        roots: [JetDriverAuthorizedSourceRoot]{{canonical_path: "/inspect-build", identity: "build-root", allow_hardlinks: false, files: [JetDriverAuthorizedSourceFile]{{path: "/inspect-build/main.jet", relative_path: "main.jet", identity: "build-source", source: "fn run() {{}}"}}, foreign_cache_files: []}},
        entry_root_identity: "build-root", entry_path: "/inspect-build/main.jet",
    }
    jet_cli_driver_request(snapshot, [], Val(1), JetDriverCompileMode.Doc)
}
fn run() {
    empty :: JetDriverBuildQueryResult{plan: None, graph: None, generated: [], diagnostics: [], complete: true, internal_problem: None}
    inspect_build_require(jet_cli_build_report(empty, "[]", None, false) == "default pipeline: no root fn build\n", "default pipeline human")
    inspect_build_require(jet_cli_build_report(empty, "[]", None, true) == "{{\"schema\":\"jet.status/v1\",\"action\":\"inspect.build\",\"ok\":true,\"reports\":[],\"build\":null}}\n", "default pipeline JSON")
    policy :: BuildSessionPolicy{legacy_denied: None, plugins_denied: None, plugin_grants: [String:[String]]{}}
    session :: build_session_new(101, "fixture", "compiler", policy)
    action_reply :: build_session_call(&session, "action", [BuildSessionValue]{.Text("compile"), .List([BuildSessionValue]{.Text("main.jet")}), .List([BuildSessionValue]{.Text("out/app")}), .List([BuildSessionValue]{.Text("compiler"), .Text("main.jet")}), .List([])}, None, false, 1, 2)
    action :: if action_reply == {.Value(value) -> value else -> panic("checked action failed")}
    target_reply :: build_session_call(&session, "add_executable", [BuildSessionValue]{.Text("app"), .List([BuildSessionValue]{.Text("main.jet")}), .List([BuildSessionValue]{action})}, None, false, 3, 4)
    target :: if target_reply == {.Value(value) -> value else -> panic("checked target failed")}
    plan_reply :: build_session_call(&session, "plan", [BuildSessionValue]{target}, None, false, 5, 6)
    returned :: if plan_reply == {.Value(value) -> value else -> panic("checked plan failed")}
    finished :: build_session_finish(&session, returned)
    plan :: finished.plan ?? panic("checked finish failed")
    graph :: build_plan_graph(plan)
    query :: JetDriverBuildQueryResult{plan: Val(plan), graph: Val(graph), generated: [], diagnostics: [], complete: true, internal_problem: None}
    human :: jet_cli_build_report(query, "", None, false)
    inspect_build_require(human == "target\tapp\tExecutable\naction\tcompile\tout/app\n", "checked graph human")
    machine :: jet_cli_build_report(query, "[]", None, true)
    key :: graph.actions[0].key
    // The checked graph owns the key; every observable projection field is
    // pinned independently of the renderer, including the static file universe.
    files :: "[{{\"path\":\"main.jet\",\"owner\":null,\"consumers\":[0],\"targets\":[0]}},{{\"path\":\"out/app\",\"owner\":0,\"consumers\":[],\"targets\":[0]}}]"
    payload :: "{{\"schema_version\":1,\"default\":0,\"targets\":[{{\"id\":0,\"name\":\"app\",\"kind\":\"Executable\",\"deps\":[],\"actions\":[0],\"files\":[\"main.jet\"]}}],\"actions\":[{{\"id\":0,\"name\":\"compile\",\"inputs\":[\"main.jet\"],\"outputs\":[\"out/app\"],\"caps\":[],\"pools\":[\"cpu\"],\"toolchain\":\"host\",\"probes\":[],\"cache\":\"Cached\",\"cache_status\":\"unknown\",\"key\":\"{key}\",\"compiler_owned\":false,\"provenance\":[\"argv=compiler main.jet\",\"inputs=1\",\"outputs=1\",\"cache=Cached\"]}}],\"action_keys\":[{{\"action\":\"compile\",\"key\":\"{key}\"}}],\"cache_hits\":[],\"files\":{files},\"affected_files\":{files},\"toolchains\":[{{\"name\":\"host\",\"target\":\"host\"}}],\"probes\":[],\"generated\":[],\"vector\":[]}}"
    inspect_build_require(jet_driver_build_plan_json(plan, "[]") == payload, "canonical graph JSON exact fields and order")
    inspect_build_require(machine == "{{\"schema\":\"jet.status/v1\",\"action\":\"inspect.build\",\"ok\":true,\"reports\":[],\"build\":{payload}}}\n", "checked graph JSON exact envelope")
    inspect_build_require(jet_cli_build_report(query, "", Val("app"), false) == "app\n  kind=Executable\n  sources=1\n  deps=0\n  actions=1\n", "target explanation")
    inspect_build_require(jet_cli_build_report(query, "", Val("compile"), false) == "compile\n  argv=compiler main.jet\n  inputs=1\n  outputs=1\n  cache=Cached\n", "action explanation")
    inspect_build_require(jet_cli_build_report(query, "", Val("out/app"), false) == "out/app\n  owner=Some(ActionId(0))\n  consumers=[]\n  targets=[TargetId(0)]\n", "file ownership explanation")
    inspect_build_require(jet_cli_build_report(query, "", Val("missing"), false) == "missing\n  owner=None\n  consumers=[]\n  targets=[]\n", "unknown path is not an invented owner")
    inspect_build_require(jet_cli_build_report(query, "", Val("app"), true) == "{{\"schema\":\"jet.status/v1\",\"action\":\"inspect.build\",\"ok\":true,\"reports\":[],\"label\":\"app\",\"provenance\":[\"kind=Executable\",\"sources=1\",\"deps=0\",\"actions=1\"]}}\n", "target explanation JSON")
    inspect_build_require(jet_cli_build_report(query, "", Val("compile"), true) == "{{\"schema\":\"jet.status/v1\",\"action\":\"inspect.build\",\"ok\":true,\"reports\":[],\"label\":\"compile\",\"provenance\":[\"argv=compiler main.jet\",\"inputs=1\",\"outputs=1\",\"cache=Cached\"]}}\n", "action explanation JSON")
    inspect_build_require(jet_cli_build_report(query, "", Val("out/app"), true) == "{{\"schema\":\"jet.status/v1\",\"action\":\"inspect.build\",\"ok\":true,\"reports\":[],\"label\":\"out/app\",\"provenance\":[\"owner=Some(ActionId(0))\",\"consumers=[]\",\"targets=[TargetId(0)]\"]}}\n", "file explanation JSON")
    inspect_build_require(jet_cli_build_report(query, "", Val("missing"), true) == "{{\"schema\":\"jet.status/v1\",\"action\":\"inspect.build\",\"ok\":true,\"reports\":[],\"label\":\"missing\",\"provenance\":[\"owner=None\",\"consumers=[]\",\"targets=[]\"]}}\n", "unknown file JSON")
    optimization := jet_driver_optimization_query(inspect_build_request())
    inspect_build_require(optimization.compile.complete && optimization.compile.internal_problem == None, "build vector production query")
    inspect_build_require(optimization.compile.build_nodes == None, "unrequested compile does not allocate a node projection")
    inspect_build_require(jet_cli_build_vector(optimization, false) == "" && jet_cli_build_vector(optimization, true) == "[]", "no-vector checked program")
    program := optimization.compile.mir ?? panic("checked vector fixture lost MIR")
    inspect_build_require(program.functions.len() > 0, "checked vector fixture has a function")
    first := program.functions[0]
    first.key = "z-first"
    accepted :: MIRVectorFact{loop_header: MIRBlockID{value: U64{1}}, cursor: None, body_blocks: [], advance_block: None, rule: .Elementwise, accesses: [], layout: .Flat, element_type: None, packed: false, lane_width: Val(4), no_aliasing: true, no_early_exit: true, effect_free_body: true, no_cross_iteration_dependencies: true, fixed_reduction: None, span: Span{start: 2, end: 9}, decision: .Eligible}
    first.optimization.vector_facts = [MIRVectorFact]{accepted}
    second := first
    second.key = "a-second"
    rejected := accepted
    rejected.rule = .Reduction
    rejected.layout = .AosStrided
    rejected.lane_width = None
    rejected.span = Span{start: 12, end: 19}
    rejected.decision = .Rejected(.MayAlias)
    second.optimization.vector_facts = [MIRVectorFact]{rejected}
    program.functions = [first, second]
    optimization.compile.mir = Val(program)
    // The acceleration view is a separate sorted projection. It must not
    // replace the compiler's declaration order or supply build vector rows.
    optimization.functions = []
    inspect_build_require(jet_cli_build_vector(optimization, false) == "vector\tz-first\t2..9\telementwise\tflat\t4\taccepted\nvector\ta-second\t12..19\treduction\taos-strided\tnone\tmay-alias\n", "build vector declaration order human")
    inspect_build_require(jet_cli_build_vector(optimization, true) == "[{{\"function\":\"z-first\",\"span\":{{\"start\":2,\"end\":9}},\"rule\":\"elementwise\",\"layout\":\"flat\",\"lane\":\"4\",\"decision\":\"accepted\"}},{{\"function\":\"a-second\",\"span\":{{\"start\":12,\"end\":19}},\"rule\":\"reduction\",\"layout\":\"aos-strided\",\"lane\":\"none\",\"decision\":\"may-alias\"}}]", "build vector declaration order JSON")
    inspect_build_require(jet_cli_build_duration(0.0) == "0.000", "positive zero")
    inspect_build_require(jet_cli_build_duration(build_math.from_bits(-9223372036854775808)) == "-0.000", "negative zero")
    inspect_build_require(jet_cli_build_duration(0.0625) == "0.062", "exact halfway rounds to even")
    inspect_build_require(jet_cli_build_duration(0.1875) == "0.188", "odd halfway rounds up")
    inspect_build_require(jet_cli_build_duration(1.2345) == "1.234", "do not double-round binary float")
    inspect_build_require(jet_cli_build_duration(build_math.from_bits(1)) == "0.000", "subnormal")
    record :: BuildRecord.new("main", [BuildNodeRecord]{{kind: "check", key: "key", subject: "main", duration_ms: 0.1875, why_ran: "source-changed", inputs: [String]{"main.jet"}}})
    inspect_build_require(jet_cli_build_nodes_report(record, false) == "check\tkey\tmain\t0.188\tsource-changed\tmain.jet\n", "real node fields human")
    inspect_build_require(jet_cli_build_nodes_report(record, true) == "{{\"schema\":\"jet.explain-build/v1\",\"program\":\"main\",\"nodes\":[{{\"kind\":\"check\",\"key\":\"key\",\"subject\":\"main\",\"duration_ms\":0.188,\"why_ran\":\"source-changed\",\"inputs\":[\"main.jet\"]}}]}}\n", "node schema does not invent fields")
    scope := JetDriverBuildQueryScope{}
    static_response := jet_driver_query_build_nodes(inspect_build_request(), &scope)
    static_request := ^static_response.request
    static_query := ^static_response.query
    inspect_build_require(static_request.authorized_sources.entry_path == "/inspect-build/main.jet" && static_request.mode == JetDriverCompileMode.Doc && !static_request.capture_build_program && !static_request.capture_build_nodes, "no-build query returns its unchanged invocation request")
    inspect_build_require(static_query.complete && static_query.plan == None && static_query.nodes.len() == 3, "no-build final checked bundle supplies nodes separately")
    inspect_build_node(static_query.nodes[0], "check", "main.jet", "e05c67e9bab9aa34ca3456b464c3adbe3b66f767085eb68b85663f8b70695957", [String]{"main.jet"})
    inspect_build_require(static_query.nodes[0].input_digests == [BuildGraphInputDigest]{{name: "main.jet", digest: "bfd8d52e2180ce4c2deb1b7c346891d3c77bbbd3a22df0fd8abfe0096e485095"}}, "exact checked bytes")
    inspect_build_node(static_query.nodes[1], "compile", "main", "fc7c98733a19662c13cb2cf9d4fd679654cb2d58d4a6ee86b659b14b9ea189d8", [String]{"check:main.jet"})
    inspect_build_node(static_query.nodes[2], "link", "main", "b6423079c3279ff750ff90cba335186d0999283f94ff5bfd41815734385e0138", [String]{"compile:main"})
    // Controlled observation inputs test the receipt projection, not a claim
    // that this fixture executed an object compiler or published a runtime pack.
    object :: ObjectHandle.from_bytes("controlled object identity input".bytes())
    observed :: jet_cli_build_compile_observation(static_query.nodes[1], 12.5, None, object) ?? panic("actual compile observation rejected")
    inspect_build_require(observed.object == object && observed.node.duration_ms == 12.5, "object identity and measured duration are retained without substitution")
    observed_record :: BuildRecord.new("main", [observed.node])
    inspect_build_require(jet_cli_build_nodes_report(observed_record, false) == "compile\tfc7c98733a19662c13cb2cf9d4fd679654cb2d58d4a6ee86b659b14b9ea189d8\tmain\t12.500\tfirst-run\tcheck:main.jet\n", "executed compile exact human receipt")
    inspect_build_require(jet_cli_build_nodes_report(observed_record, true) == "{{\"schema\":\"jet.explain-build/v1\",\"program\":\"main\",\"nodes\":[{{\"kind\":\"compile\",\"key\":\"fc7c98733a19662c13cb2cf9d4fd679654cb2d58d4a6ee86b659b14b9ea189d8\",\"subject\":\"main\",\"duration_ms\":12.500,\"why_ran\":\"first-run\",\"inputs\":[\"check:main.jet\"]}}]}}\n", "executed compile exact JSON receipt")
    prior :: jet_cli_build_compile_observation(static_query.nodes[1], 12.5, Val(record), object) ?? panic("prior record observation rejected")
    inspect_build_require(prior.node.why_ran == "input:check:main.jet", "Rust prior-record literal names input without inventing input-changed")
    inspect_build_require(jet_cli_build_compile_observation(static_query.nodes[0], 12.5, None, object) == .Err(_), "object observation cannot stamp an unexecuted check node")
    inspect_build_require(jet_cli_build_compile_observation(static_query.nodes[1], -1.0, None, object) == .Err(_), "invalid measured duration cannot become a fake zero")
    inspect_build_require(jet_cli_build_compile_observation(static_query.nodes[1], build_math.from_bits(9221120237041090560), None, object) == .Err(_), "non-finite measured duration cannot become a fake zero")
    planned := inspect_build_request()
    planned.authorized_sources.roots[0].files[0].source = "fn build(b: Build) {{}}\nfn run() {{}}"
    planned_response := jet_driver_query_build_nodes(^planned, &scope)
    planned_request := ^planned_response.request
    planned_query := ^planned_response.query
    inspect_build_require(planned_request.authorized_sources.entry_path == "/inspect-build/main.jet" && planned_request.selected_entry == None && planned_request.mode == JetDriverCompileMode.Doc && !planned_request.capture_build_program && !planned_request.capture_build_nodes, "build staging restores entry and selection before returning the invocation")
    inspect_build_require(planned_request.generated_modules.len() == 0 && planned_request.build_output_names.len() == 0, "final checked bundle leaves no temporary generated sources or output overrides in the request")
    inspect_build_require(planned_query.complete && planned_query.generated.len() == 0 && planned_query.nodes.len() == 3, "zero-generated plan still checks the final ordinary bundle")
    planned_graph :: planned_query.graph ?? panic("checked plan lost graph")
    planned_plan :: planned_query.plan ?? panic("checked plan lost plan")
    inspect_build_require(planned_graph.nodes == planned_query.nodes && build_plan_graph(planned_plan).nodes == planned_query.nodes, "same finished Core plan owns the compiler nodes")
    moved := inspect_build_request()
    moved.authorized_sources.roots[0].canonical_path = "/relocated-build"
    moved.authorized_sources.roots[0].files[0].path = "/relocated-build/main.jet"
    moved.authorized_sources.entry_path = "/relocated-build/main.jet"
    moved_response := jet_driver_query_build_nodes(^moved, &scope)
    moved_query := ^moved_response.query
    inspect_build_require(moved_query.complete && moved_query.nodes == static_query.nodes, "checkout relocation preserves identity")
    selected := inspect_build_request()
    selected.capture_build_nodes = true
    selected.build_output_names = [String]{"z", "a", "z"}
    selected_result :: jet_driver_compile_mir(^selected)
    selected_nodes :: selected_result.build_nodes ?? panic("selected outputs lost final nodes")
    inspect_build_require(selected_result.complete && selected_nodes.len() == 5, "selected outputs sorted and deduplicated")
    inspect_build_node(selected_nodes[1], "compile", "a", "09aa99b89705217152a804b0fad71966574c2fe659fce7dd2561fd4fc9337d72", [String]{"check:main.jet"})
    inspect_build_node(selected_nodes[2], "compile", "z", "4c033701848037361fca21c04ebb21c87a69af4def9efe6cd22aae0d841d000c", [String]{"check:main.jet"})
    inspect_build_node(selected_nodes[3], "link", "a", "d2cc18555b722bcff7df964cc877e15ffdae6cfdffc8dd219fd64476c4ea944e", [String]{"compile:a"})
    inspect_build_node(selected_nodes[4], "link", "z", "1b995f4cc018af862930ddf3d5cf973c675838ebbbea540afb73f12e50d76d35", [String]{"compile:z"})
    generated_request := inspect_build_request()
    loaded :: jet_driver_source_query(generated_request)
    inspect_build_require(loaded.complete && loaded.entry_module_index >= 0, "generated owner is loader selected")
    generated_request.generated_modules = [JetDriverGeneratedModule]{{package_identity: loaded.modules[loaded.entry_module_index].package_identity, name: "generated", relative_path: "build/generated.jet", source: "fn generated_value() -> Int {{ 7 }}"}}
    generated_response := jet_driver_query_build_nodes(^generated_request, &scope)
    generated_owner := ^generated_response.request
    generated_query := ^generated_response.query
    inspect_build_require(generated_owner.generated_modules.len() == 1, "preexisting generated source metadata is retained with its invocation owner")
    inspect_build_require(generated_query.complete && generated_query.nodes.len() == 4, "final generated source is a checked module")
    inspect_build_node(generated_query.nodes[0], "check", "build/generated.jet", "070a459848bc4669182150dd08b8cd3802535d2649bf3be1f38047472cee92b8", [String]{"build/generated.jet"})
    inspect_build_require(generated_query.nodes[0].input_digests == [BuildGraphInputDigest]{{name: "build/generated.jet", digest: "601d5b33f645e3713d0435b7ad669435dc3274d9f866b26079fddc352629ec72"}}, "generated bytes are retained, not omitted Doc modules or virtual origins")
    refused :: jet_cli_build_nodes_host(inspect_build_request(), &scope, "main.jet", "main", None, true, false, false)
    inspect_build_require(refused.exit_code == JET_DRIVER_EXIT_USER_ERROR && refused.stdout.contains("E2104") && !refused.stdout.contains("first-run") && !refused.stdout.contains("duration_ms"), "missing execution evidence refuses, never static fabricated metrics")
    broken := inspect_build_request()
    broken.authorized_sources.roots[0].files[0].source = "fn run() -> Int {{ true }}"
    failed_response := jet_driver_query_build_plan(^broken, &scope)
    broken = ^failed_response.request
    failed_query := ^failed_response.query
    inspect_build_require(!failed_query.complete && failed_query.diagnostics.len() > 0, "no-build packages still undergo semantic checking")
    inspect_build_require(failed_query.nodes.len() == 0, "failed check publishes no static identities")
    human_failure :: jet_cli_build_query_failure(broken, failed_query, "main.jet", false, false, false)
    inspect_build_require(human_failure.exit_code == JET_DRIVER_EXIT_USER_ERROR && human_failure.stdout == "" && human_failure.stderr.contains("problem") && human_failure.stderr.contains("found"), "build failures preserve canonical problem-count report")
    json_failure :: jet_cli_build_query_failure(broken, failed_query, "main.jet", true, false, false)
    inspect_build_require(json_failure.exit_code == JET_DRIVER_EXIT_USER_ERROR && json_failure.stderr == "" && json_failure.stdout.contains("\"action\":\"diagnostics\""), "build failures preserve canonical diagnostics status envelope")
    advisory := diagnostic_from_registry("L0507", None, "prefer an ordered arm table", "one ordered arm table is the normal form", "use ordered arms")
    advisory.severity = DIAGNOSTIC_LINT
    with_advisory := failed_query
    &with_advisory.diagnostics.push(advisory)
    quiet_failure :: jet_cli_build_query_failure(broken, with_advisory, "main.jet", true, false, false)
    verbose_failure :: jet_cli_build_query_failure(broken, with_advisory, "main.jet", true, false, true)
    inspect_build_require(!quiet_failure.stdout.contains("L0507") && verbose_failure.stdout.contains("L0507"), "build failure advisories require verbose presentation")
    internal_query :: JetDriverBuildQueryResult{plan: None, graph: None, generated: [], diagnostics: [], complete: false, internal_problem: Val("build query lost MIR")}
    internal_failure :: jet_cli_build_query_failure(inspect_build_request(), internal_query, "main.jet", true, false, false)
    inspect_build_require(internal_failure.exit_code == JET_CLI_EXIT_ICE && internal_failure.stdout == "" && internal_failure.stderr.contains("internal compiler error: build query lost MIR"), "internal query failures retain ICE exit and stream")
}
