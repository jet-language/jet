// Checked declarations, not hand-authored BuildGraph rows, drive the reports.
use {
    jet_foundation.[DIAGNOSTIC_LINT, Diagnostic, diagnostic_from_registry]
    core.build.[BuildGraphNode, BuildGraphInputDigest]
    jet_driver.[
        jet_driver_query_build_nodes, jet_driver_compile, jet_driver_source_query,
        JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USER_ERROR, JetDriverAuthorizedSourceFile, JetDriverAuthorizedSourceRoot,
        JetDriverAuthorizedSourceSnapshot, JetDriverBuildQueryResult, JetDriverBuildQueryScope,
        JetDriverCompileMode, JetDriverCompileRequest, JetDriverGeneratedModule,
        jet_driver_build_plan_json, jet_driver_build_query_stopped, jet_driver_query_build_plan,
    ]
    jet_cli.[
        JET_CLI_EXIT_ICE, jet_cli_build_compile_observation, jet_cli_build_duration,
        jet_cli_build_nodes_host, jet_cli_build_nodes_report, jet_cli_build_query_failure,
        jet_cli_build_report, jet_cli_driver_request, jet_cli_native_session_at,
    ]
    jet_build_session.[
        BuildSessionPolicy, BuildSessionValue, build_plan_graph, build_session_call,
        build_session_finish, build_session_new,
    ]
    jetpack_artifact_store.[BuildNodeRecord, BuildRecord, ObjectHandle]
    build_math: core.math
    build_sys: core.sys
    build_process: core.process
}
inspect_build_require: fn(ok: Bool, message: String) Never! {
    if !ok -> panic("InspectBuild: {message}")
}
inspect_build_node: fn(node: BuildGraphNode, kind: String, subject: String, key: String, inputs: [String]) Never! {
    inspect_build_require(node.kind == kind && node.subject == subject && node.key == key && node.inputs == inputs, "exact {kind} node {subject}")
}
inspect_build_request: fn() -> JetDriverCompileRequest {
    snapshot: JetDriverAuthorizedSourceSnapshot{
        roots: [JetDriverAuthorizedSourceRoot]{{canonical_path: "/inspect-build", identity: "build-root", allow_hardlinks: false, files: [JetDriverAuthorizedSourceFile]{{path: "/inspect-build/main.jet", relative_path: "main.jet", identity: "build-source", source: "run: fn() {{}}"}}, foreign_cache_files: []}},
        entry_root_identity: "build-root", entry_path: "/inspect-build/main.jet",
    }
    jet_cli_driver_request(snapshot, [], Val(1), JetDriverCompileMode.Doc)
}
#Test("inspect_build") {
    empty: JetDriverBuildQueryResult{plan: None, graph: None, generated: [], diagnostics: [], complete: true, internal_problem: None}
    inspect_build_require(jet_cli_build_report(empty, None, false) == "default pipeline: no root fn build\n", "default pipeline human")
    inspect_build_require(jet_cli_build_report(empty, None, true) == "{{\"schema\":\"jet.status/v1\",\"action\":\"inspect.build\",\"ok\":true,\"reports\":[],\"build\":null}}\n", "default pipeline JSON")
    policy: BuildSessionPolicy{plugins_denied: None, plugin_grants: [String:[String]]{}}
    session := build_session_new(101, "fixture", "compiler", policy)
    probe_reply: build_session_call(session, "probe", [BuildSessionValue]{BuildSessionValue.Text{value: "compiler"}, BuildSessionValue.Text{value: "find_program"}, BuildSessionValue.Text{value: "compiler"}}, None, true, 1, 2)
    probe: if probe_reply == {
        .Value(value) -> value
        .Failure(_) | .HostRequest(_, _) -> panic("checked probe failed")
    }
    found_reply: build_session_call(session, "found", [BuildSessionValue]{probe}, None, false, 1, 2)
    found: if found_reply == {
        .Value(value) -> value
        .Failure(_) | .HostRequest(_, _) -> panic("checked found program failed")
    }
    action_reply: build_session_call(session, "run", [BuildSessionValue]{BuildSessionValue.Text{value: "compile"}, found, BuildSessionValue.List{values: [BuildSessionValue]{}}}, None, false, 1, 2)
    action: if action_reply == {
        .Value(value) -> value
        .Failure(_) | .HostRequest(_, _) -> panic("checked step failed")
    }
    input_reply: build_session_call(session, "action.input", [BuildSessionValue]{action, BuildSessionValue.Text{value: "main.jet"}}, None, false, 1, 2)
    if input_reply == {
        .Value(_) -> {}
        .Failure(_) | .HostRequest(_, _) -> panic("checked step input failed")
    }
    output_reply: build_session_call(session, "action.output", [BuildSessionValue]{action, BuildSessionValue.Text{value: "out/app"}}, None, false, 1, 2)
    if output_reply == {
        .Value(_) -> {}
        .Failure(_) | .HostRequest(_, _) -> panic("checked step output failed")
    }
    target_reply: build_session_call(session, "add_executable", [BuildSessionValue]{BuildSessionValue.Text{value: "app"}, BuildSessionValue.List{values: [BuildSessionValue]{BuildSessionValue.Text{value: "main.jet"}}}, BuildSessionValue.List{values: [BuildSessionValue]{action}}}, None, false, 3, 4)
    target: if target_reply == {
        .Value(value) -> value
        .Failure(_) | .HostRequest(_, _) -> panic("checked target failed")
    }
    // `build: fn(b: Build)` names its default with `b.default(app)` and returns
    // nothing; the configured session is the plan (Graph.jet build_session_finish).
    default_reply: build_session_call(session, "default", [BuildSessionValue]{target}, None, false, 5, 6)
    if default_reply == {
        .Value(_) -> {}
        .Failure(_) | .HostRequest(_, _) -> panic("checked default failed")
    }
    finished: build_session_finish(session, BuildSessionValue.Unit)
    plan: finished.plan ?? panic("checked finish failed")
    graph: build_plan_graph(plan)
    query: JetDriverBuildQueryResult{plan: Val(plan), graph: Val(graph), generated: [], diagnostics: [], complete: true, internal_problem: None}
    human: jet_cli_build_report(query, None, false)
    inspect_build_require(human == "target\tapp\tExecutable\naction\tcompile\tout/app\n", "checked graph human")
    machine: jet_cli_build_report(query, None, true)
    key: graph.actions[0].key
    // The checked graph owns the key; every observable projection field is
    // pinned independently of the renderer, including the static file universe.
    files: "[{{\"path\":\"main.jet\",\"owner\":null,\"consumers\":[0],\"targets\":[0]}},{{\"path\":\"out/app\",\"owner\":0,\"consumers\":[],\"targets\":[0]}}]"
    payload: "{{\"schema_version\":1,\"default\":0,\"targets\":[{{\"id\":0,\"name\":\"app\",\"kind\":\"Executable\",\"deps\":[],\"actions\":[0],\"files\":[\"main.jet\"]}}],\"actions\":[{{\"id\":0,\"name\":\"compile\",\"inputs\":[\"main.jet\"],\"outputs\":[\"out/app\"],\"caps\":[],\"pools\":[\"cpu\"],\"toolchain\":\"host\",\"probes\":[\"compiler\"],\"reuse\":\"Reusable\",\"cache_status\":\"unknown\",\"key\":\"{key}\",\"compiler_owned\":false,\"provenance\":[\"argv=compiler main.jet out/app\",\"inputs=1\",\"outputs=1\",\"reuse=Reusable\"]}}],\"action_keys\":[{{\"action\":\"compile\",\"key\":\"{key}\"}}],\"cache_hits\":[],\"files\":{files},\"affected_files\":{files},\"toolchains\":[{{\"name\":\"host\",\"target\":\"host\"}}],\"probes\":[{{\"name\":\"compiler\",\"kind\":\"FindProgram {{ program: \\\"compiler\\\" }}\",\"reproducibility\":\"Ambient\"}}],\"generated\":[]}}"
    inspect_build_require(jet_driver_build_plan_json(plan) == payload, "canonical graph JSON exact fields and order")
    machine_expected: "{{\"schema\":\"jet.status/v1\",\"action\":\"inspect.build\",\"ok\":true,\"reports\":[],\"build\":{payload}}}\n"
    inspect_build_require(machine == machine_expected, "checked graph JSON exact envelope")
    inspect_build_require(jet_cli_build_report(query, Val("app"), false) == "app\n  kind=Executable\n  sources=1\n  deps=0\n  actions=1\n", "target explanation")
    inspect_build_require(jet_cli_build_report(query, Val("compile"), false) == "compile\n  argv=compiler main.jet out/app\n  inputs=1\n  outputs=1\n  reuse=Reusable\n", "action explanation")
    inspect_build_require(jet_cli_build_report(query, Val("out/app"), false) == "out/app\n  owner=Some(ActionId(0))\n  consumers=[]\n  targets=[TargetId(0)]\n", "file ownership explanation")
    inspect_build_require(jet_cli_build_report(query, Val("missing"), false) == "missing\n  owner=None\n  consumers=[]\n  targets=[]\n", "unknown path is not an invented owner")
    inspect_build_require(jet_cli_build_report(query, Val("app"), true) == "{{\"schema\":\"jet.status/v1\",\"action\":\"inspect.build\",\"ok\":true,\"reports\":[],\"label\":\"app\",\"provenance\":[\"kind=Executable\",\"sources=1\",\"deps=0\",\"actions=1\"]}}\n", "target explanation JSON")
    inspect_build_require(jet_cli_build_report(query, Val("compile"), true) == "{{\"schema\":\"jet.status/v1\",\"action\":\"inspect.build\",\"ok\":true,\"reports\":[],\"label\":\"compile\",\"provenance\":[\"argv=compiler main.jet out/app\",\"inputs=1\",\"outputs=1\",\"reuse=Reusable\"]}}\n", "action explanation JSON")
    inspect_build_require(jet_cli_build_report(query, Val("out/app"), true) == "{{\"schema\":\"jet.status/v1\",\"action\":\"inspect.build\",\"ok\":true,\"reports\":[],\"label\":\"out/app\",\"provenance\":[\"owner=Some(ActionId(0))\",\"consumers=[]\",\"targets=[TargetId(0)]\"]}}\n", "file explanation JSON")
    inspect_build_require(jet_cli_build_report(query, Val("missing"), true) == "{{\"schema\":\"jet.status/v1\",\"action\":\"inspect.build\",\"ok\":true,\"reports\":[],\"label\":\"missing\",\"provenance\":[\"owner=None\",\"consumers=[]\",\"targets=[]\"]}}\n", "unknown file JSON")
    unrequested: jet_driver_compile(inspect_build_request())
    inspect_build_require(unrequested.complete && unrequested.internal_problem == None, "checked fixture compiles")
    inspect_build_require(unrequested.build_nodes == None, "unrequested compile does not allocate a node projection")
    inspect_build_require(jet_cli_build_duration(0.0) == "0.000", "positive zero")
    inspect_build_require(jet_cli_build_duration(build_math.from_bits(-9223372036854775808)) == "-0.000", "negative zero")
    inspect_build_require(jet_cli_build_duration(0.0625) == "0.062", "exact halfway rounds to even")
    inspect_build_require(jet_cli_build_duration(0.1875) == "0.188", "odd halfway rounds up")
    inspect_build_require(jet_cli_build_duration(1.2345) == "1.234", "do not double-round binary float")
    inspect_build_require(jet_cli_build_duration(build_math.from_bits(1)) == "0.000", "subnormal")
    record: BuildRecord.new("main", [BuildNodeRecord]{{kind: "check", key: "key", subject: "main", duration_ms: 0.1875, why_ran: "source-changed", inputs: [String]{"main.jet"}}})
    inspect_build_require(jet_cli_build_nodes_report("main", Val(record), [BuildGraphNode]{}, false) == "check\tkey\tmain\t0.188\tsource-changed\tmain.jet\n", "real node fields human")
    inspect_build_require(jet_cli_build_nodes_report("main", Val(record), [BuildGraphNode]{}, true) == "{{\"schema\":\"jet.explain-build/v1\",\"program\":\"main\",\"nodes\":[{{\"kind\":\"check\",\"key\":\"key\",\"subject\":\"main\",\"duration_ms\":0.188,\"why_ran\":\"source-changed\",\"inputs\":[\"main.jet\"]}}],\"planned\":[]}}\n", "node schema does not invent fields")
    scope := JetDriverBuildQueryScope{}
    static_response := jet_driver_query_build_nodes(inspect_build_request(), scope)
    static_request := static_response.request.move()
    static_query := static_response.query.move()
    inspect_build_require(static_request.authorized_sources.entry_path == "/inspect-build/main.jet" && static_request.mode == JetDriverCompileMode.Doc && !static_request.capture_build_program && !static_request.capture_build_nodes, "no-build query returns its unchanged invocation request")
    inspect_build_require(static_query.complete && static_query.plan == None && static_query.nodes.len() == 3, "no-build final checked bundle supplies nodes separately")
    inspect_build_node(static_query.nodes[0], "check", "main.jet", "0984cbcd63f1947088648f5c4d7e9b27b7d0f39b025f227e250ca7d2ce4e7b9f", [String]{"main.jet"})
    inspect_build_require(static_query.nodes[0].input_digests == [BuildGraphInputDigest]{{name: "main.jet", digest: "f5b8f89b424bcc30467c9377fa2593c409723a20730759d92391e55c4dab0edc"}}, "exact checked bytes")
    inspect_build_node(static_query.nodes[1], "compile", "main", "fc25e6bcf7a37b9e22a1574a12a4554ce92960ca4f4558aa23c1c1ebea5b0629", [String]{"check:main.jet"})
    inspect_build_node(static_query.nodes[2], "link", "main", "fa8fa4225fe9ff3c2e3d1c7c9047bfa17552676e618f5c4d91df4f325a86bc9e", [String]{"compile:main"})
    // Controlled observation inputs test the receipt projection, not a claim
    // that this fixture executed an object compiler or published a runtime pack.
    object: ObjectHandle.from_bytes("controlled object identity input".bytes())
    observed: jet_cli_build_compile_observation(static_query.nodes[1], 12.5, None, object) ?? panic("actual compile observation rejected")
    inspect_build_require(observed.object == object && observed.node.duration_ms == 12.5, "object identity and measured duration are retained without substitution")
    observed_record: BuildRecord.new("main", [observed.node])
    inspect_build_require(jet_cli_build_nodes_report("main", Val(observed_record), [BuildGraphNode]{}, false) == "compile\tfc25e6bcf7a37b9e22a1574a12a4554ce92960ca4f4558aa23c1c1ebea5b0629\tmain\t12.500\tfirst-run\tcheck:main.jet\n", "executed compile exact human receipt")
    inspect_build_require(jet_cli_build_nodes_report("main", Val(observed_record), [BuildGraphNode]{}, true) == "{{\"schema\":\"jet.explain-build/v1\",\"program\":\"main\",\"nodes\":[{{\"kind\":\"compile\",\"key\":\"fc25e6bcf7a37b9e22a1574a12a4554ce92960ca4f4558aa23c1c1ebea5b0629\",\"subject\":\"main\",\"duration_ms\":12.500,\"why_ran\":\"first-run\",\"inputs\":[\"check:main.jet\"]}}],\"planned\":[]}}\n", "executed compile exact JSON receipt")
    prior: jet_cli_build_compile_observation(static_query.nodes[1], 12.5, Val(record), object) ?? panic("prior record observation rejected")
    inspect_build_require(prior.node.why_ran == "input:check:main.jet", "Rust prior-record literal names input without inventing input-changed")
    inspect_build_require(jet_cli_build_compile_observation(static_query.nodes[0], 12.5, None, object) == .Err(_), "object observation cannot stamp an unexecuted check node")
    inspect_build_require(jet_cli_build_compile_observation(static_query.nodes[1], -1.0, None, object) == .Err(_), "invalid measured duration cannot become a fake zero")
    inspect_build_require(jet_cli_build_compile_observation(static_query.nodes[1], build_math.from_bits(9221120237041090560), None, object) == .Err(_), "non-finite measured duration cannot become a fake zero")
    moved := inspect_build_request()
    moved.authorized_sources.roots[0].canonical_path = "/relocated-build"
    moved.authorized_sources.roots[0].files[0].path = "/relocated-build/main.jet"
    moved.authorized_sources.entry_path = "/relocated-build/main.jet"
    moved_response := jet_driver_query_build_nodes(moved, scope)
    moved_query := moved_response.query.move()
    inspect_build_require(moved_query.complete && moved_query.nodes == static_query.nodes, "checkout relocation preserves identity")
    selected := inspect_build_request()
    selected.capture_build_nodes = true
    selected.build_output_names = [String]{"z", "a", "z"}
    selected_result: jet_driver_compile(selected)
    selected_nodes: selected_result.build_nodes ?? panic("selected outputs lost final nodes")
    inspect_build_require(selected_result.complete && selected_nodes.len() == 5, "selected outputs sorted and deduplicated")
    inspect_build_node(selected_nodes[1], "compile", "a", "b367c852ce09e0443d90eb0063d366107485516dcf1b527404820bb1c992dda4", [String]{"check:main.jet"})
    inspect_build_node(selected_nodes[2], "compile", "z", "f5a6648d97434ad965f2d514441cd95f313a8552f646c78f3953f1c64632b3c2", [String]{"check:main.jet"})
    inspect_build_node(selected_nodes[3], "link", "a", "1681d167e14a4756e39c418f57021e175412a19e5698dbbf7d75d42b1e0557b9", [String]{"compile:a"})
    inspect_build_node(selected_nodes[4], "link", "z", "6ee262f6a76fc357f28a0c1626f449eee38b0cd71762db26600dd4d1812dd336", [String]{"compile:z"})
    generated_request := inspect_build_request()
    loaded: jet_driver_source_query(generated_request)
    inspect_build_require(loaded.complete && loaded.entry_module_index >= 0, "generated owner is loader selected")
    generated_request.generated_modules = [JetDriverGeneratedModule]{{package_identity: loaded.modules[loaded.entry_module_index].package_identity, name: "generated", relative_path: "build/generated.jet", source: "generated_value: fn() -> Int {{ 7 }}"}}
    generated_response := jet_driver_query_build_nodes(generated_request, scope)
    generated_owner := generated_response.request.move()
    generated_query := generated_response.query.move()
    inspect_build_require(generated_owner.generated_modules.len() == 1, "preexisting generated source metadata is retained with its invocation owner")
    inspect_build_require(generated_query.complete && generated_query.nodes.len() == 4, "final generated source is a checked module")
    inspect_build_node(generated_query.nodes[0], "check", "build/generated.jet", "44c2d8f1800d86aa2eb502f4958d6957979516f43ff235564b842ad021e60129", [String]{"build/generated.jet"})
    inspect_build_require(generated_query.nodes[0].input_digests == [BuildGraphInputDigest]{{name: "build/generated.jet", digest: "e649fe69ef43c105ef6226997fc29370d0e8d5c3573859aa308c57a16c3ba1a9"}}, "generated bytes are retained, not omitted Doc modules or virtual origins")
    // A module a `Compiler` value made carries the authority and consent the
    // build froze when `build` returned: both are inputs of its check node,
    // so a change to either is a new identity for it and every node after it.
    made_request := inspect_build_request()
    made_request.generated_modules = [JetDriverGeneratedModule]{{package_identity: loaded.modules[loaded.entry_module_index].package_identity, name: "generated", relative_path: "build/generated.jet", source: "generated_value: fn() -> Int {{ 7 }}", authority: "Meta.Rewrite", consent: "greet"}}
    made_response := jet_driver_query_build_nodes(made_request, scope)
    made_query := made_response.query.move()
    inspect_build_require(made_query.complete && made_query.nodes.len() == 4, "a made module is a checked module")
    inspect_build_require(made_query.nodes[0].inputs == [String]{"authority", "build/generated.jet", "consent"}, "the check node names the frozen authority and consent")
    inspect_build_require(made_query.nodes[0].key != generated_query.nodes[0].key && made_query.nodes[1].key == generated_query.nodes[1].key && made_query.nodes[2].key != generated_query.nodes[2].key, "authority and consent are part of the module's and its output's identity, not its neighbor's")
    other_request := inspect_build_request()
    other_request.generated_modules = [JetDriverGeneratedModule]{{package_identity: loaded.modules[loaded.entry_module_index].package_identity, name: "generated", relative_path: "build/generated.jet", source: "generated_value: fn() -> Int {{ 7 }}", authority: "Meta.Rewrite", consent: "orm"}}
    other_response := jet_driver_query_build_nodes(other_request, scope)
    other_query := other_response.query.move()
    inspect_build_require(other_query.complete && other_query.nodes[0].key != made_query.nodes[0].key, "another consent is another identity")
    planned_text: jet_cli_build_nodes_host(inspect_build_request(), scope, "main.jet", "main", None, false, false, false)
    inspect_build_require(planned_text.exit_code == JET_DRIVER_EXIT_OK && planned_text.stdout == "no build recorded for main yet; planned steps:\ncheck\t0984cbcd63f1947088648f5c4d7e9b27b7d0f39b025f227e250ca7d2ce4e7b9f\tmain.jet\tmain.jet\ncompile\tfc25e6bcf7a37b9e22a1574a12a4554ce92960ca4f4558aa23c1c1ebea5b0629\tmain\tcheck:main.jet\nlink\tfa8fa4225fe9ff3c2e3d1c7c9047bfa17552676e618f5c4d91df4f325a86bc9e\tmain\tcompile:main\n", "no record lists the planned steps with no time or reason")
    planned_json: jet_cli_build_nodes_host(inspect_build_request(), scope, "main.jet", "main", None, true, false, false)
    inspect_build_require(planned_json.exit_code == JET_DRIVER_EXIT_OK && planned_json.stdout == "{{\"schema\":\"jet.explain-build/v1\",\"program\":\"main\",\"nodes\":[],\"planned\":[{{\"kind\":\"check\",\"key\":\"0984cbcd63f1947088648f5c4d7e9b27b7d0f39b025f227e250ca7d2ce4e7b9f\",\"subject\":\"main.jet\",\"inputs\":[\"main.jet\"]}},{{\"kind\":\"compile\",\"key\":\"fc25e6bcf7a37b9e22a1574a12a4554ce92960ca4f4558aa23c1c1ebea5b0629\",\"subject\":\"main\",\"inputs\":[\"check:main.jet\"]}},{{\"kind\":\"link\",\"key\":\"fa8fa4225fe9ff3c2e3d1c7c9047bfa17552676e618f5c4d91df4f325a86bc9e\",\"subject\":\"main\",\"inputs\":[\"compile:main\"]}}]}}\n", "no record has empty nodes and planned entries without duration_ms or why_ran")
    foreign: jet_cli_build_nodes_host(inspect_build_request(), scope, "main.jet", "main", Val(BuildRecord.new("other", [BuildNodeRecord]{})), true, false, false)
    inspect_build_require(foreign.exit_code == JET_DRIVER_EXIT_USER_ERROR && foreign.stdout.contains("E2104"), "a record for another program still refuses")
    broken := inspect_build_request()
    broken.authorized_sources.roots[0].files[0].source = "run: fn() -> Int {{ true }}"
    failed_response := jet_driver_query_build_plan(broken, scope)
    broken = failed_response.request.move()
    failed_query := failed_response.query.move()
    inspect_build_require(!failed_query.complete && failed_query.diagnostics.len() > 0, "no-build packages still undergo semantic checking")
    inspect_build_require(failed_query.nodes.len() == 0, "failed check publishes no static identities")
    human_failure: jet_cli_build_query_failure(broken, failed_query, "main.jet", false, false, false)
    inspect_build_require(human_failure.exit_code == JET_DRIVER_EXIT_USER_ERROR && human_failure.stdout == "" && human_failure.stderr.contains("problem") && human_failure.stderr.contains("found"), "build failures preserve canonical problem-count report")
    json_failure: jet_cli_build_query_failure(broken, failed_query, "main.jet", true, false, false)
    inspect_build_require(json_failure.exit_code == JET_DRIVER_EXIT_USER_ERROR && json_failure.stderr == "" && json_failure.stdout.contains("\"action\":\"diagnostics\""), "build failures preserve canonical diagnostics status envelope")
    advisory := diagnostic_from_registry("L0507", None, "prefer an ordered arm table", "one ordered arm table is the normal form", "use ordered arms")
    advisory.severity = DIAGNOSTIC_LINT
    with_advisory := failed_query
    with_advisory.diagnostics.push(advisory)
    quiet_failure: jet_cli_build_query_failure(broken, with_advisory, "main.jet", true, false, false)
    verbose_failure: jet_cli_build_query_failure(broken, with_advisory, "main.jet", true, false, true)
    inspect_build_require(!quiet_failure.stdout.contains("L0507") && verbose_failure.stdout.contains("L0507"), "build failure advisories require verbose presentation")
    internal_query: JetDriverBuildQueryResult{plan: None, graph: None, generated: [], diagnostics: [], complete: false, internal_problem: Val("build query lost its plan")}
    internal_failure: jet_cli_build_query_failure(inspect_build_request(), internal_query, "main.jet", true, false, false)
    inspect_build_require(internal_failure.exit_code == JET_CLI_EXIT_ICE && internal_failure.stdout == "" && internal_failure.stderr.contains("internal compiler error: build query lost its plan"), "internal query failures retain ICE exit and stream")
}

// A build query whose staging check failed, stopped before its plan with the
// build's reports `ran`, a refused call (`refused`) and the internal
// `problem`: an internal compiler error, never the staged report on the name
// the build would have generated.
inspect_build_stopped_is_internal: fn(ran: [Diagnostic], refused: Bool, problem: String) Never! {
    errors := [Diagnostic]{diagnostic_from_registry("E0107", None, "Nothing named `Shape` exists here", "A name must be declared before it's used", "Declare it first")}
    reports := ran
    held := String?{None}
    // copy: the query owns its problem; the checks below read this one.
    held = Val(problem.copy())
    request := inspect_build_request()
    response := jet_driver_build_query_stopped(request, errors, reports, true, refused, held)
    query := response.query.move()
    inspect_build_require(!query.complete && (query.internal_problem ?? "") == problem, "a staged build query keeps its internal problem: {problem}")
    failure: jet_cli_build_query_failure(response.request.move(), query, "main.jet", false, false, false)
    inspect_build_require(failure.exit_code == JET_CLI_EXIT_ICE && failure.stdout == "" && failure.stderr.contains("internal compiler error: {problem}") && !failure.stderr.contains("Shape"), "a staged build that failed internally is an internal compiler error: {problem}")
}
#Test("inspect_build staged internal problem") {
    // The trapped compile failed internally.
    inspect_build_stopped_is_internal([Diagnostic]{}, false, "the trapped compile lost its build entry")
    // The invocation could not run.
    inspect_build_stopped_is_internal([Diagnostic]{}, false, "the IR builder refused the invocation's code: a value of String where TypeId is expected")
    // The native run failed internally after the build refused a call.
    refusal: diagnostic_from_registry("E0357", None, "`meta.add_struct` was given the field name \"two words\", which is not an identifier", "generated source could not materialize", "Give a snake_case field name")
    inspect_build_stopped_is_internal([Diagnostic]{refusal}, true, "the native run of the build entry failed internally: compiler value handle 3 is not live")
    // Without an internal problem, a run that stopped at a trap restates the
    // staged report.
    staged := [Diagnostic]{diagnostic_from_registry("E0107", None, "Nothing named `Shape` exists here", "A name must be declared before it's used", "Declare it first")}
    none := [Diagnostic]{}
    held := String?{None}
    request := inspect_build_request()
    trapped := jet_driver_build_query_stopped(request, staged, none, true, false, held)
    trapped_query := trapped.query.move()
    trapped_failure: jet_cli_build_query_failure(trapped.request.move(), trapped_query, "main.jet", false, false, false)
    inspect_build_require(trapped_failure.exit_code == JET_DRIVER_EXIT_USER_ERROR && trapped_failure.stderr.contains("Shape"), "a staged run that stopped at a trap reports the staged check")
}

// The compiler under test, never this test binary, owns the runtime pack:
// planning `build: fn` runs compile-time code over its jet_runtime.image.
inspect_build_runtime_dir: fn() -> String {
    jet: build_sys.get("JET") ?? (build_process.which("jet") ?? panic("set JET to the compiler under test"))
    parts := jet.split("/").to_list()
    _ := parts.pop()
    "{parts.join("/")}/jet-runtime"
}
#Test("inspect_build planned fn build") {
    scope := JetDriverBuildQueryScope{}
    planned := inspect_build_request()
    planned.eval_config.native = Val(jet_cli_native_session_at(inspect_build_runtime_dir()) ?? panic("the compiler under test has no runtime pack"))
    planned.authorized_sources.roots[0].files[0].source = "build: fn(b: Build) {{}}\nrun: fn() {{}}"
    planned_response := jet_driver_query_build_nodes(planned, scope)
    planned_request := planned_response.request.move()
    planned_query := planned_response.query.move()
    inspect_build_require(planned_request.authorized_sources.entry_path == "/inspect-build/main.jet" && planned_request.selected_entry == None && planned_request.mode == JetDriverCompileMode.Doc && !planned_request.capture_build_program && !planned_request.capture_build_nodes, "build staging restores entry and selection before returning the invocation")
    inspect_build_require(planned_request.generated_modules.len() == 0 && planned_request.build_output_names.len() == 0, "final checked bundle leaves no temporary generated sources or output overrides in the request")
    inspect_build_require(planned_query.complete && planned_query.generated.len() == 0 && planned_query.nodes.len() == 3, "zero-generated plan keeps the staging check's nodes")
    // A build that generates nothing keeps the staging check's nodes; they
    // are the ones the final ordinary checked bundle would name.
    final_check := inspect_build_request()
    final_check.authorized_sources.roots[0].files[0].source = "build: fn(b: Build) {{}}\nrun: fn() {{}}"
    final_check.capture_build_nodes = true
    final_check.doc_core_on_demand = true
    final_result: jet_driver_compile(final_check)
    final_nodes: final_result.build_nodes ?? panic("the final ordinary bundle lost its nodes")
    inspect_build_require(final_nodes == planned_query.nodes, "the staging check's nodes are the final ordinary bundle's")
    planned_graph: planned_query.graph ?? panic("checked plan lost graph")
    planned_plan: planned_query.plan ?? panic("checked plan lost plan")
    inspect_build_require(planned_graph.nodes == planned_query.nodes && build_plan_graph(planned_plan).nodes == planned_query.nodes, "same finished Core plan owns the compiler nodes")
}
