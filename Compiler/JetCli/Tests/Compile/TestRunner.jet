#Test("Front wrapper uses shared settings refusal and samples bare shuffle only") {
    provider := jet_cli_test_journey_provider("")
    host := jet_cli_test_journey_host(0)
    mode :: JetCLIOutputMode{json: false, color: false, quiet: false}
    if jet_cli_test_command<JetCLITestJourneyProvider,JetCLITestJourneyHost>([String]{"test", "--capture=all", "--shuffle"}, mode, false, &provider, &host) == {
        .Completed(status) -> assert_eq(status, 0)
        else -> panic("bare default command refused")
    }
    assert(provider.calls.contains("context:true"))
    if jet_cli_test_command<JetCLITestJourneyProvider,JetCLITestJourneyHost>([String]{"test", "--set=x=1", "--set=x=2"}, mode, false, &provider, &host) == {
        .OptionsRefused(error) -> assert_eq(error.code, "E2104")
        else -> panic("canonical duplicate setting diagnostic lost")
    }
    // Rust main.rs:2984 parses settings before any target resolution or
    // clock sample, so the refused invocation never reaches the provider.
    assert(!provider.calls.contains("context:false"))
}

#Test("target preparation refusal records failure and continues package and directory") {
    scenarios :: [String]{"package-prepare-error", "directory-prepare-error"}
    loop scenario in scenarios {
        provider := jet_cli_test_journey_provider(scenario)
        host := jet_cli_test_journey_host(0)
        invocation :: jet_cli_test_journey_invocation()
        assert_eq(jet_cli_test_run_command<JetCLITestJourneyProvider,JetCLITestJourneyHost>(invocation, &provider, &host) ?? panic(err.message), 1)
        later :: if scenario.starts_with("package") -> "member.jet" else -> "second.jet"
        assert(provider.calls.contains("compile:{later}:false"))
        assert(provider.calls.contains("finalize:{later}:true"))
        assert_eq(host.calls.len(), 3)
        failed :: if scenario.starts_with("package") -> "main.jet" else -> "first.jet"
        assert(provider.calls.contains("stderr:couldn't read `{failed}`: fixture read refusal\n"))
    }
}
// Rust resolve_named_profile exits at the first target; no later member runs.
#Test("fatal target preparation refusal stops directory traversal") {
    provider := jet_cli_test_journey_provider("directory-profile-fatal")
    host := jet_cli_test_journey_host(0)
    invocation :: jet_cli_test_journey_invocation()
    if jet_cli_test_run_command<JetCLITestJourneyProvider,JetCLITestJourneyHost>(invocation, &provider, &host) == {
        .Ok(_) -> panic("unknown profile was treated as a failed target")
        .Err(error) -> assert_eq(error.code, "E1219")
    }
    assert(provider.calls.contains("prepare:first.jet"))
    assert(!provider.calls.contains("prepare:second.jet"))
    assert_eq(host.calls.len(), 0)
}
// Rust run_test_opts order: environment/existence, generated, where, watch,
// fresh status (write_mode_status: never in machine mode), then discovery.
#Test("command preamble order keeps discovery after where watch and fresh") {
    provider := jet_cli_test_journey_provider("package")
    host := jet_cli_test_journey_host(0)
    invocation := jet_cli_test_journey_invocation()
    invocation.options.where_expr = Val("")
    if jet_cli_test_run_command<JetCLITestJourneyProvider,JetCLITestJourneyHost>(invocation, &provider, &host) == {
        .Ok(_) -> panic("invalid where accepted")
        .Err(error) -> assert_eq(error.code, "E2104")
    }
    assert_eq(provider.calls, [String]{"environment:main.jet"})
    machine := jet_cli_test_journey_provider("")
    fresh := jet_cli_test_journey_invocation()
    fresh.options.fresh = true
    fresh.mode = JetCLIOutputMode{json: true, color: false, quiet: false}
    assert_eq(jet_cli_test_run_command<JetCLITestJourneyProvider,JetCLITestJourneyHost>(fresh, &machine, &host) ?? panic(err.message), 0)
    loop call in machine.calls -> assert(!call.contains("fresh result run"))
    human := jet_cli_test_journey_provider("")
    fresh.mode = JetCLIOutputMode{json: false, color: false, quiet: false}
    assert_eq(jet_cli_test_run_command<JetCLITestJourneyProvider,JetCLITestJourneyHost>(fresh, &human, &host) ?? panic(err.message), 0)
    assert_eq(human.calls[0], "environment:main.jet")
    assert_eq(human.calls[1], "stderr:jet test: fresh result run (test-result cache bypassed; build cache reusable)\n")
    assert_eq(human.calls[2], "discover:main.jet")
}
// Rust run_test_package: nothing testable re-enters run_test_opts for the
// entry file, repeating environment/existence and the fresh status line.
#Test("package without testable members re-enters the command for its entry") {
    provider := jet_cli_test_journey_provider("package-empty")
    host := jet_cli_test_journey_host(0)
    invocation := jet_cli_test_journey_invocation()
    invocation.target = "/project"
    invocation.options.fresh = true
    assert_eq(jet_cli_test_run_command<JetCLITestJourneyProvider,JetCLITestJourneyHost>(invocation, &provider, &host) ?? panic(err.message), 0)
    assert(provider.calls.contains("environment:/project") && provider.calls.contains("environment:main.jet"))
    assert(provider.calls.contains("discover:main.jet"))
    notices := 0
    loop call in provider.calls { if call.contains("fresh result run") -> notices += 1 }
    assert_eq(notices, 2)
    assert(provider.calls.contains("compile:main.jet:false"))
    assert_eq(host.calls.len(), 3)
}
// Rust run_test_watch never runs directory/package discovery; children get
// test <path> [--json] [--verbose] flags, and a spawn failure keeps watching.
#Test("watch skips discovery forwards machine and verbose and survives spawn failure") {
    provider := jet_cli_test_journey_provider("watch-spawn-error")
    host := jet_cli_test_journey_host(0)
    invocation := jet_cli_test_journey_invocation()
    invocation.options.watch = true
    invocation.mode = JetCLIOutputMode{json: true, color: false, quiet: false}
    invocation.advisory_lints_visible = true
    assert_eq(jet_cli_test_run_command<JetCLITestJourneyProvider,JetCLITestJourneyHost>(invocation, &provider, &host) ?? panic(err.message), 1)
    assert(provider.calls.contains("argv:test main.jet --json --verbose --quiet --capture=all"))
    assert(provider.calls.contains("stderr:jet test watcher: couldn't run child: fixture spawn refusal\n"))
    assert(provider.calls.contains("watch-close:1"))
    loop call in provider.calls -> assert(!call.starts_with("discover"))
}
#Test("finalization error continues package with failed cache and captured output") {
    provider := jet_cli_test_journey_provider("package-finalize-error")
    host := jet_cli_test_journey_host(0)
    invocation :: jet_cli_test_journey_invocation()
    assert_eq(jet_cli_test_run_command<JetCLITestJourneyProvider,JetCLITestJourneyHost>(invocation, &provider, &host) ?? panic(err.message), 1)
    assert(provider.calls.contains("finalize:main.jet:true"))
    assert(provider.calls.contains("finalize:member.jet:true"))
    assert(provider.calls.contains("cache-write:false"))
    assert(provider.calls.contains("cache-write:true"))
    assert(provider.calls.contains("stdout:fixture: pass\n"))
    assert_eq(host.calls.len(), 6)
    found := false
    loop call in provider.calls { if call.contains("finalize test evidence for `main.jet`: fixture finalization refusal") -> found = true }
    assert(found)
}
#Test("finalization error retains coverage and named capture completion") {
    provider := jet_cli_test_journey_provider("finalize-error")
    host := jet_cli_test_journey_host(0)
    invocation := jet_cli_test_journey_invocation()
    invocation.options.coverage = true
    invocation.options.record = Val("named")
    assert_eq(jet_cli_test_run_command<JetCLITestJourneyProvider,JetCLITestJourneyHost>(invocation, &provider, &host) ?? panic(err.message), 1)
    assert(provider.calls.contains("coverage"))
    assert(provider.calls.contains("coverage-remove"))
    assert(provider.calls.contains("stdout:fixture: pass\n"))
    assert(provider.calls.contains("record-begin"))
    assert(provider.calls.contains("record-finish:1"))
    assert_eq(host.calls, [String]{"launch", "wait", "close"})
}
#Test("cached and doctest finalization errors are failed targets without launching") {
    scenarios :: [String]{"cache-finalize-error", "docs-finalize-error"}
    loop scenario in scenarios {
        provider := jet_cli_test_journey_provider(scenario)
        host := jet_cli_test_journey_host(0)
        invocation := jet_cli_test_journey_invocation()
        invocation.options.docs = scenario.starts_with("docs")
        assert_eq(jet_cli_test_run_command<JetCLITestJourneyProvider,JetCLITestJourneyHost>(invocation, &provider, &host) ?? panic(err.message), 1)
        assert(provider.calls.contains("finalize:main.jet:true"))
        assert_eq(host.calls.len(), 0)
        if scenario.starts_with("cache") -> assert(provider.calls.contains("stdout:cached pass\n"))
    }
}
#Test("failed finalization cleans only private evidence") {
    scenarios :: [String]{"finalize-error", "finalize-error-preserved"}
    loop scenario in scenarios {
        provider := jet_cli_test_journey_provider(scenario)
        host := jet_cli_test_journey_host(0)
        invocation :: jet_cli_test_journey_invocation()
        assert_eq(jet_cli_test_run_command<JetCLITestJourneyProvider,JetCLITestJourneyHost>(invocation, &provider, &host) ?? panic(err.message), 1)
        removals := 0
        loop call in provider.calls { if call == "evidence-remove:main.jet" -> removals += 1 }
        assert_eq(removals, if scenario.contains("preserved") -> 1 else -> 2)
    }
}

// Actual Front route, not a local dispatcher. Focused Runner proofs cannot
// replace Front's process-wide machine-mode publication with a fake sys API.
#Test("Front test dispatch preserves owned argv output mode and verbose advisory") {
    facts :: output_adapter_test_facts()
    plan :: jet_cli_front([String]{"test", "main.jet", "--json", "--quiet", "--verbose", "--", "--filter=child", "evil; arg"}, facts)
    if plan == {
        .Test(arguments, mode, advisory_lints_visible) -> {
            assert_eq(arguments, [String]{"test", "main.jet", "--json", "--quiet", "--verbose"})
            assert(mode.json)
            assert(mode.quiet)
            assert(!mode.color)
            assert(advisory_lints_visible)
        }
        else -> panic("Front did not dispatch test")
    }
    normal :: jet_cli_front([String]{"test", "main.jet", "--", "--json", "--verbose"}, facts)
    if normal == {
        .Test(arguments, mode, advisory_lints_visible) -> {
            assert_eq(arguments, [String]{"test", "main.jet"})
            assert(!mode.json)
            assert(!mode.quiet)
            assert(!advisory_lints_visible)
        }
        else -> panic("Front did not dispatch test")
    }
}
