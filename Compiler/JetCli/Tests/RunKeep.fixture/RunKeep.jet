// `jet run` keeps its program (Compiler/JetCli/Source/Cli/ScriptCache.jet).
// A rerun reuses the `none` program with identical output, and marks it used
// only when its last mark is past the ten-minute use grain; no rerun builds
// it again at another level. A source edit, a change to a Core file the
// compile read and a compiler change each compile again and replace it; a
// change to a Core file it never read does not. A run at `-O2` keeps its
// `full` program in a slot of its own. The cache holds 64 programs and drops
// the least recently run one. Runs against copies: the compiler (beside its
// jet-runtime), a toolchain root holding only Core, and its own XDG caches.
// Usage: jet run Compiler/JetCli/Tests/RunKeep.fixture/RunKeep.jet -- <jet> <scratch>
// Run from the repository root: Core is copied from the working directory.
// It prints one line, the CompilerRegistries row's exact verdict.
use {
    files: core.files
    process: core.process
    term: core.term
    sys: core.sys
}

fail: fn(message: String) -> Never {
    term.eprint(message)
    process.exit(1)
}

// The fixed layout of one proof: the copied compiler, the toolchain root, the
// work directory and the default XDG cache.
Keep: struct {
    jet: String
    root: String
    work: String
    cache: String
}

// One finished `jet run`.
Ran: struct {
    code: Int
    signal: Int
    output: String
    errors: String
}

// The slot's record: its path, text and modification time, the program kept
// beside it, its sources hash and the optimize level the program was built at.
Slot: struct {
    record: String
    text: String
    secs: Int
    nanos: Int
    program: String
    sources: String
    level: String
}

run_raw: fn(keep: Keep, flags: [String], target: String, xdg: String) -> Ran {
    argv := [String]{keep.jet.copy(), "run"}
    loop flag in flags -> argv.push(flag.copy())
    argv.push(target.copy())
    receipt: process.cmd(argv).cwd(keep.work.copy()).env("JET_TOOLCHAIN_ROOT", keep.root.copy()).env("XDG_CACHE_HOME", xdg.copy()).env("NO_COLOR", "1").run() ?? fail("jet run failed: {err}")
    signal: receipt.signal ?? 0
    Ran{code: receipt.code, signal: signal, output: receipt.output.copy(), errors: receipt.errors.copy()}
}

run_at: fn(keep: Keep, flags: [String], target: String, xdg: String) -> String {
    ran: run_raw(keep, flags, target, xdg)
    if ran.code != 0 || ran.signal != 0 -> fail("jet run failed: code={ran.code} signal={ran.signal}\n{ran.output}{ran.errors}")
    ran.output.copy()
}

run_ok: fn(keep: Keep, target: String, xdg: String) -> String {
    run_at(keep, [String]{}, target, xdg)
}

check: fn(step: String, output: String, expected: String) {
    if output != expected -> fail("{step}: output {output.debug()}, expected {expected.debug()}")
}

// Every entry name of `directory`, sorted.
names_in: fn(directory: String) -> [String] {
    entries: files.list_dir(directory.copy()) ?? fail("cannot list {directory}: {err}")
    names := [String]{}
    loop entry in entries -> names.push(entry.name.copy())
    names.sort()
    names
}

// A kept program's file: anything but a slot record.
program_file: fn(name: String) -> Bool {
    !name.ends_with(".run")
}

slot: fn(kept: String) -> Slot {
    names: names_in(kept)
    records: names.filter(name -> name.ends_with(".run"))
    if records.len() != 1 -> fail("expected one slot record, found {names.join(", ")}")
    record: "{kept}/{records[0]}"
    text: files.read(record.copy()) ?? fail("cannot read {record}: {err}")
    lines: text.split("\n").to_list()
    if lines.len() < 4 -> fail("slot record {record} names no program")
    program: lines[1].copy()
    programs: names.filter(name -> program_file(name))
    if programs.len() != 1 || programs[0] != program -> fail("expected only the program {program}, found {names.join(", ")}")
    modified: (files.stat(record.copy()) ?? fail("cannot stat {record}: {err}")).modified
    Slot{record: record.copy(), text: text.copy(), secs: modified.secs, nanos: modified.nanos, program: program.copy(), sources: lines[2].copy(), level: lines[3].copy()}
}

// The optimize level of each slot record in `kept`, sorted.
levels: fn(kept: String) -> [String] {
    found := [String]{}
    loop name in names_in(kept).filter(name -> name.ends_with(".run")) {
        text: files.read("{kept}/{name}") ?? fail("cannot read {name}: {err}")
        lines: text.split("\n").to_list()
        if lines.len() < 4 -> fail("slot record {name} names no program")
        found.push(lines[3].copy())
    }
    found.sort()
    found
}

// Reused: the same record naming the same program, left as it was: a record
// written within the use grain (ScriptCache.jet JET_CLI_SCRIPT_USED_GRAIN_NS)
// is already marked, so the rerun writes nothing.
reused: fn(kept: String, step: String, before: Slot) -> Slot {
    after: slot(kept)
    if after.text != before.text -> fail("{step}: the kept program was replaced, not reused")
    if after.secs != before.secs || after.nanos != before.nanos -> fail("{step}: the record, marked moments ago, was written again")
    after
}

// Set the mark of the slot record `record` to `secs` seconds.
age: fn(record: String, secs: Int) {
    #Unsafe("the test owns the slot record it ages") {
        sys.utime(record.copy(), secs, secs) ?? fail("cannot age {record}: {err}")
    }
}

// `before`'s record with its mark set back eleven minutes, past the use grain.
aged: fn(kept: String, before: Slot) -> Slot {
    age(before.record, before.secs - 660)
    slot(kept)
}

// Marked: the same record naming the same program, its old mark `before`
// renewed by the rerun `step`.
marked: fn(kept: String, step: String, before: Slot) -> Slot {
    after: slot(kept)
    if after.text != before.text -> fail("{step}: the kept program was replaced, not reused")
    later: after.secs > before.secs || (after.secs == before.secs && after.nanos > before.nanos)
    if !later -> fail("{step}: the reused record, last marked eleven minutes ago, was not marked used")
    after
}

rebuilt: fn(kept: String, step: String, before: Slot) -> Slot {
    after: slot(kept)
    if after.program == before.program -> fail("{step}: still the program {before.program}; expected a new compile")
    if after.level != "none" -> fail("{step}: the compile kept a program built at {after.level}, not none")
    after
}

write: fn(path: String, text: String) {
    files.write(path.copy(), text.copy()) ?? fail("cannot write {path}: {err}")
}

// A kept run of the stopping program reports it as the compiling run did.
same_stop: fn(name: String, ran: Ran, compiled: Ran) {
    if ran.code != compiled.code -> fail("stopping program: {name} code {ran.code}, compiling run {compiled.code}")
    if ran.signal != compiled.signal -> fail("stopping program: {name} signal {ran.signal}, compiling run {compiled.signal}")
    if ran.output != compiled.output -> fail("stopping program: {name} stdout {ran.output.debug()}, compiling run {compiled.output.debug()}")
    if ran.errors != compiled.errors -> fail("stopping program: {name} stderr {ran.errors.debug()}, compiling run {compiled.errors.debug()}")
}

greeting: fn(word: String) -> String {
    "run: fn() {{\n    print(\"hello {word}\")\n}}\n"
}

// A greeting that reads core.time, so its compile reads Core/Time/Time.jet.
timed_greeting: fn(word: String) -> String {
    "use {{\n    time: core.time\n}}\n\nrun: fn() {{\n    if time.duration_ms(1).ns < 0 -> print(\"never\")\n    print(\"hello {word}\")\n}}\n"
}

// Whether the slot record `state` names the Core file `path` as one its
// compile read.
reads_core: fn(state: Slot, path: String) -> Bool {
    state.text.split("\n").to_list().any(line -> line.starts_with("{path} "))
}

// A cap cache's slot records and its programs (one beside each record).
Cap: struct {
    records: [String]
    programs: [String]
}

cap_state: fn(cap_kept: String) -> Cap {
    names: names_in(cap_kept)
    records: names.filter(name -> name.ends_with(".run"))
    programs: names.filter(name -> program_file(name))
    if records.len() != programs.len() -> fail("cap: {records.len()} records beside {programs.len()} programs: {names.join(", ")}")
    Cap{records: records.copy(), programs: programs.copy()}
}

cap_entry: fn(keep: Keep, index: Int) -> String {
    "{keep.work}/cap{index}.jet"
}

cap_run: fn(keep: Keep, cap_cache: String, index: Int) {
    check("cap entry {index}", run_ok(keep, cap_entry(keep, index), cap_cache), "entry {index}\n")
}

run: fn() {
    args: process.args()
    if args.len() != 2 -> fail("usage: jet run Compiler/JetCli/Tests/RunKeep.jet -- <jet> <scratch>")
    given: files.canonicalize(args[0].copy()) ?? fail("cannot resolve {args[0]}: {err}")
    scratch: files.absolute(args[1].copy()) ?? fail("cannot resolve {args[1]}: {err}")
    repo: files.canonicalize(".") ?? fail("cannot resolve the repository root: {err}")
    if files.exists(scratch.copy()) -> files.remove_all(scratch.copy()) ?? fail("cannot clear {scratch}: {err}")
    bin: "{scratch}/bin"
    keep: Keep{jet: "{bin}/jet", root: "{scratch}/root", work: "{scratch}/work", cache: "{scratch}/cache"}
    directories: [String]{bin, keep.root, keep.work, keep.cache}
    loop directory in directories {
        files.create_dir_all(directory.copy()) ?? fail("cannot create {directory}: {err}")
    }
    files.copy(given.copy(), keep.jet.copy()) ?? fail("cannot copy {given}: {err}")
    given_dir: given.removesuffix("/jet")
    runtime: files.canonicalize("{given_dir}/jet-runtime") ?? fail("cannot resolve {given_dir}/jet-runtime: {err}")
    files.symlink(runtime.copy(), "{bin}/jet-runtime") ?? fail("cannot link the jet-runtime: {err}")
    files.copy_dir("{repo}/Core", "{keep.root}/Core") ?? fail("cannot copy Core: {err}")
    kept: "{keep.cache}/jet/scripts"
    file: "{keep.work}/greet.jet"

    write(file, greeting("one"))
    first: run_ok(keep, file, keep.cache)
    check("first run", first, "hello one\n")
    state := slot(kept)
    // The kept form holds the program part and the image's patches, not a copy
    // of the runtime image.
    image: "{bin}/jet-runtime/jet_runtime.image"
    if !files.exists(image.copy()) -> fail("first run: no runtime image beside the compiler")
    kept_size: (files.stat("{kept}/{state.program}") ?? fail("cannot stat the kept program: {err}")).size
    image_size: (files.stat(image.copy()) ?? fail("cannot stat {image}: {err}")).size
    if kept_size >= image_size -> fail("first run: the kept program has {kept_size} bytes, no fewer than the runtime image {image}")
    check("rerun", run_ok(keep, file, keep.cache), first)
    state = reused(kept, "rerun", state)
    if state.level != "none" -> fail("rerun: the reused program was built at {state.level}, not none")
    state = aged(kept, state)
    check("rerun of an old mark", run_ok(keep, file, keep.cache), first)
    state = marked(kept, "rerun of an old mark", state)

    write(file, greeting("two"))
    check("source edit", run_ok(keep, file, keep.cache), "hello two\n")
    state = rebuilt(kept, "source edit", state)
    check("rerun after the edit", run_ok(keep, file, keep.cache), "hello two\n")
    state = reused(kept, "rerun after the edit", state)
    // A file the program writes beside its source is no compile input.
    write("{keep.work}/greet.out", "written beside the source\n")
    check("non-source file beside the entry", run_ok(keep, file, keep.cache), "hello two\n")
    state = reused(kept, "non-source file beside the entry", state)

    // hello reads no Core file, so a change to one is no input of it.
    time_file: "{keep.root}/Core/Time/Time.jet"
    files.append_all(time_file.copy(), "\n// run-keep: a change to a Core file hello never read\n") ?? fail("cannot change Core: {err}")
    check("change of a Core file it never read", run_ok(keep, file, keep.cache), "hello two\n")
    state = reused(kept, "change of a Core file it never read", state)
    if reads_core(state, "Core/Time/Time.jet") -> fail("change of a Core file it never read: the record names Core/Time/Time.jet")

    // A program that reads core.time names Time.jet in its record, and a
    // change to Time.jet compiles it again.
    write(file, timed_greeting("two"))
    check("source that reads Core", run_ok(keep, file, keep.cache), "hello two\n")
    state = rebuilt(kept, "source that reads Core", state)
    if !reads_core(state, "Core/Time/Time.jet") -> fail("source that reads Core: the record names no Core/Time/Time.jet row")
    check("rerun of the Core reader", run_ok(keep, file, keep.cache), "hello two\n")
    state = reused(kept, "rerun of the Core reader", state)
    files.append_all(time_file.copy(), "\n// run-keep: a Core change\n") ?? fail("cannot change Core: {err}")
    check("Core change", run_ok(keep, file, keep.cache), "hello two\n")
    state = rebuilt(kept, "Core change", state)

    // A new compiler binary in the same place: a new file identity.
    files.remove(keep.jet.copy()) ?? fail("cannot remove the compiler copy: {err}")
    files.copy(given.copy(), keep.jet.copy()) ?? fail("cannot copy {given}: {err}")
    check("compiler change", run_ok(keep, file, keep.cache), "hello two\n")
    state = rebuilt(kept, "compiler change", state)
    check("rerun after the compiler change", run_ok(keep, file, keep.cache), "hello two\n")
    state = reused(kept, "rerun after the compiler change", state)

    // A slot an earlier compiler's background build left holding a `full`
    // program: the plain run's level is `none`, so it compiles again.
    stale := state.text.split("\n").to_list()
    stale[3] = "full"
    write(state.record, stale.join("\n"))
    check("rerun of a promoted slot", run_ok(keep, file, keep.cache), "hello two\n")
    state = rebuilt(kept, "rerun of a promoted slot", state)

    // A program that stops: the kept run reports it as the compiling run did.
    write(file, "run: fn() {{\n    print(\"before\")\n    panic(\"run-keep stop\")\n}}\n")
    compiled: run_raw(keep, [String]{}, file, keep.cache)
    state = rebuilt(kept, "stopping program", state)
    if compiled.code == 0 && compiled.signal == 0 -> fail("stopping program: exit 0\n{compiled.errors}")
    rerun: run_raw(keep, [String]{}, file, keep.cache)
    state = reused(kept, "stopping program rerun", state)
    same_stop("kept run", rerun, compiled)

    // The level: a run at `-O2` keeps its `full` program in a slot of its
    // own beside the plain run's `none` one, and each rerun reuses its own.
    level_kept: "{scratch}/level-cache/jet/scripts"
    write(file, greeting("three"))
    check("plain run", run_ok(keep, file, "{scratch}/level-cache"), "hello three\n")
    check("-O2 run", run_at(keep, [String]{"-O2"}, file, "{scratch}/level-cache"), "hello three\n")
    leveled: cap_state(level_kept)
    if levels(level_kept) != ([String]{"full", "none"}) -> fail("-O2 run: the slots hold programs built at {levels(level_kept).join(", ")}, not full and none")
    check("plain rerun", run_ok(keep, file, "{scratch}/level-cache"), "hello three\n")
    check("-O2 rerun", run_at(keep, [String]{"-O2"}, file, "{scratch}/level-cache"), "hello three\n")
    if cap_state(level_kept).programs != leveled.programs -> fail("level reruns: a kept program was compiled again")

    // The cap: 64 entry files fill the cache. Each entry's mark is set back
    // past the use grain, a second later than the one before, so the marks
    // keep the order of the runs to the second. A rerun of the first marks it
    // used, so keeping a 65th drops the second, which compiles again when run.
    cap_cache: "{scratch}/cap-cache"
    cap_kept: "{cap_cache}/jet/scripts"
    loop index in 0..<65 -> write(cap_entry(keep, index), "run: fn() {{\n    print(\"entry {index}\")\n}}\n")
    base := 0
    loop index in 0..<64 {
        known: if index == 0 -> [String]{} else -> cap_state(cap_kept).records.copy()
        cap_run(keep, cap_cache, index)
        fresh: cap_state(cap_kept).records.filter(name -> !known.contains(name))
        if fresh.len() != 1 -> fail("cap: entry {index} kept {fresh.len()} new records")
        record: "{cap_kept}/{fresh[0]}"
        if index == 0 -> base = (files.stat(record.copy()) ?? fail("cannot stat {record}: {err}")).modified.secs - 700
        age(record, base + index)
    }
    before := cap_state(cap_kept)
    if before.records.len() != 64 -> fail("cap: {before.records.len()} programs kept after 64 entries")
    cap_run(keep, cap_cache, 0)
    cap_run(keep, cap_cache, 64)
    before = cap_state(cap_kept)
    if before.records.len() != 64 -> fail("cap: {before.records.len()} programs kept after a 65th entry")
    cap_run(keep, cap_cache, 0)
    if cap_state(cap_kept).programs != before.programs -> fail("cap: entry 0, the most recently run, was dropped or compiled again")
    cap_run(keep, cap_cache, 1)
    after: cap_state(cap_kept)
    fresh: after.records.filter(name -> !before.records.contains(name))
    if after.records.len() != 64 || fresh.len() == 0 -> fail("cap: entry 1, the least recently run, was not compiled again")
    term.print("run-keep: reuse and its use mark, source/Core/compiler rebuilds, a promoted slot rebuilt, stop parity, a slot per level and the 64-program cap: ok")
}
