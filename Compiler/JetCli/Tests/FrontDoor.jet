// The real front door keeps opaque engine arguments and renderable channels.
use {
    jet_cli.[
        JET_CLI_JETPACK_BINARY, JetCLIPlan, jet_cli_alias_args, jet_cli_command_help, jet_cli_engine_commands,
        jet_cli_help, jet_cli_plan, jet_cli_renderable, jet_cli_structural_help,
    ]
    jet_driver.[JET_DRIVER_EXIT_USAGE]
    jet_pkg_model.[pkg_jet_build, pkg_version_json]
}

cli_front_fixture_done: fn(plan: JetCLIPlan, stdout: String, stderr: String, code: Int) Never! {
    if plan == {
        .Done(output) -> {
            if output.stdout != stdout || output.stderr != stderr || output.exit_code != code -> panic("front-door streams/status")
        }
        .Refused(_, _, _, _) | .Diagnostics(_, _, _, _, _) | .Check(_, _, _, _, _, _, _, _, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) -> panic("expected completed front-door plan")
    }
}

cli_front_fixture_engine: fn(plan: JetCLIPlan, verb: String, argv: [String]) Never! {
    if plan == {
        .InspectB(.Engine(engine, actual_verb, actual_argv)) -> {
            if engine != JET_CLI_JETPACK_BINARY || actual_verb != verb || actual_argv != argv -> panic("opaque engine dispatch must retain argv exactly")
        }
        .Done(_) | .Refused(_, _, _, _) | .Diagnostics(_, _, _, _, _) | .Check(_, _, _, _, _, _, _, _, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) -> panic("expected canonical engine plan")
    }
}

#Test("front_door") {
    loop verb in ([String]{"cc", "c++"}) {
        argv: [String]{verb, "--version", "--help", "--unknown-compiler-option", "--", "source with spaces.c", "-Werror"}
        cli_front_fixture_engine(jet_cli_plan(argv), verb, argv)
    }
    loop verb in ([String]{"trust", "image", "os", "search", "clean"}) {
        argv: [String]{verb, "--unknown-engine-option", "--", "argument with spaces", "--json"}
        forwarded: jet_cli_engine_commands(verb, argv) ?? panic("registered engine verb")
        cli_front_fixture_engine(forwarded, verb, argv)
    }
    env_argv: [String]{"--quiet", "env", "run", "--", "--help", "argument with spaces"}
    forwarded_env: jet_cli_engine_commands("env", env_argv) ?? panic("env forwarding")
    cli_front_fixture_engine(forwarded_env, "env", [String]{"env", "--quiet", "run", "--", "--help", "argument with spaces"})
    if jet_cli_engine_commands("check", [String]{"check", "source.jet"}) != None -> panic("compiler verbs must not become engine dispatch")
    cli_front_fixture_done(jet_cli_renderable("human\n", false), "human\n", "", 0)
    cli_front_fixture_done(jet_cli_renderable("human\n", true), "", "", 0)
    // Version has a machine record; help has none.
    cli_front_fixture_done(jet_cli_plan([String]{"version", "--json"}), pkg_version_json(pkg_jet_build()), "", 0)
    cli_front_fixture_done(jet_cli_plan([String]{"help", "--json"}), "", "", 0)
    cli_front_fixture_done(jet_cli_plan([String]{"--version", "--json"}), pkg_version_json(pkg_jet_build()), "", 0)
    cli_front_fixture_done(jet_cli_plan([String]{"help", "diff"}), jet_cli_structural_help("diff") ?? panic("diff help"), "", 0)
    invalid: jet_cli_help([String]{"help", "--sort=not-an-order"}, [String]{"help"}, None, false, true)
    if invalid == {
        .Refused(report, _, code, _) -> {
            if report.code != "E2104" || code != 2 -> panic("machine mode never hides invalid help ordering")
        }
        .Done(_) | .Diagnostics(_, _, _, _, _) | .Check(_, _, _, _, _, _, _, _, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) -> panic("invalid help ordering must refuse")
    }
}

#Test("try front door carries exact plan keep and JSON selections") {
    cases: [(keep: Bool, json: Bool, quiet: Bool)]{(keep: false, json: false, quiet: false), (keep: true, json: false, quiet: false), (keep: false, json: true, quiet: false), (keep: true, json: true, quiet: true)}
    loop selected in cases {
        argv := [String]{"try", "plan with spaces.json", "ignored-extra-target"}
        if selected.keep -> argv.push("--keep")
        if selected.json -> argv.push("--json")
        if selected.quiet -> argv.push("--quiet")
        if jet_cli_plan(argv) == {
            .Try(plan_path, keep, json) -> {
                assert_eq(plan_path, "plan with spaces.json")
                assert_eq(keep, selected.keep)
                assert_eq(json, selected.json)
            }
            .Done(_) | .Refused(_, _, _, _) | .Diagnostics(_, _, _, _, _) | .Check(_, _, _, _, _, _, _, _, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) -> panic("try must retain its actual plan projection")
        }
    }
    cli_front_fixture_done(jet_cli_plan([String]{"try"}), "", jet_cli_command_help("try"), JET_DRIVER_EXIT_USAGE)
    cli_front_fixture_done(jet_cli_plan([String]{"try", "--keep", "--quiet"}), "", "", JET_DRIVER_EXIT_USAGE)
    cli_front_fixture_done(jet_cli_plan([String]{"try", "--json"}), "", "", JET_DRIVER_EXIT_USAGE)
}

cli_front_alias_fixture: fn(alias: String, verb: String) Never! {
    tail: [String]{"-c", "main.c", "--", "source with spaces.c"}
    argv := [String]{alias}
    expected := [String]{}
    if verb != "" -> expected.push(verb.copy())
    loop argument in tail {
        argv.push(argument.copy())
        expected.push(argument)
    }
    assert_eq(jet_cli_alias_args(argv), expected)
    if verb != "" -> cli_front_fixture_engine(jet_cli_plan(jet_cli_alias_args(argv)), verb, expected)
}

// cc-driver.md: `jet-cc` is `jet cc`; `jet-cxx` and `jet-c++` are `jet c++`.
#Test("compiler aliases select their verb from argv0") {
    cli_front_alias_fixture("jet-cc", "cc")
    cli_front_alias_fixture("/opt/jet/bin/jet-cxx", "c++")
    cli_front_alias_fixture("../bin/jet-c++", "c++")
    cli_front_alias_fixture("C:\\jet\\jet-cc.exe", "cc")
    loop name in ([String]{"jet", "/usr/bin/jet", "jet-ccx", "xjet-cc", "jet-cc.sh"}) -> cli_front_alias_fixture(name, "")
    assert_eq(jet_cli_alias_args([String]{}), [String]{})
    assert_eq(jet_cli_alias_args([String]{"jet-cc"}), [String]{"cc"})
}
