// `jet __jetpack <op>`: the internal compiler service verb owns its raw
// arguments, stays out of help, and refuses what it can't read as a usage
// error instead of guessing.
fn jetpack_service_fixture_usage(output: JetDriverVerbOutput, needle: String) Never! {
    assert_eq(output.exit_code, JET_DRIVER_EXIT_USAGE)
    assert_eq(output.stdout, "")
    assert(output.stderr.contains("E2104"), output.stderr)
    assert(output.stderr.contains(needle), output.stderr)
}

fn run() {
    loop op in ([String]{JET_COMPILER_SERVICE_COMPTIME_EVALUATE, JET_COMPILER_SERVICE_CHECK_ENTRY, "unknown-op"}) {
        if jet_cli_plan([String]{JET_COMPILER_SERVICE_VERB, op}) == {
            .CompilerService(planned) -> assert_eq(planned, op)
            else -> panic("`jet __jetpack <op>` plans the compiler service")
        }
    }
    // The verb owns every argument: flags after it are not jet's.
    if jet_cli_plan([String]{JET_COMPILER_SERVICE_VERB, JET_COMPILER_SERVICE_CHECK_ENTRY, "--json"}) == {
        .Done(output) -> jetpack_service_fixture_usage(output, "exactly one operation")
        else -> panic("an extra service argument is a usage error")
    }
    if jet_cli_plan([String]{JET_COMPILER_SERVICE_VERB}) == {
        .Done(output) -> jetpack_service_fixture_usage(output, "exactly one operation")
        else -> panic("a missing service operation is a usage error")
    }
    help :: jet_cli_plan([String]{"help"})
    if help == {
        .Done(output) -> assert(!output.stdout.contains(JET_COMPILER_SERVICE_VERB) && !output.stderr.contains(JET_COMPILER_SERVICE_VERB), "the service verb is never in help")
        else -> {}
    }
    jetpack_service_fixture_usage(jet_cli_compiler_service("unknown-op"), "`unknown-op` is not a compiler service operation")
    jetpack_service_fixture_usage(jet_cli_compiler_service_answer(JET_COMPILER_SERVICE_COMPTIME_EVALUATE, "not json"), "not valid protocol JSON")
    jetpack_service_fixture_usage(jet_cli_compiler_service_answer(JET_COMPILER_SERVICE_COMPTIME_EVALUATE, "{{\"program\":\"x\"}}"), "`program` and `base_dir`")
    jetpack_service_fixture_usage(jet_cli_compiler_service_answer(JET_COMPILER_SERVICE_CHECK_ENTRY, "{{\"file\":\"main.jet\"}}"), "`file` and `source`")
    // A check whose entry can't be read keeps the loader's refusal.
    missing :: jet_cli_compiler_service_answer(JET_COMPILER_SERVICE_CHECK_ENTRY, compiler_service_check_request("/nonexistent/jetpack-service/main.jet", "fn run() {{ }}\n"))
    assert(missing.exit_code != JET_DRIVER_EXIT_OK, "an unreadable entry is not a clean check")
    assert(missing.stderr.contains("E2105"), missing.stderr)
}
