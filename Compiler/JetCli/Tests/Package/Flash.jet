fn flash_test_adapter_none() -> JetCLIFlashAdapter? Never! { None }
fn flash_test_build(host: &FlashTestHost, machine: MIRTargetMachine) -> JetCLIFlashPlan JetCLIFlashError! {
    jet_cli_flash_plan_from_machine<FlashTestHost>(&host, machine, flash_paths.of("/out/firmware.elf"), flash_test_no_path(), flash_test_adapter_none())
}
fn flash_test_build_error(host: &FlashTestHost, machine: MIRTargetMachine) -> String Never! {
    if flash_test_build(&host, machine) == {
        .Ok(_) -> panic("expected plan refusal")
        .Err(failure) -> ~failure.message
    }
}
fn flash_test_machine() -> MIRTargetMachine Never! {
    machine := jet_target_machine_board_sensor_v1("test")
    machine.programmers = [MIRTargetProgrammerFacts]{flash_test_facts(MIRTargetProgrammerAdapter.ProbeRs)}
    machine
}
fn flash_test_host_for_machine(machine: MIRTargetMachine) -> FlashTestHost Never! {
    audit := flash_test_file("/out/firmware.target.json")
    digest :: mir_sha256_hex("/out/firmware.elf")
    audit.text = "{{\"name\":{jet_target_json_quote(machine.name)},\"triple\":{jet_target_json_quote(machine.triple)},\"environment\":{jet_target_json_quote(jet_target_environment_identity(machine))},\"provider_identity\":{jet_target_json_quote(jet_target_provider_identity(machine))},\"image_sha256\":\"{digest}\"}}"
    FlashTestHost{files: [String:FlashTestFile]{"/out/firmware.elf": flash_test_file("/out/firmware.elf"), "/out/firmware.target.json": audit, "/bin/tool": flash_test_file("/bin/tool")}, path: Val([Path]{flash_paths.of("/bin")})}
}
