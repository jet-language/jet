#Test("flash builder hosted and canonical validation precede filesystem effects") {
    empty := FlashTestHost{files: [String:FlashTestFile]{}, path: None}
    hosted :: jet_target_machine_hosted("x86_64-unknown-linux-gnu", "test")
    assert_eq(flash_test_build_error(&empty, hosted), "target `hosted` is hosted; flashing requires a no-OS board or emulator profile")
    machine := flash_test_machine()
    machine.triple = ""
    validation :: jet_target_machine_validate(machine, jet_target_machine_use_default())
    assert(!validation.is_empty())
    assert_eq(flash_test_build_error(&empty, machine), "target `board.sensor_v1` failed canonical profile validation: {jet_target_machine_errors_debug(validation)}")
    machine = flash_test_machine()
    machine.memory[0].kind = MIRMemoryKind.Reserved
    validation_no_flash :: jet_target_machine_validate(machine, jet_target_machine_use_default())
    // No-flash branch in FlashPlan is defensive: canonical validation reports
    // MissingMemoryKind(Flash) first, so it cannot be reached with real facts.
    assert_eq(flash_test_build_error(&empty, machine), "target `board.sensor_v1` failed canonical profile validation: {jet_target_machine_errors_debug(validation_no_flash)}")
}
#Test("flash builder immutable image metadata size hash and UTF-8 filename order") {
    machine :: flash_test_machine()
    host := flash_test_host_for_machine(machine)
    image := flash_test_file("/out/firmware.elf")
    image.metadata_error = Val("stat failed")
    image.metadata.bytes = 4194305
    image.hash_error = Val("hash failed")
    image.non_utf8_name = true
    host.files["/out/firmware.elf"] = ~image
    assert_eq(flash_test_build_error(&host, machine), "cannot inspect flash image `/out/firmware.elf`: stat failed")
    image.metadata_error = None
    host.files["/out/firmware.elf"] = ~image
    assert_eq(flash_test_build_error(&host, machine), "flash image `/out/firmware.elf` is 4194305 bytes but target `board.sensor_v1` declares only 4194304 flash bytes")
    image.metadata.bytes = 4194304
    host.files["/out/firmware.elf"] = ~image
    assert_eq(flash_test_build_error(&host, machine), "cannot hash flash image `/out/firmware.elf`: hash failed")
    image.hash_error = None
    host.files["/out/firmware.elf"] = ~image
    assert_eq(flash_test_build_error(&host, machine), "flash path is not UTF-8 at byte 2")
    image.non_utf8_name = false
    host.files["/out/firmware.elf"] = ~image
    plan :: flash_test_build(&host, machine) ?? panic("plan")
    assert_eq(plan.image_bytes, 4194304)
    assert_eq(plan.image_sha256, mir_sha256_hex("/out/firmware.elf"))
    assert_eq(plan.tool_identity, mir_sha256_hex("/bin/tool"))
    assert_eq(plan.argv, [String]{"tool", "download", "--chip", "chip", "--probe", "iface", "--speed", "1000", "--connect-under-reset", "firmware.elf"})
    assert_eq(plan.audit_sha256, mir_sha256_hex((host.files.get("/out/firmware.target.json") ?? panic("audit")).text))
}
