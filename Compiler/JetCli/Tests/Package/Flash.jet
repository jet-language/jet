#Test("flash builder uses largest flash region not sum and refuses unsafe OpenOCD before PATH") {
    machine := flash_test_machine()
    &machine.memory.push(jet_target_memory_region_new("flash2", 0x10000000, MIRByteSize{bytes: 8388608}, .Flash, .Rx))
    host := flash_test_host_for_machine(machine)
    image := flash_test_file("/out/firmware.elf")
    image.metadata.bytes = 8388608
    host.files["/out/firmware.elf"] = ~image
    plan :: flash_test_build(&host, machine) ?? panic("largest capacity")
    assert_eq(plan.image_bytes, 8388608)
    image.metadata.bytes = 8388609
    host.files["/out/firmware.elf"] = ~image
    assert_eq(flash_test_build_error(&host, machine), "flash image `/out/firmware.elf` is 8388609 bytes but target `board.sensor_v1` declares only 8388608 flash bytes")
    machine.programmers = [MIRTargetProgrammerFacts]{flash_test_facts(MIRTargetProgrammerAdapter.OpenOcd)}
    host = flash_test_host_for_machine(machine)
    unsafe_image :: "/out/evil;file.elf"
    image = flash_test_file(unsafe_image)
    host.files["/out/firmware.elf"] = ~image
    host.files[unsafe_image] = ~image
    audit := flash_test_file("/out/evil;file.target.json")
    audit.text = "{{\"name\":{jet_target_json_quote(machine.name)},\"triple\":{jet_target_json_quote(machine.triple)},\"environment\":{jet_target_json_quote(jet_target_environment_identity(machine))},\"provider_identity\":{jet_target_json_quote(jet_target_provider_identity(machine))}}}"
    host.files["/out/evil;file.target.json"] = audit
    host.path = None
    assert_eq(flash_test_build_error(&host, machine), "image filename `evil;file.elf` cannot be passed to OpenOCD safely")
    facts := flash_test_facts(MIRTargetProgrammerAdapter.ProbeRs)
    facts.executable = "a/b"
    machine.programmers = [MIRTargetProgrammerFacts]{facts}
    host = flash_test_host_for_machine(machine)
    host.path = None
    assert_eq(flash_test_build_error(&host, machine), "declared flash tool `a/b` is not a bare executable")
}
