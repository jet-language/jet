    host = flash_test_host_for_machine(machine)
    tool := flash_test_file("/bin/tool")
    tool.hash_error = Val("hash failed")
    host.files["/bin/tool"] = tool
    assert_eq(flash_test_build_error(&host, machine), "cannot hash declared flash tool `/bin/tool`: hash failed")
    error := ""
    _ :: flash_test_from_machine(&host, machine, Val(JetCLIFlashAdapter.OpenOcd)) ?? {
        error = ~err.message
        flash_test_plan()
    }
    assert_eq(error, "target `board.sensor_v1` does not declare the `openocd` adapter (declared: probe-rs)")
}
