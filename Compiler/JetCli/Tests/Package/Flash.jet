// #4381 PATH BEGIN: original receipt bounds test retained; full proof owed after Path identity fix.
#Test("receipt bounds both streams and hashes lossy text including the truncation marker") {
    output := [U8]{}
    loop _ in 0..<65537 -> &output.push(U8{255})
    execution :: JetCLIFlashExecution{status: Val(0), stdout: ~output, stderr: ~output, mechanism: "sandbox", policy: "strict", failure: None}
    receipt :: jet_cli_flash_receipt_from_execution(flash_test_plan(), ^execution)
    assert(receipt.stdout_truncated)
    assert(receipt.stderr_truncated)
    assert_eq(receipt.stdout.len(), 65536)
    assert_eq(receipt.stderr.len(), 65536)
    assert_eq(receipt.result_identity, "flash-result-v1:{canonical_json_sha256(jet_cli_flash_receipt_result_json(receipt))}")
    if jet_cli_flash_receipt_result_json(receipt) == .Object(fields) {
        loop field in fields {
            if field.key == "stdout" {
                if field.value == .String(text) {
                    assert(text.ends_with("\n<output truncated>\n"))
                    assert(text.starts_with("�"))
                } else {
                    panic("stdout is text")
                }
            }
        }
    } else {
        panic("result is object")
    }
}
