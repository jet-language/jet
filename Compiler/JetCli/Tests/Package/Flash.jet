// #4376 HOST BEGIN: original host refusal test retained; full proof owed after owner lowering fix.
// #4378: Core raw OS-byte addresses remain gated. The scripted native seam
// refuses them with exact byte provenance; policy never converts/join lossy text.
#Test("UTF-8-only flash seam preserves nonUTF byte-position refusal without skipping it") {
    raw :: [U8]{U8{97}, U8{47}, U8{255}, U8{98}}
    assert(String.from_bytes(raw) == .Err(_))
    host := FlashTestHost{files: [String:FlashTestFile]{}, path: Val([Path]{flash_paths.of("/bin")})}
    file := flash_test_file("/bin/tool")
    file.inspect_error = Val(jet_cli_flash_non_utf8_error(2))
    host.files["/bin/tool"] = ~file
    if flash_test_resolve_tool(&host, "tool") == {
        .Ok(_) -> panic("raw native address was skipped or accepted")
        .Err(failure) -> {
            assert_eq(failure.byte_offset, Val(2))
            assert_eq(failure.message, "flash path is not UTF-8 at byte 2")
        }
    }
    host.files["image"] = ~file
    if flash_test_regular_file(&host, flash_paths.of("image"), "flash image") == {
        .Ok(_) -> panic("raw native address was accepted")
        .Err(failure) -> {
            assert_eq(failure.byte_offset, Val(2))
            assert_eq(failure.message, "flash path is not UTF-8 at byte 2")
        }
    }
    host.files["/out/image.target.json"] = file
    if flash_test_resolve_audit(&host, flash_paths.of("/out/image.elf"), "board", flash_test_no_path()) == {
        .Ok(_) -> panic("raw native sidecar was skipped or accepted")
        .Err(failure) -> {
            assert_eq(failure.byte_offset, Val(2))
            assert_eq(failure.message, "flash path is not UTF-8 at byte 2")
        }
    }
}
