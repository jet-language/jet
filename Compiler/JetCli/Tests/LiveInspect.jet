// Full-unit pure witnesses for the authoritative LiveInspect/EventObservation
// consumer contract over the runtime's raw snapshot records. Transport
// witnesses are separate real-filesystem fixtures.
use {
    jet_cli.[jet_cli_live_event_render, jet_cli_live_json_report, jet_cli_live_text]
    jet_foundation.[JetLiveChannel, JetLiveEvent, JetLiveRuntime, JetLiveSnapshot, JetLiveTask, JetLiveValue, jet_live_bind, jet_live_decode]
}

// The runtime's record layout (JetRuntime ObserveLive.jet): little-endian
// words; a text is its byte length (-1 when absent) and its bytes.
live_inspect_u64: fn(out: &[U8], value: U64) Never! {
    loop index in 0..<8 -> out.push(U8{Int.from_u64((value >> (index * 8)).bit_and(U64{255}))})
}
live_inspect_word: fn(out: &[U8], word: Int) Never! {
    if word < 0 -> live_inspect_u64(out, U64{word + 9223372036854775807 + 1} + U64{9223372036854775808}) else -> live_inspect_u64(out, U64{word})
}
live_inspect_put: fn(out: &[U8], text: String?) Never! {
    if text == .Val(present) {
        live_inspect_word(out, present.bytes().len())
        loop byte in present.bytes() -> out.push(byte)
    } else {
        live_inspect_word(out, -1)
    }
}
live_inspect_state: fn(state: String) -> Int Never! {
    if state == "queued" -> return 0
    if state == "running" -> return 1
    if state == "blocked" -> return 2
    3
}
live_inspect_bytes: fn(snapshot: JetLiveSnapshot) -> [U8] Never! {
    out := [U8]{}
    live_inspect_word(out, 3550338754064696650)
    live_inspect_word(out, 1)
    live_inspect_word(out, snapshot.pid)
    live_inspect_word(out, snapshot.captured_ms)
    live_inspect_word(out, snapshot.runtime.elapsed_ns)
    live_inspect_u64(out, snapshot.boot_ns)
    live_inspect_u64(out, snapshot.start_ticks)
    live_inspect_word(out, snapshot.clock_hz)
    live_inspect_word(out, if snapshot.runtime.exit -> 1 else -> 0)
    loop key in ([String]{"arenas", "arena_allocations", "arena_bytes", "workers", "queued"}) -> live_inspect_word(out, snapshot.resources.get(key) ?? 0)
    live_inspect_put(out, Val(snapshot.session_id.copy()))
    live_inspect_put(out, Val(snapshot.source_id.copy()))
    live_inspect_put(out, Val(snapshot.build_id.copy()))
    live_inspect_put(out, Val(snapshot.revision.copy()))
    live_inspect_put(out, Val(snapshot.world_id.copy()))
    live_inspect_word(out, 1)
    live_inspect_word(out, snapshot.tasks.len())
    loop row in snapshot.tasks {
        live_inspect_word(out, row.id)
        live_inspect_word(out, row.parent)
        live_inspect_word(out, 0)
        live_inspect_word(out, live_inspect_state(row.state))
        live_inspect_word(out, if row.deadline_ms == None -> 0 else -> 1)
        live_inspect_word(out, row.deadline_ms ?? 0)
        live_inspect_word(out, if row.cancelled -> 1 else -> 0)
        live_inspect_put(out, None)
        live_inspect_put(out, Val(row.wait.copy()))
    }
    if snapshot.channels.len() > 0 {
        live_inspect_word(out, 2)
        live_inspect_word(out, snapshot.channels.len())
        loop channel in snapshot.channels {
            live_inspect_word(out, channel.id)
            live_inspect_word(out, channel.depth)
            live_inspect_word(out, if channel.capacity == None -> 0 else -> 1)
            live_inspect_word(out, channel.capacity ?? 0)
            live_inspect_word(out, channel.send_waiters)
            live_inspect_word(out, channel.recv_waiters)
            live_inspect_word(out, if channel.closed -> 1 else -> 0)
        }
    }
    if snapshot.values.len() > 0 {
        live_inspect_word(out, 3)
        live_inspect_word(out, snapshot.values.len())
        loop value in snapshot.values {
            live_inspect_put(out, Val(value.value_id.copy()))
            live_inspect_put(out, Val(value.type_identity.copy()))
            live_inspect_put(out, Val(value.disposition.copy()))
            live_inspect_put(out, Val(value.reason.copy()))
            if value.rendered_value == .Val(shown) -> live_inspect_put(out, Val(shown.copy())) else -> live_inspect_put(out, None)
        }
    }
    if snapshot.event_records.len() > 0 {
        live_inspect_word(out, 4)
        live_inspect_word(out, snapshot.event_records.len())
        loop event in snapshot.event_records {
            live_inspect_word(out, event.sequence)
            live_inspect_put(out, Val(event.source.copy()))
            live_inspect_word(out, event.event_id)
            live_inspect_word(out, event.owner_id)
            live_inspect_word(out, event.subscription_id)
            live_inspect_word(out, event.dispatch_id)
            live_inspect_put(out, Val(event.lifecycle.copy()))
            live_inspect_word(out, event.queued)
            live_inspect_word(out, event.blocked)
            live_inspect_word(out, event.running)
            live_inspect_word(out, event.capacity)
            live_inspect_put(out, Val(event.overflow.copy()))
            live_inspect_word(out, event.priority)
            live_inspect_put(out, Val(event.failure.copy()))
            live_inspect_put(out, Val(event.terminal.copy()))
        }
    }
    live_inspect_word(out, 0)
    out
}
live_inspect_event: fn(sequence: Int) -> JetLiveEvent Never! {
    JetLiveEvent{sequence: sequence, source: "AsyncEvent", event_id: 2, owner_id: 3, subscription_id: 4, dispatch_id: 5, lifecycle: "HandlerFailed", queued: -1, blocked: 0, running: 1, capacity: 8, overflow: "DropNewest", priority: -17, failure: "Handler", terminal: "None"}
}
live_inspect_value: fn(value_id: String, type_identity: String, disposition: String, rendered: String?) -> JetLiveValue Never! {
    JetLiveValue{value_id: value_id, type_identity: type_identity, disposition: disposition, reason: "", rendered_value: rendered}
}
live_inspect_fixture: fn() -> JetLiveSnapshot Never! {
    resources := [String:Int]{}
    resources["arenas"] = 1
    resources["arena_allocations"] = 2
    resources["arena_bytes"] = 64
    resources["workers"] = 1
    resources["queued"] = 0
    JetLiveSnapshot{
        protocol: "jet.live.v1", session_id: "session", source_id: "app.jet", build_id: "build-1",
        revision: "rev-1", world_id: "world-1", pid: 42, start_id: "", captured_ms: 1,
        values: [JetLiveValue]{live_inspect_value("app.counter", "Int", "kept", Val("7"))},
        tasks: [JetLiveTask]{JetLiveTask{id: 2, parent: 1, state: "blocked", wait: "channel send", deadline_ms: Val(480), cancelled: false}},
        channels: [JetLiveChannel]{JetLiveChannel{id: 1, depth: 4, capacity: Val(4), send_waiters: 1, recv_waiters: 0, closed: false}},
        effects: [String:Int]{}, resources: resources,
        runtime: JetLiveRuntime{elapsed_ns: 7, cpu_ns: None, exit: false},
        event_records: [JetLiveEvent]{live_inspect_event(1)}, events: None,
        boot_ns: U64{20000000000}, start_ticks: U64{3}, clock_hz: 100,
    }
}
live_inspect_rejected: fn(bytes: [U8], message: String) Never! {
    if jet_live_decode(bytes) == {
        .Err(error) -> assert(error.message.contains(message))
        .Ok(snapshot) -> {
            if jet_cli_live_event_render(snapshot.event_records) == {
                .Err(error) -> assert(error.message.contains(message))
                .Ok(_) -> panic("unsafe live snapshot accepted: {message}")
            }
        }
    }
}
live_inspect_decoded: fn(snapshot: JetLiveSnapshot) -> JetLiveSnapshot Never! {
    jet_live_decode(live_inspect_bytes(snapshot)) ?? panic(err.message)
}
live_inspect_stat: fn(start: String, user: String, system: String) -> String Never! {
    fields := [String]{"S"}
    loop index in 1..<19 -> fields.push(if index == 11 -> user else if index == 12 -> system else -> "0")
    fields.push(start.copy())
    "42 (name ) with spaces) {fields.join(" ")}\n"
}
#Test("live_inspect") {
    snapshot: live_inspect_decoded(live_inspect_fixture())
    assert(snapshot.values[0].rendered_value == Val("7"))
    assert(snapshot.runtime == JetLiveRuntime{elapsed_ns: 7, cpu_ns: None, exit: false})
    assert((jet_cli_live_event_render(snapshot.event_records) ?? panic(err.message)) == "sequence=1 source=AsyncEvent event=2 owner=3 subscription=4 dispatch=5 lifecycle=HandlerFailed queued=-1 blocked=0 running=1 capacity=8 overflow=DropNewest priority=-17 failure=Handler terminal=None")
    expected: "jet inspect live · pid 42\nprotocol=jet.live.v1 session=session source=app.jet build=build-1 revision=rev-1 world=world-1\n\ntask tree\n  task 2     parent 1     blocked  wait=channel send deadline=480 cancelled=false\n\nchannels\n  channel 1     depth 4/4 blocked send=1 recv=0 closed=false\n\neffects: compute=0 waiting=1 channel=1 time=0 io=0\nresources: workers=1 running=0 queued=0 cancelled=0 arenas=1 arena_allocations=2 arena_bytes=64\n\nvalues\n  app.counter type=Int kept value=7\n\nevents\n  sequence=1 source=AsyncEvent event=2 owner=3 subscription=4 dispatch=5 lifecycle=HandlerFailed queued=-1 blocked=0 running=1 capacity=8 overflow=DropNewest priority=-17 failure=Handler terminal=None\n"
    assert(jet_cli_live_text(snapshot) == expected)
    loop plane in ([String]{"types", "rights", "claims", "shapes", "structure", "build", "gates"}) {
        json: jet_cli_live_json_report(snapshot, plane)
        assert(json.contains("\"action\":\"inspect.{plane}\""))
        assert(json.contains("\"rendered_value\":\"7\""))
        assert(json.contains("\"shapes\":[{{\"type_identity\":\"Int\",\"value_ids\":[\"app.counter\"]}}]"))
    }
    // The view derives order and counters from the records.
    derived := live_inspect_fixture()
    derived.tasks = [JetLiveTask]{
        JetLiveTask{id: 9, parent: 1, state: "blocked", wait: "time sleep", deadline_ms: None, cancelled: true},
        JetLiveTask{id: 3, parent: 1, state: "blocked", wait: "net tcp receive", deadline_ms: None, cancelled: false},
        JetLiveTask{id: 5, parent: 1, state: "blocked", wait: "io read", deadline_ms: None, cancelled: false},
        JetLiveTask{id: 1, parent: 0, state: "running", wait: "", deadline_ms: None, cancelled: false},
        JetLiveTask{id: 4, parent: 1, state: "paused", wait: "network", deadline_ms: None, cancelled: false},
    }
    derived.channels = [JetLiveChannel]{
        JetLiveChannel{id: 7, depth: 0, capacity: None, send_waiters: 0, recv_waiters: 0, closed: true},
        JetLiveChannel{id: 2, depth: 1, capacity: Val(2), send_waiters: 0, recv_waiters: 0, closed: false},
    }
    view: live_inspect_decoded(derived)
    assert(view.tasks.map(fn(row) { row.id }) == [Int]{1, 3, 4, 5, 9})
    assert(view.tasks[2].state == "paused" && view.tasks[0].wait == "")
    assert(view.channels[0].id == 2 && view.channels[1].capacity == None)
    assert(view.effects.get("compute") == Val(2) && view.effects.get("waiting") == Val(3) && view.effects.get("channel") == Val(0) && view.effects.get("time") == Val(1) && view.effects.get("io") == Val(2))
    assert(view.resources.get("running") == Val(1) && view.resources.get("cancelled") == Val(1))
    assert(jet_cli_live_text(view).contains("channel 7     depth 0/∞ blocked send=0 recv=0 closed=true"))
    many_channels := live_inspect_fixture()
    many_channels.channels = loop index in 0..<4097 -> JetLiveChannel{id: 4097 - index, depth: 0, capacity: None, send_waiters: 0, recv_waiters: 0, closed: false}
    bounded: live_inspect_decoded(many_channels)
    assert(bounded.channels.len() == 4096 && bounded.channels[0].id == 1 && bounded.channels[4095].id == 4096)
    // Unicode Cc controls show as one space each; the runtime records the text.
    controls := live_inspect_fixture()
    controls.world_id = String.from_bytes([U8]{U8{119}, U8{10}, U8{49}, U8{194}, U8{133}, U8{120}, U8{127}}) ?? panic("C0, C1 and DEL text")
    assert(live_inspect_decoded(controls).world_id == "w 1 x ")
    // Absence is kept where the view keeps it.
    absent := live_inspect_fixture()
    absent.values = [JetLiveValue]{live_inspect_value("app.counter", "Int", "kept", None)}
    absent.tasks[0].deadline_ms = None
    absent.event_records = [JetLiveEvent]{}
    absent_view: live_inspect_decoded(absent)
    assert(absent_view.values[0].rendered_value == None && absent_view.tasks[0].deadline_ms == None)
    assert(jet_cli_live_text(absent_view).contains("\nevents\n  (no runtime event observations)\n"))
    // Unsigned words above Int's range saturate; signed words keep their sign.
    wide := live_inspect_bytes(live_inspect_fixture())
    loop index in 88..<96 -> wide[index] = U8{255}
    assert((jet_live_decode(wide) ?? panic(err.message)).resources.get("arena_bytes") == Val(9223372036854775807))
    // The process facts: start time binds the snapshot, CPU is since the run start.
    bound := live_inspect_decoded(live_inspect_fixture())
    jet_live_bind(bound, live_inspect_stat("1234", "5", "2")) ?? panic(err.message)
    assert(bound.start_id == "1234" && bound.runtime.cpu_ns == Val(40000000))
    unbound := live_inspect_decoded(live_inspect_fixture())
    if jet_live_bind(unbound, live_inspect_stat("2001", "5", "2")) == {
        .Err(error) -> assert(error.message.contains("does not belong to process 42"))
        .Ok(_) -> panic("bound a later process to the snapshot")
    }
    no_cpu := live_inspect_decoded(live_inspect_fixture())
    jet_live_bind(no_cpu, live_inspect_stat("1234", "18446744073", "1")) ?? panic(err.message)
    assert(no_cpu.runtime.cpu_ns == None)
    truncated_stat := live_inspect_decoded(live_inspect_fixture())
    if jet_live_bind(truncated_stat, "42 (name) S 1 2\n") == {
        .Err(error) -> assert(error.message.contains("truncated"))
        .Ok(_) -> panic("accepted a truncated stat")
    }
    // Corrupt records are refused.
    good: live_inspect_bytes(live_inspect_fixture())
    magic := good.copy()
    magic[7] = U8{50}
    live_inspect_rejected(magic, "unsupported schema")
    live_inspect_rejected(good[0..<good.len() - 1].copy(), "truncated")
    trailing := good.copy()
    trailing.push(U8{0})
    live_inspect_rejected(trailing, "trailing bytes")
    unknown := good[0..<good.len() - 8].copy()
    live_inspect_word(unknown, 9)
    live_inspect_word(unknown, 0)
    live_inspect_word(unknown, 0)
    live_inspect_rejected(unknown, "unknown section")
    repeated_section := good[0..<good.len() - 8].copy()
    live_inspect_word(repeated_section, 2)
    live_inspect_word(repeated_section, 0)
    live_inspect_word(repeated_section, 0)
    live_inspect_rejected(repeated_section, "repeats a section")
    invented := live_inspect_fixture()
    invented.values = [JetLiveValue]{live_inspect_value("app.counter", "Int", "invented", Val("7"))}
    live_inspect_rejected(live_inspect_bytes(invented), "unsupported disposition")
    many_values := live_inspect_fixture()
    many_values.values = loop _ in 0..<4096 -> live_inspect_value("app.counter", "Int", "kept", Val("7"))
    assert(live_inspect_decoded(many_values).values.len() == 4096)
    many_values.values.push(live_inspect_value("app.counter", "Int", "kept", Val("7")))
    live_inspect_rejected(live_inspect_bytes(many_values), "too many values")
    many_tasks := live_inspect_fixture()
    many_tasks.tasks = loop index in 0..<4097 -> JetLiveTask{id: index, parent: 0, state: "queued", wait: "", deadline_ms: None, cancelled: false}
    live_inspect_rejected(live_inspect_bytes(many_tasks), "too many tasks")
    mixed := live_inspect_fixture()
    mixed.values = [JetLiveValue]{live_inspect_value("app.counter", "Int", "kept", Val("7")), live_inspect_value("app.counter", "Int", "kept", Val("7")), live_inspect_value("b", "Bool", "reset", None)}
    assert(jet_cli_live_json_report(live_inspect_decoded(mixed), "shapes").contains("\"shapes\":[{{\"type_identity\":\"Bool\",\"value_ids\":[\"b\"]}},{{\"type_identity\":\"Int\",\"value_ids\":[\"app.counter\",\"app.counter\"]}}]"))
    // EventObservation's closed projection.
    event := live_inspect_fixture()
    event.event_records[0].queued = -2
    live_inspect_rejected(live_inspect_bytes(event), "invalid `queued`")
    event.event_records[0] = live_inspect_event(1)
    event.event_records[0].source = "Payload"
    live_inspect_rejected(live_inspect_bytes(event), "unknown `source`")
    event.event_records = [JetLiveEvent]{live_inspect_event(1), live_inspect_event(1)}
    live_inspect_rejected(live_inspect_bytes(event), "not strictly increasing")
    event.event_records = loop sequence in 1..<258 -> live_inspect_event(sequence)
    live_inspect_rejected(live_inspect_bytes(event), "256-record limit")
    loop source in ([String]{"Event", "AsyncEvent", "DecisionHook"}) {
        closed := live_inspect_fixture()
        closed.event_records[0].source = source.copy()
        assert(jet_cli_live_text(live_inspect_decoded(closed)).contains("source={source}"))
    }
    loop lifecycle in ([String]{"Subscribed", "Removed", "DispatchStarted", "Queued", "Backpressured", "Running", "HandlerStarted", "HandlerDelivered", "HandlerFailed", "HandlerContinue", "HandlerTransform", "HandlerCancel", "HandlerFail", "Terminal"}) {
        closed := live_inspect_fixture()
        closed.event_records[0].lifecycle = lifecycle.copy()
        assert(jet_cli_live_text(live_inspect_decoded(closed)).contains("lifecycle={lifecycle}"))
    }
    loop overflow in ([String]{"None", "Block", "DropNewest", "DropOldest"}) {
        closed := live_inspect_fixture()
        closed.event_records[0].overflow = overflow.copy()
        assert(jet_cli_live_text(live_inspect_decoded(closed)).contains("overflow={overflow}"))
    }
    loop failure in ([String]{"None", "Handler", "Panic"}) {
        closed := live_inspect_fixture()
        closed.event_records[0].failure = failure.copy()
        assert(jet_cli_live_text(live_inspect_decoded(closed)).contains("failure={failure}"))
    }
    loop terminal in ([String]{"None", "Delivered", "HandlerFailed", "DroppedNewest", "DroppedOldest", "Closed", "Cancelled", "DeadlineExceeded", "Continue", "Cancel", "Fail"}) {
        closed := live_inspect_fixture()
        closed.event_records[0].terminal = terminal.copy()
        assert(jet_cli_live_text(live_inspect_decoded(closed)).contains("terminal={terminal}"))
    }
}
