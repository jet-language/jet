// Rust: Source/BudgetProviders.rs:3266
#Test("process_cpu_time_conversion_is_exact_and_rejects_invalid_timevals") {
    if target.selected_os() == "linux" {
        assert_eq(process_timeval_ns(2, 345_678, "test").unwrap(), U128{2_345_678_000})
        assert(process_timeval_ns(-1, 0, "test").is_err())
        assert(process_timeval_ns(0, 1_000_000, "test").is_err())
    }
}

// Rust: Source/BudgetProviders.rs:3275
fn request() -> ProviderRequest {
    ProviderRequest{
        schema: "jet.provider-request", version: 1,
        request_id: "1".repeat(64), provider_hash: "2".repeat(64), context_hash: "3".repeat(64),
        specs: [ProviderSpec{budget_hash: "4".repeat(64), metric: "BenchTime"}],
        workload: CanonicalJson.Null, policy: CanonicalJson.Null
    }
}
// Rust: Source/BudgetProviders.rs:3290
fn valid_events(request: &ProviderRequest) -> [ProviderEvent] {
    [
        ProviderEvent.Sample{spec: 0, metric: "BenchTime", value: Rational.integer(42)},
        ProviderEvent.Complete{request_id: request.request_id, samples: 1}
    ]
}
// Rust: Source/BudgetProviders.rs:3303
fn panic_provider(_: &ProviderRequest, _: &ProviderCancellation) -> [ProviderEvent] ProviderFailure! {
    panic("hostile provider panic")
}
// Rust: Source/BudgetProviders.rs:3309
fn unavailable_provider(request: &ProviderRequest, _: &ProviderCancellation) -> [ProviderEvent] ProviderFailure! {
    Ok([
        ProviderEvent.Unavailable{spec: 0, reason: "probe could not observe ready event", details: []},
        ProviderEvent.Complete{request_id: request.request_id, samples: 0}
    ])
}
// Rust: Source/BudgetProviders.rs:3325
fn temporary(name: String) -> OSPath {
    env.temp_dir().join("jet-budget-provider-{process.id()}-{name}-{PROVIDER_TEST_NEXT.fetch_add(1, Ordering.Relaxed)}")
}

// Rust: Source/BudgetProviders.rs:3334
#Test("compiler_probe_rejects_forged_workload_identity_before_execution") {
    root :: temporary("compile-identity")
    fs.create_dir_all(root.join("src")).unwrap()
    fs.create_dir_all(root.join("edits")).unwrap()
    fs.write(root.join("package.jet"), "name: \"identity\"\nversion: \"0.1.0\"\n").unwrap()
    fs.write(root.join("src/run.jet"), "fn run() {}\n").unwrap()
    fs.write(root.join("edits/change.patch"), "patch\n").unwrap()
    workload :: compiler_probe_workload(root, root.join("src/run.jet"), "Edit", "cli", "dev", Val("edits/change.patch")).unwrap()
    fields := if workload == { .Object(fields) -> fields, else -> panic("workload object") }
    fields["source_tree_sha256"] = CanonicalJson.String("0".repeat(64))
    req :: ProviderRequest{
        schema: "jet.provider-request", version: 1,
        request_id: "1".repeat(64), provider_hash: "2".repeat(64), context_hash: "3".repeat(64),
        specs: [ProviderSpec{budget_hash: "4".repeat(64), metric: "CompileTime(P95)"}],
        workload: CanonicalJson.Object(^fields), policy: CanonicalJson.Null
    }
    cancellation :: ProviderCancellation{cancelled: Arc.new(AtomicBool.new(false))}
    failure :: compiler_latency_provider(&req, &cancellation).unwrap_err()
    assert_eq(failure.class, FailureClass.Incompatible)
    _ :: fs.remove_dir_all(root)
}

// Rust: Source/BudgetProviders.rs:3383
#Test("compiler_probe_applies_a_deterministic_one_file_edit") {
    root :: temporary("edit-patch")
    fs.create_dir_all(root.join("src")).unwrap()
    fs.write(root.join("src/run.jet"), "fn run() {}\n").unwrap()
    fs.write(root.join("change.patch"), "--- a/src/run.jet\n+++ b/src/run.jet\n@@ -1,1 +1,1 @@\n-fn run() {}\n+fn run() { print(\"fixture\") }\n").unwrap()
    apply_unified_patch(root, "change.patch").unwrap()
    assert_eq(fs.read_to_string(root.join("src/run.jet")).unwrap(), "fn run() { print(\"fixture\") }\n")
    _ :: fs.remove_dir_all(root)
}

