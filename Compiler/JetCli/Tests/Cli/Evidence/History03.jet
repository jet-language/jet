}
// Rust: Source/ReceiptStore.rs:3884
#Test("malformed_context_pointer_is_a_cache_miss") {
    root :: receipt_test_root("malformed-context")
    store :: ReceiptStore.new(root)
    argv :: [String]{"check"}
    context_key :: store.context_key("check", argv).unwrap()
    pointer :: store.context_path(context_key)
    fs.create_dir_all(pointer.parent().unwrap()).unwrap()
    fs.write(pointer, [U8]{U8{255}, U8{254}}).unwrap()
    assert(store.lookup_context("check", argv, root).unwrap() == None)
    fs.remove_dir_all(root) ?? {}
}
// Rust: Source/ReceiptStore.rs:3906
#Test("project_check_receipt_rejects_new_higher_priority_entry") {
    project :: receipt_test_project("entry-priority", true)
    store :: ReceiptStore.new(project.join("receipts"))
    argv :: [String]{"check"}
    initial :: input_paths_for("check", argv, project)
    assert(initial.any((path) -> path.ends_with("src/run.jet")))
    claim :: receipt_test_publish(&store, argv, initial)
    fs.write(project.join("run.jet"), "fn run() -> {}\n").unwrap()
    assert(project_check_input_paths(project).unwrap().any((path) -> path.ends_with("run.jet")))
    current :: store.claim("check", argv, input_paths_for("check", argv, project)).unwrap()
    assert(claim.key != current.key)
    assert(store.lookup_context("check", argv, project).unwrap() == None)
    fs.remove_dir_all(project) ?? {}
}
