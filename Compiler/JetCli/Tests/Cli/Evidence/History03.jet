use ReceiptStore.[ReceiptStore, OptionalReceiptJob, NEXT_TEMP_ID, OPTIONAL_RECEIPT_JOB_DIR, stage_optional_receipt_job, run_optional_receipt_helper, input_paths_for, project_check_input_paths, receipt_root_for, context_identity, receipt_secret_values]
use RecordIndex.[RecordIndex, RecordKind]
