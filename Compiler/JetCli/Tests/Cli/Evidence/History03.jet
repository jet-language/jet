#Test("secret_names_cover_camel_case_dotted_env_and_receipt_identity") {
    loop name in [String]{"--apiToken", "--auth.token", "--token2", "JET_API_TOKEN", "PERSISTENCE_SECRET", "digestKey", "replayToken"} -> assert(jet_cli_receipt_is_secret_name(name), "secret name not recognized: {name}")
    assert(jet_cli_receipt_is_secret_environment_name("MY_APIKEY"))
    assert(!jet_cli_receipt_is_secret_name("--public"))
    first :: [String]{"check", "--apiToken=camel-secret", "--auth.token", "dotted-secret", "--persistenceToken", "persistence-secret", "--digest.key=digest-secret", "--replayToken", "replay-secret", "public"}
    second :: loop argument in first -> argument.replace("secret", "rotated")
    assert(jet_cli_receipt_argv_identity(first) == jet_cli_receipt_argv_identity(second))
    assert(context_identity("check", first).unwrap() == context_identity("check", second).unwrap())
    values :: receipt_secret_values(first)
    loop value in [String]{"camel-secret", "dotted-secret", "persistence-secret", "digest-secret", "replay-secret"} -> assert(values.contains(value))
}
