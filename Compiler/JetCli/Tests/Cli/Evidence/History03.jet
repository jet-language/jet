// GATE #4494: these fixtures require real native filesystem/process/atomic hosts.
fn receipt_test_root(label: String) -> OSPath {
    root :: env.temp_dir().join("jet-receipt-{label}-{process.id()}-{NEXT_TEMP_ID.fetch_add(1, sync.Ordering.Relaxed)}")
    fs.remove_dir_all(root) ?? {}
    root
}
fn receipt_test_project(label: String, nested: Bool) -> OSPath {
    project :: receipt_test_root(label)
    fs.create_dir_all(if nested -> project.join("src") else -> project).unwrap()
    fs.write(project.join(PACKAGE_FILE), "name: \"receipt-{label}\"\nversion: \"0.1.0\"\n").unwrap()
    fs.write(if nested -> project.join("src/run.jet") else -> project.join(DEFAULT_ENTRY_FILE), "fn run() -> {}\n").unwrap()
    project
}
// Native publication fixture, using the real canonical receipt store.
fn receipt_test_publish(store: &ReceiptStore, argv: [String], inputs: [OSPath]) -> JetCLIReceiptClaim {
    claim :: &store.claim("check", argv, inputs).unwrap()
    &store.write(claim, argv, I32{0}, "first".bytes(), []).unwrap()
    key :: &store.context_key("check", argv).unwrap()
    &store.remember_context_key(key, claim).unwrap()
    claim
}

// Rust: Source/ReceiptStore.rs:3843
#Test("receipt_body_digest_ignores_timestamp_because_there_is_none") {
    claim :: JetCLIReceiptClaim{verb: "check", key: "a".repeat(JET_CLI_RECEIPT_DIGEST_LEN), inputs: []}
    first :: JetCLIReceipt{claim: claim, status: I32{0}, stdout: "ok".bytes(), stderr: [], sections: [], consumed: [], produced: [], digest: ""}
    second := ~first
    second.claim = ~claim
    assert(jet_cli_receipt_digest(first) == jet_cli_receipt_digest(second))
}
