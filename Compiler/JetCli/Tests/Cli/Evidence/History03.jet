#Test("captured_child_output_is_streamed_and_retained") {
    input :: "one\ntwo\n".bytes()
    reader := std.io.Cursor.new(input)
    streamed := [U8]{}
    captured :: capture_stream(&reader, &streamed)
    assert(captured == input)
