    &stdout.push(U8{0})
    receipt :: JetCLIReceipt{claim: JetCLIReceiptClaim{verb: "check", key: "a".repeat(JET_CLI_RECEIPT_DIGEST_LEN), inputs: []}, status: I32{0}, stdout: stdout, stderr: "legacy-replay-secret\n".bytes(), sections: [], consumed: [], produced: [], digest: "b".repeat(JET_CLI_RECEIPT_DIGEST_LEN)}
    (out, error) :: replay_output(receipt, secrets)
    expected := "old <redacted>".bytes()
    &expected.push(U8{0})
    assert(out == expected)
    assert(error == "<redacted>\n".bytes())
}
// Rust: Source/ReceiptStore.rs:4393
#Test("receipt_persistence_redacts_secret_values_before_digest") {
    root :: receipt_test_root("redaction")
    store :: ReceiptStore.new(root)
    claim :: JetCLIReceiptClaim{verb: "check", key: "a".repeat(JET_CLI_RECEIPT_DIGEST_LEN), inputs: []}
    argv :: [String]{"check", "--apiToken=receipt-api-token", "--auth.token", "receipt-dotted-secret", "--persistenceToken", "receipt-persistence-secret", "--digest.key=receipt-digest-secret", "--replayToken", "receipt-hostile-secret"}
    secrets :: receipt_secret_values(argv)
    loop value in [String]{"receipt-api-token", "receipt-dotted-secret", "receipt-persistence-secret", "receipt-digest-secret", "receipt-hostile-secret"} -> assert(secrets.contains(value))
    stdout := "public receipt-api-token receipt-dotted-secret receipt-persistence-secret receipt-digest-secret receipt-hostile-secret".bytes()
    &stdout.push(U8{0})
    store.write(claim, argv, I32{0}, stdout, "receipt-hostile-secret receipt-digest-secret receipt-persistence-secret receipt-dotted-secret receipt-api-token\n".bytes()).unwrap()
    receipt :: store.lookup(claim).unwrap().unwrap()
    expected := "public <redacted> <redacted> <redacted> <redacted> <redacted>".bytes()
    &expected.push(U8{0})
    assert(receipt.stdout == expected)
    assert(receipt.stderr == "<redacted> <redacted> <redacted> <redacted> <redacted>\n".bytes())
    assert(receipt.digest == jet_cli_receipt_digest(receipt))
    assert(jet_cli_receipt_redact_bytes("receipt-hostile-secret".bytes(), secrets) == "<redacted>".bytes())
    assert(jet_cli_receipt_redact_bytes("short".bytes(), [String]{"longer-secret"}) == "short".bytes())
    fs.remove_dir_all(root) ?? {}
}
// Rust: Source/ReceiptStore.rs:4456
#Test("legacy_v1_receipts_with_unknown_rotated_and_file_secrets_fail_closed") {
    root :: receipt_test_root("legacy")
    file_secret :: root.join("token.secret")
    fs.create_dir_all(root).unwrap()
    fs.write(file_secret, "file-secret-value".bytes()).unwrap()
    value :: fs.read_to_string(file_secret).unwrap()
    store :: ReceiptStore.new(root)
    claim :: JetCLIReceiptClaim{verb: "check", key: "a".repeat(JET_CLI_RECEIPT_DIGEST_LEN), inputs: []}
    receipt := JetCLIReceipt{claim: claim, status: I32{0}, stdout: "legacy rotated-secret {value} from {file_secret.display()}".bytes(), stderr: [], sections: [], consumed: [], produced: [], digest: ""}
    receipt.digest = jet_cli_receipt_digest(receipt)
    bytes := jet_cli_receipt_encode(receipt).unwrap()
    legacy_magic :: fs.read(OSPath.from("tests/fixtures/build-metadata-compat/receipt-v1.magic")).unwrap()
    assert(legacy_magic.len() >= JET_CLI_RECEIPT_MAGIC.len())
    loop index in 0..<JET_CLI_RECEIPT_MAGIC.len() -> bytes[index] = legacy_magic[index]
    assert(jet_cli_receipt_decode(bytes).is_err())
    fs.create_dir_all(root.join("objects")).unwrap()
    fs.write(store.object_path(claim.key), bytes).unwrap()
    assert(store.lookup(claim).unwrap() == None)
    assert(store.list().unwrap().len() == 0)
    fs.remove_dir_all(root) ?? {}
}
// Rust: Source/ReceiptStore.rs:4503
#Test("optional_history_uses_canonical_jobs_and_fails_closed_for_blocked_destinations") {
    make_project :: (label: String) -> {
        project :: receipt_test_root("optional-{label}")
        fs.create_dir_all(project).unwrap()
        fs.write(project.join("package.jet"), "name: \"optional-history\"\nversion: \"0.1.0\"\n").unwrap()
        fs.write(project.join("main.jet"), "fn run() -> {}\n").unwrap()
        fs.canonicalize(project).unwrap()
    }
    project :: make_project("success")
    store :: ReceiptStore.new(project.join(".jet/receipts"))
    source :: project.join("main.jet")
    argv :: [String]{"check", source.display().to_string()}
    claim :: store.claim("check", argv, [source]).unwrap()
    job :: OptionalReceiptJob{project_root: project, cwd: project, context_key: store.context_key("check", argv).unwrap(), claim: claim, argv: argv, status: I32{0}, stdout: "optional-output".bytes(), stderr: []}
    staged :: stage_optional_receipt_job(job).unwrap()
    assert(staged.parent().unwrap().file_name().unwrap().to_str() == Val(OPTIONAL_RECEIPT_JOB_DIR))
    assert(run_optional_receipt_helper([staged.display().to_string()]) == 0)
    assert(!staged.exists(), "the helper consumes its disposable job")
    assert(store.lookup(claim).unwrap() != None)
    indexed :: RecordIndex.load_for_project(project).unwrap()
    assert(indexed.find(RecordKind.Receipt, claim.key, true) != None)
    required :: make_project("required-blocked")
    required_root :: required.join(".jet/receipts")
    fs.create_dir_all(required_root).unwrap()
    blocked_objects :: required_root.join("objects")
    fs.write(blocked_objects, "required-destination".bytes()).unwrap()
    required_store :: ReceiptStore.new(required_root)
    required_source :: required.join("main.jet")
    required_argv :: [String]{"check", required_source.display().to_string()}
    required_claim :: required_store.claim("check", required_argv, [required_source]).unwrap()
    error :: required_store.write(required_claim, required_argv, I32{0}, "output".bytes(), []).expect_err("a non-directory object destination must fail closed")
    assert(error.contains("unsafe"))
    assert(fs.read(blocked_objects).unwrap() == "required-destination".bytes())
    optional :: make_project("optional-blocked")
    optional_root :: optional.join(".jet/receipts")
    fs.create_dir_all(optional_root).unwrap()
    blocked_pending :: optional_root.join(OPTIONAL_RECEIPT_JOB_DIR)
    fs.write(blocked_pending, "optional-destination".bytes()).unwrap()
    optional_store :: ReceiptStore.new(optional_root)
    optional_source :: optional.join("main.jet")
    optional_argv :: [String]{"check", optional_source.display().to_string()}
    optional_claim :: optional_store.claim("check", optional_argv, [optional_source]).unwrap()
    optional_job :: OptionalReceiptJob{project_root: optional, cwd: optional, context_key: optional_store.context_key("check", optional_argv).unwrap(), claim: optional_claim, argv: optional_argv, status: I32{0}, stdout: [], stderr: []}
    assert(stage_optional_receipt_job(optional_job).is_err())
    assert(fs.read(blocked_pending).unwrap() == "optional-destination".bytes())
    cleanup :: make_project("cleanup")
    cleanup_pending :: cleanup.join(".jet/receipts").join(OPTIONAL_RECEIPT_JOB_DIR)
    fs.create_dir_all(cleanup_pending).unwrap()
    invalid :: cleanup_pending.join(".job-invalid")
    fs.write(invalid, "not-a-job".bytes()).unwrap()
    assert(run_optional_receipt_helper([invalid.display().to_string()]) == 0)
    assert(!invalid.exists(), "invalid jobs in the disposable namespace are removed")
    outside :: cleanup.join(".job-invalid")
    fs.write(outside, "not-a-job".bytes()).unwrap()
    assert(run_optional_receipt_helper([outside.display().to_string()]) == 0)
    assert(outside.exists(), "cleanup never deletes a file outside the canonical disposable namespace")
    loop root in [OSPath]{project, required, optional, cleanup} -> fs.remove_dir_all(root) ?? {}
}
