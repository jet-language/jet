    assert(debug.contains("stderr: \"<redacted>\""))
    assert(!debug.contains("legacy bearer secret"))
}
// Rust: Source/ReceiptStore.rs:4285
#Test("receipt_context_ignores_nix_shell_temp_paths_and_systemd_invocation") {
    first := [JetCLIReceiptEnvironmentEntry]{JetCLIReceiptEnvironmentEntry{name: "INVOCATION_ID", value: "7863347a1378412ea643bdcc4c1a8b6d"}}
    second := [JetCLIReceiptEnvironmentEntry]{JetCLIReceiptEnvironmentEntry{name: "INVOCATION_ID", value: "55d41a44be5646d9a261b25e341ea5bb"}}
    loop name in [String]{"NIX_BUILD_TOP", "TEMP", "TEMPDIR", "TMP", "TMPDIR"} {
        &first.push(JetCLIReceiptEnvironmentEntry{name: name, value: "/tmp/nix-shell.first"})
        &second.push(JetCLIReceiptEnvironmentEntry{name: name, value: "/tmp/nix-shell.second"})
    }
    stable :: JetCLIReceiptEnvironmentEntry{name: "JET_RECEIPT_TEST_STABLE", value: "same"}
    &first.push(stable)
    &second.push(stable)
    assert(jet_cli_receipt_environment_identity_from(first) == jet_cli_receipt_environment_identity_from(second))
    assert(jet_cli_receipt_environment_identity_from([stable]) != jet_cli_receipt_environment_identity_from([JetCLIReceiptEnvironmentEntry{name: "JET_RECEIPT_TEST_STABLE", value: "different"}]))
}
