// Object construction uses the canonical Foundation representation.
fn bm_object(pairs: [(String, CanonicalJSON)]) -> CanonicalJSON Never! {
    fields := [CanonicalJSONField]{}
    loop (key, value) in pairs -> &fields.push(CanonicalJSONField{key: ^key, value: ^value})
    canonical_json_object(^fields) ?? panic(err.message)
}
fn bm_index(fields: [CanonicalJSONField], key: String) -> Int Never! {
    loop (i, field) in fields { if field.key == key -> return i }
    panic("missing fixture key {key}")
}
fn bm_fields(value: CanonicalJSON) -> [CanonicalJSONField] Never! {
    if value == .Object(fields) -> return ~fields
    panic("fixture is not an object")
}
fn bm_put(fields: &[CanonicalJSONField], key: String, value: CanonicalJSON) {
    loop i in 0..<fields.len() {
        if fields[i].key == key { fields[i].value = ^value; return }
    }
    &fields.push(CanonicalJSONField{key: ^key, value: ^value})
}
fn bm_remove(fields: &[CanonicalJSONField], key: String) {
    at :: bm_index(fields, key)
    &fields.remove(at)
}
fn bm_text(fields: [CanonicalJSONField], key: String) -> String Never! {
    jet_cli_budget_manifest_text(fields[bm_index(fields, key)].value, key) ?? panic(err.message)
}

// Rust: Source/BudgetStore.rs:1863
fn valid_report(marker: String) -> ([U8], String, String, String) Never! {
    subject :: bm_object([
        ("artifact", .Null),
        ("measured_end", .String("2026-01-01T00:00:01.000000000Z")),
        ("measured_start", .String("2026-01-01T00:00:00.000000000Z")),
        ("member_sources", .Array([])), ("profile", .String("dev")),
        ("target_class", .String("native")), ("target_id", .String("target-{marker}")),
        ("target_triple", .String("x86_64-unknown-linux-gnu"))
    ])
    tool_body :: bm_object([
        ("compiler_build_id", .String("compiler")), ("jet_version", .String("1")),
        ("runner_id", .String("runner")), ("stdlib_id", .String("stdlib"))
    ])
    tool_fields := bm_fields(tool_body)
    bm_put(&tool_fields, "digest", .String(perf_stable_id(tool_body)))
    tool :: CanonicalJSON.Object(^tool_fields)
    provider_body :: bm_object([
        ("cpu_arch", .String("x86_64")), ("cpu_model", .String("test")),
        ("identity", .String("")), ("isolation", .String("process")),
        ("kernel", .String("test")), ("kind", .String("CompilerFacts")),
        ("logical_cpus", .Integer("1")), ("memory_bytes", .Integer("1")),
        ("os", .String("linux")), ("power_governor", .String("fixed")),
        ("version", .String("1"))
    ])
    provider_fields := bm_fields(provider_body)
    bm_put(&provider_fields, "hardware_fingerprint", .String(perf_stable_id(provider_body)))
    provider :: CanonicalJSON.Object(^provider_fields)
    metric :: bm_object([("name", .String("BinarySize")), ("percentile", .Null)])
    comparison :: bm_object([
        ("direction", .String("at_most")), ("kind", .String("absolute")),
        ("limit", perf_rational_to_json(perf_rational_integer(10)))
    ])
    budget_spec :: bm_object([
        ("applies", bm_object([
            ("profiles", .Array([.String("dev")])),
            ("targets", .Array([.String("target-{marker}")]))
        ])),
        ("comparison", ~comparison), ("enforcement", .String("fail")),
        ("metric", ~metric), ("name", .String("size-{marker}")),
        ("package_id", .String("pkg")), ("perf_role", .String("package")),
        ("provider", bm_object([("identity", .String("")), ("kind", .String("CompilerFacts"))])),
        ("scope", .String("Package"))
    ])
    spec :: perf_stable_id(budget_spec)
    context_input := ("jet-budget-context-v1" + TEXT_NUL).bytes()
    // Rust: Source/BudgetStore.rs:1979 — length-prefixed context frames.
    frame :: fn(out: &[U8], value: String) {
        &out.extend(U64.from_int(value.bytes().len()).to_be_bytes())
        &out.extend(value.bytes())
    }
    loop value in [String]{
        "target-{marker}", "BinarySize", "", "native", "x86_64-unknown-linux-gnu",
        "dev", "1", "compiler", "stdlib", "runner", bm_text(bm_fields(tool), "digest"),
        "CompilerFacts", "", "1", "process", "x86_64", "test", "1", "1", "linux",
        "test", "fixed", bm_text(bm_fields(provider), "hardware_fingerprint")
    } -> frame(&context_input, value)
    context :: sha256_hex(context_input)
    base :: bm_object([
        ("baseline", .Null), ("budget_id", .String("pkg:size-{marker}")),
        ("budget_spec", ^budget_spec), ("budget_spec_sha256", .String(~spec)),
        ("comparison", ~comparison), ("context_key", .String(~context)),
        ("decision", .Null), ("direction", .String("lower_is_better")),
        ("enforcement", .String("fail")), ("history", .Null), ("metric", ^metric),
        ("policy", .Null), ("provider", ^provider),
        ("samples", .Array([perf_rational_to_json(perf_rational_integer(1))])),
        ("source", .String("main.jet:1")), ("statistics", .Null),
        ("target_class", .String("native")), ("unit", .String("Bytes"))
    ])
    evidence :: perf_stable_id(bm_object([
        ("measurements", .Array([~base])), ("subject", ~subject), ("toolchain", ~tool)
    ]))
    evaluation :: perf_evaluate(evidence, context, [], [perf_rational_integer(1)], [], None,
        .Absolute{limit: perf_rational_integer(10), direction: .AtMost},
        .LowerIsBetter, .Fail, None) ?? panic(err.message)
    trend :: bm_object([
        ("estimators", .Array([])), ("label", .String("insufficient")),
        ("report_ids", .Array([])), ("score", .Null)
    ])
    decision :: bm_object([
        ("evidence", .String("pass")), ("lower95", .Null),
        ("point", perf_rational_to_json(evaluation.point)), ("policy_outcome", .String("pass")),
        ("reason", .Null), ("trend", ^trend), ("upper95", .Null)
    ])
    measurement := bm_fields(base)
    bm_put(&measurement, "decision", ^decision)
    privacy :: bm_object([
        ("excluded", .Array([])), ("retained", .Array([])),
        ("schema", .Integer("1")), ("workspace_paths_only", .Bool(true))
    ])
    content :: bm_object([
        ("evidence_id", .String(^evidence)), ("measurements", .Array([.Object(^measurement)])),
        ("privacy", ^privacy), ("subject", ^subject),
        ("summary", bm_object([
            ("fail", .Integer("0")), ("outcome", .String("pass")),
            ("pass", .Integer("1")), ("warn", .Integer("0"))
        ])), ("toolchain", ^tool)
    ])
    id :: perf_stable_id(content)
    report :: bm_object([
        ("content", ^content), ("report_id", .String(~id)),
        ("schema", .String("jet.budget-report")), ("version", .Integer("1"))
    ])
    bytes :: canonical_json_bytes(report)
    _ :: perf_verify_budget_report(bytes) ?? panic(err.message)
    (^bytes, ^id, ^spec, ^context)
}

// Rust: Source/BudgetStore.rs:2149
#Test("baseline_names_and_reasons_are_closed") {
    assert(jet_cli_budget_manifest_validate_baseline_name("release/x86-linux").is_ok())
    loop bad in [String]{"", "/x", "x/", "x//y", "X", "x_", "x/../y", "x--y"} {
        assert(jet_cli_budget_manifest_validate_baseline_name(bad).is_err(), bad)
    }
    assert(jet_cli_budget_manifest_normalize_reason(" reviewed regression ").is_err())
    assert(jet_cli_budget_manifest_normalize_reason("reviewed regression").is_ok())
    assert(jet_cli_budget_manifest_normalize_reason("é").is_err())
    assert(jet_cli_budget_manifest_normalize_reason("é").is_ok())
    assert(jet_cli_budget_manifest_validate_timestamp("2026-02-31T12:00:00.000000000Z").is_err())
    assert(jet_cli_budget_manifest_validate_timestamp("2024-02-29T12:00:00.000000000Z").is_ok())
}

