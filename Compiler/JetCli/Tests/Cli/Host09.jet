// Rust: Source/CmdCompile.rs:15634
#Test("optimized_default_release_and_debug_profiles_keep_distinct_flags") {
    optimized :: BuildProfile.Default.config().rustc_args(false)
    assert(optimized.contains("opt-level=2"))
    assert(!optimized.contains("-O"))
    assert(optimized.contains("lto=off"))
    assert(optimized.contains("strip=symbols"))
    assert(!optimized.iter().any(arg -> arg == "lto=thin" || arg == "lto=fat" || arg.starts_with("codegen-units=")))
    release :: BuildProfile.Release.config().rustc_args(false)
    assert(release.contains("opt-level=3"))
    assert(release.contains("lto=thin"))
    assert(!release.contains("lto=off"))
    debug :: BuildProfile.Debug.config().rustc_args(false)
    assert(debug.contains("codegen-units=256"))
    assert(debug.contains("debuginfo=2"))
    assert(!debug.contains("-O"))
    assert(!debug.contains("lto=thin"))
}
