// Rust: Source/CmdCompile.rs:15680
struct ScratchProject {
    root: OSPath
    // Rust: Source/CmdCompile.rs:15683
    fn new() -> ScratchProject {
        // GATE #4494: native clock, process identity and filesystem.
        nonce :: time.SystemTime.now().duration_since(time.UNIX_EPOCH).expect("clock after epoch").as_nanos()
        root :: env.temp_dir().join("jet_genmod_cache_{process.id()}_{nonce}")
        fs.create_dir_all(&root).expect("create generic-module cache fixture")
        ScratchProject { root: ^root }
    }
    // Rust: Source/CmdCompile.rs:15697
    fn write(self, name: String, source: String) -> {
        path :: self.root.join(name)
        if parent :: path.parent() { fs.create_dir_all(parent).expect("create cache fixture input directory") }
        fs.write(path, source).expect("write generic-module cache fixture")
    }
    // Rust: Source/CmdCompile.rs:15705
    fn main(self) -> String { self.root.join("main.jet").to_string_lossy().into_owned() }
    // Rust: Source/CmdCompile.rs:15708
    fn native_cache_key_with_input(self, relative: String) -> String {
        self.write("package.jet", "name: \"consumed-input-cache\"\nversion: \"1.0.0\"\n")
        bundle := Loader.load_entry_with_overlay(self.main(), .None, false).expect("load consumed-input cache fixture")
        Driver.seed_build_facts(&bundle, "dev", false, [String:String]{}).expect("seed consumed-input cache fixture")
        diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Check)
        assert(diagnostics.iter().all(diagnostic -> diagnostic.severity != Diagnostics.Severity.Error), "consumed-input cache fixture must check")
        bytes :: fs.read(self.root.join(relative)).expect("read consumed-input cache fixture")
        bundle.comptime_inputs = [AST.ComptimeInput { path: relative.replace(std.path.MAIN_SEPARATOR, "/"), hash: SHA256.sha256_hex(bytes) }]
        native_cache_key_for_program(self.main(), &bundle, "default", "run", NativeKeyBackend.Rustc("comptime-input-test-toolchain"), .None).expect("consumed-input cache key")
    }
    // Rust: Source/CmdCompile.rs:15751
    fn drop(&self) -> { _ :: fs.remove_dir_all(&self.root) }
}
