#Test("driver_brands_runtime_host_fault_without_rust_text") {
    diagnostic :: Diagnostics.Diagnostic.runtime_host_fault("before\n", "the JIT runtime helper failed")
    (stdout, what) :: diagnostic.runtime_host_fault_parts().expect("typed runtime host fault")
    report :: render_internal_fault(what)
    assert(stdout == "before\n")
    assert(report.starts_with("internal compiler error: the JIT runtime helper failed\n"))
    assert(report.contains("This is a bug in jet, NOT in your program."))
    assert(!report.contains("thread 'main' panicked"))
    assert(!report.contains("runtime_host.rs"))
}
// Rust: Source/CmdCompile.rs:16357
#Test("web_artifact_writer_rejects_symlink_output") {
    // GATE #4483/#4494: target Unix symlink and filesystem operations.
    if selected_family() == "unix" {
        root :: env.current_dir().unwrap().join(".jet-web-output-symlink-{process.id()}")
        _ :: fs.remove_dir_all(&root)
        fs.create_dir_all(&root).unwrap()
        outside :: root.join("outside.js")
        output :: root.join("app.js")
        fs.write(&outside, "must survive").unwrap()
        std.os.unix.fs.symlink(&outside, &output).unwrap()
        error :: validate_web_output_file(&output, &root).expect_err("web artifact writes must not follow symlinks")
        assert(error.contains("must not be a symlink"), "{error}")
        assert(fs.read_to_string(&outside).unwrap() == "must survive")
        _ :: fs.remove_dir_all(&root)
    }
}
// Rust: Source/CmdCompile.rs:16380
#Test("web_artifact_writer_rejects_hardlink_output") {
    // GATE #4483/#4494: target Unix hard-link filesystem operations.
    if selected_family() == "unix" {
        root :: env.current_dir().unwrap().join(".jet-web-output-hardlink-{process.id()}")
        _ :: fs.remove_dir_all(&root)
        fs.create_dir_all(&root).unwrap()
        outside :: root.with_file_name(".jet-web-output-hardlink-target-{process.id()}")
        output :: root.join("app.js")
        fs.write(&outside, "must survive").unwrap()
        fs.hard_link(&outside, &output).unwrap()
        error :: validate_web_output_file(&output, &root).expect_err("web artifact writes must not follow hardlinks")
        assert(error.contains("must not be a hard link"), "{error}")
        assert(fs.read_to_string(&outside).unwrap() == "must survive")
        _ :: fs.remove_dir_all(&root)
        _ :: fs.remove_file(&outside)
    }
}
