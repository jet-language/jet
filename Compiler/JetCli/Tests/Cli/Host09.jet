// Rust: Source/CmdCompile.rs:15775
#Test("native_cache_ignores_comments_and_tracks_bridge_identity") {
    project :: ScratchProject.new()
    defer project.drop()
    project.write("main.jet", "fn run() { print(1) }\n")
    base :: native_cache_key(project.main(), "dev", "default", "run", .None).expect("base cache key")
    project.write("main.jet", "// cache-only comment\nfn run() { print(1) }\n")
    comment :: native_cache_key(project.main(), "dev", "default", "run", .None).expect("comment cache key")
    assert(base == comment, "comments must not invalidate native cache")
    instances: [String] :: []
    no_bridge :: native_cache_salt("tool", "dependencies", "runtime", "core", "run", "linux-x86_64", instances, .None, [], .None)
    bridge_a :: native_cache_salt("tool", "dependencies", "runtime", "core", "run", "linux-x86_64", instances, .Val("bridge-a"), [], .None)
    bridge_b :: native_cache_salt("tool", "dependencies", "runtime", "core", "run", "linux-x86_64", instances, .Val("bridge-b"), [], .None)
    assert(no_bridge != bridge_a, "a bridge must have its own cache identity")
    assert(bridge_a != bridge_b, "bridge input changes must invalidate cache")
}
// Rust: Source/CmdCompile.rs:15833
#Test("generic_instance_cache_salt_tracks_every_downstream_input") {
    instances :: ["instance-a", "instance-b"]
    salt :: (tool, deps, runtime, core, mode, target, instances: [String]) -> native_cache_salt(tool, deps, runtime, core, mode, target, instances, .None, [], .None)
    base :: salt("tool-a", "deps-a", "runtime-a", "core-a", "run", "linux-x86_64", instances)
    assert(base != salt("tool-b", "deps-a", "runtime-a", "core-a", "run", "linux-x86_64", instances))
    assert(base != salt("tool-a", "deps-b", "runtime-a", "core-a", "run", "linux-x86_64", instances))
    assert(base != salt("tool-a", "deps-a", "runtime-b", "core-a", "run", "linux-x86_64", instances))
    assert(base != salt("tool-a", "deps-a", "runtime-a", "core-b", "run", "linux-x86_64", instances))
    assert(base != salt("tool-a", "deps-a", "runtime-a", "core-a", "test", "linux-x86_64", instances))
    assert(base != salt("tool-a", "deps-a", "runtime-a", "core-a", "run", "macos-aarch64", instances))
    assert(base != salt("tool-a", "deps-a", "runtime-a", "core-a", "run", "linux-x86_64", ["instance-c"]))
    assert(base == salt("tool-a", "deps-a", "runtime-a", "core-a", "run", "linux-x86_64", ["instance-b", "instance-a"]))
}
// Rust: Source/CmdCompile.rs:15957
#Test("hostile_cache_invalidation_matrix") {
    project :: ScratchProject.new()
    defer project.drop()
    project.write("main.jet", "fn run() { print(1) }\n")
    identity :: (compiler, schema, backend, flags, linker) -> "compiler={compiler};schema={schema};backend={backend};flags={flags};linker={linker}"
    base_identity :: identity("compiler-a", "schema-a", "backend-a", "flags-a", "linker-a")
    key :: (toolchain: String, profile: String) -> native_cache_key_with_toolchain(project.main(), "dev", profile, "run", toolchain, .None).expect("hostile cache fixture key")
    base :: key(base_identity, "default")
    identities :: [
        ("compiler", identity("compiler-b", "schema-a", "backend-a", "flags-a", "linker-a")),
        ("schema", identity("compiler-a", "schema-b", "backend-a", "flags-a", "linker-a")),
        ("backend", identity("compiler-a", "schema-a", "backend-b", "flags-a", "linker-a")),
        ("flags", identity("compiler-a", "schema-a", "backend-a", "flags-b", "linker-a")),
        ("linker", identity("compiler-a", "schema-a", "backend-a", "flags-a", "linker-b"))
    ]
    for (input, changed) in identities { assert(base != key(changed, "default"), "{input} must miss final cache") }
    assert(base != key(base_identity, "profile:debug;opt:none"), "profile must miss final cache")
    instances :: ["instance-a"]
    salt :: (dependencies, runtime, core, target) -> native_cache_salt(base_identity, dependencies, runtime, core, "run", target, instances, .None, [], .None)
    base_salt :: salt("dependency-a", "generated-runtime-a", "core-a", "linux-x86_64")
    assert(base_salt != native_cache_salt_with_schema("jet-native-cache-salt-v4".bytes(), base_identity, "dependency-a", "generated-runtime-a", "core-a", "run", "linux-x86_64", instances, .None, [], .None), "cache-schema change must miss final work")
    for (input, changed) in [
        ("dependency", salt("dependency-b", "generated-runtime-a", "core-a", "linux-x86_64")),
        ("generated code", salt("dependency-a", "generated-runtime-b", "core-a", "linux-x86_64")),
        ("Core artifact", salt("dependency-a", "generated-runtime-a", "core-b", "linux-x86_64")),
        ("target", salt("dependency-a", "generated-runtime-a", "core-a", "wasm32"))
    ] { assert(base_salt != changed, "{input} must miss affected final work") }
}
// Rust: Source/CmdCompile.rs:16089
#Test("native_cache_key_requires_an_exact_emitted_program") {
    project :: ScratchProject.new()
    defer project.drop()
    project.write("package.jet", "name: \"prepared-cache\"\nversion: \"1.0.0\"\n")
    project.write("main.jet", "fn run() {}\n")
    options := Driver.BuildRunOptions.default()
    options.package_scope = true
    options.build_override = true
    exact_inputs :: Driver.FrontEndInputs.for_build(project.main(), &options)
    exact :: Driver.prepare_build_front_end(exact_inputs).expect("prepare exact runtime bundle")
    assert(exact.emitted_program().is_some())
    assert(native_cache_key_for_prepared_build(project.main(), .Val(&exact), "dev", "run", NativeKeyBackend.Cranelift, .None).is_some(), "an exact checked runtime bundle keeps native caching enabled")
    project.write("tools/build.jet", "fn build(b: BuildContext) -> BuildPlan { return b.plan() }\n")
    package_inputs :: Driver.FrontEndInputs.for_build(project.main(), &options)
    package :: Driver.prepare_build_front_end(package_inputs).expect("prepare external package build entry")
    assert(package.emitted_program().is_none(), "a package build entry does not itself equal the emitted runtime bundle")
    assert(native_cache_key_for_prepared_build(project.main(), .Val(&package), "dev", "run", NativeKeyBackend.Cranelift, .None) == .None, "without an exact emitted bundle, native cache lookup and store stay disabled")
}
// Rust: Source/CmdCompile.rs:16143
#Test("generic_instance_native_cache_key_invalidates_on_program_dependency_arg_package_and_profile_edits") {
    project :: ScratchProject.new()
    defer project.drop()
    main :: "use defs.box\nmodule defs\n\nmodule selected :: box<Int>(3)\nfn run() { print(selected.value()) }\n"
    dependency :: "pub module box<T>(n: Int) { pub fn value() -> Int { return n } }\n"
    manifest_v1 :: "name: \"cache-proof\"\nversion: \"1.0.0\"\n"
    project.write("main.jet", main)
    project.write("defs.jet", dependency)
    project.write("package.jet", manifest_v1)
    base :: native_cache_key(project.main(), "dev", "default", "run", .None).expect("base cache key")
    project.write("package.jet", "// semantic no-op\nname: \"cache-proof\"\nversion: \"1.0.0\"\n")
    manifest_comment :: native_cache_key(project.main(), "dev", "default", "run", .None).expect("comment-only manifest cache key")
    assert(base == manifest_comment, "comment-only package manifest edit must reuse the native cache")
    project.write("package.jet", manifest_v1)
    toolchain_a :: native_cache_key_with_toolchain(project.main(), "dev", "default", "run", "compiler-build-a/rustc-a/linker-a/backend-a", .None).expect("toolchain A cache key")
    toolchain_b :: native_cache_key_with_toolchain(project.main(), "dev", "default", "run", "compiler-build-b/rustc-a/linker-a/backend-a", .None).expect("toolchain B cache key")
    assert(toolchain_a != toolchain_b, "production native-cache key seam must include compiler/toolchain identity")
    project.write("main.jet", "use defs.box\nmodule defs\n\nmodule selected :: box<Int>(3)\nfn run() { print(selected.value() + 1) }\n")
    program_body :: native_cache_key(project.main(), "dev", "default", "run", .None).expect("program body cache key")
    assert(base != program_body, "entry-body edit must invalidate native cache")
    project.write("main.jet", main)
    project.write("defs.jet", "pub module box<T>(n: Int) { pub fn value() -> Int { return n + 1 } }\n")
    dependency_body :: native_cache_key(project.main(), "dev", "default", "run", .None).expect("dependency cache key")
    assert(base != dependency_body, "imported template-body edit must invalidate native cache")
    project.write("defs.jet", dependency)
    project.write("main.jet", "use defs.box\nmodule defs\n\nmodule selected :: box<Int>(4)\nfn run() { print(selected.value()) }\n")
    argument :: native_cache_key(project.main(), "dev", "default", "run", .None).expect("argument cache key")
    assert(base != argument, "normalized instance-argument edit must invalidate native cache")
    project.write("main.jet", main)
    project.write("package.jet", "name: \"cache-proof\"\nversion: \"2.0.0\"\n")
    package :: native_cache_key(project.main(), "dev", "default", "run", .None).expect("package cache key")
    assert(base != package, "package manifest edit must invalidate native cache")
    project.write("package.jet", manifest_v1)
    profile :: native_cache_key(project.main(), "small", "small", "run", .None).expect("profile cache key")
    assert(base != profile, "build-profile edit must invalidate native cache")
}
