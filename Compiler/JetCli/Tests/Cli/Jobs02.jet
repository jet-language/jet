// Rust: crates/jet-cli/src/CLI.rs:3878
#Test("help_copy_uses_sentence_case_descriptions_and_title_case_chrome") {
    loop command in JET_CLI_COMMANDS {
        assert(jobs02_starts_uppercase(command.summary))
        loop action in command.actions -> assert(jobs02_starts_uppercase(action.summary))
    }
    loop flag in JET_CLI_FLAGS -> assert(jobs02_starts_uppercase(flag.help))
    help :: jet_cli_usage_page_version("test", HelpOrder.Frequency)
    assert(help.contains("\nUsage:\n"))
    assert(help.contains("\nFlags:\n"))
    loop group in JET_CLI_COMMANDS {
        if !group.actions.is_empty() -> assert(help.contains("\n{jet_cli_group_label(group.name)} Commands:\n"))
    }
}
// Rust: crates/jet-cli/src/CLI.rs:3902
#Test("frequency_ranks_order_every_command_exactly_once") {
    ranks := [Int]{}
    expected := [Int]{}
    loop (index, command) in JET_CLI_COMMANDS {
        &ranks.push(command.frequency_rank)
        &expected.push(index + 1)
    }
    &ranks.sort()
    assert_eq(ranks, expected, "run `node Tools/cli-census/census.mjs` to rank every COMMANDS row")
}
// Rust: crates/jet-cli/src/CLI.rs:3913
#Test("retired_routes_have_zero_live_registry_rows") {
    surfaces := [String]{jet_cli_usage_page_version("0.0.0", HelpOrder.Frequency), jet_cli_man_page("0.0.0")}
    &surfaces.extend(jobs02_shells())
    loop retired in JET_CLI_RETIRED {
        top_count := 0
        nested_count := 0
        loop command in JET_CLI_COMMANDS {
            if command.name == retired.spelling -> top_count += 1
            loop action in command.actions { if "{command.name} {action.name}" == retired.spelling -> nested_count += 1 }
        }
        assert_eq(top_count, 0, "retired route {retired.spelling} remains a top-level row")
        assert_eq(nested_count, 0, "retired route {retired.spelling} remains a nested row")
        needle :: "{JET_CLI_BINARY} {retired.spelling}"
        loop surface in surfaces -> assert(!surface.contains(needle), "retired route leaked into generated surface: {needle}\n{surface}")
        assert_eq(retired.category, JetCLIRetirementCategory.Semantic)
        assert_eq(retired.error_code, "E2101")
    }
}
