// Rust: crates/jet-cli/src/CLI.rs:3523
#Test("completions_mention_every_command") {
    loop script in jobs02_shells() {
        loop command in JET_CLI_COMMANDS {
            if jet_cli_is_canonical_top_level(command.name) -> assert(script.contains(command.name), "completion missing command {command.name}")
            if command.actions.len() > 0 -> assert(script.contains(command.name), "completion missing group {command.name}")
            loop action in command.actions -> assert(script.contains(action.name), "completion missing {command.name} {action.name}")
        }
    }
}
// Rust: crates/jet-cli/src/CLI.rs:3556
#Test("moved_command_registry_agrees_with_dispatch") {
    loop group in JET_CLI_COMMANDS {
        loop action in group.actions {
            if action.name == "install" {
                assert_eq(action.handler, "SharedStore")
                assert(jet_cli_moved_command(action.name) == None)
                next
            }
            if action.also_canonical_top_level {
                assert(jet_cli_is_canonical_top_level(action.name))
                assert(jet_cli_moved_command(action.name) == None)
                next
            }
            assert(!jet_cli_is_canonical_top_level(action.name), "moved bare command leaked: {action.name}")
            owner :: jet_cli_moved_command(action.name) ?? panic("missing moved owner for {action.name}")
            owner_group :: JET_CLI_COMMANDS[owner.group]
            assert(jet_cli_group_index(owner_group.name) != None)
            assert_eq(owner_group.actions[owner.action].name, action.name)
        }
    }
}
// Rust: crates/jet-cli/src/CLI.rs:3595
#Test("typo_suggestions_never_advertise_moved_bare_actions") {
    loop group in JET_CLI_COMMANDS {
        loop action in group.actions {
            canonical_bare := false
            loop command in JET_CLI_COMMANDS {
                if command.name == action.name && command.actions.is_empty() && jet_cli_is_canonical_top_level(command.name) -> canonical_bare = true
            }
            if !action.also_canonical_top_level && !canonical_bare -> assert(jet_cli_closest_command(action.name) != Val(action.name))
        }
    }
}
// Rust: crates/jet-cli/src/CLI.rs:3611
#Test("every_nested_action_has_canonical_usage") {
    loop group in JET_CLI_COMMANDS {
        loop action in group.actions {
            assert(!action.usage.trim().is_empty(), "missing usage for {group.name} {action.name}")
            loop usage in action.usage.split("\n") -> assert(usage == action.name || usage.starts_with("{action.name} "), "usage `{usage}` does not begin with action name `{action.name}`")
        }
    }
}
// Rust: crates/jet-cli/src/CLI.rs:3632
#Test("every_nested_action_routes_to_a_real_dispatch_seam") {
    loop group in JET_CLI_COMMANDS {
        loop action in group.actions {
            assert(!action.summary.trim().is_empty(), "missing summary for {group.name} {action.name}")
            handler_index :: jet_cli_handler_index(action.handler) ?? panic("missing handler")
            handler :: JET_CLI_HANDLERS[handler_index]
            assert(jet_cli_is_builtin(handler.dispatch_word), "{group.name} {action.name} routes to missing handler {handler.dispatch_word}")
            nested :: jet_cli_nested_command(group.name, action.name) ?? panic("missing nested action")
            assert_eq(JET_CLI_COMMANDS[nested.group].actions[nested.action].handler, action.handler)
            if handler.keeps_group -> assert_eq(handler.dispatch_word, group.name, "kept group must own its dispatcher")
            normalized := [String]{group.name, action.name, "tail"}
            if !handler.keeps_group {
                normalized[0] = handler.dispatch_word
                &normalized.remove(1)
            }
            expected :: if handler.keeps_group -> [String]{group.name, action.name, "tail"} else -> [String]{handler.dispatch_word, "tail"}
            assert_eq(normalized, expected)
        }
    }
}
// Rust: crates/jet-cli/src/CLI.rs:3683
#Test("man_mentions_every_command_and_flag") {
    man :: jet_cli_man_page("0.0.0")
    loop command in JET_CLI_COMMANDS { if jet_cli_is_canonical_top_level(command.name) -> assert(man.contains(command.name), "man missing command {command.name}") }
    loop flag in JET_CLI_FLAGS -> assert(man.contains(flag.long), "man missing flag {flag.long}")
}
// Rust: crates/jet-cli/src/CLI.rs:3694
#Test("authority_flags_render_in_registry_completions_and_man") {
    man :: jet_cli_man_page("0.0.0")
    scripts :: jobs02_shells()
    loop canonical in [String]{"--allow", "--deny"} {
        assert_eq(jobs02_flag_count(canonical), 1, "registry must contain one canonical {canonical} row")
        assert(jobs02_has_flag("db", canonical))
        assert(man.contains(canonical), "man missing {canonical}")
        loop script in scripts -> assert(script.contains(canonical) || script.contains(canonical.slice(2..<canonical.len())), "completion missing {canonical}")
    }
    loop effect in [BuildEffect]{BuildEffect.Net, BuildEffect.FS, BuildEffect.IO, BuildEffect.DB, BuildEffect.Time, BuildEffect.Rand, BuildEffect.Env, BuildEffect.Exec, BuildEffect.Log, BuildEffect.GPU} {
        loop kind in [String]{"allow", "deny"} {
            retired :: "--{kind}-{effect.flag()}"
            assert_eq(jobs02_flag_count(retired), 0, "registry must reject retired {retired}")
            assert(!man.contains(retired), "man contains retired {retired}")
            loop script in scripts -> assert(!script.contains(retired), "completion contains retired {retired}")
        }
    }
}
