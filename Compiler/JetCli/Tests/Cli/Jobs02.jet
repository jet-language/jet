// Rust: crates/jet-cli/src/CLI.rs:3789
#Test("no_command_declared_in_both_tables") {
    loop group in JET_CLI_COMMANDS {
        loop action in group.actions {
            handler :: JET_CLI_HANDLERS[jet_cli_handler_index(action.handler) ?? panic("missing handler")]
            if handler.keeps_group -> next
            loop command in JET_CLI_COMMANDS -> assert(command.name != handler.dispatch_word, "`{handler.dispatch_word}` is declared both as a `{group.name}` nested action and again as a top-level COMMANDS row")
        }
    }
}
