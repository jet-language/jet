// Rust: crates/jet-cli/src/CLI.rs:3825
#Test("output_flags_ignore_program_arguments_after_separator") {
    args :: [String]{"run", "--quiet", "--", "--verbose", "--json"}
    flags :: jet_cli_output_flags_parse(args) ?? panic("output flags refused")
    assert(flags.quiet)
    assert(!flags.verbose)
    assert(!flags.json)
    assert(!jet_cli_machine_output_requested(args))
    verbose :: jet_cli_output_flags_parse([String]{"run", "--verbose", "--", "--quiet", "--json"}) ?? panic("output flags refused")
    assert(verbose.verbose)
    assert(!verbose.quiet)
    assert(!verbose.json)
}
