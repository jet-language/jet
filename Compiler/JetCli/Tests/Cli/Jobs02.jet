// Rust: crates/jet-cli/src/CLI.rs:3408
#Test("dry_run_is_one_shared_flag_row") {
    assert_eq(jobs02_flag_count(JET_CLI_DRY_RUN_FLAG), 1)
    assert(jet_cli_is_known_flag(JET_CLI_DRY_RUN_FLAG))
