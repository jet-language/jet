use jet_foundation.[BuildEffect]

fn jobs02_shells() -> [String] Never! {
    [String]{jet_cli_completions_bash(), jet_cli_completions_zsh(), jet_cli_completions_fish(), jet_cli_completions_powershell()}
}
fn jobs02_flag_count(name: String) -> Int Never! {
    count := 0
    loop flag in JET_CLI_FLAGS { if flag.long == name -> count += 1 }
    count
}
fn jobs02_has_flag(command: String, name: String) -> Bool Never! {
    loop flag in jet_cli_flags_for_command(command) { if flag.long == name -> return true }
    false
}
fn jobs02_split(words: [String]) -> [String] Never! {
    args := ~words
    jet_cli_separate_job_argv(&args)
    args
}
fn jobs02_starts_uppercase(text: String) -> Bool Never! {
    if text.is_empty() -> return false
    first :: text.chars()[0]
    first.is_uppercase()
}

// Rust: crates/jet-cli/src/CLI.rs:3329
#Test("job_argv_forwards_every_word_after_the_job_name") {
    assert_eq(jobs02_split([String]{"jobs", "--interpret", "-p", "api", "web", "--port", "3000"}), [String]{"jobs", "--interpret", "-p", "api", "web", "--", "--port", "3000"})
    assert_eq(jobs02_split([String]{"jobs", "web", "--", "--port", "--", "x"}), [String]{"jobs", "web", "--", "--port", "--", "x"})
    loop words in [[String]]{[String]{"jobs", "--graph"}, [String]{"jobs", "-p", "api"}, [String]{"jobs", "web"}, [String]{"run", "main.jet", "--port", "3000"}} -> assert_eq(jobs02_split(words), words)
}
// Rust: crates/jet-cli/src/CLI.rs:3359
#Test("external_completion_rejects_hostile_program_names") {
    schema :: CLICommandSchema{entry_type: "", description: None, inputs: [TCLIInput]{}, commands: [TCLICommand]{}, jobs: [CLIRecordJob]{}, standard: false, version: None}
    assert_eq(jet_cli_completion_command_name("build/greeter") ?? panic("usable basename refused"), "greeter")
    if jet_cli_completion_command_name("safe\nINJECT_COMMAND\rnext") == {
        .Ok(_) -> panic("control character accepted")
        .Err(error) -> assert_eq(jet_cli_completion_name_error_message(error), "the program command name contains a control character")
    }
    loop shell in [String]{"bash", "zsh", "fish", "powershell"} {
        script :: jet_cli_completions_for_program(shell, "greeter", schema) ?? panic("supported shell refused")
        assert(!script.contains("build/greeter"))
    }
}
