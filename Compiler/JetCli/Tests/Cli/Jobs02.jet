    assert(usage.contains("codemod <plan.json> --dry-run"))
    assert(!usage.contains("codemod dry-run"))
}
// Rust: crates/jet-cli/src/CLI.rs:3428
#Test("dev_canvas_is_one_registered_surface") {
    assert_eq(jobs02_flag_count(JET_CLI_CANVAS_FLAG), 1)
    assert(jet_cli_is_known_flag(JET_CLI_CANVAS_FLAG))
    assert_eq(jet_cli_command_usage("dev"), "jet dev [<file.jet|dir>] [--canvas|--app <function>] [--share <loopback|lan>] [--token <token>] [-- <args>]")
    assert(jobs02_has_flag("dev", JET_CLI_CANVAS_FLAG))
    loop flag in [String]{"--output", "--target", "--canvas-host", "--canvas-port", "--canvas-transport", "--canvas-authority", "--canvas-audit"} -> assert(jobs02_has_flag("dev", flag), "{flag} must be visible in dev help")
    assert(jet_cli_man_page("0.0.0").contains("--canvas"))
    assert(jet_cli_completions_bash().contains("--canvas"))
    assert(jet_cli_completions_zsh().contains("--canvas"))
    assert(jet_cli_completions_fish().contains("canvas"))
    assert(jet_cli_completions_powershell().contains("--canvas"))
    assert(!jet_cli_is_builtin("canvas"))
}
