// Rust: crates/jet-cli/src/CLI.rs:3485
#Test("flash_registry_matches_parser_surface") {
    count := 0
    loop command in JET_CLI_COMMANDS { if command.name == "flash" -> count += 1 }
    assert_eq(count, 1)
    assert_eq(jet_cli_command_usage("flash"), "jet flash --target <board.name> [--image <firmware.elf>] [--audit <target.json>] [--adapter <probe-rs|openocd|emulator>]")
    loop flag in [String]{"--target", "--image", "--audit", "--adapter"} -> assert(jobs02_has_flag("flash", flag), "flash help missing {flag}")
    assert_eq(jobs02_flag_count("--image") + jobs02_flag_count("--audit") + jobs02_flag_count("--adapter"), 3)
    assert(jet_cli_owns_flag_vocabulary("flash"))
    loop script in jobs02_shells() -> assert(script.contains("flash"))
}
