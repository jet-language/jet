// Watch closure policy over real files and the actual loader dependency accessor.
// The supplied comptime set is an explicit test input, not a production fallback.
use core.files as cli_files
use core.sys as cli_sys
use core.process as cli_process

struct JetCLIWatchFixtureRoot { path: String }
impl JetCLIWatchFixtureRoot.Close {
    fn close(^self) -[FS]> {
        cli_files.remove_all(self.path).drop("remove watch fixture")
    }
}

fn watch_inputs_require(ok: Bool, label: String) Never! {
    if !ok -> panic("watch inputs: {label}")
}
fn run() {
    base :: cli_sys.get("JET_CLI_FMT_TEST_ROOT") ?? panic("set disk-backed scratch")
    root :: "{base}/watch-{cli_process.current_pid()}"
    cli_files.create_dir_all("{root}/assets") ?? panic("create assets")
    cli_files.create_dir_all("{root}/corpus") ?? panic("create runtime directory")
    owner :: JetCLIWatchFixtureRoot{path: root}
    defer close(^owner)
    file :: "{root}/run.jet"
    source :: "use core.files as files\n// testing.corpus(\"corpus\")\nfn run() {{ _ :: files.read(\"data.txt\") }}\n"
    cli_files.write(file, source) ?? panic("entry")
    cli_files.write("{root}/run.html", "<link href='assets/style.css'><script src='assets/main.js'></script><img srcset='assets/a.png 1x, assets/b.png 2x'><img src='https://example.invalid/no.png'>") ?? panic("HTML")
    cli_files.write("{root}/assets/style.css", "body {{ background: url(a.png?cache=1#fragment); }}") ?? panic("CSS")
    cli_files.write("{root}/assets/main.js", "import './other.js'; import('./other.js');") ?? panic("JS")
    cli_files.write("{root}/assets/other.js", "import x from './main.js';") ?? panic("reference cycle")
    cli_files.write("{root}/assets/a.png", "asset a") ?? panic("first asset")
    cli_files.write("{root}/assets/b.png", "asset b") ?? panic("second asset")
    cli_files.write("{root}/data.txt", "runtime input") ?? panic("runtime input")
    cli_files.write("{root}/corpus/input.txt", "runtime directory member") ?? panic("runtime directory member")
    cli_files.write("{root}/comptime.txt", "observed compiler input") ?? panic("comptime input")
    prepared :: jet_cli_prepare_overlays(file, file, [], false, Val(1), JetDriverCompileMode.Doc)
    request :: if prepared == {
        .Prepared(value, _) -> value
        .Refused(output) -> panic("actual preparation: {output.stderr}")
    }
    loaded :: jet_driver_query_loaded_input_paths(request)
    watch_inputs_require(loaded.complete && loaded.paths.contains(file), "actual loaded entry dependency")
    watch_inputs_require(!loaded.comptime_input_coverage_complete, "loader cannot certify evaluator input reads")
    cache := WorkspaceDeclarationCache.new()
    graph :: jet_cli_watch_from_entry(&cache, file, loaded.paths, Val([String]{"{root}/comptime.txt"})) ?? panic("watch closure policy")
    loop member in ([String]{file, "{root}/run.html", "{root}/assets/style.css", "{root}/assets/main.js", "{root}/assets/other.js", "{root}/assets/a.png", "{root}/assets/b.png", "{root}/data.txt", "{root}/corpus", "{root}/corpus/input.txt", "{root}/comptime.txt"}) {
        watch_inputs_require(graph.paths.contains(member), "literal/asset/import reference retained: {member}")
    }
    watch_inputs_require(graph.paths.len() == jet_cli_lock_canonical(graph.paths).len(), "reference cycles deduplicated")
    literals :: jet_cli_watch_runtime_literals("files.read(\"a\"); files.read_bytes_more(\"ignored\"); testing.corpus('dir'); files.read(\"{{name}}\"); files.read(\"https://example.invalid/x\"); files.read(path)")
    watch_inputs_require(literals.len() == 2 && literals.get("a") == .Val(false) && literals.get("dir") == .Val(true), "literal grammar and directory hints")
    ignored :: jet_cli_watch_local_reference(root, "https://example.invalid/x")
    watch_inputs_require(ignored == None && jet_cli_watch_local_reference(root, "//example.invalid/x") == None, "remote URLs excluded")
    blocked :: jet_cli_watch_discover(&cache, request)
    watch_inputs_require(if blocked == {.Err(error) -> error.comptime_unavailable && error.message.contains("#4736") else -> false}, "actual uncertified producer refuses rather than approximates")
}
