// The native library feed (`jet doc FILE` with JET_FRONT_LIBRARY_OBJECT_OUTPUT)
// over the real checked front end: its `#Export(c)` rows root the object, so
// an exported `run: fn` is one more export, never a refused entry.
use {
    jet_cli.[jet_cli_driver_request, jet_cli_lowering_inputs, jet_cli_runtime_library]
    jet_driver.[JetDriverAuthorizedSourceFile, JetDriverAuthorizedSourceRoot, JetDriverAuthorizedSourceSnapshot, JetDriverCompileMode, JetDriverCoreSource]
    cli_files: core.files
}

#Test("an exported run: fn builds as a library export, not a refused entry") {
    root: cli_files.mkdtemp("jet-cli-library-feed") ?? panic("create library feed scratch: {err}")
    source: "helper: fn() -> Int {{ 1 }}\n#Export(c) run: fn() {{ _ := helper() }}\n"
    snapshot: JetDriverAuthorizedSourceSnapshot{
        roots: [JetDriverAuthorizedSourceRoot]{JetDriverAuthorizedSourceRoot{
            canonical_path: "/library-feed",
            identity: "library-feed-root",
            allow_hardlinks: false,
            files: [JetDriverAuthorizedSourceFile]{JetDriverAuthorizedSourceFile{path: "/library-feed/unit.jet", relative_path: "unit.jet", identity: "library-feed-file", source: source}},
            foreign_cache_files: [JetDriverAuthorizedSourceFile]{},
        }},
        entry_root_identity: "library-feed-root",
        entry_path: "/library-feed/unit.jet",
    }
    request := jet_cli_driver_request(snapshot, [JetDriverCoreSource]{}, Val(1), JetDriverCompileMode.Doc)
    // copy: a three-field row; the request moves into the front end below.
    threads: request.compiler_threads.copy()
    lifecycle: "{root}/lifecycle.list"
    cli_files.write(lifecycle, "") ?? panic("write the lifecycle list: {err}")
    prefix: "{root}/unit"
    built: jet_cli_runtime_library(jet_cli_lowering_inputs(request, None), prefix, Val(lifecycle), threads, None)
    if built.internal_problem == .Val(problem) -> panic("the library feed refused: {problem}")
    if !built.complete -> panic("the library feed failed: {built.diagnostics.map(fn(diagnostic) { "{diagnostic.code} {diagnostic.what}" })} {cli_files.read("{prefix}.issues") ?? ""}")
    assert_eq(cli_files.read("{prefix}.exports") ?? panic("read the export list: {err}"), "run")
    assert((cli_files.read_bytes("{prefix}.o") ?? panic("read the library object: {err}")).len() > 0)
    cli_files.remove_all(root) ?? panic("library feed cleanup")
}
