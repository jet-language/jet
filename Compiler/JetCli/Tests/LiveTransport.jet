// Real filesystem and process-identity witnesses. No producer or runtime
// publication is claimed: these are hostile/valid transport inputs.
use {
    jet_cli.[jet_cli_live_read_at]
    cli_sys: core.sys
    cli_process: core.process
    cli_files: core.files
    live_time: core.time
}

// The runtime's record layout (JetRuntime ObserveLive.jet): little-endian
// words; a text is its byte length and its bytes.
live_transport_u64: fn(out: &[U8], value: U64) Never! {
    loop index in 0..<8 -> out.push(U8{Int{(value >> (index * 8)).bit_and(U64{255})}})
}
live_transport_text: fn(out: &[U8], text: String) Never! {
    live_transport_u64(out, U64{text.bytes().len()})
    loop byte in text.bytes() -> out.push(byte)
}
// A writer whose boot-clock start is `boot_ns`, at 100 ticks per second,
// with no tasks and optionally one event record.
live_transport_fixture: fn(pid: Int, boot_ns: U64, captured: Int, event_sequence: Int?) -> [U8] Never! {
    out := [U8]{}
    loop word in ([U64]{U64{3550338754064696650}, U64{1}, U64{pid}, U64{captured}, U64{0}, boot_ns, U64{0}, U64{100}, U64{0}, U64{0}, U64{0}, U64{0}, U64{0}, U64{0}}) -> live_transport_u64(out, word)
    loop text in ([String]{"s", "app.jet", "b", "r", "w"}) -> live_transport_text(out, text)
    live_transport_u64(out, U64{1})
    live_transport_u64(out, U64{0})
    if event_sequence == .Val(sequence) {
        live_transport_u64(out, U64{4})
        live_transport_u64(out, U64{1})
        live_transport_u64(out, U64{sequence})
        live_transport_text(out, "Event")
        loop _ in 0..<4 -> live_transport_u64(out, U64{1})
        live_transport_text(out, "Queued")
        loop _ in 0..<4 -> live_transport_u64(out, U64{0})
        live_transport_text(out, "None")
        live_transport_u64(out, U64{0})
        live_transport_text(out, "None")
        live_transport_text(out, "None")
    }
    live_transport_u64(out, U64{0})
    out
}
live_transport_rejected: fn(pid: Int, path: String, message: String) {
    if jet_cli_live_read_at(pid, path) == {
        .Err(error) -> assert(error.message.contains(message))
        .Ok(_) -> panic("unsafe transport accepted: {message}")
    }
}
#Test("live_transport") {
    // /proc start identity is the Linux/Android transport's actual authority.
    platform: cli_sys.name()
    if platform != "linux" && platform != "android" -> return
    pid: cli_process.current_pid()
    root: "{cli_sys.temp_dir()}/jet-live-transport-{pid}"
    cli_files.create_dir_all(root) ?? panic("exclusive transport fixture directory")
    path: "{root}/snapshot.json"
    alias: "{root}/alias.json"
    // Any process start precedes a writer that started at the latest boot time.
    latest: U64{9223372036854775807}
    now: max(0, live_time.unix_ns() /% 1000000)
    cli_files.write_bytes(path, live_transport_fixture(pid, latest, now, None)) ?? panic("snapshot fixture")
    cli_files.set_mode(path, 0o600) ?? panic("private snapshot fixture")
    actual: jet_cli_live_read_at(pid, path) ?? panic("actual private retained-descriptor read")
    assert(actual.pid == pid && actual.start_id != "" && actual.events == Val("") && actual.runtime.cpu_ns != None)
    cli_files.write_bytes(path, live_transport_fixture(pid, latest, now, Val(1))) ?? panic("event fixture")
    with_event: jet_cli_live_read_at(pid, path) ?? panic("event record read")
    assert(with_event.events == Val("sequence=1 source=Event event=1 owner=1 subscription=1 dispatch=1 lifecycle=Queued queued=0 blocked=0 running=0 capacity=0 overflow=None priority=0 failure=None terminal=None"))
    // The snapshot is never accepted merely because it is a regular file.
    cli_files.set_mode(path, 0o644) ?? panic("hostile snapshot mode")
    live_transport_rejected(pid, path, "permissions expose runtime state")
    cli_files.set_mode(path, 0o600) ?? panic("restore private mode")
    cli_files.symlink(path, alias) ?? panic("hostile final link")
    live_transport_rejected(pid, alias, "not a regular file")
    live_transport_rejected(pid, root, "not a regular file")
    // A writer that started before this process is a reused pid's snapshot.
    cli_files.write_bytes(path, live_transport_fixture(pid, U64{0}, now, None)) ?? panic("stale process start fixture")
    live_transport_rejected(pid, path, "does not belong to process")
    cli_files.write_bytes(path, live_transport_fixture(pid, latest, max(0, now - 2001), None)) ?? panic("stale publication fixture")
    live_transport_rejected(pid, path, "not publishing a live runtime snapshot")
    cli_files.write_bytes(path, live_transport_fixture(pid + 1, latest, now, None)) ?? panic("wrong pid fixture")
    live_transport_rejected(pid, path, "does not belong to process")
    // PID error precedes event-validation error, exactly as LiveInspect::read.
    cli_files.write_bytes(path, live_transport_fixture(pid + 1, latest, now, Val(0))) ?? panic("wrong pid plus invalid event fixture")
    live_transport_rejected(pid, path, "does not belong to process")
    cli_files.write_bytes(path, live_transport_fixture(pid, latest, now, Val(0))) ?? panic("invalid event sequence fixture")
    live_transport_rejected(pid, path, "live runtime event observations are invalid: runtime event observation sequence is not strictly increasing")
    cli_files.write(path, " ".repeat(1048577)) ?? panic("oversized snapshot fixture")
    live_transport_rejected(pid, path, "1 MiB safety limit")
    cli_files.write_bytes(path, [U8]{U8{255}}) ?? panic("short snapshot fixture")
    live_transport_rejected(pid, path, "invalid or unsafe schema: live runtime snapshot is truncated")
    cli_files.remove_all(root) ?? panic("transport fixture cleanup")
}
