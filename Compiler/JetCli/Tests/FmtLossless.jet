// (deleted in 44561018e9). `jet fmt` must keep every meaningful token of every
// supported source in order. The oracle compares lexed token streams after a
// closed list of parser-equivalent rewrites: top-level formatter ordering;
// marker-list grouping; `Type<T>.method()`; external-method sugar; canonical
// anonymous union member order; optional declaration and trailing commas;
// redundant default file aliases; typed-literal constructor dot removal;
// formatter-added arm blocks, bare-lambda parens, leading-dot variant patterns,
// struct shorthand labels and separators; and a required default alias on a
// dotted module import. Later ratified spellings add: the redundant default
// alias in the `name: path` and `name: "file"` use forms; a one-member import
// list; import grouping; a leading parameter sigil riding the type; `Unit` as
// `()`; `Result<T, E>` as `T E!`; empty marker parentheses; dropped positional
// names in a function type; named tuple type member order; the `,` ending a
// wrapped loop header; the choice between `-> statement` and a braced
// control body; and `->` before a foreign declaration's return type.
// No rule can reorder or drop an expression operand, operator, marker payload,
// comment or string interpolation. Not ported: the `=>` arrow rules
// (`retired_result_arrow_removal`, the LambdaArrow half of
// `canonical_arrow_rewrite`). The Jet lexer has no `=>` token, so neither
// rewrite can occur. The pinned parse-invalid UI list is the set the Jet parser
// rejects today (`jfmt_check_parse_accepts`), not the Rust list. A UI fixture
// whose parse recovers through a teaching diagnostic spells a retired form on
// purpose; fmt rewrites it to canon, so its output must lex and parse with no
// teaching diagnostic left instead of keeping every token.
use {
    fl_files: core.files
    jet_cli.[jet_cli_fmt_ordinary]
    jet_driver.[jet_driver_inline_package]
    jet_foundation.[name_text]
    jet_lexer.[
        STRING_PART_BYTE, STRING_PART_INTERPOLATION, STRING_PART_TEXT, StringPart, TOKEN_AMP, TOKEN_AND_AND, TOKEN_BANG, TOKEN_BLOCK_COMMENT, TOKEN_OR_OR,
        TOKEN_CHAR, TOKEN_COLON, TOKEN_COMMA, TOKEN_DOT, TOKEN_EOF, TOKEN_EQ, TOKEN_EQ_EQ, TOKEN_FLOAT,
        TOKEN_GE, TOKEN_GT, TOKEN_HASH, TOKEN_IDENT, TOKEN_INT, TOKEN_KW_ELSE, TOKEN_KW_ENUM, TOKEN_KW_FN, TOKEN_KW_IF, TOKEN_KW_IMPL, TOKEN_KW_LOOP, TOKEN_KW_PUB,
        TOKEN_KW_STRUCT, TOKEN_KW_USE, TOKEN_LBRACE, TOKEN_LBRACKET, TOKEN_LE, TOKEN_LINE_COMMENT, TOKEN_LPAREN, TOKEN_LT, TOKEN_MINUS, TOKEN_NOT_EQ, TOKEN_NULL,
        TOKEN_PIPE, TOKEN_QUESTION, TOKEN_RAW_STRING, TOKEN_RBRACE, TOKEN_RBRACKET, TOKEN_RETURN, TOKEN_RPAREN, TOKEN_SEMI, TOKEN_SLASH, TOKEN_STAR, TOKEN_STRING,
        TOKEN_UNIFIED_ARROW, TOKEN_UNIT_NUMBER, Token, TokenTables, lex, token_decoded, token_string_parts,
    ]
    jet_parser.[jfmt_check_parse_accepts, jfmt_is_teaching_parse_diag, parse_source]
}

// Spellings from Compiler/JetFoundation/Data/Syntax, which this package
// cannot import.
FL_KW_AS: "as"
FL_KW_FROM: "from"
FL_TYPE_ERR: "Err"
FL_TYPE_RESULT: "Result"
FL_TYPE_UNIT: "Unit"
FL_CODE_BODYLESS_FN: "E0081"
FL_CODE_RESERVED_NAME: "E0067"
FL_ADAPTATION_AFTER_FILE: "after.jet"
FL_MARKER_TARGET: "Target"
FL_MARKER_HTML: "HTML"
FL_MARKER_NO_PRELUDE: "NoPrelude"
FL_PACKAGE_FILE: "package.jet"
FL_WORKSPACE_FILE: "workspace.jet"
FL_PAYLOAD_FILE: "pkg.jet"

// One lexed token, detached from its source's name table. `own_line` marks a
// comment that starts its source line.
FmtTok: struct {
    kind: Int
    text: String
    parts: [FmtPart]
    own_line: Bool{false}
}

FmtPart: struct {
    kind: Int
    text: String
    byte: Int
    tokens: [FmtTok]
}

FmtGroup: struct {
    category: Int
    tokens: [FmtTok]
}

// A rewrite that consumed tokens on both sides, or `ok: false`.
FmtStep: struct {
    ok: Bool
    original: Int
    formatted: Int
}

fl_no_step: fn() -> FmtStep { FmtStep{ok: false, original: 0, formatted: 0} }

fl_tok: fn(tables: TokenTables, token: Token) -> FmtTok {
    parts := [FmtPart]{}
    if token.kind == TOKEN_STRING || token.kind == TOKEN_RAW_STRING {
        loop part in token_string_parts(tables, token) -> parts.push(fl_part(tables, part))
    }
    FmtTok{kind: token.kind, text: token_decoded(tables, token), parts: parts.move()}
}

fl_part: fn(tables: TokenTables, part: StringPart) -> FmtPart {
    tokens := [FmtTok]{}
    loop token in part.tokens -> tokens.push(fl_tok(tables, token))
    FmtPart{kind: part.kind, text: name_text(tables.names, part.text), byte: part.byte, tokens: tokens.move()}
}

fl_synthetic: fn(kind: Int, text: String) -> FmtTok { FmtTok{kind: kind, text: text, parts: [FmtPart]{}} }

// Kind at `index`, or -1 outside the stream.
fl_kind: fn(tokens: [FmtTok], index: Int) -> Int {
    if index < 0 || index >= tokens.len() -> return -1
    tokens[index].kind
}

fl_is_ident: fn(tokens: [FmtTok], index: Int) -> Bool { fl_kind(tokens, index) == TOKEN_IDENT }

fl_is_arrow: fn(kind: Int) -> Bool { kind == TOKEN_UNIFIED_ARROW }

fl_is_trivia: fn(kind: Int) -> Bool {
    kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT || kind == TOKEN_SEMI || kind == TOKEN_EOF
}

fl_is_comment: fn(kind: Int) -> Bool { kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT }

fl_uppercase_start: fn(text: String) -> Bool {
    bytes: text.bytes()
    bytes.len() > 0 && bytes[0] >= 65 && bytes[0] <= 90
}

// The lexer's diagnostics for `src`, or "".
fl_lex_codes: fn(src: String) -> String {
    codes := ""
    loop diagnostic in lex(src.bytes()).diagnostics -> codes = "{codes} {diagnostic.code}: {diagnostic.what};"
    codes
}

fl_lex: fn(src: String, path: String) -> [FmtTok] {
    bytes: src.bytes()
    lexed: lex(bytes)
    if lexed.diagnostics.len() > 0 -> panic("lex failed on {path}:{fl_lex_codes(src)}")
    out := [FmtTok]{}
    loop token in lexed.tokens {
        converted := fl_tok(lexed.tables, token)
        if fl_is_comment(token.kind) -> converted.own_line = fl_starts_line(bytes, token.span.start)
        out.push(converted)
    }
    out
}

// Only blanks sit between the previous line break and `start`.
fl_starts_line: fn(bytes: [U8], start: Int) -> Bool {
    cursor := start - 1
    loop cursor >= 0 && (bytes[cursor] == 32 || bytes[cursor] == 9) -> cursor -= 1
    cursor < 0 || bytes[cursor] == 10 || bytes[cursor] == 13
}

fl_canonical_tokens: fn(src: String, path: String) -> [FmtTok] {
    tokens: fl_canonicalize_fn_type_names(fl_canonicalize_control_arrow_bodies(fl_canonicalize_external_methods(fl_canonicalize_static_generic_calls(fl_expand_marker_groups(fl_canonicalize_file_prefix(fl_lex(src, path)))))))
    enum_commas: fl_enum_group_commas(tokens)
    field_commas: fl_declaration_field_commas(tokens)
    arm_commas: fl_table_arm_commas(tokens)
    kept := [FmtTok]{}
    loop index in 0..<tokens.len() {
        if enum_commas[index] || field_commas[index] || arm_commas[index] -> next
        if tokens[index].kind == TOKEN_SEMI || tokens[index].kind == TOKEN_EOF -> next
        kept.push(tokens[index])
    }
    canonical := [FmtTok]{}
    index := 0
    loop index < kept.len() {
        next_kind: fl_kind(kept, index + 1)
        if kept[index].kind == TOKEN_COMMA && (next_kind == TOKEN_RPAREN || next_kind == TOKEN_RBRACKET || next_kind == TOKEN_RBRACE) {
            index += 1
            next
        }
        // The formatter omits an explicit default `Err` in a
        // fallible return type (`T !Err` -> `T !`), never an `Err(...)` value.
        if kept[index].kind == TOKEN_IDENT && kept[index].text == FL_TYPE_ERR && fl_kind(canonical, canonical.len() - 1) == TOKEN_BANG && (next_kind == TOKEN_LBRACE || next_kind == TOKEN_EQ) {
            index += 1
            next
        }
        // `use "./foo" as foo` and `use "./foo"` parse identically.
        if fl_redundant_default_file_alias(canonical, kept, index) {
            index += 2
            next
        }
        // The same redundant default alias in the `name: path` use
        // spelling: `json: core.encoding.json` binds what
        // `core.encoding.json` binds, and `text: "./text"` what `"./text"`
        // binds.
        if fl_redundant_default_module_alias(kept, index) || fl_redundant_file_binding_alias(kept, index) {
            index += 2
            next
        }
        // `use math.[clamp]` and `use math.clamp` import the same member when
        // the module path has no dot.
        if fl_single_member_import_list(kept, index) {
            canonical.push(kept[index])
            canonical.push(kept[index + 2])
            index += 4
            next
        }
        // The access sigil rides the type: `&&s: T` is `s: &&T`.
        if fl_leading_param_sigil(kept, index) {
            canonical.push(kept[index + 1])
            canonical.push(kept[index + 2])
            canonical.push(kept[index])
            index += 3
            next
        }
        // The unit type `Unit` is `()`.
        if fl_unit_type_name(kept, index) {
            canonical.push(fl_synthetic(TOKEN_LPAREN, "("))
            canonical.push(fl_synthetic(TOKEN_RPAREN, ")"))
            index += 1
            next
        }
        // Empty marker parentheses are the retired spelling of the bare
        // marker: `#Inline()` is `#Inline`.
        if kept[index].kind == TOKEN_HASH && fl_is_ident(kept, index + 1) && fl_kind(kept, index + 2) == TOKEN_LPAREN && fl_kind(kept, index + 3) == TOKEN_RPAREN {
            canonical.push(kept[index])
            canonical.push(kept[index + 1])
            index += 4
            next
        }
        // `Result<T, E>` is the error contract `T E!`.
        if fl_is_ident(kept, index) && kept[index].text == FL_TYPE_RESULT && fl_kind(kept, index + 1) == TOKEN_LT && fl_is_ident(kept, index + 2) && fl_kind(kept, index + 3) == TOKEN_COMMA && fl_is_ident(kept, index + 4) && fl_kind(kept, index + 5) == TOKEN_GT {
            canonical.push(kept[index + 2])
            if kept[index + 4].text != FL_TYPE_ERR -> canonical.push(kept[index + 4])
            canonical.push(fl_synthetic(TOKEN_BANG, "!"))
            index += 6
            next
        }
        // The prefix declaration spelling `fn name(` is `name: fn(`.
        if kept[index].kind == TOKEN_KW_FN && fl_is_ident(kept, index + 1) && fl_kind(kept, index + 2) == TOKEN_LPAREN {
            canonical.push(kept[index + 1])
            canonical.push(fl_synthetic(TOKEN_COLON, ":"))
            canonical.push(kept[index])
            index += 2
            next
        }
        // A parenthesized optional return type: `-> (Int?)` is `-> Int?`, and
        // so after an effect arrow `-[E]> (Int?)`.
        if (fl_kind(kept, index - 1) == TOKEN_UNIFIED_ARROW || (fl_kind(kept, index - 1) == TOKEN_GT && fl_kind(kept, index - 2) == TOKEN_RBRACKET)) && kept[index].kind == TOKEN_LPAREN && fl_is_ident(kept, index + 1) && fl_kind(kept, index + 2) == TOKEN_QUESTION && fl_kind(kept, index + 3) == TOKEN_RPAREN {
            canonical.push(kept[index + 1])
            canonical.push(kept[index + 2])
            index += 4
            next
        }
        // A foreign declaration's return type may omit `->`:
        // `fn(a: Int) Int = "sym"` is `fn(a: Int) -> Int = "sym"`.
        if fl_bare_foreign_return(kept, index) {
            canonical.push(kept[index])
            canonical.push(fl_synthetic(TOKEN_UNIFIED_ARROW, "->"))
            index += 1
            next
        }
        // A late effect row parses to the leading one:
        // `fn() -> String -[E]>` is `fn() -[E]> String`.
        late_row_end: fl_late_effect_row_end(kept, index)
        if late_row_end > 0 {
            loop cursor in index + 2..<late_row_end -> canonical.push(kept[cursor])
            canonical.push(kept[index + 1])
            index = late_row_end
            next
        }
        // `T: A | B` in a generic parameter list is `T: [A, B]`.
        bounds_end: fl_piped_generic_bounds_end(kept, index)
        if bounds_end > 0 {
            canonical.push(fl_synthetic(TOKEN_LBRACKET, "["))
            loop cursor in index..<bounds_end {
                if kept[cursor].kind == TOKEN_PIPE -> canonical.push(fl_synthetic(TOKEN_COMMA, ",")) else -> canonical.push(kept[cursor])
            }
            canonical.push(fl_synthetic(TOKEN_RBRACKET, "]"))
            index = bounds_end
            next
        }
        canonical.push(kept[index])
        index += 1
    }
    fl_drop_and_groups_in_or(fl_flatten_use_groups(canonical))
}

// `&&` binds tighter than `||`, so parentheses around an `&&` chain that is a
// direct `||` operand group nothing: `(a && b) || c` is `a && b || c`.
fl_drop_and_groups_in_or: fn(tokens: [FmtTok]) -> [FmtTok] {
    dropped := [Bool]{}
    loop _ in 0..<tokens.len() -> dropped.push(false)
    loop index in 0..<tokens.len() {
        if tokens[index].kind != TOKEN_LPAREN -> next
        before: fl_kind(tokens, index - 1)
        close: fl_matching(tokens, index, TOKEN_LPAREN, TOKEN_RPAREN)
        if close < 0 -> next
        after: fl_kind(tokens, close + 1)
        if before != TOKEN_OR_OR && after != TOKEN_OR_OR -> next
        if !fl_logic_operand_left_edge(before) || !fl_logic_operand_right_edge(tokens, close + 1) -> next
        depth := 0
        and_chain := false
        loop cursor in index + 1..<close {
            kind: tokens[cursor].kind
            if fl_is_opener(kind) -> depth += 1
            if fl_is_closer(kind) -> depth -= 1
            if depth != 0 -> next
            if kind == TOKEN_AND_AND -> and_chain = true
            // Only `&&` and operands tighter than it may sit at the top level.
            if kind == TOKEN_OR_OR || kind == TOKEN_COMMA || kind == TOKEN_UNIFIED_ARROW || kind == TOKEN_PIPE {
                and_chain = false
                break
            }
        }
        if !and_chain -> next
        dropped[index] = true
        dropped[close] = true
    }
    out := [FmtTok]{}
    loop index in 0..<tokens.len() {
        if !dropped[index] -> out.push(tokens[index])
    }
    out
}

// A token that ends the expression context before a logic operand group.
fl_logic_operand_left_edge: fn(kind: Int) -> Bool {
    kind == TOKEN_OR_OR || kind == TOKEN_AND_AND || kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE || kind == TOKEN_RBRACE || kind == TOKEN_COMMA || kind == TOKEN_COLON || kind == TOKEN_EQ || kind == TOKEN_KW_IF || kind == TOKEN_KW_ELSE || kind == TOKEN_RETURN || kind == TOKEN_UNIFIED_ARROW
}

// The token after a logic operand group binds no tighter than `&&`.
fl_logic_operand_right_edge: fn(tokens: [FmtTok], index: Int) -> Bool {
    kind: fl_kind(tokens, index)
    if kind == TOKEN_IDENT -> return tokens[index].text != FL_KW_AS
    kind == TOKEN_OR_OR || kind == TOKEN_AND_AND || kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE || kind == TOKEN_LBRACE || kind == TOKEN_COMMA || kind == TOKEN_EOF || kind == TOKEN_UNIFIED_ARROW || kind == TOKEN_KW_IF || kind == TOKEN_KW_LOOP || kind == TOKEN_RETURN
}

// A `use { … }` group and one `use` per row parse to the same imports: each
// group row gets its own `use` keyword and the group braces go.
fl_flatten_use_groups: fn(tokens: [FmtTok]) -> [FmtTok] {
    out := [FmtTok]{}
    index := 0
    loop index < tokens.len() {
        if tokens[index].kind == TOKEN_KW_USE && fl_kind(tokens, index + 1) == TOKEN_LBRACE {
            close: fl_matching(tokens, index + 1, TOKEN_LBRACE, TOKEN_RBRACE)
            if close > index + 1 {
                depth := 0
                loop cursor in index + 2..<close {
                    kind: tokens[cursor].kind
                    if depth == 0 && fl_use_row_start(tokens, index + 1, cursor) -> out.push(tokens[index].copy())
                    if fl_is_opener(kind) -> depth += 1
                    if fl_is_closer(kind) -> depth -= 1
                    out.push(tokens[cursor].copy())
                }
                index = close + 1
                next
            }
        }
        out.push(tokens[index].copy())
        index += 1
    }
    out
}

// Whether `cursor`, at the top level of the use group opened at `open`,
// starts an import row. Comments ride with the row after them.
fl_use_row_start: fn(tokens: [FmtTok], open: Int, cursor: Int) -> Bool {
    kind: tokens[cursor].kind
    if kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT -> return false
    if kind != TOKEN_IDENT && kind != TOKEN_STRING && kind != TOKEN_HASH && kind != TOKEN_KW_PUB -> return false
    if kind == TOKEN_IDENT && tokens[cursor].text == FL_KW_AS -> return false
    if cursor == open + 1 -> return true
    previous: tokens[cursor - 1]
    if previous.kind == TOKEN_LINE_COMMENT || previous.kind == TOKEN_BLOCK_COMMENT -> return true
    if previous.kind == TOKEN_DOT || previous.kind == TOKEN_COLON || previous.kind == TOKEN_LBRACKET || previous.kind == TOKEN_COMMA || previous.kind == TOKEN_HASH || previous.kind == TOKEN_KW_PUB -> return false
    !(previous.kind == TOKEN_IDENT && previous.text == FL_KW_AS)
}

// A token inside a use declaration: directly after `use`, a row of a
// `use { … }` group, or within one import path.
fl_in_use: fn(tokens: [FmtTok], index: Int) -> Bool {
    open: fl_enclosing_brace(tokens, index)
    if open >= 0 && fl_kind(tokens, open - 1) == TOKEN_KW_USE -> return true
    cursor := index - 1
    loop cursor >= 0 && (fl_kind(tokens, cursor) == TOKEN_IDENT || fl_kind(tokens, cursor) == TOKEN_DOT || fl_kind(tokens, cursor) == TOKEN_COLON) -> cursor -= 1
    fl_kind(tokens, cursor) == TOKEN_KW_USE
}

// `name: a.b.name` or `name: name` inside a use declaration, where the alias
// repeats the path's last segment.
fl_redundant_default_module_alias: fn(tokens: [FmtTok], index: Int) -> Bool {
    if fl_kind(tokens, index) != TOKEN_IDENT || fl_kind(tokens, index + 1) != TOKEN_COLON || fl_kind(tokens, index + 2) != TOKEN_IDENT -> return false
    open: fl_enclosing_brace(tokens, index)
    in_use: fl_kind(tokens, index - 1) == TOKEN_KW_USE || (open >= 0 && fl_kind(tokens, open - 1) == TOKEN_KW_USE)
    if !in_use -> return false
    last := index + 2
    loop fl_kind(tokens, last + 1) == TOKEN_DOT && fl_kind(tokens, last + 2) == TOKEN_IDENT -> last += 2
    after: fl_kind(tokens, last + 1)
    if after == TOKEN_DOT || after == TOKEN_LBRACKET -> return false
    tokens[last].text == tokens[index].text
}

// `name: "dir/name"` inside a use declaration: the alias repeats the file
// path's last segment.
fl_redundant_file_binding_alias: fn(tokens: [FmtTok], index: Int) -> Bool {
    if fl_kind(tokens, index) != TOKEN_IDENT || fl_kind(tokens, index + 1) != TOKEN_COLON || fl_kind(tokens, index + 2) != TOKEN_STRING -> return false
    open: fl_enclosing_brace(tokens, index)
    in_use: fl_kind(tokens, index - 1) == TOKEN_KW_USE || (open >= 0 && fl_kind(tokens, open - 1) == TOKEN_KW_USE)
    if !in_use -> return false
    path: fl_plain_string_value(tokens[index + 2].parts) ?? return false
    segments: path.split("/").to_list()
    segments[segments.len() - 1] == tokens[index].text
}

// `.[name]` after a dotless module name in a use declaration.
fl_single_member_import_list: fn(tokens: [FmtTok], index: Int) -> Bool {
    if fl_kind(tokens, index) != TOKEN_DOT || fl_kind(tokens, index + 1) != TOKEN_LBRACKET || fl_kind(tokens, index + 2) != TOKEN_IDENT || fl_kind(tokens, index + 3) != TOKEN_RBRACKET -> return false
    if fl_kind(tokens, index - 1) != TOKEN_IDENT || fl_kind(tokens, index - 2) == TOKEN_DOT -> return false
    fl_in_use(tokens, index)
}

// `&name:` or `&&name:` opening a parameter, after any bare `#Marker`.
fl_leading_param_sigil: fn(tokens: [FmtTok], index: Int) -> Bool {
    kind: fl_kind(tokens, index)
    if kind != TOKEN_AMP && kind != TOKEN_AND_AND -> return false
    if fl_kind(tokens, index + 1) != TOKEN_IDENT || fl_kind(tokens, index + 2) != TOKEN_COLON -> return false
    head := index - 1
    loop fl_kind(tokens, head) == TOKEN_IDENT && fl_kind(tokens, head - 1) == TOKEN_HASH -> head -= 2
    before: fl_kind(tokens, head)
    before == TOKEN_LPAREN || before == TOKEN_COMMA
}

// `T: A | B` in a `fn<…>` or `struct<…>` parameter list parses to the bound
// list `T: [A, B]`. The end of the bounds starting at `index`, or -1.
fl_piped_generic_bounds_end: fn(tokens: [FmtTok], index: Int) -> Int {
    if fl_kind(tokens, index) != TOKEN_IDENT || fl_kind(tokens, index - 1) != TOKEN_COLON || fl_kind(tokens, index - 2) != TOKEN_IDENT -> return -1
    end := index + 1
    loop fl_kind(tokens, end) == TOKEN_PIPE && fl_kind(tokens, end + 1) == TOKEN_IDENT -> end += 2
    if end == index + 1 || (fl_kind(tokens, end) != TOKEN_COMMA && fl_kind(tokens, end) != TOKEN_GT) -> return -1
    // Back over the earlier parameters, `Name` or `Name: bounds`, to the `<`.
    cursor := index - 3
    loop cursor >= 0 && fl_generic_param_token(tokens[cursor].kind) -> cursor -= 1
    if fl_kind(tokens, cursor) != TOKEN_LT -> return -1
    owner: fl_kind(tokens, cursor - 1)
    if owner == TOKEN_KW_FN || owner == TOKEN_KW_STRUCT -> end else -> -1
}

fl_generic_param_token: fn(kind: Int) -> Bool {
    kind == TOKEN_IDENT || kind == TOKEN_PIPE || kind == TOKEN_COLON || kind == TOKEN_COMMA || kind == TOKEN_LBRACKET || kind == TOKEN_RBRACKET
}

// `-> Type -[E]>`: a single-name return type before a late effect row. The
// index after the row's `>`, or -1.
fl_late_effect_row_end: fn(tokens: [FmtTok], index: Int) -> Int {
    if fl_kind(tokens, index) != TOKEN_UNIFIED_ARROW || fl_kind(tokens, index + 1) != TOKEN_IDENT || fl_kind(tokens, index + 2) != TOKEN_MINUS || fl_kind(tokens, index + 3) != TOKEN_LBRACKET -> return -1
    close: fl_matching(tokens, index + 3, TOKEN_LBRACKET, TOKEN_RBRACKET)
    if close < 0 || fl_kind(tokens, close + 1) != TOKEN_GT -> return -1
    close + 2
}

// `fn(a: Int) Int = "sym"`: a foreign declaration's return type written
// without `->`, which the parser reads as `fn(a: Int) -> Int = "sym"`. True at
// the parameter list's `)` when a type follows and the declaration ends at
// `= "…"`.
fl_bare_foreign_return: fn(tokens: [FmtTok], index: Int) -> Bool {
    if fl_kind(tokens, index) != TOKEN_RPAREN -> return false
    after: fl_kind(tokens, index + 1)
    if after != TOKEN_IDENT && after != TOKEN_QUESTION && after != TOKEN_LBRACKET && after != TOKEN_LPAREN -> return false
    depth := 0
    open := index
    loop open >= 0 {
        kind: tokens[open].kind
        if kind == TOKEN_RPAREN -> depth += 1
        if kind == TOKEN_LPAREN -> depth -= 1
        if depth == 0 -> break
        open -= 1
    }
    if open < 1 || tokens[open - 1].kind != TOKEN_KW_FN -> return false
    depth = 0
    cursor := index + 1
    loop cursor < tokens.len() {
        kind: tokens[cursor].kind
        if {
            kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LT -> depth += 1
            kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_GT -> depth -= 1
            kind == TOKEN_EQ && depth == 0 -> return fl_kind(tokens, cursor + 1) == TOKEN_STRING
            kind == TOKEN_COMMA && depth == 0 -> return false
            kind == TOKEN_LBRACE || kind == TOKEN_RBRACE || kind == TOKEN_BANG || kind == TOKEN_MINUS || kind == TOKEN_UNIFIED_ARROW || kind == TOKEN_KW_FN -> return false
            else -> {}
        }
        if depth < 0 -> return false
        cursor += 1
    }
    false
}

// The type name `Unit`, not a path head, call or constructor.
fl_unit_type_name: fn(tokens: [FmtTok], index: Int) -> Bool {
    if fl_kind(tokens, index) != TOKEN_IDENT || tokens[index].text != FL_TYPE_UNIT -> return false
    after: fl_kind(tokens, index + 1)
    after != TOKEN_DOT && after != TOKEN_LPAREN && after != TOKEN_LT && after != TOKEN_COLON
}

fl_is_opener: fn(kind: Int) -> Bool { kind == TOKEN_LBRACE || kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET }

fl_is_closer: fn(kind: Int) -> Bool { kind == TOKEN_RBRACE || kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET }

// An `->` that opens the body of a statement-position `loop`, `if`, or
// `else`. Arm, callable, lambda, and value-position arrows are not bodies.
fl_is_control_body_arrow: fn(tokens: [FmtTok], arrow: Int) -> Bool {
    if tokens[arrow].kind != TOKEN_UNIFIED_ARROW -> return false
    if fl_kind(tokens, arrow - 1) == TOKEN_KW_ELSE -> return true
    depth := 0
    cursor := arrow - 1
    loop cursor >= 0 {
        kind: tokens[cursor].kind
        if fl_is_closer(kind) {
            depth += 1
        } else if fl_is_opener(kind) {
            if depth == 0 -> break
            depth -= 1
        } else if depth == 0 && (kind == TOKEN_SEMI || kind == TOKEN_KW_ELSE || kind == TOKEN_UNIFIED_ARROW) {
            break
        }
        cursor -= 1
    }
    head := cursor + 1
    loop head < arrow && fl_is_trivia(tokens[head].kind) -> head += 1
    head < arrow && (tokens[head].kind == TOKEN_KW_LOOP || tokens[head].kind == TOKEN_KW_IF)
}

// The token that ends the one-statement body after `arrow`.
fl_control_body_end: fn(tokens: [FmtTok], arrow: Int) -> Int {
    depth := 0
    loop cursor in arrow + 1..<tokens.len() {
        kind: tokens[cursor].kind
        if fl_is_opener(kind) {
            depth += 1
            next
        }
        if fl_is_closer(kind) {
            if depth == 0 -> return cursor
            depth -= 1
            next
        }
        if depth == 0 && (kind == TOKEN_SEMI || kind == TOKEN_EOF || kind == TOKEN_KW_ELSE) -> return cursor
        // The lexer's line-break `;` follows the comments before the next
        // statement; a comment on its own line already sits after the body.
        if depth == 0 && tokens[cursor].own_line && cursor > arrow + 1 -> return cursor
    }
    tokens.len()
}

// "The formatter chooses the arrow when one simple body
// fits and braces otherwise." Both spellings of a statement-position control
// body canonicalize to the braced body; the arrow choice is layout.
fl_canonicalize_control_arrow_bodies: fn(tokens: [FmtTok]) -> [FmtTok] {
    closes := [Int]{}
    loop _ in 0..<tokens.len() + 1 -> closes.push(0)
    bodies := [Bool]{}
    loop index in 0..<tokens.len() {
        body: fl_is_control_body_arrow(tokens, index)
        bodies.push(body)
        if body {
            end: fl_control_body_end(tokens, index)
            closes[end] = closes[end] + 1
        }
    }
    out := [FmtTok]{}
    loop index in 0..<tokens.len() {
        loop _ in 0..<closes[index] -> out.push(fl_synthetic(TOKEN_RBRACE, "}}"))
        if bodies[index] {
            out.push(fl_synthetic(TOKEN_LBRACE, "{{"))
        } else {
            out.push(tokens[index])
        }
    }
    loop _ in 0..<closes[tokens.len()] -> out.push(fl_synthetic(TOKEN_RBRACE, "}}"))
    out
}

// A function type keeps no names for its positional parameters (labels follow
// `*`), and `from name` names a parameter by its synthetic `_N` owner, so
// `fn(line: String) -> View<str> from line` is `fn(String) -> View<str> from _0`.
fl_canonicalize_fn_type_names: fn(tokens: [FmtTok]) -> [FmtTok] {
    dropped := [Bool]{}
    loop _ in 0..<tokens.len() -> dropped.push(false)
    renamed := [String:String]{}
    out := [FmtTok]{}
    loop index in 0..<tokens.len() {
        if tokens[index].kind != TOKEN_KW_FN || fl_kind(tokens, index + 1) != TOKEN_LPAREN -> next
        close: fl_matching(tokens, index + 1, TOKEN_LPAREN, TOKEN_RPAREN)
        if close < 0 || fl_fn_has_body(tokens, close) -> next
        names := [String:Int]{}
        position := 0
        depth := 0
        labels := false
        loop cursor in index + 2..<close {
            kind: tokens[cursor].kind
            if fl_is_opener(kind) || kind == TOKEN_LT {
                depth += 1
                next
            }
            if fl_is_closer(kind) || kind == TOKEN_GT {
                depth -= 1
                next
            }
            if depth != 0 -> next
            if kind == TOKEN_STAR {
                labels = true
                next
            }
            starts: fl_kind(tokens, cursor - 1) == TOKEN_LPAREN || fl_kind(tokens, cursor - 1) == TOKEN_COMMA
            if starts && kind != TOKEN_SLASH {
                if !labels && kind == TOKEN_IDENT && fl_kind(tokens, cursor + 1) == TOKEN_COLON {
                    dropped[cursor] = true
                    dropped[cursor + 1] = true
                    names[tokens[cursor].text] = position
                }
                position += 1
            }
        }
        // `from line | other`: each named source after the return type.
        cursor := close + 1
        loop cursor < tokens.len() && tokens[cursor].kind != TOKEN_SEMI && tokens[cursor].kind != TOKEN_COMMA && !fl_is_closer(tokens[cursor].kind) && tokens[cursor].kind != TOKEN_LBRACE {
            if fl_is_ident(tokens, cursor) && tokens[cursor].text == FL_KW_FROM {
                source := cursor + 1
                loop fl_is_ident(tokens, source) {
                    if names.get(tokens[source].text) == .Val(slot) -> renamed["{source}"] = "_{slot}"
                    if fl_kind(tokens, source + 1) != TOKEN_PIPE -> break
                    source += 2
                }
                break
            }
            cursor += 1
        }
    }
    loop index in 0..<tokens.len() {
        if dropped[index] -> next
        if renamed.get("{index}") == .Val(name) {
            out.push(fl_synthetic(TOKEN_IDENT, name))
            next
        }
        out.push(tokens[index])
    }
    out
}

// A `{` body follows the parameter list that closes at `close` before the
// declaration ends.
fl_fn_has_body: fn(tokens: [FmtTok], close: Int) -> Bool {
    depth := 0
    loop cursor in close + 1..<tokens.len() {
        kind: tokens[cursor].kind
        if depth == 0 && kind == TOKEN_LBRACE -> return true
        if depth == 0 && (kind == TOKEN_SEMI || kind == TOKEN_EOF || kind == TOKEN_COMMA || kind == TOKEN_RBRACE || kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET) -> return false
        if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LT -> depth += 1
        // The `>` closing an effect arrow `-[E]>` closes no `<`.
        if kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || (kind == TOKEN_GT && depth > 0) -> depth -= 1
    }
    false
}

fl_all_trivia: fn(tokens: [FmtTok]) -> Bool {
    loop token in tokens {
        if !fl_is_trivia(token.kind) -> return false
    }
    true
}

fl_canonicalize_file_prefix: fn(tokens: [FmtTok]) -> [FmtTok] {
    chunks := [[FmtTok]]{}
    chunk := [FmtTok]{}
    brace_depth := 0
    loop token in tokens {
        if token.kind == TOKEN_LBRACE -> brace_depth += 1
        if token.kind == TOKEN_RBRACE -> brace_depth -= 1
        end: token.kind == TOKEN_EOF || (brace_depth == 0 && token.kind == TOKEN_SEMI)
        chunk.push(token.copy())
        if end {
            chunks.push(chunk)
            chunk = [FmtTok]{}
        }
    }
    if chunk.len() > 0 -> chunks.push(chunk)

    groups := [FmtGroup]{}
    leading := [FmtTok]{}
    loop current in chunks {
        if fl_all_trivia(current) {
            loop token in current -> leading.push(token)
            next
        }
        loop token in current -> leading.push(token)
        groups.push(FmtGroup{category: fl_file_chunk_category(leading), tokens: leading})
        leading = [FmtTok]{}
    }
    if leading.len() > 0 -> groups.push(FmtGroup{category: 3, tokens: leading})
    loop directive in 0..<groups.len() {
        if !fl_is_spanless_file_marker_group(groups[directive].tokens) -> next
        displaced := [FmtTok]{}
        rest := [FmtTok]{}
        leading_trivia := true
        loop token in groups[directive].tokens {
            if leading_trivia && (fl_is_comment(token.kind) || token.kind == TOKEN_SEMI) {
                displaced.push(token)
            } else {
                leading_trivia = false
                rest.push(token)
            }
        }
        // fmt prints imports first, so an import after the directive emits the
        // comments the spanless directive cannot hold; otherwise the next item.
        target := -1
        loop candidate in directive + 1..<groups.len() {
            if groups[candidate].category == 1 {
                target = candidate
                break
            }
        }
        if target < 0 {
            loop candidate in directive + 1..<groups.len() {
                if groups[candidate].category == 3 {
                    target = candidate
                    break
                }
            }
        }
        // Rust drains the displaced trivia even when no item follows.
        groups[directive].tokens = rest
        if target >= 0 {
            loop token in groups[target].tokens -> displaced.push(token)
            groups[target].tokens = displaced
        }
    }
    loop import in 0..<groups.len() {
        if groups[import].category != 1 -> next
        hoisted := [FmtTok]{}
        // An earlier import keeps its own comments: fmt prints every import in
        // one `use` group under the first import's comments.
        loop earlier in 0..<import {
            if groups[earlier].category == 1 -> next
            retained := [FmtTok]{}
            depth := 0
            loop token in groups[earlier].tokens {
                if token.kind == TOKEN_LBRACE -> depth += 1
                if token.kind == TOKEN_RBRACE -> depth -= 1
                if fl_is_comment(token.kind) && depth == 0 {
                    hoisted.push(token)
                    next
                }
                retained.push(token)
            }
            groups[earlier].tokens = retained
        }
        if hoisted.len() > 0 {
            loop token in groups[import].tokens -> hoisted.push(token)
            groups[import].tokens = hoisted
        }
    }
    out := [FmtTok]{}
    loop category in 0..<4 {
        loop group in groups {
            if group.category == category {
                loop token in group.tokens -> out.push(token)
            }
        }
    }
    out
}

fl_code_tokens: fn(tokens: [FmtTok]) -> [FmtTok] {
    out := [FmtTok]{}
    loop token in tokens {
        if !fl_is_trivia(token.kind) -> out.push(token.copy())
    }
    out
}

fl_is_spanless_file_marker_group: fn(tokens: [FmtTok]) -> Bool {
    code: fl_code_tokens(tokens)
    code.len() >= 2 && code[0].kind == TOKEN_HASH && code[1].kind == TOKEN_IDENT && (code[1].text == FL_MARKER_TARGET || code[1].text == FL_MARKER_HTML)
}

fl_file_chunk_category: fn(chunk: [FmtTok]) -> Int {
    code: fl_code_tokens(chunk)
    if code.len() == 0 -> return 3
    if code[0].kind == TOKEN_KW_USE -> return 1
    if code[0].kind == TOKEN_KW_PUB {
        loop index in 1..<code.len() {
            if code[index].kind == TOKEN_KW_USE -> return 1
        }
    }
    if code.len() >= 2 && code[0].kind == TOKEN_HASH && code[1].kind == TOKEN_IDENT {
        if code[1].text == FL_MARKER_NO_PRELUDE -> return 0
        if code[1].text == FL_MARKER_TARGET || code[1].text == FL_MARKER_HTML -> return 2
    }
    3
}

fl_expand_marker_groups: fn(tokens: [FmtTok]) -> [FmtTok] {
    out := [FmtTok]{}
    index := 0
    loop index < tokens.len() {
        if tokens[index].kind == TOKEN_HASH && fl_kind(tokens, index + 1) == TOKEN_LBRACKET {
            end: fl_matching(tokens, index + 1, TOKEN_LBRACKET, TOKEN_RBRACKET)
            if end >= 0 {
                group_start := index + 2
                paren_depth := 0
                brace_depth := 0
                bracket_depth := 0
                loop cursor in index + 2..<end + 1 {
                    kind: tokens[cursor].kind
                    split: cursor == end || (kind == TOKEN_COMMA && paren_depth == 0 && brace_depth == 0 && bracket_depth == 0)
                    if split {
                        out.push(tokens[index])
                        loop member in group_start..<cursor -> out.push(tokens[member])
                        group_start = cursor + 1
                        next
                    }
                    if kind == TOKEN_LPAREN -> paren_depth += 1
                    if kind == TOKEN_RPAREN -> paren_depth -= 1
                    if kind == TOKEN_LBRACE -> brace_depth += 1
                    if kind == TOKEN_RBRACE -> brace_depth -= 1
                    if kind == TOKEN_LBRACKET -> bracket_depth += 1
                    if kind == TOKEN_RBRACKET -> bracket_depth -= 1
                }
                index = end + 1
                next
            }
        }
        out.push(tokens[index])
        index += 1
    }
    out
}

// Index of the closer matching the opener at `open`, or -1.
fl_matching: fn(tokens: [FmtTok], open: Int, opener: Int, closer: Int) -> Int {
    depth := 0
    loop index in open..<tokens.len() {
        if tokens[index].kind == opener -> depth += 1
        if tokens[index].kind == closer {
            depth -= 1
            if depth == 0 -> return index
        }
    }
    -1
}

fl_canonicalize_static_generic_calls: fn(tokens: [FmtTok]) -> [FmtTok] {
    out := [FmtTok]{}
    index := 0
    loop index < tokens.len() {
        if tokens[index].kind == TOKEN_IDENT && fl_kind(tokens, index + 1) == TOKEN_LT {
            close: fl_matching(tokens, index + 1, TOKEN_LT, TOKEN_GT)
            if close >= 0 && fl_kind(tokens, close + 1) == TOKEN_DOT && fl_kind(tokens, close + 2) == TOKEN_IDENT && fl_kind(tokens, close + 3) == TOKEN_LPAREN {
                out.push(tokens[index])
                out.push(tokens[close + 1])
                out.push(tokens[close + 2])
                loop generic in index + 1..<close + 1 -> out.push(tokens[generic])
                index = close + 3
                next
            }
        }
        out.push(tokens[index])
        index += 1
    }
    out
}

// External-method sugar `Type.method: fn(...) {...}` is the method inside
// `impl Type { method: fn(...) {...} }`.
fl_canonicalize_external_methods: fn(tokens: [FmtTok]) -> [FmtTok] {
    out := [FmtTok]{}
    index := 0
    loop index < tokens.len() {
        if tokens[index].kind == TOKEN_IDENT && fl_kind(tokens, index + 1) == TOKEN_DOT && fl_kind(tokens, index + 2) == TOKEN_IDENT && fl_kind(tokens, index + 3) == TOKEN_COLON && fl_kind(tokens, index + 4) == TOKEN_KW_FN {
            body_open := -1
            loop cursor in index + 4..<tokens.len() {
                if tokens[cursor].kind == TOKEN_LBRACE {
                    body_open = cursor
                    break
                }
            }
            if body_open >= 0 {
                body_close: fl_matching(tokens, body_open, TOKEN_LBRACE, TOKEN_RBRACE)
                if body_close >= 0 {
                    out.push(fl_synthetic(TOKEN_KW_IMPL, "impl"))
                    out.push(tokens[index])
                    out.push(fl_synthetic(TOKEN_LBRACE, "{{"))
                    loop body in index + 2..<body_close + 1 -> out.push(tokens[body])
                    out.push(fl_synthetic(TOKEN_RBRACE, "}}"))
                    index = body_close + 1
                    next
                }
            } else {
                method_end := -1
                loop cursor in index + 4..<tokens.len() {
                    if tokens[cursor].kind == TOKEN_SEMI || tokens[cursor].kind == TOKEN_EOF {
                        method_end = cursor
                        break
                    }
                }
                // The one-line body (`Type -> value`) has no brace to anchor
                // on; wrap that exact method span in the same impl shape.
                if method_end >= 0 {
                    out.push(fl_synthetic(TOKEN_KW_IMPL, "impl"))
                    out.push(tokens[index])
                    out.push(fl_synthetic(TOKEN_LBRACE, "{{"))
                    loop body in index + 2..<method_end -> out.push(tokens[body])
                    out.push(fl_synthetic(TOKEN_RBRACE, "}}"))
                    index = method_end
                    next
                }
            }
        }
        out.push(tokens[index])
        index += 1
    }
    out
}

fl_enum_group_commas: fn(tokens: [FmtTok]) -> [Bool] {
    ignored := [Bool]{}
    loop _ in 0..<tokens.len() -> ignored.push(false)
    enum_base_depth := -1
    awaiting_enum_body := false
    brace_stack := [Int]{}
    loop index in 0..<tokens.len() {
        kind: tokens[index].kind
        if kind == TOKEN_KW_ENUM {
            awaiting_enum_body = true
        } else if kind == TOKEN_LBRACE {
            brace_stack.push(index)
            if awaiting_enum_body {
                enum_base_depth = brace_stack.len()
                awaiting_enum_body = false
            }
        } else if kind == TOKEN_RBRACE {
            if enum_base_depth == brace_stack.len() -> enum_base_depth = -1
            if brace_stack.len() > 0 -> _ := brace_stack.pop()
        } else if kind == TOKEN_COMMA && enum_base_depth >= 0 && brace_stack.len() > enum_base_depth && fl_is_ident(tokens, index - 1) && fl_is_ident(tokens, index + 1) {
            group_open: brace_stack[brace_stack.len() - 1]
            has_field_colon := false
            loop cursor in group_open + 1..<index {
                if tokens[cursor].kind == TOKEN_COLON -> has_field_colon = true
            }
            if !has_field_colon -> ignored[index] = true
        }
    }
    ignored
}

fl_declaration_field_commas: fn(tokens: [FmtTok]) -> [Bool] {
    ignored := [Bool]{}
    loop _ in 0..<tokens.len() -> ignored.push(false)
    awaiting_struct_body := false
    struct_depth := -1
    brace_depth := 0
    paren_depth := 0
    bracket_depth := 0
    loop index in 0..<tokens.len() {
        kind: tokens[index].kind
        if kind == TOKEN_KW_STRUCT {
            awaiting_struct_body = true
        } else if kind == TOKEN_LBRACE {
            brace_depth += 1
            if awaiting_struct_body {
                struct_depth = brace_depth
                awaiting_struct_body = false
            }
        } else if kind == TOKEN_RBRACE {
            if struct_depth == brace_depth -> struct_depth = -1
            brace_depth -= 1
        } else if kind == TOKEN_LPAREN {
            paren_depth += 1
        } else if kind == TOKEN_RPAREN {
            paren_depth -= 1
        } else if kind == TOKEN_LBRACKET {
            bracket_depth += 1
        } else if kind == TOKEN_RBRACKET {
            bracket_depth -= 1
        } else if kind == TOKEN_COMMA && struct_depth == brace_depth && paren_depth == 0 && bracket_depth == 0 {
            ignored[index] = true
        }
    }
    ignored
}

// The `,` between the arms of a pattern table (`if r == { .Val(n) -> n, .None
// -> 0 }`, or a guard table `if { … }`): the formatter writes it only on a
// table it keeps on one line, so the separator is optional layout.
fl_table_arm_commas: fn(tokens: [FmtTok]) -> [Bool] {
    ignored := [Bool]{}
    loop _ in 0..<tokens.len() -> ignored.push(false)
    // One entry per open `{`: -1 for a brace that is not a table, else the
    // paren and bracket depth at its opening.
    tables := [Int]{}
    depth := 0
    previous := TOKEN_EOF
    loop index in 0..<tokens.len() {
        kind: tokens[index].kind
        if fl_is_comment(kind) -> next
        if {
            kind == TOKEN_LBRACE -> {
                opens_table: previous == TOKEN_KW_IF || previous == TOKEN_EQ_EQ || previous == TOKEN_NOT_EQ || previous == TOKEN_LT || previous == TOKEN_LE || previous == TOKEN_GT || previous == TOKEN_GE
                tables.push(if opens_table -> depth else -> -1)
            }
            kind == TOKEN_RBRACE -> {
                if tables.len() > 0 -> _ := tables.pop()
            }
            kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET -> depth += 1
            kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET -> depth -= 1
            kind == TOKEN_COMMA && tables.len() > 0 && tables[tables.len() - 1] == depth -> ignored[index] = true
        }
        previous = kind
    }
    ignored
}

fl_redundant_default_file_alias: fn(canonical: [FmtTok], tokens: [FmtTok], index: Int) -> Bool {
    if index + 1 >= tokens.len() || tokens[index].kind != TOKEN_IDENT || tokens[index].text != FL_KW_AS -> return false
    if canonical.len() == 0 || canonical[canonical.len() - 1].kind != TOKEN_STRING -> return false
    path: fl_plain_string_value(canonical[canonical.len() - 1].parts) ?? return false
    if tokens[index + 1].kind != TOKEN_IDENT -> return false
    segments: path.split("/").to_list()
    segments.len() > 0 && segments[segments.len() - 1] == tokens[index + 1].text
}

fl_plain_string_value: fn(parts: [FmtPart]) -> String? {
    value := ""
    loop part in parts {
        // A raw `\xNN` byte is not plain text.
        if part.kind != STRING_PART_TEXT -> return None
        value = "{value}{part.text}"
    }
    Val(value)
}

fl_payload_kind: fn(kind: Int) -> Bool {
    kind == TOKEN_IDENT || kind == TOKEN_INT || kind == TOKEN_FLOAT || kind == TOKEN_UNIT_NUMBER || kind == TOKEN_CHAR || fl_is_comment(kind)
}

fl_tokens_equal: fn(left: FmtTok, right: FmtTok) -> Bool {
    if left.kind != right.kind -> return false
    if left.kind == TOKEN_STRING || left.kind == TOKEN_RAW_STRING -> return fl_string_parts_equal(left.parts, right.parts)
    if fl_payload_kind(left.kind) -> return left.text == right.text
    true
}

fl_without_terminators: fn(tokens: [FmtTok]) -> [FmtTok] {
    out := [FmtTok]{}
    loop token in tokens {
        if token.kind != TOKEN_SEMI && token.kind != TOKEN_EOF -> out.push(token.copy())
    }
    out
}

fl_string_parts_equal: fn(left: [FmtPart], right: [FmtPart]) -> Bool {
    if left.len() != right.len() -> return false
    loop index in 0..<left.len() {
        a: left[index]
        b: right[index]
        if a.kind != b.kind -> return false
        if a.kind == STRING_PART_TEXT && a.text != b.text -> return false
        // Rust compared no byte parts; equal bytes are the same string.
        if a.kind == STRING_PART_BYTE && a.byte != b.byte -> return false
        if a.kind == STRING_PART_INTERPOLATION && fl_ordered_token_diff("<string interpolation>", fl_without_terminators(a.tokens), fl_without_terminators(b.tokens)) != "" -> return false
    }
    true
}

fl_describe: fn(tokens: [FmtTok], index: Int) -> String {
    if index < 0 || index >= tokens.len() -> return "None"
    "kind {tokens[index].kind} `{tokens[index].text}`"
}

// "" when `formatted` keeps every meaningful token of `original` in order;
// otherwise the first difference.
fl_ordered_token_diff: fn(path: String, original: [FmtTok], formatted: [FmtTok]) -> String {
    original_i := 0
    formatted_i := 0
    inserted_arm_braces := 0
    inserted_lambda_parens := 0
    loop original_i < original.len() || formatted_i < formatted.len() {
        if original_i < original.len() && formatted_i < formatted.len() && fl_tokens_equal(original[original_i], formatted[formatted_i]) {
            original_i += 1
            formatted_i += 1
            next
        }
        union: fl_reordered_simple_union_type(original, original_i, formatted, formatted_i)
        if union.ok {
            original_i = union.original
            formatted_i = union.formatted
            next
        }
        tuple: fl_reordered_named_tuple_type(original, original_i, formatted, formatted_i)
        if tuple.ok {
            original_i = tuple.original
            formatted_i = tuple.formatted
            next
        }
        if fl_typed_literal_dot_rewrite(original, original_i, formatted, formatted_i) {
            original_i += 1
            next
        }
        if fl_formatted_arm_block_opens(formatted, formatted_i) && fl_kind(original, original_i) != TOKEN_LBRACE {
            inserted_arm_braces += 1
            formatted_i += 1
            next
        }
        if fl_formatted_lambda_params_open(formatted, formatted_i) && fl_kind(original, original_i) != TOKEN_LPAREN {
            inserted_lambda_parens += 1
            formatted_i += 1
            next
        }
        if fl_formatted_variant_pattern_dot(original, original_i, formatted, formatted_i) {
            formatted_i += 1
            next
        }
        if inserted_lambda_parens > 0 && fl_kind(formatted, formatted_i) == TOKEN_RPAREN && fl_is_arrow(fl_kind(formatted, formatted_i + 1)) && fl_is_arrow(fl_kind(original, original_i)) {
            inserted_lambda_parens -= 1
            formatted_i += 1
            next
        }
        if inserted_arm_braces > 0 && fl_kind(formatted, formatted_i) == TOKEN_RBRACE && (fl_next_token_matches(original, original_i, formatted, formatted_i + 1) || fl_formatted_variant_pattern_dot(original, original_i, formatted, formatted_i + 1)) {
            inserted_arm_braces -= 1
            formatted_i += 1
            next
        }
        if fl_formatted_struct_shorthand_expansion(formatted, formatted_i) {
            formatted_i += 2
            next
        }
        // The other direction: fmt contracts `z: z` to the shorthand `z`.
        if fl_formatted_struct_shorthand_expansion(original, original_i) {
            original_i += 2
            next
        }
        if fl_formatted_default_module_alias(formatted, formatted_i) {
            formatted_i += 2
            next
        }
        if fl_formatted_struct_separator(formatted, formatted_i) {
            formatted_i += 1
            next
        }
        if fl_formatted_loop_header_comma(formatted, formatted_i) && fl_kind(original, original_i) == TOKEN_LBRACE {
            formatted_i += 1
            next
        }
        return "fmt changed ordered token {original_i} on {path}:\n  before: {fl_describe(original, original_i)}\n  after: {fl_describe(formatted, formatted_i)}"
    }
    if inserted_arm_braces != 0 -> return "fmt left an unmatched canonical arm block on {path}"
    if inserted_lambda_parens != 0 -> return "fmt left unmatched canonical lambda parens on {path}"
    ""
}

// The `,` a wrapped `loop` header ends with before its `{` body.
fl_formatted_loop_header_comma: fn(tokens: [FmtTok], index: Int) -> Bool {
    if fl_kind(tokens, index) != TOKEN_COMMA || fl_kind(tokens, index + 1) != TOKEN_LBRACE -> return false
    depth := 0
    cursor := index - 1
    loop cursor >= 0 {
        kind: tokens[cursor].kind
        if fl_is_closer(kind) {
            depth += 1
        } else if fl_is_opener(kind) {
            if depth == 0 -> return false
            depth -= 1
        } else if depth == 0 && kind == TOKEN_COMMA {
            return false
        } else if depth == 0 && kind == TOKEN_KW_LOOP {
            return true
        }
        cursor -= 1
    }
    false
}

fl_reordered_simple_union_type: fn(original: [FmtTok], original_i: Int, formatted: [FmtTok], formatted_i: Int) -> FmtStep {
    if !fl_simple_union_type_annotation(original, original_i) || !fl_simple_union_type_annotation(formatted, formatted_i) -> return fl_no_step()
    left: fl_simple_union_members(original, original_i)
    right: fl_simple_union_members(formatted, formatted_i)
    if left.end < 0 || right.end < 0 -> return fl_no_step()
    if fl_sorted(left.members) != fl_sorted(right.members) -> return fl_no_step()
    FmtStep{ok: true, original: left.end, formatted: right.end}
}

// A named tuple type orders its members by label (the parser's
// `type_tuple_fields_canonical`), so `(key: String, index: Int)` and
// `(index: Int, key: String)` are one type.
fl_reordered_named_tuple_type: fn(original: [FmtTok], original_i: Int, formatted: [FmtTok], formatted_i: Int) -> FmtStep {
    left: fl_named_tuple_type_members(original, original_i)
    right: fl_named_tuple_type_members(formatted, formatted_i)
    if left.end < 0 || right.end < 0 -> return fl_no_step()
    if fl_sorted(left.members) != fl_sorted(right.members) -> return fl_no_step()
    FmtStep{ok: true, original: left.end, formatted: right.end}
}

// The members of `(label: Type, …)` whose first label is at `start`, every
// member type one capitalized name; `end` is the index after `)`, or -1.
fl_named_tuple_type_members: fn(tokens: [FmtTok], start: Int) -> (members: [String], end: Int) {
    none: (members: [String]{}, end: -1)
    if fl_kind(tokens, start - 1) != TOKEN_LPAREN -> return none
    members := [String]{}
    cursor := start
    loop {
        if !fl_is_ident(tokens, cursor) || fl_kind(tokens, cursor + 1) != TOKEN_COLON || !fl_is_ident(tokens, cursor + 2) || !fl_uppercase_start(tokens[cursor + 2].text) -> return none
        members.push("{tokens[cursor].text}: {tokens[cursor + 2].text}")
        after: fl_kind(tokens, cursor + 3)
        if after == TOKEN_RPAREN -> break
        if after != TOKEN_COMMA -> return none
        cursor += 4
    }
    if members.len() < 2 -> return none
    (members: members, end: cursor + 4)
}

fl_typed_literal_dot_rewrite: fn(original: [FmtTok], original_i: Int, formatted: [FmtTok], formatted_i: Int) -> Bool {
    if fl_kind(original, original_i) != TOKEN_DOT -> return false
    body: fl_kind(original, original_i + 1)
    if body != TOKEN_LBRACE && body != TOKEN_STRING -> return false
    if formatted_i >= formatted.len() -> return false
    fl_tokens_equal(original[original_i + 1], formatted[formatted_i])
}

fl_simple_union_type_annotation: fn(tokens: [FmtTok], start: Int) -> Bool {
    colon: start - 1
    if fl_kind(tokens, colon) != TOKEN_COLON -> return false
    awaiting_struct_body := false
    awaiting_fn_params := false
    struct_scopes := [[Int]]{}
    fn_param_scopes := [[Int]]{}
    brace_depth := 0
    paren_depth := 0
    bracket_depth := 0
    loop index in 0..<colon {
        kind: tokens[index].kind
        if kind == TOKEN_KW_STRUCT {
            awaiting_struct_body = true
        } else if kind == TOKEN_KW_FN {
            awaiting_fn_params = true
        } else if kind == TOKEN_LBRACE {
            brace_depth += 1
            if awaiting_struct_body {
                struct_scopes.push([Int]{brace_depth, paren_depth, bracket_depth})
                awaiting_struct_body = false
            }
        } else if kind == TOKEN_RBRACE {
            if struct_scopes.len() > 0 && struct_scopes[struct_scopes.len() - 1][0] == brace_depth -> _ := struct_scopes.pop()
            brace_depth -= 1
        } else if kind == TOKEN_LPAREN {
            paren_depth += 1
            if awaiting_fn_params {
                fn_param_scopes.push([Int]{brace_depth, paren_depth, bracket_depth})
                awaiting_fn_params = false
            }
        } else if kind == TOKEN_RPAREN {
            if fn_param_scopes.len() > 0 && fn_param_scopes[fn_param_scopes.len() - 1][1] == paren_depth -> _ := fn_param_scopes.pop()
            paren_depth -= 1
        } else if kind == TOKEN_LBRACKET {
            bracket_depth += 1
        } else if kind == TOKEN_RBRACKET {
            bracket_depth -= 1
        }
    }
    scope: [Int]{brace_depth, paren_depth, bracket_depth}
    (struct_scopes.len() > 0 && struct_scopes[struct_scopes.len() - 1] == scope) || (fn_param_scopes.len() > 0 && fn_param_scopes[fn_param_scopes.len() - 1] == scope)
}

// The members of `A | B | ...` at `start` and the index after it; `end` is
// -1 when the type is not a simple union.
fl_simple_union_members: fn(tokens: [FmtTok], start: Int) -> (members: [String], end: Int) {
    none: (members: [String]{}, end: -1)
    if fl_kind(tokens, start) != TOKEN_IDENT -> return none
    members := [String]{tokens[start].text}
    cursor := start + 1
    loop fl_kind(tokens, cursor) == TOKEN_PIPE {
        if fl_kind(tokens, cursor + 1) != TOKEN_IDENT -> return none
        members.push(tokens[cursor + 1].text)
        cursor += 2
    }
    after: fl_kind(tokens, cursor)
    if members.len() > 1 && (after == TOKEN_COMMA || after == TOKEN_EQ || after == TOKEN_RBRACE || after == TOKEN_RPAREN) -> return (members: members, end: cursor)
    none
}

fl_text_before: fn(left: String, right: String) -> Bool {
    a: left.bytes()
    b: right.bytes()
    index := 0
    loop index < a.len() && index < b.len() {
        if a[index] != b[index] -> return a[index] < b[index]
        index += 1
    }
    a.len() < b.len()
}

fl_sorted: fn(values: [String]) -> [String] {
    out := values
    loop index in 1..<out.len() {
        cursor := index
        loop cursor > 0 && fl_text_before(out[cursor], out[cursor - 1]) {
            held: out[cursor]
            out[cursor] = out[cursor - 1]
            out[cursor - 1] = held
            cursor -= 1
        }
    }
    out
}

fl_formatted_variant_pattern_dot: fn(original: [FmtTok], original_i: Int, formatted: [FmtTok], formatted_i: Int) -> Bool {
    if original_i < 0 || original_i >= original.len() || fl_kind(formatted, formatted_i) != TOKEN_DOT || formatted_i + 1 >= formatted.len() -> return false
    left: original[original_i]
    right: formatted[formatted_i + 1]
    same_variant := false
    if left.kind == TOKEN_IDENT && right.kind == TOKEN_IDENT -> same_variant = left.text == right.text && fl_uppercase_start(left.text)
    if left.kind == TOKEN_NULL && right.kind == TOKEN_NULL -> same_variant = true
    same_variant && fl_variant_pattern_context(original, original_i)
}

fl_variant_pattern_context: fn(tokens: [FmtTok], index: Int) -> Bool {
    if fl_kind(tokens, index - 1) == TOKEN_EQ_EQ -> return true
    brace_depth := 0
    dispatch_open := -1
    cursor := index - 1
    loop cursor >= 0 {
        kind: tokens[cursor].kind
        if kind == TOKEN_RBRACE {
            brace_depth += 1
        } else if kind == TOKEN_LBRACE {
            if brace_depth == 0 {
                dispatch_open = cursor
                break
            }
            brace_depth -= 1
        }
        cursor -= 1
    }
    if dispatch_open < 0 -> return false
    fl_kind(tokens, dispatch_open - 1) == TOKEN_EQ_EQ && fl_same_brace_scope_has_if(tokens, dispatch_open - 1) && fl_pattern_reaches_arrow(tokens, index)
}

fl_same_brace_scope_has_if: fn(tokens: [FmtTok], before: Int) -> Bool {
    cursor := before - 1
    loop cursor >= 0 {
        kind: tokens[cursor].kind
        if kind == TOKEN_KW_IF -> return true
        if kind == TOKEN_LBRACE || kind == TOKEN_RBRACE || fl_is_arrow(kind) -> return false
        cursor -= 1
    }
    false
}

fl_pattern_reaches_arrow: fn(tokens: [FmtTok], index: Int) -> Bool {
    paren_depth := 0
    bracket_depth := 0
    loop cursor in index + 1..<tokens.len() {
        kind: tokens[cursor].kind
        if kind == TOKEN_LPAREN {
            paren_depth += 1
        } else if kind == TOKEN_RPAREN && paren_depth > 0 {
            paren_depth -= 1
        } else if kind == TOKEN_LBRACKET {
            bracket_depth += 1
        } else if kind == TOKEN_RBRACKET && bracket_depth > 0 {
            bracket_depth -= 1
        } else if fl_is_arrow(kind) && paren_depth == 0 && bracket_depth == 0 {
            return true
        } else if (kind == TOKEN_LBRACE || kind == TOKEN_RBRACE) && paren_depth == 0 && bracket_depth == 0 {
            return false
        }
    }
    false
}

fl_formatted_arm_block_opens: fn(tokens: [FmtTok], index: Int) -> Bool {
    fl_kind(tokens, index) == TOKEN_LBRACE && fl_is_arrow(fl_kind(tokens, index - 1))
}

fl_formatted_lambda_params_open: fn(tokens: [FmtTok], index: Int) -> Bool {
    if fl_kind(tokens, index) != TOKEN_LPAREN -> return false
    close: fl_matching(tokens, index, TOKEN_LPAREN, TOKEN_RPAREN)
    close >= 0 && fl_is_arrow(fl_kind(tokens, close + 1))
}

fl_next_token_matches: fn(original: [FmtTok], original_i: Int, formatted: [FmtTok], formatted_i: Int) -> Bool {
    has_original: original_i < original.len()
    has_formatted: formatted_i < formatted.len()
    if !has_original && !has_formatted -> return true
    if has_original && has_formatted -> return fl_tokens_equal(original[original_i], formatted[formatted_i])
    false
}

fl_struct_literal_head_before_brace: fn(tokens: [FmtTok], open: Int) -> Bool {
    kind: fl_kind(tokens, open - 1)
    if kind == TOKEN_DOT || kind == TOKEN_COLON || kind == TOKEN_COMMA || kind == TOKEN_LPAREN || kind == TOKEN_EQ || kind == TOKEN_RETURN -> return true
    if kind == TOKEN_IDENT -> return fl_uppercase_start(tokens[open - 1].text)
    if kind == TOKEN_RBRACKET {
        bracket_open: open - 2
        return fl_kind(tokens, bracket_open) == TOKEN_LBRACKET && fl_kind(tokens, bracket_open - 1) == TOKEN_IDENT && fl_uppercase_start(tokens[bracket_open - 1].text)
    }
    kind == TOKEN_GT
}

// The innermost unclosed `{` before `index`, or -1.
fl_enclosing_brace: fn(tokens: [FmtTok], index: Int) -> Int {
    depth := 0
    cursor := index - 1
    loop cursor >= 0 {
        kind: tokens[cursor].kind
        if kind == TOKEN_RBRACE {
            depth += 1
        } else if kind == TOKEN_LBRACE {
            if depth == 0 -> return cursor
            depth -= 1
        }
        cursor -= 1
    }
    -1
}

fl_formatted_struct_shorthand_expansion: fn(tokens: [FmtTok], index: Int) -> Bool {
    if fl_kind(tokens, index) != TOKEN_COLON || fl_kind(tokens, index + 1) != TOKEN_IDENT || fl_kind(tokens, index - 1) != TOKEN_IDENT -> return false
    if tokens[index - 1].text != tokens[index + 1].text -> return false
    open: fl_enclosing_brace(tokens, index)
    open >= 0 && fl_struct_literal_head_before_brace(tokens, open)
}

fl_formatted_default_module_alias: fn(tokens: [FmtTok], index: Int) -> Bool {
    if fl_kind(tokens, index) != TOKEN_IDENT || fl_kind(tokens, index + 1) != TOKEN_IDENT || tokens[index].text != FL_KW_AS -> return false
    fl_kind(tokens, index - 1) == TOKEN_IDENT && tokens[index - 1].text == tokens[index + 1].text && fl_kind(tokens, index - 2) == TOKEN_DOT && fl_exact_use_path_before_alias(tokens, index)
}

fl_exact_use_path_before_alias: fn(tokens: [FmtTok], alias_index: Int) -> Bool {
    use_index := -1
    cursor := alias_index - 1
    loop cursor >= 0 {
        if tokens[cursor].kind == TOKEN_KW_USE {
            use_index = cursor
            break
        }
        cursor -= 1
    }
    if use_index < 0 -> return false
    length: alias_index - use_index - 1
    if length < 3 || length % 2 == 0 -> return false
    loop offset in 0..<length {
        kind: tokens[use_index + 1 + offset].kind
        expected: if offset % 2 == 0 -> TOKEN_IDENT else -> TOKEN_DOT
        if kind != expected -> return false
    }
    true
}

fl_formatted_struct_separator: fn(tokens: [FmtTok], index: Int) -> Bool {
    if fl_kind(tokens, index) != TOKEN_COMMA -> return false
    open: fl_enclosing_brace(tokens, index)
    open >= 0 && fl_struct_literal_head_before_brace(tokens, open)
}

fl_ordered_sources_diff: fn(original: String, formatted: String) -> String {
    path: "canonical-rule.jet"
    fl_ordered_token_diff(path, fl_canonical_tokens(original, path), fl_canonical_tokens(formatted, path))
}

// `jet fmt`'s source formatter: ordinary sources, and sources led by one
// inline `package: { ... }` carrier.
fl_format: fn(src: String) -> (ok: Bool, text: String, codes: String) {
    result: jet_cli_fmt_ordinary(src, false, false)
    codes := ""
    loop diagnostic in result.diagnostics -> codes = "{codes} {diagnostic.code}"
    (ok: result.ok, text: result.text, codes: codes)
}

// "" when formatting keeps the token stream and is byte-stable.
fl_check_preserves: fn(path: String, src: String, formatted: String) -> String {
    if fl_lex_codes(src) != "" -> return "source does not lex on {path}:{fl_lex_codes(src)}"
    if fl_lex_codes(formatted) != "" -> return "fmt output does not lex on {path}:{fl_lex_codes(formatted)}"
    diff: fl_ordered_token_diff(path, fl_canonical_tokens(src, path), fl_canonical_tokens(formatted, path))
    if diff != "" -> return diff
    twice: fl_format(formatted)
    if !twice.ok -> return "second fmt failed on {path}:{twice.codes}"
    if twice.text != formatted -> return "fmt is not byte-stable on {path}"
    ""
}

fl_collect: fn(dir: String, out: &[String]) {
    entries: fl_files.list_dir(dir.copy()) ?? panic("cannot list {dir}: {err}")
    loop entry in entries {
        // Generated bindings and caches, not checked source.
        if entry.is_dir && entry.name == ".jet" -> next
        path: "{dir}/{entry.name}"
        if entry.is_dir {
            fl_collect(path, out)
        } else if entry.name.ends_with(".jet") {
            out.push(path)
        }
    }
}

fl_collect_sorted: fn(dir: String) -> [String] {
    out := [String]{}
    fl_collect(dir, out)
    fl_sorted(out)
}

fl_file_name: fn(path: String) -> String {
    segments: path.split("/").to_list()
    segments[segments.len() - 1]
}

fl_is_config: fn(path: String) -> Bool {
    name: fl_file_name(path)
    name == FL_PAYLOAD_FILE || name == FL_WORKSPACE_FILE || name == FL_PACKAGE_FILE
}

fl_parse_invalid: fn(src: String) -> Bool {
    lexed: lex(src.bytes())
    if lexed.diagnostics.len() > 0 -> return true
    // fmt refuses a malformed inline `package:` carrier (E1360-E1362) before it parses.
    if jet_driver_inline_package(src).error != None -> return true
    !jfmt_check_parse_accepts(parse_source(src.bytes()).diagnostics)
}

// A fixture whose parse recovers through a teaching diagnostic (or E0081)
// spells a retired or invalid form on purpose; fmt rewrites it to canon.
fl_teaching_codes: fn(src: String) -> [String] {
    codes := [String]{}
    loop diagnostic in parse_source(src.bytes()).diagnostics {
        if jfmt_is_teaching_parse_diag(diagnostic.code) || diagnostic.code == FL_CODE_BODYLESS_FN -> codes.push(diagnostic.code.copy())
    }
    codes
}

// "" when the canonical rewrite of a teaching fixture lexes and parses with no
// teaching diagnostic left. A teaching diagnostic with no mechanical canon (a
// one-member marker group needs the author's choice) stays exactly as written:
// the same teaching codes and every ordered token kept.
fl_check_rewrites_to_canon: fn(path: String, src: String, formatted: String) -> String {
    if fl_lex_codes(formatted) != "" -> return "fmt output does not lex on {path}:{fl_lex_codes(formatted)}"
    if fl_parse_invalid(formatted) -> return "fmt output of teaching fixture {path} does not parse"
    left: fl_teaching_codes(formatted)
    if left.len() == 0 -> return ""
    if left.join(", ") == fl_teaching_codes(src).join(", ") && fl_ordered_sources_diff(src, formatted) == "" -> return ""
    "fmt left teaching diagnostics {left.join(", ")} on {path}"
}

// An FFI adaptation's `after.jet` shows the generated facade, whose
// `__jet_ffi_` binders lex only in the compiler-reserved lane (E0067). It is
// generated projection output, not user program source.
fl_is_generated_projection: fn(path: String, src: String) -> Bool {
    if fl_file_name(path) != FL_ADAPTATION_AFTER_FILE -> return false
    diagnostics: lex(src.bytes()).diagnostics
    if diagnostics.len() == 0 -> return false
    loop diagnostic in diagnostics {
        if diagnostic.code != FL_CODE_RESERVED_NAME -> return false
    }
    true
}

// Run from the repository root.
#Test("fmt_is_lossless_on_supported_source_corpus") {
    example_files: fl_collect_sorted("Examples")
    ui_files: fl_collect_sorted("tests/ui")
    failures := [String]{}
    example_programs := 0
    example_configs := 0
    example_generated := 0
    loop path in example_files {
        if fl_is_config(path) {
            example_configs += 1
            next
        }
        src: fl_files.read(path.copy()) ?? panic("cannot read {path}: {err}")
        if fl_is_generated_projection(path, src) {
            example_generated += 1
            next
        }
        formatted: fl_format(src)
        if !formatted.ok {
            failures.push("example program failed to parse for fmt on {path}:{formatted.codes}")
            next
        }
        problem: fl_check_preserves(path, src, formatted.text)
        if problem != "" -> failures.push(problem)
        example_programs += 1
    }
    ui_parse_valid := 0
    ui_parse_invalid := 0
    ui_configs := 0
    actual_invalid := [String]{}
    mismatches := [String]{}
    pinned: fl_ui_parse_invalid()
    loop path in ui_files {
        // Package and workspace manifests are config, never program source.
        if fl_is_config(path) {
            ui_configs += 1
            next
        }
        src: fl_files.read(path.copy()) ?? panic("cannot read {path}: {err}")
        expected_invalid: pinned.contains(path)
        actual_is_invalid: fl_parse_invalid(src)
        if actual_is_invalid != expected_invalid {
            mismatches.push("UI parser-validity changed for {path}; update the pinned manifest only after review (expected_invalid={expected_invalid}, actual_is_invalid={actual_is_invalid})")
            next
        }
        if expected_invalid {
            actual_invalid.push(path)
            ui_parse_invalid += 1
            next
        }
        // UI error fixtures may use non-canonical spelling on purpose;
        // `.fixed.jet` companions are fmt outputs and are not re-checked.
        if !path.ends_with(".fixed.jet") {
            formatted: fl_format(src)
            if !formatted.ok {
                failures.push("parse-valid UI fixture failed formatter parse on {path}:{formatted.codes}")
            } else if fl_teaching_codes(src).len() > 0 {
                problem: fl_check_rewrites_to_canon(path, src, formatted.text)
                if problem != "" -> failures.push(problem)
            } else {
                problem: fl_check_preserves(path, src, formatted.text)
                if problem != "" -> failures.push(problem)
            }
        }
        ui_parse_valid += 1
    }
    assert(mismatches.len() == 0, "UI corpus parser-validity mismatches ({mismatches.len()} found):\n{mismatches.join("\n")}")
    assert(failures.len() == 0, "formatter token-stream failures ({failures.len()} found):\n{failures.join("\n")}")
    assert(example_files.len() == example_programs + example_configs + example_generated, "every example .jet file must be program source, explicit package/workspace config or a generated adaptation facade")
    assert(ui_files.len() == ui_parse_valid + ui_parse_invalid + ui_configs, "every UI .jet fixture must be classified by its actual formatter parse result")
    loop index in 1..<pinned.len() -> assert(fl_text_before(pinned[index - 1], pinned[index]), "UI parse-invalid manifest must be sorted and duplicate-free: {pinned[index]}")
    assert(actual_invalid == pinned, "discovered parser-invalid UI set must exactly equal the pinned manifest")
    print("formatter corpus: {example_programs} example programs, {example_configs} configs, {ui_parse_valid} parse-valid UI fixtures, {ui_parse_invalid} parse-invalid UI fixtures, {ui_configs} UI manifest configs")
}

// The readable prelude spells only what user code can write (#6281 c1): it
// parses under the ordinary user rules, and fmt keeps every token of it,
// a trait method's own `<T: Printable>` included. Run from the repository root.
#Test("readable_prelude_parses_as_user_source") {
    path: "Compiler/Prelude/core/prelude.jet"
    src: fl_files.read(path) ?? panic("cannot read {path}: {err}")
    assert(!fl_parse_invalid(src), "{path} does not parse as user source")
    assert(fl_teaching_codes(src).len() == 0, "{path} spells a retired or bodyless form: {fl_teaching_codes(src).join(" ")}")
    formatted: fl_format(src)
    assert(formatted.ok, "{path} failed formatter parse:{formatted.codes}")
    problem: fl_check_preserves(path, src, formatted.text)
    assert(problem == "", problem)
    assert(formatted.text == src, "{path} is not in fmt canonical form")
}

// One blank line separates an inline package carrier from the first item, as
// between any two top-level items; a file that is only a carrier ends in one
// newline.
#Test("an_inline_package_carrier_is_followed_by_one_blank_line") {
    tight: jet_cli_fmt_ordinary("package: {{\n    name: \"p\"\n}}\nrun: fn() {{ print(\"ok\") }}\n", false, false)
    assert(tight.ok, "the source formats")
    assert_eq(tight.text, "package: {{\n    name: \"p\"\n}}\n\nrun: fn() {{ print(\"ok\") }}\n")
    spread: jet_cli_fmt_ordinary("package: {{\n    name: \"p\"\n}}\n\n\n\nrun: fn() {{ print(\"ok\") }}\n", false, false)
    assert_eq(spread.text, tight.text)
    alone: jet_cli_fmt_ordinary("package: {{\n    name: \"p\"\n}}\n\n", false, false)
    assert_eq(alone.text, "package: {{\n    name: \"p\"\n}}\n")
}

#Test("canonical_rewrite_rules_are_explicit_and_narrow") {
    allowed: [[String]]{
        {"top-level ordering", "#Target(Web)\nuse core.ui as ui\nrun: fn() {{}}\n", "use core.ui as ui\n#Target(Web)\nrun: fn() {{}}\n"},
        {"import-hoisted top-level comments", "// helper\nhelper: fn() {{}}\n// import\nuse core.ui as ui\n", "// helper\n// import\nuse core.ui as ui\nhelper: fn() {{}}\n"},
        {"spanless marker comment position", "// web target\n#Target(Web)\nrun: fn() {{}}\n", "#Target(Web)\n// web target\nrun: fn() {{}}\n"},
        {"marker grouping", "#Codable\n#Rename(.Camel)\nS: struct {{}}\n", "#[Codable, Rename(.Camel)]\nS: struct {{}}\n"},
        {"static generic call", "run: fn() {{ Pool<Node>.new() }}\n", "run: fn() {{ Pool.new<Node>() }}\n"},
        {"external method", "Point.len: fn(self) -> Int {{ 1 }}\n", "impl Point {{ len: fn(self) -> Int {{ 1 }} }}\n"},
        {"enum group separators", "E: enum {{ G {{ A, B }} }}\n", "E: enum {{ G {{ A B }} }}\n"},
        {"struct declaration separators", "S: struct {{ x: Int, y: Int }}\n", "S: struct {{ x: Int y: Int }}\n"},
        {"trailing comma", "run: fn() {{ xs: [1,] }}\n", "run: fn() {{ xs: [1] }}\n"},
        {"default file alias", "use \"./foo\" as foo\nrun: fn() {{}}\n", "use \"./foo\"\nrun: fn() {{}}\n"},
        {"typed-literal dot removal", "run: fn() {{ p: Point.{{x: 1}} }}\n", "run: fn() {{ p: Point{{x: 1}} }}\n"},
        {"dispatch arm block", "run: fn() {{ if x == {{ .A -> print(1) }} }}\n", "run: fn() {{ if x == {{ .A -> {{ print(1) }} }} }}\n"},
        {"bare lambda params", "run: fn() {{ f: x -> x }}\n", "run: fn() {{ f: (x) -> x }}\n"},
        {"bare enum variant pattern", "run: fn() {{ if x == {{ A(v) -> print(v) }} }}\n", "run: fn() {{ if x == {{ .A(v) -> print(v) }} }}\n"},
        {"bare None variant pattern", "run: fn() {{ if x == {{ None -> print(0) }} }}\n", "run: fn() {{ if x == {{ .None -> print(0) }} }}\n"},
        {"struct shorthand label", "run: fn() {{ p: Point{{x}} }}\n", "run: fn() {{ p: Point{{x: x}} }}\n"},
        {"default module alias", "use core.encoding.json\nrun: fn() {{}}\n", "use core.encoding.json as json\nrun: fn() {{}}\n"},
        {"struct literal separator", "run: fn() {{ p: Point{{x: 1 y: 2}} }}\n", "run: fn() {{ p: Point{{x: 1, y: 2}} }}\n"},
        {"anonymous union member order", "S: struct {{ value: String | Char }}\n", "S: struct {{ value: Char | String }}\n"},
        {"redundant default alias in the name: path spelling", "use {{\n    json: core.encoding.json\n}}\nrun: fn() {{}}\n", "use {{\n    core.encoding.json\n}}\nrun: fn() {{}}\n"},
        {"loop arrow body", "run: fn() {{\n    loop i in 0..<3 {{\n        print(i)\n    }}\n}}\n", "run: fn() {{\n    loop i in 0..<3 -> print(i)\n}}\n"},
        {"if arrow body expanded", "run: fn() {{\n    if ok -> return 1\n    print(0)\n}}\n", "run: fn() {{\n    if ok {{\n        return 1\n    }}\n    print(0)\n}}\n"},
        {"else arrow bodies", "run: fn() {{\n    if ok {{\n        a()\n    }} else {{\n        b()\n    }}\n}}\n", "run: fn() {{\n    if ok -> a() else -> b()\n}}\n"},
        {"redundant file binding alias", "use {{\n    store: \"./data/store\"\n}}\nrun: fn() {{}}\n", "use {{\n    \"./data/store\"\n}}\nrun: fn() {{}}\n"},
        {"single-member import list", "use core.[files]\nrun: fn() {{}}\n", "use core.files\nrun: fn() {{}}\n"},
        {"leading parameter sigil", "f: fn(&&s: String) {{}}\n", "f: fn(s: &&String) {{}}\n"},
        {"unit type name", "f: fn() -> Unit {{}}\n", "f: fn() -> () {{}}\n"},
        {"import grouping", "use core.files\nuse core.term\nrun: fn() {{}}\n", "use {{\n    core.files\n    core.term\n}}\nrun: fn() {{}}\n"},
        {"named tuple type order", "f: fn(p: (x: Int, y: Int)) {{}}\n", "f: fn(p: (y: Int, x: Int)) {{}}\n"},
        {"wrapped loop header comma", "run: fn() {{\n    loop x in [1, 2] {{\n        print(x)\n    }}\n}}\n", "run: fn() {{\n    loop x in\n        [1, 2], {{\n        print(x)\n    }}\n}}\n"},
        {"empty marker parentheses", "#Inline()\nf: fn() {{}}\n", "#Inline\nf: fn() {{}}\n"},
        {"function type parameter names", "S: struct {{ f: fn(line: String) -> View<str> from line }}\n", "S: struct {{ f: fn(String) -> View<str> from _0 }}\n"},
        {"result type contract", "f: fn() -> Result<Int, IOError> {{ 1 }}\n", "f: fn() -> Int IOError! {{ 1 }}\n"},
        {"optional return type parens", "f: fn() -> (Int?) {{ None }}\n", "f: fn() -> Int? {{ None }}\n"},
        {"prefix declaration spelling", "S: struct {{ impl Marker {{ expand: fn(self, target: Target) {{ fn made() -> Int {{ 1 }} }} }} }}\n", "S: struct {{ impl Marker {{ expand: fn(self, target: Target) {{ made: fn() -> Int {{ 1 }} }} }} }}\n"},
        {"and group in or", "run: fn() {{ print(a && b || c) }}\n", "run: fn() {{ print((a && b) || c) }}\n"},
        {"arrow body before an own-line comment", "run: fn() {{\n    if a -> b()\n\n    // note\n    c()\n}}\n", "run: fn() {{\n    if a {{\n        b()\n    }}\n\n    // note\n    c()\n}}\n"},
        {"spanless directive comment leads the next import", "// note\n#Target(Web)\nuse core.text\n\nrun: fn() {{}}\n", "// note\nuse core.text\n#Target(Web)\n\nrun: fn() {{}}\n"},
        {"piped generic bounds", "twice: fn<T: A | B>(x: T) -> T {{ x }}\n", "twice: fn<T: [A, B]>(x: T) -> T {{ x }}\n"},
        {"late effect row", "store: fn(g: fn() -> Int -[IO]>) {{}}\n", "store: fn(g: fn() -[IO]> Int) {{}}\n"},
        {"optional return after an effect arrow", "pick: fn() -[]> (Window?) {{ None }}\n", "pick: fn() -[]> Window? {{ None }}\n"},
        {"marked parameter sigil", "bad: fn(#Root &value: Int) {{}}\n", "bad: fn(#Root value: &Int) {{}}\n"},
        {"pattern field shorthand", "run: fn() {{ if e == .Named{{z: z}} -> print(z) }}\n", "run: fn() {{ if e == .Named{{z}} -> print(z) }}\n"},
        {"parameter names before an effect arrow", "close: fn(&&handle: Handle) -[FFI.Java]> {{}}\n", "close: fn(handle: &&Handle) -[FFI.Java]> {{}}\n"},
        {"foreign return without an arrow", "#Import c.m: module {{\n    get: fn(a: Int) Int = \"get\"\n}}\n", "#Import c.m: module {{\n    get: fn(a: Int) -> Int = \"get\"\n}}\n"},
    }
    loop case in allowed {
        diff: fl_ordered_sources_diff(case[1], case[2])
        assert(diff == "", "allowed canonical rewrite failed: {case[0]}: {diff}")
    }

    paired_forbidden: [[String]]{
        {"top-level ordering does not reorder ordinary items", "first: fn() {{}}\nsecond: fn() {{}}\n", "second: fn() {{}}\nfirst: fn() {{}}\n"},
        {"import hoisting does not reorder comments", "// helper\nhelper: fn() {{}}\n// import\nuse core.ui as ui\n", "// import\n// helper\nuse core.ui as ui\nhelper: fn() {{}}\n"},
        {"spanless marker movement does not delete comments", "// web target\n#Target(Web)\nrun: fn() {{}}\n", "#Target(Web)\nrun: fn() {{}}\n"},
        {"marker grouping does not reorder markers", "#[Codable, Rename(.Camel)]\nS: struct {{}}\n", "#[Rename(.Camel), Codable]\nS: struct {{}}\n"},
        {"generic-call rewrite requires a call", "run: fn() {{ value: Pool<Node>.field }}\n", "run: fn() {{ value: Pool.field<Node> }}\n"},
        {"external-method rewrite preserves receiver", "Point.len: fn(self) -> Int {{ 1 }}\n", "impl Other {{ len: fn(self) -> Int {{ 1 }} }}\n"},
        {"task-block rewrite preserves body", "run: fn() {{ task.group g {{ x: task {{ work() }} }} }}\n", "run: fn() {{ task.group g {{ x: task {{ other() }} }} }}\n"},
        {"enum-group comma rule preserves variant order", "E: enum {{ G {{ A, B }} }}\n", "E: enum {{ G {{ B A }} }}\n"},
        {"struct-declaration comma rule preserves field order", "S: struct {{ x: Int, y: Int }}\n", "S: struct {{ y: Int x: Int }}\n"},
        {"trailing-comma rule does not remove argument separators", "run: fn() {{ call(a, b) }}\n", "run: fn() {{ call(a b) }}\n"},
        {"file-alias rule requires the default alias", "use \"./foo\" as bar\nrun: fn() {{}}\n", "use \"./foo\"\nrun: fn() {{}}\n"},
        {"arm-block rule does not remove explicit braces", "run: fn() {{ if x == {{ .A -> {{ print(1) }} }} }}\n", "run: fn() {{ if x == {{ .A -> print(1) }} }}\n"},
        {"lambda rule does not remove explicit parens", "run: fn() {{ f: (x) -> x }}\n", "run: fn() {{ f: x -> x }}\n"},
        {"variant-dot rule requires a PascalCase pattern", "run: fn() {{ if x == {{ value -> print(value) }} }}\n", "run: fn() {{ if x == {{ .value -> print(value) }} }}\n"},
        {"variant-dot rule requires a dispatch arm context", "run: fn() {{ Foo work -> print(1) }}\n", "run: fn() {{ .Foo work -> print(1) }}\n"},
        {"shorthand expansion preserves field value", "run: fn() {{ p: Point{{x}} }}\n", "run: fn() {{ p: Point{{x: y}} }}\n"},
        {"module alias requires exact use-path context", "use core.term as io\nrun: fn() {{ foo.bar }}\n", "use core.term as io\nrun: fn() {{ foo.bar as bar }}\n"},
        {"struct-literal separator rule does not remove commas", "run: fn() {{ p: Point{{x: 1, y: 2}} }}\n", "run: fn() {{ p: Point{{x: 1 y: 2}} }}\n"},
        {"union order rule requires a type annotation", "run: fn() {{ value: left.bit_or(right) }}\n", "run: fn() {{ value: right.bit_or(left) }}\n"},
        {"union order rule rejects struct field values", "run: fn() {{ p: Point{{x: left.bit_or(right)}} }}\n", "run: fn() {{ p: Point{{x: right.bit_or(left)}} }}\n"},
        {"union order rule rejects dotted member replacement", "S: struct {{ value: A | B.C }}\n", "S: struct {{ value: B | A.C }}\n"},
        {"union order rule rejects generic member replacement", "S: struct {{ value: A | B<C> }}\n", "S: struct {{ value: B | A<C> }}\n"},
        {"union order rule preserves every member", "S: struct {{ value: A | B }}\n", "S: struct {{ value: A | C }}\n"},
        {"use-alias rule requires the default alias", "use {{\n    fs: core.files\n}}\nrun: fn() {{}}\n", "use {{\n    core.files\n}}\nrun: fn() {{}}\n"},
        {"use-alias rule requires a use declaration", "run: fn() {{\n    json: core.encoding.json\n}}\n", "run: fn() {{\n    core.encoding.json\n}}\n"},
        {"control-arrow rule keeps the body", "run: fn() {{\n    loop i in 0..<3 {{\n        print(i)\n    }}\n}}\n", "run: fn() {{\n    loop i in 0..<3 -> print(0)\n}}\n"},
        {"control-arrow rule keeps the statement boundary", "run: fn() {{\n    loop i in 0..<3 {{\n        print(i)\n    }}\n    done()\n}}\n", "run: fn() {{\n    loop i in 0..<3 -> print(i) done()\n}}\n"},
        {"control-arrow rule leaves value-position arrows", "run: fn() {{\n    xs: loop i in 0..<3 -> i\n}}\n", "run: fn() {{\n    xs: loop i in 0..<3 {{ i }}\n}}\n"},
        {"file-binding alias rule requires the default alias", "use {{\n    other: \"./data/store\"\n}}\nrun: fn() {{}}\n", "use {{\n    \"./data/store\"\n}}\nrun: fn() {{}}\n"},
        {"single-member import rule keeps the member", "use core.[files]\nrun: fn() {{}}\n", "use core.term\nrun: fn() {{}}\n"},
        {"sigil rule keeps the sigil", "f: fn(&&s: String) {{}}\n", "f: fn(s: String) {{}}\n"},
        {"unit rule leaves a Unit value path", "run: fn() {{ x: Unit.default() }}\n", "run: fn() {{ x: ().default() }}\n"},
        {"import grouping keeps import order", "use core.files\nuse core.term\nrun: fn() {{}}\n", "use {{\n    core.term\n    core.files\n}}\nrun: fn() {{}}\n"},
        {"named tuple rule keeps member types", "f: fn(p: (x: Int, y: Int)) {{}}\n", "f: fn(p: (y: Int, x: Float)) {{}}\n"},
        {"loop comma rule requires a loop header", "run: fn() {{\n    if ok {{\n        print(1)\n    }}\n}}\n", "run: fn() {{\n    if ok, {{\n        print(1)\n    }}\n}}\n"},
        {"empty-paren rule keeps marker arguments", "#Inline(always)\nf: fn() {{}}\n", "#Inline\nf: fn() {{}}\n"},
        {"function-type rule keeps declaration parameter names", "f: fn(line: String) {{}}\n", "f: fn(String) {{}}\n"},
        {"function-type rule keeps labels", "S: struct {{ f: fn(*, label: Bool) }}\n", "S: struct {{ f: fn(*, Bool) }}\n"},
        {"result rule keeps the error type", "f: fn() -> Result<Int, IOError> {{ 1 }}\n", "f: fn() -> Int ParseError! {{ 1 }}\n"},
        {"optional-paren rule requires a return arrow", "run: fn() {{ x: (a?) }}\n", "run: fn() {{ x: a? }}\n"},
        {"prefix-declaration rule keeps the name", "run: fn() {{ fn made() -> Int {{ 1 }} }}\n", "run: fn() {{ other: fn() -> Int {{ 1 }} }}\n"},
        {"and-group rule keeps a negated group", "run: fn() {{ print(!(a && b) || c) }}\n", "run: fn() {{ print(!a && b || c) }}\n"},
        {"and-group rule keeps a group under a tighter operator", "run: fn() {{ print(c || (a && b) == d) }}\n", "run: fn() {{ print(c || a && b == d) }}\n"},
        {"arrow-body comment rule keeps a same-line comment in the body", "run: fn() {{\n    if a -> b() // note\n    c()\n}}\n", "run: fn() {{\n    if a {{\n        b()\n    }}\n    // note\n    c()\n}}\n"},
        {"piped-bound rule keeps a union parameter type", "run: fn(x: Int | Float) {{}}\n", "run: fn(x: [Int, Float]) {{}}\n"},
        {"late-effect-row rule keeps the row", "store: fn(g: fn() -> Int -[IO]>) {{}}\n", "store: fn(g: fn() -[FS]> Int) {{}}\n"},
        {"pattern shorthand rule keeps a renamed binding", "run: fn() {{ if e == .Named{{z: y}} -> print(y) }}\n", "run: fn() {{ if e == .Named{{z}} -> print(y) }}\n"},
        {"foreign-return rule keeps a function type parameter", "run: fn(cb: fn(Int) Int) {{}}\n", "run: fn(cb: fn(Int) -> Int) {{}}\n"},
    }
    loop case in paired_forbidden {
        assert(fl_ordered_sources_diff(case[1], case[2]) != "", "paired forbidden neighbor was accepted: {case[0]}")
    }

    forbidden: [[String]]{
        {"operand reorder", "run: fn() {{ x: a + b }}\n", "run: fn() {{ x: b + a }}\n"},
        {"marker payload deletion", "#Pre(x > 0, \"positive\") f: fn(x: Int) {{}}\n", "#Pre(x > 0) f: fn(x: Int) {{}}\n"},
        {"comment reorder", "// first\n// second\nrun: fn() {{}}\n", "// second\n// first\nrun: fn() {{}}\n"},
        {"grouping delimiter deletion", "run: fn() {{ x: (a + b) }}\n", "run: fn() {{ x: a + b }}\n"},
        {"interpolation deletion", "run: fn() {{ print(\"{{a + b}}\") }}\n", "run: fn() {{ print(\"{{a}}\") }}\n"},
        {"arbitrary dotted alias insertion", "run: fn() {{ foo.bar }}\n", "run: fn() {{ foo.bar as bar }}\n"},
        {"operator deletion", "run: fn() {{ x: a && b }}\n", "run: fn() {{ x: a b }}\n"},
        {"meaningful token addition", "run: fn() {{ call(a) }}\n", "run: fn() {{ call(a, b) }}\n"},
    }
    loop case in forbidden {
        assert(fl_ordered_sources_diff(case[1], case[2]) != "", "forbidden rewrite was accepted: {case[0]}")
    }
}

