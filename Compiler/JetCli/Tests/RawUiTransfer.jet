// core.ui's raw host carrier transfer: user source can't spell it (E0067),
// and generated-lane source (embedded Core's) may call it only inside an
// audited `#Unsafe` region (E3101). The check runs the real loader and
// checker on a user entry whose program is swapped for the generated-lane
// parse, as the embedded Core path parses; the import stays the same, so the
// loaded import edges still hold.
use jet_driver.[
    JetDriverAuthorizedSourceFile, JetDriverAuthorizedSourceRoot, JetDriverAuthorizedSourceSnapshot,
    JetDriverCheckedProjectionCapture, JetDriverCompileMode, JetDriverCoreSource,
    jet_driver_compile_loaded_stages, jet_driver_has_errors, jet_driver_keep_going_log, jet_driver_load,
]
use jet_cli.[jet_cli_driver_request]
use jet_parser.[parse_generated_source, parse_source]

// What the checker reports as E3101 for `source` as the entry's program.
fn raw_ui_transfer_reports(source: String) -> [String] {
    snapshot :: JetDriverAuthorizedSourceSnapshot{
        roots: [JetDriverAuthorizedSourceRoot]{JetDriverAuthorizedSourceRoot{
            canonical_path: "/ui-raw-transfer",
            identity: "ui-raw-transfer-root",
            allow_hardlinks: false,
            files: [JetDriverAuthorizedSourceFile]{JetDriverAuthorizedSourceFile{path: "/ui-raw-transfer/main.jet", relative_path: "main.jet", identity: "ui-raw-transfer-file", source: "use core.ui as ui\nfn run() {{ ui.text(\"jet\") }}\n"}},
            foreign_cache_files: [JetDriverAuthorizedSourceFile]{},
        }},
        entry_root_identity: "ui-raw-transfer-root",
        entry_path: "/ui-raw-transfer/main.jet",
    }
    request :: jet_cli_driver_request(snapshot, [JetDriverCoreSource]{}, Val(1), JetDriverCompileMode.Program)
    load := jet_driver_load(request)
    assert(load.complete && !jet_driver_has_errors(load.diagnostics), "{load.diagnostics:Debug}")
    parsed :: parse_generated_source(source.bytes())
    assert(parsed.diagnostics.is_empty(), "{parsed.diagnostics:Debug}")
    entry :: loop index in 0..<load.modules.len() { if load.modules[index].module_identity == load.entry_module_identity -> break index } ?? panic("no entry module")
    load.modules[entry].program = parsed.program
    keep_going := jet_driver_keep_going_log(None)
    capture := JetDriverCheckedProjectionCapture{}
    result :: jet_driver_compile_loaded_stages(request, &keep_going, ^load, false, &capture)
    loop diagnostic in result.diagnostics if diagnostic.code == "E3101" -> diagnostic.what.copy()
}

#Test("raw_ui_transfer_requires_an_audited_gate") {
    call :: `ui.__node_transfer("", 0.0, 0.0, -1, 0, [], false, "", 63, false, 0, 0, 0, 0, 0)`
    source :: "use core.ui as ui\nfn run() {{ {call} }}\n"
    reserved := false
    loop diagnostic in parse_source(source.bytes()).diagnostics {
        if diagnostic.code == "E0067" -> reserved = true
    }
    assert(reserved, "user source must not enter the compiler-reserved identifier lane")
    bare :: raw_ui_transfer_reports(source)
    assert(bare.len() == 1 && bare[0].contains("requires an audited `#Unsafe` region"), "{bare:Debug}")
    gated :: raw_ui_transfer_reports("use core.ui as ui\nfn run() {{ #Unsafe(\"UI carrier transfer: fixture\") {{ {call} }} }}\n")
    assert(gated.is_empty(), "{gated:Debug}")
}
