// Production codec + held store/index fixture. Requires real packaging identity,
// Core toolchain and disk-backed JET_CLI_FMT_TEST_ROOT. No host/provider mocks.
use core.files as cli_files
use core.sys as cli_sys
use core.process as cli_process
use jet_foundation.[MIR_ACCELERATION_RECEIPT_SCHEMA_DIGEST, MIR_ACCELERATION_RECEIPT_TYPE_NAME]

struct JetCLIAccelerationFixtureRoot {
    path: String
}
impl JetCLIAccelerationFixtureRoot.Close {
    fn close(^self) -[FS]> {
        cli_files.remove_all(self.path).drop("remove receipt fixture")
    }
}

fn acceleration_receipt_require(ok: Bool, label: String) Never! {
    if !ok -> panic("authenticated acceleration receipts: {label}")
}
fn acceleration_receipt_payload(status: String) -> String Never! {
    "{{\"decision\":{{\"measurement\":{{\"bandwidth_floor_nanos\":1,\"floor_nanos\":1,\"items\":2048,\"projected_serial_nanos\":18446744073709551615,\"required_serial_nanos\":null,\"sample_items\":1,\"sample_nanos\":18446744073709551615,\"spawn_nanos\":1}},\"pin\":null,\"status\":\"{status}\",\"transform\":\"parallel\"}},\"function\":\"run\",\"loop_header\":7,\"source\":{{\"end\":9,\"start\":2}}}}"
}
fn acceleration_receipt_section(sequence: String, payload: String) -> JetCLIReceiptSection {
    section := jet_cli_receipt_section_new("jet.acceleration.{sequence}", MIR_ACCELERATION_RECEIPT_TYPE_NAME, payload.bytes()) ?? panic("typed acceleration section")
    section.schema_digest = MIR_ACCELERATION_RECEIPT_SCHEMA_DIGEST
    section
}
fn acceleration_receipt_entry(receipt: JetCLIReceipt, identity: String, sequence: U64) -> JetCLIRecordIndexEntry {
    encoded :: jet_cli_receipt_encode(receipt) ?? panic("canonical receipt encode")
    JetCLIRecordIndexEntry{identity: JetCLIRecordIdentity{target_inputs_sha256: identity, tool_version: JET_CLI_VERSION, engine: "jet-receipt-v2"}, kind: "receipt", artifact_id: receipt.claim.key, path: ".jet/receipts/objects/{receipt.claim.key}", consumed: [], produced: [], capture: "safe", size: U64.from_int(encoded.len()) ?? panic("negative size"), recorded_sequence: sequence, saved: false}
}
fn run() {
    base :: cli_sys.get("JET_CLI_FMT_TEST_ROOT") ?? panic("set disk-backed JET_CLI_FMT_TEST_ROOT")
    root :: "{base}/accel-{cli_process.current_pid()}"
    cli_files.create_dir_all(root) ?? panic("create receipt fixture")
    owner :: JetCLIAccelerationFixtureRoot{path: root}
    defer close(^owner)
    file :: "{root}/run.jet"
    cli_files.write(file, "fn run() {{}}\n") ?? panic("create real source")
    cache := WorkspaceDeclarationCache.new()
    paths :: [String]{file}
    terminal :: jet_cli_terminal_bits()
    older_claim :: jet_cli_receipt_claim("build", paths, [String]{"build", file, "--profile", "dev"}, terminal) ?? panic("canonical older claim")
    newer_claim :: jet_cli_receipt_claim("build", paths, [String]{"build", file, "--profile", "release"}, terminal) ?? panic("canonical newer claim")
    payload :: acceleration_receipt_payload("selected")
    older :: jet_cli_receipt_prepare(older_claim, 0, [], [], [JetCLIReceiptSection]{acceleration_receipt_section("10", payload), acceleration_receipt_section("2", payload)}, [], [], []) ?? panic("prepare older receipt")
    newer :: jet_cli_receipt_prepare(newer_claim, 0, [], [], [JetCLIReceiptSection]{acceleration_receipt_section("1", acceleration_receipt_payload("proof-incomplete"))}, [], [], []) ?? panic("prepare newer receipt")
    acceleration_receipt_require(jet_cli_receipt_publish(root, older) ?? panic("publish older"), "older actual immutable publication")
    acceleration_receipt_require(jet_cli_receipt_publish(root, newer) ?? panic("publish newer"), "newer actual immutable publication")
    identity :: (jet_cli_receipt_target_identity(&cache, file, older_claim.inputs) ?? panic("canonical current target identity")).input_sha256
    index := jet_cli_record_index_new() ?? panic("index")
    jet_cli_record_index_publish_and_store(&index, root, acceleration_receipt_entry(older, identity, U64{1})) ?? panic("index older")
    jet_cli_record_index_publish_and_store(&index, root, acceleration_receipt_entry(newer, identity, U64{2})) ?? panic("index newer")
    loaded :: jet_cli_record_index_load(root) ?? panic("held index load")
    receipts :: jet_cli_receipt_list_current(root) ?? panic("authenticated current receipt load")
    selected :: jet_cli_acceleration_select_receipt(&cache, file, [String]{identity}, jet_cli_record_index_query_kind(loaded, "receipt", true), receipts, JET_COMPILER_TARGET_USIZE_MAX)
    acceleration_receipt_require(selected.len() == 1 && selected[0].record_sequence == U64{2} && selected[0].decision.status == .ProofIncomplete, "newest actual record selected")
    prepared :: jet_cli_prepare_overlays(file, file, [], false, Val(1), JetDriverCompileMode.Doc)
    request :: if prepared == {
        .Prepared(value, _) -> value
        .Refused(output) -> panic("prepare actual query: {output.stderr}")
    }
    query :: jet_driver_optimization_query(^request)
    acceleration_receipt_require(query.compile.complete, "actual compiler query before store collection")
    hosted :: jet_cli_acceleration_runtime_rows(query.profile, file, "target", Val(root)) ?? panic("directory target runtime rows")
    acceleration_receipt_require(hosted.len() == 1 && hosted[0].record_sequence == U64{2}, "directory closure -> authenticated actual host provider")
    sorted :: jet_cli_acceleration_receipt_rows(older, U64{1}, JET_COMPILER_TARGET_USIZE_MAX) ?? panic("decode numeric sequence")
    acceleration_receipt_require(sorted.len() == 2 && sorted[0].sequence == U64{2} && sorted[1].sequence == U64{10}, "numeric rather than lexical section order")
    acceleration_receipt_require(sorted[0].decision.measurement.sample_nanos == U64.MAX && sorted[0].decision.measurement.required_serial_nanos == None, "full u64 and optional null measurements")
    duplicate := older
    duplicate.sections = [JetCLIReceiptSection]{acceleration_receipt_section("1", payload), acceleration_receipt_section("01", payload)}
    duplicate_rows :: jet_cli_acceleration_receipt_rows(duplicate, U64{1}, JET_COMPILER_TARGET_USIZE_MAX)
    acceleration_receipt_require(if duplicate_rows == {.Err(error) -> error.message == "duplicate acceleration receipt sequence" else -> false}, "duplicate numeric sequence rejected with typed error")
    wide_payload :: payload.replace("\"start\":2", "\"start\":18446744073709551614").replace("\"end\":9", "\"end\":18446744073709551615")
    wide := older
    wide.sections = [JetCLIReceiptSection]{acceleration_receipt_section("1", wide_payload)}
    wide_rows :: jet_cli_acceleration_receipt_rows(wide, U64{1}, U64.MAX) ?? panic("wide source range")
    acceleration_receipt_require(jet_cli_status_json(jet_cli_optimization_runtime(wide_rows[0])).contains("\"end\":18446744073709551615"), "runtime spans never narrow to signed Int")
    truncated :: jet_cli_acceleration_receipt_rows(wide, U64{1}, U64{4294967295})
    acceleration_receipt_require(if truncated == {.Err(error) -> error.message == "acceleration field `start` is out of range" else -> false}, "host pointer width error propagates from foundation codec")
    loop invalid in ([String]{payload.replace("\"pin\":null", "\"pin\":\"#Scalar\""), payload.replace("\"selected\"", "\"unknown\""), payload.replace("\"loop_header\":7", "\"loop_header\":4294967296"), payload.replace("\"start\":2", "\"start\":10"), payload.replace("\"floor_nanos\":1", "\"floor_nanos\":1,\"unknown\":0")}) {
        bad := older
        bad.sections = [JetCLIReceiptSection]{acceleration_receipt_section("1", invalid)}
        rejected :: jet_cli_acceleration_receipt_rows(bad, U64{1}, U64.MAX)
        acceleration_receipt_require(if rejected == {.Err(error) -> error.message != "" else -> false}, "malformed payload rejected with typed error message")
    }
    malformed_claim :: jet_cli_receipt_claim("build", paths, [String]{"build", file, "--profile", "malformed"}, terminal) ?? panic("malformed-row claim")
    malformed :: jet_cli_receipt_prepare(malformed_claim, 0, [], [], [JetCLIReceiptSection]{acceleration_receipt_section("1", acceleration_receipt_payload("unknown"))}, [], [], []) ?? panic("authenticated malformed typed payload")
    _ :: jet_cli_receipt_publish(root, malformed) ?? panic("publish malformed typed payload")
    jet_cli_record_index_publish_and_store(&index, root, acceleration_receipt_entry(malformed, identity, U64{3})) ?? panic("index malformed typed payload")
    recovered :: jet_cli_acceleration_runtime_rows(query.profile, file, "target", Val(root)) ?? panic("newest malformed row fallback")
    acceleration_receipt_require(recovered.len() == 1 && recovered[0].record_sequence == U64{2}, "invalid typed rows do not become runtime observations")
    empty_claim :: jet_cli_receipt_claim("build", paths, [String]{"build", file, "--profile", "empty"}, terminal) ?? panic("empty receipt claim")
    empty :: jet_cli_receipt_prepare(empty_claim, 0, [], [], [], [], [], []) ?? panic("empty acceleration receipt")
    _ :: jet_cli_receipt_publish(root, empty) ?? panic("publish empty receipt")
    jet_cli_record_index_publish_and_store(&index, root, acceleration_receipt_entry(empty, identity, U64{4})) ?? panic("index empty receipt")
    no_rows :: jet_cli_acceleration_runtime_rows(query.profile, file, "target", Val(root)) ?? panic("empty newest receipt")
    acceleration_receipt_require(no_rows.len() == 0, "valid newest empty receipt does not fall back to older measurements")
    // Currentness is checked by the real held store, not by the index alone.
    cli_files.write(file, "fn run() {{ value :: 1 }}\n") ?? panic("change input")
    stale :: jet_cli_receipt_list_current(root) ?? panic("stale receipt load")
    acceleration_receipt_require(stale.len() == 0, "changed input cannot authenticate old receipts")
    unavailable :: jet_cli_watch_from_entry(&cache, file, [String]{file}, None)
    acceleration_receipt_require(if unavailable == {.Err(error) -> error.comptime_unavailable && error.message.contains("#4736") else -> false}, "missing canonical comptime coverage refuses, never empty graph")
}
