// The canonical-pass record projection and its place in the decisions report.
use jet_foundation.[
    CanonicalPassOptions, CanonicalPassSnapshot, canonical_pass_journal,
    canonical_pass_record, canonical_pass_take,
]
use jet_ir.[IROptReport]
use jet_cli.[
    JetCLIDecisions, jet_cli_canonical_routes, jet_cli_canonical_snapshot,
    jet_cli_decisions_report, jet_cli_status_json,
]

fn inspect_canonical_require(ok: Bool, message: String) Never! {
    if !ok -> panic("InspectCanonicalRoutes: {message}")
}
#Test("inspect_canonical_routes") {
    journal := canonical_pass_journal(CanonicalPassOptions{adapter_mode: "parity", operation_ids: [String]{"tir.lower-checked-program"}})
    input :: CanonicalPassSnapshot{representation: "ast", payload: "{{\"actual\":true}}", identity: "in"}
    output :: CanonicalPassSnapshot{representation: "tir", payload: "not a JSON snapshot", identity: "out"}
    canonical_pass_record(&journal, "lowering", "tir.lower-checked-program", "Compiler/JetDriver", input, output, "preserve")
    canonical_pass_record(&journal, "lowering", "tir.not-requested", "Compiler/JetDriver", input, output, "preserve")
    records :: canonical_pass_take(&journal)
    inspect_canonical_require(records.len() == 1, "only requested operations are journaled")
    routes :: jet_cli_canonical_routes(records, "inspecting-process")
    inspect_canonical_require(routes.len() == records.len(), "one projection per actual record")
    text :: jet_cli_status_json(routes[0])
    inspect_canonical_require(text.contains("\"schema\":\"jet.canonical-pass-record.v1\"") && text.contains("\"protocol\":\"jet.canonical-pass.v1\"") && text.contains("\"process\":\"inspecting-process\""), "canonical schema and source process")
    inspect_canonical_require(text.contains("\"canonical_payload\":") && text.contains("\"representation\":") && text.contains("\"identity\":") && text.contains("\"premises\":") && text.contains("\"disposition\":"), "snapshot facts retained")
    report :: IROptReport{level: 1, inlined_calls: 0, direct_calls: 0, folded: 1, branches_folded: 0, compares_fused: 0, copies_coalesced: 0, dead_removed: 2, unreachable_removed: 0, aggregates_replaced: 0, instructions_before: 9, instructions_after: 7}
    decisions :: JetCLIDecisions{report: report, unbuilt: [String]{}}
    json :: jet_cli_decisions_report(decisions, "target", "run.jet", "debug", routes, [], true)
    inspect_canonical_require(json.contains("\"action\":\"inspect.decisions\"") && json.contains("\"level\":1") && json.contains("\"instructions_before\":9") && json.contains("\"dead_removed\":2"), "IR optimizer report fields")
    inspect_canonical_require(json.contains("\"canonical_routes\":[{{\"schema\":\"jet.canonical-pass-record.v1\""), "journal included in status envelope")
    human :: jet_cli_decisions_report(decisions, "target", "run.jet", "debug", routes, [], false)
    inspect_canonical_require(human == "decisions: scope=target source=run.jet profile=debug\nO1: instructions 9 -> 7, inlined 0, direct calls 0, folded 1, branches 0, fused compares 0, coalesced 0, dead 2, unreachable 0, scalar-replaced 0\n", "IR optimizer report text")
    parsed :: jet_cli_canonical_snapshot("{{\"actual\":true}}")
    inspect_canonical_require(jet_cli_status_json(parsed) == "{{\"actual\":true}}", "canonical payload remains a parsed value")
    fallback :: jet_cli_canonical_snapshot("not a JSON snapshot")
    inspect_canonical_require(jet_cli_status_json(fallback) == "\"not a JSON snapshot\"", "unparseable payload remains exact text")
}
