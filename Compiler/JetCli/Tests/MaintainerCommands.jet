// Pure policy contracts for the production maintainer command leaves.
// Hosted capture replay proves disk/compiler/child behavior separately.
fn run() Never! {
    if jet_cli_reduced_path("sample.jet") != "sample.reduced.jet" -> panic("Jet suffix")
    if jet_cli_reduced_path("sample") != "sample.reduced.jet" -> panic("missing extension")
    if jet_cli_reduced_path(".sample") != ".sample.reduced.jet" -> panic("dotfile extension")
    if jet_cli_reduced_path("sample.other") != "sample.reduced.other" -> panic("keep non-Jet extension")
    if jet_cli_reduced_path("sample.") != "sample.reduced." -> panic("empty extension")
    if jet_cli_reduced_path("folder/sample.jet") != "folder/sample.reduced.jet" -> panic("sibling output")
    if jet_cli_reduced_path("back\\slash.jet") != "back\\slash.reduced.jet" -> panic("Unix backslash filename")
    if jet_cli_reduced_path("épreuve.jet") != "épreuve.reduced.jet" -> panic("UTF-8 name")
    lines :: [String]{"first", "middle", "last"}
    if jet_cli_reduce_candidate(&lines, 0, 2) != ([String]{"last"}) -> panic("first chunk")
    if jet_cli_reduce_candidate(&lines, 1, 2) != ([String]{"first", "last"}) -> panic("middle chunk")
    if jet_cli_reduce_candidate(&lines, 1, 3) != ([String]{"first"}) -> panic("last chunk")
    if jet_cli_reduce_candidate(&lines, 0, 3).len() != 0 -> panic("empty candidate")
    if jet_cli_reduce_candidate(&lines, 1, 1) != lines -> panic("zero-width removal")
    all :: jet_cli_bless_targets([String]{})
    if all.targets != JET_CLI_BLESS_TARGETS || all.unknown.len() != 0 -> panic("default sweep")
    repeated :: jet_cli_bless_targets([String]{"cross", "cross", "cli"})
    if repeated.targets != ([String]{"cross", "cross", "cli"}) -> panic("keep target order and duplicates")
    mixed :: jet_cli_bless_targets([String]{"cli", "oops", "cross", "oops"})
    if mixed.targets != ([String]{"cli", "cross"}) || mixed.unknown != ([String]{"oops", "oops"}) -> panic("all unknown targets retained")
    dry :: jet_cli_devtools_bless([String]{"cross", "cross", "--dry-run"}, false, false)
    if dry.exit_code != 0 || dry.stderr != "" || dry.stdout != "would run: UPDATE_EXPECT=1 cargo test --test cross\nwould run: UPDATE_EXPECT=1 cargo test --test cross\n" -> panic("dry run bypasses reason and child launch")
    unknown :: jet_cli_devtools_bless([String]{"cli", "--dry-run", "--json"}, false, true)
    if unknown.exit_code != 2 || !unknown.stdout.contains("Unknown bless target(s): --json") || !unknown.stderr.starts_with("usage: jet devtools bless") -> panic("raw own flags with JSON CLI diagnostic")
    empty :: jet_cli_devtools_reduce([String]{}, false, true)
    if empty.stdout != "" || empty.stderr != "usage: jet devtools reduce <file.jet> [--code EXXXX]\n" || empty.exit_code != 2 -> panic("direct missing-arg usage even in JSON")
    bad_flag :: jet_cli_devtools_reduce([String]{"sample.jet", "--code=E0003"}, false, false)
    if bad_flag.exit_code != 2 || !bad_flag.stderr.contains("Unknown `reduce` flag `--code=E0003`") -> panic("reduce takes only two-word code option")
    if "ééé".bytes().len() >= 8 || "éééé".bytes().len() != 8 -> panic("bless reason uses UTF-8 byte length")
}
