// Pure ReceiptStore/RecordIndex contracts; assemble with Compiler and run.
fn record_receipt_memory_require(ok: Bool, name: String) Never! {
    if !ok -> panic("record/receipt memory contract: {name}")
}

fn run() {
    digest :: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    claim :: JetCLIReceiptClaim{verb: "run", key: digest, inputs: [JetCLIReceiptInput]{}}
    receipt :: jet_cli_receipt_prepare(claim, 0, [U8]{255, 115, 101, 99, 114, 101, 116}, [U8]{}, [JetCLIReceiptSection]{}, [JetCLIRecordLink]{}, [JetCLIRecordLink]{}, [String]{"secret"}) ?? panic("prepare")
    record_receipt_memory_require(receipt.stdout == [U8]{255, 60, 114, 101, 100, 97, 99, 116, 101, 100, 62}, "redaction preserves non UTF8")
    bytes :: jet_cli_receipt_encode(receipt) ?? panic("encode")
    found :: jet_cli_receipt_lookup_bytes(Val(bytes), claim, [JetCLIReceiptInput]{}, [JetCLIReceiptSectionRecord]{}) ?? panic("lookup")
    record_receipt_memory_require(found.digest == receipt.digest, "authenticated cache hit")
    stale :: if jet_cli_receipt_lookup_bytes(Val(bytes), claim, [JetCLIReceiptInput]{JetCLIReceiptInput{path: "changed", digest: digest}}, [JetCLIReceiptSectionRecord]{}) == {
        .Val(_) -> false
        .None -> true
        .Err(error) -> { panic(error.message) }
    }
    record_receipt_memory_require(stale, "changed input misses without a read failure")
    index := jet_cli_record_index_new() ?? panic("index")
    identity :: JetCLIRecordIdentity{target_inputs_sha256: digest, tool_version: "jet", engine: "interpreter"}
    entry :: JetCLIRecordIndexEntry{identity: identity, kind: "replay", artifact_id: digest, path: ".jet/replays/{digest}.jetreplay", recorded_sequence: U64{1}, size: U64{1}, capture: "safe", saved: false, consumed: [JetCLIRecordLink]{}, produced: [JetCLIRecordLink]{}}
    jet_cli_record_index_update(&index, entry) ?? panic("insert")
    jet_cli_record_index_update(&index, entry) ?? panic("idempotent insert")
    record_receipt_memory_require(jet_cli_record_index_query(index, false).len() == 1, "idempotent rows")
    snapshot :: jet_cli_record_index_to_bytes(index) ?? panic("snapshot")
    restored :: jet_cli_record_index_from_bytes(snapshot) ?? panic("restore")
    record_receipt_memory_require(jet_cli_record_index_find(restored, "replay", digest, false) == .Val(entry), "canonical JSONL snapshot round trip")
    sequence :: jet_cli_record_index_next_sequence(restored) ?? panic("sequence")
    record_receipt_memory_require(sequence == U64{2}, "sequence increment")
    fresh :: jet_cli_record_index_fresh_sequence(restored, JetCLIRecordIndexEntry{identity: identity, kind: "replay", artifact_id: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", path: ".jet/replays/new.jetreplay", recorded_sequence: U64{1}, size: U64{1}, capture: "safe", saved: false, consumed: [JetCLIRecordLink]{}, produced: [JetCLIRecordLink]{}}) ?? panic("fresh sequence")
    record_receipt_memory_require(fresh.recorded_sequence == U64{2}, "new key receives a sequence after the latest disk snapshot")
    // copy: `entry` (a payload view of the index lookup above) is compared again at line 35, and
    // the take argument needs its own row (owner: `sequence_entry`).
    sequence_entry := entry.copy()
    same :: jet_cli_record_index_fresh_sequence(restored, ^sequence_entry) ?? panic("existing sequence")
    record_receipt_memory_require(same == entry, "existing identity preserves its sequence for idempotence")
    section :: jet_cli_receipt_section_new("test", "TestRecord", "{}".bytes()) ?? panic("section")
    appended :: JetCLIReceiptSectionRecord{claim_key: claim.key, parent_digest: receipt.digest, section: section}
    // copy: `receipt` stays with `receipt`, which is read again at line 40, and the binding
    // `original` owns its own.
    original := receipt.copy()
    projected :: jet_cli_receipt_merge_sections(^original, claim, [JetCLIReceiptSectionRecord]{appended, appended}) ?? panic("merge")
    record_receipt_memory_require(projected.sections.len() == 1 && projected.digest == receipt.digest, "append-only sections deduplicate and retain immutable parent identity")
    wrong :: JetCLIReceiptSectionRecord{claim_key: claim.key, parent_digest: digest, section: section}
    // copy: `receipt` stays the test's fixture (read for its digest and claim) while the rejected
    // merge takes its own copy (owner: `invalid_parent`).
    invalid_parent := receipt.copy()
    rejected :: jet_cli_receipt_merge_sections(^invalid_parent, claim, [JetCLIReceiptSectionRecord]{wrong}) == .Err(_)
    record_receipt_memory_require(rejected, "section parent authentication is mandatory")
}
