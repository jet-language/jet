// `toolchain:` comptime inputs read the toolchain tree the
// compile takes Core from, beneath its root with the no-follow rooted read, and
// only from the toolchain's own packages: the compiler workspace, its members
// and the packages their path dependencies reach inside the tree. A vendored
// package nested in the tree, a file outside it and a compile with no tree
// refuse with E0945; every read is recorded under its `toolchain:` name.
use {
    jet_cli.[JetCLIBuildInputs, JetCLIToolchainPackages]
    jet_driver.[JetDriverComptimeInputLog, JetDriverComptimeInputRecord, JetDriverComptimeInputs, JetDriverToolchainTree, jet_driver_shared_build_inputs]
    jet_foundation.[Span, TComptimeValue]
    cli_sys: core.sys
    cli_files: core.files
    cli_process: core.process
}

toolchain_inputs_test_write: fn(path: String, text: String) {
    cli_files.create_dir_all(cli_files.dirname(path)) ?? panic("test directory for {path}")
    cli_files.write(path, text) ?? panic("test file {path}")
}

// The comptime input host of the file `file`, over the real transport, with
// the toolchain tree `tree`.
toolchain_inputs_test_adapter: fn(file: String, tree: Shared<JetDriverToolchainTree>?, log: Shared<JetDriverComptimeInputLog>) -> JetDriverComptimeInputs {
    JetDriverComptimeInputs{inputs: jet_driver_shared_build_inputs(JetCLIBuildInputs{}), base_dir: cli_files.dirname(file), log: Val(log), file: file, toolchain: tree}
}

toolchain_inputs_test_text: fn(adapter: JetDriverComptimeInputs, builtin: String, path: String) -> TComptimeValue {
    if adapter.comptime_input(builtin, path, Span{start: 0, end: 1}) == {
        .Ok(value) -> value
        .Err(problem) -> panic("`{builtin}(\"{path}\")`: {problem.diagnostic.code} {problem.diagnostic.what}: {problem.diagnostic.why}")
    }
}

toolchain_inputs_test_refused: fn(adapter: JetDriverComptimeInputs, builtin: String, path: String) -> String {
    if adapter.comptime_input(builtin, path, Span{start: 0, end: 1}) == {
        .Ok(_) -> panic("`{builtin}(\"{path}\")` was admitted")
        .Err(problem) -> problem.diagnostic.code
    }
}

#Test("toolchain: comptime inputs read the toolchain tree from its own packages only") {
    made: "{cli_sys.temp_dir()}/jet-toolchain-inputs-{cli_process.current_pid()}"
    toolchain_inputs_test_write("{made}/Compiler/package.jet", "name: \"compiler\"\nversion: \"0.0.1\"\nmembers: [\n    \"Member\",\n]\n")
    toolchain_inputs_test_write("{made}/Compiler/Member/package.jet", "name: \"member\"\nversion: \"0.0.1\"\ndeps: {{\n    dep: ../../Dep,\n}}\n")
    toolchain_inputs_test_write("{made}/Compiler/Tool/package.jet", "name: \"tool\"\nversion: \"0.0.1\"\n")
    toolchain_inputs_test_write("{made}/Dep/package.jet", "name: \"dep\"\nversion: \"0.0.1\"\n")
    toolchain_inputs_test_write("{made}/Vendored/package.jet", "name: \"vendored\"\nversion: \"0.0.1\"\n")
    toolchain_inputs_test_write("{made}/Data/table.txt", "row\n")
    toolchain_inputs_test_write("{made}/Data/rows/a.txt", "a\n")
    toolchain_inputs_test_write("{made}/Data/rows/b.txt", "b\n")
    toolchain_inputs_test_write("{made}-outside/secret.txt", "secret\n")
    cli_files.symlink("{made}-outside/secret.txt", "{made}/Data/escape.txt") ?? panic("test escape link")
    root: cli_files.realpath(made) ?? panic("test root")
    log: shared JetDriverComptimeInputLog{records: [JetDriverComptimeInputRecord]{}}
    // copy: each adapter shares the one tree cell, so the package census runs once.
    tree: shared JetDriverToolchainTree{root: root.copy(), reader: JetCLIToolchainPackages{}, packages: None}
    member: toolchain_inputs_test_adapter("{root}/Compiler/Member/main.jet", Val(tree.copy()), log.copy())
    if toolchain_inputs_test_text(member, "embed_file", "toolchain:Data/table.txt") == .String(text) -> assert_eq(text, "row\n") else -> panic("embed_file gives text")
    dep: toolchain_inputs_test_adapter("{root}/Dep/Nested/lib.jet", Val(tree.copy()), log.copy())
    if toolchain_inputs_test_text(dep, "find", "toolchain:Data/rows/*.txt") == .List(values) {
        assert_eq(values.len(), 2)
        if values[0] == .String(first) -> assert_eq(first, "Data/rows/a.txt") else -> panic("find gives paths")
    } else {
        panic("find gives a list")
    }
    assert_eq(tree.guard_read().value.packages, Val([String]{"{root}/Compiler", "{root}/Compiler/Member", "{root}/Dep"}))
    names: loop record in log.guard_read().value.records -> record.path
    assert_eq(names, [String]{"toolchain:Data/table.txt", "toolchain:Data/rows/a.txt", "toolchain:Data/rows/b.txt", "toolchain:Data/rows/*.txt"})
    assert_eq(log.guard_read().value.records[0].file, "{root}/Data/table.txt")
    assert_eq(log.guard_read().value.records[3].file, "{root}/Data/rows/*.txt")
    assert_eq(log.guard_read().value.records[3].glob, "Data/rows/*.txt")
    assert_eq(toolchain_inputs_test_refused(member, "embed_file", "toolchain:Data/escape.txt"), "E0955")
    vendored: toolchain_inputs_test_adapter("{root}/Vendored/main.jet", Val(tree.copy()), log.copy())
    assert_eq(toolchain_inputs_test_refused(vendored, "embed_file", "toolchain:Data/table.txt"), "E0945")
    assert_eq(toolchain_inputs_test_refused(vendored, "find", "toolchain:Data/rows/*.txt"), "E0945")
    tool: toolchain_inputs_test_adapter("{root}/Compiler/Tool/main.jet", Val(tree.copy()), log.copy())
    assert_eq(toolchain_inputs_test_refused(tool, "embed_file", "toolchain:Data/table.txt"), "E0945")
    outside: toolchain_inputs_test_adapter("{made}-outside/main.jet", Val(tree.copy()), log.copy())
    assert_eq(toolchain_inputs_test_refused(outside, "embed_file", "toolchain:Data/table.txt"), "E0945")
    untreed: toolchain_inputs_test_adapter("{root}/Compiler/Member/main.jet", None, log.copy())
    assert_eq(toolchain_inputs_test_refused(untreed, "embed_bytes", "toolchain:Data/table.txt"), "E0945")
    assert_eq(toolchain_inputs_test_refused(member, "embed_file", "beside.txt"), "E0955")
    cli_files.remove_all(made) ?? panic("test root cleanup")
    cli_files.remove_all("{made}-outside") ?? panic("test outside cleanup")
}
