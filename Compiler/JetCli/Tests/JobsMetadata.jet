// Pure renderer assertions are controlled metadata, not checked/run evidence.
// The entry-selection assertion instead calls the actual completed checker once.
use {
    jet_foundation.[Func, Item, JobSkip, Span, StringMapEntry, JobRegistry, ast_func, ast_job_metadata]
    jet_sema.[SchemaSnapshot]
    jet_driver.[JetDriverCompileMode, JetDriverAuthorizedSourceSnapshot, JetDriverAuthorizedSourceRoot, JetDriverAuthorizedSourceFile, JetDriverCoreSource, jet_driver_checked_projection]
    jet_cli.[jet_cli_driver_request, jet_cli_job_metadata_detail, jet_cli_jobs_metadata_json, jet_cli_jobs_metadata_registry, jet_cli_jobs_text]
}

jobs_metadata_function: fn(name: String, internal: Bool) -> Func Never! {
    span: Span{start: 0, end: 0}
    function := ast_func(name, span, span)
    function.is_job = true
    metadata := ast_job_metadata()
    metadata.scope = if internal -> .Internal else -> .Ship
    metadata.after = [String]{"pre"}
    metadata.inputs = [String]{"src"}
    metadata.outputs = [String]{"out"}
    metadata.packages = [String]{"dep"}
    metadata.cwd = Val("sub")
    metadata.skip = Val(JobSkip.Always{reason: "because"})
    metadata.cache = .Shared
    metadata.parallel = Val(2)
    metadata.limits = [StringMapEntry]{StringMapEntry{key: "z", value: "2"}, StringMapEntry{key: "a", value: "1"}}
    function.job_metadata = Val(metadata)
    function
}

jobs_metadata_actual_entry: fn() {
    root: "/jobs-metadata-fixture"
    identity: "jobs-metadata-fixture"
    source: "use helper.[helper_job]\nhelper: module {{\n    #Job\n    helper_job: fn() {{}}\n}}\n#Job\nown_job: fn() {{}}\nrun: fn() {{}}\n"
    snapshot: JetDriverAuthorizedSourceSnapshot{
        roots: [JetDriverAuthorizedSourceRoot]{JetDriverAuthorizedSourceRoot{
            canonical_path: root,
            identity: identity,
            allow_hardlinks: false,
            files: [JetDriverAuthorizedSourceFile]{
                {path: "{root}/main.jet", relative_path: "main.jet", identity: identity, source: source},
            },
            foreign_cache_files: [],
        }},
        entry_root_identity: identity,
        entry_path: "{root}/main.jet",
    }
    request := jet_cli_driver_request(snapshot, [JetDriverCoreSource]{}, None, JetDriverCompileMode.Program)
    request.schema_snapshots = Val([String:SchemaSnapshot]{})
    projection: jet_driver_checked_projection(request)
    seen: (loop diagnostic in projection.compile.diagnostics -> "{diagnostic.code}: {diagnostic.what}").join("; ")
    assert_eq(seen, "")
    assert(projection.compile.complete && projection.compile.internal_problem == None)
    registry: jet_cli_jobs_metadata_registry(projection) ?? panic("actual successful entry projection")
    assert_eq(registry.completion_words().join(" "), "own_job")
    assert(registry.find("helper_job") == None)
}

#Test("jobs_metadata") {
    registry: JobRegistry.from_items([Item]{Item.Func{value: jobs_metadata_function("Visible", false)}, Item.Func{value: jobs_metadata_function("Hidden", true)}})
    policy: `"after":["pre"],"inputs":["src"],"outputs":["out"],"packages":["dep"],"cwd":"sub","skip":{"kind":"always","reason":"because"},"cache":"shared","limits":{"a":"1","z":"2"},"parallel":2`
    visible: `{"schema":"jet.status/v1","action":"jobs","ok":true,"reports":[],"jobs":[{"name":"Visible","scope":"ship","doc":null,"arguments":[],"schedule":null,`
    hidden: `},{"name":"Hidden","scope":"internal","doc":null,"arguments":[],"schedule":null,`
    jobs_json: [String]{visible, policy, hidden, policy, `}]}`}.join("")
    jobs_line: "{jobs_json}\n"
    assert_eq(jet_cli_jobs_metadata_json(registry), jobs_line)
    rows: registry.jobs()
    detail: "(after pre) (inputs src) (outputs out) (packages dep) (cwd sub) (skip always (because)) (cache shared) (limits a=1, z=2) (parallel 2)"
    assert_eq(jet_cli_job_metadata_detail(rows[0]), detail)
    jobs_text: "Visible  [ship] {detail}\nHidden   [internal] {detail}\n"
    assert_eq(jet_cli_jobs_text(registry), jobs_text)
    empty: JobRegistry.from_items([Item]{})
    empty_json: `{"schema":"jet.status/v1","action":"jobs","ok":true,"reports":[],"jobs":[]}`
    empty_line: "{empty_json}\n"
    assert_eq(jet_cli_jobs_metadata_json(empty), empty_line)
    assert_eq(jet_cli_jobs_text(empty), "No jobs declared.\n")
    span: Span{start: 0, end: 0}
    limits_only := ast_func("limits", span, span)
    limits_only.is_job = true
    policy_only := ast_job_metadata()
    policy_only.limits = [StringMapEntry]{StringMapEntry{key: "a", value: "1"}}
    limits_only.job_metadata = Val(policy_only)
    limited: JobRegistry.from_items([Item]{Item.Func{value: limits_only}})
    assert_eq(jet_cli_job_metadata_detail(limited.jobs()[0]), "(limits a=1)")
    bare := ast_func("bare", span, span)
    bare.is_job = true
    assert_eq(jet_cli_jobs_text(JobRegistry.from_items([Item]{Item.Func{value: bare}})), "bare  [dev]\n")
    jobs_metadata_actual_entry()
}
