// `jet -e CODE` runs CODE as the body of `run: fn` (Compiler/JetCli/Source/Cli/Front.jet,
// ScriptCache.jet jet_cli_eval_file). The code prints and exits 0; a rerun of
// the same code runs the same entry file and keeps no program; a `;` separates
// statements; the value of a last statement that is an expression is shown
// (one line per item of a List or an Iter, nothing for a unit value or a
// statement); code that names an undefined binding is refused with E0107
// before anything runs. `jet run -e CODE` runs it the same way; a `-e` after
// a run's program is refused with E2104, and `jet dev -e` with E2102. Runs
// with its own XDG cache.
// Usage: jet run Compiler/JetCli/Tests/RunEval.fixture/RunEval.jet -- <jet> <scratch>
// Run from the repository root: it is the toolchain root the runs use.
// It prints one line, the CompilerRegistries row's exact verdict.
use {
    files: core.files
    process: core.process
    term: core.term
}

fail: fn(message: String) -> Never { process.fail(1, message) }

// One finished `jet` run.
Ran: struct {
    code: Int
    signal: Int
    output: String
    errors: String
}

// `jet <args>` run in `work` with the cache `cache`.
jet_run: fn(jet: String, repo: String, work: String, cache: String, args: [String]) -> Ran {
    argv := [String]{jet.copy()}
    loop arg in args -> argv.push(arg.copy())
    receipt: process.cmd(argv).cwd(work.copy()).env("JET_TOOLCHAIN_ROOT", repo.copy()).env("XDG_CACHE_HOME", cache.copy()).env("NO_COLOR", "1").run() ?? fail("jet {args.join(" ")} failed to start: {err}")
    Ran{code: receipt.code, signal: receipt.signal ?? 0, output: receipt.output.copy(), errors: receipt.errors.copy()}
}

// One finished `jet -e CODE`.
eval: fn(jet: String, repo: String, work: String, cache: String, code: String) -> Ran {
    jet_run(jet, repo, work, cache, [String]{"-e", code.copy()})
}

// Every entry name of `directory`, sorted.
names_in: fn(directory: String) -> [String] {
    entries: files.list_dir(directory.copy()) ?? fail("cannot list {directory}: {err}")
    names := [String]{}
    loop entry in entries -> names.push(entry.name.copy())
    names.sort()
    names
}

// The kept slot records (there are none: every run compiles) and the entry
// files `-e` wrote.
cached: fn(cache: String) -> String {
    records: names_in("{cache}/jet/scripts").filter(name -> name.ends_with(".run"))
    sources: names_in("{cache}/jet/scripts/eval")
    "{records.len()} record(s), {sources.len()} entry file(s)"
}

run: fn() {
    args: process.args()
    if args.len() != 2 -> fail("usage: jet run Compiler/JetCli/Tests/RunEval.fixture/RunEval.jet -- <jet> <scratch>")
    jet: files.canonicalize(args[0].copy()) ?? fail("cannot resolve {args[0]}: {err}")
    scratch: files.absolute(args[1].copy()) ?? fail("cannot resolve {args[1]}: {err}")
    repo: files.canonicalize(".") ?? fail("cannot resolve the repository root: {err}")
    if files.exists(scratch.copy()) -> files.remove_all(scratch.copy()) ?? fail("cannot clear {scratch}: {err}")
    work: "{scratch}/work"
    cache: "{scratch}/cache"
    files.create_dir_all(work.copy()) ?? fail("cannot create {work}: {err}")

    first: eval(jet, repo, work, cache, "print(1 + 2)")
    if first.code != 0 || first.signal != 0 || first.output != "3\n" -> fail("print(1 + 2): code={first.code} signal={first.signal} stdout {first.output.debug()}\n{first.errors}")
    after_first: cached(cache)
    if after_first != "0 record(s), 1 entry file(s)" {
        fail("print(1 + 2): {after_first}, expected no kept program and one entry file")
    }

    rerun: eval(jet, repo, work, cache, "print(1 + 2)")
    if rerun.code != 0 || rerun.output != "3\n" {
        fail("rerun: code={rerun.code} stdout {rerun.output.debug()}\n{rerun.errors}")
    }
    if cached(cache) != after_first {
        fail("rerun: {cached(cache)}, expected the first run's entry file and no kept program")
    }

    lines: eval(jet, repo, work, cache, "name := 1; print(name)")
    if lines.code != 0 || lines.output != "1\n" -> fail("name := 1; print(name): code={lines.code} stdout {lines.output.debug()}\n{lines.errors}")

    typo: eval(jet, repo, work, cache, "name := 1; print(nmae)")
    if typo.code == 0 || typo.signal != 0 -> fail("typo: code={typo.code} signal={typo.signal}, expected a refusal\n{typo.errors}")
    if typo.output != "" -> fail("typo: ran and printed {typo.output.debug()}")
    if !typo.errors.contains("E0107") -> fail("typo: stderr names no E0107:\n{typo.errors}")

    via_run: jet_run(jet, repo, work, cache, [String]{"run", "-e", "print(1 + 2)"})
    if via_run.code != 0 || via_run.signal != 0 || via_run.output != "3\n" -> fail("jet run -e: code={via_run.code} signal={via_run.signal} stdout {via_run.output.debug()}\n{via_run.errors}")

    // The value of the last statement is shown, as `node -p` shows it.
    shows: [[String]]{
        [String]{"1 + 2", "3\n"},
        [String]{"name := 2; name * 3", "6\n"},
        [String]{"[1, 2, 3]", "1\n2\n3\n"},
        [String]{"\"GET /a 200\".words()", "GET\n/a\n200\n"},
        [String]{"\"x,y\".split(\",\")", "x\ny\n"},
        [String]{"\"a b\".words()[1]", "b\n"},
        [String]{"if 1 > 0 {{ print(4) }}", "4\n"},
        [String]{"answer: if 1 > 0 -> \"yes\" else -> \"no\"; answer", "yes\n"},
        [String]{"name := 5", ""},
    }
    loop row in shows {
        shown: eval(jet, repo, work, cache, row[0])
        if shown.code != 0 || shown.signal != 0 || shown.output != row[1] -> fail("{row[0]}: code={shown.code} signal={shown.signal} stdout {shown.output.debug()}, expected {row[1].debug()}\n{shown.errors}")
    }

    files.write("{work}/hello.jet", "run: fn() {{\n    print(1)\n}}\n") ?? fail("cannot write hello.jet: {err}")
    late: jet_run(jet, repo, work, cache, [String]{"run", "hello.jet", "-e", "print(2)"})
    if late.code == 0 || late.output != "" -> fail("jet run hello.jet -e: code={late.code} stdout {late.output.debug()}, expected a refusal")
    if !late.errors.contains("E2104") -> fail("jet run hello.jet -e: stderr names no E2104:\n{late.errors}")
    dev: jet_run(jet, repo, work, cache, [String]{"dev", "-e", "print(2)"})
    if dev.code == 0 || dev.output != "" -> fail("jet dev -e: code={dev.code} stdout {dev.output.debug()}, expected a refusal")
    if !dev.errors.contains("E2102") -> fail("jet dev -e: stderr names no E2102:\n{dev.errors}")
    term.print("run-eval: `jet -e` and `jet run -e` print, separate statements with `;`, rerun their entry file, refuse an undefined name before running and refuse a `-e` after the program or with `jet dev`: ok")
}
