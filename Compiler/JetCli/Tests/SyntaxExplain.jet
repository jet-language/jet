// Offline syntax dictionary lookup, plaintext essays, and typo classification.
use {
    jet_cli.[
        JET_CLI_SYNTAX_PROSE, JET_CLI_SYNTAX_ROWS, JetCLISyntaxKind, JetCLISyntaxRow, jet_cli_edit_distance,
        jet_cli_explain_build_fact_name, jet_cli_explain_policy, jet_cli_grammar_constants, jet_cli_grammar_tokens,
        jet_cli_syntax_display, jet_cli_syntax_lookup, jet_cli_syntax_nearest,
        jet_cli_syntax_plain_text, jet_cli_syntax_query, jet_cli_toolchain_root,
    ]
    cli_files: core.files
}

#Test("syntax_explain") {
    keyword_index: jet_cli_syntax_lookup("  Fn  ") ?? panic("case-insensitive syntax lookup")
    keyword: JET_CLI_SYNTAX_ROWS[keyword_index]
    if keyword.token != "fn" || keyword.kind != JetCLISyntaxKind.Keyword -> panic("canonical keyword")
    if jet_cli_syntax_plain_text(keyword) != "The Jet keyword `fn`.\nExample:\n  name: fn …\n" -> panic("keyword essay")
    marker_index: jet_cli_syntax_lookup("#Inline") ?? panic("marker display lookup")
    marker_row: JET_CLI_SYNTAX_ROWS[marker_index]
    if marker_row.kind != JetCLISyntaxKind.Marker || jet_cli_syntax_display(marker_row) != "#Inline" -> panic("marker identity")
    take_index: jet_cli_syntax_lookup("&&") ?? panic("take token lookup")
    essay: jet_cli_syntax_plain_text(JET_CLI_SYNTAX_ROWS[take_index])
    if !essay.contains("Between two conditions:\n") || !essay.contains("Before a parameter's type or `self`:\n") -> panic("one token's multiple meanings")
    if jet_cli_syntax_lookup("^") != .None -> panic("`^` is free and has no dictionary row")
    if !jet_cli_syntax_query("#Inlin") || !jet_cli_syntax_query(":>") || !jet_cli_syntax_query("é") -> panic("syntax typo classification")
    if jet_cli_syntax_query("npm:tool") || jet_cli_syntax_query("pkg@registry") || jet_cli_syntax_query("package-overlay:local") -> panic("package references are not syntax typos")
    if jet_cli_syntax_nearest("#Inlin") != "#Inline" -> panic("nearest registered spelling")
    if jet_cli_edit_distance("é", "f") != 1 -> panic("nearest syntax counts Unicode scalars")
    if jet_cli_explain_policy("copies", false, true) == .None -> panic("standalone policy explanation")
    if jet_cli_explain_policy("not_a_policy", false, true) != .None -> panic("unknown policy remains with caller")
    if jet_cli_explain_build_fact_name("#build.target.os") != .Val("Build.OS") -> panic("build fact precedes syntax typo classification")
    if jet_cli_explain_build_fact_name("#Build.Settings.Mode") != .Val("Build.Settings.mode") -> panic("dynamic setting normalization")
    if jet_cli_explain_build_fact_name("#build.settings.") != .None || jet_cli_explain_build_fact_name("#build.settings.a.b") != .None -> panic("invalid setting paths are not source queries")
    // The generated rows: every JET_KEYWORD_LIST word, and each Prelude marker
    // as a marker, under its Prelude spelling, with the plain meaning of its kind.
    yield_row: JET_CLI_SYNTAX_ROWS[jet_cli_syntax_lookup("yield") ?? panic("a listed keyword has a row")]
    if yield_row.kind != JetCLISyntaxKind.Keyword || jet_cli_syntax_plain_text(yield_row) != "The Jet keyword `yield`.\nExample:\n  yield …\n" -> panic("a generated keyword row explains itself")
    unsafe_row: JET_CLI_SYNTAX_ROWS[jet_cli_syntax_lookup("unsafe") ?? panic("a Prelude marker has a row")]
    if unsafe_row.kind != JetCLISyntaxKind.Marker || jet_cli_syntax_display(unsafe_row) != "#Unsafe" || unsafe_row.registry_name != "MARKER_SOURCE" -> panic("a keyword spelled as a marker is a marker row")
    if jet_cli_syntax_display(JET_CLI_SYNTAX_ROWS[jet_cli_syntax_lookup("#cli") ?? panic("CLI row")]) != "#CLI" -> panic("a marker row keeps its Prelude spelling")
    if jet_cli_syntax_lookup("#Pure") != .None -> panic("an undeclared marker has no row")
    loop row in JET_CLI_SYNTAX_ROWS {
        if jet_cli_syntax_plain_text(row) == "" || row.registry_name == "" -> panic("every syntax row explains itself")
        found: jet_cli_syntax_lookup(jet_cli_syntax_display(row)) ?? panic("every dictionary display is searchable")
        if JET_CLI_SYNTAX_ROWS[found].token != row.token -> panic("dictionary lookup precedence")
    }
    // Written prose is keyed by a row's token and kind; prose no row has is stale.
    loop prose in JET_CLI_SYNTAX_PROSE {
        if !JET_CLI_SYNTAX_ROWS.any(fn(row) { row.token == prose.token && row.kind == prose.kind }) -> panic("syntax prose for `{prose.token}` names no dictionary row")
    }
}

// Whether `text` names a decision (`D-` and a capital letter at the start of a
// word), which a reader of the dictionary can't look up.
syntax_explain_names_decision: fn(text: String) -> Bool Never! {
    raw: text.bytes()
    loop index in 0..<raw.len() {
        if raw[index] != (U8{68}) || index + 2 >= raw.len() -> next
        if raw[index + 1] != (U8{45}) || raw[index + 2] < (U8{65}) || raw[index + 2] > (U8{90}) -> next
        if index == 0 -> return true
        before: raw[index - 1]
        letter: (before >= (U8{65}) && before <= (U8{90})) || (before >= (U8{97}) && before <= (U8{122}))
        digit: before >= (U8{48}) && before <= (U8{57})
        if !letter && !digit && before != (U8{95}) -> return true
    }
    false
}

// What is wrong with `row`'s default explanation, or "" when nothing is.
syntax_explain_row_problem: fn(row: JetCLISyntaxRow) -> String Never! {
    loop meaning in row.meanings {
        if meaning.example.trim() == "" -> return "`{row.token}` has a meaning with no example"
    }
    essay: jet_cli_syntax_plain_text(row)
    if essay.contains("SIGIL_") || essay.contains("OP_") -> return "`{row.token}`'s explanation names a registry constant"
    if syntax_explain_names_decision(essay) -> return "`{row.token}`'s explanation names a decision"
    ""
}

#Test("every registered sigil and operator explains itself with an example and in plain words") {
    root: if jet_cli_toolchain_root(cli_files.cwd() ?? ".") == {
        .Found(found) -> found
        .Missing(what, fix) -> panic("{what}; {fix}")
    }
    constants: jet_cli_grammar_constants(root) ?? panic("read the syntax registry: {err.message}")
    tokens: jet_cli_grammar_tokens(root, constants) ?? panic("read the highlight tokens: {err.message}")
    problems := [String]{}
    walked := 0
    loop token in tokens {
        if token.class != "Sigil" && token.class != "Operator" && token.class != "TakeMark" -> next
        walked += 1
        index: jet_cli_syntax_lookup(token.text) ?? {
            problems.push("`{token.text}` is a registered {token.class.lower()} with no dictionary row")
            next
        }
        problem: syntax_explain_row_problem(JET_CLI_SYNTAX_ROWS[index])
        if problem != "" -> problems.push(problem)
    }
    loop row in JET_CLI_SYNTAX_ROWS {
        if row.kind != JetCLISyntaxKind.Sigil && row.kind != JetCLISyntaxKind.Operator -> next
        problem: syntax_explain_row_problem(row)
        if problem != "" && !problems.contains(problem) -> problems.push(problem)
    }
    assert(walked > 40, "the highlight registry lists the sigils and operators")
    assert_eq(problems.join("\n"), "")
}
