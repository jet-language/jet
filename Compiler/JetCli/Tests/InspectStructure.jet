// No compilation is needed to render facts.
use {
    jet_foundation.[StructureFact, StructureFactKind, GateLedger, Span]
    jet_cli.[jet_cli_structure_core, jet_cli_structure_registry, jet_cli_structure_report, jet_cli_structure_rows]
}

// Every structure fact kind, through a match that stops compiling when a kind
// is added.
inspect_structure_test_kind_ordinal: fn(kind: StructureFactKind) -> Int {
    if kind == {
        .Liveness -> 0
        .Lifecycle -> 1
        .ImportEdge -> 2
    }
}

INSPECT_STRUCTURE_TEST_KINDS: [StructureFactKind]{StructureFactKind.Liveness, StructureFactKind.Lifecycle, StructureFactKind.ImportEdge}

#Test("each structure fact kind has exactly one registration row and each Structure row has a kind") {
    seen := [Int]{}
    names := [String]{}
    loop kind in INSPECT_STRUCTURE_TEST_KINDS {
        ordinal: inspect_structure_test_kind_ordinal(kind)
        assert(!seen.contains(ordinal), "each structure fact kind is listed once")
        seen.push(ordinal)
        names.push(jet_cli_structure_registry(kind))
    }
    assert_eq(seen.len(), 3)
    rows: jet_cli_structure_rows()
    row_names := [String]{}
    loop row in rows {
        assert(names.contains(row.name), "registration row `{row.name}` names a structure fact kind")
        assert(!row_names.contains(row.name), "registration row `{row.name}` is listed once")
        row_names.push(row.name)
    }
    loop name in names -> assert(row_names.contains(name), "structure fact kind `{name}` has a registration row")
}

#Test("inspect_structure") {
    empty: jet_cli_structure_report([StructureFact]{}, GateLedger{}, false)
    if !empty.ends_with("facts: 0\n  (none in this program)\ngates: 0\n  (none in this program)\n") -> panic("empty structure text")
    facts: [StructureFact]{StructureFact{kind: StructureFactKind.Liveness, subject: "unused", source: "entry.jet", span: Span{start: 3, end: 9}, status: "unreachable", detail: "private function is never reached", gate: None}}
    text: jet_cli_structure_report(facts, GateLedger{}, false)
    if !text.contains("  liveness  entry.jet:3..9  unused  unreachable — private function is never reached\n") -> panic("structure fact text")
    machine: jet_cli_structure_report(facts, GateLedger{}, true)
    if !machine.starts_with("{{\"schema\":\"jet.status/v1\",\"action\":\"inspect.structure\",\"ok\":true,") -> panic("structure envelope")
    if !machine.contains("\"registry\":\"Structure.Liveness\"") || !machine.contains("\"gate\":null") -> panic("structure registry and optional gate")
    if !machine.ends_with("\n") -> panic("structure report newline")
    core: jet_cli_structure_core(false)
    if core.exit_code != 0 || core.stderr != "" || !core.stdout.starts_with("core\nbootstrap:\n  1. Syntax  depends_on [none]\n") -> panic("canonical Core text")
    core_json: jet_cli_structure_core(true)
    if core_json.exit_code != 0 || !core_json.stdout.contains("\"root_types\":") || !core_json.stdout.contains("\"type_exports\":") -> panic("canonical Core projection")
    if !core_json.stdout.contains("\"calls\":[{{\"module\":\"") || !core_json.stdout.contains("\"effect_leaf\":") -> panic("the Core call records' effect fields")
}
