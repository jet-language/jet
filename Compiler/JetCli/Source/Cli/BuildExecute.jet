// `jet build` runs the graph its `build: fn` declared (spec "Programmable
// builds") as one graph of steps and targets. The session's steps lower onto
// the one hermetic executor (Jetpack/CLI/Source/Build), which runs the ready
// ones together in the native sandbox against the local action cache
// (`JET_STORE_DIR`); every grant is checked and every probe run before
// anything runs. Each run records the graph it built and how long each part
// took under `.jet/build`.
use {
    cli_files: core.files
    build_crypto: core.crypto
    cli_sys: core.sys
    cli_time: core.time
    core.build.[BuildGraph, BuildGraphAction]
    jet_build_session.[BUILD_SESSION_HOST_DIR, BUILD_SESSION_IMAGE_DIR, BuildPlanExecution, BuildPlanSelection, BuildSessionAction, BuildSessionFile, BuildSessionTarget, BuildSessionToolchain]
    jet_driver.[JetDriverAuthorityPolicy, JetDriverAuthorizedSourceFile, JetDriverBuildKept, JetDriverBuildTime, JetDriverFailure, JetDriverGeneratedModule, JetDriverVerbOutput, JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USER_ERROR, jet_driver_build_graph_json, jet_driver_build_times_json]
    jet_foundation.[BuildOptions, Diagnostic, build_option_duration_ms, build_options_value, diagnostic_from_registry, diagnostic_registry_row, diagnostic_render_all]
    jet_pkg_model.[OverlayPolicy, WorkspaceDeclarationCache, pkg_build_entry_source, pkg_parse_workspace_policy, pkg_resolve_workspace_source]
    jetpack_build.[
        ActionOutcome, ActionSpec, BuildArtifactStoreHandle, BuildExecutionError, BuildProbeFact, BuildProvenance, ContentDigest,
        HermeticActionHandle, HermeticBuildContext, HermeticBuildError, HermeticBuildPlan, LinkerIdentity, ProbeHandle,
        ProbeSpec, SDKIdentity, SigningIdentityHandle, SigningIdentitySpec, SysrootIdentity, TargetRef, TargetSpec,
        ToolchainHandle, ToolchainSpec, build_action_failure_stderr, build_execute_actions, build_execute_probes, build_execution_batches,
    ]
    jetpack_foundation.[BuildEffect]
}

// Whether `source` declares the build entry `build: fn(b: Build)`, as the
// Driver's build query selects it (jet_driver_query_build_plan); any other
// top-level `build: fn` is ordinary code.
jet_cli_declares_build_entry: fn(source: String) -> Bool Never! {
    lines: source.split("\n").to_list()
    loop line in jet_cli_top_level_function_lines(source, "build") {
        if line < 1 || line > lines.len() -> next
        if lines[line - 1].split_once("build: fn(") == .Val(opened) && opened.after.split_once(")") == .Val(params) && params.before.split_once(":") == .Val(typed) {
            if !typed.before.contains(",") && typed.after.trim() == "Build" -> return true
        }
    }
    false
}

// Whether the package enclosing `file` declares its build entry in another of
// its source files or in `package.jet` (spec "Programmable builds": the entry
// may live in any package source file or in `package.jet`; the build query
// selects it). A package root or source tree that does not resolve is left to
// the compile, which reports why.
jet_cli_package_declares_build_entry: fn(file: String) -[FS, Env]> Bool Never! {
    cache := WorkspaceDeclarationCache.new()
    found := String?{None}
    if jet_cli_find_package_root_checked(cache, jet_cli_parent(file) ?? ".") == {
        .Ok(value) -> found = value
        .Err(_) -> return false
    }
    root: found ?? return false
    files := [JetDriverAuthorizedSourceFile]{}
    if jet_cli_package_sources(root, files) != None -> return false
    loop source_file in files {
        if jet_cli_declares_build_entry(source_file.source) -> return true
    }
    manifest: jet_cli_checked_file(root, JET_CLI_PACKAGE_FILE) ?? return false
    source: cli_files.read(manifest) ?? return false
    pkg_build_entry_source(source) != None
}

// One node of the graph a package build runs: a step (`id` its action), an
// executable compiled to its image (`id` its target; selected, or one whose
// image a step reads), a selected library checked (`id` its index in the
// selection's list), or a target only steps run, built for the machine
// running the build (`id` its target). `name` is the step's or target's own;
// `needs` are the nodes that finish before it starts.
JetCLIBuildNode: struct {
    kind: JetCLIBuildNodeKind
    id: Int
    name: String
    needs: [Int]
}

JetCLIBuildNodeKind: enum {
    Step
    Image
    Library
    Host
}

// The steps a build runs, the targets it builds for the machine running it
// (`b.host`), and the targets whose image a step reads (`b.image`); the
// steps use each such target whether or not it is selected.
JetCLIBuildNeeds: struct {
    steps: [Int]
    host: [Int]
    images: [Int]
}

// Run the graph `build: fn` declared under the project root `root`, as one
// graph of steps and targets: the selected targets, the steps they need and
// their prerequisites, and every target a step runs as its `b.host` tool or
// reads as its `b.image`.
// Every step's effects are granted (by the package `policy`, the enclosing
// workspace's build policy and this invocation) and every probe ran before
// anything else does. Then whatever has its inputs ready runs: the ready
// steps together in the native sandbox, up to `threads` at once, and each
// ready target compiles (an executable, into its image and, when a step runs
// it, its host copy, or reads its image, a copy at `.jet/build/image/`) or is
// checked (a library). A failure stops only what
// waits on it, and every failure is reported. `member` names the workspace
// member a workspace build runs this graph for; its invocation grant is
// None. A step without its own time limit gets the `action_timeout` option.
// `receipt` is the graph's core.build projection, which the run records. An
// output kept in git (`kept: true`) may replace a file no build made; the
// last build's receipt tells a hand edit of one from the bytes it wrote.
jet_cli_build_run_graph: fn(graph: BuildPlanExecution, receipt: BuildGraph, selected: BuildPlanSelection, root: String, policy: JetDriverAuthorityPolicy?, invocation: JetCLIInvocationAuthority?, member: String?, options: BuildOptions, threads: Int?, generated: [JetDriverGeneratedModule], trace_sink: JetCLITraceSink?, color: Bool) -> JetDriverVerbOutput {
    action_timeout_ms: build_option_duration_ms(build_options_value(options, "action_timeout")) ?? panic("the resolved `action_timeout` is a checked duration")
    if graph.actions.len() == 0 && graph.probes.len() == 0 {
        nodes := [JetCLIBuildNode]{}
        loop index in 0..<selected.executables.len() -> nodes.push(JetCLIBuildNode{kind: .Image, id: selected.executables[index].target, name: selected.executables[index].name.copy(), needs: [Int]{}})
        loop index in 0..<selected.libraries.len() -> nodes.push(JetCLIBuildNode{kind: .Library, id: index, name: selected.libraries[index].name.copy(), needs: [Int]{}})
        return jet_cli_build_run_nodes(nodes, None, None, [BuildEffect]{}, [BuildProbeFact]{}, graph, receipt, selected, JetCLIBuildNeeds{steps: [Int]{}, host: [Int]{}, images: [Int]{}}, root, member, options, threads, invocation, generated, [String: String]{}, trace_sink, color)
    }
    workspace := OverlayPolicy.empty()
    // copy: `refused` is a payload view of the policy read's result.
    if jet_cli_build_workspace_policy(workspace, root) == .Val(refused) -> return jet_cli_build_policy_refused(refused.copy(), color)
    last: jet_cli_build_last(root)
    plan: jet_cli_build_hermetic_plan(graph, action_timeout_ms, last.kept) ?? return jet_cli_ice("the checked build plan does not lower to the executor's graph: {err.debug_text()}")
    prereqs: plan.action_prereqs() ?? return jet_cli_ice("the checked build plan is not a valid executor graph: {err.debug_text()}")
    needs: jet_cli_build_needs(graph, plan, selected, prereqs) ?? return jet_cli_ice("the checked build plan is not a valid executor graph: {err.debug_text()}")
    nodes: jet_cli_build_nodes(graph, selected, needs, prereqs)
    cycle: jet_cli_build_cycle(nodes)
    if cycle.len() > 0 {
        return jet_cli_build_execution_failed("E3502", "these steps and targets each wait on another of them, so none can start: {cycle.join(", ")}", None, "a step can't run a tool built from its own output; build the tool from sources no step it feeds makes", color)
    }
    if needs.host.len() > 0 && !(cli_sys.is_linux() && cli_sys.arch() == "x86_64") {
        tool: graph.targets[needs.host[0]].name
        return jet_cli_build_execution_failed("E3502", "step tool `b.host({tool})` must build `{tool}` for this machine ({cli_sys.name()} {cli_sys.arch()}), and the native backend writes Linux x86-64 images only", None, "run this build on Linux x86-64", color)
    }
    // A `build: fn` builds Linux x86-64 images (a web build of one is refused
    // before its plan), which a step's sandbox runs only on such a machine.
    if !(cli_sys.is_linux() && cli_sys.arch() == "x86_64") {
        loop step in needs.steps {
            tool: graph.files[graph.actions[step].tool]
            if tool.kind != "image" -> next
            name: graph.targets[tool.target ?? panic("an image names its target")].name
            return jet_cli_build_execution_failed("E3502", "step `{graph.actions[step].name}` runs `b.image({name})`, a Linux x86-64 image, which a step's sandbox on this machine ({cli_sys.name()} {cli_sys.arch()}) can't run", None, "run this build on Linux x86-64", color)
        }
    }
    // copy: `overwritten` is a payload view of the check's result.
    if jet_cli_build_overwrite(root, graph, needs.steps, last.made) == .Val(overwritten) {
        return jet_cli_build_execution_failed("E3502", overwritten.copy(), None, "move the file, declare the step's output at another path, or keep the file in git with `.output(path, kept: true)`", color)
    }
    grants: jet_cli_build_grants(policy, workspace, invocation)
    loop step in needs.steps {
        action: plan.actions[step]
        loop cap in action.caps {
            if !grants.contains(cap) -> return jet_cli_build_execution_error(BuildExecutionError.MissingGrant{action: action.name, capability: cap}, member, color)
        }
    }
    probe_ids := plan.selected_probe_ids() ?? return jet_cli_ice("the checked build plan is not a valid executor graph: {err.debug_text()}")
    loop step in needs.steps {
        loop probe in plan.actions[step].probes {
            if !probe_ids.contains(probe.id) -> probe_ids.push(probe.id)
        }
    }
    loop target in needs.host {
        loop probe in graph.targets[target].probes {
            if !probe_ids.contains(probe) -> probe_ids.push(probe)
        }
    }
    probe_ids.sort()
    if probe_ids.len() > 0 && !grants.contains(BuildEffect.Exec) {
        return jet_cli_build_execution_error(BuildExecutionError.MissingGrant{action: "probe {plan.probes[probe_ids[0]].name}", capability: BuildEffect.Exec}, member, color)
    }
    probes: build_execute_probes(plan, probe_ids) ?? return jet_cli_build_execution_error(err, member, color)
    // A file of a listed package (`b.dependency(name).file(path)`) is copied
    // to its `.jet/deps/<name>/` path, where a step's sandbox reads it; a
    // folder of one is bound there in the sandbox instead.
    loop file in graph.files {
        if file.kind == "folder" -> next
        from: file.from ?? next
        to: jet_cli_entry_join(root, file.path)
        folder: jet_cli_parent(to) ?? root
        cli_files.create_dir_all(folder) ?? return jet_cli_build_failed("couldn't create `{folder}` for the package files steps read: {err}", jet_cli_why("E2105"), "make `{folder}` writable", color)
        cli_files.copy2(from, to) ?? return jet_cli_build_failed("couldn't copy the package file `{from}` a step reads: {err}", jet_cli_why("E2105"), "correct the path given to `.file(path)` on `b.dependency(name)`", color)
    }
    store := BuildArtifactStoreHandle?{None}
    if needs.steps.len() > 0 {
        store = Val(BuildArtifactStoreHandle.open() ?? return jet_cli_build_execution_failed("E3505", "couldn't open the build store: {err.message()}", None, "point `JET_STORE_DIR` at a writable store directory", color))
    }
    jet_cli_build_run_nodes(nodes, Val(plan), store, grants, probes, graph, receipt, selected, needs, root, member, options, threads, invocation, generated, last.kept, trace_sink, color)
}

// Run `nodes` to the end: each round runs every ready step at once, then
// builds one ready target, until nothing more can start. A node waiting on a
// failed one never starts. Every failure is reported, in the order it
// happened. Then the run records `receipt`, with each step's reuse, the
// digest of each kept output (`last_kept` the last build's), and the time of
// every node that ran (jet_cli_build_record).
jet_cli_build_run_nodes: fn(nodes: [JetCLIBuildNode], plan: HermeticBuildPlan?, store: BuildArtifactStoreHandle?, grants: [BuildEffect], probes: [BuildProbeFact], graph: BuildPlanExecution, receipt: BuildGraph, selected: BuildPlanSelection, needs: JetCLIBuildNeeds, root: String, member: String?, options: BuildOptions, threads: Int?, invocation: JetCLIInvocationAuthority?, generated: [JetDriverGeneratedModule], last_kept: [String: String], trace_sink: JetCLITraceSink?, color: Bool) -> JetDriverVerbOutput {
    jobs: threads ?? cli_sys.cpu_count()
    // Per node: 0 waiting, 1 done, 2 failed, 3 never started.
    states := [Int]{}
    loop _ in nodes -> states.push(0)
    failures := [JetDriverVerbOutput]{}
    times := [JetDriverBuildTime]{}
    // Per step that ran: whether the store gave back its outputs.
    reused := [Int: Bool]{}
    loop {
        ready_steps := [Int]{}
        ready_target := -1
        loop index in 0..<nodes.len() {
            if states[index] != 0 -> next
            blocked := false
            waiting := false
            loop need in nodes[index].needs {
                if states[need] >= 2 -> blocked = true
                if states[need] == 0 -> waiting = true
            }
            if blocked {
                states[index] = 3
                next
            }
            if waiting -> next
            if nodes[index].kind == .Step -> ready_steps.push(nodes[index].id) else if ready_target < 0 -> ready_target = index
        }
        if ready_steps.len() > 0 {
            executor: plan ?? panic("a build with steps lowered them to the executor")
            artifacts: store ?? panic("a build with steps opened the build store")
            loop batch in build_execution_batches(executor, ready_steps) {
                watch: cli_time.start()
                results: build_execute_actions(executor, batch, root, artifacts, grants, probes, jobs)
                wall: watch.elapsed_millis()
                loop index in 0..<batch.len() {
                    node: jet_cli_build_step_node(nodes, batch[index])
                    restored := false
                    if results[index] == {
                        .Ok(outcome) -> {
                            states[node] = 1
                            restored = outcome == .RestoredFromCache
                            reused[batch[index]] = restored
                        }
                        .Err(error) -> {
                            states[node] = 2
                            failures.push(jet_cli_build_execution_error(error, member, color))
                        }
                    }
                    times.push(JetDriverBuildTime{name: nodes[node].name.copy(), kind: "step", wall_ms: wall, reused: restored})
                }
            }
            next
        }
        if ready_target < 0 -> break
        watch: cli_time.start()
        built: jet_cli_build_target_node(nodes[ready_target], graph, selected, needs, root, options, threads, invocation, generated, trace_sink, color)
        times.push(JetDriverBuildTime{name: nodes[ready_target].name.copy(), kind: jet_cli_build_node_kind(nodes[ready_target].kind), wall_ms: watch.elapsed_millis(), reused: built.reused})
        if built.exit_code == JET_DRIVER_EXIT_OK -> states[ready_target] = 1 else {
            states[ready_target] = 2
            failures.push(built)
        }
    }
    kept: jet_cli_build_kept(root, graph, reused, last_kept)
    if jet_cli_build_record(root, receipt, reused, kept, times, color) == .Val(unrecorded) -> failures.push(unrecorded)
    jet_cli_build_failures(failures)
}

// The `kind` a node's BuildTime row names.
jet_cli_build_node_kind: fn(kind: JetCLIBuildNodeKind) -> String Never! {
    if kind == {
        .Step -> "step"
        .Image -> "image"
        .Library -> "library"
        .Host -> "host"
    }
}

// Write the run's records under `<root>/.jet/build`: `receipt.json`, the
// core.build graph it built, each step that ran marked a cache hit when
// `reused` says the store gave back its outputs and a miss when it ran, then
// `kept`; and `times.json`, its BuildTimes. A record that can't be written is
// the failure returned.
jet_cli_build_record: fn(root: String, receipt: BuildGraph, reused: [Int: Bool], kept: [JetDriverBuildKept], times: [JetDriverBuildTime], color: Bool) -[FS]> JetDriverVerbOutput? Never! {
    graph := receipt.copy()
    hits := [BuildGraphAction]{}
    loop index in 0..<graph.actions.len() {
        hit: reused.get(graph.actions[index].id) ?? next
        action := graph.actions[index].copy()
        action.cache_hit = Val(hit)
        if hit -> hits.push(action.copy())
        graph.actions[index] = action
    }
    graph.cache_hits = hits
    directory: jet_cli_entry_join(root, ".jet/build")
    fix: "make `{directory}` writable"
    cli_files.create_dir_all(directory) ?? return Val(jet_cli_build_failed("couldn't create `{directory}` for the build's records: {err}", jet_cli_why("E2105"), fix, color))
    receipt_path: cli_files.join(directory, "receipt.json")
    cli_files.write(receipt_path, jet_driver_build_graph_json(graph, kept)) ?? return Val(jet_cli_build_failed("couldn't write the build receipt `{receipt_path}`: {err}", jet_cli_why("E2105"), fix, color))
    times_path: cli_files.join(directory, "times.json")
    cli_files.write(times_path, jet_driver_build_times_json(times)) ?? return Val(jet_cli_build_failed("couldn't write the build times `{times_path}`: {err}", jet_cli_why("E2105"), fix, color))
    None
}

// The digest of each output the graph keeps in git, for the receipt: the
// bytes on disk for a step that finished this run (`reused` names those), the
// last build's (`last_kept`) for one that didn't run.
jet_cli_build_kept: fn(root: String, graph: BuildPlanExecution, reused: [Int: Bool], last_kept: [String: String]) -[FS]> [JetDriverBuildKept] Never! {
    kept := [JetDriverBuildKept]{}
    loop (id, action) in graph.actions {
        loop path in action.kept {
            digest := last_kept.get(path)
            if reused.get(id) != None && cli_files.read_bytes(jet_cli_entry_join(root, path)) == .Ok(bytes) -> digest = Val(ContentDigest.from_bytes(bytes).as_str())
            if digest == .Val(held) -> kept.push(JetDriverBuildKept{path: path.copy(), digest: held.copy()})
        }
    }
    kept
}

// What the last build's receipt says: every step output it made, and the
// digest of each kept output's bytes as it left them. Both are empty before
// any build has recorded one.
JetCLIBuildLast: struct {
    made: [String]
    kept: [String: String]
}

jet_cli_build_last: fn(root: String) -[FS]> JetCLIBuildLast Never! {
    last := JetCLIBuildLast{made: [String]{}, kept: [String: String]{}}
    receipt_text: cli_files.read(jet_cli_entry_join(root, ".jet/build/receipt.json")) ?? ""
    if jet_cli_status_value_parse(receipt_text) == .Ok(receipt) {
        actions: jet_cli_status_list(jet_cli_status_get(receipt, "actions")) ?? [JetCLIStatusValue]{}
        loop action in actions {
            outputs: jet_cli_status_list(jet_cli_status_get(action, "outputs")) ?? [JetCLIStatusValue]{}
            loop output in outputs {
                if jet_cli_status_string(Val(output)) == .Val(path) -> last.made.push(path.copy())
            }
        }
        rows: jet_cli_status_list(jet_cli_status_get(receipt, "kept")) ?? [JetCLIStatusValue]{}
        loop row in rows {
            path: jet_cli_status_string(jet_cli_status_get(row, "path")) ?? next
            digest: jet_cli_status_string(jet_cli_status_get(row, "digest")) ?? next
            last.kept[path] = digest
        }
    }
    last
}

// What refuses the run when a step in `steps` would overwrite a file the
// build didn't make, such as a committed one, as generated sources are
// refused (jet_cli_generated_shadow): an output may replace only a file the
// last build's receipt lists as a step's output (`made`), or one the step
// keeps in git. None when no step would.
jet_cli_build_overwrite: fn(root: String, graph: BuildPlanExecution, steps: [Int], made: [String]) -[FS]> String? Never! {
    loop step in steps {
        loop output in graph.actions[step].outputs {
            path: jet_cli_entry_join(root, output)
            if made.contains(output) || graph.actions[step].kept.contains(output) || !(cli_files.exists(path) || cli_files.is_symlink(path)) -> next
            return Val("step `{graph.actions[step].name}` would overwrite `{output}`, a file no build made")
        }
    }
    None
}

jet_cli_build_step_node: fn(nodes: [JetCLIBuildNode], action: Int) -> Int Never! {
    loop index in 0..<nodes.len() {
        if nodes[index].kind == .Step && nodes[index].id == action -> return index
    }
    panic("a step that ran has no node")
}

// Compile or check one target node. An executable a step runs also gets its
// host copy, built for this machine: the cross options (`os`, `min_os`) are
// the host's and every other option follows the build. When the build
// selects the host's own platform, the image and host copy are the same
// file, built once. An executable whose image a step reads (`b.image`) gets a
// copy of it at `.jet/build/image/<name>`; a host-only node builds no image.
jet_cli_build_target_node: fn(node: JetCLIBuildNode, graph: BuildPlanExecution, selected: BuildPlanSelection, needs: JetCLIBuildNeeds, root: String, options: BuildOptions, threads: Int?, invocation: JetCLIInvocationAuthority?, generated: [JetDriverGeneratedModule], trace_sink: JetCLITraceSink?, color: Bool) -> JetDriverVerbOutput {
    if node.kind == .Library {
        library: selected.libraries[node.id]
        source_path: jet_cli_entry_join(root, library.source)
        source: cli_files.read(source_path) ?? return jet_cli_build_failed("couldn't read the target source `{source_path}`: {err}", jet_cli_why("E2105"), "correct the source path given to `b.add_library`", color)
        return jet_cli_check_library(source_path, source, library.sources, generated, color, threads, trace_sink)
    }
    target: node.id
    row: graph.targets[target]
    source_path: jet_cli_entry_join(root, row.sources[0])
    source: cli_files.read(source_path) ?? return jet_cli_build_failed("couldn't read the target source `{source_path}`: {err}", jet_cli_why("E2105"), "correct the source path given to `b.add_executable`", color)
    host_dir: jet_cli_entry_join(root, BUILD_SESSION_HOST_DIR)
    host_options := jet_cli_build_options_set(options, "output_dir", host_dir)
    host_options = jet_cli_build_options_set(host_options, "os", "linux")
    host_options = jet_cli_build_options_set(host_options, "min_os", "")
    if node.kind == .Host -> return jet_cli_compile_target(source_path, row.name, source, row.sources, generated, color, host_options, threads, invocation, trace_sink)
    built: jet_cli_compile_target(source_path, row.name, source, row.sources, generated, color, options.copy(), threads, invocation, trace_sink)
    if built.exit_code != JET_DRIVER_EXIT_OK -> return built
    wants_host: needs.host.contains(target)
    cross: build_options_value(options, "os") != "linux" || build_options_value(options, "min_os") != ""
    if !needs.images.contains(target) && (!wants_host || cross) {
        if !wants_host -> return built
        return jet_cli_compile_target(source_path, row.name, source, row.sources, generated, color, host_options, threads, invocation, trace_sink)
    }
    // The image is where jet_cli_compile_target wrote it: under the source's
    // root (its package, else its folder) unless `output_dir` is absolute.
    source_dir: jet_cli_parent(cli_files.realpath(source_path) ?? source_path) ?? root
    cache := WorkspaceDeclarationCache.new()
    source_root := source_dir.copy()
    if jet_cli_find_package_root_checked(cache, source_dir) == .Ok(found) && found == .Val(package_root) -> source_root = package_root.copy()
    written: build_options_value(options, "output_dir")
    image_dir: if { written == "" -> "{source_root}/.jet/build" written.starts_with("/") -> written.copy() else -> "{source_root}/{written}" }
    image: cli_files.join(image_dir, row.name)
    if needs.images.contains(target) {
        copies_dir: jet_cli_entry_join(root, BUILD_SESSION_IMAGE_DIR)
        copied: cli_files.join(copies_dir, row.name)
        cli_files.create_dir_all(copies_dir) ?? return jet_cli_build_failed("couldn't create `{copies_dir}` for the images steps read: {err}", jet_cli_why("E2105"), "make `{copies_dir}` writable", color)
        cli_files.copy2(image, copied) ?? return jet_cli_build_failed("couldn't copy `{row.name}`'s image `{image}` to `{copied}`, where a step reads it: {err}", jet_cli_why("E2105"), "make `{copies_dir}` writable", color)
        cli_files.set_mode(copied, 493) ?? return jet_cli_build_failed("couldn't make `{copied}` executable: {err}", jet_cli_why("E2105"), "make `{copies_dir}` writable", color)
    }
    if !wants_host -> return built
    if cross -> return jet_cli_compile_target(source_path, row.name, source, row.sources, generated, color, host_options, threads, invocation, trace_sink)
    tool: cli_files.join(host_dir, row.name)
    cli_files.create_dir_all(host_dir) ?? return jet_cli_build_failed("couldn't create `{host_dir}` for the host copy of `{row.name}`: {err}", jet_cli_why("E2105"), "make `{host_dir}` writable", color)
    cli_files.copy2(image, tool) ?? return jet_cli_build_failed("couldn't copy `{row.name}`'s image to its host copy `{tool}`: {err}", jet_cli_why("E2105"), "make `{host_dir}` writable", color)
    cli_files.set_mode(tool, 493) ?? return jet_cli_build_failed("couldn't make the host copy `{tool}` executable: {err}", jet_cli_why("E2105"), "make `{host_dir}` writable", color)
    built
}

// `options` with the resolved value of row `name` replaced by `value`.
jet_cli_build_options_set: fn(options: BuildOptions, name: String, value: String) -> BuildOptions Never! {
    changed := options.copy()
    loop index in 0..<changed.values.len() {
        if changed.values[index].name == name {
            choice := changed.values[index].copy()
            choice.value = value.copy()
            changed.values[index] = choice
        }
    }
    changed
}

// One output reporting every failure of a build, or success.
jet_cli_build_failures: fn(failures: [JetDriverVerbOutput]) -> JetDriverVerbOutput Never! {
    if failures.len() == 1 -> return failures[0].copy()
    out := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    reports := [Diagnostic]{}
    loop failure in failures {
        out.stdout = "{out.stdout}{failure.stdout}"
        out.stderr = "{out.stderr}{failure.stderr}"
        if failure.exit_code > out.exit_code -> out.exit_code = failure.exit_code
        if failure.failure == .Val(failed) {
            loop report in failed.reports -> reports.push(report.copy())
        }
    }
    if failures.len() > 0 -> out.failure = Val(JetDriverFailure{reports: reports, notice: ""})
    out
}

// The steps a build runs: the selected ones, the ones each selected target
// needs, and their prerequisites; for each `b.host` tool a step runs and each
// `b.image` it reads, its target and the steps it needs. Steps ascending,
// targets in first use.
jet_cli_build_needs: fn(graph: BuildPlanExecution, plan: HermeticBuildPlan, selected: BuildPlanSelection, prereqs: [Int: [Int]]) -> JetCLIBuildNeeds HermeticBuildError! {
    steps := plan.selected_action_ids() ?? return Err(err)
    loop executable in selected.executables {
        loop step in jet_cli_build_target_steps(graph, executable.target) {
            if !steps.contains(step) -> steps.push(step)
        }
    }
    loop library in selected.libraries {
        loop step in jet_cli_build_target_steps(graph, library.target) {
            if !steps.contains(step) -> steps.push(step)
        }
    }
    host := [Int]{}
    images := [Int]{}
    pending := steps.copy()
    loop pending.len() > 0 {
        step: pending.pop() ?? break
        more := prereqs.get(step) ?? [Int]{}
        loop target in jet_cli_build_step_targets(graph, graph.actions[step], "host") {
            if host.contains(target) -> next
            host.push(target)
            loop need in jet_cli_build_target_steps(graph, target) -> more.push(need)
        }
        loop target in jet_cli_build_step_targets(graph, graph.actions[step], "image") {
            if images.contains(target) -> next
            images.push(target)
            loop need in jet_cli_build_target_steps(graph, target) -> more.push(need)
        }
        loop need in more {
            if !steps.contains(need) {
                steps.push(need)
                pending.push(need)
            }
        }
    }
    steps.sort()
    Ok(JetCLIBuildNeeds{steps, host, images})
}

// The targets whose `kind` build `action` reads: `host` for its `b.host`
// tools, `image` for the `b.image` files it reads.
jet_cli_build_step_targets: fn(graph: BuildPlanExecution, action: BuildSessionAction, kind: String) -> [Int] Never! {
    out := [Int]{}
    loop file in graph.files {
        if file.kind != kind || !action.inputs.contains(file.path) -> next
        target: file.target ?? next
        if !out.contains(target) -> out.push(target)
    }
    out
}

// The steps target `target` needs before it compiles: its own and its
// dependencies' actions, and the steps that make a source of any of them.
jet_cli_build_target_steps: fn(graph: BuildPlanExecution, target: Int) -> [Int] Never! {
    visited := [Int]{}
    pending := [Int]{target}
    loop pending.len() > 0 {
        current: pending.pop() ?? break
        if visited.contains(current) -> next
        visited.push(current)
        loop dep in graph.targets[current].deps -> pending.push(dep)
    }
    steps := [Int]{}
    loop current in visited {
        row: graph.targets[current]
        loop action in row.actions {
            if !steps.contains(action) -> steps.push(action)
        }
        loop index in 0..<graph.actions.len() {
            if steps.contains(index) -> next
            makes_source: loop output in graph.actions[index].outputs {
                if row.sources.contains(output) -> break true
            } ?? false
            if makes_source -> steps.push(index)
        }
    }
    steps
}

// The nodes of the build: the steps, the selected executables and
// libraries, then the unselected targets whose image a step reads, then the
// host-only targets, each with what it waits on.
jet_cli_build_nodes: fn(graph: BuildPlanExecution, selected: BuildPlanSelection, needs: JetCLIBuildNeeds, prereqs: [Int: [Int]]) -> [JetCLIBuildNode] Never! {
    nodes := [JetCLIBuildNode]{}
    step_nodes := [Int: Int]{}
    loop step in needs.steps {
        step_nodes[step] = nodes.len()
        nodes.push(JetCLIBuildNode{kind: .Step, id: step, name: graph.actions[step].name.copy(), needs: [Int]{}})
    }
    // The node that builds each executable target a step uses.
    target_nodes := [Int: Int]{}
    loop executable in selected.executables {
        target_nodes[executable.target] = nodes.len()
        nodes.push(JetCLIBuildNode{kind: .Image, id: executable.target, name: executable.name.copy(), needs: jet_cli_build_step_nodes(step_nodes, jet_cli_build_target_steps(graph, executable.target))})
    }
    loop index in 0..<selected.libraries.len() {
        library: selected.libraries[index]
        nodes.push(JetCLIBuildNode{kind: .Library, id: index, name: library.name.copy(), needs: jet_cli_build_step_nodes(step_nodes, jet_cli_build_target_steps(graph, library.target))})
    }
    loop target in needs.images {
        if target_nodes.get(target) != None -> next
        target_nodes[target] = nodes.len()
        nodes.push(JetCLIBuildNode{kind: .Image, id: target, name: graph.targets[target].name.copy(), needs: jet_cli_build_step_nodes(step_nodes, jet_cli_build_target_steps(graph, target))})
    }
    loop target in needs.host {
        if target_nodes.get(target) != None -> next
        target_nodes[target] = nodes.len()
        nodes.push(JetCLIBuildNode{kind: .Host, id: target, name: graph.targets[target].name.copy(), needs: jet_cli_build_step_nodes(step_nodes, jet_cli_build_target_steps(graph, target))})
    }
    loop step in needs.steps {
        index: step_nodes.get(step) ?? panic("a needed step has a node")
        waits := jet_cli_build_step_nodes(step_nodes, prereqs.get(step) ?? [Int]{})
        uses := jet_cli_build_step_targets(graph, graph.actions[step], "host")
        loop target in jet_cli_build_step_targets(graph, graph.actions[step], "image") -> uses.push(target)
        loop target in uses {
            made: target_nodes.get(target) ?? panic("a target a step uses has a node")
            if !waits.contains(made) -> waits.push(made)
        }
        node := nodes[index].copy()
        node.needs = waits
        nodes[index] = node
    }
    nodes
}

jet_cli_build_step_nodes: fn(step_nodes: [Int: Int], steps: [Int]) -> [Int] Never! {
    out := [Int]{}
    loop step in steps {
        node: step_nodes.get(step) ?? next
        if !out.contains(node) -> out.push(node)
    }
    out
}

// The names of the nodes that wait on each other in a cycle, and so on
// nothing that can finish; empty when every node can start.
jet_cli_build_cycle: fn(nodes: [JetCLIBuildNode]) -> [String] Never! {
    done := [Bool]{}
    loop _ in nodes -> done.push(false)
    progressed := true
    loop progressed {
        progressed = false
        loop index in 0..<nodes.len() {
            if done[index] -> next
            ready: loop need in nodes[index].needs {
                if !done[need] -> break false
            } ?? true
            if ready {
                done[index] = true
                progressed = true
            }
        }
    }
    names := [String]{}
    loop index in 0..<nodes.len() {
        if !done[index] {
            noun: if nodes[index].kind == .Step -> "step" else -> "target"
            names.push("{noun} `{nodes[index].name}`")
        }
    }
    names
}

// The build policy of the nearest workspace enclosing `root` into `policy`;
// none leaves it empty. The why of the refusal when that workspace's
// authority or its policy does not read: a build never runs under a policy it
// could not read.
jet_cli_build_workspace_policy: fn(policy: &OverlayPolicy, root: String) -[FS, Env]> String? Never! {
    cache := WorkspaceDeclarationCache.new()
    found: if jet_cli_find_workspace_root_checked(cache, root) == {
        .Ok(nearest) -> nearest
        .Err(error) -> { return Val("Workspace build policy above `{root}` is present but unavailable: {error.diagnostic.what}") }
    }
    workspace: found ?? return None
    resolved: if pkg_resolve_workspace_source(cache, workspace) == {
        .Ok(read) -> read
        .Err(error) -> { return Val("Workspace build policy in `{workspace}` is present but unavailable: {error.diagnostic.what}") }
    }
    source: resolved ?? return None
    parsed: pkg_parse_workspace_policy(source.source) ?? return Val("Workspace build policy in `{source.path}`: {err.message()}")
    policy.build_deny = parsed.build_deny
    policy.build_grants = parsed.build_grants
    None
}

// The build effects granted: the ambient basics and the package's
// `authority.allow`, the workspace's grant to this package, then `-A` and
// `--allow`. The package's and the invocation's `deny` and the workspace's
// `policy.deny` win over every grant.
jet_cli_build_grants: fn(policy: JetDriverAuthorityPolicy?, workspace: OverlayPolicy, invocation: JetCLIInvocationAuthority?) -> [BuildEffect] Never! {
    authority := jet_cli_policy_authority([String]{}, policy)
    subject: if policy == .Val(package) -> package.subject.copy() else -> ""
    granted := authority.granted.copy()
    loop grant in workspace.build_grants {
        if subject != "" && grant.subject == subject {
            loop right in jet_cli_policy_effects(grant.effects) -> granted.push(right)
        }
    }
    authority.granted = jet_cli_sorted_set(granted)
    jet_cli_with_invocation(authority, invocation)
    denied := authority.denied.copy()
    loop right in jet_cli_policy_effects(workspace.build_deny) -> denied.push(right)
    authority.denied = jet_cli_sorted_set(denied)
    allowed := [BuildEffect]{}
    effects: [BuildEffect]{BuildEffect.Net, BuildEffect.FS, BuildEffect.IO, BuildEffect.DB, BuildEffect.Time, BuildEffect.Rand, BuildEffect.Env, BuildEffect.Exec, BuildEffect.Log, BuildEffect.GPU}
    loop right in effects {
        if jet_cli_answer(authority, right.name()) == JetCLIVerdict.Allowed -> allowed.push(right)
    }
    allowed
}

// A workspace member's ungranted action is E3504: the command line grants the
// root build only, so the member's own authority and the workspace's grant to
// it are all it holds. The root build's is E3503.
jet_cli_build_execution_error: fn(error: BuildExecutionError, member: String?, color: Bool) -> JetDriverVerbOutput Never! {
    if error == {
        .MissingGrant(action, capability) -> {
            subject: if action.starts_with("probe ") -> "build probe `{action.slice(6..<action.len())}`" else -> "build action `{action}`"
            if member == .Val(name) -> return jet_cli_build_execution_failed("E3504", "{subject} of workspace member `{name}` asks for ungranted `{capability.name()}` authority", None, "grant `{capability.name()}` in `{name}`'s package authority or in the workspace's `policy: {{ grants: {{ \"{name}\": #({capability.name()}) }} }}`; `--allow` grants the root build only", color)
            jet_cli_build_execution_failed("E3503", "{subject} needs `{capability.name()}`, which this build does not grant", None, "grant it with `--allow={capability.name()}` or in package or workspace policy; `build: fn` declares the effect and makes the call inside `#Impure(\"reason\")`", color)
        }
        .SandboxUnavailable -> jet_cli_build_execution_failed("E3505", "build actions run only in the native sandbox, and none is available here", None, "install bubblewrap (`bwrap`) with user namespaces enabled; Jet never runs a build action outside the sandbox", color)
        .IO(action, detail) -> jet_cli_build_execution_failed("E3505", "build action `{action}` failed: {detail}", None, "fix the action's command, toolchain, or input and output declarations", color)
        .TimedOut(action, limit_ms) -> jet_cli_build_execution_failed("E3505", "build action `{action}` ran past its time limit of {limit_ms}ms and was stopped", None, "raise the limit with `.timeout(10min)` on the step, or the `action_timeout` build option for every step", color)
        .ProbeFailed(probe, detail) -> jet_cli_build_execution_failed("E3505", "build probe `{probe}` failed: {detail}", None, "install what the probe looks for, or declare it on the probe's toolchain", color)
        .FolderNotFound(probe, file, searched) -> {
            // Jet links static musl, so find_folder takes only musl's `libc.a`.
            musl: file == "libc.a"
            wanted: if musl -> "musl's static `libc.a`, with `crt1.o` beside it" else -> "`{file}`"
            fix: if musl -> "put the `lib` folder of a static musl on LIBRARY_PATH" else -> "put the folder holding `{file}` on LIBRARY_PATH"
            looked: loop folder in searched -> "  {folder}"
            jet_cli_build_execution_failed("E3505", "build probe `{probe}` found no folder holding {wanted}", Val("It looked in:\n{looked.join("\n")}"), fix, color)
        }
        .Reported(report) -> jet_cli_build_execution_failed("E3505", report.message, build_action_failure_stderr(report), "fix the command the action runs; its stderr follows", color)
        .InvalidGraph(graph) -> jet_cli_ice("the checked build plan is not a valid executor graph: {graph.debug_text()}")
        .HandEdited(action, path) -> jet_cli_build_execution_failed("E3502", "step `{action}` would overwrite `{path}`, which it keeps in git and which holds bytes no build wrote", None, "undo the edit (`git checkout -- {path}`) and change the step's inputs instead; the build rewrites `{path}` from them", color)
    }
}

// One build-execution report: `code`'s row Why, the given What and Fix, and
// `detail` (an action's stderr) printed as written.
jet_cli_build_execution_failed: fn(code: String, what: String, detail: String?, fix: String, color: Bool) -> JetDriverVerbOutput Never! {
    why: (diagnostic_registry_row(code) ?? panic("build execution code `{code}` has no registry row")).why
    jet_cli_build_refusal(code, what, why, detail, fix, color)
}

// The E3503 of a workspace build policy that does not read, `why` naming it.
jet_cli_build_policy_refused: fn(why: String, color: Bool) -> JetDriverVerbOutput Never! {
    what: (diagnostic_registry_row("E3503") ?? panic("E3503 has no registry row")).what
    jet_cli_build_refusal("E3503", what, why, None, "Fix the workspace build policy: `policy: {{ deny: #(…) }}` caps every package's build, and `policy: {{ grants: {{ \"package\": #(…) }} }}` grants one package", color)
}

jet_cli_build_refusal: fn(code: String, what: String, why: String, detail: String?, fix: String, color: Bool) -> JetDriverVerbOutput Never! {
    report := diagnostic_from_registry(code, None, what, why, fix)
    report.detail = detail
    reports: [Diagnostic]{report}
    JetDriverVerbOutput{stdout: "", stderr: diagnostic_render_all("", "", reports, color), exit_code: JET_DRIVER_EXIT_USER_ERROR, failure: Val(JetDriverFailure{reports: reports, notice: ""})}
}

// Where a `b.jet()` step finds the running compiler's folder, and the
// toolchain it runs on, named so no `b.toolchain` name can collide.
JET_CLI_BUILD_JET_MOUNT: "/jet/compiler"
JET_CLI_BUILD_JET_TOOLCHAIN: "(jet)"

// The executor's graph of the session plan: every declared toolchain, signing
// identity, probe, action and target in declaration order, so each session
// handle id is the executor handle id; the session's toolchain 0 is the
// executor's inferred host. A step whose tool is `b.jet()` runs on one more
// toolchain: the running compiler's folder (with its runtime pack and
// IDENTITY) mounted read-only, its one tool `jet`. That jet is this compiler,
// so the step gets this compiler's identity in `JET_COMPILER_IDENTITY`: an
// unpublished compiler has no IDENTITY file beside it. `last_kept` is the
// digest each kept output had when the last build left it.
jet_cli_build_hermetic_plan: fn(graph: BuildPlanExecution, action_timeout_ms: Int, last_kept: [String: String]) -> HermeticBuildPlan HermeticBuildError! {
    build := HermeticBuildContext.new()
    provenance: BuildProvenance.user_declared("fn build", None)
    toolchains := [ToolchainHandle]{build.default_host_toolchain()}
    loop index in 1..<graph.toolchains.len() {
        declared: graph.toolchains[index]
        toolchains.push(build.toolchain(declared.name, jet_cli_build_toolchain_spec(declared, provenance)))
    }
    runs_jet: loop action in graph.actions {
        if graph.files[action.tool].kind == "jet" -> break true
    } ?? false
    jet_identity := ""
    if runs_jet {
        compiler: cli_sys.executable()
        // A compiler without a named identity is known by its bytes; one it
        // can't read can't run the step either.
        jet_identity = jet_cli_compiler_identity() ?? build_crypto.sha256(cli_files.read_bytes(compiler) ?? [U8]{}).hex()
        spec: ToolchainSpec.host("host", provenance).with_read_only_mount_identity(jet_cli_executable_dir(), JET_CLI_BUILD_JET_MOUNT, jet_identity).with_tool("jet", "{JET_CLI_BUILD_JET_MOUNT}/{cli_files.basename(compiler)}").declared_only()
        toolchains.push(build.toolchain(JET_CLI_BUILD_JET_TOOLCHAIN, spec))
    }
    signing := [SigningIdentityHandle]{}
    loop identity in graph.signing -> signing.push(build.signing_identity(identity.name, SigningIdentitySpec.new(identity.label, provenance)))
    probes := [ProbeHandle]{}
    loop probe in graph.probes {
        spec: if probe.kind == {
            "find_program" -> ProbeSpec.find_program(probe.value)
            "find_folder" -> ProbeSpec.find_folder(probe.value)
            "pkg_config" -> ProbeSpec.pkg_config(probe.value)
            "header" -> ProbeSpec.header_check(probe.value)
            else -> ProbeSpec.compile_check(probe.value, [String]{}, probe.code)
        }
        probes.push(build.probe(probe.name, spec.with_toolchain(toolchains[probe.toolchain])))
    }
    actions := [HermeticActionHandle]{}
    loop action in graph.actions {
        runs_this_jet: graph.files[action.tool].kind == "jet"
        toolchain: if runs_this_jet -> toolchains[toolchains.len() - 1] else -> toolchains[action.toolchain]
        spec := jet_cli_build_action_spec(action, graph.files, toolchain, probes, signing, action_timeout_ms, last_kept)
        if runs_this_jet -> spec = spec.with_env(JET_CLI_COMPILER_IDENTITY_ENV, jet_identity)
        actions.push(build.action(action.name, spec))
    }
    targets := [TargetRef]{}
    loop target in graph.targets {
        spec := TargetSpec.new().with_toolchain(toolchains[target.toolchain])
        loop source in target.sources -> spec = spec.with_source(source)
        loop input in target.inputs -> spec = spec.with_input(input)
        loop output in target.outputs -> spec = spec.with_output(output)
        loop dep in target.deps -> spec = spec.with_dep(targets[dep])
        loop action in target.actions -> spec = spec.with_action(actions[action])
        loop probe in target.probes -> spec = spec.with_probe(probes[probe])
        if target.signing == .Val(identity) -> spec = spec.with_signing_identity(signing[identity])
        loop key in target.metadata.keys() -> spec = spec.with_metadata(key, target.metadata[key])
        added: jet_cli_build_add_target(build, target, spec)
        targets.push(added)
    }
    if graph.default >= 0 -> return build.plan_with_default(targets[graph.default])
    build.plan()
}

jet_cli_build_toolchain_spec: fn(declared: BuildSessionToolchain, provenance: BuildProvenance) -> ToolchainSpec Never! {
    spec := ToolchainSpec.target(declared.target_triple, provenance).with_host_triple(declared.host_triple)
    if declared.sdk == .Val(sdk) -> spec = spec.with_sdk(SDKIdentity.new(sdk, "declared", provenance))
    if declared.linker == .Val(linker) -> spec = spec.with_linker(LinkerIdentity.new(linker, provenance))
    if declared.sysroot == .Val(sysroot) -> spec = spec.with_sysroot(SysrootIdentity.new(sysroot, "declared", provenance))
    spec
}

jet_cli_build_action_spec: fn(action: BuildSessionAction, files: [BuildSessionFile], toolchain: ToolchainHandle, probes: [ProbeHandle], signing: [SigningIdentityHandle], action_timeout_ms: Int, last_kept: [String: String]) -> ActionSpec Never! {
    spec := ActionSpec.cached(action.argv).with_inputs(action.inputs).with_outputs(action.outputs).with_toolchain(toolchain).with_timeout_ms(action.timeout_ms ?? action_timeout_ms)
    loop path in action.kept -> spec = spec.with_kept(path, last_kept.get(path))
    loop id in action.folders {
        file: files[id]
        if file.probe == .Val(probe) -> spec = spec.with_found_folder(file.path, probes[probe]) else -> spec = spec.with_folder(file.path, file.from)
    }
    loop program in action.programs -> spec = spec.with_found_program(program.at, program.flag, probes[program.probe])
    loop cap in action.caps {
        if BuildEffect.parse(cap) == .Val(parsed) -> spec = spec.with_cap(parsed)
    }
    loop probe in action.probes -> spec = spec.with_probe(probes[probe])
    if action.signing == .Val(identity) -> spec = spec.with_signing_identity(signing[identity])
    spec
}

jet_cli_build_add_target: fn(build: &HermeticBuildContext, target: BuildSessionTarget, spec: TargetSpec) -> TargetRef HermeticBuildError! {
    if target.kind == {
        "executable" -> build.add_executable(target.name, spec)
        "library" -> build.add_library(target.name, spec)
        "test" -> build.add_test(target.name, spec)
        "asset-bundle" -> build.add_asset_bundle(target.name, spec)
        "doc" -> build.add_doc(target.name, spec)
        "install" -> build.add_install(target.name, spec)
        "package" -> build.add_package(target.name, spec)
        else -> build.add_publish(target.name, spec)
    }
}

#Test("the build entry is the colon declaration `build: fn(b: Build)`") {
    assert(jet_cli_declares_build_entry("build: fn(b: Build) {{}}\n"))
    assert(!jet_cli_declares_build_entry("build: fn(n: Int) {{}}\n"))
}
