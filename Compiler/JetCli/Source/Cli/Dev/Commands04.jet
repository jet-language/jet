}
// Rust: Source/CmdDevTools.rs:5755
fn data_bind_io_error(format: String, path: String, operation: String, why: String) -> Never {
    emit_cli_report("E2105", "Could not {operation} {format} bindings at {path}.", "{why}.", "check the input and output paths, permissions, and available disk space, then rerun `jet inspect bind {format}`.", false)
    exit(ExitCodes.USER_ERROR)
}
// Rust: Source/CmdDevTools.rs:5766
fn data_bind_output_collision(format: String, input_path: String, output_path: String) -> Never {
    emit_cli_report("E2104", "the default {format} binding output `{output_path}` is already in use", "sanitizing `{input_path}` produces the same output name as an existing binding", "rerun with `-o <different-output>` to choose an explicit path", false)
    exit(ExitCodes.USER_ERROR)
}
// Rust: Source/CmdDevTools.rs:5777
fn run_cpp_bind(args: [String]) -> {
    usage :: () -> { eprintln("usage: {Syntax.BINARY_NAME} inspect bind cpp <header.hpp> --target <triple> --clang <absolute-path> --ar <absolute-path> [--pkg <lib>] [--namespace <name>] [--instantiate <qualified=type:jet-name>] [-I <dir>] [-L <dir>] [-l <lib>] [-o <out.jet>]") }
    if args.is_empty() || CLI.is_help_flag(args[0]) { usage(); exit(if args.is_empty() { ExitCodes.USAGE } else { ExitCodes.OK }) }
    header :: args[0]
    pkg: String? := .None
    out: String? := .None
    target: String? := .None
    clang: String? := .None
    archiver: String? := .None
    include_dirs := [OSPath]{}
    library_dirs := [OSPath]{}
    libraries := [String]{}
    namespaces := [String]{}
    templates := [CppBind.TemplateInstantiation]{}
    index := 1
    while index < args.len() {
        if args[index] == {
            "--pkg" -> { pkg = args.get(index + 1).map(v -> v.clone()); if pkg.is_none() { usage(); exit(ExitCodes.USAGE) }; index += 2 }
            "-o" | "--out" -> { out = args.get(index + 1).map(v -> v.clone()); if out.is_none() { usage(); exit(ExitCodes.USAGE) }; index += 2 }
            "--target" -> { target = args.get(index + 1).map(v -> v.clone()); if target.is_none() { usage(); exit(ExitCodes.USAGE) }; index += 2 }
            "--clang" -> { clang = args.get(index + 1).map(v -> v.clone()); if clang.is_none() { usage(); exit(ExitCodes.USAGE) }; index += 2 }
            "--ar" -> { archiver = args.get(index + 1).map(v -> v.clone()); if archiver.is_none() { usage(); exit(ExitCodes.USAGE) }; index += 2 }
            "-I" -> { value :: args.get(index + 1) ?? { usage(); exit(ExitCodes.USAGE) }; include_dirs.push(OSPath.new(value)); index += 2 }
            "-L" -> { value :: args.get(index + 1) ?? { usage(); exit(ExitCodes.USAGE) }; library_dirs.push(OSPath.new(value)); index += 2 }
            "-l" -> { value :: args.get(index + 1) ?? { usage(); exit(ExitCodes.USAGE) }; libraries.push(value.clone()); index += 2 }
            "--namespace" -> { value :: args.get(index + 1) ?? { usage(); exit(ExitCodes.USAGE) }; namespaces.push(value.clone()); index += 2 }
            "--instantiate" -> {
                value :: args.get(index + 1) ?? { usage(); exit(ExitCodes.USAGE) }
                (qualified_name, rest) :: value.split_once('=') ?? { usage(); exit(ExitCodes.USAGE) }
                (cpp_types, jet_name) :: rest.rsplit_once(':') ?? { usage(); exit(ExitCodes.USAGE) }
                templates.push(CppBind.TemplateInstantiation { qualified_name: qualified_name.to_string(), cpp_args: cpp_types.split(',').map(v -> v.to_string()).collect(), jet_name: jet_name.to_string() })
                index += 2
            }
            flag -> { cli_error("E2102", "unknown `inspect bind cpp` flag `{flag}`"); usage(); exit(ExitCodes.USAGE) }
        }
    }
    selected_target :: target ?? { usage(); exit(ExitCodes.USAGE) }
    selected_clang :: clang ?? { usage(); exit(ExitCodes.USAGE) }
    selected_archiver :: archiver ?? { usage(); exit(ExitCodes.USAGE) }
    lib :: pkg ?? { base := header.rsplit('/').next() ?? header; (base.rsplit_once('.').map(v -> v.0) ?? base).to_ascii_lowercase() }
    out_path :: out ?? default_binding_output(header, Syntax.CPP_MODULE_ROOT, lib)
    cache :: OSPath.new(out_path).parent().filter(path -> !path.as_os_str().is_empty()) ?? OSPath.new(".")
    canonicalize :: (path: OSPath) -> fs.canonicalize(&path) ?? cpp_bind_error(header, "could not resolve selected native path `{path.display()}` ({err})")
    options :: CppBind.BindOptions { lib: lib.clone(), target: ^selected_target, clang: canonicalize(OSPath.new(selected_clang)), archiver: canonicalize(OSPath.new(selected_archiver)), include_dirs: include_dirs.into_iter().map(canonicalize).collect(), library_dirs: library_dirs.into_iter().map(canonicalize).collect(), libraries: ^libraries, namespaces: ^namespaces, templates: ^templates }
    result :: CppBind.bind(OSPath.new(header), cache, &options) ?? cpp_bind_error(header, err.to_string())
    fs.write(OSPath.new(out_path), result.source) ?? cpp_bind_error(header, "the generated cache could not be written ({err})")
    fs.write(cache.join("{lib}.provenance"), result.provenance) ?? cpp_bind_error(header, "the provenance could not be written ({err})")
    suffix :: if result.bound.len() == 1 { "" } else { "s" }
    println("bound {result.bound.len()} C++ member{suffix} from `{header}` → {out_path}")
}
