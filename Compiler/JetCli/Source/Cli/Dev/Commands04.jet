}
// Rust: Source/CmdDevTools.rs:5586
fn run_data_bind(format: String, args: [String]) -> {
    usage :: () -> { eprintln("usage: {Syntax.BINARY_NAME} inspect bind {format} <input> [--type <Type>] [-o <output>]") }
    if args.is_empty() || CLI.is_help_flag(args[0]) { usage(); exit(if args.is_empty() { ExitCodes.USAGE } else { ExitCodes.OK }) }
    input_path :: args[0]
    root_type: String? := .None
    output: String? := .None
    index := 1
    while index < args.len() {
        if args[index] == {
            "--type" -> {
                value :: args.get(index + 1) ?? { cli_error("E2102", "inspect bind {format} requires a value after --type"); usage(); exit(ExitCodes.USAGE) }
                if value.is_empty() { cli_error("E2102", "inspect bind {format} type name cannot be empty"); usage(); exit(ExitCodes.USAGE) }
                root_type = .Val(value.clone())
                index += 2
            }
            "-o" | "--out" -> {
                value :: args.get(index + 1) ?? { cli_error("E2102", "inspect bind {format} requires a value after -o"); usage(); exit(ExitCodes.USAGE) }
                if value.is_empty() { cli_error("E2102", "inspect bind {format} output path cannot be empty"); usage(); exit(ExitCodes.USAGE) }
                output = .Val(value.clone())
                index += 2
            }
            other -> { cli_error("E2102", "unknown inspect bind {format} argument {other}"); usage(); exit(ExitCodes.USAGE) }
        }
    }
    input :: fs.read_to_string(OSPath.new(input_path)) ?? data_bind_io_error(format, input_path, "read", "the input could not be read ({err})")
    default_output :: output.is_none()
    output_path :: output.clone() ?? {
        base := input_path.rsplit(ch -> ch == '/' || ch == '\\').next() ?? input_path // #4303
        stem := base.rsplit_once('.').map((stem, _) -> stem) ?? base // #4303
        safe :: Syntax.sanitize_generated_name(stem, Syntax.NameCase.Snake, "schema")
        selected_project_root_for_path(input_path).join(".jet").join("bindings").join("{safe}.{Syntax.FILE_EXT}").display().to_string()
    }
    command := [Syntax.BINARY_NAME.to_string(), "inspect", "bind", format.clone(), input_path.clone()]
    if root_type :: root_type { command.push("--type"); command.push(root_type.clone()) }
    if output :: output { command.push("-o"); command.push(output.clone()) }
    command_text :: command.join(" ")
    result :: CBind.generate_data(format, input_path, input, root_type, command_text) ?? data_bind_error(format, input_path, err)
    if default_output {
        // GATE #4409: distinguish missing output from other native IO failures.
        existing :: fs.read_to_string(OSPath.new(output_path)).map(value -> .Val(value)) ?? {
            if err.kind() != io.ErrorKind.NotFound { data_bind_io_error(format, output_path, "inspect", "the existing output could not be checked ({err})") }
            .None
        }
        if existing :: existing {
            generated_command :: result.source.lines().find(line -> line.starts_with("// generated by: "))
            existing_command :: existing.lines().find(line -> line.starts_with("// generated by: "))
            if generated_command != existing_command { data_bind_output_collision(format, input_path, output_path) }
        }
    }
    if parent :: OSPath.new(output_path).parent() {
        if !parent.as_os_str().is_empty() { fs.create_dir_all(parent) ?? data_bind_io_error(format, output_path, "create", "could not create output directory {parent.display()} ({err})") }
    }
    fs.write(OSPath.new(output_path), result.source) ?? data_bind_io_error(format, output_path, "write", "could not write {output_path} ({err})")
    suffix :: if result.record_count == 1 { "" } else { "s" }
    println("bound {result.record_count} {format} record{suffix} from {input_path} → {output_path}")
}
