// Rust: Source/CmdDevTools.rs:5466
fn update_binding_package_config(package_path: OSPath, name: String?, shape: Bindgen.BindingShape?, policy: Bindgen.BindingPolicy?) -> Err! {
    source := fs.read_to_string(package_path).unwrap_or_default()
    if name :: name {
        if shape :: shape {
            if !source.contains("bindings:") {
                source.push_str("\n\nbindings: .{\n")
                shape_name :: if shape == { .Automatic -> "Automatic"; .Native -> "Native" }
                frozen :: policy == .Val(Bindgen.BindingPolicy.Frozen)
                source.push_str("    {name}: .{{ shape: .{shape_name}, frozen: {frozen} }}\n")
                source.push_str("}\n")
            } else if !source.contains("{name}:") { source.push_str("\n// binding plan: {name} shape={shape.as_str()}\n") }
        }
    }
    if policy :: policy {
        if !source.contains("bindings: .{") || !source.contains("policy:") {
            policy_name :: if policy == { .Automatic -> "Automatic"; .Frozen -> "Frozen" }
            source.push_str("\n\npolicy: .{{ bindings: .{policy_name} }}\n")
        }
    }
    if source.trim().is_empty() { return Err("`{package_path.display()}` is not a package manifest") }
    fs.write(package_path, source) ?? return Err("could not write `{package_path.display()}`: {err}")
}
// Rust: Source/CmdDevTools.rs:5513
fn read_c_bind_overlay(path: String, lib: String) -> CBind.HandleOverlay Err! {
    source :: fs.read_to_string(OSPath.new(path)) ?? return Err("the overlay file could not be read ({err})")
    (tokens, lex_diagnostics) :: Lexer.lex(source)
    if !lex_diagnostics.is_empty() { return Err("the overlay has lexer diagnostics: {lex_diagnostics:#?}") }
    program :: Parser.parse_with_source(tokens, source) ?? return Err("the overlay has parser diagnostics: {err:#?}")
    overlay := CBind.HandleOverlay.default()
    found := false
    for item in program.items {
        if item == {
            .CModule(c_module) -> {
                if c_module.kind != AST.CModuleKind.Extern { continue }
                if c_module.lib != lib { return Err("the overlay declares `c.{c_module.lib}` but this bind targets `c.{lib}`") }
                found = true
                for function in c_module.functions {
                    if (close, _) :: function.close {
                        if function.return_type == { .Val(AST.Type.Named(handle)) -> { overlay.close_functions.insert(handle.clone(), close.clone()) }; else -> {} }
                    }
                }
            }
            else -> {}
        }
    }
    if !found { return Err("the overlay has no `#Import module c.{lib} {{ … }}` block") }
    overlay
}
// Rust: Source/CmdDevTools.rs:5560
fn bind_e3208(what: String, why: String, fix: String) -> Never {
    emit_cli_report("E3208", what, why, fix, false)
    exit(ExitCodes.USER_ERROR)
}
