fn selected_project_root_for_path(path: String) -> OSPath {
    build_project_root(path) ?? {
        source :: fs.read_to_string(OSPath.new(path)).unwrap_or_default()
        eprint(render_diagnostics(path, source, &err))
        exit(ExitCodes.USER_ERROR)
    }
}
