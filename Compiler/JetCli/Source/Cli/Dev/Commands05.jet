// Rust: Source/CmdDevTools.rs:8553
pub fn run_lint_complexity(file: String, mode: OutputMode, max_budget: U32?) -> Void {
    src :: fs.read_to_string(file) ?? {
        cli_error_fix("E2105", "can't find the file `{file}`", "check the spelling, or run {jet.Syntax.BINARY_NAME} from the folder that contains it")
        exit(ExitCodes.USER_ERROR)
    }
    diags :: jet.check_with_path(file)
    errors :: diags.iter().filter(fn(d) -> d.severity == .Error).cloned().collect()
    if !errors.is_empty() -> { report_problems(mode, file, src, errors); exit(ExitCodes.USER_ERROR) }
    (source_for_parse, _) :: jet.Package.mask_inline_package_source(src) ?? {
        report_problems(mode, file, src, [err.diagnostic()])
        exit(ExitCodes.USER_ERROR)
    }
    (tokens, lex_errors) :: jet.Lexer.lex(source_for_parse)
    if !lex_errors.is_empty() -> { report_problems(mode, file, src, lex_errors); exit(ExitCodes.USER_ERROR) }
    program :: jet.Parser.parse_with_source(tokens, source_for_parse) ?? {
        report_problems(mode, file, src, err)
        exit(ExitCodes.USER_ERROR)
    }
    reports :: Sema.cognitive_complexity_reports(program)
    rows :: reports.iter().map(fn(report) -> {
        line :: src.slice(0..<report.span.start).bytes().filter(fn(byte) -> byte == 10).count() + 1
        (line, max_budget.is_some_and(fn(budget) -> report.score > budget))
    }).collect()
    if mode.json {
        json_rows :: reports.iter().zip(rows).map(fn(pair) -> {
            report :: pair.0
            (line, over) :: pair.1
            budget :: max_budget.map(fn(value) -> value.to_string()) ?? "null"
            "{{\"file\":{json_string(file)},\"fn\":{json_string(report.name)},\"line\":{line},\"score\":{report.score},\"budget\":{budget},\"over\":{over}}}"
        }).collect()
        if max_budget.is_none() {
            inspection :: collect_architecture_inspection(file)
            envelope := StatusEnvelope.new("lint.complexity", true).with_field("contract", ARCH_ADVICE_SCHEMA).with_field("file", file).with_field("local_complexity", complexity_rows_value(file, reports, rows)).with_field("architecture_advice", architecture_inspection_value(inspection)).with_field("measurement", StatusValue.object(StatusFields.new().with("benchmark", "not_run").with("change_task", "not_measured").with("claim", "none")))
            if inspection.check == .Val(check) -> envelope = envelope.with_field("check", check.clone())
            println("{envelope.json()}")
        } else -> println("[{json_rows.join(",")}]")
    } else {
        loop (report, pair) in reports.iter().zip(rows) {
            line :: pair.0
            if max_budget == .Val(budget) -> println("{file}:{line} fn {report.name} — score {report.score} (budget {budget})")
            else -> println("{file}:{line} fn {report.name} — score {report.score}")
        }
        if max_budget.is_none() -> render_architecture_inspection(collect_architecture_inspection(file))
    }
    budget :: max_budget ?? return
    exceeded :: reports.iter().filter(fn(report) -> report.score > budget).map(fn(report) -> jet.Diagnostics.Diagnostic.lint("L2902", "function `{report.name}` has cognitive complexity {report.score} above budget {budget}", "the function's control flow is harder to read and maintain than the selected budget allows", "split the function, reduce nesting, or replace mixed control flow with a focused helper", .Val(report.span))).collect()
    if exceeded.is_empty() -> return
    if !mode.json -> core.term.eprint(jet.render_all_colored(file, src, exceeded, mode.color_stderr()))
    exit(ExitCodes.USER_ERROR)
}
