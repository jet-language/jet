        if flag == "--copybook" {
            copybook = args.get(i + 1).map(fn(v) -> v.to_string())
            if copybook.is_none() -> { usage(); exit(ExitCodes.USAGE) }
        } else if flag == "--pkg" {
            pkg = args.get(i + 1).map(fn(v) -> v.to_string())
            if pkg.is_none() -> { usage(); exit(ExitCodes.USAGE) }
        } else if flag == "-o" || flag == "--out" {
            out = args.get(i + 1).map(fn(v) -> v.to_string())
            if out.is_none() -> { usage(); exit(ExitCodes.USAGE) }
        } else -> { cli_error("E2102", "unknown `inspect bind cobol` flag `{flag}`"); usage(); exit(ExitCodes.USAGE) }
        i += 2
    }
    copybook_path :: copybook ?? { usage(); exit(ExitCodes.USAGE) }
    base :: source_path.rsplit("/").next() ?? source_path
    lib :: pkg ?? (base.rsplit_once(".").map(fn(v) -> v.0) ?? base).to_ascii_lowercase().replace("-", "_")
    source :: fs.read_to_string(source_path) ?? cobol_bind_error(source_path, "the program could not be read ({err})")
    copybook :: fs.read_to_string(copybook_path) ?? cobol_bind_error(copybook_path, "the copybook could not be read ({err})")
    out_path :: out ?? default_binding_output(source_path, jet.Syntax.COBOL_MODULE_ROOT, lib)
    cache :: OSPath.new(out_path).parent() ?? OSPath.new(".")
    result :: jet.CobolBind.bind(OSPath.new(source_path), source, OSPath.new(copybook_path), copybook, lib, cache) ?? cobol_bind_error(source_path, err.to_string())
    fs.write(out_path, result.source) ?? cobol_bind_error(source_path, "the generated cache could not be written ({err})")
    fs.write(cache.join("{lib}.provenance"), result.provenance) ?? cobol_bind_error(source_path, "the binding provenance could not be written ({err})")
    fs.write(cache.join("{lib}.cobol-path"), "{result.runtime_dir.display()}\n") ?? cobol_bind_error(source_path, "the libcob runtime identity could not be written ({err})")
    println("bound GnuCOBOL program `{result.program}` and {result.layout.width}-byte copybook `{result.layout.name}` → {out_path}")
    loop field in result.layout.fields -> println("  layout: {field.name} offset={field.offset} width={field.width} type={field.kind.jet_type()}")
}
