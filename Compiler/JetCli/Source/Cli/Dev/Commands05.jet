// Rust: Source/CmdDevTools.rs:7220
fn run_com_bind(args: &[String]) -> Void {
    usage :: fn() -> eprintln("usage: {jet.Syntax.BINARY_NAME} inspect bind com <library.tlb> --pkg <lib>\n       {jet.Syntax.BINARY_NAME} inspect bind com --registered <guid> --major <n> --minor <n> [--lcid <n>] --pkg <lib>")
    // GATE #4483: COM is dispatched by selected OS.
    if core.sys.target.selected_os() != "windows" {
        eprintln("Error [E3260]: `com.*` needs a Windows host.")
        eprintln(" Why: COM type libraries, apartments, and IDispatch are Windows facilities.")
        eprintln(" Fix: run `jet inspect bind com` and build the COM module on a Windows host.")
        eprintln("More: jet-lang.dev/e/E3260")
        exit(ExitCodes.USER_ERROR)
    }
    if args.is_empty() || jet.CLI.is_help_flag(args[0]) {
        usage()
        exit(if args.is_empty() -> ExitCodes.USAGE else -> ExitCodes.OK)
    }
    file := String?{None}
    guid := String?{None}
    major := U16?{None}
    minor := U16?{None}
    lcid := 0 as U32
    pkg := String?{None}
    i := 0
    loop i < args.len() {
        if args[i] == {
            "--registered" -> { guid = args.get(i + 1).map(fn(v) -> v.to_string()); i += 2 }
            "--major" -> { major = args.get(i + 1).and_then(fn(v) -> U16.parse(v).ok()); i += 2 }
            "--minor" -> { minor = args.get(i + 1).and_then(fn(v) -> U16.parse(v).ok()); i += 2 }
            "--lcid" -> { lcid = args.get(i + 1).and_then(fn(v) -> U32.parse(v).ok()) ?? U32.MAX; i += 2 }
            "--pkg" -> { pkg = args.get(i + 1).map(fn(v) -> v.to_string()); i += 2 }
            "-o" -> {
                cli_error("E2102", "`inspect bind com` writes the checked binding to `.jet/bindings/com`; custom output paths are not supported")
                usage(); exit(ExitCodes.USAGE)
            }
            "--out" -> {
                cli_error("E2102", "`inspect bind com` writes the checked binding to `.jet/bindings/com`; custom output paths are not supported")
                usage(); exit(ExitCodes.USAGE)
            }
            value -> {
                if !value.starts_with("-") && file.is_none() -> { file = .Val(value.to_string()); i += 1 }
                else -> { usage(); exit(ExitCodes.USAGE) }
            }
        }
    }
    lib :: pkg ?? { usage(); exit(ExitCodes.USAGE) }
    binding_root_path :: file ?? "package.jet"
    input :: if file == .Val(path) -> {
        if guid.is_some() -> { usage(); exit(ExitCodes.USAGE) }
        jet.ComBind.TypeLibraryInput.File(OSPath.new(path))
    } else -> {
        guid :: guid ?? { usage(); exit(ExitCodes.USAGE) }
        major :: major ?? { usage(); exit(ExitCodes.USAGE) }
        minor :: minor ?? { usage(); exit(ExitCodes.USAGE) }
        if lcid == U32.MAX -> { usage(); exit(ExitCodes.USAGE) }
        jet.ComBind.TypeLibraryInput.Registered(guid: guid, major: major, minor: minor, lcid: lcid)
    }
    out_path :: default_binding_output(binding_root_path, jet.Syntax.COM_MODULE_ROOT, lib)
    cache :: OSPath.new(out_path).parent() ?? OSPath.new(".")
    result :: jet.ComBind.bind(input, lib, cache) ?? com_bind_error(err.to_string())
    provenance_path :: cache.join("{lib}.provenance")
    publish_com_binding_artifacts(OSPath.new(out_path), result.source, provenance_path, result.provenance) ?? com_bind_error(err)
    suffix :: if result.methods.len() == 1 -> "" else -> "s"
    println("bound {result.methods.len()} typed COM member{suffix} → {out_path}")
}
// Rust: Source/CmdDevTools.rs:7338
fn com_bind_error(why: String) -> Never {
    bind_e3208("Could not generate COM bindings.", "{why}.", "select a registered or file-backed type library with IDispatch metadata and rerun on Windows.")
}
// Rust: Source/CmdDevTools.rs:7345
// Publish source and provenance as a recoverable pair, rolling both back on failure.
fn publish_com_binding_artifacts(source_path: &OSPath, source: String, provenance_path: &OSPath, provenance: String) -> Void Err! {
    if source_path == provenance_path -> return Err("generated COM source and provenance paths must differ")
    // GATE #4494: native process identity, timestamp, metadata and rename.
    nanos :: (SystemTime.now().duration_since(UNIX_EPOCH) ?? return Err("could not create COM output transaction: {err}")).as_nanos()
    suffix :: "{std.process.id()}-{nanos}"
    source_name :: source_path.file_name().and_then(fn(name) -> name.to_str()) ?? return Err("generated COM source has no valid file name")
    provenance_name :: provenance_path.file_name().and_then(fn(name) -> name.to_str()) ?? return Err("generated COM provenance has no valid file name")
    source_stage :: source_path.with_file_name(".{source_name}..com-stage-{suffix}")
    provenance_stage :: provenance_path.with_file_name(".{provenance_name}..com-stage-{suffix}")
    source_backup :: source_path.with_file_name(".{source_name}..com-previous-{suffix}")
    provenance_backup :: provenance_path.with_file_name(".{provenance_name}..com-previous-{suffix}")
    cleanup_staged :: fn() -> { _ :: fs.remove_file(source_stage); _ :: fs.remove_file(provenance_stage) }
    cleanup_backups :: fn() -> { _ :: fs.remove_file(source_backup); _ :: fs.remove_file(provenance_backup) }
    fs.write(source_stage, source) ?? { cleanup_staged(); return Err("the generated COM cache could not be staged ({err})") }
    fs.write(provenance_stage, provenance) ?? { cleanup_staged(); return Err("the COM provenance could not be staged ({err})") }
    // GATE #4409: only NotFound means an absent previous artifact.
    had_source :: if fs.symlink_metadata(source_path) == {
        .Ok(metadata) -> {
            if !metadata.file_type().is_file() -> { cleanup_staged(); return Err("the generated COM cache path is not a regular file") }
            fs.rename(source_path, source_backup) ?? { cleanup_staged(); return Err("could not stage the previous COM cache ({err})") }
            true
        }
        .Err(error) -> {
            if error.kind() == .NotFound -> false
            else -> { cleanup_staged(); return Err("could not inspect the generated COM cache ({error})") }
        }
    }
    had_provenance :: if fs.symlink_metadata(provenance_path) == {
        .Ok(metadata) -> {
            if !metadata.file_type().is_file() {
                if had_source -> _ :: fs.rename(source_backup, source_path)
                cleanup_staged()
                return Err("the generated COM provenance path is not a regular file")
            }
            fs.rename(provenance_path, provenance_backup) ?? {
                if had_source -> _ :: fs.rename(source_backup, source_path)
                cleanup_staged()
                return Err("could not stage the previous COM provenance ({err})")
            }
            true
        }
        .Err(error) -> {
            if error.kind() == .NotFound -> false
            else {
                if had_source -> _ :: fs.rename(source_backup, source_path)
                cleanup_staged()
                return Err("could not inspect the generated COM provenance ({error})")
            }
        }
    }
    fs.rename(source_stage, source_path) ?? {
        if had_source -> _ :: fs.rename(source_backup, source_path)
        if had_provenance -> _ :: fs.rename(provenance_backup, provenance_path)
        cleanup_staged()
        return Err("could not publish the generated COM cache ({err})")
    }
    fs.rename(provenance_stage, provenance_path) ?? {
        _ :: fs.remove_file(source_path)
        if had_source -> _ :: fs.rename(source_backup, source_path)
        if had_provenance -> _ :: fs.rename(provenance_backup, provenance_path)
        cleanup_staged()
        return Err("could not publish the COM provenance ({err})")
    }
    cleanup_staged()
    cleanup_backups()
}
// Rust: Source/CmdDevTools.rs:7489
fn run_java_bind(args: &[String]) -> Void {
    usage :: fn() -> eprintln("usage: {jet.Syntax.BINARY_NAME} inspect bind java <source.java> [--pkg <lib>] [-o <out.jet>]")
    if args.is_empty() || jet.CLI.is_help_flag(args[0]) -> { usage(); exit(if args.is_empty() -> ExitCodes.USAGE else -> ExitCodes.OK) }
    source_path :: args[0]
    pkg := String?{None}
    out := String?{None}
    i := 1
    loop i < args.len() {
        if args[i] == {
            "--pkg" -> {
                pkg = args.get(i + 1).map(fn(v) -> v.to_string())
                if pkg.is_none() -> { usage(); exit(ExitCodes.USAGE) }
                i += 2
            }
            "-o" -> {
                out = args.get(i + 1).map(fn(v) -> v.to_string())
                if out.is_none() -> { usage(); exit(ExitCodes.USAGE) }
                i += 2
            }
            "--out" -> {
                out = args.get(i + 1).map(fn(v) -> v.to_string())
                if out.is_none() -> { usage(); exit(ExitCodes.USAGE) }
                i += 2
            }
            flag -> { cli_error("E2102", "unknown `inspect bind java` flag `{flag}`"); usage(); exit(ExitCodes.USAGE) }
        }
    }
    base :: source_path.rsplit("/").next() ?? source_path
    lib :: pkg ?? (base.rsplit_once(".").map(fn(v) -> v.0) ?? base).to_string()
    source :: fs.read_to_string(source_path) ?? java_bind_error(source_path, "the source file could not be read ({err})")
    out_path :: out ?? default_binding_output(source_path, jet.Syntax.JAVA_MODULE_ROOT, lib)
    cache :: OSPath.new(out_path).parent() ?? OSPath.new(".")
    result :: jet.JavaBind.bind(OSPath.new(source_path), source, lib, cache) ?? java_bind_error(source_path, err.to_string())
    fs.write(out_path, result.source) ?? java_bind_error(source_path, "the generated cache could not be written ({err})")
    fs.write(cache.join("{lib}.jvm-path"), "{result.jvm_dir.display()}\n") ?? java_bind_error(source_path, "the JVM runtime identity could not be written ({err})")
    fs.write(cache.join("{lib}.provenance"), result.provenance) ?? java_bind_error(source_path, "the binding provenance could not be written ({err})")
    suffix :: if result.bound.len() == 1 -> "" else -> "s"
    println("bound {result.bound.len()} JVM member{suffix} from `{source_path}` → {out_path}")
}
// Rust: Source/CmdDevTools.rs:7584
fn java_bind_error(source: String, why: String) -> Never {
    bind_e3208("Could not generate bindings from `{source}`.", "{why}.", "use a public Java class with one public long/double constructor and non-overloaded long/double methods, then rerun `jet inspect bind java`.")
}

