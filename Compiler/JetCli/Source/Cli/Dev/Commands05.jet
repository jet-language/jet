// Rust: Source/CmdDevTools.rs:8277
pub fn run_emit_rust(file: String, mode: OutputMode, emit_metadata: Bool) -> Void {
    src :: fs.read_to_string(file) ?? {
        cli_error_fix("E2105", "can't find the file `{file}`", "check the spelling, or run {jet.Syntax.BINARY_NAME} from the folder that contains it")
        exit(ExitCodes.USER_ERROR)
    }
    (diagnostics, bundle, _) :: jet.Driver.check_file_with_effect_facts_for_run(file, "dev", [:])
    (errors, lints) :: diagnostics.into_iter().partition(fn(diagnostic) -> diagnostic.severity == .Error)
    if !errors.is_empty() -> { report_problems(mode, file, src, errors); exit(ExitCodes.USER_ERROR) }
    bundle :: bundle ?? { report_problems(mode, file, src, []); exit(ExitCodes.USER_ERROR) }
    lints :: visible_lints(lints)
    if !lints.is_empty() -> core.term.eprint(jet.render_all_colored(file, src, lints, mode.color_stderr()))
    // GATE #4494: canonical compiler-stack execution for recursive lowering.
    rust :: jet.with_compiler_stack(fn() -> {
        target :: if bundle.build_facts.target_triple.is_empty() -> jet_foundation.Layout.TargetLayout.host() else -> jet_foundation.Layout.TargetLayout.from_triple(bundle.build_facts.target_triple.clone())
        (mir, artifact) :: jet.lower_checked_semantic_mir_program_for(bundle, jet_foundation.MIR.MirArtifactRequest.new(.RustAot, .NativeExecutable, .Dev))
        mir_digest :: jet_foundation.MIR.mir_program_digest(mir)
        execution := jet.Codegen.MIRRust.MirRustExecutionConfig.for_artifact(artifact)
        execution.emit_metadata = emit_metadata
        execution.semantic_digest = if emit_metadata -> .Val(mir_digest) else -> None
        jet.Codegen.MIRRust.emit_mir_program(mir, jet.Codegen.MIRRust.MirRustConfig{target: target, target_kind: .Native, root_prefix: "", execution: execution})
    })
    core.term.print(rust)
}
// Rust: Source/CmdDevTools.rs:8348
pub fn cost_diagnostics(bundle: &AST.ProgramBundle, sema_diagnostics: &[jet.Diagnostics.Diagnostic]) -> [jet.Diagnostics.Diagnostic] jet.Codegen.TIR.TCostReportError! {
    report :: jet.Codegen.TIR.cost_report(bundle)?
    cost_diagnostics_from_report(report, sema_diagnostics)
}
// Rust: Source/CmdDevTools.rs:8356
fn cost_diagnostics_from_report(report: &jet.Codegen.TIR.TCostReport, sema_diagnostics: &[jet.Diagnostics.Diagnostic]) -> [jet.Diagnostics.Diagnostic] {
    diagnostics := sema_diagnostics.iter().filter(fn(diagnostic) -> is_cost_diagnostic(diagnostic)).cloned().collect()
    loop site in report.sites {
        if site.loop_depth > 0 && site.state == .SemanticRemainder && site.kind != .ViewMaterialization -> &diagnostics.push(jet.Diagnostics.Diagnostic.from_row("L2510", [("operation", site.kind.operation()), ("fix", site.kind.fix())], .Val(site.span)))
    }
    dedup_cost_diagnostics(&diagnostics)
    diagnostics
}
// Rust: Source/CmdDevTools.rs:8389
fn is_cost_diagnostic(diagnostic: &jet.Diagnostics.Diagnostic) -> Bool { diagnostic.code == "L2510" }
// Rust: Source/CmdDevTools.rs:8393
fn same_cost_diagnostic(left: &jet.Diagnostics.Diagnostic, right: &jet.Diagnostics.Diagnostic) -> Bool {
    left.code == right.code && left.severity == right.severity && left.span == right.span && left.what == right.what && left.why == right.why && left.fix == right.fix
}
// Rust: Source/CmdDevTools.rs:8405
fn dedup_cost_diagnostics(diagnostics: &[jet.Diagnostics.Diagnostic]) -> Void {
    seen := [jet.Diagnostics.Diagnostic]{}
    &diagnostics.retain(fn(diagnostic) -> {
        if !is_cost_diagnostic(diagnostic) -> return true
        if seen.iter().any(fn(previous) -> same_cost_diagnostic(previous, diagnostic)) -> return false
        &seen.push(diagnostic.clone())
        true
    })
}
// Rust: Source/CmdDevTools.rs:8423
pub fn merge_cost_diagnostics(bundle: &AST.ProgramBundle, diagnostics: &[jet.Diagnostics.Diagnostic]) -> Void jet.Codegen.TIR.TCostReportError! {
    dedup_cost_diagnostics(diagnostics)
    costs :: cost_diagnostics(bundle, diagnostics)?
    loop diagnostic in costs {
        if !diagnostics.iter().any(fn(existing) -> same_cost_diagnostic(existing, diagnostic)) -> &diagnostics.push(diagnostic)
    }
}
