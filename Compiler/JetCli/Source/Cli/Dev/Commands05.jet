fn run_cobol_bind(args: &[String]) -> Void {
    usage :: fn() -> eprintln("usage: {jet.Syntax.BINARY_NAME} inspect bind cobol <program.cob> --copybook <record.cpy> [--pkg <lib>] [-o <out.jet>]")
    if args.is_empty() || jet.CLI.is_help_flag(args[0]) -> { usage(); exit(if args.is_empty() -> ExitCodes.USAGE else -> ExitCodes.OK) }
    source_path :: args[0]
    copybook := String?{None}
    pkg := String?{None}
    out := String?{None}
