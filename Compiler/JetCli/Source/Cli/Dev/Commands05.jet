// Rust: Source/CmdDevTools.rs:8714
struct ArchitectureAdviceRow { kind: String, subject: String, scope: String, evidence: [ArchitectureSourceEvidence], boundaries: [String], behavior: [ArchitectureBehaviorCheck], uncertainty: [String] }
// Rust: Source/CmdDevTools.rs:8725
struct ArchitectureCall {
    caller_key: String, caller_name: String, caller_module: String, caller_span: (USize, USize),
    callee_key: String, callee_name: String, callee_module: String, callee_span: (USize, USize),
    callee_return: String?, call_span: (USize, USize),
}
// Rust: Source/CmdDevTools.rs:8740
struct ArchitectureInspection { status: String, check: StatusValue?, rows: [ArchitectureAdviceRow], reason: String? }
// Rust: Source/CmdDevTools.rs:8746
fn complexity_rows_value(file: String, reports: &[Sema.CognitiveComplexityReport], rows: &[(USize, Bool)]) -> StatusValue {
    StatusValue.array(reports.iter().zip(rows).map(fn(pair) -> StatusValue.object(StatusFields.new().with("file", file).with("fn", pair.0.name).with("line", pair.1.0).with("score", pair.0.score).with("budget", StatusValue.Null).with("over", pair.1.1))))
}
// Rust: Source/CmdDevTools.rs:8764
fn collect_architecture_inspection(file: String) -> ArchitectureInspection {
    projection :: CmdInspect.check_projection(OSPath.new(file)) ?? {
        reason :: err.iter().map(fn(diagnostic) -> "{diagnostic.code}: {diagnostic.what}").collect().join("; ")
        return ArchitectureInspection{status: "unavailable", check: None, rows: [], reason: .Val("the checked semantic projection was unavailable; no architecture claim was emitted ({reason})")}
    }
    check :: CmdInspect.check_result_value(projection.check)
    calls :: architecture_calls(projection.index())
    rows := architecture_advice_rows(projection.index(), calls)
    &rows.sort_by(fn(left, right) -> left.subject.cmp(right.subject).then(left.kind.cmp(right.kind)).then(left.scope.cmp(right.scope)))
    &rows.truncate(ARCH_ADVICE_MAX_ROWS)
    ArchitectureInspection{status: "advisory", check: .Val(check), rows: rows, reason: None}
}
// Rust: Source/CmdDevTools.rs:8801
fn architecture_calls(index: &jet_semindex.SemIndex) -> [ArchitectureCall] {
    calls := [ArchitectureCall]{}
    loop edge in index.call_edges() {
        caller :: index.definitions().iter().find(fn(definition) -> definition.module_path == edge.module_path && function_definition_matches(definition.name, edge.caller)) ?? next
        reference :: index.references().iter().filter(fn(reference) -> reference.module_path == edge.module_path && spans_overlap((reference.span.start, reference.span.end), (edge.call_span.start, edge.call_span.end)) && reference.target.is_some()).min_by_key(fn(reference) -> reference.span.end.saturating_sub(reference.span.start)) ?? next
        target :: reference.target ?? next
        callee :: index.definitions().iter().find(fn(definition) -> definition.module_path == target.module_path && definition.def_span.start == target.def_span.start && definition.def_span.end == target.def_span.end) ?? next
        callee_return :: if callee.kind == { .Function(_, ret, _) -> ret.clone(); _ -> next }
        &calls.push(ArchitectureCall{
            caller_key: definition_key(caller), caller_name: caller.qualified_name.clone(), caller_module: caller.module_path.clone(),
            caller_span: (caller.def_span.start, caller.def_span.end), callee_key: definition_key(callee),
            callee_name: callee.qualified_name.clone(), callee_module: callee.module_path.clone(),
            callee_span: (callee.def_span.start, callee.def_span.end), callee_return: callee_return,
            call_span: (edge.call_span.start, edge.call_span.end),
        })
    }
    calls
}
// Rust: Source/CmdDevTools.rs:8850
fn function_definition_matches(name: String, key: String) -> Bool {
    key == name || key.rsplit("::").next().is_some_and(fn(short) -> short == name)
}
// Rust: Source/CmdDevTools.rs:8854
fn definition_key(definition: &jet_semindex.SymbolDef) -> String {
    "{definition.module_path}:{definition.def_span.start}..{definition.def_span.end}"
}
// Rust: Source/CmdDevTools.rs:8861
fn spans_overlap(left: (USize, USize), right: (USize, USize)) -> Bool { left.0 <= right.1 && right.0 <= left.1 }
// Rust: Source/CmdDevTools.rs:8865
fn architecture_advice_rows(index: &jet_semindex.SemIndex, calls: &[ArchitectureCall]) -> [ArchitectureAdviceRow] {
    rows := [ArchitectureAdviceRow]{}
    seen := [String:Bool]{}
    by_callee := [String:[ArchitectureCall]]{}
    by_caller := [String:[ArchitectureCall]]{}
    loop call in calls {
        &by_callee.entry(call.callee_key.clone()).or_default().push(call.clone())
        &by_caller.entry(call.caller_key.clone()).or_default().push(call.clone())
    }
    callee_keys := by_callee.keys().cloned().collect()
    &callee_keys.sort()
    loop key in callee_keys {
        calls :: by_callee[key]
        callers := [String:Bool]{}
        loop call in calls -> &callers.insert(call.caller_key, true)
        if callers.len() < 2 -> next
        subject :: calls[0].callee_name.clone()
        key :: "shared-callee:{subject}"
        if seen.contains_key(key) -> next
        &seen.insert(key, true)
        &rows.push(make_architecture_advice_row(index, "shared-callee", subject, calls, "one checked callable is consumed by multiple callers; review whether they must preserve one invariant"))
    }
    caller_keys := by_caller.keys().cloned().collect()
    &caller_keys.sort()
    loop key in caller_keys {
        calls :: by_caller[key]
        callees := [String:Bool]{}
        return_types := [String:Bool]{}
        loop call in calls {
            &callees.insert(call.callee_key, true)
            if call.callee_return == .Val(ret) -> &return_types.insert(ret, true)
        }
        if callees.len() < 2 || return_types.len() != 1 -> next
        subject :: calls[0].caller_name.clone()
        key :: "consumer-agreement:{subject}"
        if seen.contains_key(key) -> next
        &seen.insert(key, true)
        &rows.push(make_architecture_advice_row(index, "consumer-agreement", subject, calls, "one checked consumer joins multiple same-result call paths; review whether their results must agree"))
    }
    rows
}
// Rust: Source/CmdDevTools.rs:8932
fn make_architecture_advice_row(index: &jet_semindex.SemIndex, kind: String, subject: String, calls: &[ArchitectureCall], note: String) -> ArchitectureAdviceRow {
    evidence := [ArchitectureSourceEvidence]{}
    evidence_keys := [String:Bool]{}
    boundary_set := [String:Bool]{}
    loop call in calls {
        &boundary_set.insert("{call.caller_module} -> {call.callee_module}", true)
        entries :: [("caller-definition", call.caller_module, call.caller_span), ("callee-definition", call.callee_module, call.callee_span), ("checked-call-site", call.caller_module, call.call_span)]
        loop (role, module_path, span) in entries {
            (start, end) :: span
            key :: "{role}:{module_path}:{start}:{end}"
            if !evidence_keys.contains_key(key) {
                &evidence_keys.insert(key, true)
                &evidence.push(ArchitectureSourceEvidence{role: role, module_path: module_path.to_string(), start: start, end: end})
            }
        }
    }
    &evidence.sort_by(fn(left, right) -> left.module_path.cmp(right.module_path).then(left.start.cmp(right.start)).then(left.role.cmp(right.role)))
    cross_module :: calls.iter().any(fn(call) -> call.caller_module != call.callee_module)
    scope :: if cross_module -> "cross-module" else -> "same-module"
    boundaries := boundary_set.keys().cloned().collect()
    loop call in calls {
        if index.effect_of(call.caller_name) == .Val(effect) {
            if !effect.inferred.is_empty() -> &boundaries.push("effects {call.caller_name}: {effect.inferred.join(", ")}")
        }
    }
    &boundaries.sort()
    &boundaries.dedup()
    ArchitectureAdviceRow{
        kind: kind, subject: subject, scope: scope, evidence: evidence, boundaries: boundaries,
        behavior: [
            ArchitectureBehaviorCheck{name: "checked_reference_resolution", status: "passed", detail: "the compiler semantic index resolved the definitions and call sites"},
            ArchitectureBehaviorCheck{name: "consumer_behavior", status: "not_run", detail: "this read-only inspection does not execute user code"},
            ArchitectureBehaviorCheck{name: "cross_mode_agreement", status: "unknown", detail: "no runtime or change-task receipt was supplied"},
        ],
        uncertainty: [note.to_string(), "the checked call graph proves references, not a business invariant", "operator review may reject this candidate; no refactor or policy is applied"],
    }
}
// Rust: Source/CmdDevTools.rs:9031
fn architecture_source_value(evidence: &ArchitectureSourceEvidence) -> StatusValue {
    StatusValue.object(StatusFields.new().with("role", evidence.role).with("module", evidence.module_path).with("span", StatusValue.object(StatusFields.new().with("start", evidence.start).with("end", evidence.end))))
}
// Rust: Source/CmdDevTools.rs:9047
fn architecture_row_value(row: &ArchitectureAdviceRow) -> StatusValue {
    behavior :: StatusValue.array(row.behavior.iter().map(fn(check) -> StatusValue.object(StatusFields.new().with("name", check.name).with("status", check.status).with("detail", check.detail))))
    StatusValue.object(StatusFields.new().with("kind", row.kind).with("subject", row.subject).with("scope", row.scope).with("source_evidence", StatusValue.array(row.evidence.iter().map(fn(evidence) -> architecture_source_value(evidence)))).with("affected_boundaries", StatusValue.array(row.boundaries.iter().map(fn(value) -> StatusValue.from(value)))).with("behavioral_checks", behavior).with("uncertainty", StatusValue.array(row.uncertainty.iter().map(fn(value) -> StatusValue.from(value)))).with("operator_action", "review_or_reject"))
}
// Rust: Source/CmdDevTools.rs:9078
fn architecture_inspection_value(inspection: &ArchitectureInspection) -> StatusValue {
    fields := StatusFields.new().with("status", inspection.status).with("rows", StatusValue.array(inspection.rows.iter().map(fn(row) -> architecture_row_value(row)))).with("operator_action", "review_or_reject")
    if inspection.reason == .Val(reason) -> fields = fields.with("reason", reason)
    StatusValue.object(fields)
}
// Rust: Source/CmdDevTools.rs:9092
fn render_architecture_inspection(inspection: &ArchitectureInspection) -> Void {
    println("architecture advice (D-ARCH-ADVICE1; advisory, operator may reject):")
    if inspection.reason == .Val(reason) -> println("  status: unavailable — {reason}")
    else if inspection.rows.is_empty() -> println("  no checked agreement candidate; local complexity is not proof of a cross-boundary invariant")
    else {
        loop row in inspection.rows {
            println("  {row.kind} `{row.subject}` [{row.scope}]")
            loop evidence in row.evidence -> println("    evidence: {evidence.role} {evidence.module_path}:{evidence.start}..{evidence.end}")
            loop boundary in row.boundaries -> println("    boundary: {boundary}")
            loop check in row.behavior -> println("    check: {check.name}={check.status} ({check.detail})")
            loop uncertainty in row.uncertainty -> println("    uncertainty: {uncertainty}")
        }
    }
    println("  measurement: benchmark/change-task not measured; no advantage claim")
}
// Rust: Source/CmdDevTools.rs:9130
pub struct BenchEvidence {
    name: String
    samples: [(U128, U64)]
    // Exact allocation events, requested bytes, iterations for each trial.
    // Calibration and warmup are outside the reset boundary.
    allocation_samples: [(U128, U128, U64)]
}

// Rust: Source/CmdDevTools.rs:9142
// Collect the twenty exact samples emitted by the canonical measurement harness.
pub fn collect_measure_evidence(file: String, src: String, mode: OutputMode, filter: String?) -> [BenchEvidence] {
    (rust_code, ffi_link) :: jet.compile_tests_with_path(src, file) ?? {
        report_problems(mode, file, src, err); exit(ExitCodes.USER_ERROR)
    }
    project_root :: jet.build_project_root(file) ?? {
        report_problems(mode, file, src, err); exit(ExitCodes.USER_ERROR)
    }
    bin :: project_root.join(".jet").join("build").join("test_measure_{stem(file)}")
    build(file, rust_code, None, bin.clone(), .Release, ffi_link, [], false, None, None, None, mode, false, None)
    // GATE #4494: native subprocess and environment, exact U128 sample parsing.
    command := Command.new(bin)
    &command.env("JET_TEST_MEASURE", "1").env("JET_TEST_MEASURE_EVIDENCE", "1")
    if filter == .Val(filter) -> &command.env("JET_TEST_FILTER", filter)
    output :: command.output() ?? {
        eprintln("measure: couldn't run `{bin.display()}`: {err}"); exit(ExitCodes.USER_ERROR)
    }
    if !output.stderr.is_empty() -> core.term.eprint(String.from_utf8_lossy(output.stderr))
    if !output.status.success() -> exit(CmdCompile.child_exit_code(output.status))
    stdout :: String.from_utf8(output.stdout) ?? {
        eprintln("measure: harness emitted non-UTF-8 evidence"); exit(ExitCodes.USER_ERROR)
    }
    evidence := [BenchEvidence]{}
    loop line in stdout.lines() {
        if line.strip_prefix("JETALLOC1\t") == .Val(wire) {
            fields := wire.split("\t")
            name :: fields.next().and_then(fn(value) -> decode_hex(value)) ?? {
                eprintln("measure: harness emitted malformed allocation identity"); exit(ExitCodes.USER_ERROR)
            }
            tier :: fields.next().filter(fn(value) -> !value.is_empty()) ?? {
                eprintln("measure: harness emitted no execution tier for allocation evidence"); exit(ExitCodes.USER_ERROR)
            }
            profile :: fields.next().filter(fn(value) -> !value.is_empty()) ?? {
                eprintln("measure: harness emitted no build profile for allocation evidence"); exit(ExitCodes.USER_ERROR)
            }
            warmups :: fields.next().and_then(fn(value) -> U64.parse(value).ok()).filter(fn(value) -> value > 0) ?? {
                eprintln("measure: harness emitted invalid warmup count for allocation evidence"); exit(ExitCodes.USER_ERROR)
            }
            iters :: fields.next().and_then(fn(value) -> U64.parse(value).ok()).filter(fn(value) -> value > 0) ?? {
                eprintln("measure: harness emitted invalid allocation iteration count"); exit(ExitCodes.USER_ERROR)
            }
            serial :: fields.next().and_then(fn(value) -> Bool.parse(value).ok()) ?? {
                eprintln("measure: harness emitted non-serial allocation evidence"); exit(ExitCodes.USER_ERROR)
            }
            if tier != "aot" || profile != "release" || warmups != 5 || !serial -> {
                eprintln("measure: harness emitted allocation evidence without the optimized serial AOT profile"); exit(ExitCodes.USER_ERROR)
            }
            samples := [(U128, U128, U64)]{}
            loop value in fields {
                (count, bytes) :: value.split_once(":") ?? {
                    eprintln("measure: harness emitted malformed allocation evidence"); exit(ExitCodes.USER_ERROR)
                }
                count :: U128.parse(count) ?? { eprintln("measure: harness emitted malformed allocation evidence"); exit(ExitCodes.USER_ERROR) }
                bytes :: U128.parse(bytes) ?? { eprintln("measure: harness emitted malformed allocation evidence"); exit(ExitCodes.USER_ERROR) }
                &samples.push((count, bytes, iters))
            }
            if samples.len() != 20 -> {
                eprintln("measure: harness emitted {samples.len()} allocation samples; policy requires 20"); exit(ExitCodes.USER_ERROR)
            }
            entry :: evidence.iter_mut().find(fn(entry) -> entry.name == name) ?? {
                eprintln("measure: allocation evidence preceded its named claim"); exit(ExitCodes.USER_ERROR)
            }
            entry.allocation_samples = ^samples
            next
        }
        wire :: line.strip_prefix("JETTESTMEASURE1\t") ?? next
        fields := wire.split("\t")
        name :: fields.next().and_then(fn(value) -> decode_hex(value)) ?? {
            eprintln("measure: harness emitted malformed claim identity"); exit(ExitCodes.USER_ERROR)
        }
        tier :: fields.next().filter(fn(value) -> !value.is_empty()) ?? {
            eprintln("measure: harness emitted no execution tier"); exit(ExitCodes.USER_ERROR)
        }
        profile :: fields.next().filter(fn(value) -> !value.is_empty()) ?? {
            eprintln("measure: harness emitted no build profile"); exit(ExitCodes.USER_ERROR)
        }
        warmups :: fields.next().and_then(fn(value) -> U64.parse(value).ok()).filter(fn(value) -> value > 0) ?? {
            eprintln("measure: harness emitted invalid warmup count"); exit(ExitCodes.USER_ERROR)
        }
        iters :: fields.next().and_then(fn(value) -> U64.parse(value).ok()).filter(fn(value) -> value > 0) ?? {
            eprintln("measure: harness emitted invalid iteration count"); exit(ExitCodes.USER_ERROR)
        }
        serial :: fields.next().and_then(fn(value) -> Bool.parse(value).ok()) ?? {
            eprintln("measure: harness emitted non-serial timing evidence"); exit(ExitCodes.USER_ERROR)
        }
        if tier != "aot" || profile != "release" || warmups != 5 || !serial -> {
            eprintln("measure: harness emitted timing evidence without the optimized serial AOT profile"); exit(ExitCodes.USER_ERROR)
        }
        samples := [(U128, U64)]{}
        loop value in fields {
            elapsed :: U128.parse(value) ?? { eprintln("measure: harness emitted invalid exact sample"); exit(ExitCodes.USER_ERROR) }
            &samples.push((elapsed, iters))
        }
        if samples.len() != 20 -> {
            eprintln("measure: harness emitted {samples.len()} samples; policy requires 20"); exit(ExitCodes.USER_ERROR)
        }
        &evidence.push(BenchEvidence{name: name, samples: samples, allocation_samples: []})
    }
    evidence
}
// Rust: Source/CmdDevTools.rs:9362
pub fn collect_service_evidence(root: &OSPath, specs: &[Sema.LocatedBudgetSpec]) -> [CmdBudget.ServiceEvidence] {
    service_names := [String:Bool]{}
    loop s in specs {
        kind :: s.spec.provider.split_once("(").map(fn(pair) -> pair.0) ?? s.spec.provider
        if kind == "ServiceProbe" -> &service_names.insert(s.spec.provider.split_once("(").and_then(fn(pair) -> pair.1.strip_suffix(")")) ?? "", true)
    }
    if service_names.is_empty() -> return []
    names := service_names.keys().cloned().collect()
    &names.sort()
    result := [CmdBudget.ServiceEvidence]{}
    loop name in names {
        argv :: ["__service-probe", name.clone(), "--no-color"]
        output :: EngineDispatch.capture(jet.Syntax.JETPACK_BINARY_NAME, "ServiceProbe", argv, root) ?? next
        if !output.status.success() {
            stderr := String.from_utf8_lossy(output.stderr).trim() // #4303
            eprintln("budget: ServiceProbe `{name}` measurement failed: {stderr}")
            next
        }
        stdout :: String.from_utf8(output.stdout) ?? {
            eprintln("budget: ServiceProbe `{name}` returned non-UTF-8 evidence"); next
        }
        expected_name :: name.bytes().map(fn(byte) -> "{byte:02x}").collect()
        rows := stdout.lines()
        row :: rows.next() ?? { eprintln("budget: ServiceProbe `{name}` returned no evidence"); next }
        if rows.next().is_some() -> { eprintln("budget: ServiceProbe `{name}` returned extra evidence rows"); next }
        fields := row.split("\t")
        if fields.next() != .Val("JETSERVICE1") || fields.next() != .Val(expected_name) -> {
            eprintln("budget: ServiceProbe `{name}` returned incompatible evidence"); next
        }
        samples_ns := [U64]{}
        malformed := false
        loop field in fields {
            value :: U64.parse(field) ?? { malformed = true; break }
            &samples_ns.push(value)
        }
        if malformed || samples_ns.len() != 20 -> { eprintln("budget: ServiceProbe `{name}` did not return exactly 20 samples"); next }
        &result.push(CmdBudget.ServiceEvidence{name: name.clone(), samples_ns: samples_ns})
    }
    result
}
// Rust: Source/CmdDevTools.rs:9454
pub fn collect_scene_evidence(file: String, src: String, mode: OutputMode, specs: &[Sema.LocatedBudgetSpec]) -> [CmdBudget.SceneEvidence] {
    scene_names := [String:Bool]{}
    loop s in specs {
        kind :: s.spec.provider.split_once("(").map(fn(pair) -> pair.0) ?? s.spec.provider
        if kind == "SceneProbe" -> &scene_names.insert(s.spec.provider.split_once("(").and_then(fn(pair) -> pair.1.strip_suffix(")")) ?? "", true)
    }
    if scene_names.is_empty() -> return []
    compiled :: jet.compile_with_path(src, file) ?? { report_problems(mode, file, src, err); return [] }
    project_root :: jet.build_project_root(file) ?? { report_problems(mode, file, src, err); return [] }
    bin :: project_root.join(".jet").join("build").join("scene_probe_{stem(file)}")
    build(file, compiled.rust, None, bin.clone(), .Release, compiled.ffi, [], false, None, None, None, mode, false, None)
    names := scene_names.keys().cloned().collect()
    &names.sort()
    result := [CmdBudget.SceneEvidence]{}
    loop scene_name in names {
        out :: Command.new(bin).env("JET_SCENE_PROBE", scene_name).output() ?? {
            eprintln("budget: SceneProbe `{scene_name}` run failed: {err}"); next
        }
        if !out.status.success() -> { eprintln("budget: SceneProbe `{scene_name}` exited with non-zero status"); next }
        stdout :: String.from_utf8(out.stdout) ?? ""
        frame_ns := [U64]{}
        draw_calls := [U64]{}
        asset_bytes := [U64]{}
        rss_hwm := [U64]{}
        expected_hex :: scene_name.bytes().map(fn(byte) -> "{byte:02x}").collect()
        loop line in stdout.lines() {
            wire :: line.strip_prefix("JETSCENE1\t") ?? next
            fields := wire.splitn(4, "\t")
            hex :: fields.next() ?? ""
            metric :: fields.next() ?? ""
            value_str :: fields.next() ?? ""
            if hex != expected_hex -> next
            value :: U64.parse(value_str) ?? {
                eprintln("budget: SceneProbe `{scene_name}` malformed value `{value_str}`"); next
            }
            if metric == {
                "FrameTime" -> &frame_ns.push(value)
                "DrawCalls" -> &draw_calls.push(value)
                "SceneAssetBytes" -> &asset_bytes.push(value)
                "MemoryHighWater" -> &rss_hwm.push(value)
                _ -> {}
            }
        }
        // Exactly 600 measured samples per metric; 120 warmup frames omitted.
        if frame_ns.len() != 600 || draw_calls.len() != 600 || asset_bytes.len() != 600 || rss_hwm.len() != 600 -> {
            eprintln("budget: SceneProbe `{scene_name}` emitted {frame_ns.len()}/{draw_calls.len()}/{asset_bytes.len()}/{rss_hwm.len()} samples; need 600 for each metric")
            next
        }
        &result.push(CmdBudget.SceneEvidence{name: scene_name.clone(), frame_ns: frame_ns, draw_calls: draw_calls, asset_bytes: asset_bytes, rss_hwm: rss_hwm})
    }
    result
}
// Rust: Source/CmdDevTools.rs:9597
pub fn run_devtools_probe(args: &[String]) -> Void {
    file :: args.first() ?? { eprintln("usage: jet devtools probe <file.jet>"); exit(ExitCodes.USAGE) }
    src :: fs.read_to_string(file) ?? { eprintln("probe: cannot read `{file}`: {err}"); exit(ExitCodes.USER_ERROR) }
    mode :: OutputMode{json: false, color: .Never, quiet: false}
    bundle := jet.Loader.load_entry(file) ?? { report_problems(mode, file, src, err); exit(ExitCodes.USER_ERROR) }
    _ :: Sema.check_bundle(&bundle, .Run)
    specs :: Sema.collect_located_budget_specs_bundle(bundle) ?? exit(ExitCodes.USER_ERROR)
    root :: OSPath.new(file).canonicalize().ok().and_then(fn(p) -> p.parent().map(fn(d) -> d.to_path_buf())).and_then(fn(d) -> .Val(jet.Loader.find_manifest_root(d) ?? d)) ?? OSPath.new(".")
    service_evidence :: collect_service_evidence(root, specs)
    scene_evidence :: collect_scene_evidence(file, src, mode, specs)
    status :: CmdBudget.run_dev_refresh(file, service_evidence, scene_evidence)
    exit(status)
}
// Rust: Source/CmdDevTools.rs:9646
fn decode_hex(value: String) -> String? {
    if value.len() % 2 != 0 -> return None
    nibble :: fn(byte: U8) -> U8? {
        if byte >= 48 && byte <= 57 -> return .Val(byte - 48)
        if byte >= 97 && byte <= 102 -> return .Val(byte - 97 + 10)
        None
    }
    bytes := [U8].with_capacity(value.len() / 2)
    loop pair in value.bytes().chunks_exact(2) {
        high :: nibble(pair[0]) ?? return None
        low :: nibble(pair[1]) ?? return None
        &bytes.push((high << 4) | low)
    }
    String.from_utf8(bytes).ok()
}

