// Rust: Source/CmdDevTools.rs:8031
pub fn run_eval(file: String, pure_required: Bool, mode: OutputMode) -> Void {
    src :: fs.read_to_string(file) ?? { cli_error("E2105", "couldn't read `{file}`: {err}"); exit(ExitCodes.USER_ERROR) }
    (source_for_parse, _) :: jet.Package.mask_inline_package_source(src) ?? {
        core.term.eprint(jet.render_all_colored(file, src, [err.diagnostic()], mode.color_stderr()))
        exit(ExitCodes.USER_ERROR)
    }
    (toks, lex_diags) :: jet.Lexer.lex(source_for_parse)
    if !lex_diags.is_empty() -> { core.term.eprint(jet.render_all_colored(file, src, lex_diags, mode.color_stderr())); exit(ExitCodes.USER_ERROR) }
    prog :: jet.Parser.parse_with_source(toks, source_for_parse) ?? {
        core.term.eprint(jet.render_all_colored(file, src, err, mode.color_stderr()))
        exit(ExitCodes.USER_ERROR)
    }
    if pure_required {
        funcs_sig := [String:Sema.FuncSig]{}
        ast_funcs := [String:&AST.Func]{}
        loop item in prog.items {
            if item == .Func(f) {
                provenance := AST.ViewProvenanceCell.new()
                if f.return_view_provenance == .Val(value) -> provenance.set(value.clone())
                &funcs_sig.insert(f.name.clone(), Sema.FuncSig{
                    deprecation: None, params: f.params.iter().map(fn(p) -> (p.convention.clone(), p.ty.clone())).collect(),
                    root_param: f.params.first().is_some_and(fn(p) -> p.root), return_type: f.return_type.clone(),
                    return_view_provenance: provenance, is_extern: false, is_c_abi: false, c_abi_name: None,
                    callback_transport: None, callback_plan_digest: None, callback_identity: None, foreign_effect_root: None,
                    undo: None, is_unsafe: f.is_unsafe, is_pure: f.is_pure, memo_bound: None, is_foreign_thread_safe: false,
                    is_sanitizer: f.is_sanitizer, is_must_use: f.is_must_use,
                    param_info: f.params.iter().map(fn(p) -> (p.name.clone(), p.default.is_some())).collect(),
                    param_call: f.params.iter().map(fn(p) -> (p.call_label().to_string(), p.zone)).collect(),
                    defaults: f.params.iter().map(fn(p) -> p.default.map(fn(d) -> d.clone())).collect(),
                    param_variadic: f.params.iter().map(fn(p) -> p.variadic).collect(),
                    variadic_bounds: f.params.last().and_then(fn(p) -> p.variadic_bound_list.clone()),
                    param_view_from_names: f.params.iter().map(fn(p) -> p.declared_view_from_names.clone()).collect(),
                    callable_policies: Sema.CallablePolicies.default(),
                })
                &ast_funcs.insert(f.name.clone(), &f)
            }
        }
        diags :: jet.check_pure_program_root("run", funcs_sig, ast_funcs)
        if !diags.is_empty() -> { core.term.eprint(jet.render_all_colored(file, src, diags, mode.color_stderr())); exit(ExitCodes.USER_ERROR) }
    }
    type_diags :: jet.check_for_eval(source_for_parse, file)
    if !type_diags.is_empty() -> { core.term.eprint(jet.render_all_colored(file, src, type_diags, mode.color_stderr())); exit(ExitCodes.USER_ERROR) }
    (value, printed) :: jet.eval_pure_program_value(source_for_parse, file) ?? {
        core.term.eprint(jet.render_all_colored(file, src, err, mode.color_stderr()))
        exit(ExitCodes.USER_ERROR)
    }
    if mode.json -> { core.term.eprint(printed); println("{render_eval_json(value)}") }
    else {
        core.term.print(printed)
        if render_eval_value(value) == .Val(value) -> println("{value}")
    }
}
