        report_problems(mode, file, src, err)
        exit(ExitCodes.USER_ERROR)
    }
    lints :: cost_diagnostics(projection.bundle, projection.diagnostics) ?? exit_cost_projection_error(file, err)
    if lints.is_empty() {
        if mode.json -> core.term.print(jet.render_all_json(machine_report_path_for_process(file), src, []))
        else -> println("ok: `{file}` has no hidden dynamic costs in loops")
        return
    }
    if mode.json -> core.term.eprint(jet.render_all_json(machine_report_path_for_process(file), src, lints))
    else {
        core.term.eprint(jet.render_all_colored(file, src, lints, mode.color_stderr()))
        suffix :: if lints.len() == 1 -> "" else -> "s"
        eprintln("\n{lints.len()} hidden dynamic cost warning{suffix} found")
    }
    exit(ExitCodes.USER_ERROR)
}
