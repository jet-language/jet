// Rust: Source/CmdRemote.rs:1
// Host-owned remote-builder bindings (D-JPK-REMOTE1).
use crate.[OutputMode, cli_error_fix]
use jet.[ExitCodes, CLI]
use jet.Comptime.Build.RemoteBuildBinding
use jet_foundation.[StatusEnvelope, StatusFields, StatusValue]
use std.process

// Rust: Source/CmdRemote.rs:8
fn run_remote(args: &[String], mode: OutputMode) -> Never {
    if args.get(1) == {
        Val("bind") -> bind(args, mode)
        Val("list") -> list(mode)
        Val("remove") -> remove(args)
        Val("help") | None -> {
            println("jet remote — manage host-owned remote builders\n\n  jet remote bind <name> --root <path> --credential-file <path> --trust-domain <name> [--execute] [--cache-read] [--cache-write] [--fallback-local]\n  jet remote list\n  jet remote remove <name>")
            process.exit(ExitCodes.OK)
        }
        Val(other) -> fail("unknown remote subcommand `{other}`")
    }
}
// Rust: Source/CmdRemote.rs:23
fn bind(args: &[String], mode: OutputMode) -> Never {
    builder :: args.get(2).filter(value -> !value.starts_with('-')).unwrap_or_else(() -> fail("jet remote bind needs a builder name"))
    root :: value_flag(args, "--root")
    credential_file :: value_flag(args, "--credential-file")
    trust_domain :: value_flag(args, "--trust-domain")
    root_path :: root.unwrap_or_else(() -> fail("jet remote bind needs `--root <absolute-path>`"))
    credential_path :: credential_file.unwrap_or_else(() -> fail("jet remote bind needs `--credential-file <path>`"))
    trust :: trust_domain.unwrap_or_else(() -> fail("jet remote bind needs `--trust-domain <name>`"))
    worker_id :: value_flag(args, "--worker-id") ?? "worker"
    // GATE #4483: native platform defaults are selected-target facts, not host assumptions.
    platform :: value_flag(args, "--platform") ?? "{core.sys.target.selected_os()}-{core.sys.target.selected_arch()}"
    abi :: value_flag(args, "--abi") ?? "native"
    timeout_ms :: value_flag(args, "--timeout-ms").map(value -> value.parse::<UInt64>().unwrap_or_else(_ -> fail("`--timeout-ms` must be a positive integer"))) ?? 30_000
    if timeout_ms == 0 { fail("`--timeout-ms` must be a positive integer") }
    cache_read :: has_flag(args, "--cache-read")
    cache_write :: has_flag(args, "--cache-write")
    execute :: has_flag(args, "--execute")
    fallback_local :: has_flag(args, "--fallback-local")
    known :: ["--root", "--credential-file", "--trust-domain", "--worker-id", "--platform", "--abi", "--timeout-ms",
        "--cache-read", "--cache-write", "--execute", "--fallback-local", CLI.MACHINE_OUTPUT_FLAG]
    for argument in args.iter().skip(3) {
        head :: argument.split_once('=').map((head, _) -> head) ?? argument
        if argument.starts_with('-') && !known.contains(head) { fail("unknown remote bind flag `{argument}`") }
    }
    // GATE #4494: canonical real host binding/credential persistence.
    binding :: RemoteBuildBinding.bind_host(builder.clone(), root_path, credential_path, trust,
        worker_id, platform, abi, cache_read, cache_write, execute, fallback_local, timeout_ms).unwrap_or_else(error -> fail(error))
    if mode.json {
        fields :: StatusFields.new().with("builder", binding.builder.clone()).with("root", binding.root.to_string_lossy().into_owned())
            .with("trust_domain", binding.trust_domain.clone()).with("worker_id", binding.worker_id.clone())
            .with("platform", binding.platform.clone()).with("abi", binding.abi.clone())
        println(StatusEnvelope.new("remote.bind", true).with_fields(fields).json())
    } else { println("bound remote builder `{binding.builder}`") }
    process.exit(ExitCodes.OK)
}
// Rust: Source/CmdRemote.rs:115
fn list(mode: OutputMode) -> Never {
    names :: RemoteBuildBinding.list_host().unwrap_or_else(error -> fail(error))
    if mode.json {
        builders :: StatusValue.array(names.iter().filter_map(name -> RemoteBuildBinding.load_host(name).ok().map(binding ->
            StatusValue.object(StatusFields.new().with("name", binding.builder).with("root", binding.root.to_string_lossy().into_owned())
                .with("trust_domain", binding.trust_domain).with("worker_id", binding.worker_id).with("platform", binding.platform)
                .with("abi", binding.abi).with("cache_read", binding.cache_read).with("cache_write", binding.cache_write)
                .with("execute", binding.execute).with("fallback_local", binding.fallback_local)))))
        println(StatusEnvelope.new("remote.list", true).with_field("builders", builders).json())
    } else if names.is_empty() { println("no remote builders are bound") }
    else {
        for name in names {
            if RemoteBuildBinding.load_host(name) == {
                Ok(binding) -> println("{binding.builder}\t{binding.root.display()}\t{binding.trust_domain}\t{capabilities(binding)}")
                Err(error) -> eprintln("{name}: {error}")
            }
        }
    }
    process.exit(ExitCodes.OK)
}
// Rust: Source/CmdRemote.rs:160
fn remove(args: &[String]) -> Never {
    builder :: args.get(2).filter(value -> !value.starts_with('-')).unwrap_or_else(() -> fail("jet remote remove needs a builder name"))
    RemoteBuildBinding.remove_host(builder).unwrap_or_else(error -> fail(error))
    println("removed remote builder `{builder}`")
    process.exit(ExitCodes.OK)
}
// Rust: Source/CmdRemote.rs:169
fn capabilities(binding: &RemoteBuildBinding) -> String {
    [if binding.cache_read { Val("cache-read") } else { None },
     if binding.cache_write { Val("cache-write") } else { None },
     if binding.execute { Val("execute") } else { None }].into_iter().flatten().collect().join(",")
}
// Rust: Source/CmdRemote.rs:181
fn value_flag(args: &[String], name: String) -> String? {
    args.iter().enumerate().find_map((index, argument) ->
        argument.strip_prefix("{name}=").map(value -> value.to_string())
            .or_else(() -> if argument == name { args.get(index + 1).cloned() } else { None }))
}
// Rust: Source/CmdRemote.rs:194
fn has_flag(args: &[String], name: String) -> Bool {
    args.iter().any(argument -> argument == name || argument == "{name}=true")
}
// Rust: Source/CmdRemote.rs:200
fn fail(message: String) -> Never {
    cli_error_fix("E2104", message, "run `jet remote help`")
    // GATE #4494: real process exit.
    process.exit(ExitCodes.USAGE)
}
