// Rust: Source/CmdDb.rs:2529
fn status_ct_value(value: CtValue) -> StatusValue {
    if value == {
        .Enum { type_name, variant, args } -> {
            if ["DataTree", "JSON", "TOML", "YAML", "CSV"].contains(type_name) {
                return if variant == {
                    "Null" -> StatusValue.Null
                    "Number" -> if args.first().map((_, value) -> value) == {
                        .Val(CtValue.Str(v)) -> v.parse<I128>().map(StatusValue.Integer) ?? StatusValue.Float(v.clone())
                        else -> StatusValue.Null
                    }
                    else -> args.first().map((_, v) -> status_ct_value(v)) ?? StatusValue.Null
                }
            }
        }
        else -> {}
    }
    if value == {
        .Int(v) -> StatusValue.from(v)
        .Float(v) -> .Float(v.to_json())
        .Bool(v) -> StatusValue.from(v)
        .Char(v) -> StatusValue.from(v.to_string())
        .Str(v) -> StatusValue.from(v)
        .BigInt(v) -> StatusValue.from(v.to_string_rep())
        .Bytes(values) -> StatusValue.array(values.iter().map(v -> StatusValue.from(v as I128)))
        .List(values) -> StatusValue.array(values.iter().map(status_ct_value))
        // GATE #4499: iteration over canonical composite-key compile-time maps.
        .Map(values) -> StatusValue.object(values.iter().fold(StatusFields.new(), (fields, (key, value)) -> fields.with(status_map_key(key), status_ct_value(value))))
        .Struct { fields, .. } -> StatusValue.object(fields.iter().filter((name, _) -> !Syntax.is_memo_storage_name(name)).fold(StatusFields.new(), (fields, (name, value)) -> fields.with(name, status_ct_value(value))))
        .Enum { variant, args, .. } -> {
            if args.is_empty() { StatusValue.from(variant) }
            else if args.iter().all((label, _) -> label.is_some()) {
                fields :: args.iter().fold(StatusFields.new(), (fields, (label, value)) -> fields.with(label.expect("checked enum label"), status_ct_value(value)))
                StatusValue.object(StatusFields.new().with(variant, StatusValue.object(fields)))
            } else { StatusValue.object(StatusFields.new().with(variant, StatusValue.array(args.iter().map((_, value) -> status_ct_value(value))))) }
        }
        .Present(v) -> status_ct_value(v)
        .Failed(CtReport.Clean(_)) | .Unit | .Closure(_) -> .Null
        .Failed(CtReport.Told(v)) -> StatusValue.object(StatusFields.new().with("err", status_ct_value(v)))
    }
}
