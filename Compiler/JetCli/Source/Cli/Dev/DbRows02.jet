// Rust: Source/CmdDb.rs:2696
fn render_plan(source: String, query: sql_kernel.JetSqlQuery) -> String {
    steps := ["scan {source}"]
    if (field, operator, value) :: query.filter { steps.push("filter {field} {operator} {value}") }
    if !query.group_by.is_empty() {
        keys :: query.group_by.iter().map(key -> if key == { .Field(field) -> field.clone(); .Ordinal(ordinal) -> "#{ordinal}" }).collect<[String]>().join(", ")
        steps.push("group {keys}")
    }
    projection :: query.projection.iter().map(item -> if item == {
        .Wildcard -> "*"
        .Field { field, alias } -> alias.map(alias -> "{field} AS {alias}") ?? field.clone()
        .Aggregate { function, field, alias } -> {
            name :: if function == { .Count -> "COUNT"; .Sum -> "SUM"; .Avg -> "AVG"; .Min -> "MIN"; .Max -> "MAX" }
            argument :: field ?? "*"
            expression :: "{name}({argument})"
            alias.map(alias -> "{expression} AS {alias}") ?? ^expression
        }
    }).collect<[String]>().join(", ")
    steps.push("project {projection}")
    if (field, descending) :: query.order { direction :: if descending { "desc" } else { "asc" }; steps.push("sort {field} {direction}") }
    if limit :: query.limit { steps.push("limit {limit}") }
    steps.join(" -> ")
}
// Rust: Source/CmdDb.rs:2754
fn handle_dot(input: String, source: LoadedSource?, state: DbState, options: DbOptions, mode: OutputMode) -> Bool DbError! {
    parts := input.splitn(2, character -> character.is_whitespace())
    command :: parts.next() ?? input
    argument :: parts.next().map(value -> value.trim()).filter(value -> !value.is_empty())
    if command == {
        ".quit" | ".exit" -> false
        ".help" -> {
            if mode.json { write_db_status(mode, "help", true, StatusFields.new().with("usage", usage())) }
            else { write_mode_renderable(mode, usage()) }
            true
        }
        ".tables" -> {
            loaded :: source ?? return Err(DbError.new("E2600", "tables", "", "no source is loaded", "pass a local source path first"))
            if mode.json { write_db_status(mode, "tables", true, StatusFields.new().with("tables", StatusValue.array([StatusValue.from(loaded.name)]))) }
            else { write_mode_renderable(mode, "{loaded.name}\n") }
            true
        }
        ".schema" -> {
            loaded :: source ?? return Err(DbError.new("E2600", "schema", "", "no source is loaded", "pass a local source path first"))
            if mode.json { write_db_status(mode, "schema", true, StatusFields.new().with("source", loaded.name).with("rows", loaded.rows).with("columns", columns_value(loaded.columns))) }
            else {
                for column in loaded.columns {
                    suffix :: if column.nullable { "?" } else { "" }
                    write_mode_renderable(mode, "{column.name}: {jet_cli_db_column_kind_name(column.kind)}{suffix}\n")
                }
            }
            true
        }
        ".plan" -> {
            plan :: state.last_plan ?? return Err(DbError.new("E2600", "plan", "", "no query plan is available", "run a SELECT query before `.plan`"))
            if mode.json { write_db_status(mode, "plan", true, StatusFields.new().with("plan", plan)) }
            else { write_mode_renderable(mode, "{plan}\n") }
            true
        }
        ".stats" -> {
            statement :: state.last_sql ?? ""
            if mode.json {
                write_db_status(mode, "stats", true, StatusFields.new().with("statement", statement).with("rows", state.last_rows).with("elapsed_ms", StatusValue.from(I128.try_from(state.last_elapsed_ms) ?? I128.MAX)).with("output_bytes", state.last_output_bytes))
            } else { write_mode_renderable(mode, "statement: {statement}\nrows: {state.last_rows} time: {state.last_elapsed_ms}ms output: {state.last_output_bytes} bytes\n") }
            true
        }
        ".export" -> {
            destination :: argument ?? return Err(DbError.new("E2104", "export", "", "`.export` needs a destination path", "use `.export report.json json` or `.export report.csv csv`"))
            export_result(destination, source, state, options, mode)
        }
        else -> Err(DbError.new("E2104", "dot-command", "", "unknown db console command `{command}`", "use `.help`, `.tables`, `.schema`, `.plan`, `.stats`, `.export`, or `.quit`"))
    }
}
// Rust: Source/CmdDb.rs:2912
fn export_result(argument: String, source: LoadedSource?, state: DbState, options: DbOptions, mode: OutputMode) -> Bool DbError! {
    if !options.allow_write || options.deny_write {
        return Err(DbError.new("E1803", "export", argument, "export writes need explicit FS.Write authority", "start `jet db --allow=FS.Write` (and `--allow=FS.Read` to load a source); denied writes never fall back to stdout"))
    }
    parts := argument.split_whitespace()
    path := parts.next() ?? "" // #4303
    if path.is_empty() { return Err(DbError.new("E2104", "export", "", "`.export` needs a destination path", "use `.export report.json json`")) }
    format :: parts.next() ?? "json"
    result :: state.last_result ?? return Err(DbError.new("E2600", "export", path, "no query result is available", "run a SELECT query before exporting"))
    bytes :: if format == {
        "json" -> result.clone()
        "csv" -> {
            loaded :: source ?? return Err(DbError.new("E2600", "export", path, "CSV export needs a loaded source schema", "load a typed source before exporting"))
            jet_cli_db_result_csv(result, loaded.columns, path)
        }
        else -> return Err(DbError.new("E2104", "export", path, "unknown export format `{format}`", "choose json or csv"))
    }
    if bytes.bytes().len() > options.max_output_bytes { return Err(DbError.new("E2603", "export", path, "export output is {bytes.bytes().len()} bytes, over the {options.max_output_bytes}-byte output limit", "raise `--max-output-bytes` or export a smaller query result")) }
    destination :: OSPath.new(path)
    // GATE #4494: actual filesystem write with OSPath ingress; retain IO error text.
    fs.write(&destination, bytes.bytes()) ?? return Err(DbError.new("E2105", "export", path, "could not write `{path}`: {err}", "check the destination and explicit FS authority"))
    if mode.json { write_db_status(mode, "export", true, StatusFields.new().with("path", path).with("bytes", bytes.bytes().len())) }
    else { write_mode_status(mode, "exported {bytes.bytes().len()} bytes to {path}\n") }
    true
}
