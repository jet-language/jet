// Rust: Source/CmdDb.rs:1842
fn prepare_session(session: &SqlSession, source: LoadedSource) -> DbError! {
    for import in ["use core.data as data", "use core.encoding.json as json"] {
        session.execute(import) ?? return Err(DbError.diagnostics("import", source.path, &err))
    }
    session.define_item(jet_cli_db_generated_row_item(source.columns)) ?? return Err(DbError.diagnostics("schema", source.path, &err))
}
