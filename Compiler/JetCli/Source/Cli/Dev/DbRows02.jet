// Rust: Source/CmdDb.rs:1869
fn process_inputs(inputs: [String], interactive: Bool, source: LoadedSource?, session: &SqlSession, state: &DbState, options: DbOptions, mode: OutputMode) -> Int {
    status := 0
    for input in inputs {
        text := input.trim() // #4303
        if text.is_empty() { continue }
        keep_going :: if text.starts_with('.') {
            handle_dot(text, source, state, options, mode) ?? {
                emit_error(mode, options.output, &err)
                status = ExitCodes.USER_ERROR
                if !interactive { return status }
                continue
            }
        } else {
            run_query(text, source, session, state, options, mode) ?? {
                emit_error(mode, options.output, &err)
                status = ExitCodes.USER_ERROR
                if !interactive { return status }
                continue
            }
            true
        }
        if !keep_going { return 0 }
    }
    status
}
