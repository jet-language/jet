// Rust: Source/CmdDb.rs:1925
fn run_dynamic_query(source: LoadedSource, query: sql_kernel.JetSqlQuery) -> (SqlEval, Value, String, Int) DbError! {
    parsed :: parse_json(source.json, false) ?? return Err(DbError.new("E2600", "query", source.path, "normalized source could not be decoded: {err.message}", "reload the local source before querying it"))
    values :: if parsed == {
        .Array(values) -> values
        else -> return Err(DbError.new("E2600", "query", source.path, "normalized source is not a row array", "reload a local JSON, JSONL, or CSV source"))
    }
    fields :: source.columns.iter().map(column -> column.name.clone()).collect()
    result :: sql_kernel.execute_sql_rows(fields, values.len(), query, (index, field) -> {
        values.get(index).and_then(row -> if row == {
            .Object(entries) -> entries.iter().find((name, _) -> name == field).map((_, value) -> db_sql_value(value))
            else -> .None
        })
    }) ?? return Err(DbError.new("E2702", "query", source.path, err, "use declared source columns and the supported SELECT query surface"))
    result_values :: result.into_iter().map(row -> Value.Object(row.fields.into_iter().map((name, value) -> (^name, db_sql_json_value(^value))).collect())).collect()
    rows :: result_values.len()
    result_tree :: Value.Array(^result_values)
    rendered :: render_json_value(result_tree)
    (SqlEval { value: .None, stdout: "", stderr: "" }, ^result_tree, ^rendered, rows)
}
// Rust: Source/CmdDb.rs:1998
fn query_result_columns(source: LoadedSource, query: sql_kernel.JetSqlQuery) -> [Column] {
    columns := [Column]{}
    for item in query.projection {
        if item == {
            .Wildcard -> {
                for column in source.columns { columns.push(Column { name: column.name.clone(), kind: column.kind, nullable: column.nullable }) }
            }
            .Field { field, alias } -> {
                source_column :: source.columns.iter().find(column -> column.name == field)
                columns.push(Column { name: alias.clone() ?? field.clone(), kind: source_column.map(column -> column.kind) ?? .String, nullable: source_column.map(column -> column.nullable) ?? true })
            }
            .Aggregate { function, field, alias } -> {
                source_column :: field.and_then(field -> source.columns.iter().find(column -> column.name == field))
                default_name :: field.map(field -> "{function.as_str()}_{field}") ?? function.as_str().to_string()
                (kind, nullable) :: if function == {
                    .Count -> (ColumnKind.Int, false)
                    .Sum -> (source_column.map(column -> column.kind) ?? ColumnKind.Float, true)
                    .Avg -> (ColumnKind.Float, true)
                    .Min | .Max -> (source_column.map(column -> column.kind) ?? ColumnKind.String, true)
                }
                columns.push(Column { name: alias.clone() ?? ^default_name, kind: kind, nullable: nullable })
            }
        }
    }
    columns
}
