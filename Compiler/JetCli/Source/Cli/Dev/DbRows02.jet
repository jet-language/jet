// Rust: Source/CmdDb.rs:1806
fn render_json_value(value: Value) -> String {
    out := String.new()
    write_json_value(&out, value)
    out
}
// Rust: Source/CmdDb.rs:1806-1831; one buffer preserves linear nested rendering.
fn write_json_value(out: &String, value: Value) -> {
    if value == {
        .Null -> out.push_str("null")
        .Bool(v) -> out.push_str(v.to_string())
        .Int(v) -> out.push_str(v.to_string())
        .Float(v) -> out.push_str(jet_cli_db_render_float(v))
        .Number(v) -> out.push_str(v)
        .TypedText(v) | .Text(v) -> out.push_str(json_str(v))
        .Bytes(values) -> {
            out.push('[')
            for (index, v) in values.iter().enumerate() {
                if index > 0 { out.push(',') }
                out.push_str(v.to_string())
            }
            out.push(']')
        }
        .Array(values) -> {
            out.push('[')
            for (index, v) in values.iter().enumerate() {
                if index > 0 { out.push(',') }
                write_json_value(out, v)
            }
            out.push(']')
        }
        .Object(entries) -> {
            out.push('{')
            for (index, (name, v)) in entries.iter().enumerate() {
                if index > 0 { out.push(',') }
                out.push_str(json_str(name))
                out.push(':')
                write_json_value(out, v)
            }
            out.push('}')
        }
    }
}
