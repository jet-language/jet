fn result_row_count(value: CtValue) -> Int? {
    if value == {
        .Present(value) -> result_row_count(value)
        .List(values) -> .Val(values.len())
        else -> .None
    }
}
// Rust: Source/CmdDb.rs:2068
fn run_query(sql: String, source: LoadedSource?, session: &SqlSession, state: &DbState, options: DbOptions, mode: OutputMode) -> DbError! {
    loaded :: source ?? return Err(DbError.new("E2600", "query", "", "a SQL query needs a local typed source", "pass `jet db source.json --allow=FS.Read --query 'SELECT * FROM source'`"))
    query :: sql_kernel.parse_sql_query(sql) ?? return Err(DbError.new("E2702", "query", loaded.path, err, "use SELECT ... FROM source with optional WHERE, GROUP BY, ORDER BY, and LIMIT clauses"))
    if query.source != loaded.name {
        return Err(DbError.new("E2702", "query", loaded.path, "query source `{query.source}` does not match loaded source `{loaded.name}`", "use `FROM {loaded.name}` or pass `--table {loaded.name}` with the desired identity"))
    }
    sql_kernel.validate_sql_query_schema(query, field -> loaded.columns.iter().any(column -> column.name == field), "SQL query") ?? return Err(DbError.new("E2702", "query", loaded.path, err, "use only columns declared by the loaded source"))
    plan :: render_plan(loaded.name, query)
    result_columns :: query_result_columns(loaded, query)
    // GATE #4494: monotonic native clock.
    started :: time.Instant.now()
    (evaluated, result_value, rendered, rows) :: if query.needs_projection_execution() {
        (evaluated, result_tree, rendered, rows) :: run_dynamic_query(loaded, query)
        (^evaluated, status_data_value(result_tree), ^rendered, rows)
    } else {
        expression :: "data.query(json.decode<[{ROW_TYPE_NAME}]>({json_str(loaded.json)}) ?? panic(\"input\"), SQL{{{json_str(sql)}}})"
        evaluated :: session.execute(expression) ?? return Err(DbError.diagnostics("query", loaded.path, &err))
        value :: evaluated.value.as_ref() ?? return Err(DbError.new("E2600", "query", loaded.path, "the SQL query produced no result value", "keep the query as a SELECT expression"))
        rendered :: Comptime.render_datatree_for_tir(value)
        rows :: result_row_count(value) ?? return Err(DbError.new("E2600", "query", loaded.path, "query result was not a typed row list", "use the local typed-table query surface rather than a scalar expression"))
        result_value :: status_ct_value(value)
        (^evaluated, ^result_value, ^rendered, rows)
    }
    elapsed_ms :: started.elapsed().as_millis()
    output_bytes :: final_output_bytes(sql, loaded, evaluated, result_value, rendered, rows, elapsed_ms, plan, result_columns, options, mode)
    state.last_sql = .Val(sql.clone())
    state.last_plan = .Val(plan.clone())
    state.last_result = .Val(rendered.clone())
    state.last_rows = rows
    state.last_elapsed_ms = elapsed_ms
    state.last_output_bytes = output_bytes
    emit_result(sql, loaded, evaluated, result_value, rendered, rows, elapsed_ms, plan, result_columns, options, mode)
}
