fn db_output_name(output: DbOutput, mode: OutputMode) -> String {
    if output == {
        .Csv -> "csv"
        .Jsonl -> "jsonl"
        .Json -> "json"
        .Human -> if mode.json { "json" } else { "human" }
    }
}
// Rust: Source/CmdDb.rs:2204
fn status_trust(transport: String, authority: String, remote: Bool) -> StatusValue {
    StatusValue.object(StatusFields.new().with("transport", transport).with("authority", authority).with("remote", remote))
}
// Rust: Source/CmdDb.rs:2213
fn status_value_json_len(value: StatusValue) -> Int {
    if value == {
        .Null -> 4
        .Bool(v) -> v.to_string().bytes().len()
        .Integer(v) -> v.to_string().bytes().len()
        .Float(v) -> v.bytes().len()
        .String(v) -> json_str(v).bytes().len()
        .Array(values) -> 2 + values.iter().map(status_value_json_len).sum() + values.len().saturating_sub(1)
        .Object(fields) -> 2 + fields.iter().map((name, value) -> json_str(name).bytes().len() + 1 + status_value_json_len(value)).sum() + fields.iter().count().saturating_sub(1)
    }
}
// Rust: Source/CmdDb.rs:2233
fn db_row_status(source: LoadedSource, index: Int, output_mode: String, plan: String, rows: Int, row: StatusValue) -> StatusEnvelope {
    db_status("row", true, StatusFields.new().with("source", source.name).with("index", index).with("output_mode", output_mode).with("plan", plan)
        .with("result_size", StatusValue.object(StatusFields.new().with("bytes", status_value_json_len(row)).with("rows", rows)))
        .with("trust", status_trust("local", "same authorized local session", false)).with("row", row.clone()))
}
// Rust: Source/CmdDb.rs:2269
fn db_query_status(sql: String, source: LoadedSource, evaluated: SqlEval, result: StatusValue, rows: Int, elapsed_ms: U128, plan: String, columns: [Column], output_mode: String) -> StatusEnvelope {
    db_status("query", true, StatusFields.new().with("source", source.name).with("sql", sql).with("rows", rows).with("elapsed_ms", elapsed_ms as I128)
        .with("input_bytes", source.input_bytes).with("output_mode", output_mode).with("plan", plan)
        .with("result_size", StatusValue.object(StatusFields.new().with("bytes", status_value_json_len(result)).with("rows", rows)))
        .with("trust", status_trust("local", "same authorized local session", false)).with("columns", columns_value(columns))
        .with("result", result.clone()).with("stdout", evaluated.stdout).with("stderr", evaluated.stderr))
}
// Rust: Source/CmdDb.rs:2314
fn final_output_bytes(sql: String, source: LoadedSource, evaluated: SqlEval, result: StatusValue, rendered: String, rows: Int, elapsed_ms: U128, plan: String, columns: [Column], options: DbOptions, mode: OutputMode) -> Int DbError! {
    output :: if mode.json && options.output == DbOutput.Jsonl {
        if result == {
            .Array(values) -> values.iter().enumerate().map((index, value) -> db_row_status(source, index, db_output_name(options.output, mode), plan, rows, value).json_line().bytes().len()).sum()
            else -> return Err(DbError.new("E2600", "query", source.path, "result is not an array for JSONL output", "use `--json` for the bounded envelope"))
        }
    } else if mode.json {
        db_query_status(sql, source, evaluated, result, rows, elapsed_ms, plan, columns, db_output_name(options.output, mode)).json_line().bytes().len()
    } else if options.output == DbOutput.Csv {
        jet_cli_db_result_csv(rendered, columns, source.path).bytes().len()
    } else {
        rendered.bytes().len() + evaluated.stdout.bytes().len() + evaluated.stderr.bytes().len() + 1 + if mode.quiet { 0 } else { "rows: {rows} time: {elapsed_ms}ms source: {source.name}\n".bytes().len() }
    }
    if output > options.max_output_bytes { return Err(DbError.new("E2603", "query", source.path, "final rendered output is {output} bytes, over the {options.max_output_bytes}-byte output limit", "raise `--max-output-bytes` or add a smaller SQL LIMIT")) }
    output
}
// Rust: Source/CmdDb.rs:2395
fn emit_result(sql: String, source: LoadedSource, evaluated: SqlEval, result: StatusValue, rendered: String, rows: Int, elapsed_ms: U128, plan: String, columns: [Column], options: DbOptions, mode: OutputMode) -> DbError! {
    if mode.json {
        if options.output == DbOutput.Jsonl {
            if result == {
                .Array(values) -> {
                    for (index, value) in values.iter().enumerate() {
                        status :: db_row_status(source, index, db_output_name(options.output, mode), plan, rows, value).json_line()
                        write_mode_machine(mode, status)
                    }
                    return
                }
                else -> return Err(DbError.new("E2600", "query", source.path, "result is not an array for JSONL output", "use `--json` for the bounded envelope"))
            }
        }
        status :: db_query_status(sql, source, evaluated, result, rows, elapsed_ms, plan, columns, db_output_name(options.output, mode)).json_line()
        write_mode_machine(mode, status)
        return
    }
    if options.output == DbOutput.Csv { write_mode_renderable(mode, jet_cli_db_result_csv(rendered, columns, source.path)) }
    else { write_mode_renderable(mode, "{rendered}\n") }
    if !evaluated.stdout.is_empty() { write_mode_renderable(mode, evaluated.stdout) }
    if !evaluated.stderr.is_empty() { write_mode_diagnostic(mode, evaluated.stderr) }
    write_mode_status(mode, "rows: {rows} time: {elapsed_ms}ms source: {source.name}\n")
}
