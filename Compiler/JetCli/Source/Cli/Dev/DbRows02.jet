fn status_data_value(value: Value) -> StatusValue {
    if value == {
        .Null -> .Null
        .Bool(v) -> StatusValue.from(v)
        .Int(v) -> StatusValue.from(v)
        .Float(v) -> .Float(v.to_string())
        .Number(v) -> v.parse<I128>().map(StatusValue.Integer) ?? StatusValue.Float(v.clone())
        .TypedText(v) | .Text(v) -> StatusValue.from(v)
        .Bytes(values) -> StatusValue.array(values.iter().map(v -> StatusValue.from(v as I128)))
        .Array(values) -> StatusValue.array(values.iter().map(status_data_value))
        .Object(fields) -> StatusValue.object(fields.iter().fold(StatusFields.new(), (fields, (name, value)) -> fields.with(name, status_data_value(value))))
    }
}
