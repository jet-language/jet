    if value == .Object(object) {
        return Ok(JetCLILearnAccessibility{keyboard: jet_cli_learn_required_bool(object, "keyboard", label), text_only: jet_cli_learn_required_bool(object, "text_only", label), reduced_motion: jet_cli_learn_required_bool(object, "reduced_motion", label), no_auto_quiz: jet_cli_learn_required_bool(object, "no_auto_quiz", label)})
    }
    return Err("{label}.accessibility must be an object: expected a DataTree object")
