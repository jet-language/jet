// Rust validate_fixture (CmdLearn.rs:625-643), source before solution before failure.
pub fn jet_cli_learn_validate_fixture<F: JetCLILearnFixtures>(fixture: JetCLILearnFixture, label: String, fixtures: F) Err! {
    jet_cli_learn_validate_fixture_path(fixture.path, label, fixtures)
    jet_cli_learn_validate_fixture_path(fixture.solution_path, label, fixtures)
    if fixture.failure != "diagnostic" && fixture.failure != "output" -> return Err("{label} fixture has unsupported failure `{fixture.failure}`")
}
fn jet_cli_learn_validate_fixture_path<F: JetCLILearnFixtures>(path: String, label: String, fixtures: F) Err! {
    if !jet_cli_learn_safe_fixture_path(path) -> return Err("{label} fixture path `{path}` is not a safe Jet filename")
    if jet_cli_learn_fixture_text(fixtures, path) == None -> return Err("{label} fixture `{path}` is not packaged")
}
// Rust object_field (CmdLearn.rs:645-649).
pub fn jet_cli_learn_object_field(object: [String:DataTree], name: String) -> DataTree? Never! { object.get(name) }
// Missing-field check permits borrowed indexing, not a copied nested tree.
fn jet_cli_learn_require_field(object: [String:DataTree], name: String, label: String) Err! {
    if !object.has_key(name) -> return Err("{label} is missing `{name}`")
}
// Rust required_text (CmdLearn.rs:651-657).
pub fn jet_cli_learn_required_text(object: [String:DataTree], name: String, label: String) -> String Err! {
    if object.has_key(name) {
        if object[name] == .Text(text) { if !text.is_empty() -> return Ok(~text) }
    }
    return Err("{label} is missing non-empty `{name}`")
}
// Rust required_bool (CmdLearn.rs:659-664).
pub fn jet_cli_learn_required_bool(object: [String:DataTree], name: String, label: String) -> Bool Err! {
    if object.has_key(name) { if object[name] == .Bool(value) -> return Ok(value) }
    return Err("{label} is missing boolean `{name}`")
}
// Rust text_array (CmdLearn.rs:666-684).
pub fn jet_cli_learn_text_array(object: [String:DataTree], name: String, label: String) -> [String] Err! {
    jet_cli_learn_require_field(object, name, label)
    if object[name] == .Array(values) {
        out := [String]{}
        loop value in values {
            if value == {
                .Text(text) -> &out.push(~text)
                else -> { return Err("{label}.{name} contains a non-string: expected a DataTree string") }
            }
        }
        return Ok(^out)
    }
    return Err("{label}.{name} must be an array: expected a DataTree array")
}
// Rust safe_fixture_path (CmdLearn.rs:686-695), POSIX Path::components.
// Repeated separators and interior/trailing '.' vanish; leading '.' does not.
pub fn jet_cli_learn_safe_fixture_path(path: String) -> Bool Never! {
    if path.is_empty() || path.starts_with("/") -> return false
    parts :: path.split("/")
    last := ""
    first := true
    loop part in parts {
        if part.is_empty() -> next
        if part == ".." -> return false
        if part == "." { if first -> return false else -> next }
        first = false
        last = ~part
    }
    // Rust extension of '.jet' is None; extension of 'x.jet' is 'jet'.
    last != ".jet" && last.ends_with(".jet")
}
// Rust step_name (CmdLearn.rs:1389-1402).
pub fn jet_cli_learn_step_name(progress: JetCLILearnProgress) -> String Never! {
    if {
        !progress.prediction_measured -> "PREDICT"
        !progress.source_completed || progress.evidence_status != "current" || !progress.reason_completed -> "CHECK"
        !progress.controlled_completed -> "CHANGE"
        else -> "TRANSFER"
    }
}
// Rust prediction_matches (CmdLearn.rs:1615-1619); ASCII case only.
pub fn jet_cli_learn_prediction_matches(lesson: JetCLILearningTask, answer: String) -> Bool Never! {
    wanted := lesson.oracle.answer.trim() // #4303
    response := answer.trim() // #4303
    left :: wanted.bytes()
    right :: response.bytes()
    if left.len() != right.len() -> return false
    loop index in 0..<left.len() {
        a :: Int.from_u8(left[index])
        b :: Int.from_u8(right[index])
        if (if a >= 65 && a <= 90 -> a + 32 else -> a) != (if b >= 65 && b <= 90 -> b + 32 else -> b) -> return false
    }
    true
}
// Rust oracle_revision (CmdLearn.rs:1804-1813).
pub fn jet_cli_learn_oracle_revision(lesson: JetCLILearningTask) -> String Never! {
    out := [U8]{}
    jet_cli_learn_append(&out, lesson.oracle.id)
    &out.push(U8{0})
    jet_cli_learn_append(&out, lesson.oracle.kind)
    &out.push(U8{0})
    jet_cli_learn_append(&out, lesson.oracle.answer)
    &out.push(U8{0})
    jet_cli_learn_append(&out, lesson.oracle.expected_output)
    &out.push(U8{0})
    jet_cli_learn_append(&out, lesson.oracle.distinguishes)
    digest :: mir_sha256_bytes(out[0..<out.len()])
    mir_sha256_hex_bytes(digest[0..<digest.len()])
}
// Rust safe_id (CmdLearn.rs:2268-2279); one underscore per non-ASCII BYTE.
pub fn jet_cli_learn_safe_id(value: String) -> String Never! {
    out := [U8]{}
    loop byte in value.bytes() {
        n :: Int.from_u8(byte)
        &out.push(if (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) -> byte else -> U8{95})
    }
    String.from_bytes(out) ?? panic("safe id is ASCII")
}
// Rust progress_path (CmdLearn.rs:1815-1825); root joining belongs to C-FS caller.
pub fn jet_cli_learn_progress_path(lesson: JetCLILearningTask) -> String Never! { "progress/{jet_cli_learn_safe_id(lesson.id)}.json" }
// Rust load_progress parse half (CmdLearn.rs:1833-1871). C-FS handles NotFound.
pub fn jet_cli_learn_load_progress(text: String) -> JetCLILearnProgress Err! {
    value :: jet_cli_learn_parse_json(text, "progress JSON")
    if value == .Object(object) {
        schema :: jet_cli_learn_required_text(object, "schema", "progress")
        if schema != JET_CLI_LEARN_PROGRESS_SCHEMA -> return Err("unsupported progress schema `{schema}`")
        return Ok(JetCLILearnProgress{
            schema: schema,
            curriculum_revision: jet_cli_learn_required_text(object, "curriculum_revision", "progress"),
            task_id: jet_cli_learn_required_text(object, "task_id", "progress"),
            capability_id: jet_cli_learn_required_text(object, "capability_id", "progress"),
            family: jet_cli_learn_required_text(object, "family", "progress"),
            source_path: jet_cli_learn_required_text(object, "source_path", "progress"),
            source_fixture_revision: jet_cli_learn_required_text(object, "source_fixture_revision", "progress"),
            source_revision: jet_cli_learn_required_text(object, "source_revision", "progress"),
            oracle_id: jet_cli_learn_required_text(object, "oracle_id", "progress"),
            oracle_revision: jet_cli_learn_required_text(object, "oracle_revision", "progress"),
            status: jet_cli_learn_required_text(object, "status", "progress"),
            phase: jet_cli_learn_required_text(object, "phase", "progress"),
            prediction_initial: jet_cli_learn_required_text(object, "prediction_initial", "progress"),
            prediction: jet_cli_learn_required_text(object, "prediction", "progress"),
            prediction_response: jet_cli_learn_optional_text(object, "prediction_response"),
            prediction_measured: jet_cli_learn_required_bool(object, "prediction_measured", "progress"),
            reveal_shown: jet_cli_learn_required_bool(object, "reveal_shown", "progress"),
            evidence_status: jet_cli_learn_required_text(object, "evidence_status", "progress"),
            evidence_source_revision: jet_cli_learn_optional_text(object, "evidence_source_revision"),
            derivation_ref: jet_cli_learn_optional_nullable_text(object, "derivation_ref"),
            reason_completed: jet_cli_learn_required_bool(object, "reason_completed", "progress"),
            source_completed: jet_cli_learn_required_bool(object, "source_completed", "progress"),
            controlled_completed: jet_cli_learn_required_bool(object, "controlled_completed", "progress"),
            controlled_revision: jet_cli_learn_optional_text(object, "controlled_revision"),
            transfer_completed: jet_cli_learn_required_bool(object, "transfer_completed", "progress"),
            transfer_revision: jet_cli_learn_optional_text(object, "transfer_revision"),
            transfer_evidence: jet_cli_learn_required_bool(object, "transfer_evidence", "progress"),
            stale_reason: jet_cli_learn_optional_nullable_text(object, "stale_reason"),
        })
    }
    return Err("progress must be an object: expected a DataTree object")
}
// Rust optional_text (CmdLearn.rs:1874-1879).
pub fn jet_cli_learn_optional_text(object: [String:DataTree], name: String) -> String Never! {
    if object.has_key(name) { if object[name] == .Text(text) -> return ~text }
    ""
}
// Rust optional_nullable_text (CmdLearn.rs:1881-1886).
pub fn jet_cli_learn_optional_nullable_text(object: [String:DataTree], name: String) -> String? Never! {
    if object.has_key(name) { if object[name] == .Text(text) -> return Val(~text) }
    None
}
fn jet_cli_learn_append(out: &[U8], text: String) Never! { loop byte in text.bytes() -> &out.push(byte) }
fn jet_cli_learn_progress_string(out: &[U8], name: String, text: String, comma: Bool) Never! {
    if comma -> &out.push(U8{44})
    jet_cli_learn_append(&out, "\"{name}\":\"{json_escape(text)}\"")
}
fn jet_cli_learn_progress_bool(out: &[U8], name: String, value: Bool) Never! { jet_cli_learn_append(&out, ",\"{name}\":{if value -> "true" else -> "false"}") }
fn jet_cli_learn_progress_option(out: &[U8], name: String, value: String?) Never! {
    jet_cli_learn_append(&out, ",\"{name}\":")
    if value == {
        .Val(text) -> jet_cli_learn_append(&out, "\"{json_escape(text)}\"")
        .None -> jet_cli_learn_append(&out, "null")
    }
}
// Rust progress_json (CmdLearn.rs:1900-1938); exact field order and final LF.
pub fn jet_cli_learn_progress_json(progress: JetCLILearnProgress) -> String Never! {
    out := [U8]{}
    &out.push(U8{123})
    jet_cli_learn_progress_string(&out, "schema", progress.schema, false)
    jet_cli_learn_progress_string(&out, "curriculum_revision", progress.curriculum_revision, true)
    jet_cli_learn_progress_string(&out, "task_id", progress.task_id, true)
    jet_cli_learn_progress_string(&out, "capability_id", progress.capability_id, true)
    jet_cli_learn_progress_string(&out, "family", progress.family, true)
    jet_cli_learn_progress_string(&out, "source_path", progress.source_path, true)
    jet_cli_learn_progress_string(&out, "source_fixture_revision", progress.source_fixture_revision, true)
    jet_cli_learn_progress_string(&out, "source_revision", progress.source_revision, true)
    jet_cli_learn_progress_string(&out, "oracle_id", progress.oracle_id, true)
    jet_cli_learn_progress_string(&out, "oracle_revision", progress.oracle_revision, true)
    jet_cli_learn_progress_string(&out, "status", progress.status, true)
    jet_cli_learn_progress_string(&out, "phase", progress.phase, true)
    jet_cli_learn_progress_string(&out, "prediction_initial", progress.prediction_initial, true)
    jet_cli_learn_progress_string(&out, "prediction", progress.prediction, true)
    jet_cli_learn_progress_string(&out, "prediction_response", progress.prediction_response, true)
    jet_cli_learn_progress_bool(&out, "prediction_measured", progress.prediction_measured)
    jet_cli_learn_progress_bool(&out, "reveal_shown", progress.reveal_shown)
    jet_cli_learn_progress_string(&out, "evidence_status", progress.evidence_status, true)
    jet_cli_learn_progress_string(&out, "evidence_source_revision", progress.evidence_source_revision, true)
    jet_cli_learn_progress_option(&out, "derivation_ref", progress.derivation_ref)
    jet_cli_learn_progress_bool(&out, "reason_completed", progress.reason_completed)
    jet_cli_learn_progress_bool(&out, "source_completed", progress.source_completed)
    jet_cli_learn_progress_bool(&out, "controlled_completed", progress.controlled_completed)
    jet_cli_learn_progress_string(&out, "controlled_revision", progress.controlled_revision, true)
    jet_cli_learn_progress_bool(&out, "transfer_completed", progress.transfer_completed)
    jet_cli_learn_progress_string(&out, "transfer_revision", progress.transfer_revision, true)
    jet_cli_learn_progress_bool(&out, "transfer_evidence", progress.transfer_evidence)
    jet_cli_learn_progress_option(&out, "stale_reason", progress.stale_reason)
    jet_cli_learn_append(&out, "}}\n")
    String.from_bytes(out) ?? panic("progress JSON is UTF-8")
}
// Rust parse_action (CmdLearn.rs:2068-2089).
pub fn jet_cli_learn_parse_action(line: String) -> JetCLILearnAction? Never! {
    trimmed := line.trim() // #4303
    normalized :: trimmed.to_ascii_lower()
    if normalized == {
        "i do not know" -> return Val(JetCLILearnAction.Unknown)
        "unknown" -> return Val(JetCLILearnAction.Unknown)
        "idk" -> return Val(JetCLILearnAction.Unknown)
        "skip" -> return Val(JetCLILearnAction.Skip)
        "reveal" -> return Val(JetCLILearnAction.Reveal)
        "help" -> return Val(JetCLILearnAction.Reveal)
        "reason" -> return Val(JetCLILearnAction.Reason)
        "explain" -> return Val(JetCLILearnAction.Reason)
        "cancel" -> return Val(JetCLILearnAction.Cancel)
        "quit" -> return Val(JetCLILearnAction.Cancel)
        else -> {}
    }
    if normalized.starts_with("predict ") {
        answer := normalized.slice(8, normalized.len()).trim() // #4303
        if !answer.is_empty() -> return Val(JetCLILearnAction.Predict(~answer))
    }
    None
}

