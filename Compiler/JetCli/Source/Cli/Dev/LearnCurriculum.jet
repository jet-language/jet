}

// Rust fixture_text (CmdLearn.rs:697-749), C-EMBED provider boundary.
// None means not packaged. Implementations return the actual packaged text.
pub trait JetCLILearnFixtures { fn text(self, path: String) -> String? Never! }
pub fn jet_cli_learn_fixture_text<F: JetCLILearnFixtures>(fixtures: F, path: String) -> String? Never! { fixtures.text(path) }

// Rust Progress::new (CmdLearn.rs:142-179).
pub fn jet_cli_learn_progress_new(lesson: JetCLILearningTask, curriculum_revision: String, source_fixture_revision: String, source_revision: String, oracle_revision: String) -> JetCLILearnProgress Never! {
    JetCLILearnProgress{
        schema: JET_CLI_LEARN_PROGRESS_SCHEMA, curriculum_revision: ~curriculum_revision,
        task_id: ~lesson.id, capability_id: ~lesson.capability_id, family: ~lesson.family,
        source_path: ~lesson.source.path, source_fixture_revision: ~source_fixture_revision,
        source_revision: ~source_revision, oracle_id: ~lesson.oracle.id, oracle_revision: ~oracle_revision,
        status: "in_progress", phase: "prediction", prediction_initial: "pending", prediction: "pending",
        prediction_response: "", prediction_measured: false, reveal_shown: false,
        evidence_status: "unknown", evidence_source_revision: "", derivation_ref: None,
        reason_completed: false, source_completed: false, controlled_completed: false, controlled_revision: "",
        transfer_completed: false, transfer_revision: "", transfer_evidence: false, stale_reason: None,
    }
}
// Rust Progress::reset_for_stale (CmdLearn.rs:181-201).
pub fn jet_cli_learn_progress_reset_for_stale(progress: &JetCLILearnProgress, reason: String, source_revision: String) Never! {
    progress.status = "stale"
    progress.phase = "prediction"
    progress.source_revision = ~source_revision
    progress.prediction_initial = "pending"
    progress.prediction = "pending"
    progress.prediction_response = ""
    progress.prediction_measured = false
    progress.reveal_shown = false
    progress.evidence_status = "stale"
    progress.evidence_source_revision = ""
    progress.derivation_ref = None
    progress.reason_completed = false
    progress.source_completed = false
    progress.controlled_completed = false
    progress.controlled_revision = ""
    progress.transfer_completed = false
    progress.transfer_revision = ""
    progress.transfer_evidence = false
    progress.stale_reason = Val(~reason)
}
// Rust Progress::update_phase (CmdLearn.rs:203-237), including status precedence.
pub fn jet_cli_learn_progress_update_phase(progress: &JetCLILearnProgress) Never! {
    progress.phase = if {
        !progress.source_completed -> "source"
        !progress.prediction_measured -> "prediction"
        progress.evidence_status != "current" -> "evidence"
        !progress.reason_completed -> "reason"
        !progress.controlled_completed -> "controlled_change"
        !progress.transfer_completed || !progress.transfer_evidence -> "transfer"
        else -> "complete"
    }
    progress.status = if {
        progress.phase == "complete" && progress.prediction_measured && progress.prediction != "unknown" && progress.prediction != "unmeasured" && progress.evidence_status == "current" && progress.stale_reason == None && progress.transfer_evidence -> "completed"
        progress.status == "cancelled" -> "cancelled"
        progress.evidence_status == "unavailable" -> "unavailable"
        progress.stale_reason != None -> "stale"
        else -> "in_progress"
    }
}
// Rust Progress::complete (CmdLearn.rs:239-241).
pub fn jet_cli_learn_progress_complete(progress: JetCLILearnProgress) -> Bool Never! { progress.status == "completed" }

// Rust parse_json(_, true) bound (EncodingJson.rs MAX_JSON_DEPTH).
fn jet_cli_learn_parse_json(text: String, label: String) -> DataTree Err! {
    limits :: EncodingLimits{buffer_bytes: 65536, max_depth: 64, max_item_bytes: text.bytes().len(), max_total_bytes: None, max_expansion_depth: 32, max_expansion_bytes: 8388608}
    learn_json.parse_with_limits(text, limits) ?? return Err("{label} at line {err.line ?? 1}: {err.reason}")
}
// Rust load_curriculum (CmdLearn.rs:413-469). Input bytes bind the revision.
pub fn jet_cli_learn_load_curriculum<F: JetCLILearnFixtures>(text: String, fixtures: F) -> JetCLILearnCurriculum Err! {
    value :: jet_cli_learn_parse_json(text, "invalid JSON")
    if value == .Object(object) {
        schema :: jet_cli_learn_required_text(object, "schema", "curriculum")
        if schema != JET_CLI_LEARN_CURRICULUM_SCHEMA -> return Err("unsupported curriculum schema `{schema}`")
        relation :: jet_cli_learn_required_text(object, "relation", "curriculum")
        if relation != JET_CLI_LEARN_CENSUS_RELATION -> return Err("curriculum must project `{JET_CLI_LEARN_CENSUS_RELATION}`, got `{relation}`")
        relation_source :: jet_cli_learn_required_text(object, "relation_source", "curriculum")
        if relation_source != JET_CLI_LEARN_CENSUS_SOURCE -> return Err("curriculum must use `{JET_CLI_LEARN_CENSUS_SOURCE}`, got `{relation_source}`")
        revision_rule :: jet_cli_learn_required_text(object, "revision_rule", "curriculum")
        if revision_rule != JET_CLI_LEARN_REVISION_RULE -> return Err("curriculum revision rule does not match the census contract")
        jet_cli_learn_require_field(object, "tasks", "curriculum")
        if object["tasks"] == .Array(values) {
            tasks := [JetCLILearningTask]{}
            ids := [String:Bool]{}
            capabilities := [String:Bool]{}
            loop (index, task_value) in values {
                lesson :: jet_cli_learn_parse_task(task_value, index, fixtures)
                if ids.has_key(lesson.id) -> return Err("duplicate curriculum task `{lesson.id}`")
                if capabilities.has_key(lesson.capability_id) -> return Err("duplicate curriculum capability `{lesson.capability_id}`")
                ids[lesson.id] = true
                capabilities[lesson.capability_id] = true
                &tasks.push(^lesson)
            }
            if tasks.is_empty() -> return Err("curriculum has no lessons")
            return Ok(JetCLILearnCurriculum{relation: relation, relation_source: relation_source, revision_rule: revision_rule, tasks: ^tasks, revision: mir_sha256_hex(text)})
        }
        return Err("curriculum tasks must be an array: expected a DataTree array")
    }
    return Err("curriculum root must be an object: expected a DataTree object")
}
// Rust parse_task (CmdLearn.rs:471-563); borrowed object/array projections.
pub fn jet_cli_learn_parse_task<F: JetCLILearnFixtures>(value: DataTree, index: Int, fixtures: F) -> JetCLILearningTask Err! {
    if value == .Object(object) {
        id :: jet_cli_learn_required_text(object, "id", "task")
        capability_id :: jet_cli_learn_required_text(object, "capability_id", id)
        census_task_id :: jet_cli_learn_required_text(object, "census_task_id", id)
        if !census_task_id.ends_with(".predict") -> return Err("{id}.census_task_id must name the canonical predict task")
        family :: jet_cli_learn_required_text(object, "family", id)
        axis :: jet_cli_learn_required_text(object, "axis", id)
        if axis != "predict" -> return Err("{id}.axis must be predict")
        concept :: jet_cli_learn_required_text(object, "concept", id)
        prerequisites :: jet_cli_learn_text_array(object, "prerequisites", id)
        prompt :: jet_cli_learn_required_text(object, "prompt", id)
        wrong_model :: jet_cli_learn_required_text(object, "wrong_model", id)
        jet_cli_learn_require_field(object, "source", id)
        source :: jet_cli_learn_parse_fixture(object["source"], "{id}.source")
        jet_cli_learn_require_field(object, "input_identity", id)
        input_identity :: jet_cli_learn_parse_input_identity(object["input_identity"], id)
        jet_cli_learn_require_field(object, "oracle", id)
        oracle :: jet_cli_learn_parse_oracle(object["oracle"], id)
        jet_cli_learn_require_field(object, "reveal", id)
        reveal :: jet_cli_learn_parse_reveal(object["reveal"], id)
        jet_cli_learn_require_field(object, "controlled_edit", id)
        controlled_edit :: jet_cli_learn_parse_fixture(object["controlled_edit"], "{id}.controlled_edit")
        jet_cli_learn_require_field(object, "transfer", id)
        transfer :: jet_cli_learn_parse_transfer(object["transfer"], id)
        jet_cli_learn_require_field(object, "accessibility", id)
        accessibility :: jet_cli_learn_parse_accessibility(object["accessibility"], id)
        jet_cli_learn_validate_fixture(source, id, fixtures)
        jet_cli_learn_validate_fixture(controlled_edit, id, fixtures)
        jet_cli_learn_validate_fixture(transfer.fixture, id, fixtures)
        if input_identity.path != source.path -> return Err("{id}.input_identity.path must match source.path")
        if oracle.expected_output != source.expected_output -> return Err("{id}.oracle.expected_output must match source.expected_output")
        if reveal.policy != "predict_then_reveal" -> return Err("{id}.reveal.policy must be predict_then_reveal")
        return Ok(JetCLILearningTask{id: id, capability_id: capability_id, census_task_id: census_task_id, family: family, axis: axis, concept: concept, prerequisites: prerequisites, prompt: prompt, wrong_model: wrong_model, source: source, input_identity: input_identity, oracle: oracle, reveal: reveal, controlled_edit: controlled_edit, transfer: transfer, accessibility: accessibility})
    }
    return Err("task {index} must be an object: expected a DataTree object")
}
// Rust parse_task Transfer construction (CmdLearn.rs:514-525).
fn jet_cli_learn_parse_transfer(value: DataTree, label: String) -> JetCLILearnTransfer Err! {
    if value == .Object(object) {
        return Ok(JetCLILearnTransfer{fixture: jet_cli_learn_parse_fixture(value, "{label}.transfer"), structural_difference: jet_cli_learn_required_text(object, "structural_difference", label), copy_guard: jet_cli_learn_required_text(object, "copy_guard", label)})
    }
    return Err("{label}.transfer must be an object: expected a DataTree object")
}
