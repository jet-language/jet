// Source-bound learning curriculum, progress, actions and presentation.
// Native execution/IO remain gated by #4494/#4483/#4409; see the exact Rust
// anchor gates below. These pure bodies never manufacture checked evidence.
use core.encoding.[DataTree, EncodingLimits]
use core.encoding.json as learn_json
use jet_foundation.[StatusFields, StatusValue, StatusEnvelope, DerivationRecord, Diagnostic, derivation_record_status_value, mir_sha256_hex, mir_sha256_bytes, mir_sha256_hex_bytes, json_escape, diagnostic_utf8_width, diagnostic_is_whitespace_at, diagnostic_theme_paint, diagnostic_theme_accent, diagnostic_theme_dim, diagnostic_theme_bold]

// Rust constants (CmdLearn.rs:25-31); authored bytes are embedded below.
JET_CLI_LEARN_DIR :: ".jet/learn/feedback"
JET_CLI_LEARN_CURRICULUM_SCHEMA :: "jet-learning-curriculum-v1"
JET_CLI_LEARN_CENSUS_RELATION :: "jet-learning-census-v1"
JET_CLI_LEARN_CENSUS_SOURCE :: "Examples/learn/curriculum.json"
JET_CLI_LEARN_PROGRESS_SCHEMA :: "jet-learn-progress-v1"
JET_CLI_LEARN_REVISION_RULE :: "source-bound observations are valid only when source_identity.digest matches; a source edit invalidates the observation until the dependent projection is regenerated and the task is re-run"


