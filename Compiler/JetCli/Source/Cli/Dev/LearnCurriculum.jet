// Rust Evaluation: only the evaluator may create these outcomes. Problems
// retain canonical diagnostics, never a made-up reason or success sentinel.
pub enum JetCLILearnEvaluation {
    Complete(stdout: String, stderr: String, derivation: DerivationRecord?)
    Problems(diagnostics: [Diagnostic])
    WrongOutput(stdout: String, stderr: String, derivation: DerivationRecord?)
}
pub fn jet_cli_learn_evaluation_complete(value: JetCLILearnEvaluation) -> Bool Never! {
    if value == .Complete(_, _, _) -> return true
    false
}
pub fn jet_cli_learn_evaluation_derivation(value: JetCLILearnEvaluation) -> DerivationRecord? Never! {
    if value == {
        .Complete(_, _, derivation) -> derivation
        .WrongOutput(_, _, derivation) -> derivation
        .Problems(_) -> None
    }
}
pub fn jet_cli_learn_evaluation_kind(value: JetCLILearnEvaluation) -> String Never! {
    if value == {
        .Complete(_, _, _) -> "complete"
        .Problems(_) -> "diagnostic"
        .WrongOutput(_, _, _) -> "wrong-output"
    }
}

// Rust Actions::from_stdin collection half: IO/IsTerminal remains #4494.
pub struct JetCLILearnActions { pub lines: [String], pub next: Int, pub interactive: Bool }
pub fn jet_cli_learn_actions_from_text(text: String) -> JetCLILearnActions Never! {
    lines := [String]{}
    loop line in jet_cli_learn_lines(text) {
        trimmed := line.trim() // #4303
        if !trimmed.is_empty() -> &lines.push(~trimmed)
    }
    JetCLILearnActions{lines: ^lines, next: 0, interactive: false}
}
// Rust Actions::next buffered branch; interactive readline/flush is gated.
pub fn jet_cli_learn_actions_next_buffered(actions: &JetCLILearnActions) -> JetCLILearnAction? Never! {
    loop actions.next < actions.lines.len() {
        action :: jet_cli_learn_parse_action(actions.lines[actions.next])
        actions.next += 1
        if action != None -> return action
    }
    None
}

// Rust str::lines: LF or CRLF only, no terminal empty row; lone CR retained.
fn jet_cli_learn_lines(text: String) -> [String] Never! {
    raw :: text.bytes()
    rows := [String]{}
    start := 0
    loop index in 0..<raw.len() {
        if raw[index] != (U8{10}) -> next
        end :: if index > start && raw[index - 1] == (U8{13}) -> index - 1 else -> index
        &rows.push(String.from_bytes(raw[start..<end]) ?? panic("line is UTF-8"))
        start = index + 1
    }
    if start < raw.len() -> &rows.push(String.from_bytes(raw[start..<raw.len()]) ?? panic("line is UTF-8"))
    rows
}

// Rust LearnStyle::new: active_profile is supplied by the one CLI output owner.
pub struct JetCLILearnStyle { pub color: Bool, pub width: Int, pub unicode: Bool }
pub fn jet_cli_learn_style_new(profile: JetCLIOutputProfile?, fallback_color: Bool) -> JetCLILearnStyle Never! {
    if profile == .Val(active) {
        return JetCLILearnStyle{color: active.ansi_enabled, width: if active.width < 24 -> 24 else if active.width > 96 -> 96 else -> active.width, unicode: active.unicode_enabled}
    }
    JetCLILearnStyle{color: fallback_color, width: 80, unicode: false}
}
pub fn jet_cli_learn_horizontal(style: JetCLILearnStyle) -> String Never! { if style.unicode -> "─" else -> "-" }
pub fn jet_cli_learn_vertical(style: JetCLILearnStyle) -> String Never! { if style.unicode -> "│" else -> "|" }
pub fn jet_cli_learn_visible_cols(text: String) -> Int Never! {
    raw :: text.bytes()
    at := 0
    columns := 0
    escaped := false
    loop at < raw.len() {
        code :: Int.from_u8(raw[at])
        if escaped {
            if code == 109 -> escaped = false
        } else {
            if code == 27 -> escaped = true else -> columns += 1
        }
        at += diagnostic_utf8_width(raw, at)
    }
    columns
}
// Same whitespace split as wrap_plain; byte cursor avoids a char-array copy.
// Each row visits at most width scalars and advances at least one.
pub fn jet_cli_learn_wrap_plain(text: String, requested: Int) -> [String] Never! {
    width :: if requested < 1 -> 1 else -> requested
    if text.is_empty() -> return [String]{""}
    raw :: text.bytes()
    rows := [String]{}
    start := 0
    loop start < raw.len() {
        end := start
        count := 0
        split := start
        loop end < raw.len() && count < width {
            space :: diagnostic_is_whitespace_at(raw, end)
            end += diagnostic_utf8_width(raw, end)
            count += 1
            if space -> split = end
        }
        if end < raw.len() && split > start -> end = split
        &rows.push(String.from_bytes(raw[start..<end]) ?? panic("wrapped row is UTF-8"))
        start = end
    }
    rows
}
pub fn jet_cli_learn_pad_plain(text: String, width: Int) -> String Never! {
    columns :: jet_cli_learn_visible_cols(text)
    if columns >= width -> return ~text
    "{text}{" ".repeat(width - columns)}"
}
fn jet_cli_learn_sub(left: Int, right: Int) -> Int Never! { if left > right -> left - right else -> 0 }
pub fn jet_cli_learn_frame(style: JetCLILearnStyle, title: String, rows: [String]) -> String Never! {
    inner :: if style.width > 4 -> style.width - 4 else -> 1
    horizontal :: jet_cli_learn_horizontal(style)
    vertical :: diagnostic_theme_paint(style.color, "90", jet_cli_learn_vertical(style))
    prefix :: "{if style.unicode -> "╭" else -> "+"}{horizontal} "
    fill :: jet_cli_learn_sub(style.width, jet_cli_learn_visible_cols(prefix) + jet_cli_learn_visible_cols(title) + 2)
    suffix :: " {horizontal.repeat(fill)}{if style.unicode -> "╮" else -> "+"}"
    out := [U8]{}
    jet_cli_learn_append(&out, diagnostic_theme_paint(style.color, "90", prefix))
    jet_cli_learn_append(&out, diagnostic_theme_accent(style.color, title))
    jet_cli_learn_append(&out, diagnostic_theme_paint(style.color, "90", suffix))
    &out.push(U8{10})
    loop row in rows {
        loop wrapped in jet_cli_learn_wrap_plain(row, inner) {
            jet_cli_learn_append(&out, "{vertical} {jet_cli_learn_pad_plain(wrapped, inner)} {vertical}\n")
        }
    }
    bottom :: "{if style.unicode -> "╰" else -> "+"}{horizontal.repeat(jet_cli_learn_sub(style.width, 2))}{if style.unicode -> "╯" else -> "+"}"
    jet_cli_learn_append(&out, diagnostic_theme_paint(style.color, "90", bottom))
    String.from_bytes(out) ?? panic("learn frame is UTF-8")
}
pub fn jet_cli_learn_status_line(style: JetCLILearnStyle, kind: String, message: String) -> String Never! {
    badge :: if kind == {
        "success" -> diagnostic_theme_paint(style.color, "32", "PASS")
        "error" -> diagnostic_theme_paint(style.color, "31", "CHECK")
        "hint" -> diagnostic_theme_paint(style.color, "33", "HELP")
        "stale" -> diagnostic_theme_paint(style.color, "33", "STALE")
        "resume" -> diagnostic_theme_accent(style.color, "RESUME")
        "paused" -> diagnostic_theme_paint(style.color, "33", "PAUSED")
        else -> diagnostic_theme_accent(style.color, kind)
    }
    "{badge} {message}"
}
pub fn jet_cli_learn_action_help(style: JetCLILearnStyle) -> String Never! {
    "{diagnostic_theme_dim(style.color, "Commands:")} {diagnostic_theme_dim(style.color, "predict <answer>  unknown  skip  help  reason  cancel")}"
}
pub fn jet_cli_learn_action_prompt(style: JetCLILearnStyle, prompt: String) -> String Never! {
    "{diagnostic_theme_accent(style.color, "learn>")} {diagnostic_theme_bold(style.color, prompt)}"
}
pub fn jet_cli_learn_step_rail(style: JetCLILearnStyle, progress: JetCLILearnProgress) -> String Never! {
    current :: jet_cli_learn_step_name(progress)
    steps :: [String]{"PREDICT", "CHECK", "CHANGE", "TRANSFER"}
    current_index := 0
    loop (index, step) in steps { if step == current -> current_index = index }
    rendered := [String]{diagnostic_theme_dim(style.color, "Steps")}
    loop (index, step) in steps {
        label :: "[{step}]"
        &rendered.push(if index == current_index -> diagnostic_theme_paint(style.color, "48;5;24;97;1", label) else if index < current_index -> diagnostic_theme_paint(style.color, "32", label) else -> diagnostic_theme_dim(style.color, label))
    }
    rendered.join("  ")
}
// source_rows text half; native read/error fallback belongs to #4494.
pub fn jet_cli_learn_source_rows(source: String) -> [String] Never! {
    rows := [String]{}
    loop (index, line) in jet_cli_learn_lines(source) {
        number :: "{index + 1}"
        &rows.push("{" ".repeat(jet_cli_learn_sub(3, number.bytes().len()))}{number} | {line}")
    }
    rows
}
pub fn jet_cli_learn_bounded_output_rows(value: String, unicode: Bool) -> [String] Never! {
    raw :: value.bytes()
    rows := [String]{}
    start := 0
    loop start < raw.len() {
        if rows.len() == 8 { &rows.push("... more output omitted"); break }
        end := start
        loop end < raw.len() && raw[end] != (U8{10}) -> end += 1
        content_end :: if end < raw.len() && end > start && raw[end - 1] == (U8{13}) -> end - 1 else -> end
        at := start
        columns := 0
        loop at < content_end && columns < 120 {
            at += diagnostic_utf8_width(raw, at)
            columns += 1
        }
        display :: String.from_bytes(raw[start..<at]) ?? panic("output row is UTF-8")
        &rows.push(if at < content_end -> "{display}{if unicode -> "…" else -> "..."}" else -> display)
        start = end + 1
    }
    if rows.is_empty() -> &rows.push("(no output)")
    rows
}
pub fn jet_cli_learn_output_comparison(style: JetCLILearnStyle, expected: String, actual: String, stderr: String) -> String Never! {
    rows := [String]{"Expected output:"}
    loop row in jet_cli_learn_bounded_output_rows(expected, style.unicode) -> &rows.push(^row)
    &rows.push("")
    &rows.push("Actual output:")
    loop row in jet_cli_learn_bounded_output_rows(actual, style.unicode) -> &rows.push(^row)
    if !stderr.is_empty() {
        &rows.push("")
        &rows.push("Stderr:")
        loop row in jet_cli_learn_bounded_output_rows(stderr, style.unicode) -> &rows.push(^row)
    }
    jet_cli_learn_frame(style, "output", rows)
}

// apply_prediction's policy is shared with both prediction loops.
pub fn jet_cli_learn_apply_prediction(lesson: JetCLILearningTask, progress: &JetCLILearnProgress, answer: ^String) -> Bool Never! {
    correct :: jet_cli_learn_prediction_matches(lesson, answer)
    result :: if correct -> "correct" else -> "incorrect"
    if progress.prediction_initial == "pending" -> progress.prediction_initial = result
    progress.prediction = result
    progress.prediction_response = ^answer
    progress.prediction_measured = true
    correct
}
pub fn jet_cli_learn_show_skip(style: JetCLILearnStyle) -> String Never! {
    "{jet_cli_learn_status_line(style, "hint", "Prediction skipped. It stays unmeasured and cannot complete this lesson.")}\n"
}
pub fn jet_cli_learn_show_reveal(lesson: JetCLILearningTask, style: JetCLILearnStyle) -> String Never! {
    "{jet_cli_learn_frame(style, "Help", [String]{"Why: {lesson.reveal.reason}", "Try this: {lesson.reveal.counterexample}", "Common mistake: {lesson.wrong_model}"})}\n"
}

// Exact native gates, not callable declarations or successful fallbacks:
// run347/run_task751/drive_fixture1169/exit_check_curriculum2132/
// validate_curriculum2200 require actual retained FS and OS-path ingress,
// SystemTime nanoseconds/PID, stdin terminal/readline/read-all/flush and close.
// materialize1781 uses exists -> packaged NotFound -> write(create/truncate);
// digest_file1798 uses read_bytes -> SHA256; load_progress1827 distinguishes
// NotFound; save_progress1888 creates parent -> json.tmp write -> rename.
// Native producers: core.files.host.retained_descriptor (#4494/#4409),
// core.sys.host.os_path_ingress / retained_clock (#4494/#4483).
// evaluate1199 needs Driver's actual development-iteration run + checked
// snapshot (no published callable yet), then SAME SemIndex producer
// jet_semindex.semindex_from_checked (port-tools, no independently recheck).
// watch_until_changed1734 needs packet0794 WatchSession.open/poll/acknowledge
// and scheduler_sleep_ms(120); WatchPolicy alone cannot supply any receipt.
// #4499 is not used: ids/capability sets are String keys (load_curriculum443).

// Rust run argument vocabulary: validate before any curriculum/FS read.
pub struct JetCLILearnOptions { pub check: Bool, pub once: Bool }
pub fn jet_cli_learn_options(args: [String]) -> JetCLILearnOptions Err! {
    check := false
    once := false
    loop arg in args {
        if arg == {
            "--check" -> check = true
            "--watch=off" -> once = true
            "--watch" | "--watch=on" | "--watch=true" | "--json" | "--quiet" | "--color" -> {}
            else -> { if !arg.starts_with("--color=") -> return Err("{arg} is not a jet learn argument") }
        }
    }
    Ok(JetCLILearnOptions{check: check, once: once})
}

// Rust run_task804–829: reset precedence and cancelled-checkpoint resumption.
pub fn jet_cli_learn_reconcile(progress: &JetCLILearnProgress, curriculum: JetCLILearnCurriculum, lesson: JetCLILearningTask, fixture_revision: ^String, source_revision: ^String, oracle_revision: ^String) Never! {
    if progress.task_id != lesson.id || progress.curriculum_revision != curriculum.revision || progress.oracle_revision != oracle_revision || progress.source_fixture_revision != fixture_revision || progress.source_revision != source_revision {
        reason :: if {
            progress.curriculum_revision != curriculum.revision -> "lesson content changed"
            progress.oracle_revision != oracle_revision -> "lesson answer changed"
            progress.source_fixture_revision != fixture_revision -> "packaged lesson source changed"
            else -> "source changed: {lesson.source.path}"
        }
        progress.curriculum_revision = ~curriculum.revision
        progress.oracle_revision = ^oracle_revision
        progress.source_fixture_revision = ^fixture_revision
        jet_cli_learn_progress_reset_for_stale(&progress, reason, ^source_revision)
    }
    if progress.status == "cancelled" && progress.stale_reason == Val("learner cancelled this checkpoint") {
        progress.status = "in_progress"
        progress.stale_reason = None
    }
    jet_cli_learn_progress_update_phase(&progress)
}
// Rust run_task prediction loops share these exact unknown/skip/cancel writes.
pub fn jet_cli_learn_prediction_unknown(progress: &JetCLILearnProgress) Never! {
    progress.prediction_initial = "unknown"
    progress.prediction = "unknown"
    progress.prediction_response = "I do not know"
    progress.reveal_shown = true
}
pub fn jet_cli_learn_prediction_skip(progress: &JetCLILearnProgress) Never! {
    progress.prediction_initial = "unmeasured"
    progress.prediction = "unmeasured"
    progress.prediction_response = "skip"
}
pub fn jet_cli_learn_cancel(progress: &JetCLILearnProgress) Never! {
    progress.status = "cancelled"
    progress.stale_reason = Val("learner cancelled this checkpoint")
}
// Rust run_task911–923: actual checked derivation only; absence is unavailable.
pub fn jet_cli_learn_primary_checked(progress: &JetCLILearnProgress, revision: ^String, derivation: DerivationRecord?) Never! {
    progress.source_completed = true
    progress.source_revision = ^revision
    progress.stale_reason = None
    progress.evidence_source_revision = ~progress.source_revision
    if derivation == {
        .Val(record) -> {
            progress.evidence_status = "current"
            progress.derivation_ref = Val(~record.id)
        }
        .None -> {
            progress.evidence_status = "unavailable"
            progress.derivation_ref = None
        }
    }
}
pub fn jet_cli_learn_controlled_changed(progress: &JetCLILearnProgress, revision: String) Never! {
    if progress.controlled_completed && revision != progress.controlled_revision {
        progress.controlled_completed = false
        progress.transfer_completed = false
        progress.transfer_evidence = false
        progress.status = "stale"
        progress.stale_reason = Val("controlled edit source changed")
    }
}
pub fn jet_cli_learn_transfer_changed(progress: &JetCLILearnProgress, revision: String) Never! {
    if progress.transfer_completed && revision != progress.transfer_revision {
        progress.transfer_completed = false
        progress.transfer_evidence = false
        progress.status = "stale"
        progress.stale_reason = Val("transfer source changed")
    }
}
// Rust validate_curriculum2222–2253, policy after the actual fixture runs.
pub fn jet_cli_learn_validate_evaluations(lesson: JetCLILearningTask, fixture: JetCLILearnFixture, label: String, broken: JetCLILearnEvaluation, solved: JetCLILearnEvaluation) Err! {
    matches_failure :: if fixture.failure == {
        "diagnostic" -> jet_cli_learn_evaluation_kind(broken) == "diagnostic"
        "output" -> jet_cli_learn_evaluation_kind(broken) == "wrong-output"
        else -> false
    }
    if !matches_failure -> return Err("{lesson.id} {label} expected {fixture.failure} failure, got \"{jet_cli_learn_evaluation_kind(broken)}\"")
    if !jet_cli_learn_evaluation_complete(solved) -> return Err("{lesson.id} {label} solution failed: {jet_cli_learn_evaluation_kind(solved)}")
    if jet_cli_learn_evaluation_derivation(solved) == None -> return Err("{lesson.id} {label} solved without current checked evidence")
}

fn jet_cli_learn_status_optional(value: String?) -> StatusValue Never! {
    if value == { .Val(text) -> StatusValue.String{value: ~text} .None -> StatusValue.Null }
}
// Rust print_status1946–2004: preserve every field, with typed Report values.
pub fn jet_cli_learn_status_value(lesson: JetCLILearningTask, progress: JetCLILearnProgress, derivation: DerivationRecord?) -> StatusValue Never! {
    source := StatusFields.new()
    source = ^source.with("path", StatusValue.String{value: ~lesson.source.path})
    source = ^source.with("digest", StatusValue.String{value: ~progress.source_revision})
    source = ^source.with("packaged_digest", StatusValue.String{value: ~progress.source_fixture_revision})
    input := StatusFields.new()
    input = ^input.with("path", StatusValue.String{value: ~lesson.input_identity.path})
    input = ^input.with("role", StatusValue.String{value: ~lesson.input_identity.role})
    input = ^input.with("revision", StatusValue.String{value: ~lesson.input_identity.revision})
    oracle := StatusFields.new()
    oracle = ^oracle.with("id", StatusValue.String{value: ~lesson.oracle.id})
    oracle = ^oracle.with("revision", StatusValue.String{value: ~progress.oracle_revision})
    oracle = ^oracle.with("kind", StatusValue.String{value: ~lesson.oracle.kind})
    oracle = ^oracle.with("answer", StatusValue.String{value: ~lesson.oracle.answer})
    oracle = ^oracle.with("expected_output", StatusValue.String{value: ~lesson.oracle.expected_output})
    oracle = ^oracle.with("distinguishes", StatusValue.String{value: ~lesson.oracle.distinguishes})
    prediction := StatusFields.new()
    prediction = ^prediction.with("initial", StatusValue.String{value: ~progress.prediction_initial})
    prediction = ^prediction.with("result", StatusValue.String{value: ~progress.prediction})
    prediction = ^prediction.with("response", StatusValue.String{value: ~progress.prediction_response})
    prediction = ^prediction.with("measured", StatusValue.Bool{value: progress.prediction_measured})
    reveal := StatusFields.new()
    reveal = ^reveal.with("policy", StatusValue.String{value: ~lesson.reveal.policy})
    reveal = ^reveal.with("shown", StatusValue.Bool{value: progress.reveal_shown})
    reveal = ^reveal.with("evidence", StatusValue.String{value: ~lesson.reveal.evidence})
    reveal = ^reveal.with("reason", StatusValue.String{value: ~lesson.reveal.reason})
    reveal = ^reveal.with("counterexample", StatusValue.String{value: ~lesson.reveal.counterexample})
    evidence := StatusFields.new()
    evidence = ^evidence.with("status", StatusValue.String{value: ~progress.evidence_status})
    evidence = ^evidence.with("source_digest", StatusValue.String{value: ~progress.evidence_source_revision})
    evidence = ^evidence.with("derivation_ref", jet_cli_learn_status_optional(progress.derivation_ref))
    record_value :: if derivation == { .Val(record) -> derivation_record_status_value(record) .None -> StatusValue.Null }
    evidence = ^evidence.with("derivation", ^record_value)
    completion := StatusFields.new()
    completion = ^completion.with("source", StatusValue.Bool{value: progress.source_completed})
    completion = ^completion.with("controlled_change", StatusValue.Bool{value: progress.controlled_completed})
    completion = ^completion.with("transfer", StatusValue.Bool{value: progress.transfer_completed})
    completion = ^completion.with("transfer_evidence", StatusValue.Bool{value: progress.transfer_evidence})
    accessibility := StatusFields.new()
    accessibility = ^accessibility.with("keyboard", StatusValue.Bool{value: lesson.accessibility.keyboard})
    accessibility = ^accessibility.with("text_only", StatusValue.Bool{value: lesson.accessibility.text_only})
    accessibility = ^accessibility.with("reduced_motion", StatusValue.Bool{value: lesson.accessibility.reduced_motion})
    accessibility = ^accessibility.with("no_auto_quiz", StatusValue.Bool{value: lesson.accessibility.no_auto_quiz})
    fields := StatusFields.new()
    fields = ^fields.with("schema", StatusValue.String{value: "jet.learn/v1"})
    fields = ^fields.with("status", StatusValue.String{value: ~progress.status})
    fields = ^fields.with("phase", StatusValue.String{value: ~progress.phase})
    fields = ^fields.with("task_id", StatusValue.String{value: ~lesson.id})
    fields = ^fields.with("census_task_id", StatusValue.String{value: ~lesson.census_task_id})
    fields = ^fields.with("capability_id", StatusValue.String{value: ~lesson.capability_id})
    fields = ^fields.with("family", StatusValue.String{value: ~lesson.family})
    fields = ^fields.with("axis", StatusValue.String{value: ~lesson.axis})
    fields = ^fields.with("concept", StatusValue.String{value: ~lesson.concept})
    fields = ^fields.with("curriculum_revision", StatusValue.String{value: ~progress.curriculum_revision})
    fields = ^fields.with("source_identity", StatusValue.object(^source))
    fields = ^fields.with("input_identity", StatusValue.object(^input))
    fields = ^fields.with("oracle", StatusValue.object(^oracle))
    fields = ^fields.with("prediction", StatusValue.object(^prediction))
    fields = ^fields.with("reveal", StatusValue.object(^reveal))
    fields = ^fields.with("evidence", StatusValue.object(^evidence))
    fields = ^fields.with("completion", StatusValue.object(^completion))
    fields = ^fields.with("stale_reason", jet_cli_learn_status_optional(progress.stale_reason))
    fields = ^fields.with("accessibility", StatusValue.object(^accessibility))
    StatusValue.object(^fields)
}
pub fn jet_cli_learn_status_envelope(lesson: JetCLILearningTask, progress: JetCLILearnProgress, derivation: DerivationRecord?) -> StatusEnvelope Never! {
    StatusEnvelope.new("learn", jet_cli_learn_progress_complete(progress)).with_field("learn", jet_cli_learn_status_value(lesson, progress, derivation))
}
pub fn jet_cli_learn_complete_envelope(curriculum: JetCLILearnCurriculum) -> StatusEnvelope Never! {
    StatusEnvelope.new("learn", true)
        .with_field("curriculum", StatusValue.String{value: "feedback"})
        .with_field("relation", StatusValue.String{value: ~curriculum.relation})
        .with_field("relation_source", StatusValue.String{value: ~curriculum.relation_source})
        .with_field("witnesses", StatusValue.Integer{value: curriculum.tasks.len()})
        .with_field("revision_rule", StatusValue.String{value: ~curriculum.revision_rule})
}
pub fn jet_cli_learn_check_envelope(curriculum: JetCLILearnCurriculum) -> StatusEnvelope Never! {
    StatusEnvelope.new("learn.check", true)
        .with_field("curriculum", StatusValue.String{value: "feedback"})
        .with_field("relation", StatusValue.String{value: ~curriculum.relation})
        .with_field("witnesses", StatusValue.Integer{value: curriculum.tasks.len()})
}

// Human projections return their exact stdout bytes. The caller applies
// OutputMode.json/quiet before sending these to the actual terminal owner.
pub fn jet_cli_learn_print_status(lesson: JetCLILearningTask, progress: JetCLILearnProgress, style: JetCLILearnStyle) -> String Never! {
    if progress.status == "cancelled" -> return "{jet_cli_learn_status_line(style, "paused", "Progress saved. Run `jet learn` to resume.")}\n{jet_cli_learn_step_rail(style, progress)}\n"
    kind :: if progress.status == {
        "completed" -> "success"
        "stale" -> "stale"
        "unavailable" -> "error"
        else -> "STATUS"
    }
    rows := [String]{"Lesson: {lesson.concept}", "Source: {progress.source_path}", "Prediction: {progress.prediction}", "Check: {progress.evidence_status}", "Change: {if progress.controlled_completed -> "passed" else -> "pending"}", "Transfer: {if progress.transfer_evidence -> "passed" else -> "pending"}"}
    if progress.stale_reason == .Val(reason) -> &rows.push("Note: {reason}")
    "{jet_cli_learn_status_line(style, kind, "{progress.status} / current step: {jet_cli_learn_step_name(progress).to_ascii_lower()}")}\n{jet_cli_learn_frame(style, "progress", rows)}\n{jet_cli_learn_step_rail(style, progress)}\n"
}
pub fn jet_cli_learn_print_complete(curriculum: JetCLILearnCurriculum, style: JetCLILearnStyle) -> String Never! {
    "{jet_cli_learn_status_line(style, "success", "All {curriculum.tasks.len()} lessons are complete.")}\n{jet_cli_learn_frame(style, "JET LEARN / DONE", [String]{"Each lesson was predicted, checked, changed, and transferred.", "Run `jet learn --check` to check the packaged lessons offline."})}\n"
}
pub fn jet_cli_learn_show_execution_evidence(lesson: JetCLILearningTask, evaluation: JetCLILearnEvaluation, style: JetCLILearnStyle) -> String Never! {
    if evaluation == .Complete(stdout, stderr, derivation) {
        evidence :: if derivation == { .Val(record) -> "Checked evidence: {record.id} ({record.rule})" .None -> "Checked evidence is unavailable; this lesson cannot finish yet." }
        return "{jet_cli_learn_status_line(style, "success", "The source passed the check and printed the expected output.")}\n{jet_cli_learn_output_comparison(style, lesson.oracle.expected_output, stdout, stderr)}\n{jet_cli_learn_frame(style, "checked run", [String]{~lesson.reveal.evidence, evidence})}\n{diagnostic_theme_dim(style.color, "Next: explain why the source behaves this way.")}\n"
    }
    ""
}
pub fn jet_cli_learn_prediction_feedback(correct: Bool, answer: String, style: JetCLILearnStyle) -> String Never! {
    kind :: if correct -> "success" else -> "hint"
    message :: if correct -> "Your answer matches." else -> "Prediction recorded. Compare it with the output below."
    "{jet_cli_learn_status_line(style, kind, message)}\n{jet_cli_learn_frame(style, "prediction", [String]{"You wrote: {answer}", "Now check the source."})}\n"
}
pub fn jet_cli_learn_print_task_intro(lesson: JetCLILearningTask, progress: JetCLILearnProgress, index: Int, total: Int, display_path: String, source: String, style: JetCLILearnStyle) -> String Never! {
    out := [U8]{}
    jet_cli_learn_append(&out, "{jet_cli_learn_frame(style, "JET LEARN / {index + 1}/{total}", [String]{~lesson.concept, "Before this lesson: {lesson.prerequisites.join(", ")}"})}\n{jet_cli_learn_step_rail(style, progress)}\n")
    if progress.status == "stale" {
        if progress.stale_reason == .Val(reason) -> jet_cli_learn_append(&out, "{jet_cli_learn_status_line(style, "stale", "Saved evidence is stale because {reason}.")}\n")
    } else if progress.prediction_measured || progress.source_completed || progress.controlled_completed || progress.transfer_completed {
        jet_cli_learn_append(&out, "{jet_cli_learn_status_line(style, "resume", "Resuming at the {jet_cli_learn_step_name(progress).to_ascii_lower()} step.")}\n")
    }
    rows := [String]{"Edit {display_path}", ""}
    loop row in jet_cli_learn_source_rows(source) -> &rows.push(^row)
    jet_cli_learn_append(&out, "\n{jet_cli_learn_frame(style, "Source", rows)}\n\n{jet_cli_learn_frame(style, "Your prediction", [String]{~lesson.prompt, "", "Type predict <answer>, or unknown for an explanation."})}\n{diagnostic_theme_dim(style.color, "unknown  Explanation    skip  Leave incomplete    cancel  Save and exit")}\n")
    String.from_bytes(out) ?? panic("intro is UTF-8")
}

// Rust show_evaluation human tail. Problems' diagnostic batch is emitted
// first by the canonical report_problems owner, even in json/quiet mode;
// the source read and that dispatch remain native/integration gates.
pub fn jet_cli_learn_show_evaluation(lesson: JetCLILearningTask, display_path: String, source: String, evaluation: JetCLILearnEvaluation, style: JetCLILearnStyle) -> String Never! {
    if evaluation == {
        .Problems(_) -> "{jet_cli_learn_status_line(style, "error", "The check reported a problem.")}\n{jet_cli_learn_frame(style, "CHECK / next", [String]{"Lesson source: {display_path}", "Read the message above before editing."})}\n{jet_cli_learn_frame(style, "source", jet_cli_learn_source_rows(source))}\n{diagnostic_theme_dim(style.color, "Next: resolve the reported problem before continuing.")}\n"
        .WrongOutput(stdout, stderr, _) -> "{jet_cli_learn_status_line(style, "error", "{lesson.family} runs, but the output is not right yet.")}\n{jet_cli_learn_output_comparison(style, lesson.oracle.expected_output, stdout, stderr)}\n{jet_cli_learn_frame(style, "source / edit", jet_cli_learn_source_rows(source))}\n{diagnostic_theme_dim(style.color, "Next: edit the named target, save, and check the output again.")}\n"
        .Complete(_, _, _) -> ""
    }
}
// Rust run_task895–900; failed source check is not successful source evidence.
pub fn jet_cli_learn_primary_failed(progress: &JetCLILearnProgress, evaluation: JetCLILearnEvaluation) Never! {
    progress.source_completed = false
    progress.evidence_status = if jet_cli_learn_evaluation_kind(evaluation) == "diagnostic" -> "current" else -> "unknown"
    jet_cli_learn_progress_update_phase(&progress)
}
// Rust run_task988–991/994–995: help does not count as explaining the result.
pub fn jet_cli_learn_reason_action(progress: &JetCLILearnProgress, action: JetCLILearnAction) -> Bool Never! {
    if action == {
        .Reason -> { progress.reason_completed = true; progress.reveal_shown = true; true }
        .Reveal -> { progress.reveal_shown = true; false }
        .Cancel -> { jet_cli_learn_cancel(&progress); false }
        else -> false
    }
}
pub fn jet_cli_learn_controlled_checked(progress: &JetCLILearnProgress, revision: ^String) Never! {
    progress.controlled_completed = true
    progress.controlled_revision = ^revision
    progress.stale_reason = None
}
pub fn jet_cli_learn_transfer_checked<F: JetCLILearnFixtures>(lesson: JetCLILearningTask, progress: &JetCLILearnProgress, revision: ^String, result: JetCLILearnEvaluation, fixtures: F) Never! {
    progress.transfer_completed = true
    progress.transfer_revision = ^revision
    primary_solution :: fixtures.text(lesson.source.solution_path) ?? ""
    transfer_solution :: fixtures.text(lesson.transfer.fixture.solution_path) ?? ""
    primary_source :: fixtures.text(lesson.source.path) ?? ""
    progress.transfer_evidence = transfer_solution != primary_solution && transfer_solution != primary_source && jet_cli_learn_evaluation_complete(result)
    progress.stale_reason = None
}
pub fn jet_cli_learn_digest_text(text: String) -> String Never! { mir_sha256_hex(text) }

// Publication gates (not substitute implementations):
// - Foundation Registry/Diagnostics publishes diagnostic_is_whitespace_at in
//   port-compiler; Main propagates that same public body (no second decoder).
// - Foundation Derivations owns derivation_record_status_value (port-compiler).
// - embed_file must retain this file's origin and repository project root for
//   the 25 exact authored assets; an assembled temporary file is not the origin.
// - packet0611 InterpreterBoundary only scans execution boundaries; it is NOT
//   the development-iteration/snapshot provider. That callable is still absent
//   from the searched Eval/Driver owners and wave INDEX, not a guessed API.

// Canonical CLI output routing, no process exit or native terminal shim.
pub fn jet_cli_learn_status_output(lesson: JetCLILearningTask, progress: JetCLILearnProgress, derivation: DerivationRecord?, mode: JetCLIOutputMode, style: JetCLILearnStyle) -> JetDriverVerbOutput Never! {
    stdout :: if mode.json -> "{jet_cli_learn_status_envelope(lesson, progress, derivation).json()}\n" else if mode.quiet -> "" else -> jet_cli_learn_print_status(lesson, progress, style)
    JetDriverVerbOutput{stdout: stdout, stderr: "", exit_code: if jet_cli_learn_progress_complete(progress) -> JET_DRIVER_EXIT_OK else -> JET_DRIVER_EXIT_USER_ERROR}
}
pub fn jet_cli_learn_complete_output(curriculum: JetCLILearnCurriculum, mode: JetCLIOutputMode, style: JetCLILearnStyle) -> JetDriverVerbOutput Never! {
    stdout :: if mode.json -> "{jet_cli_learn_complete_envelope(curriculum).json()}\n" else if mode.quiet -> "" else -> jet_cli_learn_print_complete(curriculum, style)
    JetDriverVerbOutput{stdout: stdout, stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}
pub fn jet_cli_learn_check_output(curriculum: JetCLILearnCurriculum, mode: JetCLIOutputMode, style: JetCLILearnStyle) -> JetDriverVerbOutput Never! {
    stdout :: if mode.json -> "{jet_cli_learn_check_envelope(curriculum).json()}\n" else if mode.quiet -> "" else -> "{jet_cli_learn_status_line(style, "success", "Packaged lessons checked: {curriculum.tasks.len()} passed.")}\n{diagnostic_theme_dim(style.color, "No source files were changed by this check.")}\n"
    JetDriverVerbOutput{stdout: stdout, stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}
pub fn jet_cli_learn_error(code: String, message: String, fix: String, mode: JetCLIOutputMode) -> JetDriverVerbOutput Never! {
    refusal :: jet_cli_args_refuse(code, message, jet_cli_why(code), fix, mode.json)
    JetDriverVerbOutput{stdout: refusal.stdout, stderr: if !mode.json && mode.color -> jet_cli_report(code, message, jet_cli_why(code), fix, true) else -> refusal.stderr, exit_code: JET_DRIVER_EXIT_USER_ERROR}
}

// Rust evaluate1219–1232: classify actual Ran outputs. Calling the canonical
// compiler/runtime and selecting its current derivation remain separate gates.
pub fn jet_cli_learn_evaluated_run(stdout: ^String, stderr: ^String, exit_code: Int, expected_output: String, derivation: ^DerivationRecord?) -> JetCLILearnEvaluation Never! {
    if exit_code == 0 && stdout == expected_output -> return JetCLILearnEvaluation.Complete{stdout: ^stdout, stderr: ^stderr, derivation: ^derivation}
    JetCLILearnEvaluation.WrongOutput{stdout: ^stdout, stderr: ^stderr, derivation: ^derivation}
}
pub fn jet_cli_learn_watch_prompt(display_path: String, style: JetCLILearnStyle) -> String Never! {
    "{jet_cli_learn_status_line(style, "WAIT", "Watching {display_path}. Save the file to run the check again.")}\nPress Ctrl+C to exit. Run 'jet learn' to resume.\n"
}
pub fn jet_cli_learn_recheck(label: String, style: JetCLILearnStyle) -> String Never! {
    "{jet_cli_learn_status_line(style, "CHECK", "Rechecking {label}.")}\n"
}
pub fn jet_cli_learn_controlled_feedback(display_path: String, style: JetCLILearnStyle) -> String Never! {
    "{jet_cli_learn_status_line(style, "success", "The controlled change now passes the check.")}\n{jet_cli_learn_frame(style, "CHANGE / passed", [String]{"Checked file: {display_path}", "The edit changed the requested behavior and still passes the lesson check."})}\n"
}
pub fn jet_cli_learn_transfer_feedback(lesson: JetCLILearningTask, display_path: String, style: JetCLILearnStyle) -> String Never! {
    "{jet_cli_learn_status_line(style, "success", "The transfer check passes with a different source shape.")}\n{jet_cli_learn_frame(style, "TRANSFER / passed", [String]{~lesson.transfer.structural_difference, "Checked file: {display_path}"})}\n"
}
pub fn jet_cli_learn_lesson_complete(lesson: JetCLILearningTask, style: JetCLILearnStyle) -> String Never! {
    "{jet_cli_learn_frame(style, "LESSON COMPLETE", [String]{"{lesson.concept} is complete.", "You predicted, checked the source, made a controlled change, and solved a different example."})}\n"
}
