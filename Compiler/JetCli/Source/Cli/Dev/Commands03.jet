// Rust: Source/CmdDevTools.rs:4366
pub fn exit_cost_projection_error(file: String, error: &TCostReportError) -> Never {
    fix :: match error {
        .Incomplete{surfaces} -> "report the missing checked specialization for {surfaces.join(\"; \")} with this source file; its cost cannot be proved until the compiler lowers that specialization"
        .Lowering{..} -> "report this checked-TIR lowering failure with the source file"
    }
    cli_error!(@full "E2104", "cost projection for `{file}` failed", error.message(), fix)
    exit(ExitCodes.USER_ERROR)
}
