pub fn run_explain_marker(site_input: String?, key_input: String?, mode: OutputMode) -> {
    if site_input.is_none() || key_input.is_none() {
        eprintln("usage: {Syntax.BINARY_NAME} explain marker <file>:<line> <policy-key>")
        exit(ExitCodes.USAGE)
    }
    site :: site_input.unwrap()
    key :: key_input.unwrap()
    (file, line_text) :: site.rsplit_once(':').unwrap_or_else(|| -> {
        cli_error!("E2104", "marker site must be `<file>:<line>`")
        exit(ExitCodes.USAGE)
    })
    line :: line_text.parse::<USize>().ok().filter(|line| -> line > 0).unwrap_or_else(|| -> {
        cli_error!("E2104", "marker line must be a positive number")
        exit(ExitCodes.USAGE)
    })
    policy_key :: PolicyKey.parse(key).unwrap_or_else(|| -> {
        cli_error!("E2104", "`{key}` is not a registered scoped policy")
        exit(ExitCodes.USER_ERROR)
    })
    bundle :: jet.Loader.load_entry(file) ?? {
        loop diag in err -> eprintln(diag.what)
        exit(ExitCodes.USER_ERROR)
    }
    module :: bundle.modules[0]
    offset :: if line == 1 -> 0 else module.source.match_indices('\n').nth(line - 2).map(|(at, _)| -> at + 1).unwrap_or(module.source.len())
    declarations :: module.policy_declarations.iter().filter(|declaration| -> match declaration.scope {
        .Organization, .Package, .Module -> true
        .Function, .Block -> declaration.target.is_some_and(|target| -> target.start <= offset && offset <= target.end)
    }).collect()
    explanation :: jet.Explain.lookup_policy(policy_key, declarations).unwrap_or_else(|| -> {
        cli_error!("E2104", "`{key}` has no effective declaration at {site}")
        exit(ExitCodes.USER_ERROR)
    })
    print_explanation(&explanation, mode)
}

use jet.Bindgen.[BindingShape, BindingPolicy, BindingInputs, BindingPlan, BindingOperation, CountUnit, CountMeaning, PointerRetention, PointerCountFact]
use jet.ForeignBridge.[ForeignBoundaryContract, ForeignArtifactCoverage, ForeignEvidenceBasis]
use core.sys.target.[selected_os, selected_arch] // GATE #4483 selected target identity.

// Rust: Source/CmdDevTools.rs:4602
pub fn run_bind(args: &[String]) -> {
    if args.first() == .Val(format) && (format == "json" || format == "csv" || format == "sql" || format == "xml" || format == "proto") {
        run_data_bind(format, &args[1..<args.len()])
        return
    }
    if binding_plan_command(args) {
        run_binding_plan_command(args)
        return
    }
    if args.first() == .Val(root) {
        rest :: &args[1..<args.len()]
        if root == Syntax.CPP_MODULE_ROOT { run_cpp_bind(rest); return }
        if root == Syntax.COM_MODULE_ROOT { run_com_bind(rest); return }
        if root == Syntax.COBOL_MODULE_ROOT { run_cobol_bind(rest); return }
        if root == Syntax.PERL_MODULE_ROOT { run_perl_bind(rest); return }
        if root == Syntax.RUBY_MODULE_ROOT { run_ruby_bind(rest); return }
        if root == Syntax.PHP_MODULE_ROOT { run_php_bind(rest); return }
        if root == Syntax.R_MODULE_ROOT { run_r_bind(rest); return }
        if root == Syntax.PY_MODULE_ROOT { run_python_bind(rest); return }
        if root == Syntax.JS_MODULE_ROOT { run_javascript_bind(rest); return }
        if root == Syntax.OCTAVE_MODULE_ROOT { run_octave_bind(rest); return }
        if root == Syntax.PWSH_MODULE_ROOT { run_powershell_bind(rest); return }
        if root == Syntax.DART_MODULE_ROOT { run_dart_bind(rest); return }
        if root == Syntax.PASCAL_MODULE_ROOT { run_pascal_bind(rest); return }
        if root == Syntax.ADA_MODULE_ROOT { run_ada_bind(rest); return }
        if root == Syntax.TCL_MODULE_ROOT { run_tcl_bind(rest); return }
        if root == Syntax.LUA_MODULE_ROOT { run_lua_bind(rest); return }
        if root == Syntax.JAVA_MODULE_ROOT { run_java_bind(rest); return }
        if root == Syntax.CS_MODULE_ROOT { run_dotnet_bind(rest); return }
        if root == Syntax.GO_MODULE_ROOT { run_go_bind(rest); return }
        if root == Syntax.FORTRAN_MODULE_ROOT { run_fortran_bind(rest); return }
    }
    if args.is_empty() || jet.CLI.is_help_flag(args[0]) {
        eprintln("usage: {Syntax.BINARY_NAME} inspect bind <header.h> [--pkg <lib>] [--overlay <path>] [--link <lib>] [-o <out.jet>]")
        eprintln("       {Syntax.BINARY_NAME} inspect bind <json|csv|sql|xml|proto> <input> [--type <Type>] [-o <output>]")
        eprintln("")
        eprintln("Generate a C binding cache from a header (S59). The output is")
        eprintln("a `#Bindgen module c.<lib>.__bindgen__` file, by default written")
        eprintln("to .jet/bindings/c/<lib>.jet. The compiler also runs this")
        eprintln("automatically on a cache miss; `jet inspect bind` is the manual refresh.")
        exit(if args.is_empty() -> ExitCodes.USAGE else ExitCodes.OK)
    }
    header :: args[0]
    pkg := String?{None}
    out := String?{None}
    overlay_path := String?{None}
    links := [String]{}
    quiet := false
    i := 1
    loop i < args.len() {
        flag :: args[i]
        match flag {
            "--pkg", "--overlay", "--link", "-o", "--out" -> {
                value :: args.get(i + 1).unwrap_or_else(|| -> {
                    cli_error!("E2102", "`inspect bind` requires a value after `{flag}`")
                    exit(ExitCodes.USAGE)
                })
                match flag {
                    "--pkg" -> pkg = Val(value)
                    "--overlay" -> overlay_path = Val(value)
                    "--link" -> &links.push(value)
                    _ -> out = Val(value)
                }
                i += 2
            }
            "--quiet" -> { quiet = true; i += 1 }
            other -> {
                cli_error!("E2102", "unknown `inspect bind` flag `{other}`")
                eprintln("usage: {Syntax.BINARY_NAME} inspect bind <header.h> [--pkg <lib>] [--overlay <path>] [--link <lib>] [-o <out.jet>]")
                exit(ExitCodes.USAGE)
            }
        }
    }
    raw_lib :: pkg.unwrap_or_else(|| -> {
        base :: header.rsplit('/').next().unwrap_or(header)
        base.strip_suffix(".h").unwrap_or(base).to_string()
    })
    lib :: Syntax.sanitize_generated_name(raw_lib, Syntax.NameCase.Snake, "library")
    header_src :: fs.read_to_string(header) ?? bind_e3208("Could not generate bindings from `{header}`.", "the header file could not be read ({err}).", "check the path, or install the library's dev headers.")
    handle_overlay := if overlay_path == .Val(path) {
        read_c_bind_overlay(path, lib) ?? bind_e3208("Could not read C binding overlay `{path}`.", "{err}.", "write `#Import module c.{lib} {{ … }}` in the overlay file")
    } else jet.CBind.HandleOverlay.default()
    loop link in links {
        if !handle_overlay.links.contains(link) -> &handle_overlay.links.push(link)
    }
    result :: jet.CBind.generate_with_overlay(header_src, lib, &handle_overlay) ?? bind_e3208("Could not generate bindings from `{header}`.", "{err}.", "hand-write `#Import module c.{lib} {{ … }}` for the symbols you need.")
    if !result.handle_skipped.is_empty() {
        details :: result.handle_skipped.iter().map(|(handle, reason)| -> "`{handle}`: {reason}").collect::<[String]>().join("; ")
        overlay :: overlay_path.unwrap_or("<overlay>")
        bind_e3208("Could not generate bindings from `{header}`.", "opaque handle bindings were unresolved: {details}.", "add `#Close(close_function)` to `{overlay}` in the overlay")
    }
    project_root :: selected_project_root_for_path(header)
    out_path :: out.unwrap_or_else(|| -> default_binding_output(header, "c", lib))
    if OSPath.from(out_path).parent() == .Val(parent) {
        fs.create_dir_all(&parent) ?? {
            cli_error!("E2105", "could not create `{parent.display()}`: {err}")
            exit(ExitCodes.USER_ERROR)
        }
    }
    fs.write(out_path, result.source) ?? {
        cli_error!("E2105", "could not write `{out_path}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    _ :: jet.CBind.write_bind_hash(&OSPath.from(out_path), header_src, "")
    jet.CFFI.write_c_binding_metadata(&OSPath.from(out_path), &result.handles, &result.link_closure) ?? bind_e3208("Could not publish C binding metadata for `{header}`.", "{err}.", "rerun `jet inspect bind` after checking the output path")
    header_path :: fs.canonicalize(header) ?? bind_e3208("Could not publish C binding provenance for `{header}`.", "the header path could not be resolved ({err}).", "check the header path and rerun `jet inspect bind`")
    jet.CFFI.write_c_binding_provenance(&project_root, lib, &header_path, &OSPath.from(out_path)) ?? bind_e3208("Could not publish C binding provenance for `{header}`.", "{err}.", "check the project and local library paths, then rerun `jet inspect bind`")
    if !quiet {
        suffix :: if result.bound.len() == 1 -> "" else "s"
        println("bound {result.bound.len()} function{suffix} from `{header}` → {out_path}")
    }
    if !result.skipped.is_empty() {
        suffix :: if result.skipped.len() == 1 -> "" else "s"
        println("skipped {result.skipped.len()} declaration{suffix} outside the bindable subset (hand-write `#Import` for these):")
        loop (name, why) in result.skipped -> println("  - {name} — {why}")
    }
}
// Rust: Source/CmdDevTools.rs:4967
fn binding_plan_command(args: &[String]) -> Bool {
    args.iter().any(|arg| -> arg == "--shape" || arg == "--freeze" || arg == "--policy" || arg == "--accept" || arg == "--update" || arg == "--explain") || args.first() == Val("--policy")
}
// Rust: Source/CmdDevTools.rs:4976
fn run_binding_plan_command(args: &[String]) -> {
    name := String?{None}
    shape := BindingShape.Automatic
    policy := BindingPolicy?{None}
    explain := false
    freeze := false
    update := false
    preview := false
    accept := String?{None}
    i := 0
    loop i < args.len() {
        flag :: args[i]
        match flag {
            "--shape", "--policy", "--accept" -> {
                value :: args.get(i + 1).unwrap_or_else(|| -> {
                    cli_error!("E2102", "`bind` requires a value after `{flag}`")
                    exit(ExitCodes.USAGE)
                })
                match flag {
                    "--shape" -> shape = BindingShape.parse(value) ?? {
                        cli_error!("E2102", "{err}")
                        exit(ExitCodes.USAGE)
                    }
                    "--policy" -> policy = Val(BindingPolicy.parse(value) ?? {
                        cli_error!("E2102", "{err}")
                        exit(ExitCodes.USAGE)
                    })
                    _ -> { accept = Val(value); update = true }
                }
                i += 2
            }
            "--explain" -> { explain = true; i += 1 }
            "--freeze" -> { freeze = true; i += 1 }
            "--update" -> { update = true; i += 1 }
            "--preview" -> { preview = true; i += 1 }
            value -> {
                if value.starts_with('-') {
                    cli_error!("E2102", "unknown `bind` flag `{value}`")
                    exit(ExitCodes.USAGE)
                }
                if name.replace(value).is_some() {
                    cli_error!("E2102", "`bind` accepts one binding name")
                    exit(ExitCodes.USAGE)
                }
                i += 1
            }
        }
    }
    package_path :: OSPath.from("package.jet")
    project_root :: selected_project_root_for_path("package.jet")
    if policy == .Val(selected_policy) && name.is_none() {
        update_binding_package_config(&package_path, None, None, Val(selected_policy)) ?? {
            cli_error!("E2105", "{err}")
            exit(ExitCodes.USER_ERROR)
        }
        println("binding policy: {selected_policy}")
        return
    }
    binding_name :: name.unwrap_or_else(|| -> {
        cli_error!("E2102", "usage: jet bind <name> [--shape automatic|native] [--freeze]")
        exit(ExitCodes.USAGE)
    })
    header_option :: binding_header_path(&project_root, binding_name)
    if header_option.is_none() {
        if explain && read_binding_plan(&project_root, binding_name) == .Val(record) {
            print(record)
            return
        }
        cli_error!("E3208", "binding `{binding_name}` has no pinned foreign header; pass an exact header through the project binding record")
        exit(ExitCodes.USER_ERROR)
    }
    header :: header_option.unwrap()
    header_source :: fs.read_to_string(&header) ?? {
        cli_error!("E3208", "could not read binding header `{header.display()}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    lib :: Syntax.sanitize_generated_name(binding_name, Syntax.NameCase.Snake, "library")
    generated :: jet.CBind.generate_with_overlay(header_source, lib, &jet.CBind.HandleOverlay.default()) ?? {
        cli_error!("E3208", "could not generate binding `{binding_name}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    contract :: annotate_binding_contract(generated.boundary, header_source, &header) ?? {
        cli_error!("E3208", "binding `{binding_name}` has invalid canonical evidence: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    operation :: binding_operation_from_header(binding_name, header_source)
    target :: "{selected_arch()}-{selected_os()}"
    inputs :: BindingInputs.new(target, "jet-bindgen-v1", "{header.display()}:sha256-{jet.SHA256.sha256_hex(header_source.bytes())}").with_dependencies([String]{}).with_compiler_flags([String]{})
    plan :: BindingPlan.resolve(&contract, operation, inputs, shape) ?? {
        cli_error!("E3208", "{err}")
        exit(ExitCodes.USER_ERROR)
    }
    if read_binding_plan(&project_root, binding_name) == .Val(recorded) && (policy == Val(BindingPolicy.Frozen) || freeze) {
        plan.frozen_drift(recorded_digest(recorded)) ?? {
            cli_error!("E3208", "{err}")
            exit(ExitCodes.USER_ERROR)
        }
    }
    if explain { print(plan.explain()); return }
    if preview {
        print(plan.explain())
        println("preview: no package, lock, or generated facade files were written")
        return
    }
    if accept == .Val(expected) {
        if expected != plan.candidate_digest() {
            cli_error!("E3208", "`--accept` digest `{expected}` does not match candidate `{plan.candidate_digest()}`")
            exit(ExitCodes.USER_ERROR)
        }
    } else if update && !freeze && policy != Val(BindingPolicy.Frozen) {
        cli_error!("E3208", "`--update` requires `--preview` or `--accept {plan.candidate_digest()}`")
        exit(ExitCodes.USER_ERROR)
    }
    selected_plans := [String:BindingPlan]{}
    selected_plans[binding_name] = plan
    projected :: jet.CBind.generate_with_contract_and_plans(header_source, lib, &jet.CBind.HandleOverlay.default(), contract, &selected_plans) ?? {
        cli_error!("E3208", "could not materialize binding facade `{binding_name}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    write_binding_cache(&project_root, binding_name, projected.source) ?? {
        cli_error!("E2105", "{err}")
        exit(ExitCodes.USER_ERROR)
    }
    write_binding_plan(&project_root, binding_name, &plan) ?? {
        cli_error!("E2105", "{err}")
        exit(ExitCodes.USER_ERROR)
    }
    update_binding_package_config(&package_path, Val(binding_name), Val(shape), policy.or_else(|| -> if freeze -> Val(BindingPolicy.Frozen) else None)) ?? {
        cli_error!("E2105", "{err}")
        exit(ExitCodes.USER_ERROR)
    }
    write_binding_facade(&project_root, binding_name, &plan) ?? {
        cli_error!("E2105", "{err}")
        exit(ExitCodes.USER_ERROR)
    }
    println("binding plan {binding_name} ({plan.candidate_digest()})")
}
// Rust: Source/CmdDevTools.rs:5206
fn binding_header_path(project_root: &OSPath, name: String) -> OSPath? {
    candidates :: [OSPath.from(name), OSPath.from("{name}.h"), OSPath.from("include/{name}.h"), OSPath.from("ffi/{name}.h"), project_root.join(".jet").join("ffi").join("{name}.h")]
    candidates.iter().find(|path| -> path.is_file())
}
// Rust: Source/CmdDevTools.rs:5217
fn marker_value(source: String, marker: String) -> String? {
    loop line in source.lines() {
        if line.split_once(marker) == .Val((_, rest)) {
            value := rest.trim() // #4303
            stripped :: value.strip_prefix(':').unwrap_or(value)
            inner := stripped.trim() // #4303
            if !inner.is_empty() -> return Val(inner.trim_matches('"').to_string())
        }
    }
    None
}
// Rust: Source/CmdDevTools.rs:5225
fn binding_operation_from_header(name: String, source: String) -> BindingOperation {
    declaration := source.lines().map(|line| -> line.trim()).find(|line| -> line.contains("{name}(")).unwrap_or("") // #4303
    native_signature :: declaration.trim_end_matches(';').to_string()
    result_type :: declaration.split_once("{name}(").map(|(prefix, _)| -> {
        if prefix.contains("char") && prefix.contains('*') -> return "String"
        prefix.split_whitespace().last().unwrap_or("Unit").replace("const ", "")
    }).filter(|value| -> !value.is_empty()).map(|value| -> match value {
        "void" -> "Unit"
        "uint64_t", "size_t" -> "U64"
        "int", "int32_t" -> "Int"
        "float", "double" -> "Float"
        _ -> value
    }).unwrap_or("Unit")
    operation := BindingOperation.new(name, native_signature, result_type)
    if declaration.split_once("{name}(") == .Val((_, tail)) && tail.split_once(')') == .Val((params, _)) {
        parameters :: params.split(',').map(|value| -> value.trim()).collect::<[String]>() // #4303
        pointer :: parameters.iter().find(|parameter| -> parameter.contains('*')).and_then(|parameter| -> parameter.split_whitespace().last()).map(|value| -> value.trim_start_matches('*').to_string())
        count :: parameters.iter().find(|parameter| -> {
            if parameter.contains('*') -> return false
            lower :: parameter.to_ascii_lowercase()
            lower.contains("count") || lower.contains("length") || lower.contains("len") || lower == "n" || lower.ends_with(" n")
        }).and_then(|parameter| -> parameter.split_whitespace().last()).map(|value| -> value.to_string())
        if pointer == .Val(pointer_name) && count == .Val(count_name) {
            unit :: match marker_value(source, "jet-ffi-count-unit") {
                .Val("bytes") -> CountUnit.Bytes
                .Val(value) -> if value.starts_with("elements:") -> CountUnit.Elements(value[9..<value.len()].to_string()) else CountUnit.Unknown
                _ -> CountUnit.Unknown
            }
            meaning :: match marker_value(source, "jet-ffi-count-meaning") {
                .Val("full-extent") -> CountMeaning.FullExtent
                .Val("prefix") -> CountMeaning.Prefix
                _ -> CountMeaning.Unknown
            }
            width :: marker_value(source, "jet-ffi-count-width").and_then(|value| -> value.parse::<U16>().ok()).unwrap_or(0)
            retention :: match marker_value(source, "jet-ffi-retention") {
                .Val("borrowed-for-call") -> PointerRetention.BorrowedForCall
                .Val("may-retain") -> PointerRetention.MayRetain
                _ -> PointerRetention.Unknown
            }
            operation = operation.with_pointer_count(PointerCountFact.new(pointer_name, count_name, unit, meaning, width, retention))
        }
    }
    operation.nullable_return = source.contains("jet-ffi-nullable")
    operation.borrowed_view = source.contains("jet-ffi-borrowed-view")
    operation.status_out = source.contains("jet-ffi-status-out")
    operation.partial_success = source.contains("jet-ffi-partial-success")
    operation.fallible_close = source.contains("jet-ffi-fallible-close")
    operation.callback_transport = marker_value(source, "jet-ffi-callback").unwrap_or("none")
    operation.effects = marker_value(source, "jet-ffi-effects").unwrap_or("foreign")
    operation.ownership = marker_value(source, "jet-ffi-ownership").unwrap_or("signature-declared")
    operation.failure_mapping = marker_value(source, "jet-ffi-failure").unwrap_or("preserve")
    operation.copies = marker_value(source, "jet-ffi-copies").unwrap_or("none")
    operation.placement = marker_value(source, "jet-ffi-placement").unwrap_or("caller")
    operation.cleanup = marker_value(source, "jet-ffi-cleanup").unwrap_or("none")
    operation
}
// Rust: Source/CmdDevTools.rs:5325
fn annotate_binding_contract(contract_input: ForeignBoundaryContract, source: String, header: &OSPath) -> ForeignBoundaryContract Err! {
    contract := ^contract_input
    target :: "{selected_arch()}-{selected_os()}"
    coverage :: ForeignArtifactCoverage.new("{header.display()}:sha256-{jet.SHA256.sha256_hex(source.bytes())}", target, "jet-bindgen-v1")
        .with_transitive_dependencies([String]{}).with_reachable_callbacks([String]{}).with_compiler_flags([String]{})
    contract = contract.with_artifact_coverage(coverage)
    loop raw_line in source.lines() {
        if raw_line.split_once("jet-ffi-obligation:") != .Val((_, rest)) -> next
        line := rest.trim() // #4303
        obligation := String?{None}
        basis := ForeignEvidenceBasis.Unknown
        checker := ""
        assumptions := [String]{}
        loop field in line.split(';') {
            if field.split_once('=') != .Val((raw_key, raw_value)) -> next
            key := raw_key.trim() // #4303
            value := raw_value.trim() // #4303
            match key {
                "name", "obligation" -> obligation = Val(value.to_string())
                "basis" -> basis = match value {
                    "proved" -> ForeignEvidenceBasis.Proved
                    "enforced" -> ForeignEvidenceBasis.Enforced
                    "contained" -> ForeignEvidenceBasis.Contained
                    "trusted" -> ForeignEvidenceBasis.Trusted
                    "unknown" -> ForeignEvidenceBasis.Unknown
                    other -> return Err("unknown evidence basis `{other}`")
                }
                "checker" -> checker = value.to_string()
                "assumptions" -> assumptions = raw_value.split('|').map(|item| -> item.trim()).filter(|item| -> !item.is_empty()).map(|item| -> item.to_string()).collect() // #4303
                _ -> {}
            }
        }
        if obligation == .Val(name) -> contract.set_obligation(name, basis, checker, assumptions)?
        else -> return Err("an obligation marker needs `name=`")
    }
    Ok(contract)
}
// Rust: Source/CmdDevTools.rs:5388
fn binding_plan_path(project_root: &OSPath, name: String) -> OSPath {
    project_root.join(".jet").join("lock").join("bindings").join("{name}.plan")
}
// Rust: Source/CmdDevTools.rs:5396
fn read_binding_plan(project_root: &OSPath, name: String) -> String? { fs.read_to_string(binding_plan_path(project_root, name)).ok() }
// Rust: Source/CmdDevTools.rs:5400
fn recorded_digest(record: String) -> String {
    record.lines().find_map(|line| -> line.strip_prefix("digest=")).unwrap_or("")
}
// Rust: Source/CmdDevTools.rs:5407
fn write_binding_plan(project_root: &OSPath, name: String, plan: &BindingPlan) -> Unit Err! {
    path :: binding_plan_path(project_root, name)
    if path.parent() != .Val(parent) -> return Err("binding lock path has no parent")
    fs.create_dir_all(&parent) ?? return Err("could not create `{parent.display()}`: {err}")
    record := "schema=jet-ffi-binding-plan-v1\nname={name}\ndigest={plan.digest}\nshape={plan.shape}\nboundary={plan.boundary_digest}\ninputs={plan.input_digest}\nartifact={plan.artifact}\n"
    &record.push_str(plan.explain())
    &record.push_str("\nfacade:\n")
    &record.push_str(plan.render_facade())
    fs.write(&path, record) ?? return Err("could not write binding lock: {err}")
    Ok(())
}
// Rust: Source/CmdDevTools.rs:5428
fn write_binding_facade(project_root: &OSPath, name: String, plan: &BindingPlan) -> Unit Err! {
    path :: project_root.join(".jet").join("bindings").join("c").join("{name}.adapted.jet")
    if path.parent() != .Val(parent) -> return Err("binding facade path has no parent")
    fs.create_dir_all(&parent) ?? return Err("could not create `{parent.display()}`: {err}")
    fs.write(&path, plan.render_facade()) ?? return Err("could not write generated binding facade: {err}")
    Ok(())
}
// Rust: Source/CmdDevTools.rs:5447
fn write_binding_cache(project_root: &OSPath, name: String, source: String) -> Unit Err! {
    path :: project_root.join(".jet").join("bindings").join("c").join("{name}.jet")
    if path.parent() != .Val(parent) -> return Err("binding cache path has no parent")
    fs.create_dir_all(&parent) ?? return Err("could not create `{parent.display()}`: {err}")
    fs.write(&path, source) ?? return Err("could not write generated binding cache: {err}")
    Ok(())
}

