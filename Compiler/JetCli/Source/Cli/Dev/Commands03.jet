pub fn run_explain_web_graph(args: &[String], mode: OutputMode) -> {
    file := String?{None}
    loop arg in args {
        if arg.starts_with('-') -> next
        file = Val(arg)
        break
    }
    path :: file.unwrap_or_else(|| -> {
        eprintln("usage: {Syntax.BINARY_NAME} explain --web-graph <file.{Syntax.FILE_EXT}>")
        exit(ExitCodes.USAGE)
    })
    abs :: if OSPath.from(path).is_absolute() -> OSPath.from(path) else std.env.current_dir().unwrap_or(OSPath.from(".")).join(path)
    entry :: abs.display().to_string()
    (diags, _bundle, facts) :: jet.Driver.check_file_with_effect_facts(entry, None, false)
    if facts.web_app.is_none() {
        if diags.iter().any(|d| -> d.severity == Severity.Error) {
            loop diag in diags -> eprintln(jet.render_diagnostics(entry, "", &[diag]))
            exit(ExitCodes.USER_ERROR)
        }
        if mode.json -> println(StatusEnvelope.new("inspect.web", true).with_field("web_app", StatusValue.Null).json())
        else -> println("(none)")
        return
    }
    graph :: facts.web_app.unwrap()
    empty :: graph.entry_file.is_empty() && graph.routes.is_empty() && graph.actions.is_empty() && graph.mounts.is_empty() && graph.routes_from.is_empty()
    if empty {
        if diags.iter().any(|d| -> d.severity == Severity.Error) -> loop diag in diags -> eprintln(jet.render_diagnostics(entry, "", &[diag]))
        if mode.json -> println(StatusEnvelope.new("inspect.web", true).with_field("web_app", StatusValue.Null).json())
        else -> println("(none)")
        return
    }
    if mode.json {
        web_app :: StatusValue.parse(graph.to_json()).expect("web graph projection must be valid JSON")
        println(StatusEnvelope.new("inspect.web", true).with_field("web_app", web_app).json())
    } else -> loop line in graph.explain_lines() -> println(line)
}
// Rust: Source/CmdDevTools.rs:4220
pub fn run_explain(code_input: String?, fact_file: String?, mode: OutputMode, verbose: Bool, profile: String, setting_overrides: &[String:String]) -> {
    code :: code_input.unwrap_or_else(|| -> {
        eprintln("usage: {Syntax.BINARY_NAME} explain <CODE|FACT> [file]\n       {Syntax.BINARY_NAME} explain marker <file>:<line> <policy-key>")
        exit(ExitCodes.USAGE)
    })
    if jet.Explain.build_fact_name(code) == .Val(name) {
        run_explain_fact(name, fact_file, mode, profile, setting_overrides)
        return
    }
    if PolicyKey.parse(code.trim_start_matches('@')) == .Val(key) && fact_file.is_some() {
        run_explain_policy(key, fact_file, mode)
        return
    }
    if jet.Explain.lookup(code) == .Val(explanation) {
        print_explanation(&explanation, mode)
        if verbose && !mode.json && jet.Explain.syntax_internals(code) == .Val(internals) -> print("\n{internals}")
    } else {
        if jet.Explain.is_syntax_query(code) {
            closest :: jet.Explain.nearest_syntax(code).unwrap_or("a registered syntax token")
            emit_cli_row("E2106", &[("token", code), ("closest", closest)], mode.json)
            exit(ExitCodes.USER_ERROR)
        }
        cli_error!(@fix "E2104", "no diagnostic code `{code}` exists", "run a command that reports an error to see its code, e.g. `{Syntax.BINARY_NAME} check file.{Syntax.FILE_EXT}`")
        exit(ExitCodes.USER_ERROR)
    }
}
