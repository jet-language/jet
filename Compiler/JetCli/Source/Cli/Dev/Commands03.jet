// Rust: Source/CmdDevTools.rs:4449
fn print_explanation(explanation: &Explanation, mode: OutputMode) -> {
    if mode.json {
        what :: explanation.what.unwrap_or(explanation.meaning)
        optional :: |value: String?| -> value.map(StatusValue.from).unwrap_or(StatusValue.Null)
        fields :: StatusFields.new().with("code", explanation.code).with("stage", explanation.stage).with("what", what)
            .with("why", optional(explanation.why)).with("fix", optional(explanation.fix)).with("example", optional(explanation.example))
        println(StatusEnvelope.new("explain", true).with_fields(fields).json())
        return
    }
    color :: ColorChoice.resolve(mode.color, std.io.stdout().is_terminal())
    print(jet.Explain.render(explanation, color))
}
