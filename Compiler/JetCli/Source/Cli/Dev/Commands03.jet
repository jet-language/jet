pub fn run_devtools_new_ui(args: &[String]) -> {
    if args.is_empty() {
        eprintln("usage: {Syntax.BINARY_NAME} devtools new-ui <name>")
        exit(ExitCodes.USAGE)
    }
    name :: args[0]
    if name.is_empty() || name.contains('/') || name.contains('.') {
        cli_error!("E2104", "`new-ui` takes a bare fixture name, no path or extension: got `{name}`")
        exit(ExitCodes.USER_ERROR)
    }
    ext :: Syntax.FILE_EXT
    dir :: OSPath.from("tests/ui")
    jet_path :: dir.join("{name}.{ext}")
    stderr_path :: dir.join("{name}.stderr")
    if jet_path.exists() {
        cli_error!("E2104", "`{jet_path.display()}` already exists")
        exit(ExitCodes.USER_ERROR)
    }
    fs.create_dir_all(&dir) ?? {
        cli_error!("E2105", "couldn't create `{dir.display()}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    // The TODO below is original generated fixture text, not a port placeholder.
    src :: "// TODO: describe what this diagnostic demonstrates.\nfn run() {{\n    print(definitely_undefined_scaffold_symbol)\n}}\n"
    fs.write(&jet_path, src) ?? {
        cli_error!("E2105", "couldn't write `{jet_path.display()}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    shown_path :: "tests/ui/{name}.{ext}"
    actual :: match jet.compile_with_path(src, shown_path) {
        .Err(diags) -> jet.render_diagnostics(shown_path, src, &diags)
        .Ok(_) -> "(no errors)\n"
    }
    fs.write(&stderr_path, actual) ?? {
        cli_error!("E2105", "couldn't write `{stderr_path.display()}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    println("wrote {jet_path.display()}")
    println("wrote {stderr_path.display()}")
    if actual == "(no errors)\n" -> println("note: scaffold compiled cleanly — edit `{jet_path.display()}` to trigger the diagnostic you want, then `{Syntax.BINARY_NAME} devtools bless diagnostic_snapshots`")
}
// Rust: Source/CmdDevTools.rs:3735
pub fn run_devtools_check_fixture_paths() -> {
    tests_dir :: OSPath.from("tests")
    if !tests_dir.is_dir() {
        cli_error!(@fix "E2104", "no `tests/` directory here", "run from the repo root")
        exit(ExitCodes.USER_ERROR)
    }
    rs_files := [OSPath]{}
    collect_rs_files(&tests_dir, &rs_files)
    checked := 0
    missing := [(OSPath, String)]{}
    loop rs in rs_files {
        text :: fs.read_to_string(&rs).unwrap_or_default()
        loop candidate in extract_hardcoded_paths(text) {
            checked += 1
            if !OSPath.from(candidate).exists() -> &missing.push((rs, candidate))
        }
    }
    if missing.is_empty() -> println("check-fixture-paths: {checked} embedded path(s) across {rs_files.len()} file(s), all present")
    else {
        eprintln("check-fixture-paths: {missing.len()} missing path(s):")
        loop (file, path) in missing -> eprintln("  {file.display()} -> `{path}` does not exist")
        exit(ExitCodes.USER_ERROR)
    }
}
// Rust: Source/CmdDevTools.rs:3772
fn collect_rs_files(dir: &OSPath, out: &[OSPath]) -> {
    entries :: fs.read_dir(dir) ?? return
    loop entry in entries.flatten() {
        path :: entry.path()
        if path.is_dir() -> collect_rs_files(&path, out)
        else if path.extension().and_then(|s| -> s.to_str()) == Val("rs") -> &out.push(path)
    }
}
// Rust: Source/CmdDevTools.rs:3791
fn extract_hardcoded_paths(text: String) -> [String] {
    out := [String]{}
    bytes :: text.bytes()
    i := 0
    loop i < bytes.len() {
        if bytes[i] == U8{34} {
            start :: i + 1
            j := start
            loop j < bytes.len() && bytes[j] != U8{34} {
                if bytes[j] == U8{92} -> j += 1
                j += 1
            }
            if j <= text.len() {
                lit :: text[start..<j.min(text.len())]
                before_start := start.saturating_sub(40)
                loop before_start < i && !text.is_char_boundary(before_start) -> before_start += 1
                before :: text[before_start..<i]
                display_label :: before.contains("render_diagnostics(") || before.contains("render_all_colored(") || before.contains("render_all_json(")
                if !display_label && is_hardcoded_fixture_path(lit) -> &out.push(lit.to_string())
            }
            i = j + 1
        } else -> i += 1
    }
    out
}
// Rust: Source/CmdDevTools.rs:3831
fn is_hardcoded_fixture_path(lit: String) -> Bool {
    known_prefix :: lit.starts_with("Examples/features/") || lit.starts_with("Docs/spec/") || lit.starts_with("tests/ui/") || lit.starts_with("tests/ui_lint/") || lit.starts_with("tests/cli/") || lit.starts_with("tests/release/")
    if !known_prefix || lit.contains('{') || lit.contains('}') -> return false
    lit.ends_with(".{Syntax.FILE_EXT}") || lit.ends_with(".md") || lit.ends_with(".out") || lit.ends_with(".stderr") || lit.ends_with(".warn") || lit.ends_with(".txt") || lit.ends_with(".snapshot")
}
