fn run_explain_fact(name: String, fact_file: String?, mode: OutputMode, profile: String, setting_overrides: &[String:String]) -> {
    build_facts :: explain_bundle(fact_file, profile, setting_overrides)
    fact :: build_facts.contribution(name).unwrap_or_else(|| -> {
        if name.strip_prefix("Build.Settings.") == .Val(key) -> cli_error!(@full "E0302", "`build.settings.{key}` is undeclared", "settings are declared in the package manifest", "add `{key}: Type = default` to `package.jet`")
        else -> cli_error!("E2104", "the selected build has no `{name}` fact")
        exit(ExitCodes.USER_ERROR)
    })
    explanation :: jet.Explain.lookup_fact(fact.key, fact.provenance).unwrap_or_else(|| -> {
        cli_error!(@full "E3521", "the build fact contribution chain could not be resolved", "the selected fact writers must pass the shared contribution law", "remove the conflicting writer or choose one explicit contribution")
        exit(ExitCodes.USER_ERROR)
    })
    print_explanation(&explanation, mode)
}
