// Rust: Source/CmdDevTools.rs:3880
pub fn run_devtools_bless(args: &[String]) -> {
    dry_run := false
    requested := [String]{}
    loop arg in args {
        if arg == jet.CLI.DRY_RUN_FLAG -> dry_run = true else -> &requested.push(arg)
    }
    targets :: resolve_bless_targets(&requested) ?? {
        cli_error!("E2104", "unknown bless target(s): {err}")
        eprintln("usage: {Syntax.BINARY_NAME} devtools bless [target...] [--dry-run]")
        eprintln("known targets: {BLESS_TARGETS.join(\", \")}")
        exit(ExitCodes.USAGE)
    }
    if dry_run {
        loop target in targets -> println("would run: UPDATE_EXPECT=1 cargo test --test {target}")
        return
    }
    reason_raw :: std.env.var("UPDATE_EXPECT_REASON").unwrap_or_default()
    reason := reason_raw.trim() // #4303
    if reason.len() < 8 {
        cli_error!("E2104", "a blanket bless must name the compiler change it records")
        eprintln("set the reason, then re-run:\n    UPDATE_EXPECT_REASON=\"<commit or ratified decision>\" {Syntax.BINARY_NAME} self devtools bless")
        eprintln("to bless one reviewed fixture instead: JET_UI_FILTER=<fixture> UPDATE_EXPECT=<same fixture> cargo test --test diagnostic_snapshots")
        exit(ExitCodes.USAGE)
    }
    println("bless: reason recorded — {reason}")
    any_failed := false
    loop target in targets {
        println("bless: UPDATE_EXPECT=1 cargo test --test {target}")
        match bless_command(target).status() {
            .Ok(status) -> {
                if !status.success() {
                    any_failed = true
                    eprintln("bless: `{target}` exited with {status}")
                }
            }
            .Err(error) -> {
                any_failed = true
                eprintln("bless: couldn't run `cargo test --test {target}`: {error}")
            }
        }
    }
    if any_failed -> exit(ExitCodes.USER_ERROR)
    suffix :: if targets.len() == 1 -> "" else "s"
    println("bless: done ({targets.len()} target{suffix})")
}
// Rust: Source/CmdDevTools.rs:3957
pub fn resolve_bless_targets(requested: &[String]) -> [String] Err! {
    if requested.is_empty() -> return Ok(BLESS_TARGETS.to_vec())
    out := [String]{}
    unknown := [String]{}
    loop request in requested {
        if BLESS_TARGETS.iter().find(|known| -> known == request) == .Val(target) -> &out.push(target)
        else -> &unknown.push(request)
    }
    if !unknown.is_empty() -> return Err(unknown.join(", "))
    Ok(out)
}
// Rust: Source/CmdDevTools.rs:3977
pub fn bless_command(target: String) -> Command {
    cmd := Command.new("cargo")
    cmd.env("UPDATE_EXPECT", "1")
    cmd.args(["test", "--test", target])
    cmd
}
// Rust: Source/CmdDevTools.rs:3984
fn write_generated_section(path: String, fresh: String, quiet: Bool) -> {
    text :: fs.read_to_string(path) ?? {
        cli_error!("E2105", "couldn't read `{path}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    start :: text.find(Syntax.HIGHLIGHT_GENERATED_START).unwrap_or_else(|| -> {
        cli_error!("E2105", "`{path}` has no `{Syntax.HIGHLIGHT_GENERATED_START}` marker")
        exit(ExitCodes.USER_ERROR)
    })
    prefix_start :: text[0..<start].rfind('\n').map_or(0, |idx| -> idx + 1)
    after_start :: text[start..<text.len()]
    end_rel :: after_start.find(Syntax.HIGHLIGHT_GENERATED_END).unwrap_or_else(|| -> {
        cli_error!("E2105", "`{path}` has no `{Syntax.HIGHLIGHT_GENERATED_END}` marker")
        exit(ExitCodes.USER_ERROR)
    })
    end_marker :: start + end_rel + Syntax.HIGHLIGHT_GENERATED_END.len()
    suffix_start :: text[end_marker..<text.len()].find('\n').map_or(text.len(), |idx| -> end_marker + idx + 1)
    out := String.new()
    &out.push_str(text[0..<prefix_start])
    trimmed := fresh.trim_end() // #4303
    &out.push_str(trimmed)
    &out.push('\n')
    &out.push_str(text[suffix_start..<text.len()])
    fs.write(path, out) ?? {
        cli_error!("E2105", "couldn't write `{path}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    if !quiet -> println("wrote {path}")
}
// Rust: Source/CmdDevTools.rs:4038
pub fn run_doctor(online: Bool, apply: Bool, mode: OutputMode, cross_target: String?) -> {
    checks :: jet.Doctor.run(jet.Doctor.Options{online: online, cross_target: cross_target})
    color :: mode.color_stderr_for(std.io.stdout().is_terminal())
    if apply {
        fixed :: jet.Doctor.apply_fixes(&checks)
        if fixed.is_empty() -> println("doctor: nothing to auto-fix")
        else -> loop item in fixed -> println("fixed: {item}")
        return run_doctor(online, false, mode, cross_target)
    }
    bold :: |s: String| -> if color -> "\x1b[1m{s}\x1b[0m" else s
    green :: |s: String| -> if color -> "\x1b[32m{s}\x1b[0m" else s
    yellow :: |s: String| -> if color -> "\x1b[33m{s}\x1b[0m" else s
    println(bold("{Syntax.BINARY_NAME} doctor"))
    last_section := ""
    loop check in checks {
        if check.section != last_section {
            println("")
            println(bold(check.section))
            last_section = check.section
        }
        (mark, label) :: match check.health {
            .Ok -> (green("ok  "), check.label)
            .Note -> ("note", check.label)
            .Problem -> (yellow("warn"), check.label)
        }
        println("  [{mark}] {label}: {check.detail}")
        if check.fix == .Val(fix) {
            println("        Fix: {fix}")
            if check.auto_fixable -> println("        (auto-fixable: run `{Syntax.BINARY_NAME} doctor --fix`)")
        }
    }
    println("")
    if jet.Doctor.has_problem(&checks) {
        println("Warning [L2101] (doctor_advisory): Toolchain checks need attention")
        println(" Why: One or more required tools or paths are unavailable")
        println(" Fix: Follow the fixes above, then run `jet self doctor` again")
        println(" {jet.Explain.pointer_line(\"L2101\", color)}")
        println("More: jet-lang.dev/e/L2101")
        exit(ExitCodes.USER_ERROR)
    } else -> println("everything looks good.")
}
