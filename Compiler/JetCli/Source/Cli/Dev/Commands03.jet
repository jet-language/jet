pub fn run_explain_cost(file_input: String?, mode: OutputMode, profile: String, setting_overrides: &[String:String]) -> {
    file :: file_input.unwrap_or_else(|| -> {
        eprintln("usage: {Syntax.BINARY_NAME} explain --cost <file.{Syntax.FILE_EXT}>")
        exit(ExitCodes.USAGE)
    })
    src :: fs.read_to_string(file) ?? {
        cli_error!(@fix "E2105", "can't find the file `{file}`", "check the spelling, or run {Syntax.BINARY_NAME} from the folder that contains it")
        exit(ExitCodes.USER_ERROR)
    }
    projection :: CmdInspect.check_projection_for_effects(&OSPath.from(file), profile, setting_overrides) ?? {
        errors :: err.iter().filter(|diagnostic| -> diagnostic.severity == Severity.Error).collect()
        if !errors.is_empty() {
            report_problems(mode, file, src, &errors)
            exit(ExitCodes.USER_ERROR)
        }
        cli_error!("E2104", "cost projection could not check `{file}`")
        exit(ExitCodes.USER_ERROR)
    }
    report :: jet.Codegen.TIR.cost_report(&projection.bundle) ?? exit_cost_projection_error(file, &err)
    if mode.json {
        sites :: StatusValue.array(report.sites.iter().map(|site| -> StatusValue.object(StatusFields.new()
            .with("function", site.function).with("line", source_line(src, site.span)).with("kind", site.kind.label())
            .with("state", cost_state_label(site.state)).with("loop_depth", site.loop_depth).with("tier", COST_TIER))))
        println(StatusEnvelope.new("explain.cost", true).with_field("file", file).with_field("sites", sites).json())
        return
    }
    if report.sites.is_empty() {
        println("cost: `{file}` has no typed cost sites")
        return
    }
    loop site in report.sites -> println("{file}:{source_line(src, site.span)} fn {site.function} — {site.kind.label()} — {cost_state_label(site.state)} (loop depth {site.loop_depth}; tier={COST_TIER})")
}
