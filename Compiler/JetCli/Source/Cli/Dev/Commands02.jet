//RS         }
//RS         let chunk_size = (current.len() + n - 1) / n;
//RS         if chunk_size == 0 {
//RS             break;
//RS         }
//RS         let mut made_progress = false;
//RS         let mut start = 0;
//RS         while start < current.len() {
//RS             let end = (start + chunk_size).min(current.len());
//RS             let mut candidate = current.clone();
