//RS                     start + 1,
//RS                     end,
//RS                     candidate.len()
//RS                 );
//RS                 current = candidate;
//RS                 n = if n > 2 { n - 1 } else { 2 };
//RS                 made_progress = true;
//RS                 break;
//RS             }
//RS             start = end;
//RS         }
//RS         if !made_progress {
//RS             if n >= current.len() {
//RS                 break;
//RS             }
//RS             n = (n * 2).min(current.len());
//RS         }
//RS     }
//RS     current
//RS }
