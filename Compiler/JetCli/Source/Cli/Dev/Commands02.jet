//RS             crate::cli_error!(@fix "E2105", format!("can't find the file `{}`", file), format!("check the spelling, or run {} from the folder that contains it", jet::Syntax::BINARY_NAME));
//RS             exit(ExitCodes::USER_ERROR);
//RS         }
//RS         flags = flags.with_preload(resolved);
//RS     }
//RS     let code = jet::REPL::run(project_dir, flags);
//RS     exit(code);
