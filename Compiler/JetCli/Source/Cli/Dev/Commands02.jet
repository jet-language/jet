fn dev_incremental_reload_enabled(entry_fn: String?, profile: String, gates: GateSet, setting_overrides: &[String:String]) -> Bool {
    entry_fn.is_none() && profile == "dev" && gates.is_empty() && setting_overrides.is_empty()
}
// Rust: Source/CmdDevTools.rs:2233
fn load_and_check_dev_change(file: String, entry_fn: String?, gates: GateSet, mode: OutputMode, profile: String, setting_overrides: &[String:String]) -> (ProgramBundle, Sema.SemIndexEffectFacts)? {
    new_bundle := jet.Loader.load_entry(file) ?? {
        src :: fs.read_to_string(file) ?? ""
        println("\n— {file} changed —")
        report_problems(mode, file, src, err)
        return None
    }
    Driver.seed_build_facts(&new_bundle, profile, false, setting_overrides) ?? {
        src :: fs.read_to_string(file) ?? ""
        println("\n— {file} changed —")
        report_problems(mode, file, src, err)
        return None
    }
    if entry_fn == .Val(name) -> Driver.swap_entry_point(&new_bundle, name)
    (diags, effect_facts) :: Sema.check_bundle_gates_with_effect_facts(&new_bundle, .Run, gates)
    errs :: diags.iter().filter(fn(d) -> d.severity == .Error).cloned().collect()
    if !errs.is_empty() {
        src :: fs.read_to_string(file) ?? ""
        println("\n— {file} changed —")
        report_problems(mode, file, src, errs)
        return None
    }
    render_dev_lints(file, mode, diags)
    .Val((^new_bundle, effect_facts))
}

// Rust: Source/CmdDevTools.rs:2288
fn render_dev_change(file: String, entry_fn: String?, program_args: &[String], try_anyway: Bool, policy: WatchPolicy, prev: &CheckedMirSnapshot?, gates: GateSet, mode: OutputMode, use_interpreter: Bool, profile: String, release_policy: &ReleaseDevtoolsPolicy, setting_overrides: &[String:String], incremental_cache: &Sema.IncrementalSemaCache, game_entries: &[DevWatchEntry], game_facts_out: &[Game.JetGameChangeFact], devtools_host: &WebHost?) -> CheckedMirSnapshot? {
    if !game_entries.is_empty() {
        game_facts_out = game_change_facts(game_entries, None) ?? {
            eprintln("[hot-swap] checked game facts rejected: {err}")
            return None
        }
    }
    incremental_decision := HotSwapDecision?{None}
    incrementally_checked := (ProgramBundle, Sema.SemIndexEffectFacts)?{None}
    if prev.is_some() && dev_incremental_reload_enabled(entry_fn, profile, gates, setting_overrides) {
        old :: prev.expect("incremental reload requires a baseline")
        module_name :: old.bundle.modules.get(old.bundle.entry).map(fn(module) -> module.display.clone()) ?? file.to_string()
        source :: fs.read_to_string(file) ?? ""
        (diags, bundle, facts, decision) :: Driver.check_file_with_hot_swap_incremental(old.bundle, file, .Val((OSPath.new(file), source)), false, module_name, incremental_cache)
        errs :: diags.iter().filter(fn(d) -> d.severity == .Error).cloned().collect()
        if !errs.is_empty() {
            println("\n— {file} changed —")
            report_problems(mode, file, source, errs)
            return None
        }
        safe_for_run :: bundle.is_some_and(fn(bundle) -> {
            has_run :: bundle.modules.get(bundle.entry).is_some_and(fn(module) -> module.items.iter().any(fn(item) -> {
                if item == { .Func(function) -> function.name == "run"; _ -> false }
            }))
            has_build :: bundle.modules.iter().any(fn(module) -> module.items.iter().any(fn(item) -> {
                if item == { .Func(function) -> Sema.is_build_entry(function); _ -> false }
            }))
            has_run && !has_build
        })
        if safe_for_run {
            render_dev_lints(file, mode, diags)
            incremental_decision = decision
            incrementally_checked = bundle.map(fn(bundle) -> (bundle, facts))
        } else -> incremental_cache.clear()
    }
    (new_bundle, effect_facts) :: incrementally_checked ?? (load_and_check_dev_change(file, entry_fn, gates, mode, profile, setting_overrides) ?? return None)
    resident :: policy == .Swap || policy == .Auto
    artifact_target :: if use_interpreter -> MirArtifactTarget.Interpreter else -> MirArtifactTarget.Cranelift
    (mir, artifact) :: jet.lower_checked_semantic_mir_program_for(new_bundle, dev_artifact_request(new_bundle, artifact_target, profile))
    if resident {
        module_name :: new_bundle.modules.get(new_bundle.entry).map(fn(module) -> module.display.clone()) ?? file.to_string()
        if prev == .Val(old) {
            decision :: fn() -> HotSwapDecision [jet.Diagnostics.Diagnostic]! {
                if incremental_decision.take() == .Val(decision) -> return decision
                Sema.HotSwap.type_stable_decision(old.bundle, new_bundle, module_name)
            }() ?? {
                src :: fs.read_to_string(file) ?? ""
                report_problems(mode, file, src, err)
                return None
            }
            facts :: game_change_facts(game_entries, .Val(decision)) ?? {
                eprintln("[hot-swap] checked game facts rejected: {err}")
                return None
            }
            game_facts_out = facts.clone()
            decision :: decision.with_change_facts(facts)
            reuse_current :: !use_interpreter && decision.is_compatible() && decision.changed.is_empty() && decision.changed_functions.is_empty() && decision.rechecked().is_empty() && decision.schema_migrations().is_empty() && decision.change_facts().is_empty()
            if devtools_host == .Val(host) -> _ :: host.publish_hot_swap_decision(decision)
            persist_before_migration :: if !use_interpreter && !decision.schema_migrations().is_empty() -> .Val(Persist.shared_clone()) else -> None
            migrated_in_place := false
            if decision.is_compatible() {
                if !use_interpreter {
                    resident_runtime.apply_hot_swap(decision) ?? {
                        if !mode.json -> eprintln("[hot-swap] {module_name} — adapter preparation failed: {err}")
                        return None
                    }
                }
            } else if !use_interpreter && !decision.schema_migrations().is_empty() {
                receipts :: resident_runtime.apply_hot_swap_with_program(mir, artifact, decision, release_policy) ?? {
                    if !mode.json -> eprintln("[hot-swap] {module_name} — schema migration rejected: {err}")
                    return None
                }
                if !receipts.is_empty() && !mode.quiet && !mode.json {
                    migrated :: receipts.iter().filter(fn(receipt) -> !receipt.migrated.is_empty()).count()
                    println("[hot-swap] migrated {migrated} published-schema value(s)")
                }
                migrated_in_place = true
            }
            swap_ok :: if decision.is_compatible() || migrated_in_place -> run_resident_swap(mir, artifact, try_anyway, module_name, file, mode, use_interpreter, reuse_current, release_policy) else -> run_resident_restart(mir, artifact, try_anyway, file, mode, use_interpreter, release_policy)
            if !swap_ok {
                if persist_before_migration == .Val(store) {
                    Persist.shared_replace(store)
                    resident_runtime.discard_hot_swap_plan()
                }
                return None
            }
            render_hot_swap_decision(decision, mode, migrated_in_place)
        } else {
            if !mode.quiet && !mode.json -> println("\n[restart] {module_name} — first run")
            if !run_resident_restart(mir, artifact, try_anyway, file, mode, use_interpreter, release_policy) -> return None
        }
    } else {
        if !mode.quiet -> println("\n— {file} changed, re-running —")
        jobs :: Interpreter.scheduled_jobs(new_bundle)
        requested :: program_args.first().filter(fn(arg) -> !arg.starts_with("-"))
        selected :: requested.filter(fn(name) -> jobs.iter().any(fn(pair) -> pair.0 == name))
        runtime_args :: if selected.is_some() -> program_args.slice(1..<program_args.len()) else -> program_args
        args := [String].with_capacity(runtime_args.len() + 1)
        &args.push(selected.map(fn(name) -> "{file} {name}") ?? file.to_string())
        &args.extend(runtime_args.iter().map(fn(arg) -> arg.to_string()))
        outcome :: resident_runtime.with_program_args(args, fn() -> Interpreter.dev_run_snapshot(mir, artifact, try_anyway, if use_interpreter -> Interpreter.InterpreterInvocation.DevInterpret else -> Interpreter.InterpreterInvocation.DevDefault, release_policy))
        render_dev_outcome(outcome, file, mode)
        if outcome == { .Ran(_, _, _) -> {}; _ -> return None }
    }
    .Val(CheckedMirSnapshot{bundle: new_bundle, facts: effect_facts, mir: mir, artifact: artifact})
}
// Rust: Source/CmdDevTools.rs:2597
fn game_change_facts(entries: &[DevWatchEntry], decision: &HotSwapDecision?) -> [Game.JetGameChangeFact] Err! {
    facts := [Game.JetGameChangeFact].with_capacity(entries.len())
    loop entry in entries {
        (migration, reason) :: if entry.game_kind == {
            .Asset -> (Game.JetGameMigrationDecision.Preserve, "checked asset watch change `{entry.change_kind}`")
            .Script -> {
                if decision.is_some_and(fn(decision) -> decision.is_compatible()) -> (.Preserve, "checked type-stable reload")
                else -> (.Reject, decision.and_then(fn(decision) -> decision.compatibility.reason()) ?? "checked restart or incompatible reload")
            }
            .World -> {
                if decision.is_some_and(fn(decision) -> decision.is_compatible()) -> (.Preserve, "checked type-stable reload")
                else -> (.Reject, decision.and_then(fn(decision) -> decision.compatibility.reason()) ?? "checked restart or incompatible reload")
            }
        }
        &facts.push(Game.JetGameChangeFact.new(entry.path.display().to_string(), entry.game_kind, entry.old_schema_id.clone(), entry.new_schema_id.clone(), migration, reason)?)
    }
    facts
}
// Rust: Source/CmdDevTools.rs:2639
fn publish_game_asset_watch_events(file: String, entries: &[DevWatchEntry], timestamp_ms: U64) -> Void Err! {
    asset_entries :: entries.iter().filter(fn(entry) -> entry.game_kind == .Asset).collect()
    if asset_entries.is_empty() -> return
    parent :: OSPath.new(file).parent() ?? OSPath.new(".")
    asset_root :: fs.canonicalize(parent.join("assets")) ?? {
        if parent.is_absolute() -> parent.join("assets")
        else -> (env.current_dir() ?? OSPath.new(".")).join(parent).join("assets")
    }
    root :: jet.Codegen.MIREval.game_dev_protocol.JetGameAssetRootIdentity.new("game", ".") ?? return Err(err.to_string())
    events := [jet.Codegen.MIREval.game_dev_protocol.JetGameAssetWatchEvent].with_capacity(asset_entries.len())
    skipped_count := 0
    loop entry in asset_entries {
        if entry.change_kind == "stale" {
            skipped_count = skipped_count.saturating_add(1)
            next
        }
        relative :: (entry.path.strip_prefix(asset_root) ?? return Err("asset watcher path `{entry.path.display()}` is outside root `{asset_root.display()}`")).to_string_lossy().replace("\\", "/")
        if relative.is_empty() -> return Err("asset watcher path `{entry.path.display()}` is the asset root")
        logical_path :: "assets/{relative}"
        kind :: if entry.change_kind == "created" -> jet.Codegen.MIREval.game_dev_protocol.JetGameAssetWatchEventKind.Created else if entry.change_kind == "deleted" -> jet.Codegen.MIREval.game_dev_protocol.JetGameAssetWatchEventKind.Deleted else -> jet.Codegen.MIREval.game_dev_protocol.JetGameAssetWatchEventKind.Changed
        &events.push(jet.Codegen.MIREval.game_dev_protocol.JetGameAssetWatchEvent.new(root.clone(), logical_path, kind) ?? return Err(err.to_string()))
    }
    roots :: jet.Codegen.MIREval.game_dev_protocol.JetGameAssetRootSet.new([root]) ?? return Err(err.to_string())
    projected :: jet.Codegen.MIREval.game_dev_protocol.project_asset_watch_import_events(timestamp_ms, file, roots, events, skipped_count)?
    loop event in projected -> jet_foundation.Devtools.jet_devtools_publish_event(event)
}
// Rust: Source/CmdDevTools.rs:2729
fn apply_game_watch_facts(session: &Game.JetGameDevSession, facts: &[Game.JetGameChangeFact], accepted: Bool, reason: String, timestamp_ms: U64, source: String) -> Void Err! {
    loop original in facts {
        fact :: if accepted -> original.clone() else -> original.clone().with_migration(.Reject, reason)?
        outcome :: if fact.kind == {
            .Asset -> session.apply_asset_swap(fact)?
            .Script -> session.apply_script_reload(fact)?
            .World -> session.apply_world_reload(fact)?
        }
        body :: jet_foundation.Devtools.JetDevtoolsEventBody.GameSwap(
            sequence: outcome.sequence, path: outcome.fact.path, kind: outcome.fact.kind.as_str().to_string(),
            status: outcome.status.as_str().to_string(), old_schema_id: outcome.fact.old_schema_id,
            new_schema_id: outcome.fact.new_schema_id, migration: outcome.fact.migration.as_str().to_string(), reason: outcome.fact.reason,
        )
        event :: jet_foundation.Devtools.JetDevtoolsEvent.try_new(timestamp_ms, source.to_string(), body)?
        jet_foundation.Devtools.jet_devtools_publish_event(event)
    }
}
// Rust: Source/CmdDevTools.rs:2770
fn publish_game_launch_profile(resident_session: &ResidentDevSession, file: String, profile: &jet.Codegen.MIREval.game_dev_protocol.GameDevLaunchProfile, timestamp_ms: U64) -> Void Err! {
    body :: jet_foundation.Devtools.JetDevtoolsEventBody.GameLaunchProfile(
        target: profile.target.clone(), run_mode: profile.run_mode.as_str().to_string(), headless_compatible: profile.headless_compatible,
        phases: profile.phases.iter().map(fn(phase) -> jet_foundation.Devtools.JetDevtoolsGameLaunchPhase.new(phase.phase.as_str(), phase.status.as_str(), phase.detail.clone())).collect(),
    )
    event :: jet_foundation.Devtools.JetDevtoolsEvent.try_new(timestamp_ms, "game", body)?
    _ :: resident_session.publish_devtools_event_typed(event)?
}
// Rust: Source/CmdDevTools.rs:2797
fn render_hot_swap_decision(decision: &HotSwapDecision, mode: OutputMode, migrated_in_place: Bool) -> Void {
    if mode.quiet || mode.json -> return
    list :: fn(preserved: Bool) -> {
        values :: decision.state_facts().iter().filter(fn(fact) -> fact.is_preserved() == preserved).map(fn(fact) -> fact.key).collect()
        if values.is_empty() -> "—" else -> values.join(", ")
    }
    changed :: if decision.changed_functions.is_empty() -> "—" else -> decision.changed_functions.join(", ")
    if decision.is_compatible() -> println("saved {decision.module}  swapped {changed}  kept {list(true)}")
    else if migrated_in_place -> println("saved {decision.module}  migrated in place  swapped {changed}  kept {list(true)}")
    else {
        reason :: decision.compatibility.reason() ?? "type surface changed"
        println("saved {decision.module}  restarting  kept {list(true)}  reset {list(false)}  reason {reason}")
    }
}
// Rust: Source/CmdDevTools.rs:2852
fn run_resident_swap(program: &MIRProgram, artifact: jet_foundation.MIR.MirArtifactId, try_anyway: Bool, module_name: String, file: String, mode: OutputMode, use_interpreter: Bool, reuse_current: Bool, release_policy: &ReleaseDevtoolsPolicy) -> Bool {
    outcome :: fn() -> Interpreter.RunOutcome [jet.Diagnostics.Diagnostic]! {
        if reuse_current -> return resident_runtime.run_resident_current() ?? return Err([jet.Diagnostics.Diagnostic.runtime_host_fault("", err)])
        if use_interpreter {
            backend := jet.JitBackend.InterpreterBackend.new(.DevInterpret)
            return backend.hot_swap(module_name, program, artifact, try_anyway, release_policy)
        }
        backend := resident_runtime.CraneliftBackend.new()
        backend.hot_swap(module_name, program, artifact, try_anyway, release_policy)
    }() ?? {
        exit_if_internal_fault(err)
        src :: fs.read_to_string(file) ?? ""
        report_problems(mode, file, src, err)
        return false
    }
    render_outcome(outcome, file, mode)
    true
}
// Rust: Source/CmdDevTools.rs:2896
fn run_resident_restart(program: &MIRProgram, artifact: jet_foundation.MIR.MirArtifactId, try_anyway: Bool, file: String, mode: OutputMode, use_interpreter: Bool, release_policy: &ReleaseDevtoolsPolicy) -> Bool {
    outcome :: if use_interpreter -> {
        backend := jet.JitBackend.InterpreterBackend.new(.DevInterpret)
        backend.restart(program, artifact, try_anyway, release_policy)
    } else -> {
        backend := resident_runtime.CraneliftBackend.new()
        backend.restart(program, artifact, try_anyway, release_policy)
    }
    ok :: if outcome == { .Ran(_, _, _) -> true; _ -> false }
    render_outcome(outcome, file, mode)
    ok
}
