//RS     }
//RS 
//RS     let src = fs::read_to_string(file).unwrap_or_else(|e| {
//RS         crate::cli_error!("E2105", "couldn't read `{}`: {}", file, e);
//RS         exit(ExitCodes::USER_ERROR);
//RS     });
//RS 
//RS     // `compile_with_path` reads its *file* argument straight off disk (its
//RS     // `src` parameter is display-only), so every candidate has to actually
//RS     // exist on disk under the same extension before we can ask the oracle
//RS     // about it. One scratch path, rewritten each try.
//RS     let ext = Path::new(file)
//RS         .extension()
//RS         .and_then(|s| s.to_str())
