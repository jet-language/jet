fn provision_live_lineage_env(local_rail: Bool, session_id: String, source_id: String, build_id: String, revision: String, world_id: String) -> Void {
    // Rust: Source/CmdDevTools.rs:1877
    SESSION :: "JET_DEVTOOLS_RELAY_SESSION_ID"
    // Rust: Source/CmdDevTools.rs:1878
    SOURCE :: "JET_DEVTOOLS_RELAY_SOURCE_ID"
    // Rust: Source/CmdDevTools.rs:1879
    BUILD :: "JET_DEVTOOLS_RELAY_BUILD_ID"
    // Rust: Source/CmdDevTools.rs:1880
    REVISION :: "JET_DEVTOOLS_RELAY_REVISION"
    // Rust: Source/CmdDevTools.rs:1881
    WORLD :: "JET_DEVTOOLS_RELAY_WORLD_ID"
    // Rust: Source/CmdDevTools.rs:1882
    COMMANDS :: "JET_DEVTOOLS_COMMAND_RELAY_PATH"
    // GATE #4494: actual native environment mutation and process identity.
    directory :: env.temp_dir().join("jet-devtools-commands-{std.process.id()}").to_string_lossy().into_owned()
    if !local_rail {
        loop key in [SESSION, SOURCE, BUILD, REVISION, WORLD, COMMANDS] -> env.remove_var(key)
        return
    }
    loop (key, value) in [(SESSION, session_id), (SOURCE, source_id), (BUILD, build_id), (REVISION, revision), (WORLD, world_id), (COMMANDS, directory)] -> env.set_var(key, value)
}
// Rust: Source/CmdDevTools.rs:1907
fn next_dev_job_wake(snapshot: &CheckedMirSnapshot?) -> Duration? {
    snapshot :: snapshot ?? return None
    jobs :: Interpreter.scheduled_jobs(snapshot.bundle)
    if jobs.is_empty() -> return None
    now_secs :: (SystemTime.now().duration_since(UNIX_EPOCH) ?? Duration.default()).as_secs()
    second_of_day :: now_secs % 86400
    wake := Duration?{None}
    loop (_, schedule) in jobs {
        duration :: if schedule == {
            .Duration(nanos) -> Duration.from_nanos(nanos.max(1) as U64)
            .WallClockTime(hour, minute) -> {
                target :: (hour as U64) * 3600 + (minute as U64) * 60
                seconds :: if second_of_day >= target && second_of_day < target + 60 -> 1 else if second_of_day < target -> target - second_of_day else -> 86400 - second_of_day + target
                Duration.from_secs(seconds.max(1))
            }
        }
        if wake.is_none() || duration < wake.unwrap() -> wake = .Val(duration)
    }
    wake
}
// Rust: Source/CmdDevTools.rs:1946
fn run_due_jobs(snapshot: &CheckedMirSnapshot, file: String, try_anyway: Bool, use_interpreter: Bool, mode: OutputMode, release_policy: &ReleaseDevtoolsPolicy, clock: &JobClock, resident_session: &ResidentDevSession) -> Void {
    jobs :: Interpreter.scheduled_jobs(snapshot.bundle)
    if jobs.is_empty() -> return
    loop name in clock.due(jobs) {
        if !mode.quiet -> println("\n— due job `{name}` —")
        invocation :: if use_interpreter -> Interpreter.InterpreterInvocation.DevInterpret else -> Interpreter.InterpreterInvocation.DevDefault
        // GATE #4494: relaxed native atomic fetch-add.
        job_id :: "{name}#{NEXT_DEV_JOB_ID.fetch_add(1, .Relaxed)}"
        queue :: name.clone()
        worker :: if use_interpreter -> "dev-interpreter" else -> "dev-cranelift"
        enqueued_at_ms :: dev_job_now_ms()
        publish_dev_job_fact(resident_session, dev_job_fact(.Enqueue, .Enqueued, job_id, name, queue, 0, None, None, None, enqueued_at_ms))
        started_at :: Instant.now()
        started_at_ms :: dev_job_now_ms().max(enqueued_at_ms)
        publish_dev_job_fact(resident_session, dev_job_fact(.Start, .Started, job_id, name, queue, 1, None, .Val(worker.clone()), None, started_at_ms))
        if Interpreter.run_checked_job_snapshot(snapshot, file, name, [], try_anyway, invocation, release_policy) == {
            .Ran(stdout, stderr, exit_code) -> {
                finished_at_ms :: dev_job_now_ms().max(started_at_ms)
                duration_ms :: U64.try_from(started_at.elapsed().as_millis()) ?? U64.MAX
                if exit_code == 0 -> publish_dev_job_fact(resident_session, dev_job_fact(.Complete, .Completed, job_id, name, queue, 1, .Val(duration_ms), .Val(worker), None, finished_at_ms))
                else -> publish_dev_job_fact(resident_session, dev_job_fact(.Fail, .Failed, job_id, name, queue, 1, .Val(duration_ms), .Val(worker), .Val(.Error), finished_at_ms))
                emit_run_output(stdout, stderr)
                if exit_code != 0 -> eprintln("job `{name}` exited with code {exit_code}")
            }
            .Problems(diags) -> {
                finished_at_ms :: dev_job_now_ms().max(started_at_ms)
                duration_ms :: U64.try_from(started_at.elapsed().as_millis()) ?? U64.MAX
                publish_dev_job_fact(resident_session, dev_job_fact(.Fail, .Failed, job_id, name, queue, 1, .Val(duration_ms), .Val(worker), .Val(.Error), finished_at_ms))
                exit_if_internal_fault(diags)
                src :: fs.read_to_string(file) ?? ""
                report_problems(mode, file, src, diags)
            }
        }
    }
}
