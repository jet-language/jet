pub fn run_repl(project_dir: String?, preload: String?, allow: &[String], deny: &[String], color: ColorChoice) -> Void {
    flags := jet.REPL.ReplFlags.new(allow, deny).with_color(color)
    if preload == .Val(file) {
        resolved :: resolve_source_path(file)
        if !OSPath.new(resolved).exists() {
            cli_error_fix("E2105", "can't find the file `{file}`", "check the spelling, or run {jet.Syntax.BINARY_NAME} from the folder that contains it")
            exit(ExitCodes.USER_ERROR)
        }
        flags = flags.with_preload(resolved)
    }
    code :: jet.REPL.run(project_dir, flags)
    exit(code)
}
