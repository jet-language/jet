//RS /// Shrinks by removing line-chunks (a simplified Zeller ddmin: try removing
//RS /// progressively smaller contiguous chunks, re-trying the whole file at a
//RS /// finer granularity whenever a whole pass makes no progress) and writes the
//RS /// smallest failing case to `<file>.reduced.<ext>`.
//RS pub(crate) fn run_devtools_reduce(args: &[&String]) {
//RS     if args.is_empty() {
//RS         eprintln!(
