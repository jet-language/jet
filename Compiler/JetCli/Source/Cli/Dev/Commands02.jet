// UTC duration/day bookkeeping is shared with the canonical job scheduler.
pub struct JobClock { inner: resident_runtime.Job.JetJobClock }
// Rust: Source/CmdDevTools.rs:2158
pub fn JobClock.new() -> JobClock { JobClock{inner: resident_runtime.Job.JetJobClock.new()} }
// Rust: Source/CmdDevTools.rs:2166
pub fn JobClock.due(self: &JobClock, jobs: &[(String, EverySchedule)]) -> [String] {
    schedules :: jobs.iter().map(fn(pair) -> (pair.0, prelude_schedule(pair.1))).collect()
    resident_runtime.Job.jet_job_schedule_due(&self.inner, schedules)
}
// Rust: Source/CmdDevTools.rs:2177
fn JobClock.due_at(self: &JobClock, jobs: &[(String, EverySchedule)], unix_secs: U64) -> [String] {
    schedules :: jobs.iter().map(fn(pair) -> (pair.0, prelude_schedule(pair.1))).collect()
    self.inner.due_at(schedules, unix_secs)
}
// Rust: Source/CmdDevTools.rs:2190
fn prelude_schedule(schedule: EverySchedule) -> resident_runtime.Job.JetJobSchedule {
    if schedule == {
        .Duration(nanos) -> .Duration(nanos: nanos)
        .WallClockTime(hour, minute) -> .WallClockTime(hour: hour, minute: minute)
    }
}
// Rust: Source/CmdDevTools.rs:2200
fn dev_artifact_request(bundle: &ProgramBundle, target: MirArtifactTarget, profile: String) -> MirArtifactRequest {
    build_mode :: Driver.mir_artifact_build_mode_for(bundle, .Run, profile)
    kind :: if build_mode == {
        .Test -> MirArtifactKind.TestExecutable
        .Coverage -> MirArtifactKind.TestExecutable
        .Fuzz -> MirArtifactKind.FuzzExecutable
        .Dev -> MirArtifactKind.NativeExecutable
        .Release -> MirArtifactKind.NativeExecutable
    }
    MirArtifactRequest.new(target, kind, build_mode)
}
