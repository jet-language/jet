// Rust: Source/CmdDevTools.rs:3197
fn open_completion_program(path: String) -> fs.File std.io.Error! {
    // GATE #4483: select the platform's nonblocking flag, not the host's.
    // GATE #4494: nonblocking native open refuses to hang on FIFOs.
    options := fs.OpenOptions.new().read(true)
    if core.sys.target.selected_family() == "unix" {
        os :: core.sys.target.selected_os()
        NONBLOCK :: if os == "linux" || os == "android" -> 2048 else -> 4
        &options.custom_flags(NONBLOCK)
    }
    options.open(path)
}
// Rust: Source/CmdDevTools.rs:3201
fn completion_metadata_error(program: String, why: String) -> Never {
    // GATE #4494: canonical character escape_default iterator.
    program :: program.chars().flat_map(fn(character) -> character.escape_default()).collect()
    eprintln("Error [E2103]: Couldn't read command metadata from `{program}`.")
    eprintln(" Why: {why}.")
    eprintln(" Fix: Rebuild the program with this Jet toolchain, then try again.")
    eprintln("More: jet-lang.dev/e/E2103")
    exit(ExitCodes.USER_ERROR)
}
