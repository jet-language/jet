        .Val("grammars") -> {
            write_generated_section("Tools/editors/vscode/syntaxes/jet.tmLanguage.json", jet.Syntax.render_vscode_generated_highlights(), mode.quiet)
            write_generated_section("Tools/editors/jet.tmGrammar", jet.Syntax.render_vscode_generated_highlights(), mode.quiet)
            write_generated_section("Tools/editors/tree-sitter/grammar.js", jet.Syntax.render_tree_sitter_generated_highlights(), mode.quiet)
            write_generated_section("Tools/editors/zed/languages/jet/highlights.scm", jet.Syntax.render_zed_generated_highlights(), mode.quiet)
            if !mode.quiet -> println("regenerated editor grammar sections")
        }
        .Val("reduce") -> run_devtools_reduce(args.slice(1..<args.len()))
        .Val("ice-report") -> run_devtools_ice_report(args.slice(1..<args.len()))
        .Val("new-example") -> run_devtools_new_example(args.slice(1..<args.len()))
        .Val("new-ui") -> run_devtools_new_ui(args.slice(1..<args.len()))
        .Val("check-fixture-paths") -> run_devtools_check_fixture_paths()
        .Val("bless") -> run_devtools_bless(args.slice(1..<args.len()))
        .Val("probe") -> run_devtools_probe(args.slice(1..<args.len()))
        .Val(other) -> {
            cli_error("E2101", "unknown `devtools` subcommand `{other}`")
            eprintln("usage: {jet.Syntax.BINARY_NAME} devtools <{DEVTOOLS_SUBCOMMANDS}>")
            exit(ExitCodes.USAGE)
        }
        None -> {
            eprintln("usage: {jet.Syntax.BINARY_NAME} devtools <{DEVTOOLS_SUBCOMMANDS}>")
            exit(ExitCodes.USAGE)
        }
    }
}
// Rust: Source/CmdDevTools.rs:3293
// Default oracle: the front end accepts and rustc rejects. --code selects
// a front-end diagnostic instead. Each candidate is actually written to disk.
pub fn run_devtools_reduce(args: &[String]) -> Void {
    if args.is_empty() {
        eprintln("usage: {jet.Syntax.BINARY_NAME} devtools reduce <file.{jet.Syntax.FILE_EXT}> [--code EXXXX]")
        exit(ExitCodes.USAGE)
    }
    file :: args[0]
    code_filter := String?{None}
    i := 1
    loop i < args.len() {
        if args[i] == "--code" {
            code_filter = args.get(i + 1).map(fn(s) -> s.to_string())
            i += 2
        } else {
            cli_error("E2102", "unknown `reduce` flag `{args[i]}`")
            exit(ExitCodes.USAGE)
        }
    }
    src :: fs.read_to_string(file) ?? {
        cli_error("E2105", "couldn't read `{file}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    ext :: OSPath.new(file).extension().and_then(fn(s) -> s.to_str()) ?? jet.Syntax.FILE_EXT
    scratch :: env.temp_dir().join("jet_devtools_reduce_{std.process.id()}.{ext}")
    interesting :: fn(text: String) -> reduce_oracle(scratch, text, code_filter)
    if !interesting(src) {
        why :: code_filter.map(fn(code) -> "the front end never emits `{code}` for this file") ?? "either the front end already rejects it, or rustc accepts the generated Rust"
        cli_error_full("E2104", "`{file}` doesn't reproduce the target oracle as given", why, "confirm the case fails the way you expect, then reduce it")
        exit(ExitCodes.USER_ERROR)
    }
    lines :: src.lines().map(fn(s) -> s.to_string()).collect()
    println("reduce: starting at {lines.len()} line(s)")
    reduced :: ddmin(lines, interesting)
    println("reduce: finished at {reduced.len()} line(s)")
    out_text := reduced.join("\n")
    if !out_text.is_empty() -> &out_text.push('\n')
    out_path :: reduced_path(file)
    fs.write(out_path, out_text) ?? {
        cli_error("E2105", "couldn't write `{out_path.display()}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    _ :: fs.remove_file(scratch)
    println("wrote {out_path.display()}")
}
// Rust: Source/CmdDevTools.rs:3372
fn reduce_oracle(scratch: &OSPath, src: String, code: String?) -> Bool {
    if fs.write(scratch, src).is_err() -> return false
    shown :: scratch.to_string_lossy().into_owned()
    if jet.compile_with_path(src, shown) == {
        .Ok(out) -> {
            if code == .Val(c) -> out.lints.iter().any(fn(d) -> d.code == c)
            else -> rustc_rejects(out.rust)
        }
        .Err(diags) -> {
            if code == .Val(c) -> diags.iter().any(fn(d) -> d.code == c)
            else -> false
        }
    }
}
// Rust: Source/CmdDevTools.rs:3394
fn ddmin(lines: [String], interesting: fn(String) -> Bool) -> [String] {
    current := ^lines
    n := 2
    loop {
        if current.len() < 2 -> break
        chunk_size :: (current.len() + n - 1) / n
        if chunk_size == 0 -> break
        made_progress := false
        start := 0
        loop start < current.len() {
            end :: (start + chunk_size).min(current.len())
            candidate := current.clone()
            _ :: &candidate.drain(start..<end)
            if !candidate.is_empty() && interesting(candidate.join("\n")) {
                println("reduce: dropped lines {start + 1}..{end} -> {candidate.len()} line(s) left")
                current = ^candidate
                n = if n > 2 -> n - 1 else -> 2
                made_progress = true
                break
            }
            start = end
        }
        if !made_progress {
            if n >= current.len() -> break
            n = (n * 2).min(current.len())
        }
    }
    current
}
// Rust: Source/CmdDevTools.rs:3436
fn reduced_path(file: String) -> OSPath {
    p :: OSPath.new(file)
    stem_name :: p.file_stem().and_then(fn(s) -> s.to_str()) ?? "reduced"
    ext :: p.extension().and_then(fn(s) -> s.to_str()) ?? jet.Syntax.FILE_EXT
    name :: "{stem_name}.reduced.{ext}"
    if p.parent().filter(fn(parent) -> !parent.as_os_str().is_empty()) == .Val(parent) -> parent.join(name)
    else -> OSPath.new(name)
}
// Rust: Source/CmdDevTools.rs:3455
// Missing rustc is not a rejection: never manufacture a false I2 repro.
fn rustc_probe(rust_code: String) -> (Bool, String) {
    tmp_dir :: env.temp_dir().join("jet_devtools_rustc_{std.process.id()}")
    if fs.create_dir_all(tmp_dir).is_err() -> return (true, "")
    rs_path :: tmp_dir.join("check.rs")
    if fs.write(rs_path, rust_code).is_err() {
        _ :: fs.remove_dir_all(tmp_dir)
        return (true, "")
    }
    meta_path :: tmp_dir.join("check.rmeta")
    // GATE #4494: real rustc subprocess, not a bridge into the old compiler.
    result :: Command.new("rustc").arg("--edition").arg("2021").arg("--crate-name").arg("jet_devtools_check").arg("--emit=metadata").arg(rs_path).arg("-o").arg(meta_path).output()
    outcome :: if result == {
        .Ok(o) -> (o.status.success(), String.from_utf8_lossy(o.stderr).into_owned())
        .Err(_) -> (true, "")
    }
    _ :: fs.remove_dir_all(tmp_dir)
    outcome
}
// Rust: Source/CmdDevTools.rs:3487
fn rustc_rejects(rust_code: String) -> Bool { !rustc_probe(rust_code).0 }
// Rust: Source/CmdDevTools.rs:3499
pub fn run_devtools_ice_report(args: &[String]) -> Void {
    if args.is_empty() {
        eprintln("usage: {jet.Syntax.BINARY_NAME} devtools ice-report <file.{jet.Syntax.FILE_EXT}>")
        exit(ExitCodes.USAGE)
    }
    file :: args[0]
    src :: fs.read_to_string(file) ?? {
        cli_error("E2105", "couldn't read `{file}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    out :: jet.compile_with_path(src, file) ?? {
        cli_error_full("E2105", "`{file}` doesn't reach codegen — the front end already rejects it", "ice-report bundles a case that compiles to Rust (an I2 repro)", "fix the front-end errors first, or use `{jet.Syntax.BINARY_NAME} devtools reduce --code <CODE>` to shrink a front-end diagnostic instead")
        core.term.eprint(jet.render_diagnostics(file, src, err))
        exit(ExitCodes.USER_ERROR)
    }
    (accepted, rustc_stderr) :: rustc_probe(out.rust)
    if accepted -> println("note: rustc accepted the generated Rust for `{file}` — bundling anyway, but this isn't an I2 repro")
    rustc_version :: Command.new("rustc").arg("--version").output().map(fn(o) -> {
        version := String.from_utf8_lossy(o.stdout).trim() // #4303
        version.to_string()
    }) ?? "rustc: not found"
    jet_version :: jet.VERSION
    ts :: SystemTime.now().duration_since(UNIX_EPOCH).map(fn(d) -> d.as_secs()) ?? 0
    project_root :: jet.build_project_root(file) ?? {
        core.term.eprint(jet.render_diagnostics(file, src, err))
        exit(ExitCodes.USER_ERROR)
    }
    bundle_dir :: project_root.join(".jet").join("ice-report").join("{stem(file)}-{ts}")
    fs.create_dir_all(bundle_dir) ?? {
        cli_error("E2105", "couldn't create `{bundle_dir.display()}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    write :: fn(name: String, content: String) -> {
        fs.write(bundle_dir.join(name), content) ?? {
            cli_error("E2105", "couldn't write `{name}`: {err}")
            exit(ExitCodes.USER_ERROR)
        }
    }
    write("source.{jet.Syntax.FILE_EXT}", src)
    write("generated.rs", out.rust)
    write("rustc.stderr", rustc_stderr)
    write("versions.txt", "jet {jet_version}\n{rustc_version}\n")
    println("wrote ICE report bundle to {bundle_dir.display()}")
}
// Rust: Source/CmdDevTools.rs:3584
pub fn run_devtools_new_example(args: &[String]) -> Void {
    if args.is_empty() {
        eprintln("usage: {jet.Syntax.BINARY_NAME} devtools new-example <topic>/<name>")
        exit(ExitCodes.USAGE)
    }
    spec :: args[0]
    (topic, name) :: spec.split_once("/") ?? {
        cli_error("E2104", "expected `<topic>/<name>`, got `{spec}`")
        exit(ExitCodes.USER_ERROR)
    }
    if topic.is_empty() || name.is_empty() {
        cli_error("E2104", "expected `<topic>/<name>`, got `{spec}`")
        exit(ExitCodes.USER_ERROR)
    }
    ext :: jet.Syntax.FILE_EXT
    example_dir :: OSPath.new("Examples/features").join(topic)
    expected_dir :: OSPath.new("Examples/features/expected").join(topic)
    example_path :: example_dir.join("{name}.{ext}")
    expected_path :: expected_dir.join("{name}.out")
    if example_path.exists() {
        cli_error("E2104", "`{example_path.display()}` already exists")
        exit(ExitCodes.USER_ERROR)
    }
    fs.create_dir_all(example_dir) ?? {
        cli_error("E2105", "couldn't create `{example_dir.display()}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    fs.create_dir_all(expected_dir) ?? {
        cli_error("E2105", "couldn't create `{expected_dir.display()}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    greeting :: "scaffold: {topic}/{name}"
    src :: "// TODO: describe Examples/features/{topic}/{name}.{ext}\nfn run() {{\n    print(\"{greeting}\")\n}}\n"
    fs.write(example_path, src) ?? {
        cli_error("E2105", "couldn't write `{example_path.display()}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    fs.write(expected_path, "{greeting}\n") ?? {
        cli_error("E2105", "couldn't write `{expected_path.display()}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    println("wrote {example_path.display()}")
    println("wrote {expected_path.display()}")
}
