fn live_lineage_for_file(file: String) -> (String, String, String, String) {
    source_id :: file.to_string()
    revision :: fs.read(file).map(fn(bytes) -> "sha256-{sha256_hex(bytes)}") ?? ""
    build_id :: revision.clone()
    world_id :: "world-{sha256_hex(source_id.bytes())}"
    (source_id, build_id, revision, world_id)
}
