//RS /// D-SCHEDULE1: per-job last-run bookkeeping for the due-job tick. A
//RS /// `Duration` schedule tracks the `Instant` it last ran; a `WallClockTime`
//RS /// schedule tracks the UTC day index (days since the Unix epoch) it last
//RS /// ran, so it fires once inside its matching minute, not on every 120ms
//RS /// tick within that minute. UTC only — D-SCHEDULE1's own law text carves
//RS /// timezone-aware calendars out to "the runtime API or jetos timers"; this
//RS /// is the lightweight dev-loop convenience tier, not that.
//RS pub(crate) struct JobClock {
//RS     inner: jet_jit::Job::JetJobClock,
//RS }
//RS 
//RS impl JobClock {
//RS     pub(crate) fn new() -> Self {
//RS         JobClock {
//RS             inner: jet_jit::Job::JetJobClock::new(),
//RS         }
//RS     }
//RS 
//RS     /// Which job names are due right now — records the firing so the same
//RS     /// job doesn't fire again on the very next tick.
//RS     pub(crate) fn due(&mut self, jobs: &[(String, jet::AST::EverySchedule)]) -> Vec<String> {
//RS         let schedules = jobs
//RS             .iter()
//RS             .map(|(name, schedule)| (name.as_str(), prelude_schedule(*schedule)))
//RS             .collect::<Vec<_>>();
//RS         jet_jit::Job::jet_job_schedule_due(&mut self.inner, &schedules)
//RS     }
//RS 
//RS     /// The testable core of `due`: `unix_secs` is injected so the day/window
//RS     /// arithmetic can be checked without racing real wall-clock time.
//RS     #[allow(dead_code)]
//RS     fn due_at(
//RS         &mut self,
//RS         jobs: &[(String, jet::AST::EverySchedule)],
//RS         unix_secs: u64,
//RS     ) -> Vec<String> {
//RS         let schedules = jobs
//RS             .iter()
//RS             .map(|(name, schedule)| (name.as_str(), prelude_schedule(*schedule)))
//RS             .collect::<Vec<_>>();
//RS         self.inner.due_at(&schedules, unix_secs)
//RS     }
//RS }
