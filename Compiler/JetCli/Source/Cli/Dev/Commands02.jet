fn render_outcome_timed(outcome: Interpreter.RunOutcome, file: String, elapsed: Duration?, mode: OutputMode) -> Void {
    if outcome == {
        .Ran(stdout, stderr, _) -> {
            emit_run_output(stdout, stderr)
            if elapsed == .Val(e) {
                if !mode.quiet -> println("✓ ran in {e.as_millis()} ms")
            }
        }
        .Problems(diags) -> {
            exit_if_internal_fault(diags)
            src :: fs.read_to_string(file) ?? ""
            report_problems(mode, file, src, diags)
        }
    }
}
