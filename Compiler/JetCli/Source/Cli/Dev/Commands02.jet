fn run_dev_budget_refresh(file: String, bundle: &ProgramBundle, mode: OutputMode) -> Void {
    specs :: Sema.collect_located_budget_specs_bundle(bundle) ?? return
    has_service :: specs.iter().any(fn(s) -> (s.spec.provider.split_once("(").map(fn(pair) -> pair.0) ?? s.spec.provider) == "ServiceProbe")
    has_scene :: specs.iter().any(fn(s) -> (s.spec.provider.split_once("(").map(fn(pair) -> pair.0) ?? s.spec.provider) == "SceneProbe")
    if !has_service && !has_scene -> return
    root :: OSPath.new(file).canonicalize().ok().and_then(fn(p) -> p.parent().map(fn(d) -> d.to_path_buf())).and_then(fn(d) -> .Val(jet.Loader.find_manifest_root(d) ?? d)) ?? OSPath.new(".")
    src :: fs.read_to_string(file) ?? return
    service_evidence :: if has_service -> collect_service_evidence(root, specs) else -> []
    scene_evidence :: if has_scene -> collect_scene_evidence(file, src, mode, specs) else -> []
    status :: CmdBudget.run_dev_refresh(file, service_evidence, scene_evidence)
    if status != 0 -> eprintln("budget: dev refresh failed with status {status}")
}
