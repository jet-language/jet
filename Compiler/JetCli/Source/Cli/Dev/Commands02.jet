fn render_dev_iteration(file: String, entry_fn: String?, program_args: &[String], try_anyway: Bool, gates: GateSet, mode: OutputMode, use_interpreter: Bool, profile: String, setting_overrides: &[String:String]) -> CheckedMirSnapshot? {
    started :: Instant.now()
    run := run_dev_iteration_with_entry(file, entry_fn, program_args, try_anyway, use_interpreter, gates, profile, setting_overrides)
    render_lints(file, mode, run.lints)
    snapshot :: run.snapshot.take()
    outcome :: run.outcome
    elapsed :: started.elapsed()
    ran_ok :: if outcome == { .Ran(_, _, _) -> true; _ -> false }
    render_outcome_timed(outcome, file, .Val(elapsed), mode)
    if ran_ok {
        if snapshot == .Val(snapshot) {
            run_dev_budget_refresh(file, snapshot.bundle, mode)
            return .Val(snapshot)
        }
    }
    None
}
