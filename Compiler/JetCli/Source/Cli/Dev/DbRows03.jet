// Rust: Source/CmdTest.rs:194
fn run_test_compare(target: String, args: &[String], mode: OutputMode) -> Never {
    json_output :: jet_cli_test_comparison_json_output(args, mode.json)
    relation_override :: jet_cli_test_comparison_relation_override(args)
    // GATE #4494: actual filesystem input and process exit.
    input :: if fs.read_to_string(target) == {
        Ok(input) -> input
        Err(error) -> {
            output :: jet_cli_test_comparison_error_output(json_output, "cannot read comparison corpus `{target}`: {error}")
            print(output.stdout)
            eprint(output.stderr)
            process.exit(ExitCodes.USER_ERROR)
        }
    }
    root :: foundation_parse_protocol_json(input).unwrap_or_else(() -> {
        output :: jet_cli_test_comparison_error_output(json_output, "invalid comparison corpus `{target}`: record is not valid JSON")
        print(output.stdout)
        eprint(output.stderr)
        process.exit(ExitCodes.USER_ERROR)
    })
    binding :: if jet_cli_test_comparison_binding_from_root(root) == {
        Ok(binding) -> binding
        Err(error) -> {
            output :: jet_cli_test_comparison_error_output(json_output, "invalid comparison corpus `{target}`: {error.message}")
            print(output.stdout)
            eprint(output.stderr)
            process.exit(ExitCodes.USER_ERROR)
        }
    }
    parsed :: if jet_cli_test_comparison_parse_root(root, relation_override) == {
        Ok(record) -> record
        Err(error) -> {
            output :: jet_cli_test_comparison_error_output(json_output, "invalid comparison corpus `{target}`: {error.message}")
            print(output.stdout)
            eprint(output.stderr)
            process.exit(ExitCodes.USER_ERROR)
        }
    }
    record :: jet_cli_test_comparison_runner_outcome(^parsed, root)
    owned_target :: target.to_string()
    owned_args :: args.to_vec()
    record_for_history :: record.clone()
    binding_for_history :: binding.clone()
    // GATE #4494: canonical asynchronous optional-history queue, not synchronous fallback.
    ReceiptStore.enqueue_optional_history("writing a comparison record", () -> {
        if persist_comparison_artifacts(owned_target, owned_args, record_for_history, binding_for_history) == {
            Err(error) -> ReceiptStore.optional_history_notice("writing a comparison record", error)
            Ok(_) -> {}
        }
    })
    output :: jet_cli_test_comparison_record_output(record, json_output)
    print(output.stdout)
    eprint(output.stderr)
    process.exit(output.exit_code)
}
// Rust: Source/CmdTest.rs:261
// parse_record -> Compile/TestComparisonCorpus.jet:183 jet_cli_test_comparison_parse_record.
// The native command reuses parse_root on the already retained canonical tree.

// Rust: Source/CmdTest.rs:304
fn persist_comparison_artifacts(target: String, args: &[String], record: &ComparisonRecord,
    binding: &JetCLITestComparisonBinding) -> Void Err! {
    // Rust: Source/CmdTest.rs:310-371
    // Existing canonical helper owns identity, binding attachments, checked
    // derivation and report construction, preserving the original Unit/Test rows.
    report :: jet_cli_test_comparison_evidence_report(target, record, binding).map_err(error -> error.message)?
    persist_evidence_report(report)?
    payload :: comparison_record_to_json(record).map_err(error -> error.message)?
    artifact_id :: canonical_json_sha256(payload)
    // GATE #4494: cwd and canonical real receipt/index persistence.
    cwd :: env.current_dir().map_err(error -> error.to_string())?
    argv :: args.to_vec()
    input_paths :: input_paths_for("test-compare", argv, cwd)
    if input_paths.is_empty() { return Err("comparison corpus has no current input path") }
    root :: receipt_root_for("test-compare", argv, cwd)
    store :: ReceiptStore.new(root)
    section :: ReceiptSection.from_json("comparison", "ComparisonRecord", payload)?
    evidence_link :: RecordLink.new(RecordKind.Evidence, report.identity.report_id)?
    comparison_link :: RecordLink.new(RecordKind.Comparison, artifact_id)?
    status :: if comparison_status_is_success(record.status) { 0 } else { 1 }
    store.record_with_sections_and_links("test-compare", argv, input_paths, status,
        &[], &[], &[section], &[evidence_link], &[comparison_link])?
    Ok(())
}
