// The semantic index's stable query types (and the `SymKind`/`SymDef`/`SymRef`
// records walks into). The index is versioned independently of its consumers:
// `jet inspect semindex`, `jet inspect expand`, and `jet doc` read these rows;
// LSP hover and inlay projections have no Jet consumer and are not part of this
// port.
use jet_foundation.[
    AccessConvention,
    CallablePolicy,
    DerivationRecord,
    EffectRowEntry,
    FailureContract,
    NamedSpan,
    ParamZone,
    Span,
    Type,
    ViewProvenanceMap,
    failure_contract_shown_type,
    failure_contract_source,
    type_name,
    Field,
    Param,
]

// `SCHEMA_VERSION`: bump when the exported fact shape changes incompatibly.
JET_CLI_SEMINDEX_SCHEMA_VERSION: 20

// `CallableFactUnavailable`: the typed reason a checked projection cannot
// supply a later metadata value.
JetCLISemUnavailable: struct {
    required_stage: String
    reason: String
}

// `CallableDefaultFact`: a source-text projection of a declared default; its
// prepared value is unavailable.
JetCLISemDefault: struct {
    source_text: String
    source: Span
}

// One public call slot (`CallableParameterFact` plus the `SymKind::Function`
// parallel rows it is assembled from).
JetCLISemParam: struct {
    name: String
    ty: Type
    source: Span
    label: String
    zone: ParamZone
    variadic: Bool
    access: AccessConvention
    default: JetCLISemDefault?
}

// `failure_contract` is `None` exactly when `failure_unavailable` explains why
// (`CallableFactAvailability`); the same holds for `generic_parameters`.
JetCLISemCallable: struct {
    params: [JetCLISemParam]
    signature_facts_available: Bool
    return_type: Type?
    failure_contract: FailureContract?
    failure_unavailable: JetCLISemUnavailable?
    foreign_boundary: Bool
    effects: [EffectRowEntry]?
    effect_via: NamedSpan?
    policies: [CallablePolicy]
    generic_parameters: [String]?
    generic_unavailable: JetCLISemUnavailable?
}

JetCLISemField: struct {
    name: String
    ty: Type
}

JetCLISemKind: enum {
    Module
    Function(callable: JetCLISemCallable)
    Struct(fields: [JetCLISemField], derives: [String])
    Enum(variants: [String], derives: [String])
    Trait
    Tag
    Type(derives: [String])
    Const
    EnumVariant(parent: String)
    Field(ty: Type, parent: String)
    Local(mutable: Bool, ty: Type?)
    Param(ty: Type)
}

// `qualified_name` is the canonical display path the walk records with the
// definition.
JetCLISemDef: struct {
    identity: String
    name: String
    qualified_name: String
    def_span: Span
    module_path: String
    kind: JetCLISemKind
}

JetCLISemAnchor: struct {
    module_path: String
    kind: String
    def_span: Span
    semantic_identity: String?
}

JetCLISemCompilerFact: struct {
    name: String
    kind: String
    type_name: String
}

JetCLISemRef: struct {
    name: String
    span: Span
    module_path: String
    scope_identity: String?
    target: JetCLISemAnchor?
    fact: JetCLISemCompilerFact?
}

JetCLISemCall: struct {
    caller: String
    callee: String
    module_path: String
    span: Span
}

// `kind` is `field`, `variant`, or `method`; `origin` is `type_body`,
// `inherent_impl`, `trait_impl`, or `trait_requirement`, with `origin_trait`
// naming the trait of the last two.
JetCLISemMember: struct {
    owner: String
    name: String
    identity: String
    kind: String
    origin: String
    origin_trait: String
    signature: String
    module_path: String
    span: Span
}

JetCLISemEffectProvenance: struct {
    effect_name: String
    call_path: [String]
    spans: [Span]
}

JetCLISemEffect: struct {
    function: String
    direct: [String]
    callees: [String]
    inferred: [String]
    maximal: Bool
    provenance: [JetCLISemEffectProvenance]
}

JetCLISemArithmetic: struct {
    operation: String
    policy: String
    module_path: String
    operation_span: Span
    scope_span: Span
}

// `slot_kind` is `scalar` or `list`.
JetCLISemNode: struct {
    id: Int
    parent: Int?
    slot: String
    slot_kind: String
    ordinal: Int
    class: String
    shape: String
    module_path: String
    span: Span
}

JetCLISemSlotBoundary: struct {
    parent: Int
    slot: String
    module_path: String
    span: Span
}

// `kind` is the stable `BypassKind::as_str` word.
JetCLISemBypass: struct {
    kind: String
    site: String
    detail: String
    module_path: String
    span: Span
}

JetCLISemDefinitionFact: struct {
    stable_id: String
    signature_id: String
    content_id: String
    human_identity: String
    name: String
    kind: String
    module_path: String
    span: Span
}

// An associated type with no `ty` is a requirement (`type Item`).
JetCLISemAssociatedType: struct {
    name: String
    ty: String?
}

JetCLISemTraitContract: struct {
    trait_name: String
    associated_types: [JetCLISemAssociatedType]
    methods: [String]
}

JetCLISemInstanceApplication: struct {
    name: String
    module_path: String
    semantic_identity: String
    span: Span
}

JetCLISemInstance: struct {
    name: String
    module_path: String
    fingerprint: String
    full_key_hex: String
    template_definition_id: String
    template_span: Span
    arguments: [String]
    argument_values: [String]
    argument_provenance: [[String]]
    applications: [JetCLISemInstanceApplication]
    exported_members: [String]
}

JetCLISemOutputEntry: struct {
    identity: String
    name: String
    module_path: String
    definition_span: Span
    reference_span: Span
    params: [String]
    return_type: String?
    failure_contract: String
    failure_source: String
    authority: String
    effects: [String]
}

JetCLISemOutput: struct {
    binding: String
    kind: String
    name: String
    module_path: String
    span: Span
    entry: JetCLISemOutputEntry
}

JetCLISemStateNode: struct {
    name: String
    terminal: Bool
    reachable: Bool?
    span: Span
}

JetCLISemStateTransition: struct {
    operation: String
    from: String?
    to: String
}

JetCLISemStateGraph: struct {
    owner: String
    module_path: String
    states: [JetCLISemStateNode]
    transitions: [JetCLISemStateTransition]
}

// One converted definition: the walk's record plus the per-definition facts
// `convert_defs` attaches.
JetCLISemDefinition: struct {
    def: JetCLISemDef
    view_provenance: ViewProvenanceMap?
    derives: [String]
    nominal_base: String?
    trait_contracts: [JetCLISemTraitContract]
}

// `SemIndex`: the versioned index over one checked program. Its effect
// projection is the application authority of the same checked program `jet
// build` authorizes.
JetCLISemIndex: struct {
    definitions: [JetCLISemDefinition]
    definition_facts: [JetCLISemDefinitionFact]
    derivations: [DerivationRecord]
    instances: [JetCLISemInstance]
    outputs: [JetCLISemOutput]
    state_graphs: [JetCLISemStateGraph]
    effect_projection: JetCLIAuthority
    references: [JetCLISemRef]
    calls: [JetCLISemCall]
    effects: [JetCLISemEffect]
    arithmetic: [JetCLISemArithmetic]
    members: [JetCLISemMember]
    nodes: [JetCLISemNode]
    slot_boundaries: [JetCLISemSlotBoundary]
    bypasses: [JetCLISemBypass]
}

// `CallableSignatureFact::failure_contract_name`.
jet_cli_sem_failure_contract_name: fn(callable: JetCLISemCallable) -> String? Never! {
    contract: callable.failure_contract ?? return None
    Val(type_name(failure_contract_shown_type(contract)))
}

// `CallableSignatureFact::failure_source_name`.
jet_cli_sem_failure_source_name: fn(callable: JetCLISemCallable) -> String? Never! {
    contract: callable.failure_contract ?? return None
    Val(failure_contract_source(contract))
}

// `CallableParameterFact::access_name`.
jet_cli_sem_access_name: fn(access: AccessConvention) -> String Never! {
    if access == {
        .Read -> "read"
        .Write -> "write"
        .Move -> "move"
    }
}

// `CallableParameterFact::zone_name`.
jet_cli_sem_zone_name: fn(zone: ParamZone) -> String Never! {
    if zone == {
        .PositionalOnly -> "positional_only"
        .Either -> "either"
        .LabelOnly -> "label_only"
    }
}

// The callable a definition carries, when it is a function.
jet_cli_sem_callable: fn(definition: JetCLISemDef) -> JetCLISemCallable? Never! {
    // copy: `callable` is a payload of read parameter `definition`, which keeps the original; the Val carrier owns this one
    if definition.kind == .Function(callable) -> return Val(callable.copy())
    None
}
