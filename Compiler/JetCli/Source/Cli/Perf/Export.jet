// `jet perf export`: one loss-declared projection of a verified `.jettrace`.
// `--json` (the default) wraps the whole trace in the status envelope;
// `--pprof`, `--otel`, `--chrome` and `--emit-profile-map` print their
// projection's canonical JSON. Every projection names what it loses in its
// `loss` field.
use {
    jet_driver.[JetDriverVerbOutput, JET_DRIVER_EXIT_OK]
    jet_foundation.[
        CanonicalJSON, CanonicalJSONField, TRACE_SCHEMA, TRACE_VERSION, artifact_extension,
        canonical_json_bytes, jettrace_object_view, trace_id,
    ]
}

jet_cli_perf_export: fn(args: [String], color: Bool) -[FS]> JetDriverVerbOutput Never! {
    extension: artifact_extension()
    path := String?{None}
    mode := "json"
    loop arg in args {
        if arg == {
            "--json" -> mode = "json"
            "--pprof" -> mode = "pprof"
            "--otel" -> mode = "otel"
            "--chrome" -> mode = "chrome"
            "--emit-profile-map" -> mode = "profile-map"
            else -> {
                if arg.starts_with("-") -> return jet_cli_perf_error("unknown `jet perf export` flag `{arg}`", "run `jet perf export <path{extension}> [--json|--pprof|--otel|--chrome|--emit-profile-map]", color)
                if path != None -> return jet_cli_perf_error("`jet perf export` takes one trace path", JET_CLI_PERF_FIX, color)
                // copy: the argument list keeps its word; the trace path owns its own.
                path = Val(arg.copy())
            }
        }
    }
    shown: path ?? return jet_cli_perf_error("`jet perf export` needs a {extension} path", JET_CLI_PERF_FIX, color)
    trace: jet_cli_perf_read(shown) ?? return jet_cli_perf_error(err.message, JET_CLI_PERF_FIX, color)
    if mode == "json" {
        loss: if jet_cli_perf_has_evidence(trace) -> "json-envelope; typed profile evidence and domains are retained in trace — standard Trace Event payload available with --chrome; pprof/OTel remain JSON projections" else -> "json-envelope-only; standard Trace Event payload available with --chrome; pprof/OTel remain JSON projections"
        envelope: CanonicalJSON.Object([CanonicalJSONField]{
            {key: "kind", value: CanonicalJSON.String("jet.trace.projection")},
            {key: "loss", value: CanonicalJSON.String(loss)},
            {key: "schema", value: CanonicalJSON.String(TRACE_SCHEMA)},
            {key: "trace", value: trace},
            {key: "version", value: CanonicalJSON.Integer("{TRACE_VERSION}")},
        })
        return JetDriverVerbOutput{stdout: jet_cli_perf_json("perf.export", envelope), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
    projection: if mode == {
        "pprof" -> jet_cli_perf_pprof(trace)
        "otel" -> jet_cli_perf_otel(trace)
        "chrome" -> jet_cli_perf_chrome(trace)
        else -> jet_cli_perf_profile_map(trace)
    }
    JetDriverVerbOutput{stdout: String.from_bytes(canonical_json_bytes(projection)) ?? "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

jet_cli_perf_string_field: fn(key: String, value: String) -> CanonicalJSONField Never! {
    CanonicalJSONField{key: key, value: CanonicalJSON.String(value)}
}

jet_cli_perf_integer_field: fn(key: String, value: Int) -> CanonicalJSONField Never! {
    CanonicalJSONField{key: key, value: CanonicalJSON.Integer("{value}")}
}

// A projection object: `kind`, `loss`, `schema`, `trace_id` and `version`
// around `fields`, in canonical key order.
jet_cli_perf_projection: fn(trace: CanonicalJSON, kind: String, loss: String, fields: [CanonicalJSONField]) -> CanonicalJSON Never! {
    all := fields
    all.push(jet_cli_perf_string_field("kind", kind))
    all.push(jet_cli_perf_string_field("loss", loss))
    all.push(jet_cli_perf_string_field("schema", TRACE_SCHEMA))
    all.push(jet_cli_perf_string_field("trace_id", trace_id(trace) ?? "unknown"))
    all.push(CanonicalJSONField{key: "version", value: CanonicalJSON.Integer("{TRACE_VERSION}")})
    all.sort_by(fn(left: CanonicalJSONField, right: CanonicalJSONField) { left.key <=> right.key })
    CanonicalJSON.Object(all)
}

// `export_pprof_projection`.
jet_cli_perf_pprof: fn(trace: CanonicalJSON) -> CanonicalJSON Never! {
    samples := [CanonicalJSON]{}
    loop domain in ([String]{"wall", "cpu"}) {
        if jet_cli_perf_sample_duration(trace, domain) == .Val(ns) {
            samples.push(CanonicalJSON.Object([CanonicalJSONField]{jet_cli_perf_string_field("location", domain), jet_cli_perf_integer_field("value", ns)}))
        }
    }
    jet_cli_perf_projection(trace, "jet.trace.pprof-projection", "pprof-json; samples are Jet wall/cpu only — no native stack frames, no gzip proto, no labels beyond domain", [CanonicalJSONField]{{key: "samples", value: CanonicalJSON.Array(samples)}})
}

// The content rows `key`, copied into a projection (empty when absent).
jet_cli_perf_rows_copy: fn(trace: CanonicalJSON, key: String, out: &[CanonicalJSON]) Never! {
    items: jet_cli_perf_rows(trace, key) ?? return
    // copy: the verified trace keeps its rows; the projection owns its own.
    loop item in items -> out.push(item.copy())
}

// `export_otel_projection`.
jet_cli_perf_otel: fn(trace: CanonicalJSON) -> CanonicalJSON Never! {
    spans := [CanonicalJSON]{}
    jet_cli_perf_rows_copy(trace, "spans", spans)
    jet_cli_perf_rows_copy(trace, "browser", spans)
    jet_cli_perf_projection(trace, "jet.trace.otel-projection", "otel-json; Jet spans/browser only — no resource attributes, no OTLP protobuf, no baggage/traceparent wire", [CanonicalJSONField]{{key: "spans", value: CanonicalJSON.Array(spans)}})
}

// `export_profile_map_projection`.
jet_cli_perf_profile_map: fn(trace: CanonicalJSON) -> CanonicalJSON Never! {
    symbols := [CanonicalJSON]{}
    maps := [CanonicalJSON]{}
    jet_cli_perf_rows_copy(trace, "source_identity", symbols)
    jet_cli_perf_rows_copy(trace, "source_maps", maps)
    profile := CanonicalJSON.Null
    if jet_cli_perf_content(trace) == .Ok(content) {
        // copy: the verified trace keeps its profile; the projection owns its own.
        if jet_cli_perf_key(content, "profile") == .Val(at) -> profile = content[at].value.copy()
    }
    jet_cli_perf_projection(trace, "jet.trace.profile-map-projection", "profile-map; source_identity+source_maps+typed profile evidence — no Rust/LLVM frames, no address ranges, no DWARF", [CanonicalJSONField]{
        {key: "profile", value: profile},
        {key: "source_identity", value: CanonicalJSON.Array(symbols)},
        {key: "source_maps", value: CanonicalJSON.Array(maps)},
    })
}

// `export_chrome_projection`: Trace Event Format `X` events on named lanes.
jet_cli_perf_chrome: fn(trace: CanonicalJSON) -> CanonicalJSON Never! {
    events := [CanonicalJSON]{}
    events.push(CanonicalJSON.Object([CanonicalJSONField]{
        {key: "args", value: CanonicalJSON.Object([CanonicalJSONField]{jet_cli_perf_string_field("name", "Jet perf")})},
        jet_cli_perf_string_field("name", "process_name"),
        jet_cli_perf_string_field("ph", "M"),
        jet_cli_perf_integer_field("pid", 1),
    }))
    lanes: [String]{"wall samples", "cpu samples", "browser", "lock contention", "native CPU", "allocations"}
    loop (index, lane) in lanes -> jet_cli_perf_chrome_lane(events, index + 1, lane)
    if jet_cli_perf_rows(trace, "samples") == .Ok(items) {
        loop item in items {
            duration: jet_cli_perf_member_number(item, "duration_ns") ?? next
            domain: jet_cli_perf_member_text(item, "domain") ?? next
            tid: if domain == {
                "wall" -> 1
                "cpu" -> 2
                else -> 0
            }
            if tid != 0 -> jet_cli_perf_chrome_event(events, item, 0, duration, tid)
        }
    }
    if jet_cli_perf_rows(trace, "allocations") == .Ok(items) {
        loop item in items -> jet_cli_perf_chrome_event(events, item, 0, 0, 6)
    }
    if jet_cli_perf_rows(trace, "tasks") == .Ok(items) {
        loop item in items {
            task: jet_cli_perf_member_number(item, "id") ?? next
            jet_cli_perf_chrome_lane(events, 1000 + task, "task {task}")
        }
    }
    if jet_cli_perf_rows(trace, "browser") == .Ok(items) {
        loop item in items {
            start: jet_cli_perf_member_number(item, "start_ns") ?? next
            duration: jet_cli_perf_member_number(item, "duration_ns") ?? next
            jet_cli_perf_chrome_event(events, item, start, duration, 3)
        }
    }
    loop key in ([String]{"spans", "io"}) {
        if jet_cli_perf_rows(trace, key) == .Ok(items) {
            loop item in items {
                if key == "spans" && (jet_cli_perf_member_text(item, "status") ?? "") != "captured" -> next
                start: jet_cli_perf_member_number(item, "start_ns") ?? next
                end: jet_cli_perf_member_number(item, "end_ns") ?? next
                task: jet_cli_perf_member_number(item, "task_id") ?? next
                duration: if end > start -> end - start else -> 0
                jet_cli_perf_chrome_event(events, item, start, duration, 1000 + task)
            }
        }
    }
    if jet_cli_perf_rows(trace, "locks") == .Ok(items) {
        loop item in items -> jet_cli_perf_chrome_event(events, item, 0, 0, 4)
    }
    if jet_cli_perf_rows(trace, "native") == .Ok(items) {
        loop item in items {
            if (jet_cli_perf_member_text(item, "status") ?? "") != "captured" -> next
            start: jet_cli_perf_member_number(item, "observed_at_ns") ?? next
            duration: jet_cli_perf_member_number(item, "duration_ns") ?? next
            tid: if jet_cli_perf_member_number(item, "task_id") == .Val(task) -> 1000 + task else -> 5
            jet_cli_perf_chrome_event(events, item, start, duration, tid)
        }
    }
    jet_cli_perf_projection(trace, "jet.trace.chrome-projection", "chrome-trace-json; captured X events cover wall/cpu/alloc/browser/task spans/io/locks/native and M lane metadata — unavailable states, async flow events, counter tracks, screenshots, and source-map events remain unprojected", [CanonicalJSONField]{{key: "traceEvents", value: CanonicalJSON.Array(events)}})
}

// `chrome_thread_name`: an `M` event naming lane `tid`.
jet_cli_perf_chrome_lane: fn(events: &[CanonicalJSON], tid: Int, name: String) Never! {
    events.push(CanonicalJSON.Object([CanonicalJSONField]{
        {key: "args", value: CanonicalJSON.Object([CanonicalJSONField]{jet_cli_perf_string_field("name", name)})},
        jet_cli_perf_string_field("name", "thread_name"),
        jet_cli_perf_string_field("ph", "M"),
        jet_cli_perf_integer_field("pid", 1),
        jet_cli_perf_integer_field("tid", tid),
    }))
}

// `chrome_symbol_event`: an `X` event for the row `item` when it names a symbol.
jet_cli_perf_chrome_event: fn(events: &[CanonicalJSON], item: CanonicalJSON, start_ns: Int, duration_ns: Int, tid: Int) Never! {
    fields: jettrace_object_view(item, "jettrace row") ?? return
    at: jet_cli_perf_key(fields, "symbol") ?? return
    name: jet_cli_perf_symbol(fields[at].value) ?? return
    symbol: jettrace_object_view(fields[at].value, "symbol") ?? return
    path: jet_cli_perf_field_text(symbol, "path") ?? return
    function: jet_cli_perf_field_text(symbol, "name") ?? return
    args := [CanonicalJSONField]{
        jet_cli_perf_string_field("file", path),
        jet_cli_perf_string_field("location", "{path}:{function}"),
        jet_cli_perf_string_field("symbol", function),
    }
    // `chrome_symbol_args`: the listed keys the symbol itself carries.
    keys: [String]{
        "bytes", "cancelled", "capacity", "class", "clock", "closed", "count", "depth", "domain", "id",
        "kind", "parent", "parent_task_id", "reason", "recv_waiters", "send_waiters", "state", "status",
        "target", "task_id", "wait",
    }
    loop key in keys {
        // copy: the verified trace keeps its symbol and the key list its key; the event owns its own.
        if jet_cli_perf_key(symbol, key) == .Val(found) -> args.push(CanonicalJSONField{key: key.copy(), value: symbol[found].value.copy()})
    }
    args.sort_by(fn(left: CanonicalJSONField, right: CanonicalJSONField) { left.key <=> right.key })
    events.push(CanonicalJSON.Object([CanonicalJSONField]{
        {key: "args", value: CanonicalJSON.Object(args)},
        jet_cli_perf_integer_field("dur", duration_ns /% 1000),
        jet_cli_perf_string_field("name", name),
        jet_cli_perf_string_field("ph", "X"),
        jet_cli_perf_integer_field("pid", 1),
        jet_cli_perf_integer_field("tid", tid),
        jet_cli_perf_integer_field("ts", start_ns /% 1000),
    }))
}
