// Native C link closure (D-FFI-UNIFY1/I9). The host realizes checked link
// facts; it never changes a signature, owns a handle, or wraps a C function.
use core.files as cli_files
use core.process as cli_process
use core.sys as cli_sys
use jet_driver.[JetDriverAuthorizedSourceSnapshot, jet_driver_c_dependencies]
use jet_foundation.[MIRProgram, MIRLinkArtifactKind, mir_sha256_bytes, mir_sha256_hex_bytes]

struct JetCLIForeignInputs {
    names: [String]
    bytes: [[U8]]
    paths: [String]
}

fn jet_cli_foreign_add(inputs: &JetCLIForeignInputs, path: String) -[FS]> String! {
    if inputs.paths.contains(path) -> return Ok(())
    bytes :: cli_files.read_bytes(path) ?? return Err("couldn't read C link input `{path}`: {err}")
    &inputs.paths.push(path)
    &inputs.names.push(path)
    &inputs.bytes.push(bytes)
    Ok(())
}

// A length-delimited identity avoids concatenation aliases.
fn jet_cli_foreign_hash_field(identity: &[U8], name: String, value: [U8]) Never! {
    name_bytes :: name.bytes()
    loop shift in 0..<8 -> &identity.push(U8{(name_bytes.len() >> (shift * 8)) & 255})
    loop byte in name_bytes -> &identity.push(byte)
    loop shift in 0..<8 -> &identity.push(U8{(value.len() >> (shift * 8)) & 255})
    loop byte in value -> &identity.push(byte)
}

// SQLite is the sanctioned bundled dependency, not the machine's sqlite.
// These are libsqlite3-sys 0.28.0 build.rs120-141,245-249 on Linux.
fn jet_cli_sqlite_c_flags() -> [String] Never! {
    [String]{
        "-DSQLITE_CORE", "-DSQLITE_DEFAULT_FOREIGN_KEYS=1",
        "-DSQLITE_ENABLE_API_ARMOR", "-DSQLITE_ENABLE_COLUMN_METADATA",
        "-DSQLITE_ENABLE_DBSTAT_VTAB", "-DSQLITE_ENABLE_FTS3",
        "-DSQLITE_ENABLE_FTS3_PARENTHESIS", "-DSQLITE_ENABLE_FTS5",
        "-DSQLITE_ENABLE_JSON1", "-DSQLITE_ENABLE_LOAD_EXTENSION=1",
        "-DSQLITE_ENABLE_MEMORY_MANAGEMENT", "-DSQLITE_ENABLE_RTREE",
        "-DSQLITE_ENABLE_STAT2", "-DSQLITE_ENABLE_STAT4", "-DSQLITE_SOUNDEX",
        "-DSQLITE_THREADSAFE=1", "-DSQLITE_USE_URI", "-DHAVE_USLEEP=1",
        "-D_POSIX_THREAD_SAFE_FUNCTIONS", "-DHAVE_ISNAN", "-DHAVE_LOCALTIME_R", "-w",
    }
}

// Realize a local c@path directory. All .c translation units are compiled;
// local source/header bytes, exact flags, target and tools own the cache key.
// Published archives are immutable, with a digest sidecar checked on reuse.
fn jet_cli_foreign_compile(lib: String, directory: String, cache: String) -[FS, Env, Exec, Time.Wait]> String String! {
    compiler :: cli_process.which(cli_sys.get("CC") ?? "cc") ?? return Err("the C compiler is not installed")
    archiver :: cli_process.which(cli_sys.get("AR") ?? "ar") ?? return Err("the C archiver is not installed")
    target :: cli_process.cmd([String]{compiler, "-dumpmachine"}).run() ?? return Err("couldn't query C compiler target: {err}")
    if !target.success || !target.output.trim().starts_with("x86_64") -> return Err("C compiler must target x86_64 for the native linker: {target.output}{target.errors}")
    flags := [String]{"-std=c11", "-O2", "-fPIC", "-fno-stack-protector", "-fno-asynchronous-unwind-tables", "-fno-unwind-tables", "-D_GNU_SOURCE"}
    if lib == "sqlite3" {
        loop flag in jet_cli_sqlite_c_flags() -> &flags.push(flag)
    }
    entries :: cli_files.walk_files(directory, None) ?? return Err("couldn't read C source directory `{directory}`: {err}")
    paths := [String]{}
    loop entry in entries {
        if entry.path.ends_with(".c") || entry.path.ends_with(".h") -> &paths.push(entry.path)
    }
    paths = jet_cli_sorted_set(paths)
    sources := [String]{}
    identity := [U8]{}
    jet_cli_foreign_hash_field(&identity, "schema", "jet-native-c-v1".bytes())
    jet_cli_foreign_hash_field(&identity, "target", target.output.bytes())
    loop (index, tool) in [String]{compiler, archiver} {
        content :: cli_files.read_bytes(tool) ?? return Err("couldn't read C tool `{tool}`: {err}")
        jet_cli_foreign_hash_field(&identity, if index == 0 -> "compiler" else -> "archiver", content)
    }
    loop flag in flags -> jet_cli_foreign_hash_field(&identity, "flag", flag.bytes())
    loop path in paths {
        content :: cli_files.read_bytes(path) ?? return Err("couldn't read C input `{path}`: {err}")
        relative :: path.removeprefix("{directory}/")
        jet_cli_foreign_hash_field(&identity, relative, content)
        if path.ends_with(".c") -> &sources.push(path)
    }
    if sources.len() == 0 -> return Err("C dependency `{lib}` has neither a static archive nor C sources in `{directory}`")
    // Hash what the compiler will consume, including every system/header
    // input. Compile these immutable preprocessed bytes on a cache miss.
    preprocessed := [String]{}
    loop source in sources {
        argv := [String]{compiler}
        loop flag in flags -> &argv.push(flag)
        loop flag in [String]{"-ffile-prefix-map={directory}=/jet/c", "-I", directory, "-E", "-P", source} -> &argv.push(flag)
        receipt :: cli_process.cmd(argv).run() ?? return Err("couldn't preprocess C dependency `{lib}`: {err}")
        if !receipt.success -> return Err("C compiler rejected `{source}`: {receipt.errors}")
        jet_cli_foreign_hash_field(&identity, "preprocessed", receipt.output.bytes())
        &preprocessed.push(receipt.output)
    }
    key :: mir_sha256_hex_bytes(mir_sha256_bytes(identity))
    store :: "{cache}/{key}"
    archive :: "{store}/lib{lib}.a"
    if cli_files.read_bytes(archive) == .Ok(bytes) {
        digest :: cli_files.read("{archive}.sha256") ?? ""
        if digest.trim() == mir_sha256_hex_bytes(mir_sha256_bytes(bytes)) -> return Ok(archive)
    }
    cli_files.create_dir_all(store) ?? return Err("couldn't create C object cache `{store}`: {err}")
    temporary :: "{store}/build-{cli_sys.pid()}"
    cli_files.create_dir_all(temporary) ?? return Err("couldn't create C build directory: {err}")
    objects := [String]{}
    loop (index, source) in preprocessed {
        staged_source :: "{temporary}/{index}.i"
        cli_files.write(staged_source, source) ?? return Err("couldn't stage preprocessed C source: {err}")
        object :: "{temporary}/{index}.o"
        argv := [String]{compiler}
        loop flag in flags -> &argv.push(flag)
        loop flag in [String]{"-c", staged_source, "-o", object} -> &argv.push(flag)
        receipt :: cli_process.cmd(argv).run() ?? return Err("couldn't compile C dependency `{lib}`: {err}")
        if !receipt.success -> return Err("C compiler rejected `{sources[index]}`: {receipt.errors}")
        &objects.push(object)
    }
    staged :: "{temporary}/lib{lib}.a"
    argv := [String]{archiver, "rcsD", staged}
    loop object in objects -> &argv.push(object)
    receipt :: cli_process.cmd(argv).run() ?? return Err("couldn't archive C dependency `{lib}`: {err}")
    if !receipt.success -> return Err("C archiver rejected `{lib}`: {receipt.errors}")
    bytes :: cli_files.read_bytes(staged) ?? return Err("couldn't read compiled C archive: {err}")
    digest :: mir_sha256_hex_bytes(mir_sha256_bytes(bytes))
    cli_files.rename(staged, archive) ?? return Err("couldn't publish C archive: {err}")
    cli_files.write("{temporary}/digest", digest) ?? return Err("couldn't write C archive digest: {err}")
    cli_files.rename("{temporary}/digest", "{archive}.sha256") ?? return Err("couldn't publish C archive digest: {err}")
    cli_files.remove_all(temporary) ?? return Err("couldn't remove C build objects: {err}")
    Ok(archive)
}

fn jet_cli_foreign_static_archive(lib: String, directories: [String], cache: String, source_provider: Bool) -[FS, Env, Exec, Time.Wait]> String String! {
    name :: lib.removeprefix("static=").removeprefix("dylib=")
    loop directory in directories {
        path :: "{directory}/lib{name}.a"
        if cli_files.is_file(path) -> return Ok(path)
    }
    // A declared local source directory is a source provider, not a request
    // to silently link a similarly named installed library.
    if source_provider && directories.len() > 0 -> return jet_cli_foreign_compile(name, directories[0], cache)
    compiler :: cli_sys.get("CC") ?? "cc"
    receipt :: cli_process.cmd([String]{compiler, "-print-file-name=lib{name}.a"}).run() ?? return Err("couldn't find C archive `{name}`: {err}")
    path :: receipt.output.trim()
    if !receipt.success || path == "lib{name}.a" || !cli_files.is_file(path) -> return Err("C static archive `{name}` was not found")
    Ok(path)
}

fn jet_cli_native_c_inputs(program: MIRProgram, snapshot: JetDriverAuthorizedSourceSnapshot, runtime_dir: String) -[FS, Env, Exec, Time.Wait]> JetCLIForeignInputs String! {
    inputs := JetCLIForeignInputs{names: [String]{}, bytes: [[U8]]{}, paths: [String]{}}
    root := ""
    loop candidate in snapshot.roots {
        if candidate.identity == snapshot.entry_root_identity -> root = candidate.canonical_path
    }
    if root == "" -> return Err("C link resolution has no authorized entry source root")
    cache :: "{root}/.jet/clinks/objects"
    declarations :: jet_driver_c_dependencies(snapshot)
    libraries := program.cffi.direct_links
    if libraries.len() == 0 {
        loop row in program.cffi.libs -> &libraries.push(row.lib)
    }
    loop lib in program.cffi.transitive_links -> &libraries.push(lib)
    libraries = jet_cli_sorted_set(libraries)
    loop lib in libraries {
        // The runtime pack supplies these platform archives once.
        if [String]{"c", "m", "pthread", "dl", "rt", "util"}.contains(lib) -> next
        directories := [String]{}
        declared_system := false
        loop declaration in declarations {
            if declaration.library != lib -> next
            target :: declaration.target
            if lib == "sqlite3" && (target == "system" || target.starts_with("nixpkgs:")) -> next
            if target == "system" {
                declared_system = true
                next
            }
            directory := ""
            if target.starts_with("nixpkgs:") {
                directory = jet_cli_foreign_nix_directory(lib, target.removeprefix("nixpkgs:"), declaration.root) ?? return Err(err)
            } else {
                directory = cli_files.canonicalize(cli_files.join(declaration.root, target)) ?? return Err("couldn't resolve C dependency `{lib}` at `{target}`: {err}")
            }
            if !directories.contains(directory) -> &directories.push(directory)
        }
        if directories.len() > 1 -> return Err("C dependency `{lib}` has conflicting declarations")
        if lib == "sqlite3" && directories.len() == 0 -> &directories.push("{runtime_dir}/foreign/sqlite3")
        if directories.len() > 0 {
            path :: jet_cli_foreign_static_archive(lib, directories, cache, true) ?? return Err(err)
            jet_cli_foreign_add(&inputs, path) ?? return Err(err)
            next
        }
        // Undeclared imports require pkg-config; an explicit c@system falls
        // back to the same nixpkgs provisioning as the seed resolver.
        output := ""
        configured := false
        if cli_process.cmd([String]{"pkg-config", "--static", "--libs", lib}).run() == .Ok(receipt) {
            if receipt.success {
                output = receipt.output
                configured = true
            }
        }
        if !configured {
            if !declared_system -> return Err("C dependency `{lib}` was not declared and pkg-config did not find it")
            directory :: jet_cli_foreign_nix_directory(lib, lib, root) ?? return Err(err)
            path :: jet_cli_foreign_static_archive(lib, [String]{directory}, cache, false) ?? return Err(err)
            jet_cli_foreign_add(&inputs, path) ?? return Err(err)
            next
        }
        words :: output.replace("\n", " ").replace("\t", " ").split(" ").to_list()
        names := [String]{}
        loop word in words {
            if word.starts_with("-L") -> &directories.push(word.removeprefix("-L"))
            if word.starts_with("-l") -> &names.push(word.removeprefix("-l"))
        }
        if names.len() == 0 -> &names.push(lib)
        loop name in names {
            if [String]{"c", "m", "pthread", "dl", "rt", "util"}.contains(name) -> next
            path :: jet_cli_foreign_static_archive(name, directories, cache, false) ?? return Err(err)
            jet_cli_foreign_add(&inputs, path) ?? return Err(err)
        }
    }
    // Generated foreign providers already declare exact objects/archives.
    loop link in program.links {
        loop artifact in link.artifacts {
            if artifact.kind == {
                .Object | .StaticLibrary -> jet_cli_foreign_add(&inputs, artifact.path) ?? return Err(err)
                else -> return Err("native foreign link input `{artifact.path}` is not an object or static archive")
            }
        }
    }
    Ok(inputs)
}

// The same declared nixpkgs provisioning as the seed C resolver. A native
// link still selects static archive bytes, never a dynamic loader fallback.
fn jet_cli_foreign_nix_directory(lib: String, attr: String, root: String) -[FS, Env, Exec, Time.Wait]> String String! {
    cache :: "{root}/.jet/clinks/{lib}"
    stored :: (cli_files.read(cache) ?? "").trim()
    if stored.len() > 0 && cli_files.is_dir(stored) -> return Ok("{stored}/lib")
    receipt :: cli_process.cmd([String]{"nix", "build", "--no-link", "--print-out-paths", "nixpkgs#{attr}"}).run() ?? return Err("couldn't provision C dependency `{lib}`: {err}")
    if !receipt.success -> return Err("couldn't provision C dependency `{lib}`: {receipt.errors}")
    lines :: receipt.output.trim().split("\n").to_list()
    if lines.len() != 1 || !cli_files.is_dir(lines[0]) -> return Err("C dependency `{lib}` provisioning returned no single store directory")
    cli_files.create_dir_all("{root}/.jet/clinks") ?? return Err("couldn't create C dependency cache: {err}")
    cli_files.write(cache, lines[0]) ?? return Err("couldn't write C dependency cache: {err}")
    Ok("{lines[0]}/lib")
}
