// Native C link closure (I9). The host realizes checked link facts; it never
// changes a signature or owns a handle. The only C it writes is own inline-body
// wrapper, with the checked declaration's C ABI. Every C compile here applies
// the one native C policy (NativeCPolicy.jet).
use {
    cli_files: core.files
    cli_json: core.encoding.json
    cli_process: core.process
    cli_sys: core.sys
    jet_driver.[JetDriverAuthorizedSourceSnapshot, JetDriverCDependency, JetDriverForeignLinkFacts, JetDriverInlineC, jet_driver_c_dependencies]
    jet_foundation.[BuildOptions, Type, build_options_list, sha256_bytes, sha256_hex_bytes]
    jet_pkg_model.[COMPILER_VERSION]
    jetpack_foundation.[foundation_find_folder, foundation_library_folders]
}

#Error
JetCLIForeignLinkError: struct { message: String }
jet_cli_foreign_link_error: fn(message: String) -> JetCLIForeignLinkError Never! { JetCLIForeignLinkError{message: message} }

JetCLIForeignInputs: struct {
    names: [String]
    bytes: [[U8]]
    paths: [String]
    // The closure carries the program's musl platform archives, so it links
    // the Jet-only runtime object rather than the pre-resolved runtime pack.
    platform: Bool{false}
}

jet_cli_foreign_add: fn(inputs: &JetCLIForeignInputs, path: String) JetCLIForeignLinkError! -[FS]> {
    if inputs.paths.contains(path) -> return Ok()
    bytes: cli_files.read_bytes(path) ?? return Err(jet_cli_foreign_link_error("couldn't read C link input `{path}`: {err}"))
    inputs.paths.push(path.copy())
    inputs.names.push(path.copy())
    inputs.bytes.push(bytes)
    Ok()
}

// The one native C policy (native-c-policy.tsv beside this file), as
// Tools/packaging/native-c-compiler.mjs applies it: the policy flags follow
// the caller's arguments, and the child's NIX_HARDENING_ENABLE loses only the
// policy's removed features. The parent environment is unchanged.
jet_cli_native_c_command: fn(argv: [String]) -[Env, Exec]> cli_process.ProcessSpec Never! {
    full := [String]{}
    loop word in argv -> full.push(word.copy())
    loop flag in JET_CLI_NATIVE_C_FLAGS -> full.push(flag)
    spec := cli_process.cmd(full)
    if cli_sys.get("NIX_HARDENING_ENABLE") == .Val(enabled) {
        kept := [String]{}
        loop feature in enabled.replace("\t", " ").replace("\n", " ").split(" ") {
            if feature.len() > 0 && !JET_CLI_NATIVE_C_HARDENING_REMOVED.contains(feature) -> kept.push(feature)
        }
        spec = spec.env("NIX_HARDENING_ENABLE", kept.join(" "))
    }
    spec
}

// One C compiler command of a batch: its receipt, or why it never ran.
JetCLINativeCOutcome: struct { receipt: ProcessReceipt?, failure: String }

// One launched child of a batch and the command it runs.
JetCLINativeCChild: struct { index: Int, child: ProcessChild }

// Runs the C compiler commands `commands` (jet_cli_native_c_command) as
// child processes, at most one per reported core at a time, and returns
// their outcomes in command order. Each command reads its own input and
// writes only its own output, so every receipt, object and the archive
// joined from them in command order are those of running the commands one
// after another. Callers report the first failed command, as before.
jet_cli_native_c_run_all: fn(commands: [[String]]) -[Env, Exec, Time.Wait]> [JetCLINativeCOutcome] Never! {
    width: cli_sys.cpu_count()
    outcomes := [JetCLINativeCOutcome]{}
    start := 0
    loop start < commands.len() {
        end := start + width
        if end > commands.len() -> end = commands.len()
        // Per command of this wave: why it could not start, "" once launched.
        launch_failures := [String]{}
        children := [JetCLINativeCChild]{}
        loop index in start..<end {
            child: jet_cli_native_c_command(commands[index]).spawn() ?? {
                launch_failures.push("{err}")
                next
            }
            launch_failures.push("")
            children.push(JetCLINativeCChild{index: index, child: child})
        }
        // Reap every launched child, in command order.
        loop running in children {
            loop outcomes.len() < running.index -> outcomes.push(JetCLINativeCOutcome{receipt: None, failure: launch_failures[outcomes.len() - start]})
            receipt: running.child.wait() ?? {
                outcomes.push(JetCLINativeCOutcome{receipt: None, failure: "{err}"})
                next
            }
            outcomes.push(JetCLINativeCOutcome{receipt: Val(receipt), failure: ""})
        }
        loop outcomes.len() < end -> outcomes.push(JetCLINativeCOutcome{receipt: None, failure: launch_failures[outcomes.len() - start]})
        start = end
    }
    outcomes
}

// The C compiler and archiver for the native x86-64 linker. `flags` select
// the compiler's target, sysroot and headers and follow the compiler in
// every command; `link_flags` follow them in a link: the inline C proof link
// and a C or C++ program's (Host.jet jet_cli_native_source).
JetCLINativeCTools: struct { compiler: String, archiver: String, target: String, flags: [String], link_flags: [String] }

// The tools a Jet program's foreign C closure compiles with, the platform
// archives it links once (musl's libc, the compiler builtins and, for a Rust
// helper, the unwinder), and the flags of the inline C proof link.
JetCLIClosureCTools: struct { tools: JetCLINativeCTools, platform: [String], proof: [String] }

// The pack's glibc target: what `jet run` of a C or C++ file builds.
JET_CLI_NATIVE_C_PACK_TARGET: "x86_64-unknown-linux-gnu"
// The glibc target's program loader.
JET_CLI_NATIVE_C_PACK_LOADER: "/lib64/ld-linux-x86-64.so.2"
// The pack's musl target: what a Jet program's C closure compiles for. The
// program links statically, so it names no loader.
JET_CLI_CLOSURE_C_PACK_TARGET: "x86_64-unknown-linux-musl"

// One meaning on every tier: `CC`/`AR`, when set, name the host tools;
// otherwise the C toolchain pack this jet ships (clang, lld and llvm-ar):
// the unpacked pack `JET_CC_PACK_ROOT` names, else the one its `jetpack`
// engine fetches. A host `cc`/`ar` on PATH only serves a jet with no engine
// of its own version beside it.
jet_cli_native_c_tools: fn() -[FS, Env, Exec, Time.Wait]> JetCLINativeCTools JetCLIForeignLinkError! {
    named: cli_sys.get("CC") != None || cli_sys.get("AR") != None
    if !named {
        if cli_sys.get("JET_CC_PACK_ROOT") == .Val(root) && root != "" -> return Ok(jet_cli_native_c_pack_at(root))
        if jet_cli_native_c_engine() == .Val(engine) {
            pack: jet_cli_native_c_pack_fetch(engine) ?? return Err(err)
            return Ok(jet_cli_native_c_pack_at(pack.root))
        }
    }
    jet_cli_native_c_host_tools()
}

// The same choice for a Jet program's C closure. The pack route takes the
// engine's pack and the musl sysroot the engine builds once per Hangar (no
// variable names a sysroot, so `JET_CC_PACK_ROOT` does not serve here): it
// compiles for musl and links musl's `libc.a` and the pack's compiler-rt
// builtins; the pack ships no unwinder, so a Rust helper takes the host C
// compiler's `libgcc_eh.a`. The host route links the musl `libc.a` a
// find_folder search chooses on LIBRARY_PATH and the host compiler's
// `libgcc_eh.a` and `libgcc.a`.
jet_cli_closure_c_tools: fn(rust_helper: String?) -[FS, Env, Exec, Time.Wait]> JetCLIClosureCTools JetCLIForeignLinkError! {
    named: cli_sys.get("CC") != None || cli_sys.get("AR") != None
    if !named {
        if jet_cli_native_c_engine() == .Val(engine) {
            pack: jet_cli_native_c_pack_fetch(engine) ?? return Err(err)
            if pack.musl_sysroot == "" -> return Err(jet_cli_foreign_link_error("`{engine} env fetch-toolchain --json` named no musl sysroot for the program's C closure"))
            root: pack.root
            resources: "{root}/lib/clang/21"
            tools: JetCLINativeCTools{
                compiler: "{root}/bin/clang",
                archiver: "{root}/bin/llvm-ar",
                target: JET_CLI_CLOSURE_C_PACK_TARGET,
                flags: [String]{"--target={JET_CLI_CLOSURE_C_PACK_TARGET}", "--sysroot={pack.musl_sysroot}", "-resource-dir={resources}"},
                link_flags: [String]{"-fuse-ld=lld", "--rtlib=compiler-rt", "--unwindlib=none"}
            }
            platform := [String]{}
            loop path in ([String]{"{pack.musl_sysroot}/usr/lib/libc.a", "{resources}/lib/{JET_CLI_CLOSURE_C_PACK_TARGET}/libclang_rt.builtins.a"}) {
                if !cli_files.is_file(path) -> return Err(jet_cli_foreign_link_error("jet's C toolchain pack lacks `{path}`, which a program's C closure links"))
                platform.push(path)
            }
            if rust_helper != None {
                host: jet_cli_native_c_host_tools() ?? return Err(jet_cli_foreign_link_error("a Rust helper needs an unwinder, which jet's C toolchain pack does not ship: {err.message}"))
                platform.push(jet_cli_native_c_host_archive(host, "libgcc_eh.a") ?? return Err(err))
            }
            return Ok(JetCLIClosureCTools{tools: tools, platform: platform, proof: [String]{"-static", "-nostartfiles"}})
        }
    }
    tools: jet_cli_native_c_host_tools() ?? return Err(err)
    musl: foundation_find_folder("libc.a", foundation_library_folders()).found ?? return Err(jet_cli_foreign_link_error("no folder on LIBRARY_PATH holds musl's static `libc.a`, which a program's C closure links when no `jetpack` engine of this jet's version ships beside it, or `CC`/`AR` name the C tools"))
    platform := [String]{"{musl.folder}/libc.a"}
    loop name in ([String]{"libgcc_eh.a", "libgcc.a"}) -> platform.push(jet_cli_native_c_host_archive(tools, name) ?? return Err(err))
    Ok(JetCLIClosureCTools{tools: tools, platform: platform, proof: [String]{"-shared", "-Wl,--no-undefined"}})
}

// The `jetpack` engine of this jet's version beside it, if any.
jet_cli_native_c_engine: fn() -[FS, Env, Exec, Time.Wait]> String? Never! {
    engine: jet_cli_find_engine_binary(JET_CLI_JETPACK_BINARY) ?? return None
    if jet_cli_query_engine_protocol(engine) != Val(COMPILER_VERSION) -> return None
    Val(engine)
}

// The host `CC`/`AR` (default `cc`/`ar` on PATH), which must target x86-64.
jet_cli_native_c_host_tools: fn() -[FS, Env, Exec, Time.Wait]> JetCLINativeCTools JetCLIForeignLinkError! {
    compiler: cli_process.which(cli_sys.get("CC") ?? "cc") ?? return Err(jet_cli_foreign_link_error("the C compiler is not installed, and no `jetpack` engine of this jet's version ships beside it to provide jet's C toolchain pack"))
    archiver: cli_process.which(cli_sys.get("AR") ?? "ar") ?? return Err(jet_cli_foreign_link_error("the C archiver is not installed, and no `jetpack` engine of this jet's version ships beside it to provide jet's C toolchain pack"))
    target: cli_process.cmd([String]{compiler, "-dumpmachine"}).run() ?? return Err(jet_cli_foreign_link_error("couldn't query C compiler target: {err}"))
    if !target.success || !target.output.trim().starts_with("x86_64") -> return Err(jet_cli_foreign_link_error("C compiler must target x86_64 for the native linker: {target.output}{target.errors}"))
    Ok(JetCLINativeCTools{compiler: compiler, archiver: archiver, target: target.output, flags: [String]{}, link_flags: [String]{}})
}

// The host C compiler's own archive `name` (`libgcc_eh.a`, `libgcc.a`).
jet_cli_native_c_host_archive: fn(tools: JetCLINativeCTools, name: String) -[FS, Env, Exec, Time.Wait]> String JetCLIForeignLinkError! {
    probe := jet_cli_native_c_argv(tools)
    probe.push("-print-file-name={name}")
    receipt: cli_process.cmd(probe).run() ?? return Err(jet_cli_foreign_link_error("couldn't locate the C compiler's `{name}`: {err}"))
    if !receipt.success -> return Err(jet_cli_foreign_link_error("couldn't locate the C compiler's `{name}`: {receipt.errors}"))
    path: receipt.output.trim()
    if path == name || !cli_files.is_file(path) -> return Err(jet_cli_foreign_link_error("the C compiler did not provide `{name}`"))
    Ok(path)
}

// Where the pack and its musl sysroot are, as `jet cc` reaches the pack: the
// engine puts the pack in the Hangar (verifying a copy already there) and
// realizes the musl target, building its sysroot once per Hangar.
JetCLINativeCPack: struct { root: String, musl_sysroot: String }

jet_cli_native_c_pack_fetch: fn(engine: String) -[FS, Env, Exec, Time.Wait]> JetCLINativeCPack JetCLIForeignLinkError! {
    receipt: cli_process.cmd([String]{engine, "env", "fetch-toolchain", "--json"}).run() ?? return Err(jet_cli_foreign_link_error("couldn't run `{engine} env fetch-toolchain`: {err}"))
    if !receipt.success -> return Err(jet_cli_foreign_link_error("jet's C toolchain pack is unavailable: {receipt.errors.trim()}"))
    value: cli_json.parse(receipt.output) ?? return Err(jet_cli_foreign_link_error("`{engine} env fetch-toolchain --json` printed no JSON: {err.reason}"))
    pack := JetCLINativeCPack{root: "", musl_sysroot: ""}
    if value == .Object(fields) {
        loop field in fields {
            if field.key == "root" && field.value == .Text(text) -> pack.root = text.copy()
            if field.key == "musl_sysroot" && field.value == .Text(text) -> pack.musl_sysroot = text.copy()
        }
    }
    if pack.root == "" -> return Err(jet_cli_foreign_link_error("`{engine} env fetch-toolchain --json` named no pack root"))
    Ok(pack)
}

// The tools of the unpacked pack at `root`, for its glibc target. A program
// it links loads through the target's loader, which the pack's clang leaves
// out, as `jet cc` names it (Jetpack CcDriver cli_cc_toolchain_argv).
jet_cli_native_c_pack_at: fn(root: String) -> JetCLINativeCTools Never! {
    sysroot: "{root}/glibc/{JET_CLI_NATIVE_C_PACK_TARGET}"
    JetCLINativeCTools{
        compiler: "{root}/bin/clang",
        archiver: "{root}/bin/llvm-ar",
        target: JET_CLI_NATIVE_C_PACK_TARGET,
        flags: [String]{"--target={JET_CLI_NATIVE_C_PACK_TARGET}", "--sysroot={sysroot}", "-resource-dir={root}/lib/clang/21"},
        link_flags: [String]{"-fuse-ld=lld", "--rtlib=compiler-rt", "--unwindlib=none", "-Wl,--dynamic-linker={JET_CLI_NATIVE_C_PACK_LOADER}"}
    }
}

// `tools.compiler` and its target flags, the head of every C compiler command.
jet_cli_native_c_argv: fn(tools: JetCLINativeCTools) -> [String] Never! {
    argv := [String]{tools.compiler.copy()}
    loop flag in tools.flags -> argv.push(flag.copy())
    argv
}

// Hash the compiler/archiver bytes, target, every flag (policy included) and
// the compiler wrapper's environment inputs: a Nix cc wrapper adds
// NIX_CFLAGS_COMPILE(_BEFORE) and the NIX_HARDENING_ENABLE features to every
// compile, so two environments with the same tool bytes can emit different
// objects and must not share a store entry.
jet_cli_native_c_identity: fn(identity: &[U8], schema: String, tools: JetCLINativeCTools, flags: [String]) JetCLIForeignLinkError! -[FS, Env]> {
    jet_cli_foreign_hash_field(identity, "schema", schema.bytes())
    jet_cli_foreign_hash_field(identity, "target", tools.target.bytes())
    loop (index, tool) in ([String]{tools.compiler, tools.archiver}) {
        content: cli_files.read_bytes(tool) ?? return Err(jet_cli_foreign_link_error("couldn't read C tool `{tool}`: {err}"))
        jet_cli_foreign_hash_field(identity, if index == 0 -> "compiler" else -> "archiver", content)
    }
    loop flag in tools.flags -> jet_cli_foreign_hash_field(identity, "tool-flag", flag.bytes())
    loop flag in flags -> jet_cli_foreign_hash_field(identity, "flag", flag.bytes())
    loop flag in JET_CLI_NATIVE_C_FLAGS -> jet_cli_foreign_hash_field(identity, "policy-flag", flag.bytes())
    loop feature in JET_CLI_NATIVE_C_HARDENING_REMOVED -> jet_cli_foreign_hash_field(identity, "policy-hardening-removed", feature.bytes())
    loop name in ([String]{"NIX_CFLAGS_COMPILE", "NIX_CFLAGS_COMPILE_BEFORE", "NIX_HARDENING_ENABLE"}) {
        jet_cli_foreign_hash_field(identity, "env-{name}", (cli_sys.get(name) ?? "").bytes())
    }
    Ok()
}

// A cached archive is reused only when its digest sidecar matches its bytes.
jet_cli_native_c_cached: fn(archive: String) -[FS]> Bool Never! {
    bytes: cli_files.read_bytes(archive) ?? return false
    digest: cli_files.read("{archive}.sha256") ?? ""
    digest.trim() == sha256_hex_bytes(sha256_bytes(bytes[0..<bytes.len()]))
}

// Archive `objects` deterministically and publish it with its digest
// sidecar; the staged build directory is removed afterwards.
jet_cli_native_c_publish: fn(tools: JetCLINativeCTools, lib: String, temporary: String, objects: [String], archive: String) JetCLIForeignLinkError! -[FS, Env, Exec, Time.Wait]> {
    staged: "{temporary}/lib{lib}.a"
    argv := [String]{tools.archiver, "rcsD", staged}
    loop object in objects -> argv.push(object.copy())
    receipt: cli_process.cmd(argv).run() ?? return Err(jet_cli_foreign_link_error("couldn't archive C dependency `{lib}`: {err}"))
    if !receipt.success -> return Err(jet_cli_foreign_link_error("C archiver rejected `{lib}`: {receipt.errors}"))
    bytes: cli_files.read_bytes(staged) ?? return Err(jet_cli_foreign_link_error("couldn't read compiled C archive: {err}"))
    digest: sha256_hex_bytes(sha256_bytes(bytes[0..<bytes.len()]))
    cli_files.rename(staged, archive) ?? return Err(jet_cli_foreign_link_error("couldn't publish C archive: {err}"))
    cli_files.write("{temporary}/digest", digest) ?? return Err(jet_cli_foreign_link_error("couldn't write C archive digest: {err}"))
    cli_files.rename("{temporary}/digest", "{archive}.sha256") ?? return Err(jet_cli_foreign_link_error("couldn't publish C archive digest: {err}"))
    cli_files.remove_all(temporary) ?? return Err(jet_cli_foreign_link_error("couldn't remove C build objects: {err}"))
    Ok()
}

// A length-delimited identity avoids concatenation aliases.
jet_cli_foreign_hash_field: fn(identity: &[U8], name: String, value: [U8]) Never! {
    name_bytes: name.bytes()
    loop shift in 0..<8 -> identity.push(U8{(name_bytes.len() >> (shift * 8)).bit_and(255)})
    loop byte in name_bytes -> identity.push(byte)
    loop shift in 0..<8 -> identity.push(U8{(value.len() >> (shift * 8)).bit_and(255)})
    loop byte in value -> identity.push(byte)
}

// The per-process build directory (`build-<pid>`, `probe-<pid>`) never
// reaches compiler output: `__FILE__`, the object's file symbol and any debug
// path name it as `.`, so the preprocessed identity and the archive bytes are
// the same for every run and every compiler stage.
jet_cli_native_c_build_map: fn(directory: String) -> String Never! {
    "-ffile-prefix-map={directory}=."
}

// Core's vendored C closures (Core/Vendor/*): a Core module's `c.<lib>`
// import links the archive the toolchain build (Compiler/build.jet) compiled
// once for this runtime, `{runtime_dir}/foreign/<lib>/lib<lib>.a`, never the
// machine's library and never a link-time C compile.
jet_cli_vendored_c_library: fn(lib: String) -> Bool Never! { lib == "sqlite3" || lib == "mbedtls" }

jet_cli_vendored_c_archive: fn(lib: String, runtime_dir: String) -[FS]> String JetCLIForeignLinkError! {
    archive: "{runtime_dir}/foreign/{lib}/lib{lib}.a"
    if !cli_files.is_file(archive) -> return Err(jet_cli_foreign_link_error("Core's vendored C `{lib}` is not packaged with the Jet runtime: {archive} is missing; build the toolchain with `jet build Compiler`"))
    Ok(archive)
}

// Realize a local c@path directory. All .c translation units are compiled;
// local source/header bytes, exact flags, target and tools own the cache key.
// Published archives are immutable, with a digest sidecar checked on reuse.
jet_cli_foreign_compile: fn(closure: JetCLIClosureCTools, lib: String, directory: String, cache: String) -[FS, Env, Exec, Time.Wait]> String JetCLIForeignLinkError! {
    tools: closure.tools
    flags: [String]{"-std=c11", "-O2", "-fPIC", "-fno-stack-protector", "-fno-asynchronous-unwind-tables", "-fno-unwind-tables", "-D_GNU_SOURCE"}
    paths := [String]{}
    loop item in cli_files.walk_files(directory, None) {
        entry: item ?? return Err(jet_cli_foreign_link_error("couldn't read C source directory `{directory}`: {err}"))
        if entry.path.ends_with(".c") || entry.path.ends_with(".h") -> paths.push(entry.path)
    }
    paths = jet_cli_sorted_set(paths)
    sources := [String]{}
    identity := [U8]{}
    jet_cli_native_c_identity(identity, "jet-native-c-v4", tools, flags) ?? return Err(err)
    loop path in paths {
        content: cli_files.read_bytes(path) ?? return Err(jet_cli_foreign_link_error("couldn't read C input `{path}`: {err}"))
        relative: path.removeprefix("{directory}/")
        jet_cli_foreign_hash_field(identity, relative, content)
        if path.ends_with(".c") -> sources.push(path)
    }
    if sources.len() == 0 -> return Err(jet_cli_foreign_link_error("C dependency `{lib}` has neither a static archive nor C sources in `{directory}`"))
    // Hash what the compiler will consume, including every system/header
    // input. Compile these immutable preprocessed bytes on a cache miss. The
    // units preprocess and compile as parallel C compiler children
    // (jet_cli_native_c_run_all); their outputs are read in unit order.
    commands := [[String]]{}
    loop source in sources {
        argv := jet_cli_native_c_argv(tools)
        loop flag in flags -> argv.push(flag)
        loop flag in ([String]{"-ffile-prefix-map={directory}=/jet/c", "-I", directory, "-E", "-P", source}) -> argv.push(flag)
        commands.push(argv)
    }
    preprocessed := [String]{}
    loop (index, outcome) in jet_cli_native_c_run_all(commands) {
        receipt: outcome.receipt ?? return Err(jet_cli_foreign_link_error("couldn't preprocess C dependency `{lib}`: {outcome.failure}"))
        if !receipt.success -> return Err(jet_cli_foreign_link_error("C compiler rejected `{sources[index]}`: {receipt.errors}"))
        jet_cli_foreign_hash_field(identity, "preprocessed", receipt.output.bytes())
        preprocessed.push(receipt.output)
    }
    key: sha256_hex_bytes(sha256_bytes(identity[0..<identity.len()]))
    store: "{cache}/{key}"
    archive: "{store}/lib{lib}.a"
    if jet_cli_native_c_cached(archive) -> return Ok(archive)
    cli_files.create_dir_all(store) ?? return Err(jet_cli_foreign_link_error("couldn't create C object cache `{store}`: {err}"))
    temporary: "{store}/build-{cli_sys.pid()}"
    // The store outlives a crashed build; its leftovers (an archive `ar`
    // would add to) never reach this one.
    cli_files.remove_all(temporary).drop("an absent previous build directory is expected")
    cli_files.create_dir_all(temporary) ?? return Err(jet_cli_foreign_link_error("couldn't create C build directory: {err}"))
    objects := [String]{}
    compiles := [[String]]{}
    // A unit whose staging fails stops the build after the units before it
    // compiled, as when each unit was staged and compiled in turn.
    staging_failure := String?{None}
    loop (index, source) in preprocessed {
        staged_source: "{temporary}/{index}.i"
        cli_files.write(staged_source, source) ?? {
            staging_failure = Val("couldn't stage preprocessed C source: {err}")
            break
        }
        object: "{temporary}/{index}.o"
        argv := jet_cli_native_c_argv(tools)
        loop flag in flags -> argv.push(flag)
        loop flag in ([String]{jet_cli_native_c_build_map(temporary), "-c", staged_source, "-o", object}) -> argv.push(flag)
        compiles.push(argv)
        objects.push(object)
    }
    loop (index, outcome) in jet_cli_native_c_run_all(compiles) {
        receipt: outcome.receipt ?? return Err(jet_cli_foreign_link_error("couldn't compile C dependency `{lib}`: {outcome.failure}"))
        if !receipt.success -> return Err(jet_cli_foreign_link_error("C compiler rejected `{sources[index]}`: {receipt.errors}"))
    }
    if staging_failure == .Val(failure) -> return Err(jet_cli_foreign_link_error(failure))
    jet_cli_native_c_publish(tools, lib, temporary, objects, archive) ?? return Err(err)
    Ok(archive)
}

// `inline_c_type`: the C spelling of a checked inline scalar.
jet_cli_inline_c_type: fn(ty: Type) -> String Never! {
    if ty == {
        .Int -> "int64_t"
        .Float -> "double"
        .Float32 -> "float"
        .Bool -> "_Bool"
        .IntN(signed, bits) -> if signed -> "int{bits}_t" else -> "uint{bits}_t"
        .InlineRange(base, _, _) -> jet_cli_inline_c_type(base)
        else -> "void"
    }
}

// `emit_native_inline_source`: the body, its prototype and the
// `jet_inline_<wrapper>` symbol the checked foreign row calls.
jet_cli_inline_c_source: fn(row: JetDriverInlineC, body: String) -> String Never! {
    ret: if row.return_type == .Val(ty) -> jet_cli_inline_c_type(ty) else -> "void"
    types := [String]{}
    typed := [String]{}
    args := [String]{}
    loop (position, param) in row.params {
        base: jet_cli_inline_c_type(param.ty)
        c_type: if param.write -> "{base}*" else -> base
        types.push(c_type.copy())
        typed.push("{c_type} p{position}")
        args.push("p{position}")
    }
    call: if ret == "void" -> "{row.name}({args.join(", ")});" else -> "return {row.name}({args.join(", ")});"
    declared: if types.len() == 0 -> "void" else -> types.join(", ")
    defined: if typed.len() == 0 -> "void" else -> typed.join(", ")
    "/* Jet #FFI provenance: entry {row.index}, language c. */\n#include <stdint.h>\n#include <stdbool.h>\n{ret} {row.name}({declared});\n{body}\n{ret} {row.symbol}({defined}) {{ {call} }}\n"
}

// `emit_inline_build_rs` for the native link: every selected inline C body
// (`#FFI(c)`, checked wrapper identity `jet_inline_jet_ffi_<name>`) is one
// translation unit; after all compile, ONE strict proof link joins them with
// undefined symbols refused (a static musl executable on the pack route, a
// shared object with the host C compiler), so bodies may share C state but
// nothing may stay unresolved; then one archive joins the native link. None
// when the program has no inline C body.
jet_cli_native_inline_c: fn(closure: JetCLIClosureCTools, facts: JetDriverForeignLinkFacts, cache: String) -[FS, Env, Exec, Time.Wait]> String? JetCLIForeignLinkError! {
    units := [String]{}
    loop row in facts.inline_c {
        if row.cpp -> return Err(jet_cli_foreign_link_error("inline C++ `{row.name}` needs a C++ runtime, which the native static link does not package"))
        body: row.body ?? return Err(jet_cli_foreign_link_error("inline C `{row.name}` has no triple-quoted body within its checked source span"))
        units.push(jet_cli_inline_c_source(row, body))
    }
    if units.len() == 0 -> return Ok(None)
    tools: closure.tools
    // The Rust original compiles each unit with the compiler's own dialect and
    // `-fPIC`; the native static link adds the c@path code-generation
    // constraints.
    flags: [String]{"-fPIC", "-fno-stack-protector", "-fno-asynchronous-unwind-tables", "-fno-unwind-tables"}
    identity := [U8]{}
    jet_cli_native_c_identity(identity, "jet-native-inline-c-v3", tools, flags) ?? return Err(err)
    store_root: "{cache}/inline"
    cli_files.create_dir_all(store_root) ?? return Err(jet_cli_foreign_link_error("couldn't create inline C cache `{store_root}`: {err}"))
    probe: "{store_root}/probe-{cli_sys.pid()}"
    // The store outlives a crashed probe; its leftovers never reach this one.
    cli_files.remove_all(probe).drop("an absent previous probe directory is expected")
    cli_files.create_dir_all(probe) ?? return Err(jet_cli_foreign_link_error("couldn't create inline C build directory: {err}"))
    // Hash what the compiler will consume, including every system header.
    // The units preprocess and compile as parallel C compiler children
    // (jet_cli_native_c_run_all); their outputs are read in unit order. A
    // unit whose staging fails stops after the units before it ran, as when
    // each unit was staged and preprocessed in turn.
    commands := [[String]]{}
    staging_failure := String?{None}
    loop (index, unit) in units {
        source: "{probe}/inline_{index}.c"
        cli_files.write(source, unit) ?? {
            staging_failure = Val("couldn't stage inline C source: {err}")
            break
        }
        argv := jet_cli_native_c_argv(tools)
        loop flag in flags -> argv.push(flag)
        loop flag in ([String]{jet_cli_native_c_build_map(probe), "-E", "-P", source}) -> argv.push(flag)
        commands.push(argv)
    }
    loop (index, outcome) in jet_cli_native_c_run_all(commands) {
        receipt: outcome.receipt ?? return Err(jet_cli_foreign_link_error("couldn't preprocess inline C: {outcome.failure}"))
        if !receipt.success -> return Err(jet_cli_foreign_link_error("C compiler rejected inline C unit {index}: {receipt.errors}"))
        jet_cli_foreign_hash_field(identity, "inline_{index}.c", units[index].bytes())
        jet_cli_foreign_hash_field(identity, "preprocessed", receipt.output.bytes())
    }
    if staging_failure == .Val(failure) -> return Err(jet_cli_foreign_link_error(failure))
    key: sha256_hex_bytes(sha256_bytes(identity[0..<identity.len()]))
    store: "{store_root}/{key}"
    archive: "{store}/libjet_inline_native.a"
    if jet_cli_native_c_cached(archive) {
        cli_files.remove_all(probe) ?? return Err(jet_cli_foreign_link_error("couldn't remove inline C probe: {err}"))
        return Ok(Val(archive))
    }
    cli_files.create_dir_all(store) ?? return Err(jet_cli_foreign_link_error("couldn't create inline C cache `{store}`: {err}"))
    temporary: "{store}/build-{cli_sys.pid()}"
    // The store outlives a crashed build; its leftovers (an archive `ar`
    // would add to) never reach this one.
    cli_files.remove_all(temporary).drop("an absent previous build directory is expected")
    cli_files.rename(probe, temporary) ?? return Err(jet_cli_foreign_link_error("couldn't stage inline C build directory: {err}"))
    objects := [String]{}
    compiles := [[String]]{}
    loop index in 0..<units.len() {
        source: "{temporary}/inline_{index}.c"
        object: "{temporary}/inline_{index}.o"
        argv := jet_cli_native_c_argv(tools)
        loop flag in flags -> argv.push(flag)
        loop flag in ([String]{jet_cli_native_c_build_map(temporary), "-c", source, "-o", object}) -> argv.push(flag)
        compiles.push(argv)
        objects.push(object)
    }
    loop (index, outcome) in jet_cli_native_c_run_all(compiles) {
        receipt: outcome.receipt ?? return Err(jet_cli_foreign_link_error("couldn't compile inline C: {outcome.failure}"))
        if !receipt.success -> return Err(jet_cli_foreign_link_error("C compiler rejected inline C unit {index}: {receipt.errors}"))
    }
    proof := jet_cli_native_c_argv(tools)
    loop word in tools.link_flags -> proof.push(word.copy())
    loop word in closure.proof -> proof.push(word.copy())
    loop object in objects -> proof.push(object)
    loop word in ([String]{"-o", "{temporary}/inline_bridge.proof"}) -> proof.push(word)
    linked: cli_process.cmd(proof).run() ?? return Err(jet_cli_foreign_link_error("couldn't link the inline C proof: {err}"))
    if !linked.success -> return Err(jet_cli_foreign_link_error("inline C bodies leave undefined symbols: {linked.errors}"))
    jet_cli_native_c_publish(tools, "jet_inline_native", temporary, objects, archive) ?? return Err(err)
    Ok(Val(archive))
}

jet_cli_foreign_static_archive: fn(closure: JetCLIClosureCTools, lib: String, directories: [String], cache: String, source_provider: Bool) -[FS, Env, Exec, Time.Wait]> String JetCLIForeignLinkError! {
    name: lib.removeprefix("static=").removeprefix("dylib=")
    loop directory in directories {
        path: "{directory}/lib{name}.a"
        if cli_files.is_file(path) -> return Ok(path)
    }
    // A declared local source directory is a source provider, not a request
    // to silently link a similarly named installed library.
    if source_provider && directories.len() > 0 -> return jet_cli_foreign_compile(closure, name, directories[0], cache)
    tools: closure.tools
    probe := jet_cli_native_c_argv(tools)
    probe.push("-print-file-name=lib{name}.a")
    receipt: cli_process.cmd(probe).run() ?? return Err(jet_cli_foreign_link_error("couldn't find C archive `{name}`: {err}"))
    path: receipt.output.trim()
    if !receipt.success || path == ("lib{name}.a") || !cli_files.is_file(path) -> return Err(jet_cli_foreign_link_error("C static archive `{name}` was not found"))
    Ok(path)
}

JetCLIForeignSources: struct {
    root: String
    declarations: [JetDriverCDependency]
    // The `libs` and `link_args` build options (BuildOptions.jet).
    libs: [String]
    link_args: [String]
}

// Capture only C declarations before a factory transfers its request into
// the compiler. Keeping the complete source snapshot would copy source text.
jet_cli_native_c_sources: fn(snapshot: JetDriverAuthorizedSourceSnapshot, options: BuildOptions) -> JetCLIForeignSources JetCLIForeignLinkError! {
    root := ""
    loop candidate in snapshot.roots {
        if candidate.identity == snapshot.entry_root_identity -> root = candidate.canonical_path
    }
    if root == "" -> return Err(jet_cli_foreign_link_error("C link resolution has no authorized entry source root"))
    Ok(JetCLIForeignSources{root: root, declarations: jet_driver_c_dependencies(snapshot), libs: build_options_list(options, "libs"), link_args: build_options_list(options, "link_args")})
}

// A `link_args` path or `-L` directory, under the source root unless absolute.
jet_cli_foreign_option_path: fn(root: String, written: String) -> String Never! {
    if written.starts_with("/") -> return written.copy()
    "{root}/{written}"
}

// The checked foreign link facts `facts` realized as link inputs with the
// closure's C tools `closure`: the C provider archives (with the libraries
// the `libs` and `link_args` build options add), the `link_args` archives,
// the realized Rust helper archive `rust_helper` (its exact StaticLibrary)
// and the inline C archive, in that order. Core's `c.<lib>` imports link the
// vendored C archives of the runtime in `runtime_dir`.
jet_cli_native_c_closure: fn(closure: JetCLIClosureCTools, facts: JetDriverForeignLinkFacts, rust_helper: String?, sources: JetCLIForeignSources, runtime_dir: String) -[FS, Env, Exec, Time.Wait]> JetCLIForeignInputs JetCLIForeignLinkError! {
    inputs := JetCLIForeignInputs{names: [String]{}, bytes: [[U8]]{}, paths: [String]{}}
    root: sources.root
    // Every archive key hashes the tools, flags, source and preprocessed
    // bytes, never a project path, so one store beside the FFI cache serves
    // every project and every compiler stage; a fresh project starts warm.
    cache: "{jet_cli_rust_foreign_cache()}/clinks"
    declarations: sources.declarations
    libraries := facts.direct_links.copy()
    if libraries.len() == 0 {
        loop lib in facts.libraries -> libraries.push(lib.copy())
    }
    loop lib in facts.transitive_links -> libraries.push(lib.copy())
    // The `libs` and `link_args` build options: more libraries, each found
    // in the `-L` directories first, and archives linked as they are.
    requested := sources.libs.copy()
    link_dirs := [String]{}
    archives := [String]{}
    loop word in sources.link_args {
        if {
            word.starts_with("-L") -> link_dirs.push(jet_cli_foreign_option_path(root, word.removeprefix("-L")))
            word.starts_with("-l") -> requested.push(word.removeprefix("-l"))
            else -> archives.push(jet_cli_foreign_option_path(root, word))
        }
    }
    loop lib in requested -> libraries.push(lib)
    libraries = jet_cli_sorted_set(libraries)
    loop lib in libraries {
        // These names select the program's one implicit musl platform below.
        if ([String]{"c", "m", "pthread", "dl", "rt", "util"}).contains(lib) -> next
        directories := [String]{}
        declared_system := false
        loop declaration in declarations {
            if declaration.library != lib -> next
            target: declaration.target
            if jet_cli_vendored_c_library(lib) && (target == "system" || target.starts_with("nixpkgs:")) -> next
            if target == "system" {
                declared_system = true
                next
            }
            directory := ""
            if target.starts_with("nixpkgs:") {
                directory = jet_cli_foreign_nix_directory(lib, target.removeprefix("nixpkgs:"), declaration.root) ?? return Err(err)
            } else {
                directory = cli_files.canonicalize(cli_files.join(declaration.root, target)) ?? return Err(jet_cli_foreign_link_error("couldn't resolve C dependency `{lib}` at `{target}`: {err}"))
            }
            if !directories.contains(directory) -> directories.push(directory)
        }
        if directories.len() > 1 -> return Err(jet_cli_foreign_link_error("C dependency `{lib}` has conflicting declarations"))
        if jet_cli_vendored_c_library(lib) && directories.len() == 0 {
            path: jet_cli_vendored_c_archive(lib, runtime_dir) ?? return Err(err)
            jet_cli_foreign_add(inputs, path) ?? return Err(err)
            next
        }
        if directories.len() > 0 {
            path: jet_cli_foreign_static_archive(closure, lib, directories, cache, true) ?? return Err(err)
            jet_cli_foreign_add(inputs, path) ?? return Err(err)
            next
        }
        // A `-L` directory of the `link_args` build option is searched first.
        found := ""
        loop directory in link_dirs {
            if found == "" && cli_files.is_file("{directory}/lib{lib}.a") -> found = "{directory}/lib{lib}.a"
        }
        if found != "" {
            jet_cli_foreign_add(inputs, found) ?? return Err(err)
            next
        }
        // Undeclared imports require pkg-config; an explicit c@system falls
        // back to the same nixpkgs provisioning as the seed resolver, and a
        // library the build options name to the C compiler's search path.
        output := ""
        configured := false
        if cli_process.cmd([String]{"pkg-config", "--static", "--libs", lib}).run() == .Ok(receipt) {
            if receipt.success {
                output = receipt.output
                configured = true
            }
        }
        if !configured && requested.contains(lib) && !declared_system {
            path: jet_cli_foreign_static_archive(closure, lib, [String]{}, cache, false) ?? return Err(err)
            jet_cli_foreign_add(inputs, path) ?? return Err(err)
            next
        }
        if !configured {
            if !declared_system -> return Err(jet_cli_foreign_link_error("C dependency `{lib}` was not declared and pkg-config did not find it"))
            directory: jet_cli_foreign_nix_directory(lib, lib, root) ?? return Err(err)
            path: jet_cli_foreign_static_archive(closure, lib, [String]{directory}, cache, false) ?? return Err(err)
            jet_cli_foreign_add(inputs, path) ?? return Err(err)
            next
        }
        words: output.replace("\n", " ").replace("\t", " ").split(" ").to_list()
        names := [String]{}
        loop word in words {
            if word.starts_with("-L") -> directories.push(word.removeprefix("-L"))
            if word.starts_with("-l") -> names.push(word.removeprefix("-l"))
        }
        if names.len() == 0 -> names.push(lib)
        loop name in names {
            if ([String]{"c", "m", "pthread", "dl", "rt", "util"}).contains(name) -> next
            path: jet_cli_foreign_static_archive(closure, name, directories, cache, false) ?? return Err(err)
            jet_cli_foreign_add(inputs, path) ?? return Err(err)
        }
    }
    loop archive in archives {
        if !cli_files.is_file(archive) -> return Err(jet_cli_foreign_link_error("the `link_args` archive `{archive}` doesn't exist"))
        jet_cli_foreign_add(inputs, archive) ?? return Err(err)
    }
    if rust_helper == .Val(path) -> jet_cli_foreign_add(inputs, path) ?? return Err(err)
    // Inline C bridge: every selected `#FFI(c)` body, one archive.
    if jet_cli_native_inline_c(closure, facts, cache) == {
        .Val(archive) -> { jet_cli_foreign_add(inputs, archive) ?? return Err(err) }
        .None -> {}
        .Err(error) -> { return Err(error) }
    }
    Ok(inputs)
}

// C's implicit platform is a program dependency, not a Jet runtime dependency.
// A user C closure or prepared Rust helper archive (static musl code with C
// ABI exports) links the closure tools' platform archives (musl libc, the
// compiler builtins and, for a Rust helper, the unwinder) once, with the
// Jet-only runtime object, not the runtime pack: the pack carries the startup
// of a program with no libc (`__jet_start`), and the linker starts this one
// through musl's `__libc_start_main`, which initializes the libc it links.
// Programs without a foreign closure preserve the original link line exactly
// and never resolve C tools.
jet_cli_native_c_inputs: fn(facts: JetDriverForeignLinkFacts, rust_helper: String?, sources: JetCLIForeignSources, runtime_dir: String) -[FS, Env, Exec, Time.Wait]> JetCLIForeignInputs JetCLIForeignLinkError! {
    linked: jet_cli_native_c_linked(facts)
    if !linked && facts.inline_c.len() == 0 && rust_helper == None && sources.libs.len() == 0 && sources.link_args.len() == 0 {
        return Ok(JetCLIForeignInputs{names: [String]{}, bytes: [[U8]]{}, paths: [String]{}})
    }
    closure: jet_cli_closure_c_tools(rust_helper) ?? return Err(err)
    inputs := jet_cli_native_c_closure(closure, facts, rust_helper, sources, runtime_dir) ?? return Err(err)
    if !linked && inputs.names.len() == 0 -> return Ok(inputs)
    loop path in closure.platform -> jet_cli_foreign_add(inputs, path) ?? return Err(err)
    inputs.platform = true
    Ok(inputs)
}

// Whether the checked foreign facts `facts` link C: a C provider library, a
// link of one, or a C or Rust foreign row (the program's C platform).
jet_cli_native_c_linked: fn(facts: JetDriverForeignLinkFacts) -> Bool Never! {
    facts.libraries.len() > 0 || facts.direct_links.len() > 0 || facts.transitive_links.len() > 0 || facts.c_or_rust_rows
}

// The same declared nixpkgs provisioning as the seed C resolver. A native
// link still selects static archive bytes, never a dynamic loader fallback.
jet_cli_foreign_nix_directory: fn(lib: String, attr: String, root: String) -[FS, Env, Exec, Time.Wait]> String JetCLIForeignLinkError! {
    cache: "{root}/.jet/clinks/{lib}"
    stored: (cli_files.read(cache) ?? "").trim()
    if stored.len() > 0 && cli_files.is_dir(stored) -> return Ok("{stored}/lib")
    receipt: cli_process.cmd([String]{"nix", "build", "--no-link", "--print-out-paths", "nixpkgs#{attr}"}).run() ?? return Err(jet_cli_foreign_link_error("couldn't provision C dependency `{lib}`: {err}"))
    if !receipt.success -> return Err(jet_cli_foreign_link_error("couldn't provision C dependency `{lib}`: {receipt.errors}"))
    lines: receipt.output.trim().split("\n").to_list()
    if lines.len() != 1 || !cli_files.is_dir(lines[0]) -> return Err(jet_cli_foreign_link_error("C dependency `{lib}` provisioning returned no single store directory"))
    cli_files.create_dir_all("{root}/.jet/clinks") ?? return Err(jet_cli_foreign_link_error("couldn't create C dependency cache: {err}"))
    cli_files.write(cache, lines[0]) ?? return Err(jet_cli_foreign_link_error("couldn't write C dependency cache: {err}"))
    Ok("{lines[0]}/lib")
}
