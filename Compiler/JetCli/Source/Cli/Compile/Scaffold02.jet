// Rust: Source/CmdCompile.rs:13767
pub fn write_plugin_artifacts(file: String, plugin: &PluginArtifacts, verbose: Bool, out_dir: &OSPath, mode: OutputMode) -> PluginBuildPaths PluginBuildError! {
    step :: |msg: String| -> { if verbose -> write_mode_status(mode, "[build] {msg}\n") }
    fs.create_dir_all(out_dir) ?? return Err(.ToolFailure("couldn't create the {out_dir.display()} folder: {err}"))
    name :: stem(file)
    wit_dir :: out_dir.join("{name}_wit")
    fs.create_dir_all(&wit_dir) ?? return Err(.ToolFailure("couldn't create {wit_dir.display()}: {err}"))
    wit_path :: wit_dir.join("world.wit")
    guest_rust_path :: out_dir.join("{name}_plugin.rs")
    core_wasm_path :: out_dir.join("{name}_core.wasm")
    embedded_wasm_path :: out_dir.join("{name}_embedded.wasm")
    component_wasm_path :: out_dir.join("{name}.wasm")
    fs.write(&wit_path, &plugin.wit) ?? return Err(.ToolFailure("couldn't write {wit_path.display()}: {err}"))
    fs.write(&guest_rust_path, &plugin.guest_rust) ?? return Err(.ToolFailure("couldn't write {guest_rust_path.display()}: {err}"))
    step("wit emit    -> {wit_path.display()}")
    step("guest rust  -> {guest_rust_path.display()}")
    step("rustc wasm  {guest_rust_path.display()} -> {core_wasm_path.display()}")
    rustc :: Command.new("rustc").args(["--edition", "2021", "--target", "wasm32-unknown-unknown", "--crate-type", "cdylib", "-O", "--crate-name"])
        .arg(jet.Syntax.sanitize_crate_name(guest_rust_path.file_stem().and_then(|name| -> name.to_str()).unwrap_or("out")))
        .args([guest_rust_path.to_str().unwrap(), "-o", core_wasm_path.to_str().unwrap()])
        .output() ?? return Err(.ToolFailure("couldn't run `rustc --target wasm32-unknown-unknown` ({err}) — is the wasm32-unknown-unknown target installed?"))
    if !rustc.status.success() -> return Err(.GeneratedCodeRejected("rustc rejected the generated plugin guest module\n{String.from_utf8_lossy(&rustc.stderr)}"))
    step("wit embed   {core_wasm_path.display()} -> {embedded_wasm_path.display()}")
    embed :: Command.new("wasm-tools").args(["component", "embed", wit_dir.to_str().unwrap(), "--world", plugin.world_name, core_wasm_path.to_str().unwrap(), "-o", embedded_wasm_path.to_str().unwrap()])
        .output() ?? return Err(.ToolFailure("couldn't run `wasm-tools` ({err}) — install it (ships in the project's `nix develop` shell) or add it to PATH"))
    if !embed.status.success() -> return Err(.ToolFailure("`wasm-tools component embed` failed\n{String.from_utf8_lossy(&embed.stderr)}"))
    step("wit lift    {embedded_wasm_path.display()} -> {component_wasm_path.display()}")
    new :: Command.new("wasm-tools").args(["component", "new", embedded_wasm_path.to_str().unwrap(), "-o", component_wasm_path.to_str().unwrap()])
        .output() ?? return Err(.ToolFailure("couldn't run `wasm-tools` ({err})"))
    if !new.status.success() -> return Err(.ToolFailure("`wasm-tools component new` failed\n{String.from_utf8_lossy(&new.stderr)}"))
    Ok(PluginBuildPaths{wit: wit_path, guest_rust: guest_rust_path, core_wasm: core_wasm_path, component_wasm: component_wasm_path})
}

