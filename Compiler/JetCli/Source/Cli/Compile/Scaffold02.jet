fn write_library_staged(path: &OSPath, bytes: &[U8]) -> Unit LibraryBuildError! {
    file := fs.OpenOptions.new().write(true).create_new(true).open(path) ?? return Err(LibraryBuildError.from(err))
    file.write_all(bytes) ?? return Err(LibraryBuildError.from(err))
    file.sync_all() ?? return Err(LibraryBuildError.from(err))
    Ok(())
}
// Rust: Source/CmdCompile.rs:14127
fn publish_library_file(staged: &OSPath, final_path: &OSPath) -> Unit LibraryBuildError! {
    if fs.symlink_metadata(final_path) == .Ok(metadata) {
        if library_reparse_point(&metadata) -> return Err(.Io("refusing to replace symlink or reparse point `{final_path.display()}`"))
        if metadata.is_dir() -> return Err(.Io("refusing to replace directory `{final_path.display()}`"))
        if selected_os() == "windows" -> fs.remove_file(final_path) ?? return Err(LibraryBuildError.from(err))
    }
    fs.rename(staged, final_path) ?? return Err(LibraryBuildError.from(err))
    Ok(())
}
// Rust: Source/CmdCompile.rs:14148
fn library_stem(name: String) -> String {
    result := String.new()
    loop ch in name.chars() -> &result.push(if ch.is_ascii_alphanumeric() || ch == '_' || ch == '-' -> ch else '_')
    if result.is_empty() -> &result.push_str("library")
    if result.bytes().first().is_some_and(|byte| -> byte.is_ascii_digit()) -> &result.insert(0, '_')
    result
}
// Rust: Source/CmdCompile.rs:14168
fn library_rustc(source: &OSPath, crate_type: String, output: &OSPath, profile: BuildProfile, verbose: Bool, linker: &Selection, ffi: FfiLink?, mode: OutputMode) -> Unit LibraryBuildError! {
    command := Command.new("rustc")
    command.arg("--edition").arg("2021").arg("--crate-type").arg(crate_type).arg("--crate-name")
        .arg(jet.Syntax.sanitize_crate_name(source.file_stem().and_then(|name| -> name.to_str()).unwrap_or("out")))
        .arg(source).arg("-o").arg(output)
    config :: profile.config()
    command.args(release_profile_cfg_args(&profile))
    command.args(config.rustc_args_for_target(ffi.is_some(), true))
    command.args(linker.rustc_args())
    if ffi == .Val(link) {
        command.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
        loop deps_dir in link.dependency_dirs() {
            if deps_dir.is_dir() -> command.arg("-L").arg("dependency={deps_dir.display()}")
        }
    }
    if verbose -> write_mode_status(mode, "[build] rustc {source.display()} -> {output.display()} (linker {linker.label()})\n")
    result :: command.output() ?? return Err(.Tool("couldn't start rustc: {err}"))
    if !result.status.success() -> return Err(.GeneratedCode(String.from_utf8_lossy(&result.stderr)))
    Ok(())
}
// Rust: Source/CmdCompile.rs:14237
// Canonicalize process metadata in a Unix archive, preserving names and payloads.
fn normalize_static_archive(path: &OSPath) -> Unit LibraryBuildError! {
    // Rust: Source/CmdCompile.rs:14238
    GLOBAL_HEADER :: "!<arch>\n".bytes()
    // Rust: Source/CmdCompile.rs:14239
    MEMBER_HEADER :: 60
    archive := fs.read(path) ?? return Err(LibraryBuildError.from(err))
    if !archive.starts_with(GLOBAL_HEADER) -> return Err(.GeneratedCode("rustc produced an invalid static archive `{path.display()}`"))
    offset := GLOBAL_HEADER.len()
    loop offset < archive.len() {
        end :: offset.checked_add(MEMBER_HEADER).unwrap_or_else(|| -> return Err(.GeneratedCode("static archive `{path.display()}` has an overflowing member header")))
        if end > archive.len() || archive[offset + 58..<end] != "`\n".bytes() -> return Err(.GeneratedCode("rustc produced a malformed static archive `{path.display()}`"))
        loop (start, width) in [(16, 12), (28, 6), (34, 6)] {
            &archive[offset + start..<offset + start + width].fill(U8{32})
            archive[offset + start] = U8{48}
        }
        &archive[offset + 40..<offset + 48].fill(U8{32})
        &archive[offset + 40..<offset + 46].copy_from_slice("100644".bytes())
        size_text :: String.from_utf8(&archive[offset + 48..<offset + 58]).ok()
        size :: size_text.and_then(|field| -> {
            trimmed := field.trim() // #4303
            trimmed.parse::<USize>().ok()
        }).unwrap_or_else(|| -> return Err(.GeneratedCode("static archive `{path.display()}` has an invalid member size")))
        data_end :: end.checked_add(size).unwrap_or_else(|| -> return Err(.GeneratedCode("static archive `{path.display()}` has an overflowing member payload")))
        if data_end > archive.len() -> return Err(.GeneratedCode("static archive `{path.display()}` has a truncated member payload"))
        offset = data_end + (size & 1)
    }
    fs.write(path, archive) ?? return Err(LibraryBuildError.from(err))
    Ok(())
}
// Rust: Source/CmdCompile.rs:14296
fn build_library(project_root: &OSPath, rust_code: String, artifacts: &LibraryArtifacts, config: &LibraryConfig, profile: BuildProfile, ffi: FfiLink?, verbose: Bool, mode: OutputMode) -> LibraryBuildPaths LibraryBuildError! {
    stem :: library_stem(config.name)
    target :: build_output_root(project_root)
    validate_library_output_root(&target)?
    clean_library_outputs(&target, stem)?
    stage :: new_library_stage(&target, stem)?
    needs_shared :: config.native || config.loadable
    // GATE #4483 selected target OS, never the host OS.
    shared_ext :: if selected_os() == "macos" -> "dylib" else if selected_os() == "windows" -> "dll" else "so"
    shared_name :: "lib{stem}.{shared_ext}"
    shared :: if needs_shared -> Val(target.join(shared_name)) else None
    staged_shared :: if needs_shared -> Val(stage.path.join(shared_name)) else None
    staticlib :: if config.native -> Val(target.join("lib{stem}.a")) else None
    staged_staticlib :: if config.native -> Val(stage.path.join("lib{stem}.a")) else None
    header :: if config.native -> Val(target.join("{stem}.h")) else None
    staged_header :: if config.native -> Val(stage.path.join("{stem}.h")) else None
    bindings_dir :: if config.native -> Val(target.join("bindings")) else None
    staged_bindings_dir :: if config.native -> Val(stage.path.join("bindings")) else None
    linker :: NativeLinker.for_target(None)
    if needs_shared {
        source :: stage.path.join("{stem}.rs")
        write_library_staged(&source, rust_code.bytes())?
        library_rustc(&source, "cdylib", &staged_shared.expect("shared path for native Library"), profile, verbose, &linker, ffi, mode)?
        if staged_staticlib == .Val(path) {
            library_rustc(&source, "staticlib", &path, profile, verbose, &linker, ffi, mode)?
            normalize_static_archive(&path)?
        }
    }
    if staged_header == .Val(path) -> write_library_staged(&path, artifacts.header.bytes())?
    binding_paths := [OSPath]{}
    staged_binding_paths := [OSPath]{}
    if staged_bindings_dir == .Val(dir) {
        fs.create_dir(&dir) ?? return Err(LibraryBuildError.from(err))
        loop (language, text) in artifacts.bindings {
            extension :: match language {
                "c" -> "h"
                "cpp" -> "hpp"
                "rust" -> "rs"
                "zig" -> "zig"
                "go" -> "go"
                "python" -> "py"
                "javascript" -> "mjs"
                "swift" -> "swift"
                _ -> next
            }
            path :: target.join("bindings").join("{stem}.{extension}")
            staged_path :: dir.join("{stem}.{extension}")
            write_library_staged(&staged_path, text.bytes())?
            &binding_paths.push(path)
            &staged_binding_paths.push(staged_path)
        }
    }
    loadable :: if config.loadable -> Val(target.join("{stem}.jetlib")) else None
    staged_loadable :: if config.loadable {
        path :: stage.path.join("{stem}.jetlib")
        payload :: fs.read(&staged_shared.expect("loadable Library has shared payload")) ?? return Err(LibraryBuildError.from(err))
        exports := [JetLibExport]{}
        loop export in artifacts.exports {
            scalar :: match export.scalar {
                .Int -> JetLibScalar.Int
                .Float -> JetLibScalar.Float
                .Bool -> JetLibScalar.Bool
                .Text -> JetLibScalar.Text
            }
            conventions := [JetLibAccess]{}
            loop convention in export.conventions -> &conventions.push(match convention {
                .Read -> JetLibAccess.Read
                .Write -> JetLibAccess.Write
                .Move -> JetLibAccess.Move
            })
            &exports.push(JetLibExport.with_conventions(export.name, scalar, conventions))
        }
        stamp := JetLibStamp.for_library_with_identity(config.name, exports, config.declared_effects, env!("JET_COMPILER_BUILD_ID"), env!("JET_BUILD_TARGET"), native_toolchain_identity())
        stamp.entry = config.entry
        stamp.seal_payload(&payload)
        artifact :: JetLibArtifact{stamp: stamp, payload: payload}
        write_library_staged(&path, &artifact.encode())?
        Val(path)
    } else None
    validate_library_output_root(&target)?
    if bindings_dir == .Val(dir) {
        validate_library_bindings_root(&target)?
        match fs.symlink_metadata(&dir) {
            .Ok(metadata) -> {
                if library_reparse_point(&metadata) || !metadata.is_dir() -> return Err(.Io("Library bindings root `{dir.display()}` is not a real directory"))
            }
            .Err(error) -> {
                if error.kind() != .NotFound -> return Err(LibraryBuildError.from(error))
                fs.create_dir(&dir) ?? return Err(LibraryBuildError.from(err))
            }
        }
    }
    publications := [(OSPath, OSPath)]{}
    if shared == .Val(final_path) && staged_shared == .Val(staged_path) -> &publications.push((staged_path, final_path))
    if staticlib == .Val(final_path) && staged_staticlib == .Val(staged_path) -> &publications.push((staged_path, final_path))
    if header == .Val(final_path) && staged_header == .Val(staged_path) -> &publications.push((staged_path, final_path))
    loop (staged_path, final_path) in staged_binding_paths.iter().zip(binding_paths.iter()) -> &publications.push((staged_path, final_path))
    if loadable == .Val(final_path) && staged_loadable == .Val(staged_path) -> &publications.push((staged_path, final_path))
    completion :: target.join(".{stem}.jet-library.complete")
    staged_completion :: stage.path.join(".{stem}.jet-library.complete")
    completion_text := String.from("jet-library-set-v1\n")
    loop (staged_path, final_path) in publications {
        relative :: final_path.strip_prefix(&target) ?? return Err(.Io("Library publication path `{final_path.display()}` escaped target root"))
        bytes :: fs.read(&staged_path) ?? return Err(LibraryBuildError.from(err))
        digest :: jet.SHA256.sha256_hex(&bytes)
        &completion_text.push_str("{relative.display()}\tsha256-{digest}\n")
    }
    write_library_staged(&staged_completion, completion_text.bytes())?
    &publications.push((staged_completion, completion))
    validate_library_output_root(&target)?
    validate_library_bindings_root(&target)?
    loop (staged_path, final_path) in publications {
        publish_library_file(&staged_path, &final_path) ?? {
            _ :: clean_library_outputs(&target, stem)
            return Err(err)
        }
    }
    validate_library_output_root(&target) ?? {
        _ :: clean_library_outputs(&target, stem)
        return Err(err)
    }
    Ok(LibraryBuildPaths{shared: shared, staticlib: staticlib, header: header, loadable: loadable, bindings: binding_paths})
}

// Rust: Source/CmdCompile.rs:14514
fn build_inner(file: String, rust_code: String, runtime_bundle: ProgramBundle?, bin: OSPath, profile: BuildProfile, ffi: FfiLink?, clinks: &[String], verbose: Bool, cross_target: String?, web: WebArtifacts?, plugin: PluginArtifacts?, mode: OutputMode, _restored_cache: Bool, cache_key_input: String?, target_machine: TargetMachine?, dev_aot: Bool) -> {
    step :: |msg: String| -> { if verbose -> write_mode_status(mode, "[build] {msg}\n") }
    native_store :: Store.from_env().ok()
    output_names :: bin.file_name().and_then(|name| -> name.to_str()).map(|name| -> [name.to_string()]).unwrap_or_default()
    compiler_nodes :: runtime_bundle.map(|bundle| -> jet.Driver.compiler_nodes_for_bundle_with_outputs(bundle, None, &output_names)).unwrap_or_default()
    record_program :: build_record_program(file)
    packages :: runtime_bundle.map(CheckReceipt.PackageRow.from_bundle).unwrap_or_default()
    project_root :: jet.build_project_root(file) ?? {
        source :: fs.read_to_string(file).unwrap_or_default()
        report_problems(mode, file, source, &err)
        exit(ExitCodes.USER_ERROR)
    }
    previous_record :: native_store.and_then(|store| -> store.last_build_record(&project_root, record_program).ok().flatten())
    output_root :: bin.parent().filter(|parent| -> !parent.as_os_str().is_empty()).unwrap_or(OSPath.from("."))
    output_authority :: jet_devserver.WebHost.WebOutputAuthority.open_or_create(&output_root, &project_root) ?? {
        write_mode_diagnostic(mode, "error: couldn't create the `.jet/build` folder safely: {err}\n")
        exit(ExitCodes.USER_ERROR)
    }
    cache_key := cache_key_input
    if dev_aot {
        if runtime_bundle == .Val(bundle) && ffi.is_none() && clinks.is_empty() && cross_target.is_none() && target_machine.is_none() && web.is_none() && plugin.is_none() {
            if cache_key == .Val(key) && native_store == .Val(store) && DevAot.restore(&store, key, &bin) {
                step("cache hit -> reused cached image")
                persist_build_record(native_store, &project_root, record_program, &compiler_nodes, &packages, previous_record, true, 0.0, 0.0)
                return
            }
            started :: Instant.now()
            step("cranelift  -> {bin.display()}")
            match DevAot.build(&bundle, profile.budget_name(), &bin, native_store) {
                .Ok(image) -> {
                    if cache_key == .Val(key) && native_store == .Val(store) {
                        store.publish_bytes(key, &image, false) ?? {
                            cli_error!("E2105", "couldn't store build cache artifact: {err}")
                            exit(ExitCodes.USER_ERROR)
                        }
                        step("cache store -> saved image for next time")
                    }
                    persist_build_record(native_store, &project_root, record_program, &compiler_nodes, &packages, previous_record, false, started.elapsed().as_secs_f64() * 1000.0, 0.0)
                    return
                }
                .Err(reason) -> { if !mode.json -> write_mode_status(mode, "[build] note: building with rustc because {reason}\n") }
            }
        }
        cache_key = cache_key.map(|key| -> rustc_fallback_cache_key(key))
    }
    rust_deferred :: dev_aot && rust_code.is_empty() && runtime_bundle.is_some()
    rs_name :: "{stem(file)}.rs"
    rs_path :: output_authority.path_for(rs_name) ?? {
        write_mode_diagnostic(mode, "error: invalid web Rust output `{rs_name}`: {err}\n")
        exit(ExitCodes.USER_ERROR)
    }
    step("emit Rust  -> {rs_path.display()}")
    output_authority.replace_file(rs_name, rust_code.bytes()) ?? { write_mode_diagnostic(mode, "error: couldn't write {rs_path.display()}: {err}\n") }
    if cross_target == Val(jet.Syntax.BUILD_TARGET_WEB) {
        web_output :: web.unwrap_or_else(|| -> {
            write_mode_diagnostic(mode, jet.Diagnostics.render_ice_report("missing web codegen output", "", false))
            exit(ExitCodes.ICE)
        })
        paths :: write_web_artifacts(file, &web_output, ffi, verbose, &output_authority, None, !profile.is_release(), mode) ?? {
            write_mode_diagnostic(mode, "{err}\n")
            exit(ExitCodes.ICE)
        }
        if !mode.json {
            note := "note: `--target=web` wrote `{paths.manifest.display()}`, `{paths.dom.display()}`, `{paths.js.display()}`, `{paths.wasm.display()}`, `{paths.html.display()}`"
            if paths.js_map == .Val(js_map) -> &note.push_str(", `{js_map.display()}`")
            if paths.wasm_map == .Val(wasm_map) -> &note.push_str(", `{wasm_map.display()}`")
            write_mode_status(mode, "{note}\n")
        }
        return
    }
    if cross_target == Val(jet.Syntax.TARGET_SANDBOX) {
        plugin_output :: plugin.unwrap_or_else(|| -> {
            write_mode_diagnostic(mode, jet.Diagnostics.render_ice_report("missing sandbox codegen output", "", false))
            exit(ExitCodes.ICE)
        })
        paths :: write_plugin_artifacts(file, &plugin_output, verbose, &output_root, mode) ?? {
            match err {
                .GeneratedCodeRejected(msg) -> {
                    write_mode_diagnostic(mode, jet.Diagnostics.render_ice_report("rustc rejected generated code", msg, true))
                    exit(ExitCodes.ICE)
                }
                .ToolFailure(msg) -> {
                    diag :: jet.Manifest.e1259(msg)
                    report_problems(mode, "<sandbox>", "// sandbox build for {file}", &[diag])
                    exit(ExitCodes.USER_ERROR)
                }
            }
        }
        write_mode_status(mode, "note: `--target=sandbox` wrote `{paths.wit.display()}`, `{paths.guest_rust.display()}`, `{paths.core_wasm.display()}`, `{paths.component_wasm.display()}`\n")
        return
    }
    if target_machine == .Val(machine) && machine.no_os && (machine.triple.contains("aarch64") || machine.triple.contains("thumb") || machine.triple.starts_with("arm")) {
        usage :: runtime_bundle.map(|bundle| -> TargetMachineUse.from_core_apis(bundle.used_core.iter())).unwrap_or_default()
        dossier :: machine.target_dossier(&usage, ExecutionTier.Aot, env!("CARGO_PKG_VERSION"), "none")
        identity := "jet-firmware-build-v1{TEXT_NUL}".bytes().to_vec()
        append_cache_field(&identity, rust_code)
        append_cache_field(&identity, profile.cache_tag())
        append_cache_field(&identity, native_toolchain_identity())
        &identity.extend_from_slice(&dossier.cache_bytes(machine.triple))
        target_digest :: jet.SHA256.sha256_hex(&identity)
        target_dir :: OSPath.from(".jet").join("target").join("{jet.Syntax.sanitize_crate_name(machine.name)}-{target_digest}")
        program_object :: target_dir.join("{jet.Syntax.sanitize_crate_name(stem(file))}.program.a")
        fs.create_dir_all(&target_dir) ?? {
            write_mode_diagnostic(mode, "error: couldn't create firmware work directory {target_dir.display()}: {err}\n")
            exit(ExitCodes.USER_ERROR)
        }
        rustc_started :: Instant.now()
        step("rustc object -> {program_object.display()}")
        rustc := Command.new("rustc")
        rustc.arg("--edition").arg("2021").arg("--crate-type").arg("staticlib").arg("--emit").arg("link")
            .arg("--target").arg(machine.triple).arg("--crate-name").arg(jet.Syntax.sanitize_crate_name(stem(file)))
            .args(release_profile_cfg_args(&profile)).arg("-C").arg("panic=abort").arg("-C").arg("relocation-model=static")
            .arg(&rs_path).arg("-o").arg(&program_object)
        rustc_output :: rustc.output() ?? {
            write_mode_diagnostic(mode, "error: couldn't run rustc for firmware object: {err}\n")
            exit(ExitCodes.USER_ERROR)
        }
        if !rustc_output.status.success() {
            detail :: String.from_utf8_lossy(&rustc_output.stderr)
            write_mode_diagnostic(mode, jet.Diagnostics.render_ice_report("the generated Rust did not compile for the selected target.", detail, true))
            exit(ExitCodes.ICE)
        }
        artifacts :: jet.Driver.build_target_machine_firmware(&machine, &usage, &program_object, &target_dir) ?? {
            match err {
                .Diagnostics(diags) -> report_problems(mode, file, rust_code, &diags)
                .Machine(errors) -> write_mode_diagnostic(mode, "error: target machine firmware link failed: {errors:?}\n")
            }
            exit(ExitCodes.USER_ERROR)
        }
        fs.copy(&artifacts.elf, &bin) ?? {
            write_mode_diagnostic(mode, "error: couldn't publish firmware {bin.display()}: {err}\n")
            exit(ExitCodes.USER_ERROR)
        }
        persist_build_record(native_store, &project_root, record_program, &compiler_nodes, &packages, previous_record, false, rustc_started.elapsed().as_secs_f64() * 1000.0, 0.0)
        step("firmware link -> {artifacts.elf.display()}")
        return
    }
    if cache_key == .Val(key) && native_store.is_some_and(|store| -> match store.restore_file(key, &bin) {
        .Ok(.Hit { .. }) -> true
        _ -> false
    }) {
        step("cache hit -> reused cached binary")
        persist_build_record(native_store, &project_root, record_program, &compiler_nodes, &packages, previous_record, true, 0.0, 0.0)
        return
    }
    if verbose {
        if cache_key.is_some() -> step("cache miss -> compiling")
        else if cross_target.is_some() -> step("cache bypassed (cross-compiled build)")
        else -> step("cache bypassed (C-linked build)")
    }
    generated_rust := rust_code
    if runtime_bundle == .Val(bundle) && rust_deferred {
        generated_rust = jet.Driver.emit_native_rust_for_checked_bundle(&bundle, profile.budget_name(), ffi)
        inject_game_crash_reporter_bootstrap(&generated_rust, program_uses_game_runtime(&bundle))
        output_authority.replace_file(rs_name, generated_rust.bytes()) ?? { write_mode_diagnostic(mode, "error: couldn't write {rs_path.display()}: {err}\n") }
    }
    step("rustc      {rs_path.display()} -> {bin.display()}")
    rustc_flags := [String]{}
    no_os_wasm :: target_machine.is_some_and(|machine| -> machine.no_os && machine.triple.starts_with("wasm32"))
    if no_os_wasm -> &rustc_flags.extend(["--crate-type", "cdylib", "-C", "link-arg=--no-entry", "-C", "link-arg=--export=__jet_program_entry"])
    ffi_present :: ffi.is_some()
    config :: profile.config()
    &rustc_flags.extend(release_profile_cfg_args(&profile))
    &rustc_flags.extend(config.rustc_args_for_target(ffi_present, cross_target.is_none()))
    linker :: NativeLinker.for_target(cross_target)
    &rustc_flags.extend(linker.rustc_args())
    if verbose -> step("linker     -> {linker.label()}")
    cache_flags :: rustc_flags.iter().map(std.ffi.OsString.from).collect()
    cache_env :: [(std.ffi.OsString, std.ffi.OsString)]{}
    prepared_runtime :: if ffi_present {
        if verbose -> step("runtime store bypassed (Rust FFI glue)")
        PreparedRuntime.inline(generated_rust)
    } else if native_store == .Val(store) {
        match prepare(&store, std.ffi.OsStr.new("rustc"), generated_rust, &cache_flags, &cache_env) {
            .Ok(prepared) -> {
                if verbose {
                    status :: if prepared.prebuilt() -> "prebuilt" else if prepared.cache_hit() -> "cache hit" else if prepared.is_split() -> "cache store" else "bypassed (inline fallback)"
                    step("runtime   -> {status}")
                }
                prepared
            }
            .Err(.Cache(error)) -> {
                if verbose -> step("runtime store bypassed ({error})")
                PreparedRuntime.inline(generated_rust)
            }
            .Err(.Tool(_)) -> {
                cli_error!(@full "E2105", "couldn't find `rustc` on this machine", "v1 of this language uses Rust as its backend (Docs/spec/architecture.md)", "install Rust from https://rustup.rs, then try again")
                exit(ExitCodes.USER_ERROR)
            }
        }
    } else {
        if verbose -> step("runtime store bypassed (store unavailable)")
        PreparedRuntime.inline(generated_rust)
    }
    // Compile privately, cache that exact binary, then publish the convenience path.
    bin_name :: bin.file_name().and_then(|name| -> name.to_str()).filter(|name| -> !name.is_empty()).unwrap_or_else(|| -> {
        cli_error!("E2105", "build output `{bin.display()}` has no UTF-8 file name")
        exit(ExitCodes.USER_ERROR)
    })
    work :: output_root.join(".work.{bin_name}.{id()}")
    fs.create_dir_all(&work) ?? {
        cli_error!("E2105", "couldn't create the build work dir: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    tmp_bin :: work.join(bin_name)
    tmp_rs :: work.join("{stem(file)}.rs")
    entry_parent :: OSPath.from(file).parent().filter(|parent| -> !parent.as_os_str().is_empty()).unwrap_or(OSPath.from("."))
    runtime_project_root :: runtime_bundle.map(|bundle| -> bundle.project_root).or_else(|| -> jet.Loader.find_package_root_checked(&entry_parent).ok().flatten()).unwrap_or(entry_parent)
    project_root_prefix :: fs.canonicalize(&runtime_project_root).ok()
    crate_name :: jet.Syntax.sanitize_crate_name(stem(file))
    metadata_key :: cache_key.unwrap_or_else(|| -> {
        bytes := "jet.rustc-metadata.v1{TEXT_NUL}".bytes().to_vec()
        append_cache_field(&bytes, crate_name)
        append_cache_field(&bytes, generated_rust)
        loop flag in rustc_flags -> append_cache_field(&bytes, flag)
        if ffi == .Val(link) -> append_cache_field(&bytes, link.cache_identity)
        append_link_identity(&bytes, clinks, project_root_prefix)
        jet.SHA256.sha256_hex(&bytes)
    })
    run_rustc :: |prepared: &PreparedRuntime| -> {
        rust := prepared.rust()
        if cfg!(debug_assertions) && std.env.var_os("JET_ICE_RUSTC_REJECTION_SELF_TEST").is_some() {
            rust = "{rust}\ncompile_error!(\"JET_RUSTC_REJECTION_SENTINEL\");\ncompile_error!(\"JET_RUSTC_REJECTION_SECOND_SENTINEL\");\n"
        }
        fs.write(&tmp_rs, rust) ?? {
            cli_error!("E2105", "couldn't write {tmp_rs.display()}: {err}")
            exit(ExitCodes.USER_ERROR)
        }
        cmd := Command.new("rustc")
        cmd.arg("--edition").arg("2021").args(&rustc_flags)
        cmd.arg("--crate-name").arg(crate_name).arg("-C").arg("metadata={metadata_key}")
        if project_root_prefix == .Val(prefix) -> cmd.arg("--remap-path-prefix").arg("{prefix.display()}=/jet/project")
        cmd.arg("--remap-path-prefix").arg("{work.display()}=/jet/build")
        if fs.canonicalize(&work) == .Ok(prefix) -> cmd.arg("--remap-path-prefix").arg("{prefix.display()}=/jet/build")
        cmd.arg(&tmp_rs).arg("-o").arg(&tmp_bin)
        prepared.add_rustc_args(&cmd)
        if ffi == .Val(link) {
            cmd.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
            loop deps_dir in link.dependency_dirs() {
                if deps_dir.is_dir() -> cmd.arg("-L").arg("dependency={deps_dir.display()}")
            }
        }
        loop arg in clinks -> cmd.arg(arg)
        cmd.output() ?? {
            cli_error!(@full "E2105", "couldn't find `rustc` on this machine", "v1 of this language uses Rust as its backend (Docs/spec/architecture.md)", "install Rust from https://rustup.rs, then try again")
            exit(ExitCodes.USER_ERROR)
        }
    }
    rustc_started :: Instant.now()
    out := run_rustc(&prepared_runtime)
    if !out.status.success() && prepared_runtime.is_split() {
        if verbose -> step("runtime cache bypassed (split crate rejected — inline retry)")
        out = run_rustc(&PreparedRuntime.inline(generated_rust))
    }
    if !out.status.success() {
        _ :: fs.remove_dir_all(&work)
        stderr :: String.from_utf8_lossy(&out.stderr)
        if missing_c_lib(stderr) == .Val(missing) {
            diag :: jet.CFFI.e3209(missing)
            report_problems(mode, file, "", &[diag])
            exit(ExitCodes.USER_ERROR)
        }
        if missing_linker(stderr) == .Val(missing) {
            write_mode_diagnostic(mode, "Error [L2101]: rustc could not find linker `{missing}`.\n Why: Jet uses rustc as its backend, and rustc needs a C linker to produce a native binary.\n Fix: Run from `nix develop`, or install a C toolchain (`gcc`/`clang`; on Debian/Ubuntu: `build-essential`, on Arch: `base-devel`).\nMore: jet-lang.dev/e/L2101\n")
            exit(ExitCodes.USER_ERROR)
        }
        log_name :: rustc_log_name(file)
        rustc_log_path :: output_authority.path().join(log_name)
        log_detail :: match output_authority.replace_file(log_name, &out.stderr) {
            .Ok(_) -> "  rustc log: {rustc_log_path.display()}"
            .Err(error) -> "  rustc log: {rustc_log_path.display()} (could not write: {error})"
        }
        rustc_error :: first_rustc_error_block(stderr).map(|block| -> "  rustc error:\n{block}").unwrap_or_else(|| -> {
            trimmed := stderr.trim() // #4303
            if trimmed.is_empty() -> "" else "  rustc stderr:\n{trimmed}"
        })
        if verbose && first_rustc_error_block(stderr) == .Val(block) -> write_mode_status(mode, "[build] rustc error:\n{block}\n")
        detail :: if rustc_error.is_empty() -> "  generated: {rs_path.display()}\n{log_detail}" else "  generated: {rs_path.display()}\n{log_detail}\n{rustc_error}"
        write_mode_diagnostic(mode, jet.Diagnostics.render_ice_report("the generated Rust did not compile.", detail, true))
        exit(ExitCodes.ICE)
    }
    step("link       -> {bin.display()}")
    if cache_key == .Val(key) && native_store == .Val(store) {
        store.publish_file(key, &tmp_bin) ?? {
            _ :: fs.remove_dir_all(&work)
            cli_error!("E2105", "couldn't store build cache artifact: {err}")
            exit(ExitCodes.USER_ERROR)
        }
        step("cache store -> saved binary for next time")
    }
    if fs.rename(&tmp_bin, &bin).is_err() {
        fs.copy(&tmp_bin, &bin) ?? {
            _ :: fs.remove_file(&tmp_bin)
            cli_error!("E2105", "couldn't finish writing {bin.display()}: {err}")
            exit(ExitCodes.USER_ERROR)
        }
        _ :: fs.remove_file(&tmp_bin)
    }
    persist_build_record(native_store, &runtime_project_root, record_program, &compiler_nodes, &packages, previous_record, false, rustc_started.elapsed().as_secs_f64() * 1000.0, 0.0)
    _ :: fs.remove_dir_all(&work)
}
