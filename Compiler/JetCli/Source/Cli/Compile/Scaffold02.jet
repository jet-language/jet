fn clean_library_outputs(target: &OSPath, stem: String) -> Unit LibraryBuildError! {
    // Validate both parents before stale-output cleanup can leave the target.
    validate_library_output_root(target)?
    validate_library_bindings_root(target)?
    loop path in library_owned_paths(target, stem) -> remove_library_owned_path(&path)?
    stage_prefix :: ".jet-library-stage-{stem}-{id()}-"
    entries :: fs.read_dir(target) ?? return Err(LibraryBuildError.from(err))
    loop item in entries {
        entry :: item ?? return Err(LibraryBuildError.from(err))
        if !entry.file_name().to_string_lossy().starts_with(stage_prefix) -> next
        metadata :: fs.symlink_metadata(entry.path()) ?? return Err(LibraryBuildError.from(err))
        if library_reparse_point(&metadata) || !metadata.is_dir() -> return Err(.Io("refusing to remove invalid Library staging path `{entry.path().display()}`"))
        fs.remove_dir_all(entry.path()) ?? return Err(LibraryBuildError.from(err))
    }
    Ok(())
}
// Rust: Source/CmdCompile.rs:14100
fn new_library_stage(target: &OSPath, stem: String) -> LibraryStage LibraryBuildError! {
    loop serial in U32{0}..<U32{64} {
        path :: target.join(".jet-library-stage-{stem}-{id()}-{serial}")
        match fs.create_dir(&path) {
            .Ok(_) -> return Ok(LibraryStage{path: path})
            .Err(error) -> {
                if error.kind() == .AlreadyExists -> next
                return Err(LibraryBuildError.from(error))
            }
        }
    }
    Err(.Io("could not allocate a unique Library staging directory"))
}
