//RS /// Scan a failed rustc/linker stderr for a missing C library and return its
//RS /// link name. Matches the GNU ld / lld phrasing `cannot find -l<name>` (and the
//RS /// `-l<name>` form some linkers print). Used to keep a missing *system library*
//RS /// off the I2 ICE path — it's a user/system problem, not generated-code being
//RS /// rejected.
//RS fn missing_c_lib(stderr: &str) -> Option<String> {
//RS     for line in stderr.lines() {
//RS         // e.g. "cannot find -lraylib" / "cannot find -lraylib: No such file"
