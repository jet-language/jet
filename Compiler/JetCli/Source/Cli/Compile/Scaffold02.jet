// Rust: Source/CmdCompile.rs:15362
fn build_record_program(file: String) -> String {
    input :: OSPath.from(file)
    absolute_input :: if input.is_absolute() -> input else std.env.current_dir().unwrap_or(OSPath.from(".")).join(&input)
    absolute :: fs.canonicalize(&absolute_input).unwrap_or(absolute_input)
    path :: jet.build_project_root(file).ok().and_then(|root| -> absolute.strip_prefix(&root).ok()).unwrap_or(input)
    path.display().to_string().replace('\\', "/")
}
// Rust: Source/CmdCompile.rs:15381
fn persist_build_record(store: Store?, workspace_root: &OSPath, program: String, nodes: &[BuildPlanNode], packages: &[PackageRow], previous: BuildRecord?, cache_hit: Bool, compile_duration_ms: F64, link_duration_ms: F64) -> {
    if nodes.is_empty() -> return
    records := [BuildNodeRecord]{}
    loop node in nodes {
        why_ran :: if cache_hit && node.kind != BuildNodeKind.Check -> "cached" else if previous.is_none() -> "first-run" else if node.inputs.first() == .Val(input) -> "input:{input}" else "first-run"
        duration_ms :: match node.kind {
            .Check -> 0.0
            .Compile -> compile_duration_ms
            .Link -> link_duration_ms
        }
        &records.push(BuildNodeRecord{kind: node.kind.as_str().to_string(), key: node.key, subject: node.subject, duration_ms: duration_ms, why_ran: why_ran, inputs: node.inputs})
    }
    &records.extend(CheckReceipt.package_nodes(packages, previous, false))
    if store == .Val(actual) {
        record :: BuildRecord.new(program, records)
        record_key :: jet.SHA256.sha256_hex(record.to_json().bytes())
        _ :: actual.publish_last_build_record(workspace_root, record_key, &record)
    }
}
// Rust: Source/CmdCompile.rs:15438
pub fn run_debug_native(file: String, raw_frames: Bool, dap: Bool, mode: OutputMode) -> I32 {
    src :: fs.read_to_string(file) ?? {
        cli_error!("E2105", "can't find the file `{file}`")
        return ExitCodes.USER_ERROR
    }
    project_root :: jet.build_project_root(file) ?? {
        report_problems(mode, file, src, &err)
        return ExitCodes.USER_ERROR
    }
    out :: jet.compile_for_debug(file) ?? {
        report_problems(mode, file, src, &err)
        return ExitCodes.USER_ERROR
    }
    clinks :: jet.resolve_c_links(file) ?? {
        report_problems(mode, file, src, &err)
        return ExitCodes.USER_ERROR
    }
    bin :: build_output_root(&project_root).join("{stem(file)}_dbg")
    build(file, out.rust, None, bin, BuildProfile.Debug, out.ffi, &clinks, false, None, None, None, mode, false, None)
    rust_file :: "{stem(file)}.rs"
    if dap -> jet.Debug.run_dap(&bin, rust_file, out.rust, file, src)
    else -> jet.Debug.run_native(&bin, rust_file, out.rust, file, src, raw_frames)
}
// Rust: Source/CmdCompile.rs:15501
fn missing_c_lib(stderr: String) -> String? {
    loop line in stderr.lines() {
        if line.split("cannot find -l").nth(1) == .Val(rest) {
            name :: rest.chars().take_while(|ch| -> !ch.is_whitespace() && ch != ':' && ch != '\'' && ch != '"').collect::<String>()
            if !name.is_empty() -> return Val(name)
        }
    }
    None
}
// Rust: Source/CmdCompile.rs:15519
fn missing_linker(stderr: String) -> String? {
    loop line in stderr.lines() {
        if line.split("linker `").nth(1) == .Val(rest) && rest.split_once('`') == .Val((name, tail)) {
            if !name.is_empty() && tail.contains("not found") -> return Val(name.to_string())
        }
    }
    None
}
// Rust: Source/CmdCompile.rs:15531
fn rustc_log_name(file: String) -> String { "{stem(file)}.rustc.log" }
// Rust: Source/CmdCompile.rs:15535
fn is_rustc_error_header(line: String) -> Bool {
    trimmed := line.trim_start() // #4303
    trimmed.starts_with("error:") || trimmed.starts_with("error[")
}
// Rust: Source/CmdCompile.rs:15539
fn is_rustc_diagnostic_header(line: String) -> Bool {
    trimmed := line.trim_start() // #4303
    is_rustc_error_header(trimmed) || trimmed.starts_with("warning:")
}
// Rust: Source/CmdCompile.rs:15544
fn first_rustc_error_block(stderr: String) -> String? {
    block_start := Int?{None}
    block_end := stderr.len()
    offset := 0
    loop line in stderr.split_inclusive('\n') {
        without_lf :: line.strip_suffix('\n').unwrap_or(line)
        content :: without_lf.strip_suffix('\r').unwrap_or(without_lf)
        if block_start.is_some() && is_rustc_diagnostic_header(content) {
            block_end = offset
            break
        }
        if block_start.is_none() && is_rustc_error_header(content) -> block_start = Val(offset)
        offset += line.len()
    }
    if block_start == .Val(start) && stderr.get(start..<block_end) == .Val(view) {
        block := view.trim_end() // #4303
        if !block.is_empty() -> return Val(block)
    }
    None
}
// Rust: Source/CmdCompile.rs:15565 cfg(test) belongs to the next packet's test module.

