// Rust: Source/CmdCompile.rs:13949
fn library_reparse_point(metadata: &fs.Metadata) -> Bool {
    if metadata.file_type().is_symlink() -> return true
    if selected_os() == "windows" {
        // Rust: Source/CmdCompile.rs:13956
        FILE_ATTRIBUTE_REPARSE_POINT :: U32{0x0400}
        // GATE #4494 Windows MetadataExt.file_attributes.
        return metadata.file_attributes() & FILE_ATTRIBUTE_REPARSE_POINT != 0
    }
    false
}
// Rust: Source/CmdCompile.rs:13965
fn validate_library_output_root(root: &OSPath) -> Unit LibraryBuildError! {
    match fs.symlink_metadata(root) {
        .Ok(metadata) -> {
            if library_reparse_point(&metadata) || !metadata.is_dir() -> return Err(.Io("Library output root `{root.display()}` is not a real directory"))
        }
        .Err(error) -> {
            if error.kind() != .NotFound -> return Err(LibraryBuildError.from(error))
            fs.create_dir(root) ?? return Err(LibraryBuildError.from(err))
        }
    }
    first :: fs.canonicalize(root) ?? return Err(LibraryBuildError.from(err))
    second :: fs.canonicalize(root) ?? return Err(LibraryBuildError.from(err))
    if first != second -> return Err(.Io("Library output root `{root.display()}` changed while it was being resolved"))
    metadata :: fs.symlink_metadata(root) ?? return Err(LibraryBuildError.from(err))
    if library_reparse_point(&metadata) || !metadata.is_dir() -> return Err(.Io("Library output root `{root.display()}` changed to a symlink or reparse point"))
    Ok(())
}
// Rust: Source/CmdCompile.rs:13998
fn library_owned_paths(target: &OSPath, stem: String) -> [OSPath] {
    paths := [OSPath]{}
    loop name in ["lib{stem}.a", "lib{stem}.so", "lib{stem}.dylib", "lib{stem}.dll", "{stem}.h", "{stem}.jetlib", "{stem}.rs", ".{stem}.jet-library.complete"] -> &paths.push(target.join(name))
    loop extension in ["h", "hpp", "rs", "zig", "go", "py", "mjs", "swift"] -> &paths.push(target.join("bindings").join("{stem}.{extension}"))
    paths
}
// Rust: Source/CmdCompile.rs:14019
fn remove_library_owned_path(path: &OSPath) -> Unit LibraryBuildError! {
    metadata :: fs.symlink_metadata(path) ?? {
        if err.kind() == .NotFound -> return Ok(())
        return Err(LibraryBuildError.from(err))
    }
    if library_reparse_point(&metadata) -> return Err(.Io("refusing to remove symlink or reparse point `{path.display()}`"))
    if metadata.is_dir() -> return Err(.Io("refusing to remove directory where a Library file belongs: `{path.display()}`"))
    fs.remove_file(path) ?? return Err(LibraryBuildError.from(err))
    Ok(())
}
// Rust: Source/CmdCompile.rs:14041
fn validate_library_bindings_root(target: &OSPath) -> Unit LibraryBuildError! {
    root :: target.join("bindings")
    metadata :: fs.symlink_metadata(&root) ?? {
        if err.kind() == .NotFound -> return Ok(())
        return Err(LibraryBuildError.from(err))
    }
    if library_reparse_point(&metadata) || !metadata.is_dir() -> return Err(.Io("Library bindings root `{root.display()}` is not a real directory"))
    first :: fs.canonicalize(&root) ?? return Err(LibraryBuildError.from(err))
    second :: fs.canonicalize(&root) ?? return Err(LibraryBuildError.from(err))
    if first != second -> return Err(.Io("Library bindings root `{root.display()}` changed while it was being resolved"))
    after :: fs.symlink_metadata(&root) ?? return Err(LibraryBuildError.from(err))
    if library_reparse_point(&after) || !after.is_dir() -> return Err(.Io("Library bindings root `{root.display()}` changed to a symlink or reparse point"))
    Ok(())
}
