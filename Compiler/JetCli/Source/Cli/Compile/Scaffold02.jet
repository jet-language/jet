//RS         return Err(LibraryBuildError::GeneratedCode(format!(
//RS             "rustc produced an invalid static archive `{}`",
//RS             path.display()
//RS         )));
//RS     }
//RS     let mut offset = GLOBAL_HEADER.len();
//RS     while offset < archive.len() {
//RS         let end = offset.checked_add(MEMBER_HEADER).ok_or_else(|| {
//RS             LibraryBuildError::GeneratedCode(format!(
//RS                 "static archive `{}` has an overflowing member header",
//RS                 path.display()
//RS             ))
//RS         })?;
//RS         if end > archive.len() || &archive[offset + 58..end] != b"`\n" {
//RS             return Err(LibraryBuildError::GeneratedCode(format!(
//RS                 "rustc produced a malformed static archive `{}`",
//RS                 path.display()
//RS             )));
//RS         }
//RS         // GNU archive fields: mtime [16..28], uid [28..34], gid [34..40],
//RS         // mode [40..48].  Keep the member name and size untouched.
//RS         for (start, width, value) in [(16, 12, b"0"), (28, 6, b"0"), (34, 6, b"0")] {
//RS             archive[offset + start..offset + start + width].fill(b' ');
//RS             archive[offset + start] = value[0];
//RS         }
//RS         archive[offset + 40..offset + 48].fill(b' ');
//RS         archive[offset + 40..offset + 46].copy_from_slice(b"100644");
//RS         let size = std::str::from_utf8(&archive[offset + 48..offset + 58])
