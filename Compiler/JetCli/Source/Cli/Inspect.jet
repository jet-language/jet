// The `jet inspect` group (the arms its dispatch words reach,
// `run_build_query`/`run_compiler_api`, and crates/jet-cli
// `parse_inspect_args`): the eight planes (`jet inspect <plane> [TARGET]
// [--live PID | --replay ARTIFACT]`) and the `graph`, `query`, `explain-build`,
// `compiler`, `impact`, and `provenance` actions. The other inspect actions
// belong to InspectB.jet. A plane, scope, or action whose Jet port has not
// landed is refused with E2104, never guessed.
use {
    jet_foundation.[JET_BUILD_DEFAULT_PROFILE]
    cli_files: core.files
    cli_sys: core.sys
    cli_time: core.time
    jet_driver.[
        JetDriverAuthorizedSourceSnapshot,
        JetDriverCompileMode,
        JetDriverCompileResult,
        JetDriverBuildQueryScope,
        JetDriverVerbOutput,
        JET_DRIVER_EXIT_OK,
        JET_DRIVER_EXIT_USER_ERROR,
        JET_DRIVER_EXIT_USAGE,
        jet_driver_inline_package,
        jet_driver_mask_inline_package,
        jet_driver_present_diagnostics,
        jet_driver_report_problems,
    ]
    jet_foundation.[
        JET_CLI_COMMANDS,
        JET_CLI_HANDLERS,
        BuildOptions,
        Diagnostic,
        DiagnosticRegistryStatus,
        Func,
        ImplDef,
        Item,
        Program,
        Span,
        Type,
        TypeParam,
        diagnostic_from_registry,
        diagnostic_registry_rows,
        diagnostic_render_all,
        owned_trait,
        owned_trait_arithmetic,
        owned_trait_commutative,
        owned_trait_operator_hook,
        type_name,
        DIAGNOSTIC_ERROR,
    ]
    jet_eval.[jet_eval_compiler_services_source_map]
    jet_lexer.[
        lex,
    ]
    jet_parser.[
        parse_source,
    ]
    jet_semindex.[SemCall, SemRef]
    jetpack_artifact_store.[ArtifactStore]
}

// `InspectPlane::ALL`, in order.
JET_CLI_INSPECT_PLANES: [String]{"types", "rights", "claims", "shapes", "decisions", "structure", "build", "gates"}

// `InspectScope`: `Target` is a source file or a package directory.
JetCLIInspectScope: enum {
    Package
    Target(target: String)
    Live(pid: Int)
    Replay(artifact: String)
}

// `InspectRequest`: the plane, its scope, and the plane flags kept for the
// projection.
JetCLIInspectRequest: struct {
    plane: String
    scope: JetCLIInspectScope
    options: [String]
}

JetCLIInspectParse: enum {
    Parsed(request: JetCLIInspectRequest)
    Failed(message: String)
}

// `parse_inspect_pid`: a positive `u32`.
jet_cli_inspect_pid: fn(value: String) -> Int? Never! {
    bytes: value.bytes()
    start := 0
    if bytes.len() > 0 && bytes[0] == (U8{43}) -> start = 1
    if start >= bytes.len() -> return None
    pid := 0
    loop index in start..<bytes.len() {
        digit: Int.from_u8(bytes[index]) - 48
        if digit < 0 || digit > 9 -> return None
        pid = pid * 10 + digit
        if pid > 4294967295 -> return None
    }
    Val(pid)
}

// `inspect_flag_takes_value`: only a bare flag consumes the next word; a joined
// `--flag=value` leaves the target intact.
jet_cli_inspect_flag_takes_value: fn(argument: String) -> Bool Never! {
    [String]{"--before", "--color", "--facts", "--gate", "--kind", "--output", "--profile", "--scope", "--set", "--target", "--topic", "--threads"}.contains(argument)
}

// `parse_inspect_args` over the normalized argv (`inspect <plane> ...`).
jet_cli_inspect_parse: fn(argv: [String]) -> JetCLIInspectParse Never! {
    if argv.len() < 2 -> return JetCLIInspectParse.Failed{message: "missing inspect plane; choose types, rights, claims, shapes, decisions, structure, build, or gates"}
    plane: argv[1]
    if !JET_CLI_INSPECT_PLANES.contains(plane) -> return JetCLIInspectParse.Failed{message: "unknown inspect plane `{plane}`; choose types, rights, claims, shapes, decisions, structure, build, or gates"}
    target := String?{None}
    live := Int?{None}
    replay := String?{None}
    options := [String]{}
    index := 2
    loop index < argv.len() {
        argument: argv[index]
        if argument == "--live" {
            if index + 1 >= argv.len() -> return JetCLIInspectParse.Failed{message: "`--live` needs a process id"}
            value: argv[index + 1]
            pid: jet_cli_inspect_pid(value) ?? return JetCLIInspectParse.Failed{message: "`--live` expects a positive process id, got `{value}`"}
            if pid == 0 -> return JetCLIInspectParse.Failed{message: "`--live` expects a positive process id"}
            live = Val(pid)
            options.push("--live")
            options.push(value.copy())
            index += 2
            next
        }
        if argument.starts_with("--live=") {
            value: argument.slice(7..<argument.len())
            pid: jet_cli_inspect_pid(value) ?? return JetCLIInspectParse.Failed{message: "`--live` expects a positive process id, got `{value}`"}
            if pid == 0 -> return JetCLIInspectParse.Failed{message: "`--live` expects a positive process id"}
            live = Val(pid)
            options.push(argument.copy())
            index += 1
            next
        }
        if argument == "--replay" {
            if index + 1 >= argv.len() || argv[index + 1].starts_with("-") -> return JetCLIInspectParse.Failed{message: "`--replay` needs a replay artifact path"}
            value: argv[index + 1]
            replay = Val(value)
            options.push("--replay")
            options.push(value.copy())
            index += 2
            next
        }
        if argument.starts_with("--replay=") {
            value: argument.slice(9..<argument.len())
            if value == "" -> return JetCLIInspectParse.Failed{message: "`--replay` needs a replay artifact path"}
            replay = Val(value)
            options.push(argument.copy())
            index += 1
            next
        }
        if argument == "--" -> return JetCLIInspectParse.Failed{message: "inspect planes do not accept a `--` command tail"}
        if argument.starts_with("-") {
            options.push(argument.copy())
            if jet_cli_inspect_flag_takes_value(argument) && index + 1 < argv.len() && !argv[index + 1].starts_with("-") {
                options.push(argv[index + 1])
                index += 2
                next
            }
            index += 1
            next
        }
        if target != None -> return JetCLIInspectParse.Failed{message: "inspect accepts at most one file or package target"}
        target = Val(argument)
        index += 1
    }
    if live != None && replay != None -> return JetCLIInspectParse.Failed{message: "inspect accepts at most one of `--live PID` or `--replay ARTIFACT`"}
    if target != None && (live != None || replay != None) -> return JetCLIInspectParse.Failed{message: "inspect accepts a target, `--live PID`, or `--replay ARTIFACT` as one scope"}
    scope := JetCLIInspectScope.Package
    if target == .Val(path) -> scope = JetCLIInspectScope.Target{target: path}
    if live == .Val(pid) -> scope = JetCLIInspectScope.Live{pid: pid}
    if replay == .Val(artifact) -> scope = JetCLIInspectScope.Replay{artifact: artifact}
    JetCLIInspectParse.Parsed{request: JetCLIInspectRequest{plane: plane, scope: scope, options: options}}
}

// `"inspect"`: parse the plane request, then run its projection.
jet_cli_inspect_plane: fn(argv: [String], color: Bool, json: Bool, threads: Int?) -[FS, Env, Time]> JetCLIPlan Never! {
    if jet_cli_inspect_parse(argv) == {
        .Failed(message) -> return jet_cli_fail("E2104", message, jet_cli_why("E2104"), "run `jet inspect <types|rights|claims|shapes|decisions|structure|build|gates> [TARGET] [--live PID | --replay ARTIFACT]`", color, JET_DRIVER_EXIT_USAGE)
        .Parsed(request) -> return jet_cli_inspect_run(request, color, json, threads)
    }
}

// `run_inspect`: one parsed plane request. Accel routes before the scopes, then
// the live and replay scopes, the build coverage table before the entry, and
// every other plane reads the entry `inspect_entry_path` resolves.
jet_cli_inspect_run: fn(request: JetCLIInspectRequest, color: Bool, json: Bool, threads: Int?) -[FS, Env, Time]> JetCLIPlan Never! {
    plane: request.plane
    if request.scope == .Live(pid) -> return jet_cli_inspect_live(plane, pid, color, json)
    if request.scope == .Replay(artifact) {
        if jet_cli_inspect_entry(request.scope, plane, color) == {
            .Refused(refusal) -> return refusal
            .File(path, notice) -> return JetCLIPlan.Inspect{job: JetCLIInspectJob{action: "replay", file: path, subject: Val(artifact), json: json, color: color, threads: threads, notice: notice, project: true}}
        }
    }
    if plane == "decisions" -> return jet_cli_inspect_decisions(request, color, json, threads)
    if plane == "build" {
        loop option in request.options {
            if option == "--coverage" || option.starts_with("--coverage=") -> return jet_cli_inspect_coverage(json, color)
        }
    }
    file := ""
    notice := ""
    if jet_cli_inspect_entry(request.scope, plane, color) == {
        .Refused(refusal) -> return refusal
        .File(path, written) -> {
            file = path
            notice = written
        }
    }
    // `run_inspect` Rights arm: a bare or directory scope is a project check; a
    // named file keeps explicit-file scope.
    project := true
    if request.scope == .Target(target) -> project = cli_files.is_dir(target)
    if plane == {
        "types" | "shapes" | "rights" -> return JetCLIPlan.Inspect{job: JetCLIInspectJob{action: plane, file: file, subject: None, json: json, color: color, threads: threads, notice: notice, project: project}}
        // `--core` reports the canonical Core catalog after the target
        // resolves, without compiling the entry.
        "structure" -> {
            if request.options.contains("--core") -> return jet_cli_with_notices([String]{notice}, JetCLIPlan.Done{output: jet_cli_structure_core(json)})
            return JetCLIPlan.Inspect{job: JetCLIInspectJob{action: "structure", file: file, subject: None, json: json, color: color, threads: threads, notice: notice, project: project}}
        }
        "claims" -> return jet_cli_with_notices([String]{notice}, jet_cli_inspect_claims_manifest(file, json, color))
        "build" -> {
            if request.options.contains("--times") -> return jet_cli_with_notices([String]{notice}, jet_cli_inspect_build_times(file, json, color))
            return JetCLIPlan.Inspect{job: JetCLIInspectJob{action: "graph", file: file, subject: None, json: json, color: color, threads: threads, notice: notice, project: project}}
        }
        // Gates arm: `run` over the resolved entry followed by the plane flags
        // (filters and invocation writers).
        "gates" -> {
            // copy: `file` stays with `file`, which is read again at line 229, and the new value
            // owns its own.
            gate_args := [String]{file.copy()}
            // copy: `option` stays in the iterated collection (`option` is a view of its element;
            // no move out of an element, E0225) and the pushed row owns its own.
            loop option in request.options -> gate_args.push(option.copy())
            return JetCLIPlan.Gates{file: file, args: gate_args, color: color, json: json, notice: notice}
        }
        else -> panic("inspect plane has no provider: {plane}")
    }
}

// `jet inspect decisions` up to the projection: the profile name (`--release`
// wins over `--profile`, default `debug`, the name a plain `jet build`
// compiles under), which with the build option flags over it (`--inline=off`)
// selects the optimization level, the scope name, and the resolved entry.
jet_cli_inspect_decisions: fn(request: JetCLIInspectRequest, color: Bool, json: Bool, threads: Int?) -[FS, Env]> JetCLIPlan Never! {
    plane: request.plane
    chosen := ""
    release := false
    index := 0
    loop index < request.options.len() {
        option: request.options[index]
        if option == "--release" -> release = true
        if option.starts_with("--profile=") -> chosen = option.slice(10..<option.len())
        if option == "--profile" && index + 1 < request.options.len() {
            chosen = request.options[index + 1]
            index += 1
        }
        index += 1
    }
    if release -> chosen = "release"
    profile: if chosen == "" -> "debug" else -> chosen.copy()
    if profile == {
        "release" | "hardened" | "debug" | "ci" -> {}
        else -> return jet_cli_not_ported("inspect {plane} --profile {profile}", color)
    }
    build := BuildOptions?{None}
    if jet_cli_decisions_options(request.options, chosen) == {
        .Refused(code, what, fix) -> return jet_cli_fail(code, what, jet_cli_why(code), fix, color, JET_DRIVER_EXIT_USAGE)
        .Resolved(options, _) -> build = Val(options)
    }
    scope := "package"
    target := String?{None}
    if request.scope == {
        .Target(path) -> {
            scope = "target"
            target = Val(path)
        }
        .Live(_) -> scope = "live"
        .Replay(_) -> scope = "replay"
        .Package -> {}
    }
    file := ""
    notice := ""
    if jet_cli_inspect_entry(request.scope, plane, color) == {
        .Refused(refusal) -> return refusal
        .File(path, written) -> {
            file = path
            notice = written
        }
    }
    project := true
    if request.scope == .Target(named) -> project = cli_files.is_dir(named)
    JetCLIPlan.Inspect{job: JetCLIInspectJob{action: plane, file: file, subject: target, json: json, color: color, threads: threads, notice: notice, project: project, profile: profile, build: build, scope: scope}}
}

// run_inspect_live: one securely retained, validated snapshot supplies the text
// renderer and all identity/shape/decision JSON projections.
jet_cli_inspect_live: fn(plane: String, pid: Int, color: Bool, json: Bool) -[FS, Env, Time]> JetCLIPlan Never! {
    fix: "start the program with --observe, then run `jet inspect {plane} --live {pid}`"
    snapshot: jet_cli_live_read(pid) ?? return jet_cli_inspect_b_report("E2105", err.message, jet_cli_why("E2105"), fix, color, json, JET_DRIVER_EXIT_USER_ERROR)
    output: if {
        json -> jet_cli_live_json_report(snapshot, plane)
        else -> jet_cli_live_text(snapshot)
    }
    jet_cli_done(output, "", JET_DRIVER_EXIT_OK)
}

// Does the normalized command word belong to the inspect group? `inspect`
// itself (the planes and the actions that keep the group word), or the
// dispatch word an inspect action is normalized to.
jet_cli_inspect_word: fn(command: String) -> Bool Never! {
    if command == "inspect" -> return true
    group: jet_cli_group_index("inspect") ?? return false
    loop action in JET_CLI_COMMANDS[group].actions {
        handler: jet_cli_handler_index(action.handler) ?? next
        spec: JET_CLI_HANDLERS[handler]
        if !spec.keeps_group && spec.dispatch_word == command -> return true
    }
    false
}

// Route one inspect-group command: `argv` is the normalized argv (the
// `--` tail included), `jet_argv` the words before `--`, and `args` their
// positional words; `args[0]` is the command word.
jet_cli_inspect: fn(argv: [String], jet_argv: [String], args: [String], color: Bool, quiet: Bool, json: Bool, threads: Int?) -[FS, Env, Time, Exec, IO, FFI.C, FFI.Asm, Net]> JetCLIPlan Never! {
    command: args[0]
    inspect_env: command == "inspect" && args.len() > 1 && args[1] == "env"
    if command == "inspect" && !inspect_env -> return jet_cli_inspect_plane(argv, color, json, threads)
    if command == {
        "graph" | "query" | "explain-build" -> return jet_cli_inspect_build_query(command, args, color, json, threads)
        "compiler" -> return jet_cli_inspect_compiler(args, color)
        "provenance" -> return jet_cli_inspect_provenance(jet_cli_tail(args, 1), color, json, threads)
        "impact" -> return jet_cli_inspect_impact(argv, color, json, threads)
        else -> {}
    }
    if jet_cli_inspect_b(argv, command, jet_argv, args, color, quiet, json, threads) == .Val(plan) -> return plan
    jet_cli_not_ported(jet_cli_dispatch_form(args), color)
}

// `run_impact` up to the check: `--depth=N` and exactly an entry file and a
// symbol; the host checks the absolute entry and walks its semantic index
// (`jet_cli_inspect_impact_report`).
jet_cli_inspect_impact: fn(argv: [String], color: Bool, json: Bool, threads: Int?) -[FS, Env]> JetCLIPlan Never! {
    input_fix: "correct the named argument or input, then run the command again"
    depth := 3
    positional := [String]{}
    loop argument in jet_cli_tail(argv, 1) {
        if argument.starts_with("--depth=") {
            depth = jet_cli_inspect_count(argument.slice(8..<argument.len())) ?? return jet_cli_fail("E2104", "`--depth` must be a positive integer", jet_cli_why("E2104"), input_fix, color, JET_DRIVER_EXIT_USER_ERROR)
        } else {
            if !argument.starts_with("-") -> positional.push(argument)
        }
    }
    if positional.len() != 2 -> return jet_cli_fail("E2104", "`jet inspect impact` needs an entry file and a symbol name", jet_cli_why("E2104"), "jet inspect impact Examples/ErrorsAndEffects/Effects/Effects.jet report", color, JET_DRIVER_EXIT_USER_ERROR)
    if depth == 0 -> return jet_cli_fail("E2104", "`--depth` must be at least 1", jet_cli_why("E2104"), input_fix, color, JET_DRIVER_EXIT_USER_ERROR)
    // `render_check_failure` of the impact check never colors its report.
    JetCLIPlan.Inspect{job: JetCLIInspectJob{action: "impact", file: jet_cli_inspect_absolute(positional[0]), subject: Val(positional[1]), json: json, color: false, threads: threads, notice: "", project: false, depth: depth}}
}

// One inspect projection the host carries out after compiling `file`
// (`run_types`/`run_shapes`, `run_build_query`): `action` is `types`, `shapes`,
// `graph`, `query`, or `explain-build`, and `subject` the explain-build
// subject.
JetCLIInspectJob: struct {
    action: String
    file: String
    subject: String?
    json: Bool
    verbose: Bool{false}
    color: Bool
    threads: Int?
    // The stderr notices entry resolution wrote, which go out first.
    notice: String
    // A bare or directory scope (a project check, `CheckScope::Project`) rather
    // than an explicitly named file.
    project: Bool
    // The `jet inspect impact` transitive walk limit (`--depth=N`).
    depth: Int{3}
    // `provenance`: the manifest root whose `.jet/lock` the report reads.
    root: String{""}
    // `decisions`: the profile name, the build options it optimizes under
    // (the profile's, with the build option flags over them), and the scope
    // name (`subject` is the named target).
    profile: String{"debug"}
    build: BuildOptions?{None}
    scope: String{""}
    // `explain-effects`: the file holding the site when it is a module the
    // compiled entry loads, and the 1-based line it names (0 for a whole file).
    site: String{""}
    line: Int{0}
}

// The entry an inspect scope names, and the stderr notices project entry
// resolution wrote (a migrated retired entry), which go out first.
JetCLIInspectEntry: enum {
    File(path: String, notice: String)
    Refused(plan: JetCLIPlan)
}

// `write_mode_diagnostic` then exit: one plain stderr line, with its E2104
// report for `--json` (jet_cli_plain_failure).
jet_cli_inspect_plain_error: fn(text: String, what: String, fix: String, exit_code: Int) -> JetCLIPlan Never! {
    JetCLIPlan.Done{output: jet_cli_plain_failure(text, "E2104", what, fix, exit_code)}
}

// `absolutize`: `path` joined onto the working directory.
jet_cli_inspect_absolute: fn(path: String) -[FS, Env]> String Never! {
    // copy: `path` stays with the caller (`path` is a read parameter: no move out of it, E0201) and
    // the new value owns its own.
    if path.starts_with("/") -> return path.copy()
    cwd: cli_files.cwd() ?? "."
    "{cwd}/{path}"
}

// `find_package_root_checked` over `package.jet` manifests: the canonical
// directory at or above `start` that holds one.
jet_cli_inspect_package_root: fn(start: String) -[FS, Env]> String? Never! {
    directory: cli_files.realpath(start) ?? return None
    jet_cli_manifest_root(directory)
}

// Plane and action inspection share one manifest-required root resolver.
jet_cli_inspect_require_root: fn(start: String, hint: String, color: Bool) -[FS, Env]> JetCLIInspectEntry Never! {
    if jet_cli_require_inspect_root(start, hint, color) == {
        .Root(root) -> return JetCLIInspectEntry.File{path: root, notice: ""}
        .Refused(plan) -> return JetCLIInspectEntry.Refused{plan: plan}
    }
}

// `inspect_entry_path`: a file target as typed; a package directory, or the
// working directory's package for every other scope, through its project entry.
jet_cli_inspect_entry: fn(scope: JetCLIInspectScope, plane: String, color: Bool) -[FS, Env]> JetCLIInspectEntry Never! {
    start := cli_files.cwd() ?? "."
    hint := "error: no package.jet found — run inspect inside a project"
    if scope == .Target(target) {
        if !cli_files.is_dir(target) -> return JetCLIInspectEntry.File{path: target, notice: ""}
        start = target
        hint = "error: no package.jet found for this inspect target"
    }
    root := ""
    if jet_cli_inspect_require_root(start, hint, color) == {
        .Refused(plan) -> return JetCLIInspectEntry.Refused{plan: plan}
        .File(path, _) -> root = path
    }
    notices := [String]{}
    found_entry: jet_cli_find_project_entry(root, "inspect {plane}", color, notices)
    if found_entry == {
        .Entry(entry) -> return JetCLIInspectEntry.File{path: entry.path, notice: notices.join("")}
        .Refused(plan) -> return JetCLIInspectEntry.Refused{plan: jet_cli_with_notices(notices, plan)}
        .Absent -> {}
    }
    JetCLIInspectEntry.File{path: jet_cli_entry_join(root, JET_CLI_DEFAULT_ENTRY_FILE), notice: notices.join("")}
}

// crates/jet-foundation `CoverageFact`: one plane's repair coverage over the
// active diagnostic rows.
JetCLICoverageFact: struct {
    plane: String
    rows: Int
    edit_covered: Int
    reason_covered: Int
    behavior_reasons: Int
    design_reasons: Int
    ambiguous_reasons: Int
    uncovered: Int
}

// `CoverageBaselineRow`, keyed by its plane.
JetCLICoverageBaselineRow: struct {
    plane: String
    edit_covered: Int
    reason_covered: Int
    total: Int
}

JetCLICoverageFacts: enum {
    Facts(facts: [JetCLICoverageFact])
    Invalid(message: String)
}

JetCLICoverageBaseline: enum {
    Rows(rows: [JetCLICoverageBaselineRow])
    Invalid(message: String)
}

// `diagnostic_coverage_entries` folded by `try_facts`: one fact per source
// stage of the active rows, in plane order. A row's structured fix is edit
// coverage when the fix has an applicability grade (every fix but
// `CryptoMisuse`).
jet_cli_coverage_facts: fn() -> JetCLICoverageFacts Never! {
    slots := [String:Int]{}
    facts := [JetCLICoverageFact]{}
    loop row in diagnostic_registry_rows() {
        if row.status != DiagnosticRegistryStatus.Active -> next
        plane: row.stage
        fix_edits := row.structured_fix != None
        if row.structured_fix == .Val(fix) {
            if fix == .CryptoMisuse -> fix_edits = false
        }
        if plane.trim() == "" -> return JetCLICoverageFacts.Invalid{message: "diagnostic coverage plane must not be empty"}
        if fix_edits && row.no_fix_reason != None -> return JetCLICoverageFacts.Invalid{message: "coverage row in plane `{plane}` has both fix_edits and no_fix_reason"}
        slot := facts.len()
        if slots.get(plane) == .Val(found) {
            slot = found
        } else {
            slots[plane] = slot
            facts.push(JetCLICoverageFact{plane: plane, rows: 0, edit_covered: 0, reason_covered: 0, behavior_reasons: 0, design_reasons: 0, ambiguous_reasons: 0, uncovered: 0})
        }
        facts[slot].rows += 1
        if fix_edits {
            facts[slot].edit_covered += 1
        } else {
            if row.no_fix_reason == .Val(reason) {
                facts[slot].reason_covered += 1
                if reason.kind == {
                    .Behavior -> facts[slot].behavior_reasons += 1
                    .Design -> facts[slot].design_reasons += 1
                    .Ambiguous -> facts[slot].ambiguous_reasons += 1
                }
            } else {
                facts[slot].uncovered += 1
            }
        }
    }
    planes := [String]{}
    loop fact in facts -> planes.push(fact.plane)
    planes.sort()
    ordered: loop plane in planes -> facts[slots.get(plane) ?? 0]
    JetCLICoverageFacts.Facts{facts: ordered}
}

// A Rust `usize` count: ASCII digits after an optional `+`.
jet_cli_inspect_count: fn(text: String) -> Int? Never! {
    bytes: text.bytes()
    start := 0
    if bytes.len() > 0 && bytes[0] == (U8{43}) -> start = 1
    if start >= bytes.len() -> return None
    value := 0
    loop index in start..<bytes.len() {
        digit: Int.from_u8(bytes[index]) - 48
        if digit < 0 || digit > 9 -> return None
        value = value * 10 + digit
    }
    Val(value)
}

// `CoverageBaseline::parse`: `plane edit reason total` rows, blank lines and
// `#` comments skipped, in plane order.
jet_cli_coverage_baseline: fn(text: String) -> JetCLICoverageBaseline Never! {
    rows := [JetCLICoverageBaselineRow]{}
    loop (index, raw) in text.split("\n").to_list() {
        line: raw.trim()
        if line == "" || line.starts_with("#") -> next
        fields := [String]{}
        loop word in line.replace("\t", " ").split(" ") {
            if word != "" -> fields.push(word)
        }
        number: index + 1
        if fields.len() != 4 -> return JetCLICoverageBaseline.Invalid{message: "coverage baseline line {number} must contain plane, edit count, reason count, and total"}
        edit_covered: jet_cli_inspect_count(fields[1]) ?? return JetCLICoverageBaseline.Invalid{message: "invalid edit count on coverage baseline line {number}"}
        reason_covered: jet_cli_inspect_count(fields[2]) ?? return JetCLICoverageBaseline.Invalid{message: "invalid reason count on coverage baseline line {number}"}
        total: jet_cli_inspect_count(fields[3]) ?? return JetCLICoverageBaseline.Invalid{message: "invalid total on coverage baseline line {number}"}
        if edit_covered + reason_covered > total -> return JetCLICoverageBaseline.Invalid{message: "coverage baseline line {number} counts more covered rows than total"}
        loop row in rows {
            if row.plane == fields[0] -> return JetCLICoverageBaseline.Invalid{message: "duplicate coverage baseline plane `{fields[0]}`"}
        }
        rows.push(JetCLICoverageBaselineRow{plane: fields[0], edit_covered: edit_covered, reason_covered: reason_covered, total: total})
    }
    planes := [String]{}
    loop row in rows -> planes.push(row.plane)
    planes.sort()
    ordered := [JetCLICoverageBaselineRow]{}
    loop plane in planes {
        loop row in rows {
            if row.plane == plane -> ordered.push(row)
        }
    }
    JetCLICoverageBaseline.Rows{rows: ordered}
}

jet_cli_coverage_non_decreasing: fn(plane: String, previous: JetCLICoverageBaselineRow, current: JetCLICoverageBaselineRow) -> String? Never! {
    if current.edit_covered < previous.edit_covered || current.reason_covered < previous.reason_covered || current.total < previous.total {
        return Val("coverage baseline decreased for plane `{plane}`")
    }
    if current.edit_covered + current.reason_covered > current.total -> return Val("coverage counts exceed total for plane `{plane}`")
    None
}

// `a - b`, floored at zero (Rust `saturating_sub`).
jet_cli_inspect_saturating_sub: fn(a: Int, b: Int) -> Int Never! {
    if b > a -> return 0
    a - b
}

// `CoverageBaseline::validate`: the first ratchet failure.
jet_cli_coverage_validate: fn(baseline: [JetCLICoverageBaselineRow], facts: [JetCLICoverageFact]) -> String? Never! {
    loop previous in baseline {
        found := JetCLICoverageFact?{None}
        loop fact in facts {
            if fact.plane == previous.plane -> found = Val(fact)
        }
        fact: found ?? return Val("coverage plane `{previous.plane}` disappeared")
        current: JetCLICoverageBaselineRow{plane: fact.plane, edit_covered: fact.edit_covered, reason_covered: fact.reason_covered, total: fact.rows}
        if jet_cli_coverage_non_decreasing(previous.plane, previous, current) == .Val(message) -> return Val(message)
        previous_uncovered: jet_cli_inspect_saturating_sub(previous.total, previous.edit_covered + previous.reason_covered)
        if current.total > previous.total {
            current_uncovered: jet_cli_inspect_saturating_sub(current.total, current.edit_covered + current.reason_covered)
            if current_uncovered > previous_uncovered -> return Val("new row in open coverage plane `{previous.plane}` has neither fix_edits nor no_fix_reason")
        }
    }
    loop fact in facts {
        known := false
        loop row in baseline {
            if row.plane == fact.plane -> known = true
        }
        if !known && fact.uncovered > 0 -> return Val("new coverage plane `{fact.plane}` has a row with neither fix_edits nor no_fix_reason")
    }
    None
}

jet_cli_coverage_fact_value: fn(fact: JetCLICoverageFact) -> JetCLIStatusValue Never! {
    jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("plane", jet_cli_status_text(fact.plane)),
        jet_cli_status_field("rows", jet_cli_status_int(fact.rows)),
        jet_cli_status_field("edit_covered", jet_cli_status_int(fact.edit_covered)),
        jet_cli_status_field("reason_covered", jet_cli_status_int(fact.reason_covered)),
        jet_cli_status_field("behavior_reasons", jet_cli_status_int(fact.behavior_reasons)),
        jet_cli_status_field("design_reasons", jet_cli_status_int(fact.design_reasons)),
        jet_cli_status_field("ambiguous_reasons", jet_cli_status_int(fact.ambiguous_reasons)),
        jet_cli_status_field("uncovered", jet_cli_status_int(fact.uncovered)),
    })
}

// `run_build_coverage`: the diagnostic repair-coverage table and its ratchet
// against the checked-in floor (`DIAGNOSTIC_COVERAGE_BASELINE`, which the Jet
// host reads from the toolchain tree). A registry or baseline that cannot form
// facts is Jet's own defect.
jet_cli_inspect_coverage: fn(json: Bool, color: Bool) -[FS, Env]> JetCLIPlan Never! {
    facts := [JetCLICoverageFact]{}
    if jet_cli_coverage_facts() == {
        .Invalid(message) -> return JetCLIPlan.Done{output: jet_cli_ice("registered diagnostic coverage rows must be valid: {message}")}
        .Facts(found) -> facts = found
    }
    toolchain: if jet_cli_toolchain_root(cli_files.cwd() ?? ".") == {
        .Found(root) -> root
        .Missing(what, fix) -> { return jet_cli_fail("E2105", what, jet_cli_why("E2105"), fix, color, JET_DRIVER_EXIT_USER_ERROR) }
    }
    baseline_path: "{toolchain}/tests/diagnostics_coverage_baseline.txt"
    text: cli_files.read(baseline_path) ?? return jet_cli_fail("E2105", "can't read the diagnostic coverage baseline `{baseline_path}`", jet_cli_why("E2105"), "set `{JET_CLI_TOOLCHAIN_ROOT_ENV}` to the Jet toolchain source tree, the directory that holds `tests/`", color, JET_DRIVER_EXIT_USER_ERROR)
    baseline := [JetCLICoverageBaselineRow]{}
    if jet_cli_coverage_baseline(text) == {
        .Invalid(message) -> return JetCLIPlan.Done{output: jet_cli_ice("the checked-in diagnostic coverage baseline must parse: {message}")}
        .Rows(rows) -> baseline = rows
    }
    validation: jet_cli_coverage_validate(baseline, facts)
    if json {
        values: loop fact in facts -> jet_cli_coverage_fact_value(fact)
        fields := [JetCLIStatusField]{jet_cli_status_field("coverage", jet_cli_status_array(values))}
        if validation == .Val(error) -> fields.push(jet_cli_status_field("validation_error", jet_cli_status_text(error)))
        return jet_cli_done("{jet_cli_status_render("inspect.build", validation == None, fields)}\n", "", JET_DRIVER_EXIT_OK)
    }
    out := "diagnostic coverage\nplane\trows\twith fix_edits\twith reason\tuncovered\tstate\n"
    loop fact in facts {
        state: if fact.uncovered == 0 -> "closed" else -> "open"
        out = "{out}{fact.plane}\t{fact.rows}\t{fact.edit_covered}\t{fact.reason_covered}\t{fact.uncovered}\t{state}\n"
    }
    if validation == .Val(error) -> out = "{out}coverage validation error: {error}\n"
    jet_cli_done(out, "", JET_DRIVER_EXIT_OK)
}

// crates/jet-pkg-model `current_release_status`.
JET_CLI_RELEASE_CHANNEL: "prerelease"
JET_CLI_RELEASE_DISPOSITION: "current"
JET_CLI_RELEASE_READINESS: "not-ready"
JET_CLI_RELEASE_POLICY: "future-1.0"
JET_CLI_RELEASE_POLICY_DISPOSITION: "planned"
JET_CLI_RELEASE_POLICY_ACTIVE: false

JET_CLI_CAPABILITY_RELATION_SCHEMA: "jet.capability.relation.v1"
JET_CLI_RELEASE_CLAIM_SOURCE: "manifest.capability_relation.rows"

// `run_build_query`: graph/subject queries evaluate a checked build; the bare
// node view consumes authenticated workspace last-run evidence.
jet_cli_inspect_build_query: fn(command: String, args: [String], color: Bool, json: Bool, threads: Int?) -[FS]> JetCLIPlan Never! {
    query: jet_cli_tail(args, 1)
    explain_nodes: command == "explain-build" && query.len() <= 1
    subject := String?{None}
    file := String?{None}
    if command == "graph" && query.len() > 0 -> file = Val(query[0])
    if command == "query" && query.len() > 1 && query[0] == "build" -> file = Val(query[1])
    if command == "explain-build" {
        if explain_nodes {
            if query.len() > 0 -> file = Val(query[0])
        } else {
            subject = Val(query[0])
            file = Val(query[1])
        }
    }
    path: file ?? {
        hint: if command == "explain-build" -> "<target|action|file> " else -> ""
        return jet_cli_inspect_plain_error("usage: jet {command} {hint}<file.jet>\n", "`jet {command}` needs a Jet file", "run `jet {command} {hint}<file.jet>`", JET_DRIVER_EXIT_USAGE)
    }
    JetCLIPlan.Inspect{job: JetCLIInspectJob{action: command, file: path, subject: subject, json: json, color: color, threads: threads, notice: "", project: false}}
}

// `compiler_api_error_json`: the versioned error document of one `jet inspect
// compiler` operation.
jet_cli_inspect_compiler_error: fn(operation: String, file: String, message: String) -> JetCLIPlan Never! {
    error: jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("code", jet_cli_status_text("E0956")),
        jet_cli_status_field("message", jet_cli_status_text(message)),
    })
    compiler: jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("schema_version", jet_cli_status_int(1)),
        jet_cli_status_field("api_version", jet_cli_status_int(1)),
        jet_cli_status_field("operation", jet_cli_status_text(operation)),
        jet_cli_status_field("file", jet_cli_status_text(file)),
        jet_cli_status_field("error", error),
    })
    jet_cli_done("{jet_cli_status_render("inspect.compiler.{operation}", false, [JetCLIStatusField]{jet_cli_status_field("compiler", compiler)})}\n", "", JET_DRIVER_EXIT_OK)
}

// Can `file` be read as UTF-8 text / as bytes?
jet_cli_inspect_reads: fn(file: String) -[FS]> Bool Never! {
    text: cli_files.read(file) ?? return false
    text.len() >= 0
}

jet_cli_inspect_reads_bytes: fn(file: String) -[FS]> Bool Never! {
    bytes: cli_files.read_bytes(file) ?? return false
    bytes.len() >= 0
}

// `run_compiler_api`: an unknown operation and an unreadable input are
// versioned error documents (Rust `io::Error` wording); lex and parse project
// the Jet lexer and parser over the inline-package-masked source, source-map
// reads the `// jet:` markers of generated Rust, and check projects the checked
// file (InspectCompiler.jet, `checked_value`).
jet_cli_inspect_compiler: fn(args: [String], color: Bool) -[FS, Env, Exec, IO, FFI.C, FFI.Asm, Net, Time]> JetCLIPlan Never! {
    operation: if args.len() > 1 -> args[1] else -> ""
    file: if args.len() > 2 -> args[2] else -> ""
    reads: operation == "lex" || operation == "parse" || operation == "check" || operation == "source-map" || operation == "source_map"
    if !reads -> return jet_cli_inspect_compiler_error(operation, file, "unsupported compiler operation; choose lex, parse, check, or source-map")
    if cli_files.is_dir(file) -> return jet_cli_inspect_compiler_error(operation, file, "could not read compiler input: Is a directory (os error 21)")
    if !cli_files.exists(file) -> return jet_cli_inspect_compiler_error(operation, file, "could not read compiler input: No such file or directory (os error 2)")
    if !jet_cli_inspect_reads(file) {
        if !jet_cli_inspect_reads_bytes(file) -> return jet_cli_inspect_compiler_error(operation, file, "could not read compiler input: Permission denied (os error 13)")
        return jet_cli_inspect_compiler_error(operation, file, "could not read compiler input: stream did not contain valid UTF-8")
    }
    if operation == "check" -> return JetCLIPlan.Done{output: jet_cli_inspect_compiler_check(file, cli_files.read(file) ?? "")}
    source: cli_files.read(file) ?? ""
    // `compiler_json` names source-map `source_map` in both the action and the
    // payload.
    name: if operation == "source-map" -> "source_map" else -> operation
    value := JetCLIStatusValue.Null
    if operation == "lex" {
        value = jet_cli_compiler_lexed(source)
    } else if operation == "parse" {
        value = jet_cli_compiler_syntax_tree(source)
    } else {
        value = jet_cli_compiler_source_map(source)
    }
    payload: jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("schema_version", jet_cli_status_int(1)),
        jet_cli_status_field("api_version", jet_cli_status_int(1)),
        jet_cli_status_field("operation", jet_cli_status_text(name)),
        jet_cli_status_field("value", value),
    })
    jet_cli_done("{jet_cli_status_render("inspect.compiler.{name}", true, [JetCLIStatusField]{jet_cli_status_field("compiler", payload)})}\n", "", JET_DRIVER_EXIT_OK)
}

// `status_source_map` over the shared marker reader
// (jet_eval_compiler_services_source_map).
jet_cli_compiler_source_map: fn(rust_source: String) -> JetCLIStatusValue Never! {
    map: jet_eval_compiler_services_source_map(rust_source)
    lines := [JetCLIStatusValue]{}
    loop line in map.generated_lines {
        lines.push(jet_cli_status_object([JetCLIStatusField]{
            jet_cli_status_field("generated_line", jet_cli_status_int(line.generated_line)),
            jet_cli_status_field("source", jet_cli_status_optional_text(line.source)),
            jet_cli_status_field("source_line", jet_cli_status_int(line.source_line)),
        }))
    }
    jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("schema_version", jet_cli_status_int(1)),
        jet_cli_status_field("api_version", jet_cli_status_int(1)),
        jet_cli_status_field("sources", jet_cli_status_texts(map.sources)),
        jet_cli_status_field("generated_lines", jet_cli_status_array(lines)),
    })
}

// `token_kind_name`, indexed by the jet_lexer `TOKEN_*` tag.
JET_CLI_TOKEN_KIND_NAMES: [String]{
    "", "identifier", "literal.raw_string", "literal.string", "literal.int", "literal.float",
    "literal.unit_number", "literal.char", "literal.true", "literal.false", "keyword.self",
    "literal.null", "keyword.break", "keyword.return", "punctuation.right_paren",
    "punctuation.right_bracket", "punctuation.right_brace", "operator.try", "operator.plus_plus",
    "operator.minus_minus", "operator.greater", "operator.shift_right", "operator.fence_close",
    "punctuation.dot", "operator.optional_field", "operator.and", "operator.or", "operator.add",
    "operator.subtract", "operator.star", "operator.divide", "operator.floor_divide",
    "operator.modulo", "operator.remainder", "operator.equal", "operator.not_equal",
    "operator.less", "operator.less_equal", "operator.greater_equal", "operator.compare",
    "operator.amp", "operator.alternative", "operator.caret", "operator.tilde_pipe",
    "operator.shift_left", "operator.fallback", "punctuation.left_brace",
    "punctuation.left_paren", "punctuation.left_bracket", "eof", "operator.not",
    "operator.unified_arrow", "", "", "operator.assign", "comment.line",
    "comment.block", "keyword.fn", "keyword.pub", "keyword.priv", "keyword.if", "keyword.else",
    "keyword.in", "keyword.mutate", "keyword.move", "keyword.copy", "keyword.struct",
    "keyword.enum", "keyword.impl", "keyword.trait", "keyword.tag", "keyword.effect",
    "keyword.derive", "keyword.it", "keyword.const", "keyword.comptime", "keyword.loop",
    "keyword.yield", "keyword.use", "keyword.extern", "keyword.module", "operator.fence_open",
    "punctuation.colon", "punctuation.colon_colon", "operator.bind_mutable",
    "punctuation.comma", "terminator", "operator.range", "operator.range_exclusive",
    "operator.spread", "punctuation.at", "operator.tilde", "operator.tilde_pipe_assign",
    "operator.trait_attach", "operator.add_assign", "operator.subtract_assign",
    "operator.multiply_assign", "operator.divide_assign", "operator.floor_divide_assign",
    "operator.modulo_assign", "operator.remainder_assign", "operator.amp_assign",
    "operator.bit_or_assign", "operator.caret_assign", "operator.shift_left_assign",
    "operator.shift_right_assign", "punctuation.hash", "punctuation.dollar", "operator.pipe",
    "operator.pipe_value",
}

jet_cli_compiler_span: fn(start: Int, end: Int) -> JetCLIStatusValue Never! {
    jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("start", jet_cli_status_int(start)), jet_cli_status_field("end", jet_cli_status_int(end))})
}

// `status_span` of an optional span.
jet_cli_compiler_optional_span: fn(span: Span?) -> JetCLIStatusValue Never! {
    found: span ?? return JetCLIStatusValue.Null
    jet_cli_compiler_span(found.start, found.end)
}

// A diagnostic with a source edit also lists it as `edit` (`span`, `new_text`).
jet_cli_compiler_diagnostics: fn(diagnostics: [Diagnostic]) -> JetCLIStatusValue Never! {
    values := [JetCLIStatusValue]{}
    loop diagnostic in diagnostics {
        severity: if diagnostic.severity == DIAGNOSTIC_ERROR -> "error" else -> "lint"
        fields := [JetCLIStatusField]{
            jet_cli_status_field("code", jet_cli_status_text(diagnostic.code)),
            jet_cli_status_field("severity", jet_cli_status_text(severity)),
            jet_cli_status_field("message", jet_cli_status_text(diagnostic.what)),
            jet_cli_status_field("why", jet_cli_status_text(diagnostic.why)),
            jet_cli_status_field("fix", jet_cli_status_text(diagnostic.fix)),
            jet_cli_status_field("span", jet_cli_compiler_optional_span(diagnostic.span)),
        }
        if diagnostic.edit == .Val(found) -> fields.push(jet_cli_status_field("edit", jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("span", jet_cli_compiler_span(found.span.start, found.span.end)), jet_cli_status_field("new_text", jet_cli_status_text(found.new_text))})))
        values.push(jet_cli_status_object(fields))
    }
    jet_cli_status_array(values)
}

// `SourcePositionIndex::line_col` for every byte offset: lines and columns
// count Unicode scalars from 1; an offset inside a scalar counts that scalar.
JetCLIPositions: struct {
    lines: [Int]
    columns: [Int]
}

jet_cli_compiler_positions: fn(bytes: [U8]) -> JetCLIPositions Never! {
    lines := [Int]{}
    columns := [Int]{}
    line := 1
    column := 1
    loop byte in bytes {
        lines.push(line)
        columns.push(column)
        code: Int.from_u8(byte)
        if {
            code == 10 -> {
                line += 1
                column = 1
            }
            code >= 128 && code < 192 -> {}
            else -> column += 1
        }
    }
    lines.push(line)
    columns.push(column)
    JetCLIPositions{lines: lines, columns: columns}
}

jet_cli_compiler_position: fn(positions: JetCLIPositions, offset: Int) -> JetCLIStatusValue Never! {
    index: if offset < positions.lines.len() -> offset else -> positions.lines.len() - 1
    jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("line", jet_cli_status_int(positions.lines[index])), jet_cli_status_field("column", jet_cli_status_int(positions.columns[index]))})
}

// `lex_source` + `status_lexed`: every token of the source with its inline
// `package: { }` carrier masked (Package `mask_inline_package_source`; a
// malformed carrier is the only diagnostic), with its kind, exact source text,
// byte span, and line/column ends, then the lexer diagnostics.
jet_cli_compiler_lexed: fn(source: String) -> JetCLIStatusValue Never! {
    bytes: source.bytes()
    carrier: jet_driver_inline_package(source)
    lexed: lex(jet_driver_mask_inline_package(source, carrier).bytes())
    diagnostics := lexed.diagnostics
    if carrier.error == .Val(error) -> diagnostics = [Diagnostic]{error}
    positions: jet_cli_compiler_positions(bytes)
    tokens := [JetCLIStatusValue]{}
    loop token in lexed.tokens {
        if carrier.error != None -> break
        start: token.span.start
        end: token.span.end
        text := ""
        if start < end && end <= bytes.len() -> text = String.from_bytes(bytes[start..end - 1]) ?? ""
        kind := ""
        if token.kind >= 0 && token.kind < JET_CLI_TOKEN_KIND_NAMES.len() -> kind = JET_CLI_TOKEN_KIND_NAMES[token.kind]
        tokens.push(jet_cli_status_object([JetCLIStatusField]{
            jet_cli_status_field("kind", jet_cli_status_text(kind)),
            jet_cli_status_field("text", jet_cli_status_text(text)),
            jet_cli_status_field("span", jet_cli_compiler_span(start, end)),
            jet_cli_status_field("start", jet_cli_compiler_position(positions, start)),
            jet_cli_status_field("end", jet_cli_compiler_position(positions, end)),
        }))
    }
    jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("schema_version", jet_cli_status_int(1)),
        jet_cli_status_field("api_version", jet_cli_status_int(1)),
        jet_cli_status_field("source", jet_cli_status_text(source)),
        jet_cli_status_field("tokens", jet_cli_status_array(tokens)),
        jet_cli_status_field("diagnostics", jet_cli_compiler_diagnostics(diagnostics)),
    })
}

// `item_node`: one top-level item's kind, name, and name span.
jet_cli_compiler_item: fn(item: Item) -> JetCLIStatusValue Never! {
    kind := ""
    name := String?{None}
    start := 0
    end := 0
    if item == {
        .Func(value) -> {
            kind = "function"
            name = Val(value.name)
            start = value.name_span.start
            end = value.name_span.end
        }
        .Struct(value) -> {
            kind = "struct"
            name = Val(value.name)
            start = value.name_span.start
            end = value.name_span.end
        }
        .Enum(value) -> {
            kind = "enum"
            name = Val(value.name)
            start = value.name_span.start
            end = value.name_span.end
        }
        .Distinct(value) -> {
            kind = "distinct"
            name = Val(value.name)
            start = value.name_span.start
            end = value.name_span.end
        }
        .TypeAlias(value) -> {
            kind = "type_alias"
            name = Val(value.name)
            start = value.name_span.start
            end = value.name_span.end
        }
        .UnitFamily(value) -> {
            kind = "unit_family"
            name = Val(value.family)
            start = value.family_span.start
            end = value.family_span.end
        }
        .Trait(value) -> {
            kind = "trait"
            name = Val(value.name)
            start = value.name_span.start
            end = value.name_span.end
        }
        .Tag(value) -> {
            kind = "tag"
            name = Val(value.name)
            start = value.name_span.start
            end = value.name_span.end
        }
        .EffectDecl(value) -> {
            kind = "effect"
            name = Val(value.name)
            start = value.name_span.start
            end = value.name_span.end
        }
        .Impl(value) -> {
            kind = "impl"
            name = Val(value.type_name)
            start = value.type_span.start
            end = value.type_span.end
        }
        .Const(value) -> {
            kind = "const"
            name = Val(value.name)
            start = value.name_span.start
            end = value.name_span.end
        }
        .Test(value) -> {
            kind = "test"
            name = value.name
            start = value.name_span.start
            end = value.name_span.end
        }
        .ExternRust(value) -> {
            kind = "extern_rust"
            name = Val(value.crate_spec)
            start = value.span.start
            end = value.span.end
        }
        .Module(value) -> {
            kind = "module"
            name = Val(value.name)
            start = value.name_span.start
            end = value.name_span.end
        }
        .CModule(value) -> {
            kind = "c_module"
            name = Val(value.lib)
            start = value.path_span.start
            end = value.path_span.end
        }
        .CodeModule(value) -> {
            kind = "code_module"
            name = Val(value.name)
            start = value.name_span.start
            end = value.name_span.end
        }
        .ErrorConv(value) -> {
            kind = "error_conversion"
            name = Val("{value.from_ty} -> {value.to_ty}")
            start = value.from_span.start
            end = value.from_span.end
        }
        .Migration(value) -> {
            kind = "migration"
            name = Val(value.type_name)
            start = value.type_span.start
            end = value.type_span.end
        }
        .ProtocolDecl(value) -> {
            kind = "protocol"
            name = Val(value.name)
            start = value.name_span.start
            end = value.name_span.end
        }
        .UserDerive(value) -> {
            kind = "derive"
            name = Val(value.trait_name)
            start = value.trait_span.start
            end = value.trait_span.end
        }
        .TemplateLoop(value) -> {
            kind = "template_loop"
            start = value.span.start
            end = value.span.end
        }
        .GenericModule(value) -> {
            kind = "generic_module"
            name = Val(value.name)
            start = value.name_span.start
            end = value.name_span.end
        }
        .ModuleAlias(value) -> {
            kind = "module_alias"
            name = Val(value.name)
            start = value.name_span.start
            end = value.name_span.end
        }
        .MarkerDecl(value) -> {
            kind = "marker"
            name = Val(value.name)
            start = value.name_span.start
            end = value.name_span.end
        }
        .FactDecl(value) -> {
            kind = "fact"
            name = Val(value.name)
            start = value.name_span.start
            end = value.name_span.end
        }
    }
    jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("kind", jet_cli_status_text(kind)),
        jet_cli_status_field("name", jet_cli_status_optional_text(name)),
        jet_cli_status_field("span", jet_cli_compiler_span(start, end)),
    })
}

// `parse_source` + `status_syntax_tree`: lexer diagnostics (or a malformed
// inline carrier) stop before the parse of the masked source; a parse with
// errors keeps only its error diagnostics and no items; a clean parse lists
// every top-level item and its advisories.
jet_cli_compiler_syntax_tree: fn(source: String) -> JetCLIStatusValue Never! {
    carrier: jet_driver_inline_package(source)
    masked: jet_driver_mask_inline_package(source, carrier).bytes()
    lexed: lex(masked)
    items := [JetCLIStatusValue]{}
    diagnostics := lexed.diagnostics
    if carrier.error == .Val(error) -> diagnostics = [Diagnostic]{error}
    if diagnostics.len() == 0 {
        parsed: parse_source(masked)
        errors := [Diagnostic]{}
        loop diagnostic in parsed.diagnostics {
            if diagnostic.severity == DIAGNOSTIC_ERROR -> errors.push(diagnostic)
        }
        if errors.len() > 0 {
            diagnostics = errors
        } else {
            diagnostics = parsed.diagnostics
            loop item in parsed.program.items -> items.push(jet_cli_compiler_item(item))
        }
    }
    jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("schema_version", jet_cli_status_int(1)),
        jet_cli_status_field("api_version", jet_cli_status_int(1)),
        jet_cli_status_field("source", jet_cli_status_text(source)),
        jet_cli_status_field("items", jet_cli_status_array(items)),
        jet_cli_status_field("diagnostics", jet_cli_compiler_diagnostics(diagnostics)),
    })
}

// `OperatorImpl`, with its operand and result types by name.
JetCLIOperatorImpl: struct {
    left: String
    trait_name: String
    rhs: String
    result: String
    explicit_rhs: Bool
}

jet_cli_inspect_plain_number: fn(name: String) -> Bool Never! {
    name == "Int" || name == "Float" || name == "Decimal"
}

// `operator_symbol`: the source operator of an arithmetic operator trait, `+`
// for `Add`.
jet_cli_inspect_operator_symbol: fn(trait_name: String) -> String? Never! {
    if !owned_trait_arithmetic(trait_name) -> return None
    owned: owned_trait(trait_name) ?? return None
    if owned.operators.len() == 0 -> return None
    Val(owned.operators[0].copy())
}

// The hook method an arithmetic operator trait names, or "".
jet_cli_inspect_operator_method: fn(trait_name: String) -> String Never! {
    if !owned_trait_arithmetic(trait_name) -> return ""
    owned_trait_operator_hook(trait_name) ?? ""
}

// `impl_owner_type`: the owner applied to its own type parameters.
jet_cli_inspect_owner_type: fn(owner: String, params: [String:[TypeParam]]) -> Type Never! {
    found: params.get(owner) ?? return Type.Named{name: owner}
    if found.len() == 0 -> return Type.Named{name: owner}
    args: loop param in found -> Type.Named{name: param.name}
    Type.Apply{name: owner, args: args}
}

jet_cli_inspect_rhs_local: fn(ty: Type, local: [String]) -> Bool Never! {
    if ty == {
        .Named(name) -> return local.contains(name)
        .Apply(name, _) -> return local.contains(name)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> {}
    }
    false
}

jet_cli_inspect_has_operator: fn(impls: [JetCLIOperatorImpl], left: String, trait_name: String, rhs: String) -> Bool Never! {
    loop existing in impls {
        if existing.left == left && existing.trait_name == trait_name && existing.rhs == rhs -> return true
    }
    false
}

// `validate_trait_impl` for an arithmetic hook of a checked program: a
// duplicate (left, trait, rhs) or an orphan registers nothing; otherwise the
// hook method's declared result is the row's result.
jet_cli_inspect_register_trait: fn(owner: String, trait_name: String, methods: [Func], operator_rhs: Type?, local: [String], params: [String:[TypeParam]], impls: &[JetCLIOperatorImpl]) {
    method_name: jet_cli_inspect_operator_method(trait_name)
    if method_name == "" -> return
    owner_type: jet_cli_inspect_owner_type(owner, params)
    rhs_type: operator_rhs ?? owner_type
    rhs: type_name(rhs_type)
    if jet_cli_inspect_has_operator(impls, owner, trait_name, rhs) -> return
    rhs_local: operator_rhs != None && jet_cli_inspect_rhs_local(rhs_type, local)
    if !local.contains(owner) && !rhs_local -> return
    loop method in methods {
        if method.name != method_name -> next
        result: method.return_type ?? return
        impls.push(JetCLIOperatorImpl{left: owner, trait_name: trait_name, rhs: rhs, result: type_name(result), explicit_rhs: operator_rhs != None})
        return
    }
}

// `register_impl`: a field-delegated arithmetic hook results in its owner;
// every other impl is validated as written. A top-level impl and a trait block
// in a type body register the same way.
jet_cli_inspect_register_impl: fn(owner: String, trait_name: String, methods: [Func], operator_rhs: Type?, delegation: String?, local: [String], params: [String:[TypeParam]], impls: &[JetCLIOperatorImpl]) {
    if delegation != None {
        if jet_cli_inspect_operator_method(trait_name) == "" -> return
        owner_type: jet_cli_inspect_owner_type(owner, params)
        rhs_type: operator_rhs ?? owner_type
        impls.push(JetCLIOperatorImpl{left: owner, trait_name: trait_name, rhs: type_name(rhs_type), result: type_name(owner_type), explicit_rhs: operator_rhs != None})
        return
    }
    jet_cli_inspect_register_trait(owner, trait_name, methods, operator_rhs, local, params, impls)
}

// `register_synthetic_operators`: Core's typed vector/scalar hook rows unless
// the module declares the same hook.
jet_cli_inspect_synthetic_operator: fn(impls: &[JetCLIOperatorImpl], left: String, trait_name: String, rhs: String, result: String) {
    if jet_cli_inspect_has_operator(impls, left, trait_name, rhs) -> return
    impls.push(JetCLIOperatorImpl{left: left, trait_name: trait_name, rhs: rhs, result: result, explicit_rhs: true})
}

// One module's operator rows: `TraitRegistry::auto_derives_for_items` then
// `register_synthetic_operators`. Nominal names register first; impls register
// in item order (an owner's type parameters count once its declaration has been
// read), then the trait blocks of structs and enums.
jet_cli_inspect_operator_impls: fn(program: Program) -> [JetCLIOperatorImpl] Never! {
    local := [String]{}
    loop item in program.items {
        if item == {
            .Struct(value) -> local.push(value.name)
            .Enum(value) -> local.push(value.name)
            .TypeAlias(value) -> local.push(value.name)
            .Distinct(value) -> local.push(value.name)
            .Func(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .UserDerive(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    params := [String:[TypeParam]]{}
    impls := [JetCLIOperatorImpl]{}
    loop item in program.items {
        if item == {
            .Struct(value) -> {
                if value.type_params.len() > 0 -> params[value.name] = value.type_params
            }
            .Enum(value) -> params[value.name] = value.type_params
            .TypeAlias(value) -> {
                if value.type_params.len() > 0 -> params[value.name] = value.type_params
            }
            .Impl(value) -> {
                if value.trait_name == .Val(trait_name) -> jet_cli_inspect_register_impl(value.type_name, trait_name, value.methods, value.operator_rhs, value.delegation_field, local, params, impls)
            }
            .Func(_) | .Distinct(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .UserDerive(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    loop item in program.items {
        if item == {
            .Struct(value) -> {
                loop block in value.trait_impls -> jet_cli_inspect_register_impl(value.name, block.trait_name, block.methods, block.operator_rhs, block.delegation_field, local, params, impls)
            }
            .Enum(value) -> {
                loop block in value.trait_impls -> jet_cli_inspect_register_impl(value.name, block.trait_name, block.methods, block.operator_rhs, block.delegation_field, local, params, impls)
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .UserDerive(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    jet_cli_inspect_synthetic_operator(impls, "Vec3", "Mul", "Float", "Vec3")
    jet_cli_inspect_synthetic_operator(impls, "Vec3", "Div", "Float", "Vec3")
    jet_cli_inspect_synthetic_operator(impls, "Float", "Div", "Vec3", "Vec3")
    impls
}

// The checked program's own modules (the Rust bundle's user modules): every
// source of a package root, or the entry file alone.
jet_cli_inspect_programs: fn(snapshot: JetDriverAuthorizedSourceSnapshot) -> [Program] Never! {
    programs := [Program]{}
    loop root in snapshot.roots {
        if root.identity != snapshot.entry_root_identity -> next
        package := false
        loop file in root.files {
            if file.relative_path == "package.jet" -> package = true
        }
        loop file in root.files {
            if !file.path.ends_with(".jet") || file.relative_path == "package.jet" -> next
            if !package && file.path != snapshot.entry_path -> next
            programs.push(parse_source(file.source.bytes()).program)
        }
    }
    programs
}

// `run_types`: every checked operator hook, and the mixed-operand mirror an
// untyped-reverse Add or Mul hook implies, grouped by the type that owns the
// row.
jet_cli_inspect_types: fn(programs: [Program], json: Bool) -> JetDriverVerbOutput Never! {
    registered := [JetCLIOperatorImpl]{}
    loop program in programs {
        loop implementation in jet_cli_inspect_operator_impls(program) -> registered.push(implementation)
    }
    slots := [String:Int]{}
    owners := [String]{}
    grouped := [[String]]{}
    loop implementation in registered {
        symbol: jet_cli_inspect_operator_symbol(implementation.trait_name) ?? next
        left: implementation.left
        rhs: implementation.rhs
        owner: if jet_cli_inspect_plain_number(left) && !jet_cli_inspect_plain_number(rhs) -> rhs else -> left
        source: "{left}.{implementation.trait_name}({rhs})"
        kind: if implementation.explicit_rhs -> "explicit hook" else -> "hook"
        rows := [String]{"{left} {symbol} {rhs} -> {implementation.result}  {kind} {source}"}
        if jet_cli_inspect_plain_number(rhs) && !jet_cli_inspect_plain_number(left) && owned_trait_commutative(implementation.trait_name) {
            explicit_reverse := false
            loop candidate in registered {
                if candidate.explicit_rhs && candidate.left == rhs && candidate.trait_name == implementation.trait_name && candidate.rhs == left -> explicit_reverse = true
            }
            if !explicit_reverse -> rows.push("{rhs} {symbol} {left} -> {implementation.result}  mirror of {source}")
        }
        slot := grouped.len()
        if slots.get(owner) == .Val(found) {
            slot = found
        } else {
            slots[owner] = slot
            owners.push(owner)
            grouped.push([String]{})
        }
        entry := grouped[slot]
        loop row in rows -> entry.push(row)
        grouped[slot] = entry
    }
    owners.sort()
    out := ""
    values := [JetCLIStatusValue]{}
    loop owner in owners {
        sorted := grouped[slots.get(owner) ?? 0]
        sorted.sort()
        rows := [String]{}
        loop row in sorted {
            if rows.len() == 0 || rows[rows.len() - 1] != row -> rows.push(row)
        }
        if json {
            values.push(jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("type", jet_cli_status_text(owner)), jet_cli_status_field("rows", jet_cli_status_texts(rows))}))
        } else {
            out = "{out}type {owner}:\n"
            loop row in rows -> out = "{out}  {row}\n"
        }
    }
    if json -> out = "{jet_cli_status_render("inspect.types", true, [JetCLIStatusField]{jet_cli_status_field("types", jet_cli_status_array(values))})}\n"
    JetDriverVerbOutput{stdout: out, stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// `render_check_failure` (types, shapes) and `report_problems` (the build
// queries, which end in the problem count). Under `--json` the reports are one
// failed status line on stdout: the `inspect` action, or `diagnostics` for the
// build queries.
jet_cli_inspect_check_failed: fn(job: JetCLIInspectJob, source: String, errors: [Diagnostic]) -[FS, Env]> JetDriverVerbOutput Never! {
    build_query: job.action == "graph" || job.action == "query" || job.action == "explain-build"
    if job.json {
        action: if build_query -> "diagnostics" else -> "inspect"
        return JetDriverVerbOutput{stdout: jet_cli_reports_status_json(action, false, jet_cli_report_base(job.file), job.file, source, errors), stderr: "", exit_code: JET_DRIVER_EXIT_USER_ERROR}
    }
    stderr: if build_query -> jet_driver_report_problems(job.file, source, errors, job.color, true) else -> diagnostic_render_all(job.file, source, errors, job.color)
    JetDriverVerbOutput{stdout: "", stderr: stderr, exit_code: JET_DRIVER_EXIT_USER_ERROR}
}

// `emit_diag`: one spanless report, the `cli` status line on stdout under
// `--json`.
jet_cli_replay_fail: fn(job: JetCLIInspectJob, code: String, what: String, why: String, fix: String, exit_code: Int) -> JetDriverVerbOutput Never! {
    if job.json -> return JetDriverVerbOutput{stdout: jet_cli_fail_json(code, what, why, fix), stderr: "", exit_code: exit_code}
    jet_cli_report_output("", code, what, why, fix, job.color, exit_code)
}

// `validate_replay_path`: a forward-slash path of non-empty, safe components
// ending in `.jetproof-replay` (Rust `Path::components` drops an interior `.`).
jet_cli_replay_path_problem: fn(path: String) -> String? Never! {
    if path == "" -> return Val("replay artifact path is empty")
    loop byte in path.bytes() {
        code: Int.from_u8(byte)
        if code == 0 || code == 92 -> return Val("replay artifact path must use forward-slash components")
    }
    absolute: path.starts_with("/")
    relative: if absolute -> path.slice(1..<path.len()) else -> path
    parts: relative.split("/").to_list()
    loop part in parts {
        if part == "" -> return Val("replay artifact path must use non-empty components")
    }
    loop (index, part) in parts {
        if part == ".." || (index == 0 && !absolute && part == ".") -> return Val("replay artifact path contains an unsafe component")
    }
    name: parts[parts.len() - 1]
    if name.starts_with(".") || !name.ends_with(".jetproof-replay") || name.len() == ".jetproof-replay".len() {
        return Val("replay artifact path must end in `.jetproof-replay`")
    }
    None
}

jet_cli_replay_name_problem: fn(name: String) -> String? Never! {
    valid := name != ""
    loop byte in name.bytes() {
        code: Int.from_u8(byte)
        if !((code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 45 || code == 95) -> valid = false
    }
    if valid -> return None
    Val("replay NAME must be non-empty and contain only ASCII letters, digits, `-`, or `_`")
}

// Rust `Path::starts_with(".jet")`: the first component is `.jet`.
jet_cli_replay_in_project_cache: fn(path: String) -> Bool Never! {
    path == ".jet" || path.starts_with(".jet/")
}

// `ensure_read_parent`: every ancestor of the artifact is a real directory.
jet_cli_replay_parent_problem: fn(path: String) -[FS]> String? Never! {
    parent: jet_cli_parent(path) ?? return None
    absolute: parent.starts_with("/")
    current := if absolute -> "" else -> "."
    loop part in parent.split("/").to_list() {
        if part == "" || part == "." -> next
        if part == ".." -> return Val("replay artifact parent contains an unsafe component")
        current = "{current}/{part}"
        stat: cli_files.stat(current) ?? return Val("could not inspect replay artifact parent `{current}`: {err}")
        if stat.is_symlink -> return Val("replay artifact parent is a symlink: {current}")
        if !stat.is_dir -> return Val("replay artifact parent is not a directory: {current}")
    }
    None
}

// `run_inspect_replay` through `open_named_replay`: the replay identity of the
// project entry (its bytes, its path inside the working directory, and a clean
// check), the named or written artifact path, then the artifact's parents and
// file. Reading and verifying a present artifact is not ported yet.
jet_cli_inspect_replay_host: fn(job: JetCLIInspectJob) -> JetDriverVerbOutput {
    artifact: job.subject ?? ""
    identity_what: "replay semantic identity could not be established"
    identity_fix: "replay the matching readable project file"
    _ := cli_files.read_bytes(job.file) ?? return jet_cli_replay_fail(job, "E3621", identity_what, "could not read `{job.file}`: {err}", identity_fix, JET_DRIVER_EXIT_USER_ERROR)
    cwd: cli_files.cwd() ?? return jet_cli_replay_fail(job, "E3621", identity_what, "could not resolve the project root: {err}", identity_fix, JET_DRIVER_EXIT_USER_ERROR)
    absolute: if job.file.starts_with("/") -> job.file else -> jet_cli_entry_join(cwd, job.file)
    prefix: if cwd.ends_with("/") -> cwd else -> "{cwd}/"
    if absolute != cwd && !absolute.starts_with(prefix) -> return jet_cli_replay_fail(job, "E3621", identity_what, "entry identity must be inside the current project", identity_fix, JET_DRIVER_EXIT_USER_ERROR)
    relative: if absolute == cwd -> "" else -> absolute.slice(prefix.len()..<absolute.len())
    clean := relative != "" && !relative.starts_with("/")
    loop part in relative.split("/").to_list() {
        if part == "" || part == "." || part == ".." -> clean = false
    }
    if !clean -> return jet_cli_replay_fail(job, "E3621", identity_what, "entry identity must be a clean project-relative path", identity_fix, JET_DRIVER_EXIT_USER_ERROR)
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    compiled: jet_cli_compile_file(job.file, job.color, job.threads, JetDriverCompileMode.Program)
    if compiled == {
        .Refused(refusal) -> output = refusal.move()
        .Compiled(result, snapshot) -> {
            diagnostics: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            checked: jet_cli_errors(diagnostics).len() == 0 && result.internal_problem == None
            jet_cli_inspect_finish(job, if checked -> jet_cli_inspect_replay_artifact(job, artifact, absolute) else -> jet_cli_replay_fail(job, "E3621", identity_what, "could not check `{job.file}` for artifact identity", identity_fix, JET_DRIVER_EXIT_USER_ERROR))
        }
    }
    output
}

// The replay artifact named by `artifact` for the checked entry at `absolute`.
jet_cli_inspect_replay_artifact: fn(job: JetCLIInspectJob, artifact: String, absolute: String) -> JetDriverVerbOutput {
    // `selected_project_root` of the entry's directory.
    directory: jet_cli_parent(absolute) ?? "."
    root := directory
    if jet_cli_find_package_root(directory, job.color) == .Root(found) -> root = found
    name_fix: "write `--replay=NAME` with a valid replay name or artifact path"
    path := ""
    if artifact.ends_with(".jetproof-replay") || artifact.contains("/") {
        if jet_cli_replay_path_problem(artifact) == .Val(problem) -> return jet_cli_replay_fail(job, "E2104", "invalid replay name", problem, name_fix, JET_DRIVER_EXIT_USAGE)
        path = if jet_cli_replay_in_project_cache(artifact) -> jet_cli_entry_join(root, artifact) else -> artifact
    } else {
        if jet_cli_replay_name_problem(artifact) == .Val(problem) -> return jet_cli_replay_fail(job, "E2104", "invalid replay name", problem, name_fix, JET_DRIVER_EXIT_USAGE)
        path = jet_cli_entry_join(root, ".jet/replays/{artifact}.jetproof-replay")
    }
    unavailable: "replay artifact is corrupt or unavailable"
    recapture: "recapture the target and retry"
    if jet_cli_replay_path_problem(path) == .Val(problem) -> return jet_cli_replay_fail(job, "E3622", unavailable, problem, recapture, JET_DRIVER_EXIT_USER_ERROR)
    resolved: if jet_cli_replay_in_project_cache(path) -> jet_cli_entry_join(root, path) else -> path
    if jet_cli_replay_parent_problem(resolved) == .Val(problem) -> return jet_cli_replay_fail(job, "E3622", unavailable, problem, recapture, JET_DRIVER_EXIT_USER_ERROR)
    stat: cli_files.stat(resolved) ?? return jet_cli_replay_fail(job, "E3622", unavailable, "could not inspect `{path}`: {err}", recapture, JET_DRIVER_EXIT_USER_ERROR)
    if stat.is_symlink || !stat.is_file -> return jet_cli_replay_fail(job, "E3622", unavailable, "replay artifact is not a regular file: {path}", recapture, JET_DRIVER_EXIT_USER_ERROR)
    jet_cli_not_ported_output("inspect --replay", job.color)
}

// Carry out one inspect job: check the entry as `check_projection` does (a
// missing entry is the loader's E0603 at its absolute path), then project
// the checked program. Resolution's notices go out first. Unannotated
// because the compile verbs are (Request.jet `jet_cli_compile_file`).
jet_cli_inspect_host: fn(job: JetCLIInspectJob) -> JetDriverVerbOutput {
    jet_cli_inspect_noticed(job.notice, jet_cli_inspect_run_job(job))
}

// A job's output behind resolution's notices.
jet_cli_inspect_noticed: fn(notice: String, output: &&JetDriverVerbOutput) -> JetDriverVerbOutput {
    noticed := output.move()
    if notice != "" -> noticed.stderr = "{notice}{noticed.stderr}"
    noticed
}

// A job that holds a compile result ends the process with its noticed
// output from inside the scope that owns the result (jet_cli_finish).
jet_cli_inspect_finish: fn(job: JetCLIInspectJob, output: &&JetDriverVerbOutput) -> Never {
    jet_cli_finish(jet_cli_inspect_noticed(job.notice, output))
}

jet_cli_inspect_run_job: fn(job: JetCLIInspectJob) -> JetDriverVerbOutput {
    if job.action == "replay" -> return jet_cli_inspect_replay_host(job)
    if job.action == "provenance" -> return jet_cli_inspect_provenance_host(job)
    // Structure prints any retained partial facts ahead of failing diagnostics,
    // so it skips the generic check preflight below.
    if job.action == "structure" -> return jet_cli_structure_host(job.file, job.color, job.json, job.threads, job.notice)
    if !cli_files.is_file(job.file) {
        missing: diagnostic_from_registry("E0603", None, "can't find the file `{jet_cli_inspect_absolute(job.file)}`", "a named `.jet` source path must point at an existing file", "check the spelling, or create the missing file")
        return jet_cli_inspect_check_failed(job, "", [Diagnostic]{missing})
    }
    source: cli_files.read(job.file) ?? ""
    if job.action == "decisions" -> return jet_cli_inspect_decisions_host(job, source)
    if job.action == "graph" || job.action == "query" || job.action == "explain-build" -> return jet_cli_inspect_checked_build_host(job)
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    semantic: job.action == "rights" || job.action == "impact" || job.action == "shapes" || job.action == "expand" || job.action == "web-graph" || job.action == "explain-effects"
    mode: if semantic -> JetDriverCompileMode.Doc else -> JetDriverCompileMode.Program
    watch: cli_time.start()
    compiled: jet_cli_compile_file(job.file, job.color, job.threads, mode)
    if compiled == {
        .Refused(refusal) -> output = refusal.move()
        .Compiled(result, snapshot) -> {
            diagnostics: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            errors: jet_cli_errors(diagnostics)
            if {
                // The ladder still explains a program that fails its check (an
                // E0749 asks exactly this): the report goes to stdout under the
                // errors.
                errors.len() > 0 && job.action == "explain-effects" && !job.json && result.doc_modules.len() > 0 -> {
                    failed: jet_cli_inspect_check_failed(job, source, errors)
                    report: jet_cli_explain_effects_report(result, job)
                    output = JetDriverVerbOutput{stdout: report.stdout, stderr: failed.stderr, exit_code: failed.exit_code}
                }
                errors.len() > 0 -> output = jet_cli_inspect_check_failed(job, source, errors)
                result.internal_problem != None -> output = jet_cli_ice(result.internal_problem ?? "")
                job.action == "types" -> output = jet_cli_inspect_types(jet_cli_inspect_programs(snapshot), job.json)
                job.action == "shapes" -> output = jet_cli_inspect_shapes(result.doc_modules, job.json, job.color)
                job.action == "rights" -> output = jet_cli_inspect_rights(result, job.project, job.file, job.json)
                job.action == "impact" -> output = jet_cli_inspect_impact_report(job, result, diagnostics.len(), watch.elapsed_millis())
                job.action == "expand" -> output = jet_cli_inspect_expand_report(job, result, diagnostics.len(), watch.elapsed_millis())
                job.action == "web-graph" -> output = jet_cli_web_graph_report(result, job.json)
                job.action == "explain-effects" -> output = jet_cli_explain_effects_report(result, job)
                else -> panic("inspect action has no canonical provider: {job.action}")
            }
            jet_cli_inspect_finish(job, output)
        }
    }
    output
}

jet_cli_inspect_checked_build_host: fn(job: JetCLIInspectJob) -> JetDriverVerbOutput {
    prepared: jet_cli_prepare_overlays(job.file, job.file, [JetCLIOverlay]{}, job.color, job.threads, JetDriverCompileMode.Doc)
    if prepared.move() == {
        .Refused(output) -> return output
        .Prepared(request, _) -> {
            // The checked build scope belongs to this invocation, not a CLI cache or
            // process-global integer. Driver owns evaluation and graph provenance.
            scope := JetDriverBuildQueryScope{next_session_id: 1}
            if job.action == "explain-build" && job.subject == None {
                snapshot: request.authorized_sources
                workspace := String?{None}
                loop root in snapshot.roots {
                    if root.identity == snapshot.entry_root_identity -> workspace = Val(root.canonical_path)
                }
                root: workspace ?? return jet_cli_ice("the selected build entry has no authenticated source root")
                program: jet_cli_build_record_program_at(snapshot.entry_path, root, cli_files.cwd() ?? return jet_cli_ice("could not read the build host working directory"))
                store: ArtifactStore.from_env() ?? return jet_cli_execute(jet_cli_inspect_b_report("E2104", "can't open authenticated build execution-node evidence", "{err}", "check the machine-wide artifact store configuration and permissions", job.color, job.json, JET_DRIVER_EXIT_USER_ERROR))
                record: if store.last_build_record(root, program) == {
                    .Val(value) -> Val(value)
                    .None -> None
                    .Err(error) -> { return jet_cli_execute(jet_cli_inspect_b_report("E2104", "can't read authenticated build execution-node evidence", "{error}", "check the selected workspace last-run pointer and artifact store", job.color, job.json, JET_DRIVER_EXIT_USER_ERROR)) }
                }
                return jet_cli_build_nodes_host(request, scope, job.file, program, record, job.json, job.color, job.verbose)
            }
            return jet_cli_build_host(request, scope, job.file, job.subject, job.json, job.color, job.verbose)
        }
    }
}

// jet-impact `ImpactEdge` / `ImpactRef`.
JetCLIImpactEdge: struct {
    depth: Int
    caller: String
    callee: String
    module_path: String
    span: Span
}

// Over jet-impact `ImpactReport::analyze`: the symbol's definition
// (`module::name` matches a module suffix), its references and direct call
// sites, and the transitive callers and callees to the depth limit, each edge
// once, breadth first. The explicit-file check result
// (`check_result_text`/`check_result_value`) leads the report.
jet_cli_inspect_impact_report: fn(job: JetCLIInspectJob, result: JetDriverCompileResult, diagnostics: Int, elapsed_ms: Int) -> JetDriverVerbOutput {
    symbol: job.subject ?? ""
    index: jet_cli_checked_semindex(result)
    definition_module := String?{None}
    parts: symbol.split("::").to_list()
    if parts.len() > 1 {
        name: parts[parts.len() - 1]
        module_name: symbol.slice(0..<(symbol.len() - name.len() - 2))
        loop definition in index.definitions {
            if definition.def.name == name && (definition.def.module_path == module_name || definition.def.module_path.ends_with(module_name)) {
                definition_module = Val(definition.def.module_path)
                break
            }
        }
    } else {
        loop definition in index.definitions {
            if definition.def.name == symbol {
                definition_module = Val(definition.def.module_path)
                break
            }
        }
    }
    found: definition_module != None
    references := [SemRef]{}
    loop reference in index.references {
        if reference.name == symbol -> references.push(reference)
    }
    call_sites := [JetCLIImpactEdge]{}
    loop call in index.calls {
        if call.callee == symbol -> call_sites.push(JetCLIImpactEdge{depth: 1, caller: call.caller, callee: call.callee, module_path: call.module_path, span: call.span})
    }
    upstream := [JetCLIImpactEdge]{}
    downstream := [JetCLIImpactEdge]{}
    if found {
        upstream = jet_cli_impact_walk(index.calls, symbol, job.depth, true)
        downstream = jet_cli_impact_walk(index.calls, symbol, job.depth, false)
    }
    source: job.file
    if job.json {
        check: jet_cli_inspect_check_value(source, elapsed_ms, diagnostics, JET_BUILD_DEFAULT_PROFILE)
        definition_value: if definition_module == .Val(name) -> jet_cli_status_text(name) else -> JetCLIStatusValue.Null
        impact: jet_cli_status_object([JetCLIStatusField]{
            jet_cli_status_field("symbol", jet_cli_status_text(symbol)),
            jet_cli_status_field("found", jet_cli_status_bool(found)),
            jet_cli_status_field("depth_limit", jet_cli_status_int(job.depth)),
            jet_cli_status_field("definition_module", definition_value),
            jet_cli_status_field("references", jet_cli_status_array(loop reference in references -> jet_cli_status_object([JetCLIStatusField]{
                jet_cli_status_field("depth", jet_cli_status_int(1)),
                jet_cli_status_field("name", jet_cli_status_text(reference.name)),
                jet_cli_status_field("module_path", jet_cli_status_text(reference.module_path)),
                jet_cli_status_field("span", jet_cli_compiler_span(reference.span.start, reference.span.end)),
            }))),
            jet_cli_status_field("call_sites", jet_cli_impact_edges_value(call_sites)),
            jet_cli_status_field("upstream_callers", jet_cli_impact_edges_value(upstream)),
            jet_cli_status_field("downstream_callees", jet_cli_impact_edges_value(downstream)),
            jet_cli_status_field("check", check),
        })
        status: if found -> JET_DRIVER_EXIT_OK else -> JET_DRIVER_EXIT_USER_ERROR
        return JetDriverVerbOutput{stdout: "{jet_cli_status_render("inspect.impact", found, [JetCLIStatusField]{jet_cli_status_field("impact", impact)})}\n", stderr: "", exit_code: status}
    }
    out := jet_cli_inspect_check_text(source, elapsed_ms, diagnostics, JET_BUILD_DEFAULT_PROFILE)
    if !found {
        out = "{out}symbol `{symbol}` not found in index\n"
        if references.len() == 0 && call_sites.len() == 0 -> return JetDriverVerbOutput{stdout: out, stderr: "", exit_code: JET_DRIVER_EXIT_USER_ERROR}
        out = "{out}partial matches from name references/calls:\n"
    } else {
        defined: if definition_module == .Val(name) -> " (defined in {name})" else -> ""
        out = "{out}blast radius for `{symbol}`{defined}\n"
    }
    out = "{out}  references:        {references.len()}\n  direct call sites: {call_sites.len()}\n"
    out = "{out}  upstream callers:  {upstream.len()} (depth <= {job.depth})\n  downstream callees:{downstream.len()} (depth <= {job.depth})\n"
    loop reference in references -> out = "{out}  ref  {reference.module_path}:{reference.span.start}..{reference.span.end}\n"
    loop edge in call_sites -> out = "{out}  call {edge.caller} -> {edge.callee} @ {edge.module_path}:{edge.span.start}..{edge.span.end}\n"
    loop edge in upstream -> out = "{out}  upstream[d{edge.depth}] {edge.caller} -> {edge.callee} @ {edge.module_path}\n"
    loop edge in downstream -> out = "{out}  downstream[d{edge.depth}] {edge.caller} -> {edge.callee} @ {edge.module_path}\n"
    status: if found -> JET_DRIVER_EXIT_OK else -> JET_DRIVER_EXIT_USER_ERROR
    JetDriverVerbOutput{stdout: out, stderr: "", exit_code: status}
}

// `check_result_value` for a passed explicit-file check: the `jet.check/v1`
// record impact and expand carry.
jet_cli_inspect_check_value: fn(source: String, elapsed_ms: Int, diagnostics: Int, profile: String) -> JetCLIStatusValue Never! {
    fields := [JetCLIStatusField]{jet_cli_status_field("status", jet_cli_status_text("passed"))}
    loop field in jet_cli_check_result_fields(source, elapsed_ms, diagnostics, profile) -> fields.push(field)
    jet_cli_status_object(fields)
}

// The `jet.check/v1` fields of a passed explicit-file check. A clean
// `jet check --json <file>` carries them on its status envelope, whose `ok`
// is the verdict (the envelope has no legacy `status` key); the record impact
// and expand nest also leads with `status: passed`. `profile` is the profile
// the check compiled under.
jet_cli_check_result_fields: fn(source: String, elapsed_ms: Int, diagnostics: Int, profile: String) -> [JetCLIStatusField] Never! {
    rows := [JetCLIStatusValue]{}
    loop row in JET_CLI_EXPLICIT_FILE_PROOF_ROWS {
        rows.push(jet_cli_status_object([JetCLIStatusField]{
            jet_cli_status_field("output", jet_cli_status_text("not-applicable")),
            jet_cli_status_field("name", jet_cli_status_text(row[0])),
            jet_cli_status_field("status", jet_cli_status_text("not applicable")),
            jet_cli_status_field("detail", jet_cli_status_text(row[1])),
            jet_cli_status_field("diagnostic", jet_cli_status_text(row[2])),
        }))
    }
    provenance: jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("source", jet_cli_status_text(source)),
        jet_cli_status_field("profile", jet_cli_status_text(profile)),
        jet_cli_status_field("front_end", jet_cli_status_text(JET_CLI_CHECK_FRONT_END)),
        jet_cli_status_field("programmable_build", jet_cli_status_text("not-selected")),
        jet_cli_status_field("diagnostics", jet_cli_status_int(diagnostics)),
    })
    [JetCLIStatusField]{
        jet_cli_status_field("contract", jet_cli_status_text("jet.check/v1")),
        jet_cli_status_field("schema_version", jet_cli_status_int(1)),
        jet_cli_status_field("scope", jet_cli_status_text("explicit-file")),
        jet_cli_status_field("elapsed_ms", jet_cli_status_int(elapsed_ms)),
        jet_cli_status_field("provenance", provenance),
        jet_cli_status_field("rows", jet_cli_status_array(rows)),
    }
}

// `check_result_text` for a passed explicit-file check.
jet_cli_inspect_check_text: fn(source: String, elapsed_ms: Int, diagnostics: Int, profile: String) -> String Never! {
    out := "check: passed (source={source}, profile={profile}, scope=explicit-file, schema_version=1, elapsed_ms={elapsed_ms}, front_end={JET_CLI_CHECK_FRONT_END}, programmable_build=not-selected, diagnostics={diagnostics})\n"
    loop row in JET_CLI_EXPLICIT_FILE_PROOF_ROWS {
        out = "{out}proof: output=not-applicable {row[0]} [not applicable] {row[1]} (diagnostic={row[2]})\n"
    }
    out
}

// `run_expand` after the check: the selected lens projected from the checked
// program (Expand.jet, ExpandFacts.jet, WebGraph.jet). The bare all-lens view
// is refused rather than reported partially.
jet_cli_inspect_expand_report: fn(job: JetCLIInspectJob, result: JetDriverCompileResult, diagnostics: Int, elapsed_ms: Int) -> JetDriverVerbOutput {
    selection: job.subject ?? return jet_cli_not_ported_output("inspect expand <all lenses>", false)
    index: jet_cli_checked_semindex(result)
    facts := [JetCLIExpandFact]{}
    if selection == {
        "inline" -> facts = jet_cli_expand_inline(result.doc_modules, job.json)
        "effects" -> facts = jet_cli_expand_effects(index)
        "derive" -> facts = jet_cli_expand_derive(index, result.doc_modules)
        "web" -> facts = jet_cli_expand_web(result.doc_modules, result.entry_module_identity, job.json)
        "templates" -> facts = jet_cli_expand_templates(result.doc_modules)
        "callable-signature" -> facts = jet_cli_expand_callable(index, result.doc_modules)
        "memory" -> facts = jet_cli_expand_memory(result.doc_modules, index)
        "layout" -> facts = jet_cli_expand_layout(result.doc_modules)
        "origin" -> facts = jet_cli_expand_origin(result.doc_modules)
        else -> panic("expand lens has no projection: {selection}")
    }
    lens := JET_CLI_EXPAND_LENSES[0]
    loop spec in JET_CLI_EXPAND_LENSES {
        if spec.name == selection -> lens = spec
    }
    if job.json {
        values: [JetCLIStatusValue]{jet_cli_expand_lens_value(lens, facts)}
        return JetDriverVerbOutput{stdout: jet_cli_expand_json(index, selection, values, jet_cli_inspect_check_value(job.file, elapsed_ms, diagnostics, JET_BUILD_DEFAULT_PROFILE)), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
    JetDriverVerbOutput{stdout: jet_cli_expand_text(index, lens, facts, jet_cli_inspect_check_text(job.file, elapsed_ms, diagnostics, JET_BUILD_DEFAULT_PROFILE)), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// `explicit_file_proof_rows`: name, detail, diagnostic.
JET_CLI_EXPLICIT_FILE_PROOF_ROWS: [[String]]{
    [String]{"entry resolution", "explicit-file checks resolve only the named source file", "E2389"},
    [String]{"module graph", "explicit-file checks keep semantic scope and do not promise a project graph", "E2390"},
    [String]{"Core closure", "explicit-file checks keep semantic scope and do not promise project Core closure", "E2391"},
    [String]{"tier lowering", "explicit-file checks keep semantic scope and do not promise project tier lowering", "E2392"},
}

// `check_projection_with_options_and_preflight` front end.
JET_CLI_CHECK_FRONT_END: "Driver::check_file_with_effect_facts_profile"

jet_cli_impact_edges_value: fn(edges: [JetCLIImpactEdge]) -> JetCLIStatusValue Never! {
    jet_cli_status_array(loop edge in edges -> jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("depth", jet_cli_status_int(edge.depth)),
        jet_cli_status_field("caller", jet_cli_status_text(edge.caller)),
        jet_cli_status_field("callee", jet_cli_status_text(edge.callee)),
        jet_cli_status_field("module_path", jet_cli_status_text(edge.module_path)),
        jet_cli_status_field("span", jet_cli_compiler_span(edge.span.start, edge.span.end)),
    }))
}

// jet-impact `transitive_callers` (`upstream`) / `transitive_callees`: a
// breadth-first walk from `symbol`, each (caller, callee) edge once.
jet_cli_impact_walk: fn(calls: [SemCall], symbol: String, depth_limit: Int, upstream: Bool) -> [JetCLIImpactEdge] Never! {
    out := [JetCLIImpactEdge]{}
    seen := [String]{}
    frontier := [String]{symbol}
    depths := [Int]{0}
    cursor := 0
    loop cursor < frontier.len() {
        // copy: `frontier[cursor]` stays in its list (owner: `frontier`; no move out of an element,
        // E0225) and the binding `current` owns its own.
        current: frontier[cursor].copy()
        // copy: `depths[cursor]` stays in its list (owner: `depths`; no move out of an element,
        // E0225) and the binding `depth` owns its own.
        depth: depths[cursor].copy()
        cursor += 1
        if depth >= depth_limit -> next
        loop call in calls {
            matches: if upstream -> call.callee == current else -> call.caller == current
            if !matches -> next
            key: "{call.caller}\n{call.callee}"
            if seen.contains(key) -> next
            seen.push(key)
            out.push(JetCLIImpactEdge{depth: depth + 1, caller: call.caller, callee: call.callee, module_path: call.module_path, span: call.span})
            frontier.push(if upstream -> call.caller else -> call.callee)
            depths.push(depth + 1)
        }
    }
    out
}
