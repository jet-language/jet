// Doctests under `jet test`. Each ```` ```jet ```` fence in a `///`
// run of a tested file (Docs.jet discovery) becomes the claim
// `doctest <n> of <item> in <file>` (`doctest <n> of <file>` when the run
// documents no named item): the `n`th fence documenting that item, so an edit
// elsewhere in the file keeps every name. The claims are appended after the
// file's last line in the compile's snapshot (nothing is written), so every
// original span stays put and the fence sees the file's items. The tested
// files are the package's sources when the target is in a package, else the
// target file alone. The claim runs the fence's setup lines, then prints the
// rendering of each `EXPR // => VALUE` expression in a frame. The parent
// compares each frame with its claimed value: a mismatch is E2901 at the
// claim's line and fails the doctest (or, under `--update-snapshots`, rewrites
// the claimed value); the claim's own output stays without the frames.
use {
    jet_driver.[JetDriverAuthorizedSourceSnapshot]
    jet_foundation.[
        DOC_COMMENT_PREFIX,
        Diagnostic,
        Span,
        diagnostic_from_registry,
        diagnostic_registry_row,
        diagnostic_render_all,
    ]
    jet_semindex.[semindex_doc_text]
}

JET_CLI_DOCTEST_OPEN: "\tjet-doctest\t"
JET_CLI_DOCTEST_CLOSE: "\tjet-doctest-end\t\n"

// One tested file with doctests: its path, its path as claims and
// diagnostics show it (relative to the source root), its original source, the
// doctests discovered in it and each one's claim name.
JetCLIDoctestFile: struct {
    path: String
    shown: String
    source: String
    tests: [JetCLIDocTest]
    names: [String]
}

jet_cli_doctest_file: fn(path: String, shown: String, source: String) -> JetCLIDoctestFile Never! {
    tests: jet_cli_doc_discover_doctests(JetCLIDocUnit{path: shown, source: source})
    lines: source.split("\n").to_list()
    items := [String]{}
    loop test in tests -> items.push(jet_cli_doctest_item(lines, test.line))
    names := [String]{}
    loop index in 0..<items.len() {
        ordinal := 1
        loop before in 0..<index {
            if items[before] == items[index] -> ordinal += 1
        }
        names.push(if items[index] == "" -> "doctest {ordinal} of {shown}" else -> "doctest {ordinal} of {items[index]} in {shown}")
    }
    JetCLIDoctestFile{path: path, shown: shown, source: source, tests: tests, names: names}
}

// The item the `///` run holding the fence at 1-based `fence_line` documents:
// the `name` of the first line after the run (past attribute lines) when it
// declares `name: ...`, as `Outer.name` when it is a member of the unindented
// `Outer: ...` it sits in; empty when the run documents no named item.
jet_cli_doctest_item: fn(lines: [String], fence_line: Int) -> String Never! {
    at := fence_line
    loop at < lines.len() && lines[at].trim().starts_with(DOC_COMMENT_PREFIX) -> at += 1
    loop at < lines.len() && lines[at].trim().starts_with("#") && !lines[at].trim().contains(" ") -> at += 1
    if at >= lines.len() -> return ""
    inner: jet_cli_doctest_declared(lines[at])
    if inner == "" || !(lines[at].starts_with(" ") || lines[at].starts_with("\t")) -> return inner
    above := fence_line - 2
    loop above >= 0 {
        line: lines[above]
        if line.trim() != "" && !line.starts_with(" ") && !line.starts_with("\t") && !line.starts_with("/") {
            outer: jet_cli_doctest_declared(line)
            return if outer == "" -> inner else -> "{outer}.{inner}"
        }
        above -= 1
    }
    inner
}

// The `name` a `name: ...` declaration line (past `priv`) declares, else empty.
jet_cli_doctest_declared: fn(line: String) -> String Never! {
    text: line.trim()
    raw: text.bytes()
    start: if text.starts_with("priv ") -> 5 else -> 0
    end: jet_cli_grammar_ident_end(raw, start)
    if end == start || end >= raw.len() || raw[end] != (U8{58}) -> return ""
    if end + 1 < raw.len() && raw[end + 1] == (U8{58}) -> return ""
    semindex_doc_text(raw, start, end)
}

// The doctest files of `snapshot`'s entry root (every source of a package, or
// the entry alone when `package` is false), each file's claims laid over its
// bytes in `snapshot`.
jet_cli_doctest_overlay: fn(snapshot: &JetDriverAuthorizedSourceSnapshot, package: Bool) -> [JetCLIDoctestFile] Never! {
    found := [JetCLIDoctestFile]{}
    if snapshot.roots.len() == 0 -> return found
    loop file in snapshot.roots[0].files {
        if !package && file.path != snapshot.entry_path -> next
        doctests: jet_cli_doctest_file(file.path, file.relative_path, file.source)
        if doctests.tests.len() > 0 -> found.push(doctests)
    }
    loop doctests in found {
        loop index in 0..<snapshot.roots[0].files.len() {
            if snapshot.roots[0].files[index].path == doctests.path -> snapshot.roots[0].files[index].source = jet_cli_doctest_source(doctests)
        }
    }
    found
}

// `text` as the body of a Jet string literal.
jet_cli_doctest_quote: fn(text: String) -> String Never! {
    text.replace("\\", "\\\\").replace("\"", "\\\"").replace("{{", "{{{{").replace("}}", "}}}}")
}

// The source `jet test` compiles for `doctests`: its original source with one
// claim per doctest after its last line.
jet_cli_doctest_source: fn(doctests: JetCLIDoctestFile) -> String Never! {
    out := if doctests.source.ends_with("\n") -> doctests.source else -> "{doctests.source}\n"
    position := 0
    loop test in doctests.tests {
        out = "{out}\n#Test(\"{jet_cli_doctest_quote(doctests.names[position])}\") {{\n"
        position += 1
        loop line in test.setup -> out = "{out}    {line}\n"
        loop expectation in test.expectations {
            if expectation.expression == "" -> next
            out = "{out}    print(\"\\tjet-doctest\\t{{{expectation.expression}}}\\tjet-doctest-end\\t\")\n"
        }
        out = "{out}}}\n"
    }
    out
}

jet_cli_doctest_named: fn(doctests: JetCLIDoctestFile, name: String) -> JetCLIDocTest? Never! {
    position := 0
    loop test in doctests.tests {
        if doctests.names[position] == name -> return Val(test)
        position += 1
    }
    None
}

// The doctest claims of `tests` (`jet test --docs`).
jet_cli_doctest_claims: fn(tests: [JetNativeTestCase], doctests: [JetCLIDoctestFile]) -> [JetNativeTestCase] Never! {
    claims := [JetNativeTestCase]{}
    loop test in tests {
        loop doctest_file in doctests {
            if jet_cli_doctest_named(doctest_file, test.name) != None {
                claims.push(test.copy())
                break
            }
        }
    }
    claims
}

// The byte span of 1-based `line` in `source`, without its line break.
jet_cli_doctest_line_span: fn(source: String, line: Int) -> Span Never! {
    bytes: source.bytes()
    start := 0
    current := 1
    loop current < line && start < bytes.len() {
        if bytes[start] == (U8{10}) -> current += 1
        start += 1
    }
    end := start
    loop end < bytes.len() && bytes[end] != (U8{10}) && bytes[end] != (U8{13}) -> end += 1
    Span{start: start, end: end}
}

// The outcome wire of the claim of `test` in `doctests`, settled: each framed
// rendering compared with its claimed value, the frames removed from its
// output. A mismatch fails the claim with E2901 and is added to `mismatches`,
// unless `update` records the rewrite of a one-line rendering in `rewrites`
// instead.
jet_cli_doctest_settle: fn(wire: String, doctests: JetCLIDoctestFile, test: JetCLIDocTest, color: Bool, update: Bool, rewrites: &[JetCLIDocExpectation], mismatches: &[JetCLITestStop]) -> String Err! {
    parts := jet_cli_native_test_wire_parts(wire)
    pieces: parts.stdout.split(JET_CLI_DOCTEST_OPEN).to_list()
    output := pieces[0]
    actuals := [String]{}
    loop index in 1..<pieces.len() {
        framed: pieces[index].split(JET_CLI_DOCTEST_CLOSE).to_list()
        if framed.len() < 2 {
            // A frame the claim stopped inside is its output, not a rendering.
            output = "{output}{JET_CLI_DOCTEST_OPEN}{pieces[index]}"
            next
        }
        actuals.push(framed[0])
        rest := framed[1]
        loop at in 2..<framed.len() -> rest = "{rest}{JET_CLI_DOCTEST_CLOSE}{framed[at]}"
        output = "{output}{rest}"
    }
    row: diagnostic_registry_row("E2901") ?? return Err("the doctest mismatch diagnostic is registered")
    diagnostics := [Diagnostic]{}
    position := 0
    loop expectation in test.expectations {
        if expectation.expression == "" -> next
        // A claim that stopped before this line already failed with its stop.
        if position >= actuals.len() -> break
        actual: actuals[position]
        position += 1
        if actual == expectation.expected -> next
        if update && !actual.contains("\n") {
            rewrites.push(JetCLIDocExpectation{expression: expectation.expression, expected: actual, line: expectation.line})
            next
        }
        message: "Doctest output mismatch. Expected: `{expectation.expected}` Got: `{actual}`"
        mismatches.push(JetCLITestStop{code: row.code.copy(), message: message.copy(), file: doctests.shown.copy(), line: checked(U32{expectation.line}) ?? U32{0}})
        diagnostics.push(diagnostic_from_registry(row.code, Val(jet_cli_doctest_line_span(doctests.source, expectation.line)), message, row.why, row.fix))
    }
    if diagnostics.len() > 0 {
        parts.flags = parts.flags.bit_and(14)
        parts.stderr = "{parts.stderr}{diagnostic_render_all(doctests.shown, doctests.source, diagnostics, color)}"
    }
    parts.stdout = output
    Ok(jet_cli_native_test_wire(parts))
}

// `source` with each rewrite's `// =>` claim set to its rendering.
jet_cli_doctest_rewrite: fn(source: String, rewrites: [JetCLIDocExpectation]) -> String Never! {
    lines := source.split("\n").to_list()
    loop rewrite in rewrites {
        index: rewrite.line - 1
        if index < 0 || index >= lines.len() -> next
        raw: lines[index]
        marker: jet_cli_doc_expect_marker(raw) ?? next
        ending: if raw.ends_with("\r") -> "\r" else -> ""
        lines[index] = "{semindex_doc_text(raw.bytes(), 0, marker)}{JET_CLI_DOC_EXPECT_MARKER} {rewrite.expected}{ending}"
    }
    lines.join("\n")
}

#Test("doctest claims append after the source and frame each rendering") {
    doctests: jet_cli_doctest_file("/work/run.jet", "run.jet", "/// ```jet\n/// n := 21\n/// n * 2 // => 42\n/// // => skipped\n/// ```\nf: fn() {{}}")
    assert_eq(doctests.tests.len(), 1)
    assert_eq(jet_cli_doctest_source(doctests), "/// ```jet\n/// n := 21\n/// n * 2 // => 42\n/// // => skipped\n/// ```\nf: fn() {{}}\n\n#Test(\"doctest 1 of f in run.jet\") {{\n    n := 21\n    print(\"\\tjet-doctest\\t{{n * 2}}\\tjet-doctest-end\\t\")\n}}\n")
}

#Test("a doctest is named by the item it documents and its ordinal there, not by its line") {
    source: "/// ```jet\n/// 1 // => 1\n/// ```\n/// ```jet\n/// 2 // => 2\n/// ```\nf: fn() {{}}\n\nP: struct {{\n    /// ```jet\n    /// 3 // => 3\n    /// ```\n    priv g: fn() {{}}\n}}\n\n/// ```jet\n/// 4 // => 4\n/// ```\n"
    doctests: jet_cli_doctest_file("/work/a.jet", "a.jet", source)
    assert_eq(doctests.names, ["doctest 1 of f in a.jet", "doctest 2 of f in a.jet", "doctest 1 of P.g in a.jet", "doctest 1 of a.jet"])
    moved: jet_cli_doctest_file("/work/a.jet", "a.jet", "// a new first line\n\n{source}")
    assert_eq(moved.tests[0].line, 3)
    assert_eq(moved.names, doctests.names)
}

#Test("a doctest mismatch fails its claim with E2901 and keeps the claim's output") {
    source: "/// ```jet\n/// 2 + 2 // => 5\n/// ```\n"
    doctests: jet_cli_doctest_file("/work/a.jet", "a.jet", source)
    stdout: "setup\n{JET_CLI_DOCTEST_OPEN}4{JET_CLI_DOCTEST_CLOSE}"
    wire: jet_cli_native_test_wire(JetNativeTestWire{flags: 1, name: "doctest 1 of a.jet", stdout: stdout, stderr: ""})
    rewrites := [JetCLIDocExpectation]{}
    mismatches := [JetCLITestStop]{}
    settled: jet_cli_doctest_settle(wire, doctests, doctests.tests[0], false, false, rewrites, mismatches) ?? panic("a well-formed wire settles")
    parts: jet_cli_native_test_wire_parts(settled) ?? panic("a settled wire parses")
    assert_eq(parts.flags, 0)
    assert_eq(parts.stdout, "setup\n")
    assert(parts.stderr.contains("E2901"))
    assert(parts.stderr.contains("Expected: `5` Got: `4`"))
    assert_eq(mismatches.len(), 1)
    assert_eq(mismatches[0].code, "E2901")
    assert_eq(mismatches[0].message, "Doctest output mismatch. Expected: `5` Got: `4`")
    assert_eq(mismatches[0].file, "a.jet")
    assert_eq(mismatches[0].line, U32{2})
    updated: jet_cli_doctest_settle(wire, doctests, doctests.tests[0], false, true, rewrites, mismatches) ?? panic("a well-formed wire settles")
    assert_eq(mismatches.len(), 1)
    assert_eq((jet_cli_native_test_wire_parts(updated) ?? panic("an updated wire parses")).flags, 1)
    assert_eq(jet_cli_doctest_rewrite(source, rewrites), "/// ```jet\n/// 2 + 2 // => 4\n/// ```\n")
}
