// `jet inspect audit [--advisory-db <path>] [--explain <id>]`: the project's
// unified lockfile checked against a signed offline advisory feed. The feed is
// `--advisory-db`, else $JET_ADVISORY_DB, else `.jet/advisories.db`; it must
// verify against the pinned trust root `.jet/advisory-trust` before any of its
// records is used. A missing lock or feed is E2611 and a malformed one E2607,
// so an audit never reports a clean result it could not check. Every locked
// package is matched against the advisories (E2603) and the maturity policy
// (E2609); the package's `policy.exceptions` records can waive maturity for an
// exact package#version. A critical match or an immature package fails the
// audit (exit 1); lower-severity matches are reported and the audit passes.
// `--explain <id>` prints one advisory of the verified feed.
use {
    cli_files :: core.files
    jet_driver.[
        JetDriverVerbOutput,
        JET_DRIVER_EXIT_OK,
        JET_DRIVER_EXIT_USAGE,
        JET_DRIVER_EXIT_USER_ERROR,
    ]
    jet_foundation.[Diagnostic, diagnostic_from_registry, diagnostic_render_all]
    jet_pkg_model.[PackagePolicyException, WorkspaceDeclarationCache, pkg_lock_parse, pkg_package_facts_for_root]
    jetpack_publication.[
        PublicationAdvisory,
        publication_advisory_feed_path,
        publication_advisory_now,
        publication_advisory_trust_path,
        publication_audit_advisory_feed_with_source_exceptions,
        publication_e2610,
        publication_e2611,
        publication_parse_advisory_feed,
        publication_parse_advisory_trust,
        publication_severity_label,
    ]
}

// A value flag of `jet inspect audit`: absent, given with its value, or given
// without one.
enum JetCLIAdvisoryAuditFlag {
    Absent
    Given(value: String)
    Missing
}

// `--name <value>` or `--name=<value>` in `args`.
fn jet_cli_advisory_audit_flag(args: [String], name: String) -> JetCLIAdvisoryAuditFlag Never! {
    loop (index, word) in args {
        if word == name {
            value :: args.get(index + 1) ?? return .Missing
            if value.starts_with("-") -> return .Missing
            return .Given{value: value}
        }
        if word.starts_with("{name}=") {
            value :: word.removeprefix("{name}=")
            if value == "" -> return .Missing
            return .Given{value: value}
        }
    }
    .Absent
}

// One failed audit, as a jet.status/v1 line under `--json`.
fn jet_cli_advisory_audit_fail(diagnostic: Diagnostic, exit_code: Int, color: Bool, json: Bool) -> JetDriverVerbOutput Never! {
    diagnostics :: [Diagnostic]{diagnostic}
    if json -> return JetDriverVerbOutput{stdout: jet_cli_reports_status_json("audit", false, None, "", "", diagnostics), stderr: "", exit_code: exit_code}
    JetDriverVerbOutput{stdout: "", stderr: diagnostic_render_all("", "", diagnostics, color), exit_code: exit_code}
}

fn jet_cli_advisory_audit_fail_one(diagnostic: Diagnostic, color: Bool, json: Bool) -> JetDriverVerbOutput Never! {
    jet_cli_advisory_audit_fail(diagnostic, JET_DRIVER_EXIT_USER_ERROR, color, json)
}

fn jet_cli_advisory_audit(root: String, args: [String], color: Bool, json: Bool) -[FS, Env, Time]> JetDriverVerbOutput Never! {
    advisory_db := String?{None}
    if jet_cli_advisory_audit_flag(args, "--advisory-db") == {
        .Absent -> {}
        .Given(value) -> advisory_db = Val(value)
        .Missing -> return jet_cli_advisory_audit_usage("`--advisory-db` needs a path", JET_DRIVER_EXIT_USAGE, color, json)
    }
    explain := String?{None}
    if jet_cli_advisory_audit_flag(args, "--explain") == {
        .Absent -> {}
        .Given(value) -> explain = Val(value)
        .Missing -> return jet_cli_advisory_audit_usage("`--explain` needs an advisory id", JET_DRIVER_EXIT_USAGE, color, json)
    }
    // The package's `policy.exceptions` (its inline Package or `package.jet`);
    // a package that fails to load is its own diagnostic.
    cache := WorkspaceDeclarationCache.new()
    exceptions := [PackagePolicyException]{}
    if pkg_package_facts_for_root(&cache, root) == {
        .Val(facts) -> exceptions = facts.policy.exceptions
        .None -> {}
        .Err(error) -> return jet_cli_advisory_audit_fail_one(error.diagnostic, color, json)
    }
    lock_path :: cli_files.join(cli_files.join(root, ".jet"), "lock")
    lock_text :: cli_files.read(lock_path) ?? {
        if !cli_files.exists(lock_path) -> return jet_cli_advisory_audit_fail_one(publication_e2611("the unified lockfile", "run `jet fetch`, review the lock, then run `jet inspect audit` again"), color, json)
        return jet_cli_advisory_audit_fail_one(publication_e2611("a readable unified lockfile", "repair `{lock_path}` and run `jet inspect audit` again: {jet_cli_io_error_text(err)}"), color, json)
    }
    lock :: pkg_lock_parse(lock_text) ?? return jet_cli_advisory_audit_fail_one(publication_e2611("a valid unified lockfile", "repair `{lock_path}`: {err.message()}"), color, json)
    configured :: if advisory_db == .Val(path) -> Val(path) else -> publication_advisory_feed_path(root)
    feed_path :: configured ?? return jet_cli_advisory_audit_fail_one(publication_e2611("a signed advisory database", "pass --advisory-db <path>, set JET_ADVISORY_DB, or add .jet/advisories.db"), color, json)
    feed_text :: cli_files.read(feed_path) ?? return jet_cli_advisory_audit_fail_one(publication_e2611("a readable signed advisory database", "repair `{feed_path}` and retry: {jet_cli_io_error_text(err)}"), color, json)
    feed :: publication_parse_advisory_feed(feed_text) ?? return jet_cli_advisory_audit_fail_one(err.diagnostic, color, json)
    trust_path :: publication_advisory_trust_path(root)
    trust_text :: cli_files.read(trust_path) ?? return jet_cli_advisory_audit_fail_one(publication_e2610("advisory trust root", "could not read `{trust_path}`: {jet_cli_io_error_text(err)}"), color, json)
    trust :: publication_parse_advisory_trust(trust_text) ?? return jet_cli_advisory_audit_fail_one(err.diagnostic, color, json)
    report :: publication_audit_advisory_feed_with_source_exceptions(lock, feed, trust, publication_advisory_now(), exceptions) ?? return jet_cli_advisory_audit_fail_one(err.diagnostic, color, json)
    if explain == .Val(id) {
        loop advisory in feed.advisories {
            if advisory.id == id -> return jet_cli_advisory_audit_explain(advisory, json)
        }
        return jet_cli_advisory_audit_usage("the verified advisory feed has no advisory `{id}`", JET_DRIVER_EXIT_USER_ERROR, color, json)
    }
    diagnostics := report.maturity
    critical := 0
    loop found in report.matches {
        &diagnostics.push(found.diagnostic)
        if found.severity == .Critical -> critical += 1
    }
    failed :: critical > 0 || report.maturity.len() > 0
    exit_code :: if failed -> JET_DRIVER_EXIT_USER_ERROR else -> JET_DRIVER_EXIT_OK
    if json {
        fields :: [JetCLIStatusField]{
            jet_cli_status_field("sequence", jet_cli_status_int(report.receipt.sequence)),
            jet_cli_status_field("key_id", jet_cli_status_text(report.receipt.key_id)),
            jet_cli_status_field("digest", jet_cli_status_text(report.receipt.digest)),
            jet_cli_status_field("maturity_seconds", jet_cli_status_int(report.receipt.maturity_seconds)),
            jet_cli_status_field("dependencies", jet_cli_status_int(lock.packages.len())),
            jet_cli_status_field("source_exceptions", jet_cli_status_texts(report.source_exceptions)),
            jet_cli_status_field("matches", jet_cli_status_int(report.matches.len())),
            jet_cli_status_field("critical", jet_cli_status_int(critical)),
        }
        return JetDriverVerbOutput{stdout: "{jet_cli_status_render_with_reports("audit", !failed, jet_cli_reports_json(None, "", "", diagnostics), fields)}\n", stderr: "", exit_code: exit_code}
    }
    stdout := "audit: feed sequence {report.receipt.sequence} verified (key {report.receipt.key_id}, digest {report.receipt.digest}, offline local feed).\n"
    stdout = "{stdout}audit: policy maturity {report.receipt.maturity_seconds}s; exact exceptions use package#version; {lock.packages.len()} dependencies checked.\n"
    loop exception in report.source_exceptions -> stdout = "{stdout}audit: source policy exception applied: {exception}\n"
    if diagnostics.len() == 0 -> return JetDriverVerbOutput{stdout: "{stdout}audit: no advisories found.\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    stderr := "{diagnostic_render_all("", "", diagnostics, color)}\n{report.matches.len()} advisory match(es) found ({critical} critical)\n"
    if failed -> stderr = "{stderr}audit: policy checks failed. Upgrade the affected dependencies or wait for an approved exception.\n"
    JetDriverVerbOutput{stdout: stdout, stderr: stderr, exit_code: exit_code}
}

// `--explain <id>`: one advisory of the verified feed.
fn jet_cli_advisory_audit_explain(advisory: PublicationAdvisory, json: Bool) -> JetDriverVerbOutput Never! {
    fixed :: if advisory.fixed == .Val(version) -> "{version}" else -> "none known"
    if json {
        fields :: [JetCLIStatusField]{
            jet_cli_status_field("id", jet_cli_status_text(advisory.id)),
            jet_cli_status_field("package", jet_cli_status_text(advisory.package)),
            jet_cli_status_field("affected", jet_cli_status_text(advisory.affected.raw)),
            jet_cli_status_field("fixed", jet_cli_status_text(fixed)),
            jet_cli_status_field("severity", jet_cli_status_text(publication_severity_label(advisory.severity))),
            jet_cli_status_field("title", jet_cli_status_text(advisory.title)),
        }
        return JetDriverVerbOutput{stdout: "{jet_cli_status_render("audit.explain", true, fields)}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
    out :: "advisory {advisory.id}\n  package: {advisory.package}\n  affected: {advisory.affected.raw}\n  fixed in: {fixed}\n  severity: {publication_severity_label(advisory.severity)}\n  title: {advisory.title}\n"
    JetDriverVerbOutput{stdout: out, stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// A refused `jet inspect audit` input: a usage error (exit 2) for a flag
// without its value, a user error (exit 1) for an id the feed lacks.
fn jet_cli_advisory_audit_usage(what: String, exit_code: Int, color: Bool, json: Bool) -> JetDriverVerbOutput Never! {
    jet_cli_advisory_audit_fail(diagnostic_from_registry("E2104", None, what, jet_cli_why("E2104"), "run `jet inspect audit [--advisory-db <path>] [--explain <advisory-id>]`"), exit_code, color, json)
}
