fn usage_in(order: CLI.HelpOrder) -> String { CLI.usage_page(env.package_version(), order) }
// Rust: Source/main.rs:706
pub fn help_order(jet_argv: [String]) -> CLI.HelpOrder {
    if !jet_argv.iter().any(|arg| -> arg == "--sort" || arg.starts_with("--sort=")) { return CLI.HelpOrder.default() }
    value :: test_option_value(jet_argv, "--sort").unwrap_or_default()
    CLI.HelpOrder.parse(value).unwrap_or_else(|| -> {
        emit_cli_diagnostic_with_fix("E2104", "`{value}` is not a `jet help` order", "choose one of {CLI.HelpOrder.NAMES}: `jet help --sort az`")
        exit(ExitCodes.USAGE)
    })
}
// Rust: Source/main.rs:730
pub fn command_help(cmd: String) -> String {
    bin :: Syntax.BINARY_NAME
    if group :: CLI.command_group(cmd) {
        output := "{bin} {cmd} — {group.summary}\n\n{CLI.command_group_usage(cmd)}"
        if cmd == "db" {
            &output.push_str("\nFlags:\n")
            loop (long, help) in CLI.flags_for_command(cmd) { &output.push_str("  {long:<28} {help}\n") }
        }
        return output
    }
    if (group, action) :: CLI.moved_command(cmd) {
        lines := String.new()
        loop usage_line in action.usage.lines() { &lines.push_str("  {bin} {group.name} {usage_line}\n") }
        return "{bin} {group.name} {cmd} — {CLI.action_help_summary(group.name, action)}\n\n{lines}"
    }
    command :: match CLI.COMMANDS.iter().find(|command| -> command.name == cmd) {
        Val(command) -> command
        None -> return "{bin} {cmd}\n\nRun `{bin} help` to see every command.\n"
    }
    output := "{bin} {cmd} — {command.summary}\n\n  {CLI.command_usage(cmd)}\n"
    loop (long, help) in CLI.flags_for_command(cmd) { &output.push_str("  {long:<28} {help}\n") }
    output
}
// Rust: Source/main.rs:782
pub fn looks_like_jet_source(arg: String) -> Bool {
    path :: OSPath.from(arg)
    if path.extension().is_some_and(|e| -> e == Syntax.FILE_EXT) { return true }
    if path.exists() { return path.is_file() || path.is_dir() }
    OSPath.from("{arg}.{Syntax.FILE_EXT}").exists()
}
// Rust: Source/main.rs:799
pub fn dispatch_nixpkgs_run(raw: [String], target: String, sep: USize?) -> i32? {
    (package, source) :: target.rsplit_once(Syntax.REF_PROVIDER_AT) ?? return None
    if source != Syntax.REF_SOURCE_NIXPKGS || package.is_empty() { return None }
    before_sep :: sep.map_or(raw, |i| -> raw[..i])
    fwd := ["use", target.to_string()]
    command_args := [String]{}
    saw_run := false
    saw_target := false
    i := 0usize
    loop i < before_sep.len() {
        a :: before_sep[i]
        if !saw_run && a == "run" { saw_run = true; i += 1; continue }
        if !saw_target && a == target { saw_target = true; i += 1; continue }
        match a.as_str() {
            "--no-color" | "--offline" -> &fwd.push(a.clone())
            "--fixtures" -> {
                &fwd.push(a.clone())
                if value :: before_sep.get(i + 1) { &fwd.push(value.clone()); i += 1 }
            }
            "--color=never" -> &fwd.push("--no-color")
            s if s.starts_with("--") -> {
                emit_cli_report("E2102", "`{s}` isn't a flag `jet run …@nixpkgs` understands", "this form forwards only package-run flags before `--`; tool arguments go after `--`", "write `jet run {package}@nixpkgs -- {s}` to pass it to the tool.", false)
                return Val(ExitCodes.USAGE)
            }
            other -> &command_args.push(other.to_string())
        }
        i += 1
    }
    &fwd.push("--")
    &fwd.push(package.to_string())
    &fwd.extend(command_args)
    if i :: sep { &fwd.extend(raw[i + 1..].iter().cloned()) }
    Val(EngineDispatch.dispatch(Syntax.JETPACK_BINARY_NAME, "use", fwd))
}
// Rust: Source/main.rs:865
pub fn greeting() -> String {
    bin :: Syntax.BINARY_NAME
    output := "Welcome to {Syntax.LANG_NAME}! (v{env.package_version()})\n\nGet started:\n"
    loop command in CLI.commands_in(CLI.HelpOrder.Frequency).into_iter().filter(|command| -> command.headline) {
        invocation :: "{bin} {command.name}"
        &output.push_str("  {invocation:<12} {command.summary}\n")
    }
    help :: "{bin} help"
    &output.push_str("\n  {help:<12} see every command\n")
    output
}
// Rust: Source/main.rs:888
pub fn unknown_subcommand(cmd: String) -> Never {
    bin :: Syntax.BINARY_NAME
    fix :: match CLI.closest_command(cmd) {
        Val(close) -> "did you mean `{bin} {close}`? Run `{bin} help` to see them all."
        None -> "run `{bin} help` to see every command."
    }
    emit_cli_report("E2101", "`{cmd}` isn't a {bin} command.", "every {bin} run starts with a command like `run`, `check`, or `new`.", fix, false)
    exit(ExitCodes.USAGE)
}
