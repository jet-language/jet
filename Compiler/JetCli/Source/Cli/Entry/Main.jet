//RS             group.name,
//RS             jet::CLI::action_help_summary(group.name, action)
//RS         );
//RS     }
//RS     // A canonical flat top-level command: summary, usage, and flags all come
//RS     // from the live registry. No parsing of a second usage string.
//RS     let Some(command) = jet::CLI::COMMANDS
//RS         .iter()
//RS         .find(|command| command.name == cmd)
//RS     else {
//RS         return format!("{bin} {cmd}\n\nRun `{bin} help` to see every command.\n");
//RS     };
//RS     let mut output = format!(
//RS         "{bin} {cmd} — {}\n\n  {}\n",
//RS         command.summary,
//RS         jet::CLI::command_usage(cmd),
//RS     );
//RS     for (long, help) in jet::CLI::flags_for_command(cmd) {
