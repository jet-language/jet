// Rust: Source/main.rs:196
fn emit_cli_value_for_action(diagnostic: Diagnostic, json: Bool, action: String) -> {
    profile :: active_profile()
    if json || profile.is_some_and(|profile| -> profile.machine_enabled()) {
        report_file :: ReportPath.from_process("")
        report :: diagnostic.to_report(report_file, "")
        status :: render_status_with_reports(action, false, [report], StatusFields.new())
        rendered :: "{status}\n"
        if machine_profile :: profile.filter(|profile| -> profile.machine_enabled()) {
            write_machine(machine_profile, rendered)
        } else {
            write_mode_machine(OutputMode{json: true, color: ColorChoice.Never, quiet: false}, rendered)
        }
    } else {
        color :: profile.is_some_and(|profile| -> profile.ansi_enabled())
        rendered :: render_all_colored("", "", [diagnostic], color)
        if host_profile :: profile { write_status(host_profile, rendered) }
        else { write_mode_diagnostic(OutputMode{json: false, color: ColorChoice.Never, quiet: false}, rendered) }
    }
}
// Rust: Source/main.rs:234
pub fn emit_cli_diagnostics(file: String, source: String, diagnostics: [Diagnostic]) -> {
    profile :: active_profile()
    if profile.is_some_and(|profile| -> profile.machine_enabled()) {
        machine_file :: machine_report_path_for_process(file)
        clears :: Diagnostics.report_clear_counts(diagnostics)
        reports :: diagnostics.iter().zip(clears).map(|(diagnostic, clears)| -> diagnostic.to_report_with_clears(machine_file, source, clears))
        status :: render_status_with_reports("diagnostics", false, reports, StatusFields.new())
        rendered :: "{status}\n"
        if host_profile :: profile { write_machine(host_profile, rendered) }
        else { write_mode_machine(OutputMode{json: true, color: ColorChoice.Never, quiet: false}, rendered) }
    } else {
        color :: profile.is_some_and(|profile| -> profile.ansi_enabled())
        rendered :: render_all_colored(file, source, diagnostics, color)
        if host_profile :: profile { write_status(host_profile, rendered) }
        else { write_mode_diagnostic(OutputMode{json: false, color: ColorChoice.Never, quiet: false}, rendered) }
    }
}
