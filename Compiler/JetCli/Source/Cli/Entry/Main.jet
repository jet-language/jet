pub fn question_mark_recording_error(status: i32, code: String, what: String, fix: String, json: Bool) -> Never {
    emit_cli_report(code, what, "the requested help recording cannot be used", fix, json)
    exit(status)
}
// Rust: Source/main.rs:1769
pub fn question_mark_recording_identity(profile: OutputProfile) -> RecordingIdentity Err! {
    width :: u16.try_from(profile.width()).map_err(|_| -> "output width {profile.width()} exceeds recording limits")?
    RecordingIdentity.new("?", width, u16.try_from(QUESTION_MARK_RECORDING_HEIGHT).expect("question-mark recording height fits in u16"), profile.ansi_enabled()).map_err(|error| -> error.to_string())
}
// Rust: Source/main.rs:1784-1855
// Whole boundary function owned here; Main02 skips the initial Rust1801-1855 tail.
pub fn run_question_mark_recording(store: RecordingStore, name: String, profile: OutputProfile) -> Never {
    identity :: match question_mark_recording_identity(profile) {
        Ok(identity) -> identity
        Err(error) -> question_mark_recording_error(ExitCodes.USAGE, "E2104", "cannot create help recording identity: {error}", "use a terminal width within the recording limits", profile.machine_enabled())
    }
    replay := match HeadlessReplay.new(identity) {
        Ok(replay) -> replay
        Err(error) -> question_mark_recording_error(ExitCodes.USER_ERROR, "E3629", "could not initialize help recording: {error}", "retry the recording with the same terminal profile", profile.machine_enabled())
    }
    output :: match (&replay.capture_output()) {
        Ok(output) -> output
        Err(error) -> question_mark_recording_error(ExitCodes.USER_ERROR, "E3629", "could not capture help recording: {error}", "retry the recording", profile.machine_enabled())
    }
    recording :: replay.recording()
    path :: match store.write(name, recording) {
        Ok(path) -> path
        Err(error) -> question_mark_recording_error(ExitCodes.USER_ERROR, "E3629", "could not publish help recording: {error}", "choose a new NAME or remove the conflicting artifact", profile.machine_enabled())
    }
    artifact_id :: match recording.artifact_id() {
        Ok(artifact_id) -> artifact_id
        Err(error) -> question_mark_recording_error(ExitCodes.USER_ERROR, "E3629", "could not identify help recording: {error}", "retry the recording", profile.machine_enabled())
    }
    if profile.machine_enabled() {
        payload :: render_status("help.record", true, StatusFields.new().with("artifact", path.display().to_string()).with("artifact_id", artifact_id).with("frames", recording.events().len()))
        write_machine(profile, "{payload}\n")
    } else {
        write_renderable(profile, "{output}\n")
        write_status(profile, "recording: {path.display()}\n")
    }
    exit(ExitCodes.OK)
}
