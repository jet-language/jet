pub fn reject_retired_authority_flags(argv: [String], json: Bool) -> {
    loop argument in argv {
        head :: argument.split('=').next().unwrap_or(argument)
        retired :: BuildEffect.ALL.into_iter().find_map(|effect| -> {
            allow :: "--allow-{effect.flag()}"
            deny :: "--deny-{effect.flag()}"
            if head == allow { Val(("allow", effect)) }
            else if head == deny { Val(("deny", effect)) }
            else { None }
        })
        if retired.is_none() { continue }
        (kind, effect) :: retired.unwrap()
        emit_cli_report("E2102", "`{head}` is retired", "authority grants and denials use one comma-separated rights surface", "use `--{kind}={effect.name()}`", json)
        exit(ExitCodes.USAGE)
    }
}
// Rust: Source/main.rs:1299
pub fn parse_authority_flags(argv: [String], json: Bool) -> ([String], [String]) {
    allow := [String]{}
    deny := [String]{}
    index := 0usize
    loop index < argv.len() {
        argument :: argv[index].as_str()
        (kind, inline) :: if value :: argument.strip_prefix("--allow=") { (Val("allow"), Val(value)) }
            else if value :: argument.strip_prefix("--deny=") { (Val("deny"), Val(value)) }
            else if argument == "--allow" { (Val("allow"), None) }
            else if argument == "--deny" { (Val("deny"), None) }
            else { (None, None) }
        if kind.is_none() { index += 1; continue }
        selected_kind :: kind.unwrap()
        value :: match inline {
            Val(value) -> value.to_string()
            None -> {
                next :: argv.get(index + 1).filter(|value| -> !value.starts_with('-'))
                if next.is_none() {
                    emit_cli_report("E2104", "`--{selected_kind}` needs a comma-separated rights value", "authority is read before the program's own arguments", "use `--{selected_kind}=FS.Read,Time`", json)
                    exit(ExitCodes.USAGE)
                }
                index += 1
                next.unwrap().clone()
            }
        }
        if value.trim().is_empty() {
            emit_cli_report("E2104", "`--{selected_kind}` needs a non-empty rights value", "authority names one or more effect roots or leaves", "use `--{selected_kind}=FS.Read,Time`", json)
            exit(ExitCodes.USAGE)
        }
        loop raw_right in value.split(',') {
            right := raw_right.trim() // #4303
            canonical :: Authority.parse_right(right).unwrap_or_else(|| -> {
                emit_cli_report("E2104", "unknown authority right `{right}`", "authority names match the canonical effect roots and leaves", "use `--{selected_kind}=FS.Read,Time`", json)
                exit(ExitCodes.USAGE)
            })
            if selected_kind == "allow" {
                if !allow.iter().any(|existing| -> existing == canonical) { &allow.push(canonical) }
            } else {
                if !deny.iter().any(|existing| -> existing == canonical) { &deny.push(canonical) }
            }
        }
        index += 1
    }
    if right :: allow.iter().find(|right| -> deny.iter().any(|denied| -> denied == right)) {
        emit_cli_report("E2102", "authority right `{right}` is both allowed and denied", "the same exact effective right cannot be granted and denied in one invocation", "remove one of `--allow={right}` or `--deny={right}`", json)
        exit(ExitCodes.USAGE)
    }
    (allow, deny)
}
