            }
        }
    }
    path
}
// Rust: Source/main.rs:1472
pub fn parse_gate_flags(argv: [String], json: Bool) -> Policy.GateSet {
    gates := Policy.GateSet.default()
    index := 0usize
    loop index < argv.len() {
        argument :: argv[index]
        spec :: if spec :: argument.strip_prefix("--gate=") { Val(spec.to_string()) }
            else if argument == "--gate" {
                match argv.get(index + 1) {
                    Val(spec) if !spec.starts_with('-') -> { index += 1; Val(spec.clone()) }
                    _ -> None
                }
            } else { None }
        if assignment :: spec {
            match Policy.GateSet.parse(assignment) {
                Ok(key) -> &gates.insert(key)
                Err(detail) -> {
                    emit_cli_report("E2104", "invalid audited gate", detail, "use `--gate unsafe=allow`, `--gate impure=allow`, or `--gate nondeterministic=allow`", json)
                    exit(ExitCodes.USAGE)
                }
            }
        } else if argument == "--gate" {
            emit_cli_report("E2104", "`--gate` needs a gate assignment", "an invocation gate names one audited escape and its allow value", "use `--gate name=allow`", json)
            exit(ExitCodes.USAGE)
        }
        index += 1
    }
    gates
}
