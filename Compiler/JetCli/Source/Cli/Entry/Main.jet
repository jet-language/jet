//RS     // E2102 is an argv diagnostic, not a Jet-source diagnostic: there is no
//RS     // source file and byte span for `jet fix` to apply, so its flag suggestion
//RS     // remains prose-only until the CLI report gains an argv edit surface.
//RS     for a in raw {
//RS         if !a.starts_with("--") || a == "--" {
//RS             continue;
//RS         }
//RS         if jet::CLI::is_known_flag(a) {
//RS             continue;
//RS         }
//RS         let head = a.split('=').next().unwrap_or(a);
//RS         if external_fmt
//RS             && matches!(
//RS                 head,
//RS                 "--trust"
