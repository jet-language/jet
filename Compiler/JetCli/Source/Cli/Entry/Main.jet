pub fn named_record_for_command(argv: [String], command: String, json: Bool) -> String? {
    name := None
    loop arg in argv.iter().skip(1) {
        if arg == "--record" {
            emit_cli_diagnostic_with_fix("E2104", "`--record` needs a closed `=NAME` value", "write `--record=NAME` on `run`, `dev`, `test`, or `debug`")
            exit(ExitCodes.USAGE)
        }
        parsed :: ProveReplay.parse_record_flag(arg)
        if parsed.is_none() { continue }
        if command != "run" && command != "dev" && command != "test" && command != "debug" {
            emit_cli_diagnostic_with_fix("E2102", "`--record` is not valid with `jet {command}`", "use `--record=NAME` on `run`, `dev`, `test`, or `debug`")
            exit(ExitCodes.USAGE)
        }
        match parsed.unwrap() {
            Ok(value) -> name = Val(value)
            Err(message) -> {
                ProveReplay.emit_diag("E2104", "invalid replay name", message, "write `--record=NAME` with letters, digits, `-`, or `_`", json)
                exit(ExitCodes.USAGE)
            }
        }
    }
    name
}
