pub fn parse_setting_overrides(argv: [String], json: Bool) -> [String:String] {
    settings := [String:String]{}
    index := 0usize
    loop index < argv.len() {
        argument :: argv[index]
        raw :: if value :: argument.strip_prefix("--set=") { value.to_string() }
            else if argument == "--set" {
                match argv.get(index + 1) {
                    Val(value) -> { index += 1; value.clone() }
                    None -> {
                        emit_cli_report("E2104", "`--set` needs a key=value assignment", "a typed package setting override names one declared key and its value", "use `--set key=value`", json)
                        exit(ExitCodes.USAGE)
                    }
                }
            } else { index += 1; continue }
        (raw_key, raw_value) :: raw.split_once('=').unwrap_or_else(|| -> {
            emit_cli_report("E2104", "`--set` needs a key=value assignment", "a typed package setting override names one declared key and its value", "use `--set key=value`", json)
            exit(ExitCodes.USAGE)
        })
        key := raw_key.trim() // #4303
        if key.is_empty() {
            emit_cli_report("E2104", "`--set` needs a non-empty key", "the compiler must be able to resolve one declared setting before it parses the value", "use `--set key=value` with a declared key", json)
            exit(ExitCodes.USAGE)
        }
        value := raw_value.trim() // #4303
        if (&settings.insert(key.to_string(), value.to_string())).is_some() {
            emit_cli_report("E2104", "setting `{key}` is assigned more than once", "one invocation must contribute one unambiguous value for each declared setting", "remove the duplicate `--set` assignment", json)
            exit(ExitCodes.USAGE)
        }
        index += 1
    }
    settings
}
// Rust: Source/main.rs:1588
pub fn find_external(cmd: String) -> OSPath? {
    // Derive only one safe component, never escape a PATH entry.
    if cmd.is_empty() || cmd == "." || cmd == ".." || cmd.chars().any(|character| -> character.is_control() || character == '/' || character == '\\' || character == ':') { return None }
    exe :: "{Syntax.BINARY_NAME}-{cmd}"
    path :: env.var_os("PATH") ?? return None
    loop dir in env.split_paths(path) {
        candidate :: dir.join(exe)
        if candidate.is_file() && is_executable(candidate) { return Val(candidate) }
    }
    None
}
// Rust: Source/main.rs:1616
pub fn run_question_mark(args: [String], output: OutputAdapterHost) -> Never {
    profile :: output.profile()
    color :: profile.ansi_enabled()
    query_args := [String]{}
    record_name := None
    replay_name := None
    skip_value := false
    project_root :: build_project_root(".").unwrap_or_else(|_| -> env.current_dir().unwrap_or_else(|_| -> OSPath.from(".")))
    store :: RecordingStore.new(project_root.join(".jet").join("replays"))
    loop arg in args {
        if skip_value { skip_value = false; continue }
        if arg == "--color" { skip_value = true; continue }
        if arg == "--record" { question_mark_recording_error(ExitCodes.USAGE, "E2104", "`--record` needs a closed `=NAME` value", "use `jet ? --record=NAME`", profile.machine_enabled()) }
        if name :: arg.strip_prefix("--record=") {
            if record_name.is_some() { question_mark_recording_error(ExitCodes.USAGE, "E2104", "`jet ?` accepts only one `--record=NAME` request", "remove the duplicate recording flag", profile.machine_enabled()) }
            if store.path_for_name(name) == {
                Err(error) -> question_mark_recording_error(ExitCodes.USAGE, "E2104", "invalid recording name: {error}", "use letters, digits, `-`, or `_` in NAME", profile.machine_enabled())
                Ok(_) -> {}
            }
            record_name = Val(name.to_string())
            continue
        }
        if arg == "--replay" { question_mark_recording_error(ExitCodes.USAGE, "E2104", "`--replay` needs a closed `=NAME` value", "use `jet ? --replay=NAME`", profile.machine_enabled()) }
        if name :: arg.strip_prefix("--replay=") {
            if replay_name.is_some() { question_mark_recording_error(ExitCodes.USAGE, "E2104", "`jet ?` accepts only one `--replay=NAME` request", "remove the duplicate replay flag", profile.machine_enabled()) }
            if store.path_for_name(name) == {
                Err(error) -> question_mark_recording_error(ExitCodes.USAGE, "E2104", "invalid replay name: {error}", "use letters, digits, `-`, or `_` in NAME", profile.machine_enabled())
                Ok(_) -> {}
            }
            replay_name = Val(name.to_string())
            continue
        }
        if !arg.starts_with("--color=") && arg != "--json" && arg != "--quiet" { &query_args.push(arg.as_str()) }
    }
    if record_name.is_some() && replay_name.is_some() { question_mark_recording_error(ExitCodes.USAGE, "E2104", "`jet ?` cannot record and replay in the same request", "choose either `--record=NAME` or `--replay=NAME`", profile.machine_enabled()) }
    if (record_name.is_some() || replay_name.is_some()) && !query_args.is_empty() { question_mark_recording_error(ExitCodes.USAGE, "E2104", "a `jet ?` recording request cannot include a help query", "remove the query, or run `jet ? <query>` without recording", profile.machine_enabled()) }
    if name :: record_name { run_question_mark_recording(store, name, profile) }
    if name :: replay_name { run_question_mark_replay(store, name, profile) }
    if !query_args.is_empty() {
        query :: query_args.join(" ")
        rendered :: Help.run_query(query, color)
        write_renderable(profile, rendered)
        exit(ExitCodes.OK)
    }
    if output.help_interactive() && profile.human_enabled() {
        _ :: Help.Interactive.run(color).ok()
        exit(ExitCodes.OK)
    }
    rendered :: Help.Render.render_categorized(Help.build_index(), 0, false, None, profile.width(), color, None)
    write_renderable(profile, "{rendered}\n")
    exit(ExitCodes.OK)
}
