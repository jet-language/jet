pub fn build_grants_from_authority(allow: [String]) -> [String] {
    grants := [String:Bool]{}
    loop right in allow {
        root :: Authority.root(right)
        if effect :: BuildEffect.parse(root) { grants[effect.flag().to_string()] = true }
    }
    sorted := grants.keys().collect()
    &sorted.sort()
    sorted
}
