//RS #[derive(Clone)]
//RS pub(crate) enum BuildProfile {
//RS     /// Default `jet build` profile: opt-level=2 without cross-crate LTO, so the
//RS     /// final link compiles only the program crate against the cached runtime.
//RS     Default,
//RS     /// D-BUILD-DEFAULT1: fast `jet run`/`jet dev` profile.
//RS     Fast,
//RS     /// D-BUILDPROFILE1: `--release` / `--profile=release`. Full optimization
//RS     /// with ThinLTO across the program and its runtime rlib.
//RS     Release,
//RS     /// D-MEM-SENTRY1: release optimization with runtime sentries enabled at
//RS     /// every audited memory boundary.
//RS     Hardened,
//RS     /// D-BUILDPROFILE1: `--profile=debug`. No optimization.
//RS     Debug,
//RS     /// D-BUILDPROFILE1: `--profile=ci`. Optimized with debug symbols for CI.
//RS     Ci,
//RS     /// D-BUILDPROFILE1: user-defined or manifest-overridden profile settings.
//RS     Named { name: String, config: ProfileConfig },
//RS     /// S15: size-oriented (`opt-level=z`, fat LTO, `panic=abort`).
//RS     Small,
//RS     /// E2-M15: typed no-OS / embedded profile — only the Core layer; `panic=abort`.
//RS     NoOs,
//RS }
//RS 
//RS impl BuildProfile {
//RS     /// D-BUILD-DEFAULT1: command defaults are explicit, never ambient.
//RS     pub(crate) fn default_for_command(command: &str) -> Self {
//RS         match command {
//RS             "run" | "dev" => BuildProfile::Fast,
//RS             _ => BuildProfile::Default,
//RS         }
//RS     }
