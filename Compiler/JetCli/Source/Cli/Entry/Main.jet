// Rust: Source/main.rs:312
// GATE #4494: native terminal stdio, current executable, and child dispatch.
pub fn offer_dev_environment(raw: [String], file: String, output: OutputAdapterHost) -> {
    requirement :: project_environment_requirement(OSPath.from(file))
    if requirement.is_none() { return }
    (environment, import) :: requirement.unwrap()
    if output.profile().machine_enabled() || !output.stdin_is_terminal() || !output.stderr_is_terminal() { return }
    write_mode_diagnostic(output.mode(), "jet dev needs {environment} for `use {import}`.\nRealize it now? [Y/n]\n")
    _ :: io.stderr().flush()
    answer := String.new()
    read :: match io.stdin().read_line(&answer) { Ok(read) -> read, Err(_) -> return }
    trimmed := answer.trim() // #4303
    lowered :: trimmed.to_ascii_lowercase()
    if read == 0 || (!trimmed.is_empty() && lowered != "y" && lowered != "yes") { return }
    jet_binary :: match env.current_exe() { Ok(binary) -> binary, Err(_) -> return }
    forwarded := [String].with_capacity(raw.len() + 2)
    &forwarded.push("env")
    &forwarded.push("--")
    &forwarded.push(jet_binary.to_string_lossy().into_owned())
    &forwarded.extend(raw.iter().cloned())
    exit(EngineDispatch.dispatch(Syntax.JETPACK_BINARY_NAME, "env", forwarded))
}

