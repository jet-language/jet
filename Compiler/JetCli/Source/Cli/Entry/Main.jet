pub struct ProfileConfig {
    pub optimize: OptimizeLevel
    pub debug_info: Bool
    pub codegen_units: u16?
    pub small: Bool
    pub cross_crate_lto: Bool
    pub panic_abort: Bool
    pub inspect: Package.Blocks.ReleaseInspect
    pub settings: [String:String]
}
impl ProfileConfig {
    // Rust: Source/main.rs:406
    pub fn release() -> ProfileConfig {
        ProfileConfig{optimize: .Full, debug_info: false, codegen_units: None, small: false, cross_crate_lto: true, panic_abort: false, settings: [:], inspect: Package.Blocks.ReleaseInspect.default()}
    }
    // Rust: Source/main.rs:419
    pub fn debug() -> ProfileConfig {
        ProfileConfig{optimize: .None, debug_info: true, codegen_units: Val(256u16), small: false, panic_abort: false, cross_crate_lto: false, settings: [:], inspect: Package.Blocks.ReleaseInspect.default()}
    }
    // Rust: Source/main.rs:432
    pub fn ci() -> ProfileConfig {
        ProfileConfig{optimize: .Basic, debug_info: true, codegen_units: None, small: false, cross_crate_lto: true, panic_abort: false, settings: [:], inspect: Package.Blocks.ReleaseInspect.default()}
    }
    // Rust: Source/main.rs:445
    pub fn from_def(def: Package.BuildProfileDef) -> ProfileConfig {
        ProfileConfig{optimize: OptimizeLevel.from(def.optimize), debug_info: def.debug_info, codegen_units: None, small: def.small, cross_crate_lto: true, panic_abort: def.panic == Val(Package.BuildPanic.Abort), settings: def.settings.clone(), inspect: def.inspect}
    }
    // Rust: Source/main.rs:461
    pub fn settings_tag(self) -> String {
        parts := [self.optimize.cache_tag().to_string()]
        &parts.push("inspect:{self.inspect.cfg_value()}")
        if self.debug_info { &parts.push("dbg") }
        if self.small { &parts.push("small") }
        if !self.cross_crate_lto { &parts.push("lto=off") }
        if self.panic_abort { &parts.push("panic=abort") }
        if units :: self.codegen_units { &parts.push("codegen-units={units}") }
        if !self.settings.is_empty() {
            keys := self.settings.keys().collect()
            &keys.sort()
            encoded :: keys.iter().map(|key| -> "{key.len()}:{key}{self.settings[key].len()}:{self.settings[key]}").collect<[String]>().join("")
            &parts.push("settings:{encoded}")
        }
        parts.join(";")
    }
    // Rust: Source/main.rs:493
    pub fn rustc_args(self, ffi: Bool) -> [String] { self.rustc_args_for_target(ffi, false) }
    // Rust: Source/main.rs:500
    // Foreign compiler argument data retained for explicit foreign-tool output;
    // native profile execution consumes the typed config, never a Rust callback.
    pub fn rustc_args_for_target(self, ffi: Bool, native: Bool) -> [String] {
        args := [String]{}
        if self.small {
            &args.extend(["-C", "opt-level=z", "-C", "panic=abort", "-C", "strip=symbols"])
            if !ffi { &args.extend(["-C", "lto=fat"]) }
            if native { &args.extend(["-C", "target-cpu=native"]) }
            return args
        }
        if units :: self.codegen_units { &args.extend(["-C", "codegen-units={units}"]) }
        match self.optimize {
            .None -> { &args.extend(["-C", "opt-level=0", "-C", "lto=off"]) }
            .Basic -> { &args.extend(["-C", "opt-level=2"]) }
            .Full -> { &args.extend(["-C", "opt-level=3"]) }
        }
        if self.debug_info { &args.extend(["-C", "debuginfo=2"]) }
        else if self.optimize != .None { &args.extend(["-C", "strip=symbols"]) }
        if self.panic_abort { &args.extend(["-C", "panic=abort"]) }
        if !ffi && self.optimize != .None {
            lto :: if self.cross_crate_lto { "lto=thin" } else { "lto=off" }
            &args.extend(["-C", lto.to_string()])
        }
        if native { &args.extend(["-C", "target-cpu=native"]) }
        args
    }
}

