//RS                     | "--online"
//RS                     | "--no-color"
//RS                     | "--json"
//RS                     | "--flake"
//RS                     | "--pure"
//RS                     | "--yes"
//RS                     | "--fixtures"
//RS                     | "--preset"
//RS                     | "--env"
//RS             )
//RS         {
//RS             continue;
//RS         }
//RS         if head == "--emit-rust" {
//RS             emit_cli_report(
//RS                 "E2102",
//RS                 format!("`--emit-rust` isn't a flag {bin} understands"),
//RS                 "generated output belongs to the `emit` command".to_string(),
//RS                 format!("run `{bin} emit --rust <file.{}>`", jet::Syntax::FILE_EXT),
//RS                 false,
//RS             );
//RS             exit(ExitCodes::USAGE);
//RS         }
//RS         let fix = match jet::CLI::closest_flag(head) {
//RS             Some(close) if matches!(subcmd, "run" | "test") => format!(
//RS                 "did you mean `{close}`? Or use `{bin} {subcmd} <file> -- {head}` to pass it to your program"
//RS             ),
//RS             Some(close) if subcmd == jet::CLI::JOBS_COMMAND => format!(
//RS                 "did you mean `{close}`? Or write it after the job name, `{bin} {subcmd} <name> {head}`, to pass it to the job"
//RS             ),
//RS             Some(close) => format!("did you mean `{close}`? (run `{bin} help` for the flags)"),
