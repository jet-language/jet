pub enum BuildProfile { Default, Fast, Release, Hardened, Debug, Ci, Named(name: String, config: ProfileConfig), Small, NoOs }
impl BuildProfile {
    // Rust: Source/main.rs:588
    pub fn default_for_command(command: String) -> BuildProfile {
        match command { "run" | "dev" -> .Fast, _ -> .Default }
    }
    // Rust: Source/main.rs:595
    pub fn is_release(self) -> Bool {
        match self { .Release | .Hardened -> true, .Named(name, _) -> name == Syntax.BUILD_PROFILE_RELEASE, _ -> false }
    }
    // Rust: Source/main.rs:605
    pub fn cranelift_backend(self) -> Bool {
        match self { .Default | .Fast | .Debug -> true, _ -> false }
    }
    // Rust: Source/main.rs:609
    pub fn release_inspect(self) -> Package.Blocks.ReleaseInspect? {
        if self.is_release() { Val(self.config().inspect) } else { None }
    }
    // Rust: Source/main.rs:616
    pub fn budget_name(self) -> String {
        match self { .Default | .Fast -> "dev", .Release -> "release", .Hardened -> "hardened", .Debug -> "debug", .Ci -> "ci", .Named(name, _) -> name, .Small -> "small", .NoOs -> "no-os" }
    }
    // Rust: Source/main.rs:630
    pub fn cache_tag(self) -> String {
        match self { .Default -> "default", .Fast -> "fast", .Release -> "release", .Hardened -> "hardened", .Debug -> "debug", .Ci -> "ci", .Named(name, config) -> "profile:{name};{config.settings_tag()}", .Small -> "small", .NoOs -> "no-os" }
    }
    // Rust: Source/main.rs:646
    pub fn config(self) -> ProfileConfig {
        match self {
            .Default -> ProfileConfig{optimize: .Basic, debug_info: false, codegen_units: None, small: false, cross_crate_lto: false, panic_abort: false, settings: [:], inspect: Package.Blocks.ReleaseInspect.default()}
            .Fast -> ProfileConfig{optimize: .None, debug_info: false, codegen_units: Val(256u16), small: false, cross_crate_lto: false, panic_abort: false, settings: [:], inspect: Package.Blocks.ReleaseInspect.default()}
            .Release | .Hardened -> ProfileConfig.release()
            .Debug -> ProfileConfig.debug()
            .Ci -> ProfileConfig.ci()
            .Named(_, config) -> config.clone()
            .Small | .NoOs -> ProfileConfig{optimize: .Basic, debug_info: false, codegen_units: None, small: true, cross_crate_lto: false, panic_abort: true, settings: [:], inspect: Package.Blocks.ReleaseInspect.default()}
        }
    }
}

// Rust: Source/main.rs:696
pub fn usage() -> String { usage_in(CLI.HelpOrder.default()) }
