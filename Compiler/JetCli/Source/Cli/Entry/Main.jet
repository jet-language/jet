pub fn normalize_compiler_alias(raw: &[String], argv0: String) -> {
    name :: OSPath.from(argv0).file_name().and_then(|name| -> name.to_str()) ?? return
    bare :: name.strip_suffix(".exe").unwrap_or(name)
    verb :: match bare { "jet-cc" -> "cc", "jet-cxx" | "jet-c++" -> "c++", _ -> return }
    &raw.insert(0, verb.to_string())
}
// Rust: Source/main.rs:919
pub fn normalize_frequency_ring_argv(raw: &[String], mode: OutputMode, profile: OutputProfile) -> {
    if retired :: CLI.retired_command(raw) {
        category :: retired.category
        rewrite :: retired.rewrite
        if category == CLI.RetirementCategory.Semantic { teach_retired(retired, raw, mode.json) }
        apply :: rewrite.expect("rename retirement needs a rewrite rule")
        replacement :: retired.fix(raw)
        raw = apply(raw)
        if !mode.json && !mode.quiet { write_status(profile, "Notice: `{retired.spelling}` is now `{replacement}`.\n") }
    }
    first :: raw.first().map(|s| -> s.as_str()) ?? return
    if (group_spec, _) :: CLI.moved_command(first) {
        group :: group_spec.name
        verb :: first
        replacement :: "jet {group} {raw.join(" ")}"
        emit_cli_report("E2101", "`{verb}` moved under `jet {group}`.", "infrequent commands live in a named area so daily Jet commands stay easy to scan.", "run `{replacement}`.", mode.json)
        exit(ExitCodes.USAGE)
    }
    group :: raw.first().cloned() ?? return
    // os is non-exhaustive: real native jetos verbs remain opaque to this registry.
    exhaustive :: CLI.command_group(group).map(|spec| -> spec.exhaustive).unwrap_or(false)
    if spec :: CLI.command_group(group) {
        asks_help :: if group == "env" {
            raw.get(1).map(|s| -> s.as_str()) == Val("help") || raw.get(1).is_some_and(|a| -> CLI.is_help_flag(a))
        } else {
            raw.len() == 1 || raw.get(1).map(|s| -> s.as_str()) == Val("help") || raw.get(1).is_some_and(|a| -> CLI.is_help_flag(a))
        }
        if (exhaustive || group == "env") && asks_help {
            help :: "jet {group} — {spec.summary}\n{CLI.command_group_usage(group)}"
            write_renderable(profile, help)
            exit(ExitCodes.OK)
        }
    }
    sub :: raw.get(1).cloned() ?? return
    if exhaustive && CLI.nested_command(group, sub).is_none() {
        emit_cli_report("E2101", "`{sub}` isn't a jet {group} command.", "jet {group} accepts only commands in its named area.", "run `jet {group} help`.", mode.json)
        exit(ExitCodes.USAGE)
    }
    if (_, action) :: CLI.nested_command(group, sub) {
        if !action.handler.keeps_group() { raw[0] = action.handler.dispatch_word().to_string(); &raw.remove(1) }
    }
}
// Rust: Source/main.rs:1011
pub fn run_project_parts(raw: [String], profile: OutputProfile) -> Never {
    skipped_only :: raw.iter().any(|arg| -> arg == "--skipped")
    root :: env.current_dir().unwrap_or_else(|_| -> OSPath.from("."))
    (report, failures) :: ProjectParts.scan_with_diagnostics(root, [])
    if failure :: failures.iter().find(|failure| -> failure.authority) {
        emit_cli_value(failure.problem.clone(), profile.machine_enabled())
        exit(ExitCodes.USER_ERROR)
    }
    parts :: report.parts.iter().filter(|part| -> !skipped_only || part.state == ProjectParts.ProjectPartState.Skipped).collect()
    source_files :: if skipped_only { [] } else { report.source_files.iter().collect() }
    // Rust: Source/main.rs:1029
    relative :: |path: OSPath| -> path.strip_prefix(root).unwrap_or(path).to_string_lossy().replace('\\', "/")
    // Rust: Source/main.rs:1035
    source_name :: |path: OSPath| -> {
        name := relative(path)
        extension :: ".{Syntax.FILE_EXT}"
        if name.ends_with(extension) { &name.truncate(name.len() - extension.len()) }
        "{Syntax.PROJECT_IMPORT_PREFIX}{name.replace('/', ".")}"
    }
    if profile.machine_enabled() {
        part_values := [StatusValue].with_capacity(parts.len() + source_files.len())
        &part_values.extend(parts.iter().map(|part| -> StatusValue.object(StatusFields.new().with("name", part.canonical_name()).with("path", relative(part.path)).with("state", part.state.name()))))
        &part_values.extend(source_files.iter().map(|path| -> StatusValue.object(StatusFields.new().with("name", source_name(path)).with("path", relative(path)).with("state", "automatic"))))
        conflict_values :: report.conflicts.iter().map(|conflict| -> StatusValue.object(StatusFields.new().with("name", conflict.canonical_name()).with("paths", StatusValue.array(conflict.paths.iter().map(|path| -> StatusValue.from(relative(path)))))))
        payload :: render_status("inspect.parts", true, StatusFields.new().with("parts", StatusValue.array(part_values)).with("conflicts", StatusValue.array(conflict_values)))
        write_machine(profile, "{payload}\n")
    } else if profile.unicode_enabled() {
        columns :: [TableColumn.new("state", TableCellKind.Text), TableColumn.new("name", TableCellKind.Text), TableColumn.new("path", TableCellKind.Text)]
        rows := [TableRow].with_capacity(parts.len() + source_files.len())
        &rows.extend(parts.iter().map(|part| -> TableRow.new([TableCell.text(part.state.name()), TableCell.text(part.canonical_name()), TableCell.text(relative(part.path))])))
        &rows.extend(source_files.iter().map(|path| -> TableRow.new([TableCell.text("automatic"), TableCell.text(source_name(path)), TableCell.text(relative(path))])))
        table :: AdaptiveTable.new(columns, rows)
        if rendered :: table.layout(profile).render() { write_renderable(profile, "{rendered}\n") }
        loop conflict in report.conflicts {
            rendered :: render_diagnostics("", "", [conflict.diagnostic(root, None)])
            write_status(profile, rendered)
        }
    } else {
        rendered := String.new()
        loop part in parts { &rendered.push_str("{part.state.name():<9} {part.canonical_name():<24} {relative(part.path)}\n") }
        loop path in source_files { &rendered.push_str("{"automatic":<9} {source_name(path):<24} {relative(path)}\n") }
        write_renderable(profile, rendered)
        loop conflict in report.conflicts {
            rendered :: render_diagnostics("", "", [conflict.diagnostic(root, None)])
            write_status(profile, rendered)
        }
    }
    exit(if report.conflicts.is_empty() { ExitCodes.OK } else { ExitCodes.USER_ERROR })
}
