pub fn teach_retired(spec: CLI.RetiredCommandSpec, raw: [String], json: Bool) -> Never {
    debug_assert_eq(spec.category, CLI.RetirementCategory.Semantic)
    emit_cli_report(spec.error_code, "`{spec.spelling}` isn't a jet command", spec.why.to_string(), "run `{spec.fix(raw)}`", json)
    exit(ExitCodes.USAGE)
}
// Rust: Source/main.rs:1177
pub fn check_flags(raw: [String], subcmd: String) -> {
    bin :: Syntax.BINARY_NAME
    external_fmt :: subcmd == "fmt" && raw.iter().any(|arg| -> arg == Syntax.FMT_FLAG_LANG || arg.starts_with("--lang="))
    // argv-only teaching copy has no source span or fix_edits.
    loop a in raw {
        if !a.starts_with("--") || a == "--" { continue }
        if CLI.is_known_flag(a) { continue }
        head :: a.split('=').next().unwrap_or(a)
        if external_fmt && ["--trust", "--offline", "--online", "--no-color", "--json", "--flake", "--pure", "--yes", "--fixtures", "--preset", "--env"].contains(head) { continue }
        if head == "--emit-rust" {
            emit_cli_report("E2102", "`--emit-rust` isn't a flag {bin} understands", "generated output belongs to the `emit` command", "run `{bin} emit --rust <file.{Syntax.FILE_EXT}>`", false)
            exit(ExitCodes.USAGE)
        }
        fix :: match CLI.closest_flag(head) {
            Val(close) if subcmd == "run" || subcmd == "test" -> "did you mean `{close}`? Or use `{bin} {subcmd} <file> -- {head}` to pass it to your program"
            Val(close) if subcmd == CLI.JOBS_COMMAND -> "did you mean `{close}`? Or write it after the job name, `{bin} {subcmd} <name> {head}`, to pass it to the job"
            Val(close) -> "did you mean `{close}`? (run `{bin} help` for the flags)"
            None if subcmd == "run" || subcmd == "test" -> "use `{bin} {subcmd} <file> -- {head}` to pass this flag to your program"
            None if subcmd == CLI.JOBS_COMMAND -> "write it after the job name, `{bin} {subcmd} <name> {head}`, to pass it to the job"
            None -> "drop the flag, or run `{bin} help` to see the flags"
        }
        emit_cli_report("E2102", "`{head}` isn't a flag {bin} understands", "flags before `--` belong to {bin}; everything after `--` is forwarded to your program", fix, false)
        exit(ExitCodes.USAGE)
    }
}
