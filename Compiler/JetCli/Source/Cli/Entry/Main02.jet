// Rust: Source/main.rs:1857
pub fn run_question_mark_replay(store: &Recording.RecordingStore, name: String, profile: OutputProfile) -> Never {
    recording :: store.read(name).unwrap_or_else(fn(error) -> question_mark_recording_error(
        ExitCodes.USER_ERROR, "E3622", "could not read help replay `{name}`: {error}",
        "pass an intact `.jetproof-replay` TUI recording", profile.machine_enabled()))
    if recording.identity().command != "?" {
        question_mark_recording_error(ExitCodes.USER_ERROR, "E3621",
            "help replay `{name}` targets `{recording.identity().command}` instead of `jet ?`",
            "record the help palette with `jet ? --record=NAME`", profile.machine_enabled())
    }
    expected_frame :: recording.events().iter().rev().find_map(fn(event) -> match event {
        Recording.RecordingEvent.Frame{text, ..} -> Some(Tape.normalize_terminal_text(text))
        _ -> None
    })
    tape :: recording.interaction_tape().unwrap_or_else(fn(error) -> question_mark_recording_error(
        ExitCodes.USER_ERROR, "E3622", "help replay `{name}` has unsupported input: {error}",
        "record the help palette through the headless TUI seam", profile.machine_enabled()))
    replay := Headless.HeadlessReplay.new(recording.identity().clone()).unwrap_or_else(fn(error) ->
        question_mark_recording_error(ExitCodes.USER_ERROR, "E3622",
            "could not initialize help replay `{name}`: {error}",
            "record the help palette with a valid terminal identity", profile.machine_enabled()))
    run :: &replay.replay(tape).unwrap_or_else(fn(error) -> question_mark_recording_error(
        ExitCodes.USER_ERROR, "E3623", "help replay `{name}` diverged: {error}",
        "recapture the help palette with `jet ? --record=NAME`", profile.machine_enabled()))
    output :: Tape.normalize_terminal_text(replay.driver().render().text)
    if expected_frame != Some(output) {
        question_mark_recording_error(ExitCodes.USER_ERROR, "E3623",
            "help replay `{name}` final frame differs from its recording",
            "recapture the help palette with `jet ? --record=NAME`", profile.machine_enabled())
    }
    path :: store.path_for_name(name).unwrap_or_else(fn(error) -> question_mark_recording_error(
        ExitCodes.USAGE, "E2104", "invalid replay name: {error}",
        "use letters, digits, `-`, or `_` in NAME", profile.machine_enabled()))
    artifact_id :: recording.artifact_id().unwrap_or_else(fn(error) -> question_mark_recording_error(
        ExitCodes.USER_ERROR, "E3622", "could not identify help replay `{name}`: {error}",
        "pass an intact `.jetproof-replay` TUI recording", profile.machine_enabled()))
    if profile.machine_enabled() {
        payload :: render_status("help.replay", true, StatusFields.new().with("artifact", path.display().to_string())
            .with("artifact_id", artifact_id).with("steps", run.steps_executed))
        write_machine(profile, "{payload}\n")
    } else { write_renderable(profile, "{output}\n") }
    exit(ExitCodes.OK)
}

// Rust: Source/main.rs:1971
pub fn is_executable(p: OSPath) -> Bool {
    if selected_family() == "unix" {
        fs.metadata(p).map(fn(m) -> m.permissions().mode() & 0o111 != 0).unwrap_or(false)
    } else { p.is_file() }
}

// Rust: Source/main.rs:1984
pub fn parse_target_flag(argv: [String]) -> String? Err! {
    index := 0
    loop index < argv.len() {
        arg :: argv[index]
        if arg.strip_prefix("--target=") is Some(value) {
            if value.is_empty() { return Err(()) }
            return Ok(Some(value.to_string()))
        }
        if arg == "--target" {
            return argv.get(index + 1).filter(fn(value) -> !value.starts_with('-')).map(fn(value) -> Some(value))
                .ok_or(())
        }
        index += 1
    }
    Ok(None)
}

