            argument :: args.get(1).unwrap_or_else(fn() -> {
                emit_cli_diagnostic("E2104", "`jet eval` needs a file or an expression: {jet.Syntax.BINARY_NAME} eval <file.{jet.Syntax.FILE_EXT} | expression>")
                exit(ExitCodes.USAGE)
            })
            if looks_like_jet_source(argument) { run_eval(resolve_source_path(argument), pure_flag, mode); return true }
            if argument.starts_with(':') {
                cli_error_fix("E2104", "`{argument}` is a {jet.Syntax.BINARY_NAME} command, not an expression",
                    "run `{jet.Syntax.BINARY_NAME} repl` for an interactive session, or pass an expression such as `1 + 2`")
                exit(ExitCodes.USAGE)
            }
