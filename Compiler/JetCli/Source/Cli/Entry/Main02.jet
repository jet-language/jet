pub fn invalid_repl_console_flag(argv: [String]) -> String? {
    argv.iter().find(fn(argument) -> (argument.starts_with("--console") && argument != "--console"
        && argument != "--console-ttl" && !argument.starts_with("--console-ttl="))
        || (argument.starts_with("--sandbox") && argument != "--sandbox" && !argument.starts_with("--sandbox=")))
}

