pub fn console_requested(argv: [String]) -> Bool {
    argv.iter().any(fn(argument) -> ["--console", "--sandbox", "--console-ttl"].contains(argument)
        || argument.starts_with("--sandbox=") || argument.starts_with("--console-ttl="))
}

