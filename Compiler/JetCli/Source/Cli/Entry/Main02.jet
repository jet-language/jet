            run_fix(target, dry_run, edition, jet_argv.iter().any(fn(a) -> a == "--all"), mode)
        }),
        (["new"], fn() -> {
            if args.get(1).is_some_and(fn(kind) -> ["service", "route", "job", "migration"].contains(kind)) {
                kind :: args.get(1).unwrap_or_default()
                name :: args.get(2).unwrap_or_else(fn() -> {
                    cli_error_fix("E2104", "`jet new {kind}` needs a name", "run `jet new {kind} <name> --preview`")
                    exit(ExitCodes.USAGE)
                })
                run_new_backend(kind, name, jet_argv, mode)
                return
            }
            name :: args.get(1).unwrap_or_else(fn() -> {
                cli_error_fix("E2104", "`jet new` needs a project name", "run `jet new my_app`")
                exit(ExitCodes.USAGE)
            })
            template :: if jet_argv.iter().any(fn(arg) -> arg == "--template" || arg.starts_with("--template=")) {
                value :: test_option_value(jet_argv, "--template").unwrap_or_default()
                Some(CmdCompile.NewTemplate.parse(value).unwrap_or_else(fn() -> {
                    cli_error_fix("E2104", "`{value}` is not a `jet new` template",
                        "choose one of {CmdCompile.NewTemplate.NAMES}: `jet new {name} --template ui`")
                    exit(ExitCodes.USAGE)
                }))
            } else { None }
            run_new(name, annotated, template, mode)
