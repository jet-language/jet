        .or_else(fn() -> flag_value(argv, flag))
}

// Rust: Source/main.rs:2270
pub fn console_sandbox(argv: [String]) -> Bool Err! {
    sandbox := false
    index := 0
    loop index < argv.len() {
        argument :: argv[index]
        value :: if argument == "--sandbox" {
            index += 1
            argv.get(index).ok_or("`--sandbox` needs `data`")?
        } else if argument.strip_prefix("--sandbox=") is Some(value) { value } else {
            index += 1
            continue
        }
        if value != "data" { return Err("unknown console sandbox `{value}`; use `--sandbox data`") }
        sandbox = true
        index += 1
    }
    Ok(sandbox)
}

// Rust: Source/main.rs:2297
pub fn console_rights(sandbox: Bool, authority_allow: [String], authority_deny: [String]) -> ([String], [String]) {
    allow := ["IO", "Mem.Alloc"]
    if sandbox { &allow.push("DB.Write") }
    &allow.extend(authority_allow)
    (allow, authority_deny.to_vec())
}

// Rust: Source/main.rs:2310
pub fn console_output_kind(kind: ConsoleOutputKind) -> String {
    match kind {
        ConsoleOutputKind.Startup -> "startup"
        ConsoleOutputKind.Evaluation -> "evaluation"
        ConsoleOutputKind.Request -> "request"
        ConsoleOutputKind.Data -> "data"
        ConsoleOutputKind.Grant -> "grant"
        ConsoleOutputKind.Capabilities -> "capabilities"
        ConsoleOutputKind.Bindings -> "bindings"
        ConsoleOutputKind.Audit -> "audit"
        ConsoleOutputKind.History -> "history"
        ConsoleOutputKind.Sandbox -> "sandbox"
        ConsoleOutputKind.Commit -> "commit"
        ConsoleOutputKind.Rollback -> "rollback"
        ConsoleOutputKind.Cancelled -> "cancelled"
        ConsoleOutputKind.Error -> "error"
        ConsoleOutputKind.Goodbye -> "goodbye"
    }
}

// Rust: Source/main.rs:2330
pub fn console_output(mode: OutputMode, output: &REPL.ConsoleOutput) -> {
    if mode.json {
        payload :: JSON.parse(output.payload).and_then(fn(value) -> StatusValue.from_data_tree(value))
            .unwrap_or_else(fn(_) -> StatusValue.String(output.payload.clone()))
        console :: StatusValue.object(StatusFields.new().with("protocol", "jet.console.v1")
            .with("sequence", output.sequence).with("session_id", output.session_id)
            .with("kind", console_output_kind(output.kind)).with("ok", output.ok)
            .with("message", output.message).with("payload", payload)
            .with("request_id", job_status_optional_string(output.request_id))
            .with("transaction_id", job_status_optional_string(output.transaction_id)).with("truncated", output.truncated))
        payload :: render_status("repl", output.ok, StatusFields.new().with("console", console))
        write_mode_machine(mode, "{payload}\n")
    } else { write_mode_renderable(mode, "{output.message}\n{output.payload}\n") }
}

// Rust: Source/main.rs:2365
pub fn console_error_code(error: &ConsoleError) -> String {
    match error {
        ConsoleError.ReleaseUnavailable -> "E2105"
        ConsoleError.Denied{..} | ConsoleError.Expired | ConsoleError.NonLoopbackDenied -> "E1803"
        ConsoleError.ProjectUnavailable(_) | ConsoleError.InvalidInput(_) | ConsoleError.InvalidRequest(_)
            | ConsoleError.UnknownCommand(_) | ConsoleError.ConfirmationRequired(_) -> "E2104"
        _ -> "E2105"
    }
}

// Rust: Source/main.rs:2380
pub fn run_console(project_dir: String?, argv: [String], mode: OutputMode, authority_allow: [String],
    authority_deny: [String], gates: GateSet, profile: String?, setting_overrides: [String:String]) -> I32 {
    sandbox :: match console_sandbox(argv) {
        Ok(sandbox) -> sandbox
        Err(message) -> { emit_cli_diagnostic("E2104", message); return ExitCodes.USAGE }
    }
    root :: OSPath.from(project_dir.unwrap_or("."))
    member :: flag_value(argv, "-p")
    entry :: resolve_bare_entry("run", root, member, mode, true).unwrap_or_else(fn() -> missing_bare_entry("run", root, mode))
    file :: entry.path.to_string_lossy().into_owned()
    entry_fn :: entry.callable
    snapshot :: match Store.read_authority_file(entry.path) {
        Ok(snapshot) -> snapshot
        Err(error) -> { emit_cli_diagnostic("E2105", "can't securely read console entry `{file}`: {error}"); return ExitCodes.USER_ERROR }
    }
    source :: match snapshot.text() {
        Ok(source) -> source.to_owned()
        Err(error) -> { emit_cli_diagnostic("E2105", "can't read console entry `{file}`: {error}"); return ExitCodes.USER_ERROR }
    }
    source_identity :: snapshot.path().to_path_buf()
    // Compiler stack owner replaces the retired JIT stack wrapper; no JIT execution.
    source_closure :: match jet.run_compiler_work(fn() ->
        Driver.load_immutable_source_closure(file, [(source_identity, source)])) {
        Ok(source_closure) -> source_closure
        Err(diagnostics) -> { emit_cli_diagnostics(file, source, diagnostics); return ExitCodes.USER_ERROR }
    }
    project := match ConsoleProject.from_root(root.clone()) {
        Ok(project) -> project
        Err(error) -> { emit_cli_diagnostic(console_error_code(error), error.to_string()); return ExitCodes.USER_ERROR }
    }
    package_facts :: match jet.run_compiler_work(fn() -> Loader.package_facts_for_root(root)) {
        Ok(package_facts) -> package_facts
        Err(diagnostics) -> { emit_cli_diagnostics(file, source, diagnostics); return ExitCodes.USER_ERROR }
    }
    if package_facts is Some(facts) {
        service_names :: facts.services.keys().sorted()
        loop name in service_names {
            fact :: facts.services[name]
            state :: if fact.enable { "enabled" } else { "disabled" }
            identity :: "{project.identity.project_id}:service:{name}"
            handle :: match REPL.ConsoleServiceHandle.new(name, identity, state) {
                Ok(handle) -> handle
                Err(error) -> { emit_cli_diagnostic(console_error_code(error), error.to_string()); return ExitCodes.USER_ERROR }
            }
            if &project.add_service(handle) is Err(error) {
                emit_cli_diagnostic(console_error_code(error), error.to_string())
                return ExitCodes.USER_ERROR
            }
        }
    }
    (allow, deny) :: console_rights(sandbox, authority_allow, authority_deny)
    application_authority :: if !authority_allow.is_empty() || !authority_deny.is_empty() {
        Some(Authority.ApplicationAuthority.from_policy(Some(authority_allow), Some(authority_deny), "console invocation"))
    } else { None }
    profile :: profile.unwrap_or("dev").to_owned()
    settings :: setting_overrides.clone()
    boot :: match Interpreter.boot_console_with_source_closure(file, source_closure, gates, profile, settings,
        application_authority, entry_fn) {
        Ok(boot) -> boot
        Err(diagnostics) -> { emit_cli_diagnostics(file, source, diagnostics); return ExitCodes.USER_ERROR }
    }
    CmdDevTools.render_lints(file, mode, boot.lints)
    ttl_ms :: match console_flag_value(argv, "--console-ttl") {
        Some(value) -> match value.parse[U64]() {
            Ok(ttl_ms) -> Some(ttl_ms)
            Err(_) -> {
                emit_cli_diagnostic("E2104", "`--console-ttl` needs an integer number of milliseconds")
                return ExitCodes.USAGE
            }
        }
        None -> None
    }
    jet.run_compiler_work(fn() -> {
        lease := boot.lease
        if !lease.startup_stdout().is_empty() { write_mode_renderable(mode, lease.startup_stdout()) }
        if !lease.startup_stderr().is_empty() { write_mode_diagnostic(mode, lease.startup_stderr()) }
        host := ConsoleHost.new().with_router(lease.router())
        loop resource in &lease.take_database_resources() {
            host = match host.with_database_resource(resource) {
                Ok(host) -> host
                Err(error) -> { emit_cli_diagnostic(console_error_code(error), error.to_string()); return ExitCodes.USER_ERROR }
            }
        }
        loop binding in &lease.take_service_bindings() {
            host = match host.with_service_binding(binding) {
                Ok(host) -> host
                Err(error) -> { emit_cli_diagnostic(console_error_code(error), error.to_string()); return ExitCodes.USER_ERROR }
            }
        }
        project :: match &host.attach_project(project) {
            Ok(project) -> project
            Err(error) -> { emit_cli_diagnostic(console_error_code(error), error.to_string()); return ExitCodes.USER_ERROR }
        }
        options := ConsoleOptions.new(project).with_mode(if sandbox { ConsoleMode.SandboxData } else { ConsoleMode.ReadOnly })
            .with_rights(allow).with_denied(deny).release_build(!env.debug_assertions())
        if ttl_ms is Some(value) { options = options.with_ttl_ms(value) }
        session := match &host.open(options) {
            Ok(session) -> session
            Err(error) -> { emit_cli_diagnostic(console_error_code(error), error.to_string()); return ExitCodes.USER_ERROR }
        }
        stdin :: io.stdin()
        input := stdin.lock()
        line := String.new()
        code := ExitCodes.OK
        loop {
            &line.clear()
            bytes :: match &input.read_line(&line) {
                Ok(bytes) -> bytes
                Err(error) -> {
                    emit_cli_diagnostic("E2105", "console input read failed: {error}")
                    code = ExitCodes.USER_ERROR
                    break
                }
            }
            if bytes == 0 { break }
            match &session.run_line(line.trim_end_matches(['\r', '\n'])) {
                Ok(output) -> {
                    console_output(mode, output)
                    if output.kind is ConsoleOutputKind.Goodbye | ConsoleOutputKind.Cancelled { break }
                }
                Err(error) -> {
                    emit_cli_diagnostic(console_error_code(error), error.to_string())
                    code = ExitCodes.USER_ERROR
                    if error is ConsoleError.Closed | ConsoleError.Cancelled { break }
                }
            }
        }
        if !session.is_closed() {
            if &session.close() is Ok(output) { console_output(mode, output) }
        }
        code
    })
}

// Rust: Source/main.rs:2618
pub fn run() -> {
    Diagnostics.install_ice_panic_hook()
    if jetpack.ToolchainUpdate.windows_update_helper_requested() { exit(jetpack.ToolchainUpdate.run_windows_update_helper()) }
    jet.boot_mir_eval()
    argv := env.args()
