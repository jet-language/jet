        (["debug"], fn() -> Bool {
            raw_frames :: raw.iter().any(fn(a) -> a == "--raw-frames")
            dap :: raw.iter().any(fn(a) -> a == "--dap")
            file :: match args.get(1) {
                Some(f) -> resolve_command_target("debug", f, flag_value(jet_argv, "-p"), mode, false).path.to_string_lossy().into_owned()
                None -> {
                    cwd :: env.current_dir().unwrap_or_else(fn(_) -> OSPath.from("."))
                    entry :: resolve_bare_entry("debug", cwd, flag_value(jet_argv, "-p"), mode, false).unwrap_or_else(fn() -> {
                        emit_cli_diagnostic("E2104", "`jet debug` needs a file to debug: {jet.Syntax.BINARY_NAME} debug <file.{jet.Syntax.FILE_EXT}>")
                        exit(ExitCodes.USAGE)
                    })
                    entry.path.to_string_lossy().into_owned()
                }
            }
            resolved :: resolve_source_path(file)
            if record_name.is_some() && debug_replay.is_some() {
                ProveReplay.emit_diag("E2104", "debug accepts either recording or replay",
                    "`--record` and `--replay` cannot be used in the same debug session", "choose one of `--record=NAME` or `--replay=NAME`", mode.json)
                exit(ExitCodes.USAGE)
            }
            if dap && debug_replay.is_some() {
                ProveReplay.emit_diag("E2203", "replay debugging is unavailable for native sessions",
                    "the native LLDB/DAP backend cannot browse an interpreter recording",
                    "replay an interpreter receipt without `--dap` or native-only source features", mode.json)
                exit(ExitCodes.USER_ERROR)
            }
            // Validate receipt identity before selecting a live native backend.
            replay :: debug_replay.map(fn(path) -> ProveReplay.open_named_replay(resolved, path, named_profile.unwrap_or("dev"), setting_overrides, mode.json)
                .unwrap_or_else(fn(status) -> exit(status)))
            use_native :: dap || (replay.is_none() && jet.Debug.needs_native(resolved).unwrap_or(false))
            if use_native {
                if record_name.is_some() {
                    ProveReplay.emit_diag("E2203", "recorded reverse debugging is unavailable for native sessions",
                        "the native LLDB/DAP backend has no recorded Jet source history",
                        "remove `--record`, or debug a source program within the interpreter boundary", mode.json)
                    exit(ExitCodes.USER_ERROR)
                }
                if debug_replay.is_some() {
                    ProveReplay.emit_diag("E2203", "replay debugging is unavailable for native sessions",
                        "the native LLDB/DAP backend cannot browse an interpreter recording",
                        "replay an interpreter receipt without `--dap` or native-only source features", mode.json)
                    exit(ExitCodes.USER_ERROR)
                }
                exit(run_debug_native(resolved, raw_frames, dap, mode))
            }
            if record_name is Some(name) {
                capture :: ProveReplay.begin_named_capture(resolved, name, named_profile.unwrap_or("dev"), setting_overrides, mode.json)
                    .unwrap_or_else(fn(status) -> exit(status))
                execution :: jet.Debug.run_debug_recorded(resolved)
                if ProveReplay.finish_named_capture_with_run(capture, execution.exit_code, mode.json, execution.run) is Err(status) { exit(status) }
                exit(execution.exit_code)
            }
            if replay is Some(recording) { exit(jet.Debug.run_debug_with_recording(resolved, recording.recorded_run)) }
            exit(jet.Debug.run_debug(resolved))
        }),
        (["cache"], fn() -> Bool { exit(CmdStatus.run_cache(raw[1..], mode.json)) }),
        (["shared-store"], fn() -> Bool { exit(EngineDispatch.dispatch(jet.Syntax.JETPACK_BINARY_NAME, "shared-store", raw)) }),
