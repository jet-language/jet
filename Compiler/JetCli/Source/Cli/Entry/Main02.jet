    bare_routes :: [(["run", "build", "test", "check", "dev", "doc"], fn() -> {
        cwd :: env.current_dir().unwrap_or_else(fn(_) -> OSPath.from("."))
        entry :: resolve_bare_entry(cmd, cwd, bare_member_flag, mode, !jet_argv.iter().any(fn(arg) -> arg == "--show-default"))
            .unwrap_or_else(fn() -> missing_bare_entry(cmd, cwd, mode))
        entry_str :: entry.path.to_string_lossy().to_string()
        match cmd {
            "doc" -> { run_doc(entry_str, mode, jet_argv.iter().any(fn(arg) -> arg == "--check")); return }
            "test" -> {
                entry_dir :: entry.path.parent().filter(fn(path) -> !path.as_os_str().is_empty()).unwrap_or(OSPath.from("."))
                root :: Loader.find_manifest_root(entry_dir).unwrap_or(entry_dir)
                test_opts :: TestRunOpts.parse(jet_argv, mode, setting_overrides)
                if test_opts.show_default && !mode.quiet { write_status(profile, "jet test: using stock default\n") }
                run_test_opts(root.to_string_lossy(), test_opts, mode)
                return
            }
            "dev" -> {
                try_anyway :: jet_argv.iter().any(fn(a) -> a == "--try-anyway")
                use_interpreter :: jet_argv.iter().any(fn(a) -> a == "--interpret")
                policy :: watch_policy_from(raw, WatchPolicy.Auto)
                canvas_options :: if canvas_requested { Some(canvas_options_from_args(jet_argv, output_name, requested_target)) } else { None }
                dev_profile :: if named_profile is Some(name) { resolve_named_profile(name, entry_str, mode) }
                    else if no_os { BuildProfile.NoOs } else if small { BuildProfile.Small } else { BuildProfile.default_for_command("dev") }
                run_dev(entry_str, entry.callable, try_anyway, policy, gates, mode, use_interpreter, dev_profile.budget_name(),
                    setting_overrides, passthrough, record_name, no_capture, canvas_requested, canvas_options, dev_port)
                return
            }
            _ -> {
                if jet_argv.iter().any(fn(arg) -> arg == "--show-default") && !mode.quiet { write_status(profile, "jet {cmd}: using stock default\n") }
                program_args :: if passthrough_sep.is_some() { passthrough } else { args[1..] }
                if cmd == "run" && run_wants_watch(raw) {
                    prepare_project_environment("run", OSPath.from(entry_str), mode)
                    try_anyway :: raw.iter().any(fn(a) -> a == "--try-anyway")
                    use_interpreter :: raw.iter().any(fn(a) -> a == "--interpret")
                    run_profile :: if named_profile is Some(name) { resolve_named_profile(name, entry_str, mode) }
                        else if no_os { BuildProfile.NoOs } else if small { BuildProfile.Small } else { BuildProfile.default_for_command("run") }
                    run_dev(entry_str, entry.callable, try_anyway, WatchPolicy.Restart, gates, mode, use_interpreter,
                        run_profile.budget_name(), setting_overrides, program_args, record_name, false, false, None, dev_port)
                    return
                }
                effective :: effective_target(cmd, entry_str, cross_target)
                reject_native_web_run(cmd, entry_str, effective, mode)
                effective :: native_run_target(cmd, entry_str, effective)
                stock_default :: jet_argv.iter().any(fn(arg) -> arg == "--show-default")
                run_native_execution(NativeExecutionRequest{
                    command: cmd, file: entry_str, emit_rust: emit_rust, emit_generated: emit_generated,
                    library: library_flag, small: small, no_os: no_os, gates: gates, build_grants: build_grants,
                    invocation_authority: invocation_authority, remote_builder: remote_builder, locked: locked,
                    target: effective, target_machine: selected_machine, explain_partition: explain_partition,
                    verbose: verbose, sbom: sbom, release: release_flag, profile: named_profile,
                    setting_overrides: setting_overrides, output: output_name, program_args: program_args,
                    mode: mode, output_profile: Some(profile), record: record_name, interpret: interpret,
                    entry_fn: entry.callable, check_project_scope: cmd == "check",
                    package_scope: cmd != "build" || !stock_default, build_override: cmd != "build" || !stock_default, source_overlay: None})
                return
            }
        }
    })]
