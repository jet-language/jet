pub fn canvas_flag_value(argv: [String], name: String) -> String? {
    argv.iter().find_map(fn(arg) -> arg.strip_prefix("{name}=")).or_else(fn() -> flag_value(argv, name))
}

// Rust: Source/main.rs:2014
pub fn canvas_options_from_args(argv: [String], output: String?, target: String?) -> CanvasHostOptions {
    options := CanvasHostOptions.default()
    if canvas_flag_value(argv, "--canvas-host") is Some(host) { options.host = host.to_string() }
    if canvas_flag_value(argv, "--canvas-port") is Some(port) {
        options.port = Some(port.parse[U16]().unwrap_or_else(fn(_) -> {
            cli_error_fix("E2104", "`--canvas-port={port}` isn't a valid port number",
                "use a number from 1 to 65535, e.g. `--canvas-port=3000`")
            exit(ExitCodes.USAGE)
        }))
        if options.port == Some(0) {
            cli_error_fix("E2104", "`--canvas-port=0` isn't a valid port number",
                "use a number from 1 to 65535, or omit `--canvas-port` for automatic selection")
            exit(ExitCodes.USAGE)
        }
    }
    if canvas_flag_value(argv, "--canvas-transport") is Some(transport) { options.transport = transport.to_string() }
    if canvas_flag_value(argv, "--canvas-authority") is Some(authority) { options.authority = authority.to_string() }
    options.output = output.map(fn(value) -> value.to_string())
    options.target = target.map(fn(value) -> value.to_string())
    options.audit = argv.iter().any(fn(arg) -> arg == "--canvas-audit")
    options
}

// Rust: Source/main.rs:2053
pub fn run_explain_reload(file: String?, mode: OutputMode, profile: OutputProfile) -> {
    if file.is_none() {
        cli_error_fix("E2104", "`jet explain --reload` needs one source or project path",
            "run `jet explain --reload <file.jet|dir>`")
        exit(ExitCodes.USAGE)
    }
    file :: file.unwrap()
    resolved :: resolve_source_path(file)
    canonical :: match fs.canonicalize(resolved) {
        Ok(path) if path.is_file() -> path
        Ok(_) -> {
            cli_error_fix("E2104", "`{file}` is not a source file",
                "pass a `.jet` file or a project directory with a source entry")
            exit(ExitCodes.USAGE)
        }
        Err(error) -> {
            cli_error_fix("E2105", "couldn't read `{file}`: {error}", "check the source path and run the command again")
            exit(ExitCodes.USER_ERROR)
        }
    }
    canonical_text :: canonical.to_string_lossy().into_owned()
    source_id :: canonical_text.clone()
    emit :: fn(explanation: DevServer.NativeSwap.NativeSwapExplanation) -> {
        if mode.json {
            payload :: render_status("explain.reload", true, StatusFields.new()
                .with("source_id", explanation.source_id).with("disposition", explanation.disposition.to_string())
                .with("blocking_fact", explanation.blocking_fact).with("detail", explanation.detail))
            write_machine(profile, "{payload}\n")
        } else { write_renderable(profile, "{explanation.render()}\n") }
    }
    baseline :: match git_head_source(canonical) {
        Ok(source) -> source
        Err(detail) -> {
            emit(DevServer.NativeSwap.NativeSwapExplanation.new(source_id,
                DevServer.NativeSwap.NativeSwapDisposition.Rejected,
                DevServer.NativeSwap.NativeSwapBlockingFact.CapabilityUnavailable, detail))
            return
        }
    }
    checked :: jet.run_compiler_work(fn() -> {
        cache := Sema.IncrementalSemaCache.new()
        old :: Driver.check_file_with_effect_facts_incremental(canonical_text, Some((canonical, baseline)), false, &cache)
        new :: Driver.check_file_with_effect_facts_incremental(canonical_text, None, false, &cache)
        (old, new)
    })
    (old_diagnostics, old_bundle, _) :: checked.0
    (new_diagnostics, new_bundle, _) :: checked.1
    if old_bundle.is_none() || new_bundle.is_none() {
        (phase, diagnostics) :: if old_bundle.is_none() { ("HEAD", old_diagnostics) } else { ("current", new_diagnostics) }
        detail :: if diagnostics.is_empty() { "{phase} source did not produce a checked program" } else {
            "{phase} source check failed: {diagnostics.iter().map(fn(diagnostic) -> \"{diagnostic.code} {diagnostic.what}\").collect().join(\"; \")}"
        }
        emit(DevServer.NativeSwap.NativeSwapExplanation.new(source_id,
            DevServer.NativeSwap.NativeSwapDisposition.Rejected,
            DevServer.NativeSwap.NativeSwapBlockingFact.CompileFailed, detail))
        return
    }
    decision :: match Sema.HotSwap.type_stable_decision(old_bundle.unwrap(), new_bundle.unwrap(), source_id) {
        Ok(decision) -> decision
        Err(diagnostics) -> {
            detail :: diagnostics.iter().map(fn(diagnostic) -> "{diagnostic.code} {diagnostic.what}").collect().join("; ")
            emit(DevServer.NativeSwap.NativeSwapExplanation.new(source_id,
                DevServer.NativeSwap.NativeSwapDisposition.Rejected,
                DevServer.NativeSwap.NativeSwapBlockingFact.CompileFailed,
                if detail.is_empty() { "the checked compiler could not produce a reload verdict" } else { detail }))
            return
        }
    }
    if decision.is_compatible() { emit(DevServer.NativeSwap.NativeSwapExplanation.compatible(source_id)) } else {
        emit(DevServer.NativeSwap.NativeSwapExplanation.new(source_id,
            DevServer.NativeSwap.NativeSwapDisposition.Restart,
            DevServer.NativeSwap.NativeSwapBlockingFact.IncompatibleType,
            decision.compatibility.reason().unwrap_or("the checked type surface requires a clean restart")))
    }
}

// Rust: Source/main.rs:2202
pub fn git_head_source(path: OSPath) -> String Err! {
    root_output :: Command.new("git").current_dir(path.parent().unwrap_or(OSPath.from(".")))
        .args(["rev-parse", "--show-toplevel"]).output()
        .map_err(fn(error) -> "could not locate the project baseline: {error}")?
    if !root_output.status.success() { return Err("no committed project baseline is available for reload explanation") }
    root_text :: String.from_utf8(root_output.stdout).map_err(fn(_) -> "git returned a non-text project root")?
    trimmed := root_text.trim() // #4303
    root :: OSPath.from(trimmed)
    relative :: path.strip_prefix(root).map_err(fn(_) -> "source path is outside the project baseline")?
    relative :: relative.to_str().ok_or("source path is not valid UTF-8")?.replace('\\', "/")
    spec :: "HEAD:{relative}"
    source :: Command.new("git").current_dir(root).args(["show", spec]).output()
        .map_err(fn(error) -> "could not read the project baseline: {error}")?
    if !source.status.success() { return Err("source has no committed baseline for reload explanation") }
    String.from_utf8(source.stdout).map_err(fn(_) -> "the committed source baseline is not valid UTF-8")
}

