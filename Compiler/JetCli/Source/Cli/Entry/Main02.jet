            time_budget_ms :: jet_argv.iter().find_map(fn(a) -> a.strip_prefix("--time=")).and_then(fn(v) -> v.parse[F64]().ok()).map(fn(secs) -> (secs * 1000.0) as U64)
            seed :: jet_argv.iter().find_map(fn(a) -> a.strip_prefix("--seed=")).and_then(fn(v) -> v.parse[U64]().ok())
            corpus :: jet_argv.iter().find_map(fn(a) -> a.strip_prefix("--corpus=")).map(fn(v) -> v.to_string())
            resolved :: resolve_source_path(target)
            run_fuzz(resolved, test_name, FuzzRunOpts{iterations: iterations, time_budget_ms: time_budget_ms, seed: seed, corpus: corpus}, mode)
        }),
        (["doc"], fn() -> { run_doc(target, mode, jet_argv.iter().any(fn(arg) -> arg == "--check")) }),
        (["lint"], fn() -> {
            categories :: (a11y as UInt) + (complexity as UInt) + (cost as UInt)
            if categories != 1 {
                emit_cli_report("E2102", "usage: {jet.Syntax.BINARY_NAME} lint --a11y|--complexity|--cost <file.{jet.Syntax.FILE_EXT}>",
                    "`lint` needs exactly one category flag",
                    "run `{jet.Syntax.BINARY_NAME} lint --a11y <file.{jet.Syntax.FILE_EXT}>`, `{jet.Syntax.BINARY_NAME} lint --complexity <file.{jet.Syntax.FILE_EXT}>`, or `{jet.Syntax.BINARY_NAME} lint --cost <file.{jet.Syntax.FILE_EXT}>`", false)
                exit(ExitCodes.USAGE)
            }
            resolved :: resolve_source_path(target)
            if complexity {
                max_budget :: jet_argv.iter().find_map(fn(arg) -> arg.strip_prefix("--max=")).map(fn(value) -> value.parse[U32]().unwrap_or_else(fn(_) -> {
                    cli_error_fix("E2104", "`--max={value}` isn't a non-negative integer", "use `--max=<n>` with a non-negative integer")
                    exit(ExitCodes.USAGE)
                }))
                run_lint_complexity(resolved, mode, max_budget)
            } else if cost { run_lint_cost(resolved, mode) } else { run_lint_a11y(resolved, mode) }
        }),
        (["run", "build", "check"], fn() -> {
            program_args :: if passthrough_sep.is_some() { passthrough } else { args.iter().skip(2).collect() }
            named_build_target :: named_build_entry.is_some()
            stock_default :: jet_argv.iter().any(fn(arg) -> arg == "--show-default")
            resolved :: if cmd == "build" {
                named_build_entry.unwrap_or_else(fn() -> resolve_command_target(cmd, target, bare_member_flag, mode, !stock_default))
            } else if ["run", "check"].contains(cmd) {
                resolve_command_target(cmd, target, bare_member_flag, mode, !stock_default)
            } else { ResolvedEntry.file(OSPath.from(target)) }
            resolved_path :: resolved.path.to_string_lossy().into_owned()
            if cmd == "run" && run_wants_watch(raw) {
                prepare_project_environment("run", OSPath.from(resolved_path), mode)
                try_anyway :: raw.iter().any(fn(a) -> a == "--try-anyway")
                use_interpreter :: raw.iter().any(fn(a) -> a == "--interpret")
                run_profile :: if named_profile is Some(name) { resolve_named_profile(name, resolved_path, mode) }
                    else if no_os { BuildProfile.NoOs } else if small { BuildProfile.Small } else { BuildProfile.default_for_command("run") }
                run_dev(resolved_path, resolved.callable, try_anyway, WatchPolicy.Restart, gates, mode, use_interpreter,
                    run_profile.budget_name(), setting_overrides, program_args, record_name, false, false, None, dev_port)
                return
            }
            if cmd == "run" && mode.json { jet.Outcome.jet_report_use_wire() }
            if stock_default && !mode.quiet { write_status(profile, "jet {cmd}: using stock default\n") }
            effective :: effective_target(cmd, resolved_path, cross_target)
            reject_native_web_run(cmd, resolved_path, effective, mode)
            effective :: native_run_target(cmd, resolved_path, effective)
            run_native_execution(NativeExecutionRequest{
                command: cmd, file: resolved_path, emit_rust: emit_rust, emit_generated: emit_generated,
                library: library_flag, small: small, no_os: no_os, gates: gates, build_grants: build_grants,
                invocation_authority: invocation_authority, remote_builder: remote_builder, locked: locked,
                target: effective, target_machine: selected_machine, explain_partition: explain_partition,
                verbose: verbose, sbom: sbom, release: release_flag, profile: named_profile,
                setting_overrides: setting_overrides, output: output_name, program_args: program_args,
                mode: mode, output_profile: Some(profile), record: record_name, interpret: interpret,
                entry_fn: resolved.callable, check_project_scope: cmd == "check" && OSPath.from(target).is_dir(),
                package_scope: cmd != "build" || named_build_target || (OSPath.from(target).is_dir() && !stock_default),
                build_override: cmd != "build" || !stock_default, source_overlay: None})
        })
    ]
    // Rust: Source/main.rs:5020-5047
    host_dispatch_words :: [
        dispatch_routes.iter().flat_map(fn(route) -> route.0.iter()).collect(),
        bare_routes.iter().flat_map(fn(route) -> route.0.iter()).collect(),
        late_routes.iter().flat_map(fn(route) -> route.0.iter()).collect(),
        alias_routes.iter().flat_map(fn(route) -> route.0.iter()).collect(),
        perf_routes.iter().flat_map(fn(route) -> route.0.iter()).collect(),
        lsp_routes.iter().flat_map(fn(route) -> route.0.iter()).collect()
    ]
    if CLI.parser_inventory_violations_against_slices(Some(host_dispatch_words)).into_iter().next() is Some(violation) {
        emit_cli_report("E2105", "CLI parser registry drift: {violation}",
            "the command parser and its registered surface must remain one table",
            "repair the CLI registry drift before invoking Jet", mode.json)
        exit(ExitCodes.ICE)
    }
    if dispatch_routes.iter().find(fn(route) -> route.0.contains(cmd)) is Some(route) {
        if route.1() { return }
    }
    if no_target {
        if bare_routes.iter().find(fn(route) -> route.0.contains(cmd)) is Some(route) { route.1(); return }
        write_status(profile, command_help(cmd))
        exit(ExitCodes.USAGE)
    }
    late_route :: late_routes.iter().find(fn(route) -> route.0.contains(cmd)).unwrap_or_else(fn() -> late_routes.last().unwrap())
    late_route.1()
}
