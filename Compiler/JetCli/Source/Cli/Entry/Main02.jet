        (["test"], fn() -> {
            if test_option_value(jet_argv, "--browser-scaffold") is Some(name) {
                root :: env.current_dir().unwrap_or_else(fn(_) -> OSPath.from("."))
                match scaffold_browser_tests(root, name) {
                    Ok(project) -> { write_mode_status(mode, "created browser test project `{project.display()}`\n"); exit(ExitCodes.OK) }
                    Err(error) -> {
                        cli_error_fix("E2104", error, "use `jet test --browser-scaffold=<new-project-name>`")
                        exit(ExitCodes.USER_ERROR)
                    }
                }
            }
            test_opts :: TestRunOpts.parse(jet_argv, mode, setting_overrides)
            if test_opts.show_default && !mode.quiet { write_status(profile, "jet test: using stock default\n") }
            resolved :: if OSPath.from(target).is_dir() { target.to_string() } else { resolve_source_path(target) }
            run_test_opts(resolved, test_opts, mode)
        }),
        (["add"], fn() -> { run_add(raw) }),
        (["remove"], fn() -> { run_remove(target) }),
        (["emit"], fn() -> {
            if !jet_argv.iter().any(fn(a) -> a == "--rust") {
                emit_cli_report("E2102", "usage: {jet.Syntax.BINARY_NAME} emit --rust <file.{jet.Syntax.FILE_EXT}>",
                    "`emit` needs a mode flag; today only `--rust` is supported",
                    "run `{jet.Syntax.BINARY_NAME} emit --rust <file.{jet.Syntax.FILE_EXT}>` to print the generated Rust", false)
