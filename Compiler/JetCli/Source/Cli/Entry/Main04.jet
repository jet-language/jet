fn maybe_dispatch_pinned_toolchain(raw: [String], mode: OutputMode) -> {
    cwd :: env.current_dir().unwrap_or_else(_ -> OSPath.from(".")) // GATE #4494
    root :: Loader.find_manifest_root(cwd) ?? return
    offline :: raw.iter().any(a -> a == "--offline" || a == "--locked")
    running :: Manifest.COMPILER_VERSION
    if JetPin.decide(root, running, offline) == {
        .RunNative -> {}
        .Report(d) -> { print_toolchain_diag(d, mode); exit(ExitCodes.USER_ERROR) }
        .ReExec(binary, channel, version) -> {
            write_mode_status(mode, "{JetPin.handoff_line(channel, version, running)}\n")
            // GATE #4494: actual pinned executable spawn and exit propagation.
            status :: Command.new(binary).args(raw).env(Syntax.TOOLCHAIN_EXEC_MARKER_ENV, version).status() ?? {
                cli_error!("E2105", "couldn't exec the pinned toolchain `{binary.display()}`: {err}")
                exit(ExitCodes.USER_ERROR)
            }
            exit(status.code().unwrap_or(ExitCodes.USER_ERROR))
        }
    }
}
