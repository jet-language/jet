// Rust: Source/main.rs:6745
fn run_self_update(raw: [String], mode: OutputMode) -> Never {
    roots :: Store.resolve()
    endpoint :: self_update_option(raw, "--endpoint").or_else(fn() {
        ToolchainUpdate.configured_endpoint(roots.root) ?? {
            emit_cli_report("E2105", "could not read the Jet toolchain endpoint: {err}", "self-update needs a readable host-owned endpoint configuration", "fix or remove JETPACK_ROOT/config/toolchain-v1.endpoint, or pass --endpoint <url>", mode.json)
            exit(ExitCodes.USER_ERROR)
        }
    }).unwrap_or(ToolchainUpdate.DEFAULT_ENDPOINT)
    channel :: self_update_option(raw, "--channel").unwrap_or(ToolchainUpdate.DEFAULT_CHANNEL)
    platform :: self_update_option(raw, "--platform").unwrap_or_else(ToolchainUpdate.default_target)
    state_key :: SHA256.sha256_hex("toolchain-update-v1\n{channel}\n{platform}".as_bytes())
    state_path :: roots.root.join("config/toolchain-v1").join("{state_key}.state")
    trust_key :: self_update_option(raw, "--trust-key").map(OSPath.from).unwrap_or_else(fn() { roots.root.join("trust/toolchain-v1.ed25519.pub") })
    dry_run :: raw.iter().any(arg -> arg == "--dry-run")
    apply :: raw.iter().any(arg -> arg == "--apply")
    allow_unofficial :: raw.iter().any(arg -> arg == "--allow-unofficial")
    options :: ToolchainUpdate.UpdateOptions{endpoint: endpoint, channel: channel, platform: platform, trust_key: trust_key, dry_run: dry_run, apply: apply, allow_unofficial: allow_unofficial, running_version: Manifest.COMPILER_VERSION, state_path: state_path}
    current_exe :: if apply -> env.current_exe().ok() else -> None // GATE #4494
    if ToolchainUpdate.run(options, current_exe) == {
        .Ok(result) -> {
            if mode.json {
                trust :: if result.plan.trust == { .Signed -> "signed"; .UnofficialKeyless -> "unofficial-keyless" }
                key_id :: result.plan.key_id.map(StatusValue.from).unwrap_or(StatusValue.Null)
                payload :: render_status("self-update", true, StatusFields.new()
                    .with("channel", result.plan.channel).with("version", result.plan.version).with("platform", result.plan.platform)
                    .with("artifact", result.plan.artifact_url).with("sha256", result.plan.sha256).with("size", result.plan.size)
                    .with("key_id", key_id).with("trust", trust).with("sequence", result.plan.sequence)
                    .with("published_at", result.plan.published_at).with("expires_at", result.plan.expires_at)
                    .with("min_version", result.plan.min_version).with("applied", result.applied).with("deferred", result.deferred))
                write_mode_machine(mode, "{payload}\n")
            } else {
                suffix :: if result.plan.trust == { .Signed -> ""; .UnofficialKeyless -> " [unofficial keyless source]" }
                if result.deferred -> write_mode_status(mode, "staged {Syntax.BINARY_NAME} {result.plan.version} for {result.plan.platform}; Windows will restart it after this process exits{suffix}")
                else if result.applied -> write_mode_status(mode, "updated {Syntax.BINARY_NAME} to {result.plan.version} ({result.plan.platform}){suffix}")
                else -> write_mode_status(mode, "verified {Syntax.BINARY_NAME} {result.plan.version} for {result.plan.platform} from {result.plan.artifact_url}{suffix}")
            }
            exit(ExitCodes.OK)
        }
        .Err(error) -> {
            emit_cli_report("E2105", "could not update {Syntax.BINARY_NAME}: {error}", "self-update accepts a signed channel manifest and matching signed artifact; local keyless sources are a separate explicit tier", "check the endpoint, public trust key, channel, and platform; use --dry-run to verify without installing, or --allow-unofficial only with a local file:// source", mode.json)
            exit(ExitCodes.USER_ERROR)
        }
    }
}
// Rust: Source/main.rs:6896
fn self_update_option(raw: [String], name: String) -> String? {
    raw.iter().find_map(arg -> arg.strip_prefix("{name}=").map(value -> value.to_string())).or_else(fn() {
        index :: raw.iter().position(arg -> arg == name) ?? return None
        raw.get(index + 1).filter(value -> !value.starts_with('-'))
    })
}
// Rust: Source/main.rs:6908
fn is_diagnostic_code(s: String) -> Bool {
    bytes :: s.as_bytes()
    (bytes.len() == 5 && (bytes[0] == b'E' || bytes[0] == b'L') && bytes[1..].iter().all(byte -> byte.is_ascii_digit()))
        || (bytes.len() == 6 && bytes[..2] == b"JT" && bytes[2..].iter().all(byte -> byte.is_ascii_digit()))
}
