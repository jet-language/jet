// Rust: Source/main.rs:5419
fn render_job_registry(registry: CLISchema.JobRegistry, profile: OutputProfile.OutputProfile) -> {
    jobs :: registry.visible_jobs()
    if profile.machine_enabled() {
        jobs_value :: StatusValue.array(jobs.iter().map(job -> StatusValue.object(StatusFields.new()
            .with("name", job.name).with("scope", job.scope_name())
            .with("doc", job_status_optional_string(job.doc))
            .with("arguments", StatusValue.array(job.arguments.iter().map(job_status_argument)))
            .with("schedule", job_status_optional_string(job.schedule))
            .with("after", job_status_string_array(job.after)).with("inputs", job_status_string_array(job.inputs))
            .with("outputs", job_status_string_array(job.outputs)).with("packages", job_status_string_array(job.packages))
            .with("cwd", job_status_optional_string(job.cwd)).with("skip", job_status_skip(job.skip))
            .with("cache", job_cache_name(job.cache)).with("limits", job_status_limits(job.limits)).with("parallel", job.parallel))))
        payload :: render_status("jobs", true, StatusFields.new().with("jobs", jobs_value))
        write_machine(profile, "{payload}\n")
        return
    }
    if jobs.is_empty() { write_renderable(profile, "No jobs declared.\n"); return }
    columns :: [AdaptiveTable.TableColumn.new("Name", .Text), AdaptiveTable.TableColumn.new("Scope", .Text), AdaptiveTable.TableColumn.new("Details", .Text)]
    rows :: jobs.iter().map(fn(job) {
        arguments :: job.arguments.iter().map(argument -> argument.display()).collect().join(", ")
        detail := if arguments.is_empty() -> "" else -> "({arguments})"
        if job.doc == .Val(doc) {
            if !doc.is_empty() { if !detail.is_empty() -> detail.push(' '); detail.push_str(doc.replace('\n', " ")) }
        }
        if job.schedule == .Val(schedule) { if !detail.is_empty() -> detail.push(' '); detail.push_str("(every {schedule})") }
        if !job.after.is_empty() { if !detail.is_empty() -> detail.push(' '); detail.push_str("(after {job.after.join(", ")})") }
        if !job.inputs.is_empty() { if !detail.is_empty() -> detail.push(' '); detail.push_str("(inputs {job.inputs.join(", ")})") }
        if !job.outputs.is_empty() { if !detail.is_empty() -> detail.push(' '); detail.push_str("(outputs {job.outputs.join(", ")})") }
        if !job.packages.is_empty() { if !detail.is_empty() -> detail.push(' '); detail.push_str("(packages {job.packages.join(", ")})") }
        if job.cwd == .Val(cwd) { if !detail.is_empty() -> detail.push(' '); detail.push_str("(cwd {cwd})") }
        if job.skip == .Val(skip) { if !detail.is_empty() -> detail.push(' '); detail.push_str("(skip {job_skip_label(skip)})") }
        if job.cache != .Uncached { if !detail.is_empty() -> detail.push(' '); detail.push_str("(cache {job_cache_name(job.cache)})") }
        if !job.limits.is_empty() {
            detail.push(' ')
            names := job.limits.keys().collect(); names.sort()
            limits :: names.iter().map(name -> "{name}={job.limits[name]}").collect().join(", ")
            detail.push_str("(limits {limits})")
        }
        if !detail.is_empty() -> detail.push(' ')
        detail.push_str("(parallel {job.parallel})")
        AdaptiveTable.TableRow.new([AdaptiveTable.TableCell.text(job.name), AdaptiveTable.TableCell.text(job.scope_name()), AdaptiveTable.TableCell.text(^detail)])
    }).collect()
    table :: AdaptiveTable.AdaptiveTable.new(columns, rows)
    if table.layout(profile).render() == .Val(rendered) -> write_renderable(profile, "{rendered}\n")
}
// Rust: Source/main.rs:5566
fn render_job_inspection(entry: OSPath, registry: CLISchema.JobRegistry, profile: OutputProfile.OutputProfile, requested: String?, graph: Bool, status: Bool, explain: Bool) -> {
    jobs :: registry.visible_jobs()
    selected :: if requested == {
        .Val(name) -> {
            job :: registry.find_visible(name) ?? {
                emit_cli_report("E1294", "No job named `{name}`.", "`jet jobs` inspection uses the same visible checked job namespace as invocation", "check the spelling; declared jobs: {registry.completion_words().join(", ")}", profile.machine_enabled())
                exit(ExitCodes.USER_ERROR)
            }
            [job]
        }
        .None -> jobs
    }
    if profile.machine_enabled() {
        jobs_value :: StatusValue.array(selected.iter().map(fn(job) {
            (fresh, reason) :: job_graph_freshness(entry, registry, job)
            StatusValue.object(StatusFields.new().with("name", job.name).with("scope", job.scope_name())
                .with("after", job_status_string_array(job.after)).with("inputs", job_status_string_array(job.inputs))
                .with("outputs", job_status_string_array(job.outputs)).with("packages", job_status_string_array(job.packages))
                .with("cwd", job_status_optional_string(job.cwd)).with("skip", job_status_skip(job.skip))
                .with("cache", job_cache_name(job.cache)).with("limits", job_status_limits(job.limits))
                .with("parallel", job.parallel).with("fresh", fresh).with("reason", reason))
        }))
        view :: if graph -> "graph" else if status -> "status" else if explain -> "explain" else -> "inspect"
        payload :: render_status("jobs.{view}", true, StatusFields.new().with("entry", entry.display().to_string()).with("jobs", jobs_value))
        write_machine(profile, "{payload}\n")
        return
    }
    if selected.is_empty() { write_renderable(profile, "No jobs declared.\n"); return }
    rendered := String.new()
    if graph {
        rendered.push_str("Job graph\n")
        loop job in selected {
            predecessors :: if job.after.is_empty() -> "—" else -> job.after.join(", ")
            rendered.push_str("  {job.name} <- {predecessors}\n")
        }
    } else if status {
        rendered.push_str("Job status\n")
        loop job in selected {
            (fresh, reason) :: job_graph_freshness(entry, registry, job)
            state :: if fresh -> "fresh" else -> "stale"
            rendered.push_str("  {job.name:<24} {state:<6} {reason}\n")
        }
    } else {
        rendered.push_str("Job details\n")
        loop job in selected {
            (fresh, reason) :: job_graph_freshness(entry, registry, job)
            rendered.push_str("  {job.name}\n    scope: {job.scope_name()}\n")
            rendered.push_str("    after: {if job.after.is_empty() -> "—" else -> job.after.join(", ")}\n")
            rendered.push_str("    inputs: {if job.inputs.is_empty() -> "—" else -> job.inputs.join(", ")}\n")
            rendered.push_str("    outputs: {if job.outputs.is_empty() -> "—" else -> job.outputs.join(", ")}\n")
            rendered.push_str("    packages: {if job.packages.is_empty() -> "—" else -> job.packages.join(", ")}\n")
            rendered.push_str("    cwd: {job.cwd.unwrap_or("project root")}\n")
            rendered.push_str("    skip: {job.skip.map(job_skip_label).unwrap_or("never")}\n")
            rendered.push_str("    cache: {job_cache_name(job.cache)}\n")
            names := job.limits.keys().collect(); names.sort()
            limits :: if names.is_empty() -> "—" else -> names.iter().map(name -> "{name}={job.limits[name]}").collect().join(", ")
            rendered.push_str("    limits: {limits}\n    parallel: {job.parallel}\n")
            rendered.push_str("    freshness: {if fresh -> "fresh" else -> "stale"} ({reason})\n")
        }
    }
    write_renderable(profile, rendered)
}
// Rust: Source/main.rs:5729
fn job_freshness(entry: OSPath, job: CLISchema.JobFact) -> (Bool, String) {
    if job.cache == .Uncached -> return (false, "cache policy is uncached")
    base :: job_base_directory(entry, job)
    missing_input := None as String?
    missing_output := None as String?
    // GATE #4494: filesystem modification times preserve SystemTime ordering.
    newest_input := None as time.SystemTime?
    newest_output := None as time.SystemTime?
    loop pattern in job.inputs {
        paths :: job_declared_paths(base, pattern)
        if paths.is_empty() -> missing_input = Val(pattern)
        loop path in paths {
            if !path.exists() -> missing_input = Val(pattern)
            if job_latest_modified(path) == .Val(modified) -> newest_input = Val(newest_input.map_or(modified, current -> current.max(modified)))
        }
    }
    loop pattern in job.outputs {
        paths :: job_declared_paths(base, pattern)
        if paths.is_empty() -> missing_output = Val(pattern)
        loop path in paths {
            if !path.exists() -> missing_output = Val(pattern)
            if job_latest_modified(path) == .Val(modified) -> newest_output = Val(newest_output.map_or(modified, current -> current.max(modified)))
        }
    }
    if job.outputs.is_empty() -> return (false, "no declared outputs")
    if missing_output == .Val(path) -> return (false, "output `{path}` is missing")
    if missing_input == .Val(path) -> return (false, "input `{path}` is missing")
    if newest_input > newest_output -> return (false, "an input is newer than the declared outputs")
    (true, "all declared outputs are newer than declared inputs")
}
// Rust: Source/main.rs:5788
fn job_graph_freshness(entry: OSPath, registry: CLISchema.JobRegistry, job: CLISchema.JobFact) -> (Bool, String) {
    own :: job_freshness(entry, job)
    if !own.0 -> return own
    seen := BTreeSet.new()
    if job_graph_is_stale(entry, registry, job, &seen) -> return (false, "a declared dependency is stale")
    own
}
// Rust: Source/main.rs:5804
fn job_glob_match(pattern: String, value: String) -> Bool {
    tokens :: pattern.as_bytes()
    bytes :: value.as_bytes()
    row := [Bool].repeat(false, bytes.len() + 1)
    row[0] = true
    loop token in tokens {
        next := [Bool].repeat(false, bytes.len() + 1)
        if token == b'*' {
            next[0] = row[0]
            loop index in 1..=bytes.len() { next[index] = row[index] || next[index - 1] }
        } else {
            loop index in 1..=bytes.len() {
                if token == b'?' || token == bytes[index - 1] -> next[index] = row[index - 1]
            }
        }
        row = ^next
    }
    row[bytes.len()]
}
// Rust: Source/main.rs:5828
fn job_declared_paths(base: OSPath, pattern: String) -> [OSPath] {
    normalized :: pattern.replace('\\', "/")
    if !normalized.contains('*') && !normalized.contains('?') -> return [base.join(pattern)]
    pending := [base]
    paths := [OSPath]{}
    loop {
        directory :: pending.pop() ?? break
        // GATE #4494: real directory iteration and file-kind metadata.
        entries := fs.read_dir(directory).ok() ?? continue
        ordered := entries.filter_map(entry -> entry.ok()).collect()
        ordered.sort_by_key(entry -> entry.path())
        loop entry in ordered {
            path :: entry.path()
            file_type :: entry.file_type().ok() ?? continue
            if file_type.is_dir() -> pending.push(path)
            relative_path :: path.strip_prefix(base).ok() ?? continue
            relative :: relative_path.to_string_lossy().replace('\\', "/")
            if job_glob_match(normalized, relative) -> paths.push(path)
        }
    }
    paths.sort(); paths.dedup()
    paths
}
// Rust: Source/main.rs:5863
fn job_latest_modified(path: OSPath) -> time.SystemTime? {
    // GATE #4494: lstat, modification time, directory iteration.
    metadata :: fs.symlink_metadata(path).ok() ?? return None
    latest := metadata.modified().ok()
    if metadata.is_dir() {
        entries := fs.read_dir(path).ok() ?? return None
        children := entries.filter_map(entry -> entry.ok()).map(entry -> entry.path()).collect()
        children.sort()
        loop child in children {
            if job_latest_modified(child) == .Val(modified) -> latest = Val(latest.map_or(modified, current -> current.max(modified)))
        }
    }
    latest
}
// Rust: Source/main.rs:5882
fn collect_job_graph_jobs(registry: CLISchema.JobRegistry, job: CLISchema.JobFact, out: &[CLISchema.JobFact], seen: &BTreeSet<String>) -> Err! {
    if !seen.insert(job.name) -> return Ok(())
    loop dependency in job.after {
        dependency_job :: registry.find(dependency) ?? return Err("job graph references unknown job `{dependency}`")
        collect_job_graph_jobs(registry, dependency_job, out, seen)?
    }
    out.push(job)
    Ok(())
}
// Rust: Source/main.rs:5901
fn job_graph_is_stale(entry: OSPath, registry: CLISchema.JobRegistry, job: CLISchema.JobFact, seen: &BTreeSet<String>) -> Bool {
    if !seen.insert(job.name) -> return false
    !job_freshness(entry, job).0 || job.after.iter().any(dependency -> registry.find(dependency).is_some_and(dependency_job -> job_graph_is_stale(entry, registry, dependency_job, seen)))
}
// Rust: Source/main.rs:5918
fn job_depends_on(registry: CLISchema.JobRegistry, job: CLISchema.JobFact, target: String, seen: &BTreeSet<String>) -> Bool {
    if !seen.insert(job.name) -> return false
    job.after.iter().any(dependency -> dependency == target || registry.find(dependency).is_some_and(dependency_job -> job_depends_on(registry, dependency_job, target, seen)))
}
// Rust: Source/main.rs:5935
fn retain_outermost_stale_jobs(registry: CLISchema.JobRegistry, jobs: &[CLISchema.JobFact]) -> {
    names :: jobs.iter().map(job -> job.name).collect() as BTreeSet<String>
    jobs.retain(fn(job) {
        !names.iter().any(fn(candidate) {
            if candidate == job.name -> return false
            candidate_job :: registry.find(candidate) ?? return false
            seen := BTreeSet.new()
            job_depends_on(registry, candidate_job, job.name, &seen)
        })
    })
}
// Rust: Source/main.rs:5953
fn run_job_watch(entry: OSPath, registry: CLISchema.JobRegistry, requested: String?, raw: [String], job_args: [String], mode: OutputMode, profile: OutputProfile.OutputProfile) -> Never {
    jobs :: registry.visible_jobs()
    selected :: if requested == {
        .Val(name) -> {
            job :: registry.find_visible(name) ?? {
                emit_cli_report("E1294", "No job named `{name}`.", "`jet jobs --watch` uses the same visible checked job namespace as invocation", "check the spelling; declared jobs: {registry.completion_words().join(", ")}", mode.json)
                exit(ExitCodes.USER_ERROR)
            }
            [job]
        }
        .None -> jobs
    }
    if selected.is_empty() { write_renderable(profile, "No jobs declared.\n"); exit(ExitCodes.OK) }
    watch_jobs := [CLISchema.JobFact]{}
    seen := BTreeSet.new()
    loop job in selected { collect_job_graph_jobs(registry, job, &watch_jobs, &seen) ?? reject_job_graph(entry, err, mode) }
    graph := WatchGraph.new()
    graph.set_entry(entry)
    loop job in watch_jobs {
        job_base :: job_base_directory(entry, job)
        loop pattern in job.inputs {
            loop path in job_declared_paths(job_base, pattern) { graph.upsert(path, WatchService.RootKind.BuildInput) }
            if pattern.contains('*') || pattern.contains('?') {
                prefix :: pattern.split(character -> character == '*' || character == '?').next().unwrap_or("").rsplit_once('/').map(pair -> pair.0).unwrap_or("")
                graph.upsert(job_base.join(prefix), WatchService.RootKind.BuildInput)
            }
        }
    }
    watch := WatchSession.from_graph(graph)
    write_mode_status(mode, "watching declared job inputs … (Ctrl-C to stop)\n")
    run_stale_jobs(entry, registry, selected, raw, job_args, mode)
    loop {
        // GATE #4494: native timed sleep, not a spin loop.
        thread.sleep(time.Duration.from_millis(WATCH_POLL_INTERVAL_MS))
        if watch.poll().is_some() -> run_stale_jobs(entry, registry, selected, raw, job_args, mode)
    }
}
// Rust: Source/main.rs:6030
fn job_option_takes_value(argument: String) -> Bool {
    if argument == { "--profile" | "--target" | "--allow" | "--deny" | "--gate" | "--set" | "--builder" | "--record" -> true; _ -> false }
}
// Rust: Source/main.rs:6044
fn append_job_run_options(command: &Command, raw: [String]) -> {
    index := 0
    loop while index < raw.len() {
        argument :: raw[index]
        if argument == "--" -> break
        if argument == jet.CLI.JOBS_COMMAND || !argument.starts_with('-') { index += 1; continue }
        if argument == "-p" {
            index += 1
            if raw.get(index).is_some_and(value -> !value.starts_with('-')) -> index += 1
            continue
        }
        if argument == "--json" || argument == "--watch" || argument.starts_with("--watch=") || argument == "--graph" || argument == "--status" || argument == "--explain" { index += 1; continue }
        command.arg(argument)
        if job_option_takes_value(argument) && !argument.contains('=') {
            if raw.get(index + 1).filter(value -> !value.starts_with('-')) == .Val(value) { command.arg(value); index += 1 }
        }
        index += 1
    }
}
// Rust: Source/main.rs:6081
fn run_stale_jobs(entry: OSPath, registry: CLISchema.JobRegistry, jobs: [CLISchema.JobFact], raw: [String], job_args: [String], mode: OutputMode) -> {
    stale := jobs.iter().filter(fn(job) { seen := BTreeSet.new(); job_graph_is_stale(entry, registry, job, &seen) }).collect()
    stale.sort_by(left, right -> left.name.cmp(right.name))
    retain_outermost_stale_jobs(registry, &stale)
    loop job in stale {
        // GATE #4494: executable identity and real child process exit status.
        command := Command.new(env.current_exe().unwrap_or_else(_ -> OSPath.from(Syntax.BINARY_NAME)))
        if mode.json -> command.arg("--json")
        append_job_run_options(&command, raw)
        command.arg("run").arg(entry).arg("--").arg(job.name)
        command.args(job_args)
        status :: command.status()
        if mode.quiet -> continue
        if status == {
            .Ok(status) -> {
                if status.success() -> write_mode_status(mode, "job {job.name} completed\n")
                else -> write_mode_status(mode, "job {job.name} exited with {status}\n")
            }
            .Err(error) -> write_mode_status(mode, "job {job.name} could not start: {error}\n")
        }
    }
}
// Rust: Source/main.rs:6130
fn report_command_resolution_error(command: String, error: String, mode: OutputMode) -> Never {
    if error.contains("command overrides for the package") {
        prefix :: "two `{command}` command overrides for the package: "
        locations :: error.strip_prefix(prefix).unwrap_or(error)
        emit_cli_row_with_detail("E3540", [("command", command), ("locations", locations)], "pin the chosen `{command}` entry with `jet fix`, or remove every other override", mode.json)
    } else {
        cli_error!(@full "E2105", error, "command resolution uses the checked package source tree", "repair the package source and run the command again")
    }
    exit(ExitCodes.USER_ERROR)
}
// Rust: Source/main.rs:6153
// Package resolver owns role, root and src/ precedence even without a manifest.
pub fn resolve_package_command_override(root: OSPath, command: String, mode: OutputMode) -> OSPath? {
    resolver :: Authority.AuthorityResolver.open(root) ?? report_entry_authority_error(err)
    package :: if Loader.package_facts_for_root(root) == {
        .Ok(.Val(package)) -> package
        .Ok(.None) -> Package.PackageFacts.default()
        .Err(diagnostics) -> {
            rendered :: render_diagnostics(root.display().to_string(), "", diagnostics)
            write_mode_diagnostic(mode, rendered)
            exit(ExitCodes.USER_ERROR)
        }
    }
    if package.resolve_command_entry_checked(resolver, command) == {
        .Ok(.Val(entry)) -> Val(entry.path)
        .Ok(.None) -> None
        .Err(error) -> report_command_resolution_error(command, error, mode)
    }
}
// Rust: Source/main.rs:6184
fn resolve_command_target(cmd: String, raw: String, member_flag: String?, mode: OutputMode, use_override: Bool) -> ResolvedEntry {
    if OSPath.from(raw).is_dir() {
        if resolve_bare_entry(cmd, OSPath.from(raw), member_flag, mode, use_override) == .Val(entry) {
            if checked_explicit_file(entry.path).is_some() -> return entry
        }
    }
    jet_cli_resolved_entry_file(OSPath.from(resolve_source_path(raw)))
}
// Rust: Source/main.rs:6203
pub fn resolve_source_path(raw: String) -> String {
    path :: OSPath.from(raw)
    if Authority.AuthorityResolver.open(path) == {
        .Ok(resolver) -> {
            entry :: jet_cli_find_project_entry(resolver.root()) ?? report_project_entry_error(err)
            if entry.strip_prefix(resolver.root()) == .Ok(relative) {
                if resolver.checked_file(relative) == {
                    .Ok(file) -> { resolver.revalidate_file(file) ?? report_entry_authority_error(err); return file.path.to_string_lossy().to_string() }
                    .Err(error) -> { if !error.is_missing() -> report_entry_authority_error(error) }
                }
            }
            has_package :: if resolver.checked_manifest(OSPath.from(".")) == {
                .Ok(_) -> true
                .Err(error) -> { if !error.is_missing() -> report_entry_authority_error(error); false }
            }
            if !has_package { cli_error!("E2105", "no `{Syntax.DEFAULT_ENTRY_FILE}` entry in `{raw}`"); exit(ExitCodes.USER_ERROR) }
            return entry.to_string_lossy().to_string()
        }
        .Err(error) -> {
            if !error.is_missing() {
                if error == { .WrongKind(_) -> {}; _ -> report_entry_authority_error(error) }
            }
        }
    }
    if checked_explicit_file(path) == .Val(checked) -> return keep_typed_spelling(raw, checked)
    with_ext :: "{raw}.{Syntax.FILE_EXT}"
    if checked_explicit_file(OSPath.from(with_ext)) == .Val(checked) -> return keep_typed_spelling(with_ext, checked)
    raw
}
// Rust: Source/main.rs:6253-6265
// ResolvedEntry and its file constructor reuse Entry/Project.jet's canonical
// JetCLIResolvedEntry and jet_cli_resolved_entry_file, preserving native paths.
// Rust: Source/main.rs:6287
// Typed relative spelling is kept only when canonical equality proves identity.
fn keep_typed_spelling(typed: String, checked: OSPath) -> String {
    path :: OSPath.from(typed)
    // GATE #4494: physical canonicalization for diagnostic spelling identity.
    if !path.is_absolute() && fs.canonicalize(path).is_ok_and(resolved -> resolved == checked) -> return typed
    checked.to_string_lossy().to_string()
}
// Rust: Source/main.rs:6295
fn checked_explicit_file(path: OSPath) -> OSPath? {
    parent :: path.parent().unwrap_or(OSPath.from("."))
    resolver :: if Authority.AuthorityResolver.open(parent) == {
        .Ok(resolver) -> resolver
        .Err(error) -> { if error.is_missing() -> return None; report_entry_authority_error(error) }
    }
    name :: path.file_name() ?? return None
    if resolver.checked_file(OSPath.from(name)) == {
        .Ok(file) -> Val(file.path)
        .Err(error) -> { if error.is_missing() -> None else -> report_entry_authority_error(error) }
    }
}
// Rust: Source/main.rs:6314-6316
