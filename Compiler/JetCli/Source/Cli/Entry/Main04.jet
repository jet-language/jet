    emit_cli_diagnostics(entry, source, diagnostics)
    exit(ExitCodes.USER_ERROR)
}
// Rust: Source/main.rs:6486
fn report_build_resolution_error(error: String) -> Never {
    if error.contains("two build entries for the package:") -> cli_error!(@full "E3520", error, "one package has exactly one build entry so policy and provenance have one auditable home", "keep one `fn build` and remove every other entry")
    else -> cli_error!(@fix "E1334", error, "repair the package source and try the build again")
    exit(ExitCodes.USER_ERROR)
}
// Rust: Source/main.rs:6498
fn resolve_named_build_member(cwd: OSPath, wanted: String) -> ResolvedEntry? Err! {
    resolver :: Authority.AuthorityResolver.open(cwd).ok() ?? return Ok(None)
    source :: resolver.resolve_workspace_source().ok().flatten() ?? return Ok(None)
    if source.role != WorkspaceFile.WorkspaceSourceRole.Index -> return Ok(None)
    plan :: WorkspaceFile.evaluate_checked_source(source, resolver).ok() ?? return Ok(None)
    member :: plan.members.iter().find(member -> member.name == wanted) ?? return Ok(None)
    resolve_member_build_entry(cwd.join(member.path))
}
// Rust: Source/main.rs:6517
fn resolve_member_build_entry(root: OSPath) -> ResolvedEntry? Err! {
    member_resolver :: Authority.AuthorityResolver.open(root).map_err(error -> error.to_string())?
    checked :: member_resolver.checked_manifest(OSPath.from(".")).map_err(error -> error.to_string())?
    entry :: checked.facts.resolve_build_entry_checked(member_resolver).map_err(error -> error.to_string())? ?? return Ok(None)
    Ok(Val(jet_cli_resolved_entry_file(entry.path)))
}
// Rust: Source/main.rs:6555
// Shared bare entry rule; checked workspace authority precedes package fallback.
fn resolve_bare_entry(cmd: String, cwd: OSPath, member_flag: String?, mode: OutputMode, use_override: Bool) -> ResolvedEntry? {
    workspace_resolver :: if Authority.AuthorityResolver.open(cwd) == {
        .Ok(resolver) -> Val(resolver)
        .Err(error) -> { if error.is_missing() -> None else -> report_entry_authority_error(error) }
    }
    workspace_source :: workspace_resolver.map(fn(resolver) {
        resolver.resolve_workspace_source().map_err(error -> error.workspace_diagnostic())
    })
    no_source :: if workspace_source == { .None | .Val(.Ok(.None)) -> true; _ -> false }
    if no_source {
        stale_workspace_lock :: if workspace_resolver == {
            .Val(resolver) -> {
                if resolver.checked_file(OSPath.from(Syntax.UNIFIED_LOCK_FILE)) == {
                    .Ok(lock_file) -> {
                        source :: lock_file.text() ?? report_entry_authority_error(err)
                        resolver.revalidate_file(lock_file) ?? report_entry_authority_error(err)
                        WorkspaceLock.load_checked_file(resolver, lock_file).is_none() && Lock.looks_like_workspace_lock(source)
                    }
                    .Err(error) -> { if error.is_missing() -> false else -> report_entry_authority_error(error) }
                }
            }
            .None -> false
        }
        if stale_workspace_lock {
            lock_path :: cwd.join(Syntax.UNIFIED_LOCK_FILE)
            diagnostic :: Lock.e1202_workspace(lock_path.display().to_string())
            emit_cli_diagnostics(Syntax.WORKSPACE_FILE, "", [diagnostic])
            exit(ExitCodes.USER_ERROR)
        }
    }
    if cmd == "build" && member_flag.is_none() {
        if workspace_source == .Val(.Ok(.Val(source))) {
            if source.role == WorkspaceFile.WorkspaceSourceRole.Index -> return Val(jet_cli_resolved_entry_file(source.path))
        }
    }
    workspace :: if (workspace_resolver, workspace_source) == {
        (.Val(resolver), .Val(.Ok(.Val(source)))) if source.role == WorkspaceFile.WorkspaceSourceRole.Index -> Val(WorkspaceFile.evaluate_checked_source(source, resolver))
        (_, .Val(.Err(diagnostic))) -> Val(Err(diagnostic))
        _ -> None
    }
    canonical_workspace :: if workspace_source == { .Val(.Ok(.Val(source))) -> source.role == WorkspaceFile.WorkspaceSourceRole.Index; _ -> false }
    if canonical_workspace && workspace.is_none() {
        diagnostic :: Diagnostic.error("E3503", "workspace source in `{cwd.display()}` disappeared", "workspace authority changed while the entry was being selected", "restore the workspace declaration before running the command", None)
        emit_cli_diagnostics(Syntax.WORKSPACE_FILE, "", [diagnostic])
        exit(ExitCodes.USER_ERROR)
    }
    if workspace == .Val(workspace) {
        plan :: if workspace == {
            .Ok(plan) -> plan
            .Err(diagnostic) -> {
                if cmd == "build" && member_flag.is_none() {
                    if workspace_source == .Val(.Ok(.Val(source))) {
                        if source.role == WorkspaceFile.WorkspaceSourceRole.Index -> return Val(jet_cli_resolved_entry_file(source.path))
                    }
                }
                emit_cli_diagnostics(Syntax.WORKSPACE_FILE, "", [diagnostic])
                exit(ExitCodes.USER_ERROR)
            }
        }
        runnable := [(String, ResolvedEntry)]{}
        loop member in plan.members {
            root :: cwd.join(member.path)
            stock :: if cmd == "build" -> resolve_member_build_entry(root) ?? report_build_resolution_error(err)
            else -> {
                entry :: jet_cli_find_project_entry_with_callable(root) ?? report_project_entry_error(err)
                checked_explicit_file(entry.path).map(_ -> entry)
            }
            entry :: if use_override -> command_override_entry(root, cmd, mode).or(stock) else -> stock
            if entry == .Val(entry) -> runnable.push((member.name, entry))
        }
        if member_flag == .Val(want) {
            if runnable.iter().find(pair -> pair.0 == want) == .Val(found) -> return Val(found.1)
            names :: plan.members.iter().map(member -> member.name).collect()
            if cmd == "jobs" -> cli_error!(@fix "E2104", "no workspace member named `{want}`", "list jobs for one of: {names.join(", ")}")
            else -> cli_error!(@fix "E2104", "no workspace member named `{want}`", "pick one of: {names.join(", ")}")
            exit(ExitCodes.USAGE)
        }
        if runnable.len() == 1 -> return Val(runnable[0].1)
        if runnable.len() >= 2 {
            names :: runnable.iter().map(pair -> pair.0).collect()
            if cmd == "jobs" {
                cli_error!(@full "E2104", "`jet jobs` is ambiguous — this workspace has {names.len()} members with entry files", "jobs are listed for one member at a time: {names.join(", ")}", "pick one with `jet jobs -p <member>`")
                exit(ExitCodes.USAGE)
            }
            cli_error!(@full "E2104", "`jet {cmd}` is ambiguous — {names.len()} workspace members can run", "this workspace declares multiple runnable members: {names.join(", ")}", "pick one with `jet {cmd} -p <member>`, or run its file directly")
            exit(ExitCodes.USAGE)
        }
    }
    if Loader.find_package_root_checked(cwd) == {
        .Ok(.Val(root)) -> Val(find_command_entry_with_callable(root, cmd, mode, use_override))
        .Ok(.None) -> None
        .Err(diagnostic) -> report_entry_diagnostic(diagnostic)
    }
}
