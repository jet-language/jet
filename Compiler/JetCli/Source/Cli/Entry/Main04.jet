// Rust: Source/main.rs:6474
fn report_entry_authority_error(error: Authority.AuthorityError) -> Never {
    emit_cli_diagnostics(Syntax.PACKAGE_FILE, "", [error.diagnostic()])
    exit(ExitCodes.USER_ERROR)
}
// Canonical project selection errors keep their diagnostics and exit at the host.
fn report_project_entry_error(error: JetCLIProjectEntryError) -> Never {
    if error == {
        .Authority(error) -> report_entry_authority_error(error)
        .Output(error, fix) -> { cli_error!(@fix "E2105", error.message, fix); exit(ExitCodes.USER_ERROR) }
        .Diagnostics(path, diagnostics) -> { emit_cli_diagnostics(path, "", diagnostics); exit(ExitCodes.USER_ERROR) }
    }
}
