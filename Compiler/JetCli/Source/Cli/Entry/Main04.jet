fn command_override_entry(root: OSPath, command: String, mode: OutputMode) -> ResolvedEntry? {
    if command != "run" && command != "dev" && command != "build" && command != "test" -> return None
    resolve_package_command_override(root, command, mode).map(path -> ResolvedEntry{path: path, callable: Val(command)})
}
