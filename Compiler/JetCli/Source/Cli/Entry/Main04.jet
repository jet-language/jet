// Rust: Source/main.rs:6936
pub fn report_problems_with_summary(mode: OutputMode, file: String, src: String, diags: [Diagnostic], summary: fn(Int) -> String) -> {
    hide_advisories :: !advisory_lints_visible()
    if hide_advisories && !diags.iter().any(diagnostic -> diagnostic.severity != Severity.Lint) -> return
    filtered :: if hide_advisories -> Val(diags.iter().filter(diagnostic -> diagnostic.severity != Severity.Lint).collect()) else -> None
    visible :: filtered.unwrap_or(diags)
    if visible.is_empty() -> return
    if mode.json {
        machine_file :: machine_report_path_for_process(file)
        clears :: jet.Diagnostics.report_clear_counts(visible)
        reports :: visible.iter().zip(clears).map(pair -> pair.0.to_report_with_clears(machine_file, src, pair.1))
        ok :: visible.iter().all(diagnostic -> diagnostic.severity == Severity.Lint)
        rendered :: render_status_with_reports("diagnostics", ok, reports, StatusFields.new())
        write_mode_machine(mode, "{rendered}\n")
        return
    }
    rendered :: render_all_linked(file, src, visible, mode.color_stderr(), mode.hyperlinks_stderr())
    write_mode_diagnostic(mode, rendered)
    write_mode_diagnostic(mode, "\n{summary(visible.len())}\n")
    if visible.first() == .Val(first) -> write_mode_diagnostic(mode, "{Explain.pointer_line(first.code, mode.color_stderr())}\n")
}
// Rust: Source/main.rs:7005
pub fn machine_report_path_for_process(file: String) -> ReportPath { ReportPath.from_process(file) }
// Rust: Source/main.rs:7012
pub fn machine_report_path_for_entry(entry_file: String, display: String) -> ReportPath {
    if display.is_empty() || display.starts_with('<') || OSPath.from(display).is_absolute() -> return ReportPath.from_process(display)
    entry_report :: machine_report_path_from_path(OSPath.from(entry_file))
    entry :: OSPath.from(entry_report.as_str())
    base :: entry.parent().unwrap_or(OSPath.from("."))
    root :: Loader.find_manifest_root(base).unwrap_or(base)
    machine_report_path_from_path(root.join(display))
}
// Rust: Source/main.rs:7026
pub fn machine_report_path_for_bundle(bundle: AST.ProgramBundle, display: String) -> ReportPath {
    if display.is_empty() || display.starts_with('<') || OSPath.from(display).is_absolute() -> return ReportPath.from_process(display)
    path :: bundle.modules.iter().find(module -> module.display == display).map(module -> module.path).unwrap_or_else(fn() { bundle.project_root.join(display) })
    machine_report_path_from_path(path)
}
