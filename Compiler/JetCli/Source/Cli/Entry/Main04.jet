//RS /// Keep the spelling the caller typed when it names the same file the authority
//RS /// check validated.
//RS ///
//RS /// The point of `checked_explicit_file` is the authority check; its canonical
//RS /// absolute path is not. Returning that path made every human diagnostic
//RS /// locator carry the checkout location (`--> /home/…/tests/ui/x.jet:6:4`) and
//RS /// disagree with `jet dev`, which never resolves and so renders the argument as
//RS /// typed — two verbs, two locators, one diagnostic. The absolute form stays the
//RS /// *machine* representation, which `machine_report_path_for_process` builds on
//RS /// its own for `--json`.
//RS ///
//RS /// A relative entry runs the whole pipeline: `jet dev` already hands its raw
//RS /// argument to the loader, sema, the JIT, the watcher, and the cache, and
//RS /// `find_manifest_root` canonicalizes its start before walking up.
//RS ///
//RS /// The canonical-equality guard is what makes this safe rather than merely
//RS /// shorter: it proves the typed spelling and the validated path name the same
//RS /// file. A spelling that reaches the file through a symlink or `..` — or an
//RS /// argument the caller already wrote absolute — keeps the validated path, so
//RS /// nothing downstream is ever pointed at a spelling the resolver did not check.
//RS fn keep_typed_spelling(typed: &str, checked: &Path) -> String {
//RS     let path = Path::new(typed);
//RS     if !path.is_absolute() && fs::canonicalize(path).is_ok_and(|resolved| resolved == checked) {
//RS         return typed.to_string();
//RS     }
//RS     checked.to_string_lossy().into_owned()
//RS }
