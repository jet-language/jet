// Rust: Source/main.rs:7121
fn run_split(args: [String], raw: [String], mode: OutputMode) -> Never {
    target :: if args.get(1) == {
        .Val("env") -> Transition.SplitTarget.Environment
        .Val("package") -> {
            name :: args.get(2) ?? { cli_error!("E2104", "jet split package needs a Package name"); exit(ExitCodes.USAGE) }
            Transition.SplitTarget.Package{name: name}
        }
        .Val("hosts") -> {
            name :: args.get(2) ?? { cli_error!("E2104", "jet split hosts needs a host name"); exit(ExitCodes.USAGE) }
            Transition.SplitTarget.Hosts{name: name}
        }
        .Val(other) -> { cli_error!(@fix "E2101", "unknown split target {other}", "use jet split env, jet split package <name>, or jet split hosts <name>"); exit(ExitCodes.USAGE) }
        .None -> { cli_error!("E2104", "jet split needs a target"); exit(ExitCodes.USAGE) }
    }
    check_only :: raw.iter().any(arg -> arg == "--check")
    cwd :: env.current_dir().unwrap_or_else(_ -> OSPath.from(".")) // GATE #4494
    if Transition.split(cwd, target, check_only) == {
        .Ok(result) -> print_transition_result(result, check_only, mode)
        .Err(error) -> report_transition_error(error)
    }
}
// Rust: Source/main.rs:7159
fn run_fold(args: [String], raw: [String], mode: OutputMode) -> Never {
    path :: args.get(1) ?? { cli_error!(@fix "E2104", "jet fold needs a generated transition path", "use jet fold package/env.jet or jet fold packages/name/package.jet"); exit(ExitCodes.USAGE) }
    check_only :: raw.iter().any(arg -> arg == "--check")
    cwd :: env.current_dir().unwrap_or_else(_ -> OSPath.from(".")) // GATE #4494
    if Transition.fold(cwd, OSPath.from(path), check_only) == {
        .Ok(result) -> print_transition_result(result, check_only, mode)
        .Err(error) -> report_transition_error(error)
    }
}
// Rust: Source/main.rs:7172
fn print_transition_result(result: Transition.TransitionResult, check_only: Bool, mode: OutputMode) -> Never {
    if mode.json {
        changes :: StatusValue.array(result.summary.changes.iter().map(change -> StatusValue.object(StatusFields.new().with("path", change.path.to_string_lossy().to_string()).with("action", change.action))))
        payload :: render_status("fold", true, StatusFields.new().with("operation", result.summary.operation)
            .with("check", check_only).with("before", result.summary.before_fingerprint).with("after", result.summary.after_fingerprint)
            .with("journal", result.summary.journal.to_string_lossy().to_string()).with("changes", changes))
        write_mode_machine(mode, "{payload}\n")
    } else {
        loop change in result.summary.changes {
            line :: if check_only -> "Would {change.action}: {change.path.display()}" else -> "{change.action}d {change.path.display()}."
            write_mode_status(mode, "{line}\n")
        }
        if result.summary.before_fingerprint == result.summary.after_fingerprint -> write_mode_status(mode, "package graph unchanged: {result.summary.after_fingerprint}\n")
        else {
            write_mode_status(mode, "package graph before: {result.summary.before_fingerprint}\n")
            write_mode_status(mode, "package graph after: {result.summary.after_fingerprint}\n")
        }
        if check_only -> write_mode_status(mode, "No files changed.\n")
        else -> write_mode_status(mode, "Transition journal: {result.summary.journal.display()}\n")
    }
    exit(ExitCodes.OK)
}
