use jet.[Syntax, ExitCodes, Package, Lexer, Parser, ScriptDeps, Loader, Manifest]
use jetpack.[Transition, JetPin, ScriptLock]
use std.[fs, env]
use std.process.[exit]
use crate.[OutputMode, cli_error, emit_cli_report, emit_cli_diagnostics, print_transition_result, write_mode_status, write_mode_diagnostic, print_toolchain_diag, resolve_source_path, report_problems, JET_VERSION]

// Rust: Source/main.rs:7201-7248
// The transition-result continuation is part of Main04.print_transition_result.

// Rust: Source/main.rs:7250
pub fn report_transition_error(error: Transition.TransitionError) -> Never {
    message :: error.0
    (code, why, fix) :: if message.contains("pkg.jet") || message.contains("retired") {
        ("E1226", "the package transition accepts only the current package manifest and its recorded migration path.", "rename the retired manifest to `package.jet`, or run `jet init --check` in the project root.")
    } else if message.contains("already exists") {
        ("E1252", "a transition never overwrites an existing package manifest or generated role file.", "review the existing file, or run the transition in an empty package root.")
    } else if message.contains("journal") || message.contains("fingerprint") {
        ("E1204", "a recorded package transition no longer matches the files on disk, so Jet refuses a stale or tampered replay.", "restore the recorded files or remove the stale transition journal and make a fresh checked transition.")
    } else {
        ("E1206", "the package manifest or transition input does not have the required typed shape.", "fix the named package or role file, then rerun the transition with `--check` first.")
    }
    emit_cli_report(code, message.to_string(), why.to_string(), fix.to_string(), false)
    exit(ExitCodes.USER_ERROR)
}

// Rust: Source/main.rs:7287
pub fn run_init(script: String?, raw: [String], mode: OutputMode) -> Never {
    // GATE #4494: native working directory.
    cwd :: env.current_dir().unwrap_or_else(_ -> OSPath.from("."))
    if raw.iter().any(arg -> arg == "--restore-role-files") {
        check_only :: raw.iter().any(arg -> arg == "--check")
        match Transition.restore_role_files(cwd, check_only) {
            .Ok(result) -> print_transition_result(result, check_only, mode)
            .Err(error) -> {
                cli_error("E2105", "{error}")
                exit(ExitCodes.USER_ERROR)
            }
        }
    }
    if raw.iter().any(arg -> arg == "--check") {
        has_role_file :: ["pkg.jet", "env.jet", "workspace.jet", "config.jet"].iter().any(name -> cwd.join(name).is_file())
        if has_role_file {
            match Transition.init(cwd, true) {
                .Ok(result) -> print_transition_result(result, true, mode)
                .Err(error) -> {
                    cli_error("E2105", "{error}")
                    exit(ExitCodes.USER_ERROR)
                }
            }
        }
        write_mode_status(mode, "No migration-era role files found.\nNo files changed.\n")
        exit(ExitCodes.OK)
    }
    if script.is_none() && ["pkg.jet", "env.jet", "workspace.jet", "config.jet"].iter().any(name -> cwd.join(name).is_file()) && !cwd.join(Syntax.PACKAGE_FILE).is_file() {
        match Transition.init(cwd, false) {
            .Ok(result) -> print_transition_result(result, false, mode)
            .Err(error) -> {
                cli_error("E2105", "{error}")
                exit(ExitCodes.USER_ERROR)
            }
        }
    }
    name :: cwd.file_name().and_then(name -> name.to_str()).unwrap_or("app").to_string()
    match JetPin.write_init(cwd, name, JET_VERSION) {
        .Ok(msg) -> {
            if source :: script { lift_inline_deps_into_manifest(cwd, source, mode) }
            write_mode_status(mode, "{msg}\n")
            exit(ExitCodes.OK)
        }
        .Err(diagnostic) -> {
            print_toolchain_diag(diagnostic, mode)
            exit(ExitCodes.USER_ERROR)
        }
    }
}

// Rust: Source/main.rs:7354
// Fold inline dependencies into the newly written manifest using the comment-preserving editor.
fn lift_inline_deps_into_manifest(cwd: OSPath, script: String, mode: OutputMode) -> {
    script_path :: resolve_source_path(script)
    // GATE #4494: native source and manifest reads/writes.
    src :: fs.read_to_string(script_path).ok() ?? return
    (source_for_parse, _) :: Package.mask_inline_package_source(src).ok() ?? return
    (toks, lex_diags) :: Lexer.lex(source_for_parse)
    if !lex_diags.is_empty() { return }
    prog :: Parser.parse_with_source(toks, source_for_parse).ok() ?? return
    deps :: ScriptDeps.collect(prog)
    if deps.is_empty() { return }
    manifest_path :: Loader.manifest_path(cwd) ?? return
    raw := fs.read_to_string(manifest_path).ok() ?? return
    loop dep in deps {
        raw = Manifest.add_dependency(raw, dep.name, Manifest.DepSpec.Registry(dep.selector.clone()))
    }
    if fs.write(manifest_path, raw).is_ok() {
        suffix :: if deps.len() == 1 -> "y" else -> "ies"
        name :: manifest_path.file_name().and_then(name -> name.to_str()).unwrap_or("package.jet")
        write_mode_status(mode, "lifted {deps.len()} inline dependenc{suffix} into {name}\n")
    }
}

// Rust: Source/main.rs:7408
// Lock a manifest-less script's inline dependencies against its content hash.
pub fn run_lock(script: String?, mode: OutputMode) -> {
    raw_arg :: script ?? {
        cli_error("E2104", "`jet fetch --lock` needs a script path, e.g. `jet fetch --lock stats.jet`")
        exit(ExitCodes.USER_ERROR)
    }
    file :: resolve_source_path(raw_arg)
    script_path :: OSPath.from(file)
    script_dir :: script_path.parent().unwrap_or(OSPath.from("."))
    if Loader.find_manifest_root(script_dir).is_some() {
        cli_error("E1202", "`{file}` belongs to a project with a `{Syntax.PACKAGE_FILE}` — use `jet fetch` to lock its dependencies")
        exit(ExitCodes.USER_ERROR)
    }
    // GATE #4494: native script read and lock sidecar write.
    src :: match fs.read_to_string(file) {
        .Ok(source) -> source
        .Err(error) -> {
            cli_error("E2105", "couldn't read `{file}`: {error}")
            exit(ExitCodes.USER_ERROR)
        }
    }
    source_for_parse :: match Package.mask_inline_package_source(src) {
        .Ok((masked, _)) -> masked
        .Err(error) -> {
            report_problems(mode, file, src, [error.diagnostic()])
            exit(ExitCodes.USER_ERROR)
        }
    }
    (toks, lex_diags) :: Lexer.lex(source_for_parse)
    if !lex_diags.is_empty() {
        report_problems(mode, file, src, lex_diags)
        exit(ExitCodes.USER_ERROR)
    }
    prog :: match Parser.parse_with_source(toks, source_for_parse) {
        .Ok(program) -> program
        .Err(diags) -> {
            report_problems(mode, file, src, diags)
            exit(ExitCodes.USER_ERROR)
        }
    }
    deps :: ScriptDeps.collect(prog)
    locked: [ScriptLock.LockedInlineDep] = []
    loop dep in deps {
        match ScriptDeps.resolve(dep, script_dir) {
            .Ok(resolved) -> locked.push(ScriptLock.LockedInlineDep {
                name: resolved.name,
                selector: resolved.selector,
                resolved: resolved.resolved_version,
                content_hash: resolved.content_hash,
            })
            .Err(reason) -> {
                diagnostic :: ScriptDeps.e1253(dep, reason)
                report_problems(mode, file, src, [diagnostic])
                exit(ExitCodes.USER_ERROR)
            }
        }
    }
    script_hash :: ScriptDeps.file_hash(script_path).unwrap_or_default()
    lock :: ScriptLock.ScriptLockFile {
        version: ScriptLock.SCRIPT_LOCK_VERSION,
        script_hash: script_hash,
        deps: ^locked,
    }
    match ScriptLock.write(script_path, lock) {
        .Ok(_) -> {
            write_mode_status(mode, "wrote {ScriptLock.sidecar_path(script_path).display()}\n")
            exit(ExitCodes.OK)
        }
        .Err(error) -> {
            cli_error("E2105", "couldn't write the lock sidecar: {error}")
            exit(ExitCodes.USER_ERROR)
        }
    }
}

// Rust: Source/main.rs:7500
// The only command that moves the toolchain pin.
pub fn run_update_jet(channel: String?, mode: OutputMode) -> Never {
    // GATE #4494: native working directory.
    cwd :: env.current_dir().unwrap_or_else(_ -> OSPath.from("."))
    root :: require_manifest_root(cwd, "error: `jet update jet` needs a project — no `package.jet` found here or above")
    match JetPin.move_pin(root, channel, JET_VERSION) {
        .Ok(msg) -> {
            write_mode_status(mode, "{msg}\n")
            exit(ExitCodes.OK)
        }
        .Err(diagnostic) -> {
            print_toolchain_diag(diagnostic, mode)
            exit(ExitCodes.USER_ERROR)
        }
    }
}

// Rust: Source/main.rs:7518
pub fn flag_value(args: [String], flag: String) -> String? {
    iter := args.iter()
    loop a :: iter.next() {
        if a == flag { return iter.next() }
    }
    none
}

// Rust: Source/main.rs:7528
pub fn test_option_value(args: [String], flag: String) -> String? {
    prefix :: "{flag}="
    loop (index, arg) in args.iter().enumerate() {
        if value :: arg.strip_prefix(prefix) { return value.to_string() }
        else if arg == flag { return args.get(index + 1).cloned() }
    }
    none
}

// Rust: Source/main.rs:7546
// Teach E1226 for retired manifests instead of a generic missing-package hint.
pub fn require_manifest_root(cwd: OSPath, fallback_hint: String) -> OSPath {
    match Loader.find_package_root_checked(cwd) {
        .Ok(root) -> {
            if path :: root { return path }
            mode :: OutputMode { json: false, color: jet.Diagnostics.ColorChoice.Never, quiet: false }
            match Loader.stale_manifest_name_message(cwd) {
                .Some(msg) -> write_mode_diagnostic(mode, msg)
                .None -> write_mode_diagnostic(mode, "{fallback_hint}\n")
            }
            exit(ExitCodes.USER_ERROR)
        }
        .Err(diagnostic) -> {
            emit_cli_diagnostics(Syntax.PACKAGE_FILE, "", [diagnostic])
            exit(ExitCodes.USER_ERROR)
        }
    }
}
