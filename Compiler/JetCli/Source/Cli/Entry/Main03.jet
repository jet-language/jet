//RS /// Resolve a source-path argument, allowing the `.jet` extension to be omitted
//RS /// (ext-optional CLI). If `raw` exists as-is, use it. Otherwise, if `raw.jet`
//RS /// exists, use that. If neither exists, return `raw` unchanged so the normal
//RS /// file-not-found diagnostic fires with the original name the user typed.
//RS /// D-WEBDEFAULT1 (ratified 2026-07-01, c134): resolve the effective `--target=` value for
//RS /// `file`. Precedence: an explicit CLI flag always wins; else the canonical Package
//RS /// context's `target: "web"` (inline in the entry or a managed package's package.jet);
//RS /// else a lightweight parse of `file` for a top-level `#Target(Web)` marker (a loose
//RS /// file's own default, for standalone examples with no manifest at all).
//RS /// Reparses the file/manifest — wasteful compared to threading the fact
//RS /// through the real compile pipeline, but `jet` recompiles from scratch on
//RS /// every invocation anyway (no incremental compilation), so a couple of
//RS /// extra cheap lex+parse passes are negligible, and it keeps this CLI-only
//RS /// concern out of `ProgramBundle`/codegen entirely.
//RS ///
//RS /// `jet run` also resolves the package/file web default so the execution
//RS /// boundary can reject it with a teaching diagnostic before attempting a
//RS /// native build. `jet dev` and `jet build` keep the same default resolution.
//RS fn effective_target(_cmd: &str, file: &str, explicit: Option<&str>) -> Option<String> {
//RS     if explicit.is_some() {
//RS         return explicit.map(str::to_string);
//RS     }
//RS     if let Some(target) = manifest_default_target(file) {
//RS         return Some(target);
//RS     }
//RS     let src = fs::read_to_string(file).ok()?;
//RS     let src = jet::Package::mask_inline_package_source(&src).ok()?.0;
//RS     let (toks, lex_diags) = jet::Lexer::lex(&src);
//RS     if !lex_diags.is_empty() {
//RS         return None;
//RS     }
//RS     let prog = jet::Parser::parse_with_source(&toks, &src).ok()?;
//RS     prog.default_target
//RS }
