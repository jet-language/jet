// Rust: Source/main.rs:5049
pub fn parse_build_verify(args: [String]) -> String? Err! {
    artifact := none
    index := 0
    loop index < args.len() {
        argument :: args[index]
        value := none
        if inline :: argument.strip_prefix("--verify=") {
            if inline.is_empty() { return .Err("`--verify` needs a receipt id") }
            value = inline.to_string()
        } else if argument == "--verify" {
            following :: args.get(index + 1).filter(|value| -> !value.is_empty() && !value.starts_with('-'))
                ?? return .Err("`--verify` needs a receipt id")
            index += 1
            value = following.to_string()
        }
        if receipt :: value {
            if artifact.is_some() { return .Err("`--verify` may be specified only once") }
            artifact = receipt
        }
        index += 1
    }
    .Ok(artifact)
}

// Rust: Source/main.rs:5082
// --watch=off overrides every enabling occurrence; bare run remains one-shot.
pub fn run_wants_watch(raw: [String]) -> Bool {
    if raw.iter().any(|arg| -> arg == "--watch=off") { return false }
    raw.iter().any(|arg| -> arg == "--watch" || arg == "--watch=on" || arg == "--watch=true" || arg.starts_with("--watch=") && arg != "--watch=off")
}

// Rust: Source/main.rs:5113
// Explicit CLI target, then package web profile, then the loose source marker.
// GATE #4494: native source read.
pub fn effective_target(_cmd: String, file: String, explicit: String?) -> String? {
    if explicit.is_some() { return explicit }
    if target :: manifest_default_target(file) { return target }
    source :: fs.read_to_string(OSPath.from(file)).ok() ?? return none
    (masked, _) :: Package.mask_inline_package_source(source).ok() ?? return none
    (tokens, diagnostics) :: Lexer.lex(masked)
    if !diagnostics.is_empty() { return none }
    program :: Parser.parse_with_source(tokens, masked).ok() ?? return none
    program.default_target
}

// Rust: Source/main.rs:5134
// App-returning run entries use the native serving edge; ordinary Web run is refused.
pub fn reject_native_web_run(command: String, file: String, target: String?, mode: OutputMode) -> {
    if command == "run" && target == Syntax.BUILD_TARGET_WEB && !entry_returns_app(file) {
        emit_cli_row("E-WEB-RUN", [], mode.json)
        exit(ExitCodes.USER_ERROR)
    }
}

// Rust: Source/main.rs:5146
// GATE #4483: canonical native execution host triple (not the cross-build target).
pub fn native_run_target(command: String, file: String, target: String?) -> String? {
    host :: TargetLayout.host_triple()
    if command == "run" && (target == host || target == Syntax.BUILD_TARGET_WEB && entry_returns_app(file)) {
        none
    } else { target }
}

// Rust: Source/main.rs:5164
// A cheap parser failure means no dev override; compilation owns diagnostics.
pub fn has_dev_entry_fn(file: String) -> Bool {
    source :: fs.read_to_string(OSPath.from(file)).ok() ?? return false
    (masked, _) :: Package.mask_inline_package_source(source).ok() ?? return false
    (tokens, diagnostics) :: Lexer.lex(masked)
    if !diagnostics.is_empty() { return false }
    program :: Parser.parse_with_source(tokens, masked).ok() ?? return false
    program.items.iter().any(|item| -> match item {
        .Func(function) -> function.name == "dev"
        _ -> false
    })
}

// Rust: Source/main.rs:5186
pub fn entry_returns_app(file: String) -> Bool {
    source :: fs.read_to_string(OSPath.from(file)).ok() ?? return false
    (masked, _) :: Package.mask_inline_package_source(source).ok() ?? return false
    (tokens, diagnostics) :: Lexer.lex(masked)
    if !diagnostics.is_empty() { return false }
    program :: Parser.parse_with_source(tokens, masked).ok() ?? return false
    AST.app_entry_run_fn(program.items).is_some()
}

// Rust: Source/main.rs:5208
pub fn manifest_default_target(file: String) -> String? {
    path :: OSPath.from(file)
    if !path.is_file() { return none }
    manifest :: match Loader.package_facts_for_entry(path) {
        .Ok(value) -> value ?? return none
        .Err(diagnostics) -> report_entry_diagnostics(path, diagnostics)
    }
    profile :: manifest.target_profile("web") ?? return none
    match profile {
        .WebBrowser | .WebWasiServer | .WebNoOs -> Syntax.BUILD_TARGET_WEB.to_string()
        _ -> none
    }
}

// Rust: Source/main.rs:5231
pub fn job_registry_for_entry(entry: OSPath, mode: OutputMode) -> JobRegistry {
    display :: entry.to_string_lossy().to_string()
    source :: fs.read_to_string(entry).unwrap_or_default()
    (diagnostics, maybe_bundle, _) :: Driver.check_file_with_effect_facts_for_run(display, "dev", [:])
    errors :: diagnostics.iter().filter(|diagnostic| -> diagnostic.severity == Diagnostics.Severity.Error).to_list()
    if !errors.is_empty() {
        report_problems(mode, display, source, errors)
        exit(ExitCodes.USER_ERROR)
    }
    bundle :: maybe_bundle ?? {
        report_problems(mode, display, source, [])
        exit(ExitCodes.USER_ERROR)
    }
    JobRegistry.for_entry(bundle)
}

// Rust: Source/main.rs:5254
pub fn reject_job_graph(entry: OSPath, reason: String, mode: OutputMode) -> Never {
    emit_cli_report("E1331", "Invalid job graph in `{entry.display()}`: {reason}",
        "checked #Job dependencies and execution bounds must form one valid graph",
        "remove unknown, ambiguous, or cyclic dependencies and use a positive `parallel` bound", mode.json)
    exit(ExitCodes.USER_ERROR)
}

// Rust: Source/main.rs:5266
// GATE #4494: canonical native path metadata and symlink resolution.
pub fn validate_job_registry(entry: OSPath, registry: JobRegistry, mode: OutputMode) -> {
    loop job in registry.jobs() {
        cwd :: job.cwd ?? next
        cwd_path :: OSPath.from(cwd)
        if cwd_path.is_absolute() || cwd_path.components().any(|component| -> component == Component.ParentDir) {
            emit_cli_report("E1330", "job `{job.name}` has an unsafe cwd",
                "checked #Job dependencies and execution bounds must form one valid graph",
                "use a project-relative path without `..`", mode.json)
            exit(ExitCodes.USER_ERROR)
        }
        resolved :: job_base_directory(entry, job)
        if resolved.exists() {
            project :: job_project_directory(entry)
            root :: project.canonicalize().unwrap_or_else(|_| -> project)
            canonical :: resolved.canonicalize().unwrap_or_else(|_| -> resolved)
            if !canonical.starts_with(root) {
                emit_cli_report("E1330", "job `{job.name}` has an unsafe cwd",
                    "checked #Job dependencies and execution bounds must form one valid graph",
                    "use an existing project-relative directory without symlink escapes", mode.json)
                exit(ExitCodes.USER_ERROR)
            }
        }
    }
    if reason :: registry.validate_graph().err() { reject_job_graph(entry, reason, mode) }
}

// Rust: Source/main.rs:5315
pub fn validate_job_working_directories(entry: OSPath, registry: JobRegistry, mode: OutputMode) -> {
    loop job in registry.jobs() {
        if job.cwd.is_some() {
            resolved :: job_base_directory(entry, job)
            if !resolved.is_dir() {
                emit_cli_report("E1330", "job `{job.name}` has a non-directory cwd",
                    "job cwd `{resolved.display()}` is not a directory",
                    "use an existing project-relative directory for `cwd`", mode.json)
                exit(ExitCodes.USER_ERROR)
            }
        }
    }
}

// Rust: Source/main.rs:5337
pub fn job_project_directory(entry: OSPath) -> OSPath {
    entry_dir :: entry.parent().unwrap_or_else(|| -> OSPath.from("."))
    Loader.find_manifest_root(entry_dir).unwrap_or_else(|| -> entry_dir)
}

// Rust: Source/main.rs:5341
pub fn job_base_directory(entry: OSPath, job: JobFact) -> OSPath {
    project :: job_project_directory(entry)
    job.cwd.map_or(project, |cwd| -> project.join(cwd))
}

// Rust: Source/main.rs:5348
pub fn job_status_string_array(values: [String]) -> StatusValue {
    StatusValue.array(values.iter().map(|value| -> StatusValue.String(value)))
}

// Rust: Source/main.rs:5356
pub fn job_status_optional_string(value: String?) -> StatusValue {
    value.map(|text| -> StatusValue.String(text)).unwrap_or(StatusValue.Null)
}

// Rust: Source/main.rs:5362
pub fn job_status_skip(skip: AST.JobSkip?) -> StatusValue {
    match skip {
        none -> StatusValue.Null
        .Always(reason) -> StatusValue.object(StatusFields.new().with("kind", "always").with("reason", reason))
        .UnlessPlatform{platform} -> StatusValue.object(StatusFields.new().with("kind", "unless-platform").with("platform", platform))
    }
}

// Rust: Source/main.rs:5378
pub fn job_status_limits(limits: [String:String]) -> StatusValue {
    fields := StatusFields.new()
    // Rust BTreeMap order: sort keys once, then retain the same status field ordering.
    names := limits.keys().to_list()
    &names.sort()
    loop name in names { fields = fields.with(name, limits[name]) }
    StatusValue.object(fields)
}

// Rust: Source/main.rs:5386
pub fn job_status_argument(argument: JobArgumentSchema) -> StatusValue {
    StatusValue.object(StatusFields.new()
        .with("name", argument.name)
        .with("label", argument.label)
        .with("type", argument.ty)
        .with("required", argument.required)
        .with("default", job_status_optional_string(argument.default))
        .with("variadic", argument.variadic)
        .with("zone", argument.zone.debug()))
}
