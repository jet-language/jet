// crates/jet-sema/src/Sema/CognitiveComplexity.rs; adapted from the existing
// origin/port/compiler port. Score checked parser nodes, never source heuristics.
use jet_foundation.[Expr, Func, Item, Program, Span, Stmt, ast_visit_statement]

struct JetCLIComplexityReport {
    name: String
    span: Span
    score: Int
}

fn jet_cli_complexity_reports(program: Program) -> [JetCLIComplexityReport] Never! {
    reports := [JetCLIComplexityReport]{}
    jet_cli_complexity_items(program.items, &reports)
    // Descending score, then source position, then name: Rust's stable order.
    &reports.sort_by((left: JetCLIComplexityReport, right: JetCLIComplexityReport) -> (right.score <=> left.score).then(left.span.start <=> right.span.start).then(left.name <=> right.name))
    reports
}

fn jet_cli_complexity_items(items: [Item], reports: &[JetCLIComplexityReport]) Never! {
    loop item in items {
        if item == {
            .Func(function) -> jet_cli_complexity_function(function, &reports)
            .Impl(implementation) -> loop method in implementation.methods -> jet_cli_complexity_function(method, &reports)
            .Struct(definition) -> {
                loop method in definition.methods -> jet_cli_complexity_function(method, &reports)
                loop implementation in definition.trait_impls {
                    loop method in implementation.methods -> jet_cli_complexity_function(method, &reports)
                }
            }
            .Enum(definition) -> {
                loop method in definition.methods -> jet_cli_complexity_function(method, &reports)
                loop implementation in definition.trait_impls {
                    loop method in implementation.methods -> jet_cli_complexity_function(method, &reports)
                }
            }
            .CodeModule(code_module) -> {
                if code_module.body == .Val(body) -> jet_cli_complexity_items(body, &reports)
            }
            .GenericModule(generic_module) -> jet_cli_complexity_items(generic_module.body, &reports)
            else -> {}
        }
    }
}

// The expression half of one function's complexity walk: `ast_visit_statement`
// reports every expression here, which records its controls, nesting, mixed
// boolean chains and direct recursion.
struct JetCLIComplexityVisitor {
    function_name: String
    controls: [Span]
    nesting: [Span]
    mixed: Int
    recursive: Bool
    fn visit(&self, expression: Expr) Never! -[Mem.Alloc, Mem.Rc, Time.Wait]> {
        if expression == {
            .If(_, _, _, _, _, span) -> {
                &self.controls.push(span)
                &self.nesting.push(span)
            }
            .Lambda(lambda) -> {
                &self.nesting.push(lambda.span)
                if lambda.body == .Block(body) {
                    loop nested in body -> jet_cli_complexity_statement(nested, &self.controls, &self.nesting)
                }
            }
            .Call(call) -> {
                if call.name == self.function_name -> self.recursive = true
            }
            .Binary(.And, _, _, _) | .Binary(.Or, _, _, _) -> {
                operators :: jet_cli_complexity_boolean_operators(expression)
                if operators == 3 -> self.mixed += 1
            }
            else -> {}
        }
    }
}

fn jet_cli_complexity_function(function: Func, reports: &[JetCLIComplexityReport]) Never! {
    visitor := JetCLIComplexityVisitor{function_name: function.name, controls: [Span]{}, nesting: [Span]{}, mixed: 0, recursive: false}
    loop statement in function.body {
        jet_cli_complexity_statement(statement, &visitor.controls, &visitor.nesting)
        ast_visit_statement(statement, (expression: Expr) -> &visitor.visit(expression), false)
    }
    score := visitor.mixed + if visitor.recursive -> 1 else -> 0
    loop inner in visitor.controls {
        score += 1
        loop outer in visitor.nesting {
            if outer.start < inner.start && inner.end < outer.end -> score += 1
        }
    }
    &reports.push(JetCLIComplexityReport{name: function.name, span: function.span, score: score})
}

fn jet_cli_complexity_boolean_operators(expression: Expr) -> Int Never! {
    if expression == {
        .Binary(.And, left, right, _) -> (1).bit_or(jet_cli_complexity_boolean_operators(left)).bit_or(jet_cli_complexity_boolean_operators(right))
        .Binary(.Or, left, right, _) -> (2).bit_or(jet_cli_complexity_boolean_operators(left)).bit_or(jet_cli_complexity_boolean_operators(right))
        .Paren(inner, _) -> jet_cli_complexity_boolean_operators(inner)
        else -> 0
    }
}

fn jet_cli_complexity_body(body: [Stmt], controls: &[Span], nesting: &[Span]) Never! {
    loop statement in body -> jet_cli_complexity_statement(statement, &controls, &nesting)
}

fn jet_cli_complexity_statement(statement: Stmt, controls: &[Span], nesting: &[Span]) Never! {
    if statement == {
        .While(_, body, span, _, _) | .For(_, _, _, _, body, span, _, _, _) | .Loop(body, span, _, _) -> {
            &controls.push(span)
            &nesting.push(span)
            jet_cli_complexity_body(body, &controls, &nesting)
        }
        .CountedLoop(_, _, step, body, span, _, _) -> {
            &controls.push(span)
            &nesting.push(span)
            if step == .Val(value) -> jet_cli_complexity_statement(value, &controls, &nesting)
            jet_cli_complexity_body(body, &controls, &nesting)
        }
        .Switch(_, arms, else_body, span) | .ComptimeSwitch(_, arms, else_body, span) -> {
            &controls.push(span)
            &nesting.push(span)
            loop arm in arms -> jet_cli_complexity_body(arm.body, &controls, &nesting)
            if else_body == .Val(body) -> jet_cli_complexity_body(body, &controls, &nesting)
        }
        .ComptimeIf(_, _, then_body, else_body, span, _) -> {
            &controls.push(span)
            &nesting.push(span)
            jet_cli_complexity_body(then_body, &controls, &nesting)
            if else_body == .Val(body) -> jet_cli_complexity_body(body, &controls, &nesting)
        }
        .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .Live(body, _) | .Transact(_, _, body, _, _) | .ScopeMember(_, _, _, _, body, _, _, _) | .ContextBlock(_, body, _) | .AssumeDet(_, _, body, _) -> jet_cli_complexity_body(body, &controls, &nesting)
        else -> {}
    }
}
