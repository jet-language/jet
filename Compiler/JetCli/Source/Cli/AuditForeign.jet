// The foreign-code audit of one executable entry: the checked foreign
// declarations (`#Import(<lang>)`, `#FFI(<lang>)`) of its program, the `FFI`
// effects its entry reaches, the C libraries its link adds, and the loader
// needs of the image the native route links for it (the ELF PT_INTERP
// interpreter and the PT_DYNAMIC DT_NEEDED libraries). The image is linked in
// memory as `jet run` links it and is never written or run. The effects the
// entry requires of its host, which Jet's runtime serves through system
// calls, are listed beside them.
use {
    jet_backend.[x64_executable_bytes, x64_executable_complete]
    jet_driver.[
        JetDriverForeignDeclaration,
        JetDriverForeignLinkFacts,
        JetDriverInlineC,
        JetDriverVerbOutput,
        JET_DRIVER_EXIT_OK,
        JET_DRIVER_EXIT_USER_ERROR,
        jet_driver_present_diagnostics,
        jet_driver_report_problems,
    ]
    jet_foundation.[build_options_stock]
}

// ELF program header types and the dynamic tags the loader reads.
JET_CLI_ELF_PT_LOAD :: 1
JET_CLI_ELF_PT_DYNAMIC :: 2
JET_CLI_ELF_PT_INTERP :: 3
JET_CLI_ELF_DT_NULL :: 0
JET_CLI_ELF_DT_NEEDED :: 1
JET_CLI_ELF_DT_STRTAB :: 5

#Error
struct JetCLIElfError { message: String }
fn jet_cli_elf_error(message: String) -> JetCLIElfError Never! { JetCLIElfError{message: message} }

// What the operating system must load before an image runs: the PT_INTERP
// interpreter (None for a static image), whether it has a PT_DYNAMIC
// segment, and that segment's DT_NEEDED libraries in table order.
struct JetCLIElfLoader {
    interpreter: String?
    dynamic: Bool
    needed: [String]
}

// One foreign-code audit: the program's foreign declarations, the `FFI`
// effects and the host effects its entry requires (each sorted, unique), the
// C libraries its link adds (sorted, unique), and the loader needs of its image.
struct JetCLIForeignAudit {
    declarations: [JetDriverForeignDeclaration]
    ffi_effects: [String]
    host_effects: [String]
    c_libraries: [String]
    loader: JetCLIElfLoader
}

// The little-endian unsigned field of `width` bytes at `at`, None when it
// lies outside `bytes`.
fn jet_cli_elf_field(bytes: [U8], at: Int, width: Int) -> Int? Never! {
    if at < 0 || width < 1 || at + width > bytes.len() -> return None
    value := 0
    loop k in 0..<width -> value = value.bit_or(Int.from_u8(bytes[at + k]) << (8 * k))
    Val(value)
}

// The NUL-terminated UTF-8 string at `at` in `bytes`.
fn jet_cli_elf_string(bytes: [U8], at: Int) -> String? Never! {
    if at < 0 || at >= bytes.len() -> return None
    end := at
    loop end < bytes.len() {
        if bytes[end] == (U8{0}) -> break
        end += 1
    }
    Val(String.from_bytes(bytes.slice(at, end)) ?? return None)
}

// The file offset of virtual address `address`: the PT_LOAD segment that
// holds it among its file bytes, else None.
fn jet_cli_elf_offset(bytes: [U8], phoff: Int, phentsize: Int, phnum: Int, address: Int) -> Int? Never! {
    loop index in 0..<phnum {
        header :: phoff + index * phentsize
        if (jet_cli_elf_field(bytes, header, 4) ?? return None) != JET_CLI_ELF_PT_LOAD -> next
        offset :: jet_cli_elf_field(bytes, header + 8, 8) ?? return None
        vaddr :: jet_cli_elf_field(bytes, header + 16, 8) ?? return None
        filesz :: jet_cli_elf_field(bytes, header + 32, 8) ?? return None
        if address >= vaddr && address < vaddr + filesz -> return Val(offset + address - vaddr)
    }
    None
}

// The loader needs of the little-endian ELF64 image `bytes`, or why this
// audit can't read them.
fn jet_cli_elf_loader(bytes: [U8]) -> JetCLIElfLoader JetCLIElfError! {
    if bytes.len() < 64 || bytes[0] != (U8{127}) || bytes[1] != (U8{69}) || bytes[2] != (U8{76}) || bytes[3] != (U8{70}) -> return Err(jet_cli_elf_error("the image is not an ELF file"))
    if bytes[4] != (U8{2}) || bytes[5] != (U8{1}) -> return Err(jet_cli_elf_error("the image is not a little-endian ELF64 file"))
    phoff :: jet_cli_elf_field(bytes, 32, 8) ?? return Err(jet_cli_elf_error("the ELF header is truncated"))
    phentsize :: jet_cli_elf_field(bytes, 54, 2) ?? return Err(jet_cli_elf_error("the ELF header is truncated"))
    phnum :: jet_cli_elf_field(bytes, 56, 2) ?? return Err(jet_cli_elf_error("the ELF header is truncated"))
    if phentsize < 56 || phoff + phnum * phentsize > bytes.len() -> return Err(jet_cli_elf_error("the ELF program headers lie outside the image"))
    loader := JetCLIElfLoader{interpreter: None, dynamic: false, needed: [String]{}}
    loop index in 0..<phnum {
        header :: phoff + index * phentsize
        kind :: jet_cli_elf_field(bytes, header, 4) ?? return Err(jet_cli_elf_error("the ELF program headers are truncated"))
        offset :: jet_cli_elf_field(bytes, header + 8, 8) ?? return Err(jet_cli_elf_error("the ELF program headers are truncated"))
        filesz :: jet_cli_elf_field(bytes, header + 32, 8) ?? return Err(jet_cli_elf_error("the ELF program headers are truncated"))
        if kind != JET_CLI_ELF_PT_INTERP && kind != JET_CLI_ELF_PT_DYNAMIC -> next
        if offset + filesz > bytes.len() -> return Err(jet_cli_elf_error("ELF segment {index} lies outside the image"))
        if kind == JET_CLI_ELF_PT_INTERP {
            loader.interpreter = Val(jet_cli_elf_string(bytes, offset) ?? return Err(jet_cli_elf_error("the PT_INTERP interpreter path is not UTF-8")))
            next
        }
        loader.dynamic = true
        // DT_NEEDED values index the DT_STRTAB string table, in any order.
        strtab := Int?{None}
        names := [Int]{}
        at := offset
        loop at + 16 <= offset + filesz {
            kind_at :: jet_cli_elf_field(bytes, at, 8) ?? return Err(jet_cli_elf_error("the PT_DYNAMIC table is truncated"))
            value :: jet_cli_elf_field(bytes, at + 8, 8) ?? return Err(jet_cli_elf_error("the PT_DYNAMIC table is truncated"))
            if kind_at == JET_CLI_ELF_DT_NULL -> break
            if kind_at == JET_CLI_ELF_DT_STRTAB -> strtab = Val(value)
            if kind_at == JET_CLI_ELF_DT_NEEDED -> &names.push(value)
            at += 16
        }
        if names.len() == 0 -> next
        address :: strtab ?? return Err(jet_cli_elf_error("the PT_DYNAMIC table names libraries without a DT_STRTAB"))
        table :: jet_cli_elf_offset(bytes, phoff, phentsize, phnum, address) ?? return Err(jet_cli_elf_error("the DT_STRTAB address lies outside every PT_LOAD segment"))
        loop name in names {
            &loader.needed.push(jet_cli_elf_string(bytes, table + name) ?? return Err(jet_cli_elf_error("a DT_NEEDED name lies outside the image")))
        }
    }
    Ok(loader)
}

// The audit of a program whose checked foreign facts are `facts`, whose entry
// requires `effects`, and whose linked image has the loader needs `loader`.
fn jet_cli_foreign_audit(facts: JetDriverForeignLinkFacts, effects: [String], loader: JetCLIElfLoader) -> JetCLIForeignAudit Never! {
    ffi := [String]{}
    host := [String]{}
    loop row in effects {
        if {
            ffi.contains(row) || host.contains(row) -> next
            row == "FFI" || row.starts_with("FFI.") -> &ffi.push(row)
            else -> &host.push(row)
        }
    }
    &ffi.sort()
    &host.sort()
    libraries := [String]{}
    loop library in facts.libraries {
        if !libraries.contains(library) -> &libraries.push(library)
    }
    loop library in facts.direct_links {
        if !libraries.contains(library) -> &libraries.push(library)
    }
    loop library in facts.transitive_links {
        if !libraries.contains(library) -> &libraries.push(library)
    }
    &libraries.sort()
    JetCLIForeignAudit{declarations: facts.declarations, ffi_effects: ffi, host_effects: host, c_libraries: libraries, loader: loader}
}

// Whether the audited program has no foreign code and needs no loader.
fn jet_cli_foreign_audit_clean(audit: JetCLIForeignAudit) -> Bool Never! {
    audit.declarations.len() == 0 && audit.ffi_effects.len() == 0 && audit.c_libraries.len() == 0 && audit.loader.interpreter == None && !audit.loader.dynamic
}

// A report line's list: the words joined by ", ", or "none".
fn jet_cli_foreign_audit_list(words: [String]) -> String Never! {
    if words.len() == 0 -> return "none"
    words.join(", ")
}

// The human report of `audit`.
fn jet_cli_foreign_audit_text(audit: JetCLIForeignAudit) -> String Never! {
    count :: if audit.declarations.len() == 0 -> "none" else -> "{audit.declarations.len()}"
    out := "foreign declarations: {count}\n"
    loop row in audit.declarations -> out = "{out}  {row.path}:{row.line}  {row.language}  {row.name} -> {row.symbol}\n"
    out = "{out}FFI effects reached: {jet_cli_foreign_audit_list(audit.ffi_effects)}\n"
    out = "{out}C libraries linked: {jet_cli_foreign_audit_list(audit.c_libraries)}\n"
    loader :: if {
        audit.loader.interpreter == .Val(path) -> path.copy()
        audit.loader.dynamic -> "a dynamic segment without an interpreter"
        else -> "none (static ELF, no needed libraries)"
    }
    out = "{out}dynamic loader: {loader}\n"
    if audit.loader.needed.len() > 0 -> out = "{out}needed libraries: {audit.loader.needed.join(", ")}\n"
    out = "{out}host effects: {jet_cli_foreign_audit_list(audit.host_effects)}\n"
    verdict :: if jet_cli_foreign_audit_clean(audit) -> "none" else -> "present"
    "{out}foreign code: {verdict}\n"
}

// A JSON array of `words`.
fn jet_cli_foreign_audit_texts(words: [String]) -> JetCLIStatusValue Never! {
    jet_cli_status_array(loop word in words -> jet_cli_status_text(word))
}

// The `jet.status/v1` report of `audit`.
fn jet_cli_foreign_audit_json(audit: JetCLIForeignAudit) -> String Never! {
    rows :: loop row in audit.declarations -> jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("path", jet_cli_status_text(row.path)),
        jet_cli_status_field("line", jet_cli_status_int(row.line)),
        jet_cli_status_field("language", jet_cli_status_text(row.language)),
        jet_cli_status_field("name", jet_cli_status_text(row.name)),
        jet_cli_status_field("symbol", jet_cli_status_text(row.symbol)),
    })
    interpreter :: if audit.loader.interpreter == .Val(path) -> jet_cli_status_text(path) else -> JetCLIStatusValue.Null
    loader :: jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("interpreter", interpreter),
        jet_cli_status_field("dynamic", jet_cli_status_bool(audit.loader.dynamic)),
        jet_cli_status_field("needed", jet_cli_foreign_audit_texts(audit.loader.needed)),
    })
    fields :: [JetCLIStatusField]{
        jet_cli_status_field("declarations", jet_cli_status_array(rows)),
        jet_cli_status_field("ffi_effects", jet_cli_foreign_audit_texts(audit.ffi_effects)),
        jet_cli_status_field("c_libraries", jet_cli_foreign_audit_texts(audit.c_libraries)),
        jet_cli_status_field("loader", loader),
        jet_cli_status_field("host_effects", jet_cli_foreign_audit_texts(audit.host_effects)),
        jet_cli_status_field("foreign_free", jet_cli_status_bool(jet_cli_foreign_audit_clean(audit))),
    }
    "{jet_cli_status_render("audit.foreign", true, fields)}\n"
}

// The foreign-code audit of the executable entry `file` (bytes `source`):
// its executable compile under the stock `run` options, then its image
// linked in memory exactly as `jet run` links it.
fn jet_cli_audit_foreign(file: String, source: String, color: Bool, json: Bool) -> JetDriverVerbOutput {
    options :: build_options_stock("run")
    compiled := jet_cli_compile_executable_file(file, None, color, None, options, None)
    if ^compiled == {
        .Refused(refusal) -> refusal
        .Checked(result, inputs, snapshot) -> {
            errors :: jet_driver_present_diagnostics(jet_cli_errors(result.diagnostics), snapshot, result.generated_source_files)
            if errors.len() > 0 {
                rendered :: if json -> jet_cli_reports_status_json("diagnostics", false, jet_cli_report_base(file), file, source, errors) else -> jet_driver_report_problems(file, source, errors, color, false)
                return JetDriverVerbOutput{stdout: "", stderr: rendered, exit_code: JET_DRIVER_EXIT_USER_ERROR}
            }
            facts :: result.foreign_link.copy()
            effects :: result.entry_effects.copy()
            built := jet_cli_build_binary(file, jet_cli_stem(file), "run", color, options, result, ^inputs, snapshot)
            if ^built == {
                .Failed(failure) -> failure
                .Image(executable, _) -> {
                    whole := ^executable
                    complete :: x64_executable_complete(&whole)
                    if complete != "" -> return jet_cli_ice("the foreign audit couldn't read the linked image of `{file}`: {complete}")
                    loader :: jet_cli_elf_loader(x64_executable_bytes(^whole)) ?? return jet_cli_ice("the foreign audit couldn't read the linked image of `{file}`: {err.message}")
                    audit :: jet_cli_foreign_audit(facts, effects, loader)
                    stdout :: if json -> jet_cli_foreign_audit_json(audit) else -> jet_cli_foreign_audit_text(audit)
                    JetDriverVerbOutput{stdout: stdout, stderr: "", exit_code: JET_DRIVER_EXIT_OK}
                }
            }
        }
    }
}

// Writes the little-endian `width`-byte `value` at `at` of `bytes`.
fn jet_cli_elf_test_put(bytes: &[U8], at: Int, width: Int, value: Int) Never! {
    loop k in 0..<width -> bytes[at + k] = U8{(value >> (8 * k)).bit_and(255)}
}

// A little-endian ELF64 image of `size` zero bytes with an ELF header and,
// at offset 64, one program header per `segments` row (type, offset,
// vaddr, filesz).
fn jet_cli_elf_test_image(segments: [[Int]], size: Int) -> [U8] Never! {
    bytes := [U8]{}
    loop _ in 0..<size -> &bytes.push(U8{0})
    loop (k, byte) in ([U8]{U8{127}, U8{69}, U8{76}, U8{70}, U8{2}, U8{1}}) -> bytes[k] = byte
    jet_cli_elf_test_put(&bytes, 32, 8, 64)
    jet_cli_elf_test_put(&bytes, 54, 2, 56)
    jet_cli_elf_test_put(&bytes, 56, 2, segments.len())
    loop (index, segment) in segments {
        header :: 64 + index * 56
        jet_cli_elf_test_put(&bytes, header, 4, segment[0])
        jet_cli_elf_test_put(&bytes, header + 8, 8, segment[1])
        jet_cli_elf_test_put(&bytes, header + 16, 8, segment[2])
        jet_cli_elf_test_put(&bytes, header + 32, 8, segment[3])
    }
    bytes
}

// Why jet_cli_elf_loader refuses `bytes`; "" when it reads them.
fn jet_cli_elf_test_refusal(bytes: [U8]) -> String Never! {
    _ :: jet_cli_elf_loader(bytes) ?? return err.message
    ""
}

#Test("a static ELF image needs no loader") {
    image :: jet_cli_elf_test_image([[Int]]{[Int]{JET_CLI_ELF_PT_LOAD, 0, 4194304, 512}}, 512)
    loader :: jet_cli_elf_loader(image) ?? panic(err.message)
    assert(loader.interpreter == None)
    assert(!loader.dynamic)
    assert_eq(loader.needed.len(), 0)
}

#Test("a dynamic ELF image names its interpreter and needed libraries") {
    // PT_LOAD maps file bytes 0..1024 at 0x400000. PT_INTERP is at 512 and
    // PT_DYNAMIC at 640: DT_STRTAB 0x400300, DT_NEEDED 1 and 11, DT_NULL.
    // The string table at file offset 768 holds "\0libc.so.6\0libm.so.6\0".
    image := jet_cli_elf_test_image([[Int]]{
        [Int]{JET_CLI_ELF_PT_LOAD, 0, 4194304, 1024},
        [Int]{JET_CLI_ELF_PT_INTERP, 512, 4194816, 28},
        [Int]{JET_CLI_ELF_PT_DYNAMIC, 640, 4194944, 64},
    }, 1024)
    loop (k, byte) in "/lib64/ld-linux-x86-64.so.2".bytes() -> image[512 + k] = byte
    loop (k, value) in ([Int]{JET_CLI_ELF_DT_STRTAB, 4195072, JET_CLI_ELF_DT_NEEDED, 1, JET_CLI_ELF_DT_NEEDED, 11, JET_CLI_ELF_DT_NULL, 0}) {
        jet_cli_elf_test_put(&image, 640 + k * 8, 8, value)
    }
    loop (k, byte) in "libc.so.6".bytes() -> image[769 + k] = byte
    loop (k, byte) in "libm.so.6".bytes() -> image[779 + k] = byte
    loader :: jet_cli_elf_loader(image) ?? panic(err.message)
    assert(loader.interpreter == Val("/lib64/ld-linux-x86-64.so.2"))
    assert(loader.dynamic)
    assert_eq(loader.needed, [String]{"libc.so.6", "libm.so.6"})
}

#Test("non-ELF bytes and segments outside the image are refused") {
    assert_eq(jet_cli_elf_test_refusal("#!/bin/sh\n".bytes()), "the image is not an ELF file")
    outside :: jet_cli_elf_test_image([[Int]]{[Int]{JET_CLI_ELF_PT_INTERP, 4000, 0, 16}}, 128)
    assert_eq(jet_cli_elf_test_refusal(outside), "ELF segment 0 lies outside the image")
}

#Test("the foreign audit verdict needs no declarations, FFI effects, C libraries or loader") {
    facts := JetDriverForeignLinkFacts{libraries: [String]{}, direct_links: [String]{}, transitive_links: [String]{}, c_or_rust_rows: false, inline_c: [JetDriverInlineC]{}, declarations: [JetDriverForeignDeclaration]{}}
    static :: JetCLIElfLoader{interpreter: None, dynamic: false, needed: [String]{}}
    clean :: jet_cli_foreign_audit(facts, [String]{"GPU", "FS", "GPU"}, static)
    assert(jet_cli_foreign_audit_clean(clean))
    assert_eq(jet_cli_foreign_audit_text(clean), "foreign declarations: none\nFFI effects reached: none\nC libraries linked: none\ndynamic loader: none (static ELF, no needed libraries)\nhost effects: FS, GPU\nforeign code: none\n")
    assert_eq(jet_cli_foreign_audit_json(clean), "{{\"schema\":\"jet.status/v1\",\"action\":\"audit.foreign\",\"ok\":true,\"reports\":[],\"declarations\":[],\"ffi_effects\":[],\"c_libraries\":[],\"loader\":{{\"interpreter\":null,\"dynamic\":false,\"needed\":[]}},\"host_effects\":[\"FS\",\"GPU\"],\"foreign_free\":true}}\n")
    &facts.declarations.push(JetDriverForeignDeclaration{name: "abs", language: "c", symbol: "abs", path: "/p/run.jet", line: 3})
    facts.libraries = [String]{"m"}
    facts.direct_links = [String]{"z", "m"}
    foreign :: jet_cli_foreign_audit(facts, [String]{"FFI.C", "FS"}, static)
    assert(!jet_cli_foreign_audit_clean(foreign))
    assert_eq(foreign.c_libraries, [String]{"m", "z"})
    assert_eq(jet_cli_foreign_audit_text(foreign), "foreign declarations: 1\n  /p/run.jet:3  c  abs -> abs\nFFI effects reached: FFI.C\nC libraries linked: m, z\ndynamic loader: none (static ELF, no needed libraries)\nhost effects: FS\nforeign code: present\n")
}
