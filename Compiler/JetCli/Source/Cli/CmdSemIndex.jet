// Rust: Source/CmdSemIndex.rs:155
fn run_find(args: &[String], json: Bool) -> Void {
    options :: parse_find_options(args).unwrap_or_else(message -> {
        cli_error_fix("E2104", message, "run `jet find --help` for the query forms")
        process.exit(ExitCodes.USAGE)
    })
    if options.effect.is_some() && options.example.is_some() {
        cli_error_fix("E2104", "`--effect` and `--example` cannot be combined", "use one find mode per command")
        process.exit(ExitCodes.USAGE)
    }
    effect :: options.effect
    example :: options.example
    member :: options.member
    positionals := ^options.positionals
    target_index :: positionals.iter().rposition(value -> looks_like_jet_source(value))
    target :: target_index.map(index -> positionals.remove(index))
    text :: positionals.join(" ")
    rendered_text :: text.clone()
    if effect.is_none() && example.is_none() && text.is_empty() {
        cli_error_fix("E2104", "`jet find` needs a query or an effect filter", "use `jet find \"String -> Path\"` or `jet find --effect IO`")
        process.exit(ExitCodes.USAGE)
    }
    mode :: if (effect, example) == {
        (Val(name), None) -> FindMode.Effect { name: ^name, text: ^text }
        (None, Val(raw)) -> {
            if raw.contains("=>") {
                cli_error_fix("E2104", "find examples use `->`", "write the input/output example with `->`")
                process.exit(ExitCodes.USAGE)
            }
            FindMode.Example { shape: example_shape(raw), raw: ^raw }
        }
        (None, None) -> {
            if text.contains("=>") {
                cli_error_fix("E2104", "find signatures use `->`", "write the input/output shape with `->`")
                process.exit(ExitCodes.USAGE)
            }
            if text.contains("->") {
                shape :: parse_type_shape(text).unwrap_or_else(() -> {
                    cli_error_fix("E2104", "the find signature needs input and output types", "use `jet find \"String -> Path\"`")
                    process.exit(ExitCodes.USAGE)
                })
                FindMode.Signature(^shape)
            } else { FindMode.Text(^text) }
        }
        (Val(_), Val(_)) -> unreachable()
    }
    resolution_mode :: OutputMode { json: json, color: ColorChoice.Never, quiet: false }
    // GATE #4494: actual cwd/path resolution and CLI process exit.
    entry :: if target == {
        Val(raw) if OSPath.from(raw).is_dir() ->
            resolve_bare_entry("find", OSPath.from(raw), member, resolution_mode, false).map(entry -> entry.path)
        Val(raw) -> Val(OSPath.from(resolve_source_path(raw)))
        None -> {
            cwd :: env.current_dir().unwrap_or_else(_ -> OSPath.from("."))
            resolve_bare_entry("find", cwd, member, resolution_mode, false).map(entry -> entry.path)
        }
    }
    (symbols, effects) :: if entry == {
        Val(path) -> {
            checked :: CmdInspect.check_projection_for_effects(path, "dev", &[:]).unwrap_or_else(diagnostics ->
                CmdInspect.render_check_failure(path, diagnostics, json, false))
            (build_symbol_db(checked.bundle, checked.facts).symbols, checked.index().effects().to_vec())
        }
        None -> (SemanticSymbolIndex.language(), [])
    }
    matches :: find_matches(symbols, effects, mode)
    render_find(mode, rendered_text, matches, json)
}
// Rust: Source/CmdSemIndex.rs:251
fn parse_find_options(args: &[String]) -> FindOptions Err! {
    options := FindOptions { effect: None, example: None, member: None, positionals: [] }
    index := 0
    loop index < args.len() {
        arg :: args[index]
        if arg == "--effect" || arg == "--example" {
            value :: args.get(index + 1).filter(value -> !value.starts_with("--")).ok_or_else(() -> "`{arg}` needs a value")?
            if arg == "--effect" { options.effect = Val(value.clone()) } else { options.example = Val(value.clone()) }
            index += 2
            continue
        }
        if arg.strip_prefix("--effect=") == {
            Val(value) -> {
                if value.is_empty() { return Err("`--effect` needs a value") }
                options.effect = Val(value.to_string())
            }
            None -> {
                if arg.strip_prefix("--example=") == {
                    Val(value) -> {
                        if value.is_empty() { return Err("`--example` needs a value") }
                        options.example = Val(value.to_string())
                    }
                    None -> {
                        if arg == "-p" {
                            value :: args.get(index + 1).filter(value -> !value.starts_with('-')).ok_or_else(() -> "`-p` needs a workspace member")?
                            options.member = Val(value.clone())
                            index += 2
                            continue
                        } else if arg == CLI.MACHINE_OUTPUT_FLAG || arg == "--quiet" || arg == "--color" || arg.starts_with("--color=") {
                            index += 1
                            continue
                        } else if !arg.starts_with('-') { options.positionals.push(arg.clone()) }
                    }
                }
            }
        }
        index += 1
    }
    Ok(^options)
}
// Rust: Source/CmdSemIndex.rs:302
fn find_matches(symbols: &SemanticSymbolIndex, effects: &[EffectFact], mode: &FindMode) -> [FindMatch] {
    matches := []
    for symbol in symbols.symbols() {
        if symbol.kind != SemanticSymbolKind.Function && symbol.kind != SemanticSymbolKind.Member { continue }
        candidate :: if mode == {
            FindMode.Signature(shape) -> signature_shape(symbol.signature).filter(candidate -> shape_matches(shape, candidate))
                .map(_ -> "signature matches the requested type shape")
            FindMode.Effect { name, text } -> {
                fact :: effect_fact(symbol, effects) ?? continue
                if !effect_matches(name, fact) || !text_matches(symbol, text) { continue }
                Val(effect_reason(name, fact))
            }
            FindMode.Example { raw, shape } -> {
                if !is_pure_candidate(symbol, effects) { continue }
                candidate_shape :: signature_shape(symbol.signature)
                shape_match :: shape.zip(candidate_shape).is_some_and((wanted, candidate) -> shape_matches(wanted, candidate))
                documented :: symbol.examples.iter().any(example -> normalize_text(example) == normalize_text(raw))
                if !shape_match && !documented { continue }
                Val(if shape_match { "pure candidate has the same input/output shape" }
                    else { "pure candidate has a documented matching example" })
            }
            FindMode.Text(query) -> if text_matches(symbol, query) { Val("name or documentation matches the query") } else { None }
        }
        why :: candidate ?? continue
        matches.push(FindMatch { name: symbol.qualified_name.clone(), signature: symbol.signature.clone(), why: ^why })
    }
    matches.sort_by((left, right) -> left.name.cmp(right.name).then(left.signature.cmp(right.signature)))
    ^matches
}
// Rust: Source/CmdSemIndex.rs:368
fn effect_fact(symbol: &SemanticSymbol, effects: &[EffectFact]) -> &EffectFact? {
    if symbol.provenance == { SemanticProvenance.Source { .. } -> {}; _ -> return None }
    key :: symbol.owner.map(owner -> "{owner}::{symbol.name}").unwrap_or_else(() -> symbol.name.clone())
    effects.iter().find(fact -> fact.function == key)
        .or_else(() -> effects.iter().find(fact -> fact.function == symbol.name))
        .or_else(() -> effects.iter().find(fact -> fact.function.ends_with("::{key}")))
        .or_else(() -> effects.iter().find(fact -> fact.function.ends_with("__{symbol.name}")))
}
// Rust: Source/CmdSemIndex.rs:392
fn effect_matches(wanted: String, fact: &EffectFact) -> Bool {
    wanted_root :: wanted.split('.').next() ?? wanted
    fact.maximal || fact.inferred.iter().any(actual -> actual == wanted || actual.starts_with("{wanted}.") ||
        wanted.starts_with("{actual}.") || (actual.split('.').next() ?? actual) == wanted_root)
}
// Rust: Source/CmdSemIndex.rs:403
fn effect_reason(wanted: String, fact: &EffectFact) -> String {
    if fact.maximal { return "holds {wanted} through an open effect set" }
    actual :: fact.inferred.join(", ")
    path :: fact.provenance.iter().find(proof -> proof.effect == wanted || proof.effect.starts_with("{wanted}.") ||
        wanted.starts_with("{proof.effect}.") || (proof.effect.split('.').next() ?? proof.effect) == (wanted.split('.').next() ?? wanted))
        .map(proof -> proof.call_path.join(" -> "))
    if path == { Val(path) -> "holds {wanted} (inferred: {actual}; via {path})"; None -> "holds {wanted} (inferred: {actual})" }
}
// Rust: Source/CmdSemIndex.rs:425
fn is_pure_candidate(symbol: &SemanticSymbol, effects: &[EffectFact]) -> Bool {
    effect_fact(symbol, effects).is_none_or(fact -> !fact.maximal && fact.inferred.is_empty())
}
// Rust: Source/CmdSemIndex.rs:429
fn text_matches(symbol: &SemanticSymbol, query: String) -> Bool {
    examples :: symbol.examples.join(" ")
    haystack :: "{symbol.name} {symbol.qualified_name} {symbol.summary} {examples}".to_ascii_lowercase()
    query.split_whitespace().filter(term -> term.len() > 1).all(term -> haystack.contains(term.to_ascii_lowercase()))
}
// Rust: Source/CmdSemIndex.rs:444
fn parse_type_shape(query: String) -> TypeShape? {
    (raw_inputs, raw_output) :: query.split_once("->")?
    trimmed := raw_inputs.trim() // #4303
    inputs :: if trimmed.is_empty() || trimmed == "()" { [] }
        else { split_top_level(raw_inputs, ',').into_iter().map(ty -> compact_type(ty)).filter(ty -> !ty.is_empty()).collect() }
    output :: compact_type(raw_output)
    if output.is_empty() { None } else { Val(TypeShape { inputs: ^inputs, output: ^output }) }
}
// Rust: Source/CmdSemIndex.rs:459
fn signature_shape(signature: String) -> TypeShape? {
    open :: signature.find('(')?
    close :: signature.rfind(')')?
    if close < open { return None }
    inputs :: split_top_level(signature.get(open + 1..<close)?, ',').into_iter()
        .filter(part -> { trimmed := part.trim(); trimmed != "" && trimmed != "/" && trimmed != "*" })
        .map(part -> parameter_type(part)).collect_option()?
    tail := signature.get(close + 1..)?.trim() // #4303
    if tail.starts_with("-[") { tail = "" }
    else if tail.strip_prefix("->") == { Val(rest) -> tail = rest.trim(); None -> {} }
    if tail.split_once(" -[") == { Val((return_type, _)) -> tail = return_type.trim(); None -> {} }
    output :: tail.split_whitespace().next() ?? "()"
    Val(TypeShape { inputs: ^inputs, output: compact_type(output) })
}
// Rust: Source/CmdSemIndex.rs:486
fn parameter_type(raw_part: String) -> String? {
    part := raw_part.trim() // #4303
    part = (part.strip_prefix("...") ?? part).trim_start_matches(['~', '&', '^'])
    (_, raw_ty) :: part.split_once(':')?
    ty := raw_ty.split_once(" {").map_or(raw_ty, (ty, _) -> ty).trim() // #4303
    if ty.is_empty() { None } else { Val(compact_type(ty)) }
}
// Rust: Source/CmdSemIndex.rs:495
fn example_shape(example: String) -> TypeShape? {
    (raw_inputs, output) :: example.split_once("->")?
    trimmed := raw_inputs.trim() // #4303
    inputs :: if trimmed.is_empty() || trimmed == "()" { [] }
        else { split_top_level(raw_inputs, ',').into_iter().map(value -> literal_type(value)).collect_option()? }
    Val(TypeShape { inputs: ^inputs, output: literal_type(output)? })
}
// Rust: Source/CmdSemIndex.rs:511
fn literal_type(raw_value: String) -> String? {
    value := raw_value.trim() // #4303
    if (value.starts_with('"') && value.ends_with('"')) || (value.starts_with('\'') && value.ends_with('\'')) { return Val("String") }
    if value == "true" || value == "false" { return Val("Bool") }
    if value.parse::<Int64>().is_ok() { return Val("Int") }
    if value.parse::<Float64>().is_ok() { return Val("Float") }
    if value.starts_with('[') && value.ends_with(']') {
        inner := value.get(1..<value.len() - 1)?
        if inner.trim().is_empty() { return Val("[T]") }
        types :: split_top_level(inner, ',').into_iter().map(item -> literal_type(item)).collect_option()?
        first :: types.first()?.clone()
        return Val(if types.iter().all(ty -> ty == first) { "[{first}]" } else { "[T]" })
    }
    value.split_once('{').map((ty, _) -> compact_type(ty)).filter(ty -> !ty.is_empty())
        .or_else(() -> if value == "()" || value == "None" { Val("T") } else { None })
        .or_else(() -> if !value.is_empty() { Val("T") } else { None })
}
// Rust: Source/CmdSemIndex.rs:551
fn shape_matches(wanted: &TypeShape, candidate: &TypeShape) -> Bool {
    if wanted.inputs.len() != candidate.inputs.len() { return false }
    bindings := [:]
    wanted.inputs.iter().zip(candidate.inputs).all((wanted, candidate) -> type_matches(wanted, candidate, &bindings)) &&
        type_matches(wanted.output, candidate.output, &bindings)
}
// Rust: Source/CmdSemIndex.rs:564
fn type_matches(raw_wanted: String, raw_candidate: String, bindings: &[String:String]) -> Bool {
    wanted :: compact_type(raw_wanted)
    candidate :: compact_type(raw_candidate)
    if is_type_variable(wanted) {
        return if bindings.get(wanted) == { Val(bound) -> bound == candidate; None -> { bindings[wanted] = candidate; true } }
    }
    if wanted.starts_with('[') && wanted.ends_with(']') && candidate.starts_with('[') && candidate.ends_with(']') {
        return type_matches(wanted.get(1..<wanted.len() - 1).unwrap(), candidate.get(1..<candidate.len() - 1).unwrap(), bindings)
    }
    if wanted.starts_with('(') && wanted.ends_with(')') && candidate.starts_with('(') && candidate.ends_with(')') {
        wp :: split_top_level(wanted.get(1..<wanted.len() - 1).unwrap(), ',')
        cp :: split_top_level(candidate.get(1..<candidate.len() - 1).unwrap(), ',')
        return wp.len() == cp.len() && wp.iter().zip(cp).all((w, c) -> type_matches(w, c, bindings))
    }
    if (generic_parts(wanted), generic_parts(candidate)) == {
        (Val((wh, wa)), Val((ch, ca))) -> return type_names_equal(wh, ch) && wa.len() == ca.len() &&
            wa.iter().zip(ca).all((w, c) -> type_matches(w, c, bindings))
        _ -> {}
    }
    type_names_equal(wanted, candidate)
}
// Rust: Source/CmdSemIndex.rs:613
fn generic_parts(ty: String) -> (String, [String])? {
    open :: ty.find('<')?
    if !ty.ends_with('>') { return None }
    Val((ty.get(0..<open)?, split_top_level(ty.get(open + 1..<ty.len() - 1)?, ',').into_iter().map(part -> compact_type(part)).collect()))
}
// Rust: Source/CmdSemIndex.rs:626
fn is_type_variable(ty: String) -> Bool { ty.len() == 1 && ty.chars().next().is_some_and(ch -> ch.is_ascii_uppercase()) }
// Rust: Source/CmdSemIndex.rs:630
fn type_names_equal(left: String, right: String) -> Bool { left == right || left.rsplit(['.', ':']).next() == right.rsplit(['.', ':']).next() }
// Rust: Source/CmdSemIndex.rs:634
fn compact_type(ty: String) -> String { ty.chars().filter(ch -> !ch.is_whitespace()).collect() }
// Rust: Source/CmdSemIndex.rs:638
fn split_top_level(input: String, separator: Char) -> [String] {
    parts := []
    start := 0
    round := 0
    square := 0
    angle := 0
    for (index, ch) in input.char_indices() {
        if ch == { '(' -> round += 1; ')' -> round -= 1; '[' -> square += 1; ']' -> square -= 1; '<' -> angle += 1; '>' -> angle -= 1; _ -> {} }
        if ch == separator && round == 0 && square == 0 && angle == 0 {
            part := input.get(start..<index).unwrap().trim() // #4303
            parts.push(part.to_string())
            start = index + ch.len_utf8()
        }
    }
    last := input.get(start..).unwrap().trim() // #4303
    parts.push(last.to_string())
    ^parts
}
// Rust: Source/CmdSemIndex.rs:663
fn normalize_text(value: String) -> String { value.split_whitespace().collect().join(" ") }
// Rust: Source/CmdSemIndex.rs:667
fn render_find(mode: &FindMode, query: String, matches: &[FindMatch], json: Bool) -> Void {
    if json {
        values :: StatusValue.array(matches.iter().map(item -> StatusValue.object(
            StatusFields.new().with("name", item.name).with("signature", item.signature).with("why", item.why))))
        fields :: StatusFields.new().with("query", query).with("matches", values)
        println(StatusEnvelope.new("find", true).with_fields(fields).json())
        return
    }
    heading :: if mode == {
        FindMode.Signature(_) -> "signature {query}"
        FindMode.Effect { name, text } if text.is_empty() -> "effect {name}"
        FindMode.Effect { name, text } -> "effect {name} / {text}"
        FindMode.Example { raw, .. } -> "example {raw}"
        FindMode.Text(text) -> "text {text}"
    }
    println("find: {heading}")
    if matches.is_empty() { println("  no matches"); return }
    for (index, item) in matches.iter().enumerate() {
        println("  {index + 1}. {item.signature}")
        println("     why: {item.why}")
    }
}

