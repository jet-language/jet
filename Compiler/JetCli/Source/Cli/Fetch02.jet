// Rust: Source/Fetch.rs:1798
fn verify_registry_hangar_entry(package: String, store_entry: OSPath, expected_hash: String) -> Unit [Diagnostic]! {
    actual :: Publish.registry_artifact_hash(store_entry).map_err(error -> [registry_diagnostic(package,
        "stored registry artifact cannot be hashed: {error}", "repair the canonical Jetpack Hangar or retry the verified registry ingest")])?
    if actual != expected_hash -> return Err([registry_diagnostic(package, "stored registry artifact failed its content hash",
        "repair the canonical Jetpack Hangar or retry the verified registry ingest")])
    Ok(())
}
// Rust: Source/Fetch.rs:1823
fn ingest_registry_artifact(registry: Publish.RegistryConfig, entry: Publish.IndexEntry, artifact: OSPath,
    references: [String], advisory_receipt: Publish.AdvisoryReceipt?, package_policy: Publish.PackagePolicyReceipt?,
    source_exception: PackagePolicyException?) -> OSPath Err! {
    roots :: jetpack.Store.resolve()
    policy := "registry={registry.name};tier={entry.tier.label()};gate-status={entry.gate_status.summary()}"
    provenance := "registry={registry.name};repository={Publish.redact_registry_url(registry.url)};package={entry.name}#{entry.version};source-hash={entry.content_hash};fingerprint={entry.fingerprint};publisher={entry.public_key};index-signature={entry.signature}"
    referrer_receipt :: "subject={entry.content_hash};sbom=verified;signature-binding=verified;provenance=verified;reproducibility=verified"
    policy = "{policy};oci-referrers={referrer_receipt}"
    provenance = "{provenance};oci-referrers={referrer_receipt}"
    advisory :: advisory_receipt.map(receipt -> "sequence={receipt.sequence},digest={receipt.digest},key={receipt.key_id},maturity={receipt.maturity_seconds}s")
    package_policy_fingerprint :: package_policy.map(receipt -> receipt.fingerprint.clone())
    policy_summary :: package_policy.map(receipt -> receipt.summary())
    source_summary :: source_exception.map(exception -> exception.summary())
    if policy_summary == .Val(receipt) {
        policy = "{policy};package-policy={receipt}"
        provenance = "{provenance};package-policy={receipt}"
    }
    if source_summary == .Val(exception) {
        policy = "{policy};source-policy-exception={exception}"
        provenance = "{provenance};source-policy-exception={exception}"
    }
    if advisory == .Val(receipt) {
        policy = "{policy};advisory-feed={receipt}"
        provenance = "{provenance};advisory-feed={receipt}"
    }
    reference :: "registry:{registry.name}:{entry.name}#{entry.version}"
    existing :: jetpack.Store.list(roots).into_iter().find(existing -> existing.name == entry.name
        && existing.version == entry.version && existing.reference == reference
        && existing.cache_identity.source_fingerprint == entry.content_hash)
    if advisory_receipt.is_none() {
        if existing.and_then(item -> item.envelope.provenance.split(';').find(field -> field.starts_with("advisory-feed="))) == .Val(receipt) {
            provenance = "{provenance};{receipt}"
        }
    }
    retained_references :: existing.map(item -> item.references.clone()).unwrap_or_else(() -> references.clone())
    policy_fingerprint :: package_policy_fingerprint.or_else(() -> existing.filter(_ -> advisory_receipt.is_none())
        .map(item -> item.cache_identity.policy_fingerprint.clone())).unwrap_or_else(() -> "sha256-{SHA256.sha256_hex(policy.as_bytes())}")
    if existing.filter(_ -> advisory_receipt.is_none() && policy_summary.is_none()) == .Val(item) -> provenance = item.envelope.provenance.clone()
    if !provenance.contains("oci-referrers=") -> provenance = "{provenance};oci-referrers={referrer_receipt}"
    request :: jetpack.Store.IngestRequest{
        name: entry.name.clone(), version: entry.version.clone(), reference: reference,
        cache_identity: jetpack.Store.CacheIdentity{source_fingerprint: entry.content_hash.clone(),
            recipe_fingerprint: entry.fingerprint.clone(), policy_fingerprint: policy_fingerprint, platform: jetpack.Envelope.host_platform()},
        references: retained_references, outputs: ["out":artifact], signature: "", provenance: provenance, platform_artifact_kind: ""
    }
    ingested :: jetpack.Store.ingest_tree(roots, request).map_err(error -> "{error.what()} ({error.code()})")?
    Ok(OSPath.from(ingested.entry.out))
}
// Rust: Source/Fetch.rs:1961
fn locked_store_source_path(dep_name: String, package: LockedPackage) -> OSPath [Diagnostic]! {
    fingerprint := package.fingerprint.strip_prefix("sha256-").unwrap_or(package.fingerprint) // #4303
    if !safe_store_component(dep_name) || !safe_store_component(package.version) || !safe_store_component(fingerprint) {
        return Err([locked_source_diagnostic(dep_name, "the lock has no safe immutable store fingerprint")])
    }
    Ok(Store.store_path(dep_name, package.version, fingerprint))
}
// Rust: Source/Fetch.rs:1981
fn safe_store_component(value: String) -> Bool {
    !value.is_empty() && value != "." && value != ".." && !value.contains(['/', '\\', ':'])
        && !value.chars().any(character -> character.is_control())
        && if OSPath.from(value).components().next() == { .Val(.Normal(_)) -> true, else -> false }
        && OSPath.from(value).components().nth(1).is_none()
}
// Rust: Source/Fetch.rs:1994
fn build_dep_dirs_from_lock(lock: LockFile, project_root: OSPath, manifest: Manifest.Manifest) -> [String:OSPath] [Diagnostic]! {
    dep_dirs := [String:OSPath]{}
    loop dep_name in manifest.dependencies.keys().sorted() {
        spec :: manifest.dependencies[dep_name]
        source_dir :: if spec == {
            .Path{path} -> {
                declared :: normalize_path(project_root.join(path))
                package :: lock.packages.iter().find(package -> package.name == dep_name
                    && if package.source == { .Path(_) -> true, else -> false }).ok_or_else(() -> [locked_source_diagnostic(dep_name,
                        "the lock has no matching path source identity")])?
                locked_path :: if package.source == { .Path(value) -> value, else -> panic("path package predicate guarantees a path source") }
                if normalize_path(project_root.join(locked_path)) != declared -> return Err([locked_source_diagnostic(dep_name,
                    "the locked path source disagrees with the manifest")])
                stored :: locked_store_source_path(dep_name, package)?
                Store.verify_entry(dep_name, stored, package.content_hash.unwrap_or("")).map_err(d -> [d])?
                stored
            }
            .Git{url, selector} -> {
                package :: lock.packages.iter().find(package -> package.name == dep_name
                    && if package.source == { .Git{..} -> true, else -> false }).ok_or_else(() -> [locked_source_diagnostic(dep_name,
                        "the lock has no matching git source identity")])?
                (locked_url, locked_selector) :: if package.source == {
                    .Git{url: locked_url, selector: locked_selector} -> (locked_url, locked_selector)
                    else -> panic("git package predicate guarantees a git source")
                }
                expected_selector :: Lock.git_selector_str(selector)
                if locked_url != url || locked_selector != expected_selector -> return Err([locked_source_diagnostic(dep_name,
                    "the locked git source disagrees with the manifest")])
                revision :: package.locked.ok_or_else(() -> [locked_source_diagnostic(dep_name, "the lock has no pinned git revision")])?
                expected_hash :: package.content_hash.unwrap_or(revision.tree_hash)
                stored :: locked_store_source_path(dep_name, package)?
                Store.verify_entry(dep_name, stored, expected_hash).map_err(d -> [d])?
                stored
            }
            .Registry(version_req) -> {
                requirement :: VersionReq.parse(version_req).ok_or_else(() -> [registry_diagnostic(dep_name,
                    "invalid locked version requirement `{version_req}`", "use a valid SemVer requirement before creating a lock")])?
                locked :: lock.packages.iter().find(package -> package.name == dep_name
                    && SemVer.parse(package.version).is_some_and(version -> requirement.matches(version))
                    && if package.source == { .Registry{..} -> true, else -> false }).ok_or_else(() -> [registry_diagnostic(dep_name,
                        "locked registry dependency has no exact package record", "run `jet fetch` online to select and record an immutable registry version")])?
                (registry, reference, repository, source_hash, tier, gate_status) :: if locked.source == {
                    .Registry{registry, reference, repository, source_hash, tier, gate_status, ..} -> (registry, reference, repository, source_hash, tier, gate_status)
                    else -> panic("registry package predicate guarantees registry source")
                }
                if Publish.redact_registry_url(repository) != repository -> return Err([registry_diagnostic(dep_name,
                    "locked registry repository contains embedded credentials", "regenerate the lock from a credential-free registry endpoint; credentials never belong in `.jet/lock`")])
                config :: Publish.RegistryConfig{name: registry.clone(), url: repository.clone(), mirror: false,
                    require_signed: false, tier: Publish.RegistryTier.parse(tier).unwrap_or(Publish.RegistryTier.Core)}
                repo :: Publish.ensure_local_index_clone(config).map_err(d -> [d])?
                entry :: Publish.Index.find_entry(repo, dep_name, locked.version).map_err(error -> [registry_diagnostic(dep_name,
                    "locked registry index could not be read: {error}", "restore the pinned registry mirror; locked mode never downloads a new index")])?
                    .ok_or_else(() -> [registry_diagnostic(dep_name, "locked registry index has no pinned version",
                        "restore the exact offline registry checkpoint or run `jet fetch` online")])?
                expected_reference :: "{dep_name}#{locked.version}"
                if reference != expected_reference -> return Err([registry_diagnostic(dep_name,
                    "locked registry reference does not name the locked package version", "regenerate the lock from the trusted registry checkpoint")])
                if source_hash.is_empty() -> return Err([registry_diagnostic(dep_name, "locked registry package has no source hash",
                    "regenerate the lock from a registry entry with immutable source identity")])
                if entry.content_hash != source_hash -> return Err([registry_diagnostic(dep_name,
                    "locked registry content hash disagrees with the local index", "refresh the lock from a trusted registry checkpoint")])
                if entry.tier.label() != tier || entry.gate_status.summary() != gate_status -> return Err([registry_diagnostic(dep_name,
                    "locked registry tier or gate status disagrees with the live index", "regenerate the lock from the trusted registry checkpoint")])
                all_entries :: Publish.verify_registry_package(repo, config.name, dep_name).map_err(d -> [d])?
                Publish.verify_entry_tier(entry).map_err(d -> [d])?
                Publish.verify_index_entry(all_entries, entry, config.require_signed || entry.tier == .Community, config.name).map_err(d -> [d])?
                artifact_snapshot :: Publish.snapshot_verified_artifact(repo, entry).map_err(error -> [registry_diagnostic(dep_name,
                    "locked registry artifact is unavailable: {error}", "restore the artifact in the local registry mirror; locked mode stays offline")])?
                artifact :: artifact_snapshot.path()
                dep_manifest :: load_dep_manifest(artifact, dep_name)?
                if dep_manifest.package.name != dep_name || dep_manifest.package.version != locked.version -> return Err([registry_diagnostic(dep_name,
                    "locked source metadata disagrees with its registry identity", "refresh the lock from a trusted immutable registry artifact")])
                registry_metadata :: Publish.read_registry_package_metadata(artifact, dep_name, locked.version).map_err(error -> [registry_diagnostic(dep_name,
                    "locked registry dependency metadata is invalid: {error}", "refresh the lock from a trusted immutable registry artifact")])?
                registry_dependencies :: registry_dependency_edges(dep_manifest, registry_metadata, dep_name)?
                expected_dependencies :: registry_dependencies.iter().map(dependency -> dependency.name.clone())
                    .chain(dep_manifest.dependencies.iter().filter_map(pair -> if pair.1 == {
                        .Registry(_) -> None, else -> Val(pair.0.clone()) })).collect()
                locked_dependencies :: BTreeSet[String].from(locked.dependencies)
                if locked_dependencies != expected_dependencies -> return Err([registry_diagnostic(dep_name,
                    "locked dependency roles, features, or constraints disagree with the artifact metadata", "refresh the lock from the trusted immutable registry artifact")])
                policy_receipt :: Publish.authorize_package_candidate(manifest.policy, dep_name, locked.version, dep_manifest.package.license, config.name)
                    .map_err(error -> {
                        owner :: manifest.package.name.clone()
                        edge :: "{owner} -> {dep_name}#{locked.version}"
                        [Publish.package_policy_edge_diagnostic(owner, edge, config.name, error)]
                    })?
                source_exception :: Publish.active_source_exception(manifest.policy.exceptions, dep_name, locked.version)
                stored :: ingest_registry_artifact(config, entry, artifact, [], None, Val(policy_receipt), source_exception)
                    .map_err(error -> [registry_diagnostic(dep_name, error, "repair the canonical Jetpack Hangar or retry the verified registry ingest")])?
                verify_registry_hangar_entry(dep_name, stored, source_hash)?
                stored
            }
            .Foreign{language, reference} -> validate_locked_foreign_dependency(lock, project_root, dep_name, language, reference)?
        }
        &dep_dirs.insert(dep_name.clone(), source_dir)
    }
    Ok(dep_dirs)
}
// Rust: Source/Fetch.rs:2278
fn validate_locked_foreign_dependency(lock: LockFile, project_root: OSPath, dep_name: String,
    language: jet.AST.ForeignLanguage, reference: String) -> OSPath [Diagnostic]! {
    package :: lock.packages.iter().find(package -> package.name == dep_name && if package.source == {
        .Foreign{language: locked_language, reference: locked_reference, ..} -> locked_language == language && locked_reference == reference
        else -> false
    }).ok_or_else(() -> [foreign_locked_diagnostic(dep_name, "the lock has no matching language-qualified provider identity")])?
    output :: if package.source == {
        .Foreign{output, ..} -> OSPath.from(output)
        else -> panic("foreign package predicate guarantees a foreign lock source")
    }
    output_metadata :: fs.symlink_metadata(output).map_err(error -> [foreign_locked_diagnostic(dep_name, "locked Hangar output is unavailable: {error}")])?
    if output_metadata.file_type().is_symlink() || !output_metadata.is_dir() -> return Err([foreign_locked_diagnostic(dep_name,
        "locked Hangar output is not a real directory")])
    envelope :: package.envelope.ok_or_else(() -> [foreign_locked_diagnostic(dep_name, "the foreign lock record has no verified output envelope")])?
    if envelope.output_hash.is_empty() -> return Err([foreign_locked_diagnostic(dep_name, "the foreign lock record has no output hash")])
    roots :: jetpack.Store.resolve()
    actual :: jetpack.Envelope.try_output_hash_of_in_hangar(output.to_string_lossy(), roots.hangar_dir(), false)
        .map_err(error -> [foreign_locked_diagnostic(dep_name, "locked foreign output failed integrity verification: {error}")])?
    if actual != envelope.output_hash -> return Err([foreign_locked_diagnostic(dep_name, "locked foreign output hash disagrees with its envelope")])
    stored_binding :: output.join(Syntax.SOURCE_ROOT_DIR).join(language.bindings_subdir()).join("{dep_name}.{Syntax.FILE_EXT}")
    project_binding :: jetpack.Foreign.project_binding_path(project_root, language, dep_name)
    stored_metadata :: fs.symlink_metadata(stored_binding).map_err(error -> [foreign_locked_diagnostic(dep_name, "locked generated binding is unavailable: {error}")])?
    project_metadata :: fs.symlink_metadata(project_binding).map_err(error -> [foreign_locked_diagnostic(dep_name, "project binding cache is unavailable: {error}")])?
    if stored_metadata.file_type().is_symlink() || !stored_metadata.is_file() || project_metadata.file_type().is_symlink() || !project_metadata.is_file() {
        return Err([foreign_locked_diagnostic(dep_name, "the locked generated binding is not a regular file")])
    }
    stored_bytes :: fs.read(stored_binding).map_err(error -> [foreign_locked_diagnostic(dep_name, "could not read locked generated binding: {error}")])?
    project_bytes :: fs.read(project_binding).map_err(error -> [foreign_locked_diagnostic(dep_name, "could not read project generated binding: {error}")])?
    if stored_bytes != project_bytes -> return Err([foreign_locked_diagnostic(dep_name, "project binding cache disagrees with the locked Hangar binding")])
    Ok(output)
}
