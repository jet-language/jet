    }
}
impl LocalGitSource {
    // Rust: Source/Fetch.rs:2863
    fn git_path(self: LocalGitSource) -> String Err! {
        os :: target.selected_os() // GATE #4483
        if os == "linux" || os == "android" -> return Ok("/proc/self/fd/{self.handle.expect("local Git descriptor is retained").as_raw_fd()}")
        if os == "macos" || os == "ios" -> return Ok("/dev/fd/{self.handle.expect("local Git descriptor is retained").as_raw_fd()}")
        if target.selected_family() == "windows" -> return Err("descriptor-relative Git source access is unavailable on Windows")
        Err("descriptor-relative Git source access is unavailable on this platform")
    }
}
