// Rust: Source/Fetch.rs:2940
fn validate_git_transport_url(url: String, project_root: OSPath) -> ValidatedGitTransport Err! {
    if url.is_empty() || has_terminal_control(url) || url.starts_with('-') -> return Err("the URL is empty or contains unsafe characters")
    if url.strip_prefix("file://") == .Val(path) {
        if path.is_empty() || path.contains(['?', '#', '\\']) || !path.starts_with('/') -> return Err("file URLs must name a local absolute path")
        source :: validate_local_git_path(OSPath.from(path), project_root)?
        return Ok(.Local(source))
    }
    if !url.contains("://") && !looks_like_scp_url(url) -> return Err("local git paths must use file:// inside the project root")
    (scheme, authority) :: if url.split_once("://") == {
        .Val((scheme, rest)) -> (scheme.to_ascii_lowercase(), rest.split(['/', '?', '#']).next().unwrap_or(""))
        None -> ("ssh", url.split_once(':').map(pair -> pair.0).unwrap_or(""))
    }
    if scheme != "git" && scheme != "http" && scheme != "https" && scheme != "ssh" -> return Err("the `{scheme}` transport is not allowed")
    if authority.rsplit_once('@') == .Val((user, _)) {
        if scheme != "ssh" || user.is_empty() || user.starts_with('-')
            || !user.bytes().all(byte -> byte.is_ascii_alphanumeric() || byte == b'.' || byte == b'_' || byte == b'-') {
            return Err("SSH user-info must be a safe username")
        }
    }
    host :: host_from_git_authority(authority)?
    if host.starts_with('-') -> return Err("Git transport host must not begin with `-`")
    explicit_port :: port_from_git_authority(authority)?
    port :: explicit_port.unwrap_or(if scheme == "https" { U16{443} } else if scheme == "http" { U16{80} }
        else if scheme == "git" { U16{9418} } else { U16{22} })
    endpoint :: if host.contains(':') { "[{host}]:{port}" } else { "{host}:{port}" }
    addresses :: endpoint.to_socket_addrs().map_err(error -> "could not resolve the destination: {error}")?.collect()
    if addresses.is_empty() || addresses.iter().any(address -> !jet_net.is_public_ip(address.ip())) -> return Err("the destination resolves to a non-public address")
    Ok(.Network{scheme: scheme, host: host, port: port, explicit_port: explicit_port.is_some(), address: addresses[0].ip()})
}
