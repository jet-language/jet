// Rust: Source/Fetch.rs:3063
fn validate_local_git_path(path: OSPath, project_root: OSPath) -> LocalGitSource Err! {
    os :: target.selected_os() // GATE #4483
    if os == "linux" || os == "android" || os == "macos" || os == "ios" {
        resolver :: Authority.AuthorityResolver.open(project_root).map_err(error -> "could not open the project root authority: {error}")?
        candidate :: fs.canonicalize(path).map_err(error -> "could not resolve the local Git path: {error}")?
        if !candidate.starts_with(resolver.root()) -> return Err("the local Git path resolves outside the project root")
        relative :: candidate.strip_prefix(resolver.root()).map_err(_ -> "the local Git path resolves outside the project root")?
        directory :: resolver.checked_directory(relative).map_err(error -> "could not open the local Git path authority: {error}")?
        authority :: Store.directory_authority_from_file(candidate, directory.handle).map_err(error -> "could not retain the local Git path authority: {error}")?
        _ :: Store.hash_directory_authority(authority, true).map_err(error -> "local Git source contains unsafe files: {error}")?
        handle :: authority.inheritable_clone().map_err(error -> "could not retain the local Git descriptor: {error}")?
        return Ok(LocalGitSource{handle: Val(handle)})
    }
    if target.selected_family() == "windows" -> return Err("descriptor-relative Git source access is unavailable on Windows")
    Err("descriptor-relative Git source access is unavailable on this platform")
}
// Rust: Source/Fetch.rs:3069
fn looks_like_scp_url(url: String) -> Bool {
    url.split_once(':').map(pair -> !pair.0.is_empty() && !pair.1.is_empty()
        && !pair.0.contains(['/', '?', '#']) && !pair.0.ends_with('\\')).unwrap_or(false)
}
// Rust: Source/Fetch.rs:3080
fn host_from_git_authority(authority: String) -> String Err! {
    host_authority := authority.rsplit_once('@').map(pair -> pair.1).unwrap_or(authority) // #4303
    if host_authority.is_empty() || host_authority.contains(['@', '\\']) -> return Err("the URL has no valid host")
    if host_authority.strip_prefix('[') == .Val(host) {
        (host, suffix) :: host.split_once(']').ok_or_else(() -> "the URL has an invalid IPv6 host")?
        if host.is_empty() || (!suffix.is_empty() && !suffix.starts_with(':')) -> return Err("the URL has an invalid host")
        return Ok(host.to_string())
    }
    host := host_authority.rsplit_once(':').map(pair -> pair.0).unwrap_or(host_authority) // #4303
    if host.is_empty() || host.contains(':') || host.chars().any(character -> character.is_whitespace()) -> return Err("the URL has an invalid host")
    Ok(host.to_string())
}
// Rust: Source/Fetch.rs:3107
fn port_from_git_authority(authority: String) -> U16? Err! {
    host_authority := authority.rsplit_once('@').map(pair -> pair.1).unwrap_or(authority) // #4303
    raw_port :: if host_authority.strip_prefix('[') == {
        .Val(host) -> host.split_once(']').and_then(pair -> pair.1.strip_prefix(':'))
        None -> host_authority.rsplit_once(':').map(pair -> pair.1)
    }
    if raw_port == .Val(raw) {
        port :: raw.parse[U16]().map_err(_ -> "the URL has an invalid port")?
        if port == 0 -> return Err("the URL has an invalid port")
        return Ok(Val(port))
    }
    Ok(None)
}
