fn git_cache_dir(url: String, rev: String) -> OSPath Diagnostic! {
    validate_cached_revision(rev).map_err(reason -> git_revision_diagnostic(rev, reason))?
    home :: env.var("HOME").or_else(_ -> env.var("USERPROFILE")).unwrap_or_else(_ -> ".")
    url_hash :: SHA256.sha256_hex(url.as_bytes())
    rev_prefix :: rev.char_indices().take_while(pair -> pair.0 < 16).map(pair -> pair.1).collect()
    Ok(OSPath.from(home).join(".jet").join("git-cache").join(url_hash[0..16]).join(rev_prefix))
}
