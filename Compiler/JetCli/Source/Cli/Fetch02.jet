            "check platform descriptor support and permissions", None)]
    })?
    destination_path :: Store.descriptor_path_for(inheritable)
    destination :: destination_path.to_str().ok_or_else(() -> {
        cleanup()
        [Diagnostic.error("E1206", "couldn't address the Git cache staging directory", "the platform descriptor path is not valid UTF-8",
            "run `jet fetch` on a supported platform", None)]
    })?.to_owned()
    remote :: transport.git_remote(url).map_err(reason -> { cleanup(); [git_transport_diagnostic(url, reason)] })?
    clone_ok :: hardened_git_transport_command(transport).args(["clone", "--quiet", "--", remote, destination])
        .status().map(status -> status.success()).unwrap_or(false)
    if !clone_ok {
        cleanup()
        return Err([Diagnostic.error("E1203", "failed to clone `{url}`", "git clone returned an error", "check the git URL and your network connection", None)])
    }
    checkout_ok :: jetpack.Provider.hardened_git_command().args(["-C", destination, "checkout", "--quiet", rev])
        .status().map(status -> status.success()).unwrap_or(false)
    if !checkout_ok {
        cleanup()
        return Err([Diagnostic.error("E1203", "couldn't check out revision `{rev}` from `{url}`", "git checkout returned an error",
            "check that the revision exists in the repository", None)])
    }
    snapshot :: Store.snapshot_directory_authority(staging).map_err(diagnostic -> { cleanup(); [diagnostic] })?
    if Store.publish_directory(parent_authority, staging_name, parent_authority, destination_name) == {
        .Ok(()) -> Ok(snapshot)
        .Err(error) -> {
            if error.kind() == IOErrorKind.AlreadyExists {
                drop(^snapshot)
                cleanup()
                winner :: parent_authority.open_child_directory(destination_name).map_err(error -> [Diagnostic.error("E1206",
                    "couldn't open concurrent git cache `{dest.display()}`: {error}", "the Git cache entry must be a real directory",
                    "remove the cache entry and run `jet fetch` again", None)])?
                Store.snapshot_directory_authority(winner).map_err(d -> [d])
            } else {
                cleanup()
                Err([Diagnostic.error("E1206", "couldn't publish cloned repository into `{dest.display()}`: {error}",
                    "the Git cache publication must use an atomic no-replace rename", "check cache permissions and disk space", None)])
            }
        }
    }
}
