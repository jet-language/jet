    fn pinned_url(self: ValidatedGitTransport, url: String) -> String {
        if self == {
            .Network{scheme, port, explicit_port, address, ..} -> {
                if scheme != "git" -> return url
                (url_scheme, rest) :: url.split_once("://") ?? return url
                authority_end :: rest.find(character -> character == '/' || character == '?' || character == '#').unwrap_or(rest.len())
                suffix := rest[authority_end..] // #4303
                port_text :: if explicit_port { ":{port}" } else { "" }
                "{url_scheme}://{git_host(address)}{port_text}{suffix}"
            }
            else -> url
        }
    }
    // Rust: Source/Fetch.rs:2814
    fn git_config_values(self: ValidatedGitTransport) -> [String] {
        if self == {
            .Network{scheme, host, port, address, ..} -> {
                if scheme != "http" && scheme != "https" -> return []
                // Retain URL host for certificate verification; pin the socket; no redirects.
                ["http.followRedirects=false", "http.proxy=", "http.sslVerify=true",
                    "http.curloptResolve={curl_resolve_host(host)}:{port}:{curl_resolve_address(address)}"]
            }
            else -> []
        }
    }
    // Rust: Source/Fetch.rs:2844
    fn ssh_command(self: ValidatedGitTransport) -> String? {
