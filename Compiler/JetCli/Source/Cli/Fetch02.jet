            .Network{scheme, address, ..} -> if scheme == "ssh" { Val(hardened_ssh_command_for(address)) } else { None }
            else -> None
        }
    }
    // Rust: Source/Fetch.rs:2854
    fn git_remote(self: ValidatedGitTransport, url: String) -> String Err! {
