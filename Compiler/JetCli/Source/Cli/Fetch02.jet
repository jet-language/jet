    parent_authority :: Store.ensure_directory_authority(parent).map_err(error -> [Diagnostic.error("E1206",
        "couldn't create git cache directory `{parent.display()}`: {error}", "the git cache must be reached through no-follow directory authorities",
        "remove cache symlinks or check disk space and permissions", None)])?
    (staging_name, staging) :: parent_authority.create_private_child("jet-fetch").map_err(error -> [Diagnostic.error("E1206",
        "couldn't create temporary git cache directory", "the cache staging directory could not be allocated: {error}", "check disk space and permissions", None)])?
    cleanup :: () -> { _ :: parent_authority.remove_child_tree(staging_name) }
    os :: target.selected_os() // GATE #4483
    if os != "linux" && os != "android" && os != "macos" && os != "ios" {
        cleanup()
        return Err([Diagnostic.error("E1206", "cannot run Git without descriptor-relative cache authority",
            "this platform cannot pass an unredirectable private cache directory to Git", "run `jet fetch` on Linux, Android, macOS, or iOS", None)])
    }
    inheritable :: staging.inheritable_clone().map_err(error -> {
        cleanup()
