fn hardened_git_transport_command(transport: ValidatedGitTransport) -> Command {
    command := jetpack.Provider.hardened_git_command()
    loop config in transport.git_config_values() -> &command.args(["-c", config])
    if transport.ssh_command() == .Val(ssh_command) -> &command.env("GIT_SSH_COMMAND", ssh_command)
    command
}
