    validate_git_revision(rev).map_err(reason -> [git_revision_diagnostic(rev, reason)])?
    validate_cached_revision(rev).map_err(reason -> [git_revision_diagnostic(rev, reason)])?
    parent :: dest.parent().unwrap_or_else(() -> OSPath.from("."))
