// Pure REPL rendering, distinct from the command-palette Render.jet owner.
use jet_ast.[CtValue]
use jet_repl.[Session, ReplTurn, type_name]
use jet_foundation.[diagnostic_theme_accent, diagnostic_theme_bold, diagnostic_theme_dim, diagnostic_theme_paint]

// Rust: crates/jet-repl/src/Render.rs:18
pub FOLD_LIST_THRESHOLD :: 20
// Rust: crates/jet-repl/src/Render.rs:22
pub DEFAULT_WORKSPACE_SPLIT :: 32
// Rust: crates/jet-repl/src/Render.rs:27
pub fn render_banner(version: String, color: Bool) -> String Never! {
    "{diagnostic_theme_accent(color, "Jet")} {version} — Interactive REPL  ({diagnostic_theme_bold(color, ":quit")}, {diagnostic_theme_bold(color, ":help")}, {diagnostic_theme_bold(color, "^B")} bindings)"
}
// Rust: crates/jet-repl/src/Render.rs:41
pub fn render_discovery_hint(raw_mode: Bool, color: Bool) -> String Never! {
    if raw_mode {
        "Try: {diagnostic_theme_bold(color, "Tab")} Complete · {diagnostic_theme_bold(color, "F1")} Cursor Docs · {diagnostic_theme_bold(color, "?name")} Docs · {diagnostic_theme_bold(color, "F3")} History · {diagnostic_theme_bold(color, "^P")} Pin · {diagnostic_theme_bold(color, "^F")} Fold · {diagnostic_theme_bold(color, "^R")} Rerun · {diagnostic_theme_bold(color, "^B")} Bindings"
    } else {
        "Try: {diagnostic_theme_bold(color, "?name")} Docs · {diagnostic_theme_bold(color, ":pin/:fold/:rerun <id>")} · Interactive Keys Require a TTY"
    }
}
// Rust: crates/jet-repl/src/Render.rs:67
pub fn render_prompt(turn_no: Int, color: Bool) -> String Never! {
    "{diagnostic_theme_dim(color, "{turn_no}")} {diagnostic_theme_accent(color, "user>")} "
}
// Rust: crates/jet-repl/src/Render.rs:80
pub fn format_binding(name: String, value: CtValue, mutable: Bool) -> String Never! {
    sigil :: if mutable -> ":=" else -> "::"
    "{name} {sigil} {value.jet_show()}"
}
// Rust: crates/jet-repl/src/Render.rs:88
fn element_type_name(value: CtValue) -> String Never! {
    if value == {
        .Struct{type_name: name, ..} -> ~name
        .Enum{type_name: name, ..} -> ~name
        else -> type_name(value)
    }
}
// Rust: crates/jet-repl/src/Render.rs:100
pub fn fold_decision_for_value(value: CtValue) -> (Int, String)? Never! {
    if value == .List(items) && items.len() > FOLD_LIST_THRESHOLD {
        element :: if items.is_empty() -> "Any" else -> element_type_name(items[0])
        return Val((items.len(), element))
    }
    None
}
// Rust: crates/jet-repl/src/Render.rs:114
pub fn render_fold_marker(count: Int, elem_type: String, color: Bool) -> String Never! {
    "{diagnostic_theme_dim(color, "⋯")} {count} rows folded · [{elem_type}] · unfold {diagnostic_theme_dim(color, "⏎")}"
}
// Rust: crates/jet-repl/src/Render.rs:128
pub fn render_pin_rail(label: String, turn_id: Int, requested_width: Int, color: Bool) -> String Never! {
    width :: if requested_width < 20 -> 20 else -> requested_width
    hint_plain :: "turn {turn_id} · unpin ^P"
    head_len :: 2 + label.chars().len()
    pad :: jet_cli_help_max(jet_cli_help_sub(jet_cli_help_sub(width, head_len), hint_plain.chars().len()), 1)
    hint :: "turn {turn_id} · unpin {diagnostic_theme_bold(color, "^P")}"
    separator :: diagnostic_theme_paint(color, "90", "─".repeat(width))
    "{diagnostic_theme_accent(color, "📌")} {label}{" ".repeat(pad)}{hint}\n{separator}"
}
// Rust: crates/jet-repl/src/Render.rs:152
pub fn render_bindings_pane(session: Session, changed: [String:Bool]) -> [String] Never! {
    names := session.scope.keys().to_list()
    &names.sort()
    rows := [String]{}
    loop name in names {
        value :: session.scope[name]
        line := format_binding(name, value, session.mutable_names.contains(name))
        if changed.contains_key(name) -> line = "{line} ◂ new this step"
        &rows.push(^line)
    }
    rows
}
// Rust: crates/jet-repl/src/Render.rs:175
pub fn render_workspace_row(left: String, right: String, split_col: Int, color: Bool) -> String Never! {
    pad :: jet_cli_help_max(jet_cli_help_sub(split_col, left.chars().len()), 1)
    "{left}{" ".repeat(pad)}{diagnostic_theme_paint(color, "90", "│")} {right}"
}
// Rust: crates/jet-repl/src/Render.rs:190
pub fn pin_label(session: Session, turn: ReplTurn) -> String Never! {
    if turn.bound_name == .Val(name) {
        if session.scope.get(name) == .Val(value) -> return format_binding(name, value, session.mutable_names.contains(name))
    }
    if turn.summary.is_empty() -> "OK" else -> ~turn.summary
}
