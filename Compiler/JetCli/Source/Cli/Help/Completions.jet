// Shell completions and section-1 manual from the canonical Commands/Registry tables,
// plus pure compiled-program completions from the verified CLICommandSchema.
// Generated text preserves the Rust templates, including their whitespace.

// Rust `escape_zsh` (CLI.rs:3309-3314).
fn jet_cli_completions_escape_zsh(value: String) -> String Never! {
    jet_cli_completions_zsh_bracket(value).replace(":", "\\:")
}
// Rust `escape_fish` (CLI.rs:3315-3317).
fn jet_cli_completions_escape_fish(value: String) -> String Never! { value.replace("'", "\\'") }
// Rust `roff_escape` (CLI.rs:3318-3322): only backslashes are escaped in the reference.
fn jet_cli_completions_roff_escape(value: String) -> String Never! { value.replace("\\", "\\\\") }

// One growing byte buffer, like Rust String::push_str; avoid prefix recopies.
fn jet_cli_completions_append(out: &[U8], text: String) Never! {
    loop byte in text.bytes() -> &out.push(byte)
}
fn jet_cli_completions_finish(bytes: [U8]) -> String Never! {
    String.from_bytes(bytes) ?? panic("generated completion text is not UTF-8")
}

// Rust `completions_bash` (CLI.rs:2740-2798).
pub fn jet_cli_completions_bash() -> String Never! {
    commands := [String]{}
    loop command in JET_CLI_COMMANDS {
        if jet_cli_is_canonical_top_level(command.name) -> &commands.push(command.name)
    }
    flags := [String]{}
    loop flag in JET_CLI_FLAGS -> &flags.push(flag.long)
    nested := [String]{}
    loop group in JET_CLI_COMMANDS {
        if group.actions.len() == 0 -> next
        actions := [String]{}
        loop action in group.actions -> &actions.push(action.name)
        &nested.push("        {group.name}) COMPREPLY=( $(compgen -W \"{actions.join(" ")}\" -- \"$cur\") ); return 0 ;;")
    }
    bin :: JET_CLI_BINARY
    out := "# bash completion for {bin} (generated by `{bin} self completions bash`)\n_{bin}() {{\nlocal cur prev cmds flags\nCOMPREPLY=()\ncur=\"${{COMP_WORDS[COMP_CWORD]}}\"\ncmds=\"{commands.join(" ")}\"\nflags=\"{flags.join(" ")}\"\nif [[ \"$cur\" == -* ]]; then\nCOMPREPLY=( $(compgen -W \"$flags\" -- \"$cur\") )\nreturn 0\nfi\nif [[ $COMP_CWORD -eq 1 ]]; then\nCOMPREPLY=( $(compgen -W \"$cmds\" -- \"$cur\") )\nreturn 0\nfi\n".bytes()
    jet_cli_completions_append(&out, "    if [[ $COMP_CWORD -eq 2 && \"${{COMP_WORDS[1]}}\" == \"jobs\" ]]; then\nlocal job_names\njob_names=\"$({bin} --json jobs 2>/dev/null | sed -n 's/.*\"name\":\"\\([^\"]*\\)\".*/\\1/p')\"\nCOMPREPLY=( $(compgen -W \"$job_names\" -- \"$cur\") )\nreturn 0\nfi\n")
    jet_cli_completions_append(&out, "    if [[ $COMP_CWORD -eq 2 ]]; then\ncase \"${{COMP_WORDS[1]}}\" in\n{nested.join("\n")}\n        esac\nfi\nCOMPREPLY=( $(compgen -f -- \"$cur\") )\n}}\ncomplete -F _{bin} {bin}\n")
    jet_cli_completions_finish(out)
}

// Rust `completions_zsh` (CLI.rs:2801-2858).
pub fn jet_cli_completions_zsh() -> String Never! {
    commands := [U8]{}
    loop command in JET_CLI_COMMANDS {
        if !jet_cli_is_canonical_top_level(command.name) -> next
        jet_cli_completions_append(&commands, "        '{command.name}:{jet_cli_completions_escape_zsh(command.summary)}'\n")
    }
    nested := [String]{}
    loop group in JET_CLI_COMMANDS {
        if group.actions.len() == 0 -> next
        actions := [String]{}
        loop action in group.actions -> &actions.push("'{action.name}:{jet_cli_completions_escape_zsh(action.summary)}'")
        &nested.push("            {group.name}) _values 'action' {actions.join(" ")} ;;")
    }
    flags := [U8]{}
    loop flag in JET_CLI_FLAGS -> jet_cli_completions_append(&flags, "        '{flag.long}[{jet_cli_completions_escape_zsh(flag.help)}]'\n")
    bin :: JET_CLI_BINARY
    command_lines :: jet_cli_completions_finish(commands)
    flag_lines :: jet_cli_completions_finish(flags)
    out := "#compdef {bin}\n# zsh completion for {bin} (generated by `{bin} self completions zsh`)\n_{bin}() {{\nlocal -a commands flags\ncommands=(\n{command_lines}    )\nflags=(\n{flag_lines}    )\nif (( CURRENT == 2 )); then\n_describe -t commands 'command' commands\nelif (( CURRENT == 3 && $words[2] == jobs )); then\n".bytes()
    jet_cli_completions_append(&out, "        local -a job_names\njob_names=(\"${{(@f)$({bin} --json jobs 2>/dev/null | sed -n 's/.*\"name\":\"\\([^\"]*\\)\".*/\\1/p')}}\")\n_describe -t job_names 'job' job_names\n")
    jet_cli_completions_append(&out, "    else\nif (( CURRENT == 3 )); then\ncase $words[2] in\n{nested.join("\n")}\n            esac\nelse\n_values 'flag' $flags\n_files\nfi\nfi\n}}\n_{bin} \"$@\"\n")
    jet_cli_completions_finish(out)
}

// Rust `completions_fish` (CLI.rs:2861-2898).
pub fn jet_cli_completions_fish() -> String Never! {
    bin :: JET_CLI_BINARY
    out := "# fish completion for {bin} (generated by `{bin} self completions fish`)\n".bytes()
    loop command in JET_CLI_COMMANDS {
        if !jet_cli_is_canonical_top_level(command.name) -> next
        jet_cli_completions_append(&out, "complete -c {bin} -n '__fish_use_subcommand' -a {command.name} -d '{jet_cli_completions_escape_fish(command.summary)}'\n")
    }
    loop group in JET_CLI_COMMANDS {
        loop action in group.actions -> jet_cli_completions_append(&out, "complete -c {bin} -n '__fish_seen_subcommand_from {group.name}' -a {action.name} -d '{jet_cli_completions_escape_fish(action.summary)}'\n")
    }
    loop flag in JET_CLI_FLAGS {
        long := ~flag.long
        loop long.starts_with("--") -> long = long.slice(2..<long.len())
        jet_cli_completions_append(&out, "complete -c {bin} -l {long} -d '{jet_cli_completions_escape_fish(flag.help)}'\n")
    }
    jet_cli_completions_append(&out, "complete -c {bin} -n '__fish_seen_subcommand_from jobs' -a \"({bin} --json jobs 2>/dev/null | string match -r '\\\"name\\\":\\\"[^\\\"]+\\\"' | string replace -r '.*\\\"name\\\":\\\"([^\\\"]+)\\\".*' '$1')\" -d 'job name'\n")
    jet_cli_completions_finish(out)
}

// Rust `completions_powershell` (CLI.rs:2901-2958).
pub fn jet_cli_completions_powershell() -> String Never! {
    commands := [String]{}
    loop command in JET_CLI_COMMANDS {
        if jet_cli_is_canonical_top_level(command.name) -> &commands.push("'{command.name}'")
    }
    groups := [String]{}
    loop group in JET_CLI_COMMANDS {
        if group.actions.len() == 0 -> next
        actions := [String]{}
        loop action in group.actions -> &actions.push("'{action.name}'")
        &groups.push("'{group.name}' = @({actions.join(",")})")
    }
    flags := [String]{}
    loop flag in JET_CLI_FLAGS -> &flags.push("'{flag.long}'")
    bin :: JET_CLI_BINARY
    out := "# PowerShell completion for {bin} (generated by `{bin} self completions powershell`)\n$JetCommands = @({commands.join(",")})\n$JetFlags = @({flags.join(",")})\n$JetGroups = @{{ {groups.join("; ")} }}\n".bytes()
    jet_cli_completions_append(&out, "$JetJobs = @((& {bin} --json jobs 2>$null | ConvertFrom-Json).jobs.name)\n")
    jet_cli_completions_append(&out, "Register-ArgumentCompleter -Native -CommandName {bin} -ScriptBlock {{\nparam($wordToComplete,$commandAst,$cursorPosition)\n$words = @($commandAst.CommandElements | ForEach-Object {{ $_.Extent.Text }})\n$choices = if ($wordToComplete.StartsWith('-')) {{\n$JetFlags\n}} elseif ($words.Count -ge 2 -and $words[1] -eq 'jobs') {{\n$JetJobs\n}} elseif ($words.Count -ge 2 -and $JetGroups.ContainsKey($words[1])) {{\n$JetGroups[$words[1]]\n}} else {{\n$JetCommands\n}}\n$choices | Where-Object {{ $_ -like \"$wordToComplete*\" }} |\nForEach-Object {{ [System.Management.Automation.CompletionResult]::new($_,$_,\"ParameterValue\",$_) }}\n}}\n")
    jet_cli_completions_finish(out)
}

// Rust `completion_command_name` (CLI.rs:3170-3180).
#Error
pub enum JetCLICompletionNameError {
    NoUsableName
    ControlCharacter
}

pub fn jet_cli_completion_name_error_message(error: JetCLICompletionNameError) -> String Never! {
    if error == {
        .NoUsableName -> "the program path has no usable command name"
        .ControlCharacter -> "the program command name contains a control character"
    }
}

// Rust `completion_command_name` (CLI.rs:3170-3180).
// POSIX Path::file_name ignores repeated separators and trailing current-directory
// components, but never treats a trailing parent-directory component as a filename.
pub fn jet_cli_completion_command_name(program: String) -> String JetCLICompletionNameError! {
    raw :: program.bytes()
    end := raw.len()
    loop end > 0 {
        loop end > 0 && raw[end - 1] == (U8{47}) -> end -= 1
        if end == 0 -> break
        start := end
        loop start > 0 && raw[start - 1] != (U8{47}) -> start -= 1
        if end - start == 1 && raw[start] == (U8{46}) {
            end = start
            next
        }
        if end - start == 2 && raw[start] == (U8{46}) && raw[start + 1] == (U8{46}) -> return Err(JetCLICompletionNameError.NoUsableName)
        name :: String.from_bytes(raw[start..<end]) ?? panic("path component is not UTF-8")
        if jet_cli_has_control(name) -> return Err(JetCLICompletionNameError.ControlCharacter)
        return Ok(name)
    }
    Err(JetCLICompletionNameError.NoUsableName)
}

// Rust `man_page` (CLI.rs:3254-3307).
pub fn jet_cli_man_page(version: String) -> String Never! {
    bin :: JET_CLI_BINARY
    out := ".TH {bin.to_upper()} 1 \"\" \"{bin} {version}\" \"Jet Manual\"\n.SH Name\n{bin} \\- the Jet compiler and project tool\n.SH Synopsis\n.B {bin}\n.RI [ command ] \" \" [ args ...]\n.SH Description\n{bin} builds, checks, runs, and tests Jet programs, and manages Jet projects and their dependencies. Output is plain when piped and colored on a terminal.\n.SH Commands\n".bytes()
    loop command in JET_CLI_COMMANDS {
        if !jet_cli_is_canonical_top_level(command.name) -> next
        jet_cli_completions_append(&out, ".TP\n.B {command.name}\n{jet_cli_completions_roff_escape(command.summary)}\n")
        loop action in command.actions -> jet_cli_completions_append(&out, ".TP\n.B {command.name} {action.name}\n{jet_cli_completions_roff_escape(action.summary)}\n")
    }
    jet_cli_completions_append(&out, ".SH Flags\n")
    loop flag in JET_CLI_FLAGS -> jet_cli_completions_append(&out, ".TP\n.B {flag.long}\n{jet_cli_completions_roff_escape(flag.help)}\n")
    jet_cli_completions_append(&out, ".SH Files\n.TP\n.B {PAYLOAD_FILE}\nThe project manifest.\n.SH See Also\n{bin}-explain(1)\n")
    jet_cli_completions_finish(out)
}

// Rust `shell_single_quote` and `fish_single` (CLI.rs:3237-3239,3246-3248).
// Program fish words use POSIX quoting, not the registry's escape_fish contract.
fn jet_cli_completions_shell_single_quote(value: String) -> String Never! {
    "'{jet_cli_completions_zsh_single(value)}'"
}
// Rust `zsh_single` (CLI.rs:3240-3242).
fn jet_cli_completions_zsh_single(value: String) -> String Never! { value.replace("'", "'\\''") }
// Rust `zsh_bracket` (CLI.rs:3243-3245); shared with escape_zsh above.
fn jet_cli_completions_zsh_bracket(value: String) -> String Never! {
    jet_cli_completions_zsh_single(value).replace("[", "\\[").replace("]", "\\]")
}
// Rust `ps_single` (CLI.rs:3249-3251).
fn jet_cli_completions_ps_single(value: String) -> String Never! { "'{value.replace("'", "''")}'" }
fn jet_cli_completions_ps_words(words: [String]) -> String Never! {
    quoted := [String]{}
    loop word in words -> &quoted.push(jet_cli_completions_ps_single(word))
    quoted.join(",")
}

// Rust `zsh_standard_specs` (CLI.rs:3182-3195).
fn jet_cli_completions_zsh_standard_specs(standard: Bool, version: Bool) -> [String] Never! {
    if !standard -> return [String]{}
    specs := [String]{
        "    '(-v --verbose){{-v,--verbose}}[print extra detail]'",
        "    '(-q --quiet){{-q,--quiet}}[suppress normal output]'",
        "    '--color[control terminal color]:MODE:(auto always never)'",
    }
    if version -> &specs.push("    '--version[show version]'")
    specs
}
// Rust `zsh_input_specs` (CLI.rs:3197-3235). Sort row indexes, not input copies.
fn jet_cli_completions_zsh_input_specs(inputs: [TCLIInput]) -> [String] Never! {
    positionals := [Int]{}
    loop (index, input) in inputs { if input.positional != None -> &positionals.push(index) }
    &positionals.sort_by((left: Int, right: Int) -> {
        a :: inputs[left].positional ?? 0
        b :: inputs[right].positional ?? 0
        if a == b -> left <=> right else -> a <=> b
    })
    specs := [String]{}
    loop index in positionals {
        input :: inputs[index]
        meta :: (input.metavar ?? input.flag).to_lower()
        &specs.push("    ':{jet_cli_completions_zsh_single(meta)}:{jet_cli_completions_zsh_bracket(input.help)}'")
    }
    loop input in inputs {
        value :: if input.metavar == {
            .Val(name) -> ":{name.to_lower()}:"
            None -> ""
        }
        names :: if input.short == {
            .Val(short) -> "(-{short} --{input.flag}){{-{short},--{input.flag}}}"
            None -> "--{input.flag}"
        }
        &specs.push("    '{jet_cli_completions_zsh_single(names)}[{jet_cli_completions_zsh_bracket(input.help)}]{value}'")
    }
    &specs.push("    '--help[show help]'")
    specs
}

// Rust `completions_for_program` (CLI.rs:2964-3167).
// Only schema-known words: no file probes, live values, or application execution.
pub fn jet_cli_completions_for_program(shell: String, command_name: String, schema: CLICommandSchema) -> String? Never! {
    assert(!jet_cli_has_control(command_name))
    root_words :: cli_schema_completion_words(schema)
    root_input_words :: cli_schema_root_completion_words(schema)
    version :: CLI_RECORD_VERSION
    if shell == {
        "bash" -> {
            root :: jet_cli_completions_shell_single_quote(root_words.join(" "))
            name :: jet_cli_completions_shell_single_quote(command_name)
            if schema.commands.len() == 0 {
                return Val("# bash completion from JetCommandSchema v{version}\n__jet_program_completion() {{\n    local cur\n    COMPREPLY=()\n    cur=\"${{COMP_WORDS[COMP_CWORD]}}\"\n    COMPREPLY=( $(compgen -W {root} -- \"$cur\") )\n}}\ncomplete -F __jet_program_completion -- {name}\n")
            }
            cases := [String]{}
            loop command in schema.commands {
                flags :: jet_cli_completions_shell_single_quote(cli_schema_command_completion_words(command).join(" "))
                &cases.push("        {jet_cli_completions_shell_single_quote(command.name)}) flags={flags} ;;")
            }
            flags :: jet_cli_completions_shell_single_quote(root_input_words.join(" "))
            Val("# bash completion from JetCommandSchema v{version}\n__jet_program_completion() {{\n    local cur flags\n    COMPREPLY=()\n    cur=\"${{COMP_WORDS[COMP_CWORD]}}\"\n    if [[ $COMP_CWORD -eq 1 ]]; then\n        COMPREPLY=( $(compgen -W {root} -- \"$cur\") )\n        return 0\n    fi\n    flags={flags}\n    case \"${{COMP_WORDS[1]}}\" in\n{cases.join("\n")}\n    esac\n    if [[ \"$cur\" == -* ]]; then\n        COMPREPLY=( $(compgen -W \"$flags\" -- \"$cur\") )\n    fi\n}}\ncomplete -F __jet_program_completion -- {name}\n")
        }
        "zsh" -> {
            specs := jet_cli_completions_zsh_standard_specs(schema.standard, schema.version != None)
            &specs.extend(jet_cli_completions_zsh_input_specs(schema.inputs))
            name :: jet_cli_completions_shell_single_quote(command_name)
            if schema.commands.len() == 0 {
                return Val("#compdef {name}\n# zsh completion from JetCommandSchema v{version}\n_arguments \\\n{specs.join(" \\\n")}\n")
            }
            commands := [String]{}
            loop command in schema.commands -> &commands.push(~command.name)
            &specs.push("    '1:command:({commands.join(" ")})'")
            cases := [String]{}
            loop command in schema.commands {
                // The checked command already carries its command_inputs projection.
                args :: jet_cli_completions_zsh_input_specs(command.inputs).join(" \\\n")
                &cases.push("        {jet_cli_completions_shell_single_quote(command.name)}) _arguments \\\n{args} ;;")
            }
            Val("#compdef {name}\n# zsh completion from JetCommandSchema v{version}\nif (( CURRENT == 2 )); then\n_arguments \\\n{specs.join(" \\\n")}\nelse\n    case $words[2] in\n{cases.join("\n")}\n    esac\nfi\n")
        }
        "fish" -> {
            name :: jet_cli_completions_shell_single_quote(command_name)
            condition :: if schema.commands.len() == 0 -> "" else -> " -n '__fish_use_subcommand'"
            out := "# fish completion from JetCommandSchema v{version}\ncomplete -c {name}{condition} -l help -d 'show help'\n".bytes()
            if schema.standard {
                jet_cli_completions_append(&out, "complete -c {name}{condition} -l verbose -s v -d 'print extra detail'\ncomplete -c {name}{condition} -l quiet -s q -d 'suppress normal output'\ncomplete -c {name}{condition} -l color -r -d 'control terminal color'\n")
                if schema.version != None -> jet_cli_completions_append(&out, "complete -c {name}{condition} -l version -d 'show version'\n")
            }
            loop input in schema.inputs -> jet_cli_completions_program_fish_input(&out, name, condition, input)
            loop command in schema.commands {
                jet_cli_completions_append(&out, "complete -c {name} -n '__fish_use_subcommand' -a {jet_cli_completions_shell_single_quote(command.name)}\ncomplete -c {name} -n '__fish_seen_subcommand_from {command.name}' -l help -d 'show help'\n")
                command_condition :: " -n '__fish_seen_subcommand_from {command.name}'"
                loop input in command.inputs -> jet_cli_completions_program_fish_input(&out, name, command_condition, input)
            }
            Val(jet_cli_completions_finish(out))
        }
        "powershell" -> {
            root :: jet_cli_completions_ps_words(root_words)
            name :: jet_cli_completions_ps_single(command_name)
            if schema.commands.len() == 0 {
                return Val("# PowerShell completion from JetCommandSchema v{version}\nRegister-ArgumentCompleter -Native -CommandName {name} -ScriptBlock {{ param($wordToComplete,$commandAst,$cursorPosition) @({root}) | Where-Object {{ $_ -like \"$wordToComplete*\" }} | ForEach-Object {{ [System.Management.Automation.CompletionResult]::new($_,$_,'ParameterName',$_) }} }}\n")
            }
            flags :: jet_cli_completions_ps_words(root_input_words)
            cases := [String]{}
            loop command in schema.commands {
                words :: jet_cli_completions_ps_words(cli_schema_command_completion_words(command))
                &cases.push("{jet_cli_completions_ps_single(command.name)} = @({words})")
            }
            Val("# PowerShell completion from JetCommandSchema v{version}\nRegister-ArgumentCompleter -Native -CommandName {name} -ScriptBlock {{ param($wordToComplete,$commandAst,$cursorPosition) $root = @({root}); $flags = @({flags}); $commandFlags = @{{ {cases.join("; ")} }}; $words = @($commandAst.CommandElements | ForEach-Object {{ $_.Extent.Text }}); $selected = if ($words.Count -ge 2) {{ $words[1] }} else {{ '' }}; $choices = if ($commandFlags.ContainsKey($selected)) {{ $commandFlags[$selected] }} elseif ($wordToComplete.StartsWith('-')) {{ $flags }} else {{ $root }}; $choices | Where-Object {{ $_ -like \"$wordToComplete*\" }} | ForEach-Object {{ [System.Management.Automation.CompletionResult]::new($_,$_,'ParameterName',$_) }} }}\n")
        }
        else -> None
    }
}

// Rust `completions_for_program` fish input loops (CLI.rs:3087-3101,3113-3128).
fn jet_cli_completions_program_fish_input(out: &[U8], name: String, condition: String, input: TCLIInput) Never! {
    short :: if input.short == { .Val(value) -> " -s {value}" None -> "" }
    required :: if input.metavar != None -> " -r" else -> ""
    jet_cli_completions_append(&out, "complete -c {name}{condition} -l {input.flag}{short} -d {jet_cli_completions_shell_single_quote(input.help)}{required}\n")
}
