// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! E2-M3 (D-DX2 + D-BUILD1) — `jet self doctor`: environment self-diagnosis.
//RS //!
//RS //! Jet hides a rustc dependency and a machine-wide artifact store; when those drift the
//RS //! errors land far from the cause. `doctor` checks them up front, offline by
//RS //! default, and offers an actionable fix for each problem. Auto-fixable
//RS //! problems can be applied with `--fix`. Network checks (the registry) run only
//RS //! under `--online`.
//RS //!
//RS //! The advisory diagnostic for rustc / native linker / cache / PATH problems is **L2101**.
//RS //! The C-FFI section (D-BUILD1) reports pkg-config presence and hangar link
//RS //! dirs honestly.
//RS 
//RS use std::fmt;
//RS use std::fs;
//RS use std::path::PathBuf;
//RS use std::process::Command;
//RS 
//RS /// Exact rustc release owned by the current Jet build.
//RS pub const RUSTC_VERSION_PIN: &str = "1.97.1";
