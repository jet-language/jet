#Derive(Clone, Eq)
pub enum Health { Ok, Problem, Note }
// Rust: Source/Doctor.rs:32
pub struct Check {
    pub section: String
    pub label: String
    pub health: Health
    pub detail: String
    pub fix: String?
    pub auto_fixable: Bool
}
impl Check {
    // Rust: Source/Doctor.rs:50
    fn ok(section: String, label: String, detail: String) -> Check {
        Check{section: section, label: label, health: .Ok, detail: detail, fix: None, auto_fixable: false}
    }
    // Rust: Source/Doctor.rs:60
    fn note(section: String, label: String, detail: String) -> Check {
        Check{section: section, label: label, health: .Note, detail: detail, fix: None, auto_fixable: false}
    }
    // Rust: Source/Doctor.rs:70
    fn problem(section: String, label: String, detail: String, fix: String, auto_fixable: Bool) -> Check {
        Check{section: section, label: label, health: .Problem, detail: detail, fix: Val(fix), auto_fixable: auto_fixable}
    }
}
// Rust: Source/Doctor.rs:88
#Derive(Default)
pub struct Options { pub online: Bool, pub cross_target: String? }
// Rust: Source/Doctor.rs:98
pub fn run(opts: Options) -> [Check] {
    out := [Check]{}
    &out.push(check_rustc())
    &out.push(check_native_linker())
    &out.extend(check_caches())
    &out.push(check_path())
    &out.push(check_lsp())
    if opts.online { &out.push(check_registry()) }
    else { &out.push(Check.note("registry", "registry", "skipped (offline; pass --online to check)")) }
    &out.extend(check_ffi())
    if opts.cross_target == .Val(triple) -> &out.push(check_cross_target(triple))
    ^out
}
// Rust: Source/Doctor.rs:122
pub fn has_problem(checks: [Check]) -> Bool { checks.iter().any(c -> c.health == Health.Problem) }
// Rust: Source/Doctor.rs:126
fn check_rustc() -> Check {
    output :: Command.new("rustc").arg("--version").output() ?? return Check.problem("toolchain", "rustc", "not found on PATH (Jet pin: rustc {RUSTC_VERSION_PIN})", "install Rust {RUSTC_VERSION_PIN} from https://rustup.rs, then re-run; v1 of Jet uses rustc as its hidden backend", false)
    if !output.status.success() -> return Check.problem("toolchain", "rustc", "not found on PATH (Jet pin: rustc {RUSTC_VERSION_PIN})", "install Rust {RUSTC_VERSION_PIN} from https://rustup.rs, then re-run; v1 of Jet uses rustc as its hidden backend", false)
    text :: String.from_utf8_lossy(output.stdout)
    trimmed := text.trim() // #4303
    v :: trimmed.to_string()
    actual :: v.strip_prefix("rustc ").and_then(version -> version.split_whitespace().next())
    if actual == Val(RUSTC_VERSION_PIN) -> Check.ok("toolchain", "rustc", "{v} (Jet pin: rustc {RUSTC_VERSION_PIN})")
    else -> Check.problem("toolchain", "rustc", "{v} (Jet requires rustc {RUSTC_VERSION_PIN})", "use rustc {RUSTC_VERSION_PIN} from the project toolchain, then re-run `jet self doctor`", false)
}
// Rust: Source/Doctor.rs:163
fn check_native_linker() -> Check {
    if command_ok("cc", ["--version"]) {
        detail :: which("cc").map(path -> path.display()) ?? "found"
        Check.ok("toolchain", "native linker (cc)", detail)
    } else {
        Check.problem("toolchain", "native linker (cc)", "not found on PATH", "run from `nix develop`, or install a C toolchain that provides `cc` (`gcc`/`clang`; on Debian/Ubuntu: `build-essential`, on Arch: `base-devel`)", false)
    }
}
// Rust: Source/Doctor.rs:180
fn check_caches() -> [Check] {
    [artifact_store_check(), cache_check("ffi cache", ffi_cache_dir()), cache_check("package store", Store.store_dir())]
}
// Rust: Source/Doctor.rs:190
fn artifact_store_check() -> Check {
    store :: ArtifactStore.from_env() ?? return Check.problem("cache", "artifact store", "could not open the machine-wide store: {err}", "check JET_STORE_DIR and its permissions, then run `jet cache status`", false)
    status :: store.status() ?? return Check.problem("cache", "artifact store", "could not read the machine-wide store: {err}", "check JET_STORE_DIR and its permissions, then run `jet cache status`", false)
    Check.ok("cache", "artifact store", "{status.root.display()} (footprint {format_bytes(status.footprint_bytes)}; cap {format_bytes(status.limit_bytes)}; reserve {format_bytes(status.reserve_bytes)}; {status.entries.len()} entries; {status.live_leases} live leases)")
}
// Rust: Source/Doctor.rs:230
fn cache_check(label: String, dir: OSPath) -> Check {
    if !dir.exists() -> return Check.ok("cache", label, "{dir.display()} (created on demand)")
    if !dir.is_dir() -> return Check.problem("cache", label, "{dir.display()} exists but is not a directory", "remove `{dir.display()}` so Jet can recreate it", true)
    Check.ok("cache", label, dir.display())
}
// Rust: Source/Doctor.rs:249
fn format_bytes(bytes: U64) -> String {
    const UNITS: [String] = ["B", "KiB", "MiB", "GiB", "TiB"]
    if bytes < 1024 -> return "{bytes} B"
    value := bytes as F64
    unit := 0
    loop value >= 1024.0 && unit < UNITS.len() - 1 { value = value / 1024.0; unit = unit + 1 }
    if value.fract() == 0.0 || value >= 10.0 -> "{value:.0} {UNITS[unit]}"
    else -> "{value:.1} {UNITS[unit]}"
}
// Rust: Source/Doctor.rs:268
fn check_path() -> Check {
    bin :: Syntax.BINARY_NAME
    if which(bin).is_some() -> Check.ok("path", bin, "on PATH")
    else -> Check.problem("path", bin, "`{bin}` is not on your PATH", "add the directory containing `{bin}` to PATH so commands and `{bin}-<plugin>` discovery work", false)
}
// Rust: Source/Doctor.rs:284
fn check_lsp() -> Check {
    // The server is built into the same binary; no external server is probed.
    Check.ok("lsp", "language server", "built in (`{Syntax.BINARY_NAME} lsp`)")
}
// Rust: Source/Doctor.rs:294
fn check_registry() -> Check {
    registry :: Publish.resolve_publish_registry()
    safe_url :: Publish.redact_registry_url(registry.url)
    if safe_url != registry.url {
        return Check.problem("registry", registry.name, "{safe_url} (embedded credentials or URL parameters are not allowed)", "remove credentials and query parameters from JET_REGISTRY_URL; configure the host Git credential provider instead", false)
    }
    if registry.url.starts_with("file://") {
        path := registry.url.trim_start_matches("file://") // #4303
        if OSPath.from(path).exists() -> return Check.ok("registry", registry.name, "{safe_url} (local index reachable)")
        return Check.problem("registry", registry.name, "{safe_url} (local index is missing)", "create the configured local registry or set JET_REGISTRY_URL to a reachable index", false)
    }
    git := Command.new("git")
    &git.args(["-c", "credential.useHttpPath=true", "ls-remote", "--", registry.url]).env("GIT_TERMINAL_PROMPT", "0")
    loop (key, _) in env.vars_os() {
        text :: key.to_string_lossy()
        if text.starts_with("JET_REGISTRY_") -> &git.env_remove(key)
    }
    output :: git.output() ?? return Check.problem("registry", registry.name, "{safe_url} (git unavailable; transport details omitted)", "install git or configure a local registry index", false)
    if output.status.success() -> Check.ok("registry", registry.name, "{safe_url} (reachable)")
    else -> Check.problem("registry", registry.name, "{safe_url} (unreachable; transport details omitted)", "check JET_REGISTRY_URL, credentials, and network access, then retry", false)
}
// Rust: Source/Doctor.rs:360
fn check_ffi() -> [Check] {
    out := [Check]{}
    if command_ok("pkg-config", ["--version"]) { &out.push(Check.ok("c-ffi", "pkg-config", "found")) }
    else { &out.push(Check.problem("c-ffi", "pkg-config", "not found", "install pkg-config (e.g. `pacman -S pkgconf` / `apt install pkg-config`); only needed if you link C libraries", false)) }
    if command_ok("cargo", ["--version"]) { &out.push(Check.ok("c-ffi", "cargo", "found (builds the FFI bridge crate)")) }
    else { &out.push(Check.note("c-ffi", "cargo", "not found (only needed for C FFI builds)")) }
    hangar :: PackageStore.resolve().hangar_dir()
    // GATE #4409: preserve NotFound versus other inspection errors.
    if fs.symlink_metadata(hangar) == {
        .Ok(metadata) -> {
            if metadata.file_type().is_symlink() {
                &out.push(Check.problem("c-ffi", "hangar", "{hangar.display()} is a symlink", "move the symlink aside without following it, then retry `jetpack hangar path`", false))
            } else if metadata.is_dir() {
                &out.push(Check.ok("c-ffi", "hangar", hangar.display()))
            } else {
                &out.push(Check.problem("c-ffi", "hangar", "{hangar.display()} is not a directory", "move the path aside without deleting it, then retry `jetpack hangar path`", false))
            }
        }
        .Err(error) -> {
            if error.kind() == IOErrorKind.NotFound {
                legacy :: PackageStore.legacy_user_hangar_dir()
                retired :: OSPath.from(Syntax.HANGAR_DIR)
                source :: [legacy, retired].iter().find(path -> fs.symlink_metadata(path).is_ok())
                detail :: if source == {
                    .Val(path) -> "{hangar.display()} not present; legacy Hangar at {path.display()} awaits atomic migration"
                    None -> "{hangar.display()} not present (created when you realize a C library)"
                }
                &out.push(Check.note("c-ffi", "hangar", detail))
            } else {
                &out.push(Check.problem("c-ffi", "hangar", "{hangar.display()} cannot be inspected ({error.kind()})", "restore access to the resolved user Hangar path", false))
            }
        }
    }
    ^out
}
// Rust: Source/Doctor.rs:444
pub fn apply_fixes(checks: [Check]) -> [String] {
    fixed := [String]{}
    loop c in checks {
        if c.health == Health.Problem && c.auto_fixable && c.section == "cache" {
            if c.detail.split(" exists").next() == .Val(path) {
                if fs.remove_file(OSPath.from(path)).is_ok() || fs.remove_dir_all(OSPath.from(path)).is_ok() -> &fixed.push(~c.label)
            }
        }
    }
    ^fixed
}
// Rust: Source/Doctor.rs:464
fn ffi_cache_dir() -> OSPath { dirs_home().join(".cache").join("jet").join("ffi") }
// Rust: Source/Doctor.rs:469
pub const WASM_TARGET: String = "wasm32-unknown-unknown"
// Rust: Source/Doctor.rs:473
pub fn target_rustc_triple(triple: String) -> String {
    if triple == Syntax.BUILD_TARGET_WEB || triple == Syntax.TARGET_SANDBOX -> WASM_TARGET else -> triple
}
// Rust: Source/Doctor.rs:481
#Error
#Derive(Clone, Eq)
pub enum TargetComponentProbeError {
    TargetListUnavailable
    TargetNotKnown
    SysrootUnavailable
    LibraryUnavailable(path: OSPath)
}
impl TargetComponentProbeError {
    // Rust: Source/Doctor.rs:494
    fn fmt(&self, f: &Formatter) -> Err! {
        if self == {
            .TargetListUnavailable -> f.write_str("could not run the rustc target metadata probe")
            .TargetNotKnown -> f.write_str("not a recognised rustc target triple")
            .SysrootUnavailable -> f.write_str("could not determine the rustc sysroot")
            .LibraryUnavailable(path) -> f.write_str("target-specific standard-library component is missing or empty ({path.display()})")
        }
    }
    // Rust: Source/Doctor.rs:513
    pub fn fix(&self, requested: String) -> String {
        if self == {
            .TargetNotKnown -> "`{requested}` is not a target this Jet toolchain can build; choose a supported target such as `web`, `sandbox`, or the host target"
            .TargetListUnavailable -> "the Jet toolchain's code generator is unavailable; run `jet doctor` to see the missing component, then re-run the build"
            .SysrootUnavailable -> "the Jet toolchain's code generator is unavailable; run `jet doctor` to see the missing component, then re-run the build"
            .LibraryUnavailable(_) -> "this Jet toolchain has no standard library for `{requested}`; install a Jet toolchain that includes this target (`jet doctor` reports it), or build for the host target"
        }
    }
}
// Rust: Source/Doctor.rs:533
pub fn probe_target_component(triple: String) -> OSPath TargetComponentProbeError! {
    rust_triple :: target_rustc_triple(triple)
    target_list :: Command.new("rustc").args(["--print", "target-list"]).output() ?? return Err(.TargetListUnavailable)
    if !target_list.status.success() -> return Err(.TargetListUnavailable)
    known :: String.from_utf8_lossy(target_list.stdout).lines().any(line -> line.trim() == rust_triple)
    if !known -> return Err(.TargetNotKnown)
    sysroot :: Command.new("rustc").args(["--print", "sysroot"]).output() ?? return Err(.SysrootUnavailable)
    if !sysroot.status.success() -> return Err(.SysrootUnavailable)
    text :: String.from_utf8_lossy(sysroot.stdout)
    trimmed := text.trim() // #4303
    root :: trimmed.to_string()
    if root.is_empty() -> return Err(.SysrootUnavailable)
    target_lib :: OSPath.from(root).join("lib").join("rustlib").join(rust_triple).join("lib")
    has_component := false
    if fs.read_dir(target_lib) == .Ok(entries) {
        loop entry in entries {
            if entry == .Ok(item) {
                if item.metadata() == .Ok(metadata) {
                    if metadata.is_file() && metadata.len() > 0 { has_component = true; break }
                }
            }
        }
    }
    if !has_component -> return Err(.LibraryUnavailable(target_lib))
    Ok(target_lib)
}
// Rust: Source/Doctor.rs:587
fn check_cross_target(triple: String) -> Check {
    if triple == Syntax.TARGET_SANDBOX && !command_ok("wasm-tools", ["--version"]) {
        return Check.problem("cross", triple, "`wasm-tools` isn't on PATH (needed to build a sandbox's Component)", "install wasm-tools (ships in the project's `nix develop` shell), or add it to PATH", false)
    }
    target_lib :: probe_target_component(triple) ?? return Check.problem("cross", triple, err.to_string(), err.fix(triple), false)
    description :: if triple == Syntax.BUILD_TARGET_WEB -> "Jet web backend target (WASM + JS; installed ({target_lib.display()}))"
        else if triple == Syntax.BUILD_TARGET_WASI_SERVER -> "Jet WASI Preview 2 server Component target ({target_lib.display()})"
        else -> "installed ({target_lib.display()})"
    Check.ok("cross", triple, description)
}
// Rust: Source/Doctor.rs:628
fn dirs_home() -> OSPath { OSPath.from(env.var("HOME") ?? env.var("USERPROFILE") ?? "/tmp") }
// Rust: Source/Doctor.rs:635
fn command_ok(cmd: String, args: [String]) -> Bool {
    output :: Command.new(cmd).args(args).output() ?? return false
    output.status.success()
}
// Rust: Source/Doctor.rs:644
fn which(name: String) -> OSPath? {
    path :: env.var_os("PATH") ?? return None
    loop dir in env.split_paths(path) {
        candidate :: dir.join(name)
        if candidate.is_file() -> return Val(candidate)
    }
    None
}
