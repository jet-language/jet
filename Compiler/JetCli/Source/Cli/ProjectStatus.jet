// Source/CmdStatus.rs: read-only project truth. Missing evidence creates no
// claim; stale evidence remains visible, and status never runs a producer.
use jet_foundation.[canonical_json_bytes]
struct JetCLIProjectClaim {
    name: String
    action: String
    state: String
    receipt: String?
    sections: JetCLIStatusValue
    reason: String
}

// CmdStatus.rs `target_arg` up to its default: the one explicit target, or
// None when the caller must select the stock project entry.
fn jet_cli_project_status_target(args: [String]) -> String? JetCLIReadError! {
    target := String?{None}
    skip := false
    loop arg in args {
        if skip {
            skip = false
            next
        }
        if arg == "--json" || arg == "--quiet" || arg == "--no-color" || arg.starts_with("--color=") -> next
        if arg == "--color" {
            skip = true
            next
        }
        if arg.starts_with("-") -> return Err(jet_cli_read_error("unknown `jet status` flag `{arg}`"))
        if target != None -> return Err(jet_cli_read_error("`jet status` accepts at most one target"))
        target = Val(arg)
    }
    Ok(target)
}

fn jet_cli_project_status_matches(receipt: JetCLIReceipt, target: String, directory: Bool) -[FS]> Bool Never! {
    loop input in receipt.claim.inputs {
        path :: cli_files.realpath(input.path) ?? input.path
        if path == target || (directory && (target == "/" || path.starts_with("{target}/"))) -> return true
    }
    false
}

fn jet_cli_project_status_sections(receipt: JetCLIReceipt) -> JetCLIStatusValue Never! {
    value :: jet_cli_receipt_query_sections(receipt.sections, None) ?? return jet_cli_status_object([JetCLIStatusField]{})
    text :: String.from_bytes(canonical_json_bytes(value)) ?? return jet_cli_status_object([JetCLIStatusField]{})
    jet_cli_status_value_parse(text) ?? jet_cli_status_object([JetCLIStatusField]{})
}

fn jet_cli_project_status_summarize(root: String, receipts: [JetCLIReceipt], name: String, target: String) -[FS, Time.Wait]> JetCLIProjectClaim Never! {
    success := JetCLIReceipt?{None}
    failure := JetCLIReceipt?{None}
    stale := JetCLIReceipt?{None}
    loop receipt in receipts {
        if jet_cli_receipt_lookup(root, receipt.claim) == {
            .Val(_) -> {
                if receipt.status == 0 -> success = Val(receipt) else -> failure = Val(receipt)
            }
            .None -> stale = Val(receipt)
            .Err(_) -> failure = Val(receipt)
        }
    }
    selected := JetCLIReceipt?{None}
    state := "unproven"
    reason := "no receipt proves this claim"
    if failure != None {
        selected = failure
        reason = "current receipt records failure"
    } else if success != None {
        selected = success
        state = "proven"
        reason = "current receipt records success"
    } else if stale != None {
        selected = stale
        state = "stale"
        reason = "receipt input closure changed"
    }
    receipt_id := String?{None}
    sections := jet_cli_status_object([JetCLIStatusField]{})
    if selected == .Val(receipt) {
        receipt_id = Val(receipt.claim.key.slice(0, if receipt.claim.key.len() < 12 -> receipt.claim.key.len() else -> 12))
        sections = jet_cli_project_status_sections(receipt)
    }
    JetCLIProjectClaim{name: name, action: "jet {name} {target}", state: state, receipt: receipt_id, sections: sections, reason: reason}
}

fn jet_cli_project_status_pad(text: String, width: Int) -> String Never! {
    padded := text
    loop _ in text.len()..<width -> padded = "{padded} "
    padded
}

fn jet_cli_project_status_render(target: String, rows: [JetCLIProjectClaim], error: String, json: Bool) -> JetCLIPlan Never! {
    if json {
        claims := [JetCLIStatusValue]{}
        loop row in rows {
            &claims.push(jet_cli_status_object([JetCLIStatusField]{
                jet_cli_status_field("action", jet_cli_status_text(row.action)),
                jet_cli_status_field("claim", jet_cli_status_text(row.name)),
                jet_cli_status_field("reason", jet_cli_status_text(row.reason)),
                jet_cli_status_field("receipt", jet_cli_status_optional_text(row.receipt)),
                jet_cli_status_field("sections", row.sections),
                jet_cli_status_field("state", jet_cli_status_text(row.state)),
            }))
        }
        fields :: [JetCLIStatusField]{jet_cli_status_field("claims", jet_cli_status_array(claims)), jet_cli_status_field("error", if error == "" -> JetCLIStatusValue.Null else -> jet_cli_status_text(error)), jet_cli_status_field("target", jet_cli_status_text(target))}
        return jet_cli_done("{jet_cli_status_render("status", true, fields)}\n", "", JET_DRIVER_EXIT_OK)
    }
    out := "target  {target}\n"
    loop row in rows {
        out = "{out}{jet_cli_project_status_pad(row.name, 8)} {jet_cli_project_status_pad(row.state, 9)} receipt {row.receipt ?? "none"}"
        if row.state != "proven" -> out = "{out} · act: {row.action} · {row.reason}"
        out = "{out}\n"
    }
    jet_cli_done(out, "", JET_DRIVER_EXIT_OK)
}

// The host supplies the normal default project entry and ReceiptStore's
// selected root for the parsed target, exactly as run_status does in Rust.
fn jet_cli_project_status_at(root: String, cwd: String, target: String, json: Bool) -[FS, Time.Wait]> JetCLIPlan Never! {
    receipts :: jet_cli_receipt_list(root) ?? return jet_cli_project_status_render(target, [JetCLIProjectClaim]{}, "receipt store is unreadable: {err.message}", json)
    absolute :: if target.starts_with("/") -> target else -> jet_cli_entry_join(cwd, target)
    canonical :: cli_files.realpath(absolute) ?? absolute
    directory :: if cli_files.stat(canonical) == {.Ok(info) -> info.is_dir else -> false}
    by_verb := [String:[JetCLIReceipt]]{}
    verbs := [String]{}
    loop receipt in receipts {
        if !jet_cli_project_status_matches(receipt, canonical, directory) -> next
        name :: receipt.claim.verb
        if by_verb.get(name) == None {
            &verbs.push(name)
            by_verb[name] = [JetCLIReceipt]{}
        }
        &by_verb[name].push(receipt)
    }
    &verbs.sort()
    rows := [JetCLIProjectClaim]{}
    loop name in verbs -> &rows.push(jet_cli_project_status_summarize(root, by_verb.get(name) ?? [JetCLIReceipt]{}, name, target))
    jet_cli_project_status_render(target, rows, "", json)
}
