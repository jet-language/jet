// jet-debug: exact closed, payload-free event projection. Every transport
// renders the decoded records through this validator.

jet_cli_live_event_minimum: fn(value: Int, key: String, bound: Int) -> Int JetCLIReadError! {
    if value < bound {
        message: if bound == 0 -> "runtime event observation has negative `{key}`" else -> "runtime event observation has invalid `{key}`"
        return Err(jet_cli_read_error(message))
    }
    Ok(value)
}
jet_cli_live_event_closed: fn(value: String, key: String, allowed: [String]) JetCLIReadError! {
    if !allowed.contains(value) -> return Err(jet_cli_read_error("runtime event observation has unknown `{key}` value"))
    return
}
jet_cli_live_event_render: fn(events: [JetCLILiveEvent]) -> String JetCLIReadError! {
    if events.len() > 256 -> return Err(jet_cli_read_error("runtime event observation exceeds the 256-record limit"))
    previous := 0
    lines := [String]{}
    loop event in events {
        sequence: jet_cli_live_event_minimum(event.sequence, "sequence", 0)
        if sequence <= previous -> return Err(jet_cli_read_error("runtime event observation sequence is not strictly increasing"))
        previous = sequence
        jet_cli_live_event_closed(event.source, "source", [String]{"Event", "AsyncEvent", "DecisionHook"})
        event_id: jet_cli_live_event_minimum(event.event_id, "event_id", 0)
        owner_id: jet_cli_live_event_minimum(event.owner_id, "owner_id", 0)
        subscription_id: jet_cli_live_event_minimum(event.subscription_id, "subscription_id", 0)
        dispatch_id: jet_cli_live_event_minimum(event.dispatch_id, "dispatch_id", 0)
        jet_cli_live_event_closed(event.lifecycle, "lifecycle", [String]{"Subscribed", "Removed", "DispatchStarted", "Queued", "Backpressured", "Running", "HandlerStarted", "HandlerDelivered", "HandlerFailed", "HandlerContinue", "HandlerTransform", "HandlerCancel", "HandlerFail", "Terminal"})
        queued: jet_cli_live_event_minimum(event.queued, "queued", -1)
        blocked: jet_cli_live_event_minimum(event.blocked, "blocked", -1)
        running: jet_cli_live_event_minimum(event.running, "running", -1)
        capacity: jet_cli_live_event_minimum(event.capacity, "capacity", 0)
        jet_cli_live_event_closed(event.overflow, "overflow", [String]{"None", "Block", "DropNewest", "DropOldest"})
        jet_cli_live_event_closed(event.failure, "failure", [String]{"None", "Handler", "Panic"})
        jet_cli_live_event_closed(event.terminal, "terminal", [String]{"None", "Delivered", "HandlerFailed", "DroppedNewest", "DroppedOldest", "Closed", "Cancelled", "DeadlineExceeded", "Continue", "Cancel", "Fail"})
        &lines.push("sequence={sequence} source={event.source} event={event_id} owner={owner_id} subscription={subscription_id} dispatch={dispatch_id} lifecycle={event.lifecycle} queued={queued} blocked={blocked} running={running} capacity={capacity} overflow={event.overflow} priority={event.priority} failure={event.failure} terminal={event.terminal}")
    }
    Ok(lines.join("\n"))
}
