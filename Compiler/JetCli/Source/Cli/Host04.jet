// Rust: Source/CmdCompile.rs:6338
fn emit_test_capture(result: &TestResultCache, policy: TestCapturePolicy, mode: OutputMode) {
    if mode.json {
        document :: canonical_test_json(result.stdout).or_else(fn() { canonical_status_json(result.stdout) })
        if document == {
            .Val(document) -> write_mode_machine(mode, "{document}\n")
            .None -> { if !result.stdout.is_empty() -> eprint(result.stdout); if !result.stderr.is_empty() -> eprint(result.stderr) }
        }
        return
    }
    show :: policy == TestCapturePolicy.All || (!result.ok && policy == TestCapturePolicy.Failed)
    if !show -> return
    if !result.stdout.is_empty() -> print(result.stdout)
    if !result.stderr.is_empty() -> eprint(result.stderr)
}
