fn read_test_cache_line(bytes: View[U8], cursor: &Int) -> View[U8]? {
    start :: cursor
    rest :: bytes.get(start..) ?? return None
    end :: (rest.iter().position(fn(byte) { byte == 10 }) ?? return None) + start
    cursor = end + 1
    Val(bytes[start..end])
}
// Rust: Source/CmdCompile.rs:6280
fn test_result_cache_read(path: OSPath, opts: &TestRunOpts, package: Bool) -> TestResultCache? {
    destination :: test_result_cache_path(path, opts, package) ?? return None
    bytes :: fs.read(destination).ok() ?? return None
    cursor := 0
    if (read_test_cache_line(bytes, &cursor) ?? return None) != "JET_TEST_RESULT_V2".bytes() -> return None
    ok :: (read_test_cache_line(bytes, &cursor) ?? return None) == "1".bytes()
    stdout_len :: String.from_utf8(read_test_cache_line(bytes, &cursor) ?? return None).ok().and_then(fn(text) { text.parse[Int]().ok() }) ?? return None
    stderr_len :: String.from_utf8(read_test_cache_line(bytes, &cursor) ?? return None).ok().and_then(fn(text) { text.parse[Int]().ok() }) ?? return None
    stdout_end :: cursor.checked_add(stdout_len) ?? return None
    stderr_end :: stdout_end.checked_add(stderr_len) ?? return None
    stdout :: String.from_utf8((bytes.get(cursor..stdout_end) ?? return None).to_list()).ok() ?? return None
    stderr :: String.from_utf8((bytes.get(stdout_end..stderr_end) ?? return None).to_list()).ok() ?? return None
    Val(TestResultCache{ok: ok, stdout: stdout, stderr: stderr})
}
// Rust: Source/CmdCompile.rs:6306
fn test_result_cache_write(path: OSPath, opts: &TestRunOpts, package: Bool, result: &TestResultCache) {
    destination :: test_result_cache_path(path, opts, package) ?? return
    if destination.parent() == { .Val(parent) -> _ :: fs.create_dir_all(parent), .None -> {} }
    bytes := "JET_TEST_RESULT_V2\n".bytes().to_list()
    &bytes.extend_from_slice((if result.ok -> "1\n" else -> "0\n").bytes())
    &bytes.extend_from_slice(result.stdout.len().to_string().bytes())
    &bytes.extend_from_slice(result.stderr.len().to_string().bytes())
    &bytes.push(10)
    &bytes.extend_from_slice(result.stdout.bytes())
    &bytes.extend_from_slice(result.stderr.bytes())
    _ :: fs.write(destination, bytes)
}
