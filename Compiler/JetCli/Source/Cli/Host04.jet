struct FixPlan { before: String, staged: String, edits: Int, skipped_suggestions: Int }
// Rust: Source/CmdCompile.rs:5273
pub fn run_fix(file: String, dry_run: Bool, edition: String?, all: Bool, mode: OutputMode) {
    status :: fn(text: String) { write_mode_status(mode, "{text}\n") }
    src :: fs.read_to_string(OSPath.from_text(file)) ?? { cli_error("E2105", "can't find the file `{file}`"); exit(ExitCodes.USER_ERROR) }
    edition_migrated :: if edition == Val("2027") -> apply_edition_2027_encoding_fixes(src) else -> src
    (migrated, retired_target_count) :: rewrite_retired_package_targets(edition_migrated, file)
    if edition == Val("2027") { loop note in edition_2027_encoding_audit(src, edition_migrated) -> status("{file}: edition 2027 migration: {note}") }
    retired_selector_count :: Formatter.retired_interpolation_selector_edits(migrated).len()
    retired_print_count :: Formatter.retired_print_family_edits(migrated).len()
    retired_type_count :: Formatter.retired_type_edits(migrated).len()
    fixes :: LSP.collect_fixes(file, migrated)
    select :: fn(fixes: [LSP.Fix]) { if all -> fixes else -> LSP.safe_fixes(fixes) }
    selected_fixes :: select(fixes)
    skipped_suggestions :: fixes.len().saturating_sub(selected_fixes.len())
    FIX_ROUNDS :: 16
    (fixed, applied, deferred) := LSP.apply_non_overlapping(migrated, selected_fixes)
    round := 1
    loop deferred > 0 && round < FIX_ROUNDS {
        next_fixes :: select(LSP.collect_fixes(file, fixed))
        (next, count, next_deferred) :: LSP.apply_non_overlapping(fixed, next_fixes)
        if next == fixed -> break
        fixed = next
        applied += count
        deferred = next_deferred
        round += 1
    }
    plan :: FixPlan{before: src, staged: ^fixed, edits: applied, skipped_suggestions: skipped_suggestions}
    if plan.staged == plan.before {
        if plan.skipped_suggestions == 0 -> status("{file}: no changes made")
        else {
            suffix :: if plan.skipped_suggestions == 1 -> "" else -> "s"
            status("{file}: no changes made ({plan.skipped_suggestions} suggestion{suffix} need review)")
        }
        return
    }
    n :: plan.edits
    if dry_run {
        write_mode_renderable(mode, Formatter.unified_diff(file, plan.before, plan.staged))
        if n == 0 && retired_target_count == 0 && retired_selector_count == 0 && retired_print_count == 0 && retired_type_count == 0 -> status("{file}: would apply edition migration (dry run; nothing written)")
        else if n > 0 {
            suffix :: if n == 1 -> "" else -> "es"
            status("{file}: would apply {n} fix{suffix} (dry run; nothing written)")
        }
        if retired_target_count > 0 {
            suffix :: if retired_target_count == 1 -> "" else -> "s"
            status("{file}: rewrote {retired_target_count} retired target spelling{suffix} from `plugin` to `sandbox` (D-ONCE-SANDBOX1=A)")
        }
        if retired_selector_count > 0 {
            suffix :: if retired_selector_count == 1 -> "" else -> "s"
            status("{file}: rewrote {retired_selector_count} retired interpolation selector{suffix} from `#` to `:` (D-ONCE-HASH1)")
        }
        if retired_print_count > 0 {
            suffix :: if retired_print_count == 1 -> "" else -> "s"
            status("{file}: rewrote {retired_print_count} retired print-family spelling{suffix} (D-ONCE-PRINT1=A)")
        }
        if retired_type_count > 0 {
            suffix :: if retired_type_count == 1 -> "" else -> "s"
            status("{file}: rewrote {retired_type_count} retired Core container name{suffix} (D-COLLNAME1=A)")
        }
        if plan.skipped_suggestions > 0 {
            suffix :: if plan.skipped_suggestions == 1 -> "" else -> "s"
            status("{file}: skipped {plan.skipped_suggestions} suggestion{suffix} for review (dry run)")
        }
        return
    }
    log :: CmdCodemod.commit_fix(OSPath.from_text(file), plan.before.bytes().to_list(), plan.staged.bytes().to_list())
    if n == 0 && retired_target_count == 0 && retired_selector_count == 0 && retired_print_count == 0 && retired_type_count == 0 -> status("{file}: applied edition migration")
    else if n > 0 { suffix :: if n == 1 -> "" else -> "es"; status("{file}: applied {n} fix{suffix}") }
    if plan.skipped_suggestions > 0 {
        suffix :: if plan.skipped_suggestions == 1 -> "" else -> "s"
        status("{file}: skipped {plan.skipped_suggestions} suggestion{suffix} for review")
    }
    status("  log: {log.display()}")
    if retired_target_count > 0 {
        suffix :: if retired_target_count == 1 -> "" else -> "s"
        status("{file}: rewrote {retired_target_count} retired target spelling{suffix} from `plugin` to `sandbox` (D-ONCE-SANDBOX1=A)")
    }
    if retired_selector_count > 0 {
        suffix :: if retired_selector_count == 1 -> "" else -> "s"
        status("{file}: rewrote {retired_selector_count} retired interpolation selector{suffix} from `#` to `:` (D-ONCE-HASH1)")
    }
    if retired_print_count > 0 {
        suffix :: if retired_print_count == 1 -> "" else -> "s"
        status("{file}: rewrote {retired_print_count} retired print-family spelling{suffix} (D-ONCE-PRINT1=A)")
    }
    if retired_type_count > 0 {
        suffix :: if retired_type_count == 1 -> "" else -> "s"
        status("{file}: rewrote {retired_type_count} retired Core container name{suffix} (D-COLLNAME1=A)")
    }
}
