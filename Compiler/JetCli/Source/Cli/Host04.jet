fn test_target_facts(path: OSPath, source: String, opts: &TestRunOpts, package: Bool) -> TestTargetFacts {
    shown :: path.to_string_lossy()
    facts := TestTargetFacts{package: path.file_stem().and_then(fn(name) { name.to_str() }) ?? "package", path: shown, tags: source_hash_tags(source)}
    if Loader.package_facts_for_entry(path) == {
        .Ok(Val(package_facts)) -> { facts.package = package_facts.name; &facts.deps.extend(package_facts.deps.keys()) }
        else -> {}
    }
    entry :: path.to_string_lossy()
    (bundle, _) :: Loader.load_entry_with_overlays_and_dependencies(entry, [], false)
    if bundle == {
        .Ok(bundle) -> {
            &facts.deps.extend(bundle.package_guarantees.dependency_names)
            &facts.deps.extend(bundle.dep_roots.keys())
            &facts.deps.extend(bundle.dep_roots.values().filter_map(fn(root) { root.file_name().and_then(fn(name) { name.to_str() }) }))
        }
        .Err(_) -> {}
    }
    if !opts.fresh && env.var_os("JET_RECEIPT_BYPASS").is_none() {
        if test_result_cache_read(path, opts, package) == { .Val(cached) -> { facts.status = Val(if cached.ok -> "pass" else -> "fail") }, .None -> {} }
    }
    ^facts
}
// Rust: Source/CmdCompile.rs:6137
fn test_where_matches(expression: String, facts: &TestTargetFacts) -> Bool {
    clauses :: parse_test_where(expression) ?? return false
    clauses.iter().all(fn(clause) {
        if clause.field == {
            "package" -> facts.package == clause.value
            "dep" -> facts.deps.iter().any(fn(dep) { dep == clause.value || dep.strip_prefix(clause.value).is_some_and(fn(tail) { tail.starts_with(".") }) })
            "path" -> facts.path == clause.value || facts.path.ends_with("/{clause.value}") || facts.path.contains(clause.value)
            "tag" -> facts.tags.contains(clause.value)
            "status" -> {
                lowered :: clause.value.to_ascii_lowercase()
                wanted :: if lowered == { "passed" | "success" | "ok" -> "pass", "failed" | "failure" | "error" -> "fail", else -> lowered }
                facts.status == Val(wanted)
            }
            else -> false
        }
    })
}
