fn source_hash_tags(source: String) -> BTreeSet[String] {
    tags := BTreeSet.new()
    loop line in source.lines() {
        marker := line.trim_start() // #4303
        marker :: marker.strip_prefix("#") ?? continue
        end :: marker.char_indices().find_map(fn(pair) { if !pair.1.is_ascii_alphanumeric() && pair.1 != '_' -> Val(pair.0) else -> None }) ?? marker.len()
        if end != 0 -> _ :: tags.insert(marker[..end])
    }
    ^tags
}
