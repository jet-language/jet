fn fn_header_before(src: String, open: Int) -> Int? {
    prefix :: src[..open]
    search_end := prefix.len()
    loop {
        fn_at :: prefix[..search_end].rfind("fn ") ?? return None
        boundary_ok :: fn_at == 0 || !(prefix.bytes()[fn_at - 1].is_ascii_alphanumeric() || prefix.bytes()[fn_at - 1] == 95)
        if boundary_ok {
