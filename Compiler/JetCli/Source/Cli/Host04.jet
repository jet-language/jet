fn fresh_test_evidence_report(report_id: String, file: String, toolchain: String, target: String, profile: String, source_revision: String, build_revision: String, revision: String) -> EvidenceReport {
    report := EvidenceReport.new(report_id, EvidenceProducerKind.Test, EvidenceSource.new(file, 0, 1), EvidenceBuild.new(toolchain, target, profile), EvidenceRevision.new(source_revision, build_revision, revision))
    canonicalize_test_report_identity(&report, report_id)
    ^report
}
// Rust: Source/CmdCompile.rs:6686
fn write_test_evidence_bytes(path: OSPath, bytes: View[U8]) -> U64 Err! {
    parent :: path.parent() ?? return Err("test evidence report has no parent directory")
    current := if parent.is_absolute() -> OSPath.from_text(std.path.MAIN_SEPARATOR.to_string()) else -> OSPath.from_text(".")
    loop component in parent.components() {
        name :: if component == { .Normal(name) -> name, else -> continue }
        &current.push(name)
        if fs.symlink_metadata(current) == {
            .Ok(metadata) -> {
                if metadata.file_type().is_symlink() -> return Err("test evidence parent is a symlink: {current.display()}")
                if !metadata.is_dir() -> return Err("test evidence parent is not a directory: {current.display()}")
            }
            .Err(error) -> {
                if error.kind() != io.ErrorKind.NotFound -> return Err(error.to_string())
                fs.create_dir(current) ?? return Err(err.to_string())
                if core.sys.target.selected_family() == "unix" -> fs.set_permissions(current, fs.Permissions.from_mode(0o700)) ?? return Err(err.to_string())
            }
        }
    }
    if fs.symlink_metadata(path) == {
        .Ok(metadata) -> {
            if metadata.file_type().is_symlink() || !metadata.is_file() -> return Err("final test evidence path is not a regular file: {path.display()}")
            existing :: fs.read(path) ?? return Err(err.to_string())
            if existing == bytes -> return Ok(U64.try_from(existing.len()) ?? return Err("test evidence report is too large"))
            return Err("refusing to overwrite differing test evidence report at {path.display()}")
        }
        .Err(_) -> {}
    }
    short_hash :: SHA256.sha256_hex(bytes).get(..8) ?? "00000000"
    temporary :: path.with_extension("json.tmp.{std.process.id()}.{short_hash}")
    write_result :: (fn() Err! {
        file := fs.OpenOptions.new().write(true).create_new(true).open(temporary) ?? return Err(err.to_string())
        if core.sys.target.selected_family() == "unix" -> file.set_permissions(fs.Permissions.from_mode(0o600)) ?? return Err(err.to_string())
        file.write_all(bytes) ?? return Err(err.to_string())
        file.sync_all() ?? return Err(err.to_string())
        fs.hard_link(temporary, path) ?? return Err(err.to_string())
        fs.remove_file(temporary) ?? return Err(err.to_string())
        if core.sys.target.selected_family() == "unix" {
            directory :: fs.File.open(parent) ?? return Err(err.to_string())
            directory.sync_all() ?? return Err(err.to_string())
        }
        Ok(())
    })()
    if write_result == { .Err(error) -> { _ :: fs.remove_file(temporary); return Err(error) }, .Ok(_) -> {} }
    Ok(U64.try_from(bytes.len()) ?? return Err("test evidence report is too large"))
}
// Rust: Source/CmdCompile.rs:6780
pub fn persist_evidence_report(report: &EvidenceReport) Err! { persist_evidence_report_for_inputs(report, report.revision.source) }
// Rust: Source/CmdCompile.rs:6786
pub fn persist_evidence_report_for_inputs(report: &EvidenceReport, target_inputs_sha256: String) Err! { persist_evidence_report_for_inputs_with_retention(report, target_inputs_sha256, true) }
// Rust: Source/CmdCompile.rs:6793
fn persist_optional_evidence_report_for_inputs(report: &EvidenceReport, target_inputs_sha256: String) Err! { persist_evidence_report_for_inputs_with_retention(report, target_inputs_sha256, false) }
// Rust: Source/CmdCompile.rs:6800
fn persist_evidence_report_for_inputs_with_retention(report: &EvidenceReport, target_inputs_sha256: String, protected: Bool) Err! {
    report_id :: report.identity.report_id
    if report_id.is_empty() || report_id.contains("/") || report_id.contains("\\") || report_id == "." || report_id == ".." -> return Err("evidence report has an unsafe id `{report_id}`")
    cwd :: env.current_dir() ?? return Err("could not read the current directory: {err}")
    project_root :: Loader.selected_project_root(cwd) ?? return Err("could not resolve evidence project root: {err:?}")
    path :: project_root.join(".jet/evidence").join("{report_id}.json")
    bytes :: report.encode()
    size :: write_test_evidence_bytes(path, bytes)
    identity :: RecordIdentity.new(target_inputs_sha256, report.build.toolchain, report.producer.as_str())
    index_compile_artifact_at(project_root, identity, RecordKind.Evidence, report_id, path, size, RecordCapture.Safe, [], [], protected)
    Ok(())
}
