// Rust: Source/CmdCompile.rs:6397
fn with_test_evidence_environment[R](report_path: OSPath, report_id: String, toolchain: String, target: String, profile: String, source_revision: String, build_revision: String, revision: String, operation: fn() -> R) -> R {
    values :: [(EVIDENCE_REPORT_ENV, report_path.to_string_lossy()), (EVIDENCE_REPORT_ID_ENV, report_id), (EVIDENCE_TOOLCHAIN_ENV, toolchain), (EVIDENCE_TARGET_ENV, target), (EVIDENCE_PROFILE_ENV, profile), (EVIDENCE_SOURCE_REVISION_ENV, source_revision), (EVIDENCE_BUILD_REVISION_ENV, build_revision), (EVIDENCE_REVISION_ENV, revision)]
    previous :: values.iter().map(fn(pair) { (pair.0, env.var_os(pair.0)) }).to_list()
    loop (name, value) in values -> env.set_var(name, value)
    result :: operation()
    loop (name, value) in previous {
        if value == { .Val(value) -> env.set_var(name, value), .None -> env.remove_var(name) }
    }
    result
}
// Rust: Source/CmdCompile.rs:6460
fn harness_test_cases(stdout: String) -> [HarnessTestCase]? Err! {
    if canonical_test_json(stdout) == {
        .Val(document) -> {
            value :: parse_json(document) ?? return Err("the test harness emitted an invalid canonical JSON report")
            tests_value :: value.get("tests") ?? return Err("the test harness report is missing `tests`: {err}")
            tests :: tests_value.as_array() ?? return Err("the test harness report has invalid `tests`: {err}")
            cases := [HarnessTestCase]{}
            loop test in tests {
                name_value :: test.get("name") ?? return Err("the test harness report has an invalid name: {err}")
                name :: name_value.as_str() ?? return Err("the test harness report has an invalid name: {err}")
                ok_value :: test.get("ok") ?? return Err("test `{name}` has no result: {err}")
                ok :: if ok_value == { .Bool(ok) -> ok, else -> return Err("test `{name}` has a non-boolean result") }
                expected_failure :: if test.get_opt("expectedFailure") == { .Val(.Bool(value)) -> value, .None -> false, else -> return Err("test `{name}` has a non-boolean expectation") }
                skipped :: if test.get_opt("skipped") == { .Val(.Bool(value)) -> value, .None -> false, else -> return Err("test `{name}` has a non-boolean skip flag") }
                stderr :: test.get_opt("stderr").and_then(fn(value) { value.as_str().ok() }) ?? ""
                message :: if stderr.is_empty() && !ok -> "test failed" else -> stderr
                &cases.push(HarnessTestCase{name: name, ok: ok, expected_failure: expected_failure, skipped: skipped, message: message})
            }
            return Ok(Val(^cases))
        }
        .None -> {}
    }
    cases := [HarnessTestCase]{}
    loop line in stdout.lines() {
        (name, status) :: line.rsplit_once(": ") ?? continue
        (ok, expected_failure, skipped) :: if status == {
            "pass" -> (true, false, false)
            "expected-fail" -> (true, true, false)
            "skip" -> (true, false, true)
            "FAIL" -> (false, false, false)
            "UNEXPECTED-PASS (remove expected_fail: true)" -> (false, true, false)
            else -> continue
        }
        name := name.trim() // #4303
        if name.is_empty() -> continue
        &cases.push(HarnessTestCase{name: name, ok: ok, expected_failure: expected_failure, skipped: skipped, message: if ok -> "" else -> status})
    }
    Ok(if cases.is_empty() -> None else -> Val(^cases))
}
// Rust: Source/CmdCompile.rs:6541
fn append_harness_test_evidence(report: &EvidenceReport, stdout: String, file: String, report_id: String, build: &EvidenceBuild, revision: &EvidenceRevision, child_ok: Bool) Err! {
    canonicalize_test_report_identity(&report, report_id)
    cases :: harness_test_cases(stdout)
    if cases == {
        .None -> {
            if child_ok -> return Ok(())
            name :: "{file}:harness"
            record := EvidenceRecord.from_test_codes(0, 3, name, "producer unavailable", file, 0).with_report_id(report_id)
            record.build = build
            record.revision = revision
            derivation :: record.checked_derivation()
            report.add_record_with_derivation(^record, derivation) ?? return Err(err.to_string())
            return Ok(())
        }
        .Val(cases) -> {
            terminal_claims := BTreeSet.new()
            loop record in report.records {
                if record.kind == EvidenceKind.Unit || record.kind == EvidenceKind.Property || record.kind == EvidenceKind.Doctest -> _ :: terminal_claims.insert(record.identity.claim_id)
            }
            loop case in cases {
                if terminal_claims.contains(case.name) -> continue
                record := EvidenceRecord.from_test_codes(0, harness_test_state(case), case.name, case.message, file, 0).with_report_id(report_id)
                if case.expected_failure && !case.skipped -> record.set_expectation(EvidenceExpectation.ExpectedFailure) ?? return Err(err.to_string())
                record.build = build
                record.revision = revision
                derivation :: record.checked_derivation()
                report.add_record_with_derivation(^record, derivation) ?? return Err(err.to_string())
                _ :: terminal_claims.insert(case.name)
            }
        }
    }
    Ok(())
}
