fn marker_string(marker: &Marker) -> String? {
    if marker.expr_arg(0) == {
        .Val(.Str(parts, _)) -> {
            if parts.len() != 1 -> return None
            if parts[0] == { .Lit(value) -> Val(value), else -> None }
        }
        else -> None
    }
}
// Rust: Source/CmdCompile.rs:5119
fn schedule_text(marker: &EveryMarker) -> String? {
    if marker.arg == {
        .Duration(int, float, suffix, _) -> {
            number :: int.map(fn(value) { value.to_string() }) ?? float.map(fn(value) { value.to_string() }) ?? ""
            Val("{number}{suffix}")
        }
        .WallClock(text, _) -> Val("day {text}")
        .Expression(_) -> None
    }
}
// Rust: Source/CmdCompile.rs:5137
// One lex+parse source for E1294 and `jet jobs`, retaining source order and metadata.
fn list_job_names(src: String) -> [JobListing] [Diagnostic]! {
    source :: Package.mask_inline_package_source(src) ?? return Err([err.diagnostic()])
    (toks, lex_diags) :: Lexer.lex(source.0)
    if !lex_diags.is_empty() -> return Err(lex_diags)
    prog :: Parser.parse_with_source(toks, source.0)
    jobs := [JobListing]{}
    loop item in prog.items {
        if item == {
            .Func(f) -> {
                if !f.is_job -> continue
                doc :: prog.applied_rules.iter().find(fn(application) { application.target == Val(f.span) && application.marker.name == Syntax.MARKER_DOC }).and_then(fn(application) { marker_string(application.marker) })
                &jobs.push(JobListing{name: f.name, doc: doc, schedule: f.every.and_then(schedule_text), metadata: f.job_metadata})
            }
            else -> {}
        }
    }
    Ok(^jobs)
}
// Rust: Source/CmdCompile.rs:5175
fn print_release_job_summary(src: String, release: Bool, mode: OutputMode) {
    if !release || mode.quiet || mode.json -> return
    jobs :: list_job_names(src) ?? return
    stripped :: jobs.iter().filter(fn(job) { job.metadata.map(fn(metadata) { metadata.scope != JobScope.Ship }) ?? true }).map(fn(job) { job.name }).to_list()
    if !stripped.is_empty() -> write_mode_status(mode, "stripped {stripped.len()} dev job(s): {stripped.join(", ")} (mark #Job(.Ship) to include)\n")
}
// Rust: Source/CmdCompile.rs:5210
fn write_sbom_for_build(file: String, bin: OSPath, mode: OutputMode) {
    file_path :: OSPath.from_text(file)
    search_from :: file_path.parent() ?? OSPath.from_text(".")
    (name, version, maybe_lock) :: if Loader.package_facts_for_entry(file_path) == {
        .Ok(Val(facts)) -> {
            root :: Loader.find_manifest_root(search_from) ?? search_from
            (facts.name, facts.version ?? "0.0.0", Lock.load(root))
        }
        else -> (stem(file), "0.0.0", None)
    }
    lock :: maybe_lock ?? Lock.LockFile{version: 1, packages: [], root_dependencies: [], authority: None, workspace_members: [], workspace_source_digest: None, workspace_overlay_policy: Default.default(), comptime_inputs: [], toolchains: [], browsers: [], source_channels: [], build_stamp: None, build_contributions: []}
    sbom :: Publish.emit_spdx(lock, name, version)
    out :: bin.with_extension("spdx")
    if fs.write(out, sbom) == {
        .Ok(_) -> { if !mode.quiet && !mode.json -> write_mode_status(mode, "sbom: {out.display()}\n") }
        .Err(e) -> write_mode_diagnostic(mode, "warning: couldn't write SBOM to {out.display()}: {e}\n")
    }
}
