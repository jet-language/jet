fn test_result_cache_key(path: OSPath, opts: &TestRunOpts, package: Bool) -> String? {
    identity := [U8]{}
    append_test_cache_field(&identity, "jet-test-result-v2".bytes())
    canonical :: fs.canonicalize(path).unwrap_or_else(fn(_) { path })
    append_test_cache_field(&identity, canonical.to_string_lossy().bytes())
    append_test_cache_field(&identity, (if package -> "package" else -> "file").bytes())
    entry :: path.to_string_lossy()
    (bundle, dependencies) :: Loader.load_entry_with_overlays_and_dependencies(entry, [], false)
    inputs := BTreeSet.new()
    if path.parent().and_then(Loader.find_manifest_root) == { .Val(root) -> _ :: inputs.insert(root.join(Syntax.PACKAGE_FILE)), .None -> {} }
    _ :: inputs.insert(path)
    &inputs.extend(dependencies)
    if bundle == {
        .Ok(bundle) -> {
            loop input in bundle.comptime_inputs {
                append_test_cache_field(&identity, "comptime-input".bytes())
                append_test_cache_field(&identity, input.path.bytes())
                append_test_cache_field(&identity, input.hash.bytes())
            }
