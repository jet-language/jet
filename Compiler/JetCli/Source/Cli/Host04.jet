fn split_test_where_terms(expression: String) -> [String] Err! {
    bytes :: expression.bytes()
    terms := [String]{}
    start := 0
    quote := U8?{None}
    index := 0
    loop index < bytes.len() {
        byte :: bytes[index]
        if quote == {
            .Val(mark) -> {
                if byte == 92 { index = index.saturating_add(2); continue }
                if byte == mark -> quote = None
                index += 1
                continue
            }
            .None -> {}
        }
        if byte == 39 || byte == 34 { quote = Val(byte); index += 1; continue }
        if index + 3 <= bytes.len() && (bytes[index] == 97 || bytes[index] == 65) && (bytes[index + 1] == 110 || bytes[index + 1] == 78) && (bytes[index + 2] == 100 || bytes[index + 2] == 68) && (index == 0 || bytes[index - 1].is_ascii_whitespace()) && (index + 3 == bytes.len() || bytes[index + 3].is_ascii_whitespace()) {
            term := expression[start..index].trim() // #4303
            if term.is_empty() -> return Err("empty predicate before `and`")
            &terms.push(term)
            index += 3
            start = index
            continue
        }
        index += 1
    }
    if quote.is_some() -> return Err("unterminated quote in --where expression")
    term := expression[start..].trim() // #4303
    if term.is_empty() -> return Err("empty predicate in --where expression")
    &terms.push(term)
    Ok(^terms)
}
