fn canonicalize_test_report_identity(report: &EvidenceReport, report_id: String) {
    report.identity.report_id = report_id
    &report.identity.claim_id.clear()
    &report.identity.evidence_id.clear()
}
// Rust: Source/CmdCompile.rs:6631
fn read_or_create_test_evidence_report(path: OSPath, report_id: String, file: String, toolchain: String, target: String, profile: String, source_revision: String, build_revision: String, revision: String) -> EvidenceReport Err! {
    report := if EvidenceReport.read(path) == {
        .Ok(report) -> report
        .Err(error) -> {
            if !path.exists() -> fresh_test_evidence_report(report_id, file, toolchain, target, profile, source_revision, build_revision, revision)
            else -> return Err("could not read test evidence report `{path.display()}`: {error}")
        }
    }
    canonicalize_test_report_identity(&report, report_id)
    Ok(^report)
}
