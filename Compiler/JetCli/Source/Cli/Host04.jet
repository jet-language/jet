fn find_matching_paren(after_open: String) -> Int? {
    depth := 1
    in_string := false
    escape := false
    loop (index, ch) in after_open.char_indices() {
        if in_string {
            if escape -> escape = false
            else if ch == '\\' -> escape = true
            else if ch == '"' -> in_string = false
            continue
        }
        if ch == {
            '"' -> { in_string = true }
            '(' -> { depth += 1 }
            ')' -> { depth -= 1; if depth == 0 -> return Val(index) }
            else -> {}
        }
    }
    None
}
// Rust: Source/CmdCompile.rs:5645
fn replace_untyped_call(src: String, from: String, to: String) -> String {
    out := String.with_capacity(src.len())
    rest := src
    loop {
        index :: rest.find(from) ?? break
        &out.push_str(rest[..index])
        after :: rest[index + from.len()..]
        &out.push_str(if after.starts_with("<") -> from else -> to)
        rest = after
    }
    &out.push_str(rest)
    ^out
}
// Rust: Source/CmdCompile.rs:5662
fn edition_2027_encoding_audit(before: String, after: String) -> [String] {
    notes := [String]{}
    if before.contains("json.canonical(") {
        if after.contains("?? panic(\"value is not canonical JSON\")") || (after.contains("json.canonical(") && after != before) -> &notes.push("rewrote `json.canonical(...)` to fallible form; review hashing/signing fixtures")
        else -> &notes.push("review every `json.canonical(...)` call — edition 2027 requires fallible `json.canonical(data, limits)?` (or an explicit panic fallback)")
    }
    if before != after && (before.contains("cbor.encode(") || before.contains("cbor.decode(")) -> &notes.push("rewrote deprecated CBOR forwarding calls (`encode`/`decode`)")
    if notes.is_empty() -> &notes.push("no encoding forwarding calls found")
    ^notes
}
