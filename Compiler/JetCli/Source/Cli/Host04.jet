}
// Rust: Source/CmdCompile.rs:5504
fn rewrite_json_canonical_calls(src: String) -> String {
    needle :: "json.canonical("
    out := String.with_capacity(src.len())
    base := 0
    rest := src
    loop {
        rel :: rest.find(needle) ?? break
        index :: base + rel
        &out.push_str(rest[..rel])
        after :: rest[rel + needle.len()..]
        end :: find_matching_paren(after) ?? {
            &out.push_str(needle)
            base = index + needle.len()
            rest = after
            continue
        }
        call :: "{needle}{after[..=end]}"
        trailing :: after[end + 1..]
        trimmed := trailing.trim_start() // #4303
        already :: trimmed.starts_with("?")
        if already || enclosing_fn_is_fallible(src, index) -> &out.push_str(call)
        else -> &out.push_str("{call} ?? panic(\"value is not canonical JSON\")")
        base = index + call.len()
        rest = trailing
    }
    &out.push_str(rest)
    ^out
}
