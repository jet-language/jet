        if fs.read(input) == { .Ok(contents) -> append_test_cache_field(&identity, contents), .Err(_) -> append_test_cache_field(&identity, "<missing>".bytes()) }
    }
    profile :: opts.profile ?? (if opts.release || opts.measure -> Syntax.BUILD_PROFILE_RELEASE else -> "dev")
    profile_tag :: "{profile};{setting_overrides_tag(opts.setting_overrides)};aot-target=native"
    mode_tag :: if opts.coverage -> "testcov" else -> "test"
    native_identity :: native_cache_key(entry, profile, profile_tag, mode_tag, None) ?? return None
    append_test_cache_field(&identity, "native-identity".bytes())
    append_test_cache_field(&identity, native_identity.bytes())
    options :: "show_default={opts.show_default};coverage={opts.coverage};release={opts.release};profile={opts.profile:?};trace_tiers={opts.trace_tiers};filter={opts.filter:?};shuffle={opts.shuffle_seed:?};serial={opts.serial};measure={opts.measure};docs={opts.docs};browser={opts.browser_engines:?};browser_retries={opts.browser_retries:?};browser_reporter={opts.browser_reporter:?};browser_ui={opts.browser_ui};browser_visual={opts.browser_visual};browser_trace={opts.browser_trace};"
    append_test_cache_field(&identity, options.bytes())
