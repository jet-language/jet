// `jet prove --capture`, `--capture-sensitive` and `--replay`
// (Docs/spec/proof-replay-decisions.md, "Replay wire format" and "Replay
// privacy, identity, and delivery"): the static authority preflight of the one
// target, the explicit capture destination, the sensitive-data consent, the
// writer and the complete reader of a `.jetproof-replay` artifact. Every
// refusal here comes before a program runs and leaves no artifact. Capture
// records one wall-clock value, which the run's programs read through
// JET_CLI_REPLAY_TIME_ENV; replay hands them the recorded value the same way.
// Sensitive capture also records each raw Rand read, stdin read and HTTP
// client hop through the test harness's journal (JetRuntime
// ProveJournal.jet), and replay serves them back in order.
use {
    cli_files: core.files
    cli_term: core.term
    cli_time: core.time
    prove_crypto: core.crypto
    replay_base64: core.encoding.base64
    replay_random: core.crypto.random
    jet_driver.[JetDriverVerbOutput, JET_DRIVER_EXIT_USAGE, JET_DRIVER_EXIT_USER_ERROR]
    jet_foundation.[
        BuildSettingOverride, CanonicalJSON, CanonicalJSONField, CanonicalJSONParser, Diagnostic, Effect, Expr, ImportDecl, Item, OrFallback, PatSlot, Pattern, Stmt,
        canonical_json_bytes, canonical_json_value, import_alias, import_walk_bindings,
    ]
    jet_parser.[parse_source]
    jet_sema.[sema_taint_core_effect, sema_taint_effect_name]
    jet_pkg_model.[COMPILER_VERSION]
}

// The v1 bounds (proof-replay-decisions): 256 MiB per artifact, 100,000 frames, 1 MiB
// per payload, and the header a reader accepts before it parses it.
JET_CLI_REPLAY_MAX_ARTIFACT: 268435456
JET_CLI_REPLAY_MAX_FRAMES: 100000
JET_CLI_REPLAY_MAX_PAYLOAD: 1048576
JET_CLI_REPLAY_MAX_HEADER: 4194304
// The largest integer canonical JSON writes as decimal (2^53 - 1).
JET_CLI_REPLAY_MAX_EXACT: 9007199254740991
// The largest signed 64-bit clock value.
JET_CLI_REPLAY_MAX_I64: 9223372036854775807
JET_CLI_REPLAY_ADAPTER: "mir-v1"
// Frame kinds: TimeWall, RandBits, IORead, IOChunk, IOEnd, NetRequest,
// NetDns, NetResponse, NetChunk, NetEnd, and the RunAct extension.
JET_CLI_REPLAY_KIND_TIME: 1
JET_CLI_REPLAY_KIND_RAND: 16
JET_CLI_REPLAY_KIND_IO_READ: 32
JET_CLI_REPLAY_KIND_IO_CHUNK: 33
JET_CLI_REPLAY_KIND_IO_END: 34
JET_CLI_REPLAY_KIND_NET_REQUEST: 48
JET_CLI_REPLAY_KIND_NET_DNS: 49
JET_CLI_REPLAY_KIND_NET_RESPONSE: 50
JET_CLI_REPLAY_KIND_NET_CHUNK: 51
JET_CLI_REPLAY_KIND_NET_END: 52
JET_CLI_REPLAY_KIND_ACT: 4097
// The kinds this reader decodes.
JET_CLI_REPLAY_DECODED_KINDS: [Int]{JET_CLI_REPLAY_KIND_TIME, JET_CLI_REPLAY_KIND_RAND, JET_CLI_REPLAY_KIND_IO_READ, JET_CLI_REPLAY_KIND_IO_CHUNK, JET_CLI_REPLAY_KIND_IO_END, JET_CLI_REPLAY_KIND_NET_REQUEST, JET_CLI_REPLAY_KIND_NET_DNS, JET_CLI_REPLAY_KIND_NET_RESPONSE, JET_CLI_REPLAY_KIND_NET_CHUNK, JET_CLI_REPLAY_KIND_NET_END, JET_CLI_REPLAY_KIND_ACT}
// Every v1 registry kind: TimeWall, TimeMonotonic, TimeSleep, RandBits, the
// I/O and network records, Outcome and GameEvent. A registered kind this
// reader does not replay needs a newer reader (E3620).
JET_CLI_REPLAY_KINDS_V1: [Int]{1, 2, 3, 16, 32, 33, 34, 48, 49, 50, 51, 52, 240, 16384}
// The ambient terminal builtins (Syntax `IMPURE_BUILTINS`): raw IO. Output
// reaches the terminal live and is never recorded; `input` and
// `read_all_input` read through the runtime's one stdin buffer, whose raw
// reads a sensitive capture records.
JET_CLI_REPLAY_IO_BUILTINS: [String]{"print", "eprint", "input", "read_all_input"}
JET_CLI_REPLAY_STDIN_BUILTINS: [String]{"input", "read_all_input"}
// The most bytes one IOChunk carries: its base64url text stays well under
// the 1 MiB payload limit.
JET_CLI_REPLAY_IO_CHUNK_BYTES: 524288
// The portable I/O error registry and the one Linux errno each name
// replays as. An errno outside it, or one of two that share a name
// (EPERM beside EACCES, EWOULDBLOCK is EAGAIN), cannot be replayed exactly.
JET_CLI_REPLAY_IO_ERRORS: [String]{"interrupted", "timed_out", "would_block", "broken_pipe", "connection_aborted", "connection_refused", "connection_reset", "not_connected", "address_in_use", "address_unavailable", "permission_denied", "not_found"}
JET_CLI_REPLAY_IO_ERRNOS: [Int]{4, 110, 11, 32, 103, 111, 104, 107, 98, 99, 13, 2}
// The whole portable registry, which a NetEnd outcome names: Core's HTTP
// client fails a replayed hop with the error's name as its message.
JET_CLI_REPLAY_NET_ERRORS: [String]{"interrupted", "timed_out", "would_block", "broken_pipe", "connection_aborted", "connection_refused", "connection_reset", "not_connected", "address_in_use", "address_unavailable", "permission_denied", "not_found", "unexpected_eof", "invalid_data"}
// How far a hop got (Core/Http/Client.jet C_CLIENT_STAGE_*), as NetEnd's
// `phase`.
JET_CLI_REPLAY_NET_PHASES: [String]{"resolve", "connect", "handshake", "exchange"}
// The most bytes one NetChunk carries, as for IOChunk.
JET_CLI_REPLAY_NET_CHUNK_BYTES: 524288
JET_CLI_REPLAY_IDENTITY_KEYS: [String]{"abi", "build_digest", "core_abi", "entry", "execution_adapter", "lock_digest", "mir_identity", "mir_schema", "optimized_mir_hash", "profile", "semantic_mir_hash", "source_digest", "target_triple", "time_site_id"}
JET_CLI_REPLAY_MIR_KEYS: [String]{"core_ids", "function_ids", "identity_digest", "optimized_hash", "schema", "semantic_hash", "source_map", "target_facts"}
// The runtime's wall-clock override (JetRuntime HostTime.jet
// `jet_time_raw_wall_override_ms`), in Unix milliseconds.
JET_CLI_REPLAY_TIME_ENV: "JET_PROVE_REPLAY_TIME_MS"
// The test harness's authority journal (JetRuntime ProveJournal.jet): the
// file a capture appends each raw read to, and the records and served-trace
// files a replay reads from.
JET_CLI_REPLAY_CAPTURE_ENV: "JET_PROVE_CAPTURE_JOURNAL"
JET_CLI_REPLAY_RECORDS_ENV: "JET_PROVE_REPLAY_JOURNAL"
JET_CLI_REPLAY_TRACE_ENV: "JET_PROVE_REPLAY_TRACE"
// A journal record: u8 kind, u64 LE request, u64 LE result, then the
// result's bytes for an uppercase kind. `R` is a Rand read the OS answered,
// `r` one it refused; `I` is a stdin read of up to `request` bytes that
// delivered `result` (0 at end of input), `i` one that failed with errno
// `result`; `N` is one HTTP client hop (request 0) with the `result` bytes
// Core encoded (JetCLIReplayNetHop). A replay's trace holds `Q`, u64 LE
// length and the request bytes of each hop the run made.
JET_CLI_REPLAY_JOURNAL_HEAD: 17
JET_CLI_REPLAY_JOURNAL_RAND: 82
JET_CLI_REPLAY_JOURNAL_RAND_FAILED: 114
JET_CLI_REPLAY_JOURNAL_STDIN: 73
JET_CLI_REPLAY_JOURNAL_STDIN_FAILED: 105
JET_CLI_REPLAY_JOURNAL_NET: 78
JET_CLI_REPLAY_JOURNAL_REQUEST: 81
// The exact phrase a terminal types to consent to sensitive capture.
JET_CLI_REPLAY_CONSENT: "capture sensitive"

// A verified artifact: its id, the target identity it is bound to, its
// capture mode and roots, its privacy salt's bytes, the one recorded
// wall-clock value, the Rand, stdin and HTTP reads in the order the run made
// them, each HTTP hop's NetRequest, and the exit status of the captured run.
JetCLIReplayArtifact: struct {
    artifact_id: String
    identity: [CanonicalJSONField]
    sensitive: Bool
    roots: [String]
    salt: [U8]
    unix_ns: Int
    reads: [JetCLIReplayRead]
    requests: [JetCLIReplayNetSeen]
    status: Int
}

// One recorded raw read, as its journal record: `kind` `R` (Rand bytes),
// `I` (stdin bytes, none at end of input), `i` (a failed stdin read) or `N`
// (an HTTP hop), the site it answers, the count asked for, the count
// delivered (the errno for `i`), and the delivered bytes. An `N` read's
// bytes are Core's capture record in a capture and the replay form
// (u64 LE stage, sends, stream length, the stream, then the ending) in a
// verified artifact.
JetCLIReplayRead: struct {
    kind: Int
    site_id: String
    request: Int
    result: Int
    bytes: [U8]
}

// A recorded NetRequest frame: its sequence (the hop's `request_id`) and
// its payload, which a replay's hop must match.
JetCLIReplayNetSeen: struct {
    request_id: Int
    payload: [U8]
}

// The HTTP hop a reader has open: its NetRequest's sequence and site,
// whether its NetDns and NetResponse frames came, and the NetChunk bytes
// so far.
JetCLIReplayNetOpen: struct {
    request_id: Int
    site_id: String
    resolved: Bool
    answered: Bool
    chunks: Int
    stream: [U8]
}

// One HTTP client hop as Core encodes it (Core/Http/Client.jet
// `__client_net_tape`, u64 LE numbers, each text after its u64 length): the
// request, then how far the hop got, the resolver's answers, the sends that
// went out, every byte read, the reply the program saw, and the ending.
JetCLIReplayNetHop: struct {
    hop: Int
    method: String
    scheme: String
    host: String
    port: Int
    target: String
    names: [String]
    values: [String]
    body: [U8]?
    stage: Int
    addresses: [[U8]]
    sends: Int
    stream: [U8]
    answered: Bool
    status: Int
    reply_names: [String]
    reply_values: [String]
    ending: String
}

// A capture or replay whose checks passed: the wall-clock value the run's
// programs read, the target identity, the capture mode and roots, the Time,
// Rand, stdin and HTTP site ids, and the replayed artifact.
JetCLIReplayRun: struct {
    time_ms: Int
    identity: [CanonicalJSONField]
    site_id: String
    rand_site_id: String
    io_site_id: String
    net_site_id: String
    sensitive: Bool
    roots: [String]
    replayed: JetCLIReplayArtifact?
}

// The journal files one sensitive run hands its test harnesses; an empty
// path is a file this run does not use.
JetCLIReplayJournal: struct {
    capture: String
    records: String
    trace: String
}

// One reachable call the replay authority must model: `authority` is None for
// an opaque boundary (an unknown callee, an unsafe or concurrent region), and
// `owner` is the Core module it resolves to ("" when none does).
JetCLIReplaySite: struct {
    operation: String
    authority: Effect?
    owner: String
}

// One failed artifact check: E3620 (an unsupported reader vocabulary), E3628
// (a crossed bound) or E3622 (every other byte, frame or canonical check).
#Error
JetCLIReplayFault: struct {
    code: String
    why: String
}

jet_cli_replay_corrupt: fn(why: String) -> JetCLIReplayFault Never! {
    JetCLIReplayFault{code: "E3622", why: why}
}

jet_cli_replay_unsupported: fn(why: String) -> JetCLIReplayFault Never! {
    JetCLIReplayFault{code: "E3620", why: why}
}

jet_cli_replay_limit: fn(why: String) -> JetCLIReplayFault Never! {
    JetCLIReplayFault{code: "E3628", why: why}
}

jet_cli_replay_refusal: fn(code: String, what: String, why: String, fix: String) -> JetCLIProveRefusal Never! {
    JetCLIProveRefusal{code: code, what: what, why: why, fix: fix, exit_code: JET_DRIVER_EXIT_USER_ERROR}
}

// The capture or replay form of `jet prove` once its checks pass, or the
// refusal output.
jet_cli_prove_replay_checks: fn(identity: JetCLIProveIdentity, members: [JetCLIProveMember], capture: JetCLIProveCapture?, replay: String?, color: Bool, json: Bool) -> JetCLIReplayRun JetCLIProveStop! {
    root: identity.authority_root
    sites: jet_cli_replay_sites(members)
    site_id: jet_cli_replay_site_id(identity, members, sites)
    rand_site_id: jet_cli_replay_rand_site_id(identity, members, sites)
    io_site_id: jet_cli_replay_io_site_id(identity, members, sites)
    net_site_id: jet_cli_replay_net_site_id(identity, members, sites)
    expected: jet_cli_replay_target_identity(identity, members, site_id)
    if capture == .Val(request) {
        if jet_cli_replay_capture_refusal(root, request, sites) == .Val(refusal) -> return Err(JetCLIProveStop{output: jet_cli_prove_refused(refusal, color, json)})
        roots: jet_cli_replay_capture_roots(sites, request.sensitive)
        if request.sensitive {
            if jet_cli_replay_consent(identity, members, request, roots) == .Val(refusal) -> return Err(JetCLIProveStop{output: jet_cli_prove_refused(refusal, color, json)})
        }
        return Ok(JetCLIReplayRun{time_ms: jet_cli_replay_clock_ms(), identity: expected, site_id: site_id, rand_site_id: rand_site_id, io_site_id: io_site_id, net_site_id: net_site_id, sensitive: request.sensitive, roots: roots, replayed: None})
    }
    raw: replay ?? return Err(JetCLIProveStop{output: jet_cli_ice("prove replay checks ran without --capture or --replay")})
    artifact: jet_cli_replay_input(root, raw, sites, expected, rand_site_id, io_site_id, net_site_id) ?? return Err(JetCLIProveStop{output: jet_cli_prove_refused(err, color, json)})
    Ok(JetCLIReplayRun{time_ms: artifact.unix_ns /% 1000000, identity: expected, site_id: site_id, rand_site_id: rand_site_id, io_site_id: io_site_id, net_site_id: net_site_id, sensitive: artifact.sensitive, roots: artifact.roots.copy(), replayed: Val(artifact)})
}

// The roots a capture records, in byte order: IO when a sensitive target
// reaches the terminal builtins, Net when it reaches Core's HTTP client,
// Rand when it reaches Rand, and Time always, since every capture pins the
// clock.
jet_cli_replay_capture_roots: fn(sites: [JetCLIReplaySite], sensitive: Bool) -> [String] Never! {
    roots := [String]{}
    if sensitive && jet_cli_replay_reaches(sites, Effect.IO) -> roots.push("IO")
    if sensitive && jet_cli_replay_reaches_http(sites) -> roots.push("Net")
    if sensitive && jet_cli_replay_reaches(sites, Effect.Rand) -> roots.push("Rand")
    roots.push("Time")
    roots
}

// A Net site the HTTP client's journal records: a request of Core's HTTP
// client (core.http.client, or core.http's client calls), not a server, a
// raw socket, or the build-time transport.
jet_cli_replay_is_http_client: fn(site: JetCLIReplaySite) -> Bool Never! {
    authority: site.authority ?? return false
    if authority != Effect.Net -> return false
    dot: site.operation.rfind(".")
    member: if dot < 0 -> site.operation else -> site.operation.slice(dot + 1, site.operation.len())
    if site.owner == "core.http.client" -> return !member.starts_with("jet_http_build_") && !member.starts_with("__")
    site.owner == "core.http" && !member.starts_with("serve") && !member.starts_with("__")
}

jet_cli_replay_reaches_http: fn(sites: [JetCLIReplaySite]) -> Bool Never! {
    loop site in sites {
        if jet_cli_replay_is_http_client(site) -> return true
    }
    false
}

jet_cli_replay_is_terminal_io: fn(site: JetCLIReplaySite) -> Bool Never! {
    if site.authority == .Val(authority) -> return authority == Effect.IO && JET_CLI_REPLAY_IO_BUILTINS.contains(site.operation)
    false
}

jet_cli_replay_is_stdin_read: fn(site: JetCLIReplaySite) -> Bool Never! {
    if site.authority == .Val(authority) -> return authority == Effect.IO && JET_CLI_REPLAY_STDIN_BUILTINS.contains(site.operation)
    false
}

jet_cli_replay_reaches: fn(sites: [JetCLIReplaySite], authority: Effect) -> Bool Never! {
    loop site in sites {
        if site.authority == .Val(found) {
            if found == authority -> return true
        }
    }
    false
}

// The sensitive-data disclosure on stderr, then the typed phrase on the
// terminal: anything but exactly `capture sensitive` refuses (E3627).
jet_cli_replay_consent: fn(identity: JetCLIProveIdentity, members: [JetCLIProveMember], request: JetCLIProveCapture, roots: [String]) -> JetCLIProveRefusal? {
    stem: jet_cli_replay_entry_stem(jet_cli_replay_entry(identity.authority_root, members))
    destination: request.path ?? ".jet/replays/{stem}-<id>.jetproof-replay"
    disclosed := ""
    if roots.contains("IO") -> disclosed = "the text the program reads from stdin, "
    if roots.contains("Net") -> disclosed = "{disclosed}the HTTP responses the program reads, with their DNS answers, "
    if roots.contains("Rand") -> disclosed = "{disclosed}the random bytes the program reads, "
    hosts: if roots.contains("Net") -> "the hosts the program's HTTP requests name, decided as it runs" else -> "none"
    cli_term.eprint("jet prove --capture-sensitive stores raw values from this run in a file that is not encrypted:\n  authorities: {roots.join(", ")}\n  hosts: {hosts}\n  byte limits: {JET_CLI_REPLAY_MAX_PAYLOAD} bytes per record, {JET_CLI_REPLAY_MAX_FRAMES} records, {JET_CLI_REPLAY_MAX_ARTIFACT} bytes per artifact\n  may disclose: {disclosed}paths, host names, panic text and run metadata\n  destination: {destination} (mode 0600)\nType `{JET_CLI_REPLAY_CONSENT}` to record it:")
    input := cli_term.stdin()
    answer: input.read_line() ?? ""
    if answer.removesuffix("\n").removesuffix("\r") == JET_CLI_REPLAY_CONSENT -> return None
    Val(jet_cli_replay_refusal("E3627", "replay capture refused sensitive data", "the consent phrase was not typed, so no raw Rand/IO/Net value is recorded", "run again and type `capture sensitive` exactly, or use safe `--capture` for Time-only roots"))
}

// One wall-clock read, at the millisecond the runtime hands programs. A
// reading whose nanoseconds would encode as all-digit hex, which the reader
// takes for decimal, is read again a millisecond later.
jet_cli_replay_clock_ms: fn() -> Int {
    loop {
        ms: cli_time.unix_ns() /% 1000000
        if jet_cli_replay_u64_value(jet_cli_replay_u64_text(ms * 1000000)) == .Val(back) {
            if back == ms * 1000000 -> return ms
        }
        cli_time.sleep(1ms)
    }
}

// The target identity a capture records and a replay must match: the proof
// digests, the entry, the adapter and the one Time site.
jet_cli_replay_target_identity: fn(identity: JetCLIProveIdentity, members: [JetCLIProveMember], site_id: String) -> [CanonicalJSONField] {
    triple: jet_cli_prove_triple()
    parts: triple.split("-").to_list()
    // Keys in byte order, as canonical JSON writes them.
    [CanonicalJSONField]{
        jet_cli_replay_string("abi", parts[parts.len() - 1]),
        jet_cli_replay_string("build_digest", identity.build_digest),
        jet_cli_replay_string("core_abi", identity.core_abi),
        jet_cli_replay_string("entry", jet_cli_replay_entry(identity.authority_root, members)),
        jet_cli_replay_string("execution_adapter", JET_CLI_REPLAY_ADAPTER),
        jet_cli_replay_string("lock_digest", identity.lock_digest),
        jet_cli_replay_string("mir_identity", identity.mir_json),
        jet_cli_replay_string("mir_schema", JET_CLI_REPLAY_ADAPTER),
        jet_cli_replay_string("optimized_mir_hash", identity.mir_hash),
        jet_cli_replay_string("profile", identity.profile),
        jet_cli_replay_string("semantic_mir_hash", identity.mir_hash),
        jet_cli_replay_string("source_digest", identity.source_digest),
        jet_cli_replay_string("target_triple", triple),
        jet_cli_replay_string("time_site_id", site_id),
    }
}

jet_cli_replay_string: fn(key: String, value: String) -> CanonicalJSONField Never! {
    CanonicalJSONField{key: key, value: CanonicalJSON.String(value)}
}

jet_cli_replay_integer_field: fn(key: String, value: Int) -> CanonicalJSONField Never! {
    CanonicalJSONField{key: key, value: CanonicalJSON.Integer("{value}")}
}

// The first member's path below the authority root.
jet_cli_replay_entry: fn(root: String, members: [JetCLIProveMember]) -> String Never! {
    if members.len() == 0 -> return ""
    absolute: members[0].absolute
    if absolute.starts_with("{root}/") -> return absolute.removeprefix("{root}/")
    jet_cli_file_name(absolute)
}

// The one `core.time.now` site the Time record answers, named by the entry,
// the source digest and the call; a target with no such site still gets a
// distinct id, which safe replay refuses as E3623.
jet_cli_replay_site_id: fn(identity: JetCLIProveIdentity, members: [JetCLIProveMember], sites: [JetCLIReplaySite]) -> String Never! {
    operation := "none"
    loop site in sites {
        if operation == "none" && jet_cli_replay_is_time_now(site) -> operation = site.operation.copy()
    }
    jet_cli_replay_site_digest("jet.replay.v1/time-site", identity, members, operation)
}

// The site every RandBits record answers. The runtime sees each OS read,
// not the call that made it, so the target's Rand calls share one site
// named by all of them, and `call_id` counts the reads in order.
jet_cli_replay_rand_site_id: fn(identity: JetCLIProveIdentity, members: [JetCLIProveMember], sites: [JetCLIReplaySite]) -> String Never! {
    operations := [String]{}
    loop site in sites {
        if site.authority == .Val(authority) {
            if authority == Effect.Rand -> operations.push(site.operation.copy())
        }
    }
    jet_cli_replay_site_digest("jet.replay.v1/rand-site", identity, members, operations.join("\n"))
}

// The site every IORead record answers: the target's stdin reads, which
// the runtime sees as raw reads of its one stdin buffer, share one site
// named by all of them, as Rand's do.
jet_cli_replay_io_site_id: fn(identity: JetCLIProveIdentity, members: [JetCLIProveMember], sites: [JetCLIReplaySite]) -> String Never! {
    operations := [String]{}
    loop site in sites {
        if jet_cli_replay_is_stdin_read(site) -> operations.push(site.operation.copy())
    }
    jet_cli_replay_site_digest("jet.replay.v1/io-site", identity, members, operations.join("\n"))
}

jet_cli_replay_site_digest: fn(domain: String, identity: JetCLIProveIdentity, members: [JetCLIProveMember], operation: String) -> String Never! {
    out := [U8]{}
    loop field in ([String]{domain, jet_cli_replay_entry(identity.authority_root, members), identity.source_digest, operation}) -> jet_cli_receipt_frame(out, field.bytes())
    prove_crypto.sha256(out).hex()
}

// The site every NetRequest record answers: the target's HTTP client calls,
// which the runtime sees as the hops Core makes, share one site named by
// all of them, as Rand's do.
jet_cli_replay_net_site_id: fn(identity: JetCLIProveIdentity, members: [JetCLIProveMember], sites: [JetCLIReplaySite]) -> String Never! {
    operations := [String]{}
    loop site in sites {
        if jet_cli_replay_is_http_client(site) -> operations.push(site.operation.copy())
    }
    jet_cli_replay_site_digest("jet.replay.v1/net-site", identity, members, operations.join("\n"))
}

// The v1 bytes of one capture: the canonical header, the TimeWall frame,
// then each raw read in the order the run made it (a RandBits frame, an
// IORead frame followed by the IOChunk frames it delivered or the IOEnd that
// ended it, or an HTTP hop's Net frames), and the footer, with the content
// id in place.
jet_cli_replay_encode: fn(run: JetCLIReplayRun, reads: [JetCLIReplayRead], salt: String, status: Int) -> [U8] Never! {
    header: jet_cli_replay_header_bytes("0".repeat(24), run, salt, status)
    out := "JREPLAY".bytes()
    out.push(U8{0})
    jet_cli_replay_put_le(out, 1, 2)
    jet_cli_replay_put_le(out, 0, 2)
    jet_cli_replay_put_le(out, header.len(), 4)
    out.extend(header)
    ns: CanonicalJSON.Object([CanonicalJSONField]{
        jet_cli_replay_integer_field("bits", 64),
        jet_cli_replay_string("t", "int"),
        jet_cli_replay_string("v", jet_cli_replay_u64_text(run.time_ms * 1000000)),
    })
    payloads := [[U8]]{canonical_json_bytes(CanonicalJSON.Object([CanonicalJSONField]{
        jet_cli_replay_integer_field("call_id", 0),
        jet_cli_replay_string("site_id", run.site_id),
        CanonicalJSONField{key: "unix_ns", value: ns},
    }))}
    kinds := [Int]{JET_CLI_REPLAY_KIND_TIME}
    rand_calls := 0
    io_calls := 0
    net_calls := 0
    salt_bytes: replay_base64.decode_url(salt) ?? panic("the capture's privacy salt is base64url")
    loop read in reads {
        if read.kind == JET_CLI_REPLAY_JOURNAL_RAND {
            payloads.push(canonical_json_bytes(CanonicalJSON.Object([CanonicalJSONField]{
                CanonicalJSONField{key: "bits", value: jet_cli_replay_bytes_value(read.bytes)},
                jet_cli_replay_integer_field("call_id", rand_calls),
                CanonicalJSONField{key: "requested_bits", value: jet_cli_replay_uint(read.bytes.len() * 8)},
                jet_cli_replay_string("site_id", read.site_id),
            })))
            kinds.push(JET_CLI_REPLAY_KIND_RAND)
            rand_calls += 1
            next
        }
        if read.kind == JET_CLI_REPLAY_JOURNAL_NET {
            jet_cli_replay_net_frames(payloads, kinds, read, net_calls, salt_bytes)
            net_calls += 1
            next
        }
        // Each read is its own stream, named by its IORead frame's sequence.
        stream: jet_cli_replay_integer_field("stream_id", payloads.len())
        payloads.push(canonical_json_bytes(CanonicalJSON.Object([CanonicalJSONField]{
            jet_cli_replay_integer_field("call_id", io_calls),
            CanonicalJSONField{key: "requested_bytes", value: jet_cli_replay_uint(read.request)},
            jet_cli_replay_string("site_id", read.site_id),
            stream,
        })))
        kinds.push(JET_CLI_REPLAY_KIND_IO_READ)
        io_calls += 1
        if read.kind == JET_CLI_REPLAY_JOURNAL_STDIN && read.result > 0 {
            chunk := 0
            loop chunk * JET_CLI_REPLAY_IO_CHUNK_BYTES < read.result {
                start: chunk * JET_CLI_REPLAY_IO_CHUNK_BYTES
                end: if read.result - start > JET_CLI_REPLAY_IO_CHUNK_BYTES -> start + JET_CLI_REPLAY_IO_CHUNK_BYTES else -> read.result
                payloads.push(canonical_json_bytes(CanonicalJSON.Object([CanonicalJSONField]{
                    CanonicalJSONField{key: "bytes", value: jet_cli_replay_bytes_value(read.bytes.slice(start, end))},
                    jet_cli_replay_integer_field("chunk_index", chunk),
                    stream,
                })))
                kinds.push(JET_CLI_REPLAY_KIND_IO_CHUNK)
                chunk += 1
            }
            next
        }
        outcome: if read.kind == JET_CLI_REPLAY_JOURNAL_STDIN -> jet_cli_replay_io_outcome(None) else -> jet_cli_replay_io_outcome(jet_cli_replay_io_error_name(read.result))
        payloads.push(canonical_json_bytes(CanonicalJSON.Object([CanonicalJSONField]{
            jet_cli_replay_integer_field("chunks", 0),
            CanonicalJSONField{key: "outcome", value: outcome},
            stream,
            CanonicalJSONField{key: "total_bytes", value: jet_cli_replay_uint(0)},
        })))
        kinds.push(JET_CLI_REPLAY_KIND_IO_END)
    }
    payload_bytes := 0
    loop (sequence, record) in payloads {
        payload: record.slice(0, record.len() - 1)
        frame := [U8]{U8{1}}
        jet_cli_replay_put_le(frame, kinds[sequence], 2)
        jet_cli_replay_put_le(frame, sequence, 8)
        jet_cli_replay_put_le(frame, payload.len(), 4)
        frame.extend(payload.copy())
        out.extend(frame.copy())
        out.extend(prove_crypto.sha256(frame).as_bytes())
        payload_bytes += payload.len()
    }
    // With the id zeroed, these bytes are what the content id hashes.
    id: prove_crypto.sha256(out).hex().slice(0, 24)
    bytes := out.slice(0, 32)
    bytes.extend(id.bytes())
    bytes.extend(out.slice(56, out.len()))
    footer_hash: prove_crypto.sha256(bytes).as_bytes()
    bytes.extend("JEND".bytes())
    jet_cli_replay_put_le(bytes, payloads.len(), 8)
    jet_cli_replay_put_le(bytes, payload_bytes, 8)
    bytes.extend(footer_hash)
    bytes
}

// The frames of one HTTP hop: NetRequest, NetDns once it resolved,
// NetResponse when the program saw a reply, a NetChunk per 512 KiB it read,
// and NetEnd. `request_id` is the NetRequest frame's sequence.
jet_cli_replay_net_frames: fn(payloads: &[[U8]], kinds: &[Int], read: JetCLIReplayRead, call: Int, salt: [U8]) Never! {
    hop: jet_cli_replay_net_hop(read.bytes) ?? panic("a Net journal record is checked when it is read")
    request_id: payloads.len()
    payloads.push(canonical_json_bytes(CanonicalJSON.Object(jet_cli_replay_net_request_fields(hop, call, request_id, read.site_id, salt))))
    kinds.push(JET_CLI_REPLAY_KIND_NET_REQUEST)
    id: jet_cli_replay_integer_field("request_id", request_id)
    if hop.stage >= 1 {
        addresses := [CanonicalJSON]{}
        loop address in hop.addresses -> addresses.push(CanonicalJSON.String(jet_cli_replay_ip_text(address)))
        payloads.push(canonical_json_bytes(CanonicalJSON.Object([CanonicalJSONField]{
            CanonicalJSONField{key: "addresses", value: CanonicalJSON.Array(addresses)},
            id,
        })))
        kinds.push(JET_CLI_REPLAY_KIND_NET_DNS)
    }
    if hop.answered {
        headers := [CanonicalJSON]{}
        loop (at, name) in hop.reply_names {
            headers.push(CanonicalJSON.Object([CanonicalJSONField]{jet_cli_replay_string("name", name), jet_cli_replay_string("value", hop.reply_values[at])}))
        }
        payloads.push(canonical_json_bytes(CanonicalJSON.Object([CanonicalJSONField]{
            CanonicalJSONField{key: "headers", value: CanonicalJSON.Array(headers)},
            id,
            jet_cli_replay_integer_field("status", hop.status),
        })))
        kinds.push(JET_CLI_REPLAY_KIND_NET_RESPONSE)
    }
    chunk := 0
    loop chunk * JET_CLI_REPLAY_NET_CHUNK_BYTES < hop.stream.len() {
        start: chunk * JET_CLI_REPLAY_NET_CHUNK_BYTES
        end: if hop.stream.len() - start > JET_CLI_REPLAY_NET_CHUNK_BYTES -> start + JET_CLI_REPLAY_NET_CHUNK_BYTES else -> hop.stream.len()
        payloads.push(canonical_json_bytes(CanonicalJSON.Object([CanonicalJSONField]{
            CanonicalJSONField{key: "bytes", value: jet_cli_replay_bytes_value(hop.stream.slice(start, end))},
            jet_cli_replay_integer_field("chunk_index", chunk),
            id,
        })))
        kinds.push(JET_CLI_REPLAY_KIND_NET_CHUNK)
        chunk += 1
    }
    outcome: if hop.ending == "eof" -> jet_cli_replay_io_outcome(None) else -> jet_cli_replay_io_outcome(Val(hop.ending))
    payloads.push(canonical_json_bytes(CanonicalJSON.Object([CanonicalJSONField]{
        jet_cli_replay_integer_field("chunks", chunk),
        CanonicalJSONField{key: "outcome", value: outcome},
        jet_cli_replay_string("phase", JET_CLI_REPLAY_NET_PHASES[hop.stage]),
        id,
        CanonicalJSONField{key: "sends", value: jet_cli_replay_uint(hop.sends)},
        CanonicalJSONField{key: "total_bytes", value: jet_cli_replay_uint(hop.stream.len())},
    })))
    kinds.push(JET_CLI_REPLAY_KIND_NET_END)
}

// A NetRequest's fields, in byte order. The body and each header field are
// kept only as salted digests, so the artifact never holds them.
jet_cli_replay_net_request_fields: fn(hop: JetCLIReplayNetHop, call: Int, request_id: Int, site_id: String, salt: [U8]) -> [CanonicalJSONField] Never! {
    body := CanonicalJSON.Null
    if hop.body == .Val(bytes) -> body = CanonicalJSON.String(jet_cli_replay_net_digest("jet.replay.v1/net-body", salt, [[U8]]{bytes}))
    headers := [CanonicalJSON]{}
    loop (at, name) in hop.names {
        digest: jet_cli_replay_net_digest("jet.replay.v1/net-header", salt, [[U8]]{name.bytes(), hop.values[at].bytes()})
        headers.push(CanonicalJSON.Object([CanonicalJSONField]{jet_cli_replay_string("digest_sha256", digest), jet_cli_replay_string("name", name)}))
    }
    [CanonicalJSONField]{
        CanonicalJSONField{key: "body_digest", value: body},
        jet_cli_replay_integer_field("call_id", call),
        CanonicalJSONField{key: "header_digests", value: CanonicalJSON.Array(headers)},
        jet_cli_replay_string("host", hop.host),
        jet_cli_replay_string("method", hop.method),
        jet_cli_replay_string("path", hop.target),
        jet_cli_replay_integer_field("port", hop.port),
        jet_cli_replay_integer_field("redirect_index", hop.hop),
        jet_cli_replay_integer_field("request_id", request_id),
        jet_cli_replay_string("scheme", hop.scheme),
        jet_cli_replay_string("site_id", site_id),
    }
}

// SHA-256 hex of the domain, a NUL, the artifact's 32 salt bytes, then
// each part after its u64 big-endian length.
jet_cli_replay_net_digest: fn(domain: String, salt: [U8], parts: [[U8]]) -> String Never! {
    out := domain.bytes()
    out.push(U8{0})
    out.extend(salt.copy())
    loop part in parts {
        loop step in 0..<8 {
            shift: 7 - step
            rest := part.len()
            loop _ in 0..<shift -> rest = rest /% 256
            out.push(U8.from_int(rest %% 256) ?? panic("replay digest byte"))
        }
        out.extend(part.copy())
    }
    prove_crypto.sha256(out).hex()
}

// A reader over Core's u64 LE numbers and length-prefixed byte strings;
// `bad` once a read ran past the end or held a number above 2^32.
JetCLIReplayCursor: struct {
    bytes: [U8]
    at: Int
    bad: Bool
}

jet_cli_replay_cursor_u64: fn(cursor: &JetCLIReplayCursor) -> Int Never! {
    if cursor.bad || cursor.at + 8 > cursor.bytes.len() {
        cursor.bad = true
        return 0
    }
    value: jet_cli_replay_journal_u64(cursor.bytes, cursor.at)
    cursor.at += 8
    if value < 0 {
        cursor.bad = true
        return 0
    }
    value
}

jet_cli_replay_cursor_bytes: fn(cursor: &JetCLIReplayCursor) -> [U8] Never! {
    size: jet_cli_replay_cursor_u64(cursor)
    if cursor.bad || size > cursor.bytes.len() - cursor.at {
        cursor.bad = true
        return [U8]{}
    }
    out: cursor.bytes.slice(cursor.at, cursor.at + size)
    cursor.at += size
    out
}

jet_cli_replay_cursor_text: fn(cursor: &JetCLIReplayCursor) -> String Never! {
    bytes: jet_cli_replay_cursor_bytes(cursor)
    text: String.from_bytes(bytes) ?? {
        cursor.bad = true
        return ""
    }
    text
}

// The request part of a hop record (Core's `__client_net_request`), the
// rest of the hop empty.
jet_cli_replay_net_request_read: fn(cursor: &JetCLIReplayCursor) -> JetCLIReplayNetHop Never! {
    hop := JetCLIReplayNetHop{hop: 0, method: "", scheme: "", host: "", port: 0, target: "", names: [String]{}, values: [String]{}, body: None, stage: 0, addresses: [[U8]]{}, sends: 0, stream: [U8]{}, answered: false, status: 0, reply_names: [String]{}, reply_values: [String]{}, ending: ""}
    hop.hop = jet_cli_replay_cursor_u64(cursor)
    hop.method = jet_cli_replay_cursor_text(cursor)
    hop.scheme = jet_cli_replay_cursor_text(cursor)
    hop.host = jet_cli_replay_cursor_text(cursor)
    hop.port = jet_cli_replay_cursor_u64(cursor)
    hop.target = jet_cli_replay_cursor_text(cursor)
    fields: jet_cli_replay_cursor_u64(cursor)
    loop _ in 0..<fields {
        if cursor.bad -> break
        hop.names.push(jet_cli_replay_cursor_text(cursor))
        hop.values.push(jet_cli_replay_cursor_text(cursor))
    }
    if jet_cli_replay_cursor_u64(cursor) == 1 -> hop.body = Val(jet_cli_replay_cursor_bytes(cursor))
    hop
}

// One whole hop record as Core's `__client_net_tape` wrote it, or None
// when it is malformed.
jet_cli_replay_net_hop: fn(bytes: [U8]) -> JetCLIReplayNetHop? Never! {
    cursor := JetCLIReplayCursor{bytes: bytes.copy(), at: 0, bad: false}
    hop := jet_cli_replay_net_request_read(cursor)
    hop.stage = jet_cli_replay_cursor_u64(cursor)
    count: jet_cli_replay_cursor_u64(cursor)
    loop _ in 0..<count {
        if cursor.bad -> break
        address: jet_cli_replay_cursor_bytes(cursor)
        if address.len() != 4 && address.len() != 16 -> cursor.bad = true
        hop.addresses.push(address)
    }
    hop.sends = jet_cli_replay_cursor_u64(cursor)
    hop.stream = jet_cli_replay_cursor_bytes(cursor)
    hop.answered = jet_cli_replay_cursor_u64(cursor) == 1
    if hop.answered {
        hop.status = jet_cli_replay_cursor_u64(cursor)
        replies: jet_cli_replay_cursor_u64(cursor)
        loop _ in 0..<replies {
            if cursor.bad -> break
            hop.reply_names.push(jet_cli_replay_cursor_text(cursor))
            hop.reply_values.push(jet_cli_replay_cursor_text(cursor))
        }
    }
    hop.ending = jet_cli_replay_cursor_text(cursor)
    if cursor.bad || cursor.at != bytes.len() || hop.stage < 0 || hop.stage >= JET_CLI_REPLAY_NET_PHASES.len() -> return None
    if hop.scheme != "http" && hop.scheme != "https" -> return None
    if (hop.stage < 2 && hop.ending == "eof") || (hop.answered && hop.stage != 3) || (hop.stream.len() > 0 && hop.stage < 2) -> return None
    Val(hop)
}

// Canonical Jet `{"bits":64,"t":"uint","v":"<decimal>"}`.
jet_cli_replay_uint: fn(value: Int) -> CanonicalJSON Never! {
    CanonicalJSON.Object([CanonicalJSONField]{
        jet_cli_replay_integer_field("bits", 64),
        jet_cli_replay_string("t", "uint"),
        jet_cli_replay_string("v", jet_cli_replay_u64_text(value)),
    })
}

// The portable name an errno replays as, None when it has none (or shares
// it with another errno).
jet_cli_replay_io_error_name: fn(errno: Int) -> String? Never! {
    loop (at, known) in JET_CLI_REPLAY_IO_ERRNOS {
        if known == errno -> return Val(JET_CLI_REPLAY_IO_ERRORS[at].copy())
    }
    None
}

jet_cli_replay_io_errno: fn(name: String) -> Int? Never! {
    loop (at, known) in JET_CLI_REPLAY_IO_ERRORS {
        if known == name -> return Val(JET_CLI_REPLAY_IO_ERRNOS[at])
    }
    None
}

// An IOEnd outcome: `{"kind":"eof"}` at end of input, else
// `{"error":<portable name>,"kind":"error"}`.
jet_cli_replay_io_outcome: fn(error: String?) -> CanonicalJSON Never! {
    name: error ?? return CanonicalJSON.Object([CanonicalJSONField]{jet_cli_replay_string("kind", "eof")})
    CanonicalJSON.Object([CanonicalJSONField]{jet_cli_replay_string("error", name), jet_cli_replay_string("kind", "error")})
}

// Canonical Jet bytes: `{"t":"bytes","v":"<unpadded base64url>"}`.
jet_cli_replay_bytes_value: fn(bytes: [U8]) -> CanonicalJSON Never! {
    CanonicalJSON.Object([CanonicalJSONField]{
        jet_cli_replay_string("t", "bytes"),
        jet_cli_replay_string("v", replay_base64.encode_url(bytes)),
    })
}

// The canonical header, without its trailing LF.
jet_cli_replay_header_bytes: fn(artifact_id: String, run: JetCLIReplayRun, salt: String, status: Int) -> [U8] Never! {
    roots := [CanonicalJSON]{}
    loop root in run.roots -> roots.push(CanonicalJSON.String(root.copy()))
    header: canonical_json_bytes(CanonicalJSON.Object([CanonicalJSONField]{
        jet_cli_replay_string("artifact_id", artifact_id),
        CanonicalJSONField{key: "capture", value: CanonicalJSON.Object([CanonicalJSONField]{
            jet_cli_replay_string("mode", if run.sensitive -> "sensitive" else -> "safe"),
            CanonicalJSONField{key: "roots", value: CanonicalJSON.Array(roots)},
        })},
        CanonicalJSONField{key: "identity", value: CanonicalJSON.Object(run.identity.copy())},
        CanonicalJSONField{key: "limits", value: CanonicalJSON.Object([CanonicalJSONField]{
            jet_cli_replay_integer_field("frames", JET_CLI_REPLAY_MAX_FRAMES),
            jet_cli_replay_integer_field("payload_bytes", JET_CLI_REPLAY_MAX_ARTIFACT),
        })},
        jet_cli_replay_string("privacy_salt", salt),
        jet_cli_replay_string("producer", "jet-prove"),
        CanonicalJSONField{key: "run", value: CanonicalJSON.Object([CanonicalJSONField]{
            jet_cli_replay_string("outcome", if status == JET_CLI_EXIT_RUNTIME_STOP -> "panic" else -> "exit"),
            jet_cli_replay_integer_field("status", status),
        })},
        jet_cli_replay_string("schema", "jet.replay"),
        CanonicalJSONField{key: "version", value: CanonicalJSON.Object([CanonicalJSONField]{
            jet_cli_replay_integer_field("major", 1),
            jet_cli_replay_integer_field("minor", 0),
        })},
    }))
    header.slice(0, header.len() - 1)
}

// `value` (at least zero) as `width` little-endian bytes.
jet_cli_replay_put_le: fn(out: &[U8], value: Int, width: Int) Never! {
    rest := value
    loop _ in 0..<width {
        out.push(U8.from_int(rest %% 256) ?? panic("replay wire byte"))
        rest /%= 256
    }
}

// Writes this run's capture and returns where the record index keeps it.
// The bytes pass the reader before any is published. The default name is
// `.jet/replays/<entry>-<id[0..12]>`; an explicit path is an export, with
// the indexed copy at `.jet/replays/<id>`.
jet_cli_replay_capture_write: fn(identity: JetCLIProveIdentity, request: JetCLIProveCapture, run: JetCLIReplayRun, journal: JetCLIReplayJournal, status: Int) -> String JetCLIProveRefusal! {
    root: identity.authority_root
    reads: jet_cli_replay_journal_reads(journal, run) ?? return Err(err)
    salt: replay_random.token_urlsafe(32) ?? return Err(jet_cli_replay_unfinalized("the OS gave no randomness for the privacy salt"))
    bytes: jet_cli_replay_encode(run, reads, salt, status)
    verified: jet_cli_replay_verify(bytes) ?? return Err(jet_cli_replay_capture_fault(err))
    id: verified.artifact_id
    entry: jet_cli_replay_field_value(run.identity, "entry")
    name: if request.path == None -> "{jet_cli_replay_entry_stem(entry)}-{id.slice(0, 12)}.jetproof-replay" else -> "{id}.jetproof-replay"
    jet_cli_replay_publish(root, [String]{".jet", "replays"}, name, bytes)
    if request.path == .Val(path) {
        parts: path.split("/").to_list()
        folders := [String]{}
        loop index in 0..<(parts.len() - 1) -> folders.push(parts[index].copy())
        jet_cli_replay_publish(root, folders, parts[parts.len() - 1], bytes)
    }
    indexed: ".jet/replays/{name}"
    index := jet_cli_record_index_load(root) ?? return Err(jet_cli_replay_unfinalized(err.message))
    record: JetCLIRecordIdentity{target_inputs_sha256: identity.input_sha256, tool_version: COMPILER_VERSION, engine: "jet-prove-v1"}
    row: jet_cli_comparison_index_entry(index, record, "replay", id, indexed, bytes.len(), [JetCLIRecordLink]{}, [JetCLIRecordLink]{}, false) ?? return Err(jet_cli_replay_unfinalized(err.message))
    jet_cli_record_index_publish_and_store(index, root, row) ?? return Err(jet_cli_replay_unfinalized(err.message))
    Ok(indexed)
}

// `jet test --record=NAME` (Rust `begin_named_capture`): the safe, Time-only
// capture of one run, published at `.jet/replays/NAME.jetproof-replay` and
// indexed there as a protected replay. The run's programs read the recorded
// clock through JET_CLI_REPLAY_TIME_ENV; nothing else is recorded, so no
// sensitive-data preflight applies. The identity names the selected
// `profile`, and its semantic hash binds the target's MIR identity to that
// profile and to the `--set` writers the program compiled under, so a run
// under other settings is a different recording.
JetCLIReplayRecord: struct {
    identity: JetCLIProveIdentity
    name: String
    run: JetCLIReplayRun
}

// Binds a recording of `file`, whose compile authorized `files`, before its
// program builds: a refusal leaves no artifact.
jet_cli_replay_record_begin: fn(file: String, files: [String], name: String, profile: String, settings: [BuildSettingOverride]) -> JetCLIReplayRecord JetCLIProveRefusal! {
    if jet_cli_replay_name_problem(name) == .Val(problem) {
        return Err(JetCLIProveRefusal{code: "E2104", what: "invalid replay name", why: problem, fix: "write `--record=NAME` with letters, digits, `-`, or `_`", exit_code: JET_DRIVER_EXIT_USAGE})
    }
    target: JetCLIProveTarget{kind: "file", root: file, members: [String]{file}}
    members: jet_cli_prove_members(target) ?? return Err(err)
    group: JetCLIProveGroup{entry: 0, diagnostics: [Diagnostic]{}, files: files, has_tests: true, sites: [JetCLIProveTestSite]{}, floor: None}
    base: jet_cli_prove_identity(target, members, [JetCLIProveGroup]{group}) ?? return Err(err)
    selected: if profile == "" -> "dev" else -> profile
    fields := [JetCLIProveField]{jet_cli_prove_field("mir", base.mir_hash), jet_cli_prove_field("profile", selected)}
    loop setting in settings -> fields.push(jet_cli_prove_field("set {setting.name}", setting.value))
    mir_hash: jet_cli_prove_digest("jet-record-mir-v1", fields)
    identity := base.copy()
    identity.profile = selected.copy()
    identity.mir_hash = mir_hash.copy()
    identity.mir_json = jet_cli_prove_mir_json(mir_hash, members)
    path: jet_cli_replay_record_path(name)
    if cli_time.unix_ns() < 0 {
        return Err(jet_cli_replay_refusal("E3629", "replay artifact could not be finalized", "the system clock is before the Unix epoch", "fix the system clock and record again"))
    }
    if cli_files.lexists(jet_cli_entry_join(identity.authority_root, path)) {
        return Err(jet_cli_replay_refusal("E3629", "replay artifact could not be finalized", "the recording `{path}` already exists", "record under a new NAME, or remove the old recording"))
    }
    sites: jet_cli_replay_sites(members)
    site_id: jet_cli_replay_site_id(identity, members, sites)
    run: JetCLIReplayRun{
        time_ms: jet_cli_replay_clock_ms(),
        identity: jet_cli_replay_target_identity(identity, members, site_id),
        site_id: site_id,
        rand_site_id: jet_cli_replay_rand_site_id(identity, members, sites),
        io_site_id: jet_cli_replay_io_site_id(identity, members, sites),
        net_site_id: jet_cli_replay_net_site_id(identity, members, sites),
        sensitive: false,
        roots: [String]{"Time"},
        replayed: None,
    }
    Ok(JetCLIReplayRecord{identity: identity, name: name, run: run})
}

jet_cli_replay_record_path: fn(name: String) -> String Never! {
    ".jet/replays/{name}.jetproof-replay"
}

// Writes a recording once its run ended with `status`, then indexes it
// (Rust `finish_named_capture`, `index_named_capture`); returns its path.
// An index that can't take the row is E2105, as every record index update's is.
jet_cli_replay_record_finish: fn(record: JetCLIReplayRecord, status: Int) -> String JetCLIProveRefusal! {
    root: record.identity.authority_root
    salt: replay_random.token_urlsafe(32) ?? return Err(jet_cli_replay_unfinalized("the OS gave no randomness for the privacy salt"))
    bytes: jet_cli_replay_encode(record.run, [JetCLIReplayRead]{}, salt, status)
    verified: jet_cli_replay_verify(bytes) ?? return Err(jet_cli_replay_capture_fault(err))
    jet_cli_replay_publish(root, [String]{".jet", "replays"}, "{record.name}.jetproof-replay", bytes) ?? return Err(err)
    path: jet_cli_replay_record_path(record.name)
    index := jet_cli_record_index_load(root) ?? return Err(jet_cli_replay_record_index_failed(err.message))
    identity: JetCLIRecordIdentity{target_inputs_sha256: record.identity.input_sha256, tool_version: COMPILER_VERSION, engine: "jet-prove-v1"}
    row: jet_cli_comparison_index_entry(index, identity, "replay", verified.artifact_id, path, bytes.len(), [JetCLIRecordLink]{}, [JetCLIRecordLink]{}, true) ?? return Err(jet_cli_replay_record_index_failed(err.message))
    jet_cli_record_index_publish_and_store(index, root, row) ?? return Err(jet_cli_replay_record_index_failed(err.message))
    Ok(path)
}

jet_cli_replay_record_index_failed: fn(why: String) -> JetCLIProveRefusal Never! {
    jet_cli_replay_refusal("E2105", "record index update failed", why, "make the project's `.jet/records` directory writable, then record again")
}

// --- the harness journal ------------------------------------------------------

// The journal files of a sensitive run in `folder`: a capture's empty
// journal, or a replay's records with no trace yet.
jet_cli_replay_journal_open: fn(run: JetCLIReplayRun, folder: String) -> JetCLIReplayJournal JetCLIProveRefusal! {
    records := [U8]{}
    if run.replayed == .Val(artifact) {
        loop read in artifact.reads {
            records.push(U8.from_int(read.kind) ?? panic("journal kind"))
            jet_cli_replay_put_le(records, read.request, 8)
            jet_cli_replay_put_le(records, read.result, 8)
            records.extend(read.bytes)
        }
    } else {
        return Ok(JetCLIReplayJournal{capture: jet_cli_rooted_join(folder, "journal.bin"), records: "", trace: ""})
    }
    path: jet_cli_rooted_join(folder, "records.bin")
    cli_files.write_bytes(path, records) ?? return Err(jet_cli_prove_evidence_refusal("couldn't write the replay records: {jet_cli_io_error_text(err)}"))
    Ok(JetCLIReplayJournal{capture: "", records: path, trace: jet_cli_rooted_join(folder, "trace.bin")})
}

// The raw reads a capture's harnesses journaled, in order: Rand reads as
// RandBits records of the run's Rand site, stdin reads as IORead records of
// its stdin site, HTTP hops as Net records of its HTTP site. A read the OS
// refused with no RandBits shape, an errno outside the portable registry,
// or an HTTP failure with no portable name cannot be modeled (E3625).
jet_cli_replay_journal_reads: fn(journal: JetCLIReplayJournal, run: JetCLIReplayRun) -> [JetCLIReplayRead] JetCLIProveRefusal! {
    reads := [JetCLIReplayRead]{}
    if journal.capture == "" || !cli_files.exists(journal.capture) -> return Ok(reads)
    bytes: cli_files.read_bytes(journal.capture) ?? return Err(jet_cli_replay_unfinalized("couldn't read the capture journal: {jet_cli_io_error_text(err)}"))
    at := 0
    // The TimeWall frame, then one frame per Rand read, per stdin read an
    // IORead frame and its IOChunk frames or IOEnd frame, and per HTTP hop
    // its Net frames.
    frames := 1
    loop at < bytes.len() {
        if at + JET_CLI_REPLAY_JOURNAL_HEAD > bytes.len() -> return Err(jet_cli_replay_unfinalized("the capture journal ends inside a record"))
        kind: Int.from_u8(bytes[at])
        request: jet_cli_replay_journal_u64(bytes, at + 1)
        result: jet_cli_replay_journal_u64(bytes, at + 9)
        if kind == JET_CLI_REPLAY_JOURNAL_RAND_FAILED {
            return Err(jet_cli_replay_unmodeled("a refused OS randomness read", "the OS refused a Rand read during capture, and a RandBits record holds only delivered bits", "capture again once the OS randomness source answers"))
        }
        if kind == JET_CLI_REPLAY_JOURNAL_STDIN_FAILED && jet_cli_replay_io_error_name(result) == None {
            return Err(jet_cli_replay_unmodeled("a stdin read that failed with OS error {result}", "an IOEnd record names only errors in the portable I/O registry, and this error has no exact name there", "capture again with stdin open on a terminal, a file or a pipe"))
        }
        if kind == JET_CLI_REPLAY_JOURNAL_NET {
            begin: at + JET_CLI_REPLAY_JOURNAL_HEAD
            if request != 0 || result < 0 || result > bytes.len() - begin -> return Err(jet_cli_replay_unfinalized("the capture journal holds a malformed record"))
            if !run.roots.contains("Net") {
                return Err(jet_cli_replay_unmodeled("a raw read outside the capture's roots", "the run made an HTTP request through a call the capture did not see", "change the target so it makes HTTP requests only through calls its source names directly"))
            }
            record: bytes.slice(begin, begin + result)
            hop: jet_cli_replay_net_hop(record) ?? return Err(jet_cli_replay_unfinalized("the capture journal holds a malformed HTTP record"))
            if hop.ending == "unmapped" {
                return Err(jet_cli_replay_unmodeled("an HTTP request that failed with no portable error", "the {JET_CLI_REPLAY_NET_PHASES[hop.stage]} step of an HTTP request failed in a way the portable error registry cannot name, such as a TLS certificate or protocol failure", "capture again once the request succeeds or fails with a network error such as a refused connection or a timeout"))
            }
            if hop.ending != "eof" && !JET_CLI_REPLAY_NET_ERRORS.contains(hop.ending) -> return Err(jet_cli_replay_unfinalized("the capture journal holds a malformed HTTP record"))
            frames += 2 + (hop.stream.len() + JET_CLI_REPLAY_NET_CHUNK_BYTES - 1) /% JET_CLI_REPLAY_NET_CHUNK_BYTES
            if hop.stage >= 1 -> frames += 1
            if hop.answered -> frames += 1
            if frames >= JET_CLI_REPLAY_MAX_FRAMES -> return Err(jet_cli_replay_refusal("E3628", "replay capture exceeded its artifact limit", "the run's random, stdin and HTTP reads need more than {JET_CLI_REPLAY_MAX_FRAMES - 1} records", "capture a target that makes fewer reads"))
            reads.push(JetCLIReplayRead{kind: kind, site_id: run.net_site_id.copy(), request: 0, result: result, bytes: record})
            at = begin + result
            next
        }
        start: at + JET_CLI_REPLAY_JOURNAL_HEAD
        size: if kind == JET_CLI_REPLAY_JOURNAL_STDIN_FAILED -> 0 else -> result
        rand: kind == JET_CLI_REPLAY_JOURNAL_RAND
        stdin: kind == JET_CLI_REPLAY_JOURNAL_STDIN || kind == JET_CLI_REPLAY_JOURNAL_STDIN_FAILED
        if !(rand || stdin) || request < 0 || result < 0 || (rand && result != request) || (kind == JET_CLI_REPLAY_JOURNAL_STDIN && result > request) || size > bytes.len() - start {
            return Err(jet_cli_replay_unfinalized("the capture journal holds a malformed record"))
        }
        if (rand && !run.roots.contains("Rand")) || (stdin && !run.roots.contains("IO")) {
            source: if rand -> "randomness" else -> "stdin"
            return Err(jet_cli_replay_unmodeled("a raw read outside the capture's roots", "the run read {source} through a call the capture did not see", "change the target so it reads only through calls its source names directly"))
        }
        frames += if rand -> 1 else if kind == JET_CLI_REPLAY_JOURNAL_STDIN && result > 0 -> 1 + (result + JET_CLI_REPLAY_IO_CHUNK_BYTES - 1) /% JET_CLI_REPLAY_IO_CHUNK_BYTES else -> 2
        if frames >= JET_CLI_REPLAY_MAX_FRAMES -> return Err(jet_cli_replay_refusal("E3628", "replay capture exceeded its artifact limit", "the run's random, stdin and HTTP reads need more than {JET_CLI_REPLAY_MAX_FRAMES - 1} records", "capture a target that makes fewer reads"))
        site_id: if rand -> run.rand_site_id else -> run.io_site_id
        reads.push(JetCLIReplayRead{kind: kind, site_id: site_id.copy(), request: request, result: result, bytes: bytes.slice(start, start + size)})
        at = start + size
    }
    Ok(reads)
}

// A journal u64 below 2^32, or -1 for a larger one.
jet_cli_replay_journal_u64: fn(bytes: [U8], at: Int) -> Int Never! {
    if jet_cli_replay_le(bytes, at + 4, 4) != 0 -> return -1
    jet_cli_replay_le(bytes, at, 4)
}

// The stdin bytes a capture's harnesses have read so far, in order. A test
// that `jet test` runs again alone (NativeTests.jet) reads these rather
// than the user's terminal a second time. A journal it can't read gives
// none: the rerun then reads end of input, which its own record shows.
jet_cli_replay_journal_stdin: fn(path: String) -> [U8] Never! {
    typed := [U8]{}
    bytes: cli_files.read_bytes(path) ?? return typed
    at := 0
    loop at + JET_CLI_REPLAY_JOURNAL_HEAD <= bytes.len() {
        kind: Int.from_u8(bytes[at])
        result: jet_cli_replay_journal_u64(bytes, at + 9)
        start: at + JET_CLI_REPLAY_JOURNAL_HEAD
        size: if kind < 97 -> result else -> 0
        if size < 0 || size > bytes.len() - start -> return typed
        if kind == JET_CLI_REPLAY_JOURNAL_STDIN -> typed.extend(bytes.slice(start, start + size))
        at = start + size
    }
    typed
}

// A sensitive replay consumed every record in order, or it diverged: the
// trace holds `C` for each record a harness was served, `D` where a read
// asked for what the next record does not hold, and before each HTTP hop's
// record `Q` with the request the replayed run made, which must match the
// recorded NetRequest field for field.
jet_cli_replay_journal_divergence: fn(journal: JetCLIReplayJournal, artifact: JetCLIReplayArtifact) -> JetCLIProveRefusal? {
    if journal.records == "" -> return None
    trace: if cli_files.exists(journal.trace) -> cli_files.read_bytes(journal.trace) ?? [U8]{} else -> [U8]{}
    served := 0
    hops := 0
    at := 0
    loop at < trace.len() {
        mark: Int.from_u8(trace[at])
        if mark == JET_CLI_REPLAY_JOURNAL_REQUEST {
            size: if at + 9 <= trace.len() -> jet_cli_replay_journal_u64(trace, at + 1) else -> -1
            if size < 0 || size > trace.len() - at - 9 -> return Val(jet_cli_replay_diverged("the replay trace ends inside HTTP request {hops + 1}"))
            if jet_cli_replay_net_divergence(trace.slice(at + 9, at + 9 + size), artifact, hops) == .Val(refusal) -> return Val(refusal)
            hops += 1
            at += 9 + size
            next
        }
        if mark != 67 -> return Val(jet_cli_replay_diverged("raw read {served + 1} of the replayed run asked for a value the recording does not hold next"))
        served += 1
        at += 1
    }
    if hops != artifact.requests.len() -> return Val(jet_cli_replay_diverged("the replayed run made {hops} of the {artifact.requests.len()} recorded HTTP requests"))
    if served != artifact.reads.len() -> return Val(jet_cli_replay_diverged("the replayed run made {served} of the {artifact.reads.len()} recorded raw reads"))
    None
}

// HTTP request `index` of a replayed run against the recorded NetRequest:
// the same request, ids and salt give the same fields, so the first field
// that differs names how the run diverged.
jet_cli_replay_net_divergence: fn(request: [U8], artifact: JetCLIReplayArtifact, index: Int) -> JetCLIProveRefusal? Never! {
    if index >= artifact.requests.len() -> return Val(jet_cli_replay_diverged("the replayed run made HTTP request {index + 1}, but the recording holds {artifact.requests.len()}"))
    seen: artifact.requests[index]
    cursor := JetCLIReplayCursor{bytes: request.copy(), at: 0, bad: false}
    hop: jet_cli_replay_net_request_read(cursor)
    if cursor.bad || cursor.at != request.len() -> return Val(jet_cli_replay_diverged("HTTP request {index + 1} of the replayed run reached the trace malformed"))
    parsed: jet_cli_replay_json(seen.payload, "NetRequest payload") ?? return Val(jet_cli_replay_diverged("the recorded HTTP request {index + 1} is not valid JSON"))
    recorded: if parsed == {
        .Object(found) -> found.copy()
        else -> [CanonicalJSONField]{}
    }
    fresh: jet_cli_replay_net_request_fields(hop, index, seen.request_id, jet_cli_replay_field_value(recorded, "site_id"), artifact.salt)
    loop field in fresh {
        same := false
        loop old in recorded {
            if old.key == field.key -> same = canonical_json_bytes(old.value) == canonical_json_bytes(field.value)
        }
        if !same -> return Val(jet_cli_replay_diverged("HTTP request {index + 1} of the replayed run differs from the recording in `{field.key}`"))
    }
    None
}

jet_cli_replay_diverged: fn(why: String) -> JetCLIProveRefusal Never! {
    jet_cli_replay_refusal("E3623", "replay diverged from captured authority", why, "recapture and replay the matching target")
}

// A limit the encoded capture breaks is the run's (E3628); any other
// failure of its own check is the writer's (E3629).
jet_cli_replay_capture_fault: fn(fault: JetCLIReplayFault) -> JetCLIProveRefusal Never! {
    if fault.code == "E3628" -> return jet_cli_replay_fault_refusal(fault)
    jet_cli_replay_unfinalized("the encoded artifact failed its own check: {fault.why}")
}

// Publishes `bytes` as `name` in the real folders `parts` below `root`,
// through a mode-0600 temporary, never replacing different bytes.
jet_cli_replay_publish: fn(root: String, parts: [String], name: String, bytes: [U8]) JetCLIProveRefusal! {
    held: JetCLIRootedDirectory.open(root, parts, true) ?? return Err(jet_cli_replay_unfinalized(err.message))
    _: held.publish_immutable(name, bytes, Val(0o600), JET_CLI_REPLAY_MAX_ARTIFACT) ?? return Err(jet_cli_replay_unfinalized(err.message))
}

jet_cli_replay_unfinalized: fn(why: String) -> JetCLIProveRefusal Never! {
    jet_cli_replay_refusal("E3629", "replay artifact could not be finalized", why, "fix the path and retry capture")
}

// The entry's file stem with every byte but ASCII letters, digits, `-` and
// `_` as `_`.
jet_cli_replay_entry_stem: fn(entry: String) -> String Never! {
    stem: jet_cli_file_name(entry).removesuffix(".jet")
    out := [U8]{}
    loop byte in stem.bytes() {
        code: Int.from_u8(byte)
        keep: (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 45 || code == 95
        out.push(if keep -> byte else -> U8{95})
    }
    if out.len() == 0 -> return "replay"
    String.from_bytes(out) ?? "replay"
}

// --- capture -----------------------------------------------------------------

jet_cli_replay_capture_refusal: fn(root: String, request: JetCLIProveCapture, sites: [JetCLIReplaySite]) -> JetCLIProveRefusal? {
    // Sensitive consent is the typed TTY phrase; a process without a terminal
    // on stdin can never give it.
    if request.sensitive && !cli_term.stdin().is_tty() {
        return Val(jet_cli_replay_refusal("E3627", "replay capture refused sensitive data", "non-interactive `--capture-sensitive` cannot collect TTY consent for raw Rand/IO/Net values", "run from a TTY and type `capture sensitive`, or use safe `--capture` for Time-only roots"))
    }
    if cli_time.unix_ns() < 0 {
        return Val(jet_cli_replay_refusal("E3629", "replay artifact could not be finalized", "the system clock is before the Unix epoch", "fix the system clock and retry capture"))
    }
    if request.path == .Val(path) {
        destination_fix: "choose a project-relative nonexistent `.jetproof-replay` path"
        if jet_cli_replay_capture_path_problem(path) == .Val(problem) -> return Val(jet_cli_replay_refusal("E3629", "replay artifact could not be finalized", problem, destination_fix))
        if cli_files.lexists(jet_cli_entry_join(root, path)) -> return Val(jet_cli_replay_refusal("E3629", "replay artifact could not be finalized", "an explicit capture path must not already exist", "choose a new `.jetproof-replay` path"))
    }
    jet_cli_replay_capture_preflight(sites, request.sensitive)
}

// The rule an explicit destination meets before any byte is written:
// project-relative, forward-slash, no empty, `.` or `..` component, and a
// `.jetproof-replay` file name.
jet_cli_replay_capture_path_problem: fn(path: String) -> String? Never! {
    if path == "" -> return Val("explicit capture path is empty")
    loop byte in path.bytes() {
        if Int.from_u8(byte) == 0 -> return Val("capture path contains NUL")
    }
    if path.contains("\\") -> return Val("capture path must use non-empty forward-slash components")
    parts: path.split("/").to_list()
    loop part in parts {
        if part == "" -> return Val("capture path must use non-empty forward-slash components")
    }
    loop part in parts {
        if part == "." || part == ".." -> return Val("capture path must stay project-relative")
    }
    name: parts[parts.len() - 1]
    if name == ".jetproof-replay" || !name.ends_with(".jetproof-replay") -> return Val("capture path must end in `.jetproof-replay`")
    None
}

// Capture records one `core.time.now` and refuses everything else it cannot
// model; raw Rand, IO and Net need sensitive consent, and this adapter
// records raw Rand, the terminal builtins' stdin (their output is live) and
// Core's HTTP client requests.
jet_cli_replay_capture_preflight: fn(sites: [JetCLIReplaySite], sensitive: Bool) -> JetCLIProveRefusal? Never! {
    if jet_cli_replay_time_count(sites) > 1 {
        return Val(jet_cli_replay_unmodeled("multiple core.time.now sites", "the current replay adapter has one bounded Time record and cannot prove request order for multiple sites", "capture one Time request per target, or route time through an injected deterministic input"))
    }
    // A request's headers and body are stored only as salted digests, but its
    // host, path and query are stored as text. A target that reads Secret
    // values could put one there, so it is refused before anything runs.
    if sensitive && jet_cli_replay_reaches_http(sites) && jet_cli_replay_reaches(sites, Effect.Secret) {
        return Val(jet_cli_replay_refusal("E3627", "replay capture refused sensitive data", "the target reads Secret values and makes HTTP requests, so a secret could reach a request's host, path or query, which the artifact stores as text", "capture a target that makes its HTTP requests without reading Secret values"))
    }
    loop site in sites {
        authority: site.authority ?? return Val(jet_cli_replay_unmodeled(site.operation, "the reachable call shape is opaque to the replay authority", "route the operation through a supported deterministic input, or remove it from the captured target"))
        if authority == Effect.Time {
            if jet_cli_replay_is_time_now(site) -> next
            return Val(jet_cli_replay_unmodeled(site.operation, "the current replay adapter records only `core.time.now`; this Time operation would sleep or read an unrecorded clock", "capture a target that uses `core.time.now`, or route the operation through an injected deterministic input"))
        }
        if authority == Effect.Rand || authority == Effect.IO || authority == Effect.Net {
            if !sensitive -> return Val(jet_cli_replay_refusal("E3627", "replay capture refused sensitive data", "safe capture reached raw {sema_taint_effect_name(authority)} at {site.operation}; untainted values still require sensitive-data consent", "inject deterministic data, or explicitly use --capture-sensitive"))
            if authority == Effect.Rand || jet_cli_replay_is_terminal_io(site) || jet_cli_replay_is_http_client(site) -> next
        }
        if authority == Effect.Net {
            return Val(jet_cli_replay_unmodeled(site.operation, "replay capture records the requests of Core's HTTP client, not raw sockets, TLS streams, WebSockets or servers", "make the target's network calls through `core.http.client`, or change the capture target"))
        }
        return Val(jet_cli_replay_unmodeled(site.operation, "replay capture has no authority adapter for the {sema_taint_effect_name(authority)} effect", "route the operation through a supported deterministic input, or change the capture target"))
    }
    None
}

jet_cli_replay_unmodeled: fn(operation: String, why: String, fix: String) -> JetCLIProveRefusal Never! {
    jet_cli_replay_refusal("E3625", "replay capture cannot model {operation}", why, fix)
}

// --- replay ------------------------------------------------------------------

// A replay names an indexed replay id or a project-relative artifact. The
// artifact is verified whole, then bound to the current target's exact
// identity (E3621), before any value could be injected; the target preflight
// runs first when there is no artifact to read.
jet_cli_replay_input: fn(root: String, raw: String, sites: [JetCLIReplaySite], expected: [CanonicalJSONField], rand_site_id: String, io_site_id: String, net_site_id: String) -> JetCLIReplayArtifact JetCLIProveRefusal! {
    index: jet_cli_record_index_load(root) ?? return Err(jet_cli_replay_refusal("E2105", "could not load the replay record index", err.message, "repair or remove the project's `.jet/records` index, then run the command again"))
    found: jet_cli_record_index_find(index, "replay", raw, true)
    if found == None {
        if jet_cli_replay_input_problem(raw) == .Val(problem) -> return Err(jet_cli_replay_refusal("E3622", "replay artifact path is invalid", problem, "use an indexed replay id or a canonical `.jetproof-replay` path"))
    }
    relative: if found == .Val(entry) -> entry.path.copy() else -> raw.copy()
    present: cli_files.lexists(jet_cli_entry_join(root, relative))
    if !present {
        if jet_cli_replay_target_refusal(sites, [String]{"Time"}) == .Val(refusal) -> return Err(refusal)
    }
    artifact: jet_cli_replay_verify_file(root, relative, raw) ?? return Err(jet_cli_replay_fault_refusal(err))
    if jet_cli_replay_identity_change(artifact.identity, expected) == .Val(key) {
        return Err(jet_cli_replay_refusal("E3621", "replay semantic identity does not match", "the recorded `{key}` differs from the current target's", "replay the exact recorded revision, or recapture this one"))
    }
    if present {
        if jet_cli_replay_target_refusal(sites, artifact.roots) == .Val(refusal) -> return Err(refusal)
    }
    // A safe artifact exists for its one Time read; a sensitive one pins the
    // clock whether or not the target reads it.
    if !artifact.sensitive && jet_cli_replay_time_count(sites) == 0 {
        return Err(jet_cli_replay_refusal("E3623", "replay diverged from captured authority", "the target has no statically identified `core.time.now` call site for the captured Time record", "replay the matching target, or recapture a target with one supported Time call"))
    }
    loop read in artifact.reads {
        if read.kind == JET_CLI_REPLAY_JOURNAL_RAND {
            if read.site_id != rand_site_id -> return Err(jet_cli_replay_diverged("a recorded Rand value answers a different set of Rand call sites than the target's"))
        } else if read.kind == JET_CLI_REPLAY_JOURNAL_NET {
            if read.site_id != net_site_id -> return Err(jet_cli_replay_diverged("a recorded HTTP request answers a different set of HTTP call sites than the target's"))
        } else if read.site_id != io_site_id {
            return Err(jet_cli_replay_diverged("a recorded stdin read answers a different set of stdin call sites than the target's"))
        }
    }
    Ok(artifact)
}

// The first identity key whose recorded value differs from `expected`, or
// None when the identities are the same.
jet_cli_replay_identity_change: fn(recorded: [CanonicalJSONField], expected: [CanonicalJSONField]) -> String? Never! {
    loop key in JET_CLI_REPLAY_IDENTITY_KEYS {
        if jet_cli_replay_field_value(recorded, key) != jet_cli_replay_field_value(expected, key) -> return Val(key.copy())
    }
    None
}

jet_cli_replay_field_value: fn(fields: [CanonicalJSONField], key: String) -> String Never! {
    loop field in fields {
        if field.key == key && field.value == .String(text) -> return text.copy()
    }
    ""
}

// A replay input that is not an index id: a project-relative path to a
// `.jetproof-replay` artifact or a saved record.
jet_cli_replay_input_problem: fn(raw: String) -> String? Never! {
    if raw == "" -> return Val("replay artifact path is empty")
    loop byte in raw.bytes() {
        if Int.from_u8(byte) == 0 -> return Val("replay artifact path must stay project-relative")
    }
    if raw.contains("\\") || raw.starts_with("/") -> return Val("replay artifact path must stay project-relative")
    parts: raw.split("/").to_list()
    loop part in parts {
        if part == "" -> return Val("replay artifact path must use non-empty components")
    }
    loop part in parts {
        if part == "." || part == ".." -> return Val("replay artifact path contains an unsafe component")
    }
    name: parts[parts.len() - 1]
    if name.ends_with(".jetproof-replay") && name != ".jetproof-replay" -> return None
    if parts.len() == 4 && parts[0] == ".jet" && parts[1] == "records" && parts[2] == "saved" && jet_cli_replay_lower_hex(name, 24) -> return None
    Val("replay input must be a canonical index id or `.jetproof-replay` artifact path")
}

// The one Time record replays one statically identified `core.time.now`
// site, an artifact's Rand root replays every Rand site in read order, its
// IO root the terminal builtins (stdin in read order, output live), and its
// Net root Core's HTTP client requests in order; any other reachable
// authority would run unrecorded.
jet_cli_replay_target_refusal: fn(sites: [JetCLIReplaySite], roots: [String]) -> JetCLIProveRefusal? Never! {
    if jet_cli_replay_time_count(sites) > 1 {
        return Val(jet_cli_replay_refusal("E3623", "replay diverged from captured authority", "the target requests more than one `core.time.now` site, but the artifact has one bounded Time record", "recapture a target with one supported Time request, or route time through an injected deterministic input"))
    }
    loop site in sites {
        if jet_cli_replay_is_time_now(site) -> next
        why := "replay reached an opaque authority boundary at {site.operation}"
        if site.authority == .Val(authority) {
            if authority == Effect.Rand && roots.contains("Rand") -> next
            if roots.contains("IO") && jet_cli_replay_is_terminal_io(site) -> next
            if roots.contains("Net") && jet_cli_replay_is_http_client(site) -> next
            why = if authority == Effect.Time -> "replay reached unsupported Time operation at {site.operation}; the artifact records only `core.time.now`" else -> "replay reached unrecorded {sema_taint_effect_name(authority)} authority at {site.operation}"
        }
        return Val(jet_cli_replay_refusal("E3623", "replay diverged from captured authority", why, "recapture the target with every authority it reaches recorded, or remove the unrecorded boundary"))
    }
    None
}

jet_cli_replay_fault_refusal: fn(fault: JetCLIReplayFault) -> JetCLIProveRefusal Never! {
    if fault.code == "E3620" -> return jet_cli_replay_refusal("E3620", "replay schema version is incompatible", fault.why, "use a reader for the artifact schema, or recapture with this Jet")
    if fault.code == "E3628" -> return jet_cli_replay_refusal("E3628", "replay capture exceeded its artifact limit", fault.why, "recapture a bounded artifact with a recorded Time authority")
    jet_cli_replay_refusal("E3622", "replay artifact is corrupt", fault.why, "recapture the target and keep the complete `.jetproof-replay` artifact")
}

// --- the artifact ------------------------------------------------------------

// Opens `relative` under `root` through real directories only, then verifies
// the bytes. `shown` is the input as the user wrote it.
jet_cli_replay_verify_file: fn(root: String, relative: String, shown: String) -> JetCLIReplayArtifact JetCLIReplayFault! {
    parts: relative.split("/").to_list()
    current := root.copy()
    parent := ""
    loop index in 0..<(parts.len() - 1) {
        current = jet_cli_entry_join(current, parts[index])
        parent = if parent == "" -> parts[index].copy() else -> "{parent}/{parts[index]}"
        stat: cli_files.stat(current) ?? return Err(jet_cli_replay_corrupt("could not inspect replay artifact parent `{parent}`: {jet_cli_io_error_text(err)}"))
        if stat.is_symlink -> return Err(jet_cli_replay_corrupt("replay artifact parent `{parent}` is a symlink"))
        if !stat.is_dir -> return Err(jet_cli_replay_corrupt("replay artifact parent `{parent}` is not a directory"))
    }
    path: jet_cli_entry_join(root, relative)
    stat: cli_files.stat(path) ?? return Err(jet_cli_replay_corrupt("could not inspect `{shown}`: {jet_cli_io_error_text(err)}"))
    if stat.is_symlink || !stat.is_file -> return Err(jet_cli_replay_corrupt("replay artifact `{shown}` is not a regular file"))
    if stat.size > JET_CLI_REPLAY_MAX_ARTIFACT -> return Err(jet_cli_replay_limit("replay artifact exceeds the {JET_CLI_REPLAY_MAX_ARTIFACT}-byte limit"))
    bytes: cli_files.read_bytes(path) ?? return Err(jet_cli_replay_corrupt("could not read `{shown}`: {jet_cli_io_error_text(err)}"))
    if bytes.len() > JET_CLI_REPLAY_MAX_ARTIFACT -> return Err(jet_cli_replay_limit("replay artifact exceeds the {JET_CLI_REPLAY_MAX_ARTIFACT}-byte limit"))
    jet_cli_replay_verify(bytes)
}

// The v1 wire format: `JREPLAY\0`, u16 major and minor, u32 header length,
// the canonical JSON header, frames, then `JEND`, u64 frame count, u64
// payload-byte count and the SHA-256 of every byte before `JEND`. After the
// prefix and its bounds, the footer hash comes first: a changed byte is
// corruption (E3622) whatever the changed text would parse as.
jet_cli_replay_verify: fn(bytes: [U8]) -> JetCLIReplayArtifact JetCLIReplayFault! {
    if bytes.len() < 68 || !jet_cli_replay_has_magic(bytes) -> return Err(jet_cli_replay_corrupt("missing JREPLAY magic"))
    major: jet_cli_replay_le(bytes, 8, 2)
    minor: jet_cli_replay_le(bytes, 10, 2)
    if major != 1 || minor != 0 -> return Err(jet_cli_replay_unsupported("unsupported replay schema {major}.{minor}"))
    header_length: jet_cli_replay_le(bytes, 12, 4)
    header_end: 16 + header_length
    if header_end + 52 > bytes.len() -> return Err(jet_cli_replay_corrupt("truncated header"))
    if header_length > JET_CLI_REPLAY_MAX_HEADER -> return Err(jet_cli_replay_limit("replay header exceeds the {JET_CLI_REPLAY_MAX_HEADER}-byte limit"))
    jend: bytes.len() - 52
    if !jet_cli_replay_has_jend(bytes, jend) -> return Err(jet_cli_replay_corrupt("missing JEND footer"))
    if prove_crypto.sha256(bytes.slice(0, jend)).as_bytes() != bytes.slice(jend + 20, bytes.len()) -> return Err(jet_cli_replay_corrupt("footer hash mismatch"))
    header: bytes.slice(16, header_end)
    _: String.from_bytes(header) ?? return Err(jet_cli_replay_corrupt("header is not UTF-8"))
    root: jet_cli_replay_json(header, "header")
    fields: if root == {
        .Object(found) -> found
        else -> {
            return Err(jet_cli_replay_corrupt("header must be a JSON object"))
        }
    }
    artifact := jet_cli_replay_header(fields)
    at := header_end
    frames := 0
    payload_bytes := 0
    time_frames := 0
    rand_calls := 0
    io_calls := 0
    stream := 0
    chunks := 0
    open := JetCLIReplayRead?{None}
    net_calls := 0
    net := JetCLIReplayNetOpen?{None}
    loop at < jend {
        if at + 15 > jend -> return Err(jet_cli_replay_corrupt("truncated frame header"))
        if frames >= JET_CLI_REPLAY_MAX_FRAMES -> return Err(jet_cli_replay_limit("replay artifact exceeds the {JET_CLI_REPLAY_MAX_FRAMES}-frame limit"))
        flags: Int.from_u8(bytes[at])
        kind: jet_cli_replay_le(bytes, at + 1, 2)
        length: jet_cli_replay_le(bytes, at + 11, 4)
        payload_end: at + 15 + length
        frame_end: payload_end + 32
        if frame_end > jend -> return Err(jet_cli_replay_corrupt("truncated frame payload"))
        if length > JET_CLI_REPLAY_MAX_PAYLOAD -> return Err(jet_cli_replay_limit("replay frame payload exceeds the {JET_CLI_REPLAY_MAX_PAYLOAD}-byte limit"))
        if prove_crypto.sha256(bytes.slice(at, payload_end)).as_bytes() != bytes.slice(payload_end, frame_end) -> return Err(jet_cli_replay_corrupt("frame hash mismatch"))
        if !JET_CLI_REPLAY_DECODED_KINDS.contains(kind) {
            if JET_CLI_REPLAY_KINDS_V1.contains(kind) -> return Err(jet_cli_replay_unsupported("replay record kind {jet_cli_replay_kind_text(kind)} is not supported by this reader"))
            return Err(jet_cli_replay_corrupt("replay record kind {jet_cli_replay_kind_text(kind)} is not registered"))
        }
        if flags != 1 || !jet_cli_replay_le_is(bytes, at + 3, frames) || (frames == 0 && kind != JET_CLI_REPLAY_KIND_TIME) -> return Err(jet_cli_replay_corrupt("replay frame ordering or kind is invalid"))
        payload: bytes.slice(at + 15, payload_end)
        _: String.from_bytes(payload) ?? return Err(jet_cli_replay_corrupt("replay frame payload is not UTF-8"))
        // An open read that delivered chunks ends at the first frame that is
        // not its next chunk; one with none needs its first chunk or IOEnd.
        if open != None && kind != JET_CLI_REPLAY_KIND_IO_CHUNK {
            if chunks == 0 && kind != JET_CLI_REPLAY_KIND_IO_END -> return Err(jet_cli_replay_corrupt("an IORead frame must be followed by its IOChunk frames or one IOEnd frame"))
            if chunks > 0 {
                delivered: open ?? return Err(jet_cli_replay_corrupt("an IORead frame has no stream"))
                artifact.reads.push(delivered)
                open = None
            }
        }
        if open == None && (kind == JET_CLI_REPLAY_KIND_IO_CHUNK || kind == JET_CLI_REPLAY_KIND_IO_END) -> return Err(jet_cli_replay_corrupt("an IOChunk or IOEnd frame has no open IORead"))
        // An HTTP hop's frames run from its NetRequest to its NetEnd.
        net_frame: kind == JET_CLI_REPLAY_KIND_NET_DNS || kind == JET_CLI_REPLAY_KIND_NET_RESPONSE || kind == JET_CLI_REPLAY_KIND_NET_CHUNK || kind == JET_CLI_REPLAY_KIND_NET_END
        if net != None && !net_frame -> return Err(jet_cli_replay_corrupt("a NetRequest frame must be followed by its frames up to one NetEnd frame"))
        if net == None && net_frame -> return Err(jet_cli_replay_corrupt("a NetDns, NetResponse, NetChunk or NetEnd frame has no open NetRequest"))
        if kind == JET_CLI_REPLAY_KIND_TIME {
            time_frames += 1
            artifact.unix_ns = jet_cli_replay_time_payload(payload)
        } else if kind == JET_CLI_REPLAY_KIND_RAND {
            if !artifact.roots.contains("Rand") -> return Err(jet_cli_replay_corrupt("a RandBits frame needs the capture root `Rand`"))
            drawn: jet_cli_replay_rand_payload(payload, rand_calls)
            artifact.reads.push(drawn)
            rand_calls += 1
        } else if kind == JET_CLI_REPLAY_KIND_IO_READ {
            if !artifact.roots.contains("IO") -> return Err(jet_cli_replay_corrupt("an IORead frame needs the capture root `IO`"))
            started: jet_cli_replay_io_read_payload(payload, io_calls, frames)
            open = Val(started)
            stream = frames
            chunks = 0
            io_calls += 1
        } else if kind == JET_CLI_REPLAY_KIND_IO_CHUNK {
            read: open ?? return Err(jet_cli_replay_corrupt("an IOChunk frame has no open IORead"))
            grown: jet_cli_replay_io_chunk_payload(payload, read, stream, chunks)
            open = Val(grown)
            chunks += 1
        } else if kind == JET_CLI_REPLAY_KIND_IO_END {
            read: open ?? return Err(jet_cli_replay_corrupt("an IOEnd frame has no open IORead"))
            ended: jet_cli_replay_io_end_payload(payload, read, stream)
            artifact.reads.push(ended)
            open = None
        } else if kind == JET_CLI_REPLAY_KIND_NET_REQUEST {
            if !artifact.roots.contains("Net") -> return Err(jet_cli_replay_corrupt("a NetRequest frame needs the capture root `Net`"))
            site: jet_cli_replay_net_request_payload(payload, net_calls, frames)
            artifact.requests.push(JetCLIReplayNetSeen{request_id: frames, payload: payload.copy()})
            net = Val(JetCLIReplayNetOpen{request_id: frames, site_id: site, resolved: false, answered: false, chunks: 0, stream: [U8]{}})
            net_calls += 1
        } else if kind == JET_CLI_REPLAY_KIND_NET_DNS {
            hop := net ?? return Err(jet_cli_replay_corrupt("a NetDns frame has no open NetRequest"))
            if hop.resolved || hop.answered || hop.chunks > 0 -> return Err(jet_cli_replay_corrupt("a NetDns frame must come right after its NetRequest"))
            jet_cli_replay_net_dns_payload(payload, hop.request_id)
            hop.resolved = true
            net = Val(hop)
        } else if kind == JET_CLI_REPLAY_KIND_NET_RESPONSE {
            hop := net ?? return Err(jet_cli_replay_corrupt("a NetResponse frame has no open NetRequest"))
            if !hop.resolved || hop.answered || hop.chunks > 0 -> return Err(jet_cli_replay_corrupt("a NetResponse frame must follow its NetDns frame, before any NetChunk"))
            jet_cli_replay_net_response_payload(payload, hop.request_id)
            hop.answered = true
            net = Val(hop)
        } else if kind == JET_CLI_REPLAY_KIND_NET_CHUNK {
            hop := net ?? return Err(jet_cli_replay_corrupt("a NetChunk frame has no open NetRequest"))
            if !hop.resolved -> return Err(jet_cli_replay_corrupt("a NetChunk frame must follow its NetDns frame"))
            bytes_read: jet_cli_replay_net_chunk_payload(payload, hop.request_id, hop.chunks)
            hop.stream.extend(bytes_read)
            hop.chunks += 1
            net = Val(hop)
        } else if kind == JET_CLI_REPLAY_KIND_NET_END {
            hop: net ?? return Err(jet_cli_replay_corrupt("a NetEnd frame has no open NetRequest"))
            ended: jet_cli_replay_net_end_payload(payload, hop)
            artifact.reads.push(ended)
            net = None
        } else {
            jet_cli_replay_act_payload(payload)
        }
        frames += 1
        payload_bytes += length
        at = frame_end
    }
    if open != None {
        if chunks == 0 -> return Err(jet_cli_replay_corrupt("an IORead frame must be followed by its IOChunk frames or one IOEnd frame"))
        delivered: open ?? return Err(jet_cli_replay_corrupt("an IORead frame has no stream"))
        artifact.reads.push(delivered)
    }
    if net != None -> return Err(jet_cli_replay_corrupt("a NetRequest frame must be followed by its frames up to one NetEnd frame"))
    if time_frames == 0 -> return Err(jet_cli_replay_limit("replay artifact contains no Time authority"))
    if time_frames > 1 -> return Err(jet_cli_replay_corrupt("replay must contain exactly one consumed Time frame"))
    if !jet_cli_replay_le_is(bytes, jend + 4, frames) || !jet_cli_replay_le_is(bytes, jend + 12, payload_bytes) -> return Err(jet_cli_replay_corrupt("replay footer counts do not match frames"))
    // The content id hashes the prefix, the header with a zeroed id, and the
    // frames. The header is canonical with no unknown key, so `artifact_id`
    // is its first key and the id's 24 bytes sit right after `{"artifact_id":"`.
    if jet_cli_replay_text_at(bytes, 16, "{{\"artifact_id\":\"") == false || Int.from_u8(bytes[56]) != 34 -> return Err(jet_cli_replay_corrupt("header artifact_id must be its first field"))
    body := bytes.slice(0, 32)
    loop _ in 0..<24 -> body.push(U8{48})
    body.extend(bytes.slice(56, jend))
    content: prove_crypto.sha256(body).hex()
    if content.slice(0, 24) != artifact.artifact_id -> return Err(jet_cli_replay_corrupt("replay artifact_id does not match content"))
    Ok(artifact)
}

// The header fields every v1 artifact carries, as the artifact they describe
// (its Time value comes from its frame).
jet_cli_replay_header: fn(fields: [CanonicalJSONField]) -> JetCLIReplayArtifact JetCLIReplayFault! {
    jet_cli_replay_keys(fields, "header", [String]{"artifact_id", "capture", "identity", "limits", "privacy_salt", "producer", "run", "schema", "version"}, [String]{"extensions"}, "E3620")
    version: jet_cli_replay_object(fields, "version", "header")
    jet_cli_replay_keys(version, "header version", [String]{"major", "minor"}, [String]{}, "E3620")
    if !jet_cli_replay_integer_is(version, "major", "1") || !jet_cli_replay_integer_is(version, "minor", "0") -> return Err(jet_cli_replay_unsupported("header version disagrees with the replay prefix 1.0"))
    schema: jet_cli_replay_text(fields, "schema", "header")
    if schema != "jet.replay" -> return Err(jet_cli_replay_corrupt("unexpected schema `{schema}`"))
    artifact_id: jet_cli_replay_text(fields, "artifact_id", "header")
    if !jet_cli_replay_lower_hex(artifact_id, 24) -> return Err(jet_cli_replay_corrupt("header artifact_id is not 24 lowercase hex digits"))
    producer: jet_cli_replay_text(fields, "producer", "header")
    if producer != "jet-prove" -> return Err(jet_cli_replay_corrupt("header producer `{producer}` is not jet-prove"))
    salt: jet_cli_replay_text(fields, "privacy_salt", "header")
    if !jet_cli_replay_salt(salt) -> return Err(jet_cli_replay_corrupt("header privacy_salt is not 32 bytes of unpadded base64url"))
    if jet_cli_replay_has(fields, "extensions") && !jet_cli_replay_is_kind(fields, "extensions", "object") -> return Err(jet_cli_replay_corrupt("header `extensions` must be an object"))
    identity: jet_cli_replay_object(fields, "identity", "header")
    jet_cli_replay_identity(identity)
    capture: jet_cli_replay_object(fields, "capture", "header")
    jet_cli_replay_keys(capture, "header capture", [String]{"mode", "roots"}, [String]{}, "E3620")
    mode: jet_cli_replay_text(capture, "mode", "header capture")
    if mode != "safe" && mode != "sensitive" -> return Err(jet_cli_replay_corrupt("header capture mode `{mode}` is invalid"))
    roots: jet_cli_replay_roots(capture)
    if mode == "safe" && (roots.len() != 1 || roots[0] != "Time") -> return Err(jet_cli_replay_corrupt("safe capture roots must be exactly `Time`"))
    if mode == "sensitive" {
        // Roots name authorities once each, in byte order, and always the
        // Time every capture pins.
        loop (index, root) in roots {
            if !([String]{"IO", "Net", "Rand", "Time"}).contains(root) -> return Err(jet_cli_replay_corrupt("header capture root `{root}` is not an authority"))
            if index > 0 && roots[index - 1] >= root -> return Err(jet_cli_replay_corrupt("header capture roots must be distinct and in byte order"))
        }
        if !roots.contains("Time") -> return Err(jet_cli_replay_corrupt("sensitive capture roots must include `Time`"))
    }
    limits: jet_cli_replay_object(fields, "limits", "header")
    jet_cli_replay_keys(limits, "header limits", [String]{"frames", "payload_bytes"}, [String]{}, "E3620")
    if !jet_cli_replay_integer_is(limits, "frames", "{JET_CLI_REPLAY_MAX_FRAMES}") || !jet_cli_replay_integer_is(limits, "payload_bytes", "{JET_CLI_REPLAY_MAX_ARTIFACT}") -> return Err(jet_cli_replay_corrupt("header limits are not the v1 bounds"))
    run: jet_cli_replay_object(fields, "run", "header")
    jet_cli_replay_keys(run, "header run", [String]{"outcome", "status"}, [String]{}, "E3620")
    outcome: jet_cli_replay_text(run, "outcome", "header run")
    status: Int.parse(jet_cli_replay_integer(run, "status") ?? "-1") ?? -1
    if outcome != "exit" && outcome != "panic" -> return Err(jet_cli_replay_corrupt("header run outcome `{outcome}` is invalid"))
    if status < 0 || status > 255 -> return Err(jet_cli_replay_corrupt("header run status is not an exit status"))
    if (outcome == "panic") != (status == JET_CLI_EXIT_RUNTIME_STOP) -> return Err(jet_cli_replay_corrupt("header run outcome and status disagree"))
    salt_bytes: replay_base64.decode_url(salt) ?? return Err(jet_cli_replay_corrupt("header privacy_salt is not 32 bytes of unpadded base64url"))
    Ok(JetCLIReplayArtifact{artifact_id: artifact_id, identity: identity, sensitive: mode == "sensitive", roots: roots, salt: salt_bytes, unix_ns: 0, reads: [JetCLIReplayRead]{}, requests: [JetCLIReplayNetSeen]{}, status: status})
}

// The target identity a replay is bound to.
jet_cli_replay_identity: fn(identity: [CanonicalJSONField]) JetCLIReplayFault! {
    jet_cli_replay_keys(identity, "header identity", JET_CLI_REPLAY_IDENTITY_KEYS, [String]{}, "E3620")
    loop key in ([String]{"build_digest", "lock_digest", "optimized_mir_hash", "semantic_mir_hash", "source_digest", "time_site_id"}) {
        value: jet_cli_replay_text(identity, key, "header identity")
        if !jet_cli_replay_lower_hex(value, 64) -> return Err(jet_cli_replay_corrupt("header identity `{key}` is not lowercase SHA-256 hex"))
    }
    loop key in ([String]{"abi", "core_abi", "mir_schema", "profile", "target_triple"}) {
        value: jet_cli_replay_text(identity, key, "header identity")
        if value == "" -> return Err(jet_cli_replay_corrupt("header identity `{key}` is empty"))
    }
    entry: jet_cli_replay_text(identity, "entry", "header identity")
    if jet_cli_replay_entry_problem(entry) -> return Err(jet_cli_replay_corrupt("header identity `entry` is not a project-relative path"))
    adapter: jet_cli_replay_text(identity, "execution_adapter", "header identity")
    if adapter != JET_CLI_REPLAY_ADAPTER -> return Err(jet_cli_replay_unsupported("execution adapter `{adapter}` is not supported by this reader"))
    mir_schema: jet_cli_replay_text(identity, "mir_schema", "header identity")
    if mir_schema != JET_CLI_REPLAY_ADAPTER -> return Err(jet_cli_replay_unsupported("MIR schema `{mir_schema}` is not supported by this reader"))
    mir: jet_cli_replay_text(identity, "mir_identity", "header identity")
    value: jet_cli_replay_json(mir.bytes(), "mir_identity")
    fields: if value == {
        .Object(found) -> found
        else -> {
            return Err(jet_cli_replay_corrupt("mir_identity must be a JSON object"))
        }
    }
    jet_cli_replay_keys(fields, "mir_identity", JET_CLI_REPLAY_MIR_KEYS, [String]{}, "E3622")
    loop key in ([String]{"identity_digest", "optimized_hash", "semantic_hash"}) {
        hash: jet_cli_replay_text(fields, key, "mir_identity")
        if !jet_cli_replay_lower_hex(hash, 64) -> return Err(jet_cli_replay_corrupt("mir_identity `{key}` is not lowercase SHA-256 hex"))
    }
    schema: jet_cli_replay_text(fields, "schema", "mir_identity")
    if schema != JET_CLI_REPLAY_ADAPTER -> return Err(jet_cli_replay_unsupported("mir_identity schema `{schema}` is not supported by this reader"))
    loop key in ([String]{"core_ids", "function_ids", "source_map", "target_facts"}) {
        if !jet_cli_replay_is_kind(fields, key, "array") -> return Err(jet_cli_replay_corrupt("mir_identity `{key}` must be an array"))
    }
}

// True when an identity entry is not a project-relative forward-slash path.
jet_cli_replay_entry_problem: fn(entry: String) -> Bool Never! {
    if entry == "" || entry.starts_with("/") || entry.contains("\\") -> return true
    loop part in entry.split("/").to_list() {
        if part == "" || part == "." || part == ".." -> return true
    }
    false
}

// A TimeWall record: `{call_id, site_id, unix_ns}` with `unix_ns` a tagged
// 64-bit integer. Returns the recorded nanoseconds.
jet_cli_replay_time_payload: fn(payload: [U8]) -> Int JetCLIReplayFault! {
    value: jet_cli_replay_json(payload, "Time payload")
    fields: if value == {
        .Object(found) -> found
        else -> {
            return Err(jet_cli_replay_corrupt("Time payload must be an object"))
        }
    }
    jet_cli_replay_keys(fields, "Time payload", [String]{"call_id", "site_id", "unix_ns"}, [String]{}, "E3622")
    if !jet_cli_replay_integer_is(fields, "call_id", "0") -> return Err(jet_cli_replay_corrupt("Time payload call_id is invalid"))
    site: jet_cli_replay_text(fields, "site_id", "Time payload")
    if !jet_cli_replay_lower_hex(site, 64) || site == "0".repeat(64) -> return Err(jet_cli_replay_corrupt("Time payload site_id is invalid"))
    unix_ns: jet_cli_replay_object(fields, "unix_ns", "Time payload")
    jet_cli_replay_keys(unix_ns, "Time payload unix_ns", [String]{"bits", "t", "v"}, [String]{}, "E3622")
    shape: jet_cli_replay_text(unix_ns, "t", "Time payload unix_ns")
    if !jet_cli_replay_integer_is(unix_ns, "bits", "64") || shape != "int" -> return Err(jet_cli_replay_corrupt("Time payload unix_ns type is invalid"))
    number: jet_cli_replay_text(unix_ns, "v", "Time payload unix_ns")
    if !jet_cli_replay_canonical_u64(number) -> return Err(jet_cli_replay_corrupt("Time payload unix_ns value is invalid"))
    // The runtime clock is a signed 64-bit count, so a larger value was never
    // a reading a program could have made.
    Ok(jet_cli_replay_u64_value(number) ?? return Err(jet_cli_replay_corrupt("Time payload unix_ns is beyond the signed 64-bit clock")))
}

// The value of a canonical u64 text as `jet_cli_replay_canonical_u64` reads
// it: sixteen digits that start with `0` or hold a letter are hex, every
// other text is decimal. None above the signed 64-bit range.
jet_cli_replay_u64_value: fn(text: String) -> Int? Never! {
    if text.len() != 16 || (jet_cli_replay_digits(text) && !text.starts_with("0")) {
        decimal: Int.parse(text) ?? return None
        return Val(decimal)
    }
    value := 0
    loop byte in text.bytes() {
        code: Int.from_u8(byte)
        digit: if code <= 57 -> code - 48 else -> code - 87
        if value > (JET_CLI_REPLAY_MAX_I64 - digit) /% 16 -> return None
        value = value * 16 + digit
    }
    Val(value)
}

// The canonical u64 text of `value` (at least zero): minimal decimal up to
// 2^53 - 1, else 16 lowercase hex digits. A hex text with no letter reads
// back as decimal, so a writer checks `jet_cli_replay_u64_value` returns
// `value` before it records one.
jet_cli_replay_u64_text: fn(value: Int) -> String Never! {
    if value <= JET_CLI_REPLAY_MAX_EXACT -> return "{value}"
    digits: "0123456789abcdef"
    text := ""
    rest := value
    loop _ in 0..<16 {
        text = "{digits.slice(rest %% 16, rest %% 16 + 1)}{text}"
        rest /%= 16
    }
    text
}

// A RandBits record: `{bits, call_id, requested_bits, site_id}`, with
// `bits` canonical Jet bytes, `requested_bits` a tagged u64 equal to eight
// times their count, and `call_id` the record's place among the Rand reads.
jet_cli_replay_rand_payload: fn(payload: [U8], call: Int) -> JetCLIReplayRead JetCLIReplayFault! {
    what: "Rand payload"
    fields: jet_cli_replay_payload_fields(payload, what, [String]{"bits", "call_id", "requested_bits", "site_id"})
    if !jet_cli_replay_integer_is(fields, "call_id", "{call}") -> return Err(jet_cli_replay_corrupt("Rand payload call_id is out of order"))
    site: jet_cli_replay_payload_site(fields, what)
    bytes: jet_cli_replay_payload_bytes(fields, "bits", what)
    count: jet_cli_replay_payload_uint(fields, "requested_bits", what)
    if count != bytes.len() * 8 -> return Err(jet_cli_replay_corrupt("Rand payload requested_bits disagrees with its bits"))
    Ok(JetCLIReplayRead{kind: JET_CLI_REPLAY_JOURNAL_RAND, site_id: site, request: bytes.len(), result: bytes.len(), bytes: bytes})
}

// An IORead record: `{call_id, requested_bytes, site_id, stream_id}`, with
// `call_id` the record's place among the stdin reads and `stream_id` its
// own frame sequence. Returns the read, which the next records complete.
jet_cli_replay_io_read_payload: fn(payload: [U8], call: Int, sequence: Int) -> JetCLIReplayRead JetCLIReplayFault! {
    what: "IORead payload"
    fields: jet_cli_replay_payload_fields(payload, what, [String]{"call_id", "requested_bytes", "site_id", "stream_id"})
    if !jet_cli_replay_integer_is(fields, "call_id", "{call}") -> return Err(jet_cli_replay_corrupt("IORead payload call_id is out of order"))
    site: jet_cli_replay_payload_site(fields, what)
    jet_cli_replay_payload_stream(fields, what, sequence)
    requested: jet_cli_replay_payload_uint(fields, "requested_bytes", what)
    if requested <= 0 -> return Err(jet_cli_replay_corrupt("IORead payload requested_bytes must be positive"))
    Ok(JetCLIReplayRead{kind: JET_CLI_REPLAY_JOURNAL_STDIN, site_id: site, request: requested, result: 0, bytes: [U8]{}})
}

// An IOChunk record: `{bytes, chunk_index, stream_id}`, the open read's
// next bytes. Every chunk but the last is full, and together they fit the
// read's request. Returns the read with these bytes added.
jet_cli_replay_io_chunk_payload: fn(payload: [U8], open: JetCLIReplayRead, stream: Int, chunk: Int) -> JetCLIReplayRead JetCLIReplayFault! {
    what: "IOChunk payload"
    fields: jet_cli_replay_payload_fields(payload, what, [String]{"bytes", "chunk_index", "stream_id"})
    if !jet_cli_replay_integer_is(fields, "chunk_index", "{chunk}") -> return Err(jet_cli_replay_corrupt("IOChunk payload chunk_index is out of order"))
    jet_cli_replay_payload_stream(fields, what, stream)
    bytes: jet_cli_replay_payload_bytes(fields, "bytes", what)
    if bytes.len() == 0 || bytes.len() > JET_CLI_REPLAY_IO_CHUNK_BYTES || open.result != chunk * JET_CLI_REPLAY_IO_CHUNK_BYTES || open.result + bytes.len() > open.request -> return Err(jet_cli_replay_corrupt("IOChunk payload bytes disagree with their IORead"))
    delivered := open.bytes.copy()
    delivered.extend(bytes)
    Ok(JetCLIReplayRead{kind: JET_CLI_REPLAY_JOURNAL_STDIN, site_id: open.site_id.copy(), request: open.request, result: delivered.len(), bytes: delivered})
}

// An IOEnd record: `{chunks, outcome, stream_id, total_bytes}`, ending the
// open read, which delivered nothing, at end of input or with a portable
// I/O error.
jet_cli_replay_io_end_payload: fn(payload: [U8], open: JetCLIReplayRead, stream: Int) -> JetCLIReplayRead JetCLIReplayFault! {
    what: "IOEnd payload"
    fields: jet_cli_replay_payload_fields(payload, what, [String]{"chunks", "outcome", "stream_id", "total_bytes"})
    if !jet_cli_replay_integer_is(fields, "chunks", "0") -> return Err(jet_cli_replay_corrupt("IOEnd payload chunks disagree with the stream"))
    jet_cli_replay_payload_stream(fields, what, stream)
    counted: jet_cli_replay_payload_uint(fields, "total_bytes", what)
    if counted != 0 -> return Err(jet_cli_replay_corrupt("IOEnd payload total_bytes disagree with the stream"))
    outcome: jet_cli_replay_object(fields, "outcome", what)
    jet_cli_replay_keys(outcome, "IOEnd outcome", [String]{"kind"}, [String]{"error"}, "E3622")
    ending: jet_cli_replay_text(outcome, "kind", "IOEnd outcome")
    if ending == "eof" && outcome.len() == 1 -> return Ok(JetCLIReplayRead{kind: JET_CLI_REPLAY_JOURNAL_STDIN, site_id: open.site_id.copy(), request: open.request, result: 0, bytes: [U8]{}})
    if ending != "error" || outcome.len() != 2 -> return Err(jet_cli_replay_corrupt("IOEnd outcome is neither `eof` nor an error"))
    name: jet_cli_replay_text(outcome, "error", "IOEnd outcome")
    errno: jet_cli_replay_io_errno(name) ?? return Err(jet_cli_replay_corrupt("IOEnd outcome error `{name}` is not a portable I/O error this reader replays"))
    Ok(JetCLIReplayRead{kind: JET_CLI_REPLAY_JOURNAL_STDIN_FAILED, site_id: open.site_id.copy(), request: open.request, result: errno, bytes: [U8]{}})
}

// A NetRequest record: `{body_digest, call_id, header_digests, host, method,
// path, port, redirect_index, request_id, scheme, site_id}`, with the body
// and each header field as a salted digest (null for no body), `call_id`
// the hop's place among the HTTP hops, `redirect_index` its place in its
// redirect chain and `request_id` its own frame sequence. Returns its site.
jet_cli_replay_net_request_payload: fn(payload: [U8], call: Int, sequence: Int) -> String JetCLIReplayFault! {
    what: "NetRequest payload"
    fields: jet_cli_replay_payload_fields(payload, what, [String]{"body_digest", "call_id", "header_digests", "host", "method", "path", "port", "redirect_index", "request_id", "scheme", "site_id"})
    if !jet_cli_replay_integer_is(fields, "call_id", "{call}") -> return Err(jet_cli_replay_corrupt("NetRequest payload call_id is out of order"))
    jet_cli_replay_net_id(fields, what, sequence)
    site: jet_cli_replay_payload_site(fields, what)
    scheme: jet_cli_replay_text(fields, "scheme", what)
    if scheme != "http" && scheme != "https" -> return Err(jet_cli_replay_corrupt("{what} scheme `{scheme}` is neither http nor https"))
    method: jet_cli_replay_text(fields, "method", what)
    if method == "" -> return Err(jet_cli_replay_corrupt("{what} method is empty"))
    _: jet_cli_replay_text(fields, "host", what)
    _: jet_cli_replay_text(fields, "path", what)
    port: Int.parse(jet_cli_replay_integer(fields, "port") ?? "-1") ?? -1
    if port < 1 || port > 65535 -> return Err(jet_cli_replay_corrupt("{what} port is not a TCP port"))
    redirect: Int.parse(jet_cli_replay_integer(fields, "redirect_index") ?? "-1") ?? -1
    if redirect < 0 -> return Err(jet_cli_replay_corrupt("{what} redirect_index is not a count"))
    loop field in fields {
        if field.key != "body_digest" -> next
        valid: if field.value == {
            .Null -> true
            .String(text) -> jet_cli_replay_lower_hex(text, 64)
            else -> false
        }
        if !valid -> return Err(jet_cli_replay_corrupt("{what} body_digest is neither null nor a SHA-256 digest"))
    }
    loop entry in jet_cli_replay_net_pairs(fields, "header_digests", [String]{"digest_sha256", "name"}, what) {
        if !jet_cli_replay_lower_hex(jet_cli_replay_field_value(entry, "digest_sha256"), 64) -> return Err(jet_cli_replay_corrupt("{what} header digest is not a SHA-256 digest"))
    }
    Ok(site)
}

// A NetDns record: `{addresses, request_id}`, the resolver's answers in
// order as canonical IP text.
jet_cli_replay_net_dns_payload: fn(payload: [U8], request: Int) JetCLIReplayFault! {
    what: "NetDns payload"
    fields: jet_cli_replay_payload_fields(payload, what, [String]{"addresses", "request_id"})
    jet_cli_replay_net_id(fields, what, request)
    loop item in jet_cli_replay_array(fields, "addresses", what) {
        address: if item == {
            .String(text) -> text.copy()
            else -> {
                return Err(jet_cli_replay_corrupt("{what} addresses must be strings"))
            }
        }
        if jet_cli_replay_ip_bytes(address) == None -> return Err(jet_cli_replay_corrupt("{what} address `{address}` is not canonical IP text"))
    }
}

// A NetResponse record: `{headers, request_id, status}`, the reply the
// program saw, for readers; replay parses the recorded bytes again.
jet_cli_replay_net_response_payload: fn(payload: [U8], request: Int) JetCLIReplayFault! {
    what: "NetResponse payload"
    fields: jet_cli_replay_payload_fields(payload, what, [String]{"headers", "request_id", "status"})
    jet_cli_replay_net_id(fields, what, request)
    status: Int.parse(jet_cli_replay_integer(fields, "status") ?? "-1") ?? -1
    if status < 100 || status > 999 -> return Err(jet_cli_replay_corrupt("{what} status is not an HTTP status"))
    _: jet_cli_replay_net_pairs(fields, "headers", [String]{"name", "value"}, what)
}

// A NetChunk record: `{bytes, chunk_index, request_id}`, the hop's next
// bytes read. Returns them.
jet_cli_replay_net_chunk_payload: fn(payload: [U8], request: Int, chunk: Int) -> [U8] JetCLIReplayFault! {
    what: "NetChunk payload"
    fields: jet_cli_replay_payload_fields(payload, what, [String]{"bytes", "chunk_index", "request_id"})
    if !jet_cli_replay_integer_is(fields, "chunk_index", "{chunk}") -> return Err(jet_cli_replay_corrupt("NetChunk payload chunk_index is out of order"))
    jet_cli_replay_net_id(fields, what, request)
    bytes: jet_cli_replay_payload_bytes(fields, "bytes", what)
    if bytes.len() == 0 || bytes.len() > JET_CLI_REPLAY_NET_CHUNK_BYTES -> return Err(jet_cli_replay_corrupt("NetChunk payload holds no bytes or more than one chunk"))
    Ok(bytes)
}

// A NetEnd record: `{chunks, outcome, phase, request_id, sends, total_bytes}`,
// ending the open hop where it stopped (`phase`), after `sends` writes,
// at the end of what it read (`eof`) or with a portable error. Returns the
// hop as the replay record Core reads: u64 LE stage, sends and stream
// length, the stream, then the ending.
jet_cli_replay_net_end_payload: fn(payload: [U8], open: JetCLIReplayNetOpen) -> JetCLIReplayRead JetCLIReplayFault! {
    what: "NetEnd payload"
    fields: jet_cli_replay_payload_fields(payload, what, [String]{"chunks", "outcome", "phase", "request_id", "sends", "total_bytes"})
    jet_cli_replay_net_id(fields, what, open.request_id)
    total: jet_cli_replay_payload_uint(fields, "total_bytes", what)
    full: (total + JET_CLI_REPLAY_NET_CHUNK_BYTES - 1) /% JET_CLI_REPLAY_NET_CHUNK_BYTES
    if !jet_cli_replay_integer_is(fields, "chunks", "{open.chunks}") || total != open.stream.len() || open.chunks != full -> return Err(jet_cli_replay_corrupt("NetEnd payload counts disagree with the hop's NetChunk frames"))
    sends: jet_cli_replay_payload_uint(fields, "sends", what)
    phase: jet_cli_replay_text(fields, "phase", what)
    stage := -1
    loop (at, name) in JET_CLI_REPLAY_NET_PHASES {
        if name == phase -> stage = at
    }
    if stage < 0 -> return Err(jet_cli_replay_corrupt("{what} phase `{phase}` is not a hop phase"))
    if open.resolved != (stage >= 1) || (open.answered && stage != 3) || (open.chunks > 0 && stage < 2) -> return Err(jet_cli_replay_corrupt("{what} phase disagrees with the hop's frames"))
    outcome: jet_cli_replay_object(fields, "outcome", what)
    jet_cli_replay_keys(outcome, "NetEnd outcome", [String]{"kind"}, [String]{"error"}, "E3622")
    form: jet_cli_replay_text(outcome, "kind", "NetEnd outcome")
    ending := "eof"
    if form == "error" && outcome.len() == 2 {
        ending = jet_cli_replay_text(outcome, "error", "NetEnd outcome")
        if !JET_CLI_REPLAY_NET_ERRORS.contains(ending) -> return Err(jet_cli_replay_corrupt("NetEnd outcome error `{ending}` is not a portable error"))
    } else if form != "eof" || outcome.len() != 1 {
        return Err(jet_cli_replay_corrupt("NetEnd outcome is neither `eof` nor an error"))
    }
    // Resolving and connecting end only in an error; a proxy tunnel that
    // fails while the hop is in its handshake phase may end at `eof`.
    if stage < 2 && ending == "eof" -> return Err(jet_cli_replay_corrupt("{what} ends a hop that stopped before connecting without an error"))
    record := [U8]{}
    jet_cli_replay_put_le(record, stage, 8)
    jet_cli_replay_put_le(record, sends, 8)
    jet_cli_replay_put_le(record, open.stream.len(), 8)
    record.extend(open.stream)
    record.extend(ending.bytes())
    Ok(JetCLIReplayRead{kind: JET_CLI_REPLAY_JOURNAL_NET, site_id: open.site_id.copy(), request: 0, result: record.len(), bytes: record})
}

// A Net record's `request_id`: the sequence of its hop's NetRequest frame.
jet_cli_replay_net_id: fn(fields: [CanonicalJSONField], what: String, request: Int) JetCLIReplayFault! {
    if !jet_cli_replay_integer_is(fields, "request_id", "{request}") -> return Err(jet_cli_replay_corrupt("{what} request_id is not its NetRequest's sequence {request}"))
}

// A record's array of objects with exactly the text fields `keys`.
jet_cli_replay_net_pairs: fn(fields: [CanonicalJSONField], key: String, keys: [String], what: String) -> [[CanonicalJSONField]] JetCLIReplayFault! {
    entries := [[CanonicalJSONField]]{}
    loop item in jet_cli_replay_array(fields, key, what) {
        entry: if item == {
            .Object(found) -> found.copy()
            else -> {
                return Err(jet_cli_replay_corrupt("{what} {key} must hold objects"))
            }
        }
        jet_cli_replay_keys(entry, "{what} {key}", keys, [String]{}, "E3622")
        loop name in keys {
            _: jet_cli_replay_text(entry, name, "{what} {key}")
        }
        entries.push(entry)
    }
    Ok(entries)
}

jet_cli_replay_array: fn(fields: [CanonicalJSONField], key: String, name: String) -> [CanonicalJSON] JetCLIReplayFault! {
    loop field in fields {
        if field.key != key -> next
        if field.value == .Array(items) -> return Ok(items.copy())
    }
    Err(jet_cli_replay_corrupt("{name} `{key}` must be an array"))
}

// An address the resolver answered, 4 or 16 network-order octets, as text:
// dotted decimal, or eight lowercase hex groups without leading zeros.
jet_cli_replay_ip_text: fn(address: [U8]) -> String Never! {
    if address.len() == 4 -> return "{Int.from_u8(address[0])}.{Int.from_u8(address[1])}.{Int.from_u8(address[2])}.{Int.from_u8(address[3])}"
    digits: "0123456789abcdef"
    groups := [String]{}
    loop at in 0..<(address.len() /% 2) {
        rest := Int.from_u8(address[2 * at]) * 256 + Int.from_u8(address[2 * at + 1])
        group := ""
        loop {
            group = "{digits.slice(rest %% 16, rest %% 16 + 1)}{group}"
            rest = rest /% 16
            if rest == 0 -> break
        }
        groups.push(group)
    }
    groups.join(":")
}

// The octets of canonical IP text (jet_cli_replay_ip_text), or None.
jet_cli_replay_ip_bytes: fn(text: String) -> [U8]? Never! {
    out := [U8]{}
    if text.contains(".") {
        parts: text.split(".").to_list()
        if parts.len() != 4 -> return None
        loop part in parts {
            if !jet_cli_replay_digits(part) || (part.len() > 1 && part.starts_with("0")) -> return None
            value: Int.parse(part) ?? return None
            out.push(U8.from_int(value) ?? return None)
        }
        return Val(out)
    }
    parts: text.split(":").to_list()
    if parts.len() != 8 -> return None
    loop part in parts {
        if part.len() > 4 || (part.len() > 1 && part.starts_with("0")) || !jet_cli_replay_lower_hex(part, part.len()) -> return None
        value := 0
        loop byte in part.bytes() {
            code: Int.from_u8(byte)
            value = value * 16 + (if code <= 57 -> code - 48 else -> code - 87)
        }
        out.push(U8.from_int(value /% 256) ?? return None)
        out.push(U8.from_int(value %% 256) ?? return None)
    }
    Val(out)
}

// A record payload's object, with exactly `keys`.
jet_cli_replay_payload_fields: fn(payload: [U8], what: String, keys: [String]) -> [CanonicalJSONField] JetCLIReplayFault! {
    value: jet_cli_replay_json(payload, what)
    fields: if value == {
        .Object(found) -> found
        else -> {
            return Err(jet_cli_replay_corrupt("{what} must be an object"))
        }
    }
    jet_cli_replay_keys(fields, what, keys, [String]{}, "E3622")
    Ok(fields)
}

// A record's `site_id`: lowercase SHA-256 hex, not all zero.
jet_cli_replay_payload_site: fn(fields: [CanonicalJSONField], what: String) -> String JetCLIReplayFault! {
    site: jet_cli_replay_text(fields, "site_id", what)
    if !jet_cli_replay_lower_hex(site, 64) || site == "0".repeat(64) -> return Err(jet_cli_replay_corrupt("{what} site_id is invalid"))
    Ok(site)
}

// A record's `stream_id`: the sequence of the IORead frame that opened it.
jet_cli_replay_payload_stream: fn(fields: [CanonicalJSONField], what: String, stream: Int) JetCLIReplayFault! {
    if !jet_cli_replay_integer_is(fields, "stream_id", "{stream}") -> return Err(jet_cli_replay_corrupt("{what} stream_id is not its IORead's sequence {stream}"))
}

// A record's canonical Jet bytes `{"t":"bytes","v":"<unpadded base64url>"}`.
jet_cli_replay_payload_bytes: fn(fields: [CanonicalJSONField], key: String, what: String) -> [U8] JetCLIReplayFault! {
    value: jet_cli_replay_object(fields, key, what)
    jet_cli_replay_keys(value, "{what} {key}", [String]{"t", "v"}, [String]{}, "E3622")
    shape: jet_cli_replay_text(value, "t", "{what} {key}")
    if shape != "bytes" -> return Err(jet_cli_replay_corrupt("{what} {key} type is invalid"))
    text: jet_cli_replay_text(value, "v", "{what} {key}")
    bytes: replay_base64.decode_url(text) ?? return Err(jet_cli_replay_corrupt("{what} {key} are not base64url"))
    if replay_base64.encode_url(bytes) != text -> return Err(jet_cli_replay_corrupt("{what} {key} are not canonical unpadded base64url"))
    Ok(bytes)
}

// A record's tagged `{"bits":64,"t":"uint","v":"<decimal>"}` count.
jet_cli_replay_payload_uint: fn(fields: [CanonicalJSONField], key: String, what: String) -> Int JetCLIReplayFault! {
    value: jet_cli_replay_object(fields, key, what)
    jet_cli_replay_keys(value, "{what} {key}", [String]{"bits", "t", "v"}, [String]{}, "E3622")
    width: jet_cli_replay_text(value, "t", "{what} {key}")
    if !jet_cli_replay_integer_is(value, "bits", "64") || width != "uint" -> return Err(jet_cli_replay_corrupt("{what} {key} type is invalid"))
    count: jet_cli_replay_text(value, "v", "{what} {key}")
    parsed: Int.parse(count) ?? return Err(jet_cli_replay_corrupt("{what} {key} is not a count"))
    if parsed < 0 || count != "{parsed}" -> return Err(jet_cli_replay_corrupt("{what} {key} is not a canonical count"))
    Ok(parsed)
}

// A RunAct extension record: `{function, line, locals}`.
jet_cli_replay_act_payload: fn(payload: [U8]) JetCLIReplayFault! {
    value: jet_cli_replay_json(payload, "recorded act payload")
    fields: if value == {
        .Object(found) -> found
        else -> {
            return Err(jet_cli_replay_corrupt("recorded act payload must be an object"))
        }
    }
    jet_cli_replay_keys(fields, "recorded act payload", [String]{"function", "line", "locals"}, [String]{}, "E3622")
    function: jet_cli_replay_text(fields, "function", "recorded act")
    if function == "" -> return Err(jet_cli_replay_corrupt("recorded act function is empty"))
    line: Int.parse(jet_cli_replay_integer(fields, "line") ?? "0") ?? 0
    if line < 1 -> return Err(jet_cli_replay_corrupt("recorded act line must be a positive integer"))
    if !jet_cli_replay_is_kind(fields, "locals", "array") -> return Err(jet_cli_replay_corrupt("recorded act locals must be an array"))
    loop field in fields {
        if field.key != "locals" -> next
        if field.value == .Array(locals) {
            if locals.len() > JET_CLI_REPLAY_MAX_FRAMES -> return Err(jet_cli_replay_corrupt("recorded act has too many locals"))
            loop item in locals -> jet_cli_replay_act_local(item)
        }
    }
}

// One `{name, type, value}` local of a recorded act.
jet_cli_replay_act_local: fn(item: CanonicalJSON) JetCLIReplayFault! {
    entry: if item == {
        .Object(found) -> found
        else -> {
            return Err(jet_cli_replay_corrupt("recorded act local must be an object"))
        }
    }
    jet_cli_replay_keys(entry, "recorded act local", [String]{"name", "type", "value"}, [String]{}, "E3622")
    name: jet_cli_replay_text(entry, "name", "recorded act local")
    type_name: jet_cli_replay_text(entry, "type", "recorded act local")
    _: jet_cli_replay_text(entry, "value", "recorded act local")
    if name == "" || type_name == "" -> return Err(jet_cli_replay_corrupt("recorded act local name and type must be non-empty"))
}

// --- canonical JSON fields -----------------------------------------------------

// `bytes` parsed as canonical JSON: one value, nothing after it, and exactly
// the bytes its canonical rendering writes.
jet_cli_replay_json: fn(bytes: [U8], name: String) -> CanonicalJSON JetCLIReplayFault! {
    parser := CanonicalJSONParser{bytes: bytes.copy(), at: 0}
    value: canonical_json_value(parser) ?? return Err(jet_cli_replay_corrupt("{name} is not valid JSON"))
    if parser.at != bytes.len() -> return Err(jet_cli_replay_corrupt("{name} is not valid JSON"))
    rendered: canonical_json_bytes(value)
    if rendered.slice(0, rendered.len() - 1) != bytes -> return Err(jet_cli_replay_corrupt("{name} is not canonical JSON"))
    Ok(value)
}

// Every key of `fields` is `required` or `optional`, and every required key
// is present. An unknown key is `unknown_code`: E3620 where it names reader
// vocabulary this reader lacks, E3622 inside a fixed record shape.
jet_cli_replay_keys: fn(fields: [CanonicalJSONField], name: String, required: [String], optional: [String], unknown_code: String) JetCLIReplayFault! {
    loop field in fields {
        if !required.contains(field.key) && !optional.contains(field.key) -> return Err(JetCLIReplayFault{code: unknown_code, why: "{name} has unknown field `{field.key}`"})
    }
    loop key in required {
        if !jet_cli_replay_has(fields, key) -> return Err(jet_cli_replay_corrupt("{name} is missing `{key}`"))
    }
}

jet_cli_replay_has: fn(fields: [CanonicalJSONField], key: String) -> Bool Never! {
    loop field in fields {
        if field.key == key -> return true
    }
    false
}

// True when `key` holds an `object` or `array`.
jet_cli_replay_is_kind: fn(fields: [CanonicalJSONField], key: String, kind: String) -> Bool Never! {
    loop field in fields {
        if field.key != key -> next
        if kind == "object" && field.value == .Object(_) -> return true
        if kind == "array" && field.value == .Array(_) -> return true
        return false
    }
    false
}

jet_cli_replay_text: fn(fields: [CanonicalJSONField], key: String, name: String) -> String JetCLIReplayFault! {
    loop field in fields {
        if field.key != key -> next
        if field.value == .String(text) -> return Ok(text.copy())
        return Err(jet_cli_replay_corrupt("{name} `{key}` must be a string"))
    }
    Err(jet_cli_replay_corrupt("{name} is missing `{key}`"))
}

jet_cli_replay_object: fn(fields: [CanonicalJSONField], key: String, name: String) -> [CanonicalJSONField] JetCLIReplayFault! {
    loop field in fields {
        if field.key != key -> next
        if field.value == .Object(inner) -> return Ok(inner.copy())
        return Err(jet_cli_replay_corrupt("{name} `{key}` must be an object"))
    }
    Err(jet_cli_replay_corrupt("{name} is missing `{key}`"))
}

// The decimal text of an integer field, or None.
jet_cli_replay_integer: fn(fields: [CanonicalJSONField], key: String) -> String? Never! {
    loop field in fields {
        if field.key == key && field.value == .Integer(text) -> return Val(text.copy())
    }
    None
}

jet_cli_replay_integer_is: fn(fields: [CanonicalJSONField], key: String, expected: String) -> Bool Never! {
    text: jet_cli_replay_integer(fields, key) ?? return false
    text == expected
}

// The header's capture roots: an array of strings.
jet_cli_replay_roots: fn(capture: [CanonicalJSONField]) -> [String] JetCLIReplayFault! {
    roots := [String]{}
    loop field in capture {
        if field.key != "roots" -> next
        if field.value == .Array(items) {
            loop item in items {
                if item == .String(root) {
                    roots.push(root.copy())
                } else {
                    return Err(jet_cli_replay_corrupt("header capture roots must be strings"))
                }
            }
            return Ok(roots)
        }
    }
    Err(jet_cli_replay_corrupt("header capture roots must be an array"))
}

// --- scalar encodings ----------------------------------------------------------

jet_cli_replay_lower_hex: fn(text: String, width: Int) -> Bool Never! {
    if text.len() != width -> return false
    loop byte in text.bytes() {
        code: Int.from_u8(byte)
        if !((code >= 48 && code <= 57) || (code >= 97 && code <= 102)) -> return false
    }
    true
}

jet_cli_replay_digits: fn(text: String) -> Bool Never! {
    if text == "" -> return false
    loop byte in text.bytes() {
        code: Int.from_u8(byte)
        if code < 48 || code > 57 -> return false
    }
    true
}

// A canonical u64: minimal decimal up to 2^53 - 1, else 16 lowercase hex
// digits whose value is above it. Sixteen hex digits that start with `0` are
// hex, never decimal, and so must exceed 2^53 - 1 (no `000` or `001` prefix).
jet_cli_replay_canonical_u64: fn(text: String) -> Bool Never! {
    if text.len() == 16 && text.starts_with("0") && jet_cli_replay_lower_hex(text, 16) -> return !text.starts_with("000") && !text.starts_with("001")
    if jet_cli_replay_digits(text) {
        if text.len() > 1 && text.starts_with("0") -> return false
        if text.len() > 16 -> return false
        value: Int.parse(text) ?? -1
        return value >= 0 && value <= JET_CLI_REPLAY_MAX_EXACT
    }
    jet_cli_replay_lower_hex(text, 16)
}

// 32 bytes as unpadded base64url: 43 digits whose last two bits are zero.
jet_cli_replay_salt: fn(text: String) -> Bool Never! {
    if text.len() != 43 -> return false
    last := 0
    loop byte in text.bytes() {
        code: Int.from_u8(byte)
        last = if {
            code >= 65 && code <= 90 -> code - 65
            code >= 97 && code <= 122 -> code - 97 + 26
            code >= 48 && code <= 57 -> code - 48 + 52
            code == 45 -> 62
            code == 95 -> 63
            else -> -1
        }
        if last < 0 -> return false
    }
    last %% 4 == 0
}

// A little-endian unsigned field of `width` (at most 4) bytes.
jet_cli_replay_le: fn(bytes: [U8], at: Int, width: Int) -> Int Never! {
    value := 0
    loop step in 0..<width -> value = value * 256 + Int.from_u8(bytes[at + width - 1 - step])
    value
}

// True when the u64 at `at` equals `expected`, which fits in 32 bits.
jet_cli_replay_le_is: fn(bytes: [U8], at: Int, expected: Int) -> Bool Never! {
    jet_cli_replay_le(bytes, at + 4, 4) == 0 && jet_cli_replay_le(bytes, at, 4) == expected
}

jet_cli_replay_text_at: fn(bytes: [U8], at: Int, text: String) -> Bool Never! {
    expected: text.bytes()
    if at + expected.len() > bytes.len() -> return false
    loop (index, byte) in expected {
        if bytes[at + index] != byte -> return false
    }
    true
}

jet_cli_replay_has_magic: fn(bytes: [U8]) -> Bool Never! {
    jet_cli_replay_text_at(bytes, 0, "JREPLAY") && Int.from_u8(bytes[7]) == 0
}

jet_cli_replay_has_jend: fn(bytes: [U8], at: Int) -> Bool Never! {
    jet_cli_replay_text_at(bytes, at, "JEND")
}

// `0x0030`: a frame kind as the registry writes it.
jet_cli_replay_kind_text: fn(kind: Int) -> String Never! {
    digits: "0123456789abcdef"
    text := ""
    loop step in 0..<4 {
        shift: 3 - step
        nibble := kind
        loop _ in 0..<shift -> nibble /%= 16
        text = "{text}{digits.slice(nibble %% 16, nibble %% 16 + 1)}"
    }
    "0x{text}"
}

// --- the static authority walk ---------------------------------------------

jet_cli_replay_is_time_now: fn(site: JetCLIReplaySite) -> Bool Never! {
    if site.authority == .Val(authority) -> return authority == Effect.Time && (site.operation == "now" || site.operation.ends_with(".now"))
    false
}

jet_cli_replay_time_count: fn(sites: [JetCLIReplaySite]) -> Int Never! {
    count := 0
    loop site in sites {
        if jet_cli_replay_is_time_now(site) -> count += 1
    }
    count
}

// Every reachable authority call of the members, in source order. A member
// that does not parse has no sites; its front end reports it.
jet_cli_replay_sites: fn(members: [JetCLIProveMember]) -> [JetCLIReplaySite] {
    sites := [JetCLIReplaySite]{}
    loop member in members {
        parsed: parse_source(member.source.bytes())
        if jet_cli_errors(parsed.diagnostics).len() != 0 -> next
        aliases: jet_cli_replay_aliases(parsed.program.imports)
        locals := [String]{}
        jet_cli_replay_local_names(parsed.program.items, locals)
        jet_cli_replay_items(parsed.program.items, aliases, locals, sites)
        jet_cli_replay_block(parsed.program.script_body, aliases, locals, sites)
    }
    sites
}

// Local name -> the Core module or member it imports.
jet_cli_replay_aliases: fn(imports: [ImportDecl]) -> [String:String] Never! {
    aliases := [String:String]{}
    loop declaration in imports {
        if declaration.kind == {
            .Module(name, _) -> {
                if name == "core" || name == "app" || name.starts_with("core.") {
                    aliases[import_alias(declaration)] = name.copy()
                    parts: name.split(".").to_list()
                    short: parts[parts.len() - 1]
                    if aliases.get(short) == None -> aliases[short] = name.copy()
                }
            }
            .Unqualified(module_alias, _, _, _, _) -> {
                if module_alias == "core" || module_alias.starts_with("core.") {
                    loop binding in import_walk_bindings(declaration) {
                        original: binding.original ?? next
                        aliases[binding.local] = "{module_alias}.{original}"
                    }
                }
            }
            .File(_, _) -> {}
        }
    }
    aliases
}

jet_cli_replay_local_names: fn(items: [Item], names: &[String]) {
    loop item in items {
        if item == {
            .Func(func) -> names.push(func.name.copy())
            .CodeModule(unit) -> {
                if unit.body == .Val(body) -> jet_cli_replay_local_names(body, names)
            }
            else -> {}
        }
    }
}

jet_cli_replay_items: fn(items: [Item], aliases: [String:String], locals: [String], sites: &[JetCLIReplaySite]) {
    loop item in items {
        if item == {
            .Func(func) -> jet_cli_replay_block(func.body, aliases, locals, sites)
            .Struct(def) -> {
                loop method in def.methods -> jet_cli_replay_block(method.body, aliases, locals, sites)
            }
            .Enum(def) -> {
                loop method in def.methods -> jet_cli_replay_block(method.body, aliases, locals, sites)
            }
            .Impl(def) -> {
                loop method in def.methods -> jet_cli_replay_block(method.body, aliases, locals, sites)
            }
            .Test(def) -> jet_cli_replay_block(def.body, aliases, locals, sites)
            .CodeModule(unit) -> {
                if unit.body == .Val(body) -> jet_cli_replay_items(body, aliases, locals, sites)
            }
            else -> {}
        }
    }
}

jet_cli_replay_boundary: fn(operation: String, sites: &[JetCLIReplaySite]) {
    sites.push(JetCLIReplaySite{operation: operation, authority: None, owner: ""})
}

jet_cli_replay_block: fn(body: [Stmt], aliases: [String:String], locals: [String], sites: &[JetCLIReplaySite]) {
    loop statement in body -> jet_cli_replay_stmt(statement, aliases, locals, sites)
}

jet_cli_replay_stmt: fn(statement: Stmt, aliases: [String:String], locals: [String], sites: &[JetCLIReplaySite]) {
    if statement == {
        .Expr(value) -> jet_cli_replay_expr(value, aliases, locals, sites)
        .Val(binding) -> {
            jet_cli_replay_expr(binding.init, aliases, locals, sites)
            if binding.pattern == .Val(bound) {
                if bound == .Refutable(pattern, fallback, _, _) {
                    jet_cli_replay_pattern(pattern, aliases, locals, sites)
                    jet_cli_replay_fallback(fallback, aliases, locals, sites)
                }
            }
        }
        .Assign(target, _, _, value) -> {
            if target == {
                .Local(_, _) -> {}
                .Index(base, index, _, _) -> {
                    jet_cli_replay_expr(base, aliases, locals, sites)
                    jet_cli_replay_expr(index, aliases, locals, sites)
                }
                .Field(base, _, _) -> jet_cli_replay_expr(base, aliases, locals, sites)
            }
            jet_cli_replay_expr(value, aliases, locals, sites)
        }
        .Return(value, _) -> {
            if value == .Val(returned) -> jet_cli_replay_expr(returned, aliases, locals, sites)
        }
        .While(cond, body, _, _, _) -> {
            jet_cli_replay_expr(cond, aliases, locals, sites)
            jet_cli_replay_block(body, aliases, locals, sites)
        }
        .For(_, _, _, kind, body, _, _, _, _) -> {
            if kind == {
                .Range(start, end, step, _) -> {
                    jet_cli_replay_expr(start, aliases, locals, sites)
                    jet_cli_replay_expr(end, aliases, locals, sites)
                    if step == .Val(by) -> jet_cli_replay_expr(by, aliases, locals, sites)
                }
                .In(collection, step) -> {
                    jet_cli_replay_expr(collection, aliases, locals, sites)
                    if step == .Val(by) -> jet_cli_replay_expr(by, aliases, locals, sites)
                }
            }
            jet_cli_replay_block(body, aliases, locals, sites)
        }
        .Switch(subject, arms, else_body, _) -> {
            jet_cli_replay_expr(subject, aliases, locals, sites)
            loop arm in arms {
                jet_cli_replay_expr(arm.cond, aliases, locals, sites)
                jet_cli_replay_block(arm.body, aliases, locals, sites)
            }
            if else_body == .Val(otherwise) -> jet_cli_replay_block(otherwise, aliases, locals, sites)
        }
        .Break(_) -> {}
        .BreakValue(value, _) -> jet_cli_replay_expr(value, aliases, locals, sites)
        .Continue(_) -> {}
        .BreakLabel(_, _) -> {}
        .BreakLabelValue(_, _, value, _) -> jet_cli_replay_expr(value, aliases, locals, sites)
        .ContinueLabel(_, _) -> {}
        .Loop(body, _, _, _) -> jet_cli_replay_block(body, aliases, locals, sites)
        .CountedLoop(init, cond, step, body, _, _, _) -> {
            jet_cli_replay_expr(init.init, aliases, locals, sites)
            jet_cli_replay_expr(cond, aliases, locals, sites)
            if step == .Val(next_step) -> jet_cli_replay_stmt(next_step, aliases, locals, sites)
            jet_cli_replay_block(body, aliases, locals, sites)
        }
        .Unsafe(_, _, _, _) -> jet_cli_replay_boundary("#Unsafe raw boundary", sites)
        .Impure(_, _, _, _) -> jet_cli_replay_boundary("comptime impure boundary", sites)
        .Reactive(_, _) -> jet_cli_replay_boundary("task/concurrency boundary", sites)
        .Shield(body, _) -> jet_cli_replay_block(body, aliases, locals, sites)
        .Switched(_, body, _) -> jet_cli_replay_block(body, aliases, locals, sites)
        .Region(_, _, body, _) -> jet_cli_replay_block(body, aliases, locals, sites)
        .Policy(_, body, _) -> jet_cli_replay_block(body, aliases, locals, sites)
        .TaskGroup(_, _, _, _, _) -> jet_cli_replay_boundary("task/concurrency boundary", sites)
        .Layout(_, _, body, _) -> jet_cli_replay_block(body, aliases, locals, sites)
        .AuthorityScope(_, _, _, body, _) -> jet_cli_replay_block(body, aliases, locals, sites)
        .ComptimeIf(cond, _, then_body, else_body, _, _) -> {
            jet_cli_replay_expr(cond, aliases, locals, sites)
            jet_cli_replay_block(then_body, aliases, locals, sites)
            if else_body == .Val(otherwise) -> jet_cli_replay_block(otherwise, aliases, locals, sites)
        }
        .ComptimeSwitch(subject, arms, else_body, _) -> {
            jet_cli_replay_expr(subject, aliases, locals, sites)
            loop arm in arms {
                jet_cli_replay_expr(arm.cond, aliases, locals, sites)
                jet_cli_replay_block(arm.body, aliases, locals, sites)
            }
            if else_body == .Val(otherwise) -> jet_cli_replay_block(otherwise, aliases, locals, sites)
        }
        .ComptimeBlock(body, _, _) -> jet_cli_replay_block(body, aliases, locals, sites)
        .ContextBlock(_, _, _) -> jet_cli_replay_boundary("context block boundary", sites)
        .Live(_, _) -> jet_cli_replay_boundary("live terminal boundary", sites)
        .AssumeDet(_, _, _, _) -> jet_cli_replay_boundary("assume-deterministic boundary", sites)
        .Transact(_, _, body, _, _) -> jet_cli_replay_block(body, aliases, locals, sites)
        .Yield(value, _) -> jet_cli_replay_expr(value, aliases, locals, sites)
        .ScopeMember(_, _, _, _, _, _, _, _) -> jet_cli_replay_boundary("scope member boundary", sites)
        .DeferClose(close, _) -> jet_cli_replay_expr(close, aliases, locals, sites)
    }
}

jet_cli_replay_fallback: fn(fallback: OrFallback, aliases: [String:String], locals: [String], sites: &[JetCLIReplaySite]) {
    if fallback == {
        .Value(value) -> jet_cli_replay_expr(value, aliases, locals, sites)
        .Block(body, value, _) -> {
            jet_cli_replay_block(body, aliases, locals, sites)
            if value == .Val(result) -> jet_cli_replay_expr(result, aliases, locals, sites)
        }
        .Return(value, _) -> {
            if value == .Val(returned) -> jet_cli_replay_expr(returned, aliases, locals, sites)
        }
        .Panic(_, args) -> {
            loop arg in args -> jet_cli_replay_expr(arg.expr, aliases, locals, sites)
        }
        .Break(_) -> {}
        .Continue(_) -> {}
        .BreakLabel(_, _) -> {}
        .ContinueLabel(_, _) -> {}
    }
}

jet_cli_replay_exprs: fn(values: [Expr], aliases: [String:String], locals: [String], sites: &[JetCLIReplaySite]) {
    loop value in values -> jet_cli_replay_expr(value, aliases, locals, sites)
}

jet_cli_replay_expr: fn(value: Expr, aliases: [String:String], locals: [String], sites: &[JetCLIReplaySite]) {
    if value == {
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Interp(inner, _) -> jet_cli_replay_expr(inner, aliases, locals, sites)
            }
        }
        .StrMatchLit(_, _, _) -> {}
        .BinMatchLit(_, _, _) -> {}
        .Int(_, _, _, _, _) -> {}
        .Float(_, _, _, _, _) -> {}
        .Bool(_, _, _) -> {}
        .Unit(_, _) -> {}
        .Char(_, _, _) -> {}
        .ListLit(elements, _, _) -> jet_cli_replay_exprs(elements, aliases, locals, sites)
        .MemberSpread(base, _, _, _) -> jet_cli_replay_expr(base, aliases, locals, sites)
        .Spread(inner, _, _) -> jet_cli_replay_expr(inner, aliases, locals, sites)
        .MapLit(entries, _, _) -> {
            loop entry in entries {
                jet_cli_replay_expr(entry.key, aliases, locals, sites)
                jet_cli_replay_expr(entry.value, aliases, locals, sites)
            }
        }
        .Index(base, index, _, _, _) -> {
            jet_cli_replay_expr(base, aliases, locals, sites)
            jet_cli_replay_expr(index, aliases, locals, sites)
        }
        .Slice(base, start, end, range, _, _) -> {
            jet_cli_replay_expr(base, aliases, locals, sites)
            if range == .Val(bounds) -> jet_cli_replay_expr(bounds, aliases, locals, sites)
            if range == None {
                jet_cli_replay_expr(start, aliases, locals, sites)
                jet_cli_replay_expr(end, aliases, locals, sites)
            }
        }
        .Range(start, end, _, _, _) -> {
            jet_cli_replay_expr(start, aliases, locals, sites)
            jet_cli_replay_expr(end, aliases, locals, sites)
        }
        .Ident(_, _, _) -> {}
        .Call(call, _) -> {
            jet_cli_replay_call(call.name, aliases, locals, sites)
            loop arg in call.args -> jet_cli_replay_expr(arg.expr, aliases, locals, sites)
        }
        .Unary(_, operand, _, _) -> jet_cli_replay_expr(operand, aliases, locals, sites)
        .Binary(_, left, right, _, _) -> {
            jet_cli_replay_expr(left, aliases, locals, sites)
            jet_cli_replay_expr(right, aliases, locals, sites)
        }
        .CompareChain(operands, _, _, _, _) -> jet_cli_replay_exprs(operands, aliases, locals, sites)
        .UnitLit(_, _, _, _, _, _, _) -> {}
        .Deref(inner, _, _) -> jet_cli_replay_expr(inner, aliases, locals, sites)
        .RawOf(inner, _, _) -> jet_cli_replay_expr(inner, aliases, locals, sites)
        .Copy(inner, _, _) -> jet_cli_replay_expr(inner, aliases, locals, sites)
        .Place(inner, _, _, _) -> jet_cli_replay_expr(inner, aliases, locals, sites)
        .Field(base, _, _, _) -> jet_cli_replay_expr(base, aliases, locals, sites)
        .OptField(base, _, _, _, _, _) -> jet_cli_replay_expr(base, aliases, locals, sites)
        .MethodCall(receiver, method, _, _, _, args, _) -> {
            jet_cli_replay_method(receiver, method, aliases, sites)
            jet_cli_replay_expr(receiver, aliases, locals, sites)
            loop arg in args -> jet_cli_replay_expr(arg.expr, aliases, locals, sites)
        }
        .OptMethodCall(receiver, method, _, _, args, _, _) -> {
            jet_cli_replay_method(receiver, method, aliases, sites)
            jet_cli_replay_expr(receiver, aliases, locals, sites)
            loop arg in args -> jet_cli_replay_expr(arg.expr, aliases, locals, sites)
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            loop field in fields -> jet_cli_replay_expr(field.value, aliases, locals, sites)
        }
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> {
                    loop field in fields -> jet_cli_replay_expr(field.value, aliases, locals, sites)
                }
                .Elements(elements) -> jet_cli_replay_exprs(elements, aliases, locals, sites)
                .Entries(entries) -> {
                    loop entry in entries {
                        jet_cli_replay_expr(entry.key, aliases, locals, sites)
                        jet_cli_replay_expr(entry.value, aliases, locals, sites)
                    }
                }
                .Value(inner) -> jet_cli_replay_expr(inner, aliases, locals, sites)
                .ByteText(_) -> {}
                .Empty -> {}
            }
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            loop arg in args {
                if arg == {
                    .Positional(inner) -> jet_cli_replay_expr(inner, aliases, locals, sites)
                    .Named(_, inner) -> jet_cli_replay_expr(inner, aliases, locals, sites)
                }
            }
        }
        .Tainted(inner, _, _, _) -> jet_cli_replay_expr(inner, aliases, locals, sites)
        .Present(inner, _, _) -> jet_cli_replay_expr(inner, aliases, locals, sites)
        .Absent(_, _) -> {}
        .Todo(_, _, _) -> {}
        .NoElse(_, _) -> {}
        .PatternTest(subject, pattern, _, _) -> {
            jet_cli_replay_expr(subject, aliases, locals, sites)
            jet_cli_replay_pattern(pattern, aliases, locals, sites)
        }
        .Ok(inner, _, _) -> jet_cli_replay_expr(inner, aliases, locals, sites)
        .Err(inner, _, _) -> jet_cli_replay_expr(inner, aliases, locals, sites)
        .Try(inner, _, _, context, _) -> {
            jet_cli_replay_expr(inner, aliases, locals, sites)
            if context == .Val(note) -> jet_cli_replay_expr(note, aliases, locals, sites)
        }
        .OrFallback(inner, fallback, _, _, _) -> {
            jet_cli_replay_expr(inner, aliases, locals, sites)
            jet_cli_replay_fallback(fallback, aliases, locals, sites)
        }
        .If(cond, then_body, then_value, else_body, else_value, _, _) -> {
            jet_cli_replay_expr(cond, aliases, locals, sites)
            jet_cli_replay_block(then_body, aliases, locals, sites)
            jet_cli_replay_expr(then_value, aliases, locals, sites)
            jet_cli_replay_block(else_body, aliases, locals, sites)
            jet_cli_replay_expr(else_value, aliases, locals, sites)
        }
        .TupleLit(fields, _, _, _) -> {
            loop field in fields -> jet_cli_replay_expr(field.value, aliases, locals, sites)
        }
        .Lambda(lambda, _) -> {
            if lambda.body == {
                .Expr(inner) -> jet_cli_replay_expr(inner, aliases, locals, sites)
                .Block(body) -> jet_cli_replay_block(body, aliases, locals, sites)
            }
        }
        .CallValue(_, _, _, _) -> jet_cli_replay_boundary("opaque callable", sites)
        .PtrFromAddr(_, _, _, addr, _, _) -> {
            jet_cli_replay_boundary("native pointer boundary", sites)
            jet_cli_replay_expr(addr, aliases, locals, sites)
        }
        .ComptimeName(_, _, _, _) -> {}
        .Paren(inner, _, _) -> jet_cli_replay_expr(inner, aliases, locals, sites)
    }
}

jet_cli_replay_pattern: fn(pattern: Pattern, aliases: [String:String], locals: [String], sites: &[JetCLIReplaySite]) {
    if pattern == {
        .Variant(_, bindings, _, _) -> {
            loop slot in bindings -> jet_cli_replay_slot(slot, aliases, locals, sites)
        }
        .Present(_, _, inner, _) -> {
            if inner == .Val(nested) -> jet_cli_replay_pattern(nested, aliases, locals, sites)
        }
        .Absent(_) -> {}
        .Ok(_, _, inner, _) -> {
            if inner == .Val(nested) -> jet_cli_replay_pattern(nested, aliases, locals, sites)
        }
        .Err(_, _, inner, _) -> {
            if inner == .Val(nested) -> jet_cli_replay_pattern(nested, aliases, locals, sites)
        }
        .Range(_, _, _) -> {}
        .Or(alternatives, _) -> {
            loop alternative in alternatives -> jet_cli_replay_pattern(alternative, aliases, locals, sites)
        }
        .Struct(fields, _, _, _) -> {
            loop field in fields {
                if field == {
                    .Bind(_, _, _, _) -> {}
                    .Value(_, _, inner) -> jet_cli_replay_expr(inner, aliases, locals, sites)
                    .Nested(_, _, nested) -> jet_cli_replay_pattern(nested, aliases, locals, sites)
                }
            }
        }
        .List(items, _, _) -> {
            loop slot in items -> jet_cli_replay_slot(slot, aliases, locals, sites)
        }
        .Map(entries, _, _) -> {
            loop entry in entries {
                jet_cli_replay_expr(entry.key, aliases, locals, sites)
                jet_cli_replay_slot(entry.slot, aliases, locals, sites)
            }
        }
        .StrMatch(_, _) -> {}
        .BinMatch(_, _) -> {}
    }
}

jet_cli_replay_slot: fn(slot: PatSlot, aliases: [String:String], locals: [String], sites: &[JetCLIReplaySite]) {
    if slot == {
        .Wildcard -> {}
        .Bind(_, _) -> {}
        .Range(_, _) -> {}
        .Nested(nested) -> jet_cli_replay_pattern(nested, aliases, locals, sites)
        .Named(_, _, inner) -> jet_cli_replay_slot(inner, aliases, locals, sites)
        .Rest(_) -> {}
        .Value(inner) -> jet_cli_replay_expr(inner, aliases, locals, sites)
    }
}

// A direct call. A bare name is a local function, an ambient terminal
// builtin, or an imported Core member; a dotted name is `module.member`
// through an import alias. Anything else is opaque to the replay authority.
jet_cli_replay_call: fn(name: String, aliases: [String:String], locals: [String], sites: &[JetCLIReplaySite]) {
    dot: name.rfind(".")
    if dot < 0 {
        if locals.contains(name) -> return
        if JET_CLI_REPLAY_IO_BUILTINS.contains(name) {
            sites.push(JetCLIReplaySite{operation: name, authority: Val(Effect.IO), owner: ""})
            return
        }
        if aliases.get(name) == None {
            jet_cli_replay_boundary(name, sites)
            return
        }
        target: aliases.get(name) ?? return
        member_dot: target.rfind(".")
        if member_dot < 0 -> return
        home: target.slice(0, member_dot)
        authority: sema_taint_core_effect(home, target.slice(member_dot + 1, target.len())) ?? return
        sites.push(JetCLIReplaySite{operation: target, authority: Val(authority), owner: home})
        return
    }
    head: name.slice(0, dot)
    member: name.slice(dot + 1, name.len())
    owner: jet_cli_replay_module(head, aliases)
    resolved: owner ?? head
    authority: sema_taint_core_effect(resolved, member)
    if authority == .Val(found) {
        sites.push(JetCLIReplaySite{operation: name, authority: Val(found), owner: resolved})
        return
    }
    if owner == None -> jet_cli_replay_boundary(name, sites)
}

// `receiver.method(…)`: a Core member through an import alias, else a
// method of a value, which the replay authority cannot see into.
jet_cli_replay_method: fn(receiver: Expr, method: String, aliases: [String:String], sites: &[JetCLIReplaySite]) {
    path: jet_cli_replay_receiver_path(receiver) ?? ""
    owner: jet_cli_replay_module(path, aliases) ?? ""
    if owner == "" {
        jet_cli_replay_boundary("method call {method}", sites)
        return
    }
    authority: sema_taint_core_effect(owner, method) ?? return
    sites.push(JetCLIReplaySite{operation: "{owner}.{method}", authority: Val(authority), owner: owner})
}

// `a.b.c` with `a` an import alias: the aliased module with `.b.c` appended.
jet_cli_replay_module: fn(path: String, aliases: [String:String]) -> String? Never! {
    dot: path.find(".")
    head: if dot < 0 -> path else -> path.slice(0, dot)
    target: aliases.get(head) ?? return None
    if dot < 0 -> return Val(target)
    Val("{target}{path.slice(dot, path.len())}")
}

jet_cli_replay_receiver_path: fn(receiver: Expr) -> String? Never! {
    if receiver == {
        .Ident(name, _, _) -> Val(name)
        .Field(base, member, _, _) -> {
            prefix: jet_cli_replay_receiver_path(base) ?? return None
            Val("{prefix}.{member}")
        }
        else -> None
    }
}
