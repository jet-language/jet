// Rust: Source/CmdPerf.rs:1752
fn observe_io(tasks: &[ObservedTask]) -> [ObservedIo] {
    out := [ObservedIo]{}
    loop task in tasks {
        if task.state != "blocked" { next }
        kind :: if TraceIo.kind_for_wait(task.wait) == { Val(kind) -> kind; None -> next }
        out.push(ObservedIo{kind: kind, task: task.key(), wait: task.wait.clone()})
    }
    out.sort_by_key(row -> row.task)
    out
}
// Rust: Source/CmdPerf.rs:1771
fn json_array_inner(snapshot: String, key: String) -> String? {
    tail :: snapshot.split_once("\"{key}\":[")?.1
    depth := 1
    i := 0
    bytes :: tail.bytes()
    loop i < bytes.len() {
        if bytes[i] == {
            91 -> depth += 1
            93 -> { depth -= 1; if depth == 0 { return Val(tail[0..<i]) } }
            34 -> {
                i += 1
                loop i < bytes.len() {
                    if bytes[i] == 92 { i += 2; next }
                    if bytes[i] == 34 { break }
                    i += 1
                }
            }
            _ -> {}
        }
        i += 1
    }
    None
}
