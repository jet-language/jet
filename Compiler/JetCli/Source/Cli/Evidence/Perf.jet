    fn profile_cpu_samples(&self) -> UInt64 { self.profile_cpu_samples }
    // Rust: Source/CmdPerf.rs:1733
    fn profile_samples_truncated(&self) -> Bool { self.profile_samples_truncated }
    // Rust: Source/CmdPerf.rs:1738
    fn tasks(&self) -> [ObservedTask] {
