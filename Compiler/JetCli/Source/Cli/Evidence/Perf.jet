// Rust: Source/CmdPerf.rs:1747
fn elapsed_ns(started: Instant) -> UInt64 {
    // GATE #4494: native monotonic elapsed time.
    started.elapsed().as_nanos().min(UInt64.MAX as UInt128) as UInt64
