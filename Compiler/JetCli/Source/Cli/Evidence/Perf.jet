// Rust: Source/CmdPerf.rs:1497
fn trace_task_id_map(tasks: &[ObservedTask]) -> [ObservedTaskKey:UInt64] {
    // GATE #4499: tuple-key equality/order. Preserve BTreeSet ordering.
    keys := tasks.iter().map(task -> task.key()).collect()
    keys.sort()
    keys.dedup()
    ids := [ObservedTaskKey:UInt64]{}
    loop (index, key) in keys.iter().enumerate() { ids.insert(key, index as UInt64 + 1) }
    ids
}
// Rust: Source/CmdPerf.rs:1508
struct ObservedLock { id: UInt64; depth: UInt64; capacity: UInt64?; send_waiters: UInt64; recv_waiters: UInt64; closed: Bool }
// Rust: Source/CmdPerf.rs:1518
fn observe_locks(snapshot: String) -> [ObservedLock] {
    inner :: if json_array_inner(snapshot, "channels") == { Val(inner) -> inner; None -> return [] }
    if inner.is_empty() { return [] }
    out := [ObservedLock]{}
    loop object in split_json_objects(inner, TRACE_TASK_ROW_LIMIT as Int).0 {
        id :: if json_u64(object, "id") == { Val(value) -> value; None -> next }
        depth :: if json_u64(object, "depth") == { Val(value) -> value; None -> next }
        send_waiters :: if json_u64(object, "send_waiters") == { Val(value) -> value; None -> next }
        recv_waiters :: if json_u64(object, "recv_waiters") == { Val(value) -> value; None -> next }
        if send_waiters == 0 && recv_waiters == 0 { next }
        capacity :: if object.contains("\"capacity\":null") { None } else { json_u64(object, "capacity") }
        closed :: object.contains("\"closed\":true")
        out.push(ObservedLock{id: id, depth: depth, capacity: capacity, send_waiters: send_waiters, recv_waiters: recv_waiters, closed: closed})
    }
    out.sort_by_key(lock -> lock.id)
    out
}
