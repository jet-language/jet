//RS     let name = source
//RS         .symbols
//RS         .iter()
//RS         .find(|(name, kind)| kind == "fn" && name == "run")
//RS         .or_else(|| source.symbols.iter().find(|(_, kind)| kind == "fn"))
//RS         .or_else(|| source.symbols.first())
//RS         .map(|(name, _)| name.clone())?;
//RS     Some(JetSymbolRef {
//RS         path: source.path.clone(),
//RS         name,
//RS     })
//RS }
//RS /// A top-level function as the canonical parser sees it. `span` is the
//RS /// parser-owned declaration boundary: `fn` through the closing brace.
//RS struct SourceFunction {
//RS     name: String,
//RS     span: jet::Diagnostics::Span,
//RS }
//RS 
//RS /// Top-level functions from the canonical lexer and parser, in source order.
//RS /// Comments, strings, and bodies are the parser's business, so a `fn run`
//RS /// spelled inside a comment is never an attribution target. A source that does
//RS /// not parse yields `None`: capture then names no location rather than guess.
//RS fn source_functions(src: &str) -> Option<Vec<SourceFunction>> {
//RS     let source_for_parse = jet::Package::mask_inline_package_source(src).ok()?.0;
//RS     let (tokens, lex_diagnostics) = jet::Lexer::lex(&source_for_parse);
//RS     if !lex_diagnostics.is_empty() {
//RS         return None;
//RS     }
//RS     let program = jet::Parser::parse_with_source(&tokens, &source_for_parse).ok()?;
//RS     Some(
//RS         program
//RS             .items
//RS             .iter()
//RS             .filter_map(|item| match item {
//RS                 jet::AST::Item::Func(function) => Some(SourceFunction {
//RS                     name: function.name.clone(),
//RS                     span: function.span,
//RS                 }),
//RS                 _ => None,
//RS             })
//RS             .collect(),
//RS     )
//RS }
//RS 
//RS /// 1-based line and character column of a byte offset into `src`.
//RS fn source_line_column(src: &str, offset: usize) -> (u64, u64) {
//RS     let before = src.get(..offset).unwrap_or(src);
//RS     let line_start = before.rfind('\n').map_or(0, |newline| newline + 1);
//RS     (
//RS         before.matches('\n').count() as u64 + 1,
//RS         before[line_start..].chars().count() as u64 + 1,
//RS     )
//RS }
