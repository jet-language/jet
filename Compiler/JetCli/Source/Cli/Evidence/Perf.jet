// Rust: Source/CmdPerf.rs:1434
type ObservedTaskKey = (UInt32, UInt64)
// Rust: Source/CmdPerf.rs:1442
#Derive(Default)
struct ObservedTasks { process_id: UInt32; rows: [ObservedTask]; truncated: Bool }
// Rust: Source/CmdPerf.rs:1450
fn observe_tasks(snapshot: String, process_id: UInt32) -> ObservedTasks {
    inner :: if json_array_inner(snapshot, "tasks") == { Val(inner) -> inner; None -> return ObservedTasks{process_id: process_id, rows: [], truncated: false} }
    if inner.is_empty() { return ObservedTasks{process_id: process_id, rows: [], truncated: false} }
    out := [ObservedTask]{}
    (objects, truncated) :: split_json_objects(inner, TRACE_TASK_ROW_LIMIT as Int)
    loop object in objects {
        id :: if json_u64(object, "id") == { Val(value) -> value; None -> next }
        parent :: if json_u64(object, "parent") == { Val(value) -> value; None -> next }
        state :: if json_string(object, "state") == { Val(value) -> value; None -> next }
        if state != "running" && state != "queued" && state != "blocked" && state != "done" { next }
        wait :: json_string(object, "wait").unwrap_or_default()
        cancelled :: object.contains("\"cancelled\":true")
        out.push(ObservedTask{process_id: process_id, id: id, parent: parent, state: state, wait: wait, cancelled: cancelled})
    }
